  ("real_zpow", Session.real_zpow),
  ("set_of_list", Session.set_of_list),
  ("sndcart", Session.sndcart),
  ("sqrt", Session.sqrt),
  ("string_INFINITE", Session.string_INFINITE),
  ("sum", Session.sum),
  ("sum_INDUCT", Session.sum_INDUCT),
  ("sum_RECURSION", Session.sum_RECURSION),
  ("sup", Session.sup),
  ("superadmissible", Session.superadmissible_DEF),
  ("support", Session.support),
  ("tailadmissible", Session.tailadmissible_DEF),
  ("treal_add", Session.trealThms.treal_add),
  ("treal_eq", Session.trealThms.treal_eq),
  ("treal_inv", Session.trealThms.treal_inv),
