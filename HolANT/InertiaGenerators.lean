structure InertiaGenerators where
  -- @@FIELDS
  NUMBER_FIELD_RATIONAL_RAMIFICATION_INDEX : thm
  NUMBER_FIELD_UNRAMIFIED_RATIONAL : thm
  NUMBER_FIELD_INERTIA_GROUPS_GENERATE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupInertiaGenerators [HolBase] (D : InertiaGeneratorsDeps) :
    ExceptT String IO InertiaGenerators := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, TAUT, .. } := D
  let { DIVIDES_ZERO, EXISTS_UNIQUE_THM, EXTENSION, EXTENSION_DEGREE_EQ_1,
        FIELD_SUBFIELD_GENERATED, FORALL_IN_IMAGE, GALOIS_GROUP_FIXED_FIELD,
        GALOIS_IMP_FIELD_EXTENSION, IN_GALOIS_GROUP,
        IN_GALOIS_GROUP_SUBFIELD_GENERATED, IN_SING, LE_MULT2, LE_REFL, LE_TRANS,
        MULT_CLAUSES, NOT_EXISTS_THM, NUMBER_FIELD_HOMOMORPHIC_PREIMAGE,
        NUMBER_FIELD_IMP_FIELD, NUMBER_FIELD_INTERMEDIATE_FIELD,
        NUMBER_FIELD_RAMIFICATION_INDEX_TOWER_Q,
        NUMBER_FIELD_RAMIFICATION_RESIDUE_BOUNDS, NUMBER_FIELD_RAMIFIED_PRIME_EXISTS,
        NUMBER_FIELD_TOWER_LAW, NUMBER_FIELD_UNRAMIFIED_INERTIA_FIXED_FIELD, PRIME_0,
        PRIME_IMP_RING_IDEAL, RAMIFICATION_INDEX_PRIME_SUBFIELD,
        RING_HOMOMORPHISM_SUBFIELD_INCLUSION, RING_MONOMORPHISM_IMP_HOMOMORPHISM,
        RING_OF_INTEGERS_PRIME_IDEAL_BELOW, RING_OF_NUM_EQ_0, SUBFIELD_OF_IMP_SUBSET,
        SUBGROUP_GENERATED_EQ, SUBGROUP_SUBGROUP_GENERATED, SUBSET_REFL,
        UNRAMIFIED_IMP_WEAKLY_UNRAMIFIED, field_extension, number_field,
        weakly_unramified, .. } := D.core1
  -- @@SCOPE END

  let NUMBER_FIELD_RATIONAL_RAMIFICATION_INDEX ← do
    -- the rules of the tactics, in OCaml's order (right to left)
    let r1 ← ARITH_RULE (← q r"e:num = e * 1")
    let r2 ← ARITH_RULE (← q r"1 <= e /\ e <= 1 ==> e = 1")
    prove
      r"!k:A ring p.
          number_field k /\
          extension_degree(subfield_generated k {ring_0 k},k) I = 1 /\
          prime_ideal (ring_of_integers k) p /\ ~(p = {ring_0 k})
          ==> ramification_index (integer_ring,ring_of_integers k)
                (ring_of_int k) p = 1"
      (REPEAT STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o (MATCH_MP NUMBER_FIELD_IMP_FIELD)) THEN MP_TAC (← ISPECL [(← q r"k:A ring"), (← q r"p:A->bool")] RAMIFICATION_INDEX_PRIME_SUBFIELD) THEN ASM_SIMP_TAC [PRIME_IMP_RING_IDEAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN MP_TAC (← ISPECL [(← q r"subfield_generated k {ring_0(k:A ring)}"), (← q r"k:A ring"), (← q r"I:A->A"), (← q r"p:A->bool")] RING_OF_INTEGERS_PRIME_IDEAL_BELOW) THEN ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, RING_HOMOMORPHISM_SUBFIELD_INCLUSION, EXISTS_UNIQUE_THM] THEN DISCH_THEN ((X_CHOOSE_THEN (← q r"q:A->bool") STRIP_ASSUME_TAC) o CONJUNCT1) THEN MP_TAC (← ISPECL [(← q r"subfield_generated k {ring_0(k:A ring)}"), (← q r"k:A ring"), (← q r"I:A->A"), (← q r"q:A->bool"), (← q r"p:A->bool")] NUMBER_FIELD_RAMIFICATION_RESIDUE_BOUNDS) THEN ASM_SIMP_TAC [FIELD_SUBFIELD_GENERATED, RING_HOMOMORPHISM_SUBFIELD_INCLUSION] THEN STRIP_TAC THEN MATCH_MP_TAC r2 THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC (← q r"ramification_index
       (ring_of_integers(subfield_generated k {ring_0 k}),ring_of_integers k)
       (I:A->A) p *
      residue_degree
       (ring_of_integers(subfield_generated k {ring_0 k}),ring_of_integers k)
       I p") THEN ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [r1] THEN MATCH_MP_TAC LE_MULT2 THEN ASM_REWRITE_TAC [LE_REFL])

  let NUMBER_FIELD_UNRAMIFIED_RATIONAL ← do
    -- the rules of the tactics, in OCaml's order (right to left)
    let r1 ← TAUT (← q r"(~p ==> F) ==> p")
    prove
      r"!(h:A->B) k l.
          field k /\ number_field l /\ ring_homomorphism(k,l) h /\
          extension_degree(subfield_generated k {ring_0 k},k) I = 1 /\
          (!p. prime_ideal (ring_of_integers k) p /\ ~(p = {ring_0 k})
               ==> unramified (ring_of_integers k,ring_of_integers l) h p)
          ==> extension_degree(k,l) h = 1"
      (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL [(← q r"k:A ring"), (← q r"l:B ring"), (← q r"h:A->B")] NUMBER_FIELD_TOWER_LAW) THEN ASM_REWRITE_TAC [MULT_CLAUSES] THEN DISCH_THEN (SUBST1_TAC o (SYM o CONJUNCT2)) THEN MATCH_MP_TAC r1 THEN DISCH_TAC THEN MP_TAC (← ISPEC (← q r"l:B ring") NUMBER_FIELD_RAMIFIED_PRIME_EXISTS) THEN ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC [(← q r"q:num"), (← q r"P:B->bool")] THEN STRIP_TAC THEN SUBGOAL_THEN (← q r"~(P = {ring_0(l:B ring)})") ASSUME_TAC THENL [DISCH_THEN SUBST_ALL_TAC THEN UNDISCH_TAC (← q r"ring_of_num l q IN {ring_0(l:B ring)}") THEN REWRITE_TAC [IN_SING, RING_OF_NUM_EQ_0] THEN FIRST_ASSUM (MP_TAC o (CONJUNCT1 o (GEN_REWRITE_RULE id [number_field]))) THEN DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [DIVIDES_ZERO] THEN ASM_MESON_TAC [PRIME_0], ALL_TAC] THEN MP_TAC (← ISPECL [(← q r"k:A ring"), (← q r"l:B ring"), (← q r"h:A->B"), (← q r"P:B->bool")] RING_OF_INTEGERS_PRIME_IDEAL_BELOW) THEN ASM_REWRITE_TAC [EXISTS_UNIQUE_THM] THEN DISCH_THEN ((X_CHOOSE_THEN (← q r"p:A->bool") STRIP_ASSUME_TAC) o CONJUNCT1) THEN MP_TAC (← ISPECL [(← q r"k:A ring"), (← q r"l:B ring"), (← q r"h:A->B"), (← q r"p:A->bool"), (← q r"P:B->bool")] NUMBER_FIELD_RAMIFICATION_INDEX_TOWER_Q) THEN ASM_REWRITE_TAC [] THEN MP_TAC (← ISPECL [(← q r"k:A ring"), (← q r"p:A->bool")] NUMBER_FIELD_RATIONAL_RAMIFICATION_INDEX) THEN ANTS_TAC THENL [ASM_MESON_TAC [NUMBER_FIELD_HOMOMORPHIC_PREIMAGE], DISCH_THEN SUBST1_TAC] THEN FIRST_X_ASSUM (MP_TAC o (SPEC (← q r"p:A->bool"))) THEN ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o (MATCH_MP UNRAMIFIED_IMP_WEAKLY_UNRAMIFIED)) THEN REWRITE_TAC [weakly_unramified] THEN DISCH_THEN (MP_TAC o (SPEC (← q r"P:B->bool"))) THEN ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN ASM_ARITH_TAC)

  let NUMBER_FIELD_INERTIA_GROUPS_GENERATE ← prove
    r"!(h:A->B) k l.
        number_field l /\ galois_extension(k,l) h /\
        extension_degree(subfield_generated k {ring_0 k},k) I = 1
        ==> subgroup_generated (galois_group(k,l) h)
              (UNIONS {group_carrier
                        (inertia_group(k,l) h (ring_of_integers l) Q) |
                       Q | prime_ideal (ring_of_integers l) Q /\
                           ~(Q = {ring_0 l})}) =
            galois_group(k,l) h"
    (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"field k /\ ring_homomorphism(k,l) (h:A->B)") STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [GALOIS_IMP_FIELD_EXTENSION, field_extension, RING_MONOMORPHISM_IMP_HOMOMORPHISM], ALL_TAC] THEN SUBGOAL_THEN (← q r"finite_extension(k,l) (h:A->B)") ASSUME_TAC THENL [ASM_MESON_TAC [NUMBER_FIELD_TOWER_LAW], ALL_TAC] THEN ABBREV_TAC (← q r"H = group_carrier(subgroup_generated (galois_group(k,l) (h:A->B))
          (UNIONS {group_carrier
                    (inertia_group(k,l) h (ring_of_integers l) Q) |
                   Q | prime_ideal (ring_of_integers l) Q /\
                       ~(Q = {ring_0 l})}))") THEN SUBGOAL_THEN (← q r"H subgroup_of galois_group(k,l) (h:A->B)") ASSUME_TAC THENL [EXPAND_TAC "H" THEN REWRITE_TAC [SUBGROUP_SUBGROUP_GENERATED], ALL_TAC] THEN MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"k:A ring"), (← q r"l:B ring"), (← q r"H:(B->B)->bool")] GALOIS_GROUP_FIXED_FIELD) THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ABBREV_TAC (← q r"w = fixed_field l (H:(B->B)->bool)") THEN MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"k:A ring"), (← q r"l:B ring"), (← q r"w:B->bool")] NUMBER_FIELD_UNRAMIFIED_INERTIA_FIXED_FIELD) THEN ASM_SIMP_TAC [SUBFIELD_OF_IMP_SUBSET, SUBSET_REFL] THEN DISCH_TAC THEN MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"k:A ring"), (← q r"subfield_generated l (w:B->bool)")] NUMBER_FIELD_UNRAMIFIED_RATIONAL) THEN MP_TAC (← ISPECL [(← q r"h:A->B"), (← q r"k:A ring"), (← q r"l:B ring"), (← q r"w:B->bool")] NUMBER_FIELD_INTERMEDIATE_FIELD) THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [EXTENSION_DEGREE_EQ_1, field_extension] THEN DISCH_TAC THEN REWRITE_TAC [SUBGROUP_GENERATED_EQ] THEN ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q r"group_carrier(galois_group(subfield_generated l w,l) (I:B->B)) = H") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [EXTENSION] THEN X_GEN_TAC (← q r"f:B->B") THEN ASM_SIMP_TAC [IN_GALOIS_GROUP_SUBFIELD_GENERATED, NUMBER_FIELD_IMP_FIELD] THEN REWRITE_TAC [IN_GALOIS_GROUP] THEN UNDISCH_TAC (← q r"IMAGE (h:A->B) (ring_carrier k) = w") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [FORALL_IN_IMAGE])

  -- @@RETURN BEGIN
  return { NUMBER_FIELD_RATIONAL_RAMIFICATION_INDEX, NUMBER_FIELD_UNRAMIFIED_RATIONAL,
           NUMBER_FIELD_INERTIA_GROUPS_GENERATE }
  -- @@RETURN END

end HolANT.InertiaGenerators
