    specialize [([[r:R ring]]), ([[f:X->R]]), ([[\s:X. ring_0(r:R ring)]]), ([[S DELETE t DELETE (u:X)]])] RING_SUM_EQ THEN
    have' ([[ring_sum(r:R ring) (S DELETE (t:X) DELETE u) f = ring_sum r (S DELETE t DELETE u) (\i. ring_0 r)]]) [] THEN
