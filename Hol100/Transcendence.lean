def monic_QinC_squarefree_complex_squarefree_lemma : thm := keep "monic_QinC_squarefree_complex_squarefree_lemma" fun _ => (do
  let h1 ← rgl (← ExceptT.mk [[
        p = ring_mul(r:R ring) C qpd ==>
        ring_mul r C qp'd = ring_add r qpd (ring_mul r C D) ==>
        p = ring_mul r (ring_mul r C C) (ring_sub r qp'd D)
      ]])
  prove ([[
  !(r:R ring) C p qpd qp'd D:(1->num)->R.
  ring_polynomial r C ==>
  ring_polynomial r p ==>
  ring_polynomial r qpd ==>
  ring_polynomial r qp'd ==>
  ring_polynomial r D ==>
  p = poly_mul r C qpd ==>
  poly_mul r C qp'd = poly_add r qpd (poly_mul r C D) ==>
  p = poly_mul r (poly_mul r C C) (poly_sub r qp'd D)
]])
   (rw [x_poly_use, x_poly_sub_use] THEN
    intro THEN
    specialize [([[x_poly(r:R ring)]]), ([[C:(1->num)->R]]), ([[D:(1->num)->R]]), ([[p:(1->num)->R]]), ([[qp'd:(1->num)->R]]), ([[qpd:(1->num)->R]])] (← HolLight.GENL [([[r:R ring]]), ([[C:R]]), ([[D:R]]), ([[p:R]]), ([[qp'd:R]]), ([[qpd:R]])] h1) THEN
    qed [])
  : ExceptT String IO thm).run
