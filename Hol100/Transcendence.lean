def vandermonde_indep_range : thm := keep "vandermonde_indep_range" fun _ => (do
  let h13 ← num_linear_fact (← ExceptT.mk [[i < n+1 ==> ~(i < n) ==> i = n]])
  let h12 ← num_linear_fact (← ExceptT.mk [[0 < n+1]])
  let h11 ← num_linear_fact (← ExceptT.mk [[i < n:num ==> i < n+1]])
  let h10 ← num_linear_fact (← ExceptT.mk [[i < n:num ==> ~(i = n)]])
  let h9 ← num_linear_fact (← ExceptT.mk [[n < n+1]])
  let h8 ← ar (← ExceptT.mk [[i < n ==> i < n+1]])
  let h7 ← num_linear_fact (← ExceptT.mk [[e < n ==> e+1 < n+1]])
  let h6 ← num_linear_fact (← ExceptT.mk [[e < n ==> e < n+1]])
  let h5 ← num_linear_fact (← ExceptT.mk [[n < n+1]])
  let h4 ← num_linear_fact (← ExceptT.mk [[!i:num. i < n ==> i < n+1]])
  let h3 ← def' ([[d:num->R]]) (← ExceptT.mk [[\i:num. ring_mul r (c i) (ring_sub r (v i) (v n)):R]])
  let h2 ← ar (← ExceptT.mk [[SUC n = n+1]])
  let h1 ← ar (← ExceptT.mk [[~(i < 0)]])
  prove ([[
  !(r:R ring) n c v.
  integral_domain r ==>
  (!i. i < n ==> c i IN ring_carrier r) ==>
  (!i. i < n ==> v i IN ring_carrier r) ==>
  (!i j. i < n ==> j < n ==> v i = v j ==> i = j) ==>
  (!e. e < n ==> ring_sum r (range n) (\i. ring_mul r (c i) (ring_pow r (v i) e)) = ring_0 r) ==>
  (!i. i < n ==> c i = ring_0 r)
]])
