/- File: Hol100/Sqrt.lean
Translation of HOL Light's 100/sqrt.ml, phrase by phrase.
Part of the Lean4 translation of HOL Light by Chris Walton 2026.
-/
import Hol100.Common
import SessionLibrary.Floor
import SessionLibrary.Prime
open HolCore.Kernel Session HolLight.Syntax HolExamples
open SessionLibrary.Prime SessionLibrary.Floor
namespace Hol100.Sqrt

/- The session's `prove` lifted into `ExceptT String IO`, so tactic scripts
   read as the OCaml does. -/
private def prove (g : term) (tac : HolCore.Tactics.tactic) : ExceptT String IO thm :=
  ExceptT.mk (Session.prove g tac)
private def rf (tm : term) : ExceptT String IO thm := ExceptT.mk (REAL_FIELD tm)

/- ========================================================================= -/
/- Irrationality of sqrt(2) and more general results.                        -/
/- ========================================================================= -/

#eval phrase 1
-- needs "Library/prime.ml";;              (* For number-theoretic lemmas       *)
#eval SessionLibrary.Prime.ensurePrime

#eval phrase 2
-- needs "Library/floor.ml";;              (* For definition of rationals       *)
#eval SessionLibrary.Floor.ensureFloor

/- ------------------------------------------------------------------------- -/
/- Most general irrationality of square root result.                         -/
/- ------------------------------------------------------------------------- -/

#eval phrase 3
def IRRATIONAL_SQRT_NONSQUARE : thm := keep "IRRATIONAL_SQRT_NONSQUARE" fun _ => (do
  let h1 ← rf (← ExceptT.mk [[p = (n / m) pow 2 ==> ~(m = &0) ==> m pow 2 * p = n pow 2]])
  prove ([[!n. rational(sqrt(&n)) ==> ?m. n = m EXP 2]])
   (REWRITE_TAC [rational] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o HolLight.AP_TERM ([[\x:real. x pow 2]])) THEN
    SIMP_TAC [SQRT_POW_2, REAL_POS] THEN
    ONCE_REWRITE_TAC [(← HolLight.GSYM REAL_POW2_ABS)] THEN
    REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o HolLight.GEN_REWRITE_RULE HolCore.Lib.I [integer])) THEN
    ASM_REWRITE_TAC [REAL_ABS_DIV] THEN DISCH_THEN (MP_TAC o HolLight.MATCH_MP h1) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_ABS_ZERO], ALL_TAC] THEN
    REWRITE_TAC [REAL_OF_NUM_POW, REAL_OF_NUM_MUL, REAL_OF_NUM_EQ] THEN
    ASM_MESON_TAC [EXP_MULT_EXISTS, REAL_ABS_ZERO, REAL_OF_NUM_EQ])
  : ExceptT String IO thm).run
#eval IRRATIONAL_SQRT_NONSQUARE

/- ------------------------------------------------------------------------- -/
/- In particular, prime numbers.                                             -/
/- ------------------------------------------------------------------------- -/

#eval phrase 4
def IRRATIONAL_SQRT_PRIME : thm := keep "IRRATIONAL_SQRT_PRIME" fun _ => (do
  prove ([[!p. prime p ==> ~rational(sqrt(&p))]])
   (GEN_TAC THEN ONCE_REWRITE_TAC [(← HolLight.GSYM CONTRAPOS_THM)] THEN REWRITE_TAC [] THEN
    DISCH_THEN (CHOOSE_THEN SUBST1_TAC o HolLight.MATCH_MP IRRATIONAL_SQRT_NONSQUARE) THEN
    REWRITE_TAC [PRIME_EXP, ARITH_EQ])
  : ExceptT String IO thm).run
#eval IRRATIONAL_SQRT_PRIME

/- ------------------------------------------------------------------------- -/
/- In particular, sqrt(2) is irrational.                                     -/
/- ------------------------------------------------------------------------- -/

#eval phrase 5
def IRRATIONAL_SQRT_2 : thm := keep "IRRATIONAL_SQRT_2" fun _ => (do
  prove ([[~rational(sqrt(&2))]])
   (SIMP_TAC [IRRATIONAL_SQRT_PRIME, PRIME_2])
  : ExceptT String IO thm).run
#eval IRRATIONAL_SQRT_2

-- @@ENSURE BEGIN
/-- Replays this file, once per process (see Common.lean); generated by
    tools/tutorialdiff/ensuregen.py; keep it in step with the `#eval`s above. -/
def ensure : IO Unit := once "Hol100.Sqrt" do
  replay (
          SessionLibrary.Prime.ensurePrime)
  replay (
          SessionLibrary.Floor.ensureFloor)
  replay (
          IRRATIONAL_SQRT_NONSQUARE)
  replay (
          IRRATIONAL_SQRT_PRIME)
  replay (
          IRRATIONAL_SQRT_2)
-- @@ENSURE END

end Hol100.Sqrt
