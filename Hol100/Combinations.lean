import Hol100.Common
import SessionLibrary.Binomial
open HolCore.Kernel Session HolLight.Syntax HolExamples
open SessionLibrary.Binomial
namespace Hol100.Combinations

/- The session's `prove` lifted into `ExceptT String IO`, so tactic scripts
   read as the OCaml does. -/
private def prove (g : term) (tac : HolCore.Tactics.tactic) : ExceptT String IO thm :=
  ExceptT.mk (Session.prove g tac)

/- ========================================================================= -/
/- Binomial coefficients and relation to number of combinations.             -/
/- ========================================================================= -/

#eval phrase 1
-- needs "Library/binomial.ml";;
#eval SessionLibrary.Binomial.ensureBinomial

/- ------------------------------------------------------------------------- -/
/- The theorem is really proved in that library file; reformulate it a bit.  -/
/- ------------------------------------------------------------------------- -/

#eval phrase 2
def NUMBER_OF_COMBINATIONS : thm := keep "NUMBER_OF_COMBINATIONS" fun _ => (do
  prove ([[!n m s:A->bool.
        s HAS_SIZE n
        ==> {t | t SUBSET s /\ t HAS_SIZE m} HAS_SIZE binom(n,m)]])
   (MATCH_ACCEPT_TAC HAS_SIZE_RESTRICTED_POWERSET)
  : ExceptT String IO thm).run
#eval NUMBER_OF_COMBINATIONS

#eval phrase 3
def NUMBER_OF_COMBINATIONS_EXPLICIT : thm := keep "NUMBER_OF_COMBINATIONS_EXPLICIT" fun _ => (do
  prove ([[!n m s:A->bool.
        s HAS_SIZE n
        ==> {t | t SUBSET s /\ t HAS_SIZE m} HAS_SIZE
            (if n < m then 0 else FACT(n) DIV (FACT(m) * FACT(n - m)))]])
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o HolLight.SPEC ([[m:num]]) o HolLight.MATCH_MP NUMBER_OF_COMBINATIONS) THEN
    REWRITE_TAC [(← HolLight.GSYM NOT_LE), COND_SWAP, BINOM, MULT_AC])
  : ExceptT String IO thm).run
#eval NUMBER_OF_COMBINATIONS_EXPLICIT

-- @@ENSURE BEGIN
/-- Replays this file, once per process (see Common.lean); generated by
    tools/tutorialdiff/ensuregen.py; keep it in step with the `#eval`s above. -/
def ensure : IO Unit := once "Hol100.Combinations" do
  replay (
          SessionLibrary.Binomial.ensureBinomial)
  replay (
          NUMBER_OF_COMBINATIONS)
  replay (
          NUMBER_OF_COMBINATIONS_EXPLICIT)
-- @@ENSURE END

end Hol100.Combinations
