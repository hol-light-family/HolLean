    let t ← ExceptT.mk (HolCore.Parser.parse_term s)
    ExceptT.mk (Session.define t)
  parse_as_infix := Session.parse_as_infix
  make_overloadable s ty := ExceptT.mk (Session.make_overloadable s ty)
