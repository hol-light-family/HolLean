/-- Everything HolMultiLib.Derivatives needs from the session. -/
def deps : HolMultiLib.Derivatives.DerivativesDeps where
  dg := SessionMultiLib.Degree.deps
  FIX_TAC := Session.FIX_TAC
  HYP_TAC s rule := Session.HYP_TAC s (fun th => Session.runExceptThm (rule th).run)
  CLAIM_TAC := Session.DSL.CLAIM_TAC
  qconvex := qconvex
  qdegree := qdegree
  qdet := qdet
  qmetric := qmetric
  qmisc := qmisc
  qpaths := qpaths
  qpermutations := qpermutations
  qsession := qsession
  qtopology1 := qtopology1
  qtopology2 := qtopology2
  qvec := qvec

private def ioB {α : Type} (name : String) (x : IO (Except String α)) : IO α := do
  match ← x with
  | .ok d => pure d
  | .error e => throw (IO.userError s!"{name} failed: {e}")

