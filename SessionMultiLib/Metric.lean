/-- What metric.ml uses from hol.ml's library. -/
def deps : HolMultiLib.Metric.MetricDeps where
  new_definition s := do
    let t ← ExceptT.mk (HolCore.Parser.parse_term s)
    ExceptT.mk (Session.new_definition t)
  new_type_definition ty names th :=
    ExceptT.mk (Session.new_type_definition ty names.1 names.2 th)
  new_inductive_definition s := do
    let t ← ExceptT.mk (HolCore.Parser.parse_term s)
    ExceptT.mk (Session.new_inductive_definition t)
  define s := do
    let t ← ExceptT.mk (HolCore.Parser.parse_term s)
    ExceptT.mk (Session.define t)
  parse_as_infix := Session.parse_as_infix
  prioritize_real := Session.prioritize_real
  prove_general_recursive_function_exists := Session.prove_general_recursive_function_exists
  mk_setenum l := ExceptT.mk (Session.mk_setenum l)
  ARITH_RULE t := ExceptT.mk (Session.ARITH_RULE t)
  ARITH_TAC := Session.ARITH_TAC
  ASM_ARITH_TAC := Session.ASM_ARITH_TAC
  ASM_INT_ARITH_TAC := Session.ASM_INT_ARITH_TAC
  ASM_MESON_TAC := Session.ASM_MESON_TAC
