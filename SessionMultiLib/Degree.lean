  qtopology1 := qtopology1
  qtopology2 := qtopology2
  qvec := qvec

private def ioB {α : Type} [Inhabited α] (name : String) (x : IO (Except String α)) :
    IO α := do
  if !(← Session.bundlesWanted) then return default
  match ← x with
  | .ok d => pure d
  | .error e => throw (IO.userError s!"{name} failed: {e}")

/- The bundles, in degree.ml order. -/

initialize BDGA : HolMultiLib.Degree.DGA ←
  ioB "setupDGA" (HolMultiLib.Degree.setupDGA deps).run

