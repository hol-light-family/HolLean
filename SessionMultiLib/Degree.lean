/-- Everything HolMultiLib.Degree needs from the session. -/
def deps : HolMultiLib.Degree.DegreeDeps where
  prioritize_real := Session.prioritize_real
  pt := SessionMultiLib.Polytope.deps
  prove_general_recursive_function_exists t := ExceptT.mk (Session.prove_general_recursive_function_exists t)
  qconvex := qconvex
  qdet := qdet
  qhomology := qhomology
  qcard := qcard
  qfloor := qfloor
  qmetric := qmetric
