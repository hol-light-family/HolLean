/-- Run one bundle's setup at load, failing the load if it fails. -/
private def ioB {α : Type} (name : String) (x : IO (Except String α)) : IO α := do
  match ← x with
  | .ok d => pure d
  | .error e => throw (IO.userError s!"{name} failed: {e}")

/- The bundles, in determinants.ml order. -/
initialize BTrace : HolMultiLib.Determinants.Trace ←
  ioB "setupTrace" (HolMultiLib.Determinants.setupTrace deps).run
initialize BDetBasic : HolMultiLib.Determinants.DetBasic ←
  ioB "setupDetBasic" (HolMultiLib.Determinants.setupDetBasic deps BTrace).run
initialize BMultilinear : HolMultiLib.Determinants.Multilinear ←
  ioB "setupMultilinear" (HolMultiLib.Determinants.setupMultilinear deps BTrace BDetBasic).run
initialize BInvertibility : HolMultiLib.Determinants.Invertibility ←
  ioB "setupInvertibility"
    (HolMultiLib.Determinants.setupInvertibility deps BDetBasic BMultilinear).run
initialize BCramer : HolMultiLib.Determinants.Cramer ←
  ioB "setupCramer"
    (HolMultiLib.Determinants.setupCramer deps BDetBasic BMultilinear BInvertibility).run
initialize BCofactor : HolMultiLib.Determinants.Cofactor ←
  ioB "setupCofactor"
    (HolMultiLib.Determinants.setupCofactor deps BTrace BDetBasic BInvertibility BCramer).run
initialize BLowDim : HolMultiLib.Determinants.LowDim ←
  ioB "setupLowDim" (HolMultiLib.Determinants.setupLowDim deps BTrace BCofactor).run
initialize BParallel : HolMultiLib.Determinants.Parallel ←
  ioB "setupParallel" (HolMultiLib.Determinants.setupParallel deps BInvertibility BLowDim).run
initialize BCharPoly : HolMultiLib.Determinants.CharPoly ←
  ioB "setupCharPoly"
    (HolMultiLib.Determinants.setupCharPoly deps BTrace BDetBasic BInvertibility BLowDim).run
initialize BDiagonal : HolMultiLib.Determinants.Diagonal ←
  ioB "setupDiagonal" (HolMultiLib.Determinants.setupDiagonal deps BDetBasic BInvertibility).run
initialize BPsd : HolMultiLib.Determinants.Psd ←
  ioB "setupPsd" (HolMultiLib.Determinants.setupPsd deps BTrace BDiagonal).run
initialize BFrobenius : HolMultiLib.Determinants.Frobenius ←
  ioB "setupFrobenius" (HolMultiLib.Determinants.setupFrobenius deps BTrace BPsd).run
initialize BPosDef : HolMultiLib.Determinants.PosDef ←
  ioB "setupPosDef"
    (HolMultiLib.Determinants.setupPosDef deps BTrace BInvertibility BDiagonal BPsd).run
initialize BHadamard : HolMultiLib.Determinants.Hadamard ←
  ioB "setupHadamard"
    (HolMultiLib.Determinants.setupHadamard deps BDetBasic BMultilinear BDiagonal).run
initialize BOrth1 : HolMultiLib.Determinants.Orth1 ←
  ioB "setupOrth1"
    (HolMultiLib.Determinants.setupOrth1 deps BTrace BDetBasic BMultilinear BInvertibility
      BFrobenius).run
initialize BOrth2 : HolMultiLib.Determinants.Orth2 ←
  ioB "setupOrth2" (HolMultiLib.Determinants.setupOrth2 deps BOrth1).run
initialize BIso : HolMultiLib.Determinants.Iso ←
  ioB "setupIso" (HolMultiLib.Determinants.setupIso deps BOrth1 BOrth2).run
initialize BOpNorm : HolMultiLib.Determinants.OpNorm ←
  ioB "setupOpNorm"
    (HolMultiLib.Determinants.setupOpNorm deps BDiagonal BOrth1 BOrth2 BIso).run
initialize BRotation1 : HolMultiLib.Determinants.Rotation1 ←
  ioB "setupRotation1"
    (HolMultiLib.Determinants.setupRotation1 deps BDetBasic BLowDim BOrth1 BOrth2).run
initialize BRotation2 : HolMultiLib.Determinants.Rotation2 ←
  ioB "setupRotation2"
    (HolMultiLib.Determinants.setupRotation2 deps BDetBasic BMultilinear BInvertibility
      BLowDim BOrth1 BOrth2 BOpNorm BRotation1).run
initialize BHorizontal : HolMultiLib.Determinants.Horizontal ←
  ioB "setupHorizontal"
    (HolMultiLib.Determinants.setupHorizontal deps BDetBasic BOrth1 BOrth2 BIso
      BRotation2).run
initialize BMatrixInduct : HolMultiLib.Determinants.MatrixInduct ←
