/-- Everything HolMultiLib.Integration needs from the session. -/
def deps : HolMultiLib.Integration.IntegrationDeps where
  dv := SessionMultiLib.Derivatives.deps
  prioritize_real := Session.prioritize_real
  IMP_REWRITE_TAC := Session.IMP_REWRITE_TAC
  REFUTE_THEN := Session.REFUTE_THEN
  SUBST_VAR_TAC := Session.SUBST_VAR_TAC
  LABEL_ABBREV_TAC := SessionMultiLib.Metric.LABEL_ABBREV_TAC
  CUT_TAC := SessionMultiLib.Metric.CUT_TAC
  GEN_BETA_CONV := Session.GEN_BETA_CONV
  define s := do
    let t ← ExceptT.mk (HolCore.Parser.parse_term s)
    ExceptT.mk (Session.define t)
  cases s := ExceptT.mk (Session.cases s)
  distinctness s := ExceptT.mk (Session.distinctness s)
  injectivity s := ExceptT.mk (Session.injectivity s)
  qconvex := qconvex
  qderivatives := qderivatives
  qdet := qdet
  qcard := qcard
  qfloor := qfloor
  qproducts := qproducts
  qmetric := qmetric
  qmisc := qmisc
  qpaths := qpaths
  qpermutations := qpermutations
  qsession := qsession
  qtopology := qtopology
  qvec := qvec

private def ioB {α : Type} [Inhabited α] (name : String) (x : IO (Except String α)) :
    IO α := do
  if !(← Session.bundlesWanted) then return default
  match ← Session.quietly x with
  | .ok d => pure d
  | .error e => throw (IO.userError s!"{name} failed: {e}")

