/- File: HolTest/TraceTest.lean
Runtime test suite: the tracing switches `metisverb`, `Metis_unify.verb`
(metis.ml) and `copverb` (firstorder.ml, thecops.ml).
Part of the Lean4 translation of HOL Light by Chris Walton 2026.

Each check runs a prover with its switch on, CAPTURES what it prints (so
build.log stays quiet), and compares it with the text real HOL Light printed
for the same call (HOL Light on OCaml 5.3), ignoring whitespace: the line
breaks depend on the widths of counter-made names, which differ between
sessions.  Those names (`?N` type variables, `_N` genvars) are renumbered by
first appearance on both sides.  The expectations come
from a fresh HOL Light session after hol.ml, so the counters differ but the
text, the proof search, and the reconstruction must not.

The traces also check the search itself: METIS's printed proof and the
order of reconstruction steps changed with each of the faithfulness fixes
made while adding them (physical equality in `Thm.subst`, right folds in
`unify_fo_ho_term`, OCaml's stable `List.sort`). -/

import HolTest.CommonTest

open HolCore.Kernel Session HolTest.CommonTest

/-- Renumber counter-made names (`?N`, `_N`, `__N`) by first appearance. -/
private def renumber (s : String) : String := Id.run do
  let cs := s.toList.toArray
  let mut out := ""
  let mut seen : List (String × String) := []
  let mut i := 0
  while i < cs.size do
    let c := cs[i]!
    let prevAlnum := i > 0 && (cs[i-1]!.isAlphanum)
    if (c == '?' || (c == '_' && !prevAlnum)) then
      let mut j := i
      while j < cs.size && cs[j]! == c do j := j + 1
      let mut k := j
      while k < cs.size && cs[k]!.isDigit do k := k + 1
      if k > j then
        let tok := String.ofList (cs.extract i k).toList
        let pre := String.ofList (cs.extract i j).toList
        match seen.lookup tok with
        | some r => out := out ++ r
        | none =>
          let r := pre ++ "#" ++ toString seen.length
          seen := seen ++ [(tok, r)]; out := out ++ r
        i := k
      else
        out := out.push c; i := i + 1
    else
      out := out.push c; i := i + 1
  return out

/-- Run `act` with stdout captured; return what it printed. -/
private def capture (act : IO Unit) : IO String := do
  let buf ← IO.mkRef ({} : IO.FS.Stream.Buffer)
  let _ ← IO.withStdout (IO.FS.Stream.ofBuffer buf) (do act; HolCore.FirstOrder.stdFlush)
  return String.fromUTF8! (← buf.get).data

/-- Renumbered, with all whitespace removed: line breaking and indentation
    are ignored (an accepted difference), every other character counts. -/
private def norm (s : String) : List Char :=
  (renumber s).toList.filter (fun c => !c.isWhitespace)

/-- Run prover `f` on `g` with `flags` on; compare the trace with `expected`. -/
private unsafe def traceCheck (lbl : String) (flags : List (IO.Ref Bool))
    (f : term → IO (Except String thm)) (g expected : String) : IO Unit := do
  let tm ← match ← HolCore.Parser.parse_term g with
    | .ok t => pure t | .error e => throw (IO.userError e)
  for r in flags do r.set true
  let got ← try capture (do let _ ← f tm) finally for r in flags do r.set false
  let a := norm got
  let b := norm expected
  if a == b then IO.println s!"{lbl} ({a.length} chars) -> OK"
  else
    let i := ((a.zip b).findIdx? (fun (x, y) => x != y)).getD (min a.length b.length)
    let ctx (l : List Char) := String.ofList ((l.drop (i - 40)).take 100)
    IO.println s!"{lbl} -> MISMATCH at char {i}: got {ctx a} | want {ctx b}"

private unsafe def metisFlags : List (IO.Ref Bool) := [metisverb, metis_unify_verb]
private unsafe def copFlags : List (IO.Ref Bool) := [copverb]

