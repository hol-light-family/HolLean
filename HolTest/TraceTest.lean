/- `PRINT_ID_TAC s` prints `s` straight away; `PRINT_TAC` prints the goal on
   the formatter, unflushed (thecops.ml 1462-1463). -/
#eval traceCheck "trace PRINT_TAC" copFlags
  (fun tm => prove tm (THEN DISCH_TAC (THEN (PRINT_ID_TAC "here") (THEN PRINT_TAC (ASM_REWRITE_TAC [])))))
  "p ==> p"
  "here\n\n  0 [`p`]\n\n`p`\n\n  0 [`p`]\n\n`p`\n"

/- All switches are off by default, as in HOL Light: nothing is printed. -/
#eval (do
  let s ← capture (do let _ ← METIS [] [[(!x. P x ==> Q x) /\ P a ==> Q a]]
                      let _ ← NANOCOP [] [[(!x. P x ==> Q x) /\ P a ==> Q a]]
                      let _ ← LEANCOP [] [[(!x. P x ==> Q x) /\ P a ==> Q a]])
  IO.println s!"trace off by default -> {if s.isEmpty then "OK" else "MISMATCH printed " ++ toString s.length ++ " chars"}" : IO Unit)
