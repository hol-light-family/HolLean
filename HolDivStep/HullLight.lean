/- The tactics hull_light.ml defines for its generated proofs.               -/
/- (hull_light.ml 1-28; `["timing",...,Sys.time()]` lines are not            -/
/- translated: they only print the current time.)                            -/
/- ------------------------------------------------------------------------- -/

structure HullLightTactics where
  -- @@FIELDS
  def' : term → term → ExceptT String IO tactic
  notetac : term → tactic → tactic
  note : term → List thm → tactic
  choosevar : term → term → List thm → ExceptT String IO tactic
  num_linear : term → ExceptT String IO tactic
  int_linear : term → ExceptT String IO tactic
  real_linear : term → ExceptT String IO tactic
  real_cancel : term → ExceptT String IO tactic
  specialize : List term → thm → ExceptT String IO tactic
  twocases : term → List thm → ExceptT String IO tactic
  deriving Inhabited

@[nospecialize]
def setupHullLightTactics [HolBase] (D : HullLightDeps) :
    ExceptT String IO HullLightTactics := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INT_ARITH, ITAUT, MESON, REAL_ARITH, REAL_FIELD,
        TAUT, .. } := D
  let { IMP_CONJ, .. } := D.core1
  -- @@SCOPE END

  -- `let def n d = X_CHOOSE_TAC n (MESON [] (mk_exists (n, mk_eq (n, d))))`
  -- (`def` is a Lean keyword, hence `def'`); the MESON runs when it is
  -- applied, as in OCaml
  let def' : term → term → ExceptT String IO tactic ← pure (fun n d => do
    let mkEq ← ExceptT.mk mk_eq
    let e ← liftExcept (mkEq (n, d))
    let ex ← liftExcept (HolCore.Bool.mk_exists n e)
    pure (X_CHOOSE_TAC n (← MESON [] ex)))

  let notetac : term → tactic → tactic ← pure (fun t tac =>
    SUBGOAL_THEN t MP_TAC THENL
    [tac,
      ALL_TAC] THEN
    DISCH_THEN (fun th => ASSUME_TAC th))

  let note : term → List thm → tactic ← pure (fun t why =>
    notetac t (ASM_MESON_TAC why))

  -- `note(mk_exists (n, p)) why THEN X_CHOOSE_TAC n (UNDISCH (TAUT ...))`:
  -- the right operand first, so the TAUT before the left `mk_exists`
  let choosevar : term → term → List thm → ExceptT String IO tactic ← pure (fun n p why => do
    let ex1 ← liftExcept (HolCore.Bool.mk_exists n p)
    let ex2 ← liftExcept (HolCore.Bool.mk_exists n p)
    let r ← X_CHOOSE_TAC n <$> UNDISCH (← TAUT (← liftExcept (HolCore.Bool.mk_imp ex2 ex1)))
    let ex ← liftExcept (HolCore.Bool.mk_exists n p)
    pure (note ex why THEN r))

  let num_linear : term → ExceptT String IO tactic ← pure (fun t => do
    pure (ASSUME_TAC (← UNDISCH_ALL (← REWRITE_RULE [IMP_CONJ] (← ARITH_RULE t)))))

  let int_linear : term → ExceptT String IO tactic ← pure (fun t => do
    pure (ASSUME_TAC (← UNDISCH_ALL (← REWRITE_RULE [IMP_CONJ] (← INT_ARITH t)))))

  let real_linear : term → ExceptT String IO tactic ← pure (fun t => do
    pure (ASSUME_TAC (← UNDISCH_ALL (← REWRITE_RULE [IMP_CONJ] (← REAL_ARITH t)))))

  let real_cancel : term → ExceptT String IO tactic ← pure (fun t => do
    pure (ASSUME_TAC (← UNDISCH_ALL (← REWRITE_RULE [IMP_CONJ] (← REAL_FIELD t)))))

  let specialize : List term → thm → ExceptT String IO tactic ← pure (fun v th => do
    pure (ASSUME_TAC (← UNDISCH_ALL (← REWRITE_RULE [IMP_CONJ] (← ISPECL v th)))))

  -- `note c why THEN DISJ_CASES_TAC (UNDISCH (ITAUT (mk_imp (c,c))))`
  let twocases : term → List thm → ExceptT String IO tactic ← pure (fun c why => do
    let r ← DISJ_CASES_TAC <$> UNDISCH (← ITAUT (← liftExcept (HolCore.Bool.mk_imp c c)))
    pure (note c why THEN r))

  -- @@RETURN BEGIN
  return { def', notetac, note, choosevar, num_linear, int_linear, real_linear,
           real_cancel, specialize, twocases }
  -- @@RETURN END



