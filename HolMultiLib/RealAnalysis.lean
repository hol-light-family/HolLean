  let { vector_norm, .. } := D.ts.cn.cx.cpx
  let { CONTINUOUS_TRANSFORM_WITHIN, .. } := D.ts.cn.ms.ig.qtopology
  let { ETA_AX, EXTENSION, FORALL_AND_THM, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_IMP, IN, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTER, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_01, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_POW_LT, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_NEG, NORM_POS_LT, NORM_POW_2, .. } := D.ts.cn.cx.cvx.vec3
