@[nospecialize]
def setupRZA [HolBase] (D : RealAnalysisDeps) : ExceptT String IO RZA := do
  -- @@SCOPE BEGIN
  let { eventually, EVENTUALLY_TRIVIAL, IMAGE_COMPACT_IN, real_bounded, REAL_BOUNDED_POS,
        real_closed, real_compact_def, real_open, tendsto_real_def, .. } := D.qmetric
  let { IMAGE_LIFT_DROP, LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { BOUNDED_LIFT, COMPACT_IN_EUCLIDEAN, CONTINUOUS_MAP_DROP, CONTINUOUS_MAP_LIFT,
        LIM_EQ_LIFT, .. } := D.qtopology
  let { IN_REAL_INTERVAL, REAL_INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.qmisc
  let { LIM_COMPLEX_INV, LIM_COMPLEX_MUL, .. } := D.ts.knb
  let { prioritize_complex, .. } := D.ts.cn.cxa
  let { COMPLEX_NORM_CX, CX_INJ, CX_INV, CX_MUL, CX_SUB, IM_SUB, RE_SUB, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_GE_RE_IM, .. } := D.ts.cn.cxg
  let { REAL_POW_ZERO, .. } := D.ts.cn.ms.qsession
  let { ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, new_definition, parse_as_infix,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, .. } := D.ts.cn.cx.cvx
  let { real_sub, .. } := D.ts.cn.cx.cpx
  let { CONVERGENT_IMP_BOUNDED, LIM_NEG, LIM_NEG_EQ, SEQ_OFFSET_REV,
        .. } := D.ts.cn.ms.ig.qtopology
  let { AND_FORALL_THM, ETA_AX, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_FORALL, REAL_ADD_LID,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LET_TRANS, REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RZERO,
        REAL_MUL_SYM, REAL_SUB_RZERO, RIGHT_AND_FORALL_THM, SUBSET, SUBSET_TRANS,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_div, real_pow, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { FORALL_LIFT, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.ts.cn.cx.cvx.met
  let { BOUNDED_POS, BOUNDED_SUBSET, .. } := D.ts.cn.cx.cvx.top1
  let { LIM_ADD, LIM_CMUL, LIM_CONST, LIM_SUB, LIM_UNIQUE, .. } := D.ts.cn.cx.cvx.top4
  let { closed, SEQ_OFFSET, .. } := D.ts.cn.cx.cvx.top5
  let { REAL_ABS_ABS, .. } := D.ts.cn.ms.ig.dv.qsession
  let { LIM_TRANSFORM, LIM_TRANSFORM_EQ, LIM_TRANSFORM_EVENTUALLY, open_def,
        .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { EVENTUALLY_AND, .. } := D.ts.cn.ms.ig.dv.dg.qmetric
  let { BOUNDED_UNION, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { tendsto, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  prioritize_complex

  let REAL_OPEN ← prove
   r"!s. real_open s <=> open(IMAGE lift s)"
   (REWRITE_TAC [real_open, open_def, FORALL_IN_IMAGE, FORALL_LIFT, DIST_LIFT,
                 LIFT_IN_IMAGE_LIFT])

  let REAL_CLOSED ← prove
   r"!s. real_closed s <=> closed(IMAGE lift s)"
   (GEN_TAC THEN REWRITE_TAC [real_closed, REAL_OPEN, closed] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_IMAGE, IN_DIFF, IN_UNIV] THEN
    MESON_TAC [LIFT_DROP])

  let REAL_BOUNDED ← prove
   r"real_bounded s <=> bounded(IMAGE lift s)"
   (REWRITE_TAC [BOUNDED_LIFT, real_bounded])

  let REAL_BOUNDED_POS_LT ← prove
   r"!s. real_bounded s <=> ?b. &0 < b /\ !x. x IN s ==> abs(x) < b"
   (REWRITE_TAC [real_bounded] THEN
    MESON_TAC [REAL_LT_IMP_LE,
               ← REAL_ARITH (← q r"&0 < &1 + abs(y) /\ (x <= y ==> x < &1 + abs(y))")])

  let REAL_BOUNDED_SUBSET ← prove
   r"!s t. real_bounded t /\ s SUBSET t ==> real_bounded s"
   (MESON_TAC [REAL_BOUNDED, BOUNDED_SUBSET, IMAGE_SUBSET])

  let REAL_BOUNDED_UNION ← prove
   r"!s t. real_bounded(s UNION t) <=> real_bounded s /\ real_bounded t"
   (REWRITE_TAC [REAL_BOUNDED, IMAGE_UNION, BOUNDED_UNION])

  let REAL_BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC ← prove
   r"!s. real_bounded s ==> ?a. s SUBSET real_interval(--a,a)"
   (REWRITE_TAC [REAL_BOUNDED_POS, LEFT_IMP_EXISTS_THM, SUBSET] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real->bool", ← q r"b:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"b + &1") THEN X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC)

  let REAL_BOUNDED_SUBSET_OPEN_INTERVAL ← prove
   r"!s. real_bounded s ==> ?a b. s SUBSET real_interval(a,b)"
   (MESON_TAC [REAL_BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC])

  let REAL_BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC ← prove
   r"!s. real_bounded s ==> ?a. s SUBSET real_interval[--a,a]"
   (MESON_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED, SUBSET_TRANS,
               REAL_BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC])

  let REAL_BOUNDED_SUBSET_CLOSED_INTERVAL ← prove
   r"!s. real_bounded s ==> ?a b. s SUBSET real_interval[a,b]"
   (MESON_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED, SUBSET_TRANS,
               REAL_BOUNDED_SUBSET_OPEN_INTERVAL])

  let real_compact ← prove
   r"!s. real_compact s <=> compact(IMAGE lift s)"
   (GEN_TAC THEN REWRITE_TAC [real_compact_def, ← GSYM COMPACT_IN_EUCLIDEAN] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [MATCH_MP_TAC IMAGE_COMPACT_IN THEN EXISTS_TAC (← q r"euclideanreal") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_LIFT],
      GEN_REWRITE_TAC RAND_CONV [← GSYM IMAGE_LIFT_DROP] THEN
      REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"euclidean:(real^1)topology") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_DROP]])

  parse_as_infix ("--->", (12, "right"))

  let tendsto_real ← prove
   r"(f ---> l) net <=> !e. &0 < e ==> eventually (\x. abs(f(x) - l) < e) net"
   (REWRITE_TAC [tendsto_real_def, LIM_EQ_LIFT, tendsto, o_THM, DIST_LIFT])

  let reallim ← new_definition
   r"reallim net f = @l. (f ---> l) net"

  let TENDSTO_REAL ← prove
   r"(s ---> l) = ((lift o s) --> lift l)"
   (REWRITE_TAC [FUN_EQ_THM, tendsto, tendsto_real, o_THM, DIST_LIFT])

  let REAL_TENDSTO ← prove
   r"(s --> l) = (drop o s ---> drop l)"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_DROP, ETA_AX])

  let REALLIM_COMPLEX ← prove
   r"(s ---> l) = ((Cx o s) --> Cx(l))"
   (REWRITE_TAC [FUN_EQ_THM, tendsto, tendsto_real, o_THM, dist,
                 ← GSYM CX_SUB, COMPLEX_NORM_CX])

  let REALLIM_TRIVIAL ← prove
   r"!net f l. trivial_limit net ==> (f ---> l) net"
   (SIMP_TAC [tendsto_real, EVENTUALLY_TRIVIAL])

  let REALLIM_UNIQUE ← prove
   r"!net f l l'.
         ~trivial_limit net /\ (f ---> l) net /\ (f ---> l') net ==> l = l'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_UNIQUE) THEN REWRITE_TAC [LIFT_EQ])

  let REALLIM_CONST ← prove
   r"!net a. ((\x. a) ---> a) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIM_CONST])

  let REALLIM_LMUL ← prove
   r"!f l c. (f ---> l) net ==> ((\x. c * f x) ---> c * l) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_CMUL, LIM_CMUL])

  let REALLIM_RMUL ← prove
   r"!f l c. (f ---> l) net ==> ((\x. f x * c) ---> l * c) net"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [REALLIM_LMUL])

  let REALLIM_LMUL_EQ ← prove
   r"!net f l c.
        ~(c = &0) ==> (((\x. c * f x) ---> c * l) net <=> (f ---> l) net)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [REALLIM_LMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv c:real") o MATCH_MP REALLIM_LMUL) THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LID, ETA_AX])

  let REALLIM_RMUL_EQ ← prove
   r"!net f l c.
        ~(c = &0) ==> (((\x. f x * c) ---> l * c) net <=> (f ---> l) net)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [REALLIM_LMUL_EQ])

  let REALLIM_NEG ← prove
   r"!net f l. (f ---> l) net ==> ((\x. --(f x)) ---> --l) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_NEG, LIM_NEG])

  let REALLIM_NEG_EQ ← prove
   r"!net f l. ((\x. --(f x)) ---> --l) net <=> (f ---> l) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_NEG, LIM_NEG_EQ])

  let REALLIM_ADD ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net ==> ((\x. f(x) + g(x)) ---> l + m) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_ADD, LIM_ADD])

  let REALLIM_SUB ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net ==> ((\x. f(x) - g(x)) ---> l - m) net"
   (REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_SUB, LIM_SUB])

  let REALLIM_MUL ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net ==> ((\x. f(x) * g(x)) ---> l * m) net"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_MUL, LIM_COMPLEX_MUL])

  let REALLIM_INV ← prove
   r"!net f l.
         (f ---> l) net /\ ~(l = &0) ==> ((\x. inv(f x)) ---> inv l) net"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_INV, LIM_COMPLEX_INV, ← GSYM CX_INJ])

  let REALLIM_DIV ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net /\ ~(m = &0)
    ==> ((\x. f(x) / g(x)) ---> l / m) net"
   (SIMP_TAC [real_div, REALLIM_MUL, REALLIM_INV])

  let REALLIM_ABS ← prove
   r"!net f l. (f ---> l) net ==> ((\x. abs(f x)) ---> abs l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let REALLIM_POW ← prove
   r"!net f l n. (f ---> l) net ==> ((\x. f x pow n) ---> l pow n) net"
   (REPLICATE_TAC 3 GEN_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [real_pow, REALLIM_CONST, REALLIM_MUL])

  let REALLIM_MAX ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net
    ==> ((\x. max (f x) (g x)) ---> max l m) net"
   (REWRITE_TAC [← REAL_ARITH (← q r"max x y = inv(&2) * ((x + y) + abs(x - y))")] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REALLIM_LMUL THEN
    ASM_SIMP_TAC [REALLIM_ADD, REALLIM_ABS, REALLIM_SUB])

  let REALLIM_MIN ← prove
   r"!net:(A)net f g l m.
    (f ---> l) net /\ (g ---> m) net
    ==> ((\x. min (f x) (g x)) ---> min l m) net"
   (REWRITE_TAC [← REAL_ARITH (← q r"min x y = inv(&2) * ((x + y) - abs(x - y))")] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REALLIM_LMUL THEN
    ASM_SIMP_TAC [REALLIM_ADD, REALLIM_ABS, REALLIM_SUB])

  let REALLIM_NULL ← prove
   r"!net f l. (f ---> l) net <=> ((\x. f(x) - l) ---> &0) net"
   (REWRITE_TAC [tendsto_real, REAL_SUB_RZERO])

  let REALLIM_NULL_ADD ← prove
   r"!net:(A)net f g.
    (f ---> &0) net /\ (g ---> &0) net ==> ((\x. f(x) + g(x)) ---> &0) net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP REALLIM_ADD) THEN
    REWRITE_TAC [REAL_ADD_LID])

  let REALLIM_NULL_LMUL ← prove
   r"!net f c. (f ---> &0) net ==> ((\x. c * f x) ---> &0) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real") o MATCH_MP REALLIM_LMUL) THEN
    REWRITE_TAC [REAL_MUL_RZERO])

  let REALLIM_NULL_RMUL ← prove
   r"!net f c. (f ---> &0) net ==> ((\x. f x * c) ---> &0) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real") o MATCH_MP REALLIM_RMUL) THEN
    REWRITE_TAC [REAL_MUL_LZERO])

  let REALLIM_NULL_POW ← prove
   r"!net f n. (f ---> &0) net /\ ~(n = 0) ==> ((\x. f x pow n) ---> &0) net"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"n:num") o MATCH_MP REALLIM_POW) ASSUME_TAC) THEN
    ASM_REWRITE_TAC [REAL_POW_ZERO])

  let REALLIM_NULL_LMUL_EQ ← prove
   r"!net f c.
        ~(c = &0) ==> (((\x. c * f x) ---> &0) net <=> (f ---> &0) net)"
   (MESON_TAC [REALLIM_LMUL_EQ, REAL_MUL_RZERO])

  let REALLIM_NULL_RMUL_EQ ← prove
   r"!net f c.
        ~(c = &0) ==> (((\x. f x * c) ---> &0) net <=> (f ---> &0) net)"
   (MESON_TAC [REALLIM_RMUL_EQ, REAL_MUL_LZERO])

  let REALLIM_NULL_NEG ← prove
   r"!net f. ((\x. --(f x)) ---> &0) net <=> (f ---> &0) net"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← REAL_ARITH (← q r"--x = --(&1) * x")] THEN
    MATCH_MP_TAC REALLIM_NULL_LMUL_EQ THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let REALLIM_NULL_SUB ← prove
   r"!net:(A)net f g.
    (f ---> &0) net /\ (g ---> &0) net ==> ((\x. f(x) - g(x)) ---> &0) net"
   (SIMP_TAC [real_sub, REALLIM_NULL_ADD, REALLIM_NULL_NEG])

  let REALLIM_RE ← prove
   r"!net f l. (f --> l) net ==> ((Re o f) ---> Re l) net"
   (REWRITE_TAC [REALLIM_COMPLEX] THEN
    REWRITE_TAC [tendsto, dist, o_THM, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
    REWRITE_TAC [← GSYM RE_SUB, eventually] THEN
    MESON_TAC [REAL_LET_TRANS, COMPLEX_NORM_GE_RE_IM])

  let REALLIM_IM ← prove
   r"!net f l. (f --> l) net ==> ((Im o f) ---> Im l) net"
   (REWRITE_TAC [REALLIM_COMPLEX] THEN
    REWRITE_TAC [tendsto, dist, o_THM, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
    REWRITE_TAC [← GSYM IM_SUB, eventually] THEN
    MESON_TAC [REAL_LET_TRANS, COMPLEX_NORM_GE_RE_IM])

  let REALLIM_TRANSFORM_EVENTUALLY ← prove
   r"!net f g l.
        eventually (\x. f x = g x) net /\ (f ---> l) net ==> (g ---> l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    SIMP_TAC [o_THM])

  let REALLIM_TRANSFORM ← prove
   r"!net f g l.
        ((\x. f x - g x) ---> &0) net /\ (f ---> l) net ==> (g ---> l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF, LIFT_NUM, LIFT_SUB, LIM_TRANSFORM])

  let REALLIM_TRANSFORM_EQ ← prove
   r"!net f:A->real g l.
     ((\x. f x - g x) ---> &0) net ==> ((f ---> l) net <=> (g ---> l) net)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF, LIFT_NUM, LIFT_SUB, LIM_TRANSFORM_EQ])

  let REAL_SEQ_OFFSET ← prove
   r"!f l k. (f ---> l) sequentially ==> ((\i. f (i + k)) ---> l) sequentially"
   (REPEAT GEN_TAC THEN SIMP_TAC [TENDSTO_REAL, o_DEF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SEQ_OFFSET) THEN SIMP_TAC [])

  let REAL_SEQ_OFFSET_REV ← prove
   r"!f l k. ((\i. f (i + k)) ---> l) sequentially ==> (f ---> l) sequentially"
   (SIMP_TAC [TENDSTO_REAL, o_DEF] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SEQ_OFFSET_REV THEN EXISTS_TAC (← q r"k:num") THEN ASM_SIMP_TAC [])

  let REALLIM_TRANSFORM_STRADDLE ← prove
   r"!f g h a.
        eventually (\n. f(n) <= g(n)) net /\ (f ---> a) net /\
        eventually (\n. g(n) <= h(n)) net /\ (h ---> a) net
        ==> (g ---> a) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [RIGHT_AND_FORALL_THM, tendsto_real, AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REAL_ARITH_TAC)

  let REAL_CONVERGENT_IMP_BOUNDED ← prove
   r"!s l. (s ---> l) sequentially ==> real_bounded (IMAGE s (:num))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_BOUNDED, TENDSTO_REAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
    REWRITE_TAC [o_DEF, NORM_LIFT])

  let REALLIM_NULL_ABS ← prove
   r"!net f. ((\x. abs(f x)) ---> &0) net <=> (f ---> &0) net"
   (REWRITE_TAC [tendsto_real, REAL_SUB_RZERO, REAL_ABS_ABS])

  pure { REAL_OPEN, REAL_CLOSED, REAL_BOUNDED, REAL_BOUNDED_POS_LT, REAL_BOUNDED_SUBSET,
         REAL_BOUNDED_UNION, REAL_BOUNDED_SUBSET_OPEN_INTERVAL_SYMMETRIC,
         REAL_BOUNDED_SUBSET_OPEN_INTERVAL, REAL_BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC,
         REAL_BOUNDED_SUBSET_CLOSED_INTERVAL, real_compact, tendsto_real, reallim,
         TENDSTO_REAL, REAL_TENDSTO, REALLIM_COMPLEX, REALLIM_TRIVIAL, REALLIM_UNIQUE,
         REALLIM_CONST, REALLIM_LMUL, REALLIM_RMUL, REALLIM_LMUL_EQ, REALLIM_RMUL_EQ,
         REALLIM_NEG, REALLIM_NEG_EQ, REALLIM_ADD, REALLIM_SUB, REALLIM_MUL, REALLIM_INV,
         REALLIM_DIV, REALLIM_ABS, REALLIM_POW, REALLIM_MAX, REALLIM_MIN, REALLIM_NULL,
         REALLIM_NULL_ADD, REALLIM_NULL_LMUL, REALLIM_NULL_RMUL, REALLIM_NULL_POW,
         REALLIM_NULL_LMUL_EQ, REALLIM_NULL_RMUL_EQ, REALLIM_NULL_NEG, REALLIM_NULL_SUB,
         REALLIM_RE, REALLIM_IM, REALLIM_TRANSFORM_EVENTUALLY, REALLIM_TRANSFORM,
         REALLIM_TRANSFORM_EQ, REAL_SEQ_OFFSET, REAL_SEQ_OFFSET_REV,
         REALLIM_TRANSFORM_STRADDLE, REAL_CONVERGENT_IMP_BOUNDED, REALLIM_NULL_ABS }
/- ------------------------------------------------------------------------- -/
/- Limits of functions with real range (2).                                 -/
/- (realanalysis.ml 325-477)                                                -/
/- ------------------------------------------------------------------------- -/

structure RZB where
  REALLIM_WITHIN_LE : thm
  REALLIM_WITHIN : thm
  REALLIM_AT : thm
  REALLIM_AT_INFINITY : thm
  REALLIM_AT_INFINITY_COMPLEX_0 : thm
  REALLIM_SEQUENTIALLY : thm
  REALLIM_EVENTUALLY : thm
  LIM_COMPONENTWISE : thm
  REALLIM_UBOUND : thm
  REALLIM_LBOUND : thm
  REALLIM_LE : thm
  REALLIM_CONST_EQ : thm
  REALLIM_SUM : thm
  REALLIM_NULL_SUM : thm
  REALLIM_NULL_COMPARISON : thm
  CONVERGENT_REAL_BOUNDED_MONOTONE : thm
  REALLIM_EVENTUALLY_UBOUND : thm
  REALLIM_EVENTUALLY_LBOUND : thm
  REALLIM_SEQUENTIALLY_WITHIN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZB [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) : ExceptT String IO RZB := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, REALLIM_ADD, REALLIM_COMPLEX, REALLIM_CONST, REALLIM_NEG_EQ,
        REALLIM_SUB, tendsto_real, TENDSTO_REAL, .. } := BRZA
  let { EVENTUALLY_SEQUENTIALLY_WITHIN, .. } := D.qmetric
  let { EVENTUALLY_WITHIN_LE, .. } := D.qtopology
  let { num_INFINITE_EQ, .. } := D.qsession
  let { LIM_AT_INFINITY_COMPLEX_0, .. } := D.ts.knp
  let { CONVERGENT_BOUNDED_MONOTONE_1, .. } := D.ts.cn.ms.qtopology1
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { EVENTUALLY_AT_INFINITY, INFINITE, .. } := D.ts.cn.cx.cpx
  let { HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { LIM_CONST_EQ, LIM_DROP_UBOUND, .. } := D.ts.cn.ms.ig.qtopology
  let { CONJ_ASSOC, CONJ_SYM, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_NEG2, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_SUB_LE, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, SUM_0, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { EXISTS_LIFT, FORALL_DROP, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { EVENTUALLY_AT, EVENTUALLY_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { LIM_NULL_COMPARISON, .. } := D.ts.cn.cx.cvx.top4
  let { LIM_COMPONENTWISE_LIFT, .. } := D.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let REALLIM_WITHIN_LE ← prove
   r"!f:real^N->real l a s.
        (f ---> l) (at a within s) <=>
           !e. &0 < e ==> ?d. &0 < d /\
                              !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) <= d
                                   ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_WITHIN_LE])

  let REALLIM_WITHIN ← prove
   r"!f:real^N->real l a s.
      (f ---> l) (at a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x. x IN s /\ &0 < dist(x,a) /\ dist(x,a) < d
                    ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_WITHIN] THEN MESON_TAC [])

  let REALLIM_AT ← prove
   r"!f l a:real^N.
      (f ---> l) (at a) <=>
              !e. &0 < e
                  ==> ?d. &0 < d /\ !x. &0 < dist(x,a) /\ dist(x,a) < d
                          ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_AT] THEN MESON_TAC [])

  let REALLIM_AT_INFINITY ← prove
   r"!f l. (f ---> l) at_infinity <=>
               !e. &0 < e ==> ?b. !x. norm(x) >= b ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_AT_INFINITY] THEN MESON_TAC [])

  let REALLIM_AT_INFINITY_COMPLEX_0 ← prove
   r"!f l. (f ---> l) at_infinity <=> ((f o inv) ---> l) (at(Cx(&0)))"
   (REWRITE_TAC [REALLIM_COMPLEX, LIM_AT_INFINITY_COMPLEX_0] THEN
    REWRITE_TAC [o_ASSOC])

  let REALLIM_SEQUENTIALLY ← prove
   r"!s l. (s ---> l) sequentially <=>
          !e. &0 < e ==> ?N. !n. N <= n ==> abs(s(n) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_SEQUENTIALLY] THEN MESON_TAC [])

  let REALLIM_EVENTUALLY ← prove
   r"!net f l. eventually (\x. f x = l) net ==> (f ---> l) net"
   (SIMP_TAC [tendsto_real] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs(x - x) = &0")])

  let LIM_COMPONENTWISE ← prove
   r"!net f:A->real^N.
        (f --> l) net <=>
        !i. 1 <= i /\ i <= dimindex(:N) ==> ((\x. (f x)$i) ---> l$i) net"
   (ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT] THEN
    REWRITE_TAC [TENDSTO_REAL, o_DEF])

  let REALLIM_UBOUND ← prove
   r"!(net:A net) f l b.
        (f ---> l) net /\
        ~trivial_limit net /\
        eventually (\x. f x <= b) net
        ==> l <= b"
   (REWRITE_TAC [FORALL_DROP, TENDSTO_REAL, LIFT_DROP] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"net:A net") LIM_DROP_UBOUND) THEN
    EXISTS_TAC (← q r"lift o (f:A->real)") THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP])

  let REALLIM_LBOUND ← prove
   r"!(net:A net) f l b.
        (f ---> l) net /\
        ~trivial_limit net /\
        eventually (\x. b <= f x) net
        ==> b <= l"
   (ONCE_REWRITE_TAC [← GSYM REAL_LE_NEG2] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"net:A net") REALLIM_UBOUND) THEN
    EXISTS_TAC (← q r"\a:A. --(f a:real)") THEN
    ASM_REWRITE_TAC [REALLIM_NEG_EQ])

  let REALLIM_LE ← prove
   r"!net f g l m.
           (f ---> l) net /\ (g ---> m) net /\
           ~trivial_limit net /\
           eventually (\x. f x <= g x) net
           ==> l <= m"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o MATCH_MP REALLIM_SUB o ONCE_REWRITE_RULE [CONJ_SYM]) MP_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_LE] THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT, ← GSYM CONJ_ASSOC] THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP REALLIM_LBOUND))

  let REALLIM_CONST_EQ ← prove
   r"!net:(A net) c d. ((\x. c) ---> d) net <=> trivial_limit net \/ c = d"
   (REWRITE_TAC [TENDSTO_REAL, LIM_CONST_EQ, o_DEF, LIFT_EQ])

  let REALLIM_SUM ← prove
   r"!net f:A->B->real l s.
        FINITE s /\ (!i. i IN s ==> ((f i) ---> (l i)) net)
        ==> ((\x. sum s (\i. f i x)) ---> sum s l) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, REALLIM_CONST, REALLIM_ADD, IN_INSERT, ETA_AX])

  let REALLIM_NULL_SUM ← prove
   r"!net f:A->B->real s.
        FINITE s /\ (!a. a IN s ==> ((\x. f x a) ---> &0) net)
        ==> ((\x. sum s (f x)) ---> &0) net"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP REALLIM_SUM) THEN
    REWRITE_TAC [SUM_0, ETA_AX])

  let REALLIM_NULL_COMPARISON ← prove
   r"!net:(A)net f g.
        eventually (\x. abs(f x) <= g x) net /\ (g ---> &0) net
        ==> (f ---> &0) net"
   (REWRITE_TAC [TENDSTO_REAL, LIFT_NUM, o_DEF] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LIM_NULL_COMPARISON THEN
    EXISTS_TAC (← q r"g:A->real") THEN ASM_REWRITE_TAC [NORM_LIFT])

  let CONVERGENT_REAL_BOUNDED_MONOTONE ← prove
   r"!s. real_bounded(IMAGE s (:num)) /\
       ((!n. s n <= s(SUC n)) \/ (!n. s(SUC n) <= s n))
       ==> ?l. (s ---> l) sequentially"
   (GEN_TAC THEN REWRITE_TAC [REAL_BOUNDED, ← GSYM IMAGE_o] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      CONVERGENT_BOUNDED_MONOTONE_1)) THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP, TENDSTO_REAL, EXISTS_LIFT])

  let REALLIM_EVENTUALLY_UBOUND ← prove
   r"!net f l c. (f ---> l) net /\ l < c ==> eventually (\x:A. f x < c) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real] THEN
    INTRO_TAC "lim lt" THEN HYP_TAC "lim: +" (SPEC (← q r"(c - l) / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    ASM_REAL_ARITH_TAC)

  let REALLIM_EVENTUALLY_LBOUND ← prove
   r"!net f l c. (f ---> l) net /\ c < l ==> eventually (\x:A. c < f x) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real] THEN
    INTRO_TAC "lim lt" THEN HYP_TAC "lim: +" (SPEC (← q r"(l - c) / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    ASM_REAL_ARITH_TAC)

  let REALLIM_SEQUENTIALLY_WITHIN ← prove
   r"!f l s. (f ---> l) sequentially ==> (f ---> l) (sequentially within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [tendsto_real, EVENTUALLY_SEQUENTIALLY,
                 EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
    ASM_CASES_TAC (← q r"FINITE (s:num->bool)") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (MP_TAC o REWRITE_RULE [← GSYM INFINITE, num_INFINITE_EQ]) THEN
    MESON_TAC [])

  pure { REALLIM_WITHIN_LE, REALLIM_WITHIN, REALLIM_AT, REALLIM_AT_INFINITY,
         REALLIM_AT_INFINITY_COMPLEX_0, REALLIM_SEQUENTIALLY, REALLIM_EVENTUALLY,
         LIM_COMPONENTWISE, REALLIM_UBOUND, REALLIM_LBOUND, REALLIM_LE, REALLIM_CONST_EQ,
         REALLIM_SUM, REALLIM_NULL_SUM, REALLIM_NULL_COMPARISON,
         CONVERGENT_REAL_BOUNDED_MONOTONE, REALLIM_EVENTUALLY_UBOUND,
         REALLIM_EVENTUALLY_LBOUND, REALLIM_SEQUENTIALLY_WITHIN }
/- ------------------------------------------------------------------------- -/
/- Real series.                                                              -/
/- (realanalysis.ml 478-877)                                                -/
/- ------------------------------------------------------------------------- -/

structure RZC where
  real_sums : thm
  real_infsum : thm
  real_summable : thm
  REAL_SUMS : thm
  REAL_SUMS_RE : thm
  REAL_SUMS_IM : thm
  REAL_SUMS_COMPLEX : thm
  REAL_SUMMABLE : thm
  REAL_SUMMABLE_COMPLEX : thm
  REAL_SERIES_CAUCHY : thm
  REAL_SUMMABLE_CAUCHY : thm
  REAL_SUMS_SUMMABLE : thm
  REAL_SUMS_INFSUM : thm
  REAL_INFSUM_COMPLEX : thm
  REAL_SERIES_FROM : thm
  REAL_SERIES_UNIQUE : thm
  REAL_INFSUM_UNIQUE : thm
  REAL_SERIES_FINITE : thm
  REAL_SUMMABLE_FINITE : thm
  REAL_SUMMABLE_IFF_EVENTUALLY : thm
  REAL_SUMMABLE_EQ_EVENTUALLY : thm
  REAL_SUMMABLE_IFF_COFINITE : thm
  REAL_SUMMABLE_EQ_COFINITE : thm
  REAL_SUMMABLE_FROM_ELSEWHERE : thm
  REAL_SUMMABLE_FROM_ELSEWHERE_EQ : thm
  REAL_SERIES_GOESTOZERO : thm
  REAL_SUMMABLE_IMP_TOZERO : thm
  REAL_SUMMABLE_IMP_BOUNDED : thm
  REAL_SUMMABLE_IMP_REAL_SUMS_BOUNDED : thm
  REAL_SERIES_0 : thm
  REAL_SERIES_ADD : thm
  REAL_SERIES_SUB : thm
  REAL_SERIES_LMUL : thm
  REAL_SERIES_RMUL : thm
  REAL_SERIES_NEG : thm
  REAL_SERIES_FINITE_SUM : thm
  REAL_SUMS_IFF : thm
  REAL_SUMS_EQ : thm
  REAL_SERIES_FINITE_SUPPORT : thm
  REAL_SERIES_DIFFS : thm
  REAL_SERIES_TRIVIAL : thm
  REAL_SERIES_RESTRICT : thm
  REAL_SERIES_SUM : thm
  REAL_SUMS_REINDEX : thm
  REAL_SERIES_EVEN : thm
  REAL_SERIES_ODD : thm
  REAL_INFSUM : thm
  REAL_PARTIAL_SUMS_LE_INFSUM : thm
  REAL_PARTIAL_SUMS_LE_INFSUM_GEN : thm
  REAL_SERIES_TERMS_TOZERO : thm
  REAL_SERIES_LE : thm
  REAL_SERIES_POS : thm
  REAL_SERIES_BOUND : thm
  REAL_SERIES_COMPARISON_BOUND : thm
  REAL_SERIES_MUL : thm
  REAL_SERIES_MUL_UNIQUE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZC [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) : ExceptT String IO RZC := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, REAL_CONVERGENT_IMP_BOUNDED, REAL_SEQ_OFFSET, REALLIM_ADD,
        REALLIM_COMPLEX, REALLIM_CONST, REALLIM_IM, REALLIM_LMUL, REALLIM_NEG, REALLIM_RE,
        REALLIM_RMUL, REALLIM_SUB, REALLIM_TRANSFORM_EVENTUALLY, REALLIM_UNIQUE,
        TENDSTO_REAL, .. } := BRZA
  let { REALLIM_SEQUENTIALLY, .. } := BRZB
  let { PARTIAL_SUMS_DROP_LE_INFSUM, SERIES_BOUND, SERIES_COMPARISON_BOUND, SERIES_DROP_LE,
        SERIES_DROP_POS, SERIES_EVEN, SERIES_GOESTOZERO, SERIES_ODD, SUMMABLE_IFF_COFINITE,
        SUMMABLE_IFF_EVENTUALLY, SUMMABLE_IMP_TOZERO, .. } := D.qtopology
  let { «from», .. } := D.qmisc
  let { num_FINITE, .. } := D.qsession
  let { REAL_SERIES, .. } := D.ts.knm
  let { SERIES_TERMS_TOZERO, .. } := D.ts.qtopology
  let { IN_FROM, .. } := D.ts.qmisc
  let { RE_CX, .. } := D.ts.cn.cxc
  let { IM_VSUM, RE_VSUM, REAL, REAL_CX, VSUM_CX, .. } := D.ts.cn.cxi
  let { INFSUM_UNIQUE, SERIES_BILINEAR, SERIES_BILINEAR_UNIQUE, SERIES_CAUCHY, summable,
        SUMMABLE_IMP_BOUNDED, .. } := D.ts.cn.qtopology
  let { SUM_DIFFS, .. } := D.ts.cn.qsession
  let { FROM_INTER_NUMSEG, .. } := D.ts.cn.ms.qmisc
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, new_definition,
        parse_as_infix, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { LE_0, .. } := D.ts.cn.cx.cpx
  let { UPPER_BOUND_FINITE_SET, .. } := D.ts.cn.ms.ig.qmisc
  let { NORM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { COND_RAND, ETA_AX, EXTENSION, FINITE_INDUCT_STRONG, FINITE_INTER, FINITE_NUMSEG, FINITE_SUBSET,
        .. } := D.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMAGE_o, IMP_CONJ, IN_DIFF, INTER_EMPTY, INTER_UNIV,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNION, LE_TRANS, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, REAL_ABS_NUM, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { numseg, o_DEF, o_THM, SUM_0, SUM_ADD, SUM_CLAUSES, SUM_EQ, SUM_LMUL, SUM_NEG,
        SUM_RMUL, SUM_SUB, SUM_SUBSET_SIMPLE, SUM_SUPERSET, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_CMUL, DROP_VSUM, EXISTS_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_1,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { FINITE_INTER_NUMSEG, .. } := D.ts.cn.ms.ig.dv.qmisc
  let { sums, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { BILINEAR_DROP_MUL, .. } := D.ts.cn.ms.ig.dv.qvec
  let { SUM_OFFSET, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  parse_as_infix ("real_sums", (12, "right"))

  let real_sums ← new_definition
   r"(f real_sums l) s <=> ((\n. sum (s INTER (0..n)) f) ---> l) sequentially"

  let real_infsum ← new_definition
   r"real_infsum s f = @l. (f real_sums l) s"

  let real_summable ← new_definition
   r"real_summable s f = ?l. (f real_sums l) s"

  let REAL_SUMS ← prove
   r"(f real_sums l) = ((lift o f) sums (lift l))"
   (REWRITE_TAC [FUN_EQ_THM, sums, real_sums, TENDSTO_REAL] THEN
    SIMP_TAC [LIFT_SUM, FINITE_INTER_NUMSEG, o_DEF])

  let REAL_SUMS_RE ← prove
   r"!f l s. (f sums l) s ==> ((Re o f) real_sums (Re l)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums, sums] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REALLIM_RE) THEN
    SIMP_TAC [o_DEF, RE_VSUM, FINITE_INTER_NUMSEG])

  let REAL_SUMS_IM ← prove
   r"!f l s. (f sums l) s ==> ((Im o f) real_sums (Im l)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums, sums] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REALLIM_IM) THEN
    SIMP_TAC [o_DEF, IM_VSUM, FINITE_INTER_NUMSEG])

  let REAL_SUMS_COMPLEX ← prove
   r"!f l s. (f real_sums l) s <=> ((Cx o f) sums (Cx l)) s"
   (REWRITE_TAC [real_sums, sums, REALLIM_COMPLEX] THEN
    SIMP_TAC [o_DEF, VSUM_CX, FINITE_INTER, FINITE_NUMSEG])

  let REAL_SUMMABLE ← prove
   r"real_summable s f <=> summable s (lift o f)"
   (REWRITE_TAC [real_summable, summable, REAL_SUMS, ← GSYM EXISTS_LIFT])

  let REAL_SUMMABLE_COMPLEX ← prove
   r"real_summable s f <=> summable s (Cx o f)"
   (REWRITE_TAC [real_summable, summable, REAL_SUMS_COMPLEX] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"l:complex")) THEN EXISTS_TAC (← q r"Re l") THEN
    SUBGOAL_THEN (← q r"Cx(Re l) = l") (fun th => ASM_REWRITE_TAC [th]) THEN
    REWRITE_TAC [← GSYM REAL] THEN MATCH_MP_TAC REAL_SERIES THEN
    MAP_EVERY EXISTS_TAC [← q r"Cx o (f:num->real)", ← q r"s:num->bool"] THEN
    ASM_REWRITE_TAC [o_THM, REAL_CX])

  let REAL_SERIES_CAUCHY ← prove
   r"(?l. (f real_sums l) s) <=>
   (!e. &0 < e ==> ?N. !m n. m >= N ==> abs(sum(s INTER (m..n)) f) < e)"
   (REWRITE_TAC [REAL_SUMS, SERIES_CAUCHY, ← GSYM EXISTS_LIFT] THEN
    SIMP_TAC [NORM_REAL, ← GSYM drop, DROP_VSUM, FINITE_INTER_NUMSEG] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX])

  let REAL_SUMMABLE_CAUCHY ← prove
   r"!f s. real_summable s f <=>
         !e. &0 < e
             ==> ?N. !m n. m >= N ==> abs(sum(s INTER (m..n)) f) < e"
   (REWRITE_TAC [real_summable, ← GSYM REAL_SERIES_CAUCHY])

  let REAL_SUMS_SUMMABLE ← prove
   r"!f l s. (f real_sums l) s ==> real_summable s f"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [])

  let REAL_SUMS_INFSUM ← prove
   r"!f s. (f real_sums (real_infsum s f)) s <=> real_summable s f"
   (REWRITE_TAC [real_infsum, real_summable] THEN MESON_TAC [])

  let REAL_INFSUM_COMPLEX ← prove
   r"!f s. real_summable s f ==> real_infsum s f = Re(infsum s (Cx o f))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM REAL_SUMS_INFSUM, REAL_SUMS_COMPLEX] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INFSUM_UNIQUE) THEN
    MESON_TAC [RE_CX])

  let REAL_SERIES_FROM ← prove
   r"!f l k. (f real_sums l) (from k) = ((\n. sum(k..n) f) ---> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, numseg, «from», IN_ELIM_THM, IN_INTER] THEN ARITH_TAC)

  let REAL_SERIES_UNIQUE ← prove
   r"!f l l' s. (f real_sums l) s /\ (f real_sums l') s ==> l = l'"
   (REWRITE_TAC [real_sums] THEN
    MESON_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, REALLIM_UNIQUE])

  let REAL_INFSUM_UNIQUE ← prove
   r"!f l s. (f real_sums l) s ==> real_infsum s f = l"
   (MESON_TAC [REAL_SERIES_UNIQUE, REAL_SUMS_INFSUM, real_summable])

  let REAL_SERIES_FINITE ← prove
   r"!f s. FINITE s ==> (f real_sums (sum s f)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [num_FINITE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [real_sums, REALLIM_SEQUENTIALLY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"n:num") THEN
    X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s INTER (0..m) = s")
     (fun th => ASM_REWRITE_TAC [th, REAL_SUB_REFL, REAL_ABS_NUM]) THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN
    ASM_MESON_TAC [LE_TRANS])

  let REAL_SUMMABLE_FINITE ← prove
   r"!k f. FINITE k ==> real_summable k f"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_FINITE])

  let REAL_SUMMABLE_IFF_EVENTUALLY ← prove
   r"!f g k. (?N. !n. N <= n /\ n IN k ==> f n = g n)
           ==> (real_summable k f <=> real_summable k g)"
   (REWRITE_TAC [REAL_SUMMABLE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUMMABLE_IFF_EVENTUALLY THEN REWRITE_TAC [o_THM] THEN
    ASM_MESON_TAC [])

  let REAL_SUMMABLE_EQ_EVENTUALLY ← prove
   r"!f g k. (?N. !n. N <= n /\ n IN k ==> f n = g n) /\ real_summable k f
           ==> real_summable k g"
   (MESON_TAC [REAL_SUMMABLE_IFF_EVENTUALLY])

  let REAL_SUMMABLE_IFF_COFINITE ← prove
   r"!f s t. FINITE((s DIFF t) UNION (t DIFF s))
           ==> (real_summable s f <=> real_summable t f)"
   (SIMP_TAC [REAL_SUMMABLE] THEN MESON_TAC [SUMMABLE_IFF_COFINITE])

  let REAL_SUMMABLE_EQ_COFINITE ← prove
   r"!f s t. FINITE((s DIFF t) UNION (t DIFF s)) /\ real_summable s f
           ==> real_summable t f"
   (MESON_TAC [REAL_SUMMABLE_IFF_COFINITE])

  let REAL_SUMMABLE_FROM_ELSEWHERE ← prove
   r"!f m n. real_summable (from m) f ==> real_summable (from n) f"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_SUMMABLE_EQ_COFINITE) THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"0..(m+n)") THEN
    SIMP_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, IN_UNION, IN_DIFF, IN_FROM] THEN
    ARITH_TAC)

  let REAL_SUMMABLE_FROM_ELSEWHERE_EQ ← prove
   r"!n m f. real_summable (from m) f <=> real_summable (from n) f"
   (MESON_TAC [REAL_SUMMABLE_FROM_ELSEWHERE])

  let REAL_SERIES_GOESTOZERO ← prove
   r"!s x. real_summable s x
         ==> !e. &0 < e
                 ==> eventually (\n. n IN s ==> abs(x n) < e) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_SUMMABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SERIES_GOESTOZERO) THEN
    REWRITE_TAC [o_THM, NORM_LIFT])

  let REAL_SUMMABLE_IMP_TOZERO ← prove
   r"!f:num->real k.
       real_summable k f
       ==> ((\n. if n IN k then f(n) else &0) ---> &0) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_SUMMABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUMMABLE_IMP_TOZERO) THEN
    REWRITE_TAC [TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF, ← GSYM LIFT_NUM, ← GSYM COND_RAND])

  let REAL_SUMMABLE_IMP_BOUNDED ← prove
   r"!f:num->real k. real_summable k f ==> real_bounded (IMAGE f k)"
   (REWRITE_TAC [REAL_BOUNDED, REAL_SUMMABLE, ← GSYM IMAGE_o,
                 SUMMABLE_IMP_BOUNDED])

  let REAL_SUMMABLE_IMP_REAL_SUMS_BOUNDED ← prove
   r"!f:num->real k.
       real_summable (from k) f ==> real_bounded { sum(k..n) f | n IN (:num) }"
   (REWRITE_TAC [real_summable, real_sums, LEFT_IMP_EXISTS_THM] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_CONVERGENT_IMP_BOUNDED) THEN
    REWRITE_TAC [FROM_INTER_NUMSEG, SIMPLE_IMAGE])

  let REAL_SERIES_0 ← prove
   r"!s. ((\n. &0) real_sums (&0)) s"
   (REWRITE_TAC [real_sums, SUM_0, REALLIM_CONST])

  let REAL_SERIES_ADD ← prove
   r"!x x0 y y0 s.
     (x real_sums x0) s /\ (y real_sums y0) s
     ==> ((\n. x n + y n) real_sums (x0 + y0)) s"
   (SIMP_TAC [real_sums, FINITE_INTER_NUMSEG, SUM_ADD, REALLIM_ADD])

  let REAL_SERIES_SUB ← prove
   r"!x x0 y y0 s.
     (x real_sums x0) s /\ (y real_sums y0) s
     ==> ((\n. x n - y n) real_sums (x0 - y0)) s"
   (SIMP_TAC [real_sums, FINITE_INTER_NUMSEG, SUM_SUB, REALLIM_SUB])

  let REAL_SERIES_LMUL ← prove
   r"!x x0 c s. (x real_sums x0) s ==> ((\n. c * x n) real_sums (c * x0)) s"
   (SIMP_TAC [real_sums, FINITE_INTER_NUMSEG, SUM_LMUL, REALLIM_LMUL])

  let REAL_SERIES_RMUL ← prove
   r"!x x0 c s. (x real_sums x0) s ==> ((\n. x n * c) real_sums (x0 * c)) s"
   (SIMP_TAC [real_sums, FINITE_INTER_NUMSEG, SUM_RMUL, REALLIM_RMUL])

  let REAL_SERIES_NEG ← prove
   r"!x x0 s. (x real_sums x0) s ==> ((\n. --(x n)) real_sums (--x0)) s"
   (SIMP_TAC [real_sums, FINITE_INTER_NUMSEG, SUM_NEG, REALLIM_NEG])

  let REAL_SERIES_FINITE_SUM ← prove
   r"!(f:A->num->real) l k s.
        FINITE k /\ (!i. i IN k ==> (f i real_sums l i) s)
        ==> ((\n. sum k (\i. f i n)) real_sums (sum k l)) s"
   (← do
    let skl ← q r"sum k (l:A->real)"
    pure (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, REAL_SERIES_0, IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_SERIES_ADD THEN CONJ_TAC THENL
     [REWRITE_TAC [ETA_AX] THEN FIRST_X_ASSUM (MATCH_MP_TAC o check (α := thm) (fun th =>
        HolCore.Basics.is_forall (concl th) &&
        (HolCore.Basics.dest_forall (concl th)).toOption.any (fun (p : term × term) => let b := p.2;
           (lhand b).toOption.any HolCore.Basics.is_disj))) THEN
      REWRITE_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o check (α := thm) (fun th =>
        HolCore.Basics.is_forall (concl th) && HolCore.Basics.free_in skl (concl th))) THEN
      ASM_SIMP_TAC []]))

  let REAL_SUMS_IFF ← prove
   r"!f g k. (!x. x IN k ==> f x = g x)
           ==> ((f real_sums l) k <=> (g real_sums l) k)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    MATCH_MP_TAC SUM_EQ THEN ASM_SIMP_TAC [IN_INTER])

  let REAL_SUMS_EQ ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) /\ (f real_sums l) k
           ==> (g real_sums l) k"
   (MESON_TAC [REAL_SUMS_IFF])

  let REAL_SERIES_FINITE_SUPPORT ← prove
   r"!f s k.
     FINITE (s INTER k) /\ (!x. ~(x IN s INTER k) ==> f x = &0)
     ==> (f real_sums sum(s INTER k) f) k"
   (REWRITE_TAC [real_sums, REALLIM_SEQUENTIALLY] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:num. x") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"sum (k INTER (0..n)) (f:num->real) = sum(s INTER k) f")
     (fun th => ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_NUM, th]) THEN
    MATCH_MP_TAC SUM_SUPERSET THEN
    ASM_SIMP_TAC [SUBSET, IN_INTER, IN_NUMSEG, LE_0] THEN
    ASM_MESON_TAC [IN_INTER, LE_TRANS])

  let REAL_SERIES_DIFFS ← prove
   r"!f k. (f ---> &0) sequentially
         ==> ((\n. f(n) - f(n + 1)) real_sums f(k)) (from k)"
   (REWRITE_TAC [real_sums, FROM_INTER_NUMSEG, SUM_DIFFS] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REALLIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. (f:num->real) k - f(n + 1)") THEN CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"k:num") THEN
      SIMP_TAC [],
      GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_SUB_RZERO] THEN
      MATCH_MP_TAC REALLIM_SUB THEN REWRITE_TAC [REALLIM_CONST] THEN
      MATCH_MP_TAC REAL_SEQ_OFFSET THEN ASM_REWRITE_TAC []])

  let REAL_SERIES_TRIVIAL ← prove
   r"!f. (f real_sums &0) {}"
   (REWRITE_TAC [real_sums, INTER_EMPTY, SUM_CLAUSES, REALLIM_CONST])

  let REAL_SERIES_RESTRICT ← prove
   r"!f k l:real.
        ((\n. if n IN k then f(n) else &0) real_sums l) (:num) <=>
        (f real_sums l) k"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums] THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, INTER_UNIV] THEN GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"sum s f = sum t f /\ sum t f = sum t g
                          ==> sum s f = sum t g")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_SUPERSET THEN SET_TAC [],
      MATCH_MP_TAC SUM_EQ THEN SIMP_TAC [IN_INTER]])

  let REAL_SERIES_SUM ← prove
   r"!f l k s. FINITE s /\ s SUBSET k /\ (!x. ~(x IN s) ==> f x = &0) /\
             sum s f = l ==> (f real_sums l) k"
   (REPEAT STRIP_TAC THEN EXPAND_TAC "l" THEN
    SUBGOAL_THEN (← q r"s INTER k = s:num->bool") ASSUME_TAC THENL
     [ASM SET_TAC [], ASM_MESON_TAC [REAL_SERIES_FINITE_SUPPORT]])

  let REAL_SUMS_REINDEX ← prove
   r"!k a l n.
     ((\x. a(x + k)) real_sums l) (from n) <=> (a real_sums l) (from(n + k))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums, FROM_INTER_NUMSEG] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SUM_OFFSET] THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY] THEN
    ASM_MESON_TAC [← ARITH_RULE (← q r"N + k:num <= n ==> n = (n - k) + k /\ N <= n - k"),
                   ← ARITH_RULE (← q r"N + k:num <= n ==> N <= n + k")])

  let REAL_SERIES_EVEN ← prove
   r"!f l n.
    (f real_sums l) (from n) <=>
    ((\i. if EVEN i then f(i DIV 2) else &0) real_sums l) (from (2 * n))"
   (REWRITE_TAC [REAL_SUMS, o_DEF, COND_RAND, LIFT_NUM] THEN
    REWRITE_TAC [← GSYM SERIES_EVEN])

  let REAL_SERIES_ODD ← prove
   r"!f l n.
    (f real_sums l) (from n) <=>
    ((\i. if ODD i then f(i DIV 2) else &0) real_sums l) (from (2 * n + 1))"
   (REWRITE_TAC [REAL_SUMS, o_DEF, COND_RAND, LIFT_NUM] THEN
    REWRITE_TAC [← GSYM SERIES_ODD])

  let REAL_INFSUM ← prove
   r"!f s. real_summable s f ==> real_infsum s f = drop(infsum s (lift o f))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM REAL_SUMS_INFSUM, REAL_SUMS] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INFSUM_UNIQUE) THEN
    MESON_TAC [LIFT_DROP])

  let REAL_PARTIAL_SUMS_LE_INFSUM ← prove
   r"!f s n.
        (!i. i IN s ==> &0 <= f i) /\ real_summable s f
        ==> sum (s INTER (0..n)) f <= real_infsum s f"
   (REPEAT GEN_TAC THEN SIMP_TAC [REAL_INFSUM] THEN
    REWRITE_TAC [REAL_SUMMABLE] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o BINDER_CONV o RAND_CONV o RAND_CONV)
     [← GSYM LIFT_DROP] THEN
    REWRITE_TAC [o_DEF] THEN DISCH_THEN (MP_TAC o MATCH_MP
      PARTIAL_SUMS_DROP_LE_INFSUM) THEN
    SIMP_TAC [DROP_VSUM, FINITE_INTER, FINITE_NUMSEG, o_DEF, LIFT_DROP, ETA_AX])

  let REAL_PARTIAL_SUMS_LE_INFSUM_GEN ← prove
   r"!f s t. FINITE t /\ t SUBSET s /\
           (!i. i IN s ==> &0 <= f i) /\ real_summable s f
           ==> sum t f <= real_infsum s f"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"\n:num. n") o MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
    TRANS_TAC REAL_LE_TRANS (← q r"sum (s INTER (0..n)) f") THEN
    ASM_SIMP_TAC [REAL_PARTIAL_SUMS_LE_INFSUM] THEN
    MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
    ASM_SIMP_TAC [IN_INTER, IN_DIFF, FINITE_INTER, FINITE_NUMSEG] THEN
    REWRITE_TAC [SUBSET, IN_NUMSEG, IN_INTER, LE_0] THEN ASM SET_TAC [])

  let REAL_SERIES_TERMS_TOZERO ← prove
   r"!f l n. (f real_sums l) (from n) ==> (f ---> &0) sequentially"
   (REWRITE_TAC [REAL_SUMS, TENDSTO_REAL, LIFT_NUM, SERIES_TERMS_TOZERO])

  let REAL_SERIES_LE ← prove
   r"!f g s y z.
        (f real_sums y) s /\ (g real_sums z) s /\
        (!i. i IN s ==> f(i) <= g(i))
        ==> y <= z"
   (REWRITE_TAC [REAL_SUMS] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← MESON [LIFT_DROP] (← q r"x = drop(lift x)")] THEN
    MATCH_MP_TAC SERIES_DROP_LE THEN
    MAP_EVERY EXISTS_TAC [← q r"lift o (f:num->real)", ← q r"lift o (g:num->real)"] THEN
    ASM_SIMP_TAC [o_THM, LIFT_DROP] THEN ASM_MESON_TAC [])

  let REAL_SERIES_POS ← prove
   r"!f s y.
        (f real_sums y) s /\ (!i. i IN s ==> &0 <= f(i))
        ==> &0 <= y"
   (REWRITE_TAC [REAL_SUMS] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM LIFT_DROP] THEN
    MATCH_MP_TAC SERIES_DROP_POS THEN
    EXISTS_TAC (← q r"lift o (f:num->real)") THEN
    ASM_SIMP_TAC [o_THM, LIFT_DROP] THEN ASM_MESON_TAC [])

  let REAL_SERIES_BOUND ← prove
   r"!f g s a b.
        (f real_sums a) s /\ (g real_sums b) s /\
        (!i. i IN s ==> abs(f i) <= g i)
        ==> abs(a) <= b"
   (REWRITE_TAC [REAL_SUMS, ← GSYM NORM_LIFT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SERIES_BOUND THEN
    EXISTS_TAC (← q r"lift o (f:num->real)") THEN
    REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [])

  let REAL_SERIES_COMPARISON_BOUND ← prove
   r"!f g s a.
        (g real_sums a) s /\ (!i. i IN s ==> abs(f i) <= g i)
        ==> ?l. (f real_sums l) s /\ abs(l) <= a"
   (REWRITE_TAC [REAL_SUMS, ← GSYM EXISTS_LIFT, ← GSYM NORM_LIFT] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (BINDER_CONV o RAND_CONV o RAND_CONV) [← GSYM LIFT_DROP] THEN
    MATCH_MP_TAC SERIES_COMPARISON_BOUND THEN
    EXISTS_TAC (← q r"lift o (g:num->real)") THEN
    ASM_SIMP_TAC [o_THM, LIFT_DROP])

  let REAL_SERIES_MUL ← prove
   r"!x y a b.
        (x real_sums a) (from 0) /\ (y real_sums b) (from 0) /\
        (real_summable (from 0) (\n. abs(x n)) \/
         real_summable (from 0) (\n. abs(y n)))
        ==> ((\n. sum(0..n) (\i. x i * y(n - i))) real_sums (a * b))
            (from 0)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x y:real^1. drop x % y",
      ← q r"lift o (x:num->real)", ← q r"lift o (y:num->real)",
      ← q r"lift a", ← q r"lift b"]
     SERIES_BILINEAR) THEN
    ASM_REWRITE_TAC [← GSYM REAL_SUMMABLE, ← GSYM REAL_SUMS, BILINEAR_DROP_MUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [REAL_SUMMABLE, REAL_SUMS, o_DEF, ← GSYM NORM_1]) THEN
    ASM_REWRITE_TAC [o_DEF, NORM_LIFT, REAL_SUMS, TENDSTO_REAL, LIFT_SUM] THEN
    REWRITE_TAC [DROP_CMUL, LIFT_DROP, LIFT_CMUL])

  let REAL_SERIES_MUL_UNIQUE ← prove
   r"!x y a b c.
        (x real_sums a) (from 0) /\ (y real_sums b) (from 0) /\
        ((\n. sum (0..n) (\i. x i * y(n - i))) real_sums c) (from 0)
        ==> a * b = c"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x y:real^1. drop x % y",
      ← q r"lift o (x:num->real)", ← q r"lift o (y:num->real)",
      ← q r"lift a", ← q r"lift b", ← q r"lift c"]
     SERIES_BILINEAR_UNIQUE) THEN
    ASM_REWRITE_TAC [← GSYM REAL_SUMS, BILINEAR_DROP_MUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_SUMS, o_DEF, LIFT_SUM, ← GSYM NORM_1]) THEN
    ASM_REWRITE_TAC [o_DEF, DROP_CMUL, LIFT_DROP, ← GSYM LIFT_CMUL] THEN
    REWRITE_TAC [LIFT_EQ])

  pure { real_sums, real_infsum, real_summable, REAL_SUMS, REAL_SUMS_RE, REAL_SUMS_IM,
         REAL_SUMS_COMPLEX, REAL_SUMMABLE, REAL_SUMMABLE_COMPLEX, REAL_SERIES_CAUCHY,
         REAL_SUMMABLE_CAUCHY, REAL_SUMS_SUMMABLE, REAL_SUMS_INFSUM, REAL_INFSUM_COMPLEX,
         REAL_SERIES_FROM, REAL_SERIES_UNIQUE, REAL_INFSUM_UNIQUE, REAL_SERIES_FINITE,
         REAL_SUMMABLE_FINITE, REAL_SUMMABLE_IFF_EVENTUALLY, REAL_SUMMABLE_EQ_EVENTUALLY,
         REAL_SUMMABLE_IFF_COFINITE, REAL_SUMMABLE_EQ_COFINITE,
         REAL_SUMMABLE_FROM_ELSEWHERE, REAL_SUMMABLE_FROM_ELSEWHERE_EQ,
         REAL_SERIES_GOESTOZERO, REAL_SUMMABLE_IMP_TOZERO, REAL_SUMMABLE_IMP_BOUNDED,
         REAL_SUMMABLE_IMP_REAL_SUMS_BOUNDED, REAL_SERIES_0, REAL_SERIES_ADD,
         REAL_SERIES_SUB, REAL_SERIES_LMUL, REAL_SERIES_RMUL, REAL_SERIES_NEG, REAL_SERIES_FINITE_SUM,
         REAL_SUMS_IFF, REAL_SUMS_EQ, REAL_SERIES_FINITE_SUPPORT, REAL_SERIES_DIFFS,
         REAL_SERIES_TRIVIAL, REAL_SERIES_RESTRICT, REAL_SERIES_SUM, REAL_SUMS_REINDEX,
         REAL_SERIES_EVEN, REAL_SERIES_ODD, REAL_INFSUM, REAL_PARTIAL_SUMS_LE_INFSUM,
         REAL_PARTIAL_SUMS_LE_INFSUM_GEN, REAL_SERIES_TERMS_TOZERO, REAL_SERIES_LE,
         REAL_SERIES_POS, REAL_SERIES_BOUND, REAL_SERIES_COMPARISON_BOUND,
         REAL_SERIES_MUL, REAL_SERIES_MUL_UNIQUE }
/- ------------------------------------------------------------------------- -/
/- Similar combining theorems just for summability; similar combining       -/
/- theorems for infsum.                                                     -/
/- (realanalysis.ml 878-1084)                                               -/
/- ------------------------------------------------------------------------- -/

structure RZD where
  REAL_SUMMABLE_0 : thm
  REAL_SUMMABLE_ADD : thm
  REAL_SUMMABLE_SUB : thm
  REAL_SUMMABLE_LMUL : thm
  REAL_SUMMABLE_RMUL : thm
  REAL_SUMMABLE_NEG : thm
  REAL_SUMMABLE_IFF : thm
  REAL_SUMMABLE_EQ : thm
  REAL_SERIES_SUBSET : thm
  REAL_SUMMABLE_SUBSET : thm
  REAL_SUMMABLE_TRIVIAL : thm
  REAL_SUMMABLE_RESTRICT : thm
  REAL_SUMS_FINITE_DIFF : thm
  REAL_SUMS_FINITE_UNION : thm
  REAL_SUMS_OFFSET : thm
  REAL_SUMS_OFFSET_REV : thm
  REAL_SUMMABLE_EVEN : thm
  REAL_SUMMABLE_ODD : thm
  REAL_INFSUM_0 : thm
  REAL_INFSUM_ADD : thm
  REAL_INFSUM_SUB : thm
  REAL_INFSUM_LMUL : thm
  REAL_INFSUM_RMUL : thm
  REAL_INFSUM_NEG : thm
  REAL_INFSUM_EQ : thm
  REAL_INFSUM_RESTRICT : thm
  REAL_INFSUM_EVEN : thm
  REAL_INFSUM_ODD : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZD [HolBase] (D : RealAnalysisDeps) (BRZC : RZC) : ExceptT String IO RZD := do
  -- @@SCOPE BEGIN
  let { real_infsum, REAL_INFSUM_UNIQUE, REAL_SERIES_0, REAL_SERIES_ADD, REAL_SERIES_EVEN,
        REAL_SERIES_FINITE, REAL_SERIES_LMUL, REAL_SERIES_NEG, REAL_SERIES_ODD,
        REAL_SERIES_RESTRICT, REAL_SERIES_RMUL, REAL_SERIES_SUB, REAL_SERIES_TRIVIAL,
        real_summable, real_sums, REAL_SUMS_EQ, REAL_SUMS_IFF, REAL_SUMS_INFSUM,
        .. } := BRZC
  let { IN_FROM, .. } := D.ts.qmisc
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { CONJ_SYM, EQ_IMP, EXTENSION, FINITE_DIFF, FINITE_NUMSEG,
        .. } := D.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_IMP, IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { IN_NUMSEG, IN_UNION, NOT_EXISTS_THM, .. } := D.ts.cn.cx.cvx.core3
  let { SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { SUM_RESTRICT_SET, .. } := D.ts.cn.cx.cvx.core6
  let { FINITE_INTER_NUMSEG, .. } := D.ts.cn.ms.ig.dv.qmisc
  -- @@SCOPE END

  let REAL_SUMMABLE_0 ← prove
   r"!s. real_summable s (\n. &0)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_0])

  let REAL_SUMMABLE_ADD ← prove
   r"!x y s. real_summable s x /\ real_summable s y
           ==> real_summable s (\n. x n + y n)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_ADD])

  let REAL_SUMMABLE_SUB ← prove
   r"!x y s. real_summable s x /\ real_summable s y
           ==> real_summable s (\n. x n - y n)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_SUB])

  let REAL_SUMMABLE_LMUL ← prove
   r"!s x c. real_summable s x ==> real_summable s (\n. c * x n)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_LMUL])

  let REAL_SUMMABLE_RMUL ← prove
   r"!s x c. real_summable s x ==> real_summable s (\n. x n * c)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_RMUL])

  let REAL_SUMMABLE_NEG ← prove
   r"!x s. real_summable s x ==> real_summable s (\n. --(x n))"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_NEG])

  let REAL_SUMMABLE_IFF ← prove
   r"!f g k. (!x. x IN k ==> f x = g x)
           ==> (real_summable k f <=> real_summable k g)"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SUMS_IFF])

  let REAL_SUMMABLE_EQ ← prove
   r"!f g k. (!x. x IN k ==> f x = g x) /\ real_summable k f
           ==> real_summable k g"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SUMS_EQ])

  let REAL_SERIES_SUBSET ← prove
   r"!x s t l.
        s SUBSET t /\
        ((\i. if i IN s then x i else &0) real_sums l) t
        ==> (x real_sums l) s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [real_sums] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    ASM_SIMP_TAC [← GSYM SUM_RESTRICT_SET, FINITE_INTER_NUMSEG] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN POP_ASSUM MP_TAC THEN SET_TAC [])

  let REAL_SUMMABLE_SUBSET ← prove
   r"!x s t.
        s SUBSET t /\
        real_summable t (\i. if i IN s then x i else &0)
        ==> real_summable s x"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [REAL_SERIES_SUBSET])

  let REAL_SUMMABLE_TRIVIAL ← prove
   r"!f. real_summable {} f"
   (GEN_TAC THEN REWRITE_TAC [real_summable] THEN EXISTS_TAC (← q r"&0") THEN
    REWRITE_TAC [REAL_SERIES_TRIVIAL])

  let REAL_SUMMABLE_RESTRICT ← prove
   r"!f k.
        real_summable (:num) (\n. if n IN k then f(n) else &0) <=>
        real_summable k f"
   (REWRITE_TAC [real_summable, REAL_SERIES_RESTRICT])

  let REAL_SUMS_FINITE_DIFF ← prove
   r"!f t s l.
        t SUBSET s /\ FINITE t /\ (f real_sums l) s
        ==> (f real_sums (l - sum t f)) (s DIFF t)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:num->real") o MATCH_MP REAL_SERIES_FINITE) THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SERIES_RESTRICT] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_SERIES_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:num") THEN REWRITE_TAC [IN_DIFF] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:num") o GEN_REWRITE_RULE id [SUBSET]) THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:num) IN s", ← q r"(x:num) IN t"] THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let REAL_SUMS_FINITE_UNION ← prove
   r"!f s t l.
        FINITE t /\ (f real_sums l) s
        ==> (f real_sums (l + sum (t DIFF s) f)) (s UNION t)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"s:num->bool") o MATCH_MP FINITE_DIFF) THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"f:num->real") o MATCH_MP REAL_SERIES_FINITE) THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SERIES_RESTRICT] THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_SERIES_ADD) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:num") THEN
    REWRITE_TAC [IN_DIFF, IN_UNION] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:num) IN s", ← q r"(x:num) IN t"] THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let REAL_SUMS_OFFSET ← prove
   r"!f l m n.
        (f real_sums l) (from m) /\ m < n
        ==> (f real_sums (l - sum(m..(n-1)) f)) (from n)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"from n = from m DIFF (m..(n-1))") SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_FROM, IN_DIFF, IN_NUMSEG] THEN ASM_ARITH_TAC,
      MATCH_MP_TAC REAL_SUMS_FINITE_DIFF THEN ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
      SIMP_TAC [SUBSET, IN_FROM, IN_NUMSEG]])

  let REAL_SUMS_OFFSET_REV ← prove
   r"!f l m n.
        (f real_sums l) (from m) /\ n < m
        ==> (f real_sums (l + sum(n..m-1) f)) (from n)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real", ← q r"from m", ← q r"n..m-1", ← q r"l:real"]
                  REAL_SUMS_FINITE_UNION) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN MATCH_MP_TAC EQ_IMP THEN
    BINOP_TAC THENL [AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC, ALL_TAC] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNION, IN_FROM, IN_NUMSEG] THEN
    ASM_ARITH_TAC)

  let REAL_SUMMABLE_EVEN ← prove
   r"!f n.
      real_summable (from n) f <=>
      real_summable (from (2 * n)) (\i. if EVEN i then f(i DIV 2) else &0)"
   (REWRITE_TAC [real_summable, ← GSYM REAL_SERIES_EVEN])

  let REAL_SUMMABLE_ODD ← prove
   r"!f n.
      real_summable (from n) f <=>
      real_summable (from (2 * n + 1)) (\i. if ODD i then f(i DIV 2) else &0)"
   (REWRITE_TAC [real_summable, ← GSYM REAL_SERIES_ODD])

  let REAL_INFSUM_0 ← prove
   r"real_infsum s (\i. &0) = &0"
   (MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN REWRITE_TAC [REAL_SERIES_0])

  let REAL_INFSUM_ADD ← prove
   r"!x y s. real_summable s x /\ real_summable s y
           ==> real_infsum s (\i. x i + y i) =
               real_infsum s x + real_infsum s y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
    MATCH_MP_TAC REAL_SERIES_ADD THEN ASM_REWRITE_TAC [REAL_SUMS_INFSUM])

  let REAL_INFSUM_SUB ← prove
   r"!x y s. real_summable s x /\ real_summable s y
           ==> real_infsum s (\i. x i - y i) =
               real_infsum s x - real_infsum s y"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
    MATCH_MP_TAC REAL_SERIES_SUB THEN ASM_REWRITE_TAC [REAL_SUMS_INFSUM])

  let REAL_INFSUM_LMUL ← prove
   r"!s x c. real_summable s x
           ==> real_infsum s (\n. c * x n) = c * real_infsum s x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
    MATCH_MP_TAC REAL_SERIES_LMUL THEN ASM_REWRITE_TAC [REAL_SUMS_INFSUM])

  let REAL_INFSUM_RMUL ← prove
   r"!s x c. real_summable s x
           ==> real_infsum s (\n. x n * c) = real_infsum s x * c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
    MATCH_MP_TAC REAL_SERIES_RMUL THEN ASM_REWRITE_TAC [REAL_SUMS_INFSUM])

  let REAL_INFSUM_NEG ← prove
   r"!s x. real_summable s x
         ==> real_infsum s (\n. --(x n)) = --(real_infsum s x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
    MATCH_MP_TAC REAL_SERIES_NEG THEN ASM_REWRITE_TAC [REAL_SUMS_INFSUM])

  let REAL_INFSUM_EQ ← prove
   r"!f g k. real_summable k f /\ real_summable k g /\
           (!x. x IN k ==> f x = g x)
           ==> real_infsum k f = real_infsum k g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_infsum] THEN AP_TERM_TAC THEN
    ABS_TAC THEN ASM_MESON_TAC [REAL_SUMS_EQ, REAL_SUMS_INFSUM])

  let REAL_INFSUM_RESTRICT ← prove
   r"!k a. real_infsum (:num) (\n. if n IN k then a n else &0) =
         real_infsum k a"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"a:num->real", ← q r"k:num->bool"] REAL_SUMMABLE_RESTRICT) THEN
    ASM_CASES_TAC (← q r"real_summable k a") THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THENL
     [MATCH_MP_TAC REAL_INFSUM_UNIQUE THEN
      ASM_REWRITE_TAC [REAL_SERIES_RESTRICT, REAL_SUMS_INFSUM],
      RULE_ASSUM_TAC (REWRITE_RULE [real_summable, NOT_EXISTS_THM]) THEN
      ASM_REWRITE_TAC [real_infsum]])

  let REAL_INFSUM_EVEN ← prove
   r"!f n.
        real_infsum (from n) f =
        real_infsum (from (2 * n)) (\i. if EVEN i then f(i DIV 2) else &0)"
   (REWRITE_TAC [real_infsum, ← GSYM REAL_SERIES_EVEN])

  let REAL_INFSUM_ODD ← prove
   r"!f n.
        real_infsum (from n) f =
        real_infsum (from (2 * n + 1)) (\i. if ODD i then f(i DIV 2) else &0)"
   (REWRITE_TAC [real_infsum, ← GSYM REAL_SERIES_ODD])

  pure { REAL_SUMMABLE_0, REAL_SUMMABLE_ADD, REAL_SUMMABLE_SUB, REAL_SUMMABLE_LMUL,
         REAL_SUMMABLE_RMUL, REAL_SUMMABLE_NEG, REAL_SUMMABLE_IFF, REAL_SUMMABLE_EQ,
         REAL_SERIES_SUBSET, REAL_SUMMABLE_SUBSET, REAL_SUMMABLE_TRIVIAL,
         REAL_SUMMABLE_RESTRICT, REAL_SUMS_FINITE_DIFF, REAL_SUMS_FINITE_UNION,
         REAL_SUMS_OFFSET, REAL_SUMS_OFFSET_REV, REAL_SUMMABLE_EVEN, REAL_SUMMABLE_ODD,
         REAL_INFSUM_0, REAL_INFSUM_ADD, REAL_INFSUM_SUB, REAL_INFSUM_LMUL,
         REAL_INFSUM_RMUL, REAL_INFSUM_NEG, REAL_INFSUM_EQ, REAL_INFSUM_RESTRICT,
         REAL_INFSUM_EVEN, REAL_INFSUM_ODD }
/- ------------------------------------------------------------------------- -/
/- Convergence tests for real series.                                        -/
/- (realanalysis.ml 1085-1292)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZE where
  REAL_SERIES_CAUCHY_UNIFORM : thm
  REAL_SERIES_COMPARISON : thm
  REAL_SUMMABLE_COMPARISON : thm
  REAL_SERIES_COMPARISON_UNIFORM : thm
  REAL_SUMMABLE_POS_SUBSET : thm
  REAL_SUMMABLE_POS_PARTIAL_BOUND : thm
  REAL_SERIES_RATIO : thm
  BOUNDED_PARTIAL_REAL_SUMS : thm
  REAL_SERIES_DIRICHLET : thm
  REAL_SERIES_ABSCONV_IMP_CONV : thm
  SERIES_NORMCONV_IMP_CONV : thm
  REAL_SUMS_GP : thm
  REAL_SUMMABLE_GP : thm
  REAL_SUMMABLE_ZETA : thm
  REAL_SUMMABLE_ZETA_INTEGER : thm
  DIRICHLET_SERIES_FINITE_PERTURBATION : thm
  REAL_ABEL_LEMMA : thm
  REAL_POWER_SERIES_CONV_IMP_ABSCONV : thm
  POWER_REAL_SERIES_CONV_IMP_ABSCONV_WEAK : thm
  REAL_SUMMABLE_MUL_LEFT : thm
  REAL_SUMMABLE_MUL_RIGHT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZE [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZC : RZC) (BRZD : RZD) : ExceptT String IO RZE := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, TENDSTO_REAL, .. } := BRZA
  let { CONVERGENT_REAL_BOUNDED_MONOTONE, REALLIM_UBOUND, .. } := BRZB
  let { REAL_INFSUM_UNIQUE, REAL_SERIES_CAUCHY, REAL_SERIES_FINITE_SUPPORT,
        REAL_SERIES_FROM, REAL_SERIES_MUL, real_summable, REAL_SUMMABLE,
        REAL_SUMMABLE_COMPLEX, REAL_SUMMABLE_FROM_ELSEWHERE,
        REAL_SUMMABLE_FROM_ELSEWHERE_EQ, REAL_SUMS, REAL_SUMS_COMPLEX, REAL_SUMS_EQ,
        REAL_SUMS_SUMMABLE, .. } := BRZC
  let { REAL_INFSUM_SUB, REAL_SUMMABLE_SUB, REAL_SUMMABLE_SUBSET, .. } := BRZD
  let { CX_EXP, .. } := D.tsb
  let { CX_LOG, .. } := D.tsm
  let { cpow, .. } := D.tso
  let { rpow, RPOW_LE_1, .. } := D.tsab
  let { SUMMABLE_ZETA, SUMMABLE_ZETA_INTEGER, .. } := D.tsac
  let { REAL_BOUNDED_POS, .. } := D.qmetric
  let { SERIES_CAUCHY_UNIFORM, SUMMABLE_COMPARISON, .. } := D.qtopology
  let { SUMMABLE_GP, SUMS_GP, .. } := D.ts.knn
  let { ABEL_LEMMA, POWER_SERIES_CONV_IMP_ABSCONV, POWER_SERIES_CONV_IMP_ABSCONV_WEAK,
        .. } := D.ts.kno
  let { SERIES_RATIO, SUMMABLE_EQ, .. } := D.ts.qtopology
  let { IN_FROM, .. } := D.ts.qmisc
  let { COMPLEX_NORM_CX, CX_ABS, CX_DIV, CX_INJ, CX_INV, CX_MUL, CX_POW, CX_SUB, RE_CX,
        .. } := D.ts.cn.cxc
  let { BOUNDED_PARTIAL_SUMS, SERIES_COMPARISON, SERIES_DIRICHLET, .. } := D.ts.cn.qtopology
  let { ARITH_RULE, ASM_MESON_TAC, INTRO_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, .. } := D.ts.cn.cx.cvx
  let { REAL_ABS_0, .. } := D.ts.cn.ms.ig.qsession
  let { SUM_VSUM, VSUM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { CARD_SUBSET, ETA_AX, FINITE_INTER, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, GE, IMP_CONJ, INTER_SUBSET,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_NUMSEG, IN_UNIV, LE_1, LEFT_IMP_EXISTS_THM, MONO_FORALL, MONO_IMP,
        REAL_ABS_DIV, REAL_ABS_POS, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADDR, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_TRANS, REAL_LET_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_SUB_REFL, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_div, SUM_ABS_LE, SUM_CLAUSES_NUMSEG, SUM_CONST, SUM_EQ,
        .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_SUB, EXISTS_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_NUM, NORM_1,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { FINITE_INTER_NUMSEG, .. } := D.ts.cn.ms.ig.dv.qmisc
  let { SUM_POS_LE_NUMSEG, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let REAL_SERIES_CAUCHY_UNIFORM ← prove
   r"!P:A->bool f k.
        (?l. !e. &0 < e
                 ==> ?N. !n x. N <= n /\ P x
                               ==> abs(sum(k INTER (0..n)) (f x) -
                                        l x) < e) <=>
        (!e. &0 < e ==> ?N. !m n x. N <= m /\ P x
                                    ==> abs(sum(k INTER (m..n)) (f x)) < e)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"P:A->bool", ← q r"\x:A n:num. lift(f x n)", ← q r"k:num->bool"]
          SERIES_CAUCHY_UNIFORM) THEN
    SIMP_TAC [VSUM_REAL, FINITE_INTER, FINITE_NUMSEG] THEN
    REWRITE_TAC [NORM_LIFT, o_DEF, LIFT_DROP, ETA_AX] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_TAC (← q r"l:A->real")) THEN
      EXISTS_TAC (← q r"lift o (l:A->real)") THEN
      ASM_SIMP_TAC [o_THM, DIST_LIFT],
      DISCH_THEN (X_CHOOSE_TAC (← q r"l:A->real^1")) THEN
      EXISTS_TAC (← q r"drop o (l:A->real^1)") THEN
      ASM_SIMP_TAC [SUM_VSUM, FINITE_INTER, FINITE_NUMSEG] THEN
      REWRITE_TAC [o_THM, ← GSYM DROP_SUB, ← GSYM NORM_1] THEN
      SIMP_TAC [← GSYM dist, VSUM_REAL, FINITE_INTER, FINITE_NUMSEG] THEN
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]])

  let REAL_SERIES_COMPARISON ← prove
   r"!f g s. (?l. (g real_sums l) s) /\
           (?N. !n. n >= N /\ n IN s ==> abs(f n) <= g n)
           ==> ?l. (f real_sums l) s"
   (REWRITE_TAC [REAL_SUMS, ← GSYM EXISTS_LIFT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_COMPARISON THEN
    EXISTS_TAC (← q r"g:num->real") THEN
    REWRITE_TAC [NORM_LIFT, o_THM] THEN ASM_MESON_TAC [])

  let REAL_SUMMABLE_COMPARISON ← prove
   r"!f g s. real_summable s g /\
           (?N. !n. n >= N /\ n IN s ==> abs(f n) <= g n)
           ==> real_summable s f"
   (REWRITE_TAC [real_summable, REAL_SERIES_COMPARISON])

  let REAL_SERIES_COMPARISON_UNIFORM ← prove
   r"!f g P s. (?l. (g real_sums l) s) /\
             (?N. !n x. N <= n /\ n IN s /\ P x ==> abs(f x n) <= g n)
             ==> ?l:A->real.
                    !e. &0 < e
                        ==> ?N. !n x. N <= n /\ P x
                                      ==> abs(sum(s INTER (0..n)) (f x) -
                                               l x) < e"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [GE, REAL_SERIES_CAUCHY, REAL_SERIES_CAUCHY_UNIFORM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (X_CHOOSE_TAC (← q r"N1:num"))) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN
    EXISTS_TAC (← q r"N1 + N2:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num", ← q r"x:A"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"abs (sum (s INTER (m .. n)) g)") THEN CONJ_TAC THENL
     [SIMP_TAC [← GSYM LIFT_SUM, FINITE_INTER_NUMSEG, NORM_LIFT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs(a)")) THEN
      MATCH_MP_TAC SUM_ABS_LE THEN
      REWRITE_TAC [FINITE_INTER_NUMSEG, IN_INTER, IN_NUMSEG] THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2:num <= m /\ m <= x ==> N1 <= x")],
      ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2:num <= m ==> N2 <= m")]])

  let REAL_SUMMABLE_POS_SUBSET ← prove
   r"!s t f. (!x. x IN t ==> &0 <= f x) /\ real_summable t f /\ s SUBSET t
           ==> real_summable s f"
   (INTRO_TAC "!s t f; pos sum sub" THEN MATCH_MP_TAC REAL_SUMMABLE_SUBSET THEN
    EXISTS_TAC (← q r"t:num->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_SUMMABLE_COMPARISON THEN EXISTS_TAC (← q r"f:num->real") THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"0") THEN INTRO_TAC "!n; _ n" THEN
    COND_CASES_TAC THEN REWRITE_TAC [REAL_ABS_0] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"abs x <= x <=> &0 <= x")])

  let REAL_SUMMABLE_POS_PARTIAL_BOUND ← prove
   r"!f:num->real k B.
        (!n. k <= n ==> &0 <= f n) /\ (!n. sum(k..n) f <= B)
        ==> real_summable (from k) f /\ real_infsum (from k) f <= B"
   (← do
    let bR ← q r"B:real"
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!n. &0 <= sum(k..n) (f:num->real)") ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"\n. sum(k..n) (f:num->real)")
      CONVERGENT_REAL_BOUNDED_MONOTONE) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [REAL_BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"abs B + &1:real") THEN CONJ_TAC THENL
         [REAL_ARITH_TAC,
          X_GEN_TAC (← q r"n:num") THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num") o check (α := thm) (fun th =>
            HolCore.Basics.free_in bR (concl th))) THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN REAL_ARITH_TAC],
        DISJ1_TAC THEN X_GEN_TAC (← q r"n:num") THEN
        REWRITE_TAC [SUM_CLAUSES_NUMSEG] THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [REAL_LE_ADDR, REAL_LE_REFL]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"l:real")) THEN
    SUBGOAL_THEN (← q r"((f:num->real) real_sums l) (from k)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [REAL_SERIES_FROM], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [real_summable], ALL_TAC] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP REAL_INFSUM_UNIQUE) THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_UBOUND) THEN
    EXISTS_TAC (← q r"\n. sum(k..n) (f:num->real)") THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
    MESON_TAC []))

  let REAL_SERIES_RATIO ← prove
   r"!c a s N.
      c < &1 /\
      (!n. n >= N ==> abs(a(SUC n)) <= c * abs(a(n)))
      ==> ?l:real. (a real_sums l) s"
   (REWRITE_TAC [REAL_SUMS, ← GSYM EXISTS_LIFT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_RATIO THEN
    REWRITE_TAC [o_THM, NORM_LIFT] THEN ASM_MESON_TAC [])

  let BOUNDED_PARTIAL_REAL_SUMS ← prove
   r"!f:num->real k.
        real_bounded { sum(k..n) f | n IN (:num) }
        ==> real_bounded { sum(m..n) f | m IN (:num) /\ n IN (:num) }"
   (REWRITE_TAC [REAL_BOUNDED] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f {g x | P x} = {f(g x) | P x}"),
      ← SET_RULE (← q r"IMAGE f {g x y | P x /\ Q y} = {f(g x y) | P x /\ Q y}")] THEN
    SIMP_TAC [LIFT_SUM, FINITE_INTER, FINITE_NUMSEG] THEN
    REWRITE_TAC [BOUNDED_PARTIAL_SUMS])

  let REAL_SERIES_DIRICHLET ← prove
   r"!f:num->real g N k m.
        real_bounded { sum (m..n) f | n IN (:num)} /\
        (!n. N <= n ==> g(n + 1) <= g(n)) /\
        (g ---> &0) sequentially
        ==> real_summable (from k) (\n. g(n) * f(n))"
   (REWRITE_TAC [REAL_SUMMABLE, REAL_BOUNDED, TENDSTO_REAL] THEN
    REWRITE_TAC [LIFT_NUM, LIFT_CMUL, o_DEF] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_DIRICHLET THEN
    MAP_EVERY EXISTS_TAC [← q r"N:num", ← q r"m:num"] THEN
    ASM_REWRITE_TAC [o_DEF] THEN
    SIMP_TAC [VSUM_REAL, FINITE_INTER, FINITE_NUMSEG] THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"{lift(f x) | P x} = IMAGE lift {f x | P x}")])

  let REAL_SERIES_ABSCONV_IMP_CONV ← prove
   r"!x:num->real k. real_summable k (\n. abs(x n)) ==> real_summable k x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_SUMMABLE_COMPARISON THEN
    EXISTS_TAC (← q r"\n:num. abs(x n)") THEN ASM_REWRITE_TAC [REAL_LE_REFL])

  let SERIES_NORMCONV_IMP_CONV ← prove
   r"!s f:num->real^N. real_summable s (\n. norm(f n)) ==> summable s f"
   (INTRO_TAC "!s f; hp" THEN MATCH_MP_TAC SUMMABLE_COMPARISON THEN
    EXISTS_TAC (← q r"\n:num. norm(f n:real^N)") THEN
    ASM_REWRITE_TAC [← GSYM REAL_SUMMABLE, REAL_LE_REFL])

  let REAL_SUMS_GP ← prove
   r"!n x. abs(x) < &1
         ==> ((\k. x pow k) real_sums (x pow n / (&1 - x))) (from n)"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPECL [← q r"n:num", ← q r"Cx x"] SUMS_GP) THEN
    ASM_REWRITE_TAC [REAL_SUMS_COMPLEX, ← GSYM CX_SUB, ← GSYM CX_POW, ← GSYM CX_DIV,
                     o_DEF, COMPLEX_NORM_CX])

  let REAL_SUMMABLE_GP ← prove
   r"!x k. abs(x) < &1 ==> real_summable k (\n. x pow n)"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPECL [← q r"Cx x", ← q r"k:num->bool"] SUMMABLE_GP) THEN
    ASM_REWRITE_TAC [REAL_SUMMABLE_COMPLEX] THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_CX, o_DEF, CX_POW])

  let REAL_SUMMABLE_ZETA ← prove
   r"!n x. &1 < x ==> real_summable (from n) (\k. inv(&k rpow x))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_SUMMABLE_FROM_ELSEWHERE THEN EXISTS_TAC (← q r"1") THEN
    REWRITE_TAC [REAL_SUMMABLE_COMPLEX] THEN
    MP_TAC (← ISPECL [← q r"1", ← q r"Cx x"] SUMMABLE_ZETA) THEN
    ASM_REWRITE_TAC [RE_CX, o_DEF] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMMABLE_EQ) THEN
    SIMP_TAC [IN_FROM, cpow, rpow, REAL_OF_NUM_EQ, REAL_OF_NUM_LT, CX_INJ, LE_1,
              ← GSYM CX_LOG, ← GSYM CX_MUL, ← GSYM CX_EXP, ← GSYM CX_INV])

  let REAL_SUMMABLE_ZETA_INTEGER ← prove
   r"!n m. 2 <= m ==> real_summable (from n) (\k. inv(&k pow m))"
   (REWRITE_TAC [REAL_SUMMABLE_COMPLEX, CX_INV, CX_POW,
                 SUMMABLE_ZETA_INTEGER, o_DEF])

  let DIRICHLET_SERIES_FINITE_PERTURBATION ← prove
   r"!(a:num->real) b t B s.
        FINITE t /\ (!m. ~(m IN t) ==> a m = b m) /\
        (!m. abs(a m - b m) <= B) /\ &0 <= s /\
        real_summable (from 1) (\m. a m / &m rpow s)
        ==> real_summable (from 1) (\m. b m / &m rpow s) /\
            abs(real_infsum (from 1) (\m. a m / &m rpow s) -
                real_infsum (from 1) (\m. b m / &m rpow s))
            <= B * &(CARD t)"
   (← do
    let ra3 ← REAL_ARITH (← q r"&1 <= (x:real) ==> &0 < x")
    let ra2 ← REAL_ARITH (← q r"&1 <= (x:real) ==> &1 <= abs x")
    let ra1 ← REAL_ARITH (← q r"abs((x:real) - (x - y)) = abs y")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"((\m. (a m - b m) / &m rpow s) real_sums
     sum (t INTER from 1) (\m. (a m - b m) / &m rpow s)) (from 1)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC REAL_SUMS_EQ THEN
      EXISTS_TAC (← q r"\m. if 1 <= m then ((a:num->real) m - b m) / &m rpow s
                    else &0") THEN
      CONJ_TAC THENL [SIMP_TAC [IN_FROM], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"sum (t INTER from 1) (\m. ((a:num->real) m - b m) / &m rpow s) =
      sum (t INTER from 1)
          (\m. if 1 <= m then (a m - b m) / &m rpow s else &0)")
      SUBST1_TAC THENL
       [MATCH_MP_TAC SUM_EQ THEN SIMP_TAC [IN_INTER, IN_FROM], ALL_TAC] THEN
      MATCH_MP_TAC REAL_SERIES_FINITE_SUPPORT THEN
      ASM_SIMP_TAC [FINITE_INTER, IN_INTER, IN_FROM] THEN
      X_GEN_TAC (← q r"m:num") THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_SUB_REFL, real_div, REAL_MUL_LZERO],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(\m. b m / &m rpow s) = (\m. a m / &m rpow s - (a m - b m) / &m rpow s)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM] THEN REAL_ARITH_TAC, ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_SUMS_SUMMABLE) THEN
    ASM_SIMP_TAC [REAL_SUMMABLE_SUB, REAL_INFSUM_SUB] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP REAL_INFSUM_UNIQUE) THEN
    REWRITE_TAC [ra1] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum (t INTER from 1) (\m:num. B)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUM_ABS_LE THEN ASM_SIMP_TAC [FINITE_INTER] THEN
      X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [IN_INTER, IN_FROM] THEN STRIP_TAC THEN
      REWRITE_TAC [REAL_ABS_DIV] THEN
      SUBGOAL_THEN (← q r"&1 <= abs(&m rpow s)") ASSUME_TAC THENL
       [MATCH_MP_TAC ra2 THEN
        MATCH_MP_TAC RPOW_LE_1 THEN ASM_REWRITE_TAC [REAL_OF_NUM_LE],
        ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ra3] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"B:real") THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [REAL_ABS_POS, REAL_LE_TRANS],
      ASM_SIMP_TAC [SUM_CONST, FINITE_INTER] THEN
      GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
      CONJ_TAC THENL
       [REWRITE_TAC [REAL_OF_NUM_LE] THEN MATCH_MP_TAC CARD_SUBSET THEN
        ASM_REWRITE_TAC [INTER_SUBSET],
        ASM_MESON_TAC [REAL_ABS_POS, REAL_LE_TRANS]]]))

  let REAL_ABEL_LEMMA ← prove
   r"!a M r r0.
        &0 <= r /\ r < r0 /\
        (!n. n IN k ==> abs(a n) * r0 pow n <= M)
        ==> real_summable k (\n. abs(a(n)) * r pow n)"
   (REWRITE_TAC [REAL_SUMMABLE_COMPLEX] THEN
    REWRITE_TAC [o_DEF, CX_MUL, CX_ABS] THEN REWRITE_TAC [← GSYM CX_MUL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ABEL_LEMMA THEN
    REWRITE_TAC [COMPLEX_NORM_CX] THEN ASM_MESON_TAC [])

  let REAL_POWER_SERIES_CONV_IMP_ABSCONV ← prove
   r"!a k w z.
        real_summable k (\n. a(n) * z pow n) /\ abs(w) < abs(z)
        ==> real_summable k (\n. abs(a(n) * w pow n))"
   (REWRITE_TAC [REAL_SUMMABLE_COMPLEX, o_DEF, CX_MUL, CX_ABS, CX_POW] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC POWER_SERIES_CONV_IMP_ABSCONV THEN
    EXISTS_TAC (← q r"Cx z") THEN ASM_REWRITE_TAC [COMPLEX_NORM_CX])

  let POWER_REAL_SERIES_CONV_IMP_ABSCONV_WEAK ← prove
   r"!a k w z.
        real_summable k (\n. a(n) * z pow n) /\ abs(w) < abs(z)
        ==> real_summable k (\n. abs(a n) * w pow n)"
   (REWRITE_TAC [REAL_SUMMABLE_COMPLEX, o_DEF, CX_MUL, CX_ABS, CX_POW] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC POWER_SERIES_CONV_IMP_ABSCONV_WEAK THEN
    EXISTS_TAC (← q r"Cx z") THEN ASM_REWRITE_TAC [COMPLEX_NORM_CX])

  let REAL_SUMMABLE_MUL_LEFT ← prove
   r"!x y m n p.
        real_summable (from m) (\n. abs(x n)) /\
        real_summable (from n) y
        ==> real_summable (from p) (\n. sum(0..n) (\i. x i * y(n - i)))"
   (ONCE_REWRITE_TAC [← SPEC (← q r"0") REAL_SUMMABLE_FROM_ELSEWHERE_EQ] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP REAL_SERIES_ABSCONV_IMP_CONV) THEN
    UNDISCH_TAC (← q r"real_summable (from 0) y") THEN
    REWRITE_TAC [real_summable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"a:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"a * b:real") THEN MATCH_MP_TAC REAL_SERIES_MUL THEN
    ASM_REWRITE_TAC [])

  let REAL_SUMMABLE_MUL_RIGHT ← prove
   r"!x y m n p.
        real_summable (from m) x /\
        real_summable (from n) (\n. abs(y n))
        ==> real_summable (from p) (\n. sum(0..n) (\i. x i * y(n - i)))"
   (ONCE_REWRITE_TAC [← SPEC (← q r"0") REAL_SUMMABLE_FROM_ELSEWHERE_EQ] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP REAL_SERIES_ABSCONV_IMP_CONV) THEN
    UNDISCH_TAC (← q r"real_summable (from 0) x") THEN
    REWRITE_TAC [real_summable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"a * b:real") THEN MATCH_MP_TAC REAL_SERIES_MUL THEN
    ASM_REWRITE_TAC [])

  pure { REAL_SERIES_CAUCHY_UNIFORM, REAL_SERIES_COMPARISON, REAL_SUMMABLE_COMPARISON,
         REAL_SERIES_COMPARISON_UNIFORM, REAL_SUMMABLE_POS_SUBSET, REAL_SUMMABLE_POS_PARTIAL_BOUND, REAL_SERIES_RATIO,
         BOUNDED_PARTIAL_REAL_SUMS, REAL_SERIES_DIRICHLET, REAL_SERIES_ABSCONV_IMP_CONV,
         SERIES_NORMCONV_IMP_CONV, REAL_SUMS_GP, REAL_SUMMABLE_GP, REAL_SUMMABLE_ZETA,
         REAL_SUMMABLE_ZETA_INTEGER, DIRICHLET_SERIES_FINITE_PERTURBATION, REAL_ABEL_LEMMA, REAL_POWER_SERIES_CONV_IMP_ABSCONV,
         POWER_REAL_SERIES_CONV_IMP_ABSCONV_WEAK, REAL_SUMMABLE_MUL_LEFT,
         REAL_SUMMABLE_MUL_RIGHT }
/- ------------------------------------------------------------------------- -/
/- Nets for real limit; usual limit results with real domain and either     -/
/- vector or real range.                                                    -/
/- (realanalysis.ml 1293-1542)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZF where
  atreal : thm
  ATREAL : thm
  NETLIMIT_ATREAL : thm
  NETLIMIT_WITHINREAL : thm
  WITHINREAL_UNIV : thm
  EVENTUALLY_ATREAL : thm
  TRIVIAL_LIMIT_ATREAL : thm
  EVENTUALLY_WITHINREAL : thm
  EVENTUALLY_WITHINREAL_LE : thm
  TRIVIAL_LIMIT_ATREAL_RIGHT : thm
  LIM_WITHINREAL_LE : thm
  LIM_WITHINREAL : thm
  LIM_ATREAL : thm
  REALLIM_WITHINREAL_LE : thm
  REALLIM_WITHINREAL : thm
  REALLIM_ATREAL : thm
  REALLIM_AT_POSINFINITY : thm
  REALLIM_AT_NEGINFINITY : thm
  LIM_ATREAL_WITHINREAL : thm
  REALLIM_AT_WITHIN : thm
  REALLIM_ATREAL_WITHINREAL : thm
  REALLIM_WITHIN_SUBSET : thm
  REALLIM_WITHINREAL_SUBSET : thm
  LIM_WITHINREAL_SUBSET : thm
  REALLIM_ATREAL_ID : thm
  REALLIM_WITHINREAL_ID : thm
  LIM_TRANSFORM_WITHINREAL_SET : thm
  REALLIM_TRANSFORM_WITHIN_SET : thm
  REALLIM_TRANSFORM_WITHINREAL_SET : thm
  REALLIM_TRANSFORM_WITHIN_SET_IMP : thm
  LIM_TRANSFORM_WITHINREAL_SET_IMP : thm
  REALLIM_TRANSFORM_WITHINREAL_SET_IMP : thm
  REALLIM_COMPOSE_WITHIN : thm
  REALLIM_COMPOSE_AT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZF [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) : ExceptT String IO RZF := do
  -- @@SCOPE BEGIN
  let { tendsto_real, TENDSTO_REAL, .. } := BRZA
  let { REALLIM_WITHIN, .. } := BRZB
  let { ATPOINTOF, EVENTUALLY_ATPOINTOF_METRIC, MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
        NET_WITHIN_UNIV, netlimit, NETLIMIT_ATPOINTOF, NETLIMITS_WITHIN,
        REAL_EUCLIDEAN_METRIC, REAL_OPEN_IN, trivial_limit, .. } := D.qmetric
  let { EVENTUALLY_AT_NEGINFINITY, .. } := D.qtopology
  let { APPROACHABLE_LT_LE, .. } := D.qmisc
  let { EVENTUALLY_AT_POSINFINITY, .. } := D.ts.qtopology
  let { LIM_AT_WITHIN, .. } := D.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { LEFT_AND_FORALL_THM, .. } := D.ts.cn.ms.ig.qsession
  let { LIM_TRANSFORM_WITHIN_SET_IMP, .. } := D.ts.cn.ms.ig.qtopology
  let { CONJ_ASSOC, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, MONO_FORALL, NOT_EXISTS_THM, REAL_ABS_SUB,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_MIN, .. } := D.ts.cn.cx.cvx.core4
  let { SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_NZ, .. } := D.ts.cn.cx.cvx.vec1
  let { EVENTUALLY_MONO, .. } := D.ts.cn.cx.cvx.met
  let { EVENTUALLY_AT, .. } := D.ts.cn.cx.cvx.top3
  let { EVENTUALLY_AND, EVENTUALLY_WITHIN_IMP, .. } := D.ts.cn.ms.ig.dv.dg.qmetric
  let { tendsto, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let atreal ← new_definition
   r"atreal a = atpointof euclideanreal a"

  let ATREAL ← prove
   r"!a. netfilter (atreal a) = { u | real_open u /\ a IN u}"
   (REWRITE_TAC [atreal, ATPOINTOF, REAL_OPEN_IN])

  let NETLIMIT_ATREAL ← prove
   r"!a. netlimit(atreal a) = a"
   (REWRITE_TAC [atreal, NETLIMIT_ATPOINTOF])

  let NETLIMIT_WITHINREAL ← prove
   r"!a s. netlimit (atreal a within s) = a"
   (REWRITE_TAC [netlimit, NETLIMITS_WITHIN] THEN
    REWRITE_TAC [← GSYM netlimit] THEN REWRITE_TAC [NETLIMIT_ATREAL])

  let WITHINREAL_UNIV ← prove
   r"!x. atreal x within (:real) = atreal x"
   (REWRITE_TAC [NET_WITHIN_UNIV])

  let EVENTUALLY_ATREAL ← prove
   r"!a p. eventually p (atreal a) <=>
         ?d. &0 < d /\ !x. &0 < abs(x - a) /\ abs(x - a) < d ==> p(x)"
   (REWRITE_TAC [atreal,  ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [EVENTUALLY_ATPOINTOF_METRIC] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [REAL_ABS_SUB])

  let TRIVIAL_LIMIT_ATREAL ← prove
   r"!a. ~(trivial_limit (atreal a))"
   (REWRITE_TAC [trivial_limit, EVENTUALLY_ATREAL, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"d:real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a + d / &2"))) THEN
    ASM_REAL_ARITH_TAC)

  let EVENTUALLY_WITHINREAL ← prove
   r"!s a p.
     eventually p (atreal a within s) <=>
      ?d. &0 < d /\ !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) < d ==> p(x)"
   (REWRITE_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_ATREAL] THEN MESON_TAC [])

  let EVENTUALLY_WITHINREAL_LE ← prove
   r"!s a p.
     eventually p (atreal a within s) <=>
        ?d. &0 < d /\
            !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) <= d ==> p(x)"
   (REWRITE_TAC [EVENTUALLY_WITHINREAL] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    REWRITE_TAC [APPROACHABLE_LT_LE])

  let TRIVIAL_LIMIT_ATREAL_RIGHT ← prove
   r"!a. ~trivial_limit(atreal a within {x | a < x})"
   (REWRITE_TAC [trivial_limit, EVENTUALLY_WITHINREAL, IN_ELIM_THM] THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [(← q r"a:real"), (← q r"d:real")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a + d / &2"))) THEN
    ASM_REAL_ARITH_TAC)

  let LIM_WITHINREAL_LE ← prove
   r"!f:real->real^N l a s.
        (f --> l) (atreal a within s) <=>
           !e. &0 < e ==> ?d. &0 < d /\
                              !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) <= d
                                   ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHINREAL_LE])

  let LIM_WITHINREAL ← prove
   r"!f:real->real^N l a s.
      (f --> l) (atreal a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) < d
                    ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_WITHINREAL] THEN MESON_TAC [])

  let LIM_ATREAL ← prove
   r"!f l:real^N a.
      (f --> l) (atreal a) <=>
              !e. &0 < e
                  ==> ?d. &0 < d /\ !x. &0 < abs(x - a) /\ abs(x - a) < d
                          ==> dist(f(x),l) < e"
   (REWRITE_TAC [tendsto, EVENTUALLY_ATREAL] THEN MESON_TAC [])

  let REALLIM_WITHINREAL_LE ← prove
   r"!f l a s.
        (f ---> l) (atreal a within s) <=>
           !e. &0 < e ==> ?d. &0 < d /\
                              !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) <= d
                                   ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_WITHINREAL_LE])

  let REALLIM_WITHINREAL ← prove
   r"!f l a s.
      (f ---> l) (atreal a within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x. x IN s /\ &0 < abs(x - a) /\ abs(x - a) < d
                    ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_WITHINREAL] THEN MESON_TAC [])

  let REALLIM_ATREAL ← prove
   r"!f l a.
      (f ---> l) (atreal a) <=>
              !e. &0 < e
                  ==> ?d. &0 < d /\ !x. &0 < abs(x - a) /\ abs(x - a) < d
                          ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_ATREAL] THEN MESON_TAC [])

  let REALLIM_AT_POSINFINITY ← prove
   r"!f l. (f ---> l) at_posinfinity <=>
               !e. &0 < e ==> ?b. !x. x >= b ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_AT_POSINFINITY] THEN MESON_TAC [])

  let REALLIM_AT_NEGINFINITY ← prove
   r"!f l. (f ---> l) at_neginfinity <=>
               !e. &0 < e ==> ?b. !x. x <= b ==> abs(f(x) - l) < e"
   (REWRITE_TAC [tendsto_real, EVENTUALLY_AT_NEGINFINITY] THEN MESON_TAC [])

  let LIM_ATREAL_WITHINREAL ← prove
   r"!f l a s. (f --> l) (atreal a) ==> (f --> l) (atreal a within s)"
   (REWRITE_TAC [LIM_ATREAL, LIM_WITHINREAL] THEN MESON_TAC [])

  let REALLIM_AT_WITHIN ← prove
   r"!f l a s. (f ---> l) (at a) ==> (f ---> l) (at a within s)"
   (REWRITE_TAC [TENDSTO_REAL, LIM_AT_WITHIN])

  let REALLIM_ATREAL_WITHINREAL ← prove
   r"!f l a s. (f ---> l) (atreal a) ==> (f ---> l) (atreal a within s)"
   (REWRITE_TAC [REALLIM_ATREAL, REALLIM_WITHINREAL] THEN MESON_TAC [])

  let REALLIM_WITHIN_SUBSET ← prove
   r"!f l a s t. (f ---> l) (at a within s) /\ t SUBSET s
               ==> (f ---> l) (at a within t)"
   (REWRITE_TAC [REALLIM_WITHIN, SUBSET] THEN MESON_TAC [])

  let REALLIM_WITHINREAL_SUBSET ← prove
   r"!f l a s t. (f ---> l) (atreal a within s) /\ t SUBSET s
               ==> (f ---> l) (atreal a within t)"
   (REWRITE_TAC [REALLIM_WITHINREAL, SUBSET] THEN MESON_TAC [])

  let LIM_WITHINREAL_SUBSET ← prove
   r"!f l a s t. (f --> l) (atreal a within s) /\ t SUBSET s
               ==> (f --> l) (atreal a within t)"
   (REWRITE_TAC [LIM_WITHINREAL, SUBSET] THEN MESON_TAC [])

  let REALLIM_ATREAL_ID ← prove
   r"((\x. x) ---> a) (atreal a)"
   (REWRITE_TAC [REALLIM_ATREAL] THEN MESON_TAC [])

  let REALLIM_WITHINREAL_ID ← prove
   r"!a. ((\x. x) ---> a) (atreal a within s)"
   (REWRITE_TAC [REALLIM_WITHINREAL] THEN MESON_TAC [])

  let LIM_TRANSFORM_WITHINREAL_SET ← prove
   r"!f a s t.
        eventually (\x. x IN s <=> x IN t) (atreal a)
        ==> ((f --> l) (atreal a within s) <=> (f --> l) (atreal a within t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_ATREAL, LIM_WITHINREAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let REALLIM_TRANSFORM_WITHIN_SET ← prove
   r"!f a s t.
        eventually (\x. x IN s <=> x IN t) (at a)
        ==> ((f ---> l) (at a within s) <=> (f ---> l) (at a within t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_AT, REALLIM_WITHIN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let REALLIM_TRANSFORM_WITHINREAL_SET ← prove
   r"!f a s t.
        eventually (\x. x IN s <=> x IN t) (atreal a)
        ==> ((f ---> l) (atreal a within s) <=>
             (f ---> l) (atreal a within t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_ATREAL, REALLIM_WITHINREAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let REALLIM_TRANSFORM_WITHIN_SET_IMP ← prove
   r"!f l a s t.
        eventually (\x. x IN t ==> x IN s) (at a) /\ (f ---> l) (at a within s)
        ==> (f ---> l) (at a within t)"
   (REWRITE_TAC [TENDSTO_REAL, LIM_TRANSFORM_WITHIN_SET_IMP])

  let LIM_TRANSFORM_WITHINREAL_SET_IMP ← prove
   r"!f l a s t.
        eventually (\x. x IN t ==> x IN s) (atreal a) /\
        (f --> l) (atreal a within s)
        ==> (f --> l) (atreal a within t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, EVENTUALLY_ATREAL, LIM_WITHINREAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [])

  let REALLIM_TRANSFORM_WITHINREAL_SET_IMP ← prove
   r"!f l a s t.
        eventually (\x. x IN t ==> x IN s) (atreal a) /\
        (f ---> l) (atreal a within s)
        ==> (f ---> l) (atreal a within t)"
   (REWRITE_TAC [TENDSTO_REAL, LIM_TRANSFORM_WITHINREAL_SET_IMP])

  let REALLIM_COMPOSE_WITHIN ← prove
   r"!net:A net f g s y z.
    (f ---> y) net /\
    eventually (\w. f w IN s /\ (f w = y ==> g y = z)) net /\
    (g ---> z) (atreal y within s)
    ==> ((g o f) ---> z) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real, CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [LEFT_AND_FORALL_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EVENTUALLY_WITHINREAL, ← GSYM DIST_NZ, o_DEF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real")) THEN
    ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(f:A->real) x = y") THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs(x - y) = &0 <=> x = y"),
                   ← REAL_ARITH (← q r"&0 < abs(x - y) <=> ~(x = y)")])

  let REALLIM_COMPOSE_AT ← prove
   r"!net:A net f g y z.
    (f ---> y) net /\
    eventually (\w. f w = y ==> g y = z) net /\
    (g ---> z) (atreal y)
    ==> ((g o f) ---> z) net"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"net:A net", ← q r"f:A->real", ← q r"g:real->real",
                      ← q r"(:real)", ← q r"y:real", ← q r"z:real"]
          REALLIM_COMPOSE_WITHIN) THEN
    ASM_REWRITE_TAC [IN_UNIV, WITHINREAL_UNIV])

  pure { atreal, ATREAL, NETLIMIT_ATREAL, NETLIMIT_WITHINREAL, WITHINREAL_UNIV,
         EVENTUALLY_ATREAL, TRIVIAL_LIMIT_ATREAL, EVENTUALLY_WITHINREAL,
         EVENTUALLY_WITHINREAL_LE, TRIVIAL_LIMIT_ATREAL_RIGHT, LIM_WITHINREAL_LE, LIM_WITHINREAL, LIM_ATREAL,
         REALLIM_WITHINREAL_LE, REALLIM_WITHINREAL, REALLIM_ATREAL,
         REALLIM_AT_POSINFINITY, REALLIM_AT_NEGINFINITY, LIM_ATREAL_WITHINREAL,
         REALLIM_AT_WITHIN, REALLIM_ATREAL_WITHINREAL, REALLIM_WITHIN_SUBSET,
         REALLIM_WITHINREAL_SUBSET, LIM_WITHINREAL_SUBSET, REALLIM_ATREAL_ID,
         REALLIM_WITHINREAL_ID, LIM_TRANSFORM_WITHINREAL_SET,
         REALLIM_TRANSFORM_WITHIN_SET, REALLIM_TRANSFORM_WITHINREAL_SET,
         REALLIM_TRANSFORM_WITHIN_SET_IMP, LIM_TRANSFORM_WITHINREAL_SET_IMP,
         REALLIM_TRANSFORM_WITHINREAL_SET_IMP, REALLIM_COMPOSE_WITHIN,
         REALLIM_COMPOSE_AT }
/- ------------------------------------------------------------------------- -/
/- Summability of alternating series; relations between limits at real and  -/
/- complex limit points; simpler theorems relating limits in real and      -/
/- real^1; additional congruence rules; real version of Abel's theorem.     -/
/- (realanalysis.ml 1543-1804)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZG where
  ALTERNATING_SUM_BOUNDS : thm
  ALTERNATING_SUM_BOUND : thm
  REAL_SUMMABLE_ALTERNATING_SERIES : thm
  TRIVIAL_LIMIT_WITHINREAL_WITHIN : thm
  TRIVIAL_LIMIT_WITHINREAL_WITHINCOMPLEX : thm
  LIM_WITHINREAL_WITHINCOMPLEX : thm
  LIM_ATREAL_ATCOMPLEX : thm
  LIM_WITHINREAL_WITHIN : thm
  LIM_ATREAL_AT : thm
  REALLIM_WITHINREAL_WITHIN : thm
  REALLIM_ATREAL_AT : thm
  REALLIM_WITHIN_OPEN : thm
  LIM_WITHIN_REAL_OPEN : thm
  REALLIM_WITHIN_REAL_OPEN : thm
  LIM_ATREAL_ZERO : thm
  REALLIM_AT_ZERO : thm
  REALLIM_ATREAL_ZERO : thm
  LIM_CONG_WITHINREAL : thm
  LIM_CONG_ATREAL : thm
  REALLIM_CONG_WITHIN : thm
  REALLIM_CONG_AT : thm
  REALLIM_CONG_WITHINREAL : thm
  REALLIM_CONG_ATREAL : thm
  REAL_ABEL_LIMIT_THEOREM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZG [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZC : RZC) (BRZF : RZF) : ExceptT String IO RZG := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, REALLIM_COMPLEX, TENDSTO_REAL, .. } := BRZA
  let { REALLIM_AT, REALLIM_SEQUENTIALLY, REALLIM_WITHIN, .. } := BRZB
  let { REAL_INFSUM_COMPLEX, REAL_SUMMABLE_CAUCHY, REAL_SUMMABLE_COMPLEX, .. } := BRZC
  let { ATREAL, EVENTUALLY_WITHINREAL, LIM_ATREAL, LIM_WITHINREAL, REALLIM_ATREAL,
        REALLIM_WITHINREAL, .. } := BRZF
  let { trivial_limit, WITHIN, .. } := D.qmetric
  let { AT, .. } := D.qtopology
  let { FROM_INTER_NUMSEG_MAX, .. } := D.qmisc
  let { REAL_LIM, .. } := D.ts.knm
  let { ABEL_LIMIT_THEOREM_1, .. } := D.ts.knq
  let { NOT_EVEN, ODD_ADD, .. } := D.ts.qsession
  let { extend_basic_congs, .. } := D.ts.cn.cx
  let { COMPLEX_NORM_CX, CX_INJ, CX_MUL, CX_POW, CX_SUB, DIST_CX, RE_CX, .. } := D.ts.cn.cxc
  let { FORALL_REAL, REAL, REAL_CX, REAL_VSUM, .. } := D.ts.cn.cxi
  let { SUMS_INFSUM, .. } := D.ts.cn.qtopology
  let { SUM_SING_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { LIM_AT_ZERO, .. } := D.ts.cn.ms.qtopology2
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC,
        NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { ADD_CLAUSES, .. } := D.ts.cn.cx.cpx
  let { LE_EXISTS, .. } := D.ts.cn.ms.ig.qsession
  let { ADD1, ARITH, FINITE_INTER, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, GE, IMP_CONJ, IN, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, MONO_EXISTS, MONO_FORALL, NOT_LT, NUMSEG_EMPTY,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADDR, REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_01, REAL_LT_MIN,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_SUB_0, REAL_SUB_RZERO, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES, SUM_CLAUSES_LEFT, UNWIND_THM1,
        .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, DIST_NZ, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_ADD, FORALL_LIFT, LIFT_DROP, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { EVENTUALLY_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { LIM_WITHIN, .. } := D.ts.cn.cx.cvx.top4
  let { SEQUENTIALLY, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { REAL_ABS_NZ, .. } := D.ts.cn.ms.ig.dv.qsession
  let { LIM_AT, .. } := D.ts.cn.ms.ig.dv.qtopology1
  let { LIM_TRANSFORM_WITHIN, LIM_WITHIN_OPEN, sums, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { EVEN_ADD, NOT_ODD, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let ALTERNATING_SUM_BOUNDS ← prove
   r"!a. (!n. abs(a(SUC n)) <= abs(a n)) /\
       (!n. EVEN n ==> &0 <= a n) /\ (!n. ODD n ==> a n <= &0)
       ==> !m n. (EVEN m ==> &0 <= sum(m..n) a /\ sum(m..n) a <= a(m)) /\
                 (ODD m ==> a(m) <= sum(m..n) a /\ sum(m..n) a <= &0)"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC (← MESON [LE_EXISTS, NOT_LT]
     (← q r"(!m n:num. n < m ==> P m n) /\ (!n m. P m (m + n)) ==> !m n. P m n")) THEN
    ASM_SIMP_TAC [← GSYM NUMSEG_EMPTY, SUM_CLAUSES, REAL_LE_REFL] THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [ADD_CLAUSES, SUM_SING_NUMSEG, REAL_LE_REFL] THEN
    SIMP_TAC [SUM_CLAUSES_LEFT, ← ARITH_RULE (← q r"m <= SUC(m + n)")] THEN
    X_GEN_TAC (← q r"m:num") THEN  SIMP_TAC [← ARITH_RULE (← q r"SUC(m + n) = (m + 1) + n")] THEN
    CONJ_TAC THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC o SPEC (← q r"m + 1")) THEN
    ASM_REWRITE_TAC [ODD_ADD, EVEN_ADD, ARITH, NOT_ODD, NOT_EVEN] THEN
    SIMP_TAC [REAL_LE_ADDR, ← REAL_ARITH (← q r"x + y <= x <=> y <= &0")] THENL
     [MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs b <= abs a /\ &0 <= a ==> b <= s /\ u <= v ==> &0 <= a + s")),
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs b <= abs a /\ a <= &0 ==> u <= v /\ s <= b ==> a + s <= &0"))] THEN
    ASM_SIMP_TAC [← GSYM ADD1])

  let ALTERNATING_SUM_BOUND ← prove
   r"!a. (!n. abs(a(SUC n)) <= abs(a n)) /\
       (!n. EVEN n ==> &0 <= a n) /\ (!n. ODD n ==> a n <= &0)
       ==> !m n. abs(sum(m..n) a) <= abs(a m)"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP ALTERNATING_SUM_BOUNDS) THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REWRITE_TAC [← GSYM NOT_EVEN] THEN ASM_CASES_TAC (← q r"EVEN m") THEN
    ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let REAL_SUMMABLE_ALTERNATING_SERIES ← prove
   r"!a m. (!n. abs(a(SUC n)) <= abs(a n)) /\
         (!n. EVEN n ==> &0 <= a n) /\ (!n. ODD n ==> a n <= &0) /\
         (a ---> &0) sequentially
         ==> real_summable (from m) a"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [REAL_SUMMABLE_CAUCHY, FROM_INTER_NUMSEG_MAX] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REALLIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [GE, REAL_SUB_RZERO] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"p:num"] THEN DISCH_TAC THEN
    TRANS_TAC REAL_LET_TRANS (← q r"abs(a(MAX m n))") THEN
    ASM_SIMP_TAC [ALTERNATING_SUM_BOUND] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_ARITH_TAC)

  let TRIVIAL_LIMIT_WITHINREAL_WITHIN ← prove
   r"trivial_limit(atreal x within s) <=>
        trivial_limit(at (lift x) within (IMAGE lift s))"
   (REWRITE_TAC [trivial_limit, AT, WITHIN, ATREAL] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, EVENTUALLY_WITHINREAL] THEN
    REWRITE_TAC [← TAUT (← q r"~(p /\ q /\ r) <=> p ==> ~(q /\ r)")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, DIST_LIFT])

  let TRIVIAL_LIMIT_WITHINREAL_WITHINCOMPLEX ← prove
   r"trivial_limit(atreal x within s) <=>
        trivial_limit(at (Cx x) within (real INTER IMAGE Cx s))"
   (REWRITE_TAC [trivial_limit, AT, WITHIN, ATREAL] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, EVENTUALLY_WITHINREAL] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(!x. ~(x IN s INTER IMAGE f t /\ P x /\ Q x)) <=>
      (!x. x IN t ==> ~(f x IN s /\ P(f x) /\ Q(f x)))")] THEN
    REWRITE_TAC [DIST_CX, REAL_CX, IN] THEN MESON_TAC [])

  let LIM_WITHINREAL_WITHINCOMPLEX ← prove
   r"(f --> a) (atreal x within s) <=>
   ((f o Re) --> a) (at(Cx x) within (real INTER IMAGE Cx s))"
   (REWRITE_TAC [LIM_WITHINREAL, LIM_WITHIN] THEN
    REWRITE_TAC [← SET_RULE (← q r"x IN real INTER s <=> real x /\ x IN s")] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_REAL,
      ← MESON [IN_IMAGE, CX_INJ] (← q r"Cx x IN IMAGE Cx s <=> x IN s")] THEN
    REWRITE_TAC [dist, ← GSYM CX_SUB, o_THM, RE_CX, COMPLEX_NORM_CX])

  let LIM_ATREAL_ATCOMPLEX ← prove
   r"(f --> a) (atreal x) <=> ((f o Re) --> a) (at (Cx x) within real)"
   (REWRITE_TAC [LIM_ATREAL, LIM_WITHIN] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_REAL, IN, dist, ← GSYM CX_SUB, COMPLEX_NORM_CX,
                 o_THM, RE_CX])

  let LIM_WITHINREAL_WITHIN ← prove
   r"(f --> a) (atreal x within s) <=>
        ((f o drop) --> a) (at (lift x) within (IMAGE lift s))"
   (REWRITE_TAC [LIM_WITHINREAL, LIM_WITHIN] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, DIST_LIFT, o_THM, LIFT_DROP])

  let LIM_ATREAL_AT ← prove
   r"(f --> a) (atreal x) <=> ((f o drop) --> a) (at (lift x))"
   (REWRITE_TAC [LIM_ATREAL, LIM_AT, FORALL_LIFT] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, DIST_LIFT, o_THM, LIFT_DROP])

  let REALLIM_WITHINREAL_WITHIN ← prove
   r"(f ---> a) (atreal x within s) <=>
        ((f o drop) ---> a) (at (lift x) within (IMAGE lift s))"
   (REWRITE_TAC [REALLIM_WITHINREAL, REALLIM_WITHIN] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, DIST_LIFT, o_THM, LIFT_DROP])

  let REALLIM_ATREAL_AT ← prove
   r"(f ---> a) (atreal x) <=> ((f o drop) ---> a) (at (lift x))"
   (REWRITE_TAC [REALLIM_ATREAL, REALLIM_AT, FORALL_LIFT] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, DIST_LIFT, o_THM, LIFT_DROP])

  let REALLIM_WITHIN_OPEN ← prove
   r"!f:real^N->real l a s.
        a IN s /\ open s
        ==> ((f ---> l) (at a within s) <=> (f ---> l) (at a))"
   (REWRITE_TAC [TENDSTO_REAL, LIM_WITHIN_OPEN])

  let LIM_WITHIN_REAL_OPEN ← prove
   r"!f:real->real^N l a s.
        a IN s /\ real_open s
        ==> ((f --> l) (atreal a within s) <=> (f --> l) (atreal a))"
   (REWRITE_TAC [LIM_WITHINREAL_WITHIN, LIM_ATREAL_AT, REAL_OPEN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_WITHIN_OPEN THEN ASM SET_TAC [])

  let REALLIM_WITHIN_REAL_OPEN ← prove
   r"!f l a s.
        a IN s /\ real_open s
        ==> ((f ---> l) (atreal a within s) <=> (f ---> l) (atreal a))"
   (REWRITE_TAC [TENDSTO_REAL, LIM_WITHIN_REAL_OPEN])

  let LIM_ATREAL_ZERO ← prove
   r"!f l a. (f --> l) (atreal a) <=> ((\x. f (a + x)) --> l) (atreal (&0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_ATREAL_AT, LIFT_NUM, o_DEF] THEN
    GEN_REWRITE_TAC LAND_CONV [LIM_AT_ZERO] THEN
    REWRITE_TAC [LIFT_DROP, DROP_ADD])

  let REALLIM_AT_ZERO ← prove
   r"!f l a. (f ---> l) (at a) <=> ((\x. f (a + x)) ---> l) (at (vec 0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    GEN_REWRITE_TAC LAND_CONV [LIM_AT_ZERO] THEN
    REWRITE_TAC [o_DEF])

  let REALLIM_ATREAL_ZERO ← prove
   r"!f l a. (f ---> l) (atreal a) <=> ((\x. f (a + x)) ---> l) (atreal (&0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    GEN_REWRITE_TAC LAND_CONV [LIM_ATREAL_ZERO] THEN
    REWRITE_TAC [o_DEF])

  let LIM_CONG_WITHINREAL ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) --> l) (atreal a within s) <=>
        ((g --> l) (atreal a within s)))"
   (SIMP_TAC [LIM_WITHINREAL, ← GSYM REAL_ABS_NZ, REAL_SUB_0])

  let LIM_CONG_ATREAL ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) --> l) (atreal a) <=> ((g --> l) (atreal a)))"
   (SIMP_TAC [LIM_ATREAL, ← GSYM REAL_ABS_NZ, REAL_SUB_0])

  extend_basic_congs [LIM_CONG_WITHINREAL, LIM_CONG_ATREAL]

  let REALLIM_CONG_WITHIN ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) ---> l) (at a within s) <=> ((g ---> l) (at a within s)))"
   (REWRITE_TAC [REALLIM_WITHIN, ← GSYM DIST_NZ] THEN SIMP_TAC [])

  let REALLIM_CONG_AT ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) ---> l) (at a) <=> ((g ---> l) (at a)))"
   (REWRITE_TAC [REALLIM_AT, ← GSYM DIST_NZ] THEN SIMP_TAC [])

  extend_basic_congs [REALLIM_CONG_WITHIN, REALLIM_CONG_AT]

  let REALLIM_CONG_WITHINREAL ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) ---> l) (atreal a within s) <=>
        ((g ---> l) (atreal a within s)))"
   (SIMP_TAC [REALLIM_WITHINREAL, ← GSYM REAL_ABS_NZ, REAL_SUB_0])

  let REALLIM_CONG_ATREAL ← prove
   r"(!x. ~(x = a) ==> f x = g x)
   ==> (((\x. f x) ---> l) (atreal a) <=> ((g ---> l) (atreal a)))"
   (SIMP_TAC [REALLIM_ATREAL, ← GSYM REAL_ABS_NZ, REAL_SUB_0])

  extend_basic_congs [REALLIM_CONG_WITHINREAL, REALLIM_CONG_ATREAL]

  let REAL_ABEL_LIMIT_THEOREM ← prove
   r"!s a. real_summable s a
         ==> (!r. abs(r) < &1 ==> real_summable s (\i. a i * r pow i)) /\
             ((\r. real_infsum s  (\i. a i * r pow i)) ---> real_infsum s a)
             (atreal (&1) within {z | z <= &1})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"&1", ← q r"s:num->bool", ← q r"Cx o (a:num->real)"]
          ABEL_LIMIT_THEOREM_1) THEN
    ASM_REWRITE_TAC [← GSYM REAL_SUMMABLE_COMPLEX, REAL_LT_01] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"Cx r")) THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_CX, REAL_SUMMABLE_COMPLEX] THEN
      REWRITE_TAC [o_DEF, CX_MUL, CX_POW],
      DISCH_TAC] THEN
    REWRITE_TAC [REALLIM_COMPLEX, LIM_WITHINREAL_WITHINCOMPLEX] THEN
    MATCH_MP_TAC LIM_TRANSFORM_WITHIN THEN
    EXISTS_TAC (← q r"\z. infsum s (\i. (Cx o a) i * z pow i)") THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN CONJ_TAC THENL
     [REWRITE_TAC [IMP_CONJ, IN_INTER, IN_ELIM_THM, IN_IMAGE] THEN
      REWRITE_TAC [IN, FORALL_REAL] THEN X_GEN_TAC (← q r"r:real") THEN
      REWRITE_TAC [CX_INJ, UNWIND_THM1, dist, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
      DISCH_TAC THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"r <= &1 ==> (&0 < abs(r - &1) <=> r < &1)")] THEN
      REPEAT DISCH_TAC THEN SUBGOAL_THEN (← q r"abs(r) < &1") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_INFSUM_COMPLEX, o_THM, RE_CX] THEN
      CONV_TAC SYM_CONV THEN REWRITE_TAC [← GSYM REAL, o_DEF, CX_MUL, CX_POW] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") REAL_LIM) THEN
      EXISTS_TAC (← q r"\n. vsum(s INTER (0..n)) (\i. Cx(a i) * Cx r pow i)") THEN
      REWRITE_TAC [SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, ← GSYM sums] THEN
      SIMP_TAC [← GSYM CX_POW, ← GSYM CX_MUL, REAL_VSUM, FINITE_INTER, FINITE_NUMSEG,
                SUMS_INFSUM, REAL_CX, GE, EVENTUALLY_TRUE] THEN
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      ASM_SIMP_TAC [← GSYM REAL_SUMMABLE_COMPLEX],
      ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_INFSUM_COMPLEX] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_WITHIN]) THEN
    REWRITE_TAC [LIM_WITHIN] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [REAL_MUL_LID, IN_ELIM_THM, IN_INTER, IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*"))) THEN
    EXISTS_TAC (← q r"min d (&1)") THEN ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_01] THEN
    REWRITE_TAC [IMP_CONJ, IN, FORALL_REAL] THEN
    REWRITE_TAC [CX_INJ, UNWIND_THM1, dist, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
    X_GEN_TAC (← q r"r:real") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"r <= &1 ==> (&0 < abs(r - &1) <=> r < &1)")] THEN
    REPEAT DISCH_TAC THEN SUBGOAL_THEN (← q r"abs(r) < &1") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"Cx r")) THEN
    REWRITE_TAC [CX_INJ, UNWIND_THM1, dist, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"b = a ==> norm(x - a) < e ==> norm(x - b) < e")) THEN
    REWRITE_TAC [← GSYM REAL] THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") REAL_LIM) THEN
    EXISTS_TAC (← q r"\n. vsum(s INTER (0..n)) (Cx o a)") THEN
    REWRITE_TAC [SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, ← GSYM sums] THEN
    SIMP_TAC [← GSYM CX_POW, ← GSYM CX_MUL, REAL_VSUM, FINITE_INTER, FINITE_NUMSEG,
              SUMS_INFSUM, REAL_CX, GE, o_DEF, EVENTUALLY_TRUE] THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    ASM_SIMP_TAC [← GSYM REAL_SUMMABLE_COMPLEX])

  pure { ALTERNATING_SUM_BOUNDS, ALTERNATING_SUM_BOUND, REAL_SUMMABLE_ALTERNATING_SERIES,
         TRIVIAL_LIMIT_WITHINREAL_WITHIN, TRIVIAL_LIMIT_WITHINREAL_WITHINCOMPLEX,
         LIM_WITHINREAL_WITHINCOMPLEX, LIM_ATREAL_ATCOMPLEX, LIM_WITHINREAL_WITHIN,
         LIM_ATREAL_AT, REALLIM_WITHINREAL_WITHIN, REALLIM_ATREAL_AT, REALLIM_WITHIN_OPEN,
         LIM_WITHIN_REAL_OPEN, REALLIM_WITHIN_REAL_OPEN, LIM_ATREAL_ZERO, REALLIM_AT_ZERO,
         REALLIM_ATREAL_ZERO, LIM_CONG_WITHINREAL, LIM_CONG_ATREAL, REALLIM_CONG_WITHIN,
         REALLIM_CONG_AT, REALLIM_CONG_WITHINREAL, REALLIM_CONG_ATREAL,
         REAL_ABEL_LIMIT_THEOREM }
/- ------------------------------------------------------------------------- -/
/- Continuity of a function into the reals; arithmetic combining theorems;  -/
/- some of these without netlimit, but with many different cases.           -/
/- (realanalysis.ml 1805-2137)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZH where
  real_continuous : thm
  REAL_CONTINUOUS_TRIVIAL_LIMIT : thm
  REAL_CONTINUOUS_WITHIN : thm
  REAL_CONTINUOUS_AT : thm
  REAL_CONTINUOUS_WITHINREAL : thm
  REAL_CONTINUOUS_ATREAL : thm
  CONTINUOUS_WITHINREAL : thm
  CONTINUOUS_ATREAL : thm
  real_continuous_within : thm
  real_continuous_at : thm
  real_continuous_withinreal : thm
  real_continuous_atreal : thm
  REAL_CONTINUOUS_AT_WITHIN : thm
  REAL_CONTINUOUS_ATREAL_WITHINREAL : thm
  REAL_CONTINUOUS_WITHINREAL_SUBSET : thm
  REAL_CONTINUOUS_WITHIN_SUBSET : thm
  CONTINUOUS_WITHINREAL_SUBSET : thm
  continuous_withinreal : thm
  continuous_atreal : thm
  CONTINUOUS_ATREAL_WITHINREAL : thm
  CONTINUOUS_CX_ATREAL : thm
  CONTINUOUS_CX_WITHINREAL : thm
  REAL_CONTINUOUS_TRANSFORM_WITHIN : thm
  REAL_CONTINUOUS_TRANSFORM_WITHINREAL : thm
  REAL_CONTINUOUS_TRANSFORM_AT : thm
  REAL_CONTINUOUS_TRANSFORM_ATREAL : thm
  REAL_CONTINUOUS_CONST : thm
  REAL_CONTINUOUS_LMUL : thm
  REAL_CONTINUOUS_RMUL : thm
  REAL_CONTINUOUS_NEG : thm
  REAL_CONTINUOUS_ADD : thm
  REAL_CONTINUOUS_SUB : thm
  REAL_CONTINUOUS_MUL : thm
  REAL_CONTINUOUS_INV : thm
  REAL_CONTINUOUS_DIV : thm
  REAL_CONTINUOUS_POW : thm
  REAL_CONTINUOUS_ABS : thm
  REAL_CONTINUOUS_MAX : thm
  REAL_CONTINUOUS_MIN : thm
  REAL_CONTINUOUS_WITHIN_ID : thm
  REAL_CONTINUOUS_AT_ID : thm
  REAL_CONTINUOUS_INV_WITHIN : thm
  REAL_CONTINUOUS_INV_AT : thm
  REAL_CONTINUOUS_INV_WITHINREAL : thm
  REAL_CONTINUOUS_INV_ATREAL : thm
  REAL_CONTINUOUS_DIV_WITHIN : thm
  REAL_CONTINUOUS_DIV_AT : thm
  REAL_CONTINUOUS_DIV_WITHINREAL : thm
  REAL_CONTINUOUS_DIV_ATREAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZH [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZF : RZF) : ExceptT String IO RZH := do
  -- @@SCOPE BEGIN
  let { REALLIM_ABS, REALLIM_ADD, REALLIM_CONST, REALLIM_DIV, REALLIM_INV, REALLIM_LMUL,
        REALLIM_MAX, REALLIM_MIN, REALLIM_MUL, REALLIM_NEG, REALLIM_POW, REALLIM_RMUL,
        REALLIM_SUB, REALLIM_TRIVIAL, .. } := BRZA
  let { REALLIM_WITHIN, .. } := BRZB
  let { LIM_WITHINREAL, LIM_WITHINREAL_SUBSET, NETLIMIT_WITHINREAL, REALLIM_WITHIN_SUBSET,
        REALLIM_WITHINREAL, REALLIM_WITHINREAL_SUBSET, WITHINREAL_UNIV, .. } := BRZF
  let { COMPLEX_NORM_CX, CX_SUB, .. } := D.ts.cn.cxc
  let { continuous, .. } := D.ts.cn.qtopology
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { FUN_EQ_THM, .. } := D.ts.cn.cx.cvx.core2
  let { IN_UNIV, MONO_AND, MONO_EXISTS, MONO_FORALL, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_MIN, .. } := D.ts.cn.cx.cvx.core4
  let { DIST_NZ, DIST_REFL, .. } := D.ts.cn.cx.cvx.vec1
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { NETLIMIT_WITHIN, WITHIN_UNIV, .. } := D.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  parse_as_infix ("real_continuous", (12, "right"))

  let real_continuous ← new_definition
    r"f real_continuous net <=> (f ---> f(netlimit net)) net"

  let REAL_CONTINUOUS_TRIVIAL_LIMIT ← prove
   r"!f net. trivial_limit net ==> f real_continuous net"
   (SIMP_TAC [real_continuous, REALLIM_TRIVIAL])

  let REAL_CONTINUOUS_WITHIN ← prove
   r"!f x:real^N s.
        f real_continuous (at x within s) <=>
                (f ---> f(x)) (at x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_continuous] THEN
    ASM_CASES_TAC (← q r"trivial_limit(at(x:real^N) within s)") THEN
    ASM_SIMP_TAC [REALLIM_TRIVIAL, NETLIMIT_WITHIN])

  let REAL_CONTINUOUS_AT ← prove
   r"!f x. f real_continuous (at x) <=> (f ---> f(x)) (at x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_WITHIN, IN_UNIV])

  let REAL_CONTINUOUS_WITHINREAL ← prove
   r"!f x s. f real_continuous (atreal x within s) <=>
                (f ---> f(x)) (atreal x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_continuous] THEN
    ASM_CASES_TAC (← q r"trivial_limit(atreal x within s)") THEN
    ASM_SIMP_TAC [REALLIM_TRIVIAL, NETLIMIT_WITHINREAL])

  let REAL_CONTINUOUS_ATREAL ← prove
   r"!f x. f real_continuous (atreal x) <=> (f ---> f(x)) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_WITHINREAL, IN_UNIV])

  let CONTINUOUS_WITHINREAL ← prove
   r"!f x s. f continuous (atreal x within s) <=>
                 (f --> f(x)) (atreal x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous] THEN
    ASM_CASES_TAC (← q r"trivial_limit(atreal x within s)") THEN
    ASM_SIMP_TAC [REALLIM_TRIVIAL, NETLIMIT_WITHINREAL])

  let CONTINUOUS_ATREAL ← prove
   r"!f x. f continuous (atreal x) <=> (f --> f(x)) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHINREAL, IN_UNIV])

  let real_continuous_within ← prove
   r"f real_continuous (at x within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. x' IN s /\ dist(x',x) < d ==> abs(f x' - f x) < e)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHIN, REALLIM_WITHIN] THEN
    REWRITE_TAC [← GSYM DIST_NZ] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs(x - x) = &0")])

  let real_continuous_at ← prove
   r"f real_continuous (at x) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. dist(x',x) < d ==> abs(f x' - f x) < e)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [real_continuous_within, IN_UNIV])

  let real_continuous_withinreal ← prove
   r"f real_continuous (atreal x within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. x' IN s /\ abs(x' - x) < d ==> abs(f x' - f x) < e)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHINREAL, REALLIM_WITHINREAL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < abs(x - y) <=> ~(x = y)")] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs(x - x) = &0")])

  let real_continuous_atreal ← prove
   r"f real_continuous (atreal x) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. abs(x' - x) < d ==> abs(f x' - f x) < e)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [real_continuous_withinreal, IN_UNIV])

  let REAL_CONTINUOUS_AT_WITHIN ← prove
   r"!f s x. f real_continuous (at x)
           ==> f real_continuous (at x within s)"
   (REWRITE_TAC [real_continuous_within, real_continuous_at] THEN
    MESON_TAC [])

  let REAL_CONTINUOUS_ATREAL_WITHINREAL ← prove
   r"!f s x. f real_continuous (atreal x)
           ==> f real_continuous (atreal x within s)"
   (REWRITE_TAC [real_continuous_withinreal, real_continuous_atreal] THEN
    MESON_TAC [])

  let REAL_CONTINUOUS_WITHINREAL_SUBSET ← prove
   r"!f s t. f real_continuous (atreal x within s) /\ t SUBSET s
             ==> f real_continuous (atreal x within t)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHINREAL, REALLIM_WITHINREAL_SUBSET])

  let REAL_CONTINUOUS_WITHIN_SUBSET ← prove
   r"!f s t. f real_continuous (at x within s) /\ t SUBSET s
             ==> f real_continuous (at x within t)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHIN, REALLIM_WITHIN_SUBSET])

  let CONTINUOUS_WITHINREAL_SUBSET ← prove
   r"!f s t. f continuous (atreal x within s) /\ t SUBSET s
             ==> f continuous (atreal x within t)"
   (REWRITE_TAC [CONTINUOUS_WITHINREAL, LIM_WITHINREAL_SUBSET])

  let continuous_withinreal ← prove
   r"f continuous (atreal x within s) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. x' IN s /\ abs(x' - x) < d ==> dist(f x',f x) < e)"
   (REWRITE_TAC [CONTINUOUS_WITHINREAL, LIM_WITHINREAL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < abs(x - y) <=> ~(x = y)")] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"d:real") THEN
    ASM_CASES_TAC (← q r"&0 < d") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [DIST_REFL])

  let continuous_atreal ← prove
   r"f continuous (atreal x) <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    (!x'. abs(x' - x) < d ==> dist(f x',f x) < e)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [continuous_withinreal, IN_UNIV])

  let CONTINUOUS_ATREAL_WITHINREAL ← prove
   r"!f x s. f continuous (atreal x) ==> f continuous (atreal x within s)"
   (SIMP_TAC [continuous_atreal, continuous_withinreal] THEN MESON_TAC [])

  let CONTINUOUS_CX_ATREAL ← prove
   r"!x. Cx continuous (atreal x)"
   (GEN_TAC THEN REWRITE_TAC [continuous_atreal, dist] THEN
    REWRITE_TAC [COMPLEX_NORM_CX, ← GSYM CX_SUB] THEN MESON_TAC [])

  let CONTINUOUS_CX_WITHINREAL ← prove
   r"!s x. Cx continuous (atreal x within s)"
   (SIMP_TAC [CONTINUOUS_ATREAL_WITHINREAL, CONTINUOUS_CX_ATREAL])

  let REAL_CONTINUOUS_TRANSFORM_WITHIN ← prove
   r"!f g s:real^N->bool x d.
           &0 < d /\
           x IN s /\
           (!x'. x' IN s /\ dist(x',x) < d ==> f x' = g x') /\
           f real_continuous at x within s
           ==> g real_continuous at x within s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_continuous_within] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d e:real") THEN  ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [DIST_REFL])

  let REAL_CONTINUOUS_TRANSFORM_WITHINREAL ← prove
   r"!f g s x d.
           &0 < d /\
           x IN s /\
           (!x'. x' IN s /\ abs(x' - x) < d ==> f x' = g x') /\
           f real_continuous atreal x within s
           ==> g real_continuous atreal x within s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_continuous_withinreal] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d e:real") THEN  ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs(x - x) = &0")])

  let REAL_CONTINUOUS_TRANSFORM_AT ← prove
   r"!f g x:real^N d.
           &0 < d /\
           (!x'. dist(x',x) < d ==> f x' = g x') /\
           f real_continuous at x
           ==> g real_continuous at x"
   (MP_TAC REAL_CONTINUOUS_TRANSFORM_WITHIN THEN
    REPLICATE_TAC 2 (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N)")) THEN
    REWRITE_TAC [IN_UNIV, WITHIN_UNIV])

  let REAL_CONTINUOUS_TRANSFORM_ATREAL ← prove
   r"!f g x d.
        &0 < d /\
        (!x'. abs(x' - x) < d ==> f x' = g x') /\
        f real_continuous (atreal x)
        ==> g real_continuous (atreal x)"
   (MP_TAC REAL_CONTINUOUS_TRANSFORM_WITHINREAL THEN
    REPLICATE_TAC 2 (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(:real)")) THEN
    REWRITE_TAC [IN_UNIV, WITHINREAL_UNIV])

  let REAL_CONTINUOUS_CONST ← prove
   r"!net c. (\x. c) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_CONST])

  let REAL_CONTINUOUS_LMUL ← prove
   r"!f c net. f real_continuous net ==> (\x. c * f(x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_LMUL])

  let REAL_CONTINUOUS_RMUL ← prove
   r"!f c net. f real_continuous net ==> (\x. f(x) * c) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_RMUL])

  let REAL_CONTINUOUS_NEG ← prove
   r"!f net. f real_continuous net ==> (\x. --(f x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_NEG])

  let REAL_CONTINUOUS_ADD ← prove
   r"!f g net. f real_continuous net /\ g real_continuous net
           ==> (\x. f(x) + g(x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_ADD])

  let REAL_CONTINUOUS_SUB ← prove
   r"!f g net. f real_continuous net /\ g real_continuous net
           ==> (\x. f(x) - g(x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_SUB])

  let REAL_CONTINUOUS_MUL ← prove
   r"!net f g.
     f real_continuous net /\ g real_continuous net
     ==> (\x. f(x) * g(x)) real_continuous net"
   (SIMP_TAC [real_continuous, REALLIM_MUL])

  let REAL_CONTINUOUS_INV ← prove
   r"!net f.
    f real_continuous net /\ ~(f(netlimit net) = &0)
    ==> (\x. inv(f x)) real_continuous net"
   (SIMP_TAC [real_continuous, REALLIM_INV])

  let REAL_CONTINUOUS_DIV ← prove
   r"!net f g.
    f real_continuous net /\ g real_continuous net /\ ~(g(netlimit net) = &0)
    ==> (\x. f(x) / g(x)) real_continuous net"
   (SIMP_TAC [real_continuous, REALLIM_DIV])

  let REAL_CONTINUOUS_POW ← prove
   r"!net f n. f real_continuous net ==> (\x. f(x) pow n) real_continuous net"
   (SIMP_TAC [real_continuous, REALLIM_POW])

  let REAL_CONTINUOUS_ABS ← prove
   r"!net f. f real_continuous net ==> (\x. abs(f(x))) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_ABS])

  let REAL_CONTINUOUS_MAX ← prove
   r"!f g net. f real_continuous net /\ g real_continuous net
           ==> (\x. max (f x) (g x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_MAX])

  let REAL_CONTINUOUS_MIN ← prove
   r"!f g net. f real_continuous net /\ g real_continuous net
           ==> (\x. min (f x) (g x)) real_continuous net"
   (REWRITE_TAC [real_continuous, REALLIM_MIN])

  let REAL_CONTINUOUS_WITHIN_ID ← prove
   r"!x s. (\x. x) real_continuous (atreal x within s)"
   (REWRITE_TAC [real_continuous_withinreal] THEN MESON_TAC [])

  let REAL_CONTINUOUS_AT_ID ← prove
   r"!x. (\x. x) real_continuous (atreal x)"
   (REWRITE_TAC [real_continuous_atreal] THEN MESON_TAC [])

  let REAL_CONTINUOUS_INV_WITHIN ← prove
   r"!f s a. f real_continuous (at a within s) /\ ~(f a = &0)
           ==> (\x. inv(f x)) real_continuous (at a within s)"
   (MESON_TAC [REAL_CONTINUOUS_INV, REAL_CONTINUOUS_TRIVIAL_LIMIT,
               NETLIMIT_WITHIN])

  let REAL_CONTINUOUS_INV_AT ← prove
   r"!f a. f real_continuous (at a) /\ ~(f a = &0)
         ==> (\x. inv(f x)) real_continuous (at a)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_INV_WITHIN])

  let REAL_CONTINUOUS_INV_WITHINREAL ← prove
   r"!f s a. f real_continuous (atreal a within s) /\ ~(f a = &0)
           ==> (\x. inv(f x)) real_continuous (atreal a within s)"
   (MESON_TAC [REAL_CONTINUOUS_INV, REAL_CONTINUOUS_TRIVIAL_LIMIT,
               NETLIMIT_WITHINREAL])

  let REAL_CONTINUOUS_INV_ATREAL ← prove
   r"!f a. f real_continuous (atreal a) /\ ~(f a = &0)
         ==> (\x. inv(f x)) real_continuous (atreal a)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_INV_WITHINREAL])

  let REAL_CONTINUOUS_DIV_WITHIN ← prove
   r"!f s a. f real_continuous (at a within s) /\
           g real_continuous (at a within s) /\ ~(g a = &0)
           ==> (\x. f x / g x) real_continuous (at a within s)"
   (MESON_TAC [REAL_CONTINUOUS_DIV, REAL_CONTINUOUS_TRIVIAL_LIMIT,
               NETLIMIT_WITHIN])

  let REAL_CONTINUOUS_DIV_AT ← prove
   r"!f a. f real_continuous (at a) /\
         g real_continuous (at a) /\ ~(g a = &0)
         ==> (\x. f x / g x) real_continuous (at a)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_DIV_WITHIN])

  let REAL_CONTINUOUS_DIV_WITHINREAL ← prove
   r"!f s a. f real_continuous (atreal a within s) /\
           g real_continuous (atreal a within s) /\ ~(g a = &0)
           ==> (\x. f x / g x) real_continuous (atreal a within s)"
   (MESON_TAC [REAL_CONTINUOUS_DIV, REAL_CONTINUOUS_TRIVIAL_LIMIT,
               NETLIMIT_WITHINREAL])

  let REAL_CONTINUOUS_DIV_ATREAL ← prove
   r"!f a. f real_continuous (atreal a) /\
         g real_continuous (atreal a) /\ ~(g a = &0)
         ==> (\x. f x / g x) real_continuous (atreal a)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_DIV_WITHINREAL])

  pure { real_continuous, REAL_CONTINUOUS_TRIVIAL_LIMIT, REAL_CONTINUOUS_WITHIN,
         REAL_CONTINUOUS_AT, REAL_CONTINUOUS_WITHINREAL, REAL_CONTINUOUS_ATREAL,
         CONTINUOUS_WITHINREAL, CONTINUOUS_ATREAL, real_continuous_within,
         real_continuous_at, real_continuous_withinreal, real_continuous_atreal,
         REAL_CONTINUOUS_AT_WITHIN, REAL_CONTINUOUS_ATREAL_WITHINREAL,
         REAL_CONTINUOUS_WITHINREAL_SUBSET, REAL_CONTINUOUS_WITHIN_SUBSET,
         CONTINUOUS_WITHINREAL_SUBSET, continuous_withinreal, continuous_atreal,
         CONTINUOUS_ATREAL_WITHINREAL, CONTINUOUS_CX_ATREAL, CONTINUOUS_CX_WITHINREAL,
         REAL_CONTINUOUS_TRANSFORM_WITHIN, REAL_CONTINUOUS_TRANSFORM_WITHINREAL,
         REAL_CONTINUOUS_TRANSFORM_AT, REAL_CONTINUOUS_TRANSFORM_ATREAL,
         REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_LMUL, REAL_CONTINUOUS_RMUL,
         REAL_CONTINUOUS_NEG, REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_SUB,
         REAL_CONTINUOUS_MUL, REAL_CONTINUOUS_INV, REAL_CONTINUOUS_DIV,
         REAL_CONTINUOUS_POW, REAL_CONTINUOUS_ABS, REAL_CONTINUOUS_MAX,
         REAL_CONTINUOUS_MIN, REAL_CONTINUOUS_WITHIN_ID, REAL_CONTINUOUS_AT_ID,
         REAL_CONTINUOUS_INV_WITHIN, REAL_CONTINUOUS_INV_AT,
         REAL_CONTINUOUS_INV_WITHINREAL, REAL_CONTINUOUS_INV_ATREAL,
         REAL_CONTINUOUS_DIV_WITHIN, REAL_CONTINUOUS_DIV_AT,
         REAL_CONTINUOUS_DIV_WITHINREAL, REAL_CONTINUOUS_DIV_ATREAL }
/- ------------------------------------------------------------------------- -/
/- Compositions of real and vector functions.                                -/
/- (realanalysis.ml 2138-2299)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZI where
  REAL_CONTINUOUS_WITHINREAL_COMPOSE : thm
  REAL_CONTINUOUS_ATREAL_COMPOSE : thm
  REAL_CONTINUOUS_WITHIN_COMPOSE : thm
  REAL_CONTINUOUS_AT_COMPOSE : thm
  REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE : thm
  REAL_CONTINUOUS_CONTINUOUS_AT_COMPOSE : thm
  REAL_CONTINUOUS_CONTINUOUS_WITHINREAL_COMPOSE : thm
  REAL_CONTINUOUS_CONTINUOUS_ATREAL_COMPOSE : thm
  CONTINUOUS_REAL_CONTINUOUS_WITHINREAL_COMPOSE : thm
  CONTINUOUS_REAL_CONTINUOUS_ATREAL_COMPOSE : thm
  CONTINUOUS_WITHINREAL_COMPOSE : thm
  CONTINUOUS_ATREAL_COMPOSE : thm
  CONTINUOUS_REAL_CONTINUOUS_WITHIN_COMPOSE : thm
  CONTINUOUS_REAL_CONTINUOUS_AT_COMPOSE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZI [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) : ExceptT String IO RZI := do
  -- @@SCOPE BEGIN
  let { WITHINREAL_UNIV, .. } := BRZF
  let { continuous_withinreal, real_continuous_atreal, real_continuous_within,
        real_continuous_withinreal, .. } := BRZH
  let { WITHIN_WITHIN, .. } := D.qmetric
  let { ASM_MESON_TAC, .. } := D.ts.cn.cx.cvx
  let { INTER_UNIV, .. } := D.ts.cn.cx.cvx.core2
  let { IN_IMAGE, MONO_FORALL, .. } := D.ts.cn.cx.cvx.core3
  let { o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { continuous_within, .. } := D.ts.cn.cx.cvx.top5
  let { WITHIN_UNIV, .. } := D.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let REAL_CONTINUOUS_WITHINREAL_COMPOSE ← prove
   r"!f g x s. f real_continuous (atreal x within s) /\
             g real_continuous (atreal (f x) within IMAGE f s)
             ==> (g o f) real_continuous (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_withinreal, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_ATREAL_COMPOSE ← prove
   r"!f g x. f real_continuous (atreal x) /\ g real_continuous (atreal (f x))
           ==> (g o f) real_continuous (atreal x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_atreal, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_WITHIN_COMPOSE ← prove
   r"!f g x s. f real_continuous (at x within s) /\
             g real_continuous (atreal (f x) within IMAGE f s)
             ==> (g o f) real_continuous (at x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_withinreal, real_continuous_within,
                 o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_AT_COMPOSE ← prove
   r"!f g x. f real_continuous (at x) /\
           g real_continuous (atreal (f x) within IMAGE f (:real^N))
           ==> (g o f) real_continuous (at x)"
   (ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_WITHIN_COMPOSE])

  let REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE ← prove
   r"!f g x s. f continuous (at x within s) /\
             g real_continuous (at (f x) within IMAGE f s)
             ==> (g o f) real_continuous (at x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_within, continuous_within, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_CONTINUOUS_AT_COMPOSE ← prove
   r"!f g x. f continuous (at x) /\
           g real_continuous (at (f x) within IMAGE f (:real^N))
           ==> (g o f) real_continuous (at x)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [WITHIN_WITHIN, INTER_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE])

  let REAL_CONTINUOUS_CONTINUOUS_WITHINREAL_COMPOSE ← prove
   r"!f g x s. f continuous (atreal x within s) /\
             g real_continuous (at (f x) within IMAGE f s)
             ==> (g o f) real_continuous (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_within, continuous_withinreal,
                 real_continuous_withinreal, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_CONTINUOUS_ATREAL_COMPOSE ← prove
   r"!f g x. f continuous (atreal x) /\
           g real_continuous (at (f x) within IMAGE f (:real))
           ==> (g o f) real_continuous (atreal x)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS_WITHINREAL_COMPOSE])

  let CONTINUOUS_REAL_CONTINUOUS_WITHINREAL_COMPOSE ← prove
   r"!f g x s. f real_continuous (atreal x within s) /\
             g continuous (atreal (f x) within IMAGE f s)
             ==> (g o f) continuous (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_continuous_within, continuous_withinreal,
                 real_continuous_withinreal, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_REAL_CONTINUOUS_ATREAL_COMPOSE ← prove
   r"!f g x. f real_continuous (atreal x) /\
           g continuous (atreal (f x) within IMAGE f (:real))
           ==> (g o f) continuous (atreal x)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [WITHIN_WITHIN, INTER_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_REAL_CONTINUOUS_WITHINREAL_COMPOSE])

  let CONTINUOUS_WITHINREAL_COMPOSE ← prove
   r"!f g x s. f continuous (atreal x within s) /\
             g continuous (at (f x) within IMAGE f s)
             ==> (g o f) continuous (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_within, continuous_withinreal, o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_ATREAL_COMPOSE ← prove
   r"!f g x. f continuous (atreal x) /\
           g continuous (at (f x) within IMAGE f (:real))
           ==> (g o f) continuous (atreal x)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [WITHIN_WITHIN, INTER_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_WITHINREAL_COMPOSE])

  let CONTINUOUS_REAL_CONTINUOUS_WITHIN_COMPOSE ← prove
   r"!f g x s. f real_continuous (at x within s) /\
             g continuous (atreal (f x) within IMAGE f s)
             ==> (g o f) continuous (at x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_within, real_continuous_within, continuous_withinreal,
                 o_THM, IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_REAL_CONTINUOUS_AT_COMPOSE ← prove
   r"!f g x. f real_continuous (at x) /\
           g continuous (atreal (f x) within IMAGE f (:real^M))
           ==> (g o f) continuous (at x)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [WITHIN_WITHIN, INTER_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_REAL_CONTINUOUS_WITHIN_COMPOSE])

  pure { REAL_CONTINUOUS_WITHINREAL_COMPOSE, REAL_CONTINUOUS_ATREAL_COMPOSE,
         REAL_CONTINUOUS_WITHIN_COMPOSE, REAL_CONTINUOUS_AT_COMPOSE,
         REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE, REAL_CONTINUOUS_CONTINUOUS_AT_COMPOSE,
         REAL_CONTINUOUS_CONTINUOUS_WITHINREAL_COMPOSE,
         REAL_CONTINUOUS_CONTINUOUS_ATREAL_COMPOSE,
         CONTINUOUS_REAL_CONTINUOUS_WITHINREAL_COMPOSE,
         CONTINUOUS_REAL_CONTINUOUS_ATREAL_COMPOSE, CONTINUOUS_WITHINREAL_COMPOSE,
         CONTINUOUS_ATREAL_COMPOSE, CONTINUOUS_REAL_CONTINUOUS_WITHIN_COMPOSE,
         CONTINUOUS_REAL_CONTINUOUS_AT_COMPOSE }
/- ------------------------------------------------------------------------- -/
/- Continuity of a real->real function on a set.                             -/
/- (realanalysis.ml 2300-2556)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZJ where
  real_continuous_on : thm
  REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN : thm
  REAL_CONTINUOUS_ON_SUBSET : thm
  REAL_CONTINUOUS_ON_COMPOSE : thm
  REAL_CONTINUOUS_ON : thm
  REAL_CONTINUOUS_ON_CONST : thm
  REAL_CONTINUOUS_ON_ID : thm
  REAL_CONTINUOUS_ON_LMUL : thm
  REAL_CONTINUOUS_ON_RMUL : thm
  REAL_CONTINUOUS_ON_NEG : thm
  REAL_CONTINUOUS_ON_ADD : thm
  REAL_CONTINUOUS_ON_SUB : thm
  REAL_CONTINUOUS_ON_MUL : thm
  REAL_CONTINUOUS_ON_POW : thm
  REAL_CONTINUOUS_ON_INV : thm
  REAL_CONTINUOUS_ON_DIV : thm
  REAL_CONTINUOUS_ON_ABS : thm
  REAL_CONTINUOUS_ON_MAX : thm
  REAL_CONTINUOUS_ON_MIN : thm
  REAL_CONTINUOUS_ON_EQ : thm
  REAL_CONTINUOUS_ON_UNION : thm
  REAL_CONTINUOUS_ON_UNION_OPEN : thm
  REAL_CONTINUOUS_ON_CASES : thm
  REAL_CONTINUOUS_ON_CASES_OPEN : thm
  REAL_CONTINUOUS_SUM : thm
  REAL_CONTINUOUS_PRODUCT : thm
  REAL_CONTINUOUS_ON_SUM : thm
  REAL_CONTINUOUS_ON_PRODUCT : thm
  REALLIM_CONTINUOUS_FUNCTION : thm
  LIM_REAL_CONTINUOUS_FUNCTION : thm
  REALLIM_REAL_CONTINUOUS_FUNCTION : thm
  REAL_CONTINUOUS_ON_EQ_REAL_CONTINUOUS_AT : thm
  REAL_CONTINUOUS_ATTAINS_SUP : thm
  REAL_CONTINUOUS_ATTAINS_INF : thm
  REAL_CONTINUOUS_AGREE_ON_CLOSURE_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZJ [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZG : RZG) (BRZH : RZH) (BRZI : RZI) : ExceptT String IO RZJ := do
  -- @@SCOPE BEGIN
  let { REAL_CLOSED, real_compact, REAL_OPEN, TENDSTO_REAL, tendsto_real, .. } := BRZA
  let { REALLIM_WITHIN_REAL_OPEN, REALLIM_WITHINREAL_WITHIN, .. } := BRZG
  let { continuous_atreal, REAL_CONTINUOUS_ABS, REAL_CONTINUOUS_ADD, real_continuous_at,
        real_continuous_atreal, REAL_CONTINUOUS_ATREAL, REAL_CONTINUOUS_CONST,
        REAL_CONTINUOUS_DIV_WITHINREAL, REAL_CONTINUOUS_INV_WITHINREAL,
        REAL_CONTINUOUS_LMUL, REAL_CONTINUOUS_MUL, REAL_CONTINUOUS_NEG,
        REAL_CONTINUOUS_POW, REAL_CONTINUOUS_RMUL, REAL_CONTINUOUS_SUB,
        REAL_CONTINUOUS_WITHIN_ID, real_continuous_withinreal, REAL_CONTINUOUS_WITHINREAL,
        .. } := BRZH
  let { REAL_CONTINUOUS_WITHINREAL_COMPOSE, .. } := BRZI
  let { eventually, .. } := D.qmetric
  let { CONTINUOUS_AGREE_ON_CLOSURE, CONTINUOUS_ON_UNION, CONTINUOUS_ON_UNION_OPEN,
        IMAGE_DROP_INTERVAL, IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { PRODUCT_CLAUSES, .. } := D.ts.cn.cx.cpx
  let { ETA_AX, EXISTS_IN_IMAGE, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMAGE_UNION, IMP_CONJ,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_IMAGE, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_NOT_LT, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_DROP, LIFT_DROP, LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { CLOSURE_INTERVAL, CONTINUOUS_ATTAINS_INF, CONTINUOUS_ATTAINS_SUP,
        .. } := D.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { INTERVAL_EQ_EMPTY_1, .. } := D.ts.cn.cx.cvx.top4
  let { CONTINUOUS_ON_VSUM, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { tendsto, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  parse_as_infix ("real_continuous_on", (12, "right"))

  let real_continuous_on ← new_definition
    r"f real_continuous_on s <=>
        !x. x IN s ==> !e. &0 < e
                           ==> ?d. &0 < d /\
                                   !x'. x' IN s /\ abs(x' - x) < d
                                        ==> abs(f(x') - f(x)) < e"

  let REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN ← prove
   r"!f s. f real_continuous_on s <=>
              !x. x IN s ==> f real_continuous (atreal x within s)"
   (REWRITE_TAC [real_continuous_on, real_continuous_withinreal])

  let REAL_CONTINUOUS_ON_SUBSET ← prove
   r"!f s t. f real_continuous_on s /\ t SUBSET s ==> f real_continuous_on t"
   (REWRITE_TAC [real_continuous_on, SUBSET] THEN MESON_TAC [])

  let REAL_CONTINUOUS_ON_COMPOSE ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on (IMAGE f s)
           ==> (g o f) real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    MESON_TAC [IN_IMAGE, REAL_CONTINUOUS_WITHINREAL_COMPOSE])

  let REAL_CONTINUOUS_ON ← prove
   r"!f s. f real_continuous_on s <=>
          (lift o f o drop) continuous_on (IMAGE lift s)"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHINREAL, CONTINUOUS_WITHIN,
                 FORALL_IN_IMAGE, REALLIM_WITHINREAL_WITHIN, TENDSTO_REAL] THEN
    REWRITE_TAC [o_THM, LIFT_DROP])

  let REAL_CONTINUOUS_ON_CONST ← prove
   r"!s c. (\x. c) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_CONST])

  let REAL_CONTINUOUS_ON_ID ← prove
   r"!s. (\x. x) real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHIN_ID])

  let REAL_CONTINUOUS_ON_LMUL ← prove
   r"!f c s. f real_continuous_on s ==> (\x. c * f(x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_LMUL])

  let REAL_CONTINUOUS_ON_RMUL ← prove
   r"!f c s. f real_continuous_on s ==> (\x. f(x) * c) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_RMUL])

  let REAL_CONTINUOUS_ON_NEG ← prove
   r"!f s. f real_continuous_on s
         ==> (\x. --(f x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_NEG])

  let REAL_CONTINUOUS_ON_ADD ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on s
           ==> (\x. f(x) + g(x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_ADD])

  let REAL_CONTINUOUS_ON_SUB ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on s
           ==> (\x. f(x) - g(x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_SUB])

  let REAL_CONTINUOUS_ON_MUL ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on s
           ==> (\x. f(x) * g(x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_MUL])

  let REAL_CONTINUOUS_ON_POW ← prove
   r"!f n s. f real_continuous_on s
           ==> (\x. f(x) pow n) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_POW])

  let REAL_CONTINUOUS_ON_INV ← prove
   r"!f s. f real_continuous_on s /\  (!x. x IN s ==> ~(f x = &0))
         ==> (\x. inv(f x)) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              REAL_CONTINUOUS_INV_WITHINREAL])

  let REAL_CONTINUOUS_ON_DIV ← prove
   r"!f g s.
        f real_continuous_on s /\
        g real_continuous_on s /\
        (!x. x IN s ==> ~(g x = &0))
        ==> (\x. f x / g x) real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              REAL_CONTINUOUS_DIV_WITHINREAL])

  let REAL_CONTINUOUS_ON_ABS ← prove
   r"!f s. f real_continuous_on s ==> (\x. abs(f x)) real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    SIMP_TAC [REAL_CONTINUOUS_ABS])

  let REAL_CONTINUOUS_ON_MAX ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on s
           ==> (\x. max (f x) (g x)) real_continuous_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"max a b = inv(&2) * (a + b + abs(b - a))")] THEN
    MATCH_MP_TAC REAL_CONTINUOUS_ON_LMUL THEN
    REPEAT (MATCH_MP_TAC REAL_CONTINUOUS_ON_ADD THEN ASM_REWRITE_TAC []) THEN
    MATCH_MP_TAC REAL_CONTINUOUS_ON_ABS THEN
    MATCH_MP_TAC REAL_CONTINUOUS_ON_SUB THEN ASM_REWRITE_TAC [])

  let REAL_CONTINUOUS_ON_MIN ← prove
   r"!f g s. f real_continuous_on s /\ g real_continuous_on s
           ==> (\x. min (f x) (g x)) real_continuous_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"min a b = --(max (--a) (--b))")] THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_ON_MAX, REAL_CONTINUOUS_ON_NEG])

  let REAL_CONTINUOUS_ON_EQ ← prove
   r"!f g s. (!x. x IN s ==> f(x) = g(x)) /\ f real_continuous_on s
           ==> g real_continuous_on s"
   (SIMP_TAC [real_continuous_on, IMP_CONJ])

  let REAL_CONTINUOUS_ON_UNION ← prove
   r"!f s t.
         real_closed s /\ real_closed t /\
         f real_continuous_on s /\ f real_continuous_on t
         ==> f real_continuous_on (s UNION t)"
   (REWRITE_TAC [REAL_CLOSED, REAL_CONTINUOUS_ON, IMAGE_UNION,
                 CONTINUOUS_ON_UNION])

  let REAL_CONTINUOUS_ON_UNION_OPEN ← prove
   r"!f s t.
         real_open s /\ real_open t /\
         f real_continuous_on s /\ f real_continuous_on t
         ==> f real_continuous_on (s UNION t)"
   (REWRITE_TAC [REAL_OPEN, REAL_CONTINUOUS_ON, IMAGE_UNION,
                 CONTINUOUS_ON_UNION_OPEN])

  let REAL_CONTINUOUS_ON_CASES ← prove
   r"!P f g s t.
        real_closed s /\ real_closed t /\
        f real_continuous_on s /\ g real_continuous_on t /\
        (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
        ==> (\x. if P x then f x else g x) real_continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ON_UNION THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"f:real->real"), EXISTS_TAC (← q r"g:real->real")] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let REAL_CONTINUOUS_ON_CASES_OPEN ← prove
   r"!P f g s t.
        real_open s /\ real_open t /\
        f real_continuous_on s /\ g real_continuous_on t /\
        (!x. x IN s /\ ~P x \/ x IN t /\ P x ==> f x = g x)
        ==> (\x. if P x then f x else g x) real_continuous_on (s UNION t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ON_UNION_OPEN THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"f:real->real"), EXISTS_TAC (← q r"g:real->real")] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let REAL_CONTINUOUS_SUM ← prove
   r"!net f s.
     FINITE s /\ (!a. a IN s ==> f a real_continuous net)
     ==> (\x. sum s (\a. f a x)) real_continuous net"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, SUM_CLAUSES,
              REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_ADD, ETA_AX])

  let REAL_CONTINUOUS_PRODUCT ← prove
   r"!net f s.
     FINITE s /\ (!a. a IN s ==> f a real_continuous net)
     ==> (\x. product s (\a. f a x)) real_continuous net"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, PRODUCT_CLAUSES,
              REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_MUL, ETA_AX])

  let REAL_CONTINUOUS_ON_SUM ← prove
   r"!t f s.
         FINITE s /\ (!a. a IN s ==> f a real_continuous_on t)
         ==> (\x. sum s (\a. f a x)) real_continuous_on t"
   (REPEAT GEN_TAC THEN SIMP_TAC [REAL_CONTINUOUS_ON, o_DEF, LIFT_SUM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_VSUM) THEN
    REWRITE_TAC [])

  let REAL_CONTINUOUS_ON_PRODUCT ← prove
   r"!t f s.
         FINITE s /\ (!a. a IN s ==> f a real_continuous_on t)
         ==> (\x. product s (\a. f a x)) real_continuous_on t"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, PRODUCT_CLAUSES,
              REAL_CONTINUOUS_ON_CONST, REAL_CONTINUOUS_ON_MUL, ETA_AX])

  let REALLIM_CONTINUOUS_FUNCTION ← prove
   r"!f net g l.
        f continuous (atreal l) /\ (g ---> l) net
        ==> ((\x. f(g x)) --> f l) net"
   (REWRITE_TAC [tendsto_real, tendsto, continuous_atreal, eventually] THEN
    MESON_TAC [])

  let LIM_REAL_CONTINUOUS_FUNCTION ← prove
   r"!f net g l.
        f real_continuous (at l) /\ (g --> l) net
        ==> ((\x. f(g x)) ---> f l) net"
   (REWRITE_TAC [tendsto_real, tendsto, real_continuous_at, eventually] THEN
    MESON_TAC [])

  let REALLIM_REAL_CONTINUOUS_FUNCTION ← prove
   r"!f net g l.
        f real_continuous (atreal l) /\ (g ---> l) net
        ==> ((\x. f(g x)) ---> f l) net"
   (REWRITE_TAC [tendsto_real, real_continuous_atreal, eventually] THEN
    MESON_TAC [])

  let REAL_CONTINUOUS_ON_EQ_REAL_CONTINUOUS_AT ← prove
   r"!f s. real_open s
         ==> (f real_continuous_on s <=>
              !x. x IN s ==> f real_continuous atreal x)"
   (SIMP_TAC [REAL_CONTINUOUS_ATREAL, REAL_CONTINUOUS_WITHINREAL,
         REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REALLIM_WITHIN_REAL_OPEN])

  let REAL_CONTINUOUS_ATTAINS_SUP ← prove
   r"!f s. real_compact s /\ ~(s = {}) /\ f real_continuous_on s
         ==> ?x. x IN s /\ (!y. y IN s ==> f y <= f x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(f:real->real) o drop", ← q r"IMAGE lift s"]
          CONTINUOUS_ATTAINS_SUP) THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, ← GSYM real_compact] THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, EXISTS_IN_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM, LIFT_DROP])

  let REAL_CONTINUOUS_ATTAINS_INF ← prove
   r"!f s. real_compact s /\ ~(s = {}) /\ f real_continuous_on s
         ==> ?x. x IN s /\ (!y. y IN s ==> f x <= f y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(f:real->real) o drop", ← q r"IMAGE lift s"]
          CONTINUOUS_ATTAINS_INF) THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, ← GSYM real_compact] THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, EXISTS_IN_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM, LIFT_DROP])

  let REAL_CONTINUOUS_AGREE_ON_CLOSURE_INTERVAL ← prove
   r"!g h a b.
        a < b /\
        g real_continuous_on real_interval[a,b] /\
        h real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) ==> g x = h x)
        ==> (!x. x IN real_interval[a,b] ==> g x = h x)"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IMAGE_DROP_INTERVAL] THEN
    REWRITE_TAC [← GSYM FORALL_DROP, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [LIFT_DROP, ← GSYM LIFT_EQ, o_DEF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MP_TAC (← ISPECL [← q r"a:real^1", ← q r"b:real^1"] (← CONJUNCT2 CLOSURE_INTERVAL)) THEN
    ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, ← GSYM REAL_NOT_LT] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [CONTINUOUS_AGREE_ON_CLOSURE])

  pure { real_continuous_on, REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
         REAL_CONTINUOUS_ON_SUBSET, REAL_CONTINUOUS_ON_COMPOSE, REAL_CONTINUOUS_ON,
         REAL_CONTINUOUS_ON_CONST, REAL_CONTINUOUS_ON_ID, REAL_CONTINUOUS_ON_LMUL,
         REAL_CONTINUOUS_ON_RMUL, REAL_CONTINUOUS_ON_NEG, REAL_CONTINUOUS_ON_ADD,
         REAL_CONTINUOUS_ON_SUB, REAL_CONTINUOUS_ON_MUL, REAL_CONTINUOUS_ON_POW,
         REAL_CONTINUOUS_ON_INV, REAL_CONTINUOUS_ON_DIV, REAL_CONTINUOUS_ON_ABS,
         REAL_CONTINUOUS_ON_MAX, REAL_CONTINUOUS_ON_MIN, REAL_CONTINUOUS_ON_EQ,
         REAL_CONTINUOUS_ON_UNION, REAL_CONTINUOUS_ON_UNION_OPEN,
         REAL_CONTINUOUS_ON_CASES, REAL_CONTINUOUS_ON_CASES_OPEN, REAL_CONTINUOUS_SUM,
         REAL_CONTINUOUS_PRODUCT, REAL_CONTINUOUS_ON_SUM, REAL_CONTINUOUS_ON_PRODUCT,
         REALLIM_CONTINUOUS_FUNCTION, LIM_REAL_CONTINUOUS_FUNCTION,
         REALLIM_REAL_CONTINUOUS_FUNCTION, REAL_CONTINUOUS_ON_EQ_REAL_CONTINUOUS_AT,
         REAL_CONTINUOUS_ATTAINS_SUP, REAL_CONTINUOUS_ATTAINS_INF,
         REAL_CONTINUOUS_AGREE_ON_CLOSURE_INTERVAL }
/- ------------------------------------------------------------------------- -/
/- Real version of uniform continuity; continuity versus componentwise      -/
/- continuity; derivative of real->real function; basic limit definitions.  -/
/- (realanalysis.ml 2557-2784)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZK where
  real_uniformly_continuous_on : thm
  REAL_UNIFORMLY_CONTINUOUS_ON : thm
  REAL_UNIFORMLY_CONTINUOUS_IMP_REAL_CONTINUOUS : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_SUBSET : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_COMPOSE : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_CONST : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_LMUL : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_RMUL : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_ID : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_NEG : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_ADD : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_SUB : thm
  REAL_UNIFORMLY_CONTINUOUS_ON_SUM : thm
  REAL_COMPACT_UNIFORMLY_CONTINUOUS : thm
  REAL_COMPACT_CONTINUOUS_IMAGE : thm
  REAL_DINI : thm
  CONTINUOUS_COMPONENTWISE : thm
  REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT : thm
  REAL_CONTINUOUS_COMPLEX_COMPONENTS_WITHIN : thm
  REAL_CONTINUOUS_NORM_AT : thm
  REAL_CONTINUOUS_NORM_WITHIN : thm
  REAL_CONTINUOUS_DIST_AT : thm
  REAL_CONTINUOUS_DIST_WITHIN : thm
  has_real_derivative : thm
  real_differentiable : thm
  real_derivative : thm
  higher_real_derivative : thm
  real_differentiable_on : thm
  HAS_REAL_DERIVATIVE_WITHINREAL : thm
  HAS_REAL_DERIVATIVE_ATREAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZK [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZF : RZF) (BRZH : RZH) (BRZJ : RZJ) : ExceptT String IO RZK := do
  -- @@SCOPE BEGIN
  let { real_compact, REAL_TENDSTO, REALLIM_CONST, REALLIM_NULL, REALLIM_TRIVIAL,
        .. } := BRZA
  let { LIM_COMPONENTWISE, .. } := BRZB
  let { NETLIMIT_WITHINREAL, REALLIM_WITHINREAL, WITHINREAL_UNIV, .. } := BRZF
  let { real_continuous, real_continuous_at, REAL_CONTINUOUS_AT_WITHIN, .. } := BRZH
  let { real_continuous_on, REAL_CONTINUOUS_ON, .. } := BRZJ
  let { FORALL_LIFT_FUN, .. } := D.qvectors
  let { DINI, UNIFORMLY_CONTINUOUS_ON_ADD, UNIFORMLY_CONTINUOUS_ON_CMUL,
        UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, UNIFORMLY_CONTINUOUS_ON_SUB,
        UNIFORMLY_CONTINUOUS_ON_VSUM, .. } := D.qtopology
  let { define, .. } := D.ts.cn.cx
  let { IM_DEF, RE_DEF, .. } := D.ts.cn.cxa
  let { continuous, UNIFORMLY_CONTINUOUS_ON_COMPOSE, .. } := D.ts.cn.qtopology
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { MESON_TAC, new_definition, NORM_ARITH_TAC, parse_as_infix, REAL_ARITH, REAL_FIELD,
        .. } := D.ts.cn.cx.cvx
  let { FORALL_2, .. } := D.ts.cn.cx.cpx
  let { DIMINDEX_2, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { REAL_MUL_SYM, REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_SUB, DROP_VEC, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_SUB,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { COMPACT_CONTINUOUS_IMAGE, CONTINUOUS_AT_ID, .. } := D.ts.cn.cx.cvx.top2
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  parse_as_infix ("real_uniformly_continuous_on", (12, "right"))

  let real_uniformly_continuous_on ← new_definition
    r"f real_uniformly_continuous_on s <=>
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x x'. x IN s /\ x' IN s /\ abs(x' - x) < d
                           ==> abs(f x' - f x) < e"

  let REAL_UNIFORMLY_CONTINUOUS_ON ← prove
   r"!f s. f real_uniformly_continuous_on s <=>
          (lift o f o drop) uniformly_continuous_on (IMAGE lift s)"
   (REWRITE_TAC [real_uniformly_continuous_on, uniformly_continuous_on] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM, DIST_LIFT, LIFT_DROP])

  let REAL_UNIFORMLY_CONTINUOUS_IMP_REAL_CONTINUOUS ← prove
   r"!f s. f real_uniformly_continuous_on s ==> f real_continuous_on s"
   (REWRITE_TAC [real_uniformly_continuous_on, real_continuous_on] THEN
    MESON_TAC [])

  let REAL_UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY ← prove
   r"!f s. f real_uniformly_continuous_on s <=>
                !x y. (!n. x(n) IN s) /\ (!n. y(n) IN s) /\
                      ((\n. x(n) - y(n)) ---> &0) sequentially
                      ==> ((\n. f(x(n)) - f(y(n))) ---> &0) sequentially"
   (REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, REAL_TENDSTO] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IN_IMAGE_LIFT_DROP, DROP_SUB, DROP_VEC] THEN
    REWRITE_TAC [FORALL_LIFT_FUN, o_THM, LIFT_DROP])

  let REAL_UNIFORMLY_CONTINUOUS_ON_SUBSET ← prove
   r"!f s t. f real_uniformly_continuous_on s /\ t SUBSET s
           ==> f real_uniformly_continuous_on t"
   (REWRITE_TAC [real_uniformly_continuous_on, SUBSET] THEN MESON_TAC [])

  let REAL_UNIFORMLY_CONTINUOUS_ON_COMPOSE ← prove
   r"!f g s. f real_uniformly_continuous_on s /\
           g real_uniformly_continuous_on (IMAGE f s)
           ==> (g o f) real_uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON] THEN
    SUBGOAL_THEN
     (← q r"IMAGE lift (IMAGE f s) = IMAGE (lift o f o drop) (IMAGE lift s)")
    SUBST1_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o MATCH_MP UNIFORMLY_CONTINUOUS_ON_COMPOSE)] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP])

  let REAL_UNIFORMLY_CONTINUOUS_ON_CONST ← prove
   r"!s c. (\x. c) real_uniformly_continuous_on s"
   (REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, o_DEF,
                 REAL_SUB_REFL, REALLIM_CONST])

  let REAL_UNIFORMLY_CONTINUOUS_ON_LMUL ← prove
   r"!f c s. f real_uniformly_continuous_on s
           ==> (\x. c * f(x)) real_uniformly_continuous_on s"
   (REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON] THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, UNIFORMLY_CONTINUOUS_ON_CMUL])

  let REAL_UNIFORMLY_CONTINUOUS_ON_RMUL ← prove
   r"!f c s. f real_uniformly_continuous_on s
           ==> (\x. f(x) * c) real_uniformly_continuous_on s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON_LMUL])

  let REAL_UNIFORMLY_CONTINUOUS_ON_ID ← prove
   r"!s. (\x. x) real_uniformly_continuous_on s"
   (REWRITE_TAC [real_uniformly_continuous_on] THEN MESON_TAC [])

  let REAL_UNIFORMLY_CONTINUOUS_ON_NEG ← prove
   r"!f s. f real_uniformly_continuous_on s
         ==> (\x. --(f x)) real_uniformly_continuous_on s"
   (ONCE_REWRITE_TAC [← REAL_ARITH (← q r"--x = -- &1 * x")] THEN
    REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON_LMUL])

  let REAL_UNIFORMLY_CONTINUOUS_ON_ADD ← prove
   r"!f g s. f real_uniformly_continuous_on s /\
           g real_uniformly_continuous_on s
           ==> (\x. f(x) + g(x)) real_uniformly_continuous_on s"
   (REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON, o_DEF, LIFT_ADD] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_ADD])

  let REAL_UNIFORMLY_CONTINUOUS_ON_SUB ← prove
   r"!f g s. f real_uniformly_continuous_on s /\
           g real_uniformly_continuous_on s
           ==> (\x. f(x) - g(x)) real_uniformly_continuous_on s"
   (REWRITE_TAC [REAL_UNIFORMLY_CONTINUOUS_ON, o_DEF, LIFT_SUB] THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_ON_SUB])

  let REAL_UNIFORMLY_CONTINUOUS_ON_SUM ← prove
   r"!t f s.
         FINITE s /\ (!a. a IN s ==> f a real_uniformly_continuous_on t)
         ==> (\x. sum s (\a. f a x)) real_uniformly_continuous_on t"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [REAL_UNIFORMLY_CONTINUOUS_ON, o_DEF, LIFT_SUM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP UNIFORMLY_CONTINUOUS_ON_VSUM) THEN
    REWRITE_TAC [])

  let REAL_COMPACT_UNIFORMLY_CONTINUOUS ← prove
   r"!f s. f real_continuous_on s /\ real_compact s
         ==> f real_uniformly_continuous_on s"
   (REWRITE_TAC [real_compact, REAL_CONTINUOUS_ON, REAL_UNIFORMLY_CONTINUOUS_ON,
                 COMPACT_UNIFORMLY_CONTINUOUS])

  let REAL_COMPACT_CONTINUOUS_IMAGE ← prove
   r"!f s. f real_continuous_on s /\ real_compact s
         ==> real_compact (IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_compact, REAL_CONTINUOUS_ON] THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_CONTINUOUS_IMAGE) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP])

  let REAL_DINI ← prove
   r"!f g s.
        real_compact s /\ (!n. (f n) real_continuous_on s) /\
        g real_continuous_on s /\
        (!x. x IN s ==> ((\n. (f n x)) ---> g x) sequentially) /\
        (!n x. x IN s ==> f n x <= f (n + 1) x)
        ==> !e. &0 < e
                ==> eventually (\n. !x. x IN s ==> abs(f n x - g x) < e)
                               sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n:num. lift o f n o drop", ← q r"lift o g o drop",
                      ← q r"IMAGE lift s"] DINI) THEN
    ASM_REWRITE_TAC [← GSYM real_compact, ← GSYM REAL_CONTINUOUS_ON] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_DEF, LIFT_DROP, REAL_TENDSTO] THEN
    ASM_SIMP_TAC [← GSYM LIFT_SUB, NORM_LIFT])

  let CONTINUOUS_COMPONENTWISE ← prove
   r"!net f:A->real^N.
        f continuous net <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. (f x)$i) real_continuous net"
   (REWRITE_TAC [real_continuous, continuous, LIM_COMPONENTWISE])

  let REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT ← prove
   r"!z. Re real_continuous (at z) /\ Im real_continuous (at z)"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"at(z:complex)", ← q r"\z:complex. z"] CONTINUOUS_COMPONENTWISE) THEN
    REWRITE_TAC [CONTINUOUS_AT_ID, DIMINDEX_2, FORALL_2] THEN
    REWRITE_TAC [← GSYM RE_DEF, ← GSYM IM_DEF, ETA_AX])

  let REAL_CONTINUOUS_COMPLEX_COMPONENTS_WITHIN ← prove
   r"!s z. Re real_continuous (at z within s) /\
         Im real_continuous (at z within s)"
   (MESON_TAC [REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT,
               REAL_CONTINUOUS_AT_WITHIN])

  let REAL_CONTINUOUS_NORM_AT ← prove
   r"!z. norm real_continuous (at z)"
   (REWRITE_TAC [real_continuous_at, dist] THEN
    GEN_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let REAL_CONTINUOUS_NORM_WITHIN ← prove
   r"!s z. norm real_continuous (at z within s)"
   (MESON_TAC [REAL_CONTINUOUS_NORM_AT, REAL_CONTINUOUS_AT_WITHIN])

  let REAL_CONTINUOUS_DIST_AT ← prove
   r"!a z. (\x. dist(a,x)) real_continuous (at z)"
   (REWRITE_TAC [real_continuous_at, dist] THEN
    GEN_TAC THEN GEN_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let REAL_CONTINUOUS_DIST_WITHIN ← prove
   r"!a s z. (\x. dist(a,x)) real_continuous (at z within s)"
   (MESON_TAC [REAL_CONTINUOUS_DIST_AT, REAL_CONTINUOUS_AT_WITHIN])

  parse_as_infix ("has_real_derivative", (12, "right"))
  parse_as_infix ("real_differentiable", (12, "right"))
  parse_as_infix ("real_differentiable_on", (12, "right"))

  let has_real_derivative ← new_definition
   r"(f has_real_derivative f') net <=>
        ((\x. inv(x - netlimit net) *
              (f x - (f(netlimit net) + f' * (x - netlimit net))))
         ---> &0) net"

  let real_differentiable ← new_definition
   r"f real_differentiable net <=> ?f'. (f has_real_derivative f') net"

  let real_derivative ← new_definition
   r"real_derivative f x = @f'. (f has_real_derivative f') (atreal x)"

  let higher_real_derivative ← define
   r"higher_real_derivative 0 f = f /\
  (!n. higher_real_derivative (SUC n) f =
                real_derivative (higher_real_derivative n f))"

  let real_differentiable_on ← new_definition
   r"f real_differentiable_on s <=>
     !x. x IN s ==> ?f'. (f has_real_derivative f') (atreal x within s)"

  let HAS_REAL_DERIVATIVE_WITHINREAL ← prove
   r"(f has_real_derivative f') (atreal a within s) <=>
           ((\x. (f x - f a) / (x - a)) ---> f') (atreal a within s)"
   (REWRITE_TAC [has_real_derivative] THEN
    ASM_CASES_TAC (← q r"trivial_limit(atreal a within s)") THEN
    ASM_SIMP_TAC [REALLIM_TRIVIAL, NETLIMIT_WITHINREAL] THEN
    ASM_SIMP_TAC [NETLIMIT_WITHINREAL] THEN
    GEN_REWRITE_TAC RAND_CONV [REALLIM_NULL] THEN
    REWRITE_TAC [REALLIM_WITHINREAL, REAL_SUB_RZERO] THEN
    SIMP_TAC [← REAL_FIELD
     (← q r"&0 < abs(x - a) ==> (fy - fa) / (x - a) - f' =
                          inv(x - a) * (fy - (fa + f' * (x - a)))")])

  let HAS_REAL_DERIVATIVE_ATREAL ← prove
   r"(f has_real_derivative f') (atreal a) <=>
           ((\x. (f x - f a) / (x - a)) ---> f') (atreal a)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_WITHINREAL])

  pure { real_uniformly_continuous_on, REAL_UNIFORMLY_CONTINUOUS_ON,
         REAL_UNIFORMLY_CONTINUOUS_IMP_REAL_CONTINUOUS,
         REAL_UNIFORMLY_CONTINUOUS_ON_SEQUENTIALLY, REAL_UNIFORMLY_CONTINUOUS_ON_SUBSET,
         REAL_UNIFORMLY_CONTINUOUS_ON_COMPOSE, REAL_UNIFORMLY_CONTINUOUS_ON_CONST,
         REAL_UNIFORMLY_CONTINUOUS_ON_LMUL, REAL_UNIFORMLY_CONTINUOUS_ON_RMUL,
         REAL_UNIFORMLY_CONTINUOUS_ON_ID, REAL_UNIFORMLY_CONTINUOUS_ON_NEG,
         REAL_UNIFORMLY_CONTINUOUS_ON_ADD, REAL_UNIFORMLY_CONTINUOUS_ON_SUB,
         REAL_UNIFORMLY_CONTINUOUS_ON_SUM, REAL_COMPACT_UNIFORMLY_CONTINUOUS,
         REAL_COMPACT_CONTINUOUS_IMAGE, REAL_DINI, CONTINUOUS_COMPONENTWISE,
         REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT, REAL_CONTINUOUS_COMPLEX_COMPONENTS_WITHIN,
         REAL_CONTINUOUS_NORM_AT, REAL_CONTINUOUS_NORM_WITHIN, REAL_CONTINUOUS_DIST_AT,
         REAL_CONTINUOUS_DIST_WITHIN, has_real_derivative, real_differentiable,
         real_derivative, higher_real_derivative, real_differentiable_on,
         HAS_REAL_DERIVATIVE_WITHINREAL, HAS_REAL_DERIVATIVE_ATREAL }
/- ------------------------------------------------------------------------- -/
/- Relation to Frechet derivative; relation to complex derivative;          -/
/- Caratheodory characterization.                                           -/
/- (realanalysis.ml 2785-3031)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZL where
  HAS_REAL_FRECHET_DERIVATIVE_WITHIN : thm
  HAS_REAL_FRECHET_DERIVATIVE_AT : thm
  HAS_REAL_VECTOR_DERIVATIVE_WITHIN : thm
  HAS_REAL_VECTOR_DERIVATIVE_AT : thm
  REAL_DIFFERENTIABLE_AT : thm
  REAL_DIFFERENTIABLE_WITHIN : thm
  REAL_DIFFERENTIABLE_ON : thm
  HAS_REAL_COMPLEX_DERIVATIVE_WITHIN : thm
  HAS_REAL_COMPLEX_DERIVATIVE_AT : thm
  REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE : thm
  REAL_DIFFERENTIABLE_ON_REAL_OPEN : thm
  REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_WITHIN : thm
  REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_ATREAL : thm
  HAS_COMPLEX_REAL_DERIVATIVE_WITHIN_GEN : thm
  HAS_COMPLEX_REAL_DERIVATIVE_AT_GEN : thm
  HAS_COMPLEX_REAL_DERIVATIVE_WITHIN : thm
  HAS_COMPLEX_REAL_DERIVATIVE_AT : thm
  HAS_REAL_DERIVATIVE_FROM_COMPLEX_AT : thm
  REAL_DIFFERENTIABLE_FROM_COMPLEX_AT : thm
  HAS_REAL_DERIVATIVE_CARATHEODORY_ATREAL : thm
  HAS_REAL_DERIVATIVE_CARATHEODORY_WITHINREAL : thm
  REAL_DIFFERENTIABLE_CARATHEODORY_ATREAL : thm
  REAL_DIFFERENTIABLE_CARATHEODORY_WITHINREAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZL [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZF : RZF) (BRZG : RZG) (BRZH : RZH) (BRZK : RZK) : ExceptT String IO RZL := do
  -- @@SCOPE BEGIN
  let { REALLIM_CONST, REALLIM_TRANSFORM, .. } := BRZA
  let { REALLIM_WITHINREAL, WITHINREAL_UNIV, .. } := BRZF
  let { REALLIM_WITHIN_REAL_OPEN, .. } := BRZG
  let { REAL_CONTINUOUS_ATREAL, REAL_CONTINUOUS_WITHINREAL, .. } := BRZH
  let { HAS_REAL_DERIVATIVE_ATREAL, HAS_REAL_DERIVATIVE_WITHINREAL, real_differentiable,
        real_differentiable_on, .. } := BRZK
  let { TRIVIAL_LIMIT_WITHIN_REAL, .. } := D.ts.kna
  let { complex_differentiable, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN, .. } := D.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_WITHIN, .. } := D.ts.knf
  let { REAL_LIM, .. } := D.ts.knm
  let { COMPLEX_NORM_CX, CX_DIV, CX_SUB, RE_CX, .. } := D.ts.cn.cxc
  let { FORALL_REAL, REAL, REAL_CX, REAL_DIV, REAL_SUB, .. } := D.ts.cn.cxi
  let { has_derivative_within, .. } := D.ts.cn.ms.qderivatives
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_FIELD, REAL_RING, SET_RULE, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { differentiable, differentiable_on, has_derivative, has_vector_derivative,
        .. } := D.ts.cn.ms.ig.qderivatives
  let { LINEAR_1, .. } := D.ts.cn.ms.ig.qvec
  let { COND_RAND, COND_RATOR, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IN,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_AND_EXISTS_THM, REAL_ABS_INV, REAL_ABS_MUL,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_IMP_NZ, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_SYM, REAL_SUB_REFL,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SWAP_EXISTS_THM, UNWIND_THM2, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { FORALL_LIFT, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_SUB, LINEAR_SCALING,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { LIM_WITHIN, .. } := D.ts.cn.cx.cvx.top4
  let { REAL_ABS_ABS, .. } := D.ts.cn.ms.ig.dv.qsession
  let { WITHIN_UNIV, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { LINEAR_COMPOSE_CMUL, .. } := D.ts.cn.ms.ig.dv.qvec
  let { LINEAR_ID, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let HAS_REAL_FRECHET_DERIVATIVE_WITHIN ← prove
   r"(f has_real_derivative f') (atreal x within s) <=>
        ((lift o f o drop) has_derivative (\x. f' % x))
        (at (lift x) within (IMAGE lift s))"
   (REWRITE_TAC [has_derivative_within, HAS_REAL_DERIVATIVE_WITHINREAL] THEN
    REWRITE_TAC [o_THM, LIFT_DROP, LIM_WITHIN, REALLIM_WITHINREAL] THEN
    SIMP_TAC [LINEAR_COMPOSE_CMUL, LINEAR_ID, IMP_CONJ] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, DIST_LIFT, ← GSYM LIFT_SUB, LIFT_DROP,
      ← NORM_ARITH (← q r"dist(x,vec 0) = norm x"), ← GSYM LIFT_CMUL, ← GSYM LIFT_ADD,
      NORM_LIFT] THEN
    SIMP_TAC [← REAL_FIELD
     (← q r"&0 < abs(y - x)
      ==> fy - (fx + f' * (y - x)) = (y - x) * ((fy - fx) / (y - x) - f')")] THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_MUL_ASSOC, REAL_ABS_INV, REAL_ABS_ABS] THEN
    SIMP_TAC [REAL_LT_IMP_NZ, REAL_MUL_LINV, REAL_MUL_LID])

  let HAS_REAL_FRECHET_DERIVATIVE_AT ← prove
   r"(f has_real_derivative f') (atreal x) <=>
        ((lift o f o drop) has_derivative (\x. f' % x)) (at (lift x))"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV, ← GSYM WITHIN_UNIV] THEN
    REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [IMAGE_LIFT_UNIV])

  let HAS_REAL_VECTOR_DERIVATIVE_WITHIN ← prove
   r"(f has_real_derivative f') (atreal x within s) <=>
        ((lift o f o drop) has_vector_derivative (lift f'))
        (at (lift x) within (IMAGE lift s))"
   (REWRITE_TAC [has_vector_derivative, HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, FORALL_LIFT, ← GSYM LIFT_CMUL] THEN
    REWRITE_TAC [LIFT_DROP, LIFT_EQ, REAL_MUL_SYM])

  let HAS_REAL_VECTOR_DERIVATIVE_AT ← prove
   r"(f has_real_derivative f') (atreal x) <=>
        ((lift o f o drop) has_vector_derivative (lift f')) (at (lift x))"
   (REWRITE_TAC [has_vector_derivative, HAS_REAL_FRECHET_DERIVATIVE_AT] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, FORALL_LIFT, ← GSYM LIFT_CMUL] THEN
    REWRITE_TAC [LIFT_DROP, LIFT_EQ, REAL_MUL_SYM])

  let REAL_DIFFERENTIABLE_AT ← prove
   r"!f x. f real_differentiable (atreal x) <=>
         (lift o f o drop) differentiable (at(lift x))"
   (REWRITE_TAC [real_differentiable, HAS_REAL_FRECHET_DERIVATIVE_AT] THEN
    REWRITE_TAC [differentiable, has_derivative, LINEAR_SCALING] THEN
    REWRITE_TAC [LINEAR_1, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2])

  let REAL_DIFFERENTIABLE_WITHIN ← prove
   r"!f x s.
        f real_differentiable (atreal x within s) <=>
        (lift o f o drop) differentiable (at(lift x) within IMAGE lift s)"
   (REWRITE_TAC [real_differentiable, HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [differentiable, has_derivative, LINEAR_SCALING] THEN
    REWRITE_TAC [LINEAR_1, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2])

  let REAL_DIFFERENTIABLE_ON ← prove
   r"!f s. f real_differentiable_on s <=>
         (lift o f o drop) differentiable_on (IMAGE lift s)"
   (REWRITE_TAC [real_differentiable_on, differentiable_on, ← GSYM
                 real_differentiable] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, REAL_DIFFERENTIABLE_WITHIN])

  let HAS_REAL_COMPLEX_DERIVATIVE_WITHIN ← prove
   r"(f has_real_derivative f') (atreal a within s) <=>
        ((Cx o f o Re) has_complex_derivative (Cx f'))
                (at (Cx a) within {z | real z /\ Re z IN s})"
   (REWRITE_TAC [HAS_REAL_DERIVATIVE_WITHINREAL, HAS_COMPLEX_DERIVATIVE_WITHIN,
                 LIM_WITHIN, IN_ELIM_THM, IMP_CONJ, FORALL_REAL] THEN
    REWRITE_TAC [RE_CX, dist, ← GSYM CX_SUB, COMPLEX_NORM_CX, o_THM, ← GSYM CX_DIV,
                 REALLIM_WITHINREAL] THEN
    MESON_TAC [])

  let HAS_REAL_COMPLEX_DERIVATIVE_AT ← prove
   r"(f has_real_derivative f') (atreal a) <=>
       ((Cx o f o Re) has_complex_derivative (Cx f')) (at (Cx a) within real)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE ← prove
   r"!f s. f real_differentiable_on s <=>
         !x. x IN s ==> f real_differentiable (atreal x within s)"
   (REWRITE_TAC [real_differentiable_on, real_differentiable])

  let REAL_DIFFERENTIABLE_ON_REAL_OPEN ← prove
   r"!f s. real_open s
         ==> (f real_differentiable_on s <=>
              !x. x IN s ==> ?f'. (f has_real_derivative f') (atreal x))"
   (REWRITE_TAC [real_differentiable_on, HAS_REAL_DERIVATIVE_WITHINREAL,
                 HAS_REAL_DERIVATIVE_ATREAL] THEN
    SIMP_TAC [REALLIM_WITHIN_REAL_OPEN])

  let REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_WITHIN ← prove
   r"!f s x. f real_differentiable_on s /\ x IN s
           ==> f real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE])

  let REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_ATREAL ← prove
   r"!f s x. f real_differentiable_on s /\ real_open s /\ x IN s
           ==> f real_differentiable (atreal x)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ON_REAL_OPEN, real_differentiable])

  let HAS_COMPLEX_REAL_DERIVATIVE_WITHIN_GEN ← prove
   r"!f g h s d.
        &0 < d /\ x IN s /\
        (h has_complex_derivative Cx(g))
        (at (Cx x) within {z | real z /\ Re(z) IN s}) /\
        (!y. y IN s /\ abs(y - x) < d ==>  h(Cx y) = Cx(f y))
        ==> (f has_real_derivative g) (atreal x within s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN THEN
    MAP_EVERY EXISTS_TAC [← q r"h:complex->complex", ← q r"d:real"] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, o_THM, REAL_CX, RE_CX, dist] THEN
    X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"Re w")) THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM o GEN_REWRITE_RULE id [REAL]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CX_SUB, COMPLEX_NORM_CX]) THEN
    ASM_REWRITE_TAC [RE_CX])

  let HAS_COMPLEX_REAL_DERIVATIVE_AT_GEN ← prove
   r"!f g h d.
        &0 < d /\
        (h has_complex_derivative Cx(g)) (at (Cx x) within real) /\
        (!y. abs(y - x) < d ==>  h(Cx y) = Cx(f y))
        ==> (f has_real_derivative g) (atreal x)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_WITHIN_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"h:complex->complex", ← q r"d:real"] THEN
    ASM_REWRITE_TAC [IN_UNIV, ETA_AX, ← SET_RULE (← q r"{x | r x} = r")])

  let HAS_COMPLEX_REAL_DERIVATIVE_WITHIN ← prove
   r"!f g h s.
        x IN s /\
        (h has_complex_derivative Cx(g))
        (at (Cx x) within {z | real z /\ Re(z) IN s}) /\
        (!y. y IN s ==>  h(Cx y) = Cx(f y))
        ==> (f has_real_derivative g) (atreal x within s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_WITHIN_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"h:complex->complex", ← q r"&1"] THEN
    ASM_SIMP_TAC [REAL_LT_01])

  let HAS_COMPLEX_REAL_DERIVATIVE_AT ← prove
   r"!f g h.
        (h has_complex_derivative Cx(g)) (at (Cx x) within real) /\
        (!y. h(Cx y) = Cx(f y))
        ==> (f has_real_derivative g) (atreal x)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_WITHIN THEN
    EXISTS_TAC (← q r"h:complex->complex") THEN
    ASM_REWRITE_TAC [IN_UNIV, ETA_AX, ← SET_RULE (← q r"{x | r x} = r")])

  let HAS_REAL_DERIVATIVE_FROM_COMPLEX_AT ← prove
   r"!f f' x.
        (f has_complex_derivative f') (at (Cx x)) /\
        (!z. real z ==> real(f z))
        ==> ((Re o f o Cx) has_real_derivative (Re f')) (atreal x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT THEN
    EXISTS_TAC (← q r"f:complex->complex") THEN REWRITE_TAC [o_DEF] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL, REAL_CX, RE_CX]] THEN
    FIRST_X_ASSUM (ASSUME_TAC o SPEC (← q r"real") o
      MATCH_MP HAS_COMPLEX_DERIVATIVE_AT_WITHIN) THEN
    SUBGOAL_THEN (← q r"real f'") (fun th => ASM_MESON_TAC [REAL, th]) THEN
    MATCH_MP_TAC (← ISPEC (← q r"at (Cx x) within real") REAL_LIM) THEN
    EXISTS_TAC (← q r"\y. ((f:complex->complex) y - f (Cx x)) / (y - Cx x)") THEN
    ASM_REWRITE_TAC [← GSYM HAS_COMPLEX_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [TRIVIAL_LIMIT_WITHIN_REAL, REAL_CX] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN] THEN EXISTS_TAC (← q r"&1") THEN
    ASM_SIMP_TAC [IN, REAL_CX, REAL_SUB, REAL_DIV, REAL_LT_01])

  let REAL_DIFFERENTIABLE_FROM_COMPLEX_AT ← prove
   r"!f x. f complex_differentiable at (Cx x) /\
         (!z. real z ==> real(f z))
         ==> (Re o f o Cx) real_differentiable (atreal x)"
   (REWRITE_TAC [complex_differentiable, real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_FROM_COMPLEX_AT])

  let HAS_REAL_DERIVATIVE_CARATHEODORY_ATREAL ← prove
   r"!f f' z.
        (f has_real_derivative f') (atreal z) <=>
        ?g. (!w. f(w) - f(z) = g(w) * (w - z)) /\
            g real_continuous atreal z /\ g(z) = f'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_RING (← q r"w' - z':real = a <=> w' = z' + a")] THEN
    SIMP_TAC [← GSYM FUN_EQ_THM, HAS_REAL_DERIVATIVE_ATREAL,
              REAL_CONTINUOUS_ATREAL] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [EXISTS_TAC (← q r"\w. if w = z then f':real else (f(w) - f(z)) / (w - z)") THEN
      ASM_SIMP_TAC [FUN_EQ_THM, COND_RAND, COND_RATOR, REAL_SUB_REFL] THEN
      CONV_TAC REAL_FIELD,
      FIRST_X_ASSUM SUBST_ALL_TAC THEN FIRST_X_ASSUM SUBST1_TAC THEN
      ASM_SIMP_TAC [← REAL_RING (← q r"(z + a) - (z + b * (w - w)):real = a")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        REALLIM_TRANSFORM)) THEN
      SIMP_TAC [REALLIM_CONST, ← REAL_FIELD
       (← q r"~(w = z) ==> x - (x * (w - z)) / (w - z) = &0")]])

  let HAS_REAL_DERIVATIVE_CARATHEODORY_WITHINREAL ← prove
   r"!f f' z s.
        (f has_real_derivative f') (atreal z within s) <=>
        ?g. (!w. f(w) - f(z) = g(w) * (w - z)) /\
            g real_continuous (atreal z within s) /\ g(z) = f'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_RING (← q r"w' - z':real = a <=> w' = z' + a")] THEN
    SIMP_TAC [← GSYM FUN_EQ_THM, HAS_REAL_DERIVATIVE_WITHINREAL,
              REAL_CONTINUOUS_WITHINREAL] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [EXISTS_TAC (← q r"\w. if w = z then f':real else (f(w) - f(z)) / (w - z)") THEN
      ASM_SIMP_TAC [FUN_EQ_THM, COND_RAND, COND_RATOR, REAL_SUB_REFL] THEN
      CONV_TAC REAL_FIELD,
      FIRST_X_ASSUM SUBST_ALL_TAC THEN FIRST_X_ASSUM SUBST1_TAC THEN
      ASM_SIMP_TAC [← REAL_RING (← q r"(z + a) - (z + b * (w - w)):real = a")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        REALLIM_TRANSFORM)) THEN
      SIMP_TAC [REALLIM_CONST, ← REAL_FIELD
       (← q r"~(w = z) ==> x - (x * (w - z)) / (w - z) = &0")]])

  let REAL_DIFFERENTIABLE_CARATHEODORY_ATREAL ← prove
   r"!f z. f real_differentiable atreal z <=>
         ?g. (!w. f(w) - f(z) = g(w) * (w - z)) /\ g real_continuous atreal z"
   (SIMP_TAC [real_differentiable, HAS_REAL_DERIVATIVE_CARATHEODORY_ATREAL] THEN
    MESON_TAC [])

  let REAL_DIFFERENTIABLE_CARATHEODORY_WITHINREAL ← prove
   r"!f z s.
      f real_differentiable (atreal z within s) <=>
      ?g. (!w. f(w) - f(z) = g(w) * (w - z)) /\
          g real_continuous (atreal z within s)"
   (SIMP_TAC [real_differentiable,
              HAS_REAL_DERIVATIVE_CARATHEODORY_WITHINREAL] THEN
    MESON_TAC [])

  pure { HAS_REAL_FRECHET_DERIVATIVE_WITHIN, HAS_REAL_FRECHET_DERIVATIVE_AT,
         HAS_REAL_VECTOR_DERIVATIVE_WITHIN, HAS_REAL_VECTOR_DERIVATIVE_AT,
         REAL_DIFFERENTIABLE_AT, REAL_DIFFERENTIABLE_WITHIN, REAL_DIFFERENTIABLE_ON,
         HAS_REAL_COMPLEX_DERIVATIVE_WITHIN, HAS_REAL_COMPLEX_DERIVATIVE_AT,
         REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, REAL_DIFFERENTIABLE_ON_REAL_OPEN,
         REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_WITHIN,
         REAL_DIFFERENTIABLE_ON_IMP_DIFFERENTIABLE_ATREAL,
         HAS_COMPLEX_REAL_DERIVATIVE_WITHIN_GEN, HAS_COMPLEX_REAL_DERIVATIVE_AT_GEN,
         HAS_COMPLEX_REAL_DERIVATIVE_WITHIN, HAS_COMPLEX_REAL_DERIVATIVE_AT,
         HAS_REAL_DERIVATIVE_FROM_COMPLEX_AT, REAL_DIFFERENTIABLE_FROM_COMPLEX_AT,
         HAS_REAL_DERIVATIVE_CARATHEODORY_ATREAL,
         HAS_REAL_DERIVATIVE_CARATHEODORY_WITHINREAL,
         REAL_DIFFERENTIABLE_CARATHEODORY_ATREAL,
         REAL_DIFFERENTIABLE_CARATHEODORY_WITHINREAL }
/- ------------------------------------------------------------------------- -/
/- Property of being an interval (equivalent to convex or connected).        -/
/- (realanalysis.ml 3032-3160)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZM where
  IS_REALINTERVAL_CONVEX : thm
  IS_REALINTERVAL_CONNECTED : thm
  TRIVIAL_LIMIT_WITHIN_REALINTERVAL : thm
  IS_REAL_INTERVAL_CASES : thm
  IS_REALINTERVAL_CLAUSES : thm
  REAL_CONVEX : thm
  REAL_CONVEX_ALT : thm
  REAL_MIDPOINT_IN_CONVEX : thm
  IS_REALINTERVAL_CONVEX_COMPLEX : thm
  IMAGE_AFFINITY_REAL_INTERVAL : thm
  IMAGE_STRETCH_REAL_INTERVAL : thm
  REAL_INTERVAL_TRANSLATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZM [HolBase] (D : RealAnalysisDeps) (BRZG : RZG) : ExceptT String IO RZM := do
  -- @@SCOPE BEGIN
  let { TRIVIAL_LIMIT_WITHINREAL_WITHIN, .. } := BRZG
  let { IMAGE_LIFT_DROP, .. } := D.qvectors
  let { IS_REALINTERVAL_IS_INTERVAL, REAL_INTERVAL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, is_realinterval, .. } := D.qmisc
  let { TRIVIAL_LIMIT_WITHIN_CONVEX, .. } := D.qconvex
  let { COMPLEX_CMUL, CX_ADD, CX_MUL, RE_ADD, RE_CMUL, RE_CX, RE_MUL_CX, .. } := D.ts.cn.cxc
  let { IMAGE_CX, .. } := D.ts.cn.cxi
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE,
        .. } := D.ts.cn.cx.cvx
  let { convex, .. } := D.ts.cn.cx.cpx
  let { IMAGE_AFFINITY_INTERVAL, IS_INTERVAL_1_CASES, .. } := D.ts.cn.ms.ig.qtopology
  let { EXISTS_REFL, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_SING, IN_UNIV, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, SURJECTIVE_IMAGE_EQ, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, FORALL_DROP, LIFT_ADD, LIFT_CMUL, LIFT_DROP,
        .. } := D.ts.cn.cx.cvx.vec2
  let { linear, .. } := D.ts.cn.cx.cvx.vec4
  let { IS_INTERVAL_CONNECTED_1, .. } := D.ts.cn.ms.ig.dv.dg.qconvex
  let { CONVEX_ALT, CONVEX_LINEAR_IMAGE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let IS_REALINTERVAL_CONVEX ← prove
   r"!s. is_realinterval s <=> convex(IMAGE lift s)"
   (REWRITE_TAC [IS_REALINTERVAL_IS_INTERVAL, IS_INTERVAL_CONVEX_1])

  let IS_REALINTERVAL_CONNECTED ← prove
   r"!s. is_realinterval s <=> connected(IMAGE lift s)"
   (REWRITE_TAC [IS_REALINTERVAL_IS_INTERVAL, IS_INTERVAL_CONNECTED_1])

  let TRIVIAL_LIMIT_WITHIN_REALINTERVAL ← prove
   r"!s x. is_realinterval s /\ x IN s
         ==> (trivial_limit(atreal x within s) <=> s = {x})"
   (REWRITE_TAC [TRIVIAL_LIMIT_WITHINREAL_WITHIN, IS_REALINTERVAL_CONVEX] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP, LIFT_DROP] THEN
    SIMP_TAC [TRIVIAL_LIMIT_WITHIN_CONVEX] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE_LIFT_DROP, IN_SING] THEN
    MESON_TAC [LIFT_DROP])

  let IS_REAL_INTERVAL_CASES ← prove
   r"!s. is_realinterval s <=>
        s = {} \/
        s = (:real) \/
        (?a. s = {x | a < x}) \/
        (?a. s = {x | a <= x}) \/
        (?b. s = {x | x <= b}) \/
        (?b. s = {x | x < b}) \/
        (?a b. s = {x | a < x /\ x < b}) \/
        (?a b. s = {x | a < x /\ x <= b}) \/
        (?a b. s = {x | a <= x /\ x < b}) \/
        (?a b. s = {x | a <= x /\ x <= b})"
   (REWRITE_TAC [IS_REALINTERVAL_IS_INTERVAL, IS_INTERVAL_1_CASES] THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE_LIFT_DROP, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM FORALL_DROP, IN_UNIV, NOT_IN_EMPTY])

  let IS_REALINTERVAL_CLAUSES ← prove
   r"is_realinterval {} /\
   is_realinterval (:real) /\
   (!a. is_realinterval {x | a < x}) /\
   (!a. is_realinterval {x | a <= x}) /\
   (!b. is_realinterval {x | x < b}) /\
   (!b. is_realinterval {x | x <= b}) /\
   (!a b. is_realinterval {x | a < x /\ x < b}) /\
   (!a b. is_realinterval {x | a < x /\ x <= b}) /\
   (!a b. is_realinterval {x | a <= x /\ x < b}) /\
   (!a b. is_realinterval {x | a <= x /\ x <= b})"
   (REWRITE_TAC [is_realinterval, IN_ELIM_THM, IN_UNIV, NOT_IN_EMPTY] THEN
    REAL_ARITH_TAC)

  let REAL_CONVEX ← prove
   r"!s. is_realinterval s <=>
       !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                 ==> (u * x + v * y) IN s"
   (REWRITE_TAC [IS_REALINTERVAL_CONVEX, convex] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE_LIFT_DROP, DROP_ADD, DROP_CMUL, LIFT_DROP])

  let REAL_CONVEX_ALT ← prove
   r"!s. is_realinterval s <=>
       !x y u. x IN s /\ y IN s /\ &0 <= u /\ u <= &1
                 ==> ((&1 - u) * x + u * y) IN s"
   (REWRITE_TAC [IS_REALINTERVAL_CONVEX, CONVEX_ALT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE_LIFT_DROP, DROP_ADD, DROP_CMUL, LIFT_DROP])

  let REAL_MIDPOINT_IN_CONVEX ← prove
   r"!s x y. is_realinterval s /\ x IN s /\ y IN s ==> ((x + y) / &2) IN s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(x + y) / &2 = inv(&2) * x + inv(&2) * y")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [REAL_CONVEX]) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [])

  let IS_REALINTERVAL_CONVEX_COMPLEX ← prove
   r"!s. is_realinterval s <=> convex {z | real z /\ Re z IN s}"
   (GEN_TAC THEN
    REWRITE_TAC [← GSYM IMAGE_CX, IS_REALINTERVAL_CONVEX] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o ISPEC (← q r"Cx o drop") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] CONVEX_LINEAR_IMAGE)) THEN
      REWRITE_TAC [← GSYM IMAGE_o, ← GSYM o_ASSOC] THEN
      ONCE_REWRITE_TAC [IMAGE_o] THEN REWRITE_TAC [IMAGE_LIFT_DROP] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [linear, o_THM, CX_ADD, CX_MUL, DROP_ADD, DROP_CMUL,
                   COMPLEX_CMUL],
      DISCH_THEN (MP_TAC o ISPEC (← q r"lift o Re") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] CONVEX_LINEAR_IMAGE)) THEN
      REWRITE_TAC [← GSYM IMAGE_o, ← GSYM o_ASSOC] THEN
      ONCE_REWRITE_TAC [IMAGE_o] THEN
      REWRITE_TAC [o_DEF, RE_CX, ← SET_RULE (← q r"IMAGE (\x. x) s = s")] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [linear, o_THM, RE_CMUL,
                   RE_ADD, RE_MUL_CX, LIFT_ADD, LIFT_CMUL]])

  let IMAGE_AFFINITY_REAL_INTERVAL ← prove
   r"!a b m c.
         IMAGE (\x. m * x + c) (real_interval[a,b]) =
         (if real_interval[a,b] = {}
          then {}
          else if &0 <= m
               then real_interval[m * a + c,m * b + c]
               else real_interval[m * b + c,m * a + c])"
   (REWRITE_TAC [REAL_INTERVAL_INTERVAL, ← GSYM IMAGE_o, o_DEF, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP, ← GSYM DROP_CMUL, ← GSYM DROP_ADD] THEN
    REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    REWRITE_TAC [IMAGE_o, IMAGE_AFFINITY_INTERVAL] THEN
    MESON_TAC [IMAGE_CLAUSES])

  let IMAGE_STRETCH_REAL_INTERVAL ← prove
   r"!a b m.
         IMAGE (\x. m * x) (real_interval[a,b]) =
         (if real_interval[a,b] = {}
          then {}
          else if &0 <= m
               then real_interval[m * a,m * b]
               else real_interval[m * b,m * a])"
   (ONCE_REWRITE_TAC [← REAL_ARITH (← q r"m * x = m * x + &0")] THEN
    REWRITE_TAC [IMAGE_AFFINITY_REAL_INTERVAL])

  let REAL_INTERVAL_TRANSLATION ← prove
   r"(!c a b. real_interval[c + a,c + b] =
            IMAGE (\x. c + x) (real_interval[a,b])) /\
   (!c a b. real_interval(c + a,c + b) =
            IMAGE (\x. c + x) (real_interval(a,b)))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [← REAL_ARITH (← q r"c + x:real = y <=> x = y - c"), EXISTS_REFL] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  pure { IS_REALINTERVAL_CONVEX, IS_REALINTERVAL_CONNECTED,
         TRIVIAL_LIMIT_WITHIN_REALINTERVAL, IS_REAL_INTERVAL_CASES,
         IS_REALINTERVAL_CLAUSES, REAL_CONVEX, REAL_CONVEX_ALT, REAL_MIDPOINT_IN_CONVEX,
         IS_REALINTERVAL_CONVEX_COMPLEX, IMAGE_AFFINITY_REAL_INTERVAL,
         IMAGE_STRETCH_REAL_INTERVAL, REAL_INTERVAL_TRANSLATION }
/- ------------------------------------------------------------------------- -/
/- Real continuity and differentiability; more basics about real           -/
/- derivatives; some handy theorems about the actual differentition        -/
/- function.                                                                -/
/- (realanalysis.ml 3161-3475)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZN where
  REAL_CONTINUOUS_CONTINUOUS : thm
  REAL_CONTINUOUS_CONTINUOUS1 : thm
  REAL_CONTINUOUS_CONTINUOUS_ATREAL : thm
  REAL_CONTINUOUS_CONTINUOUS_WITHINREAL : thm
  REAL_COMPLEX_CONTINUOUS_WITHINREAL : thm
  REAL_COMPLEX_CONTINUOUS_ATREAL : thm
  CONTINUOUS_CONTINUOUS_WITHINREAL : thm
  CONTINUOUS_CONTINUOUS_ATREAL : thm
  REAL_CONTINUOUS_REAL_CONTINUOUS_WITHINREAL : thm
  REAL_CONTINUOUS_REAL_CONTINUOUS_ATREAL : thm
  HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_WITHINREAL : thm
  REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL : thm
  HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL : thm
  REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL : thm
  REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON : thm
  REAL_CONTINUOUS_AT_COMPONENT : thm
  REAL_CONTINUOUS_AT_TRANSLATION : thm
  REAL_CONTINUOUS_AT_LINEAR_IMAGE : thm
  REAL_CONTINUOUS_AT_ARG : thm
  REAL_CONTINUOUS_TRANSFORM_WITHIN_SET_IMP : thm
  CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP : thm
  REAL_CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP : thm
  HAS_REAL_DERIVATIVE_WITHIN_SUBSET : thm
  REAL_DIFFERENTIABLE_ON_SUBSET : thm
  REAL_DIFFERENTIABLE_WITHIN_SUBSET : thm
  HAS_REAL_DERIVATIVE_ATREAL_WITHIN : thm
  HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN : thm
  REAL_DIFFERENTIABLE_ATREAL_WITHIN : thm
  HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN : thm
  HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL : thm
  HAS_REAL_DERIVATIVE_ZERO_CONSTANT : thm
  HAS_REAL_DERIVATIVE_ZERO_UNIQUE : thm
  REAL_DIFF_CHAIN_WITHIN : thm
  REAL_DIFF_CHAIN_ATREAL : thm
  HAS_REAL_DERIVATIVE_CHAIN : thm
  HAS_REAL_DERIVATIVE_CHAIN_UNIV : thm
  REAL_DERIVATIVE_UNIQUE_ATREAL : thm
  HAS_REAL_DERIVATIVE_DERIVATIVE : thm
  HAS_REAL_DERIVATIVE_DIFFERENTIABLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZN [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZF : RZF) (BRZG : RZG) (BRZH : RZH) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZM : RZM) : ExceptT String IO RZN := do
  -- @@SCOPE BEGIN
  let { REALLIM_COMPLEX, TENDSTO_REAL, .. } := BRZA
  let { LIM_TRANSFORM_WITHINREAL_SET_IMP, NETLIMIT_ATREAL, NETLIMIT_WITHINREAL,
        REALLIM_TRANSFORM_WITHINREAL_SET_IMP, WITHINREAL_UNIV, .. } := BRZF
  let { LIM_ATREAL_AT, LIM_ATREAL_ATCOMPLEX, LIM_WITHINREAL_WITHIN,
        LIM_WITHINREAL_WITHINCOMPLEX, REALLIM_ATREAL_AT, REALLIM_WITHIN_REAL_OPEN,
        REALLIM_WITHINREAL_WITHIN, TRIVIAL_LIMIT_WITHINREAL_WITHINCOMPLEX, .. } := BRZG
  let { CONTINUOUS_ATREAL, CONTINUOUS_WITHINREAL, real_continuous, REAL_CONTINUOUS_AT,
        REAL_CONTINUOUS_ATREAL, REAL_CONTINUOUS_WITHIN, REAL_CONTINUOUS_WITHINREAL,
        .. } := BRZH
  let { REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { HAS_REAL_DERIVATIVE_ATREAL, HAS_REAL_DERIVATIVE_WITHINREAL, real_derivative,
        real_differentiable, real_differentiable_on, .. } := BRZK
  let { HAS_REAL_COMPLEX_DERIVATIVE_AT, HAS_REAL_COMPLEX_DERIVATIVE_WITHIN,
        HAS_REAL_FRECHET_DERIVATIVE_AT, .. } := BRZL
  let { IS_REALINTERVAL_CONVEX_COMPLEX, .. } := BRZM
  let { CONTINUOUS_AT_ARG, .. } := D.tsz
  let { CONTINUOUS_AT_LIFT_COMPONENT, CONTINUOUS_AT_LINEAR_IMAGE,
        CONTINUOUS_AT_TRANSLATION, CONTINUOUS_TRANSFORM_WITHIN_SET_IMP, .. } := D.qtopology
  let { COMPLEX_DIFF_CHAIN_WITHIN, HAS_COMPLEX_DERIVATIVE_IMP_CONTINUOUS_WITHIN,
        HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN, HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET,
        HAS_COMPLEX_DERIVATIVE_ZERO_CONSTANT, .. } := D.ts.kne
  let { CX_MUL, RE_CX, RE_SUB, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_GE_RE_IM, .. } := D.ts.cn.cxg
  let { FORALL_REAL, REAL, REAL_CX, .. } := D.ts.cn.cxi
  let { continuous, .. } := D.ts.cn.qtopology
  let { FRECHET_DERIVATIVE_UNIQUE_AT, .. } := D.ts.cn.qderivatives
  let { add_linear_invariants, add_translation_invariants, ASM_MESON_TAC, MESON_TAC,
        NORM_ARITH, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { ARITH_EQ, EQ_IMP, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IN,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_MUL_SYM, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { VECTOR_MUL_RCANCEL, .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { CONTINUOUS_AT, .. } := D.ts.cn.ms.ig.dv.qtopology1
  let { LIM_TRIVIAL, NETLIMIT_WITHIN, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { VEC_EQ, .. } := D.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  let REAL_CONTINUOUS_CONTINUOUS ← prove
   r"f real_continuous net <=> (Cx o f) continuous net"
   (REWRITE_TAC [real_continuous, continuous, REALLIM_COMPLEX, o_THM])

  let REAL_CONTINUOUS_CONTINUOUS1 ← prove
   r"f real_continuous net <=> (lift o f) continuous net"
   (REWRITE_TAC [real_continuous, continuous, TENDSTO_REAL, o_THM])

  let REAL_CONTINUOUS_CONTINUOUS_ATREAL ← prove
   r"f real_continuous (atreal x) <=> (lift o f o drop) continuous (at(lift x))"
   (REWRITE_TAC [REAL_CONTINUOUS_ATREAL, REALLIM_ATREAL_AT, CONTINUOUS_AT,
                 TENDSTO_REAL, o_THM, LIFT_DROP])

  let REAL_CONTINUOUS_CONTINUOUS_WITHINREAL ← prove
   r"f real_continuous (atreal x within s) <=>
   (lift o f o drop) continuous (at(lift x) within IMAGE lift s)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHINREAL, REALLIM_WITHINREAL_WITHIN] THEN
    REWRITE_TAC [TENDSTO_REAL, CONTINUOUS_WITHIN, o_THM, LIFT_DROP])

  let REAL_COMPLEX_CONTINUOUS_WITHINREAL ← prove
   r"f real_continuous (atreal x within s) <=>
       (Cx o f o Re) continuous (at (Cx x) within (real INTER IMAGE Cx s))"
   (REWRITE_TAC [real_continuous, continuous, REALLIM_COMPLEX,
           LIM_WITHINREAL_WITHINCOMPLEX, NETLIMIT_WITHINREAL, ← GSYM o_ASSOC] THEN
    ASM_CASES_TAC (← q r"trivial_limit(at(Cx x) within (real INTER IMAGE Cx s))") THEN
    ASM_SIMP_TAC [LIM_TRIVIAL] THEN
    ASM_SIMP_TAC [TRIVIAL_LIMIT_WITHINREAL_WITHINCOMPLEX,
                  NETLIMIT_WITHIN, NETLIMIT_WITHINREAL, RE_CX, o_THM])

  let REAL_COMPLEX_CONTINUOUS_ATREAL ← prove
   r"f real_continuous (atreal x) <=>
       (Cx o f o Re) continuous (at (Cx x) within real)"
   (REWRITE_TAC [real_continuous, continuous, REALLIM_COMPLEX,
                 LIM_ATREAL_ATCOMPLEX, NETLIMIT_ATREAL, ← GSYM o_ASSOC] THEN
    ASM_CASES_TAC (← q r"trivial_limit(at(Cx x) within real)") THEN
    ASM_SIMP_TAC [LIM_TRIVIAL] THEN
    ASM_SIMP_TAC [NETLIMIT_WITHIN, RE_CX, o_THM])

  let CONTINUOUS_CONTINUOUS_WITHINREAL ← prove
   r"!f x s. f continuous (atreal x within s) <=>
           (f o drop) continuous (at (lift x) within IMAGE lift s)"
   (REWRITE_TAC [REALLIM_WITHINREAL_WITHIN, CONTINUOUS_WITHIN,
           CONTINUOUS_WITHINREAL, o_DEF, LIFT_DROP, LIM_WITHINREAL_WITHIN])

  let CONTINUOUS_CONTINUOUS_ATREAL ← prove
   r"!f x. f continuous (atreal x) <=> (f o drop) continuous (at (lift x))"
   (REWRITE_TAC [REALLIM_ATREAL_AT, CONTINUOUS_AT,
           CONTINUOUS_ATREAL, o_DEF, LIFT_DROP, LIM_ATREAL_AT])

  let REAL_CONTINUOUS_REAL_CONTINUOUS_WITHINREAL ← prove
   r"!f x s. f real_continuous (atreal x within s) <=>
           (f o drop) real_continuous (at (lift x) within IMAGE lift s)"
   (REWRITE_TAC [REALLIM_WITHINREAL_WITHIN, REAL_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHINREAL, o_DEF, LIFT_DROP,
                 LIM_WITHINREAL_WITHIN])

  let REAL_CONTINUOUS_REAL_CONTINUOUS_ATREAL ← prove
   r"!f x. f real_continuous (atreal x) <=>
         (f o drop) real_continuous (at (lift x))"
   (REWRITE_TAC [REALLIM_ATREAL_AT, REAL_CONTINUOUS_AT,
           REAL_CONTINUOUS_ATREAL, o_DEF, LIFT_DROP, LIM_ATREAL_AT])

  let HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_WITHINREAL ← prove
   r"!f f' x s. (f has_real_derivative f') (atreal x within s)
              ==> f real_continuous (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN,
                 REAL_COMPLEX_CONTINUOUS_WITHINREAL] THEN
    DISCH_THEN (MP_TAC o
      MATCH_MP HAS_COMPLEX_DERIVATIVE_IMP_CONTINUOUS_WITHIN) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, IN_IMAGE] THEN
    MESON_TAC [REAL, RE_CX, REAL_CX, IN])

  let REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL ← prove
   r"!f x s. f real_differentiable (atreal x within s)
           ==> f real_continuous (atreal x within s)"
   (MESON_TAC [HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_WITHINREAL,
               real_differentiable])

  let HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL ← prove
   r"!f f' x. (f has_real_derivative f') (atreal x)
            ==> f real_continuous (atreal x)"
   (REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_AT,
                 REAL_COMPLEX_CONTINUOUS_ATREAL,
                 HAS_COMPLEX_DERIVATIVE_IMP_CONTINUOUS_WITHIN])

  let REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL ← prove
   r"!f x. f real_differentiable atreal x ==> f real_continuous atreal x"
   (MESON_TAC [HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL, real_differentiable])

  let REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON ← prove
   r"!f s. f real_differentiable_on s ==> f real_continuous_on s"
   (REWRITE_TAC [real_differentiable_on,
                 REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    MESON_TAC [REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL,
               real_differentiable])

  let REAL_CONTINUOUS_AT_COMPONENT ← prove
   r"!i a. 1 <= i /\ i <= dimindex(:N)
         ==> (\x:real^N. x$i) real_continuous at a"
   (REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1, o_DEF,
                 CONTINUOUS_AT_LIFT_COMPONENT])

  let REAL_CONTINUOUS_AT_TRANSLATION ← prove
   r"!a z f:real^N->real.
    f real_continuous at (a + z) <=> (\x. f(a + x)) real_continuous at z"
   (REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1, o_DEF, CONTINUOUS_AT_TRANSLATION])

  add_translation_invariants [REAL_CONTINUOUS_AT_TRANSLATION]

  let REAL_CONTINUOUS_AT_LINEAR_IMAGE ← prove
   r"!h:real^N->real^N z f:real^N->real.
        linear h /\ (!x. norm(h x) = norm x)
        ==> (f real_continuous at (h z) <=> (\x. f(h x)) real_continuous at z)"
   (REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1, o_DEF,
                 CONTINUOUS_AT_LINEAR_IMAGE])

  add_linear_invariants [REAL_CONTINUOUS_AT_LINEAR_IMAGE]

  let REAL_CONTINUOUS_AT_ARG ← prove
   r"!z. ~(real z /\ &0 <= Re z) ==> Arg real_continuous (at z)"
   (REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS, CONTINUOUS_AT_ARG])

  let REAL_CONTINUOUS_TRANSFORM_WITHIN_SET_IMP ← prove
   r"!f a s t. eventually (\x. x IN t ==> x IN s) (at a) /\
             f real_continuous (at a within s)
             ==> f real_continuous (at a within t)"
   (REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1,
                 CONTINUOUS_TRANSFORM_WITHIN_SET_IMP])

  let CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP ← prove
   r"!f a s t. eventually (\x. x IN t ==> x IN s) (atreal a) /\
             f continuous (atreal a within s)
             ==> f continuous (atreal a within t)"
   (REWRITE_TAC [CONTINUOUS_WITHINREAL, LIM_TRANSFORM_WITHINREAL_SET_IMP])

  let REAL_CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP ← prove
   r"!f a s t. eventually (\x. x IN t ==> x IN s) (atreal a) /\
             f real_continuous (atreal a within s)
             ==> f real_continuous (atreal a within t)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHINREAL,
                 REALLIM_TRANSFORM_WITHINREAL_SET_IMP])

  let HAS_REAL_DERIVATIVE_WITHIN_SUBSET ← prove
   r"!f s t x. (f has_real_derivative f') (atreal x within s) /\ t SUBSET s
             ==> (f has_real_derivative f') (atreal x within t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
     HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET) THEN ASM SET_TAC [])

  let REAL_DIFFERENTIABLE_ON_SUBSET ← prove
   r"!f s t. f real_differentiable_on s /\ t SUBSET s
           ==> f real_differentiable_on t"
   (REWRITE_TAC [real_differentiable_on] THEN
    MESON_TAC [SUBSET, HAS_REAL_DERIVATIVE_WITHIN_SUBSET])

  let REAL_DIFFERENTIABLE_WITHIN_SUBSET ← prove
   r"!f s t. f real_differentiable (atreal x within s) /\ t SUBSET s
           ==> f real_differentiable (atreal x within t)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_WITHIN_SUBSET])

  let HAS_REAL_DERIVATIVE_ATREAL_WITHIN ← prove
   r"!f f' x s. (f has_real_derivative f') (atreal x)
              ==> (f has_real_derivative f') (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN,
                 HAS_REAL_COMPLEX_DERIVATIVE_AT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
       HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET) THEN ASM SET_TAC [])

  let HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN ← prove
   r"!f f' a s.
         a IN s /\ real_open s
         ==> ((f has_real_derivative f') (atreal a within s) <=>
              (f has_real_derivative f') (atreal a))"
   (REPEAT GEN_TAC THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_WITHINREAL, HAS_REAL_DERIVATIVE_ATREAL,
                  REALLIM_WITHIN_REAL_OPEN])

  let REAL_DIFFERENTIABLE_ATREAL_WITHIN ← prove
   r"!f s z. f real_differentiable (atreal z)
           ==> f real_differentiable (atreal z within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_ATREAL_WITHIN])

  let HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN ← prove
   r"!f f' g x s d.
       &0 < d /\ x IN s /\
       (!x'. x' IN s /\ abs(x' - x) < d ==> f x' = g x') /\
       (f has_real_derivative f') (atreal x within s)
       ==> (g has_real_derivative f') (atreal x within s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE
      [← TAUT (← q r"a /\ b /\ c /\ d ==> e <=> a /\ b /\ c ==> d ==> e")]
      HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN) THEN
    EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [IN_ELIM_THM, REAL_CX, RE_CX] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
     (← q r"dist(a,b) < d ==> z <= norm(a - b) ==> z < d"))) THEN
    W (MP_TAC o PART_MATCH (rand o rand) COMPLEX_NORM_GE_RE_IM o rand o snd) THEN
    SIMP_TAC [RE_SUB, RE_CX])

  let HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL ← prove
   r"!f f' g x d.
       &0 < d /\ (!x'. abs(x' - x) < d ==> f x' = g x') /\
       (f has_real_derivative f') (atreal x)
       ==> (g has_real_derivative f') (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN, IN_UNIV])

  let HAS_REAL_DERIVATIVE_ZERO_CONSTANT ← prove
   r"!f s.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative (&0)) (atreal x within s))
        ==> ?c. !x. x IN s ==> f(x) = c"
   (REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"Cx o f o Re", ← q r"{z | real z /\ Re z IN s}"]
      HAS_COMPLEX_DERIVATIVE_ZERO_CONSTANT) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, IMP_CONJ, FORALL_REAL, RE_CX, o_THM] THEN
    ASM_REWRITE_TAC [← GSYM IS_REALINTERVAL_CONVEX_COMPLEX] THEN MESON_TAC [RE_CX])

  let HAS_REAL_DERIVATIVE_ZERO_UNIQUE ← prove
   r"!f s c a.
        is_realinterval s /\ a IN s /\ f a = c /\
        (!x. x IN s ==> (f has_real_derivative (&0)) (atreal x within s))
        ==> !x. x IN s ==> f(x) = c"
   (MESON_TAC [HAS_REAL_DERIVATIVE_ZERO_CONSTANT])

  let REAL_DIFF_CHAIN_WITHIN ← prove
   r"!f g f' g' x s.
        (f has_real_derivative f') (atreal x within s) /\
        (g has_real_derivative g') (atreal (f x) within (IMAGE f s))
        ==> ((g o f) has_real_derivative (g' * f'))(atreal x within s)"
   (REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"Cx o (g o f) o Re = (Cx o g o Re) o (Cx o f o Re)")
    SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_DEF, RE_CX], ALL_TAC] THEN
    REWRITE_TAC [CX_MUL] THEN MATCH_MP_TAC COMPLEX_DIFF_CHAIN_WITHIN THEN
    ASM_REWRITE_TAC [o_THM, RE_CX] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_ELIM_THM, o_THM, REAL_CX, RE_CX] THEN SET_TAC [])

  let REAL_DIFF_CHAIN_ATREAL ← prove
   r"!f g f' g' x.
        (f has_real_derivative f') (atreal x) /\
        (g has_real_derivative g') (atreal (f x))
        ==> ((g o f) has_real_derivative (g' * f')) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    ASM_MESON_TAC [REAL_DIFF_CHAIN_WITHIN, SUBSET_UNIV,
                   HAS_REAL_DERIVATIVE_WITHIN_SUBSET])

  let HAS_REAL_DERIVATIVE_CHAIN ← prove
   r"!P f g.
        (!x. P x ==> (g has_real_derivative g'(x)) (atreal x))
        ==> (!x s. (f has_real_derivative f') (atreal x within s) /\ P(f x)
                   ==> ((\x. g(f x)) has_real_derivative f' * g'(f x))
                       (atreal x within s)) /\
            (!x. (f has_real_derivative f') (atreal x) /\ P(f x)
                 ==> ((\x. g(f x)) has_real_derivative f' * g'(f x))
                     (atreal x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM o_DEF] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_MESON_TAC [REAL_DIFF_CHAIN_WITHIN, REAL_DIFF_CHAIN_ATREAL,
                   HAS_REAL_DERIVATIVE_ATREAL_WITHIN])

  let HAS_REAL_DERIVATIVE_CHAIN_UNIV ← prove
   r"!f g. (!x. (g has_real_derivative g'(x)) (atreal x))
         ==> (!x s. (f has_real_derivative f') (atreal x within s)
                    ==> ((\x. g(f x)) has_real_derivative f' * g'(f x))
                        (atreal x within s)) /\
             (!x. (f has_real_derivative f') (atreal x)
                  ==> ((\x. g(f x)) has_real_derivative f' * g'(f x))
                      (atreal x))"
   (MP_TAC (← SPEC (← q r"\x:real. T") HAS_REAL_DERIVATIVE_CHAIN) THEN SIMP_TAC [])

  let REAL_DERIVATIVE_UNIQUE_ATREAL ← prove
   r"!f z f' f''.
        (f has_real_derivative f') (atreal z) /\
        (f has_real_derivative f'') (atreal z)
        ==> f' = f''"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_AT] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FRECHET_DERIVATIVE_UNIQUE_AT) THEN
    DISCH_THEN (MP_TAC o C AP_THM (← q r"vec 1:real^1")) THEN
    REWRITE_TAC [VECTOR_MUL_RCANCEL, VEC_EQ, ARITH_EQ])

  let HAS_REAL_DERIVATIVE_DERIVATIVE ← prove
   r"!f f' x. (f has_real_derivative f') (atreal x)
            ==> real_derivative f x = f'"
   (REWRITE_TAC [real_derivative] THEN
    MESON_TAC [REAL_DERIVATIVE_UNIQUE_ATREAL])

  let HAS_REAL_DERIVATIVE_DIFFERENTIABLE ← prove
   r"!f x. (f has_real_derivative (real_derivative f x)) (atreal x) <=>
         f real_differentiable atreal x"
   (REWRITE_TAC [real_differentiable, real_derivative] THEN MESON_TAC [])

  pure { REAL_CONTINUOUS_CONTINUOUS, REAL_CONTINUOUS_CONTINUOUS1,
         REAL_CONTINUOUS_CONTINUOUS_ATREAL, REAL_CONTINUOUS_CONTINUOUS_WITHINREAL,
         REAL_COMPLEX_CONTINUOUS_WITHINREAL, REAL_COMPLEX_CONTINUOUS_ATREAL,
         CONTINUOUS_CONTINUOUS_WITHINREAL, CONTINUOUS_CONTINUOUS_ATREAL,
         REAL_CONTINUOUS_REAL_CONTINUOUS_WITHINREAL,
         REAL_CONTINUOUS_REAL_CONTINUOUS_ATREAL,
         HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_WITHINREAL,
         REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL,
         HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL,
         REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
         REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, REAL_CONTINUOUS_AT_COMPONENT,
         REAL_CONTINUOUS_AT_TRANSLATION, REAL_CONTINUOUS_AT_LINEAR_IMAGE,
         REAL_CONTINUOUS_AT_ARG, REAL_CONTINUOUS_TRANSFORM_WITHIN_SET_IMP,
         CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP,
         REAL_CONTINUOUS_TRANSFORM_WITHINREAL_SET_IMP, HAS_REAL_DERIVATIVE_WITHIN_SUBSET,
         REAL_DIFFERENTIABLE_ON_SUBSET, REAL_DIFFERENTIABLE_WITHIN_SUBSET,
         HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN,
         REAL_DIFFERENTIABLE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN,
         HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL, HAS_REAL_DERIVATIVE_ZERO_CONSTANT,
         HAS_REAL_DERIVATIVE_ZERO_UNIQUE, REAL_DIFF_CHAIN_WITHIN, REAL_DIFF_CHAIN_ATREAL,
         HAS_REAL_DERIVATIVE_CHAIN, HAS_REAL_DERIVATIVE_CHAIN_UNIV,
         REAL_DERIVATIVE_UNIQUE_ATREAL, HAS_REAL_DERIVATIVE_DERIVATIVE,
         HAS_REAL_DERIVATIVE_DIFFERENTIABLE }
/- ------------------------------------------------------------------------- -/
/- Arithmetical combining theorems; same thing just for real                -/
/- differentiability; same again for being differentiable on a set.         -/
/- (realanalysis.ml 3476-3882)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZO where
  HAS_REAL_DERIVATIVE_LMUL_WITHIN : thm
  HAS_REAL_DERIVATIVE_LMUL_ATREAL : thm
  HAS_REAL_DERIVATIVE_RMUL_WITHIN : thm
  HAS_REAL_DERIVATIVE_RMUL_ATREAL : thm
  HAS_REAL_DERIVATIVE_CDIV_WITHIN : thm
  HAS_REAL_DERIVATIVE_CDIV_ATREAL : thm
  HAS_REAL_DERIVATIVE_ID : thm
  HAS_REAL_DERIVATIVE_CONST : thm
  HAS_REAL_DERIVATIVE_NEG : thm
  HAS_REAL_DERIVATIVE_ADD : thm
  HAS_REAL_DERIVATIVE_SUB : thm
  HAS_REAL_DERIVATIVE_MUL_WITHIN : thm
  HAS_REAL_DERIVATIVE_MUL_ATREAL : thm
  HAS_REAL_DERIVATIVE_POW_WITHIN : thm
  HAS_REAL_DERIVATIVE_POW_ATREAL : thm
  HAS_REAL_DERIVATIVE_INV_BASIC : thm
  HAS_REAL_DERIVATIVE_INV_WITHIN : thm
  HAS_REAL_DERIVATIVE_INV_ATREAL : thm
  HAS_REAL_DERIVATIVE_DIV_WITHIN : thm
  HAS_REAL_DERIVATIVE_DIV_ATREAL : thm
  HAS_REAL_DERIVATIVE_SUM : thm
  REAL_DIFFERENTIABLE_CONST : thm
  REAL_DIFFERENTIABLE_ID : thm
  REAL_DIFFERENTIABLE_NEG : thm
  REAL_DIFFERENTIABLE_ADD : thm
  REAL_DIFFERENTIABLE_SUB : thm
  REAL_DIFFERENTIABLE_INV_WITHIN : thm
  REAL_DIFFERENTIABLE_MUL_WITHIN : thm
  REAL_DIFFERENTIABLE_DIV_WITHIN : thm
  REAL_DIFFERENTIABLE_POW_WITHIN : thm
  REAL_DIFFERENTIABLE_TRANSFORM_WITHIN : thm
  REAL_DIFFERENTIABLE_TRANSFORM : thm
  REAL_DIFFERENTIABLE_EQ : thm
  REAL_DIFFERENTIABLE_INV_ATREAL : thm
  REAL_DIFFERENTIABLE_MUL_ATREAL : thm
  REAL_DIFFERENTIABLE_DIV_ATREAL : thm
  REAL_DIFFERENTIABLE_POW_ATREAL : thm
  REAL_DIFFERENTIABLE_TRANSFORM_ATREAL : thm
  REAL_DIFFERENTIABLE_COMPOSE_WITHIN : thm
  REAL_DIFFERENTIABLE_COMPOSE_ATREAL : thm
  REAL_DIFFERENTIABLE_ON_CONST : thm
  REAL_DIFFERENTIABLE_ON_ID : thm
  REAL_DIFFERENTIABLE_ON_COMPOSE : thm
  REAL_DIFFERENTIABLE_ON_NEG : thm
  REAL_DIFFERENTIABLE_ON_ADD : thm
  REAL_DIFFERENTIABLE_ON_SUB : thm
  REAL_DIFFERENTIABLE_ON_MUL : thm
  REAL_DIFFERENTIABLE_ON_INV : thm
  REAL_DIFFERENTIABLE_ON_DIV : thm
  REAL_DIFFERENTIABLE_ON_POW : thm
  REAL_DIFFERENTIABLE_ON_SUM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZO [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZF : RZF) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) : ExceptT String IO RZO := do
  -- @@SCOPE BEGIN
  let { REALLIM_ADD, REALLIM_CONST, REALLIM_NEG, TENDSTO_REAL, .. } := BRZA
  let { WITHINREAL_UNIV, .. } := BRZF
  let { has_real_derivative, real_differentiable, real_differentiable_on, .. } := BRZK
  let { HAS_REAL_COMPLEX_DERIVATIVE_AT, HAS_REAL_COMPLEX_DERIVATIVE_WITHIN,
        REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL,
        HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN, REAL_DIFF_CHAIN_ATREAL,
        REAL_DIFF_CHAIN_WITHIN, .. } := BRZN
  let { HAS_COMPLEX_DERIVATIVE_AT_WITHIN, HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN,
        .. } := D.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_INV_BASIC, HAS_COMPLEX_DERIVATIVE_LMUL_WITHIN,
        HAS_COMPLEX_DERIVATIVE_MUL_WITHIN, HAS_COMPLEX_DERIVATIVE_POW_WITHIN,
        .. } := D.ts.knf
  let { CX_ADD, CX_INJ, CX_INV, CX_MUL, CX_NEG, CX_POW, RE_CX, .. } := D.ts.cn.cxc
  let { FORALL_REAL, REAL_CX, .. } := D.ts.cn.cxi
  let { MESON_TAC, REAL_ARITH, REAL_FIELD, .. } := D.ts.cn.cx.cvx
  let { real_sub, .. } := D.ts.cn.cx.cpx
  let { EQ_IMP, ETA_AX, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, IMP_IMP, IN,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, MONO_FORALL, NOT_IN_EMPTY, REAL_ADD_LDISTRIB, REAL_ADD_RID,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_01, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NEG_0, REAL_SUB_REFL,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { LIM_CONST, .. } := D.ts.cn.cx.cvx.top4
  -- @@SCOPE END

  let HAS_REAL_DERIVATIVE_LMUL_WITHIN ← prove
   r"!f f' c x s.
        (f has_real_derivative f') (atreal x within s)
        ==> ((\x. c * f(x)) has_real_derivative (c * f')) (atreal x within s)"
   (REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [o_DEF, CX_MUL, HAS_COMPLEX_DERIVATIVE_LMUL_WITHIN])

  let HAS_REAL_DERIVATIVE_LMUL_ATREAL ← prove
   r"!f f' c x.
        (f has_real_derivative f') (atreal x)
        ==> ((\x. c * f(x)) has_real_derivative (c * f')) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_LMUL_WITHIN])

  let HAS_REAL_DERIVATIVE_RMUL_WITHIN ← prove
   r"!f f' c x s.
        (f has_real_derivative f') (atreal x within s)
        ==> ((\x. f(x) * c) has_real_derivative (f' * c)) (atreal x within s)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_LMUL_WITHIN])

  let HAS_REAL_DERIVATIVE_RMUL_ATREAL ← prove
   r"!f f' c x.
        (f has_real_derivative f') (atreal x)
        ==> ((\x. f(x) * c) has_real_derivative (f' * c)) (atreal x)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_LMUL_ATREAL])

  let HAS_REAL_DERIVATIVE_CDIV_WITHIN ← prove
   r"!f f' c x s.
        (f has_real_derivative f') (atreal x within s)
        ==> ((\x. f(x) / c) has_real_derivative (f' / c)) (atreal x within s)"
   (SIMP_TAC [real_div, HAS_REAL_DERIVATIVE_RMUL_WITHIN])

  let HAS_REAL_DERIVATIVE_CDIV_ATREAL ← prove
   r"!f f' c x.
        (f has_real_derivative f') (atreal x)
        ==> ((\x. f(x) / c) has_real_derivative (f' / c)) (atreal x)"
   (SIMP_TAC [real_div, HAS_REAL_DERIVATIVE_RMUL_ATREAL])

  let HAS_REAL_DERIVATIVE_ID ← prove
   r"!net. ((\x. x) has_real_derivative &1) net"
   (REWRITE_TAC [has_real_derivative, TENDSTO_REAL,
                 ← REAL_ARITH (← q r"x - (a + &1 * (x - a)) = &0")] THEN
    REWRITE_TAC [REAL_MUL_RZERO, LIM_CONST, o_DEF])

  let HAS_REAL_DERIVATIVE_CONST ← prove
   r"!c net. ((\x. c) has_real_derivative &0) net"
   (REWRITE_TAC [has_real_derivative, REAL_MUL_LZERO, REAL_ADD_RID, REAL_SUB_REFL,
                 REAL_MUL_RZERO, REALLIM_CONST])

  let HAS_REAL_DERIVATIVE_NEG ← prove
   r"!f f' net. (f has_real_derivative f') net
            ==> ((\x. --(f(x))) has_real_derivative (--f')) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_derivative] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REALLIM_NEG) THEN
    REWRITE_TAC [REAL_NEG_0, ← REAL_ARITH
     (← q r"a * (--b - (--c + --d * e:real)) = --(a * (b - (c + d * e)))")])

  let HAS_REAL_DERIVATIVE_ADD ← prove
   r"!f f' g g' net.
        (f has_real_derivative f') net /\ (g has_real_derivative g') net
        ==> ((\x. f(x) + g(x)) has_real_derivative (f' + g')) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_derivative] THEN
    DISCH_THEN (MP_TAC o MATCH_MP REALLIM_ADD) THEN
    REWRITE_TAC [← GSYM REAL_ADD_LDISTRIB, REAL_ADD_RID] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(fx - (fa + f' * (x - a))) + (gx - (ga + g' * (x - a))):real =
      (fx + gx) - ((fa + ga) + (f' + g') * (x - a))")])

  let HAS_REAL_DERIVATIVE_SUB ← prove
   r"!f f' g g' net.
        (f has_real_derivative f') net /\ (g has_real_derivative g') net
        ==> ((\x. f(x) - g(x)) has_real_derivative (f' - g')) net"
   (SIMP_TAC [real_sub, HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_NEG])

  let HAS_REAL_DERIVATIVE_MUL_WITHIN ← prove
   r"!f f' g g' x s.
        (f has_real_derivative f') (atreal x within s) /\
        (g has_real_derivative g') (atreal x within s)
        ==> ((\x. f(x) * g(x)) has_real_derivative
             (f(x) * g' + f' * g(x))) (atreal x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_COMPLEX_DERIVATIVE_MUL_WITHIN) THEN
    REWRITE_TAC [o_DEF, CX_MUL, CX_ADD, RE_CX])

  let HAS_REAL_DERIVATIVE_MUL_ATREAL ← prove
   r"!f f' g g' x.
        (f has_real_derivative f') (atreal x) /\
        (g has_real_derivative g') (atreal x)
        ==> ((\x. f(x) * g(x)) has_real_derivative
             (f(x) * g' + f' * g(x))) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_MUL_WITHIN])

  let HAS_REAL_DERIVATIVE_POW_WITHIN ← prove
   r"!f f' x s n. (f has_real_derivative f') (atreal x within s)
                ==> ((\x. f(x) pow n) has_real_derivative
                     (&n * f(x) pow (n - 1) * f')) (atreal x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_WITHIN] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"n:num") o
      MATCH_MP HAS_COMPLEX_DERIVATIVE_POW_WITHIN) THEN
    REWRITE_TAC [o_DEF, CX_MUL, CX_POW, RE_CX])

  let HAS_REAL_DERIVATIVE_POW_ATREAL ← prove
   r"!f f' x n. (f has_real_derivative f') (atreal x)
              ==> ((\x. f(x) pow n) has_real_derivative
                   (&n * f(x) pow (n - 1) * f')) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_POW_WITHIN])

  let HAS_REAL_DERIVATIVE_INV_BASIC ← prove
   r"!x. ~(x = &0)
         ==> ((inv) has_real_derivative (--inv(x pow 2))) (atreal x)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [HAS_REAL_COMPLEX_DERIVATIVE_AT] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN THEN
    EXISTS_TAC (← q r"inv:complex->complex") THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_INV_BASIC, CX_INJ, CX_NEG, CX_INV,
                  CX_POW, HAS_COMPLEX_DERIVATIVE_AT_WITHIN] THEN
    SIMP_TAC [IN, FORALL_REAL, IMP_CONJ, o_DEF, REAL_CX, RE_CX, CX_INV] THEN
    MESON_TAC [REAL_LT_01])

  let HAS_REAL_DERIVATIVE_INV_WITHIN ← prove
   r"!f f' x s. (f has_real_derivative f') (atreal x within s) /\
              ~(f x = &0)
              ==> ((\x. inv(f(x))) has_real_derivative (--f' / f(x) pow 2))
                  (atreal x within s)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    ASM_SIMP_TAC [← REAL_FIELD
     (← q r"~(g = &0) ==> --f / g pow 2 = --inv(g pow 2) * f")] THEN
    MATCH_MP_TAC REAL_DIFF_CHAIN_WITHIN THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_ATREAL_WITHIN THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_INV_BASIC])

  let HAS_REAL_DERIVATIVE_INV_ATREAL ← prove
   r"!f f' x. (f has_real_derivative f') (atreal x) /\
            ~(f x = &0)
            ==> ((\x. inv(f(x))) has_real_derivative (--f' / f(x) pow 2))
                (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_INV_WITHIN])

  let HAS_REAL_DERIVATIVE_DIV_WITHIN ← prove
   r"!f f' g g' x s.
        (f has_real_derivative f') (atreal x within s) /\
        (g has_real_derivative g') (atreal x within s) /\
        ~(g(x) = &0)
        ==> ((\x. f(x) / g(x)) has_real_derivative
             (f' * g(x) - f(x) * g') / g(x) pow 2) (atreal x within s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do pure (ASSUME_TAC (← CONJUNCT2 th) THEN MP_TAC th)) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_DERIVATIVE_INV_WITHIN) THEN
    UNDISCH_TAC (← q r"(f has_real_derivative f') (atreal x within s)") THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_DERIVATIVE_MUL_WITHIN) THEN
    REWRITE_TAC [← GSYM real_div] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    POP_ASSUM MP_TAC THEN CONV_TAC REAL_FIELD)

  let HAS_REAL_DERIVATIVE_DIV_ATREAL ← prove
   r"!f f' g g' x.
        (f has_real_derivative f') (atreal x) /\
        (g has_real_derivative g') (atreal x) /\
        ~(g(x) = &0)
        ==> ((\x. f(x) / g(x)) has_real_derivative
             (f' * g(x) - f(x) * g') / g(x) pow 2) (atreal x)"
   (ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_DIV_WITHIN])

  let HAS_REAL_DERIVATIVE_SUM ← prove
   r"!f net s.
         FINITE s /\ (!a. a IN s ==> (f a has_real_derivative f' a) net)
         ==> ((\x. sum s (\a. f a x)) has_real_derivative (sum s f'))
             net"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, SUM_CLAUSES] THEN
    SIMP_TAC [HAS_REAL_DERIVATIVE_CONST, HAS_REAL_DERIVATIVE_ADD, ETA_AX])

  let REAL_DIFFERENTIABLE_CONST ← prove
   r"!c net. (\z. c) real_differentiable net"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_CONST])

  let REAL_DIFFERENTIABLE_ID ← prove
   r"!net. (\z. z) real_differentiable net"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_ID])

  let REAL_DIFFERENTIABLE_NEG ← prove
   r"!f net.
        f real_differentiable net
        ==> (\z. --(f z)) real_differentiable net"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_NEG])

  let REAL_DIFFERENTIABLE_ADD ← prove
   r"!f g net.
        f real_differentiable net /\
        g real_differentiable net
        ==> (\z. f z + g z) real_differentiable net"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_ADD])

  let REAL_DIFFERENTIABLE_SUB ← prove
   r"!f g net.
        f real_differentiable net /\
        g real_differentiable net
        ==> (\z. f z - g z) real_differentiable net"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_SUB])

  let REAL_DIFFERENTIABLE_INV_WITHIN ← prove
   r"!f z s.
        f real_differentiable (atreal z within s) /\ ~(f z = &0)
        ==> (\z. inv(f z)) real_differentiable (atreal z within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_INV_WITHIN])

  let REAL_DIFFERENTIABLE_MUL_WITHIN ← prove
   r"!f g z s.
        f real_differentiable (atreal z within s) /\
        g real_differentiable (atreal z within s)
        ==> (\z. f z * g z) real_differentiable (atreal z within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_MUL_WITHIN])

  let REAL_DIFFERENTIABLE_DIV_WITHIN ← prove
   r"!f g z s.
        f real_differentiable (atreal z within s) /\
        g real_differentiable (atreal z within s) /\
        ~(g z = &0)
        ==> (\z. f z / g z) real_differentiable (atreal z within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_DIV_WITHIN])

  let REAL_DIFFERENTIABLE_POW_WITHIN ← prove
   r"!f n z s.
        f real_differentiable (atreal z within s)
        ==> (\z. f z pow n) real_differentiable (atreal z within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_POW_WITHIN])

  let REAL_DIFFERENTIABLE_TRANSFORM_WITHIN ← prove
   r"!f g x s d.
        &0 < d /\
        x IN s /\
        (!x'. x' IN s /\ abs(x' - x) < d ==> f x' = g x') /\
        f real_differentiable (atreal x within s)
        ==> g real_differentiable (atreal x within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_TRANSFORM_WITHIN])

  let REAL_DIFFERENTIABLE_TRANSFORM ← prove
   r"!f g s. (!x. x IN s ==> f x = g x) /\ f real_differentiable_on s
           ==> g real_differentiable_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [real_differentiable_on, ← GSYM real_differentiable] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_DIFFERENTIABLE_TRANSFORM_WITHIN THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real->real", ← q r"&1"] THEN
    ASM_SIMP_TAC [REAL_LT_01])

  let REAL_DIFFERENTIABLE_EQ ← prove
   r"!f g s. (!x. x IN s ==> f x = g x)
           ==> (f real_differentiable_on s <=> g real_differentiable_on s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_TRANSFORM])

  let REAL_DIFFERENTIABLE_INV_ATREAL ← prove
   r"!f z.
        f real_differentiable atreal z /\ ~(f z = &0)
        ==> (\z. inv(f z)) real_differentiable atreal z"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_INV_ATREAL])

  let REAL_DIFFERENTIABLE_MUL_ATREAL ← prove
   r"!f g z.
        f real_differentiable atreal z /\
        g real_differentiable atreal z
        ==> (\z. f z * g z) real_differentiable atreal z"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_MUL_ATREAL])

  let REAL_DIFFERENTIABLE_DIV_ATREAL ← prove
   r"!f g z.
        f real_differentiable atreal z /\
        g real_differentiable atreal z /\
        ~(g z = &0)
        ==> (\z. f z / g z) real_differentiable atreal z"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_DIV_ATREAL])

  let REAL_DIFFERENTIABLE_POW_ATREAL ← prove
   r"!f n z.
        f real_differentiable atreal z
        ==> (\z. f z pow n) real_differentiable atreal z"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_POW_ATREAL])

  let REAL_DIFFERENTIABLE_TRANSFORM_ATREAL ← prove
   r"!f g x d.
        &0 < d /\
        (!x'. abs(x' - x) < d ==> f x' = g x') /\
        f real_differentiable atreal x
        ==> g real_differentiable atreal x"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL])

  let REAL_DIFFERENTIABLE_COMPOSE_WITHIN ← prove
   r"!f g x s.
         f real_differentiable (atreal x within s) /\
         g real_differentiable (atreal (f x) within IMAGE f s)
         ==> (g o f) real_differentiable (atreal x within s)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [REAL_DIFF_CHAIN_WITHIN])

  let REAL_DIFFERENTIABLE_COMPOSE_ATREAL ← prove
   r"!f g x.
         f real_differentiable (atreal x) /\
         g real_differentiable (atreal (f x))
         ==> (g o f) real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [REAL_DIFF_CHAIN_ATREAL])

  let REAL_DIFFERENTIABLE_ON_CONST ← prove
   r"!c s. (\z. c) real_differentiable_on s"
   (REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
                 REAL_DIFFERENTIABLE_CONST])

  let REAL_DIFFERENTIABLE_ON_ID ← prove
   r"!s. (\z. z) real_differentiable_on s"
   (REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, REAL_DIFFERENTIABLE_ID])

  let REAL_DIFFERENTIABLE_ON_COMPOSE ← prove
   r"!f g s. f real_differentiable_on s /\ g real_differentiable_on (IMAGE f s)
           ==> (g o f) real_differentiable_on s"
   (SIMP_TAC [real_differentiable_on, ← GSYM real_differentiable,
              FORALL_IN_IMAGE] THEN
    MESON_TAC [REAL_DIFFERENTIABLE_COMPOSE_WITHIN])

  let REAL_DIFFERENTIABLE_ON_NEG ← prove
   r"!f s. f real_differentiable_on s ==> (\z. --(f z)) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, REAL_DIFFERENTIABLE_NEG])

  let REAL_DIFFERENTIABLE_ON_ADD ← prove
   r"!f g s.
        f real_differentiable_on s /\ g real_differentiable_on s
        ==> (\z. f z + g z) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, REAL_DIFFERENTIABLE_ADD])

  let REAL_DIFFERENTIABLE_ON_SUB ← prove
   r"!f g s.
        f real_differentiable_on s /\ g real_differentiable_on s
        ==> (\z. f z - g z) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, REAL_DIFFERENTIABLE_SUB])

  let REAL_DIFFERENTIABLE_ON_MUL ← prove
   r"!f g s.
        f real_differentiable_on s /\ g real_differentiable_on s
        ==> (\z. f z * g z) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
              REAL_DIFFERENTIABLE_MUL_WITHIN])

  let REAL_DIFFERENTIABLE_ON_INV ← prove
   r"!f s. f real_differentiable_on s /\ (!z. z IN s ==> ~(f z = &0))
         ==> (\z. inv(f z)) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
              REAL_DIFFERENTIABLE_INV_WITHIN])

  let REAL_DIFFERENTIABLE_ON_DIV ← prove
   r"!f g s.
        f real_differentiable_on s /\ g real_differentiable_on s /\
        (!z. z IN s ==> ~(g z = &0))
        ==> (\z. f z / g z) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
              REAL_DIFFERENTIABLE_DIV_WITHIN])

  let REAL_DIFFERENTIABLE_ON_POW ← prove
   r"!f s n. f real_differentiable_on s
           ==> (\z. (f z) pow n) real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
              REAL_DIFFERENTIABLE_POW_WITHIN])

  let REAL_DIFFERENTIABLE_ON_SUM ← prove
   r"!f s k. FINITE k /\ (!a. a IN k ==> (f a) real_differentiable_on s)
           ==> (\x. sum k (\a. f a x)) real_differentiable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN SIMP_TAC [SUM_CLAUSES] THEN
    SIMP_TAC [REAL_DIFFERENTIABLE_ON_CONST, IN_INSERT, NOT_IN_EMPTY] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_ADD THEN
    ASM_SIMP_TAC [ETA_AX])

  pure { HAS_REAL_DERIVATIVE_LMUL_WITHIN, HAS_REAL_DERIVATIVE_LMUL_ATREAL,
         HAS_REAL_DERIVATIVE_RMUL_WITHIN, HAS_REAL_DERIVATIVE_RMUL_ATREAL,
         HAS_REAL_DERIVATIVE_CDIV_WITHIN, HAS_REAL_DERIVATIVE_CDIV_ATREAL,
         HAS_REAL_DERIVATIVE_ID, HAS_REAL_DERIVATIVE_CONST, HAS_REAL_DERIVATIVE_NEG,
         HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_SUB, HAS_REAL_DERIVATIVE_MUL_WITHIN,
         HAS_REAL_DERIVATIVE_MUL_ATREAL, HAS_REAL_DERIVATIVE_POW_WITHIN,
         HAS_REAL_DERIVATIVE_POW_ATREAL, HAS_REAL_DERIVATIVE_INV_BASIC,
         HAS_REAL_DERIVATIVE_INV_WITHIN, HAS_REAL_DERIVATIVE_INV_ATREAL,
         HAS_REAL_DERIVATIVE_DIV_WITHIN, HAS_REAL_DERIVATIVE_DIV_ATREAL,
         HAS_REAL_DERIVATIVE_SUM, REAL_DIFFERENTIABLE_CONST, REAL_DIFFERENTIABLE_ID,
         REAL_DIFFERENTIABLE_NEG, REAL_DIFFERENTIABLE_ADD, REAL_DIFFERENTIABLE_SUB,
         REAL_DIFFERENTIABLE_INV_WITHIN, REAL_DIFFERENTIABLE_MUL_WITHIN,
         REAL_DIFFERENTIABLE_DIV_WITHIN, REAL_DIFFERENTIABLE_POW_WITHIN,
         REAL_DIFFERENTIABLE_TRANSFORM_WITHIN, REAL_DIFFERENTIABLE_TRANSFORM,
         REAL_DIFFERENTIABLE_EQ, REAL_DIFFERENTIABLE_INV_ATREAL,
         REAL_DIFFERENTIABLE_MUL_ATREAL, REAL_DIFFERENTIABLE_DIV_ATREAL,
         REAL_DIFFERENTIABLE_POW_ATREAL, REAL_DIFFERENTIABLE_TRANSFORM_ATREAL,
         REAL_DIFFERENTIABLE_COMPOSE_WITHIN, REAL_DIFFERENTIABLE_COMPOSE_ATREAL,
         REAL_DIFFERENTIABLE_ON_CONST, REAL_DIFFERENTIABLE_ON_ID,
         REAL_DIFFERENTIABLE_ON_COMPOSE, REAL_DIFFERENTIABLE_ON_NEG,
         REAL_DIFFERENTIABLE_ON_ADD, REAL_DIFFERENTIABLE_ON_SUB,
         REAL_DIFFERENTIABLE_ON_MUL, REAL_DIFFERENTIABLE_ON_INV,
         REAL_DIFFERENTIABLE_ON_DIV, REAL_DIFFERENTIABLE_ON_POW,
         REAL_DIFFERENTIABLE_ON_SUM }
/- ------------------------------------------------------------------------- -/
/- Derivative (and continuity) theorems for real transcendental functions.   -/
/- (realanalysis.ml 3883-4239)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZP where
  HAS_REAL_DERIVATIVE_EXP : thm
  REAL_DIFFERENTIABLE_AT_EXP : thm
  REAL_DIFFERENTIABLE_WITHIN_EXP : thm
  REAL_CONTINUOUS_AT_EXP : thm
  REAL_CONTINUOUS_WITHIN_EXP : thm
  REAL_CONTINUOUS_ON_EXP : thm
  HAS_REAL_DERIVATIVE_SIN : thm
  REAL_DIFFERENTIABLE_AT_SIN : thm
  REAL_DIFFERENTIABLE_WITHIN_SIN : thm
  REAL_CONTINUOUS_AT_SIN : thm
  REAL_CONTINUOUS_WITHIN_SIN : thm
  REAL_CONTINUOUS_ON_SIN : thm
  HAS_REAL_DERIVATIVE_COS : thm
  REAL_DIFFERENTIABLE_AT_COS : thm
  REAL_DIFFERENTIABLE_WITHIN_COS : thm
  REAL_CONTINUOUS_AT_COS : thm
  REAL_CONTINUOUS_WITHIN_COS : thm
  REAL_CONTINUOUS_ON_COS : thm
  HAS_REAL_DERIVATIVE_TAN : thm
  REAL_DIFFERENTIABLE_AT_TAN : thm
  REAL_DIFFERENTIABLE_WITHIN_TAN : thm
  REAL_CONTINUOUS_AT_TAN : thm
  REAL_CONTINUOUS_WITHIN_TAN : thm
  REAL_CONTINUOUS_ON_TAN : thm
  HAS_REAL_DERIVATIVE_LOG : thm
  REAL_DIFFERENTIABLE_AT_LOG : thm
  REAL_DIFFERENTIABLE_WITHIN_LOG : thm
  REAL_CONTINUOUS_AT_LOG : thm
  REAL_CONTINUOUS_WITHIN_LOG : thm
  REAL_CONTINUOUS_ON_LOG : thm
  HAS_REAL_DERIVATIVE_SQRT : thm
  REAL_DIFFERENTIABLE_AT_SQRT : thm
  REAL_DIFFERENTIABLE_WITHIN_SQRT : thm
  REAL_CONTINUOUS_AT_SQRT : thm
  REAL_CONTINUOUS_WITHIN_SQRT : thm
  REAL_CONTINUOUS_WITHIN_SQRT_COMPOSE : thm
  REAL_CONTINUOUS_AT_SQRT_COMPOSE : thm
  CONTINUOUS_WITHINREAL_SQRT_COMPOSE : thm
  CONTINUOUS_ATREAL_SQRT_COMPOSE : thm
  REAL_CONTINUOUS_WITHINREAL_SQRT_COMPOSE : thm
  REAL_CONTINUOUS_ATREAL_SQRT_COMPOSE : thm
  REAL_CONTINUOUS_ON_SQRT : thm
  HAS_REAL_DERIVATIVE_ATN : thm
  REAL_DIFFERENTIABLE_AT_ATN : thm
  REAL_DIFFERENTIABLE_WITHIN_ATN : thm
  REAL_CONTINUOUS_AT_ATN : thm
  REAL_CONTINUOUS_WITHIN_ATN : thm
  REAL_CONTINUOUS_ON_ATN : thm
  HAS_REAL_DERIVATIVE_ASN_COS : thm
  HAS_REAL_DERIVATIVE_ASN : thm
  REAL_DIFFERENTIABLE_AT_ASN : thm
  REAL_DIFFERENTIABLE_WITHIN_ASN : thm
  REAL_CONTINUOUS_AT_ASN : thm
  REAL_CONTINUOUS_WITHIN_ASN : thm
  HAS_REAL_DERIVATIVE_ACS_SIN : thm
  HAS_REAL_DERIVATIVE_ACS : thm
  REAL_DIFFERENTIABLE_AT_ACS : thm
  REAL_DIFFERENTIABLE_WITHIN_ACS : thm
  REAL_CONTINUOUS_AT_ACS : thm
  REAL_CONTINUOUS_WITHIN_ACS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZP [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) : ExceptT String IO RZP := do
  -- @@SCOPE BEGIN
  let { WITHINREAL_UNIV, .. } := BRZF
  let { REAL_CONTINUOUS_ATREAL_WITHINREAL, .. } := BRZH
  let { REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { real_differentiable, .. } := BRZK
  let { HAS_COMPLEX_REAL_DERIVATIVE_AT, HAS_COMPLEX_REAL_DERIVATIVE_AT_GEN, .. } := BRZL
  let { CONTINUOUS_CONTINUOUS_WITHINREAL, HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL,
        REAL_CONTINUOUS_CONTINUOUS1, REAL_CONTINUOUS_CONTINUOUS_ATREAL,
        REAL_DIFFERENTIABLE_ATREAL_WITHIN, .. } := BRZN
  let { HAS_COMPLEX_DERIVATIVE_CEXP, .. } := D.tsa
  let { CX_EXP, .. } := D.tsb
  let { CX_COS, CX_SIN, HAS_COMPLEX_DERIVATIVE_CCOS, HAS_COMPLEX_DERIVATIVE_CSIN,
        .. } := D.tsc
  let { CX_TAN, HAS_COMPLEX_DERIVATIVE_CTAN, .. } := D.tsk
  let { CX_LOG, HAS_COMPLEX_DERIVATIVE_CLOG, .. } := D.tsm
  let { HAS_COMPLEX_DERIVATIVE_CSQRT, .. } := D.tsn
  let { HAS_COMPLEX_DERIVATIVE_CATN, .. } := D.tsp
  let { CX_ATN, .. } := D.tsq
  let { HAS_COMPLEX_DERIVATIVE_CASN, .. } := D.tss
  let { HAS_COMPLEX_DERIVATIVE_CACS, .. } := D.tst
  let { COS_ASN, CX_ASN, .. } := D.tsv
  let { CX_ACS, SIN_ACS, .. } := D.tsw
  let { CONTINUOUS_AT_SQRT, CONTINUOUS_AT_SQRT_COMPOSE, CONTINUOUS_WITHIN_SQRT_COMPOSE,
        .. } := D.qtopology
  let { HAS_COMPLEX_DERIVATIVE_AT_WITHIN, .. } := D.ts.kne
  let { CX_ADD, CX_INJ, CX_INV, CX_MUL, CX_NEG, CX_POW, IM_CX, RE_CX, .. } := D.ts.cn.cxc
  let { CX_SQRT, .. } := D.ts.cn.cxh
  let { ASM_REAL_ARITH_TAC, MESON_TAC, .. } := D.ts.cn.cx.cvx
  let { EQ_IMP, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, .. } := D.ts.cn.cx.cvx.core2
  let { IN_UNIV, REAL_ABS_NUM, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_SUB_LT, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  -- @@SCOPE END

  let HAS_REAL_DERIVATIVE_EXP ← prove
   r"!x. (exp has_real_derivative exp(x)) (atreal x)"
   (GEN_TAC THEN MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT THEN
    EXISTS_TAC (← q r"cexp") THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
                  HAS_COMPLEX_DERIVATIVE_CEXP, CX_EXP])

  let REAL_DIFFERENTIABLE_AT_EXP ← prove
   r"!x. exp real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_EXP])

  let REAL_DIFFERENTIABLE_WITHIN_EXP ← prove
   r"!s x. exp real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ATREAL_WITHIN,
               REAL_DIFFERENTIABLE_AT_EXP])

  let REAL_CONTINUOUS_AT_EXP ← prove
   r"!x. exp real_continuous (atreal x)"
   (MESON_TAC [HAS_REAL_DERIVATIVE_EXP,
               HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL])

  let REAL_CONTINUOUS_WITHIN_EXP ← prove
   r"!s x. exp real_continuous (atreal x within s)"
   (MESON_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL,
               REAL_CONTINUOUS_AT_EXP])

  let REAL_CONTINUOUS_ON_EXP ← prove
   r"!s. exp real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHIN_EXP])

  let HAS_REAL_DERIVATIVE_SIN ← prove
   r"!x. (sin has_real_derivative cos(x)) (atreal x)"
   (GEN_TAC THEN MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT THEN
    EXISTS_TAC (← q r"csin") THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
                  HAS_COMPLEX_DERIVATIVE_CSIN, CX_SIN, CX_COS])

  let REAL_DIFFERENTIABLE_AT_SIN ← prove
   r"!x. sin real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_SIN])

  let REAL_DIFFERENTIABLE_WITHIN_SIN ← prove
   r"!s x. sin real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ATREAL_WITHIN,
               REAL_DIFFERENTIABLE_AT_SIN])

  let REAL_CONTINUOUS_AT_SIN ← prove
   r"!x. sin real_continuous (atreal x)"
   (MESON_TAC [HAS_REAL_DERIVATIVE_SIN,
               HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL])

  let REAL_CONTINUOUS_WITHIN_SIN ← prove
   r"!s x. sin real_continuous (atreal x within s)"
   (MESON_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL,
               REAL_CONTINUOUS_AT_SIN])

  let REAL_CONTINUOUS_ON_SIN ← prove
   r"!s. sin real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHIN_SIN])

  let HAS_REAL_DERIVATIVE_COS ← prove
   r"!x. (cos has_real_derivative --sin(x)) (atreal x)"
   (GEN_TAC THEN MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT THEN
    EXISTS_TAC (← q r"ccos") THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
                  HAS_COMPLEX_DERIVATIVE_CCOS, CX_SIN, CX_COS, CX_NEG])

  let REAL_DIFFERENTIABLE_AT_COS ← prove
   r"!x. cos real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_COS])

  let REAL_DIFFERENTIABLE_WITHIN_COS ← prove
   r"!s x. cos real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ATREAL_WITHIN,
               REAL_DIFFERENTIABLE_AT_COS])

  let REAL_CONTINUOUS_AT_COS ← prove
   r"!x. cos real_continuous (atreal x)"
   (MESON_TAC [HAS_REAL_DERIVATIVE_COS,
               HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL])

  let REAL_CONTINUOUS_WITHIN_COS ← prove
   r"!s x. cos real_continuous (atreal x within s)"
   (MESON_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL,
               REAL_CONTINUOUS_AT_COS])

  let REAL_CONTINUOUS_ON_COS ← prove
   r"!s. cos real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
                 REAL_CONTINUOUS_WITHIN_COS])

  let HAS_REAL_DERIVATIVE_TAN ← prove
   r"!x. ~(cos x = &0)
       ==> (tan has_real_derivative inv(cos(x) pow 2)) (atreal x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT THEN
    EXISTS_TAC (← q r"ctan") THEN REWRITE_TAC [CX_INV, CX_POW, CX_COS] THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
                  HAS_COMPLEX_DERIVATIVE_CTAN, ← GSYM CX_COS, CX_INJ, CX_TAN])

  let REAL_DIFFERENTIABLE_AT_TAN ← prove
   r"!x. ~(cos x = &0) ==> tan real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_TAN])

  let REAL_DIFFERENTIABLE_WITHIN_TAN ← prove
   r"!s x. ~(cos x = &0) ==> tan real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ATREAL_WITHIN,
               REAL_DIFFERENTIABLE_AT_TAN])

  let REAL_CONTINUOUS_AT_TAN ← prove
   r"!x. ~(cos x = &0) ==> tan real_continuous (atreal x)"
   (MESON_TAC [HAS_REAL_DERIVATIVE_TAN,
               HAS_REAL_DERIVATIVE_IMP_CONTINUOUS_ATREAL])

  let REAL_CONTINUOUS_WITHIN_TAN ← prove
   r"!s x. ~(cos x = &0) ==> tan real_continuous (atreal x within s)"
   (MESON_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL,
               REAL_CONTINUOUS_AT_TAN])

  let REAL_CONTINUOUS_ON_TAN ← prove
   r"!s. (!x. x IN s ==> ~(cos x = &0)) ==> tan real_continuous_on s"
   (MESON_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
               REAL_CONTINUOUS_WITHIN_TAN])

  let HAS_REAL_DERIVATIVE_LOG ← prove
   r"!x. &0 < x ==> (log has_real_derivative inv(x)) (atreal x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_REAL_DERIVATIVE_AT_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"clog", ← q r"x:real"] THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THENL
     [REWRITE_TAC [CX_INV] THEN MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_AT_WITHIN THEN
      MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_CLOG THEN ASM_REWRITE_TAC [RE_CX],
      MATCH_MP_TAC (← GSYM CX_LOG) THEN ASM_REAL_ARITH_TAC])

  let REAL_DIFFERENTIABLE_AT_LOG ← prove
   r"!x. &0 < x ==> log real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_LOG])

  let REAL_DIFFERENTIABLE_WITHIN_LOG ← prove
   r"!s x. &0 < x ==> log real_differentiable (atreal x within s)"
   (MESON_TAC [REAL_DIFFERENTIABLE_ATREAL_WITHIN,
