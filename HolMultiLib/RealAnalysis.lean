  let { CLOSED_CBALL, CLOSED_INTER, .. } := D.ts.cn.cx.cvx.top1
  let { IN_CBALL, .. } := D.ts.cn.cx.cvx.top4
  -- @@SCOPE END

  let DIFFERENTIABLE_NORM_AT ← prove
   r"!a:real^N. ~(a = vec 0) ==> (\x. lift(norm x)) differentiable (at a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [vector_norm] THEN
    SUBGOAL_THEN
     (← q r"(\x:real^N. lift(sqrt(x dot x))) =
      (lift o sqrt o drop) o (\x. lift(x dot x))")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF, LIFT_DROP], ALL_TAC] THEN
    MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
    REWRITE_TAC [DIFFERENTIABLE_SQNORM_AT, ← GSYM NORM_POW_2] THEN
    MP_TAC (← ISPEC (← q r"norm(a:real^N) pow 2") REAL_DIFFERENTIABLE_AT_SQRT) THEN
    ASM_SIMP_TAC [REAL_POW_LT, NORM_POS_LT, REAL_DIFFERENTIABLE_AT])

  let DIFFERENTIABLE_ON_NORM ← prove
   r"!s:real^N->bool. ~(vec 0 IN s) ==> (\x. lift(norm x)) differentiable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC DIFFERENTIABLE_NORM_AT THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_WITHIN_ASN_STRONG ← prove
   r"!x. asn real_continuous (atreal x within {t | abs(t) <= &1})"
   (GEN_TAC THEN REWRITE_TAC [REAL_COMPLEX_CONTINUOUS_WITHINREAL] THEN
    ASM_CASES_TAC (← q r"x IN {t | abs(t) <= &1}") THENL
     [MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN THEN
      MAP_EVERY EXISTS_TAC [← q r"casn", ← q r"&1"] THEN
      REWRITE_TAC [IMAGE_CX, IN_ELIM_THM, CONTINUOUS_WITHIN_CASN_REAL, REAL_LT_01,
       ← SET_RULE (← q r"real INTER {z | real z /\ P z} = {z | real z /\ P z}")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM]) THEN
      ASM_REWRITE_TAC [REAL_CX, RE_CX, IMP_CONJ, FORALL_REAL, o_THM] THEN
      SIMP_TAC [CX_ASN],
      MATCH_MP_TAC CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"real INTER IMAGE Cx {t | abs t <= &1} =
                      real INTER cball(Cx(&0),&1)")
         (fun th => SIMP_TAC [th, CLOSED_INTER, CLOSED_REAL, CLOSED_CBALL]) THEN
        REWRITE_TAC [EXTENSION, IMAGE_CX, IN_ELIM_THM, IN_CBALL, IN_INTER] THEN
        REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG, IN] THEN
        MESON_TAC [REAL_NORM],
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x y. f x = f y ==> x = y) /\ ~(x IN s)
          ==> ~(f x IN t INTER IMAGE f s)")) THEN
        ASM_REWRITE_TAC [CX_INJ]]])

  let REAL_CONTINUOUS_ON_ASN ← prove
   r"!s. (!x. x IN s ==> abs(x) <= &1) ==> asn real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_WITHINREAL_SUBSET THEN
    EXISTS_TAC (← q r"{x | abs(x) <= &1}") THEN
    ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM, REAL_CONTINUOUS_WITHIN_ASN_STRONG])

  let REAL_CONTINUOUS_WITHIN_ACS_STRONG ← prove
   r"!x. acs real_continuous (atreal x within {t | abs(t) <= &1})"
   (GEN_TAC THEN REWRITE_TAC [REAL_COMPLEX_CONTINUOUS_WITHINREAL] THEN
    ASM_CASES_TAC (← q r"x IN {t | abs(t) <= &1}") THENL
     [MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN THEN
      MAP_EVERY EXISTS_TAC [← q r"cacs", ← q r"&1"] THEN
      REWRITE_TAC [IMAGE_CX, IN_ELIM_THM, CONTINUOUS_WITHIN_CACS_REAL, REAL_LT_01,
       ← SET_RULE (← q r"real INTER {z | real z /\ P z} = {z | real z /\ P z}")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM]) THEN
      ASM_REWRITE_TAC [REAL_CX, RE_CX, IMP_CONJ, FORALL_REAL, o_THM] THEN
      SIMP_TAC [CX_ACS],
      MATCH_MP_TAC CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"real INTER IMAGE Cx {t | abs t <= &1} =
                      real INTER cball(Cx(&0),&1)")
         (fun th => SIMP_TAC [th, CLOSED_INTER, CLOSED_REAL, CLOSED_CBALL]) THEN
        REWRITE_TAC [EXTENSION, IMAGE_CX, IN_ELIM_THM, IN_CBALL, IN_INTER] THEN
        REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG, IN] THEN
        MESON_TAC [REAL_NORM],
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x y. f x = f y ==> x = y) /\ ~(x IN s)
          ==> ~(f x IN t INTER IMAGE f s)")) THEN
        ASM_REWRITE_TAC [CX_INJ]]])

  let REAL_CONTINUOUS_ON_ACS ← prove
   r"!s. (!x. x IN s ==> abs(x) <= &1) ==> acs real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_WITHINREAL_SUBSET THEN
    EXISTS_TAC (← q r"{x | abs(x) <= &1}") THEN
    ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM, REAL_CONTINUOUS_WITHIN_ACS_STRONG])

  let real_differentiation_theorems ← IO.mkRef ([] : List thm)

  let add_real_differentiation_theorems ← do
    let ETA_THM ← prove
     r"(f has_real_derivative f') net <=>
       ((\x. f x) has_real_derivative f') net"
     (REWRITE_TAC [ETA_AX])
    let ETA_TWEAK (th : thm) : ExceptT String IO thm := do
      PURE_REWRITE_RULE [IMP_CONJ]
        (← GEN_REWRITE_RULE (LAND_CONV o ONCE_DEPTH_CONV) [ETA_THM] (← SPEC_ALL th))
    pure (fun (l : List thm) => do
      let l' ← l.mapM ETA_TWEAK
      real_differentiation_theorems.modify (fun c => c ++ l'))

  add_real_differentiation_theorems
   ([HAS_REAL_DERIVATIVE_LMUL_WITHIN, HAS_REAL_DERIVATIVE_LMUL_ATREAL,
     HAS_REAL_DERIVATIVE_RMUL_WITHIN, HAS_REAL_DERIVATIVE_RMUL_ATREAL,
     HAS_REAL_DERIVATIVE_CDIV_WITHIN, HAS_REAL_DERIVATIVE_CDIV_ATREAL,
     HAS_REAL_DERIVATIVE_ID,
     HAS_REAL_DERIVATIVE_CONST,
     HAS_REAL_DERIVATIVE_NEG,
     HAS_REAL_DERIVATIVE_ADD,
     HAS_REAL_DERIVATIVE_SUB,
     HAS_REAL_DERIVATIVE_MUL_WITHIN, HAS_REAL_DERIVATIVE_MUL_ATREAL,
     HAS_REAL_DERIVATIVE_DIV_WITHIN, HAS_REAL_DERIVATIVE_DIV_ATREAL,
     HAS_REAL_DERIVATIVE_POW_WITHIN, HAS_REAL_DERIVATIVE_POW_ATREAL,
     HAS_REAL_DERIVATIVE_INV_WITHIN, HAS_REAL_DERIVATIVE_INV_ATREAL] ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN_UNIV
                HAS_REAL_DERIVATIVE_EXP))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN_UNIV
                HAS_REAL_DERIVATIVE_SIN))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN_UNIV
                HAS_REAL_DERIVATIVE_COS))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                HAS_REAL_DERIVATIVE_TAN))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                HAS_REAL_DERIVATIVE_LOG))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                HAS_REAL_DERIVATIVE_SQRT))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN_UNIV
                HAS_REAL_DERIVATIVE_ATN))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                HAS_REAL_DERIVATIVE_ASN))) ++
    (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                HAS_REAL_DERIVATIVE_ACS))))

  -- `partfn tm = let l,r = dest_comb tm in mk_pair(lhand l,r)`; pair.ml's
  -- `mk_pair` looks up `,` in the constant table, which is read once here.
  let REAL_DIFF_CONV : term → ExceptT String IO thm ← do
    let pairc ← ExceptT.mk (mk_const "," [])
    let pat ← q r"(f has_real_derivative f') net"
    let partfn (tm : term) : Except String term := do
      let (l, r) ← dest_comb tm
      let fl ← lhand l
      mk_comb (← mk_comb (inst [(type_of fl, aty), (type_of r, bty)] pairc) fl) r
    let is_deriv (t : term) : ExceptT String IO Bool :=
      tryWith (do let _ ← term_match [] pat t; pure true) (pure false)
    pure (realDiffConvGo real_differentiation_theorems partfn is_deriv)

  let REAL_DIFF_TAC : tactic ← do
    let pth ← MESON []
     (← q r"(f has_real_derivative f') net
      ==> f' = g'
          ==> (f has_real_derivative g') net")
    pure (W (fun (_asl, w) => tactic_of do
      let th ← MATCH_MP pth (← REAL_DIFF_CONV w)
      pure (MATCH_MP_TAC (← repeatRule (GEN_REWRITE_RULE I [IMP_IMP]) (← DISCH_ALL th)))))

  let REAL_DIFFERENTIABLE_TAC : tactic :=
    let DISCH_FIRST (th : thm) : ExceptT String IO thm :=
      match hyp th with
      | h :: _ => DISCH h th
      | [] => throw "hd"
    GEN_REWRITE_TAC I [real_differentiable] THEN
    W (fun (_asl, w) => tactic_of do
          let th ← REAL_DIFF_CONV (← liftExcept (HolCore.Basics.dest_exists w)).2
          let f' ← liftExcept (do rand (← rator (concl th)))
          pure (EXISTS_TAC f' THEN
            (if (hyp th).isEmpty then MATCH_ACCEPT_TAC th else
             tactic_of do
               let th' ← repeatRule (fun x => do GEN_REWRITE_RULE I [IMP_IMP] (← DISCH_FIRST x))
                            (← DISCH_FIRST th)
               pure (MATCH_MP_TAC th'))))

  pure { DIFFERENTIABLE_NORM_AT, DIFFERENTIABLE_ON_NORM, REAL_CONTINUOUS_WITHIN_ASN_STRONG,
         REAL_CONTINUOUS_ON_ASN, REAL_CONTINUOUS_WITHIN_ACS_STRONG, REAL_CONTINUOUS_ON_ACS,
         real_differentiation_theorems, add_real_differentiation_theorems,
         REAL_DIFF_CONV, REAL_DIFF_TAC, REAL_DIFFERENTIABLE_TAC }
/- ------------------------------------------------------------------------- -/
/- Some real limits involving transcendentals; analytic results for rpow.   -/
/- (realanalysis.ml 4429-4614)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZR where
  REALLIM_1_OVER_N_OFFSET : thm
  REALLIM_1_OVER_N : thm
  REALLIM_1_OVER_POW : thm
  REALLIM_LOG_OVER_N : thm
  REALLIM_1_OVER_LOG : thm
  REALLIM_POWN : thm
  REAL_POW_EVENTUALLY_LT : thm
  REALLIM_X_TIMES_LOG : thm
  REALLIM_ROOT_REFL : thm
  REALLIM_SIN_OVER_X : thm
  REALLIM_RPOW_COMPOSE : thm
  REAL_CONTINUOUS_RPOW_COMPOSE_WITHIN : thm
  HAS_REAL_DERIVATIVE_RPOW : thm
  HAS_REAL_DERIVATIVE_RPOW_RIGHT : thm
  REAL_DIFFERENTIABLE_AT_RPOW : thm
  REAL_DIFFERENTIABLE_AT_RPOW_RIGHT : thm
  REAL_CONTINUOUS_AT_RPOW : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZR [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZF : RZF) (BRZG : RZG) (BRZH : RZH) (BRZJ : RZJ) (BRZK : RZK) (BRZN : RZN) (BRZO : RZO) (BRZP : RZP) (BRZQ : RZQ) : ExceptT String IO RZR := do
  -- @@SCOPE BEGIN
  let { REALLIM_COMPLEX, REALLIM_MUL, REALLIM_TRANSFORM_EVENTUALLY, tendsto_real,
        .. } := BRZA
  let { REALLIM_NULL_COMPARISON, .. } := BRZB
  let { REALLIM_WITHINREAL, .. } := BRZF
  let { LIM_ATREAL_ATCOMPLEX, .. } := BRZG
  let { real_continuous_atreal, REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_WITHIN, .. } := BRZH
  let { REALLIM_REAL_CONTINUOUS_FUNCTION, .. } := BRZJ
  let { real_differentiable, .. } := BRZK
  let { HAS_REAL_DERIVATIVE_CHAIN, HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL,
        REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL, .. } := BRZN
  let { REAL_DIFFERENTIABLE_TRANSFORM_ATREAL, .. } := BRZO
  let { REAL_CONTINUOUS_AT_EXP, REAL_CONTINUOUS_AT_LOG, .. } := BRZP
  let { add_real_differentiation_theorems, REAL_DIFF_TAC, REAL_DIFFERENTIABLE_TAC,
        .. } := BRZQ
  let { REAL_EXP_0, REAL_EXP_SUB, .. } := D.tsb
  let { CX_SIN, .. } := D.tsc
  let { EXP_LOG, .. } := D.tsd
  let { CX_LOG, .. } := D.tsm
  let { LIM_1_OVER_LOG, LIM_CSIN_OVER_X, LIM_INV_N, LIM_INV_N_OFFSET, LIM_LOG_OVER_N,
        LIM_POWN, LIM_Z_TIMES_CLOG, .. } := D.tsx
  let { ROOT_EXP_LOG, .. } := D.tsaa
  let { REAL_ABS_RPOW, rpow, RPOW_LT2, RPOW_POS_LT, RPOW_POW, RPOW_RPOW, RPOW_ZERO,
        .. } := D.tsab
  let { complex_div, .. } := D.ts.cn.cxa
  let { COMPLEX_MUL_LID, COMPLEX_SUB_RZERO, .. } := D.ts.cn.cxb
  let { COMPLEX_NORM_CX, CX_ADD, CX_DIV, CX_INV, CX_POW, RE_CX, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_MUL, .. } := D.ts.cn.cxf
  let { FORALL_REAL, .. } := D.ts.cn.cxi
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, REAL_POW_MONO, .. } := D.ts.cn.cx.cpx
  let { FORALL_AND_THM, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IN, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_1, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, REAL_ABS_INV,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ARCH_POW_INV, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_INV2, REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LTE_TRANS,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POW_LT,
        REAL_SUB_RDISTRIB, REAL_SUB_RZERO, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_pow, SWAP_EXISTS_THM, SWAP_FORALL_THM, .. } := D.ts.cn.cx.cvx.core6
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { LIM_WITHIN, .. } := D.ts.cn.cx.cvx.top4
  let { REAL_POW_MONO_INV, .. } := D.ts.cn.ms.ig.dv.qsession
  let { LIM_AT, .. } := D.ts.cn.ms.ig.dv.qtopology1
  let { LIM_TRANSFORM_EVENTUALLY, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { REAL_ABS_POW, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let REALLIM_1_OVER_N_OFFSET ← prove
   r"!a. ((\n. inv(&n + a)) ---> &0) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_INV, CX_ADD, LIM_INV_N_OFFSET])

  let REALLIM_1_OVER_N ← prove
   r"((\n. inv(&n)) ---> &0) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_INV, LIM_INV_N])

  let REALLIM_1_OVER_POW ← prove
   r"!k. 1 <= k ==> ((\n. inv(&n pow k)) ---> &0) sequentially"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REALLIM_NULL_COMPARISON THEN
    EXISTS_TAC (← q r"\n. inv(&n pow 1)") THEN CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_ABS_INV, REAL_ABS_POW] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN REWRITE_TAC [REAL_ABS_NUM] THEN
      CONJ_TAC THENL [MATCH_MP_TAC REAL_POW_LT, MATCH_MP_TAC REAL_POW_MONO] THEN
      ASM_SIMP_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_LT, LE_1],
      REWRITE_TAC [REAL_POW_1, REALLIM_1_OVER_N]])

  let REALLIM_LOG_OVER_N ← prove
   r"((\n. log(&n) / &n) ---> &0) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX] THEN MP_TAC LIM_LOG_OVER_N THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
    SIMP_TAC [o_DEF, CX_DIV, CX_LOG, REAL_OF_NUM_LT,
              ← ARITH_RULE (← q r"1 <= n ==> 0 < n")])

  let REALLIM_1_OVER_LOG ← prove
   r"((\n. inv(log(&n))) ---> &0) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX] THEN MP_TAC LIM_1_OVER_LOG THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    REWRITE_TAC [o_DEF, complex_div, COMPLEX_MUL_LID, CX_INV] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
    SIMP_TAC [CX_LOG, REAL_OF_NUM_LT, ← ARITH_RULE (← q r"1 <= n ==> 0 < n")])

  let REALLIM_POWN ← prove
   r"!z. abs(z) < &1 ==> ((\n. z pow n) ---> &0) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_POW] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_POWN THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_CX])

  let REAL_POW_EVENTUALLY_LT ← prove
   r"!(x:real) (e:real). &0 <= x /\ x < &1 /\ &0 < e
         ==> eventually (\n. x pow n < e) sequentially"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    MP_TAC (← ISPECL [(← q r"x:real"), (← q r"e:real")] REAL_ARCH_POW_INV) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN
    DISCH_TAC THEN TRANS_TAC REAL_LET_TRANS (← q r"(x:real) pow N") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_POW_MONO_INV THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE])

  let REALLIM_X_TIMES_LOG ← prove
   r"((\x. x * log x) ---> &0) (atreal(&0) within {x | &0 <= x})"
   (MP_TAC LIM_Z_TIMES_CLOG THEN
    REWRITE_TAC [REALLIM_WITHINREAL, LIM_AT] THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_SUB_RZERO, dist, COMPLEX_SUB_RZERO] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
    ASM_CASES_TAC (← q r"&0 < d") THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN
    ASM_CASES_TAC (← q r"x = &0") THENL [ASM_REAL_ARITH_TAC, STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < x") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"Cx x")) THEN
    ASM_SIMP_TAC [COMPLEX_NORM_MUL, ← GSYM CX_LOG, COMPLEX_NORM_CX] THEN
    REWRITE_TAC [REAL_ABS_MUL])

  let REALLIM_ROOT_REFL ← prove
   r"((\n. root n (&n)) ---> &1) sequentially"
   (MATCH_MP_TAC REALLIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. exp(log(&n) / &n)") THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN CONJ_TAC THENL
    [EXISTS_TAC (← q r"1") THEN INTRO_TAC "!n; n" THEN
     MATCH_MP_TAC (← GSYM ROOT_EXP_LOG) THEN
     ASM_REWRITE_TAC [REAL_OF_NUM_LT] THEN ASM_ARITH_TAC,
     REWRITE_TAC [← GSYM REAL_EXP_0] THEN
     MATCH_MP_TAC REALLIM_REAL_CONTINUOUS_FUNCTION THEN
     REWRITE_TAC [REAL_CONTINUOUS_AT_EXP, REALLIM_LOG_OVER_N]])

  let REALLIM_SIN_OVER_X ← prove
   r"((\x. sin x / x) ---> &1) (atreal (&0))"
   (REWRITE_TAC [REALLIM_COMPLEX, LIM_ATREAL_ATCOMPLEX, o_DEF] THEN
    MP_TAC LIM_CSIN_OVER_X THEN REWRITE_TAC [LIM_AT, LIM_WITHIN, IN] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    SIMP_TAC [IMP_CONJ, FORALL_REAL, CX_SIN, CX_DIV, RE_CX])

  -- Analytic results for real power function.

  let REALLIM_RPOW_COMPOSE ← prove
   r"!net:A net f g l m.
        (f ---> l) net /\ (g ---> m) net /\ &0 < l
        ==> ((\x. (f x) rpow (g x)) ---> l rpow m) net"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REALLIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\x:A. exp(g x * log(f x))") THEN CONJ_TAC THENL
     [MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"\x:A. &0 < f x") THEN SIMP_TAC [rpow] THEN
      UNDISCH_TAC (← q r"(f ---> l) (net:A net)") THEN
      REWRITE_TAC [tendsto_real] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"l:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      REAL_ARITH_TAC,
      ASM_REWRITE_TAC [rpow] THEN
      MATCH_MP_TAC (← SPEC (← q r"exp") REALLIM_REAL_CONTINUOUS_FUNCTION) THEN
      REWRITE_TAC [REAL_CONTINUOUS_AT_EXP] THEN
      MATCH_MP_TAC REALLIM_MUL THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SPEC (← q r"log") REALLIM_REAL_CONTINUOUS_FUNCTION) THEN
      ASM_SIMP_TAC [REAL_CONTINUOUS_AT_LOG]])

  let REAL_CONTINUOUS_RPOW_COMPOSE_WITHIN ← prove
   r"!f g s a:real^N.
        f real_continuous (at a within s) /\
        g real_continuous (at a within s) /\
        &0 < f a
        ==> (\x. (f x) rpow (g x)) real_continuous (at a within s)"
   (REWRITE_TAC [REAL_CONTINUOUS_WITHIN, REALLIM_RPOW_COMPOSE])

  let HAS_REAL_DERIVATIVE_RPOW ← prove
   r"!x y.
    &0 < x
    ==> ((\x. x rpow y) has_real_derivative y * x rpow (y - &1)) (atreal x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL THEN
    EXISTS_TAC (← q r"\x. exp(y * log x)") THEN EXISTS_TAC (← q r"x:real") THEN
    ASM_SIMP_TAC [rpow, ← REAL_ARITH
      (← q r"&0 < x ==> (abs(y - x) < x <=> &0 < y /\ y < &2 * x)")] THEN
    REAL_DIFF_TAC THEN
    ASM_SIMP_TAC [REAL_SUB_RDISTRIB, REAL_EXP_SUB, REAL_MUL_LID, EXP_LOG] THEN
    REAL_ARITH_TAC)

  add_real_differentiation_theorems
   (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
     (← GEN (← q r"y:real") (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
      (← SPEC (← q r"y:real")
        (← ONCE_REWRITE_RULE [SWAP_FORALL_THM] HAS_REAL_DERIVATIVE_RPOW))))))

  let HAS_REAL_DERIVATIVE_RPOW_RIGHT ← prove
   r"!a x. &0 < a
         ==> ((\x. a rpow x) has_real_derivative log(a) * a rpow x)
              (atreal x)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [rpow] THEN
    REAL_DIFF_TAC THEN REAL_ARITH_TAC)

  add_real_differentiation_theorems
   (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
      (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN
                (← SPEC (← q r"a:real") HAS_REAL_DERIVATIVE_RPOW_RIGHT))))

  let REAL_DIFFERENTIABLE_AT_RPOW ← prove
   r"!x y. ~(x = &0) ==> (\x. x rpow y) real_differentiable atreal x"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"~(x = &0) <=> &0 < x \/ &0 < --x")] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_DIFFERENTIABLE_TRANSFORM_ATREAL THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    EXISTS_TAC (← q r"abs x") THENL
     [EXISTS_TAC (← q r"\x. exp(y * log x)") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x ==> &0 < abs x")] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"&0 < z") (fun th => REWRITE_TAC [rpow, th]) THEN
        ASM_REAL_ARITH_TAC,
        REAL_DIFFERENTIABLE_TAC THEN ASM_REAL_ARITH_TAC],
      ASM_CASES_TAC (← q r"?m n. ODD m /\ ODD n /\ abs y = &m / &n") THENL
       [EXISTS_TAC (← q r"\x. --(exp(y * log(--x)))"),
        EXISTS_TAC (← q r"\x. exp(y * log(--x))")] THEN
      (ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < --x ==> &0 < abs x")] THEN CONJ_TAC THENL
        [X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
         SUBGOAL_THEN (← q r"~(&0 < z) /\ ~(z = &0)")
           (fun th => ASM_REWRITE_TAC [rpow, th]) THEN
         ASM_REAL_ARITH_TAC,
         REAL_DIFFERENTIABLE_TAC THEN ASM_REAL_ARITH_TAC])])

  let REAL_DIFFERENTIABLE_AT_RPOW_RIGHT ← prove
   r"!a x. &0 < a ==> (\x. a rpow x) real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_RPOW_RIGHT])

  let REAL_CONTINUOUS_AT_RPOW ← prove
   r"!x y. (x = &0 ==> &0 <= y)
         ==> (\x. x rpow y) real_continuous (atreal x)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"y = &0") THEN
    ASM_REWRITE_TAC [RPOW_POW, real_pow, REAL_CONTINUOUS_CONST] THEN
    ASM_CASES_TAC (← q r"x = &0") THENL
     [ASM_REWRITE_TAC [real_continuous_atreal, RPOW_ZERO] THEN
      REWRITE_TAC [REAL_SUB_RZERO, REAL_ABS_RPOW] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"e rpow inv(y)") THEN
      ASM_SIMP_TAC [RPOW_POS_LT] THEN X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LTE_TRANS THEN
      EXISTS_TAC (← q r"e rpow inv y rpow y") THEN CONJ_TAC THENL
       [MATCH_MP_TAC RPOW_LT2 THEN ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [RPOW_RPOW, REAL_LT_IMP_LE, REAL_MUL_LINV] THEN
        REWRITE_TAC [RPOW_POW, REAL_POW_1, REAL_LE_REFL]],
      ASM_SIMP_TAC [REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
                    REAL_DIFFERENTIABLE_AT_RPOW]])

  pure { REALLIM_1_OVER_N_OFFSET, REALLIM_1_OVER_N, REALLIM_1_OVER_POW, REALLIM_LOG_OVER_N,
         REALLIM_1_OVER_LOG, REALLIM_POWN, REAL_POW_EVENTUALLY_LT, REALLIM_X_TIMES_LOG, REALLIM_ROOT_REFL,
         REALLIM_SIN_OVER_X, REALLIM_RPOW_COMPOSE, REAL_CONTINUOUS_RPOW_COMPOSE_WITHIN,
         HAS_REAL_DERIVATIVE_RPOW, HAS_REAL_DERIVATIVE_RPOW_RIGHT,
         REAL_DIFFERENTIABLE_AT_RPOW, REAL_DIFFERENTIABLE_AT_RPOW_RIGHT,
         REAL_CONTINUOUS_AT_RPOW }
/- ------------------------------------------------------------------------- -/
/- More rpow; frac; polynomials; Intermediate Value Theorem.                -/
/- (realanalysis.ml 4615-4788)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZS where
  REAL_CONTINUOUS_WITHIN_RPOW : thm
  REAL_CONTINUOUS_ON_RPOW : thm
  REAL_CONTINUOUS_AT_RPOW_RIGHT : thm
  REALLIM_RPOW : thm
  REALLIM_NULL_POW_EQ : thm
  LIM_NULL_COMPLEX_POW_EQ : thm
  LIM_NULL_RPOW : thm
  HAS_REAL_DERIVATIVE_FRAC : thm
  REAL_DIFFERENTIABLE_FRAC : thm
  REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_ATREAL : thm
  REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_WITHIN : thm
  REAL_DIFFERENTIABLE_ON_POLYNOMIAL_FUNCTION : thm
  REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_ATREAL : thm
  REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_WITHIN : thm
  REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION : thm
  REAL_IVT_INCREASING : thm
  REAL_IVT_DECREASING : thm
  IS_REALINTERVAL_CONTINUOUS_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZS [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZF : RZF) (BRZH : RZH) (BRZI : RZI) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZM : RZM) (BRZN : RZN) (BRZO : RZO) (BRZQ : RZQ) (BRZR : RZR) : ExceptT String IO RZS := do
  -- @@SCOPE BEGIN
  let { REAL_TENDSTO, REALLIM_NULL_ABS, REALLIM_NULL_POW, .. } := BRZA
  let { WITHINREAL_UNIV, .. } := BRZF
  let { REAL_CONTINUOUS_ABS, REAL_CONTINUOUS_ATREAL_WITHINREAL, REAL_CONTINUOUS_WITHIN_ID,
        .. } := BRZH
  let { REAL_CONTINUOUS_WITHINREAL_COMPOSE, .. } := BRZI
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        REALLIM_REAL_CONTINUOUS_FUNCTION, .. } := BRZJ
  let { real_differentiable, .. } := BRZK
  let { REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, .. } := BRZL
  let { IS_REALINTERVAL_CONNECTED, .. } := BRZM
  let { HAS_REAL_DERIVATIVE_CHAIN, HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL,
        REAL_CONTINUOUS_CONTINUOUS_ATREAL, REAL_DIFFERENTIABLE_ATREAL_WITHIN,
        REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
        REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL, .. } := BRZN
  let { REAL_DIFFERENTIABLE_ADD, REAL_DIFFERENTIABLE_CONST, REAL_DIFFERENTIABLE_ID,
        REAL_DIFFERENTIABLE_MUL_ATREAL, .. } := BRZO
  let { add_real_differentiation_theorems, REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_CONTINUOUS_AT_RPOW, REAL_DIFFERENTIABLE_AT_RPOW_RIGHT, .. } := BRZR
  let { REAL_ABS_RPOW, RPOW_POW, RPOW_RPOW, RPOW_ZERO, .. } := D.tsab
  let { IMAGE_LIFT_DROP, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { POLYNOMIAL_FUNCTION_INDUCT, .. } := D.qsession
  let { FRAC_UNIQUE, REAL_FRAC_POS_LT, .. } := D.qfloor
  let { COMPLEX_VEC_0, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_POW, .. } := D.ts.cn.cxf
  let { IVT_DECREASING_COMPONENT_ON_1, IVT_INCREASING_COMPONENT_ON_1,
        .. } := D.ts.cn.ms.qconvex
  let { FLOOR_FRAC, .. } := D.ts.cn.ms.qfloor
  let { LIM_CONTINUOUS_FUNCTION, .. } := D.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { FLOOR, .. } := D.ts.cn.ms.ig.qfloor
  let { DIMINDEX_1, ETA_AX, EXISTS_IN_IMAGE, FORALL_AND_THM, .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_o, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { LE_REFL, REAL_ABS_NUM, REAL_ABS_POS, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_INV_EQ_0, REAL_LE_INV_EQ, REAL_LT_IMP_NZ, REAL_LT_MIN,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RINV, REAL_OF_NUM_EQ, REAL_POS, RIGHT_FORALL_IMP_THM,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := D.ts.cn.cx.cvx.top2
  let { LIM_NULL_NORM, .. } := D.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let REAL_CONTINUOUS_WITHIN_RPOW ← prove
   r"!s x y. (x = &0 ==> &0 <= y)
           ==> (\x. x rpow y) real_continuous (atreal x within s)"
   (MESON_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL,
               REAL_CONTINUOUS_AT_RPOW])

  let REAL_CONTINUOUS_ON_RPOW ← prove
   r"!s y. (&0 IN s ==> &0 <= y) ==> (\x. x rpow y) real_continuous_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_WITHIN_RPOW THEN
    ASM_MESON_TAC [])

  let REAL_CONTINUOUS_AT_RPOW_RIGHT ← prove
   r"!a x. &0 < a ==> (\x. a rpow x) real_continuous (atreal x)"
   (SIMP_TAC [REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
              REAL_DIFFERENTIABLE_AT_RPOW_RIGHT])

  let REALLIM_RPOW ← prove
   r"!net f l n.
        (f ---> l) net /\ (l = &0 ==> &0 <= n)
        ==> ((\x. f x rpow n) ---> l rpow n) net"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC
    (← REWRITE_RULE [] (← ISPEC (← q r"\x. x rpow n") REALLIM_REAL_CONTINUOUS_FUNCTION)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_CONTINUOUS_AT_RPOW THEN
    ASM_REWRITE_TAC [])

  let REALLIM_NULL_POW_EQ ← prove
   r"!net f n.
        ~(n = 0)
        ==> (((\x. f x pow n) ---> &0) net <=> (f ---> &0) net)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [REALLIM_NULL_POW] THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"(\x. x rpow (inv(&n))) o abs") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] REALLIM_REAL_CONTINUOUS_FUNCTION)) THEN
    REWRITE_TAC [o_THM] THEN
    ASM_REWRITE_TAC [RPOW_ZERO, REAL_INV_EQ_0, REAL_OF_NUM_EQ, REAL_ABS_NUM] THEN
    SIMP_TAC [← GSYM RPOW_POW, RPOW_RPOW, REAL_ABS_POS, REAL_ABS_RPOW] THEN
    ASM_SIMP_TAC [REAL_MUL_RINV, REAL_OF_NUM_EQ] THEN
    REWRITE_TAC [REALLIM_NULL_ABS, RPOW_POW, REAL_POW_1] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM WITHINREAL_UNIV] THEN
    MATCH_MP_TAC REAL_CONTINUOUS_WITHINREAL_COMPOSE THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_ABS THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID],
      MATCH_MP_TAC REAL_CONTINUOUS_WITHIN_RPOW THEN
      REWRITE_TAC [REAL_LE_INV_EQ, REAL_POS]])

  let LIM_NULL_COMPLEX_POW_EQ ← prove
   r"!net f n.
        ~(n = 0)
        ==> (((\x. f x pow n) --> Cx(&0)) net <=> (f --> Cx(&0)) net)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN
    ONCE_REWRITE_TAC [LIM_NULL_NORM] THEN
    REWRITE_TAC [COMPLEX_NORM_POW, REAL_TENDSTO, o_DEF, LIFT_DROP] THEN
    ASM_SIMP_TAC [REALLIM_NULL_POW_EQ, DROP_VEC])

  let LIM_NULL_RPOW ← prove
   r"!net p x:A->real.
        ((lift o x) --> vec 0) net /\ &0 < p
        ==> ((\i. lift(x(i) rpow p)) --> vec 0) net"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"lift o (\x. x rpow p) o drop") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LIM_CONTINUOUS_FUNCTION)) THEN
    ASM_SIMP_TAC [o_THM, DROP_VEC, RPOW_ZERO, REAL_LT_IMP_NZ, LIFT_NUM] THEN
    REWRITE_TAC [LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM LIFT_DROP] THEN
    REWRITE_TAC [← GSYM REAL_CONTINUOUS_CONTINUOUS_ATREAL] THEN
    MATCH_MP_TAC REAL_CONTINUOUS_AT_RPOW THEN
    REWRITE_TAC [REAL_LE_INV_EQ] THEN ASM_REAL_ARITH_TAC)

  -- Analytic result for "frac".

  let HAS_REAL_DERIVATIVE_FRAC ← prove
   r"!x. ~(integer x) ==> (frac has_real_derivative (&1)) (atreal x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL THEN
    EXISTS_TAC (← q r"\y. y - floor x") THEN
    EXISTS_TAC (← q r"min (frac x) (floor x + &1 - x)") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_FRAC_POS_LT] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < x + &1 - y <=> y < x + &1"), FLOOR] THEN
    CONJ_TAC THENL [ALL_TAC, REAL_DIFF_TAC THEN REAL_ARITH_TAC] THEN
    X_GEN_TAC (← q r"y:real") THEN DISCH_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [← GSYM FRAC_UNIQUE, ← REAL_ARITH (← q r"y - (y - x):real = x")] THEN
    MP_TAC (← SPEC (← q r"x:real") FLOOR_FRAC) THEN SIMP_TAC [] THEN ASM_REAL_ARITH_TAC)

  let REAL_DIFFERENTIABLE_FRAC ← prove
   r"!x. ~(integer x) ==> frac real_differentiable (atreal x)"
   (REWRITE_TAC [real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_FRAC])

  add_real_differentiation_theorems
   (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
    (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN HAS_REAL_DERIVATIVE_FRAC)))

  -- Polynomials are differentiable and continuous.

  let REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_ATREAL ← prove
   r"!p x. polynomial_function p ==> p real_differentiable atreal x"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC POLYNOMIAL_FUNCTION_INDUCT THEN
    SIMP_TAC [REAL_DIFFERENTIABLE_CONST, REAL_DIFFERENTIABLE_ID,
              REAL_DIFFERENTIABLE_ADD, REAL_DIFFERENTIABLE_MUL_ATREAL])

  let REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_WITHIN ← prove
   r"!p s x. polynomial_function p ==> p real_differentiable atreal x within s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_ATREAL,
              REAL_DIFFERENTIABLE_ATREAL_WITHIN])

  let REAL_DIFFERENTIABLE_ON_POLYNOMIAL_FUNCTION ← prove
   r"!p s. polynomial_function p ==> p real_differentiable_on s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
              REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_WITHIN])

  let REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_ATREAL ← prove
   r"!p x. polynomial_function p ==> p real_continuous atreal x"
   (SIMP_TAC [REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
              REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_ATREAL])

  let REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_WITHIN ← prove
   r"!p s x. polynomial_function p ==> p real_continuous atreal x within s"
   (SIMP_TAC [REAL_DIFFERENTIABLE_IMP_CONTINUOUS_WITHINREAL,
              REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_WITHIN])

  let REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION ← prove
   r"!p s. polynomial_function p ==> p real_continuous_on s"
   (SIMP_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
              REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_WITHIN])

  -- Intermediate Value Theorem.

  let REAL_IVT_INCREASING ← prove
   r"!f a b y.
        a <= b /\ f real_continuous_on real_interval[a,b] /\
        f a <= y /\ y <= f b
        ==> ?x. x IN real_interval [a,b] /\ f x = y"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"y:real",
                      ← q r"1"] IVT_INCREASING_COMPONENT_ON_1) THEN
    ASM_REWRITE_TAC [← GSYM drop, o_THM, LIFT_DROP, DIMINDEX_1, LE_REFL] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, EXISTS_IN_IMAGE, LIFT_DROP])

  let REAL_IVT_DECREASING ← prove
   r"!f a b y.
        a <= b /\ f real_continuous_on real_interval[a,b] /\
        f b <= y /\ y <= f a
        ==> ?x. x IN real_interval [a,b] /\ f x = y"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"y:real",
                      ← q r"1"] IVT_DECREASING_COMPONENT_ON_1) THEN
    ASM_REWRITE_TAC [← GSYM drop, o_THM, LIFT_DROP, DIMINDEX_1, LE_REFL] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, EXISTS_IN_IMAGE, LIFT_DROP])

  let IS_REALINTERVAL_CONTINUOUS_IMAGE ← prove
   r"!s. f real_continuous_on s /\ is_realinterval s
       ==> is_realinterval(IMAGE f s)"
   (GEN_TAC THEN REWRITE_TAC [REAL_CONTINUOUS_ON, IS_REALINTERVAL_CONNECTED] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_CONTINUOUS_IMAGE) THEN
    REWRITE_TAC [IMAGE_o, ← REWRITE_RULE [IMAGE_o] IMAGE_LIFT_DROP])

  pure { REAL_CONTINUOUS_WITHIN_RPOW, REAL_CONTINUOUS_ON_RPOW, REAL_CONTINUOUS_AT_RPOW_RIGHT,
         REALLIM_RPOW, REALLIM_NULL_POW_EQ, LIM_NULL_COMPLEX_POW_EQ, LIM_NULL_RPOW,
         HAS_REAL_DERIVATIVE_FRAC, REAL_DIFFERENTIABLE_FRAC,
         REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_ATREAL,
         REAL_DIFFERENTIABLE_POLYNOMIAL_FUNCTION_WITHIN,
         REAL_DIFFERENTIABLE_ON_POLYNOMIAL_FUNCTION,
         REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_ATREAL,
         REAL_CONTINUOUS_POLYNOMIAL_FUNCTION_WITHIN,
         REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION, REAL_IVT_INCREASING, REAL_IVT_DECREASING,
         IS_REALINTERVAL_CONTINUOUS_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Zeroness of derivative at local extremum; Rolle and Mean Value Theorem.  -/
/- (realanalysis.ml 4789-4995)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZT where
  REAL_DERIVATIVE_POS_LEFT_MINIMUM : thm
  REAL_DERIVATIVE_NEG_LEFT_MAXIMUM : thm
  REAL_DERIVATIVE_POS_RIGHT_MAXIMUM : thm
  REAL_DERIVATIVE_NEG_RIGHT_MINIMUM : thm
  REAL_DERIVATIVE_ZERO_MAXMIN : thm
  REAL_ROLLE : thm
  REAL_MVT : thm
  REAL_MVT_SIMPLE : thm
  REAL_MVT_VERY_SIMPLE : thm
  REAL_ROLLE_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZT [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) (BRZO : RZO) : ExceptT String IO RZT := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, .. } := BRZA
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_ID, REAL_CONTINUOUS_ON_LMUL,
        REAL_CONTINUOUS_ON_SUB, .. } := BRZJ
  let { real_differentiable, real_differentiable_on, .. } := BRZK
  let { HAS_REAL_FRECHET_DERIVATIVE_AT, HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
        HAS_REAL_VECTOR_DERIVATIVE_AT, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN, HAS_REAL_DERIVATIVE_WITHIN_SUBSET,
        REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_ID, HAS_REAL_DERIVATIVE_LMUL_ATREAL, HAS_REAL_DERIVATIVE_SUB,
        .. } := BRZO
  let { REAL_OPEN_REAL_INTERVAL, .. } := D.qmetric
  let { IMAGE_LIFT_DROP, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, REAL_INTERVAL_INTERVAL, .. } := D.qtopology
  let { ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY, REAL_INTERVAL_OPEN_SUBSET_CLOSED,
        REAL_INTERVAL_SING, .. } := D.qmisc
  let { DIFFERENTIAL_ZERO_MAXMIN, DROP_DIFFERENTIAL_NEG_AT_MAXIMUM,
        DROP_DIFFERENTIAL_POS_AT_MINIMUM, ROLLE, .. } := D.qderivatives
  let { ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, REAL_RING,
        .. } := D.ts.cn.cx.cvx
  let { has_vector_derivative, .. } := D.ts.cn.ms.ig.qderivatives
  let { EQ_IMP, EXISTS_IN_IMAGE, EXISTS_REFL, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_SING, MONO_AND, MONO_EXISTS, MONO_FORALL, REAL_ABS_SUB,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_LT, REAL_LE_MUL_EQ, REAL_LT_IMP_LE, REAL_LT_REFL,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_RID, REAL_MUL_RZERO, REAL_SUB_LT, REAL_SUB_REFL, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, ENDS_IN_INTERVAL, FORALL_LIFT, LIFT_CMUL,
        LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  let { IN_BALL, .. } := D.ts.cn.cx.cvx.top4
  let { CONVEX_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.qconvex
  -- @@SCOPE END

  let REAL_DERIVATIVE_POS_LEFT_MINIMUM ← prove
   r"!f f' a b e.
        a < b /\ &0 < e /\
        (f has_real_derivative f') (atreal a within real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] /\ abs(x - a) < e ==> f a <= f x)
        ==> &0 <= f'"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1. f' % x",
                      ← q r"lift a", ← q r"interval[lift a,lift b]", ← q r"e:real"]
          DROP_DIFFERENTIAL_POS_AT_MINIMUM) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL, CONVEX_INTERVAL, IN_INTER, IMP_CONJ] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY,
                     ← GSYM HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, IN_BALL, DIST_LIFT,
                  REAL_INTERVAL_NE_EMPTY, REAL_LT_IMP_LE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_ABS_SUB], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b:real")) THEN
    ASM_SIMP_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY,
                  REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [DROP_CMUL, DROP_SUB, LIFT_DROP, REAL_LE_MUL_EQ,
                  REAL_SUB_LT])

  let REAL_DERIVATIVE_NEG_LEFT_MAXIMUM ← prove
   r"!f f' a b e.
        a < b /\ &0 < e /\
        (f has_real_derivative f') (atreal a within real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] /\ abs(x - a) < e ==> f x <= f a)
        ==> f' <= &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1. f' % x",
                      ← q r"lift a", ← q r"interval[lift a,lift b]", ← q r"e:real"]
          DROP_DIFFERENTIAL_NEG_AT_MAXIMUM) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL, CONVEX_INTERVAL, IN_INTER, IMP_CONJ] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY,
                     ← GSYM HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, IN_BALL, DIST_LIFT,
                  REAL_INTERVAL_NE_EMPTY, REAL_LT_IMP_LE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_ABS_SUB], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b:real")) THEN
    ASM_SIMP_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY,
                  REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [DROP_CMUL, DROP_SUB, LIFT_DROP, REAL_LE_MUL_EQ,
                  REAL_SUB_LT, ← REAL_ARITH (← q r"f * ba <= &0 <=> &0 <= --f * ba")] THEN
    REAL_ARITH_TAC)

  let REAL_DERIVATIVE_POS_RIGHT_MAXIMUM ← prove
   r"!f f' a b e.
        a < b /\ &0 < e /\
        (f has_real_derivative f') (atreal b within real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] /\ abs(x - b) < e ==> f x <= f b)
        ==> &0 <= f'"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1. f' % x",
                      ← q r"lift b", ← q r"interval[lift a,lift b]", ← q r"e:real"]
          DROP_DIFFERENTIAL_NEG_AT_MAXIMUM) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL, CONVEX_INTERVAL, IN_INTER, IMP_CONJ] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY,
                     ← GSYM HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, IN_BALL, DIST_LIFT,
                  REAL_INTERVAL_NE_EMPTY, REAL_LT_IMP_LE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_ABS_SUB], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real")) THEN
    ASM_SIMP_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY,
                  REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [DROP_CMUL, DROP_SUB, LIFT_DROP, REAL_LE_MUL_EQ, REAL_SUB_LT,
                  ← REAL_ARITH (← q r"f * (a - b) <= &0 <=> &0 <= f * (b - a)")])

  let REAL_DERIVATIVE_NEG_RIGHT_MINIMUM ← prove
   r"!f f' a b e.
        a < b /\ &0 < e /\
        (f has_real_derivative f') (atreal b within real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] /\ abs(x - b) < e ==> f b <= f x)
        ==> f' <= &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1. f' % x",
                      ← q r"lift b", ← q r"interval[lift a,lift b]", ← q r"e:real"]
          DROP_DIFFERENTIAL_POS_AT_MINIMUM) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL, CONVEX_INTERVAL, IN_INTER, IMP_CONJ] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY,
                     ← GSYM HAS_REAL_FRECHET_DERIVATIVE_WITHIN] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, IN_BALL, DIST_LIFT,
                  REAL_INTERVAL_NE_EMPTY, REAL_LT_IMP_LE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_ABS_SUB], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real")) THEN
    ASM_SIMP_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY,
                  REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [DROP_CMUL, DROP_SUB, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"&0 <= f * (a - b) <=> &0 <= --f * (b - a)")] THEN
    ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_SUB_LT] THEN REAL_ARITH_TAC)

  let REAL_DERIVATIVE_ZERO_MAXMIN ← prove
   r"!f f' x s.
        x IN s /\ real_open s /\
        (f has_real_derivative f') (atreal x) /\
        ((!y. y IN s ==> f y <= f x) \/ (!y. y IN s ==> f x <= f y))
        ==> f' = &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1. f' % x",
                      ← q r"lift x", ← q r"IMAGE lift s"]
          DIFFERENTIAL_ZERO_MAXMIN) THEN
    ASM_REWRITE_TAC [← GSYM HAS_REAL_FRECHET_DERIVATIVE_AT, ← GSYM REAL_OPEN] THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE, FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o C AP_THM (← q r"vec 1:real^1")) THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC, REAL_MUL_RID])

  -- Rolle and Mean Value Theorem.

  let REAL_ROLLE ← prove
   r"!f f' a b.
        a < b /\ f a = f b /\
        f real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b)
             ==> (f has_real_derivative f'(x)) (atreal x))
        ==> ?x. x IN real_interval(a,b) /\ f'(x) = &0"
   (REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, HAS_REAL_VECTOR_DERIVATIVE_AT] THEN
    REWRITE_TAC [← GSYM IMAGE_o, IMAGE_LIFT_DROP, has_vector_derivative] THEN
    REWRITE_TAC [LIFT_DROP] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\x:real^1 h:real^1. f'(drop x) % h",
                      ← q r"lift a", ← q r"lift b"] ROLLE) THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^1")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, FORALL_LIFT, LIFT_DROP, ← GSYM LIFT_CMUL] THEN
      REWRITE_TAC [REAL_MUL_AC],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^1") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o C AP_THM (← q r"lift(&1)")) THEN
      REWRITE_TAC [← GSYM LIFT_CMUL, ← GSYM LIFT_NUM, LIFT_EQ, REAL_MUL_RID]])

  let REAL_MVT ← prove
   r"!f f' a b.
        a < b /\
        f real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b)
             ==> (f has_real_derivative f'(x)) (atreal x))
        ==> ?x. x IN real_interval(a,b) /\ f(b) - f(a) = f'(x) * (b - a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"\x:real. f(x) - (f b - f a) / (b - a) * x",
                     ← q r"(\x. f'(x) - (f b - f a) / (b - a)):real->real",
                     ← q r"a:real", ← q r"b:real"]
                 REAL_ROLLE) THEN
    ASM_SIMP_TAC [← REAL_FIELD
     (← q r"a < b ==> (fx - fba / (b - a) = &0 <=> fba = fx * (b - a))")] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_ON_SUB, REAL_CONTINUOUS_ON_LMUL,
                  REAL_CONTINUOUS_ON_ID] THEN
    CONJ_TAC THENL [UNDISCH_TAC (← q r"a < b") THEN CONV_TAC REAL_FIELD, ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUB THEN
    ASM_SIMP_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_MUL_RID] THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_LMUL_ATREAL, HAS_REAL_DERIVATIVE_ID])

  let REAL_MVT_SIMPLE ← prove
   r"!f f' a b.
        a < b /\
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))
                 (atreal x within real_interval[a,b]))
        ==> ?x. x IN real_interval(a,b) /\ f(b) - f(a) = f'(x) * (b - a)"
   (MP_TAC REAL_MVT THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
      ASM_MESON_TAC [real_differentiable_on, real_differentiable],
      ASM_MESON_TAC [HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN, REAL_OPEN_REAL_INTERVAL,
                     REAL_INTERVAL_OPEN_SUBSET_CLOSED,
                     HAS_REAL_DERIVATIVE_WITHIN_SUBSET, SUBSET]])

  let REAL_MVT_VERY_SIMPLE ← prove
   r"!f f' a b.
        a <= b /\
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))
                 (atreal x within real_interval[a,b]))
        ==> ?x. x IN real_interval[a,b] /\ f(b) - f(a) = f'(x) * (b - a)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"b:real = a") THENL
     [ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_MUL_RZERO] THEN
      REWRITE_TAC [REAL_INTERVAL_SING, IN_SING, EXISTS_REFL],
      ASM_REWRITE_TAC [REAL_LE_LT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP REAL_MVT_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [← REWRITE_RULE [SUBSET] REAL_INTERVAL_OPEN_SUBSET_CLOSED]])

  let REAL_ROLLE_SIMPLE ← prove
   r"!f f' a b.
        a < b /\ f a = f b /\
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))
                 (atreal x within real_interval[a,b]))
        ==> ?x. x IN real_interval(a,b) /\ f'(x) = &0"
   (MP_TAC REAL_MVT_SIMPLE THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [← REAL_RING (← q r"a - a = b * (c - d) <=> b = &0 \/ c = d")] THEN
    ASM_MESON_TAC [REAL_LT_REFL])

  pure { REAL_DERIVATIVE_POS_LEFT_MINIMUM, REAL_DERIVATIVE_NEG_LEFT_MAXIMUM,
         REAL_DERIVATIVE_POS_RIGHT_MAXIMUM, REAL_DERIVATIVE_NEG_RIGHT_MINIMUM,
         REAL_DERIVATIVE_ZERO_MAXMIN, REAL_ROLLE, REAL_MVT, REAL_MVT_SIMPLE,
         REAL_MVT_VERY_SIMPLE, REAL_ROLLE_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Cauchy MVT and l'Hospital's rule.                                         -/
/- (realanalysis.ml 4996-5125)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZU where
  REAL_MVT_CAUCHY : thm
  LHOSPITAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZU [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) (BRZJ : RZJ) (BRZK : RZK) (BRZN : RZN) (BRZO : RZO) (BRZT : RZT) : ExceptT String IO RZU := do
  -- @@SCOPE BEGIN
  let { REALLIM_ATREAL, .. } := BRZF
  let { REAL_CONTINUOUS_ATREAL, REAL_CONTINUOUS_ATREAL_WITHINREAL, .. } := BRZH
  let { REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, REAL_CONTINUOUS_ON_RMUL,
        REAL_CONTINUOUS_ON_SUB, .. } := BRZJ
  let { real_differentiable, .. } := BRZK
  let { HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL, REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL,
        .. } := BRZN
  let { HAS_REAL_DERIVATIVE_RMUL_ATREAL, HAS_REAL_DERIVATIVE_SUB, .. } := BRZO
  let { REAL_MVT, REAL_ROLLE, .. } := BRZT
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_FIELD, .. } := D.ts.cn.cx.cvx
  let { AND_FORALL_THM, CONJ_ASSOC, FORALL_AND_THM, .. } := D.ts.cn.cx.cvx.core1
  let { MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_IMP,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_MIN, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_SUB_RZERO, .. } := D.ts.cn.cx.cvx.core5
  let { REAL_LT_TRANS, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let REAL_MVT_CAUCHY ← prove
   r"!f g f' g' a b.
           a < b /\
           f real_continuous_on real_interval[a,b] /\
           g real_continuous_on real_interval[a,b] /\
           (!x. x IN real_interval(a,b)
                ==> (f has_real_derivative f' x) (atreal x) /\
                    (g has_real_derivative g' x) (atreal x))
           ==> ?x. x IN real_interval(a,b) /\
                   (f b - f a) * g'(x) = (g b - g a) * f'(x)"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPECL
     [← q r"\x. (f:real->real)(x) * (g(b:real) - g(a)) - g(x) * (f(b) - f(a))",
      ← q r"\x. (f':real->real)(x) * (g(b:real) - g(a)) - g'(x) * (f(b) - f(a))",
      ← q r"a:real", ← q r"b:real"] REAL_MVT) THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_ON_SUB, REAL_CONTINUOUS_ON_RMUL,
                  HAS_REAL_DERIVATIVE_SUB, HAS_REAL_DERIVATIVE_RMUL_ATREAL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN
    UNDISCH_TAC (← q r"a < b") THEN CONV_TAC REAL_FIELD)

  let LHOSPITAL ← prove
   r"!f g f' g' c l d.
        &0 < d /\
        (!x. &0 < abs(x - c) /\ abs(x - c) < d
             ==> (f has_real_derivative f'(x)) (atreal x) /\
                 (g has_real_derivative g'(x)) (atreal x) /\
                 ~(g'(x) = &0)) /\
        (f ---> &0) (atreal c) /\ (g ---> &0) (atreal c) /\
        ((\x. f'(x) / g'(x)) ---> l) (atreal c)
        ==> ((\x. f(x) / g(x)) ---> l) (atreal c)"
   (SUBGOAL_THEN
     (← q r"!f g f' g' c l d.
        &0 < d /\
        (!x. &0 < abs(x - c) /\ abs(x - c) < d
             ==> (f has_real_derivative f'(x)) (atreal x) /\
                 (g has_real_derivative g'(x)) (atreal x) /\
                 ~(g'(x) = &0)) /\
        f(c) = &0 /\ g(c) = &0 /\
        (f ---> &0) (atreal c) /\ (g ---> &0) (atreal c) /\
        ((\x. f'(x) / g'(x)) ---> l) (atreal c)
        ==> ((\x. f(x) / g(x)) ---> l) (atreal c)")
    ASSUME_TAC THENL
     [REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(!x. abs(x - c) < d ==> f real_continuous atreal x) /\
        (!x. abs(x - c) < d ==> g real_continuous atreal x)")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"x:real") THEN
        DISJ_CASES_TAC (← REAL_ARITH (← q r"x = c \/ &0 < abs(x - c)")) THENL
         [ASM_REWRITE_TAC [REAL_CONTINUOUS_ATREAL], ALL_TAC] THEN
        REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_DIFFERENTIABLE_IMP_CONTINUOUS_ATREAL THEN
        REWRITE_TAC [real_differentiable] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x.  &0 < abs(x - c) /\ abs(x - c) < d ==> ~(g x = &0)")
      STRIP_ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"c < x \/ x < c") DISJ_CASES_TAC THENL
         [ASM_REAL_ARITH_TAC,
          MP_TAC (← ISPECL [← q r"g:real->real", ← q r"g':real->real", ← q r"c:real",
                            ← q r"x:real"] REAL_ROLLE),
          MP_TAC (← ISPECL [← q r"g:real->real", ← q r"g':real->real", ← q r"x:real",
                            ← q r"c:real"] REAL_ROLLE)] THEN
        ASM_REWRITE_TAC [NOT_IMP, NOT_EXISTS_THM] THEN
        (REPEAT CONJ_TAC THENL
          [REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
           REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
           MATCH_MP_TAC REAL_CONTINUOUS_ATREAL_WITHINREAL,
           REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC,
           X_GEN_TAC (← q r"y:real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
           DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
           REWRITE_TAC []] THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC),
        ALL_TAC] THEN
      UNDISCH_TAC (← q r"((\x. f' x / g' x) ---> l) (atreal c)") THEN
      REWRITE_TAC [REALLIM_ATREAL] THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d k:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?y. &0 < abs(y - c) /\ abs(y - c) < abs(x - c) /\
            (f:real->real) x / g x = f' y / g' y")
      STRIP_ASSUME_TAC THENL
       [ALL_TAC, ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [REAL_LT_TRANS]] THEN
      SUBGOAL_THEN (← q r"c < x \/ x < c") DISJ_CASES_TAC THENL
       [ASM_REAL_ARITH_TAC,
        MP_TAC (← ISPECL
         [← q r"f:real->real", ← q r"g:real->real", ← q r"f':real->real",
          ← q r"g':real->real", ← q r"c:real", ← q r"x:real"] REAL_MVT_CAUCHY),
        MP_TAC (← ISPECL
         [← q r"f:real->real", ← q r"g:real->real", ← q r"f':real->real",
          ← q r"g':real->real", ← q r"x:real", ← q r"c:real"] REAL_MVT_CAUCHY)] THEN
      (ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN ANTS_TAC THENL
        [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
          [CONJ_TAC THEN
           REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
           REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
           MATCH_MP_TAC REAL_CONTINUOUS_ATREAL_WITHINREAL,
           REPEAT STRIP_TAC] THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
         MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [REAL_SUB_RZERO] THEN
         GEN_TAC THEN STRIP_TAC THEN
          REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
         MATCH_MP_TAC (← REAL_FIELD
          (← q r"f * g' = g * f' /\ ~(g = &0) /\ ~(g' = &0) ==> f / g = f' / g'")) THEN
         CONJ_TAC THENL [ASM_REAL_ARITH_TAC, CONJ_TAC] THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC]),
      REPEAT GEN_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\x:real. if x = c then &0 else f(x)",
        ← q r"\x:real. if x = c then &0 else g(x)",
        ← q r"f':real->real", ← q r"g':real->real",
        ← q r"c:real", ← q r"l:real", ← q r"d:real"]) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC MONO_IMP THEN CONJ_TAC THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
      TRY (SIMP_TAC [REALLIM_ATREAL, ← REAL_ARITH (← q r"&0 < abs(x - c) ==> ~(x = c)")] THEN
          HolCore.Tactics.NO_TAC) THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
            HAS_REAL_DERIVATIVE_TRANSFORM_ATREAL) THEN
      EXISTS_TAC (← q r"abs(x - c)") THEN ASM_REAL_ARITH_TAC])

  pure { REAL_MVT_CAUCHY, LHOSPITAL }

/- ------------------------------------------------------------------------- -/
/- Darboux's theorem; continuity and differentiability of inverse functions. -/
/- (realanalysis.ml 5126-5280)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZV where
  REAL_DERIVATIVE_IVT_INCREASING : thm
  REAL_DERIVATIVE_IVT_DECREASING : thm
  HAS_REAL_DERIVATIVE_INVERSE_BASIC : thm
  HAS_REAL_DERIVATIVE_INVERSE_STRONG : thm
  HAS_REAL_DERIVATIVE_INVERSE_STRONG_X : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZV [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) (BRZO : RZO) (BRZQ : RZQ) (BRZT : RZT) : ExceptT String IO RZV := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, .. } := BRZA
  let { REAL_CONTINUOUS_ATTAINS_INF, REAL_CONTINUOUS_ON, .. } := BRZJ
  let { real_differentiable_on, .. } := BRZK
  let { HAS_REAL_FRECHET_DERIVATIVE_AT, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN, HAS_REAL_DERIVATIVE_WITHIN_SUBSET,
        REAL_CONTINUOUS_CONTINUOUS_ATREAL, REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON,
        .. } := BRZN
  let { HAS_REAL_DERIVATIVE_NEG, HAS_REAL_DERIVATIVE_SUB, REAL_DIFFERENTIABLE_ON_CONST,
        REAL_DIFFERENTIABLE_ON_ID, REAL_DIFFERENTIABLE_ON_MUL, REAL_DIFFERENTIABLE_ON_SUB,
        .. } := BRZO
  let { REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_DERIVATIVE_NEG_RIGHT_MINIMUM, REAL_DERIVATIVE_POS_LEFT_MINIMUM,
        REAL_DERIVATIVE_ZERO_MAXMIN, .. } := BRZT
  let { REAL_COMPACT_INTERVAL, REAL_OPEN_REAL_INTERVAL, .. } := D.qmetric
  let { LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY, REAL_INTERVAL_OPEN_SUBSET_CLOSED,
        REAL_OPEN_CLOSED_INTERVAL, .. } := D.qmisc
  let { HAS_DERIVATIVE_INVERSE_BASIC, HAS_DERIVATIVE_INVERSE_STRONG,
        HAS_DERIVATIVE_INVERSE_STRONG_X, .. } := D.ts.cn.qderivatives
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { EQ_IMP, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { I_THM, IN_INSERT, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_EQ_NEG2, REAL_LE_ANTISYM, REAL_LE_LT, REAL_LE_NEG2, REAL_LT_01,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_NOT_LE, REAL_SUB_0, REAL_SUB_LE,
        REAL_SUB_LT, .. } := D.ts.cn.cx.cvx.core5
  let { o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { ENDS_IN_INTERVAL, FORALL_LIFT, INTERVAL_NE_EMPTY, LIFT_DROP,
        .. } := D.ts.cn.cx.cvx.vec2
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.ts.cn.cx.cvx.vec4
  let { LINEAR_COMPOSE_CMUL, .. } := D.ts.cn.ms.ig.dv.qvec
  let { LINEAR_ID, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let REAL_DERIVATIVE_IVT_INCREASING ← prove
   r"!f f' a b.
   a <= b /\
   (!x. x IN real_interval[a,b]
        ==> (f has_real_derivative f'(x)) (atreal x within real_interval[a,b]))
   ==> !t. f'(a) <= t /\ t <= f'(b)
           ==> ?x. x IN real_interval[a,b] /\ f' x = t"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN GEN_TAC THEN
    ASM_CASES_TAC (← q r"(f':real->real) a = t") THENL
     [ASM_MESON_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(f':real->real) b = t") THENL
     [ASM_MESON_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"b:real = a") THEN ASM_REWRITE_TAC [REAL_LE_ANTISYM] THEN
    SUBGOAL_THEN (← q r"a < b") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [REAL_LE_LT] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real. f x - t * x", ← q r"real_interval[a,b]"]
          REAL_CONTINUOUS_ATTAINS_INF) THEN
    ASM_REWRITE_TAC [REAL_INTERVAL_NE_EMPTY, REAL_COMPACT_INTERVAL] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
      MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_SUB THEN
      SIMP_TAC [REAL_DIFFERENTIABLE_ON_MUL, REAL_DIFFERENTIABLE_ON_ID,
                REAL_DIFFERENTIABLE_ON_CONST] THEN
      ASM_MESON_TAC [real_differentiable_on],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPECL
     [← q r"\x:real. f x - t * x", ← q r"(f':real->real) x - t:real",
      ← q r"x:real", ← q r"real_interval(a,b)"]
          REAL_DERIVATIVE_ZERO_MAXMIN) THEN
    ASM_REWRITE_TAC [REAL_SUB_0] THEN DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [REAL_OPEN_REAL_INTERVAL] THEN
    ASM_SIMP_TAC [REAL_OPEN_CLOSED_INTERVAL, IN_DIFF] THEN
    ASM_CASES_TAC (← q r"x:real = a") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      MP_TAC (← ISPECL [← q r"\x:real. f x - t * x", ← q r"(f':real->real) a - t:real",
                        ← q r"a:real", ← q r"b:real", ← q r"&1"]
          REAL_DERIVATIVE_POS_LEFT_MINIMUM) THEN
      ASM_SIMP_TAC [REAL_LT_01, REAL_SUB_LE] THEN
      MATCH_MP_TAC (← TAUT (← q r"~q /\ p ==> (p ==> q) ==> r")) THEN
      ASM_REWRITE_TAC [REAL_NOT_LE] THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUB THEN
      CONJ_TAC THENL [ALL_TAC, REAL_DIFF_TAC THEN REWRITE_TAC [REAL_MUL_RID]] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"x:real = b") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      MP_TAC (← ISPECL [← q r"\x:real. f x - t * x", ← q r"(f':real->real) b - t:real",
                        ← q r"a:real", ← q r"b:real", ← q r"&1"]
          REAL_DERIVATIVE_NEG_RIGHT_MINIMUM) THEN
      ASM_SIMP_TAC [REAL_LT_01, REAL_SUB_LE] THEN
      MATCH_MP_TAC (← TAUT (← q r"~q /\ p ==> (p ==> q) ==> r")) THEN
      ASM_REWRITE_TAC [REAL_NOT_LE, REAL_SUB_LT] THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUB THEN
      CONJ_TAC THENL [ALL_TAC, REAL_DIFF_TAC THEN REWRITE_TAC [REAL_MUL_RID]] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUB THEN
    CONJ_TAC THENL [ALL_TAC, REAL_DIFF_TAC THEN REWRITE_TAC [REAL_MUL_RID]] THEN
    SUBGOAL_THEN
     (← q r"(f has_real_derivative f' x) (atreal x within real_interval(a,b))")
    MP_TAC THENL
     [MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"real_interval[a,b]") THEN
      ASM_SIMP_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED],
      MATCH_MP_TAC EQ_IMP THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN THEN
      REWRITE_TAC [REAL_OPEN_REAL_INTERVAL] THEN
      ASM_REWRITE_TAC [REAL_OPEN_CLOSED_INTERVAL] THEN ASM SET_TAC []])

  let REAL_DERIVATIVE_IVT_DECREASING ← prove
   r"!f f' a b.
   a <= b /\
   (!x. x IN real_interval[a,b]
        ==> (f has_real_derivative f'(x)) (atreal x within real_interval[a,b]))
   ==> !t. f'(b) <= t /\ t <= f'(a)
           ==> ?x. x IN real_interval[a,b] /\ f' x = t"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPECL
     [← q r"\x. --((f:real->real) x)", ← q r"\x. --((f':real->real) x)",
      ← q r"a:real", ← q r"b:real"] REAL_DERIVATIVE_IVT_INCREASING) THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_NEG] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--t:real")) THEN
    ASM_REWRITE_TAC [REAL_LE_NEG2, REAL_EQ_NEG2])

  -- Continuity and differentiability of inverse functions.

  let HAS_REAL_DERIVATIVE_INVERSE_BASIC ← prove
   r"!f g f' t y.
        (f has_real_derivative f') (atreal (g y)) /\
        ~(f' = &0) /\
        g real_continuous atreal y /\
        real_open t /\
        y IN t /\
        (!z. z IN t ==> f (g z) = z)
        ==> (g has_real_derivative inv(f')) (atreal y)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_AT, REAL_OPEN,
                 REAL_CONTINUOUS_CONTINUOUS_ATREAL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_DERIVATIVE_INVERSE_BASIC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"lift o f o drop", ← q r"\x:real^1. f' % x", ← q r"IMAGE lift t"] THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP, LIFT_IN_IMAGE_LIFT] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, LIFT_DROP, LINEAR_COMPOSE_CMUL, LINEAR_ID] THEN
    REWRITE_TAC [FUN_EQ_THM, I_THM, o_THM, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID])

  let HAS_REAL_DERIVATIVE_INVERSE_STRONG ← prove
   r"!f g f' s x.
         real_open s /\
         x IN s /\
         f real_continuous_on s /\
         (!x. x IN s ==> g (f x) = x) /\
         (f has_real_derivative f') (atreal x) /\
         ~(f' = &0)
         ==> (g has_real_derivative inv(f')) (atreal (f x))"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_AT, REAL_OPEN,
                 REAL_CONTINUOUS_ON] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"lift o f o drop") HAS_DERIVATIVE_INVERSE_STRONG) THEN
    REWRITE_TAC [FORALL_LIFT, o_THM, LIFT_DROP] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"\x:real^1. f' % x", ← q r"IMAGE lift s"] THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP, LIFT_IN_IMAGE_LIFT] THEN
    ASM_SIMP_TAC [FUN_EQ_THM, I_THM, o_THM, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID])

  let HAS_REAL_DERIVATIVE_INVERSE_STRONG_X ← prove
   r"!f g f' s y.
        real_open s /\ (g y) IN s /\ f real_continuous_on s /\
        (!x. x IN s ==> (g(f(x)) = x)) /\
        (f has_real_derivative f') (atreal (g y)) /\ ~(f' = &0) /\
        f(g y) = y
        ==> (g has_real_derivative inv(f')) (atreal y)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_AT, REAL_OPEN,
                 REAL_CONTINUOUS_ON] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"lift o f o drop") HAS_DERIVATIVE_INVERSE_STRONG_X) THEN
    REWRITE_TAC [FORALL_LIFT, o_THM, LIFT_DROP] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"\x:real^1. f' % x", ← q r"IMAGE lift s"] THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP, LIFT_IN_IMAGE_LIFT] THEN
    ASM_SIMP_TAC [FUN_EQ_THM, I_THM, o_THM, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID])

  pure { REAL_DERIVATIVE_IVT_INCREASING, REAL_DERIVATIVE_IVT_DECREASING,
         HAS_REAL_DERIVATIVE_INVERSE_BASIC, HAS_REAL_DERIVATIVE_INVERSE_STRONG,
         HAS_REAL_DERIVATIVE_INVERSE_STRONG_X }
/- ------------------------------------------------------------------------- -/
/- Limsup and liminf (part 1).                                               -/
/- (realanalysis.ml 5281-5492)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZW where
  has_limsup : thm
  has_liminf : thm
  HAS_LIMSUP_TRANSFORM : thm
  HAS_LIMSUP_EVENTUALLY_UBOUND : thm
  REALLIM_IMP_HAS_LIMSUP : thm
  HAS_LIMSUP_IMP_UBOUND_LE : thm
  HAS_LIMSUP_NOT_UBOUND : thm
  HAS_LIMSUP : thm
  LIMSUP_EXISTS : thm
  HAS_LIMSUP_LE : thm
  HAS_LIMSUP_UBOUND : thm
  HAS_LIMSUP_SEQUENTIALLY : thm
  HAS_LIMSUP_SEQUENTIALLY_WITHIN : thm
  HAS_LIMSUP_SEQUENTIALLY_IMP_REALLIM_SUP : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZW [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) : ExceptT String IO RZW := do
  -- @@SCOPE BEGIN
  let { REALLIM_CONST, tendsto_real, .. } := BRZA
  let { REALLIM_SEQUENTIALLY, REALLIM_UBOUND, .. } := BRZB
  let { EVENTUALLY_IFF, EVENTUALLY_SEQUENTIALLY_WITHIN, EVENTUALLY_TRIVIAL,
        TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN, .. } := D.qmetric
  let { HAS_INF, HAS_INF_APPROACH, HAS_INF_LBOUND, INF_EXISTS, REAL_ABS_BETWEEN,
        .. } := D.qsession
  let { REAL_LT_BETWEEN, .. } := D.ts.cn.ms.qmisc
  let { ELEMENT_LE_SUP, .. } := D.ts.cn.ms.qsession
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC,
        new_definition, parse_as_infix, REAL_ARITH, REAL_ARITH_TAC, .. } := D.ts.cn.cx.cvx
  let { CLAIM_TAC, HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { CONTRAPOS_THM, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { GE, IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IN_EMPTY,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LET_TRANS, REAL_LTE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, .. } := D.ts.cn.cx.cvx.core5
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.ts.cn.cx.cvx.met
  let { ALWAYS_EVENTUALLY, EVENTUALLY_MP, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { EVENTUALLY_AND, .. } := D.ts.cn.ms.ig.dv.dg.qmetric
  let { REAL_SUP_LE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  parse_as_infix ("has_limsup", (12, "right"))
  parse_as_infix ("has_liminf", (12, "right"))

  let has_limsup ← new_definition
   r"(f:A->real has_limsup l) net <=>
   trivial_limit net \/
   {b | eventually (\x. f x <= b) net} has_inf l"

  let has_liminf ← new_definition
   r"(f:A->real has_liminf l) net <=>
   trivial_limit net \/
   {b | eventually (\x. b <= f x ) net} has_sup l"

  let HAS_LIMSUP_TRANSFORM ← prove
   r"!net f g l. eventually (\x:A. f x = g x) net /\ (f has_limsup l) net
               ==> (g has_limsup l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_limsup] THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN ASM_REWRITE_TAC [] THEN
    INTRO_TAC "e l" THEN
    SUBGOAL_THEN
      (← q r"!b. eventually (\x:A. g x <= b) net <=> eventually (\x. f x <= b) net")
      (fun th => ASM_REWRITE_TAC [th]) THEN
    GEN_TAC THEN MATCH_MP_TAC EVENTUALLY_IFF THEN REWRITE_TAC [] THEN
    REMOVE_THEN "e" MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN SIMP_TAC [])

  let HAS_LIMSUP_EVENTUALLY_UBOUND ← prove
   r"!net f l b. ~trivial_limit net /\ (f has_limsup l) net /\ l < b
               ==> eventually (\x:A. f x < b) net"
   (INTRO_TAC "! *; ntriv +" THEN ASM_REWRITE_TAC [has_limsup] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INF_APPROACH) THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN INTRO_TAC "@c. + le" THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let REALLIM_IMP_HAS_LIMSUP ← prove
   r"!net f:A->real l. (f ---> l) net ==> (f has_limsup l) net"
   (INTRO_TAC "!net f l; lim" THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
    ASM_REWRITE_TAC [has_limsup] THEN POP_ASSUM (LABEL_TAC "ntriv") THEN
    REWRITE_TAC [HAS_INF] THEN CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
     EXISTS_TAC (← q r"l + &1") THEN HYP_TAC "lim: +" (REWRITE_RULE [tendsto_real]) THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
     ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
     MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN REAL_ARITH_TAC,
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [REALLIM_UBOUND],
     ALL_TAC] THEN
    INTRO_TAC "!c; c" THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"(l + c) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    HYP_TAC "lim: +" (SPEC (← q r"(c - l) / &2") o REWRITE_RULE [tendsto_real]) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let HAS_LIMSUP_IMP_UBOUND_LE ← prove
   r"!net f l. (f has_limsup l) net ==> ?b. eventually (\x:A. f x <= b) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_limsup] THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THENL
    [ASM_SIMP_TAC [EVENTUALLY_TRIVIAL], POP_ASSUM (LABEL_TAC "ntriv")] THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [HAS_INF] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN INTRO_TAC "_ _ hp" THEN
    HYP_TAC "hp: +" (SPEC (← q r"l + &1")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN MESON_TAC [])

  let HAS_LIMSUP_NOT_UBOUND ← prove
   r"!net f l c.
     ~trivial_limit net /\ (f has_limsup l) net /\ c < l
     ==> ~eventually (\x:A. f x <= c) net"
   (REWRITE_TAC [has_limsup] THEN INTRO_TAC "!net f l c; ntriv + lt" THEN
    ASM_REWRITE_TAC [] THEN INTRO_TAC "inf; c" THEN
    SUBGOAL_THEN (← q r"l <= c") (fun th => MP_TAC th THEN ASM_REAL_ARITH_TAC) THEN
    MATCH_MP_TAC HAS_INF_LBOUND THEN
    EXISTS_TAC (← q r"{b | eventually (\x:A. f x <= b) net}") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM])

  let HAS_LIMSUP ← prove
   r"!net f l. (f has_limsup l) net <=>
             trivial_limit net \/
             (!c. l < c ==> eventually (\x:A. f x <= c) net) /\
             (!c. c < l ==> ~eventually (\x:A. f x <= c) net)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THENL
    [ASM_REWRITE_TAC [has_limsup], POP_ASSUM (LABEL_TAC "ntriv")] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
    [INTRO_TAC "limsup" THEN CONJ_TAC THENL
     [INTRO_TAC "!c; lt" THEN MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"(\x:A. f x < c)") THEN CONJ_TAC THENL
      [REAL_ARITH_TAC, ASM_MESON_TAC [HAS_LIMSUP_EVENTUALLY_UBOUND]],
      ASM_MESON_TAC [HAS_LIMSUP_NOT_UBOUND]],
     ALL_TAC] THEN
    INTRO_TAC "ubound lbound" THEN ASM_REWRITE_TAC [has_limsup] THEN
    REWRITE_TAC [HAS_INF] THEN CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
     EXISTS_TAC (← q r"l + &1") THEN REMOVE_THEN "ubound" MATCH_MP_TAC THEN
     REAL_ARITH_TAC,
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [REAL_NOT_LE], ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    INTRO_TAC "!c; lt" THEN EXISTS_TAC (← q r"(l + c) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    REMOVE_THEN "ubound" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC)

  let LIMSUP_EXISTS ← prove
   r"!net f. (?l. (f has_limsup l) net) <=>
           trivial_limit net \/
           (?b. eventually (\x:A. f x <= b) net) /\
           (?c. ~eventually (\x. f x <= c) net)"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL
    [REWRITE_TAC [HAS_LIMSUP] THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
     ASM_REWRITE_TAC [] THEN STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [← REAL_ARITH (← q r"l < l + &1")], ALL_TAC] THEN
     EXISTS_TAC (← q r"l - &1") THEN POP_ASSUM (MP_TAC o SPEC (← q r"l - &1")) THEN
     ANTS_TAC THENL [REAL_ARITH_TAC, REWRITE_TAC [CONTRAPOS_THM]],
     ALL_TAC] THEN
    REWRITE_TAC [has_limsup] THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
    ASM_REWRITE_TAC [] THEN INTRO_TAC "(@b. b) (@c. c)" THEN
    REWRITE_TAC [INF_EXISTS] THEN CONJ_TAC THENL
    [ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [IN_ELIM_THM],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"c:real") THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    INTRO_TAC "![x]; x" THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
    INTRO_TAC "lt" THEN REMOVE_THEN "x" MP_TAC THEN
    REMOVE_THEN "c" MP_TAC THEN REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_REAL_ARITH_TAC)

  let HAS_LIMSUP_LE ← prove
   r"!net f g l m.
     (f has_limsup l) net /\
     (g has_limsup m) net /\
     ~trivial_limit net /\
     eventually (\x:A. f x <= g x) net
     ==> l <= m"
   (INTRO_TAC "!net f g l m; l m notriv le" THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN ONCE_REWRITE_TAC [REAL_LT_BETWEEN] THEN
    INTRO_TAC "@c. c1 c2" THEN
    CLAIM_TAC "g" (← q r"eventually (\x:A. g x < c) net") THENL
    [MATCH_MP_TAC HAS_LIMSUP_EVENTUALLY_UBOUND THEN ASM_MESON_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "+" (← q r"eventually (\x:A. f x <= c) net") THENL
    [MATCH_MP_TAC EVENTUALLY_MP THEN
     EXISTS_TAC (← q r"\x:A. f x <= g x /\ g x < c") THEN CONJ_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_REAL_ARITH_TAC,
      ASM_REWRITE_TAC [EVENTUALLY_AND]],
     REWRITE_TAC []] THEN
     MATCH_MP_TAC HAS_LIMSUP_NOT_UBOUND THEN ASM_MESON_TAC [])

  let HAS_LIMSUP_UBOUND ← prove
   r"!net f b l. eventually (\x:A. f x <= b) net /\
               (f has_limsup l) net /\
               ~trivial_limit net
               ==> l <= b"
   (INTRO_TAC "!net f b l; ub lim ntriv" THEN MATCH_MP_TAC HAS_LIMSUP_LE THEN
    MAP_EVERY EXISTS_TAC [← q r"net:A net", ← q r"f:A->real", ← q r"\x:A. b:real"] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REALLIM_IMP_HAS_LIMSUP THEN
    ASM_REWRITE_TAC [REALLIM_CONST])

  let HAS_LIMSUP_SEQUENTIALLY ← prove
   r"!a l. (a has_limsup l) sequentially <=>
         (!c. l < c ==> ?N. !n. N <= n ==> a n <= c) /\
         (!c. c < l ==> !N. ?n. N <= n /\ c < a n)"
   (REWRITE_TAC [HAS_LIMSUP, TRIVIAL_LIMIT_SEQUENTIALLY,
                 EVENTUALLY_SEQUENTIALLY] THEN
    MESON_TAC [REAL_NOT_LE])

  let HAS_LIMSUP_SEQUENTIALLY_WITHIN ← prove
   r"!a l k. (a has_limsup l) (sequentially within k) <=>
           FINITE k \/
           (!c. l < c ==> (?N. !n. n IN k /\ N <= n ==> a n <= c)) /\
           (!c. c < l ==> (!N. ?n. n IN k /\ N <= n /\ c < a n))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THEN
    ASM_REWRITE_TAC [HAS_LIMSUP, TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN] THEN
    ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
    MESON_TAC [REAL_NOT_LE])

  let HAS_LIMSUP_SEQUENTIALLY_IMP_REALLIM_SUP ← prove
   r"!f l. (f has_limsup l) sequentially
         ==> ((\n. sup {f m | m >= n}) ---> l) sequentially"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY, HAS_LIMSUP_SEQUENTIALLY] THEN
    INTRO_TAC "h1 h2; !e; epos" THEN
    HYP_TAC "h1: +" (SPEC (← q r"l + e / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@N. h1"] THEN
    HYP_TAC "h2: +" (SPEC (← q r"l - e:real")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "h2"] THEN
    EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
    ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
    HYP_TAC "h2: @M. le M" (SPEC (← q r"n:num")) THEN CONJ_TAC THENL
    [TRANS_TAC REAL_LTE_TRANS (← q r"f (M:num):real") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC ELEMENT_LE_SUP THEN CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC] THEN EXISTS_TAC (← q r"l + e / &2") THEN
      INTRO_TAC "!m; m" THEN REMOVE_THEN "h1" MATCH_MP_TAC THEN ASM_ARITH_TAC,
      REWRITE_TAC [IN_ELIM_THM, GE] THEN EXISTS_TAC (← q r"M:num") THEN
      ASM_REWRITE_TAC []],
     TRANS_TAC REAL_LET_TRANS (← q r"l + e / &2") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_SUP_LE, ASM_REAL_ARITH_TAC] THEN CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, GE] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [FORALL_IN_GSPEC] THEN INTRO_TAC "!m; m" THEN
      REMOVE_THEN "h1" MATCH_MP_TAC THEN ASM_ARITH_TAC]])

  pure { has_limsup, has_liminf, HAS_LIMSUP_TRANSFORM, HAS_LIMSUP_EVENTUALLY_UBOUND,
         REALLIM_IMP_HAS_LIMSUP, HAS_LIMSUP_IMP_UBOUND_LE, HAS_LIMSUP_NOT_UBOUND,
         HAS_LIMSUP, LIMSUP_EXISTS, HAS_LIMSUP_LE, HAS_LIMSUP_UBOUND,
         HAS_LIMSUP_SEQUENTIALLY, HAS_LIMSUP_SEQUENTIALLY_WITHIN,
         HAS_LIMSUP_SEQUENTIALLY_IMP_REALLIM_SUP }
/- ------------------------------------------------------------------------- -/
/- Limsup and liminf (part 2).                                               -/
/- (realanalysis.ml 5493-5794)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZX where
  HAS_LIMSUP_SEQUENTIALLY_REALLIM_SUP : thm
  HAS_LIMSUP_AT : thm
  HAS_LIMSUP_AT_REALLIM_SUP : thm
  HAS_LIMSUP_MUL_REALLIM_RIGHT : thm
  HAS_LIMSUP_MUL_REALLIM_LEFT : thm
  HAS_LIMSUP_SEQUENTIALLY_WITHIN_LBOUND_ZERO : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZX [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZH : RZH) (BRZW : RZW) : ExceptT String IO RZX := do
  -- @@SCOPE BEGIN
  let { CONJ_LIST, .. } := D
  let { REALLIM_CONST, tendsto_real, .. } := BRZA
  let { REALLIM_AT, REALLIM_LBOUND, REALLIM_SEQUENTIALLY, .. } := BRZB
  let { REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_AT_ID, real_continuous_atreal,
        REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_MUL, .. } := BRZH
  let { HAS_LIMSUP, has_limsup, HAS_LIMSUP_IMP_UBOUND_LE, HAS_LIMSUP_LE,
        HAS_LIMSUP_SEQUENTIALLY, HAS_LIMSUP_SEQUENTIALLY_IMP_REALLIM_SUP,
        REALLIM_IMP_HAS_LIMSUP, .. } := BRZW
  let { EVENTUALLY_HAPPENS, EVENTUALLY_UBOUND_LE_SEQUENTIALLY,
        TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN, .. } := D.qmetric
  let { HAS_INF, REAL_ABS_BETWEEN, SUP_APPROACH, .. } := D.qsession
  let { CUT_TAC, REFUTE_THEN, SUBST_VAR_TAC, .. } := D.ts.cn.ms.ig
  let { ELEMENT_LE_SUP, .. } := D.ts.cn.ms.qsession
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC,
        NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { CLAIM_TAC, HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { DE_MORGAN_THM, DIMINDEX_GE_1, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { GE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_REFL, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_REFL, REAL_LTE_TRANS,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_SUB_LT, .. } := D.ts.cn.cx.cvx.core5
  let { NORM_BASIS, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_MUL, .. } := D.ts.cn.cx.cvx.vec3
  let { EVENTUALLY_MONO, EVENTUALLY_TRUE, .. } := D.ts.cn.cx.cvx.met
  let { EVENTUALLY_AT, .. } := D.ts.cn.cx.cvx.top3
  let { EVENTUALLY_MP, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { TRIVIAL_LIMIT_AT, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { EVENTUALLY_AND, .. } := D.ts.cn.ms.ig.dv.dg.qmetric
  let { REAL_LE_RCANCEL_IMP, REAL_SUP_LE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let HAS_LIMSUP_SEQUENTIALLY_REALLIM_SUP ← prove
   r"!f l. (f has_limsup l) sequentially <=>
         (?b. !n. f n <= b) /\
         ((\n. sup {f k | k >= n}) ---> l) sequentially"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL
    [INTRO_TAC "lim" THEN
     ASM_SIMP_TAC [HAS_LIMSUP_SEQUENTIALLY_IMP_REALLIM_SUP] THEN
     REWRITE_TAC [← GSYM EVENTUALLY_UBOUND_LE_SEQUENTIALLY] THEN
     MATCH_MP_TAC HAS_LIMSUP_IMP_UBOUND_LE THEN ASM_MESON_TAC [],
     ALL_TAC] THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY] THEN INTRO_TAC "(@b. b) lim" THEN
    REWRITE_TAC [HAS_LIMSUP_SEQUENTIALLY] THEN CONJ_TAC THENL
    [INTRO_TAC "!c; c" THEN HYP_TAC "lim: +" (SPEC (← q r"c - l:real")) THEN
     ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@N. N"] THEN
     EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
     REMOVE_THEN "n" (HYP_TAC "N: +" o C MATCH_MP) THEN
     ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN, REAL_SUB_LT] THEN
     REWRITE_TAC [← REAL_ARITH (← q r"l + c - l:real = c")] THEN INTRO_TAC "_ hp" THEN
     TRANS_TAC REAL_LE_TRANS (← q r"sup {f k | k >= n:num}") THEN
     ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC ELEMENT_LE_SUP THEN
     CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC] THEN HYP MESON_TAC "b" [],
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"n:num") THEN
      REWRITE_TAC [GE, LE_REFL]],
     ALL_TAC] THEN
    INTRO_TAC "!c; c; !N" THEN HYP_TAC "lim: +" (SPEC (← q r"l - c:real")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN INTRO_TAC "@M. lim" THEN
    MP_TAC (← SPECL [← q r"{f k:real | k >= MAX N M}", ← q r"c:real"] SUP_APPROACH) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL [REWRITE_TAC [GE] THEN SET_TAC [LE_REFL], ALL_TAC] THEN
     CONJ_TAC THENL
     [EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC], ALL_TAC] THEN
     HYP_TAC "lim: +" (SPEC (← q r"MAX N M")) THEN
     ANTS_TAC THENL [ARITH_TAC, ALL_TAC] THEN
     ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
     SIMP_TAC [← REAL_ARITH (← q r"l - (l - c):real = c")],
     ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, GE] THEN INTRO_TAC "@m. m lt" THEN
    EXISTS_TAC (← q r"m:num") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let HAS_LIMSUP_AT ← prove
   r"!f l a:real^N.
     (f has_limsup l) (at a) <=>
     (!c. l < c ==> ?r. &0 < r /\
                        !x. &0 < dist(x,a) /\ dist(x,a) < r ==> f x <= c) /\
     (!c r. &0 < r /\ c < l
            ==> ?x. &0 < dist(x,a) /\ dist(x,a) < r /\ c < f x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_LIMSUP, TRIVIAL_LIMIT_AT] THEN
    REWRITE_TAC [EVENTUALLY_AT, NOT_FORALL_THM, NOT_EXISTS_THM,
                 DE_MORGAN_THM, NOT_IMP, REAL_NOT_LE] THEN
    MESON_TAC [])

  let HAS_LIMSUP_AT_REALLIM_SUP ← prove
   r"!f l a:real^N.
     (f has_limsup l) (at a) <=>
     (?b r. &0 < r /\ (!x. &0 < dist(x,a) /\ dist(x,a) < r ==> f x <= b)) /\
     ((\x. sup{f y | &0 < dist(y,a) /\ dist(y,a) <= dist(x,a)}) ---> l)
     (at a)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_limsup, TRIVIAL_LIMIT_AT] THEN
    EQ_TAC THENL
    [REWRITE_TAC [HAS_INF, EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM,
                  NOT_FORALL_THM] THEN
     INTRO_TAC "(@x0. x0) lim1 lim2" THEN CONJ_TAC THENL
     [HYP_TAC "lim2: @c. bound c" (C MATCH_MP (← REAL_ARITH (← q r"l < l + &1"))) THEN
      REMOVE_THEN "x0" (K ALL_TAC) THEN
      HYP_TAC "bound: @r. rpos bound" (REWRITE_RULE [EVENTUALLY_AT]) THEN
      MAP_EVERY EXISTS_TAC [← q r"c:real", ← q r"r:real"] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
     REWRITE_TAC [REALLIM_AT] THEN INTRO_TAC "!e; epos" THEN
     HYP_TAC "lim2: +" (SPEC (← q r"l + e:real")) THEN
     ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@c. lim lt"] THEN
     HYP_TAC "lim: @d. dpos lim" (REWRITE_RULE [EVENTUALLY_AT]) THEN
     EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN
     INTRO_TAC "!x; xnz xlt" THEN ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
     CONJ_TAC THENL
     [HYP_TAC "lim1: +" (SPEC (← q r"l - e:real")) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> ~(l <= l - e)")] THEN
      REWRITE_TAC [EVENTUALLY_AT, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"dist(x:real^N,a)")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE] THEN
      INTRO_TAC "@y. (y1 y2) lt" THEN
      TRANS_TAC REAL_LTE_TRANS (← q r"f (y:real^N):real") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC ELEMENT_LE_SUP THEN CONJ_TAC THENL
      [ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN EXISTS_TAC (← q r"c:real") THEN
       REPEAT STRIP_TAC THEN REMOVE_THEN "lim" MATCH_MP_TAC THEN
       ASM_REAL_ARITH_TAC,
       REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"y:real^N") THEN
       ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
     TRANS_TAC REAL_LET_TRANS (← q r"c:real") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC REAL_SUP_LE THEN
     CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, DE_MORGAN_THM, NOT_IMP, REAL_NOT_LE] THEN
      ABBREV_TAC (← q r"y:real^N = inv (&2) % (x + a)") THEN
      MAP_EVERY EXISTS_TAC [← q r"f (y:real^N):real", ← q r"y:real^N"] THEN
      CONJ_TAC THENL [ALL_TAC, REFL_TAC] THEN EXPAND_TAC "y" THEN
      REWRITE_TAC [← NORM_ARITH
        (← q r"dist (inv(&2) % (x + a),a:real^N) = inv(&2) * dist(x,a)")] THEN
       ASM_REAL_ARITH_TAC,
       ALL_TAC] THEN
     REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
     REMOVE_THEN "lim" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    INTRO_TAC "(@b0 r0. r0pos b0) lim" THEN REWRITE_TAC [HAS_INF] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
     REWRITE_TAC [NOT_FORALL_THM, EVENTUALLY_AT] THEN
     MAP_EVERY EXISTS_TAC [← q r"b0:real", ← q r"r0:real"] THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC, EVENTUALLY_AT] THEN GEN_TAC THEN
     INTRO_TAC "@d. dpos b" THEN
     REFUTE_THEN (LABEL_TAC "lt" o REWRITE_RULE [REAL_NOT_LE]) THEN
     HYP_TAC "lim: +" (SPEC (← q r"l - b:real") o REWRITE_RULE [REALLIM_AT]) THEN
     ASM_REWRITE_TAC [REAL_SUB_LT, ← GSYM REAL_ABS_BETWEEN] THEN
     REWRITE_TAC [← REAL_ARITH (← q r"l - (l - b):real = b")] THEN
     INTRO_TAC "@r. rpos lim" THEN
     MAP_EVERY (fun l => REMOVE_THEN l (K ALL_TAC)) ["r0pos", "b0"] THEN
     ABBREV_TAC (← q r"r1:real = min r d") THEN
     ABBREV_TAC (← q r"x:real^N = a + (r1 / &2) % basis 1") THEN
     HYP_TAC "lim: +" (SPEC (← q r"x:real^N")) THEN
     ANTS_TAC THENL
     [POP_ASSUM SUBST_VAR_TAC THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
     INTRO_TAC "lim _" THEN CUT_TAC (← q r"b:real < b") THENL
     [REWRITE_TAC [REAL_LT_REFL], ALL_TAC] THEN
     TRANS_TAC REAL_LTE_TRANS
       (← q r"sup {f y | &0 < dist (y,a:real^N) /\ dist (y,a) <= dist (x,a)}") THEN
     ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC REAL_SUP_LE THEN
     CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_EXISTS_THM, DE_MORGAN_THM] THEN
      MAP_EVERY EXISTS_TAC [← q r"f (x:real^N):real", ← q r"x:real^N"] THEN
      REWRITE_TAC [REAL_LE_REFL] THEN EXPAND_TAC "x" THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
      REWRITE_TAC [NORM_MUL] THEN
      SIMP_TAC [NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
     REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
     REMOVE_THEN "b" MATCH_MP_TAC THEN
     CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
     POP_ASSUM MP_TAC THEN EXPAND_TAC "x" THEN
     REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
     REWRITE_TAC [NORM_MUL] THEN
     SIMP_TAC [NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN
     ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    INTRO_TAC "!c; lt" THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"(c + l) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    REWRITE_TAC [EVENTUALLY_AT] THEN
      HYP_TAC "lim -> +" (SPEC (← q r"(c - l) / &2") o REWRITE_RULE [REALLIM_AT]) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"l < c ==> &0 < (c - l) / &2")] THEN
    INTRO_TAC "@d. dpos lim" THEN
    EXISTS_TAC (← q r"min r0 d") THEN CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC REAL_LE_TRANS
      (← q r"sup {f y:real | &0 < dist (y:real^N,a) /\ dist (y,a) <= dist (x,a)}") THEN
    CONJ_TAC THENL
    [MATCH_MP_TAC ELEMENT_LE_SUP THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"b0:real") THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN REMOVE_THEN "b0" MATCH_MP_TAC THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"x:real^N") THEN
      ASM_REWRITE_TAC [REAL_LE_REFL]],
     ALL_TAC] THEN
    HYP_TAC "lim: +" (SPEC (← q r"x:real^N")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    INTRO_TAC "_ +" THEN
    REWRITE_TAC [← REAL_ARITH (← q r"l + (c - l) / &2 = (c + l) / &2")] THEN
    MESON_TAC [REAL_LT_IMP_LE])

  let HAS_LIMSUP_MUL_REALLIM_RIGHT ← (do
    let LEMMA1 ← prove
     r"!a b c. a * b < c
               ==> ?d. &0 < d /\ !x. abs x < d ==> (a + x) * (b + x) < c"
     (INTRO_TAC "!a b c; lt" THEN
      CLAIM_TAC "cont" (← q r"(\x. (a + x) * (b + x)) real_continuous atreal (&0)")
      THENL
      [MATCH_MP_TAC REAL_CONTINUOUS_MUL THEN
       CONJ_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
       REWRITE_TAC [REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_AT_ID],
       ALL_TAC] THEN
      HYP_TAC "cont" (REWRITE_RULE [real_continuous_atreal]) THEN
      HYP_TAC "cont: +" (SPEC (← q r"c - a * b:real")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      INTRO_TAC "@d. dpos cont" THEN EXISTS_TAC (← q r"d:real") THEN
      ASM_REWRITE_TAC [] THEN INTRO_TAC "!x; x" THEN
      HYP_TAC "cont: +" (SPEC (← q r"x:real")) THEN ASM_REAL_ARITH_TAC)
    let LEMMA2 ← prove
     r"!a b c. c < a * b
               ==> ?d. &0 < d /\ !x. abs x < d ==> c < (a + x) * (b + x)"
     (INTRO_TAC "!a b c; lt" THEN
      CLAIM_TAC "cont" (← q r"(\x. (a + x) * (b + x)) real_continuous atreal (&0)")
      THENL
      [MATCH_MP_TAC REAL_CONTINUOUS_MUL THEN
       CONJ_TAC THEN MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
       REWRITE_TAC [REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_AT_ID],
       ALL_TAC] THEN
      HYP_TAC "cont" (REWRITE_RULE [real_continuous_atreal]) THEN
      HYP_TAC "cont: +" (SPEC (← q r"a * b - c:real")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      INTRO_TAC "@d. dpos cont" THEN EXISTS_TAC (← q r"d:real") THEN
      ASM_REWRITE_TAC [] THEN INTRO_TAC "!x; x" THEN
      HYP_TAC "cont: +" (SPEC (← q r"x:real")) THEN ASM_REAL_ARITH_TAC)
    prove
     r"!net f g a b. (f has_limsup a) net /\
                   (g ---> b) net /\
                   eventually (\x:A. &0 <= f x) net /\
                   eventually (\x:A. &0 <= g x) net
                   ==> ((\x. f x * g x) has_limsup a * b) net"
     (INTRO_TAC "!net f g a b; lsup lim fpos gpos" THEN REWRITE_TAC [HAS_LIMSUP]
      THEN
      ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN ASM_REWRITE_TAC [] THEN
      POP_ASSUM (LABEL_TAC "ntriv") THEN CONJ_TAC THENL
      [INTRO_TAC "!c; lt" THEN HYP_TAC "lt -> @d. dpos d" (MATCH_MP LEMMA1) THEN
       HYP_TAC "lim: +" (SPEC (← q r"d / &2") o REWRITE_RULE [tendsto_real]) THEN
       ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
       REWRITE_TAC [] THEN HYP_TAC "lsup: +" (REWRITE_RULE [HAS_LIMSUP]) THEN
       ASM_REWRITE_TAC [] THEN INTRO_TAC "+ _" THEN
       DISCH_THEN (MP_TAC o SPEC (← q r"a + d / &2")) THEN
       ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
       REWRITE_TAC [] THEN HYP (MP_TAC o CONJ_LIST) "fpos gpos" [] THEN
       REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
       REWRITE_TAC [] THEN INTRO_TAC "!x; fp gp; fb; gb" THEN
       TRANS_TAC REAL_LE_TRANS (← q r"(a + d / &2) * (b + d / &2)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC REAL_LT_IMP_LE THEN REMOVE_THEN "d" MATCH_MP_TAC THEN
        ASM_REAL_ARITH_TAC],
       ALL_TAC] THEN
      INTRO_TAC "!c; lt; hp" THEN ASM_CASES_TAC (← q r"b = &0") THENL
      [POP_ASSUM SUBST_VAR_TAC THEN
       HYP_TAC "lt: +" (REWRITE_RULE [REAL_MUL_RZERO]) THEN
       CUT_TAC (← q r"&0 <= c") THENL [REAL_ARITH_TAC, ALL_TAC] THEN
       CUT_TAC (← q r"eventually (\x:A. &0 <= c) net") THENL
       [DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
       MAP_EVERY (C REMOVE_THEN MP_TAC) ["fpos", "gpos", "hp"] THEN
       REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
       REWRITE_TAC [] THEN INTRO_TAC "!x; (fg g) f" THEN
       TRANS_TAC REAL_LE_TRANS (← q r"f (x:A) * g x:real") THEN ASM_SIMP_TAC [REAL_LE_MUL],
       ALL_TAC] THEN
      POP_ASSUM (LABEL_TAC "bnz") THEN CLAIM_TAC "bpos" (← q r"&0 < b") THENL
      [CUT_TAC (← q r"&0 <= b") THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       MATCH_MP_TAC REALLIM_LBOUND THEN
       MAP_EVERY EXISTS_TAC [← q r"net:A net", ← q r"g:A->real"] THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      REMOVE_THEN "bnz" (K ALL_TAC) THEN
      HYP_TAC "lt: @d. dpos lt" (MATCH_MP LEMMA2) THEN
      HYP_TAC "lsup: +" (REWRITE_RULE [HAS_LIMSUP]) THEN
      ASM_REWRITE_TAC [DE_MORGAN_THM] THEN DISJ2_TAC THEN
      ABBREV_TAC (← q r"r = min b d / &2") THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN EXISTS_TAC (← q r"a - r / &2") THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      HYP_TAC "lim: +" (SPEC (← q r"r / &2") o REWRITE_RULE [tendsto_real]) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      HYP (MP_TAC o CONJ_LIST) "fpos gpos hp" [] THEN
      REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      REWRITE_TAC [] THEN INTRO_TAC "!x; (fp gp c) g" THEN
      MATCH_MP_TAC REAL_LE_RCANCEL_IMP THEN EXISTS_TAC (← q r"b - r / &2") THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"f(x:A) * g x:real") THEN CONJ_TAC THENL
      [MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
       ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"c:real") THEN ASM_REWRITE_TAC [] THEN
      REMOVE_THEN "lt" (MP_TAC o SPEC (← q r"-- r / &2")) THEN ASM_REAL_ARITH_TAC))

  let HAS_LIMSUP_MUL_REALLIM_LEFT ← prove
   r"!net f g a b. (f ---> a) net /\
                 (g has_limsup b) net /\
                 eventually (\x:A. &0 <= f x) net /\
                 eventually (\x:A. &0 <= g x) net
                 ==> ((\x. f x * g x) has_limsup a * b) net"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [HAS_LIMSUP_MUL_REALLIM_RIGHT])

  let HAS_LIMSUP_SEQUENTIALLY_WITHIN_LBOUND_ZERO ← prove
   r"!f b k. (f has_limsup b) (sequentially within k)  /\ (!x. &0 <= f x) /\
            ~(FINITE k)
            ==> &0 <= b"
   (INTRO_TAC "!f b k;lim pos fin" THEN
    MP_TAC (← ISPECL [← q r"sequentially within k", ← q r"(\n:num. &0)",
                      ← q r"f:num->real", ← q r"&0", ← q r"b:real"]
            HAS_LIMSUP_LE) THEN
    ANTS_TAC THENL
    [ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN, EVENTUALLY_TRUE] THEN
     MATCH_MP_TAC REALLIM_IMP_HAS_LIMSUP THEN
     ASM_REWRITE_TAC [REALLIM_CONST],
     ASM_SIMP_TAC []])

  pure { HAS_LIMSUP_SEQUENTIALLY_REALLIM_SUP, HAS_LIMSUP_AT, HAS_LIMSUP_AT_REALLIM_SUP,
         HAS_LIMSUP_MUL_REALLIM_RIGHT, HAS_LIMSUP_MUL_REALLIM_LEFT,
         HAS_LIMSUP_SEQUENTIALLY_WITHIN_LBOUND_ZERO }
/- ------------------------------------------------------------------------- -/
/- Limsup and liminf (part 3: liminf).                                       -/
/- (realanalysis.ml 5795-6039)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZY where
  HAS_LIMINF_TRANSFORM : thm
  HAS_LIMINF_EVENTUALLY_LBOUND : thm
  REALLIM_IMP_HAS_LIMINF : thm
  HAS_LIMINF_IMP_LBOUND_LE : thm
  HAS_LIMINF_NOT_LBOUND : thm
  HAS_LIMINF : thm
  LIMINF_EXISTS : thm
  HAS_LIMINF_LE : thm
  HAS_LIMINF_LBOUND : thm
  HAS_LIMINF_SEQUENTIALLY : thm
  HAS_LIMINF_SEQUENTIALLY_WITHIN : thm
  HAS_LIMINF_SEQUENTIALLY_IMP_REALLIM_INF : thm
  HAS_LIMINF_SEQUENTIALLY_REALLIM_INF : thm
  HAS_LIMINF_AT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZY [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZW : RZW) : ExceptT String IO RZY := do
  -- @@SCOPE BEGIN
  let { REALLIM_CONST, tendsto_real, .. } := BRZA
  let { REALLIM_LBOUND, REALLIM_SEQUENTIALLY, .. } := BRZB
  let { has_liminf, .. } := BRZW
  let { EVENTUALLY_IFF, EVENTUALLY_LBOUND_LE_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY_WITHIN,
        EVENTUALLY_TRIVIAL, TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN, .. } := D.qmetric
  let { HAS_SUP, HAS_SUP_APPROACH, HAS_SUP_UBOUND, INF_APPROACH, REAL_ABS_BETWEEN,
        SUP_EXISTS, .. } := D.qsession
  let { REAL_LT_BETWEEN, .. } := D.ts.cn.ms.qmisc
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { CLAIM_TAC, HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { CONTRAPOS_THM, DE_MORGAN_THM, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { GE, IMP_CONJ, INF_LE_ELEMENT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_REFL, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_INF, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LTE_TRANS,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LT, .. } := D.ts.cn.cx.cvx.core5
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.ts.cn.cx.cvx.met
  let { EVENTUALLY_AT, .. } := D.ts.cn.cx.cvx.top3
  let { ALWAYS_EVENTUALLY, EVENTUALLY_MP, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { TRIVIAL_LIMIT_AT, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { EVENTUALLY_AND, .. } := D.ts.cn.ms.ig.dv.dg.qmetric
  -- @@SCOPE END

  let HAS_LIMINF_TRANSFORM ← prove
   r"!net f g l. eventually (\x:A. f x = g x) net /\ (f has_liminf l) net
               ==> (g has_liminf l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_liminf] THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN ASM_REWRITE_TAC [] THEN
    INTRO_TAC "e l" THEN
    SUBGOAL_THEN
      (← q r"!b. eventually (\x:A. b <= g x) net <=> eventually (\x. b <= f x) net")
      (fun th => ASM_REWRITE_TAC [th]) THEN
    GEN_TAC THEN MATCH_MP_TAC EVENTUALLY_IFF THEN REWRITE_TAC [] THEN
    REMOVE_THEN "e" MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN SIMP_TAC [])

  let HAS_LIMINF_EVENTUALLY_LBOUND ← prove
   r"!net f l b. ~trivial_limit net /\ (f has_liminf l) net /\ b < l
               ==> eventually (\x:A. b < f x) net"
   (INTRO_TAC "! *; ntriv +" THEN ASM_REWRITE_TAC [has_liminf] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_SUP_APPROACH) THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN INTRO_TAC "@c. + le" THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let REALLIM_IMP_HAS_LIMINF ← prove
   r"!net f:A->real l. (f ---> l) net ==> (f has_liminf l) net"
   (INTRO_TAC "!net f l; lim" THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
    ASM_REWRITE_TAC [has_liminf] THEN POP_ASSUM (LABEL_TAC "ntriv") THEN
    REWRITE_TAC [HAS_SUP] THEN CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
     EXISTS_TAC (← q r"l - &1") THEN HYP_TAC "lim: +" (REWRITE_RULE [tendsto_real]) THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
     ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
     MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN REAL_ARITH_TAC,
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [REALLIM_LBOUND],
     ALL_TAC] THEN
    INTRO_TAC "!c; c" THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"(l + c) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    HYP_TAC "lim: +" (SPEC (← q r"(l - c) / &2") o REWRITE_RULE [tendsto_real]) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let HAS_LIMINF_IMP_LBOUND_LE ← prove
   r"!net f l. (f has_liminf l) net ==> ?b. eventually (\x:A. b <= f x) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_liminf] THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THENL
    [ASM_SIMP_TAC [EVENTUALLY_TRIVIAL], POP_ASSUM (LABEL_TAC "ntriv")] THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [HAS_SUP] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN INTRO_TAC "_ _ hp" THEN
    HYP_TAC "hp: +" (SPEC (← q r"l - &1")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN MESON_TAC [])

  let HAS_LIMINF_NOT_LBOUND ← prove
   r"!net f l c.
     ~trivial_limit net /\ (f has_liminf l) net /\ l < c
     ==> ~eventually (\x:A. c <= f x) net"
   (REWRITE_TAC [has_liminf] THEN INTRO_TAC "!net f l c; ntriv + lt" THEN
    ASM_REWRITE_TAC [] THEN INTRO_TAC "inf; c" THEN
    SUBGOAL_THEN (← q r"c <= l") (fun th => MP_TAC th THEN ASM_REAL_ARITH_TAC) THEN
    MATCH_MP_TAC HAS_SUP_UBOUND THEN
    EXISTS_TAC (← q r"{b | eventually (\x:A. b <= f x) net}") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM])

  let HAS_LIMINF ← prove
   r"!net f l. (f has_liminf l) net <=>
             trivial_limit net \/
             (!c. c < l ==> eventually (\x:A. c <= f x) net) /\
             (!c. l < c ==> ~eventually (\x:A. c <= f x) net)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THENL
    [ASM_REWRITE_TAC [has_liminf], POP_ASSUM (LABEL_TAC "ntriv")] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
    [INTRO_TAC "liminf" THEN CONJ_TAC THENL
     [INTRO_TAC "!c; lt" THEN MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"(\x:A. c < f x)") THEN CONJ_TAC THENL
      [REAL_ARITH_TAC, ASM_MESON_TAC [HAS_LIMINF_EVENTUALLY_LBOUND]],
      ASM_MESON_TAC [HAS_LIMINF_NOT_LBOUND]],
     ALL_TAC] THEN
    INTRO_TAC "ubound lbound" THEN ASM_REWRITE_TAC [has_liminf] THEN
    REWRITE_TAC [HAS_SUP] THEN CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
     EXISTS_TAC (← q r"l - &1") THEN REMOVE_THEN "ubound" MATCH_MP_TAC THEN
     REAL_ARITH_TAC,
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [REAL_NOT_LE], ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    INTRO_TAC "!c; lt" THEN EXISTS_TAC (← q r"(c + l) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    REMOVE_THEN "ubound" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC)

  let LIMINF_EXISTS ← prove
   r"!net f. (?l. (f has_liminf l) net) <=>
           trivial_limit net \/
           (?b. eventually (\x:A. b <= f x) net) /\
           (?c. ~eventually (\x. c <= f x) net)"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL
    [REWRITE_TAC [HAS_LIMINF] THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
     ASM_REWRITE_TAC [] THEN STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [← REAL_ARITH (← q r"l - &1 < l")], ALL_TAC] THEN
     EXISTS_TAC (← q r"l + &1") THEN POP_ASSUM (MP_TAC o SPEC (← q r"l + &1")) THEN
     ANTS_TAC THENL [REAL_ARITH_TAC, REWRITE_TAC [CONTRAPOS_THM]],
     ALL_TAC] THEN
    REWRITE_TAC [has_liminf] THEN ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THEN
    ASM_REWRITE_TAC [] THEN INTRO_TAC "(@b. b) (@c. c)" THEN
    REWRITE_TAC [SUP_EXISTS] THEN CONJ_TAC THENL
    [ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [IN_ELIM_THM],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"c:real") THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    INTRO_TAC "![x]; x" THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
    INTRO_TAC "lt" THEN REMOVE_THEN "x" MP_TAC THEN
    REMOVE_THEN "c" MP_TAC THEN REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_REAL_ARITH_TAC)

  let HAS_LIMINF_LE ← prove
   r"!net f g l m.
     (f has_liminf l) net /\
     (g has_liminf m) net /\
     ~trivial_limit net /\
     eventually (\x:A. f x <= g x) net
     ==> l <= m"
   (INTRO_TAC "!net f g l m; l m notriv le" THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN ONCE_REWRITE_TAC [REAL_LT_BETWEEN] THEN
    INTRO_TAC "@c. c1 c2" THEN
    CLAIM_TAC "f" (← q r"eventually (\x:A. c < f x) net") THENL
    [MATCH_MP_TAC HAS_LIMINF_EVENTUALLY_LBOUND THEN ASM_MESON_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "+" (← q r"eventually (\x:A. c <= g x) net") THENL
    [MATCH_MP_TAC EVENTUALLY_MP THEN
     EXISTS_TAC (← q r"\x:A. c < f x /\ f x <= g x") THEN CONJ_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_REAL_ARITH_TAC,
      ASM_REWRITE_TAC [EVENTUALLY_AND]],
     REWRITE_TAC []] THEN
     MATCH_MP_TAC HAS_LIMINF_NOT_LBOUND THEN ASM_MESON_TAC [])

  let HAS_LIMINF_LBOUND ← prove
   r"!net f b l. eventually (\x:A. b <= f x) net /\
               (f has_liminf l) net /\
               ~trivial_limit net
               ==> b <= l"
   (INTRO_TAC "!net f b l; lb lim ntriv" THEN MATCH_MP_TAC HAS_LIMINF_LE THEN
    MAP_EVERY EXISTS_TAC [← q r"net:A net", ← q r"\x:A. b:real", ← q r"f:A->real"] THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REALLIM_IMP_HAS_LIMINF THEN
    ASM_REWRITE_TAC [REALLIM_CONST])

  let HAS_LIMINF_SEQUENTIALLY ← prove
   r"!a l. (a has_liminf l) sequentially <=>
         (!c. c < l ==> ?N. !n. N <= n ==> c <= a n) /\
         (!c. l < c ==> !N. ?n. N <= n /\ a n < c)"
   (REWRITE_TAC [HAS_LIMINF, TRIVIAL_LIMIT_SEQUENTIALLY,
                 EVENTUALLY_SEQUENTIALLY] THEN
    MESON_TAC [REAL_NOT_LE])

  let HAS_LIMINF_SEQUENTIALLY_WITHIN ← prove
   r"!a l k. (a has_liminf l) (sequentially within k) <=>
           FINITE k \/
           (!c. c < l ==> (?N. !n. n IN k /\ N <= n ==> c <= a n)) /\
           (!c. l < c ==> (!N. ?n. n IN k /\ N <= n /\ a n < c))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THEN
    ASM_REWRITE_TAC [HAS_LIMINF, TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN] THEN
    ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
    MESON_TAC [REAL_NOT_LE])

  let HAS_LIMINF_SEQUENTIALLY_IMP_REALLIM_INF ← prove
   r"!f l. (f has_liminf l) sequentially
         ==> ((\n. inf {f m | m >= n}) ---> l) sequentially"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY, HAS_LIMINF_SEQUENTIALLY] THEN
    INTRO_TAC "h1 h2; !e; epos" THEN HYP_TAC "h1: +" (SPEC (← q r"l - e / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@N. h1"] THEN
    HYP_TAC "h2: +" (SPEC (← q r"l + e:real")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "h2"] THEN
    EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
    ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
    HYP_TAC "h2: @M. le M" (SPEC (← q r"n:num")) THEN CONJ_TAC THENL
    [TRANS_TAC REAL_LTE_TRANS (← q r"l - e / &2") THEN
     CONJ_TAC THENL [ASM_REAL_ARITH_TAC, MATCH_MP_TAC REAL_LE_INF] THEN
     CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, GE] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [FORALL_IN_GSPEC] THEN INTRO_TAC "!m; m" THEN
      REMOVE_THEN "h1" MATCH_MP_TAC THEN ASM_ARITH_TAC],
     TRANS_TAC REAL_LET_TRANS (← q r"f (M:num):real") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC INF_LE_ELEMENT THEN CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC] THEN EXISTS_TAC (← q r"l - e / &2") THEN
      INTRO_TAC "!m; m" THEN REMOVE_THEN "h1" MATCH_MP_TAC THEN ASM_ARITH_TAC,
      REWRITE_TAC [IN_ELIM_THM, GE] THEN EXISTS_TAC (← q r"M:num") THEN
      ASM_REWRITE_TAC []]])

  let HAS_LIMINF_SEQUENTIALLY_REALLIM_INF ← prove
   r"!f l. (f has_liminf l) sequentially <=>
         (?b. !n. b <= f n) /\
         ((\n. inf {f k | k >= n}) ---> l) sequentially"
   (GEN_TAC THEN GEN_TAC THEN EQ_TAC THENL
    [INTRO_TAC "lim" THEN
     ASM_SIMP_TAC [HAS_LIMINF_SEQUENTIALLY_IMP_REALLIM_INF] THEN
     REWRITE_TAC [← GSYM EVENTUALLY_LBOUND_LE_SEQUENTIALLY] THEN
     MATCH_MP_TAC HAS_LIMINF_IMP_LBOUND_LE THEN ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY] THEN INTRO_TAC "(@b. b) lim" THEN
    REWRITE_TAC [HAS_LIMINF_SEQUENTIALLY] THEN CONJ_TAC THENL
    [INTRO_TAC "!c; c" THEN HYP_TAC "lim: +" (SPEC (← q r"l - c:real")) THEN
     ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@N. N"] THEN
     EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
     REMOVE_THEN "n" (HYP_TAC "N: +" o C MATCH_MP) THEN
     ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN, REAL_SUB_LT] THEN
     REWRITE_TAC [← REAL_ARITH (← q r"l - (l - c):real = c")] THEN INTRO_TAC "hp _" THEN
     TRANS_TAC REAL_LE_TRANS (← q r"inf {f k | k >= n:num}") THEN
     ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC INF_LE_ELEMENT THEN
     CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC] THEN HYP MESON_TAC "b" [],
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"n:num") THEN
      REWRITE_TAC [GE, LE_REFL]], ALL_TAC] THEN
    INTRO_TAC "!c; c; !N" THEN HYP_TAC "lim: +" (SPEC (← q r"c - l:real")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN INTRO_TAC "@M. lim" THEN
    MP_TAC (← SPECL [← q r"{f k:real | k >= MAX N M}", ← q r"c:real"] INF_APPROACH) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL [REWRITE_TAC [GE] THEN SET_TAC [LE_REFL], ALL_TAC] THEN
     CONJ_TAC THENL
     [EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC], ALL_TAC] THEN
     HYP_TAC "lim: +" (SPEC (← q r"MAX N M")) THEN
     ANTS_TAC THENL [ARITH_TAC, ALL_TAC] THEN
     ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
     SIMP_TAC [← REAL_ARITH (← q r"l + (c - l):real = c")], ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, GE] THEN INTRO_TAC "@m. m lt" THEN
    EXISTS_TAC (← q r"m:num") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let HAS_LIMINF_AT ← prove
   r"!f l a:real^N.
     (f has_liminf l) (at a) <=>
     (!c. c < l ==> ?r. &0 < r /\
                        !x. &0 < dist(x,a) /\ dist(x,a) < r ==> c <= f x) /\
     (!c r. &0 < r /\ l < c
            ==> ?x. &0 < dist(x,a) /\ dist(x,a) < r /\ f x < c)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_LIMINF, TRIVIAL_LIMIT_AT] THEN
    REWRITE_TAC [EVENTUALLY_AT, NOT_FORALL_THM, NOT_EXISTS_THM,
                 DE_MORGAN_THM, NOT_IMP, REAL_NOT_LE] THEN
    MESON_TAC [])

  pure { HAS_LIMINF_TRANSFORM, HAS_LIMINF_EVENTUALLY_LBOUND, REALLIM_IMP_HAS_LIMINF,
         HAS_LIMINF_IMP_LBOUND_LE, HAS_LIMINF_NOT_LBOUND, HAS_LIMINF, LIMINF_EXISTS,
         HAS_LIMINF_LE, HAS_LIMINF_LBOUND, HAS_LIMINF_SEQUENTIALLY,
         HAS_LIMINF_SEQUENTIALLY_WITHIN, HAS_LIMINF_SEQUENTIALLY_IMP_REALLIM_INF,
         HAS_LIMINF_SEQUENTIALLY_REALLIM_INF, HAS_LIMINF_AT }
/- ------------------------------------------------------------------------- -/
/- Liminf at a point; root test for series.                                  -/
/- (realanalysis.ml 6040-6226)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZZ where
  HAS_LIMINF_AT_REALLIM_INF : thm
  REAL_SERIES_ROOT_TEST : thm
  SERIES_ROOT_TEST : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZZ [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZC : RZC) (BRZE : RZE) (BRZW : RZW) : ExceptT String IO RZZ := do
  -- @@SCOPE BEGIN
  let { REALLIM_CONST, .. } := BRZA
  let { REALLIM_AT, .. } := BRZB
  let { real_summable, REAL_SUMMABLE_FINITE, .. } := BRZC
  let { REAL_SERIES_COMPARISON, REAL_SUMMABLE_GP, SERIES_NORMCONV_IMP_CONV, .. } := BRZE
  let { has_liminf, HAS_LIMSUP_EVENTUALLY_UBOUND, HAS_LIMSUP_LE, REALLIM_IMP_HAS_LIMSUP,
        .. } := BRZW
  let { REAL_POW_ROOT, ROOT_LE_0, ROOT_POS_LE, .. } := D.tsaa
  let { EVENTUALLY_SEQUENTIALLY_WITHIN, TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN, WITHIN,
        .. } := D.qmetric
  let { HAS_SUP, INFINITE_NONEMPTY, REAL_ABS_BETWEEN, .. } := D.qsession
  let { CUT_TAC, REFUTE_THEN, SUBST_VAR_TAC, .. } := D.ts.cn.ms.ig
  let { ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, INTRO_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { INFINITE, .. } := D.ts.cn.cx.cpx
  let { CLAIM_TAC, HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { DE_MORGAN_THM, DIMINDEX_GE_1, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { GE, INF_LE_ELEMENT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_REFL, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_INF, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE,
        REAL_LT_REFL, REAL_LTE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_POW_LE2, REAL_SUB_LT, .. } := D.ts.cn.cx.cvx.core5
  let { real_abs, .. } := D.ts.cn.cx.cvx.core6
  let { NORM_BASIS, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.ts.cn.cx.cvx.vec3
  let { EVENTUALLY_AT, .. } := D.ts.cn.cx.cvx.top3
  let { SEQUENTIALLY, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { TRIVIAL_LIMIT_AT, .. } := D.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let HAS_LIMINF_AT_REALLIM_INF ← prove
   r"!f l a:real^N.
     (f has_liminf l) (at a) <=>
     (?b r. &0 < r /\ (!x. &0 < dist(x,a) /\ dist(x,a) < r ==> b <= f x)) /\
     ((\x. inf{f y | &0 < dist(y,a) /\ dist(y,a) <= dist(x,a)}) ---> l)
     (at a)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_liminf, TRIVIAL_LIMIT_AT] THEN
    EQ_TAC THENL
    [REWRITE_TAC [HAS_SUP, EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM,
                  NOT_FORALL_THM] THEN
     INTRO_TAC "(@x0. x0) lim1 lim2" THEN CONJ_TAC THENL
     [HYP_TAC "lim2: @c. bound c" (C MATCH_MP (← REAL_ARITH (← q r"l - &1 < l"))) THEN
      REMOVE_THEN "x0" (K ALL_TAC) THEN
      HYP_TAC "bound: @r. rpos bound" (REWRITE_RULE [EVENTUALLY_AT]) THEN
      MAP_EVERY EXISTS_TAC [← q r"c:real", ← q r"r:real"] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [REALLIM_AT] THEN INTRO_TAC "!e; epos" THEN
    HYP_TAC "lim2: +" (SPEC (← q r"l - e:real")) THEN
     ANTS_TAC THENL [ASM_REAL_ARITH_TAC, INTRO_TAC "@c. lim lt"] THEN
     HYP_TAC "lim: @d. dpos lim" (REWRITE_RULE [EVENTUALLY_AT]) THEN
     EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN
     INTRO_TAC "!x; xnz xlt" THEN ASM_REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
     CONJ_TAC THENL
     [ALL_TAC, HYP_TAC "lim1: +" (SPEC (← q r"l + e:real")) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> ~(l + e <= l)")] THEN
      REWRITE_TAC [EVENTUALLY_AT, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"dist(x:real^N,a)")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE] THEN
      INTRO_TAC "@y. (y1 y2) lt" THEN
      TRANS_TAC REAL_LET_TRANS (← q r"f (y:real^N):real") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC INF_LE_ELEMENT THEN CONJ_TAC THENL
      [ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN EXISTS_TAC (← q r"c:real") THEN
       REPEAT STRIP_TAC THEN REMOVE_THEN "lim" MATCH_MP_TAC THEN
       ASM_REAL_ARITH_TAC,
       REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"y:real^N") THEN
       ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]] THEN
     TRANS_TAC REAL_LTE_TRANS (← q r"c:real") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC REAL_LE_INF THEN
     CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, DE_MORGAN_THM, NOT_IMP, REAL_NOT_LE] THEN
      ABBREV_TAC (← q r"y:real^N = inv (&2) % (x + a)") THEN
      MAP_EVERY EXISTS_TAC [← q r"f (y:real^N):real", ← q r"y:real^N"] THEN
      CONJ_TAC THENL [ALL_TAC, REFL_TAC] THEN EXPAND_TAC "y" THEN
      REWRITE_TAC [← NORM_ARITH
        (← q r"dist (inv(&2) % (x + a),a:real^N) = inv(&2) * dist(x,a)")] THEN
       ASM_REAL_ARITH_TAC,
       ALL_TAC] THEN
     REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
     REMOVE_THEN "lim" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    INTRO_TAC "(@b0 r0. r0pos b0) lim" THEN REWRITE_TAC [HAS_SUP] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
     REWRITE_TAC [NOT_FORALL_THM, EVENTUALLY_AT] THEN
     MAP_EVERY EXISTS_TAC [← q r"b0:real", ← q r"r0:real"] THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FORALL_IN_GSPEC, EVENTUALLY_AT] THEN GEN_TAC THEN
     INTRO_TAC "@d. dpos b" THEN
     REFUTE_THEN (LABEL_TAC "lt" o REWRITE_RULE [REAL_NOT_LE]) THEN
     HYP_TAC "lim: +" (SPEC (← q r"b - l:real") o REWRITE_RULE [REALLIM_AT]) THEN
     ASM_REWRITE_TAC [REAL_SUB_LT, ← GSYM REAL_ABS_BETWEEN] THEN
     REWRITE_TAC [← REAL_ARITH (← q r"l + (b - l):real = b")] THEN
     INTRO_TAC "@r. rpos lim" THEN
     MAP_EVERY (fun l => REMOVE_THEN l (K ALL_TAC)) ["r0pos", "b0"] THEN
     ABBREV_TAC (← q r"r1 = min r d") THEN
     ABBREV_TAC (← q r"x:real^N = a + (r1 / &2) % basis 1") THEN
     HYP_TAC "lim: +" (SPEC (← q r"x:real^N")) THEN
     ANTS_TAC THENL
     [POP_ASSUM SUBST_VAR_TAC THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
     INTRO_TAC "_ lim" THEN CUT_TAC (← q r"b < b") THENL
     [REWRITE_TAC [REAL_LT_REFL], ALL_TAC] THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"inf {f y | &0 < dist (y,a:real^N) /\ dist (y,a) <= dist (x,a)}") THEN
     ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC REAL_LE_INF THEN
     CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_EXISTS_THM, DE_MORGAN_THM] THEN
      MAP_EVERY EXISTS_TAC [← q r"f (x:real^N):real", ← q r"x:real^N"] THEN
      REWRITE_TAC [REAL_LE_REFL] THEN EXPAND_TAC "x" THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
      REWRITE_TAC [NORM_MUL] THEN
      SIMP_TAC [NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
     REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
     REMOVE_THEN "b" MATCH_MP_TAC THEN
     CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
     POP_ASSUM MP_TAC THEN EXPAND_TAC "x" THEN
     REWRITE_TAC [← NORM_ARITH (← q r"dist(a+v,a:real^N) = norm v")] THEN
     REWRITE_TAC [NORM_MUL] THEN
     SIMP_TAC [NORM_BASIS, LE_REFL, DIMINDEX_GE_1] THEN
     ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    INTRO_TAC "!c; lt" THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"(c + l) / &2") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    REWRITE_TAC [EVENTUALLY_AT] THEN
    HYP_TAC "lim -> +" (SPEC (← q r"(l - c) / &2") o REWRITE_RULE [REALLIM_AT]) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [← GSYM REAL_ABS_BETWEEN] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"c < l ==> &0 < (l - c) / &2")] THEN
    INTRO_TAC "@d. dpos lim" THEN
    EXISTS_TAC (← q r"min r0 d") THEN CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC REAL_LE_TRANS
      (← q r"inf {f y:real | &0 < dist (y:real^N,a) /\ dist (y,a) <= dist (x,a)}") THEN
    CONJ_TAC THENL
    [ALL_TAC, MATCH_MP_TAC INF_LE_ELEMENT THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"b0:real") THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN REMOVE_THEN "b0" MATCH_MP_TAC THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"x:real^N") THEN
      ASM_REWRITE_TAC [REAL_LE_REFL]]] THEN
    HYP_TAC "lim: +" (SPEC (← q r"x:real^N")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    INTRO_TAC "+ _" THEN
    REWRITE_TAC [← REAL_ARITH (← q r"l - (l - c) / &2 = (c + l) / &2")] THEN
    MESON_TAC [REAL_LT_IMP_LE])

  -- Root test for series.

  let REAL_SERIES_ROOT_TEST ← prove
   r"!a b k. (!n. n IN k ==> &0 <= a n) /\ b < &1 /\
           ((\n. root n (a n)) has_limsup b) (sequentially within k)
           ==> real_summable k a"
   (INTRO_TAC "!a b k; a b im_sup" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [ASM_SIMP_TAC [REAL_SUMMABLE_FINITE], POP_ASSUM (LABEL_TAC "fin")] THEN
    CLAIM_TAC "bpos" (← q r"&0 <= b") THENL
    [MATCH_MP_TAC (← ISPEC (← q r"sequentially within k") HAS_LIMSUP_LE) THEN
     MAP_EVERY EXISTS_TAC [← q r"\n:num. &0", ← q r"\n. root n (a n)"] THEN
     ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN] THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC REALLIM_IMP_HAS_LIMSUP THEN REWRITE_TAC [REALLIM_CONST],
      ALL_TAC] THEN
     ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
     REWRITE_TAC [ROOT_LE_0, WITHIN, SEQUENTIALLY, GE] THEN
     HYP SIMP_TAC "a" [] THEN
     CLAIM_TAC "@a. a" (← q r"?a:num. a IN k") THENL
     [HYP MESON_TAC "fin" [INFINITE, INFINITE_NONEMPTY, MEMBER_NOT_EMPTY],
      ALL_TAC] THEN
     EXISTS_TAC (← q r"a:num") THEN EXISTS_TAC (← q r"a:num") THEN
     ASM_REWRITE_TAC [LE_REFL],
     ALL_TAC] THEN
    CLAIM_TAC "bound"
      (← q r"eventually (\n. root n (a n) < b + (&1 - b) * inv(&2))
                  (sequentially within k)") THENL
    [MATCH_MP_TAC HAS_LIMSUP_EVENTUALLY_UBOUND THEN
     ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN] THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    REMOVE_THEN "bound" MP_TAC THEN
    ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
    INTRO_TAC "@N. bound" THEN
    REWRITE_TAC [real_summable] THEN MATCH_MP_TAC REAL_SERIES_COMPARISON THEN
    EXISTS_TAC (← q r"\n. (b + (&1 - b) * inv (&2)) pow n") THEN
    CONJ_TAC THENL
    [REWRITE_TAC [← GSYM real_summable] THEN MATCH_MP_TAC REAL_SUMMABLE_GP THEN
     ASM_REAL_ARITH_TAC,
     ALL_TAC] THEN
    EXISTS_TAC (← q r"N + 1") THEN REWRITE_TAC [GE] THEN INTRO_TAC "!n; n IN" THEN
    ASM_SIMP_TAC [real_abs] THEN
    SUBGOAL_THEN (← q r"a n = root n (a n) pow n") SUBST1_TAC THENL
    [MATCH_MP_TAC (← GSYM REAL_POW_ROOT) THEN ASM_SIMP_TAC [] THEN ASM_ARITH_TAC,
     ALL_TAC] THEN
    MATCH_MP_TAC REAL_POW_LE2 THEN ASM_SIMP_TAC [ROOT_POS_LE] THEN
    MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let SERIES_ROOT_TEST ← prove
   r"!a:num->real^N b k.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\ b < &1
     ==> summable k a"
   (INTRO_TAC "!a b k; lim b" THEN
    MATCH_MP_TAC SERIES_NORMCONV_IMP_CONV THEN
    MATCH_MP_TAC REAL_SERIES_ROOT_TEST THEN
    EXISTS_TAC (← q r"b:real") THEN ASM_SIMP_TAC [NORM_POS_LE])

  pure { HAS_LIMINF_AT_REALLIM_INF, REAL_SERIES_ROOT_TEST, SERIES_ROOT_TEST }
/- ------------------------------------------------------------------------- -/
/- Cauchy-Hadamard formula for radius of convergence of real and complex    -/
/- power series and their derivative.                                        -/
/- (realanalysis.ml 6227-6552)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAA where
  CAUCHY_HADAMARD_RADIUS_ABSCONV : thm
  CAUCHY_HADAMARD_RADIUS : thm
  CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE : thm
  CAUCHY_HADAMARD_RADIUS_DERIVATIVE : thm
  REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV : thm
  REAL_CAUCHY_HADAMARD_RADIUS : thm
  REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE : thm
  REAL_CAUCHY_HADAMARD_RADIUS_DERIVATIVE : thm
  CAUCHY_HADAMARD_RADIUS_UNIFORM : thm
  CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE : thm
  REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM : thm
  REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAA [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZC : RZC) (BRZE : RZE) (BRZR : RZR) (BRZW : RZW) (BRZX : RZX) (BRZZ : RZZ) : ExceptT String IO RZAA := do
  -- @@SCOPE BEGIN
  let { real_compact, REALLIM_CONST, REALLIM_SUB, REALLIM_TRANSFORM_EVENTUALLY, .. } := BRZA
  let { REALLIM_EVENTUALLY, REALLIM_SEQUENTIALLY_WITHIN, .. } := BRZB
  let { REAL_SUMMABLE, REAL_SUMMABLE_FINITE, .. } := BRZC
  let { REAL_SERIES_ABSCONV_IMP_CONV, SERIES_NORMCONV_IMP_CONV, .. } := BRZE
  let { REALLIM_1_OVER_N, REALLIM_ROOT_REFL, REALLIM_RPOW_COMPOSE, .. } := BRZR
  let { HAS_LIMSUP_TRANSFORM, REALLIM_IMP_HAS_LIMSUP, .. } := BRZW
  let { HAS_LIMSUP_MUL_REALLIM_LEFT, HAS_LIMSUP_MUL_REALLIM_RIGHT, .. } := BRZX
  let { REAL_SERIES_ROOT_TEST, .. } := BRZZ
  let { REAL_ROOT_MUL, REAL_ROOT_POW, ROOT_0, ROOT_LE_0, .. } := D.tsaa
  let { REAL_ROOT_RPOW, RPOW_POW, RPOW_RPOW, .. } := D.tsab
  let { EVENTUALLY_SEQUENTIALLY_WITHIN, .. } := D.qmetric
  let { COMPACT_SHRINK_ENCLOSING_BALL_INFTY, .. } := D.qtopology
  let { num_FINITE, .. } := D.qsession
  let { COMPLEX_NORM_CX, CX_MUL, CX_POW, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_MUL, COMPLEX_NORM_POW, .. } := D.ts.cn.cxf
  let { SERIES_COMPARISON_UNIFORM, summable, .. } := D.ts.cn.qtopology
  let { CUT_TAC, .. } := D.ts.cn.ms.ig
  let { REAL_POW_ZERO, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INTRO_TAC, MESON_TAC, REAL_ARITH,
        REAL_FIELD, .. } := D.ts.cn.cx.cvx
  let { LE_0, REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { CLAIM_TAC, HYP_TAC, .. } := D.ts.cn.ms.ig.dv
  let { REAL_ABS_0, .. } := D.ts.cn.ms.ig.qsession
  let { SUM_VSUM, .. } := D.ts.cn.ms.ig.qvec
  let { EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { IN_IMAGE, IN_INTER, IN_NUMSEG, LE_TRANS, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RZERO, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUB, REAL_POS, REAL_POW_LE, REAL_POW_LE2, REAL_SUB_REFL,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, .. } := D.ts.cn.cx.cvx.core6
  let { DIST_1, DIST_REFL, .. } := D.ts.cn.cx.cvx.vec1
  let { NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.ts.cn.cx.cvx.vec3
  let { EVENTUALLY_TRUE, .. } := D.ts.cn.cx.cvx.met
  let { ALWAYS_EVENTUALLY, .. } := D.ts.cn.ms.ig.dv.qmetric
  let { REAL_ABS_ABS, .. } := D.ts.cn.ms.ig.dv.qsession
  let { REAL_ABS_POW, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let CAUCHY_HADAMARD_RADIUS_ABSCONV ← prove
   r"!a k b z:complex.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
     b * norm z < &1
     ==> real_summable k (\n. norm (a n * z pow n))"
   (INTRO_TAC "!a k b z; lim radius" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [ASM_SIMP_TAC [REAL_SUMMABLE_FINITE], POP_ASSUM (LABEL_TAC "fin")] THEN
    MATCH_MP_TAC REAL_SERIES_ROOT_TEST THEN
    EXISTS_TAC (← q r"b:real * norm (z:complex)") THEN ASM_REWRITE_TAC [NORM_POS_LE] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, REAL_ROOT_MUL, COMPLEX_NORM_POW] THEN
    MATCH_MP_TAC HAS_LIMSUP_MUL_REALLIM_RIGHT THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [ROOT_LE_0, REAL_POW_LE, NORM_POS_LE, EVENTUALLY_TRUE] THEN
    MATCH_MP_TAC REALLIM_EVENTUALLY THEN
    ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN EXISTS_TAC (← q r"1") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_ROOT_POW THEN
    REWRITE_TAC [NORM_POS_LE] THEN ASM_ARITH_TAC)

  let CAUCHY_HADAMARD_RADIUS ← prove
   r"!a k b z:complex.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
     b * norm z < &1
     ==> summable k (\n. a n * z pow n)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_NORMCONV_IMP_CONV THEN
    BETA_TAC THEN MATCH_MP_TAC CAUCHY_HADAMARD_RADIUS_ABSCONV THEN
    EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [])

  let CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE ← prove
   r"!z a k b.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
     b * norm z < &1
     ==> real_summable k (\n. norm (Cx(&n) * a n * z pow (n - 1)))"
   (REPEAT GEN_TAC THEN INTRO_TAC "limsup norm" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [ASM_SIMP_TAC [REAL_SUMMABLE_FINITE], POP_ASSUM (LABEL_TAC "fin")] THEN
    MATCH_MP_TAC REAL_SERIES_ROOT_TEST THEN EXISTS_TAC (← q r"b * norm(z:complex)") THEN
    ASM_REWRITE_TAC [NORM_POS_LE] THEN ASM_CASES_TAC (← q r"norm(z:complex) = &0") THENL
    [ASM_REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, REAL_ROOT_MUL,
                      COMPLEX_NORM_POW] THEN
     MATCH_MP_TAC HAS_LIMSUP_TRANSFORM THEN EXISTS_TAC (← q r"\n:num. &0") THEN
     REWRITE_TAC [REAL_MUL_RZERO] THEN
     SIMP_TAC [REALLIM_IMP_HAS_LIMSUP, REALLIM_CONST] THEN
     ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
     EXISTS_TAC (← q r"2") THEN INTRO_TAC "!n; n le" THEN
     REWRITE_TAC [REAL_POW_ZERO] THEN
     ASM_SIMP_TAC [← ARITH_RULE (← q r"2 <= n ==> ~(n - 1 = 0)")] THEN
     REWRITE_TAC [ROOT_0, REAL_MUL_RZERO],
     ALL_TAC] THEN
    CLAIM_TAC "pos" (← q r"&0 < norm(z:complex)") THENL
    [ASM_MESON_TAC [NORM_POS_LE,
                    ← REAL_ARITH (← q r"!x:real. &0 <= x <=> x = &0 \/ &0 < x")],
     ALL_TAC] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_POW,
                 REAL_ROOT_MUL, REAL_ABS_NUM, ← GSYM REAL_MUL_ASSOC] THEN
    GEN_REWRITE_TAC (RATOR_CONV o RAND_CONV) [← GSYM REAL_MUL_LID] THEN
    MATCH_MP_TAC HAS_LIMSUP_MUL_REALLIM_LEFT THEN
    SIMP_TAC [REALLIM_ROOT_REFL, REALLIM_SEQUENTIALLY_WITHIN] THEN
    REWRITE_TAC [ROOT_LE_0, REAL_POS, EVENTUALLY_TRUE] THEN CONJ_TAC THENL
    [ALL_TAC,
     MATCH_MP_TAC ALWAYS_EVENTUALLY THEN GEN_TAC THEN
     BETA_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
     SIMP_TAC [ROOT_LE_0, REAL_POW_LE, NORM_POS_LE]] THEN
    MATCH_MP_TAC HAS_LIMSUP_MUL_REALLIM_RIGHT THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [ROOT_LE_0, NORM_POS_LE, REAL_POW_LE, EVENTUALLY_TRUE] THEN
    MATCH_MP_TAC REALLIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n:num. norm(z:complex) rpow (&1 - inv(&n))") THEN CONJ_TAC THENL
    [ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
     EXISTS_TAC (← q r"2") THEN INTRO_TAC "!n; n le" THEN
     ASM_SIMP_TAC [REAL_ROOT_RPOW, REAL_POW_LE, NORM_POS_LE, ← GSYM RPOW_POW,
                   RPOW_RPOW, ← ARITH_RULE (← q r"2 <= n ==> ~(n = 0)")] THEN
     AP_TERM_TAC THEN
     ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB, ← ARITH_RULE (← q r"2 <= n ==> 1 <= n")] THEN
     CUT_TAC (← q r"&0 < &n") THENL [CONV_TAC REAL_FIELD, ALL_TAC] THEN
     REWRITE_TAC [REAL_OF_NUM_LT] THEN ASM_ARITH_TAC,
     ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!f:num->real a. (f ---> a) = (f ---> a rpow &1)")
      (fun th => ONCE_REWRITE_TAC [th]) THENL
    [REWRITE_TAC [RPOW_POW, REAL_POW_1], ALL_TAC] THEN
    MATCH_MP_TAC REALLIM_RPOW_COMPOSE THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
    [ASM_SIMP_TAC [REALLIM_CONST, REALLIM_SEQUENTIALLY_WITHIN], ALL_TAC] THEN
    GEN_REWRITE_TAC (RATOR_CONV o RAND_CONV) [← REAL_ARITH (← q r"&1 = &1 - &0")] THEN
    MATCH_MP_TAC REALLIM_SUB THEN
    SIMP_TAC [REALLIM_CONST, REALLIM_1_OVER_N, REALLIM_SEQUENTIALLY_WITHIN])

  let CAUCHY_HADAMARD_RADIUS_DERIVATIVE ← prove
   r"!z a k b.
      ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
      b * norm z < &1
      ==> summable k (\n. Cx(&n) * a n * z pow (n - 1))"
   (REPEAT GEN_TAC THEN INTRO_TAC "limsup norm" THEN
    MATCH_MP_TAC SERIES_NORMCONV_IMP_CONV THEN
    ASM_MESON_TAC [CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE])

  let REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV ← prove
   r"!a k b x.
     ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
     b * abs x < &1
     ==> real_summable k (\n. abs (a n * x pow n))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"\n:num. Cx(a n)", ← q r"k:num->bool", ← q r"b:real", ← q r"Cx x"]
                  CAUCHY_HADAMARD_RADIUS_ABSCONV) THEN
    ASM_REWRITE_TAC [← GSYM CX_POW, ← GSYM CX_MUL, COMPLEX_NORM_CX])

  let REAL_CAUCHY_HADAMARD_RADIUS ← prove
   r"!a k b x.
     ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
     b * abs x < &1
     ==> real_summable k (\n. a n * x pow n)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_SERIES_ABSCONV_IMP_CONV THEN
    BETA_TAC THEN MATCH_MP_TAC REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV THEN
    EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [])

  let REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE ← prove
   r"!x a k b.
     ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
     b * abs x < &1
     ==> real_summable k (\n. abs (&n * a n * x pow (n - 1)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"Cx x", ← q r"\n:num. Cx(a n)", ← q r"k:num->bool", ← q r"b:real"]
                  CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE) THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_CX, ← GSYM CX_POW, ← GSYM CX_MUL])

  let REAL_CAUCHY_HADAMARD_RADIUS_DERIVATIVE ← prove
   r"!x a k b.
      ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
      b * abs x < &1
      ==> real_summable k (\n. &n * a n * x pow (n - 1))"
   (REPEAT GEN_TAC THEN INTRO_TAC "limsup norm" THEN
    MATCH_MP_TAC REAL_SERIES_ABSCONV_IMP_CONV THEN
    ASM_MESON_TAC [REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE])

  let CAUCHY_HADAMARD_RADIUS_UNIFORM ← prove
   r"!a b s k.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
     compact s /\
     (!z:complex. z IN s ==> b * norm z < &1)
     ==> ?l. !e. &0 < e
                 ==> ?N. !n z. N <= n /\ z IN s
                         ==> dist(vsum (k INTER (0..n)) (\i. a i * z pow i),
                                  l z) < e"
   (INTRO_TAC "!a b s k; limsup cpt sub" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [POP_ASSUM MP_TAC THEN REWRITE_TAC [num_FINITE] THEN INTRO_TAC "@N. N" THEN
     EXISTS_TAC (← q r"\z:complex. vsum k (\i. a i * z pow i)") THEN
     INTRO_TAC "!e; epos" THEN EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n z; n z" THEN
     SUBGOAL_THEN (← q r"k INTER (0..n) = k")
       (fun th => ASM_REWRITE_TAC [th, DIST_REFL]) THEN
     REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN
     GEN_TAC THEN ASM_CASES_TAC (← q r"x:num IN k") THEN ASM_REWRITE_TAC [] THEN
     TRANS_TAC LE_TRANS (← q r"N:num") THEN ASM_SIMP_TAC [],
     POP_ASSUM (LABEL_TAC "fin")] THEN
    MP_TAC (← ISPECL [← q r"s:complex->bool", ← q r"b:real"]
                   COMPACT_SHRINK_ENCLOSING_BALL_INFTY) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    INTRO_TAC "@r. r0 r1 r2" THEN
    MP_TAC (← ISPECL [← q r"\z:complex n. a n * z pow n",
                      ← q r"\n. norm(a n:complex) * r pow n",
                      ← q r"\z:complex. z IN s", ← q r"k:num->bool"]
                  SERIES_COMPARISON_UNIFORM) THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN CONJ_TAC THENL
    [REWRITE_TAC [← GSYM summable, ← GSYM REAL_SUMMABLE] THEN
     MATCH_MP_TAC REAL_CAUCHY_HADAMARD_RADIUS THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [REAL_ABS_NORM] THEN
     ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN INTRO_TAC "!n [z]; n z" THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_POW] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_SIMP_TAC [REAL_POW_LE2, NORM_POS_LE, REAL_LT_IMP_LE])

  let CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE ← prove
   r"!a b s k.
     ((\n. root n (norm (a n))) has_limsup b) (sequentially within k) /\
     compact s /\
     (!z. z IN s ==> b * norm z < &1)
     ==> ?l. !e. &0 < e
                 ==> ?N. !n z.
                       N <= n /\ z IN s
                       ==> dist(vsum (k INTER (0..n))
                                     (\i. Cx(&i) * a i * z pow (i - 1)),
                                l z) < e"
   (INTRO_TAC "!a s b k; limsup compact sub" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [POP_ASSUM MP_TAC THEN REWRITE_TAC [num_FINITE] THEN INTRO_TAC "@N. N" THEN
     EXISTS_TAC (← q r"\z. vsum k (\i. Cx (&i) * a i * z pow (i - 1))") THEN
     INTRO_TAC "!e; epos" THEN EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n z; n z" THEN
     SUBGOAL_THEN (← q r"k INTER (0..n) = k")
       (fun th => ASM_REWRITE_TAC [th, DIST_REFL]) THEN
     REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN GEN_TAC THEN
     ASM_CASES_TAC (← q r"x:num IN k") THEN ASM_REWRITE_TAC [] THEN
     TRANS_TAC LE_TRANS (← q r"N:num") THEN ASM_SIMP_TAC [],
     POP_ASSUM (LABEL_TAC "fin")] THEN
    CLAIM_TAC "@r. r1 r2 r3"
      (← q r"?r. &0 < r /\ b * r < &1 /\ (!z:complex. z IN s ==> norm z < r)") THENL
    [MATCH_MP_TAC COMPACT_SHRINK_ENCLOSING_BALL_INFTY THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\z:complex n. Cx(&n) * a n * z pow (n - 1)",
                      ← q r"\n. &n * norm(a n:complex) * r pow (n - 1)",
                      ← q r"\z:complex. z IN s", ← q r"k:num->bool"]
                  SERIES_COMPARISON_UNIFORM) THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN CONJ_TAC THENL
    [REWRITE_TAC [← GSYM summable, ← GSYM REAL_SUMMABLE] THEN
     MATCH_MP_TAC REAL_CAUCHY_HADAMARD_RADIUS_DERIVATIVE THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [REAL_ABS_NORM] THEN
     ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN INTRO_TAC "!n [z]; n z" THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_POW, COMPLEX_NORM_CX,
                 REAL_ABS_NUM, REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_SIMP_TAC [REAL_POW_LE2, NORM_POS_LE, REAL_LT_IMP_LE,
                  REAL_LE_MUL, REAL_OF_NUM_LE, LE_0])

  let REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM ← prove
   r"!a b s k.
     ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
     real_compact s /\
     (!x:real. x IN s ==> b * abs x < &1)
     ==> ?l. !e. &0 < e
                 ==> ?N. !n x. N <= n /\ x IN s
                         ==> abs(sum (k INTER (0..n)) (\i. a i * x pow i) -
                                  l x) < e"
   (INTRO_TAC "!a b s k; limsup cpt sub" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [POP_ASSUM MP_TAC THEN REWRITE_TAC [num_FINITE] THEN INTRO_TAC "@N. N" THEN
     EXISTS_TAC (← q r"\x:real. sum k (\i. a i * x pow i)") THEN
     INTRO_TAC "!e; epos" THEN EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n x; n x" THEN
     SUBGOAL_THEN (← q r"k INTER (0..n) = k")
       (fun th => ASM_REWRITE_TAC [th, REAL_SUB_REFL, REAL_ABS_0]) THEN
     REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN
     GEN_TAC THEN ASM_CASES_TAC (← q r"x':num IN k") THEN ASM_REWRITE_TAC [] THEN
     TRANS_TAC LE_TRANS (← q r"N:num") THEN ASM_SIMP_TAC [],
     POP_ASSUM (LABEL_TAC "fin")] THEN
    HYP_TAC "cpt" (REWRITE_RULE [real_compact]) THEN
    MP_TAC (← ISPECL [← q r"IMAGE lift (s:real->bool)", ← q r"b:real"]
                   COMPACT_SHRINK_ENCLOSING_BALL_INFTY) THEN
    ANTS_TAC THENL
   [ASM_REWRITE_TAC [IN_IMAGE] THEN GEN_TAC THEN INTRO_TAC "@x. lift" THEN
    ASM_SIMP_TAC [NORM_LIFT],
    ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE] THEN INTRO_TAC "@r. (r0 r1 r2)" THEN
    MP_TAC (← ISPECL [← q r"\x:real n. lift (a n * x pow n)",
                      ← q r"\n. abs(a n:real) * r pow n",
                      ← q r"\x:real. x IN s", ← q r"k:num->bool"]
                   SERIES_COMPARISON_UNIFORM) THEN
    ANTS_TAC THENL
    [ALL_TAC,
     REWRITE_TAC [SUM_VSUM, o_DEF, DIST_1] THEN INTRO_TAC "@l. l" THEN
     EXISTS_TAC (← q r"(\x:real. drop (l x))") THEN ASM_MESON_TAC []] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [← GSYM summable, ← GSYM REAL_SUMMABLE] THEN
     MATCH_MP_TAC REAL_CAUCHY_HADAMARD_RADIUS THEN EXISTS_TAC (← q r"b:real") THEN
     ASM_REWRITE_TAC [REAL_ABS_ABS] THEN ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN INTRO_TAC "!n [x]; n x" THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_MUL, REAL_ABS_POW] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN
    CLAIM_TAC "1" (← q r"norm (lift x) < r") THENL
    [REMOVE_THEN "r2" MATCH_MP_TAC THEN EXISTS_TAC (← q r"x:real") THEN
     ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    HYP_TAC "1" (REWRITE_RULE [NORM_LIFT]) THEN
    ASM_SIMP_TAC [REAL_POW_LE2, REAL_ABS_POS, REAL_LT_IMP_LE])

  let REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE ← prove
   r"!a b s k.
     ((\n. root n (abs (a n))) has_limsup b) (sequentially within k) /\
     real_compact s /\
     (!x. x IN s ==> b * abs x < &1)
     ==> ?l. !e. &0 < e
                 ==> ?N. !n x.
                       N <= n /\ x IN s
                       ==> abs(sum (k INTER (0..n))
                                     (\i. &i * a i * x pow (i - 1)) -
                                l x) < e"
   (INTRO_TAC "!a s b k; limsup compact sub" THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THENL
    [POP_ASSUM MP_TAC THEN REWRITE_TAC [num_FINITE] THEN INTRO_TAC "@N. N" THEN
     EXISTS_TAC (← q r"\x. sum k (\i. &i * a i * x pow (i - 1))") THEN
     INTRO_TAC "!e; epos" THEN EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n x; n x" THEN
     SUBGOAL_THEN (← q r"k INTER (0..n) = k")
       (fun th => ASM_REWRITE_TAC [th, REAL_SUB_REFL, REAL_ABS_0]) THEN
     REWRITE_TAC [EXTENSION, IN_INTER, IN_NUMSEG, LE_0] THEN GEN_TAC THEN
     ASM_CASES_TAC (← q r"x':num IN k") THEN ASM_REWRITE_TAC [] THEN
     TRANS_TAC LE_TRANS (← q r"N:num") THEN ASM_SIMP_TAC [],
     POP_ASSUM (LABEL_TAC "fin")] THEN
    HYP_TAC "compact" (REWRITE_RULE [real_compact]) THEN
    MP_TAC (← ISPECL [← q r"IMAGE lift (s:real->bool)", ← q r"b:real"]
                   COMPACT_SHRINK_ENCLOSING_BALL_INFTY) THEN
    ANTS_TAC THENL
    [ASM_REWRITE_TAC [IN_IMAGE] THEN GEN_TAC THEN INTRO_TAC "@x. lift" THEN
     ASM_SIMP_TAC [NORM_LIFT],
     ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE] THEN INTRO_TAC "@r. (r0 r1 r2)" THEN
    MP_TAC (← ISPECL [← q r"\x:real n. lift (&n * a n * x pow (n - 1))",
                      ← q r"\n. &n * abs(a n:real) * r pow (n - 1)",
                      ← q r"\x:real. x IN s", ← q r"k:num->bool"]
                  SERIES_COMPARISON_UNIFORM) THEN
    ANTS_TAC THENL
    [ALL_TAC,
     REWRITE_TAC [SUM_VSUM, o_DEF, DIST_1] THEN
     INTRO_TAC "@l. l" THEN EXISTS_TAC (← q r"(\x:real. drop (l x))") THEN
     ASM_MESON_TAC []] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [← GSYM summable, ← GSYM REAL_SUMMABLE] THEN
     MATCH_MP_TAC REAL_CAUCHY_HADAMARD_RADIUS_DERIVATIVE THEN
     EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC [REAL_ABS_ABS] THEN
     ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN INTRO_TAC "!n [x]; n x" THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_POW, REAL_ABS_MUL,
                 REAL_ABS_NUM, REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN
    CLAIM_TAC "1" (← q r"norm (lift x) < r") THENL
    [REMOVE_THEN "r2" MATCH_MP_TAC THEN EXISTS_TAC (← q r"x:real") THEN
     ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    HYP_TAC "1" (REWRITE_RULE [NORM_LIFT]) THEN
    ASM_SIMP_TAC [REAL_POW_LE2, REAL_ABS_POS, REAL_LT_IMP_LE, REAL_LE_MUL,
                  REAL_OF_NUM_LE, LE_0])

  pure { CAUCHY_HADAMARD_RADIUS_ABSCONV, CAUCHY_HADAMARD_RADIUS,
         CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE, CAUCHY_HADAMARD_RADIUS_DERIVATIVE,
         REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV, REAL_CAUCHY_HADAMARD_RADIUS,
         REAL_CAUCHY_HADAMARD_RADIUS_ABSCONV_DERIVATIVE,
         REAL_CAUCHY_HADAMARD_RADIUS_DERIVATIVE, CAUCHY_HADAMARD_RADIUS_UNIFORM,
         CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE, REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM,
         REAL_CAUCHY_HADAMARD_RADIUS_UNIFORM_DERIVATIVE }
/- ------------------------------------------------------------------------- -/
/- Real differentiation of sequences and series; Taylor.                     -/
/- (realanalysis.ml 6553-6806)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAB where
  HAS_REAL_DERIVATIVE_SEQUENCE : thm
  HAS_REAL_DERIVATIVE_SERIES : thm
  REAL_DIFFERENTIABLE_BOUND : thm
  REAL_TAYLOR_MVT_POS : thm
  REAL_TAYLOR_MVT_NEG : thm
  REAL_TAYLOR : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAB [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZC : RZC) (BRZL : RZL) (BRZM : RZM) (BRZN : RZN) (BRZO : RZO) (BRZQ : RZQ) (BRZT : RZT) : ExceptT String IO RZAB := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { real_sums, .. } := BRZC
  let { HAS_REAL_FRECHET_DERIVATIVE_WITHIN, .. } := BRZL
  let { IS_REALINTERVAL_CONVEX, .. } := BRZM
  let { HAS_REAL_DERIVATIVE_WITHIN_SUBSET, REAL_DIFF_CHAIN_WITHIN, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_LMUL_WITHIN,
        HAS_REAL_DERIVATIVE_MUL_WITHIN, HAS_REAL_DERIVATIVE_SUM, .. } := BRZO
  let { REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_ROLLE_SIMPLE, .. } := BRZT
  let { IN_REAL_INTERVAL, is_realinterval, REAL_INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.qmisc
  let { SUM_DIFFS_ALT, SUM_OFFSET_0, .. } := D.qsession
  let { DIFFERENTIABLE_BOUND, HAS_DERIVATIVE_SEQUENCE, .. } := D.ts.cn.qderivatives
  let { FACT, SUM_EQ_0_NUMSEG, .. } := D.ts.cn.qsession
  let { ADD_EQ_0, FACT_NZ, REAL_POW_ZERO, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NUM_REDUCE_CONV, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RING, .. } := D.ts.cn.cx.cvx
  let { ADD_CLAUSES, LE_0, NOT_SUC, REAL_ADD_SUB, REAL_POW_ADD, real_sub,
        .. } := D.ts.cn.cx.cpx
  let { REAL_ABS_0, .. } := D.ts.cn.ms.ig.qsession
  let { ADD1, ARITH, ETA_AX, EXISTS_IN_IMAGE, EXTENSION, FINITE_NUMSEG,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_NUMSEG, LE_1, MONO_EXISTS, REAL_ABS_DIV, REAL_ABS_MUL, REAL_ABS_NUM,
        REAL_ABS_POS, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_1, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_INV_1, REAL_INV_MUL, REAL_LE_DIV, REAL_LE_RMUL, REAL_LT_NEG2,
        REAL_LT_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO,
        REAL_NEG_0, REAL_NEG_NEG, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_MUL,
        REAL_OF_NUM_SUC, REAL_POS, REAL_POW_EQ_0, REAL_POW_LE, REAL_POW_MUL, REAL_SUB_0,
        REAL_SUB_REFL, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_div, real_pow, SUM_CLAUSES_LEFT, SUM_CLAUSES_NUMSEG,
        UNWIND_THM1, .. } := D.ts.cn.cx.cvx.core6
  let { EXISTS_LIFT, LIFT_DROP, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, .. } := D.ts.cn.cx.cvx.vec3
  let { VECTOR_SUB_RDISTRIB, .. } := D.ts.cn.cx.cvx.vec4
  let { FINITE_INTER_NUMSEG, .. } := D.ts.cn.ms.ig.dv.qmisc
  let { LINEAR_COMPOSE_CMUL, ONORM, .. } := D.ts.cn.ms.ig.dv.qvec
  let { ADD_SUB, REAL_ABS_POW, REAL_EQ_ADD_LCANCEL, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { LINEAR_ID, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let HAS_REAL_DERIVATIVE_SEQUENCE ← prove
   r"!s f f' g'.
         is_realinterval s /\
         (!n x. x IN s
                ==> (f n has_real_derivative f' n x) (atreal x within s)) /\
         (!e. &0 < e
              ==> ?N. !n x. n >= N /\ x IN s ==> abs(f' n x - g' x) <= e) /\
         (?x l. x IN s /\ ((\n. f n x) ---> l) sequentially)
         ==> ?g. !x. x IN s
                     ==> ((\n. f n x) ---> g x) sequentially /\
                         (g has_real_derivative g' x) (atreal x within s)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN, IS_REALINTERVAL_CONVEX,
                 TENDSTO_REAL] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"IMAGE lift s",
                      ← q r"\n:num. lift o f n o drop",
                      ← q r"\n:num x:real^1 h:real^1. f' n (drop x) % h",
                      ← q r"\x:real^1 h:real^1. g' (drop x) % h"]
           HAS_DERIVATIVE_SEQUENCE) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP] THEN ANTS_TAC THENL
     [REWRITE_TAC [IMP_CONJ, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM,
                   EXISTS_IN_IMAGE, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [EXISTS_LIFT, o_THM, LIFT_DROP] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL] THEN
      ASM_MESON_TAC [REAL_LE_RMUL, NORM_POS_LE],
      REWRITE_TAC [o_DEF, LIFT_DROP] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"g:real^1->real^1")) THEN
      EXISTS_TAC (← q r"drop o g o lift") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ETA_AX]) THEN
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]])

  let HAS_REAL_DERIVATIVE_SERIES ← prove
   r"!s f f' g' k.
         is_realinterval s /\
         (!n x. x IN s
                ==> (f n has_real_derivative f' n x) (atreal x within s)) /\
         (!e. &0 < e
              ==> ?N. !n x. n >= N /\ x IN s
                            ==> abs(sum (k INTER (0..n)) (\i. f' i x) - g' x)
                                    <= e) /\
         (?x l. x IN s /\ ((\n. f n x) real_sums l) k)
         ==> ?g. !x. x IN s
                     ==> ((\n. f n x) real_sums g x) k /\
                         (g has_real_derivative g' x) (atreal x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_sums] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_SEQUENCE THEN EXISTS_TAC
     (← q r"\n:num x:real. sum(k INTER (0..n)) (\n. f' n x):real") THEN
    ASM_SIMP_TAC [ETA_AX, FINITE_INTER_NUMSEG, HAS_REAL_DERIVATIVE_SUM])

  let REAL_DIFFERENTIABLE_BOUND ← prove
   r"!f f' s B.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s) /\
                        abs(f' x) <= B)
        ==> !x y. x IN s /\ y IN s ==> abs(f x - f y) <= B * abs(x - y)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN, IS_REALINTERVAL_CONVEX,
                 o_DEF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"\x h:real^1. f' (drop x) % h",
      ← q r"IMAGE lift s", ← q r"B:real"]
          DIFFERENTIABLE_BOUND) THEN
    ASM_SIMP_TAC [o_DEF, FORALL_IN_IMAGE, LIFT_DROP] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"v:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"\h:real^1. f' (v:real) % h") ONORM) THEN
      SIMP_TAC [LINEAR_COMPOSE_CMUL, LINEAR_ID] THEN
      DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_LE_RMUL, NORM_POS_LE],
      SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, LIFT_DROP] THEN
      ASM_SIMP_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM LIFT_SUB, NORM_LIFT]])

  let REAL_TAYLOR_MVT_POS ← prove
   r"!f a x n.
    a < x /\
    (!i t. t IN real_interval[a,x] /\ i <= n
           ==> ((f i) has_real_derivative f (i + 1) t)
               (atreal t within real_interval[a,x]))
    ==> ?t. t IN real_interval(a,x) /\
            f 0 x =
              sum (0..n) (\i. f i a * (x - a) pow i / &(FACT i)) +
              f (n + 1) t * (x - a) pow (n + 1) / &(FACT(n + 1))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?B. sum (0..n) (\i. f i a * (x - a) pow i / &(FACT i)) +
          B * (x - a) pow (n + 1) = f 0 x")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← MESON []
       (← q r"a + (y - a) / x * x:real = y ==> ?b. a + b * x = y")) THEN
      MATCH_MP_TAC (← REAL_FIELD (← q r"~(x = &0) ==> a + (y - a) / x * x = y")) THEN
      ASM_REWRITE_TAC [REAL_POW_EQ_0, REAL_SUB_0] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"\t. sum(0..n) (\i. f i t * (x - t) pow i / &(FACT i)) +
                       B * (x - t) pow (n + 1)",
                     ← q r"\t. (f (n + 1) t * (x - t) pow n / &(FACT n)) -
                       B * &(n + 1) * (x - t) pow n",
                     ← q r"a:real", ← q r"x:real"]
          REAL_ROLLE_SIMPLE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [SIMP_TAC [SUM_CLAUSES_LEFT, LE_0] THEN
        REWRITE_TAC [← GSYM ADD1, real_pow, REAL_SUB_REFL, REAL_POW_ZERO,
                     REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_ADD_RID] THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC [NOT_SUC, REAL_MUL_RZERO, REAL_DIV_1, REAL_MUL_RID] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x = (x + y) + &0 <=> y = &0")] THEN
        MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN
        SIMP_TAC [ARITH, ← ARITH_RULE (← q r"1 <= i ==> ~(i = 0)")] THEN
        REWRITE_TAC [real_div, REAL_MUL_LZERO, REAL_MUL_RZERO],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"t:real") THEN DISCH_TAC THEN REWRITE_TAC [real_sub] THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_ADD THEN CONJ_TAC THENL
       [ALL_TAC,
        REAL_DIFF_TAC THEN REWRITE_TAC [ADD_SUB] THEN CONV_TAC REAL_RING] THEN
      REWRITE_TAC [← GSYM real_sub] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"!g'. f' = g' /\ (f has_real_derivative g') net
             ==> (f has_real_derivative f') net")) THEN
      EXISTS_TAC
       (← q r"sum (0..n) (\i. f i t * --(&i * (x - t) pow (i - 1)) / &(FACT i) +
                                  f (i + 1) t * (x - t) pow i / &(FACT i))") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUM THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
        X_GEN_TAC (← q r"m:num") THEN STRIP_TAC THEN
        MATCH_MP_TAC HAS_REAL_DERIVATIVE_MUL_WITHIN THEN
        ASM_SIMP_TAC [ETA_AX] THEN REAL_DIFF_TAC THEN REAL_ARITH_TAC] THEN
      SIMP_TAC [SUM_CLAUSES_LEFT, LE_0, ARITH, FACT, REAL_DIV_1,
                real_pow, REAL_MUL_LZERO, REAL_NEG_0, REAL_MUL_RZERO,
                REAL_MUL_RID, REAL_ADD_LID] THEN
      ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_REWRITE_TAC [SUM_CLAUSES_NUMSEG, ARITH, FACT] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_SIMP_TAC [← SPECL [← q r"f:num->real", ← q r"1"] SUM_OFFSET_0, LE_1] THEN
      REWRITE_TAC [ADD_SUB] THEN
      REWRITE_TAC [← GSYM ADD1, FACT, ← GSYM REAL_OF_NUM_MUL, ← GSYM REAL_OF_NUM_ADD,
                   ← GSYM REAL_OF_NUM_SUC] THEN
      REWRITE_TAC [real_div, REAL_INV_MUL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"--(n * x) * (inv n * inv y):real =
                              --(n / n) * x / y")] THEN
      REWRITE_TAC [← REAL_FIELD (← q r"--((&n + &1) / (&n + &1)) * x = --x")] THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL, REAL_OF_NUM_MUL, REAL_OF_NUM_SUC] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 FACT)] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * --b + c:real = c - a * b")] THEN
      REWRITE_TAC [ADD1, ← GSYM real_div, SUM_DIFFS_ALT, LE_0] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n = 0) ==> n - 1 + 1 = n"), FACT] THEN
      REWRITE_TAC [ADD_CLAUSES] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC LAND_CONV [← GSYM th])) THEN
    REWRITE_TAC [REAL_EQ_ADD_LCANCEL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a * b / c:real = a / c * b")] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"a * x / f - B * k * x = &0 ==> (B * k - a / f) * x = &0"))) THEN
    REWRITE_TAC [REAL_ENTIRE, REAL_POW_EQ_0, REAL_SUB_0] THEN
    ASM_CASES_TAC (← q r"x:real = t") THENL
     [ASM_MESON_TAC [IN_REAL_INTERVAL, REAL_LT_REFL], ALL_TAC] THEN
    ASM_REWRITE_TAC [← GSYM ADD1, FACT] THEN
    REWRITE_TAC [← GSYM REAL_OF_NUM_MUL, ← GSYM REAL_OF_NUM_ADD, ADD1] THEN
    SUBGOAL_THEN (← q r"~(&(FACT n) = &0)") MP_TAC THENL
     [REWRITE_TAC [REAL_OF_NUM_EQ, FACT_NZ], CONV_TAC REAL_FIELD])

  let REAL_TAYLOR_MVT_NEG ← prove
   r"!f a x n.
    x < a /\
    (!i t. t IN real_interval[x,a] /\ i <= n
           ==> ((f i) has_real_derivative f (i + 1) t)
               (atreal t within real_interval[x,a]))
    ==> ?t. t IN real_interval(x,a) /\
            f 0 x =
              sum (0..n) (\i. f i a * (x - a) pow i / &(FACT i)) +
              f (n + 1) t * (x - a) pow (n + 1) / &(FACT(n + 1))"
   (REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← MESON [REAL_NEG_NEG] (← q r"(?x:real. P x) <=> (?x. P(--x))")] THEN
    MP_TAC (← SPECL [← q r"\n x. (-- &1) pow n * (f:num->real->real) n (--x)",
                     ← q r"--a:real", ← q r"  --x:real", ← q r"n:num"]
          REAL_TAYLOR_MVT_POS) THEN
    REWRITE_TAC [REAL_NEG_NEG] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(x * y) * z / w:real = y * (x * z) / w")] THEN
    REWRITE_TAC [← GSYM REAL_POW_MUL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"-- &1 * (--x - --a) = x - a")] THEN
    REWRITE_TAC [IN_REAL_INTERVAL, real_pow, REAL_MUL_LID] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--a < t /\ t < --x <=> x < --t /\ --t < a")] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [REAL_LT_NEG2] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"t:real"] THEN STRIP_TAC THEN
    REWRITE_TAC [REAL_POW_ADD, ← GSYM REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_LMUL_WITHIN THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"y pow 1 * x:real = x * y")] THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC REAL_DIFF_CHAIN_WITHIN THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
      REAL_DIFF_TAC THEN REFL_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (--) (real_interval[--a,--x]) = real_interval[x,a]")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_IMAGE, IN_REAL_INTERVAL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x:real = --y <=> --x = y"), UNWIND_THM1] THEN
      REAL_ARITH_TAC,
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC])

  let REAL_TAYLOR ← prove
   r"!f n s B.
    is_realinterval s /\
    (!i x. x IN s /\ i <= n
           ==> ((f i) has_real_derivative f (i + 1) x) (atreal x within s)) /\
    (!x. x IN s ==> abs(f (n + 1) x) <= B)
    ==> !w z. w IN s /\ z IN s
              ==> abs(f 0 z -
                      sum (0..n) (\i. f i w * (z - w) pow i / &(FACT i)))
                  <= B * abs(z - w) pow (n + 1) / &(FACT(n + 1))"
   (REPEAT STRIP_TAC THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← REAL_ARITH (← q r"w = z \/ w < z \/ z < w"))
    THENL
     [ASM_SIMP_TAC [SUM_CLAUSES_LEFT, LE_0, REAL_SUB_REFL, REAL_POW_ZERO,
                    REAL_ABS_0, ARITH, ADD_EQ_0, real_div] THEN
      REWRITE_TAC [REAL_MUL_LZERO, FACT, REAL_INV_1, REAL_MUL_RZERO] THEN
      MATCH_MP_TAC (← REAL_ARITH
        (← q r"y = &0 ==> abs(x - (x * &1 * &1 + y)) <= &0")) THEN
      MATCH_MP_TAC SUM_EQ_0_NUMSEG THEN
      SIMP_TAC [ARITH, LE_1, REAL_MUL_RZERO, REAL_MUL_LZERO],
      MP_TAC (← ISPECL [← q r"f:num->real->real", ← q r"w:real", ← q r"z:real",
                        ← q r"n:num"] REAL_TAYLOR_MVT_POS) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"real_interval[w,z] SUBSET s") ASSUME_TAC THENL
       [SIMP_TAC [SUBSET, IN_REAL_INTERVAL] THEN ASM_MESON_TAC [is_realinterval],
        ALL_TAC],
      MP_TAC (← ISPECL [← q r"f:num->real->real", ← q r"w:real", ← q r"z:real",
                        ← q r"n:num"] REAL_TAYLOR_MVT_NEG) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"real_interval[z,w] SUBSET s") ASSUME_TAC THENL
       [SIMP_TAC [SUBSET, IN_REAL_INTERVAL] THEN ASM_MESON_TAC [is_realinterval],
        ALL_TAC]] THEN
    (ANTS_TAC THENL
      [MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"t:real"] THEN STRIP_TAC THEN
       MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
       EXISTS_TAC (← q r"s:real->bool") THEN ASM_REWRITE_TAC [] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET],
       ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"t:real")
      (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
     REWRITE_TAC [REAL_ADD_SUB, REAL_ABS_MUL, REAL_ABS_DIV] THEN
     REWRITE_TAC [REAL_ABS_POW, REAL_ABS_NUM] THEN
     MATCH_MP_TAC REAL_LE_RMUL THEN
     SIMP_TAC [REAL_LE_DIV, REAL_POS, REAL_POW_LE, REAL_ABS_POS] THEN
     ASM_MESON_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED, SUBSET]))

  pure { HAS_REAL_DERIVATIVE_SEQUENCE, HAS_REAL_DERIVATIVE_SERIES,
         REAL_DIFFERENTIABLE_BOUND, REAL_TAYLOR_MVT_POS, REAL_TAYLOR_MVT_NEG,
         REAL_TAYLOR }
/- ------------------------------------------------------------------------- -/
/- Comparing sums and "integrals" via real antiderivatives; variants with   -/
/- real derivatives; relating different kinds of real limits.               -/
/- (realanalysis.ml 6807-7039)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAC where
  REAL_SUM_INTEGRAL_UBOUND_INCREASING : thm
  REAL_SUM_INTEGRAL_UBOUND_DECREASING : thm
  REAL_SUM_INTEGRAL_LBOUND_INCREASING : thm
  REAL_SUM_INTEGRAL_LBOUND_DECREASING : thm
  REAL_SUM_INTEGRAL_BOUNDS_INCREASING : thm
  REAL_SUM_INTEGRAL_BOUNDS_DECREASING : thm
  RPOW_TELESCOPE_BOUNDS : thm
  REAL_INFSUM_ZETA_BOUNDS : thm
  HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1_ALT : thm
  ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1_ALT : thm
  REALLIM_POSINFINITY_SEQUENTIALLY : thm
  LIM_ZERO_POSINFINITY : thm
  LIM_ZERO_NEGINFINITY : thm
  REALLIM_ZERO_POSINFINITY : thm
  REALLIM_ZERO_NEGINFINITY : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAC [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZC : RZC) (BRZE : RZE) (BRZF : RZF) (BRZL : RZL) (BRZN : RZN) (BRZO : RZO) (BRZR : RZR) (BRZS : RZS) (BRZT : RZT) : ExceptT String IO RZAC := do
  -- @@SCOPE BEGIN
  let { REALLIM_CONST, REALLIM_RMUL, REALLIM_SUB, TENDSTO_REAL, .. } := BRZA
  let { REALLIM_LE, REALLIM_UBOUND, .. } := BRZB
  let { REAL_SERIES_FROM, REAL_SUMS_INFSUM, .. } := BRZC
  let { REAL_SUMMABLE_ZETA, .. } := BRZE
  let { LIM_ATREAL, .. } := BRZF
  let { HAS_REAL_VECTOR_DERIVATIVE_WITHIN, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_WITHIN_SUBSET, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_NEG, .. } := BRZO
  let { HAS_REAL_DERIVATIVE_RPOW, REALLIM_1_OVER_N_OFFSET, .. } := BRZR
  let { REALLIM_RPOW, .. } := BRZS
  let { REAL_MVT_SIMPLE, .. } := BRZT
  let { RPOW_INV, RPOW_LE2, RPOW_NEG, RPOW_ONE, RPOW_POS_LE, RPOW_POS_LT, RPOW_ZERO,
        .. } := D.tsab
  let { LIM_AT_NEGINFINITY, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { SUM_DIFFS_ALT, .. } := D.qsession
  let { HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1, .. } := D.qmeasure
  let { LIM_POSINFINITY_SEQUENTIALLY, .. } := D.ts.qtopology
  let { LT_NZ, .. } := D.ts.qsession
  let { RE_NEG, RE_SUB, .. } := D.ts.cn.cxc
  let { SUM_SING_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, .. } := D.ts.cn.cx.cvx
  let { REAL_ADD_SUB, .. } := D.ts.cn.cx.cpx
  let { LIM_AT_POSINFINITY, .. } := D.ts.cn.ms.ig.qtopology
  let { ARITH, EQ_IMP, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, IMAGE_o, .. } := D.ts.cn.cx.cvx.core2
  let { REAL_ABS_INV, REAL_ADD_LID, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_INV_1, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_INV_EQ, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_SUC, REAL_POS, REAL_SUB_REFL,
        REAL_SUB_RZERO, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, real_ge, SUM_CLAUSES_NUMSEG, SUM_LE_NUMSEG, SUM_NEG,
        .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.ts.cn.cx.cvx.met
  let { REAL_INV_INV, .. } := D.ts.cn.ms.ig.dv.qsession
  let { REAL_LT_INV2, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let REAL_SUM_INTEGRAL_UBOUND_INCREASING ← prove
   r"!f g m n.
      m <= n /\
      (!x. x IN real_interval[&m,&n + &1]
           ==> (g has_real_derivative f(x))
               (atreal x within real_interval[&m,&n + &1])) /\
      (!x y. &m <= x /\ x <= y /\ y <= &n + &1 ==> f x <= f y)
      ==> sum(m..n) (\k. f(&k)) <= g(&n + &1) - g(&m)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(m..n) (\k. g(&(k + 1)) - g(&k))") THEN CONJ_TAC THENL
     [ALL_TAC, ASM_SIMP_TAC [SUM_DIFFS_ALT, REAL_OF_NUM_ADD, REAL_LE_REFL]] THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real->real", ← q r"f:real->real", ← q r"&k", ← q r"&(k + 1)"]
                  REAL_MVT_SIMPLE) THEN
    ASM_REWRITE_TAC [REAL_OF_NUM_LT, ← ARITH_RULE (← q r"k < k + 1")] THEN
    ASM_REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, REAL_ADD_SUB] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"real_interval[&m,&n + &1]") THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL]),
        REWRITE_TAC [SUBSET] THEN GEN_TAC] THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      REWRITE_TAC [REAL_MUL_RID] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN
      ASM_REAL_ARITH_TAC])

  let REAL_SUM_INTEGRAL_UBOUND_DECREASING ← prove
   r"!f g m n.
      m <= n /\
      (!x. x IN real_interval[&m - &1,&n]
           ==> (g has_real_derivative f(x))
               (atreal x within real_interval[&m - &1,&n])) /\
      (!x y. &m - &1 <= x /\ x <= y /\ y <= &n ==> f y <= f x)
      ==> sum(m..n) (\k. f(&k)) <= g(&n) - g(&m - &1)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(m..n) (\k. g(&(k + 1) - &1) - g(&k - &1))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [SUM_DIFFS_ALT] THEN
      ASM_REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← REAL_ARITH (← q r"(x + &1) - &1 = x")] THEN
      REWRITE_TAC [REAL_LE_REFL]] THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real->real", ← q r"f:real->real", ← q r"&k - &1", ← q r"&k"]
                  REAL_MVT_SIMPLE) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"k - &1 < k")] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"real_interval[&m - &1,&n]") THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL]),
        REWRITE_TAC [SUBSET] THEN GEN_TAC] THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← REAL_ARITH (← q r"(a + &1) - &1 = a")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * (x - (x - &1)) = a")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN
      ASM_REAL_ARITH_TAC])

  let REAL_SUM_INTEGRAL_LBOUND_INCREASING ← prove
   r"!f g m n.
      m <= n /\
      (!x. x IN real_interval[&m - &1,&n]
           ==> (g has_real_derivative f(x))
               (atreal x within real_interval[&m - &1,&n])) /\
      (!x y. &m - &1 <= x /\ x <= y /\ y <= &n ==> f x <= f y)
      ==> g(&n) - g(&m - &1) <= sum(m..n) (\k. f(&k))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\z. --((f:real->real) z)",
                      ← q r"\z. --((g:real->real) z)",
                      ← q r"m:num", ← q r"n:num"] REAL_SUM_INTEGRAL_UBOUND_DECREASING) THEN
    REWRITE_TAC [RE_NEG, RE_SUB, SUM_NEG, REAL_LE_NEG2,
                 ← REAL_ARITH (← q r"--x - --y:real = --(x - y)")] THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_NEG])

  let REAL_SUM_INTEGRAL_LBOUND_DECREASING ← prove
   r"!f g m n.
      m <= n /\
      (!x. x IN real_interval[&m,&n + &1]
           ==> (g has_real_derivative f(x))
               (atreal x within  real_interval[&m,&n + &1])) /\
      (!x y. &m <= x /\ x <= y /\ y <= &n + &1 ==> f y <= f x)
      ==> g(&n + &1) - g(&m) <= sum(m..n) (\k. f(&k))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\z. --((f:real->real) z)",
                      ← q r"\z. --((g:real->real) z)",
                      ← q r"m:num", ← q r"n:num"] REAL_SUM_INTEGRAL_UBOUND_INCREASING) THEN
    REWRITE_TAC [RE_NEG, RE_SUB, SUM_NEG, REAL_LE_NEG2,
                 ← REAL_ARITH (← q r"--x - --y:real = --(x - y)")] THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_NEG])

  let REAL_SUM_INTEGRAL_BOUNDS_INCREASING ← prove
   r"!f g m n.
         m <= n /\
         (!x. x IN real_interval[&m - &1,&n + &1]
              ==> (g has_real_derivative f x)
                  (atreal x within real_interval[&m - &1,&n + &1])) /\
         (!x y. &m - &1 <= x /\ x <= y /\ y <= &n + &1 ==> f x <= f y)
         ==> g(&n) - g(&m - &1) <= sum(m..n) (\k. f(&k)) /\
             sum (m..n) (\k. f(&k)) <= g(&n + &1) - g(&m)"
   (REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_SUM_INTEGRAL_LBOUND_INCREASING,
      MATCH_MP_TAC REAL_SUM_INTEGRAL_UBOUND_INCREASING] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    TRY (MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
         EXISTS_TAC (← q r"real_interval[&m - &1,&n + &1]") THEN CONJ_TAC) THEN
    TRY (FIRST_X_ASSUM MATCH_MP_TAC) THEN
    TRY (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL])) THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC)

  let REAL_SUM_INTEGRAL_BOUNDS_DECREASING ← prove
   r"!f g m n.
      m <= n /\
      (!x. x IN real_interval[&m - &1,&n + &1]
           ==> (g has_real_derivative f(x))
               (atreal x within real_interval[&m - &1,&n + &1])) /\
      (!x y. &m - &1 <= x /\ x <= y /\ y <= &n + &1 ==> f y <= f x)
      ==> g(&n + &1) - g(&m) <= sum(m..n) (\k. f(&k)) /\
          sum(m..n) (\k. f(&k)) <= g(&n) - g(&m - &1)"
   (REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_SUM_INTEGRAL_LBOUND_DECREASING,
      MATCH_MP_TAC REAL_SUM_INTEGRAL_UBOUND_DECREASING] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    TRY (MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
         EXISTS_TAC (← q r"real_interval[&m - &1,&n + &1]") THEN CONJ_TAC) THEN
    TRY (FIRST_X_ASSUM MATCH_MP_TAC) THEN
    TRY (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_REAL_INTERVAL])) THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN ASM_REAL_ARITH_TAC)

  let RPOW_TELESCOPE_BOUNDS ← prove
   r"!x s. &0 < x /\ &1 < s
         ==> inv((x + &1) rpow s) <=
             (x rpow (&1 - s) - (x + &1) rpow (&1 - s)) / (s - &1) /\
             (x rpow (&1 - s) - (x + &1) rpow (&1 - s)) / (s - &1) <=
             inv(x rpow s)"
   (← do
    let ra2 ← REAL_ARITH (← q r"(&1 - s) - &1 = --s:real")
    let ra1 ← REAL_ARITH (← q r"(x + &1) - x = &1:real")
    pure (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [(← q r"\y:real. y rpow (&1 - s)"),
                      (← q r"\y:real. (&1 - s) * y rpow ((&1 - s) - &1)"),
                      (← q r"x:real"), (← q r"x + &1:real")] REAL_MVT_SIMPLE) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      X_GEN_TAC (← q r"y:real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_ATREAL_WITHIN THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_RPOW THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [IN_REAL_INTERVAL, ra1,
                 REAL_MUL_RID, ra2] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"(x rpow (&1 - s) - (x + &1) rpow (&1 - s)) / (s - &1) = inv(y rpow s)")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM RPOW_NEG] THEN
      FIRST_X_ASSUM (MP_TAC o check (α := thm) (fun th => is_eq (concl th))) THEN
      UNDISCH_TAC (← q r"&1 < s:real") THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    CONJ_TAC THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    (CONJ_TAC THENL [MATCH_MP_TAC RPOW_POS_LT, MATCH_MP_TAC RPOW_LE2]) THEN
    ASM_REAL_ARITH_TAC))

  let REAL_INFSUM_ZETA_BOUNDS ← prove
   r"!s. &1 < s
       ==> inv(s - &1) <= real_infsum (from 1) (\m. inv(&m rpow s)) /\
           real_infsum (from 1) (\m. inv(&m rpow s)) <= s / (s - &1)"
   (← do
    let r11 ← REAL_ARITH (← q r"&1 < s:real ==> &0 <= s - &1")
    let r10 ← REAL_ARITH
       (← q r"&0 <= x / d ==> &1 + (&1 - x) / d <= &1 + &1 / d")
    let r9 ← REAL_ARITH (← q r"y <= z ==> x <= y ==> x <= z:real")
    let r8 ← REAL_ARITH (← q r"&1 < s:real ==> ~(s - &1 = &0)")
    let r7 ← REAL_ARITH (← q r"inv x = (&1 - &0) * inv x")
    let r6 ← REAL_ARITH (← q r"(n + &1) + &1 = n + &2:real")
    let a5 ← ARITH_RULE (← q r"1 <= SUC n")
    let a4 ← ARITH_RULE (← q r"~(n = 0) ==> 1 <= n")
    let a3 ← ARITH_RULE (← q r"~(n = 0) ==> 1 <= n")
    let a2 ← ARITH_RULE (← q r"1 <= SUC n")
    let a1 ← ARITH_RULE (← q r"~(1 <= 0)")
    pure (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← SPECL [(← q "1"), (← q r"s:real")] REAL_SUMMABLE_ZETA) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_SUMS_INFSUM]) THEN
    REWRITE_TAC [REAL_SERIES_FROM] THEN
    ABBREV_TAC (← q r"Z = real_infsum (from 1) (\m. inv(&m rpow s))") THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. 1 <= n
        ==> sum(1..n) (\m. inv(&m rpow s)) <=
            &1 + (&1 - &n rpow (&1 - s)) / (s - &1)")
    ASSUME_TAC THENL
     [INDUCT_TAC THEN REWRITE_TAC [a1] THEN
      ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_REWRITE_TAC [SUM_SING_NUMSEG, ARITH] THEN
        REWRITE_TAC [RPOW_ONE, REAL_INV_1] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_SIMP_TAC [SUM_CLAUSES_NUMSEG, a2,
                    a3] THEN
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
      ASM_SIMP_TAC [a4] THEN
      MP_TAC (← SPECL [(← q r"&n:real"), (← q r"s:real")] RPOW_TELESCOPE_BOUNDS) THEN
      ASM_SIMP_TAC [REAL_OF_NUM_LT, LT_NZ, ← GSYM REAL_OF_NUM_SUC] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. (&1 - (&n + &1) rpow (&1 - s)) / (s - &1) <=
        sum(1..n) (\m. inv(&m rpow s))")
    ASSUME_TAC THENL
     [INDUCT_TAC THENL
       [REWRITE_TAC [SUM_CLAUSES_NUMSEG, ARITH, REAL_ADD_LID, RPOW_ONE] THEN
        REWRITE_TAC [REAL_SUB_REFL, real_div, REAL_MUL_LZERO, REAL_LE_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [SUM_CLAUSES_NUMSEG, a5] THEN
      MP_TAC (← SPECL [(← q r"&n + &1:real"), (← q r"s:real")] RPOW_TELESCOPE_BOUNDS) THEN
      ASM_REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN
      ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_binary "real_le" o concl)) THEN
      REWRITE_TAC [r6] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_LE) THEN
      EXISTS_TAC (← q r"\n. (&1 - (&n + &1) rpow (&1 - s)) / (s - &1)") THEN
      EXISTS_TAC (← q r"\n. sum(1..n) (\m. inv(&m rpow s))") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_TRUE] THEN
      REWRITE_TAC [real_div, REAL_MUL_LID] THEN
      GEN_REWRITE_TAC LAND_CONV [r7] THEN
      MATCH_MP_TAC REALLIM_RMUL THEN MATCH_MP_TAC REALLIM_SUB THEN
      REWRITE_TAC [REALLIM_CONST] THEN
      MP_TAC (← ISPECL [(← q r"sequentially"), (← q r"\n. inv(&n + &1)"), (← q r"&0:real"),
                        (← q r"s - &1:real")] REALLIM_RPOW) THEN
      REWRITE_TAC [REALLIM_1_OVER_N_OFFSET, RPOW_ZERO] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [r8] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN
      AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [RPOW_INV, ← GSYM RPOW_NEG] THEN AP_TERM_TAC THEN
      REAL_ARITH_TAC,
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_UBOUND) THEN
      EXISTS_TAC (← q r"\n. sum(1..n) (\m. inv(&m rpow s))") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q "1") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num") o check (α := thm) (fun th =>
        HolCore.Basics.is_forall (concl th) &&
        (HolCore.Basics.dest_forall (concl th)).toOption.any (fun (p : term × term) => let b := p.2; HolCore.Basics.is_imp b))) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC r9 THEN
      SUBGOAL_THEN (← q r"s / (s - &1) = &1 + &1 / (s - &1)") SUBST1_TAC THENL
       [UNDISCH_TAC (← q r"&1 < s:real") THEN CONV_TAC REAL_FIELD, ALL_TAC] THEN
      MATCH_MP_TAC r10 THEN
      MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [RPOW_POS_LE, REAL_POS, r11]]))

  -- Some variants with real derivatives.

  let HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1_ALT ← prove
   r"!f:real^1->real^N g:real^1->real^1 g' s b.
        lebesgue_measurable s /\
        (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\
        (!x. x IN IMAGE drop s
             ==> ((drop o g o lift) has_real_derivative g' x)
                 (atreal x within IMAGE drop s))
        ==> ((\x. abs(g'(drop x)) % f(g x)) absolutely_integrable_on s /\
             integral s (\x. abs(g'(drop x)) % f(g x)) = b <=>
             f absolutely_integrable_on IMAGE g s /\
             integral (IMAGE g s) f = b)"
   (REWRITE_TAC [HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM IMAGE_o] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IMAGE_ID, ETA_AX] THEN
    REWRITE_TAC [HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1])

  let ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1_ALT ← prove
   r"!f:real^1->real^N g:real^1->real^1 g' s b.
        lebesgue_measurable s /\
        (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\
        (!x. x IN IMAGE drop s
             ==> ((drop o g o lift) has_real_derivative g' x)
                 (atreal x within IMAGE drop s))
        ==> (f absolutely_integrable_on IMAGE g s <=>
             (\x. abs(g'(drop x)) % f(g x)) absolutely_integrable_on s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o
      MATCH_MP HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1_ALT) THEN
    MESON_TAC [])

  -- Relating different kinds of real limits.

  let REALLIM_POSINFINITY_SEQUENTIALLY ← prove
   r"!f l. (f ---> l) at_posinfinity ==> ((\n. f(&n)) ---> l) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIM_POSINFINITY_SEQUENTIALLY) THEN
    REWRITE_TAC [o_DEF])

  let LIM_ZERO_POSINFINITY ← prove
   r"!f l. ((\x. f(&1 / x)) --> l) (atreal (&0)) ==> (f --> l) at_posinfinity"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_ATREAL, LIM_AT_POSINFINITY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [dist, REAL_SUB_RZERO, real_ge] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"&2 / d") THEN X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(z):real")) THEN
    REWRITE_TAC [real_div, REAL_MUL_LINV, REAL_INV_INV] THEN
    REWRITE_TAC [REAL_MUL_LID] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [REAL_ABS_INV, REAL_LT_INV_EQ] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"a <= z ==> &0 < a ==> &0 < abs z"))),
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_INV] THEN
      MATCH_MP_TAC REAL_LT_INV2 THEN ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"&2 / d <= z ==> &0 < &2 / d ==> inv d < abs z")))] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH])

  let LIM_ZERO_NEGINFINITY ← prove
   r"!f l. ((\x. f(&1 / x)) --> l) (atreal (&0)) ==> (f --> l) at_neginfinity"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIM_ATREAL, LIM_AT_NEGINFINITY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [dist, REAL_SUB_RZERO, real_ge] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"--(&2 / d)") THEN X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(z):real")) THEN
    REWRITE_TAC [real_div, REAL_MUL_LINV, REAL_INV_INV] THEN
    REWRITE_TAC [REAL_MUL_LID] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [REAL_ABS_INV, REAL_LT_INV_EQ] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"z <= --a ==> &0 < a ==> &0 < abs z"))),
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_INV] THEN
      MATCH_MP_TAC REAL_LT_INV2 THEN ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"z <= --(&2 / d) ==> &0 < &2 / d ==> inv d < abs z")))] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH])

  let REALLIM_ZERO_POSINFINITY ← prove
   r"!f l. ((\x. f(&1 / x)) ---> l) (atreal (&0)) ==> (f ---> l) at_posinfinity"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF, LIM_ZERO_POSINFINITY])

  let REALLIM_ZERO_NEGINFINITY ← prove
   r"!f l. ((\x. f(&1 / x)) ---> l) (atreal (&0)) ==> (f ---> l) at_neginfinity"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF, LIM_ZERO_NEGINFINITY])

  pure { REAL_SUM_INTEGRAL_UBOUND_INCREASING, REAL_SUM_INTEGRAL_UBOUND_DECREASING,
         REAL_SUM_INTEGRAL_LBOUND_INCREASING, REAL_SUM_INTEGRAL_LBOUND_DECREASING,
         REAL_SUM_INTEGRAL_BOUNDS_INCREASING, REAL_SUM_INTEGRAL_BOUNDS_DECREASING, RPOW_TELESCOPE_BOUNDS, REAL_INFSUM_ZETA_BOUNDS,
         HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1_ALT,
         ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1_ALT,
         REALLIM_POSINFINITY_SEQUENTIALLY, LIM_ZERO_POSINFINITY, LIM_ZERO_NEGINFINITY,
         REALLIM_ZERO_POSINFINITY, REALLIM_ZERO_NEGINFINITY }
/- ------------------------------------------------------------------------- -/
/- Real segments (bidirectional intervals); a nice lemma from "Concrete     -/
/- Mathematics".                                                            -/
/- (realanalysis.ml 7040-7173)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAD where
  closed_real_segment : thm
  open_real_segment : thm
  real_segment : thm
  REAL_SEGMENT_SEGMENT : thm
  SEGMENT_REAL_SEGMENT : thm
  IMAGE_LIFT_REAL_SEGMENT : thm
  REAL_SEGMENT_INTERVAL : thm
  REAL_INTERVAL_SUBSET_REAL_SEGMENT : thm
  REAL_CONTINUOUS_INJECTIVE_IFF_MONOTONIC : thm
  ENDS_IN_REAL_SEGMENT : thm
  IS_REAL_INTERVAL_CONTAINS_SEGMENT : thm
  IS_REALINTERVAL_CONTAINS_SEGMENT_EQ : thm
  IS_REALINTERVAL_CONTAINS_SEGMENT_IMP : thm
  IS_REALINTERVAL_SEGMENT : thm
  IN_REAL_SEGMENT : thm
  FLOOR_CONTINUOUS_MONOTONE_FLOOR : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAD [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZM : RZM) (BRZS : RZS) : ExceptT String IO RZAD := do
  -- @@SCOPE BEGIN
  let { make_overloadable, .. } := D
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_SUBSET, .. } := BRZJ
  let { IS_REALINTERVAL_CONVEX, .. } := BRZM
  let { REAL_IVT_INCREASING, .. } := BRZS
  let { LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { IS_REALINTERVAL_IS_INTERVAL, REAL_INTERVAL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, is_realinterval, IS_REALINTERVAL_INTERVAL,
        REAL_INTERVAL_EQ_EMPTY, .. } := D.qmisc
  let { IMAGE_DIFF_INJ, .. } := D.qsession
  let { FLOOR_MONO, FLOOR_UNIQUE, .. } := D.qfloor
  let { CONTINUOUS_INJECTIVE_IFF_MONOTONIC, .. } := D.qpaths
  let { REAL_LT_SUB_RADD, .. } := D.ts.qsession
  let { define, overload_interface, .. } := D.ts.cn.cx
  let { REAL_FLOOR_LE, .. } := D.ts.cn.ms.qfloor
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, SET_RULE,
        .. } := D.ts.cn.cx.cvx
  let { FLOOR, REAL_LE_FLOOR, .. } := D.ts.cn.ms.ig.qfloor
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_ID, IMAGE_o, IMP_CONJ,
        .. } := D.ts.cn.cx.cvx.core2
  let { NOT_IMP, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LT_IMP_LE, REAL_LT_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_REFL,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, FORALL_LIFT, LIFT_DROP, LIFT_EQ,
        .. } := D.ts.cn.cx.cvx.vec2
  let { segment, SEGMENT_1, .. } := D.ts.cn.cx.cvx.top5
  let { CONVEX_CONTAINS_SEGMENT, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let closed_real_segment ← define
   r"closed_real_segment[a,b] = {(&1 - u) * a + u * b | &0 <= u /\ u <= &1}"

  let open_real_segment ← new_definition
   r"open_real_segment(a,b) = closed_real_segment[a,b] DIFF {a,b}"

  make_overloadable "real_segment" (← qty "A")

  overload_interface "real_segment" (← q "open_real_segment")
  overload_interface "real_segment" (← q "closed_real_segment")

  let real_segment ← prove
   r"real_segment[a,b] = {(&1 - u) * a + u * b | &0 <= u /\ u <= &1} /\
   real_segment(a,b) = real_segment[a,b] DIFF {a,b}"
   (REWRITE_TAC [open_real_segment, closed_real_segment])

  let REAL_SEGMENT_SEGMENT ← prove
   r"(!a b. real_segment[a,b] = IMAGE drop (segment[lift a,lift b])) /\
   (!a b. real_segment(a,b) = IMAGE drop (segment(lift a,lift b)))"
   (REWRITE_TAC [segment, real_segment] THEN
    SIMP_TAC [IMAGE_DIFF_INJ, DROP_EQ, IMAGE_CLAUSES, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, DROP_ADD, DROP_CMUL, LIFT_DROP])

  let SEGMENT_REAL_SEGMENT ← prove
   r"(!a b. segment[a,b] = IMAGE lift (real_segment[drop a,drop b])) /\
   (!a b. segment(a,b) = IMAGE lift (real_segment(drop a,drop b)))"
   (REWRITE_TAC [REAL_SEGMENT_SEGMENT, ← GSYM IMAGE_o] THEN
    REWRITE_TAC [o_DEF, IMAGE_ID, LIFT_DROP])

  let IMAGE_LIFT_REAL_SEGMENT ← prove
   r"(!a b. IMAGE lift (real_segment[a,b]) = segment[lift a,lift b]) /\
   (!a b. IMAGE lift (real_segment(a,b)) = segment(lift a,lift b))"
   (REWRITE_TAC [SEGMENT_REAL_SEGMENT, LIFT_DROP])

  let REAL_SEGMENT_INTERVAL ← prove
   r"(!a b. real_segment[a,b] =
          if a <= b then real_interval[a,b] else real_interval[b,a]) /\
   (!a b. real_segment(a,b) =
          if a <= b then real_interval(a,b) else real_interval(b,a))"
   (REWRITE_TAC [REAL_SEGMENT_SEGMENT, SEGMENT_1, LIFT_DROP] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL] THEN
    CONJ_TAC THEN REPEAT GEN_TAC THEN COND_CASES_TAC THEN REWRITE_TAC [])

  let REAL_INTERVAL_SUBSET_REAL_SEGMENT ← prove
   r"(!a b. real_interval[a,b] SUBSET real_segment[a,b]) /\
   (!a b. real_interval(a,b) SUBSET real_segment(a,b))"
   (REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s = {} ==> s SUBSET t")) THEN
    REWRITE_TAC [REAL_INTERVAL_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC)

  let REAL_CONTINUOUS_INJECTIVE_IFF_MONOTONIC ← prove
   r"!f s.
        f real_continuous_on s /\ is_realinterval s
        ==> ((!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) <=>
             (!x y. x IN s /\ y IN s /\ x < y ==> f x < f y) \/
             (!x y. x IN s /\ y IN s /\ x < y ==> f y < f x))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, IS_REALINTERVAL_IS_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_INJECTIVE_IFF_MONOTONIC) THEN
    REWRITE_TAC [FORALL_LIFT, LIFT_IN_IMAGE_LIFT, o_THM, LIFT_DROP, LIFT_EQ])

  let ENDS_IN_REAL_SEGMENT ← prove
   r"!a b. a IN real_segment[a,b] /\ b IN real_segment[a,b]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
    ASM_REAL_ARITH_TAC)

  let IS_REAL_INTERVAL_CONTAINS_SEGMENT ← prove
   r"!s. is_realinterval s <=>
       !a b. a IN s /\ b IN s ==> real_segment[a,b] SUBSET s"
   (REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, IS_REALINTERVAL_CONVEX] THEN
    REWRITE_TAC [REAL_SEGMENT_SEGMENT, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_IMAGE_LIFT_DROP])

  let IS_REALINTERVAL_CONTAINS_SEGMENT_EQ ← prove
   r"!s. is_realinterval s <=>
       !a b. real_segment [a,b] SUBSET s <=> a IN s /\ b IN s"
   (MESON_TAC [IS_REAL_INTERVAL_CONTAINS_SEGMENT,
               SUBSET, ENDS_IN_REAL_SEGMENT])

  let IS_REALINTERVAL_CONTAINS_SEGMENT_IMP ← prove
   r"!s a b. is_realinterval s
           ==> (real_segment [a,b] SUBSET s <=> a IN s /\ b IN s)"
   (MESON_TAC [IS_REALINTERVAL_CONTAINS_SEGMENT_EQ])

  let IS_REALINTERVAL_SEGMENT ← prove
   r"(!a b. is_realinterval(real_segment[a,b])) /\
   (!a b. is_realinterval(real_segment(a,b)))"
   (REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    MESON_TAC [IS_REALINTERVAL_INTERVAL])

  let IN_REAL_SEGMENT ← prove
   r"(!a b x. x IN real_segment[a,b] <=> a <= x /\ x <= b \/ b <= x /\ x <= a) /\
   (!a b x. x IN real_segment(a,b) <=> a < x /\ x < b \/ b < x /\ x < a)"
   (REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC)

  -- A nice lemma from "Concrete Mathematics" (for example f = sqrt).

  let FLOOR_CONTINUOUS_MONOTONE_FLOOR ← prove
   r"!f s. is_realinterval s /\
         f real_continuous_on s /\
         (!x y. x IN s /\ y IN s /\ x <= y ==> f x <= f y) /\
         (!x. x IN s /\ integer(f x) ==> integer x)
         ==> !x. floor x IN s /\ x IN s ==> floor(f(floor x)) = floor(f x)"
   (REWRITE_TAC [is_realinterval, ← GSYM REAL_LE_ANTISYM] THEN
    REPEAT STRIP_TAC THENL [ASM_MESON_TAC [FLOOR_MONO, FLOOR], ALL_TAC] THEN
    SIMP_TAC [REAL_LE_FLOOR, FLOOR] THEN
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real->real", ← q r"floor x", ← q r"x:real", ← q r"floor(f(x:real))"]
          REAL_IVT_INCREASING) THEN
    ASM_SIMP_TAC [FLOOR, IN_REAL_INTERVAL, REAL_LT_IMP_LE, NOT_IMP] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        REAL_CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN ASM_MESON_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"integer y") ASSUME_TAC THENL
       [ASM_MESON_TAC [FLOOR], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"floor x = y") (fun th => ASM_MESON_TAC [th, REAL_LT_REFL]) THEN
      ASM_REWRITE_TAC [← GSYM FLOOR_UNIQUE, ← GSYM REAL_LT_SUB_RADD] THEN
      ASM_MESON_TAC [REAL_FLOOR_LE]])

  pure { closed_real_segment, open_real_segment, real_segment, REAL_SEGMENT_SEGMENT,
         SEGMENT_REAL_SEGMENT, IMAGE_LIFT_REAL_SEGMENT, REAL_SEGMENT_INTERVAL,
         REAL_INTERVAL_SUBSET_REAL_SEGMENT, REAL_CONTINUOUS_INJECTIVE_IFF_MONOTONIC,
         ENDS_IN_REAL_SEGMENT, IS_REAL_INTERVAL_CONTAINS_SEGMENT,
         IS_REALINTERVAL_CONTAINS_SEGMENT_EQ, IS_REALINTERVAL_CONTAINS_SEGMENT_IMP,
         IS_REALINTERVAL_SEGMENT, IN_REAL_SEGMENT, FLOOR_CONTINUOUS_MONOTONE_FLOOR }
/- ------------------------------------------------------------------------- -/
/- Convex real->real functions (part 1).                                     -/
/- (realanalysis.ml 7174-7427)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAE where
  real_convex_on : thm
  REAL_CONVEX_ON_EMPTY : thm
  REAL_CONVEX_ON : thm
  REAL_CONVEX_ON_EQ : thm
  REAL_CONVEX_ON_SING : thm
  REAL_CONVEX_ON_SUBSET : thm
  REAL_CONVEX_ON_CONST : thm
  REAL_CONVEX_ADD : thm
  REAL_CONVEX_LMUL : thm
  REAL_CONVEX_RMUL : thm
  REAL_CONVEX_ON_SUM : thm
  REAL_CONVEX_CONVEX_COMPOSE : thm
  REAL_CONVEX_COMPOSE : thm
  REAL_CONVEX_LOWER : thm
  REAL_CONVEX_LOWER_REAL_SEGMENT : thm
  REAL_CONVEX_LOWER_REAL_INTERVAL : thm
  REAL_CONVEX_LOCAL_GLOBAL_MINIMUM : thm
  REAL_CONVEX_DISTANCE : thm
  REAL_CONVEX_ON_JENSEN : thm
  REAL_CONVEX_ON_IMP_JENSEN : thm
  REAL_CONVEX_ON_CONTINUOUS : thm
  REAL_CONVEX_ON_LEFT_SECANT_MUL : thm
  REAL_CONVEX_ON_RIGHT_SECANT_MUL : thm
  REAL_CONVEX_ON_LEFT_SECANT : thm
  REAL_CONVEX_ON_RIGHT_SECANT : thm
  REAL_CONVEX_ON_DERIVATIVE_SECANT_IMP : thm
  REAL_CONVEX_ON_SECANT_DERIVATIVE_IMP : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAE [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZL : RZL) (BRZM : RZM) (BRZAD : RZAD) : ExceptT String IO RZAE := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, .. } := BRZA
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { HAS_REAL_FRECHET_DERIVATIVE_WITHIN, .. } := BRZL
  let { IS_REALINTERVAL_CONVEX, .. } := BRZM
  let { ENDS_IN_REAL_SEGMENT, REAL_SEGMENT_INTERVAL, REAL_SEGMENT_SEGMENT, .. } := BRZAD
  let { DROP_IN_IMAGE_DROP, LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { IS_REALINTERVAL_IS_INTERVAL, .. } := D.qtopology
  let { REAL_INTERVAL_NE_EMPTY, .. } := D.qmisc
  let { CONVEX_ADD, CONVEX_CMUL, CONVEX_DISTANCE, CONVEX_LOCAL_GLOBAL_MINIMUM,
        CONVEX_LOWER, CONVEX_LOWER_SEGMENT, CONVEX_ON_CONST, CONVEX_ON_EQ,
        CONVEX_ON_IMP_JENSEN, CONVEX_ON_JENSEN, CONVEX_ON_LEFT_SECANT_MUL,
        CONVEX_ON_RIGHT_SECANT_MUL, CONVEX_ON_SING, .. } := D.qconvex
  let { CONVEX_ON_DERIVATIVE_SECANT_IMP, CONVEX_ON_SECANT_DERIVATIVE_IMP,
        .. } := D.qderivatives
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, SET_RULE,
        .. } := D.ts.cn.cx.cvx
  let { convex, .. } := D.ts.cn.cx.cpx
  let { CONVEX_ON_CONTINUOUS, CONVEX_ON_RIGHT_SECANT, CONVEX_ON_SUBSET,
        .. } := D.ts.cn.ms.ig.qconvex
  let { NORM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { CONJ_ASSOC, ETA_AX, FINITE_INDUCT_STRONG, FINITE_NUMSEG,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_o,
        IMAGE_SUBSET, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VSUM, FORALL_DROP, LIFT_DROP,
        .. } := D.ts.cn.cx.cvx.vec2
  let { dist, drop, .. } := D.ts.cn.cx.cvx.vec4
  let { convex_on, CONVEX_ON_LEFT_SECANT, .. } := D.ts.cn.ms.ig.dv.qconvex
  let { IS_INTERVAL_CONVEX_1, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  parse_as_infix ("real_convex_on", (12, "right"))

  let real_convex_on ← new_definition
   r"(f:real->real) real_convex_on s <=>
        !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ (u + v = &1)
                  ==> f(u * x + v * y) <= u * f(x) + v * f(y)"

  let REAL_CONVEX_ON_EMPTY ← prove
   r"!f. f real_convex_on {}"
   (REWRITE_TAC [real_convex_on, NOT_IN_EMPTY])

  let REAL_CONVEX_ON ← prove
   r"!f s. f real_convex_on s <=> (f o drop) convex_on (IMAGE lift s)"
   (REWRITE_TAC [real_convex_on, convex_on] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM, LIFT_DROP, DROP_ADD, DROP_CMUL])

  let REAL_CONVEX_ON_EQ ← prove
   r"!f g s.
         is_realinterval s /\ (!x. x IN s ==> f x = g x) /\ f real_convex_on s
         ==> g real_convex_on s"
   (REWRITE_TAC [IS_REALINTERVAL_CONVEX, REAL_CONVEX_ON] THEN
    REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      (← REWRITE_RULE [CONJ_ASSOC] CONVEX_ON_EQ)) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP])

  let REAL_CONVEX_ON_SING ← prove
   r"!f a. f real_convex_on {a}"
   (REWRITE_TAC [REAL_CONVEX_ON, IMAGE_CLAUSES, CONVEX_ON_SING])

  let REAL_CONVEX_ON_SUBSET ← prove
   r"!f s t. f real_convex_on t /\ s SUBSET t ==> f real_convex_on s"
   (REWRITE_TAC [REAL_CONVEX_ON] THEN
    MESON_TAC [CONVEX_ON_SUBSET, IMAGE_SUBSET])

  let REAL_CONVEX_ON_CONST ← prove
   r"!s c. (\x. c) real_convex_on s"
   (REWRITE_TAC [REAL_CONVEX_ON, o_DEF, CONVEX_ON_CONST])

  let REAL_CONVEX_ADD ← prove
   r"!s f g. f real_convex_on s /\ g real_convex_on s
           ==> (\x. f(x) + g(x)) real_convex_on s"
   (REWRITE_TAC [REAL_CONVEX_ON, o_DEF, CONVEX_ADD])

  let REAL_CONVEX_LMUL ← prove
   r"!s c f. &0 <= c /\ f real_convex_on s ==> (\x. c * f(x)) real_convex_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_CONVEX_ON, o_DEF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVEX_CMUL) THEN REWRITE_TAC [])

  let REAL_CONVEX_RMUL ← prove
   r"!s c f. &0 <= c /\ f real_convex_on s ==> (\x. f(x) * c) real_convex_on s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [REAL_CONVEX_LMUL])

  let REAL_CONVEX_ON_SUM ← prove
   r"!t f:A->real->real s.
         FINITE s /\ (!a. a IN s ==> f a real_convex_on t)
         ==> (\x. sum s (\a. f a x)) real_convex_on t"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, REAL_CONVEX_ON_CONST, FORALL_IN_INSERT] THEN
    SIMP_TAC [REAL_CONVEX_ADD, ETA_AX])

  let REAL_CONVEX_CONVEX_COMPOSE ← prove
   r"!f g s:real^N->bool t.
        f convex_on s /\ g real_convex_on t /\
        convex s /\ is_realinterval t /\ IMAGE f s SUBSET t /\
        (!x y. x IN t /\ y IN t /\ x <= y ==> g x <= g y)
        ==> (g o f) convex_on s"
   (REWRITE_TAC [convex_on, convex, IS_REALINTERVAL_CONVEX,
                 real_convex_on, SUBSET] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, o_DEF] THEN
    REWRITE_TAC [IN_IMAGE_LIFT_DROP, DROP_ADD, DROP_CMUL, LIFT_DROP] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    ASM_MESON_TAC [REAL_LE_TRANS])

  let REAL_CONVEX_COMPOSE ← prove
   r"!f g s t.
        f real_convex_on s /\ g real_convex_on t /\
        is_realinterval s /\ is_realinterval t /\ IMAGE f s SUBSET t /\
        (!x y. x IN t /\ y IN t /\ x <= y ==> g x <= g y)
       ==> (g o f) real_convex_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_CONVEX_ON, ← GSYM o_ASSOC] THEN
    MATCH_MP_TAC REAL_CONVEX_CONVEX_COMPOSE THEN EXISTS_TAC (← q r"t:real->bool") THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONVEX_ON, ← GSYM IMAGE_o, o_DEF, LIFT_DROP,
                     ETA_AX, ← GSYM IS_REALINTERVAL_CONVEX])

  let REAL_CONVEX_LOWER ← prove
   r"!f s x y. f real_convex_on s /\
             x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
             ==> f(u * x + v * y) <= max (f(x)) (f(y))"
   (REWRITE_TAC [REAL_CONVEX_ON] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONVEX_LOWER) THEN
    REWRITE_TAC [o_THM, DROP_ADD, DROP_CMUL])

  let REAL_CONVEX_LOWER_REAL_SEGMENT ← prove
   r"!f s a b x.
        f real_convex_on s /\ a IN s /\ b IN s /\ x IN real_segment[a,b]
        ==> f x <= max (f a) (f b)"
   (REWRITE_TAC [REAL_CONVEX_ON, REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP, DROP_IN_IMAGE_DROP] THEN
    REWRITE_TAC [← GSYM IN_IMAGE_LIFT_DROP, o_DEF] THEN
    REWRITE_TAC [CONVEX_LOWER_SEGMENT])

  let REAL_CONVEX_LOWER_REAL_INTERVAL ← prove
   r"!f a b x.
        f real_convex_on real_interval[a,b] /\ x IN real_interval[a,b]
        ==> f x <= max (f a) (f b)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONVEX_LOWER_REAL_SEGMENT THEN
    EXISTS_TAC (← q r"real_segment[a,b]") THEN REWRITE_TAC [ENDS_IN_REAL_SEGMENT] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q r"a IN s ==> ~(s = {})"))) THEN
    ASM_SIMP_TAC [REAL_SEGMENT_INTERVAL, REAL_INTERVAL_NE_EMPTY])

  let REAL_CONVEX_LOCAL_GLOBAL_MINIMUM ← prove
   r"!f s t x.
       f real_convex_on s /\ x IN t /\ real_open t /\ t SUBSET s /\
       (!y. y IN t ==> f(x) <= f(y))
       ==> !y. y IN s ==> f(x) <= f(y)"
   (REWRITE_TAC [REAL_CONVEX_ON, REAL_OPEN] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(f:real->real) o drop", ← q r"IMAGE lift s",
                      ← q r"IMAGE lift t", ← q r"x:real^1"] CONVEX_LOCAL_GLOBAL_MINIMUM) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_THM, IMAGE_SUBSET])

  let REAL_CONVEX_DISTANCE ← prove
   r"!s a. (\x. abs(a - x)) real_convex_on s"
   (REWRITE_TAC [REAL_CONVEX_ON, o_DEF, FORALL_DROP, ← GSYM DROP_SUB] THEN
    REWRITE_TAC [drop, ← GSYM NORM_REAL, ← GSYM dist, CONVEX_DISTANCE])

  let REAL_CONVEX_ON_JENSEN ← prove
   r"!f s. is_realinterval s
         ==> (f real_convex_on s <=>
                !k u x.
                   (!i:num. 1 <= i /\ i <= k ==> &0 <= u(i) /\ x(i) IN s) /\
                   (sum (1..k) u = &1)
                   ==> f(sum (1..k) (\i. u(i) * x(i)))
                           <= sum (1..k) (\i. u(i) * f(x(i))))"
   (REWRITE_TAC [IS_REALINTERVAL_CONVEX, REAL_CONVEX_ON] THEN
    SIMP_TAC [CONVEX_ON_JENSEN] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [o_DEF, DROP_VSUM, FINITE_NUMSEG] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:num->real") THEN REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:num->real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"lift o (x:num->real)")) THEN
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, IN_IMAGE_LIFT_DROP] THEN
      REWRITE_TAC [DROP_CMUL, LIFT_DROP],
      X_GEN_TAC (← q r"x:num->real^1") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"drop o (x:num->real^1)")) THEN
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, IN_IMAGE_LIFT_DROP] THEN
      ASM_REWRITE_TAC [DROP_CMUL, LIFT_DROP, ← GSYM IN_IMAGE_LIFT_DROP]])

  let REAL_CONVEX_ON_IMP_JENSEN ← prove
   r"!f s k:A->bool u x.
        f real_convex_on s /\ is_realinterval s /\ FINITE k /\
        (!i. i IN k ==> &0 <= u i /\ x i IN s) /\ sum k u = &1
        ==> f(sum k (\i. u i * x i)) <= sum k (\i. u i * f(x i))"
   (REWRITE_TAC [REAL_CONVEX_ON, IS_REALINTERVAL_IS_INTERVAL] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
     SPECL [← q r"k:A->bool", ← q r"u:A->real", ← q r"\i:A. lift(x i)"] o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] CONVEX_ON_IMP_JENSEN)) THEN
    ASM_REWRITE_TAC [LIFT_IN_IMAGE_LIFT, o_DEF, LIFT_DROP, DROP_VSUM, DROP_CMUL,
                     ← GSYM IS_INTERVAL_CONVEX_1])

  let REAL_CONVEX_ON_CONTINUOUS ← prove
   r"!f s. real_open s /\ f real_convex_on s ==> f real_continuous_on s"
   (REWRITE_TAC [REAL_CONVEX_ON, REAL_OPEN, REAL_CONTINUOUS_ON] THEN
    REWRITE_TAC [CONVEX_ON_CONTINUOUS])

  let REAL_CONVEX_ON_LEFT_SECANT_MUL ← prove
   r"!f s. f real_convex_on s <=>
          !a b x. a IN s /\ b IN s /\ x IN real_segment[a,b]
                  ==> (f x - f a) * abs(b - a) <= (f b - f a) * abs(x - a)"
   (REWRITE_TAC [REAL_CONVEX_ON, CONVEX_ON_LEFT_SECANT_MUL] THEN
    REWRITE_TAC [REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_RIGHT_SECANT_MUL ← prove
   r"!f s. f real_convex_on s <=>
          !a b x. a IN s /\ b IN s /\ x IN real_segment[a,b]
                  ==> (f b - f a) * abs(b - x) <= (f b - f x) * abs(b - a)"
   (REWRITE_TAC [REAL_CONVEX_ON, CONVEX_ON_RIGHT_SECANT_MUL] THEN
    REWRITE_TAC [REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_LEFT_SECANT ← prove
   r"!f s.
      f real_convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN real_segment(a,b)
                ==> (f x - f a) / abs(x - a) <= (f b - f a) / abs(b - a)"
   (REWRITE_TAC [REAL_CONVEX_ON, CONVEX_ON_LEFT_SECANT] THEN
    REWRITE_TAC [REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_RIGHT_SECANT ← prove
   r"!f s.
      f real_convex_on s <=>
        !a b x. a IN s /\ b IN s /\ x IN real_segment(a,b)
                ==> (f b - f a) / abs(b - a) <= (f b - f x) / abs(b - x)"
   (REWRITE_TAC [REAL_CONVEX_ON, CONVEX_ON_RIGHT_SECANT] THEN
    REWRITE_TAC [REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_DERIVATIVE_SECANT_IMP ← prove
   r"!f f' s x y.
        f real_convex_on s /\ real_segment[x,y] SUBSET s /\
        (f has_real_derivative f') (atreal x within s)
        ==> f' * (y - x) <= f y - f x"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE_LIFT_DROP] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [FORALL_DROP] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    REWRITE_TAC [← GSYM IN_IMAGE_LIFT_DROP, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP]
          (← q r"\x. lift(drop(f % x))")))] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVEX_ON_DERIVATIVE_SECANT_IMP) THEN
    REWRITE_TAC [o_THM, DROP_CMUL, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_SECANT_DERIVATIVE_IMP ← prove
   r"!f f' s x y.
        f real_convex_on s /\ real_segment[x,y] SUBSET s /\
        (f has_real_derivative f') (atreal y within s)
        ==> f y - f x <= f' * (y - x)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE_LIFT_DROP] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [FORALL_DROP] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    REWRITE_TAC [← GSYM IN_IMAGE_LIFT_DROP, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP]
          (← q r"\x. lift(drop(f % x))")))] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVEX_ON_SECANT_DERIVATIVE_IMP) THEN
    REWRITE_TAC [o_THM, DROP_CMUL, DROP_SUB, LIFT_DROP])

  pure { real_convex_on, REAL_CONVEX_ON_EMPTY, REAL_CONVEX_ON, REAL_CONVEX_ON_EQ,
         REAL_CONVEX_ON_SING, REAL_CONVEX_ON_SUBSET, REAL_CONVEX_ON_CONST, REAL_CONVEX_ADD,
         REAL_CONVEX_LMUL, REAL_CONVEX_RMUL, REAL_CONVEX_ON_SUM, REAL_CONVEX_CONVEX_COMPOSE,
         REAL_CONVEX_COMPOSE, REAL_CONVEX_LOWER, REAL_CONVEX_LOWER_REAL_SEGMENT,
         REAL_CONVEX_LOWER_REAL_INTERVAL, REAL_CONVEX_LOCAL_GLOBAL_MINIMUM,
         REAL_CONVEX_DISTANCE, REAL_CONVEX_ON_JENSEN, REAL_CONVEX_ON_IMP_JENSEN,
         REAL_CONVEX_ON_CONTINUOUS, REAL_CONVEX_ON_LEFT_SECANT_MUL,
         REAL_CONVEX_ON_RIGHT_SECANT_MUL, REAL_CONVEX_ON_LEFT_SECANT,
         REAL_CONVEX_ON_RIGHT_SECANT, REAL_CONVEX_ON_DERIVATIVE_SECANT_IMP,
         REAL_CONVEX_ON_SECANT_DERIVATIVE_IMP }
/- ------------------------------------------------------------------------- -/
/- Convex real->real functions (part 2).                                     -/
/- (realanalysis.ml 7428-7784)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAF where
  REAL_CONVEX_ON_DERIVATIVES_IMP : thm
  REAL_CONVEX_ON_DERIVATIVE_INCREASING_IMP : thm
  REAL_CONVEX_ON_DERIVATIVE_SECANT : thm
  REAL_CONVEX_ON_SECANT_DERIVATIVE : thm
  REAL_CONVEX_ON_DERIVATIVES : thm
  REAL_CONVEX_ON_DERIVATIVE_INCREASING : thm
  HAS_REAL_DERIVATIVE_INCREASING_IMP : thm
  HAS_REAL_DERIVATIVE_INCREASING : thm
  HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP : thm
  REAL_CONVEX_ON_SECOND_DERIVATIVE : thm
  REAL_CONVEX_ON_ASYM : thm
  REAL_CONVEX_ON_EXP : thm
  REAL_CONVEX_ON_RPOW : thm
  REAL_CONVEX_ON_RPOW_NEG : thm
  REAL_CONVEX_ON_RPOW_INTEGER : thm
  REAL_CONVEX_ON_REAL_INV : thm
  CONVEX_ON_REAL_POW : thm
  REAL_CONVEX_ON_REAL_POW : thm
  REAL_CONVEX_ON_LOG : thm
  REAL_CONTINUOUS_MIDPOINT_CONVEX : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAF [HolBase] (D : RealAnalysisDeps) (BRZB : RZB) (BRZF : RZF) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZM : RZM) (BRZN : RZN) (BRZP : RZP) (BRZQ : RZQ) (BRZT : RZT) (BRZAD : RZAD) (BRZAE : RZAE) : ExceptT String IO RZAF := do
  -- @@SCOPE BEGIN
  let { REALLIM_LBOUND, .. } := BRZB
  let { EVENTUALLY_WITHINREAL, .. } := BRZF
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { HAS_REAL_DERIVATIVE_WITHINREAL, real_differentiable_on, .. } := BRZK
  let { HAS_REAL_FRECHET_DERIVATIVE_WITHIN, .. } := BRZL
  let { IS_REALINTERVAL_CLAUSES, IS_REALINTERVAL_CONVEX, TRIVIAL_LIMIT_WITHIN_REALINTERVAL,
        .. } := BRZM
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN,
        HAS_REAL_DERIVATIVE_WITHIN_SUBSET, REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON,
        .. } := BRZN
  let { HAS_REAL_DERIVATIVE_EXP, .. } := BRZP
  let { REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_MVT, REAL_MVT_VERY_SIMPLE, .. } := BRZT
  let { REAL_SEGMENT_INTERVAL, REAL_SEGMENT_SEGMENT, .. } := BRZAD
  let { REAL_CONVEX_COMPOSE, REAL_CONVEX_CONVEX_COMPOSE, REAL_CONVEX_ON, real_convex_on,
        REAL_CONVEX_ON_CONST, REAL_CONVEX_ON_SUBSET, .. } := BRZAE
  let { REAL_EXP_MONO_LE, REAL_EXP_POS_LE, .. } := D.tsb
  let { EXP_LOG, LOG_INV, LOG_POS, .. } := D.tsd
  let { rpow, RPOW_MUL, RPOW_NEG, RPOW_POS_LE, RPOW_POW, RPOW_ZERO, .. } := D.tsab
  let { REAL_OPEN_REAL_INTERVAL, .. } := D.qmetric
  let { IN_REAL_INTERVAL, is_realinterval, IS_REALINTERVAL_UNIV,
        REAL_INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.qmisc
  let { CONVEX_ON_CONST, .. } := D.qconvex
  let { CONVEX_ON_DERIVATIVE_SECANT, CONVEX_ON_DERIVATIVES, CONVEX_ON_DERIVATIVES_IMP,
        CONVEX_ON_SECANT_DERIVATIVE, .. } := D.qderivatives
  let { REAL_INV_1_LE, .. } := D.ts.qsession
  let { INTEGER_NEG, .. } := D.ts.qfloor
  let { REAL_LT_INTEGERS, .. } := D.ts.cn.ms.qfloor
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { CONTINUOUS_MIDPOINT_CONVEX, .. } := D.ts.cn.ms.ig.qconvex
  let { INTEGER_CLOSED, .. } := D.ts.cn.ms.ig.qfloor
  let { EQ_TRANS, ETA_AX, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_SING, IN_UNIV, MONO_FORALL, NOT_EXISTS_THM, REAL_ADD_LID,
        REAL_ADD_RDISTRIB, REAL_ADD_SYM, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_INV_NEG, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_MUL,
        REAL_LE_POW_2, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_RMUL_EQ, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_MUL,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LNEG, REAL_MUL_LZERO, REAL_MUL_RNEG, REAL_MUL_RZERO,
        REAL_NEG_NEG, REAL_NEG_SUB, REAL_NOT_LE, REAL_OF_NUM_LE, REAL_POW_LE2, REAL_SUB_LE,
        REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_div, real_pow, SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_SUB, FORALL_DROP, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { midpoint, .. } := D.ts.cn.cx.cvx.vec4
  let { REAL_WLOG_LT, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let REAL_CONVEX_ON_DERIVATIVES_IMP ← prove
   r"!f f'x f'y s x y.
        f real_convex_on s /\ real_segment[x,y] SUBSET s /\
        (f has_real_derivative f'x) (atreal x within s) /\
        (f has_real_derivative f'y) (atreal y within s)
        ==> f'x * (y - x) <= f'y * (y - x)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, REAL_SEGMENT_SEGMENT] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE_LIFT_DROP] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [FORALL_DROP] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    REWRITE_TAC [← GSYM IN_IMAGE_LIFT_DROP, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP]
          (← q r"\x. lift(drop(f % x))")))] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVEX_ON_DERIVATIVES_IMP) THEN
    REWRITE_TAC [o_THM, DROP_CMUL, DROP_SUB, LIFT_DROP])

  let REAL_CONVEX_ON_DERIVATIVE_INCREASING_IMP ← prove
   r"!f f'x f'y s x y.
        f real_convex_on s /\ real_interval[x,y] SUBSET s /\
        (f has_real_derivative f'x) (atreal x within s) /\
        (f has_real_derivative f'y) (atreal y within s) /\
        x < y
        ==> f'x <= f'y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"f'x:real", ← q r"f'y:real",
                      ← q r"s:real->bool", ← q r"x:real", ← q r"y:real"]
                  REAL_CONVEX_ON_DERIVATIVES_IMP) THEN
    ASM_REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_RMUL_EQ, REAL_SUB_LT])

  let REAL_CONVEX_ON_DERIVATIVE_SECANT ← prove
   r"!f f' s.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s))
        ==> (f real_convex_on s <=>
             !x y. x IN s /\ y IN s ==> f'(x) * (y - x) <= f y - f x)"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, IS_REALINTERVAL_CONVEX] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP, o_DEF]
          (← q r"lift o (\x. drop(f % x))")))] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP CONVEX_ON_DERIVATIVE_SECANT) THEN
    REWRITE_TAC [DROP_CMUL, DROP_SUB, o_THM])

  let REAL_CONVEX_ON_SECANT_DERIVATIVE ← prove
   r"!f f' s.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s))
        ==> (f real_convex_on s <=>
             !x y. x IN s /\ y IN s ==> f y - f x <= f'(y) * (y - x))"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, IS_REALINTERVAL_CONVEX] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP, o_DEF]
          (← q r"lift o (\x. drop(f % x))")))] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP CONVEX_ON_SECANT_DERIVATIVE) THEN
    REWRITE_TAC [DROP_CMUL, DROP_SUB, o_THM])

  let REAL_CONVEX_ON_DERIVATIVES ← prove
   r"!f f' s.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s))
        ==> (f real_convex_on s <=>
             !x y. x IN s /\ y IN s ==> f'(x) * (y - x) <= f'(y) * (y - x))"
   (REWRITE_TAC [HAS_REAL_FRECHET_DERIVATIVE_WITHIN,
                 REAL_CONVEX_ON, IS_REALINTERVAL_CONVEX] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IN_IMAGE_LIFT_DROP, LIFT_DROP] THEN
    ONCE_REWRITE_TAC [← GSYM (← ExceptT.mk (REWRITE_CONV [LIFT_DROP, o_DEF]
          (← q r"lift o (\x. drop(f % x))")))] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP CONVEX_ON_DERIVATIVES) THEN
    REWRITE_TAC [DROP_CMUL, DROP_SUB, o_THM])

  let REAL_CONVEX_ON_DERIVATIVE_INCREASING ← prove
   r"!f f' s.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s))
        ==> (f real_convex_on s <=>
             !x y. x IN s /\ y IN s /\ x <= y ==> f'(x) <= f'(y))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP REAL_CONVEX_ON_DERIVATIVES) THEN
    EQ_TAC THEN DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN
    STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real", ← q r"y:real"]) THEN
      ASM_CASES_TAC (← q r"x:real = y") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_SUB_LT, REAL_LT_LE],
      DISJ_CASES_TAC (← REAL_ARITH (← q r"x <= y \/ y <= x")) THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real", ← q r"y:real"]),
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real", ← q r"x:real"])] THEN
      ASM_CASES_TAC (← q r"x:real = y") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_SUB_LT, REAL_LT_LE] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH
       (← q r"a * (y - x) <= b * (y - x) <=> b * (x - y) <= a * (x - y)")] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_SUB_LT, REAL_LT_LE]])

  let HAS_REAL_DERIVATIVE_INCREASING_IMP ← prove
   r"!f f' s a b.
        is_realinterval s /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s)) /\
        (!x. x IN s ==> &0 <= f'(x)) /\
        a IN s /\ b IN s /\ a <= b
        ==> f(a) <= f(b)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"real_interval[a,b] SUBSET s") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [is_realinterval]) THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"f':real->real", ← q r"a:real", ← q r"b:real"]
      REAL_MVT_VERY_SIMPLE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
      MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"s:real->bool") THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:real") MP_TAC) THEN STRIP_TAC THEN
      GEN_REWRITE_TAC id [← GSYM REAL_SUB_LE] THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_MUL THEN
      CONJ_TAC THENL [ASM SET_TAC [], ASM_REAL_ARITH_TAC]])

  let HAS_REAL_DERIVATIVE_INCREASING ← prove
   r"!f f' s. is_realinterval s /\ ~(?a. s = {a}) /\
           (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s))
           ==> ((!x. x IN s ==> &0 <= f'(x)) <=>
                (!x y. x IN s /\ y IN s /\ x <= y ==> f(x) <= f(y)))"
   (REWRITE_TAC [NOT_EXISTS_THM] THEN REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [HAS_REAL_DERIVATIVE_INCREASING_IMP], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"atreal x within s") REALLIM_LBOUND) THEN
    EXISTS_TAC (← q r"\y:real. (f y - f x) / (y - x)") THEN
    ASM_SIMP_TAC [← GSYM HAS_REAL_DERIVATIVE_WITHINREAL] THEN
    ASM_SIMP_TAC [TRIVIAL_LIMIT_WITHIN_REALINTERVAL] THEN
    REWRITE_TAC [EVENTUALLY_WITHINREAL] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    X_GEN_TAC (← q r"y:real") THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < abs(y - x) <=> ~(y = x)")] THEN STRIP_TAC THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
     (← q r"~(y:real = x) ==> x < y \/ y < x")))
    THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM REAL_NEG_SUB] THEN
      REWRITE_TAC [real_div, REAL_INV_NEG, REAL_MUL_LNEG, REAL_MUL_RNEG] THEN
      REWRITE_TAC [REAL_NEG_NEG, ← GSYM real_div]] THEN
    MATCH_MP_TAC REAL_LE_DIV THEN
    ASM_SIMP_TAC [REAL_SUB_LE, REAL_LT_IMP_LE])

  let HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP ← prove
   r"!f f' a b.
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))

                 (atreal x within real_interval[a,b])) /\
        (!x. x IN real_interval(a,b) ==> &0 < f'(x)) /\
        a < b
        ==> f(a) < f(b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"f':real->real", ← q r"a:real", ← q r"b:real"]
          REAL_MVT) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_SUB_LT, REAL_LT_MUL]] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON,
                     real_differentiable_on],
      ASM_MESON_TAC [HAS_REAL_DERIVATIVE_WITHIN_SUBSET, SUBSET,
                     REAL_INTERVAL_OPEN_SUBSET_CLOSED, REAL_OPEN_REAL_INTERVAL,
                     HAS_REAL_DERIVATIVE_WITHIN_REAL_OPEN]])

  let REAL_CONVEX_ON_SECOND_DERIVATIVE ← prove
   r"!f f' f'' s.
        is_realinterval s /\ ~(?a. s = {a}) /\
        (!x. x IN s ==> (f has_real_derivative f'(x)) (atreal x within s)) /\
        (!x. x IN s ==> (f' has_real_derivative f''(x)) (atreal x within s))
        ==> (f real_convex_on s <=> !x. x IN s ==> &0 <= f''(x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
     (← q r"!x y. x IN s /\ y IN s /\ x <= y ==> (f':real->real)(x) <= f'(y)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_CONVEX_ON_DERIVATIVE_INCREASING,
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC HAS_REAL_DERIVATIVE_INCREASING] THEN
    ASM_REWRITE_TAC [])

  let REAL_CONVEX_ON_ASYM ← prove
   r"!s f. f real_convex_on s <=>
         !x y u v.
                x IN s /\ y IN s /\ x < y /\ &0 <= u /\ &0 <= v /\ u + v = &1
                ==> f (u * x + v * y) <= u * f x + v * f y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_convex_on] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC REAL_WLOG_LT THEN
    SIMP_TAC [← GSYM REAL_ADD_RDISTRIB, REAL_MUL_LID, REAL_LE_REFL] THEN
    ASM_MESON_TAC [REAL_ADD_SYM])

  let REAL_CONVEX_ON_EXP ← prove
   r"!s. exp real_convex_on s"
   (GEN_TAC THEN MATCH_MP_TAC REAL_CONVEX_ON_SUBSET THEN
    EXISTS_TAC (← q r"(:real)") THEN REWRITE_TAC [SUBSET_UNIV] THEN
    MP_TAC (← ISPECL [← q r"exp", ← q r"exp", ← q r"exp", ← q r"(:real)"]
       REAL_CONVEX_ON_SECOND_DERIVATIVE) THEN
    SIMP_TAC [HAS_REAL_DERIVATIVE_EXP, REAL_EXP_POS_LE,
              HAS_REAL_DERIVATIVE_ATREAL_WITHIN, IS_REALINTERVAL_UNIV] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"&0 IN s /\ &1 IN s /\ ~(&1 = &0) ==> ~(?a. s = {a})")) THEN
    REWRITE_TAC [IN_UNIV] THEN REAL_ARITH_TAC)

  let REAL_CONVEX_ON_RPOW ← prove
   r"!s t. s SUBSET {x | &0 <= x} /\ &1 <= t
         ==> (\x. x rpow t) real_convex_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CONVEX_ON_SUBSET THEN
    EXISTS_TAC (← q r"{x | &0 <= x}") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(\x. x rpow t) real_convex_on {x | &0 < x}") MP_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"\x. x rpow t", ← q r"\x. t * x rpow (t - &1)",
        ← q r"\x. t * (t - &1) * x rpow (t - &2)", ← q r"{x | &0 < x}"]
          REAL_CONVEX_ON_SECOND_DERIVATIVE) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
       [REPEAT CONJ_TAC THENL
         [REWRITE_TAC [is_realinterval, IN_ELIM_THM] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC (← SET_RULE
           (← q r"&1 IN s /\ &2 IN s /\ ~(&1 = &2) ==> ~(?a. s = {a})")) THEN
          REWRITE_TAC [IN_ELIM_THM] THEN REAL_ARITH_TAC,
          REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN ASM_REAL_ARITH_TAC,
          REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
          ASM_REWRITE_TAC [← REAL_ARITH (← q r"t - &1 - &1 = t - &2")] THEN
          ASM_REAL_ARITH_TAC],
        DISCH_THEN SUBST1_TAC THEN REPEAT STRIP_TAC THEN
        REPEAT (MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC THENL
         [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
        MATCH_MP_TAC RPOW_POS_LE THEN ASM_SIMP_TAC [REAL_LT_IMP_LE]],
      REWRITE_TAC [REAL_CONVEX_ON_ASYM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_CASES_TAC (← q r"x = &0") THENL
       [DISCH_THEN (K ALL_TAC) THEN ASM_REWRITE_TAC [REAL_MUL_RZERO] THEN
        REPEAT STRIP_TAC THEN
        ASM_SIMP_TAC [RPOW_ZERO, ← REAL_ARITH (← q r"&1 <= t ==> ~(t = &0)")] THEN
        REWRITE_TAC [REAL_MUL_RZERO, REAL_ADD_LID] THEN
        ASM_CASES_TAC (← q r"v = &0") THEN
        ASM_SIMP_TAC [RPOW_ZERO, ← REAL_ARITH (← q r"&1 <= t ==> ~(t = &0)"),
                      REAL_MUL_LZERO, REAL_LE_REFL] THEN
        ASM_SIMP_TAC [RPOW_MUL, REAL_LT_LE] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN
        ASM_SIMP_TAC [RPOW_POS_LE, REAL_LT_IMP_LE] THEN
         MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"exp(&1 * log v)") THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [rpow, REAL_LT_LE, REAL_EXP_MONO_LE] THEN
          ONCE_REWRITE_TAC [← REAL_ARITH
           (← q r"a * l <= b * l <=> --l * b <= --l * a")] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN
          ASM_SIMP_TAC [← GSYM LOG_INV, REAL_LT_LE] THEN MATCH_MP_TAC LOG_POS THEN
          MATCH_MP_TAC REAL_INV_1_LE THEN ASM_REAL_ARITH_TAC,
          ASM_SIMP_TAC [REAL_MUL_LID, EXP_LOG, REAL_LT_LE, REAL_LE_REFL]],
        ASM_MESON_TAC [REAL_LT_LE, REAL_LET_TRANS]]])

  let REAL_CONVEX_ON_RPOW_NEG ← prove
   r"!s t. s SUBSET {x | &0 < x} /\ t <= &0
         ==> (\x. x rpow t) real_convex_on s"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] REAL_CONVEX_ON_SUBSET)) THEN
    MP_TAC (← ISPECL
     [← q r"\v. v rpow t",
      ← q r"\v. t * v rpow (t - &1)",
      ← q r"\v. t * (t - &1) * v rpow (t - &2)",
      ← q r"{x | &0 < x}"] REAL_CONVEX_ON_SECOND_DERIVATIVE) THEN
    REWRITE_TAC [IN_ELIM_THM, IS_REALINTERVAL_CLAUSES, NOT_EXISTS_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"r /\ p ==> (p ==> (q <=> r)) ==> q")) THEN
    REPEAT CONJ_TAC THEN X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THENL
     [ONCE_REWRITE_TAC [← REAL_ARITH (← q r"t * (t - &1) * x = x * --t * (&1 - t)")] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_SIMP_TAC [RPOW_POS_LE, REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s = {x} ==> !a b. ~(a = b) /\ a IN s /\ b IN s ==> F"))) THEN
      MAP_EVERY EXISTS_TAC [← q r"&1:real", ← q r"&2:real"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      REAL_DIFF_TAC THEN ASM_REAL_ARITH_TAC,
      REAL_DIFF_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"t - &1 - &1 = t - &2")] THEN
      ASM_REAL_ARITH_TAC])

  let REAL_CONVEX_ON_RPOW_INTEGER ← prove
   r"!s t. s SUBSET {x | &0 < x} /\ integer t
         ==> (\x. x rpow t) real_convex_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"&0:real", ← q r"t:real"] REAL_LT_INTEGERS) THEN
    ASM_REWRITE_TAC [INTEGER_CLOSED, ← GSYM REAL_NOT_LE, REAL_ADD_LID] THEN
    ASM_CASES_TAC (← q r"t:real <= &0") THEN
    ASM_SIMP_TAC [REAL_CONVEX_ON_RPOW_NEG] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_CONVEX_ON_RPOW THEN
    ASM_REWRITE_TAC [] THEN TRANS_TAC SUBSET_TRANS (← q r"{x:real | &0 < x}") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    REAL_ARITH_TAC)

  let REAL_CONVEX_ON_REAL_INV ← prove
   r"!s. s SUBSET {x | &0 < x} ==> inv real_convex_on s"
   (REPEAT STRIP_TAC THEN MP_TAC
     (← ISPECL [← q r"s:real->bool", ← q r"-- &1:real"] REAL_CONVEX_ON_RPOW_INTEGER) THEN
    ASM_REWRITE_TAC [INTEGER_NEG, INTEGER_CLOSED, RPOW_NEG, RPOW_POW] THEN
    REWRITE_TAC [REAL_POW_1, ETA_AX])

  let CONVEX_ON_REAL_POW ← prove
   r"!f:real^N->real s n.
        f convex_on s /\ convex s /\ (!x. x IN s ==> &0 <= f x)
        ==> (\x. (f x) pow n) convex_on s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_REWRITE_TAC [real_pow, CONVEX_ON_CONST] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [o_DEF] (← ONCE_REWRITE_RULE [IMP_CONJ]
          REAL_CONVEX_CONVEX_COMPOSE))) THEN
    EXISTS_TAC (← q r"{x:real | &0 <= x}") THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, REAL_POW_LE2, IN_ELIM_THM] THEN
    REWRITE_TAC [IS_REALINTERVAL_CLAUSES] THEN
    REWRITE_TAC [← GSYM RPOW_POW] THEN
    MATCH_MP_TAC REAL_CONVEX_ON_RPOW THEN
    REWRITE_TAC [REAL_OF_NUM_LE, SUBSET_REFL] THEN ASM_ARITH_TAC)

  let REAL_CONVEX_ON_REAL_POW ← prove
   r"!f s n.
        f real_convex_on s /\ is_realinterval s /\ (!x. x IN s ==> &0 <= f x)
        ==> (\x. (f x) pow n) real_convex_on s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_REWRITE_TAC [real_pow, REAL_CONVEX_ON_CONST] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [o_DEF] (← ONCE_REWRITE_RULE [IMP_CONJ]
          REAL_CONVEX_COMPOSE))) THEN
    EXISTS_TAC (← q r"{x:real | &0 <= x}") THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, REAL_POW_LE2, IN_ELIM_THM] THEN
    REWRITE_TAC [IS_REALINTERVAL_CLAUSES] THEN
    REWRITE_TAC [← GSYM RPOW_POW] THEN
    MATCH_MP_TAC REAL_CONVEX_ON_RPOW THEN
    REWRITE_TAC [REAL_OF_NUM_LE, SUBSET_REFL] THEN ASM_ARITH_TAC)

  let REAL_CONVEX_ON_LOG ← prove
   r"!s. s SUBSET {x | &0 < x} ==> (\x. --log x) real_convex_on s"
   (GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_CONVEX_ON_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"\x. --log x", ← q r"\x:real. --inv(x)",
                      ← q r"\x:real. inv(x pow 2)", ← q r"{x | &0 < x}"]
          REAL_CONVEX_ON_SECOND_DERIVATIVE) THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_LE_INV_EQ, REAL_LE_POW_2] THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [is_realinterval, IN_ELIM_THM] THEN REAL_ARITH_TAC,
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING] THEN
      MESON_TAC [← REAL_ARITH (← q r"&0 < a ==> &0 < a + &1 /\ ~(a + &1 = a)")],
      REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN ASM_REAL_ARITH_TAC,
      REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN ASM_REAL_ARITH_TAC])

  let REAL_CONTINUOUS_MIDPOINT_CONVEX ← prove
   r"!f s. f real_continuous_on s /\ is_realinterval s /\
         (!x y. x IN s /\ y IN s ==> f ((x + y) / &2) <= (f x + f y) / &2)
         ==> f real_convex_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_CONVEX_ON] THEN
    MATCH_MP_TAC CONTINUOUS_MIDPOINT_CONVEX THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, ← GSYM IS_REALINTERVAL_CONVEX] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [midpoint, LIFT_DROP, o_THM, DROP_CMUL, DROP_ADD] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"inv(&2) * x = x / &2")])

  pure { REAL_CONVEX_ON_DERIVATIVES_IMP, REAL_CONVEX_ON_DERIVATIVE_INCREASING_IMP,
         REAL_CONVEX_ON_DERIVATIVE_SECANT, REAL_CONVEX_ON_SECANT_DERIVATIVE,
         REAL_CONVEX_ON_DERIVATIVES, REAL_CONVEX_ON_DERIVATIVE_INCREASING,
         HAS_REAL_DERIVATIVE_INCREASING_IMP, HAS_REAL_DERIVATIVE_INCREASING,
         HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP, REAL_CONVEX_ON_SECOND_DERIVATIVE,
         REAL_CONVEX_ON_ASYM, REAL_CONVEX_ON_EXP, REAL_CONVEX_ON_RPOW,
         REAL_CONVEX_ON_RPOW_NEG, REAL_CONVEX_ON_RPOW_INTEGER, REAL_CONVEX_ON_REAL_INV,
         CONVEX_ON_REAL_POW, REAL_CONVEX_ON_REAL_POW, REAL_CONVEX_ON_LOG,
         REAL_CONTINUOUS_MIDPOINT_CONVEX }

/- ------------------------------------------------------------------------- -/
/- Some convexity-derived inequalities including AGM and Young's inequality. -/
/- (realanalysis.ml 7785-7938)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAG where
  AGM_GEN : thm
  AGM_RPOW : thm
  AGM_ROOT : thm
  AGM_SQRT : thm
  AGM : thm
  AGM_2 : thm
  YOUNG_INEQUALITY : thm
  HOELDER : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAG [HolBase] (D : RealAnalysisDeps) (BRZAE : RZAE) (BRZAF : RZAF) : ExceptT String IO RZAG := do
  -- @@SCOPE BEGIN
  let { REAL_CONVEX_ON_IMP_JENSEN, .. } := BRZAE
  let { REAL_CONVEX_ON_LOG, .. } := BRZAF
  let { LOG_MONO_LE_REV, LOG_PRODUCT, .. } := D.tsd
  let { REAL_POW_ROOT, ROOT_2, ROOT_LE_0, ROOT_PRODUCT, .. } := D.tsaa
  let { LOG_RPOW, REAL_ROOT_RPOW, RPOW_0, RPOW_DIV, RPOW_EQ_0, RPOW_POS_LE, RPOW_POS_LT,
        RPOW_POW, RPOW_PRODUCT, RPOW_RPOW, .. } := D.tsab
  let { is_realinterval, .. } := D.qmisc
  let { SUM_POS_LT_ALL, .. } := D.qsession
  let { PRODUCT_DIV, PRODUCT_EQ_0, PRODUCT_SUPERSET, .. } := D.qproducts
  let { PRODUCT_CLAUSES_NUMSEG, .. } := D.ts.cn.ms.qproducts
  let { ARITH_RULE, ASM_MESON_TAC, HAS_SIZE_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        .. } := D.ts.cn.cx.cvx
  let { PRODUCT_CLAUSES, REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { PRODUCT_POS_LE, PRODUCT_POS_LT, .. } := D.ts.cn.ms.ig.qproducts
  let { ARITH, ARITH_EQ, EQ_IMP, FINITE_NUMSEG, FINITE_RESTRICT, FINITE_RULES,
        .. } := D.ts.cn.cx.cvx.core1
  let { HAS_SIZE, IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, LE_1, NEUTRAL_REAL_ADD, NOT_EXISTS_THM, NOT_IMP,
        NOT_IN_EMPTY, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_LMUL,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_MUL, REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LE, REAL_LT_MUL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RINV,
        REAL_MUL_RNEG, REAL_OF_NUM_EQ, REAL_OF_NUM_LT, REAL_POS, REAL_POW_LE2, SUBSET_REFL,
        SUBSET_RESTRICT, .. } := D.ts.cn.cx.cvx.core5
  let { real_div, SUM_ADD, SUM_CLAUSES, SUM_CLAUSES_NUMSEG, SUM_CONST, SUM_EQ, SUM_NEG,
        SUM_POS_LE, SUM_RMUL, SUM_SUPERSET, SUM_SUPPORT, support,
        .. } := D.ts.cn.cx.cvx.core6
  -- @@SCOPE END

  let AGM_GEN ← (do
    let version1 ← prove
     r"!a x k:A->bool.
            FINITE k /\ sum k a = &1 /\ (!i. i IN k ==> &0 < a i /\ &0 < x i)
            ==> product k (\i. x i rpow a i) <= sum k (\i. a i * x i)"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
      ASM_REWRITE_TAC [SUM_CLAUSES, REAL_OF_NUM_EQ, ARITH_EQ] THEN STRIP_TAC THEN
      MATCH_MP_TAC LOG_MONO_LE_REV THEN
      ASM_SIMP_TAC [PRODUCT_POS_LT, RPOW_POS_LT, LOG_PRODUCT, LOG_RPOW,
                    SUM_POS_LT_ALL, REAL_LT_MUL] THEN
      MP_TAC (← ISPECL [← q r"\x. --log x", ← q r"{x | &0 < x}", ← q r"k:A->bool",
                        ← q r"a:A->real", ← q r"x:A->real"] REAL_CONVEX_ON_IMP_JENSEN) THEN
      ASM_SIMP_TAC [IN_ELIM_THM, REAL_CONVEX_ON_LOG, SUBSET_REFL, REAL_LT_IMP_LE,
                    is_realinterval] THEN
      REWRITE_TAC [REAL_MUL_RNEG, SUM_NEG, REAL_LE_NEG2] THEN
      DISCH_THEN MATCH_MP_TAC THEN REAL_ARITH_TAC)
    let version2 ← prove
     r"!a x k:A->bool.
            FINITE k /\ sum k a = &1 /\ (!i. i IN k ==> &0 < a i /\ &0 <= x i)
            ==> product k (\i. x i rpow a i) <= sum k (\i. a i * x i)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"?i:A. i IN k /\ x i = &0") THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y /\ x = &0 ==> x <= y")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC SUM_POS_LE THEN ASM_SIMP_TAC [REAL_LE_MUL, REAL_LT_IMP_LE],
          ASM_SIMP_TAC [PRODUCT_EQ_0, RPOW_EQ_0] THEN
          ASM_MESON_TAC [REAL_LT_IMP_NZ]],
        MATCH_MP_TAC version1 THEN ASM_MESON_TAC [REAL_LT_LE]])
    prove
     r"!a x k:A->bool.
          FINITE k /\ sum k a = &1 /\ (!i. i IN k ==> &0 <= a i /\ &0 <= x i)
          ==> product k (\i. x i rpow a i) <= sum k (\i. a i * x i)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"product {i:A | i IN k /\ ~(a i = &0)} (\i. x i rpow a i)
        <= sum {i:A | i IN k /\ ~(a i = &0)} (\i. a i * x i)")
      MP_TAC THENL
       [MATCH_MP_TAC version2 THEN
        ASM_SIMP_TAC [FINITE_RESTRICT, REAL_LT_LE, IN_ELIM_THM] THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM SUM_SUPPORT] THEN
        REWRITE_TAC [support, NEUTRAL_REAL_ADD],
        MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN BINOP_TAC THENL
         [MATCH_MP_TAC PRODUCT_SUPERSET,
          MATCH_MP_TAC SUM_SUPERSET] THEN
        SIMP_TAC [IN_ELIM_THM, SUBSET_RESTRICT, IMP_CONJ, RPOW_0] THEN
        REWRITE_TAC [REAL_MUL_LZERO]]))

  let AGM_RPOW ← prove
   r"!k:A->bool x n.
        k HAS_SIZE n /\ ~(n = 0) /\ (!i. i IN k ==> &0 <= x(i))
        ==> product k (\i. x(i) rpow (&1 / &n)) <= sum k (\i. x(i) / &n)"
   (REWRITE_TAC [HAS_SIZE] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\i:A. &1 / &n", ← q r"x:A->real", ← q r"k:A->bool"]
          AGM_GEN) THEN
    ASM_SIMP_TAC [SUM_CONST, REAL_LE_DIV, REAL_OF_NUM_LT, LE_1, ARITH,
                  REAL_DIV_LMUL, REAL_OF_NUM_EQ, REAL_POS] THEN
    REWRITE_TAC [real_div, REAL_MUL_LID, REAL_MUL_AC])

  let AGM_ROOT ← prove
   r"!k:A->bool x n.
        k HAS_SIZE n /\ ~(n = 0) /\ (!i. i IN k ==> &0 <= x(i))
        ==> root n (product k x) <= sum k x / &n"
   (REWRITE_TAC [HAS_SIZE] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [ROOT_PRODUCT, real_div, ← GSYM SUM_RMUL] THEN
    ASM_SIMP_TAC [REAL_ROOT_RPOW, ← GSYM real_div] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"inv(x) = &1 / x")] THEN
    MATCH_MP_TAC AGM_RPOW THEN ASM_REWRITE_TAC [HAS_SIZE])

  let AGM_SQRT ← prove
   r"!x y. &0 <= x /\ &0 <= y ==> sqrt(x * y) <= (x + y) / &2"
   (REPEAT STRIP_TAC THEN MP_TAC
     (← ISPECL [← q r"{0,1}", ← q r"\n. if n = 0 then (x:real) else y", ← q r"2"] AGM_ROOT) THEN
    SIMP_TAC [SUM_CLAUSES, PRODUCT_CLAUSES, FINITE_RULES] THEN
    REWRITE_TAC [ARITH_EQ, IN_INSERT, NOT_IN_EMPTY,
                 ← ExceptT.mk (HAS_SIZE_CONV (← q r"s HAS_SIZE 2 "))] THEN
    ASM_SIMP_TAC [ROOT_2, REAL_MUL_RID, REAL_ADD_RID,
                  ← REAL_ARITH (← q r"x / &2 + y / &2 = (x + y) / &2")] THEN
    ASM_MESON_TAC [← ARITH_RULE (← q r"~(1 = 0)")])

  let AGM ← prove
   r"!k:A->bool x n.
        k HAS_SIZE n /\ ~(n = 0) /\ (!i. i IN k ==> &0 <= x(i))
        ==> product k x <= (sum k x / &n) pow n"
   (REWRITE_TAC [HAS_SIZE] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"root n (product (k:A->bool) x) pow n") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [REAL_POW_ROOT, PRODUCT_POS_LE, REAL_LE_REFL],
      MATCH_MP_TAC REAL_POW_LE2 THEN
      ASM_SIMP_TAC [AGM_ROOT, HAS_SIZE, ROOT_LE_0, PRODUCT_POS_LE]])

  let AGM_2 ← prove
   r"!x y u v.
        &0 <= x /\ &0 <= y /\ &0 <= u /\ &0 <= v /\ u + v = &1
        ==> x rpow u * y rpow v <= u * x + v * y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\i. if i = 0 then u:real else v",
                      ← q r"\i. if i = 0 then x:real else y", ← q r"0..SUC 0"]
          AGM_GEN) THEN
    REWRITE_TAC [SUM_CLAUSES_NUMSEG, PRODUCT_CLAUSES_NUMSEG, ARITH] THEN
    REWRITE_TAC [FINITE_NUMSEG] THEN ASM_MESON_TAC [])

  let YOUNG_INEQUALITY ← prove
   r"!a b p q. &0 <= a /\ &0 <= b /\ &0 < p /\ &0 < q /\ inv(p) + inv(q) = &1
             ==> a * b <= a rpow p / p + b rpow q / q"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a rpow p", ← q r"b rpow q", ← q r"inv p:real", ← q r"inv q:real"]
          AGM_2) THEN
    ASM_SIMP_TAC [RPOW_RPOW, RPOW_POS_LE, REAL_LE_INV_EQ, REAL_LT_IMP_LE,
                  REAL_MUL_RINV, RPOW_POW, REAL_POW_1, REAL_LT_IMP_NZ] THEN
    REAL_ARITH_TAC)

  let HOELDER ← prove
   r"!k:A->bool a x y.
        FINITE k /\ sum k a = &1 /\
        (!i. i IN k ==> &0 <= a i /\ &0 <= x i /\ &0 <= y i)
        ==> product k (\i. x i rpow a i) + product k (\i. y i rpow a i)
            <= product k (\i. (x i + y i) rpow a i)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 <= product (k:A->bool) (\i. (x i + y i) rpow a i)")
    MP_TAC THENL
     [MATCH_MP_TAC PRODUCT_POS_LE THEN ASM_SIMP_TAC [REAL_LE_ADD, RPOW_POS_LE],
      ALL_TAC] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 <= x <=> x = &0 \/ &0 < x")] THEN
    ASM_SIMP_TAC [PRODUCT_EQ_0, RPOW_EQ_0, ← TAUT (← q r"p /\ q <=> ~(p ==> ~q)"),
     ← REAL_ARITH (← q r"&0 <= x /\ &0 <= y ==> (x + y = &0 <=> x = &0 /\ y = &0)")] THEN
    REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH
       (← q r"x = &0 /\ y = &0 /\ z = &0 ==> x + y <= z")) THEN
      ASM_SIMP_TAC [PRODUCT_EQ_0, RPOW_EQ_0] THEN ASM_MESON_TAC [REAL_ADD_LID],
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID]] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← GSYM PRODUCT_DIV, ← GSYM RPOW_DIV,
                  ← REAL_ARITH (← q r"(x + y) / z:real = x / z + y / z")] THEN
    ASM_SIMP_TAC [← GSYM RPOW_PRODUCT] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum k (\i:A. a i * (x i / (x i + y i))) +
      sum k (\i. a i * (y i / (x i + y i)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN MATCH_MP_TAC AGM_GEN THEN
      ASM_SIMP_TAC [REAL_LE_ADD, REAL_LE_DIV],
      ASM_SIMP_TAC [← GSYM SUM_ADD]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"s = &1 ==> p = s ==> p <= &1"))) THEN
    MATCH_MP_TAC SUM_EQ THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"i:A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(a:A->real) i = &0") THEN
    ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_ADD_LID] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP REAL_LT_IMP_NZ) THEN
    ASM_SIMP_TAC [PRODUCT_EQ_0, RPOW_EQ_0, NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"i:A")) THEN ASM_REWRITE_TAC [] THEN
    CONV_TAC REAL_FIELD)

  pure { AGM_GEN, AGM_RPOW, AGM_ROOT, AGM_SQRT, AGM, AGM_2, YOUNG_INEQUALITY, HOELDER }
/- ------------------------------------------------------------------------- -/
/- Some other inequalities where it's handy just to use calculus.           -/
/- (realanalysis.ml 7939-8075)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAH where
  RPOW_MINUS1_QUOTIENT_LT : thm
  RPOW_MINUS1_QUOTIENT_LE : thm
  REAL_EXP_LIMIT_RPOW_LT : thm
  REAL_EXP_LIMIT_RPOW_LE : thm
  REAL_LE_X_SINH : thm
  REAL_LE_ABS_SINH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAH [HolBase] (D : RealAnalysisDeps) (BRZQ : RZQ) (BRZAF : RZAF) : ExceptT String IO RZAH := do
  -- @@SCOPE BEGIN
  let { REAL_DIFF_TAC, .. } := BRZQ
  let { HAS_REAL_DERIVATIVE_INCREASING, HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP,
        .. } := BRZAF
  let { REAL_EXP_0, REAL_EXP_INJ, REAL_EXP_MONO_LE, REAL_EXP_NEG, REAL_EXP_NZ,
        REAL_EXP_POS_LE, .. } := D.tsb
  let { LOG_1, LOG_INJ, LOG_POS, .. } := D.tsd
  let { rpow, RPOW_0, RPOW_LT2, RPOW_ONE, RPOW_POS_LE, RPOW_POS_LT, RPOW_POW, RPOW_RPOW,
        RPOW_ZERO, .. } := D.tsab
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_UNIV, .. } := D.qmisc
  let { ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { IN_ELIM_THM, IN_UNIV, MONO_FORALL, REAL_DIV_EQ_0, REAL_DIV_REFL,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_INV_EQ_0, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_MUL,
        REAL_LE_POW_2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV2_EQ,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LCANCEL_IMP, REAL_LT_LDIV_EQ, REAL_LT_MUL,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_POW_LT, REAL_SUB_LE,
        REAL_SUB_LT, REAL_SUB_REFL, REAL_SUB_RZERO, .. } := D.ts.cn.cx.cvx.core5
  let { real_div, real_pow, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_INV_INV, .. } := D.ts.cn.ms.ig.dv.qsession
  let { REAL_LT_POW_2, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let RPOW_MINUS1_QUOTIENT_LT ← prove
   r"!a x y. &0 < a /\ ~(a = &1) /\ &0 < x /\ x < y
           ==> (a rpow x - &1) / x < (a rpow y - &1) / y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x. (a rpow x - &1) / x",
                      ← q r"\x. log a * a rpow x / x - (a rpow x - &1) / x pow 2",
                      ← q r"x:real", ← q r"y:real"]
     HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP) THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN DISCH_THEN MATCH_MP_TAC THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [rpow] THEN REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"z:real") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"&0 < z") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN
    EXISTS_TAC (← q r"(z:real) pow 2") THEN
    ASM_SIMP_TAC [REAL_POW_LT, REAL_MUL_RZERO, ← REAL_FIELD
     (← q r"&0 < x ==> x pow 2 * (a * b / x - c / x pow 2) = a * b * x - c")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"l * a * z - (a - &1) = a * (l * z - &1) + &1")] THEN
    MP_TAC (← ISPECL [← q r"\x. a rpow x * (log a * x - &1) + &1",
                      ← q r"\x. log(a) pow 2 * x * a rpow x",
                      ← q r"&0", ← q r"z:real"]
     HAS_REAL_DERIVATIVE_STRICTLY_INCREASING_IMP) THEN
    ASM_REWRITE_TAC [RPOW_0] THEN
    ANTS_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC REAL_FIELD,
      REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
      REPEAT (MATCH_MP_TAC REAL_LT_MUL THEN CONJ_TAC) THEN
      ASM_SIMP_TAC [RPOW_POS_LT, REAL_LT_POW_2] THEN
      ASM_SIMP_TAC [← GSYM LOG_1, LOG_INJ, REAL_LT_01]])

  let RPOW_MINUS1_QUOTIENT_LE ← prove
   r"!a x y. &0 < a /\ &0 < x /\ x <= y
           ==> (a rpow x - &1) / x <= (a rpow y - &1) / y"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"x:real = y") THEN
    ASM_REWRITE_TAC [REAL_LE_REFL] THEN
    ASM_CASES_TAC (← q r"a = &1") THEN
    ASM_REWRITE_TAC [real_div, RPOW_ONE, REAL_SUB_REFL, REAL_MUL_LZERO,
                     REAL_LE_REFL] THEN
    ASM_SIMP_TAC [REAL_LE_LT, ← GSYM real_div, RPOW_MINUS1_QUOTIENT_LT])

  let REAL_EXP_LIMIT_RPOW_LT ← prove
   r"!x r s. &0 < r /\ r < s /\ ~(x = &0) /\ x < r
           ==> (&1 - x / r) rpow r < (&1 - x / s) rpow s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 < s") STRIP_ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < &1 - x / s") ASSUME_TAC THENL
     [ASM_SIMP_TAC [REAL_SUB_LT, REAL_LT_LDIV_EQ] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"(&1 - x / s) rpow (inv r)", ← q r"r:real", ← q r"s:real"]
          RPOW_MINUS1_QUOTIENT_LT) THEN
    ASM_SIMP_TAC [RPOW_RPOW, REAL_MUL_LINV, REAL_LT_IMP_NZ, REAL_LT_IMP_LE,
                  RPOW_POW, REAL_POW_1, RPOW_POS_LT] THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [rpow, ← GSYM REAL_EXP_0, REAL_EXP_INJ] THEN
      ASM_SIMP_TAC [REAL_ENTIRE, REAL_INV_EQ_0, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [REAL_EXP_0] THEN
      ASM_SIMP_TAC [← GSYM LOG_1, LOG_INJ, REAL_LT_01] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - x = a <=> x = &0"), REAL_DIV_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← REAL_ARITH (← q r"(&1 - x / s - &1) / r = --(x / r) / s")] THEN
      ASM_SIMP_TAC [REAL_LT_DIV2_EQ, ← REAL_ARITH
        (← q r"--x < a - &1 <=> &1 - x < a")] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"r:real") o MATCH_MP (← MESON [RPOW_LT2]
       (← q r"x < y ==> !z. &0 <= x /\ &0 < z ==> x rpow z < y rpow z"))) THEN
      ASM_SIMP_TAC [RPOW_RPOW, REAL_LT_IMP_LE, ← REAL_FIELD
       (← q r"&0 < r ==> (inv r * s) * r = s")] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [REAL_SUB_LE, REAL_LE_LDIV_EQ] THEN ASM_REAL_ARITH_TAC])

  let REAL_EXP_LIMIT_RPOW_LE ← prove
   r"!x r s. &0 <= r /\ r <= s /\ x <= r
           ==> (&1 - x / r) rpow r <= (&1 - x / s) rpow s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"x = &0") THENL
     [ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO, REAL_SUB_RZERO, RPOW_ONE],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r:real = s") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
    ASM_CASES_TAC (← q r"r:real = x") THENL
     [ASM_SIMP_TAC [REAL_DIV_REFL, REAL_SUB_REFL, RPOW_ZERO] THEN
      STRIP_TAC THEN MATCH_MP_TAC RPOW_POS_LE THEN
      REWRITE_TAC [REAL_SUB_LE] THEN
      SUBGOAL_THEN (← q r"&0 < s") (fun th => SIMP_TAC [th, REAL_LE_LDIV_EQ]) THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_SIMP_TAC [REAL_LE_LT, REAL_EXP_LIMIT_RPOW_LT] THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_LT, RPOW_POW, real_pow] THEN
    ASM_SIMP_TAC [rpow, REAL_SUB_LT, REAL_LT_LDIV_EQ] THEN COND_CASES_TAC THENL
     [ALL_TAC, MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN ASM_REAL_ARITH_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_EXP_0] THEN
    REWRITE_TAC [REAL_EXP_MONO_LE] THEN MATCH_MP_TAC REAL_LE_MUL THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC LOG_POS THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&1 <= &1 - x / y <=> &0 <= --x / y")] THEN
    MATCH_MP_TAC REAL_LE_DIV THEN ASM_REAL_ARITH_TAC)

  let REAL_LE_X_SINH ← prove
   r"!x. &0 <= x ==> x <= (exp x - inv(exp x)) / &2"
   (SUBGOAL_THEN
     (← q r"!a b. a <= b
            ==> exp a - inv(exp a) - &2 * a <= exp b - inv(exp b) - &2 * b")
     (MP_TAC o SPEC (← q r"&0"))
    THENL
     [MP_TAC (← ISPECL
       [← q r"\x. exp x - exp(--x) - &2 * x", ← q r"\x. exp x + exp(--x) - &2",
        ← q r"(:real)"]
       HAS_REAL_DERIVATIVE_INCREASING) THEN
      REWRITE_TAC [IN_ELIM_THM, IS_REALINTERVAL_UNIV, IN_UNIV] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [SET_TAC [← REAL_ARITH (← q r"~(&1 = &0)")], ALL_TAC] THEN
        GEN_TAC THEN REAL_DIFF_TAC THEN REAL_ARITH_TAC,
        SIMP_TAC [REAL_EXP_NEG] THEN
        DISCH_THEN (fun th => tactic_of do pure (SIMP_TAC [← GSYM th])) THEN
        X_GEN_TAC (← q r"x:real") THEN
        SIMP_TAC [REAL_EXP_NZ, ← REAL_FIELD
         (← q r"~(e = &0) ==> e + inv e - &2 = (e - &1) pow 2 / e")] THEN
        SIMP_TAC [REAL_EXP_POS_LE, REAL_LE_DIV, REAL_LE_POW_2]],
      MATCH_MP_TAC MONO_FORALL THEN REWRITE_TAC [REAL_EXP_0] THEN
      REAL_ARITH_TAC])

  let REAL_LE_ABS_SINH ← prove
   r"!x. abs x <= abs((exp x - inv(exp x)) / &2)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= x") THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= y ==> abs x <= abs y")) THEN
      ASM_SIMP_TAC [REAL_LE_X_SINH],
      MATCH_MP_TAC (← REAL_ARITH
        (← q r"~(&0 <= x) /\ --x <= --y ==> abs x <= abs y")) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"--((a - b) / &2) = (b - a) / &2")] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"(exp(--x) - inv(exp(--x))) / &2") THEN
      ASM_SIMP_TAC [REAL_LE_X_SINH, ← REAL_ARITH (← q r"~(&0 <= x) ==> &0 <= --x")] THEN
      REWRITE_TAC [REAL_EXP_NEG, REAL_INV_INV] THEN REAL_ARITH_TAC])

  pure { RPOW_MINUS1_QUOTIENT_LT, RPOW_MINUS1_QUOTIENT_LE, REAL_EXP_LIMIT_RPOW_LT,
         REAL_EXP_LIMIT_RPOW_LE, REAL_LE_X_SINH, REAL_LE_ABS_SINH }
/- ------------------------------------------------------------------------- -/
/- Log-convex functions.                                                     -/
/- (realanalysis.ml 8076-8220)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAI where
  log_convex_on : thm
  LOG_CONVEX_ON_EMPTY : thm
  LOG_CONVEX_ON_SUBSET : thm
  LOG_CONVEX_ON_EQ : thm
  LOG_CONVEX_IMP_POS : thm
  LOG_CONVEX_ON_CONVEX : thm
  LOG_CONVEX_ON : thm
  LOG_CONVEX_IMP_CONVEX : thm
  LOG_CONVEX_ADD : thm
  LOG_CONVEX_MUL : thm
  MIDPOINT_LOG_CONVEX : thm
  LOG_CONVEX_CONST : thm
  LOG_CONVEX_ON_SING : thm
  LOG_CONVEX_PRODUCT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAI [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZP : RZP) (BRZAG : RZAG) : ExceptT String IO RZAI := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { REAL_CONTINUOUS_ON_LOG, .. } := BRZP
  let { AGM_2, HOELDER, .. } := BRZAG
  let { REAL_EXP_ADD, REAL_EXP_MONO_LE, REAL_EXP_N, .. } := D.tsb
  let { EXP_LOG, .. } := D.tsd
  let { rpow, RPOW_ADD, RPOW_ADD_ALT, RPOW_MUL, RPOW_POW, .. } := D.tsab
  let { IMP_REWRITE_TAC, .. } := D.ts.cn.ms.ig
  let { MIDPOINT_IN_CONVEX, .. } := D.ts.cn.ms.qconvex
  let { PRODUCT_CLAUSES_NUMSEG, .. } := D.ts.cn.ms.qproducts
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { convex, PRODUCT_CLAUSES, REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { CONTINUOUS_MIDPOINT_CONVEX, .. } := D.ts.cn.ms.ig.qconvex
  let { ARITH, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_SING, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_POS, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUM_CLAUSES_NUMSEG, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_MUL_LID, VECTOR_MUL_LZERO, .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, .. } := D.ts.cn.cx.cvx.top3
  let { convex_on, .. } := D.ts.cn.ms.ig.dv.qconvex
  let { CONVEX_SING, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  parse_as_infix ("log_convex_on", (12, "right"))

  let log_convex_on ← new_definition
   r"f log_convex_on (s:real^N->bool) <=>
        (!x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                   ==> &0 <= f(u % x + v % y) /\
                       f(u % x + v % y) <= f(x) rpow u * f(y) rpow v)"

  let LOG_CONVEX_ON_EMPTY ← prove
   r"!f:real^N->real. f log_convex_on {}"
   (REWRITE_TAC [log_convex_on, NOT_IN_EMPTY])

  let LOG_CONVEX_ON_SUBSET ← prove
   r"!f s t. f log_convex_on t /\ s SUBSET t ==> f log_convex_on s"
   (REWRITE_TAC [log_convex_on] THEN SET_TAC [])

  let LOG_CONVEX_ON_EQ ← prove
   r"!f g s:real^N->bool.
         convex s /\ (!x. x IN s ==> f x = g x) /\ f log_convex_on s
         ==> g log_convex_on s"
   (REWRITE_TAC [IMP_CONJ] THEN SIMP_TAC [convex, log_convex_on])

  let LOG_CONVEX_IMP_POS ← prove
   r"!f s x:real^N.
        f log_convex_on s /\ x IN s ==> &0 <= f x"
   (REWRITE_TAC [log_convex_on] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"x:real^N", ← q r"&0", ← q r"&1"]) THEN
    REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID, VECTOR_ADD_LID] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_MESON_TAC [])

  let LOG_CONVEX_ON_CONVEX ← prove
   r"!f s:real^N->bool.
        convex s
        ==> (f log_convex_on s <=>
             (!x. x IN s ==> &0 <= f x) /\
             !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                       ==> f(u % x + v % y) <= f(x) rpow u * f(y) rpow v)"
   (REWRITE_TAC [convex] THEN REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [ASM_MESON_TAC [LOG_CONVEX_IMP_POS],
      ASM_MESON_TAC [log_convex_on],
      ASM_SIMP_TAC [log_convex_on] THEN ASM_MESON_TAC []])

  let LOG_CONVEX_ON ← prove
   r"!f s:real^N->bool.
        convex s /\ (!x. x IN s ==> &0 < f x)
        ==> (f log_convex_on s <=> (log o f) convex_on s)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [LOG_CONVEX_ON_CONVEX, REAL_LT_IMP_LE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [convex]) THEN REWRITE_TAC [convex_on, o_DEF] THEN
    GEN_REWRITE_TAC (RAND_CONV o funpow 4 BINDER_CONV o RAND_CONV)
      [← GSYM REAL_EXP_MONO_LE] THEN
    ASM_SIMP_TAC [EXP_LOG, rpow, REAL_EXP_ADD])

  let LOG_CONVEX_IMP_CONVEX ← prove
   r"!f s:real^N->bool. f log_convex_on s ==> f convex_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      LOG_CONVEX_IMP_POS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [log_convex_on]) THEN REWRITE_TAC [convex_on] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"]) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC AGM_2 THEN ASM_SIMP_TAC [])

  let LOG_CONVEX_ADD ← prove
   r"!f g s:real^N->bool.
        f log_convex_on s /\ g log_convex_on s
        ==> (\x. f x + g x) log_convex_on s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (CONJUNCTS_THEN (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      LOG_CONVEX_IMP_POS))) THEN
    REWRITE_TAC [log_convex_on] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (ASSUME_TAC o REWRITE_RULE [log_convex_on])) THEN
    REWRITE_TAC [log_convex_on] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N", ← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [REAL_LE_ADD] THEN
    MP_TAC (← ISPEC (← q r"0..SUC 0") HOELDER) THEN
    SIMP_TAC [PRODUCT_CLAUSES_NUMSEG,
              FINITE_NUMSEG, SUM_CLAUSES_NUMSEG, ARITH] THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"\i. if i = 0 then u:real else v",
      ← q r"\i. if i = 0 then (f:real^N->real) x else f y",
      ← q r"\i. if i = 0 then (g:real^N->real) x else g y"]) THEN
    REWRITE_TAC [ARITH] THEN ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_MESON_TAC [])

  let LOG_CONVEX_MUL ← prove
   r"!f g s:real^N->bool.
        f log_convex_on s /\ g log_convex_on s
        ==> (\x. f x * g x) log_convex_on s"
   (REWRITE_TAC [log_convex_on] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_LE_MUL, RPOW_MUL] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH
     (← q r"(a * b) * (c * d):real = (a * c) * (b * d)")] THEN
    ASM_SIMP_TAC [REAL_LE_MUL2])

  let MIDPOINT_LOG_CONVEX ← prove
   r"!f s:real^N->bool.
        (lift o f) continuous_on s /\ convex s /\
        (!x. x IN s ==> &0 < f x) /\
        (!x y. x IN s /\ y IN s ==> f(midpoint(x,y)) pow 2 <= f(x) * f(y))
        ==> f log_convex_on s"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [LOG_CONVEX_ON] THEN
    MATCH_MP_TAC CONTINUOUS_MIDPOINT_CONVEX THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"lift o log o (f:real^N->real) =
                    (lift o log o drop) o (lift o f)")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF, LIFT_DROP], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, IMAGE_o] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_ON_LOG THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE],
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      REWRITE_TAC [o_DEF, ← REAL_ARITH (← q r"x <= y / &2 <=> &2 * x <= y")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_EXP_MONO_LE] THEN
      ASM_SIMP_TAC [REAL_EXP_N, EXP_LOG, REAL_EXP_ADD, MIDPOINT_IN_CONVEX]])

  let LOG_CONVEX_CONST ← prove
   r"!s a. &0 <= a ==> (\x. a) log_convex_on s"
   (SIMP_TAC [log_convex_on, ← GSYM RPOW_ADD] THEN
    IMP_REWRITE_TAC [← GSYM RPOW_ADD_ALT] THEN
    REWRITE_TAC [RPOW_POW, REAL_POW_1, REAL_LE_REFL] THEN REAL_ARITH_TAC)

  let LOG_CONVEX_ON_SING ← prove
   r"!f a:real^N. f log_convex_on {a} <=> &0 <= f a"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [LOG_CONVEX_IMP_POS, IN_SING], DISCH_TAC] THEN
    MATCH_MP_TAC LOG_CONVEX_ON_EQ THEN
    EXISTS_TAC (← q r"\x:real^N. (f:real^N->real) a") THEN
    ASM_SIMP_TAC [IN_SING, CONVEX_SING, LOG_CONVEX_CONST])

  let LOG_CONVEX_PRODUCT ← prove
   r"!f s k. FINITE k /\ (!i. i IN k ==> (\x. f x i) log_convex_on s)
           ==> (\x. product k (f x)) log_convex_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, LOG_CONVEX_CONST, REAL_POS] THEN
    SIMP_TAC [FORALL_IN_INSERT, LOG_CONVEX_MUL])

  pure { log_convex_on, LOG_CONVEX_ON_EMPTY, LOG_CONVEX_ON_SUBSET, LOG_CONVEX_ON_EQ,
         LOG_CONVEX_IMP_POS, LOG_CONVEX_ON_CONVEX, LOG_CONVEX_ON, LOG_CONVEX_IMP_CONVEX,
         LOG_CONVEX_ADD, LOG_CONVEX_MUL, MIDPOINT_LOG_CONVEX, LOG_CONVEX_CONST,
         LOG_CONVEX_ON_SING, LOG_CONVEX_PRODUCT }
/- ------------------------------------------------------------------------- -/
/- Real log-convex functions.                                                -/
/- (realanalysis.ml 8221-8408)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAJ where
  real_log_convex_on : thm
  REAL_LOG_CONVEX_ON_EMPTY : thm
  REAL_LOG_CONVEX_ON_SUBSET : thm
  REAL_LOG_CONVEX_LOG_CONVEX : thm
  REAL_LOG_CONVEX_ON_EQ : thm
  REAL_LOG_CONVEX_ON_SING : thm
  REAL_LOG_CONVEX_IMP_POS : thm
  REAL_LOG_CONVEX_ON_CONVEX : thm
  REAL_LOG_CONVEX_ON : thm
  REAL_LOG_CONVEX_IMP_CONVEX : thm
  REAL_LOG_CONVEX_ADD : thm
  REAL_LOG_CONVEX_MUL : thm
  MIDPOINT_REAL_LOG_CONVEX : thm
  REAL_LOG_CONVEX_CONST : thm
  REAL_LOG_CONVEX_PRODUCT : thm
  REAL_LOG_CONVEX_RPOW_RIGHT : thm
  REAL_LOG_CONVEX_LIM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAJ [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZJ : RZJ) (BRZM : RZM) (BRZP : RZP) (BRZR : RZR) (BRZAE : RZAE) (BRZAF : RZAF) (BRZAG : RZAG) (BRZAI : RZAI) : ExceptT String IO RZAJ := do
  -- @@SCOPE BEGIN
  let { REALLIM_MUL, REALLIM_SUB, .. } := BRZA
  let { REALLIM_LBOUND, .. } := BRZB
  let { REAL_CONTINUOUS_ON_COMPOSE, REALLIM_REAL_CONTINUOUS_FUNCTION, .. } := BRZJ
  let { IS_REALINTERVAL_CONVEX, REAL_CONVEX, REAL_MIDPOINT_IN_CONVEX, .. } := BRZM
  let { REAL_CONTINUOUS_ON_LOG, .. } := BRZP
  let { REAL_CONTINUOUS_AT_RPOW, .. } := BRZR
  let { real_convex_on, .. } := BRZAE
  let { REAL_CONTINUOUS_MIDPOINT_CONVEX, .. } := BRZAF
  let { AGM_2, HOELDER, .. } := BRZAG
  let { LOG_CONVEX_IMP_POS, log_convex_on, LOG_CONVEX_ON_EQ, LOG_CONVEX_ON_SING,
        .. } := BRZAI
  let { REAL_EXP_ADD, REAL_EXP_MONO_LE, REAL_EXP_N, .. } := D.tsb
  let { EXP_LOG, .. } := D.tsd
  let { rpow, RPOW_ADD, RPOW_ADD_ALT, RPOW_MUL, RPOW_POS_LE, RPOW_POW, RPOW_RPOW,
        .. } := D.tsab
  let { IMP_REWRITE_TAC, .. } := D.ts.cn.ms.ig
  let { PRODUCT_CLAUSES_NUMSEG, .. } := D.ts.cn.ms.qproducts
  let { ASM_MESON_TAC, new_definition, parse_as_infix, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { PRODUCT_CLAUSES, REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { ARITH, CONJ_ASSOC, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT,
        .. } := D.ts.cn.cx.cvx.core2
  let { NOT_IN_EMPTY, REAL_ADD_RID, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_POS, REAL_SUB_LE,
        RIGHT_FORALL_IMP_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES_NUMSEG, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { EVENTUALLY_MONO, .. } := D.ts.cn.cx.cvx.met
  -- @@SCOPE END

  parse_as_infix ("real_log_convex_on", (12, "right"))

  let real_log_convex_on ← new_definition
   r"(f:real->real) real_log_convex_on s <=>
        (!x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                   ==> &0 <= f(u * x + v * y) /\
                       f(u * x + v * y) <= f(x) rpow u * f(y) rpow v)"

  let REAL_LOG_CONVEX_ON_EMPTY ← prove
   r"!f. f real_log_convex_on {}"
   (REWRITE_TAC [real_log_convex_on, NOT_IN_EMPTY])

  let REAL_LOG_CONVEX_ON_SUBSET ← prove
   r"!f s t. f real_log_convex_on t /\ s SUBSET t ==> f real_log_convex_on s"
   (REWRITE_TAC [real_log_convex_on] THEN SET_TAC [])

  let REAL_LOG_CONVEX_LOG_CONVEX ← prove
   r"!f s. f real_log_convex_on s <=> (f o drop) log_convex_on (IMAGE lift s)"
   (REWRITE_TAC [real_log_convex_on, log_convex_on] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF, DROP_ADD, DROP_CMUL, LIFT_DROP])

  let REAL_LOG_CONVEX_ON_EQ ← prove
   r"!f g s.
         is_realinterval s /\ (!x. x IN s ==> f x = g x) /\
         f real_log_convex_on s
         ==> g real_log_convex_on s"
   (REWRITE_TAC [IS_REALINTERVAL_CONVEX, REAL_LOG_CONVEX_LOG_CONVEX] THEN
    REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      (← REWRITE_RULE [CONJ_ASSOC] LOG_CONVEX_ON_EQ)) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP])

  let REAL_LOG_CONVEX_ON_SING ← prove
   r"!f a. f real_log_convex_on {a} <=> &0 <= f a"
   (REWRITE_TAC [REAL_LOG_CONVEX_LOG_CONVEX, LOG_CONVEX_ON_SING] THEN
    REWRITE_TAC [IMAGE_CLAUSES, LOG_CONVEX_ON_SING, o_THM, LIFT_DROP])

  let REAL_LOG_CONVEX_IMP_POS ← prove
   r"!f s x.
        f real_log_convex_on s /\ x IN s ==> &0 <= f x"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, REAL_LOG_CONVEX_LOG_CONVEX] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] LOG_CONVEX_IMP_POS)) THEN
    REWRITE_TAC [o_DEF, FORALL_IN_IMAGE, LIFT_DROP])

  let REAL_LOG_CONVEX_ON_CONVEX ← prove
   r"!f s.
        is_realinterval s
        ==> (f real_log_convex_on s <=>
             (!x. x IN s ==> &0 <= f x) /\
             !x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                       ==> f(u * x + v * y) <= f(x) rpow u * f(y) rpow v)"
   (REWRITE_TAC [REAL_CONVEX] THEN REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [ASM_MESON_TAC [REAL_LOG_CONVEX_IMP_POS],
      ASM_MESON_TAC [real_log_convex_on],
      ASM_SIMP_TAC [real_log_convex_on] THEN ASM_MESON_TAC []])

  let REAL_LOG_CONVEX_ON ← prove
   r"!f s:real->bool.
        is_realinterval s /\ (!x. x IN s ==> &0 < f x)
        ==> (f real_log_convex_on s <=> (log o f) real_convex_on s)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_LOG_CONVEX_ON_CONVEX, REAL_LT_IMP_LE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_CONVEX]) THEN
    REWRITE_TAC [real_convex_on, o_DEF] THEN
    GEN_REWRITE_TAC (RAND_CONV o funpow 4 BINDER_CONV o RAND_CONV)
      [← GSYM REAL_EXP_MONO_LE] THEN
    ASM_SIMP_TAC [EXP_LOG, rpow, REAL_EXP_ADD])

  let REAL_LOG_CONVEX_IMP_CONVEX ← prove
   r"!f s:real->bool. f real_log_convex_on s ==> f real_convex_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      REAL_LOG_CONVEX_IMP_POS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [real_log_convex_on]) THEN
    REWRITE_TAC [real_convex_on] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real", ← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPECL [← q r"x:real", ← q r"y:real", ← q r"u:real", ← q r"v:real"]) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC AGM_2 THEN ASM_SIMP_TAC [])

  let REAL_LOG_CONVEX_ADD ← prove
   r"!f g s:real->bool.
        f real_log_convex_on s /\ g real_log_convex_on s
        ==> (\x. f x + g x) real_log_convex_on s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (CONJUNCTS_THEN (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      REAL_LOG_CONVEX_IMP_POS))) THEN
    REWRITE_TAC [real_log_convex_on] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN
      (ASSUME_TAC o REWRITE_RULE [real_log_convex_on])) THEN
    REWRITE_TAC [real_log_convex_on] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real", ← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [REAL_LE_ADD] THEN
    MP_TAC (← ISPEC (← q r"0..SUC 0") HOELDER) THEN
    SIMP_TAC [PRODUCT_CLAUSES_NUMSEG,
              FINITE_NUMSEG, SUM_CLAUSES_NUMSEG, ARITH] THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"\i. if i = 0 then u:real else v",
      ← q r"\i. if i = 0 then (f:real->real) x else f y",
      ← q r"\i. if i = 0 then (g:real->real) x else g y"]) THEN
    REWRITE_TAC [ARITH] THEN ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_MESON_TAC [])

  let REAL_LOG_CONVEX_MUL ← prove
   r"!f g s:real->bool.
        f real_log_convex_on s /\ g real_log_convex_on s
        ==> (\x. f x * g x) real_log_convex_on s"
   (REWRITE_TAC [real_log_convex_on] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [REAL_LE_MUL, RPOW_MUL] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH
     (← q r"(a * b) * (c * d):real = (a * c) * (b * d)")] THEN
    ASM_SIMP_TAC [REAL_LE_MUL2])

  let MIDPOINT_REAL_LOG_CONVEX ← prove
   r"!f s:real->bool.
        f real_continuous_on s /\ is_realinterval s /\
        (!x. x IN s ==> &0 < f x) /\
        (!x y. x IN s /\ y IN s ==> f((x + y) / &2) pow 2 <= f(x) * f(y))
        ==> f real_log_convex_on s"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [REAL_LOG_CONVEX_ON] THEN
    MATCH_MP_TAC REAL_CONTINUOUS_MIDPOINT_CONVEX THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_ON_LOG THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE],
      MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN STRIP_TAC THEN
      REWRITE_TAC [o_DEF, ← REAL_ARITH (← q r"x <= y / &2 <=> &2 * x <= y")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_EXP_MONO_LE] THEN
      ASM_SIMP_TAC [REAL_EXP_N, EXP_LOG, REAL_EXP_ADD, REAL_MIDPOINT_IN_CONVEX]])

  let REAL_LOG_CONVEX_CONST ← prove
   r"!s a. &0 <= a ==> (\x. a) real_log_convex_on s"
   (SIMP_TAC [real_log_convex_on, ← GSYM RPOW_ADD] THEN
    IMP_REWRITE_TAC [← GSYM RPOW_ADD_ALT] THEN
    REWRITE_TAC [RPOW_POW, REAL_POW_1, REAL_LE_REFL] THEN REAL_ARITH_TAC)

  let REAL_LOG_CONVEX_PRODUCT ← prove
   r"!f s k. FINITE k /\ (!i. i IN k ==> (\x. f x i) real_log_convex_on s)
           ==> (\x. product k (f x)) real_log_convex_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, REAL_LOG_CONVEX_CONST, REAL_POS] THEN
    SIMP_TAC [FORALL_IN_INSERT, REAL_LOG_CONVEX_MUL])

  let REAL_LOG_CONVEX_RPOW_RIGHT ← prove
   r"!s a. &0 < a ==> (\x. a rpow x) real_log_convex_on s"
   (SIMP_TAC [real_log_convex_on, RPOW_POS_LE, REAL_LT_IMP_LE] THEN
    SIMP_TAC [DROP_ADD, DROP_CMUL, RPOW_ADD, RPOW_RPOW, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [REAL_MUL_AC, REAL_LE_REFL])

  let REAL_LOG_CONVEX_LIM ← prove
   r"!net:A net f g s.
       ~(trivial_limit net) /\
       (!x y u v. x IN s /\ y IN s /\ &0 <= u /\ &0 <= v /\ u + v = &1
                  ==> ((\i. f i (u * x + v * y)) ---> g(u * x + v * y)) net) /\
       eventually (\i. (f i) real_log_convex_on s) net
       ==> g real_log_convex_on s"
   (REWRITE_TAC [real_log_convex_on] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_SUB_LE] THEN
    CONJ_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"net:A net") REALLIM_LBOUND) THENL
     [EXISTS_TAC (← q r"\i. (f:A->real->real) i (u * x + v * y)"),
      EXISTS_TAC (← q r"\i. (f:A->real->real) i x rpow u * f i y rpow v -
                      f i (u * x + v * y)")] THEN
    ASM_SIMP_TAC [] THEN TRY CONJ_TAC THEN
    TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO))) THEN
    ASM_SIMP_TAC [REAL_SUB_LE] THEN
    MATCH_MP_TAC REALLIM_SUB THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC REALLIM_MUL THEN CONJ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [] (← ISPEC (← q r"\x. x rpow y")
      REALLIM_REAL_CONTINUOUS_FUNCTION)) THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_AT_RPOW] THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real", ← q r"x:real", ← q r"&1", ← q r"&0"]),
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"y:real", ← q r"y:real", ← q r"&1", ← q r"&0"])] THEN
    ASM_REWRITE_TAC [REAL_POS, REAL_ADD_RID, REAL_MUL_LZERO] THEN
    REWRITE_TAC [REAL_MUL_LID])

  pure { real_log_convex_on, REAL_LOG_CONVEX_ON_EMPTY, REAL_LOG_CONVEX_ON_SUBSET,
         REAL_LOG_CONVEX_LOG_CONVEX, REAL_LOG_CONVEX_ON_EQ, REAL_LOG_CONVEX_ON_SING,
         REAL_LOG_CONVEX_IMP_POS, REAL_LOG_CONVEX_ON_CONVEX, REAL_LOG_CONVEX_ON,
         REAL_LOG_CONVEX_IMP_CONVEX, REAL_LOG_CONVEX_ADD, REAL_LOG_CONVEX_MUL,
         MIDPOINT_REAL_LOG_CONVEX, REAL_LOG_CONVEX_CONST, REAL_LOG_CONVEX_PRODUCT,
         REAL_LOG_CONVEX_RPOW_RIGHT, REAL_LOG_CONVEX_LIM }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions; measures of real sets (part 1).        -/
/- (realanalysis.ml 8409-8545)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAK where
  has_real_integral : thm
  real_integrable_on : thm
  real_integral : thm
  real_negligible : thm
  absolutely_real_integrable_on : thm
  has_real_measure : thm
  real_measurable : thm
  real_measure : thm
  HAS_REAL_INTEGRAL : thm
  REAL_INTEGRABLE_INTEGRAL : thm
  HAS_REAL_INTEGRAL_INTEGRABLE : thm
  HAS_REAL_INTEGRAL_INTEGRAL : thm
  HAS_REAL_INTEGRAL_UNIQUE : thm
  REAL_INTEGRAL_UNIQUE : thm
  HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL : thm
  REAL_INTEGRAL_EQ_HAS_INTEGRAL : thm
  REAL_INTEGRABLE_ON : thm
  ABSOLUTELY_REAL_INTEGRABLE_ON : thm
  REAL_INTEGRAL : thm
  HAS_REAL_INTEGRAL_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAK [HolBase] (D : RealAnalysisDeps) : ExceptT String IO RZAK := do
  -- @@SCOPE BEGIN
  let { SUBSET_LIFT_IMAGE, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { IMP_REWRITE_TAC, .. } := D.ts.cn.ms.ig
  let { HAS_INTEGRAL_ALT, HAS_INTEGRAL_INTEGRAL, HAS_INTEGRAL_UNIQUE,
        .. } := D.ts.cn.ms.qintegration2
  let { absolutely_integrable_on, integrable_on, .. } := D.ts.cn.ms.qintegration3
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, SELECT_CONV,
        .. } := D.ts.cn.cx.cvx
  let { SELECT_UNIQUE, .. } := D.ts.cn.cx.cpx
  let { NORM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { COND_RAND, .. } := D.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, .. } := D.ts.cn.cx.cvx.core2
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_SUB, EXISTS_DROP, FORALL_LIFT, LIFT_DROP, LIFT_EQ, LIFT_NUM,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, VECTOR_ADD_LID, VECTOR_SUB_LZERO, .. } := D.ts.cn.cx.cvx.vec4
  let { BALL_1, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  parse_as_infix ("has_real_integral", (12, "right"))
  parse_as_infix ("real_integrable_on", (12, "right"))
  parse_as_infix ("absolutely_real_integrable_on", (12, "right"))
  parse_as_infix ("has_real_measure", (12, "right"))

  let has_real_integral ← new_definition
   r"(f has_real_integral y) s <=>
        ((lift o f o drop) has_integral (lift y)) (IMAGE lift s)"

  let real_integrable_on ← new_definition
   r"f real_integrable_on i <=> ?y. (f has_real_integral y) i"

  let real_integral ← new_definition
   r"real_integral i f = @y. (f has_real_integral y) i"

  let real_negligible ← new_definition
   r"real_negligible s <=> negligible (IMAGE lift s)"

  let absolutely_real_integrable_on ← new_definition
   r"f absolutely_real_integrable_on s <=>
        f real_integrable_on s /\ (\x. abs(f x)) real_integrable_on s"

  let has_real_measure ← new_definition
   r"s has_real_measure m <=> ((\x. &1) has_real_integral m) s"

  let real_measurable ← new_definition
   r"real_measurable s <=> ?m. s has_real_measure m"

  let real_measure ← new_definition
   r"real_measure s = @m. s has_real_measure m"

  let HAS_REAL_INTEGRAL ← prove
   r"(f has_real_integral y) (real_interval[a,b]) <=>
   ((lift o f o drop) has_integral (lift y)) (interval[lift a,lift b])"
   (REWRITE_TAC [has_real_integral, IMAGE_LIFT_REAL_INTERVAL])

  let REAL_INTEGRABLE_INTEGRAL ← prove
   r"!f i. f real_integrable_on i
         ==> (f has_real_integral (real_integral i f)) i"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_integrable_on, real_integral] THEN
    CONV_TAC (RAND_CONV SELECT_CONV) THEN REWRITE_TAC [])

  let HAS_REAL_INTEGRAL_INTEGRABLE ← prove
   r"!f i s. (f has_real_integral i) s ==> f real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [])

  let HAS_REAL_INTEGRAL_INTEGRAL ← prove
   r"!f s. f real_integrable_on s <=>
         (f has_real_integral (real_integral s f)) s"
   (MESON_TAC [REAL_INTEGRABLE_INTEGRAL, HAS_REAL_INTEGRAL_INTEGRABLE])

  let HAS_REAL_INTEGRAL_UNIQUE ← prove
   r"!f i k1 k2.
        (f has_real_integral k1) i /\ (f has_real_integral k2) i ==> k1 = k2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_UNIQUE) THEN
    REWRITE_TAC [LIFT_EQ])

  let REAL_INTEGRAL_UNIQUE ← prove
   r"!f y k.
      (f has_real_integral y) k ==> real_integral k f = y"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_integral] THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN ASM_MESON_TAC [HAS_REAL_INTEGRAL_UNIQUE])

  let HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL ← prove
   r"!f i s.
        (f has_real_integral i) s <=>
        f real_integrable_on s /\ real_integral s f = i"
   (MESON_TAC [REAL_INTEGRABLE_INTEGRAL, REAL_INTEGRAL_UNIQUE,
               real_integrable_on])

  let REAL_INTEGRAL_EQ_HAS_INTEGRAL ← prove
   r"!s f y. f real_integrable_on s
           ==> (real_integral s f = y <=> (f has_real_integral y) s)"
   (MESON_TAC [REAL_INTEGRABLE_INTEGRAL, REAL_INTEGRAL_UNIQUE])

  let REAL_INTEGRABLE_ON ← prove
   r"f real_integrable_on s <=>
        (lift o f o drop) integrable_on (IMAGE lift s)"
   (REWRITE_TAC [real_integrable_on, has_real_integral, EXISTS_DROP,
                 integrable_on, LIFT_DROP])

  let ABSOLUTELY_REAL_INTEGRABLE_ON ← prove
   r"f absolutely_real_integrable_on s <=>
        (lift o f o drop) absolutely_integrable_on (IMAGE lift s)"
   (REWRITE_TAC [absolutely_real_integrable_on, REAL_INTEGRABLE_ON,
                 absolutely_integrable_on] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, NORM_LIFT])

  let REAL_INTEGRAL ← prove
   r"f real_integrable_on s
   ==> real_integral s f = drop(integral (IMAGE lift s) (lift o f o drop))"
   (REWRITE_TAC [REAL_INTEGRABLE_ON] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    REWRITE_TAC [has_real_integral, LIFT_DROP] THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let HAS_REAL_INTEGRAL_ALT ← prove
   r"!f s i.
         (f has_real_integral i) s <=>
         (!a b. (\x. if x IN s then f x else &0) real_integrable_on
                real_interval [a,b]) /\
         (!e. &0 < e
              ==> (?B. &0 < B /\
                       (!a b.
                            real_interval(--B,B) SUBSET real_interval[a,b]
                            ==> abs
                                (real_integral (real_interval[a,b])
                                 (\x. if x IN s then f x else &0) -
                                 i) < e)))"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [has_real_integral] THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_INTEGRAL_ALT] THEN
    REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [← GSYM FORALL_LIFT, COND_RAND, LIFT_NUM, IN_IMAGE_LIFT_DROP] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> q')) ==> (p /\ q <=> p /\ q')")) THEN
    DISCH_TAC THEN REWRITE_TAC [BALL_1] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN ASM_CASES_TAC (← q r"&0 < B") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [FORALL_LIFT, VECTOR_ADD_LID, VECTOR_SUB_LZERO] THEN
    REWRITE_TAC [← GSYM LIFT_NEG, ← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [SUBSET_LIFT_IMAGE, NORM_REAL, ← GSYM drop] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:real") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN
    ASM_CASES_TAC (← q r"real_interval(--B,B) SUBSET real_interval[a,b]") THEN
    ASM_REWRITE_TAC [DROP_SUB, LIFT_DROP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN IMP_REWRITE_TAC [REAL_INTEGRAL] THEN
    REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF, LIFT_DROP, COND_RAND] THEN
    ASM_REWRITE_TAC [LIFT_NUM, IMAGE_LIFT_REAL_INTERVAL])

  pure { has_real_integral, real_integrable_on, real_integral, real_negligible,
         absolutely_real_integrable_on, has_real_measure, real_measurable, real_measure,
         HAS_REAL_INTEGRAL, REAL_INTEGRABLE_INTEGRAL, HAS_REAL_INTEGRAL_INTEGRABLE,
         HAS_REAL_INTEGRAL_INTEGRAL, HAS_REAL_INTEGRAL_UNIQUE, REAL_INTEGRAL_UNIQUE,
         HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL, REAL_INTEGRAL_EQ_HAS_INTEGRAL,
         REAL_INTEGRABLE_ON, ABSOLUTELY_REAL_INTEGRABLE_ON, REAL_INTEGRAL,
         HAS_REAL_INTEGRAL_ALT }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions (part 2: linearity, sums, null sets).   -/
/- (realanalysis.ml 8546-8856)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAL where
  HAS_REAL_INTEGRAL_IS_0 : thm
  HAS_REAL_INTEGRAL_0 : thm
  HAS_REAL_INTEGRAL_0_EQ : thm
  HAS_REAL_INTEGRAL_LINEAR : thm
  HAS_REAL_INTEGRAL_LMUL : thm
  HAS_REAL_INTEGRAL_RMUL : thm
  HAS_REAL_INTEGRAL_NEG : thm
  HAS_REAL_INTEGRAL_ADD : thm
  HAS_REAL_INTEGRAL_SUB : thm
  REAL_INTEGRAL_0 : thm
  REAL_INTEGRAL_ADD : thm
  REAL_INTEGRAL_LMUL : thm
  REAL_INTEGRAL_RMUL : thm
  REAL_INTEGRAL_NEG : thm
  REAL_INTEGRAL_SUB : thm
  REAL_INTEGRABLE_0 : thm
  REAL_INTEGRABLE_ADD : thm
  REAL_INTEGRABLE_LMUL : thm
  REAL_INTEGRABLE_RMUL : thm
  REAL_INTEGRABLE_LMUL_EQ : thm
  REAL_INTEGRABLE_RMUL_EQ : thm
  REAL_INTEGRABLE_NEG : thm
  REAL_INTEGRABLE_NEG_EQ : thm
  REAL_INTEGRABLE_SUB : thm
  REAL_INTEGRABLE_LINEAR : thm
  REAL_INTEGRAL_LINEAR : thm
  HAS_REAL_INTEGRAL_SUM : thm
  REAL_INTEGRAL_SUM : thm
  REAL_INTEGRABLE_SUM : thm
  HAS_REAL_INTEGRAL_EQ : thm
  REAL_INTEGRABLE_EQ : thm
  HAS_REAL_INTEGRAL_EQ_EQ : thm
  HAS_REAL_INTEGRAL_NULL : thm
  HAS_REAL_INTEGRAL_NULL_EQ : thm
  REAL_INTEGRAL_NULL : thm
  REAL_INTEGRABLE_ON_NULL : thm
  HAS_REAL_INTEGRAL_EMPTY : thm
  HAS_REAL_INTEGRAL_EMPTY_EQ : thm
  REAL_INTEGRABLE_ON_EMPTY : thm
  REAL_INTEGRAL_EMPTY : thm
  HAS_REAL_INTEGRAL_REFL : thm
  REAL_INTEGRABLE_ON_REFL : thm
  REAL_INTEGRAL_REFL : thm
  HAS_REAL_INTEGRAL_CONST : thm
  REAL_INTEGRABLE_CONST : thm
  REAL_INTEGRAL_CONST : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAL [HolBase] (D : RealAnalysisDeps) (BRZAK : RZAK) : ExceptT String IO RZAL := do
  -- @@SCOPE BEGIN
  let { has_real_integral, HAS_REAL_INTEGRAL_INTEGRAL, HAS_REAL_INTEGRAL_UNIQUE,
        REAL_INTEGRABLE_INTEGRAL, real_integrable_on, REAL_INTEGRABLE_ON,
        REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { IMAGE_LIFT_REAL_INTERVAL, REAL_INTERVAL_INTERVAL, .. } := D.qtopology
  let { EMPTY_AS_REAL_INTERVAL, .. } := D.qmisc
  let { HAS_INTEGRAL_IS_0, HAS_INTEGRAL_NEG, HAS_INTEGRAL_NULL, .. } := D.qintegration
  let { CONTENT_1, CONTENT_EQ_0_1, .. } := D.ts.cn.ms.qintegration1
  let { HAS_INTEGRAL_ADD, HAS_INTEGRAL_CMUL, HAS_INTEGRAL_CONST, HAS_INTEGRAL_LINEAR,
        HAS_INTEGRAL_SUB, INTEGRABLE_CONST, .. } := D.ts.cn.ms.qintegration2
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, .. } := D.ts.cn.cx.cvx
  let { ETA_AX, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_SYM,
        REAL_NEG_NEG, REAL_POS, REAL_SUB_0, REAL_SUB_RZERO, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB,
        .. } := D.ts.cn.cx.cvx.vec2
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let HAS_REAL_INTEGRAL_IS_0 ← prove
   r"!f s. (!x. x IN s ==> f(x) = &0) ==> (f has_real_integral &0) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_real_integral, LIFT_NUM] THEN
    MATCH_MP_TAC HAS_INTEGRAL_IS_0 THEN
    ASM_REWRITE_TAC [LIFT_EQ, FORALL_IN_IMAGE, o_THM, LIFT_DROP, ← GSYM LIFT_NUM])

  let HAS_REAL_INTEGRAL_0 ← prove
   r"!s. ((\x. &0) has_real_integral &0) s"
   (SIMP_TAC [HAS_REAL_INTEGRAL_IS_0])

  let HAS_REAL_INTEGRAL_0_EQ ← prove
   r"!i s. ((\x. &0) has_real_integral i) s <=> i = &0"
   (MESON_TAC [HAS_REAL_INTEGRAL_UNIQUE, HAS_REAL_INTEGRAL_0])

  let HAS_REAL_INTEGRAL_LINEAR ← prove
   r"!f:real->real y s h:real->real.
        (f has_real_integral y) s /\ linear(lift o h o drop)
        ==> ((h o f) has_real_integral h(y)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_LINEAR) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let HAS_REAL_INTEGRAL_LMUL ← prove
   r"!(f:real->real) k s c.
        (f has_real_integral k) s
        ==> ((\x. c * f(x)) has_real_integral (c * k)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
    REWRITE_TAC [← GSYM LIFT_CMUL, o_DEF])

  let HAS_REAL_INTEGRAL_RMUL ← prove
   r"!(f:real->real) k s c.
        (f has_real_integral k) s
        ==> ((\x. f(x) * c) has_real_integral (k * c)) s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL_LMUL])

  let HAS_REAL_INTEGRAL_NEG ← prove
   r"!f k s. (f has_real_integral k) s
           ==> ((\x. --(f x)) has_real_integral (--k)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_NEG) THEN
    REWRITE_TAC [o_DEF, LIFT_NEG])

  let HAS_REAL_INTEGRAL_ADD ← prove
   r"!f:real->real g k l s.
        (f has_real_integral k) s /\ (g has_real_integral l) s
        ==> ((\x. f(x) + g(x)) has_real_integral (k + l)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_ADD) THEN
    REWRITE_TAC [o_DEF, LIFT_ADD])

  let HAS_REAL_INTEGRAL_SUB ← prove
   r"!f:real->real g k l s.
        (f has_real_integral k) s /\ (g has_real_integral l) s
        ==> ((\x. f(x) - g(x)) has_real_integral (k - l)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_real_integral] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB) THEN
    REWRITE_TAC [o_DEF, LIFT_SUB])

  let REAL_INTEGRAL_0 ← prove
   r"!s. real_integral s (\x. &0) = &0"
   (MESON_TAC [REAL_INTEGRAL_UNIQUE, HAS_REAL_INTEGRAL_0])

  let REAL_INTEGRAL_ADD ← prove
   r"!f:real->real g s.
        f real_integrable_on s /\ g real_integrable_on s
        ==> real_integral s (\x. f x + g x) =
            real_integral s f + real_integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_ADD THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRAL_LMUL ← prove
   r"!f:real->real c s.
        f real_integrable_on s
        ==> real_integral s (\x. c * f(x)) = c * real_integral s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_LMUL THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRAL_RMUL ← prove
   r"!f:real->real c s.
        f real_integrable_on s
        ==> real_integral s (\x. f(x) * c) = real_integral s f * c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_RMUL THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRAL_NEG ← prove
   r"!f:real->real s.
        f real_integrable_on s
        ==> real_integral s (\x. --f(x)) = --real_integral s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_NEG THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRAL_SUB ← prove
   r"!f:real->real g s.
        f real_integrable_on s /\ g real_integrable_on s
        ==> real_integral s (\x. f x - g x) =
            real_integral s f - real_integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_SUB THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRABLE_0 ← prove
   r"!s. (\x. &0) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_0])

  let REAL_INTEGRABLE_ADD ← prove
   r"!f:real->real g s.
        f real_integrable_on s /\ g real_integrable_on s
        ==> (\x. f x + g x) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_ADD])

  let REAL_INTEGRABLE_LMUL ← prove
   r"!f:real->real c s.
        f real_integrable_on s
        ==> (\x. c * f(x)) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_LMUL])

  let REAL_INTEGRABLE_RMUL ← prove
   r"!f:real->real c s.
        f real_integrable_on s
        ==> (\x. f(x) * c) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_RMUL])

  let REAL_INTEGRABLE_LMUL_EQ ← prove
   r"!f s c.
        (\x. c * f x) real_integrable_on s <=>
        c = &0 \/ f real_integrable_on s"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_LMUL, REAL_MUL_LZERO] THEN
    REWRITE_TAC [REAL_INTEGRABLE_0] THEN
    ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv c:real") o
      MATCH_MP REAL_INTEGRABLE_LMUL) THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, ETA_AX])

  let REAL_INTEGRABLE_RMUL_EQ ← prove
   r"!f s c.
        (\x. f x * c) real_integrable_on s <=>
        c = &0 \/ f real_integrable_on s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [REAL_INTEGRABLE_LMUL_EQ])

  let REAL_INTEGRABLE_NEG ← prove
   r"!f:real->real s.
        f real_integrable_on s ==> (\x. --f(x)) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_NEG])

  let REAL_INTEGRABLE_NEG_EQ ← prove
   r"!f s. (\x. --f x) real_integrable_on s <=> f real_integrable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_INTEGRABLE_NEG) THEN
    REWRITE_TAC [REAL_NEG_NEG, ETA_AX])

  let REAL_INTEGRABLE_SUB ← prove
   r"!f:real->real g s.
        f real_integrable_on s /\ g real_integrable_on s
        ==> (\x. f x - g x) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_SUB])

  let REAL_INTEGRABLE_LINEAR ← prove
   r"!f h s. f real_integrable_on s /\
           linear(lift o h o drop) ==> (h o f) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_LINEAR])

  let REAL_INTEGRAL_LINEAR ← prove
   r"!f:real->real s h:real->real.
        f real_integrable_on s /\ linear(lift o h o drop)
        ==> real_integral s (h o f) = h(real_integral s f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_UNIQUE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(h:real->real) o (f:real->real)", ← q r"s:real->bool"] THEN
    CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC HAS_REAL_INTEGRAL_LINEAR] THEN
    ASM_SIMP_TAC [← GSYM HAS_REAL_INTEGRAL_INTEGRAL, REAL_INTEGRABLE_LINEAR])

  let HAS_REAL_INTEGRAL_SUM ← prove
   r"!f:A->real->real s t.
        FINITE t /\
        (!a. a IN t ==> ((f a) has_real_integral (i a)) s)
        ==> ((\x. sum t (\a. f a x)) has_real_integral (sum t i)) s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, HAS_REAL_INTEGRAL_0, IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_ADD THEN
    ASM_REWRITE_TAC [ETA_AX] THEN CONJ_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [])

  let REAL_INTEGRAL_SUM ← prove
   r"!f:A->real->real s t.
        FINITE t /\
        (!a. a IN t ==> (f a) real_integrable_on s)
        ==> real_integral s (\x. sum t (\a. f a x)) =
                sum t (\a. real_integral s (f a))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_SUM THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRABLE_SUM ← prove
   r"!f:A->real->real s t.
        FINITE t /\
        (!a. a IN t ==> (f a) real_integrable_on s)
        ==>  (\x. sum t (\a. f a x)) real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_SUM])

  let HAS_REAL_INTEGRAL_EQ ← prove
   r"!f:real->real g k s.
        (!x. x IN s ==> (f(x) = g(x))) /\
        (f has_real_integral k) s
        ==> (g has_real_integral k) s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_IS_0) MP_TAC) THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN
     (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_SUB) THEN
    SIMP_TAC [← REAL_ARITH (← q r"x - (x - y:real) = y"), ETA_AX, REAL_SUB_RZERO])

  let REAL_INTEGRABLE_EQ ← prove
   r"!f:real->real g s.
        (!x. x IN s ==> (f(x) = g(x))) /\
        f real_integrable_on s
        ==> g real_integrable_on s"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_EQ])

  let HAS_REAL_INTEGRAL_EQ_EQ ← prove
   r"!f:real->real g k s.
        (!x. x IN s ==> (f(x) = g(x)))
        ==> ((f has_real_integral k) s <=> (g has_real_integral k) s)"
   (MESON_TAC [HAS_REAL_INTEGRAL_EQ])

  let HAS_REAL_INTEGRAL_NULL ← prove
   r"!f:real->real a b.
    b <= a ==> (f has_real_integral &0) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [has_real_integral, REAL_INTERVAL_INTERVAL] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP, LIFT_NUM] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE (\x. x) s = s")] THEN
    MATCH_MP_TAC HAS_INTEGRAL_NULL THEN
    ASM_REWRITE_TAC [CONTENT_EQ_0_1, LIFT_DROP])

  let HAS_REAL_INTEGRAL_NULL_EQ ← prove
   r"!f a b i. b <= a
             ==> ((f has_real_integral i) (real_interval[a,b]) <=> i = &0)"
   (ASM_MESON_TAC [REAL_INTEGRAL_UNIQUE, HAS_REAL_INTEGRAL_NULL])

  let REAL_INTEGRAL_NULL ← prove
   r"!f a b. b <= a
           ==> real_integral(real_interval[a,b]) f = &0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_MESON_TAC [HAS_REAL_INTEGRAL_NULL])

  let REAL_INTEGRABLE_ON_NULL ← prove
   r"!f a b. b <= a
           ==> f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_NULL])

  let HAS_REAL_INTEGRAL_EMPTY ← prove
   r"!f. (f has_real_integral &0) {}"
   (GEN_TAC THEN REWRITE_TAC [EMPTY_AS_REAL_INTERVAL] THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_NULL THEN REWRITE_TAC [REAL_POS])

  let HAS_REAL_INTEGRAL_EMPTY_EQ ← prove
   r"!f i. (f has_real_integral i) {} <=> i = &0"
   (MESON_TAC [HAS_REAL_INTEGRAL_UNIQUE, HAS_REAL_INTEGRAL_EMPTY])

  let REAL_INTEGRABLE_ON_EMPTY ← prove
   r"!f. f real_integrable_on {}"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_EMPTY])

  let REAL_INTEGRAL_EMPTY ← prove
   r"!f. real_integral {} f = &0"
   (MESON_TAC [EMPTY_AS_REAL_INTERVAL, REAL_INTEGRAL_UNIQUE,
               HAS_REAL_INTEGRAL_EMPTY])

  let HAS_REAL_INTEGRAL_REFL ← prove
   r"!f a. (f has_real_integral &0) (real_interval[a,a])"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_NULL THEN
    REWRITE_TAC [REAL_LE_REFL])

  let REAL_INTEGRABLE_ON_REFL ← prove
   r"!f a. f real_integrable_on real_interval[a,a]"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_REFL])

  let REAL_INTEGRAL_REFL ← prove
   r"!f a. real_integral (real_interval[a,a]) f = &0"
   (MESON_TAC [REAL_INTEGRAL_UNIQUE, HAS_REAL_INTEGRAL_REFL])

  let HAS_REAL_INTEGRAL_CONST ← prove
   r"!a b c.
        a <= b
        ==> ((\x. c) has_real_integral (c * (b - a))) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [has_real_integral, IMAGE_LIFT_REAL_INTERVAL] THEN
    MP_TAC (← ISPECL [← q r"lift a", ← q r"lift b", ← q r"lift c"] HAS_INTEGRAL_CONST) THEN
    ASM_SIMP_TAC [o_DEF, CONTENT_1, LIFT_DROP, LIFT_CMUL])

  let REAL_INTEGRABLE_CONST ← prove
   r"!a b c. (\x. c) real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [REAL_INTEGRABLE_ON, IMAGE_LIFT_REAL_INTERVAL,
                 o_DEF, INTEGRABLE_CONST])

  let REAL_INTEGRAL_CONST ← prove
   r"!a b c.
        a <= b
        ==> real_integral (real_interval [a,b]) (\x. c) = c * (b - a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_INTEGRAL_CONST])

  pure { HAS_REAL_INTEGRAL_IS_0, HAS_REAL_INTEGRAL_0, HAS_REAL_INTEGRAL_0_EQ,
         HAS_REAL_INTEGRAL_LINEAR, HAS_REAL_INTEGRAL_LMUL, HAS_REAL_INTEGRAL_RMUL,
         HAS_REAL_INTEGRAL_NEG, HAS_REAL_INTEGRAL_ADD, HAS_REAL_INTEGRAL_SUB,
         REAL_INTEGRAL_0, REAL_INTEGRAL_ADD, REAL_INTEGRAL_LMUL, REAL_INTEGRAL_RMUL,
         REAL_INTEGRAL_NEG, REAL_INTEGRAL_SUB, REAL_INTEGRABLE_0, REAL_INTEGRABLE_ADD,
         REAL_INTEGRABLE_LMUL, REAL_INTEGRABLE_RMUL, REAL_INTEGRABLE_LMUL_EQ,
         REAL_INTEGRABLE_RMUL_EQ, REAL_INTEGRABLE_NEG, REAL_INTEGRABLE_NEG_EQ,
         REAL_INTEGRABLE_SUB, REAL_INTEGRABLE_LINEAR, REAL_INTEGRAL_LINEAR,
         HAS_REAL_INTEGRAL_SUM, REAL_INTEGRAL_SUM, REAL_INTEGRABLE_SUM,
         HAS_REAL_INTEGRAL_EQ, REAL_INTEGRABLE_EQ, HAS_REAL_INTEGRAL_EQ_EQ,
         HAS_REAL_INTEGRAL_NULL, HAS_REAL_INTEGRAL_NULL_EQ, REAL_INTEGRAL_NULL,
         REAL_INTEGRABLE_ON_NULL, HAS_REAL_INTEGRAL_EMPTY, HAS_REAL_INTEGRAL_EMPTY_EQ,
         REAL_INTEGRABLE_ON_EMPTY, REAL_INTEGRAL_EMPTY, HAS_REAL_INTEGRAL_REFL,
         REAL_INTEGRABLE_ON_REFL, REAL_INTEGRAL_REFL, HAS_REAL_INTEGRAL_CONST,
         REAL_INTEGRABLE_CONST, REAL_INTEGRAL_CONST }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions (part 3: bounds, spikes, negligible).   -/
/- (realanalysis.ml 8857-9113)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAM where
  HAS_REAL_INTEGRAL_BOUND : thm
  HAS_REAL_INTEGRAL_LE : thm
  REAL_INTEGRAL_LE : thm
  HAS_REAL_INTEGRAL_POS : thm
  REAL_INTEGRAL_POS : thm
  HAS_REAL_INTEGRAL_ISNEG : thm
  HAS_REAL_INTEGRAL_LBOUND : thm
  HAS_REAL_INTEGRAL_UBOUND : thm
  REAL_INTEGRAL_LBOUND : thm
  REAL_INTEGRAL_UBOUND : thm
  REAL_INTEGRABLE_UNIFORM_LIMIT : thm
  HAS_REAL_INTEGRAL_NEGLIGIBLE : thm
  HAS_REAL_INTEGRAL_SPIKE : thm
  HAS_REAL_INTEGRAL_SPIKE_EQ : thm
  REAL_INTEGRABLE_SPIKE : thm
  REAL_INTEGRABLE_SPIKE_EQ : thm
  REAL_INTEGRAL_SPIKE : thm
  REAL_NEGLIGIBLE_SUBSET : thm
  REAL_NEGLIGIBLE_DIFF : thm
  REAL_NEGLIGIBLE_INTER : thm
  REAL_NEGLIGIBLE_UNION : thm
  REAL_NEGLIGIBLE_UNION_EQ : thm
  REAL_NEGLIGIBLE_SING : thm
  REAL_NEGLIGIBLE_INSERT : thm
  REAL_NEGLIGIBLE_EMPTY : thm
  REAL_NEGLIGIBLE_FINITE : thm
  REAL_NEGLIGIBLE_UNIONS : thm
  REAL_OPEN_NOT_REAL_NEGLIGIBLE : thm
  HAS_REAL_INTEGRAL_SPIKE_FINITE : thm
  HAS_REAL_INTEGRAL_SPIKE_FINITE_EQ : thm
  REAL_INTEGRABLE_SPIKE_FINITE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAM [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZAK : RZAK) (BRZAL : RZAL) : ExceptT String IO RZAM := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, .. } := BRZA
  let { HAS_REAL_INTEGRAL, has_real_integral, HAS_REAL_INTEGRAL_INTEGRAL,
        REAL_INTEGRABLE_INTEGRAL, real_integrable_on, real_integral, real_negligible,
        .. } := BRZAK
  let { HAS_REAL_INTEGRAL_0, HAS_REAL_INTEGRAL_CONST, .. } := BRZAL
  let { LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, REAL_INTERVAL_INTERVAL, .. } := D.qtopology
  let { OPEN_NOT_NEGLIGIBLE, .. } := D.qmeasure
  let { HAS_INTEGRAL_BOUND, HAS_INTEGRAL_COMPONENT_LE, INTEGRABLE_UNIFORM_LIMIT,
        .. } := D.qintegration
  let { CONTENT_1, .. } := D.ts.cn.ms.qintegration1
  let { HAS_INTEGRAL_NEGLIGIBLE, HAS_INTEGRAL_SPIKE, .. } := D.ts.cn.ms.qintegration2
  let { integrable_on, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT, NEGLIGIBLE_SING,
        NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION, .. } := D.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { DIMINDEX_1, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMAGE_UNION,
        IMP_CONJ, IN_DIFF, INTER_SUBSET, .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, LE_REFL, MONO_EXISTS, REAL_ABS_SUB, .. } := D.ts.cn.cx.cvx.core3
  let { SUBSET_DIFF, SUBSET_UNION, .. } := D.ts.cn.cx.cvx.core5
  let { o_THM, UNIONS_0, UNIONS_INSERT, .. } := D.ts.cn.cx.cvx.core6
  let { EXISTS_LIFT, LIFT_DROP, LIFT_NUM, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  -- @@SCOPE END

  let HAS_REAL_INTEGRAL_BOUND ← prove
   r"!f:real->real a b i B.
        &0 <= B /\ a <= b /\
        (f has_real_integral i) (real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] ==> abs(f x) <= B)
        ==> abs i <= B * (b - a)"
   (REWRITE_TAC [HAS_REAL_INTEGRAL, REAL_INTERVAL_INTERVAL, ← GSYM NORM_LIFT] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o BINOP_CONV) [← GSYM LIFT_DROP] THEN
    ASM_SIMP_TAC [← GSYM CONTENT_1, LIFT_DROP] THEN
    MATCH_MP_TAC HAS_INTEGRAL_BOUND THEN
    EXISTS_TAC (← q r"lift o f o drop") THEN ASM_REWRITE_TAC [o_THM])

  let HAS_REAL_INTEGRAL_LE ← prove
   r"!f g s i j.
        (f has_real_integral i) s /\ (g has_real_integral j) s /\
        (!x. x IN s ==> f x <= g x)
        ==> i <= j"
   (REWRITE_TAC [has_real_integral] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM LIFT_DROP] THEN
    REWRITE_TAC [drop] THEN MATCH_MP_TAC
     (← ISPECL [← q r"lift o f o drop", ← q r"lift o g o drop", ← q r"IMAGE lift s"]
             HAS_INTEGRAL_COMPONENT_LE) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, DIMINDEX_1, LE_REFL, o_THM, LIFT_DROP,
                     ← GSYM drop])

  let REAL_INTEGRAL_LE ← prove
   r"!f:real->real g:real->real s.
        f real_integrable_on s /\ g real_integrable_on s /\
        (!x. x IN s ==> f x <= g x)
        ==> real_integral s f <= real_integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_LE THEN
    ASM_MESON_TAC [REAL_INTEGRABLE_INTEGRAL])

  let HAS_REAL_INTEGRAL_POS ← prove
   r"!f:real->real s i.
        (f has_real_integral i) s /\
        (!x. x IN s ==> &0 <= f x)
        ==> &0 <= i"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\x. &0):real->real", ← q r"f:real->real",
                      ← q r"s:real->bool", ← q r"&0:real",
                      ← q r"i:real"] HAS_REAL_INTEGRAL_LE) THEN
    ASM_SIMP_TAC [HAS_REAL_INTEGRAL_0])

  let REAL_INTEGRAL_POS ← prove
   r"!f:real->real s.
        f real_integrable_on s /\
        (!x. x IN s ==> &0 <= f x)
        ==> &0 <= real_integral s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_POS THEN
    ASM_MESON_TAC [REAL_INTEGRABLE_INTEGRAL])

  let HAS_REAL_INTEGRAL_ISNEG ← prove
   r"!f:real->real s i.
        (f has_real_integral i) s /\
        (!x. x IN s ==> f x <= &0)
        ==> i <= &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"(\x. &0):real->real",
                      ← q r"s:real->bool", ← q r"i:real", ← q r"&0:real"
                     ] HAS_REAL_INTEGRAL_LE) THEN
    ASM_SIMP_TAC [HAS_REAL_INTEGRAL_0])

  let HAS_REAL_INTEGRAL_LBOUND ← prove
   r"!f:real->real a b i.
        a <= b /\
        (f has_real_integral i) (real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] ==> B <= f(x))
        ==> B * (b - a) <= i"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\x. B):real->real", ← q r"f:real->real",
                      ← q r"real_interval[a,b]",
                      ← q r"B * (b - a):real",
                      ← q r"i:real"]
                  HAS_REAL_INTEGRAL_LE) THEN
    ASM_SIMP_TAC [HAS_REAL_INTEGRAL_CONST])

  let HAS_REAL_INTEGRAL_UBOUND ← prove
   r"!f:real->real a b i.
        a <= b /\
        (f has_real_integral i) (real_interval[a,b]) /\
        (!x. x IN real_interval[a,b] ==> f(x) <= B)
        ==> i <= B * (b - a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"(\x. B):real->real",
                      ← q r"real_interval[a,b]", ← q r"i:real",
                      ← q r"B * (b - a):real"]
                  HAS_REAL_INTEGRAL_LE) THEN
    ASM_SIMP_TAC [HAS_REAL_INTEGRAL_CONST])

  let REAL_INTEGRAL_LBOUND ← prove
   r"!f:real->real a b.
        a <= b /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b] ==> B <= f(x))
        ==> B * (b - a) <= real_integral(real_interval[a,b]) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_LBOUND THEN
    EXISTS_TAC (← q r"f:real->real") THEN
    ASM_REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_INTEGRAL])

  let REAL_INTEGRAL_UBOUND ← prove
   r"!f:real->real a b.
        a <= b /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b] ==> f(x) <= B)
        ==> real_integral(real_interval[a,b]) f <= B * (b - a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_UBOUND THEN
    EXISTS_TAC (← q r"f:real->real") THEN
    ASM_REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_INTEGRAL])

  let REAL_INTEGRABLE_UNIFORM_LIMIT ← prove
   r"!f a b. (!e. &0 < e
                ==> ?g. (!x. x IN real_interval[a,b] ==> abs(f x - g x) <= e) /\
                        g real_integrable_on real_interval[a,b] )
           ==> f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [← GSYM integrable_on] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRABLE_UNIFORM_LIMIT THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"lift o g o drop") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [o_THM, LIFT_DROP, ← GSYM LIFT_SUB, NORM_LIFT])

  let HAS_REAL_INTEGRAL_NEGLIGIBLE ← prove
   r"!f s t.
        real_negligible s /\ (!x. x IN (t DIFF s) ==> f x = &0)
        ==> (f has_real_integral (&0)) t"
   (REWRITE_TAC [has_real_integral, real_negligible, LIFT_NUM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
    EXISTS_TAC (← q r"IMAGE lift s") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [o_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [LIFT_IN_IMAGE_LIFT, LIFT_DROP] THEN ASM SET_TAC [LIFT_NUM])

  let HAS_REAL_INTEGRAL_SPIKE ← prove
   r"!f g s t y.
        real_negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x) /\
        (f has_real_integral y) t
        ==> (g has_real_integral y) t"
   (REWRITE_TAC [has_real_integral, real_negligible] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    MAP_EVERY EXISTS_TAC [← q r"lift o f o drop", ← q r"IMAGE lift s"] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [o_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [LIFT_IN_IMAGE_LIFT, LIFT_DROP] THEN ASM SET_TAC [LIFT_NUM])

  let HAS_REAL_INTEGRAL_SPIKE_EQ ← prove
   r"!f g s t y.
        real_negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> ((f has_real_integral y) t <=> (g has_real_integral y) t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_SPIKE THENL
     [EXISTS_TAC (← q r"f:real->real"), EXISTS_TAC (← q r"g:real->real")] THEN
    EXISTS_TAC (← q r"s:real->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [REAL_ABS_SUB])

  let REAL_INTEGRABLE_SPIKE ← prove
   r"!f g s t.
        real_negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> f real_integrable_on t ==> g real_integrable_on  t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [real_integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_REAL_INTEGRAL_SPIKE) THEN ASM_REWRITE_TAC [])

  let REAL_INTEGRABLE_SPIKE_EQ ← prove
   r"!f g s t.
         real_negligible s /\ (!x. x IN t DIFF s ==> g x = f x)
         ==> (f real_integrable_on t <=> g real_integrable_on t)"
   (MESON_TAC [REAL_INTEGRABLE_SPIKE])

  let REAL_INTEGRAL_SPIKE ← prove
   r"!f:real->real g s t.
        real_negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> real_integral t f = real_integral t g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_integral] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_SPIKE_EQ THEN
    ASM_MESON_TAC [])

  let REAL_NEGLIGIBLE_SUBSET ← prove
   r"!s:real->bool t:real->bool.
        real_negligible s /\ t SUBSET s ==> real_negligible t"
   (REWRITE_TAC [real_negligible] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"IMAGE lift s") THEN ASM_SIMP_TAC [IMAGE_SUBSET])

  let REAL_NEGLIGIBLE_DIFF ← prove
   r"!s t:real->bool. real_negligible s ==> real_negligible(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"s:real->bool") THEN ASM_REWRITE_TAC [SUBSET_DIFF])

  let REAL_NEGLIGIBLE_INTER ← prove
   r"!s t. real_negligible s \/ real_negligible t ==> real_negligible(s INTER t)"
   (MESON_TAC [REAL_NEGLIGIBLE_SUBSET, INTER_SUBSET])

  let REAL_NEGLIGIBLE_UNION ← prove
   r"!s t:real->bool.
       real_negligible s /\ real_negligible t ==> real_negligible (s UNION t)"
   (SIMP_TAC [NEGLIGIBLE_UNION, IMAGE_UNION, real_negligible])

  let REAL_NEGLIGIBLE_UNION_EQ ← prove
   r"!s t:real->bool.
        real_negligible (s UNION t) <=> real_negligible s /\ real_negligible t"
   (MESON_TAC [REAL_NEGLIGIBLE_UNION, SUBSET_UNION, REAL_NEGLIGIBLE_SUBSET])

  let REAL_NEGLIGIBLE_SING ← prove
   r"!a:real. real_negligible {a}"
   (REWRITE_TAC [real_negligible, NEGLIGIBLE_SING, IMAGE_CLAUSES])

  let REAL_NEGLIGIBLE_INSERT ← prove
   r"!a:real s. real_negligible(a INSERT s) <=> real_negligible s"
   (REWRITE_TAC [real_negligible, NEGLIGIBLE_INSERT, IMAGE_CLAUSES])

  let REAL_NEGLIGIBLE_EMPTY ← prove
   r"real_negligible {}"
   (REWRITE_TAC [real_negligible, NEGLIGIBLE_EMPTY, IMAGE_CLAUSES])

  let REAL_NEGLIGIBLE_FINITE ← prove
   r"!s. FINITE s ==> real_negligible s"
   (MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [REAL_NEGLIGIBLE_EMPTY, REAL_NEGLIGIBLE_INSERT])

  let REAL_NEGLIGIBLE_UNIONS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> real_negligible t)
       ==> real_negligible(UNIONS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, UNIONS_INSERT, REAL_NEGLIGIBLE_EMPTY, IN_INSERT] THEN
    SIMP_TAC [REAL_NEGLIGIBLE_UNION])

  let REAL_OPEN_NOT_REAL_NEGLIGIBLE ← prove
   r"!s. real_open s /\ ~(s = {}) ==> ~real_negligible s"
   (GEN_TAC THEN REWRITE_TAC [REAL_OPEN, real_negligible] THEN
    MESON_TAC [OPEN_NOT_NEGLIGIBLE, IMAGE_EQ_EMPTY])

  let HAS_REAL_INTEGRAL_SPIKE_FINITE ← prove
   r"!f:real->real g s t y.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x) /\
        (f has_real_integral y) t
        ==> (g has_real_integral y) t"
   (MESON_TAC [HAS_REAL_INTEGRAL_SPIKE, REAL_NEGLIGIBLE_FINITE])

  let HAS_REAL_INTEGRAL_SPIKE_FINITE_EQ ← prove
   r"!f:real->real g s y.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> ((f has_real_integral y) t <=> (g has_real_integral y) t)"
   (MESON_TAC [HAS_REAL_INTEGRAL_SPIKE_FINITE])

  let REAL_INTEGRABLE_SPIKE_FINITE ← prove
   r"!f:real->real g s.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> f real_integrable_on t
            ==> g real_integrable_on  t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [real_integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_REAL_INTEGRAL_SPIKE_FINITE) THEN ASM_REWRITE_TAC [])

  pure { HAS_REAL_INTEGRAL_BOUND, HAS_REAL_INTEGRAL_LE, REAL_INTEGRAL_LE,
         HAS_REAL_INTEGRAL_POS, REAL_INTEGRAL_POS, HAS_REAL_INTEGRAL_ISNEG,
         HAS_REAL_INTEGRAL_LBOUND, HAS_REAL_INTEGRAL_UBOUND, REAL_INTEGRAL_LBOUND,
         REAL_INTEGRAL_UBOUND, REAL_INTEGRABLE_UNIFORM_LIMIT, HAS_REAL_INTEGRAL_NEGLIGIBLE,
         HAS_REAL_INTEGRAL_SPIKE, HAS_REAL_INTEGRAL_SPIKE_EQ, REAL_INTEGRABLE_SPIKE,
         REAL_INTEGRABLE_SPIKE_EQ, REAL_INTEGRAL_SPIKE, REAL_NEGLIGIBLE_SUBSET,
         REAL_NEGLIGIBLE_DIFF, REAL_NEGLIGIBLE_INTER, REAL_NEGLIGIBLE_UNION,
         REAL_NEGLIGIBLE_UNION_EQ, REAL_NEGLIGIBLE_SING, REAL_NEGLIGIBLE_INSERT,
         REAL_NEGLIGIBLE_EMPTY, REAL_NEGLIGIBLE_FINITE, REAL_NEGLIGIBLE_UNIONS,
         REAL_OPEN_NOT_REAL_NEGLIGIBLE, HAS_REAL_INTEGRAL_SPIKE_FINITE,
         HAS_REAL_INTEGRAL_SPIKE_FINITE_EQ, REAL_INTEGRABLE_SPIKE_FINITE }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions (part 4: interiors, FTC, combining,     -/
/- affinity, reflection).                                                    -/
/- (realanalysis.ml 9114-9409)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAN where
  REAL_NEGLIGIBLE_FRONTIER_INTERVAL : thm
  HAS_REAL_INTEGRAL_SPIKE_INTERIOR : thm
  HAS_REAL_INTEGRAL_SPIKE_INTERIOR_EQ : thm
  REAL_INTEGRABLE_SPIKE_INTERIOR : thm
  REAL_INTEGRAL_EQ : thm
  REAL_INTEGRAL_EQ_0 : thm
  REAL_INTEGRABLE_CONTINUOUS : thm
  REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS : thm
  REAL_INTEGRABLE_SUBINTERVAL : thm
  HAS_REAL_INTEGRAL_COMBINE : thm
  REAL_INTEGRAL_COMBINE : thm
  REAL_INTEGRABLE_COMBINE : thm
  REAL_INTEGRABLE_ON_LITTLE_SUBINTERVALS : thm
  REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE : thm
  REAL_INTEGRAL_HAS_REAL_DERIVATIVE : thm
  REAL_ANTIDERIVATIVE_CONTINUOUS : thm
  REAL_ANTIDERIVATIVE_INTEGRAL_CONTINUOUS : thm
  HAS_REAL_INTEGRAL_AFFINITY : thm
  REAL_INTEGRABLE_AFFINITY : thm
  HAS_REAL_INTEGRAL_STRETCH : thm
  REAL_INTEGRABLE_STRETCH : thm
  HAS_REAL_INTEGRAL_REFLECT_LEMMA : thm
  HAS_REAL_INTEGRAL_REFLECT : thm
  REAL_INTEGRABLE_REFLECT : thm
  REAL_INTEGRAL_REFLECT : thm
  HAS_REAL_INTEGRAL_REFLECT_GEN : thm
  REAL_INTEGRABLE_REFLECT_GEN : thm
  REAL_INTEGRAL_REFLECT_GEN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAN [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZL : RZL) (BRZN : RZN) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAM : RZAM) : ExceptT String IO RZAN := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { HAS_REAL_VECTOR_DERIVATIVE_WITHIN, .. } := BRZL
  let { CONTINUOUS_CONTINUOUS_WITHINREAL, HAS_REAL_DERIVATIVE_WITHIN_SUBSET,
        REAL_CONTINUOUS_CONTINUOUS1, .. } := BRZN
  let { has_real_integral, HAS_REAL_INTEGRAL, REAL_INTEGRABLE_INTEGRAL, real_integrable_on,
        REAL_INTEGRABLE_ON, REAL_INTEGRAL, real_integral, REAL_INTEGRAL_UNIQUE,
        .. } := BRZAK
  let { REAL_INTEGRAL_0, .. } := BRZAL
  let { HAS_REAL_INTEGRAL_SPIKE, REAL_INTEGRAL_SPIKE, REAL_NEGLIGIBLE_EMPTY,
        REAL_NEGLIGIBLE_FINITE, REAL_NEGLIGIBLE_SUBSET, .. } := BRZAM
  let { LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, INTERVAL_REAL_INTERVAL, REAL_INTERVAL_INTERVAL,
        .. } := D.qtopology
  let { IN_REAL_INTERVAL, real_interval, SUBSET_REAL_INTERVAL, .. } := D.qmisc
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS, HAS_INTEGRAL_COMBINE, HAS_INTEGRAL_REFLECT_LEMMA,
        INTEGRABLE_ON_LITTLE_SUBINTERVALS, .. } := D.qintegration
  let { HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN, .. } := D.ts.cn.ms.qderivatives
  let { HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_REFLECT_GEN, INTEGRABLE_CONTINUOUS,
        INTEGRABLE_SUBINTERVAL, .. } := D.ts.cn.ms.qintegration2
  let { integrable_on, INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE,
        .. } := D.ts.cn.ms.qintegration3
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC,
        .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { NORM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { DIFF, DIMINDEX_1, EQ_IMP, EQ_TRANS, ETA_AX, FINITE_RULES,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_o, IMAGE_SUBSET, IMP_CONJ,
        IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_SUB,
        REAL_ADD_RID, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, REAL_LT_01, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NEG_NEG, REAL_SUB_RZERO, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, EXISTS_DROP, EXISTS_LIFT, FORALL_LIFT,
        LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { dist, drop, .. } := D.ts.cn.cx.cvx.vec4
  let { IN_BALL, IN_INTERVAL_1, .. } := D.ts.cn.cx.cvx.top4
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  let { DROP_NEG, .. } := D.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  let REAL_NEGLIGIBLE_FRONTIER_INTERVAL ← prove
   r"!a b:real. real_negligible(real_interval[a,b] DIFF real_interval(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_interval, DIFF, IN_ELIM_THM] THEN
    MATCH_MP_TAC REAL_NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{(a:real),b}") THEN
    ASM_SIMP_TAC [REAL_NEGLIGIBLE_FINITE, FINITE_RULES] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INSERT, NOT_IN_EMPTY] THEN
    REAL_ARITH_TAC)

  let HAS_REAL_INTEGRAL_SPIKE_INTERIOR ← prove
   r"!f:real->real g a b y.
        (!x. x IN real_interval(a,b) ==> g x = f x) /\
        (f has_real_integral y) (real_interval[a,b])
        ==> (g has_real_integral y) (real_interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                             HAS_REAL_INTEGRAL_SPIKE) THEN
    EXISTS_TAC (← q r"real_interval[a:real,b] DIFF real_interval(a,b)") THEN
    REWRITE_TAC [REAL_NEGLIGIBLE_FRONTIER_INTERVAL] THEN ASM SET_TAC [])

  let HAS_REAL_INTEGRAL_SPIKE_INTERIOR_EQ ← prove
   r"!f:real->real g a b y.
        (!x. x IN real_interval(a,b) ==> g x = f x)
        ==> ((f has_real_integral y) (real_interval[a,b]) <=>
             (g has_real_integral y) (real_interval[a,b]))"
   (MESON_TAC [HAS_REAL_INTEGRAL_SPIKE_INTERIOR])

  let REAL_INTEGRABLE_SPIKE_INTERIOR ← prove
   r"!f:real->real g a b.
        (!x. x IN real_interval(a,b) ==> g x = f x)
        ==> f real_integrable_on (real_interval[a,b])
            ==> g real_integrable_on  (real_interval[a,b])"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [real_integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_REAL_INTEGRAL_SPIKE_INTERIOR) THEN ASM_REWRITE_TAC [])

  let REAL_INTEGRAL_EQ ← prove
   r"!f g s.
        (!x. x IN s ==> f x = g x) ==> real_integral s f = real_integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_SPIKE THEN
    EXISTS_TAC (← q r"{}:real->bool") THEN
    ASM_SIMP_TAC [REAL_NEGLIGIBLE_EMPTY, IN_DIFF])

  let REAL_INTEGRAL_EQ_0 ← prove
   r"!f s. (!x. x IN s ==> f x = &0) ==> real_integral s f = &0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"real_integral s (\x. &0)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRAL_EQ THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [REAL_INTEGRAL_0]])

  let REAL_INTEGRABLE_CONTINUOUS ← prove
   r"!f a b.
        f real_continuous_on real_interval[a,b]
        ==> f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, real_integrable_on, has_real_integral,
                 ← GSYM integrable_on, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, INTEGRABLE_CONTINUOUS])

  let REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS ← prove
   r"!f f' a b.
        a <= b /\
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))
                 (atreal x within real_interval[a,b]))
        ==> (f' has_real_integral (f(b) - f(a))) (real_interval[a,b])"
   (REWRITE_TAC [has_real_integral, HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_SUB] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, LIFT_DROP] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o BINOP_CONV) [← GSYM LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let REAL_INTEGRABLE_SUBINTERVAL ← prove
   r"!f:real->real a b c d.
        f real_integrable_on real_interval[a,b] /\
        real_interval[c,d] SUBSET real_interval[a,b]
        ==> f real_integrable_on real_interval[c,d]"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL] THEN
    REWRITE_TAC [EXISTS_DROP, ← GSYM integrable_on, LIFT_DROP] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"lift a", ← q r"lift b"] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    ASM_SIMP_TAC [IMAGE_SUBSET])

  let HAS_REAL_INTEGRAL_COMBINE ← prove
   r"!f i j a b c.
        a <= c /\ c <= b /\
        (f has_real_integral i) (real_interval[a,c]) /\
        (f has_real_integral j) (real_interval[c,b])
        ==> (f has_real_integral (i + j)) (real_interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_INTEGRAL, LIFT_ADD] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN
    EXISTS_TAC (← q r"lift c") THEN ASM_REWRITE_TAC [LIFT_DROP])

  let REAL_INTEGRAL_COMBINE ← prove
   r"!f a b c.
        a <= c /\ c <= b /\ f real_integrable_on (real_interval[a,b])
        ==> real_integral(real_interval[a,c]) f +
            real_integral(real_interval[c,b]) f =
            real_integral(real_interval[a,b]) f"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_COMBINE THEN
    EXISTS_TAC (← q r"c:real") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
    MATCH_MP_TAC REAL_INTEGRABLE_INTEGRAL THEN
    MATCH_MP_TAC REAL_INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_REWRITE_TAC [SUBSET_REAL_INTERVAL, REAL_LE_REFL])

  let REAL_INTEGRABLE_COMBINE ← prove
   r"!f a b c.
        a <= c /\ c <= b /\
        f real_integrable_on real_interval[a,c] /\
        f real_integrable_on real_interval[c,b]
        ==> f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_COMBINE])

  let REAL_INTEGRABLE_ON_LITTLE_SUBINTERVALS ← prove
   r"!f:real->real a b.
        (!x. x IN real_interval[a,b]
             ==> ?d. &0 < d /\
                     !u v. x IN real_interval[u,v] /\
                           (!y. y IN real_interval[u,v]
                                ==> abs(y - x) < d /\ y IN real_interval[a,b])
                           ==> f real_integrable_on real_interval[u,v])
        ==> f real_integrable_on real_interval[a,b]"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL, EXISTS_DROP,
                 ← GSYM integrable_on, LIFT_DROP] THEN
    DISCH_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_LITTLE_SUBINTERVALS THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM EXISTS_DROP, FORALL_LIFT] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_IN_IMAGE_LIFT],
      REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"y:real^1") THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^1") o REWRITE_RULE [SUBSET])) THEN
      ASM_SIMP_TAC [IN_BALL, FUN_IN_IMAGE, dist, NORM_REAL] THEN
      REWRITE_TAC [← GSYM drop, DROP_SUB, LIFT_DROP] THEN SIMP_TAC [REAL_ABS_SUB]])

  let REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE ← prove
   r"!f a b x.
        f real_integrable_on real_interval[a,b] /\ x IN real_interval[a,b] /\
        f real_continuous (atreal x within real_interval[a,b])
        ==> ((\u. real_integral(real_interval[a,u]) f)
                   has_real_derivative f(x))
                 (atreal x within real_interval[a,b])"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1, IMAGE_LIFT_REAL_INTERVAL,
                 REAL_INTEGRABLE_ON, CONTINUOUS_CONTINUOUS_WITHINREAL,
                 HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, IN_IMAGE_LIFT_DROP, ← GSYM o_ASSOC] THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT
      (← q r"a /\ b /\ c /\ d ==> e <=> a /\ b /\ c ==> d ==> e")]
       HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN) THEN
    EXISTS_TAC (← q r"&1") THEN ASM_REWRITE_TAC [REAL_LT_01] THEN
    X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
    REWRITE_TAC [LIFT_DROP] THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, ← GSYM IMAGE_o, LIFT_DROP, o_DEF] THEN
    REWRITE_TAC [← GSYM o_DEF, ← SET_RULE (← q r"IMAGE (\x. x) s = s")] THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN
    MATCH_MP_TAC REAL_INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
    REWRITE_TAC [LIFT_DROP] THEN REAL_ARITH_TAC)

  let REAL_INTEGRAL_HAS_REAL_DERIVATIVE ← prove
   r"!f:real->real a b.
     f real_continuous_on real_interval[a,b]
     ==> !x. x IN real_interval[a,b]
             ==> ((\u. real_integral(real_interval[a,u]) f)
                  has_real_derivative f(x))
                 (atreal x within real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE THEN
    ASM_MESON_TAC [REAL_INTEGRABLE_CONTINUOUS,
                   REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN])

  let REAL_ANTIDERIVATIVE_CONTINUOUS ← prove
   r"!f a b.
     (f real_continuous_on real_interval[a,b])
     ==> ?g. !x. x IN real_interval[a,b]
                 ==> (g has_real_derivative f(x))
                     (atreal x within real_interval[a,b])"
   (MESON_TAC [REAL_INTEGRAL_HAS_REAL_DERIVATIVE])

  let REAL_ANTIDERIVATIVE_INTEGRAL_CONTINUOUS ← prove
   r"!f a b.
     (f real_continuous_on real_interval[a,b])
     ==> ?g. !u v. u IN real_interval[a,b] /\
                   v IN real_interval[a,b] /\ u <= v
                   ==> (f has_real_integral (g(v) - g(u)))
                       (real_interval[u,v])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP REAL_ANTIDERIVATIVE_CONTINUOUS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real->real") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real") THEN
    STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"real_interval[a:real,b]") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC, ALL_TAC] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [SUBSET_REAL_INTERVAL, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let HAS_REAL_INTEGRAL_AFFINITY ← prove
   r"!f:real->real i a b m c.
        (f has_real_integral i) (real_interval[a,b]) /\ ~(m = &0)
        ==> ((\x. f(m * x + c)) has_real_integral (inv(abs(m)) * i))
            (IMAGE (\x. inv m * (x - c)) (real_interval[a,b]))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_INTEGRAL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"lift c") o MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
    REWRITE_TAC [DIMINDEX_1, REAL_POW_1, has_real_integral] THEN
    REWRITE_TAC [o_DEF, DROP_ADD, DROP_CMUL, LIFT_DROP, LIFT_CMUL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, ← GSYM IMAGE_o, LIFT_DROP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_DEF, LIFT_CMUL, LIFT_SUB] THEN VECTOR_ARITH_TAC)

  let REAL_INTEGRABLE_AFFINITY ← prove
   r"!f a b m c.
        f real_integrable_on real_interval[a,b] /\ ~(m = &0)
        ==> (\x. f(m * x + c)) real_integrable_on
            (IMAGE (\x. inv m * (x - c)) (real_interval[a,b]))"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_AFFINITY])

  let HAS_REAL_INTEGRAL_STRETCH ← prove
   r"!f:real->real i a b m.
        (f has_real_integral i) (real_interval[a,b]) /\ ~(m = &0)
        ==> ((\x. f(m * x)) has_real_integral (inv(abs(m)) * i))
            (IMAGE (\x. inv m * x) (real_interval[a,b]))"
   (MP_TAC HAS_REAL_INTEGRAL_AFFINITY THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&0")) THEN
    REWRITE_TAC [REAL_ADD_RID, REAL_SUB_RZERO])

  let REAL_INTEGRABLE_STRETCH ← prove
   r"!f a b m.
        f real_integrable_on real_interval[a,b] /\ ~(m = &0)
        ==> (\x. f(m * x)) real_integrable_on
            (IMAGE (\x. inv m * x) (real_interval[a,b]))"
   (REWRITE_TAC [real_integrable_on] THEN MESON_TAC [HAS_REAL_INTEGRAL_STRETCH])

  let HAS_REAL_INTEGRAL_REFLECT_LEMMA ← prove
   r"!f:real->real i a b.
     (f has_real_integral i) (real_interval[a,b])
     ==> ((\x. f(--x)) has_real_integral i) (real_interval[--b,--a])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_INTEGRAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_REFLECT_LEMMA) THEN
    REWRITE_TAC [LIFT_NEG, o_DEF, DROP_NEG])

  let HAS_REAL_INTEGRAL_REFLECT ← prove
   r"!f:real->real i a b.
     ((\x. f(--x)) has_real_integral i) (real_interval[--b,--a]) <=>
     (f has_real_integral i) (real_interval[a,b])"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_REFLECT_LEMMA) THEN
    REWRITE_TAC [REAL_NEG_NEG, ETA_AX])

  let REAL_INTEGRABLE_REFLECT ← prove
   r"!f:real->real a b.
     (\x. f(--x)) real_integrable_on (real_interval[--b,--a]) <=>
     f real_integrable_on (real_interval[a,b])"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL_REFLECT])

  let REAL_INTEGRAL_REFLECT ← prove
   r"!f:real->real a b.
     real_integral (real_interval[--b,--a]) (\x. f(--x)) =
     real_integral (real_interval[a,b]) f"
   (REWRITE_TAC [real_integral, HAS_REAL_INTEGRAL_REFLECT])

  let HAS_REAL_INTEGRAL_REFLECT_GEN ← prove
   r"!f i s. ((\x. f(--x)) has_real_integral i) s <=>
           (f has_real_integral i) (IMAGE (--) s)"
   (REWRITE_TAC [has_real_integral, o_DEF, ← GSYM DROP_NEG,
                 HAS_INTEGRAL_REFLECT_GEN, ← GSYM IMAGE_o, ← GSYM LIFT_NEG])

  let REAL_INTEGRABLE_REFLECT_GEN ← prove
   r"!f s. (\x. f(--x)) real_integrable_on s <=>
         f real_integrable_on (IMAGE (--) s)"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL_REFLECT_GEN])

  let REAL_INTEGRAL_REFLECT_GEN ← prove
   r"!f s. real_integral s (\x. f(--x)) = real_integral (IMAGE (--) s) f"
   (REWRITE_TAC [real_integral, HAS_REAL_INTEGRAL_REFLECT_GEN])

  pure { REAL_NEGLIGIBLE_FRONTIER_INTERVAL, HAS_REAL_INTEGRAL_SPIKE_INTERIOR,
         HAS_REAL_INTEGRAL_SPIKE_INTERIOR_EQ, REAL_INTEGRABLE_SPIKE_INTERIOR,
         REAL_INTEGRAL_EQ, REAL_INTEGRAL_EQ_0, REAL_INTEGRABLE_CONTINUOUS,
         REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, REAL_INTEGRABLE_SUBINTERVAL,
         HAS_REAL_INTEGRAL_COMBINE, REAL_INTEGRAL_COMBINE, REAL_INTEGRABLE_COMBINE,
         REAL_INTEGRABLE_ON_LITTLE_SUBINTERVALS,
         REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE, REAL_INTEGRAL_HAS_REAL_DERIVATIVE,
         REAL_ANTIDERIVATIVE_CONTINUOUS, REAL_ANTIDERIVATIVE_INTEGRAL_CONTINUOUS,
         HAS_REAL_INTEGRAL_AFFINITY, REAL_INTEGRABLE_AFFINITY, HAS_REAL_INTEGRAL_STRETCH,
         REAL_INTEGRABLE_STRETCH, HAS_REAL_INTEGRAL_REFLECT_LEMMA,
         HAS_REAL_INTEGRAL_REFLECT, REAL_INTEGRABLE_REFLECT, REAL_INTEGRAL_REFLECT,
         HAS_REAL_INTEGRAL_REFLECT_GEN, REAL_INTEGRABLE_REFLECT_GEN,
         REAL_INTEGRAL_REFLECT_GEN }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions (part 5: strong FTC, indefinite         -/
/- integrals, restriction, spike sets).                                      -/
/- (realanalysis.ml 9410-9655)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAO where
  REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR : thm
  REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG : thm
  REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG : thm
  REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT : thm
  REAL_INDEFINITE_INTEGRAL_CONTINUOUS_LEFT : thm
  HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL : thm
  HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX : thm
  HAS_REAL_DERIVATIVE_INDEFINITE_INTEGRAL : thm
  REAL_ABSOLUTE_INTEGRAL_IMP_AE_DERIVATIVE : thm
  HAS_REAL_INTEGRAL_RESTRICT : thm
  HAS_REAL_INTEGRAL_RESTRICT_UNIV : thm
  HAS_REAL_INTEGRAL_SPIKE_SET_EQ : thm
  HAS_REAL_INTEGRAL_SPIKE_SET : thm
  REAL_INTEGRABLE_SPIKE_SET : thm
  REAL_INTEGRABLE_SPIKE_SET_EQ : thm
  REAL_INTEGRAL_SPIKE_SET : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAO [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZL : RZL) (BRZM : RZM) (BRZAK : RZAK) (BRZAM : RZAM) (BRZAN : RZAN) : ExceptT String IO RZAO := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { HAS_REAL_VECTOR_DERIVATIVE_AT, HAS_REAL_VECTOR_DERIVATIVE_WITHIN, .. } := BRZL
  let { IS_REALINTERVAL_CONVEX, .. } := BRZM
  let { ABSOLUTELY_REAL_INTEGRABLE_ON, has_real_integral, HAS_REAL_INTEGRAL,
        REAL_INTEGRABLE_ON, real_integrable_on, REAL_INTEGRAL, real_integral,
        real_negligible, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_SPIKE_EQ, .. } := BRZAM
  let { REAL_INTEGRABLE_SUBINTERVAL, .. } := BRZAN
  let { EXISTS_DROP_IMAGE, IMAGE_LIFT_DROP, LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, INTERVAL_REAL_INTERVAL, REAL_INTERVAL_INTERVAL,
        .. } := D.qtopology
  let { IN_REAL_INTERVAL, SUBSET_REAL_INTERVAL, .. } := D.qmisc
  let { ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT,
        HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL, .. } := D.qmeasure
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR,
        FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG,
        HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX,
        HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL, HAS_INTEGRAL_RESTRICT,
        INDEFINITE_INTEGRAL_CONTINUOUS_LEFT, .. } := D.qintegration
  let { HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN, .. } := D.ts.cn.ms.qderivatives
  let { INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, .. } := D.ts.cn.ms.qintegration2
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { has_vector_derivative, .. } := D.ts.cn.ms.ig.qderivatives
  let { COND_RAND, CONJ_ASSOC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_IMP, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_IMAGE, MONO_EXISTS, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LT_01, .. } := D.ts.cn.cx.cvx.core4
  let { o_DEF, o_THM, SUBSET_UNIV, UNION_COMM, UNWIND_THM1, .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ts.cn.cx.cvx.lib
  let { DROP_EQ, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { VECTOR_MUL_RZERO, .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_EQ, .. } := D.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, .. } := D.ts.cn.cx.cvx.top4
  -- @@SCOPE END

  let REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR ← prove
   r"!f:real->real f' a b.
        a <= b /\ f real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b)
             ==> (f has_real_derivative f'(x)) (atreal x))
        ==> (f' has_real_integral (f(b) - f(a))) (real_interval[a,b])"
   (REWRITE_TAC [has_real_integral, HAS_REAL_VECTOR_DERIVATIVE_AT] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_SUB] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, LIFT_DROP] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o BINOP_CONV) [← GSYM LIFT_DROP] THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG ← prove
   r"!f f' s a b.
        COUNTABLE s /\
        a <= b /\ f real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) DIFF s
             ==> (f has_real_derivative f'(x)) (atreal x))
        ==> (f' has_real_integral (f(b) - f(a))) (real_interval[a,b])"
   (REWRITE_TAC [has_real_integral, HAS_REAL_VECTOR_DERIVATIVE_AT] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_SUB] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF] THEN
    SUBGOAL_THEN (← q r"!x. drop x IN s <=> x IN IMAGE lift s")
      (fun th => REWRITE_TAC [th]) THENL [SET_TAC [LIFT_DROP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"COUNTABLE s <=> COUNTABLE(IMAGE lift s)") SUBST1_TAC THENL
     [EQ_TAC THEN SIMP_TAC [COUNTABLE_IMAGE] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"drop") o MATCH_MP COUNTABLE_IMAGE) THEN
      REWRITE_TAC [← GSYM IMAGE_o, IMAGE_LIFT_DROP],
      ALL_TAC] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM IN_DIFF, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV o BINOP_CONV)
     [← GSYM LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o
      MATCH_MP FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG ← prove
   r"!f f' s a b.
        COUNTABLE s /\
        a <= b /\ f real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b] DIFF s
             ==> (f has_real_derivative f'(x)) (atreal x))
        ==> (f' has_real_integral (f(b) - f(a))) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG THEN
    EXISTS_TAC (← q r"s:real->bool") THEN ASM_REWRITE_TAC [] THEN GEN_TAC THEN
    DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
    SIMP_TAC [IN_REAL_INTERVAL, IN_DIFF] THEN REAL_ARITH_TAC)

  let REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT ← prove
   r"!f:real->real a b.
        f real_integrable_on real_interval[a,b]
        ==> (\x. real_integral (real_interval[a,x]) f)
            real_continuous_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_CONTINUOUS_ON] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_INTEGRABLE_ON]) THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_EQ) THEN
    GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [o_DEF] THEN
    GEN_REWRITE_TAC id [← GSYM DROP_EQ] THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, LIFT_DROP, ← GSYM o_DEF] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC REAL_INTEGRAL THEN
    MATCH_MP_TAC REAL_INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
    REWRITE_TAC [LIFT_DROP] THEN REAL_ARITH_TAC)

  let REAL_INDEFINITE_INTEGRAL_CONTINUOUS_LEFT ← prove
   r"!f:real->real a b.
        f real_integrable_on real_interval[a,b]
        ==> (\x. real_integral (real_interval[x,b]) f)
            real_continuous_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_CONTINUOUS_ON] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_INTEGRABLE_ON]) THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INDEFINITE_INTEGRAL_CONTINUOUS_LEFT) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_EQ) THEN
    GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [o_DEF] THEN
    GEN_REWRITE_TAC id [← GSYM DROP_EQ] THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, LIFT_DROP, ← GSYM o_DEF] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC REAL_INTEGRAL THEN
    MATCH_MP_TAC REAL_INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
    REWRITE_TAC [LIFT_DROP] THEN REAL_ARITH_TAC)

  let HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL ← prove
   r"!f:real->real a b k y.
        COUNTABLE k /\ f real_continuous_on real_interval[a,b] /\ f a = y /\
        (!x. x IN (real_interval[a,b] DIFF k)
             ==> (f has_real_derivative &0)
                 (atreal x within real_interval[a,b]))
        ==> !x. x IN real_interval[a,b] ==> f x = y"
   (REWRITE_TAC [has_real_integral, HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_SUB] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF] THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, IMP_IMP, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [← GSYM IMP_CONJ, LIFT_DROP, has_vector_derivative] THEN
    REWRITE_TAC [LIFT_NUM, VECTOR_MUL_RZERO] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"IMAGE lift k",
      ← q r"lift y"]
     HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, o_THM, LIFT_DROP, LIFT_EQ, IN_DIFF] THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [LIFT_DROP])

  let HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX ← prove
   r"!f:real->real s k c y.
      is_realinterval s /\ COUNTABLE k /\ f real_continuous_on s /\
      c IN s /\ f c = y /\
      (!x. x IN (s DIFF k) ==> (f has_real_derivative &0) (atreal x within s))
      ==> !x. x IN s ==> f x = y"
   (REWRITE_TAC [has_real_integral, HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    REWRITE_TAC [IS_REALINTERVAL_CONVEX, REAL_CONTINUOUS_ON] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, LIFT_SUB] THEN
    REWRITE_TAC [REAL_INTERVAL_INTERVAL, FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF] THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON, IMP_IMP, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [← GSYM IMP_CONJ, LIFT_DROP, has_vector_derivative] THEN
    REWRITE_TAC [LIFT_NUM, VECTOR_MUL_RZERO] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"IMAGE lift s", ← q r"IMAGE lift k", ← q r"lift c",
      ← q r"lift y"]
     HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, o_THM, LIFT_DROP, LIFT_EQ, IN_DIFF] THEN
    ASM_REWRITE_TAC [LIFT_IN_IMAGE_LIFT, FORALL_IN_IMAGE, LIFT_DROP] THEN
    ASM_SIMP_TAC [IMP_CONJ, FORALL_IN_IMAGE, LIFT_IN_IMAGE_LIFT])

  let HAS_REAL_DERIVATIVE_INDEFINITE_INTEGRAL ← prove
   r"!f a b.
        f real_integrable_on real_interval[a,b]
        ==> ?k. real_negligible k /\
                !x. x IN real_interval[a,b] DIFF k
                    ==> ((\x. real_integral(real_interval[a,x]) f)
                         has_real_derivative
                         f(x)) (atreal x within real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b"]
          HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL) THEN
    ASM_REWRITE_TAC [← GSYM REAL_INTEGRABLE_ON, ← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [IN_DIFF, FORALL_IN_IMAGE, IMP_CONJ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE drop k") THEN
    ASM_REWRITE_TAC [real_negligible, HAS_REAL_VECTOR_DERIVATIVE_WITHIN] THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [IN_IMAGE, ← GSYM LIFT_EQ, LIFT_DROP, UNWIND_THM1] THEN
    X_GEN_TAC (← q r"x:real") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [o_THM, LIFT_DROP] THEN MATCH_MP_TAC (← REWRITE_RULE
     [← TAUT (← q r"a /\ b /\ c /\ d ==> e <=> a /\ b /\ c ==> d ==> e")]
          HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN) THEN
    EXISTS_TAC (← q r"&1") THEN ASM_SIMP_TAC [FUN_IN_IMAGE, REAL_LT_01] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"y:real") THEN REPEAT DISCH_TAC THEN
    REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, o_THM] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN
    MATCH_MP_TAC REAL_INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
    ASM_REAL_ARITH_TAC)

  let REAL_ABSOLUTE_INTEGRAL_IMP_AE_DERIVATIVE ← prove
   r"!f f' a b.
        f' absolutely_real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b]
             ==> (f' has_real_integral f x - f a) (real_interval [a,x]))
        ==> ?s. real_negligible s /\
                !x. x IN real_interval [a,b] DIFF s
                    ==> (f has_real_derivative f' x) (atreal x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL, ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    STRIP_TAC THEN MP_TAC (← EQ_IMP_RULE (← ISPECL
      [← q r"lift o f o drop", ← q r"lift o f' o drop", ← q r"lift a", ← q r"lift b"]
      ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT)).1 THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, ← GSYM LIFT_SUB],
      DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
    REWRITE_TAC [real_negligible, HAS_REAL_VECTOR_DERIVATIVE_AT] THEN
    REWRITE_TAC [EXISTS_DROP_IMAGE, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REWRITE_TAC [IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    SIMP_TAC [IN_IMAGE_LIFT_DROP, o_DEF, LIFT_DROP])

  let HAS_REAL_INTEGRAL_RESTRICT ← prove
   r"!f:real->real s t.
        s SUBSET t
        ==> (((\x. if x IN s then f x else &0) has_real_integral i) t <=>
             (f has_real_integral i) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_real_integral, o_DEF] THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s", ← q r"IMAGE lift t",
                      ← q r"lift i"]
          HAS_INTEGRAL_RESTRICT) THEN
    ASM_SIMP_TAC [IMAGE_SUBSET, IN_IMAGE_LIFT_DROP, o_DEF] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN REWRITE_TAC [LIFT_NUM])

  let HAS_REAL_INTEGRAL_RESTRICT_UNIV ← prove
   r"!f:real->real s i.
        ((\x. if x IN s then f x else &0) has_real_integral i) (:real) <=>
         (f has_real_integral i) s"
   (SIMP_TAC [HAS_REAL_INTEGRAL_RESTRICT, SUBSET_UNIV])

  let HAS_REAL_INTEGRAL_SPIKE_SET_EQ ← prove
   r"!f s t y.
        real_negligible(s DIFF t UNION t DIFF s)
        ==> ((f has_real_integral y) s <=> (f has_real_integral y) t)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_RESTRICT_UNIV] THEN
    MATCH_MP_TAC HAS_REAL_INTEGRAL_SPIKE_EQ THEN
    EXISTS_TAC (← q r"s DIFF t UNION t DIFF s:real->bool") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let HAS_REAL_INTEGRAL_SPIKE_SET ← prove
   r"!f s t y.
        real_negligible(s DIFF t UNION t DIFF s) /\
        (f has_real_integral y) s
        ==> (f has_real_integral y) t"
   (MESON_TAC [HAS_REAL_INTEGRAL_SPIKE_SET_EQ])

  let REAL_INTEGRABLE_SPIKE_SET ← prove
   r"!f s t.
        real_negligible(s DIFF t UNION t DIFF s)
        ==> f real_integrable_on s ==> f real_integrable_on t"
   (REWRITE_TAC [real_integrable_on] THEN
    MESON_TAC [HAS_REAL_INTEGRAL_SPIKE_SET_EQ])

  let REAL_INTEGRABLE_SPIKE_SET_EQ ← prove
   r"!f s t.
        real_negligible(s DIFF t UNION t DIFF s)
        ==> (f real_integrable_on s <=> f real_integrable_on t)"
   (MESON_TAC [REAL_INTEGRABLE_SPIKE_SET, UNION_COMM])

  let REAL_INTEGRAL_SPIKE_SET ← prove
   r"!f s t.
        real_negligible(s DIFF t UNION t DIFF s)
        ==> real_integral s f = real_integral t f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_integral] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_SPIKE_SET_EQ THEN
    ASM_MESON_TAC [])

  pure { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR,
         REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG,
         REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG,
         REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT,
         REAL_INDEFINITE_INTEGRAL_CONTINUOUS_LEFT,
         HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL,
         HAS_REAL_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX,
         HAS_REAL_DERIVATIVE_INDEFINITE_INTEGRAL, REAL_ABSOLUTE_INTEGRAL_IMP_AE_DERIVATIVE,
         HAS_REAL_INTEGRAL_RESTRICT, HAS_REAL_INTEGRAL_RESTRICT_UNIV,
         HAS_REAL_INTEGRAL_SPIKE_SET_EQ, HAS_REAL_INTEGRAL_SPIKE_SET,
         REAL_INTEGRABLE_SPIKE_SET, REAL_INTEGRABLE_SPIKE_SET_EQ, REAL_INTEGRAL_SPIKE_SET }
/- ------------------------------------------------------------------------- -/
/- Integrals of real->real functions (part 6: open intervals, supersets,     -/
/- restriction to intersections, straddling, unions).                        -/
/- (realanalysis.ml 9656-9882)                                              -/
/- ------------------------------------------------------------------------- -/

structure RZAP where
  HAS_REAL_INTEGRAL_OPEN_INTERVAL : thm
  REAL_INTEGRABLE_ON_OPEN_INTERVAL : thm
  REAL_INTEGRAL_OPEN_INTERVAL : thm
  HAS_REAL_INTEGRAL_ON_SUPERSET : thm
  REAL_INTEGRABLE_ON_SUPERSET : thm
  REAL_INTEGRABLE_RESTRICT_UNIV : thm
  REAL_INTEGRAL_RESTRICT_UNIV : thm
  REAL_INTEGRAL_RESTRICT : thm
  HAS_REAL_INTEGRAL_RESTRICT_INTER : thm
  REAL_INTEGRAL_RESTRICT_INTER : thm
  REAL_INTEGRABLE_RESTRICT_INTER : thm
  REAL_NEGLIGIBLE_ON_INTERVALS : thm
  HAS_REAL_INTEGRAL_SUBSET_LE : thm
  REAL_INTEGRAL_SUBSET_LE : thm
  REAL_INTEGRABLE_ON_SUBINTERVAL : thm
  REAL_INTEGRABLE_ON_SUBINTERVAL_GEN : thm
  REAL_INTEGRABLE_STRADDLE : thm
  HAS_REAL_INTEGRAL_STRADDLE_NULL : thm
  HAS_REAL_INTEGRAL_UNION : thm
  HAS_REAL_INTEGRAL_UNIONS : thm
  REAL_INDEFINITE_INTEGRAL_CONTINUOUS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAP [HolBase] (D : RealAnalysisDeps) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAM : RZAM) (BRZAO : RZAO) : ExceptT String IO RZAP := do
  -- @@SCOPE BEGIN
  let { has_real_integral, HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL,
        HAS_REAL_INTEGRAL_INTEGRAL, REAL_INTEGRABLE_INTEGRAL, real_integrable_on,
        REAL_INTEGRABLE_ON, real_integral, REAL_INTEGRAL, real_negligible, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_0, .. } := BRZAL
  let { HAS_REAL_INTEGRAL_LE, .. } := BRZAM
  let { HAS_REAL_INTEGRAL_RESTRICT, HAS_REAL_INTEGRAL_RESTRICT_UNIV, .. } := BRZAO
  let { IMAGE_LIFT_DROP, SUBSET_LIFT_IMAGE, .. } := D.qvectors
  let { IMAGE_LIFT_REAL_INTERVAL, IS_REALINTERVAL_IS_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { HAS_INTEGRAL_OPEN_INTERVAL, .. } := D.qmeasure
  let { INTEGRABLE_ON_SUBINTERVAL_GEN, .. } := D.qintegration
  let { HAS_INTEGRAL_UNION, HAS_INTEGRAL_UNIONS, INDEFINITE_INTEGRAL_CONTINUOUS,
        INTEGRABLE_ON_SUBINTERVAL, INTEGRABLE_STRADDLE, .. } := D.ts.cn.ms.qintegration2
  let { NEGLIGIBLE_ON_INTERVALS, .. } := D.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { IMAGE_UNIONS, .. } := D.ts.cn.ms.ig.qsession
  let { EQ_IMP, FINITE_IMAGE, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_o, IMAGE_SUBSET, IMAGE_UNION,
        IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, REAL_ABS_NUM,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_SUB_REFL, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_SUB, EXISTS_DROP, FORALL_LIFT, LIFT_ADD, LIFT_DROP, LIFT_EQ, LIFT_SUB, NORM_1,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { VSUM_IMAGE, .. } := D.ts.cn.cx.cvx.vec4
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let HAS_REAL_INTEGRAL_OPEN_INTERVAL ← prove
   r"!f a b y. (f has_real_integral y) (real_interval(a,b)) <=>
             (f has_real_integral y) (real_interval[a,b])"
   (REWRITE_TAC [has_real_integral, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [HAS_INTEGRAL_OPEN_INTERVAL])

  let REAL_INTEGRABLE_ON_OPEN_INTERVAL ← prove
   r"!f a b. f real_integrable_on real_interval(a,b) <=>
           f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL_OPEN_INTERVAL])

  let REAL_INTEGRAL_OPEN_INTERVAL ← prove
   r"!f a b. real_integral(real_interval(a,b)) f =
           real_integral(real_interval[a,b]) f"
   (REWRITE_TAC [real_integral, HAS_REAL_INTEGRAL_OPEN_INTERVAL])

  let HAS_REAL_INTEGRAL_ON_SUPERSET ← prove
   r"!f s t.
        (!x. ~(x IN s) ==> f x = &0) /\ s SUBSET t /\ (f has_real_integral i) s
        ==> (f has_real_integral i) t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUBSET] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ONCE_REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_RESTRICT_UNIV] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [])

  let REAL_INTEGRABLE_ON_SUPERSET ← prove
   r"!f s t.
        (!x. ~(x IN s) ==> f x = &0) /\ s SUBSET t /\ f real_integrable_on s
        ==> f real_integrable_on t"
   (REWRITE_TAC [real_integrable_on] THEN
    MESON_TAC [HAS_REAL_INTEGRAL_ON_SUPERSET])

  let REAL_INTEGRABLE_RESTRICT_UNIV ← prove
   r"!f s. (\x. if x IN s then f x else &0) real_integrable_on (:real) <=>
         f real_integrable_on s"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL_RESTRICT_UNIV])

  let REAL_INTEGRAL_RESTRICT_UNIV ← prove
   r"!f s.
     real_integral (:real) (\x. if x IN s then f x else &0) =
     real_integral s f"
   (REWRITE_TAC [real_integral, HAS_REAL_INTEGRAL_RESTRICT_UNIV])

  let REAL_INTEGRAL_RESTRICT ← prove
   r"!f s t.
        s SUBSET t
        ==> real_integral t (\x. if x IN s then f x else &0) =
            real_integral s f"
   (SIMP_TAC [real_integral, HAS_REAL_INTEGRAL_RESTRICT])

  let HAS_REAL_INTEGRAL_RESTRICT_INTER ← prove
   r"!f s t.
        ((\x. if x IN s then f x else &0) has_real_integral i) t <=>
        (f has_real_integral i) (s INTER t)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [IN_INTER] THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN MESON_TAC [])

  let REAL_INTEGRAL_RESTRICT_INTER ← prove
   r"!f s t.
        real_integral t (\x. if x IN s then f x else &0) =
        real_integral (s INTER t) f"
   (REWRITE_TAC [real_integral, HAS_REAL_INTEGRAL_RESTRICT_INTER])

  let REAL_INTEGRABLE_RESTRICT_INTER ← prove
   r"!f s t.
        (\x. if x IN s then f x else &0) real_integrable_on t <=>
        f real_integrable_on (s INTER t)"
   (REWRITE_TAC [real_integrable_on, HAS_REAL_INTEGRAL_RESTRICT_INTER])

  let REAL_NEGLIGIBLE_ON_INTERVALS ← prove
   r"!s. real_negligible s <=>
         !a b:real. real_negligible(s INTER real_interval[a,b])"
   (GEN_TAC THEN REWRITE_TAC [real_negligible] THEN
    GEN_REWRITE_TAC LAND_CONV [NEGLIGIBLE_ON_INTERVALS] THEN
    REWRITE_TAC [FORALL_LIFT, ← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN AP_TERM_TAC THEN SET_TAC [LIFT_DROP])

  let HAS_REAL_INTEGRAL_SUBSET_LE ← prove
   r"!f:real->real s t i j.
        s SUBSET t /\ (f has_real_integral i) s /\ (f has_real_integral j) t /\
        (!x. x IN t ==> &0 <= f x)
        ==> i <= j"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_LE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:real. if x IN s then f(x) else &0",
      ← q r"\x:real. if x IN t then f(x) else &0", ← q r"(:real)"] THEN
    ASM_REWRITE_TAC [HAS_REAL_INTEGRAL_RESTRICT_UNIV, IN_UNIV] THEN
    X_GEN_TAC (← q r"x:real") THEN
    REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC [REAL_LE_REFL]) THEN
    ASM SET_TAC [])

  let REAL_INTEGRAL_SUBSET_LE ← prove
   r"!f:real->real s t.
        s SUBSET t /\ f real_integrable_on s /\ f real_integrable_on t /\
        (!x. x IN t ==> &0 <= f(x))
        ==> real_integral s f <= real_integral t f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_INTEGRAL_SUBSET_LE THEN
    ASM_MESON_TAC [REAL_INTEGRABLE_INTEGRAL])

  let REAL_INTEGRABLE_ON_SUBINTERVAL ← prove
   r"!f:real->real s a b.
        f real_integrable_on s /\ real_interval[a,b] SUBSET s
        ==> f real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [REAL_INTEGRABLE_ON, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"IMAGE lift s") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    ASM_SIMP_TAC [IMAGE_SUBSET])

  let REAL_INTEGRABLE_ON_SUBINTERVAL_GEN ← prove
   r"!f s t. f real_integrable_on s /\ t SUBSET s /\ is_realinterval t
           ==> f real_integrable_on t"
   (REWRITE_TAC [REAL_INTEGRABLE_ON, IS_REALINTERVAL_IS_INTERVAL] THEN
    ONCE_REWRITE_TAC [← GSYM SUBSET_LIFT_IMAGE] THEN
    REWRITE_TAC [INTEGRABLE_ON_SUBINTERVAL_GEN])

  let REAL_INTEGRABLE_STRADDLE ← prove
   r"!f s.
        (!e. &0 < e
             ==> ?g h i j. (g has_real_integral i) s /\
                           (h has_real_integral j) s /\
                           abs(i - j) < e /\
                           !x. x IN s ==> g x <= f x /\ f x <= h x)
        ==> f real_integrable_on s"
   (REWRITE_TAC [REAL_INTEGRABLE_ON, has_real_integral] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_STRADDLE THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EXISTS_DROP, FORALL_IN_IMAGE] THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM, ← GSYM DROP_SUB, LIFT_DROP, ← GSYM NORM_1] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"g:real->real", ← q r"h:real->real", ← q r"i:real^1", ← q r"j:real^1"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"lift o g o drop", ← q r"lift o h o drop", ← q r"i:real^1", ← q r"j:real^1"] THEN
    ASM_REWRITE_TAC [o_THM, LIFT_DROP])

  let HAS_REAL_INTEGRAL_STRADDLE_NULL ← prove
   r"!f g s. (!x. x IN s ==> &0 <= f x /\ f x <= g x) /\
           (g has_real_integral &0) s
           ==> (f has_real_integral &0) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRABLE_STRADDLE THEN
      GEN_TAC THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\x. &0):real->real", ← q r"g:real->real",
        ← q r"&0:real", ← q r"&0:real"] THEN
      ASM_REWRITE_TAC [HAS_REAL_INTEGRAL_0, REAL_SUB_REFL, REAL_ABS_NUM],
      DISCH_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← ISPECL [← q r"f:real->real", ← q r"g:real->real"]
          HAS_REAL_INTEGRAL_LE),
        MATCH_MP_TAC (← ISPECL [← q r"(\x. &0):real->real", ← q r"f:real->real"]
          HAS_REAL_INTEGRAL_LE)] THEN
      EXISTS_TAC (← q r"s:real->bool") THEN
      ASM_SIMP_TAC [← GSYM HAS_REAL_INTEGRAL_INTEGRAL, HAS_REAL_INTEGRAL_0]])

  let HAS_REAL_INTEGRAL_UNION ← prove
   r"!f i j s t.
        (f has_real_integral i) s /\ (f has_real_integral j) t /\
        real_negligible(s INTER t)
        ==> (f has_real_integral (i + j)) (s UNION t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_real_integral, real_negligible, LIFT_ADD, IMAGE_UNION] THEN
    DISCH_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_UNION THEN POP_ASSUM MP_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [LIFT_DROP])

  let HAS_REAL_INTEGRAL_UNIONS ← prove
   r"!f:real->real i t.
        FINITE t /\
        (!s. s IN t ==> (f has_real_integral (i s)) s) /\
        (!s s'. s IN t /\ s' IN t /\ ~(s = s') ==> real_negligible(s INTER s'))
        ==> (f has_real_integral (sum t i)) (UNIONS t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_real_integral, real_negligible, LIFT_ADD, IMAGE_UNIONS] THEN
    SIMP_TAC [LIFT_SUM] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"\s. lift(i(IMAGE drop s))",
                      ← q r"IMAGE (IMAGE lift) t"]
      HAS_INTEGRAL_UNIONS) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                  IMAGE_LIFT_DROP, ← GSYM IMAGE_o] THEN
    ASM_SIMP_TAC [LIFT_EQ, ← SET_RULE
     (← q r"(!x y. f x = f y <=> x = y)
      ==> (IMAGE f s = IMAGE f t <=> s = t) /\
          (IMAGE f s INTER IMAGE f t = IMAGE f (s INTER t))")] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    W (MP_TAC o PART_MATCH (lhs o rand) VSUM_IMAGE o lhand o snd) THEN
    ANTS_TAC THENL [ASM SET_TAC [LIFT_DROP], ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [o_DEF, ← GSYM IMAGE_o, IMAGE_LIFT_DROP])

  let REAL_INDEFINITE_INTEGRAL_CONTINUOUS ← prove
   r"!f a b c d e.
        f real_integrable_on real_interval[a,b] /\
        c IN real_interval[a,b] /\
        d IN real_interval[a,b] /\
        &0 < e
        ==> ?k. &0 < k /\
                !c' d'. c' IN real_interval[a,b] /\
                        d' IN real_interval[a,b] /\
                        abs(c' - c) <= k /\ abs(d' - d) <= k
                      ==> abs(real_integral (real_interval[c',d']) f -
                              real_integral (real_interval[c,d]) f) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"lift c", ← q r"lift d",
      ← q r"e:real"]
          INDEFINITE_INTEGRAL_CONTINUOUS) THEN
    ASM_REWRITE_TAC [← GSYM REAL_INTEGRABLE_ON, ← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real") THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM, ← GSYM LIFT_SUB, NORM_LIFT] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"c':real", ← q r"d':real"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c':real", ← q r"d':real"]) THEN
    ASM_REWRITE_TAC [NORM_1, DROP_SUB] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN BINOP_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] REAL_INTEGRABLE_ON_SUBINTERVAL)) THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN ASM_REAL_ARITH_TAC)

  pure { HAS_REAL_INTEGRAL_OPEN_INTERVAL, REAL_INTEGRABLE_ON_OPEN_INTERVAL,
         REAL_INTEGRAL_OPEN_INTERVAL, HAS_REAL_INTEGRAL_ON_SUPERSET,
         REAL_INTEGRABLE_ON_SUPERSET, REAL_INTEGRABLE_RESTRICT_UNIV,
         REAL_INTEGRAL_RESTRICT_UNIV, REAL_INTEGRAL_RESTRICT,
         HAS_REAL_INTEGRAL_RESTRICT_INTER, REAL_INTEGRAL_RESTRICT_INTER,
         REAL_INTEGRABLE_RESTRICT_INTER, REAL_NEGLIGIBLE_ON_INTERVALS,
         HAS_REAL_INTEGRAL_SUBSET_LE, REAL_INTEGRAL_SUBSET_LE,
         REAL_INTEGRABLE_ON_SUBINTERVAL, REAL_INTEGRABLE_ON_SUBINTERVAL_GEN,
         REAL_INTEGRABLE_STRADDLE, HAS_REAL_INTEGRAL_STRADDLE_NULL,
         HAS_REAL_INTEGRAL_UNION, HAS_REAL_INTEGRAL_UNIONS,
         REAL_INDEFINITE_INTEGRAL_CONTINUOUS }
/- ------------------------------------------------------------------------- -/
/- Monotone convergence and Beppo Levi for real integrals.                   -/
/- (realanalysis.ml 9883-10112)                                             -/
/- ------------------------------------------------------------------------- -/

structure RZAQ where
  REAL_MONOTONE_CONVERGENCE_INCREASING : thm
  REAL_MONOTONE_CONVERGENCE_DECREASING : thm
  REAL_BEPPO_LEVI_INCREASING : thm
  REAL_BEPPO_LEVI_DECREASING : thm
  REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING : thm
  REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAQ [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZAK : RZAK) : ExceptT String IO RZAQ := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { REAL_INTEGRABLE_ON, REAL_INTEGRAL, real_negligible, .. } := BRZAK
  let { real_bounded, .. } := D.qmetric
  let { IMAGE_LIFT_DROP, .. } := D.qvectors
  let { BEPPO_LEVI_DECREASING, BEPPO_LEVI_INCREASING,
        BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING, MONOTONE_CONVERGENCE_DECREASING,
        .. } := D.qintegration
  let { BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING, .. } := D.ts.cn.ms.qintegration1
  let { MONOTONE_CONVERGENCE_INCREASING, .. } := D.ts.cn.ms.qintegration3
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { EQ_IMP, ETA_AX, FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, .. } := D.ts.cn.cx.cvx.core3
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_EQ, LIFT_DROP, NORM_1, .. } := D.ts.cn.cx.cvx.vec2
  let { bounded, .. } := D.ts.cn.cx.cvx.top5
  -- @@SCOPE END

  let REAL_MONOTONE_CONVERGENCE_INCREASING ← prove
   r"!f:num->real->real g s.
        (!k. (f k) real_integrable_on s) /\
        (!k x. x IN s ==> f k x <= f (SUC k) x) /\
        (!x. x IN s ==> ((\k. f k x) ---> g x) sequentially) /\
        real_bounded {real_integral s (f k) | k IN (:num)}
        ==> g real_integrable_on s /\
            ((\k. real_integral s (f k)) ---> real_integral s g) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"lift o g o drop", ← q r"IMAGE lift s"]
                  MONOTONE_CONVERGENCE_INCREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN REWRITE_TAC [LIFT_DROP] THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF])

  let REAL_MONOTONE_CONVERGENCE_DECREASING ← prove
   r"!f:num->real->real g s.
        (!k. (f k) real_integrable_on s) /\
        (!k x. x IN s ==> f (SUC k) x <= f k x) /\
        (!x. x IN s ==> ((\k. f k x) ---> g x) sequentially) /\
        real_bounded {real_integral s (f k) | k IN (:num)}
        ==> g real_integrable_on s /\
            ((\k. real_integral s (f k)) ---> real_integral s g) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"lift o g o drop", ← q r"IMAGE lift s"]
                  MONOTONE_CONVERGENCE_DECREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN REWRITE_TAC [LIFT_DROP] THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF])

  let REAL_BEPPO_LEVI_INCREASING ← prove
   r"!f s. (!k. (f k) real_integrable_on s) /\
         (!k x. x IN s ==> f k x <= f (SUC k) x) /\
         real_bounded {real_integral s (f k) | k IN (:num)}
         ==> ?g k. real_negligible k /\
                   !x. x IN (s DIFF k) ==> ((\k. f k x) ---> g x) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"IMAGE lift s"]
                  BEPPO_LEVI_INCREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"k:real^1->bool"] THEN
    REWRITE_TAC [IMP_IMP, LIFT_DROP] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"IMAGE drop k"] THEN
    ASM_REWRITE_TAC [real_negligible, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    ASM_REWRITE_TAC [IN_IMAGE_LIFT_DROP, o_THM, LIFT_DROP])

  let REAL_BEPPO_LEVI_DECREASING ← prove
   r"!f s. (!k. (f k) real_integrable_on s) /\
         (!k x. x IN s ==> f (SUC k) x <= f k x) /\
         real_bounded {real_integral s (f k) | k IN (:num)}
         ==> ?g k. real_negligible k /\
                   !x. x IN (s DIFF k) ==> ((\k. f k x) ---> g x) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"IMAGE lift s"]
                  BEPPO_LEVI_DECREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"k:real^1->bool"] THEN
    REWRITE_TAC [IMP_IMP, LIFT_DROP] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"IMAGE drop k"] THEN
    ASM_REWRITE_TAC [real_negligible, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    ASM_REWRITE_TAC [IN_IMAGE_LIFT_DROP, o_THM, LIFT_DROP])

  let REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING ← prove
   r"!f s.
     (!k. (f k) real_integrable_on s) /\
     (!k x. x IN s ==> f k x <= f (SUC k) x) /\
     real_bounded {real_integral s (f k) | k IN (:num)}
     ==> ?g k. real_negligible k /\
               (!x. x IN (s DIFF k) ==> ((\k. f k x) ---> g x) sequentially) /\
               g real_integrable_on s /\
               ((\k. real_integral s (f k)) ---> real_integral s g)
               sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"IMAGE lift s"]
                  BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"k:real^1->bool"] THEN
    REWRITE_TAC [IMP_IMP, LIFT_DROP] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"IMAGE drop k"] THEN
    ASM_REWRITE_TAC [real_negligible, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    ASM_REWRITE_TAC [IN_IMAGE_LIFT_DROP, o_THM, LIFT_DROP, ETA_AX] THEN
    SUBGOAL_THEN
     (← q r"real_integral s (drop o g o lift) =
              drop(integral (IMAGE lift s) (lift o (drop o g o lift) o drop))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF, LIFT_DROP, ETA_AX],
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]])

  let REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING ← prove
   r"!f s.
     (!k. (f k) real_integrable_on s) /\
     (!k x. x IN s ==> f (SUC k) x <= f k x) /\
     real_bounded {real_integral s (f k) | k IN (:num)}
     ==> ?g k. real_negligible k /\
               (!x. x IN (s DIFF k) ==> ((\k. f k x) ---> g x) sequentially) /\
               g real_integrable_on s /\
               ((\k. real_integral s (f k)) ---> real_integral s g)
               sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"IMAGE lift s"]
                  BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, ← GSYM NORM_1] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN EXISTS_TAC (← q r"B:real") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [o_DEF]) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV],
      ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_DIFF, IMP_CONJ, FORALL_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"k:real^1->bool"] THEN
    REWRITE_TAC [IMP_IMP, LIFT_DROP] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"IMAGE drop k"] THEN
    ASM_REWRITE_TAC [real_negligible, ← GSYM IMAGE_o, IMAGE_LIFT_DROP] THEN
    ASM_REWRITE_TAC [IN_IMAGE_LIFT_DROP, o_THM, LIFT_DROP, ETA_AX] THEN
    SUBGOAL_THEN
     (← q r"real_integral s (drop o g o lift) =
              drop(integral (IMAGE lift s) (lift o (drop o g o lift) o drop))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF, LIFT_DROP, ETA_AX],
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]])

  pure { REAL_MONOTONE_CONVERGENCE_INCREASING, REAL_MONOTONE_CONVERGENCE_DECREASING,
         REAL_BEPPO_LEVI_INCREASING, REAL_BEPPO_LEVI_DECREASING,
         REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING,
         REAL_BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING }
/- ------------------------------------------------------------------------- -/
/- Absolutely integrable real functions; dominated convergence.              -/
/- (realanalysis.ml 10113-10367)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAR where
  REAL_INTEGRAL_ABS_BOUND_INTEGRAL : thm
  ABSOLUTELY_REAL_INTEGRABLE_LE : thm
  ABSOLUTELY_REAL_INTEGRABLE_ON_EMPTY : thm
  ABSOLUTELY_REAL_INTEGRABLE_0 : thm
  ABSOLUTELY_REAL_INTEGRABLE_CONST : thm
  ABSOLUTELY_REAL_INTEGRABLE_LMUL : thm
  ABSOLUTELY_REAL_INTEGRABLE_RMUL : thm
  ABSOLUTELY_REAL_INTEGRABLE_NEG : thm
  ABSOLUTELY_REAL_INTEGRABLE_ABS : thm
  ABSOLUTELY_REAL_INTEGRABLE_ON_SUBINTERVAL : thm
  ABSOLUTELY_REAL_INTEGRABLE_RESTRICT_UNIV : thm
  ABSOLUTELY_REAL_INTEGRABLE_ADD : thm
  ABSOLUTELY_REAL_INTEGRABLE_SUB : thm
  ABSOLUTELY_REAL_INTEGRABLE_LINEAR : thm
  ABSOLUTELY_REAL_INTEGRABLE_SUM : thm
  ABSOLUTELY_REAL_INTEGRABLE_MAX : thm
  ABSOLUTELY_REAL_INTEGRABLE_MIN : thm
  ABSOLUTELY_REAL_INTEGRABLE_IMP_INTEGRABLE : thm
  ABSOLUTELY_REAL_INTEGRABLE_CONTINUOUS : thm
  NONNEGATIVE_ABSOLUTELY_REAL_INTEGRABLE : thm
  ABSOLUTELY_REAL_INTEGRABLE_INTEGRABLE_BOUND : thm
  ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_BOUND : thm
  ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_UBOUND : thm
  ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_LBOUND : thm
  ABSOLUTELY_REAL_INTEGRABLE_INF : thm
  ABSOLUTELY_REAL_INTEGRABLE_SUP : thm
  REAL_DOMINATED_CONVERGENCE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAR [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAP : RZAP) : ExceptT String IO RZAR := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { absolutely_real_integrable_on, ABSOLUTELY_REAL_INTEGRABLE_ON, has_real_integral,
        REAL_INTEGRABLE_ON, REAL_INTEGRAL, .. } := BRZAK
  let { REAL_INTEGRABLE_0, REAL_INTEGRABLE_CONST, REAL_INTEGRABLE_EQ, REAL_INTEGRABLE_LMUL,
        REAL_INTEGRABLE_NEG, REAL_INTEGRABLE_ON_EMPTY, REAL_INTEGRABLE_RMUL, .. } := BRZAL
  let { REAL_INTEGRABLE_ON_SUBINTERVAL, REAL_INTEGRABLE_RESTRICT_UNIV, .. } := BRZAP
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND, ABSOLUTELY_INTEGRABLE_LINEAR,
        .. } := D.qintegration
  let { ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND,
        ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND,
        ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_CONTINUOUS,
        ABSOLUTELY_INTEGRABLE_SUB, DOMINATED_CONVERGENCE, .. } := D.ts.cn.ms.qintegration1
  let { integrable_on, INTEGRAL_NORM_BOUND_INTEGRAL, .. } := D.ts.cn.ms.qintegration3
  let { MESON_TAC, REAL_ARITH, .. } := D.ts.cn.cx.cvx
  let { INF_INSERT_FINITE, SUP_INSERT_FINITE, .. } := D.ts.cn.ms.ig.qsession
  let { COND_RAND, CONJ_ASSOC, DIMINDEX_1, EQ_IMP, ETA_AX, EXISTS_REFL, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, IN_SING, LEFT_FORALL_IMP_THM, REAL_ABS_MUL, REAL_ABS_NEG, REAL_ABS_NUM,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { RIGHT_FORALL_IMP_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_abs, SUM_CLAUSES, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_EQ, EXISTS_LIFT, FORALL_1, LIFT_ADD, LIFT_DROP, LIFT_SUB, NORM_1,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { REAL_ABS_ABS, .. } := D.ts.cn.ms.ig.dv.qsession
  -- @@SCOPE END

  let REAL_INTEGRAL_ABS_BOUND_INTEGRAL ← prove
   r"!f:real->real g s.
        f real_integrable_on s /\ g real_integrable_on s /\
        (!x. x IN s ==> abs(f x) <= g x)
        ==> abs(real_integral s f) <= real_integral s g"
   (SIMP_TAC [REAL_INTEGRAL, ← GSYM NORM_1] THEN
    SIMP_TAC [REAL_INTEGRABLE_ON, INTEGRAL_NORM_BOUND_INTEGRAL] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, NORM_LIFT])

  let ABSOLUTELY_REAL_INTEGRABLE_LE ← prove
   r"!f:real->real s.
        f absolutely_real_integrable_on s
        ==> abs(real_integral s f) <= real_integral s (\x. abs(f x))"
   (SIMP_TAC [absolutely_real_integrable_on] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_ABS_BOUND_INTEGRAL THEN
    ASM_REWRITE_TAC [REAL_LE_REFL])

  let ABSOLUTELY_REAL_INTEGRABLE_ON_EMPTY ← prove
   r"!f. f absolutely_real_integrable_on {}"
   (REWRITE_TAC [absolutely_real_integrable_on, REAL_INTEGRABLE_ON_EMPTY])

  let ABSOLUTELY_REAL_INTEGRABLE_0 ← prove
   r"!s. (\x. &0) absolutely_real_integrable_on s"
   (REWRITE_TAC [absolutely_real_integrable_on, REAL_ABS_NUM,
                 REAL_INTEGRABLE_0])

  let ABSOLUTELY_REAL_INTEGRABLE_CONST ← prove
   r"!a b c. (\x. c) absolutely_real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [absolutely_real_integrable_on, REAL_INTEGRABLE_CONST])

  let ABSOLUTELY_REAL_INTEGRABLE_LMUL ← prove
   r"!f s c. f absolutely_real_integrable_on s
           ==> (\x. c * f(x)) absolutely_real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on,
              REAL_INTEGRABLE_LMUL, REAL_ABS_MUL])

  let ABSOLUTELY_REAL_INTEGRABLE_RMUL ← prove
   r"!f s c. f absolutely_real_integrable_on s
           ==> (\x. f(x) * c) absolutely_real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on,
              REAL_INTEGRABLE_RMUL, REAL_ABS_MUL])

  let ABSOLUTELY_REAL_INTEGRABLE_NEG ← prove
   r"!f s. f absolutely_real_integrable_on s
         ==> (\x. --f(x)) absolutely_real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on, REAL_INTEGRABLE_NEG, REAL_ABS_NEG])

  let ABSOLUTELY_REAL_INTEGRABLE_ABS ← prove
   r"!f s. f absolutely_real_integrable_on s
         ==> (\x. abs(f x)) absolutely_real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on, REAL_ABS_ABS])

  let ABSOLUTELY_REAL_INTEGRABLE_ON_SUBINTERVAL ← prove
   r"!f:real->real s a b.
        f absolutely_real_integrable_on s /\ real_interval[a,b] SUBSET s
        ==> f absolutely_real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [absolutely_real_integrable_on] THEN
    MESON_TAC [REAL_INTEGRABLE_ON_SUBINTERVAL])

  let ABSOLUTELY_REAL_INTEGRABLE_RESTRICT_UNIV ← prove
   r"!f s. (\x. if x IN s then f x else &0)
              absolutely_real_integrable_on (:real) <=>
         f absolutely_real_integrable_on s"
   (REWRITE_TAC [absolutely_real_integrable_on, REAL_INTEGRABLE_RESTRICT_UNIV,
                 COND_RAND, REAL_ABS_NUM])

  let ABSOLUTELY_REAL_INTEGRABLE_ADD ← prove
   r"!f:real->real g s.
        f absolutely_real_integrable_on s /\
        g absolutely_real_integrable_on s
        ==> (\x. f(x) + g(x)) absolutely_real_integrable_on s"
   (REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    SIMP_TAC [o_DEF, LIFT_ADD, ABSOLUTELY_INTEGRABLE_ADD])

  let ABSOLUTELY_REAL_INTEGRABLE_SUB ← prove
   r"!f:real->real g s.
        f absolutely_real_integrable_on s /\
        g absolutely_real_integrable_on s
        ==> (\x. f(x) - g(x)) absolutely_real_integrable_on s"
   (REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    SIMP_TAC [o_DEF, LIFT_SUB, ABSOLUTELY_INTEGRABLE_SUB])

  let ABSOLUTELY_REAL_INTEGRABLE_LINEAR ← prove
   r"!f h s.
        f absolutely_real_integrable_on s /\ linear(lift o h o drop)
        ==> (h o f) absolutely_real_integrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_LINEAR) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let ABSOLUTELY_REAL_INTEGRABLE_SUM ← prove
   r"!f:A->real->real s t.
        FINITE t /\
        (!a. a IN t ==> (f a) absolutely_real_integrable_on s)
        ==>  (\x. sum t (\a. f a x)) absolutely_real_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, ABSOLUTELY_REAL_INTEGRABLE_0, IN_INSERT,
              ABSOLUTELY_REAL_INTEGRABLE_ADD, ETA_AX])

  let ABSOLUTELY_REAL_INTEGRABLE_MAX ← prove
   r"!f:real->real g:real->real s.
        f absolutely_real_integrable_on s /\ g absolutely_real_integrable_on s
        ==> (\x. max (f x) (g x))
            absolutely_real_integrable_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"max a b = &1 / &2 * ((a + b) + abs(a - b))")] THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_LMUL THEN
    ASM_SIMP_TAC [ABSOLUTELY_REAL_INTEGRABLE_SUB, ABSOLUTELY_REAL_INTEGRABLE_ADD,
                  ABSOLUTELY_REAL_INTEGRABLE_ABS])

  let ABSOLUTELY_REAL_INTEGRABLE_MIN ← prove
   r"!f:real->real g:real->real s.
        f absolutely_real_integrable_on s /\ g absolutely_real_integrable_on s
        ==> (\x. min (f x) (g x))
            absolutely_real_integrable_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"min a b = &1 / &2 * ((a + b) - abs(a - b))")] THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_LMUL THEN
    ASM_SIMP_TAC [ABSOLUTELY_REAL_INTEGRABLE_SUB, ABSOLUTELY_REAL_INTEGRABLE_ADD,
                  ABSOLUTELY_REAL_INTEGRABLE_ABS])

  let ABSOLUTELY_REAL_INTEGRABLE_IMP_INTEGRABLE ← prove
   r"!f s. f absolutely_real_integrable_on s ==> f real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on])

  let ABSOLUTELY_REAL_INTEGRABLE_CONTINUOUS ← prove
   r"!f a b.
        f real_continuous_on real_interval[a,b]
        ==> f absolutely_real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, ABSOLUTELY_REAL_INTEGRABLE_ON,
                 has_real_integral,
                 ← GSYM integrable_on, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, ABSOLUTELY_INTEGRABLE_CONTINUOUS])

  let NONNEGATIVE_ABSOLUTELY_REAL_INTEGRABLE ← prove
   r"!f s.
        (!x. x IN s ==> &0 <= f(x)) /\
        f real_integrable_on s
        ==> f absolutely_real_integrable_on s"
   (SIMP_TAC [absolutely_real_integrable_on] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRABLE_EQ THEN
    EXISTS_TAC (← q r"f:real->real") THEN ASM_SIMP_TAC [real_abs])

  let ABSOLUTELY_REAL_INTEGRABLE_INTEGRABLE_BOUND ← prove
   r"!f:real->real g s.
        (!x. x IN s ==> abs(f x) <= g x) /\
        f real_integrable_on s /\ g real_integrable_on s
        ==> f absolutely_real_integrable_on s"
   (REWRITE_TAC [REAL_INTEGRABLE_ON, ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND THEN
    EXISTS_TAC (← q r"lift o g o drop") THEN ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, NORM_LIFT])

  let ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_BOUND ← prove
   r"!f:real->real g:real->real s.
        (!x. x IN s ==> abs(f x) <= abs(g x)) /\
        f real_integrable_on s /\ g absolutely_real_integrable_on s
        ==> f absolutely_real_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_INTEGRABLE_BOUND THEN
    EXISTS_TAC (← q r"\x:real. abs(g x)") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [absolutely_real_integrable_on]) THEN
    ASM_REWRITE_TAC [])

  let ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_UBOUND ← prove
   r"!f:real->real g:real->real s.
        (!x. x IN s ==> f x <= g x) /\
        f real_integrable_on s /\ g absolutely_real_integrable_on s
        ==> g absolutely_real_integrable_on s"
   (REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON, REAL_INTEGRABLE_ON] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC
     ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND THEN
    EXISTS_TAC (← q r"lift o g o drop") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, o_THM, LIFT_DROP,
                     ← GSYM drop])

  let ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_LBOUND ← prove
   r"!f:real->real g:real->real s.
        (!x. x IN s ==> f x <= g x) /\
        f absolutely_real_integrable_on s /\ g real_integrable_on s
        ==> g absolutely_real_integrable_on s"
   (REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON, REAL_INTEGRABLE_ON] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC
     ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND THEN
    EXISTS_TAC (← q r"lift o f o drop") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, o_THM, LIFT_DROP,
                     ← GSYM drop])

  let ABSOLUTELY_REAL_INTEGRABLE_INF ← prove
   r"!fs s:real->bool k:A->bool.
        FINITE k /\ ~(k = {}) /\
        (!i. i IN k ==> (\x. fs x i) absolutely_real_integrable_on s)
        ==> (\x. inf (IMAGE (fs x) k)) absolutely_real_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [IMAGE_CLAUSES] THEN
    SIMP_TAC [INF_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [IN_SING, LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_MIN THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INSERT] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INSERT])

  let ABSOLUTELY_REAL_INTEGRABLE_SUP ← prove
   r"!fs s:real->bool k:A->bool.
        FINITE k /\ ~(k = {}) /\
        (!i. i IN k ==> (\x. fs x i) absolutely_real_integrable_on s)
        ==> (\x. sup (IMAGE (fs x) k)) absolutely_real_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [IMAGE_CLAUSES] THEN
    SIMP_TAC [SUP_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [IN_SING, LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_MAX THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INSERT] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INSERT])

  let REAL_DOMINATED_CONVERGENCE ← prove
   r"!f:num->real->real g h s.
        (!k. (f k) real_integrable_on s) /\ h real_integrable_on s /\
        (!k x. x IN s ==> abs(f k x) <= h x) /\
        (!x. x IN s ==> ((\k. f k x) ---> g x) sequentially)
        ==> g real_integrable_on s /\
            ((\k. real_integral s (f k)) ---> real_integral s g) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_INTEGRABLE_ON, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. lift(f (n:num) (drop x))",
                      ← q r"lift o g o drop", ← q r"lift o h o drop", ← q r"IMAGE lift s"]
                  DOMINATED_CONVERGENCE) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, LIFT_DROP, o_DEF, NORM_LIFT] THEN
    SUBGOAL_THEN
     (← q r"!k:num. real_integral s (f k) =
              drop(integral (IMAGE lift s) (lift o f k o drop))")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_INTEGRAL THEN
      ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF],
      ALL_TAC] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN REWRITE_TAC [LIFT_DROP] THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC REAL_INTEGRAL THEN ASM_REWRITE_TAC [REAL_INTEGRABLE_ON, o_DEF])

  pure { REAL_INTEGRAL_ABS_BOUND_INTEGRAL, ABSOLUTELY_REAL_INTEGRABLE_LE,
         ABSOLUTELY_REAL_INTEGRABLE_ON_EMPTY, ABSOLUTELY_REAL_INTEGRABLE_0,
         ABSOLUTELY_REAL_INTEGRABLE_CONST, ABSOLUTELY_REAL_INTEGRABLE_LMUL,
         ABSOLUTELY_REAL_INTEGRABLE_RMUL, ABSOLUTELY_REAL_INTEGRABLE_NEG,
         ABSOLUTELY_REAL_INTEGRABLE_ABS, ABSOLUTELY_REAL_INTEGRABLE_ON_SUBINTERVAL,
         ABSOLUTELY_REAL_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_REAL_INTEGRABLE_ADD,
         ABSOLUTELY_REAL_INTEGRABLE_SUB, ABSOLUTELY_REAL_INTEGRABLE_LINEAR,
         ABSOLUTELY_REAL_INTEGRABLE_SUM, ABSOLUTELY_REAL_INTEGRABLE_MAX,
         ABSOLUTELY_REAL_INTEGRABLE_MIN, ABSOLUTELY_REAL_INTEGRABLE_IMP_INTEGRABLE,
         ABSOLUTELY_REAL_INTEGRABLE_CONTINUOUS, NONNEGATIVE_ABSOLUTELY_REAL_INTEGRABLE,
         ABSOLUTELY_REAL_INTEGRABLE_INTEGRABLE_BOUND,
         ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_BOUND,
         ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_UBOUND,
         ABSOLUTELY_REAL_INTEGRABLE_ABSOLUTELY_REAL_INTEGRABLE_LBOUND,
         ABSOLUTELY_REAL_INTEGRABLE_INF, ABSOLUTELY_REAL_INTEGRABLE_SUP,
         REAL_DOMINATED_CONVERGENCE }
/- ------------------------------------------------------------------------- -/
/- Measures of real sets (part 1).                                           -/
/- (realanalysis.ml 10368-10557)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAS where
  HAS_REAL_MEASURE_HAS_MEASURE : thm
  REAL_MEASURABLE_MEASURABLE : thm
  REAL_MEASURE_MEASURE : thm
  HAS_REAL_MEASURE_MEASURE : thm
  HAS_REAL_MEASURE_UNIQUE : thm
  REAL_MEASURE_UNIQUE : thm
  HAS_REAL_MEASURE_REAL_MEASURABLE_REAL_MEASURE : thm
  HAS_REAL_MEASURE_IMP_REAL_MEASURABLE : thm
  HAS_REAL_MEASURE : thm
  REAL_MEASURABLE : thm
  REAL_MEASURABLE_REAL_INTEGRABLE : thm
  REAL_MEASURE_REAL_INTEGRAL : thm
  REAL_MEASURE_REAL_INTEGRAL_UNIV : thm
  REAL_INTEGRAL_REAL_MEASURE : thm
  REAL_INTEGRAL_REAL_MEASURE_UNIV : thm
  HAS_REAL_MEASURE_REAL_INTERVAL : thm
  REAL_MEASURABLE_REAL_INTERVAL : thm
  REAL_MEASURE_REAL_INTERVAL : thm
  REAL_MEASURABLE_REAL_SEGMENT : thm
  REAL_MEASURE_REAL_SEGMENT : thm
  REAL_MEASURABLE_INTER : thm
  REAL_MEASURABLE_UNION : thm
  HAS_REAL_MEASURE_DISJOINT_UNION : thm
  REAL_MEASURE_DISJOINT_UNION : thm
  HAS_REAL_MEASURE_POS_LE : thm
  REAL_MEASURE_POS_LE : thm
  HAS_REAL_MEASURE_SUBSET : thm
  REAL_MEASURE_SUBSET : thm
  HAS_REAL_MEASURE_0 : thm
  REAL_MEASURE_EQ_0 : thm
  HAS_REAL_MEASURE_EMPTY : thm
  REAL_MEASURE_EMPTY : thm
  REAL_MEASURABLE_EMPTY : thm
  REAL_MEASURABLE_REAL_MEASURE_EQ_0 : thm
  REAL_MEASURABLE_REAL_MEASURE_POS_LT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAS [HolBase] (D : RealAnalysisDeps) (BRZAD : RZAD) (BRZAK : RZAK) (BRZAM : RZAM) (BRZAO : RZAO) : ExceptT String IO RZAS := do
  -- @@SCOPE BEGIN
  let { REAL_SEGMENT_INTERVAL, .. } := BRZAD
  let { has_real_integral, HAS_REAL_INTEGRAL_UNIQUE, has_real_measure, real_integrable_on,
        REAL_INTEGRAL_UNIQUE, real_measurable, real_measure, real_negligible, .. } := BRZAK
  let { REAL_NEGLIGIBLE_EMPTY, .. } := BRZAM
  let { HAS_REAL_INTEGRAL_RESTRICT_UNIV, .. } := BRZAO
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { has_measure, HAS_MEASURE_0, HAS_MEASURE_DISJOINT_UNION,
        HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_POS_LE, HAS_MEASURE_SUBSET, measurable,
        MEASURABLE_INTER, MEASURABLE_INTERVAL, MEASURABLE_UNION, measure, MEASURE_INTERVAL,
        .. } := D.qmeasure
  let { PRODUCT_1, .. } := D.ts.cn.ms.qdet
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.ts.cn.ms.qintegration1
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { DIMINDEX_1, EQ_IMP, EQ_SYM_EQ, .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_UNION, .. } := D.ts.cn.cx.cvx.core2
  let { REAL_LT_LE, .. } := D.ts.cn.cx.cvx.core4
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_EQ, EXISTS_DROP, FORALL_1, LIFT_DROP, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  -- @@SCOPE END

  let HAS_REAL_MEASURE_HAS_MEASURE ← prove
   r"!s m. s has_real_measure m <=> (IMAGE lift s) has_measure m"
   (REWRITE_TAC [has_real_measure, has_measure, has_real_integral] THEN
    REWRITE_TAC [o_DEF, LIFT_NUM])

  let REAL_MEASURABLE_MEASURABLE ← prove
   r"!s. real_measurable s <=> measurable(IMAGE lift s)"
   (REWRITE_TAC [real_measurable, measurable, HAS_REAL_MEASURE_HAS_MEASURE])

  let REAL_MEASURE_MEASURE ← prove
   r"!s. real_measure s = measure (IMAGE lift s)"
   (REWRITE_TAC [real_measure, measure, HAS_REAL_MEASURE_HAS_MEASURE])

  let HAS_REAL_MEASURE_MEASURE ← prove
   r"!s. real_measurable s <=> s has_real_measure (real_measure s)"
   (REWRITE_TAC [real_measure, real_measurable] THEN MESON_TAC [])

  let HAS_REAL_MEASURE_UNIQUE ← prove
   r"!s m1 m2. s has_real_measure m1 /\ s has_real_measure m2 ==> m1 = m2"
   (REWRITE_TAC [has_real_measure] THEN MESON_TAC [HAS_REAL_INTEGRAL_UNIQUE])

  let REAL_MEASURE_UNIQUE ← prove
   r"!s m. s has_real_measure m ==> real_measure s = m"
   (MESON_TAC [HAS_REAL_MEASURE_UNIQUE, HAS_REAL_MEASURE_MEASURE,
               real_measurable])

  let HAS_REAL_MEASURE_REAL_MEASURABLE_REAL_MEASURE ← prove
   r"!s m. s has_real_measure m <=> real_measurable s /\ real_measure s = m"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE] THEN MESON_TAC [REAL_MEASURE_UNIQUE])

  let HAS_REAL_MEASURE_IMP_REAL_MEASURABLE ← prove
   r"!s m. s has_real_measure m ==> real_measurable s"
   (REWRITE_TAC [real_measurable] THEN MESON_TAC [])

  let HAS_REAL_MEASURE ← prove
   r"!s m. s has_real_measure m <=>
              ((\x. if x IN s then &1 else &0) has_real_integral m) (:real)"
   (SIMP_TAC [HAS_REAL_INTEGRAL_RESTRICT_UNIV, has_real_measure])

  let REAL_MEASURABLE ← prove
   r"!s. real_measurable s <=> (\x. &1) real_integrable_on s"
   (REWRITE_TAC [real_measurable, real_integrable_on,
                 has_real_measure, EXISTS_DROP, LIFT_DROP])

  let REAL_MEASURABLE_REAL_INTEGRABLE ← prove
   r"real_measurable s <=>
    (\x. if x IN s then &1 else &0) real_integrable_on UNIV"
   (REWRITE_TAC [real_measurable, real_integrable_on, HAS_REAL_MEASURE])

  let REAL_MEASURE_REAL_INTEGRAL ← prove
   r"!s. real_measurable s ==> real_measure s = real_integral s (\x. &1)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_REWRITE_TAC [← GSYM has_real_measure, ← GSYM HAS_REAL_MEASURE_MEASURE])

  let REAL_MEASURE_REAL_INTEGRAL_UNIV ← prove
   r"!s. real_measurable s
       ==> real_measure s =
           real_integral UNIV (\x. if x IN s then &1 else &0)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_REWRITE_TAC [← GSYM HAS_REAL_MEASURE, ← GSYM HAS_REAL_MEASURE_MEASURE])

  let REAL_INTEGRAL_REAL_MEASURE ← prove
   r"!s. real_measurable s ==> real_integral s (\x. &1) = real_measure s"
   (SIMP_TAC [← GSYM DROP_EQ, LIFT_DROP, REAL_MEASURE_REAL_INTEGRAL])

  let REAL_INTEGRAL_REAL_MEASURE_UNIV ← prove
   r"!s. real_measurable s
       ==> real_integral UNIV (\x. if x IN s then &1 else &0) =
           real_measure s"
   (SIMP_TAC [REAL_MEASURE_REAL_INTEGRAL_UNIV])

  let HAS_REAL_MEASURE_REAL_INTERVAL ← prove
   r"(!a b. real_interval[a,b] has_real_measure (max (b - a) (&0))) /\
   (!a b. real_interval(a,b) has_real_measure (max (b - a) (&0)))"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTERVAL,
                 MEASURE_INTERVAL] THEN
    REWRITE_TAC [CONTENT_CLOSED_INTERVAL_CASES, DIMINDEX_1, FORALL_1] THEN
    REWRITE_TAC [PRODUCT_1, ← GSYM drop, LIFT_DROP] THEN REAL_ARITH_TAC)

  let REAL_MEASURABLE_REAL_INTERVAL ← prove
   r"(!a b. real_measurable (real_interval[a,b])) /\
   (!a b. real_measurable (real_interval(a,b)))"
   (REWRITE_TAC [real_measurable] THEN
    MESON_TAC [HAS_REAL_MEASURE_REAL_INTERVAL])

  let REAL_MEASURE_REAL_INTERVAL ← prove
   r"(!a b. real_measure(real_interval[a,b]) = max (b - a) (&0)) /\
   (!a b. real_measure(real_interval(a,b)) = max (b - a) (&0))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    REWRITE_TAC [HAS_REAL_MEASURE_REAL_INTERVAL])

  let REAL_MEASURABLE_REAL_SEGMENT ← prove
   r"(!a b. real_measurable(real_segment[a,b])) /\
   (!a b. real_measurable(real_segment(a,b)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MEASURABLE_REAL_INTERVAL])

  let REAL_MEASURE_REAL_SEGMENT ← prove
   r"(!a b. real_measure(real_segment[a,b]) = abs(b - a)) /\
   (!a b. real_measure(real_segment(a,b)) = abs(b - a))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_SEGMENT_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MEASURE_REAL_INTERVAL] THEN
    ASM_REAL_ARITH_TAC)

  let REAL_MEASURABLE_INTER ← prove
   r"!s t. real_measurable s /\ real_measurable t
         ==> real_measurable (s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_MEASURABLE_MEASURABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_INTER) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [LIFT_DROP])

  let REAL_MEASURABLE_UNION ← prove
   r"!s t. real_measurable s /\ real_measurable t
         ==> real_measurable (s UNION t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_MEASURABLE_MEASURABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_UNION) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [LIFT_DROP])

  let HAS_REAL_MEASURE_DISJOINT_UNION ← prove
   r"!s1 s2 m1 m2. s1 has_real_measure m1 /\ s2 has_real_measure m2 /\
                 DISJOINT s1 s2
                 ==> (s1 UNION s2) has_real_measure (m1 + m2)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, IMAGE_UNION] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_MEASURE_DISJOINT_UNION THEN
    ASM SET_TAC [LIFT_DROP])

  let REAL_MEASURE_DISJOINT_UNION ← prove
   r"!s t. real_measurable s /\ real_measurable t /\ DISJOINT s t
         ==> real_measure(s UNION t) = real_measure s + real_measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_DISJOINT_UNION,
                  ← GSYM HAS_REAL_MEASURE_MEASURE])

  let HAS_REAL_MEASURE_POS_LE ← prove
   r"!m s. s has_real_measure m ==> &0 <= m"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, HAS_MEASURE_POS_LE])

  let REAL_MEASURE_POS_LE ← prove
   r"!s. real_measurable s ==> &0 <= real_measure s"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE, HAS_REAL_MEASURE_POS_LE])

  let HAS_REAL_MEASURE_SUBSET ← prove
   r"!s1 s2 m1 m2.
        s1 has_real_measure m1 /\ s2 has_real_measure m2 /\ s1 SUBSET s2
        ==> m1 <= m2"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPECL [← q r"IMAGE lift s1", ← q r"IMAGE lift s2"]
      HAS_MEASURE_SUBSET) THEN
    ASM SET_TAC [HAS_MEASURE_SUBSET])

  let REAL_MEASURE_SUBSET ← prove
   r"!s t. real_measurable s /\ real_measurable t /\ s SUBSET t
         ==> real_measure s <= real_measure t"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE] THEN
    MESON_TAC [HAS_REAL_MEASURE_SUBSET])

  let HAS_REAL_MEASURE_0 ← prove
   r"!s. s has_real_measure &0 <=> real_negligible s"
   (REWRITE_TAC [real_negligible, HAS_REAL_MEASURE_HAS_MEASURE] THEN
    REWRITE_TAC [HAS_MEASURE_0])

  let REAL_MEASURE_EQ_0 ← prove
   r"!s. real_negligible s ==> real_measure s = &0"
   (MESON_TAC [REAL_MEASURE_UNIQUE, HAS_REAL_MEASURE_0])

  let HAS_REAL_MEASURE_EMPTY ← prove
   r"{} has_real_measure &0"
   (REWRITE_TAC [HAS_REAL_MEASURE_0, REAL_NEGLIGIBLE_EMPTY])

  let REAL_MEASURE_EMPTY ← prove
   r"real_measure {} = &0"
   (SIMP_TAC [REAL_MEASURE_EQ_0, REAL_NEGLIGIBLE_EMPTY])

  let REAL_MEASURABLE_EMPTY ← prove
   r"real_measurable {}"
   (REWRITE_TAC [real_measurable] THEN MESON_TAC [HAS_REAL_MEASURE_EMPTY])

  let REAL_MEASURABLE_REAL_MEASURE_EQ_0 ← prove
   r"!s. real_measurable s ==> (real_measure s = &0 <=> real_negligible s)"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE, ← GSYM HAS_REAL_MEASURE_0] THEN
    MESON_TAC [REAL_MEASURE_UNIQUE])

  let REAL_MEASURABLE_REAL_MEASURE_POS_LT ← prove
   r"!s. real_measurable s ==> (&0 < real_measure s <=> ~real_negligible s)"
   (SIMP_TAC [REAL_LT_LE, REAL_MEASURE_POS_LE,
              ← GSYM REAL_MEASURABLE_REAL_MEASURE_EQ_0] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  pure { HAS_REAL_MEASURE_HAS_MEASURE, REAL_MEASURABLE_MEASURABLE, REAL_MEASURE_MEASURE,
         HAS_REAL_MEASURE_MEASURE, HAS_REAL_MEASURE_UNIQUE, REAL_MEASURE_UNIQUE,
         HAS_REAL_MEASURE_REAL_MEASURABLE_REAL_MEASURE,
         HAS_REAL_MEASURE_IMP_REAL_MEASURABLE, HAS_REAL_MEASURE, REAL_MEASURABLE,
         REAL_MEASURABLE_REAL_INTEGRABLE, REAL_MEASURE_REAL_INTEGRAL,
         REAL_MEASURE_REAL_INTEGRAL_UNIV, REAL_INTEGRAL_REAL_MEASURE,
         REAL_INTEGRAL_REAL_MEASURE_UNIV, HAS_REAL_MEASURE_REAL_INTERVAL,
         REAL_MEASURABLE_REAL_INTERVAL, REAL_MEASURE_REAL_INTERVAL,
         REAL_MEASURABLE_REAL_SEGMENT, REAL_MEASURE_REAL_SEGMENT, REAL_MEASURABLE_INTER,
         REAL_MEASURABLE_UNION, HAS_REAL_MEASURE_DISJOINT_UNION,
         REAL_MEASURE_DISJOINT_UNION, HAS_REAL_MEASURE_POS_LE, REAL_MEASURE_POS_LE,
         HAS_REAL_MEASURE_SUBSET, REAL_MEASURE_SUBSET, HAS_REAL_MEASURE_0,
         REAL_MEASURE_EQ_0, HAS_REAL_MEASURE_EMPTY, REAL_MEASURE_EMPTY,
         REAL_MEASURABLE_EMPTY, REAL_MEASURABLE_REAL_MEASURE_EQ_0,
         REAL_MEASURABLE_REAL_MEASURE_POS_LT }
/- ------------------------------------------------------------------------- -/
/- Measures of real sets (part 2: differences, almost-equal sets, unions).   -/
/- (realanalysis.ml 10558-10777)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAT where
  REAL_NEGLIGIBLE_REAL_INTERVAL : thm
  REAL_MEASURABLE_UNIONS : thm
  HAS_REAL_MEASURE_DIFF_SUBSET : thm
  REAL_MEASURABLE_DIFF : thm
  REAL_MEASURE_DIFF_SUBSET : thm
  HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE : thm
  HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE : thm
  HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE_EQ : thm
  HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE_EQ : thm
  HAS_REAL_MEASURE_ALMOST : thm
  HAS_REAL_MEASURE_ALMOST_EQ : thm
  REAL_MEASURABLE_ALMOST : thm
  HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNION : thm
  REAL_MEASURE_REAL_NEGLIGIBLE_UNION : thm
  HAS_REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF : thm
  REAL_MEASURABLE_REAL_NEGLIGIBLE_SYMDIFF : thm
  REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF : thm
  HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS : thm
  REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS : thm
  HAS_REAL_MEASURE_DISJOINT_UNIONS : thm
  REAL_MEASURE_DISJOINT_UNIONS : thm
  HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE : thm
  REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE : thm
  HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE : thm
  REAL_MEASURE_DISJOINT_UNIONS_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAT [HolBase] (D : RealAnalysisDeps) (BRZAK : RZAK) (BRZAM : RZAM) (BRZAS : RZAS) : ExceptT String IO RZAT := do
  -- @@SCOPE BEGIN
  let { real_measurable, real_negligible, .. } := BRZAK
  let { REAL_NEGLIGIBLE_EMPTY, REAL_NEGLIGIBLE_UNIONS, .. } := BRZAM
  let { HAS_REAL_MEASURE_EMPTY, HAS_REAL_MEASURE_HAS_MEASURE, HAS_REAL_MEASURE_MEASURE,
        REAL_MEASURABLE_MEASURABLE, REAL_MEASURABLE_REAL_MEASURE_EQ_0, REAL_MEASURE_UNIQUE,
        .. } := BRZAS
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { REAL_INTERVAL_EQ_EMPTY, .. } := D.qmisc
  let { IMAGE_DIFF_INJ, IMAGE_INTER_INJ, .. } := D.qsession
  let { HAS_MEASURE_ALMOST, HAS_MEASURE_DIFF_NEGLIGIBLE, HAS_MEASURE_DIFF_NEGLIGIBLE_EQ,
        HAS_MEASURE_DIFF_SUBSET, HAS_MEASURE_NEGLIGIBLE_UNION,
        HAS_MEASURE_UNION_NEGLIGIBLE, HAS_MEASURE_UNION_NEGLIGIBLE_EQ, MEASURABLE_DIFF,
        MEASURABLE_UNIONS, NEGLIGIBLE_INTERVAL, .. } := D.qmeasure
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { IMAGE_UNIONS, SUM_IMAGE_NONZERO, .. } := D.ts.cn.ms.ig.qsession
  let { DISJOINT, FINITE_IMAGE, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, INTER_ACI, INTER_UNIONS,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_INSERT, .. } := D.ts.cn.cx.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUM_CLAUSES, UNION_COMM, UNIONS_0, UNIONS_INSERT,
        .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { INTERVAL_EQ_EMPTY_1, .. } := D.ts.cn.cx.cvx.top4
  -- @@SCOPE END

  let REAL_NEGLIGIBLE_REAL_INTERVAL ← prove
   r"(!a b. real_negligible(real_interval[a,b]) <=> real_interval(a,b) = {}) /\
   (!a b. real_negligible(real_interval(a,b)) <=> real_interval(a,b) = {})"
   (REWRITE_TAC [real_negligible, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [NEGLIGIBLE_INTERVAL] THEN
    REWRITE_TAC [REAL_INTERVAL_EQ_EMPTY, INTERVAL_EQ_EMPTY_1, LIFT_DROP])

  let REAL_MEASURABLE_UNIONS ← prove
   r"!f. FINITE f /\ (!s. s IN f ==> real_measurable s)
       ==> real_measurable (UNIONS f)"
   (REWRITE_TAC [REAL_MEASURABLE_MEASURABLE, IMAGE_UNIONS] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_UNIONS THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE])

  let HAS_REAL_MEASURE_DIFF_SUBSET ← prove
   r"!s1 s2 m1 m2.
        s1 has_real_measure m1 /\ s2 has_real_measure m2 /\ s2 SUBSET s1
        ==> (s1 DIFF s2) has_real_measure (m1 - m2)"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [IMAGE_DIFF_INJ, LIFT_EQ] THEN
    MATCH_MP_TAC HAS_MEASURE_DIFF_SUBSET THEN
    ASM_SIMP_TAC [IMAGE_SUBSET])

  let REAL_MEASURABLE_DIFF ← prove
   r"!s t. real_measurable s /\ real_measurable t
         ==> real_measurable (s DIFF t)"
   (SIMP_TAC [REAL_MEASURABLE_MEASURABLE, IMAGE_DIFF_INJ, LIFT_EQ] THEN
    REWRITE_TAC [MEASURABLE_DIFF])

  let REAL_MEASURE_DIFF_SUBSET ← prove
   r"!s t. real_measurable s /\ real_measurable t /\ t SUBSET s
         ==> real_measure(s DIFF t) = real_measure s - real_measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_DIFF_SUBSET, ← GSYM HAS_REAL_MEASURE_MEASURE])

  let HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE ← prove
   r"!s t m.
        s has_real_measure m /\ real_negligible t
        ==> (s UNION t) has_real_measure m"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible, IMAGE_UNION] THEN
    REWRITE_TAC [HAS_MEASURE_UNION_NEGLIGIBLE])

  let HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE ← prove
   r"!s t m.
        s has_real_measure m /\ real_negligible t
        ==> (s DIFF t) has_real_measure m"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible] THEN
    SIMP_TAC [IMAGE_DIFF_INJ, LIFT_EQ] THEN
    REWRITE_TAC [HAS_MEASURE_DIFF_NEGLIGIBLE])

  let HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE_EQ ← prove
   r"!s t m.
     real_negligible t
     ==> ((s UNION t) has_real_measure m <=> s has_real_measure m)"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible, IMAGE_UNION] THEN
    REWRITE_TAC [HAS_MEASURE_UNION_NEGLIGIBLE_EQ])

  let HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE_EQ ← prove
   r"!s t m.
     real_negligible t
     ==> ((s DIFF t) has_real_measure m <=> s has_real_measure m)"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible] THEN
    SIMP_TAC [IMAGE_DIFF_INJ, LIFT_EQ] THEN
    REWRITE_TAC [HAS_MEASURE_DIFF_NEGLIGIBLE_EQ])

  let HAS_REAL_MEASURE_ALMOST ← prove
   r"!s s' t m. s has_real_measure m /\ real_negligible t /\
              s UNION t = s' UNION t
              ==> s' has_real_measure m"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible, IMAGE_UNION] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_MEASURE_ALMOST THEN
    MAP_EVERY EXISTS_TAC [← q r"IMAGE lift s", ← q r"IMAGE lift t"] THEN ASM SET_TAC [])

  let HAS_REAL_MEASURE_ALMOST_EQ ← prove
   r"!s s' t. real_negligible t /\ s UNION t = s' UNION t
            ==> (s has_real_measure m <=> s' has_real_measure m)"
   (MESON_TAC [HAS_REAL_MEASURE_ALMOST])

  let REAL_MEASURABLE_ALMOST ← prove
   r"!s s' t. real_measurable s /\ real_negligible t /\ s UNION t = s' UNION t
            ==> real_measurable s'"
   (REWRITE_TAC [real_measurable] THEN MESON_TAC [HAS_REAL_MEASURE_ALMOST])

  let HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNION ← prove
   r"!s1 s2 m1 m2.
        s1 has_real_measure m1 /\ s2 has_real_measure m2 /\
        real_negligible(s1 INTER s2)
        ==> (s1 UNION s2) has_real_measure (m1 + m2)"
   (REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE, real_negligible, IMAGE_UNION] THEN
    SIMP_TAC [IMAGE_INTER_INJ, LIFT_EQ] THEN
    REWRITE_TAC [HAS_MEASURE_NEGLIGIBLE_UNION])

  let REAL_MEASURE_REAL_NEGLIGIBLE_UNION ← prove
   r"!s t. real_measurable s /\ real_measurable t /\ real_negligible(s INTER t)
         ==> real_measure(s UNION t) = real_measure s + real_measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNION,
                  ← GSYM HAS_REAL_MEASURE_MEASURE])

  let HAS_REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t m.
        s has_real_measure m /\
        real_negligible((s DIFF t) UNION (t DIFF s))
        ==> t has_real_measure m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_REAL_MEASURE_ALMOST THEN
    MAP_EVERY EXISTS_TAC
      [← q r"s:real->bool", ← q r"(s DIFF t) UNION (t DIFF s):real->bool"] THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let REAL_MEASURABLE_REAL_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t. real_measurable s /\ real_negligible((s DIFF t) UNION (t DIFF s))
         ==> real_measurable t"
   (REWRITE_TAC [real_measurable] THEN
    MESON_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF])

  let REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t. (real_measurable s \/ real_measurable t) /\
         real_negligible((s DIFF t) UNION (t DIFF s))
         ==> real_measure s = real_measure t"
   (MESON_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF, REAL_MEASURE_UNIQUE,
               UNION_COMM, HAS_REAL_MEASURE_MEASURE])

  let HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS ← prove
   r"!m f. FINITE f /\
         (!s. s IN f ==> s has_real_measure (m s)) /\
         (!s t. s IN f /\ t IN f /\ ~(s = t) ==> real_negligible(s INTER t))
         ==> (UNIONS f) has_real_measure (sum f m)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, UNIONS_0, UNIONS_INSERT, HAS_REAL_MEASURE_EMPTY] THEN
    REWRITE_TAC [IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real->bool", ← q r"f:(real->bool)->bool"] THEN
    STRIP_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNION THEN
    REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [INTER_UNIONS] THEN MATCH_MP_TAC REAL_NEGLIGIBLE_UNIONS THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [])

  let REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS ← prove
   r"!m f. FINITE f /\
         (!s. s IN f ==> s has_real_measure (m s)) /\
         (!s t. s IN f /\ t IN f /\ ~(s = t) ==> real_negligible(s INTER t))
         ==> real_measure(UNIONS f) = sum f m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS])

  let HAS_REAL_MEASURE_DISJOINT_UNIONS ← prove
   r"!m f. FINITE f /\
         (!s. s IN f ==> s has_real_measure (m s)) /\
         (!s t. s IN f /\ t IN f /\ ~(s = t) ==> DISJOINT s t)
         ==> (UNIONS f) has_real_measure (sum f m)"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS THEN
    ASM_SIMP_TAC [REAL_NEGLIGIBLE_EMPTY])

  let REAL_MEASURE_DISJOINT_UNIONS ← prove
   r"!m f:(real->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> s has_real_measure (m s)) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t) ==> DISJOINT s t)
        ==> real_measure(UNIONS f) = sum f m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_DISJOINT_UNIONS])

  let HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE ← prove
   r"!f:A->(real->bool) s.
        FINITE s /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> real_negligible((f x) INTER (f y)))
        ==> (UNIONS (IMAGE f s)) has_real_measure
            (sum s (\x. real_measure(f x)))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"sum s (\x. real_measure(f x)) =
      sum (IMAGE (f:A->real->bool) s) real_measure")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      MATCH_MP_TAC SUM_IMAGE_NONZERO THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
      ASM_SIMP_TAC [INTER_ACI, REAL_MEASURABLE_REAL_MEASURE_EQ_0],
      MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS THEN
      ASM_SIMP_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [FINITE_IMAGE, HAS_REAL_MEASURE_MEASURE]])

  let REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE ← prove
   r"!f:A->real->bool s.
        FINITE s /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> real_negligible((f x) INTER (f y)))
        ==> real_measure(UNIONS (IMAGE f s)) = sum s (\x. real_measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE])

  let HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE ← prove
   r"!f:A->real->bool s.
        FINITE s /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> (UNIONS (IMAGE f s)) has_real_measure
            (sum s (\x. real_measure(f x)))"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE THEN
    ASM_SIMP_TAC [REAL_NEGLIGIBLE_EMPTY])

  let REAL_MEASURE_DISJOINT_UNIONS_IMAGE ← prove
   r"!f:A->real->bool s.
        FINITE s /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> real_measure(UNIONS (IMAGE f s)) = sum s (\x. real_measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE])

  pure { REAL_NEGLIGIBLE_REAL_INTERVAL, REAL_MEASURABLE_UNIONS,
         HAS_REAL_MEASURE_DIFF_SUBSET, REAL_MEASURABLE_DIFF, REAL_MEASURE_DIFF_SUBSET,
         HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE, HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE,
         HAS_REAL_MEASURE_UNION_REAL_NEGLIGIBLE_EQ,
         HAS_REAL_MEASURE_DIFF_REAL_NEGLIGIBLE_EQ, HAS_REAL_MEASURE_ALMOST,
         HAS_REAL_MEASURE_ALMOST_EQ, REAL_MEASURABLE_ALMOST,
         HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNION, REAL_MEASURE_REAL_NEGLIGIBLE_UNION,
         HAS_REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF,
         REAL_MEASURABLE_REAL_NEGLIGIBLE_SYMDIFF, REAL_MEASURE_REAL_NEGLIGIBLE_SYMDIFF,
         HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS, REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS,
         HAS_REAL_MEASURE_DISJOINT_UNIONS, REAL_MEASURE_DISJOINT_UNIONS,
         HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE,
         REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE, HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE,
         REAL_MEASURE_DISJOINT_UNIONS_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Measures of real sets (part 3: strong unions, union bounds, inner/outer). -/
/- (realanalysis.ml 10778-10980)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAU where
  HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG : thm
  REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG : thm
  HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG : thm
  REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG : thm
  REAL_MEASURE_UNION : thm
  REAL_MEASURE_UNION_LE : thm
  REAL_MEASURE_UNIONS_LE : thm
  REAL_MEASURE_UNIONS_LE_IMAGE : thm
  REAL_NEGLIGIBLE_OUTER : thm
  REAL_NEGLIGIBLE_OUTER_LE : thm
  REAL_MEASURABLE_INNER_OUTER : thm
  HAS_REAL_MEASURE_INNER_OUTER : thm
  HAS_REAL_MEASURE_INNER_OUTER_LE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAU [HolBase] (D : RealAnalysisDeps) (BRZAK : RZAK) (BRZAM : RZAM) (BRZAP : RZAP) (BRZAS : RZAS) (BRZAT : RZAT) : ExceptT String IO RZAU := do
  -- @@SCOPE BEGIN
  let { real_negligible, .. } := BRZAK
  let { REAL_NEGLIGIBLE_EMPTY, .. } := BRZAM
  let { REAL_INTEGRABLE_STRADDLE, .. } := BRZAP
  let { HAS_REAL_MEASURE, HAS_REAL_MEASURE_MEASURE,
        HAS_REAL_MEASURE_REAL_MEASURABLE_REAL_MEASURE, REAL_MEASURABLE_INTER,
        REAL_MEASURABLE_MEASURABLE, REAL_MEASURABLE_REAL_INTEGRABLE, REAL_MEASURABLE_UNION,
        REAL_MEASURE_DISJOINT_UNION, REAL_MEASURE_EMPTY, REAL_MEASURE_MEASURE,
        REAL_MEASURE_POS_LE, REAL_MEASURE_SUBSET, REAL_MEASURE_UNIQUE, .. } := BRZAS
  let { HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE, REAL_MEASURABLE_DIFF,
        REAL_MEASURABLE_UNIONS, .. } := BRZAT
  let { EXISTS_LIFT_IMAGE, SUBSET_LIFT_IMAGE, .. } := D.qvectors
  let { NEGLIGIBLE_OUTER, NEGLIGIBLE_OUTER_LE, .. } := D.qmeasure
  let { REAL_SUB_SUB2, SUM_IMAGE_LE, .. } := D.ts.cn.ms.qsession
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { REAL_SUB_ADD2, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, DISJOINT, EQ_IMP, EQ_TRANS, ETA_AX, EXTENSION, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_RESTRICT, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNIONS, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, REAL_ABS_NUM,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_EQ_SUB_LADD, REAL_LE_LADD, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_LT, REAL_POS, REAL_SUB_REFL, RIGHT_AND_EXISTS_THM, SUBSET,
        SUBSET_REFL, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUM_CLAUSES, SUM_SUPERSET, UNIONS_0, UNIONS_INSERT,
        .. } := D.ts.cn.cx.cvx.core6
  let { DROP_VEC, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  -- @@SCOPE END

  let HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> real_negligible((f x) INTER (f y)))
        ==> (UNIONS (IMAGE f s)) has_real_measure
            (sum s (\x. real_measure(f x)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:A->real->bool",
                      ← q r"{x | x IN s /\ ~((f:A->real->bool) x = {})}"]
          HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, FINITE_RESTRICT] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [IN_UNIONS, IN_IMAGE, IN_ELIM_THM] THEN
      MESON_TAC [NOT_IN_EMPTY],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, ← TAUT (← q r"a /\ ~(a /\ b) <=> a /\ ~b")] THEN
      REWRITE_TAC [REAL_MEASURE_EMPTY]])

  let REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> real_negligible((f x) INTER (f y)))
        ==> real_measure(UNIONS (IMAGE f s)) = sum s (\x. real_measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG])

  let HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> (UNIONS (IMAGE f s)) has_real_measure
            (sum s (\x. real_measure(f x)))"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG THEN
    ASM_SIMP_TAC [REAL_NEGLIGIBLE_EMPTY])

  let REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> real_measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> real_measure(UNIONS (IMAGE f s)) = sum s (\x. real_measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG])

  let REAL_MEASURE_UNION ← prove
   r"!s t. real_measurable s /\ real_measurable t
         ==> real_measure(s UNION t) =
             real_measure(s) + real_measure(t) - real_measure(s INTER t)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"s UNION t = (s INTER t) UNION (s DIFF t) UNION (t DIFF s)")] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a + b - c:real = c + (a - c) + (b - c)")] THEN
    MP_TAC (← ISPECL [← q r"s DIFF t:real->bool", ← q r"t DIFF s:real->bool"]
          REAL_MEASURE_DISJOINT_UNION) THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_DIFF] THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s INTER t:real->bool",
                      ← q r"(s DIFF t) UNION (t DIFF s):real->bool"]
                  REAL_MEASURE_DISJOINT_UNION) THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_DIFF,
                  REAL_MEASURABLE_UNION, REAL_MEASURABLE_INTER] THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REPEAT (DISCH_THEN SUBST1_TAC) THEN AP_TERM_TAC THEN BINOP_TAC THEN
    REWRITE_TAC [REAL_EQ_SUB_LADD] THEN MATCH_MP_TAC EQ_TRANS THENL
     [EXISTS_TAC (← q r"real_measure((s DIFF t) UNION (s INTER t):real->bool)"),
      EXISTS_TAC (← q r"real_measure((t DIFF s) UNION (s INTER t):real->bool)")] THEN
    (CONJ_TAC THENL
      [CONV_TAC SYM_CONV THEN MATCH_MP_TAC REAL_MEASURE_DISJOINT_UNION THEN
       ASM_SIMP_TAC [REAL_MEASURABLE_DIFF, REAL_MEASURABLE_INTER],
       AP_TERM_TAC] THEN
     SET_TAC []))

  let REAL_MEASURE_UNION_LE ← prove
   r"!s t. real_measurable s /\ real_measurable t
         ==> real_measure(s UNION t) <= real_measure s + real_measure t"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [REAL_MEASURE_UNION] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + b - c <= a + b <=> &0 <= c")] THEN
    MATCH_MP_TAC REAL_MEASURE_POS_LE THEN ASM_SIMP_TAC [REAL_MEASURABLE_INTER])

  let REAL_MEASURE_UNIONS_LE ← prove
   r"!f. FINITE f /\ (!s. s IN f ==> real_measurable s)
       ==> real_measure(UNIONS f) <= sum f (\s. real_measure s)"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, UNIONS_INSERT, SUM_CLAUSES] THEN
    REWRITE_TAC [REAL_MEASURE_EMPTY, REAL_LE_REFL] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real->bool", ← q r"f:(real->bool)->bool"] THEN
    REWRITE_TAC [IN_INSERT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"real_measure(s) + real_measure(UNIONS f)") THEN
    ASM_SIMP_TAC [REAL_MEASURE_UNION_LE, REAL_MEASURABLE_UNIONS] THEN
    REWRITE_TAC [REAL_LE_LADD] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [])

  let REAL_MEASURE_UNIONS_LE_IMAGE ← prove
   r"!f:A->bool s:A->(real->bool).
        FINITE f /\ (!a. a IN f ==> real_measurable(s a))
        ==> real_measure(UNIONS (IMAGE s f)) <= sum f (\a. real_measure(s a))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum (IMAGE s (f:A->bool)) (\k:real->bool. real_measure k)") THEN
    ASM_SIMP_TAC [REAL_MEASURE_UNIONS_LE, FORALL_IN_IMAGE, FINITE_IMAGE] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
    REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC SUM_IMAGE_LE THEN
    ASM_SIMP_TAC [REAL_MEASURE_POS_LE])

  let REAL_NEGLIGIBLE_OUTER ← prove
   r"!s. real_negligible s <=>
       !e. &0 < e
           ==> ?t. s SUBSET t /\ real_measurable t /\ real_measure t < e"
   (REWRITE_TAC [real_negligible, REAL_MEASURABLE_MEASURABLE,
                 REAL_MEASURE_MEASURE, SUBSET_LIFT_IMAGE,
                 NEGLIGIBLE_OUTER, EXISTS_LIFT_IMAGE])

  let REAL_NEGLIGIBLE_OUTER_LE ← prove
   r"!s. real_negligible s <=>
       !e. &0 < e
           ==> ?t. s SUBSET t /\ real_measurable t /\ real_measure t <= e"
   (REWRITE_TAC [real_negligible, REAL_MEASURABLE_MEASURABLE,
                 REAL_MEASURE_MEASURE, SUBSET_LIFT_IMAGE,
                 NEGLIGIBLE_OUTER_LE, EXISTS_LIFT_IMAGE])

  let REAL_MEASURABLE_INNER_OUTER ← prove
   r"!s. real_measurable s <=>
                !e. &0 < e
                    ==> ?t u. t SUBSET s /\ s SUBSET u /\
                              real_measurable t /\ real_measurable u /\
                              abs(real_measure t - real_measure u) < e"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN REPEAT (EXISTS_TAC (← q r"s:real->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL, REAL_SUB_REFL, REAL_ABS_NUM],
      ALL_TAC] THEN
    REWRITE_TAC [REAL_MEASURABLE_REAL_INTEGRABLE] THEN
    MATCH_MP_TAC REAL_INTEGRABLE_STRADDLE THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real->bool", ← q r"u:real->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\x. if x IN t then &1 else &0):real->real",
      ← q r"(\x. if x IN u then &1 else &0):real->real",
      ← q r"real_measure(t:real->bool)",
      ← q r"real_measure(u:real->bool)"] THEN
    ASM_REWRITE_TAC [← GSYM HAS_REAL_MEASURE, ← GSYM HAS_REAL_MEASURE_MEASURE] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN REPEAT STRIP_TAC THEN
    REPEAT (COND_CASES_TAC THEN
            ASM_REWRITE_TAC [DROP_VEC, REAL_POS, REAL_LE_REFL]) THEN
    ASM SET_TAC [])

  let HAS_REAL_MEASURE_INNER_OUTER ← prove
   r"!s m. s has_real_measure m <=>
                (!e. &0 < e ==> ?t. t SUBSET s /\ real_measurable t /\
                                    m - e < real_measure t) /\
                (!e. &0 < e ==> ?u. s SUBSET u /\ real_measurable u /\
                                    real_measure u < m + e)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV
        [HAS_REAL_MEASURE_REAL_MEASURABLE_REAL_MEASURE] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"s:real->bool") THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "t") (LABEL_TAC "u")) THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC id [REAL_MEASURABLE_INNER_OUTER] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "u" (MP_TAC o SPEC (← q r"e / &2")) THEN
      REMOVE_THEN "t" (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      REWRITE_TAC [IMP_IMP, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ t <= u /\ m - e / &2 < t /\ u < m + e / &2
                            ==> abs(t - u) < e")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"~(&0 < x - y) /\ ~(&0 < y - x) ==> x = y")) THEN
      CONJ_TAC THEN DISCH_TAC THENL
       [REMOVE_THEN "u" (MP_TAC o SPEC (← q r"real_measure(s:real->bool) - m")) THEN
        ASM_REWRITE_TAC [REAL_SUB_ADD2, ← GSYM REAL_NOT_LE],
        REMOVE_THEN "t" (MP_TAC o SPEC (← q r"m - real_measure(s:real->bool)")) THEN
        ASM_REWRITE_TAC [REAL_SUB_SUB2, ← GSYM REAL_NOT_LE]] THEN
      ASM_MESON_TAC [REAL_MEASURE_SUBSET]])

  let HAS_REAL_MEASURE_INNER_OUTER_LE ← prove
   r"!s:real->bool m.
        s has_real_measure m <=>
                (!e. &0 < e ==> ?t. t SUBSET s /\ real_measurable t /\
                                    m - e <= real_measure t) /\
                (!e. &0 < e ==> ?u. s SUBSET u /\ real_measurable u /\
                                    real_measure u <= m + e)"
   (REWRITE_TAC [HAS_REAL_MEASURE_INNER_OUTER] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < e /\ m - e / &2 <= t ==> m - e < t"),
               ← REAL_ARITH (← q r"&0 < e /\ u <= m + e / &2 ==> u < m + e"),
               ← REAL_ARITH (← q r"&0 < e <=> &0 < e / &2"), REAL_LT_IMP_LE])

  pure { HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG,
         REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE_STRONG,
         HAS_REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG,
         REAL_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG, REAL_MEASURE_UNION,
         REAL_MEASURE_UNION_LE, REAL_MEASURE_UNIONS_LE, REAL_MEASURE_UNIONS_LE_IMAGE,
         REAL_NEGLIGIBLE_OUTER, REAL_NEGLIGIBLE_OUTER_LE, REAL_MEASURABLE_INNER_OUTER,
         HAS_REAL_MEASURE_INNER_OUTER, HAS_REAL_MEASURE_INNER_OUTER_LE }
/- ------------------------------------------------------------------------- -/
/- Measures of real sets (part 4: affinity, translation, scaling, nested     -/
/- unions).                                                                  -/
/- (realanalysis.ml 10981-11100)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAV where
  HAS_REAL_MEASURE_AFFINITY : thm
  HAS_REAL_MEASURE_SCALING : thm
  HAS_REAL_MEASURE_TRANSLATION : thm
  REAL_NEGLIGIBLE_TRANSLATION : thm
  HAS_REAL_MEASURE_TRANSLATION_EQ : thm
  REAL_NEGLIGIBLE_TRANSLATION_REV : thm
  REAL_NEGLIGIBLE_TRANSLATION_EQ : thm
  REAL_MEASURABLE_TRANSLATION : thm
  REAL_MEASURE_TRANSLATION : thm
  HAS_REAL_MEASURE_SCALING_EQ : thm
  REAL_MEASURABLE_SCALING : thm
  REAL_MEASURABLE_SCALING_EQ : thm
  REAL_MEASURE_SCALING : thm
  HAS_REAL_MEASURE_NESTED_UNIONS : thm
  REAL_MEASURABLE_NESTED_UNIONS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAV [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZAK : RZAK) (BRZAS : RZAS) : ExceptT String IO RZAV := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { real_measurable, .. } := BRZAK
  let { HAS_REAL_MEASURE_0, HAS_REAL_MEASURE_HAS_MEASURE, HAS_REAL_MEASURE_MEASURE,
        REAL_MEASURABLE_MEASURABLE, REAL_MEASURE_MEASURE, REAL_MEASURE_UNIQUE, .. } := BRZAS
  let { HAS_MEASURE_AFFINITY, HAS_MEASURE_NESTED_UNIONS, .. } := D.qmeasure
  let { MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.ts.cn.cx.cpx
  let { IMAGE_UNIONS, .. } := D.ts.cn.ms.ig.qsession
  let { DIMINDEX_1, EQ_IMP, .. } := D.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMAGE_o, IMAGE_SUBSET, .. } := D.ts.cn.cx.cvx.core2
  let { REAL_ABS_MUL, REAL_ABS_NUM, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_POW_MUL, REAL_POW_ONE,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_DROP, LIFT_ADD, LIFT_CMUL, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  -- @@SCOPE END

  let HAS_REAL_MEASURE_AFFINITY ← prove
   r"!s m c y. s has_real_measure y
             ==> (IMAGE (\x. m * x + c) s) has_real_measure abs(m) * y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_REAL_MEASURE_HAS_MEASURE] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"m:real", ← q r"lift c"] o MATCH_MP
      HAS_MEASURE_AFFINITY) THEN
    REWRITE_TAC [DIMINDEX_1, REAL_POW_1, ← GSYM IMAGE_o] THEN
    MATCH_MP_TAC EQ_IMP THEN REPEAT (AP_THM_TAC THEN AP_TERM_TAC) THEN
    SIMP_TAC [FUN_EQ_THM, FORALL_DROP, o_THM, LIFT_DROP, LIFT_ADD, LIFT_CMUL])

  let HAS_REAL_MEASURE_SCALING ← prove
   r"!s m y. s has_real_measure y
           ==> (IMAGE (\x. m * x) s) has_real_measure abs(m) * y"
   (ONCE_REWRITE_TAC [← REAL_ARITH (← q r"m * x = m * x + &0")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs m * x + &0 = abs m * x")] THEN
    REWRITE_TAC [HAS_REAL_MEASURE_AFFINITY])

  let HAS_REAL_MEASURE_TRANSLATION ← prove
   r"!s m a. s has_real_measure m ==> (IMAGE (\x. a + x) s) has_real_measure m"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a + x = &1 * x + a")] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← REAL_ARITH (← q r"m = abs(&1) * m")] THEN
    REWRITE_TAC [HAS_REAL_MEASURE_AFFINITY])

  let REAL_NEGLIGIBLE_TRANSLATION ← prove
   r"!s a. real_negligible s ==> real_negligible (IMAGE (\x. a + x) s)"
   (SIMP_TAC [← GSYM HAS_REAL_MEASURE_0, HAS_REAL_MEASURE_TRANSLATION])

  let HAS_REAL_MEASURE_TRANSLATION_EQ ← prove
   r"!s m. (IMAGE (\x. a + x) s) has_real_measure m <=> s has_real_measure m"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [HAS_REAL_MEASURE_TRANSLATION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--a:real") o
      MATCH_MP HAS_REAL_MEASURE_TRANSLATION) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← REAL_ARITH (← q r"--a + a + b:real = b")] THEN
    SET_TAC [])

  let REAL_NEGLIGIBLE_TRANSLATION_REV ← prove
   r"!s a. real_negligible (IMAGE (\x. a + x) s) ==> real_negligible s"
   (SIMP_TAC [← GSYM HAS_REAL_MEASURE_0, HAS_REAL_MEASURE_TRANSLATION_EQ])

  let REAL_NEGLIGIBLE_TRANSLATION_EQ ← prove
   r"!s a. real_negligible (IMAGE (\x. a + x) s) <=> real_negligible s"
   (SIMP_TAC [← GSYM HAS_REAL_MEASURE_0, HAS_REAL_MEASURE_TRANSLATION_EQ])

  let REAL_MEASURABLE_TRANSLATION ← prove
   r"!s. real_measurable (IMAGE (\x. a + x) s) <=> real_measurable s"
   (REWRITE_TAC [real_measurable, HAS_REAL_MEASURE_TRANSLATION_EQ])

  let REAL_MEASURE_TRANSLATION ← prove
   r"!s. real_measurable s
       ==> real_measure(IMAGE (\x. a + x) s) = real_measure s"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_REWRITE_TAC [HAS_REAL_MEASURE_TRANSLATION_EQ])

  let HAS_REAL_MEASURE_SCALING_EQ ← prove
   r"!s m c. ~(c = &0)
           ==> ((IMAGE (\x. c * x) s) has_real_measure (abs(c) * m) <=>
                s has_real_measure m)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [HAS_REAL_MEASURE_SCALING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c:real)") o
      MATCH_MP HAS_REAL_MEASURE_SCALING) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← GSYM REAL_ABS_MUL] THEN
    REWRITE_TAC [← GSYM REAL_POW_MUL, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [← GSYM REAL_ABS_MUL, REAL_MUL_LINV] THEN
    REWRITE_TAC [REAL_POW_ONE, REAL_ABS_NUM, REAL_MUL_LID] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let REAL_MEASURABLE_SCALING ← prove
   r"!s c. real_measurable s ==> real_measurable (IMAGE (\x. c * x) s)"
   (REWRITE_TAC [real_measurable] THEN MESON_TAC [HAS_REAL_MEASURE_SCALING])

  let REAL_MEASURABLE_SCALING_EQ ← prove
   r"!s c. ~(c = &0)
         ==> (real_measurable (IMAGE (\x. c * x) s) <=> real_measurable s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [REAL_MEASURABLE_SCALING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv c:real") o MATCH_MP REAL_MEASURABLE_SCALING) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← GSYM REAL_ABS_MUL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LID] THEN
    SET_TAC [])

  let REAL_MEASURE_SCALING ← prove
   r"!s. real_measurable s
       ==> real_measure(IMAGE (\x. c * x) s) = abs(c) * real_measure s"
   (REWRITE_TAC [HAS_REAL_MEASURE_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_REAL_MEASURE_SCALING])

  let HAS_REAL_MEASURE_NESTED_UNIONS ← prove
   r"!s B. (!n. real_measurable(s n)) /\
         (!n. real_measure(s n) <= B) /\
         (!n. s(n) SUBSET s(SUC n))
         ==> real_measurable(UNIONS { s(n) | n IN (:num) }) /\
             ((\n. real_measure(s n))
                   ---> real_measure(UNIONS { s(n) | n IN (:num) }))
             sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL, o_DEF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [REAL_MEASURE_MEASURE] THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [REAL_MEASURABLE_MEASURABLE] THEN
    REPEAT (DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
    MP_TAC (← ISPECL [← q r"IMAGE lift o (s:num->real->bool)", ← q r"B:real"]
          HAS_MEASURE_NESTED_UNIONS) THEN
    ASM_SIMP_TAC [o_THM, IMAGE_SUBSET] THEN
    REWRITE_TAC [← SET_RULE (← q r"{IMAGE f (s n) | P n} = IMAGE (IMAGE f) {s n | P n}"),
                 ← GSYM IMAGE_UNIONS] THEN
    SIMP_TAC [REAL_MEASURE_MEASURE, REAL_MEASURABLE_MEASURABLE])

  let REAL_MEASURABLE_NESTED_UNIONS ← prove
   r"!s B. (!n. real_measurable(s n)) /\
         (!n. real_measure(s n) <= B) /\
         (!n. s(n) SUBSET s(SUC n))
         ==> real_measurable(UNIONS { s(n) | n IN (:num) })"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_MEASURE_NESTED_UNIONS) THEN
    SIMP_TAC [])

  pure { HAS_REAL_MEASURE_AFFINITY, HAS_REAL_MEASURE_SCALING,
         HAS_REAL_MEASURE_TRANSLATION, REAL_NEGLIGIBLE_TRANSLATION,
         HAS_REAL_MEASURE_TRANSLATION_EQ, REAL_NEGLIGIBLE_TRANSLATION_REV,
         REAL_NEGLIGIBLE_TRANSLATION_EQ, REAL_MEASURABLE_TRANSLATION,
         REAL_MEASURE_TRANSLATION, HAS_REAL_MEASURE_SCALING_EQ, REAL_MEASURABLE_SCALING,
         REAL_MEASURABLE_SCALING_EQ, REAL_MEASURE_SCALING, HAS_REAL_MEASURE_NESTED_UNIONS,
         REAL_MEASURABLE_NESTED_UNIONS }
/- ------------------------------------------------------------------------- -/
/- Measures of real sets (part 5: countable unions and intersections, area   -/
/- under a curve).                                                           -/
/- (realanalysis.ml 11101-11358)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAW where
  HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS : thm
  REAL_NEGLIGIBLE_COUNTABLE_UNIONS : thm
  REAL_MEASURABLE_COUNTABLE_UNIONS_STRONG : thm
  HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS_BOUNDED : thm
  REAL_MEASURABLE_COUNTABLE_UNIONS : thm
  REAL_MEASURABLE_COUNTABLE_UNIONS_BOUNDED : thm
  REAL_MEASURABLE_COUNTABLE_INTERS : thm
  REAL_NEGLIGIBLE_COUNTABLE : thm
  REAL_MEASURABLE_COMPACT : thm
  REAL_MEASURABLE_OPEN : thm
  HAS_REAL_INTEGRAL_NEGLIGIBLE_EQ : thm
  HAS_REAL_INTEGRAL_AREA_UNDER_CURVE_UNIV : thm
  HAS_REAL_INTEGRAL_AREA_UNDER_CURVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAW [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZC : RZC) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAM : RZAM) (BRZAO : RZAO) (BRZAP : RZAP) (BRZAS : RZAS) (BRZAT : RZAT) (BRZAU : RZAU) (BRZAV : RZAV) : ExceptT String IO RZAW := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, real_compact, REAL_OPEN, TENDSTO_REAL, .. } := BRZA
  let { REAL_SERIES_0, REAL_SERIES_UNIQUE, real_sums, REAL_SUMS, .. } := BRZC
  let { has_real_integral, real_measurable, real_negligible, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_LMUL, .. } := BRZAL
  let { HAS_REAL_INTEGRAL_NEGLIGIBLE, REAL_NEGLIGIBLE_SUBSET, .. } := BRZAM
  let { HAS_REAL_INTEGRAL_RESTRICT_UNIV, .. } := BRZAO
  let { HAS_REAL_INTEGRAL_STRADDLE_NULL, .. } := BRZAP
  let { HAS_REAL_MEASURE, HAS_REAL_MEASURE_0, REAL_MEASURABLE_MEASURABLE,
        REAL_MEASURABLE_REAL_MEASURE_EQ_0, REAL_MEASURE_EQ_0, REAL_MEASURE_MEASURE,
        REAL_MEASURE_SUBSET, REAL_MEASURE_UNIQUE, .. } := BRZAS
  let { HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE, REAL_MEASURABLE_DIFF,
        REAL_MEASURABLE_UNIONS, .. } := BRZAT
  let { REAL_MEASURE_UNIONS_LE_IMAGE, .. } := BRZAU
  let { HAS_REAL_MEASURE_NESTED_UNIONS, REAL_MEASURABLE_NESTED_UNIONS, .. } := BRZAV
  let { IMAGE_INTER_INJ, .. } := D.qsession
  let { HAS_INTEGRAL_MEASURE_UNDER_CURVE, HAS_MEASURE_ALMOST_EQ,
        HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED, HAS_MEASURE_ISOMETRY,
        MEASURABLE_COMPACT, MEASURABLE_COUNTABLE_UNIONS_BOUNDED, MEASURABLE_OPEN,
        .. } := D.qmeasure
  let { NEGLIGIBLE_COUNTABLE, NEGLIGIBLE_STANDARD_HYPERPLANE,
        .. } := D.ts.cn.ms.qintegration3
  let { FROM_0, .. } := D.ts.cn.ms.qmisc
  let { IN_NUMSEG_0, .. } := D.ts.cn.ms.qsession
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { FORALL_2, LE_0, SUB_ADD, .. } := D.ts.cn.cx.cpx
  let { IMAGE_UNIONS, pastecart, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, CART_EQ, DIMINDEX_1, DIMINDEX_2, DIMINDEX_FINITE_SUM, EXISTS_IN_GSPEC,
        EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PASTECART, IMAGE_SUBSET, IN_DIFF,
        IN_ELIM_PASTECART_THM, INTER_SUBSET, INTER_UNIV, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTERS, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV, LAMBDA_BETA, LE_1,
        LE_REFL, REAL_ARCH_INV, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_SYM, REAL_OF_NUM_ADD, REAL_POS, RIGHT_FORALL_IMP_THM,
        SIMPLE_IMAGE, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_div, real_ge, SUM_0, SURJECTIVE_IMAGE_EQ,
        .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ts.cn.cx.cvx.lib
  let { DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { dot, drop, linear, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        .. } := D.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, .. } := D.ts.cn.cx.cvx.top4
  let { REAL_ABS_NZ, .. } := D.ts.cn.ms.ig.dv.qsession
  let { SUBSET_UNIONS, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  let { EXISTS_IN_UNIONS, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS ← prove
   r"!s:num->real->bool B.
        (!n. real_measurable(s n)) /\
        (!m n. ~(m = n) ==> real_negligible(s m INTER s n)) /\
        (!n. sum (0..n) (\k. real_measure(s k)) <= B)
        ==> real_measurable(UNIONS { s(n) | n IN (:num) }) /\
            ((\n. real_measure(s n)) real_sums
             real_measure(UNIONS { s(n) | n IN (:num) })) (from 0)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. UNIONS (IMAGE s (0..n)):real->bool", ← q r"B:real"]
                 HAS_REAL_MEASURE_NESTED_UNIONS) THEN
    REWRITE_TAC [real_sums, FROM_0, INTER_UNIV] THEN
    SUBGOAL_THEN
     (← q r"!n. (UNIONS (IMAGE s (0..n)):real->bool) has_real_measure
          (sum(0..n) (\k. real_measure(s k)))")
    MP_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC HAS_REAL_MEASURE_REAL_NEGLIGIBLE_UNIONS_IMAGE THEN
      ASM_SIMP_TAC [FINITE_NUMSEG],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (ASSUME_TAC th THEN
        ASSUME_TAC (← GEN (← q r"n:num") (← MATCH_MP REAL_MEASURE_UNIQUE
         (← SPEC (← q r"n:num") th))))) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [real_measurable], ALL_TAC] THEN
      GEN_TAC THEN MATCH_MP_TAC SUBSET_UNIONS THEN
      MATCH_MP_TAC IMAGE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_NUMSEG] THEN ARITH_TAC,
      ALL_TAC] THEN
    SIMP_TAC [LIFT_SUM, FINITE_NUMSEG, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"UNIONS {UNIONS (IMAGE s (0..n)) | n IN (:num)}:real->bool =
      UNIONS (IMAGE s (:num))")
     (fun th => REWRITE_TAC [th] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
                REWRITE_TAC []) THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real") THEN
    REWRITE_TAC [IN_UNIONS] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_IN_UNIONS, IN_UNIV] THEN
    REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [IN_NUMSEG, LE_0] THEN MESON_TAC [LE_REFL])

  let REAL_NEGLIGIBLE_COUNTABLE_UNIONS ← prove
   r"!s:num->real->bool.
        (!n. real_negligible(s n))
        ==> real_negligible(UNIONS {s(n) | n IN (:num)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:num->real->bool", ← q r"&0"]
      HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS) THEN
    ASM_SIMP_TAC [REAL_MEASURE_EQ_0, SUM_0, REAL_LE_REFL, LIFT_NUM] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [HAS_REAL_MEASURE_0, real_measurable, INTER_SUBSET,
                     REAL_NEGLIGIBLE_SUBSET],
      ALL_TAC] THEN
    SIMP_TAC [← GSYM REAL_MEASURABLE_REAL_MEASURE_EQ_0] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC REAL_SERIES_UNIQUE THEN REWRITE_TAC [LIFT_NUM] THEN
    MAP_EVERY EXISTS_TAC [← q r"(\k. &0):num->real", ← q r"from 0"] THEN
    ASM_REWRITE_TAC [REAL_SERIES_0])

  let REAL_MEASURABLE_COUNTABLE_UNIONS_STRONG ← prove
   r"!s:num->real->bool B.
        (!n. real_measurable(s n)) /\
        (!n. real_measure(UNIONS {s k | k <= n}) <= B)
        ==> real_measurable(UNIONS { s(n) | n IN (:num) })"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. UNIONS (IMAGE s (0..n)):real->bool", ← q r"B:real"]
                 REAL_MEASURABLE_NESTED_UNIONS) THEN
    SUBGOAL_THEN
     (← q r"UNIONS {UNIONS (IMAGE s (0..n)) | n IN (:num)}:real->bool =
      UNIONS (IMAGE s (:num))")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real") THEN
      REWRITE_TAC [IN_UNIONS] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_IN_UNIONS, IN_UNIV] THEN
      REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE] THEN
      REWRITE_TAC [IN_NUMSEG, LE_0] THEN MESON_TAC [LE_REFL],
      ALL_TAC] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC REAL_MEASURABLE_UNIONS THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, FINITE_NUMSEG],
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      ASM_REWRITE_TAC [IN_NUMSEG, LE_0],
      GEN_TAC THEN MATCH_MP_TAC SUBSET_UNIONS THEN
      MATCH_MP_TAC IMAGE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_NUMSEG, LE_0] THEN ARITH_TAC])

  let HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS_BOUNDED ← prove
   r"!s. (!n. real_measurable(s n)) /\
       (!m n. ~(m = n) ==> real_negligible(s m INTER s n)) /\
       real_bounded(UNIONS { s(n) | n IN (:num) })
       ==> real_measurable(UNIONS { s(n) | n IN (:num) }) /\
           ((\n. real_measure(s n)) real_sums
            real_measure(UNIONS { s(n) | n IN (:num) })) (from 0)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TENDSTO_REAL, o_DEF] THEN
    REWRITE_TAC [REAL_BOUNDED] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [REAL_MEASURE_MEASURE] THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [REAL_MEASURABLE_MEASURABLE, real_negligible] THEN
    REPEAT (DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
    MP_TAC (← ISPEC (← q r"IMAGE lift o (s:num->real->bool)")
          HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED) THEN
    ASM_SIMP_TAC [o_THM, IMAGE_SUBSET] THEN
    REWRITE_TAC [← SET_RULE (← q r"{IMAGE f (s n) | P n} = IMAGE (IMAGE f) {s n | P n}"),
                 ← GSYM IMAGE_UNIONS] THEN
    ASM_SIMP_TAC [← GSYM IMAGE_INTER_INJ, LIFT_EQ] THEN
    SIMP_TAC [REAL_SUMS, o_DEF, REAL_MEASURE_MEASURE,
              REAL_MEASURABLE_MEASURABLE])

  let REAL_MEASURABLE_COUNTABLE_UNIONS ← prove
   r"!s B. (!n. real_measurable(s n)) /\
         (!n. sum (0..n) (\k. real_measure(s k)) <= B)
         ==> real_measurable(UNIONS { s(n) | n IN (:num) })"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_MEASURABLE_COUNTABLE_UNIONS_STRONG THEN
    EXISTS_TAC (← q r"B:real") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(0..n) (\k. real_measure(s k:real->bool))") THEN
    ASM_REWRITE_TAC [] THEN
    W (MP_TAC o PART_MATCH (rand o rand) REAL_MEASURE_UNIONS_LE_IMAGE o
         rand o snd) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
    ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
    REWRITE_TAC [IN_NUMSEG, LE_0])

  let REAL_MEASURABLE_COUNTABLE_UNIONS_BOUNDED ← prove
   r"!s. (!n. real_measurable(s n)) /\
       real_bounded(UNIONS { s(n) | n IN (:num) })
       ==> real_measurable(UNIONS { s(n) | n IN (:num) })"
   (REWRITE_TAC [REAL_MEASURABLE_MEASURABLE, REAL_BOUNDED] THEN
    SIMP_TAC [IMAGE_INTER_INJ, LIFT_EQ, IMAGE_UNIONS] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f {g x | x IN s} = {f(g x) | x IN s}")] THEN
    REWRITE_TAC [MEASURABLE_COUNTABLE_UNIONS_BOUNDED])

  let REAL_MEASURABLE_COUNTABLE_INTERS ← prove
   r"!s. (!n. real_measurable(s n))
       ==> real_measurable(INTERS { s(n) | n IN (:num) })"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"INTERS { s(n):real->bool | n IN (:num) } =
                  s 0 DIFF (UNIONS {s 0 DIFF s n | n IN (:num)})")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC id [EXTENSION] THEN
      REWRITE_TAC [IN_INTERS, IN_DIFF, IN_UNIONS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_MEASURABLE_COUNTABLE_UNIONS_STRONG THEN
    EXISTS_TAC (← q r"real_measure(s 0:real->bool)") THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_DIFF, LE_0] THEN
    GEN_TAC THEN MATCH_MP_TAC REAL_MEASURE_SUBSET THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, IN_ELIM_THM, IN_DIFF] THEN
      MESON_TAC [IN_DIFF]] THEN
    ONCE_REWRITE_TAC [← GSYM IN_NUMSEG_0] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  REAL_MEASURABLE_DIFF, REAL_MEASURABLE_UNIONS])

  let REAL_NEGLIGIBLE_COUNTABLE ← prove
   r"!s. COUNTABLE s ==> real_negligible s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_negligible] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE THEN ASM_SIMP_TAC [COUNTABLE_IMAGE])

  let REAL_MEASURABLE_COMPACT ← prove
   r"!s. real_compact s ==> real_measurable s"
   (REWRITE_TAC [REAL_MEASURABLE_MEASURABLE, real_compact, MEASURABLE_COMPACT])

  let REAL_MEASURABLE_OPEN ← prove
   r"!s. real_bounded s /\ real_open s ==> real_measurable s"
   (REWRITE_TAC [REAL_MEASURABLE_MEASURABLE, REAL_OPEN, REAL_BOUNDED,
                 MEASURABLE_OPEN])

  let HAS_REAL_INTEGRAL_NEGLIGIBLE_EQ ← prove
   r"!f s. (!x. x IN s ==> &0 <= f(x))
         ==> ((f has_real_integral &0) s <=>
              real_negligible {x | x IN s /\ ~(f x = &0)})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC HAS_REAL_INTEGRAL_NEGLIGIBLE THEN
      EXISTS_TAC (← q r"{x | x IN s /\ ~((f:real->real) x = &0)}") THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN MESON_TAC []] THEN
    MATCH_MP_TAC REAL_NEGLIGIBLE_SUBSET THEN EXISTS_TAC
     (← q r"UNIONS {{x:real | x IN s /\ abs(f x) >= &1 / (&n + &1)} |
              n IN (:num)}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_NEGLIGIBLE_COUNTABLE_UNIONS THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [← GSYM HAS_REAL_MEASURE_0] THEN
      REWRITE_TAC [HAS_REAL_MEASURE] THEN
      MATCH_MP_TAC HAS_REAL_INTEGRAL_STRADDLE_NULL THEN
      EXISTS_TAC (← q r"\x:real. if x IN s then (&n + &1) * f(x) else &0") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_UNIV, IN_ELIM_THM, real_ge] THEN
        X_GEN_TAC (← q r"x:real") THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [REAL_POS] THENL
         [ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
          ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ a <= abs x ==> a <= x")) THEN
          ASM_SIMP_TAC [],
          COND_CASES_TAC THEN REWRITE_TAC [REAL_POS] THEN
          ASM_SIMP_TAC [REAL_POS, REAL_LE_MUL, REAL_LE_ADD]],
        REWRITE_TAC [HAS_REAL_INTEGRAL_RESTRICT_UNIV] THEN
        SUBST1_TAC (← REAL_ARITH (← q r"&0 = (&n + &1) * &0")) THEN
        MATCH_MP_TAC HAS_REAL_INTEGRAL_LMUL THEN ASM_REWRITE_TAC []],
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real") THEN
      REWRITE_TAC [REAL_ABS_NZ] THEN ONCE_REWRITE_TAC [REAL_ARCH_INV] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"n:num")
        STRIP_ASSUME_TAC)) THEN
      REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC] THEN
      EXISTS_TAC (← q r"n - 1") THEN ASM_SIMP_TAC [IN_UNIV, IN_ELIM_THM, real_ge] THEN
      ASM_SIMP_TAC [REAL_OF_NUM_ADD, SUB_ADD, LE_1] THEN
      ASM_SIMP_TAC [real_div, REAL_MUL_LID, REAL_LT_IMP_LE]])

  let HAS_REAL_INTEGRAL_AREA_UNDER_CURVE_UNIV ← prove
   r"!f m. (!x. &0 <= f x)
         ==> ((f has_real_integral m) (:real) <=>
              {z:real^2 | &0 <= z$2 /\ z$2 <= f(z$1)} has_measure m)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"m:real"]
          HAS_INTEGRAL_MEASURE_UNDER_CURVE) THEN
    ASM_REWRITE_TAC [has_real_integral, o_THM, LIFT_DROP, IMAGE_LIFT_UNIV] THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
    MP_TAC (← ISPEC
     (← q r"(\x. lambda i. x$i):real^(1,1)finite_sum->real^2")
     HAS_MEASURE_ISOMETRY) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
     [SIMP_TAC [NORM_EQ, dot, linear, CART_EQ, LAMBDA_BETA,
                VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1, DIMINDEX_2, ARITH],
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th]))] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    SIMP_TAC [pastecart, DIMINDEX_FINITE_SUM, DIMINDEX_1, DIMINDEX_2, ARITH,
              IN_ELIM_THM, LAMBDA_BETA, CART_EQ, FORALL_2, drop] THEN
    X_GEN_TAC (← q r"z:real^2") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(lambda i. (z:real^2)$i):real^(1,1)finite_sum") THEN
    SIMP_TAC [LAMBDA_BETA, DIMINDEX_FINITE_SUM, DIMINDEX_1, DIMINDEX_2, ARITH])

  let HAS_REAL_INTEGRAL_AREA_UNDER_CURVE ← prove
   r"!f s m.
      (!x. x IN s ==> &0 <= f x)
      ==> ((f has_real_integral m) s <=>
           {z:real^2 | z$1 IN s /\ &0 <= z$2 /\ z$2 <= f(z$1)} has_measure m)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"\x. if x IN s then (f:real->real) x else &0", ← q r"m:real"]
          HAS_REAL_INTEGRAL_AREA_UNDER_CURVE_UNIV) THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL_RESTRICT_UNIV] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [REAL_LE_REFL], DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC HAS_MEASURE_ALMOST_EQ THEN
    EXISTS_TAC (← q r"{z:real^2 | z$2 = &0}") THEN
    REWRITE_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_UNION] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  pure { HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS,
         REAL_NEGLIGIBLE_COUNTABLE_UNIONS, REAL_MEASURABLE_COUNTABLE_UNIONS_STRONG,
         HAS_REAL_MEASURE_COUNTABLE_REAL_NEGLIGIBLE_UNIONS_BOUNDED,
         REAL_MEASURABLE_COUNTABLE_UNIONS, REAL_MEASURABLE_COUNTABLE_UNIONS_BOUNDED,
         REAL_MEASURABLE_COUNTABLE_INTERS, REAL_NEGLIGIBLE_COUNTABLE,
         REAL_MEASURABLE_COMPACT, REAL_MEASURABLE_OPEN, HAS_REAL_INTEGRAL_NEGLIGIBLE_EQ,
         HAS_REAL_INTEGRAL_AREA_UNDER_CURVE_UNIV, HAS_REAL_INTEGRAL_AREA_UNDER_CURVE }

/- ------------------------------------------------------------------------- -/
/- Integration by parts; improper absolute integrals.                        -/
/- (realanalysis.ml 11359-11504)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAX where
  REAL_INTEGRATION_BY_PARTS : thm
  REAL_INTEGRATION_BY_PARTS_SIMPLE : thm
  REAL_INTEGRABLE_BY_PARTS : thm
  REAL_INTEGRABLE_BY_PARTS_EQ : thm
  ABSOLUTE_REAL_INTEGRATION_BY_PARTS : thm
  ABSOLUTE_REAL_INTEGRATION_BY_PARTS_SUM : thm
  ABSOLUTELY_REAL_INTEGRABLE_IMPROPER_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAX [HolBase] (D : RealAnalysisDeps) (BRZO : RZO) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAN : RZAN) (BRZAO : RZAO) : ExceptT String IO RZAX := do
  -- @@SCOPE BEGIN
  let { HAS_REAL_DERIVATIVE_MUL_ATREAL, HAS_REAL_DERIVATIVE_MUL_WITHIN, .. } := BRZO
  let { ABSOLUTELY_REAL_INTEGRABLE_ON, absolutely_real_integrable_on, HAS_REAL_INTEGRAL,
        real_integrable_on, REAL_INTEGRABLE_ON, REAL_INTEGRAL, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_SUB, REAL_INTEGRABLE_ON_NULL, .. } := BRZAL
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, .. } := BRZAN
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG, .. } := BRZAO
  let { real_bounded, .. } := D.qmetric
  let { DROP_IN_IMAGE_DROP, SUBSET_DROP_IMAGE, .. } := D.qvectors
  let { IMAGE_DROP_INTERVAL, .. } := D.qtopology
  let { ABSOLUTE_INTEGRATION_BY_PARTS, ABSOLUTE_INTEGRATION_BY_PARTS_SUM,
        ABSOLUTELY_INTEGRABLE_IMPROPER_SIMPLE, .. } := D.qmeasure
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, .. } := D.ts.cn.ms.qintegration1
  let { ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, .. } := D.ts.cn.cx.cvx
  let { REAL_ADD_SUB, .. } := D.ts.cn.cx.cpx
  let { CONJ_ASSOC, FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { REAL_MUL_SYM, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, FORALL_DROP, FORALL_LIFT, LIFT_ADD, LIFT_CMUL,
        LIFT_DROP, LIFT_EQ, LIFT_SUB, NORM_1, .. } := D.ts.cn.cx.cvx.vec2
  let { bilinear, linear, .. } := D.ts.cn.cx.cvx.vec4
  let { bounded, .. } := D.ts.cn.cx.cvx.top5
  -- @@SCOPE END

  let REAL_INTEGRATION_BY_PARTS ← prove
   r"!f g f' g' a b c.
        a <= b /\ COUNTABLE c /\
        (\x. f x * g x) real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) DIFF c
             ==> (f has_real_derivative f'(x)) (atreal x) /\
                 (g has_real_derivative g'(x)) (atreal x)) /\
        ((\x. f(x) * g'(x)) has_real_integral ((f b * g b - f a * g a) - y))
            (real_interval[a,b])
        ==> ((\x. f'(x) * g(x)) has_real_integral y) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x. (f:real->real)(x) * g(x)",
                      ← q r"\x. (f:real->real)(x) * g'(x) + f'(x) * g(x)",
                      ← q r"c:real->bool", ← q r"a:real", ← q r"b:real"]
      REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG) THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_MUL_ATREAL] THEN
    FIRST_ASSUM (fun th => tactic_of do
          pure (MP_TAC th THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
          DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_SUB))) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"b - a - (b - a - y):real = y"), REAL_ADD_SUB])

  let REAL_INTEGRATION_BY_PARTS_SIMPLE ← prove
   r"!f g f' g' a b.
        a <= b /\
        (!x. x IN real_interval[a,b]
             ==> (f has_real_derivative f'(x))
                    (atreal x within real_interval[a,b]) /\
                 (g has_real_derivative g'(x))
                    (atreal x within real_interval[a,b])) /\
        ((\x. f(x) * g'(x)) has_real_integral ((f b * g b - f a * g a) - y))
            (real_interval[a,b])
        ==> ((\x. f'(x) * g(x)) has_real_integral y) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x. (f:real->real)(x) * g(x)",
                      ← q r"\x. (f:real->real)(x) * g'(x) + f'(x) * g(x)",
                      ← q r"a:real", ← q r"b:real"] REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_MUL_WITHIN] THEN
    FIRST_ASSUM (fun th => tactic_of do
          pure (MP_TAC th THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
          DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_SUB))) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"b - a - (b - a - y):real = y"), REAL_ADD_SUB])

  let REAL_INTEGRABLE_BY_PARTS ← prove
   r"!f g f' g' a b c.
        COUNTABLE c /\
        (\x. f x * g x) real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) DIFF c
             ==> (f has_real_derivative f'(x)) (atreal x) /\
                 (g has_real_derivative g'(x)) (atreal x)) /\
        (\x. f(x) * g'(x)) real_integrable_on real_interval[a,b]
        ==> (\x. f'(x) * g(x)) real_integrable_on real_interval[a,b]"
   (REPEAT GEN_TAC THEN DISJ_CASES_TAC (← REAL_ARITH (← q r"b <= a \/ a <= b")) THEN
    ASM_SIMP_TAC [REAL_INTEGRABLE_ON_NULL] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [real_integrable_on] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"((f:real->real) b * g b - f a * g a) - y") THEN
    MATCH_MP_TAC REAL_INTEGRATION_BY_PARTS THEN MAP_EVERY EXISTS_TAC
     [← q r"f:real->real", ← q r"g':real->real", ← q r"c:real->bool"] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"b - a - ((b - a) - y):real = y")])

  let REAL_INTEGRABLE_BY_PARTS_EQ ← prove
   r"!f g f' g' a b c.
        COUNTABLE c /\
        (\x. f x * g x) real_continuous_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) DIFF c
             ==> (f has_real_derivative f'(x)) (atreal x) /\
                 (g has_real_derivative g'(x)) (atreal x))
        ==> ((\x. f(x) * g'(x)) real_integrable_on real_interval[a,b] <=>
             (\x. f'(x) * g(x)) real_integrable_on real_interval[a,b])"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [REAL_INTEGRABLE_BY_PARTS], DISCH_TAC] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    MATCH_MP_TAC REAL_INTEGRABLE_BY_PARTS THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_MESON_TAC [])

  let ABSOLUTE_REAL_INTEGRATION_BY_PARTS ← prove
   r"!f  g f' g' a b.
        a <= b /\
        f' absolutely_real_integrable_on real_interval[a,b] /\
        g' absolutely_real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b]
             ==> (f' has_real_integral f(x)) (real_interval[a,x])) /\
        (!x. x IN real_interval[a,b]
             ==> (g' has_real_integral g(x)) (real_interval[a,x]))
        ==> (\x. f x * g' x) absolutely_real_integrable_on
                real_interval[a,b] /\
            (\x. f' x * g x) absolutely_real_integrable_on
                real_interval[a,b] /\
            real_integral (real_interval[a,b]) (\x. f x * g' x) +
            real_integral (real_interval[a,b]) (\x. f' x * g x) =
            f b * g b - f a * g a"
   (REWRITE_TAC [FORALL_DROP, ABSOLUTELY_REAL_INTEGRABLE_ON, HAS_REAL_INTEGRAL,
                 ← GSYM IMAGE_DROP_INTERVAL, DROP_IN_IMAGE_DROP] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP, IMAGE_ID] THEN
    REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"bilinear (\x y. lift(drop x * drop y))") MP_TAC THENL
     [REWRITE_TAC [bilinear, linear, FORALL_LIFT, LIFT_DROP,
        DROP_ADD, DROP_CMUL, ← GSYM LIFT_ADD, LIFT_EQ, ← GSYM LIFT_CMUL] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTE_INTEGRATION_BY_PARTS) THEN
      REWRITE_TAC [LIFT_DROP] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [← GSYM LIFT_EQ, LIFT_ADD, LIFT_SUB] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN BINOP_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) REAL_INTEGRAL o lhs o snd) THEN
      ASM_SIMP_TAC [REAL_INTEGRABLE_ON, ← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                    LIFT_DROP, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]])

  let ABSOLUTE_REAL_INTEGRATION_BY_PARTS_SUM ← prove
   r"!f g f' g' a b.
        a <= b /\
        (f' absolutely_real_integrable_on real_interval[a,b] /\
         !x. x IN real_interval[a,b]
             ==> (f' has_real_integral f(x) - f(a)) (real_interval[a,x])) /\
        (g' absolutely_real_integrable_on real_interval[a,b] /\
         !x. x IN real_interval[a,b]
             ==> (g' has_real_integral g(x) - g(a)) (real_interval[a,x]))
        ==> (\x. f x * g' x +  f' x * g x) absolutely_real_integrable_on
            real_interval[a,b] /\
            !x. x IN real_interval[a,b]
             ==> ((\x. f x * g' x +  f' x * g x) has_real_integral
                  (f x * g x - f a * g a)) (real_interval[a,x])"
   (REWRITE_TAC [FORALL_DROP, ABSOLUTELY_REAL_INTEGRABLE_ON, HAS_REAL_INTEGRAL,
                 ← GSYM IMAGE_DROP_INTERVAL, DROP_IN_IMAGE_DROP] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP, IMAGE_ID] THEN
    REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"bilinear (\x y. lift(drop x * drop y))") MP_TAC THENL
     [REWRITE_TAC [bilinear, linear, FORALL_LIFT, LIFT_DROP,
        DROP_ADD, DROP_CMUL, ← GSYM LIFT_ADD, LIFT_EQ, ← GSYM LIFT_CMUL] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [IMP_IMP, LIFT_SUB] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTE_INTEGRATION_BY_PARTS_SUM) THEN
      REWRITE_TAC [LIFT_DROP, LIFT_ADD, LIFT_SUB]])

  -- Improper absolute integrals.

  let ABSOLUTELY_REAL_INTEGRABLE_IMPROPER_SIMPLE ← prove
   r"!f a b.
        (!c d. real_interval[c,d] SUBSET real_interval(a,b)
               ==> f absolutely_real_integrable_on real_interval[c,d]) /\
        real_bounded { real_integral (real_interval[c,d]) (\x. abs(f x)) |
                       real_interval[c,d] SUBSET real_interval(a,b)}
        ==> f absolutely_real_integrable_on real_interval[a,b]"
   (REWRITE_TAC [real_bounded, FORALL_IN_GSPEC] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN
    SIMP_TAC [REAL_INTEGRAL, absolutely_real_integrable_on] THEN
    REWRITE_TAC [← GSYM absolutely_real_integrable_on] THEN
    REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_ON, FORALL_DROP,
                 ← GSYM IMAGE_DROP_INTERVAL, o_DEF, ← GSYM IMAGE_o] THEN
    REWRITE_TAC [LIFT_DROP, IMAGE_ID, SUBSET_DROP_IMAGE] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMPROPER_SIMPLE THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_GSPEC, NORM_1, LIFT_DROP])

  pure { REAL_INTEGRATION_BY_PARTS, REAL_INTEGRATION_BY_PARTS_SIMPLE,
         REAL_INTEGRABLE_BY_PARTS, REAL_INTEGRABLE_BY_PARTS_EQ,
         ABSOLUTE_REAL_INTEGRATION_BY_PARTS, ABSOLUTE_REAL_INTEGRATION_BY_PARTS_SUM,
         ABSOLUTELY_REAL_INTEGRABLE_IMPROPER_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Change of variable in real integral (one that we know exists).            -/
/- (realanalysis.ml 11520-11735)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAY where
  HAS_REAL_INTEGRAL_SUBSTITUTION_STRONG : thm
  HAS_REAL_INTEGRAL_SUBSTITUTION : thm
  REAL_INTEGRAL_SUBSTITUTION : thm
  HAS_REAL_INTEGRAL_SUBSTITUTION_SIMPLE : thm
  REAL_INTEGRAL_SUBSTITUTION_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAY [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZG : RZG) (BRZH : RZH) (BRZJ : RZJ) (BRZK : RZK) (BRZN : RZN) (BRZAK : RZAK) (BRZAN : RZAN) (BRZAO : RZAO) : ExceptT String IO RZAY := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { REALLIM_ATREAL_AT, REALLIM_WITHIN_REAL_OPEN, REALLIM_WITHINREAL_WITHIN, .. } := BRZG
  let { REAL_CONTINUOUS_ATREAL_WITHINREAL, .. } := BRZH
  let { REAL_CONTINUOUS_ON_COMPOSE, REAL_CONTINUOUS_ON_SUBSET, .. } := BRZJ
  let { HAS_REAL_DERIVATIVE_ATREAL, HAS_REAL_DERIVATIVE_WITHINREAL, .. } := BRZK
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_WITHIN_SUBSET,
        REAL_DIFF_CHAIN_WITHIN, .. } := BRZN
  let { REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, REAL_INTEGRABLE_CONTINUOUS,
        REAL_INTEGRABLE_SUBINTERVAL, REAL_INTEGRAL_COMBINE,
        REAL_INTEGRAL_HAS_REAL_DERIVATIVE, REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE,
        .. } := BRZAN
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG,
        REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, .. } := BRZAO
  let { REAL_OPEN_REAL_INTERVAL, .. } := D.qmetric
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, REAL_INTERVAL_OPEN_SUBSET_CLOSED, SUBSET_REAL_INTERVAL,
        .. } := D.qmisc
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { INTERIOR_INTERVAL, LIM_WITHIN_INTERIOR, .. } := D.ts.cn.ms.ig.qtopology
  let { EQ_IMP, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  -- @@SCOPE END

  let HAS_REAL_INTEGRAL_SUBSTITUTION_STRONG ← prove
   r"!f g g' a b c d k.
        COUNTABLE k /\
        f real_integrable_on real_interval[c,d] /\
        g real_continuous_on real_interval[a,b] /\
        IMAGE g (real_interval[a,b]) SUBSET real_interval[c,d] /\
        (!x. x IN real_interval[a,b] DIFF k
                  ==> (g has_real_derivative g'(x))
                       (atreal x within real_interval[a,b]) /\
                      f real_continuous
                        (atreal(g x)) within real_interval[c,d]) /\
        a <= b /\ c <= d /\ g a <= g b
        ==> ((\x. f(g x) * g'(x)) has_real_integral
             real_integral (real_interval[g a,g b]) f) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"ff = \x. real_integral (real_interval[c,x]) f") THEN
    MP_TAC (← ISPECL
     [← q r"(ff:real->real) o (g:real->real)",
      ← q r"\x:real. (f:real->real)(g x) * g'(x)", ← q r"k:real->bool", ← q r"a:real",
      ← q r"b:real"]
     REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"real_interval [c,d]") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "ff" THEN
        MATCH_MP_TAC REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT THEN
        ASM_REWRITE_TAC [],
        X_GEN_TAC (← q r"x:real") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          REAL_INTERVAL_OPEN_SUBSET_CLOSED)) THEN
        SUBGOAL_THEN (← q r"(ff o g has_real_derivative f (g x:real) * g' x)
                      (atreal x within real_interval[a,b])")
        MP_TAC THENL
         [MATCH_MP_TAC REAL_DIFF_CHAIN_WITHIN THEN
          ASM_SIMP_TAC [HAS_REAL_DERIVATIVE_ATREAL_WITHIN, IN_DIFF] THEN
          MP_TAC (← ISPECL [← q r"f:real->real", ← q r"c:real", ← q r"d:real",
                            ← q r"(g:real->real) x"]
            REAL_INTEGRAL_HAS_REAL_DERIVATIVE_POINTWISE) THEN
          ASM_SIMP_TAC [REAL_CONTINUOUS_ATREAL_WITHINREAL, IN_DIFF] THEN
          ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          ASM_MESON_TAC [HAS_REAL_DERIVATIVE_WITHIN_SUBSET],
          DISCH_THEN (MP_TAC o SPEC (← q r"real_interval(a,b)") o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_REAL_DERIVATIVE_WITHIN_SUBSET)) THEN
          REWRITE_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED] THEN
          REWRITE_TAC [HAS_REAL_DERIVATIVE_WITHINREAL] THEN
          ASM_SIMP_TAC [REALLIM_WITHIN_REAL_OPEN, REAL_OPEN_REAL_INTERVAL] THEN
          REWRITE_TAC [HAS_REAL_DERIVATIVE_ATREAL]]],
      EXPAND_TAC "ff" THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"z + w:real = y ==> y - z = w")) THEN
      MATCH_MP_TAC REAL_INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_INTEGRABLE_SUBINTERVAL))] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_REAL_INTERVAL, SUBSET] THEN
      ASM_MESON_TAC [REAL_LE_REFL, REAL_LE_TRANS]])

  let HAS_REAL_INTEGRAL_SUBSTITUTION ← prove
   r"!f g g' a b c d k.
        COUNTABLE k /\
        f real_continuous_on real_interval[c,d] /\
        g real_continuous_on real_interval[a,b] /\
        IMAGE g (real_interval[a,b]) SUBSET real_interval[c,d] /\
        (!x. x IN real_interval[a,b] DIFF k
                  ==> (g has_real_derivative g'(x)) (atreal x)) /\
        a <= b /\ c <= d /\ g a <= g b
        ==> ((\x. f(g x) * g'(x)) has_real_integral
             real_integral (real_interval[g a,g b]) f) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real->real", ← q r"c:real", ← q r"d:real"]
          REAL_INTEGRAL_HAS_REAL_DERIVATIVE) THEN
    ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"h = \u. real_integral (real_interval[c,u]) f") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(h:real->real) o (g:real->real)",
      ← q r"\x:real. (f:real->real)(g x) * g' x",
      ← q r"k:real->bool", ← q r"a:real", ← q r"b:real"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG) THEN
    MP_TAC (← ISPECL
     [← q r"h:real->real", ← q r"f:real->real",
      ← q r"(g:real->real) a", ← q r"(g:real->real) b"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"x IN s ==> s SUBSET t ==> x IN t"))),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
         HAS_REAL_DERIVATIVE_WITHIN_SUBSET)] THEN
      REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN DISJ2_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"(c <= ga /\ ga <= d) /\ (c <= gb /\ gb <= d) /\ ga <= gb
        ==> c <= ga /\ ga <= gb /\ gb <= d")) THEN
      ASM_REWRITE_TAC [← GSYM IN_REAL_INTERVAL] THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL, REAL_LE_REFL],
      DISCH_THEN (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
      REWRITE_TAC [o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "h" THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          REAL_CONTINUOUS_ON_SUBSET)) THEN
        MATCH_MP_TAC REAL_INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT THEN
        ASM_SIMP_TAC [REAL_INTEGRABLE_CONTINUOUS],
        X_GEN_TAC (← q r"x:real") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          REAL_INTERVAL_OPEN_SUBSET_CLOSED)) THEN
        SUBGOAL_THEN
         (← q r"(h o (g:real->real) has_real_derivative f(g x) * g' x)
          (atreal x within real_interval[a,b])")
        MP_TAC THENL
         [MATCH_MP_TAC REAL_DIFF_CHAIN_WITHIN THEN
          ASM_SIMP_TAC [IN_DIFF, HAS_REAL_DERIVATIVE_ATREAL_WITHIN] THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:real->real) x")) THEN
          ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
            HAS_REAL_DERIVATIVE_WITHIN_SUBSET) THEN
          ASM_REWRITE_TAC [],
          REWRITE_TAC [HAS_REAL_DERIVATIVE_WITHINREAL, HAS_REAL_DERIVATIVE_ATREAL,
                       REALLIM_WITHINREAL_WITHIN, REALLIM_ATREAL_AT] THEN
          REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, TENDSTO_REAL] THEN
          MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC LIM_WITHIN_INTERIOR THEN
          REWRITE_TAC [INTERIOR_INTERVAL, ← GSYM IMAGE_LIFT_REAL_INTERVAL] THEN
          ASM_SIMP_TAC [FUN_IN_IMAGE]]]])

  let REAL_INTEGRAL_SUBSTITUTION ← prove
   r"!f g g' a b c d k.
        COUNTABLE k /\
        f real_continuous_on real_interval[c,d] /\
        g real_continuous_on real_interval[a,b] /\
        IMAGE g (real_interval[a,b]) SUBSET real_interval[c,d] /\
        (!x. x IN real_interval[a,b] DIFF k
                  ==> (g has_real_derivative g'(x)) (atreal x)) /\
        a <= b /\ c <= d /\ g a <= g b
        ==> real_integral (real_interval[a,b]) (\x. f(g x) * g'(x)) =
            real_integral (real_interval[g a,g b]) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_MESON_TAC [HAS_REAL_INTEGRAL_SUBSTITUTION])

  let HAS_REAL_INTEGRAL_SUBSTITUTION_SIMPLE ← prove
   r"!f g g' a b c d.
        f real_continuous_on real_interval[c,d] /\
        (!x. x IN real_interval[a,b]
                  ==> (g has_real_derivative g'(x))
                      (atreal x within real_interval[a,b])) /\
        IMAGE g (real_interval[a,b]) SUBSET real_interval[c,d] /\
        a <= b /\ c <= d /\ g a <= g b
        ==> ((\x. f(g x) * g'(x)) has_real_integral
             real_integral (real_interval[g a,g b]) f) (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP REAL_INTEGRAL_HAS_REAL_DERIVATIVE) THEN
    ABBREV_TAC (← q r"h = \u. real_integral (real_interval[c,u]) f") THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(h:real->real) o (g:real->real)",
      ← q r"\x:real. (f:real->real)(g x) * g' x",
      ← q r"a:real", ← q r"b:real"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    MP_TAC (← ISPECL
     [← q r"h:real->real", ← q r"f:real->real", ← q r"(g:real->real) a",
      ← q r"(g:real->real) b"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"x IN s ==> s SUBSET t ==> x IN t"))),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
         HAS_REAL_DERIVATIVE_WITHIN_SUBSET)] THEN
      REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN DISJ2_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"(c <= ga /\ ga <= d) /\ (c <= gb /\ gb <= d) /\ ga <= gb
        ==> c <= ga /\ ga <= gb /\ gb <= d")) THEN
      ASM_REWRITE_TAC [← GSYM IN_REAL_INTERVAL] THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL, REAL_LE_REFL],
      DISCH_THEN (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
      REWRITE_TAC [o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
      X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_DIFF_CHAIN_WITHIN THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:real->real) x")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
        HAS_REAL_DERIVATIVE_WITHIN_SUBSET) THEN
      ASM_REWRITE_TAC []])

  let REAL_INTEGRAL_SUBSTITUTION_SIMPLE ← prove
   r"!f g g' a b c d.
        f real_continuous_on real_interval[c,d] /\
        (!x. x IN real_interval[a,b]
                  ==> (g has_real_derivative g'(x))
                      (atreal x within real_interval[a,b])) /\
        IMAGE g (real_interval[a,b]) SUBSET real_interval[c,d] /\
        a <= b /\ c <= d /\ g a <= g b
        ==> real_integral (real_interval[a,b]) (\x. f(g x) * g'(x)) =
            real_integral (real_interval[g a,g b]) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
    ASM_MESON_TAC [HAS_REAL_INTEGRAL_SUBSTITUTION_SIMPLE])

  pure { HAS_REAL_INTEGRAL_SUBSTITUTION_STRONG, HAS_REAL_INTEGRAL_SUBSTITUTION,
         REAL_INTEGRAL_SUBSTITUTION, HAS_REAL_INTEGRAL_SUBSTITUTION_SIMPLE,
         REAL_INTEGRAL_SUBSTITUTION_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Take slice of set s at x$k = t and drop the k'th coordinate.              -/
/- (realanalysis.ml 11736-11998)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZAZ where
  slice : thm
  IN_SLICE : thm
  INTERVAL_INTER_HYPERPLANE : thm
  SLICE_INTERVAL : thm
  SLICE_DIFF : thm
  SLICE_UNIV : thm
  SLICE_EMPTY : thm
  SLICE_SUBSET : thm
  SLICE_UNIONS : thm
  SLICE_UNION : thm
  SLICE_INTER : thm
  CONVEX_SLICE : thm
  COMPACT_SLICE : thm
  CLOSED_SLICE : thm
  OPEN_SLICE : thm
  BOUNDED_SLICE : thm
  SLICE_CBALL : thm
  SLICE_BALL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZAZ [HolBase] (D : RealAnalysisDeps) : ExceptT String IO RZAZ := do
  -- @@SCOPE BEGIN
  let { DOT_DROPOUT, DOT_PUSHIN, dropout, DROPOUT_0, DROPOUT_EQ, DROPOUT_GALOIS,
        DROPOUT_PUSHIN, IN_IMAGE_DROPOUT, LINEAR_DROPOUT, pushin,
        SUBSPACE_SPECIAL_HYPERPLANE, .. } := D.qvectors
  let { CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE, COMPACT_LINEAR_IMAGE,
        IMAGE_DROPOUT_CLOSED_INTERVAL, .. } := D.qtopology
  let { CONVEX_STANDARD_HYPERPLANE, .. } := D.qconvex
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON,
        MESON_TAC, new_definition, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE,
        SET_TAC, VECTOR_ARITH, .. } := D.ts.cn.cx.cvx
  let { SQRT_POS_LT, .. } := D.ts.cn.cx.cpx
  let { IMAGE_UNIONS, .. } := D.ts.cn.ms.ig.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ts.cn.ms.ig.qtopology
  let { CART_EQ, CONJ_SYM, EQ_IMP, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMAGE_UNION,
        INTER_EMPTY, INTER_UNIONS, INTER_UNIV, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, LAMBDA_BETA, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, LT_REFL, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_SQUARE_ABS, REAL_LT_IMP_LE,
        REAL_LT_SQUARE_ABS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL,
        REAL_SUB_RZERO, SIMPLE_IMAGE, SQRT_POS_LE, SQRT_POW_2, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_THM, SWAP_EXISTS_THM, UNWIND_THM2, .. } := D.ts.cn.cx.cvx.core6
  let { BASIS_COMPONENT, COMPONENT_LE_NORM, .. } := D.ts.cn.cx.cvx.vec1
  let { IN_INTERVAL, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LE_SQUARE, NORM_SUB, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        .. } := D.ts.cn.cx.cvx.vec4
  let { BOUNDED_EMPTY, BOUNDED_SUBSET, CLOSED_INTER, CLOSED_TRANSLATION_EQ,
        .. } := D.ts.cn.cx.cvx.top1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        .. } := D.ts.cn.cx.cvx.top2
  let { IN_BALL, IN_CBALL, .. } := D.ts.cn.cx.cvx.top4
  let { NORM_LT_SQUARE, .. } := D.ts.cn.ms.ig.dv.qvec
  let { CLOSED_STANDARD_HYPERPLANE, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_CLOSED, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.pt.qtop
  let { CONVEX_INTER, CONVEX_LINEAR_IMAGE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let slice ← new_definition
   r"slice k t s = IMAGE (dropout k) (s INTER {x | x$k = t})"

  let IN_SLICE ← prove
   r"!s:real^N->bool y:real^M.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (y IN slice k t s <=> pushin k t y IN s)"
   (SIMP_TAC [slice, IN_IMAGE_DROPOUT, IN_INTER, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [pushin] THEN
    ASM_SIMP_TAC [LAMBDA_BETA, LT_REFL] THEN MESON_TAC [])

  let INTERVAL_INTER_HYPERPLANE ← prove
   r"!k t a b:real^N.
        1 <= k /\ k <= dimindex(:N)
        ==> interval[a,b] INTER {x | x$k = t} =
                if a$k <= t /\ t <= b$k
                then interval[(lambda i. if i = k then t else a$i),
                              (lambda i. if i = k then t else b$i)]
                else {}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_INTERVAL, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC, ASM_MESON_TAC [NOT_IN_EMPTY]] THEN
    SIMP_TAC [IN_INTERVAL, LAMBDA_BETA] THEN
    EQ_TAC THEN STRIP_TAC THENL [ASM_MESON_TAC [REAL_LE_ANTISYM], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LE_ANTISYM]] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let SLICE_INTERVAL ← prove
   r"!k a b t. dimindex(:M) + 1 = dimindex(:N) /\
             1 <= k /\ k <= dimindex(:N)
             ==> slice k t (interval[a,b]) =
                 if a$k <= t /\ t <= b$k
                 then interval[(dropout k:real^N->real^M) a,dropout k b]
                 else {}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [slice, INTERVAL_INTER_HYPERPLANE] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IMAGE_CLAUSES] THEN
    ASM_SIMP_TAC [IMAGE_DROPOUT_CLOSED_INTERVAL, LAMBDA_BETA, REAL_LE_REFL] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"a = a' /\ b = b' ==> interval[a,b] = interval[a',b']")) THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA, dropout] THEN
    SUBGOAL_THEN
     (← q r"!i. i <= dimindex(:M) ==> i <= dimindex(:N) /\ i + 1 <= dimindex(:N)")
    MP_TAC THENL
     [ASM_ARITH_TAC,
      ASM_SIMP_TAC [LAMBDA_BETA, ← ARITH_RULE (← q r"1 <= i + 1")] THEN ARITH_TAC])

  let SLICE_DIFF ← prove
   r"!k a s t.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (slice k a:(real^N->bool)->(real^M->bool)) (s DIFF t) =
             (slice k a s) DIFF (slice k a t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN
    SIMP_TAC [← SET_RULE (← q r"(s DIFF t) INTER u = (s INTER u) DIFF (t INTER u)")] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x y. x IN a /\ y IN a /\ f x = f y ==> x = y)
      ==> IMAGE f ((s INTER a) DIFF (t INTER a)) =
          IMAGE f (s INTER a) DIFF IMAGE f (t INTER a)")) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [DROPOUT_EQ])

  let SLICE_UNIV ← prove
   r"!k a. dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> slice k a (:real^N) = (:real^M)"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [EXTENSION, IN_UNIV, IN_IMAGE, slice, INTER_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"y:real^M") THEN EXISTS_TAC (← q r"(pushin k a:real^M->real^N) y") THEN
    ASM_SIMP_TAC [DROPOUT_PUSHIN] THEN
    ASM_SIMP_TAC [pushin, LAMBDA_BETA, LT_REFL])

  let SLICE_EMPTY ← prove
   r"!k a. slice k a {} = {}"
   (REWRITE_TAC [slice, INTER_EMPTY, IMAGE_CLAUSES])

  let SLICE_SUBSET ← prove
   r"!s t k a. s SUBSET t ==> slice k a s SUBSET slice k a t"
   (REWRITE_TAC [slice] THEN SET_TAC [])

  let SLICE_UNIONS ← prove
   r"!s k a. slice k a (UNIONS s) = UNIONS (IMAGE (slice k a) s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [slice, INTER_UNIONS, IMAGE_UNIONS] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
    AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM, slice])

  let SLICE_UNION ← prove
   r"!k a s t.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (slice k a:(real^N->bool)->(real^M->bool)) (s UNION t) =
             (slice k a s) UNION (slice k a t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [slice, IMAGE_UNION,
          ← SET_RULE (← q r"(s UNION t) INTER u = (s INTER u) UNION (t INTER u)")] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
    AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM, slice])

  let SLICE_INTER ← prove
   r"!k a s t.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (slice k a:(real^N->bool)->(real^M->bool)) (s INTER t) =
             (slice k a s) INTER (slice k a t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN
    MATCH_MP_TAC (← SET_RULE
      (← q r"(!x y. x IN u /\ y IN u /\ f x = f y ==> x = y)
       ==> IMAGE f ((s INTER t) INTER u) =
           IMAGE f (s INTER u) INTER IMAGE f (t INTER u)")) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [DROPOUT_EQ])

  let CONVEX_SLICE ← prove
   r"!k t s. dimindex(:M) < dimindex(:N) /\ convex s
           ==> convex((slice k t:(real^N->bool)->(real^M->bool)) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN
    MATCH_MP_TAC CONVEX_LINEAR_IMAGE THEN ASM_SIMP_TAC [LINEAR_DROPOUT] THEN
    MATCH_MP_TAC CONVEX_INTER THEN ASM_REWRITE_TAC [CONVEX_STANDARD_HYPERPLANE])

  let COMPACT_SLICE ← prove
   r"!k t s. dimindex(:M) < dimindex(:N) /\ compact s
           ==> compact((slice k t:(real^N->bool)->(real^M->bool)) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN
    MATCH_MP_TAC COMPACT_LINEAR_IMAGE THEN ASM_SIMP_TAC [LINEAR_DROPOUT] THEN
    REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
     [MATCH_MP_TAC BOUNDED_INTER THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED],
      MATCH_MP_TAC CLOSED_INTER THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_STANDARD_HYPERPLANE]])

  let CLOSED_SLICE ← prove
   r"!k t s. dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N) /\
           closed s
           ==> closed((slice k t:(real^N->bool)->(real^M->bool)) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN
    SUBGOAL_THEN
     (← q r"closed(IMAGE (dropout k:real^N->real^M)
                   (IMAGE (\x. x - t % basis k)
                          (s INTER {x | x$k = t})))")
    MP_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM IMAGE_o] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM, dropout] THEN
      SUBGOAL_THEN
       (← q r"!i. i <= dimindex(:M) ==> i <= dimindex(:N) /\ i + 1 <= dimindex(:N)")
      MP_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, CART_EQ,
                LAMBDA_BETA, BASIS_COMPONENT, ← ARITH_RULE (← q r"1 <= i + 1")] THEN
      SIMP_TAC [← ARITH_RULE (← q r"i:num < k ==> ~(i = k)"),
                ← ARITH_RULE (← q r"~(i < k) ==> ~(i + 1 = k)")] THEN
      REWRITE_TAC [REAL_MUL_RZERO, REAL_SUB_RZERO]] THEN
    MATCH_MP_TAC CLOSED_INJECTIVE_IMAGE_SUBSET_SUBSPACE THEN
    EXISTS_TAC (← q r"{x:real^N | x$k = &0}") THEN
    ASM_SIMP_TAC [SUBSPACE_SPECIAL_HYPERPLANE, LINEAR_DROPOUT,
                  ← ARITH_RULE (← q r"m + 1 = n ==> m < n")] THEN
    REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x - t % b:real^N = --(t % b) + x")] THEN
      ASM_SIMP_TAC [CLOSED_TRANSLATION_EQ, CLOSED_INTER,
                    CLOSED_STANDARD_HYPERPLANE],
      MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE f t SUBSET u ==> IMAGE f (s INTER t) SUBSET u")) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, BASIS_COMPONENT,
                    REAL_MUL_RID, REAL_SUB_REFL],
      REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC DROPOUT_EQ THEN EXISTS_TAC (← q r"k:num") THEN
      ASM_REWRITE_TAC [DROPOUT_0, VEC_COMPONENT]])

  let OPEN_SLICE ← prove
   r"!k t s. dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N) /\
           open s
           ==> open((slice k t:(real^N->bool)->(real^M->bool)) s)"
   (REWRITE_TAC [OPEN_CLOSED] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closed(slice k t ((:real^N) DIFF s):real^M->bool)")
    MP_TAC THENL
     [ASM_SIMP_TAC [CLOSED_SLICE],
     ASM_SIMP_TAC [SLICE_DIFF, SLICE_UNIV]])

  let BOUNDED_SLICE ← prove
   r"!k t s. dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N) /\
           bounded s
           ==> bounded((slice k t:(real^N->bool)->(real^M->bool)) s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"(slice k t:(real^N->bool)->(real^M->bool)) (interval[a,b])") THEN
    ASM_SIMP_TAC [SLICE_SUBSET] THEN ASM_SIMP_TAC [SLICE_INTERVAL] THEN
    MESON_TAC [BOUNDED_EMPTY, BOUNDED_INTERVAL])

  let SLICE_CBALL ← prove
   r"!k t x r.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (slice k t:(real^N->bool)->(real^M->bool)) (cball(x,r)) =
                if abs(t - x$k) <= r
                then cball(dropout k x,sqrt(r pow 2 - (t - x$k) pow 2))
                else {}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN COND_CASES_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, NOT_IN_EMPTY, IN_CBALL] THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [dist] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(a <= r) ==> a <= b ==> b <= r ==> F"))) THEN
      ASM_MESON_TAC [VECTOR_SUB_COMPONENT, COMPONENT_LE_NORM, NORM_SUB]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REAL_ARITH (← q r"abs(x) <= r ==> &0 <= r"))) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_CBALL] THEN X_GEN_TAC (← q r"y:real^M") THEN
    ASM_SIMP_TAC [DROPOUT_GALOIS, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2] THEN
    REWRITE_TAC [IN_CBALL, IN_INTER, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [pushin, LAMBDA_BETA, LT_REFL] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [UNWIND_THM2] THEN
    ASM_REWRITE_TAC [dist, NORM_LE_SQUARE, ← GSYM pushin] THEN
    ASM_SIMP_TAC [SQRT_POW_2, SQRT_POS_LE, REAL_SUB_LE, ← GSYM REAL_LE_SQUARE_ABS,
                  ← REAL_ARITH (← q r"abs(x) <= r ==> abs(x) <= abs(r)")] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(x - y:real^N) dot (x - y) = x dot x + y dot y - &2 * x dot y")] THEN
    ASM_SIMP_TAC [DOT_DROPOUT, DOT_PUSHIN] THEN MATCH_MP_TAC (← REAL_FIELD
       (← q r"a = t * k + b
        ==> (xx + (yy + t * t) - &2 * a <= r pow 2 <=>
             xx - k * k + yy - &2 * b <= r pow 2 - (t - k) pow 2)")) THEN
    SUBGOAL_THEN
     (← q r"y:real^M = dropout k (pushin k t y:real^N)")
     (fun th => GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [th])
    THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC DROPOUT_PUSHIN THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [DOT_DROPOUT] THEN
      ASM_SIMP_TAC [pushin, LAMBDA_BETA, LT_REFL] THEN REAL_ARITH_TAC])

  let SLICE_BALL ← prove
   r"!k t x r.
        dimindex(:M) + 1 = dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N)
        ==> (slice k t:(real^N->bool)->(real^M->bool)) (ball(x,r)) =
                if abs(t - x$k) < r
                then ball(dropout k x,sqrt(r pow 2 - (t - x$k) pow 2))
                else {}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [slice] THEN COND_CASES_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTER, NOT_IN_EMPTY, IN_BALL] THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [dist] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(a < r) ==> a <= b ==> b < r ==> F"))) THEN
      ASM_MESON_TAC [VECTOR_SUB_COMPONENT, COMPONENT_LE_NORM, NORM_SUB]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REAL_ARITH (← q r"abs(x) < r ==> &0 < r"))) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_BALL] THEN X_GEN_TAC (← q r"y:real^M") THEN
    ASM_SIMP_TAC [DROPOUT_GALOIS, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2] THEN
    REWRITE_TAC [IN_BALL, IN_INTER, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [pushin, LAMBDA_BETA, LT_REFL] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [UNWIND_THM2] THEN
    ASM_REWRITE_TAC [dist, NORM_LT_SQUARE, ← GSYM pushin] THEN
    ASM_SIMP_TAC [SQRT_POW_2, SQRT_POS_LT, REAL_SUB_LT, ← GSYM REAL_LT_SQUARE_ABS,
     REAL_LT_IMP_LE, ← REAL_ARITH (← q r"abs(x) < r ==> abs(x) < abs(r)")] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(x - y:real^N) dot (x - y) = x dot x + y dot y - &2 * x dot y")] THEN
    ASM_SIMP_TAC [DOT_DROPOUT, DOT_PUSHIN] THEN MATCH_MP_TAC (← REAL_FIELD
       (← q r"a = t * k + b
        ==> (xx + (yy + t * t) - &2 * a < r pow 2 <=>
             xx - k * k + yy - &2 * b < r pow 2 - (t - k) pow 2)")) THEN
    SUBGOAL_THEN
     (← q r"y:real^M = dropout k (pushin k t y:real^N)")
     (fun th => GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [th])
    THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC DROPOUT_PUSHIN THEN ASM_ARITH_TAC,
      ASM_SIMP_TAC [DOT_DROPOUT] THEN
      ASM_SIMP_TAC [pushin, LAMBDA_BETA, LT_REFL] THEN REAL_ARITH_TAC])

  pure { slice, IN_SLICE, INTERVAL_INTER_HYPERPLANE, SLICE_INTERVAL, SLICE_DIFF,
         SLICE_UNIV, SLICE_EMPTY, SLICE_SUBSET, SLICE_UNIONS, SLICE_UNION, SLICE_INTER,
         CONVEX_SLICE, COMPACT_SLICE, CLOSED_SLICE, OPEN_SLICE, BOUNDED_SLICE,
         SLICE_CBALL, SLICE_BALL }
/- ------------------------------------------------------------------------- -/
/- Weak but useful versions of Fubini's theorem (part 1).                    -/
/- (realanalysis.ml 11999-12193)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBA where
  FUBINI_CLOSED_INTERVAL : thm
  MEASURABLE_OUTER_INTERVALS_BOUNDED_EXPLICIT_SPECIAL : thm
  REAL_MONOTONE_CONVERGENCE_INCREASING_AE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBA [HolBase] (D : RealAnalysisDeps) (BRZAL : RZAL) (BRZAM : RZAM) (BRZAO : RZAO) (BRZAQ : RZAQ) (BRZAZ : RZAZ) : ExceptT String IO RZBA := do
  -- @@SCOPE BEGIN
  let { HAS_REAL_INTEGRAL_CONST, .. } := BRZAL
  let { REAL_NEGLIGIBLE_SUBSET, .. } := BRZAM
  let { HAS_REAL_INTEGRAL_RESTRICT, REAL_INTEGRABLE_SPIKE_SET,
        REAL_INTEGRABLE_SPIKE_SET_EQ, REAL_INTEGRAL_SPIKE_SET, .. } := BRZAO
  let { REAL_MONOTONE_CONVERGENCE_INCREASING, .. } := BRZAQ
  let { SLICE_INTERVAL, .. } := BRZAZ
  let { real_bounded, .. } := D.qmetric
  let { dropout, .. } := D.qvectors
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { NUMSEG_COMBINE_R, .. } := D.qsession
  let { HAS_MEASURE_0, HAS_MEASURE_NEGLIGIBLE_SYMDIFF, MEASURABLE_OUTER_INTERVALS_BOUNDED,
        MEASURE_EMPTY, MEASURE_INTERVAL, .. } := D.qmeasure
  let { PRODUCT_IMAGE, PRODUCT_UNION, .. } := D.qproducts
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.ts.cn.ms.qintegration1
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_FRONTIER_INTERVAL, .. } := D.ts.cn.ms.qintegration3
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { EQ_ADD_RCANCEL, INFINITE, PRODUCT_CLAUSES, SUB_ADD, .. } := D.ts.cn.cx.cpx
  let { COUNTABLE_AS_INJECTIVE_IMAGE, .. } := D.ts.cn.ms.ig.qcard
  let { PRODUCT_EQ_NUMSEG, .. } := D.ts.cn.ms.ig.qproducts
  let { INTER_INTERVAL, INTERVAL_EQ_EMPTY, .. } := D.ts.cn.ms.ig.qvec
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, EMPTY_SUBSET, EQ_IMP, EXISTS_IN_IMAGE,
        EXISTS_REFL, EXTENSION, FINITE_IMAGE, FINITE_INDEX_NUMSEG, FINITE_NUMSEG,
        FINITE_UNION, FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, INTER_EMPTY,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV,
        LAMBDA_BETA, LEFT_EXISTS_AND_THM, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, REAL_POS,
        RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, .. } := D.ts.cn.cx.cvx.core5
  let { o_THM, SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.core6
  let { INTERIOR_CLOSED_INTERVAL, INTERIOR_INTER, INTERIOR_SUBSET,
        .. } := D.ts.cn.cx.cvx.top4
  -- @@SCOPE END

  let FUBINI_CLOSED_INTERVAL ← prove
   r"!k a b:real^N.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        a$k <= b$k
        ==> ((\t. measure (slice k t (interval[a,b]) :real^M->bool))
             has_real_integral
             (measure(interval[a,b]))) (:real)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SLICE_INTERVAL] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [MEASURE_EMPTY, MEASURE_INTERVAL] THEN
    REWRITE_TAC [← GSYM IN_REAL_INTERVAL] THEN
    SIMP_TAC [HAS_REAL_INTEGRAL_RESTRICT, SUBSET_UNIV] THEN
    SUBGOAL_THEN
     (← q r"content(interval[a:real^N,b]) =
      content(interval[dropout k a:real^M,dropout k b]) * (b$k - a$k)")
    SUBST1_TAC THEN ASM_SIMP_TAC [HAS_REAL_INTEGRAL_CONST] THEN
    REWRITE_TAC [CONTENT_CLOSED_INTERVAL_CASES] THEN
    GEN_REWRITE_TAC (RAND_CONV o RATOR_CONV) [COND_RAND] THEN
    GEN_REWRITE_TAC RAND_CONV [COND_RATOR] THEN
    REWRITE_TAC [REAL_MUL_LZERO] THEN MATCH_MP_TAC (← TAUT
     (← q r"(p <=> p') /\ x = x'
      ==> (if p then x else y) = (if p' then x' else y)")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [dropout, LAMBDA_BETA] THEN EQ_TAC THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      (ASM_CASES_TAC (← q r"i <= dimindex(:N)") THENL
        [ASM_REWRITE_TAC [], ASM_ARITH_TAC])
      THENL
       [REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL]) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        ASM_CASES_TAC (← q r"i:num = k") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"i:num < k") THENL
         [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [],
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i - 1")) THEN
          COND_CASES_TAC THENL [ASM_ARITH_TAC, ASM_SIMP_TAC [SUB_ADD]]] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"1..dimindex(:N) =
                  (1..(k-1)) UNION
                  (k INSERT (IMAGE (\x. x + 1) (k..dimindex(:M))))")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_NUMSEG, IN_UNION, IN_INSERT, IN_IMAGE] THEN
      ASM_SIMP_TAC [← ARITH_RULE
       (← q r"1 <= k
        ==> (x = y + 1 /\ k <= y /\ y <= n <=>
             y = x - 1 /\ k + 1 <= x /\ x <= n + 1)")] THEN
      REWRITE_TAC [CONJ_ASSOC, LEFT_EXISTS_AND_THM, EXISTS_REFL] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"s UNION (x INSERT t) = x INSERT (s UNION t)")] THEN
    SIMP_TAC [PRODUCT_CLAUSES, FINITE_NUMSEG, FINITE_UNION, FINITE_IMAGE] THEN
    ASM_SIMP_TAC [IN_NUMSEG, IN_UNION, IN_IMAGE, ← ARITH_RULE
     (← q r"1 <= k ==> ~(k <= k - 1)")] THEN
    COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN AP_TERM_TAC THEN
    MP_TAC (← ISPECL [← q r"1", ← q r"k - 1", ← q r"dimindex(:M)"] NUMSEG_COMBINE_R) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) PRODUCT_UNION o lhand o snd) THEN
    SIMP_TAC [FINITE_NUMSEG, FINITE_IMAGE, IN_NUMSEG, ← SET_RULE
              (← q r"DISJOINT s (IMAGE f t) <=> !x. x IN t ==> ~(f x IN s)")] THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) PRODUCT_UNION o rand o snd) THEN
    SIMP_TAC [FINITE_NUMSEG, FINITE_IMAGE, IN_NUMSEG, ← SET_RULE
              (← q r"DISJOINT s t <=> !x. ~(x IN s /\ x IN t)")] THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [PRODUCT_IMAGE, EQ_ADD_RCANCEL, SUB_ADD] THEN
    BINOP_TAC THEN MATCH_MP_TAC PRODUCT_EQ_NUMSEG THEN
    SIMP_TAC [dropout, LAMBDA_BETA, o_THM] THEN
    REPEAT STRIP_TAC THEN BINOP_TAC THEN
    (W (MP_TAC o PART_MATCH (lhs o rand) LAMBDA_BETA o rand o snd) THEN
     ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
     REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
     ASM_ARITH_TAC))

  let MEASURABLE_OUTER_INTERVALS_BOUNDED_EXPLICIT_SPECIAL ← (do
    let lemma ← prove
     r"UNIONS {if n IN s then f n else {} | n IN (:num)} =
       UNIONS (IMAGE f s)"
     (SIMP_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM, IN_UNIV, EXISTS_IN_IMAGE] THEN
      MESON_TAC [NOT_IN_EMPTY])
    prove
     r"!s a b e.
          2 <= dimindex(:N) /\ 1 <= k /\ k <= dimindex(:N) /\
          measurable s /\ s SUBSET interval[a,b] /\ &0 < e
          ==> ?f:num->real^N->bool.
                (!i. (f i) SUBSET interval[a,b] /\
                     ?c d. c$k <= d$k /\ f i = interval[c,d]) /\
                (!i j. ~(i = j) ==> negligible(f i INTER f j)) /\
                s SUBSET UNIONS {f n | n IN (:num)} /\
                measurable(UNIONS {f n | n IN (:num)}) /\
                measure(UNIONS {f n | n IN (:num)}) <= measure s + e"
     (REPEAT GEN_TAC THEN
      REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP MEASURABLE_OUTER_INTERVALS_BOUNDED) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      ASM_CASES_TAC (← q r"FINITE(d:(real^N->bool)->bool)") THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool")
         (fun th => tactic_of do
            pure (SUBST_ALL_TAC (← CONJUNCT2 th) THEN ASSUME_TAC (← CONJUNCT1 th)))) THEN
         RULE_ASSUM_TAC (REWRITE_RULE [IMP_CONJ, FORALL_IN_IMAGE,
           RIGHT_FORALL_IMP_THM, IN_UNIV]) THEN
        EXISTS_TAC (← q r"\k. if k IN 1..CARD(d:(real^N->bool)->bool) then f k
                        else ({}:real^N->bool)") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"i:num") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
           [ASM_MESON_TAC [REAL_NOT_LT, IN_NUMSEG, REAL_NOT_LE, INTERVAL_EQ_EMPTY],
            REWRITE_TAC [EMPTY_SUBSET] THEN CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
            EXISTS_TAC (← q r"(lambda i. if i = k then &0 else &1):real^N") THEN
            EXISTS_TAC (← q r"(lambda i. if i = k then &1 else &0):real^N") THEN
            REWRITE_TAC [INTERVAL_EQ_EMPTY] THEN CONJ_TAC THENL
             [SIMP_TAC [LAMBDA_BETA, ← ASSUME (← q r"1 <= k"),
                        ← ASSUME (← q r"k <= dimindex(:N)"), REAL_POS],
              ALL_TAC] THEN
            SUBGOAL_THEN (← q r"?j. 1 <= j /\ j <= dimindex(:N) /\ ~(j = k)") MP_TAC THENL
             [MATCH_MP_TAC (← MESON [] (← q r"P(k - 1) \/ P(k + 1) ==> ?i. P i")) THEN
              ASM_ARITH_TAC,
              MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [LAMBDA_BETA] THEN
              REAL_ARITH_TAC]],
          ALL_TAC] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [lemma]] THEN
        REPEAT GEN_TAC THEN
          REPEAT (COND_CASES_TAC THEN
                  ASM_REWRITE_TAC [INTER_EMPTY, NEGLIGIBLE_EMPTY]),
        MP_TAC (← ISPEC (← q r"d:(real^N->bool)->bool") COUNTABLE_AS_INJECTIVE_IMAGE) THEN
        ASM_REWRITE_TAC [INFINITE] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"f:num->real^N->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IMP_CONJ, FORALL_IN_IMAGE,
           RIGHT_FORALL_IMP_THM, IN_UNIV]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM SIMPLE_IMAGE]) THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [REAL_NOT_LT, IN_NUMSEG, REAL_NOT_LE, INTERVAL_EQ_EMPTY],
            ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"]] THEN
      (DISCH_TAC THEN
       SUBGOAL_THEN (← q r"negligible(interior((f:num->real^N->bool) i) INTER
                                interior(f j))")
       MP_TAC THENL [ASM_MESON_TAC [NEGLIGIBLE_EMPTY], ALL_TAC] THEN
       REWRITE_TAC [← GSYM INTERIOR_INTER] THEN
       REWRITE_TAC [← GSYM HAS_MEASURE_0] THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
         HAS_MEASURE_NEGLIGIBLE_SYMDIFF) THEN
       SIMP_TAC [INTERIOR_SUBSET, ← SET_RULE
          (← q r"interior(s) SUBSET s
           ==> (interior s DIFF s) UNION (s DIFF interior s) =
               s DIFF interior s")] THEN
       SUBGOAL_THEN (← q r"(?c d. (f:num->real^N->bool) i = interval[c,d]) /\
                     (?c d. (f:num->real^N->bool) j = interval[c,d])")
       STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       ASM_REWRITE_TAC [INTER_INTERVAL, NEGLIGIBLE_FRONTIER_INTERVAL,
                        INTERIOR_CLOSED_INTERVAL])))

  let REAL_MONOTONE_CONVERGENCE_INCREASING_AE ← prove
   r"!f:num->real->real g s.
        (!k. (f k) real_integrable_on s) /\
        (!k x. x IN s ==> f k x <= f (SUC k) x) /\
        (?t. real_negligible t /\
             !x. x IN (s DIFF t) ==> ((\k. f k x) ---> g x) sequentially) /\
        real_bounded {real_integral s (f k) | k IN (:num)}
        ==> g real_integrable_on s /\
            ((\k. real_integral s (f k)) ---> real_integral s g) sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"g real_integrable_on (s DIFF t) /\
      ((\k. real_integral (s DIFF t) (f k)) ---> real_integral (s DIFF t) g)
      sequentially")
    MP_TAC THENL
     [MATCH_MP_TAC REAL_MONOTONE_CONVERGENCE_INCREASING THEN
      REPEAT CONJ_TAC THENL
       [UNDISCH_TAC (← q r"!k:num. f k real_integrable_on s") THEN
        MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
        MATCH_MP_TAC REAL_INTEGRABLE_SPIKE_SET,
        ASM_SIMP_TAC [IN_DIFF],
        ASM_REWRITE_TAC [],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_bounded]) THEN
        REWRITE_TAC [real_bounded, FORALL_IN_GSPEC, IN_UNIV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
        MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC EQ_IMP THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC REAL_INTEGRAL_SPIKE_SET],
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [MATCH_MP_TAC REAL_INTEGRABLE_SPIKE_SET_EQ THEN
        MATCH_MP_TAC REAL_NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"t:real->bool") THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
        AP_THM_TAC THEN BINOP_TAC THENL
         [ABS_TAC, ALL_TAC] THEN
        MATCH_MP_TAC REAL_INTEGRAL_SPIKE_SET]] THEN
    MATCH_MP_TAC REAL_NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"t:real->bool") THEN ASM_REWRITE_TAC [] THEN SET_TAC [])

  pure { FUBINI_CLOSED_INTERVAL, MEASURABLE_OUTER_INTERVALS_BOUNDED_EXPLICIT_SPECIAL,
         REAL_MONOTONE_CONVERGENCE_INCREASING_AE }
/- ------------------------------------------------------------------------- -/
/- Weak but useful versions of Fubini's theorem (part 2: FUBINI_SIMPLE_LEMMA).-/
/- (realanalysis.ml 12194-12426)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBB where
  FUBINI_SIMPLE_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBB [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZC : RZC) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAM : RZAM) (BRZAW : RZAW) (BRZAZ : RZAZ) (BRZBA : RZBA) : ExceptT String IO RZBB := do
  -- @@SCOPE BEGIN
  let { REALLIM_UNIQUE, .. } := BRZA
  let { REAL_SUMS, real_sums, .. } := BRZC
  let { real_integrable_on, REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { REAL_INTEGRABLE_SUM, REAL_INTEGRAL_SUM, .. } := BRZAL
  let { REAL_INTEGRAL_LE, .. } := BRZAM
  let { REAL_NEGLIGIBLE_COUNTABLE, .. } := BRZAW
  let { SLICE_EMPTY, SLICE_INTERVAL, SLICE_SUBSET, SLICE_UNIONS, .. } := BRZAZ
  let { FUBINI_CLOSED_INTERVAL, MEASURABLE_OUTER_INTERVALS_BOUNDED_EXPLICIT_SPECIAL,
        REAL_MONOTONE_CONVERGENCE_INCREASING_AE, .. } := BRZBA
  let { real_bounded, .. } := D.qmetric
  let { dropout, .. } := D.qvectors
  let { HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED,
        MEASURABLE_COUNTABLE_UNIONS_BOUNDED, MEASURABLE_EMPTY, MEASURABLE_INTERVAL,
        MEASURABLE_UNIONS, MEASURE_NEGLIGIBLE_UNIONS_IMAGE, MEASURE_POS_LE, MEASURE_SUBSET,
        NEGLIGIBLE_INTERVAL, .. } := D.qmeasure
  let { INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, .. } := D.qintegration
  let { NEGLIGIBLE_EMPTY, .. } := D.ts.cn.ms.qintegration3
  let { NUM_COUNTABLE, .. } := D.ts.cn.ms.qcard
  let { FROM_INTER_NUMSEG, .. } := D.ts.cn.ms.qmisc
  let { SUM_EQ_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        REAL_ARITH, .. } := D.ts.cn.cx.cvx
  let { LE_0, SUB_ADD, .. } := D.ts.cn.cx.cpx
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ts.cn.ms.ig.qtopology
  let { INTER_INTERVAL, INTERVAL_EQ_EMPTY, .. } := D.ts.cn.ms.ig.qvec
  let { CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_GE_1, EQ_IMP, FINITE_IMAGE, FINITE_NUMSEG,
        FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_IMP, IN_DIFF, INTER_EMPTY,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNION, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM,
        NOT_EXISTS_THM, NOT_IMP, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ADDR, REAL_LE_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { SIMPLE_IMAGE, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES_NUMSEG, SUM_POS_LE, UNIONS_SUBSET,
        .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNION, .. } := D.ts.cn.cx.cvx.lib
  let { INTERVAL_NE_EMPTY, .. } := D.ts.cn.cx.cvx.vec2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ts.cn.cx.cvx.met
  let { BOUNDED_EMPTY, BOUNDED_SUBSET, .. } := D.ts.cn.cx.cvx.top1
  let { BOUNDED_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let FUBINI_SIMPLE_LEMMA ← prove
   r"!k s:real^N->bool e.
        &0 < e /\
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\ measurable s /\
        (!t. measurable(slice k t s:real^M->bool)) /\
        (\t. measure (slice k t s:real^M->bool)) real_integrable_on (:real)
        ==> real_integral(:real) (\t. measure (slice k t s :real^M->bool))
                <= measure s + e"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N", ← q r"e:real"]
          MEASURABLE_OUTER_INTERVALS_BOUNDED_EXPLICIT_SPECIAL) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"1 <= dimindex(:M)") MP_TAC THENL
       [REWRITE_TAC [DIMINDEX_GE_1], ASM_ARITH_TAC],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->(real^N->bool)") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"!t n:num. measurable((slice k t:(real^N->bool)->real^M->bool)
                                       (d n))")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"n:num"] THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o CONJUNCT2 o SPEC (← q r"n:num")) THEN
      ASM_SIMP_TAC [SLICE_INTERVAL] THEN
      MESON_TAC [MEASURABLE_EMPTY, MEASURABLE_INTERVAL],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(UNIONS {d n | n IN (:num)}:real^N->bool)") THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL
         [← q r"\n t. sum(0..n)
             (\m. measure((slice k t:(real^N->bool)->real^M->bool)
                         (d m)))",
          ← q r"\t. measure((slice k t:(real^N->bool)->real^M->bool)
                     (UNIONS {d n | n IN (:num)}))", ← q r"(:real)"]
           REAL_MONOTONE_CONVERGENCE_INCREASING_AE) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN MATCH_MP_TAC REAL_INTEGRABLE_SUM THEN
        ASM_REWRITE_TAC [FINITE_NUMSEG] THEN X_GEN_TAC (← q r"j:num") THEN
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o SPEC (← q r"j:num")) THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"k:num", ← q r"u:real^N", ← q r"v:real^N"]
          FUBINI_CLOSED_INTERVAL) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [real_integrable_on],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0] THEN
        REWRITE_TAC [REAL_LE_ADDR] THEN MATCH_MP_TAC MEASURE_POS_LE THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [real_bounded, FORALL_IN_GSPEC, IN_UNIV] THEN
        EXISTS_TAC (← q r"measure(interval[a:real^N,b])") THEN X_GEN_TAC (← q r"i:num") THEN
        W (MP_TAC o PART_MATCH (lhand o rand) REAL_INTEGRAL_SUM o
          rand o lhand o snd) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [FINITE_NUMSEG] THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"?u v. u$k <= v$k /\
                              (d:num->real^N->bool) j = interval[u,v]")
          STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [real_integrable_on] THEN
          EXISTS_TAC (← q r"measure(interval[u:real^N,v])") THEN
          MATCH_MP_TAC FUBINI_CLOSED_INTERVAL THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"abs(sum(0..i) (\m. measure(d m:real^N->bool)))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
          MATCH_MP_TAC SUM_EQ_NUMSEG THEN
          X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
          MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
          SUBGOAL_THEN (← q r"?u v. u$k <= v$k /\
                              (d:num->real^N->bool) j = interval[u,v]")
          STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC FUBINI_CLOSED_INTERVAL THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= a ==> abs x <= a")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC SUM_POS_LE THEN REWRITE_TAC [FINITE_NUMSEG] THEN
          ASM_MESON_TAC [MEASURE_POS_LE, MEASURABLE_INTERVAL],
          ALL_TAC] THEN
        W (MP_TAC o PART_MATCH (rhs o rand) MEASURE_NEGLIGIBLE_UNIONS_IMAGE o
          lhand o snd) THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [FINITE_NUMSEG] THEN ASM_MESON_TAC [MEASURABLE_INTERVAL],
          ALL_TAC] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        REWRITE_TAC [MEASURABLE_INTERVAL] THEN CONJ_TAC THENL
         [MATCH_MP_TAC MEASURABLE_UNIONS THEN
          ASM_SIMP_TAC [FINITE_NUMSEG, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
          ASM_MESON_TAC [MEASURABLE_INTERVAL],
          REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN ASM_MESON_TAC []]] THEN
      EXISTS_TAC
       (← q r"(IMAGE (\i. (interval_lowerbound(d i):real^N)$k) (:num)) UNION
        (IMAGE (\i. (interval_upperbound(d i):real^N)$k) (:num))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_NEGLIGIBLE_COUNTABLE THEN
        SIMP_TAC [COUNTABLE_UNION, COUNTABLE_IMAGE, NUM_COUNTABLE],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"t:real") THEN
      REWRITE_TAC [IN_DIFF, IN_UNION, IN_IMAGE] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [IN_UNIV] THEN
      REWRITE_TAC [DE_MORGAN_THM, NOT_EXISTS_THM] THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"\n:num. (slice k t:(real^N->bool)->real^M->bool)
                            (d n)")
         HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED) THEN
      ASM_REWRITE_TAC [SLICE_UNIONS] THEN ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (MP_TAC o CONJUNCT2) THEN
        GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [← GSYM REAL_SUMS, real_sums, FROM_INTER_NUMSEG] THEN
        REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF]] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC BOUNDED_SUBSET THEN
        EXISTS_TAC (← q r"(slice k t:(real^N->bool)->real^M->bool) (interval[a,b])") THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [SLICE_INTERVAL] THEN
          MESON_TAC [BOUNDED_INTERVAL, BOUNDED_EMPTY],
          REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
          ASM_MESON_TAC [SLICE_SUBSET]]] THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"i:num", ← q r"j:num"]) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"(d:num->real^N->bool) i = {}") THENL
       [ASM_REWRITE_TAC [INTER_EMPTY, NEGLIGIBLE_EMPTY, SLICE_EMPTY],
        UNDISCH_TAC (← q r"~((d:num->real^N->bool) i = {})")] THEN
      ASM_CASES_TAC (← q r"(d:num->real^N->bool) j = {}") THENL
       [ASM_REWRITE_TAC [INTER_EMPTY, NEGLIGIBLE_EMPTY, SLICE_EMPTY],
        UNDISCH_TAC (← q r"~((d:num->real^N->bool) j = {})")] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (MAP_EVERY (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)
         [← SPEC (← q r"i:num") th, ← SPEC (← q r"j:num") th])) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:real^N", ← q r"x:real^N"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [SLICE_INTERVAL, INTERVAL_NE_EMPTY] THEN
      DISCH_TAC THEN DISCH_TAC THEN
      REPEAT (COND_CASES_TAC THEN
              ASM_REWRITE_TAC [INTER_EMPTY, NEGLIGIBLE_EMPTY]) THEN
      REWRITE_TAC [INTER_INTERVAL, NEGLIGIBLE_INTERVAL, INTERVAL_EQ_EMPTY] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(a /\ b ==> ~c)")] THEN
      SIMP_TAC [LAMBDA_BETA] THEN REWRITE_TAC [NOT_IMP] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"l:num") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"~(l:num = k)") ASSUME_TAC THENL
       [FIRST_X_ASSUM (CONJUNCTS_THEN
         (fun th => tactic_of do
            pure (MP_TAC (← SPEC (← q r"i:num") th) THEN
                  MP_TAC (← SPEC (← q r"j:num") th)))) THEN
        ASM_SIMP_TAC [INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND] THEN
        REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [] THEN DISCH_THEN SUBST_ALL_TAC THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(l:num = k) ==> l < k \/ k < l")))
      THENL
       [EXISTS_TAC (← q r"l:num") THEN
        MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
        CONJ_TAC THENL [ASM_ARITH_TAC, SIMP_TAC [dropout, LAMBDA_BETA]] THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"l - 1") THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
      CONJ_TAC THENL [ASM_ARITH_TAC, SIMP_TAC [dropout, LAMBDA_BETA]] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"k < l ==> ~(l - 1 < k)")] THEN
      ASM_SIMP_TAC [SUB_ADD],
      ALL_TAC] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
     (← q r"real_integral (:real)
          (\t. measure ((slice k t :(real^N->bool)->real^M->bool)
                        (UNIONS {d n | n IN (:num)})))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRAL_LE THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"t:real") THEN DISCH_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [SLICE_SUBSET, SLICE_UNIONS] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      MATCH_MP_TAC MEASURABLE_COUNTABLE_UNIONS_BOUNDED THEN
      ASM_REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"(slice k t:(real^N->bool)->real^M->bool) (interval[a,b])") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [SLICE_INTERVAL] THEN
        MESON_TAC [BOUNDED_INTERVAL, BOUNDED_EMPTY],
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        ASM_MESON_TAC [SLICE_SUBSET]],
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\n. real_integral (:real)
         (\t. sum (0..n) (\m. measure((slice k t:(real^N->bool)->real^M->bool)

                           (d m))))") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MP_TAC (← ISPEC (← q r"d:num->(real^N->bool)")
       HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [MEASURABLE_INTERVAL], ALL_TAC] THEN
        MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"interval[a:real^N,b]") THEN
        REWRITE_TAC [BOUNDED_INTERVAL, UNIONS_SUBSET, IN_ELIM_THM] THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
      REWRITE_TAC [← GSYM REAL_SUMS] THEN
      REWRITE_TAC [real_sums, FROM_INTER_NUMSEG] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN
      AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) REAL_INTEGRAL_SUM o rand o snd) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [FINITE_NUMSEG] THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?u v. u$k <= v$k /\
                            (d:num->real^N->bool) j = interval[u,v]")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [real_integrable_on] THEN
        EXISTS_TAC (← q r"measure(interval[u:real^N,v])") THEN
        MATCH_MP_TAC FUBINI_CLOSED_INTERVAL THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
      X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
      SUBGOAL_THEN (← q r"?u v. u$k <= v$k /\
                            (d:num->real^N->bool) j = interval[u,v]")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FUBINI_CLOSED_INTERVAL THEN ASM_REWRITE_TAC []])

  pure { FUBINI_SIMPLE_LEMMA }
/- ------------------------------------------------------------------------- -/
/- Weak but useful versions of Fubini's theorem (part 3); scaled integer,    -/
/- and hence rational, values are dense in the reals.                        -/
/- (realanalysis.ml 12427-12607)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBC where
  FUBINI_SIMPLE : thm
  FUBINI_SIMPLE_ALT : thm
  FUBINI_SIMPLE_COMPACT_STRONG : thm
  FUBINI_SIMPLE_COMPACT : thm
  FUBINI_SIMPLE_CONVEX_STRONG : thm
  FUBINI_SIMPLE_CONVEX : thm
  FUBINI_SIMPLE_OPEN_STRONG : thm
  FUBINI_SIMPLE_OPEN : thm
  REAL_OPEN_SET_RATIONAL : thm
  REAL_OPEN_RATIONAL : thm
  REAL_OPEN_SET_EXISTS_RATIONAL : thm
  REAL_OPEN_EXISTS_RATIONAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBC [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAZ : RZAZ) (BRZBA : RZBA) (BRZBB : RZBB) : ExceptT String IO RZBC := do
  -- @@SCOPE BEGIN
  let { REAL_OPEN, .. } := BRZA
  let { real_integrable_on, REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { REAL_INTEGRABLE_SUB, REAL_INTEGRAL_0, REAL_INTEGRAL_SUB, .. } := BRZAL
  let { BOUNDED_SLICE, COMPACT_SLICE, CONVEX_SLICE, OPEN_SLICE, SLICE_DIFF, SLICE_EMPTY,
        SLICE_INTERVAL, SLICE_SUBSET, .. } := BRZAZ
  let { FUBINI_CLOSED_INTERVAL, .. } := BRZBA
  let { FUBINI_SIMPLE_LEMMA, .. } := BRZBB
  let { OPEN_SET_RATIONAL_COORDINATES, .. } := D.qtopology
  let { MEASURABLE_COMPACT, MEASURABLE_CONVEX, MEASURABLE_DIFF, MEASURABLE_EMPTY,
        MEASURABLE_INTERVAL, MEASURABLE_OPEN, MEASURE_DIFF_SUBSET, MEASURE_EMPTY,
        .. } := D.qmeasure
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        SET_TAC, .. } := D.ts.cn.cx.cvx
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ts.cn.ms.ig.qtopology
  let { CONJ_ASSOC, CONJ_SYM, DIMINDEX_1, EQ_TRANS, EXISTS_IN_IMAGE,
        .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_EQ_EMPTY, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_IMP,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_NOT_LE, .. } := D.ts.cn.cx.cvx.core5
  let { FORALL_1, INTERVAL_NE_EMPTY, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { BOUNDED_DIFF, .. } := D.ts.cn.cx.cvx.top1
  let { COMPACT_IMP_BOUNDED, .. } := D.ts.cn.cx.cvx.top2
  let { BOUNDED_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let FUBINI_SIMPLE ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\
        measurable s /\
        (!t. measurable(slice k t s :real^M->bool)) /\
        (\t. measure (slice k t s :real^M->bool)) real_integrable_on (:real)
        ==> measure s =
              real_integral(:real)(\t. measure (slice k t s :real^M->bool))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [SLICE_EMPTY, MEASURE_EMPTY, REAL_INTEGRAL_0],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(interval[a:real^N,b] = {})") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [INTERVAL_NE_EMPTY] THEN DISCH_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"~(&0 < b - a) /\ ~(&0 < a - b) ==> a:real = b")) THEN
    CONJ_TAC THEN MATCH_MP_TAC (← MESON []
       (← q r"(!e. x - y = e ==> ~(&0 < e)) ==> ~(&0 < x - y)")) THEN
    X_GEN_TAC (← q r"e:real") THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"k:num", ← q r"s:real^N->bool", ← q r"e / &2"]
        FUBINI_SIMPLE_LEMMA) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:num", ← q r"interval[a:real^N,b] DIFF s", ← q r"e / &2"]
      FUBINI_SIMPLE_LEMMA) THEN
    ASM_REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    CONJ_TAC THENL [SIMP_TAC [BOUNDED_DIFF, BOUNDED_INTERVAL], ALL_TAC] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTERVAL], ALL_TAC] THEN
    ASM_SIMP_TAC [SLICE_DIFF] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"t:real") THEN MATCH_MP_TAC MEASURABLE_DIFF THEN
      ASM_SIMP_TAC [SLICE_INTERVAL] THEN
      MESON_TAC [MEASURABLE_EMPTY, MEASURABLE_INTERVAL],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!t. measure(slice k t (interval[a:real^N,b]) DIFF
                  slice k t (s:real^N->bool) :real^M->bool) =
          measure(slice k t (interval[a:real^N,b]):real^M->bool) -
          measure(slice k t s :real^M->bool)")
     (fun th => REWRITE_TAC [th])
    THENL
     [X_GEN_TAC (← q r"t:real") THEN MATCH_MP_TAC MEASURE_DIFF_SUBSET THEN
      ASM_SIMP_TAC [SLICE_SUBSET] THEN
      ASM_SIMP_TAC [SLICE_INTERVAL] THEN
      MESON_TAC [MEASURABLE_EMPTY, MEASURABLE_INTERVAL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:num", ← q r"a:real^N", ← q r"b:real^N"] FUBINI_CLOSED_INTERVAL) THEN
    ASM_SIMP_TAC [] THEN DISCH_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_INTEGRABLE_SUB THEN ASM_MESON_TAC [real_integrable_on],
      ALL_TAC] THEN
    REWRITE_TAC [REAL_NOT_LE] THEN
    ASM_SIMP_TAC [MEASURE_DIFF_SUBSET, MEASURABLE_INTERVAL] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_INTEGRAL_SUB o rand o snd) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [real_integrable_on], DISCH_THEN SUBST1_TAC] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
    ASM_REAL_ARITH_TAC)

  let FUBINI_SIMPLE_ALT ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\
        measurable s /\
        (!t. measurable(slice k t s :real^M->bool)) /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measure s = B"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
     (← q r"real_integral (:real)
                   (\t. measure (slice k t (s:real^N->bool) :real^M->bool))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC FUBINI_SIMPLE THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [real_integrable_on],
      MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN ASM_REWRITE_TAC []])

  let FUBINI_SIMPLE_COMPACT_STRONG ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        compact s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measurable s /\ measure s = B"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN
    MATCH_MP_TAC FUBINI_SIMPLE_ALT THEN
    EXISTS_TAC (← q r"k:num") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [COMPACT_IMP_BOUNDED, MEASURABLE_COMPACT] THEN
    GEN_TAC THEN MATCH_MP_TAC MEASURABLE_COMPACT THEN
    MATCH_MP_TAC COMPACT_SLICE THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let FUBINI_SIMPLE_COMPACT ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        compact s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measure s = B"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_SIMPLE_COMPACT_STRONG) THEN SIMP_TAC [])

  let FUBINI_SIMPLE_CONVEX_STRONG ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\ convex s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measurable s /\ measure s = B"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [MEASURABLE_CONVEX] THEN
    MATCH_MP_TAC FUBINI_SIMPLE_ALT THEN
    EXISTS_TAC (← q r"k:num") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [MEASURABLE_CONVEX] THEN
    GEN_TAC THEN MATCH_MP_TAC MEASURABLE_CONVEX THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONVEX_SLICE, MATCH_MP_TAC BOUNDED_SLICE] THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let FUBINI_SIMPLE_CONVEX ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\ convex s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measure s = B"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_SIMPLE_CONVEX_STRONG) THEN SIMP_TAC [])

  let FUBINI_SIMPLE_OPEN_STRONG ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\ open s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measurable s /\ measure s = B"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [MEASURABLE_OPEN] THEN
    MATCH_MP_TAC FUBINI_SIMPLE_ALT THEN
    EXISTS_TAC (← q r"k:num") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [MEASURABLE_OPEN] THEN
    GEN_TAC THEN MATCH_MP_TAC MEASURABLE_OPEN THEN CONJ_TAC THENL
     [MATCH_MP_TAC BOUNDED_SLICE, MATCH_MP_TAC OPEN_SLICE] THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let FUBINI_SIMPLE_OPEN ← prove
   r"!k s:real^N->bool.
        dimindex(:M) + 1 = dimindex(:N) /\
        1 <= k /\ k <= dimindex(:N) /\
        bounded s /\ open s /\
        ((\t. measure (slice k t s :real^M->bool)) has_real_integral B) (:real)
        ==> measure s = B"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_SIMPLE_OPEN_STRONG) THEN SIMP_TAC [])

  -- Scaled integer, and hence rational, values are dense in the reals.

  let REAL_OPEN_SET_RATIONAL ← prove
   r"!s. real_open s /\ ~(s = {}) ==> ?x. rational x /\ x IN s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    MP_TAC (← ISPEC (← q r"IMAGE lift s") OPEN_SET_RATIONAL_COORDINATES) THEN
    ASM_REWRITE_TAC [← GSYM REAL_OPEN, IMAGE_EQ_EMPTY, EXISTS_IN_IMAGE] THEN
    SIMP_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP])

  let REAL_OPEN_RATIONAL ← prove
   r"!P. real_open {x | P x} /\ (?x. P x) ==> ?x. rational x /\ P x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"{x:real | P x}") REAL_OPEN_SET_RATIONAL) THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN ASM_MESON_TAC [])

  let REAL_OPEN_SET_EXISTS_RATIONAL ← prove
   r"!s. real_open s ==> ((?x. rational x /\ x IN s) <=> (?x. x IN s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_MESON_TAC [REAL_OPEN_SET_RATIONAL, ← GSYM MEMBER_NOT_EMPTY])

  let REAL_OPEN_EXISTS_RATIONAL ← prove
   r"!P. real_open {x | P x} ==> ((?x. rational x /\ P x) <=> (?x. P x))"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP REAL_OPEN_SET_EXISTS_RATIONAL) THEN
    REWRITE_TAC [IN_ELIM_THM])

  pure { FUBINI_SIMPLE, FUBINI_SIMPLE_ALT, FUBINI_SIMPLE_COMPACT_STRONG,
         FUBINI_SIMPLE_COMPACT, FUBINI_SIMPLE_CONVEX_STRONG, FUBINI_SIMPLE_CONVEX,
         FUBINI_SIMPLE_OPEN_STRONG, FUBINI_SIMPLE_OPEN, REAL_OPEN_SET_RATIONAL,
         REAL_OPEN_RATIONAL, REAL_OPEN_SET_EXISTS_RATIONAL, REAL_OPEN_EXISTS_RATIONAL }
/- ------------------------------------------------------------------------- -/
/- A criterion for two functions to agree; extending a continuous function   -/
/- in a periodic way.                                                        -/
/- (realanalysis.ml 12608-12766)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBD where
  CONTINUOUS_ON_CONST_DYADIC_RATIONALS : thm
  REAL_CONTINUOUS_ON_CONST_DYADIC_RATIONALS : thm
  REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR : thm
  REAL_CONTINUOUS_FLOOR : thm
  REAL_CONTINUOUS_FRAC : thm
  REAL_CONTINUOUS_ON_COMPOSE_FRAC : thm
  REAL_TIETZE_PERIODIC_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBD [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) (BRZI : RZI) (BRZJ : RZJ) : ExceptT String IO RZBD := do
  -- @@SCOPE BEGIN
  let { WITHINREAL_UNIV, .. } := BRZF
  let { REAL_CONTINUOUS_AT_ID, real_continuous_atreal, REAL_CONTINUOUS_SUB,
        real_continuous_withinreal, .. } := BRZH
  let { REAL_CONTINUOUS_ATREAL_COMPOSE, .. } := BRZI
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_ADD, REAL_CONTINUOUS_ON_COMPOSE,
        REAL_CONTINUOUS_ON_CONST, REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        REAL_CONTINUOUS_ON_ID, REAL_CONTINUOUS_ON_LMUL, REAL_CONTINUOUS_ON_RMUL,
        REAL_CONTINUOUS_ON_SUB, REAL_CONTINUOUS_ON_SUBSET, .. } := BRZJ
  let { CONTINUOUS_CONSTANT_ON_CLOSURE, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { FLOOR_UNIQUE, FRAC_NUM, REAL_FLOOR_LT_REFL, REAL_FLOOR_REFL, REAL_FRAC_ADD,
        REAL_FRAC_EQ, REAL_FRAC_POS_LT, REAL_FRAC_ZERO, .. } := D.qfloor
  let { CONTINUOUS_ADDITIVE_IMP_LINEAR, .. } := D.qmeasure
  let { FRAC_FLOOR, .. } := D.ts.qfloor
  let { FLOOR_FRAC, .. } := D.ts.cn.ms.qfloor
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, REAL_ARITH, REAL_FIELD,
        .. } := D.ts.cn.cx.cvx
  let { FLOOR, INTEGER_CLOSED, .. } := D.ts.cn.ms.ig.qfloor
  let { REAL_SUB_ADD2, .. } := D.ts.cn.ms.ig.qsession
  let { AND_FORALL_THM, DIMINDEX_1, ETA_AX, FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_UNIV, MONO_FORALL, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_REFL,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_INV_1, REAL_INV_MUL, REAL_LE_ADDR, REAL_LE_ANTISYM, REAL_LE_MUL,
        REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_MIN, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_POS, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL,
        SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, real_div, real_pow, SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, FORALL_1, FORALL_DROP, LIFT_ADD, LIFT_CMUL, LIFT_DROP,
        LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, linear, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.ts.cn.cx.cvx.vec4
  let { CLOSURE_DYADIC_RATIONALS, .. } := D.ts.cn.cx.cvx.top1
  -- @@SCOPE END

  let CONTINUOUS_ON_CONST_DYADIC_RATIONALS ← prove
   r"!f:real^M->real^N a.
     f continuous_on (:real^M) /\
     (!x. (!i. 1 <= i /\ i <= dimindex(:M) ==> integer(x$i)) ==> f(x) = a) /\
     (!x. f(x) = a ==> f(inv(&2) % x) = a)
     ==> !x. f(x) = a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^M->real^N",
      ← q r"{ inv(&2 pow n) % x:real^M |n,x|
         !i. 1 <= i /\ i <= dimindex(:M) ==> integer(x$i) }",
      ← q r"a:real^N"] CONTINUOUS_CONSTANT_ON_CLOSURE) THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, CLOSURE_DYADIC_RATIONALS, IN_UNIV] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    INDUCT_TAC THEN ASM_REWRITE_TAC [real_pow, REAL_INV_1, VECTOR_MUL_LID] THEN
    ASM_SIMP_TAC [REAL_INV_MUL, ← GSYM VECTOR_MUL_ASSOC])

  let REAL_CONTINUOUS_ON_CONST_DYADIC_RATIONALS ← prove
   r"!f a.
     f real_continuous_on (:real) /\
     (!x. integer(x) ==> f(x) = a) /\
     (!x. f(x) = a ==> f(x / &2) = a)
     ==> !x. f(x) = a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a"]
      CONTINUOUS_ON_CONST_DYADIC_RATIONALS) THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, ← GSYM IMAGE_LIFT_UNIV] THEN
    ASM_SIMP_TAC [o_THM, DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_EQ, DROP_CMUL,
                  ← REAL_ARITH (← q r"inv(&2) * x = x / &2")] THEN
    ASM_MESON_TAC [LIFT_DROP])

  let REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR ← prove
   r"!f. f real_continuous_on (:real) /\
       (!x y. f(x + y) = f(x) + f(y))
       ==> !a x. f(a * x) = a * f(x)"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"lift o f o drop") CONTINUOUS_ADDITIVE_IMP_LINEAR) THEN
    ASM_REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON, ← GSYM IMAGE_LIFT_UNIV] THEN
    ASM_REWRITE_TAC [linear, ← GSYM FORALL_DROP, o_THM, DROP_ADD, LIFT_DROP,
                     DROP_CMUL, ← GSYM LIFT_ADD, ← GSYM LIFT_CMUL, LIFT_EQ])

  -- Extending a continuous function in a periodic way.

  let REAL_CONTINUOUS_FLOOR ← prove
   r"!x. ~(integer x) ==> floor real_continuous (atreal x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_continuous_atreal] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"min (x - floor x) ((floor x + &1) - x)") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT, REAL_FLOOR_LT_REFL, FLOOR] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x = y ==> abs(x - y) < e")) THEN
    ASM_REWRITE_TAC [← GSYM FLOOR_UNIQUE, FLOOR] THEN
    MP_TAC (← ISPEC (← q r"x:real") FLOOR) THEN ASM_REAL_ARITH_TAC)

  let REAL_CONTINUOUS_FRAC ← prove
   r"!x. ~(integer x) ==> frac real_continuous (atreal x)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
    REWRITE_TAC [FRAC_FLOOR] THEN MATCH_MP_TAC REAL_CONTINUOUS_SUB THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_FLOOR, REAL_CONTINUOUS_AT_ID])

  let REAL_CONTINUOUS_ON_COMPOSE_FRAC ← prove
   r"!f. f real_continuous_on real_interval[&0,&1] /\ f(&1) = f(&0)
       ==> (f o frac) real_continuous_on (:real)"
   (REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"f real_continuous_on real_interval[&0,&1]") THEN
    REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, WITHINREAL_UNIV] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"integer x") THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_CONTINUOUS_ATREAL_COMPOSE THEN
      ASM_SIMP_TAC [REAL_CONTINUOUS_FRAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [IN_REAL_INTERVAL] o
                    SPEC (← q r"frac x")) THEN
      ASM_SIMP_TAC [FLOOR_FRAC, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [real_continuous_atreal, real_continuous_withinreal] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d (min (frac x) (&1 - frac x))") THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_SUB_LT, FLOOR_FRAC, REAL_FRAC_POS_LT] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REAL_ARITH_TAC] THEN
    ASM_SIMP_TAC [real_continuous_atreal, REAL_FRAC_ZERO, REAL_FLOOR_REFL] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (BINDER_CONV o LAND_CONV)
       [IN_REAL_INTERVAL]) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"&1") th) THEN MP_TAC (← SPEC (← q r"&0") th))) THEN
    REWRITE_TAC [REAL_LE_REFL, REAL_POS] THEN
    REWRITE_TAC [IMP_IMP, real_continuous_withinreal, AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC)
                 (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"min (&1) (min d1 d2)") THEN
    ASM_REWRITE_TAC [REAL_LT_01, REAL_LT_MIN, o_DEF] THEN
    X_GEN_TAC (← q r"y:real") THEN STRIP_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"x <= y \/ y < x")) THENL
     [SUBGOAL_THEN (← q r"floor y = floor x") ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM FLOOR_UNIQUE, FLOOR] THEN
        ASM_SIMP_TAC [REAL_FLOOR_REFL] THEN ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [FRAC_FLOOR, REAL_FLOOR_REFL, REAL_SUB_REFL] THEN
        FIRST_X_ASSUM (fun th => MATCH_MP_TAC th THEN ASM_REAL_ARITH_TAC)],
      SUBGOAL_THEN (← q r"floor y = floor x - &1") ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM FLOOR_UNIQUE, FLOOR] THEN
        ASM_SIMP_TAC [REAL_FLOOR_REFL, INTEGER_CLOSED] THEN ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [FRAC_FLOOR, REAL_FLOOR_REFL, REAL_SUB_REFL] THEN
        FIRST_X_ASSUM (fun th => MATCH_MP_TAC th THEN ASM_REAL_ARITH_TAC)]])

  let REAL_TIETZE_PERIODIC_INTERVAL ← prove
   r"!f a b.
        f real_continuous_on real_interval[a,b] /\ f(a) = f(b)
        ==> ?g. g real_continuous_on (:real) /\
                (!x. x IN real_interval[a,b] ==> g(x) = f(x)) /\
                (!x. g(x + (b - a)) = g x)"
   (REPEAT STRIP_TAC THEN DISJ_CASES_TAC (← REAL_ARITH (← q r"b:real <= a \/ a < b")) THENL
     [EXISTS_TAC (← q r"\x:real. (f:real->real) a") THEN
      REWRITE_TAC [IN_REAL_INTERVAL, REAL_CONTINUOUS_ON_CONST] THEN
      ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_ANTISYM],
      EXISTS_TAC (← q r"(f:real->real) o (\y. a + (b - a) * y) o frac o
                  (\x. (x - a) / (b - a))") THEN
      REWRITE_TAC [o_THM] THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [real_div, REAL_CONTINUOUS_ON_RMUL, REAL_CONTINUOUS_ON_SUB,
                  REAL_CONTINUOUS_ON_CONST, REAL_CONTINUOUS_ON_ID] THEN
        MATCH_MP_TAC REAL_CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"(:real)") THEN
        REWRITE_TAC [SUBSET_UNIV] THEN
        MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE_FRAC THEN
        ASM_SIMP_TAC [o_THM, REAL_MUL_RZERO, REAL_MUL_RID, REAL_SUB_ADD2,
                      REAL_ADD_RID] THEN
        MATCH_MP_TAC REAL_CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [REAL_CONTINUOUS_ON_LMUL, REAL_CONTINUOUS_ON_ADD,
                  REAL_CONTINUOUS_ON_CONST, REAL_CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
        ASM_SIMP_TAC [REAL_LE_ADDR, REAL_LE_MUL, REAL_LT_IMP_LE, REAL_SUB_LT] THEN
        REWRITE_TAC [← REAL_ARITH
         (← q r"a + (b - a) * x <= b <=> &0 <= (b - a) * (&1 - x)")] THEN
         ASM_SIMP_TAC [REAL_LE_ADDR, REAL_LE_MUL, REAL_LT_IMP_LE, REAL_SUB_LE],
        X_GEN_TAC (← q r"x:real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
        STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real = b") THENL
         [ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ, REAL_SUB_LT] THEN
          ASM_REWRITE_TAC [FRAC_NUM, REAL_MUL_RZERO, REAL_ADD_RID],
          SUBGOAL_THEN (← q r"frac((x - a) / (b - a)) = (x - a) / (b - a)")
          SUBST1_TAC THENL
           [REWRITE_TAC [REAL_FRAC_EQ] THEN
            ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LT_LDIV_EQ, REAL_SUB_LT] THEN
            ASM_REAL_ARITH_TAC,
            AP_TERM_TAC THEN UNDISCH_TAC (← q r"a:real < b") THEN CONV_TAC REAL_FIELD]],
        ASM_SIMP_TAC [← REAL_FIELD
          (← q r"a < b ==> ((x + b - a) - a) / (b - a) = &1 + (x - a) / (b - a)")] THEN
        REWRITE_TAC [REAL_FRAC_ADD, FRAC_NUM, FLOOR_FRAC, REAL_ADD_LID]]])

  pure { CONTINUOUS_ON_CONST_DYADIC_RATIONALS, REAL_CONTINUOUS_ON_CONST_DYADIC_RATIONALS,
         REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR, REAL_CONTINUOUS_FLOOR, REAL_CONTINUOUS_FRAC,
         REAL_CONTINUOUS_ON_COMPOSE_FRAC, REAL_TIETZE_PERIODIC_INTERVAL }
/- ------------------------------------------------------------------------- -/
/- A variant of REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR for intervals.           -/
/- (realanalysis.ml 12767-12947)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBE where
  REAL_CONTINUOUS_ADDITIVE_EXTEND : thm
  REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBE [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) (BRZI : RZI) (BRZJ : RZJ) (BRZBD : RZBD) : ExceptT String IO RZBE := do
  -- @@SCOPE BEGIN
  let { REALLIM_WITHINREAL, WITHINREAL_UNIV, .. } := BRZF
  let { REAL_CONTINUOUS_ADD, real_continuous_atreal, REAL_CONTINUOUS_LMUL,
        real_continuous_withinreal, .. } := BRZH
  let { REAL_CONTINUOUS_ATREAL_COMPOSE, .. } := BRZI
  let { real_continuous_on, REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR, REAL_CONTINUOUS_FLOOR, REAL_CONTINUOUS_FRAC,
        .. } := BRZBD
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { REAL_ADD_SUB2, .. } := D.qsession
  let { FLOOR_NUM, FLOOR_UNIQUE, FRAC_NUM, REAL_FLOOR_ADD, REAL_FLOOR_REFL, REAL_FRAC_ADD,
        REAL_FRAC_POS_LT, REAL_FRAC_ZERO, .. } := D.qfloor
  let { FRAC_FLOOR, .. } := D.ts.qfloor
  let { FLOOR_FRAC, .. } := D.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RING, .. } := D.ts.cn.cx.cvx
  let { REAL_ADD_SUB, .. } := D.ts.cn.cx.cpx
  let { FLOOR, INTEGER_CLOSED, .. } := D.ts.cn.ms.ig.qfloor
  let { REAL_SUB_ADD2, .. } := D.ts.cn.ms.ig.qsession
  let { AND_FORALL_THM, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, MONO_FORALL, REAL_ABS_MUL, REAL_ABS_NEG, REAL_ABS_NUM,
        REAL_ADD_LDISTRIB, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_LMUL,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_POS, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL, REAL_SUB_RZERO,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  -- @@SCOPE END

  let REAL_CONTINUOUS_ADDITIVE_EXTEND ← prove
   r"!f. f real_continuous_on real_interval[&0,&1] /\
       (!x y. &0 <= x /\ &0 <= y /\ x + y <= &1
              ==> f(x + y) = f(x) + f(y))
       ==> ?g.  g real_continuous_on (:real) /\
                (!x y. g(x + y) = g(x) + g(y)) /\
                (!x. x IN real_interval[&0,&1] ==> g x = f x)"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"f(&0) = &0") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o ISPECL [← q r"&0", ← q r"&0"]) THEN
      REWRITE_TAC [REAL_ADD_LID] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    EXISTS_TAC (← q r"\x. f(&1) * floor(x) + f(frac x)") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [UNDISCH_TAC (← q r"f real_continuous_on real_interval[&0,&1]") THEN
      REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, WITHINREAL_UNIV] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"integer x") THENL
       [ALL_TAC,
        MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN CONJ_TAC THEN
        ASM_SIMP_TAC [REAL_CONTINUOUS_LMUL, REAL_CONTINUOUS_FLOOR, ETA_AX] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] REAL_CONTINUOUS_ATREAL_COMPOSE) THEN
        ASM_SIMP_TAC [REAL_CONTINUOUS_FRAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [IN_REAL_INTERVAL] o
                      SPEC (← q r"frac x")) THEN
        ASM_SIMP_TAC [FLOOR_FRAC, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [real_continuous_atreal, real_continuous_withinreal] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
        ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"min d (min (frac x) (&1 - frac x))") THEN
        ASM_SIMP_TAC [REAL_LT_MIN, REAL_SUB_LT, FLOOR_FRAC, REAL_FRAC_POS_LT] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [real_continuous_atreal, REAL_FRAC_ZERO, REAL_FLOOR_REFL] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (BINDER_CONV o LAND_CONV)
         [IN_REAL_INTERVAL]) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"&1") th) THEN MP_TAC (← SPEC (← q r"&0") th))) THEN
      REWRITE_TAC [REAL_LE_REFL, REAL_POS] THEN
      REWRITE_TAC [IMP_IMP, real_continuous_withinreal, AND_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC)
                   (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"min (&1) (min d1 d2)") THEN
      ASM_REWRITE_TAC [REAL_LT_01, REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"y:real") THEN STRIP_TAC THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"x <= y \/ y < x")) THENL
       [SUBGOAL_THEN (← q r"floor y = floor x") ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM FLOOR_UNIQUE, FLOOR] THEN
          ASM_SIMP_TAC [REAL_FLOOR_REFL] THEN ASM_REAL_ARITH_TAC,
          ASM_SIMP_TAC [FRAC_FLOOR, REAL_FLOOR_REFL] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"(a + x) - (a + &0) = x - &0")] THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC],
        SUBGOAL_THEN (← q r"floor y = floor x - &1") ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM FLOOR_UNIQUE, FLOOR] THEN
          ASM_SIMP_TAC [REAL_FLOOR_REFL, INTEGER_CLOSED] THEN ASM_REAL_ARITH_TAC,
          ASM_SIMP_TAC [FRAC_FLOOR, REAL_FLOOR_REFL] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"(f1 * (x - &1) + f) - (f1 * x + &0) =
                                  f - f1")] THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC]],
      REPEAT GEN_TAC THEN REWRITE_TAC [REAL_FLOOR_ADD, REAL_FRAC_ADD] THEN
      COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, FLOOR_FRAC, REAL_LE_ADD] THENL
       [REAL_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"f1 * ((x + y) + &1) + g = (f1 * x + z) + f1 * y + h <=>
        f1 / &2 + g / &2 = z / &2 + h / &2")] THEN
      SUBGOAL_THEN
       (← q r"!t. &0 <= t /\ t <= &1 ==> f(t) / &2 = f(t / &2)")
      ASSUME_TAC THENL
       [GEN_TAC THEN FIRST_ASSUM (MP_TAC o ISPECL [← q r"t / &2", ← q r"t / &2"]) THEN
        REWRITE_TAC [REAL_HALF] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_POS, REAL_LE_REFL, FLOOR_FRAC, REAL_LT_IMP_LE,
                    ← REAL_ARITH (← q r"~(x + y < &1) ==> &0 <= (x + y) - &1"),
                    ← REAL_ARITH (← q r"x < &1 /\ y < &1 ==> (x + y) - &1 <= &1")] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"f(a + b) = f a + f b /\ f(c + d) = f(c) + f(d) /\ a + b = c + d
        ==> (f:real->real)(a) + f(b) = f(c) + f(d)")) THEN
      REPEAT CONJ_TAC THEN TRY REAL_ARITH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY (fun t => tactic_of do pure (MP_TAC (← SPEC t FLOOR_FRAC)))
        [← q r"x:real", ← q r"y:real"] THEN
      ASM_REAL_ARITH_TAC,
      GEN_TAC THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_CASES_TAC (← q r"x = &1") THEN
      ASM_REWRITE_TAC [FLOOR_NUM, FRAC_NUM, REAL_MUL_RID, REAL_ADD_RID] THEN
      STRIP_TAC THEN SUBGOAL_THEN (← q r"floor x = &0") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [← GSYM FLOOR_UNIQUE, INTEGER_CLOSED],
        ASM_REWRITE_TAC [FRAC_FLOOR, REAL_SUB_RZERO]] THEN
      ASM_REAL_ARITH_TAC])

  let REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR_INTERVAL ← prove
   r"!f b. (f ---> &0) (atreal (&0) within {x | &0 <= x}) /\
         (!x y. &0 <= x /\ &0 <= y /\ x + y <= b ==> f(x + y) = f(x) + f(y))
         ==> !a x. &0 <= x /\ x <= b /\
                   &0 <= a * x /\ a * x <= b
                   ==> f(a * x) = a * f(x)"
   (SUBGOAL_THEN
     (← q r"!f. (f ---> &0) (atreal (&0) within {x | &0 <= x}) /\
          (!x y. &0 <= x /\ &0 <= y /\ x + y <= &1 ==> f(x + y) = f(x) + f(y))
          ==> !a x. &0 <= x /\ x <= &1 /\ &0 <= a * x /\ a * x <= &1
                    ==> f(a * x) = a * f(x)")
    ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!f. f real_continuous_on real_interval[&0,&1] /\
            (!x y. &0 <= x /\ &0 <= y /\ x + y <= &1 ==> f(x + y) = f(x) + f(y))
            ==> !a x. &0 <= x /\ x <= &1 /\ &0 <= a * x /\ a * x <= &1
                      ==> f(a * x) = a * f(x)")
      (fun th => GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC th) THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPEC (← q r"f:real->real") REAL_CONTINUOUS_ADDITIVE_EXTEND) THEN
        ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPEC (← q r"g:real->real") REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR) THEN
        ASM_MESON_TAC [],
        ASM_REWRITE_TAC [real_continuous_on, IN_REAL_INTERVAL] THEN
        X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REALLIM_WITHINREAL]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [REAL_SUB_RZERO] THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"d:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
        X_GEN_TAC (← q r"y:real") THEN STRIP_TAC THEN
        REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
         (← REAL_ARITH (← q r"y = x \/ y < x \/ x < y")) THENL
         [ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_NUM],
          SUBGOAL_THEN (← q r"(f:real->real)(y + (x - y)) = f(y) + f(x - y)")
          MP_TAC THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
            REWRITE_TAC [REAL_SUB_ADD2] THEN DISCH_THEN SUBST1_TAC THEN
            REWRITE_TAC [REAL_ADD_SUB2, REAL_ABS_NEG] THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN
            REWRITE_TAC [IN_ELIM_THM] THEN ASM_REAL_ARITH_TAC],
          SUBGOAL_THEN (← q r"(f:real->real)(x + (y - x)) = f(x) + f(y - x)")
          MP_TAC THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
            REWRITE_TAC [REAL_SUB_ADD2] THEN DISCH_THEN SUBST1_TAC THEN
            REWRITE_TAC [REAL_ADD_SUB] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            REWRITE_TAC [IN_ELIM_THM] THEN ASM_REAL_ARITH_TAC]]],
      REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
       (← REAL_ARITH (← q r"b < &0 \/ b = &0 \/ &0 < b"))
      THENL
       [ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [← REAL_ARITH
         (← q r"a <= x /\ x <= a /\ a <= y /\ y <= a <=> x = a /\ y = a")] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"&0", ← q r"&0"]) THEN
        ASM_REWRITE_TAC [REAL_ADD_LID, REAL_LE_REFL] THEN CONV_TAC (fun t => REAL_RING t),
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"(\x. f(b * x)):real->real")) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:real") THEN
        DISCH_THEN (fun th => tactic_of do
          pure (X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
                MP_TAC (← ISPEC (← q r"x / b:real") th))) THEN
        ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < b ==> b * a * x / b = a * x"),
                      REAL_DIV_LMUL, REAL_LT_IMP_NZ] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a * x / b:real = (a * x) / b")] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
        ASM_REAL_ARITH_TAC] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_ADD_LDISTRIB] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"b * x + b * y <= b <=> &0 <= b * (&1 - (x + y))"),
                      REAL_LE_MUL, REAL_LT_IMP_LE, REAL_SUB_LE]] THEN
      REWRITE_TAC [REALLIM_WITHINREAL] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REALLIM_WITHINREAL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [REAL_SUB_RZERO] THEN
      REWRITE_TAC [REAL_SUB_RZERO, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d / b:real") THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_LT_IMP_LE, REAL_ABS_MUL] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < b ==> abs b * x = x * b")] THEN
      ASM_SIMP_TAC [REAL_LT_MUL, ← GSYM REAL_LT_RDIV_EQ]])

  pure { REAL_CONTINUOUS_ADDITIVE_EXTEND, REAL_CONTINUOUS_ADDITIVE_IMP_LINEAR_INTERVAL }
/- ------------------------------------------------------------------------- -/
/- More Steinhaus variants; Bernstein polynomials; explicit Bernstein        -/
/- version of 1D Weierstrass approximation theorem.                          -/
/- (realanalysis.ml 12948-13179)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBF where
  STEINHAUS_TRIVIAL : thm
  REAL_STEINHAUS : thm
  bernstein : thm
  BERNSTEIN_CONV : ioconv
  BERNSTEIN_POS : thm
  SUM_BERNSTEIN : thm
  BERNSTEIN_LEMMA : thm
  BERNSTEIN_WEIERSTRASS : thm
  deriving Nonempty

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBF [HolBase] (D : RealAnalysisDeps) (BRZK : RZK) (BRZN : RZN) (BRZO : RZO) (BRZQ : RZQ) (BRZAS : RZAS) : ExceptT String IO RZBF := do
  -- @@SCOPE BEGIN
  let { REAL_COMPACT_CONTINUOUS_IMAGE, REAL_COMPACT_UNIFORMLY_CONTINUOUS,
        real_uniformly_continuous_on, .. } := BRZK
  let { REAL_DERIVATIVE_UNIQUE_ATREAL, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_SUM, .. } := BRZO
  let { REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_MEASURABLE_MEASURABLE, REAL_MEASURE_MEASURE, .. } := BRZAS
  let { REAL_BOUNDED_POS, REAL_COMPACT_IMP_BOUNDED, REAL_COMPACT_INTERVAL, .. } := D.qmetric
  let { BALL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { SUM_ABS_NUMSEG, .. } := D.qsession
  let { STEINHAUS, .. } := D.qmeasure
  let { REAL_BINOMIAL_THEOREM, .. } := D.qbinomial
  let { NEGLIGIBLE_COUNTABLE, .. } := D.ts.cn.ms.qintegration3
  let { SUM_EQ_NUMSEG, SUM_SING_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, new_definition,
        REAL_ARITH, REAL_FIELD, REAL_RING, SET_RULE, .. } := D.ts.cn.cx.cvx
  let { REAL_LE_LCANCEL_IMP, REAL_LE_SQUARE, REAL_POW_ADD, SUB_REFL, .. } := D.ts.cn.cx.cpx
  let { REAL_SUB_ADD2, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, CONTRAPOS_THM, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { LE_1, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MULT_CLAUSES, REAL_ABS_MUL,
        REAL_ADD_RDISTRIB, REAL_ARCH_INV, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_INV_MUL, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_LADD, REAL_LE_LDIV_EQ,
        REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_SQUARE_ABS, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID,
        REAL_NOT_LT, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_OF_NUM_SUB,
        REAL_POS, REAL_POW_2, REAL_POW_LE, REAL_POW_LT, REAL_POW_MUL, REAL_POW_ONE,
        REAL_SUB_RDISTRIB, REAL_SUB_REFL, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { real_div, real_pow, SUM_ADD_NUMSEG, SUM_LE_NUMSEG, SUM_LMUL, SUM_RMUL,
        SUM_SUB_NUMSEG, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  let { DROP_ADD, DROP_SUB, DROP_VEC, FORALL_DROP, LIFT_DROP, LIFT_SUB,
        .. } := D.ts.cn.cx.cvx.vec2
  let { IN_INTERVAL_1, .. } := D.ts.cn.cx.cvx.top4
  let { DISCRETE_IMP_COUNTABLE, .. } := D.ts.cn.ms.ig.dv.qtopology1
  -- @@SCOPE END
  let { NUM_BINOM_CONV, NUM_SUB_CONV, REAL_POLY_CONV, .. } := D

  let STEINHAUS_TRIVIAL ← prove
   r"!s e. ~(negligible s) /\ &0 < e
         ==> ?x y:real^N. x IN s /\ y IN s /\ ~(x = y) /\ norm(x - y) < e"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE THEN
    MATCH_MP_TAC DISCRETE_IMP_COUNTABLE THEN
    ASM_MESON_TAC [REAL_NOT_LT])

  let REAL_STEINHAUS ← prove
   r"!s. real_measurable s /\ &0 < real_measure s
       ==> ?d. &0 < d /\
               real_interval(--d,d) SUBSET {x - y | x IN s /\ y IN s}"
   (GEN_TAC THEN SIMP_TAC [IMP_CONJ, REAL_MEASURE_MEASURE] THEN
    REWRITE_TAC [IMP_IMP, REAL_MEASURABLE_MEASURABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP STEINHAUS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
    REWRITE_TAC [SUBSET, BALL_INTERVAL, IN_INTERVAL_1, IN_REAL_INTERVAL] THEN
    REWRITE_TAC [← SET_RULE (← q r"{g x y | x IN IMAGE f s /\ y IN IMAGE f t} =
                          {g (f x) (f y) | x IN s /\ y IN t}")] THEN
    REWRITE_TAC [← GSYM LIFT_SUB] THEN
    REWRITE_TAC [← SET_RULE (← q r"{lift(f x y) | P x y} = IMAGE lift {f x y | P x y}"),
                 IN_IMAGE_LIFT_DROP, ← GSYM FORALL_DROP] THEN
    REWRITE_TAC [DROP_SUB, DROP_VEC, LIFT_DROP, DROP_ADD] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REAL_ARITH_TAC)

  -- Bernstein polynomials.

  let bernstein ← new_definition
   r"bernstein n k x = &(binom(n,k)) * x pow k * (&1 - x) pow (n - k)"

  let BERNSTEIN_CONV : ioconv :=
    GEN_REWRITE_CONV id [bernstein] THENC
    COMB2_CONV (RAND_CONV (RAND_CONV NUM_BINOM_CONV))
               (RAND_CONV (RAND_CONV NUM_SUB_CONV)) THENC
    REAL_POLY_CONV

  -- Lemmas about Bernstein polynomials.

  let BERNSTEIN_POS ← prove
   r"!n k x. &0 <= x /\ x <= &1 ==> &0 <= bernstein n k x"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [bernstein] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_POS] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC THEN
    MATCH_MP_TAC REAL_POW_LE THEN ASM_REAL_ARITH_TAC)

  let SUM_BERNSTEIN ← prove
   r"!n. sum (0..n) (\k. bernstein n k x) = &1"
   (REWRITE_TAC [bernstein, ← GSYM REAL_BINOMIAL_THEOREM] THEN
    REWRITE_TAC [REAL_SUB_ADD2, REAL_POW_ONE])

  let BERNSTEIN_LEMMA ← prove
   r"!n x. sum(0..n) (\k. (&k - &n * x) pow 2 * bernstein n k x) =
         &n * x * (&1 - x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"!x y. sum(0..n) (\k. &(binom(n,k)) * x pow k * y pow (n - k)) =
             (x + y) pow n")
    (LABEL_TAC "0") THENL [ASM_REWRITE_TAC [REAL_BINOMIAL_THEOREM], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. sum(0..n) (\k. &k * &(binom(n,k)) * x pow (k - 1) * y pow (n - k)) =
            &n * (x + y) pow (n - 1)")
    (LABEL_TAC "1") THENL
     [REPEAT GEN_TAC THEN MATCH_MP_TAC REAL_DERIVATIVE_UNIQUE_ATREAL THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\x. sum(0..n) (\k. &(binom(n,k)) * x pow k * y pow (n - k))",
        ← q r"x:real"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUM THEN REWRITE_TAC [FINITE_NUMSEG],
        ASM_REWRITE_TAC []] THEN
      REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN CONV_TAC (fun t => REAL_RING t),
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. sum(0..n)
          (\k. &k * &(k - 1) * &(binom(n,k)) * x pow (k - 2) * y pow (n - k)) =
            &n * &(n - 1) * (x + y) pow (n - 2)")
    (LABEL_TAC "2") THENL
     [REPEAT GEN_TAC THEN MATCH_MP_TAC REAL_DERIVATIVE_UNIQUE_ATREAL THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\x. sum(0..n) (\k. &k * &(binom(n,k)) * x pow (k - 1) * y pow (n - k))",
        ← q r"x:real"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUM THEN REWRITE_TAC [FINITE_NUMSEG],
        ASM_REWRITE_TAC []] THEN
      REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
      REWRITE_TAC [← ARITH_RULE (← q r"n - 1 - 1 = n - 2")] THEN
      CONV_TAC (fun t => REAL_RING t),
      ALL_TAC] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(a - b) pow 2 * x =
      a * (a - &1) * x + (&1 - &2 * b) * a * x + b * b * x")] THEN
    REWRITE_TAC [SUM_ADD_NUMSEG, SUM_LMUL, SUM_BERNSTEIN] THEN
    SUBGOAL_THEN (← q r"sum(0..n) (\k. &k * bernstein n k x) = &n * x") SUBST1_TAC THENL
     [REMOVE_THEN "1" (MP_TAC o SPECL [← q r"x:real", ← q r"&1 - x"]) THEN
      REWRITE_TAC [REAL_SUB_ADD2, REAL_POW_ONE, bernstein, REAL_MUL_RID] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [← GSYM SUM_RMUL] THEN
      MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"(k * b * xk * y) * x:real = k * b * (x * xk) * y")] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 real_pow)] THEN
      DISJ_CASES_TAC (← ARITH_RULE (← q r"k = 0 \/ SUC(k - 1) = k")) THEN
      ASM_REWRITE_TAC [REAL_MUL_LZERO],
      ALL_TAC] THEN
    SUBGOAL_THEN
    (← q r"sum(0..n) (\k. &k * (&k - &1) * bernstein n k x) = &n * (&n - &1) * x pow 2")
    SUBST1_TAC THENL [ALL_TAC, CONV_TAC (fun t => REAL_RING t)] THEN
    REMOVE_THEN "2" (MP_TAC o SPECL [← q r"x:real", ← q r"&1 - x"]) THEN
    REWRITE_TAC [REAL_SUB_ADD2, REAL_POW_ONE, bernstein, REAL_MUL_RID] THEN
    ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_REWRITE_TAC [SUM_SING_NUMSEG, REAL_MUL_LZERO] THEN
    ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB, LE_1, REAL_MUL_ASSOC] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [← GSYM SUM_RMUL] THEN
    MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"((((k * k1) * b) * xk) * y) * x2:real =
                              k * k1 * b * y * (x2 * xk)")] THEN
    REWRITE_TAC [← GSYM REAL_POW_ADD, ← GSYM REAL_MUL_ASSOC] THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← ARITH_RULE (← q r"k = 0 \/ k = 1 \/ 1 <= k /\ 2 + k - 2 = k")) THEN
    ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID, SUB_REFL, REAL_SUB_REFL] THEN
    ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB] THEN REWRITE_TAC [REAL_MUL_AC])

  -- Explicit Bernstein version of 1D Weierstrass approximation theorem

  let BERNSTEIN_WEIERSTRASS ← prove
   r"!f e.
      f real_continuous_on real_interval[&0,&1] /\ &0 < e
      ==> ?N. !n x. N <= n /\ x IN real_interval[&0,&1]
                    ==> abs(f x -
                            sum(0..n) (\k. f(&k / &n) * bernstein n k x)) < e"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"real_bounded(IMAGE f (real_interval[&0,&1]))") MP_TAC THENL
     [MATCH_MP_TAC REAL_COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC REAL_COMPACT_CONTINUOUS_IMAGE THEN
      ASM_REWRITE_TAC [REAL_COMPACT_INTERVAL],
      REWRITE_TAC [REAL_BOUNDED_POS, LEFT_IMP_EXISTS_THM, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN X_GEN_TAC (← q r"M:real") THEN STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"f real_uniformly_continuous_on real_interval[&0,&1]")
    MP_TAC THENL
     [ASM_SIMP_TAC [REAL_COMPACT_UNIFORMLY_CONTINUOUS, REAL_COMPACT_INTERVAL],
      REWRITE_TAC [real_uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, IN_REAL_INTERVAL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"!n x. 0 < n /\ &0 <= x /\ x <= &1
            ==> abs(f x - sum(0..n) (\k. f(&k / &n) * bernstein n k x))
                  <= e / &2 + (&2 * M) / (d pow 2 * &n)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"abs(sum(0..n) (\k. (f x - f(&k / &n)) * bernstein n k x))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [REAL_SUB_RDISTRIB, SUM_SUB_NUMSEG, SUM_LMUL] THEN
        REWRITE_TAC [SUM_BERNSTEIN, REAL_MUL_RID, REAL_LE_REFL],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH lhand SUM_ABS_NUMSEG o lhand o snd) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> x <= a ==> x <= b")) THEN
      REWRITE_TAC [REAL_ABS_MUL] THEN
      ASM_SIMP_TAC [BERNSTEIN_POS, ← REAL_ARITH (← q r"&0 <= x ==> abs x = x")] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"sum(0..n) (\k. (e / &2 + &2 * M / d pow 2 * (x - &k / &n) pow 2) *
                       bernstein n k x)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
        REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
        ASM_SIMP_TAC [BERNSTEIN_POS] THEN
        SUBGOAL_THEN (← q r"&0 <= &k / &n /\ &k / &n <= &1") STRIP_ASSUME_TAC THENL
         [ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_OF_NUM_LT] THEN
          ASM_REWRITE_TAC [REAL_OF_NUM_MUL, REAL_OF_NUM_LE, MULT_CLAUSES],
          ALL_TAC] THEN
        DISJ_CASES_TAC (← REAL_ARITH
          (← q r"abs(x - &k / &n) < d \/ d <= abs(x - &k / &n)"))
        THENL
         [MATCH_MP_TAC (← REAL_ARITH (← q r"x < e /\ &0 <= d ==> x <= e + d")) THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= &2 * x <=> &0 <= x")] THEN
          ASM_SIMP_TAC [REAL_LE_MUL, REAL_LE_DIV, REAL_POW_2, REAL_LE_SQUARE,
                        REAL_LT_IMP_LE],
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= d ==> x <= e / &2 + d")) THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(x) <= M /\ abs(y) <= M /\ M * &1 <= M * b / d
            ==> abs(x - y) <= &2 * M / d * b")) THEN
          ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_POW_LT, REAL_LE_RDIV_EQ] THEN
          REWRITE_TAC [REAL_MUL_LID, ← GSYM REAL_LE_SQUARE_ABS] THEN
          ASM_REAL_ARITH_TAC],
        REWRITE_TAC [REAL_ADD_RDISTRIB, SUM_ADD_NUMSEG, SUM_LMUL] THEN
        REWRITE_TAC [SUM_BERNSTEIN, REAL_MUL_RID, REAL_LE_LADD] THEN
        REWRITE_TAC [← GSYM REAL_MUL_ASSOC, SUM_LMUL] THEN
        REWRITE_TAC [real_div, REAL_INV_MUL, ← GSYM REAL_MUL_ASSOC] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_OF_NUM_LT, ARITH, REAL_POW_LT,
                      REAL_LT_INV_EQ] THEN
        MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN EXISTS_TAC (← q r"&n pow 2") THEN
        ASM_SIMP_TAC [← GSYM SUM_LMUL, REAL_POW_LT, REAL_OF_NUM_LT, ← REAL_FIELD
          (← q r"&0 < n ==> n pow 2 * inv(n) = n")] THEN
        REWRITE_TAC [REAL_MUL_ASSOC, ← GSYM REAL_POW_MUL] THEN
        ASM_SIMP_TAC [REAL_OF_NUM_LT, ← REAL_FIELD
          (← q r"&0 < n ==> n * (x - k * inv n) = n * x - k")] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(x - y:real) pow 2 = (y - x) pow 2")] THEN
        REWRITE_TAC [BERNSTEIN_LEMMA, ← REAL_ARITH
          (← q r"&n * x <= &n <=> &n * x <= &n * &1 * &1")] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
        MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REAL_ARITH_TAC],
      MP_TAC (← ISPEC (← q r"(e / &4 * d pow 2) / (&2 * M)") REAL_ARCH_INV) THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_OF_NUM_LT, ARITH, REAL_LT_MUL] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, REAL_POW_LT, REAL_MUL_LZERO] THEN
      REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(x * &2 * m) * i = (&2 * m) * (i * x)")] THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL] THEN
      ASM_SIMP_TAC [← GSYM real_div, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real"]) THEN ASM_SIMP_TAC [] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ k < e / &4 ==> x <= e / &2 + k ==> x < e")) THEN
      ASM_SIMP_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < e ==> y <= x ==> y < e"))) THEN
      ASM_SIMP_TAC [real_div, REAL_LE_LMUL_EQ, REAL_LT_MUL,
                    REAL_OF_NUM_LT, ARITH] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_MUL, REAL_POW_LT,
                    REAL_OF_NUM_LT, LE_1, REAL_OF_NUM_LE]])

  pure { STEINHAUS_TRIVIAL, REAL_STEINHAUS, bernstein, BERNSTEIN_CONV, BERNSTEIN_POS,
         SUM_BERNSTEIN, BERNSTEIN_LEMMA, BERNSTEIN_WEIERSTRASS }
/- ------------------------------------------------------------------------- -/
/- General Stone-Weierstrass theorem.                                        -/
/- (realanalysis.ml 13180-13557)                                            -/
/- ------------------------------------------------------------------------- -/

/-- equal.ml's `PAT_CONV` on `ioconv`s (as `HolLibrary.Words.patConvIO`, which
    this file does not import). -/
partial def patConvRZ [HolBase] (pat : term) (c : ioconv) : ioconv :=
  let rec PCONV (xs : List term) (pat : term) : ioconv :=
    if mem pat xs then c
    else if !(exists' (fun x => HolCore.Basics.free_in x pat) xs) then ALL_CONV
    else match pat with
      | .Comb l r => COMB2_CONV (PCONV xs l) (PCONV xs r)
      | .Abs _ b => ABS_CONV (PCONV xs b)
      | _ => ALL_CONV
  let (xs, pbod) := HolCore.Basics.strip_abs pat
  PCONV xs pbod

structure RZBG where
  STONE_WEIERSTRASS_ALT : thm
  STONE_WEIERSTRASS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBG [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZH : RZH) (BRZI : RZI) (BRZJ : RZJ) (BRZN : RZN) (BRZBF : RZBF) : ExceptT String IO RZBG := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, REAL_BOUNDED_POS_LT, .. } := BRZA
  let { REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_MUL,
        real_continuous_withinreal, .. } := BRZH
  let { REAL_CONTINUOUS_WITHIN_COMPOSE, .. } := BRZI
  let { real_continuous_on, .. } := BRZJ
  let { REAL_CONTINUOUS_CONTINUOUS1, .. } := BRZN
  let { bernstein, BERNSTEIN_WEIERSTRASS, .. } := BRZBF
  let { COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { REAL_MIN_INF, REAL_SUP_LT_FINITE, .. } := D.qsession
  let { REAL_LT_SUP_FINITE, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH,
        REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { LE_0, .. } := D.ts.cn.cx.cpx
  let { INF_INSERT_FINITE, REAL_ABS_0, SUP_INSERT_FINITE, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, ETA_AX, EXISTS_IN_IMAGE, FINITE_IMAGE, FINITE_INDUCT_STRONG, FORALL_AND_THM,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o,
        IMP_CONJ, IMP_CONJ_ALT, INSERT_AC, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        REAL_ABS_MUL, REAL_ABS_POS, REAL_DIV_LMUL, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LT_ADD, REAL_LT_ADDR, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_MUL,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_LT,
        REAL_SUB_REFL, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, real_pow, SUM_CLAUSES_NUMSEG, UNIONS_IMAGE,
        .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  let { LIFT_DROP, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, .. } := D.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUB, .. } := D.ts.cn.cx.cvx.top3
  let { OPEN_HALFSPACE_COMPONENT_LT, .. } := D.ts.cn.cx.cvx.top4
  let { REAL_LT_MUL2, .. } := D.ts.cn.ms.ig.dv.qsession
  let { REAL_INF_LT_FINITE, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { CONTINUOUS_OPEN_IN_PREIMAGE, .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { EXISTS_FINITE_SUBSET_IMAGE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END
  let PAT_CONV : term → ioconv → ioconv := patConvRZ

  let STONE_WEIERSTRASS_ALT ← prove
   r"!(P:(real^N->real)->bool) (s:real^N->bool).
        compact s /\
        (!c. P(\x. c)) /\
        (!f g. P(f) /\ P(g) ==> P(\x. f x + g x)) /\
        (!f g. P(f) /\ P(g) ==> P(\x. f x * g x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y)
               ==> ?f. (!x. x IN s ==> f real_continuous (at x within s)) /\
                       P(f) /\ ~(f x = f y))
        ==> !f e. (!x. x IN s ==> f real_continuous (at x within s)) /\ &0 < e
                  ==> ?g. P(g) /\ !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MAP_EVERY ABBREV_TAC
     [← q r"C = \f. !x:real^N. x IN s ==> f real_continuous at x within s",
      ← q r"A = \f. C f /\
             !e. &0 < e
               ==> ?g. P(g) /\ !x:real^N. x IN s ==> abs(f x - g x) < e"] THEN
    SUBGOAL_THEN (← q r"!f:real^N->real. C(f) ==> A(f)") MP_TAC THENL
     [ALL_TAC, MAP_EVERY EXPAND_TAC ["A", "C"] THEN SIMP_TAC []] THEN
    SUBGOAL_THEN (← q r"!c:real. A(\x:real^N. c)") (LABEL_TAC "const") THENL
     [MAP_EVERY EXPAND_TAC ["A", "C"] THEN X_GEN_TAC (← q r"c:real") THEN
      ASM_REWRITE_TAC [REAL_CONTINUOUS_CONST] THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(\x. c):real^N->real") THEN
      ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_0],
      ALL_TAC] THEN
