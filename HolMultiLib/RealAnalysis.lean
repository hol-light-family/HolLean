  let { CX_ASN, .. } := D.tsv
  let { CONTINUOUS_WITHIN_CACS_REAL, CONTINUOUS_WITHIN_CASN_REAL, CX_ACS, .. } := D.tsw
  let { DIFFERENTIABLE_CHAIN_AT, DIFFERENTIABLE_SQNORM_AT, .. } := D.qderivatives
  let { CLOSED_REAL, .. } := D.ts.kna
  let { CONTINUOUS_WITHIN_CLOSED_NONTRIVIAL, .. } := D.ts.qtopology
