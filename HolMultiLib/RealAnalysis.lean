  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_WITHINREAL_SUBSET, .. } := BRZH
  let { REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { real_differentiable, .. } := BRZK
  let { REAL_DIFFERENTIABLE_AT, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_CHAIN, HAS_REAL_DERIVATIVE_CHAIN_UNIV,
        REAL_COMPLEX_CONTINUOUS_WITHINREAL, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_CDIV_ATREAL,
        HAS_REAL_DERIVATIVE_CDIV_WITHIN, HAS_REAL_DERIVATIVE_CONST,
        HAS_REAL_DERIVATIVE_DIV_ATREAL, HAS_REAL_DERIVATIVE_DIV_WITHIN,
        HAS_REAL_DERIVATIVE_ID, HAS_REAL_DERIVATIVE_INV_ATREAL,
        HAS_REAL_DERIVATIVE_INV_WITHIN, HAS_REAL_DERIVATIVE_LMUL_ATREAL,
        HAS_REAL_DERIVATIVE_LMUL_WITHIN, HAS_REAL_DERIVATIVE_MUL_ATREAL,
        HAS_REAL_DERIVATIVE_MUL_WITHIN, HAS_REAL_DERIVATIVE_NEG,
        HAS_REAL_DERIVATIVE_POW_ATREAL, HAS_REAL_DERIVATIVE_POW_WITHIN,
