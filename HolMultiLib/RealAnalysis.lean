  real_differentiation_theorems : IO.Ref (List thm)
  add_real_differentiation_theorems : List thm → ExceptT String IO Unit
  REAL_DIFF_CONV : term → ExceptT String IO thm
  REAL_DIFF_TAC : tactic
  REAL_DIFFERENTIABLE_TAC : tactic
  deriving Nonempty

