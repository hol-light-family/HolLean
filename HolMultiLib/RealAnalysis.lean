/-- lib.ml's `repeat` for a rule that can fail: apply `f` until it fails. -/
private partial def repeatRule (f : thm → ExceptT String IO thm) (x : thm) :
    ExceptT String IO thm :=
  tryWith (do repeatRule f (← f x)) (pure x)

mutual
/-- The `let rec REAL_DIFF_CONV tm` of realanalysis.ml 4388-4396, over the
    theorem list ref (dereferenced on every call, as `!` does), `partfn`
    and `is_deriv`. -/
partial def realDiffConvGo [HolBase] (rdt : IO.Ref (List thm))
    (partfn : term → Except String term) (is_deriv : term → ExceptT String IO Bool)
    (tm : term) : ExceptT String IO thm := do
  let all ← rdt.get
  tryWith (do
      let ptm ← liftExcept (partfn tm)
      HolMath.IndTypes.tryfindM' (fun th => PART_MATCH partfn th ptm) all)
    (do
      let ith ← HolMath.IndTypes.tryfindM' (fun th => do
        PART_MATCH (fun t => partfn (repeat' (fun u => do pure (← HolCore.Basics.dest_imp u).2) t)) th
          (← liftExcept (partfn tm))) all
      realDiffElimGo rdt partfn is_deriv ith)

/-- The `and REAL_DIFF_ELIM th` of realanalysis.ml 4397-4402. -/
partial def realDiffElimGo [HolBase] (rdt : IO.Ref (List thm))
    (partfn : term → Except String term) (is_deriv : term → ExceptT String IO Bool)
    (th : thm) : ExceptT String IO thm := do
  let tm := concl th
  if !HolCore.Basics.is_imp tm then return th
  let t ← liftExcept (lhand tm)
  if !(← is_deriv t) then UNDISCH th
  else
    let th1 ← realDiffConvGo rdt partfn is_deriv t
    realDiffElimGo rdt partfn is_deriv (← MATCH_MP th th1)
end

structure RZQ where
  DIFFERENTIABLE_NORM_AT : thm
  DIFFERENTIABLE_ON_NORM : thm
  REAL_CONTINUOUS_WITHIN_ASN_STRONG : thm
  REAL_CONTINUOUS_ON_ASN : thm
  REAL_CONTINUOUS_WITHIN_ACS_STRONG : thm
