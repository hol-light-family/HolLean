                        ← q r"{x:real^1 | x$1 < e}"] CONTINUOUS_OPEN_IN_PREIMAGE) THEN
      REWRITE_TAC [OPEN_HALFSPACE_COMPONENT_LT, IN_ELIM_THM] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP, o_DEF] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [← REAL_ARITH (← q r"x - y < z <=> x - z < y")] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [LIFT_SUB, ← GSYM REAL_CONTINUOUS_CONTINUOUS1,
                   ← REAL_ARITH (← q r"x < y + e <=> x - y < e")] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      REWRITE_TAC [← GSYM REAL_CONTINUOUS_CONTINUOUS1, ETA_AX] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE, UNIONS_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\z:real^N. sup {f1 (x:real^N) z | x IN t}") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REMOVE_THEN "sup" (MP_TAC o SPEC (← q r"IMAGE (f1:real^N->real^N->real) t")) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ETA_AX] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(t:real^N->bool = {})") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SIMPLE_IMAGE, ← REAL_ARITH
     (← q r"abs(f - s) < e <=> f - e < s /\ s < f + e")] THEN
    ASM_SIMP_TAC [REAL_SUP_LT_FINITE, REAL_LT_SUP_FINITE,
                  FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    UNDISCH_TAC (← q r"s SUBSET {y:real^N | ?x:real^N. x IN t /\ y IN H x}") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    EXPAND_TAC "H" THEN REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [])

  let STONE_WEIERSTRASS ← prove
   r"!(P:(real^N->real)->bool) (s:real^N->bool).
        compact s /\
        (!f. P(f) ==> !x. x IN s ==> f real_continuous (at x within s)) /\
        (!c. P(\x. c)) /\
        (!f g. P(f) /\ P(g) ==> P(\x. f x + g x)) /\
        (!f g. P(f) /\ P(g) ==> P(\x. f x * g x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> ?f. P(f) /\ ~(f x = f y))
        ==> !f e. (!x. x IN s ==> f real_continuous (at x within s)) /\ &0 < e
                  ==> ?g. P(g) /\ !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC STONE_WEIERSTRASS_ALT THEN ASM_SIMP_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM_MESON_TAC [])

  pure { STONE_WEIERSTRASS_ALT, STONE_WEIERSTRASS }

/- ------------------------------------------------------------------------- -/
/- Real and complex versions of Stone-Weierstrass theorem.                   -/
/- (realanalysis.ml 13558-13717)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBH where
  REAL_STONE_WEIERSTRASS_ALT : thm
  REAL_STONE_WEIERSTRASS : thm
  COMPLEX_STONE_WEIERSTRASS_ALT : thm
  COMPLEX_STONE_WEIERSTRASS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBH [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZH : RZH) (BRZI : RZI) (BRZJ : RZJ) (BRZK : RZK) (BRZN : RZN) (BRZBG : RZBG) : ExceptT String IO RZBH := do
  -- @@SCOPE BEGIN
  let { real_compact, .. } := BRZA
  let { REAL_CONTINUOUS_AT_WITHIN, real_continuous_within, .. } := BRZH
  let { REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE, .. } := BRZI
  let { REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := BRZJ
  let { REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT, .. } := BRZK
  let { REAL_CONTINUOUS_CONTINUOUS_WITHINREAL, .. } := BRZN
  let { STONE_WEIERSTRASS_ALT, .. } := BRZBG
  let { COMPLEX_EQ, SIMPLE_COMPLEX_ARITH, .. } := D.ts.cn.cxa
  let { COMPLEX_SUB_LDISTRIB, .. } := D.ts.cn.cxb
  let { COMPLEX_EXPAND, COMPLEX_NORM_CX, COMPLEX_NORM_II, CX_SUB, RE_ADD, RE_CX, RE_MUL_CX,
        .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_MUL, .. } := D.ts.cn.cxf
  let { CX_IM_CNJ, CX_RE_CNJ, .. } := D.ts.cn.cxg
  let { ASM_MESON_TAC, NORM_ARITH, .. } := D.ts.cn.cx.cvx
  let { AND_FORALL_THM, CONJ_ASSOC, DE_MORGAN_THM, ETA_AX, EXISTS_IN_GSPEC,
        FORALL_IN_GSPEC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_MUL_LID, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  let { DIST_LIFT, .. } := D.ts.cn.cx.cvx.vec1
  let { LIFT_DROP, LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { continuous_within, .. } := D.ts.cn.cx.cvx.top5
  -- @@SCOPE END

  let REAL_STONE_WEIERSTRASS_ALT ← prove
   r"!P s. real_compact s /\
         (!c. P (\x. c)) /\
         (!f g. P f /\ P g ==> P (\x. f x + g x)) /\
         (!f g. P f /\ P g ==> P (\x. f x * g x)) /\
         (!x y. x IN s /\ y IN s /\ ~(x = y)
                ==> ?f. f real_continuous_on s /\ P f /\ ~(f x = f y))
         ==> !f e. f real_continuous_on s /\ &0 < e
                   ==> ?g. P g /\ !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\f. (P:(real->real)->bool)(f o lift)",
      ← q r"IMAGE lift s"] STONE_WEIERSTRASS_ALT) THEN
    ASM_SIMP_TAC [← GSYM real_compact, o_DEF] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"y:real") THEN REWRITE_TAC [LIFT_EQ] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real", ← q r"y:real"]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(g:real->real) o drop") THEN
      ASM_REWRITE_TAC [o_THM, LIFT_DROP, ETA_AX] THEN
      UNDISCH_TAC (← q r"g real_continuous_on s") THEN
      REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS_WITHINREAL] THEN
      REWRITE_TAC [real_continuous_within, continuous_within] THEN
      REWRITE_TAC [o_THM, LIFT_DROP, DIST_LIFT],
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real->real) o drop")) THEN ANTS_TAC THENL
       [UNDISCH_TAC (← q r"f real_continuous_on s") THEN
        REWRITE_TAC [REAL_CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
        REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS_WITHINREAL] THEN
        REWRITE_TAC [real_continuous_within, continuous_within] THEN
        REWRITE_TAC [o_THM, LIFT_DROP, DIST_LIFT],
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [o_DEF, LIFT_DROP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(g:real^1->real) o lift") THEN ASM_REWRITE_TAC [o_DEF]]])

  let REAL_STONE_WEIERSTRASS ← prove
   r"!P s. real_compact s /\
         (!f. P f ==> f real_continuous_on s) /\
         (!c. P (\x. c)) /\
         (!f g. P f /\ P g ==> P (\x. f x + g x)) /\
         (!f g. P f /\ P g ==> P (\x. f x * g x)) /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) ==> ?f. P f /\ ~(f x = f y))
         ==> !f e. f real_continuous_on s /\ &0 < e
                   ==> ?g. P g /\ !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_STONE_WEIERSTRASS_ALT THEN ASM_SIMP_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real", ← q r"y:real"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM_MESON_TAC [])

  let COMPLEX_STONE_WEIERSTRASS_ALT ← prove
   r"!P s. compact s /\
         (!c. P (\x. c)) /\
         (!f. P f ==> P(\x. cnj(f x))) /\
         (!f g. P f /\ P g ==> P (\x. f x + g x)) /\
         (!f g. P f /\ P g ==> P (\x. f x * g x)) /\
         (!x y. x IN s /\ y IN s /\ ~(x = y)
                ==> ?f. P f /\ f continuous_on s /\ ~(f x = f y))
         ==> !f:real^N->complex e.
                f continuous_on s /\ &0 < e
                ==> ?g. P g /\ !x. x IN s ==> norm(f x - g x) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!f. P f ==> P(\x:real^N. Cx(Re(f x)))") ASSUME_TAC THENL
     [ASM_SIMP_TAC [CX_RE_CNJ, ← SIMPLE_COMPLEX_ARITH
       (← q r"x / Cx(&2) = inv(Cx(&2)) * x")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!f. P f ==> P(\x:real^N. Cx(Im(f x)))") ASSUME_TAC THENL
     [ASM_SIMP_TAC [CX_IM_CNJ, ← SIMPLE_COMPLEX_ARITH
       (← q r"x - y = x + --Cx(&1) * y /\ x / Cx(&2) = inv(Cx(&2)) * x")] THEN
      REPEAT STRIP_TAC THEN REPEAT (FIRST_ASSUM MATCH_MP_TAC ORELSE CONJ_TAC) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\x. x IN {Re o f | P (f:real^N->complex)}", ← q r"s:real^N->bool"]
          STONE_WEIERSTRASS_ALT) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, IMP_IMP, ← GSYM CONJ_ASSOC] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM, IN_ELIM_THM] THEN
      REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"c:real") THEN EXISTS_TAC (← q r"\x:real^N. Cx(c)") THEN
        ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, RE_CX],
        MAP_EVERY X_GEN_TAC [← q r"f:real^N->complex", ← q r"g:real^N->complex"] THEN
        DISCH_TAC THEN EXISTS_TAC (← q r"(\x. f x + g x):real^N->complex") THEN
        ASM_SIMP_TAC [o_THM, RE_ADD, FUN_EQ_THM],
        MAP_EVERY X_GEN_TAC [← q r"f:real^N->complex", ← q r"g:real^N->complex"] THEN
        STRIP_TAC THEN
        EXISTS_TAC (← q r"\x:real^N. Cx(Re(f x)) * Cx(Re(g x))") THEN
        ASM_SIMP_TAC [FUN_EQ_THM, RE_CX, o_THM, RE_MUL_CX],
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"f:real^N->complex") THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [COMPLEX_EQ] THEN
        REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC THENL
         [EXISTS_TAC (← q r"\x:real^N. Re(f x)") THEN ASM_REWRITE_TAC [o_DEF] THEN
          CONJ_TAC THENL
           [ALL_TAC, EXISTS_TAC (← q r"f:real^N->complex") THEN ASM_REWRITE_TAC []],
          EXISTS_TAC (← q r"\x:real^N. Im(f x)") THEN ASM_REWRITE_TAC [o_DEF] THEN
          CONJ_TAC THENL
           [ALL_TAC,
            EXISTS_TAC (← q r"\x:real^N. Cx(Im(f x))") THEN ASM_SIMP_TAC [RE_CX]]] THEN
        X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN REWRITE_TAC [← GSYM o_DEF] THEN
        MATCH_MP_TAC REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE THEN
        SIMP_TAC [REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT,
                  REAL_CONTINUOUS_AT_WITHIN] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]],
      DISCH_THEN (LABEL_TAC "*") THEN X_GEN_TAC (← q r"f:real^N->complex") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "*"
       (fun th => tactic_of do
          pure (MP_TAC (← ISPEC (← q r"Re o (f:real^N->complex)") th) THEN
                MP_TAC (← ISPEC (← q r"Im o (f:real^N->complex)") th))) THEN
      MATCH_MP_TAC (← TAUT (← q r"(p1 /\ p2) /\ (q1 /\ q2 ==> r)
                         ==> (p1 ==> q1) ==> (p2 ==> q2) ==> r")) THEN
      CONJ_TAC THENL
       [CONJ_TAC THEN X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
        MATCH_MP_TAC REAL_CONTINUOUS_CONTINUOUS_WITHIN_COMPOSE THEN
        SIMP_TAC [REAL_CONTINUOUS_COMPLEX_COMPONENTS_AT,
                  REAL_CONTINUOUS_AT_WITHIN] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN],
        ALL_TAC] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, o_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"g:real^N->complex") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"h:real^N->complex") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"\x:real^N. Cx(Re(h x)) + ii * Cx(Re(g x))") THEN
      ASM_SIMP_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV) [COMPLEX_EXPAND] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x1 - x2) < e / &2 /\ norm(y1 - y2) < e / &2
        ==> norm((x1 + y1) - (x2 + y2)) < e")) THEN
      ASM_SIMP_TAC [← GSYM CX_SUB, COMPLEX_NORM_CX, ← GSYM COMPLEX_SUB_LDISTRIB,
                    COMPLEX_NORM_MUL, COMPLEX_NORM_II, REAL_MUL_LID]])

  let COMPLEX_STONE_WEIERSTRASS ← prove
   r"!P s. compact s /\
         (!f. P f ==> f continuous_on s) /\
         (!c. P (\x. c)) /\
         (!f. P f ==> P(\x. cnj(f x))) /\
         (!f g. P f /\ P g ==> P (\x. f x + g x)) /\
         (!f g. P f /\ P g ==> P (\x. f x * g x)) /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) ==> ?f. P f /\ ~(f x = f y))
         ==> !f:real^N->complex e.
                f continuous_on s /\ &0 < e
                ==> ?g. P g /\ !x. x IN s ==> norm(f x - g x) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC COMPLEX_STONE_WEIERSTRASS_ALT THEN ASM_SIMP_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM_MESON_TAC [])

  pure { REAL_STONE_WEIERSTRASS_ALT, REAL_STONE_WEIERSTRASS,
         COMPLEX_STONE_WEIERSTRASS_ALT, COMPLEX_STONE_WEIERSTRASS }

/- ------------------------------------------------------------------------- -/
/- Stone-Weierstrass for R^n -> R polynomials.                               -/
/- (realanalysis.ml 13718-14004)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBI where
  real_polynomial_function_RULES : thm
  real_polynomial_function_INDUCT : thm
  real_polynomial_function_CASES : thm
  REAL_POLYNOMIAL_FUNCTION_ADD : thm
  REAL_POLYNOMIAL_FUNCTION_MUL : thm
  REAL_POLYNOMIAL_FUNCTION_NEG : thm
  REAL_POLYNOMIAL_FUNCTION_SUB : thm
  REAL_POLYNOMIAL_FUNCTION_SUM : thm
  REAL_POLYNOMIAL_FUNCTION_PRODUCT : thm
  REAL_POLYNOMIAL_FUNCTION_POW : thm
  POLYNOMIAL_FUNCTION_LIFT : thm
  POLYNOMIAL_FUNCTION_DROP : thm
  REAL_POLYNOMIAL_FUNCTION_EXPLICIT : thm
  REAL_POLYNOMIAL_FUNCTION_EXPLICIT_NZ : thm
  REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV : thm
  REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION : thm
  STONE_WEIERSTRASS_REAL_POLYNOMIAL_FUNCTION : thm
  REAL_STONE_WEIERSTRASS_POLYNOMIAL_FUNCTION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBI [HolBase] (D : RealAnalysisDeps) (BRZH : RZH) (BRZN : RZN) (BRZS : RZS) (BRZBG : RZBG) (BRZBH : RZBH) : ExceptT String IO RZBI := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_AT_WITHIN, REAL_CONTINUOUS_CONST,
        REAL_CONTINUOUS_MUL, .. } := BRZH
  let { REAL_CONTINUOUS_AT_COMPONENT, .. } := BRZN
  let { REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION, .. } := BRZS
  let { STONE_WEIERSTRASS, .. } := BRZBG
  let { REAL_STONE_WEIERSTRASS, .. } := BRZBH
  let { POLYNOMIAL_FUNCTION_ADD, POLYNOMIAL_FUNCTION_CONST, POLYNOMIAL_FUNCTION_ID,
        POLYNOMIAL_FUNCTION_INDUCT, POLYNOMIAL_FUNCTION_MUL, SUM_ADD_GEN, .. } := D.qsession
  let { PRODUCT_DELTA, PRODUCT_ONE, .. } := D.qproducts
  let { INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING, SET_RULE,
        SET_TAC, .. } := D.ts.cn.cx.cvx
  let { PRODUCT_CLAUSES, REAL_POW_1, REAL_POW_ADD, real_sub, .. } := D.ts.cn.cx.cpx
  let { PRODUCT_MUL_NUMSEG, .. } := D.ts.cn.ms.ig.qproducts
  let { FINITE_PRODUCT, SUM_GROUP, SUM_SUM_PRODUCT, .. } := D.ts.cn.ms.ig.qsession
  let { AND_FORALL_THM, CART_EQ, COND_RAND, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM,
        DIMINDEX_1, ETA_AX, EXTENSION, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG,
        FINITE_SING, FINITE_SUBSET, FINITE_UNION, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_INSERT, FORALL_PAIR_THM, IMP_CONJ, IMP_IMP, IN_ELIM_PAIR_THM,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, REAL_ADD_RDISTRIB,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_NEG_NEG, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_pow, SUBSET_UNIV, SUM_CLAUSES, SUM_EQ, SUM_EQ_SUPERSET, SUM_LMUL,
        SUM_RMUL, SUM_SING, SUM_SUPERSET, SWAP_EXISTS_THM, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_1, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  -- @@SCOPE END

  let { new_inductive_definition, .. } := D

  let (real_polynomial_function_RULES,
       real_polynomial_function_INDUCT,
       real_polynomial_function_CASES) ← new_inductive_definition
   r"(!i. 1 <= i /\ i <= dimindex(:N)
       ==> real_polynomial_function(\x:real^N. x$i)) /\
  (!c. real_polynomial_function(\x:real^N. c)) /\
  (!f g. real_polynomial_function f /\ real_polynomial_function g
         ==> real_polynomial_function(\x:real^N. f x + g x)) /\
  (!f g. real_polynomial_function f /\ real_polynomial_function g
         ==> real_polynomial_function(\x:real^N. f x * g x))"

  let REAL_POLYNOMIAL_FUNCTION_ADD ← prove
   r"!f g. real_polynomial_function f /\ real_polynomial_function g
         ==> real_polynomial_function(\x. f x + g x)"
   (REWRITE_TAC [real_polynomial_function_RULES])

  let REAL_POLYNOMIAL_FUNCTION_MUL ← prove
   r"!f g. real_polynomial_function f /\ real_polynomial_function g
         ==> real_polynomial_function(\x. f x * g x)"
   (REWRITE_TAC [real_polynomial_function_RULES])

  let REAL_POLYNOMIAL_FUNCTION_NEG ← prove
   r"!f:real^N->real.
        real_polynomial_function(\x. --(f x)) <=> real_polynomial_function f"
   (MATCH_MP_TAC (← MESON []
     (← q r"(!x. n(n x) = x) /\ (!x. P x ==> P(n x)) ==> (!x. P(n x) <=> P x)")) THEN
    REWRITE_TAC [REAL_NEG_NEG, ETA_AX] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"--x:real = --(&1) * x")] THEN
    ASM_SIMP_TAC [real_polynomial_function_RULES, ETA_AX])

  let REAL_POLYNOMIAL_FUNCTION_SUB ← prove
   r"!f g:real^N->real.
        real_polynomial_function f /\ real_polynomial_function g
        ==> real_polynomial_function (\x. f x - g x)"
   (SIMP_TAC [real_sub, REAL_POLYNOMIAL_FUNCTION_NEG,
              REAL_POLYNOMIAL_FUNCTION_ADD])

  let REAL_POLYNOMIAL_FUNCTION_SUM ← prove
   r"!f s. FINITE s /\
         (!a. a IN s ==> real_polynomial_function(\x. f x a))
         ==> real_polynomial_function (\x. sum s (f x))"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [real_polynomial_function_RULES, SUM_CLAUSES, FORALL_IN_INSERT])

  let REAL_POLYNOMIAL_FUNCTION_PRODUCT ← prove
   r"!f s. FINITE s /\
         (!a. a IN s ==> real_polynomial_function(\x. f x a))
         ==> real_polynomial_function (\x. product s (f x))"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [real_polynomial_function_RULES, PRODUCT_CLAUSES,
              FORALL_IN_INSERT])

  let REAL_POLYNOMIAL_FUNCTION_POW ← prove
   r"!p n. real_polynomial_function p
         ==> real_polynomial_function(\x. p(x) pow n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN ASM_SIMP_TAC [real_polynomial_function_RULES, real_pow])

  let (POLYNOMIAL_FUNCTION_LIFT, POLYNOMIAL_FUNCTION_DROP) ← CONJ_PAIR (← prove
   r"(!p. polynomial_function (p o lift) <=> real_polynomial_function p) /\
   (!p. real_polynomial_function(p o drop) <=> polynomial_function p)"
   (SUBGOAL_THEN
     (← q r"!p. polynomial_function p ==> real_polynomial_function(p o drop)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC POLYNOMIAL_FUNCTION_INDUCT THEN
      SIMP_TAC [o_DEF, real_polynomial_function_RULES, drop, DIMINDEX_1, LE_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!p. real_polynomial_function p ==> polynomial_function(p o lift)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC real_polynomial_function_INDUCT THEN
      SIMP_TAC [o_DEF, POLYNOMIAL_FUNCTION_ADD, DIMINDEX_1, FORALL_1] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP, POLYNOMIAL_FUNCTION_ID] THEN
      SIMP_TAC [POLYNOMIAL_FUNCTION_MUL, POLYNOMIAL_FUNCTION_CONST],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]))

  let (REAL_POLYNOMIAL_FUNCTION_EXPLICIT,
       REAL_POLYNOMIAL_FUNCTION_EXPLICIT_NZ,
       REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV) ← (do
    let (lemma1, lemma2) ← CONJ_PAIR (← prove
     r"(!f:real^N->real.
          (?a:num^N->real.
            FINITE {k | ~(a k = &0)} /\
            f = \x. sum (:num^N)
                     (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))) <=>
          (?(s:num^N->bool) a.
              FINITE s /\
              f = \x. sum s
                    (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i)))) /\
       (!f:real^N->real.
          (?a:num^N->real.
            FINITE {k | ~(a k = &0)} /\
            f = \x. sum (:num^N)
                     (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))) <=>
          (?(s:num^N->bool) a.
              FINITE s /\ (!k. k IN s ==> ~(a k = &0)) /\
              f = \x. sum s
                      (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))))"
     (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT
       (← q r"(r ==> q) /\ (p ==> r) /\ (q ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
      REPEAT CONJ_TAC THENL
       [MESON_TAC [],
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"a:num^N->real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"{k:num^N | ~(a k = &0)}") THEN
        ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        ABS_TAC THEN MATCH_MP_TAC SUM_SUPERSET THEN
        SIMP_TAC [SUBSET_UNIV, IN_ELIM_THM, IN_UNIV, REAL_MUL_LZERO],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"s:num^N->bool", ← q r"a:num^N->real"] THEN
        STRIP_TAC THEN
        EXISTS_TAC (← q r"\k. if k IN s then (a:num^N->real) k else &0") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            FINITE_SUBSET)) THEN
          SET_TAC [],
          ABS_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_EQ_SUPERSET THEN
          ASM_SIMP_TAC [SUBSET_UNIV, REAL_MUL_LZERO]]]))
    let REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV ← prove
     r"!f:real^N->real.
            real_polynomial_function f <=>
            ?a:num^N->real.
              FINITE {k | ~(a k = &0)} /\
              f = \x. sum (:num^N)
                       (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))"
     (REWRITE_TAC [← TAUT (← q r"(p <=> q) <=> (q ==> p) /\ (p ==> q)"),
                   FORALL_AND_THM] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN REWRITE_TAC [lemma1] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"s:num^N->bool", ← q r"a:num^N->real"] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_SUM THEN
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_MUL THEN
        REWRITE_TAC [real_polynomial_function_RULES] THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_PRODUCT THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_POW THEN
        ASM_SIMP_TAC [real_polynomial_function_RULES],
        ALL_TAC] THEN
      MATCH_MP_TAC real_polynomial_function_INDUCT THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN REWRITE_TAC [lemma1] THEN
        EXISTS_TAC (← q r"{(lambda i. if i = j then 1 else 0):num^N}") THEN
        EXISTS_TAC (← q r"\k:num^N. &1") THEN
        REWRITE_TAC [FINITE_SING, SUM_SING, REAL_MUL_LID] THEN ABS_TAC THEN
        ASM_SIMP_TAC [LAMBDA_BETA, COND_RAND, real_pow, PRODUCT_DELTA, IN_NUMSEG,
                      REAL_POW_1],
        DISCH_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"c:real") THEN REWRITE_TAC [lemma1] THEN
        EXISTS_TAC (← q r"{(lambda i. 0):num^N}") THEN
        EXISTS_TAC (← q r"(\k. c):num^N->real") THEN
        REWRITE_TAC [FINITE_SING, SUM_SING] THEN ABS_TAC THEN
        ASM_SIMP_TAC [LAMBDA_BETA, real_pow, PRODUCT_ONE, REAL_MUL_RID],
        DISCH_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2
         (X_CHOOSE_THEN (← q r"a:num^N->real") STRIP_ASSUME_TAC)
         (X_CHOOSE_THEN (← q r"b:num^N->real") STRIP_ASSUME_TAC)) THEN
        EXISTS_TAC (← q r"(\k. a k + b k):num^N->real") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_SUBSET THEN
          EXISTS_TAC (← q r"{k:num^N | ~(a k = &0)} UNION {k:num^N | ~(b k = &0)}") THEN
          ASM_REWRITE_TAC [FINITE_UNION, SUBSET, IN_UNION, IN_ELIM_THM] THEN
          REAL_ARITH_TAC,
          ASM_REWRITE_TAC [REAL_ADD_RDISTRIB] THEN ABS_TAC THEN
          CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_ADD_GEN THEN
          REWRITE_TAC [IN_UNIV, REAL_ENTIRE, DE_MORGAN_THM] THEN
          CONJ_TAC THEN MATCH_MP_TAC (← MESON [FINITE_SUBSET]
           (← q r"FINITE {k | P k} /\ {k | P k /\ Q k} SUBSET {k | P k}
            ==> FINITE {k | P k /\ Q k}")) THEN
          ASM_REWRITE_TAC [] THEN SET_TAC []],
        DISCH_TAC] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [lemma1] THEN DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"s:num^N->bool") (X_CHOOSE_THEN (← q r"a:num^N->real")
            STRIP_ASSUME_TAC))
       (X_CHOOSE_THEN (← q r"t:num^N->bool") (X_CHOOSE_THEN (← q r"b:num^N->real")
            STRIP_ASSUME_TAC))) THEN
      ASM_REWRITE_TAC [← GSYM SUM_RMUL] THEN ASM_REWRITE_TAC [← GSYM SUM_LMUL] THEN
      ASM_SIMP_TAC [SUM_SUM_PRODUCT] THEN
      MP_TAC (← GEN (← q r"g:num^N#num^N->real") (← ISPECL
       [← q r"(\(k,l). lambda i. k$i + l$i):num^N#num^N->num^N",
        ← q r"g:num^N#num^N->real", ← q r"{k,l | (k:num^N) IN s /\ (l:num^N) IN t}",
        ← q r"(:num^N)"] SUM_GROUP)) THEN
      ASM_SIMP_TAC [FINITE_PRODUCT, SUBSET_UNIV, ← GSYM lemma1] THEN
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      EXISTS_TAC (← q r"\m:num^N. sum {(k:num^N,l:num^N) | k IN s /\ l IN t /\
                                                     (lambda i. k$i + l$i) = m}
                                (\(k,l). (a:num^N->real) k * b l)") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE ((\(k,l). lambda i. k$i + l$i):num^N#num^N->num^N)
                          {k,l | k IN s /\ l IN t}") THEN
        ASM_SIMP_TAC [FINITE_PRODUCT, FINITE_IMAGE] THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        REWRITE_TAC [CONTRAPOS_THM, ← SET_RULE
         (← q r"x IN IMAGE f s <=> ~({y | y IN s /\ f y = x} = {})")] THEN
        GEN_TAC THEN DISCH_THEN (fun th => tactic_of do
         pure (MATCH_MP_TAC (← MESON [SUM_CLAUSES] (← q r"s = {} ==> sum s f = &0")) THEN
               GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
        REWRITE_TAC [EXTENSION, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_ELIM_PAIR_THM, ← GSYM CONJ_ASSOC],
        ABS_TAC THEN MATCH_MP_TAC SUM_EQ THEN X_GEN_TAC (← q r"m:num^N") THEN
        REWRITE_TAC [IN_UNIV, ← GSYM SUM_RMUL] THEN
        MATCH_MP_TAC (← MESON [SUM_EQ]
         (← q r"s = t /\ (!x. x IN t ==> f x = g x) ==> sum s f = sum t g")) THEN
        REWRITE_TAC [FORALL_IN_GSPEC, EXTENSION, FORALL_PAIR_THM,
                     IN_ELIM_PAIR_THM, IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN
        REPEAT GEN_TAC THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
        MATCH_MP_TAC (← REAL_RING
         (← q r"p1 * p2:real = p ==> (a * p1) * (b * p2) = (a * b) * p")) THEN
        ASM_SIMP_TAC [← GSYM PRODUCT_MUL_NUMSEG, LAMBDA_BETA, REAL_POW_ADD]])
    let REAL_POLYNOMIAL_FUNCTION_EXPLICIT ← prove
     r"!f:real^N->real.
          real_polynomial_function f <=>
          ?(s:num^N->bool) a.
            FINITE s /\
            f = \x. sum s
                     (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))"
     (REWRITE_TAC [← GSYM lemma1] THEN
      REWRITE_TAC [REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV])
    let REAL_POLYNOMIAL_FUNCTION_EXPLICIT_NZ ← prove
     r"!f:real^N->real.
          real_polynomial_function f <=>
          ?(s:num^N->bool) a.
              FINITE s /\ (!k. k IN s ==> ~(a k = &0)) /\
              f = \x. sum s
                      (\k. a(k) * product(1..dimindex(:N)) (\i. x$i pow k$i))"
     (REWRITE_TAC [← GSYM lemma2] THEN
      REWRITE_TAC [REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV])
    pure (REAL_POLYNOMIAL_FUNCTION_EXPLICIT,
          REAL_POLYNOMIAL_FUNCTION_EXPLICIT_NZ,
          REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV))

  let REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION ← prove
   r"!f x:real^N.
        real_polynomial_function f ==> f real_continuous at x"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC real_polynomial_function_INDUCT THEN
    SIMP_TAC [REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_MUL,
              REAL_CONTINUOUS_CONST, REAL_CONTINUOUS_AT_COMPONENT])

  let STONE_WEIERSTRASS_REAL_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^N->real s e.
        compact s /\
        (!x. x IN s ==> f real_continuous at x within s) /\
        &0 < e
        ==> ?g. real_polynomial_function g /\
                !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          STONE_WEIERSTRASS) THEN
    ASM_REWRITE_TAC [real_polynomial_function_RULES] THEN
    SIMP_TAC [REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION,
              REAL_CONTINUOUS_AT_WITHIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [CART_EQ] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN EXISTS_TAC (← q r"\x:real^N. x$i") THEN
    ASM_SIMP_TAC [real_polynomial_function_RULES])

  let REAL_STONE_WEIERSTRASS_POLYNOMIAL_FUNCTION ← prove
   r"!f s e.
        real_compact s /\ f real_continuous_on s /\ &0 < e
        ==> ?g. polynomial_function g /\
                !x. x IN s ==> abs(f x - g x) < e"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
     REAL_STONE_WEIERSTRASS) THEN
    ASM_REWRITE_TAC [REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION] THEN
    REWRITE_TAC [POLYNOMIAL_FUNCTION_CONST, POLYNOMIAL_FUNCTION_ADD] THEN
    REWRITE_TAC [POLYNOMIAL_FUNCTION_MUL] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x:real. x") THEN ASM_REWRITE_TAC [POLYNOMIAL_FUNCTION_ID])

  pure { real_polynomial_function_RULES, real_polynomial_function_INDUCT,
         real_polynomial_function_CASES, REAL_POLYNOMIAL_FUNCTION_ADD,
         REAL_POLYNOMIAL_FUNCTION_MUL, REAL_POLYNOMIAL_FUNCTION_NEG,
         REAL_POLYNOMIAL_FUNCTION_SUB, REAL_POLYNOMIAL_FUNCTION_SUM,
         REAL_POLYNOMIAL_FUNCTION_PRODUCT, REAL_POLYNOMIAL_FUNCTION_POW,
         POLYNOMIAL_FUNCTION_LIFT, POLYNOMIAL_FUNCTION_DROP,
         REAL_POLYNOMIAL_FUNCTION_EXPLICIT, REAL_POLYNOMIAL_FUNCTION_EXPLICIT_NZ,
         REAL_POLYNOMIAL_FUNCTION_EXPLICIT_UNIV,
         REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION,
         STONE_WEIERSTRASS_REAL_POLYNOMIAL_FUNCTION,
         REAL_STONE_WEIERSTRASS_POLYNOMIAL_FUNCTION }

/- ------------------------------------------------------------------------- -/
/- Stone-Weierstrass for real^M->real^N polynomials: vector polynomials.     -/
/- (realanalysis.ml 14005-14193)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBJ where
  vector_polynomial_function : thm
  REAL_POLYNOMIAL_FUNCTION_DROP : thm
  VECTOR_POLYNOMIAL_FUNCTION_LIFT : thm
  VECTOR_POLYNOMIAL_FUNCTION_CONST : thm
  VECTOR_POLYNOMIAL_FUNCTION_ID : thm
  VECTOR_POLYNOMIAL_FUNCTION_COMPONENT : thm
  VECTOR_POLYNOMIAL_FUNCTION_ADD : thm
  VECTOR_POLYNOMIAL_FUNCTION_MUL : thm
  VECTOR_POLYNOMIAL_FUNCTION_CMUL : thm
  VECTOR_POLYNOMIAL_FUNCTION_NEG : thm
  VECTOR_POLYNOMIAL_FUNCTION_SUB : thm
  VECTOR_POLYNOMIAL_FUNCTION_VSUM : thm
  REAL_VECTOR_POLYNOMIAL_FUNCTION_o : thm
  VECTOR_POLYNOMIAL_FUNCTION_o : thm
  VECTOR_POLYNOMIAL_FUNCTION_REFLECT : thm
  REAL_POLYNOMIAL_FUNCTION_1 : thm
  CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION : thm
  CONTINUOUS_ON_VECTOR_POLYNOMIAL_FUNCTION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBJ [HolBase] (D : RealAnalysisDeps) (BRZK : RZK) (BRZBI : RZBI) : ExceptT String IO RZBJ := do
  -- @@SCOPE BEGIN
  let { CONTINUOUS_COMPONENTWISE, .. } := BRZK
  let { REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION, real_polynomial_function_INDUCT,
        real_polynomial_function_RULES, .. } := BRZBI
  let { LE_ADD2, .. } := D.qsession
  let { SUM_EQ_NUMSEG, SUM_SING_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { ARITH_TAC, INDUCT_TAC, MESON, new_definition, REAL_ARITH_TAC, VECTOR_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { LE_0, REAL_POW_ADD, .. } := D.ts.cn.cx.cpx
  let { FINITE_PRODUCT, SUM_GROUP, SUM_SUM_PRODUCT, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, ARITH_EQ, COND_RAND, COND_RATOR, DIMINDEX_1, ETA_AX, EXTENSION,
        FINITE_INDUCT_STRONG, FINITE_NUMSEG, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IN_ELIM_PAIR_THM,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, LEFT_IMP_EXISTS_THM, REAL_ADD_RDISTRIB,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_MUL_LZERO, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_pow, SUM_ADD_NUMSEG, SUM_CLAUSES_LEFT, SUM_EQ, SUM_LMUL,
        SUM_RESTRICT_SET, SUM_RMUL, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_1, LIFT_CMUL, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_NEG_NEG, VECTOR_SUB,
        VSUM_CLAUSES, .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.ts.cn.cx.cvx.top2
  let { LIFT_SUM, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let vector_polynomial_function ← new_definition
   r"vector_polynomial_function (f:real^M->real^N) <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> real_polynomial_function(\x. f(x)$i)"

  let REAL_POLYNOMIAL_FUNCTION_DROP ← prove
   r"!f. real_polynomial_function(drop o f) <=> vector_polynomial_function f"
   (REWRITE_TAC [vector_polynomial_function, DIMINDEX_1, FORALL_1] THEN
    REWRITE_TAC [o_DEF, drop])

  let VECTOR_POLYNOMIAL_FUNCTION_LIFT ← prove
   r"!f. vector_polynomial_function(lift o f) <=> real_polynomial_function f"
   (REWRITE_TAC [← GSYM REAL_POLYNOMIAL_FUNCTION_DROP, o_DEF, LIFT_DROP, ETA_AX])

  let VECTOR_POLYNOMIAL_FUNCTION_CONST ← prove
   r"!c. vector_polynomial_function(\x. c)"
   (SIMP_TAC [vector_polynomial_function, real_polynomial_function_RULES])

  let VECTOR_POLYNOMIAL_FUNCTION_ID ← prove
   r"vector_polynomial_function(\x. x)"
   (SIMP_TAC [vector_polynomial_function, real_polynomial_function_RULES])

  let VECTOR_POLYNOMIAL_FUNCTION_COMPONENT ← prove
   r"!f:real^M->real^N i.
        1 <= i /\ i <= dimindex(:N) /\ vector_polynomial_function f
        ==> vector_polynomial_function(\x. lift(f x$i))"
   (SIMP_TAC [vector_polynomial_function, FORALL_1, DIMINDEX_1, ← GSYM drop,
              LIFT_DROP])

  let VECTOR_POLYNOMIAL_FUNCTION_ADD ← prove
   r"!f g:real^M->real^N.
        vector_polynomial_function f /\ vector_polynomial_function g
        ==> vector_polynomial_function (\x. f x + g x)"
   (REWRITE_TAC [vector_polynomial_function] THEN
    SIMP_TAC [VECTOR_ADD_COMPONENT, real_polynomial_function_RULES])

  let VECTOR_POLYNOMIAL_FUNCTION_MUL ← prove
   r"!f g:real^M->real^N.
        vector_polynomial_function(lift o f) /\ vector_polynomial_function g
        ==> vector_polynomial_function (\x. f x % g x)"
   (REWRITE_TAC [vector_polynomial_function, o_DEF, VECTOR_MUL_COMPONENT] THEN
    REWRITE_TAC [FORALL_1, DIMINDEX_1, ← GSYM drop, LIFT_DROP, ETA_AX] THEN
    SIMP_TAC [real_polynomial_function_RULES])

  let VECTOR_POLYNOMIAL_FUNCTION_CMUL ← prove
   r"!f:real^M->real^N c.
        vector_polynomial_function f
        ==> vector_polynomial_function (\x. c % f x)"
   (SIMP_TAC [VECTOR_POLYNOMIAL_FUNCTION_CONST, VECTOR_POLYNOMIAL_FUNCTION_MUL,
              ETA_AX, o_DEF])

  let VECTOR_POLYNOMIAL_FUNCTION_NEG ← prove
   r"!f:real^M->real^N.
        vector_polynomial_function f
        ==> vector_polynomial_function (\x. --(f x))"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = --(&1) % x")] THEN
    REWRITE_TAC [VECTOR_POLYNOMIAL_FUNCTION_CMUL])

  let VECTOR_POLYNOMIAL_FUNCTION_SUB ← prove
   r"!f g:real^M->real^N.
        vector_polynomial_function f /\ vector_polynomial_function g
        ==> vector_polynomial_function (\x. f x - g x)"
   (SIMP_TAC [VECTOR_SUB, VECTOR_POLYNOMIAL_FUNCTION_ADD,
              VECTOR_POLYNOMIAL_FUNCTION_NEG])

  let VECTOR_POLYNOMIAL_FUNCTION_VSUM ← prove
   r"!f:real^M->A->real^N s.
        FINITE s /\ (!i. i IN s ==> vector_polynomial_function (\x. f x i))
        ==> vector_polynomial_function (\x. vsum s (f x))"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, FORALL_IN_INSERT, VECTOR_POLYNOMIAL_FUNCTION_CONST,
              VECTOR_POLYNOMIAL_FUNCTION_ADD])

  let REAL_VECTOR_POLYNOMIAL_FUNCTION_o ← prove
   r"!f:real^M->real^N g.
        vector_polynomial_function f /\ real_polynomial_function g
        ==> real_polynomial_function(g o f)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN DISCH_TAC THEN
    MATCH_MP_TAC real_polynomial_function_INDUCT THEN
    REWRITE_TAC [o_DEF, real_polynomial_function_RULES] THEN
    ASM_REWRITE_TAC [← GSYM vector_polynomial_function])

  let VECTOR_POLYNOMIAL_FUNCTION_o ← prove
   r"!f:real^M->real^N g:real^N->real^P.
        vector_polynomial_function f /\ vector_polynomial_function g
        ==> vector_polynomial_function(g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      REAL_VECTOR_POLYNOMIAL_FUNCTION_o)) THEN
    SIMP_TAC [vector_polynomial_function, o_DEF])

  let VECTOR_POLYNOMIAL_FUNCTION_REFLECT ← prove
   r"!f:real^M->real^N.
        vector_polynomial_function (\x. f(--x)) <=>
        vector_polynomial_function f"
   (GEN_TAC THEN GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"f:real^M->real^N = (f o (--)) o (--)") SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_DEF, VECTOR_NEG_NEG, ETA_AX], ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_o THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_NEG THEN
    REWRITE_TAC [VECTOR_POLYNOMIAL_FUNCTION_ID])

  let REAL_POLYNOMIAL_FUNCTION_1 ← prove
   r"!f. real_polynomial_function f <=>
       ?a n. f = \x. sum(0..n) (\i. a i * drop x pow i)"
   (REWRITE_TAC [← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC real_polynomial_function_INDUCT THEN
      REWRITE_TAC [DIMINDEX_1, FORALL_1, FUN_EQ_THM] THEN CONJ_TAC THENL
       [MAP_EVERY EXISTS_TAC [← q r"\i. if i = 1 then &1 else &0", ← q r"1"] THEN
        SIMP_TAC [SUM_CLAUSES_LEFT, LE_0, ARITH_EQ, REAL_MUL_LZERO, drop] THEN
        SIMP_TAC [ARITH, SUM_SING_NUMSEG] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"c:real") THEN
        MAP_EVERY EXISTS_TAC [← q r"(\i. c):num->real", ← q r"0"] THEN
        REWRITE_TAC [SUM_SING_NUMSEG, real_pow] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^1->real", ← q r"g:real^1->real"] THEN
      REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:num->real", ← q r"m:num"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"b:num->real", ← q r"n:num"] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THENL
       [MAP_EVERY EXISTS_TAC
         [← q r"\i:num. (if i <= m then a i else &0) + (if i <= n then b i else &0)",
          ← q r"MAX m n"] THEN
        GEN_TAC THEN REWRITE_TAC [REAL_ADD_RDISTRIB, SUM_ADD_NUMSEG] THEN
        REWRITE_TAC [COND_RAND, COND_RATOR, REAL_MUL_LZERO] THEN
        REWRITE_TAC [← GSYM SUM_RESTRICT_SET] THEN BINOP_TAC THEN
        BINOP_TAC THEN REWRITE_TAC [] THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_NUMSEG] THEN ARITH_TAC,
        REWRITE_TAC [← GSYM SUM_RMUL] THEN REWRITE_TAC [← GSYM SUM_LMUL] THEN
        SIMP_TAC [SUM_SUM_PRODUCT, FINITE_NUMSEG] THEN
        EXISTS_TAC (← q r"\k. sum {x | x IN {i,j | i IN 0..m /\ j IN 0..n} /\
                                 FST x + SND x = k}
                            (\(i,j). a i * b j)") THEN
        EXISTS_TAC (← q r"m + n:num") THEN X_GEN_TAC (← q r"x:real^1") THEN
        MP_TAC (← ISPECL
         [← q r"\(i:num,j). i + j",
          ← q r"\(i,j). (a i * drop x pow i) * (b j * drop x pow j)",
          ← q r"{i,j | i IN 0..m /\ j IN 0..n}", ← q r"0..m+n"] SUM_GROUP) THEN
        SIMP_TAC [FINITE_PRODUCT, FINITE_NUMSEG, FORALL_IN_IMAGE,
                  FORALL_IN_GSPEC, SUBSET, IN_NUMSEG, LE_0, LE_ADD2] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
        X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN REWRITE_TAC [← GSYM SUM_RMUL] THEN
        MATCH_MP_TAC (← MESON [SUM_EQ] (← q r"s = t /\ (!x. x IN t ==> f x = g x)
                                    ==> sum s f = sum t g")) THEN
        SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_GSPEC, IMP_CONJ] THEN
        SIMP_TAC [IN_ELIM_PAIR_THM, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [REAL_POW_ADD] THEN REAL_ARITH_TAC],
      REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [← GSYM VECTOR_POLYNOMIAL_FUNCTION_LIFT] THEN
      SIMP_TAC [LIFT_SUM, o_DEF, FINITE_NUMSEG, FORALL_1, DIMINDEX_1] THEN
      MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG, LIFT_CMUL] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_MUL THEN
      REWRITE_TAC [← GSYM REAL_POLYNOMIAL_FUNCTION_DROP, o_DEF, LIFT_DROP] THEN
      REWRITE_TAC [real_polynomial_function_RULES] THEN
      SPEC_TAC (← q r"i:num", ← q r"k:num") THEN REWRITE_TAC [drop] THEN
      INDUCT_TAC THEN
      ASM_SIMP_TAC [real_polynomial_function_RULES, real_pow, DIMINDEX_1,
                    ARITH]])

  let CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N x.
        vector_polynomial_function f ==> f continuous at x"
   (REWRITE_TAC [vector_polynomial_function, CONTINUOUS_COMPONENTWISE] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_CONTINUOUS_REAL_POLYMONIAL_FUNCTION THEN
    ASM_SIMP_TAC [])

  let CONTINUOUS_ON_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N s.
        vector_polynomial_function f ==> f continuous_on s"
   (SIMP_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON,
              CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION])

  pure { vector_polynomial_function, REAL_POLYNOMIAL_FUNCTION_DROP,
         VECTOR_POLYNOMIAL_FUNCTION_LIFT, VECTOR_POLYNOMIAL_FUNCTION_CONST,
         VECTOR_POLYNOMIAL_FUNCTION_ID, VECTOR_POLYNOMIAL_FUNCTION_COMPONENT,
         VECTOR_POLYNOMIAL_FUNCTION_ADD, VECTOR_POLYNOMIAL_FUNCTION_MUL,
         VECTOR_POLYNOMIAL_FUNCTION_CMUL, VECTOR_POLYNOMIAL_FUNCTION_NEG,
         VECTOR_POLYNOMIAL_FUNCTION_SUB, VECTOR_POLYNOMIAL_FUNCTION_VSUM,
         REAL_VECTOR_POLYNOMIAL_FUNCTION_o, VECTOR_POLYNOMIAL_FUNCTION_o,
         VECTOR_POLYNOMIAL_FUNCTION_REFLECT, REAL_POLYNOMIAL_FUNCTION_1,
         CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION,
         CONTINUOUS_ON_VECTOR_POLYNOMIAL_FUNCTION }

/- ------------------------------------------------------------------------- -/
/- Derivatives of polynomials; vector Stone-Weierstrass approximation.       -/
/- (realanalysis.ml 14194-14394)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBK where
  REAL_POLY_DERIVATIVE : thm
  HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION : thm
  STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION : thm
  STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_SUBSPACE : thm
  STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_AFFINE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBK [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZB : RZB) (BRZK : RZK) (BRZL : RZL) (BRZO : RZO) (BRZBI : RZBI) (BRZBJ : RZBJ) : ExceptT String IO RZBK := do
  -- @@SCOPE BEGIN
  let { REAL_TENDSTO, .. } := BRZA
  let { LIM_COMPONENTWISE, .. } := BRZB
  let { CONTINUOUS_COMPONENTWISE, .. } := BRZK
  let { HAS_REAL_VECTOR_DERIVATIVE_AT, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_CONST, HAS_REAL_DERIVATIVE_ID,
        HAS_REAL_DERIVATIVE_MUL_ATREAL, .. } := BRZO
  let { real_polynomial_function_INDUCT, real_polynomial_function_RULES,
        STONE_WEIERSTRASS_REAL_POLYNOMIAL_FUNCTION, .. } := BRZBI
  let { vector_polynomial_function, VECTOR_POLYNOMIAL_FUNCTION_ADD,
        VECTOR_POLYNOMIAL_FUNCTION_COMPONENT, VECTOR_POLYNOMIAL_FUNCTION_CONST,
        VECTOR_POLYNOMIAL_FUNCTION_MUL, VECTOR_POLYNOMIAL_FUNCTION_VSUM, .. } := BRZBJ
  let { derive_strong_induction, .. } := D
  let { NORM_VSUM_PYTHAGOREAN, ORTHONORMAL_BASIS_EXPAND, .. } := D.qvectors
  let { AFFINE_TRANSLATION_SUBSPACE, .. } := D.qconvex
  let { has_derivative_at, .. } := D.ts.cn.ms.qderivatives
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { VSUM_SUB_NUMSEG, .. } := D.ts.cn.cx.cpx
  let { has_vector_derivative, .. } := D.ts.cn.ms.ig.qderivatives
  let { PAIRWISE_IMAGE, SUM_LE_INCLUDED, .. } := D.ts.cn.ms.ig.qsession
  let { CARD_NUMSEG_1, DIMINDEX_1, DIMINDEX_GE_1, ETA_AX, FINITE_INDEX_NUMSEG,
        FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, HAS_SIZE_IMAGE_INJ_EQ, IMAGE_EQ_EMPTY, IMAGE_ID,
        IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INJECTIVE_ON_ALT,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_NUMSEG, LAMBDA_BETA, LE_1, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, NOT_LT,
        NUMSEG_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_POW_2, REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_DIV,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_OF_NUM_LT, REAL_POW2_ABS, REAL_POW_2, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_EMPTY, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, pairwise, SUM_BOUND_LT_GEN, UNWIND_THM2, .. } := D.ts.cn.cx.cvx.core6
  let { DIM_SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.vec1
  let { DOT_SYM, DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, FORALL_1, FORALL_DROP, LIFT_DROP,
        NORM_LE, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LE_L1, NORM_MUL, NORM_POW_2, ORTHOGONAL_MUL, ORTHONORMAL_BASIS_SUBSPACE,
        SUBSPACE_MUL, SUBSPACE_VSUM, VECTOR_ADD_AC, .. } := D.ts.cn.cx.cvx.vec3
  let { dot, drop, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_ADD_SUB,
        VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, VECTOR_SUB_RDISTRIB, VSUM_IMAGE,
        .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUB,
        .. } := D.ts.cn.cx.cvx.top3
  let { LINEAR_VMUL_DROP, .. } := D.ts.cn.ms.ig.dv.qvec
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_LIFT_DOT2,
        .. } := D.ts.cn.ms.ig.dv.dg.qtopology1
  let { LINEAR_ID, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let REAL_POLY_DERIVATIVE ← prove
   r"!p:real^1->real.
        real_polynomial_function p
        ==> ?p'. real_polynomial_function p' /\
                 !x. ((p o lift) has_real_derivative (p'(lift x))) (atreal x)"
   (MATCH_MP_TAC
     (← derive_strong_induction real_polynomial_function_RULES
                                real_polynomial_function_INDUCT) THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, o_DEF, ← GSYM drop, LIFT_DROP] THEN
    CONJ_TAC THENL
     [EXISTS_TAC (← q r"\x:real^1. &1") THEN
      REWRITE_TAC [real_polynomial_function_RULES, HAS_REAL_DERIVATIVE_ID],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"c:real") THEN EXISTS_TAC (← q r"\x:real^1. &0") THEN
      REWRITE_TAC [real_polynomial_function_RULES, HAS_REAL_DERIVATIVE_CONST],
      ALL_TAC] THEN
    CONJ_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^1->real", ← q r"g:real^1->real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"f':real^1->real") STRIP_ASSUME_TAC))
     (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"g':real^1->real") STRIP_ASSUME_TAC)))
    THENL
     [EXISTS_TAC (← q r"\x. (f':real^1->real) x + g' x"),
      EXISTS_TAC (← q r"\x. (f:real^1->real) x * g' x + f' x * g x")] THEN
    ASM_SIMP_TAC [real_polynomial_function_RULES, HAS_REAL_DERIVATIVE_ADD,
                  HAS_REAL_DERIVATIVE_MUL_ATREAL])

  let HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!p:real^1->real^N.
        vector_polynomial_function p
        ==> ?p'. vector_polynomial_function p' /\
                 !x. (p has_vector_derivative p'(x)) (at x)"
   (GEN_TAC THEN REWRITE_TAC [vector_polynomial_function] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?q. real_polynomial_function q /\
                  (!x. ((\x. lift(((p x):real^N)$i)) has_vector_derivative
                        lift(q x)) (at x))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP REAL_POLY_DERIVATIVE) THEN
      REWRITE_TAC [HAS_REAL_VECTOR_DERIVATIVE_AT] THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, FORALL_DROP],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"q:num->real^1->real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(\x. lambda i. (q:num->real^1->real) i x):real^1->real^N") THEN
      ASM_SIMP_TAC [LAMBDA_BETA, ETA_AX] THEN
      REWRITE_TAC [has_vector_derivative, has_derivative_at] THEN
      ONCE_REWRITE_TAC [LIM_COMPONENTWISE] THEN X_GEN_TAC (← q r"x:real^1") THEN
      SIMP_TAC [LINEAR_VMUL_DROP, LINEAR_ID] THEN X_GEN_TAC (← q r"i:num") THEN
      STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
      REWRITE_TAC [has_vector_derivative, has_derivative_at] THEN
      ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, VEC_COMPONENT, VECTOR_SUB_COMPONENT,
                    VECTOR_ADD_COMPONENT, LAMBDA_BETA, REAL_TENDSTO] THEN
      SIMP_TAC [DROP_ADD, DROP_VEC, LIFT_DROP, DROP_CMUL, DROP_SUB, o_DEF]])

  let STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N s e.
        compact s /\ f continuous_on s /\ &0 < e
        ==> ?g. vector_polynomial_function g /\
                !x. x IN s ==> norm(f x - g x) < e"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
    REWRITE_TAC [CONTINUOUS_COMPONENTWISE] THEN
    REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?g. real_polynomial_function g /\
                  !x. x IN s ==> abs((f:real^M->real^N) x$i - g x) <
                                 e / &(dimindex(:N))")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC STONE_WEIERSTRASS_REAL_POLYNOMIAL_FUNCTION THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, DIMINDEX_GE_1, LE_1],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
       [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g:num->real^M->real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(\x. lambda i. g i x):real^M->real^N") THEN
      ASM_SIMP_TAC [vector_polynomial_function, LAMBDA_BETA, ETA_AX] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
      MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
      REWRITE_TAC [FINITE_NUMSEG, CARD_NUMSEG_1, NUMSEG_EMPTY, NOT_LT] THEN
      ASM_SIMP_TAC [IN_NUMSEG, DIMINDEX_GE_1, LAMBDA_BETA,
                    VECTOR_SUB_COMPONENT]])

  let STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_SUBSPACE ← prove
   r"!f:real^M->real^N s e t.
        compact s /\ f continuous_on s /\ &0 < e /\
        subspace t /\ IMAGE f s SUBSET t
        ==> ?g. vector_polynomial_function g /\ IMAGE g s SUBSET t /\
                !x. x IN s ==> norm(f x - g x) < e"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHONORMAL_BASIS_SUBSPACE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"bas:real^N->bool") MP_TAC) THEN
    ASM_CASES_TAC (← q r"FINITE(bas:real^N->bool)") THENL
     [ALL_TAC, ASM_MESON_TAC [HAS_SIZE]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FINITE_INDEX_NUMSEG]) THEN
    ABBREV_TAC (← q r"n = CARD(bas:real^N->bool)") THEN
    REWRITE_TAC [INJECTIVE_ON_ALT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:num->real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
    ASM_SIMP_TAC [← REWRITE_RULE [INJECTIVE_ON_ALT] HAS_SIZE_IMAGE_INJ_EQ] THEN
    REWRITE_TAC [HAS_SIZE, FINITE_NUMSEG, CARD_NUMSEG_1] THEN
    ASM_CASES_TAC (← q r"dim(t:real^N->bool) = n") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") DIM_SUBSET_UNIV) THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN MP_TAC (← ISPECL
     [← q r"(\x. lambda i. (f x:real^N) dot (b i)):real^M->real^N",
      ← q r"s:real^M->bool", ← q r"e:real"]
     STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
      SIMP_TAC [LAMBDA_BETA] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_DOT2 THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_CONST],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"(\x. vsum(1..n) (\i. (g x:real^N)$i % b i)):real^M->real^N") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_MUL THEN
      REWRITE_TAC [VECTOR_POLYNOMIAL_FUNCTION_CONST, o_DEF] THEN
      MATCH_MP_TAC VECTOR_POLYNOMIAL_FUNCTION_COMPONENT THEN
      ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSPACE_VSUM THEN
      ASM_SIMP_TAC [SUBSPACE_MUL, FINITE_NUMSEG],
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [DOT_SYM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
      SUBGOAL_THEN
       (← q r"vsum(IMAGE b (1..n)) (\v. (v dot f x) % v) = (f:real^M->real^N) x")
       (fun th => tactic_of do
          pure (GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← SYM th]))
      THENL
       [MATCH_MP_TAC ORTHONORMAL_BASIS_EXPAND THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN ASM SET_TAC [],
        ASM_SIMP_TAC [← REWRITE_RULE [INJECTIVE_ON_ALT] VSUM_IMAGE,
                      FINITE_NUMSEG] THEN
        REWRITE_TAC [← GSYM VSUM_SUB_NUMSEG, o_DEF, ← GSYM VECTOR_SUB_RDISTRIB] THEN
        REWRITE_TAC [NORM_LE, ← GSYM NORM_POW_2] THEN
        W (MP_TAC o PART_MATCH (lhs o rand) NORM_VSUM_PYTHAGOREAN o
          lhand o snd) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [PAIRWISE_IMAGE]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
        ASM_SIMP_TAC [pairwise, ORTHOGONAL_MUL, FINITE_NUMSEG] THEN
        DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [NORM_MUL] THEN
        REWRITE_TAC [NORM_POW_2] THEN GEN_REWRITE_TAC RAND_CONV [dot] THEN
        SIMP_TAC [← GSYM REAL_POW_2, VECTOR_SUB_COMPONENT, LAMBDA_BETA] THEN
        MATCH_MP_TAC SUM_LE_INCLUDED THEN EXISTS_TAC (← q r"\n:num. n") THEN
        REWRITE_TAC [FINITE_NUMSEG, REAL_LE_POW_2] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
        REWRITE_TAC [UNWIND_THM2] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> p ==> q /\ (q ==> r)")] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_NUMSEG]) THEN
        ASM_SIMP_TAC [LAMBDA_BETA, UNWIND_THM2, IN_NUMSEG] THEN
        REWRITE_TAC [REAL_MUL_RID, REAL_POW2_ABS, REAL_LE_REFL] THEN
        ASM_ARITH_TAC]])

  let STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_AFFINE ← prove
   r"!f:real^M->real^N s e t.
        compact s /\ f continuous_on s /\ &0 < e /\
        affine t /\ IMAGE f s SUBSET t
        ==> ?g. vector_polynomial_function g /\ IMAGE g s SUBSET t /\
                !x. x IN s ==> norm(f x - g x) < e"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY] THENL
     [MESON_TAC [VECTOR_POLYNOMIAL_FUNCTION_CONST, NOT_IN_EMPTY],
      STRIP_TAC] THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") AFFINE_TRANSLATION_SUBSPACE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"u:real^N->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(\x. f x - a):real^M->real^N", ← q r"s:real^M->bool", ← q r"e:real",
      ← q r"u:real^N->bool"] STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_SUBSPACE) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST] THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:real^N. x - a") o MATCH_MP IMAGE_SUBSET) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_ADD_SUB, IMAGE_ID] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(\x. g x + a):real^M->real^N") THEN
    ASM_SIMP_TAC [VECTOR_POLYNOMIAL_FUNCTION_ADD,
                  VECTOR_POLYNOMIAL_FUNCTION_CONST,
                  ← VECTOR_ARITH (← q r"a - (b + c):real^N = a - c - b")] THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:real^N. a + x") o MATCH_MP IMAGE_SUBSET) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_ADD_AC])

  pure { REAL_POLY_DERIVATIVE, HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION,
         STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION,
         STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_SUBSPACE,
         STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION_AFFINE }

/- ------------------------------------------------------------------------- -/
/- Polynomial paths; Lipschitz property and differentiability of real and    -/
/- vector polynomials.                                                       -/
/- (realanalysis.ml 14395-14615)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBL where
  PATH_VECTOR_POLYNOMIAL_FUNCTION : thm
  RECTIFIABLE_PATH_VECTOR_POLYNOMIAL_FUNCTION : thm
  PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION : thm
  CONNECTED_OPEN_VECTOR_POLYNOMIAL_CONNECTED : thm
  LIPSCHITZ_REAL_POLYNOMIAL_FUNCTION : thm
  LIPSCHITZ_VECTOR_POLYNOMIAL_FUNCTION : thm
  DIFFERENTIABLE_REAL_POLYNOMIAL_FUNCTION_AT : thm
  DIFFERENTIABLE_ON_REAL_POLYNOMIAL_FUNCTION : thm
  DIFFERENTIABLE_VECTOR_POLYNOMIAL_FUNCTION : thm
  DIFFERENTIABLE_ON_VECTOR_POLYNOMIAL_FUNCTION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBL [HolBase] (D : RealAnalysisDeps) (BRZBI : RZBI) (BRZBJ : RZBJ) (BRZBK : RZBK) : ExceptT String IO RZBL := do
  -- @@SCOPE BEGIN
  let { real_polynomial_function_INDUCT, real_polynomial_function_RULES, .. } := BRZBI
  let { CONTINUOUS_ON_VECTOR_POLYNOMIAL_FUNCTION, vector_polynomial_function, .. } := BRZBJ
  let { STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION, .. } := BRZBK
  let { DIFFERENTIABLE_ADD, DIFFERENTIABLE_CONST, DIFFERENTIABLE_LIFT_COMPONENT,
        DIFFERENTIABLE_MUL_AT, .. } := D.qderivatives
  let { HAS_BOUNDED_VARIATION_ON_CONST, .. } := D.qintegration
  let { DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON, .. } := D.ts.qderivatives
  let { HAS_BOUNDED_VARIATION_ON_ADD, HAS_BOUNDED_VARIATION_ON_MUL,
        .. } := D.ts.cn.qintegration
  let { DIFFERENTIABLE_COMPONENTWISE_AT, .. } := D.ts.cn.ms.qderivatives
  let { HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, HAS_BOUNDED_VARIATION_ON_ID,
        .. } := D.ts.cn.ms.qintegration2
  let { rectifiable_path, .. } := D.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_RULE,
        SET_TAC, VECTOR_ARITH_TAC, .. } := D.ts.cn.cx.cvx
  let { ARITH, CONJ_ASSOC, DIMINDEX_1, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_MUL,
        REAL_ABS_NUM, REAL_ABS_POS, REAL_ADD_RDISTRIB, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL_EQ, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_ADD, REAL_LT_IMP_LE, REAL_LT_MUL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, REAL_POS, REAL_SUB_REFL, SUBSET,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUBSET_UNIV, SUM_LE_NUMSEG, SUM_RMUL, SWAP_FORALL_THM,
        .. } := D.ts.cn.cx.cvx.core6
  let { LAMBDA_SKOLEM, .. } := D.ts.cn.cx.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_CMUL, DROP_VEC, FORALL_1, LIFT_ADD, LIFT_CMUL, LIFT_DROP,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LE_L1, NORM_MUL, NORM_POS_LE, NORM_SUB, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, drop, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_LDISTRIB, .. } := D.ts.cn.cx.cvx.vec4
  let { BOUNDED_POS, .. } := D.ts.cn.cx.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.ts.cn.cx.cvx.top2
  let { IN_BALL, IN_INTERVAL_1, IS_INTERVAL_INTERVAL, .. } := D.ts.cn.cx.cvx.top4
  let { SETDIST_LE_DIST, SETDIST_POS_LE, .. } := D.ts.cn.cx.cvx.top5
  let { CONNECTED_OPEN_PATH_CONNECTED, path_connected, .. } := D.ts.cn.ms.ig.dv.qpaths
  let { COMPACT_PATH_IMAGE, .. } := D.ts.cn.ms.ig.dv.dg.qpaths1
  let { path, path_image, PATH_IMAGE_NONEMPTY, pathfinish, pathstart,
        .. } := D.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUM_POS_LE_NUMSEG, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { OPEN_CLOSED, SETDIST_EQ_0_COMPACT_CLOSED, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { BOUNDED_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  -- One application is to pick a smooth approximation to a path, or just pick
  -- a smooth path anyway in an open connected set.

  let PATH_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!g:real^1->real^N. vector_polynomial_function g ==> path g"
   (SIMP_TAC [path, CONTINUOUS_ON_VECTOR_POLYNOMIAL_FUNCTION])

  let RECTIFIABLE_PATH_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!p:real^1->real^N. vector_polynomial_function p ==> rectifiable_path p"
   (SIMP_TAC [rectifiable_path, PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
    REWRITE_TAC [vector_polynomial_function] THEN
    ONCE_REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE] THEN
    GEN_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th THEN ASM_REWRITE_TAC []) THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    SPEC_TAC (← q r"\x. (p:real^1->real^N) x$i", ← q r"p:real^1->real") THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    MATCH_MP_TAC real_polynomial_function_INDUCT THEN
    REWRITE_TAC [o_DEF, DIMINDEX_1, FORALL_1, LIFT_ADD] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_CONST, ← GSYM drop, LIFT_DROP] THEN
    SIMP_TAC [HAS_BOUNDED_VARIATION_ON_ID, BOUNDED_INTERVAL] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_ADD] THEN
    REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← ONCE_REWRITE_RULE [CONJ_ASSOC] HAS_BOUNDED_VARIATION_ON_MUL))) THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_DROP, DROP_CMUL])

  let PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!g:real^1->real^N e.
        path g /\ &0 < e
        ==> ?p. vector_polynomial_function p /\
                pathstart p = pathstart g /\
                pathfinish p = pathfinish g /\
                !t. t IN interval[vec 0,vec 1] ==> norm(p t - g t) < e"
   (REWRITE_TAC [path] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"interval[vec 0:real^1,vec 1]",
                      ← q r"e / &4"]
          STONE_WEIERSTRASS_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_REWRITE_TAC [COMPACT_INTERVAL, ← REAL_ARITH (← q r"&0 < x / &4 <=> &0 < x")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\t. (q:real^1->real^N)(t) + (g(vec 0:real^1) - q(vec 0)) +
                  drop t % ((g(vec 1) - q(vec 1)) - (g(vec 0) - q(vec 0)))") THEN
    REWRITE_TAC [pathstart, pathfinish, DROP_VEC] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [vector_polynomial_function, VECTOR_ADD_COMPONENT,
                VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT] THEN
      REPEAT STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [vector_polynomial_function]) THEN
      MATCH_MP_TAC (← liftExcept (el 2 (CONJUNCTS real_polynomial_function_RULES))) THEN
      ASM_SIMP_TAC [real_polynomial_function_RULES, drop, DIMINDEX_1, ARITH],
      VECTOR_ARITH_TAC,
      VECTOR_ARITH_TAC,
      REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [VECTOR_SUB_LDISTRIB] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x - a) < e / &4 /\ norm b < e / &4 /\ norm c <= &1 * e / &4 /\
          norm d <= &1 * e / &4
        ==> norm((a + b + c - d) - x:real^N) < e")) THEN
      ASM_SIMP_TAC [NORM_MUL, IN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, IN_INTERVAL_1, DROP_VEC, REAL_POS,
                    REAL_LE_REFL, NORM_POS_LE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_REAL_ARITH_TAC])

  let CONNECTED_OPEN_VECTOR_POLYNOMIAL_CONNECTED ← prove
   r"!s:real^N->bool.
        open s /\ connected s
        ==> !x y. x IN s /\ y IN s
                  ==> ?g. vector_polynomial_function g /\
                          path_image g SUBSET s /\
                          pathstart g = x /\
                          pathfinish g = y"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"path_connected(s:real^N->bool)") MP_TAC THENL
     [ASM_SIMP_TAC [CONNECTED_OPEN_PATH_CONNECTED],
      REWRITE_TAC [path_connected]] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?e. &0 < e /\ !x. x IN path_image p ==> ball(x:real^N,e) SUBSET s")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"s = (:real^N)") THEN ASM_REWRITE_TAC [SUBSET_UNIV] THENL
       [MESON_TAC [REAL_LT_01], ALL_TAC] THEN
      EXISTS_TAC (← q r"setdist(path_image p,(:real^N) DIFF s)") THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
        ASM_SIMP_TAC [SETDIST_POS_LE, SETDIST_EQ_0_COMPACT_CLOSED,
                      COMPACT_PATH_IMAGE, ← GSYM OPEN_CLOSED] THEN
        ASM_SIMP_TAC [PATH_IMAGE_NONEMPTY] THEN ASM SET_TAC [],
        X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN REWRITE_TAC [SUBSET] THEN
        X_GEN_TAC (← q r"w:real^N") THEN REWRITE_TAC [IN_BALL, ← GSYM REAL_NOT_LE] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(w IN (UNIV DIFF s) ==> p) ==> (~p ==> w IN s)")) THEN
        ASM_SIMP_TAC [SETDIST_LE_DIST]],
      MP_TAC (← ISPECL [← q r"p:real^1->real^N", ← q r"e:real"]
        PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"q:real^1->real^N") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [path_image, FORALL_IN_IMAGE, SUBSET] THEN RULE_ASSUM_TAC
       (REWRITE_RULE [SUBSET, path_image, FORALL_IN_IMAGE, IN_BALL, dist]) THEN
      ASM_MESON_TAC [NORM_SUB]])

  -- Lipschitz property for real and vector polynomials.

  let LIPSCHITZ_REAL_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^N->real s.
        real_polynomial_function f /\ bounded s
        ==> ?B. &0 < B /\
                !x y. x IN s /\ y IN s ==> abs(f x - f y) <= B * norm(x - y)"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    ASM_CASES_TAC (← q r"bounded(s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN MESON_TAC [REAL_LT_01], ALL_TAC] THEN
    MATCH_MP_TAC real_polynomial_function_INDUCT THEN REPEAT CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
      ASM_SIMP_TAC [REAL_MUL_LID, ← GSYM VECTOR_SUB_COMPONENT, COMPONENT_LE_NORM],
      GEN_TAC THEN EXISTS_TAC (← q r"&1") THEN
      SIMP_TAC [REAL_LT_01, REAL_SUB_REFL, REAL_ABS_NUM, REAL_MUL_LID,
                NORM_POS_LE],
      ALL_TAC, ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^N->real", ← q r"g:real^N->real"] THEN
    DISCH_THEN (CONJUNCTS_THEN2
      (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC)
      (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC))
    THENL
     [EXISTS_TAC (← q r"B1 + B2:real") THEN ASM_SIMP_TAC [REAL_LT_ADD] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(f - f') <= B1 * n /\ abs(g - g') <= B2 * n
        ==> abs((f + g) - (f' + g')) <= (B1 + B2) * n")) THEN
      ASM_SIMP_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"B1 * (abs(g(a:real^N)) + B2 * &2 * B) +
                  B2 * (abs(f a) + B1 * &2 * B)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LT_ADD THEN CONJ_TAC THEN MATCH_MP_TAC REAL_LT_MUL THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 < x ==> &0 < abs a + x")) THEN
        MATCH_MP_TAC REAL_LT_MUL THEN ASM_REAL_ARITH_TAC,
        REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs((f - f') * g) <= a * n /\ abs((g - g') * f') <= b * n
          ==> abs(f * g - f' * g') <= (a + b) * n")) THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(a * b) * c:real = (a * c) * b")] THEN
        REWRITE_TAC [REAL_ABS_MUL] THEN
        CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [REAL_ABS_POS] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(g x - g a) <= C * norm(x - a) /\
          C * norm(x - a:real^N) <= C * B ==> abs(g x) <= abs(g a) + C * B")) THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm x <= B /\ norm a <= B ==> norm(x - a:real^N) <= &2 * B")) THEN
        ASM_SIMP_TAC []]])

  let LIPSCHITZ_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N s.
        vector_polynomial_function f /\ bounded s
        ==> ?B. &0 < B /\
                !x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y)"
   (REWRITE_TAC [vector_polynomial_function] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?b. !i. 1 <= i /\ i <= dimindex(:N)
              ==> &0 < (b:real^N)$i /\
                  !x y. x IN s /\ y IN s
                        ==> abs((f:real^M->real^N) x$i - f y$i) <=
                            b$i * norm(x - y)")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM LAMBDA_SKOLEM] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC LIPSCHITZ_REAL_POLYNOMIAL_FUNCTION THEN
      ASM_SIMP_TAC [LIPSCHITZ_REAL_POLYNOMIAL_FUNCTION],
      EXISTS_TAC (← q r"&1 + sum(1..dimindex(:N)) (\i. (b:real^N)$i)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 + x")) THEN
        MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
        REPEAT STRIP_TAC THEN
        W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        REWRITE_TAC [REAL_ADD_RDISTRIB, ← GSYM SUM_RMUL, REAL_MUL_LID] THEN
        MATCH_MP_TAC (← NORM_ARITH (← q r"x <= y ==> x <= norm(a:real^N) + y")) THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN
        ASM_SIMP_TAC [VECTOR_SUB_COMPONENT]]])

  -- Differentiability of real and vector polynomial functions.

  let DIFFERENTIABLE_REAL_POLYNOMIAL_FUNCTION_AT ← prove
   r"!f:real^N->real a.
        real_polynomial_function f ==> (lift o f) differentiable (at a)"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC real_polynomial_function_INDUCT THEN
    REWRITE_TAC [o_DEF, LIFT_ADD, LIFT_CMUL] THEN
    REWRITE_TAC [DIFFERENTIABLE_LIFT_COMPONENT, DIFFERENTIABLE_CONST] THEN
    SIMP_TAC [DIFFERENTIABLE_ADD] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC DIFFERENTIABLE_MUL_AT THEN
    ASM_REWRITE_TAC [o_DEF])

  let DIFFERENTIABLE_ON_REAL_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^N->real s.
        real_polynomial_function f ==> (lift o f) differentiable_on s"
   (SIMP_TAC [DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON,
              DIFFERENTIABLE_REAL_POLYNOMIAL_FUNCTION_AT])

  let DIFFERENTIABLE_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N a.
        vector_polynomial_function f ==> f differentiable (at a)"
   (REWRITE_TAC [vector_polynomial_function] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [DIFFERENTIABLE_COMPONENTWISE_AT] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC DIFFERENTIABLE_REAL_POLYNOMIAL_FUNCTION_AT THEN
    ASM_SIMP_TAC [])

  let DIFFERENTIABLE_ON_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!f:real^M->real^N s.
        vector_polynomial_function f ==> f differentiable_on s"
   (SIMP_TAC [DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON,
              DIFFERENTIABLE_VECTOR_POLYNOMIAL_FUNCTION])

  pure { PATH_VECTOR_POLYNOMIAL_FUNCTION, RECTIFIABLE_PATH_VECTOR_POLYNOMIAL_FUNCTION,
         PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION,
         CONNECTED_OPEN_VECTOR_POLYNOMIAL_CONNECTED,
         LIPSCHITZ_REAL_POLYNOMIAL_FUNCTION, LIPSCHITZ_VECTOR_POLYNOMIAL_FUNCTION,
         DIFFERENTIABLE_REAL_POLYNOMIAL_FUNCTION_AT,
         DIFFERENTIABLE_ON_REAL_POLYNOMIAL_FUNCTION,
         DIFFERENTIABLE_VECTOR_POLYNOMIAL_FUNCTION,
         DIFFERENTIABLE_ON_VECTOR_POLYNOMIAL_FUNCTION }

/- ------------------------------------------------------------------------- -/
/- Some basic properties of affine real algebraic varieties.                 -/
/- (realanalysis.ml 14616-14737)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBM where
  CLOSED_ALGEBRAIC_VARIETY : thm
  NEGLIGIBLE_ALGEBRAIC_VARIETY : thm
  EMPTY_INTERIOR_ALGEBRAIC_VARIETY : thm
  NOWHERE_DENSE_ALGEBRAIC_VARIETY : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBM [HolBase] (D : RealAnalysisDeps) (BRZBI : RZBI) (BRZBJ : RZBJ) : ExceptT String IO RZBM := do
  -- @@SCOPE BEGIN
  let { REAL_POLYNOMIAL_FUNCTION_EXPLICIT, REAL_POLYNOMIAL_FUNCTION_MUL,
        REAL_POLYNOMIAL_FUNCTION_POW, REAL_POLYNOMIAL_FUNCTION_PRODUCT,
        real_polynomial_function_RULES, REAL_POLYNOMIAL_FUNCTION_SUB,
        REAL_POLYNOMIAL_FUNCTION_SUM, .. } := BRZBI
  let { CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION, REAL_POLYNOMIAL_FUNCTION_DROP, .. } := BRZBJ
  let { REAL_POLYFUN_FINITE_ROOTS, .. } := D.qsession
  let { FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT, LEBESGUE_MEASURABLE_CLOSED,
        NEGLIGIBLE_EMPTY_INTERIOR, .. } := D.qmeasure
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_FINITE, NEGLIGIBLE_SUBSET,
        .. } := D.ts.cn.ms.qintegration3
  let { PRODUCT_CLAUSES_NUMSEG, .. } := D.ts.cn.ms.qproducts
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, SET_RULE,
        SET_TAC, .. } := D.ts.cn.cx.cvx
  let { INFINITE, LE_0, .. } := D.ts.cn.cx.cpx
  let { UPPER_BOUND_FINITE_SET, .. } := D.ts.cn.ms.ig.qmisc
  let { SUM_GROUP, .. } := D.ts.cn.ms.ig.qsession
  let { ARITH, CART_EQ, CONTRAPOS_THM, DE_MORGAN_THM, ETA_AX, FINITE_IMAGE, FINITE_NUMSEG,
        FINITE_RESTRICT, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_SING, LAMBDA_BETA, LAMBDA_ETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_SUB_0, SIMPLE_IMAGE_GEN, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUM_EQ_0, SUM_IMAGE, SUM_RMUL, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { CLOSED_SING, CLOSURE_EQ, .. } := D.ts.cn.cx.cvx.top1
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := D.ts.cn.cx.cvx.top2
  -- @@SCOPE END

  let CLOSED_ALGEBRAIC_VARIETY ← prove
   r"!f c. real_polynomial_function f ==> closed {x | f x = c}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM LIFT_EQ] THEN ONCE_REWRITE_TAC [← GSYM IN_SING] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
    REWRITE_TAC [CLOSED_SING] THEN GEN_TAC THEN
    MATCH_MP_TAC CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION THEN
    REWRITE_TAC [← GSYM REAL_POLYNOMIAL_FUNCTION_DROP, o_DEF, LIFT_DROP] THEN
    ASM_REWRITE_TAC [ETA_AX])

  let NEGLIGIBLE_ALGEBRAIC_VARIETY ← (do
    let lemma0 ← prove
     r"negligible {x | INFINITE {a | P a x}}
       ==> negligible {x | ~negligible {lift a | P a x}}"
     (MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, INFINITE, CONTRAPOS_THM] THEN
      REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      ASM_SIMP_TAC [NEGLIGIBLE_FINITE, FINITE_IMAGE])
    let lemma1 ← prove
     r"!n s a.
            n <= dimindex(:N) /\ FINITE s /\
            ~(!x:real^N. sum s
                (\k. a(k) * product(1..n) (\i. x$i pow (k i))) = &0)
            ==> negligible {x:real^N | sum s
                                 (\k. a(k) * product(1..n) (\i. x$i pow (k i))) =
                            &0}"
     (INDUCT_TAC THENL
       [REWRITE_TAC [PRODUCT_CLAUSES_NUMSEG, ARITH] THEN
        SIMP_TAC [← SET_RULE (← q r"{x | P} = if P then UNIV else {}"), NEGLIGIBLE_EMPTY],
        MAP_EVERY X_GEN_TAC [← q r"s:(num->num)->bool", ← q r"a:(num->num)->real"] THEN
        REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))] THEN
      SUBGOAL_THEN
       (← q r"closed {x:real^N | sum s (\k. a(k) * product (1..SUC n)
                                                     (\i. x$i pow (k i))) = &0}")
      MP_TAC THENL
       [MATCH_MP_TAC CLOSED_ALGEBRAIC_VARIETY THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_SUM THEN
        ASM_SIMP_TAC [FINITE_RESTRICT] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_MUL THEN
        REWRITE_TAC [real_polynomial_function_RULES] THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_PRODUCT THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_POW THEN
        MATCH_MP_TAC (← CONJUNCT1 real_polynomial_function_RULES) THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [PRODUCT_CLAUSES_NUMSEG, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
      MP_TAC (← ISPECL
       [← q r"\k. (k: num->num) (SUC n)", ← q r"s:(num->num)->bool"]
            UPPER_BOUND_FINITE_SET) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"m:num")) THEN
      MP_TAC (← GEN (← q r"g:(num->num)->real") (← ISPECL
         [← q r"\k. (k: num->num) (SUC n)",
          ← q r"g:(num->num)->real", ← q r"s:(num->num)->bool",
          ← q r"0..m"] SUM_GROUP)) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG, LE_0] THEN
      DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
      SIMP_TAC [IN_ELIM_THM] THEN REWRITE_TAC [REAL_MUL_ASSOC, SUM_RMUL] THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_CLOSED) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"SUC n") o MATCH_MP
        FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT) THEN
      DISCH_THEN SUBST1_TAC THEN
      SUBGOAL_THEN (← q r"SUC n <= dimindex(:N) /\
                    !i. i <= n ==> i <= dimindex(:N)") MP_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
      DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC lemma0 THEN
      SIMP_TAC [← ARITH_RULE (← q r"i <= n ==> ~(i = SUC n)")] THEN
      REWRITE_TAC [SUM_RMUL, REAL_MUL_ASSOC] THEN
      REWRITE_TAC [INFINITE, REAL_POLYFUN_FINITE_ROOTS] THEN
      REWRITE_TAC [← MESON [] (← q r"~(?y. y IN s /\ ~P y) <=> !i. i IN s ==> P i")] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") MP_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM] SUM_EQ_0)) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_NUMSEG, LE_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:num") MP_TAC) THEN
      SIMP_TAC [IN_ELIM_THM] THEN REWRITE_TAC [REAL_MUL_ASSOC, SUM_RMUL] THEN
      REWRITE_TAC [REAL_ENTIRE, DE_MORGAN_THM] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← MESON [NEGLIGIBLE_SUBSET]
       (← q r"!k:num. {x | !i:num. i <= m ==> P i x} SUBSET {x | P k x} /\
                negligible {x | P k x}
               ==> negligible {x:real^N | !i:num. i <= m ==> P i x}")) THEN
      EXISTS_TAC (← q r"j:num") THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [FINITE_RESTRICT] THEN
      CONJ_TAC THENL [ASM_ARITH_TAC, ASM_MESON_TAC []])
    let lemma2 ← prove
     r"!f:real^N->real.
            real_polynomial_function f /\ ~(!x. f x = &0)
            ==> negligible {x | f x = &0}"
     (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [REAL_POLYNOMIAL_FUNCTION_EXPLICIT, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:num^N->bool", ← q r"a:num^N->real"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
      MP_TAC (← ISPECL
       [← q r"dimindex(:N)", ← q r"IMAGE (\x:num^N i. x$i) s",
        ← q r"(a:num^N->real) o (\k. lambda i. k i)"] lemma1) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, LE_REFL] THEN
      SIMP_TAC [SUM_IMAGE, FUN_EQ_THM, CART_EQ] THEN
      REWRITE_TAC [o_DEF, LAMBDA_ETA])
    prove
     r"!f c. real_polynomial_function f /\ ~(!x. f x = c)
           ==> negligible {x | f x = c}"
     (ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma2 THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_POLYNOMIAL_FUNCTION_SUB THEN
      ASM_REWRITE_TAC [real_polynomial_function_RULES]))

  let EMPTY_INTERIOR_ALGEBRAIC_VARIETY ← prove
   r"!f c. real_polynomial_function f /\ ~(!x. f x = c)
         ==> interior {x:real^N | f(x) = c} = {}"
   (SIMP_TAC [NEGLIGIBLE_ALGEBRAIC_VARIETY, NEGLIGIBLE_EMPTY_INTERIOR])

  let NOWHERE_DENSE_ALGEBRAIC_VARIETY ← prove
   r"!f c. real_polynomial_function f /\ ~(!x. f x = c)
         ==> interior(closure {x:real^N | f(x) = c}) = {}"
   (MESON_TAC [EMPTY_INTERIOR_ALGEBRAIC_VARIETY, CLOSURE_EQ,
               CLOSED_ALGEBRAIC_VARIETY])

  pure { CLOSED_ALGEBRAIC_VARIETY, NEGLIGIBLE_ALGEBRAIC_VARIETY,
         EMPTY_INTERIOR_ALGEBRAIC_VARIETY, NOWHERE_DENSE_ALGEBRAIC_VARIETY }

/- ------------------------------------------------------------------------- -/
/- Bernoulli polynomials, defined recursively. We don't explicitly introduce -/
/- a definition for Bernoulli numbers, but use "bernoulli n (&0)" for that.  -/
/- (realanalysis.ml 14738-14942)                                            -/
/- ------------------------------------------------------------------------- -/

/-- The local `bernoullis` of `BERNOULLI_CONV` (realanalysis.ml 14751-14764). -/
partial def bernoullisRZ [HolBase] (bernoulli : thm)
    (NUM_ADD_CONV EXPAND_SUM_CONV NUM_REDUCE_CONV NUM_BINOM_CONV REAL_POLY_CONV : ioconv)
    (mk_small_numeral : Int → Except String term) (n : Int) :
    IO (Except String (List thm)) := ExceptT.run do
  if n < 0 then return []
  if n == 0 then return [← CONJUNCT1 bernoulli]
  let ths ← ExceptT.mk (bernoullisRZ bernoulli NUM_ADD_CONV EXPAND_SUM_CONV
    NUM_REDUCE_CONV NUM_BINOM_CONV REAL_POLY_CONV mk_small_numeral (n - 1))
  let th1 ← SPEC (← liftExcept (mk_small_numeral (n - 1))) (← CONJUNCT2 bernoulli)
  let th2 ← CONV_RULE (BINDER_CONV (COMB2_CONV (RAND_CONV (LAND_CONV NUM_ADD_CONV))
     (RAND_CONV (LAND_CONV EXPAND_SUM_CONV) THENC
      NUM_REDUCE_CONV THENC
      ONCE_DEPTH_CONV NUM_BINOM_CONV THENC
      REWRITE_CONV ths THENC
      REAL_POLY_CONV))) th1
  pure (th2 :: ths)

structure RZBN where
  bernoulli : thm
  BERNOULLI_CONV : ioconv
  BERNOULLI : thm
  BERNOULLI_EXPANSION : thm
  BERNOULLI_ALT : thm
  BERNOULLI_ADD : thm
  bernoulli_number : thm
  BERNOULLI_NUMBER : thm
  BERNOULLI_NUMBER_ALT : thm
  BERNOULLI_SUB_ADD1 : thm
  BERNOULLI_1 : thm
  SUM_OF_POWERS : thm
  HAS_REAL_DERIVATIVE_BERNOULLI : thm
  REAL_DIFFERENTIABLE_ON_BERNOULLI : thm
  REAL_CONTINUOUS_ON_BERNOULLI : thm
  HAS_REAL_INTEGRAL_BERNOULLI : thm
  POLYNOMIAL_FUNCTION_BERNOULLI : thm
  deriving Nonempty

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBN [HolBase] (D : RealAnalysisDeps) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) (BRZO : RZO) (BRZQ : RZQ) (BRZAN : RZAN) : ExceptT String IO RZBN := do
  -- @@SCOPE BEGIN
  let { real_differentiable, .. } := BRZK
  let { REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, HAS_REAL_DERIVATIVE_CHAIN_UNIV,
        REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, .. } := BRZN
  let { HAS_REAL_DERIVATIVE_ADD, HAS_REAL_DERIVATIVE_CONST, HAS_REAL_DERIVATIVE_SUM,
        .. } := BRZO
  let { add_real_differentiation_theorems, REAL_DIFF_TAC, .. } := BRZQ
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, .. } := BRZAN
  let { NUM_BINOM_CONV, REAL_POLY_CONV, .. } := D
  let { num_CASES, POLYNOMIAL_FUNCTION_CONST, POLYNOMIAL_FUNCTION_ID,
        POLYNOMIAL_FUNCTION_MUL, POLYNOMIAL_FUNCTION_POW, POLYNOMIAL_FUNCTION_SUM,
        SUM_DIFFS_ALT, .. } := D.qsession
  let { APPELL_SEQUENCE, BINOM_1, BINOM_PENULT, BINOM_REFL, BINOM_TOP_STEP_REAL,
        .. } := D.qbinomial
  let { define, .. } := D.ts.cn.cx
  let { REAL_POW_ZERO, SUC_SUB1, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC, NUM_REDUCE_CONV,
        REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, .. } := D.ts.cn.cx.cvx
  let { ADD_CLAUSES, LE_0, NOT_SUC, num_WF, REAL_ADD_SUB, REAL_POW_ADD, SUB_REFL,
        .. } := D.ts.cn.cx.cpx
  let { ADD1, ARITH, COND_ID, COND_RAND, COND_RATOR, ETA_AX, FINITE_NUMSEG, FORALL_AND_THM,
        .. } := D.ts.cn.cx.cvx.core1
  let { IN_NUMSEG, LE_1, REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_1,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LE, REAL_OF_NUM_SUB, REAL_OF_NUM_SUC, REAL_POS, REAL_POW_ONE,
        REAL_SUB_0, REAL_SUB_LDISTRIB, REAL_SUB_RDISTRIB, REAL_SUB_REFL,
        .. } := D.ts.cn.cx.cvx.core5
  let { num_INDUCTION, real_pow, SUM_CLAUSES_NUMSEG, SUM_DELTA, SUM_LMUL, SUM_SUB_NUMSEG,
        .. } := D.ts.cn.cx.cvx.core6
  let { ADD_SUB, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END
  let { NUM_ADD_CONV, EXPAND_SUM_CONV, mk_small_numeral, .. } := D

  let bernoulli ← define
   r"(!x. bernoulli 0 x = &1) /\
  (!n x. bernoulli (n + 1) x =
          x pow (n + 1) -
          sum(0..n) (\k. &(binom(n+2,k)) * bernoulli k x) / (&n + &2))"

  let btm ← q r"bernoulli"
  let BERNOULLI_CONV : ioconv := fun tm => ExceptT.run do
    match tm with
    | .Comb (.Comb b n) _ =>
      if b == btm then
        let th ← liftExcept (hd (← ExceptT.mk (bernoullisRZ bernoulli NUM_ADD_CONV
          EXPAND_SUM_CONV NUM_REDUCE_CONV NUM_BINOM_CONV REAL_POLY_CONV mk_small_numeral
          (← liftExcept (HolMath.Nums.dest_small_numeral n)))))
        ExceptT.mk ((REWR_CONV th THENC REAL_POLY_CONV) tm)
      else throw "BERNOULLI_CONV"
    | _ => throw "BERNOULLI_CONV"

  let (BERNOULLI, BERNOULLI_EXPANSION) ← (do
    let lemma ← (do
      let cth ← MESON [num_CASES] (← q r"(!n. P n) <=> P 0 /\ (!n. P(SUC n))")
      prove
       r"(!n x. sum (0..n) (\k. &(binom(n,k)) * B k x) - B n x =
              &n * x pow (n - 1)) <=>
       (!x. B 0 x = &1) /\
       (!n x. B (n + 1) x =
              x pow (n + 1) -
              sum(0..n) (\k. &(binom(n+2,k)) * B k x) / (&n + &2))"
       (GEN_REWRITE_TAC LAND_CONV [cth] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [cth] THEN
        SIMP_TAC [SUM_CLAUSES_NUMSEG, LE_0, BINOM_REFL, BINOM_PENULT, SUC_SUB1] THEN
        CONV_TAC NUM_REDUCE_CONV THEN
        REWRITE_TAC [REAL_MUL_LID, REAL_MUL_LZERO, REAL_SUB_REFL] THEN
        SIMP_TAC [ADD1, ← ARITH_RULE (← q r"(n + 1) + 1 = n + 2"), ← GSYM REAL_OF_NUM_ADD] THEN
        BINOP_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
        CONV_TAC REAL_FIELD))
    CONJ_PAIR (← prove
     r"(!n x. sum(0..n) (\k. &(binom(n,k)) * bernoulli k x) - bernoulli n x =
            &n * x pow (n - 1)) /\
     (!n x. bernoulli n x =
            sum(0..n) (\k. &(binom(n,k)) * bernoulli k (&0) * x pow (n - k)))"
     (REWRITE_TAC [lemma, bernoulli] THEN
      SUBGOAL_THEN
       (← q r"!n x. sum(0..n) (\k. &(binom(n,k)) *
                           sum (0..k)
                               (\l. &(binom(k,l)) *
                                    bernoulli l (&0) * x pow (k - l))) -
     sum(0..n) (\k. &(binom(n,k)) * bernoulli k (&0) * x pow (n - k)) =
     &n * x pow (n - 1)")
      MP_TAC THENL
       [REPEAT GEN_TAC THEN MP_TAC (← ISPECL
         [← q r"\n. bernoulli n (&0)", ← q r"n:num", ← q r"x:real", ← q r"&1"]
         APPELL_SEQUENCE) THEN
        REWRITE_TAC [REAL_POW_ONE, REAL_MUL_RID] THEN DISCH_THEN SUBST1_TAC THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x + &1 = &1 + x")] THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM APPELL_SEQUENCE] THEN
        REWRITE_TAC [REAL_POW_ONE, REAL_MUL_RID, ← GSYM SUM_SUB_NUMSEG] THEN
        REWRITE_TAC [← GSYM REAL_SUB_LDISTRIB, ← GSYM REAL_SUB_RDISTRIB] THEN
        REWRITE_TAC [← REWRITE_RULE [← GSYM lemma] bernoulli] THEN
        REWRITE_TAC [REAL_POW_ZERO, COND_RAND, COND_RATOR] THEN
        REWRITE_TAC [← ARITH_RULE (← q r"i - 1 = 0 <=> i = 0 \/ i = 1")] THEN
        REWRITE_TAC [← MESON []
         (← q r"(if p \/ q then x else y) = if q then x else if p then x else y")] THEN
        SIMP_TAC [REAL_MUL_LZERO, REAL_MUL_RZERO, COND_ID, SUM_DELTA] THEN
        REWRITE_TAC [IN_NUMSEG, LE_0, BINOM_1] THEN
        ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
        ASM_SIMP_TAC [LE_1] THEN REAL_ARITH_TAC,
        REWRITE_TAC [lemma] THEN STRIP_TAC THEN
         MATCH_MP_TAC num_WF THEN MATCH_MP_TAC num_INDUCTION THEN
        ASM_SIMP_TAC [ADD1, bernoulli,
               ← ARITH_RULE (← q r"m < n + 1 <=> m <= n")]])))

  let BERNOULLI_ALT ← prove
   r"!n x. sum(0..n) (\k. &(binom(n+1,k)) * bernoulli k x) =
         (&n + &1) * x pow n"
   (REPEAT GEN_TAC THEN
    MP_TAC (← SPECL [← q r"SUC n", ← q r"x:real"] BERNOULLI) THEN
    REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0, SUC_SUB1, BINOM_REFL] THEN
    REWRITE_TAC [ADD1, ← GSYM REAL_OF_NUM_ADD] THEN REAL_ARITH_TAC)

  let BERNOULLI_ADD ← prove
   r"!n x y. bernoulli n (x + y) =
           sum(0..n) (\k. &(binom(n,k)) * bernoulli k x * y pow (n - k))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [BERNOULLI_EXPANSION] THEN
    REWRITE_TAC [APPELL_SEQUENCE])

  let bernoulli_number ← prove
   r"bernoulli 0 (&0) = &1 /\
  (!n. bernoulli (n + 1) (&0) =
       --sum(0..n) (\k. &(binom(n+2,k)) * bernoulli k (&0)) / (&n + &2))"
   (REWRITE_TAC [bernoulli, REAL_POW_ADD] THEN REAL_ARITH_TAC)

  let BERNOULLI_NUMBER ← prove
   r"!n. sum (0..n) (\k. &(binom (n,k)) * bernoulli k (&0)) - bernoulli n (&0) =
       if n = 1 then &1 else &0"
   (REWRITE_TAC [BERNOULLI] THEN
    MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [ARITH, REAL_MUL_LZERO] THEN
    MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [SUC_SUB1] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC n = 1 <=> n = 0")] THEN
    CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [real_pow, REAL_MUL_LID] THEN
    REWRITE_TAC [NOT_SUC, REAL_MUL_LZERO, REAL_MUL_RZERO])

  let BERNOULLI_NUMBER_ALT ← prove
   r"!n. sum(0..n) (\k. &(binom(n+1,k)) * bernoulli k (&0)) =
       if n = 0 then &1 else &0"
   (REWRITE_TAC [BERNOULLI_ALT] THEN INDUCT_TAC THEN
    REWRITE_TAC [real_pow, REAL_MUL_LZERO, REAL_MUL_RZERO, NOT_SUC] THEN
    REWRITE_TAC [REAL_ADD_LID, REAL_MUL_RID])

  let BERNOULLI_SUB_ADD1 ← prove
   r"!n x. bernoulli n (x + &1) - bernoulli n x = &n * x pow (n - 1)"
   (REWRITE_TAC [BERNOULLI_ADD, REAL_POW_ONE, REAL_MUL_RID] THEN
    REWRITE_TAC [BERNOULLI])

  let BERNOULLI_1 ← prove
   r"!n. bernoulli n (&1) =
       if n = 1 then bernoulli n (&0) + &1 else bernoulli n (&0)"
   (GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM REAL_ADD_LID] THEN
    COND_CASES_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"x = y + &1 <=> x - y = &1")],
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_0]] THEN
    REWRITE_TAC [BERNOULLI_SUB_ADD1, REAL_POW_ZERO] THEN
    ASM_REWRITE_TAC [SUB_REFL, REAL_MUL_RID] THEN
    ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
    COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let SUM_OF_POWERS ← prove
   r"!m n. sum(0..n) (\k. &k pow m) =
         (bernoulli (m + 1) (&n + &1) - bernoulli (m + 1) (&0)) / (&m + &1)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o BINDER_CONV o RAND_CONV)
     [← GSYM SUC_SUB1] THEN
    REWRITE_TAC [← REAL_FIELD (← q r"x = y / (&m + &1) <=> (&m + &1) * x = y")] THEN
    REWRITE_TAC [← GSYM SUM_LMUL, REAL_OF_NUM_SUC, ← GSYM BERNOULLI_SUB_ADD1] THEN
    REWRITE_TAC [ADD1, SUM_DIFFS_ALT, LE_0])

  let HAS_REAL_DERIVATIVE_BERNOULLI ← prove
   r"!n x. ((bernoulli n) has_real_derivative (&n * bernoulli (n - 1) x))
         (atreal x)"
   (INDUCT_TAC THEN GEN_TAC THEN
    GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
    ONCE_REWRITE_TAC [BERNOULLI_EXPANSION] THEN
    REWRITE_TAC [SUM_CLAUSES_NUMSEG, ARITH, SUB_REFL, ← CONJUNCT1 real_pow] THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_CONST, REAL_MUL_LZERO, LE_0] THEN
    GEN_REWRITE_TAC (RATOR_CONV o RAND_CONV) [← GSYM REAL_ADD_RID] THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_ADD THEN
    REWRITE_TAC [HAS_REAL_DERIVATIVE_CONST, SUC_SUB1, ← GSYM SUM_LMUL] THEN
    MATCH_MP_TAC HAS_REAL_DERIVATIVE_SUM THEN
    REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN REAL_DIFF_TAC THEN
    REWRITE_TAC [ADD1, BINOM_TOP_STEP_REAL] THEN
    ASM_SIMP_TAC [← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_SUB, ← ARITH_RULE
     (← q r"k <= n ==> ~(k = n + 1) /\ (n + 1) - k - 1 = n - k /\ k <= n + 1")] THEN
    UNDISCH_TAC (← q r"k:num <= n") THEN REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN
    CONV_TAC REAL_FIELD)

  add_real_differentiation_theorems
   (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
    (← MATCH_MP HAS_REAL_DERIVATIVE_CHAIN_UNIV
     (← SPEC (← q r"n:num") HAS_REAL_DERIVATIVE_BERNOULLI))))

  let REAL_DIFFERENTIABLE_ON_BERNOULLI ← prove
   r"!n s. (bernoulli n) real_differentiable_on s"
   (REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, real_differentiable] THEN
    MESON_TAC [HAS_REAL_DERIVATIVE_BERNOULLI,
               HAS_REAL_DERIVATIVE_ATREAL_WITHIN])

  let REAL_CONTINUOUS_ON_BERNOULLI ← prove
   r"!n s. (bernoulli n) real_continuous_on s"
   (MESON_TAC [REAL_DIFFERENTIABLE_ON_BERNOULLI,
               REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON])

  let HAS_REAL_INTEGRAL_BERNOULLI ← prove
   r"!n. ((bernoulli n) has_real_integral (if n = 0 then &1 else &0))
       (real_interval[&0,&1])"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPECL
     [← q r"\x. bernoulli (n + 1) x / (&n + &1)", ← q r"bernoulli n", ← q r"&0", ← q r"&1"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    REWRITE_TAC [REAL_POS] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
      REWRITE_TAC [ADD_SUB, ← GSYM REAL_OF_NUM_ADD] THEN CONV_TAC REAL_FIELD,
      REWRITE_TAC [BERNOULLI_1, ← ARITH_RULE (← q r"n + 1 = 1 <=> n = 0")] THEN
      ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [REAL_SUB_REFL] THEN
      REWRITE_TAC [REAL_ADD_LID, ADD_CLAUSES, REAL_DIV_1, REAL_ADD_SUB]])

  let POLYNOMIAL_FUNCTION_BERNOULLI ← prove
   r"!n. polynomial_function(bernoulli n)"
   (GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    ONCE_REWRITE_TAC [BERNOULLI_EXPANSION] THEN
    MATCH_MP_TAC POLYNOMIAL_FUNCTION_SUM THEN
    SIMP_TAC [FINITE_NUMSEG, POLYNOMIAL_FUNCTION_MUL, POLYNOMIAL_FUNCTION_POW,
              POLYNOMIAL_FUNCTION_ID, POLYNOMIAL_FUNCTION_CONST])

  pure { bernoulli, BERNOULLI_CONV, BERNOULLI, BERNOULLI_EXPANSION, BERNOULLI_ALT,
         BERNOULLI_ADD, bernoulli_number, BERNOULLI_NUMBER, BERNOULLI_NUMBER_ALT,
         BERNOULLI_SUB_ADD1, BERNOULLI_1, SUM_OF_POWERS,
         HAS_REAL_DERIVATIVE_BERNOULLI, REAL_DIFFERENTIABLE_ON_BERNOULLI,
         REAL_CONTINUOUS_ON_BERNOULLI, HAS_REAL_INTEGRAL_BERNOULLI,
         POLYNOMIAL_FUNCTION_BERNOULLI }

/- ------------------------------------------------------------------------- -/
/- Bernoulli polynomials: uniqueness, Raabe, reflection.                     -/
/- (realanalysis.ml 14943-15106)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBO where
  BERNOULLI_UNIQUE : thm
  BERNOULLI_RAABE_2 : thm
  BERNOULLI_HALF : thm
  BERNOULLI_REFLECT : thm
  BERNOULLI_1_0 : thm
  BERNOULLI_NUMBER_ZERO : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBO [HolBase] (D : RealAnalysisDeps) (BRZM : RZM) (BRZS : RZS) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAN : RZAN) (BRZBN : RZBN) : ExceptT String IO RZBO := do
  -- @@SCOPE BEGIN
  let { IMAGE_AFFINITY_REAL_INTERVAL, .. } := BRZM
  let { REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION, .. } := BRZS
  let { HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_REAL_INTEGRAL_UNIQUE,
        REAL_INTEGRABLE_INTEGRAL, REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_ADD, HAS_REAL_INTEGRAL_CONST, HAS_REAL_INTEGRAL_LMUL,
        HAS_REAL_INTEGRAL_SUB, .. } := BRZAL
  let { HAS_REAL_INTEGRAL_AFFINITY, REAL_INTEGRABLE_CONTINUOUS, REAL_INTEGRAL_COMBINE,
        .. } := BRZAN
  let { bernoulli, BERNOULLI_1, BERNOULLI_ADD, BERNOULLI_ALT, BERNOULLI_SUB_ADD1,
        HAS_REAL_INTEGRAL_BERNOULLI, POLYNOMIAL_FUNCTION_BERNOULLI, .. } := BRZBN
  let { REAL_INTERVAL_EQ_EMPTY, .. } := D.qmisc
  let { EVEN_SUB, INFINITE_IMAGE_INJ, num_INFINITE, POLYNOMIAL_FUNCTION_ADD,
        POLYNOMIAL_FUNCTION_CONST, POLYNOMIAL_FUNCTION_FINITE_ROOTS,
        POLYNOMIAL_FUNCTION_ID, POLYNOMIAL_FUNCTION_LMUL, POLYNOMIAL_FUNCTION_o,
        POLYNOMIAL_FUNCTION_RMUL, POLYNOMIAL_FUNCTION_SUB, .. } := D.qsession
  let { BINOM_PENULT, BINOM_REFL, .. } := D.qbinomial
  let { REAL_POW_POW, .. } := D.ts.qsession
  let { IMP_REWRITE_TAC, .. } := D.ts.cn.ms.ig
  let { INFINITE_SUPERSET, SUM_EQ_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, REAL_RING, .. } := D.ts.cn.cx.cvx
  let { INFINITE, LE_0, num_WF, REAL_POW_ADD, real_sub, SUB_REFL, .. } := D.ts.cn.cx.cpx
  let { ADD1, ARITH, CONJ_SYM, EQ_TRANS, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, REAL_ADD_LID, REAL_DIV_REFL, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_INV_MUL, REAL_LT_POW2, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO,
        REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_SUC, REAL_POS, REAL_POW_DIV,
        REAL_POW_EQ_0, REAL_POW_MUL, REAL_POW_ONE, REAL_SUB_0, REAL_SUB_LDISTRIB,
        REAL_SUB_REFL, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { num_INDUCTION, o_DEF, real_div, real_pow, SUM_0, SUM_CLAUSES_NUMSEG, SUM_LMUL,
        SUM_NEG, SUM_SUB_NUMSEG, SWAP_FORALL_THM, .. } := D.ts.cn.cx.cvx.core6
  let { ADD_SUB, EVEN_ADD, EVEN_MULT, LT_SUC_LE, NOT_ODD, REAL_POW_NEG,
        .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let BERNOULLI_UNIQUE ← prove
   r"!p n. polynomial_function p /\
         (!x. p(x + &1) - p(x) = &n * x pow (n - 1)) /\
         (real_integral (real_interval[&0,&1]) p = if n = 0 then &1 else &0)
         ==> p = bernoulli n"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SUB_0] THEN
    MP_TAC (← SPECL [← q r"\x. p x - bernoulli n x", ← q r"p(&0) - bernoulli n (&0)"]
     POLYNOMIAL_FUNCTION_FINITE_ROOTS) THEN
    ASM_SIMP_TAC [POLYNOMIAL_FUNCTION_SUB,
                  POLYNOMIAL_FUNCTION_BERNOULLI, ETA_AX] THEN
    MATCH_MP_TAC (← TAUT (← q r"~p /\ (q ==> r) ==> (p <=> ~q) ==> r")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM INFINITE] THEN
      MATCH_MP_TAC INFINITE_SUPERSET THEN
      EXISTS_TAC (← q r"IMAGE (&) (:num)") THEN
      SIMP_TAC [INFINITE_IMAGE_INJ, REAL_OF_NUM_EQ, num_INFINITE,
                SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_ELIM_THM] THEN
      CONV_TAC (BINDER_CONV SYM_CONV) THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN
      ASM_MESON_TAC [BERNOULLI_SUB_ADD1, ← REAL_ARITH
       (← q r"p - b:real = p' - b' <=> p' - p = b' - b")],
      DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN ONCE_ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC HAS_REAL_INTEGRAL_UNIQUE THEN
      EXISTS_TAC (← q r"\x. p x - bernoulli n x") THEN
      EXISTS_TAC (← q r"real_interval[&0,&1]") THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← REAL_ARITH (← q r"x = x * (&1 - &0)")] THEN
        ONCE_ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC HAS_REAL_INTEGRAL_CONST THEN REWRITE_TAC [REAL_POS],
        GEN_REWRITE_TAC LAND_CONV
         [← GSYM (← SPEC (← q r"if n = 0 then &1 else &0") REAL_SUB_REFL)] THEN
        MATCH_MP_TAC HAS_REAL_INTEGRAL_SUB THEN
        REWRITE_TAC [ETA_AX, HAS_REAL_INTEGRAL_BERNOULLI] THEN
        ASM_REWRITE_TAC [HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
        MATCH_MP_TAC REAL_INTEGRABLE_CONTINUOUS THEN
        ASM_SIMP_TAC [REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION]]])

  let BERNOULLI_RAABE_2 ← prove
   r"!n x. bernoulli n ((x + &1) / &2) + bernoulli n (x / &2) =
         &2 / &2 pow n * bernoulli n x"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_REWRITE_TAC [bernoulli] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    SIMP_TAC [REAL_LT_POW2, ← REAL_FIELD
     (← q r"&0 < p ==> (x = &2 / p * y <=> p / &2 * x = y)")] THEN
    GEN_REWRITE_TAC id [← GSYM FUN_EQ_THM] THEN
    REWRITE_TAC [ETA_AX] THEN  MATCH_MP_TAC BERNOULLI_UNIQUE THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC POLYNOMIAL_FUNCTION_LMUL THEN
      MATCH_MP_TAC POLYNOMIAL_FUNCTION_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] POLYNOMIAL_FUNCTION_o) THEN
      REWRITE_TAC [POLYNOMIAL_FUNCTION_BERNOULLI, real_div] THEN
      SIMP_TAC [POLYNOMIAL_FUNCTION_ADD, POLYNOMIAL_FUNCTION_CONST,
                POLYNOMIAL_FUNCTION_ID, POLYNOMIAL_FUNCTION_RMUL],
      REWRITE_TAC [← REAL_ARITH (← q r"((x + &1) + &1) / &2 = x / &2 + &1")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * (x + y) - a * (y + z):real = a * (x - z)")] THEN
      REWRITE_TAC [BERNOULLI_SUB_ADD1, REAL_POW_DIV] THEN GEN_TAC THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a / b * c * d / e:real = c * (a / b / e) * d")] THEN
      ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
      MATCH_MP_TAC (← REAL_RING (← q r"b = &1 ==> a * b * c = a * c")) THEN
      REWRITE_TAC [real_div, ← GSYM REAL_MUL_ASSOC, ← GSYM REAL_INV_MUL] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 real_pow)] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n = 0) ==> SUC(n - 1) = n")] THEN
      REWRITE_TAC [← GSYM real_div] THEN MATCH_MP_TAC REAL_DIV_REFL THEN
      REWRITE_TAC [REAL_POW_EQ_0] THEN REAL_ARITH_TAC,
      SUBGOAL_THEN
       (← q r"(bernoulli n) real_integrable_on real_interval[&0,&1 / &2] /\
        (bernoulli n) real_integrable_on real_interval[&1 / &2,&1]")
      MP_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC REAL_INTEGRABLE_CONTINUOUS THEN
        SIMP_TAC [REAL_CONTINUOUS_ON_POLYNOMIAL_FUNCTION,
                  POLYNOMIAL_FUNCTION_BERNOULLI],
        DISCH_THEN (CONJUNCTS_THEN (MP_TAC o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_REAL_INTEGRAL_AFFINITY) o
         MATCH_MP REAL_INTEGRABLE_INTEGRAL))] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"m * (x - c):real = m * x + m * --c")] THEN
      REWRITE_TAC [IMAGE_AFFINITY_REAL_INTERVAL, IMP_IMP] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPECL [← q r"inv(&2)", ← q r"inv(&2)"])
       (MP_TAC o SPECL [← q r"inv(&2)", ← q r"&0"])) THEN
      REWRITE_TAC [REAL_INTERVAL_EQ_EMPTY] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_REAL_INTEGRAL_ADD) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"&2 pow n / &2") o
          MATCH_MP HAS_REAL_INTEGRAL_LMUL) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&1 / &2 * x + &1 / &2 = (x + &1) / &2"),
                   ← REAL_ARITH (← q r"&1 / &2 * x + &0 = x / &2")] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
      ASM_REWRITE_TAC [REAL_ENTIRE] THEN DISJ2_TAC THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&2 * x + &2 * y = &0 <=> y + x = &0")] THEN
      IMP_REWRITE_TAC [REAL_INTEGRAL_COMBINE] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← GSYM HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
      ASM_MESON_TAC [HAS_REAL_INTEGRAL_BERNOULLI]])

  let BERNOULLI_HALF ← prove
   r"!n. bernoulli n (&1 / &2) = (&2 / &2 pow n - &1) * bernoulli n (&0)"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"n:num", ← q r"&1"] BERNOULLI_RAABE_2) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + b:real = c * a <=> b = (c - &1) * a")] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [BERNOULLI_1] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let BERNOULLI_REFLECT ← prove
   r"!n x. bernoulli n (&1 - x) = --(&1) pow n * bernoulli n x"
   (ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. sum(0..n) (\k. &(binom(n + 1,k)) *
                         (bernoulli k (&1 - x) - --(&1) pow k * bernoulli k x)) =
          &0")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUM_SUB_NUMSEG, REAL_SUB_LDISTRIB] THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [REAL_SUB_0, BERNOULLI_ALT] THEN
      TRANS_TAC EQ_TRANS
       (← q r"--(&1) pow n * (bernoulli (n + 1) x - bernoulli (n + 1) (x - &1))") THEN
      CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"n + 1", ← q r"x - &1"] BERNOULLI_SUB_ADD1) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x - a + a:real = x")] THEN
        DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [ADD_SUB, ← REAL_ARITH (← q r"&1 - x = --(&1) * (x - &1)")] THEN
        REWRITE_TAC [REAL_POW_MUL, REAL_MUL_AC, ← GSYM REAL_OF_NUM_ADD],
        MATCH_MP_TAC (← REAL_FIELD
         (← q r"z pow 2 = &1 /\ z * x = y ==> z * y = x")) THEN
        REWRITE_TAC [REAL_POW_POW] THEN CONJ_TAC THENL
         [REWRITE_TAC [REAL_POW_NEG, EVEN_MULT, ARITH, REAL_POW_ONE],
          REWRITE_TAC [← GSYM SUM_LMUL]] THEN
        MP_TAC (← ISPECL [← q r"SUC n", ← q r"x:real", ← q r"--(&1)"] BERNOULLI_ADD) THEN
        REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0, BINOM_REFL, SUB_REFL] THEN
        REWRITE_TAC [← GSYM real_sub, ADD1, REAL_MUL_LID, ← CONJUNCT1 real_pow] THEN
        DISCH_THEN SUBST1_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"--s' = s ==> s = b - (s' + b * &1)")) THEN
        REWRITE_TAC [← GSYM SUM_NEG] THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
        X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REAL_RING
         (← q r"--(&1) pow 1 * p = q * r ==> --(b * k * p) = q * b * r * k")) THEN
        REWRITE_TAC [← GSYM REAL_POW_ADD] THEN REWRITE_TAC [REAL_POW_NEG] THEN
        REWRITE_TAC [EVEN_ADD, EVEN_SUB, REAL_POW_ONE, ARITH] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"k <= n ==> ~(n + 1 <= k)")] THEN
        REWRITE_TAC [← TAUT (← q r"~(~p <=> q) <=> (p <=> q)")]],
      MATCH_MP_TAC num_WF THEN MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [bernoulli, ← CONJUNCT1 real_pow, REAL_MUL_LID] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [LT_SUC_LE] THEN DISCH_THEN
       (fun th => tactic_of do
          pure (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"SUC n")) THEN ASSUME_TAC th)) THEN
      REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0] THEN
      ASM_SIMP_TAC [REAL_SUB_REFL, REAL_MUL_RZERO, SUM_0, REAL_ADD_LID] THEN
      REWRITE_TAC [← GSYM ADD1, BINOM_PENULT, ← GSYM REAL_OF_NUM_SUC] THEN
      REWRITE_TAC [REAL_ENTIRE, REAL_SUB_0] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC])

  let BERNOULLI_1_0 ← prove
   r"!n. bernoulli n (&1) = --(&1) pow n * bernoulli n (&0)"
   (GEN_TAC THEN SUBST1_TAC (← REAL_ARITH (← q r"&0 = &1 - &1")) THEN
    REWRITE_TAC [BERNOULLI_REFLECT, REAL_MUL_ASSOC, ← GSYM REAL_POW_MUL] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [REAL_POW_ONE, REAL_MUL_LID])

  let BERNOULLI_NUMBER_ZERO ← prove
   r"!n. ODD n /\ ~(n = 1) ==> bernoulli n (&0) = &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"n:num") BERNOULLI_1) THEN
    MP_TAC (← SPEC (← q r"n:num") BERNOULLI_1_0) THEN
    ASM_REWRITE_TAC [REAL_POW_NEG, REAL_POW_ONE, ← GSYM NOT_ODD] THEN
    REAL_ARITH_TAC)

  pure { BERNOULLI_UNIQUE, BERNOULLI_RAABE_2, BERNOULLI_HALF, BERNOULLI_REFLECT,
         BERNOULLI_1_0, BERNOULLI_NUMBER_ZERO }

/- ------------------------------------------------------------------------- -/
/- Bounds for Bernoulli polynomials.                                         -/
/- (realanalysis.ml 15107-15339)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBP where
  BERNOULLI_EVEN_BOUND : thm
  BERNOULLI_NUMBER_EQ_0 : thm
  BERNOULLI_BOUND : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBP [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZL : RZL) (BRZN : RZN) (BRZQ : RZQ) (BRZT : RZT) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAN : RZAN) (BRZAR : RZAR) (BRZBN : RZBN) (BRZBO : RZBO) : ExceptT String IO RZBP := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ATTAINS_SUP, REAL_CONTINUOUS_ON_ABS, .. } := BRZJ
  let { REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, .. } := BRZL
  let { REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, .. } := BRZN
  let { REAL_DIFF_TAC, REAL_DIFFERENTIABLE_TAC, .. } := BRZQ
  let { REAL_DERIVATIVE_ZERO_MAXMIN, REAL_ROLLE_SIMPLE, .. } := BRZT
  let { REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { REAL_INTEGRABLE_CONST, REAL_INTEGRAL_CONST, .. } := BRZAL
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, REAL_INTEGRABLE_CONTINUOUS, .. } := BRZAN
  let { REAL_INTEGRAL_ABS_BOUND_INTEGRAL, .. } := BRZAR
  let { bernoulli, BERNOULLI_CONV, BERNOULLI_EXPANSION, HAS_REAL_DERIVATIVE_BERNOULLI,
        REAL_CONTINUOUS_ON_BERNOULLI, .. } := BRZBN
  let { BERNOULLI_1_0, BERNOULLI_HALF, BERNOULLI_NUMBER_ZERO, BERNOULLI_REFLECT,
        .. } := BRZBO
  let { REAL_COMPACT_INTERVAL, REAL_OPEN_REAL_INTERVAL, .. } := D.qmetric
  let { IN_REAL_INTERVAL, real_interval, REAL_INTERVAL_NE_EMPTY, .. } := D.qmisc
  let { DIV_MULT, FINITE_REAL_INTERVAL, REAL_POLYFUN_FINITE_ROOTS, SUM_EQ_GENERAL_INVERSES,
        .. } := D.qsession
  let { binom, .. } := D.qbinomial
  let { ODD_ADD, ODD_MULT, .. } := D.ts.qsession
  let { INFINITE_SUPERSET, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC,
        INDUCT_TAC, MESON, NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, .. } := D.ts.cn.cx.cvx
  let { ADD_CLAUSES, INFINITE, LE_0, REAL_POW_MONO, SUB_REFL, .. } := D.ts.cn.cx.cpx
  let { ADD1, ADD_SUB2, AND_FORALL_THM, ARITH, ARITH_EQ, CONJ_ACI, CONTRAPOS_THM,
        EQ_SYM_EQ, EQ_TRANS, FORALL_AND_THM, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, LE_REFL, LEFT_IMP_EXISTS_THM, MULT_CLAUSES, NOT_EXISTS_THM,
        NOT_IMP, REAL_ABS_MUL, REAL_ABS_NEG, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_POW2, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_OF_NUM_ADD,
        REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_MUL, REAL_OF_NUM_SUC, REAL_POS,
        REAL_POW_EQ_0, REAL_POW_ONE, SUBSET, .. } := D.ts.cn.cx.cvx.core5
  let { real_div, real_max, .. } := D.ts.cn.cx.cvx.core6
  let { ADD_SUB, EVEN_EXISTS, EVEN_MULT, EVEN_OR_ODD, ODD_EXISTS, REAL_ABS_POW,
        .. } := D.ts.cn.ms.ig.dv.dg.qsession
  let { REAL_WLOG_LT, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let BERNOULLI_EVEN_BOUND ← (do
    let lemma ← prove
     r"(!n x. x IN real_interval(&0,&1 / &2)
              ==> ~(bernoulli (2 * n + 1) x = &0)) /\
       (!n x y. x IN real_interval(&0,&1 / &2) /\
                y IN real_interval(&0,&1 / &2) /\
                bernoulli (2 * n) x = &0 /\ bernoulli (2 * n) y = &0
                ==> x = y)"
     (REWRITE_TAC [AND_FORALL_THM, IN_REAL_INTERVAL] THEN INDUCT_TAC THENL
       [CONV_TAC NUM_REDUCE_CONV THEN
        CONV_TAC (ONCE_DEPTH_CONV BERNOULLI_CONV) THEN REAL_ARITH_TAC,
        POP_ASSUM MP_TAC THEN REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_WLOG_LT THEN REWRITE_TAC [] THEN
        CONJ_TAC THENL [REWRITE_TAC [CONJ_ACI, EQ_SYM_EQ], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL
         [← q r"\x. bernoulli (2 * SUC n) x / (&2 * &n + &2)",
          ← q r"bernoulli (2 * n + 1)", ← q r"x:real", ← q r"y:real"]
            REAL_ROLLE_SIMPLE) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
          REWRITE_TAC [← GSYM REAL_OF_NUM_MUL, ← GSYM REAL_OF_NUM_SUC,
                       ← ARITH_RULE (← q r"2 * SUC n - 1 = 2 * n + 1")] THEN
          CONV_TAC REAL_FIELD,
          REWRITE_TAC [IN_REAL_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"z:real") THEN
          DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
          ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
          ASM_REAL_ARITH_TAC],
        POP_ASSUM_LIST (K ALL_TAC) THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"x:real") THEN REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL
         [← q r"\x. bernoulli (2 * SUC n + 1) x / (&2 * &n + &3)",
          ← q r"bernoulli (2 * SUC n)", ← q r"&0", ← q r"x:real"]
            REAL_ROLLE_SIMPLE) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
         [REWRITE_TAC [real_div, REAL_MUL_LZERO, REAL_ENTIRE] THEN DISJ1_TAC THEN
          MATCH_MP_TAC BERNOULLI_NUMBER_ZERO THEN
          REWRITE_TAC [ODD_ADD, ODD_MULT, ADD1, ARITH] THEN ARITH_TAC,
          REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
          SIMP_TAC [ADD_SUB, ← GSYM REAL_OF_NUM_MUL, ← GSYM REAL_OF_NUM_ADD, ADD1] THEN
          CONV_TAC REAL_FIELD,
          REWRITE_TAC [IN_REAL_INTERVAL, NOT_EXISTS_THM] THEN
          X_GEN_TAC (← q r"u:real") THEN STRIP_TAC] THEN
        MP_TAC (← ISPECL
         [← q r"\x. bernoulli (2 * SUC n + 1) x / (&2 * &n + &3)",
          ← q r"bernoulli (2 * SUC n)", ← q r"x:real", ← q r"&1 / &2"]
            REAL_ROLLE_SIMPLE) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
         [REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN CONV_TAC SYM_CONV THEN
          REWRITE_TAC [REAL_ENTIRE] THEN DISJ1_TAC THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [BERNOULLI_HALF] THEN
          REWRITE_TAC [REAL_ENTIRE] THEN DISJ2_TAC THEN
          MATCH_MP_TAC BERNOULLI_NUMBER_ZERO THEN
          REWRITE_TAC [ODD_ADD, ODD_MULT, ADD1, ARITH] THEN ARITH_TAC,
          REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN
          SIMP_TAC [ADD_SUB, ← GSYM REAL_OF_NUM_MUL,
                    ← GSYM REAL_OF_NUM_ADD, ADD1] THEN
          CONV_TAC REAL_FIELD,
          REWRITE_TAC [IN_REAL_INTERVAL, NOT_EXISTS_THM] THEN
          X_GEN_TAC (← q r"v:real") THEN STRIP_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real", ← q r"v:real"]) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC])
    prove
     r"!n x. EVEN n /\ x IN real_interval[&0,&1]
           ==> abs(bernoulli n x) <= abs(bernoulli n (&0))"
     (REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [bernoulli, REAL_LE_REFL] THEN
      MP_TAC (← ISPECL [← q r"\x. abs(bernoulli n x)", ← q r"real_interval[&0,&1]"]
            REAL_CONTINUOUS_ATTAINS_SUP) THEN
      REWRITE_TAC [REAL_COMPACT_INTERVAL, REAL_INTERVAL_NE_EMPTY, REAL_POS] THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC REAL_CONTINUOUS_ON_ABS THEN
        MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
        REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE] THEN
        REPEAT STRIP_TAC THEN REAL_DIFFERENTIABLE_TAC,
        REWRITE_TAC [IN_REAL_INTERVAL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:real") MP_TAC)] THEN
      ASM_CASES_TAC (← q r"z = &0") THEN ASM_SIMP_TAC [] THEN
      ASM_CASES_TAC (← q r"z = &1") THEN ASM_REWRITE_TAC [BERNOULLI_1_0] THEN
      ASM_SIMP_TAC [REAL_ABS_MUL, REAL_ABS_POW, REAL_ABS_NEG, REAL_POW_ONE,
                    REAL_ABS_NUM, REAL_MUL_LID] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"bernoulli n", ← q r"&n * bernoulli (n - 1) z",
                        ← q r"z:real", ← q r"real_interval(&0,&1)"]
            REAL_DERIVATIVE_ZERO_MAXMIN) THEN
      REWRITE_TAC [REAL_OPEN_REAL_INTERVAL, IN_REAL_INTERVAL] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [HAS_REAL_DERIVATIVE_BERNOULLI] THEN
        ASM_CASES_TAC (← q r"&0 <= bernoulli n z") THENL
         [DISJ1_TAC, DISJ2_TAC] THEN
        X_GEN_TAC (← q r"y:real") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real")) THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_REWRITE_TAC [REAL_ENTIRE, REAL_OF_NUM_EQ] THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"z = &1 / &2") THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"!z. x <= z /\ z <= &1 * y ==> x <= y")) THEN
        EXISTS_TAC (← q r"abs(bernoulli n (&1 / &2))") THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REWRITE_TAC [BERNOULLI_HALF, REAL_ABS_MUL] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= &1 ==> abs(x - &1) <= &1")) THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID, REAL_POS] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&2 pow 1 <= x ==> &2 <= x")) THEN
        MATCH_MP_TAC REAL_POW_MONO THEN REWRITE_TAC [REAL_OF_NUM_LE] THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"&0 < z /\ z < &1 / &2 \/ &1 / &2 < z /\ z < &1")
      STRIP_ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC,
        MP_TAC (← ISPECL [← q r"(n - 2) DIV 2", ← q r"z:real"] (← CONJUNCT1 lemma)) THEN
        ASM_REWRITE_TAC [IN_REAL_INTERVAL],
        MP_TAC (← ISPECL [← q r"(n - 2) DIV 2", ← q r"&1 - z"] (← CONJUNCT1 lemma)) THEN
        ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [BERNOULLI_REFLECT]] THEN
        REWRITE_TAC [REAL_ENTIRE, REAL_POW_EQ_0] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV] THEN
      SUBGOAL_THEN (← q r"2 * (n - 2) DIV 2 + 1 = n - 1")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVEN_EXISTS]) THEN
      DISCH_THEN (CHOOSE_THEN SUBST_ALL_TAC) THEN
      UNDISCH_TAC (← q r"~(2 * m = 0)") THEN SPEC_TAC (← q r"m:num", ← q r"m:num") THEN
      INDUCT_TAC THEN REWRITE_TAC [MULT_CLAUSES, ADD_SUB2] THEN
      SIMP_TAC [DIV_MULT, ARITH_EQ] THEN ARITH_TAC))

  let BERNOULLI_NUMBER_EQ_0 ← prove
   r"!n. bernoulli n (&0) = &0 <=> ODD n /\ ~(n = 1)"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [BERNOULLI_NUMBER_ZERO] THEN
    ASM_CASES_TAC (← q r"n = 1") THEN
    ASM_REWRITE_TAC [← ExceptT.mk (BERNOULLI_CONV (← q r"bernoulli 1 (&0)"))] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN DISCH_TAC THEN
    DISJ_CASES_TAC (← SPEC (← q r"n:num") EVEN_OR_ODD) THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"n:num", ← q r"\k. &(binom(n,n - k)) * bernoulli (n - k) (&0)"]
          REAL_POLYFUN_FINITE_ROOTS) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ ~p ==> (p <=> q) ==> r")) THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"n:num") THEN SIMP_TAC [IN_NUMSEG, LE_0, LE_REFL, SUB_REFL] THEN
      REWRITE_TAC [binom, REAL_MUL_RID, bernoulli] THEN REAL_ARITH_TAC,
      REWRITE_TAC [← GSYM INFINITE] THEN MATCH_MP_TAC INFINITE_SUPERSET THEN
      EXISTS_TAC (← q r"real_interval[&0,&1]") THEN
      REWRITE_TAC [real_interval, INFINITE, FINITE_REAL_INTERVAL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"n:num", ← q r"x:real"] BERNOULLI_EVEN_BOUND) THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL,
        ← REAL_ARITH (← q r"abs x <= abs(&0) <=> x = &0")] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EQ_TRANS) THEN
      GEN_REWRITE_TAC RAND_CONV [BERNOULLI_EXPANSION] THEN
      MATCH_MP_TAC SUM_EQ_GENERAL_INVERSES THEN
      REPEAT (EXISTS_TAC (← q r"\k:num. n - k")) THEN
      SIMP_TAC [IN_NUMSEG, ← ARITH_RULE (← q r"k:num <= n ==> n - (n - k) = k")] THEN
      REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN ARITH_TAC])

  -- This is a simple though sub-optimal bound (we can actually get
  -- |B_{2n+1}(x)| <= (2n + 1) / (2 pi) * |B_{2n}(0)| with more work).

  let BERNOULLI_BOUND ← prove
   r"!n x. x IN real_interval[&0,&1]
         ==> abs(bernoulli n x)
             <= max (&n / &2) (&1) * abs(bernoulli (2 * n DIV 2) (&0))"
   (REPEAT STRIP_TAC THEN DISJ_CASES_TAC (← SPEC (← q r"n:num") EVEN_OR_ODD) THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVEN_EXISTS]),
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [ODD_EXISTS])] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") SUBST_ALL_TAC) THENL
     [REWRITE_TAC [← ARITH_RULE (← q r"(2 * m) DIV 2 = m")] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&1 * y <= max x (&1) * y /\ a <= y ==> a <= max x (&1) * y")) THEN
      SIMP_TAC [REAL_LE_RMUL, REAL_ABS_POS, ← REAL_ARITH (← q r"y <= max x y")] THEN
      MATCH_MP_TAC BERNOULLI_EVEN_BOUND THEN ASM_REWRITE_TAC [EVEN_MULT, ARITH],
      POP_ASSUM MP_TAC THEN SPEC_TAC (← q r"x:real", ← q r"x:real") THEN
      MATCH_MP_TAC (← MESON []
       (← q r"!Q. ((!x. P x /\ Q x ==> R x) ==> (!x. P x ==> R x)) /\
            (!x. P x /\ Q x ==> R x)
            ==> !x. P x ==> R x")) THEN
      EXISTS_TAC (← q r"\x. x IN real_interval[&0,&1 / &2]") THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
        ASM_CASES_TAC (← q r"x <= &1 / &2") THEN ASM_SIMP_TAC [] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"&1 - x")) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [BERNOULLI_REFLECT, REAL_ABS_MUL, REAL_ABS_POW] THEN
        REWRITE_TAC [REAL_ABS_NEG, REAL_ABS_NUM, REAL_MUL_LID, REAL_POW_ONE],
        REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [← ARITH_RULE (← q r"SUC(2 * m) DIV 2 = m")] THEN
        REWRITE_TAC [← GSYM REAL_OF_NUM_SUC, ← GSYM REAL_OF_NUM_MUL] THEN
        REWRITE_TAC [ADD1, ← REAL_ARITH (← q r"(x + &1) + &1 = x + &2")] THEN
        ASM_CASES_TAC (← q r"m = 0") THENL
         [ASM_REWRITE_TAC [MULT_CLAUSES, ADD_CLAUSES] THEN
          CONV_TAC (ONCE_DEPTH_CONV BERNOULLI_CONV) THEN ASM_REAL_ARITH_TAC,
          MP_TAC (← ISPECL [← q r"\x. bernoulli (2 * m + 1) x / &(2 * m + 1)",
                            ← q r"bernoulli (2 * m)", ← q r"&0", ← q r"x:real"]
            REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
          ASM_SIMP_TAC [BERNOULLI_NUMBER_ZERO, ODD_ADD, ODD_MULT, ARITH,
                        ← ARITH_RULE (← q r"2 * m + 1 = 1 <=> m = 0")] THEN
          ANTS_TAC THENL
           [REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN REWRITE_TAC [ADD_SUB] THEN
            REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_MUL] THEN
            CONV_TAC REAL_FIELD,
            DISCH_THEN (MP_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
            REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_MUL] THEN
            REWRITE_TAC [← REAL_FIELD
             (← q r"i = b / (&2 * &m + &1) - &0 / (&2 * &m + &1) <=>
              b = (&2 * &m + &1) * i")] THEN DISCH_THEN SUBST1_TAC THEN
            REWRITE_TAC [real_max, ← REAL_ARITH (← q r"(x + &1) / &2 <= &1 <=> x <= &1"),
                         REAL_OF_NUM_MUL, REAL_OF_NUM_LE] THEN
            ASM_REWRITE_TAC [← ARITH_RULE (← q r"2 * m <= 1 <=> m = 0")] THEN
            REWRITE_TAC [← GSYM REAL_OF_NUM_MUL, real_div, ← GSYM REAL_MUL_ASSOC] THEN
            REWRITE_TAC [REAL_ABS_MUL, ← REAL_ARITH
             (← q r"abs(&2 * &n + &1) = &2 * &n + &1")] THEN
            MATCH_MP_TAC REAL_LE_LMUL THEN
            CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
            TRANS_TAC REAL_LE_TRANS
              (← q r"real_integral (real_interval [&0,x])
                             (\x. abs(bernoulli (2 * m) (&0)))") THEN
            CONJ_TAC THENL
             [MATCH_MP_TAC REAL_INTEGRAL_ABS_BOUND_INTEGRAL THEN
              SIMP_TAC [REAL_INTEGRABLE_CONST, REAL_INTEGRABLE_CONTINUOUS,
                        REAL_CONTINUOUS_ON_BERNOULLI] THEN
              REPEAT STRIP_TAC THEN MATCH_MP_TAC BERNOULLI_EVEN_BOUND THEN
              REWRITE_TAC [EVEN_MULT, ARITH, IN_REAL_INTERVAL] THEN
              RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
              ASM_REAL_ARITH_TAC,
              ASM_SIMP_TAC [REAL_INTEGRAL_CONST] THEN
              REWRITE_TAC [← REAL_ARITH (← q r"a * (x - &0) = x * a")] THEN
              MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
              ASM_REAL_ARITH_TAC]]]]])

  pure { BERNOULLI_EVEN_BOUND, BERNOULLI_NUMBER_EQ_0, BERNOULLI_BOUND }

/- ------------------------------------------------------------------------- -/
/- Absolutely integrable functions remain so modified by Bernoulli sawtooth; -/
/- the Euler-Maclaurin summation formula for real functions.                 -/
/- (realanalysis.ml 15340-15607)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBQ where
  ABSOLUTELY_INTEGRABLE_ON_MUL_BERNOULLI_FRAC : thm
  REAL_EULER_MACLAURIN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBQ [HolBase] (D : RealAnalysisDeps) (BRZJ : RZJ) (BRZK : RZK) (BRZL : RZL) (BRZN : RZN) (BRZQ : RZQ) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAM : RZAM) (BRZAN : RZAN) (BRZAX : RZAX) (BRZBD : RZBD) (BRZBN : RZBN) (BRZBP : RZBP) : ExceptT String IO RZBQ := do
  -- @@SCOPE BEGIN
  let { REAL_CONTINUOUS_ON, REAL_CONTINUOUS_ON_MUL, REAL_CONTINUOUS_ON_SUBSET, .. } := BRZJ
  let { REAL_COMPACT_CONTINUOUS_IMAGE, real_differentiable, real_differentiable_on,
        .. } := BRZK
  let { REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE, .. } := BRZL
  let { HAS_REAL_DERIVATIVE_WITHIN_SUBSET, REAL_CONTINUOUS_CONTINUOUS_ATREAL,
        REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, .. } := BRZN
  let { REAL_DIFF_TAC, REAL_DIFFERENTIABLE_TAC, .. } := BRZQ
  let { HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_REAL_INTEGRAL_INTEGRAL,
        REAL_INTEGRABLE_INTEGRAL, real_integrable_on, REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { HAS_REAL_INTEGRAL_LMUL, REAL_INTEGRABLE_ON_NULL, REAL_INTEGRAL_NULL, .. } := BRZAL
  let { REAL_INTEGRABLE_SPIKE, REAL_INTEGRAL_SPIKE, REAL_NEGLIGIBLE_SING, .. } := BRZAM
  let { HAS_REAL_INTEGRAL_COMBINE, REAL_INTEGRABLE_CONTINUOUS, .. } := BRZAN
  let { REAL_INTEGRATION_BY_PARTS_SIMPLE, .. } := BRZAX
  let { REAL_CONTINUOUS_FRAC, .. } := BRZBD
  let { bernoulli, BERNOULLI_1, BERNOULLI_CONV, REAL_CONTINUOUS_ON_BERNOULLI, .. } := BRZBN
  let { BERNOULLI_NUMBER_EQ_0, .. } := BRZBP
  let { real_bounded, REAL_COMPACT_IMP_BOUNDED, REAL_COMPACT_INTERVAL, .. } := D.qmetric
  let { LIFT_IN_IMAGE_LIFT, .. } := D.qvectors
  let { COUNTABLE_INTEGER, IN_REAL_INTERVAL, SUBSET_REAL_INTERVAL, .. } := D.qmisc
  let { LT_LE, SUM_CLAUSES_RIGHT, SUM_DIFFS_ALT, .. } := D.qsession
  let { FRAC_UNIQUE, .. } := D.qfloor
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT,
        CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
        MEASURABLE_ON_COMPOSE_CONTINUOUS, .. } := D.qmeasure
  let { ADD_ASSOC, ODD_ADD, ODD_MULT, .. } := D.ts.qsession
  let { LEBESGUE_MEASURABLE_UNIV, .. } := D.ts.qmeasure
  let { FACT, .. } := D.ts.cn.qsession
  let { ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, .. } := D.ts.cn.ms.qintegration1
  let { NEGLIGIBLE_COUNTABLE, .. } := D.ts.cn.ms.qintegration3
  let { FLOOR_FRAC, .. } := D.ts.cn.ms.qfloor
  let { ADD_EQ_0, FACT_NZ, SUC_SUB1, SUM_EQ_NUMSEG, SUM_SING_NUMSEG,
        .. } := D.ts.cn.ms.qsession
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC,
        INDUCT_TAC, MESON, MESON_TAC, NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, .. } := D.ts.cn.cx.cvx
  let { LE_0, NOT_SUC, REAL_ADD_SUB, .. } := D.ts.cn.cx.cpx
  let { INTEGER_CLOSED, .. } := D.ts.cn.ms.ig.qfloor
  let { ADD1, ARITH, ARITH_EQ, COND_RAND, EQ_TRANS, ETA_AX, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN, IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { IN_SING, IN_UNIV, LE_REFL, LT_IMP_LE, REAL_ADD_ASSOC, REAL_ADD_LID, REAL_ADD_RID,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_MUL, REAL_OF_NUM_SUC,
        REAL_SUB_REFL, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, SUM_0, SUM_ADD_NUMSEG, SUM_CLAUSES_LEFT, SUM_CLAUSES_NUMSEG,
        SUM_LMUL, SUM_SUB_NUMSEG, .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ts.cn.cx.cvx.lib
  let { FORALL_LIFT, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_RZERO, .. } := D.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.ts.cn.cx.cvx.top2
  let { bounded, .. } := D.ts.cn.cx.cvx.top5
  let { BILINEAR_DROP_MUL, .. } := D.ts.cn.ms.ig.dv.qvec
  let { ADD_SUB, LT, LT_SUC_LE, SUM_OFFSET, .. } := D.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_ON_MUL_BERNOULLI_FRAC ← prove
   r"!f:real^1->real^N s n.
        f absolutely_integrable_on s
        ==> (\x. bernoulli n (frac(drop x)) % f x)
            absolutely_integrable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_TAC THEN MP_TAC (← ISPECL
     [← q r"\x y:real^N. drop(x) % y",
      ← q r"\x:real^1. lift(bernoulli n (frac (drop x)))",
      ← q r"\x. if x IN s then (f:real^1->real^N) x else vec 0", ← q r"(:real^1)"]
     ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT) THEN
    ASM_REWRITE_TAC [LIFT_DROP, BILINEAR_DROP_MUL] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN REWRITE_TAC [VECTOR_MUL_RZERO] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"(\x. lift(bernoulli n (frac (drop x)))) =
        (lift o bernoulli n o drop) o (lift o frac o drop)")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF, LIFT_DROP], ALL_TAC] THEN
      MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS THEN CONJ_TAC THENL
       [MATCH_MP_TAC
          CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE lift integer") THEN
        SIMP_TAC [LEBESGUE_MEASURABLE_UNIV, NEGLIGIBLE_COUNTABLE,
                  COUNTABLE_IMAGE, COUNTABLE_INTEGER] THEN
        MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
        REWRITE_TAC [FORALL_LIFT, IN_DIFF, IN_UNIV, LIFT_IN_IMAGE_LIFT] THEN
        REWRITE_TAC [IN] THEN
        REWRITE_TAC [← GSYM REAL_CONTINUOUS_CONTINUOUS_ATREAL] THEN
        REWRITE_TAC [REAL_CONTINUOUS_FRAC],
        MP_TAC (← SPECL [← q r"n:num", ← q r"(:real)"] REAL_CONTINUOUS_ON_BERNOULLI) THEN
        REWRITE_TAC [REAL_CONTINUOUS_ON, IMAGE_LIFT_UNIV]],
      REWRITE_TAC [bounded, FORALL_IN_IMAGE, IN_UNIV, NORM_LIFT] THEN
      SUBGOAL_THEN (← q r"real_compact (IMAGE (bernoulli n) (real_interval[&0,&1]))")
      MP_TAC THENL
       [MATCH_MP_TAC REAL_COMPACT_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [REAL_CONTINUOUS_ON_BERNOULLI, REAL_COMPACT_INTERVAL],
        DISCH_THEN (MP_TAC o MATCH_MP REAL_COMPACT_IMP_BOUNDED) THEN
        REWRITE_TAC [real_bounded, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
        MESON_TAC [FLOOR_FRAC, REAL_LT_IMP_LE]]])

  -- The Euler-Maclaurin summation formula for real and complex functions.

  let REAL_EULER_MACLAURIN ← (do
    let lemma ← prove
     r"!f k m n.
            f real_continuous_on real_interval[&m,&n] /\ m < n
            ==> ((\x. bernoulli k (frac x) * f x) has_real_integral
                 sum(m..n-1) (\j. real_integral (real_interval[&j,&j + &1])
                                               (\x. bernoulli k (x - &j) * f x)))
                (real_interval[&m,&n])"
     (REPLICATE_TAC 3 GEN_TAC THEN INDUCT_TAC THEN REWRITE_TAC [← CONJUNCT1 LT] THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC, LT_SUC_LE, SUC_SUB1] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"m:num = n") THENL
       [ASM_REWRITE_TAC [SUM_SING_NUMSEG],
        SUBGOAL_THEN (← q r"0 < n") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        ASM_SIMP_TAC [SUM_CLAUSES_RIGHT] THEN
        MATCH_MP_TAC HAS_REAL_INTEGRAL_COMBINE THEN EXISTS_TAC (← q r"&n") THEN
        ASM_REWRITE_TAC [REAL_OF_NUM_LE, ← REAL_ARITH (← q r"x <= x + &1")] THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [LT_LE] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            REAL_CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
          ASM_REWRITE_TAC [REAL_OF_NUM_LE, ← REAL_ARITH (← q r"x <= x + &1"), LE_REFL],
          ALL_TAC]] THEN
      MATCH_MP_TAC (← MESON [REAL_INTEGRAL_SPIKE, HAS_REAL_INTEGRAL_INTEGRAL,
                             REAL_INTEGRABLE_SPIKE]
       (← q r"!t. g real_integrable_on s /\ real_negligible t /\
            (!x. x IN s DIFF t ==> f x = g x)
            ==>  (f has_real_integral (real_integral s g)) s")) THEN
      EXISTS_TAC (← q r"{&n + &1}") THEN REWRITE_TAC [REAL_NEGLIGIBLE_SING] THEN
      (CONJ_TAC THENL
        [MATCH_MP_TAC REAL_INTEGRABLE_CONTINUOUS THEN
         MATCH_MP_TAC REAL_CONTINUOUS_ON_MUL THEN CONJ_TAC THENL
          [MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
           REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE] THEN
           REPEAT STRIP_TAC THEN REAL_DIFFERENTIABLE_TAC,
           FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
             REAL_CONTINUOUS_ON_SUBSET)) THEN
           REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
           REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE] THEN ASM_ARITH_TAC],
         REWRITE_TAC [IN_DIFF, IN_SING, IN_REAL_INTERVAL] THEN
         X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
         AP_TERM_TAC THEN     REWRITE_TAC [← GSYM FRAC_UNIQUE] THEN
         REWRITE_TAC [← REAL_ARITH (← q r"x - (x - &n) = &n"), INTEGER_CLOSED] THEN
         ASM_REAL_ARITH_TAC]))
    let step ← prove
     r"!f f' k m n.
            m < n /\
            (!x. x IN real_interval[&m,&n]
                 ==> (f has_real_derivative f' x)
                     (atreal x within real_interval[&m,&n])) /\
            f' real_continuous_on real_interval[&m,&n]
            ==> real_integral (real_interval[&m,&n])
                              (\x. bernoulli (k + 1) (frac x) * f' x) =
                (bernoulli (k + 1) (&0) * (f(&n) - f(&m)) +
                 (if k = 0 then sum(m+1..n) (\i. f(&i)) else &0)) -
                (&k + &1) *
                real_integral (real_interval[&m,&n])
                              (\x. bernoulli k (frac x) * f x)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"f real_continuous_on real_interval[&m,&n]") ASSUME_TAC THENL
       [ASM_MESON_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE,
                       real_differentiable,
                       REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON],
        ASM_SIMP_TAC [← REWRITE_RULE [HAS_REAL_INTEGRAL_INTEGRABLE_INTEGRAL]
         lemma]] THEN
      TRANS_TAC EQ_TRANS
        (← q r"sum(m..n-1)
            (\j. (bernoulli (k + 1) (&0) * (f (&j + &1) - f (&j)) +
                  (if k = 0 then f (&j + &1) else &0)) -
                 (&k + &1) *
                 real_integral (real_interval[&j,&j + &1])
                               (\x. bernoulli k (x - &j) * f x))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        REWRITE_TAC [] THEN MATCH_MP_TAC REAL_INTEGRAL_UNIQUE THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [REAL_MUL_SYM]
          REAL_INTEGRATION_BY_PARTS_SIMPLE) THEN
        MAP_EVERY EXISTS_TAC
         [← q r"f:real->real", ← q r"\x. (&k + &1) * bernoulli k (x - &j)"] THEN
        REWRITE_TAC [REAL_ADD_SUB, REAL_SUB_REFL, BERNOULLI_1] THEN
        REPEAT CONJ_TAC THENL
         [REAL_ARITH_TAC,
          X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
          CONJ_TAC THENL
           [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ANTS_TAC THENL
             [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
               (← q r"x IN s ==> s SUBSET t ==> x IN t"))),
              MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
                HAS_REAL_DERIVATIVE_WITHIN_SUBSET)] THEN
            REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
            REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN ASM_ARITH_TAC,
            REAL_DIFF_TAC THEN  REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ADD_SUB] THEN
            REAL_ARITH_TAC],
          REWRITE_TAC [← ARITH_RULE (← q r"k + 1 = 1 <=> k = 0")] THEN
          ASM_CASES_TAC (← q r"k = 0") THEN ASM_REWRITE_TAC [] THENL
           [REWRITE_TAC [← REAL_ARITH
             (← q r"(b + &1) * f1 - b * f0 - ((b * (f1 - f0) + f1) - w):real = w")],
            REWRITE_TAC [← REAL_ARITH
             (← q r"b * f1 - b * f0 - ((b * (f1 - f0) + &0) - w) = w")]] THEN
          REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN
          MATCH_MP_TAC HAS_REAL_INTEGRAL_LMUL THEN
          MATCH_MP_TAC REAL_INTEGRABLE_INTEGRAL THEN
          MATCH_MP_TAC REAL_INTEGRABLE_CONTINUOUS THEN
          MATCH_MP_TAC REAL_CONTINUOUS_ON_MUL THEN
          (CONJ_TAC THENL
            [MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
             REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE] THEN
             REPEAT STRIP_TAC THEN REAL_DIFFERENTIABLE_TAC,
             FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
               REAL_CONTINUOUS_ON_SUBSET)) THEN
             REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
             REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN ASM_ARITH_TAC])],
        REWRITE_TAC [SUM_ADD_NUMSEG, SUM_LMUL, SUM_SUB_NUMSEG] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN BINOP_TAC THENL
         [AP_TERM_TAC THEN REWRITE_TAC [← GSYM SUM_SUB_NUMSEG] THEN
          REWRITE_TAC [REAL_OF_NUM_ADD, SUM_DIFFS_ALT] THEN
          COND_CASES_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
          AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
          ASM_ARITH_TAC,
          ASM_CASES_TAC (← q r"k = 0") THEN ASM_REWRITE_TAC [SUM_0] THEN
          REWRITE_TAC [← GSYM (← SPEC (← q r"1") SUM_OFFSET), REAL_OF_NUM_ADD] THEN
          AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN ASM_ARITH_TAC]])
    prove
     r"!f m n p.
      m <= n /\
      (!k x. k <= 2 * p + 1 /\ x IN real_interval[&m,&n]
             ==> ((f k) has_real_derivative f (k + 1) x)
                 (atreal x within real_interval [&m,&n]))
      ==> (\x. bernoulli (2 * p + 1) (frac x) * f (2 * p + 1) x)
          real_integrable_on real_interval[&m,&n] /\
          sum(m..n) (\i. f 0 (&i)) =
          real_integral (real_interval [&m,&n]) (f 0) +
          (f 0 (&m) + f 0 (&n)) / &2 +
          sum (1..p) (\k. bernoulli (2 * k) (&0) / &(FACT(2 * k)) *
                          (f (2 * k - 1) (&n) - f (2 * k - 1) (&m))) +
          real_integral (real_interval [&m,&n])
                        (\x. bernoulli (2 * p + 1) (frac x) * f (2 * p + 1) x) /
          &(FACT(2 * p + 1))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
       (← q r"m:num <= n ==> m = n \/ m < n")))
      THENL
       [ASM_SIMP_TAC [REAL_INTEGRABLE_ON_NULL, REAL_LE_REFL] THEN
        ASM_REWRITE_TAC [SUM_SING_NUMSEG, REAL_SUB_REFL, REAL_MUL_LZERO] THEN
        SIMP_TAC [REAL_INTEGRAL_NULL, REAL_LE_REFL, ← REAL_ARITH (← q r"(x + x) / &2 = x"),
                  REAL_MUL_RZERO, SUM_0, real_div, REAL_MUL_LZERO] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [real_integrable_on] THEN
        MP_TAC (← ISPECL [← q r"f (2 * p + 1):real->real", ← q r"2 * p + 1",
                          ← q r"m:num", ← q r"n:num"]
            lemma) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
        MATCH_MP_TAC REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON THEN
        REWRITE_TAC [REAL_DIFFERENTIABLE_ON_DIFFERENTIABLE] THEN
        REWRITE_TAC [real_differentiable] THEN ASM_MESON_TAC [LE_REFL],
        ALL_TAC] THEN
      ASM_SIMP_TAC [SUM_CLAUSES_LEFT, LT_IMP_LE] THEN
      SUBGOAL_THEN
       (← q r"!k:num.  k <= 2 * p + 1
               ==> (f k) real_differentiable_on real_interval[&m,&n]")
      ASSUME_TAC THENL [ASM_MESON_TAC [real_differentiable_on], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"(f:num->real->real) 0", ← q r"(f:num->real->real) (0 + 1)",
                        ← q r"0", ← q r"m:num", ← q r"n:num"] step) THEN
      ASM_SIMP_TAC [REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON,
                    ← ARITH_RULE (← q r"0 + 1 <= 2 * p + 1"), LE_0] THEN
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [← CONJUNCT1 bernoulli] THEN
      REWRITE_TAC [REAL_ADD_LID, REAL_MUL_LID, ETA_AX] THEN
      REWRITE_TAC [← ExceptT.mk (BERNOULLI_CONV (← q r"bernoulli 1 (&0)"))] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"i' = r ==> i' = (-- &1 / &2 * (n - m) + s) - i
                 ==> m + s = i + (m + n) / &2 + r")) THEN
      POP_ASSUM_LIST (MP_TAC o HolLight.end_itlist CONJ o HolLight.rev) THEN
      SPEC_TAC (← q r"p:num", ← q r"p:num") THEN INDUCT_TAC THENL
       [REWRITE_TAC [SUM_CLAUSES_NUMSEG] THEN CONV_TAC NUM_REDUCE_CONV THEN
        REAL_ARITH_TAC,
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
         [← ARITH_RULE (← q r"2 * SUC p + 1 = 2 * p + 3")] THEN
        FIRST_X_ASSUM (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"k <= 2 * p + 1 ==> k <= 2 * p + 3")] THEN
        DISCH_TAC] THEN
      ASM_REWRITE_TAC [SUM_CLAUSES_NUMSEG, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
      REWRITE_TAC [← GSYM REAL_ADD_ASSOC] THEN AP_TERM_TAC THEN
      MP_TAC (← ISPECL [← q r"(f:num->real->real) (2 * p + 1)",
                        ← q r"(f:num->real->real) ((2 * p + 1) + 1)",
                        ← q r"2 * p + 1", ← q r"m:num", ← q r"n:num"] step) THEN
      ASM_SIMP_TAC [REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON,
                    ← ARITH_RULE (← q r"(2 * p + 1) + 1 <= 2 * p + 3"),
                    ← ARITH_RULE (← q r"2 * p + 1 <= 2 * p + 3")] THEN
      REWRITE_TAC [ADD_EQ_0, ARITH_EQ, REAL_ADD_RID] THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_MUL] THEN
      REWRITE_TAC [← REAL_FIELD
       (← q r"x = y - ((&2 * &p + &1) + &1) * z <=> z = (y - x) / (&2 * &p + &2)")] THEN
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [← ARITH_RULE (← q r"2 * SUC p - 1 = 2 * p + 1")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * p + 1) + 1 = 2 * SUC p")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"2 * SUC p = SUC(2 * p + 1)")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"SUC(2 * p + 1) + 1 = SUC(SUC(2 * p + 1))")] THEN
      REWRITE_TAC [FACT, ← GSYM REAL_OF_NUM_MUL, ← GSYM REAL_OF_NUM_ADD,
                   ← GSYM REAL_OF_NUM_SUC] THEN
      MATCH_MP_TAC (← REAL_FIELD
       (← q r"~(t = &0) /\
        i2 = &0 - (&2 * &p + &3) * i1
        ==> (b * (fn - fm) - i1) / (&2 * &p + &2) / t =
            b / (((&2 * &p + &1) + &1) * t) * (fn - fm) +
            i2 / ((((&2 * &p + &1) + &1) + &1) * ((&2 * &p + &1) + &1) * t)")) THEN
      REWRITE_TAC [REAL_OF_NUM_EQ, FACT_NZ] THEN
      MP_TAC (← ISPECL [← q r"(f:num->real->real) (SUC(2 * p + 1))",
                        ← q r"(f:num->real->real) (SUC(2 * p + 1) + 1)",
                        ← q r"SUC(2 * p + 1)", ← q r"m:num", ← q r"n:num"] step) THEN
      ASM_SIMP_TAC [REAL_DIFFERENTIABLE_ON_IMP_REAL_CONTINUOUS_ON, NOT_SUC,
                    ← ARITH_RULE (← q r"SUC(2 * p + 1) + 1 <= 2 * p + 3"),
                    ← ARITH_RULE (← q r"SUC(2 * p + 1) <= 2 * p + 3")] THEN
      REWRITE_TAC [ADD1, ← GSYM ADD_ASSOC, REAL_OF_NUM_ADD] THEN
      CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, REAL_ADD_RID, ← GSYM REAL_OF_NUM_MUL] THEN
      DISCH_THEN SUBST1_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [REAL_ENTIRE] THEN DISJ1_TAC THEN
      REWRITE_TAC [BERNOULLI_NUMBER_EQ_0] THEN
      REWRITE_TAC [ODD_ADD, ODD_MULT, ARITH] THEN ARITH_TAC))

  pure { ABSOLUTELY_INTEGRABLE_ON_MUL_BERNOULLI_FRAC, REAL_EULER_MACLAURIN }

/- ------------------------------------------------------------------------- -/
/- Euler-Maclaurin summation formula, antiderivative forms.                  -/
/- (realanalysis.ml 15608-15707)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBR where
  REAL_EULER_MACLAURIN_ANTIDERIVATIVE : thm
  COMPLEX_EULER_MACLAURIN_ANTIDERIVATIVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBR [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZK : RZK) (BRZN : RZN) (BRZAK : RZAK) (BRZAN : RZAN) (BRZBQ : RZBQ) : ExceptT String IO RZBR := do
  -- @@SCOPE BEGIN
  let { REALLIM_ATREAL, .. } := BRZF
  let { HAS_REAL_DERIVATIVE_ATREAL, .. } := BRZK
  let { HAS_REAL_DERIVATIVE_ATREAL_WITHIN, .. } := BRZN
  let { REAL_INTEGRABLE_ON, REAL_INTEGRAL, REAL_INTEGRAL_UNIQUE, .. } := BRZAK
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, .. } := BRZAN
  let { REAL_EULER_MACLAURIN, .. } := BRZBQ
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { HAS_COMPLEX_DERIVATIVE_AT, .. } := D.ts.knf
  let { COMPLEX_EQ, IM_DEF, RE_DEF, .. } := D.ts.cn.cxa
  let { CX_SUB, DIST_CX, IM_ADD, IM_CX, IM_DIV_CX, IM_MUL_CX, IM_SUB, RE_ADD, RE_CX,
        RE_DIV_CX, RE_MUL_CX, RE_SUB, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_GE_RE_IM, .. } := D.ts.cn.cxg
  let { IM_VSUM, RE_VSUM, .. } := D.ts.cn.cxi
  let { INTEGRAL_COMPONENT, .. } := D.ts.cn.qintegration
  let { IMP_REWRITE_TAC, .. } := D.ts.cn.ms.ig
  let { INTEGRABLE_COMPONENTWISE, .. } := D.ts.cn.ms.qintegration2
  let { SUM_EQ_NUMSEG, .. } := D.ts.cn.ms.qsession
  let { ARITH_RULE, MESON_TAC, NUM_REDUCE_CONV, .. } := D.ts.cn.cx.cvx
  let { FORALL_2, LE_0, .. } := D.ts.cn.cx.cpx
  let { AND_FORALL_THM, ARITH, DIMINDEX_2, FINITE_NUMSEG, .. } := D.ts.cn.cx.cvx.core1
  let { IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { MONO_EXISTS, MONO_FORALL, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LET_TRANS, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_LE, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { dist, .. } := D.ts.cn.cx.cvx.vec4
  let { LIM_AT, .. } := D.ts.cn.ms.ig.dv.qtopology1
  -- @@SCOPE END

  let REAL_EULER_MACLAURIN_ANTIDERIVATIVE ← prove
   r"!f m n p.
     m <= n /\
     (!k x. k <= 2 * p + 2 /\ x IN real_interval[&m,&n]
            ==> ((f k) has_real_derivative f (k + 1) x)
                (atreal x within real_interval [&m,&n]))
     ==> ((\x. bernoulli (2 * p + 1) (frac x) * f (2 * p + 2) x)
          real_integrable_on real_interval[&m,&n]) /\
         sum(m..n) (\i. f 1 (&i)) =
         (f 0 (&n) - f 0 (&m)) +
         (f 1 (&m) + f 1 (&n)) / &2 +
         sum (1..p) (\k. bernoulli (2 * k) (&0) / &(FACT(2 * k)) *
                         (f (2 * k) (&n) - f (2 * k) (&m))) +
         real_integral (real_interval [&m,&n])
                       (\x. bernoulli (2 * p + 1) (frac x) * f (2 * p + 2) x) /
         &(FACT(2 * p + 1))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. (f:num->real->real)(SUC n)", ← q r"m:num", ← q r"n:num",
                      ← q r"p:num"]
          REAL_EULER_MACLAURIN) THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"k <= 2 * p + 1 ==> SUC k <= 2 * p + 2"),
                  ← ARITH_RULE (← q r"SUC(k + 1) = SUC k + 1"),
                  ← ARITH_RULE (← q r"SUC(2 * p) + 1 = 2 * p + 2")] THEN
    CONV_TAC NUM_REDUCE_CONV THEN DISCH_THEN (SUBST1_TAC o CONJUNCT2) THEN
    MP_TAC (← ISPECL
     [← q r"f 0:real->real", ← q r"f (0 + 1):real->real", ← q r"&m", ← q r"&n"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    ASM_SIMP_TAC [REAL_OF_NUM_LE, LE_0] THEN CONV_TAC NUM_REDUCE_CONV THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC(2 * p) + 1 = 2 * p + 2")] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
    SIMP_TAC [← ARITH_RULE (← q r"1 <= k ==> SUC(2 * k - 1) = 2 * k")])

  let COMPLEX_EULER_MACLAURIN_ANTIDERIVATIVE ← (do
    let (lemma_re, lemma_im) ← CONJ_PAIR (← prove
     r"((f has_complex_derivative f') (at (Cx x))
        ==> ((Re o f o Cx) has_real_derivative (Re f')) (atreal x)) /\
       ((f has_complex_derivative f') (at (Cx x))
        ==> ((Im o f o Cx) has_real_derivative (Im f')) (atreal x))"
     (REPEAT GEN_TAC THEN CONJ_TAC THEN
      REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_AT, HAS_REAL_DERIVATIVE_ATREAL] THEN
      REWRITE_TAC [LIM_AT, REALLIM_ATREAL, o_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"y:real") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"Cx y")) THEN
      ASM_REWRITE_TAC [DIST_CX, dist] THEN
      REWRITE_TAC [← GSYM RE_SUB, ← GSYM IM_SUB, CX_SUB,
                   ← GSYM RE_DIV_CX, ← GSYM IM_SUB, ← GSYM IM_DIV_CX] THEN
      MESON_TAC [COMPLEX_NORM_GE_RE_IM, REAL_LET_TRANS]))
    let ilemma ← prove
     r"f integrable_on interval[lift a,lift b]
       ==> Re(integral (interval[lift a,lift b]) f) =
           real_integral (real_interval[a,b]) (\x. Re(f(lift x))) /\
           Im(integral (interval[lift a,lift b]) f) =
           real_integral (real_interval[a,b]) (\x. Im(f(lift x)))"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [RE_DEF, IM_DEF] THEN
      ASM_SIMP_TAC [INTEGRAL_COMPONENT] THEN
      IMP_REWRITE_TAC [REAL_INTEGRAL] THEN
      REWRITE_TAC [o_DEF, IMAGE_LIFT_REAL_INTERVAL, LIFT_DROP] THEN
      REWRITE_TAC [REAL_INTEGRABLE_ON] THEN
      REWRITE_TAC [o_DEF, IMAGE_LIFT_REAL_INTERVAL, LIFT_DROP] THEN
      RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_COMPONENTWISE]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [DIMINDEX_2, ARITH])
    prove
     r"!f m n p.
       m <= n /\
       (!k x. k <= 2 * p + 2 /\ &m <= x /\ x <= &n
              ==> ((f k) has_complex_derivative f (k + 1) (Cx x)) (at(Cx x)))
       ==> (\x. Cx(bernoulli (2 * p + 1) (frac(drop x))) *
                         f (2 * p + 2) (Cx(drop x)))
           integrable_on interval[lift(&m),lift(&n)] /\
           vsum(m..n) (\i. f 1 (Cx(&i))) =
           (f 0 (Cx(&n)) - f 0 (Cx(&m))) +
           (f 1 (Cx(&m)) + f 1 (Cx(&n))) / Cx(&2) +
           vsum (1..p) (\k. Cx(bernoulli (2 * k) (&0) / &(FACT(2 * k))) *
                            (f (2 * k) (Cx(&n)) - f (2 * k) (Cx(&m)))) +
           integral (interval[lift(&m),lift(&n)])
                    (\x. Cx(bernoulli (2 * p + 1) (frac(drop x))) *
                         f (2 * p + 2) (Cx(drop x))) /
           Cx(&(FACT(2 * p + 1)))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [COMPLEX_EQ] THEN
      MAP_EVERY (MP_TAC o C SPEC REAL_EULER_MACLAURIN_ANTIDERIVATIVE)
       [← q r"\n:num. (Im o f n o Cx)", ← q r"\n:num. (Re o f n o Cx)"] THEN
      REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"m:num", ← q r"n:num", ← q r"p:num"]) THEN
      ASM_SIMP_TAC [lemma_re, lemma_im, HAS_REAL_DERIVATIVE_ATREAL_WITHIN,
                    o_THM, IN_REAL_INTERVAL] THEN
      SIMP_TAC [RE_VSUM, IM_VSUM, FINITE_NUMSEG] THEN
      DISCH_THEN (CONJUNCTS_THEN (ASSUME_TAC o CONJUNCT1)) THEN
      SIMP_TAC [RE_DIV_CX, IM_DIV_CX, RE_VSUM, IM_VSUM, FINITE_NUMSEG, RE_ADD,
                RE_SUB, IM_ADD, IM_SUB, RE_MUL_CX, IM_MUL_CX, RE_CX, IM_CX] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [INTEGRABLE_COMPONENTWISE] THEN
        REWRITE_TAC [DIMINDEX_2, FORALL_2, ← GSYM RE_DEF, ← GSYM IM_DEF] THEN
        REWRITE_TAC [RE_MUL_CX, IM_MUL_CX] THEN
        ASM_REWRITE_TAC [← REWRITE_RULE [o_DEF] (← GSYM REAL_INTEGRABLE_ON),
                         ← GSYM IMAGE_LIFT_REAL_INTERVAL],
        SIMP_TAC [ilemma] THEN REWRITE_TAC [RE_MUL_CX, IM_MUL_CX, LIFT_DROP]]))

  pure { REAL_EULER_MACLAURIN_ANTIDERIVATIVE, COMPLEX_EULER_MACLAURIN_ANTIDERIVATIVE }

/- ------------------------------------------------------------------------- -/
/- Specific properties of complex measurable functions.                      -/
/- (realanalysis.ml 15708-15855)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBS where
  NEGLIGIBLE_REAL : thm
  MEASURABLE_ON_COMPLEX_MUL : thm
  MEASURABLE_ON_COMPLEX_INV : thm
  MEASURABLE_ON_COMPLEX_DIV : thm
  MEASURABLE_ON_CPRODUCT : thm
  MEASURABLE_ON_CLOG : thm
  MEASURABLE_ON_CPOW : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBS [HolBase] (D : RealAnalysisDeps) : ExceptT String IO RZBS := do
  -- @@SCOPE BEGIN
  let { CONTINUOUS_ON_CEXP, .. } := D.tsa
  let { CONTINUOUS_ON_CLOG, .. } := D.tsm
  let { cpow, .. } := D.tso
  let { CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
        LEBESGUE_MEASURABLE_SING, measurable_on, MEASURABLE_ON_CASES,
        MEASURABLE_ON_COMBINE, MEASURABLE_ON_COMPOSE_CONTINUOUS, MEASURABLE_ON_CONST_EQ,
        MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := D.qmeasure
  let { LIM_COMPLEX_INV, .. } := D.ts.knb
  let { CONTINUOUS_COMPLEX_INV_AT, CONTINUOUS_ON_COMPLEX_MUL, .. } := D.ts.knc
  let { LEBESGUE_MEASURABLE_UNIV, MEASURABLE_ON_UNIV, .. } := D.ts.qmeasure
  let { complex_div, IM_DEF, .. } := D.ts.cn.cxa
  let { COMPLEX_MUL_LZERO, COMPLEX_MUL_RID, .. } := D.ts.cn.cxb
  let { COMPLEX_VEC_0, .. } := D.ts.cn.cxc
  let { COMPLEX_NORM_NZ, .. } := D.ts.cn.cxf
  let { real, .. } := D.ts.cn.cxi
  let { CPRODUCT_CLAUSES, .. } := D.ts.cn.cxk
  let { MEASURABLE_ON_CONST, .. } := D.ts.cn.qmeasure
  let { NEGLIGIBLE_STANDARD_HYPERPLANE, NEGLIGIBLE_UNION, .. } := D.ts.cn.ms.qintegration3
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, .. } := D.ts.cn.cx.cvx
  let { CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP, ETA_AX, FINITE_INDUCT_STRONG, FORALL_AND_THM,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_INSERT_EMPTY,
        REAL_ARCH_INV, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_INV2, REAL_LE_TRANS, REAL_LT_INV_EQ, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, SKOLEM_THM,
        .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, SUBSET_UNIV, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  let { DIST_0, DIST_REFL, .. } := D.ts.cn.cx.cvx.vec1
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.ts.cn.cx.cvx.vec2
  let { VECTOR_SUB_EQ, .. } := D.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, SUBTOPOLOGY_UNIV, .. } := D.ts.cn.cx.cvx.met
  let { CLOSED_IN, .. } := D.ts.cn.cx.cvx.top1
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := D.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := D.ts.cn.cx.cvx.top3
  let { IN_BALL, LIM_SEQUENTIALLY, LINEAR_CONTINUOUS_ON, OPEN_BALL,
        .. } := D.ts.cn.cx.cvx.top4
  let { OPEN_UNIV, .. } := D.ts.cn.cx.cvx.top5
  let { CONTINUOUS_AT_WITHIN, CONTINUOUS_ON_EQ_CONTINUOUS_AT,
        .. } := D.ts.cn.ms.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_TRANSFORM, .. } := D.ts.cn.ms.ig.dv.qtopology2
  let { TIETZE_UNBOUNDED, .. } := D.ts.cn.ms.ig.dv.dg.qconvex
  let { OPEN_CLOSED, .. } := D.ts.cn.ms.ig.dv.dg.qtopology2
  let { SING_GSPEC, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let NEGLIGIBLE_REAL ← prove
   r"negligible real"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"real = {z | real z}")] THEN
    REWRITE_TAC [real, IM_DEF, NEGLIGIBLE_STANDARD_HYPERPLANE])

  let MEASURABLE_ON_COMPLEX_MUL ← prove
   r"!f g:real^N->complex s.
         f measurable_on s /\ g measurable_on s
         ==> (\x. f x * g x) measurable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_COMBINE THEN
    ASM_REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_MUL_LZERO] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
    CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  let MEASURABLE_ON_COMPLEX_INV ← prove
   r"!f:real^N->real^2.
     f measurable_on (:real^N) /\ negligible {x | f x = Cx(&0)}
     ==> (\x. inv(f x)) measurable_on (:real^N)"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [measurable_on, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"g:num->real^N->complex"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"k UNION {x:real^N | f x = Cx(&0)}") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_UNION] THEN
    SUBGOAL_THEN
     (← q r"!n. ?h. h continuous_on (:real^N) /\
              !x. x IN {x | g n x IN (:complex) DIFF ball(Cx(&0),inv(&n + &1))}
                  ==> (h:real^N->complex) x = inv(g n x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC TIETZE_UNBOUNDED THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
        REWRITE_TAC [← GSYM OPEN_CLOSED, OPEN_BALL, ETA_AX] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV],
        REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
        GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC CONTINUOUS_AT_WITHIN THEN
        MATCH_MP_TAC CONTINUOUS_COMPLEX_INV_AT THEN CONJ_TAC THENL
         [REWRITE_TAC [ETA_AX] THEN
          ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV],
          RULE_ASSUM_TAC (REWRITE_RULE [IN_ELIM_THM, IN_UNIV, IN_DIFF]) THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [IN_BALL]) THEN
          SIMP_TAC [CONTRAPOS_THM, DIST_REFL, REAL_LT_INV_EQ] THEN
          REAL_ARITH_TAC]],
      REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"h:num->real^N->complex") THEN
      REWRITE_TAC [FORALL_AND_THM, IN_ELIM_THM, IN_DIFF, IN_UNION, IN_UNIV] THEN
      REWRITE_TAC [IN_BALL, DE_MORGAN_THM, REAL_NOT_LT] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN
      STRIP_TAC THEN MATCH_MP_TAC LIM_TRANSFORM THEN
      EXISTS_TAC (← q r"\n. inv((g:num->real^N->complex) n x)") THEN
      ASM_SIMP_TAC [o_DEF, LIM_COMPLEX_INV] THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      SUBGOAL_THEN (← q r"&0 < norm((f:real^N->complex) x)") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [COMPLEX_NORM_NZ], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:real^N->complex) x) / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") (LABEL_TAC "*")) THEN
      MP_TAC (← SPEC (← q r"norm((f:real^N->complex) x) / &2") REAL_ARCH_INV) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"N1 + N2 + 1") THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN CONV_TAC SYM_CONV THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [← GSYM COMPLEX_VEC_0, DIST_0] THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"n:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"dist(g,f) < norm(f) / &2 ==> norm(f) / &2 <= norm g"))) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < y ==> z <= x ==> z <= y"))) THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      ASM_REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC])

  let MEASURABLE_ON_COMPLEX_DIV ← (do
    let lemma ← prove
     r"!f g:real^N->complex.
          f measurable_on (:real^N) /\ g measurable_on (:real^N) /\
          negligible {x | g(x) = Cx(&0)}
          ==> (\x. f(x) / g(x)) measurable_on (:real^N)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [complex_div] THEN
      ASM_SIMP_TAC [MEASURABLE_ON_COMPLEX_MUL, MEASURABLE_ON_COMPLEX_INV])
    prove
     r"!f g:real^N->complex s.
          f measurable_on s /\ g measurable_on (:real^N) /\
          negligible {x | g(x) = Cx(&0)}
          ==> (\x. f(x) / g(x)) measurable_on s"
     (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
      REWRITE_TAC [IN_UNIV, ETA_AX] THEN DISCH_THEN (MP_TAC o MATCH_MP lemma) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, complex_div, COMPLEX_VEC_0] THEN
      GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [COMPLEX_MUL_LZERO]))

  let MEASURABLE_ON_CPRODUCT ← prove
   r"!f:A->real^N->complex s t.
         FINITE t /\ (t = {} ==> lebesgue_measurable s) /\
         (!i. i IN t ==> f i measurable_on s)
         ==> (\x. cproduct t (\i. f i x)) measurable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [CPRODUCT_CLAUSES, MEASURABLE_ON_CONST_EQ] THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_INSERT_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_SIMP_TAC [CPRODUCT_CLAUSES, COMPLEX_MUL_RID, ETA_AX] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPLEX_MUL THEN ASM_REWRITE_TAC [ETA_AX] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  let MEASURABLE_ON_CLOG ← prove
   r"!s. lebesgue_measurable s ==> clog measurable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"(:complex)") THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, LEBESGUE_MEASURABLE_UNIV] THEN
    MATCH_MP_TAC
      CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"real") THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV, NEGLIGIBLE_REAL] THEN
    MATCH_MP_TAC CONTINUOUS_ON_CLOG THEN
    REWRITE_TAC [← SET_RULE
      (← q r"(z:complex) IN UNIV DIFF (r:complex->bool) <=> ~(r z)")] THEN
    REWRITE_TAC [real] THEN MESON_TAC [])

  let MEASURABLE_ON_CPOW ← prove
   r"!s w. lebesgue_measurable s ==> (\z. z cpow w) measurable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"(:complex)") THEN
    ASM_REWRITE_TAC [SUBSET_UNIV, LEBESGUE_MEASURABLE_UNIV] THEN
    REWRITE_TAC [cpow] THEN MATCH_MP_TAC MEASURABLE_ON_CASES THEN
    ASM_REWRITE_TAC [MEASURABLE_ON_CONST] THEN
    REWRITE_TAC [SING_GSPEC, LEBESGUE_MEASURABLE_SING] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS THEN
    REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPLEX_MUL THEN
    REWRITE_TAC [MEASURABLE_ON_CONST] THEN
    SIMP_TAC [MEASURABLE_ON_CLOG, LEBESGUE_MEASURABLE_UNIV])

  pure { NEGLIGIBLE_REAL, MEASURABLE_ON_COMPLEX_MUL, MEASURABLE_ON_COMPLEX_INV,
         MEASURABLE_ON_COMPLEX_DIV, MEASURABLE_ON_CPRODUCT, MEASURABLE_ON_CLOG,
         MEASURABLE_ON_CPOW }

/- ------------------------------------------------------------------------- -/
/- Measurable real->real functions.                                          -/
/- (realanalysis.ml 15856-16101)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBT where
  real_measurable_on : thm
  real_lebesgue_measurable : thm
  REAL_MEASURABLE_ON_UNIV : thm
  REAL_LEBESGUE_MEASURABLE : thm
  REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE : thm
  REAL_MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE : thm
  REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE : thm
  INTEGRABLE_SUBINTERVALS_IMP_REAL_MEASURABLE : thm
  INTEGRABLE_IMP_REAL_MEASURABLE : thm
  ABSOLUTELY_REAL_INTEGRABLE_REAL_MEASURABLE : thm
  CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET : thm
  REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS : thm
  REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_0 : thm
  REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL : thm
  REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET : thm
  REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0 : thm
  CONTINUOUS_IMP_REAL_MEASURABLE_ON : thm
  REAL_MEASURABLE_ON_CONST : thm
  REAL_MEASURABLE_ON_0 : thm
  REAL_MEASURABLE_ON_LMUL : thm
  REAL_MEASURABLE_ON_RMUL : thm
  REAL_MEASURABLE_ON_NEG : thm
  REAL_MEASURABLE_ON_NEG_EQ : thm
  REAL_MEASURABLE_ON_ABS : thm
  REAL_MEASURABLE_ON_ADD : thm
  REAL_MEASURABLE_ON_SUB : thm
  REAL_MEASURABLE_ON_MAX : thm
  REAL_MEASURABLE_ON_MIN : thm
  REAL_MEASURABLE_ON_MUL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBT [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZAK : RZAK) (BRZAM : RZAM) : ExceptT String IO RZBT := do
  -- @@SCOPE BEGIN
  let { REAL_CLOSED, .. } := BRZA
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { ABSOLUTELY_REAL_INTEGRABLE_ON, absolutely_real_integrable_on, REAL_INTEGRABLE_ON,
        .. } := BRZAK
  let { REAL_INTEGRABLE_SPIKE, .. } := BRZAM
  let { IMAGE_LIFT_REAL_INTERVAL, INTERVAL_REAL_INTERVAL, .. } := D.qtopology
  let { CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET, INTEGRABLE_IMP_MEASURABLE,
        INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE, lebesgue_measurable,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE, MEASURABLE_ON_ADD,
        MEASURABLE_ON_CMUL, MEASURABLE_ON_COMPOSE_CONTINUOUS,
        MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET,
        MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0,
        MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL, MEASURABLE_ON_DROP_MUL,
        MEASURABLE_ON_MAX, MEASURABLE_ON_MIN, MEASURABLE_ON_NEG, MEASURABLE_ON_NORM,
        MEASURABLE_ON_SUB, .. } := D.qmeasure
  let { MEASURABLE_ON_UNIV, .. } := D.ts.qmeasure
  let { CONTINUOUS_IMP_MEASURABLE_ON, MEASURABLE_ON_CONST, .. } := D.ts.cn.qmeasure
  let { IMAGE_LIFT_UNIV, IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_MESON_TAC, new_definition, parse_as_infix, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { indicator, .. } := D.ts.cn.ms.ig.qvec
  let { CART_EQ, COND_ID, COND_RAND, DIMINDEX_1, EQ_IMP, ETA_AX,
        .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, IMP_IMP, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { LAMBDA_BETA, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, REAL_NEG_NEG, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_1, FORALL_DROP, FORALL_LIFT, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  parse_as_infix ("real_measurable_on", (12, "right"))

  let real_measurable_on ← new_definition
   r"f real_measurable_on s <=>
        (lift o f o drop) measurable_on (IMAGE lift s)"

  let real_lebesgue_measurable ← new_definition
   r"real_lebesgue_measurable s <=>
      (\x. if x IN s then &1 else &0) real_measurable_on (:real)"

  let REAL_MEASURABLE_ON_UNIV ← prove
   r"(\x.  if x IN s then f(x) else &0) real_measurable_on (:real) <=>
   f real_measurable_on s"
   (REWRITE_TAC [real_measurable_on, o_DEF, IMAGE_LIFT_UNIV] THEN
    SIMP_TAC [COND_RAND, LIFT_NUM, MEASURABLE_ON_UNIV, ← GSYM IN_IMAGE_LIFT_DROP])

  let REAL_LEBESGUE_MEASURABLE ← prove
   r"!s. real_lebesgue_measurable s <=> lebesgue_measurable (IMAGE lift s)"
   (REWRITE_TAC [real_lebesgue_measurable, lebesgue_measurable, COND_RAND,
      COND_RAND, real_measurable_on, indicator, IMAGE_LIFT_UNIV, o_DEF] THEN
    REWRITE_TAC [LIFT_NUM, IN_IMAGE_LIFT_DROP])

  let REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE ← prove
   r"!f g s.
        f real_measurable_on s /\
        g real_integrable_on s /\
        (!x. x IN s ==> abs(f x) <= g x)
        ==> f real_integrable_on s"
   (REWRITE_TAC [real_measurable_on, REAL_INTEGRABLE_ON] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"lift o g o drop") THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, NORM_LIFT])

  let REAL_MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE ← prove
   r"!f g s k.
      f real_measurable_on s /\ g real_integrable_on s /\ real_negligible k /\
      (!x. x IN s DIFF k ==> abs(f x) <= g x)
      ==> f real_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC
     (← q r"\x. if x IN k then abs(f x) else (g:real->real) x") THEN
    ASM_SIMP_TAC [COND_RAND, IN_DIFF, LIFT_DROP, REAL_LE_REFL, COND_ID] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] REAL_INTEGRABLE_SPIKE) THEN
    MAP_EVERY EXISTS_TAC [← q r"g:real->real", ← q r"k:real->bool"] THEN
    ASM_SIMP_TAC [IN_DIFF])

  let REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE ← prove
   r"!f g s.
        f real_measurable_on s /\
        g real_integrable_on s /\
        (!x. x IN s ==> abs(f x) <= g x)
        ==> f absolutely_real_integrable_on s"
   (REWRITE_TAC [real_measurable_on, REAL_INTEGRABLE_ON,
                 ABSOLUTELY_REAL_INTEGRABLE_ON] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC (← q r"lift o g o drop") THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, NORM_LIFT])

  let INTEGRABLE_SUBINTERVALS_IMP_REAL_MEASURABLE ← prove
   r"!f. (!a b. f real_integrable_on real_interval[a,b])
       ==> f real_measurable_on (:real)"
   (REWRITE_TAC [real_measurable_on, REAL_INTEGRABLE_ON, IMAGE_LIFT_UNIV] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE THEN
    ASM_REWRITE_TAC [FORALL_LIFT])

  let INTEGRABLE_IMP_REAL_MEASURABLE ← prove
   r"!f:real->real s.
        f real_integrable_on s ==> f real_measurable_on s"
   (REWRITE_TAC [real_measurable_on, REAL_INTEGRABLE_ON] THEN
    REWRITE_TAC [INTEGRABLE_IMP_MEASURABLE])

  let ABSOLUTELY_REAL_INTEGRABLE_REAL_MEASURABLE ← prove
   r"!f s. f absolutely_real_integrable_on s <=>
         f real_measurable_on s /\ (\x. abs(f x)) real_integrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_real_integrable_on] THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> b) /\ (b /\ c ==> a) ==> (a /\ c <=> b /\ c)")) THEN
    REWRITE_TAC [INTEGRABLE_IMP_REAL_MEASURABLE] THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"\x. abs((f:real->real) x)") THEN ASM_REWRITE_TAC [REAL_LE_REFL])

  let CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET ← prove
   r"!f s. f real_continuous_on s /\ real_closed s ==> f real_measurable_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, real_measurable_on, REAL_CLOSED] THEN
    REWRITE_TAC [CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET, IMAGE_LIFT_UNIV])

  let REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS ← prove
   r"!f g. f real_measurable_on (:real) /\ g real_continuous_on (:real)
         ==> (g o f) real_measurable_on (:real)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_CONTINUOUS_ON, real_measurable_on] THEN
    REWRITE_TAC [IMAGE_LIFT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_COMPOSE_CONTINUOUS) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_0 ← prove
   r"!f:real->real g:real->real s.
        f real_measurable_on s /\ g real_continuous_on (:real) /\ g(&0) = &0
        ==> (g o f) real_measurable_on s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    DISCH_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_DEF] THEN ASM_MESON_TAC [])

  let REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL ← prove
   r"!f:real->real g:real->real a b.
        f real_measurable_on (:real) /\
        (!x. f(x) IN real_interval(a,b)) /\
        g real_continuous_on real_interval(a,b)
        ==> (g o f) real_measurable_on (:real)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift o g o drop", ← q r"lift a",
                      ← q r"lift b"]
          MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL) THEN
    REWRITE_TAC [real_measurable_on, REAL_CONTINUOUS_ON] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IMAGE_LIFT_UNIV, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM FORALL_DROP] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, LIFT_DROP] THEN ASM SET_TAC [])

  let REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET ← prove
   r"!f:real->real g:real->real s.
        real_closed s /\
        f real_measurable_on (:real) /\
        (!x. f(x) IN s) /\
        g real_continuous_on s
        ==> (g o f) real_measurable_on (:real)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift o g o drop", ← q r"IMAGE lift s"]
          MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET) THEN
    REWRITE_TAC [real_measurable_on, REAL_CONTINUOUS_ON, REAL_CLOSED] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IMAGE_LIFT_UNIV, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM FORALL_DROP] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, LIFT_DROP] THEN ASM SET_TAC [])

  let REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0 ← prove
   r"!f:real->real g:real->real s t.
        real_closed s /\
        f real_measurable_on t /\
        (!x. f(x) IN s) /\
        g real_continuous_on s /\
        &0 IN s /\ g(&0) = &0
        ==> (g o f) real_measurable_on t"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift o g o drop",
                      ← q r"IMAGE lift s", ← q r"IMAGE lift t"]
          MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0) THEN
    REWRITE_TAC [real_measurable_on, REAL_CONTINUOUS_ON, REAL_CLOSED] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IMAGE_LIFT_UNIV, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM FORALL_DROP] THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE, LIFT_DROP, ← GSYM LIFT_NUM])

  let CONTINUOUS_IMP_REAL_MEASURABLE_ON ← prove
   r"!f. f real_continuous_on (:real) ==> f real_measurable_on (:real)"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, real_measurable_on] THEN
    REWRITE_TAC [CONTINUOUS_IMP_MEASURABLE_ON, IMAGE_LIFT_UNIV])

  let REAL_MEASURABLE_ON_CONST ← prove
   r"!k:real. (\x. k) real_measurable_on (:real)"
   (SIMP_TAC [real_measurable_on, o_DEF, MEASURABLE_ON_CONST, IMAGE_LIFT_UNIV])

  let REAL_MEASURABLE_ON_0 ← prove
   r"!s. (\x. &0) real_measurable_on s"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [REAL_MEASURABLE_ON_CONST, COND_ID])

  let REAL_MEASURABLE_ON_LMUL ← prove
   r"!c f s. f real_measurable_on s ==> (\x. c * f x) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real") o MATCH_MP MEASURABLE_ON_CMUL) THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_DROP])

  let REAL_MEASURABLE_ON_RMUL ← prove
   r"!c f s. f real_measurable_on s ==> (\x. f x * c) real_measurable_on s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [REAL_MEASURABLE_ON_LMUL])

  let REAL_MEASURABLE_ON_NEG ← prove
   r"!f s. f real_measurable_on s ==> (\x. --(f x)) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_NEG) THEN
    REWRITE_TAC [o_DEF, LIFT_NEG, LIFT_DROP])

  let REAL_MEASURABLE_ON_NEG_EQ ← prove
   r"!f s. (\x. --(f x)) real_measurable_on s <=> f real_measurable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_MEASURABLE_ON_NEG) THEN
    REWRITE_TAC [REAL_NEG_NEG, ETA_AX])

  let REAL_MEASURABLE_ON_ABS ← prove
   r"!f s. f real_measurable_on s ==> (\x. abs(f x)) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_NORM) THEN
    REWRITE_TAC [o_DEF, NORM_LIFT])

  let REAL_MEASURABLE_ON_ADD ← prove
   r"!f g s. f real_measurable_on s /\ g real_measurable_on s
           ==> (\x. f x + g x) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_ADD) THEN
    REWRITE_TAC [o_DEF, LIFT_ADD, LIFT_DROP])

  let REAL_MEASURABLE_ON_SUB ← prove
   r"!f g s.
        f real_measurable_on s /\ g real_measurable_on s
        ==> (\x. f x - g x) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_SUB) THEN
    REWRITE_TAC [o_DEF, LIFT_SUB, LIFT_DROP])

  let REAL_MEASURABLE_ON_MAX ← prove
   r"!f g s.
        f real_measurable_on s /\ g real_measurable_on s
        ==> (\x. max (f x) (g x)) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_MAX) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    SIMP_TAC [FUN_EQ_THM, o_THM, CART_EQ, LAMBDA_BETA, DIMINDEX_1, FORALL_1] THEN
    REWRITE_TAC [← GSYM drop, LIFT_DROP])

  let REAL_MEASURABLE_ON_MIN ← prove
   r"!f g s.
        f real_measurable_on s /\ g real_measurable_on s
        ==> (\x. min (f x) (g x)) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_MIN) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    SIMP_TAC [FUN_EQ_THM, o_THM, CART_EQ, LAMBDA_BETA, DIMINDEX_1, FORALL_1] THEN
    REWRITE_TAC [← GSYM drop, LIFT_DROP])

  let REAL_MEASURABLE_ON_MUL ← prove
   r"!f g s.
        f real_measurable_on s /\ g real_measurable_on s
        ==> (\x. f x * g x) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_DROP_MUL) THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_DROP])

  pure { real_measurable_on, real_lebesgue_measurable, REAL_MEASURABLE_ON_UNIV,
         REAL_LEBESGUE_MEASURABLE,
         REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE,
         REAL_MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE,
         REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
         INTEGRABLE_SUBINTERVALS_IMP_REAL_MEASURABLE, INTEGRABLE_IMP_REAL_MEASURABLE,
         ABSOLUTELY_REAL_INTEGRABLE_REAL_MEASURABLE,
         CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET,
         REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS, REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_0,
         REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL,
         REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET,
         REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0,
         CONTINUOUS_IMP_REAL_MEASURABLE_ON, REAL_MEASURABLE_ON_CONST,
         REAL_MEASURABLE_ON_0, REAL_MEASURABLE_ON_LMUL, REAL_MEASURABLE_ON_RMUL,
         REAL_MEASURABLE_ON_NEG, REAL_MEASURABLE_ON_NEG_EQ, REAL_MEASURABLE_ON_ABS,
         REAL_MEASURABLE_ON_ADD, REAL_MEASURABLE_ON_SUB, REAL_MEASURABLE_ON_MAX,
         REAL_MEASURABLE_ON_MIN, REAL_MEASURABLE_ON_MUL }

/- ------------------------------------------------------------------------- -/
/- Measurable real->real functions, continued.                               -/
/- (realanalysis.ml 16102-16215)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBU where
  REAL_MEASURABLE_ON_SPIKE_SET : thm
  REAL_MEASURABLE_ON_RESTRICT : thm
  REAL_MEASURABLE_ON_LIMIT : thm
  ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT : thm
  REAL_COMPLEX_MEASURABLE_ON : thm
  REAL_MEASURABLE_ON_INV : thm
  REAL_MEASURABLE_ON_DIV : thm
  REAL_MEASURABLE_ON_RPOW : thm
  MEASURABLE_ON_LIFT_RPOW : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBU [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZS : RZS) (BRZAK : RZAK) (BRZAL : RZAL) (BRZAR : RZAR) (BRZBS : RZBS) (BRZBT : RZBT) : ExceptT String IO RZBU := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { REAL_CONTINUOUS_ON_RPOW, .. } := BRZS
  let { real_negligible, .. } := BRZAK
  let { REAL_INTEGRABLE_LMUL, .. } := BRZAL
  let { ABSOLUTELY_REAL_INTEGRABLE_ABS, ABSOLUTELY_REAL_INTEGRABLE_IMP_INTEGRABLE,
        .. } := BRZAR
  let { MEASURABLE_ON_COMPLEX_DIV, MEASURABLE_ON_COMPLEX_INV, .. } := BRZBS
  let { INTEGRABLE_IMP_REAL_MEASURABLE, REAL_LEBESGUE_MEASURABLE,
        REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
        real_measurable_on, REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_0,
        REAL_MEASURABLE_ON_MUL, REAL_MEASURABLE_ON_UNIV, .. } := BRZBT
  let { RPOW_ZERO, .. } := D.tsab
  let { REAL_BOUNDED_POS, .. } := D.qmetric
  let { MEASURABLE_ON_COMPONENTWISE, MEASURABLE_ON_COMPOSE_CONTINUOUS_0,
        MEASURABLE_ON_LIMIT, MEASURABLE_ON_RESTRICT, .. } := D.qmeasure
  let { MEASURABLE_ON_SPIKE_SET, MEASURABLE_ON_UNIV, .. } := D.ts.qmeasure
  let { IM_DEF, RE_DEF, .. } := D.ts.cn.cxa
  let { COMPLEX_VEC_0, CX_DIV, CX_INJ, CX_INV, IM_CX, RE_CX, .. } := D.ts.cn.cxc
  let { MEASURABLE_ON_CONST, .. } := D.ts.cn.qmeasure
  let { NEGLIGIBLE_SUBSET, .. } := D.ts.cn.ms.qintegration3
  let { IMAGE_LIFT_UNIV, IN_IMAGE_LIFT_DROP, .. } := D.ts.cn.ms.qvec
  let { ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { FORALL_2, .. } := D.ts.cn.cx.cpx
  let { COND_ID, COND_RAND, COND_RATOR, DIMINDEX_2, EQ_IMP, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ_ALT, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, REAL_ABS_MUL, REAL_ABS_POS,
        .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_RMUL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.ts.cn.cx.cvx.core4
  let { o_DEF, o_THM, SURJECTIVE_IMAGE_EQ, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_NUM, .. } := D.ts.cn.cx.cvx.vec2
  -- @@SCOPE END

  let REAL_MEASURABLE_ON_SPIKE_SET ← prove
   r"!f:real->real s t.
        real_negligible (s DIFF t UNION t DIFF s)
        ==> f real_measurable_on s
            ==> f real_measurable_on t"
   (REWRITE_TAC [real_measurable_on, real_negligible] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET THEN POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    SET_TAC [])

  let REAL_MEASURABLE_ON_RESTRICT ← prove
   r"!f s. f real_measurable_on (:real) /\
         real_lebesgue_measurable s
         ==> (\x. if x IN s then f(x) else &0) real_measurable_on (:real)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE,
                 IMAGE_LIFT_UNIV] THEN
    REWRITE_TAC [o_DEF, COND_RAND, LIFT_NUM, ← GSYM IN_IMAGE_LIFT_DROP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_RESTRICT) THEN
    REWRITE_TAC [])

  let REAL_MEASURABLE_ON_LIMIT ← prove
   r"!f g s k.
        (!n. (f n) real_measurable_on s) /\
        real_negligible k /\
        (!x. x IN s DIFF k ==> ((\n. f n x) ---> g x) sequentially)
        ==> g real_measurable_on s"
   (REWRITE_TAC [real_measurable_on, real_negligible, TENDSTO_REAL] THEN
    REWRITE_TAC [o_DEF] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN MAP_EVERY EXISTS_TAC
     [← q r"\n:num. lift o f n o drop", ← q r"IMAGE lift k"] THEN
    ASM_REWRITE_TAC [] THEN
    SIMP_TAC [LIFT_DROP, ← SET_RULE (← q r"(!x. drop(lift x) = x)
              ==> IMAGE lift s DIFF IMAGE lift t = IMAGE lift (s DIFF t)")] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, o_DEF, LIFT_DROP])

  let ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT ← prove
   r"!f g s. f real_measurable_on s /\ real_bounded (IMAGE f s) /\
           g absolutely_real_integrable_on s
           ==> (\x. f x * g x) absolutely_real_integrable_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_BOUNDED_POS]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN MATCH_MP_TAC
     REAL_MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC (← q r"\x. B * abs((g:real->real) x)") THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_ON_MUL, INTEGRABLE_IMP_REAL_MEASURABLE,
      ABSOLUTELY_REAL_INTEGRABLE_IMP_INTEGRABLE, REAL_INTEGRABLE_LMUL,
      ABSOLUTELY_REAL_INTEGRABLE_ABS] THEN
    ASM_SIMP_TAC [REAL_ABS_MUL, REAL_LE_RMUL, REAL_ABS_POS])

  let REAL_COMPLEX_MEASURABLE_ON ← prove
   r"!f s. f real_measurable_on s <=>
         (Cx o f o drop) measurable_on (IMAGE lift s)"
   (ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV,
                      ← GSYM MEASURABLE_ON_UNIV] THEN
    ONCE_REWRITE_TAC [MEASURABLE_ON_COMPONENTWISE] THEN
    REWRITE_TAC [FORALL_2, DIMINDEX_2, ← GSYM RE_DEF, ← GSYM IM_DEF] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [real_measurable_on, IMAGE_LIFT_UNIV] THEN
    REWRITE_TAC [o_DEF, IN_IMAGE_LIFT_DROP] THEN
    REWRITE_TAC [COND_RAND, COND_RATOR, LIFT_NUM, COMPLEX_VEC_0] THEN
    REWRITE_TAC [RE_CX, IM_CX, COND_ID, MEASURABLE_ON_CONST, LIFT_NUM])

  let REAL_MEASURABLE_ON_INV ← prove
   r"!f. f real_measurable_on (:real) /\ real_negligible {x | f x = &0}
       ==> (\x. inv(f x)) real_measurable_on (:real)"
   (GEN_TAC THEN REWRITE_TAC [REAL_COMPLEX_MEASURABLE_ON] THEN
    REWRITE_TAC [o_DEF, CX_INV, IMAGE_LIFT_UNIV] THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPLEX_INV THEN ASM_REWRITE_TAC [CX_INJ] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_negligible]) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_DIV ← prove
   r"!f g. f real_measurable_on s /\ g real_measurable_on (:real) /\
         real_negligible {x | g(x) = &0}
         ==> (\x. f(x) / g(x)) real_measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_COMPLEX_MEASURABLE_ON] THEN
    REWRITE_TAC [o_DEF, CX_DIV, IMAGE_LIFT_UNIV] THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPLEX_DIV THEN ASM_REWRITE_TAC [CX_INJ] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_negligible]) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_RPOW ← prove
   r"!f r s. f real_measurable_on s /\ &0 < r
           ==> (\x. f x rpow r) real_measurable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. f x rpow r) = (\x. x rpow r) o (f:real->real)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC REAL_MEASURABLE_ON_COMPOSE_CONTINUOUS_0 THEN
    ASM_SIMP_TAC [REAL_CONTINUOUS_ON_RPOW, RPOW_ZERO,
                  REAL_LT_IMP_LE, REAL_LT_IMP_NZ])

  let MEASURABLE_ON_LIFT_RPOW ← prove
   r"!f:real^N->real s y.
        (\x. lift(f x)) measurable_on s /\ &0 < y
        ==> (\x. lift(f x rpow y)) measurable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x:real^N. lift(f x rpow y)) =
      (lift o (\w. w rpow y) o drop) o (\x. lift(f x))")
    SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_THM, LIFT_DROP], ALL_TAC] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS_0 THEN REPEAT CONJ_TAC THENL
     [ASM_REWRITE_TAC [],
      ONCE_REWRITE_TAC [← GSYM IMAGE_LIFT_UNIV] THEN
      REWRITE_TAC [← GSYM REAL_CONTINUOUS_ON] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_ON_RPOW THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [o_DEF, DROP_VEC, RPOW_ZERO, LIFT_NUM, REAL_LT_IMP_NZ]])

  pure { REAL_MEASURABLE_ON_SPIKE_SET, REAL_MEASURABLE_ON_RESTRICT,
         REAL_MEASURABLE_ON_LIMIT, ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT,
         REAL_COMPLEX_MEASURABLE_ON, REAL_MEASURABLE_ON_INV, REAL_MEASURABLE_ON_DIV,
         REAL_MEASURABLE_ON_RPOW, MEASURABLE_ON_LIFT_RPOW }

/- ------------------------------------------------------------------------- -/
/- Properties of real Lebesgue measurable sets.                              -/
/- (realanalysis.ml 16216-16408)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBV where
  REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE : thm
  REAL_LEBESGUE_MEASURABLE_EMPTY : thm
  REAL_LEBESGUE_MEASURABLE_UNIV : thm
  REAL_LEBESGUE_MEASURABLE_COMPACT : thm
  REAL_LEBESGUE_MEASURABLE_INTERVAL : thm
  REAL_LEBESGUE_MEASURABLE_INTER : thm
  REAL_LEBESGUE_MEASURABLE_UNION : thm
  REAL_LEBESGUE_MEASURABLE_COMPL : thm
  REAL_LEBESGUE_MEASURABLE_DIFF : thm
  REAL_LEBESGUE_MEASURABLE_ON_SUBINTERVALS : thm
  REAL_LEBESGUE_MEASURABLE_CLOSED : thm
  REAL_LEBESGUE_MEASURABLE_OPEN : thm
  REAL_LEBESGUE_MEASURABLE_UNIONS : thm
  REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT : thm
  REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS : thm
  REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS : thm
  REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT : thm
  REAL_LEBESGUE_MEASURABLE_INTERS : thm
  REAL_LEBESGUE_MEASURABLE_IFF_MEASURABLE : thm
  REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  REAL_MEASURABLE_ON_MEASURABLE_SUBSET : thm
  REAL_CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET : thm
  REAL_CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  REAL_MEASURABLE_ON_CASES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBV [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZJ : RZJ) (BRZAK : RZAK) (BRZAS : RZAS) (BRZAW : RZAW) (BRZBT : RZBT) (BRZBU : RZBU) : ExceptT String IO RZBV := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, REAL_CLOSED, REAL_OPEN, .. } := BRZA
  let { REAL_CONTINUOUS_ON, .. } := BRZJ
  let { real_negligible, .. } := BRZAK
  let { REAL_MEASURABLE_MEASURABLE, REAL_MEASURABLE_REAL_INTERVAL, .. } := BRZAS
  let { REAL_MEASURABLE_COMPACT, .. } := BRZAW
  let { REAL_LEBESGUE_MEASURABLE, real_measurable_on, REAL_MEASURABLE_ON_ADD,
        REAL_MEASURABLE_ON_UNIV, .. } := BRZBT
  let { REAL_MEASURABLE_ON_RESTRICT, .. } := BRZBU
  let { IMAGE_DROP_INTERVAL, .. } := D.qtopology
  let { IMAGE_DIFF_INJ, .. } := D.qsession
  let { CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
        CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET, LEBESGUE_MEASURABLE_CLOSED,
        LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
        LEBESGUE_MEASURABLE_EMPTY, LEBESGUE_MEASURABLE_IFF_MEASURABLE,
        LEBESGUE_MEASURABLE_ON_SUBINTERVALS, LEBESGUE_MEASURABLE_OPEN,
        LEBESGUE_MEASURABLE_UNION, MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := D.qmeasure
  let { LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_UNIV, .. } := D.ts.qmeasure
  let { NUM_COUNTABLE, .. } := D.ts.cn.ms.qcard
  let { INTERS_UNIONS, .. } := D.ts.cn.ms.qsession
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { IMAGE_UNIONS, .. } := D.ts.cn.ms.ig.qsession
  let { EQ_IMP, FINITE_INDUCT_STRONG, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMP_CONJ, IN_DIFF,
        .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNIV, REAL_ADD_LID, REAL_ADD_RID,
        .. } := D.ts.cn.cx.cvx.core3
  let { SIMPLE_IMAGE, .. } := D.ts.cn.cx.cvx.core5
  let { UNIONS_0, UNIONS_INSERT, .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ts.cn.cx.cvx.lib
  let { FORALL_DROP, LIFT_DROP, LIFT_EQ, .. } := D.ts.cn.cx.cvx.vec2
  let { COUNTABLE_AS_IMAGE, .. } := D.ts.cn.ms.ig.dv.dg.qcard
  let { FINITE_IMP_COUNTABLE, .. } := D.ts.cn.ms.ig.dv.dg.pt.qcard
  -- @@SCOPE END

  let REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE ← prove
   r"!s. real_measurable s ==> real_lebesgue_measurable s"
   (REWRITE_TAC [REAL_LEBESGUE_MEASURABLE, REAL_MEASURABLE_MEASURABLE,
                 MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let REAL_LEBESGUE_MEASURABLE_EMPTY ← prove
   r"real_lebesgue_measurable {}"
   (REWRITE_TAC [REAL_LEBESGUE_MEASURABLE, IMAGE_CLAUSES,
                 LEBESGUE_MEASURABLE_EMPTY])

  let REAL_LEBESGUE_MEASURABLE_UNIV ← prove
   r"real_lebesgue_measurable (:real)"
   (REWRITE_TAC [REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
                 LEBESGUE_MEASURABLE_UNIV])

  let REAL_LEBESGUE_MEASURABLE_COMPACT ← prove
   r"!s. real_compact s ==> real_lebesgue_measurable s"
   (SIMP_TAC [REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE,
              REAL_MEASURABLE_COMPACT])

  let REAL_LEBESGUE_MEASURABLE_INTERVAL ← prove
   r"(!a b. real_lebesgue_measurable(real_interval[a,b])) /\
   (!a b. real_lebesgue_measurable(real_interval(a,b)))"
   (SIMP_TAC [REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE,
              REAL_MEASURABLE_REAL_INTERVAL])

  let REAL_LEBESGUE_MEASURABLE_INTER ← prove
   r"!s t. real_lebesgue_measurable s /\ real_lebesgue_measurable t
         ==> real_lebesgue_measurable(s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_LEBESGUE_MEASURABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_INTER) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN MP_TAC LIFT_DROP THEN SET_TAC [])

  let REAL_LEBESGUE_MEASURABLE_UNION ← prove
   r"!s t:real->bool.
        real_lebesgue_measurable s /\ real_lebesgue_measurable t
        ==> real_lebesgue_measurable(s UNION t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_LEBESGUE_MEASURABLE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_UNION) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN MP_TAC LIFT_DROP THEN SET_TAC [])

  let REAL_LEBESGUE_MEASURABLE_COMPL ← prove
   r"!s. real_lebesgue_measurable((:real) DIFF s) <=>
       real_lebesgue_measurable s"
   (GEN_TAC THEN REWRITE_TAC [REAL_LEBESGUE_MEASURABLE] THEN
    GEN_REWRITE_TAC (RAND_CONV) [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
    AP_TERM_TAC THEN MP_TAC LIFT_DROP THEN SET_TAC [])

  let REAL_LEBESGUE_MEASURABLE_DIFF ← prove
   r"!s t:real->bool.
        real_lebesgue_measurable s /\ real_lebesgue_measurable t
        ==> real_lebesgue_measurable(s DIFF t)"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    SIMP_TAC [REAL_LEBESGUE_MEASURABLE_COMPL, REAL_LEBESGUE_MEASURABLE_INTER])

  let REAL_LEBESGUE_MEASURABLE_ON_SUBINTERVALS ← prove
   r"!s. real_lebesgue_measurable s <=>
       !a b. real_lebesgue_measurable(s INTER real_interval[a,b])"
   (GEN_TAC THEN REWRITE_TAC [REAL_LEBESGUE_MEASURABLE] THEN
    GEN_REWRITE_TAC LAND_CONV [LEBESGUE_MEASURABLE_ON_SUBINTERVALS] THEN
    REWRITE_TAC [FORALL_DROP, ← GSYM IMAGE_DROP_INTERVAL] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN AP_TERM_TAC THEN
    MP_TAC LIFT_DROP THEN SET_TAC [])

  let REAL_LEBESGUE_MEASURABLE_CLOSED ← prove
   r"!s. real_closed s ==> real_lebesgue_measurable s"
   (REWRITE_TAC [REAL_LEBESGUE_MEASURABLE, REAL_CLOSED,
                 LEBESGUE_MEASURABLE_CLOSED])

  let REAL_LEBESGUE_MEASURABLE_OPEN ← prove
   r"!s. real_open s ==> real_lebesgue_measurable s"
   (REWRITE_TAC [REAL_LEBESGUE_MEASURABLE, REAL_OPEN,
                 LEBESGUE_MEASURABLE_OPEN])

  let REAL_LEBESGUE_MEASURABLE_UNIONS ← prove
   r"!f. FINITE f /\ (!s. s IN f ==> real_lebesgue_measurable s)
       ==> real_lebesgue_measurable (UNIONS f)"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, UNIONS_INSERT, REAL_LEBESGUE_MEASURABLE_EMPTY] THEN
    REWRITE_TAC [IN_INSERT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LEBESGUE_MEASURABLE_UNION THEN ASM_SIMP_TAC [])

  let REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT ← prove
   r"!s:num->real->bool.
        (!n. real_lebesgue_measurable(s n))
        ==> real_lebesgue_measurable(UNIONS {s n | n IN (:num)})"
   (GEN_TAC THEN REWRITE_TAC [REAL_LEBESGUE_MEASURABLE] THEN DISCH_THEN (MP_TAC o
      MATCH_MP LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT) THEN
    REWRITE_TAC [IMAGE_UNIONS, SIMPLE_IMAGE] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [])

  let REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS ← prove
   r"!f:(real->bool)->bool.
        COUNTABLE f /\ (!s. s IN f ==> real_lebesgue_measurable s)
        ==> real_lebesgue_measurable (UNIONS f)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"f:(real->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0, REAL_LEBESGUE_MEASURABLE_EMPTY] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"f:(real->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
    MATCH_MP_TAC REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT THEN
    GEN_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN MESON_TAC [])

  let REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS ← prove
   r"!f:(real->bool)->bool.
        COUNTABLE f /\ (!s. s IN f ==> real_lebesgue_measurable s)
        ==> real_lebesgue_measurable (INTERS f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [INTERS_UNIONS, REAL_LEBESGUE_MEASURABLE_COMPL] THEN
    MATCH_MP_TAC REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, COUNTABLE_IMAGE,
                  REAL_LEBESGUE_MEASURABLE_COMPL])

  let REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT ← prove
   r"!s:num->real->bool.
        (!n. real_lebesgue_measurable(s n))
        ==> real_lebesgue_measurable(INTERS {s n | n IN (:num)})"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE])

  let REAL_LEBESGUE_MEASURABLE_INTERS ← prove
   r"!f:(real->bool)->bool.
        FINITE f /\ (!s. s IN f ==> real_lebesgue_measurable s)
        ==> real_lebesgue_measurable (INTERS f)"
   (SIMP_TAC [REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS, FINITE_IMP_COUNTABLE])

  let REAL_LEBESGUE_MEASURABLE_IFF_MEASURABLE ← prove
   r"!s. real_bounded s ==> (real_lebesgue_measurable s <=> real_measurable s)"
   (REWRITE_TAC [REAL_BOUNDED, REAL_LEBESGUE_MEASURABLE,
                 REAL_MEASURABLE_MEASURABLE] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_IFF_MEASURABLE])

  let REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!f s t. s SUBSET t /\ f real_measurable_on t /\
           real_lebesgue_measurable s
           ==> f real_measurable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [IN_UNIV] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_MEASURABLE_ON_RESTRICT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN ASM SET_TAC [])

  let REAL_MEASURABLE_ON_MEASURABLE_SUBSET ← prove
   r"!f s t. s SUBSET t /\ f real_measurable_on t /\ real_measurable s
           ==> f real_measurable_on s"
   (MESON_TAC [REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
               REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE])

  let REAL_CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET ← prove
   r"!f s. f real_continuous_on s /\ real_closed s ==> f real_measurable_on s"
   (REWRITE_TAC [REAL_CONTINUOUS_ON, REAL_CLOSED, real_measurable_on] THEN
    REWRITE_TAC [CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET])

  let REAL_CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!f s m.
        f real_continuous_on s DIFF m /\
        real_lebesgue_measurable s /\
        real_negligible m
        ==> f real_measurable_on s"
   (REWRITE_TAC [real_measurable_on, real_negligible, REAL_LEBESGUE_MEASURABLE,
                 REAL_CONTINUOUS_ON] THEN
    SIMP_TAC [IMAGE_DIFF_INJ, LIFT_EQ] THEN
    REWRITE_TAC [CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET])

  let REAL_MEASURABLE_ON_CASES ← prove
   r"!P f g s.
        real_lebesgue_measurable {x | P x} /\
        f real_measurable_on s /\ g real_measurable_on s
        ==> (\x. if P x then f x else g x) real_measurable_on s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. (if x IN s then if P x then f x else g x else &0) =
          (if x IN {x | P x} then if x IN s then f x else &0 else &0) +
          (if x IN (:real) DIFF {x | P x}
           then if x IN s then g x else &0 else &0)")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN REWRITE_TAC [IN_UNIV, IN_ELIM_THM, IN_DIFF] THEN
      MESON_TAC [REAL_ADD_LID, REAL_ADD_RID],
      MATCH_MP_TAC REAL_MEASURABLE_ON_ADD THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_MEASURABLE_ON_RESTRICT THEN
      ASM_REWRITE_TAC [REAL_LEBESGUE_MEASURABLE_COMPL]])

  pure { REAL_MEASURABLE_IMP_REAL_LEBESGUE_MEASURABLE, REAL_LEBESGUE_MEASURABLE_EMPTY,
         REAL_LEBESGUE_MEASURABLE_UNIV, REAL_LEBESGUE_MEASURABLE_COMPACT,
         REAL_LEBESGUE_MEASURABLE_INTERVAL, REAL_LEBESGUE_MEASURABLE_INTER,
         REAL_LEBESGUE_MEASURABLE_UNION, REAL_LEBESGUE_MEASURABLE_COMPL,
         REAL_LEBESGUE_MEASURABLE_DIFF, REAL_LEBESGUE_MEASURABLE_ON_SUBINTERVALS,
         REAL_LEBESGUE_MEASURABLE_CLOSED, REAL_LEBESGUE_MEASURABLE_OPEN,
         REAL_LEBESGUE_MEASURABLE_UNIONS,
         REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
         REAL_LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
         REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS,
         REAL_LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT,
         REAL_LEBESGUE_MEASURABLE_INTERS, REAL_LEBESGUE_MEASURABLE_IFF_MEASURABLE,
         REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
         REAL_MEASURABLE_ON_MEASURABLE_SUBSET,
         REAL_CONTINUOUS_IMP_REAL_MEASURABLE_ON_CLOSED_SUBSET,
         REAL_CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
         REAL_MEASURABLE_ON_CASES }

/- ------------------------------------------------------------------------- -/
/- Various common equivalent forms of function measurability.                -/
/- (realanalysis.ml 16409-16541)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBW where
  REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LT : thm
  REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LE : thm
  REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GT : thm
  REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GE : thm
  REAL_MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL : thm
  REAL_MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL : thm
  REAL_MEASURABLE_ON_PREIMAGE_OPEN : thm
  REAL_MEASURABLE_ON_PREIMAGE_CLOSED : thm
  REAL_MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT : thm
  REAL_LEBESGUE_MEASURABLE_PREIMAGE_OPEN : thm
  REAL_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBW [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZBT : RZBT) : ExceptT String IO RZBW := do
  -- @@SCOPE BEGIN
  let { REAL_CLOSED, REAL_OPEN, TENDSTO_REAL, .. } := BRZA
  let { REAL_LEBESGUE_MEASURABLE, real_measurable_on, .. } := BRZBT
  let { IMAGE_DROP_UNIV, IMAGE_LIFT_DROP, .. } := D.qvectors
  let { IMAGE_DROP_INTERVAL, .. } := D.qtopology
  let { MEASURABLE_ON_PREIMAGE_CLOSED, MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, MEASURABLE_ON_PREIMAGE_OPEN,
        MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL, MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT,
        .. } := D.qmeasure
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { MESON_TAC, .. } := D.ts.cn.cx.cvx
  let { DIMINDEX_1, EQ_IMP, ETA_AX, FINITE_IMAGE, .. } := D.ts.cn.cx.cvx.core1
  let { IMAGE_o, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, .. } := D.ts.cn.cx.cvx.core3
  let { o_DEF, SURJECTIVE_IMAGE_EQ, .. } := D.ts.cn.cx.cvx.core6
  let { FORALL_1, FORALL_DROP, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  -- @@SCOPE END

  let REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LT ← prove
   r"!f. f real_measurable_on (:real) <=>
        !a. real_lebesgue_measurable {x | f(x) < a}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
     MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, o_DEF, LIFT_DROP] THEN
    GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LE ← prove
   r"!f. f real_measurable_on (:real) <=>
        !a. real_lebesgue_measurable {x | f(x) <= a}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
     MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, o_DEF, LIFT_DROP] THEN
    GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GT ← prove
   r"!f. f real_measurable_on (:real) <=>
        !a. real_lebesgue_measurable {x | f(x) > a}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
     MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, o_DEF, LIFT_DROP] THEN
    GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GE ← prove
   r"!f. f real_measurable_on (:real) <=>
        !a. real_lebesgue_measurable {x | f(x) >= a}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
     MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, o_DEF, LIFT_DROP] THEN
    GEN_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL ← prove
   r"!f. f real_measurable_on (:real) <=>
       !a b. real_lebesgue_measurable {x | f(x) IN real_interval(a,b)}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
                 MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL, FORALL_DROP] THEN
    GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM, o_DEF, ← GSYM IMAGE_DROP_INTERVAL, LIFT_DROP,
                 FORALL_DROP, IN_IMAGE] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL ← prove
   r"!f. f real_measurable_on (:real) <=>
       !a b. real_lebesgue_measurable {x | f(x) IN real_interval[a,b]}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
                 MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL, FORALL_DROP] THEN
    GEN_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN AP_TERM_TAC THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM, o_DEF, ← GSYM IMAGE_DROP_INTERVAL, LIFT_DROP,
                 FORALL_DROP, IN_IMAGE] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_OPEN ← prove
   r"!f. f real_measurable_on (:real) <=>
       !t. real_open t ==> real_lebesgue_measurable {x | f(x) IN t}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
                 MEASURABLE_ON_PREIMAGE_OPEN, REAL_OPEN] THEN
    GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"t:real->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE lift t")) THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"t:real^1->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE drop t")) THEN
      ASM_REWRITE_TAC [IMAGE_LIFT_DROP, ← GSYM IMAGE_o]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THENL
     [CONV_TAC SYM_CONV, ALL_TAC] THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_IMAGE, o_DEF, IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_PREIMAGE_CLOSED ← prove
   r"!f. f real_measurable_on (:real) <=>
       !t. real_closed t ==> real_lebesgue_measurable {x | f(x) IN t}"
   (REWRITE_TAC [real_measurable_on, REAL_LEBESGUE_MEASURABLE, IMAGE_LIFT_UNIV,
                 MEASURABLE_ON_PREIMAGE_CLOSED, REAL_CLOSED] THEN
    GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"t:real->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE lift t")) THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"t:real^1->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE drop t")) THEN
      ASM_REWRITE_TAC [IMAGE_LIFT_DROP, ← GSYM IMAGE_o]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THENL
     [CONV_TAC SYM_CONV, ALL_TAC] THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_IMAGE, o_DEF, IN_ELIM_THM] THEN MESON_TAC [LIFT_DROP])

  let REAL_MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT ← prove
   r"!f. f real_measurable_on (:real) <=>
       ?g. (!n. (g n) real_measurable_on (:real)) /\
           (!n. FINITE(IMAGE (g n) (:real))) /\
           (!x. ((\n. g n x) ---> f x) sequentially)"
   (GEN_TAC THEN REWRITE_TAC [real_measurable_on, IMAGE_LIFT_UNIV] THEN
    GEN_REWRITE_TAC LAND_CONV [MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT] THEN
    EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^1->real^1") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\n:num. drop o g n o lift") THEN
      REWRITE_TAC [TENDSTO_REAL] THEN REPEAT CONJ_TAC THENL
       [ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX],
        GEN_TAC THEN REWRITE_TAC [IMAGE_o, IMAGE_LIFT_UNIV] THEN
        MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
        X_GEN_TAC (← q r"x:real") THEN REWRITE_TAC [TENDSTO_REAL] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"lift x")) THEN
        REWRITE_TAC [o_DEF, LIFT_DROP]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\n:num. lift o g n o drop") THEN REPEAT CONJ_TAC THENL
       [ASM_REWRITE_TAC [],
        GEN_TAC THEN REWRITE_TAC [IMAGE_o, IMAGE_DROP_UNIV] THEN
        MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
        X_GEN_TAC (← q r"x:real^1") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"drop x")) THEN
        REWRITE_TAC [TENDSTO_REAL, o_DEF, LIFT_DROP]]])

  let REAL_LEBESGUE_MEASURABLE_PREIMAGE_OPEN ← prove
   r"!f t. f real_measurable_on (:real) /\ real_open t
         ==> real_lebesgue_measurable {x | f(x) IN t}"
   (SIMP_TAC [REAL_MEASURABLE_ON_PREIMAGE_OPEN])

  let REAL_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED ← prove
   r"!f t. f real_measurable_on (:real) /\ real_closed t
         ==> real_lebesgue_measurable {x | f(x) IN t}"
   (SIMP_TAC [REAL_MEASURABLE_ON_PREIMAGE_CLOSED])

  pure { REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LT, REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LE,
         REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GT, REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_GE,
         REAL_MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL,
         REAL_MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL,
         REAL_MEASURABLE_ON_PREIMAGE_OPEN, REAL_MEASURABLE_ON_PREIMAGE_CLOSED,
         REAL_MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT,
         REAL_LEBESGUE_MEASURABLE_PREIMAGE_OPEN,
         REAL_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Continuity of measure within a halfspace w.r.t. to the boundary.          -/
/- (realanalysis.ml 16542-16669)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBX where
  REAL_CONTINUOUS_MEASURE_IN_HALFSPACE_LE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBX [HolBase] (D : RealAnalysisDeps) (BRZH : RZH) (BRZN : RZN) : ExceptT String IO RZBX := do
  -- @@SCOPE BEGIN
  let { continuous_atreal, .. } := BRZH
  let { REAL_CONTINUOUS_CONTINUOUS1, .. } := BRZN
  let { MEASURABLE_DIFF, MEASURABLE_INTEGRABLE, MEASURABLE_INTER,
        MEASURABLE_INTER_HALFSPACE_LE, MEASURABLE_INTERVAL, MEASURE_INTEGRAL,
        MEASURE_LIMIT, MEASURE_NEGLIGIBLE_UNION_EQ, MEASURE_POS_LE, MEASURE_SUBSET,
        .. } := D.qmeasure
  let { INTERVAL_SPLIT, .. } := D.qintegration
  let { INDEFINITE_INTEGRAL_CONTINUOUS, INTEGRABLE_RESTRICT_UNIV,
        .. } := D.ts.cn.ms.qintegration2
  let { INTEGRAL_RESTRICT_UNIV, NEGLIGIBLE_EMPTY, .. } := D.ts.cn.ms.qintegration3
  let { ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        .. } := D.ts.cn.cx.cvx
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ts.cn.ms.ig.qtopology
  let { indicator, .. } := D.ts.cn.ms.ig.qvec
  let { FUN_EQ_THM, IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_NUMSEG, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, REAL_LE_SQUARE_ABS, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_MIN,
        .. } := D.ts.cn.cx.cvx.core4
  let { REAL_POW_2, REAL_SUB_LT, SUBSET_TRANS, .. } := D.ts.cn.cx.cvx.core5
  let { o_THM, SUM_DELTA, SUM_LE_NUMSEG, .. } := D.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.ts.cn.cx.cvx.misc
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, LIFT_DROP, LIFT_SUB, NORM_0,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LE_SQUARE, NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { dist, dot, VECTOR_SUB_COMPONENT, VECTOR_SUB_REFL, .. } := D.ts.cn.cx.cvx.vec4
  let { BOUNDED_BALL, .. } := D.ts.cn.cx.cvx.top1
  let { SUBSET_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  let { INTER_ASSOC, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let REAL_CONTINUOUS_MEASURE_IN_HALFSPACE_LE ← prove
   r"!(s:real^N->bool) a i.
        measurable s /\ 1 <= i /\ i <= dimindex(:N)
        ==> (\a. measure(s INTER {x | x$i <= a})) real_continuous atreal a"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS1] THEN
    REWRITE_TAC [continuous_atreal, o_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?u v:real^N. abs(measure(s INTER interval[u,v]) - measure s) < e / &2 /\
                   ~(interval(u,v) = {}) /\ u$i < a /\ a < v$i")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"e / &2"] MEASURE_LIMIT) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"ball(vec 0:real^N,B)") BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
      REWRITE_TAC [BOUNDED_BALL, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(lambda j. min (a - &1) ((u:real^N)$j)):real^N") THEN
      EXISTS_TAC (← q r"(lambda j. max (a + &1) ((v:real^N)$j)):real^N") THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_X_ASSUM
         (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
        SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN REAL_ARITH_TAC,
        ASM_SIMP_TAC [INTERVAL_NE_EMPTY, LAMBDA_BETA] THEN REAL_ARITH_TAC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"indicator(s:real^N->bool)", ← q r"u:real^N", ← q r"v:real^N", ← q r"u:real^N",
      ← q r"(lambda j. if j = i then min ((v:real^N)$i) a else v$j):real^N",
      ← q r"e / &2"]
        INDEFINITE_INTEGRAL_CONTINUOUS) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN ANTS_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
      REWRITE_TAC [indicator, ← MESON []
       (← q r"(if P then if Q then x else y else y) =
        (if P /\ Q then x else y)")] THEN
      REWRITE_TAC [← GSYM IN_INTER, ← GSYM MEASURABLE_INTEGRABLE] THEN
      ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
      ASM_SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, REAL_LE_REFL, REAL_LT_IMP_LE] THEN
      X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d (min (a - (u:real^N)$i) ((v:real^N)$i - a))") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT] THEN
    X_GEN_TAC (← q r"b:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N",
     ← q r"(lambda j. if j = i then min ((v:real^N)$i) b else v$j):real^N"]) THEN
    REWRITE_TAC [dist] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
      ASM_SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, REAL_LE_REFL, REAL_LT_IMP_LE] THEN
      ASM_SIMP_TAC [VECTOR_SUB_REFL, NORM_0, REAL_LT_IMP_LE] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [NORM_LE_SQUARE, dot, REAL_LT_IMP_LE] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
         (← q r"sum(1..dimindex(:N)) (\j. if j = i then d pow 2 else &0)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
          ASM_SIMP_TAC [LAMBDA_BETA, VECTOR_SUB_COMPONENT] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [← GSYM REAL_POW_2, ← GSYM REAL_LE_SQUARE_ABS] THEN
          ASM_REAL_ARITH_TAC,
          ASM_REWRITE_TAC [SUM_DELTA, IN_NUMSEG, REAL_LE_REFL]]],
      SUBGOAL_THEN
       (← q r"!b. integral
             (interval[u:real^N,
                       (lambda j. if j = i then min (v$i) b else (v:real^N)$j)])
             (indicator s) =
            lift(measure(s INTER interval[u,v] INTER {x | x$i <= b}))")
       (fun th => REWRITE_TAC [th])
      THENL
       [GEN_TAC THEN
        ASM_SIMP_TAC [MEASURE_INTEGRAL, MEASURABLE_INTER_HALFSPACE_LE,
                      MEASURABLE_INTER, MEASURABLE_INTERVAL, LIFT_DROP] THEN
        ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
        AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
        ASM_SIMP_TAC [INTERVAL_SPLIT, indicator] THEN
        REWRITE_TAC [IN_INTER] THEN MESON_TAC [],
        REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN
        SUBGOAL_THEN
         (← q r"!b. measure(s INTER {x:real^N | x$i <= b}) =
              measure((s INTER interval[u,v]) INTER {x | x$i <= b}) +
              measure((s DIFF interval[u,v]) INTER {x | x$i <= b})")
         (fun th => REWRITE_TAC [th])
        THENL
         [GEN_TAC THEN CONV_TAC SYM_CONV THEN
          MATCH_MP_TAC MEASURE_NEGLIGIBLE_UNION_EQ THEN
          ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTER_HALFSPACE_LE,
                        MEASURABLE_INTERVAL, MEASURABLE_DIFF] THEN
          CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC (← MESON [NEGLIGIBLE_EMPTY] (← q r"s = {} ==> negligible s")) THEN
          SET_TAC [],
          REWRITE_TAC [← GSYM INTER_ASSOC] THEN MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(nub - nua) < e / &2
            ==> abs(mub - mua) < e / &2
                ==> abs((mub + nub) - (mua + nua)) < e")) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"y < e ==> x <= y ==> x < e"))) THEN
          SUBGOAL_THEN
           (← q r"abs(measure(s INTER interval [u,v]) - measure s) =
            measure(s DIFF interval[u:real^N,v])")
          SUBST1_TAC THENL
           [MATCH_MP_TAC (← REAL_ARITH
             (← q r"x + z = y /\ &0 <= z ==> abs(x - y) = z")) THEN
            ASM_SIMP_TAC [MEASURE_POS_LE, MEASURABLE_DIFF,
                          MEASURABLE_INTERVAL] THEN
            MATCH_MP_TAC MEASURE_NEGLIGIBLE_UNION_EQ THEN
            ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_DIFF,
                          MEASURABLE_INTERVAL] THEN
            CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
            MATCH_MP_TAC (← MESON [NEGLIGIBLE_EMPTY] (← q r"s = {} ==> negligible s")) THEN
            SET_TAC [],
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"&0 <= x /\ x <= a /\ &0 <= y /\ y <= a ==> abs(x - y) <= a")) THEN
            ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTER_HALFSPACE_LE,
              MEASURABLE_INTERVAL, MEASURABLE_DIFF, MEASURE_POS_LE] THEN
            CONJ_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
            ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTER_HALFSPACE_LE,
              MEASURABLE_INTERVAL, MEASURABLE_DIFF, MEASURE_POS_LE] THEN
            SET_TAC []]]]])

  pure { REAL_CONTINUOUS_MEASURE_IN_HALFSPACE_LE }

/- ------------------------------------------------------------------------- -/
/- Second mean value theorem and monotone integrability.                     -/
/- (realanalysis.ml 16670-16914)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBY where
  REAL_SECOND_MEAN_VALUE_THEOREM_FULL : thm
  REAL_SECOND_MEAN_VALUE_THEOREM : thm
  REAL_SECOND_MEAN_VALUE_THEOREM_GEN_FULL : thm
  REAL_SECOND_MEAN_VALUE_THEOREM_GEN : thm
  REAL_SECOND_MEAN_VALUE_THEOREM_BONNET_FULL : thm
  REAL_SECOND_MEAN_VALUE_THEOREM_BONNET : thm
  REAL_INTEGRABLE_INCREASING_PRODUCT : thm
  REAL_INTEGRABLE_INCREASING_PRODUCT_UNIV : thm
  REAL_INTEGRABLE_INCREASING : thm
  REAL_INTEGRABLE_DECREASING_PRODUCT : thm
  REAL_INTEGRABLE_DECREASING_PRODUCT_UNIV : thm
  REAL_INTEGRABLE_DECREASING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBY [HolBase] (D : RealAnalysisDeps) (BRZAK : RZAK) (BRZAP : RZAP) : ExceptT String IO RZBY := do
  -- @@SCOPE BEGIN
  let { HAS_REAL_INTEGRAL, REAL_INTEGRABLE_ON, REAL_INTEGRAL, REAL_INTEGRAL_UNIQUE,
        .. } := BRZAK
  let { REAL_INTEGRABLE_ON_SUBINTERVAL, .. } := BRZAP
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY, SUBSET_REAL_INTERVAL, .. } := D.qmisc
  let { INTEGRABLE_DECREASING_1, INTEGRABLE_DECREASING_PRODUCT,
        INTEGRABLE_DECREASING_PRODUCT_UNIV, INTEGRABLE_INCREASING_PRODUCT,
        INTEGRABLE_INCREASING_PRODUCT_UNIV, SECOND_MEAN_VALUE_THEOREM_BONNET_FULL,
        SECOND_MEAN_VALUE_THEOREM_FULL, SECOND_MEAN_VALUE_THEOREM_GEN_FULL,
        .. } := D.qintegration
  let { INTEGRABLE_INCREASING_1, .. } := D.ts.cn.ms.qintegration2
  let { IMAGE_LIFT_UNIV, .. } := D.ts.cn.ms.qvec
  let { ASM_REAL_ARITH_TAC, .. } := D.ts.cn.cx.cvx
  let { EQ_IMP, EXISTS_IN_IMAGE, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, .. } := D.ts.cn.cx.cvx.core2
  let { MONO_EXISTS, .. } := D.ts.cn.cx.cvx.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_EQ, LIFT_ADD, LIFT_CMUL, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  -- @@SCOPE END

  let REAL_SECOND_MEAN_VALUE_THEOREM_FULL ← prove
   r"!f g a b.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                ((\x. g x * f x) has_real_integral
                 (g(a) * real_integral (real_interval[a,c]) f +
                  g(b) * real_integral (real_interval[c,b]) f))
                (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop",
                      ← q r"lift a", ← q r"lift b"]
      SECOND_MEAN_VALUE_THEOREM_FULL) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY] THEN
    ASM_REWRITE_TAC [← GSYM REAL_INTEGRABLE_ON] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_ADD] THEN AP_TERM_TAC THEN
    BINOP_TAC THEN AP_TERM_TAC THEN ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_INTEGRAL o rand o snd) THEN
    REWRITE_TAC [o_DEF] THEN ANTS_TAC THEN SIMP_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_INTEGRABLE_ON_SUBINTERVAL)) THEN
    REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY]) THEN
    ASM_REAL_ARITH_TAC)

  let REAL_SECOND_MEAN_VALUE_THEOREM ← prove
   r"!f g a b.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                real_integral (real_interval[a,b]) (\x. g x * f x) =
                 g(a) * real_integral (real_interval[a,c]) f +
                 g(b) * real_integral (real_interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_SECOND_MEAN_VALUE_THEOREM_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
    REWRITE_TAC [])

  let REAL_SECOND_MEAN_VALUE_THEOREM_GEN_FULL ← prove
   r"!f g a b u v.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) ==> u <= g x /\ g x <= v) /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                ((\x. g x * f x) has_real_integral
                 (u * real_integral (real_interval[a,c]) f +
                  v * real_integral (real_interval[c,b]) f))
                (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop",
                      ← q r"lift a", ← q r"lift b", ← q r"u:real", ← q r"v:real"]
      SECOND_MEAN_VALUE_THEOREM_GEN_FULL) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY] THEN
    ASM_REWRITE_TAC [← GSYM REAL_INTEGRABLE_ON] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_ADD] THEN AP_TERM_TAC THEN
    BINOP_TAC THEN AP_TERM_TAC THEN ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_INTEGRAL o rand o snd) THEN
    REWRITE_TAC [o_DEF] THEN ANTS_TAC THEN SIMP_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_INTEGRABLE_ON_SUBINTERVAL)) THEN
    REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY]) THEN
    ASM_REAL_ARITH_TAC)

  let REAL_SECOND_MEAN_VALUE_THEOREM_GEN ← prove
   r"!f g a b u v.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval(a,b) ==> u <= g x /\ g x <= v) /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                real_integral (real_interval[a,b]) (\x. g x * f x) =
                 u * real_integral (real_interval[a,c]) f +
                 v * real_integral (real_interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_SECOND_MEAN_VALUE_THEOREM_GEN_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
    REWRITE_TAC [])

  let REAL_SECOND_MEAN_VALUE_THEOREM_BONNET_FULL ← prove
   r"!f g a b.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b] ==> &0 <= g x) /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                ((\x. g x * f x) has_real_integral
                 (g(b) * real_integral (real_interval[c,b]) f))
                (real_interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop",
                      ← q r"lift a", ← q r"lift b"]
      SECOND_MEAN_VALUE_THEOREM_BONNET_FULL) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY] THEN
    ASM_REWRITE_TAC [← GSYM REAL_INTEGRABLE_ON] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [HAS_REAL_INTEGRAL, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_ADD] THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
    REWRITE_TAC [LIFT_DROP] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_INTEGRAL o rand o snd) THEN
    REWRITE_TAC [o_DEF] THEN ANTS_TAC THEN SIMP_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_INTEGRABLE_ON_SUBINTERVAL)) THEN
    REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY]) THEN
    ASM_REAL_ARITH_TAC)

  let REAL_SECOND_MEAN_VALUE_THEOREM_BONNET ← prove
   r"!f g a b.
        ~(real_interval[a,b] = {}) /\
        f real_integrable_on real_interval[a,b] /\
        (!x. x IN real_interval[a,b] ==> &0 <= g x) /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g x <= g y)
        ==> ?c. c IN real_interval[a,b] /\
                real_integral (real_interval[a,b]) (\x. g x * f x) =
                g(b) * real_integral (real_interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP REAL_SECOND_MEAN_VALUE_THEOREM_BONNET_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP REAL_INTEGRAL_UNIQUE) THEN
    REWRITE_TAC [])

  let REAL_INTEGRABLE_INCREASING_PRODUCT ← prove
   r"!f g a b.
        f real_integrable_on real_interval[a,b] /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g(x) <= g(y))
        ==> (\x. g(x) * f(x)) real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop",
                      ← q r"lift a", ← q r"lift b"]
      INTEGRABLE_INCREASING_PRODUCT) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  let REAL_INTEGRABLE_INCREASING_PRODUCT_UNIV ← prove
   r"!f g B.
        f real_integrable_on (:real) /\
        (!x y. x <= y ==> g x <= g y) /\
        (!x. abs(g x) <= B)
         ==> (\x. g x * f x) real_integrable_on (:real)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop", ← q r"B:real"]
      INTEGRABLE_INCREASING_PRODUCT_UNIV) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_UNIV,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  let REAL_INTEGRABLE_INCREASING ← prove
   r"!f a b.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f(x) <= f(y))
        ==> f real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b"]
      INTEGRABLE_INCREASING_1) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  let REAL_INTEGRABLE_DECREASING_PRODUCT ← prove
   r"!f g a b.
        f real_integrable_on real_interval[a,b] /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> g(y) <= g(x))
        ==> (\x. g(x) * f(x)) real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop",
                      ← q r"lift a", ← q r"lift b"]
      INTEGRABLE_DECREASING_PRODUCT) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  let REAL_INTEGRABLE_DECREASING_PRODUCT_UNIV ← prove
   r"!f g B.
        f real_integrable_on (:real) /\
        (!x y. x <= y ==> g y <= g x) /\
        (!x. abs(g x) <= B)
         ==> (\x. g x * f x) real_integrable_on (:real)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"(g:real->real) o drop", ← q r"B:real"]
      INTEGRABLE_DECREASING_PRODUCT_UNIV) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_UNIV,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  let REAL_INTEGRABLE_DECREASING ← prove
   r"!f a b.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f(y) <= f(x))
        ==> f real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b"]
      INTEGRABLE_DECREASING_1) THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL,
                     ← GSYM REAL_INTEGRABLE_ON] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [o_DEF, LIFT_DROP, REAL_INTEGRABLE_ON, LIFT_CMUL])

  pure { REAL_SECOND_MEAN_VALUE_THEOREM_FULL, REAL_SECOND_MEAN_VALUE_THEOREM,
         REAL_SECOND_MEAN_VALUE_THEOREM_GEN_FULL, REAL_SECOND_MEAN_VALUE_THEOREM_GEN,
         REAL_SECOND_MEAN_VALUE_THEOREM_BONNET_FULL,
         REAL_SECOND_MEAN_VALUE_THEOREM_BONNET, REAL_INTEGRABLE_INCREASING_PRODUCT,
         REAL_INTEGRABLE_INCREASING_PRODUCT_UNIV, REAL_INTEGRABLE_INCREASING,
         REAL_INTEGRABLE_DECREASING_PRODUCT, REAL_INTEGRABLE_DECREASING_PRODUCT_UNIV,
         REAL_INTEGRABLE_DECREASING }

/- ------------------------------------------------------------------------- -/
/- Measurability and absolute integrability of monotone functions.           -/
/- (realanalysis.ml 16915-17033)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZBZ where
  REAL_MEASURABLE_ON_INCREASING_UNIV : thm
  REAL_MEASURABLE_ON_INCREASING : thm
  REAL_MEASURABLE_ON_DECREASING_UNIV : thm
  REAL_MEASURABLE_ON_DECREASING : thm
  ABSOLUTELY_REAL_INTEGRABLE_INCREASING_PRODUCT : thm
  ABSOLUTELY_REAL_INTEGRABLE_INCREASING : thm
  ABSOLUTELY_REAL_INTEGRABLE_DECREASING_PRODUCT : thm
  ABSOLUTELY_REAL_INTEGRABLE_DECREASING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZBZ [HolBase] (D : RealAnalysisDeps) (BRZAR : RZAR) (BRZBT : RZBT) (BRZBU : RZBU) (BRZBV : RZBV) (BRZBW : RZBW) : ExceptT String IO RZBZ := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_REAL_INTEGRABLE_CONST, .. } := BRZAR
  let { REAL_MEASURABLE_ON_0, REAL_MEASURABLE_ON_NEG_EQ, REAL_MEASURABLE_ON_UNIV,
        .. } := BRZBT
  let { ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT, .. } := BRZBU
  let { REAL_LEBESGUE_MEASURABLE_CLOSED, REAL_LEBESGUE_MEASURABLE_EMPTY,
        REAL_LEBESGUE_MEASURABLE_INTERVAL, REAL_LEBESGUE_MEASURABLE_OPEN,
        REAL_LEBESGUE_MEASURABLE_UNIV, REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
        .. } := BRZBV
  let { REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LE, .. } := BRZBW
  let { real_bounded, REAL_CLOSED_HALFSPACE_LE, REAL_OPEN_HALFSPACE_LT, .. } := D.qmetric
  let { IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY, .. } := D.qmisc
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, .. } := D.ts.cn.cx.cvx
  let { ETA_AX, EXTENSION, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, NOT_IN_EMPTY, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TOTAL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_LE, .. } := D.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LE, REAL_NOT_LT, .. } := D.ts.cn.cx.cvx.core5
  let { SUBSET_UNIV, SUP, .. } := D.ts.cn.cx.cvx.core6
  -- @@SCOPE END
  -- STRIP_THM_THEN is not lifted into HolLight; bound here from HolCore.Tactics.
  let STRIP_THM_THEN : thm_tactical := HolCore.Tactics.STRIP_THM_THEN HolBase.B

  let REAL_MEASURABLE_ON_INCREASING_UNIV ← prove
   r"!f. (!x y. x <= y ==> f x <= f y) ==> f real_measurable_on (:real)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [REAL_MEASURABLE_ON_PREIMAGE_HALFSPACE_LE] THEN
    X_GEN_TAC (← q r"y:real") THEN
    REPEAT_TCL STRIP_THM_THEN ASSUME_TAC
     (← SET_RULE (← q r"{x | (f:real->real) x <= y} = {} \/
                {x | (f:real->real) x <= y} = UNIV \/
                ?a b. f a <= y /\ ~(f b <= y)")) THEN
    ASM_REWRITE_TAC [REAL_LEBESGUE_MEASURABLE_EMPTY,
                     REAL_LEBESGUE_MEASURABLE_UNIV] THEN
    MP_TAC (← ISPEC (← q r"{x | (f:real->real) x <= y}") SUP) THEN
    REWRITE_TAC [IN_ELIM_THM, EXTENSION, NOT_IN_EMPTY] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [REAL_LE_TOTAL, REAL_LE_TRANS], ALL_TAC] THEN
    ABBREV_TAC (← q r"s = sup {x | (f:real->real) x <= y}") THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"(!x. (f:real->real) x <= y <=> x < s) \/
       (!x. (f:real->real) x <= y <=> x <= s)")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"(f:real->real) s <= y") THEN
      ASM_MESON_TAC [REAL_LE_TRANS, REAL_NOT_LE, REAL_LE_ANTISYM, REAL_LE_TOTAL],
      ASM_SIMP_TAC [REAL_OPEN_HALFSPACE_LT, REAL_LEBESGUE_MEASURABLE_OPEN],
      ASM_SIMP_TAC [REAL_CLOSED_HALFSPACE_LE, REAL_LEBESGUE_MEASURABLE_CLOSED]])

  let REAL_MEASURABLE_ON_INCREASING ← prove
   r"!f a b. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> f x <= f y)
           ==> f real_measurable_on real_interval[a,b]"
   (REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"real_interval[a,b] = {}") THENL
     [ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, REAL_MEASURABLE_ON_0],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_INTERVAL_EQ_EMPTY, REAL_NOT_LT])] THEN
    ABBREV_TAC (← q r"g = \x. if x < a then f(a)
                        else if b < x then f(b)
                        else (f:real->real) x") THEN
    SUBGOAL_THEN (← q r"g real_measurable_on real_interval[a,b]") MP_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM REAL_MEASURABLE_ON_UNIV] THEN EXPAND_TAC "g" THEN
      SIMP_TAC [IN_REAL_INTERVAL, ← GSYM REAL_NOT_LT]] THEN
    MATCH_MP_TAC REAL_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"(:real)") THEN
    REWRITE_TAC [SUBSET_UNIV, REAL_LEBESGUE_MEASURABLE_INTERVAL] THEN
    MATCH_MP_TAC REAL_MEASURABLE_ON_INCREASING_UNIV THEN EXPAND_TAC "g" THEN
    ASM_MESON_TAC [REAL_LT_LE, REAL_LE_TRANS, REAL_LE_TOTAL, REAL_LE_ANTISYM,
                   REAL_NOT_LT, REAL_LT_IMP_LE, REAL_LE_REFL])

  let REAL_MEASURABLE_ON_DECREASING_UNIV ← prove
   r"!f. (!x y. x <= y ==> f y <= f x) ==> f real_measurable_on (:real)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← GSYM REAL_MEASURABLE_ON_NEG_EQ] THEN
    MATCH_MP_TAC REAL_MEASURABLE_ON_INCREASING_UNIV THEN
    ASM_SIMP_TAC [REAL_LE_NEG2])

  let REAL_MEASURABLE_ON_DECREASING ← prove
   r"!f a b. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> f y <= f x)
           ==> f real_measurable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← GSYM REAL_MEASURABLE_ON_NEG_EQ] THEN
    MATCH_MP_TAC REAL_MEASURABLE_ON_INCREASING THEN
    ASM_SIMP_TAC [REAL_LE_NEG2])

  let ABSOLUTELY_REAL_INTEGRABLE_INCREASING_PRODUCT ← prove
   r"!f g a b.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f x <= f y) /\
        g absolutely_real_integrable_on real_interval[a,b]
        ==> (\x. f x * g x) absolutely_real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_ON_INCREASING] THEN
    REWRITE_TAC [real_bounded, FORALL_IN_IMAGE] THEN
    EXISTS_TAC (← q r"abs((f:real->real) a) + abs((f:real->real) b)") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC
     (← REAL_ARITH (← q r"a <= x /\ x <= b ==> abs x <= abs a + abs b")) THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [IN_REAL_INTERVAL, REAL_LE_TRANS, REAL_LE_REFL])

  let ABSOLUTELY_REAL_INTEGRABLE_INCREASING ← prove
   r"!f a b. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> f x <= f y)
           ==> f absolutely_real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
    GEN_REWRITE_TAC (LAND_CONV o ABS_CONV) [← GSYM REAL_MUL_RID] THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_INCREASING_PRODUCT THEN
    ASM_REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_CONST])

  let ABSOLUTELY_REAL_INTEGRABLE_DECREASING_PRODUCT ← prove
   r"!f g a b.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f y <= f x) /\
        g absolutely_real_integrable_on real_interval[a,b]
        ==> (\x. f x * g x) absolutely_real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT THEN
    ASM_SIMP_TAC [REAL_MEASURABLE_ON_DECREASING] THEN
    REWRITE_TAC [real_bounded, FORALL_IN_IMAGE] THEN
    EXISTS_TAC (← q r"abs((f:real->real) a) + abs((f:real->real) b)") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC
     (← REAL_ARITH (← q r"b <= x /\ x <= a ==> abs x <= abs a + abs b")) THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [IN_REAL_INTERVAL, REAL_LE_TRANS, REAL_LE_REFL])

  let ABSOLUTELY_REAL_INTEGRABLE_DECREASING ← prove
   r"!f a b. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> f y <= f x)
           ==> f absolutely_real_integrable_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
    GEN_REWRITE_TAC (LAND_CONV o ABS_CONV) [← GSYM REAL_MUL_RID] THEN
    MATCH_MP_TAC ABSOLUTELY_REAL_INTEGRABLE_DECREASING_PRODUCT THEN
    ASM_REWRITE_TAC [ABSOLUTELY_REAL_INTEGRABLE_CONST])

  pure { REAL_MEASURABLE_ON_INCREASING_UNIV, REAL_MEASURABLE_ON_INCREASING,
         REAL_MEASURABLE_ON_DECREASING_UNIV, REAL_MEASURABLE_ON_DECREASING,
         ABSOLUTELY_REAL_INTEGRABLE_INCREASING_PRODUCT,
         ABSOLUTELY_REAL_INTEGRABLE_INCREASING,
         ABSOLUTELY_REAL_INTEGRABLE_DECREASING_PRODUCT,
         ABSOLUTELY_REAL_INTEGRABLE_DECREASING }

/- ------------------------------------------------------------------------- -/
/- Real functions of bounded variation.                                      -/
/- (realanalysis.ml 17034-17265)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZCA where
  has_bounded_real_variation_on : thm
  real_variation : thm
  HAS_BOUNDED_REAL_VARIATION_ON_EQ : thm
  HAS_BOUNDED_REAL_VARIATION_ON_SUBSET : thm
  HAS_BOUNDED_REAL_VARIATION_ON_LMUL : thm
  HAS_BOUNDED_REAL_VARIATION_ON_RMUL : thm
  HAS_BOUNDED_REAL_VARIATION_ON_NEG : thm
  HAS_BOUNDED_REAL_VARIATION_ON_ADD : thm
  HAS_BOUNDED_REAL_VARIATION_ON_SUB : thm
  HAS_BOUNDED_REAL_VARIATION_ON_NULL : thm
  HAS_BOUNDED_REAL_VARIATION_ON_EMPTY : thm
  HAS_BOUNDED_REAL_VARIATION_ON_ABS : thm
  HAS_BOUNDED_REAL_VARIATION_ON_MAX : thm
  HAS_BOUNDED_REAL_VARIATION_ON_MIN : thm
  HAS_BOUNDED_REAL_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL : thm
  HAS_BOUNDED_REAL_VARIATION_ON_MUL : thm
  REAL_VARIATION_POS_LE : thm
  REAL_VARIATION_GE_ABS_FUNCTION : thm
  REAL_VARIATION_GE_FUNCTION : thm
  REAL_VARIATION_MONOTONE : thm
  REAL_VARIATION_NEG : thm
  REAL_VARIATION_TRIANGLE : thm
  HAS_BOUNDED_REAL_VARIATION_ON_COMBINE : thm
  REAL_VARIATION_COMBINE : thm
  REAL_VARIATION_MINUS_FUNCTION_MONOTONE : thm
  INCREASING_BOUNDED_REAL_VARIATION : thm
  INCREASING_REAL_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZCA [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZAD : RZAD) : ExceptT String IO RZCA := do
  -- @@SCOPE BEGIN
  let { REAL_BOUNDED, .. } := BRZA
  let { IMAGE_LIFT_REAL_SEGMENT, .. } := BRZAD
  let { IMAGE_DROP_INTERVAL, IMAGE_LIFT_REAL_INTERVAL, IS_REALINTERVAL_IS_INTERVAL,
        .. } := D.qtopology
  let { IN_REAL_INTERVAL, .. } := D.qmisc
  let { HAS_BOUNDED_VARIATION_ON_COMBINE, HAS_BOUNDED_VARIATION_ON_EMPTY,
        HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL, HAS_BOUNDED_VARIATION_ON_MAX,
        HAS_BOUNDED_VARIATION_ON_MIN, HAS_BOUNDED_VARIATION_ON_NEG,
        HAS_BOUNDED_VARIATION_ON_NORM, HAS_BOUNDED_VARIATION_ON_NULL,
        INCREASING_VECTOR_VARIATION, VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE,
        VECTOR_VARIATION_NEG, VECTOR_VARIATION_POS_LE, VECTOR_VARIATION_TRIANGLE,
        .. } := D.qintegration
  let { HAS_BOUNDED_VARIATION_ON_ADD, HAS_BOUNDED_VARIATION_ON_MUL,
        .. } := D.ts.cn.qintegration
  let { CONTENT_EQ_0_1, .. } := D.ts.cn.ms.qintegration1
  let { HAS_BOUNDED_VARIATION_ON_CMUL, HAS_BOUNDED_VARIATION_ON_EQ,
        HAS_BOUNDED_VARIATION_ON_SUB, HAS_BOUNDED_VARIATION_ON_SUBSET,
        INCREASING_BOUNDED_VARIATION, .. } := D.ts.cn.ms.qintegration2
  let { VECTOR_VARIATION_COMBINE, VECTOR_VARIATION_GE_NORM_FUNCTION,
        VECTOR_VARIATION_MONOTONE, .. } := D.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        .. } := D.ts.cn.cx.cvx
  let { NORM_REAL, .. } := D.ts.cn.ms.ig.qvec
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMAGE_SUBSET, IMP_CONJ,
        .. } := D.ts.cn.cx.cvx.core2
  let { REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_SUB, FORALL_DROP, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_SUB,
        .. } := D.ts.cn.cx.cvx.vec2
  let { NORM_LIFT, .. } := D.ts.cn.cx.cvx.vec3
  let { drop, .. } := D.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, .. } := D.ts.cn.cx.cvx.top4
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  let { BOUNDED_INTERVAL, .. } := D.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  parse_as_infix ("has_bounded_real_variation_on", (12, "right"))

  let has_bounded_real_variation_on ← new_definition
   r"f has_bounded_real_variation_on s <=>
  (lift o f o drop) has_bounded_variation_on (IMAGE lift s)"

  let real_variation ← new_definition
   r"real_variation s f = vector_variation (IMAGE lift s) (lift o f o drop)"

  let HAS_BOUNDED_REAL_VARIATION_ON_EQ ← prove
   r"!f g s.
        (!x. x IN s ==> f x = g x) /\ f has_bounded_real_variation_on s


        ==> g has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [IMP_CONJ, has_bounded_real_variation_on] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_EQ) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_SUBSET ← prove
   r"!f s t. f has_bounded_real_variation_on s /\ t SUBSET s
           ==> f has_bounded_real_variation_on t"
   (REWRITE_TAC [has_bounded_real_variation_on] THEN
    MESON_TAC [HAS_BOUNDED_VARIATION_ON_SUBSET, IMAGE_SUBSET])

  let HAS_BOUNDED_REAL_VARIATION_ON_LMUL ← prove
   r"!f c s. f has_bounded_real_variation_on s
           ==> (\x. c * f x) has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, HAS_BOUNDED_VARIATION_ON_CMUL])

  let HAS_BOUNDED_REAL_VARIATION_ON_RMUL ← prove
   r"!f c s. f has_bounded_real_variation_on s
           ==> (\x. f x * c) has_bounded_real_variation_on s"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [HAS_BOUNDED_REAL_VARIATION_ON_LMUL])

  let HAS_BOUNDED_REAL_VARIATION_ON_NEG ← prove
   r"!f s. f has_bounded_real_variation_on s
         ==> (\x. --f x) has_bounded_real_variation_on s"
   (REWRITE_TAC [has_bounded_real_variation_on, o_DEF, LIFT_NEG] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_NEG])

  let HAS_BOUNDED_REAL_VARIATION_ON_ADD ← prove
   r"!f g s. f has_bounded_real_variation_on s /\
           g has_bounded_real_variation_on s
           ==> (\x. f x + g x) has_bounded_real_variation_on s"
   (REWRITE_TAC [has_bounded_real_variation_on, o_DEF, LIFT_ADD] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_ADD])

  let HAS_BOUNDED_REAL_VARIATION_ON_SUB ← prove
   r"!f g s. f has_bounded_real_variation_on s /\
           g has_bounded_real_variation_on s
           ==> (\x. f x - g x) has_bounded_real_variation_on s"
   (REWRITE_TAC [has_bounded_real_variation_on, o_DEF, LIFT_SUB] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_SUB])

  let HAS_BOUNDED_REAL_VARIATION_ON_NULL ← prove
   r"!f a b. b <= a ==> f has_bounded_real_variation_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_NULL THEN
    ASM_REWRITE_TAC [BOUNDED_INTERVAL, CONTENT_EQ_0_1, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_EMPTY ← prove
   r"!f. f has_bounded_real_variation_on {}"
   (REWRITE_TAC [IMAGE_CLAUSES, has_bounded_real_variation_on] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_EMPTY])

  let HAS_BOUNDED_REAL_VARIATION_ON_ABS ← prove
   r"!f s. f has_bounded_real_variation_on s
         ==> (\x. abs(f x)) has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_NORM) THEN
    REWRITE_TAC [o_DEF, NORM_REAL, ← GSYM drop, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_MAX ← prove
   r"!f g s. f has_bounded_real_variation_on s /\
           g has_bounded_real_variation_on s
           ==> (\x. max (f x) (g x)) has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_MAX) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_MIN ← prove
   r"!f g s. f has_bounded_real_variation_on s /\
           g has_bounded_real_variation_on s
           ==> (\x. min (f x) (g x)) has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_MIN) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL ← prove
   r"!f a b. f has_bounded_real_variation_on real_interval[a,b]
           ==> real_bounded(IMAGE f (real_interval[a,b]))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_real_variation_on, REAL_BOUNDED] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
      HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL) THEN
    REWRITE_TAC [IMAGE_o, IMAGE_DROP_INTERVAL, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_ON_MUL ← prove
   r"!f g s.
        f has_bounded_real_variation_on s /\
        g has_bounded_real_variation_on s /\
        is_realinterval s
        ==> (\x. f x * g x) has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, IS_REALINTERVAL_IS_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_MUL) THEN
    REWRITE_TAC [o_DEF, LIFT_CMUL, LIFT_DROP])

  let REAL_VARIATION_POS_LE ← prove
   r"!f s. f has_bounded_real_variation_on s ==> &0 <= real_variation s f"
   (REWRITE_TAC [real_variation, has_bounded_real_variation_on] THEN
    REWRITE_TAC [VECTOR_VARIATION_POS_LE])

  let REAL_VARIATION_GE_ABS_FUNCTION ← prove
   r"!f s a b.
        f has_bounded_real_variation_on s /\ real_segment[a,b] SUBSET s
        ==> abs(f b - f a) <= real_variation s f"
   (REWRITE_TAC [has_bounded_real_variation_on] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"IMAGE lift s", ← q r"lift a", ← q r"lift b"]
     VECTOR_VARIATION_GE_NORM_FUNCTION) THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_SEGMENT,
                  IMAGE_EQ_EMPTY, IMAGE_SUBSET] THEN
    REWRITE_TAC [real_variation, o_THM, LIFT_DROP, ← GSYM LIFT_SUB, NORM_LIFT])

  let REAL_VARIATION_GE_FUNCTION ← prove
   r"!f s a b.
        f has_bounded_real_variation_on s /\ real_segment[a,b] SUBSET s
        ==> f b - f a <= real_variation s f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> x <= a")) THEN
    ASM_MESON_TAC [REAL_VARIATION_GE_ABS_FUNCTION])

  let REAL_VARIATION_MONOTONE ← prove
   r"!f s t. f has_bounded_real_variation_on s /\ t SUBSET s
           ==> real_variation t f <= real_variation s f"
   (REWRITE_TAC [has_bounded_real_variation_on, real_variation] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
    ASM_SIMP_TAC [IMAGE_SUBSET])

  let REAL_VARIATION_NEG ← prove
   r"!f s. real_variation s (\x. --(f x)) = real_variation s f"
   (SIMP_TAC [real_variation, o_DEF, LIFT_NEG, VECTOR_VARIATION_NEG])

  let REAL_VARIATION_TRIANGLE ← prove
   r"!f g s. f has_bounded_real_variation_on s /\
           g has_bounded_real_variation_on s
           ==> real_variation s (\x. f x + g x)
               <= real_variation s f + real_variation s g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_real_variation_on, real_variation] THEN
    DISCH_THEN (MP_TAC o MATCH_MP VECTOR_VARIATION_TRIANGLE) THEN
    REWRITE_TAC [o_DEF, LIFT_ADD])

  let HAS_BOUNDED_REAL_VARIATION_ON_COMBINE ← prove
   r"!f a b c.
        a <= c /\ c <= b
        ==> (f has_bounded_real_variation_on real_interval[a,b] <=>
             f has_bounded_real_variation_on real_interval[a,c] /\
             f has_bounded_real_variation_on real_interval[c,b])"
   (REWRITE_TAC [has_bounded_real_variation_on, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"lift c"]
          HAS_BOUNDED_VARIATION_ON_COMBINE) THEN
    ASM_REWRITE_TAC [LIFT_DROP, has_bounded_real_variation_on,
        IMAGE_LIFT_REAL_INTERVAL])

  let REAL_VARIATION_COMBINE ← prove
   r"!f a b c.
        a <= c /\ c <= b /\
        f has_bounded_real_variation_on real_interval[a,b]
        ==> real_variation (real_interval[a,c]) f +
            real_variation (real_interval[c,b]) f =
            real_variation (real_interval[a,b]) f"
   (REWRITE_TAC [has_bounded_real_variation_on, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"lift c"]
          VECTOR_VARIATION_COMBINE) THEN
    ASM_REWRITE_TAC [LIFT_DROP, real_variation, IMAGE_LIFT_REAL_INTERVAL])

  let REAL_VARIATION_MINUS_FUNCTION_MONOTONE ← prove
   r"!f a b c d.
        f has_bounded_real_variation_on real_interval[a,b] /\
        real_interval[c,d] SUBSET real_interval[a,b] /\
        ~(real_interval[c,d] = {})
        ==> real_variation (real_interval[c,d]) f - (f d - f c) <=
            real_variation (real_interval[a,b]) f - (f b - f a)"
   (REWRITE_TAC [has_bounded_real_variation_on, IMAGE_LIFT_REAL_INTERVAL] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b", ← q r"lift c", ← q r"lift d"]
     VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE) THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, real_variation,
                  IMAGE_EQ_EMPTY, IMAGE_SUBSET] THEN
    REWRITE_TAC [o_THM, LIFT_DROP, DROP_SUB])

  let INCREASING_BOUNDED_REAL_VARIATION ← prove
   r"!f a b.
      (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
             ==> f x <= f y)
      ==> f has_bounded_real_variation_on real_interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC INCREASING_BOUNDED_VARIATION THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM FORALL_DROP, o_THM, LIFT_DROP] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN ASM_MESON_TAC [])

  let INCREASING_REAL_VARIATION ← prove
   r"!f a b.
        ~(real_interval[a,b] = {}) /\
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f x <= f y)
        ==> real_variation (real_interval[a,b]) f = f b - f a"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [real_variation, IMAGE_LIFT_REAL_INTERVAL] THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"lift a", ← q r"lift b"]
          INCREASING_VECTOR_VARIATION) THEN
    REWRITE_TAC [o_THM, LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [LIFT_DROP] THEN ASM_MESON_TAC [])

  pure { has_bounded_real_variation_on, real_variation,
         HAS_BOUNDED_REAL_VARIATION_ON_EQ, HAS_BOUNDED_REAL_VARIATION_ON_SUBSET,
         HAS_BOUNDED_REAL_VARIATION_ON_LMUL, HAS_BOUNDED_REAL_VARIATION_ON_RMUL,
         HAS_BOUNDED_REAL_VARIATION_ON_NEG, HAS_BOUNDED_REAL_VARIATION_ON_ADD,
         HAS_BOUNDED_REAL_VARIATION_ON_SUB, HAS_BOUNDED_REAL_VARIATION_ON_NULL,
         HAS_BOUNDED_REAL_VARIATION_ON_EMPTY, HAS_BOUNDED_REAL_VARIATION_ON_ABS,
         HAS_BOUNDED_REAL_VARIATION_ON_MAX, HAS_BOUNDED_REAL_VARIATION_ON_MIN,
         HAS_BOUNDED_REAL_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL,
         HAS_BOUNDED_REAL_VARIATION_ON_MUL, REAL_VARIATION_POS_LE,
         REAL_VARIATION_GE_ABS_FUNCTION, REAL_VARIATION_GE_FUNCTION,
         REAL_VARIATION_MONOTONE, REAL_VARIATION_NEG, REAL_VARIATION_TRIANGLE,
         HAS_BOUNDED_REAL_VARIATION_ON_COMBINE, REAL_VARIATION_COMBINE,
         REAL_VARIATION_MINUS_FUNCTION_MONOTONE, INCREASING_BOUNDED_REAL_VARIATION,
         INCREASING_REAL_VARIATION }

/- ------------------------------------------------------------------------- -/
/- Bounded real variation: affinity, translation, reflection.                -/
/- (realanalysis.ml 17266-17413)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZCB where
  HAS_BOUNDED_REAL_VARIATION_AFFINITY2_EQ : thm
  REAL_VARIATION_AFFINITY2 : thm
  HAS_BOUNDED_REAL_VARIATION_AFFINITY_EQ : thm
  REAL_VARIATION_AFFINITY : thm
  HAS_BOUNDED_REAL_VARIATION_TRANSLATION2_EQ : thm
  REAL_VARIATION_TRANSLATION2 : thm
  HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ : thm
  REAL_VARIATION_TRANSLATION : thm
  HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ_INTERVAL : thm
  REAL_VARIATION_TRANSLATION_INTERVAL : thm
  HAS_BOUNDED_REAL_VARIATION_TRANSLATION : thm
  HAS_BOUNDED_REAL_VARIATION_REFLECT2_EQ : thm
  REAL_VARIATION_REFLECT2 : thm
  HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ : thm
  REAL_VARIATION_REFLECT : thm
  HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ_INTERVAL : thm
  REAL_VARIATION_REFLECT_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZCB [HolBase] (D : RealAnalysisDeps) (BRZM : RZM) (BRZCA : RZCA) : ExceptT String IO RZCB := do
  -- @@SCOPE BEGIN
  let { REAL_INTERVAL_TRANSLATION, .. } := BRZM
  let { has_bounded_real_variation_on, real_variation, .. } := BRZCA
  let { REFLECT_REAL_INTERVAL, .. } := D.qmisc
  let { HAS_BOUNDED_VARIATION_AFFINITY2_EQ, HAS_BOUNDED_VARIATION_AFFINITY_EQ,
        HAS_BOUNDED_VARIATION_REFLECT2_EQ, HAS_BOUNDED_VARIATION_REFLECT_EQ,
        HAS_BOUNDED_VARIATION_TRANSLATION2_EQ, HAS_BOUNDED_VARIATION_TRANSLATION_EQ,
        VECTOR_VARIATION_AFFINITY, VECTOR_VARIATION_AFFINITY2, VECTOR_VARIATION_REFLECT,
        VECTOR_VARIATION_REFLECT2, VECTOR_VARIATION_TRANSLATION2,
        VECTOR_VARIATION_TRANSLATION_ALT, .. } := D.qintegration
  let { IMAGE_o, .. } := D.ts.cn.cx.cvx.core2
  let { o_DEF, .. } := D.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, LIFT_ADD, LIFT_CMUL, LIFT_DROP, .. } := D.ts.cn.cx.cvx.vec2
  let { LIFT_NEG, .. } := D.ts.cn.ms.ig.dv.dg.qvec
  let { DROP_NEG, .. } := D.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  let HAS_BOUNDED_REAL_VARIATION_AFFINITY2_EQ ← prove
   r"!m c f s.
        (\x. f (m * x + c)) has_bounded_real_variation_on


        IMAGE (\x. inv m * x + --(inv m * c)) s <=>
        m = &0 \/ f has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"m:real", ← q r"lift c", ← q r"lift o f o drop",
                      ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_AFFINITY2_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
     DROP_ADD, DROP_CMUL, LIFT_ADD, LIFT_CMUL, LIFT_NEG, LIFT_DROP])

  let REAL_VARIATION_AFFINITY2 ← prove
   r"!m c f s.
        real_variation (IMAGE (\x. inv m * x + --(inv m * c)) s)
                       (\x. f (m * x + c)) =
        if m = &0 then &0 else real_variation s f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"m:real", ← q r"lift c", ← q r"lift o f o drop",
                      ← q r"IMAGE lift s"]
           VECTOR_VARIATION_AFFINITY2) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
     DROP_ADD, DROP_CMUL, LIFT_ADD, LIFT_CMUL, LIFT_NEG, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_AFFINITY_EQ ← prove
   r"!m c f s.
        (\x. f (m * x + c)) has_bounded_real_variation_on s <=>
        m = &0 \/ f has_bounded_real_variation_on IMAGE (\x. m * x + c) s"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"m:real", ← q r"lift c", ← q r"lift o f o drop",
                      ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_AFFINITY_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
     DROP_ADD, DROP_CMUL, LIFT_ADD, LIFT_CMUL, LIFT_NEG, LIFT_DROP])

  let REAL_VARIATION_AFFINITY ← prove
   r"!m c f s.
        real_variation s (\x. f (m * x + c)) =
        if m = &0 then &0 else real_variation (IMAGE (\x. m * x + c) s) f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"m:real", ← q r"lift c", ← q r"lift o f o drop",
                      ← q r"IMAGE lift s"]
           VECTOR_VARIATION_AFFINITY) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
     DROP_ADD, DROP_CMUL, LIFT_ADD, LIFT_CMUL, LIFT_NEG, LIFT_DROP])

  let HAS_BOUNDED_REAL_VARIATION_TRANSLATION2_EQ ← prove
   r"!a f s.
      (\x. f(a + x)) has_bounded_real_variation_on (IMAGE (\x. --a + x) s) <=>
      f has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift a", ← q r"lift o f o drop", ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_TRANSLATION2_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
                 DROP_ADD, LIFT_DROP, LIFT_ADD, LIFT_NEG])

  let REAL_VARIATION_TRANSLATION2 ← prove
   r"!a f s. real_variation (IMAGE (\x. --a + x) s) (\x. f(a + x)) =
           real_variation s f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift a", ← q r"lift o f o drop", ← q r"IMAGE lift s"]
          VECTOR_VARIATION_TRANSLATION2) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
                 DROP_ADD, LIFT_DROP, LIFT_ADD, LIFT_NEG])

  let HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ ← prove
   r"!a f s. (\x. f(a + x)) has_bounded_real_variation_on s <=>
           f has_bounded_real_variation_on (IMAGE (\x. a + x) s)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift a", ← q r"lift o f o drop", ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_TRANSLATION_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
                 DROP_ADD, LIFT_DROP, LIFT_ADD, LIFT_NEG])

  let REAL_VARIATION_TRANSLATION ← prove
   r"!a f s. real_variation s (\x. f(a + x)) =
           real_variation (IMAGE (\x. a + x) s) f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift a", ← q r"lift o f o drop", ← q r"IMAGE lift s"]
          VECTOR_VARIATION_TRANSLATION_ALT) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
                 DROP_ADD, LIFT_DROP, LIFT_ADD, LIFT_NEG])

  let HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ_INTERVAL ← prove
   r"!a f u v.
        (\x. f(a + x)) has_bounded_real_variation_on real_interval[u,v] <=>
        f has_bounded_real_variation_on real_interval[a+u,a+v]"
   (REWRITE_TAC [REAL_INTERVAL_TRANSLATION,
                 HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ])

  let REAL_VARIATION_TRANSLATION_INTERVAL ← prove
   r"!a f u v.
        real_variation (real_interval[u,v]) (\x. f(a + x)) =
        real_variation (real_interval[a+u,a+v]) f"
   (REWRITE_TAC [REAL_INTERVAL_TRANSLATION,
                   REAL_VARIATION_TRANSLATION])

  let HAS_BOUNDED_REAL_VARIATION_TRANSLATION ← prove
   r"!f s a. f has_bounded_real_variation_on s
           ==> (\x. f(a + x)) has_bounded_real_variation_on
               (IMAGE (\x. --a + x) s)"
   (REWRITE_TAC [HAS_BOUNDED_REAL_VARIATION_TRANSLATION2_EQ])

  let HAS_BOUNDED_REAL_VARIATION_REFLECT2_EQ ← prove
   r"!f s. (\x. f(--x)) has_bounded_real_variation_on (IMAGE (--) s) <=>
         f has_bounded_real_variation_on s"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_REFLECT2_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
                 DROP_NEG, LIFT_DROP, LIFT_NEG])

  let REAL_VARIATION_REFLECT2 ← prove
   r"!f s. real_variation (IMAGE (--) s) (\x. f(--x)) =
         real_variation s f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          VECTOR_VARIATION_REFLECT2) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
                 DROP_NEG, LIFT_DROP, LIFT_NEG])

  let HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ ← prove
   r"!f s. (\x. f(--x)) has_bounded_real_variation_on s <=>
         f has_bounded_real_variation_on (IMAGE (--) s)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          HAS_BOUNDED_VARIATION_REFLECT_EQ) THEN
    REWRITE_TAC [o_DEF, has_bounded_real_variation_on, ← GSYM IMAGE_o,
                 DROP_NEG, LIFT_DROP, LIFT_NEG])

  let REAL_VARIATION_REFLECT ← prove
   r"!f s. real_variation s (\x. f(--x)) =
         real_variation (IMAGE (--) s) f"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          VECTOR_VARIATION_REFLECT) THEN
    REWRITE_TAC [o_DEF, real_variation, ← GSYM IMAGE_o,
                 DROP_NEG, LIFT_DROP, LIFT_NEG])

  let HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ_INTERVAL ← prove
   r"!f u v. (\x. f(--x)) has_bounded_real_variation_on real_interval[u,v] <=>
           f has_bounded_real_variation_on real_interval[--v,--u]"
   (REWRITE_TAC [← GSYM REFLECT_REAL_INTERVAL,
                 HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ])

  let REAL_VARIATION_REFLECT_INTERVAL ← prove
   r"!f u v. real_variation (real_interval[u,v]) (\x. f(--x)) =
           real_variation (real_interval[--v,--u]) f"
   (REWRITE_TAC [← GSYM REFLECT_REAL_INTERVAL, REAL_VARIATION_REFLECT])

  pure { HAS_BOUNDED_REAL_VARIATION_AFFINITY2_EQ, REAL_VARIATION_AFFINITY2,
         HAS_BOUNDED_REAL_VARIATION_AFFINITY_EQ, REAL_VARIATION_AFFINITY,
         HAS_BOUNDED_REAL_VARIATION_TRANSLATION2_EQ, REAL_VARIATION_TRANSLATION2,
         HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ, REAL_VARIATION_TRANSLATION,
         HAS_BOUNDED_REAL_VARIATION_TRANSLATION_EQ_INTERVAL,
         REAL_VARIATION_TRANSLATION_INTERVAL, HAS_BOUNDED_REAL_VARIATION_TRANSLATION,
         HAS_BOUNDED_REAL_VARIATION_REFLECT2_EQ, REAL_VARIATION_REFLECT2,
         HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ, REAL_VARIATION_REFLECT,
         HAS_BOUNDED_REAL_VARIATION_REFLECT_EQ_INTERVAL,
         REAL_VARIATION_REFLECT_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Bounded real variation: Darboux decomposition, one-sided limits,          -/
/- continuity of the variation.                                              -/
/- (realanalysis.ml 17414-17579)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZCC where
  HAS_BOUNDED_REAL_VARIATION_DARBOUX : thm
  HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRICT : thm
  INCREASING_LEFT_LIMIT : thm
  DECREASING_LEFT_LIMIT : thm
  INCREASING_RIGHT_LIMIT : thm
  DECREASING_RIGHT_LIMIT : thm
  HAS_BOUNDED_REAL_VARIATION_LEFT_LIMIT : thm
  HAS_BOUNDED_REAL_VARIATION_RIGHT_LIMIT : thm
  REAL_VARIATION_CONTINUOUS_LEFT : thm
  REAL_VARIATION_CONTINUOUS_RIGHT : thm
  REAL_VARIATION_CONTINUOUS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZCC [HolBase] (D : RealAnalysisDeps) (BRZA : RZA) (BRZG : RZG) (BRZN : RZN) (BRZCA : RZCA) : ExceptT String IO RZCC := do
  -- @@SCOPE BEGIN
  let { TENDSTO_REAL, .. } := BRZA
  let { LIM_WITHINREAL_WITHIN, .. } := BRZG
  let { REAL_CONTINUOUS_CONTINUOUS_WITHINREAL, .. } := BRZN
  let { has_bounded_real_variation_on, real_variation, .. } := BRZCA
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.qtopology
  let { DECREASING_LEFT_LIMIT_1, DECREASING_RIGHT_LIMIT_1,
        HAS_BOUNDED_VARIATION_DARBOUX_STRICT, HAS_BOUNDED_VECTOR_VARIATION_LEFT_LIMIT,
        HAS_BOUNDED_VECTOR_VARIATION_RIGHT_LIMIT, INCREASING_LEFT_LIMIT_1,
        INCREASING_RIGHT_LIMIT_1, VECTOR_VARIATION_CONTINUOUS,
        VECTOR_VARIATION_CONTINUOUS_LEFT, VECTOR_VARIATION_CONTINUOUS_RIGHT,
        .. } := D.qintegration
  let { HAS_BOUNDED_VARIATION_DARBOUX, .. } := D.ts.cn.ms.qintegration2
  let { CONJ_ASSOC, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.ts.cn.cx.cvx.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.ts.cn.cx.cvx.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, .. } := D.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, .. } := D.ts.cn.cx.cvx.core6
  let { EXISTS_LIFT, FORALL_DROP, LIFT_DROP, LIFT_EQ, LIFT_SUB, .. } := D.ts.cn.cx.cvx.vec2
  -- @@SCOPE END

  let HAS_BOUNDED_REAL_VARIATION_DARBOUX ← prove
   r"!f a b.
     f has_bounded_real_variation_on real_interval[a,b] <=>
     ?g h. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> g x <= g y) /\
           (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                  ==> h x <= h y) /\
           (!x. f x = g x - h x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_DARBOUX, IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE,
                 ← GSYM IMAGE_LIFT_REAL_INTERVAL, LIFT_DROP] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"drop o h o lift"] THEN
      ASM_REWRITE_TAC [o_THM] THEN REWRITE_TAC [← GSYM LIFT_EQ, FORALL_DROP] THEN
      ASM_REWRITE_TAC [LIFT_DROP, LIFT_SUB],
      MAP_EVERY X_GEN_TAC [← q r"g:real->real", ← q r"h:real->real"] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"lift o g o drop", ← q r"lift o h o drop"] THEN
      ASM_REWRITE_TAC [o_THM, LIFT_DROP] THEN REWRITE_TAC [LIFT_SUB]])

  let HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRICT ← prove
   r"!f a b.
     f has_bounded_real_variation_on real_interval[a,b] <=>
     ?g h. (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x < y
                  ==> g x < g y) /\
           (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x < y
                  ==> h x < h y) /\
           (!x. f x = g x - h x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_DARBOUX_STRICT,
                 IMAGE_LIFT_REAL_INTERVAL] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE,
                 ← GSYM IMAGE_LIFT_REAL_INTERVAL, LIFT_DROP] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"drop o g o lift", ← q r"drop o h o lift"] THEN
      ASM_REWRITE_TAC [o_THM] THEN REWRITE_TAC [← GSYM LIFT_EQ, FORALL_DROP] THEN
      ASM_REWRITE_TAC [LIFT_DROP, LIFT_SUB],
      MAP_EVERY X_GEN_TAC [← q r"g:real->real", ← q r"h:real->real"] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"lift o g o drop", ← q r"lift o h o drop"] THEN
      ASM_REWRITE_TAC [o_THM, LIFT_DROP] THEN REWRITE_TAC [LIFT_SUB]])

  let INCREASING_LEFT_LIMIT ← prove
   r"!f a b c.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f x <= f y) /\
        c IN real_interval[a,b]
       ==> ?l. (f ---> l) (atreal c within real_interval[a,c])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC INCREASING_LEFT_LIMIT_1 THEN EXISTS_TAC (← q r"lift b") THEN
    SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, FUN_IN_IMAGE])

  let DECREASING_LEFT_LIMIT ← prove
   r"!f a b c.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f y <= f x) /\
        c IN real_interval[a,b]
        ==> ?l. (f ---> l) (atreal c within real_interval[a,c])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC DECREASING_LEFT_LIMIT_1 THEN EXISTS_TAC (← q r"lift b") THEN
    SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, FUN_IN_IMAGE])

  let INCREASING_RIGHT_LIMIT ← prove
   r"!f a b c.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f x <= f y) /\
        c IN real_interval[a,b]
       ==> ?l. (f ---> l) (atreal c within real_interval[c,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC INCREASING_RIGHT_LIMIT_1 THEN EXISTS_TAC (← q r"lift a") THEN
    SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, FUN_IN_IMAGE])

  let DECREASING_RIGHT_LIMIT ← prove
   r"!f a b c.
        (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
               ==> f y <= f x) /\
        c IN real_interval[a,b]
        ==> ?l. (f ---> l) (atreal c within real_interval[c,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC DECREASING_RIGHT_LIMIT_1 THEN EXISTS_TAC (← q r"lift a") THEN
    SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM, LIFT_DROP, FUN_IN_IMAGE])

  let HAS_BOUNDED_REAL_VARIATION_LEFT_LIMIT ← prove
   r"!f a b c.
        f has_bounded_real_variation_on real_interval[a,b] /\
        c IN real_interval[a,b]
        ==> ?l. (f ---> l) (atreal c within real_interval[a,c])"
   (REWRITE_TAC [has_bounded_real_variation_on] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC HAS_BOUNDED_VECTOR_VARIATION_LEFT_LIMIT THEN
    EXISTS_TAC (← q r"lift b") THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, ← GSYM o_ASSOC, FUN_IN_IMAGE])

  let HAS_BOUNDED_REAL_VARIATION_RIGHT_LIMIT ← prove
   r"!f a b c.
        f has_bounded_real_variation_on real_interval[a,b] /\
        c IN real_interval[a,b]
        ==> ?l. (f ---> l) (atreal c within real_interval[c,b])"
   (REWRITE_TAC [has_bounded_real_variation_on] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [TENDSTO_REAL, ← GSYM EXISTS_LIFT] THEN
    REWRITE_TAC [LIM_WITHINREAL_WITHIN, IMAGE_LIFT_REAL_INTERVAL] THEN
    MATCH_MP_TAC HAS_BOUNDED_VECTOR_VARIATION_RIGHT_LIMIT THEN
    EXISTS_TAC (← q r"lift a") THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, ← GSYM o_ASSOC, FUN_IN_IMAGE])

  let REAL_VARIATION_CONTINUOUS_LEFT ← prove
   r"!f a b c.
        f has_bounded_real_variation_on real_interval[a,b] /\
        c IN real_interval[a,b]
        ==> ((\x. real_variation(real_interval[a,x]) f)
             real_continuous (atreal c within real_interval[a,c]) <=>
            f real_continuous (atreal c within real_interval[a,c]))"
   (REWRITE_TAC [has_bounded_real_variation_on, real_variation] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL,
          REAL_CONTINUOUS_CONTINUOUS_WITHINREAL] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"lift b") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, FUN_IN_IMAGE])

  let REAL_VARIATION_CONTINUOUS_RIGHT ← prove
   r"!f a b c.
        f has_bounded_real_variation_on real_interval[a,b] /\
        c IN real_interval[a,b]
        ==> ((\x. real_variation(real_interval[a,x]) f)
             real_continuous (atreal c within real_interval[c,b]) <=>
            f real_continuous (atreal c within real_interval[c,b]))"
   (REWRITE_TAC [has_bounded_real_variation_on, real_variation] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL,
          REAL_CONTINUOUS_CONTINUOUS_WITHINREAL] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_CONTINUOUS_RIGHT THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, FUN_IN_IMAGE])

  let REAL_VARIATION_CONTINUOUS ← prove
   r"!f a b c.
        f has_bounded_real_variation_on real_interval[a,b] /\
        c IN real_interval[a,b]
        ==> ((\x. real_variation(real_interval[a,x]) f)
             real_continuous (atreal c within real_interval[a,b]) <=>
            f real_continuous (atreal c within real_interval[a,b]))"
   (REWRITE_TAC [has_bounded_real_variation_on, real_variation] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL,
          REAL_CONTINUOUS_CONTINUOUS_WITHINREAL] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_CONTINUOUS THEN
    ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, FUN_IN_IMAGE])

  pure { HAS_BOUNDED_REAL_VARIATION_DARBOUX, HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRICT,
         INCREASING_LEFT_LIMIT, DECREASING_LEFT_LIMIT, INCREASING_RIGHT_LIMIT,
         DECREASING_RIGHT_LIMIT, HAS_BOUNDED_REAL_VARIATION_LEFT_LIMIT,
         HAS_BOUNDED_REAL_VARIATION_RIGHT_LIMIT, REAL_VARIATION_CONTINUOUS_LEFT,
         REAL_VARIATION_CONTINUOUS_RIGHT, REAL_VARIATION_CONTINUOUS }

/- ------------------------------------------------------------------------- -/
/- Bounded real variation: strong Darboux decomposition, discontinuities,    -/
/- Lebesgue differentiation; Lebesgue density theorem.                       -/
/- (realanalysis.ml 17580-17757)                                            -/
/- ------------------------------------------------------------------------- -/

structure RZCD where
  HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRONG : thm
  HAS_BOUNDED_REAL_VARIATION_COUNTABLE_DISCONTINUITIES : thm
  REAL_INTEGRABLE_REAL_BOUNDED_VARIATION_PRODUCT : thm
  REAL_LEBESGUE_DIFFERENTIATION_THEOREM : thm
  REAL_LEBESGUE_DIFFERENTIATION_THEOREM_ALT : thm
  REAL_LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING : thm
  REAL_LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING : thm
  LEBESGUE_DENSITY_THEOREM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupRZCD [HolBase] (D : RealAnalysisDeps) (BRZF : RZF) (BRZH : RZH) (BRZL : RZL) (BRZN : RZN) (BRZAK : RZAK) (BRZCA : RZCA) (BRZCC : RZCC) : ExceptT String IO RZCD := do
  -- @@SCOPE BEGIN
  let { REALLIM_WITHINREAL, .. } := BRZF
  let { REAL_CONTINUOUS_ADD, REAL_CONTINUOUS_SUB, REAL_CONTINUOUS_WITHIN_ID, .. } := BRZH
  let { REAL_DIFFERENTIABLE_AT, .. } := BRZL
  let { REAL_CONTINUOUS_CONTINUOUS_ATREAL, .. } := BRZN
  let { REAL_INTEGRABLE_ON, real_negligible, .. } := BRZAK
  let { has_bounded_real_variation_on, HAS_BOUNDED_REAL_VARIATION_ON_SUBSET,
        REAL_VARIATION_MINUS_FUNCTION_MONOTONE, REAL_VARIATION_MONOTONE, .. } := BRZCA
  let { REAL_VARIATION_CONTINUOUS, REAL_VARIATION_CONTINUOUS_LEFT,
        REAL_VARIATION_CONTINUOUS_RIGHT, .. } := BRZCC
  let { IMAGE_LIFT_REAL_INTERVAL, IS_REALINTERVAL_IS_INTERVAL, .. } := D.qtopology
  let { IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY, SUBSET_REAL_INTERVAL, .. } := D.qmisc
  let { LEBESGUE_DENSITY_THEOREM_LIFT_CBALL, LEBESGUE_DIFFERENTIATION_THEOREM,
        LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING,
        LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING, .. } := D.qmeasure
  let { INTEGRABLE_BOUNDED_VARIATION_PRODUCT, .. } := D.qintegration
  let { HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES, .. } := D.ts.cn.ms.qintegration2
  let { NEGLIGIBLE_SUBSET, .. } := D.ts.cn.ms.qintegration3
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_TAC, .. } := D.ts.cn.cx.cvx
  let { COUNTABLE_SUBSET, .. } := D.ts.cn.ms.ig.qcard
  let { COND_RAND, CONJ_ASSOC, EXISTS_IN_IMAGE, .. } := D.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, .. } := D.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, MONO_EXISTS, .. } := D.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD2, .. } := D.ts.cn.cx.cvx.core4
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_RESTRICT, .. } := D.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, UNWIND_THM1, .. } := D.ts.cn.cx.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ts.cn.cx.cvx.lib
  let { DIST_1, .. } := D.ts.cn.cx.cvx.vec1
  let { DROP_VEC, EXISTS_DROP, EXISTS_LIFT, FORALL_LIFT, LIFT_CMUL, LIFT_DROP,
        .. } := D.ts.cn.cx.cvx.vec2
  let { LIM_WITHIN, .. } := D.ts.cn.cx.cvx.top4
  let { REAL_LTE_ADD2, .. } := D.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRONG ← prove
   r"!f a b.
     f has_bounded_real_variation_on real_interval[a,b]
     ==> ?g h.
          (!x. f x = g x - h x) /\
          (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                 ==> g x <= g y) /\
          (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x <= y
                 ==> h x <= h y) /\
          (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x < y
                 ==> g x < g y) /\
          (!x y. x IN real_interval[a,b] /\ y IN real_interval[a,b] /\ x < y
                 ==> h x < h y) /\
          (!x. x IN real_interval[a,b] /\
               f real_continuous (atreal x within real_interval[a,x])
               ==> g real_continuous (atreal x within real_interval[a,x]) /\
                   h real_continuous (atreal x within real_interval[a,x])) /\
          (!x. x IN real_interval[a,b] /\
               f real_continuous (atreal x within real_interval[x,b])
               ==> g real_continuous (atreal x within real_interval[x,b]) /\
                   h real_continuous (atreal x within real_interval[x,b])) /\
          (!x. x IN real_interval[a,b] /\
               f real_continuous (atreal x within real_interval[a,b])
               ==> g real_continuous (atreal x within real_interval[a,b]) /\
                   h real_continuous (atreal x within real_interval[a,b]))"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x. x + real_variation (real_interval[a,x]) f",
      ← q r"\x. x + real_variation (real_interval[a,x]) f - f x"] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(x + l) - (x + l - f):real = f")] THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_VARIATION_MONOTONE,
      MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!x. a - (b - x) <= c - (d - x) ==> a - b <= c - d")) THEN
      EXISTS_TAC (← q r"(f:real->real) a") THEN
      MATCH_MP_TAC REAL_VARIATION_MINUS_FUNCTION_MONOTONE,
      MATCH_MP_TAC REAL_LTE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_VARIATION_MONOTONE,
      MATCH_MP_TAC REAL_LTE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!x. a - (b - x) <= c - (d - x) ==> a - b <= c - d")) THEN
      EXISTS_TAC (← q r"(f:real->real) a") THEN
      MATCH_MP_TAC REAL_VARIATION_MINUS_FUNCTION_MONOTONE,
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS_LEFT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS_LEFT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS_RIGHT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS_RIGHT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC REAL_CONTINUOUS_ADD THEN
      REWRITE_TAC [REAL_CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC REAL_CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real->real", ← q r"a:real", ← q r"b:real", ← q r"x:real"]
          REAL_VARIATION_CONTINUOUS) THEN
      ASM_REWRITE_TAC []] THEN
    (CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         HAS_BOUNDED_REAL_VARIATION_ON_SUBSET)),
        ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
      REWRITE_TAC [SUBSET_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY] THEN
      ASM_REAL_ARITH_TAC))

  let HAS_BOUNDED_REAL_VARIATION_COUNTABLE_DISCONTINUITIES ← prove
   r"!f s. f has_bounded_real_variation_on s /\ is_realinterval s
           ==> COUNTABLE {x | x IN s /\ ~(f real_continuous atreal x)}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_real_variation_on] THEN
    REWRITE_TAC [REAL_CONTINUOUS_CONTINUOUS_ATREAL] THEN
    REWRITE_TAC [IS_REALINTERVAL_IS_INTERVAL] THEN DISCH_THEN (MP_TAC o
      MATCH_MP HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES) THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"drop") o MATCH_MP COUNTABLE_IMAGE) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_IMAGE, EXISTS_LIFT, LIFT_DROP, UNWIND_THM1] THEN
    REWRITE_TAC [← GSYM IMAGE_LIFT_REAL_INTERVAL, IN_ELIM_THM] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, ← GSYM CONJ_ASSOC, EXISTS_DROP, LIFT_DROP] THEN
    MESON_TAC [LIFT_DROP])

  let REAL_INTEGRABLE_REAL_BOUNDED_VARIATION_PRODUCT ← prove
   r"!f g a b.
        f real_integrable_on real_interval[a,b] /\
        g has_bounded_real_variation_on real_interval[a,b]
        ==> (\x. g x * f x) real_integrable_on real_interval[a,b]"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_real_variation_on, REAL_INTEGRABLE_ON] THEN
    REWRITE_TAC [IMAGE_LIFT_REAL_INTERVAL, o_DEF, LIFT_CMUL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_BOUNDED_VARIATION_PRODUCT) THEN
    REWRITE_TAC [LIFT_DROP])

  let REAL_LEBESGUE_DIFFERENTIATION_THEOREM ← prove
   r"!f s. is_realinterval s /\ f has_bounded_real_variation_on s
           ==> real_negligible
                 {x | x IN s /\ ~(f real_differentiable atreal x)}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_negligible] THEN
    REWRITE_TAC [has_bounded_real_variation_on, IS_REALINTERVAL_IS_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_DIFFERENTIATION_THEOREM) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [REAL_DIFFERENTIABLE_AT] THEN SET_TAC [])

  let REAL_LEBESGUE_DIFFERENTIATION_THEOREM_ALT ← prove
   r"!f s. is_realinterval s /\ f has_bounded_real_variation_on s
         ==> ?t. t SUBSET s /\ real_negligible t /\
                 !x. x IN s DIFF t ==> f real_differentiable atreal x"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"{x | x IN s /\ ~(f real_differentiable atreal x)}") THEN
    ASM_SIMP_TAC [REAL_LEBESGUE_DIFFERENTIATION_THEOREM, SUBSET_RESTRICT] THEN
    REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN CONV_TAC (fun t => TAUT t))

  let REAL_LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING ← prove
   r"!f s. is_realinterval s /\
         (!x y. x IN s /\ y IN s /\ x <= y ==> f x <= f y)
         ==> real_negligible
                 {x | x IN s /\ ~(f real_differentiable atreal x)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [← GSYM IS_REALINTERVAL_IS_INTERVAL, o_THM, LIFT_DROP] THEN
    REWRITE_TAC [real_negligible] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [REAL_DIFFERENTIABLE_AT] THEN SET_TAC [])

  let REAL_LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING ← prove
   r"!f s. is_realinterval s /\
         (!x y. x IN s /\ y IN s /\ x <= y ==> f y <= f x)
         ==> real_negligible
                 {x | x IN s /\ ~(f real_differentiable atreal x)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"lift o f o drop", ← q r"IMAGE lift s"]
          LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [← GSYM IS_REALINTERVAL_IS_INTERVAL, o_THM, LIFT_DROP] THEN
    REWRITE_TAC [real_negligible] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [REAL_DIFFERENTIABLE_AT] THEN SET_TAC [])

  -- Lebesgue density theorem. This isn't about R specifically, but it's most
  -- naturally stated as a real limit so it ends up here in this file.

  let LEBESGUE_DENSITY_THEOREM ← prove
   r"!s:real^N->bool.
      lebesgue_measurable s
      ==> ?k. negligible k /\
              !x. ~(x IN k)
                  ==> ((\e. measure(s INTER cball(x,e)) / measure(cball(x,e)))
                       ---> (if x IN s then &1 else &0))
                      (atreal(&0) within {e | &0 < e})"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_DENSITY_THEOREM_LIFT_CBALL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REWRITE_TAC [REALLIM_WITHINREAL, LIM_WITHIN] THEN
    REWRITE_TAC [FORALL_LIFT, IN_ELIM_THM, LIFT_DROP, DIST_1] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RAND] THEN
    REWRITE_TAC [DROP_VEC])

  pure { HAS_BOUNDED_REAL_VARIATION_DARBOUX_STRONG,
         HAS_BOUNDED_REAL_VARIATION_COUNTABLE_DISCONTINUITIES,
         REAL_INTEGRABLE_REAL_BOUNDED_VARIATION_PRODUCT,
         REAL_LEBESGUE_DIFFERENTIATION_THEOREM, REAL_LEBESGUE_DIFFERENTIATION_THEOREM_ALT,
         REAL_LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING,
         REAL_LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING, LEBESGUE_DENSITY_THEOREM }

end HolMultiLib.RealAnalysis
