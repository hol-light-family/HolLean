set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCV [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSH : MSH) (BMSJ : MSJ) (BMSN : MSN) (BMST : MST) (BMSAJ : MSAJ) (BMSAL : MSAL) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBB : MSBB) (BMSBU : MSBU) (BMSCQ : MSCQ) (BMSCS : MSCS) : ExceptT String IO MSCV := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURABLE_UNION, MEASURE_INTERVAL_1, MEASURE_SUBSET,
        MEASURE_UNIQUE, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_UNIONS, MEASURE_NEGLIGIBLE_SYMDIFF,
        NEGLIGIBLE_EQ_MEASURE_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURE_UNIONS_LE_IMAGE, NEGLIGIBLE_OUTER, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. } := BMSF
  let { HAS_MEASURE_ELEMENTARY, MEASURABLE_COMPACT, .. } := BMSG
  let { HALF_MEASURES, .. } := BMSH
  let { MEASURABLE_SEGMENT, MEASURE_SEGMENT_1, .. } := BMSJ
  let { MEASURABLE_OUTER_CLOSED_INTERVALS, .. } := BMSN
  let { MEASURE_ISOMETRY, .. } := BMST
  let { NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE, .. } := BMSAJ
  let { NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE_LOWDIM, .. } := BMSAL
  let { MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { MEASURABLE_LINEAR_IMAGE_GEN,
        PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE, .. } := BMSBB
  let { MEASURE_DIFFERENTIABLE_IMAGE, .. } := BMSBU
  let { ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT, .. } := BMSCQ
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE, .. } := BMSCS
  let { DIFFERENTIABLE_COMPONENTWISE_WITHIN, DIFFERENTIABLE_WITHIN_SUBSET,
        .. } := D.qderivatives
  let { DET_1, .. } := D.qdet
  let { ABSOLUTELY_CONTINUOUS_COMPARISON, ABSOLUTELY_CONTINUOUS_EXTENDS_TO_CLOSURE,
        ABSOLUTELY_CONTINUOUS_ON_COMPONENTWISE, ABSOLUTELY_CONTINUOUS_ON_COMPOSE_LINEAR,
        ABSOLUTELY_CONTINUOUS_ON_EQ, ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS, ABSOLUTELY_CONTINUOUS_ON_SUBSET,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL, CONTENT_EQ_0_INTERIOR, CONTENT_SUBSET,
        CONTINUOUS_BV_IMP_UNIFORMLY_CONTINUOUS, .. } := D.qintegration1
  let { HAS_BOUNDED_VARIATION_ON_CLOSURE, HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
        HAS_BOUNDED_VARIATION_ON_EQ, INTEGRABLE_SPIKE_SET, INTEGRABLE_SUBINTERVAL,
        .. } := D.qintegration2
  let { absolutely_continuous_on, absolutely_setcontinuous_on, division_of,
        INTEGRAL_COMBINE, INTEGRAL_SPIKE_SET, INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1,
        NEGLIGIBLE_COUNTABLE, NEGLIGIBLE_INSERT, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ,
        .. } := D.qintegration3
  let { COUNTABLE_RESTRICT, .. } := D.qcard
  let { REAL_ARCH_POW, real_min, .. } := D.qsession
  let { CONNECTED_CLOSURE, .. } := D.qtopology1
  let { CONNECTED_COMPACT_INTERVAL_1, CONNECTED_CONVEX_1, CONVEX_INTERIOR_CLOSURE,
        .. } := D.ig.qconvex
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, .. } := D.ig.qderivatives
  let { COUNTABLE_EMPTY, .. } := D.ig.qcard
  let { LEFT_AND_FORALL_THM, SUM_IMAGE_NONZERO, .. } := D.ig.qsession
  let { EQ_INTERVAL_1, INTERIOR_INTERVAL, IS_INTERVAL_INTER, OPEN_CLOSED_INTERVAL_1,
        UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS,
        .. } := D.ig.qtopology
  let { CONNECTED_INTERVAL, .. } := D.ig.dv.qconvex
  let { matrix, .. } := D.ig.dv.qvec
  let { IS_INTERVAL_CONNECTED_1, .. } := D.ig.dv.dg.qconvex
  let { I_DEF, I_O_ID, .. } := D.ig.dv.dg.qsession
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, .. } := D.ig.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_CLOSURE, .. } := D.ig.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, SEGMENT_CONVEX_HULL, .. } := D.ig.dv.dg.pt.qcvx3
  let { AND_FORALL_THM, ARITH, CONJ_ASSOC, CONJ_SYM, DIFF_EMPTY, DIMINDEX_1, DIMINDEX_GE_1,
        EMPTY_SUBSET, EQ_IMP, FINITE_IMAGE, FORALL_FINITE_SUBSET_IMAGE,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ, IMAGE_o, IMAGE_SUBSET,
