       (← q r"dd = UNIONS { {x | ~(?l. ((\t. inv(drop t) %
                                       ((f:real^M->real^1)(x + drop t % v) - f x))
                                  --> l) (at (vec 0)))}
                     | v IN qq}") THEN
      SUBGOAL_THEN
       (← q r"!x v. ~(x IN dd)
              ==> ?l. ((\t. inv(drop t) %
                            ((f:real^M->real^1)(x + drop t % v) - f x))
