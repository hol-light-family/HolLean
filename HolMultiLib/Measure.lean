        MATCH_MP_TAC MEASURABLE_INTER THEN CONJ_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_IMP_MEASURABLE) THENL
         [ASM_SIMP_TAC [MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GE],
