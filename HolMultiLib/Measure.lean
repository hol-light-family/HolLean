       (← q r"(\x:real^N. (t n * (&1 - e)) % x) =
        (\x. t(n:num) % x) o (\x. (&1 - e) % x)")
      SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, VECTOR_MUL_ASSOC, REAL_MUL_SYM], ALL_TAC] THEN
      REWRITE_TAC [IMAGE_o] THEN ONCE_REWRITE_TAC [← GSYM IMAGE_o] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"IMAGE f s INTER t = {} <=> !x. f x IN t ==> ~(x IN s)")] THEN
      X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"\y:real^N. inv(t(n:num)) % (y - b n)") o
       MATCH_MP FUN_IN_IMAGE) THEN
      REWRITE_TAC [o_DEF, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC, ← GSYM IMAGE_o] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, REAL_LT_IMP_NZ, VECTOR_MUL_LID] THEN
      SPEC_TAC ((← q r"y:real^N"), (← q r"y:real^N")) THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o funpow 3 RAND_CONV)
        [← GSYM th])) THEN
      ASM_SIMP_TAC [INTERIOR_AFFINITY, REAL_LT_IMP_NZ] THEN
      ASM_SIMP_TAC [FRONTIER_AFFINITY, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"v:real^N") THEN
      SUBGOAL_THEN
       (← q r"frontier(interior A):real^N->bool = frontier A")
      SUBST1_TAC THENL
       [REWRITE_TAC [frontier, INTERIOR_INTERIOR] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC CONVEX_CLOSURE_INTERIOR THEN ASM_REWRITE_TAC [],
        DISCH_TAC] THEN
      SUBGOAL_THEN
       (← q r"(\x. (&1 - e) % (f':real^N->real^N->real^N) a x) =
        (\x. (&1 - e) % x) o (f' a)")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], REWRITE_TAC [← GSYM IMAGE_o]] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"!t. s SUBSET t /\ ~(x IN IMAGE f t) ==> ~(x IN IMAGE f s)")) THEN
      EXISTS_TAC (← q r"A:real^N->bool") THEN
      REWRITE_TAC [INTERIOR_SUBSET, IMAGE_o] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [EXISTS_IN_IMAGE] THEN
      EXISTS_TAC (← q r"v:real^N") THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"y = t n % v + (z:num->real^N) n") THEN
      SUBGOAL_THEN (← q r"y IN (c:num->real^N->bool) n") ASSUME_TAC THENL
       [FIRST_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
        EXPAND_TAC "y" THEN REWRITE_TAC [IN_IMAGE] THEN
        EXISTS_TAC (← q r"v:real^N") THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
         (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
        REWRITE_TAC [FRONTIER_SUBSET_EQ] THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"norm(y - a:real^N) <= &2 * M * t(n:num)") ASSUME_TAC THENL
       [EXPAND_TAC "y" THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(x) <= m /\ norm(z - y) <= m
          ==> norm((x + y) - z:real^N) <= &2 * m")) THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [NORM_MUL, real_abs, REAL_LT_IMP_LE, REAL_LE_LMUL_EQ] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_X_ASSUM
         (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
        REWRITE_TAC [FRONTIER_SUBSET_EQ] THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
        ALL_TAC]] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN
    EXISTS_TAC (← q r"abs((t:num->real) n)") THEN REWRITE_TAC [← GSYM NORM_MUL] THEN
    REWRITE_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_RINV, real_abs, REAL_LT_IMP_LE, REAL_LT_IMP_NZ] THEN
    EXPAND_TAC "b" THEN REWRITE_TAC [← VECTOR_ARITH
     (← q r"&1 % y - &1 % (x + z) - w:real^N = y - x - (w + z)")] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP LINEAR_SUB th])) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_CMUL th)])) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + b - c:real^N = (a + b) - c")] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_ADD th)])) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP LINEAR_SUB th)])) THEN
    REMOVE_THEN "D" (MP_TAC o SPEC (← q r"y:real^N")) THEN
    GEN_REWRITE_TAC (funpow 3 LAND_CONV) [← GSYM dist] THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [← GSYM IN_BALL] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    TRANS_TAC REAL_LE_TRANS (← q r"k / M / &2 * &2 * M * t(n:num)") THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_DIV, REAL_HALF] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < M ==> k / M / &2 * &2 * M * t = t * k")] THEN
    REWRITE_TAC [REAL_LE_REFL])

  let MEASURE_DIFFERENTIABLE_IMAGE_APPROX ← prove
   r"!f:real^N->real^N f' s c a.
        open s /\ a IN s /\
        (!x. x IN s
             ==> (f has_derivative f' x) (at x) /\
                 ~(det(matrix (f' x)) = &0)) /\
        ((\n. lift(diameter (c n))) --> vec 0) sequentially /\
        (!n. a IN closure(c n)) /\
        (?A. convex A /\ bounded A /\ ~(interior A = {}) /\
             !n. ?t z. &0 < t /\ IMAGE (\x. t % x + z) A = c n)
        ==> eventually (\n. measurable(IMAGE f (c n))) sequentially /\
            ((\n. lift(measure(IMAGE f (c n)) / measure(c n)))
             --> lift(abs(det(matrix(f' a))))) sequentially"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"matrix(f' a) = jacobian (f:real^N->real^N) (at a)")
     (fun th => tactic_of do
        pure (REWRITE_TAC [th] THEN
              MATCH_MP_TAC MEASURE_DIFFERENTIABLE_IMAGE_APPROX_GEN THEN
              REWRITE_TAC [← GSYM th]))
    THENL
     [REWRITE_TAC [jacobian] THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC HAS_FRECHET_DERIVATIVE_UNIQUE_AT THEN ASM_SIMP_TAC [],
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [differentiable], ALL_TAC] THEN
      ASM_MESON_TAC [DIFFERENTIABLE_IMP_OPEN_MAP, SUBSET]])

  pure { MEASURE_DIFFERENTIABLE_IMAGE_APPROX_GEN, MEASURE_DIFFERENTIABLE_IMAGE_APPROX }
/- ------------------------------------------------------------------------- -/
/- Connectedness of the range of the Jacobian determinant.                  -/
/- (measure.ml 21983-22159)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCI where
  CONNECTED_JACOBIAN_RANGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCI [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSG : MSG) (BMSJ : MSJ) (BMSAM : MSAM) (BMSBZ : MSBZ) (BMSCG : MSCG) (BMSCH : MSCH) : ExceptT String IO MSCI := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_MEASURE_POS_LT, .. } := BMSB
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { NEGLIGIBLE_CONVEX_INTERIOR, .. } := BMSJ
  let { LEBESGUE_MEASURABLE_COMPACT, .. } := BMSAM
  let { MEASURABLE_DIFFERENTIABLE_IMAGE_ALT, MEASURABLE_DIFFERENTIABLE_IMAGE_EQ,
        MEASURE_DIFFERENTIABLE_IMAGE_EQ, .. } := BMSBZ
  let { WEAK_LEBESGUE_POINTS_IMP_IVT, .. } := BMSCG
  let { MEASURE_DIFFERENTIABLE_IMAGE_APPROX, .. } := BMSCH
  let { CONVEX_AFFINITY, .. } := D.qconvex
  let { DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT, HAS_DERIVATIVE_AT_WITHIN,
        INVERSE_FUNCTION_THEOREM, JACOBIAN_SIGN_INVARIANCE, .. } := D.qderivatives
  let { BOUNDED_AFFINITY, COMPACT_AFFINITY, CONNECTED_NEGATIONS, DIST_LE_DIAMETER,
        .. } := D.qtopology1
  let { INTERIOR_AFFINITY, LOCALLY_COMPACT, .. } := D.qtopology2
  let { differentiable, DIFFERENTIABLE_IMP_CONTINUOUS_ON, has_derivative,
        .. } := D.ig.qderivatives
  let { LE_EXISTS, .. } := D.ig.qsession
  let { INTERIOR_INTERVAL, SEQ_OFFSET_REV, .. } := D.ig.qtopology
  let { EVENTUALLY_MP, .. } := D.ig.dv.qmetric
  let { LIM_TRANSFORM_EVENTUALLY, open_def, .. } := D.ig.dv.qtopology2
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { INVERTIBLE_DET_NZ, .. } := D.ig.dv.dg.qdet
  let { LE_0, .. } := D.ig.dv.dg.qsession
  let { locally, OPEN_IMP_LOCALLY_COMPACT, .. } := D.ig.dv.dg.qtopology2
  let { LIFT_NEG, MATRIX_INVERTIBLE, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { ADD_SYM, AND_FORALL_THM, CONJ_ASSOC, EQ_SYM_EQ, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_EQ_EMPTY, IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INTER, LE_ADD, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP, MONO_OR,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LET_TRANS, REAL_LT_IMP_NZ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_abs, real_div, SWAP_FORALL_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_EQ, INTERVAL_NE_EMPTY, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VEC_COMPONENT, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, OPEN_IN_IMP_SUBSET, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSURE_INC, COMPACT_CONTINUOUS_IMAGE, COMPACT_INTERVAL,
        .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, DIAMETER_POS_LE, .. } := D.ig.dv.dg.pt.cvx.top3
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { homeomorphism, OPEN_IN_OPEN_EQ, OPEN_INTER, SEQ_OFFSET,
        .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let CONNECTED_JACOBIAN_RANGE ← prove
   r"!f:real^N->real^N f' s.
        open s /\ connected s /\
        (!x. x IN s
             ==> (f has_derivative f' x) (at x) /\ ~(det(matrix (f' x)) = &0))
        ==> connected (IMAGE (\x. lift(det(matrix(f' x)))) s)"
   (REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"connected
       (IMAGE (\x. lift(abs(det(matrix((f':real^N->real^N->real^N) x))))) s)")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (fun th => tactic_of do
       pure (MP_TAC (← MATCH_MP CONNECTED_NEGATIONS th) THEN MP_TAC th)) THEN
      MATCH_MP_TAC (← MESON []
       (← q r"t = s \/ u = s ==> connected t ==> connected u ==> connected s")) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s ==> a x = f x) \/ (!x. x IN s ==> n(a x) = f x)
        ==> IMAGE a s = IMAGE f s \/ IMAGE n (IMAGE a s) = IMAGE f s")) THEN
      REWRITE_TAC [LIFT_EQ, ← GSYM LIFT_NEG] THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                        ← q r"s:real^N->bool"] JACOBIAN_SIGN_INVARIANCE) THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
      REWRITE_TAC [] THEN REAL_ARITH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s
          ==> ?g. linear g /\
                  (f':real^N->real^N->real^N) x o g = I /\ g o f' x = I")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (rand o rand) MATRIX_INVERTIBLE o snd) THEN
      REWRITE_TAC [INVERTIBLE_DET_NZ] THEN ASM_MESON_TAC [has_derivative],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    X_GEN_TAC (← q r"g':real^N->real^N->real^N") THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC WEAK_LEBESGUE_POINTS_IMP_IVT THEN
    MAP_EVERY EXISTS_TAC [← q r"--vec 1:real^N", ← q r"vec 1:real^N"] THEN
    SUBGOAL_THEN (← q r"~(interval[--vec 1:real^N,vec 1] = {}) /\
                  ~(interval(--vec 1:real^N,vec 1) = {})")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [INTERVAL_NE_EMPTY, VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ASM_REWRITE_TAC [locally]] THEN
    GEN_REWRITE_TAC BINOP_CONV [SWAP_FORALL_THM] THEN
    GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET]] THEN
    SUBGOAL_THEN (← q r"(f:real^N->real^N) continuous_on s") ASSUME_TAC THENL
     [MATCH_MP_TAC DIFFERENTIABLE_IMP_CONTINUOUS_ON THEN
      ASM_SIMP_TAC [DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT] THEN
      ASM_MESON_TAC [differentiable],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?u. open u /\ a IN u /\ u SUBSET s /\
          !x y. x IN u /\ y IN u ==> ((f:real^N->real^N) x = f y <=> x = y)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                        ← q r"a:real^N", ← q r"s:real^N->bool"] INVERSE_FUNCTION_THEOREM) THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REWRITE_TAC [homeomorphism] THEN MESON_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [OPEN_IN_OPEN_EQ] THEN
      X_GEN_TAC (← q r"w:real^N->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"u INTER w:real^N->bool") OPEN_IMP_LOCALLY_COMPACT) THEN
      ASM_SIMP_TAC [OPEN_INTER, LOCALLY_COMPACT, OPEN_IN_OPEN_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [IN_INTER] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N->bool") THEN
      REWRITE_TAC [SUBSET_INTER] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_TRANS], ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURABLE_DIFFERENTIABLE_IMAGE_ALT o
        snd) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPACT] THEN
        ASM_MESON_TAC [SUBSET, HAS_DERIVATIVE_AT_WITHIN],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC MEASURABLE_COMPACT THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_TRANS],
      ALL_TAC] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"!Q'. ((!x. P x /\ Q' x /\ R x ==> S x)
               ==> (!x. P x /\ Q x /\ R x ==> S x)) /\
            (!x. P x /\ Q' x /\ R x ==> S x)
            ==> (!x. P x /\ Q x /\ R x ==> S x)")) THEN
    EXISTS_TAC
     (← q r"\c:num->real^N->bool. (!n. a IN c n) /\ (!n. c n SUBSET u)") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"c:num->real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MP)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n:num. (a:real^N) IN c n /\ c n SUBSET u")) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [UNDISCH_TAC (← q r"open(u:real^N->bool)") THEN REWRITE_TAC [open_def] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_SEQUENTIALLY]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [DIST_0, NORM_LIFT, EVENTUALLY_SEQUENTIALLY] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"bounded((c:num->real^N->bool) n)") MP_TAC THENL
         [FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC o SPEC (← q r"n:num")) THEN
          ASM_SIMP_TAC [BOUNDED_AFFINITY, BOUNDED_INTERVAL],
          SIMP_TAC [real_abs, DIAMETER_POS_LE] THEN REPEAT STRIP_TAC] THEN
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        TRANS_TAC REAL_LET_TRANS (← q r"diameter((c:num->real^N->bool) n)") THEN
        ASM_SIMP_TAC [DIST_LE_DIAMETER],
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, ← MESON [LE_ADD, LE_EXISTS]
         (← q r"(!n:num. N <= n ==> P n) <=> (!n. P(N + n))")] THEN
        REWRITE_TAC [FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\n. (c:num->real^N->bool) (N + n)")) THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"N:num") o MATCH_MP SEQ_OFFSET) THEN
        REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MATCH_MP_TAC SEQ_OFFSET_REV THEN EXISTS_TAC (← q r"N:num") THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"linear((f':real^N->real^N->real^N) a)") ASSUME_TAC THENL
     [ASM_MESON_TAC [has_derivative], ALL_TAC] THEN
    X_GEN_TAC (← q r"c:num->real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!n. compact((c:num->real^N->bool) n)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC o SPEC (← q r"n:num")) THEN
      ASM_SIMP_TAC [COMPACT_AFFINITY, COMPACT_INTERVAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. ~(interior((c:num->real^N->bool) n) = {})") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC o SPEC (← q r"n:num")) THEN
      ASM_REWRITE_TAC [INTERIOR_AFFINITY, INTERIOR_INTERVAL] THEN
      ASM_SIMP_TAC [IMAGE_EQ_EMPTY, REAL_LT_IMP_NZ],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. convex((c:num->real^N->bool) n)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC o SPEC (← q r"n:num")) THEN
      ASM_SIMP_TAC [CONVEX_AFFINITY, CONVEX_INTERVAL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. &0 < measure((c:num->real^N->bool) n)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [MEASURABLE_MEASURE_POS_LT, MEASURABLE_COMPACT] THEN
      ASM_SIMP_TAC [NEGLIGIBLE_CONVEX_INTERIOR],
      ALL_TAC] THEN
    MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN EXISTS_TAC
    (← q r"\n:num. lift(measure (IMAGE (f:real^N->real^N) (c n)) / measure (c n))") THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"0") THEN X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [LE_0] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div, LIFT_CMUL] THEN
      AP_TERM_TAC THEN REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN
      MATCH_MP_TAC MEASURE_DIFFERENTIABLE_IMAGE_EQ THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPACT, CONJ_ASSOC] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [HAS_DERIVATIVE_AT_WITHIN, SUBSET], ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURABLE_DIFFERENTIABLE_IMAGE_EQ o
        snd) THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPACT] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [HAS_DERIVATIVE_AT_WITHIN, SUBSET],
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC MEASURABLE_COMPACT THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_TRANS]],
      MP_TAC (← ISPECL
       [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
        ← q r"s:real^N->bool", ← q r"c:num->real^N->bool", ← q r"a:real^N"]
          MEASURE_DIFFERENTIABLE_IMAGE_APPROX) THEN
      ASM_SIMP_TAC [CLOSURE_INC] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      EXISTS_TAC (← q r"interval[--vec 1:real^N,vec 1]") THEN
      REWRITE_TAC [CONVEX_INTERVAL, BOUNDED_INTERVAL, INTERIOR_INTERVAL] THEN
      ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN ASM_REWRITE_TAC []])

  pure { CONNECTED_JACOBIAN_RANGE }

/- ------------------------------------------------------------------------- -/
/- Jacobian range: segment and subset versions.                             -/
/- (measure.ml 22160-22445)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCJ where
  CONNECTED_JACOBIAN_RANGE_ALT : thm
  CONNECTED_JACOBIAN_RANGE_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCJ [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSC : MSC) (BMSG : MSG) (BMSJ : MSJ) (BMSAM : MSAM) (BMSBZ : MSBZ) (BMSCH : MSCH) (BMSCI : MSCI) : ExceptT String IO MSCJ := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_MEASURE_POS_LT, .. } := BMSB
  let { INTEGRABLE_ON_CONST, INTEGRAL_CONST_GEN, .. } := BMSC
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { NEGLIGIBLE_CONVEX_FRONTIER, NEGLIGIBLE_CONVEX_INTERIOR, .. } := BMSJ
  let { LEBESGUE_MEASURABLE_COMPACT, .. } := BMSAM
  let { MEASURABLE_DIFFERENTIABLE_IMAGE_EQ, MEASURE_DIFFERENTIABLE_IMAGE_EQ, .. } := BMSBZ
  let { MEASURE_DIFFERENTIABLE_IMAGE_APPROX, .. } := BMSCH
  let { CONNECTED_JACOBIAN_RANGE, .. } := BMSCI
  let { CONVEX_SCALING_EQ, .. } := D.qconvex
  let { DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT, HAS_DERIVATIVE_AT_WITHIN,
        INVERSE_FUNCTION_THEOREM, JACOBIAN_SIGN_INVARIANCE, .. } := D.qderivatives
  let { INTEGRAL_DROP_LE_AE, .. } := D.qintegration3
  let { BOUNDED_SCALING, BOUNDED_SCALING_EQ, BOUNDED_TRANSLATION, COMPACT_SCALING_EQ,
        DIAMETER_SCALING, DIAMETER_TRANSLATION, DIST_LE_DIAMETER, .. } := D.qtopology1
  let { INTERIOR_SCALING, SET_DIFF_FRONTIER, .. } := D.qtopology2
  let { differentiable, DIFFERENTIABLE_IMP_CONTINUOUS_ON, .. } := D.ig.qderivatives
  let { LIM_NULL_CMUL, SEQ_HARMONIC_OFFSET, .. } := D.ig.dv.qtopology2
  let { IN_TRANSLATION_GALOIS, TRANSLATION_SUBSET_GALOIS_LEFT, .. } := D.ig.dv.qvec
  let { CONVEX_CONNECTED, IS_INTERVAL_CONNECTED_1, .. } := D.ig.dv.dg.qconvex
  let { EVENTUALLY_AND, .. } := D.ig.dv.dg.qmetric
  let { tendsto, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { COMPACT_TRANSLATION_EQ, .. } := D.ig.dv.dg.pt.qtop
  let { COMPACT_CONVEX_HULL, CONVEX_CONVEX_HULL, CONVEX_INTERIOR,
        .. } := D.ig.dv.dg.pt.qcvx2
  let { CONVEX_TRANSLATION_EQ, IN_CONVEX_SET, .. } := D.ig.dv.dg.pt.qcvx3
  let { CONJ_ACI, CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, INSERT_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_INSERT, LE_REFL, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_EXISTS, REAL_ABS_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_EQ_0, REAL_INV_LE_1, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
        REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_LE,
        REAL_LT_SUB_LADD, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, .. } := D.ig.dv.dg.pt.cvx.core6
  let { HULL_INC, HULL_MINIMAL, HULL_SUBSET, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DIST_0, DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_MUL_RZERO, VECTOR_SUB_REFL, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { BALL_EQ_EMPTY, BOUNDED_TRANSLATION_EQ, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_INC, COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED,
        COMPACT_INSERT, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, DIAMETER_POS_LE, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL, IN_INTERIOR_CBALL, IN_INTERVAL_1, INTERIOR_CBALL, INTERIOR_SUBSET,
        INTERIOR_TRANSLATION, IS_INTERVAL_1, OPEN_CONTAINS_CBALL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { homeomorphism, OPEN_INTERIOR, SEGMENT_1, SEGMENT_SYM, SUBSET_INTERIOR,
        .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let CONNECTED_JACOBIAN_RANGE_ALT ← (do
    let lemma ← prove
     r"!f:real^N->real^N f' s t.
          open s /\ connected s /\
          (!x. x IN s
               ==> (f has_derivative f' x) (at x) /\
                   ~(det(matrix (f' x)) = &0)) /\
          t SUBSET s /\ convex t /\ ~(interior t = {})
          ==> !e x. &0 < e /\ x IN t
                    ==> (?x'. x' IN interior t /\
                              det(matrix(f' x')) <= det(matrix(f' x)) + e) /\
                        (?x'. x' IN interior t /\
                              det(matrix(f' x)) <= det(matrix(f' x')) + e)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(f:real^N->real^N) continuous_on s") ASSUME_TAC THENL
       [MATCH_MP_TAC DIFFERENTIABLE_IMP_CONTINUOUS_ON THEN
        ASM_SIMP_TAC [DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT] THEN
        ASM_MESON_TAC [differentiable],
        ALL_TAC] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN s") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(?x'. x' IN interior t /\
              abs(det(matrix((f':real^N->real^N->real^N) x')))
              <= abs(det(matrix(f' x))) + e) /\
        (?x'. x' IN interior t /\
              abs(det(matrix(f' x))) <= abs(det(matrix(f' x'))) + e)")
      MP_TAC THENL
       [ALL_TAC,
        MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                          ← q r"s:real^N->bool"] JACOBIAN_SIGN_INVARIANCE) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
         [ALL_TAC, GEN_REWRITE_TAC RAND_CONV [CONJ_SYM]] THEN
        MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"y:real^N") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        (SUBGOAL_THEN (← q r"(y:real^N) IN s") ASSUME_TAC THENL
          [ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET], ALL_TAC]) THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"x < &0 ==> ~(&0 <= x)")] THEN
        REAL_ARITH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:real^N")) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERIOR_CBALL]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      ABBREV_TAC (← q r"A = convex hull (x INSERT cball(z:real^N,r))") THEN
      SUBGOAL_THEN (← q r"compact(A:real^N->bool) /\ convex A") STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "A" THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
        MATCH_MP_TAC COMPACT_CONVEX_HULL THEN
        SIMP_TAC [COMPACT_INSERT, COMPACT_CBALL],
        ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      SUBGOAL_THEN (← q r"~(interior(A:real^N->bool) = {})") ASSUME_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ ~(s = {}) ==> ~(t = {})")) THEN
        EXISTS_TAC (← q r"ball(z:real^N,r)") THEN
        ASM_REWRITE_TAC [BALL_EQ_EMPTY, REAL_NOT_LE] THEN
        REWRITE_TAC [← GSYM INTERIOR_CBALL] THEN MATCH_MP_TAC SUBSET_INTERIOR THEN
        MATCH_MP_TAC (← SET_RULE (← q r"!x. x INSERT s SUBSET t ==> s SUBSET t")) THEN
        EXISTS_TAC (← q r"x:real^N") THEN EXPAND_TAC "A" THEN REWRITE_TAC [HULL_SUBSET],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(A:real^N->bool) SUBSET t") ASSUME_TAC THENL
       [EXPAND_TAC "A" THEN MATCH_MP_TAC HULL_MINIMAL THEN
        ASM_REWRITE_TAC [INSERT_SUBSET],
        ALL_TAC] THEN
      ABBREV_TAC
       (← q r"c = \n. IMAGE (\y:real^N. x + y)
                      (IMAGE (\x. inv(&n + &1) % x)
                             (IMAGE (\y. --x + y) A))") THEN
      SUBGOAL_THEN (← q r"!n. x IN (c:num->real^N->bool) n") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "c" THEN
        REWRITE_TAC [IN_TRANSLATION_GALOIS, VECTOR_SUB_REFL] THEN
        GEN_REWRITE_TAC I [IN_IMAGE] THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
        REWRITE_TAC [VECTOR_MUL_RZERO, IN_TRANSLATION_GALOIS] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"vec 0 - --x:real^N = x:real^N")] THEN
        EXPAND_TAC "A" THEN MATCH_MP_TAC HULL_INC THEN REWRITE_TAC [IN_INSERT],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!n. convex((c:num->real^N->bool) n) /\ compact(c n) /\
            bounded(c n) /\ ~(interior(c n) = {})")
      MP_TAC THENL
       [EXPAND_TAC "c" THEN
        REWRITE_TAC [CONVEX_TRANSLATION_EQ, COMPACT_TRANSLATION_EQ,
                     BOUNDED_TRANSLATION_EQ, INTERIOR_TRANSLATION,
                     CONVEX_SCALING_EQ, COMPACT_SCALING_EQ, IMAGE_EQ_EMPTY,
                     BOUNDED_SCALING_EQ, INTERIOR_SCALING,
                     REAL_INV_EQ_0, ← REAL_ARITH (← q r"~(&n + &1 = &0)")] THEN
        ASM_REWRITE_TAC [],
        REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
      SUBGOAL_THEN (← q r"!n. &0 < measure((c:num->real^N->bool) n)") ASSUME_TAC THENL
       [ASM_SIMP_TAC [MEASURABLE_MEASURE_POS_LT, MEASURABLE_COMPACT] THEN
        ASM_SIMP_TAC [NEGLIGIBLE_CONVEX_INTERIOR],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!n. (c:num->real^N->bool) n SUBSET t") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "c" THEN
        REWRITE_TAC [TRANSLATION_SUBSET_GALOIS_LEFT] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"IMAGE g s SUBSET t /\ IMAGE f (IMAGE g s) SUBSET IMAGE g s
          ==> IMAGE f (IMAGE g s) SUBSET t")) THEN
        ASM_SIMP_TAC [IMAGE_SUBSET] THEN REWRITE_TAC [SUBSET] THEN
        ONCE_REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"w:real^N") THEN
        DISCH_TAC THEN REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← VECTOR_ARITH
         (← q r"a % x:real^N = (&1 - a) % vec 0 + a % x")] THEN
        MATCH_MP_TAC IN_CONVEX_SET THEN
        ASM_REWRITE_TAC [REAL_LE_INV_EQ, ← REAL_ARITH (← q r"&0 <= &n + &1")] THEN
        REWRITE_TAC [CONVEX_TRANSLATION_EQ, IN_TRANSLATION_GALOIS] THEN
        ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"vec 0 - --x:real^N = x")] THEN
        EXPAND_TAC "A" THEN SIMP_TAC [HULL_INC, IN_INSERT] THEN
        MATCH_MP_TAC REAL_INV_LE_1 THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"((\n. lift(diameter(c n:real^N->bool))) --> vec 0) sequentially")
      (LABEL_TAC "D") THENL
       [EXPAND_TAC "c" THEN REWRITE_TAC [] THEN
        ASM_SIMP_TAC [DIAMETER_SCALING, BOUNDED_SCALING, BOUNDED_TRANSLATION,
                      DIAMETER_TRANSLATION] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] LIFT_CMUL] THEN
        MATCH_MP_TAC LIM_NULL_CMUL THEN
        REWRITE_TAC [REAL_ABS_INV, ← REAL_ARITH (← q r"abs(&n + &1) = &n + &1")] THEN
        REWRITE_TAC [SEQ_HARMONIC_OFFSET],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                        ← q r"s:real^N->bool", ← q r"c:num->real^N->bool", ← q r"x:real^N"]
              MEASURE_DIFFERENTIABLE_IMAGE_APPROX) THEN
      ASM_SIMP_TAC [CLOSURE_INC] THEN ANTS_TAC THENL
       [EXISTS_TAC (← q r"A:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "c" THEN
        REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
        EXISTS_TAC (← q r"inv(&n + &1)") THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        EXISTS_TAC (← q r"(&1 - inv(&n + &1)) % x:real^N") THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN CONV_TAC (fun t => VECTOR_ARITH t),
        STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"?u. open u /\ x IN u /\ u SUBSET s /\
            !a b. a IN u /\ b IN u ==> ((f:real^N->real^N) a = f b <=> a = b)")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                          ← q r"x:real^N", ← q r"s:real^N->bool"] INVERSE_FUNCTION_THEOREM) THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [homeomorphism] THEN MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"eventually (\n. c n SUBSET (u:real^N->bool)) sequentially")
      MP_TAC THENL
       [UNDISCH_TAC (← q r"open(u:real^N->bool)") THEN
        REWRITE_TAC [OPEN_CONTAINS_CBALL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        REMOVE_THEN "D" (MP_TAC o GEN_REWRITE_RULE I [tendsto]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN ASM_REWRITE_TAC [DIST_0] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [NORM_LIFT, real_abs] THEN
        ASM_SIMP_TAC [DIAMETER_POS_LE] THEN DISCH_TAC THEN
        TRANS_TAC SUBSET_TRANS (← q r"cball(x:real^N,d)") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, IN_CBALL] THEN
        X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
        TRANS_TAC REAL_LE_TRANS (← q r"diameter((c:num->real^N->bool) n)") THEN
        ASM_SIMP_TAC [DIST_LE_DIAMETER, REAL_LT_IMP_LE],
        REMOVE_THEN "D" (K ALL_TAC)] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [tendsto]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [DIST_LIFT] THEN
      REWRITE_TAC [EVENTUALLY_AND, ← REAL_ARITH
       (← q r"abs(x - y) < e <=> x < y + e /\ y < x + e")] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(r /\ p ==> s) /\ (r /\ q ==> t) ==> p /\ q ==> r ==> s /\ t")) THEN
      REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
      GEN_REWRITE_TAC BINOP_CONV [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [← MESON [] (← q r"~(?x. P x /\ Q x) <=> !x. P x ==> ~Q x")] THEN
      REWRITE_TAC [REAL_NOT_LE] THEN CONJ_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
      REWRITE_TAC [LE_REFL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [REAL_NOT_LT] THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"x + e <= y <=> x <= y - e")] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ONCE_REWRITE_TAC [← GSYM LIFT_DROP] THEN
      REWRITE_TAC [LIFT_CMUL] THEN
      ASM_SIMP_TAC [← GSYM INTEGRAL_CONST_GEN, MEASURABLE_COMPACT] THEN
      REWRITE_TAC [LIFT_DROP] THENL
       [W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DIFFERENTIABLE_IMAGE_EQ o
          rand o snd),
        W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DIFFERENTIABLE_IMAGE_EQ o
          lhand o snd)] THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPACT] THEN
      (ANTS_TAC THENL
        [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
          [ASM_MESON_TAC [HAS_DERIVATIVE_AT_WITHIN, SUBSET], ALL_TAC] THEN
         W (MP_TAC o PART_MATCH (rand o rand) MEASURABLE_DIFFERENTIABLE_IMAGE_EQ o
           snd) THEN
