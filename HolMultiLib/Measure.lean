structure MSCW where
  CONVERSE_SARD : thm
  CONVERSE_SARD_1 : thm
  DIFF_CHAIN_WITHIN_EQUAL_AE : thm
  DIFF_CHAIN_AT_EQUAL_AE : thm
  DIFF_CHAIN_WITHIN_AE : thm
  ABSOLUTE_INTEGRAL_SUBSTITUTION : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCW [HolBase] (D : MeasureDeps) (BMSBV : MSBV) (BMSCR : MSCR) (BMSCS : MSCS) (BMSCV : MSCV) : ExceptT String IO MSCW := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_DIFFERENTIABLE_PREIMAGE, .. } := BMSBV
  let { ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ,
        ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT,
        FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS, .. } := BMSCR
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE, .. } := BMSCS
  let { ABSOLUTELY_CONTINUOUS_ON_COMPOSE, BANACH_ZARECKI, .. } := BMSCV
  let { VECTOR_DERIVATIVE_UNIQUE_WITHIN, .. } := D.qderivatives
  let { DET_1, RANK_EQ_FULL_DET, .. } := D.qdet
  let { ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_INTEGRABLE_COMPONENTWISE, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        .. } := D.qintegration1
  let { HAS_ABSOLUTE_INTEGRAL, HAS_BOUNDED_VARIATION_COMPOSE_INCREASING,
        HAS_INTEGRAL_COMPONENTWISE, .. } := D.qintegration2
  let { INTEGRAL_UNIQUE, LIFT_INTEGRAL_COMPONENT, NEGLIGIBLE_COUNTABLE, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { COUNTABLE_NON_LIMIT_POINTS, .. } := D.qtopology1
  let { HAS_DERIVATIVE_WITHIN_SUBSET, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET,
        VECTOR_DIFF_CHAIN_WITHIN, .. } := D.ig.qderivatives
  let { DROP_BASIS, matrix, .. } := D.ig.dv.qvec
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { AND_FORALL_THM, ARITH, CONJ_ASSOC, DE_MORGAN_THM, DIMINDEX_1, EQ_IMP, EXTENSION,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, LAMBDA_BETA, LEFT_IMP_EXISTS_THM,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, SUBSET, SUBSET_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_VEC, LIFT_CMUL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_MUL_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, IS_INTERVAL_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { TRIVIAL_LIMIT_WITHIN, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let CONVERSE_SARD ← prove
   r"!(f:real^M->real^N) f' s.
        dimindex(:M) = dimindex(:N) /\
        (!x. x IN s ==> (f has_derivative f'(x)) (at x within s)) /\
        negligible(IMAGE f s)
        ==> negligible {x | x IN s /\ rank(matrix(f' x)) = dimindex(:N)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"f':real^M->real^M->real^N",
      ← q r"{x | x IN s /\ rank(matrix((f':real^M->real^M->real^N)x)) = dimindex(:N)}",
      ← q r"IMAGE (f:real^M->real^N) s"]
          NEGLIGIBLE_DIFFERENTIABLE_PREIMAGE) THEN
    FIRST_X_ASSUM SUBST1_TAC THEN ASM_SIMP_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [ALL_TAC, MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC []] THEN
    X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HAS_DERIVATIVE_WITHIN_SUBSET) THEN
    REWRITE_TAC [SUBSET_RESTRICT])

  let CONVERSE_SARD_1 ← prove
   r"!(f:real^1->real^1) f' s.
        (!x. x IN s ==> (f has_vector_derivative f'(x)) (at x within s)) /\
        negligible(IMAGE f s)
        ==> negligible {x | x IN s /\ ~(f'(x) = vec 0)}"
   (REPEAT GEN_TAC THEN MP_TAC (REFL (← q r"dimindex(:1)")) THEN
    PURE_REWRITE_TAC [IMP_IMP, has_vector_derivative] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVERSE_SARD) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^1") THEN
    AP_TERM_TAC THEN REWRITE_TAC [RANK_EQ_FULL_DET] THEN
    SIMP_TAC [DET_1, matrix, LAMBDA_BETA, DIMINDEX_1, ARITH] THEN
    REWRITE_TAC [← GSYM drop, DROP_CMUL, DROP_BASIS, REAL_MUL_LID] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC])

  let DIFF_CHAIN_WITHIN_EQUAL_AE ← prove
   r"!(f:real^1->real^1) (g:real^1->real^1) f' g' h' s t u v w.
        IMAGE f s SUBSET t /\ negligible u /\ negligible v /\ negligible w /\
        (!n. n SUBSET t /\ negligible n ==> negligible(IMAGE g n)) /\
        (!x. x IN s DIFF u
             ==> (f has_vector_derivative f' x) (at x within s)) /\
        (!y. y IN t DIFF v
             ==> (g has_vector_derivative g' y) (at y within t)) /\
        (!x. x IN s DIFF w
             ==> ((g o f) has_vector_derivative h' x) (at x within s))
        ==> negligible {x | x IN s /\ ~(h' x = drop(f' x) % g'(f x))}"
   (REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL
     [← q r"(g:real^1->real^1) o (f:real^1->real^1)",
      ← q r"h':real^1->real^1",
      ← q r"{x | x IN s DIFF (u UNION w) /\ (f:real^1->real^1) x IN v}"]
     CONVERSE_SARD_1) THEN
    MP_TAC (← SPECL
     [← q r"f:real^1->real^1", ← q r"f':real^1->real^1",
      ← q r"{x | x IN s DIFF (u UNION w) /\ (f:real^1->real^1) x IN v}"]
     CONVERSE_SARD_1) THEN
    REWRITE_TAC [IN_ELIM_THM, IMAGE_o, IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_SIMP_TAC [SUBSET_RESTRICT],
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"v:real^1->bool") THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC []],
      DISCH_TAC] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_SIMP_TAC [SUBSET_RESTRICT],
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"v:real^1->bool") THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC []],
      DISCH_TAC] THEN
    UNDISCH_THEN (← q r"negligible (v:real^1->bool)") (K ALL_TAC : thm → tactic) THEN
    SUBGOAL_THEN (← q r"negligible {x:real^1 | x IN s /\ ~(x limit_point_of s)}")
    MP_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ ~P x} = s DIFF {x | P x}")] THEN
      MATCH_MP_TAC NEGLIGIBLE_COUNTABLE THEN
      REWRITE_TAC [COUNTABLE_NON_LIMIT_POINTS],
      ALL_TAC] THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      let _ ← ExceptT.mk (HolCore.Drule.term_match [] (← q r"negligible s") (concl th))
      pure (MP_TAC th))) THEN
    REWRITE_TAC [← GSYM NEGLIGIBLE_UNION_EQ, IMP_IMP] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN
    X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^1) IN u") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^1) IN w") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^1) limit_point_of s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(f:real^1->real^1) x IN v") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM DE_MORGAN_THM] THEN TRY DISCH_TAC THEN
    UNDISCH_TAC
      (← q r"~(h' x:real^1 = drop(f' x) % g'((f:real^1->real^1) x))") THEN
    ASM_REWRITE_TAC [DROP_VEC] THENL [CONV_TAC (fun t => VECTOR_ARITH t), ALL_TAC] THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_UNIQUE_WITHIN THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(g:real^1->real^1) o (f:real^1->real^1)",
      ← q r"x:real^1", ← q r"s:real^1->bool"] THEN
    ASM_SIMP_TAC [TRIVIAL_LIMIT_WITHIN] THEN
    MATCH_MP_TAC VECTOR_DIFF_CHAIN_WITHIN THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  let DIFF_CHAIN_AT_EQUAL_AE ← prove
   r"!(f:real^1->real^1) (g:real^1->real^1) f' g' h' s t u v w.
        IMAGE f s SUBSET t /\ negligible u /\ negligible v /\ negligible w /\
        (!n. n SUBSET t /\ negligible n ==> negligible(IMAGE g n)) /\
        (!x. x IN s DIFF u  ==> (f has_vector_derivative f' x) (at x)) /\
        (!y. y IN t DIFF v ==> (g has_vector_derivative g' y) (at y)) /\
        (!x. x IN s DIFF w ==> ((g o f) has_vector_derivative h' x) (at x))
        ==> negligible {x | x IN s /\ ~(h' x = drop(f' x) % g'(f x))}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIFF_CHAIN_WITHIN_EQUAL_AE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"g:real^1->real^1", ← q r"t:real^1->bool",
      ← q r"u:real^1->bool", ← q r"v:real^1->bool", ← q r"w:real^1->bool"] THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN])

  let DIFF_CHAIN_WITHIN_AE ← prove
   r"!(f:real^1->real^1) (g:real^1->real^1) f' g' s t u v.
        IMAGE f s SUBSET t /\ negligible u /\ negligible v /\
        (!x. x IN s DIFF u
             ==> (f has_vector_derivative f' x) (at x within s)) /\
        (!y. y IN t DIFF v
             ==> (g has_vector_derivative g' y) (at y within t)) /\
        negligible {x | x IN s /\ f' x = vec 0}
        ==> negligible
             {x | x IN s /\
                  ~(((g o f) has_vector_derivative drop(f' x) % g'(f x))
                    (at x within s))}"
   (REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL
     [← q r"f:real^1->real^1", ← q r"f':real^1->real^1",
      ← q r"{x | x IN s DIFF u /\ (f:real^1->real^1) x IN v}"]
     CONVERSE_SARD_1) THEN
    REWRITE_TAC [IN_ELIM_THM, IMAGE_o, IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_SIMP_TAC [SUBSET_RESTRICT],
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"v:real^1->bool") THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC []],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"negligible {x:real^1 | x IN s /\ ~(x limit_point_of s)}")
    MP_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ ~P x} = s DIFF {x | P x}")] THEN
      MATCH_MP_TAC NEGLIGIBLE_COUNTABLE THEN
      REWRITE_TAC [COUNTABLE_NON_LIMIT_POINTS],
      ALL_TAC] THEN
    UNDISCH_THEN (← q r"negligible (v:real^1->bool)") (K ALL_TAC : thm → tactic) THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      let _ ← ExceptT.mk (HolCore.Drule.term_match [] (← q r"negligible s") (concl th))
      pure (MP_TAC th))) THEN
    REWRITE_TAC [← GSYM NEGLIGIBLE_UNION_EQ, IMP_IMP] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN
    X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^1) IN u") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^1) limit_point_of s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(f:real^1->real^1) x IN v") THEN ASM_REWRITE_TAC [] THENL
     [CONV_TAC (fun t => TAUT t), ALL_TAC] THEN
    UNDISCH_TAC
     (← q r"~((g o f has_vector_derivative drop(f' x) % (g':real^1->real^1)(f x))
        (at x within s))") THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
    MATCH_MP_TAC VECTOR_DIFF_CHAIN_WITHIN THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  let ABSOLUTE_INTEGRAL_SUBSTITUTION ← prove
   r"!(f:real^1->real^N) g g' a b s.
        drop a <= drop b /\
        f absolutely_integrable_on interval[g a,g b] /\
        g absolutely_continuous_on interval[a,b] /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (g has_vector_derivative g' x) (at x within interval[a,b])) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(g x) <= drop(g y))
        ==> (\x. drop(g' x) % f(g x)) absolutely_integrable_on interval[a,b] /\
            integral (interval[a,b]) (\x. drop(g' x) % f(g x)) =
            integral (interval[g a,g b]) f"
   (W (fun (_asl, w) => tactic_of do
      pure (SUBGOAL_THEN (inst [(← qty "1", ← qty "N")] w) ASSUME_TAC)) THENL
     [ALL_TAC,
      REWRITE_TAC [HAS_ABSOLUTE_INTEGRAL] THEN
      ONCE_REWRITE_TAC [HAS_INTEGRAL_COMPONENTWISE] THEN
      SIMP_TAC [LIFT_INTEGRAL_COMPONENT,
                ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
      ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"i:num") THEN
      REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\x. lift((f:real^1->real^N) x$i)",
        ← q r"g:real^1->real^1", ← q r"g':real^1->real^1",
        ← q r"a:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"]) THEN
      ASM_SIMP_TAC [LIFT_CMUL, VECTOR_MUL_COMPONENT] THEN
      SIMP_TAC [HAS_ABSOLUTE_INTEGRAL]] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
     [ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"ff:real^1->real^1", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"integral (interval [g a,g b]) f =
      (ff:real^1->real^1) (g(b:real^1)) - ff(g a)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
      EXISTS_TAC (← q r"t:real^1->bool") THEN
      ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN],
      ALL_TAC] THEN
    MP_TAC (← EQ_IMP_RULE (← ISPECL
     [← q r"(ff:real^1->real^1) o (g:real^1->real^1)",
      ← q r"\x:real^1. drop(g' x) % (f:real^1->real^1)(g x)",
      ← q r"a:real^1", ← q r"b:real^1"]
     ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ)).2 THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_REFL, INTEGRAL_UNIQUE]] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"ff:real^1->real^1", ← q r"g:real^1->real^1",
                        ← q r"interval[a:real^1,b]",
                        ← q r"interval[(g:real^1->real^1) a,g b]"]
        ABSOLUTELY_CONTINUOUS_ON_COMPOSE) THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL, BOUNDED_INTERVAL] THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, REAL_LE_REFL] THEN
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING THEN
      ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
                    BOUNDED_INTERVAL],
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON))] THEN
    REWRITE_TAC [BOUNDED_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
      ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h':real^1->real^1", ← q r"u:real^1->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->real^1", ← q r"ff:real^1->real^1", ← q r"g':real^1->real^1",
      ← q r"f:real^1->real^1", ← q r"h':real^1->real^1",
      ← q r"interval[a:real^1,b]", ← q r"interval[(g:real^1->real^1) a,g b]",
      ← q r"s:real^1->bool", ← q r"t:real^1->bool", ← q r"u:real^1->bool"]
     DIFF_CHAIN_WITHIN_EQUAL_AE) THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN_INTERVAL_1, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_REFL],
        ASM_MESON_TAC [BANACH_ZARECKI]],
      UNDISCH_TAC (← q r"negligible(u:real^1->bool)")] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC (← MESON [] (← q r"P s ==> negligible s ==> ?t. negligible t /\ P t")) THEN
    X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF, IN_ELIM_THM, IN_UNION] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [DE_MORGAN_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN, IN_DIFF])

  pure { CONVERSE_SARD, CONVERSE_SARD_1, DIFF_CHAIN_WITHIN_EQUAL_AE,
         DIFF_CHAIN_AT_EQUAL_AE, DIFF_CHAIN_WITHIN_AE, ABSOLUTE_INTEGRAL_SUBSTITUTION }
/- ------------------------------------------------------------------------- -/
/- The indefinite integral of a gauge integrable function has the Luzin N  -/
/- property.                                                                -/
/- (measure.ml 26818-27199)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCX where
  NEGLIGIBLE_IMAGE_INDEFINITE_INTEGRAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCX [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSJ : MSJ) (BMSBH : MSBH) : ExceptT String IO MSCX := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_NEGLIGIBLE_SYMDIFF, MEASURE_NEGLIGIBLE_SYMDIFF, NEGLIGIBLE_SYMDIFF_EQ,
        .. } := BMSB
  let { MEASURE_UNIONS_LE_IMAGE, NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. } := BMSF
  let { MEASURABLE_CBALL, MEASURE_CBALL_BOUND, .. } := BMSJ
  let { VITALI_COVERING_THEOREM_CBALLS, .. } := BMSBH
  let { CONVEX_CONTAINS_SEGMENT_IMP, .. } := D.qconvex
  let { HAS_INTEGRAL_INTEGRAL, HENSTOCK_LEMMA_PART2, INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT,
        INTEGRABLE_ON_SUBINTERVAL, INTEGRABLE_SPIKE, .. } := D.qintegration2
  let { fine, gauge, has_integral, INTEGRAL_COMBINE, INTEGRAL_SPIKE, NEGLIGIBLE_COUNTABLE,
        NEGLIGIBLE_DIFF, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT, NEGLIGIBLE_SUBSET,
        tagged_partial_division_of, .. } := D.qintegration3
  let { COUNTABLE_LOCAL_MAXIMA, .. } := D.qmisc
  let { CBALL_INTERVAL, .. } := D.qtopology1
  let { COUNTABLE_SUBSET, .. } := D.ig.qcard
  let { REAL_POW_1, .. } := D.ig.qsession
  let { OPEN_CLOSED_INTERVAL_1, .. } := D.ig.qtopology
  let { CONNECTED_INTERVAL, .. } := D.ig.dv.qconvex
  let { CONTINUOUS_OPEN_PREIMAGE, .. } := D.ig.dv.qtopology1
  let { IS_INTERVAL_CONNECTED_1, .. } := D.ig.dv.dg.qconvex
  let { BALL_1, .. } := D.ig.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { CONVEX_CBALL, .. } := D.ig.dv.dg.pt.qcvx2
