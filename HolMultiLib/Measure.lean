  let { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSBC
  let { MEASURABLE_ON_DET_JACOBIAN, .. } := BMSBL
  let { MEASURABLE_DIFFERENTIABLE_IMAGE, MEASURE_DIFFERENTIABLE_IMAGE, .. } := BMSBU
