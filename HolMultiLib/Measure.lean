        REWRITE_TAC [LE_REFL, ← GSYM LIFT_SUB, NORM_LIFT] THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC
         [← q r"{y | pastecart x y IN (f:num->real^(M,N)finite_sum->bool) N}",
          ← q r"{y | pastecart x y IN (g:num->real^(M,N)finite_sum->bool) N}"] THEN
