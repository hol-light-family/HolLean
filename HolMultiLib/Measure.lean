  let { LEBESGUE_MEASURABLE_INTERVAL, .. } := BMSAM
  let { CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_GEN, .. } := BMSCC
  let { CONVEX_TRANSLATION_SUBSET_PREIMAGE, .. } := D.qconvex
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NEG_EQ,
