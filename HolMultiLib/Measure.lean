structure MSBS where
  LEBESGUE_MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE : thm
  MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE : thm
  MEASURE_LOCALLY_LIPSCHITZ_IMAGE : thm
  LEBESGUE_MEASURABLE_LIPSCHITZ_IMAGE : thm
  MEASURABLE_LIPSCHITZ_IMAGE : thm
  MEASURE_LIPSCHITZ_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBS [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSF : MSF) (BMSJ : MSJ) (BMSO : MSO) (BMST : MST) (BMSAI : MSAI) (BMSAJ : MSAJ) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBB : MSBB) (BMSBH : MSBH) : ExceptT String IO MSBS := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_NEGLIGIBLE_SYMDIFF, MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE,
