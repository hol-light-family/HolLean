  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { AND_FORALL_THM, CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, ETA_AX, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMP_CONJ,
        IMP_IMP, IN, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_UNIV, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM, LT_REFL, MONO_AND,
        MONO_EXISTS, REAL_ABS_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LET_TRANS,
