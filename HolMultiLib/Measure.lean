        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INTERVAL_NE_EMPTY]) THEN
