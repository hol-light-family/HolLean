/- FTC for absolutely continuous functions and its consequences.           -/
/- (measure.ml 24887-25205)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCR where
  FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_EQ : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE : thm
  ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ : thm
  ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT : thm
  ABSOLUTE_INTEGRATION_BY_PARTS_SUM : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCR [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSG : MSG) (BMSO : MSO) (BMSAA : MSAA) (BMSCQ : MSCQ) : ExceptT String IO MSCR := do
  -- @@SCOPE BEGIN
  let { MEASURE_SUBSET, .. } := BMSA
  let { MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURABLE_ELEMENTARY, MEASURE_ELEMENTARY, .. } := BMSG
  let { MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL, .. } := BMSAA
  let { ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT, .. } := BMSCQ
  let { HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN, .. } := D.qderivatives
  let { ABSOLUTELY_CONTINUOUS_ON_ADD, ABSOLUTELY_CONTINUOUS_ON_BILINEAR,
        ABSOLUTELY_CONTINUOUS_ON_CONST, ABSOLUTELY_CONTINUOUS_ON_EQ,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUB, ABSOLUTELY_CONTINUOUS_ON_SUBSET,
        ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_ON_NULL,
        CONTENT_EQ_0_1, .. } := D.qintegration1
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_BARTLE, HAS_BOUNDED_SETVARIATION_ON_EQ,
        HAS_INTEGRAL_INTEGRAL, INTEGRABLE_ON_SUBINTERVAL, .. } := D.qintegration2
  let { absolutely_continuous_on, absolutely_setcontinuous_on, fine, gauge,
        has_bounded_variation_on, integrable_on, INTEGRAL_COMBINE, INTEGRAL_REFL,
        INTEGRAL_UNIQUE, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
        NEGLIGIBLE_INSERT, NEGLIGIBLE_UNION_EQ, PARTIAL_DIVISION_OF_TAGGED_DIVISION,
        TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND, tagged_partial_division_of,
        .. } := D.qintegration3
  let { VSUM_NORM_TRIANGLE, .. } := D.qvec
  let { has_derivative, has_vector_derivative, HAS_VECTOR_DERIVATIVE_ADD,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN,
        HAS_VECTOR_DERIVATIVE_CONST, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET,
        .. } := D.ig.qderivatives
  let { EXP_1, .. } := D.ig.qsession
  let { INTERIOR_INTERVAL, LIM_WITHIN_INTERIOR, NETLIMIT_AT, .. } := D.ig.qtopology
  let { NETLIMIT_WITHIN, .. } := D.ig.dv.qtopology2
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, SET_TAC, VECTOR_ARITH,
        .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { AND_FORALL_THM, CARD_SUBSET, CONJ_ASSOC, DE_MORGAN_THM, DIMINDEX_1, EQ_IMP,
        FINITE_IMAGE, FINITE_RESTRICT, FINITE_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, IMP_CONJ, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_UNION, LE_TRANS, LEFT_IMP_EXISTS_THM, MONO_AND,
        MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, PAIR_EQ, REAL_ADD_LID,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_01, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RZERO, REAL_OF_NUM_LE, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUM_CONST, SUM_IMAGE_GEN, SUM_LE, SUM_LMUL, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DROP_EQ, NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_INTERVAL, OPEN_BALL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS ← prove
   r"!f:real^1->real^N f' s a b.
      negligible s /\ drop a <= drop b /\
      f absolutely_continuous_on interval[a,b] /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f'(x)) (at x within interval[a,b]))
      ==> (f' has_integral (f(b) - f(a))) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_BARTLE THEN
    EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [absolutely_continuous_on]) THEN
    REWRITE_TAC [absolutely_setcontinuous_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2 / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^1->bool", ← q r"d:real"] MEASURABLE_OUTER_OPEN) THEN
    ASM_SIMP_TAC [MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE, REAL_ADD_LID] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. if x IN s then u else ball(x:real^1,&1)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [gauge] THEN X_GEN_TAC (← q r"x:real^1") THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, REAL_LT_01] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"p:(real^1#(real^1->bool))->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC VSUM_NORM_TRIANGLE THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o
      REWRITE_RULE [tagged_partial_division_of]) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE SND (p:(real^1#(real^1->bool))->bool)") o
     MATCH_MP (← MESON [] (← q r"(!x y. P x y) ==> !x. P x (UNIONS x)"))) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [PARTIAL_DIVISION_OF_TAGGED_DIVISION],
        REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_IMAGE,
                     IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_PAIR_THM] THEN
        ASM_MESON_TAC [tagged_partial_division_of, SUBSET],
        TRANS_TAC REAL_LET_TRANS (← q r"measure(u:real^1->bool)") THEN
        ASM_REWRITE_TAC [] THEN TRANS_TAC REAL_LE_TRANS
         (← q r"measure(UNIONS (IMAGE SND (p:(real^1#(real^1->bool))->bool)))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> y <= x")) THEN
          MATCH_MP_TAC MEASURE_ELEMENTARY THEN
          ASM_MESON_TAC [PARTIAL_DIVISION_OF_TAGGED_DIVISION],
          MATCH_MP_TAC MEASURE_SUBSET THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [MEASURABLE_ELEMENTARY,
                           PARTIAL_DIVISION_OF_TAGGED_DIVISION],
            REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_IMAGE,
                         IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_PAIR_THM] THEN
            FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
            FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
            REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
            REWRITE_TAC [AND_FORALL_THM, IMP_IMP] THEN
            REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN SET_TAC []]]],
      W (MP_TAC o PART_MATCH (lhand o rand) (← ISPEC (← q r"SND") SUM_IMAGE_GEN) o
          lhand o rand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"y <= &2 * x ==> x < e / &2 ==> y <= e")) THEN
      REWRITE_TAC [← GSYM SUM_LMUL] THEN
      MATCH_MP_TAC SUM_LE THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"k:real^1->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?y z:real^1. k = interval[y,z] /\ x IN interval[y,z]")
      MP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE I [tagged_partial_division_of]) THEN
        ASM_MESON_TAC [],
        DISCH_THEN (REPEAT_TCL CHOOSE_THEN
         (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC))] THEN
      ASM_CASES_TAC (← q r"interval[y:real^1,z] = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN DISCH_TAC THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum {x | x IN (p:(real^1#(real^1->bool))->bool) /\
                 SND x = interval[y,z]}
            (\a. norm(f(z) - f(y):real^N))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE THEN
        ASM_SIMP_TAC [FINITE_RESTRICT, FORALL_PAIR_THM, IN_ELIM_THM] THEN
        ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
                      REAL_LE_REFL],
        ASM_SIMP_TAC [SUM_CONST, FINITE_RESTRICT] THEN
        ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                      INTERVAL_UPPERBOUND_NONEMPTY]] THEN
      ASM_CASES_TAC (← q r"content(interval[y:real^1,z]) = &0") THENL
       [SUBGOAL_THEN (← q r"z:real^1 = y")
          (fun th => REWRITE_TAC [th, VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO,
                                  REAL_LE_REFL]) THEN
        ASM_MESON_TAC [DROP_EQ, CONTENT_EQ_0_1, REAL_LE_ANTISYM,
                       INTERVAL_NE_EMPTY_1],
        MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE]] THEN
      REWRITE_TAC [REAL_OF_NUM_LE] THEN MP_TAC (← ISPECL
       [← q r"p:(real^1#(real^1->bool))->bool",
        ← q r"interval[a:real^1,b]", ← q r"x:real^1"]
       TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND) THEN
      ASM_REWRITE_TAC [DIMINDEX_1, EXP_1] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LE_TRANS) THEN
      MATCH_MP_TAC CARD_SUBSET THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_ELIM_THM, PAIR_EQ] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
      SET_TAC []])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_EQ ← prove
   r"!f:real^1->real^N a b.
      f absolutely_integrable_on interval[a,b] <=>
      f integrable_on interval[a,b] /\
      (\t. integral(interval[a,t]) f) has_bounded_variation_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_variation_on,
                 ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ] THEN
    ASM_CASES_TAC (← q r"(f:real^1->real^N) integrable_on interval[a,b]") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      HAS_BOUNDED_SETVARIATION_ON_EQ) THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^1", ← q r"d:real^1"] THEN STRIP_TAC THEN
    REWRITE_TAC [] THENL [CONV_TAC SYM_CONV, ALL_TAC] THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    MATCH_MP_TAC (← VECTOR_ARITH (← q r"b + c:real^N = a ==> a - b = c")) THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN REPEAT CONJ_TAC THEN
    TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          INTEGRABLE_ON_SUBINTERVAL))) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1]) THEN
    REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE ← prove
   r"!f:real^1->real^N f' s a b.
      f absolutely_continuous_on interval[a,b] /\
      negligible s /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f'(x)) (at x within interval[a,b]))
      ==> f' absolutely_integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop b <= drop a \/ drop a <= drop b")) THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_ON_NULL, CONTENT_EQ_0_1] THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_EQ] THEN CONJ_TAC THENL
     [REWRITE_TAC [integrable_on] THEN
      EXISTS_TAC (← q r"(f:real^1->real^N) b - f a") THEN
      MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
      EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
      REWRITE_TAC [BOUNDED_INTERVAL] THEN
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_EQ THEN
      EXISTS_TAC (← q r"\x. (f:real^1->real^N) x - f a") THEN
      ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_SUB,
                    ABSOLUTELY_CONTINUOUS_ON_CONST] THEN
      X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
      EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IN_INTERVAL_1],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
        STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC, ASM_REAL_ARITH_TAC] THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC]])

  let ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ ← prove
   r"!f:real^1->real^N f' a b.
      f' absolutely_integrable_on interval[a,b] /\
      (!x. x IN interval[a,b]
           ==> (f' has_integral (f x - f a)) (interval[a,x])) <=>
      f absolutely_continuous_on interval[a,b] /\
      ?s. negligible s /\
          !x. x IN interval [a,b] DIFF s
              ==> (f has_vector_derivative f' x) (at x within interval[a,b])"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_EQ THEN
      EXISTS_TAC (← q r"\x. (f:real^1->real^N) a + integral(interval[a,x]) f'") THEN
      ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT,
                    ABSOLUTELY_CONTINUOUS_ON_ADD,
                    ABSOLUTELY_CONTINUOUS_ON_CONST] THEN
      X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"a + b:real^N = c <=> b = c - a")] THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN ASM_SIMP_TAC [],
      FIRST_ASSUM (MP_TAC o MATCH_MP HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL o
          MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s:real^1->bool") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [IN_DIFF] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^1") THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"((\x:real^1. (f:real^1->real^N) a) has_vector_derivative (vec 0))
        (at x within interval[a,b])")
      MP_TAC THENL [REWRITE_TAC [HAS_VECTOR_DERIVATIVE_CONST], ALL_TAC] THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_VECTOR_DERIVATIVE_ADD) THEN
      REWRITE_TAC [VECTOR_ADD_LID] THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
          HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN)) THEN
      EXISTS_TAC (← q r"&1") THEN ASM_REWRITE_TAC [REAL_LT_01] THEN
      X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"a + b:real^N = c <=> b = c - a")] THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN ASM_SIMP_TAC [],
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE THEN
      ASM_MESON_TAC [],
      MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
      EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IN_INTERVAL_1],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        X_GEN_TAC (← q r"y:real^1") THEN REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
        STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC, ASM_REAL_ARITH_TAC] THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC]])

  let ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT ← prove
   r"!f:real^1->real^N f' a b.
      f' absolutely_integrable_on interval[a,b] /\
      (!x. x IN interval[a,b]
           ==> (f' has_integral (f x - f a)) (interval[a,x])) <=>
      f absolutely_continuous_on interval[a,b] /\
      ?s. negligible s /\
          !x. x IN interval [a,b] DIFF s
              ==> (f has_vector_derivative f' x) (at x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ] THEN
    AP_TERM_TAC THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC),
      MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN]] THEN
    EXISTS_TAC (← q r"(a:real^1) INSERT b INSERT s") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_INSERT] THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, IN_INTERVAL_1, DE_MORGAN_THM] THEN
    X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [← GSYM DROP_EQ] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
    MATCH_MP_TAC EQ_IMP THEN
    REWRITE_TAC [has_vector_derivative, has_derivative] THEN
    REWRITE_TAC [NETLIMIT_WITHIN, NETLIMIT_AT] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC LIM_WITHIN_INTERIOR THEN
    REWRITE_TAC [INTERIOR_INTERVAL, IN_INTERVAL_1] THEN
    ASM_REAL_ARITH_TAC)

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ ← prove
   r"!f':real^1->real^N a b.
     f' absolutely_integrable_on interval[a,b] <=>
     ?f s. f absolutely_continuous_on interval[a,b] /\
           negligible s /\
           !x. x IN interval [a,b] DIFF s
               ==> (f has_vector_derivative f' x) (at x within interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [← GSYM ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [← TAUT (← q r"(p <=> p /\ q) <=> p ==> q")] THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    EXISTS_TAC (← q r"\t. integral(interval[a,t]) (f':real^1->real^N)") THEN
    REWRITE_TAC [INTEGRAL_REFL, VECTOR_SUB_RZERO] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      INTEGRABLE_ON_SUBINTERVAL)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
    REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT ← prove
   r"!f':real^1->real^N a b.
     f' absolutely_integrable_on interval[a,b] <=>
     ?f s. f absolutely_continuous_on interval[a,b] /\
           negligible s /\
           !x. x IN interval [a,b] DIFF s
               ==> (f has_vector_derivative f' x) (at x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ] THEN
    AP_TERM_TAC THEN ABS_TAC THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC),
      MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN]] THEN
    EXISTS_TAC (← q r"(a:real^1) INSERT b INSERT s") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_INSERT] THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, IN_INTERVAL_1, DE_MORGAN_THM] THEN
    X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [← GSYM DROP_EQ] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
    MATCH_MP_TAC EQ_IMP THEN
    REWRITE_TAC [has_vector_derivative, has_derivative] THEN
    REWRITE_TAC [NETLIMIT_WITHIN, NETLIMIT_AT] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC LIM_WITHIN_INTERIOR THEN
    REWRITE_TAC [INTERIOR_INTERVAL, IN_INTERVAL_1] THEN
    ASM_REAL_ARITH_TAC)

  let ABSOLUTE_INTEGRATION_BY_PARTS_SUM ← prove
   r"!(bop:real^M->real^N->real^P) (f:real^1->real^M) g f' g' a b.
        bilinear bop /\ drop a <= drop b /\
        (f' absolutely_integrable_on interval[a,b] /\
         !x. x IN interval[a,b]
             ==> (f' has_integral f(x) - f(a)) (interval[a,x])) /\
        (g' absolutely_integrable_on interval[a,b] /\
         !x. x IN interval[a,b]
             ==> (g' has_integral g(x) - g(a)) (interval[a,x]))
        ==> (\x. bop (f x) (g' x) + bop (f' x) (g x))
            absolutely_integrable_on interval[a,b] /\
            !x. x IN interval[a,b]
                ==> ((\x. bop (f x) (g' x) + bop (f' x) (g x))
                     has_integral (bop (f x) (g x) - bop (f a) (g a)))
                    (interval[a,x])"
   (REWRITE_TAC [ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM, IN_DIFF] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"s:real^1->bool") THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"t:real^1->bool") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_BILINEAR, BOUNDED_INTERVAL,
                  IS_INTERVAL_INTERVAL] THEN
    EXISTS_TAC (← q r"s UNION t:real^1->bool") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, IN_UNION, DE_MORGAN_THM] THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN])

  pure { FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS,
         ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_EQ,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE,
         ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ,
         ABSOLUTE_INTEGRAL_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE_EQ_ALT,
         ABSOLUTE_INTEGRATION_BY_PARTS_SUM }
/- ------------------------------------------------------------------------- -/
/- Characterizing absolutely continuous functions as Lebesgue integrals.    -/
/- (measure.ml 25206-25590)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCS where
  ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE : thm
  ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE_ALT : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE : thm
  ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCS [HolBase] (D : MeasureDeps) (BMSCP : MSCP) (BMSCQ : MSCQ) (BMSCR : MSCR) : ExceptT String IO MSCS := do
  -- @@SCOPE BEGIN
  let { LEBESGUE_DIFFERENTIATION_THEOREM_ALT, .. } := BMSCP
  let { ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT, .. } := BMSCQ
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS, .. } := BMSCR
  let { has_derivative_at, HAS_DERIVATIVE_COMPONENTWISE_AT, HAS_VECTOR_DERIVATIVE_SUB,
        HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN, VECTOR_DERIVATIVE_UNIQUE_AT,
        .. } := D.qderivatives
  let { ABSOLUTELY_CONTINUOUS_ON_ADD, ABSOLUTELY_CONTINUOUS_ON_CONST,
        ABSOLUTELY_CONTINUOUS_ON_EQ, ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUBSET, ABSOLUTELY_INTEGRABLE_COMPONENTWISE,
        ABSOLUTELY_INTEGRABLE_ON_EMPTY, ABSOLUTELY_INTEGRABLE_SPIKE,
        ABSOLUTELY_INTEGRABLE_SUB, CONTENT_1, .. } := D.qintegration1
  let { FATOU_STRONG, HAS_BOUNDED_VARIATION_DARBOUX,
        HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_CMUL,
        HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_INTEGRAL,
        INCREASING_BOUNDED_VARIATION, INTEGRABLE_AFFINITY, INTEGRABLE_CMUL,
        INTEGRABLE_CONST, INTEGRABLE_INCREASING_1, INTEGRABLE_SUB, .. } := D.qintegration2
  let { INTEGRAL_CMUL, INTEGRAL_COMBINE, INTEGRAL_CONST, INTEGRAL_DROP_LE, INTEGRAL_SPIKE,
        INTEGRAL_SUB, INTEGRAL_UNIQUE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT,
        NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_UNIONS, .. } := D.qintegration3
  let { has_vector_derivative, HAS_VECTOR_DERIVATIVE_AT_WITHIN, VECTOR_DIFFERENTIABLE,
        .. } := D.ig.qderivatives
  let { IMAGE_AFFINITY_INTERVAL, OPEN_CLOSED_INTERVAL_1, .. } := D.ig.qtopology
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { REAL_INV_INV, .. } := D.ig.dv.qsession
  let { LIM_COMPOSE_AT, LIM_EVENTUALLY, LIM_NULL, LIM_TRANSFORM, .. } := D.ig.dv.qtopology2
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_ASSOC, DE_MORGAN_THM, DIMINDEX_1, ETA_AX, FINITE_IMAGE, FINITE_NUMSEG,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_NUMSEG, IN_UNION, LAMBDA_BETA, LE_1,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_IN_EMPTY,
        REAL_ABS_INV, REAL_ABS_NUM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_0, REAL_LE_ADDR, REAL_LE_DIV, REAL_LE_INV_EQ,
        REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RADD, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_REFL,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RINV, REAL_NOT_LE, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_POS,
        REAL_SUB_LDISTRIB, REAL_SUB_LE, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, ENDS_IN_INTERVAL, LIFT_CMUL, LIFT_DROP,
        NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RID, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_EQ,
        VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_INTERVAL,
        LIM_ADD, LIM_CONST, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, SEQ_HARMONIC, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE ← prove
   r"!f:real^1->real^1 a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> ?s f'. negligible s /\
                   (!x. x IN interval[a,b] DIFF s
                        ==> (f has_vector_derivative f' x) (at x)) /\
                   f' absolutely_integrable_on interval[a,b] /\
                   (!x. x IN interval[a,b]
                        ==> drop(integral(interval[a,x]) f')
                            <= drop(f x) - drop(f a))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"interval[a:real^1,b]"]
          LEBESGUE_DIFFERENTIATION_THEOREM_ALT) THEN
    ASM_SIMP_TAC [IS_INTERVAL_INTERVAL, INCREASING_BOUNDED_VARIATION] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{a:real^1,b} UNION s") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY] THEN
    RULE_ASSUM_TAC
     (REWRITE_RULE [VECTOR_DIFFERENTIABLE, RIGHT_IMP_EXISTS_THM]) THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"f':real^1->real^1") o
          GEN_REWRITE_RULE I [SKOLEM_THM]) THEN
    EXISTS_TAC (← q r"f':real^1->real^1") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, ABSOLUTELY_INTEGRABLE_ON_EMPTY] THEN
    SUBGOAL_THEN
     (← q r"!c. c IN interval[a,b]
          ==> (f':real^1->real^1) absolutely_integrable_on interval[a,c] /\
              drop(integral(interval[a,c]) f') <= drop(f c) - drop(f a)")
     (fun th => ASM_MESON_TAC [ENDS_IN_INTERVAL, th]) THEN
    X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(interval[a:real^1,c] = {})") MP_TAC THENL
     [ASM_MESON_TAC [INTERVAL_NE_EMPTY_1, IN_INTERVAL_1], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"interval[a:real^1,c] SUBSET interval[a,b]") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1, REAL_LE_REFL],
      ALL_TAC] THEN
    UNDISCH_TAC (← q r"negligible(s:real^1->bool)") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN interval[a,c] DIFF s
          ==> ((f:real^1->real^1) has_vector_derivative f' x) (at x)")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN interval[a,c] /\ y IN interval[a,c] /\ drop x <= drop y
            ==> drop(f x) <= drop(f y)")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    SPEC_TAC ((← q r"c:real^1"), (← q r"b:real^1")) THEN GEN_TAC THEN REPEAT DISCH_TAC THEN
    ABBREV_TAC (← q r"g = \x. if drop x < drop a then f(a)
                        else if drop b < drop x then f(b)
                        else (f:real^1->real^1) x") THEN
    SUBGOAL_THEN
     (← q r"(f':real^1->real^1) absolutely_integrable_on interval[a,b] /\
      drop(integral(interval[a,b]) f') <= drop(g b) - drop(g a)")
    MP_TAC THENL
     [ALL_TAC,
      EXPAND_TAC "g" THEN REWRITE_TAC [REAL_LT_REFL] THEN
      ASM_REWRITE_TAC [← GSYM INTERVAL_EQ_EMPTY_1]] THEN
    ABBREV_TAC (← q r"t = s UNION {a:real^1,b}") THEN
    SUBGOAL_THEN (← q r"negligible(t:real^1->bool)") MP_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN interval[a,b] DIFF t
            ==> ((g:real^1->real^1) has_vector_derivative f' x) (at x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF] THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC THEN
      MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^1->real^1", ← q r"interval(a:real^1,b)"] THEN
      REWRITE_TAC [OPEN_INTERVAL, CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [OPEN_CLOSED_INTERVAL_1, IN_DIFF, IN_INSERT] THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, DE_MORGAN_THM, IN_INTERVAL_1] THEN
      REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN
      REWRITE_TAC [← GSYM REAL_NOT_LE] THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x. drop b <= drop x ==> (g:real^1->real^1) x = g b")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      EXPAND_TAC "g" THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      AP_TERM_TAC THEN REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x y. drop x <= drop y ==> drop(g x) <= drop(g y)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      EXPAND_TAC "g" THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL]) THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
      REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN ASM_REWRITE_TAC [] THEN
      DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    UNDISCH_TAC (← q r"~(interval[a:real^1,b] = {})") THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    SPEC_TAC ((← q r"t:real^1->bool"), (← q r"s:real^1->bool")) THEN
    SPEC_TAC ((← q r"g:real^1->real^1"), (← q r"f:real^1->real^1")) THEN
    REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\n x. &n % ((f:real^1->real^1)(x + lift(inv(&n))) - f(x))",
      ← q r"f':real^1->real^1", ← q r"interval[a:real^1,b]", ← q r"s:real^1->bool",
      ← q r"drop(f(b:real^1)) - drop(f a)"] FATOU_STRONG) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN
      REWRITE_TAC [has_derivative_at, has_vector_derivative] THEN
      DISCH_THEN (MP_TAC o
        SPEC (← q r"\n. x + lift(inv(&n))") o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
         (← REWRITE_RULE [CONJ_ASSOC]
            (← ISPEC (← q r"sequentially") LIM_COMPOSE_AT))) o
        CONJUNCT2) THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, o_DEF, VECTOR_ADD_SUB] THEN
      REWRITE_TAC [NORM_LIFT, REAL_ABS_INV, REAL_ABS_NUM, REAL_INV_INV] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_INV_0, VECTOR_MUL_LZERO] THEN
      ANTS_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
        MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST, SEQ_HARMONIC],
        ALL_TAC] THEN
      GEN_REWRITE_TAC RAND_CONV [LIM_NULL] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM) THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"1") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"n % (f' - (f + d)) - (n % (f' - f) - k):real^N = k - n % d")] THEN
      REWRITE_TAC [LIFT_DROP, VECTOR_MUL_ASSOC, VECTOR_SUB_EQ] THEN
      ASM_SIMP_TAC [REAL_MUL_RINV, REAL_OF_NUM_EQ, LE_1, VECTOR_MUL_LID],
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC INTEGRABLE_CMUL THEN
      MATCH_MP_TAC INTEGRABLE_SUB THEN CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [INTEGRABLE_INCREASING_1]] THEN
      SUBGOAL_THEN
       (← q r"(f:real^1->real^1) integrable_on
        interval[a + lift(inv(&n)),b + lift(inv(&n))]")
      MP_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_INCREASING_1 THEN ASM_SIMP_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"&1", ← q r"lift(inv(&n))"] o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_AFFINITY)) THEN
      REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [real_div, REAL_MUL_LID, VECTOR_MUL_LID] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) + --x:real^1 = a")] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INTERVAL_EQ_EMPTY_1]) THEN
      ASM_REWRITE_TAC [DROP_ADD, ← REAL_ARITH (← q r"x + i < y + i <=> ~(y <= x)")] THEN
      ASM_MESON_TAC [INTERVAL_NE_EMPTY_1],
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [DROP_CMUL, DROP_SUB] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
      REWRITE_TAC [REAL_POS, REAL_SUB_LE] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [DROP_ADD, REAL_LE_ADDR, LIFT_DROP, REAL_LE_INV_EQ] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN REWRITE_TAC [VECTOR_ADD_LDISTRIB] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1",
      ← q r"integral (interval[a + lift(inv(&n)),b + lift(inv(&n))]) f:real^1",
      ← q r"interval[a + lift(inv(&n)),b + lift(inv(&n))]",
      ← q r"&1", ← q r"lift(inv(&n))"] HAS_INTEGRAL_AFFINITY) THEN
    REWRITE_TAC [DIMINDEX_1] THEN
    REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL, IMAGE_AFFINITY_INTERVAL] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [VECTOR_MUL_LID, INTERVAL_EQ_EMPTY_1] THEN
    REWRITE_TAC [DROP_ADD, LIFT_DROP] THEN
    COND_CASES_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) + --x:real^N = a")]] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [INTEGRABLE_INCREASING_1], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&n") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN STRIP_TAC THEN
    REWRITE_TAC [VECTOR_SUB_LDISTRIB] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) INTEGRAL_SUB o  rand o lhand o snd) THEN
    SUBGOAL_THEN (← q r"!u v. (f:real^1->real^1) integrable_on interval[u,v]")
    ASSUME_TAC THENL [ASM_MESON_TAC [INTEGRABLE_INCREASING_1], ALL_TAC] THEN
    ASM_SIMP_TAC [INTEGRABLE_CMUL, INTEGRAL_CMUL] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, DROP_CMUL] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b + lift(&1 / &n)", ← q r"a + lift(&1 / &n)"]
     INTEGRAL_COMBINE) THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + b:real^N = b <=> b = b - a")] THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [DROP_ADD, REAL_LE_ADDR, REAL_LE_RADD] THEN
      SIMP_TAC [real_div, REAL_MUL_LID, REAL_LE_INV_EQ, LIFT_DROP, REAL_POS] THEN
      ASM_MESON_TAC [INTERVAL_NE_EMPTY_1],
      DISCH_THEN (SUBST1_TAC o MATCH_MP (← VECTOR_ARITH
       (← q r"a + b:real^N = c ==> b = c - a")))] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b + lift(&1 / &n)", ← q r"b:real^1"]
     INTEGRAL_COMBINE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [DROP_ADD, REAL_LE_ADDR, REAL_LE_RADD] THEN
      SIMP_TAC [real_div, REAL_MUL_LID, REAL_LE_INV_EQ, LIFT_DROP, REAL_POS] THEN
      ASM_MESON_TAC [INTERVAL_NE_EMPTY_1],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(i + b) - a - i:real^N = b - a")] THEN
    REWRITE_TAC [DROP_SUB, REAL_SUB_LDISTRIB] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b /\ d <= c ==> a - c <= b - d")) THEN
    CONJ_TAC THENL
     [TRANS_TAC REAL_LE_TRANS
       (← q r"&n * drop(integral (interval[b,b + lift (&1 / &n)])
                           (\x. (f:real^1->real^1) b))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
        MATCH_MP_TAC INTEGRAL_DROP_LE THEN
        ASM_REWRITE_TAC [INTEGRABLE_CONST, IN_INTERVAL_1] THEN
        ASM_MESON_TAC [REAL_LE_REFL],
        REWRITE_TAC [INTEGRAL_CONST] THEN
        SIMP_TAC [CONTENT_1, DROP_ADD, LIFT_DROP, REAL_LE_ADDR,
                  REAL_LE_DIV, REAL_POS] THEN
        REWRITE_TAC [DROP_CMUL] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_OF_NUM_LE]) THEN
        CONV_TAC (fun t => REAL_FIELD t)],
      TRANS_TAC REAL_LE_TRANS
       (← q r"&n * drop(integral (interval[a,a + lift (&1 / &n)])
                           (\x. (f:real^1->real^1) a))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [INTEGRAL_CONST] THEN
        SIMP_TAC [CONTENT_1, DROP_ADD, LIFT_DROP, REAL_LE_ADDR,
                  REAL_LE_DIV, REAL_POS] THEN
        REWRITE_TAC [DROP_CMUL] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_OF_NUM_LE]) THEN
        CONV_TAC (fun t => REAL_FIELD t),
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
        MATCH_MP_TAC INTEGRAL_DROP_LE THEN
        ASM_SIMP_TAC [INTEGRABLE_CONST, IN_INTERVAL_1]]])

  let ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE_ALT ← prove
   r"!f:real^1->real^1 f' a b s.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x))
        ==> f' absolutely_integrable_on interval[a,b] /\
            (!x. x IN interval[a,b]
                 ==> drop(integral(interval[a,x]) f')
                     <= drop(f x) - drop(f a))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^1->bool", ← q r"g:real^1->real^1"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN interval[a,b] DIFF (s UNION t) ==> (f':real^1->real^1) x = g x")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
      MATCH_MP_TAC VECTOR_DERIVATIVE_UNIQUE_AT THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^1->real^1", ← q r"x:real^1"] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE) THEN
      EXISTS_TAC (← q r"g:real^1->real^1") THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"s UNION t:real^1->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ],
      X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"drop(integral(interval[a,c]) (g:real^1->real^1))") THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
      MATCH_MP_TAC INTEGRAL_SPIKE THEN
      EXISTS_TAC (← q r"s UNION t:real^1->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
      SUBGOAL_THEN (← q r"interval[a:real^1,c] SUBSET interval[a,b]") MP_TAC THENL
       [ASM_MESON_TAC [IN_INTERVAL_1, SUBSET_INTERVAL_1, REAL_LE_REFL],
        ASM SET_TAC []]])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE ← (do
    let lemma ← prove
     r"!f:real^1->real^1 a b.
          f has_bounded_variation_on interval[a,b]
          ==> ?f' s. negligible s /\
                     (!x. x IN interval[a,b] DIFF s
                          ==> (f has_vector_derivative f' x) (at x)) /\
                     f' absolutely_integrable_on interval[a,b]"
     (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE I [HAS_BOUNDED_VARIATION_DARBOUX]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1"]
       ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1"]
       ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:real^1->bool", ← q r"g':real^1->real^1"] THEN
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^1->bool", ← q r"h':real^1->real^1"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x. (g':real^1->real^1) x - h' x") THEN
      EXISTS_TAC (← q r"s UNION t:real^1->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_SUB] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM FUN_EQ_THM]) THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_SUB THEN
      ASM SET_TAC [])
    prove
     r"!f:real^1->real^N a b.
          f has_bounded_variation_on interval[a,b]
          ==> ?f' s. negligible s /\
                     (!x. x IN interval[a,b] DIFF s
                          ==> (f has_vector_derivative f' x) (at x)) /\
                     f' absolutely_integrable_on interval[a,b]"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← MATCH_MP MONO_FORALL (← GEN (← q r"i:num") (← MATCH_MP MONO_IMP (← CONJ
        (← TAUT (← q r"1 <= i /\ i <= dimindex(:N) ==> 1 <= i /\ i <= dimindex(:N)"))
        (← SPECL [← q r"\x. lift((f:real^1->real^N)x$i)", ← q r"a:real^1", ← q r"b:real^1"]
           lemma))))) THEN
      ASM_REWRITE_TAC [← GSYM HAS_BOUNDED_VARIATION_ON_COMPONENTWISE] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:num->real^1->real^1", ← q r"s:num->real^1->bool"] THEN
      DISCH_TAC THEN
      EXISTS_TAC (← q r"(\x. lambda i. drop((g:num->real^1->real^1) i x))
                  :real^1->real^N") THEN
      EXISTS_TAC (← q r"UNIONS (IMAGE (s:num->real^1->bool) (1..dimindex(:N)))") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
        ASM_SIMP_TAC [IN_NUMSEG, FINITE_IMAGE, FORALL_IN_IMAGE, FINITE_NUMSEG],
        X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [IN_DIFF, UNIONS_IMAGE, IN_NUMSEG, IN_ELIM_THM] THEN
        REWRITE_TAC [← MESON [] (← q r"~(?x. P x /\ Q x) <=> (!x. P x ==> ~Q x)")] THEN
        STRIP_TAC THEN
        REWRITE_TAC [has_vector_derivative] THEN
        ONCE_REWRITE_TAC [HAS_DERIVATIVE_COMPONENTWISE_AT] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
        ASM_SIMP_TAC [IN_DIFF, has_vector_derivative] THEN
        ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, LAMBDA_BETA] THEN
        REWRITE_TAC [LIFT_CMUL, LIFT_DROP],
        ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
        ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX]]))

  let ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ ← prove
   r"!f:real^1->real^N a b.
        f absolutely_continuous_on interval[a,b] <=>
        ?f'. f' absolutely_integrable_on interval[a,b] /\
             !x. x IN interval[a,b]
                 ==> (f' has_integral (f x - f a)) (interval[a,x])"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON)) THEN
      REWRITE_TAC [BOUNDED_INTERVAL] THEN DISCH_THEN (MP_TAC o MATCH_MP
        ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f':real^1->real^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
      EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IN_INTERVAL_1],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
        ASM_MESON_TAC [IN_INTERVAL_1],
        X_GEN_TAC (← q r"y:real^1") THEN REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
        STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_AT_WITHIN THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC],
      FIRST_ASSUM (MP_TAC o MATCH_MP
        ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT) THEN
      MP_TAC (← ISPECL [← q r"interval[a:real^1,b]", ← q r"(f:real^1->real^N) a"]
        ABSOLUTELY_CONTINUOUS_ON_CONST) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_CONTINUOUS_ON_ADD) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ABSOLUTELY_CONTINUOUS_ON_EQ) THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + i:real^N = x <=> i = x - a")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN ASM_SIMP_TAC []])

  pure { ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE,
         ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE_ALT,
         ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE,
         ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ }

/- ------------------------------------------------------------------------- -/
/- Variation in terms of integral in a more general setting.                -/
/- (measure.ml 25591-25851)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCT where
  ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION : thm
  ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION_ALT : thm
  VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_GEN : thm
  ABSOLUTELY_CONTINUOUS_VECTOR_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCT [HolBase] (D : MeasureDeps) (BMSCR : MSCR) (BMSCS : MSCS) : ExceptT String IO MSCT := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE,
        FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS, .. } := BMSCR
  let { ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ,
        ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE,
        ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE, .. } := BMSCS
  let { NORM_VECTOR_DERIVATIVES_LE_AT, VECTOR_DERIVATIVE_UNIQUE_AT, .. } := D.qderivatives
  let { ABSOLUTELY_CONTINUOUS_COMPARISON, ABSOLUTELY_CONTINUOUS_ON_EMPTY,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUBSET, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL, ABSOLUTELY_INTEGRABLE_SET_VARIATION,
        ABSOLUTELY_INTEGRABLE_SPIKE, CONTENT_EQ_0_1, .. } := D.qintegration1
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        .. } := D.qintegration2
  let { INTEGRAL_DROP_LE_AE, INTEGRAL_SPIKE, INTEGRAL_UNIQUE, INTERVAL_LOWERBOUND_1,
        INTERVAL_UPPERBOUND_1, NEGLIGIBLE_INSERT, NEGLIGIBLE_UNION_EQ, SET_VARIATION_EQ,
        vector_variation, VECTOR_VARIATION_COMBINE, VECTOR_VARIATION_GE_NORM_FUNCTION,
        VECTOR_VARIATION_MONOTONE, VECTOR_VARIATION_ON_NULL, .. } := D.qintegration3
  let { HAS_VECTOR_DERIVATIVE_AT_1D, HAS_VECTOR_DERIVATIVE_AT_WITHIN,
        HAS_VECTOR_DERIVATIVE_WITHIN_1D, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET,
        .. } := D.ig.qderivatives
  let { INTERIOR_INTERVAL, LIM_WITHIN_INTERIOR, OPEN_CLOSED_INTERVAL_1,
        .. } := D.ig.qtopology
  let { LIM_DROP_LBOUND, TRIVIAL_LIMIT_AT, .. } := D.ig.dv.qtopology2
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_SYM, DE_MORGAN_THM, EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, REAL_ABS_SUB,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_NEG, REAL_LE_INV_EQ, REAL_LE_MUL, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG, REAL_NEG_SUB, REAL_SUB_LE,
        REAL_SUB_RZERO, REAL_WLOG_LE, SUBSET, SUBSET_REFL, .. } := D.ig.dv.dg.pt.cvx.core5
  let { DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_EQ, DROP_SUB, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT,
        LIFT_DROP, LIFT_NUM, LIFT_SUB, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.ig.dv.dg.pt.cvx.met
  let { EVENTUALLY_AT, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, OPEN_CONTAINS_BALL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, SEGMENT_1, SEGMENT_SYM, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION ← prove
   r"!f:real^1->real^N a b.
      f has_bounded_variation_on interval[a,b]
      ==> ?s f'. negligible s /\
                 (!x. x IN interval[a,b] DIFF s
                      ==> (f has_vector_derivative f' x) (at x)) /\
                 f' absolutely_integrable_on interval[a,b] /\
                 !c. c IN interval[a,b]
                     ==> drop(integral (interval[a,c]) (\x. lift(norm(f' x))))
                         <= vector_variation (interval[a,c]) f"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f':real^1->real^N", ← q r"s:real^1->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. lift(vector_variation (interval[a,x]) (f:real^1->real^N))",
      ← q r"a:real^1", ← q r"b:real^1"] ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)),
        ALL_TAC] THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [LIFT_DROP, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^1->bool", ← q r"v':real^1->real^1"] THEN
    STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"a INSERT b INSERT s UNION t:real^1->bool", ← q r"f':real^1->real^N"] THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_INSERT] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"interval[a:real^1,c] SUBSET interval[a,b]") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"c IN interval[a:real^1,b]"))) THEN
    SIMP_TAC [VECTOR_VARIATION_ON_NULL, CONTENT_EQ_0_1, REAL_LE_REFL,
              BOUNDED_INTERVAL, REAL_SUB_RZERO] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC INTEGRAL_DROP_LE_AE THEN
    EXISTS_TAC (← q r"a INSERT b INSERT s UNION t:real^1->bool") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_INSERT] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE THEN
      ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL],
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, IN_UNION, LIFT_DROP, DE_MORGAN_THM] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= abs b /\ &0 <= b ==> a <= b")) THEN
    SUBGOAL_THEN (← q r"eventually (\y:real^1. y IN interval[a,b]) (at x)")
    ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"interval(a:real^1,b)") OPEN_CONTAINS_BALL) THEN
      REWRITE_TAC [OPEN_INTERVAL, EVENTUALLY_AT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [OPEN_CLOSED_INTERVAL_1, IN_DIFF, IN_INSERT] THEN
      ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"d:real") THEN REWRITE_TAC [SUBSET, IN_BALL, IN_DIFF] THEN
      MESON_TAC [DIST_SYM],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM NORM_1] THEN
      MATCH_MP_TAC NORM_VECTOR_DERIVATIVES_LE_AT THEN MAP_EVERY EXISTS_TAC
       [← q r"f:real^1->real^N",
        ← q r"\x. lift (vector_variation (interval[a,x]) (f:real^1->real^N))",
        ← q r"x:real^1"] THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
      REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN
      SUBGOAL_THEN
       (← q r"!u v. u IN interval[a,b] /\ v IN interval[a,b]
              ==> norm((f:real^1->real^N) u - f v) <=
                  abs(vector_variation (interval[a,u]) f -
                      vector_variation (interval[a,v]) f)")
       (fun th => MP_TAC th THEN ASM SET_TAC []) THEN
      REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LE THEN CONJ_TAC THENL
       [REWRITE_TAC [NORM_SUB, REAL_ABS_SUB, CONJ_SYM], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN REPEAT STRIP_TAC THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"vector_variation (interval[u,v]) (f:real^1->real^N)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
        ASM_REWRITE_TAC [SEGMENT_1, SUBSET_REFL] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC (← REAL_ARITH (← q r"a + b = c ==> b <= abs(a - c)")) THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMBINE THEN REPEAT CONJ_TAC THEN
        TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET))) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC],
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1"))) THEN
      ASM_REWRITE_TAC [IN_DIFF, HAS_VECTOR_DERIVATIVE_AT_1D] THEN
      REPEAT (ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          LIM_DROP_LBOUND)) THEN
      REWRITE_TAC [TRIVIAL_LIMIT_AT, DROP_CMUL, DROP_SUB, LIFT_DROP] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
      X_GEN_TAC (← q r"y:real^1") THEN REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"x IN interval[a:real^1,b]") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"drop x <= drop y \/ drop y <= drop x")) THENL
       [ALL_TAC,
        ONCE_REWRITE_TAC [← GSYM REAL_NEG_SUB] THEN
        SIMP_TAC [REAL_INV_NEG, REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG]] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_REWRITE_TAC [REAL_LE_INV_EQ, REAL_SUB_LE] THEN
      (MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)),
        ALL_TAC]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC])

  let ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION_ALT ← prove
   r"!f:real^1->real^N f' a b s.
        f has_bounded_variation_on interval[a,b] /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x within interval[a,b]))
        ==> f' absolutely_integrable_on interval[a,b] /\
            !c. c IN interval[a,b]
                ==> drop(integral (interval[a,c]) (\x. lift(norm(f' x))))
                    <= vector_variation (interval[a,c]) f"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^1->bool", ← q r"g:real^1->real^N"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN interval[a,b] DIFF (a INSERT b INSERT (s UNION t))
          ==> (f':real^1->real^N) x = g x")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
      MATCH_MP_TAC VECTOR_DERIVATIVE_UNIQUE_AT THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^1->real^N", ← q r"x:real^1"] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      SUBGOAL_THEN (← q r"((f:real^1->real^N) has_vector_derivative f' x)
                    (at x within interval[a,b])")
      MP_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP] THEN
      SIMP_TAC [HAS_VECTOR_DERIVATIVE_WITHIN_1D, HAS_VECTOR_DERIVATIVE_AT_1D] THEN
      MATCH_MP_TAC LIM_WITHIN_INTERIOR THEN
      REWRITE_TAC [INTERIOR_INTERVAL] THEN
      REWRITE_TAC [OPEN_CLOSED_INTERVAL_1] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE) THEN
      EXISTS_TAC (← q r"g:real^1->real^N") THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"a INSERT b INSERT (s UNION t):real^1->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_INSERT],
      X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"drop(integral(interval[a,c])
            (\x. lift(norm((g:real^1->real^N) x))))") THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
      MATCH_MP_TAC INTEGRAL_SPIKE THEN
      EXISTS_TAC (← q r"a INSERT b INSERT (s UNION t):real^1->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_INSERT] THEN
      SUBGOAL_THEN (← q r"interval[a:real^1,c] SUBSET interval[a,b]") MP_TAC THENL
       [ASM_MESON_TAC [IN_INTERVAL_1, SUBSET_INTERVAL_1, REAL_LE_REFL],
        ASM SET_TAC []]])

  let VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_GEN ← prove
   r"!f:real^1->real^N f' a b s.
        f absolutely_continuous_on interval[a,b] /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x within interval[a,b]))
        ==> f' absolutely_integrable_on interval[a,b] /\
            vector_variation (interval[a,b]) f =
            drop(integral (interval[a,b]) (\x. lift(norm(f' x))))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_ABSOLUTELY_CONTINUOUS_DERIVATIVE],
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SET_VARIATION)] THEN
    REWRITE_TAC [vector_variation] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
     MATCH_MP_TAC SET_VARIATION_EQ THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN
    SIMP_TAC [INTERVAL_NE_EMPTY_1, INTERVAL_LOWERBOUND_1,
              INTERVAL_UPPERBOUND_1] THEN
    STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS THEN
    EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [ABSOLUTELY_CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, SUBSET, IN_DIFF])

  let ABSOLUTELY_CONTINUOUS_VECTOR_VARIATION ← prove
   r"!f:real^1->real^N a b.
       f has_bounded_variation_on interval[a,b] /\
       (\x. lift(vector_variation (interval [a,x]) f))
                absolutely_continuous_on interval[a,b] <=>
       f absolutely_continuous_on interval[a,b]"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_COMPARISON)) THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      REWRITE_TAC [dist] THEN TRANS_TAC REAL_LE_TRANS
       (← q r"vector_variation(interval[x,y]) (f:real^1->real^N)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
        ASM_SIMP_TAC [SEGMENT_1, REAL_LT_IMP_LE, SUBSET_REFL],
        REWRITE_TAC [NORM_LIFT, ← GSYM LIFT_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"x + y = z ==> y <= abs(x - z)")) THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMBINE THEN REPEAT CONJ_TAC] THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET))) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
                      BOUNDED_INTERVAL],
        DISCH_THEN (MP_TAC o MATCH_MP
          ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE)] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^1->real^N", ← q r"s:real^1->bool"] THEN
      STRIP_TAC THEN
      ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_EMPTY] THEN
      REWRITE_TAC [ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ] THEN
      EXISTS_TAC (← q r"\x. lift(norm((f':real^1->real^N) x))") THEN
      SIMP_TAC [VECTOR_VARIATION_ON_NULL, CONTENT_EQ_0_1, REAL_LE_REFL,
                BOUNDED_INTERVAL, REAL_SUB_RZERO, LIFT_NUM, VECTOR_SUB_RZERO] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"b IN interval[a,b] /\
        (!c. c IN interval[a,b] ==> P(interval[a,c]) /\ Q c)
        ==> P(interval[a,b]) /\
            !c. c IN interval[a,b] ==> Q c")) THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
      SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
                ← TAUT (← q r"(p ==> q) ==> (p /\ q /\ r <=> p /\ r)")] THEN
      X_GEN_TAC (← q r"c:real^1") THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN
      CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_GEN o rand o snd) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC, SIMP_TAC [ABSOLUTELY_INTEGRABLE_NORM]] THEN
      SUBGOAL_THEN (← q r"interval[a:real^1,c] SUBSET interval[a,b]") ASSUME_TAC THENL
       [REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN, SUBSET, IN_DIFF,
                       ABSOLUTELY_CONTINUOUS_ON_SUBSET]]])

  pure { ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION,
         ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION_ALT,
         VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_GEN,
         ABSOLUTELY_CONTINUOUS_VECTOR_VARIATION }
/- ------------------------------------------------------------------------- -/
/- Converses: equality holds only if the function is absolutely continuous. -/
/- (measure.ml 25852-25957)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCU where
  INCREASING_FTC_AE_IMP_ABSOLUTELY_CONTINUOUS : thm
  VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_REV : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCU [HolBase] (D : MeasureDeps) (BMSCS : MSCS) (BMSCT : MSCT) : ExceptT String IO MSCU := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ,
        ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE_ALT, .. } := BMSCS
  let { ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION_ALT,
        ABSOLUTELY_CONTINUOUS_VECTOR_VARIATION, .. } := BMSCT
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        CONTENT_EQ_0_1, .. } := D.qintegration1
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        .. } := D.qintegration2
  let { INTEGRAL_COMBINE, VECTOR_VARIATION_COMBINE, VECTOR_VARIATION_ON_NULL,
        .. } := D.qintegration3
  let { HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, .. } := D.ig.qderivatives
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { REAL_LE_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_SUB_RZERO, RIGHT_AND_FORALL_THM, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { DROP_ADD, DROP_EQ, DROP_SUB, LIFT_DROP, LIFT_NUM, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let INCREASING_FTC_AE_IMP_ABSOLUTELY_CONTINUOUS ← prove
   r"!f f' a b s.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x)) /\
        integral (interval[a,b]) f' = f(b) - f(a)
        ==> f absolutely_continuous_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ] THEN
    EXISTS_TAC (← q r"f':real^1->real^1") THEN
    REWRITE_TAC [RIGHT_AND_FORALL_THM] THEN X_GEN_TAC (← q r"c:real^1") THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"f':real^1->real^1"]
      ABSOLUTELY_INTEGRABLE_INCREASING_DERIVATIVE_ALT) THEN
    DISCH_THEN (fun th => tactic_of do
     pure (MP_TAC (← ISPECL [← q r"a:real^1", ← q r"c:real^1", ← q r"s:real^1->bool"] th) THEN
     MP_TAC (← ISPECL [← q r"c:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"] th) THEN
     MP_TAC (← ISPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"] th))) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"c IN interval[a:real^1,b]") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"interval[a:real^1,c] SUBSET interval[a,b] /\
      interval[c,b] SUBSET interval[a,b]")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_INTERVAL_1, SUBSET_INTERVAL_1, REAL_LE_REFL],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"b:real^1")))] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_REFL], DISCH_TAC] THEN
    ANTS_TAC THENL
     [ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"c:real^1")))] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_REFL], DISCH_TAC] THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM DROP_EQ]) THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_SUB] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"!j. i <= c - a /\ j <= b - c /\ i + j = k
          ==> k = b - a ==> i = c - a")) THEN
    EXISTS_TAC (← q r"drop(integral(interval[c:real^1,b]) f')") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [← GSYM DROP_ADD, DROP_EQ] THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    ASM_REWRITE_TAC [← GSYM IN_INTERVAL_1])

  let VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_REV ← prove
   r"!f:real^1->real^N f' a b s.
        f has_bounded_variation_on interval[a,b] /\
        negligible s /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x within interval[a,b])) /\
        vector_variation (interval[a,b]) f =
        drop(integral (interval[a,b]) (\x. lift(norm(f' x))))
        ==> f absolutely_continuous_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_CONTINUOUS_VECTOR_VARIATION] THEN
    ASM_REWRITE_TAC [ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_EQ] THEN
    EXISTS_TAC (← q r"\x. lift(norm((f':real^1->real^N) x))") THEN
    SIMP_TAC [VECTOR_VARIATION_ON_NULL, CONTENT_EQ_0_1, REAL_LE_REFL,
              BOUNDED_INTERVAL, REAL_SUB_RZERO, LIFT_NUM, VECTOR_SUB_RZERO] THEN
    REWRITE_TAC [RIGHT_AND_FORALL_THM] THEN X_GEN_TAC (← q r"c:real^1") THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"f':real^1->real^N"]
      ABSOLUTE_INTEGRAL_NORM_DERIVATIVE_LE_VARIATION_ALT) THEN
    DISCH_THEN (fun th => tactic_of do
     pure (MP_TAC (← ISPECL [← q r"a:real^1", ← q r"c:real^1", ← q r"s:real^1->bool"] th) THEN
     MP_TAC (← ISPECL [← q r"c:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"] th) THEN
     MP_TAC (← ISPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"] th))) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"c IN interval[a:real^1,b]") THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_NORM] THEN
    SUBGOAL_THEN
     (← q r"interval[a:real^1,c] SUBSET interval[a,b] /\
      interval[c,b] SUBSET interval[a,b]")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_INTERVAL_1, SUBSET_INTERVAL_1, REAL_LE_REFL],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, SUBSET, IN_DIFF,
                     HAS_BOUNDED_VARIATION_ON_SUBSET],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"b:real^1")))] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_REFL], DISCH_TAC] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, SUBSET, IN_DIFF,
                     HAS_BOUNDED_VARIATION_ON_SUBSET],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"c:real^1")))] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_REFL], DISCH_TAC] THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    MP_TAC (← ISPECL
     [← q r"\x. lift(norm((f':real^1->real^N) x))",
      ← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"]
          INTEGRAL_COMBINE) THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
    ASM_REWRITE_TAC [← GSYM IN_INTERVAL_1] THEN
    REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_ADD] THEN ASM_REAL_ARITH_TAC)

  pure { INCREASING_FTC_AE_IMP_ABSOLUTELY_CONTINUOUS,
         VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE_REV }
