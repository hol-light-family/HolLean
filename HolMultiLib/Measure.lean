  -- @@SCOPE END

  let MEASURABLE_OUTER_CLOSED_INTERVALS ← (do
    let lemma ← prove
     r"UNIONS (UNIONS {d n | n IN (:num)}) =
     UNIONS {UNIONS(d n) | n IN (:num)}"
     (REWRITE_TAC [SIMPLE_IMAGE, UNIONS_IMAGE] THEN
      GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN MESON_TAC [])
    prove
     r"!s:real^N->bool e.
        measurable s /\ &0 < e
        ==> ?d. COUNTABLE d /\
                (!k. k IN d ==> ~(k = {}) /\ (?a b. k = interval[a,b])) /\
                (!k l. k IN d /\ l IN d /\ ~(k = l)
                       ==> interior k INTER interior l = {}) /\
                s SUBSET UNIONS d /\
                measurable (UNIONS d) /\
                measure (UNIONS d) <= measure s + e"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?d. COUNTABLE d /\
        (!k. k IN d ==> ?a b:real^N. k = interval[a,b]) /\
        s SUBSET UNIONS d /\
        measurable (UNIONS d) /\
        measure (UNIONS d) <= measure s + e")
      MP_TAC THENL
       [ALL_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"d1:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPEC (← q r"d1:(real^N->bool)->bool") COUNTABLE_ELEMENTARY_DIVISION) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"d:(real^N->bool)->bool") THEN
        STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
        ASM_REWRITE_TAC []] THEN
      MP_TAC (← ISPECL
       [← q r"\n. s INTER (ball(vec 0:real^N,&n + &1) DIFF ball(vec 0,&n))",
        ← q r"measure(s:real^N->bool)"] HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS) THEN
      ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_DIFF, MEASURABLE_BALL] THEN
      SUBGOAL_THEN
       (← q r"!m n. ~(m = n)
          ==> (s INTER (ball(vec 0,&m + &1) DIFF ball(vec 0,&m))) INTER
              (s INTER (ball(vec 0,&n + &1) DIFF ball(vec 0,&n))) =
              ({}:real^N->bool)")
      ASSUME_TAC THENL
       [MATCH_MP_TAC WLOG_LT THEN REWRITE_TAC [] THEN
        CONJ_TAC THENL [MESON_TAC [INTER_COMM], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"m1 SUBSET n
      ==> (s INTER (m1 DIFF m)) INTER (s INTER (n1 DIFF n)) = {}")) THEN
        MATCH_MP_TAC SUBSET_BALL THEN
        REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE] THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [NEGLIGIBLE_EMPTY] THEN X_GEN_TAC (← q r"n:num") THEN
        W (MP_TAC o PART_MATCH (rand o rand)
          MEASURE_DISJOINT_UNIONS_IMAGE o lhand o snd) THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, DISJOINT] THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_DIFF, MEASURABLE_BALL] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        SIMP_TAC [SUBSET, FORALL_IN_UNIONS, IMP_CONJ, FORALL_IN_IMAGE,
                  RIGHT_FORALL_IMP_THM, IN_INTER] THEN
        ASM_SIMP_TAC [MEASURABLE_UNIONS, FINITE_NUMSEG, FORALL_IN_IMAGE,
                FINITE_IMAGE, MEASURABLE_INTER, MEASURABLE_DIFF, MEASURABLE_BALL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"UNIONS {s INTER (ball(vec 0,&n + &1) DIFF ball(vec 0,&n)) | n IN (:num)} =
    (s:real^N->bool)")
      ASSUME_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNIONS, EXISTS_IN_GSPEC, IN_UNIV, IN_INTER] THEN
        X_GEN_TAC (← q r"x:real^N") THEN
        ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"?n. (x:real^N) IN ball(vec 0,&n)") MP_TAC THENL
         [REWRITE_TAC [IN_BALL_0, REAL_ARCH_LT],
          GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") MP_TAC) THEN ASM_CASES_TAC (← q r"n = 0") THENL
           [ASM_REWRITE_TAC [IN_BALL_0, ← GSYM REAL_NOT_LE, NORM_POS_LE],
            STRIP_TAC THEN EXISTS_TAC (← q r"n - 1") THEN REWRITE_TAC [IN_DIFF] THEN
            ASM_SIMP_TAC [REAL_OF_NUM_ADD, SUB_ADD, LE_1] THEN
            FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]],
        ASM_REWRITE_TAC [] THEN DISCH_TAC] THEN
      MP_TAC (← MATCH_MP MONO_FORALL (← GEN (← q r"n:num")
       (← ISPECL
         [← q r"s INTER (ball(vec 0:real^N,&n + &1) DIFF ball(vec 0,&n))",
          ← q r"--(vec(n + 1)):real^N", ← q r"vec(n + 1):real^N",
          ← q r"e / &2 / &2 pow n"]
            MEASURABLE_OUTER_INTERVALS_BOUNDED))) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF, REAL_LT_POW2] THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_DIFF, MEASURABLE_BALL] THEN
        REWRITE_TAC [SUBSET, IN_INTER, IN_INTERVAL, IN_BALL_0, IN_DIFF, REAL_NOT_LT,
          REAL_OF_NUM_ADD, VECTOR_NEG_COMPONENT, VEC_COMPONENT, REAL_BOUNDS_LE] THEN
        MESON_TAC [COMPONENT_LE_NORM, REAL_LET_TRANS, REAL_LT_IMP_LE],
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
      X_GEN_TAC (← q r"d:num->(real^N->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"UNIONS {d n | n IN (:num)} :(real^N->bool)->bool") THEN
      REWRITE_TAC [lemma] THEN CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_UNIONS THEN
        ASM_REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
        SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_UNIONS, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC LAND_CONV [← GSYM th])) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, IN_UNIV, IN_UNIONS] THEN
        REWRITE_TAC [EXISTS_IN_GSPEC] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
       (← q r"sum(0..n) (\k. measure(s INTER (ball(vec 0:real^N,&k + &1) DIFF
                                  ball(vec 0,&k))) + e / &2 / &2 pow k)") THEN
      ASM_SIMP_TAC [SUM_LE_NUMSEG] THEN REWRITE_TAC [SUM_ADD_NUMSEG] THEN
      MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THENL
       [W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
          lhand o snd) THEN
        ASM_SIMP_TAC [DISJOINT, FINITE_NUMSEG, MEASURABLE_DIFF, MEASURABLE_INTER,
                      MEASURABLE_BALL] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, FINITE_NUMSEG,
          FINITE_IMAGE, MEASURABLE_DIFF, MEASURABLE_INTER, MEASURABLE_BALL] THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
        MATCH_MP_TAC SUBSET_UNIONS THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [SUBSET_UNIV],
        REWRITE_TAC [real_div, SUM_LMUL, REAL_INV_POW, SUM_GP, LT] THEN
        REWRITE_TAC [← GSYM real_div] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [← REAL_ARITH (← q r"e / &2 * (&1 - x) / (&1 / &2) <= e <=>
                            &0 <= e * x")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
        MATCH_MP_TAC REAL_POW_LE THEN CONV_TAC REAL_RAT_REDUCE_CONV]))

  let MEASURABLE_OUTER_OPEN_INTERVALS ← (do
    let lemma ← prove
     r"!s. UNIONS(s DELETE {}) = UNIONS s"
     (REWRITE_TAC [EXTENSION, IN_UNIONS, IN_DELETE] THEN
      MESON_TAC [NOT_IN_EMPTY])
    prove
     r"!s:real^N->bool e.
        measurable s /\ &0 < e
        ==> ?d. COUNTABLE d /\
                (!k. k IN d ==> ~(k = {}) /\ (?a b. k = interval(a,b))) /\
                s SUBSET UNIONS d /\
                measurable (UNIONS d) /\
                measure (UNIONS d) <= measure s + e"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"e / &2"]
        MEASURABLE_OUTER_CLOSED_INTERVALS) THEN
      ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"dset:(real^N->bool)->bool") THEN
      ASM_CASES_TAC (← q r"dset:(real^N->bool)->bool = {}") THENL
       [ASM_REWRITE_TAC [UNIONS_0, SUBSET_EMPTY] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
        ASM_REWRITE_TAC [UNIONS_0, NOT_IN_EMPTY, MEASURE_EMPTY, SUBSET_REFL] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      SUBGOAL_THEN
       (← q r"?f. dset = IMAGE (f:num->(real^N->bool)) (:num) DELETE {} /\
        (!m n. f m = f n ==> m = n \/ f n = {})")
      MP_TAC THENL
       [ASM_CASES_TAC (← q r"FINITE(dset:(real^N->bool)->bool)") THENL
         [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FINITE_HAS_SIZE]) THEN
          DISCH_THEN (MP_TAC o MATCH_MP HAS_SIZE_INDEX) THEN
          ABBREV_TAC (← q r"m = CARD(dset:(real^N->bool)->bool)") THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"\i. if i < m then (f:num->real^N->bool) i else {}") THEN
          REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
          GEN_REWRITE_TAC I [EXTENSION] THEN
          REWRITE_TAC [IN_DELETE, IN_IMAGE, IN_UNIV] THEN ASM_MESON_TAC [],
          MP_TAC (← ISPEC (← q r"dset:(real^N->bool)->bool")
            COUNTABLE_AS_INJECTIVE_IMAGE) THEN
          ASM_REWRITE_TAC [INFINITE] THEN MATCH_MP_TAC MONO_EXISTS THEN
          GEN_TAC THEN STRIP_TAC THEN CONJ_TAC THENL
           [ALL_TAC, ASM_MESON_TAC []] THEN
          ASM_REWRITE_TAC [← SET_RULE (← q r"s = s DELETE a <=> ~(a IN s)")] THEN
          ASM_MESON_TAC []],
        ALL_TAC] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:num->real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_forall o concl)) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, FORALL_AND_THM, SKOLEM_THM,
                   IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_DELETE, lemma] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!x. ~(P x) ==> ~(P x) /\ Q x) ==> (!x. P x ==> Q x) ==> !x. Q x"))) THEN
      ANTS_TAC THENL [MESON_TAC [EMPTY_AS_INTERVAL], ALL_TAC] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:num->real^N", ← q r"b:num->real^N"] THEN
      DISCH_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      GEN_REWRITE_TAC I [IMP_CONJ] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!x y. ~(P x) /\ ~(P y) /\ ~(f x = f y) ==> Q x y)
    ==> (!x y. P x ==> Q x y) /\ (!x y. P y ==> Q x y)
        ==> (!x y. ~(f x = f y) ==> Q x y)"))) THEN
      SIMP_TAC [INTERIOR_EMPTY, INTER_EMPTY] THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?d. COUNTABLE d /\
        (!k. k IN d ==> ?a b:real^N. k = interval(a,b)) /\
        s SUBSET UNIONS d /\
        measurable (UNIONS d) /\
        measure (UNIONS d) <= measure s + e")
      MP_TAC THENL
       [ALL_TAC,
        DISCH_THEN (X_CHOOSE_TAC (← q r"d:(real^N->bool)->bool")) THEN
        EXISTS_TAC (← q r"d DELETE ({}:real^N->bool)") THEN
        ASM_SIMP_TAC [lemma, COUNTABLE_DELETE, IN_DELETE]] THEN
      MP_TAC (← GEN (← q r"n:num") (← ISPECL [← q r"(a:num->real^N) n", ← q r"(b:num->real^N) n",
        ← q r"e / &2 pow (n + 2)"] EXPAND_CLOSED_OPEN_INTERVAL)) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2, SKOLEM_THM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"A:num->real^N", ← q r"B:num->real^N"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (\n. interval(A n:real^N,B n)) (:num)") THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, FORALL_IN_IMAGE, IN_UNIV] THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_UNIONS] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, IN_UNIV] THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN
        ASM_REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE, IN_UNIV] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN
      REWRITE_TAC [MEASURABLE_INTERVAL] THEN X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
       (← q r"sum(0..n) (\i. measure(interval[a i:real^N,b i]) + e / &2 pow (i + 2))") THEN
      ASM_SIMP_TAC [SUM_LE_NUMSEG] THEN REWRITE_TAC [SUM_ADD_NUMSEG] THEN
      REWRITE_TAC [real_div, REAL_INV_MUL, SUM_LMUL, REAL_POW_ADD, SUM_RMUL] THEN
      REWRITE_TAC [REAL_INV_POW, SUM_GP, LT] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"s <= m + e / &2 /\ &0 <= e * x
    ==> s + e * (&1 - x) / (&1 / &2) * &1 / &4 <= m + e")) THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_POW_LE, REAL_LT_IMP_LE,
                    REAL_LE_DIV, REAL_POS] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)) THEN
      W (MP_TAC o PART_MATCH (rhs o rand) MEASURE_NEGLIGIBLE_UNIONS_IMAGE o
            lhand o snd) THEN
      REWRITE_TAC [FINITE_NUMSEG, MEASURABLE_INTERVAL] THEN ANTS_TAC THENL
       [MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"interval[(a:num->real^N) i,b i] = interval[a j,b j]") THENL
         [UNDISCH_TAC
           (← q r"!m n. (d:num->real^N->bool) m = d n ==> m = n \/ d n = {}") THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"i:num", ← q r"j:num"]) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [INTER_EMPTY, NEGLIGIBLE_EMPTY],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE
           (BINDER_CONV o BINDER_CONV o RAND_CONV o LAND_CONV)
           [← GSYM INTERIOR_INTER]) THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"i:num", ← q r"j:num"]) THEN
          ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [← GSYM HAS_MEASURE_0, HAS_MEASURE_MEASURABLE_MEASURE] THEN
          SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL] THEN
          MATCH_MP_TAC (← MESON [MEASURE_EMPTY]
           (← q r"measure(interior s) = measure s
        ==> interior s = {} ==> measure s = &0")) THEN
          MATCH_MP_TAC MEASURE_INTERIOR THEN
          SIMP_TAC [BOUNDED_INTER, BOUNDED_INTERVAL, NEGLIGIBLE_CONVEX_FRONTIER,
                    CONVEX_INTER, CONVEX_INTERVAL]],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_UNIONS THEN
        SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, MEASURABLE_INTERVAL,
                  FINITE_NUMSEG],
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_UNIONS THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        ASM_REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN MESON_TAC []]))

  pure { MEASURABLE_OUTER_CLOSED_INTERVALS, MEASURABLE_OUTER_OPEN_INTERVALS }

/- ------------------------------------------------------------------------- -/
/- Open outer and compact inner approximation; inner divisions of open      -/
/- sets; measurable hulls of bounded sets.  (measure.ml 3787-3966)          -/
/- ------------------------------------------------------------------------- -/

structure MSO where
  MEASURABLE_OUTER_OPEN : thm
  MEASURABLE_INNER_COMPACT : thm
  OPEN_MEASURABLE_INNER_DIVISION : thm
  OUTER_MEASURE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSO [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSN : MSN) : ExceptT String IO MSO := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURE, MEASURABLE_INTER, MEASURABLE_INTERVAL, MEASURE_DISJOINT_UNION,
        MEASURE_DISJOINT_UNION_EQ, MEASURE_POS_LE, MEASURE_SUBSET, MEASURE_UNIQUE, .. } :=
        BMSA
  let { MEASURABLE_DIFF, MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS, .. } := BMSB
  let { HAS_MEASURE_LIMIT, MEASURE_LIMIT, .. } := BMSC
  let { MEASURABLE_COUNTABLE_INTERS, MEASURE_COUNTABLE_UNIONS_APPROACHABLE, .. } := BMSF
  let { MEASURABLE_OPEN, .. } := BMSG
  let { MEASURABLE_OUTER_OPEN_INTERVALS, .. } := BMSN
  let { FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, INF, INTER_COMM, INTER_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_DIFF, BOUNDED_SUBSET_BALL, CLOSED_INTERVAL, .. } :=
        D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := D.ig.dv.dg.pt.cvx.top2
  let { OPEN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTER, OPEN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, ..
        } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { SUBSET_UNIONS, .. } := D.ig.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { REAL_LE_TRANS_LTE, .. } := D.ig.dv.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, .. } :=
        D.ig.qtopology
  let { ELEMENTARY_UNIONS_INTERVALS, .. } := D.qintegration1
  let { division_of, .. } := D.qintegration3
  let { FORALL_POS_MONO_1, .. } := D.qmisc
  let { SUBSET_INTERS, .. } := D.qsession
  let { CLOSED_DIFF, .. } := D.qtopology1
  let { OPEN_UNIONS, .. } := D.qtopology2
  -- @@SCOPE END

  let MEASURABLE_OUTER_OPEN ← prove
   r"!s:real^N->bool e.
        measurable s /\ &0 < e
        ==> ?t. open t /\ s SUBSET t /\
                measurable t /\ measure t < measure s + e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"e / &2"]
      MEASURABLE_OUTER_OPEN_INTERVALS) THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:(real^N->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS d :real^N->bool") THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e /\ m <= s + e / &2 ==> m < s + e")] THEN
    MATCH_MP_TAC OPEN_UNIONS THEN ASM_MESON_TAC [OPEN_INTERVAL])

  let MEASURABLE_INNER_COMPACT ← prove
   r"!s:real^N->bool e.
        measurable s /\ &0 < e
        ==> ?t. compact t /\ t SUBSET s /\
                measurable t /\ measure s < measure t + e"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HAS_MEASURE_MEASURE]) THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_MEASURE_LIMIT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> &0 < e / &4")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MP_TAC (← ISPEC (← q r"ball(vec 0:real^N,B)") BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [BOUNDED_BALL, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL  [← q r"interval[a:real^N,b] DIFF s", ← q r"e/ &4"]
          MEASURABLE_OUTER_OPEN) THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTERVAL,
                  ← REAL_ARITH (← q r"&0 < e ==> &0 < e / &4")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"interval[a:real^N,b] DIFF t") THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN
      ASM_SIMP_TAC [CLOSED_DIFF, CLOSED_INTERVAL, BOUNDED_DIFF, BOUNDED_INTERVAL],
      ASM SET_TAC [],
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTERVAL],
      MATCH_MP_TAC (← REAL_ARITH
          (← q r"&0 < e /\
         measure(s) < measure(interval[a,b] INTER s) + e / &4 /\
         measure(t) < measure(interval[a,b] DIFF s) + e / &4 /\
         measure(interval[a,b] INTER s) +
         measure(interval[a,b] DIFF s) = measure(interval[a,b]) /\
         measure(interval[a,b] INTER t) +
         measure(interval[a,b] DIFF t) = measure(interval[a,b]) /\
         measure(interval[a,b] INTER t) <= measure t
         ==> measure s < measure(interval[a,b] DIFF t) + e")) THEN
      ASM_SIMP_TAC [MEASURE_SUBSET, INTER_SUBSET, MEASURABLE_INTER,
                    MEASURABLE_INTERVAL] THEN
      CONJ_TAC THENL
       [FIRST_ASSUM (SUBST_ALL_TAC o SYM o MATCH_MP MEASURE_UNIQUE) THEN
        ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REAL_ARITH_TAC,
        CONJ_TAC THEN MATCH_MP_TAC MEASURE_DISJOINT_UNION_EQ THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_DIFF, MEASURABLE_INTERVAL] THEN
        SET_TAC []]])

  let OPEN_MEASURABLE_INNER_DIVISION ← prove
   r"!s:real^N->bool e.
        open s /\ measurable s /\ &0 < e
        ==> ?D. D division_of UNIONS D /\
                UNIONS D SUBSET s /\
                measure s < measure(UNIONS D) + e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"e / &2"] MEASURE_LIMIT) THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"ball(vec 0:real^N,B)") BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    ASM_REWRITE_TAC [BOUNDED_BALL, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"s INTER interval(a - vec 1:real^N,b + vec 1)")
          OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) THEN
    ASM_SIMP_TAC [OPEN_INTER, OPEN_INTERVAL, SUBSET_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"D:(real^N->bool)->bool", ← q r"measure(s:real^N->bool)",
                      ← q r"e / &2"] MEASURE_COUNTABLE_UNIONS_APPROACHABLE) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [MEASURABLE_INTERVAL], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"measure(UNIONS D :real^N->bool)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC MEASURE_SUBSET THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC MEASURABLE_UNIONS THEN
          ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL],
          ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL],
          ASM_SIMP_TAC [SUBSET_UNIONS]],
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL, INTER_SUBSET]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"d:(real^N->bool)->bool") ELEMENTARY_UNIONS_INTERVALS) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [MEASURABLE_INTERVAL, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:(real^N->bool)->bool") THEN
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"UNIONS p :real^N->bool = UNIONS d") SUBST1_TAC THENL
       [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"UNIONS D :real^N->bool") THEN
        ASM_SIMP_TAC [SUBSET_UNIONS, INTER_SUBSET],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"ms' - e / &2 < mud ==> ms < ms' + e / &2 ==> ms < mud + e"))) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"abs(sc - s) < e / &2
        ==> sc <= so /\ sc <= s ==> s < so + e / &2"))) THEN
        CONJ_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL, INTER_SUBSET] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")) THEN
        REWRITE_TAC [SUBSET_INTERVAL, VECTOR_SUB_COMPONENT, VEC_COMPONENT,
                     VECTOR_ADD_COMPONENT] THEN
        MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
        MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN REAL_ARITH_TAC]])

  let OUTER_MEASURE ← prove
   r"!s:real^N->bool.
        bounded s
        ==> ?t. s SUBSET t /\ measurable t /\
                !t'. s SUBSET t' /\ measurable t' ==> negligible(t DIFF t')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC
     (← q r"IMAGE measure {u:real^N->bool | s SUBSET u /\ measurable u /\ open u}")
     INF) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_GSPEC] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      ASM_MESON_TAC [BOUNDED_SUBSET_BALL, OPEN_BALL, BOUNDED_BALL,
                     MEASURABLE_OPEN, MEASURE_POS_LE],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"b = inf(IMAGE measure { u:real^N->bool |
                            s SUBSET u /\ measurable u /\ open u})") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← GEN (← q r"n:num") (← SPEC (← q r"b + inv(&n + &1)") th)) THEN
            MP_TAC (← SPEC (← q r"&0") th))) THEN
    SIMP_TAC [MEASURE_POS_LE, MEASURABLE_OPEN] THEN DISCH_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"b + x <= b <=> ~(&0 < x)")] THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE] THEN
    REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:num->real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"INTERS {u n | n IN (:num)} : real^N->bool") THEN
    ASM_REWRITE_TAC [SUBSET_INTERS, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [MEASURABLE_COUNTABLE_INTERS, MEASURABLE_OPEN] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (funpowM 3 rand) MEASURABLE_MEASURE_POS_LT o snd) THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_COUNTABLE_INTERS,
                  MEASURABLE_OPEN] THEN
    MATCH_MP_TAC (← TAUT (← q r"~p ==> (p <=> ~q) ==> q")) THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"INTERS {u n | n IN (:num)} INTER t:real^N->bool",
      ← q r"measure(INTERS {u n | n IN (:num)} DIFF t:real^N->bool)"]
     MEASURABLE_OUTER_OPEN) THEN
    ASM_SIMP_TAC [MEASURABLE_COUNTABLE_INTERS, MEASURABLE_INTER] THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [REAL_NOT_LT] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
      MEASURE_DISJOINT_UNION o lhand o snd) THEN
    ASM_SIMP_TAC [MEASURABLE_COUNTABLE_INTERS, MEASURABLE_INTER, MEASURABLE_DIFF,
                  ← SET_RULE (← q r"DISJOINT (s INTER t) (s DIFF t)")] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← SET_RULE (← q r"(s INTER t) UNION (s DIFF t) = s")] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"b:real") THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x <= y <=> x - y <= &0")] THEN
      ONCE_REWRITE_TAC [REAL_LE_TRANS_LTE] THEN
      MATCH_MP_TAC FORALL_POS_MONO_1 THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, X_GEN_TAC (← q r"n:num")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x - y <= z <=> x <= y + z")] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"measure((u:num->real^N->bool) n)") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_COUNTABLE_INTERS] THEN SET_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []])

  pure { MEASURABLE_OUTER_OPEN, MEASURABLE_INNER_COMPACT, OPEN_MEASURABLE_INNER_DIVISION,
         OUTER_MEASURE }

/- ------------------------------------------------------------------------- -/
/- Transformation of measure by linear maps: it suffices to check the      -/
/- scaling on intervals.  (measure.ml 3965-4255)                            -/
/- ------------------------------------------------------------------------- -/

structure MSP where
  MEASURABLE_LINEAR_IMAGE_INTERVAL : thm
  HAS_MEASURE_LINEAR_SUFFICIENT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSP [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSJ : MSJ) (BMSM : MSM) : ExceptT String IO MSP := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_MEASURE, HAS_MEASURE_POS_LE,
        HAS_MEASURE_UNIQUE, measurable, MEASURABLE_INTER, MEASURABLE_INTERVAL,
        MEASURE_INTERVAL, MEASURE_SUBSET, MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_0, HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE, MEASURABLE_DIFF,
        MEASURE_DIFF_SUBSET, MEASURE_NEGLIGIBLE_UNIONS, .. } := BMSB
  let { HAS_MEASURE_INNER_OUTER_LE, HAS_MEASURE_LIMIT, .. } := BMSC
  let { HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED, .. } := BMSF
  let { MEASURABLE_CONVEX, NEGLIGIBLE_CONVEX_FRONTIER, NEGLIGIBLE_LINEAR_SINGULAR_IMAGE, ..
        } := BMSJ
  let { MEASURABLE_OUTER_INTERVALS_BOUNDED, .. } := BMSM
  let { EQ_IMP, EQ_TRANS, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_IMP,
        INTER_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_FORALL, REAL_ABS_MUL, REAL_ADD_LDISTRIB, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_LE_LADD, REAL_LE_LDIV_EQ, REAL_LE_LMUL,
        REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LZERO, REAL_MUL_SYM, REAL_SUB_LDISTRIB,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET, SUBSET_TRANS, .. }
        := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, real_div, SUM_EQ, SUM_LMUL, UNIONS_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { INTERVAL_NE_EMPTY, LIFT_CMUL, LIFT_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VEC_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_LINEAR_IMAGE, BOUNDED_SUBSET, BOUNDED_SUBSET_BALL, .. } :=
        D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_BALL_0, INTERIOR_CLOSED_INTERVAL, INTERIOR_INTER, LINEAR_CONTINUOUS_AT, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { frontier, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } :=
        D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_INTER, CONVEX_LINEAR_IMAGE, .. } := D.ig.dv.dg.pt.qcvx2
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { LINEAR_ID, .. } := D.ig.dv.dg.qvec
  let { INFINITE, REAL_LT_RMUL_EQ, .. } := D.ig.dv.qsession
  let { LINEAR_BOUNDED_POS, .. } := D.ig.dv.qvec
  let { COUNTABLE_AS_INJECTIVE_IMAGE, .. } := D.ig.qcard
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, INTERIOR_IMAGE_SUBSET, .. } := D.ig.qtopology
  let { CONTENT_EQ_0_INTERIOR, CONTENT_POS_LT, .. } := D.qintegration1
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_INTER, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION, .. } :=
        D.qintegration3
  let { REAL_NEG_GT0, .. } := D.qsession
  let { SERIES_CMUL, SERIES_UNIQUE, SUMS_EQ, .. } := D.qtopology2
  let { LINEAR_INJECTIVE_ISOMORPHISM, .. } := D.qvec
  -- @@SCOPE END

  let MEASURABLE_LINEAR_IMAGE_INTERVAL ← prove
   r"!f a b. linear f ==> measurable(IMAGE f (interval[a,b]))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_CONVEX THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONVEX_LINEAR_IMAGE THEN
      ASM_MESON_TAC [CONVEX_INTERVAL],
      MATCH_MP_TAC BOUNDED_LINEAR_IMAGE THEN
      ASM_MESON_TAC [BOUNDED_INTERVAL]])

  let HAS_MEASURE_LINEAR_SUFFICIENT ← prove
   r"!f:real^N->real^N m.
        linear f /\
        (!a b. IMAGE f (interval[a,b]) has_measure
               (m * measure(interval[a,b])))
        ==> !s. measurable s ==> (IMAGE f s) has_measure (m * measure s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"m < &0 \/ &0 <= m")) THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 0:real^N", ← q r"vec 1:real^N"]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_POS_LE) THEN
      MATCH_MP_TAC (← TAUT (← q r"~a ==> a ==> b")) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < --m * x ==> ~(&0 <= m * x)")) THEN
      MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [REAL_NEG_GT0] THEN
      REWRITE_TAC [MEASURE_INTERVAL] THEN MATCH_MP_TAC CONTENT_POS_LT THEN
      SIMP_TAC [VEC_COMPONENT, REAL_LT_01],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"!x y. (f:real^N->real^N) x = f y ==> x = y") THENL
     [ALL_TAC,
      SUBGOAL_THEN (← q r"!s. negligible(IMAGE (f:real^N->real^N) s)") ASSUME_TAC THENL
       [ASM_MESON_TAC [NEGLIGIBLE_LINEAR_SINGULAR_IMAGE], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"m * measure(interval[vec 0:real^N,vec 1]) = &0") MP_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"IMAGE (f:real^N->real^N) (interval[vec 0,vec 1])")
          HAS_MEASURE_UNIQUE) THEN
        ASM_REWRITE_TAC [HAS_MEASURE_0],
        REWRITE_TAC [REAL_ENTIRE, MEASURE_INTERVAL] THEN
        MATCH_MP_TAC (← TAUT (← q r"~b /\ (a ==> c) ==> a \/ b ==> c")) THEN CONJ_TAC THENL
         [SIMP_TAC [CONTENT_EQ_0_INTERIOR, INTERIOR_CLOSED_INTERVAL,
                    INTERVAL_NE_EMPTY, VEC_COMPONENT, REAL_LT_01],
          ASM_SIMP_TAC [REAL_MUL_LZERO, HAS_MEASURE_0]]]] THEN
    MP_TAC (← ISPEC (← q r"f:real^N->real^N") LINEAR_INJECTIVE_ISOMORPHISM) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->real^N") STRIP_ASSUME_TAC) THEN
    UNDISCH_THEN (← q r"!x y. (f:real^N->real^N) x = f y ==> x = y") (K ALL_TAC) THEN
    SUBGOAL_THEN
     (← q r"!s. bounded s /\ measurable s
        ==> (IMAGE (f:real^N->real^N) s) has_measure (m * measure s)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"!d. COUNTABLE d /\
          (!k. k IN d ==> k SUBSET interval[a,b] /\ ~(k = {}) /\
                          (?c d. k = interval[c,d])) /\
          (!k1 k2. k1 IN d /\ k2 IN d /\ ~(k1 = k2)
                   ==> interior k1 INTER interior k2 = {})
          ==> IMAGE (f:real^N->real^N) (UNIONS d) has_measure
                    (m * measure(UNIONS d))")
      ASSUME_TAC THENL
       [REWRITE_TAC [IMAGE_UNIONS] THEN REPEAT STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"!g:real^N->real^N.
          linear g
          ==> !k l. k IN d /\ l IN d /\ ~(k = l)
