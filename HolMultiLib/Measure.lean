        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [UNIONS_IMAGE, IN_UNIV, IN_ELIM_THM] THEN ASM SET_TAC []]])

  let VITALI_COVERING_LEMMA_CBALLS ← prove
   r"!s a:A->real^N r k B.
      s SUBSET UNIONS (IMAGE (\i. cball(a i,r i)) k) /\
      (!i. i IN k ==> &0 < r i /\ r i <= B)
      ==> ?c. COUNTABLE c /\
              c SUBSET k /\
              pairwise (\i j. DISJOINT (cball(a i,r i)) (cball(a j,r j))) c /\
              s SUBSET UNIONS (IMAGE (\i. cball(a i,&5 * r i)) c)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"a:A->real^N") o
       MATCH_MP VITALI_COVERING_LEMMA_CBALLS_BALLS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"UNIONS(IMAGE(\i. ball((a:A->real^N) i,&5 * r i)) c)") THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC UNIONS_MONO_IMAGE THEN
    REWRITE_TAC [BALL_SUBSET_CBALL])

  let VITALI_COVERING_LEMMA_BALLS ← prove
   r"!s a:A->real^N r k B.
      s SUBSET UNIONS (IMAGE (\i. ball(a i,r i)) k) /\
      (!i. i IN k ==> &0 < r i /\ r i <= B)
      ==> ?c. COUNTABLE c /\
              c SUBSET k /\
              pairwise (\i j. DISJOINT (ball(a i,r i)) (ball(a j,r j))) c /\
              s SUBSET UNIONS (IMAGE (\i. ball(a i,&5 * r i)) c)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"a:A->real^N") o
       MATCH_MP VITALI_COVERING_LEMMA_CBALLS_BALLS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          PAIRWISE_IMP)) THEN
      REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      ASM_MESON_TAC [BALL_SUBSET_CBALL, ← SET_RULE
       (← q r"s SUBSET s' /\ t SUBSET t' /\ DISJOINT s' t' ==> DISJOINT s t")],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"UNIONS(IMAGE(\i. cball((a:A->real^N) i,r i)) k)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC UNIONS_MONO_IMAGE THEN
      REWRITE_TAC [BALL_SUBSET_CBALL]])

  pure { PAIRWISE_DISJOINT_LEBESGUE_MEASURABLE_IMP_COUNTABLE,
         WIENER_COVERING_LEMMA_BALLS, WIENER_COVERING_LEMMA_CBALLS,
         VITALI_COVERING_LEMMA_CBALLS_BALLS, VITALI_COVERING_LEMMA_CBALLS,
         VITALI_COVERING_LEMMA_BALLS }
/- ------------------------------------------------------------------------- -/
/- Vitali covering theorems.  (measure.ml 13753-13956)                      -/
/- ------------------------------------------------------------------------- -/

structure MSBH where
  VITALI_COVERING_THEOREM_CBALLS : thm
  VITALI_COVERING_THEOREM_BALLS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBH [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSJ : MSJ) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBG : MSBG) : ExceptT String IO MSBH := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURABLE_UNION, MEASURE_DISJOINT_UNION, MEASURE_POS_LE,
        MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE, .. } := BMSB
  let { NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_APPROACHABLE, MEASURE_COUNTABLE_UNIONS_LE_GEN,
        NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { MEASURE_INTERIOR, .. } := BMSG
  let { MEASURABLE_BALL, MEASURABLE_CBALL, MEASURE_BALL_SCALING,
        NEGLIGIBLE_CONVEX_FRONTIER, NEGLIGIBLE_SPHERE, .. } := BMSJ
  let { LEBESGUE_MEASURABLE_CBALL, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { VITALI_COVERING_LEMMA_CBALLS_BALLS, .. } := BMSBG
  let { NEGLIGIBLE_ON_INTERVALS, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ,
        .. } := D.qintegration3
  let { SUM_IMAGE_LE, .. } := D.qsession
  let { COUNTABLE_SUBSET, .. } := D.ig.qcard
  let { BALL_UNION_SPHERE, .. } := D.ig.dv.dg.qtopology1
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_RAT_REDUCE_CONV,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { EXISTS_FINITE_SUBSET_IMAGE, .. } := D.ig.dv.dg.pt.qses
  let { CLOSED_UNIONS, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_CBALL, .. } := D.ig.dv.dg.pt.qcvx2
  let { CONJ_ASSOC, CONJ_SYM, EXISTS_IN_GSPEC, FINITE_IMAGE, FORALL_FINITE_SUBSET_IMAGE,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, MONO_AND, MONO_EXISTS, NOT_IN_EMPTY, PAIRWISE_IMP,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL, REAL_LE_RDIV_EQ, REAL_LE_TRANS, REAL_LT_DIV,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_POS, REAL_POW_LT, SIMPLE_IMAGE, SUBSET, SUBSET_RESTRICT,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, SUM_LE, SUM_LMUL, UNIONS_IMAGE, UNIONS_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EMPTY, BALL_SUBSET_CBALL, BOUNDED_CBALL, CLOSED_CBALL,
        .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, IN_CBALL, INTERIOR_CBALL, OPEN_CONTAINS_BALL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { closed, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let VITALI_COVERING_THEOREM_CBALLS ← prove
   r"!k a:A->real^N r s.
      (!i. i IN k ==> &0 < r i) /\
      (!x d. x IN s /\ &0 < d
             ==> ?i. i IN k /\ x IN cball(a i,r i) /\ r i < d)
      ==> ?c. COUNTABLE c /\ c SUBSET k /\
              pairwise (\i j. DISJOINT (cball(a i,r i)) (cball(a j,r j))) c /\
              negligible(s DIFF UNIONS {cball(a i,r i) | i IN c})"
   (SUBGOAL_THEN
     (← q r"!k a:A->real^N r s.
        (!i. i IN k ==> &0 < r i /\ r i <= &1) /\
        (!x d. x IN s /\ &0 < d
               ==> ?i. i IN k /\ x IN cball(a i,r i) /\ r i < d)
        ==> ?c. COUNTABLE c /\ c SUBSET k /\
                pairwise (\i j. DISJOINT (cball(a i,r i)) (cball(a j,r j))) c /\
                negligible(s DIFF UNIONS {cball(a i,r i) | i IN c})")
    MP_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"k' = {i | i IN k /\ (r:A->real) i <= &1}") THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"k':A->bool", ← q r"a:A->real^N", ← q r"r:A->real", ← q r"s:real^N->bool"]) THEN
      ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_MESON_TAC [← REAL_ARITH
       (← q r"&0 < d
        ==> &0 < min d (&1) /\ (x < min d (&1) ==> x < d /\ x <= &1)")]] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"a:A->real^N", ← q r"r:A->real", ← q r"k:A->bool", ← q r"&1"]
          VITALI_COVERING_LEMMA_CBALLS_BALLS) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real^N", ← q r"u:real^N"] THEN
    ONCE_REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN
    ABBREV_TAC
     (← q r"d = {i | i IN c /\
               ~DISJOINT (ball((a:A->real^N) i,&5 * r i)) (interval[l,u])}") THEN
    SUBGOAL_THEN (← q r"COUNTABLE(d:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        COUNTABLE_SUBSET)) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"measurable(UNIONS(IMAGE (\i. cball((a:A->real^N) i,r i)) d))")
    ASSUME_TAC THENL
     [MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"interval[l - vec 6:real^N,u + vec 6]") THEN
      REWRITE_TAC [MEASURABLE_INTERVAL] THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, FORALL_IN_IMAGE,
                    LEBESGUE_MEASURABLE_CBALL, COUNTABLE_IMAGE] THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      EXPAND_TAC "d" THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"i:A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      SIMP_TAC [SUBSET, ← SET_RULE (← q r"~DISJOINT s t <=> ?x. x IN s /\ x IN t")] THEN
      REWRITE_TAC [IN_CBALL, IN_BALL, IN_INTERVAL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
      ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
      REWRITE_TAC [VEC_COMPONENT] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(y - x) <= &6 * &1
        ==> l <= x /\ x <= u ==> l - &6 <= y /\ y <= u + &6")) THEN
      REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
      W (MP_TAC o PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"&6 * (r:A->real) i") THEN
      CONJ_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [dist])) THEN
        CONV_TAC (fun t => NORM_ARITH t),
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
        ASM SET_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"IMAGE (\i. cball((a:A->real^N) i,r i)) d",
      ← q r"measure(UNIONS(IMAGE (\i. cball((a:A->real^N) i,r i)) d))",
      ← q r"e / &5 pow (dimindex(:N))"]
     MEASURE_COUNTABLE_UNIONS_APPROACHABLE) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, MEASURABLE_CBALL] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, ← REAL_ARITH (← q r"&0 < &5"), CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ FINITE s <=> FINITE s /\ p")] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, FORALL_FINITE_SUBSET_IMAGE] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, MEASURABLE_CBALL,
                    FINITE_IMAGE] THEN
      ASM SET_TAC [],
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"UNIONS(IMAGE (\i. ball((a:A->real^N) i,&5 * r i)) (d DIFF d1))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_DIFF, IN_INTER] THEN
      X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"(:real^N) DIFF UNIONS (IMAGE (\i:A. cball(a i,r i)) d1)")
            OPEN_CONTAINS_BALL) THEN
      ASM_SIMP_TAC [← GSYM closed, CLOSED_UNIONS, CLOSED_CBALL,
                    FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> DISJOINT s t")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"q / &2"]) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"i:A") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:A") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"j:A") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"DISJOINT s (UNIONS (IMAGE f k))
        ==> (?x. x IN s /\ x IN f i) ==> ~(i IN k)"))) THEN
      REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP
       (← SET_RULE (← q r"~DISJOINT s t ==> ?x. x IN s /\ x IN t"))) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_CBALL]) THEN
      REWRITE_TAC [IN_CBALL, IN_BALL] THEN
      UNDISCH_TAC (← q r"(r:A->real) i < q / &2") THEN CONV_TAC (fun t => NORM_ARITH t),
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_GEN THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_IMAGE THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           COUNTABLE_SUBSET)) THEN
        SET_TAC [],
        REWRITE_TAC [FORALL_IN_IMAGE, MEASURABLE_BALL],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"d2:A->bool") THEN STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE_LE o lhand o snd) THEN
      ASM_SIMP_TAC [MEASURABLE_BALL, MEASURE_POS_LE] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      REWRITE_TAC [o_DEF] THEN TRANS_TAC REAL_LE_TRANS
        (← q r"sum d2 (\i. &5 pow dimindex(:N) *
                     measure(ball((a:A->real^N) i,r i)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        MATCH_MP_TAC MEASURE_BALL_SCALING THEN CONV_TAC REAL_RAT_REDUCE_CONV,
        REWRITE_TAC [SUM_LMUL] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM]] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_POW_LT, ← REAL_ARITH (← q r"&0 < &5")] THEN
      REWRITE_TAC [← GSYM INTERIOR_CBALL] THEN
      SIMP_TAC [MEASURE_INTERIOR, BOUNDED_CBALL, NEGLIGIBLE_CONVEX_FRONTIER,
                CONVEX_CBALL] THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
          lhand o snd) THEN
      ASM_REWRITE_TAC [MEASURABLE_CBALL] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"n - e < m ==> m + p <= n ==> p <= e"))) THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        MEASURE_DISJOINT_UNION o lhand o snd) THEN
      ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, MEASURABLE_CBALL,
                    FINITE_IMAGE] THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_UNIONS, FORALL_IN_IMAGE,
                    MEASURABLE_CBALL, FINITE_IMAGE] THEN
      ASM SET_TAC []])

  let VITALI_COVERING_THEOREM_BALLS ← prove
   r"!k a:A->real^N r s.
      (!x d. x IN s /\ &0 < d
             ==> ?i. i IN k /\ x IN ball(a i,r i) /\ r i < d)
      ==> ?c. COUNTABLE c /\ c SUBSET k /\
              pairwise (\i j. DISJOINT (ball(a i,r i)) (ball(a j,r j))) c /\
              negligible(s DIFF UNIONS {ball(a i,r i) | i IN c})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{i | i IN k /\ &0 < (r:A->real) i}",
      ← q r"a:A->real^N", ← q r"r:A->real", ← q r"s:real^N->bool"]
     VITALI_COVERING_THEOREM_CBALLS) THEN
    SIMP_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"d:real"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"i:A") THEN ASM_CASES_TAC (← q r"(r:A->real) i <= &0") THEN
      ASM_SIMP_TAC [BALL_EMPTY, NOT_IN_EMPTY] THEN
      SIMP_TAC [← REWRITE_RULE [SUBSET] BALL_SUBSET_CBALL] THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
       [ASM SET_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          PAIRWISE_IMP)) THEN
        REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        ASM_MESON_TAC [BALL_SUBSET_CBALL, ← SET_RULE
         (← q r"s SUBSET s' /\ t SUBSET t' /\ DISJOINT s' t' ==> DISJOINT s t")],
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"s DIFF UNIONS {cball((a:A->real^N) i,r i) | i IN c} UNION
                    UNIONS {sphere(a i,r i) | i IN c}") THEN
        ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
        REWRITE_TAC [← GSYM BALL_UNION_SPHERE, SIMPLE_IMAGE] THEN CONJ_TAC THENL
         [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
          ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, NEGLIGIBLE_SPHERE],
          REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC []]]])

  pure { VITALI_COVERING_THEOREM_CBALLS, VITALI_COVERING_THEOREM_BALLS }
/- ------------------------------------------------------------------------- -/
/- Negligibility is a local property, equivalent to localized zero density. -/
/- (measure.ml 13957-14169)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBI where
  LOCALLY_NEGLIGIBLE_ALT : thm
  LOCALLY_NEGLIGIBLE : thm
  LOCALLY_LEBESGUE_MEASURABLE_ALT : thm
  LOCALLY_LEBESGUE_MEASURABLE : thm
  NEGLIGIBLE_EQ_ZERO_DENSITY_ALT : thm
  NEGLIGIBLE_EQ_ZERO_DENSITY : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBI [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSJ : MSJ) (BMSAM : MSAM) (BMSBH : MSBH) : ExceptT String IO MSBI := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_NEGLIGIBLE_SYMDIFF, MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE,
        MEASURE_EQ_0, MEASURE_NEGLIGIBLE_SYMDIFF, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURE_UNIONS_LE_IMAGE, NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, NEGLIGIBLE_COUNTABLE_UNIONS_GEN,
        .. } := BMSF
  let { MEASURABLE_BALL, MEASURE_BALL_POS, .. } := BMSJ
  let { LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, LEBESGUE_MEASURABLE_INTER,
        LEBESGUE_MEASURABLE_OPEN_IN, .. } := BMSAM
  let { VITALI_COVERING_THEOREM_BALLS, .. } := BMSBH
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.qcard
  let { LINDELOF_OPEN_IN, locally, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { SUBSET_BALL, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_SYM, EXISTS_IN_GSPEC, FINITE_IMAGE, FORALL_FINITE_SUBSET_IMAGE,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INTER, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS,
        MONO_FORALL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_MIN, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_MIN, REAL_LT_MUL, REAL_LTE_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { pairwise, SUM_LE, SUM_LMUL, UNIONS_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.met
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { open_in, OPEN_IN_OPEN_INTER, OPEN_IN_REFL, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LOCALLY_NEGLIGIBLE_ALT ← prove
   r"!s:real^N->bool.
    negligible s <=>
    !x. x IN s
        ==> ?u. open_in (subtopology euclidean s) u /\ x IN u /\ negligible u"
   (GEN_TAC THEN EQ_TAC THENL [MESON_TAC [OPEN_IN_REFL], ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^N->real^N->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE (u:real^N->real^N->bool) s)") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MP_TAC (← ISPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]
      LINDELOF_OPEN_IN) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let LOCALLY_NEGLIGIBLE ← prove
   r"!s:real^N->bool. locally negligible s <=> negligible s"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [LOCALLY_NEGLIGIBLE_ALT] THEN
      MESON_TAC [OPEN_IN_REFL, SUBSET_REFL, NEGLIGIBLE_SUBSET],
      DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
      STRIP_TAC THEN REPEAT (EXISTS_TAC (← q r"w INTER s:real^N->bool")) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL, INTER_SUBSET, SUBSET_REFL] THEN
      ASM_MESON_TAC [SUBSET, IN_INTER, OPEN_IN_IMP_SUBSET, NEGLIGIBLE_SUBSET]])

  let LOCALLY_LEBESGUE_MEASURABLE_ALT ← prove
   r"!s:real^N->bool.
    lebesgue_measurable s <=>
    !x. x IN s
        ==> ?u. open_in (subtopology euclidean s) u /\
                x IN u /\ lebesgue_measurable u"
   (GEN_TAC THEN EQ_TAC THENL [MESON_TAC [OPEN_IN_REFL], ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^N->real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s = UNIONS (IMAGE (u:real^N->real^N->bool) s)") SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [open_in]) THEN ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"IMAGE (u:real^N->real^N->bool) s", ← q r"s:real^N->bool"]
      LINDELOF_OPEN_IN) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let LOCALLY_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. locally lebesgue_measurable s <=> lebesgue_measurable s"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THENL
     [DISCH_TAC THEN ONCE_REWRITE_TAC [LOCALLY_LEBESGUE_MEASURABLE_ALT] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"x:real^N"]) THEN
      ASM_REWRITE_TAC [OPEN_IN_REFL] THEN
      ASM_MESON_TAC [LEBESGUE_MEASURABLE_OPEN_IN, OPEN_IN_SUBSET_TRANS],
      DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
      STRIP_TAC THEN REPEAT (EXISTS_TAC (← q r"w INTER s:real^N->bool")) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL, INTER_SUBSET, SUBSET_REFL] THEN
      ASM_MESON_TAC [SUBSET, IN_INTER, OPEN_IN_IMP_SUBSET,
                     LEBESGUE_MEASURABLE_OPEN_IN, LEBESGUE_MEASURABLE_INTER]])

  let NEGLIGIBLE_EQ_ZERO_DENSITY_ALT ← prove
   r"!s:real^N->bool.
        negligible s <=>
        !x e. x IN s /\ &0 < e
              ==> ?d u. &0 < d /\ d <= e /\
                        s INTER ball(x,d) SUBSET u /\
                        measurable u /\ measure u < e * measure(ball(x,d))"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"e:real") THEN
      EXISTS_TAC (← q r"s INTER ball(x:real^N,e)") THEN
      ASM_SIMP_TAC [SUBSET_REFL, MEASURABLE_INTER, MEASURABLE_BALL,
                    NEGLIGIBLE_IMP_MEASURABLE, REAL_LE_REFL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 /\ &0 < y ==> x < y")) THEN
      ASM_SIMP_TAC [MEASURE_BALL_POS, REAL_LT_MUL] THEN
      ASM_MESON_TAC [MEASURE_EQ_0, NEGLIGIBLE_SUBSET, INTER_SUBSET],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [LOCALLY_NEGLIGIBLE_ALT] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"s INTER ball(z:real^N,&1)") THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, IN_INTER] THEN
    REWRITE_TAC [CENTRE_IN_BALL, REAL_LT_01] THEN
    REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{(x:real^N,d) | x IN s /\ &0 < d /\ ball(x,d) SUBSET ball(z,&1) /\
                       ?u. s INTER ball(x,d) SUBSET u /\
                           measurable u /\
                           measure u < e / measure(ball(z:real^N,&1)) *
                                       measure(ball(x,d))}",
      ← q r"FST:real^N#real->real^N", ← q r"SND:real^N#real->real",
      ← q r"s INTER ball(z:real^N,&1)"]
     VITALI_COVERING_THEOREM_BALLS) THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real"] THEN
      REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN EXISTS_TAC (← q r"x:real^N") THEN
      MP_TAC (← ISPEC (← q r"ball(z:real^N,&1)") OPEN_CONTAINS_BALL) THEN
      REWRITE_TAC [OPEN_BALL] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"x:real^N", ← q r"min (e / measure(ball(z:real^N,&1)) / &2)
                         (min (d / &2) k)"]) THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_HALF, REAL_LT_DIV,
                    MEASURE_BALL_POS, REAL_LT_01] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN REPEAT CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"ball(x:real^N,k)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_BALL THEN
        ASM_REAL_ARITH_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] REAL_LTE_TRANS)) THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN
        SIMP_TAC [MEASURE_POS_LE, MEASURABLE_BALL] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> min (x / &2) y <= x")) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, MEASURE_BALL_POS, REAL_LT_01],
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    REWRITE_TAC [SIMPLE_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N#real->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!p. p IN c ==> ?u. s INTER ball p SUBSET u /\
                         measurable(u:real^N->bool) /\
                         measure u < e / measure (ball(z:real^N,&1)) *
                                     measure(ball p)")
    MP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN MESON_TAC [],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^N#real->real^N->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"((s INTER ball(z:real^N,&1)) DIFF UNIONS (IMAGE ball c)) UNION
                UNIONS(IMAGE u c)") THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"measurable(UNIONS(IMAGE (u:real^N#real->real^N->bool) c)) /\
      measure(UNIONS(IMAGE u c)) <= e")
    MP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] MEASURABLE_NEGLIGIBLE_SYMDIFF),
        MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= e ==> y <= e")) THEN
        MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF] THEN
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN SET_TAC []] THEN
    MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"d:real^N#real->bool") THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      MEASURE_UNIONS_LE_IMAGE o lhand o snd) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum d (\p:real^N#real.
                  e / measure(ball(z:real^N,&1)) * measure(ball p))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUM_LMUL] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a / b * c:real = (a * c) / b")] THEN
    SIMP_TAC [REAL_LE_LDIV_EQ, MEASURE_BALL_POS, REAL_LT_01] THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"measure(UNIONS (IMAGE ball d):real^N->bool)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC MEASURE_DISJOINT_UNIONS_IMAGE THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_PAIR_THM, MEASURABLE_BALL], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
      MATCH_MP_TAC MEASURE_SUBSET THEN
      REWRITE_TAC [MEASURABLE_BALL, UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC MEASURABLE_UNIONS THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM,
                    MEASURABLE_BALL, FINITE_IMAGE]])

  let NEGLIGIBLE_EQ_ZERO_DENSITY ← prove
   r"!s:real^N->bool.
        negligible s <=>
        !x r e. x IN s /\ &0 < e /\ &0 < r
                ==> ?d u. &0 < d /\ d <= r /\
                          s INTER ball(x,d) SUBSET u /\
                          measurable u /\ measure u < e * measure(ball(x,d))"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [NEGLIGIBLE_EQ_ZERO_DENSITY_ALT] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"r:real", ← q r"e:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min r e:real")) THEN
      ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LE_MIN] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] REAL_LTE_TRANS)) THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, MEASURE_BALL_POS] THEN REAL_ARITH_TAC,
      X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"e:real", ← q r"e:real"]) THEN
      ASM_MESON_TAC []])

  pure { LOCALLY_NEGLIGIBLE_ALT, LOCALLY_NEGLIGIBLE, LOCALLY_LEBESGUE_MEASURABLE_ALT,
         LOCALLY_LEBESGUE_MEASURABLE, NEGLIGIBLE_EQ_ZERO_DENSITY_ALT,
         NEGLIGIBLE_EQ_ZERO_DENSITY }

/- ------------------------------------------------------------------------- -/
/- A handy measurability lemma; Borel measurability of the set of points   -/
/- of differentiability.  (measure.ml 14170-14504)                          -/
/- ------------------------------------------------------------------------- -/

structure MSBJ where
  LEBESGUE_MEASURABLE_POINTS_OF_CONVERGENCE : thm
  BOREL_POINTS_OF_DIFFERENTIABILITY : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBJ [HolBase] (D : MeasureDeps) (BMSAM : MSAM) : ExceptT String IO MSBJ := do
  -- @@SCOPE BEGIN
  let { LEBESGUE_MEASURABLE_CLOSED_IN, LEBESGUE_MEASURABLE_COUNTABLE_INTERS,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, .. } := BMSAM
  let { DIFFERENTIABLE_IMP_CONTINUOUS_AT, HAS_DERIVATIVE_AT_ALT, .. } := D.qderivatives
  let { COUNTABLE_CART, COUNTABLE_RESTRICT, NUM_COUNTABLE, .. } := D.qcard
  let { RATIONAL_BETWEEN, .. } := D.qfloor
  let { CLOSED_IN_INTERS, EVENTUALLY_FORALL, .. } := D.qmetric
  let { FORALL_POS_MONO_1_EQ, .. } := D.qmisc
  let { DIMINDEX_NONZERO, .. } := D.qsession
  let { BOREL_INTER, BOREL_INTERS, BOREL_UNIONS, CLOSED_IN_BOREL, CONVERGENT_EQ_CAUCHY_AT,
        .. } := D.qtopology1
  let { GDELTA_IMP_BOREL, GDELTA_POINTS_OF_CONTINUITY, .. } := D.qtopology2
  let { MATRIX_RATIONAL_APPROXIMATION, MATRIX_SUB_COMPONENT, MATRIX_VECTOR_MUL_BASIS,
        MATRIX_VECTOR_MUL_SUB_LDISTRIB, MATRIX_VECTOR_MUL_SUB_RDISTRIB,
        ONORM_LE_MATRIX_COMPONENT, .. } := D.qvec
  let { differentiable, .. } := D.ig.qderivatives
  let { COUNTABLE_RATIONAL, .. } := D.ig.qmisc
  let { CONVERGENT_EQ_CAUCHY, .. } := D.ig.dv.qtopology1
  let { cauchy, .. } := D.ig.dv.qtopology2
  let { LINEAR_COMPOSE_SUB, ONORM, .. } := D.ig.dv.qvec
  let { CLOSED_IN_INTER, CLOSED_IN_UNION, .. } := D.ig.dv.dg.qmetric
  let { REAL_LT_INV2, REAL_LT_TRANS, .. } := D.ig.dv.dg.qsession
  let { CLOSED_INSERT, CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_ON_CMUL,
        .. } := D.ig.dv.dg.qtopology1
  let { OPEN_CLOSED, tendsto, .. } := D.ig.dv.dg.qtopology2
  let { MATRIX_VECTOR_MUL_RMUL, .. } := D.ig.dv.dg.qvec
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CLOSED_IN_REFL, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_GE_1, EXTENSION, FINITE_NUMSEG, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, GE, IMP_CONJ_ALT, IMP_IMP, INTER, INTER_UNIV, INTERS_0,
        INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE_1, LE_ADD,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_LT,
        NUMSEG_EMPTY, REAL_ARCH_INV, REAL_DIV_LMUL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_LMUL_EQ, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_MIN,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_SUB_LE, REAL_SUB_RDISTRIB, RIGHT_AND_EXISTS_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_ge, SWAP_EXISTS_THM, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { LAMBDA_SKOLEM, REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_NZ, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { EXISTS_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_SUB, MATRIX_VECTOR_MUL_LINEAR,
        MATRIX_WORKS, NORM_BASIS, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { column, dist, drop, VECTOR_ADD_SUB, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_CBALL, CLOSED_HALFSPACE_COMPONENT_GE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top2
