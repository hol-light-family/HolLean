  let { LEBESGUE_MEASURABLE_MEASURABLE_INTER_EQ,
        MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE, OUTER_MEASURE_GEN, .. } := BMSAS
  let { LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_BOREL,
        MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL_EQ, .. } := BMSAW
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { COUNTABLE_LIST, NUM_COUNTABLE, .. } := D.qcard
  let { suslin, SUSLIN_MONO, suslin_operation, SUSLIN_SUPERSET, .. } := D.qmisc
  let { INTERS_SUBSET_STRONG, LE_SUC_LT, .. } := D.qsession
  let { BOREL_IMP_ANALYTIC, COMPACT_IMP_BOREL, .. } := D.qtopology1
  let { analytic, .. } := D.qtopology2
  let { APPEND_NIL, BUTLAST, BUTLAST_APPEND, EL_APPEND, EL_LIST_OF_SEQ, LAST, LAST_APPEND,
