  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, SUBSET_UNIV, UNIONS_GSPEC, UNIONS_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  -- @@SCOPE END

  let SUSLIN_LEBESGUE_MEASURABLE ← (do
    let lemma ← prove
     r"!l m a b:A. APPEND l [a] = APPEND m [b] <=> l = m /\ a = b"
     (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN
      DISCH_THEN (fun th => tactic_of do
       pure (MP_TAC (← AP_TERM (← q r"BUTLAST:A list->A list") th) THEN
       MP_TAC (← AP_TERM (← q r"LAST:A list->A") th))) THEN
      REWRITE_TAC [LAST_APPEND, BUTLAST_APPEND, NOT_CONS_NIL] THEN
      SIMP_TAC [LAST, BUTLAST, APPEND_NIL])
    prove
     r"suslin lebesgue_measurable:(real^N->bool)->bool = lebesgue_measurable"
     (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUSLIN_SUPERSET] THEN
      REWRITE_TAC [SUBSET, suslin, FORALL_IN_GSPEC] THEN REWRITE_TAC [IN] THEN
      SUBGOAL_THEN
       (← q r"!e. (!l:num list. lebesgue_measurable(e l)) /\ e [] = (:real^N)
        ==> lebesgue_measurable(suslin_operation e)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"e:num list->real^N->bool") THEN STRIP_TAC,
        DISCH_TAC THEN X_GEN_TAC (← q r"e:num list->real^N->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"\l:num list. if l = [] then (:real^N) else e l")) THEN
        REWRITE_TAC [] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [LEBESGUE_MEASURABLE_UNIV], ALL_TAC] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SIMP_TAC [suslin_operation] THEN
        REPEAT (AP_TERM_TAC THEN
               MATCH_MP_TAC (← SET_RULE
                (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
               REPEAT STRIP_TAC) THEN
        ASM_SIMP_TAC [LIST_OF_SEQ_EQ_NIL, LE_1]] THEN
      ONCE_REWRITE_TAC [LEBESGUE_MEASURABLE_MEASURABLE_INTER_EQ] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
      ABBREV_TAC
       (← q r"f = \l. UNIONS { INTERS { (e:num list->real^N->bool)(list_of_seq s n) |
                              1 <= n} |
                     list_of_seq s (LENGTH l) = l}") THEN
      SUBGOAL_THEN
       (← q r"!l. (f:num list->real^N->bool) l SUBSET e l")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"l:num list") THEN ASM_CASES_TAC (← q r"l:num list = []") THEN
        ASM_REWRITE_TAC [SUBSET_UNIV] THEN EXPAND_TAC "f" THEN
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"s:num->num") THEN DISCH_TAC THEN
        MATCH_MP_TAC INTERS_SUBSET_STRONG THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
        EXISTS_TAC (← q r"LENGTH(l:num list)") THEN
        ASM_SIMP_TAC [LE_1, LENGTH_EQ_NIL, SUBSET_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!l. ?u. f l INTER t SUBSET u /\ u SUBSET e l /\ u SUBSET t /\
            measurable u /\
            !v. (f:num list->real^N->bool) l INTER t SUBSET v /\
                lebesgue_measurable v
                ==> negligible(u DIFF v)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"l:num list") THEN
        MP_TAC (← ISPECL [← q r"(f:num list->real^N->bool) l INTER t", ← q r"t:real^N->bool"]
          OUTER_MEASURE_GEN) THEN
        ASM_REWRITE_TAC [INTER_SUBSET] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"u INTER t INTER e(l:num list):real^N->bool") THEN
        ASM_SIMP_TAC [MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE,
                      MEASURABLE_INTER] THEN
        REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
        X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN SET_TAC [],
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
      X_GEN_TAC (← q r"g:num list->real^N->bool") THEN STRIP_TAC THEN
      ABBREV_TAC
      (← q r"h = \l. (g l:real^N->bool) DIFF UNIONS {g(APPEND l [i]) | i IN (:num)}") THEN
      SUBGOAL_THEN
       (← q r"!l. negligible((h:num list->real^N->bool) l)")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"l:num list") THEN EXPAND_TAC "h" THEN REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
                      FORALL_IN_GSPEC, MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
        SUBGOAL_THEN
         (← q r"f l:real^N->bool = UNIONS {f (APPEND l [i]) | i IN (:num)}")
        SUBST1_TAC THENL
         [EXPAND_TAC "f" THEN
          REWRITE_TAC [LENGTH_APPEND, LENGTH, ADD_CLAUSES] THEN
          REWRITE_TAC [list_of_seq, lemma] THEN
          REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC] THEN SET_TAC [],
          REWRITE_TAC [INTER_UNIONS] THEN
          REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
          MATCH_MP_TAC UNIONS_MONO_IMAGE THEN
          ASM_REWRITE_TAC [o_THM, IN_UNIV]],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"H:real^N->bool = UNIONS {h l | l IN (:num list)}") THEN
      SUBGOAL_THEN (← q r"negligible(H:real^N->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "H" THEN MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
        SIMP_TAC [COUNTABLE_LIST, NUM_COUNTABLE, COUNTABLE_IMAGE],
        ALL_TAC] THEN
      MATCH_MP_TAC MEASURABLE_NEGLIGIBLE_SYMDIFF THEN
      EXISTS_TAC (← q r"(g:num list->real^N->bool) []") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"H:real^N->bool") THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"e SUBSET g /\ g DIFF h SUBSET e
    ==> (g DIFF e) UNION (e DIFF g) SUBSET h")) THEN
      CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"(f:num list->real^N->bool) [] INTER t") THEN
        ASM_REWRITE_TAC [] THEN EXPAND_TAC "f" THEN
        REWRITE_TAC [suslin_operation, LENGTH, LIST_OF_SEQ_EQ_NIL, IN_UNIV] THEN
        REWRITE_TAC [SUBSET_REFL],
        ALL_TAC] THEN
      EXPAND_TAC "H" THEN REWRITE_TAC [SUBSET, IN_DIFF, UNIONS_GSPEC, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM, NOT_EXISTS_THM] THEN
      STRIP_TAC THEN
      REWRITE_TAC [suslin_operation, IN_INTER, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      SUBGOAL_THEN
       (← q r"?l:num->num list.
        (!n. LENGTH(l n) = n /\ (x:real^N) IN g(l n)) /\
        (!n m. m < n ==> EL m (l(SUC n)) = EL m (l n))")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC DEPENDENT_CHOICE THEN
        CONJ_TAC THENL [ASM_MESON_TAC [LENGTH], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"l:num list"] THEN STRIP_TAC THEN
        MATCH_MP_TAC (← MESON [] (← q r"(?t h. P(APPEND t [h])) ==> (?l. P l)")) THEN
        EXISTS_TAC (← q r"l:num list") THEN
        ASM_SIMP_TAC [LENGTH, LENGTH_APPEND, EL_APPEND, ADD_CLAUSES] THEN
        SUBGOAL_THEN (← q r"~(x IN (h:num list->real^N->bool) l)") MP_TAC THENL
         [ASM_REWRITE_TAC [], EXPAND_TAC "h" THEN REWRITE_TAC [UNIONS_GSPEC]] THEN
        ASM SET_TAC [],
        EXISTS_TAC (← q r"(\n. EL n (l(SUC n))):num->num") THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"list_of_seq (\n. EL n (l (SUC n))) n :num list = l n")
        SUBST1_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        ASM_SIMP_TAC [LIST_EQ, LENGTH_LIST_OF_SEQ, EL_LIST_OF_SEQ] THEN
        X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [← GSYM LE_SUC_LT] THEN
        SIMP_TAC [LE_EXISTS, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"d:num") THEN DISCH_THEN (K ALL_TAC) THEN
        SPEC_TAC (← q r"d:num", ← q r"d:num") THEN INDUCT_TAC THEN
        ASM_SIMP_TAC [ADD_CLAUSES, ← ARITH_RULE (← q r"m < SUC(m + d)")]]))

  let ANALYTIC_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. analytic s ==> lebesgue_measurable s"
   (ONCE_REWRITE_TAC [← GSYM SUSLIN_LEBESGUE_MEASURABLE] THEN
    REWRITE_TAC [analytic] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUSLIN_MONO) THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPACT])

  let LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC ← prove
   r"!f:real^M->real^N s t.
        f measurable_on s /\ lebesgue_measurable s /\ analytic t
        ==> lebesgue_measurable {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM SUSLIN_LEBESGUE_MEASURABLE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [analytic]) THEN
    REWRITE_TAC [suslin, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:num list->real^N->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
    EXISTS_TAC (← q r"\l:num list. {x | x IN s /\ (f:real^M->real^N) x IN g l}") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"l:num list") THEN DISCH_TAC THEN ONCE_REWRITE_TAC [IN] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_BOREL THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOREL],
      REWRITE_TAC [suslin_operation, UNIONS_GSPEC, INTERS_GSPEC] THEN
      MP_TAC LE_REFL THEN SET_TAC []])

  let LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC ← prove
   r"!f:real^M->real^N t.
        f measurable_on (:real^M) /\ analytic t
        ==> lebesgue_measurable {x | f x IN t}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | P x} = {x | x IN UNIV /\ P x}")] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC THEN
    ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV])

  let MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC_EQ ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\ lebesgue_measurable s <=>
        !t. analytic t ==> lebesgue_measurable {x | x IN s /\ f x IN t}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC] THEN
    REWRITE_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL_EQ] THEN
    SIMP_TAC [BOREL_IMP_ANALYTIC])

  let MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s
        ==> (f measurable_on s <=>
             !t. analytic t ==> lebesgue_measurable {x | x IN s /\ f x IN t})"
   (SIMP_TAC [← GSYM MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC_EQ])

  let MEASURABLE_ON_PREIMAGE_ANALYTIC ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !t. analytic t ==> lebesgue_measurable {x | f x IN t}"
   (SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC,
              LEBESGUE_MEASURABLE_UNIV, IN_UNIV])

  pure { SUSLIN_LEBESGUE_MEASURABLE, ANALYTIC_IMP_LEBESGUE_MEASURABLE,
         LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC,
         LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC,
         MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC_EQ,
         MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC,
         MEASURABLE_ON_PREIMAGE_ANALYTIC }

/- ------------------------------------------------------------------------- -/
/- Some additional lemmas about measurability and absolute integrals.      -/
/- (measure.ml 11838-12021)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAY where
  MEASURABLE_ON_LIFT_INV : thm
  MEASURABLE_ON_LIFT_DIV : thm
  ABSOLUTELY_INTEGRABLE_UNION : thm
  ABSOLUTELY_INTEGRABLE_DIFF : thm
  ABSOLUTELY_INTEGRABLE_INTER : thm
  INTEGRAL_COUNTABLE_UNIONS_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAY [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAP : MSAP) (BMSAW : MSAW) : ExceptT String IO MSAY := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_IMP_MEASURABLE, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_LIFT_MUL, MEASURABLE_ON_SPIKE_SET, .. } := BMSAE
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET, LEBESGUE_MEASURABLE_INTER,
        LEBESGUE_MEASURABLE_UNIONS, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_OPEN, .. } := BMSAP
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN, .. } := BMSAW
  let { ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_INTEGRABLE_SUB,
        DOMINATED_CONVERGENCE, .. } := D.qintegration1
  let { INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration2
  let { INTEGRAL_RESTRICT_UNIV, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { OPEN_IN_OPEN_TRANS, .. } := D.qtopology2
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { REAL_INV_INV, .. } := D.ig.dv.qsession
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { LE_0, .. } := D.ig.dv.dg.qsession
  let { OPEN_DELETE, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.ig.dv.dg.pt.cvx
  let { COND_RAND, COND_RATOR, CONJ_SYM, EQ_IMP, EXISTS_IN_GSPEC, EXTENSION, FINITE_IMAGE,
        FINITE_NUMSEG, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DELETE, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV,
        MONO_EXISTS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_EQ_0, REAL_LE_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SIMPLE_IMAGE, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, EXISTS_LIFT, FORALL_LIFT, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_0,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, .. } := D.ig.dv.dg.pt.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_IMP_OPEN_MAP, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_SUBSET, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let MEASURABLE_ON_LIFT_INV ← (do
    let lemma ← prove
     r"!f:real^N->real s.
          (\x. lift(f x)) measurable_on s /\
          (!x. x IN s ==> ~(f x = &0))
          ==> (\x. lift(inv(f x))) measurable_on s"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"lebesgue_measurable(s:real^N->bool)") ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEASURABLE_ON_UNIV]) THEN
        REWRITE_TAC [MEASURABLE_ON_PREIMAGE_OPEN] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(:real^1) DELETE vec 0")) THEN
        SIMP_TAC [OPEN_UNIV, OPEN_DELETE, IN_DELETE, IN_UNIV] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
        ASM_SIMP_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_VEC] THEN
        REWRITE_TAC [← MESON [] (← q r"~(if p then F else T) <=> p")] THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN s} = s")],
        UNDISCH_TAC (← q r"(\x:real^N. lift(f x)) measurable_on s") THEN
        ASM_SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"u:real^1->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"IMAGE (lift o inv o drop) (u DELETE vec 0)")) THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC OPEN_IN_OPEN_TRANS THEN
          EXISTS_TAC (← q r"(:real^1) DELETE vec 0") THEN
          SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
          MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
          MAP_EVERY EXISTS_TAC
           [← q r"lift o inv o drop", ← q r"(:real^1) DELETE vec 0"] THEN
          CONJ_TAC THENL
           [REWRITE_TAC [HOMEOMORPHISM, SUBSET, FORALL_IN_IMAGE, IN_DELETE,
                         IN_UNIV, o_THM, FORALL_LIFT, LIFT_DROP] THEN
            REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_VEC] THEN
            REWRITE_TAC [REAL_INV_INV, REAL_INV_EQ_0] THEN
            MATCH_MP_TAC CONTINUOUS_ON_INV THEN
            REWRITE_TAC [IN_DELETE, o_DEF, LIFT_DROP, CONTINUOUS_ON_ID] THEN
            SIMP_TAC [← GSYM DROP_EQ, DROP_VEC],
            MATCH_MP_TAC OPEN_SUBSET THEN ASM_SIMP_TAC [OPEN_DELETE] THEN
            SET_TAC []],
          MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
          REWRITE_TAC [EXTENSION, IN_IMAGE, o_THM, LIFT_DROP, IN_ELIM_THM] THEN
          REWRITE_TAC [LIFT_EQ, EXISTS_LIFT, LIFT_DROP, IN_DELETE,
                       ← GSYM LIFT_NUM] THEN
          ASM_MESON_TAC [REAL_INV_INV, REAL_INV_EQ_0]]])
    prove
     r"!f:real^N->real s.
        (\x. lift(f x)) measurable_on s /\ negligible {x | x IN s /\ f x = &0}
        ==> (\x. lift(inv(f x))) measurable_on s"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] MEASURABLE_ON_SPIKE_SET) THEN
      EXISTS_TAC (← q r"{x:real^N | x IN s /\ ~(f x = &0)}") THEN CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC lemma THEN SIMP_TAC [IN_ELIM_THM] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] MEASURABLE_ON_SPIKE_SET) THEN
        EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            NEGLIGIBLE_SUBSET)) THEN
      SET_TAC []))

  let MEASURABLE_ON_LIFT_DIV ← prove
   r"!f:real^N->real g s.
        (\x. lift(f x)) measurable_on s /\ (\x. lift(g x)) measurable_on s /\
        negligible {x | x IN s /\ g x = &0}
        ==> (\x. lift(f x / g x)) measurable_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_div] THEN
    MATCH_MP_TAC MEASURABLE_ON_LIFT_MUL THEN
    ASM_SIMP_TAC [MEASURABLE_ON_LIFT_INV])

  let ABSOLUTELY_INTEGRABLE_UNION ← prove
   r"!f:real^M->real^N s t.
        f absolutely_integrable_on s /\ f absolutely_integrable_on t
        ==> f absolutely_integrable_on (s UNION t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(f:real^M->real^N) absolutely_integrable_on
    ({x | x IN s /\ ~(f x = vec 0)} INTER
     {x | x IN t /\ ~(f x = vec 0)})")
    MP_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_INTER THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"(f:real^M->real^N) absolutely_integrable_on s"),
        UNDISCH_TAC (← q r"(f:real^M->real^N) absolutely_integrable_on t")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_IMP_MEASURABLE o
          MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
      ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
      REWRITE_TAC [MEASURABLE_ON_PREIMAGE_OPEN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N) DELETE (vec 0)")) THEN
      SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_TERM_TAC THEN SET_TAC [],
      ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV])) THEN
      ONCE_REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ADD) THEN
      ONCE_REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
      MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
      ASM_REWRITE_TAC [IN_INTER, IN_UNION, IN_ELIM_THM] THEN
      ASM_CASES_TAC (← q r"(f:real^M->real^N) x = vec 0") THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC (fun t => VECTOR_ARITH t)])

  let ABSOLUTELY_INTEGRABLE_DIFF ← prove
   r"!f:real^M->real^N s t.
        f absolutely_integrable_on s /\ f absolutely_integrable_on t
        ==> f absolutely_integrable_on (s DIFF t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_UNION) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2) THEN REWRITE_TAC [IMP_IMP] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNION] THEN
    CONV_TAC (fun t => VECTOR_ARITH t))

  let ABSOLUTELY_INTEGRABLE_INTER ← prove
   r"!f:real^M->real^N s t.
        f absolutely_integrable_on s /\ f absolutely_integrable_on t
        ==> f absolutely_integrable_on (s INTER t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_UNION) THEN
    POP_ASSUM MP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ADD) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [IN_INTER, IN_UNION] THEN
    CONV_TAC (fun t => VECTOR_ARITH t))

  let INTEGRAL_COUNTABLE_UNIONS_ALT ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on (UNIONS {s m | m IN (:num)}) /\
        (!m. lebesgue_measurable(s m))
        ==> (!n. f absolutely_integrable_on UNIONS {s m | m IN 0..n}) /\
            ((\n. integral (UNIONS {s m | m IN 0..n}) f)
             --> integral (UNIONS {s m | m IN (:num)}) f) sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET)) THEN
      CONJ_TAC THENL [SET_TAC [], MATCH_MP_TAC LEBESGUE_MEASURABLE_UNIONS] THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, SIMPLE_IMAGE] THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG],
      DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ q ==> p ==> q")) THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_UNIV,
                      ← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    MATCH_MP_TAC DOMINATED_CONVERGENCE THEN
    EXISTS_TAC
     (← q r"\x. if x IN UNIONS {s m | m IN (:num)}
        then lift(norm((f:real^M->real^N) x)) else vec 0") THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_UNIV, INTEGRABLE_RESTRICT_UNIV] THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
                  ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    REWRITE_TAC [IN_UNIV] THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN
      REPEAT (COND_CASES_TAC THEN
             ASM_REWRITE_TAC [REAL_LE_REFL, LIFT_DROP, REAL_LE_REFL,
                              NORM_0, DROP_VEC, NORM_POS_LE]) THEN
      ASM SET_TAC [],
      X_GEN_TAC (← q r"x:real^M") THEN COND_CASES_TAC THENL
       [MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_UNIONS]) THEN
        REWRITE_TAC [EXISTS_IN_GSPEC] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_NUMSEG, LE_0, IN_ELIM_THM] THEN MESON_TAC [],
        MATCH_MP_TAC LIM_EVENTUALLY THEN MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_NUMSEG, LE_0, IN_ELIM_THM] THEN ASM
        SET_TAC []]])

  pure { MEASURABLE_ON_LIFT_INV, MEASURABLE_ON_LIFT_DIV, ABSOLUTELY_INTEGRABLE_UNION,
         ABSOLUTELY_INTEGRABLE_DIFF, ABSOLUTELY_INTEGRABLE_INTER,
         INTEGRAL_COUNTABLE_UNIONS_ALT }

/- ------------------------------------------------------------------------- -/
/- Regularity properties and Steinhaus, this time for Lebesgue measure.    -/
/- (measure.ml 12022-12194)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAZ where
  LEBESGUE_MEASURABLE_OUTER_OPEN : thm
  LEBESGUE_MEASURABLE_INNER_CLOSED : thm
  STEINHAUS_LEBESGUE : thm
  LEBESGUE_MEASURABLE_REGULAR_OUTER : thm
  LEBESGUE_MEASURABLE_REGULAR_INNER : thm
  LEBESGUE_MEASURABLE_SMALL_IMP_NEGLIGIBLE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAZ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSJ : MSJ) (BMSO : MSO) (BMSW : MSW) (BMSAM : MSAM) (BMSAS : MSAS) : ExceptT String IO MSAZ := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURABLE_INTERVAL, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_MEASURE_POS_LT, MEASURE_DIFF_SUBSET, .. } := BMSB
  let { NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE, .. } := BMSF
  let { MEASURABLE_BALL, .. } := BMSJ
  let { MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { STEINHAUS, .. } := BMSW
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_INTER,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
        MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE, .. } := BMSAS
  let { NEGLIGIBLE_ON_INTERVALS, .. } := D.qintegration3
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_IMAGE, CARD_LE_SUBSET, CARD_MUL_LT_INFINITE,
        CARD_NOT_LT, mul_c, NUM_COUNTABLE, .. } := D.qcard
  let { real_INFINITE, SUBSET_INTERS, UNIONS_DIFF, .. } := D.qsession
  let { CARD_EQ_BALL, CLOSED_UNION_COMPACT_SUBSETS, .. } := D.qtopology1
  let { OPEN_UNIONS, .. } := D.qtopology2
  let { CARD_LE_TRANS, .. } := D.ig.qcard
  let { SUM_GP, .. } := D.ig.qmisc
  let { REAL_ARCH_POW2, .. } := D.ig.qsession
  let { COUNTABLE_AS_IMAGE, .. } := D.ig.dv.dg.qcard
  let { LT, .. } := D.ig.dv.dg.qsession
  let { OPEN_CLOSED, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_RAT_REDUCE_CONV,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { EQ_IMP, EXISTS_PAIR_THM, EXTENSION, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_ELIM_PAIR_THM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_AND,
        MONO_EXISTS, NOT_FORALL_THM, REAL_ARCH_POW_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_POW, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_POW_INV, REAL_POW_LE, RIGHT_EXISTS_AND_THM, SKOLEM_THM,
        SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_div, SUM_LE_NUMSEG, SUM_LMUL, UNIONS_IMAGE, UNIONS_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_PRODUCT_DEPENDENT, .. } := D.ig.dv.dg.pt.cvx.lib
  let { IN_BALL_0, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let LEBESGUE_MEASURABLE_OUTER_OPEN ← prove
   r"!s:real^N->bool e.
        lebesgue_measurable s /\ &0 < e
        ==> ?t. open t /\
                s SUBSET t /\
                measurable(t DIFF s) /\
                measure(t DIFF s) < e"
   (REPEAT STRIP_TAC THEN MP_TAC (← GEN (← q r"n:num")
     (← ISPECL [← q r"s INTER ball(vec 0:real^N,&2 pow n)",
               ← q r"e / &4 / &2 pow n"]
          MEASURABLE_OUTER_OPEN)) THEN
    ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, REAL_LT_DIV,
                  MEASURABLE_BALL, REAL_LT_INV_EQ, REAL_LT_POW2,
                  ← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"t:num->real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS(IMAGE t (:num)):real^N->bool") THEN
    ASM_SIMP_TAC [OPEN_UNIONS, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"norm(x:real^N)") REAL_ARCH_POW2) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [IN_BALL_0, IN_INTER],
      REWRITE_TAC [UNIONS_DIFF, ← SET_RULE
       (← q r"{f x | x IN IMAGE g s} = {f(g(x)) | x IN s}")] THEN
      MATCH_MP_TAC (← MESON [← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")]
          (← q r"&0 < e /\ P /\ x <= e / &2 ==> P /\ x < e")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN
      ASM_SIMP_TAC [MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE] THEN
      X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum(0..n) (\i. e / &4 / &2 pow i)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"measure(t i DIFF (s INTER ball(vec 0:real^N,&2 pow i)))") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [MATCH_MP_TAC MEASURE_SUBSET THEN
          ASM_SIMP_TAC [MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE,
            MEASURABLE_INTER, MEASURABLE_BALL, LEBESGUE_MEASURABLE_INTER,
            MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
          SET_TAC [],
          ASM_SIMP_TAC [MEASURE_DIFF_SUBSET, MEASURABLE_DIFF, MEASURABLE_BALL,
                        MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"t < s + e ==> t - s <= e")]],
        REWRITE_TAC [real_div, SUM_LMUL, REAL_INV_POW, SUM_GP] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [← CONJUNCT1 LT] THEN
        ASM_SIMP_TAC [← GSYM REAL_MUL_ASSOC, REAL_LE_LMUL_EQ] THEN
        REWRITE_TAC [← REAL_ARITH
          (← q r"&1 / &4 * (&1 - x) * &2 <= &1 / &2 <=> &0 <= x")] THEN
        MATCH_MP_TAC REAL_POW_LE THEN CONV_TAC REAL_RAT_REDUCE_CONV]])

  let LEBESGUE_MEASURABLE_INNER_CLOSED ← prove
   r"!s:real^N->bool e.
        lebesgue_measurable s /\ &0 < e
        ==> ?t. closed t /\
                t SUBSET s /\
                measurable(s DIFF t) /\
                measure(s DIFF t) < e"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"t:real^N->bool") o MATCH_MP
      LEBESGUE_MEASURABLE_OUTER_OPEN) THEN
    EXISTS_TAC (← q r"(:real^N) DIFF t") THEN POP_ASSUM MP_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
    REWRITE_TAC [← GSYM OPEN_CLOSED] THENL
     [SET_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC,
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC] THEN
    SET_TAC [])

  let STEINHAUS_LEBESGUE ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s /\ ~negligible s
        ==> ?d. &0 < d /\ ball(vec 0,d) SUBSET {x - y | x IN s /\ y IN s}"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    MP_TAC (← ISPEC (← q r"s INTER interval[a:real^N,b]") STEINHAUS) THEN
    ASM_SIMP_TAC [← GSYM MEASURABLE_MEASURE_POS_LT, MEASURABLE_INTERVAL,
                  MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
    SET_TAC [])

  let LEBESGUE_MEASURABLE_REGULAR_OUTER ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s
        ==> ?k c. negligible k /\ (!n. open(c n)) /\
                  s = INTERS {c n | n IN (:num)} DIFF k"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      LEBESGUE_MEASURABLE_OUTER_OPEN)) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
    REWRITE_TAC [REAL_LT_POW2, SKOLEM_THM, REAL_LT_INV_EQ] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"c:num->real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"INTERS {c n | n IN (:num)} DIFF s:real^N->bool") THEN
    EXISTS_TAC (← q r"c:num->real^N->bool") THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"s = t DIFF (t DIFF s) <=> s SUBSET t")] THEN
    ASM_REWRITE_TAC [SUBSET_INTERS, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [REAL_POW_INV]] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
    EXISTS_TAC (← q r"(c:num->real^N->bool) n DIFF s") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [SET_TAC [], ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS]])

  let LEBESGUE_MEASURABLE_REGULAR_INNER ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s
        ==> ?k c. negligible k /\ (!n. compact(c n)) /\
                  s = UNIONS {c n | n IN (:num)} UNION k"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      LEBESGUE_MEASURABLE_INNER_CLOSED)) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
    REWRITE_TAC [REAL_LT_POW2, SKOLEM_THM, REAL_LT_INV_EQ] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"c:num->real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"s DIFF UNIONS {c n | n IN (:num)}:real^N->bool") THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [REAL_POW_INV]] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      EXISTS_TAC (← q r"s DIFF (c:num->real^N->bool) n") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [SET_TAC [], ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS]],
      SUBGOAL_THEN
       (← q r"?d. (!n. compact(d n:real^N->bool)) /\
          UNIONS {d n | n IN (:num)} = UNIONS {c n | n IN (:num)}")
      MP_TAC THENL
       [MP_TAC (← GEN (← q r"n:num") (← ISPEC
         (← q r"(c:num->real^N->bool) n") CLOSED_UNION_COMPACT_SUBSETS)) THEN
        ASM_REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN DISCH_THEN
         (X_CHOOSE_THEN (← q r"d:num->num->real^N->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
         (← q r"COUNTABLE {d n m:real^N->bool | n IN (:num) /\ m IN (:num)}")
        MP_TAC THENL
         [MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
          REWRITE_TAC [NUM_COUNTABLE],
          DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COUNTABLE_AS_IMAGE)) THEN
          ANTS_TAC THENL [SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
          ASM SET_TAC []],
        MATCH_MP_TAC MONO_EXISTS THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [← SET_RULE (← q r"s = t UNION (s DIFF t) <=> t SUBSET s")] THEN
        ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC]]])

  let LEBESGUE_MEASURABLE_SMALL_IMP_NEGLIGIBLE ← prove
   r"!s:real^N->bool. lebesgue_measurable s /\ s <_c (:real) ==> negligible s"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q <=> ~(p /\ ~q)")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP STEINHAUS_LEBESGUE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s:real^N->bool", ← q r"(:real)"]
          CARD_MUL_LT_INFINITE) THEN
    ASM_REWRITE_TAC [real_INFINITE, mul_c, CARD_NOT_LT] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"ball(vec 0:real^N,r)") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CARD_EQ_BALL, CARD_EQ_SYM, CARD_EQ_IMP_LE], ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"{x - y:real^N | x IN s /\ y IN s}") THEN
    ASM_SIMP_TAC [CARD_LE_SUBSET] THEN
    SUBGOAL_THEN
      (← q r"{x - y:real^N | x IN s /\ y IN s} =
     IMAGE (\z. FST z - SND z) {x,y | x IN s /\ y IN s}")
      (fun th => REWRITE_TAC [th, CARD_LE_IMAGE]) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM] THEN
    SET_TAC [])

  pure { LEBESGUE_MEASURABLE_OUTER_OPEN, LEBESGUE_MEASURABLE_INNER_CLOSED,
         STEINHAUS_LEBESGUE, LEBESGUE_MEASURABLE_REGULAR_OUTER,
         LEBESGUE_MEASURABLE_REGULAR_INNER, LEBESGUE_MEASURABLE_SMALL_IMP_NEGLIGIBLE }

/- ------------------------------------------------------------------------- -/
/- A Lebesgue measurable set is almost an F_sigma or G_delta; existence of -/
/- nonmeasurable subsets of any set of positive measure.                    -/
/- (measure.ml 12195-12325)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBA where
  LEBESGUE_MEASURABLE_ALMOST_FSIGMA : thm
  LEBESGUE_MEASURABLE_ALMOST_GDELTA : thm
  NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS : thm
  NEGLIGIBLE_IFF_MEASURABLE_SUBSETS : thm
  NON_MEASURABLE_SET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBA [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSF : MSF) (BMSAM : MSAM) (BMSAZ : MSAZ) : ExceptT String IO MSBA := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { NEGLIGIBLE_OUTER_LE, NOT_NEGLIGIBLE_UNIV, .. } := BMSC
  let { NEGLIGIBLE_TRANSLATION_EQ, .. } := BMSE
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { LEBESGUE_MEASURABLE_COMPL, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
        NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { LEBESGUE_MEASURABLE_INNER_CLOSED, STEINHAUS_LEBESGUE, .. } := BMSAZ
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { RATIONAL_BETWEEN, RATIONAL_CLOSED, .. } := D.qfloor
  let { UNION_OF, .. } := D.qsession
  let { fsigma, GDELTA_COMPLEMENT, .. } := D.qtopology2
  let { COUNTABLE_RATIONAL, .. } := D.ig.qmisc
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        SELECT_CONV, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { ARITH, CONJ_SYM, DIMINDEX_GE_1, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM,
        NOT_IMP, REAL_ARCH_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { UNIONS_IMAGE, UNIONS_SUBSET, UNWIND_THM1, UNWIND_THM2,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { BASIS_NONZERO, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { NORM_BASIS, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_MUL_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_BALL_0, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let LEBESGUE_MEASURABLE_ALMOST_FSIGMA ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s
        ==> ?c t. fsigma c /\ negligible t /\ c UNION t = s /\ DISJOINT c t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [fsigma, UNION_OF, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(?a b c. P a b c) <=> (?c b a. P a b c)")] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q /\ r) /\ s /\ t /\ u <=>
                    r /\ t /\ u /\ p /\ q /\ s")] THEN
    REWRITE_TAC [UNWIND_THM1] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          LEBESGUE_MEASURABLE_INNER_CLOSED)) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, SKOLEM_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"f:num->real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:num->real^N->bool) (:num)") THEN
    EXISTS_TAC (← q r"s DIFF UNIONS (IMAGE (f:num->real^N->bool) (:num))") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"DISJOINT s (u DIFF s)"), COUNTABLE_IMAGE,
                  NUM_COUNTABLE, FORALL_IN_IMAGE, IN_UNIV, UNIONS_SUBSET,
                  ← SET_RULE (← q r"s UNION (u DIFF s) = u <=> s SUBSET u")] THEN
    REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_ARCH_INV]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"s DIFF (f:num->real^N->bool) n") THEN
    ASM_REWRITE_TAC [UNIONS_IMAGE] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"inv(&n + &1)") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN TRANS_TAC REAL_LE_TRANS (← q r"inv(&n)") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
    REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_ADD] THEN
    ASM_ARITH_TAC)

  let LEBESGUE_MEASURABLE_ALMOST_GDELTA ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s
        ==> ?c t. gdelta c /\ negligible t /\ s UNION t = c /\ DISJOINT t s"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_ALMOST_FSIGMA) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"t:real^N->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"(:real^N) DIFF c", ← q r"t:real^N->bool"] THEN
    ASM_REWRITE_TAC [GDELTA_COMPLEMENT] THEN ASM SET_TAC [])

  let NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS ← (do
    let lemma ← prove
     r"!s:real^N->bool.
      lebesgue_measurable s /\
      (!x y q. x IN s /\ y IN s /\ rational q /\ y = q % basis 1 + x ==> y = x)
      ==> negligible s"
     (SIMP_TAC [← VECTOR_ARITH (← q r"q + x:real^N = x <=> q = vec 0"), VECTOR_MUL_EQ_0,
                BASIS_NONZERO, DIMINDEX_GE_1, ARITH] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN
      DISCH_TAC THEN MP_TAC (← ISPEC (← q r"s:real^N->bool") STEINHAUS_LEBESGUE) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      FIRST_ASSUM (X_CHOOSE_TAC (← q r"q:real") o MATCH_MP RATIONAL_BETWEEN) THEN
      FIRST_X_ASSUM
       (MP_TAC o SPEC (← q r"q % basis 1:real^N") o GEN_REWRITE_RULE I [SUBSET]) THEN
      SIMP_TAC [IN_BALL_0, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1,
                ARITH, NOT_IMP] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [IN_ELIM_THM]] THEN
      ASM_REWRITE_TAC [REAL_MUL_RID, IN_ELIM_THM, NOT_EXISTS_THM,
                       ← VECTOR_ARITH (← q r"q:real^N = x - y <=> x = q + y")] THEN
      ASM_CASES_TAC (← q r"q = &0") THENL [ASM_REAL_ARITH_TAC, ASM_MESON_TAC []])
    prove
     r"!s:real^N->bool. negligible s <=> !t. t SUBSET s ==> lebesgue_measurable t"
     (GEN_TAC THEN EQ_TAC THENL
       [MESON_TAC [NEGLIGIBLE_SUBSET, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
        DISCH_TAC] THEN
      ABBREV_TAC
       (← q r"(canonize:real^N->real^N) =
    \x. @y. y IN s /\ ?q. rational q /\ q % basis 1 + y = x") THEN
      SUBGOAL_THEN
       (← q r"!x:real^N. x IN s
               ==> canonize x IN s /\
                   ?q. rational q /\ q % basis 1 + canonize x = x")
      ASSUME_TAC THENL
       [GEN_TAC THEN DISCH_TAC THEN EXPAND_TAC "canonize" THEN
        CONV_TAC SELECT_CONV THEN EXISTS_TAC (← q r"x:real^N") THEN
        ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"&0") THEN
        REWRITE_TAC [RATIONAL_CLOSED] THEN VECTOR_ARITH_TAC,
        ALL_TAC] THEN
      ABBREV_TAC (← q r"v = IMAGE (canonize:real^N->real^N) s") THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"UNIONS (IMAGE (\q. IMAGE (\x:real^N. q % basis 1 + x) v) rational)") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [UNIONS_IMAGE, SUBSET, IN_ELIM_THM] THEN ASM SET_TAC []] THEN
      MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
      SIMP_TAC [COUNTABLE_RATIONAL, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_TRANSLATION_EQ] THEN GEN_TAC THEN
      DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC lemma THEN
      CONJ_TAC THENL [FIRST_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
      EXPAND_TAC "v" THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"q:real") THEN REPEAT DISCH_TAC THEN
      EXPAND_TAC "canonize" THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"z:real^N") THEN AP_TERM_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"y:real^N") th) THEN
              MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"q % b + x:real^N = y <=> x = y - q % b")] THEN
      STRIP_TAC THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"x - q % b:real^N = y - r % b - s % b <=>
                   y + (q - r - s) % b = x /\ x + (r + s - q) % b = y")] THEN
      STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC
       (BINDER_CONV o RAND_CONV o RAND_CONV o LAND_CONV) [← SYM th])) THEN
      SIMP_TAC [VECTOR_MUL_EQ_0, BASIS_NONZERO, DIMINDEX_GE_1, ARITH, ← VECTOR_ARITH
       (← q r"y - q % b:real^N = (y + r % b) - s % b <=> (q + r - s) % b = vec 0")] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a + b - c = &0 <=> c = a + b"), UNWIND_THM2] THEN
      ASM_SIMP_TAC [RATIONAL_CLOSED]))

  let NEGLIGIBLE_IFF_MEASURABLE_SUBSETS ← prove
   r"!s:real^N->bool. negligible s <=> !t. t SUBSET s ==> measurable t"
   (MESON_TAC [NEGLIGIBLE_SUBSET, NEGLIGIBLE_IMP_MEASURABLE,
               MEASURABLE_IMP_LEBESGUE_MEASURABLE,
               NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS])

  let NON_MEASURABLE_SET ← prove
   r"?s:real^N->bool. ~lebesgue_measurable s"
   (MP_TAC (← ISPEC (← q r"(:real^N)") NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS) THEN
    REWRITE_TAC [NOT_NEGLIGIBLE_UNIV] THEN MESON_TAC [])

  pure { LEBESGUE_MEASURABLE_ALMOST_FSIGMA, LEBESGUE_MEASURABLE_ALMOST_GDELTA,
         NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS, NEGLIGIBLE_IFF_MEASURABLE_SUBSETS,
         NON_MEASURABLE_SET }

/- ------------------------------------------------------------------------- -/
/- Preserving Lebesgue measurability vs. preserving negligibility;         -/
/- Lebesgue-Lebesgue measurability.  (measure.ml 12326-12512)               -/
/- ------------------------------------------------------------------------- -/

structure MSBB where
  PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE : thm
  PRESERVES_NEGLIGIBLE_IMAGE : thm
  PRESERVES_NEGLIGIBLE_IMAGE_UNIV : thm
  LEBESGUE_MEASURABLE_CONTINUOUS_IMAGE : thm
  PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE : thm
  PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_ALT : thm
  LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE : thm
  LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN : thm
  MEASURABLE_LINEAR_IMAGE_GEN : thm
  LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ_GEN : thm
  DOUBLE_LEBESGUE_MEASURABLE : thm
  DOUBLE_LEBESGUE_MEASURABLE_ON : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBB [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSJ : MSJ) (BMST : MST) (BMSAJ : MSAJ) (BMSAM : MSAM) (BMSAP : MSAP) (BMSAW : MSAW) (BMSAZ : MSAZ) (BMSBA : MSBA) : ExceptT String IO MSBB := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { NEGLIGIBLE_LOWDIM, .. } := BMSJ
  let { MEASURABLE_LINEAR_IMAGE_EQ_GEN, .. } := BMST
  let { NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM, NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE,
        .. } := BMSAJ
  let { BOREL_IMP_LEBESGUE_MEASURABLE, LEBESGUE_MEASURABLE_COMPACT,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, LEBESGUE_MEASURABLE_INTER,
        LEBESGUE_MEASURABLE_UNION, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_BOREL, .. } := BMSAP
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL, .. } := BMSAW
  let { LEBESGUE_MEASURABLE_REGULAR_INNER, .. } := BMSAZ
  let { LEBESGUE_MEASURABLE_ALMOST_FSIGMA, NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS,
        .. } := BMSBA
  let { DIFFERENTIABLE_ON_LINEAR, DIFFERENTIABLE_ON_SUBSET, .. } := D.qderivatives
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { FSIGMA_IMP_BOREL, .. } := D.qtopology2
  let { DIM_IMAGE_KERNEL_GEN, LINEAR_SURJECTIVE_IFF_INJECTIVE_GEN, .. } := D.qvec
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, .. } := D.ig.qderivatives
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { LINEAR_INJECTIVE_0, .. } := D.ig.dv.dg.qvec
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { DIM_EQ_0, .. } := D.ig.dv.dg.pt.qvec
  let { EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_SUBSET_IMAGE, FUN_EQ_THM, IMAGE_o, IMAGE_SUBSET,
        IMAGE_UNION, IMP_CONJ, IMP_IMP, INTER_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DIM_SUBSET, DIM_UNIV, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { SUBSPACE_UNIV, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { COMPACT_CONTINUOUS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  -- @@SCOPE END

  let PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE ← prove
   r"!f s:real^N->bool.
        (!t. negligible t /\ t SUBSET s ==> lebesgue_measurable(IMAGE f t))
        ==> (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [NEGLIGIBLE_IFF_LEBESGUE_MEASURABLE_SUBSETS] THEN
    REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
    ASM_MESON_TAC [NEGLIGIBLE_SUBSET, SUBSET_TRANS])

  let PRESERVES_NEGLIGIBLE_IMAGE ← prove
   r"!f:real^M->real^N s.
      (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t)) <=>
      (!t. negligible t /\ t SUBSET s ==> lebesgue_measurable(IMAGE f t))"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE] THEN
    MESON_TAC [NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE])

  let PRESERVES_NEGLIGIBLE_IMAGE_UNIV ← prove
   r"!f:real^M->real^N.
        (!t. negligible t ==> negligible(IMAGE f t)) <=>
        (!t. negligible t  ==> lebesgue_measurable(IMAGE f t))"
   (MESON_TAC [PRESERVES_NEGLIGIBLE_IMAGE, SUBSET_UNIV])

  let LEBESGUE_MEASURABLE_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t))
        ==> !t. lebesgue_measurable t /\ t SUBSET s
                ==> lebesgue_measurable(IMAGE f t)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (STRIP_ASSUME_TAC o
      MATCH_MP LEBESGUE_MEASURABLE_REGULAR_INNER) THEN
    ASM_REWRITE_TAC [IMAGE_UNION, IMAGE_UNIONS] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN
    SUBGOAL_THEN (← q r"(k:real^M->bool) SUBSET s") ASSUME_TAC THENL
     [ASM SET_TAC [], ASM_SIMP_TAC [NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE]] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, FORALL_IN_IMAGE] THEN
    SIMP_TAC [IN_UNIV, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
    GEN_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_COMPACT THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [])

  let PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> ((!t. lebesgue_measurable t /\ t SUBSET s
                  ==> lebesgue_measurable (IMAGE f t)) <=>
             (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t)))"
   (MESON_TAC [LEBESGUE_MEASURABLE_CONTINUOUS_IMAGE,
               PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE,
               NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE])

  let PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_ALT ← prove
   r"!f:real^M->real^N.
        f continuous_on s
        ==> ((!t. lebesgue_measurable t /\ t SUBSET s
                  ==> lebesgue_measurable (IMAGE f t)) <=>
             (!t. negligible t /\ t SUBSET s
                  ==> lebesgue_measurable(IMAGE f t)))"
   (SIMP_TAC [PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE] THEN
    MESON_TAC [PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE,
               NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE])

  let LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) <= dimindex(:N) /\
        f differentiable_on s /\ lebesgue_measurable s
        ==> lebesgue_measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC
     (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
          LEBESGUE_MEASURABLE_CONTINUOUS_IMAGE) THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_SIMP_TAC [SUBSET_REFL, DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE THEN
    ASM_MESON_TAC [DIFFERENTIABLE_ON_SUBSET])

  let LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN ← prove
   r"!f:real^M->real^N s.
        linear f /\ lebesgue_measurable s /\ dimindex(:M) <= dimindex(:N)
        ==> lebesgue_measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_ON_LINEAR])

  let MEASURABLE_LINEAR_IMAGE_GEN ← prove
   r"!f:real^M->real^N s.
        linear f /\ measurable s /\ dimindex(:M) <= dimindex(:N)
        ==> measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
     (← q r"m:num <= n ==> m < n \/ m = n")))
    THENL
     [MATCH_MP_TAC NEGLIGIBLE_IMP_MEASURABLE THEN
      MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM THEN
      ASM_SIMP_TAC [DIFFERENTIABLE_ON_LINEAR],
      ASM_CASES_TAC (← q r"!x y. (f:real^M->real^N) x = f y ==> x = y") THENL
       [ASM_MESON_TAC [MEASURABLE_LINEAR_IMAGE_EQ_GEN], ALL_TAC] THEN
      MATCH_MP_TAC NEGLIGIBLE_IMP_MEASURABLE THEN
      MATCH_MP_TAC NEGLIGIBLE_LOWDIM THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)"]
          DIM_IMAGE_KERNEL_GEN) THEN
      ASM_REWRITE_TAC [SUBSPACE_UNIV, DIM_UNIV] THEN ONCE_ASM_REWRITE_TAC [] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC (← ARITH_RULE
       (← q r"x <= y /\ ~(d = 0) ==> x < y + d")) THEN
      SIMP_TAC [DIM_SUBSET, IMAGE_SUBSET, SUBSET_UNIV] THEN
      REWRITE_TAC [IN_UNIV, DIM_EQ_0] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_INJECTIVE_0) THEN ASM SET_TAC []])

  let LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ_GEN ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) = dimindex(:N) /\ linear f /\ (!x y. f x = f y ==> x = y)
        ==> (lebesgue_measurable(IMAGE f s) <=> lebesgue_measurable s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"!y. f((g:real^N->real^M) y) = y") ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_SURJECTIVE_IFF_INJECTIVE_GEN) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    EQ_TAC THENL
     [ALL_TAC,
      ASM_MESON_TAC [LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, LE_REFL]] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s = IMAGE (g:real^N->real^M) (IMAGE f s)") SUBST1_TAC THENL
     [ASM SET_TAC [],
      ASM_MESON_TAC [LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, LE_REFL]])

  let DOUBLE_LEBESGUE_MEASURABLE ← prove
   r"!f:real^M->real^N.
        (!t. lebesgue_measurable t ==> lebesgue_measurable {x | f x IN t}) <=>
        f measurable_on (:real^M) /\
        (!t. negligible t ==> lebesgue_measurable {x | f x IN t})"
   (GEN_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [MEASURABLE_ON_PREIMAGE_BOREL,
                  NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE,
                  BOREL_IMP_LEBESGUE_MEASURABLE] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"u:real^N->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_ALMOST_FSIGMA) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N->bool", ← q r"n:real^N->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | f x IN s UNION t} = {x | f x IN s} UNION {x | f x IN t}")] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN
    ASM_SIMP_TAC [FSIGMA_IMP_BOREL])

  let DOUBLE_LEBESGUE_MEASURABLE_ON ← prove
   r"!f:real^M->real^N s t.
        lebesgue_measurable s /\ lebesgue_measurable t /\ IMAGE f s SUBSET t
        ==> ((!u. lebesgue_measurable u /\ u SUBSET t
                  ==> lebesgue_measurable {x | x IN s /\ f x IN u}) <=>
             f measurable_on s /\
             (!u. negligible u /\ u SUBSET t
                  ==> lebesgue_measurable {x | x IN s /\ f x IN u}))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL] THEN
    EQ_TAC THENL
     [SIMP_TAC [NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t INTER v:real^N->bool")) THEN
      ASM_SIMP_TAC [INTER_SUBSET, LEBESGUE_MEASURABLE_INTER,
                    BOREL_IMP_LEBESGUE_MEASURABLE] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "B") (LABEL_TAC "N")) THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_ALMOST_FSIGMA) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"b:real^N->bool", ← q r"n:real^N->bool"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN a /\ f x IN s UNION t} =
      {x | x IN a /\ f x IN s} UNION {x | x IN a /\ f x IN t}")] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN CONJ_TAC THENL
       [REMOVE_THEN "B" MATCH_MP_TAC, REMOVE_THEN "N" MATCH_MP_TAC] THEN
      ASM_SIMP_TAC [FSIGMA_IMP_BOREL] THEN ASM SET_TAC []])

  pure { PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE,
         PRESERVES_NEGLIGIBLE_IMAGE, PRESERVES_NEGLIGIBLE_IMAGE_UNIV,
         LEBESGUE_MEASURABLE_CONTINUOUS_IMAGE,
         PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE,
         PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_ALT,
         LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE, LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN,
         MEASURABLE_LINEAR_IMAGE_GEN, LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ_GEN,
         DOUBLE_LEBESGUE_MEASURABLE, DOUBLE_LEBESGUE_MEASURABLE_ON }

/- ------------------------------------------------------------------------- -/
/- Measurability of continuous functions and of compositions.              -/
/- (measure.ml 12513-12765)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBC where
  CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET : thm
  CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  MEASURABLE_CONTINUOUS_COMPOSE : thm
  MEASURABLE_ON_COMPOSE_REV : thm
  MEASURABLE_ON_CONTINUOUS_COMPOSE_REV : thm
  MEASURABLE_ON_COMPOSE_GEN : thm
  MEASURABLE_ON_COMPOSE_ALT : thm
  MEASURABLE_ON_CONTINUOUS_COMPOSE : thm
  MEASURABLE_ON_DIFFERENTIABLE_IMAGE : thm
  BOREL_MEASURABLE_IMP_MEASURABLE_ON : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBC [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAF : MSAF) (BMSAM : MSAM) (BMSAW : MSAW) (BMSAZ : MSAZ) (BMSBB : MSBB) : ExceptT String IO MSBC := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_OUTER, .. } := BMSC
  let { measurable_on, .. } := BMSAB
  let { MEASURABLE_ON_SPIKE_SET, .. } := BMSAE
  let { MEASURABLE_ON_LIMIT, .. } := BMSAF
  let { LEBESGUE_MEASURABLE_CLOSED, LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_DIFF,
        NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN, .. } := BMSAW
  let { LEBESGUE_MEASURABLE_INNER_CLOSED, .. } := BMSAZ
  let { DOUBLE_LEBESGUE_MEASURABLE_ON, LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE,
        PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_ALT, .. } := BMSBB
  let { DIFFERENTIABLE_ON_SUBSET, .. } := D.qderivatives
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION, .. } := D.qintegration3
  let { borel_measurable_INDUCT, .. } := D.qtopology2
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, .. } := D.ig.qderivatives
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { prove_recursive_functions_exist, .. } := D.ig.dv.dg.pt
  let { TIETZE_UNBOUNDED, .. } := D.ig.dv.dg.qconvex
  let { REAL_LT_INV2, REAL_LT_TRANS, TRANSITIVE_STEPWISE_LE, .. } := D.ig.dv.dg.qsession
  let { CLOSED_UNION, CONTINUOUS_ON_CASES, .. } := D.ig.dv.dg.qtopology1
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { num_RECURSION, .. } := D.ig.dv.dg.pt.qses
  let { CONJ_ASSOC, DIFF_EMPTY, EMPTY_SUBSET, EQ_IMP, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        OR_EXISTS_THM, REAL_ARCH_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LT_INV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_OF_NUM_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_REFL,
        SUBSET_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { EVENTUALLY_SEQUENTIALLY, SUBTOPOLOGY_UNIV, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_EMPTY, CLOSED_IN, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.top3
  -- @@SCOPE END

  let CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← (do
    let lemma ← prove
     r"!s. lebesgue_measurable s
         ==> ?u:num->real^M->bool.
                (!n. closed(u n)) /\ (!n. u n SUBSET s) /\
                (!n. measurable(s DIFF u n) /\
                     measure(s DIFF u n) < inv(&n + &1)) /\
                (!n. u(n) SUBSET u(SUC n))"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!n t. closed t /\ t SUBSET s
            ==> ?u:real^M->bool.
                      closed u /\ t SUBSET u /\ u SUBSET s /\
                      measurable(s DIFF u) /\ measure(s DIFF u) < inv(&n + &1)")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"s DIFF t:real^M->bool", ← q r"inv(&n + &1)"]
          LEBESGUE_MEASURABLE_INNER_CLOSED) THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_CLOSED] THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"t UNION u:real^M->bool") THEN ASM_SIMP_TAC [CLOSED_UNION] THEN
        CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [← SET_RULE (← q r"s DIFF (t UNION u) = s DIFF t DIFF u")],
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"v:num->(real^M->bool)->(real^M->bool)") THEN DISCH_TAC THEN
        MP_TAC (← prove_recursive_functions_exist num_RECURSION
            (← q r"(u:num->real^M->bool) 0 = v 0 {} /\
           (!n. u(SUC n) = v (SUC n) (u n))")) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:num->real^M->bool") THEN
        STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"!n. closed(u n) /\ (u:num->real^M->bool) n SUBSET s")
        ASSUME_TAC THENL
         [INDUCT_TAC THEN
          ASM_SIMP_TAC [CLOSED_EMPTY, EMPTY_SUBSET],
          ASM_SIMP_TAC []] THEN
        INDUCT_TAC THEN ONCE_ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [CLOSED_EMPTY, EMPTY_SUBSET]])
    prove
     r"!f:real^M->real^N s.
        f continuous_on s /\ lebesgue_measurable s
        ==> f measurable_on s"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (X_CHOOSE_THEN (← q r"u:num->real^M->bool") STRIP_ASSUME_TAC o
        MATCH_MP lemma) THEN
      SUBGOAL_THEN (← q r"lebesgue_measurable((:real^M) DIFF s)") MP_TAC THENL
       [ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:num->real^M->bool") STRIP_ASSUME_TAC o
        MATCH_MP lemma) THEN
      REWRITE_TAC [measurable_on] THEN
      EXISTS_TAC (← q r"(:real^M) DIFF
           (UNIONS {u n | n IN (:num)} UNION UNIONS {v n | n IN (:num)})") THEN
      SUBGOAL_THEN
       (← q r"!n. ?g. g continuous_on (:real^M) /\
            (!x. x IN u(n) UNION v(n:num)
                 ==> g x = if x IN s then (f:real^M->real^N)(x) else vec 0)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC TIETZE_UNBOUNDED THEN
        ASM_SIMP_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN, CLOSED_UNION] THEN
        MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_CONST] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []],
        REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"g:num->real^M->real^N") THEN
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"(s DIFF UNIONS {u n | n IN (:num)}) UNION
                ((:real^M) DIFF s DIFF UNIONS {v n | n IN (:num)})") THEN
        CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
        MATCH_MP_TAC NEGLIGIBLE_UNION THEN CONJ_TAC THEN
        REWRITE_TAC [NEGLIGIBLE_OUTER] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPEC (← q r"e:real") REAL_ARCH_INV) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THENL
         [EXISTS_TAC (← q r"s DIFF u(n:num):real^M->bool"),
          EXISTS_TAC (← q r"(:real^M) DIFF s DIFF v(n:num):real^M->bool")] THEN
        (CONJ_TAC THENL [SET_TAC [], ASM_REWRITE_TAC []] THEN
         MATCH_MP_TAC REAL_LT_TRANS THEN
         EXISTS_TAC (← q r"inv(&n + &1)") THEN ASM_REWRITE_TAC [] THEN
         MATCH_MP_TAC REAL_LT_TRANS THEN
         EXISTS_TAC (← q r"inv(&n)") THEN ASM_REWRITE_TAC [] THEN
         MATCH_MP_TAC REAL_LT_INV2 THEN ASM_REWRITE_TAC [REAL_OF_NUM_LT] THEN
         CONJ_TAC THENL [ASM_ARITH_TAC, REAL_ARITH_TAC]),
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [← SET_RULE
         (← q r"~(x IN (UNIV DIFF (s UNION t))) <=> x IN s \/ x IN t")] THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        REWRITE_TAC [OR_EXISTS_THM] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
        MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        EXISTS_TAC (← q r"n:num") THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_UNION] THEN
        SUBGOAL_THEN
         (← q r"!i j. i <= j ==> (u:num->real^M->bool)(i) SUBSET u(j) /\
                       (v:num->real^M->bool)(i) SUBSET v(j)")
         (fun th => ASM_MESON_TAC [SUBSET, th]) THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
       ASM_REWRITE_TAC [] THEN SET_TAC []]))

  let CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ closed s ==> f measurable_on s"
   (SIMP_TAC [CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
              LEBESGUE_MEASURABLE_CLOSED])

  let CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!f:real^M->real^N s m.
        f continuous_on (s DIFF m) /\ lebesgue_measurable s /\ negligible m
        ==> f measurable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) measurable_on (s DIFF m)") MP_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_DIFF, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
      MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         NEGLIGIBLE_SUBSET)) THEN
      SET_TAC []])

  let MEASURABLE_CONTINUOUS_COMPOSE ← prove
   r"!f:real^N->real^P g:real^M->real^N.
        f measurable_on UNIV /\
        g continuous_on UNIV /\
        (!k. negligible k ==> negligible {x | g x IN k})
        ==> (f o g) measurable_on UNIV"
   (REWRITE_TAC [measurable_on, IN_UNIV] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"h:num->real^N->real^P"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"{x | (g:real^M->real^N) x IN k}") THEN
    EXISTS_TAC (← q r"\n x:real^M. (h:num->real^N->real^P) n (g x)") THEN
    ASM_SIMP_TAC [IN_ELIM_THM, o_DEF] THEN GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV])

  let MEASURABLE_ON_COMPOSE_REV ← prove
   r"!f:real^N->real^P g:real^M->real^N s t.
      lebesgue_measurable s /\ IMAGE g s = t /\
      (!k. lebesgue_measurable k /\ k SUBSET s
           ==> lebesgue_measurable (IMAGE g k)) /\
      (f o g) measurable_on s
      ==> f measurable_on t"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"lebesgue_measurable(t:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    ASM_SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^P->bool") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [o_THM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{x | x IN s /\ (f:real^N->real^P) (g(x:real^M)) IN u}")) THEN
    ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let MEASURABLE_ON_CONTINUOUS_COMPOSE_REV ← prove
   r"!f:real^N->real^P g:real^M->real^N s t.
      lebesgue_measurable s /\ IMAGE g s = t /\
      (!k. negligible k /\ k SUBSET s
           ==> lebesgue_measurable (IMAGE g k)) /\
      g continuous_on s /\
      (f o g) measurable_on s
      ==> f measurable_on t"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 4 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] MEASURABLE_ON_COMPOSE_REV)) THEN
    ASM_MESON_TAC [PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_ALT])

  let MEASURABLE_ON_COMPOSE_GEN ← prove
   r"!f:real^N->real^P g:real^M->real^N s t.
      lebesgue_measurable t /\ IMAGE g s SUBSET t /\
      (!k. lebesgue_measurable k /\ k SUBSET t
           ==> lebesgue_measurable {x | x IN s /\ g x IN k}) /\
      f measurable_on t
      ==> (f o g) measurable_on s"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"lebesgue_measurable(s:real^M->bool)") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN
      MATCH_MP_TAC EQ_IMP THEN
      AP_TERM_TAC THEN ASM SET_TAC [],
      ASM_SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN]] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^P->bool") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [o_THM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{x | x IN t /\ (f:real^N->real^P) x IN u}")) THEN
    ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let MEASURABLE_ON_COMPOSE_ALT ← prove
   r"!f:real^N->real^P g:real^M->real^N s t.
      lebesgue_measurable s /\ lebesgue_measurable t /\ IMAGE g s SUBSET t /\
      (!k. negligible k /\ k SUBSET t
           ==> lebesgue_measurable {x | x IN s /\ g x IN k}) /\
      g measurable_on s /\
      f measurable_on t
      ==> (f o g) measurable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_COMPOSE_GEN THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [DOUBLE_LEBESGUE_MEASURABLE_ON])

  let MEASURABLE_ON_CONTINUOUS_COMPOSE ← prove
   r"!f:real^N->real^P g:real^M->real^N s t.
      lebesgue_measurable s /\ lebesgue_measurable t /\ IMAGE g s SUBSET t /\
      f measurable_on t /\ g continuous_on s /\
      (!k. negligible k /\ k SUBSET t
           ==> lebesgue_measurable {x | x IN s /\ g x IN k})
      ==> (f o g) measurable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_COMPOSE_ALT THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_SIMP_TAC [CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET])

  let MEASURABLE_ON_DIFFERENTIABLE_IMAGE ← prove
   r"!f:real^N->real^P g:real^M->real^N s.
        dimindex(:M) <= dimindex(:N) /\
        lebesgue_measurable s /\ g differentiable_on s /\
        (f o g) measurable_on s
        ==> f measurable_on (IMAGE g s)"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] MEASURABLE_ON_CONTINUOUS_COMPOSE_REV)) THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE THEN
    ASM_MESON_TAC [DIFFERENTIABLE_ON_SUBSET,
                   NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE])

  let BOREL_MEASURABLE_IMP_MEASURABLE_ON ← prove
   r"!f:real^M->real^N s.
       f borel_measurable_on s /\ lebesgue_measurable s ==> f measurable_on s"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC borel_measurable_INDUCT THEN CONJ_TAC THENL
     [MESON_TAC [CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET],
      REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"lebesgue_measurable(s:real^M->bool)") THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN
      MAP_EVERY EXISTS_TAC [← q r"f:num->real^M->real^N", ← q r"{}:real^M->bool"] THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_EMPTY, DIFF_EMPTY]])

  pure { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
         CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET,
         CONTINUOUS_AE_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
         MEASURABLE_CONTINUOUS_COMPOSE, MEASURABLE_ON_COMPOSE_REV,
         MEASURABLE_ON_CONTINUOUS_COMPOSE_REV, MEASURABLE_ON_COMPOSE_GEN,
         MEASURABLE_ON_COMPOSE_ALT, MEASURABLE_ON_CONTINUOUS_COMPOSE,
         MEASURABLE_ON_DIFFERENTIABLE_IMAGE, BOREL_MEASURABLE_IMP_MEASURABLE_ON }

/- ------------------------------------------------------------------------- -/
/- Connections between measurability and Baire-ness.                       -/
/- (measure.ml 12766-12881)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBD where
  BAIRE_IMP_MEASURABLE_ON : thm
  BAIRE_IMP_MEASURABLE_ON_UNIV : thm
  MEASURABLE_EQ_ALMOST_BAIRE1 : thm
  MEASURABLE_EQ_ALMOST_BAIRE2 : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBD [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSBC : MSBC) : ExceptT String IO MSBD := do
  -- @@SCOPE BEGIN
  let { measurable_on, .. } := BMSAB
  let { MEASURABLE_ON_SPIKE, MEASURABLE_ON_SPIKE_SET, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_UNIV,
        NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { BOREL_MEASURABLE_IMP_MEASURABLE_ON, .. } := BMSBC
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { COUNTABLE_INTERSECTION_OF_INC, COUNTABLE_INTERSECTION_OF_INTERS,
        COUNTABLE_RESTRICT, COUNTABLE_SUBSET_NUM, COUNTABLE_UNION_OF_UNIONS, .. } := D.qcard
  let { RATIONAL_BETWEEN, .. } := D.qfloor
  let { BAIRE_EXTENSION, BAIRE_IMP_BOREL_MEASURABLE, BAIRE_MONO,
        COUNTABLE_UNION_OF_BAIRE_INDICATOR, .. } := D.qtopology1
  let { FSIGMA_BAIRE, .. } := D.qtopology2
  let { COUNTABLE_RATIONAL, .. } := D.ig.qmisc
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONVERGENT_EQ_CAUCHY, .. } := D.ig.dv.qtopology1
  let { baire, cauchy, .. } := D.ig.dv.qtopology2
  let { REAL_LT_TRANS, .. } := D.ig.dv.dg.qsession
  let { CLOSED_IMP_FSIGMA, .. } := D.ig.dv.dg.qtopology1
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, num_CONV, NUM_REDUCE_CONV, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { ETA_AX, EXTENSION, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, GE, IMP_CONJ, IN, IN_DIFF, INTERS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LET_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SIMPLE_IMAGE, SKOLEM_THM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, SUBSET_UNIV, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { dist, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_CBALL, CLOSED_INTERS, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, CONTINUOUS_SUB, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL_0, LIM_UNIQUE, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let BAIRE_IMP_MEASURABLE_ON ← prove
   r"!(f:real^M->real^N) s.
        baire n s f /\ lebesgue_measurable s ==> f measurable_on s"
   (MESON_TAC [BOREL_MEASURABLE_IMP_MEASURABLE_ON, BAIRE_IMP_BOREL_MEASURABLE])

  let BAIRE_IMP_MEASURABLE_ON_UNIV ← prove
   r"!(f:real^M->real^N) s.
        baire n (:real^M) f ==> f measurable_on (:real^M)"
   (MESON_TAC [BAIRE_IMP_MEASURABLE_ON, LEBESGUE_MEASURABLE_UNIV])

  let MEASURABLE_EQ_ALMOST_BAIRE1 ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        ?s. negligible((:real^M) DIFF s) /\ baire 1 s f"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [measurable_on, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:real^M->bool", ← q r"g:num->real^M->real^N"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"(:real^M) DIFF s") THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF (UNIV DIFF s) = s")] THEN
      REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"1")), baire] THEN
      EXISTS_TAC (← q r"g:num->real^M->real^N") THEN ASM_SIMP_TAC [IN_DIFF] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^M->bool") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP BAIRE_IMP_BOREL_MEASURABLE) THEN
      DISCH_THEN (MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] BOREL_MEASURABLE_IMP_MEASURABLE_ON)) THEN
      ONCE_REWRITE_TAC [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
      ASM_SIMP_TAC [NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE] THEN
      MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              NEGLIGIBLE_SUBSET)) THEN
      SET_TAC []])

  let MEASURABLE_EQ_ALMOST_BAIRE2 ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        ?g. baire 2 (:real^M) g /\ negligible {x | ~(g x = f x)}"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [measurable_on, IN_UNIV, LEFT_IMP_EXISTS_THM],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP BAIRE_IMP_BOREL_MEASURABLE) THEN
      DISCH_THEN (MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] BOREL_MEASURABLE_IMP_MEASURABLE_ON)) THEN
      REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV] THEN
      MATCH_MP_TAC MEASURABLE_ON_SPIKE THEN
      EXISTS_TAC (← q r"{x | ~((g:real^M->real^N) x = f x)}") THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN MESON_TAC []] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"g:num->real^M->real^N"] THEN
    STRIP_TAC THEN
    ABBREV_TAC
     (← q r"s = {x | ?l. ((\n. (g:num->real^M->real^N) n x) --> l) sequentially}") THEN
    SUBGOAL_THEN
     (← q r"!x. ?l. x IN s ==> ((\n. (g:num->real^M->real^N) n x) --> l) sequentially")
    MP_TAC THENL [EXPAND_TAC "s" THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^M->real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:real^M->real^N", ← q r"s:real^M->bool", ← q r"2"]
     BAIRE_EXTENSION) THEN
    CONV_TAC NUM_REDUCE_CONV THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC BAIRE_MONO THEN EXISTS_TAC (← q r"SUC 0") THEN
        REWRITE_TAC [baire] THEN CONV_TAC NUM_REDUCE_CONV THEN
        EXISTS_TAC (← q r"g:num->real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"s = INTERS {UNIONS {INTERS
           {{x | dist((g:num->real^M->real^N) m x,g n x) <= e} |
            m IN {p | N <= p} /\ n IN {p | N <= p}} | N IN (:num)} |
           e IN {q | q IN rational /\ &0 < q}}")
      SUBST1_TAC THENL
       [EXPAND_TAC "s" THEN REWRITE_TAC [CONVERGENT_EQ_CAUCHY] THEN
        GEN_REWRITE_TAC I [EXTENSION] THEN X_GEN_TAC (← q r"x:real^M") THEN
        SIMP_TAC [cauchy, UNIONS_GSPEC, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        REWRITE_TAC [IN, GE] THEN EQ_TAC THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"e:real") THEN
        STRIP_TAC THEN MP_TAC (← SPECL [← q r"&0", ← q r"e:real"] RATIONAL_BETWEEN) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"q:real") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"q:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN
        ASM_MESON_TAC [REAL_LT_TRANS, REAL_LT_IMP_LE, REAL_LET_TRANS],
        MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTERS THEN
        SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_RESTRICT,
                  COUNTABLE_RATIONAL, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_THEN (K ALL_TAC) THEN
        MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [← ARITH_RULE (← q r"2 = 1 + 1"), o_THM] THEN
        MATCH_MP_TAC COUNTABLE_UNION_OF_BAIRE_INDICATOR THEN
        MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
        SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"N:num") THEN REWRITE_TAC [IN_UNIV, ← GSYM FSIGMA_BAIRE] THEN
        MATCH_MP_TAC CLOSED_IMP_FSIGMA THEN MATCH_MP_TAC CLOSED_INTERS THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
        REWRITE_TAC [dist, ← GSYM IN_CBALL_0] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
        REWRITE_TAC [CLOSED_CBALL] THEN
        GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_SUB THEN
        REWRITE_TAC [ETA_AX] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"k:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"!x. ~(x IN k) ==> (h:real^M->real^N) x = f x") MP_TAC THENL
       [ALL_TAC, ASM SET_TAC []] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\n. (g:num->real^M->real^N) n x") THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN ASM SET_TAC []])

  pure { BAIRE_IMP_MEASURABLE_ON, BAIRE_IMP_MEASURABLE_ON_UNIV,
         MEASURABLE_EQ_ALMOST_BAIRE1, MEASURABLE_EQ_ALMOST_BAIRE2 }

/- ------------------------------------------------------------------------- -/
/- Versions of the Lebesgue density theorem, both integral and measure     -/
/- forms.  (measure.ml 12882-13137)                                         -/
/- ------------------------------------------------------------------------- -/

structure MSBE where
  LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_CBALL : thm
  LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_BALL : thm
  LEBESGUE_DENSITY_THEOREM_INTEGRAL_CBALL : thm
  LEBESGUE_DENSITY_THEOREM_INTEGRAL_BALL : thm
  LEBESGUE_DENSITY_THEOREM_LIFT_CBALL : thm
  LEBESGUE_DENSITY_THEOREM_LIFT_BALL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBE [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSG : MSG) (BMSJ : MSJ) (BMSAA : MSAA) (BMSAM : MSAM) (BMSAS : MSAS) : ExceptT String IO MSBE := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_ON_INDICATOR, MEASURABLE_INTERVAL, MEASURE_INTERVAL,
        MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURE_NEGLIGIBLE_SYMDIFF, .. } := BMSB
  let { ABSOLUTELY_INTEGRABLE_ON_CONST, INTEGRABLE_ON_CONST, INTEGRAL_CONST_GEN,
        .. } := BMSC
  let { MEASURE_CLOSURE, .. } := BMSG
  let { MEASURABLE_CBALL, MEASURE_CBALL_POS, NEGLIGIBLE_CONVEX_FRONTIER, NEGLIGIBLE_SPHERE,
        .. } := BMSJ
  let { ABSOLUTELY_INTEGRABLE_LEBESGUE_POINTS, .. } := BMSAA
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET, LEBESGUE_MEASURABLE_CBALL,
        .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_RESTRICT_INTER, ABSOLUTELY_INTEGRABLE_SUB,
        CONTENT_CLOSED_INTERVAL_CASES, CONTENT_EQ_0, CONTENT_POS_LE, .. } := D.qintegration1
  let { INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration2
  let { INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_RESTRICT_INTER, INTEGRAL_RESTRICT_UNIV,
        INTEGRAL_SPIKE_SET, INTEGRAL_SUB, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { DIMINDEX_NONZERO, .. } := D.qsession
  let { SPHERE_UNION_BALL, .. } := D.qtopology2
  let { PRODUCT_CONST_NUMSEG_1, .. } := D.ig.qproducts
  let { indicator, LIFT_EQ_CMUL, .. } := D.ig.qvec
  let { REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { LIM_NULL, LIM_TRANSFORM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { SUM_BOUND_GEN, .. } := D.ig.dv.dg.pt.qses
  let { CONVEX_BALL, .. } := D.ig.dv.dg.pt.qcvx2
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, EQ_IMP, FINITE_NUMSEG, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, INTER_UNIV, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LE_1, MONO_AND, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, NOT_LT, NUMSEG_EMPTY, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_POS,
        REAL_DIV_RMUL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_MUL2,
        REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_RDIV_EQ,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_OF_NUM_EQ,
        REAL_OF_NUM_LT, REAL_POS, REAL_POW_DIV, REAL_POW_EQ_0, REAL_POW_LE, REAL_POW_LT,
        REAL_POW_MUL, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_abs, real_div, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_VEC, FORALL_DROP, FORALL_LIFT, IN_INTERVAL, LIFT_CMUL, LIFT_DROP,
        NORM_0, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, NORM_MUL, NORM_POS_LE, REAL_ABS_NORM,
        .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, CLOSURE_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { EVENTUALLY_WITHIN, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL, LIM_NULL_COMPARISON, LIM_WITHIN, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_CBALL ← prove
   r"!f:real^M->real^N.
        (!a b. f absolutely_integrable_on interval[a,b])
        ==> ?k. negligible k /\
                !x. ~(x IN k)
                    ==> ((\e. inv(measure(cball(x,drop e))) %
                              integral (cball(x,drop e))
                                       (\y. lift(norm(f y - f x))))
                        --> vec 0)
                        (at (vec 0) within {t | &0 < drop t})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_LEBESGUE_POINTS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [LIM_WITHIN, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"x:real^M", ← q r"e / &(dimindex(:M)) pow dimindex(:M)"]) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, DIST_0,
                  REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [FORALL_LIFT, NORM_LIFT, LIFT_DROP] THEN
    X_GEN_TAC (← q r"h:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"h:real")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SIMP_TAC [REAL_LT_RDIV_EQ,  REAL_POW_LT,
              REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    REWRITE_TAC [REAL_ABS_MUL, NORM_MUL] THEN ONCE_REWRITE_TAC
     [← REAL_ARITH (← q r"x <= (abs a * b) * c <=> x <= (abs(a) * c) * b")] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [REAL_ABS_POS] THEN
    CONJ_TAC THENL
     [SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, REAL_POW_LT,
                REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
      REWRITE_TAC [REAL_ABS_INV, real_div, ← GSYM REAL_INV_MUL] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN CONJ_TAC THENL
       [REWRITE_TAC [← GSYM REAL_ABS_NZ, CONTENT_EQ_0] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                     VECTOR_SUB_COMPONENT] THEN ASM_REAL_ARITH_TAC,
        SIMP_TAC [real_abs, CONTENT_POS_LE, MEASURE_POS_LE, MEASURABLE_CBALL] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"measure(interval[x - h / &(dimindex(:M)) % vec 1:real^M,
                                   x + h / &(dimindex(:M)) % vec 1]) *
                  &(dimindex (:M)) pow dimindex (:M)") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
          REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                       VECTOR_SUB_COMPONENT, REAL_MUL_RID] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"x - h <= x + h <=> &0 <= h"),
                        REAL_LE_DIV, REAL_POS, REAL_LT_IMP_LE] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"(x + h) - (x - h) = &2 * h"),
                       PRODUCT_CONST_NUMSEG_1, REAL_POW_DIV, REAL_POW_MUL] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> y <= x")) THEN
          REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN AP_TERM_TAC THEN
          MATCH_MP_TAC REAL_DIV_RMUL THEN
          REWRITE_TAC [REAL_POW_EQ_0, REAL_OF_NUM_EQ, DIMINDEX_NONZERO],
          MATCH_MP_TAC REAL_LE_RMUL THEN SIMP_TAC [REAL_POS, REAL_POW_LE] THEN
          MATCH_MP_TAC MEASURE_SUBSET THEN
          REWRITE_TAC [MEASURABLE_INTERVAL, MEASURABLE_CBALL] THEN
          REWRITE_TAC [SUBSET, IN_INTERVAL, IN_CBALL] THEN
          X_GEN_TAC (← q r"y:real^M") THEN
          REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                       VECTOR_SUB_COMPONENT, REAL_MUL_RID, ← REAL_ARITH
                        (← q r"x - h <= y /\ y <= x + h <=> abs(x - y) <= h")] THEN
          STRIP_TAC THEN REWRITE_TAC [dist] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"sum(1..dimindex(:M)) (\i. abs((x - y:real^M)$i))") THEN
          REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_BOUND_GEN THEN
          ASM_REWRITE_TAC [CARD_NUMSEG_1, VECTOR_SUB_COMPONENT, IN_NUMSEG] THEN
          REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1]]],
      REWRITE_TAC [NORM_POS_LE] THEN
      SUBGOAL_THEN
       (← q r"cball(x:real^M,h) SUBSET interval[x - h % vec 1,x + h % vec 1]")
      ASSUME_TAC THENL
       [REWRITE_TAC [SUBSET, IN_CBALL, IN_INTERVAL] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                     VECTOR_SUB_COMPONENT, REAL_MUL_RID, ← REAL_ARITH
                        (← q r"x - h <= y /\ y <= x + h <=> abs(x - y) <= h")] THEN
        REWRITE_TAC [dist, ← GSYM VECTOR_SUB_COMPONENT] THEN
        MESON_TAC [REAL_LE_TRANS, COMPONENT_LE_NORM],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(f:real^M->real^N) absolutely_integrable_on cball(x,h)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
                       LEBESGUE_MEASURABLE_CBALL],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
      REWRITE_TAC [NORM_1] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> a <= abs b")) THEN
      REWRITE_TAC [← GSYM NORM_1] THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV] THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
                    ABSOLUTELY_INTEGRABLE_SUB, ABSOLUTELY_INTEGRABLE_ON_CONST,
                    MEASURABLE_CBALL, MEASURABLE_INTERVAL, IN_UNIV] THEN
      GEN_TAC THEN
      REPEAT (COND_CASES_TAC THEN
             ASM_REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM, LIFT_DROP, NORM_0,
                              DROP_VEC, NORM_POS_LE, REAL_LE_REFL]) THEN
      ASM SET_TAC []])

  let LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_BALL ← prove
   r"!f:real^M->real^N.
        (!a b. f absolutely_integrable_on interval[a,b])
        ==> ?k. negligible k /\
                !x. ~(x IN k)
                    ==> ((\e. inv(measure(ball(x,drop e))) %
                              integral (ball(x,drop e))
                                       (\y. lift(norm(f y - f x))))
                        --> vec 0)
                        (at (vec 0) within {t | &0 < drop t})"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
      MATCH_MP LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_CBALL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, IN_ELIM_THM, FORALL_LIFT, LIFT_DROP] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [DIST_0, NORM_LIFT, REAL_LT_01] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM CLOSURE_BALL, MEASURE_CLOSURE, BOUNDED_BALL,
                  NEGLIGIBLE_CONVEX_FRONTIER, CONVEX_BALL] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE_SET THEN
    ASM_SIMP_TAC [CLOSURE_BALL] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"sphere(x:real^M,e)") THEN REWRITE_TAC [NEGLIGIBLE_SPHERE] THEN
    REWRITE_TAC [← GSYM SPHERE_UNION_BALL] THEN SET_TAC [])

  let LEBESGUE_DENSITY_THEOREM_INTEGRAL_CBALL ← prove
   r"!f:real^M->real^N s.
        (!a b. f absolutely_integrable_on (s INTER interval[a,b]))
        ==> ?k. negligible k /\
                !x. ~(x IN k)
                    ==> ((\e. inv(measure(cball(x,drop e))) %
                              integral (s INTER cball(x,drop e)) f)
                         --> (if x IN s then f x else vec 0))
                        (at (vec 0) within {t | &0 < drop t})"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_INTER] THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_INTER] THEN
    ABBREV_TAC (← q r"g:real^M->real^N = \x. if x IN s then f x else vec 0") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FUN_EQ_THM]) THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    SPEC_TAC (← q r"g:real^M->real^N", ← q r"f:real^M->real^N") THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP
      LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_CBALL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [LIM_NULL] THEN
    GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV o LAND_CONV o ABS_CONV)
     [← GSYM LIFT_DROP] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_NULL_COMPARISON) THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, IN_ELIM_THM, DIST_0, FORALL_LIFT] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [LIFT_DROP, NORM_LIFT, REAL_LT_01] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN REWRITE_TAC [DROP_CMUL] THEN
    ASM_SIMP_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div),
                  REAL_LE_RDIV_EQ, MEASURE_CBALL_POS] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x * y) <= z ==> y * x <= z")) THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NORM, ← GSYM NORM_MUL] THEN
    ASM_SIMP_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC, REAL_MUL_RINV,
                  REAL_LT_IMP_NZ, MEASURE_CBALL_POS] THEN
    SIMP_TAC [← GSYM INTEGRAL_CONST_GEN, MEASURABLE_CBALL, VECTOR_MUL_LID] THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) absolutely_integrable_on cball(x,e)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"interval[x - e % vec 1:real^M,x + e % vec 1]") THEN
      ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_CBALL] THEN
      REWRITE_TAC [SUBSET, IN_CBALL, IN_INTERVAL] THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT,
                   VECTOR_SUB_COMPONENT, REAL_MUL_RID, ← REAL_ARITH
                      (← q r"x - h <= y /\ y <= x + h <=> abs(x - y) <= h")] THEN
      REWRITE_TAC [dist, ← GSYM VECTOR_SUB_COMPONENT] THEN
      MESON_TAC [REAL_LE_TRANS, COMPONENT_LE_NORM],
      ASM_SIMP_TAC [← GSYM INTEGRAL_SUB, INTEGRABLE_ON_CONST, MEASURABLE_CBALL,
                    ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]] THEN
    MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
                  ABSOLUTELY_INTEGRABLE_SUB, ABSOLUTELY_INTEGRABLE_ON_CONST,
                  MEASURABLE_CBALL, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    REWRITE_TAC [LIFT_DROP, REAL_LE_REFL])

  let LEBESGUE_DENSITY_THEOREM_INTEGRAL_BALL ← prove
   r"!f:real^M->real^N s.
        (!a b. f absolutely_integrable_on (s INTER interval[a,b]))
        ==> ?k. negligible k /\
                !x. ~(x IN k)
                    ==> ((\e. inv(measure(ball(x,drop e))) %
                              integral (s INTER ball(x,drop e)) f)
                         --> (if x IN s then f x else vec 0))
                        (at (vec 0) within {t | &0 < drop t})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LEBESGUE_DENSITY_THEOREM_INTEGRAL_CBALL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, IN_ELIM_THM, FORALL_LIFT, LIFT_DROP] THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [DIST_0, NORM_LIFT, REAL_LT_01] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM CLOSURE_BALL, MEASURE_CLOSURE, BOUNDED_BALL,
                  NEGLIGIBLE_CONVEX_FRONTIER, CONVEX_BALL] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE_SET THEN
    ASM_SIMP_TAC [CLOSURE_BALL] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"sphere(x:real^M,e)") THEN REWRITE_TAC [NEGLIGIBLE_SPHERE] THEN
    REWRITE_TAC [← GSYM SPHERE_UNION_BALL] THEN SET_TAC [])

  let LEBESGUE_DENSITY_THEOREM_LIFT_CBALL ← prove
   r"!s:real^N->bool.
      lebesgue_measurable s
      ==> ?k. negligible k /\
              !x. ~(x IN k)
                  ==> ((\e. lift(measure(s INTER cball(x,drop e)) /
                                 measure(cball(x,drop e))))
                       --> (if x IN s then vec 1 else vec 0))
                      (at (vec 0) within {t | &0 < drop t})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"indicator(s:real^N->bool)", ← q r"(:real^N)"]
          LEBESGUE_DENSITY_THEOREM_INTEGRAL_CBALL) THEN
    REWRITE_TAC [IN_UNIV, INTER_UNIV] THEN
    ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_ON_INDICATOR] THEN
    ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                  MEASURABLE_INTERVAL] THEN
    REWRITE_TAC [indicator, INTEGRAL_RESTRICT_INTER] THEN
    ASM_SIMP_TAC [INTEGRAL_CONST_GEN, MEASURABLE_CBALL,
                  MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
    REWRITE_TAC [← GSYM LIFT_EQ_CMUL] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div, LIFT_CMUL])

  let LEBESGUE_DENSITY_THEOREM_LIFT_BALL ← prove
   r"!s:real^N->bool.
      lebesgue_measurable s
      ==> ?k. negligible k /\
              !x. ~(x IN k)
                  ==> ((\e. lift(measure(s INTER ball(x,drop e)) /
                                 measure(ball(x,drop e))))
                       --> (if x IN s then vec 1 else vec 0))
                      (at (vec 0) within {t | &0 < drop t})"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_DENSITY_THEOREM_LIFT_CBALL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC I [FUN_EQ_THM] THEN REWRITE_TAC [← GSYM FORALL_DROP] THEN
    X_GEN_TAC (← q r"e:real") THEN AP_TERM_TAC THEN BINOP_TAC THEN
    MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"sphere(x:real^N,e)") THEN
    REWRITE_TAC [NEGLIGIBLE_SPHERE] THEN
    REWRITE_TAC [← GSYM SPHERE_UNION_BALL] THEN SET_TAC [])

  pure { LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_CBALL,
         LEBESGUE_DENSITY_THEOREM_INTEGRAL_NORM_BALL,
         LEBESGUE_DENSITY_THEOREM_INTEGRAL_CBALL, LEBESGUE_DENSITY_THEOREM_INTEGRAL_BALL,
         LEBESGUE_DENSITY_THEOREM_LIFT_CBALL, LEBESGUE_DENSITY_THEOREM_LIFT_BALL }

/- ------------------------------------------------------------------------- -/
/- More refined form of "derivative is zero at a maximum or minimum"       -/
/- w.r.t. a Lebesgue measurable set of density 1.  (measure.ml 13138-13387) -/
/- ------------------------------------------------------------------------- -/

structure MSBF where
  DIFFERENTIAL_ZERO_MAXMIN_DENSITY : thm
  DIFFERENTIAL_ZERO_LEVELSET_DENSITY : thm
  NEGLIGIBLE_POINTS_OF_AMBIGUOUS_DERIVATIVE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBF [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSE : MSE) (BMSG : MSG) (BMSJ : MSJ) (BMSAS : MSAS) (BMSBE : MSBE) : ExceptT String IO MSBF := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURE_DIFF_SUBSET, .. } := BMSB
  let { MEASURABLE_SCALING, MEASURE_SCALING, .. } := BMSE
  let { MEASURABLE_OPEN, MEASURE_OPEN_POS_LT, .. } := BMSG
  let { MEASURABLE_BALL, MEASURE_BALL_POS, .. } := BMSJ
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { LEBESGUE_DENSITY_THEOREM_LIFT_BALL, .. } := BMSBE
  let { HAS_DERIVATIVE_COMPONENTWISE_WITHIN, HAS_DERIVATIVE_NEG, has_derivative_within,
        .. } := D.qderivatives
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { LINEAR_TO_REALS, .. } := D.qvec
  let { HAS_DERIVATIVE_SUB, .. } := D.ig.qderivatives
  let { CONTINUOUS_OPEN_PREIMAGE_UNIV, .. } := D.ig.qtopology
  let { REAL_LT_RMUL_EQ, .. } := D.ig.dv.qsession
  let { FORALL_DOT_EQ_0, .. } := D.ig.dv.qvec
  let { EVENTUALLY_AND, .. } := D.ig.dv.dg.qmetric
  let { tendsto, .. } := D.ig.dv.dg.qtopology2
  let { ASM_REAL_ARITH_TAC, GEN_GEOM_ORIGIN_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { BALL_SCALING, BOUNDED_INTER, CONTINUOUS_AT_LIFT_DOT, CONTINUOUS_CMUL,
        .. } := D.ig.dv.dg.pt.qtop
  let { CART_EQ, CONJ_ASSOC, CONTRAPOS_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, REAL_ABS_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_NEG2, REAL_LE_REFL, REAL_LT_01, REAL_LT_IMP_NZ,
        REAL_LT_LDIV_EQ, REAL_LT_LMUL, REAL_LT_LMUL_EQ, REAL_LT_MUL_EQ, REAL_LT_RDIV_EQ,
        REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID,
        REAL_MUL_RZERO, REAL_MUL_SYM, REAL_POW_2, REAL_SUB_LT, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, real_gt, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_0, DIST_LIFT, DIST_NZ, DIST_SYM, DOT_POS_LT, DOT_RMUL, DOT_RZERO,
        .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_EQ, DROP_SUB, DROP_VEC, FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        LIFT_SUB, LINEAR_0, NORM_0, NORM_1, NORM_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LT, NORM_POW_2, REAL_ABS_NORM,
        .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VEC_COMPONENT, VECTOR_MUL_LCANCEL, VECTOR_MUL_RZERO, VECTOR_NEG_EQ_0,
        VECTOR_SUB_EQ, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_TRUE, .. } := D.ig.dv.dg.pt.cvx.met
  let { BOUNDED_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_AT_LIFT_NORM, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_SUB, EVENTUALLY_WITHIN, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL, IN_BALL_0, LIM_WITHIN, OPEN_BALL, OPEN_HALFSPACE_COMPONENT_GT,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTER, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let DIFFERENTIAL_ZERO_MAXMIN_DENSITY ← (do
    let lemma ← prove
     r"!k a d:real^N.
        &0 < k /\ k < &1 /\ ~(d = vec 0)
        ==> ?e. &0 < e /\
                !r. &0 < r
                    ==> measurable({x | d dot (x - a) > k * norm d * norm(x - a)}
                                   INTER ball(a,r)) /\
                        e * measure(ball(a,r))
                        <= measure({x | d dot (x - a) > k * norm d * norm(x - a)}
                                   INTER ball(a,r))"
     (REPEAT GEN_TAC THEN GEN_GEOM_ORIGIN_TAC (← q r"a:real^N") ["d"] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_SUB_RZERO] THEN
      EXISTS_TAC (← q r"measure({x:real^N | d dot x > k * norm d * norm x}
                          INTER ball(vec 0,&1)) /
                  measure(ball(vec 0:real^N,&1))") THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(a / b) * c:real = (a * c) / b")] THEN
      SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ,
                REAL_LT_01, MEASURE_BALL_POS] THEN
      SUBGOAL_THEN
       (← q r"open({x:real^N | d dot x > k * norm d * norm x} INTER ball(vec 0,&1))")
      ASSUME_TAC THENL
       [MATCH_MP_TAC OPEN_INTER THEN REWRITE_TAC [OPEN_BALL, real_gt] THEN
        ONCE_REWRITE_TAC [← MESON [REAL_SUB_LT, LIFT_DROP]
          (← q r"x < y <=> &0 < drop(lift(y - x))")] THEN
        ONCE_REWRITE_TAC [← SET_RULE
         (← q r"{x | &0 < drop(f x)} = {x | f x IN {y | &0 < drop y}}")] THEN
        MATCH_MP_TAC CONTINUOUS_OPEN_PREIMAGE_UNIV THEN
        REWRITE_TAC [drop, ← REWRITE_RULE [real_gt] OPEN_HALFSPACE_COMPONENT_GT] THEN
        REWRITE_TAC [LIFT_SUB, LIFT_CMUL] THEN GEN_TAC THEN
        MATCH_MP_TAC CONTINUOUS_SUB THEN
        REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_AT_LIFT_DOT] THEN
        REPEAT (MATCH_MP_TAC CONTINUOUS_CMUL) THEN
        REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_AT_LIFT_NORM],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [REAL_MUL_LZERO] THEN MATCH_MP_TAC MEASURE_OPEN_POS_LT THEN
        ASM_SIMP_TAC [BOUNDED_INTER, BOUNDED_BALL] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        EXISTS_TAC (← q r"(k + &1) / &2 % inv(norm d) % d:real^N") THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM, IN_BALL_0, DOT_RMUL] THEN
        REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
        REWRITE_TAC [← REAL_ARITH
         (← q r"e * inv d * p > k * d * q <=> q * k * d < (e * p) / d")] THEN
        ASM_SIMP_TAC [REAL_LT_RDIV_EQ, NORM_POS_LT, ← GSYM REAL_MUL_ASSOC] THEN
        REWRITE_TAC [← GSYM REAL_POW_2, NORM_POW_2] THEN
        ASM_SIMP_TAC [REAL_LT_RMUL_EQ, REAL_MUL_ASSOC, DOT_POS_LT] THEN
        ASM_SIMP_TAC [REAL_MUL_RID, ← REAL_ARITH
         (← q r"&0 < k ==> abs((k + &1) / &2) = (k + &1) / &2")] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
        MATCH_MP_TAC REAL_LT_LMUL THEN ASM_REAL_ARITH_TAC,
        X_GEN_TAC (← q r"r:real") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"ball(vec 0:real^N,r) = ball(r % vec 0,r * &1)")
        SUBST1_TAC THENL [SIMP_TAC [VECTOR_MUL_RZERO, REAL_MUL_RID], ALL_TAC] THEN
        ASM_SIMP_TAC [BALL_SCALING, MEASURE_SCALING, MEASURABLE_BALL] THEN
        SUBGOAL_THEN
         (← q r"{x:real^N | d dot x > k * norm d * norm x} INTER
          IMAGE (\x. r % x) (ball (vec 0,&1)) =
          IMAGE (\x. r % x)
                ({x:real^N | d dot x > k * norm d * norm x} INTER ball(vec 0,&1))")
        SUBST1_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"(!x y. f x = f y ==> x = y) /\ (!x. f x IN s <=> x IN s)
            ==> s INTER IMAGE f t = IMAGE f (s INTER t)")) THEN
          ASM_SIMP_TAC [VECTOR_MUL_LCANCEL, REAL_LT_IMP_NZ, IN_ELIM_THM] THEN
          ASM_SIMP_TAC [DOT_RMUL, NORM_MUL, REAL_LT_LMUL_EQ, ← REAL_ARITH
           (← q r"&0 < r
            ==> (r * d > g * e * abs r * f <=> r * g * e * f < r * d)")] THEN
          REAL_ARITH_TAC,
          ALL_TAC] THEN
        ASM_SIMP_TAC [MEASURABLE_SCALING, MEASURE_SCALING,
                      MEASURABLE_OPEN, BOUNDED_INTER, BOUNDED_BALL] THEN
        REWRITE_TAC [REAL_MUL_AC, REAL_LE_REFL]])
    prove
     r"!f f' s a:real^N.
          (f has_derivative f') (at a within s) /\
          (eventually (\x. drop(f a) <= drop(f x)) (at a within s) \/
           eventually (\x. drop(f x) <= drop(f a)) (at a within s)) /\
          lebesgue_measurable s /\
          ((\e. lift(measure(s INTER ball(a,drop e)) / measure(ball(a,drop e))))
           --> vec 1)
          (at (vec 0) within {t | &0 < drop t})
          ==> f' = \v. vec 0"
     (SUBGOAL_THEN
       (← q r"!f f' s a:real^N.
            (f has_derivative f') (at a within s) /\
            eventually (\x. drop(f x) <= drop(f a)) (at a within s) /\
            lebesgue_measurable s /\
            ((\e. lift(measure(s INTER ball(a,drop e)) / measure(ball(a,drop e))))
             --> vec 1)
            (at (vec 0) within {t | &0 < drop t})
            ==> f' = \v. vec 0")
      ASSUME_TAC THENL
       [ALL_TAC,
        REPEAT STRIP_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"(--) o (f:real^N->real^1)", ← q r"(--) o (f':real^N->real^1)"]),
           FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"f:real^N->real^1", ← q r"f':real^N->real^1"])] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"a:real^N"]) THEN
        ASM_SIMP_TAC [HAS_DERIVATIVE_NEG, o_DEF, DROP_NEG, REAL_LE_NEG2] THEN
        REWRITE_TAC [FUN_EQ_THM, VECTOR_NEG_EQ_0]] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [has_derivative_within, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [tendsto] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!e. &0 < e ==> P e) /\ Q ==> !e. &0 < e ==> P e /\ Q"))) THEN
      REWRITE_TAC [← GSYM EVENTUALLY_AND, DIST_0, NORM_MUL, REAL_ABS_INV] THEN
      REWRITE_TAC [REAL_ABS_NORM] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"!e. &0 < e
            ==> eventually (\x. drop(f'(x - a:real^N)) <= e * norm(x - a))
                           (at a within s)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        X_GEN_TAC (← q r"x:real^N") THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
        ASM_CASES_TAC (← q r"x:real^N = a") THENL
         [ASM_REWRITE_TAC [VECTOR_SUB_REFL] THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (REWRITE_TAC [← MATCH_MP LINEAR_0 th])) THEN
          REWRITE_TAC [DROP_VEC, NORM_0, REAL_MUL_RZERO, REAL_LE_REFL],
          ASM_SIMP_TAC [REAL_LT_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
          REWRITE_TAC [NORM_1, DROP_SUB, DROP_ADD] THEN REAL_ARITH_TAC],
        FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"&0:real"))] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_TO_REALS) THEN
      ABBREV_TAC (← q r"d = row 1 (matrix(f':real^N->real^1))") THEN
      DISCH_THEN SUBST1_TAC THEN
      REPEAT (FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
         check (HolCore.Basics.free_in (← q r"f':real^N->real^1") o concl))) THEN
      REWRITE_TAC [FUN_EQ_THM, ← GSYM DROP_EQ, LIFT_DROP, DROP_VEC] THEN
      REWRITE_TAC [FORALL_DOT_EQ_0] THEN
      GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o GEN (← q r"e:real") o SPEC (← q r"e * norm(d:real^N)")) THEN
      ASM_SIMP_TAC [REAL_LT_MUL_EQ, NORM_POS_LT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"&1 / &2")) THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      MP_TAC (← ISPECL [← q r"&1 / &2", ← q r"a:real^N", ← q r"d:real^N"] lemma) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_WITHIN]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_ELIM_THM, FORALL_LIFT, LIFT_DROP, DIST_0] THEN
      REWRITE_TAC [DIST_LIFT, ← GSYM LIFT_NUM, NORM_LIFT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"R:real") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [EVENTUALLY_WITHIN, ← GSYM DIST_NZ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
      ABBREV_TAC (← q r"r = min R k / &2") THEN
      SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:real"))) THEN ASM_REWRITE_TAC [] THEN
      REPEAT DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"m <= &1 - e ==> abs(m - &1) < e ==> F")) THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, MEASURE_BALL_POS] THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"y <= m - x ==> e * m <= x ==> y <= (&1 - e) * m")) THEN
      ASM_SIMP_TAC [← GSYM MEASURE_DIFF_SUBSET, MEASURABLE_BALL, INTER_SUBSET] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_BALL,
                    MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTER, MEASURABLE_BALL] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s /\ x IN b ==> ~(x IN h))
        ==> s INTER b SUBSET b DIFF (h INTER b)")) THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_BALL] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"x:real^N = a") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, DOT_RZERO, NORM_0, real_gt] THEN
      REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_REFL] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
      ASM_REAL_ARITH_TAC))

  let DIFFERENTIAL_ZERO_LEVELSET_DENSITY ← prove
   r"!f:real^M->real^N f' s a c.
        (f has_derivative f') (at a within s) /\
        eventually (\x. f x = c) (at a within s) /\
        lebesgue_measurable s /\
        ((\e. lift
              (measure (s INTER ball (a,drop e)) /
               measure (ball (a,drop e)))) -->
         vec 1)
        (at (vec 0) within {t | &0 < drop t})
        ==> f' = \h. vec 0"
   (ONCE_REWRITE_TAC [HAS_DERIVATIVE_COMPONENTWISE_WITHIN] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!i. 1 <= i /\ i <= dimindex(:N)
                      ==> (\x. lift((f':real^M->real^N) x$i)) = (\x. vec 0)")
    MP_TAC THENL
     [ALL_TAC,
      SIMP_TAC [FUN_EQ_THM, ← GSYM DROP_EQ, LIFT_DROP, DROP_VEC] THEN
      SIMP_TAC [CART_EQ, VEC_COMPONENT]] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC DIFFERENTIAL_ZERO_MAXMIN_DENSITY THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x. lift((f:real^M->real^N) x$i)", ← q r"s:real^M->bool", ← q r"a:real^M"] THEN
    ASM_SIMP_TAC [LIFT_DROP] THEN
    ASM_CASES_TAC (← q r"(c:real^N)$i <= (f:real^M->real^N) a$i") THENL
     [DISJ2_TAC, DISJ1_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
    ASM_SIMP_TAC [] THEN ASM_REAL_ARITH_TAC)

  let NEGLIGIBLE_POINTS_OF_AMBIGUOUS_DERIVATIVE ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s
        ==> negligible
             {x | x IN s /\ ?y z. (f has_derivative y) (at x within s) /\
                                  (f has_derivative z) (at x within s) /\
                                  ~(y = z)}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC
     (← q r"{x:real^M | x IN s /\
                  ~(((\e. lift(measure(s INTER ball(x,drop e)) /
                               measure(ball(x,drop e)))) -->
                    vec 1) (at (vec 0) within {t | &0 < drop t}))}") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP LEBESGUE_DENSITY_THEOREM_LIFT_BALL) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool")
       (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ ~q ==> r <=> p ==> ~r ==> q")] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
      MATCH_MP_TAC (← TAUT (← q r"(p ==> r ==> ~q) ==> p /\ q ==> p /\ ~r")) THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN REPEAT DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f':real^M->real^N", ← q r"f'':real^M->real^N"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [FUN_EQ_THM] THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
      GEN_REWRITE_TAC I [← GSYM FUN_EQ_THM] THEN
      MATCH_MP_TAC DIFFERENTIAL_ZERO_LEVELSET_DENSITY THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\x. (f:real^M->real^N) x - f x",
        ← q r"s:real^M->bool", ← q r"x:real^M", ← q r"vec 0:real^N"] THEN
      ASM_SIMP_TAC [HAS_DERIVATIVE_SUB] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, EVENTUALLY_TRUE]])

  pure { DIFFERENTIAL_ZERO_MAXMIN_DENSITY, DIFFERENTIAL_ZERO_LEVELSET_DENSITY,
         NEGLIGIBLE_POINTS_OF_AMBIGUOUS_DERIVATIVE }
/- ------------------------------------------------------------------------- -/
/- Countably many disjoint sets of positive measure; Wiener and Vitali     -/
/- covering lemmas.  (measure.ml 13388-13752)                               -/
/- ------------------------------------------------------------------------- -/

structure MSBG where
  PAIRWISE_DISJOINT_LEBESGUE_MEASURABLE_IMP_COUNTABLE : thm
  WIENER_COVERING_LEMMA_BALLS : thm
  WIENER_COVERING_LEMMA_CBALLS : thm
  VITALI_COVERING_LEMMA_CBALLS_BALLS : thm
  VITALI_COVERING_LEMMA_CBALLS : thm
  VITALI_COVERING_LEMMA_BALLS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBG [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSAS : MSAS) : ExceptT String IO MSBG := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS, MEASURE_NEGLIGIBLE_UNIONS_IMAGE,
        .. } := BMSB
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { NEGLIGIBLE_ON_COUNTABLE_INTERVALS, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { COUNTABLE_CROSS, NUM_COUNTABLE, .. } := D.qcard
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { ZL_SUBSETS_UNIONS, .. } := D.qwo
  let { ADD_EQ_0, DISJOINT_EMPTY_REFL, EXP_EQ_0, FORALL_IN_CROSS, MULT_EQ_0,
        PAIRWISE_CHAIN_UNIONS, PAIRWISE_EMPTY, PAIRWISE_UNION, REAL_LET_ANTISYM,
        .. } := D.qsession
  let { COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS, .. } := D.qtopology1
  let { COUNTABLE_IMAGE_INJ_EQ, COUNTABLE_SUBSET, COUNTABLE_UNIONS, .. } := D.ig.qcard
  let { IN_CROSS, .. } := D.ig.qsession
  let { ARCH_EVENTUALLY_INV1, .. } := D.ig.dv.qmetric
  let { REAL_POW_MONO_INV, .. } := D.ig.dv.qsession
  let { WF_INDUCT_TAC, .. } := D.ig.dv.dg.pt
  let { ADD_SUB, DEPENDENT_CHOICE, TRANSITIVE_STEPWISE_LE, UNIONS_MONO_IMAGE,
        .. } := D.ig.dv.dg.qsession
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_IMP_COUNTABLE, .. } := D.ig.dv.dg.pt.qcard
  let { ARITH_EQ, CARD_EQ_0, CARD_PSUBSET, CHOOSE_SUBSET_STRONG, CONTRAPOS_THM, DISJOINT,
        EMPTY_SUBSET, EMPTY_UNIONS, EXISTS_PAIR_THM, EXTENSION, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_RESTRICT, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FORALL_IN_UNION, HAS_SIZE, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, IN_UNIV, LE_REFL, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, PAIRWISE_IMP,
        PAIRWISE_INSERT, REAL_ARCH_POW_INV, REAL_DIV_1, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_INV_POW, REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NOT_LT, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LE, REAL_OF_NUM_MUL, REAL_OF_NUM_POW, SUBSET, SUBSET_EMPTY,
        SUBSET_RESTRICT, SUBSET_TRANS, SUBSET_UNION, .. } := D.ig.dv.dg.pt.cvx.core5
  let { pairwise, real_div, real_pow, SUM_CONST, SUM_LT_ALL, SUP_FINITE, SWAP_EXISTS_THM,
        UNIONS_IMAGE, UNIONS_INSERT, UNIONS_SUBSET, UNIONS_UNION, UNWIND_THM2, WLOG_LE,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { VEC_COMPONENT, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
