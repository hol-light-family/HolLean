  let (ABSOLUTELY_INTEGRABLE_CONVOLUTION_AE, HAS_DOUBLE_INTEGRAL_CONVOLUTION) ←
   CONJ_PAIR (← prove
   r"(!bop:real^N->real^P->real^Q f:real^M->real^N g:real^M->real^P.
        bilinear bop /\
        f absolutely_integrable_on (:real^M) /\
        g absolutely_integrable_on (:real^M)
        ==> ?t. negligible t /\
                !x. ~(x IN t)
                    ==> (\y. bop (f(x - y)) (g y))
                        absolutely_integrable_on (:real^M)) /\
     (!bop:real^N->real^P->real^Q f:real^M->real^N g:real^M->real^P.
        bilinear bop /\
        f absolutely_integrable_on (:real^M) /\
        g absolutely_integrable_on (:real^M)
        ==> ((\x. integral (:real^M) (\y. bop (f(x - y)) (g y))) has_integral
             bop (integral (:real^M) f) (integral (:real^M) g)) (:real^M))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    STRIP_TAC THEN
