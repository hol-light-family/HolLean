      ONCE_REWRITE_TAC [← TAUT (← q r"closed_in a b /\ c <=> ~(closed_in a b ==> ~c)")] THEN
      SIMP_TAC [← ISPEC (← q r"euclidean") CLOSED_IN_IMP_SUBSET,
                ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
      REWRITE_TAC [NOT_IMP] THEN DISCH_THEN MATCH_MP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"c:num->real^M->bool", ← q r"{n:num | n <= k}"] THEN
      REWRITE_TAC [FORALL_IN_UNIONS] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [CLOSED_SUBSET_EQ, COMPACT_IMP_CLOSED, UNIONS_GSPEC] THEN
      SIMP_TAC [FINITE_RESTRICT, FINITE_NUMSEG_LE] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← MESON [OPEN_IN_REFL]
       (← q r"P(s:real^N->bool)
        ==> ?t. open_in (subtopology euclidean s) t /\ P t")) THEN
      ASM SET_TAC [],
      REWRITE_TAC [LE, UNIONS_GSPEC] THEN SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              NEGLIGIBLE_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_DIFF, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      MESON_TAC [LE_REFL]])

  let PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN ← prove
   r"!f:real^M->real^N s.
        f measurable_on s
        ==> ((!t. lebesgue_measurable t /\ t SUBSET s
                  ==> lebesgue_measurable (IMAGE f t)) <=>
             (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE,
                 NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
      DISCH_TAC THEN X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"t:real^M->bool"]
          LUZIN_SIGMA) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:real^M->real^N) t =
      IMAGE f (UNIONS u) UNION IMAGE f (t DIFF UNIONS u)")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN CONJ_TAC THENL
     [REWRITE_TAC [IMAGE_UNIONS] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [COMPACT_CONTINUOUS_IMAGE, LEBESGUE_MEASURABLE_COMPACT],
      MATCH_MP_TAC NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let LEBESGUE_MEASURABLE_PREIMAGE_CARD_LE ← prove
   r"!f:real^M->real^N s n.
        f measurable_on s /\ lebesgue_measurable s /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
        ==> lebesgue_measurable
              {y | FINITE {x | x IN s /\ f x = y} /\
                   CARD {x | x IN s /\ f x = y} <= n}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] LUZIN_SIGMA_NESTED) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:num->real^M->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF THEN EXISTS_TAC
     (← q r"{y | FINITE(UNIONS {{x | x IN c k /\ f x = (y:real^N)} | k IN (:num)}) /\
       CARD(UNIONS {{x:real^M | x IN c k /\ f x = y} | k IN (:num)}) <= n}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← MESON []
       (← q r"!s:real^M->bool.
           lebesgue_measurable s /\ s = t ==> lebesgue_measurable t")) THEN
      EXISTS_TAC
       (← q r"INTERS {{y | FINITE {x | x IN c k /\ (f:real^M->real^N) x = y} /\
                   CARD {x | x IN c k /\ (f:real^M->real^N) x = y} <= n} |
              k IN (:num)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT THEN
        X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC GDELTA_IMP_LEBESGUE_MEASURABLE THEN
        MATCH_MP_TAC GDELTA_PREIMAGE_CARD_LE THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_FSIGMA],
        REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
          GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC CARD_LE_UNIONS_CHAIN THEN
          ASM_REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
          MATCH_MP_TAC WLOG_LE THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"!m n. m <= n ==> (c:num->real^M->bool) m SUBSET c n")
          MP_TAC THENL [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE, SET_TAC []] THEN
          ASM_REWRITE_TAC [] THEN SET_TAC [],
          REWRITE_TAC [SUBSET_INTERS, FORALL_IN_GSPEC] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIV] THEN REPEAT GEN_TAC THEN
          MATCH_MP_TAC (← MESON [FINITE_SUBSET, CARD_SUBSET, LE_TRANS]
           (← q r"s SUBSET t
            ==> FINITE t /\ CARD t <= n ==> FINITE s /\ CARD s <= n")) THEN
          REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC []]],
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N)
                        (s DIFF UNIONS {c n | n IN (:num)} )") THEN
      ASM_SIMP_TAC [SUBSET_DIFF] THEN
      MATCH_MP_TAC (← SET_RULE
      (← q r"(!y. ~(P y <=> Q y) ==> y IN t)
       ==> ({y | P y} DIFF {y | Q y}) UNION ({y | Q y} DIFF {y | P y})
           SUBSET t")) THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"~(FINITE(f y) /\ CARD(f y) <= n <=> FINITE(g y) /\ CARD(g y) <= n)
        ==> ~(f y = g y)"))) THEN
      REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []])

  let LEBESGUE_MEASURABLE_PREIMAGE_HAS_SIZE ← prove
   r"!f:real^M->real^N s n.
        f measurable_on s /\ lebesgue_measurable s /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
        ==> lebesgue_measurable {y | {x | x IN s /\ f x = y} HAS_SIZE n}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_SIZE] THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LEBESGUE_MEASURABLE_PREIMAGE_CARD_LE) THEN
    ASM_REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"n = 0") THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"0")) THEN ASM_REWRITE_TAC [LE],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"n - 1") th) THEN MP_TAC (← SPEC (← q r"n:num") th))) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP LEBESGUE_MEASURABLE_DIFF) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN REWRITE_TAC [HAS_SIZE] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
    ASM_CASES_TAC (← q r"FINITE  {x | x IN s /\ (f:real^M->real^N) x = y}") THEN
    ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC)

  let LEBESGUE_MEASURABLE_PREIMAGE_FINITE ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\ lebesgue_measurable s /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
        ==> lebesgue_measurable {y | FINITE {x | x IN s /\ f x = y}}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LEBESGUE_MEASURABLE_PREIMAGE_HAS_SIZE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o
      MATCH_MP LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [HAS_SIZE, UNIONS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
    MESON_TAC [])

  let LEBESGUE_MEASURABLE_PREIMAGE_INFINITE ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\ lebesgue_measurable s /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
        ==> lebesgue_measurable {y | INFINITE {x | x IN s /\ f x = y}}"
   (REWRITE_TAC [INFINITE, ← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL,
                 LEBESGUE_MEASURABLE_PREIMAGE_FINITE])

  let MEASURABLE_ON_BANACH_INDICATRIX ← prove
   r"!f:real^M->real^N s c.
        f measurable_on s /\ lebesgue_measurable s /\
        (!t. t SUBSET s /\ negligible t ==> negligible (IMAGE f t))
        ==> (\y. if FINITE {x | x IN s /\ f x = y}
                 then lift(&(CARD{x | x IN s /\ f x = y}))
                 else c) measurable_on (:real^N)"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LE,
              LEBESGUE_MEASURABLE_UNIV] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP, IN_UNIV] THEN
    X_GEN_TAC (← q r"a:real") THEN
    REPLICATE_TAC 2 (ONCE_REWRITE_TAC [COND_RAND]) THEN
    ONCE_REWRITE_TAC [COND_RATOR] THEN REWRITE_TAC [LIFT_DROP] THEN
    ASM_CASES_TAC (← q r"drop c <= a") THEN
    ASM_REWRITE_TAC [← MESON [] (← q r"(if p then x else F) <=> p /\ x"),
                     ← MESON [] (← q r"(if p then x else T) <=> ~p \/ p /\ x")]
    THENL
     [ONCE_REWRITE_TAC [← SET_RULE
       (← q r"{x | ~P x \/ Q x} = (UNIV DIFF {x | P x}) UNION {x | Q x}")] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPL,
                    LEBESGUE_MEASURABLE_PREIMAGE_FINITE],
      ALL_TAC] THEN
    (ASM_CASES_TAC (← q r"a < &0") THEN
     ASM_SIMP_TAC [← REAL_ARITH (← q r"a < &0 ==> ~(&n <= a)")] THEN
     REWRITE_TAC [LEBESGUE_MEASURABLE_EMPTY, EMPTY_GSPEC] THEN
     RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT]) THEN
     SUBGOAL_THEN (← q r"!n. &n <= a <=> &n <= floor a")
      (fun th => ONCE_REWRITE_TAC [th])
     THENL [ASM_MESON_TAC [REAL_LE_FLOOR, INTEGER_CLOSED], ALL_TAC] THEN
     FIRST_ASSUM (X_CHOOSE_THEN (← q r"n:num") SUBST1_TAC o MATCH_MP FLOOR_POS) THEN
     REWRITE_TAC [REAL_OF_NUM_LE] THEN
     MATCH_MP_TAC LEBESGUE_MEASURABLE_PREIMAGE_CARD_LE THEN
     ASM_REWRITE_TAC []))

  pure { LUZIN_SIGMA_NESTED, PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN,
         LEBESGUE_MEASURABLE_PREIMAGE_CARD_LE, LEBESGUE_MEASURABLE_PREIMAGE_HAS_SIZE,
         LEBESGUE_MEASURABLE_PREIMAGE_FINITE, LEBESGUE_MEASURABLE_PREIMAGE_INFINITE,
         MEASURABLE_ON_BANACH_INDICATRIX }
/- ------------------------------------------------------------------------- -/
/- A measurable subset on which a function is injective, and approximate    -/
/- variants.  (measure.ml 16377-16525)                                      -/
/- ------------------------------------------------------------------------- -/

structure MSBO where
  LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY : thm
  BOREL_DOMAIN_OF_INJECTIVITY : thm
  GDELTA_DOMAIN_OF_INJECTIVITY_MEASURABLE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBO [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSF : MSF) (BMSG : MSG) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAP : MSAP) (BMSAS : MSAS) (BMSBM : MSBM) (BMSBN : MSBN) : ExceptT String IO MSBO := do
  -- @@SCOPE BEGIN
  let { MEASURE_EQ_0, .. } := BMSB
  let { HAS_MEASURE_NESTED_INTERS, .. } := BMSF
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { BOREL_IMP_LEBESGUE_MEASURABLE, GDELTA_IMP_LEBESGUE_MEASURABLE,
        LEBESGUE_MEASURABLE_COMPACT, LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_INSERT,
        LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_OPEN, .. } := BMSAP
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { LUZIN_SIGMA, .. } := BMSBM
  let { LUZIN_SIGMA_NESTED, PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN,
        .. } := BMSBN
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN, .. } := D.qtopology1
  let { GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS, .. } := D.qtopology2
  let { OPEN_DELETE, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_SYM, EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_UNION, IMP_CONJ, INJECTIVE_ON_ALT, INTERS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_IMAGE, LE_REFL, MONO_EXISTS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_SUB_RZERO, SKOLEM_THM, SUBSET_DIFF, SUBSET_REFL, SUBSET_RESTRICT,
        SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { BOUNDED_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, .. } := D.ig.dv.dg.pt.cvx.top2
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY ← prove
   r"!f:real^M->real^N s.
        f measurable_on s
        ==> ?t. lebesgue_measurable t /\ t SUBSET s /\
                IMAGE f t = IMAGE f s /\
                !x y. x IN t /\ y IN t /\ f x = f y ==> x = y"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N s.
          f measurable_on s /\ lebesgue_measurable s
          ==> ?t. lebesgue_measurable t /\ t SUBSET s /\
                  IMAGE f t = IMAGE f s /\
                  !x y. x IN t /\ y IN t /\ f x = f y ==> x = y")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] LUZIN_SIGMA) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"u:(real^M->bool)->bool"]
            BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN) THEN
      ASM_SIMP_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^M->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!y. ?x. y IN IMAGE f s DIFF IMAGE f (UNIONS u)
                ==> x IN s DIFF UNIONS u /\ (f:real^M->real^N) x = y")
      MP_TAC THENL [SET_TAC [], REWRITE_TAC [SKOLEM_THM]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC
       (← q r"b UNION IMAGE (g:real^N->real^M)
                      (IMAGE (f:real^M->real^N) s DIFF IMAGE f (UNIONS u))") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF THEN
        EXISTS_TAC (← q r"b:real^M->bool") THEN
        ASM_SIMP_TAC [BOREL_IMP_LEBESGUE_MEASURABLE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                NEGLIGIBLE_SUBSET)) THEN
        ASM SET_TAC [],
        ASM SET_TAC [],
        ABBREV_TAC (← q r"v:real^M->bool = UNIONS u") THEN
        ASM_REWRITE_TAC [IMAGE_UNION] THEN ASM SET_TAC [],
        ABBREV_TAC (← q r"v:real^M->bool = UNIONS u") THEN ASM SET_TAC []],
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"lebesgue_measurable {x | x IN s /\ ~((f:real^M->real^N) x = vec 0)}")
      ASSUME_TAC THENL
       [FIRST_ASSUM (MP_TAC o SPEC (← q r"(:real^N) DELETE (vec 0)") o
            GEN_REWRITE_RULE I [MEASURABLE_ON_PREIMAGE_OPEN] o
            GEN_REWRITE_RULE I [← GSYM MEASURABLE_ON_UNIV]) THEN
        SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o ISPECL
       [← q r"f:real^M->real^N",
        ← q r"{x | x IN s /\ ~((f:real^M->real^N) x = vec 0)}"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_RESTRICT],
        REWRITE_TAC [← SET_RULE
         (← q r"IMAGE f {x | x IN s /\ ~(f x = a)} = IMAGE f s DELETE a")]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
      ASM_CASES_TAC (← q r"vec 0 IN IMAGE (f:real^M->real^N) s") THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_IMAGE]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^M") (STRIP_ASSUME_TAC o GSYM)) THEN
        EXISTS_TAC (← q r"(a:real^M) INSERT t") THEN
        ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_INSERT] THEN ASM SET_TAC [],
        EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
        ASM SET_TAC []]])

  let BOREL_DOMAIN_OF_INJECTIVITY ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\ lebesgue_measurable s /\
        (!n. n SUBSET s /\ negligible n ==> negligible(IMAGE f n))
        ==> ?t. borel t /\ t SUBSET s /\
                negligible(IMAGE f s DIFF IMAGE f t) /\
                !x y. x IN t /\ y IN t /\ f x = f y ==> x = y"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] LUZIN_SIGMA) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"u:(real^M->bool)->bool"]
          BOREL_DOMAIN_OF_INJECTIVITY_CONTINUOUS_GEN) THEN
    ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (s DIFF UNIONS u)") THEN
    ASM_SIMP_TAC [SUBSET_DIFF] THEN ASM SET_TAC [])

  let GDELTA_DOMAIN_OF_INJECTIVITY_MEASURABLE ← prove
   r"!f:real^M->real^N s u e.
        f measurable_on s /\ lebesgue_measurable s /\ &0 < e /\
        IMAGE f s SUBSET u /\ measurable u /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
        ==> ?t. t SUBSET s /\ gdelta t /\ bounded t /\ measurable t /\
                measurable(IMAGE f t) /\
                measure(IMAGE f s DIFF IMAGE f t) < e /\
                (!x y. x IN t /\ y IN t /\ f x = f y ==> x = y)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LUZIN_SIGMA_NESTED) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:num->real^M->bool") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
      PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"\n:num. IMAGE (f:real^M->real^N) s DIFF IMAGE f (k n)")
          HAS_MEASURE_NESTED_INTERS) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [X_GEN_TAC (← q r"n:num"), ASM SET_TAC []] THEN
      MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [SUBSET_REFL, LEBESGUE_MEASURABLE_COMPACT],
      DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
    SUBGOAL_THEN
     (← q r"measure(INTERS {IMAGE (f:real^M->real^N) s DIFF IMAGE f (k n) |
                      n IN (:num)}) = &0")
    SUBST1_TAC THENL
     [MATCH_MP_TAC MEASURE_EQ_0 THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N)
                        (s DIFF UNIONS {k n | n IN (:num)})") THEN
      ASM_SIMP_TAC [SUBSET_DIFF] THEN
      REWRITE_TAC [INTERS_GSPEC, UNIONS_GSPEC] THEN ASM SET_TAC [],
      REWRITE_TAC [LIM_SEQUENTIALLY, DIST_LIFT]] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [REAL_SUB_RZERO, LE_REFL] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(k:num->real^M->bool) n"]
          GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [BOUNDED_SUBSET, COMPACT_IMP_BOUNDED],
      MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"(k:num->real^M->bool) n") THEN
      ASM_SIMP_TAC [GDELTA_IMP_LEBESGUE_MEASURABLE, MEASURABLE_COMPACT],
      ASM_SIMP_TAC [MEASURABLE_COMPACT, COMPACT_CONTINUOUS_IMAGE],
      ASM_SIMP_TAC [← REAL_ARITH (← q r"abs x < e ==> x < e")],
      ASM_SIMP_TAC [],
      ASM_MESON_TAC [SUBSET_TRANS]])

  pure { LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY, BOREL_DOMAIN_OF_INJECTIVITY,
         GDELTA_DOMAIN_OF_INJECTIVITY_MEASURABLE }
/- ------------------------------------------------------------------------- -/
/- Relations between image measure sizes and preimage cardinality (Banach). -/
/- (measure.ml 16526-16757)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBP where
  LUZIN_NPROPERTY_IMP_COUNTABLE_PREIMAGES : thm
  BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER : thm
  BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBP [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBC : MSBC) (BMSBM : MSBM) : ExceptT String IO MSBP := do
  -- @@SCOPE BEGIN
  let { MEASURE_DISJOINT_UNION, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_MEASURE_EQ_0, MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { NEGLIGIBLE_OUTER, .. } := BMSC
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { GDELTA_IMP_LEBESGUE_MEASURABLE, LEBESGUE_MEASURABLE_COMPACT,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT, LEBESGUE_MEASURABLE_DIFF,
        LEBESGUE_MEASURABLE_UNION, MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSBC
  let { LUZIN_SIGMA, .. } := BMSBM
  let { NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS, .. } := D.qtopology2
  let { COUNTABLE_EMPTY, COUNTABLE_SUBSET, COUNTABLE_UNIONS, .. } := D.ig.qcard
  let { ARCH_EVENTUALLY_INV1, .. } := D.ig.dv.qmetric
  let { ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_IMP_COUNTABLE, .. } := D.ig.dv.dg.pt.qcard
  let { CONTRAPOS_THM, EXISTS_IN_GSPEC, FINITE_SING, FINITE_SUBSET, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM,
        NOT_IMP, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_DIFF, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUP, UNIONS_GSPEC, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNION, .. } := D.ig.dv.dg.pt.cvx.lib
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  -- @@SCOPE END

  let LUZIN_NPROPERTY_IMP_COUNTABLE_PREIMAGES ← (do
    let lemma ← prove
     r"!f:real^M->real^N s.
            lebesgue_measurable s /\ f measurable_on s /\
            (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
            ==> ?t. t SUBSET s /\ lebesgue_measurable t /\
                    negligible(IMAGE f s DIFF IMAGE f t) /\
                    !y. COUNTABLE {x | x IN t /\ f x = y}"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
            LUZIN_SIGMA) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:(real^M->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!k. k IN u ==> ?k'. measurable k' /\ k' SUBSET k /\
                            IMAGE f k' = IMAGE f k /\
                            !y. FINITE {x | x IN k' /\ (f:real^M->real^N) x = y}")
      MP_TAC THENL
       [X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"k:real^M->bool"]
          GDELTA_DOMAIN_OF_INJECTIVITY_CONTINUOUS) THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
         [MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
          EXISTS_TAC (← q r"k:real^M->bool") THEN REWRITE_TAC [SUBSET_RESTRICT] THEN
          ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN
          ASM_SIMP_TAC [GDELTA_IMP_LEBESGUE_MEASURABLE],
          MATCH_MP_TAC (← MESON [FINITE_SUBSET, FINITE_SING]
           (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
          ASM SET_TAC []],
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
          [RIGHT_IMP_EXISTS_THM]] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:(real^M->bool)->(real^M->bool)") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (c:(real^M->bool)->(real^M->bool)) u)") THEN
      REPEAT CONJ_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
        ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE],
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (s DIFF UNIONS u)") THEN
        ASM_SIMP_TAC [SUBSET_DIFF] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"IMAGE f u = IMAGE f t
          ==> (IMAGE f s DIFF IMAGE f u) SUBSET IMAGE f (s DIFF t)")) THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"y:real^N") THEN
        MATCH_MP_TAC COUNTABLE_SUBSET THEN
        EXISTS_TAC (← q r"UNIONS {{x | x IN c k /\ (f:real^M->real^N) x = y} |
                            (k:real^M->bool) IN u}") THEN CONJ_TAC
        THENL [ALL_TAC, REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []] THEN
        MATCH_MP_TAC COUNTABLE_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [FINITE_IMP_COUNTABLE]])
    prove
     r"!f:real^M->real^N s.
          lebesgue_measurable s /\ f measurable_on s /\
          (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))
          ==> negligible {y | ~COUNTABLE {x | x IN s /\ f x = y}}"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
            LUZIN_SIGMA) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:(real^M->bool)->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"UNIONS{{y | ~COUNTABLE {x | x IN k /\ f x = y}} | k IN u}
        UNION IMAGE (f:real^M->real^N) (s DIFF UNIONS u)") THEN
      REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC,
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, UNIONS_GSPEC, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON [COUNTABLE_EMPTY]
         (← q r"~COUNTABLE s ==> ~(s = {})"))) THEN
        REWRITE_TAC [← SET_RULE
         (← q r"~({x | x IN s /\ f x = y} = {}) <=> y IN IMAGE f s")] THEN DISCH_TAC THEN
        REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~q ==> p")] THEN DISCH_TAC THEN
        REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ ~Q x) <=> ~(!x. P x ==> Q x)")] THEN
        DISCH_TAC THEN
        UNDISCH_TAC (← q r"~COUNTABLE {x | x IN s /\ (f:real^M->real^N) x = y}") THEN
        REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"{x | x IN s /\ (f:real^M->real^N) x = y} =
                      {x | x IN UNIONS u /\ f x = y}")
        SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
         (← q r"UNIONS {{x | x IN k /\ (f:real^M->real^N) x = y} | k IN u}") THEN
        ASM_SIMP_TAC [COUNTABLE_UNIONS, FORALL_IN_IMAGE, SIMPLE_IMAGE,
                     COUNTABLE_IMAGE] THEN
        REWRITE_TAC [UNIONS_IMAGE] THEN ASM SET_TAC []] THEN
      SUBGOAL_THEN
       (← q r"compact k /\ (f:real^M->real^N) continuous_on k /\
        (!t. t SUBSET k /\ negligible t ==> negligible(IMAGE f t))")
      MP_TAC THENL [ASM_MESON_TAC [SUBSET_TRANS], ALL_TAC] THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN
      SPEC_TAC ((← q r"k:real^M->bool"), (← q r"s:real^M->bool")) THEN
      REPEAT STRIP_TAC THEN
      ABBREV_TAC
       (← q r"m = sup { measure t |
                  t SUBSET s /\ lebesgue_measurable t /\
                  negligible(IMAGE f s DIFF IMAGE f t) /\
                  !y. COUNTABLE {x | x IN t /\ (f:real^M->real^N) x = y}}") THEN
      FIRST_ASSUM (fun th => tactic_of do
        let t ← liftExcept (rand (← liftExcept (lhs (concl th))))
        pure (MP_TAC (← SPEC t SUP))) THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE (← q r"(?x. P x) ==> ~({f x | P x} = {})")) THEN
          MATCH_MP_TAC lemma THEN
          ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COMPACT,
                        CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET],
          ASM_MESON_TAC [MEASURE_SUBSET, MEASURABLE_LEBESGUE_MEASURABLE_SUBSET,
                         MEASURABLE_COMPACT]],
        ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"m - inv(&n + &1)")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"m <= m - a <=> ~(&0 < a)")] THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [NOT_FORALL_THM, SKOLEM_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"h:num->real^M->bool") THEN REWRITE_TAC [FORALL_AND_THM] THEN
      REWRITE_TAC [REAL_NOT_LE] THEN STRIP_TAC THEN
      ABBREV_TAC (← q r"t:real^M->bool = UNIONS {h n | n IN (:num)}") THEN
      SUBGOAL_THEN (← q r"lebesgue_measurable(t:real^M->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "t" THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s DIFF t:real^M->bool"] lemma) THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_COMPACT] THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, SUBSET_TRANS,
          SUBSET_DIFF, LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_COMPACT,
          CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET],
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"measurable(t:real^M->bool) /\ measurable(u:real^M->bool) /\
                    (!n. measurable((h:num->real^M->bool) n))")
      STRIP_ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!y. COUNTABLE {x | x IN t /\ (f:real^M->real^N) x = y}")
      ASSUME_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
         (← q r"UNIONS {{x | x IN h n /\ (f:real^M->real^N) x = y} | n IN (:num)}") THEN
        ASM_SIMP_TAC [COUNTABLE_UNIONS, FORALL_IN_IMAGE, SIMPLE_IMAGE,
                      COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
        EXPAND_TAC "t" THEN REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"negligible(IMAGE (f:real^M->real^N) s DIFF IMAGE f t)")
      ASSUME_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s DIFF IMAGE f (h 0)") THEN
        ASM_REWRITE_TAC [] THEN EXPAND_TAC "t" THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"measure(t UNION u:real^M->bool) <= m") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_UNION] THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN s UNION t /\ P x} =
         {x | x IN s /\ P x} UNION {x | x IN t /\ P x}")] THEN
        ASM_REWRITE_TAC [COUNTABLE_UNION] THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
         (← q r"(IMAGE f (s DIFF t) DIFF IMAGE f u) UNION
          (IMAGE (f:real^M->real^N) s DIFF IMAGE f t)") THEN
        ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN SET_TAC [],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        MEASURE_DISJOINT_UNION o lhand o lhand o snd) THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"t + u <= m ==> &0 <= u ==> ~(&0 < m - t) ==> u = &0"))) THEN
      ASM_SIMP_TAC [MEASURE_POS_LE] THEN ANTS_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM ARCH_EVENTUALLY_INV1] THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
        REWRITE_TAC [LE_REFL, REAL_NOT_LT] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a - b <= c <=> a - c <= b")] THEN
        TRANS_TAC REAL_LE_TRANS (← q r"measure((h:num->real^M->bool) n)") THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
        MATCH_MP_TAC MEASURE_SUBSET THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "t" THEN SET_TAC [],
        ASM_SIMP_TAC [MEASURABLE_MEASURE_EQ_0] THEN DISCH_TAC] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (s DIFF (t UNION u))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
         (← q r"IMAGE (f:real^M->real^N) u UNION
          (IMAGE f s DIFF IMAGE f t) UNION
          (IMAGE f (s DIFF t) DIFF IMAGE f u)") THEN
        CONJ_TAC THENL [ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ], SET_TAC []] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
        GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        REWRITE_TAC [] THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN
        EXISTS_TAC (← q r"{x | x IN t /\ (f:real^M->real^N) x = y} UNION
                    {x | x IN u /\ (f:real^M->real^N) x = y}") THEN
        ASM_REWRITE_TAC [COUNTABLE_UNION] THEN ASM SET_TAC []]))

  let BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER ← prove
   r"!f:real^M->real^N s.
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !t. t SUBSET s /\ measurable t /\ measure t < d
                         ==> ?u. IMAGE f t SUBSET u /\
                                 measurable u /\ measure u < e)
        ==> (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))"
   (REPEAT GEN_TAC THEN DISCH_THEN (LABEL_TAC "*") THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [NEGLIGIBLE_OUTER] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE])

  let BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY ← prove
   r"!f:real^M->real^N s.
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !t. t SUBSET s /\ measurable t /\ measure t < d
                         ==> measurable (IMAGE f t) /\ measure (IMAGE f t) < e)
        ==> (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER THEN
    ASM_MESON_TAC [SUBSET_REFL])

  pure { LUZIN_NPROPERTY_IMP_COUNTABLE_PREIMAGES, BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER,
         BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY }

/- ------------------------------------------------------------------------- -/
/- Banach S-property consequences.  (measure.ml 16758-16967)                -/
/- ------------------------------------------------------------------------- -/

structure MSBQ where
  BANACH_SPROPERTY_OUTER : thm
  BANACH_SPROPERTY_IMP_PRESERVES_MEASURABLE : thm
  BANACH_SPROPERTY_IMP_FINITE_PREIMAGES : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBQ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSG : MSG) (BMSH : MSH) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBN : MSBN) (BMSBO : MSBO) (BMSBP : MSBP) : ExceptT String IO MSBQ := do
  -- @@SCOPE BEGIN
  let { MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE, .. } := BMSB
  let { MEASURE_UNION_LE, .. } := BMSC
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { MULTIPART_MEASURES, .. } := BMSH
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_UNIONS,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { LEBESGUE_MEASURABLE_INNER_COMPACT, MEASURABLE_LEBESGUE_MEASURABLE_SUBSET,
        .. } := BMSAS
  let { LEBESGUE_MEASURABLE_PREIMAGE_INFINITE,
        PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN, .. } := BMSBN
  let { GDELTA_DOMAIN_OF_INJECTIVITY_MEASURABLE, .. } := BMSBO
  let { BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY, BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER,
        .. } := BMSBP
  let { CARD_NUMSEG_LT, FINITE_NUMSEG_LT, REAL_ARCH_LT, WF_REC, .. } := D.qsession
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { INFINITE, .. } := D.ig.dv.qsession
  let { WF_num, WLOG_LT, .. } := D.ig.dv.dg.qsession
  let { ASM_MESON_TAC, MESON, REAL_ARITH, SELECT_CONV, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { num_WF, .. } := D.ig.dv.dg.pt.qses
  let { AND_FORALL_THM, CONJ_SYM, CONTRAPOS_THM, FINITE_EMPTY, FINITE_IMAGE, FINITE_SING,
        FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INJECTIVE_ON_ALT, INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LE_1, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_DIV, REAL_LE_RDIV_EQ, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01,
        REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LT, SIMPLE_IMAGE,
        SIMPLE_IMAGE_GEN, SUBSET, SUBSET_DIFF, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUM_CONST, SUM_LE, UNIONS_GSPEC, UNIONS_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  -- @@SCOPE END

  let BANACH_SPROPERTY_OUTER ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !t. t SUBSET s /\ measurable t /\ measure t < d
                         ==> ?u. IMAGE f t SUBSET u /\
                                 measurable u /\ measure u < e)
        ==> (!e. &0 < e
                 ==> ?d. &0 < d /\
                         !t. t SUBSET s /\ measurable t /\ measure t < d
                             ==> measurable (IMAGE f t) /\
                                 measure (IMAGE f t) < e)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2) o MATCH_MP
      PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
    ANTS_TAC THENL
     [ONCE_REWRITE_TAC [CONJ_SYM] THEN
      MATCH_MP_TAC BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY_OUTER THEN
      ASM_REWRITE_TAC [],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool"))) THEN
    ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
    REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_MESON_TAC [MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, MEASURE_SUBSET,
                   REAL_LET_TRANS])

  let BANACH_SPROPERTY_IMP_PRESERVES_MEASURABLE ← prove
   r"!f:real^M->real^N s.
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !t. t SUBSET s /\ measurable t /\ measure t < d
                         ==> measurable (IMAGE f t) /\ measure (IMAGE f t) < e)
        ==> (!t. t SUBSET s /\ measurable t ==> measurable(IMAGE f t))"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, REAL_LT_01] THEN
    X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    MP_TAC (← SPEC (← q r"measure(t:real^M->bool) / d") REAL_ARCH_LT) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") MP_TAC) THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_SIMP_TAC [← GSYM REAL_NOT_LE, REAL_LE_DIV, REAL_LT_IMP_LE,
                  MEASURE_POS_LE] THEN
    REWRITE_TAC [REAL_NOT_LE] THEN ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_HALF] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"t:real^M->bool", ← q r"n:num"] MULTIPART_MEASURES) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXPAND_TAC "t" THEN REWRITE_TAC [IMAGE_UNIONS] THEN
    MATCH_MP_TAC MEASURABLE_UNIONS THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"measurable s /\ measure s < &1 ==> measurable(s:real^M->bool)")) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM SET_TAC [])

  let BANACH_SPROPERTY_IMP_FINITE_PREIMAGES ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\ measurable s /\
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !t. t SUBSET s /\ measurable t /\ measure t < d
                         ==> measurable (IMAGE f t) /\
                             measure (IMAGE f t) < e)
        ==> negligible {y | INFINITE {x | x IN s /\ f x = y}}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP MEASURABLE_IMP_LEBESGUE_MEASURABLE) THEN
    FIRST_ASSUM (ASSUME_TAC o
      MATCH_MP BANACH_SPROPERTY_IMP_PRESERVES_MEASURABLE) THEN
    FIRST_ASSUM (ASSUME_TAC o
      MATCH_MP BANACH_SPROPERTY_IMP_LUZIN_NPROPERTY) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LEBESGUE_MEASURABLE_PREIMAGE_INFINITE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          LEBESGUE_MEASURABLE_INNER_COMPACT)) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"?c. (!n. c n SUBSET s DIFF UNIONS {c m | (m:num) < n}) /\
           (!n. measurable(c n)) /\
           (!n. measurable(IMAGE (f:real^M->real^N) (c n))) /\
           (!n. measure(k:real^N->bool) / &2 <= measure(IMAGE f (c n))) /\
           (!n x y. x IN c n /\ y IN c n ==> (f x = f y <=> x = y))")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"?c. !n. c n = @t. t SUBSET s DIFF UNIONS {c m | (m:num) < n} /\
                          measurable t /\
                          measurable(IMAGE (f:real^M->real^N) t) /\
                          measure(k:real^N->bool) / &2 <= measure(IMAGE f t) /\
                          (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y))")
      MP_TAC THENL
       [MATCH_MP_TAC (← MATCH_MP WF_REC WF_num) THEN
        REPEAT STRIP_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
        REWRITE_TAC [UNIONS_GSPEC, ← MESON []
         (← q r"(?m:num. m < n /\ a IN f m) <=> ~(!m. m < n ==> ~(a IN f m))")] THEN
        ASM_SIMP_TAC [],
        MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"c:num->real^M->bool") THEN
      REWRITE_TAC [AND_FORALL_THM] THEN
      DISCH_THEN (fun th => MATCH_MP_TAC num_WF THEN MP_TAC th) THEN
      MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN SUBST1_TAC THEN
      DISCH_TAC THEN CONV_TAC SELECT_CONV THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N",
                        ← q r"s DIFF UNIONS {(c:num->real^M->bool) m | m < n}",
                        ← q r"IMAGE (f:real^M->real^N) s",
                        ← q r"measure(k:real^N->bool) / &2"]
          GDELTA_DOMAIN_OF_INJECTIVITY_MEASURABLE) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN ANTS_TAC THENL
       [MATCH_MP_TAC (← TAUT
         (← q r"r /\ s /\ (q ==> p) /\ q ==> p /\ q /\ r /\ s")) THEN
        CONJ_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [SUBSET_REFL]] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET_TRANS, SUBSET_DIFF], ALL_TAC] THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, SUBSET_DIFF],
          MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC LEBESGUE_MEASURABLE_UNIONS THEN
          ASM_SIMP_TAC [FORALL_IN_GSPEC, MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
          SIMP_TAC [FINITE_NUMSEG_LT, FINITE_IMAGE]],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^M->bool")] THEN
      REWRITE_TAC [INJECTIVE_ON_ALT] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < k / &2 ==> k <= x + y ==> k / &2 <= y"))) THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURE_UNION_LE o rand o snd) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [SUBSET_REFL] THEN MATCH_MP_TAC MEASURABLE_DIFF THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THENL
         [REWRITE_TAC [SUBSET_DIFF], ASM SET_TAC []] THEN
        MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [FINITE_NUMSEG_LT, FINITE_IMAGE],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS)] THEN
      ASM_SIMP_TAC [← SET_RULE
       (← q r"t SUBSET s
        ==> (IMAGE f s DIFF IMAGE f t) UNION IMAGE f t = IMAGE f s")] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [SUBSET_DIFF] THEN
        MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [FINITE_NUMSEG_LT, FINITE_IMAGE],
        ALL_TAC] THEN
      TRANS_TAC SUBSET_TRANS
       (← q r"{y | INFINITE {x | x IN s /\ (f:real^M->real^N) x = y}}") THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
        (← q r"y IN IMAGE f s <=> ~({x | x IN s /\ f x = y} = {})")] THEN
      MATCH_MP_TAC (← MESON [FINITE_EMPTY] (← q r"~FINITE s ==> ~(s = {})")) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INFINITE]) THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN
      SUBGOAL_THEN
       (← q r"FINITE {x | x IN UNIONS {c m | (m:num) < n} /\ (f:real^M->real^N) x = y}")
      MP_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        REWRITE_TAC [INTER_UNIONS, FINITE_UNIONS, SIMPLE_IMAGE] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [← GSYM IMAGE_o, FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, o_DEF, FORALL_IN_GSPEC, IMAGE_ID] THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC (← MESON [FINITE_SUBSET, FINITE_SING]
         (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
        ASM SET_TAC [],
        REWRITE_TAC [IMP_IMP, ← GSYM FINITE_UNION] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
        SET_TAC []],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"measure(k:real^N->bool) / &2")) THEN
      ASM_SIMP_TAC [REAL_HALF, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"(c:num->real^M->bool) n")) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LT] THEN
      MATCH_MP_TAC (← MESON [] (← q r"(!n. P n) /\ ~(!n. ~Q n) ==> ?n. P n /\ Q n")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [REAL_NOT_LT]] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"measure(s:real^M->bool) / d") REAL_ARCH_LT) THEN
      REWRITE_TAC [NOT_EXISTS_THM, REAL_NOT_LT] THEN X_GEN_TAC (← q r"n:num") THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ] THEN TRANS_TAC REAL_LE_TRANS
        (← q r"measure(UNIONS {(c:num->real^M->bool) m | m < n})") THEN
      CONJ_TAC THENL
       [ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
          rand o snd) THEN
        ASM_REWRITE_TAC [FINITE_NUMSEG_LT, FORALL_IN_GSPEC] THEN ANTS_TAC THENL
         [MATCH_MP_TAC WLOG_LT THEN ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o RAND_CONV)
         [← GSYM CARD_NUMSEG_LT] THEN
        SIMP_TAC [← GSYM SUM_CONST, FINITE_NUMSEG_LT] THEN
        MATCH_MP_TAC SUM_LE THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC, FINITE_NUMSEG_LT],
        MATCH_MP_TAC MEASURE_SUBSET THEN ASM_REWRITE_TAC [UNIONS_SUBSET] THEN
        CONJ_TAC THENL [MATCH_MP_TAC MEASURABLE_UNIONS, ASM SET_TAC []] THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT]]])

  pure { BANACH_SPROPERTY_OUTER, BANACH_SPROPERTY_IMP_PRESERVES_MEASURABLE,
         BANACH_SPROPERTY_IMP_FINITE_PREIMAGES }
/- ------------------------------------------------------------------------- -/
/- Absolute continuity of image measure.  (measure.ml 16968-17165)          -/
/- ------------------------------------------------------------------------- -/

structure MSBR where
  ABSOLUTELY_CONTINUOUS_MEASURE_IMAGE : thm
  ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_GEN : thm
  ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBR [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSAJ : MSAJ) (BMSAL : MSAL) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBC : MSBC) (BMSBN : MSBN) : ExceptT String IO MSBR := do
  -- @@SCOPE BEGIN
  let { MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_MEASURE_EQ_0, .. } := BMSB
  let { NEGLIGIBLE_OUTER, .. } := BMSC
  let { HAS_MEASURE_NESTED_INTERS, MEASURE_COUNTABLE_UNIONS_LE_GEN, .. } := BMSF
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE, .. } := BMSAJ
  let { NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE, .. } := BMSAL
  let { LEBESGUE_MEASURABLE_COMPACT, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSBC
  let { PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN, .. } := BMSBN
  let { DIFFERENTIABLE_WITHIN_SUBSET, .. } := D.qderivatives
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { COUNTABLE_SUBSET_NUM, .. } := D.qcard
  let { SUM_IMAGE_LE, .. } := D.qsession
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on, .. } := D.ig.qderivatives
  let { SUM_GP, UPPER_BOUND_FINITE_SET, .. } := D.ig.qmisc
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { INFINITE, .. } := D.ig.dv.qsession
  let { LIM_DROP_LBOUND, .. } := D.ig.dv.qtopology2
  let { INTERS_SUBSET, .. } := D.ig.dv.dg.qsession
  let { ARITH_RULE, ASM_MESON_TAC, MESON, REAL_ARITH, REAL_RAT_REDUCE_CONV, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_SYM, CONTRAPOS_THM, EMPTY_GSPEC, EMPTY_UNIONS, FINITE_NUMSEG, FORALL_AND_THM,
        FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_UNION, IN_UNIV, LE_REFL, LE_TRANS,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, REAL_ARCH_POW_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_POW, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ,
        REAL_LT_POW2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_POW_INV, REAL_POW_LE, RIGHT_IMP_EXISTS_THM,
        SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_RESTRICT,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_pow, SUM_LE_NUMSEG, SUM_SUBSET_SIMPLE, UNIONS_GSPEC, UNIONS_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { LIFT_DROP, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { COMPACT_CONTINUOUS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.top2
  -- @@SCOPE END

  let ABSOLUTELY_CONTINUOUS_MEASURE_IMAGE ← prove
   r"!f:real^M->real^N s u.
        f measurable_on s /\ IMAGE f s SUBSET u /\ measurable u /\
        (!t. t SUBSET s /\ negligible t ==> negligible(IMAGE f t)) /\
        negligible {y | INFINITE {x | x IN s /\ f x = y}}
        ==> (!e. &0 < e
                 ==> ?d. &0 < d /\
                         !t. t SUBSET s /\ measurable t /\ measure t < d
                             ==> measurable (IMAGE f t) /\
                                 measure (IMAGE f t) < e)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"((!d. ~P d) ==> F) ==> ?d. P d")) THEN
    DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, REAL_LT_POW2] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV) [NOT_FORALL_THM] THEN
    REWRITE_TAC [SKOLEM_THM, NOT_EXISTS_THM, NOT_IMP] THEN
    X_GEN_TAC (← q r"t:num->real^M->bool") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN
     (← q r"!n:num. measurable(IMAGE (f:real^M->real^N) (t n))")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP
        PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE],
      ASM_REWRITE_TAC [REAL_NOT_LT] THEN DISCH_TAC] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"c:real^M->bool = INTERS {UNIONS {t k | n <= k} | n IN (:num)}",
      ← q r"d = INTERS
          {UNIONS {IMAGE (f:real^M->real^N) (t k) | n <= k} | n IN (:num)}"] THEN
    MP_TAC (← ISPEC
     (← q r"\n:num. UNIONS {IMAGE (f:real^M->real^N) (t k) | n <= k}")
     HAS_MEASURE_NESTED_INTERS) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [REWRITE_TAC [← ARITH_RULE (← q r"SUC n <= k <=> n <= k /\ ~(n = k)")] THEN
      CONJ_TAC THENL [X_GEN_TAC (← q r"n:num"), SET_TAC []] THEN
      MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP
        PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] LIM_DROP_LBOUND)) THEN
    REWRITE_TAC [LIFT_DROP, TRIVIAL_LIMIT_SEQUENTIALLY, NOT_IMP, REAL_NOT_LE] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [] THEN TRANS_TAC REAL_LE_TRANS
       (← q r"measure(IMAGE (f:real^M->real^N) (t(n:num)))") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [ALL_TAC, REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []] THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP
          PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE],
        MP_TAC (← SPEC (← q r"n:num") LE_REFL) THEN
        REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC []],
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"&0 < e ==> x = &0 ==> x < e"))) THEN
      ASM_SIMP_TAC [MEASURABLE_MEASURE_EQ_0]] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN ANTS_TAC THENL
     [EXPAND_TAC "c" THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTERS_SUBSET THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        REWRITE_TAC [EMPTY_UNIONS, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN ASM SET_TAC [],
        REWRITE_TAC [NEGLIGIBLE_OUTER] THEN X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"d:real"] REAL_ARCH_POW_INV) THEN
        ASM_REWRITE_TAC [REAL_POW_INV] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"UNIONS {t k | SUC N <= k}:real^M->bool") THEN CONJ_TAC THENL
         [EXPAND_TAC "c" THEN
          REWRITE_TAC [SUBSET, INTERS_GSPEC, UNIONS_GSPEC] THEN SET_TAC [],
          ALL_TAC] THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [REAL_LET_TRANS]
          (← q r"a < d ==> measurable(s:real^N->bool) /\ measure s <= a
                     ==> measurable s /\ measure s < d"))) THEN
        MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_GEN THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_IMAGE] THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN
        REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
        X_GEN_TAC (← q r"k:num->bool") THEN STRIP_TAC THEN
        W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE_LE o lhand o snd) THEN
        ASM_SIMP_TAC [o_DEF, MEASURE_POS_LE] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        FIRST_ASSUM (X_CHOOSE_THEN (← q r"M:num") MP_TAC o ISPEC (← q r"\n:num. n") o
          MATCH_MP UPPER_BOUND_FINITE_SET) THEN
        REWRITE_TAC [] THEN DISCH_TAC THEN TRANS_TAC REAL_LE_TRANS
         (← q r"sum(SUC N..M) (\n. measure(t n:real^M->bool))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
          ASM_SIMP_TAC [FINITE_NUMSEG, SUBSET, IN_NUMSEG, MEASURE_POS_LE] THEN
          ASM SET_TAC [],
          TRANS_TAC REAL_LE_TRANS (← q r"sum(SUC N..M) (\n. inv(&2 pow n))") THEN
          ASM_SIMP_TAC [SUM_LE_NUMSEG, REAL_LT_IMP_LE] THEN
          REWRITE_TAC [SUM_GP, REAL_INV_POW] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN COND_CASES_TAC THEN
          SIMP_TAC [REAL_POW_LE, ← REAL_ARITH (← q r"&0 <= &1 / &2"), real_pow, ← REAL_ARITH
           (← q r"(&1 / &2 * x - &1 / &2 * y) / (&1 / &2) <= x <=> &0 <= y")]]],
      UNDISCH_TAC
       (← q r"negligible {y | INFINITE {x | x IN s /\ (f:real^M->real^N) x = y}}") THEN
      REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET)] THEN
    EXPAND_TAC "d" THEN GEN_REWRITE_TAC I [SUBSET] THEN
    REWRITE_TAC [INTERS_GSPEC, IN_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
    DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM, IN_UNION] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~q ==> p")] THEN EXPAND_TAC "c" THEN
    REWRITE_TAC [IN_IMAGE, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV, UNIONS_GSPEC] THEN
    REWRITE_TAC [NOT_EXISTS_THM, NOT_FORALL_THM, ← TAUT
      (← q r"~(p /\ q) <=> p ==> ~q")] THEN
    GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [INFINITE, RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    DISCH_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"r:real^M->num")) THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"M:num") MP_TAC o ISPEC (← q r"r:real^M->num") o
          MATCH_MP UPPER_BOUND_FINITE_SET) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"k:num") MP_TAC o SPEC (← q r"M:num")) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^M") STRIP_ASSUME_TAC) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
    REPEAT (ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC]) THEN
    ASM_MESON_TAC [LE_TRANS])

  let ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_GEN ← prove
   r"!f:real^N->real^N s.
      compact s /\
      f continuous_on s /\
      negligible (IMAGE f {x | x IN s /\ ~(f differentiable (at x within s))})
      ==> !e. &0 < e
              ==> ?d. &0 < d /\
                      !t. t SUBSET s /\ measurable t /\ measure t < d
                          ==> measurable(IMAGE f t) /\
                              measure(IMAGE f t) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_MEASURE_IMAGE THEN
    EXISTS_TAC (← q r"IMAGE (f:real^N->real^N) s") THEN
    REWRITE_TAC [SUBSET_REFL] THEN
    ASM_SIMP_TAC [CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
      COMPACT_CONTINUOUS_IMAGE, LEBESGUE_MEASURABLE_COMPACT, MEASURABLE_COMPACT,

      NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE] THEN
    X_GEN_TAC (← q r"n:real^N->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC
     (← q r"IMAGE f {x | x IN s /\ ~(f differentiable at x within s)} UNION
      IMAGE (f:real^N->real^N)
            {x | x IN n /\ f differentiable at x within s}") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE THEN
    REWRITE_TAC [LE_REFL] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              NEGLIGIBLE_SUBSET)) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      REWRITE_TAC [differentiable_on, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] DIFFERENTIABLE_WITHIN_SUBSET) THEN
      ASM SET_TAC []])

  let ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE ← prove
   r"!f:real^N->real^N s.
        compact s /\ f differentiable_on s
        ==> !e. &0 < e
                ==> ?d. &0 < d /\
                        !t. t SUBSET s /\ measurable t /\ measure t < d
                            ==> measurable(IMAGE f t) /\
                                measure(IMAGE f t) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_GEN THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [differentiable_on]) THEN
    ASM_REWRITE_TAC [← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
    REWRITE_TAC [EMPTY_GSPEC, IMAGE_CLAUSES, NEGLIGIBLE_EMPTY])

  pure { ABSOLUTELY_CONTINUOUS_MEASURE_IMAGE,
         ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_GEN,
         ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE }
