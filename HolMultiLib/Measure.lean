/- ------------------------------------------------------------------------- -/
/- Corollaries of Sard; infinite preimages; negligibility of bounded       -/
/- variation and rectifiable low-dimensional images.  (measure.ml 9168-9351)-/
/- ------------------------------------------------------------------------- -/

structure MSAL where
  BABY_SARD_ALT : thm
  NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE_GEN : thm
  NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE : thm
  NEGLIGIBLE_INFINITE_PREIMAGES_DIFFERENTIABLE : thm
  NEGLIGIBLE_IMAGE_BOUNDED_VARIATION_INTERVAL : thm
  NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE_LOWDIM : thm
  NEGLIGIBLE_RECTIFIABLE_PATH_IMAGE : thm
  INTERIOR_RECTIFIABLE_PATH_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAL [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMSF : MSF) (BMSAJ : MSAJ) (BMSAK : MSAK) : ExceptT String IO MSAL := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_EMPTY_INTERIOR, .. } := BMSC
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM, .. } := BMSAJ
  let { BABY_SARD, .. } := BMSAK
  let { DIFFERENTIABLE_FINITE_PREIMAGES_GEN, .. } := D.qderivatives
  let { DET_EQ_0_RANK, .. } := D.qdet
  let { ABSOLUTELY_CONTINUOUS_EXTENDS_TO_CLOSURE,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUBSET, FACTOR_THROUGH_VARIATION, .. } := D.qintegration1
  let { HAS_BOUNDED_VARIATION_ON_CLOSURE, HAS_BOUNDED_VARIATION_ON_SUBSET,
        .. } := D.qintegration2
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, rectifiable_path,
        .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { CLOSED_IN_COMPACT, .. } := D.qtopology1
  let { differentiable, DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on,
        HAS_DERIVATIVE_WITHIN_SUBSET, .. } := D.ig.qderivatives
  let { IMAGE_UNIONS, REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { INFINITE, .. } := D.ig.dv.qsession
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { INVERTIBLE_DET_NZ, .. } := D.ig.dv.dg.qdet
  let { path_image, .. } := D.ig.dv.dg.qpaths2
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, .. } := D.ig.dv.dg.qtopology1
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_CLOSURE, CONVEX_INTER, .. } := D.ig.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.ig.dv.dg.pt.qcvx3
  let { AND_FORALL_THM, CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_1, EMPTY_GSPEC, EXTENSION,
        FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM,
        MONO_AND, MONO_EXISTS, REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_LID, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_INTER,
        SUBSET_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DROP_VEC, FORALL_DROP, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { dist, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSED_CLOSURE, CLOSED_INTER_COMPACT, CLOSED_SING, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_INTERVAL_1, IS_INTERVAL_COMPACT, IS_INTERVAL_INTERVAL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let BABY_SARD_ALT ← prove
   r"!f:real^M->real^N s.
         dimindex(:M) <= dimindex(:N) /\
         (!x. x IN s
              ==> ?f'. (f has_derivative f') (at x within s) /\
                       rank(matrix f') < dimindex (:N))
         ==> negligible(IMAGE f s)"
   (REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BABY_SARD THEN ASM_MESON_TAC [])

  let NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE_GEN ← prove
   r"!f:real^N->real^N s.
       (!y. compact {x | x IN s /\ f x = y}) /\
       negligible (IMAGE f {x | x IN s /\ ~(f differentiable (at x within s))})
       ==> negligible {y | INFINITE {x | x IN s /\ f x = y}}"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"f:real^N->real^N",
      ← q r"{x | x IN s /\
         ?f'. (f has_derivative f') (at x within s) /\
              ~invertible(matrix f':real^N^N)}"]
     BABY_SARD_ALT) THEN
    REWRITE_TAC [IN_ELIM_THM, LE_REFL] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      REWRITE_TAC [← GSYM DET_EQ_0_RANK, INVERTIBLE_DET_NZ] THEN
      GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HAS_DERIVATIVE_WITHIN_SUBSET) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ]] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, INFINITE] THEN X_GEN_TAC (← q r"y:real^N") THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [DE_MORGAN_THM, IN_UNION, ← SET_RULE
     (← q r"~(y IN IMAGE f s) <=> (!x. f x = y ==> ~(x IN s))")] THEN
    REWRITE_TAC [IN_ELIM_THM, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT, differentiable] THEN
    REWRITE_TAC [AND_FORALL_THM,
      ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    REWRITE_TAC [← MESON [] (← q r"~(?x. P x /\ Q x) /\ (?x. P x) <=>
        (?x. P x /\ ~Q x) /\ (!x. P x ==> ~Q x)")] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM, RIGHT_IMP_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f':real^N->real^N->real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC DIFFERENTIABLE_FINITE_PREIMAGES_GEN THEN
    EXISTS_TAC (← q r"f':real^N->real^N->real^N") THEN
    ASM_SIMP_TAC [← GSYM INVERTIBLE_DET_NZ])

  let NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE ← prove
   r"!f:real^N->real^N s.
       f continuous_on s /\ compact s /\
       negligible (IMAGE f {x | x IN s /\ ~(f differentiable (at x within s))})
       ==> negligible {y | INFINITE {x | x IN s /\ f x = y}}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE_GEN THEN
    ASM_REWRITE_TAC [] THEN GEN_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CLOSED_IN_COMPACT)) THEN
    ONCE_REWRITE_TAC [← GSYM IN_SING] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
    ASM_REWRITE_TAC [CLOSED_SING])

  let NEGLIGIBLE_INFINITE_PREIMAGES_DIFFERENTIABLE ← prove
   r"!f:real^N->real^N s.
        compact s /\ f differentiable_on s
        ==> negligible {y | INFINITE {x | x IN s /\ f(x) = y}}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [differentiable_on]) THEN
    REWRITE_TAC [← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
    ASM_REWRITE_TAC [EMPTY_GSPEC, IMAGE_CLAUSES, NEGLIGIBLE_EMPTY])

  let NEGLIGIBLE_IMAGE_BOUNDED_VARIATION_INTERVAL ← (do
    let lemma ← prove
     r"!f:real^1->real^N a b.
          2 <= dimindex(:N) /\ f has_bounded_variation_on interval[a,b]
          ==> negligible(IMAGE f (interval[a,b]))"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FACTOR_THROUGH_VARIATION) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") (STRIP_ASSUME_TAC o GSYM)) THEN
      SUBGOAL_THEN
       (← q r"IMAGE (f:real^1->real^N) (interval[a,b]) =
      IMAGE g { lift(vector_variation (interval[a,u]) f) | u |
                u IN interval[a,b]}")
      SUBST1_TAC THENL
       [REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN ASM SET_TAC [],
        MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM THEN
        ASM_REWRITE_TAC [DIMINDEX_1, ← ARITH_RULE (← q r"1 < n <=> 2 <= n")] THEN
        X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"(:real^1)", ← q r"&1"] THEN
        ASM_SIMP_TAC [← GSYM dist, REAL_MUL_LID, IN_INTER, IN_UNIV, OPEN_UNIV]])
    prove
     r"!f:real^1->real^N s.
        2 <= dimindex(:N) /\ f has_bounded_variation_on s /\ is_interval s
        ==> negligible(IMAGE f s)"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"IMAGE (f:real^1->real^N)
        (closure s INTER UNIONS {interval[--vec n,vec n] | n IN (:num)})") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [INTER_UNIONS, IMAGE_UNIONS] THEN
        REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
        MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
        SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, FORALL_IN_IMAGE, o_THM] THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC) THEN
        MP_TAC (← ISPEC (← q r"closure s INTER interval[--vec n:real^1,vec n]")
         IS_INTERVAL_COMPACT) THEN
        SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_INTERVAL, CLOSED_CLOSURE] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IS_INTERVAL_CONVEX_1]) THEN
        ASM_SIMP_TAC [IS_INTERVAL_CONVEX_1, CONVEX_CLOSURE, CONVEX_INTER,
                      CONVEX_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"closure s:real^1->bool") THEN
        ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_CLOSURE, IS_INTERVAL_CONVEX_1] THEN
        ASM SET_TAC [],
        MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET_INTER, CLOSURE_SUBSET] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"(!x. ?n. x IN f n)
      ==> s SUBSET UNIONS {f n | n IN UNIV}")) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, ← GSYM REAL_ABS_BOUNDS] THEN
        REWRITE_TAC [← GSYM FORALL_DROP, DROP_VEC, REAL_ARCH_SIMPLE]]))

  let NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE_LOWDIM ← prove
   r"!f:real^1->real^N s.
        2 <= dimindex(:N) /\ f absolutely_continuous_on s /\ is_interval s
        ==> negligible(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_CONTINUOUS_EXTENDS_TO_CLOSURE)) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
     (← q r"IMAGE (g:real^1->real^N)
        (closure s INTER UNIONS {interval[--vec n,vec n] | n IN (:num)})") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [INTER_UNIONS, IMAGE_UNIONS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
      MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, FORALL_IN_IMAGE, o_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC) THEN
      MP_TAC (← ISPEC (← q r"closure s INTER interval[--vec n:real^1,vec n]")
       IS_INTERVAL_COMPACT) THEN
      SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_INTERVAL, CLOSED_CLOSURE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IS_INTERVAL_CONVEX_1]) THEN
      ASM_SIMP_TAC [IS_INTERVAL_CONVEX_1, CONVEX_CLOSURE, CONVEX_INTER,
                    CONVEX_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC NEGLIGIBLE_IMAGE_BOUNDED_VARIATION_INTERVAL THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
      REWRITE_TAC [BOUNDED_INTERVAL] THEN
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"closure s:real^1->bool") THEN
      ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s ==> g x = f x) /\ s SUBSET c /\ u = UNIV
      ==> IMAGE f s SUBSET IMAGE g (c INTER u)")) THEN
      ASM_REWRITE_TAC [CLOSURE_SUBSET, UNIONS_GSPEC, EXTENSION] THEN
      REWRITE_TAC [IN_UNIV, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, ← GSYM REAL_ABS_BOUNDS] THEN
      REWRITE_TAC [← GSYM FORALL_DROP, DROP_VEC, REAL_ARCH_SIMPLE]])

  let NEGLIGIBLE_RECTIFIABLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N.
        2 <= dimindex(:N) /\ rectifiable_path g ==> negligible(path_image g)"
   (REWRITE_TAC [rectifiable_path, path_image] THEN
    SIMP_TAC [NEGLIGIBLE_IMAGE_BOUNDED_VARIATION_INTERVAL,
              IS_INTERVAL_INTERVAL])

  let INTERIOR_RECTIFIABLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N.
        2 <= dimindex(:N) /\ rectifiable_path g
        ==> interior(path_image g) = {}"
   (MESON_TAC [NEGLIGIBLE_RECTIFIABLE_PATH_IMAGE, NEGLIGIBLE_EMPTY_INTERIOR])

  pure { BABY_SARD_ALT, NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE_GEN,
         NEGLIGIBLE_INFINITE_PREIMAGES_MOSTLY_DIFFERENTIABLE,
         NEGLIGIBLE_INFINITE_PREIMAGES_DIFFERENTIABLE,
         NEGLIGIBLE_IMAGE_BOUNDED_VARIATION_INTERVAL,
         NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE_LOWDIM,
         NEGLIGIBLE_RECTIFIABLE_PATH_IMAGE, INTERIOR_RECTIFIABLE_PATH_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Properties of Lebesgue measurable sets.  (measure.ml 9352-9686)          -/
/- ------------------------------------------------------------------------- -/

structure MSAM where
  MEASURABLE_ON_INDICATOR : thm
  MEASURABLE_ON_INDICATOR_SUBSET : thm
  MEASURABLE_IMP_LEBESGUE_MEASURABLE : thm
  NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE : thm
  LEBESGUE_MEASURABLE_EMPTY : thm
  LEBESGUE_MEASURABLE_UNIV : thm
  LEBESGUE_MEASURABLE_COMPACT : thm
  LEBESGUE_MEASURABLE_BALL : thm
  LEBESGUE_MEASURABLE_CBALL : thm
  LEBESGUE_MEASURABLE_INTERVAL : thm
  LEBESGUE_MEASURABLE_INTER : thm
  LEBESGUE_MEASURABLE_UNION : thm
  LEBESGUE_MEASURABLE_DIFF : thm
  LEBESGUE_MEASURABLE_COMPL : thm
  LEBESGUE_MEASURABLE_ON_SUBINTERVALS : thm
  LEBESGUE_MEASURABLE_CLOSED : thm
  LEBESGUE_MEASURABLE_OPEN : thm
  LEBESGUE_MEASURABLE_OPEN_IN : thm
  LEBESGUE_MEASURABLE_CLOSED_IN : thm
  LEBESGUE_MEASURABLE_UNIONS : thm
  LEBESGUE_MEASURABLE_COUNTABLE_UNIONS : thm
  LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT : thm
  LEBESGUE_MEASURABLE_COUNTABLE_INTERS : thm
  LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT : thm
  LEBESGUE_MEASURABLE_INTERS : thm
  GDELTA_IMP_LEBESGUE_MEASURABLE : thm
  FSIGMA_IMP_LEBESGUE_MEASURABLE : thm
  BOREL_IMP_LEBESGUE_MEASURABLE : thm
  LEBESGUE_MEASURABLE_IFF_MEASURABLE : thm
  LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS : thm
  LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS : thm
  MEASURABLE_ON_MEASURABLE_SUBSET : thm
  LEBESGUE_MEASURABLE_JORDAN : thm
  LEBESGUE_MEASURABLE_CONVEX : thm
  LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF : thm
  LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ : thm
  LEBESGUE_MEASURABLE_INSERT : thm
  LEBESGUE_MEASURABLE_DELETE : thm
  LEBESGUE_MEASURABLE_SING : thm
  ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_INTER : thm
  ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAM [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSG : MSG) (BMSJ : MSJ) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAG : MSAG) : ExceptT String IO MSAM := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTEGRABLE, MEASURABLE_INTER, MEASURABLE_INTERVAL, .. } := BMSA
  let { MEASURABLE_EMPTY, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURABLE_COMPACT, MEASURABLE_JORDAN, .. } := BMSG
  let { MEASURABLE_BALL, MEASURABLE_CBALL, NEGLIGIBLE_CONVEX_FRONTIER, .. } := BMSJ
  let { INTEGRABLE_IMP_MEASURABLE, INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE,
        lebesgue_measurable, MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_0, MEASURABLE_ON_CONST, .. } := BMSAD
  let { MEASURABLE_ON_CASES, MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { MEASURABLE_ON_COUNTABLE_UNIONS, MEASURABLE_ON_DIFF, MEASURABLE_ON_INTER,
        MEASURABLE_ON_UNION, MEASURABLE_ON_UNIONS, .. } := BMSAG
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration1
  let { INTEGRABLE_CONST, INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration2
  let { NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { INTERS_UNIONS, INTERSECTION_OF, UNION_OF, .. } := D.qsession
  let { borel_INDUCT, fsigma, gdelta, .. } := D.qtopology2
  let { REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ig.qtopology
  let { indicator, NORM_REAL, .. } := D.ig.qvec
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { COMPL_COMPL, .. } := D.ig.dv.dg.qsession
  let { FRONTIER_INTER_SUBSET, OPEN_CLOSED, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_IMP_COUNTABLE, .. } := D.ig.dv.dg.pt.qcard
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INTER, IN_UNIV, MONO_EXISTS, REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SIMPLE_IMAGE, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { UNION_COMM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, IN_INTERVAL, LIFT_DROP, NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VEC_COMPONENT, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_SUBSET_CBALL, CLOSED_IN_CLOSED, CLOSED_INTER_COMPACT,
        .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_CBALL_0, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_IN_OPEN, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let MEASURABLE_ON_INDICATOR ← prove
   r"!s t. indicator t measurable_on s <=> lebesgue_measurable(s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [lebesgue_measurable] THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [indicator, IN_UNIV, IN_INTER] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [])

  let MEASURABLE_ON_INDICATOR_SUBSET ← prove
   r"!s t:real^N->bool.
        t SUBSET s
        ==> (indicator t measurable_on s <=> lebesgue_measurable t)"
   (SIMP_TAC [MEASURABLE_ON_INDICATOR, ← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")])

  let MEASURABLE_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. measurable s ==> lebesgue_measurable s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [lebesgue_measurable] THEN
    MATCH_MP_TAC INTEGRABLE_IMP_MEASURABLE THEN
    ASM_REWRITE_TAC [indicator, ← GSYM MEASURABLE_INTEGRABLE])

  let NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. negligible s ==> lebesgue_measurable s"
   (SIMP_TAC [NEGLIGIBLE_IMP_MEASURABLE, MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let LEBESGUE_MEASURABLE_EMPTY ← prove
   r"lebesgue_measurable {}"
   (SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_EMPTY])

  let LEBESGUE_MEASURABLE_UNIV ← prove
   r"lebesgue_measurable (:real^N)"
   (REWRITE_TAC [lebesgue_measurable, indicator, IN_UNIV, MEASURABLE_ON_CONST])

  let LEBESGUE_MEASURABLE_COMPACT ← prove
   r"!s:real^N->bool. compact s ==> lebesgue_measurable s"
   (SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_COMPACT])

  let LEBESGUE_MEASURABLE_BALL ← prove
   r"!a:real^N r. lebesgue_measurable(ball(a,r))"
   (SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_BALL])

  let LEBESGUE_MEASURABLE_CBALL ← prove
   r"!a:real^N r. lebesgue_measurable(cball(a,r))"
   (SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_CBALL])

  let LEBESGUE_MEASURABLE_INTERVAL ← prove
   r"(!a b:real^N. lebesgue_measurable(interval[a,b])) /\
   (!a b:real^N. lebesgue_measurable(interval(a,b)))"
   (SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_INTERVAL])

  let LEBESGUE_MEASURABLE_INTER ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ lebesgue_measurable t
        ==> lebesgue_measurable(s INTER t)"
   (REWRITE_TAC [indicator, lebesgue_measurable, MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_INTER])

  let LEBESGUE_MEASURABLE_UNION ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ lebesgue_measurable t
        ==> lebesgue_measurable(s UNION t)"
   (REWRITE_TAC [indicator, lebesgue_measurable, MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_UNION])

  let LEBESGUE_MEASURABLE_DIFF ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ lebesgue_measurable t
        ==> lebesgue_measurable(s DIFF t)"
   (REWRITE_TAC [indicator, lebesgue_measurable, MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_DIFF])

  let LEBESGUE_MEASURABLE_COMPL ← prove
   r"!s. lebesgue_measurable((:real^N) DIFF s) <=> lebesgue_measurable s"
   (MESON_TAC [LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_UNIV,
               COMPL_COMPL])

  let LEBESGUE_MEASURABLE_ON_SUBINTERVALS ← prove
   r"!s. lebesgue_measurable s <=>
       !a b:real^N. lebesgue_measurable(s INTER interval[a,b])"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [LEBESGUE_MEASURABLE_INTERVAL, LEBESGUE_MEASURABLE_INTER] THEN
    REWRITE_TAC [lebesgue_measurable] THEN DISCH_TAC THEN
    MATCH_MP_TAC INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"(\x. vec 1):real^N->real^1") THEN
    REWRITE_TAC [INTEGRABLE_CONST] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, indicator, IN_INTER] THEN MESON_TAC [],
      REPEAT STRIP_TAC THEN REWRITE_TAC [indicator] THEN
      COND_CASES_TAC THEN REWRITE_TAC [DROP_VEC, NORM_REAL, ← GSYM drop] THEN
      REAL_ARITH_TAC])

  let LEBESGUE_MEASURABLE_CLOSED ← prove
   r"!s:real^N->bool. closed s ==> lebesgue_measurable s"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [LEBESGUE_MEASURABLE_ON_SUBINTERVALS] THEN
    ASM_SIMP_TAC [CLOSED_INTER_COMPACT, LEBESGUE_MEASURABLE_COMPACT,
                  COMPACT_INTERVAL])

  let LEBESGUE_MEASURABLE_OPEN ← prove
   r"!s:real^N->bool. open s ==> lebesgue_measurable s"
   (REWRITE_TAC [OPEN_CLOSED] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_CLOSED])

  let LEBESGUE_MEASURABLE_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean s) t /\ lebesgue_measurable s
        ==> lebesgue_measurable t"
   (MESON_TAC [OPEN_IN_OPEN, LEBESGUE_MEASURABLE_OPEN,
               LEBESGUE_MEASURABLE_INTER])

  let LEBESGUE_MEASURABLE_CLOSED_IN ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean s) t /\ lebesgue_measurable s
        ==> lebesgue_measurable t"
   (MESON_TAC [CLOSED_IN_CLOSED, LEBESGUE_MEASURABLE_CLOSED,
               LEBESGUE_MEASURABLE_INTER])

  let LEBESGUE_MEASURABLE_UNIONS ← prove
   r"!f. FINITE f /\ (!s. s IN f ==> lebesgue_measurable s)
       ==> lebesgue_measurable (UNIONS f)"
   (REWRITE_TAC [indicator, lebesgue_measurable, MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_UNIONS])

  let LEBESGUE_MEASURABLE_COUNTABLE_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        COUNTABLE f /\ (!s. s IN f ==> lebesgue_measurable s)
        ==> lebesgue_measurable (UNIONS f)"
   (REWRITE_TAC [indicator, lebesgue_measurable, MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_COUNTABLE_UNIONS])

  let LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT ← prove
   r"!s:num->real^N->bool.
        (!n. lebesgue_measurable(s n))
        ==> lebesgue_measurable(UNIONS {s n | n IN (:num)})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, IN_UNIV, NUM_COUNTABLE])

  let LEBESGUE_MEASURABLE_COUNTABLE_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        COUNTABLE f /\ (!s. s IN f ==> lebesgue_measurable s)
        ==> lebesgue_measurable (INTERS f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [INTERS_UNIONS, LEBESGUE_MEASURABLE_COMPL] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, COUNTABLE_IMAGE,
                  LEBESGUE_MEASURABLE_COMPL])

  let LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT ← prove
   r"!s:num->real^N->bool.
        (!n. lebesgue_measurable(s n))
        ==> lebesgue_measurable(INTERS {s n | n IN (:num)})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, COUNTABLE_IMAGE,
                  NUM_COUNTABLE])

  let LEBESGUE_MEASURABLE_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!s. s IN f ==> lebesgue_measurable s)
        ==> lebesgue_measurable (INTERS f)"
   (SIMP_TAC [LEBESGUE_MEASURABLE_COUNTABLE_INTERS, FINITE_IMP_COUNTABLE])

  let GDELTA_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. gdelta s ==> lebesgue_measurable s"
   (GEN_TAC THEN REWRITE_TAC [gdelta, INTERSECTION_OF] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_OPEN])

  let FSIGMA_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. fsigma s ==> lebesgue_measurable s"
   (GEN_TAC THEN REWRITE_TAC [fsigma, UNION_OF] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_CLOSED])

  let BOREL_IMP_LEBESGUE_MEASURABLE ← prove
   r"!s:real^N->bool. borel s ==> lebesgue_measurable s"
   (MATCH_MP_TAC borel_INDUCT THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_OPEN, LEBESGUE_MEASURABLE_COMPL] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COUNTABLE_UNIONS])

  let LEBESGUE_MEASURABLE_IFF_MEASURABLE ← prove
   r"!s:real^N->bool. bounded s ==> (lebesgue_measurable s <=> measurable s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
    REWRITE_TAC [lebesgue_measurable, indicator, MEASURABLE_INTEGRABLE] THEN
    SUBGOAL_THEN (← q r"?a b:real^N. s = s INTER interval[a,b]")
     (REPEAT_TCL CHOOSE_THEN SUBST1_TAC)
    THENL [REWRITE_TAC [← SET_RULE (← q r"s = s INTER t <=> s SUBSET t")] THEN
           ASM_MESON_TAC [BOUNDED_SUBSET_CLOSED_INTERVAL], ALL_TAC] THEN
    REWRITE_TAC [IN_INTER, ← MESON []
     (← q r"(if P x /\ Q x then a else b) =
    (if Q x then if P x then a else b else b)")] THEN
    REWRITE_TAC [MEASURABLE_ON_UNIV, INTEGRABLE_RESTRICT_UNIV] THEN
    STRIP_TAC THEN MATCH_MP_TAC
      MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"(\x. vec 1):real^N->real^1") THEN
    ASM_REWRITE_TAC [INTEGRABLE_CONST, NORM_REAL, DROP_VEC, ← GSYM drop] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN SIMP_TAC [DROP_VEC] THEN
    REAL_ARITH_TAC)

  let LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s <=>
        (!a b. measurable(s INTER interval[a,b]))"
   (MESON_TAC [LEBESGUE_MEASURABLE_ON_SUBINTERVALS,
               LEBESGUE_MEASURABLE_IFF_MEASURABLE,
               BOUNDED_INTER, BOUNDED_INTERVAL])

  let LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s <=>
        (!n. measurable(s INTER interval[--vec n,vec n]))"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV
     [LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS] THEN
    EQ_TAC THEN SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!a b:real^N. ?n. s INTER interval[a,b] =
                     ((s INTER interval[--vec n,vec n]) INTER interval[a,b])")
     (fun th => ASM_MESON_TAC [th, MEASURABLE_INTERVAL, MEASURABLE_INTER]) THEN
    REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"interval[a:real^N,b]", ← q r"vec 0:real^N"]
          BOUNDED_SUBSET_CBALL) THEN
    REWRITE_TAC [BOUNDED_INTERVAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← SPEC (← q r"r:real") REAL_ARCH_SIMPLE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"i SUBSET b ==> b SUBSET n ==> s INTER i = (s INTER n) INTER i"))) THEN
    REWRITE_TAC [SUBSET, IN_CBALL_0, IN_INTERVAL, VEC_COMPONENT,
                 VECTOR_NEG_COMPONENT, ← GSYM REAL_ABS_BOUNDS] THEN
    ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS])

  let MEASURABLE_ON_MEASURABLE_SUBSET ← prove
   r"!f s t. s SUBSET t /\ f measurable_on t /\ measurable s
           ==> f measurable_on s"
   (MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET,
               MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let LEBESGUE_MEASURABLE_JORDAN ← prove
   r"!s:real^N->bool. negligible(frontier s) ==> lebesgue_measurable s"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [LEBESGUE_MEASURABLE_ON_SUBINTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    MATCH_MP_TAC MEASURABLE_IMP_LEBESGUE_MEASURABLE THEN
    MATCH_MP_TAC MEASURABLE_JORDAN THEN
    SIMP_TAC [BOUNDED_INTER, BOUNDED_INTERVAL] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"frontier s UNION frontier(interval[a:real^N,b])") THEN
    ASM_REWRITE_TAC [FRONTIER_INTER_SUBSET, NEGLIGIBLE_UNION_EQ] THEN
    SIMP_TAC [NEGLIGIBLE_CONVEX_FRONTIER, CONVEX_INTERVAL])

  let LEBESGUE_MEASURABLE_CONVEX ← prove
   r"!s:real^N->bool. convex s ==> lebesgue_measurable s"
   (SIMP_TAC [LEBESGUE_MEASURABLE_JORDAN, NEGLIGIBLE_CONVEX_FRONTIER])

  let LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ negligible((s DIFF t) UNION (t DIFF s))
        ==> lebesgue_measurable t"
   (REPEAT STRIP_TAC THEN SUBST1_TAC (← SET_RULE
     (← q r"t:real^N->bool = (s DIFF (s DIFF t)) UNION (t DIFF s)")) THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN CONJ_TAC THENL
     [MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
    SET_TAC [])

  let LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ ← prove
   r"!s t:real^N->bool.
        negligible(s DIFF t UNION t DIFF s)
        ==> (lebesgue_measurable s <=> lebesgue_measurable t)"
   (MESON_TAC [LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF, UNION_COMM])

  let LEBESGUE_MEASURABLE_INSERT ← prove
   r"!s a:real^N. lebesgue_measurable(a INSERT s) <=> lebesgue_measurable s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{a:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let LEBESGUE_MEASURABLE_DELETE ← prove
   r"!s a:real^N. lebesgue_measurable(s DELETE a) <=> lebesgue_measurable s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{a:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let LEBESGUE_MEASURABLE_SING ← prove
   r"!a:real^N. lebesgue_measurable {a}"
   (GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE THEN
    REWRITE_TAC [NEGLIGIBLE_SING])

  let ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_INTER ← prove
   r"!f:real^M->real^N s t.
        f absolutely_integrable_on s /\ lebesgue_measurable t
        ==> f absolutely_integrable_on (s INTER t)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC
      MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC
     (← q r"\x. lift(norm(if x IN s then (f:real^M->real^N) x else vec 0))") THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_NORM, IN_UNIV, IN_INTER,
                  ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    REWRITE_TAC [← MESON []
     (← q r"(if p /\ q then x else y) = if q then if p then x else y else y")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MEASURABLE_ON_CASES THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"{x | x IN s} = s"), MEASURABLE_ON_0] THEN
      ASM_SIMP_TAC [INTEGRABLE_IMP_MEASURABLE,
                    ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
      X_GEN_TAC (← q r"x:real^M") THEN ASM_CASES_TAC (← q r"(x:real^M) IN t") THEN
      ASM_REWRITE_TAC [REAL_LE_REFL, LIFT_DROP, NORM_0, NORM_POS_LE]])

  let ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!f:real^M->real^N s t.
        f absolutely_integrable_on s /\ t SUBSET s /\ lebesgue_measurable t
        ==> f absolutely_integrable_on t"
   (MESON_TAC [ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_INTER,
               ← SET_RULE (← q r"s SUBSET t ==> s = t INTER s")])

  pure { MEASURABLE_ON_INDICATOR, MEASURABLE_ON_INDICATOR_SUBSET,
         MEASURABLE_IMP_LEBESGUE_MEASURABLE, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE,
         LEBESGUE_MEASURABLE_EMPTY, LEBESGUE_MEASURABLE_UNIV, LEBESGUE_MEASURABLE_COMPACT,
         LEBESGUE_MEASURABLE_BALL, LEBESGUE_MEASURABLE_CBALL, LEBESGUE_MEASURABLE_INTERVAL,
         LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_UNION, LEBESGUE_MEASURABLE_DIFF,
         LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_ON_SUBINTERVALS,
         LEBESGUE_MEASURABLE_CLOSED, LEBESGUE_MEASURABLE_OPEN, LEBESGUE_MEASURABLE_OPEN_IN,
         LEBESGUE_MEASURABLE_CLOSED_IN, LEBESGUE_MEASURABLE_UNIONS,
         LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
         LEBESGUE_MEASURABLE_COUNTABLE_INTERS, LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT,
         LEBESGUE_MEASURABLE_INTERS, GDELTA_IMP_LEBESGUE_MEASURABLE,
         FSIGMA_IMP_LEBESGUE_MEASURABLE, BOREL_IMP_LEBESGUE_MEASURABLE,
         LEBESGUE_MEASURABLE_IFF_MEASURABLE, LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS,
         LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS,
         MEASURABLE_ON_MEASURABLE_SUBSET, LEBESGUE_MEASURABLE_JORDAN,
         LEBESGUE_MEASURABLE_CONVEX, LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF,
         LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ, LEBESGUE_MEASURABLE_INSERT,
         LEBESGUE_MEASURABLE_DELETE, LEBESGUE_MEASURABLE_SING,
         ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_INTER,
         ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Invariance theorems for Lebesgue measurability.  (measure.ml 9687-9820)  -/
/- ------------------------------------------------------------------------- -/

structure MSAN where
  MEASURABLE_ON_TRANSLATION : thm
  MEASURABLE_ON_TRANSLATION_EQ : thm
  NEGLIGIBLE_LINEAR_IMAGE_GEN : thm
  MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN : thm
  MEASURABLE_ON_LINEAR_IMAGE_EQ : thm
  LEBESGUE_MEASURABLE_TRANSLATION : thm
  LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ : thm
  MEASURABLE_ON_REFLECT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAN [HolBase] (D : MeasureDeps) (BMSE : MSE) (BMSAB : MSAB) (BMSAJ : MSAJ) (BMSAM : MSAM) : ExceptT String IO MSAN := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_TRANSLATION_EQ, .. } := BMSE
  let { lebesgue_measurable, measurable_on, .. } := BMSAB
  let { NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE, .. } := BMSAJ
  let { LEBESGUE_MEASURABLE_IFF_MEASURABLE, LEBESGUE_MEASURABLE_ON_SUBINTERVALS,
        .. } := BMSAM
  let { DIFFERENTIABLE_ON_LINEAR, .. } := D.qderivatives
  let { LINEAR_INJECTIVE_IMP_SURJECTIVE, LINEAR_SURJECTIVE_IFF_INJECTIVE_GEN, .. } := D.qvec
  let { indicator, .. } := D.ig.qvec
  let { LINEAR_BIJECTIVE_LEFT_RIGHT_INVERSE, .. } := D.ig.dv.dg.qvec
  let { add_linear_invariants, add_translation_invariants, ASM_MESON_TAC,
        GEOM_TRANSLATE_TAC, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_ASSOC, EQ_IMP, ETA_AX, EXTENSION, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_IMAGE, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { o_DEF, o_THM, SUBSET_UNIV, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { linear, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let MEASURABLE_ON_TRANSLATION ← prove
   r"!f:real^M->real^N s a.
          f measurable_on (IMAGE (\x. a + x) s)
          ==> (\x. f(a + x)) measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [measurable_on, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"g:num->real^M->real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"IMAGE (\x:real^M. --a + x) k") THEN
    EXISTS_TAC (← q r"\n. (g:num->real^M->real^N) n o (\x. a + x)") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_TRANSLATION_EQ] THEN CONJ_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      X_GEN_TAC (← q r"x:real^M") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a + x:real^M")) THEN
      REWRITE_TAC [o_DEF, IN_IMAGE] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = --a + y <=> a + x = y")] THEN
      REWRITE_TAC [UNWIND_THM1, ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")]])

  let MEASURABLE_ON_TRANSLATION_EQ ← prove
   r"!f:real^M->real^N s a.
        (\x. f(a + x)) measurable_on s <=>
        f measurable_on (IMAGE (\x. a + x) s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [MEASURABLE_ON_TRANSLATION] THEN
    MP_TAC (← ISPECL [← q r"\x. (f:real^M->real^N) (a + x)",
                     ← q r"IMAGE (\x:real^M. a + x) s", ← q r"--a:real^M"]
      MEASURABLE_ON_TRANSLATION) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ETA_AX, IMAGE_ID, ← VECTOR_ARITH
     (← q r"--a + a + x:real^N = x /\ a + --a + x = x")])

  let NEGLIGIBLE_LINEAR_IMAGE_GEN ← prove
   r"!f:real^M->real^N s.
        linear f /\ negligible s /\ dimindex(:M) <= dimindex(:N)
        ==> negligible (IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_ON_LINEAR])

  let MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN ← (do
    let lemma ← prove
     r"!f:real^N->real^P g:real^M->real^N h s.
        dimindex(:M) = dimindex(:N) /\
        linear g /\ linear h /\ (!x. h(g x) = x) /\ (!x. g(h x) = x)
        ==> (f o g) measurable_on s ==> f measurable_on (IMAGE g s)"
     (REPEAT GEN_TAC THEN REWRITE_TAC [measurable_on] THEN
      STRIP_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool")
       (X_CHOOSE_THEN (← q r"G:num->real^M->real^P") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"IMAGE (g:real^M->real^N) k") THEN
      EXISTS_TAC (← q r"\n x. (G:num->real^M->real^P) n ((h:real^N->real^M) x)") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_LINEAR_IMAGE_GEN THEN
        ASM_MESON_TAC [LE_REFL],
        GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_MESON_TAC [LINEAR_CONTINUOUS_ON, CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(h:real^N->real^M) y")) THEN
        ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        ASM_REWRITE_TAC [o_THM] THEN
        AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []])
    prove
     r"!f:real^M->real^N h:real^N->real^P s.
        dimindex(:M) = dimindex(:N) /\ linear f /\ (!x y. f x = f y ==> x = y)
        ==> ((h o f) measurable_on s <=> h measurable_on (IMAGE f s))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"f:real^M->real^N") LINEAR_INJECTIVE_LEFT_INVERSE) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, FUN_EQ_THM, o_THM, I_THM] THEN
      X_GEN_TAC (← q r"g:real^N->real^M") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!y:real^N. (f:real^M->real^N) ((g:real^N->real^M) y) = y")
      ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"IMAGE (f:real^M->real^N) UNIV = UNIV") MP_TAC THENL
         [ALL_TAC, ASM SET_TAC []] THEN
        REWRITE_TAC [EXTENSION, IN_UNIV, IN_IMAGE] THEN
        ASM_MESON_TAC [LINEAR_SURJECTIVE_IFF_INJECTIVE_GEN],
        ALL_TAC] THEN
      EQ_TAC THENL [ASM_MESON_TAC [lemma], DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"(h:real^N->real^P) o (f:real^M->real^N)",
                       ← q r"g:real^N->real^M", ← q r"f:real^M->real^N",
                       ← q r"IMAGE (f:real^M->real^N) s"] lemma) THEN
      ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID, ETA_AX] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC []))

  let MEASURABLE_ON_LINEAR_IMAGE_EQ ← prove
   r"!f:real^N->real^N h:real^N->real^P s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> ((h o f) measurable_on s <=> h measurable_on (IMAGE f s))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN THEN
    ASM_MESON_TAC [])

  let LEBESGUE_MEASURABLE_TRANSLATION ← prove
   r"!a:real^N s.
     lebesgue_measurable (IMAGE (\x. a + x) s) <=>
     lebesgue_measurable s"
   (ONCE_REWRITE_TAC [LEBESGUE_MEASURABLE_ON_SUBINTERVALS] THEN
    SIMP_TAC [LEBESGUE_MEASURABLE_IFF_MEASURABLE,
              BOUNDED_INTER, BOUNDED_INTERVAL] THEN
    GEOM_TRANSLATE_TAC [])

  add_translation_invariants [LEBESGUE_MEASURABLE_TRANSLATION]

  let LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
         ==> (lebesgue_measurable (IMAGE f s) <=>
              lebesgue_measurable s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_INJECTIVE_IMP_SURJECTIVE) THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"g:real^N->real^N") STRIP_ASSUME_TAC o
          MATCH_MP LINEAR_BIJECTIVE_LEFT_RIGHT_INVERSE) THEN
    REWRITE_TAC [lebesgue_measurable] THEN MP_TAC (← ISPECL
     [← q r"g:real^N->real^N", ← q r"indicator(s:real^N->bool)", ← q r"(:real^N)"]
     MEASURABLE_ON_LINEAR_IMAGE_EQ) THEN
    ASM_REWRITE_TAC [indicator, o_DEF] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], MATCH_MP_TAC EQ_IMP] THEN
    BINOP_TAC THENL
     [AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
      AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [],
      AP_TERM_TAC THEN ASM SET_TAC []])

  add_linear_invariants [LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ]

  let MEASURABLE_ON_REFLECT ← prove
   r"!f:real^M->real^N s.
        (\x. f(--x)) measurable_on s <=> f measurable_on (IMAGE (--) s)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    MATCH_MP_TAC MEASURABLE_ON_LINEAR_IMAGE_EQ THEN
    REWRITE_TAC [linear] THEN CONV_TAC (fun t => VECTOR_ARITH t))

  pure { MEASURABLE_ON_TRANSLATION, MEASURABLE_ON_TRANSLATION_EQ,
         NEGLIGIBLE_LINEAR_IMAGE_GEN, MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN,
         MEASURABLE_ON_LINEAR_IMAGE_EQ, LEBESGUE_MEASURABLE_TRANSLATION,
         LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ, MEASURABLE_ON_REFLECT }

/- ------------------------------------------------------------------------- -/
/- Various common equivalent forms of function measurability: preimages of -/
/- halfspaces and limits of simple functions.  (measure.ml 9821-10045)      -/
/- ------------------------------------------------------------------------- -/

structure MSAO where
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT : thm
  MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAO [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAF : MSAF) (BMSAM : MSAM) : ExceptT String IO MSAO := do
  -- @@SCOPE BEGIN
  let { lebesgue_measurable, .. } := BMSAB
  let { MEASURABLE_ON_CMUL, MEASURABLE_ON_CONST, MEASURABLE_ON_NEG, MEASURABLE_ON_SUB,
        .. } := BMSAD
  let { MEASURABLE_ON_COMPONENTWISE, MEASURABLE_ON_MIN, MEASURABLE_ON_VSUM, .. } := BMSAE
  let { MEASURABLE_ON_LIMIT, .. } := BMSAF
  let { LEBESGUE_MEASURABLE_DIFF, .. } := BMSAM
  let { NEGLIGIBLE_EMPTY, .. } := D.qintegration3
  let { REAL_EQ_INTEGERS, REAL_FLOOR_LE, .. } := D.qfloor
  let { FINITE_CART, MULT_2, REAL_ARCH_POW, .. } := D.qsession
  let { IN_IMAGE_LIFT_DROP, .. } := D.qvec
  let { FLOOR, INTEGER_CLOSED, REAL_LE_FLOOR, .. } := D.ig.qfloor
  let { REAL_ABS_BOUNDS, REAL_POW_ADD, .. } := D.ig.qsession
  let { DIST_REAL, indicator, LIFT_EQ_CMUL, .. } := D.ig.qvec
  let { REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { LIM_COMPONENTWISE_LIFT, .. } := D.ig.dv.qtopology2
  let { REAL_ABS_POW, REAL_POW_MONO, .. } := D.ig.dv.dg.qsession
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_INTSEG, .. } := D.ig.dv.dg.pt.qfloor
  let { ARITH, DIMINDEX_1, EQ_TRANS, ETA_AX, FINITE_IMAGE, FINITE_SUBSET, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIV, LAMBDA_BETA, MONO_EXISTS, NOT_IN_EMPTY,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_RID, REAL_ARCH_INV, REAL_ARCH_POW_INV,
        REAL_DIV_LMUL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_TRANS, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, REAL_LT_LCANCEL_IMP, REAL_LT_LDIV_EQ, REAL_LT_NEG2, REAL_LT_POW2,
        REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE,
        REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POS,
        REAL_POW_EQ_0, REAL_POW_INV, REAL_POW_LE, REAL_SUB_LDISTRIB, REAL_SUB_LT,
        REAL_SUB_REFL, RIGHT_IMP_EXISTS_THM, SING_SUBSET, SKOLEM_THM, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_div, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, LIFT_DROP, LIFT_NUM, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VECTOR_NEG_COMPONENT, VECTOR_SUB_COMPONENT, VSUM_EQ_0, VSUM_SING, VSUM_SUPERSET,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let (MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT,
       MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT) ← CONJ_PAIR (← (do
    let lemma0 ← prove
     r"!f:real^M->real^1 n m.
          integer m /\
          m / &2 pow n <= drop(f x) /\
          drop(f x) < (m + &1) / &2 pow n /\
          abs(m) <= &2 pow (2 * n)
          ==> vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
                   (\k. k / &2 pow n %
                        indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                              drop(f y) < (k + &1) / &2 pow n}
                                  x) =
              lift(m / &2 pow n)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"vsum {m} (\k. k / &2 pow n %
                    indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                          drop(f y) < (k + &1) / &2 pow n}
                              x)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VSUM_SUPERSET THEN
        ASM_REWRITE_TAC [SING_SUBSET, IN_ELIM_THM, IN_SING] THEN
        X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
        ASM_REWRITE_TAC [indicator, IN_ELIM_THM] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN
        UNDISCH_TAC (← q r"~(k:real = m)") THEN ASM_SIMP_TAC [REAL_EQ_INTEGERS] THEN
        POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        REAL_ARITH_TAC,
        ASM_REWRITE_TAC [VSUM_SING, indicator, IN_ELIM_THM, LIFT_EQ_CMUL]])
    let lemma1 ← prove
     r"!f:real^M->real^1.
          (!a b. lebesgue_measurable {x | a <= drop(f x) /\ drop(f x) < b})
          ==> ?g. (!n. (g n) measurable_on (:real^M)) /\
                  (!n. FINITE(IMAGE (g n) (:real^M))) /\
                  (!x. ((\n. g n x) --> f x) sequentially)"
     (REPEAT STRIP_TAC THEN
      EXISTS_TAC
       (← q r"\n x. vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
                 (\k. k / &2 pow n %
                      indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                            drop(f y) < (k + &1) / &2 pow n}
                                x)") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC MEASURABLE_ON_VSUM THEN
        REWRITE_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, IN_ELIM_THM] THEN
        GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_CMUL THEN
        ASM_REWRITE_TAC [← GSYM lebesgue_measurable, ETA_AX],
        X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (\k. lift(k / &2 pow n))
                        {k | integer k /\ abs(k) <= &2 pow (2 * n)}") THEN
        CONJ_TAC THENL
         [SIMP_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, FINITE_IMAGE],
          ALL_TAC] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_IMAGE] THEN
        ASM_CASES_TAC
         (← q r"?k. integer k /\ abs k <= &2 pow (2 * n) /\
            k / &2 pow n <= drop(f(x:real^M)) /\
            drop(f x) < (k + &1) / &2 pow n")
        THENL
         [FIRST_X_ASSUM (fun th => MP_TAC th THEN MATCH_MP_TAC MONO_EXISTS) THEN
          X_GEN_TAC (← q r"m:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
          MATCH_MP_TAC lemma0 THEN ASM_REWRITE_TAC [],
          EXISTS_TAC (← q r"&0") THEN
          ASM_REWRITE_TAC [IN_ELIM_THM, INTEGER_CLOSED, REAL_ABS_NUM] THEN
          SIMP_TAC [REAL_POW_LE, REAL_POS, real_div, REAL_MUL_LZERO] THEN
          REWRITE_TAC [LIFT_NUM, ← GSYM real_div] THEN
          MATCH_MP_TAC VSUM_EQ_0 THEN
          X_GEN_TAC (← q r"k:real") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
          REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
          REWRITE_TAC [indicator, IN_ELIM_THM] THEN ASM_MESON_TAC []],
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        MP_TAC (← ISPECL [← q r"&2", ← q r"abs(drop((f:real^M->real^1) x))"]
            REAL_ARCH_POW) THEN
        ANTS_TAC THENL [REAL_ARITH_TAC, DISCH_THEN (X_CHOOSE_TAC (← q r"N1:num"))] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
        REWRITE_TAC [REAL_POW_INV] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") MP_TAC) THEN
        SUBST1_TAC (← REAL_ARITH (← q r"inv(&2 pow N2) = &1 / &2 pow N2")) THEN
        SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_POW2] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"MAX N1 N2") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        ABBREV_TAC (← q r"m = floor(&2 pow n * drop(f(x:real^M)))") THEN
        SUBGOAL_THEN (← q r"dist(lift(m / &2 pow n),(f:real^M->real^1) x) < e")
        MP_TAC THENL
         [REWRITE_TAC [DIST_REAL, ← GSYM drop, LIFT_DROP] THEN
          MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN EXISTS_TAC (← q r"abs(&2 pow n)") THEN
          REWRITE_TAC [← GSYM REAL_ABS_MUL, REAL_SUB_LDISTRIB] THEN
          SIMP_TAC [REAL_DIV_LMUL, REAL_POW_EQ_0, ← GSYM REAL_ABS_NZ,
                    REAL_OF_NUM_EQ, ARITH] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"x <= y /\ y < x + &1 /\ &1 <= z ==> abs(x - y) < z")) THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"e * &2 pow N2") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_ABS_POW, REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"x:real^1 = y ==> dist(y,z) < e ==> dist(x,z) < e")) THEN
          MATCH_MP_TAC lemma0 THEN
          SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          SIMP_TAC [REAL_ABS_BOUNDS, REAL_LE_FLOOR, REAL_FLOOR_LE,
                    INTEGER_CLOSED] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) <= e ==> --e <= x /\ x - &1 < e")) THEN
          REWRITE_TAC [MULT_2, REAL_POW_ADD, REAL_ABS_MUL, REAL_ABS_POW,
                       REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN SIMP_TAC [REAL_POW_LE, REAL_POS] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"x < e ==> e <= d ==> x <= d")))] THEN
        MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_ARITH_TAC])
    prove
     r"(!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a k. 1 <= k /\ k <= dimindex(:N)
              ==> lebesgue_measurable {x | f(x)$k < a}) /\
   (!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        ?g. (!n. (g n) measurable_on (:real^M)) /\
            (!n. FINITE(IMAGE (g n) (:real^M))) /\
            (!x. ((\n. g n x) --> f x) sequentially))"
     (MATCH_MP_TAC (← MESON []
       (← q r"(!f. P f ==> Q f) /\ (!f. Q f ==> R f) /\ (!f. R f ==> P f)
    ==> (!f. P f <=> Q f) /\ (!f. P f <=> R f)")) THEN
      REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"g:real^M->real^N") THEN DISCH_TAC THEN
        ABBREV_TAC (← q r"f:real^M->real^N = \x. --(g x)") THEN
        SUBGOAL_THEN (← q r"(f:real^M->real^N) measurable_on (:real^M)") ASSUME_TAC THENL
         [EXPAND_TAC "f" THEN MATCH_MP_TAC MEASURABLE_ON_NEG THEN ASM_SIMP_TAC [],
          ALL_TAC] THEN
        ONCE_REWRITE_TAC [← GSYM REAL_LT_NEG2] THEN X_GEN_TAC (← q r"a:real") THEN
        SPEC_TAC (← q r"--a:real", ← q r"a:real") THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FUN_EQ_THM]) THEN
        SIMP_TAC [← GSYM VECTOR_NEG_COMPONENT] THEN DISCH_THEN (K ALL_TAC) THEN
        REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num") o
          GEN_REWRITE_RULE I [MEASURABLE_ON_COMPONENTWISE]) THEN
        ASM_REWRITE_TAC [] THEN  REPEAT STRIP_TAC THEN
        MP_TAC (← GEN (← q r"d:real") (← ISPECL
         [← q r"\x. lift ((f:real^M->real^N) x$k)",
          ← q r"(\x. lift a + (lambda i. d)):real^M->real^1",
          ← q r"(:real^M)"] MEASURABLE_ON_MIN)) THEN
        ASM_REWRITE_TAC [MEASURABLE_ON_CONST] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← GEN (← q r"n:num") (← ISPEC (← q r"&n + &1")
            (← MATCH_MP MEASURABLE_ON_CMUL
              (← MATCH_MP MEASURABLE_ON_SUB
                (← CONJ (← SPEC (← q r"inv(&n + &1)") th)
                        (← SPEC (← q r"&0") th)))))))) THEN
        REWRITE_TAC [lebesgue_measurable, indicator] THEN
        DISCH_THEN (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
              MEASURABLE_ON_LIMIT)) THEN
        EXISTS_TAC (← q r"{}:real^M->bool") THEN
        REWRITE_TAC [NEGLIGIBLE_EMPTY, IN_DIFF, IN_UNIV, NOT_IN_EMPTY] THEN
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN
        SIMP_TAC [LIM_SEQUENTIALLY, DIST_REAL, VECTOR_MUL_COMPONENT,
                  VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
                  LAMBDA_BETA, DIMINDEX_1, ARITH] THEN
        REWRITE_TAC [← GSYM drop, LIFT_DROP, REAL_ADD_RID] THEN
        SIMP_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1"), ← REAL_ARITH
         (← q r"&0 < d ==> (min x (a + d) - min x a =
                  if x <= a then &0 else if x <= a + d then x - a else d)")] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"a < (f:real^M->real^N) x $k") THEN ASM_REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"(x:real^N)$k <= a <=> ~(a < x$k)")] THEN
        ASM_REWRITE_TAC [REAL_MUL_RZERO, DROP_VEC, REAL_SUB_REFL, REAL_ABS_NUM] THEN
        MP_TAC (← SPEC (← q r"((f:real^M->real^N) x)$k - a") REAL_ARCH_INV) THEN
        ASM_REWRITE_TAC [REAL_SUB_LT] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"a + inv(&n + &1) < ((f:real^M->real^N) x)$k") ASSUME_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"N < f - a ==> n <= N ==> a + n < f"))) THEN
          MATCH_MP_TAC REAL_LE_INV2 THEN
          REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
          ASM_ARITH_TAC,
          ASM_SIMP_TAC [REAL_MUL_RINV, ← REAL_ARITH (← q r"~(&n + &1 = &0)")] THEN
          ASM_REAL_ARITH_TAC],
        REPEAT STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"!k. 1 <= k /\ k <= dimindex(:N)
          ==> ?g. (!n. (g n) measurable_on (:real^M)) /\
                  (!n. FINITE(IMAGE (g n) (:real^M))) /\
                  (!x. ((\n. g n x) --> lift((f x:real^N)$k)) sequentially)")
        MP_TAC THENL
         [REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma1 THEN
          ASM_SIMP_TAC [LIFT_DROP] THEN
          MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN
          REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | Q x} DIFF {x | ~P x}")] THEN
          MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN
          ASM_SIMP_TAC [REAL_NOT_LE],
          GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
        REWRITE_TAC [SKOLEM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->num->real^M->real^1") MP_TAC) THEN
        REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
        REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
        EXISTS_TAC
          (← q r"\n x. (lambda k. drop((g:num->num->real^M->real^1) k n x)):real^N") THEN
        REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [X_GEN_TAC (← q r"n:num") THEN ONCE_REWRITE_TAC [MEASURABLE_ON_COMPONENTWISE] THEN
          X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
          ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX],
          X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC FINITE_SUBSET THEN
          EXISTS_TAC (← q r"{x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                        ==> lift(x$i) IN IMAGE (g i (n:num)) (:real^M)}") THEN
          ASM_SIMP_TAC [← GSYM IN_IMAGE_LIFT_DROP, ← SET_RULE (← q r"{x | x IN s} = s"),
                        FINITE_IMAGE, FINITE_CART] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
          SIMP_TAC [IN_IMAGE, IN_UNIV, LAMBDA_BETA, DROP_EQ] THEN MESON_TAC [],
          X_GEN_TAC (← q r"x:real^M") THEN ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT] THEN
          X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
          ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX]],
        X_GEN_TAC (← q r"f:real^M->real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
        MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN
        MAP_EVERY EXISTS_TAC [← q r"g:num->real^M->real^N", ← q r"{}:real^M->bool"] THEN
        ASM_REWRITE_TAC [NEGLIGIBLE_EMPTY]])))

  pure { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT,
         MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Measurability via preimages of halfspaces, intervals, open, closed and  -/
/- Borel sets, and orthants.  (measure.ml 10046-10287)                      -/
/- ------------------------------------------------------------------------- -/

structure MSAP where
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE : thm
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT : thm
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE : thm
  MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL : thm
  MEASURABLE_ON_PREIMAGE_OPEN : thm
  MEASURABLE_ON_PREIMAGE_CLOSED : thm
  MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL : thm
  MEASURABLE_ON_PREIMAGE_BOREL : thm
  LEBESGUE_MEASURABLE_PREIMAGE_OPEN : thm
  LEBESGUE_MEASURABLE_PREIMAGE_CLOSED : thm
  LEBESGUE_MEASURABLE_PREIMAGE_BOREL : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_LE : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_GE : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_LT : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_GT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAP [HolBase] (D : MeasureDeps) (BMSAD : MSAD) (BMSAM : MSAM) (BMSAO : MSAO) : ExceptT String IO MSAP := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_NEG, MEASURABLE_ON_NEG_EQ, .. } := BMSAD
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
        LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_INTERS, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { NUM_COUNTABLE, .. } := D.qcard
  let { CLOSED_INTERVAL_LEFT, .. } := D.qtopology1
  let { borel_INDUCT, OPEN_COUNTABLE_UNION_OPEN_INTERVALS, OPEN_IMP_BOREL,
        OPEN_INTERVAL_LEFT, .. } := D.qtopology2
  let { REAL_SUP_LE_FINITE, .. } := D.ig.qsession
  let { OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, .. } := D.ig.qtopology
  let { COMPL_COMPL, .. } := D.ig.dv.dg.qsession
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { DIMINDEX_GE_1, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_LE, NUMSEG_EMPTY, REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LT_NEG2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NEG_NEG, SIMPLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_gt, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { OPEN_HALFSPACE_COMPONENT_LT, .. } := D.ig.dv.dg.pt.cvx.top4
  let { closed, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a k. 1 <= k /\ k <= dimindex(:N)
              ==> lebesgue_measurable {x | f(x)$k >= a}"
   (GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"x >= a <=> ~(x < a)")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT])

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a k. 1 <= k /\ k <= dimindex(:N)
              ==> lebesgue_measurable {x | f(x)$k > a}"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT] THEN
    GEN_REWRITE_TAC LAND_CONV
     [← MESON [REAL_NEG_NEG] (← q r"(!x. P x) <=> (!x:real. P(--x))")] THEN
    REWRITE_TAC [real_gt, VECTOR_NEG_COMPONENT, REAL_LT_NEG2])

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a k. 1 <= k /\ k <= dimindex(:N)
              ==> lebesgue_measurable {x | f(x)$k <= a}"
   (GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"x <= a <=> ~(x > a)")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT])

  let (MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL,
       MEASURABLE_ON_PREIMAGE_OPEN) ← CONJ_PAIR (← (do
    let ulemma ← prove
     r"{x | f x IN UNIONS D} = UNIONS {{x | f(x) IN s} | s IN D}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"(!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a b. lebesgue_measurable {x | f(x) IN interval(a,b)}) /\
   (!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !t. open t ==> lebesgue_measurable {x | f(x) IN t})"
     (MATCH_MP_TAC (← MESON []
       (← q r"(!f. P f ==> Q f) /\ (!f. Q f ==> R f) /\ (!f. R f ==> P f)
    ==> (!f. P f <=> Q f) /\ (!f. P f <=> R f)")) THEN
      REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN SUBGOAL_THEN
        (← q r"{x | (f:real^M->real^N) x IN interval(a,b)} =
        INTERS {{x | a$k < f(x)$k} | k IN 1..dimindex(:N)} INTER
        INTERS {{x | (--b)$k < --(f(x))$k} | k IN 1..dimindex(:N)}")
        SUBST1_TAC THENL
         [REWRITE_TAC [IN_INTERVAL, ← GSYM IN_NUMSEG] THEN
          REWRITE_TAC [VECTOR_NEG_COMPONENT, REAL_LT_NEG2] THEN
          REWRITE_TAC [INTERS_GSPEC] THEN SET_TAC [],
          MATCH_MP_TAC LEBESGUE_MEASURABLE_INTER THEN
          CONJ_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_INTERS THEN
          SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
          REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THENL
           [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
             [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT]),
            FIRST_X_ASSUM (MP_TAC o MATCH_MP MEASURABLE_ON_NEG) THEN
            REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT]] THEN
          ASM_SIMP_TAC [real_gt]],
        REPEAT STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_COUNTABLE_UNION_OPEN_INTERVALS) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"D:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN ONCE_REWRITE_TAC [ulemma] THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"i:real^N->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:real^N->bool")) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM],
        REPEAT STRIP_TAC THEN
        REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT] THEN
        REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← SET_RULE
          (← q r"{x:real^M | (f x)$k < a} = {x | f x IN {y:real^N | y$k < a}}")] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [OPEN_HALFSPACE_COMPONENT_LT]])))

  let MEASURABLE_ON_PREIMAGE_CLOSED ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !t. closed t ==> lebesgue_measurable {x | f(x) IN t}"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM LEBESGUE_MEASURABLE_COMPL, closed] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"UNIV DIFF {x | f x IN t} = {x | f x IN (UNIV DIFF t)}")] THEN
    REWRITE_TAC [← MESON [COMPL_COMPL]
     (← q r"(!s. P(UNIV DIFF s)) <=> (!s. P s)")] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_OPEN])

  let MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL ← (do
    let ulemma ← prove
     r"{x | f x IN UNIONS D} = UNIONS {{x | f(x) IN s} | s IN D}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!f:real^M->real^N.
         f measurable_on (:real^M) <=>
         !a b. lebesgue_measurable {x | f(x) IN interval[a,b]}"
     (GEN_TAC THEN EQ_TAC THENL
       [SIMP_TAC [MEASURABLE_ON_PREIMAGE_CLOSED, CLOSED_INTERVAL], DISCH_TAC] THEN
      REWRITE_TAC [MEASURABLE_ON_PREIMAGE_OPEN] THEN REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"D:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN ONCE_REWRITE_TAC [ulemma] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"i:real^N->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM]))

  let MEASURABLE_ON_PREIMAGE_BOREL ← (do
    let lemma ← prove
     r"{x | f x IN UNIONS u} = UNIONS {{x | f x IN t} | t IN u}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !t. borel t ==> lebesgue_measurable {x | f x IN t}"
     (GEN_TAC THEN EQ_TAC THENL
       [DISCH_TAC, MESON_TAC [MEASURABLE_ON_PREIMAGE_OPEN, OPEN_IMP_BOREL]] THEN
      MATCH_MP_TAC borel_INDUCT THEN
      ASM_REWRITE_TAC [← GSYM MEASURABLE_ON_PREIMAGE_OPEN] THEN
      REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL, lemma,
        ← SET_RULE (← q r"{x | f x IN UNIV DIFF t} = UNIV DIFF {x | f x IN t}")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE]))

  let LEBESGUE_MEASURABLE_PREIMAGE_OPEN ← prove
   r"!f:real^M->real^N t.
        f measurable_on (:real^M) /\ open t
        ==> lebesgue_measurable {x | f(x) IN t}"
   (SIMP_TAC [MEASURABLE_ON_PREIMAGE_OPEN])

  let LEBESGUE_MEASURABLE_PREIMAGE_CLOSED ← prove
   r"!f:real^M->real^N t.
        f measurable_on (:real^M) /\ closed t
        ==> lebesgue_measurable {x | f(x) IN t}"
   (SIMP_TAC [MEASURABLE_ON_PREIMAGE_CLOSED])

  let LEBESGUE_MEASURABLE_PREIMAGE_BOREL ← prove
   r"!f:real^M->real^N t.
        f measurable_on (:real^M) /\ borel t
        ==> lebesgue_measurable {x | f(x) IN t}"
   (SIMP_TAC [MEASURABLE_ON_PREIMAGE_BOREL])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_LE ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a. lebesgue_measurable {x | !k. 1 <= k /\ k <= dimindex(:N)
                                         ==> f(x)$k <= (a:real^N)$k}"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [GEN_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | !k. P k ==> f x$k <= a k} =
                     {x | f(x) IN {y | !k. P k ==> y$k <= a k}}")] THEN
      FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
          [MEASURABLE_ON_PREIMAGE_CLOSED]) THEN
      REWRITE_TAC [CLOSED_INTERVAL_LEFT],
      REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"k:num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | (f:real^M->real^N) x$k <= a} =
      UNIONS
       {{x | !j. 1 <= j /\ j <= dimindex(:N) ==>
                 f x$j <= ((lambda i. if i = k then a else &n):real^N)$j} |
        n IN (:num)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN SIMP_TAC [LAMBDA_BETA] THEN
        SPEC_TAC (← q r"(f:real^M->real^N) x", ← q r"y:real^N") THEN GEN_TAC THEN
        ASM_CASES_TAC (← q r"(y:real^N)$k <= a") THENL [ALL_TAC, ASM_MESON_TAC []] THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← SPEC
         (← q r"sup {(y:real^N)$j | j IN 1..dimindex(:N)}") REAL_ARCH_SIMPLE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN
        SIMP_TAC [REAL_SUP_LE_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1]  THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE,
                      FORALL_IN_IMAGE]]])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_GE ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a. lebesgue_measurable {x | !k. 1 <= k /\ k <= dimindex(:N)
                                         ==> f(x)$k >= (a:real^N)$k}"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_ORTHANT_LE] THEN
    GEN_REWRITE_TAC LAND_CONV
     [← MESON [VECTOR_NEG_NEG] (← q r"(!x:real^N. P x) <=> (!x. P(--x))")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--x <= --y <=> x >= y"), VECTOR_NEG_COMPONENT])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_LT ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a. lebesgue_measurable {x | !k. 1 <= k /\ k <= dimindex(:N)
                                         ==> f(x)$k < (a:real^N)$k}"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [GEN_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{x | !k. P k ==> f x$k < a k} =
                     {x | f(x) IN {y | !k. P k ==> y$k < a k}}")] THEN
      FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
          [MEASURABLE_ON_PREIMAGE_OPEN]) THEN
      REWRITE_TAC [OPEN_INTERVAL_LEFT],
      REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"k:num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | (f:real^M->real^N) x$k < a} =
      UNIONS
       {{x | !j. 1 <= j /\ j <= dimindex(:N) ==>
                 f x$j < ((lambda i. if i = k then a else &n):real^N)$j} |
        n IN (:num)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN SIMP_TAC [LAMBDA_BETA] THEN
        SPEC_TAC (← q r"(f:real^M->real^N) x", ← q r"y:real^N") THEN GEN_TAC THEN
        ASM_CASES_TAC (← q r"(y:real^N)$k < a") THENL [ALL_TAC, ASM_MESON_TAC []] THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← SPEC
         (← q r"&1 + sup {(y:real^N)$j | j IN 1..dimindex(:N)}") REAL_ARCH_SIMPLE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&1 + x <= y <=> x <= y - &1")] THEN
        SIMP_TAC [REAL_SUP_LE_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1]  THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN
        ASM_MESON_TAC [← REAL_ARITH (← q r"x <= y - &1 ==> x < y")],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE,
                      FORALL_IN_IMAGE]]])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_GT ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !a. lebesgue_measurable {x | !k. 1 <= k /\ k <= dimindex(:N)
                                         ==> f(x)$k > (a:real^N)$k}"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_ORTHANT_LT] THEN
    GEN_REWRITE_TAC LAND_CONV
     [← MESON [VECTOR_NEG_NEG] (← q r"(!x:real^N. P x) <=> (!x. P(--x))")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--x < --y <=> x > y"), VECTOR_NEG_COMPONENT])

  pure { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE,
         MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT,
         MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE,
         MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL, MEASURABLE_ON_PREIMAGE_OPEN,
         MEASURABLE_ON_PREIMAGE_CLOSED, MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL,
         MEASURABLE_ON_PREIMAGE_BOREL, LEBESGUE_MEASURABLE_PREIMAGE_OPEN,
         LEBESGUE_MEASURABLE_PREIMAGE_CLOSED, LEBESGUE_MEASURABLE_PREIMAGE_BOREL,
         MEASURABLE_ON_PREIMAGE_ORTHANT_LE, MEASURABLE_ON_PREIMAGE_ORTHANT_GE,
         MEASURABLE_ON_PREIMAGE_ORTHANT_LT, MEASURABLE_ON_PREIMAGE_ORTHANT_GT }

/- ------------------------------------------------------------------------- -/
/- Nonnegative measurable functions are increasing limits of simple        -/
/- functions.  (measure.ml 10288-10554)                                     -/
/- ------------------------------------------------------------------------- -/

structure MSAQ where
  MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT_INCREASING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAQ [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAO : MSAO) : ExceptT String IO MSAQ := do
  -- @@SCOPE BEGIN
  let { lebesgue_measurable, measurable_on, .. } := BMSAB
  let { MEASURABLE_ON_CMUL, .. } := BMSAD
  let { MEASURABLE_ON_VSUM, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_DIFF, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT,
        .. } := BMSAO
  let { REAL_EQ_INTEGERS, REAL_FLOOR_LE, REAL_LT_INTEGERS, .. } := D.qfloor
  let { integer, MULT_2, REAL_ARCH_POW, REAL_EQ_ADD_RCANCEL, .. } := D.qsession
  let { FLOOR, INTEGER_CLOSED, REAL_LE_FLOOR, .. } := D.ig.qfloor
  let { REAL_ABS_BOUNDS, REAL_POW_ADD, SUM_SUBSET, .. } := D.ig.qsession
  let { DIST_REAL, DROP_INDICATOR_POS_LE, indicator, LIFT_EQ_CMUL, VSUM_REAL,
        .. } := D.ig.qvec
  let { REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { EVEN_MULT, REAL_ABS_POW, REAL_LE_POW2, REAL_POW_MONO, TRANSITIVE_STEPWISE_LE,
        .. } := D.ig.dv.dg.qsession
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { REAL_EQ_MUL_LCANCEL, .. } := D.ig.dv.dg.pt.qses
  let { FINITE_INTSEG, .. } := D.ig.dv.dg.pt.qfloor
  let { ARITH, CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_1, EQ_TRANS, ETA_AX, FINITE_IMAGE,
        FINITE_SUBSET, FINITE_UNION, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIV, LE_ADD, MONO_EXISTS, NOT_EXISTS_THM,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_LDISTRIB, REAL_ARCH_POW_INV, REAL_DIV_LMUL,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_INV_MUL, REAL_LE_DIV, REAL_LE_DIV2_EQ,
        REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RMUL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_LCANCEL_IMP, REAL_LT_LDIV_EQ, REAL_LT_POW2,
        REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_EQ,
        REAL_OF_NUM_MUL, REAL_POS, REAL_POW_EQ_0, REAL_POW_INV, REAL_POW_LE,
        REAL_SUB_LDISTRIB, REAL_SUB_LT, SING_SUBSET, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, real_pow, SUM_ADD, SUM_EQ, SUM_IMAGE, SUM_LE, SUM_POS_LE,
        SUM_UNION, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_SUB, DROP_VEC, FORALL_1, LIFT_DROP, LIFT_NUM,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_MUL_EQ_0, VSUM_EQ_0, VSUM_SING, VSUM_SUPERSET,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT_INCREASING ← (do
    let lemma ← prove
     r"!f:real^M->real^1 n m.
          integer m /\
          m / &2 pow n <= drop(f x) /\
          drop(f x) < (m + &1) / &2 pow n /\
          abs(m) <= &2 pow (2 * n)
          ==> vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
                   (\k. k / &2 pow n %
                        indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                              drop(f y) < (k + &1) / &2 pow n}
                                  x) =
              lift(m / &2 pow n)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"vsum {m} (\k. k / &2 pow n %
                    indicator {y:real^M | k / &2 pow n <= drop(f y) /\
                                          drop(f y) < (k + &1) / &2 pow n}
                              x)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VSUM_SUPERSET THEN
        ASM_REWRITE_TAC [SING_SUBSET, IN_ELIM_THM, IN_SING] THEN
        X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN
        REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
        ASM_REWRITE_TAC [indicator, IN_ELIM_THM] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← TAUT (← q r"F ==> p")) THEN
        UNDISCH_TAC (← q r"~(k:real = m)") THEN ASM_SIMP_TAC [REAL_EQ_INTEGERS] THEN
        POP_ASSUM_LIST (MP_TAC o end_itlist CONJ) THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        REAL_ARITH_TAC,
        ASM_REWRITE_TAC [VSUM_SING, indicator, IN_ELIM_THM, LIFT_EQ_CMUL]])
    prove
     r"!f:real^N->real^1.
        f measurable_on (:real^N) /\ (!x. &0 <= drop(f x)) <=>
        ?g. (!n x. &0 <= drop(g n x) /\ drop(g n x) <= drop(f x)) /\
            (!n x. drop(g n x) <= drop(g(SUC n) x)) /\
            (!n. (g n) measurable_on (:real^N)) /\
            (!n. FINITE(IMAGE (g n) (:real^N))) /\
            (!x. ((\n. g n x) --> f x) sequentially)"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [STRIP_TAC,
        DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
         [GEN_REWRITE_TAC RAND_CONV [MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT] THEN
          MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
          MESON_TAC [REAL_LE_TRANS]]] THEN
      SUBGOAL_THEN
       (← q r"!a b. lebesgue_measurable {x:real^N | a <= drop(f x) /\ drop(f x) < b}")
      ASSUME_TAC THENL
       [REPEAT GEN_TAC THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | Q x} DIFF {x | ~P x}")] THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN REWRITE_TAC [REAL_NOT_LE] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
         [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT]) THEN
        SIMP_TAC [drop, FORALL_1, DIMINDEX_1],
        FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o GEN_REWRITE_RULE I [measurable_on])] THEN
      REWRITE_TAC [FORALL_AND_THM, ← GSYM CONJ_ASSOC] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!x. P x /\ R x ==> Q x) /\ (?x. P x /\ R x)
    ==> (?x. P x /\ Q x /\ R x)")) THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"g:num->real^N->real^1") THEN STRIP_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_SEQUENTIALLY] o
            SPEC (← q r"x:real^N")) THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"drop((g:num->real^N->real^1) n x - f x)")) THEN
        ASM_REWRITE_TAC [DROP_SUB, REAL_SUB_LT, NOT_EXISTS_THM] THEN
        X_GEN_TAC (← q r"N:num") THEN DISCH_THEN (MP_TAC o SPEC (← q r"N + n:num")) THEN
        REWRITE_TAC [LE_ADD, DIST_REAL, ← GSYM drop] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"f < g /\ g <= g' ==> ~(abs(g' - f) < g - f)")) THEN
        ASM_REWRITE_TAC [] THEN MP_TAC (← ARITH_RULE (← q r"n:num <= N + n")) THEN
        SPEC_TAC (← q r"N + n:num", ← q r"m:num") THEN SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM_REWRITE_TAC [] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      EXISTS_TAC
       (← q r"\n x. vsum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
               (\k. k / &2 pow n %
                    indicator {y:real^N | k / &2 pow n <= drop(f y) /\
                                          drop(f y) < (k + &1) / &2 pow n}
                              x)") THEN
      REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"!n. FINITE {k | integer k /\ abs k <= &2 pow (2 * n)}")
      ASSUME_TAC THENL
       [SIMP_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, FINITE_IMAGE],
        ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [REPEAT GEN_TAC THEN REWRITE_TAC [VSUM_REAL, LIFT_DROP, o_DEF] THEN
        MATCH_MP_TAC SUM_POS_LE THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN REWRITE_TAC [DROP_CMUL] THEN
        ASM_CASES_TAC (← q r"&0 <= k") THENL
         [MATCH_MP_TAC REAL_LE_MUL THEN
          ASM_SIMP_TAC [REAL_LE_DIV, REAL_POW_LE, REAL_POS] THEN
          REWRITE_TAC [DROP_INDICATOR_POS_LE],
          MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> &0 <= x")) THEN
          REWRITE_TAC [REAL_ENTIRE] THEN DISJ2_TAC THEN REWRITE_TAC [indicator] THEN
          COND_CASES_TAC THEN REWRITE_TAC [DROP_VEC] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_ELIM_THM]) THEN
          MATCH_MP_TAC (← TAUT (← q r"~b ==> a /\ b ==> c")) THEN
          REWRITE_TAC [REAL_NOT_LT] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"&0") THEN ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
          ASM_SIMP_TAC [← GSYM REAL_LT_INTEGERS, REAL_MUL_LZERO, INTEGER_CLOSED] THEN
          ASM_REAL_ARITH_TAC],
        REPEAT GEN_TAC THEN SIMP_TAC [VSUM_REAL, LIFT_DROP, o_DEF, DROP_CMUL] THEN
        TRANS_TAC REAL_LE_TRANS
         (← q r"sum {k | integer k /\ abs(k) <= &2 pow (2 * n)}
          (\k. k / &2 pow n *
           (drop(indicator {y:real^N | k / &2 pow n <= drop(f y) /\
                         drop(f y) < (k + &1 / &2) / &2 pow n} x) +
            drop(indicator {y:real^N | (k + &1 / &2) / &2 pow n <= drop(f y) /\
                             drop(f y) < (k + &1) / &2 pow n} x)))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC SUM_EQ THEN
          REWRITE_TAC [FORALL_IN_GSPEC] THEN
          SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
          X_GEN_TAC (← q r"k:real") THEN STRIP_TAC THEN AP_TERM_TAC THEN
          REWRITE_TAC [indicator, IN_ELIM_THM] THEN
          REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [DROP_VEC]) THEN
          ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
         [← REAL_ARITH (← q r"x / y = (&2 * x) * inv(&2) * inv(y)")] THEN
        REWRITE_TAC [← GSYM REAL_INV_MUL] THEN REWRITE_TAC [← GSYM real_div] THEN
        REWRITE_TAC [← GSYM (← CONJUNCT2 real_pow),
                     ← REAL_ARITH (← q r"&2 * (k + &1 / &2) = &2 * k + &1"),
                     ← REAL_ARITH (← q r"&2 * (k + &1) = (&2 * k + &1) + &1")] THEN
        ASM_SIMP_TAC [REAL_ADD_LDISTRIB, SUM_ADD]  THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"!g. sum s f <= sum s g /\ a + sum s g <= b ==> a + sum s f <= b")) THEN
        EXISTS_TAC
         (← q r"\k. (&2 * k + &1) / &2 pow SUC n *
          drop
          (indicator
           {y | (&2 * k + &1) / &2 pow SUC n <= drop ((f:real^N->real^1) y) /\
                drop (f y) < ((&2 * k + &1) + &1) / &2 pow SUC n} x)") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_RMUL THEN
          SIMP_TAC [DROP_INDICATOR_POS_LE, REAL_LE_DIV2_EQ, REAL_LT_POW2] THEN
          REAL_ARITH_TAC,
          ALL_TAC] THEN
        MP_TAC (← ISPEC (← q r"\x. &2 * x") SUM_IMAGE) THEN
        MP_TAC (← ISPEC (← q r"\x. &2 * x + &1") SUM_IMAGE) THEN
        REWRITE_TAC [REAL_EQ_ADD_RCANCEL, REAL_EQ_MUL_LCANCEL] THEN
        REWRITE_TAC [REAL_OF_NUM_EQ, ARITH, IMP_CONJ, o_DEF] THEN
        REPEAT (DISCH_THEN (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← GSYM th]))) THEN
        W (MP_TAC o PART_MATCH (rand o rand) SUM_UNION o lhand o snd) THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [FINITE_IMAGE, ← SET_RULE
           (← q r"DISJOINT (IMAGE f s) (IMAGE g s) <=>
        !x. x IN s ==> !y. y IN s ==> ~(f x = g y)")] THEN
          REWRITE_TAC [FORALL_IN_GSPEC] THEN
          X_GEN_TAC (← q r"i:real") THEN STRIP_TAC THEN
          X_GEN_TAC (← q r"j:real") THEN STRIP_TAC THEN
          DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"&2 * x = &2 * y + &1 ==> &2 * abs(x - y) = &1"))) THEN
          SUBGOAL_THEN (← q r"integer(i - j)") MP_TAC THENL
           [ASM_SIMP_TAC [INTEGER_CLOSED], REWRITE_TAC [integer]] THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [REAL_OF_NUM_MUL, REAL_OF_NUM_EQ] THEN
          DISCH_THEN (MP_TAC o AP_TERM (← q r"EVEN")) THEN
          REWRITE_TAC [EVEN_MULT, ARITH],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        MATCH_MP_TAC SUM_SUBSET THEN
        ASM_SIMP_TAC [FINITE_UNION, FINITE_IMAGE] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s ==> x IN u) /\ (!x. x IN t ==> x IN u)
        ==> !x. x IN (s UNION t) DIFF u ==> P x")) THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          SIMP_TAC [INTEGER_CLOSED, ← ARITH_RULE (← q r"2 * SUC n = 2 + 2 * n")] THEN
          REWRITE_TAC [REAL_POW_ADD] THEN
          CONJ_TAC THENL [REAL_ARITH_TAC, REPEAT STRIP_TAC] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(x) <= n /\ &1 <= n ==> abs(&2 * x + &1) <= &2 pow 2 * n")) THEN
          ASM_REWRITE_TAC [REAL_LE_POW2],
          X_GEN_TAC (← q r"k:real") THEN REWRITE_TAC [IN_ELIM_THM, IN_DIFF] THEN
          STRIP_TAC THEN REWRITE_TAC [DROP_CMUL] THEN
          ASM_CASES_TAC (← q r"&0 <= k") THENL
           [MATCH_MP_TAC REAL_LE_MUL THEN
            ASM_SIMP_TAC [REAL_LE_DIV, REAL_POW_LE, REAL_POS] THEN
            REWRITE_TAC [DROP_INDICATOR_POS_LE],
            MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> &0 <= x")) THEN
            REWRITE_TAC [REAL_ENTIRE] THEN DISJ2_TAC THEN
            REWRITE_TAC [indicator] THEN
            COND_CASES_TAC THEN REWRITE_TAC [DROP_VEC] THEN
            FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_ELIM_THM]) THEN
            MATCH_MP_TAC (← TAUT (← q r"~b ==> a /\ b ==> c")) THEN
            REWRITE_TAC [REAL_NOT_LT] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
            EXISTS_TAC (← q r"&0") THEN ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
            ASM_SIMP_TAC [← GSYM REAL_LT_INTEGERS, REAL_MUL_LZERO,
                          INTEGER_CLOSED] THEN
            ASM_REAL_ARITH_TAC]],
        X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC MEASURABLE_ON_VSUM THEN
        REWRITE_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, IN_ELIM_THM] THEN
        GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_CMUL THEN
        ASM_REWRITE_TAC [← GSYM lebesgue_measurable, ETA_AX],
        X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (\k. lift(k / &2 pow n))
                      {k | integer k /\ abs(k) <= &2 pow (2 * n)}") THEN
        CONJ_TAC THENL
         [SIMP_TAC [REAL_ABS_BOUNDS, FINITE_INTSEG, FINITE_IMAGE],
          ALL_TAC] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_IMAGE] THEN
        ASM_CASES_TAC
         (← q r"?k. integer k /\ abs k <= &2 pow (2 * n) /\
          k / &2 pow n <= drop(f(x:real^N)) /\
          drop(f x) < (k + &1) / &2 pow n")
        THENL
         [FIRST_X_ASSUM (fun th => MP_TAC th THEN MATCH_MP_TAC MONO_EXISTS) THEN
          X_GEN_TAC (← q r"m:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
          MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC [],
          EXISTS_TAC (← q r"&0") THEN
          ASM_REWRITE_TAC [IN_ELIM_THM, INTEGER_CLOSED, REAL_ABS_NUM] THEN
          SIMP_TAC [REAL_POW_LE, REAL_POS, real_div, REAL_MUL_LZERO] THEN
          REWRITE_TAC [LIFT_NUM, ← GSYM real_div] THEN
          MATCH_MP_TAC VSUM_EQ_0 THEN
          X_GEN_TAC (← q r"k:real") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
          REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
          REWRITE_TAC [indicator, IN_ELIM_THM] THEN ASM_MESON_TAC []],
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        MP_TAC (← ISPECL [← q r"&2", ← q r"abs(drop((f:real^N->real^1) x))"]
            REAL_ARCH_POW) THEN
        ANTS_TAC THENL [REAL_ARITH_TAC, DISCH_THEN (X_CHOOSE_TAC (← q r"N1:num"))] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
        REWRITE_TAC [REAL_POW_INV] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") MP_TAC) THEN
        SUBST1_TAC (← REAL_ARITH (← q r"inv(&2 pow N2) = &1 / &2 pow N2")) THEN
        SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_POW2] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"MAX N1 N2") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        ABBREV_TAC (← q r"m = floor(&2 pow n * drop(f(x:real^N)))") THEN
        SUBGOAL_THEN (← q r"dist(lift(m / &2 pow n),(f:real^N->real^1) x) < e")
        MP_TAC THENL
         [REWRITE_TAC [DIST_REAL, ← GSYM drop, LIFT_DROP] THEN
          MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN EXISTS_TAC (← q r"abs(&2 pow n)") THEN
          REWRITE_TAC [← GSYM REAL_ABS_MUL, REAL_SUB_LDISTRIB] THEN
          SIMP_TAC [REAL_DIV_LMUL, REAL_POW_EQ_0, ← GSYM REAL_ABS_NZ,
                    REAL_OF_NUM_EQ, ARITH] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"x <= y /\ y < x + &1 /\ &1 <= z ==> abs(x - y) < z")) THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"e * &2 pow N2") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_ABS_POW, REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"x:real^1 = y ==> dist(y,z) < e ==> dist(x,z) < e")) THEN
          MATCH_MP_TAC lemma THEN
          SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
          ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
          EXPAND_TAC "m" THEN REWRITE_TAC [FLOOR] THEN
          SIMP_TAC [REAL_ABS_BOUNDS, REAL_LE_FLOOR, REAL_FLOOR_LE,
                    INTEGER_CLOSED] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) <= e ==> --e <= x /\ x - &1 < e")) THEN
          REWRITE_TAC [MULT_2, REAL_POW_ADD, REAL_ABS_MUL, REAL_ABS_POW,
                       REAL_ABS_NUM] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN SIMP_TAC [REAL_POW_LE, REAL_POS] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"x < e ==> e <= d ==> x <= d")))] THEN
        MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_ARITH_TAC]))

  pure { MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT_INCREASING }

/- ------------------------------------------------------------------------- -/
/- Some "iff" variants of integrability on subsets.                         -/
/- (measure.ml 10555-10662)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAR where
  ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ_ALT : thm
  ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAR [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAO : MSAO) (BMSAP : MSAP) : ExceptT String IO MSAR := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_MEASURABLE, INTEGRABLE_IMP_MEASURABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_COMPONENTWISE, MEASURABLE_ON_CONST_EQ, MEASURABLE_ON_MUL,
        .. } := BMSAE
  let { MEASURABLE_ON_INDICATOR_SUBSET, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT, .. } := BMSAP
  let { ABSOLUTELY_INTEGRABLE_COMPONENTWISE, .. } := D.qintegration1
  let { INTEGRABLE_ADD, INTEGRABLE_CMUL, INTEGRABLE_COMPONENTWISE, INTEGRABLE_NEG,
        INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration2
  let { BOUNDED_SING, .. } := D.ig.qtopology
  let { indicator, .. } := D.ig.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { AND_FORALL_THM, ARITH, COND_RAND, COND_RATOR, DIMINDEX_1, EQ_IMP, ETA_AX,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_RMUL, REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_REFL, SUBSET_RESTRICT,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_gt, SWAP_FORALL_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, LIFT_CMUL, LIFT_DROP, NORM_1,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VEC_COMPONENT, VECTOR_ADD_LID, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_EMPTY, BOUNDED_INSERT, BOUNDED_POS, BOUNDED_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.top1
  -- @@SCOPE END

  let (ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ,
       ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ) ← CONJ_PAIR (← prove
   r"(!f:real^M->real^N s.
        f absolutely_integrable_on s <=>
        f measurable_on s /\
        !t. t SUBSET s /\ lebesgue_measurable t ==> f integrable_on t) /\
   (!f:real^M->real^N s.
        f absolutely_integrable_on s <=>
        f measurable_on s /\
        !g. g measurable_on s /\ bounded(IMAGE g s)
            ==> (\x. drop(g x) % f x) integrable_on s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (BINOP_CONV o RAND_CONV o LAND_CONV)
     [MEASURABLE_ON_COMPONENTWISE] THEN
    ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE,
                      INTEGRABLE_COMPONENTWISE] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC (← MESON []
     (← q r"(!i. P i ==> R i) /\ (!i. R i ==> Q i) /\ (!i. Q i ==> P i)
    ==> ((!i. P i) <=> (!i. Q i)) /\ ((!i. P i) <=> (!i. R i))")) THEN
    REWRITE_TAC [AND_FORALL_THM] THEN  X_GEN_TAC (← q r"i:num") THEN
    ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:N)") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_COMPONENT, LIFT_CMUL] THEN
    ABBREV_TAC (← q r"h x = lift((f:real^M->real^N) x$i)") THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN REWRITE_TAC [ETA_AX] THEN
    SPEC_TAC (← q r"h:real^M->real^1", ← q r"f:real^M->real^1") THEN
    GEN_TAC THEN REWRITE_TAC [ABSOLUTELY_INTEGRABLE_MEASURABLE] THEN
    ASM_CASES_TAC (← q r"(f:real^M->real^1) measurable_on s") THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN MATCH_MP_TAC
          MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
      EXISTS_TAC (← q r"\x. B % lift(norm((f:real^M->real^1) x))") THEN
      REWRITE_TAC [NORM_MUL, ← GSYM NORM_1, DROP_CMUL, LIFT_DROP] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL, NORM_POS_LE] THEN
      ASM_SIMP_TAC [INTEGRABLE_CMUL, MEASURABLE_ON_MUL, LIFT_DROP, ETA_AX],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"indicator(t:real^M->bool)")) THEN
      ASM_SIMP_TAC [MEASURABLE_ON_INDICATOR_SUBSET] THEN ANTS_TAC THENL
       [MATCH_MP_TAC BOUNDED_SUBSET THEN
        EXISTS_TAC (← q r"{vec 0:real^1,vec 1}") THEN
        REWRITE_TAC [BOUNDED_INSERT, BOUNDED_EMPTY] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INSERT, indicator] THEN
        MESON_TAC [],
        ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
        REWRITE_TAC [indicator] THEN
        ASM_MESON_TAC [DROP_VEC, VECTOR_MUL_LZERO, VECTOR_MUL_LID, SUBSET]],
      FIRST_ASSUM (fun th => tactic_of do
       pure (MP_TAC (← SPEC
        (← q r"{x:real^M | (if x IN s then f x else vec 0:real^1)$1 > &0}") th) THEN
       MP_TAC (← SPEC
         (← q r"{x:real^M | (if x IN s then f x else vec 0:real^1)$1 < &0}") th))) THEN
      FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE I [← GSYM MEASURABLE_ON_UNIV]) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT]) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT]) THEN
      SIMP_TAC [DIMINDEX_1, ARITH] THEN
      REPLICATE_TAC 2 (DISCH_THEN (K ALL_TAC)) THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [real_gt, VEC_COMPONENT, REAL_LT_REFL] THEN
      REWRITE_TAC [SUBSET_RESTRICT, ← SET_RULE
        (← q r"{x | if x IN s then Q x else F} = {x | x IN s /\ Q x}")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_NEG) THEN
      ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
      REWRITE_TAC [IN_ELIM_THM, ← GSYM drop, IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_ADD) THEN
      MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [VECTOR_ADD_LID] THEN
      REWRITE_TAC [NORM_1, ← GSYM DROP_EQ, LIFT_DROP, DROP_ADD] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [DROP_VEC, DROP_NEG]) THEN
      ASM_REAL_ARITH_TAC]))

  let ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ_ALT ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s
        ==> (f absolutely_integrable_on s <=>
             !g. g measurable_on s /\ bounded(IMAGE g s)
                 ==> (\x. drop(g x) % f x) integrable_on s)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q <=> q) <=> q ==> p")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(\x. vec 1):real^M->real^1")) THEN
    ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, MEASURABLE_ON_CONST_EQ] THEN
    REWRITE_TAC [VECTOR_MUL_LID, ETA_AX] THEN
    ANTS_TAC THENL [ALL_TAC, REWRITE_TAC [INTEGRABLE_IMP_MEASURABLE]] THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"{vec 1:real^1}") THEN
    REWRITE_TAC [BOUNDED_SING] THEN SET_TAC [])

  let ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ_ALT ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s
        ==> (f absolutely_integrable_on s <=>
             !t. t SUBSET s /\ lebesgue_measurable t ==> f integrable_on t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ] THEN
    ASM_MESON_TAC [SUBSET_REFL, INTEGRABLE_IMP_MEASURABLE])

  pure { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ,
         ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ,
         ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT_EQ_ALT,
         ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET_EQ_ALT }

/- ------------------------------------------------------------------------- -/
/- More connections with measure where Lebesgue measurability is useful.   -/
/- (measure.ml 10663-10895)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAS where
  MEASURABLE_LEBESGUE_MEASURABLE_SUBSET : thm
  MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE : thm
  MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE : thm
  LEBESGUE_MEASURABLE_MEASURABLE_INTER_EQ : thm
  MEASURABLE_INTER_HALFSPACE_LE : thm
  MEASURABLE_INTER_HALFSPACE_GE : thm
  MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE : thm
  MEASURABLE_OPEN_IN : thm
  MEASURABLE_CLOSED_IN : thm
  MEASURABLE_ON_REAL_SGN : thm
  LEBESGUE_MEASURABLE_INNER_COMPACT : thm
  CHOOSE_LARGE_MEASURABLE_SUBSET : thm
  CHOOSE_LARGE_COMPACT_SUBSET : thm
  CHOOSE_LARGE_COMPACT_SUBSET_ALT : thm
  OUTER_LEBESGUE_MEASURE : thm
  OUTER_MEASURE_GEN : thm
  OUTER_MEASURE_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAS [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSF : MSF) (BMSO : MSO) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAO : MSAO) (BMSAP : MSAP) : ExceptT String IO MSAS := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTEGRABLE, MEASURABLE_INTERVAL, MEASURABLE_UNION, .. } := BMSA
  let { MEASURABLE_MEASURE_POS_LT, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURABLE_NESTED_UNIONS, .. } := BMSF
  let { MEASURABLE_INNER_COMPACT, OUTER_MEASURE, .. } := BMSO
  let { lebesgue_measurable, MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE,
        MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_CONST, .. } := BMSAD
  let { MEASURABLE_ON_CASES, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_CLOSED, LEBESGUE_MEASURABLE_CLOSED_IN,
        LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
        LEBESGUE_MEASURABLE_INTER,
        LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS,
        LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS, LEBESGUE_MEASURABLE_OPEN_IN,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT, .. } := BMSAP
  let { NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_ON_INTERVALS, .. } := D.qintegration3
  let { REAL_LT_ADDL, real_sgn, UNIONS_DIFF, .. } := D.qsession
  let { REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { indicator, NORM_REAL, .. } := D.ig.qvec
  let { CLOSED_IN_IMP_SUBSET, .. } := D.ig.dv.dg.qmetric
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTER, .. } := D.ig.dv.dg.pt.qtop
  let { DIMINDEX_1, EXTENSION, FINITE_INDEX_INRANGE, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { INTER_COMM, INTER_SUBSET, INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM,
        REAL_ABS_NUM, REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_REFL,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_SUC, REAL_POS, REAL_SUB_LT, SKOLEM_THM, SUBSET,
        SUBSET_INTER, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_gt, UNIONS_GSPEC, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, FORALL_1, IN_INTERVAL, LIFT_DROP, LIFT_NUM, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VEC_COMPONENT, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, .. } := D.ig.dv.dg.pt.cvx.met
  let { BOUNDED_CBALL, CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE,
        .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_CBALL_0, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let MEASURABLE_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ measurable t /\ s SUBSET t
        ==> measurable s"
   (REWRITE_TAC [lebesgue_measurable, MEASURABLE_INTEGRABLE] THEN
    REWRITE_TAC [indicator] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"(\x. if x IN t then vec 1 else vec 0):real^N->real^1") THEN
    ASM_REWRITE_TAC [IN_UNIV] THEN GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN
           ASM_REWRITE_TAC [DROP_VEC, NORM_REAL, ← GSYM drop]) THEN
    REWRITE_TAC [REAL_ABS_NUM, REAL_LE_REFL, REAL_POS] THEN ASM SET_TAC [])

  let MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE ← prove
   r"!s t:real^N->bool.
        lebesgue_measurable s /\ measurable t ==> measurable(s INTER t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_INTER, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
                  INTER_SUBSET])

  let MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE ← prove
   r"!s t:real^N->bool.
        measurable s /\ lebesgue_measurable t ==> measurable(s INTER t)"
   (MESON_TAC [INTER_COMM, MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE])

  let LEBESGUE_MEASURABLE_MEASURABLE_INTER_EQ ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s <=>
        !t. measurable t ==> measurable(s INTER t)"
   (MESON_TAC [LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS,
               MEASURABLE_INTERVAL,
               MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE])

  let MEASURABLE_INTER_HALFSPACE_LE ← prove
   r"!s a i. measurable s ==> measurable(s INTER {x:real^N | x$i <= a})"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !z:real^N. z$i = z$k")
    CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE THEN
    ASM_SIMP_TAC [CLOSED_HALFSPACE_COMPONENT_LE, LEBESGUE_MEASURABLE_CLOSED])

  let MEASURABLE_INTER_HALFSPACE_GE ← prove
   r"!s a i. measurable s ==> measurable(s INTER {x:real^N | x$i >= a})"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !z:real^N. z$i = z$k")
    CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE THEN
    ASM_SIMP_TAC [CLOSED_HALFSPACE_COMPONENT_GE, LEBESGUE_MEASURABLE_CLOSED])

  let MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE ← prove
   r"!s t. measurable s /\ lebesgue_measurable t ==> measurable(s DIFF t)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
    ASM_SIMP_TAC [MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE,
                  LEBESGUE_MEASURABLE_COMPL])

  let MEASURABLE_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean s) t /\ measurable s
        ==> measurable t"
   (MESON_TAC [MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, OPEN_IN_IMP_SUBSET,
      LEBESGUE_MEASURABLE_OPEN_IN, MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let MEASURABLE_CLOSED_IN ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean s) t /\ measurable s
        ==> measurable t"
   (MESON_TAC [MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, CLOSED_IN_IMP_SUBSET,
      LEBESGUE_MEASURABLE_CLOSED_IN, MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let MEASURABLE_ON_REAL_SGN ← prove
   r"!f:real^N->real s.
        (\x. lift(f x)) measurable_on s
        ==> (\x. lift(real_sgn(f x))) measurable_on s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [real_sgn, ← MESON [DROP_VEC, REAL_LT_REFL, LIFT_DROP]
     (← q r"(if P x then lift(if &0 < f x then &1 else if f x < &0 then -- &1 else &0)
     else vec 0) =
     if (&0 < (if P x then f x else &0)) then lift(&1)
     else if ((if P x then f x else &0) < &0) then lift(-- &1)
     else lift(&0)")] THEN
    REWRITE_TAC [← MESON [LIFT_NUM]
     (← q r"(if P then lift(f x) else vec 0) = lift(if P then f x else &0)")] THEN
    ABBREV_TAC (← q r"h x = if x IN s then (f:real^N->real) x else &0") THEN
    DISCH_TAC THEN MATCH_MP_TAC MEASURABLE_ON_CASES THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT]),
      REWRITE_TAC [MEASURABLE_ON_CONST] THEN
      MATCH_MP_TAC MEASURABLE_ON_CASES THEN
      REWRITE_TAC [MEASURABLE_ON_CONST] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT])] THEN
    REWRITE_TAC [real_gt, DIMINDEX_1, FORALL_1] THEN
    SIMP_TAC [← GSYM drop, LIFT_DROP])

  let LEBESGUE_MEASURABLE_INNER_COMPACT ← prove
   r"!s:real^N->bool.
        lebesgue_measurable s /\ ~negligible s
        ==> ?k. k SUBSET s /\ compact k /\ &0 < measure k"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?a b:real^N. ~(negligible(s INTER interval[a,b]))")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [NEGLIGIBLE_ON_INTERVALS], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"s INTER interval[a:real^N,b]", ← q r"measure(s INTER interval[a:real^N,b])"]
     MEASURABLE_INNER_COMPACT) THEN
    ASM_SIMP_TAC [MEASURABLE_MEASURE_POS_LT, MEASURABLE_INTERVAL,
                  MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^N->bool") THEN
    SIMP_TAC [SUBSET_INTER, REAL_LT_ADDL])

  let CHOOSE_LARGE_MEASURABLE_SUBSET ← prove
   r"!s:real^N->bool B.
        lebesgue_measurable s /\ ~measurable s
        ==> ?t. t SUBSET s /\ measurable t /\ B <= measure t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. s INTER interval[--vec n:real^N,vec n]", ← q r"B:real"]
          MEASURABLE_NESTED_UNIONS) THEN
    ASM_REWRITE_TAC [← GSYM
     LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> s) /\ q /\ ~r ==> (p /\ q ==> r) ==> s")) THEN
    REWRITE_TAC [NOT_FORALL_THM, REAL_NOT_LE] THEN REPEAT CONJ_TAC THENL
     [DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      EXISTS_TAC (← q r"s INTER interval[--vec n:real^N,vec n]") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, INTER_SUBSET] THEN
      ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                    MEASURABLE_INTERVAL],
      GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")) THEN
      REWRITE_TAC [SUBSET_INTERVAL, VECTOR_NEG_COMPONENT, VEC_COMPONENT] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN
      REAL_ARITH_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
       (← q r"~measurable s ==> t = s ==> ~measurable t"))) THEN
      ONCE_REWRITE_TAC [← SET_RULE
       (← q r"{s INTER f n | n IN (:num)} = {s INTER t | t IN IMAGE f (:num)}")] THEN
      REWRITE_TAC [← GSYM INTER_UNIONS] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"u = UNIV ==> s INTER u = s")) THEN
      REWRITE_TAC [UNIONS_IMAGE, EXTENSION, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^N") THEN
      MP_TAC (← ISPEC (← q r"norm(x:real^N)") REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL, VECTOR_NEG_COMPONENT] THEN
      REWRITE_TAC [← GSYM REAL_ABS_BOUNDS, VEC_COMPONENT] THEN
      ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS]])

  let CHOOSE_LARGE_COMPACT_SUBSET ← prove
   r"!s:real^N->bool B.
        lebesgue_measurable s /\ ~measurable s
        ==> ?t. t SUBSET s /\ compact t /\ B <= measure t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"B + &1"]
      CHOOSE_LARGE_MEASURABLE_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"&1"] MEASURABLE_INNER_COMPACT) THEN
    ASM_REWRITE_TAC [REAL_LT_01] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM SET_TAC [], ASM_REAL_ARITH_TAC])

  let CHOOSE_LARGE_COMPACT_SUBSET_ALT ← prove
   r"!(s:real^N->bool) B.
        lebesgue_measurable s /\ B < measure s
        ==> ?t. compact t /\ t SUBSET s /\ B < measure t"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"measurable(s:real^N->bool)") THENL
     [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"measure(s:real^N->bool) - B"]
          MEASURABLE_INNER_COMPACT),
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"B + &1:real"]
          CHOOSE_LARGE_COMPACT_SUBSET)] THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN MATCH_MP_TAC MONO_EXISTS THEN
    SIMP_TAC [] THEN REAL_ARITH_TAC)

  let OUTER_LEBESGUE_MEASURE ← prove
   r"!s:real^N->bool.
     ?t. s SUBSET t /\ lebesgue_measurable t /\
         !t'. s SUBSET t' /\ lebesgue_measurable t' ==> negligible(t DIFF t')"
   (GEN_TAC THEN MP_TAC
     (← GEN (← q r"n:num") (← SPEC (← q r"s INTER cball(vec 0:real^N,&n)") OUTER_MEASURE)) THEN
    SIMP_TAC [BOUNDED_INTER, BOUNDED_CBALL, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:num->real^N->bool") THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS {u n | n IN (:num)}:real^N->bool") THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
                  MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MP_TAC (← SPEC (← q r"norm(x:real^N)") REAL_ARCH_SIMPLE) THEN
      REWRITE_TAC [← GSYM IN_CBALL_0] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [UNIONS_DIFF, ← SET_RULE
       (← q r"{f x | x IN {g y | y IN s}} = {f(g x) | x IN s}")] THEN
      MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
      X_GEN_TAC (← q r"n:num") THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE] THEN
      ASM SET_TAC []])

  let OUTER_MEASURE_GEN ← prove
   r"!s u:real^N->bool.
        s SUBSET u /\ measurable u
        ==> ?t. s SUBSET t /\ measurable t /\
                !t'. s SUBSET t' /\ lebesgue_measurable t'
                     ==> negligible(t DIFF t')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") OUTER_LEBESGUE_MEASURE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
    MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"u UNION (t DIFF u):real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    MATCH_MP_TAC MEASURABLE_UNION THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NEGLIGIBLE_IMP_MEASURABLE THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE])

  let OUTER_MEASURE_EQ ← prove
   r"!s:real^N->bool.
        (?t. s SUBSET t /\ measurable t) <=>
        (?t. s SUBSET t /\ measurable t /\
             !t'. s SUBSET t' /\ lebesgue_measurable t'
                  ==> negligible(t DIFF t'))"
   (GEN_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, OUTER_MEASURE_GEN])

  pure { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET,
         MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
         MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE,
         LEBESGUE_MEASURABLE_MEASURABLE_INTER_EQ, MEASURABLE_INTER_HALFSPACE_LE,
         MEASURABLE_INTER_HALFSPACE_GE, MEASURABLE_MEASURABLE_DIFF_LEBESGUE_MEASURABLE,
         MEASURABLE_OPEN_IN, MEASURABLE_CLOSED_IN, MEASURABLE_ON_REAL_SGN,
         LEBESGUE_MEASURABLE_INNER_COMPACT, CHOOSE_LARGE_MEASURABLE_SUBSET,
         CHOOSE_LARGE_COMPACT_SUBSET, CHOOSE_LARGE_COMPACT_SUBSET_ALT,
         OUTER_LEBESGUE_MEASURE, OUTER_MEASURE_GEN, OUTER_MEASURE_EQ }

/- ------------------------------------------------------------------------- -/
/- Continuity of measure with respect to parameters determining a region;  -/
/- negligibility of a set with uncountably many disjoint translates.        -/
/- (measure.ml 10896-11024)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAT where
  CONTINUOUS_ON_MEASURE_IN_PORTION : thm
  CONTINUOUS_ON_MEASURE_IN_HALFSPACE : thm
  NEGLIGIBLE_DISJOINT_TRANSLATES : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAT [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSE : MSE) (BMSJ : MSJ) (BMSAM : MSAM) (BMSAS : MSAS) : ExceptT String IO MSAT := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTEGRABLE, MEASURABLE_INTERVAL,
        MEASURE_INTEGRAL_UNIV, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { HAS_MEASURE_DISJOINT_UNIONS_IMAGE, MEASURABLE_MEASURE_EQ_0, .. } := BMSB
  let { MEASURABLE_TRANSLATION_EQ, MEASURE_TRANSLATION, .. } := BMSE
  let { NEGLIGIBLE_HYPERPLANE, .. } := BMSJ
  let { LEBESGUE_MEASURABLE_CONVEX, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
        MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE, .. } := BMSAS
  let { DOMINATED_CONVERGENCE_AE, .. } := D.qintegration1
  let { NEGLIGIBLE_ON_INTERVALS, .. } := D.qintegration3
  let { LIMPT_INFINITE_CBALL, .. } := D.qtopology2
  let { indicator, .. } := D.ig.qvec
  let { INFINITE, REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { CONTINUOUS_ON_SEQUENTIALLY, .. } := D.ig.dv.qtopology1
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { CONTINUOUS_ON_LIFT_DOT2, .. } := D.ig.dv.dg.qtopology1
  let { tendsto, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_HALFSPACE_LE, .. } := D.ig.dv.dg.pt.qcvx2
  let { CHOOSE_SUBSET_STRONG, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, HAS_SIZE, IMP_CONJ, IN_DELETE, IN_DIFF,
        INTER_COMM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_FORALL,
        REAL_ABS_NUM, REAL_ARCH, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LT, REAL_POS, REAL_SUB_0, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_INTER,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, pairwise, SUM_CONST, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, IN_INTERVAL, LIFT_DROP, LIFT_SUB, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_TRUE, .. } := D.ig.dv.dg.pt.cvx.met
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let CONTINUOUS_ON_MEASURE_IN_PORTION ← prove
   r"!(f:real^M->real^N->real) s t.
        measurable s /\
        (!a. a IN t ==> lebesgue_measurable {x | f a x <= &0}) /\
        (!a. a IN t ==> negligible {x | f a x = &0}) /\
        (!x. x IN s ==> (\a. lift(f a x)) continuous_on t)
        ==> (\a. lift(measure {x | x IN s /\ f a x <= &0}))
            continuous_on t"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_SEQUENTIALLY, IN_UNIV, IN_DELETE] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:num->real^M", ← q r"c:real^M"] THEN STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    ASM_SIMP_TAC [MEASURE_INTEGRAL_UNIV, LIFT_DROP, o_DEF,
                  MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE] THEN
    MATCH_MP_TAC (← TAUT
      (← q r"g integrable_on s /\ (f --> integral s g) sequentially
     ==> (f --> integral s g) sequentially"))  THEN
    MATCH_MP_TAC DOMINATED_CONVERGENCE_AE THEN
    EXISTS_TAC (← q r"indicator(s:real^N->bool)") THEN
    EXISTS_TAC (← q r"{x | (f:real^M->real^N->real) c x = &0}") THEN
    ASM_REWRITE_TAC [← GSYM MEASURABLE_INTEGRABLE, indicator] THEN
    ASM_SIMP_TAC [MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_THM, IN_INTER] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
      ASM_REWRITE_TAC [NORM_1, DROP_VEC, REAL_ABS_NUM, REAL_LE_REFL] THEN
      COND_CASES_TAC THEN
      ASM_REWRITE_TAC [DROP_VEC, REAL_ABS_NUM, REAL_POS, REAL_LE_REFL],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC] THEN
    MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONTINUOUS_ON_SEQUENTIALLY] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:num->real^M", ← q r"c:real^M"]) THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [tendsto] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"abs((f:real^M->real^N->real) c x)")) THEN
    ASM_REWRITE_TAC [← GSYM REAL_ABS_NZ, REAL_SUB_0, o_THM, DIST_LIFT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let CONTINUOUS_ON_MEASURE_IN_HALFSPACE ← prove
   r"!s b. measurable s
         ==> (\a. lift(measure {x | x IN s /\ a dot x <= b}))
             continuous_on ((:real^N) DELETE vec 0)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a:real <= b <=> a - b <= &0")] THEN
    MATCH_MP_TAC CONTINUOUS_ON_MEASURE_IN_PORTION THEN
    ASM_SIMP_TAC [IN_DELETE, REAL_SUB_0, NEGLIGIBLE_HYPERPLANE] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a - b <= &0 <=> a:real <= b")] THEN
    SIMP_TAC [LEBESGUE_MEASURABLE_CONVEX, CONVEX_HALFSPACE_LE, LIFT_SUB] THEN
    SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_LIFT_DOT2,
              CONTINUOUS_ON_ID])

  let NEGLIGIBLE_DISJOINT_TRANSLATES ← prove
   r"!s:real^N->bool k z.
        lebesgue_measurable s /\ z limit_point_of k /\
        pairwise (\a b. DISJOINT (IMAGE (\x. a + x) s) (IMAGE (\x. b + x) s)) k
        ==> negligible s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    ABBREV_TAC (← q r"t = s INTER interval[a:real^N,b]") THEN
    SUBGOAL_THEN (← q r"measurable(t:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                     MEASURABLE_INTERVAL, INTER_COMM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"bounded(t:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [BOUNDED_INTER, BOUNDED_INTERVAL], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM MEASURABLE_MEASURE_EQ_0] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ ~(&0 < x) ==> x = &0")) THEN
    ASM_SIMP_TAC [MEASURE_POS_LE] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&1") o
      GEN_REWRITE_RULE I [LIMPT_INFINITE_CBALL]) THEN
    REWRITE_TAC [REAL_LT_01] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o
      SPEC (← q r"measure(IMAGE (\x:real^N. z + x) (interval[a - vec 1,b + vec 1]))") o
      MATCH_MP REAL_ARCH) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") MP_TAC) THEN
    MP_TAC (← ISPECL [← q r"n:num", ← q r"k INTER cball(z:real^N,&1)"]
      CHOOSE_SUBSET_STRONG) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [INFINITE], ALL_TAC] THEN
    REWRITE_TAC [SUBSET_INTER, LEFT_IMP_EXISTS_THM, REAL_NOT_LT] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"measure(UNIONS(IMAGE (\a. IMAGE (\x:real^N. a + x) t) u))") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    SUBGOAL_THEN
     (← q r"UNIONS(IMAGE (\a. IMAGE (\x:real^N. a + x) t) u) has_measure
    &n * measure(t:real^N->bool)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\a. IMAGE (\x:real^N. a + x) t", ← q r"u:real^N->bool"]
          HAS_MEASURE_DISJOINT_UNIONS_IMAGE) THEN
      ASM_SIMP_TAC [MEASURABLE_TRANSLATION_EQ, MEASURE_TRANSLATION,
                    SUM_CONST] THEN
      DISCH_THEN MATCH_MP_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
      ASM SET_TAC [],
      REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE] THEN STRIP_TAC] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [REAL_LE_REFL], MATCH_MP_TAC MEASURE_SUBSET] THEN
    ASM_REWRITE_TAC [MEASURABLE_TRANSLATION_EQ, MEASURABLE_INTERVAL] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_IMAGE, IMP_CONJ,
                 RIGHT_FORALL_IMP_THM] THEN
    X_GEN_TAC (← q r"e:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [IN_IMAGE, UNWIND_THM1, ← VECTOR_ARITH
     (← q r"d + e:real^N = z + y <=> e + d - z = y")] THEN
    SUBGOAL_THEN (← q r"x IN interval[a:real^N,b]") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_INTERVAL]] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
    REWRITE_TAC [VEC_COMPONENT] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"abs(d) <= &1
    ==> a <= x /\ x <= b ==> a - &1 <= x + d /\ x + d <= b + &1")) THEN
    SUBGOAL_THEN (← q r"e IN cball(z:real^N,&1)") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_CBALL]] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
    MESON_TAC [REAL_LE_TRANS, COMPONENT_LE_NORM])

  pure { CONTINUOUS_ON_MEASURE_IN_PORTION, CONTINUOUS_ON_MEASURE_IN_HALFSPACE,
         NEGLIGIBLE_DISJOINT_TRANSLATES }

/- ------------------------------------------------------------------------- -/
/- Preimage characterizations of measurability using points from a dense   -/
/- set: halfspaces and intervals.  (measure.ml 11025-11249)                 -/
/- ------------------------------------------------------------------------- -/

structure MSAU where
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE_DENSE : thm
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE_DENSE : thm
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT_DENSE : thm
  MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT_DENSE : thm
  MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL_DENSE : thm
  MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL_DENSE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAU [HolBase] (D : MeasureDeps) (BMSAD : MSAD) (BMSAM : MSAM) (BMSAP : MSAP) : ExceptT String IO MSAU := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_NEG_EQ, .. } := BMSAD
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_INTERS,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE,
        MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL, .. } := BMSAP
  let { NUM_COUNTABLE, .. } := D.qcard
  let { CLOSURE_NEGATIONS, .. } := D.qtopology1
  let { INTERIOR_INTERVAL, .. } := D.ig.qtopology
  let { LIFT_NEG, .. } := D.ig.dv.dg.qvec
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_GE_1, EXISTS_IN_IMAGE, EXISTS_OR_THM,
        EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, FORALL_AND_THM,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, INTER_UNIV,
        INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LEFT_EXISTS_AND_THM,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_OR, NOT_FORALL_THM, NOT_LE,
        NUMSEG_EMPTY, REAL_ARCH_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_INF_FINITE,
        REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LTE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_SUB_LT,
        RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SKOLEM_THM,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SURJECTIVE_IMAGE_EQ, SWAP_FORALL_THM, UNIONS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, INTERVAL_OPEN_SUBSET_CLOSED,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, VECTOR_SUB_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSURE_APPROACHABLE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE_DENSE ← prove
   r"!f:real^M->real^N r.
        closure (IMAGE lift r) = (:real^1)
        ==> (f measurable_on (:real^M) <=>
             !a k. 1 <= k /\ k <= dimindex(:N) /\ a IN r
                   ==> lebesgue_measurable {x | f(x)$k <= a})"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"k:num"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. ?x. x IN r /\ a < x /\ x < a + inv(&n + &1)")
    MP_TAC THENL
     [GEN_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [EXTENSION]) THEN
      REWRITE_TAC [IN_UNIV, CLOSURE_APPROACHABLE, EXISTS_IN_IMAGE] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"lift(a + inv(&n + &1) / &2)", ← q r"inv(&n + &1) / &2"]) THEN
      REWRITE_TAC [REAL_HALF, DIST_LIFT, REAL_LT_INV_EQ] THEN
      ANTS_TAC THENL [REAL_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
      SIMP_TAC [] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"t:num->real") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | (f:real^M->real^N) x$k <= a} =
    INTERS {{x | (f x)$k <= t n} | n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN EQ_TAC THENL
       [ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, REAL_NOT_LE] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"i < f - a ==> !j. j <= i /\ a < t /\ t < a + j ==> &0 < f - t"))) THEN
      EXISTS_TAC (← q r"inv(&n + &1)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, SIMPLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE]])

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE_DENSE ← prove
   r"!f:real^M->real^N r.
        closure (IMAGE lift r) = (:real^1)
        ==> (f measurable_on (:real^M) <=>
             !a k. 1 <= k /\ k <= dimindex(:N) /\ a IN r
                   ==> lebesgue_measurable {x | f(x)$k >= a})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    MP_TAC (← ISPECL [← q r"(\x. --f x):real^M->real^N", ← q r"IMAGE (--) r:real->bool"]
          MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE_DENSE) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_NEG] THEN
      ASM_REWRITE_TAC [← GSYM o_DEF, IMAGE_o, CLOSURE_NEGATIONS] THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [IN_UNIV] THEN
      MESON_TAC [VECTOR_NEG_NEG],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [VECTOR_NEG_COMPONENT, ← REAL_ARITH (← q r"--x <= --y <=> x >= y")]])

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT_DENSE ← prove
   r"!f:real^M->real^N r.
        closure (IMAGE lift r) = (:real^1)
        ==> (f measurable_on (:real^M) <=>
             !a k. 1 <= k /\ k <= dimindex(:N) /\ a IN r
                   ==> lebesgue_measurable {x | f(x)$k < a})"
   (GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"x < a <=> ~(x >= a)")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL] THEN
    SIMP_TAC [← GSYM MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE_DENSE])

  let MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT_DENSE ← prove
   r"!f:real^M->real^N r.
        closure (IMAGE lift r) = (:real^1)
        ==> (f measurable_on (:real^M) <=>
             !a k. 1 <= k /\ k <= dimindex(:N) /\ a IN r
                   ==> lebesgue_measurable {x | f(x)$k > a})"
   (GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"x > a <=> ~(x <= a)")] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_COMPL] THEN
    SIMP_TAC [← GSYM MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE_DENSE])

  let MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a b. a IN t /\ b IN t
                   ==> lebesgue_measurable {x | f(x) IN interval[a,b]})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    SUBGOAL_THEN
     (← q r"!n. ?u v:real^N.
        (u IN t /\ u IN interval[(a - lambda i. inv(&n + &1)),a]) /\
        (v IN t /\ v IN interval[b,(b + lambda i. inv(&n + &1))])")
    MP_TAC THENL
     [GEN_TAC THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM, LEFT_EXISTS_AND_THM] THEN
      CONJ_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"~(interior s INTER t = {}) /\ interior s SUBSET s
      ==> ?x. x IN t /\ x IN s")) THEN
      REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED] THEN
      W (MP_TAC o PART_MATCH (rand o rand) OPEN_INTER_CLOSURE_EQ_EMPTY o
        rand o snd) THEN
      REWRITE_TAC [OPEN_INTERVAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [INTER_UNIV, INTERVAL_NE_EMPTY] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - i < a <=> &0 < i"),
                   ← REAL_ARITH (← q r"b < b + i <=> &0 < i")] THEN
      REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:num->real^N", ← q r"v:num->real^N"] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN_INTERVAL] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA]] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | (f:real^M->real^N) x IN interval[a,b]} =
    INTERS {{x | f x IN interval[u n,v n]} | n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [IN_INTERVAL] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"k:num") THEN
      ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
      EQ_TAC THENL [ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, REAL_NOT_LE] THEN
      REWRITE_TAC [DE_MORGAN_THM, EXISTS_OR_THM, REAL_NOT_LE] THEN
      MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THENL
       [MATCH_MP_TAC (← REAL_ARITH
         (← q r"!a i j. i < a - f /\ j <= i /\ a - j <= t /\ t <= a
                ==> &0 < t - f")) THEN EXISTS_TAC (← q r"(a:real^N)$k"),
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"!a i j. i < f - a /\ j <= i /\ a <= t /\ t <= a + j
                ==> &0 < f - t")) THEN EXISTS_TAC (← q r"(b:real^N)$k")] THEN
      MAP_EVERY EXISTS_TAC [← q r"inv(&n)", ← q r"inv(&n + &1)"] THEN ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, SIMPLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE]])

  let MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a b. a IN t /\ b IN t
                   ==> lebesgue_measurable {x | f(x) IN interval(a,b)})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    SUBGOAL_THEN
     (← q r"!n. ?u v:real^N.
        (u IN t /\ u IN interval[a,(a + lambda i. inv(&n + &1))]) /\
        (v IN t /\ v IN interval[(b - lambda i. inv(&n + &1)),b])")
    MP_TAC THENL
     [GEN_TAC THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM, LEFT_EXISTS_AND_THM] THEN
      CONJ_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"~(interior s INTER t = {}) /\ interior s SUBSET s
      ==> ?x. x IN t /\ x IN s")) THEN
      REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED] THEN
      W (MP_TAC o PART_MATCH (rand o rand) OPEN_INTER_CLOSURE_EQ_EMPTY o
        rand o snd) THEN
      REWRITE_TAC [OPEN_INTERVAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [INTER_UNIV, INTERVAL_NE_EMPTY] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - i < a <=> &0 < i"),
                   ← REAL_ARITH (← q r"b < b + i <=> &0 < i")] THEN
      REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:num->real^N", ← q r"v:num->real^N"] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN_INTERVAL] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA]] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | (f:real^M->real^N) x IN interval(a,b)} =
    UNIONS {{x | f x IN interval(u n,v n)} | n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_INTERVAL] THEN
      EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LET_TRANS, REAL_LTE_TRANS]] THEN
      SPEC_TAC (← q r"(f:real^M->real^N) x", ← q r"y:real^N") THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"&0 < inf { min ((y - a:real^N)$i) ((b - y:real^N)$i) |
                 i IN 1..dimindex(:N)}")
      MP_TAC THENL
       [SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
        ASM_SIMP_TAC [FORALL_IN_IMAGE, REAL_LT_MIN, REAL_SUB_LT,
                      VECTOR_SUB_COMPONENT, IN_NUMSEG],
        ALL_TAC] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, VECTOR_SUB_COMPONENT, IN_NUMSEG] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"k:num"])) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"inv(&n + &1) <= inv(&n)") MP_TAC THENL
       [ALL_TAC, REAL_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, SIMPLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE]])

  pure { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE_DENSE,
         MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE_DENSE,
         MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT_DENSE,
         MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT_DENSE,
         MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL_DENSE,
         MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL_DENSE }

/- ------------------------------------------------------------------------- -/
/- Preimage characterizations of measurability using points from a dense   -/
/- set: orthants.  (measure.ml 11250-11413)                                 -/
/- ------------------------------------------------------------------------- -/

structure MSAV where
  MEASURABLE_ON_PREIMAGE_ORTHANT_LE_DENSE : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_GE_DENSE : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_LT_DENSE : thm
  MEASURABLE_ON_PREIMAGE_ORTHANT_GT_DENSE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAV [HolBase] (D : MeasureDeps) (BMSAD : MSAD) (BMSAM : MSAM) (BMSAP : MSAP) : ExceptT String IO MSAV := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_NEG_EQ, .. } := BMSAD
  let { LEBESGUE_MEASURABLE_COUNTABLE_INTERS, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
        .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_ORTHANT_LE, MEASURABLE_ON_PREIMAGE_ORTHANT_LT, .. } := BMSAP
  let { NUM_COUNTABLE, .. } := D.qcard
  let { CLOSURE_NEGATIONS, .. } := D.qtopology1
  let { INTERIOR_INTERVAL, .. } := D.ig.qtopology
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { CONTRAPOS_THM, DIMINDEX_GE_1, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG,
        FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_EQ_EMPTY, INTER_UNIV, INTERS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        MONO_FORALL, NOT_FORALL_THM, NOT_LE, NUMSEG_EMPTY, REAL_ARCH_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_INF_FINITE,
        REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LTE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_SUB_LT,
        SIMPLE_IMAGE, SKOLEM_THM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SURJECTIVE_IMAGE_EQ, SWAP_FORALL_THM, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, INTERVAL_OPEN_SUBSET_CLOSED,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, VECTOR_SUB_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let MEASURABLE_ON_PREIMAGE_ORTHANT_LE_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a. a IN t
                 ==> lebesgue_measurable
                        {x | !k. 1 <= k /\ k <= dimindex(:N)
                                 ==> f(x)$k <= (a:real^N)$k})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [MEASURABLE_ON_PREIMAGE_ORTHANT_LE] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN X_GEN_TAC (← q r"a:real^N") THEN
    SUBGOAL_THEN
     (← q r"!n. ?u:real^N.
        u IN t /\ u IN interval[a,(a + lambda i. inv(&n + &1))]")
    MP_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"~(interior s INTER t = {}) /\ interior s SUBSET s
      ==> ?x. x IN t /\ x IN s")) THEN
      REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED] THEN
      W (MP_TAC o PART_MATCH (rand o rand) OPEN_INTER_CLOSURE_EQ_EMPTY o
        rand o snd) THEN
      REWRITE_TAC [OPEN_INTERVAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [INTER_UNIV, INTERVAL_NE_EMPTY] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"b < b + i <=> &0 < i")] THEN
      REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:num->real^N") THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN_INTERVAL] THEN
      SIMP_TAC [VECTOR_ADD_COMPONENT, LAMBDA_BETA]] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | !i. 1 <= i /\ i <= dimindex(:N)
             ==> (f:real^M->real^N) x$i <= (a:real^N)$i} =
    INTERS {{x | !i. 1 <= i /\ i <= dimindex(:N)
                      ==> (f:real^M->real^N) x$i <= (u n:real^N)$i} |
            n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"k:num") THEN
      ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
      EQ_TAC THENL [ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, REAL_NOT_LE] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!a i j. i < f - a /\ j <= i /\ a <= t /\ t <= a + j
              ==> &0 < f - t")) THEN EXISTS_TAC (← q r"(a:real^N)$k") THEN
      MAP_EVERY EXISTS_TAC [← q r"inv(&n)", ← q r"inv(&n + &1)"] THEN ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, SIMPLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE]])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_GE_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a. a IN t
                 ==> lebesgue_measurable
                        {x | !k. 1 <= k /\ k <= dimindex(:N)
                                 ==> f(x)$k >= (a:real^N)$k})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    MP_TAC (← ISPECL [← q r"(\x. --f x):real^M->real^N", ← q r"IMAGE (--) t:real^N->bool"]
          MEASURABLE_ON_PREIMAGE_ORTHANT_LE_DENSE) THEN
    ASM_REWRITE_TAC [CLOSURE_NEGATIONS, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [VECTOR_NEG_COMPONENT, ← REAL_ARITH (← q r"--x <= --y <=> x >= y")] THEN
    DISCH_THEN MATCH_MP_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_UNIV] THEN MESON_TAC [VECTOR_NEG_NEG])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_LT_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a. a IN t
                 ==> lebesgue_measurable
                        {x | !k. 1 <= k /\ k <= dimindex(:N)
                                 ==> f(x)$k < (a:real^N)$k})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [MEASURABLE_ON_PREIMAGE_ORTHANT_LT] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN X_GEN_TAC (← q r"a:real^N") THEN
    SUBGOAL_THEN
     (← q r"!n. ?u:real^N.
        u IN t /\ u IN interval[(a - lambda i. inv(&n + &1)):real^N,a]")
    MP_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"~(interior s INTER t = {}) /\ interior s SUBSET s
      ==> ?x. x IN t /\ x IN s")) THEN
      REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED] THEN
      W (MP_TAC o PART_MATCH (rand o rand) OPEN_INTER_CLOSURE_EQ_EMPTY o
        rand o snd) THEN
      REWRITE_TAC [OPEN_INTERVAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [INTER_UNIV, INTERVAL_NE_EMPTY] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, LAMBDA_BETA] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"b - i < b <=> &0 < i")] THEN
      REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:num->real^N") THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN_INTERVAL] THEN
      SIMP_TAC [VECTOR_ADD_COMPONENT, LAMBDA_BETA]] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | !i. 1 <= i /\ i <= dimindex(:N)
             ==> (f:real^M->real^N) x$i < (a:real^N)$i} =
    UNIONS {{x | !i. 1 <= i /\ i <= dimindex(:N)
                      ==> (f:real^M->real^N) x$i < (u n:real^N)$i} |
            n IN (:num)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_INTERVAL] THEN
      EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LET_TRANS, REAL_LTE_TRANS]] THEN
      SPEC_TAC (← q r"(f:real^M->real^N) x", ← q r"y:real^N") THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"&0 < inf { (a - y:real^N)$i | i IN 1..dimindex(:N)}")
      MP_TAC THENL
       [SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
        ASM_SIMP_TAC [FORALL_IN_IMAGE, REAL_LT_MIN, REAL_SUB_LT,
                      VECTOR_SUB_COMPONENT, IN_NUMSEG],
        ALL_TAC] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, VECTOR_SUB_COMPONENT, IN_NUMSEG] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"k:num"])) THEN
      ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, LAMBDA_BETA] THEN
      SUBGOAL_THEN (← q r"inv(&n + &1) <= inv(&n)") MP_TAC THENL
       [ALL_TAC, REAL_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, SIMPLE_IMAGE] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE]])

  let MEASURABLE_ON_PREIMAGE_ORTHANT_GT_DENSE ← prove
   r"!f:real^M->real^N t.
        closure t = (:real^N)
        ==> (f measurable_on (:real^M) <=>
             !a. a IN t
                 ==> lebesgue_measurable
                        {x | !k. 1 <= k /\ k <= dimindex(:N)
                                 ==> f(x)$k > (a:real^N)$k})"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM MEASURABLE_ON_NEG_EQ] THEN
    MP_TAC (← ISPECL [← q r"(\x. --f x):real^M->real^N", ← q r"IMAGE (--) t:real^N->bool"]
          MEASURABLE_ON_PREIMAGE_ORTHANT_LT_DENSE) THEN
    ASM_REWRITE_TAC [CLOSURE_NEGATIONS, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [VECTOR_NEG_COMPONENT, ← REAL_ARITH (← q r"--x < --y <=> x > y")] THEN
    DISCH_THEN MATCH_MP_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_UNIV] THEN MESON_TAC [VECTOR_NEG_NEG])

  pure { MEASURABLE_ON_PREIMAGE_ORTHANT_LE_DENSE, MEASURABLE_ON_PREIMAGE_ORTHANT_GE_DENSE,
         MEASURABLE_ON_PREIMAGE_ORTHANT_LT_DENSE, MEASURABLE_ON_PREIMAGE_ORTHANT_GT_DENSE }

/- ------------------------------------------------------------------------- -/
/- Localized variants of function measurability equivalents.               -/
/- (measure.ml 11414-11640)                                                 -/
