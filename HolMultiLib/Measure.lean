  let { COMPACT_SPHERE, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_ON_CONST,
        CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_SUB, CONTINUOUS_SUB,
        CONTINUOUS_WITHIN_SUBSET, FRONTIER_CBALL, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL, IN_CBALL, IN_SPHERE_0, INTERIOR_CBALL, LIM_ADD, LIM_CMUL, LIM_CONST,
