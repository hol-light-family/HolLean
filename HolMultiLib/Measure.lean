set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAX [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSF : MSF) (BMSAM : MSAM) (BMSAS : MSAS) (BMSAW : MSAW) : ExceptT String IO MSAX := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, .. } := BMSA
  let { MEASURABLE_NEGLIGIBLE_SYMDIFF, .. } := BMSB
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { LEBESGUE_MEASURABLE_COMPACT, LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT,
