   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_integrable_on] THEN
    BINOP_TAC THEN REWRITE_TAC [INTEGRABLE_CONVOLUTION_SYM] THEN
    MP_TAC (← ISPECL
     [← q r"\x y. lift(norm((bop:real^N->real^P->real^Q) x y))",
