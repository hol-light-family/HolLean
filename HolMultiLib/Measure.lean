  ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_LINEAR : thm
  ABSOLUTELY_INTEGRABLE_ON_LINEAR_IMAGE : thm
  INTEGRAL_CHANGE_OF_VARIABLES_LINEAR : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBZ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSJ : MSJ) (BMSBX : MSBX) (BMSBY : MSBY) : ExceptT String IO MSBZ := do
  -- @@SCOPE BEGIN
  let { has_measure, measurable, MEASURE_INTEGRAL, .. } := BMSA
  let { NEGLIGIBLE_LINEAR_SINGULAR_IMAGE, .. } := BMSJ
  let { HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_INVERTIBLE, .. } := BMSBX
  let { HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES, .. } := BMSBY
  let { HAS_DERIVATIVE_LINEAR, .. } := D.qderivatives
  let { DET_CMUL, DET_EQ_0, .. } := D.qdet
  let { ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_CMUL, ABSOLUTELY_INTEGRABLE_CMUL_EQ,
        ABSOLUTELY_INTEGRABLE_COMPONENTWISE, ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_ON_NEGLIGIBLE,
        .. } := D.qintegration1
  let { HAS_INTEGRAL_COMPONENTWISE, HAS_INTEGRAL_INTEGRABLE_INTEGRAL, INTEGRAL_0,
        .. } := D.qintegration2
  let { integrable_on, INTEGRAL_CMUL, INTEGRAL_ON_NEGLIGIBLE, .. } := D.qintegration3
  let { MATRIX_CMUL, .. } := D.qvec
  let { has_vector_derivative, .. } := D.ig.qderivatives
  let { REAL_ABS_ZERO, REAL_POW_1, .. } := D.ig.qsession
  let { LIFT_EQ_CMUL, .. } := D.ig.qvec
  let { LINEAR_ID, MATRIX_I, MATRIX_INVERTIBLE, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { AND_FORALL_THM, DIMINDEX_1, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, MONO_EXISTS, NOT_EXISTS_THM, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_POS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { EXISTS_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_NUM, LINEAR_INJECTIVE_LEFT_INVERSE,
        MATRIX_COMPOSE, MATRIX_ID, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_MUL_COMPONENT, VECTOR_MUL_LZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { DET_I, DET_MUL, .. } := D.ig.dv.dg.pt.cvx.det
  let { LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES ← prove
   r"!f:real^M->real^N g:real^M->real^M g' s.
      lebesgue_measurable s /\
      (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
      (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y)
      ==> (f absolutely_integrable_on (IMAGE g s) <=>
           (\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES) THEN
    MESON_TAC [])

  let INTEGRAL_CHANGE_OF_VARIABLES ← prove
   r"!f:real^M->real^N g:real^M->real^M g' s.
      lebesgue_measurable s /\
      (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
      (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\
       (f absolutely_integrable_on (IMAGE g s) \/
        (\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s)
      ==> integral (IMAGE g s) f =
          integral s (\x. abs(det(matrix(g' x))) % f(g x))"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (p /\ q /\ r) /\ s")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES) THEN
    ASM_MESON_TAC [])

  let HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1 ← prove
   r"!f:real^1->real^N g:real^1->real^1 g' s b.
        lebesgue_measurable s /\
         (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\
         (!x. x IN s
              ==> (g has_vector_derivative lift (g' (drop x)))
                  (at x within s))
         ==> ((\x. abs (g' (drop x)) % f (g x)) absolutely_integrable_on s /\
              integral s (\x. abs (g' (drop x)) % f (g x)) = b <=>
              f absolutely_integrable_on IMAGE g s /\
              integral (IMAGE g s) f = b)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← MESON [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
                     HAS_INTEGRAL_INTEGRABLE_INTEGRAL]
     (← q r"f absolutely_integrable_on s /\ integral s f = b <=>
      f absolutely_integrable_on s /\ (f has_integral b) s")] THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL_COMPONENTWISE,
                      ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"i:num") THEN
    ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:N)") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← MESON [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
                      HAS_INTEGRAL_INTEGRABLE_INTEGRAL]
      (← q r"f absolutely_integrable_on s /\ (f has_integral b) s <=>
       f absolutely_integrable_on s /\ integral s f = b")] THEN
    MP_TAC (← ISPECL
     [← q r"\x. lift((f:real^1->real^N) x$i)",
      ← q r"g:real^1->real^1",
      ← q r"(\x h. g'(drop x) % h) :real^1->real^1->real^1",
      ← q r"s:real^1->bool",
      ← q r"lift((b:real^N)$i)"] HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [has_vector_derivative] o
        SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [← GSYM LIFT_CMUL] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [LIFT_CMUL, LIFT_DROP],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    SIMP_TAC [MATRIX_CMUL, LINEAR_ID, MATRIX_ID, DET_CMUL] THEN
    REWRITE_TAC [DET_I, DIMINDEX_1, REAL_POW_1, REAL_MUL_RID] THEN
    REWRITE_TAC [LIFT_CMUL, VECTOR_MUL_COMPONENT])

  let ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1 ← prove
   r"!f:real^1->real^N g:real^1->real^1 g' s.
        lebesgue_measurable s /\
        (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\
        (!x. x IN s
             ==> (g has_vector_derivative lift (g' (drop x)))
                 (at x within s))
        ==> (f absolutely_integrable_on IMAGE g s <=>
             (\x. abs(g'(drop x)) % f(g x)) absolutely_integrable_on s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o
      MATCH_MP HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1) THEN
    MESON_TAC [])

  let HAS_MEASURE_DIFFERENTIABLE_IMAGE ← prove
   r"!f:real^N->real^N f' s m.
        lebesgue_measurable s /\
        (!x. x IN s ==> (f has_derivative f' x) (at x within s)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (IMAGE f s has_measure m <=>
             ((\x. lift(abs(det(matrix(f' x))))) has_integral (lift m)) s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\x. vec 1):real^N->real^1",
                      ← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                      ← q r"s:real^N->bool", ← q r"lift m"]
          HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM LIFT_NUM, ← GSYM LIFT_CMUL, REAL_MUL_RID] THEN
    SIMP_TAC [ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS, LIFT_DROP,
              REAL_ABS_POS, REAL_POS] THEN
    REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [LIFT_NUM, has_measure])

  let MEASURABLE_DIFFERENTIABLE_IMAGE_EQ ← prove
   r"!f:real^N->real^N f' s.
        lebesgue_measurable s /\
        (!x. x IN s ==> (f has_derivative f' x) (at x within s)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (measurable (IMAGE f s) <=>
             (\x. lift(abs(det(matrix(f' x))))) integrable_on s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_DIFFERENTIABLE_IMAGE) THEN
    SIMP_TAC [measurable, integrable_on] THEN REWRITE_TAC [← GSYM EXISTS_LIFT])

  let MEASURABLE_DIFFERENTIABLE_IMAGE_ALT ← prove
   r"!f:real^N->real^N f' s.
        lebesgue_measurable s /\
        (!x. x IN s ==> (f has_derivative f' x) (at x within s)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (measurable (IMAGE f s) <=>
             (\x. lift(abs(det(matrix(f' x))))) absolutely_integrable_on s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
          ← q r"s:real^N->bool"] MEASURABLE_DIFFERENTIABLE_IMAGE_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS THEN
    REWRITE_TAC [LIFT_DROP, REAL_ABS_POS])

  let MEASURE_DIFFERENTIABLE_IMAGE_EQ ← prove
   r"!f:real^N->real^N f' s.
        lebesgue_measurable s /\
        (!x. x IN s ==> (f has_derivative f' x) (at x within s)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        (\x. lift(abs(det(matrix(f' x))))) integrable_on s
        ==> measure (IMAGE f s) =
            drop(integral s (\x. lift(abs(det(matrix(f' x))))))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"f':real^N->real^N->real^N",
                      ← q r"s:real^N->bool"] MEASURABLE_DIFFERENTIABLE_IMAGE_EQ) THEN
    ASM_REWRITE_TAC [] THEN SIMP_TAC [MEASURE_INTEGRAL] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN AP_TERM_TAC THEN
    REWRITE_TAC [LIFT_EQ_CMUL] THEN
    MATCH_MP_TAC INTEGRAL_CHANGE_OF_VARIABLES THEN
    ASM_REWRITE_TAC [← GSYM LIFT_EQ_CMUL] THEN DISJ2_TAC THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS,
                  LIFT_DROP, REAL_ABS_POS])

  let HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_LINEAR ← prove
   r"!f:real^M->real^N g:real^M->real^M s b.
      linear g
      ==> ((\x. abs(det(matrix g)) % f(g x)) absolutely_integrable_on s /\
           integral s (\x. abs(det(matrix g)) % f(g x)) = b <=>
           f absolutely_integrable_on (IMAGE g s) /\
           integral (IMAGE g s) f = b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"det(matrix g:real^M^M) = &0") THENL
     [ASM_REWRITE_TAC [REAL_ABS_NUM, VECTOR_MUL_LZERO] THEN
      REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0, INTEGRAL_0] THEN
      SUBGOAL_THEN (← q r"negligible(IMAGE (g:real^M->real^M) s)") ASSUME_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_LINEAR_SINGULAR_IMAGE THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          LINEAR_INJECTIVE_LEFT_INVERSE)) THEN
        ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"h:real^M->real^M") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        DISCH_THEN (MP_TAC o AP_TERM (← q r"(det o matrix):(real^M->real^M)->real")) THEN
        ASM_SIMP_TAC [o_THM, MATRIX_COMPOSE, DET_MUL, MATRIX_I, DET_I] THEN
        REAL_ARITH_TAC,
        ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_ON_NEGLIGIBLE,
                      INTEGRAL_ON_NEGLIGIBLE]],
      MATCH_MP_TAC HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_INVERTIBLE THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [DET_EQ_0]) THEN
      ASM_SIMP_TAC [MATRIX_INVERTIBLE, FUN_EQ_THM, o_THM, I_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:real^M->real^M") THEN
      STRIP_TAC THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, HAS_DERIVATIVE_LINEAR]])

  let ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_LINEAR ← prove
   r"!f:real^M->real^N g:real^M->real^M s.
      linear g
      ==> ((\x. abs(det(matrix g)) % f(g x)) absolutely_integrable_on s <=>
           f absolutely_integrable_on (IMAGE g s))"
   (MESON_TAC [HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_LINEAR])

  let ABSOLUTELY_INTEGRABLE_ON_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N g:real^M->real^M s.
      linear g
      ==> (f absolutely_integrable_on (IMAGE g s) <=>
           (f o g) absolutely_integrable_on s \/ det(matrix g) = &0)"
   (ASM_SIMP_TAC [← GSYM ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_LINEAR] THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_CMUL_EQ, o_DEF, REAL_ABS_ZERO] THEN
    CONV_TAC (fun t => TAUT t))

  let INTEGRAL_CHANGE_OF_VARIABLES_LINEAR ← prove
   r"!f:real^M->real^N g:real^M->real^M s.
        linear g /\
        (f absolutely_integrable_on (IMAGE g s) \/
         (f o g) absolutely_integrable_on s)
        ==> integral (IMAGE g s) f = abs(det(matrix g)) % integral s (f o g)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"g:real^M->real^M", ← q r"s:real^M->bool"]
          ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_LINEAR) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT
     (← q r"(p \/ q) /\ (p /\ q ==> r) ==> (p <=> q) ==> r")) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (DISJ_CASES_THEN MP_TAC) THEN
      ASM_SIMP_TAC [o_DEF, ABSOLUTELY_INTEGRABLE_CMUL],
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"g:real^M->real^M", ← q r"s:real^M->bool"]
          HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_LINEAR) THEN
      ASM_REWRITE_TAC [o_DEF] THEN DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM th])) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [ABSOLUTELY_INTEGRABLE_CMUL_EQ] o
       CONJUNCT1) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO, INTEGRAL_0] THEN
      ASM_SIMP_TAC [INTEGRAL_CMUL, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]])

  pure { ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES, INTEGRAL_CHANGE_OF_VARIABLES,
         HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1,
         ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1, HAS_MEASURE_DIFFERENTIABLE_IMAGE,
         MEASURABLE_DIFFERENTIABLE_IMAGE_EQ, MEASURABLE_DIFFERENTIABLE_IMAGE_ALT,
         MEASURE_DIFFERENTIABLE_IMAGE_EQ, HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_LINEAR,
         ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_LINEAR,
         ABSOLUTELY_INTEGRABLE_ON_LINEAR_IMAGE, INTEGRAL_CHANGE_OF_VARIABLES_LINEAR }

/- ------------------------------------------------------------------------- -/
/- Approximation of L_1 functions by bounded continuous ones.               -/
/- (measure.ml 19729-20111)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCA where
  ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCA [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSJ : MSJ) (BMSL : MSL) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBC : MSBC) : ExceptT String IO MSCA := do
  -- @@SCOPE BEGIN
  let { INTEGRAL_MEASURE, MEASURABLE_INTEGRABLE, MEASURABLE_INTERVAL, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURE_DIFF_SUBSET, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { ABSOLUTELY_INTEGRABLE_ON_CONST, INTEGRABLE_ON_CONST, .. } := BMSC
  let { INTEGRABLE_ON_OPEN_INTERVAL, .. } := BMSJ
  let { EXPAND_CLOSED_OPEN_INTERVAL, .. } := BMSL
  let { ABSOLUTELY_INTEGRABLE_MEASURABLE, INTEGRABLE_IMP_MEASURABLE, lebesgue_measurable,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE, measurable_on,
        MEASURABLE_ON_UNIV, .. } := BMSAB
  let { CONTINUOUS_IMP_MEASURABLE_ON, MEASURABLE_ON_0, .. } := BMSAD
  let { MEASURABLE_ON_CASES, MEASURABLE_ON_RESTRICT, .. } := BMSAE
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_DIFF,
        LEBESGUE_MEASURABLE_INTERVAL, LEBESGUE_MEASURABLE_UNIV, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSBC
  let { TIETZE, .. } := D.qconvex
  let { ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_EQ,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_MAX,
        ABSOLUTELY_INTEGRABLE_MIN, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_RESTRICT_INTER, ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV,
        ABSOLUTELY_INTEGRABLE_SUB, DOMINATED_CONVERGENCE, .. } := D.qintegration1
  let { HAS_INTEGRAL_ALT, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_ADD, INTEGRABLE_CONST,
        INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SPIKE_SET, INTEGRAL_0, INTEGRAL_ADD,
        .. } := D.qintegration2
  let { absolutely_integrable_on, INTEGRAL_CMUL, INTEGRAL_DROP_LE, INTEGRAL_DROP_POS,
        INTEGRAL_EQ, INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_RESTRICT_INTER,
        INTEGRAL_RESTRICT_UNIV, INTEGRAL_SPIKE_SET, INTEGRAL_UNION, NEGLIGIBLE_EMPTY,
        NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { BOUNDED_COMPONENTWISE, CONTINUOUS_ON_MIN, .. } := D.qtopology1
  let { NORM_1_POS, .. } := D.qvec
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ig.qtopology
  let { indicator, LIFT_EQ_CMUL, NORM_BOUND_COMPONENT_LE, NORM_REAL, .. } := D.ig.qvec
  let { LIM_NULL, LIM_NULL_NORM, .. } := D.ig.dv.qtopology2
  let { CLOSED_UNION, CONTINUOUS_ON_CASES, CONTINUOUS_ON_MAX, .. } := D.ig.dv.dg.qtopology1
  let { OPEN_CLOSED, .. } := D.ig.dv.dg.qtopology2
  let { NORM_LE_COMPONENTWISE, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CART_EQ, COND_ID, COND_RAND, COND_RATOR, EQ_IMP, ETA_AX,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, FUN_EQ_THM, IMP_CONJ_ALT, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LAMBDA_BETA, LE_REFL, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_LE, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_SUB, NORM_0,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VEC_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.ig.dv.dg.pt.cvx.met
  let { BOUNDED_BALL, BOUNDED_POS, CLOSED_IN, CLOSED_INTERVAL,
        .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { bounded, OPEN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS ← (do
    let lemma ← prove
     r"!f:real^M->real^N s e.
            measurable s /\ f absolutely_integrable_on s /\ &0 < e
            ==> ?g. g absolutely_integrable_on s /\
                    g continuous_on (:real^M) /\
                    bounded (IMAGE g (:real^M)) /\
                    norm(integral s (\x. lift(norm(f x - g x)))) < e"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"?h. h absolutely_integrable_on s /\
             bounded (IMAGE h (:real^M)) /\
             norm(integral s (\x. lift(norm(f x - h x:real^N)))) < e / &2")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL
         [← q r"\n x. lift(norm
           (f x - (lambda i. max (--(&n))
                               (min (&n) ((f:real^M->real^N)(x)$i)))))",
          ← q r"(\x. vec 0):real^M->real^1",
          ← q r"\x. lift(norm((f:real^M->real^N)(x)))",
          ← q r"s:real^M->bool"]
              DOMINATED_CONVERGENCE) THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"!n. ((\x. lambda i. max (--(&n)) (min (&n) ((f x:real^N)$i)))
              :real^M->real^N) absolutely_integrable_on s")
        ASSUME_TAC THENL
         [GEN_TAC THEN
          FIRST_ASSUM (MP_TAC o SPEC (← q r"(\x. lambda i. &n):real^M->real^N") o
            MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] ABSOLUTELY_INTEGRABLE_MIN)) THEN
          ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_ON_CONST] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"(\x. lambda i. --(&n)):real^M->real^N") o
            MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] ABSOLUTELY_INTEGRABLE_MAX)) THEN
          ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_ON_CONST] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
          SIMP_TAC [CART_EQ, LAMBDA_BETA],
          ALL_TAC] THEN
        ANTS_TAC THENL
         [REPEAT CONJ_TAC THENL
           [X_GEN_TAC (← q r"n:num") THEN
            MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
            MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
            ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_SUB],
            ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_NORM,
                          ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
            MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M"] THEN DISCH_TAC THEN
            REWRITE_TAC [LIFT_DROP, NORM_LIFT, REAL_ABS_NORM] THEN
            MATCH_MP_TAC NORM_LE_COMPONENTWISE THEN
            SIMP_TAC [LAMBDA_BETA, VECTOR_SUB_COMPONENT] THEN REAL_ARITH_TAC,
            X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
            REWRITE_TAC [LIM_SEQUENTIALLY] THEN
            X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
            MP_TAC (← SPEC (← q r"norm((f:real^M->real^N) x)") REAL_ARCH_SIMPLE) THEN
            MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
            DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
            REWRITE_TAC [DIST_0, NORM_LIFT, REAL_ABS_NORM, ← GSYM LIFT_SUB] THEN
            MATCH_MP_TAC (← NORM_ARITH
             (← q r"&0 < d /\ x = y ==> norm(x:real^N - y) < d")) THEN
            ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN REPEAT STRIP_TAC THEN
            MATCH_MP_TAC (← REAL_ARITH
              (← q r"abs(x) <= n ==> x = max (--n) (min n x)")) THEN
            ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS, REAL_OF_NUM_LE]],
          DISCH_THEN (MP_TAC o CONJUNCT2) THEN REWRITE_TAC [LIM_SEQUENTIALLY] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
          REWRITE_TAC [INTEGRAL_0, DIST_0, LE_REFL] THEN DISCH_TAC THEN
          EXISTS_TAC (← q r"(\x. lambda i. max (--(&n)) (min (&n)
                                 ((f:real^M->real^N)(x)$i))):real^M->real^N") THEN
          ASM_REWRITE_TAC [] THEN
          ONCE_REWRITE_TAC [BOUNDED_COMPONENTWISE] THEN
          REWRITE_TAC [bounded, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN EXISTS_TAC (← q r"&n") THEN
          X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
          ASM_SIMP_TAC [NORM_LIFT, LAMBDA_BETA] THEN REAL_ARITH_TAC],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?k g. negligible k /\
              (!n. g n continuous_on (:real^M)) /\
              (!n x. norm(g n x:real^N) <= norm(B % vec 1:real^N)) /\
              (!x. x IN (s DIFF k)  ==> ((\n. g n x) --> h x) sequentially)")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"(h:real^M->real^N) measurable_on s") MP_TAC THENL
         [ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_MEASURABLE], ALL_TAC] THEN
        REWRITE_TAC [measurable_on] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(\n x. lambda i. max (--B) (min B (((g n x):real^N)$i))):
                    num->real^M->real^N") THEN
        ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [X_GEN_TAC (← q r"n:num") THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
          MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"(lambda i. B):real^N"]
                    CONTINUOUS_ON_CONST) THEN
          REWRITE_TAC [IMP_IMP] THEN
          DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MIN) THEN
          MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"(lambda i. --B):real^N"]
                    CONTINUOUS_ON_CONST) THEN
          REWRITE_TAC [IMP_IMP] THEN
          DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MAX) THEN
          MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA],
          REPEAT STRIP_TAC THEN MATCH_MP_TAC NORM_LE_COMPONENTWISE THEN
          SIMP_TAC [LAMBDA_BETA, VEC_COMPONENT, VECTOR_MUL_COMPONENT] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [LIM_SEQUENTIALLY] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"ee:real") THEN
          MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
          MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"norm(c - a:real^N) <= norm(b - a)
            ==> dist(b,a) < ee ==> dist(c,a) < ee")) THEN
          MATCH_MP_TAC NORM_LE_COMPONENTWISE THEN
          SIMP_TAC [LAMBDA_BETA, VECTOR_SUB_COMPONENT] THEN
          X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (MP_TAC o MATCH_MP NORM_BOUND_COMPONENT_LE) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
          REAL_ARITH_TAC],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!n. (g:num->real^M->real^N) n absolutely_integrable_on s")
      ASSUME_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC
          MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
        EXISTS_TAC (← q r"(\x. lift(norm(B % vec 1:real^N))):real^M->real^1") THEN
        ASM_REWRITE_TAC [LIFT_DROP, INTEGRABLE_ON_CONST] THEN
        ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
        MATCH_MP_TAC (← REWRITE_RULE [lebesgue_measurable, indicator]
            MEASURABLE_ON_RESTRICT) THEN
        ASM_SIMP_TAC [CONTINUOUS_IMP_MEASURABLE_ON, ETA_AX] THEN
        MATCH_MP_TAC INTEGRABLE_IMP_MEASURABLE THEN
        ASM_REWRITE_TAC [← GSYM MEASURABLE_INTEGRABLE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"\n x. lift(norm((g:num->real^M->real^N) n x - h x))",
        ← q r"(\x. vec 0):real^M->real^1",
        ← q r"(\x. lift(B + norm(B % vec 1:real^N))):real^M->real^1",
        ← q r"s DIFF k:real^M->bool"] DOMINATED_CONVERGENCE) THEN
      ASM_SIMP_TAC [INTEGRAL_0, INTEGRABLE_ON_CONST, MEASURABLE_DIFF,
                    NEGLIGIBLE_IMP_MEASURABLE] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM] THEN REPEAT CONJ_TAC THENL
         [GEN_TAC THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
