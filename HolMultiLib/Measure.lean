            ==> measure(IMAGE (f:real^N->real^N) s) <= drop m + e * measure s")
      MP_TAC THENL
       [MATCH_MP_TAC (← MESON [REAL_LT_01]
         (← q r"(!e. &0 < e ==> P /\ Q e) ==> P /\ (!e. &0 < e ==> Q e)")),
