  let { MEASURABLE_ON_SIMPLE_FUNCTION_LIMIT_INCREASING, .. } := BMSAQ
  let { LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED,
        MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LE,
        MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN, .. } := BMSAW
  let { ABSOLUTELY_INTEGRABLE_UNION, MEASURABLE_ON_LIFT_INV, .. } := BMSAY
  let { DOUBLE_LEBESGUE_MEASURABLE_ON, LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE,
