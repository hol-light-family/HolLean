        EXISTS_TAC (← q r"B:real") THEN
        ASM_REWRITE_TAC [← GSYM LIFT_SUB, ← GSYM VECTOR_SUB_COMPONENT, NORM_LIFT] THEN
        ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS]] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [LIPSCHITZ_POS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"(:real^M)") SEPARABLE) THEN
      REWRITE_TAC [SUBSET_UNIV, ← SET_RULE (← q r"UNIV SUBSET s <=> s = UNIV")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"qq:real^M->bool") STRIP_ASSUME_TAC) THEN
