      ASM_REWRITE_TAC [PAIRWISE_INSERT, ← SET_RULE (← q r"s = x INSERT s <=> x IN s")] THEN
      ASM_CASES_TAC (← q r"(i:A) IN e") THEN ASM_REWRITE_TAC [] THENL
       [ALL_TAC, SET_TAC []] THEN
