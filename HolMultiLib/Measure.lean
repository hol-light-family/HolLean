                   has_integral lift(measure s)) UNIV"
       (GEN_TAC THEN STRIP_TAC THEN
        FIRST_ASSUM (X_CHOOSE_THEN (← q r"g:num->real^(M,N)finite_sum->bool")
         STRIP_ASSUME_TAC o MATCH_MP OPEN_COUNTABLE_LIMIT_ELEMENTARY) THEN
        SUBGOAL_THEN (← q r"!n:num. g n SUBSET (s:real^(M,N)finite_sum->bool)")
        ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MP_TAC (← ISPECL
         [← q r"\n:num x:real^M. lift(measure {y:real^N | pastecart x y IN (g n)})",
