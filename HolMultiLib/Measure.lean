  let RADEMACHER_UNIV ← (do
    let lemma ← prove
     r"{x | ~(!i. i IN s ==> P i x)} = UNIONS (IMAGE (\i. {x | ~(P i x)}) s)"
     (REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [])
    let lemma' ← prove
     r"{x | !i. P i ==> R i x} = INTERS {{x | R i x} | P i}"
     (REWRITE_TAC [INTERS_GSPEC] THEN SET_TAC [])
    let lemur ← prove
     r"!a b c.
            c < a + b
            ==> ?e p r s. rational r /\ rational s /\ rational p /\ rational e /\
                          &0 < e /\
                          a >= r + e /\ b >= s + e /\ c <= p - e /\ p < r + s"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"&0", ← q r"((a + b) - c) / &10"]
        RATIONAL_APPROXIMATION_ABOVE) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"c + e:real", ← q r"e:real"] RATIONAL_APPROXIMATION_ABOVE) THEN
      MP_TAC (← ISPECL [← q r"b - e:real", ← q r"e:real"] RATIONAL_APPROXIMATION_BELOW) THEN
      MP_TAC (← ISPECL [← q r"a - e:real", ← q r"e:real"] RATIONAL_APPROXIMATION_BELOW) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC [← q r"e:real", ← q r"p:real", ← q r"r:real", ← q r"s:real"] THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)
    prove
     r"!f:real^M->real^N.
          (?B. !x y. norm(f x - f y) <= B * norm(x - y))
          ==> negligible {x | ~(f differentiable at x)}"
     (SUBGOAL_THEN
       (← q r"!f:real^M->real^1.
            (?B. !x y. norm(f x - f y) <= B * norm(x - y))
            ==> negligible {x | ~(f differentiable at x)}")
      ASSUME_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"f:real^M->real^N") THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
        ONCE_REWRITE_TAC [DIFFERENTIABLE_COMPONENTWISE_AT] THEN
        REWRITE_TAC [← GSYM IN_NUMSEG, lemma] THEN
        MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE, IN_NUMSEG] THEN
