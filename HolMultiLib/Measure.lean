      ONCE_REWRITE_TAC [INTER_COMM] THEN
      ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_INTER] THEN
      MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN EXISTS_TAC (← q r"(:real^N)") THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, INTEGRABLE_RESTRICT_UNIV])))

  pure { MEASURABLE_DIFFERENTIABLE_IMAGE, MEASURE_DIFFERENTIABLE_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Negligible preimages under full-rank differentiable maps.                -/
/- (measure.ml 18041-18144)                                                 -/
