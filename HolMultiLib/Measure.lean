                    ← NORM_ARITH (← q r"dist(--x:real^N,--y) = dist(x,y)")] THEN
      REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
      GEN_REWRITE_TAC I [SUBSET] THEN X_GEN_TAC (← q r"x:real^1") THEN
      REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [LEFT_OR_FORALL_THM] THEN
      REWRITE_TAC [RIGHT_OR_FORALL_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m + n:num")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a <= abs x <=> a <= x \/ a <= --x"), o_DEF,
                   ← TAUT (← q r"p /\ (q \/ r) <=> p /\ q \/ p /\ r"), EXISTS_OR_THM] THEN
      MATCH_MP_TAC MONO_OR THEN
      CONJ_TAC THEN REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REWRITE_TAC [DROP_NEG, ← REAL_ARITH (← q r"--x - --y:real = --(x - y)"),
                   ← REAL_ARITH (← q r"--a / b:real = --(a / b)")] THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
      MATCH_MP_TAC SUBSET_BALL THEN REWRITE_TAC [← GSYM REAL_OF_NUM_ADD] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN REAL_ARITH_TAC)
    let lemma6 ← prove
     r"!f:real^1->real^1 a b.
        f has_bounded_variation_on interval[a,b] /\ drop a < drop b
        ==> negligible {x | x IN interval[a,b] /\
                            ~(f differentiable (at x within interval[a,b]))}"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_DIFFERENTIABLE] THEN
      REWRITE_TAC [has_vector_derivative, EXISTS_LIFT] THEN
      REWRITE_TAC [← GSYM LIFT_CMUL] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [LIFT_CMUL, LIFT_DROP, has_derivative_within] THEN
      REWRITE_TAC [EXISTS_DROP, LIFT_DROP, LINEAR_SCALING] THEN
      REWRITE_TAC [NORM_1, ← GSYM REAL_ABS_INV] THEN
      ONCE_REWRITE_TAC [LIM_NULL_NORM] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_ABS] THEN REWRITE_TAC [← GSYM NORM_MUL] THEN
      REWRITE_TAC [← GSYM LIM_NULL_NORM] THEN ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"a % (y - (x + d)):real^N = a % (y - x) - a % d")] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
      ONCE_REWRITE_TAC [← MESON [LIFT_DROP] (← q r"a % x = a % lift(drop x)")] THEN
      REWRITE_TAC [← GSYM LIFT_CMUL] THEN
      SIMP_TAC [DROP_EQ, DROP_SUB, ← REAL_FIELD
       (← q r"~(x' = x) ==> (inv(x' - x) * h) * (x' - x):real = h")] THEN
      REWRITE_TAC [LIFT_DROP,
                   ← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      REWRITE_TAC [← GSYM LIM_NULL] THEN
      REWRITE_TAC [CONVERGENT_EQ_CAUCHY_WITHIN, DIST_LIFT] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC
       (← q r"UNIONS {{x | x IN interval[a,b] /\
                    !n. ?u v. u IN ball(x,inv(&n + &1)) /\ u IN interval[a,b] /\
                              v IN ball(x,inv(&n + &1)) /\ v IN interval[a,b] /\
                              ~(u = x) /\ ~(v = x) /\
                              inv(&m + &1)
                              <= abs((drop(f v) - drop(f x)) /
                                     (drop v - drop x) -
                                     (drop(f u) - drop(f x)) /
                                     (drop u - drop x))}
                | m IN (:num)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN GEN_TAC THEN
        MATCH_MP_TAC lemma5 THEN
        ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
        GEN_REWRITE_TAC I [SUBSET] THEN X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN
        ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_TAC THEN
        MATCH_MP_TAC FORALL_POS_MONO_1 THEN CONJ_TAC THENL
         [REPEAT GEN_TAC THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
          MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [REAL_LT_TRANS],
          X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
          REWRITE_TAC [← GSYM REAL_NOT_LT, NOT_FORALL_THM, ← GSYM DIST_NZ] THEN
          REWRITE_TAC [IN_BALL] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"p:num")) THEN
          EXISTS_TAC (← q r"inv(&p + &1)") THEN
          REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
          ASM_MESON_TAC [DIST_SYM]]])
    let lemma7 ← prove
     r"!f:real^1->real^1 a b k.
        f has_bounded_variation_on interval[a,b]
        ==> negligible {x | x IN interval[a,b] /\ ~(f differentiable at x)}"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, NEGLIGIBLE_EMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"a <= b ==> a = b \/ a < b"))) THEN
      REWRITE_TAC [DROP_EQ] THEN STRIP_TAC THENL
       [ASM_REWRITE_TAC [INTERVAL_SING] THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{b:real^1}") THEN
        REWRITE_TAC [SUBSET_RESTRICT, NEGLIGIBLE_SING],
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"(a:real^1) INSERT b INSERT
                    {x | x IN interval[a,b] /\
                              ~((f:real^1->real^1) differentiable
                                (at x within interval[a,b]))}") THEN
        ASM_REWRITE_TAC [NEGLIGIBLE_INSERT] THEN CONJ_TAC THENL
         [MATCH_MP_TAC lemma6 THEN ASM_MESON_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s /\ ~(x = a) /\ ~(x = b) ==> (Q x <=> P x))
          ==> {x | x IN s /\ P x} SUBSET
               a INSERT b INSERT {x | x IN s /\ Q x}")) THEN
        X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [VECTOR_DIFFERENTIABLE] THEN AP_TERM_TAC THEN ABS_TAC THEN
        REWRITE_TAC [has_vector_derivative] THEN
        REWRITE_TAC [has_derivative_at, has_derivative_within] THEN
        AP_TERM_TAC THEN MATCH_MP_TAC LIM_WITHIN_INTERIOR THEN
        REWRITE_TAC [OPEN_CLOSED_INTERVAL_1, INTERIOR_INTERVAL] THEN
        ASM SET_TAC []])
    prove
     r"!f:real^1->real^N a b.
          f has_bounded_variation_on interval[a,b]
          ==> negligible {x | x IN interval[a,b] /\ ~(f differentiable at x)}"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [DIFFERENTIABLE_COMPONENTWISE_AT] THEN
      REWRITE_TAC [← GSYM IN_NUMSEG, NOT_FORALL_THM, NOT_IMP] THEN
      REWRITE_TAC [← SET_RULE (← q r"x IN a /\ (?i. i IN s /\ P i x) <=>
                            ?i. i IN s /\ x IN {x | x IN a /\ P i x}")] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | ?i. i IN k /\ x IN f i} = UNIONS {f i | i IN k}")] THEN
      MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
      SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
      MATCH_MP_TAC lemma7 THEN
      FIRST_ASSUM (MATCH_MP_TAC o
        ONCE_REWRITE_RULE [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
      ASM_REWRITE_TAC []))

  pure { LEBESGUE_DIFFERENTIATION_THEOREM_COMPACT }
/- ------------------------------------------------------------------------- -/
/- The Lebesgue differentiation theorem: general forms.                     -/
/- (measure.ml 24634-24742)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCP where
  LEBESGUE_DIFFERENTIATION_THEOREM : thm
  LEBESGUE_DIFFERENTIATION_THEOREM_ALT : thm
  LEBESGUE_DIFFERENTIATION_THEOREM_GEN : thm
  LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING : thm
  LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCP [HolBase] (D : MeasureDeps) (BMSF : MSF) (BMSBI : MSBI) (BMSCO : MSCO) : ExceptT String IO MSCP := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { LOCALLY_NEGLIGIBLE_ALT, .. } := BMSBI
  let { LEBESGUE_DIFFERENTIATION_THEOREM_COMPACT, .. } := BMSCO
  let { DIFFERENTIABLE_NEG, .. } := D.qderivatives
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, INCREASING_BOUNDED_VARIATION,
        .. } := D.qintegration2
  let { NEGLIGIBLE_FINITE, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { IS_INTERVAL_LOCALLY_COMPACT_INTERVAL, .. } := D.qtopology2
  let { CARD_FRONTIER_INTERVAL_1, OPEN_COUNTABLE_UNION_CLOSED_INTERVALS,
        .. } := D.ig.qtopology
  let { IS_INTERVAL_CONNECTED_1, .. } := D.ig.dv.dg.qconvex
  let { locally, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { ETA_AX, FINITE_RESTRICT, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, INTER_UNIONS,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_NEG2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SIMPLE_IMAGE, SUBSET, SUBSET_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, SWAP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { VECTOR_NEG_NEG, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSURE_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, INTERIOR_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { frontier, OPEN_IN_OPEN, OPEN_IN_REFL, OPEN_INTERIOR, UNIONS_COMPONENTS,
        .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LEBESGUE_DIFFERENTIATION_THEOREM ← prove
   r"!f:real^1->real^N s.
        is_interval s /\ f has_bounded_variation_on s
        ==> negligible {x | x IN s /\ ~(f differentiable at x)}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"negligible {x | x IN frontier s /\ ~(f differentiable at x)} /\
      negligible {x | x IN interior s /\
                      ~((f:real^1->real^N) differentiable at x)}")
    MP_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM NEGLIGIBLE_UNION_EQ] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
      REWRITE_TAC [frontier] THEN
      MP_TAC (← ISPEC (← q r"s:real^1->bool") CLOSURE_SUBSET) THEN SET_TAC []] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_FINITE THEN MATCH_MP_TAC FINITE_RESTRICT THEN
      ASM_MESON_TAC [CARD_FRONTIER_INTERVAL_1],
      SUBGOAL_THEN (← q r"(f:real^1->real^N) has_bounded_variation_on interior s")
      MP_TAC THENL
       [ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_SUBSET, INTERIOR_SUBSET],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"s:real^1->bool") OPEN_INTERIOR) THEN
      POP_ASSUM_LIST (K ALL_TAC)] THEN
    SPEC_TAC ((← q r"interior s:real^1->bool"), (← q r"s:real^1->bool")) THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^1->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    REWRITE_TAC [INTER_UNIONS] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"i:real^1->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:real^1->bool")) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    MATCH_MP_TAC LEBESGUE_DIFFERENTIATION_THEOREM_COMPACT THEN
    ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_SUBSET])

  let LEBESGUE_DIFFERENTIATION_THEOREM_ALT ← prove
   r"!f:real^1->real^N s.
        is_interval s /\ f has_bounded_variation_on s
        ==> ?t. t SUBSET s /\ negligible t /\
                !x. x IN s DIFF t ==> f differentiable at x"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"{x | x IN s /\ ~((f:real^1->real^N) differentiable at x)}") THEN
    ASM_SIMP_TAC [LEBESGUE_DIFFERENTIATION_THEOREM, SUBSET_RESTRICT] THEN
    REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN CONV_TAC (fun t => TAUT t))

  let LEBESGUE_DIFFERENTIATION_THEOREM_GEN ← prove
   r"!f:real^1->real^N s.
        COUNTABLE(components s) /\ f has_bounded_variation_on s
        ==> negligible {x | x IN s /\ ~(f differentiable at x)}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [UNIONS_COMPONENTS] THEN
    REWRITE_TAC [INTER_UNIONS] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    MATCH_MP_TAC LEBESGUE_DIFFERENTIATION_THEOREM THEN
    REWRITE_TAC [IS_INTERVAL_CONNECTED_1] THEN
    ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET,
                   HAS_BOUNDED_VARIATION_ON_SUBSET])

  let LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING ← prove
   r"!f s.
      is_interval s /\
      (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f x) <= drop(f y))
      ==> negligible {x | x IN s /\ ~(f differentiable at x)}"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [LOCALLY_NEGLIGIBLE_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IS_INTERVAL_LOCALLY_COMPACT_INTERVAL) THEN
    REWRITE_TAC [locally] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s:real^1->bool", ← q r"x:real^1"]) THEN
    ASM_REWRITE_TAC [OPEN_IN_REFL] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [OPEN_IN_OPEN, ← MESON []
     (← q r"(?u. (?t. open t /\ u = s INTER t) /\ P u) <=>
      ?t. open t /\ P(s INTER t)")] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^1->bool") THEN
    ASM_REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM, IMP_CONJ, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"i:real^1->bool") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    DISCH_THEN SUBST1_TAC THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{x | x IN interval[a,b] /\
                     ~((f:real^1->real^1) differentiable at x)}") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC LEBESGUE_DIFFERENTIATION_THEOREM_COMPACT THEN
    MATCH_MP_TAC INCREASING_BOUNDED_VARIATION THEN ASM SET_TAC [])

  let LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING ← prove
   r"!f s.
      is_interval s /\
      (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f y) <= drop(f x))
      ==> negligible {x | x IN s /\ ~(f differentiable at x)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(--) o (f:real^1->real^1)", ← q r"s:real^1->bool"]
          LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING) THEN
    ASM_REWRITE_TAC [o_THM, DROP_NEG, REAL_LE_NEG2] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    REPEAT (STRIP_TAC THEN ASM_REWRITE_TAC []) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP DIFFERENTIABLE_NEG) THEN
    ASM_REWRITE_TAC [o_THM, VECTOR_NEG_NEG, ETA_AX])

  pure { LEBESGUE_DIFFERENTIATION_THEOREM, LEBESGUE_DIFFERENTIATION_THEOREM_ALT,
         LEBESGUE_DIFFERENTIATION_THEOREM_GEN,
         LEBESGUE_DIFFERENTIATION_THEOREM_INCREASING,
         LEBESGUE_DIFFERENTIATION_THEOREM_DECREASING }
/- ------------------------------------------------------------------------- -/
/- Forms of absolute continuity of the indefinite (absolute) integral.     -/
/- (measure.ml 24743-24886)                                                 -/
