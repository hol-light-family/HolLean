       DISCH_THEN (SUBST1_TAC o SYM)] THEN
     W (MP_TAC o PART_MATCH (lhand o rand) ABSOLUTELY_INTEGRABLE_LE o
       lhand o snd) THEN
     ANTS_TAC THENL
      [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN CONJ_TAC THEN
       MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL THEN
       EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
       ASM_SIMP_TAC [SUBSET_INTERVAL_1, ← GSYM IN_INTERVAL_1, REAL_LE_REFL, ETA_AX],
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)]) THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [REAL_LE_TRANS, REAL_LT_IMP_LE]
     (← q r"norm(integral i f) < e ==> drop(integral j f) <= norm(integral i f)
      ==> drop(integral j f) <= e")) o SPEC (← q r"n:num")) THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= x ==> a <= abs x")) THEN
    MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
    REWRITE_TAC [LIFT_DROP, NORM_POS_LE] THEN
    ASM_SIMP_TAC [SUBSET_INTERVAL_1, ← GSYM IN_INTERVAL_1, REAL_LE_REFL] THEN
    CONJ_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN REWRITE_TAC [ETA_AX] THEN
    ASM_SIMP_TAC [] THEN CONJ_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
    ASM_SIMP_TAC [SUBSET_INTERVAL_1, ← GSYM IN_INTERVAL_1, REAL_LE_REFL, ETA_AX])

  pure { ABSOLUTE_INTEGRATION_BY_PARTS }
/- ------------------------------------------------------------------------- -/
/- Measurability of inverse function (including sections / selections).    -/
/- (measure.ml 23174-23308)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCM where
  DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION_GEN : thm
  DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION : thm
  LEBESGUE_MEASURABLE_MEASURABLE_IMAGE : thm
  MEASURABLE_ON_INVERSE_FUNCTION : thm
  DOUBLE_LEBESGUE_MEASURABLE_LEFT_INVERSE : thm
  MEASURABLE_ON_LEFT_INVERSE : thm
  DOUBLE_LEBESGUE_MEASURABLE_RIGHT_INVERSE : thm
  MEASURABLE_ON_RIGHT_INVERSE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCM [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAP : MSAP) (BMSAW : MSAW) (BMSBN : MSBN) (BMSBO : MSBO) : ExceptT String IO MSCM := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF,
        LEBESGUE_MEASURABLE_OPEN, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_OPEN, .. } := BMSAP
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN_EQ, .. } := BMSAW
  let { PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN, .. } := BMSBN
  let { LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY, .. } := BMSBO
  let { NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.ig.dv.qsession
  let { OPEN_DELETE, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { AND_FORALL_THM, EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { RIGHT_AND_EXISTS_THM, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SWAP_FORALL_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION_GEN ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t))
        ==> (!t. lebesgue_measurable t
                 ==> lebesgue_measurable(IMAGE f (s INTER t)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC
     (← q r"t INTER {x | x IN s /\ ~((f:real^M->real^N) x = vec 0)}")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_INTER THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEASURABLE_ON_UNIV]) THEN
      REWRITE_TAC [MEASURABLE_ON_PREIMAGE_OPEN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N) DELETE vec 0")) THEN
      SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
         LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF) THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{vec 0:real^N}") THEN
      REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC []])

  let DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION ← prove
   r"!f:real^M->real^N g s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t)) /\
        (!x. x IN s ==> g(f x) = x)
        ==> !t. lebesgue_measurable t
                ==> lebesgue_measurable {y | y IN IMAGE f s /\ g y IN t}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION_GEN) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN
    GEN_TAC THEN MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let (LEBESGUE_MEASURABLE_MEASURABLE_IMAGE, MEASURABLE_ON_INVERSE_FUNCTION) ←
   CONJ_PAIR (← prove
   r"(!f:real^M->real^N s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> lebesgue_measurable(IMAGE f s)) /\
     (!f:real^M->real^N g s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible(IMAGE f t)) /\
        (!x. x IN s ==> g(f x) = x)
        ==> g measurable_on (IMAGE f s))"
   (REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, AND_FORALL_THM] THEN GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_FORALL_THM] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, AND_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> r /\ q")] THEN
    STRIP_TAC THEN
    REWRITE_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN_EQ] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"g:real^N->real^M", ← q r"s:real^M->bool"]
          DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_OPEN]))

  let DOUBLE_LEBESGUE_MEASURABLE_LEFT_INVERSE ← prove
   r"!f:real^M->real^N s.
      f measurable_on s /\
      (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t)) /\
      (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
      ==> ?g. (!x. x IN s ==> g(f x) = x) /\
              (!t. lebesgue_measurable t
                   ==> lebesgue_measurable {y | y IN IMAGE f s /\ g y IN t})"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
    CONJ_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION THEN
    ASM_REWRITE_TAC [])

  let MEASURABLE_ON_LEFT_INVERSE ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t)) /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ?g. (!x. x IN s ==> g(f x) = x) /\ g measurable_on IMAGE f s"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN DISCH_TAC THEN
    CONJ_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_ON_INVERSE_FUNCTION THEN
    ASM_REWRITE_TAC [])

  let DOUBLE_LEBESGUE_MEASURABLE_RIGHT_INVERSE ← prove
   r"!f:real^M->real^N s.
       f measurable_on s /\
       (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t))
       ==> ?g. (!y. y IN IMAGE f s ==> g y IN s /\ f(g y) = y) /\
               (!t. lebesgue_measurable t
                    ==> lebesgue_measurable {y | y IN IMAGE f s /\ g y IN t})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"t:real^M->bool"]
          DOUBLE_LEBESGUE_MEASURABLE_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, SUBSET_TRANS],
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  let MEASURABLE_ON_RIGHT_INVERSE ← prove
   r"!f:real^M->real^N s.
        f measurable_on s /\
        (!t. negligible t /\ t SUBSET s ==> negligible (IMAGE f t))
        ==> ?g. (!y. y IN IMAGE f s ==> g y IN s /\ f(g y) = y) /\
                g measurable_on IMAGE f s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LEBESGUE_MEASURABLE_DOMAIN_OF_INJECTIVITY) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"t:real^M->bool"]
          MEASURABLE_ON_LEFT_INVERSE) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, SUBSET_TRANS],
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  pure { DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION_GEN,
         DOUBLE_LEBESGUE_MEASURABLE_INVERSE_FUNCTION,
         LEBESGUE_MEASURABLE_MEASURABLE_IMAGE, MEASURABLE_ON_INVERSE_FUNCTION,
         DOUBLE_LEBESGUE_MEASURABLE_LEFT_INVERSE, MEASURABLE_ON_LEFT_INVERSE,
         DOUBLE_LEBESGUE_MEASURABLE_RIGHT_INVERSE, MEASURABLE_ON_RIGHT_INVERSE }
/- ------------------------------------------------------------------------- -/
/- Egorov's theorem.                                                        -/
/- (measure.ml 23309-23421)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCN where
  EGOROV : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCN [HolBase] (D : MeasureDeps) (BMSB : MSB) (BMSF : MSF) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAF : MSAF) (BMSAM : MSAM) (BMSAS : MSAS) (BMSAW : MSAW) : ExceptT String IO MSCN := do
  -- @@SCOPE BEGIN
  let { MEASURE_EQ_0, .. } := BMSB
  let { HAS_MEASURE_NESTED_INTERS, MEASURE_COUNTABLE_UNIONS_LE, .. } := BMSF
  let { MEASURABLE_ON_SUB, .. } := BMSAD
  let { MEASURABLE_ON_SPIKE_SET, .. } := BMSAE
  let { MEASURABLE_ON_LIMIT, .. } := BMSAF
  let { LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
        .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED, .. } := BMSAW
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { COUNTABLE_SUBSET_NUM, .. } := D.qcard
  let { SUM_GP, .. } := D.ig.qmisc
  let { REAL_POW_ADD, .. } := D.ig.qsession
  let { LT, SUBSET_UNIONS, .. } := D.ig.dv.dg.qsession
  let { OPEN_CLOSED, .. } := D.ig.dv.dg.qtopology2
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_ASSOC, DE_MORGAN_THM, ETA_AX, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ, IMP_IMP, IN_DIFF, INTERS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_FORALL_THM, REAL_ARCH_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_POW, REAL_LE_INV2, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_POW_LE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_div, real_ge, SUM_LE_NUMSEG, SUM_LMUL, SUM_RMUL, UNIONS_GSPEC, UNIONS_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { LIFT_NUM, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { IN_BALL, LIM_SEQUENTIALLY, OPEN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let EGOROV ← prove
   r"!f:num->real^M->real^N g s t.
        measurable s /\ negligible t /\ (!n. f n measurable_on s) /\
        (!x. x IN s DIFF t ==> ((\n. f n x) --> g x) sequentially)
        ==> !d. &0 < d
                ==> ?k. k SUBSET s /\ measurable k /\ measure k < d /\
                        !e. &0 < e
                            ==> ?N. !n x. N <= n /\ x IN s DIFF k
                                          ==> dist(f n x,g x) < e"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(g:real^M->real^N) measurable_on s") ASSUME_TAC THENL
     [MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN ASM_MESON_TAC [], ALL_TAC] THEN
    ABBREV_TAC (← q r"e = \n m. UNIONS{{x | x IN s /\
                                      dist((f:num->real^M->real^N) k x,g x)
                                        >= inv(&m + &1)} | n <= k}") THEN
    SUBGOAL_THEN
     (← q r"!m n. measurable ((e:num->num->real^M->bool) n m)")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN
      MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "e" THEN CONJ_TAC THENL
       [ALL_TAC, REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN SET_TAC []] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_SUBSET_NUM, FORALL_IN_GSPEC] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [← NORM_ARITH
       (← q r"dist(a:real^M,b) >= e <=> ~(dist(vec 0,a - b) < e)")] THEN
      REWRITE_TAC [← GSYM IN_BALL, ← SET_RULE (← q r"~(x IN s) <=> x IN UNIV DIFF s")] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED THEN
      ASM_SIMP_TAC [← GSYM OPEN_CLOSED, OPEN_BALL,
                    MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
      MATCH_MP_TAC MEASURABLE_ON_SUB THEN CONJ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] MEASURABLE_ON_SPIKE_SET) THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [ETA_AX] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       NEGLIGIBLE_SUBSET)) THEN
      SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m. ?k. measure((e:num->num->real^M->bool) k m) < d / &2 pow (m + 2)")
    MP_TAC THENL
     [GEN_TAC THEN MP_TAC (← ISPEC
        (← q r"\n. (e:num->num->real^M->bool) n m") HAS_MEASURE_NESTED_INTERS) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [GEN_TAC THEN EXPAND_TAC "e" THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC SUBSET_UNIONS THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        ARITH_TAC,
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)] THEN
      SUBGOAL_THEN
       (← q r"measure (INTERS {(e:num->num->real^M->bool) n m | n IN (:num)}) = &0")
      SUBST1_TAC THENL
       [MATCH_MP_TAC MEASURE_EQ_0 THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"t:real^M->bool") THEN
        ASM_REWRITE_TAC [INTERS_GSPEC, SUBSET, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
        ASM_CASES_TAC (← q r"(x:real^M) IN t") THEN ASM_REWRITE_TAC [IN_DIFF] THEN
        EXPAND_TAC "e" THEN REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_DIFF] THEN
        ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [LIM_SEQUENTIALLY, NOT_FORALL_THM, NOT_EXISTS_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"inv(&m + &1)")) THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &m + &1")] THEN
        REWRITE_TAC [DE_MORGAN_THM, real_ge, REAL_NOT_LE] THEN MESON_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [LIM_SEQUENTIALLY, LIFT_NUM, DIST_0, NORM_LIFT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"d / &2 pow (m + 2)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"N:num")) THEN REWRITE_TAC [LE_REFL] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:num->num") THEN DISCH_TAC] THEN
    EXISTS_TAC (← q r"UNIONS {(e:num->num->real^M->bool) (k m) m | m IN (:num)}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN EXPAND_TAC "e" THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN SET_TAC [],
      ALL_TAC] THEN
