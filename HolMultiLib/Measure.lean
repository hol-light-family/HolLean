        X_GEN_TAC (← q r"f':real^M->real^M->real^1") THEN DISCH_TAC] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC
       (← q r"dd UNION {x | ~(x IN dd) /\ ~(linear((f':real^M->real^M->real^1) x))}") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^M") THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
