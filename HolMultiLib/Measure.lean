        MP_TAC (← SPEC (← q r"e:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"!d. g < s + d /\ s <= g /\ d < e ==> abs(g - s) < e")) THEN
        EXISTS_TAC (← q r"inv(&n + &1)") THEN ASM_SIMP_TAC [MEASURE_SUBSET] THEN
