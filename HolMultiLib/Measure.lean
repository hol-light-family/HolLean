        MATCH_MP_TAC GATEAUX_DERIVATIVE_LIPSCHITZ THEN
        EXISTS_TAC (← q r"(:real^M)") THEN ASM_SIMP_TAC [IN_UNIV, OPEN_UNIV] THEN
        ASM_MESON_TAC []] THEN
      SUBGOAL_THEN
       (← q r"!v. lebesgue_measurable
