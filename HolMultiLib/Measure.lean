     [REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV] THEN CONJ_TAC THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
      ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      REWRITE_TAC [← REWRITE_RULE [IN] ABSOLUTELY_INTEGRABLE_RESTRICT_INTER] THEN
      REWRITE_TAC [← SET_RULE (← q r"(\x. P x) INTER UNIV = {x | P x}")] THEN
      REWRITE_TAC [ABSOLUTELY_INTEGRABLE_TRANSLATION] THEN
      REPEAT CONJ_TAC THEN
      REWRITE_TAC [IN_TRANSLATION_GALOIS_ALT, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
      ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID,
                       ← VECTOR_ARITH (← q r"a + --a + x:real^N = x")] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN
      ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_TRANSLATION],

      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [LIFT_DROP] THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN t") THEN
      ASM_REWRITE_TAC [NORM_0, NORM_POS_LE, NORM_LIFT, REAL_ABS_NORM] THEN
      REPEAT (COND_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
      REWRITE_TAC [REAL_LE_REFL]])

  let CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_GEN ← prove
   r"!f:real^M->real^N s t.
       f absolutely_integrable_on s /\ lebesgue_measurable t
       ==> (\a. integral t (\x. f(a + x))) continuous_on
           {a | IMAGE (\x. a + x) t SUBSET s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_ON] THEN
    X_GEN_TAC (← q r"a:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [LIM_NULL] THEN ONCE_REWRITE_TAC [LIM_WITHIN_ZERO] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"IMAGE (\x:real^M. a + x) t"]
     CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM_GEN) THEN
    ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_TRANSLATION] THEN
    REWRITE_TAC [← GSYM INTEGRAL_TRANSLATION] THEN
    MATCH_MP_TAC (← MESON [LIM_WITHIN_SUBSET]
     (← q r"t SUBSET s /\ ((x --> l) (at a within s) ==> (y --> m) (at a within s))
      ==> (x --> l) (at a within s) ==> (y --> m) (at a within t)")) THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, ← GSYM IMAGE_o] THEN
      REWRITE_TAC [IN_ELIM_THM, ← VECTOR_ARITH (← q r"b - a + a + x:real^N = b + x")],
      ALL_TAC] THEN
    REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o RATOR_CONV o LAND_CONV o ABS_CONV)
     [← GSYM LIFT_DROP] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_NULL_COMPARISON) THEN
    REWRITE_TAC [EVENTUALLY_WITHIN] THEN EXISTS_TAC (← q r"&1") THEN
    REWRITE_TAC [REAL_LT_01, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"b:real^M") THEN REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"b + a + x:real^N = (a + b) + x")] THEN
    STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) INTEGRAL_SUB o rand o lhand o snd) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [INTEGRABLE_TRANSLATION] THEN CONJ_TAC THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN
      ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_TRANSLATION],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
    REWRITE_TAC [LIFT_DROP, REAL_LE_REFL] THEN CONJ_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN CONJ_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_TRANSLATION] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_TRANSLATION])

  let CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION ← prove
   r"!f:real^M->real^N.
       f absolutely_integrable_on (:real^M)
       ==> (\a. integral (:real^M) (\x. f(a + x))) continuous_on (:real^M)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"(:real^M)"]
      CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_GEN) THEN
    ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV, SUBSET_UNIV, UNIV_GSPEC])

  let CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF ← prove
   r"!s:real^N->bool.
        measurable s
        ==> ((\a. lift(measure(((IMAGE (\x. a + x) s) DIFF s) UNION
                               (s DIFF IMAGE (\x. a + x) s)))) --> vec 0)
            (at (vec 0))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC I [← GSYM LIM_AT_REFLECT] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
     [← SET_RULE (← q r"s = s INTER UNIV")]) THEN
    REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_ON_INDICATOR] THEN
    REWRITE_TAC [VECTOR_NEG_0] THEN DISCH_THEN (MP_TAC o
      MATCH_MP CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_EVENTUALLY) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"a:real^N") THEN
    ASM_SIMP_TAC [MEASURE_INTEGRAL, MEASURABLE_UNION, MEASURABLE_DIFF,
                  MEASURABLE_TRANSLATION_EQ, LIFT_DROP] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    ASM_REWRITE_TAC [indicator, IN_DIFF, IN_UNION] THEN
    REWRITE_TAC [IN_TRANSLATION_GALOIS] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x - --a:real^N = a + x")] THEN
    REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, NORM_1] THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [DROP_SUB, DROP_VEC]) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let CONTINUOUS_MEASURE_TRANSLATION_DIFF ← prove
   r"!s:real^N->bool.
        measurable s
        ==> ((\a. lift(measure((IMAGE (\x. a + x) s) DIFF s))) --> vec 0)
            (at (vec 0))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_NULL_COMPARISON) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"a:real^N") THEN
    ASM_SIMP_TAC [NORM_LIFT, real_abs, MEASURE_POS_LE, MEASURABLE_DIFF,
                  MEASURABLE_TRANSLATION_EQ] THEN
    MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_DIFF,
                  MEASURABLE_TRANSLATION_EQ] THEN
    SET_TAC [])

  pure { CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM_GEN,
         CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_GEN,
         CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION,
         CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF, CONTINUOUS_MEASURE_TRANSLATION_DIFF }
/- ------------------------------------------------------------------------- -/
/- Continuity of the measure of a differentiable image under translation.   -/
/- (measure.ml 20496-20606)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCD where
  CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_TRANSLATION : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCD [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSG : MSG) (BMSAM : MSAM) (BMSAN : MSAN) (BMSAS : MSAS) (BMSBB : MSBB) (BMSBR : MSBR) (BMSCC : MSCC) : ExceptT String IO MSCD := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_UNION, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, .. } := BMSB
  let { MEASURE_UNION_LE, .. } := BMSC
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { LEBESGUE_MEASURABLE_COMPACT, LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_UNION,
        .. } := BMSAM
  let { LEBESGUE_MEASURABLE_TRANSLATION, .. } := BMSAN
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE, .. } := BMSBB
  let { ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE, .. } := BMSBR
  let { CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF, .. } := BMSCC
  let { DIFFERENTIABLE_ON_SUBSET, .. } := D.qderivatives
  let { COMPACT_TRANSLATION, .. } := D.qtopology1
  let { OPEN_TRANSLATION_SUBSET_PREIMAGE, .. } := D.qtopology2
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, .. } := D.ig.qderivatives
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, LIM_AT, .. } := D.ig.dv.qtopology1
  let { ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.ig.dv.dg.pt.cvx
  let { COMPACT_TRANSLATION_EQ, .. } := D.ig.dv.dg.pt.qtop
  let { CONJ_ASSOC, CONJ_SYM, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LE_REFL, REAL_ABS_NUM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_MIN, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_SUB_REFL, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_0, DIST_LIFT, DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_ADD_SYM, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_SUMS,
        .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL, OPEN_CONTAINS_CBALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_at, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_TRANSLATION ← prove
   r"!f:real^N->real^N s k.
        open s /\ f differentiable_on s /\ compact k
        ==> (\a. lift(measure(IMAGE f (IMAGE (\x. a + x) k))))
            continuous_on {a | IMAGE (\x. a + x) k SUBSET s}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"s:real^N->bool"]
          OPEN_TRANSLATION_SUBSET_PREIMAGE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"{a:real^N | IMAGE (\x. a + x) k SUBSET s}")
      OPEN_CONTAINS_CBALL) THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [continuous_at] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N",
                      ← q r"{x + d:real^N | x IN k /\ d IN cball(b,r)}"]
          ABSOLUTELY_CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE) THEN
    ASM_SIMP_TAC [COMPACT_SUMS, COMPACT_CBALL] THEN
    SUBGOAL_THEN (← q r"{x + d:real^N | x IN k /\ d IN cball (b,r)} SUBSET s")
    ASSUME_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC, SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real^N"] THEN STRIP_TAC THEN
      UNDISCH_TAC
       (← q r"cball(b:real^N,r) SUBSET {a | IMAGE (\x. a + x) k SUBSET s}") THEN
      GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"d:real^N")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_ELIM_THM, SUBSET, FORALL_IN_IMAGE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [VECTOR_ADD_SYM],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        DIFFERENTIABLE_ON_SUBSET)) THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\x:real^N. b + x) k")
      CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF) THEN
    ASM_SIMP_TAC [MEASURABLE_COMPACT, COMPACT_TRANSLATION] THEN
    REWRITE_TAC [LIM_AT, DIST_LIFT, DIST_0, NORM_LIFT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min t r:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c - b:real^N")) THEN
    ASM_REWRITE_TAC [← GSYM dist, ← GSYM DIST_NZ] THEN
    ASM_CASES_TAC (← q r"c:real^N = b") THEN
    ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_NUM] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"c - b + b + x:real^N = c + x")] THEN
    DISCH_THEN (fun th => tactic_of do
      let t ← liftExcept (do rand (← rand (← lhand (concl th))))
      pure (ASSUME_TAC th THEN
        FIRST_X_ASSUM (MP_TAC o SPEC t))) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [← REAL_ARITH (← q r"abs x < d ==> x < d")] THEN
      ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_DIFF, MEASURABLE_COMPACT,
                    COMPACT_TRANSLATION_EQ] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"s UNION t SUBSET u ==> (s DIFF t UNION t DIFF s) SUBSET u")) THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [VECTOR_ADD_SYM] THEN
      SUBGOAL_THEN (← q r"b IN cball(b:real^N,r) /\ c IN cball(b,r)") MP_TAC THENL
       [ALL_TAC, SET_TAC []] THEN
      REWRITE_TAC [IN_CBALL, DIST_REFL] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC,
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (\x. b + x) k SUBSET {x + d:real^N | x IN k /\ d IN cball(b,r)} /\
      IMAGE (\x. c + x) k SUBSET {x + d:real^N | x IN k /\ d IN cball(b,r)}")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN REWRITE_TAC [FORALL_IN_IMAGE, SUBSET] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"x:real^N") THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"b + x:real^N = x + c <=> b = c")] THEN
      ASM_REWRITE_TAC [UNWIND_THM1, IN_CBALL, DIST_REFL] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM o_DEF] THEN
    REWRITE_TAC [IMAGE_o] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"x <= y + d /\ y <= x + d ==> d < e ==> abs(x - y) < e")) THEN
    CONJ_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) MEASURE_UNION_LE o rand o snd) THEN
    (ANTS_TAC THENL
      [ALL_TAC,
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
       MATCH_MP_TAC MEASURE_SUBSET THEN
       REWRITE_TAC [CONJ_ASSOC] THEN
       CONJ_TAC THENL [ALL_TAC, SET_TAC []]]) THEN
    CONJ_TAC THEN
    MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_SUBSET THEN EXISTS_TAC
      (← q r"IMAGE (f:real^N->real^N) {x + d | x IN k /\ d IN cball(b,r)}") THEN
    (REWRITE_TAC [CONJ_ASSOC] THEN
     CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
     CONJ_TAC THENL
      [REPEAT (MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN CONJ_TAC) THEN
       MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE THEN
       ASM_SIMP_TAC [LEBESGUE_MEASURABLE_TRANSLATION,
                     LEBESGUE_MEASURABLE_COMPACT,
                     LEBESGUE_MEASURABLE_UNION, LEBESGUE_MEASURABLE_DIFF] THEN
       REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC DIFFERENTIABLE_ON_SUBSET THEN
       EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
       MATCH_MP_TAC MEASURABLE_COMPACT THEN
       MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
       ASM_SIMP_TAC [COMPACT_SUMS, COMPACT_CBALL] THEN
       MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
       EXISTS_TAC (← q r"s:real^N->bool") THEN
       ASM_SIMP_TAC [DIFFERENTIABLE_IMP_CONTINUOUS_ON]]))

  pure { CONTINUOUS_MEASURE_DIFFERENTIABLE_IMAGE_TRANSLATION }
