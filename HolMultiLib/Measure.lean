      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC))

  let MEASURABLE_ON_VECTOR_DERIVATIVE_GEN ← prove
   r"!f:real^1->real^N f' s.
        lebesgue_measurable s /\
        (!x. x IN s ==> (f has_vector_derivative f'(x)) (at x within s))
        ==> f' measurable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [MEASURABLE_ON_COMPONENTWISE] THEN
    REWRITE_TAC [has_vector_derivative] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")]
          MEASURABLE_ON_PARTIAL_DERIVATIVES)) THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [DIMINDEX_1, FORALL_1] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] MEASURABLE_ON_EQ) THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM drop, LIFT_DROP, matrix] THEN
    ASM_SIMP_TAC [LAMBDA_BETA, VECTOR_MUL_COMPONENT, CART_EQ,
                  FORALL_1, DIMINDEX_1, DROP_BASIS] THEN
    REWRITE_TAC [← GSYM drop, LIFT_DROP, REAL_MUL_LID])

  let MEASURABLE_ON_VECTOR_DERIVATIVE ← prove
   r"!f:real^1->real^N f' s k.
        negligible k /\ lebesgue_measurable s /\
        (!x. x IN (s DIFF k) ==> (f has_vector_derivative f'(x)) (at x))
        ==> f' measurable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f':real^1->real^N) measurable_on (s DIFF k)") MP_TAC THENL
     [MATCH_MP_TAC MEASURABLE_ON_VECTOR_DERIVATIVE_GEN THEN
      EXISTS_TAC (← q r"f:real^1->real^N") THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_DIFF, HAS_VECTOR_DERIVATIVE_AT_WITHIN,
                    NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
      MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
      SET_TAC []])

  let MEASURABLE_ON_DET_JACOBIAN ← prove
   r"!f:real^N->real^N f' s.
         lebesgue_measurable s /\
         (!x. x IN s ==> (f has_derivative f' x) (at x within s))
         ==> (\x. lift(det(matrix(f' x)))) measurable_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [det, LIFT_SUM, o_DEF] THEN
    MATCH_MP_TAC MEASURABLE_ON_VSUM THEN
    SIMP_TAC [FINITE_PERMUTATIONS, FINITE_NUMSEG, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"p:num->num") THEN DISCH_TAC THEN REWRITE_TAC [LIFT_CMUL] THEN
    MATCH_MP_TAC MEASURABLE_ON_CMUL THEN
    MATCH_MP_TAC MEASURABLE_ON_LIFT_PRODUCT THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_ON_PARTIAL_DERIVATIVES THEN
    EXISTS_TAC (← q r"f:real^N->real^N") THEN
    ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG])

  pure { MEASURABLE_ON_PARTIAL_DERIVATIVES, MEASURABLE_ON_VECTOR_DERIVATIVE_GEN,
         MEASURABLE_ON_VECTOR_DERIVATIVE, MEASURABLE_ON_DET_JACOBIAN }
/- ------------------------------------------------------------------------- -/
/- Luzin's theorem (Talvila and Loeb's proof from Marius Junge's notes).    -/
/- (measure.ml 15780-16163)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBM where
  LUZIN : thm
  LUZIN_EQ : thm
  LUZIN_EQ_ALT : thm
  LUZIN_SIGMA : thm
  LUZIN_SIGMA_EXPLICIT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBM [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSJ : MSJ) (BMSO : MSO) (BMSAE : MSAE) (BMSAF : MSAF) (BMSAM : MSAM) (BMSAS : MSAS) (BMSAW : MSAW) (BMSBC : MSBC) : ExceptT String IO MSBM := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_UNION, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_UNIONS, MEASURE_DIFF_SUBSET, MEASURE_EMPTY, .. } := BMSB
  let { MEASURE_UNION, NEGLIGIBLE_OUTER, .. } := BMSC
  let { MEASURABLE_COUNTABLE_INTERS_GEN, MEASURE_COUNTABLE_UNIONS_LE,
        MEASURE_COUNTABLE_UNIONS_LE_GEN, NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { MEASURABLE_CONVEX, .. } := BMSJ
  let { MEASURABLE_INNER_COMPACT, .. } := BMSO
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { MEASURABLE_ON_LIMIT, .. } := BMSAF
  let { MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_ON_MEASURABLE_SUBSET, .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { MEASURABLE_ON_MEASURABLE_PREIMAGE_CLOSED, MEASURABLE_ON_MEASURABLE_PREIMAGE_OPEN,
        .. } := BMSAW
  let { CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSBC
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { COUNTABLE_AS_INJECTIVE_IMAGE_SUBSET, NUM_COUNTABLE, .. } := D.qcard
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.qfloor
  let { COUNTABLE_INTEGER_COORDINATES, FORALL_POS_MONO_1, .. } := D.qmisc
  let { DIFF_INTERS, DIFF_UNIONS_NONEMPTY, FINITE_NUMSEG_LT, SUM_IMAGE_LE,
        UNIONS_INSERT_EMPTY, WF_REC_num, .. } := D.qsession
  let { UNIV_SECOND_COUNTABLE_SEQUENCE, .. } := D.qtopology2
  let { COUNTABLE_SUBSET, COUNTABLE_UNIONS, .. } := D.ig.qcard
  let { FLOOR, INTEGER_CLOSED, .. } := D.ig.qfloor
  let { SUM_GP, UPPER_BOUND_FINITE_SET, .. } := D.ig.qmisc
  let { PAIRWISE_IMAGE, .. } := D.ig.qsession
  let { COMPACT_UNION, .. } := D.ig.qtopology
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { IS_INTERVAL_CONVEX, TIETZE_UNBOUNDED, .. } := D.ig.dv.dg.qconvex
  let { LT, REAL_LT_TRANS, WLOG_LT, .. } := D.ig.dv.dg.qsession
  let { CONTINUOUS_ON_EMPTY, .. } := D.ig.dv.dg.qtopology1
  let { OPEN_CLOSED, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SELECT_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { num_WF, .. } := D.ig.dv.dg.pt.qses
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { AND_FORALL_THM, ARITH, CART_EQ, CONJ_SYM, CONTRAPOS_THM, EMPTY_SUBSET,
        FINITE_IMAGE, FINITE_NUMSEG, FORALL_AND_THM, FORALL_FINITE_SUBSET_IMAGE,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_DIFF, INJECTIVE_ON_ALT, INTER_SUBSET, INTERS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIONS, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IMP,
        REAL_ARCH_POW_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_POW, REAL_LE_INV_EQ, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_LT, REAL_POW_INV, REAL_POW_LE, REAL_POW_LT, REAL_SUB_0,
        RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET,
        SUBSET_DIFF, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, real_div, SUBSET_UNIV, SUM_LE_NUMSEG, SUM_LMUL, SUM_SUBSET_SIMPLE,
        UNIONS_GSPEC, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VEC_COMPONENT, VECTOR_ADD_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, SUBTOPOLOGY_UNIV, .. } := D.ig.dv.dg.pt.cvx.met
  let { BOUNDED_SUBSET, CLOSED_IN, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_EMPTY, COMPACT_IMP_CLOSED, COMPACT_INTERS, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, CONTINUOUS_WITHIN_OPEN,
        .. } := D.ig.dv.dg.pt.cvx.top3
  let { closed, is_interval, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LUZIN ← prove
   r"!f:real^M->real^N s e.
        measurable s /\ f measurable_on s /\ &0 < e
        ==> ?k. compact k /\ k SUBSET s /\
                measure(s DIFF k) < e /\ f continuous_on k"
   (REPEAT STRIP_TAC THEN
    X_CHOOSE_THEN (← q r"v:num->real^N->bool") STRIP_ASSUME_TAC
      UNIV_SECOND_COUNTABLE_SEQUENCE THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          MEASURABLE_ON_MEASURABLE_PREIMAGE_OPEN) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          MEASURABLE_ON_MEASURABLE_PREIMAGE_CLOSED) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. ?k k'.
          compact k /\ k SUBSET {x | x IN s /\ (f:real^M->real^N) x IN v n} /\
          compact k' /\ k' SUBSET {x | x IN s /\ f x IN ((:real^N) DIFF v n)} /\
          measure(s DIFF (k UNION k')) < e / &4 / &2 pow n")
    MP_TAC THENL
     [GEN_TAC THEN
      MP_TAC (← ISPECL [← q r"{x:real^M | x IN s /\ f(x) IN (v:num->real^N->bool) n}",
                        ← q r"e / &4 / &2 / &2 pow n"] MEASURABLE_INNER_COMPACT) THEN
      ASM_SIMP_TAC [REAL_OF_NUM_LT, ARITH, REAL_LT_DIV, REAL_LT_POW2] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"{x:real^M | x IN s /\ f(x) IN (:real^N) DIFF v(n:num)}",
                        ← q r"e / &4 / &2 / &2 pow n"] MEASURABLE_INNER_COMPACT) THEN
      ASM_SIMP_TAC [← GSYM OPEN_CLOSED, REAL_LT_DIV, REAL_POW_LT, REAL_OF_NUM_LT,
                    ARITH] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k':real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
       (← q r"measure(({x | x IN s /\ (f:real^M->real^N) x IN v n} DIFF k) UNION
                ({x | x IN s /\ f x IN ((:real^N) DIFF v(n:num))} DIFF k'))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_UNION, MEASURABLE_COMPACT,
                      ← GSYM OPEN_CLOSED] THEN SET_TAC [],
        ASM_SIMP_TAC [MEASURE_UNION, MEASURABLE_DIFF, MEASURABLE_COMPACT,
                      ← GSYM OPEN_CLOSED, MEASURE_DIFF_SUBSET] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"s < k + e / &4 / &2 / d /\ s' < k' + e / &4 / &2 / d /\ m = &0
          ==> (s - k) + (s' - k') - m < e / &4 / d")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON [MEASURE_EMPTY]
         (← q r"s = {} ==> measure s = &0")) THEN SET_TAC []],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, IN_DIFF, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:num->real^M->bool", ← q r"k':num->real^M->bool"] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
    EXISTS_TAC (← q r"INTERS {k n UNION k' n | n IN (:num)} :real^M->bool") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COMPACT_INTERS THEN
      ASM_SIMP_TAC [FORALL_IN_GSPEC, COMPACT_UNION] THEN SET_TAC [],
      REWRITE_TAC [INTERS_GSPEC] THEN ASM SET_TAC [],
      REWRITE_TAC [DIFF_INTERS, ← SET_RULE
       (← q r"{f y | y IN {g x | x IN s}} = {f(g x) | x IN s}")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC
       (← MESON [] (← q r"measurable s /\ measure s <= b ==> measure s <= b")) THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_UNION, MEASURABLE_COMPACT] THEN
      X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum(0..n) (\i. e / &4 / &2 pow i)") THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [SUM_LE_NUMSEG, REAL_LT_IMP_LE], ALL_TAC] THEN
      ASM_SIMP_TAC [real_div, SUM_LMUL, REAL_LE_LMUL_EQ, ← REAL_ARITH
       (← q r"(e * inv(&4)) * s <= e * inv(&2) <=> e * s <= e * &2")] THEN
      REWRITE_TAC [REAL_INV_POW, SUM_GP, LT] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [← REAL_ARITH
       (← q r"(&1 - s) / (&1 / &2) <= &2 <=> &0 <= s")] THEN
      MATCH_MP_TAC REAL_POW_LE THEN CONV_TAC REAL_RAT_REDUCE_CONV,

      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_OPEN, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?n:num. (f:real^M->real^N)(x) IN v(n) /\ v(n) SUBSET t")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_THEN
         (← q r"!s. open s ==> (?k. s:real^N->bool = UNIONS {v(n:num) | n IN k})")
         (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, UNIONS_GSPEC] THEN ASM SET_TAC [],
        EXISTS_TAC (← q r"(:real^M) DIFF k'(n:num)") THEN
        ASM_SIMP_TAC [← GSYM closed, COMPACT_IMP_CLOSED] THEN ASM SET_TAC []]])

  let (LUZIN_EQ, LUZIN_EQ_ALT) ← CONJ_PAIR (← prove
   r"(!f:real^M->real^N s.
        measurable s
        ==> (f measurable_on s <=>
             !e. &0 < e
                 ==> ?k. compact k /\ k SUBSET s /\
                         measure(s DIFF k) < e /\ f continuous_on k)) /\
   (!f:real^M->real^N s.
        measurable s
        ==> (f measurable_on s <=>
             !e. &0 < e
                 ==> ?k g. compact k /\ k SUBSET s /\
                           measure(s DIFF k) < e /\
                           g continuous_on (:real^M) /\
                           (!x. x IN k ==> g x = f x)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"measurable(s:real^M->bool)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [LUZIN],
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC TIETZE_UNBOUNDED THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN],
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&2 pow n)")) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, REAL_LT_POW2] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:num->real^M->bool", ← q r"g:num->real^M->real^N"] THEN
      STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN MAP_EVERY EXISTS_TAC
       [← q r"g:num->real^M->real^N",
        ← q r"s DIFF UNIONS {INTERS {k m | n <= m} | n IN (:num)}:real^M->bool"] THEN
      REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC CONTINUOUS_IMP_MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
        ASM_MESON_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, CONTINUOUS_ON_SUBSET,
                       SUBSET_UNIV],
        SIMP_TAC [DIFF_UNIONS_NONEMPTY, ← SET_RULE (← q r"~({f x | x IN UNIV} = {})")] THEN
        REWRITE_TAC [NEGLIGIBLE_OUTER] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← SPECL [← q r"inv(&2)", ← q r"e / &4"] REAL_ARCH_POW_INV) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [REAL_POW_INV]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"s DIFF INTERS {k m | n:num <= m}:real^M->bool") THEN
        REPEAT CONJ_TAC THENL
         [REWRITE_TAC [INTERS_GSPEC, FORALL_IN_GSPEC] THEN ASM SET_TAC [],
          MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC MEASURABLE_COUNTABLE_INTERS_GEN THEN
          ASM_SIMP_TAC [FORALL_IN_GSPEC, MEASURABLE_COMPACT] THEN
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC [LE_REFL]] THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
          MATCH_MP_TAC COUNTABLE_IMAGE THEN
          MESON_TAC [NUM_COUNTABLE, COUNTABLE_SUBSET, SUBSET_UNIV],
          REWRITE_TAC [DIFF_INTERS] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC
           (← MESON [] (← q r"measurable s /\ measure s <= b ==> measure s <= b")) THEN
          MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_GEN THEN
          ASM_SIMP_TAC [FORALL_IN_GSPEC, MEASURABLE_COMPACT, MEASURABLE_DIFF] THEN
          CONJ_TAC THENL
           [ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
            MATCH_MP_TAC COUNTABLE_IMAGE THEN
            REWRITE_TAC [← SET_RULE (← q r"{x | x IN s} = s")] THEN
            ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
            MATCH_MP_TAC COUNTABLE_IMAGE THEN
            MESON_TAC [NUM_COUNTABLE, COUNTABLE_SUBSET, SUBSET_UNIV],
            REWRITE_TAC [SIMPLE_IMAGE] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
            REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
            ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
            REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
            X_GEN_TAC (← q r"ns:num->bool") THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
            STRIP_TAC THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
            W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE_LE o lhand o snd) THEN
            ASM_SIMP_TAC [o_DEF, MEASURE_POS_LE, MEASURABLE_DIFF,
                          MEASURABLE_COMPACT] THEN
            MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
            FIRST_ASSUM (MP_TAC o SPEC (← q r"\x:num. x") o
              MATCH_MP UPPER_BOUND_FINITE_SET) THEN
            REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"m:num") THEN
            STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
            EXISTS_TAC (← q r"sum (n..m) (\i. measure(s DIFF k i:real^M->bool))") THEN
            CONJ_TAC THENL
             [MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
              ASM_SIMP_TAC [MEASURE_POS_LE, MEASURABLE_DIFF, MEASURABLE_COMPACT,
                            FINITE_NUMSEG, SUBSET, IN_NUMSEG],
              ALL_TAC] THEN
            MATCH_MP_TAC REAL_LE_TRANS THEN
            EXISTS_TAC (← q r"sum (n..m) (\i. inv(&2 pow i))") THEN
            ASM_SIMP_TAC [SUM_LE_NUMSEG, REAL_LT_IMP_LE] THEN
            REWRITE_TAC [REAL_INV_POW, SUM_GP, LT] THEN
            COND_CASES_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN MATCH_MP_TAC (← REAL_ARITH
             (← q r"a <= e / &4 /\ &0 <= b
              ==> (a - b) / (&1 / &2) <= e / &2")) THEN
            REWRITE_TAC [real_div, REAL_MUL_LID, REAL_POW_INV] THEN
            ASM_SIMP_TAC [← GSYM real_div, REAL_LT_IMP_LE, REAL_LE_INV_EQ,
                          REAL_LT_POW2]]],
        REWRITE_TAC [← SET_RULE (← q r"s DIFF (s DIFF t) = s INTER t")] THEN
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [UNIONS_GSPEC, IN_INTER] THEN
        REWRITE_TAC [IN_UNIV, IN_ELIM_THM, INTERS_GSPEC] THEN
        STRIP_TAC THEN MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN ASM_MESON_TAC []]]))

  let LUZIN_SIGMA ← (do
    let lemma ← prove
     r"!f:real^M->real^N s.
           measurable s /\ f measurable_on s
           ==> ?u. COUNTABLE u /\ pairwise DISJOINT u /\
                   (!k. k IN u
                        ==> compact k /\ k SUBSET s /\ f continuous_on k) /\
                   negligible(s DIFF UNIONS u)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?g. !n. g n =
                @k. compact k /\
                    k SUBSET (s DIFF UNIONS {g(i:num) | i < n}) /\
                    measure((s DIFF UNIONS {g i | i < n}) DIFF k)
                    < inv(&n + &1) /\
                    (f:real^M->real^N) continuous_on k")
      MP_TAC THENL
       [MATCH_MP_TAC WF_REC_num THEN
        REPEAT STRIP_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
        AP_TERM_TAC THEN BINOP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        REPLICATE_TAC 2 (AP_THM_TAC THEN AP_TERM_TAC) THEN
        AP_TERM_TAC THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_TAC (← q r"g:num->real^M->bool"))] THEN
      SUBGOAL_THEN
       (← q r"!n:num. compact (g n) /\
                (g n) SUBSET (s DIFF UNIONS {g(i:num) | i < n}) /\
                measure (s DIFF UNIONS {g i | i < n} DIFF (g n))
                < inv(&n + &1) /\
                (f:real^M->real^N) continuous_on (g n)")
      MP_TAC THENL
       [MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o SPEC (← q r"n:num")) THEN CONV_TAC SELECT_CONV THEN
        MATCH_MP_TAC LUZIN THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        CONJ_TAC THENL
         [ALL_TAC,
          MATCH_MP_TAC MEASURABLE_ON_MEASURABLE_SUBSET THEN
          EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_DIFF]] THEN
        MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, MEASURABLE_COMPACT] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC FINITE_IMAGE THEN
        REWRITE_TAC [FINITE_NUMSEG_LT],
        FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"0")) THEN
        REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
      EXISTS_TAC (← q r"IMAGE (g:num->real^M->bool) (:num)") THEN
      ASM_SIMP_TAC [NUM_COUNTABLE, COUNTABLE_IMAGE, FORALL_IN_IMAGE, IN_UNIV] THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [PAIRWISE_IMAGE] THEN REWRITE_TAC [pairwise, IN_UNIV] THEN
        MATCH_MP_TAC WLOG_LT THEN REWRITE_TAC [] THEN ASM SET_TAC [],
        ASM SET_TAC [],
        REWRITE_TAC [NEGLIGIBLE_OUTER] THEN MATCH_MP_TAC FORALL_POS_MONO_1 THEN
        CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ALL_TAC] THEN
        X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC
         (← q r"s DIFF UNIONS {(g:num->real^M->bool) i | i < n} DIFF g n") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN
        MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_SIMP_TAC [MEASURABLE_COMPACT] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, MEASURABLE_COMPACT] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC FINITE_IMAGE THEN
       REWRITE_TAC [FINITE_NUMSEG_LT]])
    prove
     r"!f:real^M->real^N s.
         lebesgue_measurable s /\ f measurable_on s
         ==> ?u. COUNTABLE u /\ pairwise DISJOINT u /\
                 (!k. k IN u ==> compact k /\ k SUBSET s /\ f continuous_on k) /\
                 negligible(s DIFF UNIONS u)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!a. ?u. COUNTABLE u /\ pairwise DISJOINT u /\
              (!k. k IN u
                   ==> compact k /\
                       k SUBSET
                       s INTER {x | !i. 1 <= i /\ i <= dimindex(:M)
                                        ==> a$i <= x$i /\ x$i < a$i + &1} /\
                       (f:real^M->real^N) continuous_on k) /\
              negligible(s INTER {x | !i. 1 <= i /\ i <= dimindex(:M)
                                        ==> (a:real^M)$i <= x$i /\
                                            x$i < a$i + &1}
                         DIFF UNIONS u)")
      MP_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC lemma THEN
        CONJ_TAC THENL
         [ALL_TAC,
          MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
          EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [INTER_SUBSET] THEN
          MATCH_MP_TAC MEASURABLE_IMP_LEBESGUE_MEASURABLE] THEN
        MATCH_MP_TAC MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE THEN
        ASM_REWRITE_TAC [] THEN
        (MATCH_MP_TAC MEASURABLE_CONVEX THEN CONJ_TAC THENL
          [MATCH_MP_TAC IS_INTERVAL_CONVEX THEN
           REWRITE_TAC [is_interval, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN
           REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
           GEN_TAC THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
           ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
           MATCH_MP_TAC BOUNDED_SUBSET THEN
           EXISTS_TAC (← q r"interval[a:real^M,a + vec 1]") THEN
           REWRITE_TAC [BOUNDED_INTERVAL] THEN
           SIMP_TAC [SUBSET, IN_INTERVAL, VECTOR_ADD_COMPONENT, VEC_COMPONENT] THEN
           SIMP_TAC [REAL_LT_IMP_LE, IN_ELIM_THM]]),
         REWRITE_TAC [SKOLEM_THM, IN_ELIM_THM, LEFT_IMP_EXISTS_THM]] THEN
       X_GEN_TAC (← q r"u:real^M->(real^M->bool)->bool") THEN
       REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
       EXISTS_TAC
        (← q r"UNIONS (IMAGE (u:real^M->(real^M->bool)->bool)
                   {x | !i. 1 <= i /\ i <= dimindex(:M) ==> integer(x$i)})") THEN
       REPEAT CONJ_TAC THENL
        [MATCH_MP_TAC COUNTABLE_UNIONS THEN
         ASM_REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
         SIMP_TAC [COUNTABLE_INTEGER_COORDINATES, COUNTABLE_IMAGE],
         REWRITE_TAC [pairwise] THEN REWRITE_TAC [IMP_CONJ] THEN
         REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_IN_UNIONS] THEN
         REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
         X_GEN_TAC (← q r"a:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
         X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN
         X_GEN_TAC (← q r"b:real^M") THEN DISCH_TAC THEN
         X_GEN_TAC (← q r"l:real^M->bool") THEN REPEAT DISCH_TAC THEN
         ASM_CASES_TAC (← q r"a:real^M = b") THENL
          [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [], ALL_TAC] THEN
         FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
         REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"i:num") STRIP_ASSUME_TAC) THEN
         MP_TAC (← SPEC (← q r"(a:real^M)$i - (b:real^M)$i") REAL_ABS_INTEGER_LEMMA) THEN
         ASM_SIMP_TAC [INTEGER_CLOSED, REAL_SUB_0] THEN DISCH_TAC THEN
         FIRST_X_ASSUM (fun th => tactic_of do
           pure (MP_TAC (← ISPECL [← q r"a:real^M", ← q r"k:real^M->bool"] th) THEN
                 MP_TAC (← ISPECL [← q r"b:real^M", ← q r"l:real^M->bool"] th))) THEN
         ASM_REWRITE_TAC [IMP_IMP] THEN
         DISCH_THEN (CONJUNCTS_THEN (fun th => tactic_of do
           pure (MP_TAC (← liftExcept (el 1 (CONJUNCTS th)))))) THEN
         MATCH_MP_TAC (← SET_RULE
          (← q r"DISJOINT i j
           ==> k SUBSET s INTER i ==> l SUBSET s INTER j ==> DISJOINT k l")) THEN
         REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. x IN s /\ x IN t ==> F")] THEN
         X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN
         DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"i:num"))) THEN
         ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
         REWRITE_TAC [FORALL_IN_UNIONS] THEN
         REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
         ASM SET_TAC [],
         FIRST_ASSUM (MP_TAC o
           ISPEC (← q r"{x:real^M | !i. 1 <= i /\ i <= dimindex(:M) ==> integer(x$i)}") o
          MATCH_MP
          (← MESON [FORALL_IN_IMAGE, COUNTABLE_IMAGE, NEGLIGIBLE_COUNTABLE_UNIONS_GEN]
          (← q r"(!a. negligible(f a))
           ==> !s. COUNTABLE s ==> negligible(UNIONS (IMAGE f s))"))) THEN
         REWRITE_TAC [COUNTABLE_INTEGER_COORDINATES] THEN
         MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
         REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, SUBSET, IN_DIFF, IN_INTER] THEN
         X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
         STRIP_TAC THEN EXISTS_TAC (← q r"(lambda i. floor((x:real^M)$i)):real^M") THEN
         ASM_SIMP_TAC [LAMBDA_BETA, FLOOR] THEN
         FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
         REWRITE_TAC [CONTRAPOS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
         X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
         EXISTS_TAC (← q r"(lambda i. floor((x:real^M)$i)):real^M") THEN
         ASM_SIMP_TAC [LAMBDA_BETA, FLOOR]]))

  let LUZIN_SIGMA_EXPLICIT ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s /\ f measurable_on s
        ==> ?k. (!n. compact(k n)) /\
                (!n. k n SUBSET s) /\
                (!n. f continuous_on k n) /\
                pairwise (\m n. DISJOINT (k m) (k n)) (:num) /\
                negligible(s DIFF UNIONS {k n | n IN (:num)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LUZIN_SIGMA) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:(real^M->bool)->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
     [COUNTABLE_AS_INJECTIVE_IMAGE_SUBSET]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, INJECTIVE_ON_ALT] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:num->real^M->bool", ← q r"t:num->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n. if n IN t then (k:num->real^M->bool) n else {}") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_IMAGE]) THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [COMPACT_EMPTY],
      ASM_MESON_TAC [EMPTY_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_EMPTY],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
      REWRITE_TAC [pairwise, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN ASM SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              NEGLIGIBLE_SUBSET)) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s = t ==> s SUBSET t")) THEN
      AP_TERM_TAC THEN ONCE_REWRITE_TAC [← GSYM UNIONS_INSERT_EMPTY] THEN
      AP_TERM_TAC THEN SET_TAC []])

  pure { LUZIN, LUZIN_EQ, LUZIN_EQ_ALT, LUZIN_SIGMA, LUZIN_SIGMA_EXPLICIT }
