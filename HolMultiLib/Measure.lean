        MATCH_MP_TAC (← MESON []
         (← q r"(!x y. P x y ==> Q x y) ==> (!x y. P x y ==> Q x y \/ R x y)")) THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC [],
        X_GEN_TAC (← q r"i:A") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"(r:A->real) i / B"] REAL_ARCH_POW_INV) THEN
        SUBGOAL_THEN (← q r"&0 < (r:A->real) i /\ r i <= B") STRIP_ASSUME_TAC THENL
         [ASM_SIMP_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"&0 < B") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_MUL_LZERO] THEN
