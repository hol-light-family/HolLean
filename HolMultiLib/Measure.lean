structure MSCC where
  CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM_GEN : thm
  CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_GEN : thm
  CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION : thm
  CONTINUOUS_MEASURE_TRANSLATION_SYMDIFF : thm
  CONTINUOUS_MEASURE_TRANSLATION_DIFF : thm
