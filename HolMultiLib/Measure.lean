      SUBGOAL_THEN (← q r"~(cball((a:A->real^N) i,r i) = {})") MP_TAC THENL
       [ASM_SIMP_TAC [CBALL_EQ_EMPTY, REAL_NOT_LT], ASM SET_TAC []] THEN
      MATCH_MP_TAC REAL_LT_IMP_LE THEN ASM SET_TAC [],
      REWRITE_TAC [FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"UNIONS (IMAGE (c:num->A->bool) (:num))") THEN
      MATCH_MP_TAC (← TAUT
       (← q r"q /\ (q /\ r ==> p) /\ r /\ s ==> p /\ q /\ r /\ s")) THEN
      REPEAT CONJ_TAC THENL
       [ASM SET_TAC [],
        SPEC_TAC ((← q r"UNIONS (IMAGE (c:num->A->bool) (:num))"), (← q r"q:A->bool")) THEN
        REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"\i. cball((a:A->real^N) i,r i)", ← q r"q:A->bool"]
          COUNTABLE_IMAGE_INJ_EQ) THEN
        ANTS_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"i:A", ← q r"j:A"] THEN
          REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
          REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
          DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE
           (← q r"~(s = {}) /\ DISJOINT s t ==> ~(s = t)")) THEN
          RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
          ASM_SIMP_TAC [CBALL_EQ_EMPTY] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(x < &0)")) THEN
          ASM SET_TAC [],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        MATCH_MP_TAC COUNTABLE_DISJOINT_NONEMPTY_INTERIOR_SUBSETS THEN
