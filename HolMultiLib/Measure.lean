structure MSAW where
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED_INTERVAL : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GE : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GT : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LE : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LT : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN_INTERVAL : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL : thm
  LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_OPEN : thm
  LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN_EQ : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED_EQ : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_CLOSED : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_CLOSED_INTERVAL : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_OPEN : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GE : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GT : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LE : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LT : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_OPEN_INTERVAL : thm
  MEASURABLE_MEASURABLE_PREIMAGE_OPEN : thm
  MEASURABLE_MEASURABLE_PREIMAGE_CLOSED : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_OPEN_EQ : thm
  MEASURABLE_ON_MEASURABLE_PREIMAGE_CLOSED_EQ : thm
  LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_BOREL : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_BOREL_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAW [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAM : MSAM) (BMSAO : MSAO) (BMSAP : MSAP) (BMSAS : MSAS) : ExceptT String IO MSAW := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_UNIV, .. } := BMSAB
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_UNION,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { MEASURABLE_ON_PREIMAGE_BOREL, MEASURABLE_ON_PREIMAGE_CLOSED,
        MEASURABLE_ON_PREIMAGE_CLOSED_INTERVAL,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GE,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT,
        MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LE, MEASURABLE_ON_PREIMAGE_OPEN,
        MEASURABLE_ON_PREIMAGE_OPEN_INTERVAL, .. } := BMSAP
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { BOREL_UNIV, .. } := D.qtopology1
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
