     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      ABBREV_TAC
       (← q r"m = integral s (\x:real^N. lift(abs(det(matrix(f' x):real^N^N))))") THEN
      SUBGOAL_THEN
       (← q r"measurable(IMAGE (f:real^N->real^N) s) /\
