        ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_INTER,
                          ← GSYM INTEGRAL_RESTRICT_INTER] THEN
        REWRITE_TAC [IN_ELIM_THM, ← MESON [] (← q r"(if ~(x = a) then x else a) = x")] THEN
        REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
         [MATCH_MP_TAC INTEGRABLE_SPIKE_SET,
          MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          AP_TERM_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE_SET] THEN
        REWRITE_TAC [REAL_ABS_ZERO] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC
         (← q r"IMAGE (g:real^N->real^N)
                {x | x IN s /\ det(matrix(g' x):real^N^N) = &0}") THEN
        (CONJ_TAC THENL [ALL_TAC, SET_TAC []]) THEN
        MATCH_MP_TAC BABY_SARD THEN
        EXISTS_TAC (← q r"g':real^N->real^N->real^N") THEN
        SIMP_TAC [IN_ELIM_THM, LE_REFL, DET_EQ_0_RANK] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
        EXISTS_TAC (← q r"s:real^N->bool") THEN ASM SET_TAC []])
    let version2 ← prove
     r"!f:real^N->real^1 g:real^N->real^N g' s.
            (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
            (\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s
            ==> f absolutely_integrable_on (IMAGE g s)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\x. --((f:real^N->real^1) x)", ← q r"g:real^N->real^N",
        ← q r"g':real^N->real^N->real^N",
        ← q r"{x | x IN s /\ drop(f((g:real^N->real^N) x)) < &0}",
        ← q r"drop(integral {x | x IN s /\ drop(f((g:real^N->real^N) x)) < &0}
                       (\x. abs(det(matrix(g' x):real^N^N)) % --(f(g x))))"]
       version1) THEN
      MP_TAC (← ISPECL
       [← q r"f:real^N->real^1", ← q r"g:real^N->real^N", ← q r"g':real^N->real^N->real^N",
        ← q r"{x | x IN s /\ &0 < drop(f((g:real^N->real^N) x))}",
        ← q r"drop(integral {x | x IN s /\ &0 < drop(f((g:real^N->real^N) x))}
                       (\x. abs(det(matrix(g' x):real^N^N)) % f(g x)))"]
       version1) THEN
      REWRITE_TAC [REAL_LE_REFL, ← SET_RULE
       (← q r"IMAGE g {x | x IN s /\ P(g x)} = {y | y IN IMAGE g s /\ P y}")] THEN
      REWRITE_TAC [INTEGRABLE_NEG_EQ, ETA_AX] THEN
      SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE, REAL_NEG_GE0, DROP_NEG] THEN
      REWRITE_TAC [VECTOR_MUL_RNEG, INTEGRABLE_NEG_EQ] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
          MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
          EXISTS_TAC (← q r"s:real^N->bool") THEN ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"(\x. abs(det(matrix(g' x))) % f((g:real^N->real^N) x)) integrable_on
          {x | x IN s /\ &0 < drop(abs(det(matrix(g' x):real^N^N)) % f(g x))}")
        MP_TAC THENL
         [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
          FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET)) THEN
          REWRITE_TAC [SUBSET_RESTRICT] THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_IMP_MEASURABLE o
             MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
          ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
          REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"&0")) THEN
          REWRITE_TAC [FORALL_1, DIMINDEX_1, real_gt, ← GSYM drop] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
          REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
          ASM_REWRITE_TAC [DROP_VEC, REAL_LT_REFL],
          ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          REWRITE_TAC [FUN_EQ_THM, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
          ASM_CASES_TAC (← q r"det(matrix(g'(x:real^N)):real^N^N) = &0") THEN
          ASM_REWRITE_TAC [VECTOR_MUL_LZERO, COND_ID,
                           REAL_ABS_NUM, DROP_CMUL] THEN
          ASM_SIMP_TAC [REAL_LT_MUL_EQ, ← GSYM REAL_ABS_NZ]],
        DISCH_THEN (MP_TAC o ISPEC (← q r"(\x. vec 0):real^N->real^1") o MATCH_MP
         (← ONCE_REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
            ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND) o
         CONJUNCT1) THEN
        SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE, DROP_VEC] THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0] THEN
        MATCH_MP_TAC (← TAUT (← q r"(q ==> p ==> r) ==> p ==> q ==> r"))] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
          MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
          EXISTS_TAC (← q r"s:real^N->bool") THEN ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"(\x. abs(det(matrix(g' x))) % f((g:real^N->real^N) x)) integrable_on
          {x | x IN s /\ drop(abs(det(matrix(g' x):real^N^N)) % f(g x)) < &0}")
        MP_TAC THENL
         [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
          FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET)) THEN
          REWRITE_TAC [SUBSET_RESTRICT] THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_IMP_MEASURABLE o
             MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
          ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
          REWRITE_TAC [MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"&0")) THEN
          REWRITE_TAC [FORALL_1, DIMINDEX_1, real_gt, ← GSYM drop] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
          REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
          ASM_REWRITE_TAC [DROP_VEC, REAL_LT_REFL],
          ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
          REWRITE_TAC [FUN_EQ_THM, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
          ASM_CASES_TAC (← q r"det(matrix(g'(x:real^N)):real^N^N) = &0") THEN
          ASM_REWRITE_TAC [VECTOR_MUL_LZERO, COND_ID, REAL_ABS_NUM] THEN
          REWRITE_TAC [DROP_CMUL, ← REAL_ARITH (← q r"a * b < &0 <=> &0 < a * --b")] THEN
          ASM_SIMP_TAC [REAL_LT_MUL_EQ, ← GSYM REAL_ABS_NZ, REAL_NEG_GT0]],
        DISCH_THEN (MP_TAC o ISPEC (← q r"(\x. vec 0):real^N->real^1") o MATCH_MP
         (← ONCE_REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> q ==> p /\ r ==> s")]
            ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_UBOUND) o
         CONJUNCT1) THEN
        SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE, DROP_VEC] THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0, IMP_IMP]] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_UNION) THEN
      ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, IN_ELIM_THM, IN_UNION] THEN
      X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(f:real^N->real^1) x = vec 0") THEN
      ASM_REWRITE_TAC [COND_ID] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM DROP_EQ]) THEN
      REWRITE_TAC [DROP_VEC, ← REAL_ARITH (← q r"~(x = &0) <=> x < &0 \/ &0 < x")] THEN
      MESON_TAC [])
    let ABSOLUTELY_INTEGRABLE_ON_IMAGE ← prove
     r"!f:real^M->real^N g:real^M->real^M g' s.
            (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
            (\x. abs(det(matrix(g' x))) % f(g x)) absolutely_integrable_on s
            ==> f absolutely_integrable_on (IMAGE g s)"
     (REPEAT GEN_TAC THEN
      ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
      REWRITE_TAC [RIGHT_AND_FORALL_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
      ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [VECTOR_MUL_COMPONENT, LIFT_CMUL, version2])
    let INTEGRAL_ON_IMAGE_DROP_UBOUND_LE ← prove
     r"!f:real^N->real^1 g:real^N->real^N g' s b.
            (!x. x IN s ==> &0 <= drop(f(g x))) /\
            (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
            (\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\
            drop(integral s (\x. abs(det(matrix (g' x))) % f(g x))) <= b
            ==> drop(integral (IMAGE g s) f) <= b"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP version1) THEN SIMP_TAC [])
    pure (ABSOLUTELY_INTEGRABLE_ON_IMAGE, INTEGRAL_ON_IMAGE_DROP_UBOUND_LE))

  pure { ABSOLUTELY_INTEGRABLE_ON_IMAGE, INTEGRAL_ON_IMAGE_DROP_UBOUND_LE }
/- ------------------------------------------------------------------------- -/
/- The classic change-of-variables theorem, invertible version.             -/
/- (measure.ml 18691-19112)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBX where
  HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_INVERTIBLE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBX [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAK : MSAK) (BMSAM : MSAM) (BMSAO : MSAO) (BMSAP : MSAP) (BMSAY : MSAY) (BMSBW : MSBW) : ExceptT String IO MSBX := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_IMP_MEASURABLE, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { BABY_SARD, .. } := BMSAK
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAM
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT, .. } := BMSAP
  let { ABSOLUTELY_INTEGRABLE_UNION, .. } := BMSAY
  let { ABSOLUTELY_INTEGRABLE_ON_IMAGE, INTEGRAL_ON_IMAGE_DROP_UBOUND_LE, .. } := BMSBW
  let { HAS_DERIVATIVE_INVERSE_WITHIN, .. } := D.qderivatives
  let { DET_EQ_0, DET_EQ_0_RANK, .. } := D.qdet
  let { ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND,
        ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_UBOUND,
        ABSOLUTELY_INTEGRABLE_COMPONENTWISE, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_INTEGRABLE_SPIKE_SET_EQ,
        .. } := D.qintegration1
  let { HAS_INTEGRAL_COMPONENTWISE, HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_UNION,
        INTEGRABLE_EQ, INTEGRABLE_NEG_EQ, .. } := D.qintegration2
  let { INTEGRAL_EQ, INTEGRAL_NEG, INTEGRAL_RESTRICT_UNIV, INTEGRAL_SPIKE_SET,
        INTEGRAL_UNION, INTEGRAL_UNIQUE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET,
        .. } := D.qintegration3
  let { REAL_NEG_GT0, .. } := D.qsession
  let { differentiable, differentiable_on, has_derivative, HAS_DERIVATIVE_WITHIN_SUBSET,
        .. } := D.ig.qderivatives
  let { COND_SWAP, .. } := D.ig.qsession
  let { REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { INVERTIBLE_DET_NZ, .. } := D.ig.dv.dg.qdet
  let { MATRIX_I, MATRIX_INVERTIBLE, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_RING,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { AND_FORALL_THM, CONJ_ASSOC, DIMINDEX_1, EMPTY_GSPEC, EQ_IMP, ETA_AX, EXTENSION,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, IN_UNIV, LE_REFL, LEFT_AND_EXISTS_THM, LEFT_OR_DISTRIB,
        MONO_AND, NOT_IMP, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ANTISYM, REAL_LE_MUL, REAL_LE_TRANS, REAL_LT_ANTISYM,
        REAL_LT_IMP_LE, REAL_LT_MUL_EQ, REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        SUBSET_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, real_gt, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_VEC, FORALL_1, FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, MATRIX_COMPOSE, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_EQ_NEG2, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RCANCEL, VECTOR_MUL_RNEG,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { DET_I, DET_MUL, .. } := D.ig.dv.dg.pt.cvx.det
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.top3
  -- @@SCOPE END

  let HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_INVERTIBLE ← (do
    let version0 ← prove
     r"!f:real^N->real^1 g:real^N->real^N h g' h' s t b.
            (!x. x IN s ==> g(x) IN t /\ h(g x) = x) /\
            (!y. y IN t ==> h(y) IN s /\ g(h y) = y) /\
            (!y. y IN t ==> &0 <= drop(f y)) /\
            (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
            (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\
            (!y. y IN t ==> h' y o g'(h y) = I)
            ==> (f integrable_on t /\
                 drop(integral t f) <= b <=>
                 (\x. abs(det(matrix(g' x))) % f(g x)) integrable_on s /\
                 drop (integral s (\x. abs(det(matrix (g' x))) % f(g x))) <= b)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE (g:real^N->real^N) s = t /\ IMAGE h t = s")
      STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      EQ_TAC THEN STRIP_TAC THENL
       [EXPAND_TAC "s", EXPAND_TAC "t"] THEN
      (CONJ_TAC THENL
         [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
          MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_IMAGE,
          MATCH_MP_TAC INTEGRAL_ON_IMAGE_DROP_UBOUND_LE])
      THENL
       [EXISTS_TAC (← q r"h':real^N->real^N->real^N") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND THEN
        EXISTS_TAC (← q r"(\x. vec 0):real^N->real^1") THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0, DROP_VEC, VECTOR_MUL_ASSOC] THEN
        ASM_SIMP_TAC [← GSYM REAL_ABS_MUL, REAL_LE_MUL,
                      DROP_CMUL, REAL_ABS_POS] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            INTEGRABLE_EQ)),
        EXISTS_TAC (← q r"h':real^N->real^N->real^N") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "t" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [DROP_CMUL, REAL_LE_MUL, REAL_ABS_POS] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            INTEGRABLE_EQ)),
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            REAL_LE_TRANS)) THEN
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
          MATCH_MP_TAC INTEGRAL_EQ THEN
          CONV_TAC (ONCE_DEPTH_CONV SYM_CONV)],
        EXISTS_TAC (← q r"g':real^N->real^N->real^N") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND THEN
        EXISTS_TAC (← q r"(\x. vec 0):real^N->real^1") THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0, DROP_VEC] THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_ABS_POS, DROP_CMUL],
        EXISTS_TAC (← q r"g':real^N->real^N->real^N") THEN ASM_REWRITE_TAC [] THEN
        ASM SET_TAC []] THEN
      ASM_SIMP_TAC [← GSYM DET_MUL, VECTOR_MUL_ASSOC, ← GSYM REAL_ABS_MUL] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN CONV_TAC SYM_CONV THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM VECTOR_MUL_LID] THEN
      REWRITE_TAC [VECTOR_MUL_RCANCEL] THEN DISJ1_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [has_derivative]) THEN
      ASM_SIMP_TAC [← GSYM MATRIX_COMPOSE] THEN
      REWRITE_TAC [MATRIX_I, DET_I, REAL_ABS_NUM])
    let version1 ← prove
     r"!f:real^N->real^1 g:real^N->real^N h g' h' s t b.
            (!x. x IN s ==> g(x) IN t /\ h(g x) = x) /\
            (!y. y IN t ==> h(y) IN s /\ g(h y) = y) /\
            (!y. y IN t ==> &0 <= drop(f y)) /\
            (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
            (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\
            (!y. y IN t ==> h' y o g'(h y) = I)
            ==> (((\x. abs(det(matrix(g' x))) % f(g x)) has_integral b) s <=>
                 (f has_integral b) t)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
      SPEC_TAC ((← q r"b:real^1"), (← q r"b:real^1")) THEN
      REWRITE_TAC [FORALL_LIFT, ← GSYM DROP_EQ, LIFT_DROP] THEN
      REWRITE_TAC [← MESON [REAL_LE_TRANS, REAL_LE_ANTISYM]
       (← q r"(!b. P x /\ f x = b <=> Q x /\ g x = b) <=>
        (!b. P x /\ f x <= b <=> Q x /\ g x <= b)")] THEN
      GEN_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC version0 THEN
      MAP_EVERY EXISTS_TAC [← q r"h:real^N->real^N", ← q r"h':real^N->real^N->real^N"] THEN
      ASM_REWRITE_TAC [])
    let version2 ← prove
     r"!f:real^N->real^1 g:real^N->real^N h g' h' s t b.
          (!x. x IN s ==> g(x) IN t /\ h(g x) = x) /\
          (!y. y IN t ==> h(y) IN s /\ g(h y) = y) /\
          (!x. x IN s ==> (g has_derivative g' x) (at x within s)) /\
          (!y. y IN t ==> (h has_derivative h' y) (at y within t)) /\
          (!y. y IN t ==> h' y o g'(h y) = I)
          ==> ((\x. abs(det(matrix(g' x))) % f(g x))
               absolutely_integrable_on s /\
               integral s (\x. abs(det(matrix(g' x))) % f(g x)) = b <=>
               f absolutely_integrable_on t /\ integral t f = b)"
     (REPEAT STRIP_TAC THEN
