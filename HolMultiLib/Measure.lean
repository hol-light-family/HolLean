      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [BOUNDED_SUBSET_BALL, COMPACT_IMP_BOUNDED,
                       MEASURABLE_BALL, OPEN_BALL],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"t:real^(M,N)finite_sum->bool")
