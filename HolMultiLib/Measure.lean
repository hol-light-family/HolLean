/- ------------------------------------------------------------------------- -/
/- Fubini for measurability and negligibility; negligible products.        -/
/- (measure.ml 28335-28589)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDC where
  FUBINI_MEASURE_ALT : thm
  FUBINI_LEBESGUE_MEASURABLE : thm
  FUBINI_LEBESGUE_MEASURABLE_ALT : thm
  FUBINI_NEGLIGIBLE : thm
  FUBINI_NEGLIGIBLE_ALT : thm
  NEGLIGIBLE_PCROSS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDC [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSN : MSN) (BMST : MST) (BMSAM : MSAM) (BMSAN : MSAN) (BMSDB : MSDB) : ExceptT String IO MSDC := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURE, measurable, MEASURABLE_INTERVAL, measure, MEASURE_INTERVAL,
        MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_EMPTY, MEASURABLE_UNIONS, MEASURE_EQ_0,
        NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { HAS_INTEGRAL_NEGLIGIBLE_EQ_AE, MEASURE_UNIONS_LE_IMAGE, NEGLIGIBLE_OUTER_LE,
        .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. } := BMSF
  let { MEASURE_ELEMENTARY, .. } := BMSG
  let { MEASURABLE_OUTER_CLOSED_INTERVALS, .. } := BMSN
  let { HAS_MEASURE_ISOMETRY, .. } := BMST
  let { LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS,
        LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS, .. } := BMSAM
  let { NEGLIGIBLE_LINEAR_IMAGE_GEN, .. } := BMSAN
  let { FUBINI_MEASURE, .. } := BMSDB
  let { CONTENT_PASTECART, CONTENT_POS_LE, .. } := D.qintegration1
  let { division_of, NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_EMPTY,
        NEGLIGIBLE_ON_COUNTABLE_INTERVALS, NEGLIGIBLE_ON_INTERVALS, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { PCROSS_UNIONS, .. } := D.qsession
  let { LINEAR_PASTECART, SQNORM_PASTECART, .. } := D.qvec
  let { PCROSS_INTERVAL, .. } := D.ig.qtopology
  let { INTER_PCROSS, SUBSET_UNIONS, .. } := D.ig.dv.dg.qsession
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { ADD_SYM, COND_RAND, CONJ_ASSOC, CONJ_SYM, DIMINDEX_1, DIMINDEX_FINITE_SUM,
        EMPTY_GSPEC, EQ_IMP, EQ_TRANS, EXISTS_PASTECART, EXTENSION, FINITE_IMAGE,
        FORALL_FINITE_SUBSET_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, IN_DIFF, INTER, INTER_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, IN_UNIV, LE_REFL, LEFT_AND_EXISTS_THM,
        NOT_FORALL_THM, PASTECART_IN_PCROSS, PASTECART_INJ, REAL_ADD_AC, REAL_ADD_LID,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_RDIV_EQ, REAL_LE_TRANS, REAL_LT_DIV,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SNDCART_PASTECART,
        SUBSET, SUBSET_PCROSS, SUBSET_REFL, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUM_EQ, SUM_LMUL, SUM_POS_LE, SUM_RMUL, UNIONS_GSPEC, UNWIND_THM1, UNWIND_THM2,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DROP_EQ, DROP_VEC, FORALL_1, FSTCART_ADD, FSTCART_CMUL, LIFT_DROP, LIFT_NUM,
        LINEAR_FSTCART, LINEAR_SNDCART, NORM_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POW_2, PASTECART_ADD, PASTECART_CMUL, SNDCART_ADD, SNDCART_CMUL,
        .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, linear, .. } := D.ig.dv.dg.pt.cvx.vec4
  -- @@SCOPE END

  let FUBINI_MEASURE_ALT ← prove
   r"!s:real^(M,N)finite_sum->bool.
        measurable s
        ==> negligible {y | ~measurable {x | pastecart x y IN s}} /\
            ((\y. lift(measure {x | pastecart x y IN s}))
             has_integral lift(measure s)) UNIV"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\z. pastecart (sndcart z) (fstcart z))
                        (s:real^(M,N)finite_sum->bool)")
          FUBINI_MEASURE) THEN
    MP_TAC (← ISPEC
     (← q r"\z:real^(M,N)finite_sum. pastecart (sndcart z) (fstcart z)")
     HAS_MEASURE_ISOMETRY) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_SYM] THEN
      SIMP_TAC [LINEAR_PASTECART, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      SIMP_TAC [FORALL_PASTECART, NORM_EQ, ← GSYM NORM_POW_2, SQNORM_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, REAL_ADD_AC],
      DISCH_TAC THEN ASM_REWRITE_TAC [measurable, measure] THEN
      ASM_REWRITE_TAC [← GSYM measurable, ← GSYM measure] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART,
                   SNDCART_PASTECART, PASTECART_INJ] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, UNWIND_THM1]])

  let FUBINI_LEBESGUE_MEASURABLE ← (do
    let lemma ← prove
     r"{x | ?n. P n x} = UNIONS {{x | P n x} | n IN (:num)}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!s:real^(M,N)finite_sum->bool.
          lebesgue_measurable s
          ==> negligible {x | ~lebesgue_measurable {y | pastecart x y IN s}}"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [NEGLIGIBLE_ON_COUNTABLE_INTERVALS] THEN
      X_GEN_TAC (← q r"m:num") THEN
      REWRITE_TAC [LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS] THEN
      REWRITE_TAC [INTER, IN_ELIM_THM, NOT_FORALL_THM, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [lemma] THEN MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
      X_GEN_TAC (← q r"n:num") THEN
      MP_TAC (← ISPEC (← q r"(s:real^(M,N)finite_sum->bool) INTER
                    (interval[--vec m,vec m] PCROSS interval[--vec n,vec n])")
            FUBINI_MEASURE) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [PCROSS_INTERVAL] THEN
        ASM_MESON_TAC [LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS],
        DISCH_THEN (MP_TAC o CONJUNCT1)] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [IN_INTER, PASTECART_IN_PCROSS] THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN interval[--vec m,vec m]") THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, MEASURABLE_EMPTY]))

  let FUBINI_LEBESGUE_MEASURABLE_ALT ← (do
    let lemma ← prove
     r"{x | ?n. P n x} = UNIONS {{x | P n x} | n IN (:num)}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!s:real^(M,N)finite_sum->bool.
          lebesgue_measurable s
          ==> negligible {y | ~lebesgue_measurable {x | pastecart x y IN s}}"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [NEGLIGIBLE_ON_COUNTABLE_INTERVALS] THEN
      X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [LEBESGUE_MEASURABLE_MEASURABLE_ON_COUNTABLE_SUBINTERVALS] THEN
      REWRITE_TAC [INTER, IN_ELIM_THM, NOT_FORALL_THM, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [lemma] THEN MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
      X_GEN_TAC (← q r"m:num") THEN
      MP_TAC (← ISPEC (← q r"(s:real^(M,N)finite_sum->bool) INTER
                    (interval[--vec m,vec m] PCROSS interval[--vec n,vec n])")
            FUBINI_MEASURE_ALT) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [PCROSS_INTERVAL] THEN
        ASM_MESON_TAC [LEBESGUE_MEASURABLE_MEASURABLE_ON_SUBINTERVALS],
        DISCH_THEN (MP_TAC o CONJUNCT1)] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"y:real^N") THEN
      REWRITE_TAC [IN_INTER, PASTECART_IN_PCROSS] THEN
      ASM_CASES_TAC (← q r"(y:real^N) IN interval[--vec n,vec n]") THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, MEASURABLE_EMPTY]))

  let FUBINI_NEGLIGIBLE ← prove
   r"!s. negligible s
       ==> negligible
            {x:real^M | ~negligible {y:real^N | pastecart x y IN s}}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_MEASURE o MATCH_MP
      NEGLIGIBLE_IMP_MEASURABLE) THEN
    ASM_SIMP_TAC [MEASURE_EQ_0, LIFT_NUM, IMP_CONJ] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x:real^M. lift (measure {y:real^N | pastecart x y IN s})",
      ← q r"(:real^M)",
      ← q r"{x:real^M | ~measurable {y:real^N | pastecart x y IN s}}"]
     HAS_INTEGRAL_NEGLIGIBLE_EQ_AE) THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_DIFF, IN_ELIM_THM] THEN
    SIMP_TAC [IMP_IMP, FORALL_1, DIMINDEX_1, ← GSYM drop, LIFT_DROP, IN_UNIV] THEN
    ASM_SIMP_TAC [MEASURE_POS_LE, IMP_CONJ] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    UNDISCH_TAC
     (← q r"negligible {x:real^M | ~measurable {y:real^N | pastecart x y IN s}}") THEN
    REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, ← GSYM DROP_EQ] THEN
    REWRITE_TAC [LIFT_DROP, DROP_VEC] THEN
    REWRITE_TAC [HAS_MEASURE_MEASURE, ← GSYM HAS_MEASURE_0] THEN
    SET_TAC [])

  let FUBINI_NEGLIGIBLE_ALT ← (do
    let lemma ← prove
     r"!s:real^(M,N)finite_sum->bool.
          negligible s
           ==> negligible (IMAGE (\z. pastecart (sndcart z) (fstcart z)) s)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LINEAR_IMAGE_GEN THEN
      ASM_REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_SYM, LE_REFL] THEN
      REWRITE_TAC [linear, FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART,
                   FSTCART_ADD, SNDCART_ADD, FSTCART_CMUL, SNDCART_CMUL,
                   ← GSYM PASTECART_ADD, ← GSYM PASTECART_CMUL])
    prove
     r"!s. negligible s
         ==> negligible
              {y:real^N | ~negligible {x:real^M | pastecart x y IN s}}"
     (GEN_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP lemma) THEN
      DISCH_THEN (MP_TAC o MATCH_MP FUBINI_NEGLIGIBLE) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, PASTECART_INJ,
                   FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [UNWIND_THM1, UNWIND_THM2]))

  let NEGLIGIBLE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        negligible(s PCROSS t) <=> negligible s \/ negligible t"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_NEGLIGIBLE) THEN
      REWRITE_TAC [PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [← SET_RULE (← q r"{y | P /\ Q y} = if P then {y | Q y} else {}")] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN REWRITE_TAC [NEGLIGIBLE_EMPTY] THEN
      ASM_CASES_TAC (← q r"negligible(t:real^N->bool)") THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"~(if P then F else T) = P"),
                       ← SET_RULE (← q r"{x | x IN s} = s")],
      ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
      REWRITE_TAC [FORALL_PASTECART, ← GSYM PCROSS_INTERVAL, INTER_PCROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"aa:real^M", ← q r"a:real^N", ← q r"bb:real^M", ← q r"b:real^N"] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"(s:real^M->bool) PCROSS interval[a:real^N,b]") THEN
      REWRITE_TAC [SUBSET_PCROSS, INTER_SUBSET] THEN
      REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN MP_TAC (← ISPECL
       [← q r"s:real^M->bool", ← q r"e / (content(interval[a:real^N,b]) + &1)"]
       MEASURABLE_OUTER_CLOSED_INTERVALS) THEN
      ASM_SIMP_TAC [NEGLIGIBLE_IMP_MEASURABLE, REAL_LT_DIV, CONTENT_POS_LE,
        MEASURE_EQ_0, REAL_ADD_LID, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS { (k:real^M->bool) PCROSS interval[a:real^N,b] |
                           k IN d}") THEN
      ASM_REWRITE_TAC [← GSYM PCROSS_UNIONS, SUBSET_PCROSS, SUBSET_REFL] THEN
      REWRITE_TAC [PCROSS_UNIONS] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_INTERVAL, PCROSS_INTERVAL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"D:(real^M->bool)->bool") THEN STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_UNIONS_LE_IMAGE o
        lhand o snd) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_INTERVAL, PCROSS_INTERVAL, SUBSET],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum D (\k:real^M->bool. measure k * content(interval[a:real^N,b]))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC SUM_EQ THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET], ASM_REWRITE_TAC []] THEN
        ASM_REWRITE_TAC [PCROSS_INTERVAL, MEASURE_INTERVAL, CONTENT_PASTECART],
        REWRITE_TAC [SUM_RMUL]] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 <= x /\ x * (y + &1) <= e ==> x * y <= e")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_POS_LE THEN
        ASM_MESON_TAC [MEASURE_POS_LE, SUBSET, MEASURABLE_INTERVAL],
        SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1"),
                  CONTENT_POS_LE]] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)) THEN
      TRANS_TAC REAL_LE_TRANS (← q r"measure(UNIONS D:real^M->bool)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE,
        MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [SUBSET_UNIONS] THEN
        ASM_MESON_TAC [MEASURABLE_UNIONS, MEASURABLE_INTERVAL, SUBSET]] THEN
      TRANS_TAC EQ_TRANS (← q r"sum (D:(real^M->bool)->bool) content") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [MEASURE_INTERVAL, SUBSET],
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC MEASURE_ELEMENTARY THEN
        REWRITE_TAC [division_of] THEN ASM SET_TAC []],
      ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
      REWRITE_TAC [FORALL_PASTECART, ← GSYM PCROSS_INTERVAL, INTER_PCROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"aa:real^N", ← q r"b:real^M", ← q r"bb:real^N"] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"interval[a:real^M,b] PCROSS (t:real^N->bool)") THEN
      REWRITE_TAC [SUBSET_PCROSS, INTER_SUBSET] THEN
      REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN MP_TAC (← ISPECL
       [← q r"t:real^N->bool", ← q r"e / (content(interval[a:real^M,b]) + &1)"]
       MEASURABLE_OUTER_CLOSED_INTERVALS) THEN
      ASM_SIMP_TAC [NEGLIGIBLE_IMP_MEASURABLE, REAL_LT_DIV, CONTENT_POS_LE,
        MEASURE_EQ_0, REAL_ADD_LID, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS { interval[a:real^M,b] PCROSS (k:real^N->bool) |
                           k IN d}") THEN
      ASM_REWRITE_TAC [← GSYM PCROSS_UNIONS, SUBSET_PCROSS, SUBSET_REFL] THEN
      REWRITE_TAC [PCROSS_UNIONS] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_INTERVAL, PCROSS_INTERVAL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"D:(real^N->bool)->bool") THEN STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_UNIONS_LE_IMAGE o
        lhand o snd) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_INTERVAL, PCROSS_INTERVAL, SUBSET],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum D (\k:real^N->bool. content(interval[a:real^M,b]) * measure k)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC SUM_EQ THEN
        X_GEN_TAC (← q r"k:real^N->bool") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?u v:real^N. k = interval[u,v]") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET], ASM_REWRITE_TAC []] THEN
        ASM_REWRITE_TAC [PCROSS_INTERVAL, MEASURE_INTERVAL, CONTENT_PASTECART],
        REWRITE_TAC [SUM_LMUL]] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 <= x /\ x * (y + &1) <= e ==> y * x <= e")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_POS_LE THEN
        ASM_MESON_TAC [MEASURE_POS_LE, SUBSET, MEASURABLE_INTERVAL],
        SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 <= x ==> &0 < x + &1"),
                  CONTENT_POS_LE]] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)) THEN
      TRANS_TAC REAL_LE_TRANS (← q r"measure(UNIONS D:real^N->bool)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE,
        MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [SUBSET_UNIONS] THEN
        ASM_MESON_TAC [MEASURABLE_UNIONS, MEASURABLE_INTERVAL, SUBSET]] THEN
      TRANS_TAC EQ_TRANS (← q r"sum (D:(real^N->bool)->bool) content") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [MEASURE_INTERVAL, SUBSET],
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC MEASURE_ELEMENTARY THEN
        REWRITE_TAC [division_of] THEN ASM SET_TAC []]])

  pure { FUBINI_MEASURE_ALT, FUBINI_LEBESGUE_MEASURABLE, FUBINI_LEBESGUE_MEASURABLE_ALT,
         FUBINI_NEGLIGIBLE, FUBINI_NEGLIGIBLE_ALT, NEGLIGIBLE_PCROSS }

/- ------------------------------------------------------------------------- -/
/- Fubini-Tonelli for measure; measurability of products.                  -/
/- (measure.ml 28590-28852)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDD where
  FUBINI_TONELLI_MEASURE : thm
  FUBINI_TONELLI_MEASURE_ALT : thm
  FUBINI_TONELLI_NEGLIGIBLE : thm
  FUBINI_TONELLI_NEGLIGIBLE_ALT : thm
  LEBESGUE_MEASURABLE_PCROSS : thm
  MEASURABLE_PCROSS : thm
  HAS_MEASURE_PCROSS : thm
  MEASURE_PCROSS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDD [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSJ : MSJ) (BMST : MST) (BMSAB : MSAB) (BMSAM : MSAM) (BMSAS : MSAS) (BMSBB : MSBB) (BMSDB : MSDB) (BMSDC : MSDC) : ExceptT String IO MSDD := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE, HAS_MEASURE_MEASURABLE_MEASURE, measurable, measure, MEASURE_SUBSET,
        .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_EMPTY, MEASURE_EMPTY, MEASURE_EQ_0,
        NEGLIGIBLE_EQ_MEASURE_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { INTEGRABLE_ON_CONST, .. } := BMSC
  let { MEASURABLE_NESTED_UNIONS, .. } := BMSF
  let { MEASURABLE_BALL, .. } := BMSJ
  let { HAS_MEASURE_ISOMETRY, .. } := BMST
  let { lebesgue_measurable, measurable_on, .. } := BMSAB
  let { MEASURABLE_IMP_LEBESGUE_MEASURABLE, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE,
        .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE, .. } := BMSAS
  let { LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, .. } := BMSBB
  let { FUBINI_MEASURE, .. } := BMSDB
  let { FUBINI_NEGLIGIBLE, FUBINI_NEGLIGIBLE_ALT, NEGLIGIBLE_PCROSS, .. } := BMSDC
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_CMUL, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_UNIQUE, INTEGRABLE_0,
        INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SPIKE, .. } := D.qintegration2
  let { integrable_on, INTEGRAL_DROP_LE_AE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { REAL_ARCH_LT, .. } := D.qsession
  let { LINEAR_PASTECART, SQNORM_PASTECART, .. } := D.qvec
  let { indicator, LIFT_EQ_CMUL, .. } := D.ig.qvec
  let { CONTINUOUS_ON_PASTECART, .. } := D.ig.dv.dg.qtopology1
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_RAT_REDUCE_CONV, SET_RULE,
        SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { SUBSET_BALL, .. } := D.ig.dv.dg.pt.qtop
  let { ADD_SYM, COND_RAND, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_FINITE_SUM,
        EQ_IMP, EXISTS_PASTECART, EXTENSION, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, IN_UNIV, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, PASTECART_IN_PCROSS, PASTECART_INJ,
        REAL_ADD_AC, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_SYM, REAL_OF_NUM_SUC, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM,
        RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUBSET_UNIV, UNIONS_GSPEC, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM,
        LINEAR_FSTCART, LINEAR_SNDCART, NORM_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POW_2, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL_0, LIM_MUL, LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let FUBINI_TONELLI_MEASURE ← prove
   r"!s:real^(M,N)finite_sum->bool.
        lebesgue_measurable s
        ==> (measurable s <=>
             negligible {x | ~measurable {y | pastecart x y IN s}} /\
             (\x. lift(measure {y | pastecart x y IN s})) integrable_on UNIV)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [FUBINI_MEASURE, integrable_on], STRIP_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\n. s INTER ball(vec 0:real^(M,N)finite_sum,&n)",
      ← q r"drop(integral (:real^M)
         (\x. lift (measure {y:real^N | pastecart x y IN s})))"]
         MEASURABLE_NESTED_UNIONS) THEN
    ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                  MEASURABLE_BALL, ← GSYM REAL_OF_NUM_SUC, SUBSET_BALL,
                  ← REAL_ARITH (← q r"x <= x + &1"),
                  ← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")] THEN
    ANTS_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      MP_TAC (← SPEC (← q r"s INTER ball(vec 0:real^(M,N)finite_sum,&n)")
          FUBINI_MEASURE) THEN
      ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                    MEASURABLE_BALL, HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
      REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC INTEGRAL_DROP_LE_AE THEN
      ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"{x:real^M | ~measurable {y:real^N | pastecart x y IN s}} UNION
                  {x:real^M | ~measurable {y:real^N | pastecart x y IN s INTER
                                                      ball (vec 0,&n)}}") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, IN_DIFF, IN_UNIV, DE_MORGAN_THM,
                       IN_UNION, IN_ELIM_THM, LIFT_DROP] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_INTER, IN_BALL_0, IN_UNIV] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN MESON_TAC [REAL_ARCH_LT]])

  let FUBINI_TONELLI_MEASURE_ALT ← prove
   r"!s:real^(M,N)finite_sum->bool.
        lebesgue_measurable s
        ==> (measurable s <=>
             negligible {y | ~measurable {x | pastecart x y IN s}} /\
             (\y. lift(measure {x | pastecart x y IN s})) integrable_on UNIV)"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\z. pastecart (sndcart z) (fstcart z))
                        (s:real^(M,N)finite_sum->bool)")
          FUBINI_TONELLI_MEASURE) THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, LINEAR_PASTECART,
                  LINEAR_FSTCART, LINEAR_SNDCART, DIMINDEX_FINITE_SUM,
                  ← ARITH_RULE (← q r"m + n:num <= n + m")] THEN
    MP_TAC (← ISPEC
     (← q r"\z:real^(M,N)finite_sum. pastecart (sndcart z) (fstcart z)")
     HAS_MEASURE_ISOMETRY) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_SYM] THEN
      SIMP_TAC [LINEAR_PASTECART, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      SIMP_TAC [FORALL_PASTECART, NORM_EQ, ← GSYM NORM_POW_2, SQNORM_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, REAL_ADD_AC],
      DISCH_TAC THEN ASM_REWRITE_TAC [measurable, measure] THEN
      ASM_REWRITE_TAC [← GSYM measurable, ← GSYM measure] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART,
                   SNDCART_PASTECART, PASTECART_INJ] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, UNWIND_THM1]])

  let FUBINI_TONELLI_NEGLIGIBLE ← prove
   r"!s:real^(M,N)finite_sum->bool.
        lebesgue_measurable s
        ==> (negligible s <=>
             negligible {x | ~negligible {y | pastecart x y IN s}})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [FUBINI_NEGLIGIBLE] THEN DISCH_TAC THEN
    REWRITE_TAC [NEGLIGIBLE_EQ_MEASURE_0] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [FUBINI_TONELLI_MEASURE] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, CONTRAPOS_THM,
                     NEGLIGIBLE_IMP_MEASURABLE],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE)],
      DISCH_TAC THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP FUBINI_MEASURE) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HAS_INTEGRAL_UNIQUE)) THEN
      MATCH_MP_TAC HAS_INTEGRAL_SPIKE] THEN
    EXISTS_TAC (← q r"(\x. vec 0):real^M->real^1") THEN
    EXISTS_TAC
     (← q r"{x:real^M | ~negligible {y:real^N | pastecart x y IN s}}") THEN
     ASM_REWRITE_TAC [INTEGRABLE_0, IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN
    SIMP_TAC [MEASURE_EQ_0, ← GSYM DROP_EQ, DROP_VEC, LIFT_DROP, HAS_INTEGRAL_0])

  let FUBINI_TONELLI_NEGLIGIBLE_ALT ← prove
   r"!s:real^(M,N)finite_sum->bool.
        lebesgue_measurable s
        ==> (negligible s <=>
             negligible {y | ~negligible {x | pastecart x y IN s}})"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\z. pastecart (sndcart z) (fstcart z))
                        (s:real^(M,N)finite_sum->bool)")
          FUBINI_TONELLI_NEGLIGIBLE) THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, LINEAR_PASTECART,
                  LINEAR_FSTCART, LINEAR_SNDCART, DIMINDEX_FINITE_SUM,
                  ← ARITH_RULE (← q r"m + n:num <= n + m")] THEN
    MP_TAC (← ISPEC
     (← q r"\z:real^(M,N)finite_sum. pastecart (sndcart z) (fstcart z)")
     HAS_MEASURE_ISOMETRY) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_SYM] THEN
      SIMP_TAC [LINEAR_PASTECART, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      SIMP_TAC [FORALL_PASTECART, NORM_EQ, ← GSYM NORM_POW_2, SQNORM_PASTECART] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, REAL_ADD_AC],
      DISCH_TAC THEN ASM_REWRITE_TAC [HAS_MEASURE_0] THEN
      ASM_REWRITE_TAC [← GSYM HAS_MEASURE_0] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART,
                   SNDCART_PASTECART, PASTECART_INJ] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM, UNWIND_THM1]])

  let LEBESGUE_MEASURABLE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        lebesgue_measurable(s PCROSS t) <=>
        negligible s \/ negligible t \/
        (lebesgue_measurable s /\ lebesgue_measurable t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"negligible(s:real^M->bool)") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_PCROSS, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
      ASM_REWRITE_TAC []] THEN
    ASM_CASES_TAC (← q r"negligible(t:real^N->bool)") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_PCROSS, NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE],
      ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [lebesgue_measurable, measurable_on, IN_UNIV] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC
       [← q r"k:real^(M,N)finite_sum->bool",
        ← q r"g:num->real^(M,N)finite_sum->real^1"] THEN
      STRIP_TAC THEN FIRST_ASSUM (fun th => tactic_of do
        pure (ASSUME_TAC (← MATCH_MP FUBINI_NEGLIGIBLE th) THEN
        ASSUME_TAC (← MATCH_MP FUBINI_NEGLIGIBLE_ALT th))) THEN
      SUBGOAL_THEN
       (← q r"~(s SUBSET {x:real^M | ~negligible {y:real^N | pastecart x y IN k}})")
      MP_TAC THENL [ASM_MESON_TAC [NEGLIGIBLE_SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(t SUBSET {y:real^N | ~negligible {x:real^M | pastecart x y IN k}})")
      MP_TAC THENL [ASM_MESON_TAC [NEGLIGIBLE_SUBSET], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, NOT_FORALL_THM, NOT_IMP, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^M") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{x:real^M | pastecart x (y:real^N) IN k}") THEN
      EXISTS_TAC (← q r"\n x. (g:num->real^(M,N)finite_sum->real^1)
                        n (pastecart x y)") THEN
      EXISTS_TAC (← q r"{y:real^N | pastecart (x:real^M) y IN k}") THEN
      EXISTS_TAC (← q r"\n y. (g:num->real^(M,N)finite_sum->real^1)
                        n (pastecart x y)") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THEN
      (CONJ_TAC THENL
        [GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
         MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
         SIMP_TAC [CONTINUOUS_ON_PASTECART,
                   CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
         ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
         ALL_TAC])
      THENL
       [X_GEN_TAC (← q r"u:real^M") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"pastecart (u:real^M) (y:real^N)")),
        X_GEN_TAC (← q r"v:real^N") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"pastecart (x:real^M) (v:real^N)"))] THEN
      ASM_REWRITE_TAC [indicator, PASTECART_IN_PCROSS],
      MAP_EVERY X_GEN_TAC
       [← q r"u:real^M->bool", ← q r"f:num->real^M->real^1",
        ← q r"v:real^N->bool", ← q r"g:num->real^N->real^1"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"u PCROSS (:real^N) UNION (:real^M) PCROSS v") THEN
      EXISTS_TAC (← q r"\n:num z:real^(M,N)finite_sum.
        lift(drop(f n (fstcart z)) * drop(g n (sndcart z)))") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_PCROSS] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN REWRITE_TAC [LIFT_CMUL] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [o_DEF, LIFT_DROP] THEN
        CONJ_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
        REWRITE_TAC [FORALL_PASTECART, IN_UNION, PASTECART_IN_PCROSS] THEN
        REWRITE_TAC [IN_UNIV, DE_MORGAN_THM, LIFT_CMUL, LIFT_DROP] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN STRIP_TAC THEN
        REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
        SUBGOAL_THEN (← q r"indicator (s PCROSS t) (pastecart x y) =
                      drop(indicator s (x:real^M)) % indicator t (y:real^N)")
        SUBST1_TAC THENL
         [REWRITE_TAC [indicator, PASTECART_IN_PCROSS] THEN
          MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(y:real^N) IN t"] THEN
          ASM_REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV,
          MATCH_MP_TAC LIM_MUL THEN REWRITE_TAC [o_DEF, LIFT_DROP] THEN
          ASM_SIMP_TAC []]]])

  let MEASURABLE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        measurable(s PCROSS t) <=>
        negligible s \/ negligible t \/ (measurable s /\ measurable t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"negligible(s:real^M->bool)") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_PCROSS, NEGLIGIBLE_IMP_MEASURABLE],
      ASM_REWRITE_TAC []] THEN
    ASM_CASES_TAC (← q r"negligible(t:real^N->bool)") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_PCROSS, NEGLIGIBLE_IMP_MEASURABLE],
      ASM_REWRITE_TAC []] THEN
    ASM_CASES_TAC
     (← q r"lebesgue_measurable((s:real^M->bool) PCROSS (t:real^N->bool))")
    THENL
     [ASM_SIMP_TAC [FUBINI_TONELLI_MEASURE, PASTECART_IN_PCROSS],
      ASM_MESON_TAC [LEBESGUE_MEASURABLE_PCROSS,
      MEASURABLE_IMP_LEBESGUE_MEASURABLE]] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P /\ x IN s} = if P then s else {}")] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [MEASURABLE_EMPTY, MEASURE_EMPTY] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [LIFT_NUM, INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_ON_CONST] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | if x IN s then P else F} = if P then s else {}")] THEN
    ASM_CASES_TAC (← q r"measurable(s:real^M->bool)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"measurable(t:real^N->bool)") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_EMPTY] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN
    ASM_MESON_TAC [NEGLIGIBLE_EQ_MEASURE_0])

  let HAS_MEASURE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool a b.
        s has_measure a /\ t has_measure b
        ==> (s PCROSS t) has_measure (a * b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(s:real^M->bool) PCROSS (t:real^N->bool)")
          FUBINI_MEASURE) THEN
    REWRITE_TAC [MEASURABLE_PCROSS, PASTECART_IN_PCROSS] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [measurable], ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"{y | P /\ y IN s} = if P then s else {}")] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [MEASURABLE_EMPTY, MEASURE_EMPTY] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [LIFT_NUM, INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_ON_CONST] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | if x IN s then P else F} = if P then s else {}")] THEN
    REWRITE_TAC [HAS_INTEGRAL_RESTRICT_UNIV] THEN STRIP_TAC THEN
    REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_PCROSS] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [measurable], ALL_TAC] THEN
    REWRITE_TAC [← GSYM LIFT_EQ] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HAS_INTEGRAL_UNIQUE)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_MEASURE_MEASURABLE_MEASURE]) THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIFT_CMUL] THEN
    ASM_REWRITE_TAC [LIFT_EQ_CMUL] THEN MATCH_MP_TAC HAS_INTEGRAL_CMUL THEN
    REWRITE_TAC [← GSYM LIFT_EQ_CMUL] THEN
    ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    ASM_REWRITE_TAC [← GSYM HAS_MEASURE, HAS_MEASURE_MEASURABLE_MEASURE])

  let MEASURE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        measurable s /\ measurable t
        ==> measure(s PCROSS t) = measure s * measure t"
   (MESON_TAC [HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_PCROSS])

  pure { FUBINI_TONELLI_MEASURE, FUBINI_TONELLI_MEASURE_ALT, FUBINI_TONELLI_NEGLIGIBLE,
         FUBINI_TONELLI_NEGLIGIBLE_ALT, LEBESGUE_MEASURABLE_PCROSS, MEASURABLE_PCROSS,
         HAS_MEASURE_PCROSS, MEASURE_PCROSS }
/- ------------------------------------------------------------------------- -/
/- Measurability of a function and of its ordinate set.                    -/
/- (measure.ml 28853-29060)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDE where
  LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE : thm
  LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT : thm
  LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE_EQ : thm
  LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LE_EQ : thm
  LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT_EQ : thm
  LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LT_EQ : thm
  NEGLIGIBLE_MEASURABLE_FUNCTION_GRAPH : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDE [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMSAC : MSAC) (BMSAM : MSAM) (BMSAN : MSAN) (BMSAP : MSAP) (BMSAT : MSAT) (BMSAV : MSAV) (BMSDC : MSDC) (BMSDD : MSDD) : ExceptT String IO MSDE := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_EMPTY_INTERIOR, .. } := BMSC
  let { MEASURABLE_ON_COMPOSE_CONTINUOUS, .. } := BMSAC
  let { LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_INTERS,
        LEBESGUE_MEASURABLE_DIFF, LEBESGUE_MEASURABLE_INTERS, LEBESGUE_MEASURABLE_OPEN,
        LEBESGUE_MEASURABLE_UNION, LEBESGUE_MEASURABLE_UNIV, .. } := BMSAM
  let { LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ, .. } := BMSAN
  let { LEBESGUE_MEASURABLE_PREIMAGE_CLOSED, .. } := BMSAP
  let { NEGLIGIBLE_DISJOINT_TRANSLATES, .. } := BMSAT
  let { MEASURABLE_ON_PREIMAGE_ORTHANT_GE_DENSE, MEASURABLE_ON_PREIMAGE_ORTHANT_GT_DENSE,
        .. } := BMSAV
  let { FUBINI_LEBESGUE_MEASURABLE_ALT, .. } := BMSDC
  let { LEBESGUE_MEASURABLE_PCROSS, .. } := BMSDD
  let { RATIONAL_BETWEEN, .. } := D.qfloor
  let { CONNECTED_SING, .. } := D.qtopology1
  let { INTERIOR_COMPLEMENT, .. } := D.qtopology2
  let { COUNTABLE_RATIONAL, .. } := D.ig.qmisc
  let { CONNECTED_PCROSS_EQ, .. } := D.ig.dv.qtopology1
  let { CONNECTED_UNIV, .. } := D.ig.dv.dg.qtopology1
  let { MESON_TAC, REAL_ARITH, SET_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { PASTECART_EQ, .. } := D.ig.dv.dg.pt.qses
  let { VEC_EQ, .. } := D.ig.dv.dg.pt.qvec
  let { AND_FORALL_THM, ARITH_EQ, CART_EQ, CONTRAPOS_THM, EQ_IMP, ETA_AX, EXTENSION,
        FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, IN, IN_DIFF,
        IN_ELIM_PASTECART_THM, INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_SING, IN_UNIV, NOT_FORALL_THM, NOT_IMP,
        PASTECART_IN_PCROSS, PASTECART_INJ, PCROSS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LET_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NEG_NEG, REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE,
        SNDCART_PASTECART, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, real_ge, real_gt, SURJECTIVE_IMAGE_EQ,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { FSTCART_ADD, FSTCART_CMUL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { PASTECART_ADD, PASTECART_VEC, SNDCART_ADD, SNDCART_CMUL,
        .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, linear, VECTOR_ADD_LID, VECTOR_EQ_NEG2, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSED_HALFSPACE_COMPONENT_GE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONNECTED_IMP_PERFECT, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_NEG, .. } := D.ig.dv.dg.pt.cvx.top3
  let { OPEN_HALFSPACE_COMPONENT_LT, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE ← (do
    let lemma ← prove
     r"!x y. x <= y <=> !q. rational q /\ y < q ==> x < q"
     (REPEAT GEN_TAC THEN EQ_TAC THENL [MESON_TAC [REAL_LET_TRANS], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [REAL_NOT_LE, NOT_FORALL_THM, NOT_IMP, REAL_NOT_LT] THEN
      MESON_TAC [RATIONAL_BETWEEN, REAL_LT_IMP_LE])
    prove
     r"!f:real^M->real^N k.
          f measurable_on (:real^M)
          ==> lebesgue_measurable {pastecart x (y:real^N) | y$k <= (f x)$k}"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{pastecart (x:real^M) (y:real^N) | y$k <= (f x:real^N)$k} =
        INTERS {{pastecart x y | (f x)$k < q ==> y$k < q} | q IN rational}")
      SUBST1_TAC THENL
       [REWRITE_TAC [INTERS_GSPEC, EXTENSION, FORALL_PASTECART] THEN
        REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN
        ONCE_REWRITE_TAC [IN_ELIM_THM] THEN
        REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN MESON_TAC [lemma, IN],
        ALL_TAC] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_RATIONAL] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN ONCE_REWRITE_TAC [← SET_RULE
       (← q r"{f x y | P x y ==> Q x y} = {f x y | Q x y} UNION {f x y | ~(P x y)}")] THEN
      X_GEN_TAC (← q r"q:real") THEN REWRITE_TAC [IN] THEN DISCH_TAC THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN
      REWRITE_TAC [REAL_NOT_LT, ← GSYM PCROSS, LEBESGUE_MEASURABLE_PCROSS,
       ← SET_RULE (← q r"{f x y |x,y| P x} = {f x y | x IN {x | P x} /\ y IN UNIV}"),
       ← SET_RULE (← q r"{f x y |x,y| Q y} = {f x y | x IN UNIV /\ y IN {x | Q x}}")] THEN
      CONJ_TAC THEN REPEAT DISJ2_TAC THEN
      REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV] THENL
       [MATCH_MP_TAC LEBESGUE_MEASURABLE_OPEN THEN
        REWRITE_TAC [drop, OPEN_HALFSPACE_COMPONENT_LT],
        ONCE_REWRITE_TAC [← SET_RULE
         (← q r"{x | q <= (f x)$k} = {x | f x IN {y | q <= y$k}}")] THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_PREIMAGE_CLOSED THEN
        ASM_REWRITE_TAC [drop, ← GSYM real_ge, CLOSED_HALFSPACE_COMPONENT_GE]]))

  let LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT ← prove
   r"!f:real^M->real^N k.
        f measurable_on (:real^M)
        ==> lebesgue_measurable {pastecart x (y:real^N) | y$k < (f x)$k}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"f < y <=> ~(--f <= --y)")] THEN
    MP_TAC (← ISPECL [← q r"(--) o (f:real^M->real^N)", ← q r"k:num"]
      LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
      SIMP_TAC [CONTINUOUS_ON_NEG, CONTINUOUS_ON_ID],
      ALL_TAC] THEN
    MP_TAC (← ISPEC
     (← q r"\z:real^(M,N)finite_sum. pastecart (fstcart z) (--sndcart z)")
     LEBESGUE_MEASURABLE_LINEAR_IMAGE_EQ) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, PASTECART_INJ, VECTOR_EQ_NEG2,
                 ← GSYM PASTECART_EQ] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [linear, PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART,
                   FSTCART_ADD, FSTCART_CMUL, SNDCART_ADD, SNDCART_CMUL] THEN
      VECTOR_ARITH_TAC,
      DISCH_THEN (fun th => tactic_of do
        pure (GEN_REWRITE_TAC LAND_CONV [← GSYM th]))] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM LEBESGUE_MEASURABLE_COMPL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF s = t <=> s = UNIV DIFF t")] THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_PASTECART_THM, o_DEF,
                 FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [VECTOR_NEG_COMPONENT, REAL_NEG_NEG] THEN
    MESON_TAC [FSTCART_PASTECART, SNDCART_PASTECART, VECTOR_NEG_NEG])

  let (LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE_EQ,
       LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LE_EQ) ← CONJ_PAIR (← prove
   r"(!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !k. 1 <= k /\ k <= dimindex(:N)
            ==> lebesgue_measurable
                  {pastecart x (y:real^N) | y$k <= (f x)$k}) /\
     (!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        lebesgue_measurable
          {pastecart x (y:real^N) | !k. 1 <= k /\ k <= dimindex(:N)
                                        ==> y$k <= (f x)$k})"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THEN DISCH_TAC THENL
     [ASM_SIMP_TAC [LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE],
      SUBGOAL_THEN
       (← q r"{ pastecart x y |
          !k. 1 <= k /\ k <= dimindex(:N)
              ==> (y:real^N)$k <= (f:real^M->real^N) x$k } =
        INTERS {{ pastecart x y | (y:real^N)$k <= (f:real^M->real^N) x$k} |
                  k IN 1..dimindex(:N)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [INTERS_GSPEC, EXTENSION, IN_ELIM_THM, IN_NUMSEG] THEN
        REWRITE_TAC [FORALL_PASTECART, PASTECART_INJ] THEN MESON_TAC [],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_INTERS THEN
        SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
        ASM_SIMP_TAC [FORALL_IN_IMAGE, IN_NUMSEG]],
      MP_TAC (← ISPECL
       [← q r"f:real^M->real^N",
        ← q r"{y | lebesgue_measurable
                {x | !k. 1 <= k /\ k <= dimindex (:N)
                         ==> (y:real^N)$k <= (f:real^M->real^N) x$k}}"]
       MEASURABLE_ON_PREIMAGE_ORTHANT_GE_DENSE) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, real_ge] THEN DISCH_THEN MATCH_MP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_LEBESGUE_MEASURABLE_ALT) THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
      REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN
      REWRITE_TAC [← SET_RULE (← q r"s = UNIV <=> UNIV DIFF s = {}")] THEN
      REWRITE_TAC [← GSYM INTERIOR_COMPLEMENT, NEGLIGIBLE_EMPTY_INTERIOR]]))

  let (LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT_EQ,
       LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LT_EQ) ← CONJ_PAIR (← prove
   r"(!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        !k. 1 <= k /\ k <= dimindex(:N)
            ==> lebesgue_measurable
                  {pastecart x (y:real^N) | y$k < (f x)$k}) /\
     (!f:real^M->real^N.
        f measurable_on (:real^M) <=>
        lebesgue_measurable
          {pastecart x (y:real^N) | !k. 1 <= k /\ k <= dimindex(:N)
                                        ==> y$k < (f x)$k})"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THEN DISCH_TAC THENL
     [ASM_SIMP_TAC [LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT],
      SUBGOAL_THEN
       (← q r"{ pastecart x y |
          !k. 1 <= k /\ k <= dimindex(:N)
              ==> (y:real^N)$k < (f:real^M->real^N) x$k } =
        INTERS {{ pastecart x y | (y:real^N)$k < (f:real^M->real^N) x$k} |
                  k IN 1..dimindex(:N)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [INTERS_GSPEC, EXTENSION, IN_ELIM_THM, IN_NUMSEG] THEN
        REWRITE_TAC [FORALL_PASTECART, PASTECART_INJ] THEN MESON_TAC [],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_INTERS THEN
        SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
        ASM_SIMP_TAC [FORALL_IN_IMAGE, IN_NUMSEG]],
      MP_TAC (← ISPECL
       [← q r"f:real^M->real^N",
        ← q r"{y | lebesgue_measurable
                {x | !k. 1 <= k /\ k <= dimindex (:N)
                         ==> (y:real^N)$k < (f:real^M->real^N) x$k}}"]
       MEASURABLE_ON_PREIMAGE_ORTHANT_GT_DENSE) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, real_gt] THEN DISCH_THEN MATCH_MP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_LEBESGUE_MEASURABLE_ALT) THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | ~P x} = UNIV DIFF {x | P x}")] THEN
      REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN
      REWRITE_TAC [← SET_RULE (← q r"s = UNIV <=> UNIV DIFF s = {}")] THEN
      REWRITE_TAC [← GSYM INTERIOR_COMPLEMENT, NEGLIGIBLE_EMPTY_INTERIOR]]))

  let NEGLIGIBLE_MEASURABLE_FUNCTION_GRAPH ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M) ==> negligible {pastecart x y | f x = y}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_DISJOINT_TRANSLATES THEN
    EXISTS_TAC (← q r"{pastecart (vec 0:real^M) x | x IN (:real^N)}") THEN
    EXISTS_TAC (← q r"vec 0:real^(M,N)finite_sum") THEN REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"{pastecart x y | (f:real^M->real^N) x = y} =
        INTERS {{pastecart x y | y$i <= (f x)$i} DIFF
                {pastecart x y | y$i < (f x)$i} | i IN 1..dimindex(:N)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [CART_EQ, INTERS_GSPEC, EXTENSION, FORALL_PASTECART] THEN
        REWRITE_TAC [IN_ELIM_PASTECART_THM, IN_NUMSEG] THEN
        ONCE_REWRITE_TAC [IN_ELIM_THM] THEN
        REWRITE_TAC [IN_ELIM_PASTECART_THM, IN_DIFF, REAL_NOT_LT] THEN
        REWRITE_TAC [REAL_LE_ANTISYM] THEN MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_INTERS THEN
      SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, FINITE_NUMSEG] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN X_GEN_TAC (← q r"k:num") THEN
      STRIP_TAC THEN MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFF THEN
      ASM_SIMP_TAC [LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE,
                    LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT],
      MATCH_MP_TAC CONNECTED_IMP_PERFECT THEN
      REWRITE_TAC [← GSYM PCROSS, ← SET_RULE
       (← q r"{f a x | x IN s} = {f w x | w IN {a} /\ x IN s}")] THEN
      REWRITE_TAC [← GSYM PASTECART_VEC, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [CONNECTED_SING, CONNECTED_PCROSS_EQ, CONNECTED_UNIV] THEN
      REWRITE_TAC [IN_SING, IN_UNIV] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"!a b. a IN s /\ b IN s /\ ~(a = b) ==> ~(?a. s = {a})")) THEN
      EXISTS_TAC (← q r"pastecart (vec 0:real^M) (vec 0:real^N)") THEN
      EXISTS_TAC (← q r"pastecart (vec 0:real^M) (vec 1:real^N)") THEN
      REWRITE_TAC [PASTECART_IN_PCROSS, IN_SING, IN_UNIV] THEN
      REWRITE_TAC [PASTECART_INJ, VEC_EQ, ARITH_EQ],
      REWRITE_TAC [pairwise, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, PASTECART_INJ] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, PASTECART_INJ, FORALL_IN_IMAGE,
        ← SET_RULE (← q r"DISJOINT s t <=> !x. x IN s ==> !y. y IN t ==> ~(x = y)")] THEN
      REWRITE_TAC [PASTECART_ADD, VECTOR_ADD_LID, PASTECART_INJ] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x':real^M", ← q r"y':real^N"] THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM)) THEN
      ASM_CASES_TAC (← q r"x':real^M = x") THEN ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"~(a:real^N = b)") THEN REWRITE_TAC [CONTRAPOS_THM] THEN
      CONV_TAC (fun t => VECTOR_ARITH t)])

  pure { LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE,
         LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT,
         LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE_EQ,
         LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LE_EQ,
         LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LT_EQ,
         LEBESGUE_MEASURABLE_FUNCTION_ORTHANT_SET_LT_EQ,
         NEGLIGIBLE_MEASURABLE_FUNCTION_GRAPH }
/- ------------------------------------------------------------------------- -/
/- Integrals and "area under curve"; miscellaneous composition lemmas.     -/
/- (measure.ml 29061-29214)                                                 -/
/- ------------------------------------------------------------------------- -/
/- Fubini swaps, intervals, Tonelli, and double integrals over products.   -/
/- (measure.ml 29523-29885)                                                 -/
/- ------------------------------------------------------------------------- -/
/- Fubini for absolute integrability.                                       -/
/- (measure.ml 29215-29522)                                                 -/
/- ------------------------------------------------------------------------- -/
/- Some versions of Fubini where we stay in a fixed space R^n.             -/
/- (measure.ml 29886-30245)                                                 -/
/- ------------------------------------------------------------------------- -/
/- Integrals and "area under curve"; miscellaneous composition lemmas.     -/
/- (measure.ml 29061-29214)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDF where
  MEASURABLE_IFF_LEBESGUE_MEASURABLE_UNDER_CURVE : thm
  INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE : thm
  HAS_INTEGRAL_MEASURE_UNDER_CURVE : thm
  MEASURABLE_ON_COMPOSE_FSTCART : thm
  MEASURABLE_ON_COMPOSE_SNDCART : thm
  MEASURABLE_ON_COMPOSE_SUB : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDF [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSAB : MSAB) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAN : MSAN) (BMSBB : MSBB) (BMSDB : MSDB) (BMSDC : MSDC) (BMSDD : MSDD) (BMSDE : MSDE) : ExceptT String IO MSDF := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTERVAL, MEASURE_INTERVAL_1,
        .. } := BMSA
  let { INTEGRABLE_IMP_MEASURABLE, measurable_on, .. } := BMSAB
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { LEBESGUE_MEASURABLE_CLOSED, LEBESGUE_MEASURABLE_INTER, LEBESGUE_MEASURABLE_OPEN,
        LEBESGUE_MEASURABLE_UNION, LEBESGUE_MEASURABLE_UNIV, .. } := BMSAM
  let { MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN, .. } := BMSAN
  let { LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, .. } := BMSBB
  let { FUBINI_MEASURE, .. } := BMSDB
  let { NEGLIGIBLE_PCROSS, .. } := BMSDC
  let { FUBINI_TONELLI_MEASURE, LEBESGUE_MEASURABLE_PCROSS, .. } := BMSDD
  let { LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE,
        LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE_EQ, .. } := BMSDE
  let { HAS_INTEGRAL_INTEGRABLE_INTEGRAL, .. } := D.qintegration2
  let { integrable_on, INTEGRAL_UNIQUE, NEGLIGIBLE_EMPTY, .. } := D.qintegration3
  let { LINEAR_PASTECART, .. } := D.qvec
  let { LINEAR_COMPOSE_SUB, .. } := D.ig.dv.qvec
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_SYM, DIMINDEX_1, EMPTY_GSPEC, ETA_AX, EXTENSION,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IN_ELIM_PASTECART_THM,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM,
        PASTECART_IN_PCROSS, PASTECART_INJ, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_SUB_RZERO, SNDCART_PASTECART, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_ge, SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_VEC, FORALL_1, LIFT_DROP, LIFT_EQ, LINEAR_FSTCART, LINEAR_SNDCART,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSED_HALFSPACE_COMPONENT_GE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, OPEN_HALFSPACE_COMPONENT_LT,
        .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let MEASURABLE_IFF_LEBESGUE_MEASURABLE_UNDER_CURVE ← prove
   r"!f:real^N->real^1.
        (!x. &0 <= drop(f x))
        ==> (f measurable_on (:real^N) <=>
             lebesgue_measurable { pastecart x y | y IN interval[vec 0,f x]})"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE_EQ] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, IN_INTERVAL_1, ← GSYM drop, DROP_VEC] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN
       (← q r"{pastecart x y | &0 <= drop y /\ drop y <= drop (f x)} =
        (:real^N) PCROSS {y | &0 <= drop y} INTER
        {pastecart (x:real^N) y | drop y <= drop (f x)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS,
                     IN_INTER, IN_ELIM_PASTECART_THM] THEN
        REWRITE_TAC [IN_UNIV, IN_ELIM_THM],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_INTER THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_PCROSS, LEBESGUE_MEASURABLE_UNIV] THEN
        SIMP_TAC [LEBESGUE_MEASURABLE_CLOSED, ← GSYM real_ge, drop,
                  CLOSED_HALFSPACE_COMPONENT_GE]],
      SUBGOAL_THEN
       (← q r"{pastecart (x:real^N) y | drop y <= drop (f x)} =
        {pastecart x y | &0 <= drop y /\ drop y <= drop (f x)} UNION
         (:real^N) PCROSS {y | drop y < &0}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS,
                     IN_UNION, IN_ELIM_PASTECART_THM] THEN
        REWRITE_TAC [IN_UNIV, IN_ELIM_THM] THEN
        ASM_MESON_TAC [REAL_NOT_LE, REAL_LT_IMP_LE, REAL_LE_TRANS],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_UNION THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_PCROSS, LEBESGUE_MEASURABLE_UNIV] THEN
        SIMP_TAC [LEBESGUE_MEASURABLE_OPEN, drop,
                  OPEN_HALFSPACE_COMPONENT_LT]]])

  let INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE ← prove
   r"!f:real^N->real^1.
        (!x. &0 <= drop(f x))
        ==> (f integrable_on (:real^N) <=>
             measurable { pastecart x y | y IN interval[vec 0,f x]})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [W (MP_TAC o PART_MATCH (lhand o rand) FUBINI_TONELLI_MEASURE o snd) THEN
      REWRITE_TAC [IN_ELIM_PASTECART_THM, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
      ASM_SIMP_TAC [MEASURE_INTERVAL_1, DROP_VEC, REAL_SUB_RZERO, LIFT_DROP] THEN
      REWRITE_TAC [MEASURABLE_INTERVAL, EMPTY_GSPEC, NEGLIGIBLE_EMPTY] THEN
      ASM_REWRITE_TAC [ETA_AX] THEN DISCH_THEN MATCH_MP_TAC THEN
      SUBGOAL_THEN
       (← q r"{pastecart x y | y IN interval [vec 0,f x]} =
        {pastecart x y | drop y <= drop(f x)} INTER
        (:real^N) PCROSS {x | &0 <= drop x}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, FORALL_PASTECART, IN_INTER, IN_ELIM_PASTECART_THM,
                     PASTECART_IN_PCROSS, IN_UNIV] THEN
        REWRITE_TAC [IN_INTERVAL_1, IN_ELIM_THM, DROP_VEC, CONJ_SYM],
        MATCH_MP_TAC LEBESGUE_MEASURABLE_INTER THEN REWRITE_TAC [drop] THEN
        ASM_SIMP_TAC [LEBESGUE_MEASURABLE_FUNCTION_ORDINATE_SET_LE,
                      INTEGRABLE_IMP_MEASURABLE, LEBESGUE_MEASURABLE_PCROSS] THEN
        REPEAT DISJ2_TAC THEN REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV] THEN
        MATCH_MP_TAC LEBESGUE_MEASURABLE_CLOSED THEN
        REWRITE_TAC [drop, ← GSYM real_ge, CLOSED_HALFSPACE_COMPONENT_GE]],
      FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_MEASURE) THEN
      REWRITE_TAC [IN_ELIM_PASTECART_THM, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
      ASM_SIMP_TAC [MEASURE_INTERVAL_1, DROP_VEC, REAL_SUB_RZERO, LIFT_DROP] THEN
      REWRITE_TAC [ETA_AX, ← GSYM LIFT_EQ] THEN MESON_TAC [integrable_on]])

  let HAS_INTEGRAL_MEASURE_UNDER_CURVE ← prove
   r"!f:real^N->real^1 m.
        (!x. &0 <= drop(f x))
        ==> ((f has_integral lift m) (:real^N) <=>
             { pastecart x y | y IN interval[vec 0,f x]} has_measure m)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE,
                 HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p <=> p') /\ (p /\ p' ==> (q <=> q')) ==> (p /\ q <=> p' /\ q')")) THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE], STRIP_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_MEASURE) THEN
    REWRITE_TAC [IN_ELIM_PASTECART_THM, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
    ASM_REWRITE_TAC [MEASURE_INTERVAL_1, DROP_VEC, REAL_SUB_RZERO, LIFT_DROP] THEN
    REWRITE_TAC [ETA_AX, ← GSYM LIFT_EQ] THEN
    ASM_MESON_TAC [integrable_on, INTEGRAL_UNIQUE])

  let MEASURABLE_ON_COMPOSE_FSTCART ← prove
   r"!f:real^M->real^P.
        f measurable_on (:real^M)
        ==> (\z:real^(M,N)finite_sum. f(fstcart z)) measurable_on
            (:real^(M,N)finite_sum)"
   (GEN_TAC THEN REWRITE_TAC [measurable_on, LEFT_IMP_EXISTS_THM, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"g:num->real^M->real^P"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(k:real^M->bool) PCROSS (:real^N)") THEN
    EXISTS_TAC (← q r"(\n z. g n (fstcart z)):num->real^(M,N)finite_sum->real^P") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_PCROSS, FORALL_PASTECART, PASTECART_IN_PCROSS,
                     IN_UNIV, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [LINEAR_FSTCART, LINEAR_CONTINUOUS_ON] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV])

  let MEASURABLE_ON_COMPOSE_SNDCART ← prove
   r"!f:real^N->real^P.
        f measurable_on (:real^N)
        ==> (\z:real^(M,N)finite_sum. f(sndcart z)) measurable_on
            (:real^(M,N)finite_sum)"
   (GEN_TAC THEN REWRITE_TAC [measurable_on, LEFT_IMP_EXISTS_THM, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"g:num->real^N->real^P"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(:real^M) PCROSS (k:real^N->bool)") THEN
    EXISTS_TAC (← q r"(\n z. g n (sndcart z)):num->real^(M,N)finite_sum->real^P") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_PCROSS, FORALL_PASTECART, PASTECART_IN_PCROSS,
                     IN_UNIV, SNDCART_PASTECART, SNDCART_PASTECART] THEN
    GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [LINEAR_SNDCART, LINEAR_CONTINUOUS_ON] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV])

  let MEASURABLE_ON_COMPOSE_SUB ← prove
   r"!f:real^M->real^N.
        f measurable_on (:real^M)
        ==> (\z. f(fstcart z - sndcart z))
            measurable_on (:real^(M,M)finite_sum)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\z. f(fstcart z - sndcart z)):real^(M,M)finite_sum->real^N =
      (\z. f(fstcart z)) o
      (\z. pastecart (fstcart z - sndcart z) (sndcart z))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART],
      W (MP_TAC o PART_MATCH (lhs o rand) MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN o
        snd)] THEN
    REWRITE_TAC [FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [PASTECART_INJ] THEN
      CONJ_TAC THENL [MATCH_MP_TAC LINEAR_PASTECART, CONV_TAC (fun t => VECTOR_ARITH t)] THEN
      SIMP_TAC [LINEAR_SNDCART, LINEAR_FSTCART, LINEAR_COMPOSE_SUB],
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"(:real^(M,M)finite_sum)") THEN
      ASM_SIMP_TAC [MEASURABLE_ON_COMPOSE_FSTCART, SUBSET_UNIV] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN THEN
      REWRITE_TAC [LE_REFL, LEBESGUE_MEASURABLE_UNIV] THEN
      MATCH_MP_TAC LINEAR_PASTECART THEN
      SIMP_TAC [LINEAR_SNDCART, LINEAR_FSTCART, LINEAR_COMPOSE_SUB]])

  pure { MEASURABLE_IFF_LEBESGUE_MEASURABLE_UNDER_CURVE,
         INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE, HAS_INTEGRAL_MEASURE_UNDER_CURVE,
         MEASURABLE_ON_COMPOSE_FSTCART, MEASURABLE_ON_COMPOSE_SNDCART,
         MEASURABLE_ON_COMPOSE_SUB }
/- ------------------------------------------------------------------------- -/
/- Fubini for absolute integrability.                                       -/
/- (measure.ml 29215-29522)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDG where
  FUBINI_ABSOLUTELY_INTEGRABLE : thm
  FUBINI_ABSOLUTELY_INTEGRABLE_ALT : thm
  FUBINI_INTEGRAL : thm
  FUBINI_INTEGRAL_ALT : thm
  FUBINI_HAS_ABSOLUTE_INTEGRAL : thm
  FUBINI_HAS_ABSOLUTE_INTEGRAL_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDG [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMST : MST) (BMSAB : MSAB) (BMSDB : MSDB) (BMSDF : MSDF) : ExceptT String IO MSDG := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_MEASURE, measurable, MEASURE_UNIQUE,
        .. } := BMSA
  let { HAS_MEASURE_ISOMETRY, .. } := BMST
  let { INTEGRABLE_IMP_MEASURABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE, .. } := BMSAB
  let { FUBINI_MEASURE, .. } := BMSDB
  let { HAS_INTEGRAL_MEASURE_UNDER_CURVE, INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE,
        .. } := BMSDF
  let { ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_COMPONENTWISE,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_MAX_1,
        ABSOLUTELY_INTEGRABLE_MIN_1, ABSOLUTELY_INTEGRABLE_NEG, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV, ABSOLUTELY_INTEGRABLE_SPIKE_SET,
        ABSOLUTELY_INTEGRABLE_SUB, .. } := D.qintegration1
  let { HAS_INTEGRAL_COMPONENTWISE, HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_SPIKE,
        HAS_INTEGRAL_SUB, INTEGRABLE_SPIKE_SET, .. } := D.qintegration2
  let { INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_PASTECART_SYM_UNIV, INTEGRAL_SUB,
        INTEGRAL_UNIQUE, LIFT_INTEGRAL_COMPONENT, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ,
        NEGLIGIBLE_UNIONS, NONNEGATIVE_ABSOLUTELY_INTEGRABLE, .. } := D.qintegration3
  let { ADD_AC, .. } := D.qsession
  let { LINEAR_PASTECART, SQNORM_PASTECART, .. } := D.qvec
  let { COMPL_COMPL, .. } := D.ig.dv.dg.qsession
  let { MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_1, DIMINDEX_FINITE_SUM, EQ_IMP,
        ETA_AX, EXISTS_PASTECART, FINITE_IMAGE, FINITE_NUMSEG,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, IN_UNIV, MONO_EXISTS, PASTECART_INJ, REAL_ADD_AC,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SNDCART_PASTECART, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SURJECTIVE_IMAGE_EQ, UNIONS_GSPEC, UNWIND_THM1,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_SUB, FORALL_1, LIFT_DROP, LIFT_NUM, LINEAR_COMPOSE, LINEAR_FSTCART,
        LINEAR_SNDCART, NORM_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POW_2, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, .. } := D.ig.dv.dg.pt.cvx.vec4
  -- @@SCOPE END

  let FUBINI_ABSOLUTELY_INTEGRABLE ← (do
    let lemma ← prove
     r"{x | ~(!i. i IN k ==> P i x)} = UNIONS {{x | ~P i x} | i IN k}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    let assoclemma ← prove
     r"!P:real^(M,N)finite_sum->real^P->bool.
            {pastecart x y | P x y} has_measure m
            ==> {pastecart x (pastecart y z) | P (pastecart x y) z}
                has_measure m"
     (GEN_TAC THEN MP_TAC (← ISPECL
       [← q r"\z. pastecart (fstcart(fstcart z):real^M)
                       (pastecart (sndcart(fstcart z):real^N)
                                  (sndcart z:real^P))",
        ← q r"{pastecart (x:real^(M,N)finite_sum) (y:real^P) | P x y}",
        ← q r"m:real"] HAS_MEASURE_ISOMETRY) THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_AC] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [REPEAT (MATCH_MP_TAC LINEAR_PASTECART THEN CONJ_TAC) THEN
          REWRITE_TAC [← GSYM o_DEF] THEN
          REPEAT (MATCH_MP_TAC LINEAR_COMPOSE THEN CONJ_TAC) THEN
          REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART],
          SIMP_TAC [FORALL_PASTECART, NORM_EQ, ← GSYM NORM_POW_2, SQNORM_PASTECART,
                    FSTCART_PASTECART, SNDCART_PASTECART, REAL_ADD_AC]],
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC EQ_IMP THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
        REWRITE_TAC [FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART,
                     IN_ELIM_THM, EXISTS_PASTECART, PASTECART_INJ] THEN
        MESON_TAC []])
    let FUBINI_LEMMA ← prove
     r"!f:real^(M,N)finite_sum->real^1.
            f integrable_on (:real^(M,N)finite_sum) /\ (!x. &0 <= drop(f x))
            ==> negligible {x | ~((f o pastecart x) integrable_on (:real^N))} /\
                ((\x. integral (:real^N) (f o pastecart x)) has_integral
                 integral (:real^(M,N)finite_sum) f) (:real^M)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"f:real^(M,N)finite_sum->real^1")
        INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"measurable { pastecart x (pastecart y z) |
                     z IN interval[vec 0,(f:real^(M,N)finite_sum->real^1)
                                         (pastecart x y)] }")
      ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [measurable]) THEN
        REWRITE_TAC [measurable] THEN MATCH_MP_TAC MONO_EXISTS THEN
        REWRITE_TAC [assoclemma],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_MEASURE) THEN
      REWRITE_TAC [IN_ELIM_THM, PASTECART_INJ] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, UNWIND_THM1] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | ?y z. P y z /\ x = pastecart y z} =
        {pastecart y z | P y z}")] THEN
      MP_TAC (← GEN (← q r"x:real^M") (← ISPEC
         (← q r"(f:real^(M,N)finite_sum->real^1) o pastecart x")
            INTEGRABLE_IFF_MEASURABLE_UNDER_CURVE)) THEN
      ASM_REWRITE_TAC [o_DEF] THEN DISCH_THEN (ASSUME_TAC o GSYM) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"y = z /\ ((f has_integral y) s ==> (g has_integral y) s)
        ==> (f has_integral y) s ==> (g has_integral z) s")) THEN
      CONJ_TAC THENL
       [CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
        ASM_SIMP_TAC [HAS_INTEGRAL_MEASURE_UNDER_CURVE] THEN
        ASM_REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE] THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
        MATCH_MP_TAC assoclemma THEN
        ASM_REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE],
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
            (← REWRITE_RULE [CONJ_ASSOC] HAS_INTEGRAL_SPIKE)) THEN
        EXISTS_TAC
         (← q r"{x | ~((\y. (f:real^(M,N)finite_sum->real^1) (pastecart x y))
                 integrable_on (:real^N))}") THEN
        ASM_REWRITE_TAC [IN_UNIV, IN_DIFF, IN_ELIM_THM] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
        ASM_SIMP_TAC [HAS_INTEGRAL_MEASURE_UNDER_CURVE] THEN
        ASM_SIMP_TAC [← GSYM HAS_MEASURE_MEASURE]])
    let FUBINI_1 ← prove
     r"!f:real^(M,N)finite_sum->real^1.
            f absolutely_integrable_on (:real^(M,N)finite_sum)
            ==> negligible
                 {x | ~((f o pastecart x) absolutely_integrable_on (:real^N))} /\
                ((\x. integral (:real^N) (f o pastecart x)) has_integral
                 integral (:real^(M,N)finite_sum) f) (:real^M)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN MAP_EVERY ABBREV_TAC
       [← q r"g = \x:real^(M,N)finite_sum. lift (max (&0) (drop(f x)))",
        ← q r"h = \x:real^(M,N)finite_sum. --(lift (min (&0) (drop(f x))))"] THEN
      SUBGOAL_THEN (← q r"!x:real^(M,N)finite_sum. &0 <= drop(g x) /\ &0 <= drop(h x)")
      STRIP_ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g", "h"] THEN
        REWRITE_TAC [DROP_NEG, LIFT_DROP] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(g:real^(M,N)finite_sum->real^1) absolutely_integrable_on UNIV /\
        (h:real^(M,N)finite_sum->real^1) absolutely_integrable_on UNIV")
      STRIP_ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g", "h"] THEN REWRITE_TAC [] THEN CONJ_TAC THEN
        TRY (MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NEG) THENL
         [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MAX_1,
          MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MIN_1] THEN
        ASM_REWRITE_TAC [LIFT_DROP, ETA_AX, LIFT_NUM] THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_0],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(f:real^(M,N)finite_sum->real^1) = \x. g x - h x")
      SUBST1_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g", "h"] THEN
        REWRITE_TAC [FUN_EQ_THM, ← GSYM DROP_EQ, LIFT_DROP, DROP_SUB, DROP_NEG] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"h:real^(M,N)finite_sum->real^1") FUBINI_LEMMA) THEN
      MP_TAC (← ISPEC (← q r"g:real^(M,N)finite_sum->real^1") FUBINI_LEMMA) THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
      ONCE_REWRITE_TAC [← TAUT
       (← q r"p /\ q ==> r /\ s ==> t <=> p /\ r ==> q /\ s ==> t")] THEN
      REWRITE_TAC [← GSYM NEGLIGIBLE_UNION_EQ, o_DEF] THEN DISCH_TAC THEN
      DISCH_THEN (ASSUME_TAC o MATCH_MP HAS_INTEGRAL_SUB) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            NEGLIGIBLE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNION, ← GSYM DE_MORGAN_THM] THEN
        REWRITE_TAC [CONTRAPOS_THM, o_DEF] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
        CONJ_TAC THEN MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
        ASM_REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, IN_UNIV],
        ASM_SIMP_TAC [INTEGRAL_SUB, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
         (← REWRITE_RULE [CONJ_ASSOC] HAS_INTEGRAL_SPIKE))) THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (EXISTS_TAC (← liftExcept (rand (concl th))) THEN
            CONJ_TAC THENL [ACCEPT_TAC th, ALL_TAC])) THEN
        REWRITE_TAC [IN_DIFF, IN_UNIV, IN_UNION, IN_ELIM_THM] THEN
        SIMP_TAC [DE_MORGAN_THM, INTEGRAL_SUB]])
    prove
     r"!f:real^(M,N)finite_sum->real^P.
          f absolutely_integrable_on (:real^(M,N)finite_sum)
          ==> negligible
               {x | ~((\y. f(pastecart x y))
                       absolutely_integrable_on (:real^N))} /\
              ((\x. integral (:real^N) (\y. f(pastecart x y))) has_integral
               integral (:real^(M,N)finite_sum) f) (:real^M)"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
        REWRITE_TAC [← GSYM IN_NUMSEG, lemma] THEN
        MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
        SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG],
        DISCH_TAC THEN
        ONCE_REWRITE_TAC [HAS_INTEGRAL_COMPONENTWISE]] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
        [ABSOLUTELY_INTEGRABLE_COMPONENTWISE]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP FUBINI_1) THEN SIMP_TAC [o_DEF] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      ASM_SIMP_TAC [LIFT_INTEGRAL_COMPONENT,
                    ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
            HAS_INTEGRAL_SPIKE)) THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (EXISTS_TAC (← liftExcept (rand (concl th))) THEN
          CONJ_TAC THENL [ACCEPT_TAC th, ALL_TAC])) THEN
      REWRITE_TAC [IN_UNIV, IN_DIFF, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [LIFT_INTEGRAL_COMPONENT,
                    ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]))

  let FUBINI_ABSOLUTELY_INTEGRABLE_ALT ← prove
   r"!f:real^(M,N)finite_sum->real^P.
        f absolutely_integrable_on (:real^(M,N)finite_sum)
        ==> negligible
             {y | ~((\x. f(pastecart x y))
                     absolutely_integrable_on (:real^M))} /\
            ((\y. integral (:real^M) (\x. f(pastecart x y))) has_integral
             integral (:real^(M,N)finite_sum) f) (:real^N)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I
     [← GSYM ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV]) THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [INTEGRAL_PASTECART_SYM_UNIV])

  let FUBINI_INTEGRAL ← prove
   r"!f:real^(M,N)finite_sum->real^P.
        f absolutely_integrable_on UNIV
        ==> integral UNIV f =
            integral UNIV (\x. integral UNIV (\y. f(pastecart x y)))"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o CONJUNCT2 o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN REFL_TAC)

  let FUBINI_INTEGRAL_ALT ← prove
   r"!f:real^(M,N)finite_sum->real^P.
        f absolutely_integrable_on UNIV
        ==> integral UNIV f =
            integral UNIV (\y. integral UNIV (\x. f(pastecart x y)))"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM
      (MP_TAC o CONJUNCT2 o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE_ALT) THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN REFL_TAC)

  let FUBINI_HAS_ABSOLUTE_INTEGRAL ← prove
   r"!f:real^(M,N)finite_sum->real^P.
        f absolutely_integrable_on (:real^(M,N)finite_sum)
        ==> negligible
             {x | ~((\y. f(pastecart x y))
                     absolutely_integrable_on (:real^N))} /\
            (\x. integral (:real^N) (\y. f(pastecart x y)))
            absolutely_integrable_on (:real^M) /\
            integral (:real^M)
              (\x. integral (:real^N) (\y. f(pastecart x y))) =
            integral (:real^(M,N)finite_sum) f"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_NORM) THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    ASM_REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [IN_UNIV, INTEGRABLE_IMP_MEASURABLE] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"n1 = {x | ~((\y. (f:real^(M,N)finite_sum->real^P)(pastecart x y))
              absolutely_integrable_on (:real^N))} ",
      ← q r"n2 = {x | ~((\y. lift(norm((f:real^(M,N)finite_sum->real^P)
                                  (pastecart x y))))
              absolutely_integrable_on (:real^N))}"] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE_SET) THEN
    EXISTS_TAC (← q r"(:real^M) DIFF (n1 UNION n2)") THEN
    REWRITE_TAC [← SET_RULE (← q r"(s DIFF UNIV) UNION UNIV DIFF s = UNIV DIFF s")] THEN
    REWRITE_TAC [COMPL_COMPL] THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC
     (← q r"\x. integral (:real^N) (\y. lift(norm((f:real^(M,N)finite_sum->real^P)
                                            (pastecart x y))))") THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_UNION, DE_MORGAN_THM] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_IMP_MEASURABLE THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"n1 UNION n2:real^M->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN SET_TAC [],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"n1 UNION n2:real^M->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN SET_TAC [],
      X_GEN_TAC (← q r"x:real^M") THEN MAP_EVERY EXPAND_TAC ["n1", "n2"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]])

  let FUBINI_HAS_ABSOLUTE_INTEGRAL_ALT ← prove
   r"!f:real^(M,N)finite_sum->real^P.
        f absolutely_integrable_on (:real^(M,N)finite_sum)
        ==> negligible
             {y | ~((\x. f(pastecart x y))
                     absolutely_integrable_on (:real^M))} /\
            (\y. integral (:real^M) (\x. f(pastecart x y)))
            absolutely_integrable_on (:real^N) /\
            integral (:real^N)
              (\y. integral (:real^M) (\x. f(pastecart x y))) =
            integral (:real^(M,N)finite_sum) f"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE_ALT) THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_NORM) THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE_ALT) THEN
    ASM_REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [IN_UNIV, INTEGRABLE_IMP_MEASURABLE] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"n1 = {y | ~((\x. (f:real^(M,N)finite_sum->real^P)(pastecart x y))
              absolutely_integrable_on (:real^M))} ",
      ← q r"n2 = {y | ~((\x. lift(norm((f:real^(M,N)finite_sum->real^P)
                                  (pastecart x y))))
              absolutely_integrable_on (:real^M))}"] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE_SET) THEN
    EXISTS_TAC (← q r"(:real^N) DIFF (n1 UNION n2)") THEN
    REWRITE_TAC [← SET_RULE (← q r"(s DIFF UNIV) UNION UNIV DIFF s = UNIV DIFF s")] THEN
    REWRITE_TAC [COMPL_COMPL] THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC
     (← q r"\y. integral (:real^M) (\x. lift(norm((f:real^(M,N)finite_sum->real^P)
                                            (pastecart x y))))") THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_UNION, DE_MORGAN_THM] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_IMP_MEASURABLE THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"(:real^N)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"n1 UNION n2:real^N->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN SET_TAC [],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"(:real^N)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"n1 UNION n2:real^N->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN SET_TAC [],
      X_GEN_TAC (← q r"x:real^N") THEN MAP_EVERY EXPAND_TAC ["n1", "n2"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]])

  pure { FUBINI_ABSOLUTELY_INTEGRABLE, FUBINI_ABSOLUTELY_INTEGRABLE_ALT,
         FUBINI_INTEGRAL, FUBINI_INTEGRAL_ALT, FUBINI_HAS_ABSOLUTE_INTEGRAL,
         FUBINI_HAS_ABSOLUTE_INTEGRAL_ALT }
/- ------------------------------------------------------------------------- -/
/- Fubini swaps, intervals, Tonelli, and double integrals over products.   -/
/- (measure.ml 29523-29885)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDH where
  FUBINI_INTEGRAL_SWAP : thm
  FUBINI_HAS_INTEGRAL_SWAP : thm
  FUBINI_HAS_INTEGRAL_SWAP_ALT : thm
  FUBINI_INTEGRAL_INTERVAL : thm
  FUBINI_INTEGRAL_INTERVAL_ALT : thm
  INTEGRAL_PASTECART_CONTINUOUS : thm
  INTEGRAL_SWAP_CONTINUOUS : thm
  FUBINI_TONELLI : thm
  FUBINI_TONELLI_ALT : thm
  HAS_DOUBLE_INTEGRAL_PCROSS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDH [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAF : MSAF) (BMSAM : MSAM) (BMSAN : MSAN) (BMSDF : MSDF) (BMSDG : MSDG) : ExceptT String IO MSDH := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_MEASURABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE, .. } := BMSAB
  let { MEASURABLE_ON_CONST, MEASURABLE_ON_NORM, .. } := BMSAD
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, MEASURABLE_ON_MIN, MEASURABLE_ON_MUL,
        .. } := BMSAE
  let { MEASURABLE_ON_BILINEAR, .. } := BMSAF
  let { LEBESGUE_MEASURABLE_INTERVAL, .. } := BMSAM
  let { MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN, .. } := BMSAN
  let { MEASURABLE_ON_COMPOSE_FSTCART, MEASURABLE_ON_COMPOSE_SNDCART, .. } := BMSDF
  let { FUBINI_ABSOLUTELY_INTEGRABLE, FUBINI_ABSOLUTELY_INTEGRABLE_ALT, FUBINI_INTEGRAL,
        FUBINI_INTEGRAL_ALT, .. } := BMSDG
  let { ABSOLUTELY_INTEGRABLE_CMUL, ABSOLUTELY_INTEGRABLE_CONTINUOUS,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV, ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV,
        .. } := D.qintegration1
  let { HAS_INTEGRAL_INTEGRABLE, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        HAS_INTEGRAL_RESTRICT_UNIV, INTEGRABLE_0, INTEGRABLE_CASES, INTEGRABLE_CMUL,
        INTEGRABLE_CONST, INTEGRABLE_EQ, INTEGRAL_0, .. } := D.qintegration2
  let { absolutely_integrable_on, integrable_on, INTEGRAL_CMUL, INTEGRAL_DROP_POS,
        INTEGRAL_LINEAR, INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_NORM_BOUND_INTEGRAL_AE,
        INTEGRAL_RESTRICT_UNIV, INTEGRAL_UNIQUE, MONOTONE_CONVERGENCE_INCREASING,
        NEGLIGIBLE_EMPTY, NEGLIGIBLE_UNION_EQ, NONNEGATIVE_ABSOLUTELY_INTEGRABLE,
        NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE, .. } := D.qintegration3
  let { REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { PCROSS_INTERVAL, .. } := D.ig.qtopology
  let { NORM_REAL, .. } := D.ig.qvec
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { BILINEAR_BOUNDED_POS, BILINEAR_LZERO, BILINEAR_RZERO, .. } := D.ig.dv.qvec
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, .. } := D.ig.dv.dg.pt.cvx
  let { ADD_SYM, CART_EQ, COND_RAND, COND_RATOR, DE_MORGAN_THM, DIMINDEX_1,
        DIMINDEX_FINITE_SUM, EQ_IMP, ETA_AX, EXISTS_PASTECART, EXTENSION, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, IN_UNIV, LAMBDA_BETA, MONO_EXISTS, NOT_IN_EMPTY,
        PASTECART_IN_PCROSS, PASTECART_INJ, REAL_ARCH_SIMPLE,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_OF_NUM_LE, REAL_OF_NUM_SUC, RIGHT_FORALL_IMP_THM,
        SNDCART_PASTECART, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUBSET_UNIV, SURJECTIVE_IMAGE_EQ, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_VEC, FORALL_1, FSTCART_ADD, FSTCART_CMUL, IN_INTERVAL, LIFT_CMUL,
        LIFT_DROP, NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, PASTECART_ADD, PASTECART_CMUL, REAL_ABS_NORM,
        SNDCART_ADD, SNDCART_CMUL, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { bilinear, drop, linear, VEC_COMPONENT, VECTOR_NEG_COMPONENT,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { bounded, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let FUBINI_INTEGRAL_SWAP ← prove
   r"!f. f absolutely_integrable_on (:real^(M,N)finite_sum)
         ==> integral (:real^M)
                      (\x. integral (:real^N) (\y. f (pastecart x y))):real^P =
             integral (:real^N)
                      (\y. integral (:real^M) (\x. f (pastecart x y)))"
   (MESON_TAC [FUBINI_INTEGRAL, FUBINI_INTEGRAL_ALT])

  let FUBINI_HAS_INTEGRAL_SWAP ← prove
   r"!f. f absolutely_integrable_on (:real^(M,N)finite_sum)
       ==> ((\x. integral (:real^N) (\y. f (pastecart x y))) has_integral
            integral (:real^N)
                     (\y. integral (:real^M) (\x. f (pastecart x y))):real^P)
            (:real^M)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE_ALT) THEN
    MESON_TAC [INTEGRAL_UNIQUE])

  let FUBINI_HAS_INTEGRAL_SWAP_ALT ← prove
   r"!f. f absolutely_integrable_on (:real^(M,N)finite_sum)
       ==> ((\y. integral (:real^M) (\x. f (pastecart x y))) has_integral
            integral (:real^M)
                      (\x. integral (:real^N) (\y. f (pastecart x y))):real^P)
            (:real^N)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE_ALT) THEN
    MESON_TAC [INTEGRAL_UNIQUE])

  let FUBINI_INTEGRAL_INTERVAL ← prove
   r"!f:real^(M,N)finite_sum->real^P a b c d.
        f absolutely_integrable_on interval[pastecart a c,pastecart b d]
        ==> integral (interval[pastecart a c,pastecart b d]) f =
            integral (interval[a,b])
                     (\x. integral (interval[c,d])
                                   (\y. f(pastecart x y)))"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_INTEGRAL) THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_UNIV] THEN DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    REWRITE_TAC [PASTECART_IN_PCROSS, ← GSYM PCROSS_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [INTEGRAL_0] THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_UNIV])

  let FUBINI_INTEGRAL_INTERVAL_ALT ← prove
   r"!f:real^(M,N)finite_sum->real^P a b c d.
        f absolutely_integrable_on interval[pastecart a c,pastecart b d]
        ==> integral (interval[pastecart a c,pastecart b d]) f =
            integral (interval[c,d])
                     (\y. integral (interval[a,b])
                                   (\x. f(pastecart x y)))"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP FUBINI_INTEGRAL_ALT) THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_UNIV] THEN DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    REWRITE_TAC [PASTECART_IN_PCROSS, ← GSYM PCROSS_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [INTEGRAL_0] THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_UNIV])

  let INTEGRAL_PASTECART_CONTINUOUS ← prove
   r"!f:real^(M,N)finite_sum->real^P a b c d.
        f continuous_on interval[pastecart a c,pastecart b d]
        ==> integral (interval[pastecart a c,pastecart b d]) f =
            integral (interval[a,b])
                     (\x. integral (interval[c,d])
                                   (\y. f(pastecart x y)))"
   (SIMP_TAC [FUBINI_INTEGRAL_INTERVAL, ABSOLUTELY_INTEGRABLE_CONTINUOUS])

  let INTEGRAL_SWAP_CONTINUOUS ← prove
   r"!f:real^M->real^N->real^P a b c d.
        (\z. f (fstcart z) (sndcart z))
        continuous_on interval[pastecart a c,pastecart b d]
        ==> integral (interval[a,b]) (\x. integral (interval[c,d]) (f x)) =
            integral (interval[c,d])
                     (\y. integral (interval[a,b]) (\x. f x y))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_CONTINUOUS) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← MATCH_MP FUBINI_INTEGRAL_INTERVAL_ALT th) THEN
      MP_TAC (← MATCH_MP FUBINI_INTEGRAL_INTERVAL th))) THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [ETA_AX])

  let FUBINI_TONELLI ← prove
   r"!f:real^(M,N)finite_sum->real^P.
     f measurable_on (:real^(M,N)finite_sum)
     ==> (f absolutely_integrable_on (:real^(M,N)finite_sum) <=>
          negligible
            {x | ~((\y. f(pastecart x y)) absolutely_integrable_on (:real^N))} /\
          (\x. integral (:real^N) (\y. lift(norm(f(pastecart x y)))))
          integrable_on (:real^M))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_NORM) THEN
      DISCH_THEN (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      FIRST_ASSUM (ACCEPT_TAC o MATCH_MP HAS_INTEGRAL_INTEGRABLE),
      ALL_TAC] THEN
    ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_MEASURABLE] THEN ABBREV_TAC
      (← q r"g = \n x. if x IN interval[--vec n,vec n]
                 then lift(min (norm ((f:real^(M,N)finite_sum->real^P) x)) (&n))
                 else vec 0") THEN
    SUBGOAL_THEN
     (← q r"!n. (g:num->real^(M,N)finite_sum->real^1) n absolutely_integrable_on UNIV")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "g" THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
      REWRITE_TAC [IN_UNIV, DIMINDEX_1, FORALL_1] THEN
      REWRITE_TAC [COND_RAND, COND_RATOR, ← GSYM drop, LIFT_DROP, DROP_VEC] THEN
      CONJ_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), ALL_TAC] THEN
      MATCH_MP_TAC INTEGRABLE_CASES THEN
      REWRITE_TAC [INTEGRABLE_0, IN_UNIV, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
      MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
      EXISTS_TAC (← q r"\x:real^(M,N)finite_sum. lift(&n)") THEN
      REWRITE_TAC [INTEGRABLE_CONST, NORM_LIFT, LIFT_DROP] THEN
      SIMP_TAC [NORM_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> abs(min x (&n)) <= &n")] THEN
      MP_TAC (← ISPECL
       [← q r"\x. lift(norm((f:real^(M,N)finite_sum->real^P) x))",
        ← q r"\x:real^(M,N)finite_sum. lift(&n)",
        ← q r"interval[--vec n:real^(M,N)finite_sum,vec n]"] MEASURABLE_ON_MIN) THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
        EXISTS_TAC (← q r"(:real^(M,N)finite_sum)") THEN
        REWRITE_TAC [SUBSET_UNIV, LEBESGUE_MEASURABLE_INTERVAL] THEN
        ASM_SIMP_TAC [MEASURABLE_ON_NORM, MEASURABLE_ON_CONST],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA] THEN
        REWRITE_TAC [DIMINDEX_1, LIFT_DROP, FORALL_1, ← GSYM drop]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"g:num->real^(M,N)finite_sum->real^1",
      ← q r"\x. lift(norm((f:real^(M,N)finite_sum->real^P) x))",
      ← q r"(:real^(M,N)finite_sum)"]
     MONOTONE_CONVERGENCE_INCREASING) THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, IN_UNIV] THEN
    REPEAT CONJ_TAC THENL
     [REPEAT GEN_TAC THEN EXPAND_TAC "g" THEN REWRITE_TAC [] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [LIFT_DROP]) THEN
      REWRITE_TAC [REAL_LE_REFL, DROP_VEC, ← GSYM REAL_OF_NUM_SUC] THEN
      TRY (CONV_TAC (fun t => NORM_ARITH t)) THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← TAUT (← q r"~p ==> p ==> q"))) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      REWRITE_TAC [SUBSET_INTERVAL, VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN REPEAT STRIP_TAC THEN
      REAL_ARITH_TAC,
      X_GEN_TAC (← q r"z:real^(M,N)finite_sum") THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN
      MP_TAC (← ISPEC (← q r"&1 + max (norm z) (norm((f:real^(M,N)finite_sum->real^P) z))")
          REAL_ARCH_SIMPLE) THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN DISCH_TAC THEN
      EXPAND_TAC "g" THEN REWRITE_TAC [] THEN COND_CASES_TAC THENL
       [AP_TERM_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"min a b = a <=> a <= b")] THEN
        ASM_REAL_ARITH_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← TAUT (← q r"~p ==> p ==> q"))) THEN
        REWRITE_TAC [IN_INTERVAL, VECTOR_NEG_COMPONENT, VEC_COMPONENT] THEN
        REWRITE_TAC [← GSYM REAL_ABS_BOUNDS] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(x$i) <= norm(x:real^N) /\ norm x <= a ==> abs(x$i) <= a")) THEN
        REWRITE_TAC [COMPONENT_LE_NORM] THEN ASM_REAL_ARITH_TAC],
      MP_TAC (← GEN (← q r"n:num") (← ISPEC (← q r"(g:num->real^(M,N)finite_sum->real^1) n")
        FUBINI_ABSOLUTELY_INTEGRABLE)) THEN
      ASM_REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (REWRITE_TAC [← GSYM (← MATCH_MP INTEGRAL_UNIQUE (← SPEC (← q r"n:num") th))])) THEN
      REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN
      EXISTS_TAC
       (← q r"drop(integral (:real^M)
              (\x. lift(norm(integral (:real^N)
                (\y. lift(norm(
                  (f:real^(M,N)finite_sum->real^P) (pastecart x y))))))))") THEN
      X_GEN_TAC (← q r"n:num") THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL_AE THEN
      EXISTS_TAC
       (← q r"{x | ~((\y. (f:real^(M,N)finite_sum->real^P)(pastecart x y))
               absolutely_integrable_on (:real^N))} UNION
        {x | ~((\y. (g:num->real^(M,N)finite_sum->real^1) n (pastecart x y))
               absolutely_integrable_on (:real^N))}") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [integrable_on],
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
        MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE THEN
        EXISTS_TAC
         (← q r"{x | ~((\y. (f:real^(M,N)finite_sum->real^P)(pastecart x y))
               absolutely_integrable_on (:real^N))}") THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        REWRITE_TAC [absolutely_integrable_on, ← GSYM drop] THEN
        STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_POS THEN
        ASM_REWRITE_TAC [LIFT_DROP, NORM_POS_LE],
        X_GEN_TAC (← q r"x:real^M") THEN
        REWRITE_TAC [IN_DIFF, IN_UNIV, IN_UNION, IN_ELIM_THM, DE_MORGAN_THM] THEN
        STRIP_TAC THEN REWRITE_TAC [LIFT_DROP] THEN
        MATCH_MP_TAC (← REAL_ARITH
          (← q r"drop a <= norm a /\ x <= drop a==> x <= norm a")) THEN CONJ_TAC
        THENL [REWRITE_TAC [drop, NORM_REAL] THEN REAL_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
        RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
        ASM_REWRITE_TAC [LIFT_DROP, REAL_LE_REFL, IN_UNIV] THEN
        X_GEN_TAC (← q r"y:real^N") THEN EXPAND_TAC "g" THEN
        COND_CASES_TAC THEN REWRITE_TAC [NORM_0, NORM_POS_LE] THEN
        REWRITE_TAC [NORM_LIFT] THEN CONV_TAC (fun t => NORM_ARITH t)]])

  let FUBINI_TONELLI_ALT ← prove
   r"!f:real^(M,N)finite_sum->real^P.
     f measurable_on (:real^(M,N)finite_sum)
     ==> (f absolutely_integrable_on (:real^(M,N)finite_sum) <=>
          negligible
            {y | ~((\x. f(pastecart x y)) absolutely_integrable_on (:real^M))} /\
          (\y. integral (:real^M) (\x. lift(norm(f(pastecart x y)))))
          integrable_on (:real^N))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC
     (← q r"(f:real^(M,N)finite_sum->real^P) o (\z. pastecart (sndcart z) (fstcart z))")
     FUBINI_TONELLI) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [W (MP_TAC o PART_MATCH (lhand o rand) MEASURABLE_ON_LINEAR_IMAGE_EQ_GEN o
          snd) THEN
      ASM_REWRITE_TAC [DIMINDEX_FINITE_SUM, ADD_SYM] THEN ANTS_TAC THENL
       [SIMP_TAC [linear, FORALL_PASTECART, FSTCART_PASTECART,
                  SNDCART_PASTECART, PASTECART_INJ,
                  FSTCART_ADD, SNDCART_ADD, FSTCART_CMUL, SNDCART_CMUL] THEN
        REWRITE_TAC [← GSYM PASTECART_ADD, ← GSYM PASTECART_CMUL],
        DISCH_THEN SUBST1_TAC THEN POP_ASSUM MP_TAC THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [IN_UNIV] THEN
        REWRITE_TAC [EXISTS_PASTECART, FORALL_PASTECART] THEN
        REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN MESON_TAC []],
      REWRITE_TAC [ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV, o_DEF,
                   FSTCART_PASTECART, SNDCART_PASTECART]])

  let HAS_DOUBLE_INTEGRAL_PCROSS ← prove
   r"!bop:real^P->real^Q->real^R f:real^M->real^P g:real^N->real^Q s t.
        bilinear bop /\
        f absolutely_integrable_on s /\
        g absolutely_integrable_on t
        ==> ((\z. bop (f(fstcart z)) (g(sndcart z))) has_integral
             bop (integral s f) (integral t g))
            (s PCROSS t)"
   (REPEAT GEN_TAC THEN  DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
    ABBREV_TAC (← q r"f':real^M->real^P = \x. if x IN s then f x else vec 0") THEN
    ABBREV_TAC (← q r"g':real^N->real^Q = \x. if x IN t then g x else vec 0") THEN
    SUBGOAL_THEN
     (← q r"(\x:real^(M,N)finite_sum.
          if x IN s PCROSS t
          then (bop:real^P->real^Q->real^R) (f (fstcart x)) (g (sndcart x))
          else vec 0) =
      (\x. bop (f'(fstcart x)) (g'(sndcart x)))")
    SUBST1_TAC THENL
     [MAP_EVERY EXPAND_TAC ["f'", "g'"] THEN
      REWRITE_TAC [FUN_EQ_THM, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP BILINEAR_LZERO) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP BILINEAR_RZERO) THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN
      MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(y:real^N) IN t"] THEN
      ASM_REWRITE_TAC [],
      UNDISCH_TAC (← q r"bilinear(bop:real^P->real^Q->real^R)") THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN
      SPEC_TAC ((← q r"f':real^M->real^P"), (← q r"f:real^M->real^P")) THEN
      SPEC_TAC ((← q r"g':real^N->real^Q"), (← q r"g:real^N->real^Q")) THEN
      REPEAT STRIP_TAC] THEN
    ABBREV_TAC
     (← q r"h = \z. (bop:real^P->real^Q->real^R)
              ((f:real^M->real^P) (fstcart z))
              ((g:real^N->real^Q) (sndcart z))") THEN
    SUBGOAL_THEN
     (← q r"(h:real^(M,N)finite_sum->real^R) measurable_on UNIV")
    ASSUME_TAC THENL
     [EXPAND_TAC "h" THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          MEASURABLE_ON_BILINEAR)) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_ON_COMPOSE_FSTCART,
        MATCH_MP_TAC MEASURABLE_ON_COMPOSE_SNDCART] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ABSOLUTELY_INTEGRABLE_MEASURABLE]) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(h:real^(M,N)finite_sum->real^R) absolutely_integrable_on UNIV")
    ASSUME_TAC THENL
     [MATCH_MP_TAC
       MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC
        (← q r"\z. lift(B * norm((f:real^M->real^P) (fstcart z)) *
                      norm((g:real^N->real^Q) (sndcart z)))") THEN
      REWRITE_TAC [IN_UNIV, LIFT_DROP, LIFT_CMUL, DROP_CMUL] THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_CMUL,
        EXPAND_TAC "h" THEN REWRITE_TAC [DROP_CMUL, LIFT_DROP] THEN
        ASM_REWRITE_TAC []] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      W (MP_TAC o PART_MATCH (lhand o rand) FUBINI_TONELLI_ALT o snd) THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN ANTS_TAC THENL
       [MATCH_MP_TAC MEASURABLE_ON_MUL THEN CONJ_TAC THEN
        MATCH_MP_TAC MEASURABLE_ON_NORM THENL
         [MATCH_MP_TAC MEASURABLE_ON_COMPOSE_FSTCART,
          MATCH_MP_TAC MEASURABLE_ON_COMPOSE_SNDCART] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [ABSOLUTELY_INTEGRABLE_MEASURABLE]) THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← MESON [NEGLIGIBLE_EMPTY] (← q r"s = {} ==> negligible s")) THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
        X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [← GSYM LIFT_CMUL] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIFT_CMUL] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_CMUL THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC INTEGRABLE_EQ THEN
      REWRITE_TAC [NORM_MUL, LIFT_CMUL, REAL_ABS_NORM, NORM_LIFT, IN_UNIV] THEN
      EXISTS_TAC (← q r"\y. drop(integral (:real^M)
                             (\x. lift(norm((f:real^M->real^P) x)))) %
                      lift(norm((g:real^N->real^Q) y))") THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [← GSYM LIFT_CMUL] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIFT_CMUL] THEN
        REWRITE_TAC [LIFT_DROP] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC INTEGRAL_CMUL THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC INTEGRABLE_CMUL THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
                  ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FUBINI_ABSOLUTELY_INTEGRABLE) THEN
    EXPAND_TAC "h" THEN REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
    MP_TAC (← GEN (← q r"x:real^P") (← ISPECL [← q r"g:real^N->real^Q", ← q r"(:real^N)",
                   ← q r"(bop:real^P->real^Q->real^R) x"]
          INTEGRAL_LINEAR)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [bilinear, ETA_AX]) THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, o_DEF] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MP_TAC (← GEN (← q r"y:real^Q") (← ISPECL [← q r"f:real^M->real^P", ← q r"(:real^M)",
                   ← q r"\x. (bop:real^P->real^Q->real^R) x y"]
          INTEGRAL_LINEAR)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [bilinear, ETA_AX]) THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, o_DEF])

  pure { FUBINI_INTEGRAL_SWAP, FUBINI_HAS_INTEGRAL_SWAP, FUBINI_HAS_INTEGRAL_SWAP_ALT,
         FUBINI_INTEGRAL_INTERVAL, FUBINI_INTEGRAL_INTERVAL_ALT,
         INTEGRAL_PASTECART_CONTINUOUS, INTEGRAL_SWAP_CONTINUOUS, FUBINI_TONELLI,
         FUBINI_TONELLI_ALT, HAS_DOUBLE_INTEGRAL_PCROSS }
/- ------------------------------------------------------------------------- -/
/- Some versions of Fubini where we stay in a fixed space R^n.             -/
/- (measure.ml 29886-30245)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDI where
  FUBINI_NEGLIGIBLE_REPLACEMENTS : thm
  FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT : thm
  FUBINI_NEGLIGIBLE_OFFSET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDI [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMSE : MSE) (BMST : MST) (BMSAM : MSAM) (BMSBB : MSBB) (BMSDC : MSDC) (BMSDD : MSDD) : ExceptT String IO MSDI := do
  -- @@SCOPE BEGIN
  let { NOT_NEGLIGIBLE_UNIV, .. } := BMSC
  let { NEGLIGIBLE_TRANSLATION_EQ, .. } := BMSE
  let { NEGLIGIBLE_LINEAR_IMAGE_EQ, .. } := BMST
  let { LEBESGUE_MEASURABLE_UNIV, .. } := BMSAM
  let { LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, .. } := BMSBB
  let { NEGLIGIBLE_PCROSS, .. } := BMSDC
  let { FUBINI_TONELLI_NEGLIGIBLE, FUBINI_TONELLI_NEGLIGIBLE_ALT,
        LEBESGUE_MEASURABLE_PCROSS, .. } := BMSDD
  let { ORTHOGONAL_TRANSFORMATION_EXISTS, ORTHOGONAL_TRANSFORMATION_INVERSE_o,
        .. } := D.qdet
  let { NEGLIGIBLE_EMPTY, .. } := D.qintegration3
  let { swap, .. } := D.qpermutations
  let { IMAGE_LIFT_UNIV, .. } := D.qvec
  let { fstcart, pastecart, .. } := D.ig.qsession
  let { DROP_BASIS, .. } := D.ig.dv.qvec
  let { I_DEF, PASTECART_FST_SND, .. } := D.ig.dv.dg.qsession
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { CART_EQ, COND_RAND, DIMINDEX_1, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1, EQ_IMP,
        EXISTS_REFL, EXTENSION, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_PASTECART, FUN_EQ_THM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_ELIM_THM, IN_UNIV, LAMBDA_BETA, LE_REFL, LEFT_IMP_EXISTS_THM,
        PASTECART_IN_PCROSS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_EQ_0, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_SYM, RIGHT_FORALL_IMP_THM,
        SIMPLE_IMAGE_GEN, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SURJECTIVE_IMAGE_EQ, .. } := D.ig.dv.dg.pt.cvx.core6
  let { BASIS_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, LIFT_DROP, LINEAR_ADD, LINEAR_CMUL, LINEAR_SCALING,
        NORM_BASIS, NORM_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, linear, VECTOR_ADD_COMPONENT, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LCANCEL, VECTOR_MUL_LID, VECTOR_MUL_RZERO,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { ORTHOGONAL_TRANSFORMATION_INJECTIVE, ORTHOGONAL_TRANSFORMATION_LINEAR,
        .. } := D.ig.dv.dg.pt.cvx.det
  -- @@SCOPE END

  let FUBINI_NEGLIGIBLE_REPLACEMENTS ← (do
    let lemma0 ← prove
     r"!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
               ==> linear((\x. lambda k. x$swap(i,j)k):real^N->real^N)"
     (SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                LAMBDA_BETA])
    let lemma1 ← prove
     r"!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
             ==> ((\x. lambda k. x$swap(i,j)k):real^N->real^N) o
                 ((\x. lambda k. x$swap(i,j)k):real^N->real^N) = I"
     (SIMP_TAC [CART_EQ, FUN_EQ_THM, o_THM, I_THM, LAMBDA_BETA] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [swap] THEN
      REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA]))
    let lemma2 ← prove
     r"!i j s. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
               ==> (negligible
                     (IMAGE ((\x. lambda k. x$swap(i,j)k):real^N->real^N) s) <=>
                    negligible s)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LINEAR_IMAGE_EQ THEN
      ASM_SIMP_TAC [lemma0] THEN
      MATCH_MP_TAC (← MESON [] (← q r"(!x. n(n x) = x) ==> !x y. n x = n y ==> x = y")) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [o_DEF, FUN_EQ_THM, I_DEF] lemma1])
    let lemma3 ← prove
     r"!s. negligible s <=> negligible(s PCROSS (:real^1))"
     (REWRITE_TAC [NEGLIGIBLE_PCROSS, NOT_NEGLIGIBLE_UNIV])
    let lemma4 ← prove
     r"!s:real^(N,1)finite_sum->bool.
        lebesgue_measurable s
        ==> (negligible s <=>
             negligible {lift a |
                          ~negligible { x:real^(N,1)finite_sum |
                                    (lambda i. if i = dimindex(:N) + 1 then a
                                               else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP FUBINI_TONELLI_NEGLIGIBLE_ALT) THEN
      AP_TERM_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [SIMPLE_IMAGE_GEN] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      CONJ_TAC THENL [MESON_TAC [LIFT_DROP], X_GEN_TAC (← q r"y:real")] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [lemma3] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"z:real^1"] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      SIMP_TAC [CART_EQ, pastecart, DIMINDEX_FINITE_SUM,
                DIMINDEX_1, LAMBDA_BETA] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"i = dimindex(:N) + 1") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(n + 1 <= n) /\ (n + 1) - n = 1")] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC)
    let lemma5 ← prove
     r"!k s:real^(N,1)finite_sum->bool.
        lebesgue_measurable s /\ 1 <= k /\ k <= dimindex(:N)
        ==> (negligible s <=>
             negligible { lift a |
                          ~negligible { x:real^(N,1)finite_sum |
                                   (lambda i. if i = k then a else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"k:num", ← q r"dimindex(:N) + 1"]
       (← HolLight.INST_TYPE [(← qty "(N,1)finite_sum", ← qty "N")] lemma2)) THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
       [REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th]))] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma4 o lhand o snd) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN THEN
        ASM_REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC lemma0 THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        DISCH_THEN SUBST1_TAC] THEN
      AP_TERM_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"a:real") THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← MESON []
         (← q r"(!x. f(f x) = x) ==> (!y. P y ==> ?x. f x = y)")) THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] lemma1) THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^(N,1)finite_sum") THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. f(f x) = x) /\ (f a IN s <=> Q)  ==> (a IN IMAGE f s <=> Q)")) THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] lemma1) THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        AP_THM_TAC THEN AP_TERM_TAC] THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN X_GEN_TAC (← q r"i:num") THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"i:num = k") THEN ASM_REWRITE_TAC [swap] THEN
      (W (MP_TAC o PART_MATCH (lhs o rand) LAMBDA_BETA o lhand o snd) THEN
       REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
       ANTS_TAC THENL
        [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC THEN SIMP_TAC []]) THEN
      COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) LAMBDA_BETA o lhand o snd) THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
      AP_TERM_TAC THEN ASM_ARITH_TAC)
    prove
     r"!k s:real^N->bool.
      lebesgue_measurable s
      ==> (negligible s <=>
           negligible { lift a |
                        ~negligible { x:real^N |
                                  (lambda i. if i = k then a else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THENL
       [GEN_REWRITE_TAC LAND_CONV [lemma3] THEN
        MP_TAC (← ISPECL [← q r"k:num", ← q r"(s:real^N->bool) PCROSS (:real^1)"]
            lemma5) THEN
        ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_PCROSS, LEBESGUE_MEASURABLE_UNIV] THEN
        DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"a:real") THEN
        AP_TERM_TAC THEN GEN_REWRITE_TAC RAND_CONV [lemma3] THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM, FORALL_PASTECART] THEN
        REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV] THEN REPEAT GEN_TAC THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM PASTECART_FST_SND] THEN
        REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV, IN_ELIM_THM] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [fstcart, CART_EQ, LAMBDA_BETA,
                  DIMINDEX_FINITE_SUM, DIMINDEX_1, pastecart,
                  ← ARITH_RULE (← q r"i <= n ==> i <= n + 1")],
        SUBGOAL_THEN
         (← q r"!a x. (lambda i. if i = k then a else x$i):real^N = x")
         (fun th => REWRITE_TAC [th])
        THENL [SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN ASM_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [← SET_RULE
         (← q r"{lift a | p} = if p then IMAGE lift UNIV else {}")] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN
        REWRITE_TAC [IMAGE_LIFT_UNIV, NOT_NEGLIGIBLE_UNIV, NEGLIGIBLE_EMPTY] THEN
        ASM_CASES_TAC (← q r"negligible(s:real^N->bool)") THEN
        ASM_REWRITE_TAC [← SET_RULE (← q r"{x | x IN s} = s")]]))

  let FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT ← (do
    let lemma0 ← prove
     r"!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
               ==> linear((\x. lambda k. x$swap(i,j)k):real^N->real^N)"
     (SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                LAMBDA_BETA])
    let lemma1 ← prove
     r"!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
             ==> ((\x. lambda k. x$swap(i,j)k):real^N->real^N) o
                 ((\x. lambda k. x$swap(i,j)k):real^N->real^N) = I"
     (SIMP_TAC [CART_EQ, FUN_EQ_THM, o_THM, I_THM, LAMBDA_BETA] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [swap] THEN
      REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA]))
    let lemma2 ← prove
     r"!i j s. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
               ==> (negligible
                     (IMAGE ((\x. lambda k. x$swap(i,j)k):real^N->real^N) s) <=>
                    negligible s)"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LINEAR_IMAGE_EQ THEN
      ASM_SIMP_TAC [lemma0] THEN
      MATCH_MP_TAC (← MESON [] (← q r"(!x. n(n x) = x) ==> !x y. n x = n y ==> x = y")) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [o_DEF, FUN_EQ_THM, I_DEF] lemma1])
    let lemma3 ← prove
     r"!s. negligible s <=> negligible(s PCROSS (:real^1))"
     (REWRITE_TAC [NEGLIGIBLE_PCROSS, NOT_NEGLIGIBLE_UNIV])
    let lemma4 ← prove
     r"!s:real^(N,1)finite_sum->bool.
        lebesgue_measurable s
        ==> (negligible s <=>
             negligible { x:real^(N,1)finite_sum |
                          ~negligible { lift a |
                                    (lambda i. if i = dimindex(:N) + 1 then a
                                               else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP FUBINI_TONELLI_NEGLIGIBLE) THEN
      GEN_REWRITE_TAC LAND_CONV [lemma3] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"z:real^1"] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [SIMPLE_IMAGE_GEN] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      CONJ_TAC THENL [MESON_TAC [LIFT_DROP], X_GEN_TAC (← q r"y:real")] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      SIMP_TAC [CART_EQ, pastecart, DIMINDEX_FINITE_SUM,
                DIMINDEX_1, LAMBDA_BETA] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"i = dimindex(:N) + 1") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(n + 1 <= n) /\ (n + 1) - n = 1")] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN ASM_ARITH_TAC)
    let lemma5 ← prove
     r"!k s:real^(N,1)finite_sum->bool.
        lebesgue_measurable s /\ 1 <= k /\ k <= dimindex(:N)
        ==> (negligible s <=>
             negligible { x:real^(N,1)finite_sum |
                          ~negligible { lift a |
                                   (lambda i. if i = k then a else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"k:num", ← q r"dimindex(:N) + 1"]
       (← HolLight.INST_TYPE [(← qty "(N,1)finite_sum", ← qty "N")] lemma2)) THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
       [REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        DISCH_THEN (fun th => tactic_of do pure (ONCE_REWRITE_TAC [← GSYM th]))] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma4 o lhand o snd) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN THEN
        ASM_REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC lemma0 THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        DISCH_THEN SUBST1_TAC] THEN
      AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← MESON []
         (← q r"(!x. f(f x) = x) ==> (!y. P y ==> ?x. f x = y)")) THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] lemma1) THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^(N,1)finite_sum") THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"a:real") THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. f(f x) = x) /\ (f a IN s <=> Q)  ==> (a IN IMAGE f s <=> Q)")) THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] lemma1) THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ASM_ARITH_TAC,
        AP_THM_TAC THEN AP_TERM_TAC] THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN X_GEN_TAC (← q r"i:num") THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"i:num = k") THEN ASM_REWRITE_TAC [swap] THEN
      (W (MP_TAC o PART_MATCH (lhs o rand) LAMBDA_BETA o lhand o snd) THEN
       REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
       ANTS_TAC THENL
        [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC THEN SIMP_TAC []]) THEN
      COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) LAMBDA_BETA o lhand o snd) THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
      AP_TERM_TAC THEN ASM_ARITH_TAC)
    prove
     r"!k s:real^N->bool.
      lebesgue_measurable s
      ==> (negligible s <=>
           negligible { x:real^N |
                        ~negligible { lift a |
                                  (lambda i. if i = k then a else x$i) IN s}})"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THENL
       [ONCE_REWRITE_TAC [lemma3] THEN
        MP_TAC (← ISPECL [← q r"k:num", ← q r"(s:real^N->bool) PCROSS (:real^1)"]
            lemma5) THEN
        ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_PCROSS, LEBESGUE_MEASURABLE_UNIV] THEN
        DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN REPEAT GEN_TAC THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
        GEN_TAC THEN GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
         [← GSYM PASTECART_FST_SND] THEN
        REWRITE_TAC [PASTECART_IN_PCROSS, IN_UNIV] THEN
        AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [fstcart, CART_EQ, LAMBDA_BETA,
                  DIMINDEX_FINITE_SUM, DIMINDEX_1, pastecart,
                  ← ARITH_RULE (← q r"i <= n ==> i <= n + 1")],
        SUBGOAL_THEN
         (← q r"!a x. (lambda i. if i = k then a else x$i):real^N = x")
         (fun th => REWRITE_TAC [th])
        THENL [SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN ASM_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [← SET_RULE
         (← q r"{lift a | p} = if p then IMAGE lift UNIV else {}")] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN
        REWRITE_TAC [IMAGE_LIFT_UNIV, NOT_NEGLIGIBLE_UNIV, NEGLIGIBLE_EMPTY] THEN
        AP_TERM_TAC THEN SET_TAC []]))

  let FUBINI_NEGLIGIBLE_OFFSET ← prove
   r"!s v:real^N.
        lebesgue_measurable s
        ==> (negligible s <=>
             negligible { x | ~negligible {t | (x + drop t % v) IN s}})"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"v:real^N = vec 0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID] THEN
      REWRITE_TAC [← SET_RULE (← q r"{a | P} = if P then UNIV else {}")] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN
      REWRITE_TAC [NOT_NEGLIGIBLE_UNIV, NEGLIGIBLE_EMPTY] THEN
      AP_TERM_TAC THEN SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"norm(v:real^N) % basis 1:real^N", ← q r"v:real^N"]
          ORTHOGONAL_TRANSFORMATION_EXISTS) THEN
    SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
    REWRITE_TAC [REAL_ABS_NORM, REAL_MUL_RID, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:real^N->real^N") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_LINEAR) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_INVERSE_o) THEN
    REWRITE_TAC [FUN_EQ_THM, o_THM, I_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^N->real^N") THEN STRIP_TAC THEN
     FIRST_ASSUM (ASSUME_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_LINEAR) THEN
    MP_TAC (← ISPECL [← q r"1", ← q r"IMAGE (g:real^N->real^N) s"]
          FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT) THEN
    ASM_SIMP_TAC [LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN, LE_REFL] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [ASM_MESON_TAC [NEGLIGIBLE_LINEAR_IMAGE_EQ,
                     ORTHOGONAL_TRANSFORMATION_INJECTIVE],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. {t | (x + drop t % v:real^N) IN s} =
          {t | ((g:real^N->real^N) x + (drop t * norm(v)) % basis 1) IN
               IMAGE g s}")
     (fun th => ONCE_REWRITE_TAC [th])
    THENL
     [X_GEN_TAC (← q r"x:real^N") THEN MATCH_MP_TAC (← SET_RULE
       (← q r"(!t. f(b t) = a t) /\ (!x. f(g x) = x) /\ (!y. g(f y) = y)
        ==> {t | a t IN s} = {t | b t IN IMAGE g s}")) THEN
      ASM_SIMP_TAC [LINEAR_ADD] THEN ASM_MESON_TAC [LINEAR_CMUL, VECTOR_MUL_ASSOC],
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM DROP_CMUL)]] THEN
    SUBGOAL_THEN
     (← q r"!P. {t:real^1 | P(norm(v:real^N) % t)} =
          IMAGE (\x. inv(norm v) % x) {t | P(t)}")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"y:real^1") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"norm(v:real^N) % y:real^1"),
        ALL_TAC] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_RINV,
                    NORM_EQ_0, VECTOR_MUL_LID],
      ALL_TAC] THEN
    ASM_SIMP_TAC [NEGLIGIBLE_LINEAR_IMAGE_EQ, VECTOR_MUL_LCANCEL,
                  NORM_EQ_0, REAL_INV_EQ_0, LINEAR_SCALING] THEN
    SUBGOAL_THEN
     (← q r"!P. {x | P(g x)} = IMAGE (f:real^N->real^N) {x | P x}")
    MP_TAC THENL [ASM SET_TAC [], SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic)] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) NEGLIGIBLE_LINEAR_IMAGE_EQ o
      rand o snd) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_INJECTIVE],
      DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN
     (← q r"!s x. {t | (x + drop t % basis 1) IN s} =
            IMAGE (\y. --(x$1 % basis 1) + y)
                  {t | ((lambda i. if i = 1 then drop t else x$i):real^N) IN s}")
     (fun th => ONCE_REWRITE_TAC [th])
    THENL
     [REPEAT GEN_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [EXISTS_REFL, ← VECTOR_ARITH
       (← q r"--a + x:real^N = y <=> x = y + a")] THEN
      GEN_TAC THEN REWRITE_TAC [IN_ELIM_THM, DROP_ADD, DROP_NEG] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      SIMP_TAC [CART_EQ, VECTOR_ADD_COMPONENT, LAMBDA_BETA, DROP_CMUL, DROP_BASIS,
                VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"k = 1") THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      REWRITE_TAC [NEGLIGIBLE_TRANSLATION_EQ]] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [SIMPLE_IMAGE_GEN] THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
    REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN
    MESON_TAC [LIFT_DROP])

  pure { FUBINI_NEGLIGIBLE_REPLACEMENTS, FUBINI_NEGLIGIBLE_REPLACEMENTS_ALT,
         FUBINI_NEGLIGIBLE_OFFSET }
