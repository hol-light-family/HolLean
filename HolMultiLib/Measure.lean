          REWRITE_TAC [← GSYM real_div] THEN
          ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &1 + abs x")] THEN
          GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
          ASM_SIMP_TAC [REAL_LE_RMUL_EQ] THEN REAL_ARITH_TAC]],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HAS_MEASURE_LIMIT] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HAS_MEASURE_MEASURE]) THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_MEASURE_LIMIT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / (&1 + abs m)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &1 + abs x")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*"))) THEN
    MP_TAC (← ISPEC (← q r"ball(vec 0:real^N,B)") BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [BOUNDED_BALL, LEFT_IMP_EXISTS_THM] THEN
    REMOVE_THEN "*" MP_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"c:real^N") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"d:real^N") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"interval[c:real^N,d]", ← q r"vec 0:real^N"]
      BOUNDED_SUBSET_BALL) THEN
    REWRITE_TAC [BOUNDED_INTERVAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"f:real^N->real^N") LINEAR_BOUNDED_POS) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN

    EXISTS_TAC (← q r"D * C:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"s INTER (IMAGE (h:real^N->real^N) (interval[a,b]))")) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:real^N->real^N) (s INTER IMAGE h (interval [a,b])) =
    (IMAGE f s) INTER interval[a,b]")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [BOUNDED_INTER, BOUNDED_LINEAR_IMAGE, BOUNDED_INTERVAL] THEN
      ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_LINEAR_IMAGE_INTERVAL],
      ALL_TAC] THEN
    DISCH_TAC THEN EXISTS_TAC
     (← q r"m * measure(s INTER (IMAGE (h:real^N->real^N) (interval[a,b])))") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"m * e / (&1 + abs m)") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [real_div, REAL_MUL_ASSOC] THEN REWRITE_TAC [← GSYM real_div] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &1 + abs x")] THEN
      GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [REAL_LT_RMUL_EQ] THEN REAL_ARITH_TAC] THEN
    REWRITE_TAC [← GSYM REAL_SUB_LDISTRIB, REAL_ABS_MUL] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [real_abs] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"abs(z - m) < e ==> z <= w /\ w <= m ==> abs(w - m) <= e"))) THEN
    SUBST1_TAC (← SYM (← MATCH_MP MEASURE_UNIQUE
     (← ASSUME (← q r"s INTER interval [c:real^N,d] has_measure z")))) THEN
    CONJ_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_LINEAR_IMAGE_INTERVAL,
                  MEASURABLE_INTERVAL, INTER_SUBSET] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!v. t SUBSET v /\ v SUBSET u ==> s INTER t SUBSET s INTER u")) THEN
    EXISTS_TAC (← q r"ball(vec 0:real^N,D)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!f. (!x. h(f x) = x) /\ IMAGE f s SUBSET t ==> s SUBSET IMAGE h t")) THEN
    EXISTS_TAC (← q r"f:real^N->real^N") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(vec 0:real^N,D * C)") THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_BALL_0] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"C * norm(x:real^N)") THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [REAL_LT_LMUL_EQ])

  pure { MEASURABLE_LINEAR_IMAGE_INTERVAL, HAS_MEASURE_LINEAR_SUFFICIENT }

/- ------------------------------------------------------------------------- -/
/- Induction over matrix row operations, elementary matrices and           -/
/- elementary linear maps.  (measure.ml 4256-4580)                          -/
/- ------------------------------------------------------------------------- -/

structure MSQ where
  INDUCT_MATRIX_ROW_OPERATIONS : thm
  INDUCT_MATRIX_ELEMENTARY : thm
  INDUCT_MATRIX_ELEMENTARY_ALT : thm
  INDUCT_LINEAR_ELEMENTARY : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSQ [HolBase] (D : MeasureDeps) : ExceptT String IO MSQ := do
  -- @@SCOPE BEGIN
  let { AND_FORALL_THM, ARITH, CART_EQ, COND_ID, COND_RAND, COND_RATOR, CONJ_ASSOC,
        DE_MORGAN_THM, EQ_IMP, EQ_SYM_EQ, EQ_TRANS, ETA_AX, FINITE_RULES, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_NUMSEG, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_FORALL,
        MONO_IMP, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, REAL_ADD_RID, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { num_INDUCTION, o_DEF, SUM_0, SUM_CLAUSES, SUM_DELTA, SUM_SUPERSET, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { MATRIX_VECTOR_MUL_ASSOC, MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { matrix_mul, matrix_vector_mul, row, VEC_COMPONENT, VECTOR_ADD_COMPONENT,
        VECTOR_MUL_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, REAL_RING, .. } := D.ig.dv.dg.pt.cvx
  let { LE_0, .. } := D.ig.dv.dg.qsession
  let { COND_COMPONENT, .. } := D.ig.qvec
  let { IN_DIMINDEX_SWAP, .. } := D.qdet
  let { swap, SWAP_GALOIS, .. } := D.qpermutations
  let { SUM_EQ_NUMSEG, .. } := D.qsession
  let { mat, .. } := D.qvec
  -- @@SCOPE END

  let INDUCT_MATRIX_ROW_OPERATIONS ← prove
   r"!P:real^N^N->bool.
        (!A i. 1 <= i /\ i <= dimindex(:N) /\ row i A = vec 0 ==> P A) /\
        (!A. (!i j. 1 <= i /\ i <= dimindex(:N) /\
                    1 <= j /\ j <= dimindex(:N) /\ ~(i = j)
                    ==> A$i$j = &0) ==> P A) /\
        (!A m n. P A /\ 1 <= m /\ m <= dimindex(:N) /\
                 1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
                 ==> P(lambda i j. A$i$(swap(m,n) j))) /\
        (!A m n c. P A /\ 1 <= m /\ m <= dimindex(:N) /\
                   1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
                   ==> P(lambda i. if i = m then row m A + c % row n A
                                   else row i A))
        ==> !A. P A"
   (GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "zero_row") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "diagonal") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "swap_cols") (LABEL_TAC "row_op")) THEN
    SUBGOAL_THEN
     (← q r"!k A:real^N^N.
        (!i j. 1 <= i /\ i <= dimindex(:N) /\
               k <= j /\ j <= dimindex(:N) /\ ~(i = j)
               ==> A$i$j = &0)
        ==> P A")
     (fun th => tactic_of do
        pure (GEN_TAC THEN MATCH_MP_TAC th THEN
              EXISTS_TAC (← q r"dimindex(:N) + 1") THEN ARITH_TAC)) THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN USE_THEN "diagonal" MATCH_MP_TAC THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [LE_0],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"k:num") THEN DISCH_THEN (LABEL_TAC "ind_hyp") THEN
    DISJ_CASES_THEN2 SUBST1_TAC ASSUME_TAC (← ARITH_RULE (← q r"k = 0 \/ 1 <= k")) THEN
    ASM_REWRITE_TAC [ARITH] THEN
    ASM_CASES_TAC (← q r"k <= dimindex(:N)") THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN REMOVE_THEN "ind_hyp" MATCH_MP_TAC THEN
      ASM_ARITH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!A:real^N^N.
        ~(A$k$k = &0) /\
        (!i j. 1 <= i /\ i <= dimindex (:N) /\
               SUC k <= j /\ j <= dimindex (:N) /\ ~(i = j)
               ==> A$i$j = &0)
        ==> P A")
    (LABEL_TAC "nonzero_hyp") THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"A:real^N^N") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"row k (A:real^N^N) = vec 0") THENL
       [REMOVE_THEN "zero_row" MATCH_MP_TAC THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
      SIMP_TAC [VEC_COMPONENT, row, LAMBDA_BETA] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"l:num") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"l:num = k") THENL
       [REMOVE_THEN "nonzero_hyp" MATCH_MP_TAC THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      REMOVE_THEN "swap_cols" (MP_TAC o SPECL
       [← q r"(lambda i j. (A:real^N^N)$i$swap(k,l) j):real^N^N",
        ← q r"k:num", ← q r"l:num"]) THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN ANTS_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
        REPEAT STRIP_TAC THEN REWRITE_TAC [swap] THEN
        REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA])] THEN
      REMOVE_THEN "nonzero_hyp" MATCH_MP_TAC THEN
      ONCE_REWRITE_TAC [← ARITH_RULE (← q r"SUC k <= i <=> 1 <= i /\ SUC k <= i")] THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN
      ASM_REWRITE_TAC [swap] THEN MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN
      STRIP_TAC THEN SUBGOAL_THEN (← q r"l:num <= k") ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:num", ← q r"l:num"]) THEN
        ASM_REWRITE_TAC [] THEN ARITH_TAC,
        ALL_TAC] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC] THEN
     SUBGOAL_THEN
     (← q r"!l A:real^N^N.
        ~(A$k$k = &0) /\
        (!i j. 1 <= i /\ i <= dimindex (:N) /\
               SUC k <= j /\ j <= dimindex (:N) /\ ~(i = j)
               ==> A$i$j = &0) /\
        (!i. l <= i /\ i <= dimindex(:N) /\ ~(i = k) ==> A$i$k = &0)
        ==> P A")
     MP_TAC THENL
      [ALL_TAC,
       DISCH_THEN (MP_TAC o SPEC (← q r"dimindex(:N) + 1")) THEN
       REWRITE_TAC [CONJ_ASSOC, ← ARITH_RULE (← q r"~(n + 1 <= i /\ i <= n)")]] THEN
     MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
      [GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
       DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "main") (LABEL_TAC "aux")) THEN
       USE_THEN "ind_hyp" MATCH_MP_TAC THEN
       MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
       ASM_CASES_TAC (← q r"j:num = k") THENL
        [ASM_REWRITE_TAC [] THEN USE_THEN "aux" MATCH_MP_TAC THEN ASM_ARITH_TAC,
         REMOVE_THEN "main" MATCH_MP_TAC THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"l:num") THEN DISCH_THEN (LABEL_TAC "inner_hyp") THEN
    GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "main") (LABEL_TAC "aux")) THEN
    ASM_CASES_TAC (← q r"l:num = k") THENL
     [REMOVE_THEN "inner_hyp" MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN REMOVE_THEN "aux" MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    DISJ_CASES_TAC (← ARITH_RULE (← q r"l = 0 \/ 1 <= l")) THENL
     [REMOVE_THEN "ind_hyp" MATCH_MP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"j:num = k") THENL
       [ASM_REWRITE_TAC [] THEN REMOVE_THEN "aux" MATCH_MP_TAC THEN ASM_ARITH_TAC,
        REMOVE_THEN "main" MATCH_MP_TAC THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"l <= dimindex(:N)") THENL
     [ALL_TAC,
      REMOVE_THEN "inner_hyp" MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC] THEN
    REMOVE_THEN "inner_hyp" (MP_TAC o SPECL
     [← q r"(lambda i. if i = l then row l (A:real^N^N) + --(A$l$k/A$k$k) % row k A
                else row i A):real^N^N"]) THEN
    ANTS_TAC THENL
     [SUBGOAL_THEN (← q r"!i. l <= i ==> 1 <= i") ASSUME_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      ONCE_REWRITE_TAC [← ARITH_RULE (← q r"SUC k <= j <=> 1 <= j /\ SUC k <= j")] THEN
      ASM_SIMP_TAC [LAMBDA_BETA, row, COND_COMPONENT,
                    VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"~(y = &0) ==> x + --(x / y) * y = &0")] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"i:num") THEN
      ASM_CASES_TAC (← q r"i:num = l") THEN ASM_REWRITE_TAC [] THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_RING (← q r"x = &0 /\ y = &0 ==> x + z * y = &0")) THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        REPEAT STRIP_TAC THEN REMOVE_THEN "aux" MATCH_MP_TAC THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    DISCH_TAC THEN REMOVE_THEN "row_op" (MP_TAC o SPECL
     [← q r"(lambda i. if i = l then row l A + --(A$l$k / A$k$k) % row k A
                else row i (A:real^N^N)):real^N^N",
      ← q r"l:num", ← q r"k:num", ← q r"(A:real^N^N)$l$k / A$k$k"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                  VECTOR_MUL_COMPONENT, row, COND_COMPONENT] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let INDUCT_MATRIX_ELEMENTARY ← prove
   r"!P:real^N^N->bool.
        (!A B. P A /\ P B ==> P(A ** B)) /\
        (!A i. 1 <= i /\ i <= dimindex(:N) /\ row i A = vec 0 ==> P A) /\
        (!A. (!i j. 1 <= i /\ i <= dimindex(:N) /\
                    1 <= j /\ j <= dimindex(:N) /\ ~(i = j)
                    ==> A$i$j = &0) ==> P A) /\
        (!m n. 1 <= m /\ m <= dimindex(:N) /\
               1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
               ==> P(lambda i j. (mat 1:real^N^N)$i$(swap(m,n) j))) /\
        (!m n c. 1 <= m /\ m <= dimindex(:N) /\
                 1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
                 ==> P(lambda i j. if i = m /\ j = n then c
                                   else if i = j then &1 else &0))
        ==> !A. P A"
   (GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th =>
      MATCH_MP_TAC INDUCT_MATRIX_ROW_OPERATIONS THEN MP_TAC th) THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (X_GEN_TAC (← q r"A:real^N^N") THEN MP_TAC th)) THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"(P:real^N^N->bool) A") THENL
     [REWRITE_TAC [← GSYM IMP_CONJ], REWRITE_TAC [← GSYM IMP_CONJ_ALT]] THEN
    DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN REWRITE_TAC [CART_EQ] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA, matrix_mul, row] THENL
     [ASM_SIMP_TAC [mat, IN_DIMINDEX_SWAP, LAMBDA_BETA] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN
      SIMP_TAC [SUM_DELTA, REAL_MUL_RZERO, REAL_MUL_RID] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [swap, IN_NUMSEG]) THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"i:num = m") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [REAL_MUL_LZERO] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
      ASM_SIMP_TAC [SUM_DELTA, LAMBDA_BETA, IN_NUMSEG, REAL_MUL_LID]] THEN
    ASM_SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, LAMBDA_BETA] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC
      (← q r"sum {m,n} (\k. (if k = n then c else if m = k then &1 else &0) *
                    (A:real^N^N)$k$j)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_SUPERSET THEN
      ASM_SIMP_TAC [SUBSET, IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM,
                    IN_NUMSEG, REAL_MUL_LZERO] THEN
      ASM_ARITH_TAC,
      ASM_SIMP_TAC [SUM_CLAUSES, FINITE_RULES, IN_INSERT, NOT_IN_EMPTY] THEN
      REAL_ARITH_TAC])

  let INDUCT_MATRIX_ELEMENTARY_ALT ← prove
   r"!P:real^N^N->bool.
        (!A B. P A /\ P B ==> P(A ** B)) /\
        (!A i. 1 <= i /\ i <= dimindex(:N) /\ row i A = vec 0 ==> P A) /\
        (!A. (!i j. 1 <= i /\ i <= dimindex(:N) /\
                    1 <= j /\ j <= dimindex(:N) /\ ~(i = j)
                    ==> A$i$j = &0) ==> P A) /\
        (!m n. 1 <= m /\ m <= dimindex(:N) /\
               1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
               ==> P(lambda i j. (mat 1:real^N^N)$i$(swap(m,n) j))) /\
        (!m n. 1 <= m /\ m <= dimindex(:N) /\
               1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
               ==> P(lambda i j. if i = m /\ j = n \/ i = j then &1 else &0))
        ==> !A. P A"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC INDUCT_MATRIX_ELEMENTARY THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"c = &0") THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        pure (MATCH_MP_TAC th THEN
              MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"])) THEN
      ASM_SIMP_TAC [LAMBDA_BETA, COND_ID],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(lambda i j. if i = m /\ j = n then c else if i = j then &1 else &0) =
  ((lambda i j. if i = j then if j = n then inv c else &1 else &0):real^N^N) **
    ((lambda i j. if i = m /\ j = n \/ i = j then &1 else &0):real^N^N) **
    ((lambda i j. if i = j then if j = n then c else &1 else &0):real^N^N)")
    SUBST1_TAC THENL
     [ALL_TAC,
      REPEAT (MATCH_MP_TAC (← ASSUME (← q r"!A B:real^N^N. P A /\ P B ==> P(A ** B)")) THEN
             CONJ_TAC) THEN
      ASM_SIMP_TAC [] THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MATCH_MP_TAC th THEN
              MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"])) THEN
      ASM_SIMP_TAC [LAMBDA_BETA]] THEN
    SIMP_TAC [CART_EQ, matrix_mul, LAMBDA_BETA] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG, ← REAL_ARITH
         (← q r"(if p then &1 else &0) * (if q then c else &0) =
        if q then if p then c else &0 else &0")] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(if p then x else &0) * y = (if p then x * y else &0)")] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG] THEN
    ASM_CASES_TAC (← q r"i:num = m") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"j:num = n") THEN ASM_REWRITE_TAC [REAL_MUL_LID, EQ_SYM_EQ] THEN
    ASM_CASES_TAC (← q r"i:num = n") THEN
    ASM_SIMP_TAC [REAL_MUL_LINV, REAL_MUL_LID, REAL_MUL_RZERO])

  let INDUCT_LINEAR_ELEMENTARY ← prove
   r"!P. (!f g. linear f /\ linear g /\ P f /\ P g ==> P(f o g)) /\
       (!f i. linear f /\ 1 <= i /\ i <= dimindex(:N) /\ (!x. (f x)$i = &0)
              ==> P f) /\
       (!c. P(\x. lambda i. c i * x$i)) /\
       (!m n. 1 <= m /\ m <= dimindex(:N) /\
              1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
              ==> P(\x. lambda i. x$swap(m,n) i)) /\
       (!m n. 1 <= m /\ m <= dimindex(:N) /\
              1 <= n /\ n <= dimindex(:N) /\ ~(m = n)
              ==> P(\x. lambda i. if i = m then x$m + x$n else x$i))
       ==> !f:real^N->real^N. linear f ==> P f"
   (GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"\A:real^N^N. P(\x:real^N. A ** x):bool")
      INDUCT_MATRIX_ELEMENTARY_ALT) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_IMP THEN CONJ_TAC THENL
     [ALL_TAC,
      DISCH_TAC THEN X_GEN_TAC (← q r"f:real^N->real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"matrix(f:real^N->real^N)")) THEN
      ASM_SIMP_TAC [MATRIX_WORKS] THEN REWRITE_TAC [ETA_AX]] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
     [DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"A:real^N^N", ← q r"B:real^N^N"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\x:real^N. (A:real^N^N) ** x", ← q r"\x:real^N. (B:real^N^N) ** x"]) THEN
      ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR, o_DEF] THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_ASSOC],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
     [DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"A:real^N^N", ← q r"m:num"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\x:real^N. (A:real^N^N) ** x", ← q r"m:num"]) THEN
      ASM_REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      UNDISCH_TAC (← q r"row m (A:real^N^N) = vec 0") THEN
      ASM_SIMP_TAC [CART_EQ, row, LAMBDA_BETA, VEC_COMPONENT, matrix_vector_mul,
                    REAL_MUL_LZERO, SUM_0],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"A:real^N^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\i. (A:real^N^N)$i$i")) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [CART_EQ, matrix_vector_mul, FUN_EQ_THM, LAMBDA_BETA] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"i:num"] THEN STRIP_TAC THEN
      MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"sum(1..dimindex(:N)) (\j. if j = i then (A:real^N^N)$i$j * (x:real^N)$j
                                else &0)") THEN
      CONJ_TAC THENL [ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG], ALL_TAC] THEN
      MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [] THEN COND_CASES_TAC THEN ASM_SIMP_TAC [REAL_MUL_LZERO],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"m:num") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [CART_EQ, matrix_vector_mul, FUN_EQ_THM, LAMBDA_BETA,
                  mat, IN_DIMINDEX_SWAP]
    THENL
     [ONCE_REWRITE_TAC [SWAP_GALOIS] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
      ONCE_REWRITE_TAC [COND_RATOR] THEN
      SIMP_TAC [SUM_DELTA, REAL_MUL_LID, REAL_MUL_LZERO, IN_NUMSEG] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [swap] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"i:num"] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"i:num = m") THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
      ASM_SIMP_TAC [SUM_DELTA, REAL_MUL_LZERO, REAL_MUL_LID, IN_NUMSEG] THEN
      MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"sum {m,n} (\j. if n = j \/ j = m then (x:real^N)$j else &0)") THEN
      CONJ_TAC THENL
       [SIMP_TAC [SUM_CLAUSES, FINITE_RULES, IN_INSERT, NOT_IN_EMPTY] THEN
        ASM_REWRITE_TAC [REAL_ADD_RID],
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN
        ASM_SIMP_TAC [SUBSET, IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM,
                      IN_NUMSEG, REAL_MUL_LZERO] THEN
        ASM_ARITH_TAC]])

  pure { INDUCT_MATRIX_ROW_OPERATIONS, INDUCT_MATRIX_ELEMENTARY,
         INDUCT_MATRIX_ELEMENTARY_ALT, INDUCT_LINEAR_ELEMENTARY }

/- ------------------------------------------------------------------------- -/
/- Coordinate swaps and shears: Galois lemmas and the measure of a sheared -/
/- interval.  (measure.ml 4581-4780)                                        -/
/- ------------------------------------------------------------------------- -/

structure MSR where
  LAMBDA_SWAP_GALOIS : thm
  LAMBDA_ADD_GALOIS : thm
  HAS_MEASURE_SHEAR_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSR [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSJ : MSJ) (BMSP : MSP) : ExceptT String IO MSR := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTER, MEASURABLE_INTERVAL,
        MEASURABLE_UNION, MEASURE_INTERVAL, .. } := BMSA
  let { MEASURE_EQ_0, MEASURE_NEGLIGIBLE_UNION, .. } := BMSB
  let { MEASURE_UNION, .. } := BMSC
  let { MEASURABLE_TRANSLATION_EQ, MEASURE_TRANSLATION, .. } := BMSE
  let { MEASURABLE_CONVEX, NEGLIGIBLE_HYPERPLANE, .. } := BMSJ
  let { MEASURABLE_LINEAR_IMAGE_INTERVAL, .. } := BMSP
  let { CART_EQ, CONJ_ASSOC, EXTENSION, FINITE_DELETE, FINITE_NUMSEG, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IN_DELETE, INTER, .. } := D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNION, LAMBDA_BETA,
        NOT_IN_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_SUB_RZERO, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { BASIS_INJ, DOT_BASIS, DOT_LSUB, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { linear, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_EQ, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_LINEAR_IMAGE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RING, SET_RULE, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { UNION_OVER_INTER, .. } := D.ig.dv.dg.pt.qses
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_HALFSPACE_GE, CONVEX_HALFSPACE_LE, CONVEX_INTER, CONVEX_LINEAR_IMAGE, .. } :=
        D.ig.dv.dg.pt.qcvx2
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { PRODUCT_EQ, .. } := D.ig.qproducts
  let { PRODUCT_CLAUSES, .. } := D.ig.qsession
  let { IN_DIMINDEX_SWAP, .. } := D.qdet
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { NEGLIGIBLE_INTER, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { SWAP_IDEMPOTENT, .. } := D.qpermutations
  -- @@SCOPE END

  let LAMBDA_SWAP_GALOIS ← prove
   r"!x:real^N y:real^N.
        1 <= m /\ m <= dimindex(:N) /\ 1 <= n /\ n <= dimindex(:N)
        ==> (x = (lambda i. y$swap(m,n) i) <=>
             (lambda i. x$swap(m,n) i) = y)"
   (SIMP_TAC [CART_EQ, LAMBDA_BETA, IN_DIMINDEX_SWAP] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"swap(m,n) (i:num)")) THEN
    ASM_SIMP_TAC [IN_DIMINDEX_SWAP] THEN
    ASM_MESON_TAC [← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] SWAP_IDEMPOTENT])

  let LAMBDA_ADD_GALOIS ← prove
   r"!x:real^N y:real^N.
        1 <= m /\ m <= dimindex(:N) /\ 1 <= n /\ n <= dimindex(:N) /\
        ~(m = n)
        ==> (x = (lambda i. if i = m then y$m + y$n else y$i) <=>
             (lambda i. if i = m then x$m - x$n else x$i) = y)"
   (SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
    ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let HAS_MEASURE_SHEAR_INTERVAL ← (do
    let lemma ← prove
     r"!s t u v:real^N->bool.
          measurable s /\ measurable t /\ measurable u /\
          negligible(s INTER t) /\ negligible(s INTER u) /\
          negligible(t INTER u) /\
          s UNION t UNION u = v
          ==> v has_measure (measure s) + (measure t) + (measure u)"
     (REPEAT STRIP_TAC THEN
      ASM_SIMP_TAC [HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_UNION] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [MEASURE_UNION, MEASURABLE_UNION] THEN
      ASM_SIMP_TAC [MEASURE_EQ_0, UNION_OVER_INTER, MEASURE_UNION,
                    MEASURABLE_UNION, NEGLIGIBLE_INTER, MEASURABLE_INTER] THEN
      REAL_ARITH_TAC)
    let lemma' ← prove
     r"!s t u a:real^N.
          measurable s /\ measurable t /\
          s UNION (IMAGE (\x. a + x) t) = u /\
          negligible(s INTER (IMAGE (\x. a + x) t))
          ==> measure s + measure t = measure u"
     (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
      ASM_SIMP_TAC [MEASURE_NEGLIGIBLE_UNION, MEASURABLE_TRANSLATION_EQ,
                    MEASURE_TRANSLATION])
    prove
     r"!a b:real^N m n.
        1 <= m /\ m <= dimindex(:N) /\
        1 <= n /\ n <= dimindex(:N) /\
        ~(m = n) /\ ~(interval[a,b] = {}) /\
        &0 <= a$n
        ==> (IMAGE (\x. (lambda i. if i = m then x$m + x$n else x$i))
                   (interval[a,b]):real^N->bool)
            has_measure measure (interval [a,b])"
     (REWRITE_TAC [INTERVAL_NE_EMPTY] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"linear((\x. lambda i. if i = m then x$m + x$n else x$i):real^N->real^N)")
      ASSUME_TAC THENL
       [ASM_SIMP_TAC [linear, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                      VECTOR_MUL_COMPONENT, CART_EQ] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"IMAGE (\x. lambda i. if i = m then x$m + x$n else x$i)
            (interval[a:real^N,b]):real^N->bool",
        ← q r"interval[a,(lambda i. if i = m then (b:real^N)$m + b$n else b$i)] INTER
       {x:real^N | (basis m - basis n) dot x <= a$m}",
        ← q r"interval[a,(lambda i. if i = m then b$m + b$n else b$i)] INTER
       {x:real^N | (basis m - basis n) dot x >= (b:real^N)$m}",
        ← q r"interval[a:real^N,
              (lambda i. if i = m then (b:real^N)$m + b$n else b$i)]"]
         lemma) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [CONVEX_LINEAR_IMAGE, CONVEX_INTERVAL,
                      CONVEX_HALFSPACE_LE, CONVEX_HALFSPACE_GE,
                      CONVEX_INTER, MEASURABLE_CONVEX, BOUNDED_INTER,
                      BOUNDED_LINEAR_IMAGE, BOUNDED_INTERVAL] THEN
        REWRITE_TAC [INTER] THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_INTER, IN_IMAGE] THEN
        ASM_SIMP_TAC [LAMBDA_ADD_GALOIS, UNWIND_THM1] THEN
        ASM_SIMP_TAC [IN_INTERVAL, IN_ELIM_THM, LAMBDA_BETA,
                      DOT_BASIS, DOT_LSUB] THEN
        ONCE_REWRITE_TAC [← MESON []
           (← q r"(!i:num. P i) <=> P m /\ (!i. ~(i = m) ==> P i)")] THEN
        ASM_SIMP_TAC [] THEN
        REWRITE_TAC [← TAUT (← q r"(p /\ x) /\ (q /\ x) /\ r <=> x /\ p /\ q /\ r"),
                     ← TAUT (← q r"(p /\ x) /\ q /\ (r /\ x) <=> x /\ p /\ q /\ r"),
                     ← TAUT (← q r"((p /\ x) /\ q) /\ (r /\ x) /\ s <=>
                            x /\ p /\ q /\ r /\ s"),
                ← TAUT (← q r"(a /\ x \/ (b /\ x) /\ c \/ (d /\ x) /\ e <=> f /\ x) <=>
                  x ==> (a \/ b /\ c \/ d /\ e <=> f)")] THEN
        ONCE_REWRITE_TAC [← SET_RULE
         (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [ALL_TAC,
          GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"n:num")) THEN
          ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC] THEN
        REWRITE_TAC [← GSYM CONJ_ASSOC] THEN REPEAT CONJ_TAC THEN
        MATCH_MP_TAC NEGLIGIBLE_INTER THEN DISJ2_TAC THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THENL
         [EXISTS_TAC (← q r"{x:real^N | (basis m - basis n) dot x = (a:real^N)$m}"),
          EXISTS_TAC (← q r"{x:real^N | (basis m - basis n) dot x = (b:real^N)$m}"),
          EXISTS_TAC (← q r"{x:real^N | (basis m - basis n) dot x = (b:real^N)$m}")]
        THEN (CONJ_TAC THENL
          [MATCH_MP_TAC NEGLIGIBLE_HYPERPLANE THEN
           REWRITE_TAC [VECTOR_SUB_EQ] THEN
           ASM_MESON_TAC [BASIS_INJ],
           ASM_SIMP_TAC [DOT_LSUB, DOT_BASIS, SUBSET, IN_ELIM_THM,
                         NOT_IN_EMPTY] THEN
           FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:num")) THEN ASM_REWRITE_TAC [] THEN
           ASM_REAL_ARITH_TAC]),
        ALL_TAC] THEN
      ASM_SIMP_TAC [HAS_MEASURE_MEASURABLE_MEASURE,
                    MEASURABLE_LINEAR_IMAGE_INTERVAL,
                    MEASURABLE_INTERVAL] THEN
      MP_TAC (← ISPECL
       [← q r"interval[a,(lambda i. if i = m then (b:real^N)$m + b$n else b$i)] INTER
       {x:real^N | (basis m - basis n) dot x <= a$m}",
        ← q r"interval[a,(lambda i. if i = m then b$m + b$n else b$i)] INTER
       {x:real^N | (basis m - basis n) dot x >= (b:real^N)$m}",
        ← q r"interval[a:real^N,
              (lambda i. if i = m then (a:real^N)$m + b$n
                         else (b:real^N)$i)]",
        ← q r"(lambda i. if i = m then (a:real^N)$m - (b:real^N)$m
                else &0):real^N"]
         lemma') THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [CONVEX_LINEAR_IMAGE, CONVEX_INTERVAL,
                      CONVEX_HALFSPACE_LE, CONVEX_HALFSPACE_GE,
                      CONVEX_INTER, MEASURABLE_CONVEX, BOUNDED_INTER,
                      BOUNDED_LINEAR_IMAGE, BOUNDED_INTERVAL] THEN
        REWRITE_TAC [INTER] THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_INTER, IN_IMAGE] THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = (lambda i. p i) + y <=>
                                   x - (lambda i. p i) = y")] THEN
        ASM_SIMP_TAC [IN_INTERVAL, IN_ELIM_THM, LAMBDA_BETA,
                      DOT_BASIS, DOT_LSUB, UNWIND_THM1,
                      VECTOR_SUB_COMPONENT] THEN
        ONCE_REWRITE_TAC [← MESON []
           (← q r"(!i:num. P i) <=> P m /\ (!i. ~(i = m) ==> P i)")] THEN
        ASM_SIMP_TAC [REAL_SUB_RZERO] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"x:real^N") THEN
          FIRST_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:num")) THEN
          ASM_REWRITE_TAC [] THEN
          ASM_CASES_TAC
           (← q r"!i. ~(i = m)
            ==> 1 <= i /\ i <= dimindex (:N)
                ==> (a:real^N)$i <= (x:real^N)$i /\
                    x$i <= (b:real^N)$i") THEN
          ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
          ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
          ONCE_REWRITE_TAC [← TAUT (← q r"((a /\ b) /\ c) /\ (d /\ e) /\ f <=>
                             (b /\ e) /\ a /\ c /\ d /\ f")] THEN
          ONCE_REWRITE_TAC [← SET_RULE
           (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
          MATCH_MP_TAC NEGLIGIBLE_INTER THEN DISJ2_TAC THEN
          MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
          EXISTS_TAC (← q r"{x:real^N | (basis m - basis n) dot x = (a:real^N)$m}")
          THEN CONJ_TAC THENL
           [MATCH_MP_TAC NEGLIGIBLE_HYPERPLANE THEN
            REWRITE_TAC [VECTOR_SUB_EQ] THEN
            ASM_MESON_TAC [BASIS_INJ],
            ASM_SIMP_TAC [DOT_LSUB, DOT_BASIS, SUBSET, IN_ELIM_THM,
                          NOT_IN_EMPTY] THEN
            FIRST_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
            FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:num")) THEN
            ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]],
        ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"a:real = b + c ==> a = x + b ==> x = c")) THEN
      ASM_SIMP_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES,
                    LAMBDA_BETA] THEN
      REPEAT (COND_CASES_TAC THENL
       [ALL_TAC,
        FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
        MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:num")) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC]) THEN
      SUBGOAL_THEN (← q r"1..dimindex(:N) = m INSERT ((1..dimindex(:N)) DELETE m)")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_INSERT, IN_DELETE, IN_NUMSEG] THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      SIMP_TAC [PRODUCT_CLAUSES, FINITE_DELETE, FINITE_NUMSEG] THEN
      ASM_SIMP_TAC [IN_DELETE] THEN
      MATCH_MP_TAC (← REAL_RING
       (← q r"s1:real = s3 /\ s2 = s3
    ==> ((bm + bn) - am) * s1 =
        ((am + bn) - am) * s2 + (bm - am) * s3")) THEN
      CONJ_TAC THEN MATCH_MP_TAC PRODUCT_EQ THEN
      SIMP_TAC [IN_DELETE] THEN REAL_ARITH_TAC))

  pure { LAMBDA_SWAP_GALOIS, LAMBDA_ADD_GALOIS, HAS_MEASURE_SHEAR_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- The measure of a linear image scales by |det|.  (measure.ml 4781-4933)  -/
/- ------------------------------------------------------------------------- -/

structure MSS where
  HAS_MEASURE_LINEAR_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSS [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSD : MSD) (BMSE : MSE) (BMSJ : MSJ) (BMSP : MSP) (BMSQ : MSQ) (BMSR : MSR) : ExceptT String IO MSS := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_MEASURE, MEASURABLE_INTERVAL,
        MEASURE_INTERVAL, .. } := BMSA
  let { HAS_MEASURE_0, HAS_MEASURE_EMPTY, MEASURE_EMPTY, .. } := BMSB
  let { HAS_MEASURE_STRETCH, .. } := BMSD
  let { HAS_MEASURE_TRANSLATION, MEASURE_TRANSLATION, .. } := BMSE
  let { NEGLIGIBLE_LINEAR_SINGULAR_IMAGE, .. } := BMSJ
  let { HAS_MEASURE_LINEAR_SUFFICIENT, .. } := BMSP
  let { INDUCT_LINEAR_ELEMENTARY, .. } := BMSQ
  let { HAS_MEASURE_SHEAR_INTERVAL, LAMBDA_SWAP_GALOIS, .. } := BMSR
  let { CART_EQ, COND_ID, EQ_IMP, EQ_SYM_EQ, ETA_AX, EXTENSION, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { I_THM, IN_IMAGE, IN_NUMSEG, LAMBDA_BETA, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_RID,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO,
        REAL_POS, REAL_POW_ONE, RIGHT_FORALL_IMP_THM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, UNWIND_THM1, .. } := D.ig.dv.dg.pt.cvx.core6
  let { BASIS_COMPONENT, BASIS_NONZERO, DOT_BASIS, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, MATRIX_COMPOSE, MATRIX_EQ, MATRIX_WORKS, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { linear, matrix_vector_mul, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { DET_I, DET_MUL, .. } := D.ig.dv.dg.pt.cvx.det
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, REAL_ARITH_TAC, VECTOR_ARITH, .. } :=
        D.ig.dv.dg.pt.cvx
  let { INVERTIBLE_DET_NZ, .. } := D.ig.dv.dg.qdet
  let { matrix, transp, .. } := D.ig.dv.qvec
  let { PRODUCT_PERMUTE, .. } := D.ig.qdet
  let { PRODUCT_EQ_NUMSEG, .. } := D.ig.qproducts
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.ig.qtopology
  let { COND_COMPONENT, .. } := D.ig.qvec
  let { DET_DIAGONAL, DET_LOWERTRIANGULAR, DET_PERMUTE_COLUMNS, DET_TRANSP,
        DET_UPPERTRIANGULAR, diagonal_matrix, IN_DIMINDEX_SWAP, .. } := D.qdet
  let { CONTENT_CLOSED_INTERVAL, .. } := D.qintegration1
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { PERMUTES_SWAP, SWAP_IDEMPOTENT, .. } := D.qpermutations
  let { REAL_ABS_SIGN, .. } := D.qsession
  let { basis, INVERTIBLE_LEFT_INVERSE, LINEAR_SINGULAR_INTO_HYPERPLANE, mat,
        MATRIX_LEFT_INVERTIBLE_INJECTIVE, .. } := D.qvec
  -- @@SCOPE END

  let HAS_MEASURE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ measurable s
        ==> (IMAGE f s) has_measure (abs(det(matrix f)) * measure s)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC INDUCT_LINEAR_ELEMENTARY THEN REPEAT CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"IMAGE (g:real^N->real^N) s"))
       (MP_TAC o SPEC (← q r"s:real^N->bool"))) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [HAS_MEASURE_MEASURABLE_MEASURE] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [MATRIX_COMPOSE, DET_MUL, REAL_ABS_MUL] THEN
      REWRITE_TAC [IMAGE_o, ← GSYM REAL_MUL_ASSOC],

      MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"m:num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~(!x y. (f:real^N->real^N) x = f y ==> x = y)")
      ASSUME_TAC THENL
       [ASM_SIMP_TAC [LINEAR_SINGULAR_INTO_HYPERPLANE] THEN
        EXISTS_TAC (← q r"basis m:real^N") THEN
        ASM_SIMP_TAC [BASIS_NONZERO, DOT_BASIS],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"matrix f:real^N^N") INVERTIBLE_DET_NZ) THEN
      ASM_SIMP_TAC [INVERTIBLE_LEFT_INVERSE, MATRIX_LEFT_INVERTIBLE_INJECTIVE,
                    MATRIX_WORKS, REAL_ABS_NUM, REAL_MUL_LZERO] THEN
      DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [HAS_MEASURE_0] THEN
      ASM_SIMP_TAC [NEGLIGIBLE_LINEAR_SINGULAR_IMAGE],

      MAP_EVERY X_GEN_TAC [← q r"c:num->real", ← q r"s:real^N->bool"] THEN
      DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o REWRITE_RULE [HAS_MEASURE_MEASURE]) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"c:num->real") o
       MATCH_MP HAS_MEASURE_STRETCH) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      SIMP_TAC [matrix, LAMBDA_BETA] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) DET_DIAGONAL o rand o snd) THEN
      REWRITE_TAC [diagonal_matrix] THEN
      SIMP_TAC [LAMBDA_BETA, BASIS_COMPONENT, REAL_MUL_RZERO] THEN
      DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC PRODUCT_EQ_NUMSEG THEN
      REWRITE_TAC [REAL_MUL_RID],

      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
      MATCH_MP_TAC HAS_MEASURE_LINEAR_SUFFICIENT THEN
      ASM_SIMP_TAC [linear, LAMBDA_BETA, IN_DIMINDEX_SWAP, VECTOR_ADD_COMPONENT,
                    VECTOR_MUL_COMPONENT, CART_EQ] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
      SUBGOAL_THEN (← q r"matrix (\x:real^N. lambda i. x$swap (m,n) i):real^N^N =
                  transp(lambda i j. (mat 1:real^N^N)$i$swap (m,n) j)")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [MATRIX_EQ, LAMBDA_BETA, IN_DIMINDEX_SWAP,
                      matrix_vector_mul, CART_EQ, matrix, mat, basis,
                      COND_COMPONENT, transp] THEN
        REWRITE_TAC [EQ_SYM_EQ],
        ALL_TAC] THEN
      REWRITE_TAC [DET_TRANSP] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) DET_PERMUTE_COLUMNS o
          rand o lhand o rand o snd) THEN
      ASM_SIMP_TAC [PERMUTES_SWAP, IN_NUMSEG, ETA_AX] THEN
      DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [DET_I, REAL_ABS_SIGN, REAL_MUL_RID, REAL_MUL_LID] THEN
      ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
       [ASM_SIMP_TAC [IMAGE_CLAUSES, HAS_MEASURE_EMPTY, MEASURE_EMPTY],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(IMAGE (\x:real^N. lambda i. x$swap (m,n) i)
              (interval[a,b]):real^N->bool = {})")
      MP_TAC THENL [ASM_REWRITE_TAC [IMAGE_EQ_EMPTY], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"IMAGE (\x:real^N. lambda i. x$swap (m,n) i)
              (interval[a,b]):real^N->bool =
      interval[(lambda i. a$swap (m,n) i),
               (lambda i. b$swap (m,n) i)]")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_INTERVAL, IN_IMAGE] THEN
        ASM_SIMP_TAC [LAMBDA_SWAP_GALOIS, UNWIND_THM1] THEN
        SIMP_TAC [LAMBDA_BETA] THEN GEN_TAC THEN EQ_TAC THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"swap(m,n) (i:num)")) THEN
        ASM_SIMP_TAC [IN_DIMINDEX_SWAP] THEN
        ASM_MESON_TAC [← REWRITE_RULE [FUN_EQ_THM, o_THM, I_THM] SWAP_IDEMPOTENT],
        ALL_TAC] THEN
      REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTERVAL] THEN
      REWRITE_TAC [MEASURE_INTERVAL] THEN
      ASM_SIMP_TAC [CONTENT_CLOSED_INTERVAL, ← GSYM INTERVAL_NE_EMPTY] THEN
      DISCH_THEN (K ALL_TAC) THEN SIMP_TAC [LAMBDA_BETA] THEN
      ASM_SIMP_TAC [← GSYM VECTOR_SUB_COMPONENT, IN_DIMINDEX_SWAP] THEN
      MP_TAC (← ISPECL [← q r"\i. (b - a:real^N)$i", ← q r"swap(m:num,n)",
                        ← q r"1..dimindex(:N)"]
                  (← GSYM PRODUCT_PERMUTE)) THEN
      REWRITE_TAC [o_DEF] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [PERMUTES_SWAP, IN_NUMSEG],

      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
      MATCH_MP_TAC HAS_MEASURE_LINEAR_SUFFICIENT THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [linear, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                      VECTOR_MUL_COMPONENT, CART_EQ] THEN REAL_ARITH_TAC,
        DISCH_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
      SUBGOAL_THEN
        (← q r"det(matrix(\x. lambda i. if i = m then (x:real^N)$m + x$n
                                else x$i):real^N^N) = &1")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [matrix, basis, COND_COMPONENT, LAMBDA_BETA] THEN
        FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
         (← q r"~(m:num = n) ==> m < n \/ n < m")))
        THENL
         [W (MP_TAC o PART_MATCH (lhs o rand) DET_UPPERTRIANGULAR o lhs o snd),
          W (MP_TAC o PART_MATCH (lhs o rand) DET_LOWERTRIANGULAR o lhs o snd)]
        THEN ASM_SIMP_TAC [LAMBDA_BETA, BASIS_COMPONENT, COND_COMPONENT,
                           matrix, REAL_ADD_RID, COND_ID,
                           PRODUCT_CONST_NUMSEG, REAL_POW_ONE] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        REPEAT GEN_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LID] THEN
      ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
       [ASM_SIMP_TAC [IMAGE_CLAUSES, HAS_MEASURE_EMPTY, MEASURE_EMPTY],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"IMAGE (\x. lambda i. if i = m then x$m + x$n else x$i) (interval [a,b]) =
      IMAGE (\x:real^N. (lambda i. if i = m \/ i = n then a$n else &0) +
                        x)
            (IMAGE (\x:real^N. lambda i. if i = m then x$m + x$n else x$i)
                   (IMAGE (\x. (lambda i. if i = n then --(a$n) else &0) + x)
                          (interval[a,b])))")
      SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM IMAGE_o] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        ASM_SIMP_TAC [FUN_EQ_THM, o_THM, VECTOR_ADD_COMPONENT, LAMBDA_BETA,
                      CART_EQ] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"i:num"] THEN
        STRIP_TAC THEN ASM_CASES_TAC (← q r"i:num = m") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"i:num = n") THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC HAS_MEASURE_TRANSLATION THEN
      SUBGOAL_THEN
       (← q r"measure(interval[a,b]) =
      measure(IMAGE (\x:real^N. (lambda i. if i = n then --(a$n) else &0) + x)
                    (interval[a,b]):real^N->bool)")
      SUBST1_TAC THENL [REWRITE_TAC [MEASURE_TRANSLATION], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(IMAGE (\x:real^N. (lambda i. if i = n then --(a$n) else &0) + x)
                    (interval[a,b]):real^N->bool = {})")
      MP_TAC THENL [ASM_SIMP_TAC [IMAGE_EQ_EMPTY], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"c + x:real^N = &1 % x + c")] THEN
      ASM_REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, REAL_POS] THEN
      DISCH_TAC THEN MATCH_MP_TAC HAS_MEASURE_SHEAR_INTERVAL THEN
      ASM_SIMP_TAC [LAMBDA_BETA, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      REAL_ARITH_TAC])

  pure { HAS_MEASURE_LINEAR_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Linear images, orthogonal transformations and isometries; measurable    -/
/- convex sets.  (measure.ml 4934-5185)                                     -/
/- ------------------------------------------------------------------------- -/

structure MST where
  MEASURABLE_LINEAR_IMAGE : thm
  MEASURE_LINEAR_IMAGE : thm
  HAS_MEASURE_LINEAR_IMAGE_ALT : thm
  HAS_MEASURE_LINEAR_IMAGE_SAME : thm
  MEASURE_LINEAR_IMAGE_SAME : thm
  MEASURABLE_LINEAR_IMAGE_EQ : thm
  NEGLIGIBLE_LINEAR_IMAGE : thm
  NEGLIGIBLE_LINEAR_IMAGE_EQ : thm
  MEASURABLE_NEGATIONS : thm
  HAS_MEASURE_ORTHOGONAL_IMAGE : thm
  HAS_MEASURE_ORTHOGONAL_IMAGE_EQ : thm
  MEASURE_ORTHOGONAL_IMAGE_EQ : thm
  MEASURE_NEGATIONS : thm
  HAS_MEASURE_ISOMETRY : thm
  MEASURABLE_LINEAR_IMAGE_EQ_GEN : thm
  MEASURE_ISOMETRY : thm
  MEASURABLE_CONVEX_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMST [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSJ : MSJ) (BMSS : MSS) : ExceptT String IO MST := do
  -- @@SCOPE BEGIN
  let { has_measure, HAS_MEASURE_MEASURABLE_MEASURE, measurable, MEASURABLE_INTERVAL,
        measure, MEASURE_INTERVAL, MEASURE_POS_LE, MEASURE_SUBSET, MEASURE_UNIQUE, .. } :=
        BMSA
  let { HAS_MEASURE_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { MEASURABLE_CONVEX, NEGLIGIBLE_CONVEX_INTERIOR, .. } := BMSJ
  let { HAS_MEASURE_LINEAR_IMAGE, .. } := BMSS
  let { ARITH, CART_EQ, COND_ID, DE_MORGAN_THM, DIMINDEX_GE_1, EQ_IMP, EQ_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_o, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { LAMBDA_BETA, LE_REFL, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, MONO_IMP,
        NOT_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD, REAL_LE_DIV, REAL_LE_LT, REAL_LE_MUL, REAL_LT_IMP_LE, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RZERO, REAL_POS, REAL_SUB_RZERO, SUBSET, SUBSET_TRANS, .. }
        := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { BASIS_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, LINEAR_COMPOSE, NORM_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { dot, linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { DET_ORTHOGONAL_MATRIX, ORTHOGONAL_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_LINEAR,
        ORTHOGONAL_TRANSFORMATION_MATRIX, .. } := D.ig.dv.dg.pt.cvx.det
  let { INTERIOR_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERIOR, .. } := D.ig.dv.dg.pt.cvx.top5
  let { add_linear_invariants, ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, basic_ss,
        GEN_GEOM_ORIGIN_TAC, GEN_SIMPLIFY_CONV, GEOM_BASIS_MULTIPLE_TAC,
        LINEAR_INVARIANT_RULE, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RING, TOP_DEPTH_SQCONV, VECTOR_ARITH_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { LINEAR_NEGATION, .. } := D.ig.dv.dg.pt.qvec
  let { RELATIVE_INTERIOR_NONEMPTY_INTERIOR, .. } := D.ig.dv.dg.qconvex
  let { I_DEF, .. } := D.ig.dv.dg.qsession
  let { PRODUCT_POS_LE_NUMSEG, PRODUCT_POS_LT_NUMSEG, .. } := D.ig.qproducts
  let { IMAGE_I, .. } := D.ig.qsession
  let { RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAYS, .. } := D.qconvex
  let { ORTHOGONAL_TRANSFORMATION_INVERSE_o, ORTHOGONAL_TRANSFORMATION_NEGATION, .. } :=
        D.qdet
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { HAS_INTEGRAL_TWIZZLE_EQ, .. } := D.qintegration2
  let { PRODUCT_CLAUSES_LEFT, .. } := D.qproducts
  let { PERMUTES_I, .. } := D.qpermutations
  let { SUM_EQ_NUMSEG, .. } := D.qsession
  let { OPEN_CONTAINS_INTERVAL, .. } := D.qtopology2
  -- @@SCOPE END

  let MEASURABLE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ measurable s ==> measurable(IMAGE f s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_LINEAR_IMAGE) THEN
    SIMP_TAC [HAS_MEASURE_MEASURABLE_MEASURE])

  let MEASURE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ measurable s
        ==> measure(IMAGE f s) = abs(det(matrix f)) * measure s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_LINEAR_IMAGE) THEN
    SIMP_TAC [HAS_MEASURE_MEASURABLE_MEASURE])

  let HAS_MEASURE_LINEAR_IMAGE_ALT ← prove
   r"!f:real^N->real^N s m.
        linear f /\ s has_measure m
        ==> (IMAGE f s) has_measure (abs(det(matrix f)) * m)"
   (MESON_TAC [MEASURE_UNIQUE, measurable, HAS_MEASURE_LINEAR_IMAGE])

  let HAS_MEASURE_LINEAR_IMAGE_SAME ← prove
   r"!f s. linear f /\ measurable s /\ abs(det(matrix f)) = &1
         ==> (IMAGE f s) has_measure (measure s)"
   (MESON_TAC [HAS_MEASURE_LINEAR_IMAGE, REAL_MUL_LID])

  let MEASURE_LINEAR_IMAGE_SAME ← prove
   r"!f:real^N->real^N s.
        linear f /\ measurable s /\ abs(det(matrix f)) = &1
        ==> measure(IMAGE f s) = measure s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_LINEAR_IMAGE_SAME) THEN
    SIMP_TAC [HAS_MEASURE_MEASURABLE_MEASURE])

  let MEASURABLE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (measurable (IMAGE f s) <=> measurable s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE MEASURABLE_LINEAR_IMAGE))

  add_linear_invariants [MEASURABLE_LINEAR_IMAGE_EQ]

  let NEGLIGIBLE_LINEAR_IMAGE ← prove
   r"!f:real^N->real^N s. linear f /\ negligible s ==> negligible(IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM HAS_MEASURE_0] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HAS_MEASURE_LINEAR_IMAGE_ALT) THEN
    REWRITE_TAC [REAL_MUL_RZERO])

  let NEGLIGIBLE_LINEAR_IMAGE_EQ ← prove
   r"!f:real^N->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (negligible (IMAGE f s) <=> negligible s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE NEGLIGIBLE_LINEAR_IMAGE))

  add_linear_invariants [NEGLIGIBLE_LINEAR_IMAGE_EQ]

  let MEASURABLE_NEGATIONS ← prove
   r"!s:real^N->bool. measurable(IMAGE (--) s) <=> measurable s"
   (GEN_TAC THEN MATCH_MP_TAC MEASURABLE_LINEAR_IMAGE_EQ THEN
    REWRITE_TAC [LINEAR_NEGATION] THEN VECTOR_ARITH_TAC)

  let HAS_MEASURE_ORTHOGONAL_IMAGE ← prove
   r"!f:real^N->real^N s m.
        orthogonal_transformation f /\ s has_measure m
        ==> (IMAGE f s) has_measure m"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_LINEAR) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_LINEAR_IMAGE_ALT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    MATCH_MP_TAC (← REAL_RING (← q r"x = &1 ==> x * m = m")) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs x = &1 <=> x = &1 \/ x = -- &1")] THEN
    MATCH_MP_TAC DET_ORTHOGONAL_MATRIX THEN
    ASM_MESON_TAC [ORTHOGONAL_TRANSFORMATION_MATRIX])

  let HAS_MEASURE_ORTHOGONAL_IMAGE_EQ ← prove
   r"!f:real^N->real^N s m.
        orthogonal_transformation f
        ==> ((IMAGE f s) has_measure m <=> s has_measure m)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [HAS_MEASURE_ORTHOGONAL_IMAGE] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_INVERSE_o) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^N") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
     REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_ORTHOGONAL_IMAGE) THEN
    ASM_SIMP_TAC [← GSYM IMAGE_o, IMAGE_I])

  add_linear_invariants
   [← REWRITE_RULE [ORTHOGONAL_TRANSFORMATION] HAS_MEASURE_ORTHOGONAL_IMAGE_EQ]

  let MEASURE_ORTHOGONAL_IMAGE_EQ ← prove
   r"!f:real^N->real^N s.
        orthogonal_transformation f
        ==> measure(IMAGE f s) = measure s"
   (SIMP_TAC [measure, HAS_MEASURE_ORTHOGONAL_IMAGE_EQ])

  add_linear_invariants
   [← REWRITE_RULE [ORTHOGONAL_TRANSFORMATION] MEASURE_ORTHOGONAL_IMAGE_EQ]

  let MEASURE_NEGATIONS ← prove
   r"!s:real^N->bool. measure(IMAGE (--) s) = measure s"
   (SIMP_TAC [MEASURE_ORTHOGONAL_IMAGE_EQ, ORTHOGONAL_TRANSFORMATION_NEGATION])

  let HAS_MEASURE_ISOMETRY ← prove
   r"!f:real^M->real^N s m.
        dimindex(:M) = dimindex(:N) /\ linear f /\ (!x. norm(f x) = norm x)
        ==> (IMAGE f s has_measure m <=> s has_measure m)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"IMAGE ((\x. lambda i. x$i):real^N->real^M) (IMAGE (f:real^M->real^N) s)
    has_measure m") THEN
    CONJ_TAC THENL
     [SPEC_TAC (← q r"IMAGE (f:real^M->real^N) s", ← q r"s:real^N->bool") THEN GEN_TAC THEN
      CONV_TAC SYM_CONV THEN REWRITE_TAC [has_measure] THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
          HAS_INTEGRAL_TWIZZLE_EQ o lhand o snd) THEN
      REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      ONCE_ASM_REWRITE_TAC [] THEN REWRITE_TAC [← GSYM I_DEF, PERMUTES_I],
      REWRITE_TAC [← GSYM IMAGE_o] THEN
      MATCH_MP_TAC HAS_MEASURE_ORTHOGONAL_IMAGE_EQ THEN
      ASM_REWRITE_TAC [ORTHOGONAL_TRANSFORMATION, o_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC LINEAR_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                  VECTOR_MUL_COMPONENT],
        X_GEN_TAC (← q r"x:real^M") THEN
        TRANS_TAC EQ_TRANS (← q r"norm((f:real^M->real^N) x)") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC []] THEN
        SIMP_TAC [NORM_EQ, dot, LAMBDA_BETA] THEN
        FIRST_ASSUM (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC SUM_EQ_NUMSEG THEN SIMP_TAC [LAMBDA_BETA]]])

  let MEASURABLE_LINEAR_IMAGE_EQ_GEN ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) = dimindex(:N) /\ linear f /\ (!x y. f x = f y ==> x = y)
        ==> (measurable(IMAGE f s) <=> measurable s)"
   (REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"measurable(IMAGE ((\x. lambda i. x$i):real^N->real^M)
                     (IMAGE (f:real^M->real^N) s))") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN REWRITE_TAC [measurable] THEN
      AP_TERM_TAC THEN ABS_TAC THEN MATCH_MP_TAC HAS_MEASURE_ISOMETRY THEN
      ONCE_ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                  VECTOR_MUL_COMPONENT],
        SIMP_TAC [NORM_EQ, dot, LAMBDA_BETA] THEN
        ASM_MESON_TAC []],
      REWRITE_TAC [← GSYM IMAGE_o] THEN
      MATCH_MP_TAC MEASURABLE_LINEAR_IMAGE_EQ THEN CONJ_TAC THENL
       [MATCH_MP_TAC LINEAR_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        SIMP_TAC [linear, CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT,
                  VECTOR_MUL_COMPONENT],
        SIMP_TAC [CART_EQ, LAMBDA_BETA, o_DEF] THEN
        ASM_MESON_TAC [CART_EQ]]])

  let MEASURE_ISOMETRY ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) = dimindex(:N) /\ linear f /\ (!x. norm(f x) = norm x)
        ==> measure (IMAGE f s) = measure s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [measure] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP HAS_MEASURE_ISOMETRY th])))

  let MEASURABLE_CONVEX_EQ ← prove
   r"!s:real^N->bool.
        convex s ==> (measurable s <=> bounded s \/ interior s = {})"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interior s:real^N->bool = {}") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_CONVEX_INTERIOR, NEGLIGIBLE_IMP_MEASURABLE],
      EQ_TAC THEN ASM_SIMP_TAC [MEASURABLE_CONVEX]] THEN
    DISCH_TAC THEN GEN_REWRITE_TAC I [← TAUT (← q r"p <=> ~ ~ p")] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool")
          RELATIVE_INTERIOR_UNBOUNDED_CONVEX_CONTAINS_RAYS) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, RELATIVE_INTERIOR_NONEMPTY_INTERIOR] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"l:real^N") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN GEOM_BASIS_MULTIPLE_TAC 1 (← q r"l:real^N") THEN
    X_GEN_TAC (← q r"l:real") THEN ASM_CASES_TAC (← q r"l = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, DE_MORGAN_THM] THEN
    GEN_REWRITE_TAC LAND_CONV [REAL_LE_LT] THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:real^N")) THEN
    MP_TAC (← ISPEC (← q r"interior s:real^N->bool") OPEN_CONTAINS_INTERVAL) THEN
    REWRITE_TAC [OPEN_INTERIOR] THEN DISCH_THEN (MP_TAC o SPEC (← q r"z:real^N")) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
    REPEAT (POP_ASSUM MP_TAC) THEN GEN_GEOM_ORIGIN_TAC (← q r"u:real^N") ["l"] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"!t. &0 <= t
         ==> measure(interval[vec 0:real^N,
                              (lambda i. if i = 1 then t else (v:real^N)$i)])
             <= measure(s:real^N->bool)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [MEASURABLE_INTERVAL] THEN
      TRANS_TAC SUBSET_TRANS (← q r"interior(s:real^N->bool)") THEN
      REWRITE_TAC [INTERIOR_SUBSET] THEN
      SIMP_TAC [SUBSET, IN_INTERVAL, LAMBDA_BETA, VEC_COMPONENT] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(lambda i. if i = 1 then &0 else (x:real^N)$i):real^N",
        ← q r"(x:real^N)$1 / l:real"]) THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_LT_IMP_LE, DIMINDEX_GE_1, LE_REFL] THEN
      ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
        SIMP_TAC [IN_INTERVAL, LAMBDA_BETA, VEC_COMPONENT] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL]) THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN
        ASM_REWRITE_TAC [VEC_COMPONENT] THEN REAL_ARITH_TAC,
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA, VECTOR_ADD_COMPONENT] THEN
        ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT,
                      ← REAL_FIELD (← q r"&0 < l ==> x / l * l * y = x * y")] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC],
      DISCH_THEN (MP_TAC o SPEC
       (← q r"v$1 * (measure(s:real^N->bool) + &1) /
            measure(interval[vec 0:real^N,v])")) THEN
      SUBGOAL_THEN
       (← q r"!i. 1 <= i /\ i <= dimindex(:N) ==> &0 < (v:real^N)$i")
      ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL]) THEN
        MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
        REWRITE_TAC [VEC_COMPONENT] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
      SIMP_TAC [LAMBDA_BETA, VEC_COMPONENT] THEN
      REWRITE_TAC [← MESON [] (← q r"(&0 <= if p then x else y) <=>
                         if p then &0 <= x else &0 <= y")] THEN
      ASM (fun ths => tactic_of do
        pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
          (← ExceptT.mk (basic_ss [])) 5 ths))))
       [REAL_LE_DIV, REAL_LE_ADD, REAL_POS, MEASURE_POS_LE, REAL_LE_MUL,
        REAL_LE_MUL, MEASURABLE_INTERVAL, DIMINDEX_GE_1, LE_REFL,
        LAMBDA_BETA, VEC_COMPONENT, REAL_LT_IMP_LE,
        PRODUCT_POS_LE_NUMSEG, REAL_SUB_RZERO] THEN
      SIMP_TAC [PRODUCT_CLAUSES_LEFT, DIMINDEX_GE_1, COND_ID] THEN
      SIMP_TAC [ARITH, ← ARITH_RULE (← q r"2 <= n ==> ~(n = 1)")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = y + &1 ==> ~(x <= y)")) THEN
      MATCH_MP_TAC (← REAL_FIELD
       (← q r"&0 < v /\ &0 < p ==> (v * m / (v * p)) * p = m")) THEN
      ASM_SIMP_TAC [DIMINDEX_GE_1, LE_REFL] THEN
      MATCH_MP_TAC PRODUCT_POS_LT_NUMSEG THEN REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_ARITH_TAC])

  pure { MEASURABLE_LINEAR_IMAGE, MEASURE_LINEAR_IMAGE, HAS_MEASURE_LINEAR_IMAGE_ALT,
         HAS_MEASURE_LINEAR_IMAGE_SAME, MEASURE_LINEAR_IMAGE_SAME,
         MEASURABLE_LINEAR_IMAGE_EQ, NEGLIGIBLE_LINEAR_IMAGE, NEGLIGIBLE_LINEAR_IMAGE_EQ,
         MEASURABLE_NEGATIONS, HAS_MEASURE_ORTHOGONAL_IMAGE,
         HAS_MEASURE_ORTHOGONAL_IMAGE_EQ, MEASURE_ORTHOGONAL_IMAGE_EQ, MEASURE_NEGATIONS,
         HAS_MEASURE_ISOMETRY, MEASURABLE_LINEAR_IMAGE_EQ_GEN, MEASURE_ISOMETRY,
         MEASURABLE_CONVEX_EQ }

/- ------------------------------------------------------------------------- -/
/- Measure of a standard simplex.  (measure.ml 5183-5409)                   -/
/- ------------------------------------------------------------------------- -/

structure MSU where
  CONGRUENT_IMAGE_STD_SIMPLEX : thm
  HAS_MEASURE_IMAGE_STD_SIMPLEX : thm
  HAS_MEASURE_STD_SIMPLEX : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSU [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSJ : MSJ) (BMST : MST) : ExceptT String IO MSU := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, MEASURE_INTERVAL, .. } := BMSA
  let { HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE, .. } := BMSB
  let { MEASURABLE_CONVEX, NEGLIGIBLE_HYPERPLANE, .. } := BMSJ
  let { HAS_MEASURE_LINEAR_IMAGE_SAME, .. } := BMST
  let { ADD1, ARITH, CARD_NUMSEG_1, CART_EQ, COND_ID, DIMINDEX_GE_1, EQ_IMP, EQ_TRANS,
        ETA_AX, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, LAMBDA_BETA, LE, LE_REFL, LE_TRANS,
        LT_IMP_LE, LT_REFL, NOT_LE, NOT_LT, REAL_ABS_MUL, REAL_ADD_RID, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ADDR, REAL_LE_ANTISYM, REAL_LE_LT, REAL_LE_REFL, REAL_LE_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RZERO, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_EQ,
        REAL_POW_ONE, REAL_SUB_0, REAL_SUB_LE, REAL_SUB_REFL, REAL_SUB_RZERO,
        RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { num_WOP, numseg, SUM_0, SUM_ADD_NUMSEG, SUM_CLAUSES_LEFT, SUM_CLAUSES_NUMSEG,
        SUM_CONST, SUM_DELTA, SUM_EQ, SUM_LMUL, .. } := D.ig.dv.dg.pt.cvx.core6
  let { BASIS_COMPONENT, DOT_BASIS, DOT_LSUB, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_EQ, ..
        } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_INSERT, .. } := D.ig.dv.dg.pt.cvx.top1
  let { FINITE_IMP_BOUNDED, .. } := D.ig.dv.dg.pt.cvx.top3
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_CONVEX_HULL, .. } := D.ig.dv.dg.pt.qcvx1
  let { CONVEX_CONVEX_HULL, .. } := D.ig.dv.dg.pt.qcvx2
  let { SUB_ADD, .. } := D.ig.dv.dg.qsession
  let { FINITE_PERMUTATIONS, .. } := D.ig.dv.qpermutations
  let { matrix, .. } := D.ig.dv.qvec
  let { PERMUTES_IN_IMAGE, PERMUTES_INVERSE, PERMUTES_INVERSES, .. } := D.ig.qpermutations
  let { LE_LT, TOPOLOGICAL_SORT, .. } := D.ig.qsession
  let { COND_COMPONENT, .. } := D.ig.qvec
  let { STD_SIMPLEX, .. } := D.qconvex
  let { DET_LOWERTRIANGULAR, DET_PERMUTE_ROWS, LAMBDA_BETA_PERM, .. } := D.qdet
  let { CONTENT_UNIT, .. } := D.qintegration1
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { CARD_PERMUTATIONS, permutes, PERMUTES_FINITE_SURJECTIVE, PERMUTES_INJECTIVE,
        PERMUTES_INVERSE_EQ, PERMUTES_SURJECTIVE, .. } := D.qpermutations
  let { FACT_NZ, HAS_SIZE_NUMSEG_1, REAL_ABS_SIGN, SUM_EQ_NUMSEG, SUM_PARTIAL_PRE,
        SUM_SING_NUMSEG, .. } := D.qsession
  let { basis, BASIS_NE, .. } := D.qvec
  -- @@SCOPE END

  let CONGRUENT_IMAGE_STD_SIMPLEX ← prove
   r"!p. p permutes 1..dimindex(:N)
       ==> {x:real^N | &0 <= x$(p 1) /\ x$(p(dimindex(:N))) <= &1 /\
                       (!i. 1 <= i /\ i < dimindex(:N)
                            ==> x$(p i) <= x$(p(i + 1)))} =
           IMAGE (\x:real^N. lambda i. sum(1..inverse p(i)) (\j. x$j))
                 {x | (!i. 1 <= i /\ i <= dimindex (:N) ==> &0 <= x$i) /\
                      sum (1..dimindex (:N)) (\i. x$i) <= &1}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:real^N") THEN
      ASM_SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA, LAMBDA_BETA_PERM, LE_REFL,
                    ← ARITH_RULE (← q r"i < n ==> i <= n /\ i + 1 <= n"),
                    ← ARITH_RULE (← q r"1 <= n + 1"), DIMINDEX_GE_1] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP PERMUTES_INVERSES th])) THEN
      ASM_SIMP_TAC [SUM_SING_NUMSEG, DIMINDEX_GE_1, LE_REFL] THEN
      REWRITE_TAC [← GSYM ADD1, SUM_CLAUSES_NUMSEG, ← ARITH_RULE (← q r"1 <= SUC n")] THEN
      ASM_SIMP_TAC [REAL_LE_ADDR] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(lambda i. if i = 1 then x$(p 1)
                         else (x:real^N)$p(i) - x$p(i - 1)):real^N") THEN
    ASM_SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA, LAMBDA_BETA_PERM, LE_REFL,
                  ← ARITH_RULE (← q r"i < n ==> i <= n /\ i + 1 <= n"),
                  ← ARITH_RULE (← q r"1 <= n + 1"), DIMINDEX_GE_1, CART_EQ] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"1 <= inverse (p:num->num) i /\
                  !x. x <= inverse p i ==> x <= dimindex(:N)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [PERMUTES_INVERSE, IN_NUMSEG, LE_TRANS, PERMUTES_IN_IMAGE],
        ASM_SIMP_TAC [LAMBDA_BETA] THEN ASM_SIMP_TAC [SUM_CLAUSES_LEFT, ARITH]] THEN
      SIMP_TAC [← ARITH_RULE (← q r"2 <= n ==> ~(n = 1)")] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o BINDER_CONV)
                  [← GSYM REAL_MUL_LID] THEN
      ONCE_REWRITE_TAC [SUM_PARTIAL_PRE] THEN
      REWRITE_TAC [REAL_SUB_REFL, REAL_MUL_RZERO, SUM_0, COND_ID] THEN
      REWRITE_TAC [REAL_MUL_LID, ARITH, REAL_SUB_RZERO] THEN
      FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← ARITH_RULE
       (← q r"1 <= p ==> p = 1 \/ 2 <= p")) o CONJUNCT1) THEN
      ASM_SIMP_TAC [ARITH] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP PERMUTES_INVERSES th])) THEN
      REWRITE_TAC [REAL_ADD_RID] THEN TRY REAL_ARITH_TAC THEN
      ASM_MESON_TAC [PERMUTES_INVERSE_EQ, PERMUTES_INVERSE],

      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [REAL_SUB_LE] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i - 1")) THEN
      ASM_SIMP_TAC [SUB_ADD] THEN DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC,

      SIMP_TAC [SUM_CLAUSES_LEFT, DIMINDEX_GE_1, ARITH,
                ← ARITH_RULE (← q r"2 <= n ==> ~(n = 1)")] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV o BINDER_CONV)
                  [← GSYM REAL_MUL_LID] THEN
      ONCE_REWRITE_TAC [SUM_PARTIAL_PRE] THEN
      REWRITE_TAC [REAL_SUB_REFL, REAL_MUL_RZERO, SUM_0, COND_ID] THEN
      REWRITE_TAC [REAL_MUL_LID, ARITH, REAL_SUB_RZERO] THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [REAL_ADD_RID] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"x + y - x:real = y")] THEN
      ASM_MESON_TAC [DIMINDEX_GE_1,
                     ← ARITH_RULE (← q r"1 <= n /\ ~(2 <= n) ==> n = 1")]])

  let HAS_MEASURE_IMAGE_STD_SIMPLEX ← prove
   r"!p. p permutes 1..dimindex(:N)
       ==> {x:real^N | &0 <= x$(p 1) /\ x$(p(dimindex(:N))) <= &1 /\
                       (!i. 1 <= i /\ i < dimindex(:N)
                            ==> x$(p i) <= x$(p(i + 1)))}
           has_measure
           (measure (convex hull
             (vec 0 INSERT {basis i:real^N | 1 <= i /\ i <= dimindex(:N)})))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CONGRUENT_IMAGE_STD_SIMPLEX] THEN
    ASM_SIMP_TAC [← GSYM STD_SIMPLEX] THEN
    MATCH_MP_TAC HAS_MEASURE_LINEAR_IMAGE_SAME THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [linear, CART_EQ] THEN
      ASM_SIMP_TAC [LAMBDA_BETA, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                    ← GSYM SUM_ADD_NUMSEG, ← GSYM SUM_LMUL] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_EQ_NUMSEG THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [],
      MATCH_MP_TAC MEASURABLE_CONVEX THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
      MATCH_MP_TAC BOUNDED_CONVEX_HULL THEN REWRITE_TAC [BOUNDED_INSERT] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      MATCH_MP_TAC FINITE_IMP_BOUNDED THEN MATCH_MP_TAC FINITE_IMAGE THEN
      REWRITE_TAC [← GSYM numseg, FINITE_NUMSEG],
      MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"abs(det
       ((lambda i. ((lambda i j. if j <= i then &1 else &0):real^N^N)
                   $inverse p i)
        :real^N^N))") THEN
      CONJ_TAC THENL
       [AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [CART_EQ] THEN
        ASM_SIMP_TAC [matrix, LAMBDA_BETA, BASIS_COMPONENT, COND_COMPONENT,
                      LAMBDA_BETA_PERM, PERMUTES_INVERSE] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
        EXISTS_TAC (← q r"sum (1..inverse (p:num->num) i)
                      (\k. if k = j then &1 else &0)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC SUM_EQ THEN
          ASM_SIMP_TAC [IN_NUMSEG, PERMUTES_IN_IMAGE, basis] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC LAMBDA_BETA THEN
          ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG, LE_TRANS,
                         PERMUTES_INVERSE],
          ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG]],
        ALL_TAC] THEN
      ASM_SIMP_TAC [PERMUTES_INVERSE, DET_PERMUTE_ROWS, ETA_AX] THEN
      REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_SIGN, REAL_MUL_LID] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = &1 ==> abs x = &1")) THEN
      ASM_SIMP_TAC [DET_LOWERTRIANGULAR, ← GSYM NOT_LT, LAMBDA_BETA] THEN
      REWRITE_TAC [LT_REFL, PRODUCT_CONST_NUMSEG, REAL_POW_ONE]])

  let HAS_MEASURE_STD_SIMPLEX ← (do
    let lemma ← prove
     r"!f:num->real. (!i. 1 <= i /\ i < n ==> f i <= f(i + 1)) <=>
                   (!i j. 1 <= i /\ i <= j /\ j <= n ==> f i <= f j)"
     (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
       [GEN_TAC THEN INDUCT_TAC THEN
        SIMP_TAC [LE, REAL_LE_REFL] THEN
        STRIP_TAC THEN ASM_SIMP_TAC [REAL_LE_REFL] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"(f:num->real) j") THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC x <= y ==> x <= y")] THEN
        REWRITE_TAC [ADD1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC])
    prove
     r"(convex hull (vec 0:real^N INSERT {basis i | 1 <= i /\ i <= dimindex(:N)}))
   has_measure inv(&(FACT(dimindex(:N))))"
     (MP_TAC (← ISPECL
       [← q r"\p. {x:real^N | &0 <= x$(p 1) /\ x$(p(dimindex(:N))) <= &1 /\
                     (!i. 1 <= i /\ i < dimindex(:N)
                          ==> x$(p i) <= x$(p(i + 1)))}",
        ← q r"{p | p permutes 1..dimindex(:N)}"]
        HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE) THEN
      ASM_SIMP_TAC [← REWRITE_RULE [HAS_MEASURE_MEASURABLE_MEASURE]
                                HAS_MEASURE_IMAGE_STD_SIMPLEX, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [SUM_CONST, FINITE_PERMUTATIONS, FINITE_NUMSEG,
                    CARD_PERMUTATIONS, CARD_NUMSEG_1] THEN
      ANTS_TAC THENL
       [MAP_EVERY X_GEN_TAC [← q r"p:num->num", ← q r"q:num->num"] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"?i. i IN 1..dimindex(:N) /\ ~(p i:num = q i)") MP_TAC THENL
         [ASM_MESON_TAC [permutes, FUN_EQ_THM], ALL_TAC] THEN
        GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
        REWRITE_TAC [← TAUT (← q r"a ==> ~(b /\ ~c) <=> a /\ b ==> c")] THEN
        REWRITE_TAC [IN_NUMSEG] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"{x:real^N | (basis(p(k:num)) - basis(q k)) dot x = &0}") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC NEGLIGIBLE_HYPERPLANE THEN REWRITE_TAC [VECTOR_SUB_EQ] THEN
          MATCH_MP_TAC BASIS_NE THEN ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG],
          ALL_TAC] THEN
        REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM, DOT_LSUB, VECTOR_SUB_EQ] THEN
        ASM_SIMP_TAC [DOT_BASIS, ← GSYM IN_NUMSEG, PERMUTES_IN_IMAGE] THEN
        SUBGOAL_THEN (← q r"?l. (q:num->num) l = p(k:num)") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [permutes], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"1 <= l /\ l <= dimindex(:N)") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"k:num < l") ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM NOT_LE] THEN REWRITE_TAC [LE_LT] THEN
          ASM_MESON_TAC [PERMUTES_INJECTIVE, IN_NUMSEG],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?m. (p:num->num) m = q(k:num)") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [permutes], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"1 <= m /\ m <= dimindex(:N)") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"k:num < m") ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM NOT_LE] THEN REWRITE_TAC [LE_LT] THEN
          ASM_MESON_TAC [PERMUTES_INJECTIVE, IN_NUMSEG],
          ALL_TAC] THEN
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [lemma] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:num", ← q r"l:num"]) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:num", ← q r"m:num"]) THEN
        ASM_SIMP_TAC [LT_IMP_LE, IMP_IMP, REAL_LE_ANTISYM, REAL_SUB_0] THEN
        MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
        ASM_MESON_TAC [PERMUTES_IN_IMAGE, IN_NUMSEG, DOT_BASIS],
        ALL_TAC] THEN
      REWRITE_TAC [HAS_MEASURE_MEASURABLE_MEASURE] THEN
      DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_CONVEX THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
        MATCH_MP_TAC BOUNDED_CONVEX_HULL THEN REWRITE_TAC [BOUNDED_INSERT] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        MATCH_MP_TAC FINITE_IMP_BOUNDED THEN MATCH_MP_TAC FINITE_IMAGE THEN
        REWRITE_TAC [← GSYM numseg, FINITE_NUMSEG],
        ALL_TAC] THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"~(y = &0) ==> (x = inv y <=> y * x = &1)"),
                    REAL_OF_NUM_EQ, FACT_NZ] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"measure(interval[vec 0:real^N,vec 1])") THEN CONJ_TAC THENL
       [AP_TERM_TAC, REWRITE_TAC [MEASURE_INTERVAL, CONTENT_UNIT]] THEN
      REWRITE_TAC [lemma] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, FORALL_IN_IMAGE, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM, IN_ELIM_THM] THEN
        SIMP_TAC [IMP_IMP, IN_INTERVAL, LAMBDA_BETA, VEC_COMPONENT] THEN
        X_GEN_TAC (← q r"p:num->num") THEN STRIP_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN
        STRIP_TAC THEN X_GEN_TAC (← q r"i:num") THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_LE_TRANS THENL
         [EXISTS_TAC (← q r"(x:real^N)$(p 1)"),
          EXISTS_TAC (← q r"(x:real^N)$(p(dimindex(:N)))")] THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"i:num") o MATCH_MP PERMUTES_SURJECTIVE) THEN
        ASM_MESON_TAC [LE_REFL, PERMUTES_IN_IMAGE, IN_NUMSEG],
        ALL_TAC] THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIONS(IMAGE f t) <=>
                        !x. x IN s ==> ?y. y IN t /\ x IN f y")] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_INTERVAL, IN_ELIM_THM] THEN
      SIMP_TAC [VEC_COMPONENT] THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"\i j. ~((x:real^N)$j <= x$i)") TOPOLOGICAL_SORT) THEN
      REWRITE_TAC [REAL_NOT_LE, REAL_NOT_LT] THEN
      ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"dimindex(:N)", ← q r"1..dimindex(:N)"]) THEN
      REWRITE_TAC [HAS_SIZE_NUMSEG_1, EXTENSION, IN_IMAGE, IN_NUMSEG] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->num") (CONJUNCTS_THEN2
       (ASSUME_TAC o GSYM) ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"\i. if i IN 1..dimindex(:N) then f(i) else i") THEN
      REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← ARITH_RULE
        (← q r"1 <= i /\ i <= j /\ j <= n <=>
     1 <= i /\ 1 <= j /\ i <= n /\ j <= n /\ i <= j")] THEN
      ASM_SIMP_TAC [IN_NUMSEG, LE_REFL, DIMINDEX_GE_1] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        ASM_MESON_TAC [LE_REFL, DIMINDEX_GE_1, LE_LT, REAL_LE_LT]] THEN
      SIMP_TAC [PERMUTES_FINITE_SURJECTIVE, FINITE_NUMSEG] THEN
      SIMP_TAC [IN_NUMSEG] THEN ASM_MESON_TAC []))

  pure { CONGRUENT_IMAGE_STD_SIMPLEX, HAS_MEASURE_IMAGE_STD_SIMPLEX,
         HAS_MEASURE_STD_SIMPLEX }

/- ------------------------------------------------------------------------- -/
/- Measure of a general simplex; area of a triangle; volume of a           -/
/- tetrahedron.  (measure.ml 5411-5555)                                     -/
/- ------------------------------------------------------------------------- -/

structure MSV where
  HAS_MEASURE_SIMPLEX_0 : thm
  HAS_MEASURE_SIMPLEX : thm
  MEASURABLE_CONVEX_HULL : thm
  MEASURABLE_SIMPLEX : thm
  MEASURE_SIMPLEX : thm
  HAS_MEASURE_TRIANGLE : thm
  MEASURABLE_TRIANGLE : thm
  MEASURE_TRIANGLE : thm
  HAS_MEASURE_TETRAHEDRON : thm
  MEASURABLE_TETRAHEDRON : thm
  MEASURE_TETRAHEDRON : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSV [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSE : MSE) (BMSJ : MSJ) (BMSS : MSS) (BMSU : MSU) : ExceptT String IO MSV := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, .. } := BMSA
  let { HAS_MEASURE_TRANSLATION, .. } := BMSE
  let { MEASURABLE_CONVEX, .. } := BMSJ
  let { HAS_MEASURE_LINEAR_IMAGE, .. } := BMSS
  let { HAS_MEASURE_STD_SIMPLEX, .. } := BMSU
  let { ARITH, CART_EQ, COND_RAND, DIMINDEX_2, DIMINDEX_3, EQ_IMP, EXTENSION, FINITE_IMAGE,
        FINITE_INSERT, FINITE_NUMSEG, FINITE_RULES, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_CLAUSES, IMAGE_o, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, LAMBDA_BETA, NOT_IMP, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_RID, REAL_MUL_RZERO, SIMPLE_IMAGE_GEN, .. } := D.ig.dv.dg.pt.cvx.core5
  let { numseg, o_DEF, real_div, SUM_DELTA, .. } := D.ig.dv.dg.pt.cvx.core6
  let { MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_LINEAR, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_3, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { matrix_vector_mul, VECTOR_ADD_RID, VECTOR_SUB_COMPONENT, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { DET_3, .. } := D.ig.dv.dg.pt.cvx.det
  let { BOUNDED_INSERT, .. } := D.ig.dv.dg.pt.cvx.top1
  let { FINITE_IMP_BOUNDED, .. } := D.ig.dv.dg.pt.cvx.top3
  let { ASM_ARITH_TAC, MESON_TAC, NUM_REDUCE_CONV, SET_RULE, VECTOR_ARITH, .. } :=
        D.ig.dv.dg.pt.cvx
  let { MATRIX_VECTOR_MUL_RZERO, .. } := D.ig.dv.dg.pt.qvec
  let { BOUNDED_CONVEX_HULL, .. } := D.ig.dv.dg.pt.qcvx1
  let { CONVEX_CONVEX_HULL, CONVEX_HULL_LINEAR_IMAGE, CONVEX_HULL_TRANSLATION, .. } :=
        D.ig.dv.dg.pt.qcvx2
  let { VECTOR_2, .. } := D.ig.dv.dg.qvec
  let { transp, .. } := D.ig.dv.qvec
  let { DET_2, DET_TRANSP, .. } := D.qdet
  let { FINITE_SET_OF_LIST, IN_SET_OF_LIST, set_of_list, SET_OF_LIST_MAP, SUC_SUB1, vector,
        .. } := D.qsession
  let { basis, .. } := D.qvec
  let { LENGTH, LENGTH_MAP, MAP, MEM_EXISTS_EL, .. } := D.qlists
  -- @@SCOPE END

  let HAS_MEASURE_SIMPLEX_0 ← prove
   r"!l:(real^N)list.
        LENGTH l = dimindex(:N)
        ==> (convex hull (vec 0 INSERT set_of_list l)) has_measure
            abs(det(vector l)) / &(FACT(dimindex(:N)))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"vec 0 INSERT (set_of_list l) =
        IMAGE (\x:real^N. transp(vector l:real^N^N) ** x)
              (vec 0 INSERT {basis i:real^N | 1 <= i /\ i <= dimindex(:N)})")
    SUBST1_TAC THENL
     [ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [IMAGE_CLAUSES, ← GSYM IMAGE_o, o_DEF] THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_RZERO] THEN AP_TERM_TAC THEN
      SIMP_TAC [matrix_vector_mul, vector, transp, LAMBDA_BETA, basis] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN
      SIMP_TAC [REAL_MUL_RZERO, SUM_DELTA] THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, IN_NUMSEG] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(b /\ c ==> ~a)")] THEN
      X_GEN_TAC (← q r"y:real^N") THEN SIMP_TAC [LAMBDA_BETA, REAL_MUL_RID] THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
      REWRITE_TAC [NOT_IMP, REAL_MUL_RID, ← GSYM CART_EQ] THEN
      ASM_REWRITE_TAC [IN_SET_OF_LIST, MEM_EXISTS_EL] THEN
      EQ_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"i:num") STRIP_ASSUME_TAC) THENL
       [EXISTS_TAC (← q r"SUC i"), EXISTS_TAC (← q r"i - 1")] THEN
      ASM_REWRITE_TAC [SUC_SUB1] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [CONVEX_HULL_LINEAR_IMAGE, MATRIX_VECTOR_MUL_LINEAR] THEN
    SUBGOAL_THEN
     (← q r"det(vector l:real^N^N) = det(matrix(\x:real^N. transp(vector l) ** x))")
    SUBST1_TAC THENL
     [REWRITE_TAC [MATRIX_OF_MATRIX_VECTOR_MUL, DET_TRANSP], ALL_TAC] THEN
    REWRITE_TAC [real_div] THEN
    ASM_SIMP_TAC [← GSYM (← REWRITE_RULE [HAS_MEASURE_MEASURABLE_MEASURE]
                   HAS_MEASURE_STD_SIMPLEX)] THEN
    MATCH_MP_TAC HAS_MEASURE_LINEAR_IMAGE THEN
    REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR] THEN
    MATCH_MP_TAC MEASURABLE_CONVEX THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
    MATCH_MP_TAC BOUNDED_CONVEX_HULL THEN REWRITE_TAC [BOUNDED_INSERT] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    MATCH_MP_TAC FINITE_IMP_BOUNDED THEN MATCH_MP_TAC FINITE_IMAGE THEN
    REWRITE_TAC [← GSYM numseg, FINITE_NUMSEG])

  let HAS_MEASURE_SIMPLEX ← prove
   r"!a l:(real^N)list.
        LENGTH l = dimindex(:N)
        ==> (convex hull (set_of_list(CONS a l))) has_measure
            abs(det(vector(MAP (\x. x - a) l))) / &(FACT(dimindex(:N)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"MAP (\x:real^N. x - a) l") HAS_MEASURE_SIMPLEX_0) THEN
    ASM_REWRITE_TAC [LENGTH_MAP, set_of_list] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o MATCH_MP HAS_MEASURE_TRANSLATION) THEN
    REWRITE_TAC [← GSYM CONVEX_HULL_TRANSLATION] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [IMAGE_CLAUSES, VECTOR_ADD_RID, SET_OF_LIST_MAP] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← VECTOR_ARITH (← q r"a + x - a:real^N = x"),
                 ← SET_RULE (← q r"IMAGE (\x. x) s = s")])

  let MEASURABLE_CONVEX_HULL ← prove
   r"!s. bounded s ==> measurable(convex hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_CONVEX THEN
    ASM_SIMP_TAC [CONVEX_CONVEX_HULL, BOUNDED_CONVEX_HULL])

  let MEASURABLE_SIMPLEX ← prove
   r"!l. measurable(convex hull (set_of_list l))"
   (GEN_TAC THEN MATCH_MP_TAC MEASURABLE_CONVEX_HULL THEN
    MATCH_MP_TAC FINITE_IMP_BOUNDED THEN REWRITE_TAC [FINITE_SET_OF_LIST])

  let MEASURE_SIMPLEX ← prove
   r"!a l:(real^N)list.
        LENGTH l = dimindex(:N)
        ==> measure(convex hull (set_of_list(CONS a l))) =
            abs(det(vector(MAP (\x. x - a) l))) / &(FACT(dimindex(:N)))"
   (MESON_TAC [HAS_MEASURE_SIMPLEX, HAS_MEASURE_MEASURABLE_MEASURE])

  let HAS_MEASURE_TRIANGLE ← prove
   r"!a b c:real^2.
        convex hull {a,b,c} has_measure
        abs((b$1 - a$1) * (c$2 - a$2) - (b$2 - a$2) * (c$1 - a$1)) / &2"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^2", ← q r"[b;c]:(real^2)list"] HAS_MEASURE_SIMPLEX) THEN
    REWRITE_TAC [LENGTH, DIMINDEX_2, ARITH, set_of_list, MAP] THEN
    CONV_TAC NUM_REDUCE_CONV THEN SIMP_TAC [DET_2, VECTOR_2] THEN
    SIMP_TAC [VECTOR_SUB_COMPONENT, DIMINDEX_2, ARITH])

  let MEASURABLE_TRIANGLE ← prove
   r"!a b c:real^N. measurable(convex hull {a,b,c})"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC MEASURABLE_CONVEX THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
    MATCH_MP_TAC BOUNDED_CONVEX_HULL THEN MATCH_MP_TAC FINITE_IMP_BOUNDED THEN
    REWRITE_TAC [FINITE_INSERT, FINITE_RULES])

  let MEASURE_TRIANGLE ← prove
   r"!a b c:real^2.
        measure(convex hull {a,b,c}) =
        abs((b$1 - a$1) * (c$2 - a$2) - (b$2 - a$2) * (c$1 - a$1)) / &2"
   (REWRITE_TAC [← REWRITE_RULE [HAS_MEASURE_MEASURABLE_MEASURE]
                 HAS_MEASURE_TRIANGLE])

  let HAS_MEASURE_TETRAHEDRON ← prove
   r"!a b c d:real^3.
        convex hull {a,b,c,d} has_measure
        abs((b$1 - a$1) * (c$2 - a$2) * (d$3 - a$3) +
            (b$2 - a$2) * (c$3 - a$3) * (d$1 - a$1) +
            (b$3 - a$3) * (c$1 - a$1) * (d$2 - a$2) -
            (b$1 - a$1) * (c$3 - a$3) * (d$2 - a$2) -
            (b$2 - a$2) * (c$1 - a$1) * (d$3 - a$3) -
            (b$3 - a$3) * (c$2 - a$2) * (d$1 - a$1)) /
           &6"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^3", ← q r"[b;c;d]:(real^3)list"] HAS_MEASURE_SIMPLEX) THEN
    REWRITE_TAC [LENGTH, DIMINDEX_3, ARITH, set_of_list, MAP] THEN
    CONV_TAC NUM_REDUCE_CONV THEN SIMP_TAC [DET_3, VECTOR_3] THEN
    SIMP_TAC [VECTOR_SUB_COMPONENT, DIMINDEX_3, ARITH])

  let MEASURABLE_TETRAHEDRON ← prove
   r"!a b c d:real^N. measurable(convex hull {a,b,c,d})"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC MEASURABLE_CONVEX THEN REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
    MATCH_MP_TAC BOUNDED_CONVEX_HULL THEN MATCH_MP_TAC FINITE_IMP_BOUNDED THEN
    REWRITE_TAC [FINITE_INSERT, FINITE_RULES])

  let MEASURE_TETRAHEDRON ← prove
   r"!a b c d:real^3.
        measure(convex hull {a,b,c,d}) =
        abs((b$1 - a$1) * (c$2 - a$2) * (d$3 - a$3) +
            (b$2 - a$2) * (c$3 - a$3) * (d$1 - a$1) +
            (b$3 - a$3) * (c$1 - a$1) * (d$2 - a$2) -
            (b$1 - a$1) * (c$3 - a$3) * (d$2 - a$2) -
            (b$2 - a$2) * (c$1 - a$1) * (d$3 - a$3) -
            (b$3 - a$3) * (c$2 - a$2) * (d$1 - a$1)) / &6"
   (REWRITE_TAC [← REWRITE_RULE [HAS_MEASURE_MEASURABLE_MEASURE]
                 HAS_MEASURE_TETRAHEDRON])

  pure { HAS_MEASURE_SIMPLEX_0, HAS_MEASURE_SIMPLEX, MEASURABLE_CONVEX_HULL,
         MEASURABLE_SIMPLEX, MEASURE_SIMPLEX, HAS_MEASURE_TRIANGLE, MEASURABLE_TRIANGLE,
         MEASURE_TRIANGLE, HAS_MEASURE_TETRAHEDRON, MEASURABLE_TETRAHEDRON,
         MEASURE_TETRAHEDRON }

/- ------------------------------------------------------------------------- -/
/- Measure is continuous with Hausdorff distance; Steinhaus's theorem.     -/
/- (measure.ml 5557-5785)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSW where
  MEASURE_CONTINUOUS_WITH_HAUSDIST : thm
  MEASURE_CONTINUOUS_WITH_HAUSDIST_EXPLICIT : thm
  MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_EXPLICIT : thm
  MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_BOUND : thm
  STEINHAUS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSW [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSG : MSG) (BMSJ : MSJ) (BMSO : MSO) : ExceptT String IO MSW := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_UNION, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURE_EMPTY, NEGLIGIBLE_EQ_MEASURE_0, .. } := BMSB
  let { MEASURE_SUB_LE_MEASURE_DIFF, MEASURE_SUB_LE_MEASURE_SYMDIFF, MEASURE_UNION, .. } :=
        BMSC
  let { MEASURABLE_TRANSLATION_EQ, MEASURE_SCALING, MEASURE_TRANSLATION,
        NOT_MEASURABLE_UNIV, .. } := BMSE
  let { MEASURABLE_COMPACT, MEASURABLE_JORDAN, MEASURE_CLOSURE, .. } := BMSG
  let { MEASURABLE_CONVEX, NEGLIGIBLE_CONVEX_FRONTIER, .. } := BMSJ
  let { MEASURABLE_INNER_COMPACT, MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, DE_MORGAN_THM, EXTENSION, FORALL_IN_GSPEC, .. }
        := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ_ALT, IN_DIFF, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, REAL_ADD_LID, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_POS, REAL_SUB_RZERO, SUBSET, SUBSET_EMPTY,
        SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { UNION_COMM, UNION_SUBSET, UNWIND_THM2, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { dist, VECTOR_MUL_LID, VECTOR_MUL_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EQ_EMPTY, BOUNDED_BALL, BOUNDED_SUBSET, BOUNDED_SUMS, CBALL_SCALING,
        CLOSURE_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_EQ_EMPTY, COMPACT_CBALL, COMPACT_CLOSURE, COMPACT_SUMS,
        CONNECTED_INTER_FRONTIER, CONNECTED_SEGMENT, .. } := D.ig.dv.dg.pt.cvx.top2
  let { DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT, FRONTIER_EQ_EMPTY, HAUSDIST_CLOSURE,
        HAUSDIST_COMPACT_SUMS, HAUSDIST_SYM, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL_0, NOT_BOUNDED_UNIV, .. } := D.ig.dv.dg.pt.cvx.top4
  let { SEPARATE_COMPACT_CLOSED, SETDIST_LE_DIST, SETDIST_POS_LE, SUBSET_CBALL,
        SUBSET_CLOSURE, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEOM_ORIGIN_TAC, NORM_ARITH, REAL_ARITH,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_HAUSDIST_LE_EQ, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_CLOSURE, .. } := D.ig.dv.dg.pt.qcvx2
  let { OPEN_CLOSED, SETDIST_EQ_0_COMPACT_CLOSED, SETDIST_SYM, .. } := D.ig.dv.dg.qtopology2
  let { CONVEX_SUMS_MULTIPLES, .. } := D.qconvex
  let { CONVEX_SYMDIFF_CLOSE_TO_FRONTIER, .. } := D.qpolytope
  let { COMPACT_FRONTIER_BOUNDED, COMPACT_SCALING, .. } := D.qtopology1
  -- @@SCOPE END

  let MEASURE_CONTINUOUS_WITH_HAUSDIST ← prove
   r"!s:real^N->bool e.
        bounded s /\ convex s /\ ~(s = {}) /\ &0 < e
        ==> ?d. &0 < d /\
                !t. bounded t /\ convex t /\ ~(t = {}) /\ hausdist(s,t) < d
                    ==> abs(measure(t) - measure(s)) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"frontier s:real^N->bool", ← q r"e:real"]
      MEASURABLE_OUTER_OPEN) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP NEGLIGIBLE_CONVEX_FRONTIER) THEN
    REWRITE_TAC [NEGLIGIBLE_EQ_MEASURE_0] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, REAL_ADD_LID] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"setdist(frontier s,(:real^N) DIFF u)") THEN CONJ_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
      ASM_SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, COMPACT_FRONTIER_BOUNDED,
                    ← GSYM OPEN_CLOSED, SETDIST_POS_LE, FRONTIER_EQ_EMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF s = {} <=> s = UNIV"), DE_MORGAN_THM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [NOT_BOUNDED_UNIV], ALL_TAC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [NOT_MEASURABLE_UNIV], ASM SET_TAC []],
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"u < e ==> a <= u ==> a < e"))) THEN
      W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_SUB_LE_MEASURE_SYMDIFF o
        lhand o snd) THEN
      ASM_SIMP_TAC [MEASURABLE_CONVEX] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_DIFF, MEASURABLE_CONVEX] THEN
      ONCE_REWRITE_TAC [UNION_COMM] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool",
                       ← q r"setdist(frontier s,(:real^N) DIFF u)"]
          CONVEX_SYMDIFF_CLOSE_TO_FRONTIER) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_BALL_0] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      REWRITE_TAC [← NORM_ARITH (← q r"~(norm(y:real^N) < e) = e <= dist(x,x + y)")] THEN
      MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC []])

  let MEASURE_CONTINUOUS_WITH_HAUSDIST_EXPLICIT ← prove
   r"!s:real^N->bool e.
        bounded s /\ convex s /\ &0 < e
        ==> ?d. &0 < d /\
                !t. convex t /\
                    (!y. y IN s ==> ?x. x IN t /\ dist(x,y) < d) /\
                    (!y. y IN t ==> ?x. x IN s /\ dist(x,y) < d)
                    ==> abs(measure(t) - measure(s)) < e"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"&1") THEN SIMP_TAC [MEASURE_EMPTY] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"e:real"]
      MEASURE_CONTINUOUS_WITH_HAUSDIST) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"d / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"&1") THEN SIMP_TAC [MEASURE_EMPTY] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"{a + b:real^N | a IN s /\ b IN ball(vec 0,d / &2)}") THEN
      ASM_SIMP_TAC [BOUNDED_SUMS, BOUNDED_BALL] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_BALL_0, ← VECTOR_ARITH
       (← q r"x:real^N = a + b <=> b = x - a")] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [UNWIND_THM2] THEN
      ASM_MESON_TAC [dist, DIST_SYM],
      DISCH_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < d /\ x <= d / &2 ==> x < d")) THEN
      ASM_SIMP_TAC [REAL_HAUSDIST_LE_EQ] THEN
      ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TRANS, SETDIST_LE_DIST, IN_SING,
                     DIST_SYM, SETDIST_SYM]])

  let MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_EXPLICIT ← prove
   r"!s:real^N->bool e.
        bounded s /\ negligible(frontier s) /\ &0 < e
        ==> ?d. &0 < d /\
                !s'. measurable s' /\
                     (!y. y IN s' ==> ?x. x IN s /\ dist(x,y) < d)
                     ==> measure(s') < measure(s) + e"
   (REWRITE_TAC [NEGLIGIBLE_EQ_MEASURE_0] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"&1") THEN SIMP_TAC [MEASURE_EMPTY] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"frontier s:real^N->bool", ← q r"e:real"]
      MEASURABLE_OUTER_OPEN) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, REAL_ADD_LID] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"setdist(frontier s,(:real^N) DIFF u)") THEN CONJ_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
      ASM_SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, COMPACT_FRONTIER_BOUNDED,
                    ← GSYM OPEN_CLOSED, SETDIST_POS_LE, FRONTIER_EQ_EMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF s = {} <=> s = UNIV"), DE_MORGAN_THM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [NOT_BOUNDED_UNIV], ALL_TAC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [NOT_MEASURABLE_UNIV], ASM SET_TAC []],

      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"u < e ==> t - s <= u ==> t < s + e"))) THEN
      TRANS_TAC REAL_LE_TRANS (← q r"measure(t DIFF s:real^N->bool)") THEN
      ASM_SIMP_TAC [MEASURE_SUB_LE_MEASURE_DIFF, MEASURABLE_JORDAN,
                    NEGLIGIBLE_EQ_MEASURE_0] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_JORDAN, MEASURABLE_DIFF,
                    NEGLIGIBLE_EQ_MEASURE_0] THEN
      REWRITE_TAC [SUBSET, IN_DIFF] THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"segment[x:real^N,y]", ← q r"s:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN REWRITE_TAC [CONNECTED_SEGMENT] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_DIFF] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [EXISTS_TAC (← q r"y:real^N"), EXISTS_TAC (← q r"x:real^N")] THEN
        ASM_REWRITE_TAC [ENDS_IN_SEGMENT],
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"dist(x:real^N,z) < setdist(frontier s,(:real^N) DIFF u)")
      MP_TAC THENL
       [ASM_MESON_TAC [REAL_LET_TRANS, DIST_IN_CLOSED_SEGMENT, DIST_SYM],
        GEN_REWRITE_TAC I [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        REWRITE_TAC [REAL_NOT_LT] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        MATCH_MP_TAC SETDIST_LE_DIST THEN ASM SET_TAC []]])

  let MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_BOUND ← prove
   r"!s s' r e a:real^N.
        bounded s /\ convex s /\ ball(a,r) SUBSET s /\ &0 < r /\
        bounded s' /\ measurable s' /\ hausdist(s,s') <= e * r /\ &0 < e
        ==> measure(s') <= measure(s) * (&1 + e) pow dimindex(:N)"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s':real^N->bool", ← q r"closure s:real^N->bool"]
          HAUSDIST_COMPACT_SUMS) THEN
    ASM_REWRITE_TAC [HAUSDIST_CLOSURE, COMPACT_CLOSURE, CLOSURE_EQ_EMPTY] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [REAL_NOT_LE, BALL_EQ_EMPTY, SUBSET_EMPTY], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     (← REWRITE_RULE [CONJ_ASSOC] MEASURE_SUBSET))) THEN
    ASM_SIMP_TAC [MEASURABLE_COMPACT, COMPACT_SUMS, COMPACT_CLOSURE,
                  COMPACT_CBALL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"measure {&1 % y + e % z:real^N | y IN closure s /\ z IN closure s}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_COMPACT, COMPACT_SUMS, COMPACT_CLOSURE,
                    COMPACT_CBALL] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE
         (← q r"{a % x + b % y:real^N | x IN s /\ y IN t} =
        {x + y | x IN IMAGE (\x. a % x) s /\ y IN IMAGE (\x. b % x) t}")] THEN
        ASM_SIMP_TAC [MEASURABLE_COMPACT, COMPACT_SUMS, COMPACT_CLOSURE,
                      COMPACT_CBALL, COMPACT_SCALING],
        REWRITE_TAC [VECTOR_MUL_LID] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"t SUBSET IMAGE (\x. e % x) u
        ==> {y + z:real^N | y IN s /\ z IN t} SUBSET
            {y + e % z | y IN s /\ z IN u}")) THEN
        TRANS_TAC SUBSET_TRANS (← q r"IMAGE (\x:real^N. e % x) (cball(vec 0,r))") THEN
        CONJ_TAC THENL
         [ASM_SIMP_TAC [← GSYM CBALL_SCALING, VECTOR_MUL_RZERO] THEN
          MATCH_MP_TAC SUBSET_CBALL THEN ASM_MESON_TAC [HAUSDIST_SYM],
          MATCH_MP_TAC IMAGE_SUBSET THEN
          ASM_SIMP_TAC [← GSYM CLOSURE_BALL, SUBSET_CLOSURE]]],
      ASM_SIMP_TAC [CONVEX_SUMS_MULTIPLES, REAL_POS, REAL_LT_IMP_LE,
                    CONVEX_CLOSURE] THEN
      ASM_SIMP_TAC [MEASURE_SCALING, COMPACT_CLOSURE, MEASURABLE_COMPACT] THEN
      ASM_SIMP_TAC [MEASURE_CLOSURE, NEGLIGIBLE_CONVEX_FRONTIER] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"y * x = a ==> x * y <= a")) THEN
      AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN ASM_REAL_ARITH_TAC])

  let STEINHAUS ← prove
   r"!s:real^N->bool.
        measurable s /\ &0 < measure s
        ==> ?d. &0 < d /\ ball(vec 0,d) SUBSET {x - y | x IN s /\ y IN s}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"measure(s:real^N->bool) / &3"]
      MEASURABLE_INNER_COMPACT) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"measure(s:real^N->bool) / &3"]
      MEASURABLE_OUTER_OPEN) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < x / &3 <=> &0 < x")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"(:real^N) DIFF u"]
      SEPARATE_COMPACT_CLOSED) THEN
    ASM_REWRITE_TAC [← GSYM OPEN_CLOSED] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET, IN_BALL_0, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"v:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~((IMAGE (\x:real^N. v + x) k) INTER k = {})") MP_TAC THENL
     [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE (\x:real^N. v + x) k", ← q r"k:real^N->bool"]
          MEASURE_UNION) THEN
      ASM_REWRITE_TAC [MEASURABLE_TRANSLATION_EQ, MEASURE_EMPTY] THEN
      REWRITE_TAC [MEASURE_TRANSLATION, REAL_SUB_RZERO] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!s:real^N->bool u:real^N->bool.
        measure u < measure s + measure s / &3 /\
        measure s < measure k + measure s / &3 /\
        measure x <= measure u
        ==> ~(measure x = measure k + measure k)")) THEN
      MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"u:real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_TRANSLATION_EQ, MEASURABLE_UNION] THEN
      ASM_REWRITE_TAC [UNION_SUBSET] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"v + x:real^N"]) THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, ← NORM_ARITH
       (← q r"d <= dist(x:real^N,v + x) <=> ~(norm v < d)")],
      REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_IMAGE] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"v:real^N = x - y <=> x = v + y")] THEN
      ASM SET_TAC []])

  pure { MEASURE_CONTINUOUS_WITH_HAUSDIST, MEASURE_CONTINUOUS_WITH_HAUSDIST_EXPLICIT,
         MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_EXPLICIT,
         MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_BOUND, STEINHAUS }

/- ------------------------------------------------------------------------- -/
/- A measurable set with cardinality less than c is negligible; Austin's   -/
/- lemma.  (measure.ml 5786-5969)                                           -/
/- ------------------------------------------------------------------------- -/

structure MSX where
  MEASURABLE_NONNEGLIGIBLE_IMP_LARGE : thm
  MEASURABLE_SMALL_IMP_NEGLIGIBLE : thm
  AUSTIN_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSX [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSW : MSW) : ExceptT String IO MSX := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURABLE_UNION, MEASURE_DISJOINT_UNION, MEASURE_INTERVAL,
        MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS, MEASURE_EMPTY, .. }
        := BMSB
  let { STEINHAUS, .. } := BMSW
  let { AND_FORALL_THM, ARITH, CARD_NUMSEG_1, CARD_PSUBSET, DE_MORGAN_THM, DIMINDEX_GE_1,
        FINITE_DELETE, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT, FINITE_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ_ALT, IMP_IMP, IN_DELETE, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_NUMSEG, LE_1, LEFT_IMP_EXISTS_THM, MONO_FORALL,
        NOT_EXISTS_THM, NOT_IN_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RZERO, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_POW_LT, REAL_POW_MUL, REAL_SUB_LE,
        SUBSET, SUBSET_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core5
  let { pairwise, real_ge, SUP_FINITE, UNIONS_0, UNIONS_INSERT, UNWIND_THM2, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EQ_EMPTY, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_CBALL, COMPACT_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_BALL, IN_CBALL, INTERIOR_CBALL, INTERIOR_CLOSED_INTERVAL, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { UNIT_INTERVAL_NONEMPTY, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
        D.ig.dv.dg.pt.cvx
  let { CONVEX_CBALL, .. } := D.ig.dv.dg.pt.qcvx2
  let { WF_INDUCT_TAC, .. } := D.ig.dv.dg.pt
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { INFINITE, .. } := D.ig.dv.qsession
  let { CARD_LE_TRANS, .. } := D.ig.qcard
  let { PRODUCT_CONST, .. } := D.ig.qproducts
  let { HOMEOMORPHIC_CONVEX_COMPACT, .. } := D.qconvex
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { NEGLIGIBLE_FINITE, .. } := D.qintegration3
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_ANTISYM, CARD_LE_IMAGE, CARD_LE_SUBSET,
        CARD_LE_UNIV, CARD_SQUARE_INFINITE, mul_c, .. } := D.qcard
  let { lt_c, PAIRWISE_EMPTY, REAL_POW_LE2_REV, .. } := D.qsession
  let { CARD_EQ_EUCLIDEAN, .. } := D.qtopology1
  let { HOMEOMORPHIC_IMP_CARD_EQ, HOMEOMORPHIC_OPEN_INTERVAL_UNIV, .. } := D.qtopology2
  let { DISJOINT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let MEASURABLE_NONNEGLIGIBLE_IMP_LARGE ← prove
   r"!s:real^N->bool. measurable s /\ &0 < measure s ==> s =_c (:real)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE(s:real^N->bool)") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_FINITE, MEASURABLE_MEASURE_POS_LT],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP STEINHAUS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      REWRITE_TAC [CARD_LE_UNIV] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      REWRITE_TAC [CARD_EQ_EUCLIDEAN],
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN CONJ_TAC THENL
     [MESON_TAC [CARD_EQ_EUCLIDEAN, CARD_EQ_SYM, CARD_EQ_IMP_LE], ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"interval(vec 0:real^N,vec 1)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      MATCH_MP_TAC HOMEOMORPHIC_IMP_CARD_EQ THEN
      MATCH_MP_TAC HOMEOMORPHIC_OPEN_INTERVAL_UNIV THEN
      REWRITE_TAC [UNIT_INTERVAL_NONEMPTY],
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"interval[vec 0:real^N,vec 1]") THEN
    SIMP_TAC [INTERVAL_OPEN_SUBSET_CLOSED, CARD_LE_SUBSET] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"cball(vec 0:real^N,d / &2)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_IMP_LE THEN
      MATCH_MP_TAC HOMEOMORPHIC_IMP_CARD_EQ THEN
      MATCH_MP_TAC HOMEOMORPHIC_CONVEX_COMPACT THEN
      REWRITE_TAC [CONVEX_INTERVAL, COMPACT_INTERVAL, INTERIOR_CLOSED_INTERVAL,
                   CONVEX_CBALL, COMPACT_CBALL, UNIT_INTERVAL_NONEMPTY,
                   INTERIOR_CBALL, BALL_EQ_EMPTY] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"ball(vec 0:real^N,d)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_LE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"IMAGE (\(x:real^N,y). x - y) (s *_c s)") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [mul_c, CARD_LE_SUBSET, ← SET_RULE
       (← q r"IMAGE f {g x y | P x /\ Q y} = {f(g x y) | P x /\ Q y}")],
      ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"((s:real^N->bool) *_c s)") THEN
    REWRITE_TAC [CARD_LE_IMAGE] THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN MATCH_MP_TAC CARD_SQUARE_INFINITE THEN
    ASM_REWRITE_TAC [INFINITE])

  let MEASURABLE_SMALL_IMP_NEGLIGIBLE ← prove
   r"!s:real^N->bool. measurable s /\ s <_c (:real) ==> negligible s"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b ==> c <=> a ==> ~c ==> ~b")] THEN
    SIMP_TAC [← GSYM MEASURABLE_MEASURE_POS_LT] THEN REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_NONNEGLIGIBLE_IMP_LARGE) THEN
    REWRITE_TAC [lt_c] THEN MESON_TAC [CARD_EQ_IMP_LE, CARD_EQ_SYM])

  let AUSTIN_LEMMA ← prove
   r"!D. FINITE D /\
       (!d. d IN D
            ==> ?k a b. d = interval[a:real^N,b] /\
                        (!i. 1 <= i /\ i <= dimindex(:N) ==> b$i - a$i = k))
       ==> ?D'. D' SUBSET D /\ pairwise DISJOINT D' /\
                measure(UNIONS D') >=
                measure(UNIONS D) / &3 pow (dimindex(:N))"
   (GEN_TAC THEN WF_INDUCT_TAC (← q r"CARD(D:(real^N->bool)->bool)") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
    ASM_CASES_TAC (← q r"D:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [SUBSET_EMPTY, UNWIND_THM2, PAIRWISE_EMPTY] THEN
      REWRITE_TAC [UNIONS_0, real_ge, MEASURE_EMPTY, NOT_IN_EMPTY] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 / x = &0"), REAL_LE_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?d:real^N->bool. d IN D /\ !d'. d' IN D ==> measure d' <= measure d")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"IMAGE measure (D:(real^N->bool)->bool)") SUP_FINITE) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"{c:real^N->bool | c IN (D DELETE d) /\ c INTER d = {}}")) THEN
    ANTS_TAC THENL [MATCH_MP_TAC CARD_PSUBSET THEN ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_DELETE, FINITE_RESTRICT, IN_ELIM_THM, real_ge] THEN
    ANTS_TAC THENL [ASM_SIMP_TAC [IN_DELETE], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D':(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(d:real^N->bool) INSERT D'") THEN REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
      REWRITE_TAC [pairwise, IN_INSERT] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?a3 b3:real^N.
        measure(interval[a3,b3]) = &3 pow dimindex(:N) * measure d /\
        !c. c IN D /\ ~(c INTER d = {}) ==> c SUBSET interval[a3,b3]")
    STRIP_ASSUME_TAC THENL
     [USE_THEN "*" (MP_TAC o SPEC (← q r"d:real^N->bool")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real", ← q r"a:real^N", ← q r"b:real^N"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
      EXISTS_TAC (← q r"inv(&2) % (a + b) - &3 / &2 % (b - a):real^N") THEN
      EXISTS_TAC (← q r"inv(&2) % (a + b) + &3 / &2 % (b - a):real^N") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
                     VECTOR_MUL_COMPONENT] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(x + &3 / &2 * a) - (x - &3 / &2 * a) = &3 * a"),
                     ← REAL_ARITH (← q r"x - a <= x + a <=> &0 <= a")] THEN
        ASM_SIMP_TAC [] THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_LE] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= &3 / &2 * x - &0 <=> &0 <= x")] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MUL_RZERO] THEN
        SIMP_TAC [PRODUCT_CONST, FINITE_NUMSEG, CARD_NUMSEG_1, REAL_POW_MUL],
        X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"k':real", ← q r"a':real^N", ← q r"b':real^N"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE RAND_CONV [DISJOINT_INTERVAL]) THEN
        REWRITE_TAC [NOT_EXISTS_THM, SUBSET_INTERVAL] THEN
        REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
        ASM_CASES_TAC (← q r"1 <= i") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"i <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[a':real^N,b']")) THEN
        ASM_REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
        REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LT] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a$k <= b$k <=> &0 <= b$k - a$k")] THEN
        ASM_SIMP_TAC [IN_NUMSEG] THEN
        ASM_CASES_TAC (← q r"&0 <= k") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"&0 <= k'") THEN ASM_REWRITE_TAC [] THEN
        REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
          pure (SIMP_TAC [th] THEN MP_TAC (← ISPEC (← q r"i:num") th)))) THEN
        ASM_SIMP_TAC [PRODUCT_CONST, CARD_NUMSEG_1, FINITE_NUMSEG] THEN
        DISCH_TAC THEN DISCH_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
         (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")]
          REAL_POW_LE2_REV)) THEN
        ASM_SIMP_TAC [DIMINDEX_GE_1, LE_1] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
                     VECTOR_MUL_COMPONENT] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    REWRITE_TAC [UNIONS_INSERT] THEN
    SUBGOAL_THEN (← q r"!d:real^N->bool. d IN D ==> measurable d") ASSUME_TAC THENL
     [ASM_MESON_TAC [MEASURABLE_INTERVAL], ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DISJOINT_UNION o
      rand o snd) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC MEASURABLE_UNIONS THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        FINITE_SUBSET)) THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, FINITE_DELETE],
      DISCH_THEN SUBST1_TAC] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(interval[a3:real^N,b3]) +
              measure(UNIONS D DIFF interval[a3,b3])") THEN
    CONJ_TAC THENL
     [W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DISJOINT_UNION o
        rand o snd) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [MEASURABLE_UNIONS, MEASURABLE_DIFF,
                      MEASURABLE_INTERVAL] THEN SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC MEASURE_SUBSET THEN REPEAT CONJ_TAC THENL
         [ASM_SIMP_TAC [MEASURABLE_UNIONS],
          ASM_MESON_TAC [MEASURABLE_UNIONS, MEASURABLE_DIFF,
                         MEASURABLE_INTERVAL, MEASURABLE_UNION],
          SET_TAC []]],
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"a * x + y <= (x + z) * a <=> y <= z * a")] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"y <= a ==> x <= y ==> x <= a"))) THEN
      SIMP_TAC [REAL_LE_DIV2_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_UNIONS, MEASURABLE_INTERVAL,
                    IN_ELIM_THM, IN_DELETE, FINITE_DELETE, FINITE_RESTRICT] THEN
      ASM SET_TAC []])

  pure { MEASURABLE_NONNEGLIGIBLE_IMP_LARGE, MEASURABLE_SMALL_IMP_NEGLIGIBLE,
         AUSTIN_LEMMA }

/- ------------------------------------------------------------------------- -/
/- Some differentiability-like properties of the indefinite integral: the  -/
/- one-sided box form.  (measure.ml 5970-6404)                              -/
/- ------------------------------------------------------------------------- -/

structure MSY where
  INTEGRABLE_CCONTINUOUS_EXPLICIT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSY [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSK : MSK) (BMSX : MSX) : ExceptT String IO MSY := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_MEASURE_EQ_0, MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS,
        MEASURE_EMPTY, MEASURE_NEGLIGIBLE_UNIONS_IMAGE, NEGLIGIBLE_INTERVAL, .. } := BMSB
  let { MEASURE_UNIONS_LE, NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_APPROACHABLE, MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. }
        := BMSF
  let { COVERING_LEMMA, .. } := BMSK
  let { AUSTIN_LEMMA, .. } := BMSX
  let { AND_FORALL_THM, ARITH, CARD_NUMSEG_1, CART_EQ, CONJ_ASSOC, DIMINDEX_GE_1,
        EMPTY_SUBSET, EXISTS_IN_IMAGE, EXISTS_SUBSET_IMAGE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_SUBSET, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNIONS, IN_UNIV, LE_1,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_LT, NUMSEG_EMPTY, PAIR_EQ, REAL_ABS_INV, REAL_ARCH_INV, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ,
        REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID,
        REAL_MUL_SYM, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_POW_LT, REAL_POW_MUL, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, real_div, real_ge, SUBSET_UNIV, SUM_BOUND_LT_GEN, SUM_EQ, SUM_RMUL,
        UNIONS_0, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_MUL, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, INTERIOR_SUBSET, LIM_SEQUENTIALLY, OPEN_BALL, OPEN_CONTAINS_BALL, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { ADD_SUB, .. } := D.ig.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { REAL_LE_LCANCEL_IMP, .. } := D.ig.dv.qsession
  let { PRODUCT_MUL_NUMSEG, PRODUCT_POS_LT_NUMSEG, .. } := D.ig.qproducts
  let { SUM_LE_INCLUDED, .. } := D.ig.qsession
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { HENSTOCK_LEMMA, INTEGRABLE_ON_SUBINTERVAL, .. } := D.qintegration2
  let { fine, gauge, NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_EMPTY, NEGLIGIBLE_ON_INTERVALS,
        NEGLIGIBLE_SUBSET, tagged_partial_division_of, .. } := D.qintegration3
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { MONO_NOT, .. } := D.qsession
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let INTEGRABLE_CCONTINUOUS_EXPLICIT ← prove
   r"!f:real^M->real^N.
    (!a b. f integrable_on interval[a,b])
    ==> ?k. negligible k /\
         !x e. ~(x IN k) /\ &0 < e
               ==> ?d. &0 < d /\
                       !h. &0 < h /\ h < d
                           ==> norm(inv(content(interval[x,x + h % vec 1])) %
                                    integral (interval[x,x + h % vec 1]) f -
                                    f(x)) < e"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [IN_UNIV] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"box = \h x. interval[x:real^M,x + h % vec 1]",
      ← q r"box2 = \h x. interval[x:real^M - h % vec 1,x + h % vec 1]",
      ← q r"i = \h:real x:real^M. inv(content(box h x)) %
                      integral (box h x) (f:real^M->real^N)"] THEN
    SUBGOAL_THEN
     (← q r"?k. negligible k /\
        !x e. ~(x IN k) /\ &0 < e
              ==> ?d. &0 < d /\
                      !h. &0 < h /\ h < d
                          ==> norm(i h x - (f:real^M->real^N) x) < e")
    MP_TAC THENL
     [ALL_TAC, MAP_EVERY EXPAND_TAC ["i", "box"] THEN REWRITE_TAC []] THEN
    EXISTS_TAC
     (← q r"{x | ~(!e. &0 < e
              ==> ?d. &0 < d /\
                      !h. &0 < h /\ h < d
                          ==> norm(i h x - (f:real^M->real^N) x) < e)}") THEN
    SIMP_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC
     (← q r"UNIONS {{x | !d. &0 < d
                     ==> ?h. &0 < h /\ h < d /\
                             inv(&k + &1) <= dist(i h x,(f:real^M->real^N) x)}
            |  k IN (:num)}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"e:real"] THEN STRIP_TAC THEN
      REWRITE_TAC [SIMPLE_IMAGE, UNIONS_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_ARCH_INV]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real")) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [dist] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"inv(&k)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      ASM_REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
    X_GEN_TAC (← q r"jj:num") THEN
    SUBGOAL_THEN (← q r"&0 < inv(&jj + &1)") MP_TAC THENL
     [REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      SPEC_TAC (← q r"inv(&jj + &1)", ← q r"mu:real") THEN GEN_TAC THEN DISCH_TAC] THEN
    ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    ASM_CASES_TAC (← q r"negligible(interval[a:real^M,b])") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [NEGLIGIBLE_INTERVAL]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
    REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a - vec 1:real^M",
                     ← q r"b + vec 1:real^M"]
      HENSTOCK_LEMMA) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_ON_SUBINTERVAL, SUBSET_UNIV], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(e * mu) / &2 / &6 pow (dimindex(:M))")) THEN
    ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, REAL_LT_MUL,
                  REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x} INTER s = {x | x IN s /\ P x}")] THEN
    ABBREV_TAC
      (← q r"E = {x | x IN interval[a,b] /\
              !d. &0 < d
                   ==> ?h. &0 < h /\ h < d /\
                           mu <= dist(i h x,(f:real^M->real^N) x)}") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN E
        ==> ?h. &0 < h /\
                (box h x:real^M->bool) SUBSET (g x) /\
                (box h x:real^M->bool) SUBSET interval[a - vec 1,b + vec 1] /\
                mu <= dist(i h x,(f:real^M->real^N) x)")
    MP_TAC THENL
