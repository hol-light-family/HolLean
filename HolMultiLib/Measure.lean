        LIST_OF_SEQ_EQ_NIL, NOT_CONS_NIL, .. } := D.qlists
  let { LE_EXISTS, .. } := D.ig.qsession
  let { ADD_CLAUSES, DEPENDENT_CHOICE, UNIONS_MONO_IMAGE, .. } := D.ig.dv.dg.qsession
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { EQ_IMP, EXISTS_IN_GSPEC, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IN, IN_DIFF, INTER_SUBSET, INTER_UNIONS,
        INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM,
