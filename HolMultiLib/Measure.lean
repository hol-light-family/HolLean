@[nospecialize]
def setupMSBW [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSAB : MSAB) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAK : MSAK) (BMSAM : MSAM) (BMSAO : MSAO) (BMSAP : MSAP) (BMSAQ : MSAQ) (BMSAW : MSAW) (BMSAY : MSAY) (BMSBB : MSBB) (BMSBC : MSBC) (BMSBL : MSBL) (BMSBU : MSBU) (BMSBV : MSBV) : ExceptT String IO MSBW := do
