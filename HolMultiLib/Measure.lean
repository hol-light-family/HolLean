structure MSCQ where
  ABSOLUTELY_CONTINUOUS_INTEGRAL : thm
  ABSOLUTELY_SETCONTINUOUS_INDEFINITE_INTEGRAL : thm
  ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT : thm
  ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_LEFT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCQ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSC : MSC) (BMSG : MSG) (BMSAM : MSAM) (BMSCA : MSCA) : ExceptT String IO MSCQ := do
  -- @@SCOPE BEGIN
  let { INTEGRAL_MEASURE, .. } := BMSA
  let { INTEGRABLE_ON_CONST, .. } := BMSC
  let { MEASURABLE_ELEMENTARY, MEASURE_ELEMENTARY, .. } := BMSG
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET, LEBESGUE_MEASURABLE_INTERVAL,
        LEBESGUE_MEASURABLE_UNIV, MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS, .. } := BMSCA
  let { ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_EQ,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_INTEGRABLE_SUB,
        ABSOLUTELY_SETCONTINUOUS_COMPARISON, ABSOLUTELY_SETCONTINUOUS_ON_ALT,
        .. } := D.qintegration1
  let { INTEGRABLE_ON_SUBINTERVAL, INTEGRAL_ADD, .. } := D.qintegration2
  let { absolutely_continuous_on, INTEGRAL_CMUL, INTEGRAL_COMBINE,
        INTEGRAL_COMBINE_DIVISION_TOPDOWN, INTEGRAL_DROP_LE, INTEGRAL_NORM_BOUND_INTEGRAL,
        INTEGRAL_SUBSET_DROP_LE, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := D.qintegration3
  let { LIFT_EQ_CMUL, NORM_REAL, .. } := D.ig.qvec
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, basic_ss, GEN_SIMPLIFY_CONV, NORM_ARITH,
        REAL_ARITH, SET_TAC, TOP_DEPTH_SQCONV, .. } := D.ig.dv.dg.pt.cvx
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, MONO_EXISTS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_VEC, LIFT_DROP, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, .. } := D.ig.dv.dg.pt.cvx.top1
  let { INTERVAL_NE_EMPTY_1, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let ABSOLUTELY_CONTINUOUS_INTEGRAL ← prove
   r"!f:real^M->real^N s e.
        f absolutely_integrable_on s /\ &0 < e
        ==> ?d. &0 < d /\
                !t. t SUBSET s /\ measurable t /\ measure t < d
                    ==> norm(integral t f) < e"
   (ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. if x IN s then (f:real^M->real^N) x else vec 0",
      ← q r"(:real^M)", ← q r"e / &2"]
     ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS) THEN
    ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV, REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / &2 / B") THEN ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    TRANS_TAC REAL_LET_TRANS
     (← q r"drop(integral t (\x. lift(norm((if x IN s then f x else vec 0) - g x)) +
                           lift(norm((g:real^M->real^N) x))))") THEN
    SUBGOAL_THEN
     (← q r"(g:real^M->real^N) absolutely_integrable_on t /\
      (\x. if x IN s then (f:real^M->real^N) x else vec 0)
      absolutely_integrable_on t")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET THEN
      EXISTS_TAC (← q r"(:real^M)") THEN
      ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, SUBSET_UNIV],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) absolutely_integrable_on t") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          ABSOLUTELY_INTEGRABLE_EQ)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM (fun ths => tactic_of do
        pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
          (← ExceptT.mk (basic_ss [])) 5 ths))))
       [ABSOLUTELY_INTEGRABLE_NORM, ABSOLUTELY_INTEGRABLE_ADD,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_SUB] THEN
      GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [LIFT_DROP, DROP_ADD] THEN
      COND_CASES_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), ASM SET_TAC []],
      ALL_TAC] THEN
    ASM (fun ths => tactic_of do
      pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
        (← ExceptT.mk (basic_ss [])) 5 ths))))
     [ABSOLUTELY_INTEGRABLE_NORM, INTEGRAL_ADD, DROP_ADD,
      ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_SUB] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e")) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"norm(integral s (f:real^M->real^1)) < e / &2
        ==> drop(integral t f) <= norm(integral s f)
             ==> drop(integral t f) < e / &2"))) THEN
      REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> x <= abs y")) THEN
      MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_NORM, IN_UNIV, SUBSET_UNIV, LIFT_DROP,
       ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_SUB] THEN
      REWRITE_TAC [NORM_POS_LE],
      TRANS_TAC REAL_LET_TRANS (← q r"drop(integral t (\x:real^M. lift B))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRAL_DROP_LE THEN
        ASM_SIMP_TAC [LIFT_DROP, ABSOLUTELY_INTEGRABLE_NORM, INTEGRABLE_ON_CONST,
                      ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
        ASM_SIMP_TAC [LIFT_EQ_CMUL, INTEGRAL_CMUL, INTEGRABLE_ON_CONST,
                      INTEGRAL_MEASURE] THEN
        REWRITE_TAC [DROP_CMUL, DROP_VEC, REAL_MUL_RID] THEN
       ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
       ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ]]])

  let ABSOLUTELY_SETCONTINUOUS_INDEFINITE_INTEGRAL ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s /\ lebesgue_measurable s
        ==> (\k. integral k f) absolutely_setcontinuous_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ABSOLUTELY_SETCONTINUOUS_ON_ALT] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"e:real") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] ABSOLUTELY_CONTINUOUS_INTEGRAL)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:real^M->real^N") o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
                 INTEGRAL_COMBINE_DIVISION_TOPDOWN)) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET)) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURABLE_IMP_LEBESGUE_MEASURABLE THEN
      ASM_MESON_TAC [MEASURABLE_ELEMENTARY],
      DISCH_THEN (SUBST1_TAC o SYM) THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_ELEMENTARY],
        ASM_MESON_TAC [MEASURE_ELEMENTARY]]])

  let ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT ← prove
   r"!f:real^1->real^N a b.
        f absolutely_integrable_on interval[a,b]
        ==> (\x. integral(interval[a,x]) f)
            absolutely_continuous_on interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_SETCONTINUOUS_INDEFINITE_INTEGRAL)) THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_INTERVAL] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          ABSOLUTELY_SETCONTINUOUS_COMPARISON) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^1", ← q r"d:real^1"] THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1] THEN
    STRIP_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"y + z:real^N = x ==> norm(x - y) <= norm z")) THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL) o
     MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  let ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_LEFT ← prove
   r"!f:real^1->real^N a b.
        f absolutely_integrable_on interval[a,b]
        ==> (\x. integral(interval[x,b]) f)
            absolutely_continuous_on interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_SETCONTINUOUS_INDEFINITE_INTEGRAL)) THEN
    REWRITE_TAC [LEBESGUE_MEASURABLE_INTERVAL] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          ABSOLUTELY_SETCONTINUOUS_COMPARISON) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^1", ← q r"d:real^1"] THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1] THEN
    STRIP_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"z + x:real^N = y ==> norm(x - y) <= norm z")) THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL) o
     MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  pure { ABSOLUTELY_CONTINUOUS_INTEGRAL, ABSOLUTELY_SETCONTINUOUS_INDEFINITE_INTEGRAL,
         ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT,
         ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_LEFT }
