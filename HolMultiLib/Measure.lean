             UNIONS {IMAGE (g:real^M->real^M)(s m) | m IN 0..n} <=>
             (\x. abs(det(matrix(g' x):real^M^M)) % f(g x))
             absolutely_integrable_on UNIONS {s m | m IN 0..n}) /\
