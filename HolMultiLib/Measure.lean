  LEBESGUE_MEASURABLE_ABSOLUTELY_CONTINUOUS_IMAGE : thm
  ABSOLUTELY_CONTINUOUS_IMP_BANACH_SPROPERTY : thm
  MEASURABLE_ABSOLUTELY_CONTINUOUS_IMAGE : thm
