structure MSAX where
  SUSLIN_LEBESGUE_MEASURABLE : thm
  ANALYTIC_IMP_LEBESGUE_MEASURABLE : thm
  LEBESGUE_MEASURABLE_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC : thm
  LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC_EQ : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_ANALYTIC : thm
  MEASURABLE_ON_PREIMAGE_ANALYTIC : thm
