structure MSBZ where
  ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES : thm
  INTEGRAL_CHANGE_OF_VARIABLES : thm
  HAS_ABSOLUTE_INTEGRAL_CHANGE_OF_VARIABLES_1 : thm
  ABSOLUTELY_INTEGRABLE_CHANGE_OF_VARIABLES_1 : thm
  HAS_MEASURE_DIFFERENTIABLE_IMAGE : thm
  MEASURABLE_DIFFERENTIABLE_IMAGE_EQ : thm
  MEASURABLE_DIFFERENTIABLE_IMAGE_ALT : thm
  MEASURE_DIFFERENTIABLE_IMAGE_EQ : thm
