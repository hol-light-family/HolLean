      REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"n:num") THEN
      SUBGOAL_THEN
       (← q r"UNIONS {IMAGE f (interval[--vec k,vec k] INTER s) | k <= n} =
