  let PAIRWISE_DISJOINT_LEBESGUE_MEASURABLE_IMP_COUNTABLE ← prove
   r"!f:(real^N->bool)->bool.
        pairwise (\s t. negligible (s INTER t)) f /\
        (!s. s IN f ==> lebesgue_measurable s /\ ~negligible s)
        ==> COUNTABLE f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC
     (← q r"UNIONS
       (IMAGE (\(m,n).
          {s | s IN f /\
             inv(&m + &1) < measure(s INTER interval[--vec n:real^N,vec n])})
       ((:num) CROSS (:num)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNIONS THEN
      SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_CROSS, NUM_COUNTABLE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_CROSS, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
      MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN
      MATCH_MP_TAC (← MESON [] (← q r"!n. ~(FINITE s ==> n <= CARD s) ==> FINITE s")) THEN
      EXISTS_TAC (← q r"1 + (m + 1) * (2 * n) EXP dimindex(:N)") THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE
       [← GSYM CONTRAPOS_THM] CHOOSE_SUBSET_STRONG) THEN
      REWRITE_TAC [NOT_EXISTS_THM, SUBSET, HAS_SIZE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"t:(real^N->bool)->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\s. s INTER interval[--vec n:real^N,vec n]",
                        ← q r"t:(real^N->bool)->bool"]
          MEASURE_NEGLIGIBLE_UNIONS_IMAGE) THEN
      ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                    MEASURABLE_INTERVAL, NOT_IMP] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
        REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
        MATCH_MP_TAC MONO_IMP THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
        SET_TAC [],
        MATCH_MP_TAC (← REAL_ARITH (← q r"!z. x <= z /\ z < y ==> ~(x = y)")) THEN
        EXISTS_TAC (← q r"measure(interval[--vec n:real^N,vec n])") THEN CONJ_TAC THENL
         [MATCH_MP_TAC MEASURE_SUBSET THEN REWRITE_TAC [MEASURABLE_INTERVAL] THEN
          CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC []] THEN
          MATCH_MP_TAC MEASURABLE_UNIONS THEN
          ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
          ASM_SIMP_TAC [MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE,
                        MEASURABLE_INTERVAL],
          TRANS_TAC REAL_LET_TRANS
           (← q r"sum (t:(real^N->bool)->bool) (\s. inv(&m + &1))") THEN
          CONJ_TAC THENL
           [ASM_SIMP_TAC [SUM_CONST, MEASURE_INTERVAL, ← GSYM REAL_OF_NUM_MUL,
              ← GSYM REAL_OF_NUM_ADD, CONTENT_CLOSED_INTERVAL_CASES] THEN
            REWRITE_TAC [VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN
            REWRITE_TAC [← REAL_ARITH (← q r"-- &n <= &n /\ x - --x = &2 * x")] THEN
            SIMP_TAC [← REAL_FIELD
             (← q r"(&1 + (&m + &1) * x) * inv(&m + &1) = x + inv(&m + &1)")] THEN
            MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y /\ &0 <= z ==> x <= y + z")) THEN
            REWRITE_TAC [REAL_LE_INV_EQ, ← REAL_ARITH (← q r"&0 <= &m + &1")] THEN
            REWRITE_TAC [PRODUCT_CONST_NUMSEG, REAL_OF_NUM_MUL, REAL_OF_NUM_POW,
                         REAL_OF_NUM_LE, ADD_SUB, LE_REFL],
            MATCH_MP_TAC SUM_LT_ALL THEN ASM_SIMP_TAC [← GSYM CARD_EQ_0] THEN
            REWRITE_TAC [MULT_EQ_0, EXP_EQ_0, ARITH_EQ, ADD_EQ_0]]]],
      REWRITE_TAC [SUBSET, UNIONS_IMAGE] THEN
      X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [EXISTS_PAIR_THM, IN_CROSS, IN_UNIV, IN_ELIM_THM] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
       [NEGLIGIBLE_ON_COUNTABLE_INTERVALS]) THEN
      REWRITE_TAC [NOT_FORALL_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"n:num") THEN
      ASM_SIMP_TAC [← GSYM MEASURABLE_MEASURE_POS_LT, MEASURABLE_INTERVAL,
                    MEASURABLE_LEBESGUE_MEASURABLE_INTER_MEASURABLE] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM ARCH_EVENTUALLY_INV1] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [LE_REFL]])

  let WIENER_COVERING_LEMMA_BALLS ← prove
   r"!k a:A->real^N r s.
        FINITE k /\ s SUBSET UNIONS(IMAGE (\i. ball(a i,r i)) k)
        ==> ?c. c SUBSET k /\
                pairwise (\i j. DISJOINT (ball(a i,r i)) (ball(a j,r j))) c /\
                s SUBSET UNIONS(IMAGE (\i. ball(a i,&3 * r i)) c)"
   (REPLICATE_TAC 3 GEN_TAC THEN WF_INDUCT_TAC (← q r"CARD(k:A->bool)") THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_REWRITE_TAC [PAIRWISE_EMPTY, SUBSET_EMPTY, IMAGE_CLAUSES,
                     FINITE_EMPTY, UNWIND_THM2] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (r:A->real) k") SUP_FINITE) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"n:A") THEN DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(r:A->real) n <= &0") THENL
     [EXISTS_TAC (← q r"{}:A->bool") THEN
      ASM_REWRITE_TAC [PAIRWISE_EMPTY, EMPTY_SUBSET] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET u ==> u = {} ==> s SUBSET t"))) THEN
      REWRITE_TAC [EMPTY_UNIONS, FORALL_IN_IMAGE, BALL_EQ_EMPTY] THEN
      ASM_MESON_TAC [REAL_LE_TRANS],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{i | i IN k /\ DISJOINT (ball((a:A->real^N) i,r i)) (ball(a n,r n))}")) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC CARD_PSUBSET THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← SET_RULE (← q r"i IN s ==> ~P i ==> {j | j IN s /\ P j} PSUBSET s"))) THEN
      ASM_REWRITE_TAC [← GSYM DISJOINT_EMPTY_REFL, BALL_EQ_EMPTY],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s DIFF ball((a:A->real^N) n,&3 * r n)")) THEN
    ASM_SIMP_TAC [FINITE_RESTRICT] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET UNIONS(IMAGE h f)
        ==> g SUBSET f /\ (!i. i IN f DIFF g ==> h i SUBSET b)
           ==> s DIFF b SUBSET UNIONS(IMAGE h g)"))) THEN
      REWRITE_TAC [SUBSET_RESTRICT, ← SET_RULE
       (← q r"i IN k DIFF {x | x IN k /\ P x} <=> i IN k /\ ~P i")] THEN
      X_GEN_TAC (← q r"m:A") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"m:A")) THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [DISJOINT, EXTENSION, SUBSET, NOT_IN_EMPTY, IN_BALL, IN_INTER] THEN
      CONV_TAC (fun t => NORM_ARITH t),
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(n:A) INSERT c") THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [PAIRWISE_INSERT, IMAGE_CLAUSES, UNIONS_INSERT] THEN
      ASM SET_TAC []])

