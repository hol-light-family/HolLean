/- ------------------------------------------------------------------------- -/
/- A derivative-free formulation of (absolute) integration by parts.        -/
/- (measure.ml 22823-23173)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCL where
  ABSOLUTE_INTEGRATION_BY_PARTS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCL [HolBase] (D : MeasureDeps) (BMSAF : MSAF) (BMSAM : MSAM) (BMSBC : MSBC) (BMSCA : MSCA) : ExceptT String IO MSCL := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT, .. } := BMSAF
  let { LEBESGUE_MEASURABLE_INTERVAL, .. } := BMSAM
  let { CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET, .. } := BMSBC
  let { ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS, .. } := BMSCA
  let { ABSOLUTELY_INTEGRABLE_CONTINUOUS, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_LE, ABSOLUTELY_INTEGRABLE_NORM,
        ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL, ABSOLUTELY_INTEGRABLE_SUB,
        .. } := D.qintegration1
  let { HAS_INTEGRAL_INTEGRAL, INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, INTEGRABLE_CMUL,
        INTEGRABLE_CONTINUOUS, INTEGRABLE_SUB, INTEGRAL_ADD, .. } := D.qintegration2
  let { INTEGRAL_CMUL, INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE,
        INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_REFL, INTEGRAL_SUB, INTEGRAL_SUBSET_DROP_LE,
        INTEGRAL_UNIQUE, INTEGRATION_BY_PARTS, .. } := D.qintegration3
  let { BILINEAR_CONTINUOUS_ON_COMPOSE, .. } := D.qtopology1
  let { has_derivative, has_vector_derivative, .. } := D.ig.qderivatives
  let { COUNTABLE_EMPTY, .. } := D.ig.qcard
  let { INTERIOR_INTERVAL, LIM_WITHIN_INTERIOR, NETLIMIT_AT, .. } := D.ig.qtopology
  let { BILINEAR_SWAP, NORM_REAL, .. } := D.ig.qvec
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { LIM_BILINEAR, .. } := D.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_NULL, LIM_NULL_CMUL, NETLIMIT_WITHIN, SEQ_HARMONIC_OFFSET,
        .. } := D.ig.dv.qtopology2
  let { BILINEAR_BOUNDED_POS, .. } := D.ig.dv.qvec
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ARITH_TAC, ASM_MESON_TAC, basic_ss, GEN_SIMPLIFY_CONV, MESON, MESON_TAC,
        NORM_ARITH, REAL_ARITH, TOP_DEPTH_SQCONV, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_ASSOC, DIFF_EMPTY, ETA_AX, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMP_CONJ_ALT, .. } := D.ig.dv.dg.pt.cvx.core2
  let { REAL_LE_ADD, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LTE_TRANS,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POS,
        REAL_POW_2, SKOLEM_THM, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, ENDS_IN_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_ADD, LIFT_CMUL,
        LIFT_DROP, LINEAR_SUB, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, NORM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { bilinear, drop, VECTOR_MUL_ASSOC, VECTOR_SUB_EQ, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL,
        .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_EQ, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, LIM_ADD, LIM_CONST, LIM_MUL, LIM_NULL_ADD,
        LIM_NULL_COMPARISON, LIM_SUB, LIM_UNIQUE, .. } := D.ig.dv.dg.pt.cvx.top4
  let { SEQ_HARMONIC, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let ABSOLUTE_INTEGRATION_BY_PARTS ← prove
   r"!(bop:real^M->real^N->real^P) (f:real^1->real^M) g f' g' a b.
        bilinear bop /\ drop a <= drop b /\
