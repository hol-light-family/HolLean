  let { MEASURE_ISOMETRY, .. } := BMST
  let { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE, .. } := BMSAI
  let { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM, .. } := BMSAJ
  let { LEBESGUE_MEASURABLE_COUNTABLE_UNIONS, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
        .. } := BMSAM
  let { MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAS
  let { PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE, .. } := BMSBB
  let { VITALI_COVERING_THEOREM_BALLS, .. } := BMSBH
  let { NEGLIGIBLE_COUNTABLE, NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.qcard
  let { BALL_TRANSLATION, .. } := D.qtopology1
  let { LINDELOF, .. } := D.qtopology2
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { DISCRETE_IMP_COUNTABLE, .. } := D.ig.dv.qtopology1
  let { open_def, .. } := D.ig.dv.qtopology2
  let { NORM_LT_SQUARE, .. } := D.ig.dv.qvec
  let { UNIONS_MONO_IMAGE, .. } := D.ig.dv.dg.qsession
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { BALL_SCALING, SUBSET_BALL, .. } := D.ig.dv.dg.pt.qtop
  let { AND_FORALL_THM, CART_EQ, CONJ_SYM, CONTRAPOS_THM, EXISTS_IN_GSPEC, FINITE_IMAGE,
        FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT,
        INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_AND,
        REAL_ABS_POS, REAL_ADD_LDISTRIB, REAL_DIV_LMUL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_NZ,
        REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LT_MUL, REAL_LT_RDIV_EQ, REAL_MIN_LE,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LNEG, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_NOT_LT, REAL_POS, REAL_POW_LE, REAL_POW_LT, REAL_SUB_LT, SIMPLE_IMAGE,
        SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, pairwise, real_abs, SUM_LE, SUM_LMUL, SURJECTIVE_IMAGE_EQ,
        UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { NORM_EQ, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, NORM_POS_LT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, dot, linear, VECTOR_ADD_COMPONENT, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_SUB_EQ, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, IN_BALL_0, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_on, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LEBESGUE_MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) <= dimindex(:N) /\ lebesgue_measurable s /\
        (!x. x IN s
             ==> ?t b. open t /\ x IN t /\
                       !y. y IN s INTER t
                           ==> norm(f y - f x) <= b * norm(y - x))
        ==> lebesgue_measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) continuous_on s") MP_TAC THENL
     [REWRITE_TAC [continuous_on] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, dist] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^M->bool", ← q r"B:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [open_def]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d (e / (abs B + &1))") THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_MIN, ← REAL_ARITH (← q r"&0 < abs B + &1")] THEN
      X_GEN_TAC (← q r"y:real^M") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      SIMP_TAC [REAL_LT_RDIV_EQ, ← REAL_ARITH (← q r"&0 < abs B + &1")] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"B * norm(y - x:real^M)") THEN
      ASM_SIMP_TAC [REAL_LE_RMUL, NORM_POS_LE, ← REAL_ARITH (← q r"B <= abs B + &1")] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INTER] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [dist],
      DISCH_THEN (MP_TAC o MATCH_MP
       PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE) THEN
      DISCH_THEN (MP_TAC o (fun (th : thm) => do pure (← EQ_IMP_RULE th).2)) THEN
      ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET_REFL]] THEN
      X_GEN_TAC (← q r"u:real^M->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let (MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE, MEASURE_LOCALLY_LIPSCHITZ_IMAGE) ←
   CONJ_PAIR (← prove
   r"(!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\
        measurable s /\
        (!x. x IN s
             ==> ?t. open t /\
                     x IN t /\
                     (!y. y IN s INTER t
                          ==> norm(f y - f x) <= B * norm(y - x)))
        ==> measurable(IMAGE f s)) /\
   (!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\
        measurable s /\
        (!x. x IN s
             ==> ?t. open t /\
                     x IN t /\
                     (!y. y IN s INTER t
                          ==> norm(f y - f x) <= B * norm(y - x)))
        ==> measure(IMAGE f s) <= B pow dimindex(:N) * measure s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC I [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. ?e. x IN s
              ==> &0 < e /\
                  !y. y IN s INTER ball(x,e)
                      ==> norm((f:real^M->real^N) y - f x) <= B * norm(y - x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [OPEN_CONTAINS_BALL, SUBSET, IN_INTER] THEN MESON_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"r:real^M->real") THEN DISCH_THEN (LABEL_TAC "*") THEN
    ASM_CASES_TAC (← q r"B < &0") THENL
     [SUBGOAL_THEN (← q r"negligible(s:real^M->bool)") ASSUME_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE THEN
        MATCH_MP_TAC DISCRETE_IMP_COUNTABLE THEN
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"(r:real^M->real) x") THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
        ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^M") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [IN_INTER, IN_BALL] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
        ANTS_TAC THENL [ALL_TAC, CONV_TAC (fun t => NORM_ARITH t)] THEN
        MATCH_MP_TAC (← NORM_ARITH (← q r"&0 < --x ==> ~(norm(a:real^M) <= x)")) THEN
        REWRITE_TAC [← GSYM REAL_MUL_LNEG] THEN MATCH_MP_TAC REAL_LT_MUL THEN
        ASM_SIMP_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN ASM_REAL_ARITH_TAC,
        SUBGOAL_THEN (← q r"negligible(IMAGE (f:real^M->real^N) s)") ASSUME_TAC THENL
         [MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN ASM SET_TAC [],
          RULE_ASSUM_TAC (REWRITE_RULE [NEGLIGIBLE_EQ_MEASURE_0]) THEN
          ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_LE_REFL]]],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT])] THEN
    ASM_CASES_TAC (← q r"dimindex(:M) < dimindex(:N)") THENL
     [SUBGOAL_THEN (← q r"negligible(IMAGE (f:real^M->real^N) s)") MP_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM THEN
        ASM SET_TAC [],
        ASM_SIMP_TAC [NEGLIGIBLE_EQ_MEASURE_0, REAL_POS, REAL_POW_LE, REAL_LE_MUL,
                      MEASURE_POS_LE]],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"B = &0") THENL
     [SUBGOAL_THEN (← q r"negligible(IMAGE (f:real^M->real^N) s)") MP_TAC THENL
       [ALL_TAC,
        ASM_SIMP_TAC [NEGLIGIBLE_EQ_MEASURE_0, REAL_POS, REAL_POW_LE, REAL_LE_MUL,
                      MEASURE_POS_LE]] THEN
      MP_TAC (← ISPEC (← q r"{ball(x:real^M,r x) | x IN s}") LINDELOF) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, SIMPLE_IMAGE, OPEN_BALL] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^M->bool") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N)
                   (UNIONS (IMAGE (\x. s INTER ball(x,r x)) c))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"UNIONS (IMAGE (\x. {(f:real^M->real^N) x}) c)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
          ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, NEGLIGIBLE_SING],
          REWRITE_TAC [IMAGE_UNIONS, ← GSYM IMAGE_o, o_DEF] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s ==> f x SUBSET g x)
            ==> UNIONS (IMAGE f s) SUBSET UNIONS (IMAGE g s)")) THEN
          X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"(x:real^M) IN s") ASSUME_TAC THENL
           [ASM SET_TAC [], ALL_TAC] THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
          ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o CONJUNCT2) THEN
          REWRITE_TAC [REAL_MUL_LZERO, ← NORM_ARITH
           (← q r"norm(x - y:real^M) <= &0 <=> x = y")] THEN
          SET_TAC []],
        TRANS_TAC SUBSET_TRANS
         (← q r"IMAGE (f:real^M->real^N)
                (s INTER UNIONS(IMAGE (\x. ball (x,r x)) c))") THEN
        CONJ_TAC THENL
         [ASM_REWRITE_TAC [], REWRITE_TAC [INTER_UNIONS] THEN ASM SET_TAC []] THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM, IN_INTER] THEN
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        EXISTS_TAC (← q r"x:real^M") THEN ASM_SIMP_TAC [CENTRE_IN_BALL]],
      SUBGOAL_THEN (← q r"&0 < B") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]] THEN
    SUBGOAL_THEN
     (← q r"measurable(IMAGE (f:real^M->real^N) s) /\
      !e. &0 < e ==> measure(IMAGE f s) <= B pow dimindex(:N) * (measure s + e)")
    MP_TAC THENL
     [MATCH_MP_TAC (← MESON [REAL_LT_01]
       (← q r"(!e. &0 < e ==> P /\ Q e) ==> P /\ (!e. &0 < e ==> Q e)")),
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC
         (← q r"(measure(IMAGE (f:real^M->real^N) s) / B pow dimindex(:N) - measure s)
               / &2"))) THEN
      ASM_SIMP_TAC [REAL_SUB_LT, REAL_LT_RDIV_EQ, REAL_ADD_LDISTRIB, REAL_HALF,
                    REAL_LT_IMP_NZ, REAL_DIV_LMUL, REAL_POW_LT, ← REAL_ARITH
                    (← q r"B * (x - y) / &2 = (B * x - B * y) / &2")] THEN
      REAL_ARITH_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"e:real"] MEASURABLE_OUTER_OPEN) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^M->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{(x,t) | x IN s /\ t <= (r:real^M->real) x /\ ball(x,t) SUBSET u}",
      ← q r"FST:real^M#real->real^M",
      ← q r"SND:real^M#real->real", ← q r"s:real^M->bool"]
     VITALI_COVERING_THEOREM_BALLS) THEN
    ASM_REWRITE_TAC [EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"d:real"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"x:real^M") THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d':real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min (d / &2) (min d' (r(x:real^M)))") THEN
      ASM_SIMP_TAC [CENTRE_IN_BALL, REAL_LT_MIN, REAL_MIN_LE, REAL_LE_REFL] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      TRANS_TAC SUBSET_TRANS (← q r"ball(x:real^M,d')") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_BALL THEN ASM_REAL_ARITH_TAC,
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^M#real->bool") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"measurable(IMAGE (f:real^M->real^N) (s INTER UNIONS {ball i | i IN c})) /\
      measure(IMAGE (f:real^M->real^N) (s INTER UNIONS {ball i | i IN c}))
      <= B pow dimindex(:N) * (measure(s:real^M->bool) + e)")
    MP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
         MEASURABLE_NEGLIGIBLE_SYMDIFF),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"IMAGE (f:real^M->real^N) (s DIFF UNIONS {ball i | i IN c})") THEN
      (CONJ_TAC THENL [ALL_TAC, SET_TAC []]) THEN
      MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []] THEN
    MATCH_MP_TAC (← MESON [MEASURABLE_LEBESGUE_MEASURABLE_SUBSET, REAL_LE_TRANS,
                           MEASURE_SUBSET]
      (← q r"!t. lebesgue_measurable s /\ s SUBSET t /\ measurable t /\ measure t <= b
           ==> measurable s /\ measure s <= b")) THEN
    EXISTS_TAC (← q r"UNIONS {ball((f:real^M->real^N) (FST x),B * SND x) |
                        (x:real^M#real) IN c}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [INTER_UNIONS, SIMPLE_IMAGE, ← GSYM IMAGE_o, IMAGE_UNIONS] THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, o_THM] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC LEBESGUE_MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE THEN
      ASM_SIMP_TAC [MEASURABLE_IMP_LEBESGUE_MEASURABLE, MEASURABLE_INTER,
                    MEASURABLE_BALL] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [INTER_UNIONS, IMAGE_UNIONS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
      MATCH_MP_TAC UNIONS_MONO_IMAGE THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, o_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"t:real"] THEN STRIP_TAC THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"y:real^M") THEN REWRITE_TAC [IN_INTER, IN_BALL] THEN
      STRIP_TAC THEN REMOVE_THEN "*" (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"y:real^M"))) THEN
      ASM_REWRITE_TAC [IN_INTER, ← GSYM dist, IN_BALL] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [DIST_SYM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [MEASURABLE_BALL] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"k:real^M#real->bool") THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_UNIONS_LE_IMAGE o
      lhand o snd) THEN
    ASM_REWRITE_TAC [MEASURABLE_BALL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum k (\a:real^M#real. abs B pow dimindex(:N) * measure(ball a))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"t:real"] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(f:real^M->real^N) x = B % inv(B) % f x") SUBST1_TAC THENL
       [ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, VECTOR_MUL_LID],
        ALL_TAC] THEN
      ASM_SIMP_TAC [BALL_SCALING, MEASURE_SCALING, MEASURABLE_BALL] THEN
      SUBGOAL_THEN (← q r"dimindex(:N) = dimindex(:M)") SUBST1_TAC THENL
       [ASM_ARITH_TAC, MATCH_MP_TAC REAL_LE_LMUL] THEN
      ASM_SIMP_TAC [REAL_POW_LE, REAL_ABS_POS] THEN
      ONCE_REWRITE_TAC [← GSYM VECTOR_ADD_RID] THEN
      REWRITE_TAC [BALL_TRANSLATION, MEASURE_TRANSLATION] THEN
      SUBGOAL_THEN
       (← q r"ball(vec 0:real^N,t) = IMAGE (\x. lambda i. x$i) (ball(vec 0:real^M,t))")
      SUBST1_TAC THENL
       [CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
        REWRITE_TAC [IN_BALL_0, NORM_LT_SQUARE] THEN
        SIMP_TAC [dot, LAMBDA_BETA] THEN
        SUBGOAL_THEN (← q r"dimindex(:M) = dimindex(:N)") SUBST1_TAC THENL
         [ASM_ARITH_TAC, REWRITE_TAC []] THEN
        X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"(lambda i. (y:real^N)$i):real^M") THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
        SUBGOAL_THEN (← q r"dimindex(:N) = dimindex(:M)") SUBST1_TAC THENL
         [ASM_ARITH_TAC, SIMP_TAC [LAMBDA_BETA]],
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC MEASURE_ISOMETRY THEN
        CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        SIMP_TAC [linear, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                  LAMBDA_BETA, CART_EQ] THEN
        X_GEN_TAC (← q r"z:real^M") THEN
        SIMP_TAC [NORM_EQ, dot, LAMBDA_BETA] THEN
        SUBGOAL_THEN (← q r"dimindex(:M) = dimindex(:N)") SUBST1_TAC THENL
         [ASM_ARITH_TAC, REWRITE_TAC []]],
      REWRITE_TAC [SUM_LMUL] THEN ASM_REWRITE_TAC [real_abs] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_POW_LE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"u < s + e ==> x <= u ==> x <= s + e"))) THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
          lhand o snd) THEN
      ASM_REWRITE_TAC [FORALL_PAIR_THM, MEASURABLE_BALL] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, FORALL_PAIR_THM,
                    MEASURABLE_BALL, FINITE_IMAGE] THEN
      ASM SET_TAC []]))

  let LEBESGUE_MEASURABLE_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\ lebesgue_measurable s /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> lebesgue_measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LEBESGUE_MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"(:real^M)", ← q r"B:real"] THEN
    ASM_SIMP_TAC [OPEN_UNIV, IN_UNIV, IN_INTER])

  let MEASURABLE_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\ measurable s /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> measurable(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE THEN
    EXISTS_TAC (← q r"B:real") THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"(:real^M)") THEN
    ASM_SIMP_TAC [OPEN_UNIV, IN_UNIV, IN_INTER])

  let MEASURE_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\ measurable s /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> measure(IMAGE f s) <= B pow dimindex(:N) * measure s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURE_LOCALLY_LIPSCHITZ_IMAGE THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"(:real^M)") THEN
    ASM_SIMP_TAC [OPEN_UNIV, IN_UNIV, IN_INTER])

  pure { LEBESGUE_MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE, MEASURABLE_LOCALLY_LIPSCHITZ_IMAGE,
         MEASURE_LOCALLY_LIPSCHITZ_IMAGE, LEBESGUE_MEASURABLE_LIPSCHITZ_IMAGE,
         MEASURABLE_LIPSCHITZ_IMAGE, MEASURE_LIPSCHITZ_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Measurability and measure of bounded differentiable images.              -/
/- (measure.ml 17493-17755)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBT where
  MEASURABLE_BOUNDED_DIFFERENTIABLE_IMAGE : thm
  MEASURE_BOUNDED_DIFFERENTIABLE_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBT [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSF : MSF) (BMSJ : MSJ) (BMSO : MSO) (BMST : MST) (BMSW : MSW) (BMSAJ : MSAJ) (BMSAM : MSAM) (BMSAN : MSAN) (BMSBB : MSBB) (BMSBH : MSBH) : ExceptT String IO MSBT := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_EMPTY, MEASURABLE_NEGLIGIBLE_SYMDIFF, MEASURABLE_UNIONS,
        MEASURE_DISJOINT_UNIONS_IMAGE, MEASURE_EMPTY, MEASURE_NEGLIGIBLE_SYMDIFF,
        .. } := BMSB
  let { MEASURE_UNIONS_LE_IMAGE, .. } := BMSC
  let { MEASURABLE_TRANSLATION, MEASURE_SCALING, MEASURE_TRANSLATION, .. } := BMSE
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. } := BMSF
  let { MEASURABLE_BALL, MEASURE_BALL_POS, NEGLIGIBLE_CONVEX_FRONTIER, .. } := BMSJ
  let { MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { MEASURABLE_LINEAR_IMAGE, MEASURE_LINEAR_IMAGE, .. } := BMST
  let { MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_EXPLICIT, .. } := BMSW
  let { NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE, .. } := BMSAJ
  let { LEBESGUE_MEASURABLE_IFF_MEASURABLE, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
        .. } := BMSAM
  let { LEBESGUE_MEASURABLE_TRANSLATION, .. } := BMSAN
  let { LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE, LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN,
        .. } := BMSBB
  let { VITALI_COVERING_THEOREM_BALLS, .. } := BMSBH
  let { DIFFERENTIABLE_ON_SUBSET, has_derivative_within, .. } := D.qderivatives
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { BALL_TRANSLATION, .. } := D.qtopology1
  let { differentiable, differentiable_on, .. } := D.ig.qderivatives
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { BALL_SCALING, SUBSET_BALL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_BALL, CONVEX_LINEAR_IMAGE, .. } := D.ig.dv.dg.pt.qcvx2
  let { AND_FORALL_THM, CONJ_SYM, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, FINITE_IMAGE,
        FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMAGE_CLAUSES, IMAGE_ID, IMAGE_o, IMP_CONJ,
        IMP_CONJ_ALT, INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LE_REFL, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_FORALL, NOT_EXISTS_THM, REAL_ABS_INV, REAL_ABS_POS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_MUL2,
        REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ,
        REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_NOT_LT, REAL_POW_INV, REAL_POW_LT, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE,
        SKOLEM_THM, SUBSET, SUBSET_DIFF, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, pairwise, real_div, SUM_LE, SUM_LMUL, SWAP_FORALL_THM, UNWIND_THM2,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DIST_0, DIST_MUL, DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { LINEAR_0, LINEAR_CMUL, LINEAR_SCALING, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_RZERO,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_LINEAR_IMAGE, BOUNDED_SUBSET, BOUNDED_SUMS, CENTRE_IN_BALL,
        .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, IN_BALL_0, LIM_WITHIN, OPEN_CONTAINS_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let (MEASURABLE_BOUNDED_DIFFERENTIABLE_IMAGE,
       MEASURE_BOUNDED_DIFFERENTIABLE_IMAGE) ← CONJ_PAIR (← prove
   r"(!f:real^N->real^N f' s B.
      measurable s /\
      (!x. x IN s
           ==> (f has_derivative f' x) (at x within s) /\
               abs(det(matrix(f' x))) <= B)
      ==> measurable(IMAGE f s)) /\
   (!f:real^N->real^N f' s B.
      measurable s /\
      (!x. x IN s
           ==> (f has_derivative f' x) (at x within s) /\
               abs(det(matrix(f' x))) <= B)
      ==> measure(IMAGE f s) <= B * measure s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    ASM_CASES_TAC (← q r"B < &0") THENL
     [ASM_SIMP_TAC [← REAL_ARITH (← q r"B < &0 ==> ~(abs x <= B)")] THEN
      SIMP_TAC [← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [IMAGE_CLAUSES, MEASURE_EMPTY, MEASURABLE_EMPTY] THEN
      REAL_ARITH_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT]) THEN STRIP_TAC] THEN
   SUBGOAL_THEN
     (← q r"measurable(IMAGE (f:real^N->real^N) s) /\
      !e. &0 < e ==> measure(IMAGE f s) <= (B + e) * measure s")
    MP_TAC THENL
     [MATCH_MP_TAC (← MESON [REAL_LT_01]
       (← q r"(!e. &0 < e ==> P /\ Q e) ==> P /\ (!e. &0 < e ==> Q e)")),
      FIRST_X_ASSUM (MP_TAC o MATCH_MP MEASURE_POS_LE) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 <= x <=> x = &0 \/ &0 < x")] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
       [ASM_MESON_TAC [REAL_MUL_RZERO, REAL_LT_01],
        FIRST_X_ASSUM (MP_TAC o SPEC
          (← q r"(measure(IMAGE (f:real^N->real^N) s) / measure s - B) / &2")) THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ] THEN
        ASM_REAL_ARITH_TAC]] THEN
    SUBGOAL_THEN
     (← q r"!d e. &0 < d /\ &0 < e
            ==> measurable(IMAGE (f:real^N->real^N) s) /\
                measure(IMAGE f s) <= (B + e) * (measure s + d)")
    MP_TAC THENL
     [ALL_TAC,
      GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THENL [ASM_MESON_TAC [REAL_LT_01], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"(measure(IMAGE (f:real^N->real^N) s) / (B + e) - measure s) / &2")) THEN
      SUBGOAL_THEN (← q r"&0 < B + e") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, REWRITE_TAC []] THEN
      ASM_SIMP_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM REAL_LE_LDIV_EQ)] THEN
      ASM_REAL_ARITH_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:real", ← q r"e:real"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"m:real"] MEASURABLE_OUTER_OPEN) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^N->real^N) differentiable_on s") ASSUME_TAC THENL
     [REWRITE_TAC [differentiable_on, differentiable] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x d. x IN s /\ &0 < d
            ==> ?r. &0 < r /\ r < d /\ ball(x,r) SUBSET u /\
                    measurable(IMAGE (f:real^N->real^N) (s INTER ball(x,r))) /\
                    measure(IMAGE f (s INTER ball(x,r)))
                    <= (B + e) * measure(ball(x,r))")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"IMAGE ((f':real^N->real^N->real^N) x) (ball(vec 0,&1))",
                        ← q r"e * measure(ball(vec 0:real^N,&1))"]
          MEASURE_SEMICONTINUOUS_WITH_HAUSDIST_EXPLICIT) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o
        GEN_REWRITE_RULE I [has_derivative_within]) THEN
      ASM_SIMP_TAC [CONVEX_LINEAR_IMAGE, CONVEX_BALL,
                    NEGLIGIBLE_CONVEX_FRONTIER] THEN
      ASM_SIMP_TAC [BOUNDED_LINEAR_IMAGE, BOUNDED_BALL] THEN
      ASM_SIMP_TAC [REAL_LT_MUL, MEASURE_BALL_POS, REAL_LT_01] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE I
        [OPEN_CONTAINS_BALL]) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"l:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_WITHIN]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"k:real")) THEN ASM_REWRITE_TAC [DIST_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:real") STRIP_ASSUME_TAC) THEN
      ABBREV_TAC (← q r"r = min (min l (n / &2)) (min (&1) (d / &2))") THEN
      EXISTS_TAC (← q r"r:real") THEN REPLICATE_TAC 2
       (MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_TAC]) THEN
      CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"ball(x:real^N,l)") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC SUBSET_BALL THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"IMAGE (\x. inv(r) % x)
              (IMAGE (\y. --(f x) + y)
                     (IMAGE (f:real^N->real^N) (s INTER ball(x,r))))")) THEN
      ASM_SIMP_TAC [MEASURE_LINEAR_IMAGE, MEASURABLE_BALL, MEASURE_TRANSLATION,
                    MEASURABLE_TRANSLATION] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"q /\ (q ==> p) /\ (p ==> r ==> s) ==> (p /\ q ==> r) ==> s")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE, IN_INTER, IN_BALL] THEN
        X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"y:real^N = x") THENL
         [EXISTS_TAC (← q r"vec 0:real^N") THEN
          ASM_REWRITE_TAC [DIST_REFL, REAL_LT_01] THEN
          FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP LINEAR_0) THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"r % (--x + x):real^N = vec 0")] THEN
          ASM_REWRITE_TAC [DIST_REFL],
          EXISTS_TAC (← q r"inv(r) % (y - x):real^N") THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (REWRITE_TAC [← MATCH_MP LINEAR_CMUL th])) THEN
          ASM_REWRITE_TAC [DIST_0, NORM_MUL, REAL_ABS_INV, DIST_MUL] THEN
          REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
          ASM_SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < x ==> &0 < abs x")] THEN
          REWRITE_TAC [← NORM_ARITH
           (← q r"norm(y - x:real^N) < &1 * r <=> dist(x,y) < r")] THEN
          CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
          ASM_REWRITE_TAC [← GSYM DIST_NZ] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
          REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
          ASM_SIMP_TAC [REAL_LT_LDIV_EQ, ← GSYM dist, ← GSYM DIST_NZ] THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"a <= b ==> dist(y:real^N,x + f) < a ==> dist(--x + y,f) < b")) THEN
          ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
          ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [DISCH_TAC THEN
        W (MP_TAC o PART_MATCH (rand o rand)
           LEBESGUE_MEASURABLE_IFF_MEASURABLE o snd) THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC BOUNDED_SUBSET THEN
          EXISTS_TAC
           (← q r"{a + b | a IN IMAGE ((f':real^N->real^N->real^N) x)
                                (ball(vec 0,&1)) /\
                     b IN ball(vec 0,k)}") THEN
          ASM_SIMP_TAC [BOUNDED_SUMS, BOUNDED_BALL, BOUNDED_LINEAR_IMAGE] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
          ONCE_REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> r /\ p /\ q")] THEN
          REWRITE_TAC [UNWIND_THM2, ← VECTOR_ARITH
           (← q r"x:real^N = a + b <=> b = x - a")] THEN
          REWRITE_TAC [IN_BALL_0, ← GSYM dist] THEN ASM_MESON_TAC [DIST_SYM],
          DISCH_THEN (SUBST1_TAC o SYM) THEN
          MATCH_MP_TAC LEBESGUE_MEASURABLE_LINEAR_IMAGE_GEN THEN
          REWRITE_TAC [LE_REFL, LINEAR_SCALING] THEN
          REWRITE_TAC [LEBESGUE_MEASURABLE_TRANSLATION] THEN
          MATCH_MP_TAC LEBESGUE_MEASURABLE_DIFFERENTIABLE_IMAGE THEN
          ASM_SIMP_TAC [LE_REFL, MEASURABLE_IMP_LEBESGUE_MEASURABLE,
                        MEASURABLE_INTER, MEASURABLE_BALL] THEN
          MATCH_MP_TAC DIFFERENTIABLE_ON_SUBSET THEN
          EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN ASM
          SET_TAC []],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"\x:real^N. r % x") o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] MEASURABLE_LINEAR_IMAGE)) THEN
      REWRITE_TAC [LINEAR_SCALING] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM IMAGE_o] THEN
      ASM_SIMP_TAC [o_DEF, VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [VECTOR_MUL_LID, IMAGE_ID] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^N->real^N) x") o
         MATCH_MP MEASURABLE_TRANSLATION) THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM IMAGE_o] THEN
      REWRITE_TAC [o_DEF, ← VECTOR_ARITH (← q r"x + --x + y:real^N = y")] THEN
      REWRITE_TAC [IMAGE_ID] THEN DISCH_TAC THEN
      ASM_SIMP_TAC [MEASURE_SCALING, MEASURABLE_TRANSLATION] THEN
      REWRITE_TAC [MEASURE_TRANSLATION, REAL_ABS_INV, REAL_POW_INV] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_POW_LT,
                    ← REAL_ARITH (← q r"&0 < r ==> &0 < abs r")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"y <= z ==> x < y ==> x <= z")) THEN
      ONCE_REWRITE_TAC [← REAL_ARITH
       (← q r"(a * b + c) * r:real = a * r * b + c * r")] THEN
      SIMP_TAC [← GSYM MEASURE_SCALING, MEASURABLE_BALL] THEN
      ASM_SIMP_TAC [← GSYM BALL_SCALING] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= a * m /\ w * z * y <= b * m
        ==> x + (w * y) * z <= (a + b) * m")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REWRITE_TAC [REAL_ABS_POS] THEN
        SIMP_TAC [MEASURE_POS_LE, MEASURABLE_BALL] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← GSYM REAL_MUL_ASSOC],
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
        SIMP_TAC [← GSYM MEASURE_SCALING, MEASURABLE_BALL] THEN
        ASM_SIMP_TAC [← GSYM BALL_SCALING]] THEN
      REWRITE_TAC [VECTOR_MUL_RZERO, REAL_MUL_RID] THEN
      SUBST1_TAC (← VECTOR_ARITH (← q r"x:real^N = x + vec 0")) THEN
      REWRITE_TAC [BALL_TRANSLATION, MEASURE_TRANSLATION, REAL_LE_REFL],
      ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, LEFT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    X_GEN_TAC (← q r"r:real^N->real->real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{(x:real^N,(r:real^N->real->real) x t) | x IN s /\ &0 < t}",
      ← q r"FST:real^N#real->real^N",
      ← q r"SND:real^N#real->real", ← q r"s:real^N->bool"]
     VITALI_COVERING_THEOREM_BALLS) THEN
    ASM_REWRITE_TAC [EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"d:real"] THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN ASM_MESON_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N#real->bool") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"measurable(IMAGE (f:real^N->real^N) (s INTER UNIONS {ball i | i IN c})) /\
      measure(IMAGE (f:real^N->real^N) (s INTER UNIONS {ball i | i IN c}))
      <= (B + e) * (measure s + m)")
    MP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
         MEASURABLE_NEGLIGIBLE_SYMDIFF),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"IMAGE (f:real^N->real^N) (s DIFF UNIONS {ball i | i IN c})") THEN
      (CONJ_TAC THENL [ALL_TAC, SET_TAC []]) THEN
      MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE THEN
      ASM_REWRITE_TAC [LE_REFL] THEN MATCH_MP_TAC DIFFERENTIABLE_ON_SUBSET THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      REWRITE_TAC [SUBSET_DIFF, differentiable_on, differentiable] THEN
      ASM_MESON_TAC []] THEN
    REWRITE_TAC [INTER_UNIONS, SIMPLE_IMAGE, ← GSYM IMAGE_o, IMAGE_UNIONS] THEN
    MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, o_THM] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"k:real^N#real->bool") THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_UNIONS_LE_IMAGE o
      lhand o snd) THEN
    ASM_REWRITE_TAC [MEASURABLE_BALL] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, o_THM] THEN ASM SET_TAC [],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum k (\a:real^N#real. (B + e) * measure(ball a))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> (!x. x IN t ==> P x) ==> (!x. x IN s ==> P x)")))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, o_THM] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SUM_LMUL] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"u < s + e ==> x <= u ==> x <= s + e"))) THEN
    W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
        lhand o snd) THEN
    ASM_REWRITE_TAC [FORALL_PAIR_THM, MEASURABLE_BALL] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, FORALL_PAIR_THM,
                  MEASURABLE_BALL, FINITE_IMAGE] THEN
    ASM SET_TAC []))

  pure { MEASURABLE_BOUNDED_DIFFERENTIABLE_IMAGE, MEASURE_BOUNDED_DIFFERENTIABLE_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Measurability and measure of differentiable images with integrable       -/
/- Jacobian.  (measure.ml 17756-18040)                                      -/
/- ------------------------------------------------------------------------- -/

structure MSBU where
  MEASURABLE_DIFFERENTIABLE_IMAGE : thm
  MEASURE_DIFFERENTIABLE_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBU [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSAB : MSAB) (BMSAM : MSAM) (BMSAS : MSAS) (BMSAW : MSAW) (BMSBT : MSBT) : ExceptT String IO MSBU := do
  -- @@SCOPE BEGIN
  let { INTEGRAL_MEASURE, MEASURABLE_INTER, MEASURABLE_INTERVAL, MEASURE_POS_LE,
        MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE_STRONG, .. } := BMSB
  let { INTEGRABLE_ON_CONST, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE, MEASURE_COUNTABLE_UNIONS_LE_STRONG, .. } := BMSF
  let { INTEGRABLE_IMP_MEASURABLE, .. } := BMSAB
  let { ABSOLUTELY_INTEGRABLE_ON_LEBESGUE_MEASURABLE_SUBSET, LEBESGUE_MEASURABLE_UNIONS,
        MEASURABLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_MEASURABLE_INTER_LEBESGUE_MEASURABLE, .. } := BMSAS
  let { MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_GE,
        MEASURABLE_ON_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAW
  let { MEASURABLE_BOUNDED_DIFFERENTIABLE_IMAGE, MEASURE_BOUNDED_DIFFERENTIABLE_IMAGE,
        .. } := BMSBT
