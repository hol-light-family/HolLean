structure MSBV where
  NEGLIGIBLE_DIFFERENTIABLE_PREIMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBV [HolBase] (D : MeasureDeps) (BMSAI : MSAI) (BMSBI : MSBI) : ExceptT String IO MSBV := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE, .. } := BMSAI
  let { LOCALLY_NEGLIGIBLE_ALT, .. } := BMSBI
  let { NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { FULL_RANK_INJECTIVE, .. } := D.qvec
  let { HAS_DERIVATIVE_WITHIN_ALT, .. } := D.ig.qderivatives
  let { NOT_SUC, .. } := D.ig.qsession
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.ig.dv.qsession
  let { LINEAR_INVERTIBLE_BOUNDED_BELOW_POS, .. } := D.ig.dv.qvec
  let { REAL_LT_TRANS, .. } := D.ig.dv.dg.qsession
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { ETA_AX, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, REAL_ARCH_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_RMUL, REAL_LT_01, REAL_LT_INV_EQ,
        REAL_LTE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUC, REAL_SUB_LT, REAL_SUB_RDISTRIB, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { num_INDUCTION, real_div, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { LINEAR_INJECTIVE_LEFT_INVERSE, MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS, NORM_0,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_SUB_REFL, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, OPEN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_IN_OPEN_INTER, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let NEGLIGIBLE_DIFFERENTIABLE_PREIMAGE ← prove
   r"!f:real^M->real^N f' s t.
        dimindex(:M) = dimindex(:N) /\
        (!x. x IN s ==> (f has_derivative f' x) (at x within s) /\
                        rank(matrix(f' x)) = dimindex(:N)) /\
        negligible t
        ==> negligible {x | x IN s /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC
      (← q r"u = \n. {x | x IN s /\
                    !y. y IN s /\ norm(y - x) < inv(&n + &1)
                        ==> norm(y - x:real^M)
                            <= (&n + &1) * norm(f y - f x:real^N)}") THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC
     (← q r"UNIONS {{x | x IN u n /\ (f:real^M->real^N) x IN t} | n IN (:num)}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN X_GEN_TAC (← q r"n:num") THEN
      ONCE_REWRITE_TAC [LOCALLY_NEGLIGIBLE_ALT] THEN
      X_GEN_TAC (← q r"a:real^M") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      ABBREV_TAC
       (← q r"v = {x | x IN u n /\ (f:real^M->real^N) x IN t} INTER
            ball(a,inv(&n + &1) / &2)") THEN
      EXISTS_TAC (← q r"v:real^M->bool") THEN EXPAND_TAC "v" THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, CENTRE_IN_BALL, REAL_HALF] THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      SUBGOAL_THEN
       (← q r"!x y:real^M. x IN v /\ y IN v
                     ==> norm(x - y) <= (&n + &1) * norm(f x - f y:real^N)")
      ASSUME_TAC THENL
       [EXPAND_TAC "v" THEN REWRITE_TAC [IN_ELIM_THM, IN_INTER, IN_BALL] THEN
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        MESON_TAC [← NORM_ARITH
         (← q r"dist(a:real^N,x) < e / &2 /\ dist(a,y) < e / &2 ==> norm(x - y) < e")],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?g. !x. x IN v ==> g((f:real^M->real^N) x) = x")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM INJECTIVE_ON_LEFT_INVERSE] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"]) THEN
        ASM_REWRITE_TAC [VECTOR_SUB_REFL, real_div, NORM_0, REAL_MUL_LZERO] THEN
        CONV_TAC (fun t => NORM_ARITH t),
        ALL_TAC] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC
       (← q r"IMAGE (g:real^N->real^M) (IMAGE (f:real^M->real^N) v INTER t)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN
      CONJ_TAC THENL [ASM_MESON_TAC [LE_REFL], ALL_TAC] THEN
      ASM_SIMP_TAC [IN_INTER, IMP_CONJ, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET], ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^M") THEN REPEAT DISCH_TAC THEN
      EXISTS_TAC (← q r"ball((f:real^M->real^N) x,&1)") THEN
      REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, REAL_LT_01] THEN ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIV, UNIONS_GSPEC] THEN
      X_GEN_TAC (← q r"x:real^M") THEN SIMP_TAC [] THEN
      DISCH_THEN (ASSUME_TAC o CONJUNCT1) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [HAS_DERIVATIVE_WITHIN_ALT] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"\h:real^M. matrix((f':real^M->real^M->real^N) x) ** h")
          LINEAR_INJECTIVE_LEFT_INVERSE) THEN
      ASM_REWRITE_TAC [← GSYM FULL_RANK_INJECTIVE] THEN
      ASM_SIMP_TAC [MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], REWRITE_TAC [ETA_AX]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^M") MP_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          LINEAR_INVERTIBLE_BOUNDED_BELOW_POS)) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"B:real") REAL_ARCH_INV) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC, NOT_SUC] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B - inv(&n + &1)")) THEN
      ASM_REWRITE_TAC [REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPEC (← q r"d:real") REAL_ARCH_INV) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MATCH_MP_TAC num_INDUCTION THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC, NOT_SUC] THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"MAX m n") THEN EXPAND_TAC "u" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^M")) THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        TRANS_TAC REAL_LT_TRANS (← q r"inv(&m + &1)") THEN ASM_REWRITE_TAC [] THEN
        TRANS_TAC REAL_LTE_TRANS (← q r"inv(&(MAX m n) + &1)") THEN ASM_SIMP_TAC [],
        REWRITE_TAC [REAL_SUB_RDISTRIB] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"b <= norm(y) /\ d <= c
          ==> norm(f - f' - y:real^N) <= b - c
              ==> d <= norm(f - f')")) THEN
        ASM_REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE]] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ARITH_TAC])

  pure { NEGLIGIBLE_DIFFERENTIABLE_PREIMAGE }
