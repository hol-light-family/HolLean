        REWRITE_TAC [← REAL_ARITH (← q r"x - --x = &2 * x")] THEN
        SIMP_TAC [PRODUCT_CLAUSES_LEFT, DIMINDEX_GE_1] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS] THEN
