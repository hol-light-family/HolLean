        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M") STRIP_ASSUME_TAC) THEN
        UNDISCH_TAC (← q r"~((x:real^M) IN dd)") THEN EXPAND_TAC "dd" THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, NOT_EXISTS_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"u:real^M")) THEN
        ASM_REWRITE_TAC [CONVERGENT_EQ_CAUCHY_AT, NOT_FORALL_THM] THEN
