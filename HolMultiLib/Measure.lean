@[nospecialize]
def setupMSCC [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSE : MSE) (BMSAM : MSAM) (BMSAN : MSAN) (BMSCB : MSCB) : ExceptT String IO MSCC := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_ON_INDICATOR, MEASURABLE_UNION, MEASURE_INTEGRAL,
