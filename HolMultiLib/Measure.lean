  let { EVENTUALLY_AND, .. } := D.ig.dv.dg.qmetric
  let { COMPACT_PATH_IMAGE, CONNECTED_PATH_IMAGE, .. } := D.ig.dv.dg.qpaths1
  let { OPEN_CONNECTED_COMPONENT, PATH_CONNECTED_EQ_CONNECTED, PATH_IMAGE_NONEMPTY,
        PATHFINISH_IN_PATH_IMAGE, PATHSTART_IN_PATH_IMAGE, .. } := D.ig.dv.dg.qpaths2
  let { CONNECTED_COMPONENT_MONO, CONNECTED_COMPONENT_REFL_EQ, .. } := D.ig.dv.dg.qtopology1
