      REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
      REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                   VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x ==> a <= a + x")] THEN
      MATCH_MP_TAC PRODUCT_POS_LT_NUMSEG THEN
      REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
    DISCH_THEN (fun th => tactic_of do
     pure (GEN_REWRITE_TAC (funpow 2 RAND_CONV)
      [← MATCH_MP (← REAL_ARITH (← q r"&0 < x ==> x = abs x")) th] THEN
      ASSUME_TAC th)) THEN
    REWRITE_TAC [real_div, ← GSYM REAL_ABS_INV] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM NORM_MUL] THEN
    SUBGOAL_THEN
     (← q r"mu <= dist(i (uv(tag(k:real^M->bool):real^M):real) (tag k):real^N,
               f(tag k))")
    MP_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> m <= x ==> m <= y")) THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN EXPAND_TAC "i" THEN
    REWRITE_TAC [dist, VECTOR_SUB_LDISTRIB] THEN
    UNDISCH_TAC
      (← q r"&0 < measure(box(uv(tag(k:real^M->bool):real^M):real)
                (tag k):real^M->bool)") THEN
    EXPAND_TAC "box" THEN REWRITE_TAC [MEASURE_INTERVAL] THEN
    SIMP_TAC [VECTOR_MUL_ASSOC, REAL_LT_IMP_NZ, REAL_MUL_LINV] THEN
    REWRITE_TAC [VECTOR_MUL_LID])

  pure { INTEGRABLE_CCONTINUOUS_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Differentiability-like property of the indefinite integral: the         -/
/- symmetric box form.  (measure.ml 6405-6738)                              -/
/- ------------------------------------------------------------------------- -/

structure MSZ where
  INTEGRABLE_CCONTINUOUS_EXPLICIT_SYMMETRIC : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSZ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSK : MSK) (BMSX : MSX) : ExceptT String IO MSZ := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_MEASURE_EQ_0, MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS,
        MEASURE_EMPTY, NEGLIGIBLE_INTERVAL, .. } := BMSB
  let { MEASURE_UNIONS_LE, NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_APPROACHABLE, MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, .. }
        := BMSF
  let { COVERING_LEMMA, .. } := BMSK
  let { AUSTIN_LEMMA, .. } := BMSX
  let { AND_FORALL_THM, ARITH, CARD_NUMSEG_1, CART_EQ, CONJ_ASSOC, DIMINDEX_GE_1,
        EMPTY_SUBSET, EXISTS_IN_IMAGE, EXISTS_SUBSET_IMAGE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_SUBSET, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, INTER_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNIONS, IN_UNIV, LE_1,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_LT, NUMSEG_EMPTY, PAIR_EQ, REAL_ABS_INV, REAL_ARCH_INV, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ,
        REAL_LT_MIN, REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_SYM, REAL_NOT_LT,
        REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POW_LT, RIGHT_EXISTS_AND_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { pairwise, real_div, real_ge, SUBSET_UNIV, SUM_BOUND_LT_GEN, SUM_RMUL, UNIONS_0,
        UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_MUL, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, INTERIOR_SUBSET, LIM_SEQUENTIALLY, OPEN_BALL, OPEN_CONTAINS_BALL, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { REAL_LE_LCANCEL_IMP, .. } := D.ig.dv.qsession
  let { PRODUCT_POS_LT_NUMSEG, .. } := D.ig.qproducts
  let { SUM_LE_INCLUDED, .. } := D.ig.qsession
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { HENSTOCK_LEMMA, INTEGRABLE_ON_SUBINTERVAL, .. } := D.qintegration2
  let { fine, gauge, NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_ON_INTERVALS,
        NEGLIGIBLE_SUBSET, tagged_partial_division_of, .. } := D.qintegration3
  let { MONO_NOT, .. } := D.qsession
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let INTEGRABLE_CCONTINUOUS_EXPLICIT_SYMMETRIC ← prove
   r"!f:real^M->real^N.
    (!a b. f integrable_on interval[a,b])
    ==> ?k. negligible k /\
         !x e. ~(x IN k) /\ &0 < e
               ==> ?d. &0 < d /\
                       !h. &0 < h /\ h < d
                ==> norm(inv(content(interval[x - h % vec 1,x + h % vec 1])) %
                    integral (interval[x - h % vec 1,x + h % vec 1]) f -
                    f(x)) < e"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"box = \h x. interval[x - h % vec 1:real^M,x + h % vec 1]",
      ← q r"i = \h:real x:real^M. inv(content(box h x)) %
                      integral (box h x) (f:real^M->real^N)"] THEN
    SUBGOAL_THEN
     (← q r"?k. negligible k /\
        !x e. ~(x IN k) /\ &0 < e
              ==> ?d. &0 < d /\
                      !h. &0 < h /\ h < d
                          ==> norm(i h x - (f:real^M->real^N) x) < e")
    MP_TAC THENL
     [ALL_TAC, MAP_EVERY EXPAND_TAC ["i", "box"] THEN REWRITE_TAC []] THEN
    EXISTS_TAC
     (← q r"{x | ~(!e. &0 < e
              ==> ?d. &0 < d /\
                      !h. &0 < h /\ h < d
                          ==> norm(i h x - (f:real^M->real^N) x) < e)}") THEN
    SIMP_TAC [IN_ELIM_THM] THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC
     (← q r"UNIONS {{x | !d. &0 < d
                     ==> ?h. &0 < h /\ h < d /\
                             inv(&k + &1) <= dist(i h x,(f:real^M->real^N) x)}
            |  k IN (:num)}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"e:real"] THEN STRIP_TAC THEN
      REWRITE_TAC [SIMPLE_IMAGE, UNIONS_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_ARCH_INV]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real")) THEN
      ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [dist] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"inv(&k)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      ASM_REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
    X_GEN_TAC (← q r"jj:num") THEN
    SUBGOAL_THEN (← q r"&0 < inv(&jj + &1)") MP_TAC THENL
     [REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC,
      SPEC_TAC (← q r"inv(&jj + &1)", ← q r"mu:real") THEN GEN_TAC THEN DISCH_TAC] THEN
    ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    ASM_CASES_TAC (← q r"negligible(interval[a:real^M,b])") THENL
     [ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [NEGLIGIBLE_INTERVAL]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
    REWRITE_TAC [NEGLIGIBLE_OUTER_LE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a - vec 1:real^M",
                     ← q r"b + vec 1:real^M"]
      HENSTOCK_LEMMA) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_ON_SUBINTERVAL, SUBSET_UNIV], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(e * mu) / &2 / &3 pow (dimindex(:M))")) THEN
    ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, REAL_LT_MUL,
                  REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | P x} INTER s = {x | x IN s /\ P x}")] THEN
    ABBREV_TAC
      (← q r"E = {x | x IN interval[a,b] /\
              !d. &0 < d
                   ==> ?h. &0 < h /\ h < d /\
                           mu <= dist(i h x,(f:real^M->real^N) x)}") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN E
        ==> ?h. &0 < h /\
                (box h x:real^M->bool) SUBSET (g x) /\
                (box h x:real^M->bool) SUBSET interval[a - vec 1,b + vec 1] /\
                mu <= dist(i h x,(f:real^M->real^N) x)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN EXPAND_TAC "E" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [gauge]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o SPEC (← q r"x:real^M")) THEN
      REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"min (&1) (d / &(dimindex(:M)))"))) THEN
      REWRITE_TAC [REAL_LT_MIN, REAL_LT_01, ← GSYM CONJ_ASSOC] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, DIMINDEX_GE_1, LE_1, REAL_OF_NUM_LT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"ball(x:real^M,d)") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "box" THEN
        REWRITE_TAC [SUBSET, IN_INTERVAL, IN_BALL] THEN
        X_GEN_TAC (← q r"y:real^M") THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                     VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        SIMP_TAC [← REAL_ARITH (← q r"x - h <= y /\ y <= x + h <=> abs(x - y) <= h")] THEN
        DISCH_TAC THEN MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"sum(1..dimindex(:M)) (\i. abs((x - y:real^M)$i))") THEN
        REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
        REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, IN_NUMSEG] THEN
        SIMP_TAC [NOT_LT, DIMINDEX_GE_1, CARD_NUMSEG_1, VECTOR_SUB_COMPONENT] THEN
        ASM_MESON_TAC [REAL_LET_TRANS],
        UNDISCH_TAC (← q r"(x:real^M) IN interval[a,b]") THEN
        EXPAND_TAC "box" THEN REWRITE_TAC [SUBSET, IN_INTERVAL] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (X_GEN_TAC (← q r"y:real^M") THEN MP_TAC th)) THEN
        REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
        X_GEN_TAC (← q r"i:num") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                     VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"uv:real^M->real") THEN
    REWRITE_TAC [← TAUT (← q r"(a ==> b /\ c) <=> (a ==> b) /\ (a ==> c)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^M", ← q r"b:real^M", ← q r"E:real^M->bool",
                     ← q r"\x:real^M. if x IN E then ball(x,uv x) else g(x)"]
     COVERING_LEMMA) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [INTERVAL_NE_EMPTY] THEN CONJ_TAC THENL
       [EXPAND_TAC "E" THEN SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [gauge] THEN GEN_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [gauge]) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"D:(real^M->bool)->bool")) THEN
    EXISTS_TAC (← q r"UNIONS D:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"measurable(UNIONS D:real^M->bool) /\
    measure(UNIONS D) <= measure(interval[a:real^M,b])")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      REWRITE_TAC [MEASURABLE_INTERVAL] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC MEASURABLE_UNIONS THEN
      ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"?d. d SUBSET D /\ FINITE d /\
        measure(UNIONS D:real^M->bool) <= &2 * measure(UNIONS d)")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"measure(UNIONS D:real^M->bool) = &0") THENL
       [EXISTS_TAC (← q r"{}:(real^M->bool)->bool") THEN
        ASM_REWRITE_TAC [FINITE_EMPTY, EMPTY_SUBSET, MEASURE_EMPTY, UNIONS_0] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV,
        MP_TAC (← ISPECL [← q r"D:(real^M->bool)->bool",
                         ← q r"measure(interval[a:real^M,b])",
                         ← q r"measure(UNIONS D:real^M->bool) / &2"]
                  MEASURE_COUNTABLE_UNIONS_APPROACHABLE) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [ASM_SIMP_TAC [MEASURABLE_MEASURE_POS_LT, REAL_HALF] THEN
          ASM_SIMP_TAC [← GSYM MEASURABLE_MEASURE_EQ_0] THEN
          CONJ_TAC THENL [ASM_MESON_TAC [MEASURABLE_INTERVAL], ALL_TAC] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
          REPEAT (CONJ_TAC THENL
            [ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL, MEASURABLE_UNIONS],
             ALL_TAC]) THEN
          ASM SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN REAL_ARITH_TAC]],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o elc 3) THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b <=> ~(a ==> ~b)")] THEN
    SIMP_TAC [IN_INTER] THEN REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"tag:(real^M->bool)->real^M")) THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"D <= &2 * d ==> d <= e / &2 ==> D <= e"))) THEN
    MP_TAC (← ISPEC
     (← q r"IMAGE (\k:real^M->bool. (box:real->real^M->real^M->bool)
                            (uv(tag k):real) ((tag k:real^M))) d")
     AUSTIN_LEMMA) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN EXPAND_TAC "box" THEN
      EXISTS_TAC (← q r"&2 * uv((tag:(real^M->bool)->real^M) k):real") THEN
      EXISTS_TAC (← q r"(tag:(real^M->bool)->real^M) k - uv(tag k) % vec 1:real^M") THEN
      EXISTS_TAC (← q r"(tag:(real^M->bool)->real^M) k + uv(tag k) % vec 1:real^M") THEN
      REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                   VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [EXISTS_SUBSET_IMAGE, real_ge] THEN
    SIMP_TAC [REAL_LE_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:(real^M->bool)->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"d <= d' /\ p <= e ==> d' <= p ==> d <= e")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MEASURE_SUBSET THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL],
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        EXPAND_TAC "box" THEN REWRITE_TAC [MEASURABLE_INTERVAL],
        REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_IMAGE] THEN
        X_GEN_TAC (← q r"z:real^M") THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"(z:real^M) IN k") THEN
        SPEC_TAC (← q r"z:real^M", ← q r"z:real^M") THEN
        REWRITE_TAC [← GSYM SUBSET] THEN MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"ball(tag k:real^M,uv(tag(k:real^M->bool)))") THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
        EXPAND_TAC "box" THEN REWRITE_TAC [SUBSET, IN_BALL, IN_INTERVAL] THEN
        X_GEN_TAC (← q r"z:real^M") THEN REWRITE_TAC [dist] THEN DISCH_TAC THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                     VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        SIMP_TAC [← REAL_ARITH (← q r"x - h <= y /\ y <= x + h <=> abs(x - y) <= h")] THEN
        REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
        ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LT_IMP_LE, REAL_LE_TRANS]],
      ALL_TAC] THEN
    SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    SUBGOAL_THEN (← q r"FINITE(p:(real^M->bool)->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN
    EXISTS_TAC (← q r"mu:real") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"IMAGE (\k. (tag:(real^M->bool)->real^M) k,
                (box(uv(tag k):real) (tag k):real^M->bool)) p")) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [tagged_partial_division_of, fine] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [IN_IMAGE, PAIR_EQ] THEN
      REWRITE_TAC [← MESON []
       (← q r"(!x j. (?k. (x = tag k /\ j = g k) /\ k IN d) ==> P x j) <=>
      (!k. k IN d ==> P (tag k) (g k))")] THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN REPEAT CONJ_TAC THENL
         [EXPAND_TAC "box" THEN REWRITE_TAC [IN_INTERVAL] THEN
          REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                       VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
          GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
           (← q r"&0 < u ==> x - u <= x /\ x <= x + u")) THEN ASM_MESON_TAC [SUBSET],
          ASM_MESON_TAC [SUBSET],
          EXPAND_TAC "box" THEN MESON_TAC []],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [pairwise]) THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k1:real^M->bool") THEN
        ASM_CASES_TAC (← q r"(k1:real^M->bool) IN p") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k2:real^M->bool") THEN
        ASM_CASES_TAC (← q r"(k2:real^M->bool) IN p") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"(tag:(real^M->bool)->real^M) k1 = tag k2") THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [EXPAND_TAC "box" THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
          REWRITE_TAC [SUBSET_INTERVAL] THEN
          REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                       VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x - e <= x + e <=> &0 <= e")] THEN
          SUBGOAL_THEN (← q r"&0 <= uv((tag:(real^M->bool)->real^M) k1) /\
                      &0 <= uv((tag:(real^M->bool)->real^M) k2)")
          STRIP_ASSUME_TAC THENL
           [ASM_MESON_TAC [SUBSET, REAL_LT_IMP_LE], ASM_REWRITE_TAC []] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
          MATCH_MP_TAC MONO_NOT THEN REWRITE_TAC [AND_FORALL_THM] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
          DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
          ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC (← SET_RULE
           (← q r"i1 SUBSET s1 /\ i2 SUBSET s2
          ==> DISJOINT s1 s2 ==> i1 INTER i2 = {}")) THEN
          REWRITE_TAC [INTERIOR_SUBSET]],
        ASM_MESON_TAC [SUBSET]],
      ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"e = e' /\ y <= x ==> x < e ==> y <= e'")) THEN
    CONJ_TAC THENL [REWRITE_TAC [real_div, REAL_MUL_AC], ALL_TAC] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_UNIONS_LE o lhand o snd) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      EXPAND_TAC "box" THEN REWRITE_TAC [MEASURABLE_INTERVAL],
      ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a' <= e ==> a <= a' ==> a <= e")) THEN
    ASM_SIMP_TAC [REAL_LE_RDIV_EQ, ← GSYM SUM_RMUL] THEN
    MATCH_MP_TAC SUM_LE_INCLUDED THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, RIGHT_EXISTS_AND_THM, FINITE_IMAGE] THEN
    REWRITE_TAC [NORM_POS_LE, EXISTS_IN_IMAGE] THEN
    EXISTS_TAC (← q r"SND:real^M#(real^M->bool)->real^M->bool") THEN
    X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"k:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"&0 < uv(tag(k:real^M->bool):real^M):real") ASSUME_TAC
    THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"&0
    < measure(box(uv(tag(k:real^M->bool):real^M):real) (tag k):real^M->bool)")
    MP_TAC THENL
     [EXPAND_TAC "box" THEN
      REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
      REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                   VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x ==> a - x <= a + x")] THEN
      MATCH_MP_TAC PRODUCT_POS_LT_NUMSEG THEN
      REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
    DISCH_THEN (fun th => tactic_of do
     pure (GEN_REWRITE_TAC (funpow 2 RAND_CONV)
      [← MATCH_MP (← REAL_ARITH (← q r"&0 < x ==> x = abs x")) th] THEN
      ASSUME_TAC th)) THEN
    REWRITE_TAC [real_div, ← GSYM REAL_ABS_INV] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM NORM_MUL] THEN
    SUBGOAL_THEN
     (← q r"mu <= dist(i (uv(tag(k:real^M->bool):real^M):real) (tag k):real^N,
               f(tag k))")
    MP_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> m <= x ==> m <= y")) THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN EXPAND_TAC "i" THEN
    REWRITE_TAC [dist, VECTOR_SUB_LDISTRIB] THEN
    UNDISCH_TAC
      (← q r"&0 < measure(box(uv(tag(k:real^M->bool):real^M):real)
                (tag k):real^M->bool)") THEN
    EXPAND_TAC "box" THEN REWRITE_TAC [MEASURE_INTERVAL] THEN
    SIMP_TAC [VECTOR_MUL_ASSOC, REAL_LT_IMP_NZ, REAL_MUL_LINV] THEN
    REWRITE_TAC [VECTOR_MUL_LID])

  pure { INTEGRABLE_CCONTINUOUS_EXPLICIT_SYMMETRIC }

/- ------------------------------------------------------------------------- -/
/- The indefinite integral is differentiable almost everywhere; Lebesgue    -/
/- points.  (measure.ml 6739-6953)                                          -/
/- ------------------------------------------------------------------------- -/

structure MSAA where
  HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL : thm
  ABSOLUTELY_INTEGRABLE_LEBESGUE_POINTS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAA [HolBase] (D : MeasureDeps) (BMSF : MSF) (BMST : MST) (BMSY : MSY) (BMSZ : MSZ) : ExceptT String IO MSAA := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { NEGLIGIBLE_LINEAR_IMAGE, .. } := BMST
  let { INTEGRABLE_CCONTINUOUS_EXPLICIT, .. } := BMSY
  let { INTEGRABLE_CCONTINUOUS_EXPLICIT_SYMMETRIC, .. } := BMSZ
  let { DE_MORGAN_THM, DIFF_EMPTY, FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        NOT_EXISTS_THM, REAL_ABS_INV, REAL_ABS_NUM, REAL_ABS_POS, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_0, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_MIN, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, SKOLEM_THM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_abs, real_div, SUBSET_UNIV, UNIONS_IMAGE, UNWIND_THM1, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_SUB, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_NEG, NORM_POS_LT, REAL_ABS_NORM, .. } :=
        D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, linear, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_NEG_NEG, VECTOR_SUB_EQ,
        VECTOR_SUB_LDISTRIB, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CLOSURE_APPROACHABLE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_RATIONAL_COORDINATES, .. } := D.ig.dv.dg.pt.cvx.top2
  let { IN_INTERVAL_1, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { COUNTABLE_RATIONAL_COORDINATES, .. } := D.ig.dv.dg.qmisc
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { has_vector_derivative, .. } := D.ig.qderivatives
  let { REAL_EQ_RDIV_EQ, .. } := D.ig.qsession
  let { IN_INTERVAL_REFLECT, NORM_REAL, .. } := D.ig.qvec
  let { HAS_DERIVATIVE_WITHIN, .. } := D.qderivatives
  let { ABSOLUTELY_INTEGRABLE_CONST, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_NORM, ABSOLUTELY_INTEGRABLE_SUB, CONTENT_1, CONTENT_POS_LE, ..
        } := D.qintegration1
  let { INTEGRABLE_CONST, INTEGRABLE_ON_SUBINTERVAL, INTEGRABLE_REFLECT,
        INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SUBINTERVAL, .. } := D.qintegration2
  let { INTEGRAL_COMBINE, INTEGRAL_CONST, INTEGRAL_EQ, INTEGRAL_NORM_BOUND_INTEGRAL,
        INTEGRAL_REFLECT, INTEGRAL_SUB, NEGLIGIBLE_UNION, .. } := D.qintegration3
  -- @@SCOPE END

  let HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL ← prove
   r"!f:real^1->real^N a b.
        f integrable_on interval[a,b]
        ==> ?k. negligible k /\
                !x. x IN interval[a,b] DIFF k
                    ==> ((\x. integral(interval[a,x]) f) has_vector_derivative
                         f(x)) (at x within interval[a,b])"
   (SUBGOAL_THEN
     (← q r"!f:real^1->real^N a b.
        f integrable_on interval[a,b]
        ==> ?k. negligible k /\
                !x e. x IN interval[a,b] DIFF k /\ &0 < e
                      ==> ?d. &0 < d /\
                              !x'. x' IN interval[a,b] /\
                                   drop x < drop x' /\ drop x' < drop x + d
                                   ==> norm(integral(interval[x,x']) f -
                                            drop(x' - x) % f x) /
                                       norm(x' - x) < e")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
       (← q r"(\x. if x IN interval[a,b] then f x else vec 0):real^1->real^N")
       INTEGRABLE_CCONTINUOUS_EXPLICIT) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [REPEAT GEN_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"(:real^1)") THEN
        ASM_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV, SUBSET_UNIV],
        ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^1->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"e:real"] THEN
      REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"e:real"]) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"drop y - drop x")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"x + (drop y - drop x) % vec 1 = y") SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_CMUL, DROP_VEC] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_SIMP_TAC [CONTENT_1, REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x < e ==> y < e")) THEN
      ASM_SIMP_TAC [REAL_EQ_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ,
                    ← GSYM DROP_EQ, REAL_LT_IMP_NE] THEN
      SUBGOAL_THEN (← q r"norm(y - x) = abs(drop y - drop x)") SUBST1_TAC THENL
       [REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB], ALL_TAC] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM NORM_MUL)] THEN
      REWRITE_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"x < y ==> (y - x) * inv(y - x) = &1")] THEN
      AP_TERM_TAC THEN REWRITE_TAC [DROP_SUB, VECTOR_MUL_LID] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC INTEGRAL_EQ THEN
      X_GEN_TAC (← q r"z:real^1") THEN REWRITE_TAC [DIFF_EMPTY] THEN DISCH_TAC THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1",
                             ← q r"b:real^1"] th) THEN
      MP_TAC (← ISPECL [← q r"\x. (f:real^1->real^N) (--x)", ← q r"--b:real^1",
                       ← q r"--a:real^1"] th))) THEN
    ASM_REWRITE_TAC [INTEGRABLE_REFLECT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k2:real^1->bool")
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "2"))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k1:real^1->bool")
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1"))) THEN
    EXISTS_TAC (← q r"k1 UNION IMAGE (--) k2:real^1->bool") THEN CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_UNION THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NEGLIGIBLE_LINEAR_IMAGE THEN ASM_REWRITE_TAC [linear] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN
    REWRITE_TAC [IN_IMAGE, ← VECTOR_ARITH (← q r"x:real^1 = --x' <=> --x = x'")] THEN
    REWRITE_TAC [UNWIND_THM1] THEN STRIP_TAC THEN
    REWRITE_TAC [has_vector_derivative, HAS_DERIVATIVE_WITHIN] THEN CONJ_TAC THENL
     [REWRITE_TAC [linear, DROP_ADD, DROP_CMUL] THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REMOVE_THEN "2" (MP_TAC o SPECL [← q r"--x:real^1", ← q r"e:real"]) THEN
    REMOVE_THEN "1" (MP_TAC o SPECL [← q r"x:real^1", ← q r"e:real"]) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_REFLECT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1"))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "2"))) THEN
    EXISTS_TAC (← q r"min d1 d2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"y:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"drop x < drop y \/ drop y < drop x") DISJ_CASES_TAC THENL
     [ASM_REAL_ARITH_TAC,
      REMOVE_THEN "1" (MP_TAC o SPEC (← q r"y:real^1")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x < e ==> y < e")) THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← VECTOR_ARITH (← q r"c + a:real^N = b ==> a = b - c")) THEN
      MATCH_MP_TAC INTEGRAL_COMBINE THEN
      REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      REMOVE_THEN "2" (MP_TAC o SPEC (← q r"--y:real^1")) THEN
      ANTS_TAC THENL [SIMP_TAC [DROP_NEG] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"norm(--y - --x) = abs(drop y - drop x)") SUBST1_TAC THENL
       [REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, DROP_NEG] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x < e ==> y < e")) THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [INTEGRAL_REFLECT] THEN
      REWRITE_TAC [VECTOR_NEG_NEG, DROP_SUB, DROP_NEG] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH
        (← q r"x - (--a - --b) % y:real^N = --(--x - (a - b) % y)")] THEN
      REWRITE_TAC [NORM_NEG] THEN AP_TERM_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← VECTOR_ARITH (← q r"b + a = c ==> --a:real^N = b - c")) THEN
      MATCH_MP_TAC INTEGRAL_COMBINE THEN
      REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC])

  let ABSOLUTELY_INTEGRABLE_LEBESGUE_POINTS ← prove
   r"!f:real^M->real^N.
    (!a b. f absolutely_integrable_on interval[a,b])
    ==> ?k. negligible k /\
            !x e. ~(x IN k) /\ &0 < e
                  ==> ?d. &0 < d /\
                          !h. &0 < h /\ h < d
                             ==> norm(inv(content(interval[x - h % vec 1,
                                                           x + h % vec 1])) %
                                      integral (interval[x - h % vec 1,
                                                         x + h % vec 1])
                                               (\t. lift(norm(f t - f x))))
                                 < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← GEN (← q r"r:real^N") (← ISPEC (← q r"\t. lift(norm((f:real^M->real^N) t - r))")
          INTEGRABLE_CCONTINUOUS_EXPLICIT_SYMMETRIC)) THEN
    REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONO_FORALL) THEN ANTS_TAC THENL
     [REPEAT GEN_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
      ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_CONST],
      ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    X_GEN_TAC (← q r"k:real^N->real^M->bool") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"UNIONS (IMAGE (k:real^N->real^M->bool)
           {x | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(x$i)})") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_RATIONAL_COORDINATES] THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"e:real"] THEN
    REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, NOT_EXISTS_THM] THEN
    REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN STRIP_TAC THEN
    MP_TAC (← SET_RULE (← q r"(f:real^M->real^N) x IN (:real^N)")) THEN
    REWRITE_TAC [← GSYM CLOSURE_RATIONAL_COORDINATES] THEN
    REWRITE_TAC [CLOSURE_APPROACHABLE, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"r:real^N", ← q r"x:real^M", ← q r"e / &3"]) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"h:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"h:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"norm(y1:real^N) < e / &3 /\ norm(i1 - i2) <= e / &3
    ==> norm(i1 - y1) < e / &3 ==> norm(i2) < e")) THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [dist, DIST_SYM], ALL_TAC] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC
     (← q r"abs(inv(content(interval[x - h % vec 1,x + h % vec 1]))) *
    drop(integral (interval[x - h % vec 1,x + h % vec 1])
                  (\x:real^M. lift(e / &3)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
      W (MP_TAC o PART_MATCH (rand o rand) INTEGRAL_SUB o rand o lhand o snd) THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
        ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_CONST],
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
        REWRITE_TAC [INTEGRABLE_CONST] THEN CONJ_TAC THENL
         [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
          MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN CONJ_TAC THEN
          MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
          MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
          ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_CONST],
          X_GEN_TAC (← q r"y:real^M") THEN STRIP_TAC THEN
          REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM, LIFT_DROP, ← GSYM LIFT_SUB] THEN
          ASM_MESON_TAC [← NORM_ARITH
           (← q r"dist(r,x) < e / &3
          ==> abs(norm(y - r:real^N) - norm(y - x)) <= e / &3")]]],
      ASM_CASES_TAC
       (← q r"content(interval[x - h % vec 1:real^M,x + h % vec 1]) = &0")
      THENL
       [ASM_REWRITE_TAC [REAL_INV_0, REAL_ABS_NUM, REAL_MUL_LZERO] THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [REAL_ABS_INV] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ,
                      ← GSYM REAL_ABS_NZ] THEN
        REWRITE_TAC [INTEGRAL_CONST, DROP_CMUL, LIFT_DROP] THEN
        SIMP_TAC [real_abs, CONTENT_POS_LE, REAL_MUL_SYM, REAL_LE_REFL]]])

  pure { HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL,
         ABSOLUTELY_INTEGRABLE_LEBESGUE_POINTS }

/- ------------------------------------------------------------------------- -/
/- Measurability of a function on a set; Lebesgue measurability; relation  -/
/- between measurability and integrability.  (measure.ml 6954-7155)         -/
/- ------------------------------------------------------------------------- -/

structure MSAB where
  measurable_on : thm
  MEASURABLE_ON_UNIV : thm
  lebesgue_measurable : thm
  MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE : thm
  MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE : thm
  MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE : thm
  INTEGRAL_DROP_LE_MEASURABLE : thm
  INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE : thm
  INTEGRABLE_IMP_MEASURABLE : thm
  ABSOLUTELY_INTEGRABLE_MEASURABLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAB [HolBase] (D : MeasureDeps) (BMSY : MSY) : ExceptT String IO MSAB := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_CCONTINUOUS_EXPLICIT, .. } := BMSY
  let { AND_FORALL_THM, COND_ID, COND_RAND, CONJ_ASSOC, DIMINDEX_1, ETA_AX, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS,
        MONO_FORALL, REAL_ABS_DIV, REAL_ABS_INV, REAL_ABS_NUM, REAL_ARCH_INV, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_LE_1, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INV_EQ,
        REAL_LT_LDIV_EQ, REAL_LT_MIN, REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_POS, REAL_POW_LT, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { real_abs, real_div, SUBSET_UNIV, SWAP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, FORALL_1, IN_INTERVAL, LIFT_DROP, NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_on, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_ARITH_TAC, ASM_MESON_TAC, new_definition, NORM_ARITH, parse_as_infix,
        REAL_ARITH, REAL_ARITH_TAC, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { ADD_SUB, REAL_ABS_POW, .. } := D.ig.dv.dg.qsession
  let { LEFT_AND_FORALL_THM, .. } := D.ig.qsession
  let { NORM_REAL, .. } := D.ig.qvec
  let { ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_BOUND, ABSOLUTELY_INTEGRABLE_CONTINUOUS,
        CONTENT_CLOSED_INTERVAL_CASES, DOMINATED_CONVERGENCE_INTEGRABLE, .. } :=
        D.qintegration1
  let { INDEFINITE_INTEGRAL_CONTINUOUS, INTEGRABLE_ALT,
        INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND, INTEGRABLE_ON_SUBINTERVAL,
        INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SPIKE, INTEGRABLE_SPIKE_SET, .. } :=
        D.qintegration2
  let { absolutely_integrable_on, INTEGRAL_DROP_LE, NEGLIGIBLE_SUBSET,
        NONNEGATIVE_ABSOLUTELY_INTEGRABLE, .. } := D.qintegration3
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { REAL_ABS_LE, .. } := D.qsession
  -- @@SCOPE END

  parse_as_infix ("measurable_on", (12, "right"))

  let measurable_on ← new_definition
   r"(f:real^M->real^N) measurable_on s <=>
        ?k g. negligible k /\
              (!n. (g n) continuous_on (:real^M)) /\
              (!x. ~(x IN k)
                   ==> ((\n. g n x) --> if x IN s then f(x) else vec 0)
                       sequentially)"

  let MEASURABLE_ON_UNIV ← prove
   r"(\x.  if x IN s then f(x) else vec 0) measurable_on (:real^M) <=>
   f measurable_on s"
   (REWRITE_TAC [measurable_on, IN_UNIV, ETA_AX])

  let lebesgue_measurable ← new_definition
   r"lebesgue_measurable s <=> (indicator s) measurable_on (:real^N)"

  let MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE ← (do
    let lemma ← prove
     r"!f:real^M->real^N g a b.
          f measurable_on (:real^M) /\
          g integrable_on interval[a,b] /\
          (!x. x IN interval[a,b] ==> norm(f x) <= drop(g x))
          ==> f integrable_on interval[a,b]"
     (REPEAT GEN_TAC THEN REWRITE_TAC [measurable_on, IN_UNIV] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"h:num->real^M->real^N"] THEN
      STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"interval[a:real^M,b] DIFF k") THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         NEGLIGIBLE_SUBSET)) THEN SET_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC DOMINATED_CONVERGENCE_INTEGRABLE THEN
      MAP_EVERY EXISTS_TAC
       [← q r"h:num->real^M->real^N", ← q r"g:real^M->real^1"] THEN
      ASM_SIMP_TAC [IN_DIFF] THEN REWRITE_TAC [LEFT_AND_FORALL_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN
      UNDISCH_TAC (← q r"(g:real^M->real^1) integrable_on interval [a,b]") THEN
      SUBGOAL_THEN
       (← q r"(h:num->real^M->real^N) n absolutely_integrable_on interval[a,b]")
      MP_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_CONTINUOUS THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
        REWRITE_TAC [IMP_IMP, absolutely_integrable_on, ← GSYM CONJ_ASSOC] THEN
        REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
        MATCH_MP_TAC INTEGRABLE_SPIKE_SET THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         NEGLIGIBLE_SUBSET)) THEN SET_TAC []])
    prove
     r"!f:real^M->real^N g s.
        f measurable_on s /\
        g integrable_on s /\
        (!x. x IN s ==> norm(f x) <= drop(g x))
        ==> f integrable_on s"
     (ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND THEN
      EXISTS_TAC (← q r"g:real^M->real^1") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
      MATCH_MP_TAC lemma THEN
      EXISTS_TAC (← q r"(\x. if x IN s then g x else vec 0):real^M->real^1") THEN
      RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_ALT]) THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [NORM_0, DROP_VEC, REAL_POS]))

  let MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE ← prove
   r"!f:real^M->real^N g s k.
        f measurable_on s /\ g integrable_on s /\ negligible k /\
        (!x. x IN s DIFF k ==> norm(f x) <= drop(g x))
        ==> f integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN EXISTS_TAC
     (← q r"\x. if x IN k then lift(norm((f:real^M->real^N) x)) else g x") THEN
    ASM_SIMP_TAC [COND_RAND, IN_DIFF, LIFT_DROP, REAL_LE_REFL, COND_ID] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
    MAP_EVERY EXISTS_TAC [← q r"g:real^M->real^1", ← q r"k:real^M->bool"] THEN
    ASM_SIMP_TAC [IN_DIFF])

  let MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE ← prove
   r"!f:real^M->real^N g s.
        f measurable_on s /\
        g integrable_on s /\
        (!x. x IN s ==> norm(f x) <= drop(g x))
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"g:real^M->real^1"]
      ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_BOUND) THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN
      ASM_MESON_TAC [REAL_ABS_LE, REAL_LE_TRANS],
      ASM_MESON_TAC [MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE],
      MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      ASM_REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, ← GSYM drop] THEN
      ASM_MESON_TAC [← NORM_ARITH (← q r"norm(x) <= a ==> &0 <= a")]])

  let INTEGRAL_DROP_LE_MEASURABLE ← prove
   r"!f g s:real^N->bool.
        f measurable_on s /\
        g integrable_on s /\
        (!x. x IN s ==> &0 <= drop(f x) /\ drop(f x) <= drop(g x))
        ==> drop(integral s f) <= drop(integral s g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"g:real^N->real^1") THEN
    ASM_SIMP_TAC [NORM_REAL, ← GSYM drop, real_abs])

  let INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE ← prove
   r"!f:real^M->real^N.
        (!a b. f integrable_on interval[a,b]) ==> f measurable_on (:real^M)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [measurable_on, IN_UNIV] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"box = \h x. interval[x:real^M,x + h % vec 1]",
      ← q r"i = \h:real x:real^M. inv(content(box h x)) %
                      integral (box h x) (f:real^M->real^N)"] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    EXISTS_TAC (← q r"(\n x. i (inv(&n + &1)) x):num->real^M->real^N") THEN
    REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [continuous_on, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M", ← q r"e:real"] THEN
      DISCH_TAC THEN EXPAND_TAC "i" THEN EXPAND_TAC "box" THEN
      MP_TAC (← ISPECL
       [← q r"f:real^M->real^N",
        ← q r"x - &2 % vec 1:real^M",
        ← q r"x + &2 % vec 1:real^M",
        ← q r"x:real^M",
        ← q r"x + inv(&n + &1) % vec 1:real^M",
        ← q r"e * (&1 / (&n + &1)) pow dimindex(:M)"]
       INDEFINITE_INTEGRAL_CONTINUOUS) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [IN_INTERVAL, VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT,
          REAL_MUL_RID, VECTOR_MUL_COMPONENT, VEC_COMPONENT] THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"&0 <= inv(&n + &1) /\ inv(&n + &1) <= &1") MP_TAC THENL
           [ALL_TAC, REAL_ARITH_TAC] THEN
          ASM_REWRITE_TAC [REAL_LE_INV_EQ, ← REAL_ARITH (← q r"&0 <= &n + &1")] THEN
          MATCH_MP_TAC REAL_INV_LE_1 THEN REAL_ARITH_TAC,
          MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC REAL_POW_LT THEN MATCH_MP_TAC REAL_LT_DIV THEN
          REAL_ARITH_TAC],
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"min k (&1)") THEN
        ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_01] THEN
        ASM_REWRITE_TAC [dist] THEN X_GEN_TAC (← q r"y:real^M") THEN DISCH_TAC THEN
        REWRITE_TAC [CONTENT_CLOSED_INTERVAL_CASES] THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                     VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a <= a + x <=> &0 <= x")] THEN
        REWRITE_TAC [REAL_LE_INV_EQ, ← REAL_ARITH (← q r"&0 <= &n + &1")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(x + inv y) - x = &1 / y")] THEN
        REWRITE_TAC [PRODUCT_CONST_NUMSEG, ADD_SUB] THEN
        REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
        REWRITE_TAC [REAL_ABS_INV, REAL_ABS_POW, REAL_ABS_DIV] THEN
        REWRITE_TAC [REAL_ABS_NUM, ← REAL_ARITH (← q r"abs(&n + &1) = &n + &1")] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
        ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_DIV, REAL_POW_LT,
                      ← REAL_ARITH (← q r"&0 < &1 /\ &0 < &n + &1")] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"(y + i) - (x + i):real^N = y - x"),
                     ← VECTOR_ARITH (← q r"(y - i) - (x - i):real^N = y - x")] THEN
        ASM_SIMP_TAC [IN_INTERVAL, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, dist,
                     VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"i:num") THEN
        ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:M)") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= i /\ i <= &1 /\ abs(x - y) <= &1
        ==> (x - &2 <= y /\ y <= x + &2) /\
            (x - &2 <= y + i /\ y + i <= x + &2)")) THEN
        ASM_SIMP_TAC [REAL_LE_INV_EQ, REAL_INV_LE_1,
                      ← REAL_ARITH (← q r"&0 <= &n + &1 /\ &1 <= &n + &1")] THEN
        REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
        ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LT_IMP_LE, NORM_SUB,
                       REAL_LE_TRANS]],
      FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_CCONTINUOUS_EXPLICIT) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
      ASM_CASES_TAC (← q r"negligible(k:real^M->bool)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"d:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MAP_EVERY EXPAND_TAC ["i", "box"] THEN REWRITE_TAC [dist] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC])

  let INTEGRABLE_IMP_MEASURABLE ← prove
   r"!f:real^M->real^N s.
        f integrable_on s ==> f measurable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV, ← GSYM MEASURABLE_ON_UNIV] THEN
    SPEC_TAC (← q r"\x. if x IN s then (f:real^M->real^N) x else vec 0",
             ← q r"f:real^M->real^N") THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV])

  let ABSOLUTELY_INTEGRABLE_MEASURABLE ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s <=>
        f measurable_on s /\ (\x. lift(norm(f x))) integrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_integrable_on] THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> b) /\ (b /\ c ==> a) ==> (a /\ c <=> b /\ c)")) THEN
    REWRITE_TAC [INTEGRABLE_IMP_MEASURABLE] THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE THEN
    EXISTS_TAC (← q r"\x. lift(norm((f:real^M->real^N) x))") THEN
    ASM_REWRITE_TAC [LIFT_DROP, REAL_LE_REFL])

  pure { measurable_on, MEASURABLE_ON_UNIV, lebesgue_measurable,
         MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_INTEGRABLE,
         MEASURABLE_BOUNDED_AE_BY_INTEGRABLE_IMP_INTEGRABLE,
         MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE,
         INTEGRAL_DROP_LE_MEASURABLE, INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE,
         INTEGRABLE_IMP_MEASURABLE, ABSOLUTELY_INTEGRABLE_MEASURABLE }

/- ------------------------------------------------------------------------- -/
/- Composing continuous and measurable functions; a few variants.          -/
/- (measure.ml 7186-7350)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSAC where
  MEASURABLE_ON_COMPOSE_CONTINUOUS : thm
  MEASURABLE_ON_COMPOSE_CONTINUOUS_0 : thm
  MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL : thm
  MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET : thm
  MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAC [HolBase] (D : MeasureDeps) (BMSAB : MSAB) : ExceptT String IO MSAC := do
  -- @@SCOPE BEGIN
  let { measurable_on, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { CART_EQ, EQ_IMP, ETA_AX, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ_ALT, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LAMBDA_BETA, LE_1, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        REAL_ABS_INV, REAL_ABS_NUM, REAL_ARCH_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_LMUL, REAL_LET_TRANS, REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, .. }
        := D.ig.dv.dg.pt.cvx.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, LIFT_ADD, LIFT_CMUL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_RID, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_IN, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.top3
  let { LIM_ADD, LIM_CMUL, LIM_CONST, LIM_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC,
        VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { real_sub, .. } := D.ig.dv.dg.pt.qses
  let { VECTOR_NEG_0, .. } := D.ig.dv.dg.pt.qvec
  let { TIETZE_UNBOUNDED, .. } := D.ig.dv.dg.qconvex
  let { CONTINUOUS_ON_MAX, .. } := D.ig.dv.dg.qtopology1
  let { LIFT_NEG, .. } := D.ig.dv.dg.qvec
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONTINUOUS_ON_SEQUENTIALLY, .. } :=
        D.ig.dv.qtopology1
  let { LIM_COMPONENTWISE_LIFT, .. } := D.ig.dv.qtopology2
  let { LIM_NEG, .. } := D.ig.qtopology
  let { CONTINUOUS_ON_MIN, .. } := D.qtopology1
  let { LIM_CONTINUOUS_FUNCTION, LIM_MAX, LIM_MIN, .. } := D.qtopology2
  -- @@SCOPE END

  let MEASURABLE_ON_COMPOSE_CONTINUOUS ← prove
   r"!f:real^M->real^N g:real^N->real^P.
        f measurable_on (:real^M) /\ g continuous_on (:real^N)
        ==> (g o f) measurable_on (:real^M)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [measurable_on, IN_UNIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n x. (g:real^N->real^P) ((h:num->real^M->real^N) n x)") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [ETA_AX] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
       [CONTINUOUS_ON_SEQUENTIALLY]) THEN
      ASM_SIMP_TAC [o_DEF, IN_UNIV]])

  let MEASURABLE_ON_COMPOSE_CONTINUOUS_0 ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        f measurable_on s /\ g continuous_on (:real^N) /\ g(vec 0) = vec 0
        ==> (g o f) measurable_on s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    DISCH_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_COMPOSE_CONTINUOUS) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, o_DEF] THEN ASM_MESON_TAC [])

  let MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL ← prove
   r"!f:real^M->real^N g:real^N->real^P a b.
        f measurable_on (:real^M) /\
        (!x. f(x) IN interval(a,b)) /\
        g continuous_on interval(a,b)
        ==> (g o f) measurable_on (:real^M)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [measurable_on, IN_UNIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"(\n x. (g:real^N->real^P)
           (lambda i. max ((a:real^N)$i + (b$i - a$i) / (&n + &2))
                          (min ((h n x:real^N)$i)
                               ((b:real^N)$i - (b$i - a$i) / (&n + &2)))))
    :num->real^M->real^P") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL
         [← q r"(:real^M)",
          ← q r"(lambda i. (b:real^N)$i - (b$i - (a:real^N)$i) / (&n + &2)):real^N"]
           CONTINUOUS_ON_CONST) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
        REWRITE_TAC [IMP_IMP] THEN
        DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MIN) THEN
        MP_TAC (← ISPECL
         [← q r"(:real^M)",
          ← q r"(lambda i. (a:real^N)$i + ((b:real^N)$i - a$i) / (&n + &2)):real^N"]
           CONTINUOUS_ON_CONST) THEN
        REWRITE_TAC [IMP_IMP] THEN
        DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_ON_MAX) THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA],
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval(a:real^N,b)") THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M") o CONJUNCT1) THEN
        SIMP_TAC [IN_INTERVAL, LAMBDA_BETA] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
        MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN DISCH_TAC THEN
        SUBGOAL_THEN
          (← q r"&0 < ((b:real^N)$i - (a:real^N)$i) / (&n + &2) /\
         ((b:real^N)$i - (a:real^N)$i) / (&n + &2) <= (b$i - a$i) / &2") MP_TAC
        THENL [ALL_TAC, REAL_ARITH_TAC] THEN
        ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_LT_LDIV_EQ,
                      ← REAL_ARITH (← q r"&0 < &n + &2")] THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [real_div]] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC THENL
         [ASM_REAL_ARITH_TAC,
          MATCH_MP_TAC REAL_LE_INV2 THEN REAL_ARITH_TAC]],
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC LIM_CONTINUOUS_FUNCTION THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_INTERVAL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"((\n. (lambda i. ((a:real^N)$i + ((b:real^N)$i - a$i) / (&n + &2))))
       --> a) sequentially /\
      ((\n. (lambda i. ((b:real^N)$i - ((b:real^N)$i - a$i) / (&n + &2))))
       --> b) sequentially")
      MP_TAC THENL
       [ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT] THEN
        SIMP_TAC [LAMBDA_BETA] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        REWRITE_TAC [real_sub] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
        REWRITE_TAC [LIFT_ADD] THEN MATCH_MP_TAC LIM_ADD THEN
        REWRITE_TAC [LIM_CONST, LIFT_NEG, real_div, LIFT_CMUL] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_NEG_0] THEN
        TRY (MATCH_MP_TAC LIM_NEG) THEN REWRITE_TAC [VECTOR_NEG_0] THEN
        SUBST1_TAC (← VECTOR_ARITH
         (← q r"vec 0:real^1 = ((b:real^N)$j + --((a:real^N)$j)) % vec 0")) THEN
        MATCH_MP_TAC LIM_CMUL THEN
        REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0, NORM_LIFT] THEN
        X_GEN_TAC (← q r"e:real") THEN
        GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN REWRITE_TAC [REAL_ABS_INV] THEN
        MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
        ASM_SIMP_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LT, LE_1,
                      REAL_OF_NUM_LE, REAL_ABS_NUM] THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [← TAUT (← q r"a ==> b /\ c ==> d <=> a /\ c ==> b ==> d")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LIM_MIN) THEN
      REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LIM_MAX) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA, FUN_EQ_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL]) THEN
      ASM_MESON_TAC [← REAL_ARITH (← q r"a < x /\ x < b ==> max a (min x b) = x")]])

  let MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        closed s /\
        f measurable_on (:real^M) /\
        (!x. f(x) IN s) /\
        g continuous_on s
        ==> (g o f) measurable_on (:real^M)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^P", ← q r"(:real^N)", ← q r"s:real^N->bool"]
      TIETZE_UNBOUNDED) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN] THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"h:real^N->real^P") THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"(g:real^N->real^P) o (f:real^M->real^N) = h o f") SUBST1_TAC
    THENL [ASM_SIMP_TAC [FUN_EQ_THM, o_THM], ALL_TAC] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS THEN ASM_REWRITE_TAC [])

  let MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0 ← prove
   r"!f:real^M->real^N g:real^N->real^P s t.
        closed s /\
        f measurable_on t /\
        (!x. f(x) IN s) /\
        g continuous_on s /\
        vec 0 IN s /\ g(vec 0) = vec 0
        ==> (g o f) measurable_on t"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    MP_TAC (← ISPECL [← q r"(\x. if x IN t then f x else vec 0):real^M->real^N",
                     ← q r"g:real^N->real^P", ← q r"s:real^N->bool"]
          MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [MEASURABLE_ON_UNIV] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM] THEN ASM_MESON_TAC []])

  pure { MEASURABLE_ON_COMPOSE_CONTINUOUS, MEASURABLE_ON_COMPOSE_CONTINUOUS_0,
         MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL,
         MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET,
         MEASURABLE_ON_COMPOSE_CONTINUOUS_CLOSED_SET_0 }

/- ------------------------------------------------------------------------- -/
/- Basic closure properties of measurable functions.  (measure.ml 7351-7470)-/
/- ------------------------------------------------------------------------- -/

structure MSAD where
  CONTINUOUS_IMP_MEASURABLE_ON : thm
  MEASURABLE_ON_CONST : thm
  MEASURABLE_ON_0 : thm
  MEASURABLE_ON_CMUL : thm
  MEASURABLE_ON_CMUL_EQ : thm
  MEASURABLE_ON_NEG : thm
  MEASURABLE_ON_NEG_EQ : thm
  MEASURABLE_ON_NORM : thm
  MEASURABLE_ON_LIFT_ABS : thm
  MEASURABLE_ON_PASTECART : thm
  MEASURABLE_ON_COMBINE : thm
  MEASURABLE_ON_ADD : thm
  MEASURABLE_ON_SUB : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAD [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAC : MSAC) : ExceptT String IO MSAD := do
  -- @@SCOPE BEGIN
  let { measurable_on, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_COMPOSE_CONTINUOUS_0, .. } := BMSAC
  let { COND_ID, DE_MORGAN_THM, ETA_AX, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNION, IN_UNIV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_LINV, SNDCART_PASTECART, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { LIFT_NUM, LINEAR_FSTCART, LINEAR_SNDCART, NORM_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, PASTECART_VEC, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, VECTOR_NEG_NEG, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, .. } :=
        D.ig.dv.dg.pt.cvx.top3
  let { LIM_CONST, LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_on, .. } := D.ig.dv.dg.pt.cvx.top5
  let { NORM_ARITH_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { FSTCART_VEC, SNDCART_VEC, .. } := D.ig.dv.dg.pt.qvec
  let { CONTINUOUS_ON_CMUL, CONTINUOUS_ON_PASTECART, .. } := D.ig.dv.dg.qtopology1
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_UNION, .. } := D.qintegration3
  let { LIM_PASTECART, .. } := D.qtopology2
  -- @@SCOPE END

  let CONTINUOUS_IMP_MEASURABLE_ON ← prove
   r"!f:real^M->real^N. f continuous_on (:real^M) ==> f measurable_on (:real^M)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [measurable_on, IN_UNIV] THEN
    EXISTS_TAC (← q r"{}:real^M->bool") THEN REWRITE_TAC [NEGLIGIBLE_EMPTY] THEN
    EXISTS_TAC (← q r"\n:num. (f:real^M->real^N)") THEN
    ASM_REWRITE_TAC [LIM_CONST])

  let MEASURABLE_ON_CONST ← prove
   r"!k:real^N. (\x. k) measurable_on (:real^M)"
   (SIMP_TAC [CONTINUOUS_IMP_MEASURABLE_ON, CONTINUOUS_ON_CONST])

  let MEASURABLE_ON_0 ← prove
   r"!s. (\x. vec 0) measurable_on s"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [MEASURABLE_ON_CONST, COND_ID])

  let MEASURABLE_ON_CMUL ← prove
   r"!c f:real^M->real^N s.
        f measurable_on s ==> (\x. c % f x) measurable_on s"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS_0 THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RZERO] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
    SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID])

  let MEASURABLE_ON_CMUL_EQ ← prove
   r"!f:real^M->real^N s c.
        (\x. c % f x) measurable_on s <=> c = &0 \/ f measurable_on s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, MEASURABLE_ON_0] THEN
    EQ_TAC THEN REWRITE_TAC [MEASURABLE_ON_CMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP MEASURABLE_ON_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV] THEN
    REWRITE_TAC [VECTOR_MUL_LID, ETA_AX])

  let MEASURABLE_ON_NEG ← prove
   r"!f:real^M->real^N s.
     f measurable_on s ==> (\x. --(f x)) measurable_on s"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = --(&1) % x"),
                 MEASURABLE_ON_CMUL])

  let MEASURABLE_ON_NEG_EQ ← prove
   r"!f:real^M->real^N s. (\x. --(f x)) measurable_on s <=> f measurable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_NEG) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX])

  let MEASURABLE_ON_NORM ← prove
   r"!f:real^M->real^N s.
        f measurable_on s ==> (\x. lift(norm(f x))) measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"\x:real^N. lift(norm x)") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] MEASURABLE_ON_COMPOSE_CONTINUOUS_0)) THEN
    REWRITE_TAC [o_DEF, NORM_0, LIFT_NUM] THEN DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [continuous_on, IN_UNIV, DIST_LIFT] THEN
    GEN_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let MEASURABLE_ON_LIFT_ABS ← prove
   r"!f:real^N->real s.
        (\x. lift(f x)) measurable_on s
        ==> (\x. lift(abs(f x))) measurable_on s"
   (REWRITE_TAC [← GSYM NORM_LIFT, MEASURABLE_ON_NORM])

  let MEASURABLE_ON_PASTECART ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        f measurable_on s /\ g measurable_on s
        ==> (\x. pastecart (f x) (g x)) measurable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [measurable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"k1:real^M->bool") MP_TAC)
     (X_CHOOSE_THEN (← q r"k2:real^M->bool") MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g2:num->real^M->real^P") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g1:num->real^M->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"k1 UNION k2:real^M->bool") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_UNION] THEN
    EXISTS_TAC (← q r"(\n x. pastecart (g1 n x) (g2 n x))
              :num->real^M->real^(N,P)finite_sum") THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_PASTECART, ETA_AX, IN_UNION, DE_MORGAN_THM] THEN
    X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
    ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN
    REWRITE_TAC [← GSYM PASTECART_VEC] THEN ASM_SIMP_TAC [LIM_PASTECART])

  let MEASURABLE_ON_COMBINE ← prove
   r"!h:real^N->real^P->real^Q f:real^M->real^N g:real^M->real^P s.
        f measurable_on s /\ g measurable_on s /\
        (\x. h (fstcart x) (sndcart x)) continuous_on UNIV /\
        h (vec 0) (vec 0) = vec 0
        ==> (\x. h (f x) (g x)) measurable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x:real^M. (h:real^N->real^P->real^Q) (f x) (g x)) =
    (\x. h (fstcart x) (sndcart x)) o (\x. pastecart (f x) (g x))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, FSTCART_PASTECART, SNDCART_PASTECART, o_THM],
      MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS_0 THEN
      ASM_SIMP_TAC [MEASURABLE_ON_PASTECART, FSTCART_VEC, SNDCART_VEC]])

  let MEASURABLE_ON_ADD ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f measurable_on s /\ g measurable_on s
        ==> (\x. f x + g x) measurable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_COMBINE THEN
    ASM_REWRITE_TAC [VECTOR_ADD_LID] THEN MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
    CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  let MEASURABLE_ON_SUB ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f measurable_on s /\ g measurable_on s
        ==> (\x. f x - g x) measurable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_ON_COMBINE THEN
    ASM_REWRITE_TAC [VECTOR_SUB_RZERO] THEN MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
    CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART])

  pure { CONTINUOUS_IMP_MEASURABLE_ON, MEASURABLE_ON_CONST, MEASURABLE_ON_0,
         MEASURABLE_ON_CMUL, MEASURABLE_ON_CMUL_EQ, MEASURABLE_ON_NEG,
         MEASURABLE_ON_NEG_EQ, MEASURABLE_ON_NORM, MEASURABLE_ON_LIFT_ABS,
         MEASURABLE_ON_PASTECART, MEASURABLE_ON_COMBINE, MEASURABLE_ON_ADD,
         MEASURABLE_ON_SUB }

/- ------------------------------------------------------------------------- -/
/- More closure properties of measurable functions: max, min, products,    -/
/- sums, components, spikes, restriction and cases.  (measure.ml 7471-7740) -/
/- ------------------------------------------------------------------------- -/

structure MSAE where
  MEASURABLE_ON_MAX : thm
  MEASURABLE_ON_MIN : thm
  MEASURABLE_ON_DROP_MUL : thm
  MEASURABLE_ON_LIFT_MUL : thm
  MEASURABLE_ON_MUL : thm
  MEASURABLE_ON_VSUM : thm
  MEASURABLE_ON_COMPONENTWISE : thm
  MEASURABLE_ON_CONST_EQ : thm
  MEASURABLE_ON_LIFT_POW : thm
  MEASURABLE_ON_LIFT_PRODUCT : thm
  MEASURABLE_ON_SPIKE : thm
  MEASURABLE_ON_SPIKE_SET : thm
  MEASURABLE_ON_SPIKE_SET_EQ : thm
  MEASURABLE_ON_EQ : thm
  MEASURABLE_ON_RESTRICT : thm
  MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET : thm
  MEASURABLE_ON_OPEN_INTERVAL : thm
  MEASURABLE_ON_CASES : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAE [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAC : MSAC) (BMSAD : MSAD) : ExceptT String IO MSAE := do
  -- @@SCOPE BEGIN
  let { lebesgue_measurable, measurable_on, MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_COMPOSE_CONTINUOUS, .. } := BMSAC
  let { MEASURABLE_ON_0, MEASURABLE_ON_ADD, MEASURABLE_ON_CMUL, MEASURABLE_ON_COMBINE,
        MEASURABLE_ON_CONST, MEASURABLE_ON_NEG, MEASURABLE_ON_SUB, .. } := BMSAD
  let { CART_EQ, COND_RAND, COND_RATOR, CONJ_SYM, DE_MORGAN_THM, EQ_IMP, ETA_AX,
        EXISTS_IN_IMAGE, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV, LAMBDA_BETA,
        LAMBDA_ETA, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_INSERT_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { num_INDUCTION, o_DEF, real_pow, SWAP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { dist, VEC_COMPONENT, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_RZERO,
        VECTOR_NEG_COMPONENT, VECTOR_SUB_COMPONENT, VSUM_CLAUSES, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_MUL, .. } := D.ig.dv.dg.pt.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_on, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_LIFT_COMPONENT, .. } :=
        D.ig.dv.dg.qtopology1
  let { LIM_COMPONENTWISE_LIFT, .. } := D.ig.dv.qtopology2
  let { NOT_SUC, PRODUCT_CLAUSES, .. } := D.ig.qsession
  let { indicator, .. } := D.ig.qvec
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_FRONTIER_INTERVAL, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNION, NEGLIGIBLE_UNIONS, .. } := D.qintegration3
  let { FSTCART_SUB, NORM_FSTCART, NORM_SNDCART, SNDCART_SUB, .. } := D.qvec
  -- @@SCOPE END

  let MEASURABLE_ON_MAX ← (do
    let lemma ← REWRITE_RULE []
     (← ISPEC (← q r"(\x y. lambda i. max (x$i) (y$i)):real^N->real^N->real^N")
            MEASURABLE_ON_COMBINE)
    prove
     r"!f:real^M->real^N g:real^M->real^N s.
      f measurable_on s /\ g measurable_on s
      ==> (\x. (lambda i. max ((f x)$i) ((g x)$i)):real^N)
          measurable_on s"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"max x x = x"), LAMBDA_ETA] THEN
      SIMP_TAC [continuous_on, LAMBDA_BETA, IN_UNIV, DIST_LIFT] THEN
      GEN_TAC THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^(N,N)finite_sum", ← q r"e:real"] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [dist] THEN
      X_GEN_TAC (← q r"y:real^(N,N)finite_sum") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x - y) < e /\ abs(x' - y') < e
    ==> abs(max x x' - max y y') < e")) THEN
      REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN CONJ_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"norm(x) < e /\ abs(x$i) <= norm x ==> abs(x$i) < e")) THEN
      ASM_SIMP_TAC [COMPONENT_LE_NORM, ← GSYM FSTCART_SUB, ← GSYM SNDCART_SUB] THEN
      ASM_MESON_TAC [REAL_LET_TRANS, NORM_FSTCART, NORM_SNDCART]))

  let MEASURABLE_ON_MIN ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
      f measurable_on s /\ g measurable_on s
      ==> (\x. (lambda i. min ((f x)$i) ((g x)$i)):real^N)
          measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_NEG)) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_MAX) THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_NEG) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN
    SIMP_TAC [CART_EQ, VECTOR_NEG_COMPONENT, LAMBDA_BETA] THEN REAL_ARITH_TAC)

  let MEASURABLE_ON_DROP_MUL ← (do
    let lemma ← REWRITE_RULE []
     (← ISPEC (← q r"\x y. drop x % y :real^N") MEASURABLE_ON_COMBINE)
    prove
     r"!f g:real^M->real^N s.
      f measurable_on s /\ g measurable_on s
      ==> (\x. drop(f x) % g x) measurable_on s"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_REWRITE_TAC [VECTOR_MUL_RZERO] THEN MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [o_DEF, ETA_AX, LIFT_DROP] THEN
      CONJ_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
      REWRITE_TAC [LINEAR_FSTCART, LINEAR_SNDCART]))

  let MEASURABLE_ON_LIFT_MUL ← prove
   r"!f g s. (\x. lift(f x)) measurable_on s /\
           (\x. lift(g x)) measurable_on s
           ==> (\x. lift(f x * g x)) measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_DROP_MUL) THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_DROP])

  let MEASURABLE_ON_MUL ← prove
   r"!f g s. (\x. lift(f x)) measurable_on s /\ g measurable_on s
           ==> (\x. f x % g x) measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_DROP_MUL) THEN
    REWRITE_TAC [LIFT_DROP])

  let MEASURABLE_ON_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\ (!i. i IN t ==> (f i) measurable_on s)
        ==> (\x. vsum t (\i. f i x)) measurable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, MEASURABLE_ON_0, MEASURABLE_ON_ADD, IN_INSERT,
              ETA_AX])

  let MEASURABLE_ON_COMPONENTWISE ← (do
    let lemma ← prove
     r"!f:real^M->real^N.
          f measurable_on (:real^M) <=>
          (!i. 1 <= i /\ i <= dimindex(:N)
               ==> (\x. lift(f x$i)) measurable_on (:real^M))"
     (REPEAT GEN_TAC THEN EQ_TAC THENL
       [REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
         ISPEC (← q r"\x:real^N. lift(x$i)") o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] MEASURABLE_ON_COMPOSE_CONTINUOUS)) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT, o_DEF],
        ALL_TAC] THEN
      REWRITE_TAC [measurable_on, IN_UNIV] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"k:num->real^M->bool", ← q r"g:num->num->real^M->real^1"] THEN
      DISCH_TAC THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE k (1..dimindex(:N))):real^M->bool") THEN
      EXISTS_TAC (← q r"(\n x. lambda i. drop(g i n x)):num->real^M->real^N") THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
        ASM_SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, FORALL_IN_IMAGE, FINITE_IMAGE],
        GEN_TAC THEN ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
        ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX],
        X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE] THEN
        REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(a /\ b) <=> a ==> ~b")] THEN
        REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
        ONCE_REWRITE_TAC [LIM_COMPONENTWISE_LIFT] THEN
        ASM_SIMP_TAC [LAMBDA_BETA, LIFT_DROP, ETA_AX]])
    prove
     r"!f:real^M->real^N s.
        f measurable_on s <=>
        (!i. 1 <= i /\ i <= dimindex (:N)
             ==> (\x. lift (f x$i)) measurable_on s)"
     (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
      GEN_REWRITE_TAC LAND_CONV [lemma] THEN
      REWRITE_TAC [COND_RAND, COND_RATOR, VEC_COMPONENT, LIFT_NUM]))

  let MEASURABLE_ON_CONST_EQ ← prove
   r"!s:real^M->bool c:real^N.
        (\x. c) measurable_on s <=> c = vec 0 \/ lebesgue_measurable s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c:real^N = vec 0") THEN
    ASM_REWRITE_TAC [MEASURABLE_ON_0] THEN
    ONCE_REWRITE_TAC [MEASURABLE_ON_COMPONENTWISE] THEN EQ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [VEC_COMPONENT] THEN STRIP_TAC THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv((c:real^N)$i)") o
        MATCH_MP MEASURABLE_ON_CMUL) THEN
      ASM_SIMP_TAC [← GSYM LIFT_CMUL, REAL_MUL_LINV, LIFT_NUM] THEN
      ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
      REWRITE_TAC [lebesgue_measurable, indicator],
      REWRITE_TAC [lebesgue_measurable, indicator, MEASURABLE_ON_UNIV] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(c:real^N)$i") o
        MATCH_MP MEASURABLE_ON_CMUL) THEN
      REWRITE_TAC [← GSYM LIFT_NUM, ← GSYM LIFT_CMUL, REAL_MUL_RID]])

  let MEASURABLE_ON_LIFT_POW ← prove
   r"!f:real^M->real s n.
        (\x. lift(f x)) measurable_on s /\ (n = 0 ==> lebesgue_measurable s)
        ==> (\x. lift(f x pow n)) measurable_on s"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC num_INDUCTION THEN
    SIMP_TAC [MEASURABLE_ON_CONST_EQ, ← CONJUNCT1 real_pow] THEN
    X_GEN_TAC (← q r"n:num") THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_CASES_TAC (← q r"lebesgue_measurable(s:real^M->bool)") THEN
    ASM_REWRITE_TAC [NOT_SUC, real_pow, REAL_MUL_RID] THEN
    ASM_SIMP_TAC [MEASURABLE_ON_LIFT_MUL])

  let MEASURABLE_ON_LIFT_PRODUCT ← prove
   r"!f:A->real^N->real s t.
         FINITE t /\ (t = {} ==> lebesgue_measurable s) /\
         (!i. i IN t ==> (\x. lift(f i x)) measurable_on s)
         ==> (\x. lift(product t (\i. f i x))) measurable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, MEASURABLE_ON_CONST_EQ] THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_INSERT_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_SIMP_TAC [PRODUCT_CLAUSES, REAL_MUL_RID, ETA_AX] THEN
    MATCH_MP_TAC MEASURABLE_ON_LIFT_MUL THEN ASM_REWRITE_TAC [ETA_AX] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  let MEASURABLE_ON_SPIKE ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN t DIFF s ==> g x = f x)
        ==> f measurable_on t ==> g measurable_on t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    REWRITE_TAC [measurable_on] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"s UNION k:real^M->bool") THEN
    ASM_SIMP_TAC [DE_MORGAN_THM, IN_UNION, NEGLIGIBLE_UNION])

  let MEASURABLE_ON_SPIKE_SET ← prove
   r"!f:real^M->real^N s t.
        negligible (s DIFF t UNION t DIFF s)
        ==> f measurable_on s
            ==> f measurable_on t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [measurable_on] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"g:num->real^M->real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"k UNION (s DIFF t UNION t DIFF s):real^M->bool") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_UNION, IN_UNION, DE_MORGAN_THM] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let MEASURABLE_ON_SPIKE_SET_EQ ← prove
   r"!f:real^M->real^N s t.
        negligible (s DIFF t UNION t DIFF s)
        ==> (f measurable_on s <=> f measurable_on t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET THEN
    POP_ASSUM MP_TAC THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN SET_TAC [])

  let MEASURABLE_ON_EQ ← prove
   r"!f g:real^M->real^N s.
        (!x. x IN s ==> f x = g x) /\ f measurable_on s
        ==> g measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MEASURABLE_ON_SPIKE THEN
    EXISTS_TAC (← q r"{}:real^M->bool") THEN
    REWRITE_TAC [NEGLIGIBLE_EMPTY] THEN ASM SET_TAC [])

  let MEASURABLE_ON_RESTRICT ← prove
   r"!f:real^M->real^N s.
        f measurable_on (:real^M) /\ lebesgue_measurable s
        ==> (\x. if x IN s then f(x) else vec 0) measurable_on (:real^M)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [lebesgue_measurable, indicator] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_DROP_MUL) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [DROP_VEC] THEN VECTOR_ARITH_TAC)

  let MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET ← prove
   r"!f s t. s SUBSET t /\ f measurable_on t /\
           lebesgue_measurable s
           ==> f measurable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [IN_UNIV] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_RESTRICT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN ASM SET_TAC [])

  let MEASURABLE_ON_OPEN_INTERVAL ← prove
   r"!f:real^M->real^N a b.
        f measurable_on interval(a,b) <=> f measurable_on interval[a,b]"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MEASURABLE_ON_SPIKE_SET_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"interval[a:real^M,b] DIFF interval(a,b)") THEN
    REWRITE_TAC [NEGLIGIBLE_FRONTIER_INTERVAL] THEN
    MP_TAC (← ISPECL [← q r"a:real^M", ← q r"b:real^M"] INTERVAL_OPEN_SUBSET_CLOSED) THEN
    SET_TAC [])

  let MEASURABLE_ON_CASES ← prove
   r"!P f g:real^M->real^N s.
        lebesgue_measurable {x | P x} /\
        f measurable_on s /\ g measurable_on s
        ==> (\x. if P x then f x else g x) measurable_on s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. (if x IN s then if P x then (f:real^M->real^N) x else g x else vec 0) =
        (if x IN {x | P x} then if x IN s then f x else vec 0 else vec 0) +
        (if x IN (:real^M) DIFF {x | P x}
         then if x IN s then g x else vec 0 else vec 0)")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN REWRITE_TAC [IN_UNIV, IN_ELIM_THM, IN_DIFF] THEN
      MESON_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID],
      MATCH_MP_TAC MEASURABLE_ON_ADD THEN
      CONJ_TAC THEN MATCH_MP_TAC MEASURABLE_ON_RESTRICT THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [lebesgue_measurable]) THEN
      REWRITE_TAC [lebesgue_measurable] THEN
      SUBGOAL_THEN (← q r"((\x. vec 1):real^M->real^1) measurable_on (:real^M)")
      MP_TAC THENL [REWRITE_TAC [MEASURABLE_ON_CONST], REWRITE_TAC [IMP_IMP]] THEN
      DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_SUB) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [indicator, IN_DIFF, IN_UNIV, IN_ELIM_THM, FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"x:real^M") THEN
      ASM_CASES_TAC (← q r"(P:real^M->bool) x") THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC (fun t => VECTOR_ARITH t)])

  pure { MEASURABLE_ON_MAX, MEASURABLE_ON_MIN, MEASURABLE_ON_DROP_MUL,
         MEASURABLE_ON_LIFT_MUL, MEASURABLE_ON_MUL, MEASURABLE_ON_VSUM,
         MEASURABLE_ON_COMPONENTWISE, MEASURABLE_ON_CONST_EQ, MEASURABLE_ON_LIFT_POW,
         MEASURABLE_ON_LIFT_PRODUCT, MEASURABLE_ON_SPIKE, MEASURABLE_ON_SPIKE_SET,
         MEASURABLE_ON_SPIKE_SET_EQ, MEASURABLE_ON_EQ, MEASURABLE_ON_RESTRICT,
         MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, MEASURABLE_ON_OPEN_INTERVAL,
         MEASURABLE_ON_CASES }

/- ------------------------------------------------------------------------- -/
/- Limits of measurable functions; bilinear products; square integrable    -/
/- functions.  (measure.ml 7741-8037)                                       -/
/- ------------------------------------------------------------------------- -/

structure MSAF where
  MEASURABLE_ON_LIMIT : thm
  MEASURABLE_ON_BILINEAR : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT : thm
  MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE_AE : thm
  ABSOLUTELY_INTEGRABLE_SQUARE_INTEGRABLE_PRODUCT : thm
  SQUARE_INTEGRAL_SQUARE_INTEGRABLE_PRODUCT_LE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAF [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAC : MSAC) (BMSAD : MSAD) (BMSAE : MSAE) : ExceptT String IO MSAF := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_MEASURABLE, INTEGRABLE_IMP_MEASURABLE,
        INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE, lebesgue_measurable,
        MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE, measurable_on,
        MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_COMPOSE_CONTINUOUS, MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL, ..
        } := BMSAC
  let { MEASURABLE_ON_NORM, .. } := BMSAD
  let { MEASURABLE_ON_RESTRICT, MEASURABLE_ON_SPIKE, MEASURABLE_ON_SPIKE_SET, .. } := BMSAE
  let { CARD_NUMSEG_1, DE_MORGAN_THM, DIMINDEX_1, ETA_AX, FINITE_NUMSEG, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_NUMSEG, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_MUL_EQ, REAL_LE_POW_2, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_SQUARE_ABS, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE,
        REAL_LT_MUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_POW_LT, RIGHT_FORALL_IMP_THM,
        SQRT_EQ_0, SQRT_POS_LE, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_BOUND, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, FORALL_1, IN_INTERVAL,
        INTERVAL_NE_EMPTY, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB,
        LINEAR_0, NORM_0, NORM_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { bilinear, drop, VEC_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, .. } := D.ig.dv.dg.pt.cvx.top1
  let { LIM_CONST, .. } := D.ig.dv.dg.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, LIM_BILINEAR, .. } := D.ig.dv.qtopology1
  let { BILINEAR_BOUNDED_POS, .. } := D.ig.dv.qvec
  let { indicator, .. } := D.ig.qvec
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_SPIKE,
        DOMINATED_CONVERGENCE_INTEGRABLE, .. } := D.qintegration1
  let { HAS_INTEGRAL_NEGLIGIBLE, HAS_INTEGRAL_NEGLIGIBLE_EQ, INTEGRABLE_ADD,
        INTEGRABLE_CMUL, INTEGRABLE_CONST, INTEGRABLE_SPIKE, INTEGRABLE_SPIKE_SET,
        INTEGRABLE_SUB, INTEGRAL_ADD, .. } := D.qintegration2
  let { absolutely_integrable_on, INTEGRAL_CMUL, INTEGRAL_DROP_POS,
        INTEGRAL_EQ_HAS_INTEGRAL, INTEGRAL_SUB, INTEGRAL_UNIQUE, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { REAL_SQRT_POW_2, .. } := D.qsession
  let { BILINEAR_CONTINUOUS_ON_COMPOSE, .. } := D.qtopology1
  let { HOMEOMORPHIC_OPEN_INTERVAL_UNIV, LIM_CONTINUOUS_FUNCTION, .. } := D.qtopology2
  let { BILINEAR_LIFT_MUL, .. } := D.qvec
  -- @@SCOPE END

  let MEASURABLE_ON_LIMIT ← prove
   r"!f:num->real^M->real^N g s k.
        (!n. (f n) measurable_on s) /\
        negligible k /\
        (!x. x IN s DIFF k ==> ((\n. f n x) --> g x) sequentially)
        ==> g measurable_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"vec 1:real^N"]
      HOMEOMORPHIC_OPEN_INTERVAL_UNIV) THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY, VEC_COMPONENT, REAL_LT_01] THEN
    REWRITE_TAC [homeomorphic, homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h':real^N->real^N", ← q r"h:real^N->real^N"] THEN
    REWRITE_TAC [IN_UNIV] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"((h':real^N->real^N) o (h:real^N->real^N) o
     (\x. if x IN s then g x else vec 0)) measurable_on (:real^M)")
    MP_TAC THENL
     [ALL_TAC, ASM_REWRITE_TAC [o_DEF, MEASURABLE_ON_UNIV]] THEN
    SUBGOAL_THEN (← q r"!y:real^N. norm(h y:real^N) <= &(dimindex(:N))")
    ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"IMAGE h UNIV = s ==> (!z. z IN s ==> P z) ==> !y. P(h y)"))) THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_INTERVAL] THEN
      REWRITE_TAC [VEC_COMPONENT] THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum(1..dimindex(:N)) (\i. abs((y:real^N)$i))") THEN
      REWRITE_TAC [NORM_LE_L1] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM CARD_NUMSEG_1] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC SUM_BOUND THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x /\ x < &1 ==> abs(x) <= &1")],
      ALL_TAC] THEN
    MATCH_MP_TAC MEASURABLE_ON_COMPOSE_CONTINUOUS_OPEN_INTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"vec 1:real^N"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_SUBINTERVALS_IMP_MEASURABLE THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"interval[a:real^M,b] DIFF k") THEN CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"k:real^M->bool") THEN
        ASM_REWRITE_TAC [] THEN SET_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC DOMINATED_CONVERGENCE_INTEGRABLE THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\n x. h(if x IN s then f n x else vec 0:real^N)):num->real^M->real^N",
        ← q r"(\x. vec(dimindex(:N))):real^M->real^1"] THEN
      REWRITE_TAC [o_DEF, INTEGRABLE_CONST] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC
          MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
        EXISTS_TAC (← q r"(\x. vec(dimindex(:N))):real^M->real^1") THEN
        ASM_REWRITE_TAC [ETA_AX, INTEGRABLE_CONST] THEN
        ASM_SIMP_TAC [DROP_VEC] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] MEASURABLE_ON_SPIKE_SET) THEN
          EXISTS_TAC (← q r"interval[a:real^M,b:real^M]") THEN CONJ_TAC THENL
           [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"k:real^M->bool") THEN
            ASM_REWRITE_TAC [] THEN SET_TAC [],
            ALL_TAC] THEN
          ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
          MATCH_MP_TAC (← REWRITE_RULE [indicator, lebesgue_measurable]
                MEASURABLE_ON_RESTRICT) THEN
          REWRITE_TAC [MEASURABLE_ON_UNIV] THEN CONJ_TAC THENL
           [MP_TAC (← ISPECL
             [← q r"(\x. if x IN s then f (n:num) x else vec 0):real^M->real^N",
              ← q r"h:real^N->real^N"] MEASURABLE_ON_COMPOSE_CONTINUOUS) THEN
            ASM_REWRITE_TAC [o_DEF] THEN DISCH_THEN MATCH_MP_TAC THEN
            ASM_REWRITE_TAC [MEASURABLE_ON_UNIV, ETA_AX],
            MATCH_MP_TAC INTEGRABLE_IMP_MEASURABLE THEN
            REWRITE_TAC [INTEGRABLE_CONST]],
          MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
          EXISTS_TAC (← q r"interval[a:real^M,b:real^M]") THEN
          REWRITE_TAC [INTEGRABLE_CONST] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
          EXISTS_TAC (← q r"k:real^M->bool") THEN ASM_REWRITE_TAC [] THEN SET_TAC []],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
        EXISTS_TAC (← q r"interval[a:real^M,b:real^M]") THEN
        REWRITE_TAC [INTEGRABLE_CONST] THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"k:real^M->bool") THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
        ASM_SIMP_TAC [DROP_VEC],
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [LIM_CONST] THEN
        MATCH_MP_TAC LIM_CONTINUOUS_FUNCTION THEN CONJ_TAC THENL
         [ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV],
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []]],
      REWRITE_TAC [o_THM] THEN ASM SET_TAC []])

  let MEASURABLE_ON_BILINEAR ← prove
   r"!op:real^N->real^P->real^Q f g s:real^M->bool.
        bilinear op /\ f measurable_on s /\ g measurable_on s
        ==> (\x. op (f x) (g x)) measurable_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [measurable_on, LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"ff:num->real^M->real^N"] THEN
    REPLICATE_TAC 3 DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"k':real^M->bool", ← q r"gg:num->real^M->real^P"] THEN
    REPLICATE_TAC 3 DISCH_TAC THEN EXISTS_TAC (← q r"k UNION k':real^M->bool") THEN
    EXISTS_TAC
     (← q r"\n:num x:real^M. (op:real^N->real^P->real^Q) (ff n x) (gg n x)") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN CONJ_TAC THENL
     [GEN_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
          BILINEAR_CONTINUOUS_ON_COMPOSE)) THEN
      ASM_REWRITE_TAC [ETA_AX],
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_UNION, DE_MORGAN_THM] THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"(if x IN s then (op:real^N->real^P->real^Q) (f x) (g x) else vec 0) =
      op (if x IN s then f(x:real^M) else vec 0)
         (if x IN s then g(x:real^M) else vec 0)")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bilinear]) THEN
        DISCH_THEN (CONJUNCTS_THEN2
         (MP_TAC o GEN (← q r"y:real^N") o MATCH_MP LINEAR_0 o SPEC (← q r"y:real^N"))
         (MP_TAC o GEN (← q r"z:real^P") o MATCH_MP LINEAR_0 o SPEC (← q r"z:real^P"))) THEN
        MESON_TAC [],
        REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
                  LIM_BILINEAR)) THEN
        ASM_SIMP_TAC []]])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT ← prove
   r"!op:real^N->real^P->real^Q f g s:real^M->bool.
        bilinear op /\
        f measurable_on s /\ bounded (IMAGE f s) /\
        g absolutely_integrable_on s
        ==> (\x. op (f x) (g x)) absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC (← q r"\x:real^M. lift(B * C * norm((g:real^M->real^P) x))") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          MEASURABLE_ON_BILINEAR)) THEN
      ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_MEASURABLE],
      REWRITE_TAC [LIFT_CMUL] THEN
      REPEAT (MATCH_MP_TAC INTEGRABLE_CMUL) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN REWRITE_TAC [LIFT_DROP] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"B * norm((f:real^M->real^N) x) * norm(g x:real^P)") THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
      ASM_SIMP_TAC [NORM_POS_LE]])

  let MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE_AE ← prove
   r"!f:real^M->real^N g s t.
        f measurable_on s /\  g integrable_on s /\ negligible t /\
        (!x. x IN s DIFF t ==> norm(f x) <= drop(g x))
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x. if x IN s DIFF t then (f:real^M->real^N) x else vec 0",
      ← q r"t:real^M->bool"] THEN
    ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    EXISTS_TAC (← q r"\x. if x IN s DIFF t then (g:real^M->real^1) x else vec 0") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")]
          MEASURABLE_ON_SPIKE)),
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")]
          INTEGRABLE_SPIKE)),
      ASM_MESON_TAC [REAL_LE_REFL, NORM_0, DROP_VEC]] THEN
    EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_SIMP_TAC [])

  let ABSOLUTELY_INTEGRABLE_SQUARE_INTEGRABLE_PRODUCT ← prove
   r"!bop:real^N->real^P->real^Q f:real^M->real^N g:real^M->real^P s.
        bilinear bop /\
        f measurable_on s /\ (\x. lift(norm(f x) pow 2)) integrable_on s /\
        g measurable_on s /\ (\x. lift(norm(g x) pow 2)) integrable_on s
        ==> (\x. bop (f x) (g x)) absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE THEN
    ASM_SIMP_TAC [MEASURABLE_ON_BILINEAR] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. B / &2 % lift(norm((f:real^M->real^N) x) pow 2 +
                                norm((g:real^M->real^P) x) pow 2)") THEN
    ASM_SIMP_TAC [LIFT_ADD, INTEGRABLE_ADD, INTEGRABLE_CMUL] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    REWRITE_TAC [DROP_CMUL, LIFT_DROP, DROP_ADD, ← REAL_ARITH
     (← q r"B * x * y <= B / &2 * (x pow 2 + y pow 2) <=>
    &0 <= B * (x - y) pow 2")] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN ASM_SIMP_TAC [REAL_LE_POW_2, REAL_LT_IMP_LE])

  let SQUARE_INTEGRAL_SQUARE_INTEGRABLE_PRODUCT_LE ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        f measurable_on s /\ (\x. lift(norm(f x) pow 2)) integrable_on s /\
        g measurable_on s /\ (\x. lift(norm(g x) pow 2)) integrable_on s
        ==> drop(integral s (\x. lift(norm(f x) * norm(g x)))) pow 2 <=
            drop(integral s (\x. lift(norm(f x) pow 2))) *
            drop(integral s (\x. lift(norm(g x) pow 2)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x y. lift(drop x * drop y)",
      ← q r"\x. lift(norm((f:real^M->real^N) x))",
      ← q r"\x. lift(norm((g:real^M->real^P) x))",
      ← q r"s:real^M->bool"]
     ABSOLUTELY_INTEGRABLE_SQUARE_INTEGRABLE_PRODUCT) THEN
    ASM_SIMP_TAC [LIFT_DROP, NORM_LIFT, REAL_ABS_NORM, MEASURABLE_ON_NORM] THEN
    REWRITE_TAC [BILINEAR_LIFT_MUL] THEN DISCH_THEN (ASSUME_TAC o
        MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"a = sqrt(drop(integral s (\x. lift(norm((f:real^M->real^N) x) pow 2))))",
      ← q r"b = sqrt(drop(integral s
         (\x. lift(norm((g:real^M->real^P) x) pow 2))))"] THEN
    ASM_CASES_TAC (← q r"a = &0") THENL
     [UNDISCH_TAC (← q r"a = &0") THEN EXPAND_TAC "a" THEN REWRITE_TAC [SQRT_EQ_0] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"\x. lift(norm((f:real^M->real^N) x) pow 2)",
                       ← q r"s:real^M->bool"] HAS_INTEGRAL_NEGLIGIBLE_EQ) THEN
      REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p ==> q /\ r ==> s")] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_1, DIMINDEX_1] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP, REAL_LE_POW_2] THEN
      ASM_SIMP_TAC [← GSYM INTEGRAL_EQ_HAS_INTEGRAL] THEN
      ASM_REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_VEC, NORM_EQ_0,
                       ← REAL_RING (← q r"x pow 2 = &0 <=> x = &0")] THEN
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> x <= &0 * y")) THEN
      REWRITE_TAC [← REAL_RING (← q r"x pow 2 = &0 <=> x = &0")] THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP] THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
      EXISTS_TAC (← q r"{x | x IN s /\ ~((f:real^M->real^N) x = vec 0)}") THEN
      ASM_SIMP_TAC [NORM_0, REAL_MUL_LZERO, LIFT_NUM, ← SET_RULE
       (← q r"x IN s DIFF {x | x IN s /\ ~P x} <=> x IN s /\ P x")],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"b = &0") THENL
     [UNDISCH_TAC (← q r"b = &0") THEN EXPAND_TAC "b" THEN REWRITE_TAC [SQRT_EQ_0] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"\x. lift(norm((g:real^M->real^P) x) pow 2)",
                       ← q r"s:real^M->bool"] HAS_INTEGRAL_NEGLIGIBLE_EQ) THEN
      REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p ==> q /\ r ==> s")] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_1, DIMINDEX_1] THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP, REAL_LE_POW_2] THEN
      ASM_SIMP_TAC [← GSYM INTEGRAL_EQ_HAS_INTEGRAL] THEN
      ASM_REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_VEC, NORM_EQ_0,
                       ← REAL_RING (← q r"x pow 2 = &0 <=> x = &0")] THEN
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> x <= y * &0")) THEN
      REWRITE_TAC [← REAL_RING (← q r"x pow 2 = &0 <=> x = &0")] THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP] THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
      EXISTS_TAC (← q r"{x | x IN s /\ ~((g:real^M->real^P) x = vec 0)}") THEN
      ASM_SIMP_TAC [NORM_0, REAL_MUL_RZERO, LIFT_NUM, ← SET_RULE
       (← q r"x IN s DIFF {x | x IN s /\ ~P x} <=> x IN s /\ P x")],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\x. lift((a * norm((g:real^M->real^P) x) -
               b * norm((f:real^M->real^N) x)) pow 2)",
      ← q r"s:real^M->bool"] INTEGRAL_DROP_POS) THEN
    REWRITE_TAC [LIFT_DROP, REAL_LE_POW_2] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"(a * g - b * f:real) pow 2 =
    (a pow 2 * g pow 2 + b pow 2 * f pow 2) - (&2 * a * b) * (f * g)")] THEN
    REWRITE_TAC [LIFT_ADD, LIFT_SUB] THEN ONCE_REWRITE_TAC [LIFT_CMUL] THEN
    ASM_SIMP_TAC [INTEGRABLE_ADD, INTEGRABLE_SUB, INTEGRABLE_CMUL,
                  INTEGRAL_ADD, INTEGRAL_SUB, INTEGRAL_CMUL] THEN
    REWRITE_TAC [DROP_SUB, DROP_ADD, DROP_CMUL] THEN
    SUBGOAL_THEN
     (← q r"drop(integral s (\x. lift(norm((f:real^M->real^N) x) pow 2))) = a pow 2 /\
    drop(integral s (\x. lift(norm((g:real^M->real^P) x) pow 2))) = b pow 2")
    (CONJUNCTS_THEN SUBST1_TAC) THENL
     [MAP_EVERY EXPAND_TAC ["a", "b"] THEN
      REWRITE_TAC [REAL_SQRT_POW_2, ← REAL_ARITH (← q r"x = abs x <=> &0 <= x")] THEN
      ASM_SIMP_TAC [INTEGRAL_DROP_POS, LIFT_DROP, REAL_LE_POW_2],
      REWRITE_TAC [← REAL_ARITH
       (← q r"&0 <= (a pow 2 * b pow 2 + b pow 2 * a pow 2) - (&2 * a * b) * i <=>
      (a * b) * i <= (a * b) pow 2")]] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"x <= y ==> &0 <= x ==> abs x <= abs y"))) THEN
    SUBGOAL_THEN (← q r"&0 <= a /\ &0 <= b") STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["a", "b"] THEN CONJ_TAC THEN
      MATCH_MP_TAC SQRT_POS_LE THEN
      ASM_SIMP_TAC [INTEGRAL_DROP_POS, LIFT_DROP, REAL_LE_POW_2],
      ASM_SIMP_TAC [INTEGRAL_DROP_POS, LIFT_DROP, REAL_LE_MUL, NORM_POS_LE]] THEN
    REWRITE_TAC [REAL_LE_SQUARE_ABS, ← REAL_ARITH
     (← q r"((a * b) * i) pow 2 <= (a * b) pow 2 pow 2 <=>
    &0 <= (a * b) pow 2 * ((a pow 2 * b pow 2) - i pow 2)")] THEN
    SUBGOAL_THEN (← q r"&0 < a * b") ASSUME_TAC THENL
     [MATCH_MP_TAC REAL_LT_MUL THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_POW_LT]] THEN
    REWRITE_TAC [LIFT_CMUL] THEN REAL_ARITH_TAC)

  pure { MEASURABLE_ON_LIMIT, MEASURABLE_ON_BILINEAR,
         ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT,
         MEASURABLE_BOUNDED_BY_INTEGRABLE_IMP_ABSOLUTELY_INTEGRABLE_AE,
         ABSOLUTELY_INTEGRABLE_SQUARE_INTEGRABLE_PRODUCT,
         SQUARE_INTEGRAL_SQUARE_INTEGRABLE_PRODUCT_LE }

/- ------------------------------------------------------------------------- -/
/- Natural closure properties of measurable functions under set           -/
/- operations.  (measure.ml 8038-8183)                                      -/
/- ------------------------------------------------------------------------- -/

structure MSAG where
  MEASURABLE_ON_EMPTY : thm
  MEASURABLE_ON_INTER : thm
  MEASURABLE_ON_DIFF : thm
  MEASURABLE_ON_UNION : thm
  MEASURABLE_ON_UNIONS : thm
  MEASURABLE_ON_COUNTABLE_UNIONS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAG [HolBase] (D : MeasureDeps) (BMSAB : MSAB) (BMSAC : MSAC) (BMSAD : MSAD) (BMSAE : MSAE) (BMSAF : MSAF) : ExceptT String IO MSAG := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_UNIV, .. } := BMSAB
  let { MEASURABLE_ON_COMPOSE_CONTINUOUS, .. } := BMSAC
  let { MEASURABLE_ON_ADD, MEASURABLE_ON_CONST, MEASURABLE_ON_SUB, .. } := BMSAD
  let { MEASURABLE_ON_COMPONENTWISE, MEASURABLE_ON_LIFT_MUL, .. } := BMSAE
  let { MEASURABLE_ON_LIMIT, .. } := BMSAF
  let { AND_FORALL_THM, ARITH, COND_RAND, COND_RATOR, CONTRAPOS_THM, DIMINDEX_1, EQ_IMP,
        EXISTS_IN_IMAGE, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DIFF, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_POS, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_POW_LE, SKOLEM_THM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, UNIONS_0, UNIONS_INSERT, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, EXISTS_DROP, FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_EQ, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { drop, VEC_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL, .. } := D.ig.dv.dg.pt.cvx.top3
  let { OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        SET_TAC, VECTOR_ARITH_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.ig.dv.dg.pt.qses
  let { COUNTABLE_AS_IMAGE, .. } := D.ig.dv.dg.qcard
  let { LE_0, REAL_POW_NEG, .. } := D.ig.dv.dg.qsession
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, .. } := D.ig.dv.qtopology1
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { IVT_INCREASING_COMPONENT_1, .. } := D.qconvex
  let { NEGLIGIBLE_EMPTY, .. } := D.qintegration3
  let { INJECTIVE_INTO_1D_IMP_OPEN_MAP, PATH_CONNECTED_UNIV, .. } := D.qpaths
  let { REAL_POW_EQ_ODD, REAL_POW_EQ_ODD_EQ, .. } := D.qsession
  let { CONTINUOUS_ON_INVERSE_OPEN_MAP, .. } := D.qtopology1
  -- @@SCOPE END

  let MEASURABLE_ON_EMPTY ← prove
   r"!f:real^M->real^N. f measurable_on {}"
   (ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    REWRITE_TAC [NOT_IN_EMPTY, MEASURABLE_ON_CONST])

  let MEASURABLE_ON_INTER ← prove
   r"!f:real^M->real^N s t.
        f measurable_on s /\ f measurable_on t
        ==> f measurable_on (s INTER t)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    ONCE_REWRITE_TAC [MEASURABLE_ON_COMPONENTWISE] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q ==> r <=> p /\ p ==> q ==> r")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_LIFT_MUL) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_LIFT_MUL) THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    REWRITE_TAC [VEC_COMPONENT, ← REAL_ARITH
     (← q r"(if p then x else &0) * (if q then y else &0) =
    if p /\ q then x * y else &0")] THEN
    SUBGOAL_THEN (← q r"!s. (\x. lift (drop x pow 3)) continuous_on s") ASSUME_TAC THENL
     [GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"(x:real) pow 3 = x * x * x")] THEN
      REWRITE_TAC [LIFT_CMUL] THEN
      REPEAT (MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
             ASM_REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID]),
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?r. !x. lift(drop(r x) pow 3) = x") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM SKOLEM_THM, FORALL_LIFT, ← GSYM EXISTS_DROP, LIFT_EQ] THEN
      X_GEN_TAC (← q r"x:real") THEN  MP_TAC (← ISPECL
       [← q r"\x. lift (drop x pow 3)", ← q r"lift(--(abs x + &1))",
        ← q r"lift(abs x + &1)", ← q r"x:real", ← q r"1"] IVT_INCREASING_COMPONENT_1) THEN
      REWRITE_TAC [← GSYM drop, LIFT_DROP, EXISTS_DROP] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(:real^1)")) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV],
        REWRITE_TAC [REAL_BOUNDS_LE, REAL_POW_NEG, ARITH] THEN
        MATCH_MP_TAC (← REAL_ARITH
        (← q r"&0 <= x /\ &0 <= x pow 2 /\ &0 <= x pow 3 ==> x <= (x + &1) pow 3")) THEN
        SIMP_TAC [REAL_POW_LE, REAL_ABS_POS]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x.  r(lift(x pow 3)) = lift x") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN GEN_TAC THEN
      MATCH_MP_TAC REAL_POW_EQ_ODD THEN EXISTS_TAC (← q r"3") THEN
      ASM_REWRITE_TAC [ARITH, ← GSYM LIFT_EQ, LIFT_DROP],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(r:real^1->real^1) continuous_on (:real^1)") ASSUME_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_INVERSE_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"\x. lift(drop x pow 3)", ← q r"(:real^1)"] THEN
      ASM_REWRITE_TAC [LIFT_DROP] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (REPEAT STRIP_TAC THEN SUBST1_TAC (← SYM th))) THEN
      MATCH_MP_TAC INJECTIVE_INTO_1D_IMP_OPEN_MAP THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_UNIV, LIFT_EQ] THEN
      SIMP_TAC [REAL_POW_EQ_ODD_EQ, ARITH, DROP_EQ],
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"&0 = &0 pow 3")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(x * x) * x:real = x pow 3"), IN_INTER] THEN
      REWRITE_TAC [← MESON [] (← q r"(if p then x pow 3 else y pow 3) =
                         (if p then x else y:real) pow 3")] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"r:real^1->real^1") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] MEASURABLE_ON_COMPOSE_CONTINUOUS)) THEN
      ASM_REWRITE_TAC [o_DEF]])

  let MEASURABLE_ON_DIFF ← prove
   r"!f:real^M->real^N s t.
    f measurable_on s /\ f measurable_on t ==> f measurable_on (s DIFF t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP MEASURABLE_ON_INTER) THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1) THEN REWRITE_TAC [IMP_IMP] THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, IN_DIFF, IN_INTER] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let MEASURABLE_ON_UNION ← prove
   r"!f:real^M->real^N s t.
    f measurable_on s /\ f measurable_on t ==> f measurable_on (s UNION t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP MEASURABLE_ON_INTER) THEN
    POP_ASSUM MP_TAC THEN ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_ADD) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MEASURABLE_ON_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, IN_UNION, IN_INTER] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let MEASURABLE_ON_UNIONS ← prove
   r"!f:real^M->real^N k.
        FINITE k /\ (!s. s IN k ==> f measurable_on s)
        ==> f measurable_on (UNIONS k)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, MEASURABLE_ON_EMPTY, UNIONS_INSERT] THEN
    SIMP_TAC [FORALL_IN_INSERT, MEASURABLE_ON_UNION])

  let MEASURABLE_ON_COUNTABLE_UNIONS ← prove
   r"!f:real^M->real^N k.
        COUNTABLE k /\ (!s. s IN k ==> f measurable_on s)
        ==> f measurable_on (UNIONS k)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"k:(real^M->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0, MEASURABLE_ON_EMPTY] THEN
    MP_TAC (← ISPEC (← q r"k:(real^M->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:num->real^M->bool") THEN DISCH_THEN SUBST_ALL_TAC THEN
    ONCE_REWRITE_TAC [← GSYM MEASURABLE_ON_UNIV] THEN
    MATCH_MP_TAC MEASURABLE_ON_LIMIT THEN
    EXISTS_TAC (← q r"(\n x. if x IN UNIONS (IMAGE d (0..n)) then f x else vec 0):
              num->real^M->real^N") THEN
    EXISTS_TAC (← q r"{}:real^M->bool") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_EMPTY, MEASURABLE_ON_UNIV] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC MEASURABLE_ON_UNIONS THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [FORALL_IN_IMAGE]) THEN
      SIMP_TAC [FORALL_IN_IMAGE, IN_UNIV, FINITE_IMAGE, FINITE_NUMSEG],
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_THEN (K ALL_TAC) THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN UNIONS (IMAGE d (:num))") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIM_EVENTUALLY THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_UNIONS]) THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_UNIV, EVENTUALLY_SEQUENTIALLY] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [IN_UNIONS]) THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_NUMSEG, LE_0] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM SET_TAC []]])

  pure { MEASURABLE_ON_EMPTY, MEASURABLE_ON_INTER, MEASURABLE_ON_DIFF,
         MEASURABLE_ON_UNION, MEASURABLE_ON_UNIONS, MEASURABLE_ON_COUNTABLE_UNIONS }

/- ------------------------------------------------------------------------- -/
/- An existence theorem for "improper" integrals.  (measure.ml 8184-8445)   -/
/- ------------------------------------------------------------------------- -/

structure MSAH where
  ABSOLUTELY_INTEGRABLE_IMPROPER_SIMPLE : thm
  ABSOLUTELY_INTEGRABLE_IMPROPER : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAH [HolBase] (D : MeasureDeps) (BMSJ : MSJ) (BMSAB : MSAB) (BMSAG : MSAG) : ExceptT String IO MSAH := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_ON_OPEN_INTERVAL, INTEGRABLE_ON_OPEN_INTERVAL, .. } := BMSJ
  let { ABSOLUTELY_INTEGRABLE_MEASURABLE, .. } := BMSAB
  let { MEASURABLE_ON_COUNTABLE_UNIONS, .. } := BMSAG
  let { AND_FORALL_THM, DIMINDEX_1, DIMINDEX_GE_1, FINITE_IMAGE, FINITE_NUMSEG,
        FINITE_UNION, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_EQ_EMPTY, IMAGE_UNION, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE_1, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, NOT_FORALL_THM, NOT_LT, NUMSEG_EMPTY, REAL_ARCH_INV, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_ADD, REAL_LT_IMP_LE, REAL_LT_INF_FINITE, REAL_LT_INV_EQ, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_SUC,
        REAL_SUB_LE, REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_ge, UNIONS_GSPEC, UNIONS_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_SUB, DROP_VEC, FORALL_1, IN_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { BOUNDED_POS, BOUNDED_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top1
  let { LIM_CONST, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { EMPTY_UNION, .. } := D.ig.dv.dg.pt.qses
  let { SUB_ADD, TRANSITIVE_STEPWISE_LE, .. } := D.ig.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { LIM_EVENTUALLY, .. } := D.ig.dv.qtopology2
  let { IMP_REWRITE_TAC, .. } := D.ig
  let { ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND,
        ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND,
        ABSOLUTELY_INTEGRABLE_COMPONENTWISE, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_ON_NULL, BOUNDED_INTEGRALS_OVER_SUBINTERVALS, CONTENT_LT_NZ,
        CONTENT_POS_LT_EQ, .. } := D.qintegration1
  let { INTEGRABLE_ADD, INTEGRABLE_COMPONENTWISE, INTEGRABLE_RESTRICT_INTER,
        INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SUB, INTEGRABLE_SUBINTERVAL, .. } :=
        D.qintegration2
  let { INTEGRAL_RESTRICT_INTER, INTEGRAL_RESTRICT_UNIV, INTEGRAL_SUB,
        LIFT_INTEGRAL_COMPONENT, MONOTONE_CONVERGENCE_INCREASING, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_IMPROPER_SIMPLE ← prove
   r"!(f:real^M->real^N) a b.
        (!c d. interval[c,d] SUBSET interval(a,b)
               ==> f absolutely_integrable_on interval[c,d]) /\
        bounded { integral (interval[c,d]) (\x. lift(norm(f x))) |
                  interval[c,d] SUBSET interval(a,b)}
        ==> f absolutely_integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ABSOLUTELY_INTEGRABLE_ON_OPEN_INTERVAL] THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_MEASURABLE] THEN
    STRIP_TAC THEN
    ABBREV_TAC
     (← q r"i = \n. interval[(lambda i. (a:real^M)$i + inv(&n + &1)):real^M,
                     (lambda i. (b:real^M)$i - inv(&n + &1))]") THEN
    SUBGOAL_THEN (← q r"!n. (i:num->real^M->bool) n SUBSET i(SUC n)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "i" THEN
      SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MP_TAC (← SPECL [← q r"&n + &1", ← q r"&(SUC n) + &1"] REAL_LE_INV2) THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (i:num->real^M->bool) n SUBSET interval(a,b)")
    ASSUME_TAC THENL
     [GEN_TAC THEN EXPAND_TAC "i" THEN
      SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN
      MP_TAC (← SPEC (← q r"&n + &1:real") REAL_LT_INV_EQ) THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"UNIONS {(i:num->real^M->bool) n | n IN (:num)} = interval(a,b)")
    ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
      ASM_REWRITE_TAC [UNIONS_GSPEC, SUBSET, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_INTERVAL] THEN
      DISCH_TAC THEN MP_TAC (← SPEC
        (← q r"inf({(x - a:real^M)$i | i IN 1..dimindex(:M)} UNION
           {(b - x:real^M)$i | i IN 1..dimindex(:M)})")
         REAL_ARCH_INV) THEN
       SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                 IMAGE_EQ_EMPTY, NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1,
                 FINITE_UNION, IMAGE_UNION, EMPTY_UNION] THEN
       REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_IMAGE] THEN
       ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, IN_NUMSEG, REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"n - 1") THEN EXPAND_TAC "i" THEN
      REWRITE_TAC [IN_INTERVAL] THEN
      ASM_SIMP_TAC [REAL_OF_NUM_ADD, SUB_ADD, LE_1, LAMBDA_BETA] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"i:real < x - a ==> a + i <= x")] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"i:real < b - x ==> x <= b - i")],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
      MATCH_MP_TAC MEASURABLE_ON_COUNTABLE_UNIONS THEN
      SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, COUNTABLE_IMAGE,
                NUM_COUNTABLE, IN_UNIV] THEN
      X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      EXPAND_TAC "i" THEN REWRITE_TAC [IN_UNIV] THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\n x. if x IN i(n:num)
           then lift(norm((f:real^M->real^N) x)) else vec 0",
      ← q r"\x. if x IN interval(a,b)
           then lift(norm((f:real^M->real^N) x)) else vec 0",
      ← q r"(:real^M)"] MONOTONE_CONVERGENCE_INCREASING) THEN
    REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV, INTEGRAL_RESTRICT_UNIV, IN_UNIV] THEN
    ANTS_TAC THENL [ALL_TAC, DISCH_THEN (ACCEPT_TAC o CONJUNCT1)] THEN
    REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      EXPAND_TAC "i" THEN REWRITE_TAC [IN_UNIV] THEN ASM_SIMP_TAC [],
      REPEAT GEN_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      REWRITE_TAC [REAL_LE_REFL, LIFT_DROP, DROP_VEC, NORM_POS_LE] THEN
      ASM SET_TAC [],
      X_GEN_TAC (← q r"x:real^M") THEN ASM_CASES_TAC (← q r"(x:real^M) IN interval(a,b)") THEN
      ASM_REWRITE_TAC [] THENL
       [MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        UNDISCH_TAC (← q r"(x:real^M) IN interval(a,b)") THEN
        FIRST_X_ASSUM (fun th => tactic_of do
         pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM th])) THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
        MP_TAC (← SPEC (← q r"\m n. (i:num->real^M->bool) m SUBSET i n")
          TRANSITIVE_STEPWISE_LE) THEN
        ASM_REWRITE_TAC [SUBSET_REFL, SUBSET_TRANS] THEN ASM SET_TAC [],
        SUBGOAL_THEN (← q r"!n. ~(x IN (i:num->real^M->bool) n)") MP_TAC THENL
         [ASM SET_TAC [], ASM_SIMP_TAC [LIM_CONST]]],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        BOUNDED_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      EXPAND_TAC "i" THEN REWRITE_TAC [IN_UNIV] THEN SET_TAC []])

  let ABSOLUTELY_INTEGRABLE_IMPROPER ← prove
   r"!f:real^M->real^N a b.
     (!c d. interval[c,d] SUBSET interval(a,b)
            ==> f integrable_on interval[c,d]) /\
     bounded { integral (interval[c,d]) f |
               interval[c,d] SUBSET interval(a,b)} /\
     (!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?g. g absolutely_integrable_on interval[a,b] /\
                  ((!x. x IN interval[a,b] ==> (f x)$i <= drop(g x)) \/
                   (!x. x IN interval[a,b] ==> (f x)$i >= drop(g x))))
   ==> f absolutely_integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"content(interval[a:real^M,b]) = &0") THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_ON_NULL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONTENT_LT_NZ, CONTENT_POS_LT_EQ]) THEN
    STRIP_TAC THEN
    ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [real_ge] THEN
    SUBGOAL_THEN
     (← q r"(!n. interval[a + inv(&n + &1) % (b - a),b - inv(&n + &1) % (b - a)] SUBSET
         interval(a:real^M,b)) /\
    (!n. interval[a + inv(&n + &1) % (b - a),b - inv(&n + &1) % (b - a)] SUBSET
         interval[a:real^M,b])")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET t /\ t SUBSET u ==> s SUBSET t /\ s SUBSET u")) THEN
      REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED] THEN
      REWRITE_TAC [SUBSET_INTERVAL] THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                   VECTOR_SUB_COMPONENT] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"a < a + x <=> &0 < x"),
                    ← REAL_ARITH (← q r"b - x < b <=> &0 < x"), REAL_LT_MUL,
                    REAL_SUB_LT, REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. interval[a + inv(&n + &1) % (b - a),b - inv(&n + &1) % (b - a)] SUBSET
        interval[a + inv(&(SUC n) + &1) % (b - a):real^M,
                 b - inv(&(SUC n) + &1) % (b - a)]")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET_INTERVAL] THEN GEN_TAC THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                   VECTOR_SUB_COMPONENT] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a + x * y <= a + w * y <=> &0 <= (w - x) * y"),
                   ← REAL_ARITH (← q r"b - w * y <= b - x * y <=> &0 <= (w - x) * y")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_SIMP_TAC [REAL_SUB_LE, REAL_LT_IMP_LE, ← GSYM REAL_OF_NUM_SUC] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^1") STRIP_ASSUME_TAC) THENL
     [MATCH_MP_TAC
       ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND THEN
      EXISTS_TAC (← q r"g:real^M->real^1") THEN
      ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, DIMINDEX_1] THEN
      ASM_REWRITE_TAC [IMP_IMP, FORALL_1, ← GSYM drop, LIFT_DROP] THEN
      SUBGOAL_THEN
       (← q r"(\x. lift((f:real^M->real^N) x$i)) = (\x. g x - (g x - lift(f x$i)))")
      SUBST1_TAC THENL [ABS_TAC THEN CONV_TAC (fun t => VECTOR_ARITH t), ALL_TAC] THEN
      MATCH_MP_TAC INTEGRABLE_SUB THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
      MP_TAC (← ISPECL
       [← q r"\n x. if x IN interval[a + inv(&n + &1) % (b - a),
                              b - inv(&n + &1) % (b - a)]
             then g x - lift((f:real^M->real^N) x $i) else vec 0",
        ← q r"\x. g x - lift((f:real^M->real^N) x$i)",
        ← q r"interval(a:real^M,b)"] MONOTONE_CONVERGENCE_INCREASING) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC, SIMP_TAC [INTEGRABLE_ON_OPEN_INTERVAL]] THEN
      REWRITE_TAC [INTEGRABLE_RESTRICT_INTER, INTEGRAL_RESTRICT_INTER] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> s INTER t = s")] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC INTEGRABLE_SUB THEN CONJ_TAC THENL
         [ASM_MESON_TAC [INTEGRABLE_SUBINTERVAL,
                         ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
          RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_COMPONENTWISE]) THEN
          ASM_MESON_TAC []],
        ALL_TAC],
      MATCH_MP_TAC
       ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND THEN
      EXISTS_TAC (← q r"g:real^M->real^1") THEN
      ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, DIMINDEX_1] THEN
      ASM_REWRITE_TAC [IMP_IMP, FORALL_1, ← GSYM drop, LIFT_DROP] THEN
      SUBGOAL_THEN
       (← q r"(\x. lift((f:real^M->real^N) x$i)) = (\x. (lift(f x$i) - g x) + g x)")
      SUBST1_TAC THENL [ABS_TAC THEN CONV_TAC (fun t => VECTOR_ARITH t), ALL_TAC] THEN
      MATCH_MP_TAC INTEGRABLE_ADD THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
      MP_TAC (← ISPECL
       [← q r"\n x. if x IN interval[a + inv(&n + &1) % (b - a),
                              b - inv(&n + &1) % (b - a)]
             then lift((f:real^M->real^N) x $i) - g x else vec 0",
        ← q r"\x. lift((f:real^M->real^N) x$i) - g x",
        ← q r"interval(a:real^M,b)"] MONOTONE_CONVERGENCE_INCREASING) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC, SIMP_TAC [INTEGRABLE_ON_OPEN_INTERVAL]] THEN
      REWRITE_TAC [INTEGRABLE_RESTRICT_INTER, INTEGRAL_RESTRICT_INTER] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> s INTER t = s")] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC INTEGRABLE_SUB THEN CONJ_TAC THENL
         [RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_COMPONENTWISE]) THEN
          ASM_MESON_TAC [],
          ASM_MESON_TAC [INTEGRABLE_SUBINTERVAL,
                         ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE]],
        ALL_TAC]] THEN
    (REPEAT CONJ_TAC THENL
      [REPEAT STRIP_TAC THEN
       REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL]) THEN
       ASM_SIMP_TAC [DROP_SUB, DROP_VEC, REAL_SUB_LE, LIFT_DROP] THEN
       ASM SET_TAC [],
       X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_INTERVAL] THEN
       DISCH_TAC THEN MATCH_MP_TAC LIM_EVENTUALLY THEN MP_TAC (← SPEC
        (← q r"inf({(x - a:real^M)$i / (b - a)$i | i IN 1..dimindex(:M)} UNION
           {(b - x:real^M)$i / (b - a)$i | i IN 1..dimindex(:M)})")
         REAL_ARCH_INV) THEN
       SIMP_TAC [REAL_LT_INF_FINITE, SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                 IMAGE_EQ_EMPTY, NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1,
                 FINITE_UNION, IMAGE_UNION, EMPTY_UNION] THEN
       REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_IMAGE] THEN
       SIMP_TAC [VECTOR_SUB_COMPONENT, IN_NUMSEG, EVENTUALLY_SEQUENTIALLY] THEN
       ASM_SIMP_TAC [REAL_SUB_LT, REAL_LT_RDIV_EQ, REAL_MUL_LZERO] THEN
       MATCH_MP_TAC MONO_EXISTS THEN
       X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
       X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_FORALL_THM]) THEN
       MATCH_MP_TAC (← MESON [] (← q r"(!x. ~P x) ==> (?x. P x) ==> Q")) THEN
       X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
       REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT,
                    VECTOR_MUL_COMPONENT, ← REAL_ARITH
              (← q r"a + y <= x /\ x <= b - y <=> y <= x - a /\ y <= b - x")] THEN
       ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_SUB_LT] THEN
       CONJ_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
       EXISTS_TAC (← q r"inv(&N)") THEN
       ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_SUB_LT, REAL_LT_IMP_LE] THEN
       MATCH_MP_TAC REAL_LE_INV2 THEN
       ASM_SIMP_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, LE_1] THEN
       ASM_ARITH_TAC,
       FIRST_ASSUM (MP_TAC o MATCH_MP
         ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
       DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_INTEGRALS_OVER_SUBINTERVALS) THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
       REWRITE_TAC [BOUNDED_POS, FORALL_IN_GSPEC, IN_UNIV] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
       EXISTS_TAC (← q r"B + C:real") THEN ASM_SIMP_TAC [REAL_LT_ADD] THEN
       RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_COMPONENTWISE]) THEN
       GEN_TAC THEN W (MP_TAC o PART_MATCH (lhs o rand) INTEGRAL_SUB o
         rand o lhand o snd) THEN
       ASM_SIMP_TAC [] THEN ANTS_TAC THENL
        [ASM_MESON_TAC [INTEGRABLE_SUBINTERVAL,
                        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
         DISCH_THEN SUBST1_TAC]])
    THENL
     [MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(x:real^N) <= c /\ norm(y) <= b ==> norm(x - y) <= b + c")),
      MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(x:real^N) <= c /\ norm(y) <= b ==> norm(x - y) <= c + b"))] THEN
    ASM_SIMP_TAC [] THEN IMP_REWRITE_TAC [← GSYM LIFT_INTEGRAL_COMPONENT] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM INTEGRABLE_COMPONENTWISE]) THEN
    ASM_SIMP_TAC [NORM_LIFT] THEN
    W (MP_TAC o PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN ASM_SIMP_TAC [])

  pure { ABSOLUTELY_INTEGRABLE_IMPROPER_SIMPLE, ABSOLUTELY_INTEGRABLE_IMPROPER }

/- ------------------------------------------------------------------------- -/
/- Negligibility of a Lipschitz image of a negligible set.                 -/
/- (measure.ml 8446-8740)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSAI where
  NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAI [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSK : MSK) (BMSO : MSO) : ExceptT String IO MSAI := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_UNIONS, MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE, .. } := BMSB
  let { NEGLIGIBLE_OUTER, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_GEN, NEGLIGIBLE_COUNTABLE_UNIONS_GEN, .. } := BMSF
  let { MEASURE_ELEMENTARY, .. } := BMSG
  let { COVERING_LEMMA, .. } := BMSK
  let { MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { division_of, gauge, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { SUM_IMAGE_LE, .. } := D.qsession
  let { PRODUCT_CONST, PRODUCT_EQ_NUMSEG, .. } := D.ig.qproducts
  let { IMAGE_UNIONS, .. } := D.ig.qsession
  let { REAL_POW_MONO_INV, .. } := D.ig.dv.qsession
  let { open_def, .. } := D.ig.dv.qtopology2
  let { ADD_SUB, SUBSET_UNIONS, .. } := D.ig.dv.dg.qsession
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.ig.dv.dg.pt.qses
  let { ARITH, CARD_NUMSEG_1, CONJ_SYM, DIMINDEX_GE_1, EXTENSION, FINITE_NUMSEG,
        FINITE_SUBSET, FORALL_AND_THM, FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, IN_UNIV, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, REAL_ADD_LID, REAL_ARCH_SIMPLE, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_MUL_EQ, REAL_LE_RMUL,
        REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MIN, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, REAL_MAX_LE, REAL_MIN_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_LT, REAL_POW_LT,
        REAL_POW_MUL, REAL_SUB_LE, RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUM_CONST, SUM_EQ, SUM_LE, SUM_LE_NUMSEG, SUM_LMUL, SWAP_EXISTS_THM,
        UNIONS_GSPEC, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { ENDS_IN_INTERVAL, IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_POS_LE, NORM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_NEG_COMPONENT, VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_CBALL, BOUNDED_SUBSET, CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, IN_CBALL_0, INTERIOR_CLOSED_INTERVAL, INTERIOR_EMPTY, OPEN_BALL,
        .. } := D.ig.dv.dg.pt.cvx.top4
  let { bounded, OPEN_INTER, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE ← (do
    let lemma ← prove
     r"!f:real^M->real^N s B.
        dimindex(:M) <= dimindex(:N) /\ bounded s /\ negligible s /\ &0 < B /\
        (!x. x IN s
             ==> ?t. open t /\ x IN t /\
                     !y. y IN s INTER t
                         ==> norm(f y - f x) <= B * norm(y - x))
        ==> negligible(IMAGE f s)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [NEGLIGIBLE_OUTER] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^M->bool",
                       ← q r"e / &2 / (&2 * B * &(dimindex(:M))) pow (dimindex(:N))"]
        MEASURABLE_OUTER_OPEN) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [NEGLIGIBLE_IMP_MEASURABLE] THEN
        MATCH_MP_TAC REAL_LT_DIV THEN ASM_REWRITE_TAC [REAL_HALF] THEN
        MATCH_MP_TAC REAL_POW_LT THEN
        REPEAT (MATCH_MP_TAC REAL_LT_MUL THEN CONJ_TAC) THEN
        ASM_SIMP_TAC [DIMINDEX_GE_1, REAL_OF_NUM_LT, ARITH, LE_1],
        ALL_TAC] THEN
      ASM_SIMP_TAC [NEGLIGIBLE_IMP_MEASURABLE, REAL_HALF, MEASURE_EQ_0] THEN
      REWRITE_TAC [REAL_ADD_LID] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!x. ?r. &0 < r /\ r <= &1 / &2 /\
              (x IN s
               ==> !y. norm(y - x:real^M) < r
                       ==> y IN t /\
                           (y IN s
                            ==> norm(f y - f x:real^N) <= B * norm(y - x)))")
      MP_TAC THENL
       [X_GEN_TAC (← q r"x:real^M") THEN ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN
        ASM_REWRITE_TAC [] THENL
         [ALL_TAC, EXISTS_TAC (← q r"&1 / &4") THEN REAL_ARITH_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
        ASM_REWRITE_TAC [IN_INTER] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPEC (← q r"t INTER u :real^M->bool") open_def) THEN
        ASM_SIMP_TAC [OPEN_INTER, OPEN_BALL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
        ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_INTER, dist]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"min (&1 / &2) r") THEN
        ASM_REWRITE_TAC [REAL_MIN_LE, REAL_LT_MIN] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_MESON_TAC [],
        FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
          check (HolCore.Basics.is_forall o concl)) THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
        REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
        X_GEN_TAC (← q r"r:real^M->real") THEN STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"?c. s SUBSET interval[--(vec c):real^M,vec c] /\
          ~(interval(--(vec c):real^M,vec c) = {})")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPEC (← q r"abs c + &1") REAL_ARCH_SIMPLE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
        DISCH_TAC THEN REWRITE_TAC [SUBSET, INTERVAL_NE_EMPTY] THEN
        REWRITE_TAC [IN_INTERVAL, VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN
        STRIP_TAC THEN REWRITE_TAC [REAL_BOUNDS_LE] THEN W (MP_TAC o
          PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M"))) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"--(vec c):real^M", ← q r"(vec c):real^M",
                       ← q r"s:real^M->bool",
                       ← q r"\x:real^M. ball(x,r x)"] COVERING_LEMMA) THEN
      ASM_REWRITE_TAC [gauge, OPEN_BALL, CENTRE_IN_BALL] THEN

      REWRITE_TAC [VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"D:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!k. k IN D
          ==> ?u v z. k = interval[u,v] /\ ~(interval(u,v) = {}) /\
                      z IN s /\ z IN interval[u,v] /\
                      interval[u:real^M,v] SUBSET ball(z,r z)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"d:real^M->bool") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?u v:real^M. d = interval[u,v]") MP_TAC THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^M") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^M") THEN
        DISCH_THEN SUBST_ALL_TAC THEN
        ASM_MESON_TAC [SUBSET, INTERIOR_CLOSED_INTERVAL, IN_INTER],
        ALL_TAC] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"u:(real^M->bool)->real^M", ← q r"v:(real^M->bool)->real^M",
        ← q r"z:(real^M->bool)->real^M"] THEN
      DISCH_THEN (LABEL_TAC "*") THEN EXISTS_TAC
       (← q r"UNIONS(IMAGE (\d:real^M->bool.
         interval[(f:real^M->real^N)(z d) -
      (B * &(dimindex(:M)) *
      ((v(d):real^M)$1 - (u(d):real^M)$1)) % vec 1:real^N,
                  f(z d) +
                  (B * &(dimindex(:M)) * (v(d)$1 - u(d)$1)) % vec 1]) D)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"y:real^M") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(y:real^M) IN UNIONS D") MP_TAC THENL
         [ASM_MESON_TAC [SUBSET], REWRITE_TAC [UNIONS_IMAGE]] THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"d:real^M->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"(y:real^M) IN ball(z(d:real^M->bool),r(z d))") MP_TAC THENL
         [ASM_MESON_TAC [SUBSET], REWRITE_TAC [IN_BALL, dist]] THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"y IN t /\
        norm((f:real^M->real^N) y - f(z d)) <= B * norm(y - z(d:real^M->bool))")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REWRITE_TAC [IN_INTERVAL] THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
        REWRITE_TAC [← REAL_ARITH
         (← q r"z - b <= y /\ y <= z + b <=> abs(y - z) <= b")] THEN
        REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN W (MP_TAC o
          PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        REWRITE_TAC [VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            REAL_LE_TRANS)) THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
        W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o RAND_CONV)
         [← GSYM CARD_NUMSEG_1] THEN
        SIMP_TAC [← GSYM SUM_CONST, FINITE_NUMSEG] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"((v:(real^M->bool)->real^M) d - u d)$j") THEN
        REWRITE_TAC [VECTOR_SUB_COMPONENT] THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"y IN interval[(u:(real^M->bool)->real^M) d,v d] /\
                      (z d) IN interval[u d,v d]")
          MP_TAC THENL [ASM_MESON_TAC [], REWRITE_TAC [IN_INTERVAL]] THEN
          DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"j:num"))) THEN
          ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"(u:(real^M->bool)->real^M) d", ← q r"(v:(real^M->bool)->real^M) d"]) THEN
          ASM_MESON_TAC [DIMINDEX_GE_1, LE_REFL]],
        ALL_TAC] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(x <= e / &2 ==> x < e) /\ P /\ x <= e / &2 ==> P /\ x < e")) THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_GEN THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, MEASURABLE_INTERVAL] THEN
      ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"D':(real^M->bool)->bool") THEN STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE_LE o lhand o snd) THEN
      ASM_SIMP_TAC [MEASURE_POS_LE, MEASURABLE_INTERVAL] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      REWRITE_TAC [o_DEF] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"(&2 * B * &(dimindex(:M))) pow (dimindex(:N)) *
                sum D' (\d:real^M->bool. measure d)") THEN
      SUBGOAL_THEN (← q r"FINITE(D':(real^M->bool)->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM SUM_LMUL] THEN MATCH_MP_TAC SUM_LE THEN
        ASM_REWRITE_TAC [MEASURE_INTERVAL] THEN X_GEN_TAC (← q r"d:real^M->bool") THEN
        DISCH_TAC THEN REWRITE_TAC [CONTENT_CLOSED_INTERVAL_CASES] THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, ← REAL_ARITH
         (← q r"(a - x <= a + x <=> &0 <= x) /\ (a + x) - (a - x) = &2 * x")] THEN
        REWRITE_TAC [VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
        ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1] THEN
        SUBGOAL_THEN (← q r"d = interval[u d:real^M,v d]")
         (fun th => GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [th])
        THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
        REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
        SUBGOAL_THEN
         (← q r"!i. 1 <= i /\ i <= dimindex(:M)
            ==> ((u:(real^M->bool)->real^M) d)$i <= (v d:real^M)$i")
        MP_TAC THENL
         [ASM_MESON_TAC [SUBSET, INTERVAL_NE_EMPTY, REAL_LT_IMP_LE], ALL_TAC] THEN
        SIMP_TAC [REAL_SUB_LE, DIMINDEX_GE_1, LE_REFL] THEN DISCH_TAC THEN
        REWRITE_TAC [PRODUCT_CONST_NUMSEG, REAL_POW_MUL] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH,
                      ← GSYM REAL_MUL_ASSOC, ADD_SUB, DIMINDEX_GE_1, LE_1] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"((v d:real^M)$1 - ((u:(real^M->bool)->real^M) d)$1)
                  pow (dimindex(:M))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_POW_MONO_INV THEN
          ASM_SIMP_TAC [REAL_SUB_LE, DIMINDEX_GE_1, LE_REFL] THEN
          REWRITE_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> x <= a")) THEN W (MP_TAC o
            PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
          REWRITE_TAC [DIMINDEX_GE_1, LE_REFL] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"!z r. norm(z - u) < r /\ norm(z - v) < r /\ r <= &1 / &2
                ==> norm(v - u:real^M) <= &1")) THEN
          MAP_EVERY EXISTS_TAC
           [← q r"(z:(real^M->bool)->real^M) d",
            ← q r"r((z:(real^M->bool)->real^M) d):real"] THEN
          ASM_REWRITE_TAC [← GSYM dist, ← GSYM IN_BALL] THEN
          SUBGOAL_THEN
           (← q r"(u:(real^M->bool)->real^M) d IN interval[u d,v d] /\
          (v:(real^M->bool)->real^M) d IN interval[u d,v d]")
          MP_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET]] THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY],
          GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM CARD_NUMSEG_1] THEN
          SIMP_TAC [← GSYM PRODUCT_CONST, FINITE_NUMSEG] THEN
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC PRODUCT_EQ_NUMSEG THEN
          FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"(u:(real^M->bool)->real^M) d", ← q r"(v:(real^M->bool)->real^M) d"]) THEN
          ASM_MESON_TAC [DIMINDEX_GE_1, LE_REFL, SUBSET]],
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"(&2 * B * &(dimindex(:M))) pow dimindex(:N) *
                  measure(t:real^M->bool)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_LE_LMUL THEN
          CONJ_TAC THENL [MATCH_MP_TAC REAL_LT_IMP_LE, ALL_TAC],
          MATCH_MP_TAC REAL_LT_IMP_LE THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
          W (MP_TAC o PART_MATCH (rand o rand) REAL_LT_RDIV_EQ o snd)] THEN
        ASM_SIMP_TAC [REAL_POW_LT, REAL_LT_MUL, LE_1, DIMINDEX_GE_1,
                      ← REAL_ARITH (← q r"&0 < &2 * B <=> &0 < B"), REAL_OF_NUM_LT] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"measure(UNIONS D':real^M->bool)") THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [← q r"D':(real^M->bool)->bool",
                           ← q r"UNIONS D':real^M->bool"]
            MEASURE_ELEMENTARY) THEN
          ANTS_TAC THENL
           [ASM_REWRITE_TAC [division_of] THEN
            CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET]] THEN
            GEN_TAC THEN DISCH_TAC THEN CONJ_TAC THENL
             [ASM SET_TAC [], ASM_MESON_TAC [SUBSET, INTERIOR_EMPTY]],
            DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
            MATCH_MP_TAC SUM_EQ THEN ASM_MESON_TAC [MEASURE_INTERVAL, SUBSET]],
          MATCH_MP_TAC MEASURE_SUBSET THEN CONJ_TAC THENL
           [MATCH_MP_TAC MEASURABLE_UNIONS THEN
            ASM_MESON_TAC [MEASURABLE_INTERVAL, SUBSET],
            ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
            EXISTS_TAC (← q r"UNIONS D:real^M->bool") THEN
            ASM_SIMP_TAC [SUBSET_UNIONS] THEN
            REWRITE_TAC [SUBSET, FORALL_IN_UNIONS] THEN
            X_GEN_TAC (← q r"d:real^M->bool") THEN
            REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
            DISCH_TAC THEN REWRITE_TAC [← GSYM SUBSET] THEN
            SUBGOAL_THEN (← q r"d SUBSET ball(z d:real^M,r(z d))") MP_TAC THENL
             [ASM_MESON_TAC [],
              REWRITE_TAC [SUBSET, IN_BALL, dist] THEN
              ASM_MESON_TAC [NORM_SUB]]]]])
    prove
     r"!f:real^M->real^N s.
        dimindex(:M) <= dimindex(:N) /\ negligible s /\
        (!x. x IN s
             ==> ?t b. open t /\ x IN t /\
                       !y. y IN s INTER t
                           ==> norm(f y - f x) <= b * norm(y - x))
        ==> negligible(IMAGE f s)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"s = UNIONS
    {{x | x IN s /\ norm(x:real^M) <= &n /\
          ?t. open t /\ x IN t /\
              !y. y IN s INTER t
                  ==> norm(f y - f x:real^N) <= (&n + &1) * norm(y - x)} |
     n IN (:num)}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"t:real^M->bool") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPEC (← q r"max (norm(x:real^M)) b") REAL_ARCH_SIMPLE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [REAL_MAX_LE] THEN
        X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"b * norm(y - x:real^M)") THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [IMAGE_UNIONS] THEN
        MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
        REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        ASM_SIMP_TAC [← GSYM IMAGE_o, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_UNIV] THEN
        MATCH_MP_TAC lemma THEN EXISTS_TAC (← q r"&n + &1") THEN ASM_REWRITE_TAC [] THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC BOUNDED_SUBSET THEN
          EXISTS_TAC (← q r"cball(vec 0:real^M,&n)") THEN
          SIMP_TAC [BOUNDED_CBALL, SUBSET, IN_CBALL_0, IN_ELIM_THM],
          MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
          ASM_REWRITE_TAC [] THEN SET_TAC [],
          REAL_ARITH_TAC,
          REWRITE_TAC [IN_ELIM_THM, IN_INTER] THEN MESON_TAC []]]))

  pure { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Lipschitz and differentiable images of negligible and low-dimensional   -/
/- sets.  (measure.ml 8741-8846)                                            -/
/- ------------------------------------------------------------------------- -/

structure MSAJ where
  NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM : thm
  NEGLIGIBLE_LIPSCHITZ_IMAGE_UNIV : thm
  NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE : thm
  NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSAJ [HolBase] (D : MeasureDeps) (BMSAI : MSAI) : ExceptT String IO MSAJ := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE, .. } := BMSAI
  let { DIFFERENTIABLE_CHAIN_WITHIN, DIFFERENTIABLE_LINEAR, .. } := D.qderivatives
  let { NEGLIGIBLE_STANDARD_HYPERPLANE, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { DIST_PASTECART_CANCEL, .. } := D.qvec
  let { differentiable, differentiable_on, HAS_DERIVATIVE_WITHIN_ALT,
        .. } := D.ig.qderivatives
  let { pastecart, .. } := D.ig.qsession
  let { OPEN_PCROSS, .. } := D.ig.dv.qtopology2
  let { LINEAR_BOUNDED_POS, .. } := D.ig.dv.qvec
  let { ARITH_RULE, ASM_MESON_TAC, NORM_ARITH, REAL_ARITH_TAC, SET_RULE,
        .. } := D.ig.dv.dg.pt.cvx
  let { CART_EQ, DIMINDEX_1, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1, EQ_IMP, ETA_AX,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LAMBDA_BETA, LE_REFL, LEFT_IMP_EXISTS_THM, NOT_LT,
        PASTECART_IN_PCROSS, REAL_ADD_RDISTRIB, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LT_01, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, SNDCART_PASTECART, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.ig.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, OPEN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) < dimindex(:N) /\
        (!x. x IN s
             ==> ?t b. open t /\ x IN t /\
                       !y. y IN s INTER t
                           ==> norm(f y - f x) <= b * norm(y - x))
        ==> negligible(IMAGE f s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
      [← q r"(f:real^M->real^N) o (sndcart:real^(1,M)finite_sum->real^M)",
       ← q r"IMAGE (pastecart (vec 0:real^1)) (s:real^M->bool)"]
      NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, SNDCART_PASTECART, ETA_AX] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
    ASM_REWRITE_TAC [← ARITH_RULE (← q r"1 + m <= n <=> m < n")] THEN CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"{x:real^(1,M)finite_sum | x$1 = &0}") THEN
      SIMP_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE, DIMINDEX_GE_1, LE_REFL] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, SUBSET, IN_ELIM_THM] THEN
      SIMP_TAC [pastecart, LAMBDA_BETA, DIMINDEX_1, LE_REFL, VEC_COMPONENT,
                DIMINDEX_FINITE_SUM, ← ARITH_RULE (← q r"1 <= 1 + n")],
      REWRITE_TAC [IN_INTER, IMP_CONJ, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [← GSYM dist, DIST_PASTECART_CANCEL, SNDCART_PASTECART] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INTER] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"b:real"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"(:real^1) PCROSS (u:real^M->bool)", ← q r"b:real"] THEN
      ASM_SIMP_TAC [OPEN_PCROSS, OPEN_UNIV, PASTECART_IN_PCROSS, IN_UNIV] THEN
      ASM_SIMP_TAC [dist]])

  let NEGLIGIBLE_LIPSCHITZ_IMAGE_UNIV ← prove
   r"!f:real^N->real^N s B.
        negligible s /\ (!x y. norm(f x - f y) <= B * norm(x - y))
        ==> negligible(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN
    ASM_REWRITE_TAC [LE_REFL] THEN X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"interval(a - vec 1:real^N,a + vec 1)", ← q r"B:real"] THEN
    ASM_REWRITE_TAC [OPEN_INTERVAL, IN_INTERVAL] THEN
    REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT, VEC_COMPONENT] THEN
    REAL_ARITH_TAC)

  let NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) <= dimindex(:N) /\ negligible s /\ f differentiable_on s
        ==> negligible(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE THEN
    ASM_REWRITE_TAC [IN_INTER] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [differentiable_on]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
    ASM_REWRITE_TAC [differentiable, HAS_DERIVATIVE_WITHIN_ALT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f':real^M->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&1")) THEN
    REWRITE_TAC [REAL_LT_01, REAL_MUL_RID] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP LINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ball(x:real^M,d)") THEN EXISTS_TAC (← q r"B + &1") THEN
    ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
    REWRITE_TAC [IN_BALL, dist, REAL_ADD_RDISTRIB] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"!d. norm(y - x - d:real^N) <= z /\ norm(d) <= b
        ==> norm(y - x) <= b + z")) THEN
    EXISTS_TAC (← q r"(f':real^M->real^N)(y - x)") THEN
    ASM_MESON_TAC [NORM_SUB])

  let NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM ← prove
   r"!f:real^M->real^N s.
        dimindex(:M) < dimindex(:N) /\ f differentiable_on s
        ==> negligible(IMAGE f s)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP
     (← ARITH_RULE (← q r"m < n ==> !x:num. x <= m ==> x <= n"))) THEN
    SUBGOAL_THEN
     (← q r"(f:real^M->real^N) =
    (f o ((\x. lambda i. x$i):real^N->real^M)) o
    ((\x. lambda i. if i <= dimindex(:M) then x$i else &0):real^M->real^N)")
    SUBST1_TAC THENL
     [SIMP_TAC [FUN_EQ_THM, o_THM] THEN GEN_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA],
      ONCE_REWRITE_TAC [IMAGE_o] THEN
      MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE THEN
      REWRITE_TAC [LE_REFL] THEN CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"{y:real^N | y$(dimindex(:N)) = &0}") THEN
        SIMP_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE, LE_REFL, DIMINDEX_GE_1] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        SIMP_TAC [LAMBDA_BETA, LE_REFL, DIMINDEX_GE_1] THEN
        ASM_REWRITE_TAC [← GSYM NOT_LT],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [differentiable_on]) THEN
        REWRITE_TAC [differentiable_on, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        MATCH_MP_TAC DIFFERENTIABLE_CHAIN_WITHIN THEN CONJ_TAC THENL
         [MATCH_MP_TAC DIFFERENTIABLE_LINEAR THEN
          SIMP_TAC [linear, LAMBDA_BETA, CART_EQ,
                    VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT],
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN BINOP_TAC THENL
           [AP_TERM_TAC,
            MATCH_MP_TAC (← SET_RULE
             (← q r"(!x. f(g x) = x) ==> s = IMAGE f (IMAGE g s)"))] THEN
          ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA]]]])

  pure { NEGLIGIBLE_LOCALLY_LIPSCHITZ_IMAGE_LOWDIM, NEGLIGIBLE_LIPSCHITZ_IMAGE_UNIV,
         NEGLIGIBLE_DIFFERENTIABLE_IMAGE_NEGLIGIBLE, NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM }

/- ------------------------------------------------------------------------- -/
/- Simplest case of Sard's theorem (we don't need continuity of the        -/
/- derivative).  (measure.ml 8847-9167)                                     -/
/- ------------------------------------------------------------------------- -/

structure MSAK where
  BABY_SARD : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSAK [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSK : MSK) : ExceptT String IO MSAK := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_UNIONS, .. } := BMSB
  let { MEASURE_UNIONS_LE_IMAGE, NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN, NEGLIGIBLE_COUNTABLE_UNIONS_GEN,
        .. } := BMSF
  let { MEASURE_ELEMENTARY, .. } := BMSG
  let { COVERING_LEMMA, .. } := BMSK
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { division_of, gauge, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { PRODUCT_CLAUSES_LEFT, PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { REAL_BOUNDS_LT, .. } := D.qsession
  let { ONORM_POS_LE, RANK_DIM_IM, .. } := D.qvec
  let { has_derivative, HAS_DERIVATIVE_WITHIN_ALT, HAS_DERIVATIVE_WITHIN_SUBSET,
        .. } := D.ig.qderivatives
  let { IMAGE_UNIONS, SUM_CONST_NUMSEG, .. } := D.ig.qsession
  let { REAL_POW_MONO_INV, .. } := D.ig.dv.qsession
  let { ONORM, .. } := D.ig.dv.qvec
  let { ADD_SUB, .. } := D.ig.dv.dg.qsession
  let { NORM_LE_COMPONENTWISE, .. } := D.ig.dv.dg.qvec
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEN_GEOM_ORIGIN_TAC,
        GEOM_BASIS_MULTIPLE_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.ig.dv.dg.pt.qses
  let { AND_FORALL_THM, ARITH, CONJ_ASSOC, CONJ_SYM, DIMINDEX_GE_1, ETA_AX,
        EXISTS_IN_IMAGE, EXTENSION, FORALL_AND_THM, FORALL_FINITE_SUBSET_IMAGE,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LAMBDA_BETA, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM,
        MONO_AND, MONO_EXISTS, MONO_FORALL, REAL_ABS_REFL, REAL_ARCH_SIMPLE,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_LMUL,
        REAL_LE_LMUL_EQ, REAL_LE_LT, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_POW2, REAL_MAX_LE, REAL_MIN_LE,
        .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_SYM, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_POS,
        REAL_POW_LE, REAL_POW_LE2, REAL_POW_LT, REAL_POW_MUL, REAL_SUB_LE,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_div, real_pow, SUM_EQ, SUM_LE, SUM_LMUL, UNIONS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { COMPONENT_LE_NORM, DOT_BASIS, DOT_LMUL, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { ENDS_IN_INTERVAL, IN_INTERVAL, INTERVAL_NE_EMPTY, INTERVAL_OPEN_SUBSET_CLOSED,
        LOWDIM_SUBSET_HYPERPLANE, MATRIX_WORKS, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_POS_LE, NORM_SUB, SPAN_SUPERSET, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_MUL_LZERO, VECTOR_NEG_COMPONENT, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_CBALL, BOUNDED_SUBSET, CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, IN_CBALL_0, INTERIOR_EMPTY, OPEN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { bounded, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let BABY_SARD ← (do
    let lemma ← prove
     r"!p w e m.
      dim p < dimindex(:N) /\ &0 <= m /\ &0 <= e
      ==> ?s. measurable s /\
              {z:real^N | norm(z - w) <= m /\
                          ?t. t IN p /\ norm(z - w - t) <= e}
              SUBSET s /\
              measure s <= (&2 * e) * (&2 * m) pow (dimindex(:N) - 1)"
     (REPEAT GEN_TAC THEN GEN_GEOM_ORIGIN_TAC (← q r"w:real^N") ["t", "p"] THEN
      REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_SUBSET_HYPERPLANE) THEN
      REWRITE_TAC [VECTOR_SUB_RZERO, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^N") THEN GEOM_BASIS_MULTIPLE_TAC 1 (← q r"a:real^N") THEN
      X_GEN_TAC (← q r"a:real") THEN GEN_REWRITE_TAC LAND_CONV [REAL_LE_LT] THEN
      ASM_CASES_TAC (← q r"a = &0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      REPEAT STRIP_TAC THEN
      EXISTS_TAC
       (← q r"interval[--(lambda i. if i = 1 then e else m):real^N,
               (lambda i. if i = 1 then e else m)]") THEN
      REWRITE_TAC [MEASURABLE_INTERVAL] THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL] THEN
        SIMP_TAC [VECTOR_NEG_COMPONENT, LAMBDA_BETA] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
