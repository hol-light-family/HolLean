  let { LEBESGUE_MEASURABLE_TRANSLATION, .. } := BMSAN
  let { CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM, .. } := BMSCB
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_RESTRICT_INTER, ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV,
        ABSOLUTELY_INTEGRABLE_SUB, ABSOLUTELY_INTEGRABLE_TRANSLATION,
        .. } := D.qintegration1
  let { INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_TRANSLATION, .. } := D.qintegration2
  let { INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_RESTRICT_UNIV, INTEGRAL_SUB,
        INTEGRAL_TRANSLATION, .. } := D.qintegration3
  let { LIM_AT_REFLECT, LIM_AT_WITHIN, LIM_WITHIN_ZERO, .. } := D.qtopology2
  let { IN_TRANSLATION_GALOIS_ALT, .. } := D.qvec
  let { CONTINUOUS_ON, .. } := D.ig.qtopology
  let { indicator, .. } := D.ig.qvec
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { LIM_NULL, LIM_TRANSFORM_EVENTUALLY, LIM_WITHIN_SUBSET, .. } := D.ig.dv.qtopology2
  let { IN_TRANSLATION_GALOIS, .. } := D.ig.dv.qvec
  let { MESON, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, VECTOR_ARITH,
