  pure { ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS }
/- ------------------------------------------------------------------------- -/
/- Continuity of the (absolute) integral under translation.                 -/
/- (measure.ml 20112-20354)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCB where
  CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCB [HolBase] (D : MeasureDeps) (BMSAM : MSAM) (BMSCA : MSCA) : ExceptT String IO MSCB := do
  -- @@SCOPE BEGIN
  let { LEBESGUE_MEASURABLE_UNIV, .. } := BMSAM
  let { ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS, .. } := BMSCA
  let { ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_NORM, ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_INTEGRABLE_SUB,
        ABSOLUTELY_INTEGRABLE_TRANSLATION, CONTENT_EQ_0_INTERIOR, CONTENT_LT_NZ,
        CONTENT_SUBSET, .. } := D.qintegration1
  let { HAS_INTEGRAL_ALT, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_RESTRICT_UNIV,
        INTEGRABLE_TRANSLATION, INTEGRAL_ADD, .. } := D.qintegration2
  let { absolutely_integrable_on, INTEGRAL_COMPONENT_UBOUND, INTEGRAL_DROP_POS,
        INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_RESTRICT_UNIV, INTEGRAL_SUB,
        INTEGRAL_TRANSLATION, .. } := D.qintegration3
  let { BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC, .. } := D.qtopology1
  let { REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { INTERIOR_INTERVAL, INTERVAL_TRANSLATION, .. } := D.ig.qtopology
  let { TRANSLATION_UNIV, .. } := D.ig.qvec
  let { LIM_AT, .. } := D.ig.dv.qtopology1
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.ig.dv.dg.qtopology2
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { CONJ_ASSOC, DIMINDEX_1, ETA_AX, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_IMP, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_MIN, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SUBSET, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_0, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_SUB, IN_INTERVAL, LIFT_ADD, LIFT_DROP, LIFT_NUM, LIFT_SUB, NORM_0,
        NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_POS_LE, NORM_SUB, REAL_ABS_NORM, TRANSLATION_SUBSET_GALOIS_RIGHT,
        .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_NEG_COMPONENT,
        VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EQ_EMPTY, BOUNDED_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL_0, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let CONTINUOUS_ON_ABSOLUTELY_INTEGRABLE_TRANSLATION_NORM ← (do
    let lemma ← prove
     r"!f:real^M->real^N.
            lift(norm(f x)) - (if p x then lift(norm(f x)) else vec 0) =
            lift(norm(f x - (if p x then f x else vec 0)))"
     (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [VECTOR_SUB_RZERO, VECTOR_SUB_REFL] THEN
      REWRITE_TAC [NORM_0, LIFT_NUM])
    prove
     r"!f:real^M->real^N.
          f absolutely_integrable_on (:real^M)
          ==> ((\a. integral (:real^M) (\x. lift(norm(f(a + x) - f x))))
               --> vec 0) (at (vec 0))"
     (SUBGOAL_THEN
       (← q r"!f:real^M->real^N.
            f absolutely_integrable_on (:real^M) /\ f continuous_on (:real^M)
            ==> ((\a. integral (:real^M) (\x. lift(norm(f(a + x) - f x))))
                 --> vec 0) (at (vec 0))")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC,
        X_GEN_TAC (← q r"f:real^M->real^N") THEN STRIP_TAC THEN
        REWRITE_TAC [LIM_AT] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"e / &3"]
            ABSOLUTELY_INTEGRABLE_APPROXIMATE_CONTINUOUS) THEN
        ASM_REWRITE_TAC [LEBESGUE_MEASURABLE_UNIV] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"g:real^M->real^N")) THEN
        ASM_REWRITE_TAC [LIM_AT] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"a:real^M") THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^M")) THEN
