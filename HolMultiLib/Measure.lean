  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_LT, .. } := BMSAO
  let { MEASURABLE_ON_PREIMAGE_HALFSPACE_COMPONENT_GT, MEASURABLE_ON_PREIMAGE_OPEN,
