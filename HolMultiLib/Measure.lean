      DISCH_THEN (MP_TAC o SPEC
       (← q r"drop(integral (interval[a,x]) (f:real^1->real^1))") o MATCH_MP (← REAL_ARITH
       (← q r"u = x + r /\ v = x - r ==> !y. r <= abs(y - u) \/ r <= abs(y - v)"))) THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"dist(x:real^1,v) <= r", ← q r"dist(x:real^1,u) <= r"] THEN
      MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"v:real^1", ← q r"u:real^1"] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r ==> s <=> r ==> p /\ q ==> s")] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!u v. R u v ==> R v u) /\ (!u v. P u ==> R u v)
        ==> !u v. P u \/ P v ==> R u v")) THEN
      CONJ_TAC THENL [MESON_TAC [], REPEAT STRIP_TAC] THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"drop u <= drop x \/ drop x <= drop u")) THENL
       [MAP_EVERY EXISTS_TAC [← q r"u:real^1", ← q r"x:real^1"],
        MAP_EVERY EXISTS_TAC [← q r"x:real^1", ← q r"u:real^1"]] THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1] THEN
      (CONJ_TAC THENL
        [MATCH_MP_TAC (← MESON [SUBSET_TRANS, INTERVAL_SUBSET_SEGMENT_1]
          (← q r"segment[a:real^1,b] SUBSET t ==> interval[a,b] SUBSET t")) THEN
         SIMP_TAC [CONVEX_CONTAINS_SEGMENT_IMP, CONVEX_CBALL] THEN
         ASM_REWRITE_TAC [IN_CBALL, DIST_REFL] THEN ASM_REAL_ARITH_TAC,
         ALL_TAC]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          REAL_LE_TRANS)) THEN
      REWRITE_TAC [NORM_1] THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"u + d = x ==> abs(x - u) <= abs d")),
        MATCH_MP_TAC (← REAL_ARITH (← q r"x + d = u ==> abs(x - u) <= abs d"))] THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_ADD, LIFT_DROP] THEN
      MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
      (SUBGOAL_THEN (← q r"x IN interval(a:real^1,b)") MP_TAC THENL
        [ASM SET_TAC [], REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC]) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      UNDISCH_TAC (← q r"cball(x:real^1,r) SUBSET interval [a,b]") THEN
      REWRITE_TAC [SUBSET] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:real^1")) THEN
      ASM_REWRITE_TAC [IN_CBALL, IN_INTERVAL_1] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1->real->real^1", ← q r"v:real^1->real->real^1"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                      ← q r"g:real^1->real^1->bool", ← q r"e:real"]
          HENSTOCK_LEMMA_PART2) THEN
    ASM_REWRITE_TAC [DIMINDEX_1, REAL_MUL_LID] THEN
    DISCH_THEN (MP_TAC o SPEC
      (← q r"IMAGE (\(x:real^1,r:real). x,interval[u x r:real^1,v x r]) l")) THEN
    REWRITE_TAC [tagged_partial_division_of, ← GSYM CONJ_ASSOC] THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN ANTS_TAC THENL
     [REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, PAIR_EQ] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x r x' r'. (x,r) IN l /\ (x',r') IN l /\ ~(x = x' /\ r = r')
                  ==> DISJOINT (interval[(u:real^1->real->real^1) x r,v x r])
                               (interval[u x' r',v x' r'])")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"r:real", ← q r"x':real^1", ← q r"r':real"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"x:real^1", ← q r"r:real", ← q r"x':real^1", ← q r"r':real"]) THEN
      ASM_REWRITE_TAC [PAIR_EQ] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(?f. IMAGE f s SUBSET t /\ IMAGE f s' SUBSET t')
        ==> DISJOINT t t' ==> DISJOINT s s'")) THEN
      EXISTS_TAC (← q r"\c. integral (interval [a,c]) (f:real^1->real^1)") THEN
      CONJ_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"!t. s SUBSET t /\ IMAGE f t = v ==> IMAGE f s SUBSET v"))
      THENL
       [EXISTS_TAC (← q r"cball(x:real^1,r)"), EXISTS_TAC (← q r"cball(x':real^1,r')")] THEN
      ASM_SIMP_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, PAIR_EQ] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"interior s SUBSET s /\ interior t SUBSET t /\ DISJOINT s t
        ==> interior s INTER interior t = {}")) THEN
      REWRITE_TAC [INTERIOR_SUBSET] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [fine, IN_IMAGE, EXISTS_PAIR_THM, PAIR_EQ] THEN
      SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE o lhand o lhand o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ] THEN ASM SET_TAC [],
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= &2 * q ==> p = q ==> p <= &2 * e ==> x <= &4 * e")) THEN
      REWRITE_TAC [← GSYM SUM_LMUL] THEN MATCH_MP_TAC SUM_LE THEN
      ASM_REWRITE_TAC [FORALL_PAIR_THM, o_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"r:real"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(f:real^1->real^1) x = vec 0") SUBST1_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [VECTOR_MUL_RZERO]] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_POS] THEN
      ASM_SIMP_TAC [← NORM_ARITH (← q r"norm(vec 0 - x:real^N) = norm x")]])

  pure { NEGLIGIBLE_IMAGE_INDEFINITE_INTEGRAL }
/- ------------------------------------------------------------------------- -/
/- Increasing/decreasing/constant from the sign of an a.e. derivative.     -/
/- (measure.ml 27200-27469)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCY where
  POSITIVE_AE_DERIVATIVE_IMP_NONDECREASING : thm
  POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT_GEN : thm
  POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT : thm
  POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN : thm
  POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE : thm
  ZERO_AE_DERIVATIVE_IMP_CONSTANT_GEN : thm
  ZERO_AE_DERIVATIVE_IMP_CONSTANT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCY [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMST : MST) (BMSAK : MSAK) (BMSCV : MSCV) : ExceptT String IO MSCY := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_EMPTY_INTERIOR, .. } := BMSC
  let { NEGLIGIBLE_LINEAR_IMAGE, .. } := BMST
  let { BABY_SARD, .. } := BMSAK
  let { NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE, .. } := BMSCV
  let { IVT_DECREASING_COMPONENT_ON_1, .. } := D.qconvex
  let { has_derivative_at, HAS_VECTOR_DERIVATIVE_NEG,
        HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN, VECTOR_DERIVATIVE_UNIQUE_AT,
        .. } := D.qderivatives
  let { DET_1, DET_EQ_0_RANK, .. } := D.qdet
  let { ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS, .. } := D.qintegration1
  let { NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { has_vector_derivative, HAS_VECTOR_DERIVATIVE_AT_WITHIN,
        HAS_VECTOR_DERIVATIVE_CONST, .. } := D.ig.qderivatives
  let { INTERIOR_INTERVAL, OPEN_CLOSED_INTERVAL_1, .. } := D.ig.qtopology
  let { CONNECTED_INTERVAL, .. } := D.ig.dv.qconvex
  let { LIM_AT, .. } := D.ig.dv.qtopology1
  let { matrix, .. } := D.ig.dv.qvec
  let { IS_INTERVAL_CONNECTED_1, .. } := D.ig.dv.dg.qconvex
  let { BALL_1, DISJOINT_INTERVAL_1, .. } := D.ig.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, LINEAR_NEGATION, .. } := D.ig.dv.dg.pt.qvec
  let { AND_FORALL_THM, DIMINDEX_1, EXISTS_IN_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_o, IMAGE_UNION, IMP_CONJ, IMP_IMP, IN_DIFF, INTER_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING, LAMBDA_BETA, LE_REFL, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, REAL_ABS_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_NEG2, REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ,
        REAL_LT_LE, REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NEG_0, REAL_NOT_LT, REAL_SUB_LE,
        RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, real_div, SUBSET_UNIV, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DIST_0, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, ENDS_IN_INTERVAL, LIFT_DROP,
        LIFT_EQ, LIFT_NUM, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, VECTOR_SUB_EQ, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.ig.dv.dg.pt.cvx.met
  let { CLOSED_IN, CLOSED_SING, .. } := D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_INTERVAL, CONNECTED_CONTINUOUS_IMAGE, CONTINUOUS_ATTAINS_SUP,
        .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_1, IS_INTERVAL_INTERVAL,
        LINEAR_CONTINUOUS_ON, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, PROPER_MAP_FROM_COMPACT, SUBSET_INTERIOR,
        .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let POSITIVE_AE_DERIVATIVE_IMP_NONDECREASING ← (do
    let lemma1 ← prove
     r"!f f' a b s.
          drop a <= drop b /\
          f continuous_on interval[a,b] /\
          interior(IMAGE f s) = {} /\
          (!x. x IN interval[a,b] DIFF s
               ==> (f has_vector_derivative f' x) (at x) /\ &0 < drop(f' x))
          ==> drop(f a) <= drop(f b)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"~(interval(f b,f a) SUBSET IMAGE (f:real^1->real^1) s)")
      MP_TAC THENL
       [DISCH_THEN (MP_TAC o MATCH_MP SUBSET_INTERIOR) THEN
        ASM_REWRITE_TAC [SUBSET_EMPTY, INTERVAL_NE_EMPTY_1, INTERIOR_INTERVAL],
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^1") THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC] THEN
      MP_TAC (← ISPECL [← q r"drop",
                        ← q r"{x | x IN interval[a,b] /\ (f:real^1->real^1) x = y}"]
            CONTINUOUS_ATTAINS_SUP) THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID, IN_ELIM_THM] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC [← GSYM IN_SING] THEN
          MATCH_MP_TAC PROPER_MAP_FROM_COMPACT THEN EXISTS_TAC (← q r"(:real^1)") THEN
          ASM_REWRITE_TAC [SUBSET_UNIV, COMPACT_INTERVAL] THEN
          REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN, CLOSED_SING],
          REWRITE_TAC [← SET_RULE
           (← q r"~({x | x IN s /\ f x = y} = {}) <=> y IN IMAGE f s")] THEN
          SUBGOAL_THEN (← q r"connected (IMAGE (f:real^1->real^1) (interval[a,b]))")
          MP_TAC THENL
           [ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INTERVAL],
            REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1]] THEN
          DISCH_THEN MATCH_MP_TAC THEN
          REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_IMAGE] THEN
          EXISTS_TAC (← q r"b:real^1") THEN
          ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN
          EXISTS_TAC (← q r"a:real^1") THEN
          ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN
          ASM_REAL_ARITH_TAC],
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^1") MP_TAC) THEN
        ASM_CASES_TAC (← q r"(c:real^1) IN s") THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_CASES_TAC (← q r"c IN interval[a:real^1,b]") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^1")) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"c IN interval(a:real^1,b)") ASSUME_TAC THENL
         [SIMP_TAC [OPEN_CLOSED_INTERVAL_1, IN_INSERT, NOT_IN_EMPTY, IN_DIFF] THEN
          ASM_MESON_TAC [REAL_LT_REFL],
          MATCH_MP_TAC (← TAUT (← q r"F ==> p"))]] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [has_vector_derivative]) THEN
      REWRITE_TAC [has_derivative_at, LIM_AT, DIST_0] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"drop(f'(c:real^1))") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      SIMP_TAC [dist, REAL_LT_LDIV_EQ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      SUBGOAL_THEN (← q r"~(ball(c:real^1,d) INTER interval(c,b) = {})") MP_TAC THENL
       [SIMP_TAC [BALL_1, DISJOINT_INTERVAL_1, DROP_SUB, DROP_ADD, LIFT_DROP] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IMP] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^1") THEN
      SIMP_TAC [IN_INTER, IN_BALL, ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
      ASM_CASES_TAC (← q r"x:real^1 = c") THEN ASM_REWRITE_TAC [ENDS_IN_INTERVAL] THEN
      ASM_REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ, IN_INTERVAL_1] THEN
      STRIP_TAC THEN GEN_REWRITE_TAC (funpow 3 RAND_CONV) [NORM_1] THEN
      ASM_SIMP_TAC [DROP_SUB, real_abs, REAL_SUB_LE, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [NORM_1, DROP_ADD, DROP_SUB, DROP_CMUL] THEN MATCH_MP_TAC
       (← REAL_ARITH (← q r"~(y < x) ==> ~(abs(x - (y + a * b)) < b * a)")) THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"x:real^1", ← q r"b:real^1",
                        ← q r"drop y", ← q r"1"] IVT_DECREASING_COMPONENT_ON_1) THEN
      ASM_SIMP_TAC [DIMINDEX_1, LE_REFL, ← GSYM drop, REAL_LT_IMP_LE, NOT_IMP] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [IN_INTERVAL_1, DROP_EQ] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^1") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:real^1")) THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC])
    prove
     r"!f f' a b s.
        f continuous_on interval[a,b] /\
        interior(IMAGE f s) = {} /\
        (!x. x IN interval[a,b] DIFF s
             ==> (f has_vector_derivative f' x) (at x) /\ &0 < drop(f' x))
        ==> !x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
                  ==> drop(f x) <= drop(f y)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma1 THEN
      MAP_EVERY EXISTS_TAC [← q r"f':real^1->real^1", ← q r"s:real^1->bool"] THEN
      ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        X_GEN_TAC (← q r"w:real^1") THEN REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
        STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, IN_DIFF] THEN ASM_REAL_ARITH_TAC]))

  let POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT_GEN ← prove
   r"!f:real^1->real^1 f' a b s.
      f continuous_on interval[a,b] /\
      interior s = {} /\ interior(IMAGE f s) = {} /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f' x) (at x) /\ &0 < drop(f' x))
      ==> !x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x < drop y
                ==> drop(f x) < drop(f y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"f':real^1->real^1",
                      ← q r"a:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"]
          POSITIVE_AE_DERIVATIVE_IMP_NONDECREASING) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [REAL_LT_LE] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [REAL_LT_IMP_LE], ALL_TAC] THEN
    DISCH_THEN (ASSUME_TAC o SYM) THEN
    SUBGOAL_THEN (← q r"!w. w IN interval[x,y] ==> (f:real^1->real^1) w = f x")
    ASSUME_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ, ← GSYM REAL_LE_ANTISYM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN REPEAT STRIP_TAC THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM), ALL_TAC] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
      ASM_REAL_ARITH_TAC,
      SUBGOAL_THEN (← q r"~(interval(x:real^1,y) SUBSET s)") MP_TAC THENL
       [DISCH_THEN (MP_TAC o MATCH_MP SUBSET_INTERIOR) THEN
        ASM_REWRITE_TAC [INTERIOR_INTERVAL, SUBSET_EMPTY] THEN
        ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1],
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"z:real^1") THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"(z:real^1) IN s") THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
          (← q r"(f has_vector_derivative f'(z:real^1)) (at z) /\ &0 < drop(f' z)")
        MP_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> &0 < x ==> F"))] THEN
        REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP, LIFT_NUM] THEN
        MATCH_MP_TAC VECTOR_DERIVATIVE_UNIQUE_AT THEN
        MAP_EVERY EXISTS_TAC [← q r"f:real^1->real^1", ← q r"z:real^1"] THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
        EXISTS_TAC (← q r"\w:real^1. (f:real^1->real^1) x") THEN
        EXISTS_TAC (← q r"interval(x:real^1,y)") THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, OPEN_INTERVAL,
                         HAS_VECTOR_DERIVATIVE_CONST] THEN
        ASM_MESON_TAC [IN_INTERVAL_1, REAL_LT_IMP_LE]]])

  let POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT ← prove
   r"!f:real^1->real^1 f' a b s.
      f absolutely_continuous_on interval[a,b] /\ negligible s /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f' x) (at x) /\ &0 < drop(f' x))
      ==> !x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x < drop y
                ==> drop(f x) < drop(f y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT_GEN THEN
    MAP_EVERY EXISTS_TAC
     [← q r"f':real^1->real^1", ← q r"interval[a:real^1,b] INTER s"] THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
                  IS_INTERVAL_INTERVAL] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"i DIFF (i INTER s) = i DIFF s")] THEN
    CONJ_TAC THEN MATCH_MP_TAC NEGLIGIBLE_EMPTY_INTERIOR THENL
     [ALL_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE)) THEN
      REWRITE_TAC [INTER_SUBSET, IS_INTERVAL_INTERVAL]] THEN
    ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET])

  let POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN ← prove
   r"!f:real^1->real^1 f' a b s.
      f continuous_on interval[a,b] /\ negligible(IMAGE f s) /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f' x) (at x) /\ &0 <= drop(f' x))
      ==> !x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
                ==> drop(f x) <= drop(f y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC POSITIVE_AE_DERIVATIVE_IMP_NONDECREASING THEN
    EXISTS_TAC (← q r"f':real^1->real^1") THEN
    EXISTS_TAC
     (← q r"s UNION {x | x IN interval[a,b] DIFF s /\
                   (f':real^1->real^1) x = vec 0}") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"x IN i DIFF (s UNION {x | x IN i DIFF s /\ P x}) <=>
       x IN i /\ ~P x /\ ~(x IN s)")] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)"), IN_DIFF] THEN
    SIMP_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
    MATCH_MP_TAC NEGLIGIBLE_EMPTY_INTERIOR THEN
    ASM_REWRITE_TAC [IMAGE_UNION, NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC BABY_SARD THEN
    EXISTS_TAC (← q r"\x h. drop h % (f':real^1->real^1) x") THEN
    REWRITE_TAC [LE_REFL, ← GSYM has_vector_derivative] THEN
    ASM_SIMP_TAC [IN_ELIM_THM, IN_DIFF, HAS_VECTOR_DERIVATIVE_AT_WITHIN] THEN
    REWRITE_TAC [← GSYM DET_EQ_0_RANK, DET_1] THEN
    SIMP_TAC [matrix, LAMBDA_BETA, LE_REFL, DIMINDEX_1] THEN
    SIMP_TAC [← GSYM drop, DROP_CMUL, REAL_MUL_RZERO])

  let POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE ← prove
   r"!f:real^1->real^1 f' a b s.
      f absolutely_continuous_on interval[a,b] /\ negligible s /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f' x) (at x) /\ &0 <= drop(f' x))
      ==> !x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
                ==> drop(f x) <= drop(f y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN THEN
    MAP_EVERY EXISTS_TAC
     [← q r"f':real^1->real^1", ← q r"interval[a:real^1,b] INTER s"] THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
                  IS_INTERVAL_INTERVAL] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"i DIFF (i INTER s) = i DIFF s")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE)) THEN
    REWRITE_TAC [INTER_SUBSET, IS_INTERVAL_INTERVAL] THEN
    ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET])

  let ZERO_AE_DERIVATIVE_IMP_CONSTANT_GEN ← prove
   r"!f:real^1->real^1 a b s.
      f continuous_on interval[a,b] /\
      negligible(IMAGE f s) /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative (vec 0)) (at x))
      ==> !x. x IN interval[a,b] ==> f x = f a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"(\x. vec 0):real^1->real^1"]
     POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN) THEN
    MP_TAC (← ISPECL
     [← q r"(--) o (f:real^1->real^1)", ← q r"(--) o (\x. vec 0):real^1->real^1"]
     POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN) THEN
    REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"s:real^1->bool"]) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, IMAGE_o, LINEAR_CONTINUOUS_ON,
                  LINEAR_NEGATION, NEGLIGIBLE_LINEAR_IMAGE] THEN
    ASM_SIMP_TAC [DROP_VEC, REAL_LE_REFL, o_DEF, HAS_VECTOR_DERIVATIVE_NEG] THEN
    REWRITE_TAC [DROP_NEG, DROP_VEC, REAL_LE_REFL, REAL_NEG_0, REAL_LE_NEG2] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"x:real^1"]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
    REWRITE_TAC [← GSYM DROP_EQ, IN_INTERVAL_1, ← GSYM REAL_LE_ANTISYM] THEN
    ASM_REAL_ARITH_TAC)

  let ZERO_AE_DERIVATIVE_IMP_CONSTANT ← prove
   r"!f:real^1->real^1 a b s.
      f absolutely_continuous_on interval[a,b] /\ negligible s /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative (vec 0)) (at x))
      ==> !x. x IN interval[a,b] ==> f x = f a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC ZERO_AE_DERIVATIVE_IMP_CONSTANT_GEN THEN
    EXISTS_TAC (← q r"interval[a:real^1,b] INTER s") THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
                  IS_INTERVAL_INTERVAL] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"i DIFF (i INTER s) = i DIFF s")] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        NEGLIGIBLE_ABSOLUTELY_CONTINUOUS_IMAGE)) THEN
    REWRITE_TAC [INTER_SUBSET, IS_INTERVAL_INTERVAL] THEN
    ASM_MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET])

  pure { POSITIVE_AE_DERIVATIVE_IMP_NONDECREASING,
         POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT_GEN,
         POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LT,
         POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE_GEN,
         POSITIVE_AE_DERIVATIVE_IMP_INCREASING_LE,
         ZERO_AE_DERIVATIVE_IMP_CONSTANT_GEN, ZERO_AE_DERIVATIVE_IMP_CONSTANT }
/- ------------------------------------------------------------------------- -/
/- Convergence in measure implies convergence AE of a subsequence.         -/
/- (measure.ml 27470-27607)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSCZ where
  CONVERGENCE_IN_MEASURE : thm
  CONVERGENCE_IN_MEASURE_UNIQUE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSCZ [HolBase] (D : MeasureDeps) (BMSC : MSC) (BMSF : MSF) : ExceptT String IO MSCZ := do
  -- @@SCOPE BEGIN
  let { NEGLIGIBLE_OUTER_LE, .. } := BMSC
  let { MEASURE_COUNTABLE_UNIONS_LE, .. } := BMSF
  let { NEGLIGIBLE_INTER, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, .. } := D.qintegration3
  let { EVENTUALLY_SUBSEQUENCE, .. } := D.qmetric
  let { TRANSITIVE_STEPWISE_LT, .. } := D.qsession
  let { SUM_GP, .. } := D.ig.qmisc
  let { LE_EXISTS, REAL_POW_ADD, .. } := D.ig.qsession
  let { REAL_INV_INV, REAL_POW_MONO_INV, .. } := D.ig.dv.qsession
  let { DEPENDENT_CHOICE, LT, REAL_LT_TRANS, .. } := D.ig.dv.dg.qsession
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, REAL_ARITH, REAL_RAT_REDUCE_CONV, SET_RULE,
        SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { FORALL_AND_THM, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMP_CONJ_ALT, IN_DIFF, INTER_SUBSET, INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE_ADD, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_FORALL_THM, REAL_ARCH_POW_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LE_INV_EQ, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_POW2, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, REAL_POS, REAL_POW_INV, REAL_POW_LE, SKOLEM_THM, SUBSET,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, real_ge, SUM_LE_NUMSEG, SUM_LMUL, UNIONS_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, LIM_UNIQUE, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let CONVERGENCE_IN_MEASURE ← prove
   r"!f:num->real^M->real^N g s.
        (!n. f n measurable_on s) /\
        (!e. &0 < e
             ==> eventually
                  (\n. ?t. {x | x IN s /\ dist(f n x,g x) >= e} SUBSET t /\
                           measurable t /\ measure t < e)
                  sequentially)
        ==> ?r t. (!m n:num. m < n ==> r m < r n) /\
                  negligible t /\ t SUBSET s /\
                  !x. x IN s DIFF t
                      ==> ((\n. f (r n) x) --> g x) sequentially"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?r. (!n. ?t. {x | x IN s /\ dist(f (r n) x,(g:real^M->real^N) x)
                                  >= inv(&2 pow n)} SUBSET t /\
                        measurable t /\ measure t < inv(&2 pow n)) /\
          (!n. r n :num < r(SUC n))")
    MP_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&1")),
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"p:num"] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&2 pow (SUC n))"))] THEN
      ASM_REWRITE_TAC [REAL_LT_01, REAL_LT_INV_EQ, REAL_LT_POW2] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THENL
       [MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"m:num") THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"m:num")) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LE_REFL],
        DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (MP_TAC o SPEC (← q r"m + p + 1:num"))) THEN
        DISCH_THEN (fun th => tactic_of do
          pure (EXISTS_TAC (← q r"m + p + 1:num") THEN MP_TAC th)) THEN
        REWRITE_TAC [LE_ADD, ← ARITH_RULE (← q r"p < m + p + 1")]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      X_GEN_TAC (← q r"t:num->real^M->bool") THEN STRIP_TAC] THEN
    EXISTS_TAC (← q r"s INTER
         INTERS {UNIONS {(t:num->real^M->bool) k | n <= k} | n IN (:num)}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN ASM_REWRITE_TAC [] THEN ARITH_TAC,
      MATCH_MP_TAC NEGLIGIBLE_INTER THEN DISJ2_TAC THEN
      SIMP_TAC [NEGLIGIBLE_OUTER_LE] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e / &2"] REAL_ARCH_POW_INV) THEN
      ASM_REWRITE_TAC [REAL_POW_INV, REAL_HALF] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS {(t:num->real^M->bool) k | N <= k}") THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"x IN s ==> INTERS s SUBSET x")) THEN SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [LE_EXISTS, ← SET_RULE
       (← q r"{f n | ?d. n = N + d} = {f(N + n) | n IN (:num)}")] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"n:num") THEN
      TRANS_TAC REAL_LE_TRANS (← q r"sum(0..n) (\k. inv(&2 pow (N + k)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
        ALL_TAC] THEN
      REWRITE_TAC [REAL_POW_ADD, REAL_INV_MUL, SUM_LMUL, ← GSYM REAL_POW_INV] THEN
      REWRITE_TAC [SUM_GP, ← CONJUNCT1 LT] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [real_div, REAL_MUL_LID, REAL_INV_INV] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x * y * &2 <= e <=> y * x <= e / &2")] THEN
      REWRITE_TAC [REAL_POW_INV] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REAL_ARITH (← q r"n < e / &2 ==> &0 <= x * n ==> (&1 - x) * n <= e / &2"))) THEN
      REWRITE_TAC [← GSYM REAL_INV_MUL, REAL_LE_INV_EQ, ← GSYM REAL_POW_ADD] THEN
      SIMP_TAC [REAL_POW_LE, REAL_POS],
      REWRITE_TAC [INTER_SUBSET],
      X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF (s INTER t) = s DIFF t")] THEN
      REWRITE_TAC [IN_DIFF, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_EXISTS_THM] THEN
      REWRITE_TAC [← TAUT (← q r"~(a /\ b) <=> a ==> ~b")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (LABEL_TAC "*")) THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
      ASM_REWRITE_TAC [REAL_POW_INV] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"M:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"N + M:num") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"n:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [SUBSET]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^M"]) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, real_ge, REAL_NOT_LE] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LT_TRANS) THEN
      TRANS_TAC REAL_LET_TRANS (← q r"inv(&2 pow M)") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM REAL_POW_INV] THEN MATCH_MP_TAC REAL_POW_MONO_INV THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC])

  let CONVERGENCE_IN_MEASURE_UNIQUE ← prove
   r"!f:num->real^M->real^N g h s.
        (!n. f n measurable_on s) /\
        (!e. &0 < e
             ==> eventually
                  (\n. ?t. {x | x IN s /\ dist(f n x,g x) >= e} SUBSET t /\
                           measurable t /\ measure t < e)
                  sequentially) /\
        (!e. &0 < e
             ==> eventually
                  (\n. ?t. {x | x IN s /\ dist(f n x,h x) >= e} SUBSET t /\
                           measurable t /\ measure t < e)
                  sequentially)
        ==> negligible {x | x IN s /\ ~(g x = h x)}"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "g") (LABEL_TAC "h")) THEN
    MP_TAC (← ISPECL [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N",
                      ← q r"s:real^M->bool"] CONVERGENCE_IN_MEASURE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"r:num->num", ← q r"t:real^M->bool"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(f:num->real^M->real^N) o (r:num->num)", ← q r"h:real^M->real^N",
                      ← q r"s:real^M->bool"] CONVERGENCE_IN_MEASURE) THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "h" (MP_TAC o SPEC (← q r"e:real")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"r:num->num") o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] EVENTUALLY_SUBSEQUENCE)) THEN
      ASM_REWRITE_TAC [o_DEF],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"r':num->num", ← q r"t':real^M->bool"] THEN
    STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"t UNION t':real^M->bool") THEN
    ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ, ← SET_RULE
     (← q r"{x | x IN s /\ ~P x} SUBSET t <=> !x. x IN s DIFF t ==> P x")] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    REWRITE_TAC [← SET_RULE
     (← q r"x IN s DIFF (t UNION t') <=> x IN s DIFF t /\ x IN s DIFF t'")] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN EXISTS_TAC
     (← q r"((\n. (f:num->real^M->real^N) n x) o (r:num->num)) o (r':num->num)") THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    CONJ_TAC THENL [MATCH_MP_TAC LIM_SUBSEQUENCE, ALL_TAC] THEN
    ASM_SIMP_TAC [o_DEF])

  pure { CONVERGENCE_IN_MEASURE, CONVERGENCE_IN_MEASURE_UNIQUE }
/- ------------------------------------------------------------------------- -/
/- Basic path notions for AC paths.                                         -/
/- (measure.ml 27608-27863)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDA where
  ABSOLUTELY_CONTINUOUS_IMP_PATH : thm
  ABSOLUTELY_CONTINUOUS_IMP_RECTIFIABLE_PATH : thm
  ABSOLUTELY_INTEGRABLE_VECTOR_DERIVATIVE_ABSOLUTELY_CONTINUOUS : thm
  ABSOLUTELY_CONTINUOUS_REVERSEPATH : thm
  ABSOLUTELY_CONTINUOUS_JOINPATHS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSDA [HolBase] (D : MeasureDeps) (BMSCS : MSCS) (BMSCV : MSCV) : ExceptT String IO MSDA := do
  -- @@SCOPE BEGIN
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE, .. } := BMSCS
  let { ABSOLUTELY_CONTINUOUS_ON_COMPOSE, .. } := BMSCV
  let { VECTOR_DERIVATIVE_AT, .. } := D.qderivatives
  let { ABSOLUTELY_CONTINUOUS_ON_CMUL, ABSOLUTELY_CONTINUOUS_ON_COMBINE,
        ABSOLUTELY_CONTINUOUS_ON_CONST, ABSOLUTELY_CONTINUOUS_ON_EQ,
        ABSOLUTELY_CONTINUOUS_ON_ID, ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUB, .. } := D.qintegration1
  let { HAS_BOUNDED_VARIATION_COMPOSE_DECREASING, HAS_BOUNDED_VARIATION_COMPOSE_INCREASING,
        INTEGRABLE_SPIKE, .. } := D.qintegration2
  let { absolutely_integrable_on, rectifiable_path, .. } := D.qintegration3
  let { reversepath, .. } := D.ig.qpaths
  let { joinpaths, path, pathfinish, pathstart, .. } := D.ig.dv.dg.qpaths2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        .. } := D.ig.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { FORALL_IN_IMAGE, IMP_IMP, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_LMUL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_MUL_RZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, IS_INTERVAL_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top4
  -- @@SCOPE END

  let ABSOLUTELY_CONTINUOUS_IMP_PATH ← prove
   r"!g:real^1->real^N.
      g absolutely_continuous_on interval[vec 0,vec 1] ==> path g"
   (REWRITE_TAC [path] THEN
    MESON_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS, IS_INTERVAL_INTERVAL])

  let ABSOLUTELY_CONTINUOUS_IMP_RECTIFIABLE_PATH ← prove
   r"!g:real^1->real^N.
      g absolutely_continuous_on interval[vec 0,vec 1] ==> rectifiable_path g"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [rectifiable_path] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [ABSOLUTELY_CONTINUOUS_IMP_PATH, path],
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
      ASM_REWRITE_TAC [BOUNDED_INTERVAL]])

  let ABSOLUTELY_INTEGRABLE_VECTOR_DERIVATIVE_ABSOLUTELY_CONTINUOUS ← prove
   r"!g:real^1->real^N.
      g absolutely_continuous_on interval[vec 0,vec 1]
      ==> (\t. vector_derivative g (at t))
          absolutely_integrable_on interval[vec 0,vec 1]"
   (GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN
      (← q r"g:real^1->real^N has_bounded_variation_on interval[vec 0,vec 1]")
      MP_TAC THENL
    [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
     ASM_REWRITE_TAC [BOUNDED_INTERVAL], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
      ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"gd:real^1->real^N", ← q r"s1:real^1->bool"] THEN
    STRIP_TAC THEN
    REWRITE_TAC [absolutely_integrable_on] THEN CONJ_TAC THENL
     [MP_TAC (← ISPECL
        [← q r"gd:real^1->real^N",
         ← q r"\t:real^1. vector_derivative (g:real^1->real^N) (at t)",
         ← q r"s1:real^1->bool",
         ← q r"interval[vec 0:real^1,vec 1]"]
        INTEGRABLE_SPIKE) THEN
      CONV_TAC (LAND_CONV (DEPTH_CONV BETA_CONV)) THEN
      REWRITE_TAC [IMP_IMP] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:real^1") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_DIFF],
        ASM_MESON_TAC [absolutely_integrable_on]],
      MP_TAC (← ISPECL
        [← q r"\t:real^1. lift(norm((gd:real^1->real^N) t))",
         ← q r"\t:real^1. lift(norm(vector_derivative (g:real^1->real^N) (at t)))",
         ← q r"s1:real^1->bool",
         ← q r"interval[vec 0:real^1,vec 1]"]
        INTEGRABLE_SPIKE) THEN
      CONV_TAC (LAND_CONV (DEPTH_CONV BETA_CONV)) THEN
      REWRITE_TAC [IMP_IMP] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:real^1") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_DIFF],
        ASM_MESON_TAC [absolutely_integrable_on]]])

  let ABSOLUTELY_CONTINUOUS_REVERSEPATH ← prove
   r"!g:real^1->real^N.
      g absolutely_continuous_on interval[vec 0,vec 1]
      ==> (reversepath g) absolutely_continuous_on interval[vec 0,vec 1]"
   (GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [reversepath] THEN
    SUBGOAL_THEN
      (← q r"(\t:real^1. (g:real^1->real^N)(vec 1 - t)) =
       (g:real^1->real^N) o (\t:real^1. vec 1 - t)")
      SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"(\t:real^1. vec 1 - t)
       absolutely_continuous_on interval[vec 0:real^1, vec 1]")
      ASSUME_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUB THEN
      REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_CONST, ABSOLUTELY_CONTINUOUS_ON_ID],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
      [← q r"g:real^1->real^N",
       ← q r"\t:real^1. vec 1 - t",
       ← q r"interval[vec 0:real^1, vec 1]",
       ← q r"interval[vec 0:real^1, vec 1]"]
      ABSOLUTELY_CONTINUOUS_ON_COMPOSE) THEN
    REWRITE_TAC [o_DEF] THEN
    ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL, BOUNDED_INTERVAL] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_VEC, DROP_SUB] THEN
      REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    SUBGOAL_THEN
      (← q r"g:real^1->real^N has_bounded_variation_on interval[vec 0, vec 1]")
      ASSUME_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
      ASM_REWRITE_TAC [BOUNDED_INTERVAL], ALL_TAC] THEN
    MP_TAC (← ISPECL
      [← q r"\t:real^1. vec 1 - t",
       ← q r"g:real^1->real^N",
       ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
      HAS_BOUNDED_VARIATION_COMPOSE_DECREASING) THEN
    REWRITE_TAC [o_DEF] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_SUB] THEN REAL_ARITH_TAC,
        REWRITE_TAC [VECTOR_SUB_RZERO, VECTOR_SUB_REFL] THEN
        ASM_REWRITE_TAC []],
      SIMP_TAC []])

  let ABSOLUTELY_CONTINUOUS_JOINPATHS ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g1 = pathstart g2 /\
        g1 absolutely_continuous_on interval[vec 0,vec 1] /\
        g2 absolutely_continuous_on interval[vec 0,vec 1]
        ==> (g1 ++ g2) absolutely_continuous_on interval[vec 0,vec 1]"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
      [← q r"(g1 ++ g2):real^1->real^N",
       ← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"lift(&1 / &2)"]
      ABSOLUTELY_CONTINUOUS_ON_COMBINE) THEN
    REWRITE_TAC [DROP_VEC, LIFT_DROP] THEN
    ANTS_TAC THENL [REAL_ARITH_TAC, DISCH_THEN SUBST1_TAC] THEN
    CONJ_TAC THENL
     [/- First half: (g1 ++ g2) AC on [0, 1/2] -/
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_EQ THEN
      EXISTS_TAC (← q r"\x:real^1. (g1:real^1->real^N)(&2 % x)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP, joinpaths] THEN
        REPEAT STRIP_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\x:real^1. (g1:real^1->real^N)(&2 % x)) =
         g1 o (\x:real^1. &2 % x)")
        SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\x:real^1. &2 % x)
         absolutely_continuous_on interval[vec 0, lift(&1 / &2)]")
        ASSUME_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_CMUL THEN
        REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_ID],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
        [← q r"g1:real^1->real^N",
         ← q r"\x:real^1. &2 % x",
         ← q r"interval[vec 0:real^1, lift(&1 / &2)]",
         ← q r"interval[vec 0:real^1, vec 1]"]
        ABSOLUTELY_CONTINUOUS_ON_COMPOSE) THEN
      REWRITE_TAC [o_DEF] THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL, BOUNDED_INTERVAL] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1,
                     DROP_VEC, DROP_CMUL, LIFT_DROP] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN
      SUBGOAL_THEN
        (← q r"(g1:real^1->real^N) has_bounded_variation_on interval[vec 0, vec 1]")
        ASSUME_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
        ASM_REWRITE_TAC [BOUNDED_INTERVAL],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
        [← q r"\x:real^1. &2 % x",
         ← q r"g1:real^1->real^N",
         ← q r"vec 0:real^1", ← q r"lift(&1 / &2)"]
        HAS_BOUNDED_VARIATION_COMPOSE_INCREASING) THEN
      REWRITE_TAC [o_DEF] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, LIFT_DROP] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_LMUL THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [VECTOR_MUL_RZERO, ← GSYM LIFT_CMUL] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN
          REWRITE_TAC [LIFT_NUM] THEN ASM_REWRITE_TAC []],
        SIMP_TAC []],
      /- Second half: (g1 ++ g2) AC on [1/2, 1] -/
      MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_EQ THEN
      EXISTS_TAC (← q r"\x:real^1. (g2:real^1->real^N)(&2 % x - vec 1)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP, joinpaths] THEN
        REPEAT STRIP_TAC THEN
        COND_CASES_TAC THENL
         [SUBGOAL_THEN (← q r"&2 % x - vec 1 = vec 0:real^1") SUBST1_TAC THENL
           [REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            ALL_TAC] THEN
          SUBGOAL_THEN (← q r"&2 % x = vec 1:real^1") SUBST1_TAC THENL
           [REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            ALL_TAC] THEN
          UNDISCH_TAC (← q r"pathfinish g1 = pathstart (g2:real^1->real^N)") THEN
          REWRITE_TAC [pathfinish, pathstart] THEN MESON_TAC [],
          REFL_TAC],
        ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\x:real^1. (g2:real^1->real^N)(&2 % x - vec 1)) =
         g2 o (\x:real^1. &2 % x - vec 1)")
        SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\x:real^1. &2 % x - vec 1)
         absolutely_continuous_on interval[lift(&1 / &2), vec 1]")
        ASSUME_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUB THEN
        REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_CMUL THEN
        REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_ID],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
        [← q r"g2:real^1->real^N",
         ← q r"\x:real^1. &2 % x - vec 1",
         ← q r"interval[lift(&1 / &2):real^1, vec 1]",
         ← q r"interval[vec 0:real^1, vec 1]"]
        ABSOLUTELY_CONTINUOUS_ON_COMPOSE) THEN
      REWRITE_TAC [o_DEF] THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL, BOUNDED_INTERVAL] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1,
                     DROP_VEC, DROP_CMUL, DROP_SUB, LIFT_DROP] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN
      SUBGOAL_THEN
        (← q r"(g2:real^1->real^N) has_bounded_variation_on interval[vec 0, vec 1]")
        ASSUME_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
        ASM_REWRITE_TAC [BOUNDED_INTERVAL],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
        [← q r"\x:real^1. &2 % x - vec 1",
         ← q r"g2:real^1->real^N",
         ← q r"lift(&1 / &2)", ← q r"vec 1:real^1"]
        HAS_BOUNDED_VARIATION_COMPOSE_INCREASING) THEN
      REWRITE_TAC [o_DEF] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB, LIFT_DROP] THEN
          ASM_REAL_ARITH_TAC,
          SUBGOAL_THEN
            (← q r"&2 % lift(&1 / &2) - vec 1 = vec 0:real^1 /\
             &2 % vec 1 - vec 1 = vec 1:real^1")
            (fun th => REWRITE_TAC [th]) THENL
           [REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_SUB, DROP_VEC,
                         LIFT_DROP] THEN
            REAL_ARITH_TAC,
            ASM_REWRITE_TAC []]],
        SIMP_TAC []]])

  pure { ABSOLUTELY_CONTINUOUS_IMP_PATH, ABSOLUTELY_CONTINUOUS_IMP_RECTIFIABLE_PATH,
         ABSOLUTELY_INTEGRABLE_VECTOR_DERIVATIVE_ABSOLUTELY_CONTINUOUS,
         ABSOLUTELY_CONTINUOUS_REVERSEPATH, ABSOLUTELY_CONTINUOUS_JOINPATHS }
/- ------------------------------------------------------------------------- -/
/- Fubini-type results for measure.                                         -/
/- (measure.ml 27864-28334)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSDB where
  FUBINI_MEASURE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSDB [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) (BMSG : MSG) (BMSJ : MSJ) (BMSO : MSO) : ExceptT String IO MSDB := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_MEASURE, measurable, MEASURABLE_INTER,
        MEASURABLE_INTERVAL, MEASURABLE_UNION, MEASURE_INTERVAL, MEASURE_POS_LE,
        MEASURE_SUBSET, MEASURE_UNIQUE, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_EMPTY, MEASURABLE_UNIONS, MEASURE_DIFF_SUBSET,
        MEASURE_EMPTY, MEASURE_NEGLIGIBLE_UNIONS, MEASURE_NEGLIGIBLE_UNIONS_IMAGE,
        .. } := BMSB
  let { MEASURABLE_INNER_OUTER, .. } := BMSC
  let { HAS_MEASURE_NESTED_UNIONS, .. } := BMSF
  let { MEASURABLE_COMPACT, MEASURABLE_ELEMENTARY, .. } := BMSG
  let { MEASURABLE_BALL, NEGLIGIBLE_CONVEX_INTERIOR, .. } := BMSJ
  let { MEASURABLE_INNER_COMPACT, MEASURABLE_OUTER_OPEN, .. } := BMSO
  let { BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING_AE,
        BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING, CONTENT_PASTECART,
        .. } := D.qintegration1
  let { HAS_INTEGRAL_CONST, HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_NEGLIGIBLE_EQ,
        HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_SUB,
        HAS_INTEGRAL_VSUM, INTEGRABLE_SUB, .. } := D.qintegration2
  let { division_of, INTEGRAL_SUB, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND_NONEMPTY, MONOTONE_CONVERGENCE_DECREASING_AE, NEGLIGIBLE,
        NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_EMPTY, NEGLIGIBLE_STANDARD_HYPERPLANE,
        NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_UNIONS,
        OPEN_COUNTABLE_LIMIT_ELEMENTARY, .. } := D.qintegration3
  let { INTERIOR_PCROSS, LIM_COMPONENT_LBOUND, .. } := D.qtopology2
  let { COMPACT_UNION, CONVERGENT_IMP_BOUNDED, INTERIOR_INTERVAL, PCROSS_INTERVAL,
        .. } := D.ig.qtopology
  let { INTER_INTERVAL, NORM_LE_PASTECART, .. } := D.ig.qvec
  let { ALWAYS_EVENTUALLY, .. } := D.ig.dv.qmetric
  let { CONTINUOUS_PASTECART, .. } := D.ig.dv.qtopology1
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { DEPENDENT_CHOICE, INTER_PCROSS, TRANSITIVE_STEPWISE_LE, .. } := D.ig.dv.dg.qsession
  let { OPEN_DIFF, .. } := D.ig.dv.dg.qtopology2
  let { LIFT_SUM, .. } := D.ig.dv.dg.qvec
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_PRODUCT_DEPENDENT, .. } := D.ig.dv.dg.pt.qses
  let { CONVEX_INTER, .. } := D.ig.dv.dg.pt.qcvx2
  let { AND_FORALL_THM, COND_ID, COND_RAND, COND_RATOR, CONJ_ASSOC, CONJ_SYM,
        DE_MORGAN_THM, DIMINDEX_1, FINITE_IMAGE, FINITE_NUMSEG, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, IN_DIFF, INTER, INTER_EMPTY, INTER_SUBSET, INTER_UNIV,
        .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM,
        PASTECART_IN_PCROSS, PCROSS_EQ_EMPTY, REAL_ABS_SUB, REAL_ARCH_INV,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_SUB_LE, SIMPLE_IMAGE,
        SUBSET_INTER, SUBSET_UNION, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, UNION_SUBSET, UNIONS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { DIST_0, DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_EQ, DROP_SUB, FORALL_1, IN_INTERVAL, INTERVAL_NE_EMPTY, LIFT_CMUL, LIFT_DROP,
        LIFT_EQ, LIFT_NUM, LIFT_SUB, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, VEC_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
