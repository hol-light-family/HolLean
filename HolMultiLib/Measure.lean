  let MIDPOINT_CONVEX_IMP_CONVEX_OSTROWSKI ← prove
   r"!f:real^N->real s t B.
        convex s /\ open s /\
        t SUBSET s /\ lebesgue_measurable t /\ ~negligible t /\
