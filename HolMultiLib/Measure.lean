/- Nested Luzin; measurability of the Banach indicatrix.                    -/
/- (measure.ml 16164-16376)                                                 -/
/- ------------------------------------------------------------------------- -/

structure MSBN where
  LUZIN_SIGMA_NESTED : thm
  PRESERVES_LEBESGUE_MEASURABLE_IFF_PRESERVES_NEGLIGIBLE_GEN : thm
  LEBESGUE_MEASURABLE_PREIMAGE_CARD_LE : thm
  LEBESGUE_MEASURABLE_PREIMAGE_HAS_SIZE : thm
  LEBESGUE_MEASURABLE_PREIMAGE_FINITE : thm
  LEBESGUE_MEASURABLE_PREIMAGE_INFINITE : thm
  MEASURABLE_ON_BANACH_INDICATRIX : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSBN [HolBase] (D : MeasureDeps) (BMSAE : MSAE) (BMSAM : MSAM) (BMSAW : MSAW) (BMSBB : MSBB) (BMSBM : MSBM) : ExceptT String IO MSBN := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_SUBSET, .. } := BMSAE
  let { GDELTA_IMP_LEBESGUE_MEASURABLE, LEBESGUE_MEASURABLE_COMPACT,
        LEBESGUE_MEASURABLE_COMPL, LEBESGUE_MEASURABLE_COUNTABLE_INTERS_EXPLICIT,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS,
        LEBESGUE_MEASURABLE_COUNTABLE_UNIONS_EXPLICIT, LEBESGUE_MEASURABLE_DIFF,
        LEBESGUE_MEASURABLE_EMPTY, LEBESGUE_MEASURABLE_NEGLIGIBLE_SYMDIFF,
        LEBESGUE_MEASURABLE_UNION, LEBESGUE_MEASURABLE_UNIV,
        NEGLIGIBLE_IMP_LEBESGUE_MEASURABLE, .. } := BMSAM
  let { MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_HALFSPACE_COMPONENT_LE, .. } := BMSAW
  let { PRESERVES_LEBESGUE_MEASURABLE_IMP_PRESERVES_NEGLIGIBLE, .. } := BMSBB
  let { LUZIN_SIGMA, LUZIN_SIGMA_EXPLICIT, .. } := BMSBM
  let { NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { PASTING_LEMMA_LOCALLY_FINITE, .. } := D.qmetric
  let { CARD_LE_UNIONS_CHAIN, SUBSET_INTERS, .. } := D.qsession
  let { GDELTA_PREIMAGE_CARD_LE, .. } := D.qtopology2
  let { FLOOR_POS, INTEGER_CLOSED, REAL_LE_FLOOR, .. } := D.ig.qfloor
  let { FINITE_NUMSEG_LE, IMAGE_UNIONS, .. } := D.ig.qsession
  let { COMPACT_UNIONS, .. } := D.ig.qtopology
  let { INFINITE, .. } := D.ig.dv.qsession
  let { CLOSED_IN_IMP_SUBSET, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.ig.dv.dg.qmetric
  let { TRANSITIVE_STEPWISE_LE, .. } := D.ig.dv.dg.qsession
  let { CLOSED_IMP_FSIGMA, CLOSED_SUBSET_EQ, CONTINUOUS_MAP_EUCLIDEAN,
        .. } := D.ig.dv.dg.qtopology1
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { CARD_SUBSET, COND_RAND, COND_RATOR, DIMINDEX_1, EMPTY_GSPEC, EQ_IMP, EXTENSION,
        FINITE_IMAGE, FINITE_RESTRICT, FINITE_SUBSET, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, HAS_SIZE, IMP_CONJ, IMP_IMP, IN_DIFF,
        INTERS_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE, LE_REFL, LE_TRANS, LEFT_IMP_EXISTS_THM, NOT_IMP,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_NOT_LT, REAL_OF_NUM_LE, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_DIFF, .. } := D.ig.dv.dg.pt.cvx.core5
  let { UNIONS_GSPEC, UNIONS_SUBSET, WLOG_LE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { FORALL_1, LIFT_DROP, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED, .. } := D.ig.dv.dg.pt.cvx.top2
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.ig.dv.dg.pt.cvx.top5
  -- @@SCOPE END

  let LUZIN_SIGMA_NESTED ← prove
   r"!f:real^M->real^N s.
        lebesgue_measurable s /\ f measurable_on s
        ==> ?k. (!n. compact(k n)) /\
                (!n. k n SUBSET s) /\
                (!n. f continuous_on k n) /\
                (!n. k n SUBSET k(SUC n)) /\
                negligible(s DIFF UNIONS {k n | n IN (:num)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool"]
          LUZIN_SIGMA_EXPLICIT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n. UNIONS {(c:num->real^M->bool) m | m <= n}") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC COMPACT_UNIONS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_NUMSEG_LE, FINITE_IMAGE],
      ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC],
      X_GEN_TAC (← q r"k:num") THEN MP_TAC (← ISPECL
       [← q r"subtopology euclidean (UNIONS {c m | m:num <= k}:real^M->bool)",
