        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:real^1") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"t:real^1") THEN
        REWRITE_TAC [← GSYM DIST_NZ] THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(a:real^M - a') <= e / &4 /\ norm(b - b') <= e / &4
