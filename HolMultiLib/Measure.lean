        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"s:real^N->bool = UNIONS {t n | n IN (:num)}")
       (fun th => GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [th] THEN
                  GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o ONCE_DEPTH_CONV) [th])
      THENL
       [EXPAND_TAC "t" THEN REWRITE_TAC [UNIONS_GSPEC, IN_UNIV, IN_ELIM_THM] THEN
        GEN_REWRITE_TAC I [EXTENSION] THEN X_GEN_TAC (← q r"x:real^N") THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← GSYM REAL_LT_LDIV_EQ] THEN
        MP_TAC (← ISPEC
         (← q r"abs(det(matrix(f'(x:real^N)):real^N^N)) / e") FLOOR_POS) THEN
        ASM_SIMP_TAC [REAL_LE_DIV, REAL_LT_IMP_LE, REAL_ABS_POS] THEN
        MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [FLOOR],
        ALL_TAC] THEN
      REWRITE_TAC [IMAGE_UNIONS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o] THEN
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE THEN
      REWRITE_TAC [o_THM] THEN CONJ_TAC THEN X_GEN_TAC (← q r"n:num") THENL
       [MATCH_MP_TAC MEASURABLE_BOUNDED_DIFFERENTIABLE_IMAGE THEN
        MAP_EVERY EXISTS_TAC [← q r"f':real^N->real^N->real^N", ← q r"(&n + &1) * e"] THEN
        ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "t" THEN SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
          HAS_DERIVATIVE_WITHIN_SUBSET) THEN
        SET_TAC [],
        ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum(0..n) (\k. ((&k + &1) * e) * measure(t k:real^N->bool))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC MEASURE_BOUNDED_DIFFERENTIABLE_IMAGE THEN
        EXISTS_TAC (← q r"f':real^N->real^N->real^N") THEN
        ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "t" THEN SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE] THEN
