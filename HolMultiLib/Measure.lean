  -- @@SCOPE END

  let [MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED,
       MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_CLOSED_INTERVAL,
       MEASURABLE_ON_LEBESGUE_MEASURABLE_PREIMAGE_OPEN,
