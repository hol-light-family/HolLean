  qintegration3 : QIntegrationThms3
  qcard : QCardThms
  qfloor : QFloorThms
  qproducts : QProductsThms
  qwo : QWoThms
  qmetric : QMetricThms
  qmisc : QMiscThms
  qpaths : QPathsThms
  qpermutations : QPermutationsThms
  qpolytope : QPolytopeThms
  qsession : QSessionThms
  qtopology1 : QTopologyThms1
  qtopology2 : QTopologyThms2
  qvec : QVecThms
  qlists : QListsThms

/- ------------------------------------------------------------------------- -/
/- Lebesgue measure in the case where the measure is finite: definitions,  -/
/- intervals, intersections, unions, monotonicity.  (measure.ml 1-336)     -/
/- ------------------------------------------------------------------------- -/

structure MSA where
  has_measure : thm
  measurable : thm
  measure : thm
  HAS_MEASURE_MEASURE : thm
  HAS_MEASURE_UNIQUE : thm
  MEASURE_UNIQUE : thm
  HAS_MEASURE_MEASURABLE_MEASURE : thm
  HAS_MEASURE_IMP_MEASURABLE : thm
  HAS_MEASURE : thm
  MEASURABLE : thm
  MEASURABLE_INTEGRABLE : thm
  MEASURE_INTEGRAL : thm
  MEASURE_INTEGRAL_UNIV : thm
  INTEGRAL_MEASURE : thm
  INTEGRAL_MEASURE_UNIV : thm
  INTEGRABLE_ON_INDICATOR : thm
  ABSOLUTELY_INTEGRABLE_ON_INDICATOR : thm
  INTEGRAL_INDICATOR : thm
  HAS_MEASURE_INTERVAL : thm
  MEASURABLE_INTERVAL : thm
  MEASURE_INTERVAL : thm
  MEASURE_INTERVAL_1 : thm
  MEASURE_INTERVAL_1_ALT : thm
  MEASURE_INTERVAL_2 : thm
  MEASURE_INTERVAL_2_ALT : thm
  MEASURE_INTERVAL_3 : thm
  MEASURE_INTERVAL_3_ALT : thm
  MEASURE_INTERVAL_4 : thm
  MEASURE_INTERVAL_4_ALT : thm
  MEASURABLE_INTER : thm
  MEASURABLE_UNION : thm
  HAS_MEASURE_DISJOINT_UNION : thm
  MEASURE_DISJOINT_UNION : thm
  MEASURE_DISJOINT_UNION_EQ : thm
  HAS_MEASURE_POS_LE : thm
  MEASURE_POS_LE : thm
  HAS_MEASURE_SUBSET : thm
  MEASURE_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSA [HolBase] (D : MeasureDeps) : ExceptT String IO MSA := do
  -- @@SCOPE BEGIN
  let { ARITH, ARITH_EQ, CART_EQ, COND_ID, COND_RAND, CONJ_ASSOC, DIMINDEX_1, DIMINDEX_2,
        DIMINDEX_3, EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_INTER, IN_UNION, IN_UNIV, LAMBDA_BETA, MONO_FORALL, REAL_ABS_NUM, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LT_LE, REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_POS, REAL_SUB_REFL, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { DROP_EQ, DROP_VEC, EXISTS_DROP, FORALL_1, FORALL_3, INTERVAL_OPEN_SUBSET_CLOSED,
        LIFT_ADD, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_1, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VEC_COMPONENT, VECTOR_ADD_LID, VECTOR_ADD_RID, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { MESON_TAC, new_definition, parse_as_infix, REAL_ARITH_TAC, SET_TAC, .. } :=
        D.ig.dv.dg.pt.cvx
  let { VEC_EQ, .. } := D.ig.dv.dg.pt.qvec
  let { FORALL_2, .. } := D.ig.dv.dg.qvec
  let { indicator, LIFT_EQ_CMUL, .. } := D.ig.qvec
  let { prioritize_real, .. } := D.ig
  let { PRODUCT_1, PRODUCT_2, PRODUCT_3, PRODUCT_4, .. } := D.qdet
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_MAX,
        ABSOLUTELY_INTEGRABLE_MIN, CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { HAS_INTEGRAL_ADD, HAS_INTEGRAL_COMPONENT_POS, HAS_INTEGRAL_CONST,
        HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_SUBSET_DROP_LE,
        HAS_INTEGRAL_UNIQUE, INTEGRABLE_RESTRICT_UNIV, .. } := D.qintegration2
  let { absolutely_integrable_on, integrable_on, INTEGRAL_RESTRICT_INTER, INTEGRAL_UNIQUE,
        NEGLIGIBLE_FRONTIER_INTERVAL, NONNEGATIVE_ABSOLUTELY_INTEGRABLE, .. } :=
        D.qintegration3
  let { DIMINDEX_4, .. } := D.qsession
  let { FORALL_4, .. } := D.qvec
  -- @@SCOPE END

  prioritize_real

  parse_as_infix ("has_measure", (12, "right"))

  let has_measure ← new_definition
   r"s has_measure m <=> ((\x. vec 1) has_integral (lift m)) s"

  let measurable ← new_definition
   r"measurable s <=> ?m. s has_measure m"

  let measure ← new_definition
   r"measure s = @m. s has_measure m"

  let HAS_MEASURE_MEASURE ← prove
   r"!s. measurable s <=> s has_measure (measure s)"
   (REWRITE_TAC [measure, measurable] THEN MESON_TAC [])

  let HAS_MEASURE_UNIQUE ← prove
   r"!s m1 m2. s has_measure m1 /\ s has_measure m2 ==> m1 = m2"
   (REWRITE_TAC [has_measure, ← GSYM LIFT_EQ] THEN MESON_TAC [HAS_INTEGRAL_UNIQUE])

  let MEASURE_UNIQUE ← prove
   r"!s m. s has_measure m ==> measure s = m"
   (MESON_TAC [HAS_MEASURE_UNIQUE, HAS_MEASURE_MEASURE, measurable])

  let HAS_MEASURE_MEASURABLE_MEASURE ← prove
   r"!s m. s has_measure m <=> measurable s /\ measure s = m"
   (REWRITE_TAC [HAS_MEASURE_MEASURE] THEN MESON_TAC [MEASURE_UNIQUE])

  let HAS_MEASURE_IMP_MEASURABLE ← prove
   r"!s m. s has_measure m ==> measurable s"
   (REWRITE_TAC [measurable] THEN MESON_TAC [])

  let HAS_MEASURE ← prove
   r"!s m. s has_measure m <=>
              ((\x. if x IN s then vec 1 else vec 0) has_integral (lift m))
              (:real^N)"
   (SIMP_TAC [HAS_INTEGRAL_RESTRICT_UNIV, has_measure])

  let MEASURABLE ← prove
   r"!s. measurable s <=> (\x. vec 1:real^1) integrable_on s"
   (REWRITE_TAC [measurable, integrable_on,
                 has_measure, EXISTS_DROP, LIFT_DROP])

  let MEASURABLE_INTEGRABLE ← prove
   r"measurable s <=>
     (\x. if x IN s then vec 1 else vec 0:real^1) integrable_on UNIV"
   (REWRITE_TAC [measurable, integrable_on,
                 HAS_MEASURE, EXISTS_DROP, LIFT_DROP])

  let MEASURE_INTEGRAL ← prove
   r"!s. measurable s ==> measure s = drop (integral s (\x. vec 1))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP] THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    ASM_REWRITE_TAC [← GSYM has_measure, ← GSYM HAS_MEASURE_MEASURE])

  let MEASURE_INTEGRAL_UNIV ← prove
   r"!s. measurable s
       ==> measure s =
           drop(integral UNIV (\x. if x IN s then vec 1 else vec 0))"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP] THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    ASM_REWRITE_TAC [← GSYM HAS_MEASURE, ← GSYM HAS_MEASURE_MEASURE])

  let INTEGRAL_MEASURE ← prove
   r"!s. measurable s ==> integral s (\x. vec 1) = lift(measure s)"
   (SIMP_TAC [← GSYM DROP_EQ, LIFT_DROP, MEASURE_INTEGRAL])

  let INTEGRAL_MEASURE_UNIV ← prove
   r"!s. measurable s
       ==> integral UNIV (\x. if x IN s then vec 1 else vec 0) =
           lift(measure s)"
   (SIMP_TAC [← GSYM DROP_EQ, LIFT_DROP, MEASURE_INTEGRAL_UNIV])

  let INTEGRABLE_ON_INDICATOR ← prove
   r"!s t:real^N->bool. indicator s integrable_on t <=> measurable(s INTER t)"
   (ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    REWRITE_TAC [MEASURABLE_INTEGRABLE, ← GSYM indicator] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [indicator, IN_INTER] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [VEC_EQ, ARITH_EQ]))

  let ABSOLUTELY_INTEGRABLE_ON_INDICATOR ← prove
   r"!s t:real^N->bool.
    indicator s absolutely_integrable_on t <=> measurable(s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM INTEGRABLE_ON_INDICATOR] THEN
    REWRITE_TAC [absolutely_integrable_on, indicator, COND_RAND] THEN
    REWRITE_TAC [NORM_1, DROP_VEC, REAL_ABS_NUM, LIFT_NUM])

  let INTEGRAL_INDICATOR ← prove
   r"!s t:real^M->bool.
      measurable(s INTER t)
      ==> integral t (indicator s) = lift(measure(s INTER t))"
   (SIMP_TAC [MEASURE_INTEGRAL, LIFT_DROP, indicator, INTEGRAL_RESTRICT_INTER])

  let HAS_MEASURE_INTERVAL ← prove
   r"(!a b:real^N. interval[a,b] has_measure content(interval[a,b])) /\
   (!a b:real^N. interval(a,b) has_measure content(interval[a,b]))"
   (MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [REWRITE_TAC [has_measure] THEN
      ONCE_REWRITE_TAC [LIFT_EQ_CMUL] THEN REWRITE_TAC [HAS_INTEGRAL_CONST],
      ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN SIMP_TAC [HAS_MEASURE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                             HAS_INTEGRAL_SPIKE) THEN
    EXISTS_TAC (← q r"interval[a:real^N,b] DIFF interval(a,b)") THEN
    REWRITE_TAC [NEGLIGIBLE_FRONTIER_INTERVAL] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] INTERVAL_OPEN_SUBSET_CLOSED) THEN
    SET_TAC [])

  let MEASURABLE_INTERVAL ← prove
   r"(!a b:real^N. measurable (interval[a,b])) /\
   (!a b:real^N. measurable (interval(a,b)))"
   (REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_INTERVAL])

  let MEASURE_INTERVAL ← prove
   r"(!a b:real^N. measure(interval[a,b]) = content(interval[a,b])) /\
   (!a b:real^N. measure(interval(a,b)) = content(interval[a,b]))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    REWRITE_TAC [HAS_MEASURE_INTERVAL])

  let MEASURE_INTERVAL_1 ← prove
   r"(!a b:real^1. measure(interval[a,b]) =
                    if drop a <= drop b then drop b - drop a else &0) /\
   (!a b:real^1. measure(interval(a,b)) =
                    if drop a <= drop b then drop b - drop a else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, PRODUCT_1, drop])

  let MEASURE_INTERVAL_1_ALT ← prove
   r"(!a b:real^1. measure(interval[a,b]) =
                    if drop a < drop b then drop b - drop a else &0) /\
   (!a b:real^1. measure(interval(a,b)) =
                    if drop a < drop b then drop b - drop a else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL_1] THEN REAL_ARITH_TAC)

  let MEASURE_INTERVAL_2 ← prove
   r"(!a b:real^2. measure(interval[a,b]) =
                 if a$1 <= b$1 /\ a$2 <= b$2
                 then (b$1 - a$1) * (b$2 - a$2)
                 else &0) /\
   (!a b:real^2. measure(interval(a,b)) =
                 if a$1 <= b$1 /\ a$2 <= b$2
                 then (b$1 - a$1) * (b$2 - a$2)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
    REWRITE_TAC [DIMINDEX_2, FORALL_2, PRODUCT_2])

  let MEASURE_INTERVAL_2_ALT ← prove
   r"(!a b:real^2. measure(interval[a,b]) =
                 if a$1 < b$1 /\ a$2 < b$2
                 then (b$1 - a$1) * (b$2 - a$2)
                 else &0) /\
   (!a b:real^2. measure(interval(a,b)) =
                 if a$1 < b$1 /\ a$2 < b$2
                 then (b$1 - a$1) * (b$2 - a$2)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL_2] THEN REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(a:real^2)$1 = (b:real^2)$1", ← q r"(a:real^2)$2 = (b:real^2)$2"] THEN
    ASM_REWRITE_TAC [REAL_LT_REFL, REAL_MUL_LZERO, REAL_MUL_RZERO,
                     REAL_SUB_REFL, REAL_LE_REFL, REAL_ABS_NUM, COND_ID] THEN
    ASM_REWRITE_TAC [REAL_LT_LE])

  let MEASURE_INTERVAL_3 ← prove
   r"(!a b:real^3. measure(interval[a,b]) =
                 if a$1 <= b$1 /\ a$2 <= b$2 /\ a$3 <= b$3
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3)
                 else &0) /\
   (!a b:real^3. measure(interval(a,b)) =
                 if a$1 <= b$1 /\ a$2 <= b$2 /\ a$3 <= b$3
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
    REWRITE_TAC [DIMINDEX_3, FORALL_3, PRODUCT_3])

  let MEASURE_INTERVAL_3_ALT ← prove
   r"(!a b:real^3. measure(interval[a,b]) =
                 if a$1 < b$1 /\ a$2 < b$2 /\ a$3 < b$3
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3)
                 else &0) /\
   (!a b:real^3. measure(interval(a,b)) =
                 if a$1 < b$1 /\ a$2 < b$2 /\ a$3 < b$3
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL_3] THEN REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(a:real^3)$1 = (b:real^3)$1",
      ← q r"(a:real^3)$2 = (b:real^3)$2",
      ← q r"(a:real^3)$3 = (b:real^3)$3"] THEN
    ASM_REWRITE_TAC [REAL_LT_REFL, REAL_MUL_LZERO, REAL_MUL_RZERO,
                     REAL_SUB_REFL, REAL_LE_REFL, REAL_ABS_NUM, COND_ID] THEN
    ASM_REWRITE_TAC [REAL_LT_LE])

  let MEASURE_INTERVAL_4 ← prove
   r"(!a b:real^4. measure(interval[a,b]) =
                 if a$1 <= b$1 /\ a$2 <= b$2 /\ a$3 <= b$3 /\ a$4 <= b$4
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3) * (b$4 - a$4)
                 else &0) /\
   (!a b:real^4. measure(interval(a,b)) =
                 if a$1 <= b$1 /\ a$2 <= b$2 /\ a$3 <= b$3 /\ a$4 <= b$4
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3) * (b$4 - a$4)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
    REWRITE_TAC [DIMINDEX_4, FORALL_4, PRODUCT_4])

  let MEASURE_INTERVAL_4_ALT ← prove
   r"(!a b:real^4. measure(interval[a,b]) =
                 if a$1 < b$1 /\ a$2 < b$2 /\ a$3 < b$3 /\ a$4 < b$4
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3) * (b$4 - a$4)
                 else &0) /\
   (!a b:real^4. measure(interval(a,b)) =
                 if a$1 < b$1 /\ a$2 < b$2 /\ a$3 < b$3 /\ a$4 < b$4
                 then (b$1 - a$1) * (b$2 - a$2) * (b$3 - a$3) * (b$4 - a$4)
                 else &0)"
   (REWRITE_TAC [MEASURE_INTERVAL_4] THEN REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(a:real^4)$1 = (b:real^4)$1",
      ← q r"(a:real^4)$2 = (b:real^4)$2",
      ← q r"(a:real^4)$3 = (b:real^4)$3",
      ← q r"(a:real^4)$4 = (b:real^4)$4"] THEN
    ASM_REWRITE_TAC [REAL_LT_REFL, REAL_MUL_LZERO, REAL_MUL_RZERO,
                     REAL_SUB_REFL, REAL_LE_REFL, REAL_ABS_NUM, COND_ID] THEN
    ASM_REWRITE_TAC [REAL_LT_LE])

  let MEASURABLE_INTER ← prove
   r"!s t:real^N->bool. measurable s /\ measurable t ==> measurable (s INTER t)"
   (REWRITE_TAC [MEASURABLE_INTEGRABLE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
    SUBGOAL_THEN
     (← q r"(\x. if x IN s INTER t then vec 1 else vec 0):real^N->real^1 =
    (\x. lambda i. min (((if x IN s then vec 1 else vec 0):real^1)$i)
                       (((if x IN t then vec 1 else vec 0):real^1)$i))")
    SUBST1_TAC THENL
     [SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REPEAT STRIP_TAC THEN
      MAP_EVERY ASM_CASES_TAC [← q r"(x:real^N) IN s", ← q r"(x:real^N) IN t"] THEN
      ASM_SIMP_TAC [IN_INTER, VEC_COMPONENT] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MIN THEN
    CONJ_TAC THEN MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
    ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [VEC_COMPONENT, REAL_POS])

  let MEASURABLE_UNION ← prove
   r"!s t:real^N->bool. measurable s /\ measurable t ==> measurable (s UNION t)"
   (REWRITE_TAC [MEASURABLE_INTEGRABLE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
    SUBGOAL_THEN
     (← q r"(\x. if x IN s UNION t then vec 1 else vec 0):real^N->real^1 =
    (\x. lambda i. max (((if x IN s then vec 1 else vec 0):real^1)$i)
                       (((if x IN t then vec 1 else vec 0):real^1)$i))")
    SUBST1_TAC THENL
     [SIMP_TAC [FUN_EQ_THM, CART_EQ, LAMBDA_BETA] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REPEAT STRIP_TAC THEN
      MAP_EVERY ASM_CASES_TAC [← q r"(x:real^N) IN s", ← q r"(x:real^N) IN t"] THEN
      ASM_SIMP_TAC [IN_UNION, VEC_COMPONENT] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MAX THEN
    CONJ_TAC THEN MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
    ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [VEC_COMPONENT, REAL_POS])

  let HAS_MEASURE_DISJOINT_UNION ← prove
   r"!s1 s2 m1 m2. s1 has_measure m1 /\ s2 has_measure m2 /\ DISJOINT s1 s2
                 ==> (s1 UNION s2) has_measure (m1 + m2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_MEASURE, CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_ADD) THEN
    REWRITE_TAC [LIFT_ADD] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID]) THEN
    ASM SET_TAC [])

  let MEASURE_DISJOINT_UNION ← prove
   r"!s t. measurable s /\ measurable t /\ DISJOINT s t
         ==> measure(s UNION t) = measure s + measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_DISJOINT_UNION, ← GSYM HAS_MEASURE_MEASURE])

  let MEASURE_DISJOINT_UNION_EQ ← prove
   r"!s t u.
        measurable s /\ measurable t /\ s UNION t = u /\ DISJOINT s t
        ==> measure s + measure t = measure u"
   (MESON_TAC [MEASURE_DISJOINT_UNION])

  let HAS_MEASURE_POS_LE ← prove
   r"!m s:real^N->bool. s has_measure m ==> &0 <= m"
   (REWRITE_TAC [HAS_MEASURE] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT2 LIFT_DROP)] THEN
    REWRITE_TAC [drop] THEN MATCH_MP_TAC (← ISPEC
     (← q r"(\x. if x IN s then vec 1 else vec 0):real^N->real^1")
     HAS_INTEGRAL_COMPONENT_POS) THEN
    EXISTS_TAC (← q r"(:real^N)") THEN ASM_REWRITE_TAC [DIMINDEX_1, ARITH, IN_UNIV] THEN
    GEN_TAC THEN COND_CASES_TAC THEN
    REWRITE_TAC [← GSYM drop, DROP_VEC, REAL_POS])

  let MEASURE_POS_LE ← prove
   r"!s. measurable s ==> &0 <= measure s"
   (REWRITE_TAC [HAS_MEASURE_MEASURE, HAS_MEASURE_POS_LE])

  let HAS_MEASURE_SUBSET ← prove
   r"!s1 s2:real^N->bool m1 m2.
        s1 has_measure m1 /\ s2 has_measure m2 /\ s1 SUBSET s2
        ==> m1 <= m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_measure] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM (← CONJUNCT2 LIFT_DROP)] THEN
    MATCH_MP_TAC (← ISPEC (← q r"(\x. vec 1):real^N->real^1")
      HAS_INTEGRAL_SUBSET_DROP_LE) THEN
    MAP_EVERY EXISTS_TAC [← q r"s1:real^N->bool", ← q r"s2:real^N->bool"] THEN
    ASM_REWRITE_TAC [DROP_VEC, REAL_POS])

  let MEASURE_SUBSET ← prove
   r"!s t. measurable s /\ measurable t /\ s SUBSET t
         ==> measure s <= measure t"
   (REWRITE_TAC [HAS_MEASURE_MEASURE] THEN MESON_TAC [HAS_MEASURE_SUBSET])

  pure { has_measure, measurable, measure, HAS_MEASURE_MEASURE, HAS_MEASURE_UNIQUE,
         MEASURE_UNIQUE, HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_IMP_MEASURABLE,
         HAS_MEASURE, MEASURABLE, MEASURABLE_INTEGRABLE, MEASURE_INTEGRAL,
         MEASURE_INTEGRAL_UNIV, INTEGRAL_MEASURE, INTEGRAL_MEASURE_UNIV,
         INTEGRABLE_ON_INDICATOR, ABSOLUTELY_INTEGRABLE_ON_INDICATOR, INTEGRAL_INDICATOR,
         HAS_MEASURE_INTERVAL, MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_INTERVAL_1,
         MEASURE_INTERVAL_1_ALT, MEASURE_INTERVAL_2, MEASURE_INTERVAL_2_ALT,
         MEASURE_INTERVAL_3, MEASURE_INTERVAL_3_ALT, MEASURE_INTERVAL_4,
         MEASURE_INTERVAL_4_ALT, MEASURABLE_INTER, MEASURABLE_UNION,
         HAS_MEASURE_DISJOINT_UNION, MEASURE_DISJOINT_UNION, MEASURE_DISJOINT_UNION_EQ,
         HAS_MEASURE_POS_LE, MEASURE_POS_LE, HAS_MEASURE_SUBSET, MEASURE_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Measure zero, differences, negligible perturbations, finite unions.     -/
/- (measure.ml 337-735)                                                     -/
/- ------------------------------------------------------------------------- -/

structure MSB where
  HAS_MEASURE_0 : thm
  MEASURE_EQ_0 : thm
  NEGLIGIBLE_IMP_MEASURABLE : thm
  HAS_MEASURE_EMPTY : thm
  MEASURE_EMPTY : thm
  MEASURABLE_EMPTY : thm
  MEASURABLE_SING : thm
  MEASURABLE_MEASURE_EQ_0 : thm
  NEGLIGIBLE_EQ_MEASURE_0 : thm
  MEASURE_SING : thm
  MEASURABLE_MEASURE_POS_LT : thm
  NEGLIGIBLE_INTERVAL : thm
  MEASURABLE_UNIONS : thm
  HAS_MEASURE_DIFF_SUBSET : thm
  MEASURABLE_DIFF : thm
  MEASURE_DIFF_SUBSET : thm
  HAS_MEASURE_UNION_NEGLIGIBLE : thm
  HAS_MEASURE_DIFF_NEGLIGIBLE : thm
  HAS_MEASURE_UNION_NEGLIGIBLE_EQ : thm
  HAS_MEASURE_DIFF_NEGLIGIBLE_EQ : thm
  HAS_MEASURE_ALMOST : thm
  HAS_MEASURE_ALMOST_EQ : thm
  MEASURABLE_ALMOST : thm
  HAS_MEASURE_NEGLIGIBLE_UNION : thm
  MEASURE_NEGLIGIBLE_UNION : thm
  MEASURE_NEGLIGIBLE_UNION_EQ : thm
  HAS_MEASURE_NEGLIGIBLE_SYMDIFF : thm
  MEASURABLE_NEGLIGIBLE_SYMDIFF : thm
  MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ : thm
  MEASURE_NEGLIGIBLE_SYMDIFF : thm
  NEGLIGIBLE_SYMDIFF_EQ : thm
  NEGLIGIBLE_DELETE : thm
  HAS_MEASURE_NEGLIGIBLE_UNIONS : thm
  MEASURE_NEGLIGIBLE_UNIONS : thm
  HAS_MEASURE_DISJOINT_UNIONS : thm
  MEASURE_DISJOINT_UNIONS : thm
  HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE : thm
  MEASURE_NEGLIGIBLE_UNIONS_IMAGE : thm
  HAS_MEASURE_DISJOINT_UNIONS_IMAGE : thm
  MEASURE_DISJOINT_UNIONS_IMAGE : thm
  HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG : thm
  MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG : thm
  HAS_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG : thm
  MEASURE_DISJOINT_UNIONS_IMAGE_STRONG : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSB [HolBase] (D : MeasureDeps) (BMSA : MSA) : ExceptT String IO MSB := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE, has_measure, HAS_MEASURE_DISJOINT_UNION, HAS_MEASURE_INTERVAL,
        HAS_MEASURE_MEASURE, HAS_MEASURE_UNIQUE, measurable, MEASURABLE_INTER,
        MEASURABLE_UNION, measure, MEASURE_POS_LE, MEASURE_UNIQUE, .. } := BMSA
  let { CONJ_ASSOC, DISJOINT, EQ_IMP, EQ_SYM_EQ, EXTENSION, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_RESTRICT, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, INTER_ACI,
        INTER_UNIONS, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNION, IN_UNIONS, IN_UNIV, MONO_FORALL,
        NOT_IN_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LT_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_POS, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SUM_CLAUSES, SUM_SUPERSET, UNION_COMM, UNIONS_0, UNIONS_INSERT, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, LIFT_NUM, LIFT_SUB, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { INTERIOR_CLOSED_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { SUM_IMAGE_NONZERO, .. } := D.ig.qsession
  let { indicator, .. } := D.ig.qvec
  let { CONTENT_EQ_0_INTERIOR, .. } := D.qintegration1
  let { HAS_INTEGRAL_ALT, HAS_INTEGRAL_DROP_LE, HAS_INTEGRAL_DROP_POS,
        HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_SUB, .. } :=
        D.qintegration2
  let { integrable_on, NEGLIGIBLE, negligible, NEGLIGIBLE_DIFF, NEGLIGIBLE_EMPTY,
        NEGLIGIBLE_INTER, NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ,
        NEGLIGIBLE_UNIONS, .. } := D.qintegration3
  -- @@SCOPE END

  let HAS_MEASURE_0 ← prove
   r"!s:real^N->bool. s has_measure &0 <=> negligible s"
   (GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [NEGLIGIBLE, has_measure] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(:real^N)")) THEN
      ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
      REWRITE_TAC [IN_UNIV, indicator, LIFT_NUM]] THEN
    REWRITE_TAC [negligible] THEN REWRITE_TAC [has_measure] THEN
    ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [LIFT_NUM] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [HAS_INTEGRAL_ALT]) THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REWRITE_TAC [integrable_on, IN_UNIV] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV)
     [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [indicator] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^1")) THEN
    SUBGOAL_THEN (← q r"y:real^1 = vec 0") (fun th => ASM_MESON_TAC [th]) THEN
    REWRITE_TAC [← GSYM DROP_EQ, ← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← ISPEC
       (← q r"(\x. if x IN interval [a,b]
           then if x IN s then vec 1 else vec 0 else vec 0):real^N->real^1")
       HAS_INTEGRAL_DROP_LE) THEN
      EXISTS_TAC (← q r"(\x. if x IN s then vec 1 else vec 0):real^N->real^1"),
      REWRITE_TAC [DROP_VEC] THEN MATCH_MP_TAC (← ISPEC
       (← q r"(\x. if x IN interval [a,b]
           then if x IN s then vec 1 else vec 0 else vec 0):real^N->real^1")
       HAS_INTEGRAL_DROP_POS)] THEN
    EXISTS_TAC (← q r"(:real^N)") THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    REWRITE_TAC [DROP_VEC, REAL_POS, REAL_LE_REFL])

  let MEASURE_EQ_0 ← prove
   r"!s. negligible s ==> measure s = &0"
   (MESON_TAC [MEASURE_UNIQUE, HAS_MEASURE_0])

  let NEGLIGIBLE_IMP_MEASURABLE ← prove
   r"!s:real^N->bool. negligible s ==> measurable s"
   (MESON_TAC [HAS_MEASURE_0, measurable])

  let HAS_MEASURE_EMPTY ← prove
   r"{} has_measure &0"
   (REWRITE_TAC [HAS_MEASURE_0, NEGLIGIBLE_EMPTY])

  let MEASURE_EMPTY ← prove
   r"measure {} = &0"
   (SIMP_TAC [MEASURE_EQ_0, NEGLIGIBLE_EMPTY])

  let MEASURABLE_EMPTY ← prove
   r"measurable {}"
   (REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_EMPTY])

  let MEASURABLE_SING ← prove
   r"!a:real^N. measurable {a}"
   (MESON_TAC [NEGLIGIBLE_IMP_MEASURABLE, NEGLIGIBLE_SING])

  let MEASURABLE_MEASURE_EQ_0 ← prove
   r"!s. measurable s ==> (measure s = &0 <=> negligible s)"
   (REWRITE_TAC [HAS_MEASURE_MEASURE, ← GSYM HAS_MEASURE_0] THEN
    MESON_TAC [MEASURE_UNIQUE])

  let NEGLIGIBLE_EQ_MEASURE_0 ← prove
   r"!s:real^N->bool.
        negligible s <=> measurable s /\ measure s = &0"
   (MESON_TAC [NEGLIGIBLE_IMP_MEASURABLE, MEASURABLE_MEASURE_EQ_0])

  let MEASURE_SING ← prove
   r"!a:real^N. measure {a} = &0"
   (MESON_TAC [NEGLIGIBLE_EQ_MEASURE_0, NEGLIGIBLE_SING])

  let MEASURABLE_MEASURE_POS_LT ← prove
   r"!s. measurable s ==> (&0 < measure s <=> ~negligible s)"
   (SIMP_TAC [REAL_LT_LE, MEASURE_POS_LE, ← GSYM MEASURABLE_MEASURE_EQ_0] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  let NEGLIGIBLE_INTERVAL ← prove
   r"(!a b. negligible(interval[a,b]) <=> interval(a,b) = {}) /\
   (!a b. negligible(interval(a,b)) <=> interval(a,b) = {})"
   (REWRITE_TAC [← GSYM HAS_MEASURE_0] THEN
    MESON_TAC [HAS_MEASURE_INTERVAL, CONTENT_EQ_0_INTERIOR,
               INTERIOR_CLOSED_INTERVAL, HAS_MEASURE_UNIQUE])

  let MEASURABLE_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!s. s IN f ==> measurable s)
        ==> measurable (UNIONS f)"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, UNIONS_INSERT, MEASURABLE_EMPTY] THEN
    REWRITE_TAC [IN_INSERT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURABLE_UNION THEN ASM_SIMP_TAC [])

  let HAS_MEASURE_DIFF_SUBSET ← prove
   r"!s1 s2 m1 m2. s1 has_measure m1 /\ s2 has_measure m2 /\ s2 SUBSET s1
                 ==> (s1 DIFF s2) has_measure (m1 - m2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_MEASURE, CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB) THEN
    REWRITE_TAC [LIFT_SUB] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_SUB_RZERO] THEN
    ASM SET_TAC [])

  let MEASURABLE_DIFF ← prove
   r"!s t:real^N->bool. measurable s /\ measurable t ==> measurable (s DIFF t)"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool. measurable s /\ measurable t /\ t SUBSET s
         ==> measurable (s DIFF t)")
    ASSUME_TAC THENL
     [REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_DIFF_SUBSET],
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF (s INTER t)")] THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [MEASURABLE_INTER] THEN
      SET_TAC []])

  let MEASURE_DIFF_SUBSET ← prove
   r"!s t. measurable s /\ measurable t /\ t SUBSET s
         ==> measure(s DIFF t) = measure s - measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_DIFF_SUBSET, ← GSYM HAS_MEASURE_MEASURE])

  let HAS_MEASURE_UNION_NEGLIGIBLE ← prove
   r"!s t:real^N->bool m.
        s has_measure m /\ negligible t ==> (s UNION t) has_measure m"
   (REWRITE_TAC [HAS_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\x. if x IN s then vec 1 else vec 0):real^N->real^1",
      ← q r"t:real^N->bool"] THEN
    ASM_SIMP_TAC [IN_DIFF, IN_UNIV, IN_UNION])

  let HAS_MEASURE_DIFF_NEGLIGIBLE ← prove
   r"!s t:real^N->bool m.
        s has_measure m /\ negligible t ==> (s DIFF t) has_measure m"
   (REWRITE_TAC [HAS_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\x. if x IN s then vec 1 else vec 0):real^N->real^1",
      ← q r"t:real^N->bool"] THEN
    ASM_SIMP_TAC [IN_DIFF, IN_UNIV, IN_UNION])

  let HAS_MEASURE_UNION_NEGLIGIBLE_EQ ← prove
   r"!s t:real^N->bool m.
     negligible t ==> ((s UNION t) has_measure m <=> s has_measure m)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HAS_MEASURE_UNION_NEGLIGIBLE] THEN
    SUBST1_TAC (← SET_RULE (← q r"s:real^N->bool = (s UNION t) DIFF (t DIFF s)")) THEN
    MATCH_MP_TAC HAS_MEASURE_DIFF_NEGLIGIBLE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NEGLIGIBLE_DIFF THEN ASM_REWRITE_TAC [])

  let HAS_MEASURE_DIFF_NEGLIGIBLE_EQ ← prove
   r"!s t:real^N->bool m.
     negligible t ==> ((s DIFF t) has_measure m <=> s has_measure m)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HAS_MEASURE_DIFF_NEGLIGIBLE] THEN
    SUBST1_TAC (← SET_RULE (← q r"s:real^N->bool = (s DIFF t) UNION (t INTER s)")) THEN
    MATCH_MP_TAC HAS_MEASURE_UNION_NEGLIGIBLE THEN
    ASM_SIMP_TAC [NEGLIGIBLE_INTER])

  let HAS_MEASURE_ALMOST ← prove
   r"!s s' t m. s has_measure m /\ negligible t /\ s UNION t = s' UNION t
              ==> s' has_measure m"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"s UNION t = s' UNION t ==> s' = (s UNION t) DIFF (t DIFF s')"))) THEN
    ASM_SIMP_TAC [HAS_MEASURE_DIFF_NEGLIGIBLE, HAS_MEASURE_UNION_NEGLIGIBLE,
                  NEGLIGIBLE_DIFF])

  let HAS_MEASURE_ALMOST_EQ ← prove
   r"!s s' t. negligible t /\ s UNION t = s' UNION t
            ==> (s has_measure m <=> s' has_measure m)"
   (MESON_TAC [HAS_MEASURE_ALMOST])

  let MEASURABLE_ALMOST ← prove
   r"!s s' t. measurable s /\ negligible t /\ s UNION t = s' UNION t
            ==> measurable s'"
   (REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_ALMOST])

  let HAS_MEASURE_NEGLIGIBLE_UNION ← prove
   r"!s1 s2:real^N->bool m1 m2.
        s1 has_measure m1 /\ s2 has_measure m2 /\ negligible(s1 INTER s2)
        ==> (s1 UNION s2) has_measure (m1 + m2)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_MEASURE_ALMOST THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(s1 DIFF (s1 INTER s2)) UNION (s2 DIFF (s1 INTER s2)):real^N->bool",
      ← q r"s1 INTER s2:real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC, SET_TAC []] THEN
    MATCH_MP_TAC HAS_MEASURE_DISJOINT_UNION THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC HAS_MEASURE_ALMOST THEN EXISTS_TAC (← q r"s1:real^N->bool"),
      MATCH_MP_TAC HAS_MEASURE_ALMOST THEN EXISTS_TAC (← q r"s2:real^N->bool"),
      SET_TAC []] THEN
    EXISTS_TAC (← q r"s1 INTER s2:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let MEASURE_NEGLIGIBLE_UNION ← prove
   r"!s t. measurable s /\ measurable t /\ negligible(s INTER t)
         ==> measure(s UNION t) = measure s + measure t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_NEGLIGIBLE_UNION, ← GSYM HAS_MEASURE_MEASURE])

  let MEASURE_NEGLIGIBLE_UNION_EQ ← prove
   r"!s t u.
        measurable s /\ measurable t /\ s UNION t = u /\ negligible(s INTER t)
        ==> measure s + measure t = measure u"
   (MESON_TAC [MEASURE_NEGLIGIBLE_UNION])

  let HAS_MEASURE_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t:real^N->bool m.
        s has_measure m /\
        negligible((s DIFF t) UNION (t DIFF s))
        ==> t has_measure m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_MEASURE_ALMOST THEN
    MAP_EVERY EXISTS_TAC
     [← q r"s:real^N->bool", ← q r"(s DIFF t) UNION (t DIFF s):real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let MEASURABLE_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t:real^N->bool.
        measurable s /\ negligible((s DIFF t) UNION (t DIFF s))
        ==> measurable t"
   (REWRITE_TAC [measurable] THEN
    MESON_TAC [HAS_MEASURE_NEGLIGIBLE_SYMDIFF])

  let MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ ← prove
   r"!s t:real^N->bool.
        negligible(s DIFF t UNION t DIFF s)
        ==> (measurable s <=> measurable t)"
   (MESON_TAC [MEASURABLE_NEGLIGIBLE_SYMDIFF, UNION_COMM])

  let MEASURE_NEGLIGIBLE_SYMDIFF ← prove
   r"!s t:real^N->bool.
        negligible(s DIFF t UNION t DIFF s) ==> measure s = measure t"
   (REPEAT STRIP_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"measurable(s:real^N->bool)", ← q r"measurable(t:real^N->bool)"]
    THENL
     [ASM_MESON_TAC [HAS_MEASURE_NEGLIGIBLE_SYMDIFF, MEASURE_UNIQUE,
                     HAS_MEASURE_MEASURE],
      ASM_MESON_TAC [MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ],
      ASM_MESON_TAC [MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ],
      REWRITE_TAC [measure] THEN AP_TERM_TAC THEN ABS_TAC THEN
      ASM_MESON_TAC [measurable]])

  let NEGLIGIBLE_SYMDIFF_EQ ← prove
   r"!s t:real^N->bool.
        negligible (s DIFF t UNION t DIFF s)
        ==> (negligible s <=> negligible t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [IMP_IMP, ← GSYM NEGLIGIBLE_UNION_EQ] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    SET_TAC [])

  let NEGLIGIBLE_DELETE ← prove
   r"!a:real^N. negligible(s DELETE a) <=> negligible s"
   (GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SYMDIFF_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{a:real^N}") THEN REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let HAS_MEASURE_NEGLIGIBLE_UNIONS ← prove
   r"!m f:(real^N->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> s has_measure (m s)) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t) ==> negligible(s INTER t))
        ==> (UNIONS f) has_measure (sum f m)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, UNIONS_0, UNIONS_INSERT, HAS_MEASURE_EMPTY] THEN
    REWRITE_TAC [IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"f:(real^N->bool)->bool"] THEN
    STRIP_TAC THEN STRIP_TAC THEN MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNION THEN
    REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [INTER_UNIONS] THEN MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [])

  let MEASURE_NEGLIGIBLE_UNIONS ← prove
   r"!m f:(real^N->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> s has_measure (m s)) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t) ==> negligible(s INTER t))
        ==> measure(UNIONS f) = sum f m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_NEGLIGIBLE_UNIONS])

  let HAS_MEASURE_DISJOINT_UNIONS ← prove
   r"!m f:(real^N->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> s has_measure (m s)) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t) ==> DISJOINT s t)
        ==> (UNIONS f) has_measure (sum f m)"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNIONS THEN
    ASM_SIMP_TAC [NEGLIGIBLE_EMPTY])

  let MEASURE_DISJOINT_UNIONS ← prove
   r"!m f:(real^N->bool)->bool.
        FINITE f /\
        (!s. s IN f ==> s has_measure (m s)) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t) ==> DISJOINT s t)
        ==> measure(UNIONS f) = sum f m"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_DISJOINT_UNIONS])

  let HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE ← prove
   r"!f:A->real^N->bool s.
        FINITE s /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> negligible((f x) INTER (f y)))
        ==> (UNIONS (IMAGE f s)) has_measure (sum s (\x. measure(f x)))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"sum s (\x. measure(f x)) = sum (IMAGE (f:A->real^N->bool) s) measure")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      MATCH_MP_TAC SUM_IMAGE_NONZERO THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
      ASM_SIMP_TAC [INTER_ACI, MEASURABLE_MEASURE_EQ_0],
      MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNIONS THEN
      ASM_SIMP_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [FINITE_IMAGE, HAS_MEASURE_MEASURE]])

  let MEASURE_NEGLIGIBLE_UNIONS_IMAGE ← prove
   r"!f:A->real^N->bool s.
        FINITE s /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> negligible((f x) INTER (f y)))
        ==> measure(UNIONS (IMAGE f s)) = sum s (\x. measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE])

  let HAS_MEASURE_DISJOINT_UNIONS_IMAGE ← prove
   r"!f:A->real^N->bool s.
        FINITE s /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> (UNIONS (IMAGE f s)) has_measure (sum s (\x. measure(f x)))"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE THEN
    ASM_SIMP_TAC [NEGLIGIBLE_EMPTY])

  let MEASURE_DISJOINT_UNIONS_IMAGE ← prove
   r"!f:A->real^N->bool s.
        FINITE s /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> measure(UNIONS (IMAGE f s)) = sum s (\x. measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_DISJOINT_UNIONS_IMAGE])

  let HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real^N->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> negligible((f x) INTER (f y)))
        ==> (UNIONS (IMAGE f s)) has_measure (sum s (\x. measure(f x)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:A->real^N->bool",
                      ← q r"{x | x IN s /\ ~((f:A->real^N->bool) x = {})}"]
          HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, FINITE_RESTRICT] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_UNIONS, IN_IMAGE, IN_ELIM_THM] THEN
      MESON_TAC [NOT_IN_EMPTY],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN
      SIMP_TAC [SUBSET, IN_ELIM_THM, ← TAUT (← q r"a /\ ~(a /\ b) <=> a /\ ~b")] THEN
      REWRITE_TAC [MEASURE_EMPTY]])

  let MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real^N->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> negligible((f x) INTER (f y)))
        ==> measure(UNIONS (IMAGE f s)) = sum s (\x. measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG])

  let HAS_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real^N->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> (UNIONS (IMAGE f s)) has_measure (sum s (\x. measure(f x)))"
   (REWRITE_TAC [DISJOINT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG THEN
    ASM_SIMP_TAC [NEGLIGIBLE_EMPTY])

  let MEASURE_DISJOINT_UNIONS_IMAGE_STRONG ← prove
   r"!f:A->real^N->bool s.
        FINITE {x | x IN s /\ ~(f x = {})} /\
        (!x. x IN s ==> measurable(f x)) /\
        (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (f x) (f y))
        ==> measure(UNIONS (IMAGE f s)) = sum s (\x. measure(f x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    ASM_SIMP_TAC [HAS_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG])

  pure { HAS_MEASURE_0, MEASURE_EQ_0, NEGLIGIBLE_IMP_MEASURABLE, HAS_MEASURE_EMPTY,
         MEASURE_EMPTY, MEASURABLE_EMPTY, MEASURABLE_SING, MEASURABLE_MEASURE_EQ_0,
         NEGLIGIBLE_EQ_MEASURE_0, MEASURE_SING, MEASURABLE_MEASURE_POS_LT,
         NEGLIGIBLE_INTERVAL, MEASURABLE_UNIONS, HAS_MEASURE_DIFF_SUBSET, MEASURABLE_DIFF,
         MEASURE_DIFF_SUBSET, HAS_MEASURE_UNION_NEGLIGIBLE, HAS_MEASURE_DIFF_NEGLIGIBLE,
         HAS_MEASURE_UNION_NEGLIGIBLE_EQ, HAS_MEASURE_DIFF_NEGLIGIBLE_EQ,
         HAS_MEASURE_ALMOST, HAS_MEASURE_ALMOST_EQ, MEASURABLE_ALMOST,
         HAS_MEASURE_NEGLIGIBLE_UNION, MEASURE_NEGLIGIBLE_UNION,
         MEASURE_NEGLIGIBLE_UNION_EQ, HAS_MEASURE_NEGLIGIBLE_SYMDIFF,
         MEASURABLE_NEGLIGIBLE_SYMDIFF, MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ,
         MEASURE_NEGLIGIBLE_SYMDIFF, NEGLIGIBLE_SYMDIFF_EQ, NEGLIGIBLE_DELETE,
         HAS_MEASURE_NEGLIGIBLE_UNIONS, MEASURE_NEGLIGIBLE_UNIONS,
         HAS_MEASURE_DISJOINT_UNIONS, MEASURE_DISJOINT_UNIONS,
         HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE, MEASURE_NEGLIGIBLE_UNIONS_IMAGE,
         HAS_MEASURE_DISJOINT_UNIONS_IMAGE, MEASURE_DISJOINT_UNIONS_IMAGE,
         HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG, MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG,
         HAS_MEASURE_DISJOINT_UNIONS_IMAGE_STRONG, MEASURE_DISJOINT_UNIONS_IMAGE_STRONG }

/- ------------------------------------------------------------------------- -/
/- Measure of unions, inner and outer approximation, limits, integrals of  -/
/- constants, open sets are not negligible.  (measure.ml 736-1071)         -/
/- ------------------------------------------------------------------------- -/

structure MSC where
  MEASURE_UNION : thm
  MEASURE_UNION_LE : thm
  MEASURE_UNIONS_LE : thm
  MEASURABLE_INSERT : thm
  MEASURABLE_DELETE : thm
  MEASURE_INSERT : thm
  MEASURE_DELETE : thm
  MEASURE_UNIONS_LE_IMAGE : thm
  MEASURE_SUB_LE_MEASURE_DIFF : thm
  MEASURE_SUB_LE_MEASURE_SYMDIFF : thm
  MEASURABLE_INNER_OUTER : thm
  HAS_MEASURE_INNER_OUTER : thm
  HAS_MEASURE_INNER_OUTER_LE : thm
  NEGLIGIBLE_OUTER : thm
  NEGLIGIBLE_OUTER_LE : thm
  HAS_MEASURE_LIMIT : thm
  MEASURE_LIMIT : thm
  INTEGRABLE_ON_CONST : thm
  ABSOLUTELY_INTEGRABLE_ON_CONST : thm
  HAS_INTEGRAL_CONST_GEN : thm
  INTEGRAL_CONST_GEN : thm
  OPEN_NOT_NEGLIGIBLE : thm
  NOT_NEGLIGIBLE_UNIV : thm
  NEGLIGIBLE_EMPTY_INTERIOR : thm
  HAS_INTEGRAL_NEGLIGIBLE_EQ_AE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSC [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) : ExceptT String IO MSC := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE, HAS_MEASURE_MEASURABLE_MEASURE, HAS_MEASURE_MEASURE, MEASURABLE,
        MEASURABLE_INTEGRABLE, MEASURABLE_INTER, MEASURABLE_UNION, MEASURE_DISJOINT_UNION,
        MEASURE_INTEGRAL, MEASURE_POS_LE, MEASURE_SUBSET, MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_DIFF, MEASURABLE_EMPTY, MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ,
        MEASURABLE_UNIONS, MEASURE_EMPTY, MEASURE_NEGLIGIBLE_SYMDIFF, NEGLIGIBLE_INTERVAL,
        NEGLIGIBLE_SYMDIFF_EQ, .. } := BMSB
  let { ARITH, CARD_NUMSEG_1, CART_EQ, DIMINDEX_GE_1, EMPTY_SUBSET, EQ_IMP, EQ_TRANS,
        ETA_AX, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE_1, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_LT,
        NUMSEG_EMPTY, REAL_ABS_NUM, REAL_ABS_SUB, REAL_ADD_LID, REAL_DIV_REFL, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_SUB_LADD, REAL_LE_LADD, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LE, REAL_OF_NUM_LT, REAL_POS, REAL_SUB_REFL,
        RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_REFL, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_CLAUSES, UNIONS_0, UNIONS_INSERT, UNIV_NOT_EMPTY, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, EXISTS_LIFT, IN_INTERVAL, INTERVAL_NE_EMPTY, LIFT_DROP, LIFT_SUB,
        NORM_EQ_0, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_CBALL, INTERIOR_SUBSET, OPEN_CONTAINS_CBALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { OPEN_INTERIOR, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { SUM_BOUND_GEN, .. } := D.ig.dv.dg.pt.qses
  let { LINEAR_ID, .. } := D.ig.dv.dg.qvec
  let { REAL_LE_SUB_RADD, .. } := D.ig.dv.qsession
  let { LINEAR_VMUL_DROP, .. } := D.ig.dv.qvec
  let { REAL_SUB_ADD2, .. } := D.ig.qsession
  let { HAS_INTEGRAL, HAS_INTEGRAL_INTEGRAL, HAS_INTEGRAL_LINEAR,
        HAS_INTEGRAL_NEGLIGIBLE_EQ, HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE_EQ,
        INTEGRABLE_0, INTEGRABLE_LINEAR, INTEGRABLE_STRADDLE, .. } := D.qintegration2
  let { absolutely_integrable_on, INTEGRAL_UNIQUE, NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, .. }
        := D.qintegration3
  let { REAL_SUB_SUB2, SUM_IMAGE_LE, .. } := D.qsession
  let { vec, .. } := D.qvec
  -- @@SCOPE END

  let MEASURE_UNION ← prove
   r"!s t:real^N->bool.
        measurable s /\ measurable t
        ==> measure(s UNION t) = measure(s) + measure(t) - measure(s INTER t)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"s UNION t = (s INTER t) UNION (s DIFF t) UNION (t DIFF s)")] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a + b - c:real = c + (a - c) + (b - c)")] THEN
    MP_TAC (← ISPECL [← q r"s DIFF t:real^N->bool", ← q r"t DIFF s:real^N->bool"]
          MEASURE_DISJOINT_UNION) THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF] THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s INTER t:real^N->bool",
                      ← q r"(s DIFF t) UNION (t DIFF s):real^N->bool"]
                  MEASURE_DISJOINT_UNION) THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_UNION, MEASURABLE_INTER] THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REPEAT (DISCH_THEN SUBST1_TAC) THEN AP_TERM_TAC THEN BINOP_TAC THEN
    REWRITE_TAC [REAL_EQ_SUB_LADD] THEN MATCH_MP_TAC EQ_TRANS THENL
     [EXISTS_TAC (← q r"measure((s DIFF t) UNION (s INTER t):real^N->bool)"),
      EXISTS_TAC (← q r"measure((t DIFF s) UNION (s INTER t):real^N->bool)")] THEN
    (CONJ_TAC THENL
      [CONV_TAC SYM_CONV THEN MATCH_MP_TAC MEASURE_DISJOINT_UNION THEN
       ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTER],
       AP_TERM_TAC] THEN
     SET_TAC []))

  let MEASURE_UNION_LE ← prove
   r"!s t:real^N->bool.
        measurable s /\ measurable t
        ==> measure(s UNION t) <= measure s + measure t"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [MEASURE_UNION] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + b - c <= a + b <=> &0 <= c")] THEN
    MATCH_MP_TAC MEASURE_POS_LE THEN ASM_SIMP_TAC [MEASURABLE_INTER])

  let MEASURE_UNIONS_LE ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!s. s IN f ==> measurable s)
        ==> measure(UNIONS f) <= sum f (\s. measure s)"
   (REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, UNIONS_INSERT, SUM_CLAUSES] THEN
    REWRITE_TAC [MEASURE_EMPTY, REAL_LE_REFL] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"f:(real^N->bool)->bool"] THEN
    REWRITE_TAC [IN_INSERT] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(s:real^N->bool) + measure(UNIONS f:real^N->bool)") THEN
    ASM_SIMP_TAC [MEASURE_UNION_LE, MEASURABLE_UNIONS] THEN
    REWRITE_TAC [REAL_LE_LADD] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [])

  let MEASURABLE_INSERT ← prove
   r"!x s:real^N->bool. measurable(x INSERT s) <=> measurable s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{x:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let MEASURABLE_DELETE ← prove
   r"!x s:real^N->bool. measurable(s DELETE x) <=> measurable s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MEASURABLE_NEGLIGIBLE_SYMDIFF_EQ THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{x:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let MEASURE_INSERT ← prove
   r"!x s:real^N->bool. measure(x INSERT s) = measure s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{x:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let MEASURE_DELETE ← prove
   r"!x s:real^N->bool. measure(s DELETE x) = measure s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{x:real^N}") THEN
    REWRITE_TAC [NEGLIGIBLE_SING] THEN SET_TAC [])

  let MEASURE_UNIONS_LE_IMAGE ← prove
   r"!f:A->bool s:A->(real^N->bool).
        FINITE f /\ (!a. a IN f ==> measurable(s a))
        ==> measure(UNIONS (IMAGE s f)) <= sum f (\a. measure(s a))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum (IMAGE s (f:A->bool)) (\k:real^N->bool. measure k)") THEN
    ASM_SIMP_TAC [MEASURE_UNIONS_LE, FORALL_IN_IMAGE, FINITE_IMAGE] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
    REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC SUM_IMAGE_LE THEN
    ASM_SIMP_TAC [MEASURE_POS_LE])

  let MEASURE_SUB_LE_MEASURE_DIFF ← prove
   r"!s t:real^N->bool.
      measurable s /\ measurable t
      ==> measure s - measure t <= measure(s DIFF t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_LE_SUB_RADD] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"measure((s DIFF t) UNION t:real^N->bool)") THEN
    ASM_SIMP_TAC [MEASURE_UNION_LE, MEASURABLE_DIFF] THEN
    MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_DIFF] THEN SET_TAC [])

  let MEASURE_SUB_LE_MEASURE_SYMDIFF ← prove
   r"!s t:real^N->bool.
      measurable s /\ measurable t
      ==> abs(measure s - measure t) <= measure((s DIFF t) UNION (t DIFF s))"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(s - t) <= e <=> s - t <= e /\ t - s <= e")] THEN
    REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_SUB_LE_MEASURE_DIFF o
          lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_UNION, MEASURABLE_DIFF] THEN SET_TAC [])

  let MEASURABLE_INNER_OUTER ← prove
   r"!s:real^N->bool.
        measurable s <=>
                !e. &0 < e
                    ==> ?t u. t SUBSET s /\ s SUBSET u /\
                              measurable t /\ measurable u /\
                              abs(measure t - measure u) < e"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN REPEAT (EXISTS_TAC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL, REAL_SUB_REFL, REAL_ABS_NUM],
      ALL_TAC] THEN
    REWRITE_TAC [MEASURABLE_INTEGRABLE] THEN MATCH_MP_TAC INTEGRABLE_STRADDLE THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"u:real^N->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\x. if x IN t then vec 1 else vec 0):real^N->real^1",
      ← q r"(\x. if x IN u then vec 1 else vec 0):real^N->real^1",
      ← q r"lift(measure(t:real^N->bool))",
      ← q r"lift(measure(u:real^N->bool))"] THEN
    ASM_REWRITE_TAC [← GSYM HAS_MEASURE, ← GSYM HAS_MEASURE_MEASURE] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN REPEAT STRIP_TAC THEN
    REPEAT (COND_CASES_TAC THEN
           ASM_REWRITE_TAC [DROP_VEC, REAL_POS, REAL_LE_REFL]) THEN
    ASM SET_TAC [])

  let HAS_MEASURE_INNER_OUTER ← prove
   r"!s:real^N->bool m.
        s has_measure m <=>
                (!e. &0 < e ==> ?t. t SUBSET s /\ measurable t /\
                                    m - e < measure t) /\
                (!e. &0 < e ==> ?u. s SUBSET u /\ measurable u /\
                                    measure u < m + e)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_MEASURE_MEASURABLE_MEASURE] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "t") (LABEL_TAC "u")) THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC I [MEASURABLE_INNER_OUTER] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "u" (MP_TAC o SPEC (← q r"e / &2")) THEN
      REMOVE_THEN "t" (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      REWRITE_TAC [IMP_IMP, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e /\ t <= u /\ m - e / &2 < t /\ u < m + e / &2
                          ==> abs(t - u) < e")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"~(&0 < x - y) /\ ~(&0 < y - x) ==> x = y")) THEN
      CONJ_TAC THEN DISCH_TAC THENL
       [REMOVE_THEN "u" (MP_TAC o SPEC (← q r"measure(s:real^N->bool) - m")) THEN
        ASM_REWRITE_TAC [REAL_SUB_ADD2, ← GSYM REAL_NOT_LE],
        REMOVE_THEN "t" (MP_TAC o SPEC (← q r"m - measure(s:real^N->bool)")) THEN
        ASM_REWRITE_TAC [REAL_SUB_SUB2, ← GSYM REAL_NOT_LE]] THEN
      ASM_MESON_TAC [MEASURE_SUBSET]])

  let HAS_MEASURE_INNER_OUTER_LE ← prove
   r"!s:real^N->bool m.
        s has_measure m <=>
                (!e. &0 < e ==> ?t. t SUBSET s /\ measurable t /\
                                    m - e <= measure t) /\
                (!e. &0 < e ==> ?u. s SUBSET u /\ measurable u /\
                                    measure u <= m + e)"
   (REWRITE_TAC [HAS_MEASURE_INNER_OUTER] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < e /\ m - e / &2 <= t ==> m - e < t"),
               ← REAL_ARITH (← q r"&0 < e /\ u <= m + e / &2 ==> u < m + e"),
               ← REAL_ARITH (← q r"&0 < e <=> &0 < e / &2"), REAL_LT_IMP_LE])

  let NEGLIGIBLE_OUTER ← prove
   r"!s:real^N->bool.
      negligible s <=>
      !e. &0 < e ==> ?t. s SUBSET t /\ measurable t /\ measure t < e"
   (GEN_TAC THEN REWRITE_TAC [← GSYM HAS_MEASURE_0, HAS_MEASURE_INNER_OUTER] THEN
    REWRITE_TAC [REAL_ADD_LID] THEN MATCH_MP_TAC (← TAUT (← q r"a ==> (a /\ b <=> b)")) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"{}:real^N->bool") THEN
    REWRITE_TAC [EMPTY_SUBSET, MEASURABLE_EMPTY, MEASURE_EMPTY] THEN
    ASM_REAL_ARITH_TAC)

  let NEGLIGIBLE_OUTER_LE ← prove
   r"!s:real^N->bool.
      negligible s <=>
      !e. &0 < e ==> ?t. s SUBSET t /\ measurable t /\ measure t <= e"
   (REWRITE_TAC [NEGLIGIBLE_OUTER] THEN
    MESON_TAC [REAL_LT_IMP_LE, ← REAL_ARITH
      (← q r"&0 < e ==> &0 < e / &2 /\ (x <= e / &2 ==> x < e)")])

  let HAS_MEASURE_LIMIT ← prove
   r"!s. s has_measure m <=>
        !e. &0 < e
            ==> ?B. &0 < B /\
                    !a b. ball(vec 0,B) SUBSET interval[a,b]
                          ==> ?z. (s INTER interval[a,b]) has_measure z /\
                                  abs(z - m) < e"
   (GEN_TAC THEN REWRITE_TAC [HAS_MEASURE] THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_INTEGRAL] THEN
    REWRITE_TAC [IN_UNIV] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
      [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [← MESON [IN_INTER]
          (← q r"(if x IN k INTER s then a else b) =
         (if x IN s then if x IN k then a else b else b)")] THEN
    REWRITE_TAC [EXISTS_LIFT, ← GSYM LIFT_SUB, NORM_LIFT])

  let MEASURE_LIMIT ← prove
   r"!s:real^N->bool e.
        measurable s /\ &0 < e
        ==> ?B. &0 < B /\
                !a b. ball(vec 0,B) SUBSET interval[a,b]
                      ==> abs(measure(s INTER interval[a,b]) -
                              measure s) < e"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HAS_MEASURE_MEASURE]) THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_MEASURE_LIMIT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [MEASURE_UNIQUE])

  let INTEGRABLE_ON_CONST ← prove
   r"!c:real^N. (\x:real^M. c) integrable_on s <=> c = vec 0 \/ measurable s"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"c:real^N = vec 0") THEN
    ASM_REWRITE_TAC [INTEGRABLE_0, MEASURABLE] THEN EQ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CART_EQ]) THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, VEC_COMPONENT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o
        ISPEC (← q r"(\y. lambda i. y$k / (c:real^N)$k):real^N->real^1") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_LINEAR)) THEN
      ASM_SIMP_TAC [vec, o_DEF, REAL_DIV_REFL] THEN DISCH_THEN MATCH_MP_TAC THEN
      SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                LAMBDA_BETA] THEN REAL_ARITH_TAC,
      DISCH_THEN (MP_TAC o
        ISPEC (← q r"(\y. lambda i. (c:real^N)$i * y$i):real^1->real^N") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_LINEAR)) THEN
      ANTS_TAC THENL
       [SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                  LAMBDA_BETA] THEN REAL_ARITH_TAC,
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        SIMP_TAC [FUN_EQ_THM, CART_EQ, o_THM, LAMBDA_BETA, VEC_COMPONENT] THEN
        REWRITE_TAC [REAL_MUL_RID]]])

  let ABSOLUTELY_INTEGRABLE_ON_CONST ← prove
   r"!c. (\x. c) absolutely_integrable_on s <=> c = vec 0 \/ measurable s"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_ON_CONST] THEN
    REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP, DROP_VEC, NORM_EQ_0])

  let HAS_INTEGRAL_CONST_GEN ← prove
   r"!s c. measurable s
         ==> (((\x. c):real^M->real^N) has_integral (measure s % c)) s"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"(\x. vec 1):real^M->real^1", ← q r"integral s ((\x. vec 1):real^M->real^1)",
      ← q r"s:real^M->bool", ← q r"\v. drop v % (c:real^N)"] HAS_INTEGRAL_LINEAR) THEN
    ASM_SIMP_TAC [o_DEF, DROP_VEC, VECTOR_MUL_LID, ← GSYM MEASURE_INTEGRAL] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    SIMP_TAC [LINEAR_VMUL_DROP, LINEAR_ID, ← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    ASM_REWRITE_TAC [INTEGRABLE_ON_CONST])

  let INTEGRAL_CONST_GEN ← prove
   r"!s c. measurable s
         ==> integral s ((\x. c):real^M->real^N) = measure s % c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_CONST_GEN THEN ASM_REWRITE_TAC [])

  let OPEN_NOT_NEGLIGIBLE ← prove
   r"!s:real^N->bool. open s /\ ~(s = {}) ==> ~(negligible s)"
   (GEN_TAC THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"negligible(interval[a - e / (&(dimindex(:N))) % vec 1:real^N,
                                    a + e / (&(dimindex(:N))) % vec 1])")
    MP_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"cball(a:real^N,e)") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [NEGLIGIBLE_SUBSET], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, IN_INTERVAL, IN_CBALL, VECTOR_ADD_COMPONENT,
        VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID,
        ← REAL_ARITH (← q r"a - e <= x /\ x <= a + e <=> abs(x - a) <= e"), dist] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC SUM_BOUND_GEN THEN
      REWRITE_TAC [FINITE_NUMSEG, CARD_NUMSEG_1, NUMSEG_EMPTY, NOT_LT] THEN
      REWRITE_TAC [IN_NUMSEG, VECTOR_SUB_COMPONENT, DIMINDEX_GE_1] THEN
      ASM_MESON_TAC [REAL_ABS_SUB],
      REWRITE_TAC [NEGLIGIBLE_INTERVAL, INTERVAL_NE_EMPTY] THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, REAL_MUL_RID,
        VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT] THEN
      REPEAT STRIP_TAC THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a - e < a + e <=> &0 < e")] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1]])

  let NOT_NEGLIGIBLE_UNIV ← prove
   r"~negligible(:real^N)"
   (SIMP_TAC [OPEN_NOT_NEGLIGIBLE, OPEN_UNIV, UNIV_NOT_EMPTY])

  let NEGLIGIBLE_EMPTY_INTERIOR ← prove
   r"!s:real^N->bool. negligible s ==> interior s = {}"
   (MESON_TAC [OPEN_NOT_NEGLIGIBLE, INTERIOR_SUBSET, OPEN_INTERIOR,
               NEGLIGIBLE_SUBSET])

  let HAS_INTEGRAL_NEGLIGIBLE_EQ_AE ← prove
   r"!f:real^M->real^N s t.
        negligible t /\
        (!x i. x IN s DIFF t /\ 1 <= i /\ i <= dimindex (:N) ==> &0 <= f x$i)
        ==> ((f has_integral vec 0) s <=>
             negligible {x | x IN s /\ ~(f x = vec 0)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. if x IN t then vec 0 else (f:real^M->real^N) x",
      ← q r"s:real^M->bool"] HAS_INTEGRAL_NEGLIGIBLE_EQ) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [VEC_COMPONENT, IN_DIFF, REAL_LE_REFL], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ,
      MATCH_MP_TAC NEGLIGIBLE_SYMDIFF_EQ THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET] THEN
    EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  pure { MEASURE_UNION, MEASURE_UNION_LE, MEASURE_UNIONS_LE, MEASURABLE_INSERT,
         MEASURABLE_DELETE, MEASURE_INSERT, MEASURE_DELETE, MEASURE_UNIONS_LE_IMAGE,
         MEASURE_SUB_LE_MEASURE_DIFF, MEASURE_SUB_LE_MEASURE_SYMDIFF,
         MEASURABLE_INNER_OUTER, HAS_MEASURE_INNER_OUTER, HAS_MEASURE_INNER_OUTER_LE,
         NEGLIGIBLE_OUTER, NEGLIGIBLE_OUTER_LE, HAS_MEASURE_LIMIT, MEASURE_LIMIT,
         INTEGRABLE_ON_CONST, ABSOLUTELY_INTEGRABLE_ON_CONST, HAS_INTEGRAL_CONST_GEN,
         INTEGRAL_CONST_GEN, OPEN_NOT_NEGLIGIBLE, NOT_NEGLIGIBLE_UNIV,
         NEGLIGIBLE_EMPTY_INTERIOR, HAS_INTEGRAL_NEGLIGIBLE_EQ_AE }

/- ------------------------------------------------------------------------- -/
/- Properties of measure under simple affine transformations: affinities   -/
/- and coordinate stretches.  (measure.ml 1072-1280)                        -/
/- ------------------------------------------------------------------------- -/

structure MSD where
  HAS_MEASURE_AFFINITY : thm
  STRETCH_GALOIS : thm
  HAS_MEASURE_STRETCH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSD [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) : ExceptT String IO MSD := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE, .. } := BMSA
  let { HAS_MEASURE_0, .. } := BMSB
  let { CART_EQ, COND_ID, CONJ_ASSOC, DIMINDEX_GE_1, ETA_AX, EXISTS_IN_IMAGE, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_RULES, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ_ALT, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MONO_FORALL, MONO_IMP, NOT_FORALL_THM, NOT_IMP, NOT_LE,
        NUMSEG_EMPTY, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_EQ_0, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_RMUL_EQ, REAL_LE_SUP_FINITE, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_LMUL, REAL_LT_LMUL_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ,
        REAL_LTE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_SYM,
        REAL_NOT_LT, REAL_POW_INV, REAL_POW_LT, REAL_SUB_LDISTRIB, SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core5
  let { o_THM, real_abs, real_div, real_pow, SUP_FINITE, UNWIND_THM1, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_SUB, IN_INTERVAL, LIFT_CMUL, LIFT_DROP, NORM_1, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_MUL_LZERO,
        VECTOR_MUL_RNEG, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, VECTOR_SUB_LDISTRIB, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EQ_EMPTY, CENTRE_IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top1
  let { IN_BALL, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_ABS_POW, .. } := D.ig.dv.dg.qsession
  let { NORM_LE_COMPONENTWISE, .. } := D.ig.dv.dg.qvec
  let { REAL_ABS_ABS, REAL_ABS_NZ, REAL_INV_INV, .. } := D.ig.dv.qsession
  let { PRODUCT_EQ_0_NUMSEG, .. } := D.ig.qproducts
  let { REAL_SUP_LE_FINITE, .. } := D.ig.qsession
  let { IMAGE_AFFINITY_INTERVAL, IMAGE_STRETCH_INTERVAL, .. } := D.ig.qtopology
  let { COND_COMPONENT, .. } := D.ig.qvec
  let { HAS_INTEGRAL, HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_STRETCH, .. } := D.qintegration2
  let { NEGLIGIBLE_FINITE, NEGLIGIBLE_STANDARD_HYPERPLANE, NEGLIGIBLE_SUBSET, .. } :=
        D.qintegration3
  let { PRODUCT_INV, .. } := D.qproducts
  let { DIMINDEX_NONZERO, REAL_LT_SUP_FINITE, .. } := D.qsession
  let { VECTOR_EQ_AFFINITY, .. } := D.qtopology2
  -- @@SCOPE END

  let HAS_MEASURE_AFFINITY ← prove
   r"!s m c y. s has_measure y
             ==> (IMAGE (\x:real^N. m % x + c) s)
                 has_measure abs(m) pow (dimindex(:N)) * y"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"m = &0") THENL
     [ASM_REWRITE_TAC [REAL_ABS_NUM, VECTOR_ADD_LID, VECTOR_MUL_LZERO] THEN
      ONCE_REWRITE_TAC [← MATCH_MP (← ARITH_RULE (← q r"~(x = 0) ==> x = SUC(x - 1)"))
       (← SPEC_ALL DIMINDEX_NONZERO)] THEN DISCH_TAC THEN
      REWRITE_TAC [real_pow, REAL_MUL_LZERO, HAS_MEASURE_0] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{c:real^N}") THEN
      SIMP_TAC [NEGLIGIBLE_FINITE, FINITE_RULES] THEN SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [HAS_MEASURE] THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL] THEN REWRITE_TAC [IN_UNIV] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real / abs(m) pow dimindex(:N)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, ← GSYM REAL_ABS_NZ, REAL_POW_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"abs(m) * B + norm(c:real^N)") THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < B /\ &0 <= x ==> &0 < B + x"),
                  NORM_POS_LE, REAL_LT_MUL, ← GSYM REAL_ABS_NZ, REAL_POW_LT] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
    REWRITE_TAC [IN_IMAGE] THEN
    ASM_SIMP_TAC [VECTOR_EQ_AFFINITY, UNWIND_THM1] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
      [← q r"if &0 <= m then inv m % u + --(inv m % c):real^N
                 else inv m % v + --(inv m % c)",
       ← q r"if &0 <= m then inv m % v + --(inv m % c):real^N
                 else inv m % u + --(inv m % c)"]) THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b ==> c) ==> (a ==> b) ==> c")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"m % x + c:real^N")) THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [IN_BALL, IN_INTERVAL] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← NORM_ARITH (← q r"dist(vec 0,x) = norm(x:real^N)")] THEN
        DISCH_TAC THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(x:real^N) < a ==> norm(x + y) < a + norm(y)")) THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_LT_LMUL, ← GSYM REAL_ABS_NZ],
        ALL_TAC] THEN
      SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_NEG_COMPONENT,
                COND_COMPONENT] THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
      REWRITE_TAC [← REAL_ARITH (← q r"m * u + --(m * c):real = (u - c) * m")] THEN
      SUBST1_TAC (← REAL_ARITH
        (← q r"inv(m) = if &0 <= inv(m) then abs(inv m) else --(abs(inv m))")) THEN
      SIMP_TAC [REAL_LE_INV_EQ] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(x - y:real) * --z = (y - x) * z")] THEN
      REWRITE_TAC [REAL_ABS_INV, ← GSYM real_div] THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, ← GSYM REAL_ABS_NZ] THEN
      ASM_REWRITE_TAC [real_abs] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN DISCH_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^1")
     (fun th => tactic_of do
        pure (EXISTS_TAC (← q r"(abs m pow dimindex (:N)) % z:real^1") THEN
              MP_TAC th))) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REAL_FIELD (← q r"~(x = &0) ==> ~(inv x = &0)"))) THEN
    REWRITE_TAC [← TAUT (← q r"a ==> b ==> c <=> b /\ a ==> c")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--(inv m % c):real^N") o
      MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
    ASM_REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, REAL_INV_INV] THEN
    SIMP_TAC [COND_ID] THEN COND_CASES_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC,
                 VECTOR_MUL_LNEG, VECTOR_MUL_RNEG] THEN
    ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID, VECTOR_NEG_NEG] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(u + --c) + c:real^N = u")] THEN
    REWRITE_TAC [REAL_ABS_INV, REAL_INV_INV, ← GSYM REAL_POW_INV] THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    REWRITE_TAC [LIFT_CMUL, ← GSYM VECTOR_SUB_LDISTRIB] THEN
    REWRITE_TAC [NORM_MUL, REAL_ABS_POW, REAL_ABS_ABS] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_POW_LT, ← GSYM REAL_ABS_NZ])

  let STRETCH_GALOIS ← prove
   r"!x:real^N y:real^N m.
        (!k. 1 <= k /\ k <= dimindex(:N) ==>  ~(m k = &0))
        ==> ((y = (lambda k. m k * x$k)) <=> (lambda k. inv(m k) * y$k) = x)"
   (REPEAT GEN_TAC THEN SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x. p x ==> (q x <=> r x))
    ==> (!x. p x) ==> ((!x. q x) <=> (!x. r x))")) THEN
    GEN_TAC THEN ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:N)") THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => REAL_FIELD t))

  let HAS_MEASURE_STRETCH ← prove
   r"!s m y. s has_measure y
           ==> (IMAGE (\x:real^N. lambda k. m k * x$k) s :real^N->bool)
               has_measure abs(product (1..dimindex(:N)) m) * y"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC
     (← q r"!k. 1 <= k /\ k <= dimindex(:N) ==> ~(m k = &0)")
    THENL
     [ALL_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_FORALL_THM]) THEN
      REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"product(1..dimindex (:N)) m = &0") SUBST1_TAC THENL
       [ASM_MESON_TAC [PRODUCT_EQ_0_NUMSEG], ALL_TAC] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LZERO, HAS_MEASURE_0] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"{x:real^N | x$k = &0}") THEN
      ASM_SIMP_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, LAMBDA_BETA, REAL_MUL_LZERO]] THEN
    UNDISCH_TAC (← q r"(s:real^N->bool) has_measure y") THEN
    REWRITE_TAC [HAS_MEASURE] THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL] THEN REWRITE_TAC [IN_UNIV] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"&0 < abs(product(1..dimindex(:N)) m)") ASSUME_TAC THENL
     [ASM_MESON_TAC [REAL_ABS_NZ, REAL_LT_DIV, PRODUCT_EQ_0_NUMSEG],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real / abs(product(1..dimindex(:N)) m)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"sup(IMAGE (\k. abs(m k) * B) (1..dimindex(:N)))") THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [REAL_LT_SUP_FINITE, FINITE_IMAGE, NUMSEG_EMPTY, FINITE_NUMSEG,
                    IN_NUMSEG, ← GSYM NOT_LE, DIMINDEX_GE_1, IMAGE_EQ_EMPTY,
                    EXISTS_IN_IMAGE] THEN
      ASM_MESON_TAC [IN_NUMSEG, DIMINDEX_GE_1, LE_REFL, REAL_LT_MUL, REAL_ABS_NZ],
      DISCH_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [IN_IMAGE, STRETCH_GALOIS, UNWIND_THM1] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
      [← q r"(lambda k. min (inv(m k) * (u:real^N)$k)
                     (inv(m k) * (v:real^N)$k)):real^N",
       ← q r"(lambda k. max (inv(m k) * (u:real^N)$k)
                 (inv(m k) * (v:real^N)$k)):real^N"]) THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (b ==> a ==> c) ==> (a ==> b) ==> c")) THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"z:real^1") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"!k. 1 <= k /\ k <= dimindex (:N) ==> ~(inv(m k) = &0)")
      MP_TAC THENL [ASM_SIMP_TAC [REAL_INV_EQ_0], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_STRETCH)] THEN
    (MP_TAC (← ISPECL [← q r"u:real^N", ← q r"v:real^N", ← q r"\i:num. inv(m i:real)"]
      IMAGE_STRETCH_INTERVAL) THEN
     SUBGOAL_THEN (← q r"~(interval[u:real^N,v] = {})") ASSUME_TAC THENL
      [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
        (← q r"s SUBSET t ==> ~(s = {}) ==> ~(t = {})"))) THEN
       ASM_REWRITE_TAC [BALL_EQ_EMPTY, ← GSYM REAL_NOT_LT],
       ALL_TAC] THEN
     ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM))
    THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"b SUBSET s ==> b' SUBSET IMAGE f b ==> b' SUBSET IMAGE f s"))) THEN
      REWRITE_TAC [IN_BALL, SUBSET, ← NORM_ARITH (← q r"dist(vec 0:real^N,x) = norm x"),
                   IN_IMAGE] THEN
      ASM_SIMP_TAC [STRETCH_GALOIS, REAL_INV_EQ_0, UNWIND_THM1, REAL_INV_INV] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC
       (← q r"norm(sup(IMAGE(\k. abs(m k)) (1..dimindex(:N))) % x:real^N)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NORM_LE_COMPONENTWISE THEN
        SIMP_TAC [LAMBDA_BETA, VECTOR_MUL_COMPONENT, REAL_ABS_MUL] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_RMUL THEN
        REWRITE_TAC [REAL_ABS_POS] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> x <= abs y")) THEN
        ASM_SIMP_TAC [REAL_LE_SUP_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY,
                      NUMSEG_EMPTY, FINITE_NUMSEG, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_NUMSEG] THEN ASM_MESON_TAC [REAL_LE_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [NORM_MUL] THEN MATCH_MP_TAC REAL_LTE_TRANS THEN
      EXISTS_TAC (← q r"abs(sup(IMAGE(\k. abs(m k)) (1..dimindex(:N)))) * B") THEN
      SUBGOAL_THEN (← q r"&0 < sup(IMAGE(\k. abs(m k)) (1..dimindex(:N)))")
      ASSUME_TAC THENL
       [ASM_SIMP_TAC [REAL_LT_SUP_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY,
                      NUMSEG_EMPTY, FINITE_NUMSEG, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, ← GSYM REAL_ABS_NZ, IN_NUMSEG] THEN
        ASM_MESON_TAC [DIMINDEX_GE_1, LE_REFL],
        ALL_TAC] THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ, ← REAL_ARITH (← q r"&0 < x ==> &0 < abs x")] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sup(IMAGE(\k. abs(m k)) (1..dimindex(:N))) * B") THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ, ← REAL_ARITH (← q r"&0 < x ==> abs x <= x")] THEN
      ASM_SIMP_TAC [REAL_LE_SUP_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY,
                    NUMSEG_EMPTY, FINITE_NUMSEG, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      ASM_SIMP_TAC [EXISTS_IN_IMAGE, REAL_LE_RMUL_EQ] THEN
      ASM_SIMP_TAC [REAL_SUP_LE_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY,
                    NUMSEG_EMPTY, FINITE_NUMSEG, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      MP_TAC (← ISPEC (← q r"IMAGE (\k. abs (m k)) (1..dimindex(:N))") SUP_FINITE) THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IMAGE_EQ_EMPTY, NUMSEG_EMPTY,
                    ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      REWRITE_TAC [IN_IMAGE] THEN MESON_TAC [],

      MATCH_MP_TAC (← MESON []
       (← q r"s = t /\ P z ==> (f has_integral z) s ==> Q
                       ==> ?w. (f has_integral w) t /\ P w")) THEN
      SIMP_TAC [← GSYM PRODUCT_INV, FINITE_NUMSEG, ← GSYM REAL_ABS_INV] THEN
      REWRITE_TAC [REAL_INV_INV] THEN CONJ_TAC THENL
       [REWRITE_TAC [← GSYM IMAGE_o] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. f x = x) ==> IMAGE f s = s")) THEN
        SIMP_TAC [o_THM, LAMBDA_BETA, CART_EQ] THEN
        ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_RINV, REAL_MUL_LID],
        REWRITE_TAC [NORM_1, DROP_SUB, LIFT_DROP, DROP_CMUL] THEN
        REWRITE_TAC [← GSYM REAL_SUB_LDISTRIB, ETA_AX] THEN
        REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_ABS] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THEN
        ASM_MESON_TAC [NORM_1, DROP_SUB, LIFT_DROP]]])

  pure { HAS_MEASURE_AFFINITY, STRETCH_GALOIS, HAS_MEASURE_STRETCH }

/- ------------------------------------------------------------------------- -/
/- Measure under translations, scalings and affinities; the whole space is -/
/- not measurable.  (measure.ml 1281-1437)                                  -/
/- ------------------------------------------------------------------------- -/

structure MSE where
  HAS_MEASURE_TRANSLATION : thm
  NEGLIGIBLE_TRANSLATION : thm
  HAS_MEASURE_TRANSLATION_EQ : thm
  MEASURE_TRANSLATION : thm
  NEGLIGIBLE_TRANSLATION_REV : thm
  NEGLIGIBLE_TRANSLATION_EQ : thm
  MEASURABLE_TRANSLATION_EQ : thm
  MEASURABLE_TRANSLATION : thm
  HAS_MEASURE_SCALING : thm
  HAS_MEASURE_SCALING_EQ : thm
  MEASURABLE_SCALING : thm
  MEASURABLE_SCALING_EQ : thm
  MEASURABLE_AFFINITY_EQ : thm
  MEASURABLE_AFFINITY : thm
  MEASURE_SCALING : thm
  MEASURE_AFFINITY : thm
  NEGLIGIBLE_SCALING : thm
  NEGLIGIBLE_SCALING_EQ : thm
  NEGLIGIBLE_AFFINITY_EQ : thm
  NEGLIGIBLE_AFFINITY : thm
  NOT_MEASURABLE_UNIV : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSE [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSD : MSD) : ExceptT String IO MSE := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURE, measurable, measure, MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_EMPTY, MEASURABLE_MEASURE_EQ_0, MEASURABLE_SING, .. } :=
        BMSB
  let { NOT_NEGLIGIBLE_UNIV, .. } := BMSC
  let { HAS_MEASURE_AFFINITY, .. } := BMSD
  let { DIMINDEX_GE_1, EQ_IMP, .. } := D.ig.dv.dg.pt.cvx.core1
  let { IMAGE_CONST, IMAGE_ID, IMAGE_o, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIV, LE_1, REAL_ABS_MUL, REAL_ABS_NUM, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RZERO, REAL_POW_MUL,
        REAL_POW_ONE, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SURJECTIVE_IMAGE_EQ, .. } := D.ig.dv.dg.pt.cvx.core6
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { VECTOR_ADD_RID, VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        .. } := D.ig.dv.dg.pt.cvx.vec4
  let { add_translation_invariants, MESON_TAC, REAL_RAT_REDUCE_CONV, REAL_RING, SET_TAC,
        VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { NEGLIGIBLE_EMPTY, NEGLIGIBLE_SING, .. } := D.qintegration3
  let { REAL_POW_EQ_1, .. } := D.qsession
  -- @@SCOPE END

  let HAS_MEASURE_TRANSLATION ← prove
   r"!s m a. s has_measure m ==> (IMAGE (\x:real^N. a + x) s) has_measure m"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"&1", ← q r"a:real^N", ← q r"m:real"]
                  HAS_MEASURE_AFFINITY) THEN
    REWRITE_TAC [VECTOR_MUL_LID, REAL_ABS_NUM, REAL_POW_ONE, REAL_MUL_LID] THEN
    REWRITE_TAC [VECTOR_ADD_SYM])

  let NEGLIGIBLE_TRANSLATION ← prove
   r"!s a. negligible s ==> negligible (IMAGE (\x:real^N. a + x) s)"
   (SIMP_TAC [← GSYM HAS_MEASURE_0, HAS_MEASURE_TRANSLATION])

  let HAS_MEASURE_TRANSLATION_EQ ← prove
   r"!a s m. (IMAGE (\x:real^N. a + x) s) has_measure m <=> s has_measure m"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [HAS_MEASURE_TRANSLATION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"--a:real^N") o
      MATCH_MP HAS_MEASURE_TRANSLATION) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← VECTOR_ARITH (← q r"--a + a + b:real^N = b")] THEN
    SET_TAC [])

  add_translation_invariants [HAS_MEASURE_TRANSLATION_EQ]

  let MEASURE_TRANSLATION ← prove
   r"!a s. measure(IMAGE (\x:real^N. a + x) s) = measure s"
   (REWRITE_TAC [measure, HAS_MEASURE_TRANSLATION_EQ])

  add_translation_invariants [MEASURE_TRANSLATION]

  let NEGLIGIBLE_TRANSLATION_REV ← prove
   r"!s a. negligible (IMAGE (\x:real^N. a + x) s) ==> negligible s"
   (SIMP_TAC [← GSYM HAS_MEASURE_0, HAS_MEASURE_TRANSLATION_EQ])

  let NEGLIGIBLE_TRANSLATION_EQ ← prove
   r"!a s. negligible (IMAGE (\x:real^N. a + x) s) <=> negligible s"
   (SIMP_TAC [← GSYM HAS_MEASURE_0, HAS_MEASURE_TRANSLATION_EQ])

  add_translation_invariants [NEGLIGIBLE_TRANSLATION_EQ]

  let MEASURABLE_TRANSLATION_EQ ← prove
   r"!a:real^N s. measurable (IMAGE (\x. a + x) s) <=> measurable s"
   (REWRITE_TAC [measurable, HAS_MEASURE_TRANSLATION_EQ])

  add_translation_invariants [MEASURABLE_TRANSLATION_EQ]

  let MEASURABLE_TRANSLATION ← prove
   r"!s a:real^N. measurable s ==> measurable (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [MEASURABLE_TRANSLATION_EQ])

  let HAS_MEASURE_SCALING ← prove
   r"!s m c. s has_measure m
           ==> (IMAGE (\x:real^N. c % x) s) has_measure
               (abs(c) pow dimindex(:N)) * m"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real", ← q r"vec 0:real^N", ← q r"m:real"]
                  HAS_MEASURE_AFFINITY) THEN
    REWRITE_TAC [VECTOR_ADD_RID])

  let HAS_MEASURE_SCALING_EQ ← prove
   r"!s m c. ~(c = &0)
           ==> (IMAGE (\x:real^N. c % x) s
                  has_measure (abs(c) pow dimindex(:N)) * m <=>
                s has_measure m)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [HAS_MEASURE_SCALING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP HAS_MEASURE_SCALING) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, ← GSYM REAL_ABS_MUL] THEN
    REWRITE_TAC [← GSYM REAL_POW_MUL, VECTOR_MUL_ASSOC, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [← GSYM REAL_ABS_MUL, REAL_MUL_LINV] THEN
    REWRITE_TAC [REAL_POW_ONE, REAL_ABS_NUM, REAL_MUL_LID, VECTOR_MUL_LID] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let MEASURABLE_SCALING ← prove
   r"!s c. measurable s ==> measurable (IMAGE (\x:real^N. c % x) s)"
   (REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_SCALING])

  let MEASURABLE_SCALING_EQ ← prove
   r"!s:real^N->bool c. measurable (IMAGE (\x. c % x) s) <=>
                      c = &0 \/ measurable s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [MEASURABLE_SING, MEASURABLE_EMPTY],
      EQ_TAC THEN REWRITE_TAC [MEASURABLE_SCALING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP MEASURABLE_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let MEASURABLE_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        measurable (IMAGE (\x. m % x + c) s) <=> m = &0 \/ measurable s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, MEASURABLE_TRANSLATION_EQ,
                 MEASURABLE_SCALING_EQ, IMAGE_o])

  let MEASURABLE_AFFINITY ← prove
   r"!s m c:real^N. measurable s ==> measurable (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [MEASURABLE_AFFINITY_EQ])

  let MEASURE_SCALING ← prove
   r"!s c. measurable s
         ==> measure(IMAGE (\x:real^N. c % x) s) =
             (abs(c) pow dimindex(:N)) * measure s"
   (REWRITE_TAC [HAS_MEASURE_MEASURE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MEASURE_UNIQUE THEN ASM_SIMP_TAC [HAS_MEASURE_SCALING])

  let MEASURE_AFFINITY ← prove
   r"!s m c:real^N.
        measurable s
        ==> measure(IMAGE (\x. m % x + c) s) =
            abs m pow dimindex (:N) * measure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_UNIQUE THEN
    MATCH_MP_TAC HAS_MEASURE_AFFINITY THEN
    ASM_REWRITE_TAC [← GSYM HAS_MEASURE_MEASURE])

  let NEGLIGIBLE_SCALING ← prove
   r"!s c. negligible s ==> negligible (IMAGE (\x:real^N. c % x) s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM HAS_MEASURE_0] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real") o MATCH_MP HAS_MEASURE_SCALING) THEN
    REWRITE_TAC [REAL_MUL_RZERO])

  let NEGLIGIBLE_SCALING_EQ ← prove
   r"!s:real^N->bool c.
        negligible (IMAGE (\x. c % x) s) <=> c = &0 \/ negligible s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [NEGLIGIBLE_SING, NEGLIGIBLE_EMPTY],
      EQ_TAC THEN REWRITE_TAC [NEGLIGIBLE_SCALING] THEN
      DISCH_THEN (MP_TAC o
        SPEC (← q r"inv(c):real") o MATCH_MP NEGLIGIBLE_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let NEGLIGIBLE_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        negligible (IMAGE (\x. m % x + c) s) <=>
        m = &0 \/ negligible s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, NEGLIGIBLE_TRANSLATION_EQ,
                 NEGLIGIBLE_SCALING_EQ, IMAGE_o])

  let NEGLIGIBLE_AFFINITY ← prove
   r"!s m c:real^N.
     negligible s ==> negligible (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [NEGLIGIBLE_AFFINITY_EQ])

  let NOT_MEASURABLE_UNIV ← prove
   r"~measurable(:real^N)"
   (DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"&2") o MATCH_MP MEASURE_SCALING) THEN
    MATCH_MP_TAC (← REAL_RING
     (← q r"a = b /\ ~(b = &0) /\ ~(c = &1) ==> a = c * b ==> F")) THEN
    REWRITE_TAC [REAL_POW_EQ_1] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_SIMP_TAC [MEASURABLE_MEASURE_EQ_0, NOT_NEGLIGIBLE_UNIV] THEN
    SIMP_TAC [DIMINDEX_GE_1, LE_1] THEN AP_TERM_TAC THEN
    MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [IN_UNIV] THEN
    X_GEN_TAC (← q r"x:real^N") THEN EXISTS_TAC (← q r"inv(&2) % x:real^N") THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [VECTOR_MUL_LID])

  pure { HAS_MEASURE_TRANSLATION, NEGLIGIBLE_TRANSLATION, HAS_MEASURE_TRANSLATION_EQ,
         MEASURE_TRANSLATION, NEGLIGIBLE_TRANSLATION_REV, NEGLIGIBLE_TRANSLATION_EQ,
         MEASURABLE_TRANSLATION_EQ, MEASURABLE_TRANSLATION, HAS_MEASURE_SCALING,
         HAS_MEASURE_SCALING_EQ, MEASURABLE_SCALING, MEASURABLE_SCALING_EQ,
         MEASURABLE_AFFINITY_EQ, MEASURABLE_AFFINITY, MEASURE_SCALING, MEASURE_AFFINITY,
         NEGLIGIBLE_SCALING, NEGLIGIBLE_SCALING_EQ, NEGLIGIBLE_AFFINITY_EQ,
         NEGLIGIBLE_AFFINITY, NOT_MEASURABLE_UNIV }

/- ------------------------------------------------------------------------- -/
/- Measurability of countable unions and intersections of various kinds.  -/
/- (measure.ml 1438-1846)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSF where
  HAS_MEASURE_NESTED_UNIONS : thm
  MEASURABLE_NESTED_UNIONS : thm
  HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS : thm
  NEGLIGIBLE_COUNTABLE_UNIONS_GEN : thm
  HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED : thm
  MEASURABLE_COUNTABLE_UNIONS_BOUNDED : thm
  MEASURE_COUNTABLE_UNIONS_LE_STRONG : thm
  MEASURE_COUNTABLE_UNIONS_LE : thm
  MEASURABLE_COUNTABLE_UNIONS_STRONG : thm
  MEASURABLE_COUNTABLE_UNIONS : thm
  MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN : thm
  MEASURE_COUNTABLE_UNIONS_LE_GEN : thm
  MEASURABLE_COUNTABLE_INTERS : thm
  MEASURABLE_COUNTABLE_INTERS_GEN : thm
  MEASURE_COUNTABLE_UNIONS_APPROACHABLE : thm
  HAS_MEASURE_NESTED_INTERS : thm
  INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSF [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) : ExceptT String IO MSF := do
  -- @@SCOPE BEGIN
  let { INTEGRAL_MEASURE_UNIV, measurable, MEASURABLE_INTEGRABLE, MEASURABLE_INTERVAL,
        MEASURE_INTEGRAL_UNIV, MEASURE_POS_LE, MEASURE_SUBSET, MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE, MEASURABLE_DIFF, MEASURABLE_EMPTY,
        MEASURABLE_UNIONS, MEASURE_DIFF_SUBSET, MEASURE_EMPTY,
        MEASURE_NEGLIGIBLE_UNIONS_IMAGE, .. } := BMSB
  let { MEASURE_UNIONS_LE, MEASURE_UNIONS_LE_IMAGE, .. } := BMSC
  let { CONJ_ASSOC, CONJ_SYM, EMPTY_SUBSET, EQ_IMP, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE,
        EXISTS_SUBSET_IMAGE, EXTENSION, FINITE_EMPTY, FINITE_IMAGE, FINITE_NUMSEG,
        FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_SUBSET_IMAGE, FUN_EQ_THM, IMAGE_SUBSET,
        IMP_CONJ, IMP_IMP, IN_DIFF, INTER_UNIV, INTERS_GSPEC, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTERS, IN_NUMSEG, IN_UNIONS, IN_UNIV, LE_REFL, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, NOT_EXISTS_THM, NUMSEG_CLAUSES, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_REFL, REAL_LE_TRANS, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_POS, SIMPLE_IMAGE, SUBSET, SUBSET_DIFF, SUBSET_EMPTY, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { numseg, o_DEF, real_abs, SUBSET_UNIV, SWAP_EXISTS_THM, UNIONS_0, UNIONS_GSPEC,
        UNIONS_IMAGE, UNWIND_THM2, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_SUB, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { LIM_CONST, LIM_SEQUENTIALLY, LIM_SUB, .. } := D.ig.dv.dg.pt.cvx.top4
  let { bounded, OPEN_UNIV, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE,
        SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { EXISTS_IN_UNIONS, .. } := D.ig.dv.dg.pt.qses
  let { COUNTABLE_AS_IMAGE, .. } := D.ig.dv.dg.qcard
  let { LE_0, SUBSET_NUMSEG, SUBSET_UNIONS, TRANSITIVE_STEPWISE_LE, .. } :=
        D.ig.dv.dg.qsession
  let { LIFT_SUM, .. } := D.ig.dv.dg.qvec
  let { LIM_EVENTUALLY, sums, .. } := D.ig.dv.qtopology2
  let { FINITE_NUMSEG_LE, .. } := D.ig.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, LIM_DROP_UBOUND,
        OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, .. } := D.ig.qtopology
  let { DIST_REAL, .. } := D.ig.qvec
  let { INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE, MONOTONE_CONVERGENCE_INCREASING,
        NEGLIGIBLE_COUNTABLE_UNIONS, NEGLIGIBLE_EMPTY, NEGLIGIBLE_SUBSET, .. } :=
        D.qintegration3
  let { FROM_0, .. } := D.qmisc
  let { DIFF_INTERS, IN_NUMSEG_0, TRANSITIVE_STEPWISE_LE_EQ, .. } := D.qsession
  -- @@SCOPE END

  let HAS_MEASURE_NESTED_UNIONS ← prove
   r"!s:num->real^N->bool B.
        (!n. measurable(s n)) /\
        (!n. measure(s n) <= B) /\
        (!n. s(n) SUBSET s(SUC n))
        ==> measurable(UNIONS { s(n) | n IN (:num) }) /\
            ((\n. lift(measure(s n)))
                  --> lift(measure(UNIONS { s(n) | n IN (:num) })))
            sequentially"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b /\ (b ==> c))")] THEN
    SIMP_TAC [MEASURE_INTEGRAL_UNIV, LIFT_DROP] THEN
    REWRITE_TAC [MEASURABLE_INTEGRABLE] THEN
    STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"b /\ c ==> b /\ (b ==> c)")) THEN
    MATCH_MP_TAC MONOTONE_CONVERGENCE_INCREASING THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REPEAT GEN_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      REWRITE_TAC [DROP_VEC, REAL_POS, REAL_LE_REFL] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN COND_CASES_TAC THENL
       [MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_UNIONS]) THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [EXISTS_IN_IMAGE] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (MP_TAC (← PART_MATCH (rand o rand) TRANSITIVE_STEPWISE_LE_EQ (concl th)))) THEN
        ASM_REWRITE_TAC [SUBSET_TRANS, SUBSET_REFL] THEN ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [IN_UNIONS]) THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [EXISTS_IN_IMAGE] THEN
        SIMP_TAC [NOT_EXISTS_THM, IN_UNIV, LIM_CONST]],
       RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEASURABLE_INTEGRABLE]) THEN
       ASM_SIMP_TAC [INTEGRAL_MEASURE_UNIV] THEN
       REWRITE_TAC [bounded, SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
       EXISTS_TAC (← q r"B:real") THEN REWRITE_TAC [IN_UNIV, NORM_LIFT] THEN
       REWRITE_TAC [real_abs] THEN ASM_MESON_TAC [MEASURE_POS_LE]])

  let MEASURABLE_NESTED_UNIONS ← prove
   r"!s:num->real^N->bool B.
        (!n. measurable(s n)) /\
        (!n. measure(s n) <= B) /\
        (!n. s(n) SUBSET s(SUC n))
        ==> measurable(UNIONS { s(n) | n IN (:num) })"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_MEASURE_NESTED_UNIONS) THEN
    SIMP_TAC [])

  let HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS ← prove
   r"!s:num->real^N->bool B.
        (!n. measurable(s n)) /\
        (!m n. ~(m = n) ==> negligible(s m INTER s n)) /\
        (!n. sum (0..n) (\k. measure(s k)) <= B)
        ==> measurable(UNIONS { s(n) | n IN (:num) }) /\
            ((\n. lift(measure(s n))) sums
             lift(measure(UNIONS { s(n) | n IN (:num) }))) (from 0)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. UNIONS (IMAGE s (0..n)):real^N->bool", ← q r"B:real"]
                 HAS_MEASURE_NESTED_UNIONS) THEN
    REWRITE_TAC [sums, FROM_0, INTER_UNIV] THEN
    SUBGOAL_THEN
     (← q r"!n. (UNIONS (IMAGE s (0..n)):real^N->bool) has_measure
        (sum(0..n) (\k. measure(s k)))")
    MP_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC HAS_MEASURE_NEGLIGIBLE_UNIONS_IMAGE THEN
      ASM_SIMP_TAC [FINITE_NUMSEG],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (ASSUME_TAC th THEN
        ASSUME_TAC (← GEN (← q r"n:num")
          (← MATCH_MP MEASURE_UNIQUE (← SPEC (← q r"n:num") th))))) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [measurable], ALL_TAC] THEN
      GEN_TAC THEN MATCH_MP_TAC SUBSET_UNIONS THEN
      MATCH_MP_TAC IMAGE_SUBSET THEN
      REWRITE_TAC [SUBSET, IN_NUMSEG] THEN ARITH_TAC,
      ALL_TAC] THEN
    SIMP_TAC [LIFT_SUM, FINITE_NUMSEG, o_DEF] THEN
    SUBGOAL_THEN
     (← q r"UNIONS {UNIONS (IMAGE s (0..n)) | n IN (:num)}:real^N->bool =
    UNIONS (IMAGE s (:num))")
     (fun th => REWRITE_TAC [th] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
                REWRITE_TAC []) THEN
    GEN_REWRITE_TAC I [EXTENSION] THEN X_GEN_TAC (← q r"x:real^N") THEN
    REWRITE_TAC [IN_UNIONS] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_IN_UNIONS, IN_UNIV] THEN
    REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [IN_NUMSEG, LE_0] THEN MESON_TAC [LE_REFL])

  let NEGLIGIBLE_COUNTABLE_UNIONS_GEN ← prove
   r"!f. COUNTABLE f /\ (!s:real^N->bool. s IN f ==> negligible s)
       ==> negligible(UNIONS f)"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0, NEGLIGIBLE_EMPTY] THEN
    MP_TAC (← ISPEC (← q r"f:(real^N->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, FORALL_IN_IMAGE, IN_UNIV] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN ASM_REWRITE_TAC [])

  let HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED ← prove
   r"!s:num->real^N->bool.
        (!n. measurable(s n)) /\
        (!m n. ~(m = n) ==> negligible(s m INTER s n)) /\
        bounded(UNIONS { s(n) | n IN (:num) })
        ==> measurable(UNIONS { s(n) | n IN (:num) }) /\
            ((\n. lift(measure(s n))) sums
             lift(measure(UNIONS { s(n) | n IN (:num) }))) (from 0)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    MATCH_MP_TAC HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS THEN
    EXISTS_TAC (← q r"measure(interval[a:real^N,b])") THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(UNIONS (IMAGE (s:num->real^N->bool) (0..n)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC MEASURE_NEGLIGIBLE_UNIONS_IMAGE THEN
      ASM_SIMP_TAC [FINITE_NUMSEG],
      MATCH_MP_TAC MEASURE_SUBSET THEN REWRITE_TAC [MEASURABLE_INTERVAL] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE],
        ASM SET_TAC []]])

  let MEASURABLE_COUNTABLE_UNIONS_BOUNDED ← prove
   r"!s:num->real^N->bool.
        (!n. measurable(s n)) /\
        bounded(UNIONS { s(n) | n IN (:num) })
        ==> measurable(UNIONS { s(n) | n IN (:num) })"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"UNIONS { s(n):real^N->bool | n IN (:num) } =
    UNIONS { UNIONS {s(m) | m IN 0..n} | n IN (:num)}")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC I [EXTENSION] THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2, IN_UNIONS, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_NUMSEG, IN_UNIV, LE_0] THEN MESON_TAC [LE_REFL],
      MATCH_MP_TAC MEASURABLE_NESTED_UNIONS THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"measure(interval[a:real^N,b])") THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG],
        DISCH_TAC] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_REWRITE_TAC [MEASURABLE_INTERVAL] THEN ASM SET_TAC [],
        GEN_TAC THEN REWRITE_TAC [NUMSEG_CLAUSES, LE_0] THEN SET_TAC []]])

  let MEASURE_COUNTABLE_UNIONS_LE_STRONG ← prove
   r"!d:num->(real^N->bool) B.
        (!n. measurable(d n)) /\
        (!n. measure(UNIONS {d k | k <= n}) <= B)
        ==> measurable(UNIONS {d n | n IN (:num)}) /\
            measure(UNIONS {d n | n IN (:num)}) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. UNIONS {(d:num->(real^N->bool)) k | k IN (0..n)}",
                      ← q r"B:real"]
           HAS_MEASURE_NESTED_UNIONS) THEN REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"UNIONS {UNIONS {d k | k IN (0..n)} | n IN (:num)} =
                UNIONS {d n:real^N->bool | n IN (:num)}")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC, IN_UNIV, IN_NUMSEG, LE_0] THEN
      MESON_TAC [LE_REFL],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC MEASURABLE_UNIONS THEN
        SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE],
        ASM_REWRITE_TAC [IN_NUMSEG, LE_0],
        GEN_TAC THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
        MATCH_MP_TAC SUBSET_UNIONS THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET_NUMSEG] THEN ARITH_TAC],
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM (← CONJUNCT2 LIFT_DROP)] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_UBOUND) THEN
      EXISTS_TAC (← q r"\n. lift(measure(UNIONS {d k | k IN 0..n} :real^N->bool))") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"0") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [LIFT_DROP, IN_NUMSEG, LE_0]])

  let MEASURE_COUNTABLE_UNIONS_LE ← prove
   r"!d:num->(real^N->bool) B.
        (!n. measurable(d n)) /\
        (!n. sum(0..n) (\k. measure(d k)) <= B)
        ==> measurable(UNIONS {d n | n IN (:num)}) /\
            measure(UNIONS {d n | n IN (:num)}) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"n:num") THEN
    MP_TAC (← ISPECL [← q r"0..n", ← q r"d:num->real^N->bool"] MEASURE_UNIONS_LE_IMAGE) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num"))) THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, numseg, LE_0, IN_ELIM_THM] THEN
    MESON_TAC [REAL_LE_TRANS])

  let MEASURABLE_COUNTABLE_UNIONS_STRONG ← prove
   r"!s:num->real^N->bool B.
        (!n. measurable(s n)) /\
        (!n. measure(UNIONS {s k | k <= n}) <= B)
        ==> measurable(UNIONS { s(n) | n IN (:num) })"
   (MESON_TAC [MEASURE_COUNTABLE_UNIONS_LE_STRONG, REAL_LE_REFL])

  let MEASURABLE_COUNTABLE_UNIONS ← prove
   r"!s:num->real^N->bool B.
        (!n. measurable(s n)) /\
        (!n. sum (0..n) (\k. measure(s k)) <= B)
        ==> measurable(UNIONS { s(n) | n IN (:num) })"
   (MESON_TAC [MEASURE_COUNTABLE_UNIONS_LE, REAL_LE_REFL])

  let MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN ← prove
   r"!D B. COUNTABLE D /\
         (!d:real^N->bool. d IN D ==> measurable d) /\
         (!D'. D' SUBSET D /\ FINITE D' ==> measure(UNIONS D') <= B)
         ==> measurable(UNIONS D) /\ measure(UNIONS D) <= B"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"D:(real^N->bool)->bool = {}") THENL
     [ASM_SIMP_TAC [UNIONS_0, MEASURABLE_EMPTY, SUBSET_EMPTY] THEN
      MESON_TAC [FINITE_EMPTY],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MP_TAC (← ISPEC (← q r"D:(real^N->bool)->bool") COUNTABLE_AS_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real^N->bool") SUBST1_TAC) THEN
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, FORALL_SUBSET_IMAGE] THEN
      REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN REPEAT DISCH_TAC THEN
      ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
      MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{k:num | k <= n}")) THEN
      SIMP_TAC [FINITE_NUMSEG_LE, FINITE_IMAGE] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
      REPLICATE_TAC 3 AP_TERM_TAC THEN SET_TAC []])

  let MEASURE_COUNTABLE_UNIONS_LE_GEN ← prove
   r"!D B. COUNTABLE D /\
         (!d:real^N->bool. d IN D ==> measurable d) /\
         (!D'. D' SUBSET D /\ FINITE D' ==> sum D' (\d. measure d) <= B)
         ==> measurable(UNIONS D) /\ measure(UNIONS D) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"D':(real^N->bool)->bool") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"D':(real^N->bool)->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC MEASURE_UNIONS_LE THEN ASM SET_TAC [])

  let MEASURABLE_COUNTABLE_INTERS ← prove
   r"!s:num->real^N->bool.
        (!n. measurable(s n))
        ==> measurable(INTERS { s(n) | n IN (:num) })"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"INTERS { s(n):real^N->bool | n IN (:num) } =
                s 0 DIFF (UNIONS {s 0 DIFF s n | n IN (:num)})")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_INTERS, IN_DIFF, IN_UNIONS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MEASURABLE_COUNTABLE_UNIONS_STRONG THEN
    EXISTS_TAC (← q r"measure(s 0:real^N->bool)") THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF, LE_0] THEN
    GEN_TAC THEN MATCH_MP_TAC MEASURE_SUBSET THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, IN_ELIM_THM, IN_DIFF] THEN
      MESON_TAC [IN_DIFF]] THEN
    ONCE_REWRITE_TAC [← GSYM IN_NUMSEG_0] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FINITE_IMAGE, FINITE_NUMSEG,
                  MEASURABLE_DIFF, MEASURABLE_UNIONS])

  let MEASURABLE_COUNTABLE_INTERS_GEN ← prove
   r"!D. COUNTABLE D /\ ~(D = {}) /\
       (!d:real^N->bool. d IN D ==> measurable d)
       ==> measurable(INTERS D)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"D:(real^N->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, FORALL_IN_IMAGE, IN_UNIV] THEN
    GEN_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
    ONCE_REWRITE_TAC [← GSYM SIMPLE_IMAGE] THEN
    MATCH_MP_TAC MEASURABLE_COUNTABLE_INTERS THEN ASM SET_TAC [])

  let MEASURE_COUNTABLE_UNIONS_APPROACHABLE ← prove
   r"!D B e.
        COUNTABLE D /\
        (!d. d IN D ==> measurable d) /\
        (!D'. D' SUBSET D /\ FINITE D' ==> measure(UNIONS D') <= B) /\
        &0 < e
        ==> ?D'. D' SUBSET D /\ FINITE D' /\
                 measure(UNIONS D) - e < measure(UNIONS D':real^N->bool)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"D:(real^N->bool)->bool = {}") THENL
     [DISCH_TAC THEN EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
      ASM_REWRITE_TAC [EMPTY_SUBSET, FINITE_EMPTY, UNIONS_0, MEASURE_EMPTY] THEN
      ASM_REAL_ARITH_TAC,
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MP_TAC (← ISPEC (← q r"D:(real^N->bool)->bool") COUNTABLE_AS_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real^N->bool") SUBST1_TAC) THEN
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, EXISTS_SUBSET_IMAGE,
                   FORALL_SUBSET_IMAGE] THEN
      REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN REPEAT DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\n. UNIONS(IMAGE (d:num->real^N->bool) {k | k <= n})",
        ← q r"B:real"] HAS_MEASURE_NESTED_UNIONS) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [MEASURABLE_UNIONS, FORALL_IN_IMAGE, FINITE_IMAGE,
                      FINITE_NUMSEG_LE, IN_ELIM_THM] THEN
        GEN_TAC THEN MATCH_MP_TAC SUBSET_UNIONS THEN
        MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"UNIONS {UNIONS (IMAGE d {k | k <= n}) | n IN (:num)}:real^N->bool =
      UNIONS (IMAGE d (:num))")
      SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_IMAGE] THEN REWRITE_TAC [UNIONS_GSPEC] THEN
        REWRITE_TAC [IN_UNIV, IN_ELIM_THM, EXTENSION] THEN
        MESON_TAC [LE_REFL],
        ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [LIM_SEQUENTIALLY, DIST_REAL, ← GSYM drop, LIFT_DROP] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
      REWRITE_TAC [LE_REFL] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"{k:num | k <= n}") THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LE] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"abs(x - u) < e /\ &0 < e ==> u - e < x")]])

  let HAS_MEASURE_NESTED_INTERS ← prove
   r"!s:num->real^N->bool.
        (!n. measurable(s n)) /\
        (!n. s(SUC n) SUBSET s(n))
        ==> measurable(INTERS {s n | n IN (:num)}) /\
            ((\n. lift(measure (s n))) -->
                  lift(measure (INTERS {s n | n IN (:num)}))) sequentially"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\n. (s:num->real^N->bool) 0 DIFF s n", ← q r"measure(s 0:real^N->bool)"]
          HAS_MEASURE_NESTED_UNIONS) THEN
    ASM_SIMP_TAC [MEASURABLE_DIFF] THEN ANTS_TAC THENL
     [CONJ_TAC THEN X_GEN_TAC (← q r"n:num") THENL
       [MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_DIFF, SUBSET_DIFF] THEN SET_TAC [],
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num"))) THEN SET_TAC []],
      SUBGOAL_THEN
       (← q r"UNIONS {s 0 DIFF s n | n IN (:num)} =
      s 0 DIFF INTERS {s n :real^N->bool | n IN (:num)}")
       (fun th => REWRITE_TAC [th])
      THENL [REWRITE_TAC [DIFF_INTERS] THEN SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"measurable(s 0 DIFF (s 0 DIFF INTERS {s n | n IN (:num)})
                   :real^N->bool)")
        MP_TAC THENL [ASM_SIMP_TAC [MEASURABLE_DIFF], ALL_TAC] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
         (← q r"t SUBSET s ==> s DIFF (s DIFF t) = t")) THEN
        REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM] THEN SET_TAC [],

        MP_TAC (← ISPECL [← q r"sequentially", ← q r"lift(measure(s 0:real^N->bool))"]
          LIM_CONST) THEN REWRITE_TAC [IMP_IMP] THEN
        DISCH_THEN (MP_TAC o MATCH_MP LIM_SUB) THEN
        REWRITE_TAC [← GSYM LIFT_SUB] THEN MATCH_MP_TAC EQ_IMP THEN
        AP_THM_TAC THEN BINOP_TAC THEN REWRITE_TAC [LIFT_EQ, FUN_EQ_THM] THEN
        REPEAT GEN_TAC THEN
        REWRITE_TAC [← REAL_ARITH (← q r"s - m:real = n <=> m = s - n")] THEN
        MATCH_MP_TAC MEASURE_DIFF_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_COUNTABLE_INTERS] THENL
         [ALL_TAC, SET_TAC []] THEN
        MP_TAC (← ISPEC (← q r"\m n:num. (s n :real^N->bool) SUBSET (s m)")
            TRANSITIVE_STEPWISE_LE) THEN
        ASM_REWRITE_TAC [] THEN
        ANTS_TAC THENL [SET_TAC [], MESON_TAC [LE_0]]]])

  let INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE_ALT ← prove
   r"!f:real^M->real^N.
        (!a b. (f has_integral (vec 0)) (interval[a,b]))
        ==> negligible{x | ~(f x = vec 0)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:real^M)") OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) THEN
    REWRITE_TAC [OPEN_UNIV, SUBSET_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"UNIONS {{x | x IN d /\ ~((f:real^M->real^N) x = vec 0)} |
                      d IN D}") THEN
    CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []] THEN
    MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS_GEN THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"d:real^M->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real^M->bool")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE THEN
    ASM_REWRITE_TAC [])

  pure { HAS_MEASURE_NESTED_UNIONS, MEASURABLE_NESTED_UNIONS,
         HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS, NEGLIGIBLE_COUNTABLE_UNIONS_GEN,
         HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS_BOUNDED,
         MEASURABLE_COUNTABLE_UNIONS_BOUNDED, MEASURE_COUNTABLE_UNIONS_LE_STRONG,
         MEASURE_COUNTABLE_UNIONS_LE, MEASURABLE_COUNTABLE_UNIONS_STRONG,
         MEASURABLE_COUNTABLE_UNIONS, MEASURE_COUNTABLE_UNIONS_LE_STRONG_GEN,
         MEASURE_COUNTABLE_UNIONS_LE_GEN, MEASURABLE_COUNTABLE_INTERS,
         MEASURABLE_COUNTABLE_INTERS_GEN, MEASURE_COUNTABLE_UNIONS_APPROACHABLE,
         HAS_MEASURE_NESTED_INTERS, INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE_ALT }

/- ------------------------------------------------------------------------- -/
/- Measurability of compact and bounded open sets.  (measure.ml 1847-2121) -/
/- ------------------------------------------------------------------------- -/

structure MSG where
  MEASURABLE_COMPACT : thm
  MEASURABLE_OPEN : thm
  MEASURE_OPEN_POS_LT : thm
  MEASURE_OPEN_POS_LT_EQ : thm
  MEASURABLE_CLOSURE : thm
  MEASURABLE_INTERIOR : thm
  MEASURABLE_FRONTIER : thm
  MEASURE_FRONTIER : thm
  MEASURE_CLOSURE : thm
  MEASURE_INTERIOR : thm
  MEASURABLE_JORDAN : thm
  HAS_MEASURE_ELEMENTARY : thm
  MEASURABLE_ELEMENTARY : thm
  MEASURE_ELEMENTARY : thm
  MEASURABLE_INTER_INTERVAL : thm
  MEASURABLE_INSIDE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSG [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSF : MSF) : ExceptT String IO MSG := do
  -- @@SCOPE BEGIN
  let { has_measure, HAS_MEASURE_INTERVAL, measurable, MEASURABLE_INTER,
        MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_UNIQUE, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_MEASURE_POS_LT, MEASURABLE_UNIONS, MEASURE_DIFF_SUBSET,
        MEASURE_EMPTY, MEASURE_EQ_0, MEASURE_NEGLIGIBLE_SYMDIFF, .. } := BMSB
  let { MEASURABLE_INNER_OUTER, OPEN_NOT_NEGLIGIBLE, .. } := BMSC
  let { MEASURABLE_COUNTABLE_INTERS, .. } := BMSF
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, FINITE_IMAGE, FINITE_NUMSEG, FINITE_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, IN_NUMSEG, IN_UNIONS, IN_UNIV,
        LAMBDA_BETA, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_SUB,
        REAL_ADD_RDISTRIB, REAL_ARCH, REAL_ARCH_POW_INV, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LE_LDIV_EQ, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01,
        REAL_LT_DIV, REAL_LT_POW2, REAL_LT_RDIV_EQ, REAL_LT_REFL, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_SYM, REAL_OF_NUM_LT,
        REAL_POW_INV, REAL_SUB_REFL, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, ..
        } := D.ig.dv.dg.pt.cvx.core5
  let { o_THM, real_div, real_pow, SUM_BOUND, SWAP_EXISTS_THM, UNWIND_THM2, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_CLOSURE, BOUNDED_DIFF, BOUNDED_POS, CLOSED_CLOSURE, CLOSED_INTERVAL, .. } :=
        D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        .. } := D.ig.dv.dg.pt.cvx.top2
  let { INTERIOR_SUBSET, .. } := D.ig.dv.dg.pt.cvx.top4
  let { closed, frontier, OPEN_INTERIOR, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.ig.dv.dg.pt.qses
  let { FINITE_INTSEG, .. } := D.ig.dv.dg.pt.qfloor
  let { BOUNDED_INTERIOR, BOUNDED_INTERVAL, .. } := D.ig.dv.dg.pt.qtop
  let { REAL_ABS_POW, .. } := D.ig.dv.dg.qsession
  let { LIFT_SUM, .. } := D.ig.dv.dg.qvec
  let { open_def, .. } := D.ig.dv.qtopology2
  let { FLOOR, INTEGER_CLOSED, .. } := D.ig.qfloor
  let { REAL_ABS_0, .. } := D.ig.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.ig.qtopology
  let { DIVISION_OF_FINITE, .. } := D.qintegration1
  let { HAS_INTEGRAL_COMBINE_DIVISION, .. } := D.qintegration2
  let { division_of, NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { FLOOR_FRAC, REAL_LE_REVERSE_INTEGERS, REAL_LT_INTEGERS, .. } := D.qfloor
  let { BOUNDED_INSIDE, OPEN_INSIDE, .. } := D.qpaths
  let { FINITE_CART, .. } := D.qsession
  let { CLOSED_DIFF, .. } := D.qtopology1
  -- @@SCOPE END

  let MEASURABLE_COMPACT ← (do
    let lemma ← prove
     r"!f s:real^N->bool.
          (!n. FINITE(f n)) /\
          (!n. s SUBSET UNIONS(f n)) /\
          (!x. ~(x IN s) ==> ?n. ~(x IN UNIONS(f n))) /\
          (!n a. a IN f(SUC n) ==> ?b. b IN f(n) /\ a SUBSET b) /\
          (!n a. a IN f(n) ==> measurable a)
          ==> measurable s"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!n. UNIONS(f(SUC n):(real^N->bool)->bool) SUBSET UNIONS(f n)")
      ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"s = INTERS { UNIONS(f n) | n IN (:num) }:real^N->bool")
      SUBST1_TAC THENL
       [ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
        REWRITE_TAC [SUBSET, IN_INTERS, FORALL_IN_IMAGE, IN_UNIV] THEN
        REWRITE_TAC [IN_IMAGE] THEN ASM SET_TAC [],
        MATCH_MP_TAC MEASURABLE_COUNTABLE_INTERS THEN
        ASM_REWRITE_TAC [] THEN GEN_TAC THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ASM_MESON_TAC []])
    prove
     r"!s:real^N->bool. compact s ==> measurable s"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
      EXISTS_TAC
       (← q r"\n. { k | ?u:real^N. (!i. 1 <= i /\ i <= dimindex(:N)
                              ==> integer(u$i)) /\
                  k = { x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                                       ==> u$i / &2 pow n <= x$i /\
                                           x$i < (u$i + &1) / &2 pow n } /\
                  ~(s INTER k = {})}") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        SUBGOAL_THEN
         (← q r"?N. !x:real^N i. x IN s /\ 1 <= i /\ i <= dimindex(:N)
                       ==> abs(x$i * &2 pow n) < &N")
        STRIP_ASSUME_TAC THENL
         [FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
          REWRITE_TAC [BOUNDED_POS, LEFT_IMP_EXISTS_THM] THEN
          X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
          MP_TAC (← SPEC (← q r"B * &2 pow n") (← MATCH_MP REAL_ARCH REAL_LT_01)) THEN
          MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [REAL_MUL_RID] THEN
          X_GEN_TAC (← q r"N:num") THEN
          REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_POW, REAL_ABS_NUM] THEN
          SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
          ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS, REAL_LET_TRANS],
          ALL_TAC] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC
         (← q r"IMAGE (\u. {x | !i. 1 <= i /\ i <= dimindex(:N)
                          ==> (u:real^N)$i <= (x:real^N)$i * &2 pow n /\
                              x$i * &2 pow n < u$i + &1})
            {u | !i. 1 <= i /\ i <= dimindex(:N) ==> integer (u$i) /\
                                                     abs(u$i) <= &N}") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_IMAGE THEN MATCH_MP_TAC FINITE_CART THEN
          REWRITE_TAC [← GSYM REAL_BOUNDS_LE, FINITE_INTSEG],
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
          X_GEN_TAC (← q r"l:real^N->bool") THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N") THEN
          STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN ASM_SIMP_TAC [] THEN
          X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
          MATCH_MP_TAC REAL_LE_REVERSE_INTEGERS THEN
          ASM_SIMP_TAC [INTEGER_CLOSED] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") MP_TAC) THEN
          REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"k:num"))) THEN
          ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"k:num"]) THEN
          ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC],
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        EXISTS_TAC (← q r"(lambda i. floor(&2 pow n * (x:real^N)$i)):real^N") THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b /\ c) /\ d <=> b /\ a /\ c /\ d")] THEN
        REWRITE_TAC [UNWIND_THM2] THEN SIMP_TAC [LAMBDA_BETA, FLOOR] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN EXISTS_TAC (← q r"x:real^N") THEN
        ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [REAL_MUL_SYM, FLOOR],
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_CLOSED) THEN
        REWRITE_TAC [closed, open_def] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPECL [← q r"inv(&2)", ← q r"e / &(dimindex(:N))"] REAL_ARCH_POW_INV) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_RDIV_EQ, REAL_OF_NUM_LT,
                      DIMINDEX_GE_1, ← ARITH_RULE (← q r"0 < x <=> 1 <= x")] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b /\ c) /\ d <=> b /\ a /\ c /\ d")] THEN
        REWRITE_TAC [UNWIND_THM2] THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
        X_GEN_TAC (← q r"u:real^N") THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC o CONJUNCT2) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N")
         (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
        REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"d < e ==> x <= d ==> x < e"))) THEN
        REWRITE_TAC [dist] THEN
        W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> x <= a ==> x <= b")) THEN
        GEN_REWRITE_TAC (funpow 3 RAND_CONV) [← GSYM CARD_NUMSEG_1] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN MATCH_MP_TAC SUM_BOUND THEN
        SIMP_TAC [FINITE_NUMSEG, IN_NUMSEG, VECTOR_SUB_COMPONENT] THEN
        X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num"))) THEN
        ASM_REWRITE_TAC [real_div, REAL_ADD_RDISTRIB] THEN
        REWRITE_TAC [REAL_MUL_LID, ← GSYM REAL_POW_INV] THEN REAL_ARITH_TAC,
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"a:real^N->bool"] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N")
         (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o SYM) ASSUME_TAC) THEN
        REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b /\ c) /\ d <=> b /\ a /\ c /\ d")] THEN
        REWRITE_TAC [UNWIND_THM2] THEN
        EXISTS_TAC (← q r"(lambda i. floor((u:real^N)$i / &2)):real^N") THEN
        ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, LAMBDA_BETA, FLOOR] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"~(s INTER a = {}) /\ a SUBSET b
                           ==> ~(s INTER b = {}) /\ a SUBSET b")) THEN
        ASM_REWRITE_TAC [] THEN EXPAND_TAC "a" THEN REWRITE_TAC [SUBSET] THEN
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM] THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [real_pow, real_div, REAL_INV_MUL, REAL_MUL_ASSOC] THEN
        REWRITE_TAC [← GSYM real_div] THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_POW2] THEN
        MP_TAC (← SPEC (← q r"(u:real^N)$k / &2") FLOOR) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"u / &2 < floor(u / &2) + &1 <=>
                            u < &2 * floor(u / &2) + &2")] THEN
        ASM_SIMP_TAC [REAL_LT_INTEGERS, INTEGER_CLOSED, FLOOR_FRAC] THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"a:real^N->bool", ← q r"u:real^N"] THEN
        DISCH_THEN (SUBST1_TAC o CONJUNCT1 o CONJUNCT2) THEN
        ONCE_REWRITE_TAC [MEASURABLE_INNER_OUTER] THEN
        GEN_TAC THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"interval(inv(&2 pow n) % u:real^N,
                         inv(&2 pow n) % (u + vec 1))") THEN
        EXISTS_TAC (← q r"interval[inv(&2 pow n) % u:real^N,
                         inv(&2 pow n) % (u + vec 1)]") THEN
        REWRITE_TAC [MEASURABLE_INTERVAL, MEASURE_INTERVAL] THEN
        ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_0] THEN
        REWRITE_TAC [SUBSET, IN_INTERVAL, IN_ELIM_THM] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, VECTOR_ADD_COMPONENT,
                      VEC_COMPONENT] THEN
        REAL_ARITH_TAC]))

  let MEASURABLE_OPEN ← prove
   r"!s:real^N->bool. bounded s /\ open s ==> measurable s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"s SUBSET t ==> s = t DIFF (t DIFF s)"))) THEN
    MATCH_MP_TAC MEASURABLE_DIFF THEN
    REWRITE_TAC [MEASURABLE_INTERVAL] THEN
    MATCH_MP_TAC MEASURABLE_COMPACT THEN
    SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_DIFF, BOUNDED_INTERVAL] THEN
    MATCH_MP_TAC CLOSED_DIFF THEN ASM_REWRITE_TAC [CLOSED_INTERVAL])

  let MEASURE_OPEN_POS_LT ← prove
   r"!s. open s /\ bounded s /\ ~(s = {}) ==> &0 < measure s"
   (MESON_TAC [OPEN_NOT_NEGLIGIBLE, MEASURABLE_MEASURE_POS_LT, MEASURABLE_OPEN])

  let MEASURE_OPEN_POS_LT_EQ ← prove
   r"!s. open s /\ bounded s ==> (&0 < measure s <=> ~(s = {}))"
   (MESON_TAC [MEASURE_OPEN_POS_LT, MEASURE_EMPTY, REAL_LT_REFL])

  let MEASURABLE_CLOSURE ← prove
   r"!s. bounded s ==> measurable(closure s)"
   (SIMP_TAC [MEASURABLE_COMPACT, COMPACT_EQ_BOUNDED_CLOSED, CLOSED_CLOSURE,
              BOUNDED_CLOSURE])

  let MEASURABLE_INTERIOR ← prove
   r"!s. bounded s ==> measurable(interior s)"
   (SIMP_TAC [MEASURABLE_OPEN, OPEN_INTERIOR, BOUNDED_INTERIOR])

  let MEASURABLE_FRONTIER ← prove
   r"!s:real^N->bool. bounded s ==> measurable(frontier s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier] THEN
    MATCH_MP_TAC MEASURABLE_DIFF THEN
    ASM_SIMP_TAC [MEASURABLE_CLOSURE, MEASURABLE_INTERIOR] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
    REWRITE_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET])

  let MEASURE_FRONTIER ← prove
   r"!s:real^N->bool.
        bounded s
        ==> measure(frontier s) = measure(closure s) - measure(interior s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier] THEN
    MATCH_MP_TAC MEASURE_DIFF_SUBSET THEN
    ASM_SIMP_TAC [MEASURABLE_CLOSURE, MEASURABLE_INTERIOR] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
    REWRITE_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET])

  let MEASURE_CLOSURE ← prove
   r"!s:real^N->bool.
        bounded s /\ negligible(frontier s)
        ==> measure(closure s) = measure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    ASM_SIMP_TAC [MEASURABLE_CLOSURE] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      NEGLIGIBLE_SUBSET)) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN
    REWRITE_TAC [frontier] THEN SET_TAC [])

  let MEASURE_INTERIOR ← prove
   r"!s:real^N->bool.
        bounded s /\ negligible(frontier s)
        ==> measure(interior s) = measure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    ASM_SIMP_TAC [MEASURABLE_INTERIOR] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      NEGLIGIBLE_SUBSET)) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN
    REWRITE_TAC [frontier] THEN SET_TAC [])

  let MEASURABLE_JORDAN ← prove
   r"!s:real^N->bool. bounded s /\ negligible(frontier s) ==> measurable s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [MEASURABLE_INNER_OUTER] THEN
    GEN_TAC THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"interior(s):real^N->bool") THEN
    EXISTS_TAC (← q r"closure(s):real^N->bool") THEN
    ASM_SIMP_TAC [MEASURABLE_INTERIOR, MEASURABLE_CLOSURE] THEN
    REWRITE_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET] THEN
    ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN
    ASM_SIMP_TAC [← GSYM MEASURE_FRONTIER, REAL_ABS_NUM, MEASURE_EQ_0])

  let HAS_MEASURE_ELEMENTARY ← prove
   r"!d s. d division_of s ==> s has_measure (sum d content)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_measure] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [LIFT_SUM] THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE_DIVISION THEN
    ASM_REWRITE_TAC [o_THM] THEN REWRITE_TAC [← GSYM has_measure] THEN
    ASM_MESON_TAC [HAS_MEASURE_INTERVAL, division_of])

  let MEASURABLE_ELEMENTARY ← prove
   r"!d s. d division_of s ==> measurable s"
   (REWRITE_TAC [measurable] THEN MESON_TAC [HAS_MEASURE_ELEMENTARY])

  let MEASURE_ELEMENTARY ← prove
   r"!d s. d division_of s ==> measure s = sum d content"
   (MESON_TAC [HAS_MEASURE_ELEMENTARY, MEASURE_UNIQUE])

  let MEASURABLE_INTER_INTERVAL ← prove
   r"!s a b:real^N. measurable s ==> measurable (s INTER interval[a,b])"
   (SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL])

  let MEASURABLE_INSIDE ← prove
   r"!s:real^N->bool. compact s ==> measurable(inside s)"
   (SIMP_TAC [MEASURABLE_OPEN, BOUNDED_INSIDE, COMPACT_IMP_CLOSED,
              OPEN_INSIDE, COMPACT_IMP_BOUNDED])

  pure { MEASURABLE_COMPACT, MEASURABLE_OPEN, MEASURE_OPEN_POS_LT, MEASURE_OPEN_POS_LT_EQ,
         MEASURABLE_CLOSURE, MEASURABLE_INTERIOR, MEASURABLE_FRONTIER, MEASURE_FRONTIER,
         MEASURE_CLOSURE, MEASURE_INTERIOR, MEASURABLE_JORDAN, HAS_MEASURE_ELEMENTARY,
         MEASURABLE_ELEMENTARY, MEASURE_ELEMENTARY, MEASURABLE_INTER_INTERVAL,
         MEASURABLE_INSIDE }

/- ------------------------------------------------------------------------- -/
/- We can split off part of a measurable set of chosen size.               -/
/- (measure.ml 2122-2361)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSH where
  PART_MEASURES : thm
  HALF_MEASURES : thm
  MULTIPART_MEASURES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSH [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) : ExceptT String IO MSH := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTER, MEASURABLE_INTERVAL, MEASURE_DISJOINT_UNION, MEASURE_INTERVAL,
        MEASURE_POS_LE, MEASURE_SUBSET, .. } := BMSA
  let { MEASURABLE_DIFF, MEASURABLE_EMPTY, MEASURABLE_SING, MEASURABLE_UNIONS,
        MEASURE_DIFF_SUBSET, MEASURE_DISJOINT_UNIONS_IMAGE, MEASURE_EMPTY, MEASURE_SING, ..
        } := BMSB
  let { MEASURE_LIMIT, .. } := BMSC
  let { CARD_CLAUSES, CARD_NUMSEG_1, CONJ_ASSOC, DIMINDEX_1, FINITE_IMAGE, FINITE_INSERT,
        FINITE_NUMSEG, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, IMP_IMP, INTER_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LAMBDA_BETA, LE_1, LE_REFL, MONO_EXISTS, PAIRWISE_INSERT,
        REAL_ABS_SUB, REAL_DIV_RMUL, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_NEG2, REAL_LE_SUB_LADD,
        REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUB, REAL_POS, REAL_SUB_RDISTRIB, REAL_SUB_REFL, REAL_WLOG_LE,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_DIFF,
        .. } := D.ig.dv.dg.pt.cvx.core5
  let { pairwise, real_abs, SUM_CONST, UNION_EMPTY, UNIONS_GSPEC, UNIONS_INSERT,
        UNIONS_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_SYM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, EXISTS_DROP, FORALL_LIFT, IN_INTERVAL, INTERVAL_SING, LIFT_CMUL,
        LIFT_DROP, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_ID, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_BALL_0, IN_INTERVAL_1, .. } := D.ig.dv.dg.pt.cvx.top4
  let { continuous_on, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, SELECT_CONV, SET_RULE, SET_TAC, ..
        } := D.ig.dv.dg.pt.cvx
  let { CARD_IMAGE_LE, DISJOINT_EMPTY, num_WF, .. } := D.ig.dv.dg.pt.qses
  let { VECTOR_NEG_0, .. } := D.ig.dv.dg.pt.qvec
  let { WF_num, WLOG_LT, .. } := D.ig.dv.dg.qsession
  let { CONTINUOUS_ON_CMUL, CONTINUOUS_ON_LIFT_POW, .. } := D.ig.dv.dg.qtopology1
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { PRODUCT_CONST, .. } := D.ig.qproducts
  let { PAIRWISE_IMAGE, REAL_ABS_BOUNDS, .. } := D.ig.qsession
  let { CONTINUOUS_ON_COMPARISON, .. } := D.ig.qtopology
  let { IVT_INCREASING_COMPONENT_ON_1, .. } := D.qconvex
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { CARD_NUMSEG_LT, FINITE_NUMSEG_LT, LT_TRANS, WF_REC, .. } := D.qsession
  let { vec, .. } := D.qvec
  -- @@SCOPE END

  let PART_MEASURES ← prove
   r"!s:real^N->bool m.
        measurable s /\ &0 <= m /\ m <= measure s
        ==> ?t u. DISJOINT t u /\ t UNION u = s /\
                  measurable t /\ measure t = m /\
                  measurable u /\ measure u = measure s - m"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP MEASURE_POS_LE) THEN
    ASM_CASES_TAC (← q r"measure(s:real^N->bool) = m") THENL
     [MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"{}:real^N->bool"] THEN
      ASM_REWRITE_TAC [UNION_EMPTY, DISJOINT_EMPTY, MEASURE_EMPTY] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [MEASURABLE_EMPTY] THEN
      REWRITE_TAC [REAL_SUB_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"measure(s:real^N->bool) - m"]
          MEASURE_LIMIT) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"\x. lift(measure(s INTER
           interval[--(lambda i. drop x):real^N,(lambda i. drop x)]))",
      ← q r"vec 0:real^1", ← q r"lift B", ← q r"m:real", ← q r"1"]
          IVT_INCREASING_COMPONENT_ON_1) THEN
    ASM_REWRITE_TAC [← GSYM drop, LIFT_DROP, DIMINDEX_1, LE_REFL, DROP_VEC] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN ANTS_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC, ← GSYM EXISTS_DROP] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") MP_TAC) THEN
      ABBREV_TAC (← q r"c:real^N = lambda i. b") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"s INTER interval[--c:real^N,c]") THEN
      EXISTS_TAC (← q r"s DIFF interval[--c:real^N,c]") THEN
      REPLICATE_TAC 2
       (MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
        CONJ_TAC THENL [SET_TAC [], DISCH_TAC]) THEN
      MP_TAC (← ISPECL
       [← q r"s INTER interval[--c:real^N,c]", ← q r"s DIFF interval[--c:real^N,c]"]
       MEASURE_DISJOINT_UNION) THEN
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTER, MEASURABLE_INTERVAL] THEN
      REAL_ARITH_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [INTERVAL_SING, ← GSYM vec, VECTOR_NEG_0] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"measure {vec 0:real^N}") THEN CONJ_TAC THENL
       [MATCH_MP_TAC MEASURE_SUBSET THEN
        ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_SING, MEASURE_SING] THEN
        REWRITE_TAC [INTER_SUBSET],
        REWRITE_TAC [MEASURE_SING] THEN ASM_REAL_ARITH_TAC],
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(measure (s INTER i) - measure s) < measure s - m
      ==> m <= measure(s INTER i:real^N->bool)")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      SIMP_TAC [SUBSET, IN_BALL_0, IN_INTERVAL, LAMBDA_BETA, VECTOR_NEG_COMPONENT,
                ← GSYM REAL_ABS_BOUNDS] THEN
      MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS, REAL_LT_IMP_LE]] THEN
    MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "N", ← qty "P")] CONTINUOUS_ON_COMPARISON) THEN
    EXISTS_TAC
     (← q r"\x. lift(measure(interval[--(lambda i. drop x):real^N,
                              (lambda i. drop x)]))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [MEASURE_INTERVAL, continuous_on] THEN
      REWRITE_TAC [CONTENT_CLOSED_INTERVAL_CASES] THEN
      SIMP_TAC [LAMBDA_BETA, VECTOR_NEG_COMPONENT] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      SIMP_TAC [← REAL_ARITH (← q r"--x <= x <=> &0 <= x"), LIFT_DROP] THEN
      SIMP_TAC [PRODUCT_CONST, CARD_NUMSEG_1, ← REAL_ARITH (← q r"x - --x = &2 * x"),
                FINITE_NUMSEG] THEN
      SUBGOAL_THEN
       (← q r"(\x. lift((&2 * drop x) pow (dimindex(:N)))) continuous_on (:real^1)")
      MP_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_LIFT_POW THEN
        SIMP_TAC [LIFT_CMUL, LIFT_DROP, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID],
        REWRITE_TAC [continuous_on, IN_UNIV] THEN MESON_TAC []],
      REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LE THEN
      CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [LIFT_DROP, IN_INTERVAL_1, DROP_VEC, DIST_LIFT] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DIFF_SUBSET o
        rand o lhand o snd) THEN
      W (MP_TAC o PART_MATCH (rand o rand) MEASURE_DIFF_SUBSET o
        funpowM 3 rand o snd) THEN
      ASM_SIMP_TAC [MEASURABLE_INTER, MEASURABLE_INTERVAL] THEN
      ASM_SIMP_TAC [SUBSET_INTERVAL, VECTOR_NEG_COMPONENT, LAMBDA_BETA,
        REAL_LE_NEG2, ← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")] THEN
      REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN
      ASM_SIMP_TAC [real_abs, MEASURE_POS_LE, MEASURABLE_DIFF, MEASURABLE_INTER,
                    MEASURABLE_INTERVAL] THEN
      MATCH_MP_TAC MEASURE_SUBSET THEN
      ASM_SIMP_TAC [MEASURABLE_DIFF, MEASURABLE_INTER, MEASURABLE_INTERVAL] THEN
      SET_TAC []])

  let HALF_MEASURES ← prove
   r"!s:real^N->bool.
        measurable s
        ==> ?t u. DISJOINT t u /\ t UNION u = s /\
                  measurable t /\ measure t = measure s / &2 /\
                  measurable u /\ measure u = measure s / &2"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"measure(s:real^N->bool) / &2"]
          PART_MEASURES) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP MEASURE_POS_LE) THEN ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let MULTIPART_MEASURES ← prove
   r"!s:real^N->bool n.
        measurable s /\ ~(n = 0)
        ==> ?f. FINITE f /\ CARD f <= n /\
                pairwise DISJOINT f /\ UNIONS f = s /\
                !t. t IN f
                    ==> t SUBSET s /\ measurable t /\
                         measure t = measure s / &n"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?k:num->real^N->bool.
        !m. k m = @t. t SUBSET s DIFF UNIONS {k i | i < m} /\
                      measurable t /\ measure t = measure s / &n")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← MATCH_MP WF_REC WF_num) THEN
      REPEAT STRIP_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
      REWRITE_TAC [UNIONS_GSPEC, ← MESON []
       (← q r"(?m:num. m < n /\ a IN f m) <=> ~(!m. m < n ==> ~(a IN f m))")] THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m. m < n - 1
        ==> k m SUBSET s DIFF UNIONS {k i | i < m} /\ measurable(k m) /\
            measure((k:num->real^N->bool) m) = measure(s:real^N->bool) / &n")
    MP_TAC THENL
     [MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"m:num") THEN
      FIRST_X_ASSUM (SUBST1_TAC o SPEC (← q r"m:num")) THEN
      REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN CONV_TAC SELECT_CONV THEN
      MP_TAC (← ISPECL [← q r"s DIFF UNIONS {(k:num->real^N->bool) i | i < m}",
                        ← q r"measure(s:real^N->bool) / &n"]
          PART_MEASURES) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [REAL_LE_DIV, REAL_POS, MEASURE_POS_LE],
        MATCH_MP_TAC MONO_EXISTS THEN STRIP_TAC THEN ASM SET_TAC []] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"p:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:num")) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ASM SET_TAC []],
        W (MP_TAC o PART_MATCH (lhand o rand)
          MEASURE_DIFF_SUBSET o rand o snd) THEN
        ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
         [CONJ_TAC THENL
           [MATCH_MP_TAC MEASURABLE_UNIONS THEN
            ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
            SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT, FORALL_IN_IMAGE],
            REWRITE_TAC [FORALL_IN_GSPEC]] THEN
          X_GEN_TAC (← q r"p:num") THEN REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:num")) THEN
          (ANTS_TAC THENL [ASM_ARITH_TAC, ASM SET_TAC []]),
          DISCH_THEN SUBST1_TAC] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
          rand o rand o snd) THEN
        REWRITE_TAC [FINITE_NUMSEG_LT, FORALL_IN_GSPEC] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON [LT_TRANS]
         (← q r"(!i. i < m /\ i < n - 1 ==> P i) ==> m < n - 1
        ==> (!i. i < m ==> P i)"))) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_SIMP_TAC [] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
        ANTS_TAC THENL
         [REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
          MATCH_MP_TAC WLOG_LT THEN
          REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
          MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
          REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
          DISCH_THEN SUBST1_TAC] THEN
        SIMP_TAC [SUM_CONST, FINITE_NUMSEG_LT, CARD_NUMSEG_LT] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1, REAL_SUB_RDISTRIB,
                      REAL_DIV_RMUL, REAL_LT_IMP_NZ, ← GSYM REAL_MUL_ASSOC] THEN
        REWRITE_TAC [← REAL_ARITH
          (← q r"s <= s * a - b * s <=> &0 <= s * (a - b - &1)")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_SIMP_TAC [MEASURE_POS_LE] THEN
        REWRITE_TAC [REAL_LE_SUB_LADD] THEN
        REWRITE_TAC [REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN ASM_ARITH_TAC],
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"0")) THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(s DIFF UNIONS(IMAGE k {m | m < n - 1})) INSERT
              (IMAGE (k:num->real^N->bool) {m | m < n - 1})") THEN
    REWRITE_TAC [FORALL_IN_INSERT, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    SIMP_TAC [FINITE_INSERT, FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
    REPEAT CONJ_TAC THENL
     [SIMP_TAC [CARD_CLAUSES, FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
      MATCH_MP_TAC (← ARITH_RULE
       (← q r"~(n = 0) /\ m <= n - 1 ==> (if p then m else SUC m) <= n")) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM CARD_NUMSEG_LT] THEN
      MATCH_MP_TAC CARD_IMAGE_LE THEN REWRITE_TAC [FINITE_NUMSEG_LT],
      REWRITE_TAC [PAIRWISE_INSERT] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [PAIRWISE_IMAGE] THEN
      REWRITE_TAC [pairwise, FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      MATCH_MP_TAC WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
      REWRITE_TAC [UNIONS_INSERT] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET s ==> (s DIFF t) UNION t = s")) THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET_DIFF],
      MATCH_MP_TAC MEASURABLE_DIFF THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MEASURABLE_UNIONS THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT, FORALL_IN_IMAGE] THEN
      ASM SET_TAC [],
      W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DIFF_SUBSET o lhand o snd) THEN
      ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC MEASURABLE_UNIONS THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT, FORALL_IN_IMAGE] THEN
        ASM SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"s - t = s / a <=> t = (&1 - inv a) * s")] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) MEASURE_DISJOINT_UNIONS_IMAGE o
        lhand o snd) THEN
      ASM_SIMP_TAC [FINITE_NUMSEG_LT, IN_ELIM_THM] THEN ANTS_TAC THENL
       [MATCH_MP_TAC WLOG_LT THEN RULE_ASSUM_TAC (REWRITE_RULE [UNIONS_GSPEC]) THEN
        ASM SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      SIMP_TAC [SUM_CONST, CARD_NUMSEG_LT, FINITE_NUMSEG_LT] THEN
      ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUB, LE_1] THEN
      FIRST_X_ASSUM (MP_TAC o
         GEN_REWRITE_RULE RAND_CONV [← GSYM REAL_OF_NUM_EQ]) THEN
      CONV_TAC (fun t => REAL_FIELD t),
      ASM SET_TAC []]])

  pure { PART_MEASURES, HALF_MEASURES, MULTIPART_MEASURES }

/- ------------------------------------------------------------------------- -/
/- A nice lemma for negligibility proofs: starlike sets.                    -/
/- (measure.ml 2362-2556)                                                   -/
/- ------------------------------------------------------------------------- -/

structure MSI where
  STARLIKE_NEGLIGIBLE_BOUNDED_MEASURABLE : thm
  STARLIKE_NEGLIGIBLE_LEMMA : thm
  STARLIKE_NEGLIGIBLE : thm
  STARLIKE_NEGLIGIBLE_STRONG : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSI [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSE : MSE) (BMSG : MSG) : ExceptT String IO MSI := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURE, measurable, MEASURABLE_INTERVAL, MEASURE_SUBSET,
        MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_DISJOINT_UNIONS, MEASURABLE_MEASURE_POS_LT, MEASURE_EMPTY, .. } := BMSB
  let { MEASURABLE_SCALING, MEASURE_SCALING, NEGLIGIBLE_TRANSLATION_REV, .. } := BMSE
  let { MEASURABLE_COMPACT, .. } := BMSG
  let { ARITH, CONTRAPOS_THM, DIMINDEX_GE_1, DISJOINT, EQ_SYM_EQ, EXISTS_IN_IMAGE,
        FINITE_IMAGE, FINITE_NUMSEG, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP, INSERT_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_INTER, IN_NUMSEG, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_IMP,
        REAL_ABS_DIV, REAL_ABS_NUM, REAL_ARCH, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_1, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, REAL_LT_REFL, REAL_LTE_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_NOT_LE, REAL_OF_NUM_ADD,
        REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_POS,
        REAL_POW_LE, REAL_POW_LE2, REAL_POW_LT, REAL_POW_MUL, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, SUM_IMAGE, SUM_LE, SUM_RMUL, SUM_SUBSET_SIMPLE, UNIONS_SUBSET,
        UNWIND_THM2, .. } := D.ig.dv.dg.pt.cvx.core6
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_RZERO, .. } :=
        D.ig.dv.dg.pt.cvx.vec4
  let { BOUNDED_INSERT, CLOSED_INTER_COMPACT, CLOSED_TRANSLATION, .. } :=
        D.ig.dv.dg.pt.cvx.top1
  let { COMPACT_IMP_BOUNDED, COMPACT_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { CONVEX_ALT, .. } := D.ig.dv.dg.pt.qcvx2
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { EVEN_EXISTS, EVEN_MULT, REAL_LT_INV2, REAL_POW_MONO, .. } := D.ig.dv.dg.qsession
  let { REAL_POW_1, SUM_CONST_NUMSEG, .. } := D.ig.qsession
  let { NEGLIGIBLE_ON_INTERVALS, .. } := D.qintegration3
  let { BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC, .. } := D.qtopology1
  -- @@SCOPE END

  let STARLIKE_NEGLIGIBLE_BOUNDED_MEASURABLE ← prove
   r"!s. measurable s /\ bounded s /\
       (!c x:real^N. &0 <= c /\ x IN s /\ (c % x) IN s ==> c = &1)
       ==> negligible s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(&0 < measure(s:real^N->bool))")
     (fun th => ASM_MESON_TAC [th, MEASURABLE_MEASURE_POS_LT]) THEN
    DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"(vec 0:real^N) INSERT s")
        BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC) THEN
    ASM_SIMP_TAC [BOUNDED_INSERT, COMPACT_IMP_BOUNDED, NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [INSERT_SUBSET] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?N. EVEN N /\ &0 < &N /\
        measure(interval[--a:real^N,a])
         < (&N * measure(s:real^N->bool)) / &4 pow dimindex (:N)")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o SPEC
       (← q r"measure(interval[--a:real^N,a]) * &4 pow (dimindex(:N))") o
       MATCH_MP REAL_ARCH) THEN
      SIMP_TAC [REAL_LT_RDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
      SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, ← ASSUME (← q r"&0 < measure(s:real^N->bool)")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"2 * (N DIV 2 + 1)") THEN REWRITE_TAC [EVEN_MULT, ARITH] THEN
      CONJ_TAC THENL [ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < a ==> a <= b ==> x < b"))) THEN
      REWRITE_TAC [REAL_OF_NUM_LE] THEN ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"UNIONS (IMAGE (\m. IMAGE (\x:real^N. (&m / &N) % x) s)
                                (1..N))",
                      ← q r"interval[--a:real^N,a]"] MEASURE_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"measure:(real^N->bool)->real",
                      ← q r"IMAGE (\m. IMAGE (\x:real^N. (&m / &N) % x) s) (1..N)"]
                  HAS_MEASURE_DISJOINT_UNIONS) THEN
    SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IMP_CONJ] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM HAS_MEASURE_MEASURE] THEN
      MATCH_MP_TAC MEASURABLE_SCALING THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ ~c ==> d <=> a /\ b /\ ~d ==> c")] THEN
    SUBGOAL_THEN
     (← q r"!m n. m IN 1..N /\ n IN 1..N /\
          ~(DISJOINT (IMAGE (\x:real^N. &m / &N % x) s)
                     (IMAGE (\x. &n / &N % x) s))
          ==> m = n")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [DISJOINT, ← GSYM MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, IN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N")
       (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"(%) (&N / &m) :real^N->real^N")) THEN
      SUBGOAL_THEN (← q r"~(&N = &0) /\ ~(&m = &0)") STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [REAL_OF_NUM_EQ] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_NUMSEG])) THEN
        ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE (BINDER_CONV o BINDER_CONV)
       [← GSYM CONTRAPOS_THM]) THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, ← REAL_FIELD
       (← q r"~(x = &0) /\ ~(y = &0) ==> x / y * y / x = &1")] THEN
      ASM_SIMP_TAC [← REAL_FIELD
       (← q r"~(x = &0) /\ ~(y = &0) ==> x / y * z / x = z / y")] THEN
      REWRITE_TAC [VECTOR_MUL_LID] THEN DISCH_THEN SUBST_ALL_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"&n / &m", ← q r"y:real^N"]) THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_POS, ← REAL_FIELD
       (← q r"~(y = &0) ==> (x / y = &1 <=> x = y)")] THEN
      REWRITE_TAC [REAL_OF_NUM_EQ, EQ_SYM_EQ],
      ALL_TAC] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_TAC] THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [measurable] THEN ASM_MESON_TAC [],
      REWRITE_TAC [MEASURABLE_INTERVAL],
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"--a:real^N", ← q r"a:real^N"] CONVEX_INTERVAL) THEN
      DISCH_THEN (MP_TAC o REWRITE_RULE [CONVEX_ALT] o CONJUNCT1) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"vec 0:real^N", ← q r"x:real^N", ← q r"&n / &N"]) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
      DISCH_THEN MATCH_MP_TAC THEN SIMP_TAC [REAL_LE_DIV, REAL_POS] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_NUMSEG]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"1 <= n /\ n <= N ==> 0 < N /\ n <= N"))) THEN
      SIMP_TAC [← GSYM REAL_OF_NUM_LE, ← GSYM REAL_OF_NUM_LT, REAL_LE_LDIV_EQ] THEN
      SIMP_TAC [REAL_MUL_LID],
      ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP MEASURE_UNIQUE) THEN
    ASM_SIMP_TAC [MEASURE_SCALING, REAL_NOT_LE] THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"&0")) THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC
     (← q r"sum (1..N) (measure o (\m. IMAGE (\x:real^N. &m / &N % x) s))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC SUM_IMAGE THEN REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"DISJOINT s s <=> s = {}"), IMAGE_EQ_EMPTY] THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      ASM_MESON_TAC [REAL_LT_REFL, MEASURE_EMPTY]] THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"0")) THEN
    ASM_SIMP_TAC [o_DEF, MEASURE_SCALING, SUM_RMUL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"x < a ==> a <= b ==> x < b"))) THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"(a * b) * c:real = (a * c) * b")] THEN
    ASM_SIMP_TAC [REAL_LE_RMUL_EQ] THEN REWRITE_TAC [← GSYM SUM_RMUL] THEN
    REWRITE_TAC [← GSYM REAL_POW_MUL] THEN
    REWRITE_TAC [REAL_ABS_DIV, REAL_ABS_NUM] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"M:num") SUBST_ALL_TAC o
          GEN_REWRITE_RULE I [EVEN_EXISTS]) THEN
    REWRITE_TAC [← GSYM REAL_OF_NUM_MUL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_MUL]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← REAL_ARITH (← q r"&0 < &2 * x <=> &0 < x")]) THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < y ==> x / (&2 * y) * &4 = x * &2 / y")] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(M..(2*M)) (\i. (&i * &2 / &M) pow dimindex (:N))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
      SIMP_TAC [REAL_POW_LE, REAL_LE_MUL, REAL_LE_DIV, REAL_POS] THEN
      REWRITE_TAC [IN_NUMSEG, FINITE_NUMSEG, SUBSET] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_OF_NUM_LT]) THEN
      ARITH_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(M..(2*M)) (\i. &2)") THEN CONJ_TAC THENL
     [REWRITE_TAC [SUM_CONST_NUMSEG] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * M + 1) - M = M + 1")] THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_ADD] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC SUM_LE THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"&2 pow (dimindex(:N))") THEN
    CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_POW_1] THEN
      MATCH_MP_TAC REAL_POW_MONO THEN REWRITE_TAC [DIMINDEX_GE_1] THEN
      ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_POW_LE2 THEN
    REWRITE_TAC [REAL_POS, ARITH, real_div, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LE_RDIV_EQ] THEN
    REWRITE_TAC [REAL_OF_NUM_MUL, REAL_OF_NUM_LE] THEN
    UNDISCH_TAC (← q r"M:num <= n") THEN ARITH_TAC)

  let STARLIKE_NEGLIGIBLE_LEMMA ← prove
   r"!s. compact s /\
       (!c x:real^N. &0 <= c /\ x IN s /\ (c % x) IN s ==> c = &1)
       ==> negligible s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC STARLIKE_NEGLIGIBLE_BOUNDED_MEASURABLE THEN
    ASM_MESON_TAC [MEASURABLE_COMPACT, COMPACT_IMP_BOUNDED])

  let STARLIKE_NEGLIGIBLE ← prove
   r"!s a. closed s /\
         (!c x:real^N. &0 <= c /\ (a + x) IN s /\ (a + c % x) IN s ==> c = &1)
         ==> negligible s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_TRANSLATION_REV THEN
    EXISTS_TAC (← q r"--a:real^N") THEN ONCE_REWRITE_TAC [NEGLIGIBLE_ON_INTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
    MATCH_MP_TAC STARLIKE_NEGLIGIBLE_LEMMA THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_INTER_COMPACT THEN REWRITE_TAC [COMPACT_INTERVAL] THEN
      ASM_SIMP_TAC [CLOSED_TRANSLATION],
      REWRITE_TAC [IN_IMAGE, IN_INTER] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = --a + y <=> y = a + x")] THEN
      REWRITE_TAC [UNWIND_THM2] THEN ASM MESON_TAC []])

  let STARLIKE_NEGLIGIBLE_STRONG ← prove
   r"!s a. closed s /\
         (!c x:real^N. &0 <= c /\ c < &1 /\ (a + x) IN s
                       ==> ~((a + c % x) IN s))
         ==> negligible s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC STARLIKE_NEGLIGIBLE THEN
    EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"x:real^N"] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"~(x < y) /\ ~(y < x) ==> x = y")) THEN
    STRIP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"inv c:real", ← q r"c % x:real^N"]) THEN
    ASM_REWRITE_TAC [REAL_LE_INV_EQ, VECTOR_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV, ← REAL_ARITH (← q r"&1 < c ==> ~(c = &0)")] THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LID] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_1] THEN
    MATCH_MP_TAC REAL_LT_INV2 THEN ASM_REWRITE_TAC [REAL_LT_01])

  pure { STARLIKE_NEGLIGIBLE_BOUNDED_MEASURABLE, STARLIKE_NEGLIGIBLE_LEMMA,
         STARLIKE_NEGLIGIBLE, STARLIKE_NEGLIGIBLE_STRONG }

/- ------------------------------------------------------------------------- -/
/- Negligible hyperplanes and low-dimensional sets; bounded convex sets;   -/
/- balls and segments; singular linear images.  (measure.ml 2557-2860)     -/
/- ------------------------------------------------------------------------- -/

structure MSJ where
  NEGLIGIBLE_HYPERPLANE : thm
  NEGLIGIBLE_LOWDIM : thm
  NEGLIGIBLE_AFFINE_HULL : thm
  NEGLIGIBLE_AFFINE_HULL_1 : thm
  NEGLIGIBLE_AFFINE_HULL_2 : thm
  NEGLIGIBLE_AFFINE_HULL_3 : thm
  NEGLIGIBLE_CONVEX_HULL : thm
  NEGLIGIBLE_CONVEX_HULL_1 : thm
  NEGLIGIBLE_CONVEX_HULL_2 : thm
  NEGLIGIBLE_CONVEX_HULL_3 : thm
  NEGLIGIBLE_CONVEX_FRONTIER : thm
  MEASURABLE_CONVEX : thm
  NEGLIGIBLE_CONVEX_INTERIOR : thm
  NEGLIGIBLE_SPHERE : thm
  MEASURABLE_BALL : thm
  MEASURABLE_CBALL : thm
  MEASURE_BALL_POS : thm
  MEASURE_CBALL_POS : thm
  HAS_INTEGRAL_OPEN_INTERVAL : thm
  INTEGRABLE_ON_OPEN_INTERVAL : thm
  INTEGRAL_OPEN_INTERVAL : thm
  ABSOLUTELY_INTEGRABLE_ON_OPEN_INTERVAL : thm
  MEASURABLE_SEGMENT : thm
  MEASURE_SEGMENT_1 : thm
  NEGLIGIBLE_SEGMENT : thm
  MEASURE_BALL_SCALING : thm
  MEASURE_CBALL_SCALING : thm
  MEASURE_CBALL_BOUND : thm
  MEASURE_BALL_BOUND : thm
  NEGLIGIBLE_LINEAR_SINGULAR_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSJ [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSC : MSC) (BMSE : MSE) (BMSG : MSG) (BMSI : MSI) : ExceptT String IO MSJ := do
  -- @@SCOPE BEGIN
  let { MEASURABLE_INTERVAL, MEASURE_INTERVAL, MEASURE_INTERVAL_1, MEASURE_SUBSET, .. } :=
        BMSA
  let { MEASURE_EMPTY, MEASURE_NEGLIGIBLE_SYMDIFF, MEASURE_SING, .. } := BMSB
  let { OPEN_NOT_NEGLIGIBLE, .. } := BMSC
  let { MEASURE_SCALING, NEGLIGIBLE_TRANSLATION_EQ, .. } := BMSE
  let { MEASURABLE_COMPACT, MEASURABLE_JORDAN, MEASURABLE_OPEN, MEASURE_OPEN_POS_LT_EQ, .. }
        := BMSG
  let { STARLIKE_NEGLIGIBLE, STARLIKE_NEGLIGIBLE_STRONG, .. } := BMSI
  let { CARD_CLAUSES, DE_MORGAN_THM, DIFF_EMPTY, DIMINDEX_1, DIMINDEX_2, DIMINDEX_3,
        FINITE_EMPTY, FINITE_INDUCT_STRONG, FINITE_INSERT, .. } := D.ig.dv.dg.pt.cvx.core1
  let { HAS_SIZE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, INSERT_SUBSET, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, LET_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_TRANS, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RID, REAL_POS, REAL_POW_LE, REAL_SUB_0, SUBSET,
        SUBSET_DIFF, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_abs, UNWIND_THM2, .. } := D.ig.dv.dg.pt.cvx.core6
  let { HULL_INC, HULL_MINIMAL, .. } := D.ig.dv.dg.pt.cvx.misc
  let { BASIS_EXISTS, COMPONENT_LE_NORM, DIM_LE_CARD, DIM_SPAN, DIM_SUBSET_UNIV, DOT_EQ_0,
        DOT_LZERO, DOT_RADD, DOT_RMUL, DOT_RNEG, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_SUB, IN_INTERVAL, LOWDIM_SUBSET_HYPERPLANE, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { SPAN_INC, SPAN_INSERT_0, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, drop, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_RZERO, VECTOR_SUB_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { BALL_EMPTY, BALL_EQ_EMPTY, BALL_SUBSET_CBALL, BOUNDED_BALL, CBALL_SCALING,
        CBALL_SING, CLOSED_HYPERPLANE, .. } := D.ig.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_CBALL, .. } := D.ig.dv.dg.pt.cvx.top2
  let { FRONTIER_CBALL, FRONTIER_CLOSED, FRONTIER_EMPTY, .. } := D.ig.dv.dg.pt.cvx.top3
  let { IN_CBALL, INTERIOR_CLOSED_INTERVAL, INTERIOR_SUBSET, OPEN_BALL, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { frontier, OPEN_INTERIOR, SEGMENT_1, SUBSET_INTERIOR, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, GEOM_ORIGIN_TAC, MESON,
        MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, .. } :=
        D.ig.dv.dg.pt.cvx
  let { BALL_SCALING, .. } := D.ig.dv.dg.pt.qtop
  let { AFFINE_HULL_EMPTY, AFFINE_HULL_EQ_SPAN, .. } := D.ig.dv.dg.pt.qcvx1
  let { CONVEX_CBALL, CONVEX_HULL_SUBSET_AFFINE_HULL, .. } := D.ig.dv.dg.pt.qcvx2
  let { INTERIOR_SEGMENT, .. } := D.ig.dv.dg.pt.qcvx3
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { ADD_SUB, .. } := D.ig.dv.dg.qsession
  let { NORM_REAL, .. } := D.ig.qvec
  let { BOUNDED_SEGMENT, CONVEX_SEGMENT, CONVEX_TRANSLATION,
        IN_INTERIOR_CLOSURE_CONVEX_SHRINK, INTERIOR_SIMPLEX_NONEMPTY, SEGMENT_EQ_EMPTY, .. }
        := D.qconvex
  let { CONTENT_CLOSED_INTERVAL_CASES, .. } := D.qintegration1
  let { HAS_INTEGRAL_INTERIOR, .. } := D.qintegration2
  let { absolutely_integrable_on, integrable_on, integral, NEGLIGIBLE_EMPTY,
        NEGLIGIBLE_SUBSET, .. } := D.qintegration3
  let { PRODUCT_CONST_NUMSEG, .. } := D.qproducts
  let { DIMINDEX_NONZERO, REAL_POW_ZERO, .. } := D.qsession
  let { DIM_CLOSURE, .. } := D.qtopology1
  let { FRONTIER_TRANSLATION, SPHERE_UNION_BALL, .. } := D.qtopology2
  let { LINEAR_SINGULAR_IMAGE_HYPERPLANE, .. } := D.qvec
  -- @@SCOPE END

  let NEGLIGIBLE_HYPERPLANE ← prove
   r"!a b. ~(a = vec 0 /\ b = &0) ==> negligible {x:real^N | a dot x = b}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = vec 0") THEN
    ASM_SIMP_TAC [DOT_LZERO, ← SET_RULE (← q r"{x | F} = {}"), NEGLIGIBLE_EMPTY] THEN
    MATCH_MP_TAC STARLIKE_NEGLIGIBLE THEN
    SUBGOAL_THEN (← q r"?x:real^N. ~(a dot x = b)") MP_TAC THENL
     [MATCH_MP_TAC (← MESON [] (← q r"!a:real^N. P a \/ P(--a) ==> ?x. P x")) THEN
      EXISTS_TAC (← q r"a:real^N") THEN REWRITE_TAC [DOT_RNEG] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"~(a = &0) ==> ~(a = b) \/ ~(--a = b)")) THEN
      ASM_REWRITE_TAC [DOT_EQ_0],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
    REWRITE_TAC [CLOSED_HYPERPLANE, IN_ELIM_THM, DOT_RADD, DOT_RMUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"y:real^N"] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"&0 <= t /\ ac + ay = b /\ ac + t * ay = b
    ==> ((ay = &0 ==> ac = b) /\ (t - &1) * ay = &0)"))) THEN
    ASM_SIMP_TAC [REAL_ENTIRE, REAL_SUB_0] THEN CONV_TAC (fun t => TAUT t))

  let NEGLIGIBLE_LOWDIM ← prove
   r"!s:real^N->bool. dim(s) < dimindex(:N) ==> negligible s"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP LOWDIM_SUBSET_HYPERPLANE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"span(s):real^N->bool") THEN REWRITE_TAC [SPAN_INC] THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{x:real^N | a dot x = &0}") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_HYPERPLANE])

  let NEGLIGIBLE_AFFINE_HULL ← prove
   r"!s:real^N->bool.
        FINITE s /\ CARD(s) <= dimindex(:N) ==> negligible(affine hull s)"
   (REWRITE_TAC [IMP_CONJ] THEN  MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [AFFINE_HULL_EMPTY, NEGLIGIBLE_EMPTY] THEN
    SUBGOAL_THEN
     (← q r"!x s:real^N->bool n.
        ~(x IN s) /\ (x INSERT s) HAS_SIZE n /\ n <= dimindex(:N)
        ==> negligible(affine hull(x INSERT s))")
     (fun th => MESON_TAC [th, HAS_SIZE, FINITE_INSERT]) THEN
    X_GEN_TAC (← q r"orig:real^N") THEN GEOM_ORIGIN_TAC (← q r"orig:real^N") THEN
    SIMP_TAC [AFFINE_HULL_EQ_SPAN, IN_INSERT, SPAN_INSERT_0, HULL_INC] THEN
    REWRITE_TAC [HAS_SIZE, FINITE_INSERT, IMP_CONJ] THEN
    SIMP_TAC [CARD_CLAUSES] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_LOWDIM THEN
    MATCH_MP_TAC LET_TRANS THEN EXISTS_TAC (← q r"CARD(s:real^N->bool)") THEN
    ASM_SIMP_TAC [DIM_LE_CARD, DIM_SPAN] THEN ASM_ARITH_TAC)

  let NEGLIGIBLE_AFFINE_HULL_1 ← prove
   r"!a:real^1. negligible (affine hull {a})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_AFFINE_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_1] THEN
    ARITH_TAC)

  let NEGLIGIBLE_AFFINE_HULL_2 ← prove
   r"!a b:real^2. negligible (affine hull {a,b})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_AFFINE_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_2] THEN
    ARITH_TAC)

  let NEGLIGIBLE_AFFINE_HULL_3 ← prove
   r"!a b c:real^3. negligible (affine hull {a,b,c})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_AFFINE_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_3] THEN
    ARITH_TAC)

  let NEGLIGIBLE_CONVEX_HULL ← prove
   r"!s:real^N->bool.
        FINITE s /\ CARD(s) <= dimindex(:N) ==> negligible(convex hull s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP NEGLIGIBLE_AFFINE_HULL) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
    REWRITE_TAC [CONVEX_HULL_SUBSET_AFFINE_HULL])

  let NEGLIGIBLE_CONVEX_HULL_1 ← prove
   r"!a:real^1. negligible (convex hull {a})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_CONVEX_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_1] THEN
    ARITH_TAC)

  let NEGLIGIBLE_CONVEX_HULL_2 ← prove
   r"!a b:real^2. negligible (convex hull {a,b})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_CONVEX_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_2] THEN
    ARITH_TAC)

  let NEGLIGIBLE_CONVEX_HULL_3 ← prove
   r"!a b c:real^3. negligible (convex hull {a,b,c})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_CONVEX_HULL THEN
    SIMP_TAC [FINITE_INSERT, CARD_CLAUSES, FINITE_EMPTY, DIMINDEX_3] THEN
    ARITH_TAC)

  let NEGLIGIBLE_CONVEX_FRONTIER ← prove
   r"!s:real^N->bool. convex s ==> negligible(frontier s)"
   (SUBGOAL_THEN
     (← q r"!s:real^N->bool. convex s /\ (vec 0) IN s ==> negligible(frontier s)")
    ASSUME_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [FRONTIER_EMPTY, NEGLIGIBLE_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (\x:real^N. --a + x) s")) THEN
      ASM_SIMP_TAC [CONVEX_TRANSLATION, IN_IMAGE] THEN
      ASM_REWRITE_TAC [UNWIND_THM2,
                       ← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
      REWRITE_TAC [FRONTIER_TRANSLATION, NEGLIGIBLE_TRANSLATION_EQ]] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← ISPEC (← q r"s:real^N->bool") DIM_SUBSET_UNIV) THEN
    REWRITE_TAC [← ARITH_RULE (← q r"d:num <= e <=> d < e \/ d = e")] THEN STRIP_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"closure s:real^N->bool") THEN
      REWRITE_TAC [frontier, SUBSET_DIFF] THEN
      MATCH_MP_TAC NEGLIGIBLE_LOWDIM THEN ASM_REWRITE_TAC [DIM_CLOSURE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?a:real^N. a IN interior s") CHOOSE_TAC THENL
     [X_CHOOSE_THEN (← q r"b:real^N->bool") STRIP_ASSUME_TAC
       (← ISPEC (← q r"s:real^N->bool") BASIS_EXISTS) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      MP_TAC (← ISPEC (← q r"b:real^N->bool") INTERIOR_SIMPLEX_NONEMPTY) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [← GSYM SUBSET] THEN
      MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC HULL_MINIMAL THEN
      ASM_REWRITE_TAC [INSERT_SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC STARLIKE_NEGLIGIBLE_STRONG THEN
    EXISTS_TAC (← q r"a:real^N") THEN REWRITE_TAC [FRONTIER_CLOSED] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [frontier, IN_DIFF, DE_MORGAN_THM] THEN DISJ2_TAC THEN
    SIMP_TAC [← VECTOR_ARITH
     (← q r"a + c % x:real^N = (a + x) - (&1 - c) % ((a + x) - a)")] THEN
    MATCH_MP_TAC IN_INTERIOR_CLOSURE_CONVEX_SHRINK THEN
    RULE_ASSUM_TAC (REWRITE_RULE [frontier, IN_DIFF]) THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let MEASURABLE_CONVEX ← prove
   r"!s:real^N->bool. convex s /\ bounded s ==> measurable s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MEASURABLE_JORDAN THEN
    ASM_SIMP_TAC [NEGLIGIBLE_CONVEX_FRONTIER])

  let NEGLIGIBLE_CONVEX_INTERIOR ← prove
   r"!s:real^N->bool. convex s ==> (negligible s <=> interior s = {})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [OPEN_NOT_NEGLIGIBLE, INTERIOR_SUBSET, OPEN_INTERIOR,
                 NEGLIGIBLE_SUBSET],
      DISCH_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"frontier s:real^N->bool") THEN
      ASM_SIMP_TAC [NEGLIGIBLE_CONVEX_FRONTIER] THEN
      ASM_REWRITE_TAC [frontier, DIFF_EMPTY, CLOSURE_SUBSET]])

  let NEGLIGIBLE_SPHERE ← prove
   r"!a:real^N r. negligible (sphere(a,r))"
   (REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN
    SIMP_TAC [NEGLIGIBLE_CONVEX_FRONTIER, CONVEX_CBALL])

  let MEASURABLE_BALL ← prove
   r"!a r. measurable(ball(a,r))"
   (SIMP_TAC [MEASURABLE_OPEN, BOUNDED_BALL, OPEN_BALL])

  let MEASURABLE_CBALL ← prove
   r"!a r. measurable(cball(a,r))"
   (SIMP_TAC [MEASURABLE_COMPACT, COMPACT_CBALL])

  let MEASURE_BALL_POS ← prove
   r"!x:real^N e. &0 < measure(ball(x,e)) <=> &0 < e"
   (SIMP_TAC [MEASURE_OPEN_POS_LT_EQ, OPEN_BALL, BOUNDED_BALL, BALL_EQ_EMPTY] THEN
    REAL_ARITH_TAC)

  let MEASURE_CBALL_POS ← prove
   r"!x:real^N e. &0 < measure(cball(x,e)) <=> &0 < e"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM MEASURE_BALL_POS] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC MEASURE_NEGLIGIBLE_SYMDIFF THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"sphere(x:real^N,e)") THEN
    REWRITE_TAC [← GSYM SPHERE_UNION_BALL, NEGLIGIBLE_SPHERE] THEN SET_TAC [])

  let HAS_INTEGRAL_OPEN_INTERVAL ← prove
   r"!f a b y. (f has_integral y) (interval(a,b)) <=>
             (f has_integral y) (interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM INTERIOR_CLOSED_INTERVAL] THEN
    MATCH_MP_TAC HAS_INTEGRAL_INTERIOR THEN
    MATCH_MP_TAC NEGLIGIBLE_CONVEX_FRONTIER THEN
    REWRITE_TAC [CONVEX_INTERVAL])

  let INTEGRABLE_ON_OPEN_INTERVAL ← prove
   r"!f a b. f integrable_on interval(a,b) <=>
           f integrable_on interval[a,b]"
   (REWRITE_TAC [integrable_on, HAS_INTEGRAL_OPEN_INTERVAL])

  let INTEGRAL_OPEN_INTERVAL ← prove
   r"!f a b. integral(interval(a,b)) f = integral(interval[a,b]) f"
   (REWRITE_TAC [integral, HAS_INTEGRAL_OPEN_INTERVAL])

  let ABSOLUTELY_INTEGRABLE_ON_OPEN_INTERVAL ← prove
   r"!f:real^M->real^N a b.
        f absolutely_integrable_on interval(a,b) <=>
        f absolutely_integrable_on interval[a,b]"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_ON_OPEN_INTERVAL])

  let MEASURABLE_SEGMENT ← prove
   r"(!a b:real^N. measurable(segment[a,b])) /\
   (!a b:real^N. measurable(segment(a,b)))"
   (SIMP_TAC [MEASURABLE_CONVEX, CONVEX_SEGMENT, BOUNDED_SEGMENT])

  let MEASURE_SEGMENT_1 ← prove
   r"(!a b:real^1. measure(segment[a,b]) = norm(b - a)) /\
   (!a b:real^1. measure(segment(a,b)) = norm(b - a))"
   (REWRITE_TAC [SEGMENT_1] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [MEASURE_INTERVAL_1] THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN ASM_REAL_ARITH_TAC)

  let NEGLIGIBLE_SEGMENT ← prove
   r"(!a b:real^N. negligible(segment[a,b]) <=> 2 <= dimindex(:N) \/ a = b) /\
   (!a b:real^N. negligible(segment(a,b)) <=> 2 <= dimindex(:N) \/ a = b)"
   (SIMP_TAC [NEGLIGIBLE_CONVEX_INTERIOR, CONVEX_SEGMENT] THEN
    REWRITE_TAC [INTERIOR_SEGMENT] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [SEGMENT_EQ_EMPTY])

  let MEASURE_BALL_SCALING ← prove
   r"!a:real^N c r.
      &0 <= c
      ==> measure(ball(a,c * r)) = c pow dimindex(:N) * measure(ball(a,r))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_SIMP_TAC [REAL_MUL_LZERO, BALL_EMPTY, REAL_LE_REFL, MEASURE_EMPTY,
                  REAL_POW_ZERO, DIMINDEX_NONZERO] THEN
    SUBGOAL_THEN (← q r"&0 < c") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^N = c % vec 0")) THEN
    ASM_SIMP_TAC [BALL_SCALING, MEASURE_SCALING, MEASURABLE_BALL] THEN
    ASM_REWRITE_TAC [real_abs, VECTOR_MUL_RZERO])

  let MEASURE_CBALL_SCALING ← prove
   r"!a:real^N c r.
      &0 <= c
      ==> measure(cball(a,c * r)) = c pow dimindex(:N) * measure(cball(a,r))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_SIMP_TAC [REAL_MUL_LZERO, CBALL_SING, REAL_LE_REFL, MEASURE_SING,
                  REAL_POW_ZERO, DIMINDEX_NONZERO] THEN
    SUBGOAL_THEN (← q r"&0 < c") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^N = c % vec 0")) THEN
    ASM_SIMP_TAC [CBALL_SCALING, MEASURE_SCALING, MEASURABLE_CBALL] THEN
    ASM_REWRITE_TAC [real_abs, VECTOR_MUL_RZERO])

  let MEASURE_CBALL_BOUND ← prove
   r"!x:real^N d.
        &0 <= d ==> measure(cball(x,d)) <= (&2 * d) pow (dimindex(:N))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(interval[x - d % vec 1:real^N,x + d % vec 1])") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MEASURE_SUBSET THEN
      REWRITE_TAC [MEASURABLE_CBALL, MEASURABLE_INTERVAL] THEN
      REWRITE_TAC [SUBSET, IN_CBALL, IN_INTERVAL] THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT, dist] THEN
      REWRITE_TAC [VECTOR_MUL_COMPONENT, VEC_COMPONENT] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"x - y:real^N", ← q r"i:num"] COMPONENT_LE_NORM) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_COMPONENT] THEN ASM_REAL_ARITH_TAC,
      SIMP_TAC [MEASURE_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES] THEN
      COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_POW_LE, REAL_LE_MUL, REAL_POS] THEN
      REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_SUB_COMPONENT] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(x + a) - (x - a):real = &2 * a")] THEN
      REWRITE_TAC [PRODUCT_CONST_NUMSEG, VECTOR_MUL_COMPONENT, VEC_COMPONENT] THEN
      REWRITE_TAC [REAL_MUL_RID, ADD_SUB, REAL_LE_REFL]])

  let MEASURE_BALL_BOUND ← prove
   r"!x:real^N d.
        &0 <= d ==> measure(ball(x,d)) <= (&2 * d) pow (dimindex(:N))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"measure(cball(x:real^N,d))") THEN
    ASM_SIMP_TAC [MEASURE_CBALL_BOUND] THEN MATCH_MP_TAC MEASURE_SUBSET THEN
    REWRITE_TAC [BALL_SUBSET_CBALL, MEASURABLE_BALL, MEASURABLE_CBALL])

  let NEGLIGIBLE_LINEAR_SINGULAR_IMAGE ← prove
   r"!f:real^N->real^N s.
        linear f /\ ~(!x y. f(x) = f(y) ==> x = y)
        ==> negligible(IMAGE f s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LINEAR_SINGULAR_IMAGE_HYPERPLANE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{x:real^N | a dot x = &0}") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_HYPERPLANE])

  pure { NEGLIGIBLE_HYPERPLANE, NEGLIGIBLE_LOWDIM, NEGLIGIBLE_AFFINE_HULL,
         NEGLIGIBLE_AFFINE_HULL_1, NEGLIGIBLE_AFFINE_HULL_2, NEGLIGIBLE_AFFINE_HULL_3,
         NEGLIGIBLE_CONVEX_HULL, NEGLIGIBLE_CONVEX_HULL_1, NEGLIGIBLE_CONVEX_HULL_2,
         NEGLIGIBLE_CONVEX_HULL_3, NEGLIGIBLE_CONVEX_FRONTIER, MEASURABLE_CONVEX,
         NEGLIGIBLE_CONVEX_INTERIOR, NEGLIGIBLE_SPHERE, MEASURABLE_BALL, MEASURABLE_CBALL,
         MEASURE_BALL_POS, MEASURE_CBALL_POS, HAS_INTEGRAL_OPEN_INTERVAL,
         INTEGRABLE_ON_OPEN_INTERVAL, INTEGRAL_OPEN_INTERVAL,
         ABSOLUTELY_INTEGRABLE_ON_OPEN_INTERVAL, MEASURABLE_SEGMENT, MEASURE_SEGMENT_1,
         NEGLIGIBLE_SEGMENT, MEASURE_BALL_SCALING, MEASURE_CBALL_SCALING,
         MEASURE_CBALL_BOUND, MEASURE_BALL_BOUND, NEGLIGIBLE_LINEAR_SINGULAR_IMAGE }

/- ------------------------------------------------------------------------- -/
/- The covering lemma (a multidimensional form of Lemma 3, p65 of Swartz's  -/
/- "Introduction to Gauge Integrals").  (measure.ml 2861-3175)              -/
/- ------------------------------------------------------------------------- -/

structure MSK where
  COVERING_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSK [HolBase] (D : MeasureDeps) : ExceptT String IO MSK := do
  -- @@SCOPE BEGIN
  let { ADD_SYM, AND_FORALL_THM, ARITH, ARITH_EQ, CARD_NUMSEG_1, CONJ_ASSOC, DE_MORGAN_THM,
        DIMINDEX_GE_1, EMPTY_GSPEC, EXISTS_IN_IMAGE, EXISTS_PAIR_THM, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_RULES, FINITE_SUBSET, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, IMP_CONJ, IMP_IMP,
        IN_ELIM_PAIR_THM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_UNIONS, IN_UNIV, LAMBDA_BETA, LE_1, LE_REFL,
        MONO_EXISTS, MONO_FORALL, NOT_IMP, NOT_LT, NUMSEG_EMPTY, REAL_ARCH_POW_INV, .. } :=
        D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LE_ADDR, REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_INV2,
        REAL_LE_LADD, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_MUL_EQ, REAL_LE_RDIV_EQ,
        REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_DIV2_EQ,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LADD, REAL_LT_LDIV_EQ,
        REAL_LT_POW2, REAL_LT_RDIV_EQ, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_SYM,
        REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_POW, REAL_OF_NUM_SUB, REAL_POS, REAL_POW_EQ_0, REAL_POW_INV,
        REAL_POW_LE, REAL_SUB_ADD, REAL_SUB_LE, REAL_SUB_LT, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { real_div, SWAP_FORALL_THM, WLOG_LE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, .. } := D.ig.dv.dg.pt.cvx.lib
  let { LAMBDA_SKOLEM, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, INTERVAL_SING, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_POS_LT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_BALL, INTERIOR_CLOSED_INTERVAL, OPEN_CONTAINS_BALL, .. } :=
        D.ig.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { FINITE_PRODUCT_DEPENDENT, SUM_BOUND_GEN, .. } := D.ig.dv.dg.pt.qses
  let { FINITE_IMP_COUNTABLE, .. } := D.ig.dv.dg.pt.qcard
  let { LT, REAL_LT_INV2, REAL_POW_MONO_LT, .. } := D.ig.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { REAL_LT_RMUL_EQ, .. } := D.ig.dv.qsession
  let { COUNTABLE_SUBSET, .. } := D.ig.qcard
  let { FLOOR, FLOOR_POS, INTEGER_CLOSED, .. } := D.ig.qfloor
  let { LE_EXISTS, REAL_POW_ADD, .. } := D.ig.qsession
  let { EQ_INTERVAL, .. } := D.ig.qtopology
  let { INTERVAL_EQ_EMPTY, .. } := D.ig.qvec
  let { gauge, .. } := D.qintegration3
  let { NUM_COUNTABLE, .. } := D.qcard
  let { REAL_LT_INTEGERS, .. } := D.qfloor
  let { EXP_LT_0, FINITE_CART, FINITE_NUMSEG_LT, REAL_EQ_MUL_RCANCEL, WF, WF_FINITE, .. } :=
        D.qsession
  let { DISJOINT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let COVERING_LEMMA ← prove
   r"!a b:real^N s g.
        s SUBSET interval[a,b] /\ ~(interval(a,b) = {}) /\ gauge g
        ==> ?d. COUNTABLE d /\
                (!k. k IN d ==> k SUBSET interval[a,b] /\ ~(interior k = {}) /\
                                (?c d. k = interval[c,d])) /\
                (!k1 k2. k1 IN d /\ k2 IN d /\ ~(k1 = k2)
                         ==> interior k1 INTER interior k2 = {}) /\
                (!k. k IN d ==> ?x. x IN (s INTER k) /\ k SUBSET g(x)) /\
                (!u v. interval[u,v] IN d
                       ==> ?n. !i. 1 <= i /\ i <= dimindex(:N)
                                   ==> v$i - u$i = (b$i - a$i) / &2 pow n) /\
                s SUBSET UNIONS d"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?d. COUNTABLE d /\
        (!k. k IN d ==> k SUBSET interval[a,b] /\ ~(interior k = {}) /\
                        (?c d:real^N. k = interval[c,d])) /\
        (!k1 k2. k1 IN d /\ k2 IN d
                 ==> k1 SUBSET k2 \/ k2 SUBSET k1 \/
                     interior k1 INTER interior k2 = {}) /\
        (!x. x IN s ==> ?k. k IN d /\ x IN k /\ k SUBSET g(x)) /\
        (!u v. interval[u,v] IN d
                       ==> ?n. !i. 1 <= i /\ i <= dimindex(:N)
                                   ==> v$i - u$i = (b$i - a$i) / &2 pow n) /\
        (!k. k IN d ==> FINITE {l | l IN d /\ k SUBSET l})")
    ASSUME_TAC THENL
     [EXISTS_TAC
       (← q r"IMAGE (\(n,v).
             interval[(lambda i. a$i + &(v$i) / &2 pow n *
                                       ((b:real^N)$i - (a:real^N)$i)):real^N,
                      (lambda i. a$i + (&(v$i) + &1) / &2 pow n * (b$i - a$i))])
            {n,v | n IN (:num) /\
                   v IN {v:num^N | !i. 1 <= i /\ i <= dimindex(:N)
                                       ==> v$i < 2 EXP n}}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_IMAGE THEN
        MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
        REWRITE_TAC [NUM_COUNTABLE, IN_UNIV] THEN
        GEN_TAC THEN MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN
        MATCH_MP_TAC FINITE_CART THEN REWRITE_TAC [FINITE_NUMSEG_LT],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"v:num^N"] THEN
        REWRITE_TAC [IN_ELIM_PAIR_THM] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN DISCH_TAC THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
        REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN
        SIMP_TAC [INTERVAL_NE_EMPTY, SUBSET_INTERVAL, LAMBDA_BETA] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
        ASM_SIMP_TAC [REAL_LE_LADD, REAL_LE_RMUL_EQ, REAL_SUB_LT, REAL_LE_MUL_EQ,
                      REAL_LT_LADD, REAL_LT_RMUL_EQ, REAL_LE_ADDR, ← REAL_ARITH
                        (← q r"a + x * (b - a) <= b <=> &0 <= (&1 - x) * (b - a)")] THEN
        SIMP_TAC [REAL_LE_DIV2_EQ, REAL_LT_DIV2_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x <= x + &1 /\ x < x + &1")] THEN
        REWRITE_TAC [REAL_SUB_LE] THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [REAL_MUL_LZERO, REAL_POS, REAL_MUL_LID] THEN
        SIMP_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_POW, REAL_OF_NUM_LE] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"x + 1 <= y <=> x < y"), REAL_LT_IMP_LE],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [ONCE_REWRITE_TAC [IMP_CONJ] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [IN_ELIM_PAIR_THM, IN_UNIV] THEN REWRITE_TAC [IN_ELIM_THM] THEN
        REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
        GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
        MATCH_MP_TAC WLOG_LE THEN CONJ_TAC THENL
         [REPEAT GEN_TAC THEN
          GEN_REWRITE_TAC RAND_CONV [SWAP_FORALL_THM] THEN
          REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [],
          ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"v:num^N", ← q r"w:num^N"] THEN REPEAT DISCH_TAC THEN
        REWRITE_TAC [INTERIOR_CLOSED_INTERVAL, SUBSET_INTERVAL] THEN
        SIMP_TAC [DISJOINT_INTERVAL, LAMBDA_BETA] THEN
        MATCH_MP_TAC (← TAUT (← q r"p \/ q \/ r ==> (a ==> p) \/ (b ==> q) \/ r")) THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(a /\ b ==> ~c)")] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
        ASM_SIMP_TAC [REAL_LE_LADD, REAL_LE_RMUL_EQ, REAL_SUB_LT, LAMBDA_BETA] THEN
        REWRITE_TAC [NOT_IMP, REAL_LE_LADD] THEN
        ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"~(x + &1 <= x)")] THEN DISJ2_TAC THEN
        MATCH_MP_TAC (← MESON []
         (← q r"(!i. ~P i ==> Q i) ==> (!i. Q i) \/ (?i. P i)")) THEN
        X_GEN_TAC (← q r"i:num") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LE] THEN
        UNDISCH_TAC (← q r"m:num <= n") THEN REWRITE_TAC [LE_EXISTS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"p:num") SUBST1_TAC) THEN
        ONCE_REWRITE_TAC [ADD_SYM] THEN
        REWRITE_TAC [REAL_POW_ADD, real_div, REAL_INV_MUL] THEN
        REWRITE_TAC [REAL_MUL_ASSOC] THEN REWRITE_TAC [← GSYM real_div] THEN
        ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_LT_POW2, REAL_LT_DIV2_EQ] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_POW2,
                      REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ] THEN
        SIMP_TAC [REAL_LT_INTEGERS, INTEGER_CLOSED] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        SUBGOAL_THEN
          (← q r"?e. &0 < e /\ !y. (!i. 1 <= i /\ i <= dimindex(:N)
                                ==> abs((x:real^N)$i - (y:real^N)$i) <= e)
                           ==> y IN g(x)")
        STRIP_ASSUME_TAC THENL
         [FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE I [gauge]) THEN
          STRIP_TAC THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_CONTAINS_BALL]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"e / &2 / &(dimindex(:N))") THEN
          ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1,
                        ARITH] THEN
          X_GEN_TAC (← q r"y:real^N") THEN STRIP_TAC THEN
          MATCH_MP_TAC (← SET_RULE (← q r"!s. s SUBSET t /\ x IN s ==> x IN t")) THEN
          EXISTS_TAC (← q r"ball(x:real^N,e)") THEN ASM_REWRITE_TAC [IN_BALL] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
          ASM_REWRITE_TAC [dist] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"sum(1..dimindex(:N)) (\i. abs((x - y:real^N)$i))") THEN
          REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_BOUND_GEN THEN
          ASM_SIMP_TAC [IN_NUMSEG, FINITE_NUMSEG, NUMSEG_EMPTY, NOT_LT,
                        DIMINDEX_GE_1, VECTOR_SUB_COMPONENT, CARD_NUMSEG_1],
          ALL_TAC] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM] THEN
        MP_TAC (← SPECL [← q r"&1 / &2", ← q r"e / norm(b - a:real^N)"]
          REAL_ARCH_POW_INV) THEN
        SUBGOAL_THEN (← q r"&0 < norm(b - a:real^N)") ASSUME_TAC THENL
         [ASM_MESON_TAC [VECTOR_SUB_EQ, NORM_POS_LT, INTERVAL_SING], ALL_TAC] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
        REWRITE_TAC [real_div, REAL_MUL_LID, REAL_POW_INV] THEN DISCH_TAC THEN
        SIMP_TAC [IN_ELIM_THM, IN_INTERVAL, SUBSET, LAMBDA_BETA] THEN
        MATCH_MP_TAC (← MESON []
         (← q r"(!x. Q x ==> R x) /\ (?x. P x /\ Q x) ==> ?x. P x /\ Q x /\ R x")) THEN
        CONJ_TAC THENL
         [REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"w:num^N", ← q r"y:real^N"] THEN
          REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
          DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
          DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"(a + n <= x /\ x <= a + m) /\
          (a + n <= y /\ y <= a + m) ==> abs(x - y) <= m - n"))) THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"y * z <= e
          ==> a <= ((x + &1) * y) * z - ((x * y) * z) ==> a <= e")) THEN
          RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
          ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_SUB_LT] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
          (← REAL_ARITH (← q r"n < e * x ==> &0 <= e * (inv y - x) ==> n <= e / y"))) THEN
          MATCH_MP_TAC REAL_LE_MUL THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
          REWRITE_TAC [REAL_SUB_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
          ASM_SIMP_TAC [REAL_SUB_LT] THEN
          MP_TAC (← SPECL [← q r"b - a:real^N", ← q r"i:num"] COMPONENT_LE_NORM) THEN
          ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        REWRITE_TAC [IN_UNIV, AND_FORALL_THM] THEN
        REWRITE_TAC [← TAUT (← q r"(a ==> c) /\ (a ==> b) <=> a ==> b /\ c")] THEN
        REWRITE_TAC [← GSYM LAMBDA_SKOLEM] THEN X_GEN_TAC (← q r"i:num") THEN
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(x:real^N) IN interval[a,b]") MP_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN REWRITE_TAC [IN_INTERVAL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN STRIP_TAC THEN
        DISJ_CASES_TAC (← MATCH_MP (← REAL_ARITH (← q r"x <= y ==> x = y \/ x < y"))
         (← ASSUME (← q r"(x:real^N)$i <= (b:real^N)$i")))
        THENL
         [EXISTS_TAC (← q r"2 EXP n - 1") THEN
          SIMP_TAC [← GSYM REAL_OF_NUM_SUB, ← GSYM REAL_OF_NUM_LT,
                    EXP_LT_0, LE_1, ARITH] THEN
          ASM_REWRITE_TAC [REAL_SUB_ADD, ← REAL_ARITH (← q r"a - &1 < a")] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"&1 * (b - a) = x /\ y <= x ==> a + y <= b /\ b <= a + x")) THEN
          ASM_SIMP_TAC [REAL_EQ_MUL_RCANCEL, REAL_LT_IMP_NZ, REAL_LE_RMUL_EQ,
                        REAL_SUB_LT, REAL_LT_INV_EQ, REAL_LT_POW2] THEN
          SIMP_TAC [← GSYM REAL_OF_NUM_POW, REAL_MUL_RINV, REAL_POW_EQ_0,
                    REAL_OF_NUM_EQ, ARITH_EQ] THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        MP_TAC (← SPEC (← q r"&2 pow n * ((x:real^N)$i - (a:real^N)$i) /
                              ((b:real^N)$i - (a:real^N)$i)") FLOOR_POS) THEN
        ANTS_TAC THENL
         [ASM_MESON_TAC [REAL_LE_MUL, REAL_LE_MUL, REAL_POW_LE, REAL_POS,
                         REAL_SUB_LE, REAL_LT_IMP_LE, REAL_LE_DIV],
          ALL_TAC] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"m:num") THEN
        REWRITE_TAC [← GSYM REAL_OF_NUM_LT, ← GSYM REAL_OF_NUM_POW] THEN
        DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a + b * c <= x /\ x <= a + b' * c <=>
                              b * c <= x - a /\ x - a <= b' * c")] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← GSYM REAL_LE_RDIV_EQ,
                      REAL_SUB_LT, ← GSYM real_div] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_POW2] THEN
        SIMP_TAC [FLOOR, REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"((x:real^N)$i - (a:real^N)$i) /
                  ((b:real^N)$i - (a:real^N)$i) *
                  &2 pow n") THEN
        REWRITE_TAC [FLOOR] THEN GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
        ASM_SIMP_TAC [REAL_LT_RMUL_EQ, REAL_LT_POW2] THEN
        ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_MUL_LID, REAL_SUB_LT] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      CONJ_TAC THENL
       [REPEAT GEN_TAC THEN REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN
        REWRITE_TAC [EQ_INTERVAL, IN_ELIM_PAIR_THM] THEN
        REWRITE_TAC [INTERVAL_EQ_EMPTY, IN_UNIV, IN_ELIM_THM] THEN
        SIMP_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(a /\ b ==> ~c)"), LAMBDA_BETA] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
        ASM_SIMP_TAC [REAL_LT_LADD, REAL_LT_RMUL_EQ, REAL_SUB_LT,
                      REAL_LT_DIV2_EQ, REAL_LT_POW2,
                      ← REAL_ARITH (← q r"~(v + &1 < v)")] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
        STRIP_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"v:num^N"] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN DISCH_TAC THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
       (← q r"IMAGE (\(n,v).
            interval[(lambda i. a$i + &(v$i) / &2 pow n *
                                      ((b:real^N)$i - (a:real^N)$i)):real^N,
                     (lambda i. a$i + (&(v$i) + &1) / &2 pow n * (b$i - a$i))])
            {m,v | m IN 0..n /\
                   v IN {v:num^N | !i. 1 <= i /\ i <= dimindex(:N)
                                       ==> v$i < 2 EXP m}}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN
        MATCH_MP_TAC FINITE_PRODUCT_DEPENDENT THEN
        REWRITE_TAC [FINITE_NUMSEG] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC FINITE_CART THEN REWRITE_TAC [FINITE_NUMSEG_LT],
        ALL_TAC] THEN
      GEN_REWRITE_TAC I [SUBSET] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"w:num^N"] THEN DISCH_TAC THEN
      DISCH_TAC THEN SIMP_TAC [IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY EXISTS_TAC [← q r"m:num", ← q r"w:num^N"] THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_NUMSEG, ← GSYM NOT_LT, LT] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET_INTERVAL]) THEN
      SIMP_TAC [NOT_IMP, LAMBDA_BETA] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
      ASM_SIMP_TAC [REAL_LE_LADD, REAL_LE_RMUL_EQ, REAL_SUB_LT] THEN
      ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_LT_POW2] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x <= x + &1")] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"1")) THEN
      REWRITE_TAC [LE_REFL, DIMINDEX_GE_1] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"w / m <= v / n /\ (v + &1) / n <= (w + &1) / m
      ==> inv n <= inv m"))) THEN
      REWRITE_TAC [REAL_NOT_LE] THEN MATCH_MP_TAC REAL_LT_INV2 THEN
      ASM_REWRITE_TAC [REAL_LT_POW2] THEN MATCH_MP_TAC REAL_POW_MONO_LT THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?d. COUNTABLE d /\
        (!k. k IN d ==> k SUBSET interval[a,b] /\ ~(interior k = {}) /\
                        (?c d:real^N. k = interval[c,d])) /\
        (!k1 k2. k1 IN d /\ k2 IN d
                 ==> k1 SUBSET k2 \/ k2 SUBSET k1 \/
                     interior k1 INTER interior k2 = {}) /\
        (!k. k IN d ==> (?x. x IN s INTER k /\ k SUBSET g x)) /\
        (!u v. interval[u,v] IN d
                       ==> ?n. !i. 1 <= i /\ i <= dimindex(:N)
                                   ==> v$i - u$i = (b$i - a$i) / &2 pow n) /\
        (!k. k IN d ==> FINITE {l | l IN d /\ k SUBSET l}) /\
        s SUBSET UNIONS d")
    MP_TAC THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC
       (← q r"{k:real^N->bool | k IN d /\ ?x. x IN (s INTER k) /\ k SUBSET g x}") THEN
      ASM_SIMP_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_SUBSET THEN
        EXISTS_TAC (← q r"d:(real^N->bool)->bool") THEN
        ASM_REWRITE_TAC [] THEN SET_TAC [],
        X_GEN_TAC (← q r"k:real^N->bool") THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{l:real^N->bool | l IN d /\ k SUBSET l}") THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        ASM SET_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"{k:real^N->bool | k IN d /\ !k'. k' IN d /\ ~(k = k')
                                     ==> ~(k SUBSET k')}") THEN
    ASM_SIMP_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC (← q r"d:(real^N->bool)->bool") THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
    GEN_REWRITE_TAC I [SUBSET] THEN REWRITE_TAC [FORALL_IN_UNIONS] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"x:real^N"] THEN DISCH_TAC THEN
    REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
    MP_TAC (← ISPEC (← q r"\k l:real^N->bool. k IN d /\ l IN d /\ l SUBSET k /\ ~(k = l)")
       WF_FINITE) THEN
    REWRITE_TAC [WF] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN X_GEN_TAC (← q r"l:real^N->bool") THEN
      ASM_CASES_TAC (← q r"(l:real^N->bool) IN d") THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, FINITE_RULES] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"{m:real^N->bool | m IN d /\ l SUBSET m}") THEN
      ASM_SIMP_TAC [] THEN SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"\l:real^N->bool. l IN d /\ x IN l")) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  pure { COVERING_LEMMA }

/- ------------------------------------------------------------------------- -/
/- Countable unions of intervals as non-overlapping unions; slightly larger -/
/- open intervals.  (measure.ml 3176-3312)                                  -/
/- ------------------------------------------------------------------------- -/

structure MSL where
  COUNTABLE_ELEMENTARY_DIVISION : thm
  EXPAND_CLOSED_OPEN_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupMSL [HolBase] (D : MeasureDeps) (BMSA : MSA) : ExceptT String IO MSL := do
  -- @@SCOPE BEGIN
  let { MEASURE_INTERVAL, .. } := BMSA
  let { ARITH_EQ, EMPTY_SUBSET, EMPTY_UNIONS, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXTENSION,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMP_CONJ, IMP_IMP, IN_DELETE, INTER_COMM, .. } :=
        D.ig.dv.dg.pt.cvx.core2
  let { IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, REAL_ADD_LDISTRIB,
        REAL_ADD_RID, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_LT_ADDR, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, SWAP_FORALL_THM, UNIONS_0, UNIONS_INSERT, WLOG_LE, .. } :=
        D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_DELETE, COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { DIST_0, DIST_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { DROP_VEC, FORALL_LIFT, INTERVAL_NE_EMPTY, LIFT_ADD, LIFT_CMUL, LIFT_DROP, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { midpoint, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ADD, CONTINUOUS_AT_ID, .. } := D.ig.dv.dg.pt.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_MUL, .. } := D.ig.dv.dg.pt.cvx.top3
  let { continuous_at, .. } := D.ig.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEOM_ORIGIN_TAC, INDUCT_TAC,
        MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.ig.dv.dg.pt.cvx
  let { num_RECURSION, .. } := D.ig.dv.dg.pt.qses
  let { FINITE_IMP_COUNTABLE, .. } := D.ig.dv.dg.pt.qcard
  let { prove_recursive_functions_exist, .. } := D.ig.dv.dg.pt
  let { LT, TRANSITIVE_STEPWISE_LE, .. } := D.ig.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.ig.dv.dg.qvec
  let { COUNTABLE_EMPTY, COUNTABLE_UNIONS, .. } := D.ig.qcard
  let { CONTENT_CLOSED_INTERVAL_CASES, CONTENT_EMPTY, DIVISION_OF_FINITE,
        DIVISION_OF_TRIVIAL, DIVISION_OF_UNION_SELF, ELEMENTARY_UNION_INTERVAL_STRONG, .. }
        := D.qintegration1
  let { division_of, .. } := D.qintegration3
  let { FORALL_COUNTABLE_AS_IMAGE, NUM_COUNTABLE, .. } := D.qcard
  let { PRODUCT_CLAUSES_NUMSEG, .. } := D.qproducts
  -- @@SCOPE END
  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let COUNTABLE_ELEMENTARY_DIVISION ← (do
    let lemma ← prove
     r"!s. UNIONS(s DELETE {}) = UNIONS s"
     (REWRITE_TAC [EXTENSION, IN_UNIONS, IN_DELETE] THEN
      MESON_TAC [NOT_IN_EMPTY])
    prove
     r"!d. COUNTABLE d /\ (!k. k IN d ==> ?a b:real^N. k = interval[a,b])
       ==> ?d'. COUNTABLE d' /\
                (!k. k IN d' ==> ~(k = {}) /\ ?a b. k = interval[a,b]) /\
                (!k l. k IN d' /\ l IN d' /\ ~(k = l)
                       ==> interior k INTER interior l = {}) /\
                UNIONS d' = UNIONS d"
     (REWRITE_TAC [IMP_CONJ, FORALL_COUNTABLE_AS_IMAGE] THEN
      REWRITE_TAC [UNIONS_0, EMPTY_UNIONS] THEN CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
        REWRITE_TAC [NOT_IN_EMPTY, COUNTABLE_EMPTY],
        ALL_TAC] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"d:num->real^N->bool", ← q r"a:num->real^N", ← q r"b:num->real^N"] THEN
      DISCH_TAC THEN
      CHOOSE_THEN MP_TAC (← prove_recursive_functions_exist num_RECURSION
       (← q r"x 0 = ({}:(real^N->bool)->bool) /\
    (!n. x(SUC n) = @q. (x n) SUBSET q /\
                        q division_of (d n) UNION UNIONS(x n))")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!n:num. (x n) division_of UNIONS {d k:real^N->bool | k < n}")
      ASSUME_TAC THENL
       [INDUCT_TAC THEN
        ASM_REWRITE_TAC [LT, ← SET_RULE (← q r"UNIONS {f x |x| F} = {}"),
                         DIVISION_OF_TRIVIAL] THEN
        FIRST_ASSUM (MP_TAC o SPECL [← q r"(a:num->real^N) n", ← q r"(b:num->real^N) n"] o
          MATCH_MP ELEMENTARY_UNION_INTERVAL_STRONG o
          MATCH_MP DIVISION_OF_UNION_SELF) THEN
        DISCH_THEN (ASSUME_TAC o SELECT_RULE) THEN
        REWRITE_TAC [← SET_RULE (← q r"{f x | x = a \/ q x} = f a INSERT {f x | q x}")] THEN
        REWRITE_TAC [UNIONS_INSERT] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM o lastc) THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!m n. m <= n ==> (x:num->(real^N->bool)->bool) m SUBSET x n")
      ASSUME_TAC THENL
       [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"n:num") THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(a:num->real^N) n", ← q r"(b:num->real^N) n"] o
          MATCH_MP ELEMENTARY_UNION_INTERVAL_STRONG o
          MATCH_MP DIVISION_OF_UNION_SELF o SPEC (← q r"n:num")) THEN
        DISCH_THEN (ASSUME_TAC o SELECT_RULE) THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE x (:num)) DELETE ({}:real^N->bool)") THEN
      REWRITE_TAC [COUNTABLE_DELETE, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                   FORALL_IN_UNIONS, FORALL_IN_IMAGE, IN_DELETE, IN_UNIV] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COUNTABLE_UNIONS THEN
        SIMP_TAC [COUNTABLE_IMAGE, NUM_COUNTABLE, FORALL_IN_IMAGE, IN_UNIV] THEN
        GEN_TAC THEN MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN
        ASM_MESON_TAC [DIVISION_OF_FINITE],
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"k:real^N->bool"] THEN
        ASM_MESON_TAC [division_of],
        REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
        GEN_REWRITE_TAC BINDER_CONV [SWAP_FORALL_THM] THEN
        MATCH_MP_TAC WLOG_LE THEN
        CONJ_TAC THENL [MESON_TAC [INTER_COMM], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"l:real^N->bool"] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m:num", ← q r"n:num"]) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of] o
          SPEC (← q r"n:num")) THEN ASM SET_TAC [],
        REWRITE_TAC [lemma] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, IN_UNIV,
                     FORALL_IN_UNIONS, SUBSET, IN_UNIONS, EXISTS_IN_IMAGE]
        THENL
         [X_GEN_TAC (← q r"k:real^N->bool") THEN DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
          X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of] o
             SPEC (← q r"n:num")) THEN
          DISCH_THEN (MP_TAC o lastc) THEN ASM SET_TAC [],
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"y:real^N"] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of] o
             SPEC (← q r"SUC n")) THEN
          DISCH_THEN (MP_TAC o lastc) THEN
          REWRITE_TAC [EXTENSION, IN_UNIONS, EXISTS_IN_GSPEC] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N")) THEN
          ASM_MESON_TAC [← ARITH_RULE (← q r"n < SUC n")]]]))

  let EXPAND_CLOSED_OPEN_INTERVAL ← (do
    let lemma ← prove
     r"!f n. (\x. lift(product(1..n) (\i. f i + drop x))) continuous at (vec 0)"
     (GEN_TAC THEN INDUCT_TAC THEN
      REWRITE_TAC [PRODUCT_CLAUSES_NUMSEG, ARITH_EQ, CONTINUOUS_CONST] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n")] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_MUL THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [o_DEF, LIFT_ADD, LIFT_DROP] THEN
      SIMP_TAC [CONTINUOUS_ADD, CONTINUOUS_AT_ID, CONTINUOUS_CONST])
    prove
     r"!a b:real^N e.
        &0 < e
        ==> ?c d. interval[a,b] SUBSET interval(c,d) /\
                  measure(interval(c,d)) <= measure(interval[a,b]) + e"
     (REPEAT GEN_TAC THEN ABBREV_TAC (← q r"m:real^N = midpoint(a,b)") THEN
      POP_ASSUM MP_TAC THEN GEOM_ORIGIN_TAC (← q r"m:real^N") THEN
      REWRITE_TAC [midpoint, ← VECTOR_ARITH
       (← q r"inv(&2) % (a + b):real^N = vec 0 <=> a = --b")] THEN
      REPEAT GEN_TAC THEN DISCH_THEN SUBST1_TAC THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"interval[--b:real^N,b] = {}") THENL
       [MAP_EVERY EXISTS_TAC [← q r"--b:real^N", ← q r"b:real^N"] THEN
        REWRITE_TAC [MEASURE_INTERVAL] THEN
        ASM_REWRITE_TAC [CONTENT_EMPTY, EMPTY_SUBSET] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INTERVAL_NE_EMPTY]) THEN
      REWRITE_TAC [VECTOR_NEG_COMPONENT, ← REAL_ARITH (← q r"--x <= x <=> &0 <= x")] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"\i. &2 * (b:real^N)$i", ← q r"dimindex(:N)"] lemma) THEN
      REWRITE_TAC [continuous_at, DIST_LIFT, FORALL_LIFT, DIST_0, DROP_VEC] THEN
      REWRITE_TAC [NORM_LIFT, LIFT_DROP, REAL_ADD_RID] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"--(b + k / &4 % vec 1:real^N)", ← q r"b + k / &4 % vec 1:real^N"] THEN
      REWRITE_TAC [MEASURE_INTERVAL, SUBSET_INTERVAL,
                   CONTENT_CLOSED_INTERVAL_CASES] THEN
      REWRITE_TAC [VECTOR_NEG_COMPONENT, VECTOR_ADD_COMPONENT,
                   VECTOR_MUL_COMPONENT, VEC_COMPONENT, REAL_MUL_RID] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"--x <= x <=> &0 <= x"), REAL_LT_ADDR,
                    ← REAL_ARITH (← q r"&0 < k / &4 <=> &0 < k"),
                    ← REAL_ARITH (← q r"&0 <= b /\ &0 < k ==> --(b + k) < b"),
                    ← REAL_ARITH (← q r"&0 <= b /\ &0 < k ==> --(b + k) < --b"),
                    ← REAL_ARITH (← q r"&0 <= b /\ &0 < k ==> &0 <= b + k")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"b - --b = &2 * b"), REAL_ADD_LDISTRIB] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"abs(a - b) < e ==> a <= b + e")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC))

  pure { COUNTABLE_ELEMENTARY_DIVISION, EXPAND_CLOSED_OPEN_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Outer and inner approximation of measurable set by well-behaved sets:   -/
/- the bounded case.  (measure.ml 3313-3514)                                -/
/- ------------------------------------------------------------------------- -/

structure MSM where
  MEASURABLE_OUTER_INTERVALS_BOUNDED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSM [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSF : MSF) (BMSG : MSG) (BMSK : MSK) : ExceptT String IO MSM := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE, INTEGRAL_MEASURE_UNIV, measurable, MEASURABLE_INTER,
        MEASURABLE_INTERVAL, MEASURE_SUBSET, MEASURE_UNIQUE, .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_EMPTY, MEASURE_EMPTY, MEASURE_NEGLIGIBLE_UNIONS_IMAGE,
        MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG, NEGLIGIBLE_INTERVAL, .. } := BMSB
  let { HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS, .. } := BMSF
  let { MEASURABLE_ELEMENTARY, MEASURE_ELEMENTARY, .. } := BMSG
  let { COVERING_LEMMA, .. } := BMSK
  let { ARITH, CONJ_ASSOC, DIMINDEX_1, ETA_AX, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_SUBSET, IMP_CONJ, IMP_IMP, INTER_UNIONS, ..
        } := D.ig.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_INTER, IN_SING, IN_UNIV, MONO_EXISTS, NOT_IN_EMPTY, PAIR_EQ,
        REAL_ADD_LID, REAL_DIV_1, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM,
        SUBSET, SUBSET_EMPTY, SUBSET_REFL, .. } := D.ig.dv.dg.pt.cvx.core5
  let { o_DEF, real_pow, SUBSET_UNIV, UNION_EMPTY, UNIONS_0, .. } := D.ig.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_VEC, DROP_VSUM, LIFT_DROP, LIFT_SUB, .. } :=
        D.ig.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { drop, VSUM_EQ, VSUM_IMAGE, VSUM_SUB, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.ig.dv.dg.pt.cvx.met
  let { INTERIOR_CLOSED_INTERVAL, INTERIOR_EMPTY, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { UNIONS_1, .. } := D.ig.dv.dg.pt.qses
  let { LIFT_SUM, .. } := D.ig.dv.dg.qvec
  let { INFINITE, .. } := D.ig.dv.qsession
  let { sums, .. } := D.ig.dv.qtopology2
  let { COUNTABLE_AS_INJECTIVE_IMAGE, COUNTABLE_EMPTY, COUNTABLE_SING, .. } := D.ig.qcard
  let { EQ_INTERVAL, .. } := D.ig.qtopology
  let { VSUM_COMPONENT, .. } := D.ig.qvec
  let { HAS_INTEGRAL_EQ, HAS_INTEGRAL_INTEGRABLE, HAS_INTEGRAL_RESTRICT_UNIV,
        HENSTOCK_LEMMA_PART1, .. } := D.qintegration2
  let { division_of, fine, has_integral, INTEGRAL_RESTRICT_UNIV, INTEGRAL_UNIQUE,
        NEGLIGIBLE_FRONTIER_INTERVAL, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION,
        tagged_partial_division_of, .. } := D.qintegration3
  let { FROM_INTER_NUMSEG, .. } := D.qmisc
  let { LIM_COMPONENT_UBOUND, .. } := D.qtopology2
  -- @@SCOPE END

  let MEASURABLE_OUTER_INTERVALS_BOUNDED ← (do
    let lemma ← prove
     r"(!x y. (x,y) IN IMAGE (\z. f z,g z) s ==> P x y) <=>
     (!z. z IN s ==> P (f z) (g z))"
     (REWRITE_TAC [IN_IMAGE, PAIR_EQ] THEN MESON_TAC [])
    prove
     r"!s a b:real^N e.
        measurable s /\ s SUBSET interval[a,b] /\ &0 < e
        ==> ?d. COUNTABLE d /\
                (!k. k IN d ==> k SUBSET interval[a,b] /\ ~(k = {}) /\
                                (?c d. k = interval[c,d])) /\
                (!k1 k2. k1 IN d /\ k2 IN d /\ ~(k1 = k2)
                         ==> interior k1 INTER interior k2 = {}) /\
                (!u v. interval[u,v] IN d
                       ==> ?n. !i. 1 <= i /\ i <= dimindex(:N)
                                   ==> v$i - u$i = (b$i - a$i) / &2 pow n) /\
                (!k. k IN d /\ ~(interval(a,b) = {}) ==> ~(interior k = {})) /\
                s SUBSET UNIONS d /\
                measurable (UNIONS d) /\
                measure (UNIONS d) <= measure s + e"
     (REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
       [ASM_REWRITE_TAC [SUBSET_EMPTY] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"{}:(real^N->bool)->bool") THEN
        ASM_REWRITE_TAC [NOT_IN_EMPTY, UNIONS_0, MEASURE_EMPTY, REAL_ADD_LID,
                         SUBSET_REFL, COUNTABLE_EMPTY, MEASURABLE_EMPTY] THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE],
        ALL_TAC] THEN
      STRIP_TAC THEN ASM_CASES_TAC (← q r"interval(a:real^N,b) = {}") THEN
      ASM_REWRITE_TAC [] THENL
       [EXISTS_TAC (← q r"{interval[a:real^N,b]}") THEN
        REWRITE_TAC [UNIONS_1, COUNTABLE_SING] THEN
        ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_INSERT,
                         NOT_IN_EMPTY, SUBSET_REFL, MEASURABLE_INTERVAL] THEN
        CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
         [ASM_REWRITE_TAC [IN_SING, EQ_INTERVAL] THEN
          REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"0") THEN
          ASM_REWRITE_TAC [real_pow, REAL_DIV_1],
          SUBGOAL_THEN
           (← q r"measure(interval[a:real^N,b]) = &0 /\ measure(s:real^N->bool) = &0")
           (fun th => ASM_SIMP_TAC [th, REAL_LT_IMP_LE, REAL_ADD_LID]) THEN
          SUBGOAL_THEN
            (← q r"interval[a:real^N,b] has_measure &0 /\
         (s:real^N->bool) has_measure &0")
            (fun th => MESON_TAC [th, MEASURE_UNIQUE]) THEN
          REWRITE_TAC [HAS_MEASURE_0] THEN
          MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
           [ASM_REWRITE_TAC [NEGLIGIBLE_INTERVAL],
            ASM_MESON_TAC [NEGLIGIBLE_SUBSET]]],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [measurable]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"m:real")) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP MEASURE_UNIQUE) THEN
      SUBGOAL_THEN
       (← q r"((\x:real^N. if x IN s then vec 1 else vec 0) has_integral (lift m))
    (interval[a,b])")
      ASSUME_TAC THENL
       [ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HAS_MEASURE]) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_EQ) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HAS_INTEGRAL_INTEGRABLE) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [has_integral]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^N->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"s:real^N->bool",
                       ← q r"g:real^N->real^N->bool"] COVERING_LEMMA) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:(real^N->bool)->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [INTERIOR_EMPTY], ALL_TAC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"(\x. if x IN s then vec 1 else vec 0):real^N->real^1",
                        ← q r"a:real^N", ← q r"b:real^N", ← q r"g:real^N->real^N->bool",
                        ← q r"e:real"]
                    HENSTOCK_LEMMA_PART1) THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (LABEL_TAC "*") THEN
      SUBGOAL_THEN
       (← q r"!k l:real^N->bool. k IN d /\ l IN d /\ ~(k = l)
                       ==> negligible(k INTER l)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:real^N->bool", ← q r"l:real^N->bool"]) THEN
        ASM_SIMP_TAC [] THEN
        SUBGOAL_THEN
         (← q r"?x y:real^N u v:real^N. k = interval[x,y] /\ l = interval[u,v]")
        MP_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
        DISCH_THEN (REPEAT_TCL CHOOSE_THEN (CONJUNCTS_THEN SUBST_ALL_TAC)) THEN
        REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN DISCH_TAC THEN
        MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"(interval[x:real^N,y] DIFF interval(x,y)) UNION
                (interval[u:real^N,v] DIFF interval(u,v)) UNION
                (interval (x,y) INTER interval (u,v))") THEN
        CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
        ASM_REWRITE_TAC [UNION_EMPTY] THEN
        SIMP_TAC [NEGLIGIBLE_UNION, NEGLIGIBLE_FRONTIER_INTERVAL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!D. FINITE D /\ D SUBSET d
         ==> measurable(UNIONS D :real^N->bool) /\ measure(UNIONS D) <= m + e")
      ASSUME_TAC THENL
       [GEN_TAC THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"?t:(real^N->bool)->real^N. !k. k IN D ==> t(k) IN (s INTER k) /\
                                                k SUBSET (g(t k))")
        (CHOOSE_THEN (LABEL_TAC "+")) THENL
         [REWRITE_TAC [← GSYM SKOLEM_THM] THEN ASM SET_TAC [], ALL_TAC] THEN
        REMOVE_THEN "*" (MP_TAC o SPEC
         (← q r"IMAGE (\k. (t:(real^N->bool)->real^N) k,k) D")) THEN
        ASM_SIMP_TAC [VSUM_IMAGE, PAIR_EQ] THEN REWRITE_TAC [o_DEF] THEN
        ANTS_TAC THENL
         [REWRITE_TAC [tagged_partial_division_of, fine] THEN
          ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [lemma, RIGHT_FORALL_IMP_THM, IMP_CONJ, PAIR_EQ] THEN
          ASM_SIMP_TAC [] THEN
          CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [SUBSET]],
          ALL_TAC] THEN
        USE_THEN "+" (MP_TAC o REWRITE_RULE [IN_INTER]) THEN
        SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
        ASM_SIMP_TAC [VSUM_SUB] THEN
        SUBGOAL_THEN (← q r"D division_of (UNIONS D:real^N->bool)") ASSUME_TAC THENL
         [REWRITE_TAC [division_of] THEN ASM SET_TAC [], ALL_TAC] THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP MEASURABLE_ELEMENTARY) THEN
        SUBGOAL_THEN (← q r"vsum D (\k:real^N->bool. content k % vec 1) =
                  lift(measure(UNIONS D))")
        SUBST1_TAC THENL
         [ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
          ASM_SIMP_TAC [LIFT_DROP, DROP_VSUM, o_DEF, DROP_CMUL, DROP_VEC] THEN
          SIMP_TAC [REAL_MUL_RID, ETA_AX] THEN ASM_MESON_TAC [MEASURE_ELEMENTARY],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"vsum D (\k. integral k (\x:real^N. if x IN s then vec 1 else vec 0)) =
      lift(sum D (\k. measure(k INTER s)))")
        SUBST1_TAC THENL
         [ASM_SIMP_TAC [LIFT_SUM, o_DEF] THEN MATCH_MP_TAC VSUM_EQ THEN
          X_GEN_TAC (← q r"k:real^N->bool") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
          SUBGOAL_THEN (← q r"measurable(k:real^N->bool)") ASSUME_TAC THENL
           [ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL], ALL_TAC] THEN
          ASM_SIMP_TAC [← GSYM INTEGRAL_MEASURE_UNIV, MEASURABLE_INTER] THEN
          REWRITE_TAC [← MESON [IN_INTER]
            (← q r"(if x IN k INTER s then a else b) =
         (if x IN k then if x IN s then a else b else b)")] THEN
          REWRITE_TAC [INTEGRAL_RESTRICT_UNIV],
          ALL_TAC] THEN
        ASM_REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"y <= m ==> abs(x - y) <= e ==> x <= m + e")) THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"measure(UNIONS D INTER s:real^N->bool)") THEN
        CONJ_TAC THENL
         [ALL_TAC,
          EXPAND_TAC "m" THEN MATCH_MP_TAC MEASURE_SUBSET THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
          MATCH_MP_TAC MEASURABLE_INTER THEN ASM_REWRITE_TAC []] THEN
        REWRITE_TAC [INTER_UNIONS] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC MEASURE_NEGLIGIBLE_UNIONS_IMAGE_STRONG THEN
        ASM_SIMP_TAC [FINITE_RESTRICT] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [SUBSET, MEASURABLE_INTERVAL, MEASURABLE_INTER],
          ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"l:real^N->bool"] THEN
        STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
        EXISTS_TAC (← q r"k INTER l:real^N->bool") THEN ASM_SIMP_TAC [] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"FINITE(d:(real^N->bool)->bool)") THENL
       [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"d:(real^N->bool)->bool") COUNTABLE_AS_INJECTIVE_IMAGE) THEN
      ASM_REWRITE_TAC [INFINITE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:num->real^N->bool")
       (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC)) THEN
      MP_TAC (← ISPECL [← q r"s:num->real^N->bool", ← q r"m + e:real"]
        HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS) THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a /\ b ==> c) ==> (a ==> b) ==> c")) THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IMP_CONJ, RIGHT_FORALL_IMP_THM,
                                    FORALL_IN_IMAGE, IN_UNIV]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]) THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [MEASURABLE_INTERVAL, MEASURABLE_INTER],
        ASM_MESON_TAC [],
        X_GEN_TAC (← q r"n:num") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (s:num->real^N->bool) (0..n)")) THEN
        SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IMAGE_SUBSET, SUBSET_UNIV] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= e ==> y <= e")) THEN
        MATCH_MP_TAC MEASURE_NEGLIGIBLE_UNIONS_IMAGE THEN
        ASM_MESON_TAC [FINITE_NUMSEG, MEASURABLE_INTERVAL],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM (← CONJUNCT2 LIFT_DROP)] THEN
      REWRITE_TAC [drop] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_COMPONENT_UBOUND) THEN
      EXISTS_TAC
       (← q r"\n. vsum(from 0 INTER (0..n)) (\n. lift(measure(s n:real^N->bool)))") THEN
      ASM_REWRITE_TAC [← GSYM sums, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      REWRITE_TAC [DIMINDEX_1, ARITH, EVENTUALLY_SEQUENTIALLY] THEN
      SIMP_TAC [VSUM_COMPONENT, ARITH, DIMINDEX_1] THEN
      ASM_REWRITE_TAC [← GSYM drop, LIFT_DROP, FROM_INTER_NUMSEG]))

  pure { MEASURABLE_OUTER_INTERVALS_BOUNDED }

/- ------------------------------------------------------------------------- -/
/- Outer approximation of a measurable set by countable unions of closed   -/
/- and of open intervals.  (measure.ml 3515-3786)                           -/
/- ------------------------------------------------------------------------- -/

structure MSN where
  MEASURABLE_OUTER_CLOSED_INTERVALS : thm
  MEASURABLE_OUTER_OPEN_INTERVALS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupMSN [HolBase] (D : MeasureDeps) (BMSA : MSA) (BMSB : MSB) (BMSF : MSF) (BMSG : MSG) (BMSJ : MSJ) (BMSL : MSL) (BMSM : MSM) : ExceptT String IO MSN := do
  -- @@SCOPE BEGIN
  let { HAS_MEASURE_MEASURABLE_MEASURE, MEASURABLE_INTER, MEASURABLE_INTERVAL,
        MEASURE_SUBSET, .. } := BMSA
  let { HAS_MEASURE_0, MEASURABLE_DIFF, MEASURABLE_UNIONS, MEASURE_DISJOINT_UNIONS_IMAGE,
        MEASURE_EMPTY, MEASURE_NEGLIGIBLE_UNIONS_IMAGE, .. } := BMSB
  let { HAS_MEASURE_COUNTABLE_NEGLIGIBLE_UNIONS, MEASURE_COUNTABLE_UNIONS_LE, .. } := BMSF
  let { MEASURE_INTERIOR, .. } := BMSG
  let { MEASURABLE_BALL, NEGLIGIBLE_CONVEX_FRONTIER, .. } := BMSJ
  let { COUNTABLE_ELEMENTARY_DIVISION, EXPAND_CLOSED_OPEN_INTERVAL, .. } := BMSL
  let { MEASURABLE_OUTER_INTERVALS_BOUNDED, .. } := BMSM
  let { CONJ_ASSOC, DISJOINT, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE,
        FINITE_NUMSEG, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.ig.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_DELETE, IN_DIFF, INTER_COMM, INTER_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, IN_UNIV, LE_1, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_INV_POW, REAL_LE_ADD2, REAL_LE_DIV, REAL_LE_MUL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_POW2, .. } :=
        D.ig.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_POS, REAL_POW_LE,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, .. } := D.ig.dv.dg.pt.cvx.core5
  let { num_WOP, real_div, SUBSET_UNIV, SUM_ADD_NUMSEG, SUM_LE_NUMSEG, SUM_LMUL, SUM_RMUL,
        UNIONS_0, UNIONS_IMAGE, .. } := D.ig.dv.dg.pt.cvx.core6
  let { COUNTABLE_DELETE, COUNTABLE_IMAGE, .. } := D.ig.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.ig.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.ig.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.ig.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.ig.dv.dg.pt.cvx.vec3
  let { VEC_COMPONENT, VECTOR_NEG_COMPONENT, .. } := D.ig.dv.dg.pt.cvx.vec4
  let { IN_BALL_0, INTERIOR_EMPTY, INTERIOR_INTER, .. } := D.ig.dv.dg.pt.cvx.top4
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.ig.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.ig.dv.dg.pt.qses
  let { BOUNDED_INTER, BOUNDED_INTERVAL, SUBSET_BALL, .. } := D.ig.dv.dg.pt.qtop
  let { CONVEX_INTER, .. } := D.ig.dv.dg.pt.qcvx2
  let { CONVEX_INTERVAL, .. } := D.ig.dv.dg.qconvex
  let { LT, SUB_ADD, SUBSET_UNIONS, WLOG_LT, .. } := D.ig.dv.dg.qsession
  let { INFINITE, .. } := D.ig.dv.qsession
  let { COUNTABLE_AS_INJECTIVE_IMAGE, COUNTABLE_UNIONS, .. } := D.ig.qcard
  let { SUM_GP, .. } := D.ig.qmisc
  let { FINITE_HAS_SIZE, REAL_POW_ADD, .. } := D.ig.qsession
  let { EMPTY_AS_INTERVAL, .. } := D.ig.qtopology
