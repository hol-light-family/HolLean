  let { REAL_NEG_GT0, .. } := D.qsession
  let { differentiable, DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on,
        HAS_DERIVATIVE_WITHIN_SUBSET, .. } := D.ig.qderivatives
  let { REAL_ABS_ZERO, .. } := D.ig.qsession
  let { LIM_DROP_UBOUND, .. } := D.ig.qtopology
  let { indicator, .. } := D.ig.qvec
  let { REAL_ABS_ABS, REAL_ABS_NZ, .. } := D.ig.dv.qsession
  let { OPEN_DELETE, .. } := D.ig.dv.dg.qtopology2
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.ig.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.ig.dv.dg.pt.qvec
  let { COND_ID, COND_RAND, CONJ_SYM, DE_MORGAN_THM, DIMINDEX_1, EQ_IMP, ETA_AX, EXTENSION,
        FINITE_IMAGE, FINITE_SUBSET, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.ig.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, FUN_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, IN_DELETE,
        INTER_COMM, .. } := D.ig.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_SING, IN_UNION, IN_UNIV, LE_REFL, MONO_AND, MONO_EXISTS,
        MONO_FORALL, NOT_IMP, NOT_IN_EMPTY, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.ig.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_MUL_EQ,
        REAL_LT_REFL, .. } := D.ig.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_SYM, REAL_NEG_GE0, REAL_POS,
        RIGHT_AND_EXISTS_THM, RIGHT_AND_FORALL_THM, SIMPLE_IMAGE, SUBSET_REFL,
