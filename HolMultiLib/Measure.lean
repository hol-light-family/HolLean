  let MEASURABLE_ON_CONVOLUTION ← prove
   r"!bop:real^N->real^P->real^Q f:real^M->real^N g:real^M->real^P x.
        bilinear bop /\ f measurable_on (:real^M) /\ g measurable_on (:real^M)
