        REAL_ARITH_TAC] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      ABBREV_TAC
        (← q r"t = \n. {x | x IN s /\
                      &n * e <= abs(det(matrix(f'(x:real^N)):real^N^N)) /\
                      abs(det(matrix(f' x))) < (&n + &1) * e}") THEN
      SUBGOAL_THEN
       (← q r"!n. measurable((t:num->real^N->bool) n)")
      ASSUME_TAC THENL
       [GEN_TAC THEN EXPAND_TAC "t" THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x /\ Q x} =
