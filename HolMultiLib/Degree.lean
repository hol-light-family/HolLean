  let { COUNTABLE_INTER, .. } := D.qcard
  let { RATIONAL_NUM, .. } := D.qfloor
  let { CLOPEN_IN_EQ_FRONTIER_OF, CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_SUBTOPOLOGY, CLOSURE_OF_SUBTOPOLOGY_OPEN, INTERIOR_OF_CLOSURE_OF,
        INTERIOR_OF_EMPTY, INTERIOR_OF_FRONTIER_OF_EMPTY, INTERIOR_OF_OPEN_IN,
        INTERIOR_OF_SUBTOPOLOGY_MONO, OPEN_IN_SUBSET, SUBTOPOLOGY_SUBTOPOLOGY, .. } :=
        D.qmetric
  let { COUNTABLE_RATIONAL_COORDINATES, .. } := D.qmisc
  let { DIMENSION_EMPTY, DIMENSION_EQ_MINUS1, DIMENSION_INSERT, DIMENSION_LE_AFF_DIM,
        DIMENSION_LE_DIMINDEX, DIMENSION_LE_EQ_GENERAL, DIMENSION_LE_MINUS1,
        DIMENSION_LE_RATIONAL_COORDINATES, DIMENSION_LE_UNIONS_ZERODIMENSIONAL,
        DIMENSION_LINEAR_IMAGE, DIMENSION_SING, DIMENSION_SUBSET, DIMENSION_UNION_LE_BASIC,
        HOMEOMORPHIC_DIMENSION, HOMEOMORPHISM_MOVING_DENSE_COUNTABLE_SUBSETS_EXISTS, .. } :=
        D.qpaths1
  let { RELATIVE_FRONTIER_CONVEX_INTER_AFFINE, .. } := D.qpaths2
  let { IMAGE_DIFF_INJ_ALT, LE_0, REAL_ABS_POW, SUB_0, SUBSET_CARD_EQ, SUBSET_NUMSEG, .. }
