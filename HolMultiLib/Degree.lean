  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. }
        := D.pt.cvx.top3
  let { OPEN_IN_REFL, SETDIST_EQ_0_CLOSED_IN, SETDIST_POS_LE, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { CARD_IMAGE_LE, .. } := D.pt.qses
  let { CLOSED_UNIONS, SETDIST_SING_IN_SET, .. } := D.pt.qtop
  let { CONVEX_INTER, .. } := D.pt.qcvx2
  let { CONVEX_SING, .. } := D.pt.qcvx3
  let { WF_INDUCT_TAC, .. } := D.pt
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER, CLOSED_IN_SUBSET_TRANS, OPEN_IN_UNION, .. }
