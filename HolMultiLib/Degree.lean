      ASM_REWRITE_TAC [COMPACT_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
      ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"u:real^M->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) HOMOTOPIC_WITH_EUCLIDEAN_ALT o
        snd) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      EXISTS_TAC (← q r"h:real^(1,M)finite_sum->real^N") THEN
      ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           CONTINUOUS_ON_SUBSET)),
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"IMAGE h u2 SUBSET v ==> u SUBSET u2 ==> IMAGE h u SUBSET v")))] THEN
        ASM_REWRITE_TAC [],
        ONCE_REWRITE_TAC [CONJ_ASSOC]] THEN
      SUBGOAL_THEN (← q r"!x:real^M. x IN u ==> x IN s") MP_TAC THENL
       [ASM_MESON_TAC [SUBSET, OPEN_IN_IMP_SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!x:real^M. x IN t ==> x IN c") MP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [IN_INSERT] THEN REPEAT DISCH_TAC THEN EXPAND_TAC "fg" THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, VEC_EQ, ARITH_EQ] THEN
      ASM SET_TAC []])

  pure { AR, ANR, ENR, AR_IMP_ABSOLUTE_EXTENSOR, AR_IMP_ABSOLUTE_RETRACT,
         AR_IMP_ABSOLUTE_RETRACT_UNIV, ABSOLUTE_EXTENSOR_IMP_AR, AR_EQ_ABSOLUTE_EXTENSOR,
         AR_IMP_RETRACT, HOMEOMORPHIC_ARNESS, AR_TRANSLATION, AR_LINEAR_IMAGE_EQ,
         HOMEOMORPHISM_ARNESS, ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR,
         ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT,
         ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV,
         ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR, ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR,
         ANR_IMP_ABSOLUTE_CLOSED_NEIGHBOURHOOD_RETRACT,
         ANR_IMP_ABSOLUTE_CLOSED_NEIGHBOURHOOD_EXTENSOR, ANR_IMP_NEIGHBOURHOOD_RETRACT,
         ANR_IMP_CLOSED_NEIGHBOURHOOD_RETRACT, HOMEOMORPHIC_ANRNESS, ANR_TRANSLATION,
         ANR_LINEAR_IMAGE_EQ, HOMEOMORPHISM_ANRNESS, HOMOTOPIC_ON_NEIGHBOURHOOD_INTO_ANR }

/- ------------------------------------------------------------------------- -/
/- Analogous properties of ENRs; some relations among the concepts.         -/
/- (degree.ml 3171-3430)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DGG where
  ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT : thm
  ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV : thm
  HOMEOMORPHIC_ENRNESS : thm
  ENR_TRANSLATION : thm
  ENR_LINEAR_IMAGE_EQ : thm
  HOMEOMORPHISM_ENRNESS : thm
  AR_IMP_ANR : thm
  ENR_IMP_ANR : thm
  ENR_ANR : thm
  AR_ANR : thm
  ANR_RETRACT_OF_ANR : thm
  AR_RETRACT_OF_AR : thm
  ENR_RETRACT_OF_ENR : thm
  RETRACT_OF_UNIV : thm
  COMPACT_AR : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGG [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) : ExceptT String IO DGG := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_CLOSED, RETRACT_OF_CONTRACTIBLE, RETRACT_OF_EMPTY,
        RETRACT_OF_LOCALLY_COMPACT, RETRACT_OF_TRANS, retraction, .. } := BDGB
  let { ABSOLUTE_EXTENSOR_IMP_AR, ANR, ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR, AR,
        AR_EQ_ABSOLUTE_EXTENSOR, AR_IMP_ABSOLUTE_RETRACT, ENR, .. } := BDGF
  let { DIMINDEX_1, DIMINDEX_FINITE_SUM, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_UNWIND_THM2, IMAGE_o, IMP_CONJ, IN_DIFF,
        INT_OF_NUM_ADD, .. } := D.pt.cvx.core2
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        PASTECART_IN_PCROSS, .. } := D.pt.cvx.core3
  let { REAL_POS, SUBSET, .. } := D.pt.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, UNIV_NOT_EMPTY, .. } := D.pt.cvx.core6
  let { DROP_VEC, .. } := D.pt.cvx.vec2
  let { CLOSED_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV, .. } :=
        D.pt.cvx.met
  let { CLOSED_IN, CLOSED_IN_CLOSED, CLOSED_UNIV, .. } := D.pt.cvx.top1
  let { COMPACT_IMP_CLOSED, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_REFL, .. } :=
        D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, .. } := D.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_IN, OPEN_IN_OPEN_INTER, OPEN_IN_REFL, SEGMENT_1,
        .. } := D.pt.cvx.top5
  let { add_linear_invariants, add_translation_invariants, ARITH_TAC, ASM_MESON_TAC,
        INT_ARITH, MESON_TAC, SET_TAC, .. } := D.pt.cvx
  let { CLOSED_IN_REFL, .. } := D.pt.qtop
  let { AFF_DIM_LE_UNIV, .. } := D.pt.qcvx1
  let { CONVEX_UNIV, .. } := D.pt.qcvx3
  let { DUGUNDJI, TIETZE_UNBOUNDED, .. } := D.qconvex
  let { CLOSED_IN_EMPTY, CLOSED_IN_IMP_SUBSET, .. } := D.qmetric
  let { CONVEX_IMP_CONTRACTIBLE, HOMEOMORPHIC_CLOSED_IN_CONVEX, HOMEOMORPHIC_CONTRACTIBLE,
        HOMOTOPIC_WITH_EUCLIDEAN, .. } := D.qpaths1
  let { contractible, LOCALLY_COMPACT_HOMEOMORPHIC_CLOSED, .. } := D.qpaths2
  let { CONTINUOUS_ON_CASES_LOCAL, CONTINUOUS_ON_PASTECART, .. } := D.qtopology1
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, HOMEOMORPHIC_LOCAL_COMPACTNESS,
        HOMEOMORPHIC_TRANSLATION_SELF, LOCALLY_COMPACT_CLOSED_IN_OPEN,
        OPEN_IMP_LOCALLY_COMPACT, SEPARATION_NORMAL_LOCAL, URYSOHN_LOCAL, .. } :=
        D.qtopology2
  -- @@SCOPE END

  let ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT ← prove
   r"!s:real^M->bool s':real^N->bool u.
        ENR s /\ s homeomorphic s' /\ s' SUBSET u
        ==> ?t'. open_in (subtopology euclidean u) t' /\ s' retract_of t'"
   (REWRITE_TAC [ENR, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"X:real^M->bool", ← q r"Y:real^N->bool",
      ← q r"K:real^N->bool", ← q r"U:real^M->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"locally compact (Y:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [RETRACT_OF_LOCALLY_COMPACT,
                     OPEN_IMP_LOCALLY_COMPACT, HOMEOMORPHIC_LOCAL_COMPACTNESS],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?W:real^N->bool.
          open_in (subtopology euclidean K) W /\
          closed_in (subtopology euclidean W) Y")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (X_CHOOSE_THEN (← q r"W:real^N->bool") STRIP_ASSUME_TAC o
          MATCH_MP LOCALLY_COMPACT_CLOSED_IN_OPEN) THEN
      EXISTS_TAC (← q r"K INTER W:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, CLOSED_IN_CLOSED] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CLOSED_IN_CLOSED]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    REWRITE_TAC [homeomorphism] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^M", ← q r"W:real^N->bool", ← q r"Y:real^N->bool"]
          TIETZE_UNBOUNDED) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->real^M") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{x | x IN W /\ (h:real^N->real^M) x IN U}") THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"W:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"(:real^M)") THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, SUBSET_UNIV],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, retract_of, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^M->real^M") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o r o (h:real^N->real^M)") THEN
    SUBGOAL_THEN
     (← q r"(W:real^N->bool) SUBSET K /\ Y SUBSET W")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSED_IN_IMP_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [IMAGE_o, o_THM] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC) THEN
    REWRITE_TAC [IMAGE_o] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  let ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV ← prove
   r"!s:real^M->bool s':real^N->bool.
        ENR s /\ s homeomorphic s' ==> ?t'. open t' /\ s' retract_of t'"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    MATCH_MP_TAC ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT THEN
    ASM_MESON_TAC [SUBSET_UNIV])

  let HOMEOMORPHIC_ENRNESS ← prove
   r"!s:real^M->bool t:real^N->bool.
      s homeomorphic t ==> (ENR s <=> ENR t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [ENR] THENL
     [MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV),
      MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"s:real^M->bool"]
          ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV)] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  let ENR_TRANSLATION ← prove
   r"!a:real^N s. ENR(IMAGE (\x. a + x) s) <=> ENR s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ENRNESS THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  add_translation_invariants [ENR_TRANSLATION]

  let ENR_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (ENR(IMAGE f s) <=> ENR s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ENRNESS THEN
    ASM_MESON_TAC [HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF])

  add_linear_invariants [ENR_LINEAR_IMAGE_EQ]

  let HOMEOMORPHISM_ENRNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (ENR(IMAGE f k) <=> ENR k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ENRNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- Some relations among the concepts. We also relate AR to being a retract -/
  /- of UNIV, which is often a more convenient proxy in the closed case.     -/
  /- ----------------------------------------------------------------------- -/

  let AR_IMP_ANR ← prove
   r"!s:real^N->bool. AR s ==> ANR s"
   (REWRITE_TAC [AR, ANR] THEN MESON_TAC [OPEN_IN_REFL, CLOSED_IN_IMP_SUBSET])

  let ENR_IMP_ANR ← prove
   r"!s:real^N->bool. ENR s ==> ANR s"
   (REWRITE_TAC [ANR] THEN
    MESON_TAC [ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT, CLOSED_IN_IMP_SUBSET])

  let ENR_ANR ← prove
   r"!s:real^N->bool. ENR s <=> ANR s /\ locally compact s"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN ASM_SIMP_TAC [ENR_IMP_ANR] THENL
     [ASM_MESON_TAC [ENR, RETRACT_OF_LOCALLY_COMPACT, OPEN_IMP_LOCALLY_COMPACT],
      SUBGOAL_THEN
       (← q r"?t. closed t /\
            (s:real^N->bool) homeomorphic (t:real^(N,1)finite_sum->bool)")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC LOCALLY_COMPACT_HOMEOMORPHIC_CLOSED THEN
        ASM_REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN ARITH_TAC,
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [ANR]) THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"(:real^(N,1)finite_sum)", ← q r"t:real^(N,1)finite_sum->bool"]) THEN
        ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN, ← GSYM OPEN_IN] THEN
        REWRITE_TAC [← GSYM ENR] THEN ASM_MESON_TAC [HOMEOMORPHIC_ENRNESS]]])

  let AR_ANR ← prove
   r"!s:real^N->bool. AR s <=> ANR s /\ contractible s /\ ~(s = {})"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [AR_IMP_ANR] THENL
     [CONJ_TAC THENL
       [ALL_TAC,
        ASM_MESON_TAC [AR, HOMEOMORPHIC_EMPTY, RETRACT_OF_EMPTY,
             FORALL_UNWIND_THM2, CLOSED_IN_EMPTY, UNIV_NOT_EMPTY]] THEN
      SUBGOAL_THEN
       (← q r"?c s':real^(N,1)finite_sum->bool.
            convex c /\ ~(c = {}) /\ closed_in (subtopology euclidean c) s' /\
            (s:real^N->bool) homeomorphic s'")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_CLOSED_IN_CONVEX THEN
        REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1, ← GSYM INT_OF_NUM_ADD] THEN
        REWRITE_TAC [← INT_ARITH (← q r"x:int < y + &1 <=> x <= y"), AFF_DIM_LE_UNIV],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [AR]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"c:real^(N,1)finite_sum->bool", ← q r"s':real^(N,1)finite_sum->bool"]) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SYM, HOMEOMORPHIC_CONTRACTIBLE,
                     RETRACT_OF_CONTRACTIBLE, CONVEX_IMP_CONTRACTIBLE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [contractible]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMOTOPIC_WITH_EUCLIDEAN] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"h:real^(1,N)finite_sum->real^N"] THEN
    STRIP_TAC THEN REWRITE_TAC [AR_EQ_ABSOLUTE_EXTENSOR] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^(N,1)finite_sum->real^N", ← q r"w:real^(N,1)finite_sum->bool",
      ← q r"t:real^(N,1)finite_sum->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o  ISPECL
      [← q r"f:real^(N,1)finite_sum->real^N", ← q r"w:real^(N,1)finite_sum->bool",
       ← q r"t:real^(N,1)finite_sum->bool"]  o
      REWRITE_RULE [ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
      [← q r"u:real^(N,1)finite_sum->bool", ← q r"g:real^(N,1)finite_sum->real^N"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"t:real^(N,1)finite_sum->bool", ← q r"w DIFF u:real^(N,1)finite_sum->bool",
      ← q r"w:real^(N,1)finite_sum->bool"] SEPARATION_NORMAL_LOCAL) THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"v:real^(N,1)finite_sum->bool", ← q r"v':real^(N,1)finite_sum->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"t:real^(N,1)finite_sum->bool", ← q r"w DIFF v:real^(N,1)finite_sum->bool",
      ← q r"w:real^(N,1)finite_sum->bool", ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
          URYSOHN_LOCAL) THEN
    ASM_SIMP_TAC [SEGMENT_1, CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [DROP_VEC, REAL_POS] THEN
    X_GEN_TAC (← q r"e:real^(N,1)finite_sum->real^1") THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"\x. if (x:real^(N,1)finite_sum) IN w DIFF v then a
          else (h:real^(1,N)finite_sum->real^N) (pastecart (e x) (g x))") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"w:real^(N,1)finite_sum->bool = (w DIFF v) UNION (w DIFF v')")
      MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do pure (
          GEN_REWRITE_TAC RAND_CONV [th] THEN
          MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
          REWRITE_TAC [← GSYM th])) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL, CONTINUOUS_ON_CONST] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN CONJ_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN RULE_ASSUM_TAC
       (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS]) THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [IN_DIFF] THEN
      COND_CASES_TAC THEN ASM SET_TAC []])

  let ANR_RETRACT_OF_ANR ← prove
   r"!s t:real^N->bool. ANR t /\ s retract_of t ==> ANR s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^N->real^N") THEN STRIP_TAC THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^(N,1)finite_sum->real^N")
          STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(r:real^N->real^N) o (g:real^(N,1)finite_sum->real^N)") THEN
    ASM_SIMP_TAC [IMAGE_o, o_THM] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  let AR_RETRACT_OF_AR ← prove
   r"!s t:real^N->bool. AR t /\ s retract_of t ==> AR s"
   (REWRITE_TAC [AR_ANR] THEN
    MESON_TAC [ANR_RETRACT_OF_ANR, RETRACT_OF_CONTRACTIBLE, RETRACT_OF_EMPTY])

  let ENR_RETRACT_OF_ENR ← prove
   r"!s t:real^N->bool. ENR t /\ s retract_of t ==> ENR s"
   (REWRITE_TAC [ENR] THEN MESON_TAC [RETRACT_OF_TRANS])

  let RETRACT_OF_UNIV ← prove
   r"!s:real^N->bool. s retract_of (:real^N) <=> AR s /\ closed s"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC AR_RETRACT_OF_AR THEN EXISTS_TAC (← q r"(:real^N)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC ABSOLUTE_EXTENSOR_IMP_AR THEN
      MESON_TAC [DUGUNDJI, CONVEX_UNIV, UNIV_NOT_EMPTY],
      MATCH_MP_TAC RETRACT_OF_CLOSED THEN ASM_MESON_TAC [CLOSED_UNIV],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          AR_IMP_ABSOLUTE_RETRACT)) THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN, HOMEOMORPHIC_REFL]])

  let COMPACT_AR ← prove
   r"!s. compact s /\ AR s <=> compact s /\ s retract_of (:real^N)"
   (REWRITE_TAC [RETRACT_OF_UNIV] THEN MESON_TAC [COMPACT_IMP_CLOSED])

  pure { ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT, ENR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV,
         HOMEOMORPHIC_ENRNESS, ENR_TRANSLATION, ENR_LINEAR_IMAGE_EQ, HOMEOMORPHISM_ENRNESS,
         AR_IMP_ANR, ENR_IMP_ANR, ENR_ANR, AR_ANR, ANR_RETRACT_OF_ANR, AR_RETRACT_OF_AR,
         ENR_RETRACT_OF_ENR, RETRACT_OF_UNIV, COMPACT_AR }

/- ------------------------------------------------------------------------- -/
/- More properties of ARs, ANRs and ENRs.  (degree.ml 3431-3947)             -/
/- ------------------------------------------------------------------------- -/

structure DGH where
  NOT_AR_EMPTY : thm
  AR_IMP_NONEMPTY : thm
  ENR_EMPTY : thm
  ANR_EMPTY : thm
  CONVEX_IMP_AR : thm
  CONVEX_IMP_ANR : thm
  IS_INTERVAL_IMP_ENR : thm
  ENR_CONVEX_CLOSED : thm
  AR_UNIV : thm
  ANR_UNIV : thm
  ENR_UNIV : thm
  AR_SING : thm
  ANR_SING : thm
  ENR_SING : thm
  ANR_OPEN_IN : thm
  ENR_OPEN_IN : thm
  ANR_NEIGHBORHOOD_RETRACT : thm
  ENR_NEIGHBORHOOD_RETRACT : thm
  ANR_RELATIVE_INTERIOR : thm
  ANR_DELETE : thm
  ENR_RELATIVE_INTERIOR : thm
  ENR_DELETE : thm
  OPEN_IMP_ENR : thm
  OPEN_IMP_ANR : thm
  ANR_BALL : thm
  ENR_BALL : thm
  AR_BALL : thm
  ANR_CBALL : thm
  ENR_CBALL : thm
  AR_CBALL : thm
  ANR_INTERVAL : thm
  ENR_INTERVAL : thm
  AR_INTERVAL : thm
  ANR_INTERIOR : thm
  ENR_INTERIOR : thm
  AR_IMP_CONTRACTIBLE : thm
  AR_IMP_PATH_CONNECTED : thm
  AR_IMP_CONNECTED : thm
  ENR_IMP_LOCALLY_COMPACT : thm
  ANR_IMP_LOCALLY_PATH_CONNECTED : thm
  ANR_IMP_LOCALLY_CONNECTED : thm
  AR_IMP_LOCALLY_PATH_CONNECTED : thm
  AR_IMP_LOCALLY_CONNECTED : thm
  ENR_IMP_LOCALLY_PATH_CONNECTED : thm
  ENR_IMP_LOCALLY_CONNECTED : thm
  COUNTABLE_ANR_COMPONENTS : thm
  COUNTABLE_ANR_CONNECTED_COMPONENTS : thm
  COUNTABLE_ANR_PATH_COMPONENTS : thm
  FINITE_ANR_COMPONENTS : thm
  FINITE_ENR_COMPONENTS : thm
  ANR_PCROSS : thm
  ANR_PCROSS_EQ : thm
  AR_PCROSS : thm
  ENR_PCROSS : thm
  ENR_PCROSS_EQ : thm
  AR_PCROSS_EQ : thm
  AR_CLOSED_UNION_LOCAL : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGH [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) (BDGG : DGG) : ExceptT String IO DGH := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_EMPTY, RETRACT_OF_LOCALLY_PATH_CONNECTED, retraction, .. } :=
        BDGB
  let { ABSOLUTE_EXTENSOR_IMP_AR, ANR, ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR,
        ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR, AR, AR_IMP_ABSOLUTE_EXTENSOR,
        AR_IMP_ABSOLUTE_RETRACT, ENR, HOMEOMORPHIC_ANRNESS, HOMEOMORPHIC_ARNESS, .. } :=
        BDGF
  let { ANR_RETRACT_OF_ANR, AR_ANR, AR_IMP_ANR, ENR_ANR, ENR_IMP_ANR, ENR_RETRACT_OF_ENR, ..
        } := BDGG
  let { COND_ID, CONJ_ASSOC, DIMINDEX_1, DIMINDEX_FINITE_SUM, EQ_IMP, EQ_TRANS, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FSTCART_PASTECART, IMAGE_o, IMP_CONJ,
        INT_OF_NUM_ADD, INTER_SUBSET, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, NOT_INSERT_EMPTY, PASTECART_IN_PCROSS, PCROSS,
        PCROSS_EMPTY, PCROSS_EQ_EMPTY, .. } := D.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_TOTAL, .. } := D.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LE, SNDCART_PASTECART, SUBSET, SUBSET_REFL, .. }
        := D.pt.cvx.core5
  let { o_DEF, real_ge, SWAP_EXISTS_THM, UNIV_NOT_EMPTY, .. } := D.pt.cvx.core6
  let { LIFT_DROP, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.pt.cvx.vec2
  let { drop, .. } := D.pt.cvx.vec4
  let { CLOSED_IN_TRANS, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV,
        .. } := D.pt.cvx.met
  let { BALL_EQ_EMPTY, CBALL_EQ_EMPTY, CLOSED_CBALL, CLOSED_HALFSPACE_COMPONENT_GE,
        CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_INTERVAL,
        CLOSED_SING, CLOSED_UNIV, .. } := D.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, CONTINUOUS_OPEN_IN_PREIMAGE_GEN, HOMEOMORPHIC_REFL, .. } :=
        D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, LINEAR_CONTINUOUS_ON, OPEN_BALL, .. } := D.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_IN, OPEN_IN_REFL, OPEN_INTERIOR, OPEN_INTERVAL,
        SETDIST_EQ_0_CLOSED_IN, SETDIST_POS_LE, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, INT_ARITH, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { OPEN_IN_DELETE, SETDIST_SING_IN_SET, .. } := D.pt.qtop
  let { AFF_DIM_LE_UNIV, .. } := D.pt.qcvx1
  let { CONVEX_BALL, CONVEX_CBALL, .. } := D.pt.qcvx2
  let { CONVEX_SING, CONVEX_UNIV, .. } := D.pt.qcvx3
  let { CONVEX_INTERVAL, DUGUNDJI, IS_INTERVAL_CONVEX, OPEN_IN_SET_RELATIVE_INTERIOR, .. }
        := D.qconvex
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER, CLOSED_IN_SUBSET_TRANS, CLOSED_IN_UNION, .. }
        := D.qmetric
  let { CONTRACTIBLE_IMP_CONNECTED, CONTRACTIBLE_IMP_PATH_CONNECTED, CONTRACTIBLE_PCROSS,
        CONTRACTIBLE_PCROSS_EQ, CONVEX_IMP_CONTRACTIBLE, CONVEX_IMP_LOCALLY_PATH_CONNECTED,
        COUNTABLE_COMPONENTS, COUNTABLE_CONNECTED_COMPONENTS, COUNTABLE_PATH_COMPONENTS,
        FINITE_COMPONENTS, HOMEOMORPHIC_CLOSED_IN_CONVEX,
        HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS, .. } := D.qpaths1
  let { LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, .. } := D.qpaths2
  let { PASTECART_FST_SND, .. } := D.qsession
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_IN_PREIMAGE_GEN,
        CONTINUOUS_ON_CASES_LOCAL, CONTINUOUS_ON_LIFT_SETDIST, CONTINUOUS_ON_PASTECART, .. }
        := D.qtopology1
  let { HOMEOMORPHIC_PCROSS_SING, IS_INTERVAL_IMP_LOCALLY_COMPACT, LOCALLY_COMPACT_PCROSS,
        LOCALLY_COMPACT_PCROSS_EQ, LOCALLY_OPEN_SUBSET, OPEN_EMPTY,
        OPEN_IMP_LOCALLY_COMPACT, .. } := D.qtopology2
  -- @@SCOPE END

  let NOT_AR_EMPTY ← prove
   r"~(AR({}:real^N->bool))"
   (REWRITE_TAC [AR_ANR])

  let AR_IMP_NONEMPTY ← prove
   r"!s:real^N->bool. AR s ==> ~(s = {})"
   (MESON_TAC [NOT_AR_EMPTY])

  let ENR_EMPTY ← prove
   r"ENR {}"
   (REWRITE_TAC [ENR, RETRACT_OF_EMPTY] THEN MESON_TAC [OPEN_EMPTY])

  let ANR_EMPTY ← prove
   r"ANR {}"
   (SIMP_TAC [ENR_EMPTY, ENR_IMP_ANR])

  let CONVEX_IMP_AR ← prove
   r"!s:real^N->bool. convex s /\ ~(s = {}) ==> AR s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTE_EXTENSOR_IMP_AR THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC DUGUNDJI THEN
    ASM_REWRITE_TAC [])

  let CONVEX_IMP_ANR ← prove
   r"!s:real^N->bool. convex s ==> ANR s"
   (MESON_TAC [ANR_EMPTY, CONVEX_IMP_AR, AR_IMP_ANR])

  let IS_INTERVAL_IMP_ENR ← prove
   r"!s:real^N->bool. is_interval s ==> ENR s"
   (SIMP_TAC [ENR_ANR, IS_INTERVAL_IMP_LOCALLY_COMPACT] THEN
    SIMP_TAC [CONVEX_IMP_ANR, IS_INTERVAL_CONVEX])

  let ENR_CONVEX_CLOSED ← prove
   r"!s:real^N->bool. closed s /\ convex s ==> ENR s"
   (MESON_TAC [CONVEX_IMP_ANR, ENR_ANR, CLOSED_IMP_LOCALLY_COMPACT])

  let AR_UNIV ← prove
   r"AR(:real^N)"
   (MESON_TAC [CONVEX_IMP_AR, CONVEX_UNIV, UNIV_NOT_EMPTY])

  let ANR_UNIV ← prove
   r"ANR(:real^N)"
   (MESON_TAC [CONVEX_IMP_ANR, CONVEX_UNIV])

  let ENR_UNIV ← prove
   r"ENR(:real^N)"
   (MESON_TAC [ENR_CONVEX_CLOSED, CONVEX_UNIV, CLOSED_UNIV])

  let AR_SING ← prove
   r"!a:real^N. AR {a}"
   (SIMP_TAC [CONVEX_IMP_AR, CONVEX_SING, NOT_INSERT_EMPTY])

  let ANR_SING ← prove
   r"!a:real^N. ANR {a}"
   (SIMP_TAC [AR_IMP_ANR, AR_SING])

  let ENR_SING ← prove
   r"!a:real^N. ENR {a}"
   (SIMP_TAC [ENR_ANR, ANR_SING, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_SING])

  let ANR_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ ANR t ==> ANR s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^(N,1)finite_sum->real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^(N,1)finite_sum->bool")
          STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{x | x IN w /\ (g:real^(N,1)finite_sum->real^N) x IN s}") THEN
    ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_TRANS THEN
      EXISTS_TAC (← q r"w:real^(N,1)finite_sum->bool") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN ASM_MESON_TAC [],
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC []])

  let ENR_OPEN_IN ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean t) s /\ ENR t ==> ENR s"
   (REWRITE_TAC [ENR_ANR] THEN MESON_TAC [ANR_OPEN_IN, LOCALLY_OPEN_SUBSET])

  let ANR_NEIGHBORHOOD_RETRACT ← prove
   r"!s t u:real^N->bool.
        s retract_of t /\ open_in (subtopology euclidean u) t /\ ANR u
        ==> ANR s"
   (MESON_TAC [ANR_OPEN_IN, ANR_RETRACT_OF_ANR])

  let ENR_NEIGHBORHOOD_RETRACT ← prove
   r"!s t u:real^N->bool.
        s retract_of t /\ open_in (subtopology euclidean u) t /\ ENR u
        ==> ENR s"
   (MESON_TAC [ENR_OPEN_IN, ENR_RETRACT_OF_ENR])

  let ANR_RELATIVE_INTERIOR ← prove
   r"!s. ANR(s) ==> ANR(relative_interior s)"
   (MESON_TAC [OPEN_IN_SET_RELATIVE_INTERIOR, ANR_OPEN_IN])

  let ANR_DELETE ← prove
   r"!s a:real^N. ANR(s) ==> ANR(s DELETE a)"
   (MESON_TAC [ANR_OPEN_IN, OPEN_IN_DELETE, OPEN_IN_REFL])

  let ENR_RELATIVE_INTERIOR ← prove
   r"!s. ENR(s) ==> ENR(relative_interior s)"
   (MESON_TAC [OPEN_IN_SET_RELATIVE_INTERIOR, ENR_OPEN_IN])

  let ENR_DELETE ← prove
   r"!s a:real^N. ENR(s) ==> ENR(s DELETE a)"
   (MESON_TAC [ENR_OPEN_IN, OPEN_IN_DELETE, OPEN_IN_REFL])

  let OPEN_IMP_ENR ← prove
   r"!s:real^N->bool. open s ==> ENR s"
   (REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    MESON_TAC [ENR_UNIV, ENR_OPEN_IN])

  let OPEN_IMP_ANR ← prove
   r"!s:real^N->bool. open s ==> ANR s"
   (SIMP_TAC [OPEN_IMP_ENR, ENR_IMP_ANR])

  let ANR_BALL ← prove
   r"!a:real^N r. ANR(ball(a,r))"
   (MESON_TAC [CONVEX_IMP_ANR, CONVEX_BALL])

  let ENR_BALL ← prove
   r"!a:real^N r. ENR(ball(a,r))"
   (SIMP_TAC [ENR_ANR, ANR_BALL, OPEN_IMP_LOCALLY_COMPACT, OPEN_BALL])

  let AR_BALL ← prove
   r"!a:real^N r. AR(ball(a,r)) <=> &0 < r"
   (SIMP_TAC [AR_ANR, BALL_EQ_EMPTY, ANR_BALL, CONVEX_BALL,
              CONVEX_IMP_CONTRACTIBLE, REAL_NOT_LE])

  let ANR_CBALL ← prove
   r"!a:real^N r. ANR(cball(a,r))"
   (MESON_TAC [CONVEX_IMP_ANR, CONVEX_CBALL])

  let ENR_CBALL ← prove
   r"!a:real^N r. ENR(cball(a,r))"
   (SIMP_TAC [ENR_ANR, ANR_CBALL, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_CBALL])

  let AR_CBALL ← prove
   r"!a:real^N r. AR(cball(a,r)) <=> &0 <= r"
   (SIMP_TAC [AR_ANR, CBALL_EQ_EMPTY, ANR_CBALL, CONVEX_CBALL,
              CONVEX_IMP_CONTRACTIBLE, REAL_NOT_LT])

  let ANR_INTERVAL ← prove
   r"(!a b:real^N. ANR(interval[a,b])) /\ (!a b:real^N. ANR(interval(a,b)))"
   (SIMP_TAC [CONVEX_IMP_ANR, CONVEX_INTERVAL, CLOSED_INTERVAL,
              OPEN_IMP_ANR, OPEN_INTERVAL])

  let ENR_INTERVAL ← prove
   r"(!a b:real^N. ENR(interval[a,b])) /\ (!a b:real^N. ENR(interval(a,b)))"
   (SIMP_TAC [ENR_CONVEX_CLOSED, CONVEX_INTERVAL, CLOSED_INTERVAL,
              OPEN_IMP_ENR, OPEN_INTERVAL])

  let AR_INTERVAL ← prove
   r"(!a b:real^N. AR(interval[a,b]) <=> ~(interval[a,b] = {})) /\
   (!a b:real^N. AR(interval(a,b)) <=> ~(interval(a,b) = {}))"
   (SIMP_TAC [AR_ANR, ANR_INTERVAL, CONVEX_IMP_CONTRACTIBLE, CONVEX_INTERVAL])

  let ANR_INTERIOR ← prove
   r"!s. ANR(interior s)"
   (SIMP_TAC [OPEN_INTERIOR, OPEN_IMP_ANR])

  let ENR_INTERIOR ← prove
   r"!s. ENR(interior s)"
   (SIMP_TAC [OPEN_INTERIOR, OPEN_IMP_ENR])

  let AR_IMP_CONTRACTIBLE ← prove
   r"!s:real^N->bool. AR s ==> contractible s"
   (SIMP_TAC [AR_ANR])

  let AR_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. AR s ==> path_connected s"
   (MESON_TAC [AR_IMP_CONTRACTIBLE, CONTRACTIBLE_IMP_PATH_CONNECTED])

  let AR_IMP_CONNECTED ← prove
   r"!s:real^N->bool. AR s ==> connected s"
   (MESON_TAC [AR_IMP_CONTRACTIBLE, CONTRACTIBLE_IMP_CONNECTED])

  let ENR_IMP_LOCALLY_COMPACT ← prove
   r"!s:real^N->bool. ENR s ==> locally compact s"
   (SIMP_TAC [ENR_ANR])

  let ANR_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool. ANR s ==> locally path_connected s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?c s':real^(N,1)finite_sum->bool.
          convex c /\ ~(c = {}) /\ closed_in (subtopology euclidean c) s' /\
          (s:real^N->bool) homeomorphic s'")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_CLOSED_IN_CONVEX THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1, ← GSYM INT_OF_NUM_ADD] THEN
      REWRITE_TAC [← INT_ARITH (← q r"x:int < y + &1 <=> x <= y"), AFF_DIM_LE_UNIV],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [ANR]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"c:real^(N,1)finite_sum->bool", ← q r"s':real^(N,1)finite_sum->bool"]) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_SYM, HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS,
                   RETRACT_OF_LOCALLY_PATH_CONNECTED,
                   CONVEX_IMP_LOCALLY_PATH_CONNECTED,
                   LOCALLY_OPEN_SUBSET])

  let ANR_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. ANR s ==> locally connected s"
   (SIMP_TAC [ANR_IMP_LOCALLY_PATH_CONNECTED,
              LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let AR_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool. AR s ==> locally path_connected s"
   (SIMP_TAC [AR_IMP_ANR, ANR_IMP_LOCALLY_PATH_CONNECTED])

  let AR_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. AR s ==> locally connected s"
   (SIMP_TAC [AR_IMP_LOCALLY_PATH_CONNECTED,
              LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let ENR_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool. ENR s ==> locally path_connected s"
   (SIMP_TAC [ANR_IMP_LOCALLY_PATH_CONNECTED, ENR_IMP_ANR])

  let ENR_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. ENR s ==> locally connected s"
   (SIMP_TAC [ANR_IMP_LOCALLY_CONNECTED, ENR_IMP_ANR])

  let COUNTABLE_ANR_COMPONENTS ← prove
   r"!s:real^N->bool. ANR s ==> COUNTABLE(components s)"
   (SIMP_TAC [ANR_IMP_LOCALLY_CONNECTED, COUNTABLE_COMPONENTS])

  let COUNTABLE_ANR_CONNECTED_COMPONENTS ← prove
   r"!s:real^N->bool t.
        ANR s ==> COUNTABLE {connected_component s x | x IN t}"
   (SIMP_TAC [ANR_IMP_LOCALLY_CONNECTED, COUNTABLE_CONNECTED_COMPONENTS])

  let COUNTABLE_ANR_PATH_COMPONENTS ← prove
   r"!s:real^N->bool t.
        ANR s ==> COUNTABLE {path_component s x | x IN t}"
   (SIMP_TAC [ANR_IMP_LOCALLY_PATH_CONNECTED, COUNTABLE_PATH_COMPONENTS])

  let FINITE_ANR_COMPONENTS ← prove
   r"!s:real^N->bool. ANR s /\ compact s ==> FINITE(components s)"
   (SIMP_TAC [FINITE_COMPONENTS, ANR_IMP_LOCALLY_CONNECTED])

  let FINITE_ENR_COMPONENTS ← prove
   r"!s:real^N->bool. ENR s /\ compact s ==> FINITE(components s)"
   (SIMP_TAC [FINITE_COMPONENTS, ENR_IMP_LOCALLY_CONNECTED])

  let ANR_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool. ANR s /\ ANR t ==> ANR(s PCROSS t)"
   (REPEAT STRIP_TAC THEN SIMP_TAC [ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^((M,N)finite_sum,1)finite_sum->real^(M,N)finite_sum",
      ← q r"u:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"c:real^((M,N)finite_sum,1)finite_sum->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"fstcart o (f:real^((M,N)finite_sum,1)finite_sum->real^(M,N)finite_sum)",
      ← q r"u:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"c:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"s:real^M->bool"] ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
    MP_TAC (← ISPECL
     [← q r"sndcart o (f:real^((M,N)finite_sum,1)finite_sum->real^(M,N)finite_sum)",
      ← q r"u:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"c:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"t:real^N->bool"] ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, LINEAR_CONTINUOUS_ON,
                  LINEAR_FSTCART, LINEAR_SNDCART, IMAGE_o] THEN
    RULE_ASSUM_TAC
     (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE, PCROSS, IN_ELIM_THM]) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SNDCART_PASTECART], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"w2:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"h:real^((M,N)finite_sum,1)finite_sum->real^N"] THEN
    STRIP_TAC THEN ANTS_TAC THENL
     [ASM_MESON_TAC [FSTCART_PASTECART], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"w1:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"g:real^((M,N)finite_sum,1)finite_sum->real^M"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"w1 INTER w2:real^((M,N)finite_sum,1)finite_sum->bool",
      ← q r"\x:real^((M,N)finite_sum,1)finite_sum.
          pastecart (g x:real^M) (h x:real^N)"] THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER, o_DEF, PASTECART_IN_PCROSS,
                  PASTECART_FST_SND] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET])

  let ANR_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        ANR(s PCROSS t) <=> s = {} \/ t = {} \/ ANR s /\ ANR t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, ANR_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, ANR_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [ANR_PCROSS] THEN REPEAT STRIP_TAC THENL
     [UNDISCH_TAC (← q r"~(t:real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ANR ((s:real^M->bool) PCROSS {b:real^N})") MP_TAC THENL
       [ALL_TAC, MESON_TAC [HOMEOMORPHIC_PCROSS_SING, HOMEOMORPHIC_ANRNESS]],
      UNDISCH_TAC (← q r"~(s:real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ANR ({a:real^M} PCROSS (t:real^N->bool))") MP_TAC THENL
       [ALL_TAC, MESON_TAC [HOMEOMORPHIC_PCROSS_SING, HOMEOMORPHIC_ANRNESS]]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ANR_RETRACT_OF_ANR)) THEN
    REWRITE_TAC [retract_of, retraction] THENL
     [EXISTS_TAC (← q r"\x:real^(M,N)finite_sum. pastecart (fstcart x) (b:real^N)"),
      EXISTS_TAC (← q r"\x:real^(M,N)finite_sum. pastecart (a:real^M) (sndcart x)")] THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_PCROSS, FORALL_IN_IMAGE, IN_SING,
                  FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS,
                  CONTINUOUS_ON_PASTECART, LINEAR_FSTCART, LINEAR_SNDCART,
                  LINEAR_CONTINUOUS_ON, CONTINUOUS_ON_CONST])

  let AR_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool. AR s /\ AR t ==> AR(s PCROSS t)"
   (SIMP_TAC [AR_ANR, ANR_PCROSS, CONTRACTIBLE_PCROSS, PCROSS_EQ_EMPTY])

  let ENR_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool. ENR s /\ ENR t ==> ENR(s PCROSS t)"
   (SIMP_TAC [ENR_ANR, ANR_PCROSS, LOCALLY_COMPACT_PCROSS])

  let ENR_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        ENR(s PCROSS t) <=> s = {} \/ t = {} \/ ENR s /\ ENR t"
   (REWRITE_TAC [ENR_ANR, ANR_PCROSS_EQ, LOCALLY_COMPACT_PCROSS_EQ] THEN
    CONV_TAC (fun t => TAUT t))

  let AR_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        AR(s PCROSS t) <=> AR s /\ AR t /\ ~(s = {}) /\ ~(t = {})"
   (SIMP_TAC [AR_ANR, ANR_PCROSS_EQ, CONTRACTIBLE_PCROSS_EQ, PCROSS_EQ_EMPTY] THEN
    CONV_TAC (fun t => TAUT t))

  let AR_CLOSED_UNION_LOCAL ← (do
    let lemma ← prove
     r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        AR s /\ AR t /\ AR(s INTER t)
        ==> (s UNION t) retract_of u"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s INTER t:real^N->bool = {}") THENL
       [ASM_MESON_TAC [NOT_AR_EMPTY], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(s:real^N->bool) SUBSET u /\ t SUBSET u") STRIP_ASSUME_TAC
      THENL [ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET], ALL_TAC] THEN
      MAP_EVERY ABBREV_TAC
       [← q r"s' = {x:real^N | x IN u /\ setdist({x},s) <= setdist({x},t)}",
        ← q r"t' = {x:real^N | x IN u /\ setdist({x},t) <= setdist({x},s)}",
        ← q r"w = {x:real^N | x IN u /\ setdist({x},s) = setdist({x},t)}"] THEN
      SUBGOAL_THEN (← q r"closed_in (subtopology euclidean u) (s':real^N->bool) /\
                    closed_in (subtopology euclidean u) (t':real^N->bool)")
      STRIP_ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["s'", "t'"] THEN
        ONCE_REWRITE_TAC [← GSYM REAL_SUB_LE] THEN
        ONCE_REWRITE_TAC [← GSYM LIFT_DROP] THEN REWRITE_TAC [← SET_RULE
         (← q r"a <= drop(lift x) <=> lift x IN {x | a <= drop x}")] THEN
        REWRITE_TAC [LIFT_DROP, LIFT_SUB] THEN CONJ_TAC THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
        SIMP_TAC [CLOSED_SING, CONTINUOUS_ON_SUB, CONTINUOUS_ON_LIFT_SETDIST,
                  drop, CLOSED_HALFSPACE_COMPONENT_LE,
                  ← REWRITE_RULE [real_ge] CLOSED_HALFSPACE_COMPONENT_GE],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(s:real^N->bool) SUBSET s' /\ (t:real^N->bool) SUBSET t'")
      STRIP_ASSUME_TAC THENL
        [MAP_EVERY EXPAND_TAC ["s'", "t'"] THEN
         SIMP_TAC [SUBSET, IN_ELIM_THM, SETDIST_SING_IN_SET, SETDIST_POS_LE] THEN
         ASM SET_TAC [],
         ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(s INTER t:real^N->bool) retract_of w") MP_TAC THENL
       [MATCH_MP_TAC AR_IMP_ABSOLUTE_RETRACT THEN
        EXISTS_TAC (← q r"s INTER t:real^N->bool") THEN
        ASM_REWRITE_TAC [HOMEOMORPHIC_REFL] THEN
        MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_INTER] THEN
        CONJ_TAC THENL [EXPAND_TAC "w", ASM SET_TAC []] THEN
        SIMP_TAC [SUBSET, IN_INTER, IN_ELIM_THM, SETDIST_SING_IN_SET] THEN
        ASM SET_TAC [],
        GEN_REWRITE_TAC LAND_CONV [retract_of] THEN
        REWRITE_TAC [retraction, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"r0:real^N->real^N") THEN STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x:real^N. x IN w ==> (x IN s <=> x IN t)")
      ASSUME_TAC THENL
       [EXPAND_TAC "w" THEN REWRITE_TAC [IN_ELIM_THM] THEN GEN_TAC THEN
        DISCH_THEN (fun th => EQ_TAC THEN DISCH_TAC THEN MP_TAC th) THEN
        ASM_SIMP_TAC [SETDIST_SING_IN_SET] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&0 = setdist p <=> setdist p = &0")] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"~(s = {}) /\ (p <=> s = {} \/ x IN s) ==> p ==> x IN s")) THEN
        (CONJ_TAC THENL
         [ASM SET_TAC [], MATCH_MP_TAC SETDIST_EQ_0_CLOSED_IN]) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"s' INTER t':real^N->bool = w") ASSUME_TAC THENL
       [ASM SET_TAC [REAL_LE_ANTISYM], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closed_in (subtopology euclidean u) (w:real^N->bool)")
      ASSUME_TAC THENL [ASM_MESON_TAC [CLOSED_IN_INTER], ALL_TAC] THEN
      ABBREV_TAC (← q r"r = \x:real^N. if x IN w then r0 x else x") THEN
      SUBGOAL_THEN
       (← q r"IMAGE (r:real^N->real^N) (w UNION s) SUBSET s /\
        IMAGE (r:real^N->real^N) (w UNION t) SUBSET t")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "r" THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(r:real^N->real^N) continuous_on  (w UNION s UNION t)")
      ASSUME_TAC THENL
       [EXPAND_TAC "r" THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_UNION] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?g:real^N->real^N.
            g continuous_on u /\
            IMAGE g u SUBSET s /\
            !x. x IN w UNION s ==> g x = r x")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC AR_IMP_ABSOLUTE_EXTENSOR THEN
        ASM_SIMP_TAC [CLOSED_IN_UNION] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET, IN_UNION],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?h:real^N->real^N.
            h continuous_on u /\
            IMAGE h u SUBSET t /\
            !x. x IN w UNION t ==> h x = r x")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC AR_IMP_ABSOLUTE_EXTENSOR THEN
        ASM_SIMP_TAC [CLOSED_IN_UNION] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET, IN_UNION],
        ALL_TAC] THEN
      REWRITE_TAC [retract_of, retraction] THEN
      EXISTS_TAC (← q r"\x. if x IN s' then (g:real^N->real^N) x else h x") THEN
      REPEAT CONJ_TAC THENL
       [ASM SET_TAC [],
        ALL_TAC,
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNION] THEN ASM SET_TAC [],
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_UNION] THEN
        STRIP_TAC THEN ASM_SIMP_TAC [IN_UNION, COND_ID] THENL
         [COND_CASES_TAC THENL [EXPAND_TAC "r", ASM SET_TAC []],
          COND_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          TRANS_TAC EQ_TRANS (← q r"(r:real^N->real^N) x") THEN
          CONJ_TAC THENL [ASM SET_TAC [], EXPAND_TAC "r"]] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []] THEN
      SUBGOAL_THEN
       (← q r"u:real^N->bool = s' UNION t'")
       (fun th => tactic_of do pure (ONCE_REWRITE_TAC [th] THEN
                  MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
                  REWRITE_TAC [← GSYM th]))
      THENL [ASM SET_TAC [REAL_LE_TOTAL], ASM_SIMP_TAC []] THEN
      REPEAT CONJ_TAC THEN TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC []) THEN
      REWRITE_TAC [← TAUT (← q r"p /\ ~p \/ q /\ p <=> p /\ q")] THEN
      ASM_SIMP_TAC [← GSYM IN_INTER, IN_UNION])
    prove
     r"!s t:real^N->bool.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        AR(s) /\ AR(t) /\ AR(s INTER t)
        ==> AR(s UNION t)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [AR] THEN MAP_EVERY X_GEN_TAC
       [← q r"u:real^(N,1)finite_sum->bool", ← q r"c:real^(N,1)finite_sum->bool"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
      REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"f:real^N->real^(N,1)finite_sum", ← q r"g:real^(N,1)finite_sum->real^N"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"closed_in (subtopology euclidean u)
                  {x | x IN c /\ (g:real^(N,1)finite_sum->real^N) x IN s} /\
        closed_in (subtopology euclidean u)
                  {x | x IN c /\ (g:real^(N,1)finite_sum->real^N) x IN t}")
      STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_TRANS THEN
        EXISTS_TAC (← q r"c:real^(N,1)finite_sum->bool") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
        EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN c /\ (g:real^(N,1)finite_sum->real^N) x IN s} UNION
        {x | x IN c /\ (g:real^(N,1)finite_sum->real^N) x IN t} = c")
       (fun th => tactic_of do pure (SUBST1_TAC (← SYM th))) THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [UNDISCH_TAC (← q r"AR(s:real^N->bool)"),
        UNDISCH_TAC (← q r"AR(t:real^N->bool)"),
        UNDISCH_TAC (← q r"AR(s INTER t:real^N->bool)")] THEN
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOMEOMORPHIC_ARNESS THEN
      REWRITE_TAC [homeomorphic, homeomorphism] THEN MAP_EVERY EXISTS_TAC
       [← q r"f:real^N->real^(N,1)finite_sum", ← q r"g:real^(N,1)finite_sum->real^N"] THEN
      REPEAT CONJ_TAC THEN TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC []))

  pure { NOT_AR_EMPTY, AR_IMP_NONEMPTY, ENR_EMPTY, ANR_EMPTY, CONVEX_IMP_AR, CONVEX_IMP_ANR,
         IS_INTERVAL_IMP_ENR, ENR_CONVEX_CLOSED, AR_UNIV, ANR_UNIV, ENR_UNIV, AR_SING,
         ANR_SING, ENR_SING, ANR_OPEN_IN, ENR_OPEN_IN, ANR_NEIGHBORHOOD_RETRACT,
         ENR_NEIGHBORHOOD_RETRACT, ANR_RELATIVE_INTERIOR, ANR_DELETE, ENR_RELATIVE_INTERIOR,
         ENR_DELETE, OPEN_IMP_ENR, OPEN_IMP_ANR, ANR_BALL, ENR_BALL, AR_BALL, ANR_CBALL,
         ENR_CBALL, AR_CBALL, ANR_INTERVAL, ENR_INTERVAL, AR_INTERVAL, ANR_INTERIOR,
         ENR_INTERIOR, AR_IMP_CONTRACTIBLE, AR_IMP_PATH_CONNECTED, AR_IMP_CONNECTED,
         ENR_IMP_LOCALLY_COMPACT, ANR_IMP_LOCALLY_PATH_CONNECTED, ANR_IMP_LOCALLY_CONNECTED,
         AR_IMP_LOCALLY_PATH_CONNECTED, AR_IMP_LOCALLY_CONNECTED,
         ENR_IMP_LOCALLY_PATH_CONNECTED, ENR_IMP_LOCALLY_CONNECTED, COUNTABLE_ANR_COMPONENTS,
         COUNTABLE_ANR_CONNECTED_COMPONENTS, COUNTABLE_ANR_PATH_COMPONENTS,
         FINITE_ANR_COMPONENTS, FINITE_ENR_COMPONENTS, ANR_PCROSS, ANR_PCROSS_EQ, AR_PCROSS,
         ENR_PCROSS, ENR_PCROSS_EQ, AR_PCROSS_EQ, AR_CLOSED_UNION_LOCAL }

/- ------------------------------------------------------------------------- -/
/- General ANR union lemma (Kuratowski).  (degree.ml 3948-4183)              -/
/- ------------------------------------------------------------------------- -/

structure DGI where
  ANR_UNION_EXTENSION_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGI [HolBase] (D : DegreeDeps) (BDGF : DGF) : ExceptT String IO DGI := do
  -- @@SCOPE BEGIN
  let { ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR, .. } := BDGF
  let { ARITH_EQ, CONJ_ASSOC, FINITE_EMPTY, FINITE_INSERT, FORALL_AND_THM, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES, IMP_CONJ, IMP_IMP, INTER_COMM,
        INTER_SUBSET, .. } := D.pt.cvx.core2
  let { IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, .. }
        := D.pt.cvx.core3
  let { RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_REFL, .. }
        := D.pt.cvx.core5
  let { SUBSET_UNIV, SWAP_FORALL_THM, UNIONS_2, .. } := D.pt.cvx.core6
  let { CLOSED_IN_DIFF, CLOSED_IN_TRANS, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, .. } := D.pt.cvx.met
  let { CONTINUOUS_ON_SUBSET, .. } := D.pt.cvx.top3
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { CLOSED_IN_REFL, .. } := D.pt.qtop
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER, CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET,
        CLOSED_IN_UNION, PASTING_LEMMA_EXISTS_CLOSED, SUBTOPOLOGY_SUBTOPOLOGY, .. } :=
        D.qmetric
  let { WLOG_LT, .. } := D.qsession
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := D.qtopology1
  let { SEPARATION_NORMAL_LOCAL, .. } := D.qtopology2
  -- @@SCOPE END

  let ANR_UNION_EXTENSION_LEMMA ← prove
   r"!f:real^M->real^N s t u s1 s2 u1 u2.
        f continuous_on t /\ IMAGE f t SUBSET u /\
        ANR u1 /\ ANR u2 /\ ANR(u1 INTER u2) /\ u1 UNION u2 = u /\
        closed_in (subtopology euclidean s) t /\
        closed_in (subtopology euclidean s) s1 /\
        closed_in (subtopology euclidean s) s2 /\
        s1 UNION s2 = s /\
        IMAGE f (t INTER s1) SUBSET u1 /\
        IMAGE f (t INTER s2) SUBSET u2
        ==> ?v g. t SUBSET v /\
                  open_in (subtopology euclidean s) v /\
                  g continuous_on v /\ IMAGE g v SUBSET u /\
                  !x. x IN t ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?v v' h.
          t INTER s1 INTER s2 SUBSET v /\ v SUBSET v' /\
          open_in (subtopology euclidean (s1 INTER s2)) v /\
          closed_in (subtopology euclidean (s1 INTER s2)) v' /\
          h continuous_on v' /\ IMAGE h v' SUBSET u1 INTER u2 /\
          !x. x IN v' INTER t ==> (h:real^M->real^N) x = f x")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"f:real^M->real^N", ← q r"s:real^M->bool",
        ← q r"t INTER s1 INTER s2:real^M->bool", ← q r"u1 INTER u2:real^N->bool"]
        ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
      ASM_SIMP_TAC [CLOSED_IN_INTER] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^M->bool", ← q r"g:real^M->real^N"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"t INTER s1 INTER s2:real^M->bool", ← q r"s DIFF v:real^M->bool",
                        ← q r"s:real^M->bool"] SEPARATION_NORMAL_LOCAL) THEN
      ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
