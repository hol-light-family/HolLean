  let { OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED,
        OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, .. } := D.qpaths2
  let { SIMPLEX_IMP_CLOSED, SIMPLEX_IMP_CONVEX, SIMPLICIAL_COMPLEX_IMP_TRIANGULATION,
        triangulation, .. } := D.qpolytope
  let { LT_SUC_LE, .. } := D.qsession
  let { CLOSED_UNION, CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_CLOSED_IN_PREIMAGE_GEN,
        CONTINUOUS_ON_CASES_LOCAL, CONTINUOUS_ON_LIFT_SETDIST, .. } := D.qtopology1
  let { IN_COMPONENTS, LOCALLY_COMPACT_CLOSED_UNION, .. } := D.qtopology2
  -- @@SCOPE END

  let ANR_CLOSED_UNION_LOCAL ← prove
   r"!s t:real^N->bool u.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        ANR(s) /\ ANR(t) /\ ANR(s INTER t)
        ==> ANR(s UNION t)"
   (MAP_EVERY X_GEN_TAC
     [← q r"y1:real^N->bool", ← q r"y2:real^N->bool", ← q r"yn:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"closed_in (subtopology euclidean (y1 UNION y2)) (y1:real^N->bool) /\
      closed_in (subtopology euclidean (y1 UNION y2)) (y2:real^N->bool)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [CLOSED_IN_SUBSET_TRANS, SUBSET_UNION, UNION_SUBSET,
                     CLOSED_IN_IMP_SUBSET],
      REPEAT (FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
        check (HolCore.Basics.free_in (← q r"yn:real^N->bool") o concl)))] THEN
    MATCH_MP_TAC ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^(N,1)finite_sum->real^N",
      ← q r"s:real^(N,1)finite_sum->bool", ← q r"t:real^(N,1)finite_sum->bool"] THEN
    STRIP_TAC THEN
    ASM_CASES_TAC (← q r"IMAGE (f:real^(N,1)finite_sum->real^N) t SUBSET y1") THENL
     [MP_TAC (← ISPECL
       [← q r"f:real^(N,1)finite_sum->real^N", ← q r"s:real^(N,1)finite_sum->bool",
        ← q r"t:real^(N,1)finite_sum->bool", ← q r"y1:real^N->bool"]
        ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"IMAGE (f:real^(N,1)finite_sum->real^N) t SUBSET y2") THENL
     [MP_TAC (← ISPECL
       [← q r"f:real^(N,1)finite_sum->real^N", ← q r"s:real^(N,1)finite_sum->bool",
        ← q r"t:real^(N,1)finite_sum->bool", ← q r"y2:real^N->bool"]
        ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC ANR_UNION_EXTENSION_LEMMA THEN MAP_EVERY ABBREV_TAC
     [← q r"b1 = {x | x IN s /\
                 setdist({x},
                     {x | x IN t /\ (f:real^(N,1)finite_sum->real^N) x IN y1})
               <= setdist({x},{x | x IN t /\ f x IN y2})}",
      ← q r"b2 = {x | x IN s /\
                 setdist({x},
                     {x | x IN t /\ (f:real^(N,1)finite_sum->real^N) x IN y2})
               <= setdist({x},{x | x IN t /\ f x IN y1})}"] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"b1:real^(N,1)finite_sum->bool",
      ← q r"b2:real^(N,1)finite_sum->bool",
      ← q r"y1:real^N->bool",
      ← q r"y2:real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THENL [EXPAND_TAC "b1", EXPAND_TAC "b2"] THEN
      ONCE_REWRITE_TAC [← MESON [LIFT_DROP, REAL_SUB_LE]
       (← q r"x <= y <=> &0 <= drop(lift(y - x))")] THEN
      ONCE_REWRITE_TAC [← SET_RULE
       (← q r"&0 <= drop x <=> x IN {y | &0 <= drop y}")] THEN
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
      REWRITE_TAC [drop, ← GSYM real_ge, CLOSED_HALFSPACE_COMPONENT_GE] THEN
      SIMP_TAC [LIFT_SUB, CONTINUOUS_ON_SUB, CONTINUOUS_ON_LIFT_SETDIST,
                CONTINUOUS_ON_CONST],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MAP_EVERY EXPAND_TAC ["b1", "b2"] THEN
      MP_TAC REAL_LE_TOTAL THEN SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER] THEN
    MAP_EVERY EXPAND_TAC ["b1", "b2"] THEN
    X_GEN_TAC (← q r"x:real^(N,1)finite_sum") THEN REWRITE_TAC [IN_ELIM_THM] THEN
    STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"(f:real^(N,1)finite_sum->real^N) x IN y2") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC],
      SUBGOAL_THEN (← q r"(f:real^(N,1)finite_sum->real^N) x IN y1") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_NOT_LT]) THEN
    ASM_SIMP_TAC [SETDIST_SING_IN_SET, IN_ELIM_THM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
    REWRITE_TAC [SETDIST_POS_LE] THEN
    MP_TAC (← ISPEC (← q r"s:real^(N,1)finite_sum->bool") SETDIST_EQ_0_CLOSED_IN) THEN
    DISCH_THEN (fun th =>
      W (MP_TAC o PART_MATCH (lhand o rand) th o rand o snd)) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN
    (ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
    MATCH_MP_TAC CLOSED_IN_TRANS THEN
    EXISTS_TAC (← q r"t:real^(N,1)finite_sum->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
    EXISTS_TAC (← q r"y1 UNION y2:real^N->bool") THEN ASM_REWRITE_TAC [])

  let ENR_CLOSED_UNION_LOCAL ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        ENR(s) /\ ENR(t) /\ ENR(s INTER t)
        ==> ENR(s UNION t)"
   (REWRITE_TAC [ENR_ANR] THEN
    MESON_TAC [ANR_CLOSED_UNION_LOCAL, LOCALLY_COMPACT_CLOSED_UNION])

  let AR_CLOSED_UNION ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ AR(s) /\ AR(t) /\ AR(s INTER t)
        ==> AR(s UNION t)"
   (MESON_TAC [AR_CLOSED_UNION_LOCAL, CLOSED_SUBSET, SUBSET_UNION])

  let ANR_CLOSED_UNION ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ ANR(s) /\ ANR(t) /\ ANR(s INTER t)
        ==> ANR(s UNION t)"
   (MESON_TAC [ANR_CLOSED_UNION_LOCAL, CLOSED_SUBSET, SUBSET_UNION])

  let ENR_CLOSED_UNION ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ ENR(s) /\ ENR(t) /\ ENR(s INTER t)
        ==> ENR(s UNION t)"
   (MESON_TAC [ENR_CLOSED_UNION_LOCAL, CLOSED_SUBSET, SUBSET_UNION])

  let ABSOLUTE_RETRACT_UNION ← prove
   r"!s t. s retract_of (:real^N) /\
         t retract_of (:real^N) /\
         (s INTER t) retract_of (:real^N)
         ==> (s UNION t) retract_of (:real^N)"
   (SIMP_TAC [RETRACT_OF_UNIV, AR_CLOSED_UNION, CLOSED_UNION])

  let RETRACT_FROM_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        (s UNION t) retract_of u /\ (s INTER t) retract_of t
        ==> s retract_of u"
   (REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"(s UNION t) retract_of (u:real^N->bool)") THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] RETRACT_OF_TRANS) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, retract_of] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x:real^N. if x IN s then x else r x") THEN
    SIMP_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID] THEN ASM SET_TAC [])

  let AR_FROM_UNION_AND_INTER_LOCAL ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        AR(s UNION t) /\ AR(s INTER t)
        ==> AR(s) /\ AR(t)"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool.
          closed_in (subtopology euclidean (s UNION t)) s /\
          closed_in (subtopology euclidean (s UNION t)) t /\
          AR(s UNION t) /\ AR(s INTER t)
          ==> AR(s)")
    MP_TAC THENL [ALL_TAC, MESON_TAC [UNION_COMM, INTER_COMM]] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC AR_RETRACT_OF_AR THEN
    EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RETRACT_FROM_UNION_AND_INTER THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [RETRACT_OF_REFL] THEN
    MATCH_MP_TAC RETRACT_OF_SUBSET THEN EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN
    REWRITE_TAC [INTER_SUBSET, SUBSET_UNION] THEN
    MATCH_MP_TAC AR_IMP_RETRACT THEN ASM_SIMP_TAC [CLOSED_IN_INTER])

  let AR_FROM_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ AR(s UNION t) /\ AR(s INTER t)
        ==> AR(s) /\ AR(t)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC AR_FROM_UNION_AND_INTER_LOCAL THEN
    ASM_MESON_TAC [CLOSED_SUBSET, SUBSET_UNION])

  let ANR_FROM_UNION_AND_INTER_LOCAL ← prove
   r"!s t:real^N->bool.
        closed_in (subtopology euclidean (s UNION t)) s /\
        closed_in (subtopology euclidean (s UNION t)) t /\
        ANR(s UNION t) /\ ANR(s INTER t)
        ==> ANR(s) /\ ANR(t)"
   (SUBGOAL_THEN
     (← q r"!s t:real^N->bool.
          closed_in (subtopology euclidean (s UNION t)) s /\
          closed_in (subtopology euclidean (s UNION t)) t /\
          ANR(s UNION t) /\ ANR(s INTER t)
          ==> ANR(s)")
    MP_TAC THENL [ALL_TAC, MESON_TAC [UNION_COMM, INTER_COMM]] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ANR_NEIGHBORHOOD_RETRACT THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s INTER t:real^N->bool", ← q r"s UNION t:real^N->bool"]
          ANR_IMP_NEIGHBOURHOOD_RETRACT) THEN
    ASM_SIMP_TAC [CLOSED_IN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    EXISTS_TAC (← q r"s UNION u:real^N->bool") THEN CONJ_TAC THENL
     [ALL_TAC,
      SUBGOAL_THEN
       (← q r"s UNION u:real^N->bool =
        ((s UNION t) DIFF t) UNION u")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [OPEN_IN_UNION, OPEN_IN_DIFF, OPEN_IN_REFL]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retract_of, retraction, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^N->real^N") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\x:real^N. if x IN s then x else r x") THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"s UNION u:real^N->bool = s UNION (u INTER t)")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, CONJ_ASSOC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET]] THEN
    CONJ_TAC THENL
     [UNDISCH_TAC
       (← q r"closed_in(subtopology euclidean (s UNION t)) (s:real^N->bool)"),
      UNDISCH_TAC
         (← q r"closed_in(subtopology euclidean (s UNION t)) (t:real^N->bool)")] THEN
    REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM SET_TAC [])

  let ANR_FROM_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\ ANR(s UNION t) /\ ANR(s INTER t)
        ==> ANR(s) /\ ANR(t)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC ANR_FROM_UNION_AND_INTER_LOCAL THEN
    ASM_MESON_TAC [CLOSED_SUBSET, SUBSET_UNION])

  let ANR_FINITE_UNIONS_CONVEX_CLOSED ← prove
   r"!t:(real^N->bool)->bool.
        FINITE t /\ (!c. c IN t ==> closed c /\ convex c) ==> ANR(UNIONS t)"
   (GEN_TAC THEN WF_INDUCT_TAC (← q r"CARD(t:(real^N->bool)->bool)") THEN
    POP_ASSUM MP_TAC THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r ==> s <=> q ==> p ==> r ==> s")] THEN
    SPEC_TAC (← q r"t:(real^N->bool)->bool", ← q r"t:(real^N->bool)->bool") THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, UNIONS_INSERT, FORALL_IN_INSERT] THEN
    REWRITE_TAC [ANR_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"t:(real^N->bool)->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC : thm → tactic) STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [IMP_IMP] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ANR_CLOSED_UNION THEN ASM_SIMP_TAC [CLOSED_UNIONS] THEN
    ASM_SIMP_TAC [CONVEX_IMP_ANR] THEN REWRITE_TAC [INTER_UNIONS] THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [CARD_CLAUSES] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, LT_SUC_LE, LE_REFL] THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, CLOSED_INTER, CONVEX_INTER] THEN
    ASM_SIMP_TAC [CARD_IMAGE_LE])

  let FINITE_IMP_ANR ← prove
   r"!s:real^N->bool. FINITE s ==> ANR s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s = UNIONS {{a:real^N} | a IN s}") SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [],
      MATCH_MP_TAC ANR_FINITE_UNIONS_CONVEX_CLOSED THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, SIMPLE_IMAGE, FINITE_IMAGE] THEN
      REWRITE_TAC [CLOSED_SING, CONVEX_SING]])

  let ANR_INSERT ← prove
   r"!s a:real^N. closed s /\ ANR s ==> ANR(a INSERT s)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    MATCH_MP_TAC ANR_CLOSED_UNION THEN
    ASM_MESON_TAC [CLOSED_SING, ANR_SING, ANR_EMPTY,
                   ← SET_RULE (← q r"{a} INTER s = {a} \/ {a} INTER s = {}")])

  let ANR_TRIANGULATION ← prove
   r"!tr. triangulation tr ==> ANR(UNIONS tr)"
   (REWRITE_TAC [triangulation] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ANR_FINITE_UNIONS_CONVEX_CLOSED THEN
    ASM_MESON_TAC [SIMPLEX_IMP_CLOSED, SIMPLEX_IMP_CONVEX])

  let ANR_SIMPLICIAL_COMPLEX ← prove
   r"!c. simplicial_complex c ==>  ANR(UNIONS c)"
   (MESON_TAC [ANR_TRIANGULATION, SIMPLICIAL_COMPLEX_IMP_TRIANGULATION])

  let ANR_PATH_COMPONENT_ANR ← prove
   r"!s x:real^N. ANR(s) ==> ANR(path_component s x)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      ANR_OPEN_IN)) THEN
    MATCH_MP_TAC OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED THEN
    ASM_SIMP_TAC [ANR_IMP_LOCALLY_PATH_CONNECTED])

  let ANR_CONNECTED_COMPONENT_ANR ← prove
   r"!s x:real^N. ANR(s) ==> ANR(connected_component s x)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      ANR_OPEN_IN)) THEN
    MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED THEN
    ASM_SIMP_TAC [ANR_IMP_LOCALLY_CONNECTED])

  let ANR_COMPONENT_ANR ← prove
   r"!s:real^N->bool.
        ANR s /\ c IN components s ==> ANR c"
   (REWRITE_TAC [IN_COMPONENTS] THEN MESON_TAC [ANR_CONNECTED_COMPONENT_ANR])

  pure { ANR_CLOSED_UNION_LOCAL, ENR_CLOSED_UNION_LOCAL, AR_CLOSED_UNION, ANR_CLOSED_UNION,
         ENR_CLOSED_UNION, ABSOLUTE_RETRACT_UNION, RETRACT_FROM_UNION_AND_INTER,
         AR_FROM_UNION_AND_INTER_LOCAL, AR_FROM_UNION_AND_INTER,
         ANR_FROM_UNION_AND_INTER_LOCAL, ANR_FROM_UNION_AND_INTER,
         ANR_FINITE_UNIONS_CONVEX_CLOSED, FINITE_IMP_ANR, ANR_INSERT, ANR_TRIANGULATION,
         ANR_SIMPLICIAL_COMPLEX, ANR_PATH_COMPONENT_ANR, ANR_CONNECTED_COMPONENT_ANR,
         ANR_COMPONENT_ANR }

/- ------------------------------------------------------------------------- -/
/- Application to open union; local ANRs and covering spaces.               -/
/- (degree.ml 4483-5235)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DGK where
  ANR_OPEN_UNION : thm
  ENR_OPEN_UNION : thm
  ANR_OPEN_UNIONS : thm
  ENR_OPEN_UNIONS : thm
  LOCALLY_ANR_ALT : thm
  LOCALLY_ANR : thm
  ANR_LOCALLY : thm
  LOCALLY_ENR_ALT : thm
  LOCALLY_ENR : thm
  ENR_LOCALLY : thm
  ANR_COVERING_SPACE_EQ : thm
  ANR_COVERING_SPACE : thm
  ENR_COVERING_SPACE_EQ : thm
  ENR_COVERING_SPACE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGK [HolBase] (D : DegreeDeps) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGI : DGI) : ExceptT String IO DGK := do
  -- @@SCOPE BEGIN
  let { ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR, ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR,
        HOMEOMORPHIC_ANRNESS, .. } := BDGF
  let { ENR_ANR, .. } := BDGG
  let { ANR_EMPTY, ANR_OPEN_IN, ENR_OPEN_IN, .. } := BDGH
  let { ANR_UNION_EXTENSION_LEMMA, .. } := BDGI
  let { ADD1, ADD_SYM, ARITH, CONJ_ASSOC, DISJOINT, DISJOINT_SYM, EXTENSION, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNIONS, IMAGE_o, IMAGE_SUBSET,
        IMAGE_UNION, IMP_CONJ, IN_DELETE, IN_DIFF, INTER_SUBSET, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIONS, IN_UNIV, LE_ADD,
        LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_IMP,
        NOT_IN_EMPTY, REAL_ARCH_POW_INV, .. } := D.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LT_IMP_LE, REAL_LT_POW2, .. } := D.pt.cvx.core4
  let { REAL_NOT_LT, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POW_INV, REAL_SUB_LE, REAL_SUB_LT,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS,
        SUBSET_UNION, .. } := D.pt.cvx.core5
  let { num_INDUCTION, num_WOP, o_DEF, pairwise, real_ge, real_gt, SUBSET_UNIV,
        SWAP_EXISTS_THM, SWAP_FORALL_THM, UNION_SUBSET, UNIONS_0, UNIONS_IMAGE,
        UNIONS_INSERT, UNIONS_SUBSET, UNIONS_UNION, .. } := D.pt.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_SUB, .. } := D.pt.cvx.vec2
  let { drop, .. } := D.pt.cvx.vec4
  let { CLOSED_IN_DIFF, CLOSED_IN_TRANS, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_IMP_SUBSET,
        OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
        OPEN_IN_TRANS, .. } := D.pt.cvx.met
  let { CLOSED_CLOSURE, CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_HALFSPACE_COMPONENT_LE,
        CLOSED_IN_CLOSED_INTER, .. } := D.pt.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.pt.cvx.top3
  let { OPEN_HALFSPACE_COMPONENT_GT, .. } := D.pt.cvx.top4
  let { homeomorphic, OPEN_IN_REFL, SETDIST_EQ_0_CLOSED_IN, SETDIST_POS_LE,
        SETDIST_SUBSET_RIGHT, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { DELETE_SUBSET, DISJOINT_EMPTY, .. } := D.pt.qses
  let { OPEN_IN_UNIONS, .. } := D.pt.qmet
  let { CLOSED_IN_REFL, SETDIST_SING_IN_SET, .. } := D.pt.qtop
  let { COUNTABLE_AS_IMAGE, .. } := D.qcard
  let { CLOSED_IN_IMP_SUBSET, PASTING_LEMMA_EXISTS, SUBTOPOLOGY_SUBTOPOLOGY, .. } :=
        D.qmetric
  let { COVERING_SPACE_LOCALLY_COMPACT_EQ, COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ, .. } :=
        D.qpaths1
  let { DIFF_UNIONS_PAIRWISE_DISJOINT, EVEN_EXISTS, EVEN_OR_ODD, LE_0, LT, LT_SUC_LE,
        ODD_EXISTS, REAL_LT_INV2, REAL_POW_MONO, REAL_POW_MONO_LT, SUBSET_NUMSEG,
        SUBSET_UNIONS, TRANSITIVE_STEPWISE_LE, UNIONS_MONO_IMAGE, WLOG_LT, .. } :=
        D.qsession
  let { CLOSURE_MINIMAL_LOCAL, CONTINUOUS_CLOSED_IN_PREIMAGE,
        CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, CONTINUOUS_MAP_EUCLIDEAN,
        CONTINUOUS_ON_LIFT_SETDIST, CONTINUOUS_OPEN_IN_PREIMAGE, .. } := D.qtopology1
  let { LINDELOF_OPEN_IN, locally, LOCALLY_COMPACT_OPEN_UNION, LOCALLY_COMPACT_OPEN_UNIONS,
        URYSOHN_LOCAL, .. } := D.qtopology2
  let { prove_general_recursive_function_exists, .. } := D
  -- @@SCOPE END

  let ANR_OPEN_UNION ← prove
   r"!s t u:real^N->bool.
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t /\
        ANR(s) /\ ANR(t)
        ==> ANR(s UNION t)"
   (MAP_EVERY X_GEN_TAC
     [← q r"u1:real^N->bool", ← q r"u2:real^N->bool", ← q r"un:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"open_in (subtopology euclidean (u1 UNION u2)) (u1:real^N->bool) /\
      open_in (subtopology euclidean (u1 UNION u2)) (u2:real^N->bool)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET_TRANS, SUBSET_UNION, UNION_SUBSET,
                     OPEN_IN_IMP_SUBSET],
      REPEAT (FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
        check (HolCore.Basics.free_in (← q r"un:real^N->bool") o concl)))] THEN
    MATCH_MP_TAC ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^(N,1)finite_sum->real^N",
      ← q r"s:real^(N,1)finite_sum->bool", ← q r"t:real^(N,1)finite_sum->bool"] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC ANR_UNION_EXTENSION_LEMMA THEN MAP_EVERY ABBREV_TAC
     [← q r"t1 = {x | x IN t /\ ~((f:real^(N,1)finite_sum->real^N)(x) IN u1)}",
