structure DGN where
  HOMOTOPIC_ON_COMPONENTS : thm
  INESSENTIAL_ON_COMPONENTS : thm
  HOMOTOPIC_NEIGHBOURHOOD_EXTENSION : thm
  HOMOTOPIC_ON_COMPONENTS_EQ : thm
  INESSENTIAL_ON_COMPONENTS_EQ : thm
  COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS : thm
  COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS_NULL : thm
  COHOMOTOPICALLY_TRIVIAL_1D : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGN [HolBase] (D : DegreeDeps) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGL : DGL) : ExceptT String IO DGN := do
  -- @@SCOPE BEGIN
  let { ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR, .. } := BDGF
  let { ENR_IMP_ANR, .. } := BDGG
  let { ANR_IMP_LOCALLY_PATH_CONNECTED, .. } := BDGH
  let { EXTENSION_FROM_COMPONENT, .. } := BDGL
  let { ARITH_EQ, CONJ_ASSOC, DIMINDEX_1, EMPTY_SUBSET, EQ_IMP, EXISTS_IN_IMAGE, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_CLAUSES, IMAGE_ID,
        IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.pt.cvx.core2
  let { IN_INSERT, IN_SING, IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IN_EMPTY, NOT_INSERT_EMPTY, PASTECART_IN_PCROSS, .. } := D.pt.cvx.core3
  let { RIGHT_EXISTS_AND_THM, RIGHT_IMP_EXISTS_THM, SING_SUBSET, SKOLEM_THM,
        SNDCART_PASTECART, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_PCROSS,
        SUBSET_REFL, SUBSET_UNION, .. } := D.pt.cvx.core5
  let { o_DEF, SWAP_EXISTS_THM, UNION_ASSOC, UNION_SUBSET, UNIONS_SUBSET, .. } :=
        D.pt.cvx.core6
  let { DIM_UNIV, .. } := D.pt.cvx.vec1
  let { LINEAR_SNDCART, .. } := D.pt.cvx.vec2
  let { SUBSPACE_UNIV, .. } := D.pt.cvx.vec3
  let { OPEN_IN_IMP_SUBSET, .. } := D.pt.cvx.met
  let { CLOSED_EMPTY, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_SING, CLOSED_SUBSET, .. } :=
        D.pt.cvx.top1
  let { COMPACT_COMPONENTS, COMPACT_IMP_CLOSED, COMPACT_INTERVAL, COMPONENTS_EQ_EMPTY,
        CONNECTED_CONTINUOUS_IMAGE, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        HOMEOMORPHIC_SUBSPACES, .. } := D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, IN_COMPONENTS_CONNECTED,
        IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, LINEAR_CONTINUOUS_ON, .. } :=
        D.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_IN_OPEN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        UNIONS_COMPONENTS, UNIT_INTERVAL_NONEMPTY, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { IMAGE_SNDCART_PCROSS, .. } := D.pt.qses
  let { VEC_EQ, .. } := D.pt.qvec
  let { CLOSED_IN_REFL, .. } := D.pt.qtop
  let { IS_INTERVAL_CONNECTED_1, .. } := D.qconvex
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, CLOSED_IN_UNION,
        HOMOTOPIC_CONSTANT_MAPS, HOMOTOPIC_ON_EMPTY, HOMOTOPIC_WITH_EQ,
        HOMOTOPIC_WITH_TRANS, .. } := D.qmetric
  let { COMPONENT_INTERMEDIATE_CLOPEN, HOMEOMORPHIC_CONTRACTIBLE_EQ,
        HOMOTOPIC_ON_CLOPEN_UNIONS, HOMOTOPIC_TRIVIALITY, HOMOTOPIC_WITH_EUCLIDEAN,
        HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, .. } := D.qpaths1
  let { HOMOTOPIC_WITH_SUBSET_LEFT, INESSENTIAL_ON_CLOPEN_UNIONS,
        IS_INTERVAL_CONTRACTIBLE_1, NULLHOMOTOPIC_FROM_CONTRACTIBLE,
        OPEN_IN_COMPONENTS_LOCALLY_CONNECTED, PATH_COMPONENT_OF_EUCLIDEAN,
        PATH_CONNECTED_EQ_CONNECTED_LPC, PATH_CONNECTED_IFF_PATH_COMPONENT,
        SURA_BURA_CLOPEN_SUBSET, .. } := D.qpaths2
  let { PCROSS_UNION, UNIONS_MONO, UNIONS_MONO_IMAGE, .. } := D.qsession
  let { CLOSED_IN_COMPONENT, CLOSED_IN_PCROSS, CLOSED_INSERT, COMPONENTS_EMPTY,
        CONTINUOUS_ON_CASES_LOCAL, .. } := D.qtopology1
  let { TUBE_LEMMA_GEN, .. } := D.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let HOMOTOPIC_ON_COMPONENTS ← prove
   r"!s t f g:real^M->real^N.
        locally connected s /\
        (!c. c IN components s
             ==> homotopic_with (\x. T)
                   (subtopology euclidean c,subtopology euclidean t) f g)
        ==> homotopic_with (\x. T)
             (subtopology euclidean s,subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC
     (RATOR_CONV o LAND_CONV o LAND_CONV o RAND_CONV) [UNIONS_COMPONENTS] THEN
    MATCH_MP_TAC HOMOTOPIC_ON_CLOPEN_UNIONS THEN
    X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← GSYM UNIONS_COMPONENTS] THEN
    ASM_MESON_TAC [CLOSED_IN_COMPONENT, OPEN_IN_COMPONENTS_LOCALLY_CONNECTED])

  let INESSENTIAL_ON_COMPONENTS ← prove
   r"!f:real^M->real^N s t.
        locally connected s /\ path_connected t /\
        (!c. c IN components s
             ==> ?a. homotopic_with (\x. T)
                       (subtopology euclidean c,subtopology euclidean t)
                       f (\x. a))
        ==> ?a. homotopic_with (\x. T)
                  (subtopology euclidean s,subtopology euclidean t)
                  f (\x. a)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"components(s:real^M->bool) = {}") THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [COMPONENTS_EQ_EMPTY]) THEN
      ASM_SIMP_TAC [HOMOTOPIC_ON_EMPTY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?a:real^N. a IN t") MP_TAC THENL
      [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
       DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^M->bool")) THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
       ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
       GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
       FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN SET_TAC [],
       MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_ON_COMPONENTS THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_TRANS) THEN
    REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EUCLIDEAN] THEN
    DISJ2_TAC THEN FIRST_X_ASSUM
     (MATCH_MP_TAC o REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN ASM SET_TAC [])

  let HOMOTOPIC_NEIGHBOURHOOD_EXTENSION ← prove
   r"!f g:real^M->real^N s t u.
        f continuous_on s /\ IMAGE f s SUBSET u /\
        g continuous_on s /\ IMAGE g s SUBSET u /\
        closed_in (subtopology euclidean s) t /\ ANR u /\
        homotopic_with (\x. T)
         (subtopology euclidean t,subtopology euclidean u) f g
        ==> ?v. t SUBSET v /\
                open_in (subtopology euclidean s) v /\
                homotopic_with (\x. T)
                 (subtopology euclidean v,subtopology euclidean u) f g"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,M)finite_sum->real^N")
          STRIP_ASSUME_TAC) THEN
    ABBREV_TAC
     (← q r"h' = \z. if fstcart z IN {vec 0} then f(sndcart z)
               else if fstcart z IN {vec 1} then g(sndcart z)
               else (h:real^(1,M)finite_sum->real^N) z") THEN
    MP_TAC (← ISPECL
     [← q r"h':real^(1,M)finite_sum->real^N",
      ← q r"interval[vec 0:real^1,vec 1] PCROSS (s:real^M->bool)",
      ← q r"{vec 0:real^1,vec 1} PCROSS (s:real^M->bool) UNION
       interval[vec 0,vec 1] PCROSS t",
      ← q r"u:real^N->bool"] ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
    ASM_SIMP_TAC [ENR_IMP_ANR] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{a,b} = {a} UNION {b}")] THEN
        REWRITE_TAC [PCROSS_UNION, UNION_ASSOC] THEN EXPAND_TAC "h'" THEN
        REPLICATE_TAC 2 (MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
         REPLICATE_TAC 2 (CONJ_TAC THENL
          [MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
           EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1] PCROSS (s:real^M->bool)") THEN
           REWRITE_TAC [← SET_RULE (← q r"t UNION u SUBSET s UNION t UNION u")] THEN
           REWRITE_TAC [SUBSET_UNION, UNION_SUBSET, SUBSET_PCROSS] THEN
           REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, ENDS_IN_UNIT_INTERVAL] THEN
           ASM_REWRITE_TAC [SUBSET_REFL] THEN
           TRY (MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC) THEN
           MATCH_MP_TAC CLOSED_IN_PCROSS THEN
           ASM_REWRITE_TAC [CLOSED_IN_REFL] THEN MATCH_MP_TAC CLOSED_SUBSET THEN
           REWRITE_TAC [SING_SUBSET, ENDS_IN_UNIT_INTERVAL, CLOSED_SING],
           ALL_TAC]) THEN
         REPEAT CONJ_TAC THENL
          [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
           MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
           SIMP_TAC [LINEAR_SNDCART, LINEAR_CONTINUOUS_ON] THEN
           ASM_REWRITE_TAC [IMAGE_SNDCART_PCROSS, NOT_INSERT_EMPTY],
           ASM_REWRITE_TAC [],
           REWRITE_TAC [FORALL_PASTECART, IN_UNION, PASTECART_IN_PCROSS] THEN
           REWRITE_TAC [FSTCART_PASTECART, IN_SING, SNDCART_PASTECART] THEN
           MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^M"] THEN
           ASM_CASES_TAC (← q r"x:real^1 = vec 0") THEN ASM_REWRITE_TAC [] THEN
           REWRITE_TAC [VEC_EQ, ARITH_EQ, ENDS_IN_UNIT_INTERVAL] THEN
            ASM_CASES_TAC (← q r"x:real^1 = vec 1") THEN ASM_REWRITE_TAC []]),
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART] THEN
        REWRITE_TAC [IN_UNION, PASTECART_IN_PCROSS, IN_SING, NOT_IN_EMPTY] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^M"] THEN
        REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
        EXPAND_TAC "h'" THEN
        REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_SING] THEN
        REPEAT (COND_CASES_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []]) THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE f s SUBSET u ==> b IN s ==> f b IN u"))) THEN
        ASM_REWRITE_TAC [PASTECART_IN_PCROSS],
        MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC THEN
        MATCH_MP_TAC CLOSED_IN_PCROSS THEN
        ASM_REWRITE_TAC [CLOSED_IN_REFL] THEN
        MATCH_MP_TAC CLOSED_SUBSET THEN
        REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, ENDS_IN_UNIT_INTERVAL] THEN
        SIMP_TAC [CLOSED_INSERT, CLOSED_EMPTY]],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"w:real^(1,M)finite_sum->bool", ← q r"k:real^(1,M)finite_sum->real^N"] THEN
      STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"interval[vec 0:real^1,vec 1]",
                      ← q r"t:real^M->bool", ← q r"s:real^M->bool",
                      ← q r"w:real^(1,M)finite_sum->bool"]
          TUBE_LEMMA_GEN) THEN
    ASM_REWRITE_TAC [COMPACT_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"t':real^M->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [HOMOTOPIC_WITH_EUCLIDEAN_ALT] THEN
    EXISTS_TAC (← q r"k:real^(1,M)finite_sum->real^N") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th =>
      W (MP_TAC o PART_MATCH (fun t => do lhs (← liftExcept (HolCore.Basics.dest_imp t)).2)
          th o lhs o snd)) THEN
    REWRITE_TAC [IN_UNION, PASTECART_IN_PCROSS, IN_INSERT] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC]) THEN
    EXPAND_TAC "h'" THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_SING] THEN
    REWRITE_TAC [VEC_EQ, ARITH_EQ])

  let HOMOTOPIC_ON_COMPONENTS_EQ ← prove
   r"!s t f g:real^M->real^N.
        (locally connected s \/ compact s /\ ANR t)
        ==> (homotopic_with (\x. T)
               (subtopology euclidean s,subtopology euclidean t) f g <=>
             f continuous_on s /\ IMAGE f s SUBSET t /\
             g continuous_on s /\ IMAGE g s SUBSET t /\
             !c. c IN components s
                 ==> homotopic_with (\x. T)
                      (subtopology euclidean c,subtopology euclidean t) f g)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> r) /\ (r ==> (q <=> s)) ==> (q <=> r /\ s)")) THEN
    CONJ_TAC THENL
     [MESON_TAC [HOMOTOPIC_WITH_IMP_CONTINUOUS, HOMOTOPIC_WITH_IMP_SUBSET],
      ALL_TAC] THEN
    STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [HOMOTOPIC_WITH_SUBSET_LEFT, IN_COMPONENTS_SUBSET],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!c. c IN components s
          ==> ?u. c SUBSET u /\
                  closed_in (subtopology euclidean s) u /\
                  open_in (subtopology euclidean s) u /\
                  homotopic_with (\x. T)
                   (subtopology euclidean u,subtopology euclidean t)
                   (f:real^M->real^N) g")
    MP_TAC THENL
     [X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      FIRST_X_ASSUM DISJ_CASES_TAC THENL
       [EXISTS_TAC (← q r"c:real^M->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_COMPONENT, SUBSET_REFL,
                      OPEN_IN_COMPONENTS_LOCALLY_CONNECTED],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
        ASM_REWRITE_TAC [] THEN DISCH_TAC THEN MP_TAC (← ISPECL
         [← q r"f:real^M->real^N", ← q r"g:real^M->real^N",
          ← q r"s:real^M->bool", ← q r"c:real^M->bool", ← q r"t:real^N->bool"]
          HOMOTOPIC_NEIGHBOURHOOD_EXTENSION) THEN
        ASM_SIMP_TAC [CLOSED_IN_COMPONENT] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_IN_OPEN]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^M->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
        MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"c:real^M->bool", ← q r"v:real^M->bool"]
          SURA_BURA_CLOPEN_SUBSET) THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_LOCALLY_COMPACT] THEN
        ANTS_TAC THENL
         [CONJ_TAC THENL [ASM_MESON_TAC [COMPACT_COMPONENTS], ASM SET_TAC []],
          MATCH_MP_TAC MONO_EXISTS] THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN CONJ_TAC THENL
         [MATCH_MP_TAC CLOSED_SUBSET THEN
          ASM_MESON_TAC [COMPACT_IMP_CLOSED, OPEN_IN_IMP_SUBSET],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_SUBSET_LEFT)) THEN
          FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
          ASM SET_TAC []]],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:(real^M->bool)->(real^M->bool)") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"s = UNIONS (IMAGE k (components(s:real^M->bool)))")
       (fun th => tactic_of do pure (SUBST1_TAC th THEN ASSUME_TAC (← SYM th)))
      THENL
        [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
          [GEN_REWRITE_TAC LAND_CONV [UNIONS_COMPONENTS] THEN
           MATCH_MP_TAC UNIONS_MONO THEN REWRITE_TAC [EXISTS_IN_IMAGE] THEN
           ASM_MESON_TAC [],
           REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
           ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET]],
         MATCH_MP_TAC HOMOTOPIC_ON_CLOPEN_UNIONS THEN
         ASM_SIMP_TAC [FORALL_IN_IMAGE]]])

  let INESSENTIAL_ON_COMPONENTS_EQ ← prove
   r"!s t f:real^M->real^N.
        (locally connected s \/ compact s /\ ANR t) /\
        path_connected t
        ==> ((?a. homotopic_with (\x. T)
                   (subtopology euclidean s,subtopology euclidean t)
                   f (\x. a)) <=>
             f continuous_on s /\ IMAGE f s SUBSET t /\
             !c. c IN components s
                 ==> ?a. homotopic_with (\x. T)
                          (subtopology euclidean c,subtopology euclidean t)
                          f (\x. a))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> r) /\ (r ==> (q <=> s)) ==> (q <=> r /\ s)")) THEN
    CONJ_TAC THENL
     [MESON_TAC [HOMOTOPIC_WITH_IMP_CONTINUOUS, HOMOTOPIC_WITH_IMP_SUBSET],
      STRIP_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
         pure (REWRITE_TAC [← MATCH_MP HOMOTOPIC_ON_COMPONENTS_EQ th])) THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [COMPONENTS_EMPTY, IMAGE_CLAUSES, NOT_IN_EMPTY,
                  EMPTY_SUBSET] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?c:real^M->bool. c IN components s") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY, COMPONENTS_EQ_EMPTY], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"d:real^M->bool")] THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
          pure (ASSUME_TAC (← MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET th) THEN
          MP_TAC th)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_TRANS) THEN
    REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EUCLIDEAN] THEN DISJ2_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o
      REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY)) THEN
    ASM SET_TAC [])

  let COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS ← prove
   r"!s:real^M->bool t:real^N->bool.
        (locally connected s \/ compact s /\ ANR t)
         ==> ((!f g. f continuous_on s /\ IMAGE f s SUBSET t /\
                     g continuous_on s /\ IMAGE g s SUBSET t
                     ==> homotopic_with (\x. T)
                          (subtopology euclidean s,subtopology euclidean t)
                          f g) <=>
              (!c. c IN components s
                   ==> (!f g. f continuous_on c /\ IMAGE f c SUBSET t /\
                              g continuous_on c /\ IMAGE g c SUBSET t
                              ==> homotopic_with (\x. T)
                                   (subtopology euclidean c,
                                    subtopology euclidean t) f g)))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"g:real^M->real^N", ← q r"s:real^M->bool",
                        ← q r"c:real^M->bool", ← q r"t:real^N->bool"]
          EXTENSION_FROM_COMPONENT) THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool",
                        ← q r"c:real^M->bool", ← q r"t:real^N->bool"]
          EXTENSION_FROM_COMPONENT) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [ENR_IMP_ANR], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f':real^M->real^N") STRIP_ASSUME_TAC) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [ENR_IMP_ANR], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g':real^M->real^N") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"f':real^M->real^N", ← q r"g':real^M->real^N"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"c:real^M->bool") o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_SUBSET_LEFT)) THEN
      ASM_SIMP_TAC [IN_COMPONENTS_SUBSET] THEN MATCH_MP_TAC
       (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_EQ) THEN
      ASM_SIMP_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY],
      FIRST_ASSUM (fun th => tactic_of do
         pure (REWRITE_TAC [← MATCH_MP HOMOTOPIC_ON_COMPONENTS_EQ th])) THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"c:real^M->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      REPEAT CONJ_TAC THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC []])

  let COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS_NULL ← prove
   r"!s:real^M->bool t:real^N->bool.
        (locally connected s \/ compact s /\ ANR t) /\ path_connected t
         ==> ((!f. f continuous_on s /\ IMAGE f s SUBSET t
                   ==> ?a. homotopic_with (\x. T)
                            (subtopology euclidean s,
                             subtopology euclidean t) f (\x. a)) <=>
              (!c. c IN components s
                   ==> (!f. f continuous_on c /\ IMAGE f c SUBSET t
                            ==> ?a. homotopic_with (\x. T)
                                     (subtopology euclidean c,
                                      subtopology euclidean t) f (\x. a))))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS) THEN
    ASM_SIMP_TAC [HOMOTOPIC_TRIVIALITY])

  let COHOMOTOPICALLY_TRIVIAL_1D ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        ANR t /\ connected t /\
        (dimindex(:M) = 1 \/ ?r:real^1->bool. s homeomorphic r)
        ==> ?a. homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean t) f (\x. a)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"path_connected(t:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [ANR_IMP_LOCALLY_PATH_CONNECTED,
                     PATH_CONNECTED_EQ_CONNECTED_LPC],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← MESON []
      (← q r"p \/ q ==> (p ==> q) ==> q"))) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [← GSYM DIMINDEX_1, ← GSYM DIM_UNIV] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
       (← REWRITE_RULE [CONJ_ASSOC] HOMEOMORPHIC_SUBSPACES))) THEN
      REWRITE_TAC [SUBSPACE_UNIV, homeomorphic] THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^1") THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^M") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"IMAGE (f:real^M->real^1) s") THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_TAC (← q r"r:real^1->bool"))] THEN
    SUBGOAL_THEN
     (← q r"!c. c IN components s
          ==> ?u. closed_in (subtopology euclidean s) u /\
                  open_in (subtopology euclidean s) u /\
                  c SUBSET u /\
                  ?a. homotopic_with (\x. T)
                       (subtopology euclidean u,subtopology euclidean t)
                       (f:real^M->real^N) (\x. a)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"c:real^M->bool", ← q r"t:real^N->bool"]
          NULLHOMOTOPIC_FROM_CONTRACTIBLE) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"g:real^M->real^1", ← q r"h:real^1->real^M"] THEN
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"contractible(IMAGE (g:real^M->real^1) c)") MP_TAC THENL
         [SIMP_TAC [← GSYM IS_INTERVAL_CONTRACTIBLE_1, IS_INTERVAL_CONNECTED_1] THEN
          MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
          FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, homeomorphism],
          MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOMEOMORPHIC_CONTRACTIBLE_EQ THEN
          ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
          MAP_EVERY EXISTS_TAC [← q r"g:real^M->real^1", ← q r"h:real^1->real^M"] THEN
          FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
          RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC []],
        DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N"))] THEN
      MP_TAC (← ISPECL
       [← q r"f:real^M->real^N", ← q r"(\x. a):real^M->real^N",
        ← q r"s:real^M->bool", ← q r"c:real^M->bool", ← q r"t:real^N->bool"]
         HOMOTOPIC_NEIGHBOURHOOD_EXTENSION) THEN
       ASM_REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
       ASM_SIMP_TAC [CLOSED_IN_COMPONENT] THEN ANTS_TAC THENL
        [FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
         FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
         ASM SET_TAC [],
         DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC)] THEN
       MP_TAC (← ISPECL
        [← q r"s:real^M->bool", ← q r"c:real^M->bool", ← q r"u:real^M->bool"]
          COMPONENT_INTERMEDIATE_CLOPEN) THEN
       ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^M->bool") THEN
       STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"a:real^N") THEN
       ASM_MESON_TAC [HOMOTOPIC_WITH_SUBSET_LEFT],
       GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
       REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
       X_GEN_TAC (← q r"u:(real^M->bool)->real^M->bool") THEN STRIP_TAC THEN
       SUBGOAL_THEN
        (← q r"s = UNIONS (IMAGE (u:(real^M->bool)->real^M->bool) (components s))")
        (fun th => tactic_of do pure (SUBST1_TAC th THEN ASSUME_TAC (← SYM th)))
       THENL
        [REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
          [GEN_REWRITE_TAC LAND_CONV [UNIONS_COMPONENTS] THEN
           GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM IMAGE_ID] THEN
           MATCH_MP_TAC UNIONS_MONO_IMAGE THEN ASM_SIMP_TAC [],
           REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
           ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET]],
         MATCH_MP_TAC INESSENTIAL_ON_CLOPEN_UNIONS THEN
         ASM_SIMP_TAC [FORALL_IN_IMAGE]]])

  pure { HOMOTOPIC_ON_COMPONENTS, INESSENTIAL_ON_COMPONENTS,
         HOMOTOPIC_NEIGHBOURHOOD_EXTENSION, HOMOTOPIC_ON_COMPONENTS_EQ,
         INESSENTIAL_ON_COMPONENTS_EQ, COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS,
         COHOMOTOPICALLY_TRIVIAL_ON_COMPONENTS_NULL, COHOMOTOPICALLY_TRIVIAL_1D }

/- ------------------------------------------------------------------------- -/
/- A few simple lemmas about deformation retracts.  (degree.ml 6682-7087)    -/
/- ------------------------------------------------------------------------- -/

structure DGO where
  DEFORMATION_RETRACTION_COMPOSE : thm
  DEFORMATION_RETRACT_TRANS : thm
  DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT : thm
  DEFORMATION_RETRACT : thm
  ANR_STRONG_DEFORMATION_RETRACTION : thm
  DEFORMATION_RETRACT_OF_CONTRACTIBLE : thm
  AR_DEFORMATION_RETRACT_OF_CONTRACTIBLE : thm
  DEFORMATION_RETRACT_OF_CONTRACTIBLE_SING : thm
  STRONG_DEFORMATION_RETRACT_OF_AR : thm
  AR_STRONG_DEFORMATION_RETRACT_OF_AR : thm
  SING_STRONG_DEFORMATION_RETRACT_OF_AR : thm
  HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_CONVEX : thm
  HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_AFFINE_HULL : thm
  HOMOTOPY_EQUIVALENT_PUNCTURED_UNIV_SPHERE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGO [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGL : DGL) (BDGM : DGM) : ExceptT String IO DGO := do
  -- @@SCOPE BEGIN
  let { CLOSED_IN_RETRACT, retract_of, RETRACT_OF_EMPTY, RETRACT_OF_IMP_SUBSET,
        RETRACT_OF_SPACE_EUCLIDEAN, retraction, RETRACTION_MAPS_EUCLIDEAN, RETRACTION_o,
        RETRACTION_REFL, .. } := BDGB
  let { AR_IMP_RETRACT, .. } := BDGF
  let { AR_ANR, AR_IMP_ANR, .. } := BDGG
  let { AR_IMP_CONTRACTIBLE, AR_SING, .. } := BDGH
  let { RELATIVE_FRONTIER_DEFORMATION_RETRACT_OF_PUNCTURED_CONVEX, .. } := BDGL
  let { BORSUK_HOMOTOPY_EXTENSION, .. } := BDGM
  let { ARITH_EQ, CONJ_ASSOC, ETA_AX, EXTENSION, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, ..
        } := D.pt.cvx.core2
  let { IN_INSERT, IN_INTER, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PASTECART_IN_PCROSS, .. } := D.pt.cvx.core3
  let { REAL_LE_MUL, REAL_LE_MUL2, REAL_LT_IMP_NZ, .. } := D.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_NOT_LE,
        REAL_SUB_LE, REAL_SUB_REFL, REAL_SUB_RZERO, SNDCART_PASTECART, SUBSET, SUBSET_REFL,
        .. } := D.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.pt.cvx.core6
  let { DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_NUM, LIFT_SUB, LINEAR_FSTCART,
        LINEAR_SNDCART, .. } := D.pt.cvx.vec2
  let { VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.pt.cvx.vec4
  let { BALL_EQ_EMPTY, BOUNDED_CBALL, CENTRE_IN_BALL, CLOSED_EMPTY, CLOSED_IN_CLOSED,
        CLOSED_SING, CLOSED_UNIV, .. } := D.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_CBALL, LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEN_GEOM_ORIGIN_TAC, MESON, MESON_TAC,
        REAL_ARITH, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { VEC_EQ, .. } := D.pt.qvec
  let { CLOSED_IN_REFL, CLOSED_PCROSS_EQ, .. } := D.pt.qtop
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_CONVEX, CLOSURE_SUBSET_AFFINE_HULL, .. } :=
        D.pt.qcvx1
  let { CONVEX_CBALL, .. } := D.pt.qcvx2
  let { relative_frontier, RELATIVE_INTERIOR_CBALL, .. } := D.pt.qcvx3
  let { AFFINE_HULL_NONEMPTY_INTERIOR, RELATIVE_FRONTIER_CBALL, .. } := D.qconvex
  let { CLOSED_IN_UNION, DEFORMATION_RETRACT_OF_SPACE,
        DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE, HOMOTOPIC_CONSTANT_MAPS,
        HOMOTOPIC_ON_EMPTY, HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS,
        SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.qmetric
  let { CONTRACTIBLE_IMP_PATH_CONNECTED, HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT,
        HOMOTOPIC_COMPOSE_CONTINUOUS_RIGHT, HOMOTOPIC_WITH_EUCLIDEAN,
        HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_SUBSET, .. } := D.qpaths1
  let { contractible, HOMOTOPIC_WITH_RESTRICT, HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN,
        HOMOTOPY_EQUIVALENT_SYM, HOMOTOPY_EQUIVALENT_TRANS, PATH_COMPONENT_OF_EUCLIDEAN,
        PATH_CONNECTED_IFF_PATH_COMPONENT, .. } := D.qpaths2
  let { I_DEF, I_O_ID, PASTECART_FST_SND, PCROSS_UNION, .. } := D.qsession
  let { CLOSED_IN_PCROSS, CLOSED_IN_SING, CLOSED_INSERT, CONTINUOUS_ON_CASES_LOCAL,
        CONTINUOUS_ON_FSTCART, CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_SNDCART, .. } :=
        D.qtopology1
  let { HOMEOMORPHIC_SPHERES, .. } := D.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let DEFORMATION_RETRACTION_COMPOSE ← prove
   r"!s t u r1 r2:real^N->real^N.
        homotopic_with (\x. T)
          (subtopology euclidean s,subtopology euclidean s) (\x. x) r1 /\
        retraction (s,t) r1 /\
        homotopic_with (\x. T)
          (subtopology euclidean t,subtopology euclidean t) (\x. x) r2 /\
        retraction (t,u) r2
        ==> homotopic_with (\x. T)
             (subtopology euclidean s,subtopology euclidean s)
             (\x. x) (r2 o r1) /\
            retraction (s,u) (r2 o r1)"
   (REPEAT STRIP_TAC THENL [ALL_TAC, ASM_MESON_TAC [RETRACTION_o]] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_TRANS THEN
    EXISTS_TAC (← q r"(\x. x) o (r1:real^N->real^N)") THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [o_DEF, ETA_AX], ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_RIGHT THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_RESTRICT)),
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [retraction]) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let DEFORMATION_RETRACT_TRANS ← prove
   r"!s t u:real^N->bool.
        (?r. homotopic_with (\x. T)
              (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
             retraction (s,t) r) /\
        (?r. homotopic_with (\x. T)
              (subtopology euclidean t,subtopology euclidean t) (\x. x) r /\
             retraction (t,u) r)
        ==> ?r. homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction (s,u) r"
   (MESON_TAC [DEFORMATION_RETRACTION_COMPOSE])

  let DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT ← prove
   r"!s t:real^N->bool.
        (?r. homotopic_with (\x. T)
              (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
             retraction(s,t) r)
        ==> s homotopy_equivalent t"
   (REWRITE_TAC [← GSYM I_DEF, ← GSYM RETRACTION_MAPS_EUCLIDEAN] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN] THEN
    MATCH_MP_TAC DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE THEN
    ASM_MESON_TAC [I_O_ID, HOMOTOPIC_WITH_SYM])

  let DEFORMATION_RETRACT ← prove
   r"!s t:real^N->bool.
        (?r. homotopic_with (\x. T)
              (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
             retraction(s,t) r) <=>
        t retract_of s /\
        ?f. homotopic_with (\x. T)
             (subtopology euclidean s,subtopology euclidean s) (\x. x) f /\
            IMAGE f s SUBSET t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology euclidean (s:real^N->bool)", ← q r"t:real^N->bool"]
     DEFORMATION_RETRACT_OF_SPACE) THEN
    REWRITE_TAC [RETRACT_OF_SPACE_EUCLIDEAN, SUBTOPOLOGY_SUBTOPOLOGY,
                 TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, RETRACTION_MAPS_EUCLIDEAN] THEN
    REWRITE_TAC [I_DEF] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    ASM_CASES_TAC (← q r"(t:real^N->bool) SUBSET s") THEN
    ASM_SIMP_TAC [retraction, ← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")])

  let ANR_STRONG_DEFORMATION_RETRACTION ← prove
   r"!s t:real^N->bool.
        ANR s /\
        (?r. homotopic_with (\x. T)
              (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
             retraction(s,t) r)
        ==> ?r. homotopic_with (\h. !x. x IN t ==> h x = x)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,t) r"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:real^(1,N)finite_sum->real^N") THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"g:real^(1,(1,N)finite_sum)finite_sum->real^N =
       \z. if fstcart(sndcart z) = vec 0 then (sndcart(sndcart z))
           else if fstcart(sndcart z) = vec 1
                then f(pastecart (vec 1 - fstcart z)
                                 (f(pastecart (vec 1) (sndcart(sndcart z)))))
           else f(pastecart (lift(drop(fstcart(sndcart z)) *
                                      (&1 - drop (fstcart z))))
                            (sndcart(sndcart z)))") THEN
    MP_TAC (← ISPECL
     [← q r"f:real^(1,N)finite_sum->real^N",
      ← q r"\x. (g:real^(1,(1,N)finite_sum)finite_sum->real^N) (pastecart (vec 1) x)",
      ← q r"{vec 0:real^1,vec 1} PCROSS (s:real^N->bool) UNION
       interval[vec 0:real^1,vec 1] PCROSS (t:real^N->bool)",
      ← q r"interval[vec 0:real^1,vec 1] PCROSS (s:real^N->bool)",
      ← q r"s:real^N->bool"] BORSUK_HOMOTOPY_EXTENSION) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC THEN
        MATCH_MP_TAC CLOSED_IN_PCROSS THEN REWRITE_TAC [CLOSED_IN_REFL] THENL
         [ALL_TAC, ASM_MESON_TAC [CLOSED_IN_RETRACT, retract_of]] THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b} = {a} UNION {b}")] THEN
        MATCH_MP_TAC CLOSED_IN_UNION THEN
        REWRITE_TAC [CLOSED_IN_SING, ENDS_IN_UNIT_INTERVAL],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) HOMOTOPIC_WITH_EUCLIDEAN_ALT o
        snd) THEN
      ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      EXISTS_TAC (← q r"g:real^(1,(1,N)finite_sum)finite_sum->real^N") THEN
      EXPAND_TAC "g" THEN
      REWRITE_TAC [FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      ASM_REWRITE_TAC [DROP_VEC, REAL_SUB_RZERO, REAL_MUL_RID, LIFT_DROP,
                       VECTOR_SUB_RZERO, PASTECART_FST_SND, CONJ_ASSOC] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [IN_UNION, PASTECART_IN_PCROSS, IN_INSERT, NOT_IN_EMPTY] THEN
        REPEAT GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
        SET_TAC []] THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN EXPAND_TAC "g" THEN
        REWRITE_TAC [FORALL_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        ASM_REWRITE_TAC [DROP_VEC, REAL_SUB_RZERO, REAL_MUL_RID, LIFT_DROP,
                     VECTOR_SUB_RZERO, PASTECART_FST_SND, CONJ_ASSOC,
                     PASTECART_IN_PCROSS, IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1", ← q r"y:real^N"] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
         [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC [],
          ALL_TAC] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE f s SUBSET t ==> x IN s ==> f x IN t"))) THEN
        ASM_REWRITE_TAC [PASTECART_IN_PCROSS] THEN
        (CONJ_TAC THENL
          [ALL_TAC,
           FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
           ASM SET_TAC []]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC, DROP_SUB,
                         REAL_SUB_LE, ← REAL_ARITH (← q r"&1 - x <= &1 <=> &0 <= x")] THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
        MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REAL_ARITH_TAC] THEN
      EXPAND_TAC "g" THEN
      REWRITE_TAC [← MESON [] (← q r"(if p then x else if q then y else r) =
          (if p \/ q then if p then x else y else r)")] THEN
      REWRITE_TAC [PCROSS_UNION] THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [CLOSED_IN_CLOSED] THEN
        EXISTS_TAC (← q r"(:real^1) PCROSS {vec 0:real^1,vec 1} PCROSS (:real^N)") THEN
        SIMP_TAC [CLOSED_PCROSS_EQ, CLOSED_UNIV, CLOSED_INSERT, CLOSED_EMPTY] THEN
        REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNION, IN_INTER,
                     EXTENSION, IN_UNIV, IN_INSERT, NOT_IN_EMPTY] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
        DISCH_THEN (MP_TAC o CONJUNCT1 o REWRITE_RULE [SUBSET]) THEN
        MESON_TAC [ENDS_IN_UNIT_INTERVAL],
        SUBGOAL_THEN (← q r"closed_in (subtopology euclidean s) (t:real^N->bool)")
        MP_TAC THENL [ASM_MESON_TAC [CLOSED_IN_RETRACT, retract_of], ALL_TAC] THEN
        REWRITE_TAC [CLOSED_IN_CLOSED] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(:real^1) PCROSS (:real^1) PCROSS (c:real^N->bool)") THEN
        ASM_REWRITE_TAC [CLOSED_PCROSS_EQ, CLOSED_UNIV] THEN
        REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNION, IN_INTER,
                     EXTENSION, IN_UNIV, IN_INSERT, NOT_IN_EMPTY] THEN
        MESON_TAC [ENDS_IN_UNIT_INTERVAL],
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b} = {a} UNION {b}")] THEN
        REWRITE_TAC [PCROSS_UNION] THEN
        MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN REPEAT CONJ_TAC THENL
         [REWRITE_TAC [CLOSED_IN_CLOSED] THEN EXISTS_TAC
           (← q r"(:real^1) PCROSS {vec 0:real^1} PCROSS (:real^N)") THEN
          ASM_REWRITE_TAC [CLOSED_PCROSS_EQ, CLOSED_UNIV] THEN
          REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNION, IN_INTER,
                  EXTENSION, IN_UNIV, IN_INSERT, NOT_IN_EMPTY, CLOSED_SING] THEN
          MESON_TAC [ENDS_IN_UNIT_INTERVAL],
          REWRITE_TAC [CLOSED_IN_CLOSED] THEN EXISTS_TAC
           (← q r"(:real^1) PCROSS {vec 1:real^1} PCROSS (:real^N)") THEN
          ASM_REWRITE_TAC [CLOSED_PCROSS_EQ, CLOSED_UNIV] THEN
          REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNION, IN_INTER,
                  EXTENSION, IN_UNIV, IN_INSERT, NOT_IN_EMPTY, CLOSED_SING] THEN
          MESON_TAC [ENDS_IN_UNIT_INTERVAL],
          SIMP_TAC [CONTINUOUS_ON_SNDCART, LINEAR_CONTINUOUS_ON,
                    LINEAR_SNDCART],
          ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
           [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
            SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                      LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
            GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
            MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
            SIMP_TAC [CONTINUOUS_ON_SNDCART, LINEAR_CONTINUOUS_ON,
                      LINEAR_SNDCART] THEN
            FIRST_X_ASSUM (STRIP_ASSUME_TAC o
              GEN_REWRITE_RULE I [retraction]) THEN
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
            REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
                         FORALL_PASTECART, SNDCART_PASTECART] THEN
            SIMP_TAC [],
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
            REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
              FORALL_PASTECART, SNDCART_PASTECART, FSTCART_PASTECART] THEN
            SIMP_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN
            SIMP_TAC [← REAL_ARITH (← q r"&1 - x <= &1 <=> &0 <= x"), REAL_SUB_LE] THEN
            FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
            SET_TAC []],
          REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS,
                       FSTCART_PASTECART, SNDCART_PASTECART, IN_SING] THEN
          MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1", ← q r"y:real^N"] THEN
          ASM_CASES_TAC (← q r"v:real^1 = vec 0") THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [VEC_EQ, ARITH_EQ]],
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
          SIMP_TAC [CONTINUOUS_ON_SNDCART, LINEAR_CONTINUOUS_ON,
                     LINEAR_SNDCART] THEN
          REWRITE_TAC [LIFT_CMUL] THEN MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          SIMP_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_FSTCART,
                    LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
          SIMP_TAC [LIFT_SUB, LIFT_DROP, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                    LINEAR_CONTINUOUS_ON, LINEAR_FSTCART],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
            FORALL_PASTECART, SNDCART_PASTECART, FSTCART_PASTECART] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, LIFT_DROP] THEN
          SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE] THEN
          REPEAT STRIP_TAC THENL
           [GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
            MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REAL_ARITH_TAC,
            FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
            ASM SET_TAC []]],
        REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS,
                      FSTCART_PASTECART, SNDCART_PASTECART, IN_SING] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1", ← q r"y:real^N"] THEN
        COND_CASES_TAC THEN
        ASM_REWRITE_TAC [IN_INSERT, LIFT_DROP, REAL_MUL_LZERO, DROP_VEC,
                         LIFT_NUM] THEN
        ASM_CASES_TAC (← q r"v:real^1 = vec 1") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
        ASM_REWRITE_TAC [DROP_VEC, REAL_MUL_LID,
                         LIFT_SUB, LIFT_NUM, LIFT_DROP] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
        ASM SET_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,N)finite_sum->real^N")
      STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(h:real^(1,N)finite_sum->real^N) o pastecart (vec 1)") THEN
    CONJ_TAC THENL
     [W (MP_TAC o PART_MATCH (lhand o rand) HOMOTOPIC_WITH_EUCLIDEAN_ALT o
        snd) THEN
      ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      EXISTS_TAC (← q r"h:real^(1,N)finite_sum->real^N") THEN
      ASM_SIMP_TAC [IN_UNION, PASTECART_IN_PCROSS, IN_INSERT, o_THM] THEN
      EXPAND_TAC "g" THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      ASM_REWRITE_TAC [DROP_VEC, VECTOR_SUB_REFL, REAL_SUB_REFL, REAL_MUL_RZERO,
                       LIFT_NUM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC [],
      REWRITE_TAC [retraction, o_THM] THEN REPEAT CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
          SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
                    CONTINUOUS_ON_ID],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
          SIMP_TAC [ENDS_IN_UNIT_INTERVAL]],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_THM],
        ALL_TAC] THEN
      ASM_SIMP_TAC [IN_UNION, IN_INSERT, PASTECART_IN_PCROSS,
         ENDS_IN_UNIT_INTERVAL] THEN
      EXPAND_TAC "g" THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, VEC_EQ, ARITH_EQ] THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN SET_TAC []])

  let DEFORMATION_RETRACT_OF_CONTRACTIBLE ← prove
   r"!s t:real^N->bool.
        contractible s /\ t retract_of s
        ==> ?r. homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,t) r"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [RETRACT_OF_EMPTY, HOMOTOPIC_ON_EMPTY,
                  TOPSPACE_EUCLIDEAN_SUBTOPOLOGY]
    THENL [MESON_TAC [RETRACTION_REFL], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [DEFORMATION_RETRACT] THEN
    SUBGOAL_THEN (← q r"?a:real^N. a IN t") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY, AR_ANR], ALL_TAC] THEN
    EXISTS_TAC (← q r"(\x. a):real^N->real^N") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [contractible]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [RETRACT_OF_IMP_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:real^N) IN s") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_TRANS)) THEN
    REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS, PATH_COMPONENT_OF_EUCLIDEAN] THEN
    ASM_MESON_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT,
                   CONTRACTIBLE_IMP_PATH_CONNECTED])

  let AR_DEFORMATION_RETRACT_OF_CONTRACTIBLE ← prove
   r"!s t:real^N->bool.
        contractible s /\ AR t /\ closed_in (subtopology euclidean s) t
        ==> ?r. homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,t) r"
   (MESON_TAC [DEFORMATION_RETRACT_OF_CONTRACTIBLE, AR_IMP_RETRACT])

  let DEFORMATION_RETRACT_OF_CONTRACTIBLE_SING ← prove
   r"!s a:real^N.
        contractible s /\ a IN s
        ==> ?r. homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,{a}) r"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC AR_DEFORMATION_RETRACT_OF_CONTRACTIBLE THEN
    ASM_REWRITE_TAC [CLOSED_IN_SING, AR_SING])

  let STRONG_DEFORMATION_RETRACT_OF_AR ← prove
   r"!s t:real^N->bool.
        AR s /\ t retract_of s
        ==> ?r. homotopic_with (\h. !x. x IN t ==> h x = x)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,t) r"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ANR_STRONG_DEFORMATION_RETRACTION THEN
    ASM_SIMP_TAC [AR_IMP_ANR] THEN
    MATCH_MP_TAC DEFORMATION_RETRACT_OF_CONTRACTIBLE THEN
    ASM_SIMP_TAC [AR_IMP_CONTRACTIBLE])

  let AR_STRONG_DEFORMATION_RETRACT_OF_AR ← prove
   r"!s t:real^N->bool.
        AR s /\ AR t /\ closed_in (subtopology euclidean s) t
        ==> ?r. homotopic_with (\h. !x. x IN t ==> h x = x)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,t) r"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ANR_STRONG_DEFORMATION_RETRACTION THEN
    ASM_SIMP_TAC [AR_IMP_ANR] THEN
    MATCH_MP_TAC AR_DEFORMATION_RETRACT_OF_CONTRACTIBLE THEN
    ASM_SIMP_TAC [AR_IMP_CONTRACTIBLE])

  let SING_STRONG_DEFORMATION_RETRACT_OF_AR ← prove
   r"!s a:real^N.
        AR s /\ a IN s
        ==> ?r. homotopic_with (\h. h a = a)
                 (subtopology euclidean s,subtopology euclidean s) (\x. x) r /\
                retraction(s,{a}) r"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"{a:real^N}"]
          AR_STRONG_DEFORMATION_RETRACT_OF_AR) THEN
    ASM_REWRITE_TAC [AR_SING, CLOSED_IN_SING] THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY])

  let HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_CONVEX ← prove
   r"!s t a:real^N.
      convex s /\ bounded s /\ a IN relative_interior s /\
      convex t /\ relative_frontier s SUBSET t /\ t SUBSET affine hull s
      ==> (relative_frontier s) homotopy_equivalent (t DELETE a)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMOTOPY_EQUIVALENT_SYM] THEN
    MATCH_MP_TAC DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT THEN
    ASM_MESON_TAC [RELATIVE_FRONTIER_DEFORMATION_RETRACT_OF_PUNCTURED_CONVEX])

  let HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_AFFINE_HULL ← prove
   r"!s a:real^N.
      convex s /\ bounded s /\ a IN relative_interior s
      ==> (relative_frontier s) homotopy_equivalent (affine hull s DELETE a)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_CONVEX THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL, SUBSET_REFL] THEN
    REWRITE_TAC [relative_frontier] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET u ==> s DIFF t SUBSET u")) THEN
    REWRITE_TAC [CLOSURE_SUBSET_AFFINE_HULL])

  let HOMOTOPY_EQUIVALENT_PUNCTURED_UNIV_SPHERE ← prove
   r"!c a:real^N r.
        &0 < r ==> ((:real^N) DELETE c) homotopy_equivalent sphere(a,r)"
   (REPEAT GEN_TAC THEN GEN_GEOM_ORIGIN_TAC (← q r"c:real^N") ["a"] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMOTOPY_EQUIVALENT_SYM] THEN
    TRANS_TAC HOMOTOPY_EQUIVALENT_TRANS (← q r"sphere(vec 0:real^N,r)") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SPHERES, HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT] THEN
    MP_TAC (← ISPECL [← q r"cball(vec 0:real^N,r)", ← q r"vec 0:real^N"]
      HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_AFFINE_HULL) THEN
    REWRITE_TAC [CONVEX_CBALL, BOUNDED_CBALL, RELATIVE_FRONTIER_CBALL,
                 RELATIVE_INTERIOR_CBALL] THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL, REAL_LT_IMP_NZ, AFFINE_HULL_NONEMPTY_INTERIOR,
                  INTERIOR_CBALL, BALL_EQ_EMPTY, REAL_NOT_LE])

  pure { DEFORMATION_RETRACTION_COMPOSE, DEFORMATION_RETRACT_TRANS,
         DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT, DEFORMATION_RETRACT,
         ANR_STRONG_DEFORMATION_RETRACTION, DEFORMATION_RETRACT_OF_CONTRACTIBLE,
         AR_DEFORMATION_RETRACT_OF_CONTRACTIBLE, DEFORMATION_RETRACT_OF_CONTRACTIBLE_SING,
         STRONG_DEFORMATION_RETRACT_OF_AR, AR_STRONG_DEFORMATION_RETRACT_OF_AR,
         SING_STRONG_DEFORMATION_RETRACT_OF_AR,
         HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_CONVEX,
         HOMOTOPY_EQUIVALENT_RELATIVE_FRONTIER_PUNCTURED_AFFINE_HULL,
         HOMOTOPY_EQUIVALENT_PUNCTURED_UNIV_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Preservation of fixpoints under (more general notion of) retraction, and  -/
/- Bohl-type fixed point theorems.  (degree.ml 7088-7406)                    -/
/- ------------------------------------------------------------------------- -/

structure DGP where
  INVERTIBLE_FIXPOINT_PROPERTY : thm
  HOMEOMORPHIC_FIXPOINT_PROPERTY : thm
  RETRACT_FIXPOINT_PROPERTY : thm
  FRONTIER_SUBSET_RETRACTION : thm
  NO_RETRACTION_FRONTIER_BOUNDED : thm
  COMPACT_SUBSET_FRONTIER_RETRACTION : thm
  NOT_ABSOLUTE_RETRACT_COBOUNDED : thm
  BOHL : thm
  BOHL_ALT : thm
  BOHL_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGP [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGC : DGC) (BDGL : DGL) : ExceptT String IO DGP := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_SUBSET, RETRACT_OF_TRANS, retraction, .. } := BDGB
  let { BROUWER, NO_RETRACTION_CBALL, .. } := BDGC
  let { RELATIVE_FRONTIER_DEFORMATION_RETRACT_OF_PUNCTURED_CONVEX,
        SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE, SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE_GEN, .. }
        := BDGL
  let { CONTRAPOS_THM, EQ_IMP, FORALL_IN_GSPEC, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IN_DELETE, IN_DIFF, ..
        } := D.pt.cvx.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IN_EMPTY, OR_EXISTS_THM, REAL_ABS_DIV, REAL_DIV_REFL,
        REAL_DIV_RMUL, .. } := D.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_LE_1, REAL_LE_INV_EQ, REAL_LT_IMP_LE, REAL_LT_IMP_NZ,
        REAL_LT_REFL, .. } := D.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_NOT_LE, REAL_SUB_LE, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } :=
        D.pt.cvx.core5
  let { o_DEF, o_THM, real_div, SUBSET_UNIV, UNION_SUBSET, .. } := D.pt.cvx.core6
  let { DIST_0, .. } := D.pt.cvx.vec1
  let { LIFT_CMUL, NORM_EQ_0, .. } := D.pt.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.pt.cvx.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_SUB_EQ, .. } :=
        D.pt.cvx.vec4
  let { BOUNDED_CLOSURE, BOUNDED_SUBSET_BALL, CLOSED_CBALL, CLOSED_CLOSURE,
        CLOSED_INTER_COMPACT, CLOSURE_CLOSED, CLOSURE_COMPLEMENT, .. } := D.pt.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, FRONTIER_CBALL, FRONTIER_SUBSET_EQ, .. } := D.pt.cvx.top3
  let { IN_BALL, IN_CBALL, IN_SEGMENT, IN_SPHERE, INTERIOR_EMPTY, INTERIOR_SUBSET, .. } :=
        D.pt.cvx.top4
  let { frontier, homeomorphic, homeomorphism, OPEN_INTERIOR, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEOM_ORIGIN_TAC, MESON_TAC, NORM_ARITH,
        REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.pt.cvx
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_CONVEX, CLOSURE_SUBSET_AFFINE_HULL, .. } :=
        D.pt.qcvx1
  let { convex, RELATIVE_FRONTIER_NONEMPTY_INTERIOR, .. } := D.pt.qcvx3
  let { AFFINE_HULL_NONEMPTY_INTERIOR, RELATIVE_INTERIOR_NONEMPTY_INTERIOR, .. } :=
        D.qconvex
  let { BOUNDED_UNION, CONTINUOUS_ON_CASES, CONTINUOUS_ON_CMUL, .. } := D.qtopology1
  let { OPEN_CLOSED, SPHERE_SUBSET_CBALL, .. } := D.qtopology2
  -- @@SCOPE END

  let INVERTIBLE_FIXPOINT_PROPERTY ← prove
   r"!s:real^M->bool t:real^N->bool i r.
     i continuous_on t /\ IMAGE i t SUBSET s /\
     r continuous_on s /\ IMAGE r s SUBSET t /\
     (!y. y IN t ==> (r(i(y)) = y))
     ==> (!f. f continuous_on s /\ IMAGE f s SUBSET s
              ==> ?x. x IN s /\ (f x = x))
         ==> !g. g continuous_on t /\ IMAGE g t SUBSET t
                 ==> ?y. y IN t /\ (g y = y)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"(i:real^N->real^M) o (g:real^N->real^N) o (r:real^M->real^N)")) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, CONTINUOUS_ON_COMPOSE, IMAGE_SUBSET,
                     SUBSET_TRANS, IMAGE_o],
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
      REWRITE_TAC [o_THM] THEN ASM_MESON_TAC []])

  let HOMEOMORPHIC_FIXPOINT_PROPERTY ← prove
   r"!s t. s homeomorphic t
         ==> ((!f. f continuous_on s /\ IMAGE f s SUBSET s
                   ==> ?x. x IN s /\ (f x = x)) <=>
              (!g. g continuous_on t /\ IMAGE g t SUBSET t
                   ==> ?y. y IN t /\ (g y = y)))"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN MATCH_MP_TAC INVERTIBLE_FIXPOINT_PROPERTY THEN
    ASM_MESON_TAC [SUBSET_REFL])

  let RETRACT_FIXPOINT_PROPERTY ← prove
   r"!s t:real^N->bool.
        t retract_of s /\
        (!f. f continuous_on s /\ IMAGE f s SUBSET s
             ==> ?x. x IN s /\ (f x = x))
        ==> !g. g continuous_on t /\ IMAGE g t SUBSET t
                ==> ?y. y IN t /\ (g y = y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC INVERTIBLE_FIXPOINT_PROPERTY THEN
    EXISTS_TAC (← q r"\x:real^N. x") THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [retract_of] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN REWRITE_TAC [retraction] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE])

  let FRONTIER_SUBSET_RETRACTION ← prove
   r"!s:real^N->bool t r.
        bounded s /\
        frontier s SUBSET t /\
        r continuous_on (closure s) /\
        IMAGE r s SUBSET t /\
        (!x. x IN t ==> r x = x)
        ==> s SUBSET t"
   (ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [← SET_RULE (← q r"~(s SUBSET t) <=> ?x. x IN s /\ ~(x IN t)")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    REPLICATE_TAC 3 GEN_TAC THEN X_GEN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"q = \z:real^N. if z IN closure s then r(z) else z") THEN
    SUBGOAL_THEN
      (← q r"(q:real^N->real^N) continuous_on
        closure(s) UNION closure((:real^N) DIFF s)")
    MP_TAC THENL
     [EXPAND_TAC "q" THEN MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
      ASM_REWRITE_TAC [CLOSED_CLOSURE, CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [← TAUT (← q r"p /\ ~p <=> F")] THEN X_GEN_TAC (← q r"z:real^N") THEN
      REWRITE_TAC [CLOSURE_COMPLEMENT, IN_DIFF, IN_UNIV] THEN STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, frontier, IN_DIFF]) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"closure(s) UNION closure((:real^N) DIFF s) = (:real^N)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET closure s /\ t SUBSET closure t /\ s UNION t = UNIV
        ==> closure s UNION closure t = UNIV")) THEN
      REWRITE_TAC [CLOSURE_SUBSET] THEN SET_TAC [],
      DISCH_TAC] THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o SPEC (← q r"a:real^N") o
      MATCH_MP BOUNDED_SUBSET_BALL o MATCH_MP BOUNDED_CLOSURE) THEN
    SUBGOAL_THEN (← q r"!x. ~((q:real^N->real^N) x = a)") ASSUME_TAC THENL
     [GEN_TAC THEN EXPAND_TAC "q" THEN COND_CASES_TAC THENL
       [ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(x:real^N) IN t") (fun th => ASM_MESON_TAC [th]) THEN
        UNDISCH_TAC (← q r"frontier(s:real^N->bool) SUBSET t") THEN
        REWRITE_TAC [SUBSET, frontier, IN_DIFF] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET],
        ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET, CLOSURE_SUBSET]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"B:real"] NO_RETRACTION_CBALL) THEN
    ASM_REWRITE_TAC [retract_of, ← GSYM FRONTIER_CBALL] THEN
    EXISTS_TAC (← q r"(\y. a + B / norm(y - a) % (y - a)) o (q:real^N->real^N)") THEN
    REWRITE_TAC [retraction, FRONTIER_SUBSET_EQ, CLOSED_CBALL] THEN
    REWRITE_TAC [FRONTIER_CBALL, SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_SPHERE, DIST_0] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [o_DEF, real_div, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      SUBGOAL_THEN (← q r"(\x:real^N. lift(norm(x - a))) = (lift o norm) o (\x. x - a)")
      SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_THM], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [CONTINUOUS_ON_LIFT_NORM],
      REWRITE_TAC [o_THM, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM,
                   ← NORM_ARITH (← q r"dist(a,a + b) = norm b")] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, VECTOR_SUB_EQ, NORM_EQ_0] THEN
      ASM_REAL_ARITH_TAC,
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN REWRITE_TAC [o_THM] THEN
      EXPAND_TAC "q" THEN REWRITE_TAC [] THEN COND_CASES_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_BALL]) THEN
        ASM_MESON_TAC [REAL_LT_REFL],
        REWRITE_TAC [← NORM_ARITH (← q r"norm(x - a) = dist(a,x)")] THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ, VECTOR_MUL_LID] THEN
        VECTOR_ARITH_TAC]])

  let NO_RETRACTION_FRONTIER_BOUNDED ← prove
   r"!s:real^N->bool.
        bounded s /\ ~(interior s = {}) ==> ~((frontier s) retract_of s)"
   (GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [retract_of, retraction] THEN
    REWRITE_TAC [FRONTIER_SUBSET_EQ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"frontier s:real^N->bool",
                      ← q r"r:real^N->real^N"] FRONTIER_SUBSET_RETRACTION) THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED, SUBSET_REFL] THEN REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN ASM SET_TAC [])

  let COMPACT_SUBSET_FRONTIER_RETRACTION ← prove
   r"!f:real^N->real^N s.
        compact s /\ f continuous_on s /\ (!x. x IN frontier s ==> f x = x)
        ==> s SUBSET IMAGE f s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s UNION (IMAGE f s):real^N->bool", ← q r"vec 0:real^N"]
      BOUNDED_SUBSET_BALL) THEN
    ASM_SIMP_TAC [BOUNDED_UNION, COMPACT_IMP_BOUNDED,
                  COMPACT_CONTINUOUS_IMAGE, UNION_SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"g = \x:real^N. if x IN s then f(x) else x") THEN
    SUBGOAL_THEN (← q r"(g:real^N->real^N) continuous_on (:real^N)") ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"(:real^N) = s UNION closure((:real^N) DIFF s)") SUBST1_TAC
      THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"UNIV DIFF s SUBSET t ==> UNIV = s UNION t")) THEN
        REWRITE_TAC [CLOSURE_SUBSET],
        ALL_TAC] THEN
      EXPAND_TAC "g" THEN MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
      ASM_SIMP_TAC [CLOSED_CLOSURE, CONTINUOUS_ON_ID, COMPACT_IMP_CLOSED] THEN
      REWRITE_TAC [CLOSURE_COMPLEMENT, IN_DIFF, IN_UNIV] THEN
      REWRITE_TAC [← TAUT (← q r"p /\ ~p <=> F")] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [frontier, IN_DIFF] THEN
      ASM_SIMP_TAC [CLOSURE_CLOSED, COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"p:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?h:real^N->real^N.
          retraction (UNIV DELETE p,sphere(vec 0,r)) h")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM retract_of] THEN
      MATCH_MP_TAC SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE_GEN THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"r:real"] NO_RETRACTION_CBALL) THEN
    ASM_REWRITE_TAC [retract_of, NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(h:real^N->real^N) o (g:real^N->real^N)")) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    REWRITE_TAC [retraction] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
    SIMP_TAC [SUBSET, IN_SPHERE, IN_CBALL, REAL_EQ_IMP_LE] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_DELETE, IN_UNIV, o_THM] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN cball (vec 0,r) ==> ~((g:real^N->real^N) x = p)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN EXPAND_TAC "g" THEN
      COND_CASES_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_DELETE],
      SUBGOAL_THEN (← q r"(g:real^N->real^N) x = x") (fun th => ASM_SIMP_TAC [th]) THEN
      EXPAND_TAC "g" THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [IN_BALL, REAL_LT_REFL, SUBSET]])

  let NOT_ABSOLUTE_RETRACT_COBOUNDED ← prove
   r"!s. bounded s /\ ((:real^N) DIFF s) retract_of (:real^N) ==> s = {}"
   (GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"(!x. x IN s ==> F) ==> s = {}")) THEN
    X_GEN_TAC (← q r"a:real^N") THEN POP_ASSUM MP_TAC THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o
      MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP NO_RETRACTION_CBALL) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC RETRACT_OF_SUBSET THEN
    EXISTS_TAC (← q r"(:real^N)") THEN SIMP_TAC [SUBSET_UNIV, SPHERE_SUBSET_CBALL] THEN
    MATCH_MP_TAC RETRACT_OF_TRANS THEN EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC RETRACT_OF_SUBSET THEN
    EXISTS_TAC (← q r"(:real^N) DELETE (vec 0)") THEN
    ASM_SIMP_TAC [SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_SPHERE, IN_DIFF, IN_UNIV] THEN
    MESON_TAC [REAL_LT_REFL])

  let BOHL ← prove
   r"!f s a:real^N.
        f continuous_on s /\ convex s /\ compact s /\ a IN interior s
        ==> (?x. x IN s /\ f x = x) \/
            (?x. x IN frontier s /\ x IN segment(a,f x))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, INTERIOR_EMPTY] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"affine hull s:real^N->bool", ← q r"a:real^N"]
          RELATIVE_FRONTIER_DEFORMATION_RETRACT_OF_PUNCTURED_CONVEX) THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL, COMPACT_IMP_BOUNDED] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE (← q r"a IN s ==> ~(s = {})"))) THEN
    ASM_SIMP_TAC [RELATIVE_INTERIOR_NONEMPTY_INTERIOR,
                  RELATIVE_FRONTIER_NONEMPTY_INTERIOR] THEN
    SIMP_TAC [SUBSET_REFL, frontier, CLOSURE_SUBSET_AFFINE_HULL,
              ← SET_RULE (← q r"s SUBSET u ==> s DIFF t SUBSET u")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retraction]) THEN
    ASM_SIMP_TAC [AFFINE_HULL_NONEMPTY_INTERIOR, ← GSYM frontier] THEN
    STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"(\x. if x IN s then x else r x) o (f:real^N->real^N)",
      ← q r"s:real^N->bool"] BROUWER) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN
         (← q r"IMAGE (f:real^N->real^N) s =
                  s INTER IMAGE f s UNION
                  ((:real^N) DIFF interior s) INTER IMAGE f s")
        SUBST1_TAC THENL
         [MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN SET_TAC [],
          ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
        ASM_SIMP_TAC [CLOSED_INTER_COMPACT, COMPACT_CONTINUOUS_IMAGE,
                      COMPACT_IMP_CLOSED, ← GSYM OPEN_CLOSED, OPEN_INTERIOR] THEN
        REWRITE_TAC [CONTINUOUS_ON_ID] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
          REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [frontier] THEN
          MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC []],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:real^N") THEN
        DISCH_TAC THEN REWRITE_TAC [o_DEF] THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE r t SUBSET u ==> u SUBSET s /\ y IN t ==> r y IN s"))) THEN
        ASM_SIMP_TAC [frontier, CLOSURE_CLOSED, COMPACT_IMP_CLOSED] THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN ASM SET_TAC []],
      REWRITE_TAC [OR_EXISTS_THM, o_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"x:real^N") THEN COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
      ASM_CASES_TAC (← q r"f(x:real^N) = x") THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~((f:real^N->real^N) x = a)") ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC [IN_SEGMENT]] THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"c:real") MP_TAC o
          SPEC (← q r"(f:real^N->real^N) x")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"c:real") THEN ASM_REWRITE_TAC [← VECTOR_ARITH
       (← q r"x:real^N = (&1 - c) % a + c % y <=> x - a = c % (y - a)")] THEN
      REWRITE_TAC [← GSYM REAL_NOT_LE] THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~((f:real^N->real^N) x IN s)") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [convex]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"a:real^N", ← q r"x:real^N", ← q r"&1 - inv c", ← q r"inv(c):real"]) THEN
      FIRST_ASSUM (ASSUME_TAC o
        MATCH_MP (← REWRITE_RULE [SUBSET] INTERIOR_SUBSET)) THEN
      ASM_SIMP_TAC [REAL_LE_INV_EQ, REAL_SUB_LE, REAL_LT_IMP_LE,
                    REAL_INV_LE_1, ← REAL_ARITH (← q r"(&1 - u) + u = &1")] THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
        [← MATCH_MP (← VECTOR_ARITH (← q r"x - a:real^N = y ==> x = a + y")) th])) THEN
      REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, ← REAL_ARITH (← q r"&1 <= c ==> ~(c = &0)")] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      CONV_TAC (fun t => VECTOR_ARITH t)])

  let BOHL_ALT ← prove
   r"!f s a.
        f continuous_on s /\ convex s /\ compact s /\ a IN interior s /\
        IMAGE f s SUBSET (:real^N) DELETE a
        ==> ?x. x IN frontier s /\ a IN segment(x,f x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x:real^N. x + (a - f(x))", ← q r"s:real^N->bool", ← q r"a:real^N"]
          BOHL) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                  CONTINUOUS_ON_ID] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x + a - y:real^N = x <=> y = a")] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [IN_SEGMENT, ← VECTOR_ARITH (← q r"a:real^N = x + a - y <=> y = x")] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
    CONV_TAC (fun t => VECTOR_ARITH t))

  let BOHL_SIMPLE ← prove
   r"!f:real^N->real^N s a.
       compact s /\ a IN s /\
       f continuous_on s /\ IMAGE f s SUBSET (:real^N) DELETE a
       ==> ?x. x IN frontier s /\ ~(f x = x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"s:real^N->bool"]
          COMPACT_SUBSET_FRONTIER_RETRACTION) THEN
    ASM SET_TAC [])

  pure { INVERTIBLE_FIXPOINT_PROPERTY, HOMEOMORPHIC_FIXPOINT_PROPERTY,
         RETRACT_FIXPOINT_PROPERTY, FRONTIER_SUBSET_RETRACTION,
         NO_RETRACTION_FRONTIER_BOUNDED, COMPACT_SUBSET_FRONTIER_RETRACTION,
         NOT_ABSOLUTE_RETRACT_COBOUNDED, BOHL, BOHL_ALT, BOHL_SIMPLE }

/- ------------------------------------------------------------------------- -/
/- Connectivity of retract complements; fixpoints for ANRs; Schauder lemma.  -/
/- (degree.ml 7407-7705)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DGQ where
  BOUNDED_COMPONENT_RETRACT_COMPLEMENT_MEETS : thm
  COMPONENT_RETRACT_COMPLEMENT_MEETS : thm
  FINITE_COMPLEMENT_ENR_COMPONENTS : thm
  FINITE_COMPLEMENT_ANR_COMPONENTS : thm
  CARD_LE_RETRACT_COMPLEMENT_COMPONENTS : thm
  CONNECTED_RETRACT_COMPLEMENT : thm
  BROUWER_INESSENTIAL_ANR : thm
  BROUWER_CONTRACTIBLE_ANR : thm
  FIXED_POINT_INESSENTIAL_SPHERE_MAP : thm
  BROUWER_AR : thm
  BROUWER_ABSOLUTE_RETRACT : thm
  SCHAUDER_PROJECTION : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGQ [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGC : DGC) (BDGG : DGG) (BDGL : DGL) (BDGM : DGM) (BDGP : DGP) : ExceptT String IO DGQ := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_IMP_SUBSET, retraction, .. } := BDGB
  let { BROUWER, .. } := BDGC
  let { AR_ANR, ENR_ANR, RETRACT_OF_UNIV, .. } := BDGG
  let { ANR_SPHERE, ENR_BOUNDED, .. } := BDGL
  let { BORSUK_HOMOTOPY_EXTENSION, .. } := BDGM
  let { FRONTIER_SUBSET_RETRACTION, .. } := BDGP
  let { CARD_CLAUSES, CARD_SUBSET, CART_EQ, CONJ_ASSOC, DE_MORGAN_THM, DIFF_EMPTY,
        DIMINDEX_1, EQ_IMP, EXISTS_IN_GSPEC, EXISTS_OR_THM, FINITE_EMPTY, FINITE_SING,
        FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, HAS_SIZE, HAS_SIZE_0, IN, IN_DIFF, INTER_COMM, .. } :=
        D.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LAMBDA_BETA, LE_TRANS, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.pt.cvx.core3
  let { REAL_ENTIRE, REAL_LE_INV_EQ, REAL_LE_MUL, REAL_LE_MUL_EQ, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, .. } := D.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_NOT_LT, REAL_SUB_LT, SUBSET, SUBSET_TRANS, .. } :=
        D.pt.cvx.core5
  let { o_DEF, SUM_LMUL, UNIONS_IMAGE, UNIV_NOT_EMPTY, .. } := D.pt.cvx.core6
  let { CARD_LE_RELATIONAL_FULL, .. } := D.pt.cvx.lib
  let { HULL_INC, .. } := D.pt.cvx.misc
  let { FORALL_1, LIFT_DROP, LIFT_SUB, .. } := D.pt.cvx.vec2
  let { NORM_SUB, .. } := D.pt.cvx.vec3
  let { dist, drop, VECTOR_MUL_ASSOC, VSUM_LMUL, .. } := D.pt.cvx.vec4
  let { BOUNDED_SUBSET, BOUNDED_SUBSET_CBALL, CBALL_EQ_EMPTY, CLOSED_CBALL,
        CLOSED_IMP_LOCALLY_COMPACT, CLOSED_SUBSET, CLOSURE_CLOSED, .. } := D.pt.cvx.top1
  let { CLOSURE_MINIMAL, COMPACT_CBALL, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED,
        COMPACT_IMP_CLOSED, COMPACT_SPHERE, COMPONENTS_EQ, CONNECTED_INTER_FRONTIER, .. } :=
        D.pt.cvx.top2
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, FRONTIER_COMPLEMENT, FRONTIER_EQ_EMPTY, .. } := D.pt.cvx.top3
  let { IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        INTERIOR_OPEN, .. } := D.pt.cvx.top4
  let { closed, components, frontier, OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_UNIV, .. } :=
        D.pt.cvx.top5
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, HAS_SIZE_CONV, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { CONVEX_BALL, CONVEX_CBALL, CONVEX_CONVEX_HULL, .. } := D.pt.qcvx2
  let { CONVEX_VSUM, CONVEX_VSUM_STRONG, FRONTIER_OF_COMPONENTS_SUBSET, .. } := D.qconvex
  let { CARD_LE_CARD_IMP, CARD_LE_FINITE, .. } := D.qcard
  let { HOMOTOPIC_WITH_SYM, .. } := D.qmetric
  let { FINITE_COMPONENTS_MEETING_COMPACT_SUBSET, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, .. } := D.qpaths1
  let { NULLHOMOTOPIC_FROM_CONTRACTIBLE, OPEN_IMP_LOCALLY_CONNECTED, .. } := D.qpaths2
  let { SUM_POS_LT, .. } := D.qsession
  let { CLOSURE_UNION_FRONTIER, COMPACT_DIFF, COMPACT_IMP_TOTALLY_BOUNDED,
        COMPONENTS_EQ_SING, CONNECTED_COMPONENT_MONO, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS, CONNECTED_UNIV, CONTINUOUS_ON_LIFT_DIST,
        CONTINUOUS_ON_MAX, CONTINUOUS_ON_VSUM, .. } := D.qtopology1
  let { OPEN_DELETE, SPHERE_EQ_EMPTY, .. } := D.qtopology2
  let { LIFT_SUM, .. } := D.qvec
  -- @@SCOPE END

  let BOUNDED_COMPONENT_RETRACT_COMPLEMENT_MEETS ← prove
   r"!s t c. closed s /\ s retract_of t /\
           c IN components((:real^N) DIFF s) /\ bounded c
           ==> ~(c SUBSET t)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"frontier(c:real^N->bool) SUBSET s") ASSUME_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"frontier((:real^N) DIFF s)") THEN
      ASM_SIMP_TAC [FRONTIER_OF_COMPONENTS_SUBSET] THEN
      REWRITE_TAC [FRONTIER_COMPLEMENT] THEN
      ASM_SIMP_TAC [frontier, CLOSURE_CLOSED] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"closure(c:real^N->bool) SUBSET t") ASSUME_TAC THENL
     [REWRITE_TAC [CLOSURE_UNION_FRONTIER] THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:real^N->bool) SUBSET s") ASSUME_TAC THENL
     [MATCH_MP_TAC FRONTIER_SUBSET_RETRACTION THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
      REWRITE_TAC [retraction] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"r:real^N->real^N") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []],
      FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
      ASM SET_TAC []])

  let COMPONENT_RETRACT_COMPLEMENT_MEETS ← prove
   r"!s t c. closed s /\ s retract_of t /\ bounded t /\
           c IN components((:real^N) DIFF s)
           ==> ~(c SUBSET t)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    ASM_CASES_TAC (← q r"bounded(c:real^N->bool)") THENL
     [ASM_MESON_TAC [BOUNDED_COMPONENT_RETRACT_COMPLEMENT_MEETS],
      ASM_MESON_TAC [BOUNDED_SUBSET]])

  let FINITE_COMPLEMENT_ENR_COMPONENTS ← prove
   r"!s. compact s /\ ENR s ==> FINITE(components((:real^N) DIFF s))"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [DIFF_EMPTY] THEN
      MESON_TAC [COMPONENTS_EQ_SING, CONNECTED_UNIV, UNIV_NOT_EMPTY, FINITE_SING],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [ENR_BOUNDED, COMPACT_IMP_BOUNDED] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!c. c IN components((:real^N) DIFF s) ==> ~(c SUBSET u)")
    ASSUME_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC COMPONENT_RETRACT_COMPLEMENT_MEETS THEN
      ASM_MESON_TAC [COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"vec 0:real^N"]
          BOUNDED_SUBSET_CBALL) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"cball(vec 0:real^N,r) DIFF u", ← q r"(:real^N) DIFF s"]
          FINITE_COMPONENTS_MEETING_COMPACT_SUBSET) THEN
    ASM_SIMP_TAC [COMPACT_DIFF, COMPACT_CBALL, OPEN_IMP_LOCALLY_CONNECTED,
       ← GSYM closed, COMPACT_IMP_CLOSED] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!c. c IN s ==> P c) ==> {c | c IN s /\ P c} = s")) THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(c INTER frontier(u:real^N->bool) = {})") MP_TAC THENL
     [MATCH_MP_TAC CONNECTED_INTER_FRONTIER THEN
      CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"s DIFF t = {} <=> s SUBSET t")] THEN
      ONCE_REWRITE_TAC [INTER_COMM] THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        OPEN_INTER_CLOSURE_EQ_EMPTY o rand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [CLOSURE_UNION_FRONTIER] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"~(t = {}) /\ t SUBSET u
        ==> ~(u INTER (s UNION t) = {})")) THEN
      ASM_REWRITE_TAC [FRONTIER_EQ_EMPTY, DE_MORGAN_THM, ← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY], ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      TRANS_TAC SUBSET_TRANS (← q r"frontier((:real^N) DIFF s)") THEN
      ASM_SIMP_TAC [FRONTIER_OF_COMPONENTS_SUBSET] THEN
      REWRITE_TAC [FRONTIER_COMPLEMENT] THEN
      ASM_SIMP_TAC [frontier, CLOSURE_CLOSED, COMPACT_IMP_CLOSED] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t
        ==> ~(c INTER s = {}) ==> ~(c INTER t = {})")) THEN
      ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s DIFF u SUBSET t DIFF u")) THEN
      MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_REWRITE_TAC [CLOSED_CBALL]])

  let FINITE_COMPLEMENT_ANR_COMPONENTS ← prove
   r"!s. compact s /\ ANR s ==> FINITE(components((:real^N) DIFF s))"
   (MESON_TAC [FINITE_COMPLEMENT_ENR_COMPONENTS, ENR_ANR,
               COMPACT_IMP_CLOSED, CLOSED_IMP_LOCALLY_COMPACT])

  let CARD_LE_RETRACT_COMPLEMENT_COMPONENTS ← prove
   r"!s t. compact s /\ s retract_of t /\ bounded t
         ==> components((:real^N) DIFF s) <=_c components((:real^N) DIFF t)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    MATCH_MP_TAC (← ISPEC (← q r"SUBSET") CARD_LE_RELATIONAL_FULL) THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC
       [← q r"d:real^N->bool", ← q r"c:real^N->bool", ← q r"c':real^N->bool"] THEN
      STRIP_TAC THEN MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") COMPONENTS_EQ) THEN
      ASM_SIMP_TAC [] THEN
      ASM_CASES_TAC (← q r"d:real^N->bool = {}") THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY]] THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~((u:real^N->bool) SUBSET t)") MP_TAC THENL
     [MATCH_MP_TAC COMPONENT_RETRACT_COMPLEMENT_MEETS THEN
      ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED],
      ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"~(s SUBSET t) <=> ?p. p IN s /\ ~(p IN t)")] THEN
    REWRITE_TAC [components, EXISTS_IN_GSPEC, IN_UNIV, IN_DIFF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"u = connected_component ((:real^N) DIFF s) p")
    SUBST_ALL_TAC THENL
     [MP_TAC (← ISPECL [← q r"(:real^N) DIFF s", ← q r"u:real^N->bool"]
        COMPONENTS_EQ) THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [components, FORALL_IN_GSPEC, IN_DIFF, IN_UNIV] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"p:real^N")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"p:real^N") THEN
      ASM_REWRITE_TAC [IN_INTER] THEN REWRITE_TAC [IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN ASM SET_TAC []])

  let CONNECTED_RETRACT_COMPLEMENT ← prove
   r"!s t. compact s /\ s retract_of t /\ bounded t /\
         connected((:real^N) DIFF t)
         ==> connected((:real^N) DIFF s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONNECTED_EQ_COMPONENTS_SUBSET_SING_EXISTS] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"u:real^N->bool")) THEN
    SUBGOAL_THEN (← q r"FINITE(components((:real^N) DIFF t))") ASSUME_TAC THENL
     [ASM_MESON_TAC [FINITE_SUBSET, FINITE_SING], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          CARD_LE_RETRACT_COMPLEMENT_COMPONENTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"FINITE(components((:real^N) DIFF s)) /\
      CARD(components((:real^N) DIFF s)) <= CARD(components((:real^N) DIFF t))")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [CARD_LE_CARD_IMP, CARD_LE_FINITE], ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    REWRITE_TAC [EXISTS_OR_THM] THEN
    REWRITE_TAC [← GSYM HAS_SIZE_0,
                 ← GSYM (← ExceptT.mk (HAS_SIZE_CONV (← q r"s HAS_SIZE 1")))] THEN
    ASM_REWRITE_TAC [HAS_SIZE, ← ARITH_RULE (← q r"n = 0 \/ n = 1 <=> n <= 1")] THEN
    TRANS_TAC LE_TRANS (← q r"CARD{u:real^N->bool}") THEN CONJ_TAC THENL
     [TRANS_TAC LE_TRANS (← q r"CARD(components((:real^N) DIFF t))") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CARD_SUBSET THEN
      ASM_REWRITE_TAC [FINITE_SING],
      SIMP_TAC [CARD_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY] THEN ARITH_TAC])

  let BROUWER_INESSENTIAL_ANR ← prove
   r"!f:real^N->real^N s.
        compact s /\ ~(s = {}) /\ ANR s /\
        f continuous_on s /\ IMAGE f s SUBSET s /\
        (?a. homotopic_with (\x. T)
              (subtopology euclidean s,subtopology euclidean s) f (\x. a))
        ==> ?x. x IN s /\ f x = x"
   (ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (X_CHOOSE_TAC (← q r"r:real") o SPEC (← q r"vec 0:real^N") o
      MATCH_MP BOUNDED_SUBSET_CBALL o MATCH_MP COMPACT_IMP_BOUNDED) THEN
    MP_TAC (← ISPECL
     [← q r"(\x. a):real^N->real^N", ← q r"f:real^N->real^N",
      ← q r"s:real^N->bool", ← q r"cball(vec 0:real^N,r)", ← q r"s:real^N->bool"]
      BORSUK_HOMOTOPY_EXTENSION) THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_SUBSET,
                  CONTINUOUS_ON_CONST, CLOSED_CBALL] THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^N->real^N", ← q r"cball(vec 0:real^N,r)"]
          BROUWER) THEN
    ASM_SIMP_TAC [COMPACT_CBALL, CONVEX_CBALL, CBALL_EQ_EMPTY] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < r ==> ~(r < &0)")] THEN ASM SET_TAC [])

  let BROUWER_CONTRACTIBLE_ANR ← prove
   r"!f:real^N->real^N s.
        compact s /\ contractible s /\ ~(s = {}) /\ ANR s /\
        f continuous_on s /\ IMAGE f s SUBSET s
        ==> ?x. x IN s /\ f x = x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_INESSENTIAL_ANR THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC NULLHOMOTOPIC_FROM_CONTRACTIBLE THEN ASM_REWRITE_TAC [])

  let FIXED_POINT_INESSENTIAL_SPHERE_MAP ← prove
   r"!f a:real^N r c.
     &0 < r /\
     homotopic_with (\x. T)
      (subtopology euclidean (sphere(a,r)),
       subtopology euclidean (sphere(a,r))) f (\x. c)
     ==> ?x. x IN sphere(a,r) /\ f x = x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_INESSENTIAL_ANR THEN
    REWRITE_TAC [ANR_SPHERE] THEN
    ASM_SIMP_TAC [SPHERE_EQ_EMPTY, COMPACT_SPHERE, OPEN_DELETE, OPEN_UNIV] THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    ASM_SIMP_TAC [REAL_NOT_LT, REAL_LT_IMP_LE] THEN ASM_MESON_TAC [])

  let BROUWER_AR ← prove
   r"!f s:real^N->bool.
        compact s /\ AR s /\ f continuous_on s /\ IMAGE f s SUBSET s
         ==> ?x. x IN s /\ f x = x"
   (REWRITE_TAC [AR_ANR] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_CONTRACTIBLE_ANR THEN
    ASM_REWRITE_TAC [])

  let BROUWER_ABSOLUTE_RETRACT ← prove
   r"!f s. compact s /\ s retract_of (:real^N) /\
         f continuous_on s /\ IMAGE f s SUBSET s
         ==> ?x. x IN s /\ f x = x"
   (REWRITE_TAC [RETRACT_OF_UNIV, AR_ANR] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BROUWER_CONTRACTIBLE_ANR THEN
    ASM_REWRITE_TAC [])

  let SCHAUDER_PROJECTION ← prove
   r"!s:real^N->bool e.
        compact s /\ &0 < e
        ==> ?t f. FINITE t /\ t SUBSET s /\
                  f continuous_on s /\ IMAGE f s SUBSET (convex hull t) /\
                  (!x. x IN s ==> norm(f x - x) < e)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o SPEC (← q r"e:real") o MATCH_MP COMPACT_IMP_TOTALLY_BOUNDED) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"g = \p x:real^N. max (&0) (e - norm(x - p))") THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s ==> &0 < sum t (\p. (g:real^N->real^N->real) p x)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_POS_LT THEN
      ASM_REWRITE_TAC [] THEN EXPAND_TAC "g" THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 <= max (&0) b")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 < max (&0) b <=> &0 < b"), REAL_SUB_LT] THEN
      UNDISCH_TAC (← q r"s SUBSET UNIONS (IMAGE (\x:real^N. ball(x,e)) t)") THEN
      REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_BALL, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [dist, NORM_SUB],
      ALL_TAC] THEN
    EXISTS_TAC
     (← q r"(\x. inv(sum t (\p. g p x)) % vsum t (\p. g p x % p)):real^N->real^N") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_NZ, LIFT_SUM, o_DEF],
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_VSUM THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THENL
       [ALL_TAC, MATCH_MP_TAC CONTINUOUS_ON_MUL] THEN
      REWRITE_TAC [o_DEF, CONTINUOUS_ON_CONST] THEN
      EXPAND_TAC "g" THEN
      (SUBGOAL_THEN
        (← q r"(\x. lift (max (&0) (e - norm (x - y:real^N)))) =
         (\x. (lambda i. max (lift(&0)$i) (lift(e - norm (x - y))$i)))")
       SUBST1_TAC THENL
        [SIMP_TAC [CART_EQ, LAMBDA_BETA, FUN_EQ_THM] THEN
         REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, LIFT_DROP],
         MATCH_MP_TAC CONTINUOUS_ON_MAX] THEN
       REWRITE_TAC [CONTINUOUS_ON_CONST, LIFT_SUB] THEN
       MATCH_MP_TAC CONTINUOUS_ON_SUB THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
       REWRITE_TAC [← ONCE_REWRITE_RULE [NORM_SUB] (← GSYM dist)] THEN
       REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_DIST]),
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← GSYM VSUM_LMUL, VECTOR_MUL_ASSOC] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN MATCH_MP_TAC CONVEX_VSUM THEN
      ASM_SIMP_TAC [HULL_INC, CONVEX_CONVEX_HULL, SUM_LMUL] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_NZ, REAL_MUL_LINV] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_SIMP_TAC [REAL_LE_INV_EQ, REAL_LT_IMP_LE] THEN
      EXPAND_TAC "g" THEN REAL_ARITH_TAC,
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
      REWRITE_TAC [← REWRITE_RULE [dist] (← GSYM IN_BALL)] THEN
      REWRITE_TAC [← GSYM VSUM_LMUL, VECTOR_MUL_ASSOC] THEN
      MATCH_MP_TAC CONVEX_VSUM_STRONG THEN
      ASM_REWRITE_TAC [CONVEX_BALL, SUM_LMUL, REAL_ENTIRE] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_NZ, REAL_MUL_LINV, REAL_LT_INV_EQ,
                    REAL_LE_MUL_EQ] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      EXPAND_TAC "g" THEN REWRITE_TAC [IN_BALL, dist, NORM_SUB] THEN
      REAL_ARITH_TAC])

  pure { BOUNDED_COMPONENT_RETRACT_COMPLEMENT_MEETS, COMPONENT_RETRACT_COMPLEMENT_MEETS,
         FINITE_COMPLEMENT_ENR_COMPONENTS, FINITE_COMPLEMENT_ANR_COMPONENTS,
         CARD_LE_RETRACT_COMPLEMENT_COMPONENTS, CONNECTED_RETRACT_COMPLEMENT,
         BROUWER_INESSENTIAL_ANR, BROUWER_CONTRACTIBLE_ANR,
         FIXED_POINT_INESSENTIAL_SPHERE_MAP, BROUWER_AR, BROUWER_ABSOLUTE_RETRACT,
         SCHAUDER_PROJECTION }

/- ------------------------------------------------------------------------- -/
/- Other fixed-point theorems, Perron-Frobenius, bijections between          -/
/- intervals.  (degree.ml 7706-7961)                                         -/
/- ------------------------------------------------------------------------- -/

structure DGR where
  BROUWER_FACTOR_THROUGH_AR : thm
  BROUWER_ABSOLUTE_RETRACT_GEN : thm
  SCHAUDER_GEN : thm
  SCHAUDER : thm
  SCHAUDER_UNIV : thm
  ROTHE : thm
  PERRON_FROBENIUS : thm
  interval_bij : thm
  INTERVAL_BIJ_AFFINE : thm
  CONTINUOUS_INTERVAL_BIJ : thm
  CONTINUOUS_ON_INTERVAL_BIJ : thm
  IN_INTERVAL_INTERVAL_BIJ : thm
  INTERVAL_BIJ_BIJ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGR [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGC : DGC) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGL : DGL) : ExceptT String IO DGR := do
  -- @@SCOPE BEGIN
  let { RETRACT_OF_CLOSED, retraction, .. } := BDGB
  let { BROUWER, BROUWER_BALL, .. } := BDGC
  let { AR_IMP_ABSOLUTE_EXTENSOR, .. } := BDGF
  let { RETRACT_OF_UNIV, .. } := BDGG
  let { CONVEX_IMP_AR, .. } := BDGH
  let { ABSOLUTE_RETRACTION_CONVEX_CLOSED, .. } := BDGL
  let { AND_FORALL_THM, CART_EQ, DIMINDEX_GE_1, FINITE_NUMSEG, FINITE_SING, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMAGE_SUBSET, IMP_CONJ_ALT, IN_DIFF,
        .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        NOT_EXISTS_THM, REAL_ABS_INV, .. } := D.pt.cvx.core3
  let { REAL_INV_0, REAL_LE_DIV, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_MUL,
        REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_IMP_NZ,
        REAL_LT_REFL, .. } := D.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_SYM, REAL_POS, REAL_SUB_0,
        REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL, SING_SUBSET, SUBSET, .. } := D.pt.cvx.core5
  let { o_DEF, o_THM, real_div, SUBSET_UNIV, SUM_SING, SUM_SUBSET_SIMPLE, UNIV_NOT_EMPTY, ..
        } := D.pt.cvx.core6
  let { BASIS_COMPONENT, DOT_BASIS, DOT_RMUL, DOT_RZERO, .. } := D.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, MATRIX_VECTOR_MUL_LINEAR, NORM_EQ_0, .. } :=
        D.pt.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.pt.cvx.vec3
  let { dot, linear, matrix_vector_mul, VEC_COMPONENT, VECTOR_ADD_COMPONENT,
        VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, .. } := D.pt.cvx.vec4
  let { SUBTOPOLOGY_UNIV, .. } := D.pt.cvx.met
  let { BOUNDED_SUBSET, BOUNDED_SUBSET_CBALL, CLOSED_HYPERPLANE, CLOSED_IN, CLOSED_INTER,
        CLOSED_UNIV, .. } := D.pt.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_CONTINUOUS_IMAGE,
        COMPACT_EQ_BOUNDED_CLOSED, CONTINUOUS_ADD, CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } :=
        D.pt.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUBSET, .. } := D.pt.cvx.top3
  let { LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, new_definition, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, SET_TAC, VECTOR_ARITH, .. } := D.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.pt.qtop
  let { CONVEX_HYPERPLANE, CONVEX_INTER, .. } := D.pt.qcvx2
  let { CONVEX_POSITIVE_ORTHANT, CONVEX_UNIV, .. } := D.pt.qcvx3
  let { REAL_ADD_SUB, SUM_POS_EQ_0_NUMSEG, SUM_POS_LE_NUMSEG, .. } := D.qsession
  let { CLOSED_POSITIVE_ORTHANT, CONTINUOUS_ON_LIFT_DOT2, .. } := D.qtopology1
  let { MATRIX_VECTOR_MUL_RMUL, .. } := D.qvec
  -- @@SCOPE END

  let BROUWER_FACTOR_THROUGH_AR ← prove
   r"!f:real^M->real^N g:real^N->real^M s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        compact s /\ AR t
        ==> ?x. x IN s /\ g(f x) = x"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE I [COMPACT_EQ_BOUNDED_CLOSED]) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:real^M") o MATCH_MP BOUNDED_SUBSET_CBALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)",
                      ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          AR_IMP_ABSOLUTE_EXTENSOR) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"(g:real^N->real^M) o (h:real^M->real^N)",
                      ← q r"a:real^M", ← q r"r:real"] BROUWER_BALL) THEN
    ASM_REWRITE_TAC [o_THM, IMAGE_o] THEN
    ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV, IMAGE_SUBSET])

  let BROUWER_ABSOLUTE_RETRACT_GEN ← prove
   r"!f s:real^N->bool.
           s retract_of (:real^N) /\
           f continuous_on s /\ IMAGE f s SUBSET s /\ bounded(IMAGE f s)
           ==> ?x. x IN s /\ f x = x"
   (REWRITE_TAC [RETRACT_OF_UNIV] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. x", ← q r"f:real^N->real^N",
                      ← q r"closure(IMAGE (f:real^N->real^N) s)", ← q r"s:real^N->bool"]
          BROUWER_FACTOR_THROUGH_AR) THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, COMPACT_CLOSURE, IMAGE_ID] THEN
    REWRITE_TAC [CLOSURE_SUBSET] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q ==> r) /\ p ==> (p ==> q) ==> r")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC CLOSURE_MINIMAL] THEN
    ASM_MESON_TAC [RETRACT_OF_CLOSED, CLOSED_UNIV])

  let SCHAUDER_GEN ← prove
   r"!f s t:real^N->bool.
     AR s /\ f continuous_on s /\ IMAGE f s SUBSET t /\ t SUBSET s /\ compact t
     ==> ?x. x IN t /\ f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. x", ← q r"f:real^N->real^N",
                      ← q r"t:real^N->bool", ← q r"s:real^N->bool"]
          BROUWER_FACTOR_THROUGH_AR) THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID])

  let SCHAUDER ← prove
   r"!f s t:real^N->bool.
        convex s /\ ~(s = {}) /\ t SUBSET s /\ compact t /\
        f continuous_on s /\ IMAGE f s SUBSET t
        ==> ?x. x IN s /\ f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          SCHAUDER_GEN) THEN
    ASM_SIMP_TAC [CONVEX_IMP_AR] THEN ASM SET_TAC [])

  let SCHAUDER_UNIV ← prove
   r"!f:real^N->real^N.
        f continuous_on (:real^N) /\ bounded (IMAGE f (:real^N))
        ==> ?x. f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"(:real^N)",
                      ← q r"closure(IMAGE (f:real^N->real^N) (:real^N))"] SCHAUDER) THEN
    ASM_REWRITE_TAC [UNIV_NOT_EMPTY, CONVEX_UNIV, COMPACT_CLOSURE, IN_UNIV] THEN
    REWRITE_TAC [SUBSET_UNIV, CLOSURE_SUBSET])

  let ROTHE ← prove
   r"!f s:real^N->bool.
        closed s /\ convex s /\ ~(s = {}) /\
        f continuous_on s /\ bounded(IMAGE f s) /\
        IMAGE f (frontier s) SUBSET s
        ==> ?x. x IN s /\ f x = x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"(:real^N)"]
      ABSOLUTE_RETRACTION_CONVEX_CLOSED) THEN
    ASM_REWRITE_TAC [retraction, SUBSET_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"(r:real^N->real^N) o (f:real^N->real^N)", ← q r"s:real^N->bool",
      ← q r"IMAGE (r:real^N->real^N) (closure(IMAGE (f:real^N->real^N) s))"]
     SCHAUDER) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [CLOSURE_SUBSET, IMAGE_SUBSET, IMAGE_o] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_REWRITE_TAC [COMPACT_CLOSURE],
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
      REWRITE_TAC [o_THM] THEN STRIP_TAC THEN ASM SET_TAC []])

  let PERRON_FROBENIUS ← prove
   r"!A:real^N^N.
        (!i j. 1 <= i /\ i <= dimindex(:N) /\ 1 <= j /\ j <= dimindex(:N)
               ==> &0 <= A$i$j)
        ==> ?v c. norm v = &1 /\ &0 <= c /\ A ** v = c % v"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"?v. ~(v = vec 0) /\ (A:real^N^N) ** v = vec 0") THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"v:real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"inv(norm v) % v:real^N") THEN EXISTS_TAC (← q r"&0") THEN
      ASM_SIMP_TAC [REAL_LE_REFL, NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM,
                    REAL_MUL_LINV, NORM_EQ_0, MATRIX_VECTOR_MUL_RMUL] THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_RZERO],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_EXISTS_THM]) THEN
      REWRITE_TAC [← TAUT (← q r"~(~p /\ q) <=> q ==> p")] THEN DISCH_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\x:real^N. inv(vec 1 dot (A ** x)) % ((A:real^N^N) ** x)",
      ← q r"{x:real^N | vec 1 dot x = &1} INTER
       {x:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= x$i}"]
     BROUWER) THEN
    SIMP_TAC [CONVEX_INTER, CONVEX_POSITIVE_ORTHANT, CONVEX_HYPERPLANE] THEN
    SUBGOAL_THEN
     (← q r"!x. (!i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= x$i)
          ==> !i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= ((A:real^N^N) ** x)$i")
    ASSUME_TAC THENL
     [GEN_TAC THEN STRIP_TAC THEN SIMP_TAC [matrix_vector_mul, LAMBDA_BETA] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN
      ASM_MESON_TAC [REAL_LE_MUL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. (!i. 1 <= i /\ i <= dimindex(:N) ==> &0 <= x$i) /\ vec 1 dot x = &1
          ==> &0 < vec 1 dot ((A:real^N^N) ** x)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [DOT_RZERO] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
      DISCH_TAC THEN REWRITE_TAC [dot, VEC_COMPONENT, REAL_MUL_LID] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN ASM_MESON_TAC [],
        DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          SUM_POS_EQ_0_NUMSEG)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [CART_EQ, VEC_COMPONENT]) THEN
        ASM_MESON_TAC []],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, CLOSED_INTER, CLOSED_HYPERPLANE,
                  CLOSED_POSITIVE_ORTHANT] THEN
        MATCH_MP_TAC BOUNDED_SUBSET THEN
        EXISTS_TAC (← q r"interval[vec 0:real^N,vec 1]") THEN
        SIMP_TAC [BOUNDED_INTERVAL, SUBSET, IN_INTER, IN_ELIM_THM, IN_INTERVAL,
                  dot, VEC_COMPONENT, REAL_MUL_LID] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        TRANS_TAC REAL_LE_TRANS (← q r"sum {i} (\i. (x:real^N)$i)") THEN
        CONJ_TAC THENL [REWRITE_TAC [SUM_SING, REAL_LE_REFL], ALL_TAC] THEN
        MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
        REWRITE_TAC [FINITE_SING, FINITE_NUMSEG] THEN
        ASM_SIMP_TAC [SING_SUBSET, IN_SING, IN_DIFF, IN_NUMSEG],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"basis 1:real^N") THEN
        SIMP_TAC [IN_INTER, IN_ELIM_THM, BASIS_COMPONENT] THEN
        CONJ_TAC THENL [ALL_TAC, MESON_TAC [REAL_POS]] THEN
        SIMP_TAC [DOT_BASIS, DIMINDEX_GE_1, LE_REFL, VEC_COMPONENT],
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, MATRIX_VECTOR_MUL_LINEAR, o_DEF] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [CONTINUOUS_ON_LIFT_DOT2, MATRIX_VECTOR_MUL_LINEAR,
                  CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON] THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
        ASM_MESON_TAC [REAL_LT_REFL],
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER, IN_ELIM_THM] THEN
        REWRITE_TAC [DOT_RMUL] THEN REPEAT STRIP_TAC THENL
         [MATCH_MP_TAC REAL_MUL_LINV THEN MATCH_MP_TAC REAL_LT_IMP_NZ THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [],
          REWRITE_TAC [VECTOR_MUL_COMPONENT] THEN MATCH_MP_TAC REAL_LE_MUL THEN
          REWRITE_TAC [REAL_LE_INV_EQ] THEN ASM_MESON_TAC [REAL_LT_IMP_LE]]],
      REWRITE_TAC [IN_INTER, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [DOT_RZERO] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"inv(norm x) % x:real^N") THEN
      EXISTS_TAC (← q r"vec 1 dot ((A:real^N^N) ** x)") THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        MATCH_MP_TAC REAL_MUL_LINV THEN ASM_REWRITE_TAC [NORM_EQ_0],
        ASM_MESON_TAC [REAL_LT_IMP_LE],
        REWRITE_TAC [MATRIX_VECTOR_MUL_RMUL, VECTOR_MUL_ASSOC] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        REWRITE_TAC [← GSYM VECTOR_MUL_ASSOC] THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o SYM o AP_TERM
          (← q r"(%) (vec 1 dot ((A:real^N^N) ** x)):real^N->real^N")) THEN
        REWRITE_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, ← VECTOR_ARITH
         (← q r"v:real^N = c % v <=> (c - &1) % v = vec 0")] THEN
        DISJ1_TAC THEN REWRITE_TAC [REAL_SUB_0] THEN
        MATCH_MP_TAC REAL_MUL_RINV THEN MATCH_MP_TAC REAL_LT_IMP_NZ THEN
        ASM_MESON_TAC []]])

  let interval_bij ← new_definition
   r"interval_bij (a:real^N,b:real^N) (u:real^N,v:real^N) (x:real^N) =
    (lambda i. u$i + (x$i - a$i) / (b$i - a$i) * (v$i - u$i)):real^N"

  let INTERVAL_BIJ_AFFINE ← prove
   r"interval_bij (a,b) (u,v) =
        \x. (lambda i. (v$i - u$i) / (b$i - a$i) * x$i) +
            (lambda i. u$i - (v$i - u$i) / (b$i - a$i) * a$i)"
   (SIMP_TAC [FUN_EQ_THM, CART_EQ, VECTOR_ADD_COMPONENT, LAMBDA_BETA,
              interval_bij] THEN
    REAL_ARITH_TAC)

  let CONTINUOUS_INTERVAL_BIJ ← prove
   r"!a b u v x. (interval_bij (a:real^N,b:real^N) (u:real^N,v:real^N))
                  continuous at x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [INTERVAL_BIJ_AFFINE] THEN
    MATCH_MP_TAC CONTINUOUS_ADD THEN REWRITE_TAC [CONTINUOUS_CONST] THEN
    MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    SIMP_TAC [linear, CART_EQ, LAMBDA_BETA,
              VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    REAL_ARITH_TAC)

  let CONTINUOUS_ON_INTERVAL_BIJ ← prove
   r"!a b u v s. interval_bij (a,b) (u,v) continuous_on s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REWRITE_TAC [CONTINUOUS_INTERVAL_BIJ])

  let IN_INTERVAL_INTERVAL_BIJ ← prove
   r"!a b u v x:real^N.
        x IN interval[a,b] /\ ~(interval[u,v] = {})
        ==> (interval_bij (a,b) (u,v) x) IN interval[u,v]"
   (SIMP_TAC [IN_INTERVAL, interval_bij, LAMBDA_BETA, INTERVAL_NE_EMPTY] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u <= u + x <=> &0 <= x"),
                 ← REAL_ARITH (← q r"u + x <= v <=> x <= &1 * (v - u)")] THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC THEN
      TRY (MATCH_MP_TAC REAL_LE_DIV) THEN
      ASM_SIMP_TAC [REAL_SUB_LE] THEN ASM_MESON_TAC [REAL_LE_TRANS],
      MATCH_MP_TAC REAL_LE_RMUL THEN ASM_SIMP_TAC [REAL_SUB_LE] THEN
      SUBGOAL_THEN (← q r"(a:real^N)$i <= (b:real^N)$i") MP_TAC THENL
       [ASM_MESON_TAC [REAL_LE_TRANS], ALL_TAC] THEN
      GEN_REWRITE_TAC LAND_CONV [REAL_LE_LT] THEN STRIP_TAC THENL
       [ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_SUB_LT] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"a <= x /\ x <= b ==> x - a <= &1 * (b - a)")],
        ASM_REWRITE_TAC [real_div, REAL_SUB_REFL, REAL_INV_0] THEN
        REAL_ARITH_TAC]])

  let INTERVAL_BIJ_BIJ ← prove
   r"!a b u v x:real^N.
        (!i. 1 <= i /\ i <= dimindex(:N) ==> a$i < b$i /\ u$i < v$i)
        ==> interval_bij (a,b) (u,v) (interval_bij (u,v) (a,b) x) = x"
   (SIMP_TAC [interval_bij, CART_EQ, LAMBDA_BETA, REAL_ADD_SUB] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN CONV_TAC (fun t => REAL_FIELD t))

  pure { BROUWER_FACTOR_THROUGH_AR, BROUWER_ABSOLUTE_RETRACT_GEN, SCHAUDER_GEN,
         SCHAUDER, SCHAUDER_UNIV, ROTHE, PERRON_FROBENIUS, interval_bij,
         INTERVAL_BIJ_AFFINE, CONTINUOUS_INTERVAL_BIJ, CONTINUOUS_ON_INTERVAL_BIJ,
         IN_INTERVAL_INTERVAL_BIJ, INTERVAL_BIJ_BIJ }

/- ------------------------------------------------------------------------- -/
/- Fashoda meet theorem, some ad hoc segment lemmas and the Fashoda           -/
/- corollary pointed out by Tom Hales.  (degree.ml 7962-8392)                -/
/- ------------------------------------------------------------------------- -/

structure DGS where
  INFNORM_2 : thm
  INFNORM_EQ_1_2 : thm
  INFNORM_EQ_1_IMP : thm
  FASHODA_UNIT : thm
  FASHODA_UNIT_PATH : thm
  FASHODA : thm
  SEGMENT_VERTICAL : thm
  SEGMENT_HORIZONTAL : thm
  FASHODA_INTERLACE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGS [HolBase] (D : DegreeDeps) (BDGC : DGC) (BDGR : DGR) : ExceptT String IO DGS := do
  -- @@SCOPE BEGIN
  let { BROUWER_WEAK, .. } := BDGC
  let { CONTINUOUS_ON_INTERVAL_BIJ, IN_INTERVAL_INTERVAL_BIJ, interval_bij,
        INTERVAL_BIJ_BIJ, .. } := BDGR
  let { ARITH, CART_EQ, CONJ_ASSOC, DIMINDEX_2, DISJ_ASSOC, EXTENSION, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_o, IN_DIFF, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNION, LAMBDA_BETA, LEFT_IMP_EXISTS_THM,
        LEFT_OR_DISTRIB, MONO_AND, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY,
        REAL_ABS_INV, REAL_DIV_REFL, .. } := D.pt.cvx.core3
  let { REAL_LE_LADD, REAL_LE_REFL, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, .. }
        := D.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_POS,
        REAL_SUB_LT, REAL_SUB_REFL, RIGHT_OR_DISTRIB, SUBSET, SUBSET_REFL, SUBSET_TRANS, ..
        } := D.pt.cvx.core5
  let { o_DEF, o_THM, real_div, UNION_ASSOC, .. } := D.pt.cvx.core6
  let { BASIS_COMPONENT, BASIS_EXPANSION, .. } := D.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_VEC, IN_INTERVAL, INTERVAL_NE_EMPTY, LIFT_DROP, LIFT_NUM,
        .. } := D.pt.cvx.vec2
  let { linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_ADD_LID, VECTOR_ADD_RID,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LZERO, VECTOR_NEG_COMPONENT, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_EQ, .. } := D.pt.cvx.vec4
  let { COMPACT_INTERVAL, CONNECTED_IVT_COMPONENT, CONTINUOUS_AT_ID,
        CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_AT_INV, .. } := D.pt.cvx.top2
  let { CONTINUOUS_MUL, CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_CLOSED_INTERVAL, LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { SEGMENT_SCALAR_MULTIPLE, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEOM_ORIGIN_TAC, MESON_TAC, NUMSEG_CONV,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.pt.qses
  let { DROP_NEG, .. } := D.pt.qvec
  let { CONVEX_CONTAINS_SEGMENT, .. } := D.pt.qcvx2
  let { CONVEX_INTERVAL, .. } := D.qconvex
  let { CONNECTED_PATH_IMAGE, .. } := D.qpaths1
  let { path, path_image, PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH, PATH_IMAGE_NONEMPTY,
        PATH_JOIN, PATH_LINEPATH, pathfinish, PATHFINISH_IN_PATH_IMAGE, PATHFINISH_JOIN,
        PATHFINISH_LINEPATH, pathstart, PATHSTART_IN_PATH_IMAGE, PATHSTART_JOIN,
        PATHSTART_LINEPATH, .. } := D.qpaths2
  let { REAL_EQ_ADD_LCANCEL, REAL_MAX_SUP, .. } := D.qsession
  let { CONTINUOUS_AT_LIFT_INFNORM, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_LIFT_COMPONENT, .. }
        := D.qtopology1
  let { FORALL_2, infnorm, INFNORM_EQ_0, INFNORM_MUL, INFNORM_POS_LT, INFNORM_SET_IMAGE,
        LIFT_NEG, REAL_ABS_INFNORM, SUBSET_INTERVAL, VECTOR_2, VSUM_2, .. } := D.qvec
  -- @@SCOPE END

  let INFNORM_2 ← prove
   r"infnorm (x:real^2) = max (abs(x$1)) (abs(x$2))"
   (REWRITE_TAC [infnorm, INFNORM_SET_IMAGE,
                 ← ExceptT.mk (NUMSEG_CONV (← q r"1..2")), DIMINDEX_2] THEN
    REWRITE_TAC [IMAGE_CLAUSES, ← GSYM REAL_MAX_SUP])

  let INFNORM_EQ_1_2 ← prove
   r"infnorm (x:real^2) = &1 <=>
        abs(x$1) <= &1 /\ abs(x$2) <= &1 /\
        (x$1 = -- &1 \/ x$1 = &1 \/ x$2 = -- &1 \/ x$2 = &1)"
   (REWRITE_TAC [INFNORM_2] THEN REAL_ARITH_TAC)

  let INFNORM_EQ_1_IMP ← prove
   r"infnorm (x:real^2) = &1 ==> abs(x$1) <= &1 /\ abs(x$2) <= &1"
   (SIMP_TAC [INFNORM_EQ_1_2])

  let FASHODA_UNIT ← prove
   r"!f:real^1->real^2 g:real^1->real^2.
        IMAGE f (interval[--vec 1,vec 1]) SUBSET interval[--vec 1,vec 1] /\
        IMAGE g (interval[--vec 1,vec 1]) SUBSET interval[--vec 1,vec 1] /\
        f continuous_on interval[--vec 1,vec 1] /\
        g continuous_on interval[--vec 1,vec 1] /\
        f(--vec 1)$1 = -- &1 /\ f(vec 1)$1 = &1 /\
        g(--vec 1)$2 = -- &1 /\ g(vec 1)$2 = &1
        ==> ?s t. s IN interval[--vec 1,vec 1] /\
                  t IN interval[--vec 1,vec 1] /\
                  f(s) = g(t)"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC I [← TAUT (← q r"p <=> ~ ~p")] THEN
    DISCH_THEN (MP_TAC o REWRITE_RULE [NOT_EXISTS_THM]) THEN
    REWRITE_TAC [← TAUT (← q r"~(a /\ b /\ c) <=> a /\ b ==> ~c")] THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"sqprojection = \z:real^2. inv(infnorm z) % z") THEN
    ABBREV_TAC (← q r"(negatex:real^2->real^2) = \x. vector[--(x$1); x$2]") THEN
    SUBGOAL_THEN (← q r"!z:real^2. infnorm(negatex z:real^2) = infnorm z") ASSUME_TAC
    THENL
     [EXPAND_TAC "negatex" THEN SIMP_TAC [VECTOR_2, INFNORM_2] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z. ~(z = vec 0) ==> infnorm((sqprojection:real^2->real^2) z) = &1")
    ASSUME_TAC THENL
     [EXPAND_TAC "sqprojection" THEN
      REWRITE_TAC [INFNORM_MUL, REAL_ABS_INFNORM, REAL_ABS_INV] THEN
      SIMP_TAC [REAL_MUL_LINV, INFNORM_EQ_0],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(\w. (negatex:real^2->real^2)
                         (sqprojection(f(lift(w$1)) - g(lift(w$2)):real^2)))
                    :real^2->real^2",
                      ← q r"interval[--vec 1,vec 1]:real^2->bool"]
           BROUWER_WEAK) THEN
    REWRITE_TAC [NOT_IMP, COMPACT_INTERVAL, CONVEX_INTERVAL] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [INTERIOR_CLOSED_INTERVAL, INTERVAL_NE_EMPTY] THEN
      SIMP_TAC [VEC_COMPONENT, VECTOR_NEG_COMPONENT] THEN REAL_ARITH_TAC,
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN EXPAND_TAC "negatex" THEN
        SIMP_TAC [linear, VECTOR_2, CART_EQ, FORALL_2, DIMINDEX_2,
                  VECTOR_MUL_COMPONENT, VECTOR_NEG_COMPONENT,
                  VECTOR_ADD_COMPONENT, ARITH] THEN
        REAL_ARITH_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_SUB THEN CONJ_TAC THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
        SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT, DIMINDEX_2, ARITH] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[--vec 1:real^1,vec 1]"),
        MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
        EXPAND_TAC "sqprojection" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"x:real^2") THEN STRIP_TAC THEN
        MATCH_MP_TAC CONTINUOUS_MUL THEN REWRITE_TAC [CONTINUOUS_AT_ID] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_AT_INV THEN
        REWRITE_TAC [CONTINUOUS_AT_LIFT_INFNORM, INFNORM_EQ_0, VECTOR_SUB_EQ] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL])] THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
      SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, VEC_COMPONENT, ARITH,
                VECTOR_NEG_COMPONENT, DROP_NEG, DROP_VEC, LIFT_DROP],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^2") THEN STRIP_TAC THEN
      SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, REAL_BOUNDS_LE,
                VECTOR_NEG_COMPONENT, VEC_COMPONENT, ARITH] THEN
      MATCH_MP_TAC INFNORM_EQ_1_IMP THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL]) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
      SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, VEC_COMPONENT, ARITH,
                VECTOR_NEG_COMPONENT, DROP_NEG, DROP_VEC, LIFT_DROP],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^2") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"infnorm(x:real^2) = &1") MP_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV)
       [← SYM th])) THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL]) THEN
      SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, VEC_COMPONENT, ARITH,
                VECTOR_NEG_COMPONENT, DROP_NEG, DROP_VEC, LIFT_DROP],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(!x i. 1 <= i /\ i <= 2 /\ ~(x = vec 0)
             ==> (&0 < ((sqprojection:real^2->real^2) x)$i <=> &0 < x$i)) /\
      (!x i. 1 <= i /\ i <= 2 /\ ~(x = vec 0)
             ==> ((sqprojection x)$i < &0 <=> x$i < &0))")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "sqprojection" THEN
      SIMP_TAC [VECTOR_MUL_COMPONENT, DIMINDEX_2, ARITH] THEN
      REWRITE_TAC [← GSYM (← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div)] THEN
      SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_RDIV_EQ, INFNORM_POS_LT] THEN
      REWRITE_TAC [REAL_MUL_LZERO],
      ALL_TAC] THEN
    REWRITE_TAC [INFNORM_EQ_1_2, CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC
     (REPEAT_TCL DISJ_CASES_THEN (fun th => ASSUME_TAC th THEN MP_TAC th))) THEN
    MAP_EVERY EXPAND_TAC ["x", "negatex"] THEN REWRITE_TAC [VECTOR_2] THENL
     [DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH (← q r"--x = -- &1 ==> &0 < x"))),
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH (← q r"--x = &1 ==> x < &0"))),
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH (← q r"x = -- &1 ==> x < &0"))),
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH (← q r"x = &1 ==> &0 < x")))] THEN
    W (fun (_, w) => FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC (← PART_MATCH (lhs o rand) th (← liftExcept (lhand w)))))) THEN
    (ANTS_TAC THENL
      [REWRITE_TAC [VECTOR_SUB_EQ, ARITH] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL]) THEN
       ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
       SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, VEC_COMPONENT, ARITH,
                 VECTOR_NEG_COMPONENT, DROP_NEG, DROP_VEC, LIFT_DROP] THEN
       REAL_ARITH_TAC,
       DISCH_THEN SUBST1_TAC]) THEN
    ASM_SIMP_TAC [VECTOR_SUB_COMPONENT, DIMINDEX_2, ARITH,
                  LIFT_NEG, LIFT_NUM]
    THENL
     [MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x$1) <= &1 /\ abs(x$2) <= &1 ==> ~(&0 < -- &1 - x$1)")),
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x$1) <= &1 /\ abs(x$2) <= &1 ==> ~(&1 - x$1 < &0)")),
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x$1) <= &1 /\ abs(x$2) <= &1 ==> ~(x$2 - -- &1 < &0)")),
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs(x$1) <= &1 /\ abs(x$2) <= &1 ==> ~(&0 < x$2 - &1)"))] THEN
    (SUBGOAL_THEN (← q r"!z:real^2. abs(z$1) <= &1 /\ abs(z$2) <= &1 <=>
                             z IN interval[--vec 1,vec 1]")
      (fun th => REWRITE_TAC [th]) THENL
      [SIMP_TAC [IN_INTERVAL, DIMINDEX_2, FORALL_2, VEC_COMPONENT, ARITH,
                 VECTOR_NEG_COMPONENT, DROP_NEG, DROP_VEC, LIFT_DROP] THEN
       REAL_ARITH_TAC,
       ALL_TAC]) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE f s SUBSET t ==> x IN s ==> f x IN t"))) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, DROP_VEC, LIFT_DROP] THEN
    ASM_REWRITE_TAC [REAL_BOUNDS_LE])

  let FASHODA_UNIT_PATH ← prove
   r"!f:real^1->real^2 g:real^1->real^2.
        path f /\ path g /\
        path_image f SUBSET interval[--vec 1,vec 1] /\
        path_image g SUBSET interval[--vec 1,vec 1] /\
        (pathstart f)$1 = -- &1 /\ (pathfinish f)$1 = &1 /\
        (pathstart g)$2 = -- &1 /\ (pathfinish g)$2 = &1
        ==> ?z. z IN path_image f /\ z IN path_image g"
   (SIMP_TAC [path, path_image, pathstart, pathfinish] THEN REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"iscale = \z:real^1. inv(&2) % (z + vec 1)") THEN
    MP_TAC (← ISPECL
     [← q r"(f:real^1->real^2) o (iscale:real^1->real^1)",
      ← q r"(g:real^1->real^2) o (iscale:real^1->real^1)"]
     FASHODA_UNIT) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (iscale:real^1->real^1) (interval[--vec 1,vec 1])
      SUBSET interval[vec 0,vec 1]")
    ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN EXPAND_TAC "iscale" THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, DROP_VEC, DROP_CMUL, DROP_ADD] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(iscale:real^1->real^1) continuous_on interval [--vec 1,vec 1]")
    ASSUME_TAC THENL
     [EXPAND_TAC "iscale" THEN
      SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID, CONTINUOUS_ON_ADD,
                CONTINUOUS_ON_CONST],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IMAGE_o] THEN ANTS_TAC THENL
     [REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      REPLICATE_TAC 2 (CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        ALL_TAC]) THEN
      EXPAND_TAC "iscale" THEN REWRITE_TAC [o_THM] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"inv(&2) % (--x + x) = vec 0"),
                       ← VECTOR_ARITH (← q r"inv(&2) % (x + x) = x")],
      REWRITE_TAC [o_THM, LEFT_IMP_EXISTS_THM, IN_IMAGE] THEN ASM SET_TAC []])

  let FASHODA ← prove
   r"!f g a b:real^2.
        path f /\ path g /\
        path_image f SUBSET interval[a,b] /\
        path_image g SUBSET interval[a,b] /\
        (pathstart f)$1 = a$1 /\ (pathfinish f)$1 = b$1 /\
        (pathstart g)$2 = a$2 /\ (pathfinish g)$2 = b$2
        ==> ?z. z IN path_image f /\ z IN path_image g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(interval[a:real^2,b] = {})") MP_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> ~(s = {}) ==> ~(t = {})"))) THEN
      REWRITE_TAC [PATH_IMAGE_NONEMPTY],
      ALL_TAC] THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY, DIMINDEX_2, FORALL_2] THEN STRIP_TAC THEN
    MP_TAC (← ASSUME (← q r"(a:real^2)$1 <= (b:real^2)$1")) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a <= b <=> b = a \/ a < b")] THEN STRIP_TAC THENL
     [SUBGOAL_THEN
        (← q r"?z:real^2. z IN path_image g /\ z$2 = (pathstart f:real^2)$2")
      MP_TAC THENL
       [MATCH_MP_TAC CONNECTED_IVT_COMPONENT THEN
        MAP_EVERY EXISTS_TAC [← q r"pathstart(g:real^1->real^2)",
                              ← q r"pathfinish(g:real^1->real^2)"] THEN
        ASM_SIMP_TAC [CONNECTED_PATH_IMAGE, PATHSTART_IN_PATH_IMAGE, REAL_LE_REFL,
                      PATHFINISH_IN_PATH_IMAGE, DIMINDEX_2, ARITH] THEN
        UNDISCH_TAC (← q r"path_image f SUBSET interval[a:real^2,b]") THEN
        REWRITE_TAC [SUBSET, path_image, IN_INTERVAL_1, FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN SIMP_TAC [pathstart] THEN
        SIMP_TAC [DROP_VEC, REAL_POS, IN_INTERVAL, FORALL_2, DIMINDEX_2],
        ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^2") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN SIMP_TAC [path_image, IN_IMAGE] THEN
      EXISTS_TAC (← q r"vec 0:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
      ASM_REWRITE_TAC [CART_EQ, FORALL_2, DIMINDEX_2, pathstart] THEN
      SUBGOAL_THEN
       (← q r"(z:real^2) IN interval[a,b] /\ f(vec 0:real^1) IN interval[a,b]")
      MP_TAC THENL
       [ASM_MESON_TAC [SUBSET, path_image, IN_IMAGE, PATHSTART_IN_PATH_IMAGE,
                       pathstart],
        ASM_REWRITE_TAC [IN_INTERVAL, FORALL_2, DIMINDEX_2] THEN REAL_ARITH_TAC],
      ALL_TAC] THEN
    MP_TAC (← ASSUME (← q r"(a:real^2)$2 <= (b:real^2)$2")) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a <= b <=> b = a \/ a < b")] THEN STRIP_TAC THENL
     [SUBGOAL_THEN
        (← q r"?z:real^2. z IN path_image f /\ z$1 = (pathstart g:real^2)$1")
      MP_TAC THENL
       [MATCH_MP_TAC CONNECTED_IVT_COMPONENT THEN
        MAP_EVERY EXISTS_TAC [← q r"pathstart(f:real^1->real^2)",
                              ← q r"pathfinish(f:real^1->real^2)"] THEN
        ASM_SIMP_TAC [CONNECTED_PATH_IMAGE, PATHSTART_IN_PATH_IMAGE, REAL_LE_REFL,
                      PATHFINISH_IN_PATH_IMAGE, DIMINDEX_2, ARITH] THEN
        UNDISCH_TAC (← q r"path_image g SUBSET interval[a:real^2,b]") THEN
        REWRITE_TAC [SUBSET, path_image, IN_INTERVAL_1, FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN SIMP_TAC [pathstart] THEN
        SIMP_TAC [DROP_VEC, REAL_POS, IN_INTERVAL, FORALL_2, DIMINDEX_2],
        ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^2") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN SIMP_TAC [path_image, IN_IMAGE] THEN
      EXISTS_TAC (← q r"vec 0:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
      ASM_REWRITE_TAC [CART_EQ, FORALL_2, DIMINDEX_2, pathstart] THEN
      SUBGOAL_THEN
       (← q r"(z:real^2) IN interval[a,b] /\ g(vec 0:real^1) IN interval[a,b]")
      MP_TAC THENL
       [ASM_MESON_TAC [SUBSET, path_image, IN_IMAGE, PATHSTART_IN_PATH_IMAGE,
                       pathstart],
        ASM_REWRITE_TAC [IN_INTERVAL, FORALL_2, DIMINDEX_2] THEN REAL_ARITH_TAC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"interval_bij (a,b) (--vec 1,vec 1) o (f:real^1->real^2)",
      ← q r"interval_bij (a,b) (--vec 1,vec 1) o (g:real^1->real^2)"]
     FASHODA_UNIT_PATH) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [path, path_image, pathstart, pathfinish]) THEN
    ASM_REWRITE_TAC [path, path_image, pathstart, pathfinish, o_THM] THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_INTERVAL_BIJ] THEN
      REWRITE_TAC [IMAGE_o] THEN REPLICATE_TAC 2 (CONJ_TAC THENL
       [REWRITE_TAC [SUBSET] THEN ONCE_REWRITE_TAC [FORALL_IN_IMAGE] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC IN_INTERVAL_INTERVAL_BIJ THEN
        SIMP_TAC [INTERVAL_NE_EMPTY, VECTOR_NEG_COMPONENT, VEC_COMPONENT] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM SET_TAC [],
        ALL_TAC]) THEN
      ASM_SIMP_TAC [interval_bij, LAMBDA_BETA, DIMINDEX_2, ARITH] THEN
      ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ, REAL_SUB_LT] THEN
      REWRITE_TAC [real_div, REAL_SUB_REFL, REAL_MUL_LZERO] THEN
      SIMP_TAC [VECTOR_NEG_COMPONENT, VEC_COMPONENT, DIMINDEX_2, ARITH] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^2")
     (fun th => tactic_of do
        pure (EXISTS_TAC (← q r"interval_bij (--vec 1,vec 1) (a,b) (z:real^2)") THEN
              MP_TAC th))) THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN REWRITE_TAC [IMAGE_o] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s ==> g(f(x)) = x) ==> x IN IMAGE f s ==> g x IN s")) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERVAL_BIJ_BIJ THEN
    ASM_SIMP_TAC [FORALL_2, DIMINDEX_2, VECTOR_NEG_COMPONENT, VEC_COMPONENT,
                  ARITH] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let SEGMENT_VERTICAL ← prove
   r"!a:real^2 b:real^2 x:real^2.
      a$1 = b$1
      ==> (x IN segment[a,b] <=>
           x$1 = a$1 /\ x$1 = b$1 /\
           (a$2 <= x$2 /\ x$2 <= b$2 \/ b$2 <= x$2 /\ x$2 <= a$2))"
   (GEOM_ORIGIN_TAC (← q r"a:real^2") THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, VEC_COMPONENT, REAL_LE_LADD,
                 REAL_EQ_ADD_LCANCEL] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
    SUBST1_TAC (← SYM (← ISPEC (← q r"b:real^2") BASIS_EXPANSION)) THEN
    ASM_REWRITE_TAC [DIMINDEX_2, VSUM_2, VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^2 = &0 % basis 2")) THEN
    REWRITE_TAC [SEGMENT_SCALAR_MULTIPLE, IN_ELIM_THM, CART_EQ] THEN
    REWRITE_TAC [DIMINDEX_2, FORALL_2, VECTOR_MUL_COMPONENT] THEN
    SIMP_TAC [BASIS_COMPONENT, DIMINDEX_2, ARITH,
              REAL_MUL_RZERO, REAL_MUL_RID] THEN MESON_TAC [])

  let SEGMENT_HORIZONTAL ← prove
   r"!a:real^2 b:real^2 x:real^2.
      a$2 = b$2
      ==> (x IN segment[a,b] <=>
           x$2 = a$2 /\ x$2 = b$2 /\
           (a$1 <= x$1 /\ x$1 <= b$1 \/ b$1 <= x$1 /\ x$1 <= a$1))"
   (GEOM_ORIGIN_TAC (← q r"a:real^2") THEN
    REWRITE_TAC [VECTOR_ADD_COMPONENT, VEC_COMPONENT, REAL_LE_LADD,
                 REAL_EQ_ADD_LCANCEL] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (ASSUME_TAC o SYM) THEN
    SUBST1_TAC (← SYM (← ISPEC (← q r"b:real^2") BASIS_EXPANSION)) THEN
    ASM_REWRITE_TAC [DIMINDEX_2, VSUM_2, VECTOR_MUL_LZERO, VECTOR_ADD_RID] THEN
    SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^2 = &0 % basis 1")) THEN
    REWRITE_TAC [SEGMENT_SCALAR_MULTIPLE, IN_ELIM_THM, CART_EQ] THEN
    REWRITE_TAC [DIMINDEX_2, FORALL_2, VECTOR_MUL_COMPONENT] THEN
    SIMP_TAC [BASIS_COMPONENT, DIMINDEX_2, ARITH,
              REAL_MUL_RZERO, REAL_MUL_RID] THEN MESON_TAC [])

  let FASHODA_INTERLACE ← prove
   r"!f g a b:real^2.
        path f /\ path g /\
        path_image f SUBSET interval[a,b] /\
        path_image g SUBSET interval[a,b] /\
        (pathstart f)$2 = a$2 /\ (pathfinish f)$2 = a$2 /\
        (pathstart g)$2 = a$2 /\ (pathfinish g)$2 = a$2 /\
        (pathstart f)$1 < (pathstart g)$1 /\
        (pathstart g)$1 < (pathfinish f)$1 /\
        (pathfinish f)$1 < (pathfinish g)$1
        ==> ?z. z IN path_image f /\ z IN path_image g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(interval[a:real^2,b] = {})") MP_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> ~(s = {}) ==> ~(t = {})"))) THEN
      REWRITE_TAC [PATH_IMAGE_NONEMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"pathstart (f:real^1->real^2) IN interval[a,b] /\
      pathfinish f IN interval[a,b] /\
      pathstart g IN interval[a,b] /\
      pathfinish g IN interval[a,b]")
    MP_TAC THENL
     [ASM_MESON_TAC [SUBSET, PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE],
      ALL_TAC] THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY, IN_INTERVAL, FORALL_2, DIMINDEX_2] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL
     [← q r"linepath(vector[a$1 - &2;a$2 - &2],vector[(pathstart f)$1;a$2 - &2]) ++
       linepath(vector[(pathstart f)$1;(a:real^2)$2 - &2],pathstart f) ++
       (f:real^1->real^2) ++
       linepath(pathfinish f,vector[(pathfinish f)$1;a$2 - &2]) ++
       linepath(vector[(pathfinish f)$1;a$2 - &2],
                vector[(b:real^2)$1 + &2;a$2 - &2])",
      ← q r"linepath(vector[(pathstart g)$1; (pathstart g)$2 - &3],pathstart g) ++
       (g:real^1->real^2) ++
       linepath(pathfinish g,vector[(pathfinish g)$1;(a:real^2)$2 - &1]) ++
       linepath(vector[(pathfinish g)$1;a$2 - &1],vector[b$1 + &1;a$2 - &1]) ++
       linepath(vector[b$1 + &1;a$2 - &1],vector[(b:real^2)$1 + &1;b$2 + &3])",
      ← q r"vector[(a:real^2)$1 - &2; a$2 - &3]:real^2",
      ← q r"vector[(b:real^2)$1 + &2; b$2 + &3]:real^2"]
     FASHODA) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_JOIN,
                  PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH] THEN
    REWRITE_TAC [VECTOR_2] THEN ANTS_TAC THENL
     [CONJ_TAC THEN
      REPEAT (MATCH_MP_TAC
              (← SET_RULE (← q r"s SUBSET u /\ t SUBSET u ==> (s UNION t) SUBSET u")) THEN
             CONJ_TAC) THEN
      TRY (REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN
          MATCH_MP_TAC (← REWRITE_RULE [CONVEX_CONTAINS_SEGMENT]
             (← CONJUNCT1 (← SPEC_ALL CONVEX_INTERVAL))) THEN
          ASM_REWRITE_TAC [IN_INTERVAL, FORALL_2, DIMINDEX_2, VECTOR_2] THEN
          ASM_REAL_ARITH_TAC) THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"interval[a:real^2,b:real^2]") THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN
      REWRITE_TAC [SUBSET_INTERVAL, FORALL_2, DIMINDEX_2, VECTOR_2] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^2") THEN
    REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN
    (tactic_of do
      let sr ← SET_RULE (← q r"(s UNION t) UNION u = u UNION t UNION s")
      let gua ← GSYM UNION_ASSOC
      pure (SUBGOAL_THEN
       (← q r"!f s:real^2->bool. path_image f UNION s =
                           path_image f UNION (s DIFF {pathstart f,pathfinish f})")
       (fun th => ONCE_REWRITE_TAC [th] THEN
                  REWRITE_TAC [gua] THEN
                  ONCE_REWRITE_TAC [sr] THEN
                  ONCE_REWRITE_TAC [th])
      THENL
       [REWRITE_TAC [EXTENSION, IN_UNION, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
        ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE],
        ALL_TAC])) THEN
    REWRITE_TAC [IN_UNION, IN_DIFF, ← GSYM DISJ_ASSOC, LEFT_OR_DISTRIB,
                 RIGHT_OR_DISTRIB, ← GSYM CONJ_ASSOC,
                 ← SET_RULE (← q r"~(z IN {x,y}) <=> ~(z = x) /\ ~(z = y)")] THEN
    DISCH_THEN (REPEAT_TCL DISJ_CASES_THEN MP_TAC) THEN
    ASM_SIMP_TAC [SEGMENT_VERTICAL, SEGMENT_HORIZONTAL, VECTOR_2] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"path_image (f:real^1->real^2) SUBSET interval [a,b]") THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"z:real^2")) THEN
    UNDISCH_TAC (← q r"path_image (g:real^1->real^2) SUBSET interval [a,b]") THEN
    REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"z:real^2")) THEN
    ASM_REWRITE_TAC [IN_INTERVAL, FORALL_2, DIMINDEX_2] THEN
    REPEAT (DISCH_THEN (fun th => if HolCore.Basics.is_imp (concl th) then ALL_TAC else
      ASSUME_TAC th)) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN TRY REAL_ARITH_TAC THEN
    REWRITE_TAC [CART_EQ, FORALL_2, DIMINDEX_2] THEN REAL_ARITH_TAC)

  pure { INFNORM_2, INFNORM_EQ_1_2, INFNORM_EQ_1_IMP, FASHODA_UNIT, FASHODA_UNIT_PATH,
         FASHODA, SEGMENT_VERTICAL, SEGMENT_HORIZONTAL, FASHODA_INTERLACE }

/- ------------------------------------------------------------------------- -/
/- Complement in dimension N >= 2 of a set homeomorphic to an interval is    -/
/- (path-)connected; application to arcs.  (degree.ml 8393-8526)            -/
/- ------------------------------------------------------------------------- -/

structure DGT where
  UNBOUNDED_COMPONENTS_COMPLEMENT_ABSOLUTE_RETRACT : thm
  CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT : thm
  PATH_CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT : thm
  CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT : thm
  PATH_CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT : thm
  RETRACTION_ARC : thm
  PATH_CONNECTED_ARC_COMPLEMENT : thm
  CONNECTED_ARC_COMPLEMENT : thm
  INSIDE_ARC_EMPTY : thm
  INSIDE_SIMPLE_CURVE_IMP_CLOSED : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupDGT [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGL : DGL) (BDGP : DGP) : ExceptT String IO DGT := do
  -- @@SCOPE BEGIN
  let { retract_of, retraction, .. } := BDGB
  let { HOMEOMORPHIC_ARNESS, .. } := BDGF
  let { COMPACT_AR, .. } := BDGG
  let { CONVEX_IMP_AR, .. } := BDGH
  let { ABSOLUTE_RETRACT_PATH_IMAGE_ARC, .. } := BDGL
  let { FRONTIER_SUBSET_RETRACTION, .. } := BDGP
  let { CONJ_ASSOC, DIFF_EMPTY, DIMINDEX_GE_1, EQ_IMP, FORALL_IN_GSPEC, .. } :=
        D.pt.cvx.core1
  let { IMP_CONJ, IN_DIFF, .. } := D.pt.cvx.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.pt.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.pt.cvx.core5
  let { SUBSET_UNIV, .. } := D.pt.cvx.core6
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_INTERVAL,
        CONNECTED_COMPONENT_SUBSET, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, .. } := D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, INTERIOR_OPEN, .. } := D.pt.cvx.top4
  let { closed, components, frontier, .. } := D.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { CONVEX_CONNECTED_1_GEN, CONVEX_INTERVAL, .. } := D.qconvex
  let { ARC_IMP_PATH, ARC_SIMPLE_PATH, BOUNDED_PATH_IMAGE,
        COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT, CONNECTED_PATH_IMAGE, .. } := D.qpaths1
  let { arc, IN_CLOSURE_CONNECTED_COMPONENT, INSIDE_BOUNDED_COMPLEMENT_CONNECTED_EMPTY,
        INSIDE_CONVEX, OPEN_CONNECTED_COMPONENT, path, PATH_CONNECTED_EQ_CONNECTED,
        PATH_CONNECTED_IMP_CONNECTED, path_image, .. } := D.qpaths2
  let { COMPL_COMPL, .. } := D.qsession
  let { CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_EQ_CONNECTED_COMPONENT_EQ, CONNECTED_UNIV,
        .. } := D.qtopology1
  let { HOMEOMORPHIC_COMPACT, HOMEOMORPHIC_COMPACTNESS, IN_COMPONENTS, .. } := D.qtopology2
  -- @@SCOPE END

  let UNBOUNDED_COMPONENTS_COMPLEMENT_ABSOLUTE_RETRACT ← prove
   r"!s c. compact s /\ AR s /\ c IN components((:real^N) DIFF s)
         ==> ~bounded c"
   (REWRITE_TAC [CONJ_ASSOC, COMPACT_AR] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, components, FORALL_IN_GSPEC] THEN
    GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"open((:real^N) DIFF s)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [← GSYM closed, COMPACT_IMP_CLOSED], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^N->real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"connected_component ((:real^N) DIFF s) y",
                      ← q r"s:real^N->bool",
                      ← q r"r:real^N->real^N"]
                  FRONTIER_SUBSET_RETRACTION) THEN
    ASM_SIMP_TAC [NOT_IMP, INTERIOR_OPEN, OPEN_CONNECTED_COMPONENT] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [frontier] THEN
      ASM_SIMP_TAC [INTERIOR_OPEN, OPEN_CONNECTED_COMPONENT] THEN
      REWRITE_TAC [SUBSET, IN_DIFF] THEN X_GEN_TAC (← q r"z:real^N") THEN
      ASM_CASES_TAC (← q r"(z:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [IN_CLOSURE_CONNECTED_COMPONENT, IN_UNIV, IN_DIFF] THEN
      CONV_TAC (fun t => TAUT t),
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_UNIV],
      ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE
       (← q r"~(c = {}) /\ c SUBSET (:real^N) DIFF s ==> ~(c SUBSET s)")) THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET, CONNECTED_COMPONENT_EQ_EMPTY] THEN
      ASM_REWRITE_TAC [IN_UNIV, IN_DIFF]])

  let CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT ← prove
   r"!s. 2 <= dimindex(:N) /\ compact s /\ AR s
       ==> connected((:real^N) DIFF s)"
   (REWRITE_TAC [COMPACT_AR] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_EQ_CONNECTED_COMPONENT_EQ] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT THEN
    ASM_SIMP_TAC [COMPL_COMPL, COMPACT_IMP_BOUNDED] THEN
    CONJ_TAC THEN
    MATCH_MP_TAC UNBOUNDED_COMPONENTS_COMPLEMENT_ABSOLUTE_RETRACT THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN REWRITE_TAC [CONJ_ASSOC, COMPACT_AR] THEN
    ASM_REWRITE_TAC [IN_COMPONENTS] THEN ASM_MESON_TAC [])

  let PATH_CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT ← prove
   r"!s:real^N->bool.
        2 <= dimindex(:N) /\ compact s /\ AR s
        ==> path_connected((:real^N) DIFF s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT) THEN
    MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC PATH_CONNECTED_EQ_CONNECTED THEN
    REWRITE_TAC [← GSYM closed] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_INTERVAL,
                   COMPACT_IMP_CLOSED])

  let CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT ← prove
   r"!s:real^N->bool t:real^M->bool.
        2 <= dimindex(:N) /\ s homeomorphic t /\ convex t /\ compact t
        ==> connected((:real^N) DIFF s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [DIFF_EMPTY, CONNECTED_UNIV] THEN
    MATCH_MP_TAC CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_ARNESS) THEN
    ASM_MESON_TAC [CONVEX_IMP_AR, HOMEOMORPHIC_EMPTY])

  let PATH_CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT ← prove
   r"!s:real^N->bool t:real^M->bool.
        2 <= dimindex(:N) /\ s homeomorphic t /\ convex t /\ compact t
        ==> path_connected((:real^N) DIFF s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT) THEN
    MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC PATH_CONNECTED_EQ_CONNECTED THEN
    REWRITE_TAC [← GSYM closed] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_INTERVAL,
                   COMPACT_IMP_CLOSED])

  let RETRACTION_ARC ← prove
   r"!p. arc p
       ==> ?f. f continuous_on (:real^N) /\
               IMAGE f (:real^N) SUBSET path_image p /\
               (!x. x IN path_image p ==> f x = x)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(:real^N)") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          ABSOLUTE_RETRACT_PATH_IMAGE_ARC)) THEN
    REWRITE_TAC [SUBSET_UNIV, retract_of, retraction])

  let PATH_CONNECTED_ARC_COMPLEMENT ← prove
   r"!p. 2 <= dimindex(:N) /\ arc p
       ==> path_connected((:real^N) DIFF path_image p)"
   (REWRITE_TAC [arc, path] THEN REPEAT STRIP_TAC THEN SIMP_TAC [path_image] THEN
    MP_TAC (← ISPECL [← q r"path_image p:real^N->bool",
                      ← q r"interval[vec 0:real^1,vec 1]"]
          PATH_CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT) THEN
    ASM_REWRITE_TAC [CONVEX_INTERVAL, COMPACT_INTERVAL, path_image] THEN
    DISCH_THEN MATCH_MP_TAC THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    MATCH_MP_TAC HOMEOMORPHIC_COMPACT THEN
    EXISTS_TAC (← q r"p:real^1->real^N") THEN ASM_REWRITE_TAC [COMPACT_INTERVAL])

  let CONNECTED_ARC_COMPLEMENT ← prove
   r"!p. 2 <= dimindex(:N) /\ arc p
       ==> connected((:real^N) DIFF path_image p)"
   (SIMP_TAC [PATH_CONNECTED_ARC_COMPLEMENT, PATH_CONNECTED_IMP_CONNECTED])

  let INSIDE_ARC_EMPTY ← prove
   r"!p:real^1->real^N. arc p ==> inside(path_image p) = {}"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"dimindex(:N) = 1") THENL
     [MATCH_MP_TAC INSIDE_CONVEX THEN
      ASM_SIMP_TAC [CONVEX_CONNECTED_1_GEN, CONNECTED_PATH_IMAGE, ARC_IMP_PATH],
      MATCH_MP_TAC INSIDE_BOUNDED_COMPLEMENT_CONNECTED_EMPTY THEN
      ASM_SIMP_TAC [BOUNDED_PATH_IMAGE, ARC_IMP_PATH] THEN
      MATCH_MP_TAC CONNECTED_ARC_COMPLEMENT THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"2 <= n <=> 1 <= n /\ ~(n = 1)")] THEN
      REWRITE_TAC [DIMINDEX_GE_1]])

  let INSIDE_SIMPLE_CURVE_IMP_CLOSED ← prove
   r"!g x:real^N.
        simple_path g /\ x IN inside(path_image g)
        ==> pathfinish g = pathstart g"
   (MESON_TAC [ARC_SIMPLE_PATH, INSIDE_ARC_EMPTY, NOT_IN_EMPTY])

  pure { UNBOUNDED_COMPONENTS_COMPLEMENT_ABSOLUTE_RETRACT,
         CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT, PATH_CONNECTED_COMPLEMENT_ABSOLUTE_RETRACT,
         CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT,
         PATH_CONNECTED_COMPLEMENT_HOMEOMORPHIC_CONVEX_COMPACT, RETRACTION_ARC,
         PATH_CONNECTED_ARC_COMPLEMENT, CONNECTED_ARC_COMPLEMENT, INSIDE_ARC_EMPTY,
         INSIDE_SIMPLE_CURVE_IMP_CLOSED }

