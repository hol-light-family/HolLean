       [← GSYM IMAGE_o] THEN
      ASM_REWRITE_TAC [o_DEF, ← VECTOR_ARITH (← q r"--a + a + x:real^N = x"), IMAGE_ID],
      ASM_SIMP_TAC [o_DEF, ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")]])

  let RETRACT_OF_TRANSLATION_EQ ← prove
   r"!a t s:real^N->bool.
