      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_POW, REAL_ABS_NORM] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM NORM_EQ_0]) THEN
      UNDISCH_TAC (← q r"&0 < r") THEN
      SIMP_TAC [real_abs, REAL_LT_IMP_LE] THEN CONV_TAC (fun t => REAL_FIELD t),
      MATCH_MP_TAC CLOSURE_OF_SUBSET THEN ASM_MESON_TAC [OPEN_IN_SUBSET],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_CLOSURE_OF)) THEN
    ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s INTER (s DELETE a)")] THEN
    REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
    SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY_OPEN, OPEN_IN_DELETE, OPEN_IN_REFL] THEN
    SIMP_TAC [← SET_RULE (← q r"c SUBSET u ==> (u DELETE z) INTER c = c DELETE z"),
              CLOSURE_OF_SUBSET_SUBTOPOLOGY] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"z INSERT w = z INSERT y
      ==> w = x DELETE z ==> z INSERT y = z INSERT x")) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"i z = z ==> z INSERT IMAGE i (s DELETE z) = z INSERT IMAGE i s")) THEN
    EXPAND_TAC "i" THEN REWRITE_TAC [VECTOR_MUL_RZERO])

  let DIMENSION_FRONTIER_NONDENSE_OPEN ← prove
   r"!u:real^N->bool.
        open u /\ ~(u = {}) /\ ~(closure u = (:real^N))
        ==> dimension(frontier u) = &(dimindex(:N)) - &1"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"u:real^N->bool"]
          DIMENSION_RELATIVE_FRONTIER_NONDENSE_OPEN) THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_OPEN] THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, AFFINE_UNIV, AFF_DIM_UNIV,
                     EUCLIDEAN_CLOSURE_OF])

  let DIMENSION_RELATIVE_FRONTIER_CONVEX ← prove
   r"!s:real^N->bool.
        convex s /\ bounded s /\ ~(s = {})
        ==> dimension(relative_frontier s) = aff_dim s - &1"
   (REPEAT STRIP_TAC THEN  MP_TAC (← ISPECL
     [← q r"affine hull s:real^N->bool", ← q r"relative_interior s:real^N->bool"]
     DIMENSION_RELATIVE_FRONTIER_BOUNDED_OPEN) THEN
    REWRITE_TAC [AFFINE_AFFINE_HULL, OPEN_IN_RELATIVE_INTERIOR] THEN
    ASM_SIMP_TAC [BOUNDED_RELATIVE_INTERIOR, RELATIVE_FRONTIER_RELATIVE_INTERIOR,
                  AFF_DIM_AFFINE_HULL, RELATIVE_INTERIOR_EQ_EMPTY])

  let DIMENSION_SPHERE_INTER_AFFINE ← prove
   r"!a:real^N r t.
        &0 < r /\ affine t /\ a IN t
        ==> dimension(sphere(a,r) INTER t) = aff_dim t - &1"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN
    W (MP_TAC o PART_MATCH (rand o rand) RELATIVE_FRONTIER_CONVEX_INTER_AFFINE o
      rand o lhand o snd) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [CONVEX_CBALL, INTERIOR_CBALL, ← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) DIMENSION_RELATIVE_FRONTIER_CONVEX o
      lhand o snd) THEN
    ANTS_TAC THENL
     [SIMP_TAC [BOUNDED_INTER, BOUNDED_CBALL] THEN
      ASM_SIMP_TAC [CONVEX_INTER, CONVEX_CBALL, AFFINE_IMP_CONVEX] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      ASM_MESON_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE],
      DISCH_THEN SUBST1_TAC THEN AP_THM_TAC THEN AP_TERM_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN AP_TERM_TAC THEN
    ASM_SIMP_TAC [HULL_P] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    MATCH_MP_TAC AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERIOR_CBALL, IN_INTER] THEN
    ASM_MESON_TAC [CENTRE_IN_BALL])

  let DIMENSION_SPHERE ← prove
   r"!a:real^N r. dimension(sphere(a,r)) =
                if &0 < r then &(dimindex(:N)) - &1
                else if r = &0 then &0 else -- &1"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r:real = &0") THEN
    ASM_SIMP_TAC [REAL_LT_REFL, SPHERE_SING, DIMENSION_SING] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [DIMENSION_EQ_MINUS1, SPHERE_EQ_EMPTY] THENL
     [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV)
     [← SET_RULE (← q r"s = s INTER UNIV")] THEN
    ASM_SIMP_TAC [DIMENSION_SPHERE_INTER_AFFINE, AFFINE_UNIV, IN_UNIV] THEN
    REWRITE_TAC [AFF_DIM_UNIV])

  pure { AFF_DIM_DIMENSION, AFF_DIM_DIMENSION_ALT, DIMENSION_SUBSPACE, DIM_DIMENSION,
         DIMENSION_OPEN_IN_CONVEX, DIMENSION_OPEN, DIMENSION_UNIV,
         DIMENSION_NONEMPTY_INTERIOR, DIMENSION_ATMOST_RATIONAL_COORDINATES,
         DIMENSION_COMPLEMENT_RATIONAL_COORDINATES, DIMENSION_EQ_FULL_GEN,
         DIMENSION_LT_FULL_GEN, DIMENSION_EQ_FULL_ALT, DIMENSION_LT_FULL_ALT,
         DIMENSION_EQ_FULL, DIMENSION_LT_FULL, DIMENSION_RELATIVE_FRONTIER_BOUNDED_OPEN,
         DIMENSION_FRONTIER_BOUNDED_OPEN, DIMENSION_RELATIVE_FRONTIER_NONDENSE_OPEN,
         DIMENSION_FRONTIER_NONDENSE_OPEN, DIMENSION_RELATIVE_FRONTIER_CONVEX,
         DIMENSION_SPHERE_INTER_AFFINE, DIMENSION_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Nonseparation: a "simple" set of dimension n can't be separated by sets   -/
/- of dimension <= n - 2.  (degree.ml 2318-2613)                             -/
/- ------------------------------------------------------------------------- -/

structure DGE where
  CONNECTED_OPEN_IN_CONVEX_DIFF_LOWDIM : thm
  CONNECTED_CONVEX_DIFF_LOWDIM : thm
  CONNECTED_OPEN_IN_DIFF_LOWDIM : thm
  CONNECTED_OPEN_DIFF_LOWDIM : thm
  CONNECTED_FULL_CONVEX_DIFF_LOWDIM : thm
  CONNECTED_UNIV_DIFF_LOWDIM : thm
  CONNECTED_FULL_REGULAR_DIFF_LOWDIM : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGE [HolBase] (D : DegreeDeps) (BDGD : DGD) : ExceptT String IO DGE := do
  -- @@SCOPE BEGIN
  let { DIMENSION_LT_FULL_ALT, DIMENSION_NONEMPTY_INTERIOR, DIMENSION_OPEN_IN_CONVEX,
        DIMENSION_RELATIVE_FRONTIER_NONDENSE_OPEN, .. } := BDGD
  let { EMPTY_DIFF, EQ_IMP, .. } := D.pt.cvx.core1
  let { IMP_CONJ, INT_EQ_IMP_LE, INT_LE_TRANS, INTER_COMM, INTER_SUBSET, .. } :=
        D.pt.cvx.core2
  let { IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_IMP, .. } :=
        D.pt.cvx.core3
  let { SUBSET_DIFF, SUBSET_TRANS, .. } := D.pt.cvx.core5
  let { SUBSET_UNIV, UNIV_NOT_EMPTY, .. } := D.pt.cvx.core6
  let { HULL_P, HULL_SUBSET, .. } := D.pt.cvx.misc
  let { CLOSURE_OF_SUBTOPOLOGY, frontier_of, INTERIOR_OF_EQ_EMPTY_COMPLEMENT,
        INTERIOR_OF_RESTRICT, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, .. } := D.pt.cvx.met
  let { CENTRE_IN_BALL, CLOSED_CLOSURE, CLOSURE_COMPLEMENT, .. } := D.pt.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_OPEN_IN_INTER_CLOSURE, CLOSURE_SUBSET, .. } :=
        D.pt.cvx.top2
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.pt.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_OF_SUBSETS, INTERIOR_SUBSET, INTERIOR_UNIV, OPEN_BALL,
        .. } := D.pt.cvx.top4
  let { homeomorphic, OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN_INTER, OPEN_IN_REFL,
        OPEN_INTERIOR, OPEN_SUBSET, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } :=
        D.pt.cvx.top5
  let { ASM_INT_ARITH_TAC, ASM_MESON_TAC, INT_ARITH, MESON_TAC, SET_RULE, SET_TAC, .. } :=
        D.pt.cvx
  let { INTER_ASSOC, .. } := D.pt.qses
  let { AFF_DIM_AFFINE_HULL, AFF_DIM_NONEMPTY_INTERIOR, AFFINE_AFFINE_HULL,
        AFFINE_IMP_CONVEX, .. } := D.pt.qcvx1
  let { CONVEX_BALL, CONVEX_INTER, .. } := D.pt.qcvx2
  let { CONVEX_UNIV, OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_SUBSET, .. } := D.pt.qcvx3
  let { AFF_DIM_OPEN, AFFINE_HULL_CONVEX_INTER_OPEN, AFFINE_HULL_OPEN_IN_AFFINE,
        AFFINE_HULL_OPEN_IN_CONVEX, CONNECTED_WITH_RELATIVE_INTERIOR_OPEN_IN_CONVEX,
        CONVEX_CLOSURE_RELATIVE_INTERIOR, CONVEX_CONNECTED,
        HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS, RELATIVE_FRONTIER_FRONTIER_OF, .. } :=
        D.qconvex
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO,
        CLOSURE_OF_SUBSET_SUBTOPOLOGY, CLOSURE_OF_UNION, INTERIOR_OF_OPEN_IN, .. } :=
        D.qmetric
  let { DIMENSION_SUBSET, HOMEOMORPHIC_DIMENSION, .. } := D.qpaths1
  let { CONNECTED_CONNECTED_DIFF, CONNECTED_EMPTY, CONNECTED_INTERMEDIATE_CLOSURE,
        CONNECTED_SEPARATION, .. } := D.qtopology1
  let { HOMEOMORPHIC_CONNECTEDNESS, OPEN_IN_DIFF_CLOSED, OPEN_INTER_CLOSURE_EQ, .. } :=
        D.qtopology2
  -- @@SCOPE END

  let CONNECTED_OPEN_IN_CONVEX_DIFF_LOWDIM ← (do
    let lemma1 ← prove
     r"!u s:real^N->bool.
          affine u /\ dimension s <= aff_dim u - &2 ==> connected(u DIFF s)"
     (MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"d:real^N->bool"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"subtopology euclidean u interior_of d:real^N->bool = {}")
      ASSUME_TAC THENL
       [ONCE_REWRITE_TAC [INTERIOR_OF_RESTRICT] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"u INTER d:real^N->bool"]
          DIMENSION_LT_FULL_ALT) THEN
        ASM_SIMP_TAC [AFFINE_IMP_CONVEX, INTER_SUBSET] THEN
        MATCH_MP_TAC (← TAUT (← q r"p ==> (p <=> q /\ r) ==> r")) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
         (← q r"d:int <= u - &2 ==> d' <= d ==> d' < u"))) THEN
        SIMP_TAC [DIMENSION_SUBSET, INTER_SUBSET],
        ALL_TAC] THEN
      REWRITE_TAC [CONNECTED_SEPARATION, NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u1:real^N->bool", ← q r"u2:real^N->bool"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP (← SET_RULE
       (← q r"u1 UNION u2 = u DIFF d ==> u INTER u1 = u1 /\ u INTER u2 = u2"))) THEN
      SUBGOAL_THEN (← q r"(u:real^N->bool) SUBSET closure u1 UNION closure u2")
      ASSUME_TAC THENL
       [FIRST_ASSUM (MP_TAC o
          GEN_REWRITE_RULE I [INTERIOR_OF_EQ_EMPTY_COMPLEMENT]) THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        SUBST1_TAC (← SYM (← ASSUME (← q r"u1 UNION u2:real^N->bool = u DIFF d"))) THEN
        REWRITE_TAC [CLOSURE_OF_UNION] THEN
        ASM_REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
        SET_TAC [],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"v:real^N->bool = u DIFF closure u1") THEN
      MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"v:real^N->bool"]
        DIMENSION_RELATIVE_FRONTIER_NONDENSE_OPEN) THEN
      SUBGOAL_THEN (← q r"~(v:real^N->bool = {})") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"open_in (subtopology euclidean u) (v:real^N->bool)")
      ASSUME_TAC THENL
       [EXPAND_TAC "v" THEN SIMP_TAC [OPEN_IN_DIFF_CLOSED, CLOSED_CLOSURE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"v:real^N->bool"]
        AFFINE_HULL_OPEN_IN_AFFINE) THEN
      ASM_REWRITE_TAC [RELATIVE_FRONTIER_FRONTIER_OF] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"!t. s SUBSET t /\ t SUBSET u /\ ~(t = u)
          ==> ~(s = u)")) THEN
        EXISTS_TAC (← q r"subtopology euclidean u closure_of u2:real^N->bool") THEN
        REWRITE_TAC [CLOSURE_OF_SUBSET_SUBTOPOLOGY] THEN CONJ_TAC THENL
         [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN REWRITE_TAC [CLOSED_IN_CLOSURE_OF],
          ALL_TAC] THEN
        ASM_REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
        ASM SET_TAC [],
        MATCH_MP_TAC (← INT_ARITH
         (← q r"!x. d:int <= x /\ x < n ==> ~(d = n)")) THEN
        EXISTS_TAC (← q r"dimension(d:real^N->bool)") THEN
        CONJ_TAC THENL [MATCH_MP_TAC DIMENSION_SUBSET, ASM_INT_ARITH_TAC] THEN
        ASM_SIMP_TAC [frontier_of, INTERIOR_OF_OPEN_IN] THEN
        MP_TAC (← ISPECL [← q r"subtopology euclidean (u:real^N->bool)",
              ← q r"u DIFF subtopology euclidean u closure_of u1:real^N->bool",
              ← q r"subtopology euclidean u closure_of u2:real^N->bool"]
            CLOSURE_OF_MONO) THEN
        REWRITE_TAC [CLOSURE_OF_CLOSURE_OF] THEN
        ASM_REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
        ASM_REWRITE_TAC [← SET_RULE (← q r"u DIFF u INTER s = u DIFF s")] THEN
        ASM SET_TAC []])
    let lemma2 ← prove
     r"!u s t:real^N->bool.
          affine u /\ open_in (subtopology euclidean u) s /\
          connected s /\ dimension t <= aff_dim u - &2
          ==> connected(s DIFF t)"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      MATCH_MP_TAC CONNECTED_CONNECTED_DIFF THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"s:real^N->bool",
                          ← q r"u DIFF t:real^N->bool", ← q r"u:real^N->bool"]
          CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
        ASM_REWRITE_TAC [SUBSET_DIFF] THEN
        MP_TAC (← ISPECL
         [← q r"u:real^N->bool", ← q r"u DIFF closure(u DIFF t):real^N->bool"]
         DIMENSION_OPEN_IN_CONVEX) THEN
        ASM_SIMP_TAC [AFFINE_IMP_CONVEX, OPEN_IN_DIFF_CLOSED, CLOSED_CLOSURE] THEN
        COND_CASES_TAC THENL
         [DISCH_THEN (K ALL_TAC : thm → tactic) THEN
          ASM_SIMP_TAC [← SET_RULE
           (← q r"s SUBSET u /\ u DIFF closure(u DIFF t) = {}
            ==> s INTER closure (u DIFF t) = s")] THEN
          ASM_SIMP_TAC [← SET_RULE
           (← q r"s SUBSET u ==> s INTER (u DIFF t) = s DIFF t")] THEN
          MESON_TAC [CLOSURE_SUBSET],
          MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
           (← q r"d:int <= u - &2 ==> d' <= d ==> ~(d' = u)"))) THEN
          MATCH_MP_TAC DIMENSION_SUBSET THEN
          MP_TAC (← ISPEC (← q r"u DIFF t:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC []],
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_IN_CONTAINS_BALL]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"ball(x:real^N,r) INTER u") THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL, IN_INTER] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [INTER_COMM, OPEN_BALL, OPEN_IN_OPEN_INTER,
                         OPEN_IN_SUBSET_TRANS],
          ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"ball(x:real^N,r) INTER u", ← q r"u:real^N->bool"]
            HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS) THEN
        ASM_SIMP_TAC [CONVEX_BALL, CONVEX_INTER, AFFINE_IMP_CONVEX] THEN
        ASM_SIMP_TAC [HULL_P, OPEN_IN_REFL] THEN
        ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
        ONCE_REWRITE_TAC [INTER_COMM] THEN
        SUBGOAL_THEN (← q r"affine hull (u INTER ball(x:real^N,r)) = affine hull u")
        SUBST1_TAC THENL
         [MATCH_MP_TAC AFFINE_HULL_CONVEX_INTER_OPEN THEN
          ASM_SIMP_TAC [AFFINE_IMP_CONVEX, OPEN_BALL, ← GSYM MEMBER_NOT_EMPTY] THEN
          EXISTS_TAC (← q r"x:real^N") THEN
          ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN
          ASM SET_TAC [],
          ASM_SIMP_TAC [HULL_P, OPEN_IN_OPEN_INTER, OPEN_BALL]] THEN
        REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
        DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"u:real^N->bool",
                          ← q r"IMAGE (f:real^N->real^N) (ball(x,r) INTER u INTER t)"]
            lemma1) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [TRANS_TAC INT_LE_TRANS (← q r"dimension(t:real^N->bool)") THEN
          ASM_REWRITE_TAC [] THEN
          TRANS_TAC INT_LE_TRANS
            (← q r"dimension(ball(x:real^N,r) INTER u INTER t)") THEN
          ASM_SIMP_TAC [DIMENSION_SUBSET, INTER_SUBSET, ← GSYM INTER_ASSOC] THEN
          MATCH_MP_TAC INT_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
          MATCH_MP_TAC HOMEOMORPHIC_DIMENSION,
          MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
          MATCH_MP_TAC HOMEOMORPHIC_CONNECTEDNESS] THEN
        REWRITE_TAC [homeomorphic] THEN
        MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
        REWRITE_TAC [INTER_SUBSET, SUBSET_DIFF, SUBSET_UNIV] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN ASM SET_TAC []])
    prove
     r"!c s t:real^N->bool.
        convex c /\ open_in (subtopology euclidean c) s /\
        connected s /\ dimension t <= aff_dim c - &2
        ==> connected(s DIFF t)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [CONNECTED_EMPTY, EMPTY_DIFF] THEN
      MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"(relative_interior c INTER s) DIFF t:real^N->bool") THEN
      SUBGOAL_THEN
       (← q r"open_in (subtopology euclidean (affine hull c))
                (relative_interior c INTER s:real^N->bool)")
      ASSUME_TAC THENL
       [TRANS_TAC OPEN_IN_TRANS (← q r"relative_interior c:real^N->bool") THEN
        ASM_REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR] THEN
        MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"c:real^N->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL, RELATIVE_INTERIOR_SUBSET],
        ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC lemma2 THEN
        EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
        REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR] THEN
        ASM_SIMP_TAC [AFF_DIM_AFFINE_HULL, AFFINE_AFFINE_HULL] THEN
        MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"s:real^N->bool"]
            AFFINE_HULL_OPEN_IN_CONVEX) THEN
        ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
        DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN
        MATCH_MP_TAC CONNECTED_WITH_RELATIVE_INTERIOR_OPEN_IN_CONVEX THEN
        ASM_REWRITE_TAC [],
        MP_TAC (← ISPEC (← q r"c:real^N->bool") RELATIVE_INTERIOR_SUBSET) THEN SET_TAC [],
        MP_TAC (← ISPECL
         [← q r"relative_interior c INTER s:real^N->bool",
          ← q r"affine hull c DIFF t:real^N->bool",
          ← q r"affine hull c:real^N->bool"] CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
        ASM_REWRITE_TAC [SUBSET_DIFF] THEN
        MP_TAC (← ISPECL
         [← q r"affine hull c:real^N->bool",
          ← q r"affine hull c DIFF closure(affine hull c DIFF t):real^N->bool"]
         DIMENSION_OPEN_IN_CONVEX) THEN
        ASM_SIMP_TAC [AFFINE_IMP_CONVEX, OPEN_IN_DIFF_CLOSED, CLOSED_CLOSURE,
                      AFFINE_AFFINE_HULL] THEN
        COND_CASES_TAC THENL
         [DISCH_THEN (K ALL_TAC : thm → tactic) THEN
          ASM_SIMP_TAC [RELATIVE_INTERIOR_SUBSET, HULL_SUBSET, ← SET_RULE
           (← q r"relative_interior c SUBSET c /\ c SUBSET u /\
            u DIFF closure(u DIFF t) = {}
            ==> (relative_interior c INTER s) INTER closure (u DIFF t) =
                relative_interior c INTER s /\
                (relative_interior c INTER s) INTER (u DIFF t) =
                (relative_interior c INTER s) DIFF t")] THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN
          ONCE_REWRITE_TAC [INTER_COMM] THEN
          MP_TAC (← ISPECL
           [← q r"s:real^N->bool", ← q r"relative_interior c:real^N->bool", ← q r"c:real^N->bool"]
           CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
          REWRITE_TAC [RELATIVE_INTERIOR_SUBSET] THEN
          ASM_SIMP_TAC [CONVEX_CLOSURE_RELATIVE_INTERIOR] THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN
          TRANS_TAC SUBSET_TRANS (← q r"s:real^N->bool") THEN
          REWRITE_TAC [SUBSET_DIFF] THEN
          TRANS_TAC SUBSET_TRANS (← q r"closure s:real^N->bool") THEN
          REWRITE_TAC [CLOSURE_SUBSET] THEN MATCH_MP_TAC SUBSET_CLOSURE THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"c SUBSET closure c /\ s SUBSET c ==> s SUBSET s INTER closure c")) THEN
          ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSURE_SUBSET],
          MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
          REWRITE_TAC [AFF_DIM_AFFINE_HULL] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
           (← q r"d:int <= u - &2 ==> d' <= d ==> ~(d' = u)"))) THEN
          MATCH_MP_TAC DIMENSION_SUBSET THEN
          MP_TAC (← ISPEC (← q r"affine hull c DIFF t:real^N->bool") CLOSURE_SUBSET) THEN
          SET_TAC []]]))

  let CONNECTED_CONVEX_DIFF_LOWDIM ← prove
   r"!s t:real^N->bool.
        convex s /\ dimension t <= aff_dim s - &2 ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_OPEN_IN_CONVEX_DIFF_LOWDIM THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_SIMP_TAC [CONVEX_CONNECTED, OPEN_IN_REFL])

  let CONNECTED_OPEN_IN_DIFF_LOWDIM ← prove
   r"!s t:real^N->bool.
        open_in (subtopology euclidean (affine hull s)) s /\
        connected s /\
        dimension t <= aff_dim s - &2
        ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_OPEN_IN_CONVEX_DIFF_LOWDIM THEN
    EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFF_DIM_AFFINE_HULL, AFFINE_AFFINE_HULL])

  let CONNECTED_OPEN_DIFF_LOWDIM ← prove
   r"!s t:real^N->bool.
        open s /\ connected s /\ dimension t <= &(dimindex(:N)) - &2
        ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [EMPTY_DIFF, CONNECTED_EMPTY] THEN
    MATCH_MP_TAC CONNECTED_OPEN_IN_DIFF_LOWDIM THEN
    ASM_SIMP_TAC [OPEN_SUBSET, HULL_SUBSET, AFF_DIM_OPEN])

  let CONNECTED_FULL_CONVEX_DIFF_LOWDIM ← prove
   r"!s:real^N->bool t.
        convex s /\ ~(interior s = {}) /\ dimension t <= &(dimindex(:N)) - &2
        ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_CONVEX_DIFF_LOWDIM THEN
    ASM_SIMP_TAC [AFF_DIM_NONEMPTY_INTERIOR])

  let CONNECTED_UNIV_DIFF_LOWDIM ← prove
   r"!s:real^N->bool.
        dimension s <= &(dimindex(:N)) - &2 ==> connected((:real^N) DIFF s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_FULL_CONVEX_DIFF_LOWDIM THEN
    ASM_REWRITE_TAC [CONVEX_UNIV, INTERIOR_UNIV, UNIV_NOT_EMPTY])

  let CONNECTED_FULL_REGULAR_DIFF_LOWDIM ← (do
    let lemma ← prove
     r"!s t:real^N->bool.
          open s /\ interior t = {} ==> s SUBSET closure(s DIFF t)"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s SUBSET t <=> s INTER t = s")] THEN
      W (MP_TAC o PART_MATCH (rand o rand) OPEN_INTER_CLOSURE_EQ o
        lhand o snd) THEN
      ASM_REWRITE_TAC [CLOSURE_COMPLEMENT] THEN SET_TAC [])
    prove
     r"!s:real^N->bool t.
        s SUBSET closure(interior s) /\
        connected(interior s) /\
        dimension t <= &(dimindex(:N)) - &2
        ==> connected(s DIFF t)"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"interior s DIFF t:real^N->bool") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_OPEN_DIFF_LOWDIM THEN
        ASM_REWRITE_TAC [OPEN_INTERIOR],
        MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET) THEN SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"closure(interior s):real^N->bool") THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC CLOSURE_MINIMAL THEN REWRITE_TAC [CLOSED_CLOSURE] THEN
        MATCH_MP_TAC lemma THEN REWRITE_TAC [OPEN_INTERIOR] THEN
        MP_TAC (← SPEC (← q r"t:real^N->bool") DIMENSION_NONEMPTY_INTERIOR) THEN
        ASM_CASES_TAC (← q r"interior t:real^N->bool = {}") THEN
        ASM_REWRITE_TAC [] THEN ASM_INT_ARITH_TAC]))

  pure { CONNECTED_OPEN_IN_CONVEX_DIFF_LOWDIM, CONNECTED_CONVEX_DIFF_LOWDIM,
         CONNECTED_OPEN_IN_DIFF_LOWDIM, CONNECTED_OPEN_DIFF_LOWDIM,
         CONNECTED_FULL_CONVEX_DIFF_LOWDIM, CONNECTED_UNIV_DIFF_LOWDIM,
         CONNECTED_FULL_REGULAR_DIFF_LOWDIM }

/- ------------------------------------------------------------------------- -/
/- Absolute retracts (AR), absolute neighbourhood retracts (ANR) and         -/
/- Euclidean neighbourhood retracts (ENR); the usual properties of ARs and   -/
/- ANRs.  (degree.ml 2614-3170)                                              -/
/- ------------------------------------------------------------------------- -/

structure DGF where
  AR : thm
  ANR : thm
  ENR : thm
  AR_IMP_ABSOLUTE_EXTENSOR : thm
  AR_IMP_ABSOLUTE_RETRACT : thm
  AR_IMP_ABSOLUTE_RETRACT_UNIV : thm
  ABSOLUTE_EXTENSOR_IMP_AR : thm
  AR_EQ_ABSOLUTE_EXTENSOR : thm
  AR_IMP_RETRACT : thm
  HOMEOMORPHIC_ARNESS : thm
  AR_TRANSLATION : thm
  AR_LINEAR_IMAGE_EQ : thm
  HOMEOMORPHISM_ARNESS : thm
  ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR : thm
  ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT : thm
  ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_RETRACT_UNIV : thm
  ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR : thm
  ANR_EQ_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR : thm
  ANR_IMP_ABSOLUTE_CLOSED_NEIGHBOURHOOD_RETRACT : thm
  ANR_IMP_ABSOLUTE_CLOSED_NEIGHBOURHOOD_EXTENSOR : thm
  ANR_IMP_NEIGHBOURHOOD_RETRACT : thm
  ANR_IMP_CLOSED_NEIGHBOURHOOD_RETRACT : thm
  HOMEOMORPHIC_ANRNESS : thm
  ANR_TRANSLATION : thm
  ANR_LINEAR_IMAGE_EQ : thm
  HOMEOMORPHISM_ANRNESS : thm
  HOMOTOPIC_ON_NEIGHBOURHOOD_INTO_ANR : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGF [HolBase] (D : DegreeDeps) (BDGB : DGB) : ExceptT String IO DGF := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_IMP_SUBSET, RETRACT_OF_SUBSET, retraction, .. } := BDGB
  let { ARITH_EQ, CONJ_ASSOC, DIMINDEX_1, DIMINDEX_FINITE_SUM, EMPTY_SUBSET, .. } :=
        D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_o,
        IMP_CONJ, INSERT_SUBSET, INT_OF_NUM_ADD, .. } := D.pt.cvx.core2
  let { IN_INSERT, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY,
        NOT_INSERT_EMPTY, PASTECART_IN_PCROSS, .. } := D.pt.cvx.core3
  let { SNDCART_PASTECART, SUBSET, SUBSET_PCROSS, SUBSET_REFL, SUBSET_UNION, .. } :=
        D.pt.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, UNION_ASSOC, UNION_COMM, UNION_SUBSET, .. } := D.pt.cvx.core6
  let { LINEAR_SNDCART, .. } := D.pt.cvx.vec2
  let { VECTOR_SUB_EQ, .. } := D.pt.cvx.vec4
  let { CLOSED_IN_DIFF, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.pt.cvx.met
  let { CLOSED_IN, .. } := D.pt.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, HOMEOMORPHIC_REFL, .. } := D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_OF_SUBSETS,
        LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_IN, TOPSPACE_EUCLIDEAN, UNIT_INTERVAL_NONEMPTY, ..
        } := D.pt.cvx.top5
  let { add_linear_invariants, add_translation_invariants, ASM_MESON_TAC, INT_ARITH,
        MESON_TAC, new_definition, NUM_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { VEC_EQ, .. } := D.pt.qvec
  let { CLOSED_IN_REFL, .. } := D.pt.qtop
  let { AFF_DIM_LE_UNIV, .. } := D.pt.qcvx1
  let { DUGUNDJI, .. } := D.qconvex
  let { CLOSED_IN_EMPTY, CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER, CLOSED_IN_SUBSET_TRANS,
        CLOSED_IN_UNION, .. } := D.qmetric
  let { HOMEOMORPHIC_CLOSED_IN_CONVEX, HOMOTOPIC_WITH_EUCLIDEAN_ALT, .. } := D.qpaths1
  let { PCROSS_UNION, .. } := D.qsession
  let { CLOSED_IN_INSERT, CLOSED_IN_PCROSS_EQ, CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT,
        CONTINUOUS_ON_CASES_LOCAL, .. } := D.qtopology1
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, HOMEOMORPHIC_TRANSLATION_SELF,
        SEPARATION_NORMAL_LOCAL, TUBE_LEMMA_GEN, .. } := D.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let AR ← new_definition
   r"AR(s:real^N->bool) <=>
        !u s':real^(N,1)finite_sum->bool.
                s homeomorphic s' /\ closed_in (subtopology euclidean u) s'
                ==> s' retract_of u"

  let ANR ← new_definition
   r"ANR(s:real^N->bool) <=>
        !u s':real^(N,1)finite_sum->bool.
                s homeomorphic s' /\ closed_in (subtopology euclidean u) s'
                ==> ?t. open_in (subtopology euclidean u) t /\
                        s' retract_of t"

  let ENR ← new_definition
   r"ENR s <=> ?u. open u /\ s retract_of u"

  /- ----------------------------------------------------------------------- -/
  /- First, show that we do indeed get the "usual" properties of ARs and     -/
  /- ANRs.                                                                   -/
  /- ----------------------------------------------------------------------- -/

  let AR_IMP_ABSOLUTE_EXTENSOR ← prove
   r"!f:real^M->real^N u t s.
        AR s /\ f continuous_on t /\ IMAGE f t SUBSET s /\
        closed_in (subtopology euclidean u) t
        ==> ?g. g continuous_on u /\ IMAGE g u SUBSET s /\
                !x. x IN t ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?c s':real^(N,1)finite_sum->bool.
          convex c /\ ~(c = {}) /\ closed_in (subtopology euclidean c) s' /\
          (s:real^N->bool) homeomorphic s'")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_CLOSED_IN_CONVEX THEN
      REWRITE_TAC [DIMINDEX_FINITE_SUM, DIMINDEX_1, ← GSYM INT_OF_NUM_ADD] THEN
      REWRITE_TAC [← INT_ARITH (← q r"x:int < y + &1 <=> x <= y"), AFF_DIM_LE_UNIV],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [AR]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"c:real^(N,1)finite_sum->bool", ← q r"s':real^(N,1)finite_sum->bool"]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
    REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"g:real^N->real^(N,1)finite_sum", ← q r"h:real^(N,1)finite_sum->real^N"] THEN
    STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"(g:real^N->real^(N,1)finite_sum) o (f:real^M->real^N)",
      ← q r"c:real^(N,1)finite_sum->bool", ← q r"u:real^M->bool", ← q r"t:real^M->bool"]
          DUGUNDJI) THEN
    ASM_REWRITE_TAC [IMAGE_o, o_THM] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f':real^M->real^(N,1)finite_sum")
      STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^(N,1)finite_sum->real^(N,1)finite_sum") THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(h:real^(N,1)finite_sum->real^N) o r o
                (f':real^M->real^(N,1)finite_sum)") THEN
    ASM_REWRITE_TAC [IMAGE_o, o_THM] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [])

  let AR_IMP_ABSOLUTE_RETRACT ← prove
   r"!s:real^N->bool u s':real^M->bool.
        AR s /\ s homeomorphic s' /\ closed_in (subtopology euclidean u) s'
        ==> s' retract_of u"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
    REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^N->real^M", ← q r"h:real^M->real^N"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"h:real^M->real^N", ← q r"u:real^M->bool", ← q r"s':real^M->bool",
                      ← q r"s:real^N->bool"] AR_IMP_ABSOLUTE_EXTENSOR) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h':real^M->real^N") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [retract_of, retraction] THEN
    EXISTS_TAC (← q r"(g:real^N->real^M) o (h':real^M->real^N)") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    ASM_SIMP_TAC [o_THM, IMAGE_o] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [])

  let AR_IMP_ABSOLUTE_RETRACT_UNIV ← prove
   r"!s:real^N->bool s':real^M->bool.
    AR s /\ s homeomorphic s' /\ closed s' ==> s' retract_of (:real^M)"
   (MESON_TAC [AR_IMP_ABSOLUTE_RETRACT,
               TOPSPACE_EUCLIDEAN, SUBTOPOLOGY_UNIV, OPEN_IN, CLOSED_IN])

  let ABSOLUTE_EXTENSOR_IMP_AR ← prove
   r"!s:real^N->bool.
        (!f:real^(N,1)finite_sum->real^N u t.
             f continuous_on t /\ IMAGE f t SUBSET s /\
             closed_in (subtopology euclidean u) t
             ==> ?g. g continuous_on u /\ IMAGE g u SUBSET s /\
                     !x. x IN t ==> g x = f x)
        ==> AR s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [AR] THEN MAP_EVERY X_GEN_TAC
     [← q r"u:real^(N,1)finite_sum->bool", ← q r"t:real^(N,1)finite_sum->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [homeomorphic]) THEN
    REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"g:real^N->real^(N,1)finite_sum", ← q r"h:real^(N,1)finite_sum->real^N"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o ISPECL
      [← q r"h:real^(N,1)finite_sum->real^N",
       ← q r"u:real^(N,1)finite_sum->bool", ← q r"t:real^(N,1)finite_sum->bool"]) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN DISCH_THEN (X_CHOOSE_THEN
      (← q r"h':real^(N,1)finite_sum->real^N") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [retract_of, retraction] THEN
    EXISTS_TAC (← q r"(g:real^N->real^(N,1)finite_sum) o
                (h':real^(N,1)finite_sum->real^N)") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    ASM_SIMP_TAC [o_THM, IMAGE_o] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [])

  let AR_EQ_ABSOLUTE_EXTENSOR ← prove
   r"!s:real^N->bool.
        AR s <=>
        (!f:real^(N,1)finite_sum->real^N u t.
             f continuous_on t /\ IMAGE f t SUBSET s /\
             closed_in (subtopology euclidean u) t
             ==> ?g. g continuous_on u /\ IMAGE g u SUBSET s /\
                     !x. x IN t ==> g x = f x)"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [AR_IMP_ABSOLUTE_EXTENSOR, ABSOLUTE_EXTENSOR_IMP_AR])

  let AR_IMP_RETRACT ← prove
   r"!s u:real^N->bool.
        AR s /\ closed_in (subtopology euclidean u) s ==> s retract_of u"
   (MESON_TAC [AR_IMP_ABSOLUTE_RETRACT, HOMEOMORPHIC_REFL])

  let HOMEOMORPHIC_ARNESS ← (do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool.
      s homeomorphic t /\ AR t ==> AR s"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [AR] THEN
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        AR_IMP_ABSOLUTE_RETRACT)) THEN
      ASM_REWRITE_TAC [] THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"s:real^M->bool") THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SYM])
    prove
     r"!s:real^M->bool t:real^N->bool.
      s homeomorphic t ==> (AR s <=> AR t)"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN POP_ASSUM MP_TAC THENL
       [ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM], ALL_TAC] THEN
      ASM_MESON_TAC [lemma]))

  let AR_TRANSLATION ← prove
   r"!a:real^N s. AR(IMAGE (\x. a + x) s) <=> AR s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_ARNESS THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  add_translation_invariants [AR_TRANSLATION]

  let AR_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (AR(IMAGE f s) <=> AR s)"
