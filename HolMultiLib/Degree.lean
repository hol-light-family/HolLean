  BROUWER_DEGREE_ID : thm
  BROUWER_DEGREE_COMPOSE : thm
  BROUWER_DEGREE_HOMOTOPIC : thm
  BROUWER_DEGREE_CONST : thm
  BROUWER_DEGREE_REFLECT_ALONG : thm
  BROUWER_DEGREE_NONSURJECTIVE : thm
