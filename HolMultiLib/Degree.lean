@[nospecialize]
def setupDGL [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGJ : DGJ) (BDGK : DGK) : ExceptT String IO DGL := do
  -- @@SCOPE BEGIN
  let { CLOSED_IN_RETRACT, retract_of, RETRACT_OF_IMP_SUBSET, RETRACT_OF_LOCALLY_CONNECTED,
        RETRACT_OF_LOCALLY_PATH_CONNECTED, RETRACT_OF_PATH_CONNECTED, RETRACT_OF_REFL,
        RETRACT_OF_SUBSET, RETRACT_OF_TRANS, retraction, .. } := BDGB
  let { ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR, AR_IMP_ABSOLUTE_RETRACT, ENR, .. } := BDGF
  let { AR_RETRACT_OF_AR, ENR_ANR, ENR_IMP_ANR, HOMEOMORPHIC_ENRNESS, RETRACT_OF_UNIV, .. }
        := BDGG
  let { ANR_IMP_LOCALLY_CONNECTED, ANR_OPEN_IN, CONVEX_IMP_AR, COUNTABLE_ANR_COMPONENTS,
        COUNTABLE_ANR_CONNECTED_COMPONENTS, COUNTABLE_ANR_PATH_COMPONENTS, ENR_EMPTY,
        ENR_IMP_LOCALLY_CONNECTED, ENR_OPEN_IN, ENR_SING, ENR_UNIV, IS_INTERVAL_IMP_ENR, ..
        } := BDGH
  let { ANR_FINITE_UNIONS_CONVEX_CLOSED, ANR_FROM_UNION_AND_INTER_LOCAL,
        AR_FROM_UNION_AND_INTER, ENR_CLOSED_UNION, FINITE_IMP_ANR, .. } := BDGJ
  let { ANR_OPEN_UNIONS, ENR_OPEN_UNIONS, .. } := BDGK
  let { ETA_AX, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DELETE,
        IN_DIFF, INTER_COMM, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        MONO_FORALL, NOT_FORALL_THM, NOT_IMP, REAL_DIV_RMUL, .. } := D.pt.cvx.core3
  let { REAL_ENTIRE, REAL_INV_LT_1, REAL_LE_MUL, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, .. } := D.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_NOT_LE, REAL_SUB_0, REAL_SUB_LE, REAL_SUB_REFL,
        RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_UNION, .. } :=
        D.pt.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, SWAP_EXISTS_THM, SWAP_FORALL_THM, UNIV_NOT_EMPTY,
        UNWIND_THM2, .. } := D.pt.cvx.core6
  let { HULL_SUBSET, .. } := D.pt.cvx.misc
  let { VECTOR_ADD_LID, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_SUB_EQ,
        VECTOR_SUB_REFL, .. } := D.pt.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.pt.cvx.met
  let { BOUNDED_BALL, BOUNDED_CBALL, BOUNDED_SUBSET_BALL, CENTRE_IN_BALL, CLOSED_CLOSURE,
        CLOSED_IMP_LOCALLY_COMPACT, CLOSED_IN, CLOSED_IN_CLOSED, CLOSED_SING, CLOSED_SUBSET,
        CLOSED_UNIV, CLOSEST_POINT_IN_SET, CLOSEST_POINT_SELF, CLOSURE_CLOSED, .. } :=
        D.pt.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_COMPONENTS, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        COMPACT_INTERVAL, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, CONTINUOUS_OPEN_IN_PREIMAGE_GEN,
        FRONTIER_CBALL, FRONTIER_CLOSED, HOMEOMORPHIC_EMPTY, .. } := D.pt.cvx.top3
  let { HOMEOMORPHIC_SYM, IN_COMPONENTS_NONEMPTY, IN_SEGMENT, INTERIOR_CBALL,
        INTERIOR_SUBSET, OPEN_BALL, .. } := D.pt.cvx.top4
  let { OPEN_IN, OPEN_IN_OPEN, OPEN_IN_REFL, OPEN_INTER, OPEN_UNIV, segment,
        UNIONS_COMPONENTS, .. } := D.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.pt.cvx
  let { BOUNDED_INTER, CLOSED_UNIONS, COMPACT_TRANSLATION_EQ, OPEN_IN_DELETE, .. } :=
        D.pt.qtop
  let { AFF_DIM_AFFINE_HULL, AFFINE_AFFINE_HULL, AFFINE_HULL_EQ_EMPTY, AFFINE_IMP_CONVEX,
        CLOSED_AFFINE_HULL, CLOSURE_SUBSET_AFFINE_HULL, .. } := D.pt.qcvx1
  let { CONVEX_CBALL, .. } := D.pt.qcvx2
  let { convex, CONVEX_UNIV, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT, relative_frontier,
        RELATIVE_FRONTIER_NONEMPTY_INTERIOR, RELATIVE_INTERIOR_EQ_EMPTY,
        RELATIVE_INTERIOR_SUBSET, .. } := D.pt.qcvx3
  let { AFFINE_HULL_NONEMPTY_INTERIOR, AFFINE_IMP_SUBSPACE, AFFINE_TRANSLATION,
        CLOSEST_POINT_IN_RELATIVE_FRONTIER, COMPACT_RELATIVE_FRONTIER_BOUNDED,
        CONTINUOUS_ON_CLOSEST_POINT, CONTINUOUS_ON_COMPACT_SURFACE_PROJECTION,
        CONVEX_INTERVAL, DUGUNDJI, RAY_TO_RELATIVE_FRONTIER, RELATIVE_FRONTIER_EMPTY,
        RELATIVE_FRONTIER_TRANSLATION, RELATIVE_INTERIOR_NONEMPTY_INTERIOR,
        SUBSPACE_IMP_CONIC, TIETZE_UNBOUNDED, .. } := D.qconvex
  let { CLOSED_IN_IMP_SUBSET, .. } := D.qmetric
  let { ARC_SIMPLE_PATH, CONVEX_IMP_LOCALLY_PATH_CONNECTED, FINITE_SPHERE,
        HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE, HOMOTOPIC_WITH_LINEAR, .. } := D.qpaths1
  let { arc, LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, OPEN_IMP_LOCALLY_CONNECTED,
        OPEN_IMP_LOCALLY_PATH_CONNECTED, OPEN_IN_COMPONENTS_LOCALLY_CONNECTED,
        OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED,
        OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, path, PATH_CONNECTED_EMPTY,
        PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_PUNCTURED_CONVEX, path_image,
        PATH_IMAGE_NONEMPTY, SURA_BURA_CLOPEN_SUBSET, .. } := D.qpaths2
  let { SIMPLEX_IMP_CLOSED, SIMPLEX_IMP_CONVEX, SIMPLICIAL_COMPLEX_IMP_TRIANGULATION,
        triangulation, .. } := D.qpolytope
  let { BAIRE1_INDICATOR, CLOSED_IMP_FSIGMA, CLOSED_IMP_GDELTA, CLOSED_IN_COMPONENT,
        CLOSEST_POINT_IN_FRONTIER, EXTENSION_FROM_CLOPEN, .. } := D.qtopology1
  let { FINITE_IMP_CLOSED, FRONTIER_CLOSURES, FSIGMA_INTER, GDELTA_INTER,
        HOMEOMORPHIC_COMPACT, HOMEOMORPHIC_COMPACTNESS, IN_COMPONENTS,
        LOCALLY_COMPACT_CLOSED_IN, LOCALLY_EMPTY, LOCALLY_OPEN_SUBSET, OPEN_DELETE,
        OPEN_EMPTY, OPEN_IMP_FSIGMA, OPEN_IMP_GDELTA, .. } := D.qtopology2
  -- @@SCOPE END

  let ENR_BOUNDED ← prove
   r"!s:real^N->bool.
        bounded s
        ==> (ENR s <=> ?u. open u /\ bounded u /\ s retract_of u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [ENR] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ball(vec 0:real^N,r) INTER u") THEN
    ASM_SIMP_TAC [BOUNDED_INTER, OPEN_INTER, OPEN_BALL, BOUNDED_BALL] THEN
    MATCH_MP_TAC RETRACT_OF_SUBSET THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP RETRACT_OF_IMP_SUBSET) THEN
    ASM SET_TAC [])

  let ABSOLUTE_RETRACT_IMP_AR_GEN ← prove
   r"!s:real^M->bool s':real^N->bool t u.
      s retract_of t /\ convex t /\ ~(t = {}) /\
      s homeomorphic s' /\ closed_in (subtopology euclidean u) s'
      ==> s' retract_of u"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"t:real^M->bool"]
      AR_RETRACT_OF_AR) THEN ASM_SIMP_TAC [CONVEX_IMP_AR] THEN
    ASM_MESON_TAC [AR_IMP_ABSOLUTE_RETRACT])

  let ABSOLUTE_RETRACT_IMP_AR ← prove
   r"!s s'. s retract_of (:real^M) /\ s homeomorphic s' /\ closed s'
          ==> s' retract_of (:real^N)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTE_RETRACT_IMP_AR_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^M->bool", ← q r"(:real^M)"] THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN] THEN
    REWRITE_TAC [CONVEX_UNIV, CLOSED_UNIV, UNIV_NOT_EMPTY])

  let HOMEOMORPHIC_COMPACT_ARNESS ← prove
   r"!s s'. s homeomorphic s'
          ==> (compact s /\ s retract_of (:real^M) <=>
               compact s' /\ s' retract_of (:real^N))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"compact(s:real^M->bool) /\ compact(s':real^N->bool)") THENL
     [ALL_TAC, ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS]] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] ABSOLUTE_RETRACT_IMP_AR) THEN
    ASM_MESON_TAC [HOMEOMORPHIC_SYM, COMPACT_IMP_CLOSED])

  let EXTENSION_INTO_AR_LOCAL ← prove
   r"!f:real^M->real^N c s t.
        f continuous_on c /\ IMAGE f c SUBSET t /\ t retract_of (:real^N) /\
        closed_in (subtopology euclidean s) c
        ==> ?g. g continuous_on s /\ IMAGE g (:real^M) SUBSET t /\
                !x. x IN c ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"c:real^M->bool"]
          TIETZE_UNBOUNDED) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^M->real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(r:real^N->real^N) o (g:real^M->real^N)") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      REWRITE_TAC [o_THM] THEN ASM SET_TAC []])

  let EXTENSION_INTO_AR ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ t retract_of (:real^N) /\
        closed s
        ==> ?g. g continuous_on (:real^M) /\ IMAGE g (:real^M) SUBSET t /\
                !x. x IN s ==> g x = f x"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"(:real^M)", ← q r"t:real^N->bool"]
     EXTENSION_INTO_AR_LOCAL) THEN
    REWRITE_TAC [← GSYM OPEN_IN, ← GSYM CLOSED_IN, SUBTOPOLOGY_UNIV])

  let NEIGHBOURHOOD_EXTENSION_INTO_ANR ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ ANR t /\ closed s
        ==> ?v g. s SUBSET v /\ open v /\ g continuous_on v /\
                  IMAGE g v SUBSET t /\ !x. x IN s ==> g x = f x"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
     ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
    REWRITE_TAC [← GSYM OPEN_IN, ← GSYM CLOSED_IN, SUBTOPOLOGY_UNIV] THEN
    CONV_TAC (fun t => TAUT t))

  let EXTENSION_FROM_COMPONENT ← prove
   r"!f:real^M->real^N s c u.
        (locally connected s \/ compact s /\ ANR u) /\
        c IN components s /\
        f continuous_on c /\ IMAGE f c SUBSET u
        ==> ?g. g continuous_on s /\ IMAGE g s SUBSET u /\
                !x. x IN c ==> g x = f x"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?t g. open_in (subtopology euclidean s) t /\
            closed_in (subtopology euclidean s) t /\
            c SUBSET t /\
            (g:real^M->real^N) continuous_on t /\ IMAGE g t SUBSET u /\
            !x. x IN c ==> g x = f x")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (DISJ_CASES_THEN STRIP_ASSUME_TAC) THENL
       [MAP_EVERY EXISTS_TAC [← q r"c:real^M->bool", ← q r"f:real^M->real^N"] THEN
        ASM_SIMP_TAC [SUBSET_REFL, CLOSED_IN_COMPONENT,
                      OPEN_IN_COMPONENTS_LOCALLY_CONNECTED],
        MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"c:real^M->bool",
                          ← q r"u:real^N->bool"]
         ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR) THEN
        ASM_SIMP_TAC [CLOSED_IN_COMPONENT, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"w:real^M->bool", ← q r"g:real^M->real^N"] THEN
        STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [OPEN_IN_OPEN]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^M->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
        MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"c:real^M->bool", ← q r"v:real^M->bool"]
          SURA_BURA_CLOPEN_SUBSET) THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_LOCALLY_COMPACT] THEN
        ANTS_TAC THENL
         [CONJ_TAC THENL [ASM_MESON_TAC [COMPACT_COMPONENTS], ASM SET_TAC []],
          MATCH_MP_TAC MONO_EXISTS] THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN
