    ASM_SIMP_TAC [IMAGE_SUBSET, FORALL_IN_IMAGE] THEN REPEAT CONJ_TAC THENL
     [REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
