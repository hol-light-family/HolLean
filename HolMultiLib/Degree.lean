@[nospecialize]
def setupDGJ [HolBase] (D : DegreeDeps) (BDGB : DGB) (BDGF : DGF) (BDGG : DGG) (BDGH : DGH) (BDGI : DGI) : ExceptT String IO DGJ := do
  -- @@SCOPE BEGIN
  let { retract_of, RETRACT_OF_IMP_SUBSET, RETRACT_OF_REFL, RETRACT_OF_SUBSET,
        RETRACT_OF_TRANS, retraction, .. } := BDGB
  let { ABSOLUTE_NEIGHBOURHOOD_EXTENSOR_IMP_ANR, ANR_IMP_ABSOLUTE_NEIGHBOURHOOD_EXTENSOR,
        ANR_IMP_NEIGHBOURHOOD_RETRACT, AR_IMP_RETRACT, .. } := BDGF
  let { AR_RETRACT_OF_AR, ENR_ANR, RETRACT_OF_UNIV, .. } := BDGG
  let { ANR_EMPTY, ANR_IMP_LOCALLY_CONNECTED, ANR_IMP_LOCALLY_PATH_CONNECTED,
        ANR_NEIGHBORHOOD_RETRACT, ANR_OPEN_IN, ANR_SING, AR_CLOSED_UNION_LOCAL,
        CONVEX_IMP_ANR, .. } := BDGH
  let { ANR_UNION_EXTENSION_LEMMA, .. } := BDGI
  let { CARD_CLAUSES, CONJ_ASSOC, FINITE_IMAGE, FINITE_INDUCT_STRONG, FORALL_IN_GSPEC, .. }
        := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_COMM,
        INTER_SUBSET, INTER_UNIONS, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
        D.pt.cvx.core3
  let { REAL_LE_TOTAL, .. } := D.pt.cvx.core4
  let { REAL_NOT_LT, REAL_SUB_LE, SIMPLE_IMAGE, SUBSET, SUBSET_UNION, .. } := D.pt.cvx.core5
  let { real_ge, SWAP_EXISTS_THM, UNION_COMM, UNION_SUBSET, UNIONS_0, UNIONS_GSPEC,
        UNIONS_INSERT, .. } := D.pt.cvx.core6
  let { LIFT_DROP, LIFT_SUB, .. } := D.pt.cvx.vec2
  let { drop, .. } := D.pt.cvx.vec4
  let { CLOSED_IN_TRANS, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.pt.cvx.met
  let { CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_IN_CLOSED, CLOSED_INTER, CLOSED_SING,
