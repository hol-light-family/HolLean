         (← q r"(!x. x IN i DELETE z ==> g x IN c)
          ==> g z = p ==> IMAGE g i DELETE p SUBSET c"))) THEN
        ASM_MESON_TAC [pathfinish]]])

  pure { FINITE_ANR_COMPLEMENT_COMPONENTS_CONCENTRIC,
         ACCESSIBLE_FRONTIER_ANR_INTER_COMPLEMENT_COMPONENT,
         ACCESSIBLE_FRONTIER_ANR_COMPLEMENT_COMPONENT }

