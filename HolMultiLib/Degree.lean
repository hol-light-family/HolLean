set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupDGA [HolBase] (D : DegreeDeps) : ExceptT String IO DGA := do
  -- @@SCOPE BEGIN
  let { CONTRAPOS_THM, DIMINDEX_GE_1, EQ_TRANS, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ, IN_DELETE, INTER_UNIV, .. } :=
        D.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, PSUBSET, REAL_ABS_INV, .. } := D.pt.cvx.core3
  let { REAL_INV_1, .. } := D.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_POW_2, REAL_SGN_EQ, SIMPLE_IMAGE, SUBSET, .. } := D.pt.cvx.core5
  let { o_DEF, o_THM, real_gt, .. } := D.pt.cvx.core6
  let { BASIS_COMPONENT, BASIS_NONZERO, .. } := D.pt.cvx.vec1
  let { IN_SPAN_IMAGE_BASIS, LINEAR_INJECTIVE_LEFT_INVERSE, MATRIX_COMPOSE,
        MATRIX_MUL_ASSOC, MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_ASSOC,
        MATRIX_VECTOR_MUL_LINEAR, MATRIX_WORKS, NORM_0, NORM_EQ_0, .. } := D.pt.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, SPAN_STDBASIS, .. } := D.pt.cvx.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_SUB_COMPONENT, ..
        } := D.pt.cvx.vec4
  let { DET_I, DET_MATRIX_REFLECT_ALONG, DET_MUL, DET_ORTHOGONAL_MATRIX,
        ORTHOGONAL_MATRIX_MATRIX, ORTHOGONAL_TRANSFORMATION,
        ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG, REFLECT_ALONG_BASIS_COMPONENT, .. } :=
        D.pt.cvx.det
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM, CONTINUOUS_ON_MUL, ..
        } := D.pt.cvx.top3
  let { IN_SEGMENT, IN_SPHERE_0, .. } := D.pt.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { ASM_ARITH_TAC, ASM_MESON_TAC, new_definition, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        REAL_RING, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { PSUBSET_ALT, .. } := D.pt.qses
  let { HOMOGENEOUS_LINEAR_EQUATIONS_DET, INVERTIBLE_DET_NZ, NORM_REFLECT_ALONG,
        ORTHOGONAL_MATRIX_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_I,
        POSITIVE_DEFINITE_IMP_INVERTIBLE, reflect_along, .. } := D.qdet
  let { BROUWER_DEGREE2_COMPOSE, BROUWER_DEGREE2_CONST, BROUWER_DEGREE2_EQ,
        BROUWER_DEGREE2_HOMOTOPIC, BROUWER_DEGREE2_ID, BROUWER_DEGREE2_NONSURJECTIVE,
        BROUWER_DEGREE2_REFLECTION, .. } := D.qhomology
  let { continuous_map, CONTINUOUS_MAP_COMPOSE, homeomorphic_maps,
        HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT,
        HOMOTOPIC_WITH_EQ, HOMOTOPIC_WITH_REFL, NSPHERE, TOPSPACE_SUBTOPOLOGY, .. } :=
        D.qmetric
  let { HOMOTOPIC_WITH_COMPOSE, HOMOTOPIC_WITH_IMP_SUBSET,
        HOMOTOPIC_WITH_LINEAR_POSITIVE_DEFINITE_MAPS, HOMOTOPIC_WITH_MONO,
        HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS,
        HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_ALT, .. } := D.qpaths1
  let { HOMOTOPIC_WITH_REFLECTIONS_ALONG, HOMOTOPIC_WITH_RESTRICT, .. } := D.qpaths2
  let { I_DEF, int_eq, INT_MUL_LID, INT_NEG_0, int_neg_th, int_of_num_th, REAL_LT_POW_2,
        REAL_SGN_INEQS, REAL_SGN_MUL, SUB_ADD, .. } := D.qsession
  let { CONTINUOUS_MAP_EUCLIDEAN2, DET_POSITIVE_DEFINITE, .. } := D.qtopology1
  let { HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE, LEFT_POLAR_DECOMPOSITION_INVERTIBLE,
        POSITIVE_DEFINITE_INV, .. } := D.qtopology2
  let { LINEAR_INJECTIVE_0, LINEAR_INVERSE_LEFT, MATRIX_I, MATRIX_INV, MATRIX_INVERTIBLE,
        MATRIX_MUL_LID, .. } := D.qvec
  -- @@SCOPE END

  D.prioritize_real

  let brouwer_degree1 ← new_definition
   r"brouwer_degree1 n (f:real^N->real^N) =
        if 1 <= n /\ n <= dimindex(:N)
        then brouwer_degree2 (n - 1)
              ((\x i. if 1 <= i /\ i <= n then x$i else &0) o
               f o
               (\x. lambda i. if 1 <= i /\ i <= n then x i else &0))
        else &1"

  let brouwer_degree ← new_definition
   r"brouwer_degree (f:real^N->real^N) = brouwer_degree1 (dimindex(:N)) f"

  let BROUWER_DEGREE1_EQ ← prove
   r"!n f g:real^N->real^N.
        (!x. x IN sphere(vec 0,&1) INTER span(IMAGE basis (1..n))
             ==> f x = g x)
        ==> brouwer_degree1 n f = brouwer_degree1 n g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree1] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"h:(num->real)->real^N =
        \x. lambda i. if 1 <= i /\ i <= n then x i else &0",
      ← q r"h':real^N->num->real = \x i. if 1 <= i /\ i <= n then x$i else &0"] THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    MATCH_MP_TAC BROUWER_DEGREE2_EQ THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [continuous_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY]) THEN
    ASM SET_TAC [])

  let BROUWER_DEGREE1_ID ← prove
   r"!n. brouwer_degree1 n (\x:real^N. x) = &1"
   (GEN_TAC THEN REWRITE_TAC [brouwer_degree1] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"h:(num->real)->real^N =
        \x. lambda i. if 1 <= i /\ i <= n then x i else &0",
      ← q r"h':real^N->num->real = \x i. if 1 <= i /\ i <= n then x$i else &0"] THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    SUBST1_TAC (← SYM (← SPEC (← q r"n - 1") BROUWER_DEGREE2_ID)) THEN
    MATCH_MP_TAC BROUWER_DEGREE2_EQ THEN ASM_SIMP_TAC [o_THM])

  let BROUWER_DEGREE1_COMPOSE ← prove
   r"!n f g:real^N->real^N.
        f continuous_on (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) /\
        g continuous_on (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) /\
        IMAGE f (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) SUBSET
                (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) /\
        IMAGE g (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) SUBSET
                (sphere(vec 0,&1) INTER span(IMAGE basis (1..n)))
        ==> brouwer_degree1 n (g o f) =
            brouwer_degree1 n g * brouwer_degree1 n f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree1] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [INT_MUL_LID] THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"h:(num->real)->real^N =
        \x. lambda i. if 1 <= i /\ i <= n then x i else &0",
      ← q r"h':real^N->num->real = \x i. if 1 <= i /\ i <= n then x$i else &0"] THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand)
      BROUWER_DEGREE2_COMPOSE o rand o snd) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EUCLIDEAN2],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC BROUWER_DEGREE2_EQ THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN AP_TERM_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [continuous_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY]) THEN
    ASM SET_TAC [])

  let BROUWER_DEGREE1_HOMOTOPIC ← prove
   r"!n f g:real^N->real^N.
     homotopic_with (\x. T)
      (subtopology euclidean (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))),
       subtopology euclidean (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))))
      f g
     ==> brouwer_degree1 n f = brouwer_degree1 n g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree1] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"h:(num->real)->real^N =
        \x. lambda i. if 1 <= i /\ i <= n then x i else &0",
      ← q r"h':real^N->num->real = \x i. if 1 <= i /\ i <= n then x$i else &0"] THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    MATCH_MP_TAC BROUWER_DEGREE2_HOMOTOPIC THEN
    ASM_MESON_TAC [HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT,
                   HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT])

  let BROUWER_DEGREE1_CONST ← prove
   r"!n a:real^N.
      1 <= n /\ n <= dimindex(:N) ==> brouwer_degree1 n (\x. a) = &0"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [brouwer_degree1, o_DEF, BROUWER_DEGREE2_CONST])

  let BROUWER_DEGREE1_REFLECT_ALONG ← prove
   r"!n a:real^N.
        1 <= n /\ n <= dimindex(:N) /\
        a IN span(IMAGE basis (1..n)) DELETE vec 0
        ==> brouwer_degree1 n (reflect_along a) = -- &1"
   (REWRITE_TAC [IN_DELETE, IN_SPAN_IMAGE_BASIS] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS
     (← q r"brouwer_degree1 n (reflect_along (basis 1:real^N))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC BROUWER_DEGREE1_HOMOTOPIC THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_REFLECTIONS_ALONG THEN
      ASM_SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTER] THEN
      ASM_REWRITE_TAC [IN_SPHERE_0, NORM_REFLECT_ALONG, IN_SPAN_IMAGE_BASIS] THEN
      SIMP_TAC [IN_SEGMENT, LEFT_IMP_EXISTS_THM] THEN
      ASM_SIMP_TAC [reflect_along, VECTOR_SUB_COMPONENT, VECTOR_MUL_COMPONENT,
                    VECTOR_ADD_COMPONENT] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN GEN_TAC THEN STRIP_TAC THEN
      SIMP_TAC [IN_NUMSEG, IMP_CONJ] THEN X_GEN_TAC (← q r"j:num") THEN
      ASM_CASES_TAC (← q r"j = 1") THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [BASIS_COMPONENT] THEN REAL_ARITH_TAC,
      SUBST1_TAC (← SYM (← SPEC (← q r"n - 1") BROUWER_DEGREE2_REFLECTION)) THEN
      ASM_REWRITE_TAC [brouwer_degree1] THEN
      MATCH_MP_TAC BROUWER_DEGREE2_EQ THEN
      REWRITE_TAC [NSPHERE, TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:num->real") THEN ASM_SIMP_TAC [SUB_ADD, IN_NUMSEG] THEN
      STRIP_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [o_THM] THEN
      ASM_CASES_TAC (← q r"1 <= i /\ i <= n") THEN ASM_REWRITE_TAC [] THENL
       [ALL_TAC, ASM_MESON_TAC [INT_NEG_0, LE_REFL]] THEN
      SUBGOAL_THEN (← q r"i <= dimindex(:N)") MP_TAC THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_SIMP_TAC [REFLECT_ALONG_BASIS_COMPONENT, DIMINDEX_GE_1, LE_REFL,
                    LAMBDA_BETA]])

  let BROUWER_DEGREE1_NONSURJECTIVE ← prove
   r"!n (f:real^N->real^N).
        1 <= n /\ n <= dimindex(:N) /\
        f continuous_on (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) /\
        IMAGE f (sphere(vec 0,&1) INTER span(IMAGE basis (1..n))) PSUBSET
                (sphere(vec 0,&1) INTER span(IMAGE basis (1..n)))
        ==> brouwer_degree1 n f = &0"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [brouwer_degree1] THEN
    MATCH_MP_TAC BROUWER_DEGREE2_NONSURJECTIVE THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_MAPS_NSPHERE_EUCLIDEAN_SPHERE) THEN
    MAP_EVERY ABBREV_TAC
     [← q r"h:(num->real)->real^N =
        \x. lambda i. if 1 <= i /\ i <= n then x i else &0",
      ← q r"h':real^N->num->real = \x i. if 1 <= i /\ i <= n then x$i else &0"] THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [PSUBSET]) THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EUCLIDEAN2],
      ALL_TAC] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
          GEN_REWRITE_RULE I [PSUBSET_ALT]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!a. a IN t /\ ~(a IN s) ==> ~(s = t)")) THEN
    EXISTS_TAC (← q r"(h':real^N->num->real) a") THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [continuous_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY]) THEN
    ASM_SIMP_TAC [IMAGE_o] THEN ASM SET_TAC [])

  let BROUWER_DEGREE_EQ ← prove
   r"!f g:real^N->real^N.
        (!x. x IN sphere(vec 0,&1) ==> f x = g x)
        ==> brouwer_degree f = brouwer_degree g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_EQ THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS] THEN
    ASM_REWRITE_TAC [IN_INTER, IN_UNIV])

  let BROUWER_DEGREE_ID ← prove
   r"brouwer_degree (\x:real^N. x) = &1"
   (REWRITE_TAC [brouwer_degree, BROUWER_DEGREE1_ID])

  let BROUWER_DEGREE_COMPOSE ← prove
   r"!f g:real^N->real^N.
        f continuous_on sphere(vec 0,&1) /\
        g continuous_on sphere(vec 0,&1) /\
        IMAGE f (sphere(vec 0,&1)) SUBSET sphere(vec 0,&1) /\
        IMAGE g (sphere(vec 0,&1)) SUBSET sphere(vec 0,&1)
        ==> brouwer_degree (g o f) = brouwer_degree g * brouwer_degree f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_COMPOSE THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS, INTER_UNIV] THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE])

  let BROUWER_DEGREE_HOMOTOPIC ← prove
   r"!f g:real^N->real^N.
     homotopic_with (\x. T)
      (subtopology euclidean (sphere(vec 0,&1)),
       subtopology euclidean (sphere(vec 0,&1)))
      f g
     ==> brouwer_degree f = brouwer_degree g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_HOMOTOPIC THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS, INTER_UNIV] THEN
    ASM_REWRITE_TAC [SIMPLE_IMAGE])

  let BROUWER_DEGREE_CONST ← prove
   r"!a:real^N. brouwer_degree (\x. a) = &0"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_CONST THEN
    REWRITE_TAC [DIMINDEX_GE_1, LE_REFL])

  let BROUWER_DEGREE_REFLECT_ALONG ← prove
   r"!a:real^N. ~(a = vec 0) ==> brouwer_degree (reflect_along a) = -- &1"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_REFLECT_ALONG THEN
    ASM_REWRITE_TAC [DIMINDEX_GE_1, LE_REFL] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS] THEN
    ASM_REWRITE_TAC [IN_UNIV, IN_DELETE])

  let BROUWER_DEGREE_NONSURJECTIVE ← prove
   r"!(f:real^N->real^N).
        f continuous_on sphere(vec 0,&1) /\
        IMAGE f (sphere(vec 0,&1)) PSUBSET sphere(vec 0,&1)
        ==> brouwer_degree f = &0"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [brouwer_degree] THEN
    MATCH_MP_TAC BROUWER_DEGREE1_NONSURJECTIVE THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_NUMSEG, SPAN_STDBASIS, INTER_UNIV] THEN
    ASM_REWRITE_TAC [DIMINDEX_GE_1, LE_REFL, SIMPLE_IMAGE])

  let BROUWER_DEGREE_ORTHOGONAL_TRANSFORMATION ← prove
   r"!(f:real^N->real^N).
        orthogonal_transformation f
        ==> real_of_int(brouwer_degree f) = det(matrix f)"
   (REPEAT STRIP_TAC THEN MP_TAC
     (← ISPEC (← q r"f:real^N->real^N") HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS) THEN
    FIRST_ASSUM (DISJ_CASES_TAC o
     MATCH_MP DET_ORTHOGONAL_MATRIX o MATCH_MP ORTHOGONAL_MATRIX_MATRIX)
    THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"I:real^N->real^N")),
      DISCH_THEN (MP_TAC o SPEC (← q r"reflect_along(basis 1):real^N->real^N"))] THEN
    ASM_SIMP_TAC [MATRIX_I, DET_I, ORTHOGONAL_TRANSFORMATION_I,
      DET_MATRIX_REFLECT_ALONG, ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG,
      BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"\f:real^N->real^N. T") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_MONO)) THEN
    REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP BROUWER_DEGREE_HOMOTOPIC) THEN
    SIMP_TAC [BROUWER_DEGREE_ID, I_DEF, BROUWER_DEGREE_REFLECT_ALONG,
              BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
    REWRITE_TAC [int_neg_th, int_of_num_th])

  /- ----------------------------------------------------------------------- -/
  /- Hence the key theorem about homotopy of linear maps.                    -/
  /- ----------------------------------------------------------------------- -/

  let HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS ← prove
   r"!f g:real^N->real^N.
        orthogonal_transformation f /\ orthogonal_transformation g
        ==> (homotopic_with (\x. T)
              (subtopology euclidean (sphere (vec 0,&1)),
               subtopology euclidean (sphere (vec 0,&1))) f g <=>
             det(matrix f) = det(matrix g))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [← GSYM BROUWER_DEGREE_ORTHOGONAL_TRANSFORMATION] THEN
      REWRITE_TAC [← GSYM int_eq, BROUWER_DEGREE_HOMOTOPIC],
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_MONO THEN
      EXISTS_TAC (← q r"orthogonal_transformation:(real^N->real^N)->bool") THEN
      ASM_REWRITE_TAC [HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS]])

  let HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_ALT ← prove
   r"!f g:real^N->real^N.
        orthogonal_transformation f /\ orthogonal_transformation g
        ==> (homotopic_with (\x. T)
              (subtopology euclidean ((:real^N) DELETE vec 0),
               subtopology euclidean ((:real^N) DELETE vec 0))
              f g <=>
             det(matrix f) = det(matrix g))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [← GSYM HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS] THEN
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\x. inv(norm x) % x) o (f:real^N->real^N)",
        ← q r"(\x. inv(norm x) % x) o (g:real^N->real^N)"] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [ORTHOGONAL_TRANSFORMATION]) THEN
      ASM_SIMP_TAC [IN_SPHERE_0, o_THM, REAL_INV_1, VECTOR_MUL_LID] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE THEN MAP_EVERY EXISTS_TAC
       [← q r"\f:real^N->real^N. T", ← q r"\f:real^N->real^N. T",
        ← q r"(:real^N) DELETE vec 0"] THEN
      REWRITE_TAC [HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_DELETE, IN_SPHERE_0] THEN
      REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      SIMP_TAC [REAL_MUL_LINV, NORM_EQ_0] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
         HOMOTOPIC_WITH_RESTRICT)) THEN
        REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
        REWRITE_TAC [CONTRAPOS_THM, IN_SPHERE_0, NORM_0] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN MATCH_MP_TAC (← SET_RULE
         (← q r"~(z IN s)
          ==> !f. a IN IMAGE f s ==> a IN IMAGE f (UNIV DELETE z)")) THEN
        REWRITE_TAC [CONTRAPOS_THM, IN_SPHERE_0, NORM_0] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV,
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [o_DEF] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [IN_DELETE, NORM_EQ_0] THEN
        REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_NORM]],
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_MONO THEN
     EXISTS_TAC (← q r"orthogonal_transformation:(real^N->real^N)->bool") THEN
      ASM_REWRITE_TAC [HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_ALT]])

  let HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP ← prove
   r"!f g:real^N->real^N.
        orthogonal_transformation f /\ orthogonal_transformation g /\
        homotopic_with (\x. T)
          (subtopology euclidean (sphere (vec 0,&1)),
           subtopology euclidean (sphere (vec 0,&1))) f g
        ==> det(matrix f) = det(matrix g)"
   (SIMP_TAC [← GSYM HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS])

  let HOMOTOPIC_LINEAR_MAPS_IMP ← (do
    let lemma ← prove
     r"!f:real^N->real^N.
        linear f /\ ~(det(matrix f) = &0)
        ==> ?P. positive_definite P /\
                orthogonal_transformation ((\x. P ** x) o f)"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM INVERTIBLE_DET_NZ]) THEN
      REWRITE_TAC [LEFT_POLAR_DECOMPOSITION_INVERTIBLE, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"U:real^N^N", ← q r"P:real^N^N"] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      EXISTS_TAC (← q r"matrix_inv P:real^N^N") THEN
      ASM_REWRITE_TAC [POSITIVE_DEFINITE_INV, o_DEF] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP MATRIX_WORKS th)])) THEN
      ASM_SIMP_TAC [MATRIX_MUL_ASSOC, MATRIX_VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [MATRIX_INV, POSITIVE_DEFINITE_IMP_INVERTIBLE] THEN
      ASM_SIMP_TAC [MATRIX_MUL_LID, MATRIX_WORKS] THEN
      ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION])
    prove
     r"!f g:real^N->real^N.
     linear f /\ linear g /\
     homotopic_with (\x. T)
       (subtopology euclidean ((:real^N) DELETE vec 0),
        subtopology euclidean ((:real^N) DELETE vec 0)) f g
     ==> real_sgn(det(matrix f)) = real_sgn(det(matrix g))"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
      REWRITE_TAC [← SET_RULE
        (← q r"IMAGE f (UNIV DELETE w) SUBSET UNIV DELETE z <=>
         ~(?x. ~(x = w) /\ f x = z)")] THEN
      ASM_SIMP_TAC [← GSYM MATRIX_WORKS, HOMOGENEOUS_LINEAR_EQUATIONS_DET] THEN
      STRIP_TAC THEN MP_TAC (← ISPEC (← q r"g:real^N->real^N") lemma) THEN
      MP_TAC (← ISPEC (← q r"f:real^N->real^N") lemma) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"P:real^N^N") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"Q:real^N^N") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(\x. (P:real^N^N) ** x) o (f:real^N->real^N)",
        ← q r"(\x. (Q:real^N^N) ** x) o (g:real^N->real^N)"]
       HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_ALT) THEN
      ASM_SIMP_TAC [MATRIX_COMPOSE, MATRIX_VECTOR_MUL_LINEAR] THEN
      REWRITE_TAC [DET_MUL, MATRIX_OF_MATRIX_VECTOR_MUL] THEN
      DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN ANTS_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\f:real^N->real^N. T",
          ← q r"\f:real^N->real^N. linear f /\ positive_definite(matrix f)",
          ← q r"(:real^N) DELETE vec 0"] THEN
        ASM_REWRITE_TAC [HOMOTOPIC_WITH_LINEAR_POSITIVE_DEFINITE_MAPS] THEN
        ASM_REWRITE_TAC [MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_LINEAR],
        DISCH_THEN (MP_TAC o AP_TERM (← q r"real_sgn")) THEN
        REWRITE_TAC [REAL_SGN_MUL] THEN MATCH_MP_TAC (← REAL_RING
         (← q r"x = &1 /\ y = &1 ==> x * a = y * b ==> a = b")) THEN
        ASM_SIMP_TAC [REAL_SGN_EQ, real_gt, DET_POSITIVE_DEFINITE]]))

  let HOMOTOPIC_LINEAR_MAPS_ALT ← prove
   r"!f g:real^N->real^N.
     linear f /\ linear g /\
     homotopic_with (\x. T)
        (subtopology euclidean ((:real^N) DELETE vec 0),
         subtopology euclidean ((:real^N) DELETE vec 0)) f g
     ==> &0 < det(matrix f) * det(matrix g)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_SGN_INEQS] THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"]
        HOMOTOPIC_LINEAR_MAPS_IMP) THEN
    ASM_SIMP_TAC [REAL_SGN_MUL, ← GSYM REAL_POW_2, REAL_LT_POW_2] THEN
    DISCH_TAC THEN REWRITE_TAC [REAL_SGN_INEQS] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE f (UNIV DELETE a) SUBSET UNIV DELETE a
      ==> !x. f x = a ==> x = a"))) THEN
    ASM_SIMP_TAC [← GSYM LINEAR_INJECTIVE_0, MATRIX_INVERTIBLE,
                  ← GSYM INVERTIBLE_DET_NZ] THEN
    ASM_MESON_TAC [LINEAR_INJECTIVE_LEFT_INVERSE, LINEAR_INVERSE_LEFT])

  pure { brouwer_degree1, brouwer_degree, BROUWER_DEGREE1_EQ, BROUWER_DEGREE1_ID,
         BROUWER_DEGREE1_COMPOSE, BROUWER_DEGREE1_HOMOTOPIC, BROUWER_DEGREE1_CONST,
         BROUWER_DEGREE1_REFLECT_ALONG, BROUWER_DEGREE1_NONSURJECTIVE, BROUWER_DEGREE_EQ,
         BROUWER_DEGREE_ID, BROUWER_DEGREE_COMPOSE, BROUWER_DEGREE_HOMOTOPIC,
         BROUWER_DEGREE_CONST, BROUWER_DEGREE_REFLECT_ALONG, BROUWER_DEGREE_NONSURJECTIVE,
         BROUWER_DEGREE_ORTHOGONAL_TRANSFORMATION, HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS,
         HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_ALT, HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP,
         HOMOTOPIC_LINEAR_MAPS_IMP, HOMOTOPIC_LINEAR_MAPS_ALT }

/- ------------------------------------------------------------------------- -/
/- Hairy ball theorem and relatives; retractions.  (degree.ml 406-1103)      -/
/- ------------------------------------------------------------------------- -/

structure DGB where
  FIXPOINT_HOMOTOPIC_IDENTITY_SPHERE : thm
  FIXPOINT_OR_NEG_MAPPING_SPHERE : thm
  HAIRY_BALL_THEOREM_ALT : thm
  HAIRY_BALL_THEOREM : thm
  CONTINUOUS_FUNCTION_HAS_EIGENVALUES_ODD_DIM : thm
  EULER_ROTATION_THEOREM_GEN : thm
  retraction : thm
  retract_of : thm
  RETRACTION_MAPS_EUCLIDEAN : thm
  RETRACT_OF_SPACE_EUCLIDEAN : thm
  RETRACTION : thm
  RETRACT_OF_IMP_EXTENSIBLE : thm
  RETRACTION_IDEMPOTENT : thm
  IDEMPOTENT_IMP_RETRACTION : thm
  RETRACTION_SUBSET : thm
  RETRACT_OF_SUBSET : thm
  RETRACT_OF_TRANSLATION : thm
  RETRACT_OF_TRANSLATION_EQ : thm
  RETRACT_OF_INJECTIVE_LINEAR_IMAGE : thm
  RETRACT_OF_LINEAR_IMAGE_EQ : thm
  RETRACTION_REFL : thm
  RETRACT_OF_REFL : thm
  RETRACTION_CLOSEST_POINT : thm
  RETRACT_OF_IMP_SUBSET : thm
  RETRACT_OF_EMPTY : thm
  RETRACT_OF_SING : thm
  RETRACT_OF_OPEN_UNION : thm
  RETRACT_OF_SEPARATED_UNION : thm
  RETRACT_OF_CLOSED_UNION : thm
  RETRACTION_o : thm
  RETRACT_OF_TRANS : thm
  CLOSED_IN_RETRACT : thm
  RETRACT_OF_CONTRACTIBLE : thm
  RETRACT_OF_COMPACT : thm
  RETRACT_OF_CLOSED : thm
  RETRACT_OF_CONNECTED : thm
  RETRACT_OF_PATH_CONNECTED : thm
  RETRACT_OF_SIMPLY_CONNECTED : thm
  RETRACT_OF_HOMOTOPICALLY_TRIVIAL : thm
  RETRACT_OF_HOMOTOPICALLY_TRIVIAL_NULL : thm
  RETRACT_OF_COHOMOTOPICALLY_TRIVIAL : thm
  RETRACT_OF_COHOMOTOPICALLY_TRIVIAL_NULL : thm
  RETRACTION_IMP_QUOTIENT_MAP_EXPLICIT : thm
  RETRACT_OF_LOCALLY_CONNECTED : thm
  RETRACT_OF_LOCALLY_PATH_CONNECTED : thm
  RETRACT_OF_LOCALLY_COMPACT : thm
  RETRACT_OF_PCROSS : thm
  RETRACT_OF_PCROSS_EQ : thm
  HOMOTOPIC_INTO_RETRACT : thm
  deriving Inhabited

set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupDGB [HolBase] (D : DegreeDeps) (BDGA : DGA) : ExceptT String IO DGB := do
  -- @@SCOPE BEGIN
  let { HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP, .. } := BDGA
  let { AND_FORALL_THM, ARITH, CART_EQ, CONJ_ACI, CONJ_ASSOC, DIMINDEX_GE_1, EMPTY_SUBSET,
        EXISTS_OR_THM, FORALL_IN_GSPEC, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_PCROSS, FORALL_PASTECART,
        FSTCART_PASTECART, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o,
        IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IN_ELIM_PASTECART_THM, .. } := D.pt.cvx.core2
  let { I_THM, IN_SING, LAMBDA_BETA, LE_REFL, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM,
        LEFT_OR_DISTRIB, MEMBER_NOT_EMPTY, MONO_EXISTS, MULT_CLAUSES, NOT_IMP, NOT_IN_EMPTY,
        PASTECART_IN_PCROSS, PCROSS, PCROSS_EMPTY, PCROSS_EQ_EMPTY, REAL_ABS_INV, .. } :=
        D.pt.cvx.core3
  let { REAL_INV_EQ_0, REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_REFL, .. } :=
        D.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_RNEG, REAL_NEG_ADD,
        REAL_NOT_LT, REAL_POW_EQ_0, REAL_POW_ONE, REAL_SUB_REFL, SNDCART_PASTECART, SUBSET,
        SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNION, .. } := D.pt.cvx.core5
  let { o_DEF, o_THM, real_abs, SUM_0, UNION_EMPTY, .. } := D.pt.cvx.core6
  let { BASIS_NONZERO, DOT_EQ_0, .. } := D.pt.cvx.vec1
  let { DROP_EQ, DROP_VEC, LIFT_DROP, LINEAR_FSTCART, LINEAR_INJECTIVE_LEFT_INVERSE,
        LINEAR_SNDCART, MATRIX_ID, MATRIX_OF_MATRIX_VECTOR_MUL, MATRIX_VECTOR_MUL_LINEAR,
        NORM_EQ_0, NORM_EQ_SQUARE, .. } := D.pt.cvx.vec2
  let { NORM_MUL, NORM_NEG, ORTHOGONAL_LNEG, ORTHOGONAL_MUL, ORTHOGONAL_REFL, REAL_ABS_NORM,
        .. } := D.pt.cvx.vec3
  let { dot, linear, orthogonal, VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC,
        VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_MUL_LZERO,
        VECTOR_MUL_RNEG, VECTOR_MUL_RZERO, VECTOR_NEG_NEG, VECTOR_SUB_EQ, .. } :=
        D.pt.cvx.vec4
  let { DET_I, ORTHOGONAL_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_ID, .. } := D.pt.cvx.det
  let { CLOSEST_POINT_IN_SET, CLOSEST_POINT_SELF, .. } := D.pt.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, CONNECTED_CONTINUOUS_IMAGE, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. }
        := D.pt.cvx.top3
  let { IN_SPHERE_0, LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { SPHERE_EMPTY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { add_linear_invariants, add_translation_invariants, ARITH_RULE, ASM_MESON_TAC,
        ASM_REAL_ARITH_TAC, MESON, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, SET_TAC, VECTOR_ARITH, .. } := D.pt.cvx
  let { CONTINUOUS_ON_CLOSEST_POINT, .. } := D.qconvex
  let { DET_NEG, ORTHOGONAL_MATRIX_TRANSFORMATION, ORTHOGONAL_TRANSFORMATION_NEG,
        rotation_matrix, .. } := D.qdet
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, HOMOTOPIC_WITH_TRANS, retract_of_space,
        retraction_maps, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.qmetric
  let { COHOMOTOPICALLY_TRIVIAL_RETRACTION_GEN, COHOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN,
        HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS, HOMOTOPIC_WITH_EUCLIDEAN,
        HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN,
        HOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN, .. } := D.qpaths1
  let { contractible, LOCALLY_CONNECTED_QUOTIENT_IMAGE,
        LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE, PATH_CONNECTED_CONTINUOUS_IMAGE,
        SIMPLY_CONNECTED_RETRACTION_GEN, .. } := D.qpaths2
  let { ADD_CLAUSES, ADD_SUB, EVEN_ADD, EVEN_EXISTS, EVEN_MULT, I_DEF, NOT_ODD,
        PASTECART_FST_SND, REAL_POW_NEG, SUM_OFFSET, SUM_PAIR, .. } := D.qsession
  let { CLOSED_IN_CLOSED_EQ, CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT,
        CONTINUOUS_MAP_EUCLIDEAN, CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_ON_CMUL,
        CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_UNION_LOCAL_OPEN,
        CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP, .. } := D.qtopology1
  let { LOCALLY_COMPACT_CLOSED_IN, SEPARATION_CLOSED_IN_UNION, SEPARATION_OPEN_IN_UNION,
        SPHERE_SCALING, SPHERE_SING, .. } := D.qtopology2
  let { LINEAR_BIJECTIVE_LEFT_RIGHT_INVERSE, LINEAR_COMPOSE_NEG, LINEAR_ID, MATRIX_NEG,
        ORTHOGONAL_0, .. } := D.qvec
  -- @@SCOPE END

  let FIXPOINT_HOMOTOPIC_IDENTITY_SPHERE ← prove
   r"!f:real^N->real^N.
        ODD(dimindex(:N)) /\
        homotopic_with (\x. T)
         (subtopology euclidean (sphere(vec 0,&1)),
          subtopology euclidean (sphere(vec 0,&1))) (\x. x) f
        ==> ?x. x IN sphere(vec 0,&1) /\ f x = x"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^N", ← q r"\x:real^N. --x",
                      ← q r"sphere(vec 0:real^N,&1)", ← q r"&1"]
          HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [CONTINUOUS_ON_NEG, CONTINUOUS_ON_ID],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0, NORM_NEG],
      ASM_MESON_TAC [VECTOR_NEG_NEG],
      DISCH_THEN (MP_TAC o SPEC (← q r"\x:real^N. x") o
       MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          HOMOTOPIC_WITH_TRANS)) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
       (← REWRITE_RULE [CONJ_ASSOC]
          HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP))) THEN
      SIMP_TAC [ORTHOGONAL_TRANSFORMATION_NEG, ORTHOGONAL_TRANSFORMATION_ID,
                MATRIX_NEG, LINEAR_ID, DET_NEG, MATRIX_ID, DET_I] THEN
      ASM_REWRITE_TAC [REAL_POW_NEG, REAL_POW_ONE, ← GSYM NOT_ODD] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV])

  let FIXPOINT_OR_NEG_MAPPING_SPHERE ← prove
   r"!f:real^N->real^N.
        ODD(dimindex(:N)) /\
        f continuous_on sphere(vec 0,&1) /\
        IMAGE f (sphere(vec 0,&1)) SUBSET sphere(vec 0,&1)
        ==> ?x. x IN sphere(vec 0,&1) /\ (f x = --x \/ f x = x)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [LEFT_OR_DISTRIB, EXISTS_OR_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> q) ==> p \/ q")) THEN DISCH_TAC THEN
    MATCH_MP_TAC FIXPOINT_HOMOTOPIC_IDENTITY_SPHERE THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS THEN
    ASM_REWRITE_TAC [IMAGE_ID, SUBSET_REFL, CONTINUOUS_ON_ID] THEN
    ASM_MESON_TAC [VECTOR_NEG_NEG])

  let (HAIRY_BALL_THEOREM_ALT, HAIRY_BALL_THEOREM) ← CONJ_PAIR (← prove
   r"(!r. (?f. f continuous_on sphere(vec 0:real^N,r) /\
             (!x. x IN sphere(vec 0,r)
                  ==> ~(f x = vec 0) /\ orthogonal x (f x))) <=>
        r <= &0 \/ EVEN(dimindex(:N))) /\
   (!r. (?f. f continuous_on sphere(vec 0:real^N,r) /\
             IMAGE f (sphere(vec 0,r)) SUBSET sphere(vec 0,r) /\
             (!x. x IN sphere(vec 0,r)
                  ==> ~(f x = vec 0) /\ orthogonal x (f x))) <=>
        r < &0 \/ &0 < r /\ EVEN(dimindex(:N)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"r:real") THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, NOT_IN_EMPTY, IMAGE_CLAUSES, EMPTY_SUBSET,
                  CONTINUOUS_ON_EMPTY, REAL_LT_IMP_LE] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN ASM_REWRITE_TAC [REAL_LE_REFL, REAL_LT_REFL] THENL
     [SIMP_TAC [SPHERE_SING, FORALL_IN_INSERT, NOT_IN_EMPTY, SUBSET,
                FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [ALL_TAC, MESON_TAC [IN_SING]] THEN
      EXISTS_TAC (← q r"(\x. basis 1):real^N->real^N") THEN
      SIMP_TAC [CONTINUOUS_ON_CONST, ORTHOGONAL_0, BASIS_NONZERO, LE_REFL,
                DIMINDEX_GE_1],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ASM_SIMP_TAC [← GSYM REAL_NOT_LT]] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (p ==> r) /\ (r ==> q)
      ==> (p <=> r) /\ (q <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
      REWRITE_TAC [← GSYM NOT_ODD] THEN REPEAT STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"\x. inv(norm(f(r % x))) % (f:real^N->real^N) (r % x)")
            FIXPOINT_OR_NEG_MAPPING_SPHERE) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN CONJ_TAC THENL
         [REWRITE_TAC [o_DEF] THEN
          MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN CONJ_TAC THENL
           [MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE,
            X_GEN_TAC (← q r"x:real^N") THEN
            FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r % x:real^N")) THEN
            ASM_SIMP_TAC [NORM_MUL, real_abs, REAL_LT_IMP_LE, NORM_EQ_0,
                          IN_SPHERE_0, REAL_MUL_RID]],
          ALL_TAC] THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_SIMP_TAC [← GSYM SPHERE_SCALING, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID,
                      VECTOR_MUL_RZERO, REAL_MUL_RID],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        MATCH_MP_TAC REAL_MUL_LINV THEN
        ASM_SIMP_TAC [NORM_MUL, real_abs, REAL_LT_IMP_LE, NORM_EQ_0,
                      IN_SPHERE_0, REAL_MUL_RID],
        REWRITE_TAC [IN_SPHERE_0, ← VECTOR_ARITH (← q r"a:real^N = --x <=> --a = x")] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r % x:real^N")) THEN
        ASM_SIMP_TAC [NORM_MUL, real_abs, REAL_LT_IMP_LE, NORM_EQ_0,
                      IN_SPHERE_0, REAL_MUL_RID] THEN
        ASM_SIMP_TAC [ORTHOGONAL_MUL, REAL_LT_IMP_NZ] THEN
        FIRST_X_ASSUM (fun th => tactic_of do pure (
          GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o LAND_CONV) [← SYM th])) THEN
        REWRITE_TAC [ORTHOGONAL_MUL, ORTHOGONAL_LNEG, ORTHOGONAL_REFL,
                     REAL_INV_EQ_0, NORM_EQ_0] THEN
        CONV_TAC (fun t => TAUT t)],
      REWRITE_TAC [EVEN_EXISTS] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      EXISTS_TAC (← q r"(\x. lambda i. if EVEN(i) then --(x$(i-1)) else x$(i+1)):
                  real^N->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
        SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                  LAMBDA_BETA, REAL_NEG_ADD, ← GSYM REAL_MUL_RNEG] THEN
        MESON_TAC [],
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0, ← GSYM DOT_EQ_0] THEN
        SIMP_TAC [orthogonal, dot, LAMBDA_BETA, NORM_EQ_SQUARE]] THEN
      SUBGOAL_THEN (← q r"1..dimindex(:N) = 2*0+1..(2 * (n - 1) + 1) + 1")
      SUBST1_TAC THENL
       [BINOP_TAC THEN REWRITE_TAC [ADD_CLAUSES, MULT_CLAUSES] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ARITH_RULE
          (← q r"m = 2 * n ==> 1 <= m ==> m = (2 * (n - 1) + 1) + 1"))) THEN
        REWRITE_TAC [DIMINDEX_GE_1],
        REWRITE_TAC [SUM_OFFSET, SUM_PAIR]] THEN
      REWRITE_TAC [EVEN_ADD, EVEN_MULT, ARITH, ADD_SUB] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a + --x * --y:real = x * y + a")] THEN
      ASM_SIMP_TAC [REAL_POW_EQ_0, REAL_LT_IMP_NZ] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x + y * --z = x - z * y"), REAL_SUB_REFL, SUM_0]]))

  let CONTINUOUS_FUNCTION_HAS_EIGENVALUES_ODD_DIM ← prove
   r"!f:real^N->real^N.
        ODD(dimindex(:N)) /\ f continuous_on sphere(vec 0:real^N,&1)
        ==> ?v c. v IN sphere(vec 0,&1) /\ f v = c % v"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"!v. norm v = &1 ==> ~((f:real^N->real^N) v = vec 0)") THENL
     [ALL_TAC, ASM_MESON_TAC [VECTOR_MUL_LZERO, IN_SPHERE_0]] THEN
    MP_TAC (← ISPEC (← q r"\x. inv(norm(f x)) % (f:real^N->real^N) x")
          FIXPOINT_OR_NEG_MAPPING_SPHERE) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN ASM_REWRITE_TAC [o_DEF] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_NORM_COMPOSE, IN_SPHERE_0],
        REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o AP_TERM
       (← q r"(%) (norm((f:real^N->real^N) v)):real^N->real^N"))] THEN
      ASM_SIMP_TAC [VECTOR_MUL_LID, VECTOR_MUL_ASSOC, REAL_MUL_RINV, NORM_EQ_0,
                    REAL_MUL_LINV] THEN
      ASM_MESON_TAC [VECTOR_MUL_RNEG, VECTOR_MUL_LNEG])

  let EULER_ROTATION_THEOREM_GEN ← prove
   r"!A:real^N^N.
        ODD(dimindex(:N)) /\ rotation_matrix A
        ==> ?v. norm v = &1 /\ A ** v = v"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [rotation_matrix]) THEN
    ASM_CASES_TAC (← q r"!v:real^N. v IN sphere (vec 0,&1) ==> ~(A ** v = v)") THENL
     [ALL_TAC, ASM_MESON_TAC [IN_SPHERE_0]] THEN
    MP_TAC (← ISPECL [← q r"\x:real^N. (A:real^N^N) ** x", ← q r"\x:real^N. --x",
                      ← q r"sphere(vec 0:real^N,&1)", ← q r"&1"]
          HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS) THEN
    ASM_REWRITE_TAC [VECTOR_NEG_NEG] THEN ANTS_TAC THENL
