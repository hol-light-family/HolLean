  let RETRACT_OF_EMPTY ← prove
   r"(!s:real^N->bool. {} retract_of s <=> s = {}) /\
   (!s:real^N->bool. s retract_of {} <=> s = {})"
   (REWRITE_TAC [retract_of, retraction, SUBSET_EMPTY, IMAGE_CLAUSES] THEN
