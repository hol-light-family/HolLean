    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID])

  let RETRACT_OF_COHOMOTOPICALLY_TRIVIAL ← prove
   r"!s t:real^N->bool u:real^M->bool.
        t retract_of s /\
        (!f g. f continuous_on s /\ IMAGE f s SUBSET u /\
               g continuous_on s /\ IMAGE g s SUBSET u
               ==> homotopic_with (\x. T)
                    (subtopology euclidean s,subtopology euclidean u)  f g)
        ==> (!f g. f continuous_on t /\ IMAGE f t SUBSET u /\
                   g continuous_on t /\ IMAGE g t SUBSET u
                   ==> homotopic_with (\x. T)
                       (subtopology euclidean t,subtopology euclidean u) f g)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> p /\ q /\ T /\ r /\ s /\ T")] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      COHOMOTOPICALLY_TRIVIAL_RETRACTION_GEN) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real^N->real^N") THEN
    REWRITE_TAC [RETRACTION] THEN STRIP_TAC THEN EXISTS_TAC (← q r"\x:real^N. x") THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID])

  let RETRACT_OF_COHOMOTOPICALLY_TRIVIAL_NULL ← prove
   r"!s t:real^N->bool u:real^M->bool.
        t retract_of s /\
        (!f. f continuous_on s /\ IMAGE f s SUBSET u
             ==> ?c. homotopic_with (\x. T)
                      (subtopology euclidean s,subtopology euclidean u)
                      f (\x. c))
        ==> (!f. f continuous_on t /\ IMAGE f t SUBSET u
                 ==> ?c. homotopic_with (\x. T)
                          (subtopology euclidean t,subtopology euclidean u)
                          f (\x. c))"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> p /\ q /\ T")] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      COHOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real^N->real^N") THEN
    REWRITE_TAC [RETRACTION] THEN STRIP_TAC THEN EXISTS_TAC (← q r"\x:real^N. x") THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID])

  let RETRACTION_IMP_QUOTIENT_MAP_EXPLICIT ← prove
   r"!r s t:real^N->bool.
    retraction (s,t) r
    ==> !u. u SUBSET t
            ==> (open_in (subtopology euclidean s) {x | x IN s /\ r x IN u} <=>
                 open_in (subtopology euclidean t) u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RETRACTION] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP THEN
    EXISTS_TAC (← q r"\x:real^N. x") THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_ID, SUBSET_REFL, IMAGE_ID])

  let RETRACT_OF_LOCALLY_CONNECTED ← prove
   r"!s t:real^N->bool.
        s retract_of t /\ locally connected t ==> locally connected s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retract_of] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (fun th => tactic_of do pure (SUBST1_TAC (← SYM
      (← liftExcept (el 2 (CONJUNCTS (← GEN_REWRITE_RULE I [RETRACTION] th))))))) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC RETRACTION_IMP_QUOTIENT_MAP_EXPLICIT THEN
    ASM_MESON_TAC [RETRACTION])

  let RETRACT_OF_LOCALLY_PATH_CONNECTED ← prove
   r"!s t:real^N->bool.
        s retract_of t /\ locally path_connected t
        ==> locally path_connected s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retract_of] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (fun th => tactic_of do pure (SUBST1_TAC (← SYM
      (← liftExcept (el 2 (CONJUNCTS (← GEN_REWRITE_RULE I [RETRACTION] th))))))) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
      LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC RETRACTION_IMP_QUOTIENT_MAP_EXPLICIT THEN
    ASM_MESON_TAC [RETRACTION])

  let RETRACT_OF_LOCALLY_COMPACT ← prove
   r"!s t:real^N->bool.
        locally compact s /\ t retract_of s ==> locally compact t"
   (MESON_TAC [CLOSED_IN_RETRACT, LOCALLY_COMPACT_CLOSED_IN])

  let RETRACT_OF_PCROSS ← prove
   r"!s:real^M->bool s' t:real^N->bool t'.
        s retract_of s' /\ t retract_of t'
        ==> (s PCROSS t) retract_of (s' PCROSS t')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS] THEN
    REWRITE_TAC [retract_of, retraction, SUBSET, FORALL_IN_IMAGE] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"f:real^M->real^M") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"g:real^N->real^N") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"\z. pastecart ((f:real^M->real^M) (fstcart z))
                              ((g:real^N->real^N) (sndcart z))") THEN
    REWRITE_TAC [FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
    CONJ_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
     CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART])

  let RETRACT_OF_PCROSS_EQ ← prove
   r"!s s':real^M->bool t t':real^N->bool.
        s PCROSS t retract_of s' PCROSS t' <=>
        (s = {} \/ t = {}) /\ (s' = {} \/ t' = {}) \/
        s retract_of s' /\ t retract_of t'"
   (REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"s:real^M->bool = {}",
      ← q r"s':real^M->bool = {}",
      ← q r"t:real^N->bool = {}",
      ← q r"t':real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, RETRACT_OF_EMPTY, PCROSS_EQ_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [RETRACT_OF_PCROSS] THEN
    REWRITE_TAC [retract_of, retraction, SUBSET, FORALL_IN_PCROSS,
                 FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^(M,N)finite_sum->real^(M,N)finite_sum")
      STRIP_ASSUME_TAC) THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"?b:real^N. b IN t") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"\x. fstcart((r:real^(M,N)finite_sum->real^(M,N)finite_sum)
                              (pastecart x b))") THEN
      ASM_SIMP_TAC [FSTCART_PASTECART] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [],
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [LINEAR_FSTCART, LINEAR_CONTINUOUS_ON] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
                  CONTINUOUS_ON_CONST] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
        ASM_MESON_TAC [MEMBER_NOT_EMPTY],
        ASM_MESON_TAC [PASTECART_FST_SND, PASTECART_IN_PCROSS, MEMBER_NOT_EMPTY]],
      SUBGOAL_THEN (← q r"?a:real^M. a IN s") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"\x. sndcart((r:real^(M,N)finite_sum->real^(M,N)finite_sum)
                              (pastecart a x))") THEN
      ASM_SIMP_TAC [SNDCART_PASTECART] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [],
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [LINEAR_SNDCART, LINEAR_CONTINUOUS_ON] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
                  CONTINUOUS_ON_CONST] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
        ASM_MESON_TAC [MEMBER_NOT_EMPTY],
        ASM_MESON_TAC [PASTECART_FST_SND, PASTECART_IN_PCROSS,
                       MEMBER_NOT_EMPTY]]])

  let HOMOTOPIC_INTO_RETRACT ← prove
   r"!f:real^M->real^N g s t u.
        IMAGE f s SUBSET t /\ IMAGE g s SUBSET t /\ t retract_of u /\
        homotopic_with (\x. T)
         (subtopology euclidean s,subtopology euclidean u) f g
        ==> homotopic_with (\x. T)
             (subtopology euclidean s,subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    SIMP_TAC [HOMOTOPIC_WITH_EUCLIDEAN_ALT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^(1,M)finite_sum->real^N") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [retract_of]) THEN
    REWRITE_TAC [retraction, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^N->real^N") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(r:real^N->real^N) o (h:real^(1,M)finite_sum->real^N)") THEN
    ASM_SIMP_TAC [o_THM, IMAGE_o] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE, ASM SET_TAC []] THEN
    CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      CONTINUOUS_ON_SUBSET)) THEN
    ASM SET_TAC [])

  pure { FIXPOINT_HOMOTOPIC_IDENTITY_SPHERE, FIXPOINT_OR_NEG_MAPPING_SPHERE,
         HAIRY_BALL_THEOREM_ALT, HAIRY_BALL_THEOREM,
         CONTINUOUS_FUNCTION_HAS_EIGENVALUES_ODD_DIM, EULER_ROTATION_THEOREM_GEN,
         retraction, retract_of, RETRACTION_MAPS_EUCLIDEAN, RETRACT_OF_SPACE_EUCLIDEAN,
         RETRACTION, RETRACT_OF_IMP_EXTENSIBLE, RETRACTION_IDEMPOTENT,
         IDEMPOTENT_IMP_RETRACTION, RETRACTION_SUBSET, RETRACT_OF_SUBSET,
         RETRACT_OF_TRANSLATION, RETRACT_OF_TRANSLATION_EQ,
         RETRACT_OF_INJECTIVE_LINEAR_IMAGE, RETRACT_OF_LINEAR_IMAGE_EQ, RETRACTION_REFL,
         RETRACT_OF_REFL, RETRACTION_CLOSEST_POINT, RETRACT_OF_IMP_SUBSET,
         RETRACT_OF_EMPTY, RETRACT_OF_SING, RETRACT_OF_OPEN_UNION,
         RETRACT_OF_SEPARATED_UNION, RETRACT_OF_CLOSED_UNION, RETRACTION_o,
         RETRACT_OF_TRANS, CLOSED_IN_RETRACT, RETRACT_OF_CONTRACTIBLE, RETRACT_OF_COMPACT,
         RETRACT_OF_CLOSED, RETRACT_OF_CONNECTED, RETRACT_OF_PATH_CONNECTED,
         RETRACT_OF_SIMPLY_CONNECTED, RETRACT_OF_HOMOTOPICALLY_TRIVIAL,
         RETRACT_OF_HOMOTOPICALLY_TRIVIAL_NULL, RETRACT_OF_COHOMOTOPICALLY_TRIVIAL,
         RETRACT_OF_COHOMOTOPICALLY_TRIVIAL_NULL, RETRACTION_IMP_QUOTIENT_MAP_EXPLICIT,
         RETRACT_OF_LOCALLY_CONNECTED, RETRACT_OF_LOCALLY_PATH_CONNECTED,
         RETRACT_OF_LOCALLY_COMPACT, RETRACT_OF_PCROSS, RETRACT_OF_PCROSS_EQ,
         HOMOTOPIC_INTO_RETRACT }

/- ------------------------------------------------------------------------- -/
/- Brouwer fixed-point theorem; the topological dimension of R^n.            -/
/- (degree.ml 1104-1585)                                                     -/
/- ------------------------------------------------------------------------- -/

structure DGC where
  CONTRACTIBLE_SPHERE : thm
  NO_RETRACTION_CBALL : thm
  BROUWER_BALL : thm
  BROUWER : thm
  BROUWER_WEAK : thm
  BROUWER_CUBE : thm
  DIMENSION_EQ_AFF_DIM : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGC [HolBase] (D : DegreeDeps) (BDGA : DGA) (BDGB : DGB) : ExceptT String IO DGC := do
  -- @@SCOPE BEGIN
  let { HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP, .. } := BDGA
  let { retract_of, RETRACT_OF_CONTRACTIBLE, retraction, .. } := BDGB
  let { AND_FORALL_THM, ARITH_EQ, CARD_NUMSEG_1, CART_EQ, COND_ID, COND_RAND, CONJ_ASSOC,
        CONJ_SYM, CONTRAPOS_THM, DIFF_EMPTY, DIMINDEX_GE_1, DISJOINT, ETA_AX, EXTENSION,
        FORALL_AND_THM, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_ID, IMP_CONJ_ALT,
        INT_LE_ANTISYM, INT_LE_REFL, INT_LE_TRANS, INT_OF_NUM_EQ, INT_OF_NUM_LE,
        INT_OF_NUM_SUB, INTER_ACI, INTER_SUBSET, INTER_UNIV, INTERS_0, INTERS_IMAGE,
        INTERS_INSERT, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_SING, LAMBDA_BETA, LE_REFL,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM,
        NOT_IMP, NOT_IN_EMPTY, NOT_LE, NOT_LT, NUMSEG_EMPTY, REAL_ADD_RID, REAL_DIV_EQ_0, ..
        } := D.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_LE_ADD, REAL_LE_MUL, REAL_LE_POW_2, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_EQ, REAL_POS,
        REAL_POW_2, REAL_POW_LE2, REAL_SUB_LE, REAL_SUB_REFL, RIGHT_AND_EXISTS_THM,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SQRT_POW_2, SUBSET, SUBSET_INTER, SUBSET_REFL, ..
        } := D.pt.cvx.core5
  let { numseg, o_DEF, o_THM, real_div, SUM_DELTA, .. } := D.pt.cvx.core6
  let { HULL_INC, .. } := D.pt.cvx.misc
  let { BASIS_NONZERO, DIM_BASIS_IMAGE, DIM_SPAN, DOT_EQ_0, DOT_LMUL, DOT_NORM_SUB,
        DOT_RMUL, .. } := D.pt.cvx.vec1
  let { IN_INTERVAL, IN_SPAN_IMAGE_BASIS, LIFT_ADD, LIFT_CMUL, LIFT_NUM, LIFT_SUB,
        MATRIX_ID, NORM_0, NORM_EQ_SQUARE, .. } := D.pt.cvx.vec2
  let { NORM_POS_LE, NORM_POW_2, SPAN_0, .. } := D.pt.cvx.vec3
  let { dist, dot, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_ADD_RID, VECTOR_CHOOSE_SIZE,
        VECTOR_MUL_EQ_0, VECTOR_MUL_RZERO, VECTOR_SUB_COMPONENT, VECTOR_SUB_EQ, .. } :=
        D.pt.cvx.vec4
  let { DET_I, DET_MATRIX_REFLECT_ALONG, LINEAR_REFLECT_ALONG, ORTHOGONAL_TRANSFORMATION_ID,
        ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG, .. } := D.pt.cvx.det
  let { CLOSED_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, .. } :=
        D.pt.cvx.met
  let { BOUNDED_POS, CLOSED_IN_CLOSED_INTER, CLOSED_SPAN, CLOSEST_POINT_IN_SET,
        CLOSEST_POINT_SELF, .. } := D.pt.cvx.top1
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_INTER_CLOSED, COMPACT_INTERVAL,
        CONNECTED_OPEN_IN, CONNECTED_SEGMENT, .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_INV, CONTINUOUS_ON_MUL, CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT, .. } := D.pt.cvx.top3
  let { IN_CBALL, IN_SPHERE, INTERIOR_EMPTY, LINEAR_CONTINUOUS_ON, .. } := D.pt.cvx.top4
  let { OPEN_IN_REFL, open_segment, SETDIST_EQ_0_CLOSED_IN, SETDIST_LE_DIST, SETDIST_POS_LE,
        SPHERE_EMPTY, UNIT_INTERVAL_NONEMPTY, .. } := D.pt.cvx.top5
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC,
        GEOM_NORMALIZE_TAC, GEOM_ORIGIN_TAC, INT_ARITH, MESON, MESON_TAC, NORM_ARITH,
        NUM_REDUCE_CONV, NUMSEG_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.pt.cvx
  let { UNION_OVER_INTER, .. } := D.pt.qses
  let { VECTOR_NEG_0, .. } := D.pt.qvec
  let { CLOSED_IN_REFL, SETDIST_SING_IN_SET, .. } := D.pt.qtop
  let { AFF_DIM_DIM_0, AFF_DIM_EMPTY, AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFF_DIM_GE,
        AFF_DIM_LE_UNIV, AFFINE_HULL_EQ_SPAN, .. } := D.pt.qcvx1
  let { CONVEX_CBALL, CONVEX_INTER, .. } := D.pt.qcvx2
  let { OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_SUBSET, ..
        } := D.pt.qcvx3
  let { AFF_DIM_RELATIVE_INTERIOR, AFFINE_HULL_RELATIVE_INTERIOR,
        CONTINUOUS_ON_CLOSEST_POINT, CONVEX_CONNECTED, CONVEX_INTERVAL,
        CONVEX_RELATIVE_INTERIOR, CONVEX_SPAN, HOMEOMORPHIC_RELATIVELY_OPEN_CONVEX_SETS,
        SEGMENT_SUBSET_CONVEX, .. } := D.qconvex
  let { CLOSED_IN_IMP_SUBSET, .. } := D.qmetric
  let { CONTRACTIBLE_EMPTY, CONTRACTIBLE_SING, CONVEX_IMP_CONTRACTIBLE, DIMENSION_EMPTY,
        DIMENSION_LE_AFF_DIM, DIMENSION_LE_MINUS1, DIMENSION_SEPARATION_THEOREM,
        DIMENSION_SING, DIMENSION_SUBSET, HOMEOMORPHIC_DIMENSION,
        HOMOTOPIC_INTO_CONTRACTIBLE, .. } := D.qpaths1
  let { I_DEF, INT_FORALL_POS, INT_SUB_LE, INTERS_SUBSET, NUMSEG_RREC, SQRT_UNIQUE, WF_num,
        WF_REC_EXISTS, .. } := D.qsession
  let { CLOSED_STANDARD_HYPERPLANE, CONTINUOUS_ON_CASES_LOCAL, CONTINUOUS_ON_CMUL,
        CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_LIFT_COMPONENT,
        CONTINUOUS_ON_LIFT_DOT2, CONTINUOUS_ON_LIFT_SETDIST,
        CONTINUOUS_ON_LIFT_SQRT_COMPOSE, DIST_IN_OPEN_SEGMENT, .. } := D.qtopology1
  let { ORTHOGONAL_TRANSFORMATION_SPHERE, SETDIST_SYM, SPHERE_SING, SPHERE_SUBSET_CBALL, ..
        } := D.qtopology2
  let { LIFT_NEG, SPAN_SPAN, .. } := D.qvec
  -- @@SCOPE END

  let CONTRACTIBLE_SPHERE ← prove
   r"!a:real^N r. contractible(sphere(a,r)) <=> r <= &0"
   (GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, CONTRACTIBLE_EMPTY, REAL_LT_IMP_LE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT]) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"b:real^N") (SUBST1_TAC o SYM) o
          MATCH_MP VECTOR_CHOOSE_SIZE) THEN
    REWRITE_TAC [← NORM_ARITH (← q r"norm(b:real^N) <= &0 <=> b = vec 0")] THEN
    GEOM_NORMALIZE_TAC (← q r"b:real^N") THEN
    SIMP_TAC [NORM_0, SPHERE_SING, CONTRACTIBLE_SING] THEN
    X_GEN_TAC (← q r"b:real^N") THEN ASM_CASES_TAC (← q r"b:real^N = vec 0") THEN
    ASM_REWRITE_TAC [NORM_0, REAL_OF_NUM_EQ, ARITH_EQ] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN POP_ASSUM_LIST (K ALL_TAC) THEN
    DISCH_THEN (MP_TAC o ISPEC (← q r"I:real^N->real^N") o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     (← REWRITE_RULE [CONJ_ASSOC] HOMOTOPIC_INTO_CONTRACTIBLE))) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"reflect_along (basis 1:real^N)", ← q r"sphere(vec 0:real^N,&1)"]) THEN
    REWRITE_TAC [CONTINUOUS_ON_ID, IMAGE_ID, I_DEF, NOT_IMP] THEN
    SIMP_TAC [SUBSET_REFL, LINEAR_CONTINUOUS_ON, LINEAR_REFLECT_ALONG,
              ORTHOGONAL_TRANSFORMATION_SPHERE,
              ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     (← REWRITE_RULE [CONJ_ASSOC] HOMOTOPIC_ORTHOGONAL_TRANSFORMATIONS_IMP))) THEN
    REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG,
                 ORTHOGONAL_TRANSFORMATION_ID] THEN
