set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupDGD [HolBase] (D : DegreeDeps) (BDGC : DGC) : ExceptT String IO DGD := do
  -- @@SCOPE BEGIN
  let { DIMENSION_EQ_AFF_DIM, .. } := BDGC
  let { ARITH_EQ, CARD_NUMSEG, CARD_NUMSEG_1, CARD_PSUBSET, CARD_SUBSET, CONJ_ASSOC,
