  let { num_INDUCTION, numseg, o_DEF, real_abs, real_div, SUBSET_UNIV, UNIONS_GSPEC,
        UNIV_NOT_EMPTY, UNWIND_THM1, .. } := D.pt.cvx.core6
  let { HULL_HULL, HULL_INC, HULL_P, HULL_SUBSET, .. } := D.pt.cvx.misc
  let { DIM_BASIS_IMAGE, DIM_SPAN, .. } := D.pt.cvx.vec1
  let { IN_SPAN_IMAGE_BASIS, LIFT_CMUL, LINEAR_SCALING, NORM_EQ_0, .. } := D.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LT, REAL_ABS_NORM, SUBSPACE_MUL, SUBSPACE_SPAN, .. } :=
        D.pt.cvx.vec3
  let { dist, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LCANCEL, VECTOR_MUL_LID,
        VECTOR_MUL_RZERO, VECTOR_SUB_COMPONENT, .. } := D.pt.cvx.vec4
  let { CLOSURE_OF_SUBTOPOLOGY, frontier_of, INTERIOR_OF_SUBSET, OPEN_IN_DIFF,
        OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_INTERIOR_OF, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_TRANS, SUBTOPOLOGY_UNIV, .. } := D.pt.cvx.met
  let { BALL_MIN_INTER, BOUNDED_CBALL, BOUNDED_CLOSURE, BOUNDED_SUBSET,
        BOUNDED_SUBSET_CBALL, CBALL_SCALING, CENTRE_IN_BALL, CENTRE_IN_CBALL,
        CLOSED_CLOSURE, CLOSED_SPAN, CLOSURE_APPROACHABLE, .. } := D.pt.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_MINIMAL_EQ, CLOSURE_RATIONAL_COORDINATES, CONNECTED_CLOPEN,
        .. } := D.pt.cvx.top2
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_MUL, EUCLIDEAN_CLOSURE_OF, FRONTIER_CBALL, .. } := D.pt.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_IMP_OPEN_MAP, HOMEOMORPHISM_OF_SUBSETS, IN_CBALL_0,
        INTERIOR_CBALL, INTERIOR_SUBSET, OPEN_BALL, .. } := D.pt.cvx.top4
  let { homeomorphic, homeomorphism, OPEN_IN, OPEN_IN_CONTAINS_BALL,
        OPEN_IN_INJECTIVE_LINEAR_IMAGE, OPEN_IN_REFL, OPEN_INTERIOR, OPEN_UNIV,
        SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.pt.cvx.top5
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC,
        GEOM_ORIGIN_TAC, INT_ARITH, INT_REDUCE_CONV, MESON, MESON_TAC, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, .. } := D.pt.cvx
  let { CARD_IMAGE_LE, INT_LTE_TRANS, INT_NOT_LE, INT_SUB_RZERO, .. } := D.pt.qses
  let { BOUNDED_INTER, OPEN_IN_DELETE, .. } := D.pt.qtop
  let { AFF_DIM_AFFINE_HULL, AFF_DIM_CONVEX_HULL, AFF_DIM_EMPTY, AFF_DIM_EQ_0,
        AFF_DIM_EQ_FULL, AFF_DIM_EQ_MINUS1, AFF_DIM_GE, AFF_DIM_LE_UNIV, AFF_DIM_POS_LE,
        AFF_DIM_SING, AFF_DIM_SUBSET, AFF_DIM_UNIV, AFFINE_AFFINE_HULL, AFFINE_HULL_CLOSURE,
