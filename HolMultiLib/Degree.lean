  let { AFF_DIM_CONVEX_INTER_OPEN, AFF_DIM_DIM_SUBSPACE, AFF_DIM_EQ_FULL_GEN,
        AFF_DIM_OPEN_IN, AFFINE_BOUNDED_EQ_LOWDIM, AFFINE_EQ_SUBSPACE,
        AFFINE_HULL_AFFINE_INTER_NONEMPTY_INTERIOR, AFFINE_HULL_OPEN_IN_AFFINE,
        AFFINE_HULL_OPEN_IN_CONVEX, AFFINE_HULL_RELATIVE_FRONTIER_BOUNDED,
        BOUNDED_RELATIVE_INTERIOR, CONVEX_CONNECTED, OPEN_IN_CONVEX_MEETS_RELATIVE_INTERIOR,
        RELATIVE_FRONTIER_EMPTY, RELATIVE_FRONTIER_EQ_EMPTY, RELATIVE_FRONTIER_FRONTIER_OF,
