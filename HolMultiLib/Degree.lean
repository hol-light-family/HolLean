        CLOSED_AFFINE_HULL, .. } := D.pt.qcvx1
  let { CONIC_IMAGE_MULTIPLE, CONVEX_BALL, CONVEX_CBALL, CONVEX_CONVEX_HULL, CONVEX_INTER,
        .. } := D.pt.qcvx2
  let { CONVEX_UNIV, IN_RELATIVE_INTERIOR, OPEN_IN_RELATIVE_INTERIOR, relative_frontier,
        RELATIVE_FRONTIER_SING, RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_INTERIOR,
