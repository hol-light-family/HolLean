  LOCALLY_CONNECTED_SPHERE_GEN : thm
  ABSOLUTE_RETRACTION_CONVEX_CLOSED_RELATIVE : thm
  ABSOLUTE_RETRACTION_CONVEX_CLOSED : thm
  ABSOLUTE_RETRACT_CONVEX_CLOSED : thm
