  FRONTIER_RETRACT_OF_PUNCTURED_UNIVERSE : thm
  SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE_GEN : thm
  SPHERE_RETRACT_OF_PUNCTURED_UNIVERSE : thm
  ENR_SPHERE : thm
  ANR_SPHERE : thm
