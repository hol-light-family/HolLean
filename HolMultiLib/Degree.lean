        FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT, FORALL_AND_THM, .. } := D.pt.cvx.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT,
        IN_DELETE, IN_DIFF, INT_EQ_IMP_LE, INT_LE_ANTISYM, INT_LE_REFL, INT_LE_TRANS,
        INT_LET_TRANS, INT_LT_LE, INT_NOT_LT, INT_OF_NUM_EXISTS, INT_OF_NUM_LE,
        INT_OF_NUM_SUB, INT_OF_NUM_SUC, INTER_COMM, INTER_SUBSET, .. } := D.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNIV, LAMBDA_BETA, LE, LE_REFL,
        LE_TRANS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, REAL_ABS_DIV,
        REAL_DIV_EQ_0, REAL_DIV_RMUL, .. } := D.pt.cvx.core3
  let { REAL_INV_POW, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LET_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, REAL_LT_REFL, .. } := D.pt.cvx.core4
  let { REAL_NOT_LE, REAL_POW_EQ_0, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_DELETE,
        SUBSET_EMPTY, SUBSET_INTER, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS, .. } :=
