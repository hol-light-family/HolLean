      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] INT_LE_TRANS) THEN
      MATCH_MP_TAC DIMENSION_SUBSET THEN SET_TAC [],
      DISCH_TAC THEN GEN_REWRITE_TAC id [DIMENSION_LE_EQ] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(:real^N)", ← q r"vec 0:real^N"]) THEN
        ASM_REWRITE_TAC [OPEN_UNIV, IN_UNIV] THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP DIMENSION_LE_IMP_GE) THEN ASM_ARITH_TAC,
        ASM_MESON_TAC []]])

  return { DIMENSION_LE_UNIONS_RELATIVE, DIMENSION_LE_UNIONS, DIMENSION_LE_UNION_RELATIVE,
           DIMENSION_LE_UNION, DIMENSION_LE_UNION_RELATIVE_GEN, DIMENSION_LE_UNION_GEN,
           DIMENSION_LE_UNION_CLOSED_IN, DIMENSION_LE_UNIONS_ZERODIMENSIONAL,
           DIMENSION_LE_UNIONS_ZERODIMENSIONAL_EQ, DIMENSION_INSERT, DIMENSION_DELETE,
           DIMENSION_LE_EQ_GEN }

