        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
        UNDISCH_TAC (← q r"~(w INTER c:real^N->bool = {})") THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [IN_BALL_0] THEN
        ONCE_REWRITE_TAC [CONJ_SYM] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = y + z <=> z = x - y")] THEN
        REWRITE_TAC [UNWIND_THM2, ← GSYM dist] THEN
        TRANS_TAC REAL_LET_TRANS (← q r"diameter(c:real^N->bool)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC DIST_LE_DIAMETER THEN
        ASM_REWRITE_TAC [],
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            BOUNDED_SUBSET)),
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← MESON [DIAMETER_SUBSET, REAL_LE_TRANS]
              (← q r"s SUBSET t
               ==> bounded t /\ diameter t <= e ==> diameter s <= e")))] THEN
        ASM_SIMP_TAC [BOUNDED_SUMS, BOUNDED_BALL] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) DIAMETER_SUMS o lhand o snd) THEN
        ASM_SIMP_TAC [BOUNDED_BALL, DIAMETER_BALL] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> ~(e / &4 < &0)")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"d + &2 * e / &4 <= e <=> d <= e / &2")] THEN
        TRANS_TAC REAL_LE_TRANS (← q r"r / &2 pow (k + 1)") THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
        REWRITE_TAC [real_div, REAL_POW_ADD, REAL_INV_MUL] THEN
        ASM_REAL_ARITH_TAC]] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"w:real^N->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_UNION] THEN
      X_GEN_TAC (← q r"x:real^N") THEN EXPAND_TAC "q" THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN SET_TAC [],
      REWRITE_TAC [IN_UNIV]] THEN
    X_GEN_TAC (← q r"n:num") THEN
    DISJ_CASES_TAC (← ARITH_RULE (← q r"n:num <= k \/ k < n")) THENL
     [TRANS_TAC SUBSET_TRANS (← q r"(t:num->real^N->bool) k") THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"n:num <= k") THEN
        MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"k:num", ← q r"n:num"] THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_REWRITE_TAC [] THEN SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"UNIONS ws:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN
        GEN_REWRITE_TAC (fun c => LAND_CONV (RAND_CONV c)) [← GSYM IMAGE_ID] THEN
        MATCH_MP_TAC UNIONS_MONO_IMAGE THEN
        X_GEN_TAC (← q r"w:real^N->bool") THEN DISCH_TAC THEN
        REWRITE_TAC [SUBSET] THEN EXPAND_TAC "q" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"{x:real^N}") THEN
        REWRITE_TAC [BOUNDED_SING, CONNECTED_SING, IN_SING] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        REWRITE_TAC [DIAMETER_SING] THEN ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
    EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM] THEN
    SUBGOAL_THEN (← q r"?b:real^N. b IN f k /\ b IN f(SUC k)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_INTER, MEMBER_NOT_EMPTY], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"b IN (t:num->real^N->bool) k") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"f:num->real^N->bool") THEN
      ASM_MESON_TAC [LT_TRANS, LE_TRANS, LT_IMP_LE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:real^N) IN UNIONS ws") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"w:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE f (k+1..n)):real^N->bool") THEN
    REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"!i. i <= n ==> connected(UNIONS(IMAGE f (k+1..i)):real^N->bool)")
       (fun th => SIMP_TAC [th, LE_REFL]) THEN
      MATCH_MP_TAC num_INDUCTION THEN
      SUBGOAL_THEN (← q r"k+1..0 = {}") SUBST1_TAC THENL
       [REWRITE_TAC [NUMSEG_EMPTY] THEN ARITH_TAC,
        REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, CONNECTED_EMPTY]] THEN
      X_GEN_TAC (← q r"i:num") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_CASES_TAC (← q r"i:num = k") THENL
       [ASM_REWRITE_TAC [ADD1, NUMSEG_SING, IMAGE_CLAUSES, UNIONS_1] THEN
        ASM_MESON_TAC [ADD1],
        REWRITE_TAC [NUMSEG_CLAUSES] THEN
        COND_CASES_TAC THEN REWRITE_TAC [] THEN DISCH_TAC THEN
        REWRITE_TAC [IMAGE_CLAUSES, UNIONS_INSERT] THEN
        MATCH_MP_TAC CONNECTED_UNION THEN ASM_SIMP_TAC [] THEN
        REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:num")) THEN
        REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
         [ASM_ARITH_TAC,
          ONCE_REWRITE_TAC [INTER_COMM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_ARITH_TAC]],
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN s ==> f x SUBSET g x) /\ s SUBSET t
        ==> UNIONS(IMAGE f s) SUBSET UNIONS {g x | x IN t}")) THEN
      REWRITE_TAC [IN_NUMSEG, SUBSET_UNIV] THEN X_GEN_TAC (← q r"i:num") THEN
      STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"f:num->real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      MATCH_MP_TAC BOUNDED_UNIONS THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE, IN_NUMSEG],
      ALL_TAC,
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"b:real^N") THEN
      ASM_REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, IN_NUMSEG, IN_INTER] THEN
      EXISTS_TAC (← q r"SUC k") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"n:num") THEN
      ASM_REWRITE_TAC [IN_NUMSEG] THEN ASM_ARITH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!d j. j + d = n
            ==> diameter (UNIONS (IMAGE f (j..n)):real^N->bool)
                < &2 * r / &2 pow j")
     (MP_TAC o SPECL [← q r"n - (k + 1)", ← q r"k + 1"])
    THENL
     [ALL_TAC,
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LTE_TRANS) THEN
