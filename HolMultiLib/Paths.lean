      SUBGOAL_THEN (← q r"s INTER h UNION t INTER h:real^N->bool = h")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC []] THEN
      SUBGOAL_THEN (← q r"(s INTER h) INTER t INTER h:real^N->bool = c")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        ASM SET_TAC [],
        ASM_MESON_TAC [PATH_CONNECTED_PATH_COMPONENT]]])

  let LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\
        locally path_connected (s UNION t) /\
        locally path_connected (s INTER t)
        ==> locally path_connected s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"t:real^N->bool", ← q r"s UNION t:real^N->bool"] THEN
    ASM_SIMP_TAC [CLOSED_SUBSET, SUBSET_UNION])

  return { PATH_CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL,
           PATH_CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL,
           PATH_CONNECTED_FROM_CLOSED_UNION_AND_INTER, PATH_CONNECTED_CLOSURE_FROM_FRONTIER,
           LOCALLY_PATH_CONNECTED_SUBREGION, LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER_GEN,
           LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER }

/- ------------------------------------------------------------------------- -/
/- Two uniform variants of local connectedness. ULC is an abbreviation for   -/
/- "uniformly locally connected"; FCCOVERABLE ("fine connected coverable")   -/
/- is more usually called "Property S" (Whyburn, Hocking & Young etc.)       -/
/- (paths.ml 7850-8140)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTW where
  SUBMETRIC_EUCLIDEAN_METRIC : thm
  MTOPOLOGY_SUBMETRIC_EUCLIDEAN : thm
  MBOUNDED_SUBMETRIC_EUCLIDEAN : thm
  MDIAMETER_SUBMETRIC_EUCLIDEAN : thm
  CONNECTED_IN_SUBTOPOLOGY_EUCLIDEAN : thm
  COMPACT_IN_SUBTOPOLOGY_EUCLIDEAN : thm
  CONNECTED_IN_SUBMETRIC_EUCLIDEAN : thm
  COMPACT_IN_SUBMETRIC_EUCLIDEAN_MSPACE : thm
  LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN : thm
  LOCALLY_COMPACT_SPACE_SUBMETRIC_EUCLIDEAN : thm
  CONNECTED_IN_SUBMETRIC_EUCLIDEAN_MSPACE : thm
  FCCOVERABLE_IN_EUCLIDEAN_METRIC : thm
  FCCOVERABLE_SPACE_SUBMETRIC_EUCLIDEAN : thm
  ULC_SPACE_SUBMETRIC_EUCLIDEAN : thm
  FCCOVERABLE_IMP_LOCALLY_CONNECTED : thm
  ULC_IMP_LOCALLY_CONNECTED : thm
  FCCOVERABLE_INTERMEDIATE_CLOSURE : thm
  COMPACT_LOCALLY_CONNECTED_IMP_ULC : thm
  COMPACT_LOCALLY_CONNECTED_IMP_ULC_ALT : thm
  BOUNDED_ULC_IMP_FCCOVERABLE : thm
  COMPACT_LOCALLY_CONNECTED_IMP_FCCOVERABLE : thm
  COMPACT_LOCALLY_CONNECTED_EQ_FCCCOVERABLE : thm
  deriving Inhabited

@[nospecialize]
def setupPTW [HolBase] (D : PathsDeps) (BS : PTS) : ExceptT String IO PTW := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { FINITE_IMAGE, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMP_IMP, INTER_UNIV, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.cvx.core3
  let { REAL_LET_TRANS, REAL_LT_01, .. } := D.cvx.core4
  let { SIMPLE_IMAGE, SUBSET, SUBSET_INTER, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { dist, .. } := D.cvx.vec4
  let { CLOSURE_EQ, .. } := D.cvx.top1
  let { COMPACT_CLOSURE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, CONNECTED_IN_EUCLIDEAN, .. } :=
    D.cvx.top2
  let { DIAMETER_BOUNDED_BOUND, DIAMETER_CLOSURE, EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { IN_BALL, .. } := D.cvx.top4
  let { COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN, COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE,
        COMPACT_IN_SUBTOPOLOGY, CONNECTED_IN_SUBTOPOLOGY,
        FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE, FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE,
        .. } := D.pmet1
  let { MBOUNDED_SUBMETRIC, MTOPOLOGY_SUBMETRIC, SUBMETRIC, TOTALLY_BOUNDED_IN_SUBMETRIC,
        TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE, ULC_SPACE_IMP_LOCALLY_CONNECTED_SPACE,
        fccoverable_in, fccoverable_space, mdiameter, ulc_space, .. } := D.pmet2
  let { CLOSURE_UNIONS, COMPACT_IN_EUCLIDEAN, COMPACT_UNIONS, .. } := D.ptop1
  let { CONNECTED_CLOSURE, .. } := D.ptop2
  let { EUCLIDEAN_METRIC, .. } := D.ptop3
  let { LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN, .. } := D.ptop4
  let { MBOUNDED_EUCLIDEAN, MDIAMETER_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC, .. } := D.ptop5
  let { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, .. } := BS
  -- @@SCOPE END

  let SUBMETRIC_EUCLIDEAN_METRIC ← prove
   r"(!s:real^N->bool. mspace(submetric euclidean_metric s) = s) /\
   (!s:real^N->bool. mdist(submetric euclidean_metric s) = dist)"
   (REWRITE_TAC [SUBMETRIC, EUCLIDEAN_METRIC, INTER_UNIV])

  let MTOPOLOGY_SUBMETRIC_EUCLIDEAN ← prove
   r"!s:real^N->bool.
     mtopology(submetric euclidean_metric s) = subtopology euclidean s"
   (REWRITE_TAC [MTOPOLOGY_SUBMETRIC, MTOPOLOGY_EUCLIDEAN_METRIC])

  let MBOUNDED_SUBMETRIC_EUCLIDEAN ← prove
   r"!s t:real^N->bool.
     t SUBSET s ==> (mbounded (submetric euclidean_metric s) t <=> bounded t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [MBOUNDED_SUBMETRIC, MBOUNDED_EUCLIDEAN] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"(t:A->bool) SUBSET s ==> s INTER t = t")])

  let MDIAMETER_SUBMETRIC_EUCLIDEAN ← prove
   r"!s t:real^N->bool.
     t SUBSET s
     ==> mdiameter (submetric euclidean_metric s) t = diameter t"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM MDIAMETER_EUCLIDEAN, mdiameter, SUBMETRIC,
                EUCLIDEAN_METRIC, INTER_UNIV] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"(t:A->bool) SUBSET s ==> s INTER t = t")])

  let CONNECTED_IN_SUBTOPOLOGY_EUCLIDEAN ← prove
   r"!s t:real^N->bool.
     connected_in (subtopology euclidean s) t <=> t SUBSET s /\ connected t"
   (MESON_TAC [CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_EUCLIDEAN])

  let COMPACT_IN_SUBTOPOLOGY_EUCLIDEAN ← prove
   r"!s t:real^N->bool.
     compact_in (subtopology euclidean s) t <=> t SUBSET s /\ compact t"
   (MESON_TAC [COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_EUCLIDEAN])

  let CONNECTED_IN_SUBMETRIC_EUCLIDEAN ← prove
   r"!s t:real^N->bool.
     connected_in (mtopology(submetric euclidean_metric s)) t <=>
     t SUBSET s /\ connected t"
   (REWRITE_TAC [MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
                CONNECTED_IN_SUBTOPOLOGY_EUCLIDEAN])

  let COMPACT_IN_SUBMETRIC_EUCLIDEAN_MSPACE ← prove
   r"!s:real^N->bool.
     compact_in (mtopology(submetric euclidean_metric s)) s <=> compact s"
   (REWRITE_TAC [MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
                COMPACT_IN_SUBTOPOLOGY_EUCLIDEAN, SUBSET_REFL])

  let LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN ← prove
   r"!s:real^N->bool.
     locally_connected_space(mtopology(submetric euclidean_metric s)) <=>
     locally connected s"
   (REWRITE_TAC [MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
                LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN])

  let LOCALLY_COMPACT_SPACE_SUBMETRIC_EUCLIDEAN ← prove
   r"!s:real^N->bool.
     locally_compact_space(mtopology(submetric euclidean_metric s)) <=>
     locally compact s"
   (REWRITE_TAC [MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
                LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN])

  let CONNECTED_IN_SUBMETRIC_EUCLIDEAN_MSPACE ← prove
   r"!s:real^N->bool.
     connected_in (mtopology(submetric euclidean_metric s)) s <=>
     connected s"
   (REWRITE_TAC [CONNECTED_IN_SUBMETRIC_EUCLIDEAN, SUBSET_REFL])

  let FCCOVERABLE_IN_EUCLIDEAN_METRIC ← prove
   r"!s:real^N->bool.
     fccoverable_in euclidean_metric s <=>
     (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                         !t. t IN c ==> connected t /\ bounded t /\
                                        diameter t <= e)"
   (GEN_TAC THEN REWRITE_TAC [fccoverable_in, EUCLIDEAN_METRIC, SUBSET_UNIV,
                              MTOPOLOGY_EUCLIDEAN_METRIC, CONNECTED_IN_EUCLIDEAN,
                              MBOUNDED_EUCLIDEAN, MDIAMETER_EUCLIDEAN])

  let FCCOVERABLE_SPACE_SUBMETRIC_EUCLIDEAN ← prove
   r"!s:real^N->bool.
     fccoverable_space (submetric euclidean_metric s) <=>
     (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                         !t. t IN c ==> connected t /\ bounded t /\
                                        diameter t <= e)"
   (GEN_TAC THEN REWRITE_TAC [fccoverable_space, SUBMETRIC_EUCLIDEAN_METRIC,
                              CONNECTED_IN_SUBMETRIC_EUCLIDEAN] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:(real^N->bool)->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_TAC THEN
    (SUBGOAL_THEN (← q r"(t:real^N->bool) SUBSET s") ASSUME_TAC THENL
      [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [MBOUNDED_SUBMETRIC_EUCLIDEAN, MDIAMETER_SUBMETRIC_EUCLIDEAN])

  let ULC_SPACE_SUBMETRIC_EUCLIDEAN ← prove
   r"!s:real^N->bool.
     ulc_space (submetric euclidean_metric s) <=>
     (!e. &0 < e
          ==> ?d. &0 < d /\
                  !x y. x IN s /\ y IN s /\ dist(x,y) < d
                        ==> ?c. x IN c /\ y IN c /\ c SUBSET s /\
                                connected c /\ bounded c /\ diameter c <= e)"
   (GEN_TAC THEN
    REWRITE_TAC [ulc_space, SUBMETRIC_EUCLIDEAN_METRIC,
                CONNECTED_IN_SUBMETRIC_EUCLIDEAN] THEN
    EQ_TAC THEN
    (MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
     MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
     MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
     REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
     MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N->bool") THEN
     STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     ASM_MESON_TAC [MBOUNDED_SUBMETRIC_EUCLIDEAN,
                   MDIAMETER_SUBMETRIC_EUCLIDEAN]))

  let FCCOVERABLE_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool.
        (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                            !t. t IN c ==> connected t /\ bounded t /\
                                           diameter t <= e)
        ==> locally connected s"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric euclidean_metric (s:real^N->bool)")
      FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE) THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN,
                FCCOVERABLE_SPACE_SUBMETRIC_EUCLIDEAN] THEN
    ASM_MESON_TAC [])

  let ULC_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool.
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !x y. x IN s /\ y IN s /\ dist(x,y) < d
                           ==> ?c. x IN c /\ y IN c /\ c SUBSET s /\
                                   connected c /\
                                   bounded c /\ diameter c <= e)
        ==> locally connected s"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric euclidean_metric (s:real^N->bool)")
      ULC_SPACE_IMP_LOCALLY_CONNECTED_SPACE) THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN,
                ULC_SPACE_SUBMETRIC_EUCLIDEAN] THEN
    DISCH_THEN MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  let FCCOVERABLE_INTERMEDIATE_CLOSURE ← prove
   r"!s t:real^N->bool.
        s SUBSET t /\ t SUBSET closure s /\
        (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                           !t. t IN c ==> connected t /\ bounded t /\
                                          diameter t <= e)
        ==> (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = t /\
                                !t. t IN c ==> connected t /\ bounded t /\
                                               diameter t <= e)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM FCCOVERABLE_IN_EUCLIDEAN_METRIC,
                ← GSYM EUCLIDEAN_CLOSURE_OF, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    MATCH_ACCEPT_TAC FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE)

  let COMPACT_LOCALLY_CONNECTED_IMP_ULC ← prove
   r"!s:real^N->bool.
     compact s /\ locally connected s
     ==> (!e. &0 < e
              ==> ?d. &0 < d /\
                      !x y. x IN s /\ y IN s /\ dist(x,y) < d
                            ==> ?c. x IN c /\ y IN c /\ c SUBSET s /\
                                    connected c /\
                                    bounded c /\ diameter c <= e)"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric euclidean_metric (s:real^N->bool)")
      COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE) THEN
    REWRITE_TAC [SUBMETRIC_EUCLIDEAN_METRIC,
                COMPACT_IN_SUBMETRIC_EUCLIDEAN_MSPACE,
                LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN,
                ULC_SPACE_SUBMETRIC_EUCLIDEAN] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  let COMPACT_LOCALLY_CONNECTED_IMP_ULC_ALT ← prove
   r"!s:real^N->bool.
     compact s /\ locally connected s
     ==> !e. &0 < e
             ==> ?d. &0 < d /\ d < e /\
                     !x y. x IN s /\ y IN s /\ dist(x,y) < d
                           ==> ?c. connected c /\ x IN c /\ y IN c /\
                                   c SUBSET s INTER ball(x,e) INTER ball(y,e)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") COMPACT_LOCALLY_CONNECTED_IMP_ULC) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d e / &2") THEN
    REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [SUBSET_INTER] THEN
    CONJ_TAC THEN REWRITE_TAC [SUBSET, IN_BALL] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
    TRANS_TAC REAL_LET_TRANS (← q r"diameter(c:real^N->bool)") THEN
    REWRITE_TAC [dist] THEN ASM_SIMP_TAC [DIAMETER_BOUNDED_BOUND] THEN
    ASM_REAL_ARITH_TAC)

  let BOUNDED_ULC_IMP_FCCOVERABLE ← prove
   r"!s:real^N->bool.
        bounded s /\
        (!e. &0 < e
            ==> ?d. &0 < d /\
                    !x y. x IN s /\ y IN s /\ dist(x,y) < d
                          ==> ?c. x IN c /\ y IN c /\ c SUBSET s /\
                                  connected c /\ bounded c /\ diameter c <= e)
        ==> (!e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                           !t. t IN c ==> connected t /\ bounded t /\
                                          diameter t <= e)"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric euclidean_metric (s:real^N->bool)")
      TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE) THEN
    REWRITE_TAC [SUBMETRIC_EUCLIDEAN_METRIC,
                ULC_SPACE_SUBMETRIC_EUCLIDEAN, FCCOVERABLE_SPACE_SUBMETRIC_EUCLIDEAN] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC TOTALLY_BOUNDED_IN_SUBMETRIC THEN
    REWRITE_TAC [SUBSET_REFL] THEN
    MATCH_MP_TAC COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN THEN
    REWRITE_TAC [EUCLIDEAN_METRIC, SUBSET_UNIV,
                MTOPOLOGY_EUCLIDEAN_METRIC, EUCLIDEAN_CLOSURE_OF,
                COMPACT_IN_EUCLIDEAN, COMPACT_CLOSURE] THEN
    ASM_REWRITE_TAC [])

  let COMPACT_LOCALLY_CONNECTED_IMP_FCCOVERABLE ← prove
   r"!s:real^N->bool.
        compact s /\ locally connected s
        ==> !e. &0 < e ==> ?c. FINITE c /\ UNIONS c = s /\
                           !t. t IN c ==> connected t /\ bounded t /\
                                          diameter t <= e"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_LOCALLY_CONNECTED_IMP_ULC) THEN
    FIRST_X_ASSUM STRIP_ASSUME_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
    GEN_REWRITE_TAC id [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_ULC_IMP_FCCOVERABLE) THEN
    REWRITE_TAC [])

  let COMPACT_LOCALLY_CONNECTED_EQ_FCCCOVERABLE ← prove
   r"!s:real^N->bool.
       compact s /\ locally connected s <=>
       !e. &0 < e
           ==> ?c. FINITE c /\ UNIONS c = s /\
                   !t. t IN c ==> connected t /\ compact t /\ diameter t <= e"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [FIRST_ASSUM (MP_TAC o
        MATCH_MP COMPACT_LOCALLY_CONNECTED_IMP_FCCOVERABLE) THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:(real^N->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE closure (c:(real^N->bool)->bool)") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, CONNECTED_CLOSURE,
                   COMPACT_CLOSURE, DIAMETER_CLOSURE] THEN
      ASM_SIMP_TAC [← GSYM SIMPLE_IMAGE, ← GSYM CLOSURE_UNIONS] THEN
      ASM_SIMP_TAC [CLOSURE_EQ, COMPACT_IMP_CLOSED],
      CONJ_TAC THENL [ASM_MESON_TAC [COMPACT_UNIONS, REAL_LT_01], ALL_TAC] THEN
      MATCH_MP_TAC FCCOVERABLE_IMP_LOCALLY_CONNECTED THEN
      ASM_MESON_TAC [COMPACT_IMP_BOUNDED]])

  return { SUBMETRIC_EUCLIDEAN_METRIC, MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
           MBOUNDED_SUBMETRIC_EUCLIDEAN, MDIAMETER_SUBMETRIC_EUCLIDEAN,
           CONNECTED_IN_SUBTOPOLOGY_EUCLIDEAN, COMPACT_IN_SUBTOPOLOGY_EUCLIDEAN,
           CONNECTED_IN_SUBMETRIC_EUCLIDEAN, COMPACT_IN_SUBMETRIC_EUCLIDEAN_MSPACE,
           LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN,
           LOCALLY_COMPACT_SPACE_SUBMETRIC_EUCLIDEAN, CONNECTED_IN_SUBMETRIC_EUCLIDEAN_MSPACE,
           FCCOVERABLE_IN_EUCLIDEAN_METRIC, FCCOVERABLE_SPACE_SUBMETRIC_EUCLIDEAN,
           ULC_SPACE_SUBMETRIC_EUCLIDEAN, FCCOVERABLE_IMP_LOCALLY_CONNECTED,
           ULC_IMP_LOCALLY_CONNECTED, FCCOVERABLE_INTERMEDIATE_CLOSURE,
           COMPACT_LOCALLY_CONNECTED_IMP_ULC, COMPACT_LOCALLY_CONNECTED_IMP_ULC_ALT,
           BOUNDED_ULC_IMP_FCCOVERABLE, COMPACT_LOCALLY_CONNECTED_IMP_FCCOVERABLE,
           COMPACT_LOCALLY_CONNECTED_EQ_FCCCOVERABLE }

/- ------------------------------------------------------------------------- -/
/- Localization of "property S".  (paths.ml 8141-8591)                       -/
/- ------------------------------------------------------------------------- -/

structure PTX where
  LOCALLY_FCCOVERABLE : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPTX [HolBase] (D : PathsDeps) (BS : PTS) (BW : PTW) : ExceptT String IO PTX := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH,
        NORM_ARITH, .. } := D.cvx
