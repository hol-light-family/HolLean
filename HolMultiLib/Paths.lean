        ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s DIFF t SUBSET u ==> s INTER u SUBSET v ==> s DIFF t SUBSET v"))) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"d SUBSET UNIV DIFF c ==> s INTER c SUBSET s DIFF d")) THEN
      ASM_SIMP_TAC [CLOSURE_MINIMAL_EQ, ← GSYM OPEN_CLOSED] THEN
      ASM SET_TAC [])
    let LOCALLY_DIMENSION_LE' ← prove
     r"!s:real^N->bool n.
            (subtopology euclidean s) dimension_le n <=>
            -- &1 <= n /\
            locally (\u. (subtopology euclidean u) dimension_le n) s"
     (REPEAT GEN_TAC THEN EQ_TAC THENL
       [DISCH_TAC THEN
        CONJ_TAC THENL [ASM_MESON_TAC [DIMENSION_LE_BOUND], ALL_TAC] THEN
        REWRITE_TAC [locally] THEN
        MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"v:real^N->bool", ← q r"v:real^N->bool"] THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"v:real^N->bool") o MATCH_MP
          DIMENSION_LE_SUBTOPOLOGY) THEN
        REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN SET_TAC [],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [DIMENSION_LE_EQ'] THEN
      REWRITE_TAC [locally] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s INTER v:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, LEFT_IMP_EXISTS_THM, IN_INTER] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"u:real^N->bool"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?b:real^N->bool. a IN b /\ open b /\ s INTER closure b SUBSET w")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_CBALL]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:real^N"))) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"ball(a:real^N,r)") THEN
        ASM_SIMP_TAC [CLOSURE_BALL, OPEN_BALL, CENTRE_IN_BALL] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"b INTER v:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_INTER, IN_INTER] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"s INTER frontier c:real^N->bool = u INTER frontier c")
