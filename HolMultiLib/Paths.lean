      ExceptT String IO (thm × thm × thm × thm × thm))

  return { dimension, DIMENSION_GE, DIMENSION_LE_IMP_GE, HOMEOMORPHIC_DIMENSION,
           DIMENSION_LE_EQ, LOCALLY_DIMENSION_LE, DIMENSION_LE_AFF_DIM,
           DIMENSION_DIMENSION_LE }

