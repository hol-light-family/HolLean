  -- @@SCOPE END

  let DIMENSION_PCROSS_LE ← prove
   r"!s:real^M->bool t:real^N->bool.
       ~(s = {} /\ t = {})
       ==> dimension(s PCROSS t) <= dimension s + dimension t"
   (SUBGOAL_THEN
     (← q r"!n s:real^M->bool t:real^N->bool.
