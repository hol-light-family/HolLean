    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~(t:real^N->bool = {})") MP_TAC THENL
     [ASM_MESON_TAC [AFF_DIM_EQ_MINUS1], ALL_TAC] THEN
