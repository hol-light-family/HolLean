structure PUB where
  CONTINUOUS_EQ_COMPACT_PATH_CONNECTED_PRESERVING : thm
  CONNECTED_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON : thm
  CONNECTED_CONNECTED_IMP_CLOSED_POINTIMAGES : thm
  CONNECTED_CONNECTED_POINTIMAGES_IMP_CONTINUOUS_ON : thm
  CLOSED_CLOSED_PREIMAGES_IMP_CONTINUOUS_ON : thm
  CLOSED_CONNECTED_PREIMAGES_IMP_CONTINUOUS_ON : thm
  BICONNECTED_IMP_CONTINUOUS_ON : thm
  deriving Inhabited

@[nospecialize]
def setupPUB [HolBase] (D : PathsDeps) (BL : PTL) (BS : PTS) (BZ : PTZ) (BUA : PUA) :
    ExceptT String IO PUB := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DE_MORGAN_THM, FINITE_IMAGE, FINITE_UNIONS, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_UNION, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, .. } := D.cvx.core3
  let { REAL_LT_IMP_NZ, .. } := D.cvx.core4
  let { SIMPLE_IMAGE, SUBSET, SUBSET_DIFF, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNIONS_GSPEC, o_DEF, .. } := D.cvx.core6
  let { DIST_REFL, DIST_SYM, .. } := D.cvx.vec1
  let { EVENTUALLY_SEQUENTIALLY, OPEN_IN_DIFF, .. } := D.cvx.met
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED, CONNECTED_CLOSED_IN, CONNECTED_INSERT,
        CONNECTED_INTER_FRONTIER, .. } := D.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, FRONTIER_BALL, .. } :=
    D.cvx.top3
  let { IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        IN_SPHERE, LIM_SUBSEQUENCE, .. } := D.cvx.top4
  let { OPEN_IN_OPEN_INTER, OPEN_IN_REFL, UNIONS_COMPONENTS, closure, continuous_on, open_in,
        .. } := D.cvx.top5
  let { INFINITE, INFINITE_ENUMERATE, INFINITE_SUPERSET, .. } := D.pses1
  let { UPPER_BOUND_FINITE_SET, .. } := D.pmisc
  let { CLOSED_IN_EMPTY, CLOSED_IN_UNION, .. } := D.pmet1
  let { CLOSED_IN_COMPACT, CLOSED_IN_LIMPT, CLOSED_IN_SING, CLOSED_SUBSET_EQ, .. } := D.ptop1
  let { CONNECTED_INSERT_LIMPT, .. } := D.ptop2
  let { CONTINUOUS_WITHIN_SEQUENTIALLY_INJ, .. } := D.ptop3
  let { LIMIT_POINT_OF_LOCAL, LIMPT_SEQUENTIAL, .. } := D.ptop4
  let { SPHERE_1, TENDSTO_ALT, .. } := D.ptop5
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_CONTINUOUS_IMAGE, .. } := BL
  let { LOCALLY_CONNECTED, .. } := BS
  let { SEMI_LOCALLY_CONNECTED_GEN, .. } := BZ
  let { COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON,
        CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN, .. } := BUA
  -- @@SCOPE END

  let CONTINUOUS_EQ_COMPACT_PATH_CONNECTED_PRESERVING ← prove
   r"!f:real^M->real^N s.
     locally path_connected s
     ==> (f continuous_on s <=>
          (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\
          (!c. c SUBSET s /\ path_connected c ==> path_connected(IMAGE f c)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [COMPACT_CONTINUOUS_IMAGE, PATH_CONNECTED_CONTINUOUS_IMAGE,
                    CONTINUOUS_ON_SUBSET],
      STRIP_TAC THEN FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:real^M->real^N") o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN)) THEN
      ASM_MESON_TAC [PATH_CONNECTED_IMP_CONNECTED]])

  let CONNECTED_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON ← prove
   r"!f:real^N->real^1 s t.
        IMAGE f s SUBSET t /\
        locally connected s /\
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
        (!y. closed_in (subtopology euclidean s) {x | x IN s /\ f x = y})
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_on] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"s DIFF {y:real^N | y IN s /\ f y IN sphere(f x:real^1,e)}",
      ← q r"x:real^N"]) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
        ASM_SIMP_TAC [SPHERE_1, ← REAL_ARITH (← q r"&0 < e ==> ~(e < &0)")] THEN
        ASM_SIMP_TAC [CLOSED_IN_UNION, ← SET_RULE
         (← q r"{x | x IN s /\ f x IN {a,b}} =
          {x | x IN s /\ f x = a} UNION {x | x IN s /\ f x = b}")],
        ASM_REWRITE_TAC [IN_DIFF, IN_ELIM_THM, IN_SPHERE, DIST_REFL] THEN
        ASM_SIMP_TAC [REAL_LT_IMP_NZ]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [open_in]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:real^N"))) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"IMAGE (f:real^N->real^1) u SUBSET ball(f x,e)") MP_TAC THENL
       [MP_TAC (← ISPECL
         [← q r"IMAGE (f:real^N->real^1) u", ← q r"ball((f:real^N->real^1) x,e)"]
         CONNECTED_INTER_FRONTIER) THEN
        ASM_SIMP_TAC [FRONTIER_BALL] THEN
        SUBGOAL_THEN (← q r"(f:real^N->real^1) x IN ball(f x,e)") MP_TAC THENL
         [ASM_REWRITE_TAC [CENTRE_IN_BALL], ASM SET_TAC []],
        REWRITE_TAC [IN_BALL, FORALL_IN_IMAGE, SUBSET] THEN
        ASM_MESON_TAC [DIST_SYM]]])

  let CONNECTED_CONNECTED_IMP_CLOSED_POINTIMAGES ← prove
   r"!f:real^M->real^N s.
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
        (!y. connected {x | x IN s /\ f x = y})
        ==> !y. closed_in (subtopology euclidean s) {x | x IN s /\ f x = y}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"b:real^N") THEN
    ABBREV_TAC (← q r"t = {x | x IN s /\ (f:real^M->real^N) x = b}") THEN
    ASM_CASES_TAC (← q r"t:real^M->bool = {}") THEN ASM_SIMP_TAC [CLOSED_IN_EMPTY] THEN
    REWRITE_TAC [CLOSED_IN_LIMPT] THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"a:real^M")] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^N")) THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"connected(IMAGE (f:real^M->real^N) (a INSERT t))")
    MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [CONNECTED_INSERT_LIMPT] THEN ASM SET_TAC [],
      REWRITE_TAC [CONNECTED_CLOSED_IN, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"{b:real^N}", ← q r"{(f:real^M->real^N) a}"]) THEN
      REWRITE_TAC [CLOSED_IN_SING] THEN ASM SET_TAC []])

  let CONNECTED_CONNECTED_POINTIMAGES_IMP_CONTINUOUS_ON ← prove
   r"!f:real^N->real^1 s t.
        IMAGE f s SUBSET t /\
        locally connected s /\
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
        (!y. connected {x | x IN s /\ f x = y})
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON THEN
    EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONNECTED_CONNECTED_IMP_CLOSED_POINTIMAGES THEN
    ASM_REWRITE_TAC [])

  let CLOSED_CLOSED_PREIMAGES_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s t.
        compact t /\
        (!y. closed_in (subtopology euclidean s) {x | x IN s /\ f x = y}) /\
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c))
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_IN_COMPACT THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [CLOSED_SUBSET_EQ, COMPACT_IMP_CLOSED])

  let CLOSED_CONNECTED_PREIMAGES_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s t.
        compact t /\
        (!y. connected {x | x IN s /\ f x = y}) /\
        (!c. closed_in (subtopology euclidean s) c
             ==> closed_in (subtopology euclidean t) (IMAGE f c)) /\
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c))
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_CLOSED_PREIMAGES_IMP_CONTINUOUS_ON THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONNECTED_CONNECTED_IMP_CLOSED_POINTIMAGES THEN
    ASM_REWRITE_TAC [])

  let BICONNECTED_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s t.
        FINITE (components t) /\ locally compact t /\ locally connected t /\
        IMAGE f s = t /\
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
        (!c. c SUBSET t /\ connected c ==> connected {x | x IN s /\ f x IN c})
        ==> f continuous_on s"
   (← do
    let lemma ← prove
     r"{n | f n IN UNIONS a} = UNIONS {{n | f n IN s} | s IN a}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    pure (
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    X_GEN_TAC (← q r"p:real^M") THEN DISCH_TAC THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY_INJ] THEN
    X_GEN_TAC (← q r"x:num->real^M") THEN STRIP_TAC THEN
    REWRITE_TAC [TENDSTO_ALT, EVENTUALLY_SEQUENTIALLY, o_DEF] THEN
    X_GEN_TAC (← q r"v:real^N->bool") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"FINITE {n:num | (f:real^M->real^N) (x n) IN (t DIFF v)}") THENL
     [FIRST_ASSUM (MP_TAC o ISPEC (← q r"\n:num. n") o
        MATCH_MP UPPER_BOUND_FINITE_SET) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_DIFF] THEN MATCH_MP_TAC (← MESON []
       (← q r"(!n. P n ==> Q(SUC n)) ==> (?n. P n) ==> (?n. Q n)")) THEN
      X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"n:num") THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"~(SUC m <= n) <=> n <= m")] THEN ASM SET_TAC [],
      MATCH_MP_TAC (← TAUT (← q r"F ==> p"))] THEN
    SUBGOAL_THEN
     (← q r"?u. open_in (subtopology euclidean t) u /\
          (f:real^M->real^N) p IN u /\
          u SUBSET v /\
          INFINITE {n:num | (f:real^M->real^N) (x n) IN t DIFF u} /\
          FINITE(components(t DIFF u))")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"t:real^N->bool") SEMI_LOCALLY_CONNECTED_GEN) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPECL
       [← q r"(f:real^M->real^N) p", ← q r"t INTER v:real^N->bool"]) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM INFINITE]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INFINITE_SUPERSET)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?c. c IN components (t DIFF u) /\
                      INFINITE {n:num | (f:real^M->real^N)(x n) IN c}")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"INFINITE {n:num | (f:real^M->real^N)(x n) IN t DIFF u}") THEN
      MP_TAC (← ISPEC (← q r"t DIFF u:real^N->bool") UNIONS_COMPONENTS) THEN
      DISCH_THEN (fun th =>
        GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [th]) THEN
      REWRITE_TAC [lemma, INFINITE, FINITE_UNIONS] THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"(p:real^M) INSERT {x | x IN s /\ (f:real^M->real^N) x IN c}")) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_INSERT_LIMPT THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"t DIFF u:real^N->bool") THEN
          REWRITE_TAC [SUBSET_DIFF] THEN ASM_MESON_TAC [IN_COMPONENTS_SUBSET],
          ASM_MESON_TAC [IN_COMPONENTS_CONNECTED]],
        FIRST_ASSUM (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [LIMPT_SEQUENTIAL] THEN
        EXISTS_TAC (← q r"(x:num->real^M) o (r:num->num)") THEN
        ASM_SIMP_TAC [LIM_SUBSEQUENCE] THEN
        REWRITE_TAC [o_DEF, IN_ELIM_THM] THEN ASM SET_TAC []],
      SUBGOAL_THEN
       (← q r"IMAGE f (p INSERT {x | x IN s /\ f x IN c}) =
        (f:real^M->real^N)(p) INSERT c")
      SUBST1_TAC THENL
       [MP_TAC (← ISPECL [← q r"t DIFF u:real^N->bool", ← q r"c:real^N->bool"]
          IN_COMPONENTS_SUBSET) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      ASM_SIMP_TAC [CONNECTED_INSERT] THEN
      REWRITE_TAC [closure, IN_UNION, DE_MORGAN_THM, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"c:real^N->bool",
                     ← q r"(f:real^M->real^N) p"]
          LIMIT_POINT_OF_LOCAL) THEN
      ASM SET_TAC []]))

  return { CONTINUOUS_EQ_COMPACT_PATH_CONNECTED_PRESERVING,
           CONNECTED_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON,
           CONNECTED_CONNECTED_IMP_CLOSED_POINTIMAGES,
           CONNECTED_CONNECTED_POINTIMAGES_IMP_CONTINUOUS_ON,
           CLOSED_CLOSED_PREIMAGES_IMP_CONTINUOUS_ON,
           CLOSED_CONNECTED_PREIMAGES_IMP_CONTINUOUS_ON, BICONNECTED_IMP_CONTINUOUS_ON }

/- ------------------------------------------------------------------------- -/
/- Topological characterizations of non-strict monotonicity.                 -/
/- (paths.ml 9887-10141)                                                     -/
/- ------------------------------------------------------------------------- -/

structure PUC where
  MONOTONE_TOPOLOGICALLY_IMP : thm
  MONOTONE_TOPOLOGICALLY_EQ : thm
  MONOTONE_TOPOLOGICALLY : thm
  MONOTONE_TOPOLOGICALLY_INTO_1D_EQ : thm
  MONOTONE_TOPOLOGICALLY_INTO_1D : thm
  MONOTONE_TOPOLOGICALLY_POINTS : thm
  MONOTONE_TOPOLOGICALLY_POINTS_IMP : thm
  MONOTONE_IMP_HOMEOMORPHISM_1D : thm
  MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP : thm
  MONOTONE_INTO_1D_IMP_PROPER_MAP : thm
  MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupPUC [HolBase] (D : PathsDeps) (BL : PTL) (BN : PTN) (BS : PTS) (BT : PTT)
    (BUA : PUA) (BUB : PUB) : ExceptT String IO PUC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, EQ_IMP, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMAGE_o, IMP_CONJ, INJECTIVE_ON_ALT, .. } := D.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_FORALL, NOT_EXISTS_THM, NOT_IMP, .. } :=
    D.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LT_IMP_LE, REAL_LT_REFL, .. } := D.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SUBSET_REFL, SUBSET_RESTRICT, .. } :=
    D.cvx.core5
  let { SUBSET_UNIV, o_DEF, o_THM, .. } := D.cvx.core6
  let { REAL_NON_MONOTONE, .. } := D.cvx.misc
  let { DROP_EQ, FORALL_DROP, FORALL_LIFT, LIFT_DROP, .. } := D.cvx.vec2
  let { CLOSED_IN_DIFF, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_SUBSET, .. } := D.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED,
        CONNECTED_CONTINUOUS_IMAGE, CONNECTED_IN_EUCLIDEAN, CONNECTED_OPEN_IN, .. } :=
    D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IS_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.pses1
  let { DROP_IN_IMAGE_DROP, FORALL_DROP_IMAGE, .. } := D.pvec
  let { CLOSED_IN_IMP_SUBSET, CONNECTED_IN_SUBTOPOLOGY, .. } := D.pmet1
  let { MONOTONE_MAP, MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT, TOPSPACE_EUCLIDEANREAL, .. } :=
    D.pmet2
  let { CLOSED_IN_COMPACT, CLOSED_IN_LIMPT, .. } := D.ptop1
  let { CONNECTED_EMPTY, CONNECTED_SING, CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, CONNECTED_UNIV,
        CONTINUOUS_MAP_EQ_DROP, CONTINUOUS_MAP_EUCLIDEAN, .. } := D.ptop2
  let { IS_INTERVAL_1_CASES, IS_REALINTERVAL_IS_INTERVAL, LIMIT_POINT_OF_LOCAL,
        LOCALLY_COMPACT_COMPACT, LOCALLY_COMPACT_OPEN_IN, .. } := D.ptop4
  let { OPEN_IN_DIFF_CLOSED, PROPER_MAP, .. } := D.ptop5
  let { CONVEX_CONNECTED_1, .. } := D.pcvx1
  let { IS_INTERVAL_CONNECTED, IS_INTERVAL_CONNECTED_1, IS_INTERVAL_CONVEX_1, .. } := D.pcvx2
  let { IS_INTERVAL_PATH_CONNECTED, .. } := BL
  let { INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM, .. } := BN
  let { LOCALLY_CONNECTED, .. } := BS
  let { CONVEX_IMP_LOCALLY_CONNECTED, .. } := BT
  let { COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON, .. } := BUA
  let { CONNECTED_CONNECTED_POINTIMAGES_IMP_CONTINUOUS_ON, .. } := BUB
  -- @@SCOPE END

  let MONOTONE_TOPOLOGICALLY_IMP ← prove
   r"!f s. (!c. connected c ==> connected {x | x IN s /\ f x IN c})
         ==> (!x y. x IN s /\ y IN s /\ drop x <= drop y
                     ==> drop(f x) <= drop(f y)) \/
              (!x y. x IN s /\ y IN s /\ drop x <= drop y
                     ==> drop(f y) <= drop(f x))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [FORALL_LIFT, REAL_NON_MONOTONE, LIFT_DROP] THEN
    REWRITE_TAC [NOT_EXISTS_THM, FORALL_DROP, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"] THEN
    STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y | drop y < drop(f(b:real^1))}")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y | drop(f(b:real^1)) < drop y}"))] THEN
    REWRITE_TAC [NOT_IMP, ← GSYM IS_INTERVAL_CONNECTED_1] THEN
    (CONJ_TAC THENL
      [REWRITE_TAC [IS_INTERVAL_1_CASES] THEN SET_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [IS_INTERVAL_1, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"c:real^1", ← q r"b:real^1"]) THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LT_REFL])

  let MONOTONE_TOPOLOGICALLY_EQ ← prove
   r"!f s. (!c. connected c ==> connected {x | x IN s /\ f x IN c}) <=>
         is_interval s /\
         ((!x y. x IN s /\ y IN s /\ drop x <= drop y
                 ==> drop(f x) <= drop(f y)) \/
          (!x y. x IN s /\ y IN s /\ drop x <= drop y
                 ==> drop(f y) <= drop(f x)))"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [MONOTONE_TOPOLOGICALLY_IMP] THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"(:real^1)")) THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ f x IN UNIV} = s")] THEN
      REWRITE_TAC [CONNECTED_UNIV, ← GSYM IS_INTERVAL_CONNECTED_1],
      REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1] THEN SET_TAC []])

  let MONOTONE_TOPOLOGICALLY ← prove
   r"!f s. is_interval s
         ==> ((!x y. x IN s /\ y IN s /\ drop x <= drop y
                     ==> drop(f x) <= drop(f y)) \/
              (!x y. x IN s /\ y IN s /\ drop x <= drop y
                     ==> drop(f y) <= drop(f x)) <=>
              !c. connected c ==> connected {x | x IN s /\ f x IN c})"
   (SIMP_TAC [MONOTONE_TOPOLOGICALLY_EQ])

  let MONOTONE_TOPOLOGICALLY_INTO_1D_EQ ← prove
   r"!f:real^N->real^1 s.
        f continuous_on s
        ==> ((!k. connected k ==> connected {x | x IN s /\ f x IN k}) <=>
             connected s /\ (!y. connected {x | x IN s /\ f x = y}))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [CONTINUOUS_MAP_EQ_DROP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT) THEN
    REWRITE_TAC [MONOTONE_MAP, CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV,
                TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEAN, o_THM, FORALL_DROP, DROP_EQ] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_DROP_IMAGE, DROP_IN_IMAGE_DROP] THEN
    REWRITE_TAC [IS_REALINTERVAL_IS_INTERVAL] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LIFT_DROP, IMAGE_ID] THEN
    REWRITE_TAC [IS_INTERVAL_CONNECTED_1])

  let MONOTONE_TOPOLOGICALLY_INTO_1D ← prove
   r"!f:real^N->real^1 s.
        connected s /\ f continuous_on s /\
        (!y. connected {x | x IN s /\ f x = y})
        ==> (!k. connected k ==> connected {x | x IN s /\ f x IN k})"
   (MESON_TAC [MONOTONE_TOPOLOGICALLY_INTO_1D_EQ])

  let MONOTONE_TOPOLOGICALLY_POINTS ← prove
   r"!f:real^1->real^1 s.
        is_interval s /\ f continuous_on s
        ==> ((!x y. x IN s /\ y IN s /\ drop x <= drop y
                    ==> drop(f x) <= drop(f y)) \/
             (!x y. x IN s /\ y IN s /\ drop x <= drop y
                    ==> drop(f y) <= drop(f x)) <=>
             !a. connected {x | x IN s /\ f x = a})"
   (SIMP_TAC [MONOTONE_TOPOLOGICALLY, MONOTONE_TOPOLOGICALLY_INTO_1D_EQ] THEN
    SIMP_TAC [IS_INTERVAL_CONNECTED])

  let MONOTONE_TOPOLOGICALLY_POINTS_IMP ← prove
   r"!f s. f continuous_on s /\ is_interval s /\
         (!y. connected {x | x IN s /\ f x = y})
         ==> (!x y. x IN s /\ y IN s /\ drop x <= drop y
                    ==> drop(f x) <= drop(f y)) \/
             (!x y. x IN s /\ y IN s /\ drop x <= drop y
                    ==> drop(f y) <= drop(f x))"
   (SIMP_TAC [MONOTONE_TOPOLOGICALLY_POINTS])

  let MONOTONE_IMP_HOMEOMORPHISM_1D ← prove
   r"!f s t.
        is_interval s /\ is_interval t /\ IMAGE f s = t /\
        ((!x y. x IN s /\ y IN s /\ drop x < drop y
                ==> drop(f x) < drop(f y)) \/
         (!x y. x IN s /\ y IN s /\ drop x < drop y
                ==> drop(f x) < drop(f y)))
        ==> ?g. homeomorphism(s,t) (f,g)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s ==> ((f:real^1->real^1) x = f y <=> x = y)")
    ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM INJECTIVE_ON_ALT] THEN
      REWRITE_TAC [← GSYM DROP_EQ, ← GSYM REAL_LE_ANTISYM] THEN
      ASM_MESON_TAC [REAL_NOT_LE],
      ALL_TAC] THEN
    EXPAND_TAC "t" THEN
    W (MP_TAC o PART_MATCH (rand o rand) INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM o
          snd) THEN
    ASM_REWRITE_TAC [INJECTIVE_ON_ALT] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [IS_INTERVAL_PATH_CONNECTED] THEN
    MATCH_MP_TAC CONNECTED_CONNECTED_POINTIMAGES_IMP_CONTINUOUS_ON THEN
    EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    ASM_SIMP_TAC [CONVEX_IMP_LOCALLY_CONNECTED, ← GSYM IS_INTERVAL_CONVEX_1] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool"]
          INJECTIVE_ON_LEFT_INVERSE) THEN
      ASM_REWRITE_TAC [INJECTIVE_ON_ALT] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"g:real^1->real^1")) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^1", ← q r"t:real^1->bool"]
          MONOTONE_TOPOLOGICALLY) THEN
      ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [← GSYM REAL_NOT_LT, CONTRAPOS_THM] THEN
      DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], MATCH_MP_TAC MONO_FORALL] THEN
      X_GEN_TAC (← q r"c:real^1->bool") THEN
      DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"y:real^1") THEN
      SUBGOAL_THEN (← q r"{x | x IN s /\ (f:real^1->real^1) x = y} = {} \/
                    ?a. {x | x IN s /\ f x = y} = {a}")
      MP_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"(!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
            ==> {x | x IN s /\ f x = a} = {} \/
                ?b. {x | x IN s /\ f x = a} = {b}")) THEN
        ASM_MESON_TAC [],
        STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_EMPTY, CONNECTED_SING]]])

  let MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\ locally compact s /\ locally connected t /\
        f continuous_on s /\
        (!y. compact {x | x IN s /\ f x = y}) /\
        (!c. c SUBSET t /\ connected c ==> connected {x | x IN s /\ f x IN c})
        ==> (!k. k SUBSET t /\ compact k
                 ==> compact {x | x IN s /\ f x IN k})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [PROPER_MAP, SUBSET_REFL] THEN
    X_GEN_TAC (← q r"k:real^M->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    REWRITE_TAC [CLOSED_IN_LIMPT] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"y:real^N") THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q ==> r <=> q /\ ~r ==> ~p")] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"s DIFF k:real^M->bool"]
          LOCALLY_COMPACT_OPEN_IN) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL] THEN
    REWRITE_TAC [LOCALLY_COMPACT_COMPACT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"{x | x IN s /\ (f:real^M->real^N) x = y}")) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^M->bool"] THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"b:real^M->bool = closure u DIFF u") THEN
    SUBGOAL_THEN (← q r"(b:real^M->bool) SUBSET v") ASSUME_TAC THENL
     [EXPAND_TAC "b" THEN MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET u ==> s DIFF t SUBSET u")) THEN
      MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"compact(b:real^M->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_COMPACT THEN EXISTS_TAC (← q r"v:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "b" THEN MATCH_MP_TAC CLOSED_IN_DIFF THEN CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_SUBSET THEN REWRITE_TAC [CLOSED_CLOSURE] THEN
        ASM SET_TAC [],
        MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
        EXISTS_TAC (← q r"s DIFF k:real^M->bool") THEN ASM SET_TAC []],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"t DIFF IMAGE (f:real^M->real^N) b", ← q r"y:real^N"]) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC CLOSED_SUBSET THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^N->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL
       [← q r"t:real^N->bool", ← q r"IMAGE (f:real^M->real^N) k", ← q r"y:real^N"]
          LIMIT_POINT_OF_LOCAL) THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"r:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPEC (← q r"{x | x IN s /\ (f:real^M->real^N) x IN r}")
          CONNECTED_OPEN_IN) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (r ==> q) ==> (p <=> ~q) ==> ~r")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET], DISCH_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN s /\ (f:real^M->real^N) x IN r} INTER u",
      ← q r"{x | x IN s /\ (f:real^M->real^N) x IN r} DIFF closure u"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_INTER THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"s DIFF k:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
      ASM_REWRITE_TAC [OPEN_IN_REFL],
      SIMP_TAC [OPEN_IN_DIFF_CLOSED, CLOSED_CLOSURE],
      ASM SET_TAC [],
      MP_TAC (← ISPEC (← q r"u:real^M->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
      ASM SET_TAC [],
      ASM SET_TAC []]])

  let MONOTONE_INTO_1D_IMP_PROPER_MAP ← prove
   r"!f:real^N->real^1 s t.
      connected s /\ locally compact s /\
      f continuous_on s /\ IMAGE f s = t /\
      (!y. compact {x | x IN s /\ f x = y}) /\
      (!y. connected {x | x IN s /\ f x = y})
      ==> (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONVEX_IMP_LOCALLY_CONNECTED THEN
      REWRITE_TAC [CONVEX_CONNECTED_1] THEN
      ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE],
      ASM_MESON_TAC [MONOTONE_TOPOLOGICALLY_INTO_1D]])

  let MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP_GEN ← prove
   r"!f:real^M->real^N s t.
        IMAGE f s = t /\ locally compact s /\ locally connected t /\
        (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\
        (!y. compact {x | x IN s /\ f x = y}) /\
        (!c. c SUBSET t /\ connected c ==> connected {x | x IN s /\ f x IN c})
        ==> (!k. k SUBSET t /\ compact k
                 ==> compact {x | x IN s /\ f x IN k})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON THEN
    ASM_REWRITE_TAC [] THEN GEN_TAC THEN
    MATCH_MP_TAC CLOSED_SUBSET THEN REWRITE_TAC [SUBSET_RESTRICT] THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED])

  return { MONOTONE_TOPOLOGICALLY_IMP, MONOTONE_TOPOLOGICALLY_EQ, MONOTONE_TOPOLOGICALLY,
           MONOTONE_TOPOLOGICALLY_INTO_1D_EQ, MONOTONE_TOPOLOGICALLY_INTO_1D,
           MONOTONE_TOPOLOGICALLY_POINTS, MONOTONE_TOPOLOGICALLY_POINTS_IMP,
           MONOTONE_IMP_HOMEOMORPHISM_1D, MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP,
           MONOTONE_INTO_1D_IMP_PROPER_MAP, MONOTONE_CONNECTED_PREIMAGES_IMP_PROPER_MAP_GEN }

/- ------------------------------------------------------------------------- -/
/- Sura-Bura's results about compact components of sets.                     -/
/- (paths.ml 10142-10304)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PUD where
  SURA_BURA_COMPACT : thm
  SURA_BURA_CLOPEN_SUBSET : thm
  SURA_BURA_CLOPEN_SUBSET_ALT : thm
  SURA_BURA : thm
  COMPONENT_CLOPEN_HAUSDIST_EXPLICIT : thm
  COMPONENT_CLOPEN_HAUSDIST : thm
  deriving Inhabited

@[nospecialize]
def setupPUD [HolBase] (D : PathsDeps) : ExceptT String IO PUD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ACI, CONTRAPOS_THM, FINITE_EMPTY, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { IMP_CONJ, INTERS_0, INTER_UNIV, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTERS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.cvx.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { VECTOR_ADD_RID, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS, .. } := D.cvx.met
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, CENTRE_IN_CBALL, CLOSED_IMP_LOCALLY_COMPACT,
        CLOSED_SING, .. } := D.cvx.top1
  let { COMPACT_COMPONENTS, COMPACT_IMP_CLOSED, COMPACT_INTERS, .. } := D.cvx.top2
  let { HAUSDIST_EMPTY, .. } := D.cvx.top3
  let { IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_INTER, OPEN_IN_OPEN, OPEN_IN_REFL, REAL_HAUSDIST_LE_SUMS, .. } := D.cvx.top5
  let { COMPACT_IN_SUBTOPOLOGY, COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF,
        HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := D.pmet1
  let { OPEN_IN_INTERS, QUASI_COMPONENTS_OF_SET, .. } := D.pmet2
  let { CLOSED_IMP_FIP_COMPACT, CLOSED_IN_COMPACT_EQ, COMPACT_IN_EUCLIDEAN, .. } := D.ptop1
  let { COMPONENTS_INTERMEDIATE_SUBSET, .. } := D.ptop2
  let { EUCLIDEAN_CONNECTED_COMPONENTS_OF, HAUSDORFF_SPACE_EUCLIDEAN, .. } := D.ptop3
  let { LOCALLY_COMPACT_COMPACT_SUBOPEN, LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN, .. } :=
    D.ptop4
  let { OPEN_CLOSED, OPEN_SUMS, SEPARATION_NORMAL, .. } := D.ptop5
  -- @@SCOPE END

  let SURA_BURA_COMPACT ← prove
   r"!s c:real^N->bool.
        compact s /\ c IN components s
        ==> c = INTERS {t | c SUBSET t /\
                            open_in (subtopology euclidean s) t /\
                            closed_in (subtopology euclidean s) t}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (s:real^N->bool)", ← q r"c:real^N->bool"]
          COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF) THEN
    ASM_REWRITE_TAC [LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    ASM_REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_EUCLIDEAN] THEN
    ASM_SIMP_TAC [EUCLIDEAN_CONNECTED_COMPONENTS_OF, IN_COMPONENTS_SUBSET] THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_EUCLIDEAN, HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_LOCALLY_COMPACT] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [COMPACT_COMPONENTS], ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do pure (GEN_REWRITE_TAC LAND_CONV
     [← GSYM (← MATCH_MP QUASI_COMPONENTS_OF_SET th)])) THEN
    REWRITE_TAC [CONJ_ACI])

  let SURA_BURA_CLOPEN_SUBSET ← prove
   r"!s c u:real^N->bool.
        locally compact s /\
        c IN components s /\ compact c /\
        open u /\ c SUBSET u
        ==> ?k. open_in (subtopology euclidean s) k /\ compact k /\
                c SUBSET k /\ k SUBSET u"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_COMPACT_COMPACT_SUBOPEN]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"c:real^N->bool", ← q r"u:real^N->bool"]) THEN
    ASM_SIMP_TAC [IN_COMPONENTS_SUBSET, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"k:real^N->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"c:real^N->bool"]
         SURA_BURA_COMPACT) THEN
    ASM_SIMP_TAC [CLOSED_IN_COMPACT_EQ] THEN ANTS_TAC THENL
     [MATCH_MP_TAC COMPONENTS_INTERMEDIATE_SUBSET THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_THEN (ASSUME_TAC o SYM)] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
    MP_TAC (← ISPECL
     [← q r"(:real^N) DIFF (u INTER w)",
      ← q r"{t:real^N->bool | c SUBSET t /\ open_in (subtopology euclidean k) t /\
                         compact t /\ t SUBSET k}"]
     CLOSED_IMP_FIP_COMPACT) THEN
    ASM_SIMP_TAC [← GSYM OPEN_CLOSED, OPEN_INTER, FORALL_IN_GSPEC] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [SUBSET] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_ELIM_THM, ← SET_RULE
      (← q r"(UNIV DIFF u) INTER s = {} <=> s SUBSET u")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:(real^N->bool)->bool") MP_TAC) THEN
    ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, INTERS_0, FINITE_EMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"UNIV SUBSET s INTER t <=> s = UNIV /\ t = UNIV")] THEN
      DISCH_THEN (CONJUNCTS_THEN SUBST_ALL_TAC) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTER_UNIV]) THEN
      UNDISCH_THEN (← q r"s:real^N->bool = v") (SUBST_ALL_TAC o SYM) THEN
      SUBGOAL_THEN (← q r"k:real^N->bool = s") SUBST_ALL_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [SUBSET_UNIV]] THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [IN_COMPONENTS_SUBSET, OPEN_IN_REFL],
      STRIP_TAC THEN EXISTS_TAC (← q r"INTERS f:real^N->bool") THEN
      ASM_SIMP_TAC [COMPACT_INTERS] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"v:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
      EXISTS_TAC (← q r"k:real^N->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_INTERS THEN ASM_SIMP_TAC [],
        EXPAND_TAC "v" THEN REWRITE_TAC [SUBSET_INTER] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!t. t IN f ==> t SUBSET s) /\ ~(f = {}) ==> INTERS f SUBSET s")) THEN
        ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, SUBSET_TRANS]]])

  let SURA_BURA_CLOPEN_SUBSET_ALT ← prove
   r"!s c u:real^N->bool.
        locally compact s /\
        c IN components s /\ compact c /\
        open_in (subtopology euclidean s) u /\ c SUBSET u
        ==> ?k. open_in (subtopology euclidean s) k /\ compact k /\
                c SUBSET k /\ k SUBSET u"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") (STRIP_ASSUME_TAC o GSYM)) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N->bool", ← q r"v:real^N->bool"]
          SURA_BURA_CLOPEN_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
    ASM SET_TAC [])

  let SURA_BURA ← prove
   r"!s c:real^N->bool.
        locally compact s /\ c IN components s /\ compact c
        ==> c = INTERS {k | c SUBSET k /\ compact k /\
                            open_in (subtopology euclidean s) k}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"{x:real^N}", ← q r"c:real^N->bool"] SEPARATION_NORMAL) THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N->bool", ← q r"v:real^N->bool"]
          SURA_BURA_CLOPEN_SUBSET) THEN
    ASM_REWRITE_TAC [IN_INTERS, NOT_FORALL_THM, IN_ELIM_THM, NOT_IMP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM SET_TAC [])

  let COMPONENT_CLOPEN_HAUSDIST_EXPLICIT ← prove
   r"!s c:real^N->bool e.
        &0 < e /\
        locally compact s /\
        c IN components s /\
        compact c
        ==> ?k. open_in (subtopology euclidean s) k /\
                compact k /\ c SUBSET k /\
                k SUBSET {x + d | x IN c /\ d IN ball(vec 0,e)}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SURA_BURA_CLOPEN_SUBSET THEN
    ASM_SIMP_TAC [OPEN_SUMS, OPEN_BALL] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, VECTOR_ADD_RID])

  let COMPONENT_CLOPEN_HAUSDIST ← prove
   r"!s c:real^N->bool e.
        &0 < e /\
        locally compact s /\
        c IN components s /\
        compact c
        ==> ?k. open_in (subtopology euclidean s) k /\
                compact k /\ c SUBSET k /\ hausdist(c,k) < e"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N->bool", ← q r"e / &2"]
          COMPONENT_CLOPEN_HAUSDIST_EXPLICIT) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"k:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"c:real^N->bool = {}", ← q r"k:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [HAUSDIST_EMPTY] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_HAUSDIST_LE_SUMS THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       SUBSET_TRANS))
    THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
      ASM_REWRITE_TAC [CENTRE_IN_CBALL, VECTOR_ADD_RID] THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET u
        ==> {f x y | x IN s /\ y IN t} SUBSET {f x y | x IN s /\ y IN u}")) THEN
      REWRITE_TAC [BALL_SUBSET_CBALL]])

  return { SURA_BURA_COMPACT, SURA_BURA_CLOPEN_SUBSET, SURA_BURA_CLOPEN_SUBSET_ALT, SURA_BURA,
           COMPONENT_CLOPEN_HAUSDIST_EXPLICIT, COMPONENT_CLOPEN_HAUSDIST }

