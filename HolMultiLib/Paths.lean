/- Elementary properties of dimension.  (paths.ml 22342-22570)               -/
/- ------------------------------------------------------------------------- -/

structure PWI where
  DIMENSION_TRANSLATION : thm
  DIMENSION_LINEAR_IMAGE : thm
  DIMENSION_LE_DIMINDEX : thm
  DIMENSION_LE_MINUS1 : thm
  DIMENSION_EQ_MINUS1 : thm
  DIMENSION_POS_LE : thm
  DIMENSION_EMPTY : thm
  DIMENSION_SUBSET : thm
  DIMENSION_LE_DISCRETE : thm
  DIMENSION_EQ_ZERO_DISCRETE : thm
  DIMENSION_EQ_DISCRETE : thm
  DIMENSION_LE_EQ_ALT : thm
  DIMENSION_LE_EQ_LOCAL : thm
  DIMENSION_LE_EQ_GENERAL : thm
  DIMENSION_LE_EQ_LOCALLY : thm
  LOCALLY_OPEN_AND_DIMENSION_LE : thm
  DIMENSION_EQ_ON_NBDS : thm
  LOCALLY_DIMENSION_EQ : thm
  DIMENSION_EQ_ON_OPEN_SUBSETS : thm
  DIMENSION_EQ_LOCALLY_CLOPEN : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWI [HolBase] (D : PathsDeps) (BWH : PWH) : ExceptT String IO PWI := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, MESON_TAC, SET_RULE, SET_TAC, add_linear_invariants,
        add_translation_invariants, .. } := D.cvx
  let { IMP_CONJ_ALT, INTER_EMPTY, INT_LE_ANTISYM, INT_LE_TRANS, .. } := D.cvx.core2
  let { IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.cvx.core3
  let { SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { OPEN_IN, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, OPEN_IN_REFL, SUBSET_CLOSURE,
        TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { INT_LE_TRANS_LE, .. } := D.pses1
  let { DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN, DIMENSION_LE_CASES,
        DIMENSION_LE_DISCRETE_TOPOLOGY, DIMENSION_LE_EQ_EMPTY, DIMENSION_LE_EQ_SUBTOPOLOGY,
        DIMENSION_LE_SUBTOPOLOGIES, FRONTIER_OF_CLOSURES, FRONTIER_OF_SUBSET_SUBTOPOLOGY, .. } :=
    D.pmet1
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF, FRONTIER_CLOSURES,
        HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF, .. } := D.ptop3
  let { HOMEOMORPHIC_TRANSLATION_SELF, LOCALLY_AND_OPEN_IN, LOCALLY_ON_NBDS, .. } := D.ptop4
  let { NEIGHBOURHOOD_BASE_OF_EUCLIDEAN, locally, .. } := D.ptop5
  let { AFF_DIM_LE_UNIV, .. } := D.pcvx1
  let { DIMENSION_GE, HOMEOMORPHIC_DIMENSION, DIMENSION_LE_EQ, LOCALLY_DIMENSION_LE,
        DIMENSION_LE_AFF_DIM, DIMENSION_DIMENSION_LE, .. } := BWH
  -- @@SCOPE END

  let DIMENSION_TRANSLATION ← prove
   r"!a:real^N s. dimension(IMAGE (\x. a + x) s) = dimension s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_DIMENSION THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  add_translation_invariants [DIMENSION_TRANSLATION]

  let DIMENSION_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> dimension(IMAGE f s) = dimension s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_DIMENSION THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants [DIMENSION_LINEAR_IMAGE]

  let DIMENSION_LE_DIMINDEX ← prove
   r"!s:real^N->bool. dimension s <= &(dimindex(:N))"
   (MESON_TAC [INT_LE_TRANS, AFF_DIM_LE_UNIV, DIMENSION_LE_AFF_DIM])

  let DIMENSION_LE_MINUS1 ← prove
   r"!s:real^N->bool. dimension s <= -- &1 <=> s = {}"
   (REWRITE_TAC [DIMENSION_DIMENSION_LE, DIMENSION_LE_EQ_EMPTY,
                TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let DIMENSION_EQ_MINUS1 ← prove
   r"!s:real^N->bool. dimension s = -- &1 <=> s = {}"
   (REWRITE_TAC [← GSYM INT_LE_ANTISYM, DIMENSION_GE, DIMENSION_LE_MINUS1])

  let DIMENSION_POS_LE ← prove
   r"!s:real^N->bool. &0 <= dimension s <=> ~(s = {})"
   (SIMP_TAC [DIMENSION_GE, DIMENSION_EQ_MINUS1, ← INT_ARITH
      (← q r"-- &1:int <= d ==> (&0 <= d <=> ~(d = -- &1))")])

  let DIMENSION_EMPTY ← prove
   r"dimension {} = -- &1"
   (REWRITE_TAC [DIMENSION_EQ_MINUS1])

  let DIMENSION_SUBSET ← prove
   r"!s t:real^N->bool. s SUBSET t ==> dimension s <= dimension t"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [INT_LE_TRANS_LE] THEN
    REWRITE_TAC [DIMENSION_DIMENSION_LE] THEN
    ASM_MESON_TAC [DIMENSION_LE_SUBTOPOLOGIES])

  let DIMENSION_LE_DISCRETE ← prove
   r"!s:real^N->bool.
        {x | x limit_point_of s} = {} ==> dimension s <= &0"
   (GEN_TAC THEN REWRITE_TAC [DIMENSION_DIMENSION_LE] THEN
    REWRITE_TAC [← GSYM EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF] THEN
    SIMP_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY, INTER_EMPTY,
             TOPSPACE_EUCLIDEAN, SUBSET_UNIV, DIMENSION_LE_DISCRETE_TOPOLOGY])

  let DIMENSION_EQ_ZERO_DISCRETE ← prove
   r"!s:real^N->bool.
        ~(s = {}) /\ {x | x limit_point_of s} = {} ==> dimension s = &0"
   (SIMP_TAC [← GSYM INT_LE_ANTISYM, DIMENSION_POS_LE, DIMENSION_LE_DISCRETE])

  let DIMENSION_EQ_DISCRETE ← prove
   r"!s:real^N->bool.
        {x | x limit_point_of s} = {}
        ==> dimension s = if s = {} then --(&1) else &0"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [DIMENSION_EMPTY, DIMENSION_EQ_ZERO_DISCRETE])

  let DIMENSION_LE_EQ_ALT ← prove
   r"!s:real^N->bool n.
       dimension s <= n <=>
       -- &1 <= n /\
       !v a. open v /\ a IN v /\ a IN s
             ==> ?u. a IN u /\ u SUBSET v /\ open u /\
                     dimension(subtopology euclidean s frontier_of (s INTER u))
                     <= n - &1"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DIMENSION_DIMENSION_LE] THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ_SUBTOPOLOGY] THEN
    REWRITE_TAC [← GSYM OPEN_IN])

  let DIMENSION_LE_EQ_LOCAL ← prove
   r"!s:real^N->bool n.
        dimension s <= n <=>
       -- &1 <= n /\
       !v a. open_in (subtopology euclidean s) v /\ a IN v
             ==> ?u. a IN u /\ u SUBSET v /\
                     open_in (subtopology euclidean s) u /\
                     dimension(subtopology euclidean s frontier_of u)
                     <= n - &1"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DIMENSION_DIMENSION_LE] THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_CASES] THEN
    REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [← GSYM DIMENSION_DIMENSION_LE] THEN
    SIMP_TAC [FRONTIER_OF_SUBSET_SUBTOPOLOGY, ← SET_RULE
     (← q r"t SUBSET s ==> s INTER t = t")])

  let DIMENSION_LE_EQ_GENERAL ← prove
   r"!t s:real^N->bool n.
        s SUBSET t
        ==> (dimension s <= n <=>
             -- &1 <= n /\
             !v a. open_in (subtopology euclidean t) v /\ a IN v /\ a IN s
                   ==> ?u. a IN u /\
                           u SUBSET v /\
                           open_in (subtopology euclidean t) u /\
                           dimension(s INTER
                                     subtopology euclidean t frontier_of u)
                           <= n - &1)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ],
      GEN_REWRITE_TAC RAND_CONV [DIMENSION_LE_EQ_LOCAL]] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [IN_INTER]) THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t INTER u:real^N->bool"),
      SUBGOAL_THEN (← q r"(a:real^N) IN t") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t INTER v:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_SIMP_TAC [IN_INTER, OPEN_IN_OPEN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"uu:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [IN_INTER]) THEN
      EXISTS_TAC (← q r"s INTER u:real^N->bool")] THEN
   (ASM_SIMP_TAC [IN_INTER, OPEN_IN_OPEN_INTER] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
        INT_LE_TRANS)) THEN
    MATCH_MP_TAC DIMENSION_SUBSET THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES, FRONTIER_CLOSURES] THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])
    THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET t /\ c1 SUBSET c1' /\ c2 SUBSET c2'
        ==> s INTER (t INTER c1) INTER t INTER c2 SUBSET
            s INTER c1' INTER c2'")),
      MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET t /\ c1 SUBSET c1' /\ c2 SUBSET c2'
        ==> (s INTER c1) INTER s INTER c2 SUBSET
            s INTER (t INTER c1') INTER (t INTER c2')"))] THEN
    ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN MATCH_MP_TAC SUBSET_CLOSURE THEN ASM SET_TAC [])

  let DIMENSION_LE_EQ_LOCALLY ← prove
   r"!s:real^N->bool n.
      dimension s <= n <=>
      --(&1) <= n /\
      locally (\u. open_in (subtopology euclidean s) u /\
                   dimension(subtopology euclidean s frontier_of u) <= n - &1)
              s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally] THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ_LOCAL] THEN
    MESON_TAC [SUBSET])

  let LOCALLY_OPEN_AND_DIMENSION_LE ← prove
   r"!s n. dimension s <= n <=>
         -- &1 <= n /\
         locally (\u. open_in (subtopology euclidean s) u /\
                      dimension u <= n) s"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [LOCALLY_DIMENSION_LE] THEN
    AP_TERM_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [LOCALLY_AND_OPEN_IN] THEN
    REWRITE_TAC [locally] THEN
    MESON_TAC [DIMENSION_SUBSET, INT_LE_TRANS, SUBSET_TRANS])

  let DIMENSION_EQ_ON_NBDS ← prove
   r"!s:real^N->bool n.
        ~(s = {}) /\
        (!x. x IN s
             ==> ?u v. x IN u /\ open_in (subtopology euclidean s) u /\
                       u SUBSET v /\ v SUBSET s /\ dimension v = n)
        ==> dimension s = n"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:real^N")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"dimension(v:real^N->bool) <= dimension(s:real^N->bool)")
    MP_TAC THENL [ASM_SIMP_TAC [DIMENSION_SUBSET], ASM_REWRITE_TAC []] THEN
    SIMP_TAC [← GSYM INT_LE_ANTISYM] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [LOCALLY_DIMENSION_LE] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIMENSION_GE], ALL_TAC] THEN
    ONCE_REWRITE_TAC [LOCALLY_ON_NBDS] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM INT_LE_ANTISYM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [LOCALLY_DIMENSION_LE] THEN
    SIMP_TAC [])

  let LOCALLY_DIMENSION_EQ ← prove
   r"!s:real^N->bool n.
        ~(s = {}) /\ locally (\u. dimension u = n) s ==> dimension s = n"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
    REWRITE_TAC [OPEN_IN_REFL] THEN DISCH_TAC THEN
    MATCH_MP_TAC DIMENSION_EQ_ON_NBDS THEN ASM_MESON_TAC [])

  let DIMENSION_EQ_ON_OPEN_SUBSETS ← prove
   r"!s:real^N->bool n.
        ~(s = {}) /\
        (!x. x IN s
             ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                     dimension u = n)
        ==> dimension s = n"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIMENSION_EQ_ON_NBDS THEN
    ASM_MESON_TAC [SUBSET_REFL, OPEN_IN_IMP_SUBSET])

  let DIMENSION_EQ_LOCALLY_CLOPEN ← prove
   r"!s:real^N->bool.
        dimension s <= &0 <=>
        locally (\u. closed_in (subtopology euclidean s) u /\
                     open_in (subtopology euclidean s) u) s"
   (REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_EUCLIDEAN] THEN
    REWRITE_TAC [DIMENSION_DIMENSION_LE] THEN
    REWRITE_TAC [DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN])

  return { DIMENSION_TRANSLATION, DIMENSION_LINEAR_IMAGE, DIMENSION_LE_DIMINDEX,
           DIMENSION_LE_MINUS1, DIMENSION_EQ_MINUS1, DIMENSION_POS_LE, DIMENSION_EMPTY,
           DIMENSION_SUBSET, DIMENSION_LE_DISCRETE, DIMENSION_EQ_ZERO_DISCRETE,
           DIMENSION_EQ_DISCRETE, DIMENSION_LE_EQ_ALT, DIMENSION_LE_EQ_LOCAL,
           DIMENSION_LE_EQ_GENERAL, DIMENSION_LE_EQ_LOCALLY, LOCALLY_OPEN_AND_DIMENSION_LE,
           DIMENSION_EQ_ON_NBDS, LOCALLY_DIMENSION_EQ, DIMENSION_EQ_ON_OPEN_SUBSETS,
           DIMENSION_EQ_LOCALLY_CLOPEN }

/- ------------------------------------------------------------------------- -/
/- Small inductive dimension; small sets are zero-dimensional.               -/
/- (paths.ml 22571-22715)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWJ where
  SMALL_INDUCTIVE_DIMENSION : thm
  SMALL_IMP_DIMENSION_LE_0 : thm
  COUNTABLE_IMP_DIMENSION_LE_0 : thm
  FINITE_IMP_DIMENSION_LE_0 : thm
  DIMENSION_SING : thm
  CONNECTED_DIMENSION_EQ_SING : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWJ [HolBase] (D : PathsDeps) (BWH : PWH) (BWI : PWI) : ExceptT String IO PWJ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, SET_RULE, SET_TAC, INT_REDUCE_CONV, .. } := D.cvx
  let { DIFF_EMPTY, FINITE_SING, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, INT_LE_TRANS, IN_DIFF, .. } := D.cvx.core2
  let { IN_IMAGE, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_INSERT_EMPTY, .. } := D.cvx.core3
  let { REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { RIGHT_AND_EXISTS_THM, SING_SUBSET, SUBSET, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNWIND_THM2, .. } := D.cvx.core6
  let { DROP_VEC, FORALL_LIFT, LIFT_DROP, LIFT_EQ, .. } := D.cvx.vec2
  let { CLOSED_IN_DIFF, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { FRONTIER_BALL, .. } := D.cvx.top3
  let { INTERVAL_NE_EMPTY_1, IN_INTERVAL_1, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_IMAGE, CARD_LE_SUBSET, CARD_LE_TRANS,
        CARD_LTE_TRANS, CARD_NOT_LE, COUNTABLE_IMP_CARD_LT_REAL, FINITE_IMP_COUNTABLE, .. } :=
    D.pcard
  let { CLOSED_IN_CLOSURE_OF, CLOSED_IN_EMPTY, CLOSED_IN_FRONTIER_OF, CLOSED_IN_IMP_SUBSET,
        CLOSURE_OF_CLOSED_IN, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_SUBTOPOLOGY,
        FRONTIER_OF_CLOSURES, FRONTIER_OF_SUBSET_SUBTOPOLOGY, .. } := D.pmet1
  let { OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, OPEN_IN_SUBSET, .. } := D.pmet2
  let { CARD_EQ_INTERVAL, CLOSED_IN_REFL, CLOSED_IN_SING, .. } := D.ptop1
  let { CONNECTED_OPEN_IN_EQ, .. } := D.ptop2
  let { LOCALLY_CLOSED_IN_EXPLICIT, .. } := D.ptop4
  let { SUBSET_BALL, sphere, .. } := D.ptop5
  let { DIMENSION_GE, DIMENSION_LE_EQ, .. } := BWH
  let { DIMENSION_EQ_MINUS1, DIMENSION_SUBSET, DIMENSION_LE_EQ_LOCAL, .. } := BWI
  -- @@SCOPE END

  let SMALL_INDUCTIVE_DIMENSION ← prove
   r"!s:real^N->bool n.
        dimension s <= n <=>
        -- &1 <= n /\
        !c a. a IN s /\ closed_in (subtopology euclidean s) c /\ ~(a IN c)
              ==> ?b. closed_in (subtopology euclidean s) b /\
                      dimension b <= n - &1 /\
                      ?u v. open_in (subtopology euclidean s) u /\
                            open_in (subtopology euclidean s) v /\
                            DISJOINT u v /\ u UNION v = s DIFF b /\
                            a IN u /\ c SUBSET v"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ_LOCAL] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?v:real^N->bool. a IN v /\
                         open_in (subtopology euclidean s) v /\
                         DISJOINT ((subtopology euclidean s) closure_of v) c")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s DIFF c:real^N->bool",
                         ← q r"a:real^N"]
          LOCALLY_CLOSED_IN_EXPLICIT) THEN
        ASM_SIMP_TAC [IN_DIFF, OPEN_IN_DIFF, OPEN_IN_REFL] THEN
        MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"subtopology euclidean s frontier_of u:real^N->bool") THEN
      ASM_REWRITE_TAC [CLOSED_IN_FRONTIER_OF] THEN MAP_EVERY EXISTS_TAC
       [← q r"u:real^N->bool",
        ← q r"s DIFF (subtopology euclidean s closure_of u):real^N->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, CLOSED_IN_CLOSURE_OF,
                   FRONTIER_OF_CLOSURES, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                   CLOSED_IN_DIFF, CLOSED_IN_REFL, CLOSURE_OF_CLOSED_IN] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"u SUBSET t ==> DISJOINT u (s DIFF t)")) THEN
        MATCH_MP_TAC CLOSURE_OF_SUBSET THEN ASM_MESON_TAC [OPEN_IN_SUBSET],
        MATCH_MP_TAC (← SET_RULE
         (← q r"u SUBSET u' /\ u' SUBSET s
          ==> u UNION (s DIFF u') = s DIFF (u' INTER (s DIFF u))")) THEN
        REWRITE_TAC [CLOSURE_OF_SUBSET_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"DISJOINT v c
          ==> c SUBSET s /\ u SUBSET v ==> c SUBSET s DIFF u"))) THEN
        ASM_MESON_TAC [CLOSURE_OF_MONO, CLOSED_IN_IMP_SUBSET]],
      MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s DIFF w:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_SIMP_TAC [IN_DIFF, CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"b:real^N->bool", ← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      TRANS_TAC INT_LE_TRANS (← q r"dimension(b:real^N->bool)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC DIMENSION_SUBSET THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"u UNION v = s DIFF b
        ==> f SUBSET s /\ DISJOINT f u /\ DISJOINT f v ==> f SUBSET b"))) THEN
      REWRITE_TAC [FRONTIER_OF_SUBSET_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [FRONTIER_OF_CLOSURES, CLOSURE_OF_CLOSED_IN, CLOSED_IN_REFL,
                   TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, CLOSED_IN_DIFF] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"v INTER s = {} ==> DISJOINT (s INTER c) v")) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, OPEN_IN_SUBSET] THEN
      ASM SET_TAC []])

  let SMALL_IMP_DIMENSION_LE_0 ← prove
   r"!s:real^N->bool. s <_c (:real) ==> dimension s <= &0"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [DIMENSION_LE_EQ] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    SIMP_TAC [DIMENSION_GE, ← INT_ARITH (← q r"a:int <= d ==> (d <= a <=> d = a)")] THEN
    REWRITE_TAC [DIMENSION_EQ_MINUS1] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"~(interval(vec 0,lift r) SUBSET IMAGE (\x:real^N. lift(dist(a,x))) s)")
    MP_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_SUBSET) THEN
      W (MP_TAC o PART_MATCH lhand CARD_LE_IMAGE o rand o lhand o snd) THEN
      PURE_REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_TRANS) THEN
      REWRITE_TAC [CARD_NOT_LE] THEN
      TRANS_TAC CARD_LTE_TRANS (← q r"(:real)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      MATCH_MP_TAC (← CONJUNCT2 CARD_EQ_INTERVAL) THEN
      ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1, DROP_VEC, LIFT_DROP],
      REWRITE_TAC [SUBSET, NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
      REWRITE_TAC [IN_IMAGE, NOT_EXISTS_THM, FORALL_LIFT, IN_INTERVAL_1] THEN
      X_GEN_TAC (← q r"p:real") THEN REWRITE_TAC [LIFT_EQ, LIFT_DROP, DROP_VEC] THEN
      REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> q ==> ~p")] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"ball(a:real^N,p)") THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, ← GSYM SUBSET] THEN
      ASM_SIMP_TAC [FRONTIER_BALL, sphere] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      TRANS_TAC SUBSET_TRANS (← q r"ball(a:real^N,r)") THEN
      ASM_SIMP_TAC [SUBSET_BALL, REAL_LT_IMP_LE]])

  let COUNTABLE_IMP_DIMENSION_LE_0 ← prove
   r"!s:real^N->bool. COUNTABLE s ==> dimension s <= &0"
   (SIMP_TAC [COUNTABLE_IMP_CARD_LT_REAL, SMALL_IMP_DIMENSION_LE_0])

  let FINITE_IMP_DIMENSION_LE_0 ← prove
   r"!s:real^N->bool. FINITE s ==> dimension s <= &0"
   (SIMP_TAC [COUNTABLE_IMP_DIMENSION_LE_0, FINITE_IMP_COUNTABLE])

  let DIMENSION_SING ← prove
   r"!a:real^N. dimension {a} = &0"
   (GEN_TAC THEN MATCH_MP_TAC (← INT_ARITH
     (← q r"-- &1:int <= x /\ x <= &0 /\ ~(x = -- &1) ==> x = &0")) THEN
    REWRITE_TAC [DIMENSION_GE, DIMENSION_EQ_MINUS1, NOT_INSERT_EMPTY] THEN
    SIMP_TAC [FINITE_IMP_DIMENSION_LE_0, FINITE_SING])

  let CONNECTED_DIMENSION_EQ_SING ← prove
   r"!s:real^N->bool. connected s ==> (dimension s = &0 <=> ?a. s = {a})"
   (REPEAT GEN_TAC THEN
    REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN ASM_REWRITE_TAC [DIMENSION_SING] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"~(s = {}) /\ (!a b. ~(a = b) /\ a IN s /\ b IN s ==> F)
      ==> ?a. s = {a}")) THEN
    ASM_REWRITE_TAC [← GSYM DIMENSION_EQ_MINUS1] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← INT_ARITH (← q r"i:int = &0 ==> i <= &0"))) THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SMALL_INDUCTIVE_DIMENSION] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    SIMP_TAC [DIMENSION_GE, ← INT_ARITH (← q r"a:int <= d ==> (d <= a <=> d = a)")] THEN
    REWRITE_TAC [DIMENSION_EQ_MINUS1] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"{b:real^N}", ← q r"a:real^N"]) THEN
    ASM_REWRITE_TAC [CLOSED_IN_SING, IN_SING, SING_SUBSET] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [UNWIND_THM2, CLOSED_IN_EMPTY] THEN
    REWRITE_TAC [NOT_EXISTS_THM, DIFF_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_OPEN_IN_EQ]) THEN
    REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
    ASM SET_TAC [])

  return { SMALL_INDUCTIVE_DIMENSION, SMALL_IMP_DIMENSION_LE_0, COUNTABLE_IMP_DIMENSION_LE_0,
           FINITE_IMP_DIMENSION_LE_0, DIMENSION_SING, CONNECTED_DIMENSION_EQ_SING }

/- ------------------------------------------------------------------------- -/
/- Subsets of each dimension; unions; zero-dimensional reduction and         -/
/- separation.  (paths.ml 22716-22908)                                       -/
/- ------------------------------------------------------------------------- -/

structure PWK where
  DIMENSION_SUBSET_EXISTS : thm
  DIMENSION_UNION_LE_BASIC : thm
  DIMENSION_ZERO_REDUCTION_THEOREM : thm
  DIMENSION_ZERO_REDUCTION_THEOREM_2 : thm
  DIMENSION_ZERO_SEPARATION_THEOREM : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWK [HolBase] (D : PathsDeps) (BWH : PWH) (BWI : PWI) : ExceptT String IO PWK := do
  -- @@SCOPE BEGIN
  let { ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, INT_ARITH_TAC, MESON, MESON_TAC,
        SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, EMPTY_SUBSET, .. } := D.cvx.core1
  let { IMP_CONJ, INTER_COMM, INTER_SUBSET, INT_LE_REFL, INT_OF_NUM_EXISTS, INT_OF_NUM_SUC,
        INT_SUB_LZERO, .. } := D.cvx.core2
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL,
        NOT_EXISTS_THM, .. } := D.cvx.core3
  let { SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNION_COMM, UNION_EMPTY, num_INDUCTION, .. } := D.cvx.core6
  let { CLOSED_IN_DIFF, CLOSED_IN_TRANS, OPEN_IN_DIFF, OPEN_IN_EMPTY, .. } := D.cvx.met
  let { OPEN_IN_REFL, OPEN_UNIV, .. } := D.cvx.top5
  let { INT_ADD_SYM, INT_FORALL_POS, INT_SUB_RZERO, .. } := D.pses1
  let { UNION_OF, UNION_OVER_INTER, .. } := D.pses2
  let { GENERAL_REDUCTION_THEOREM, GENERAL_REDUCTION_THEOREM_2, .. } := D.pmisc
  let { CLOSED_IN_EMPTY, CLOSED_IN_FRONTIER_OF, CLOSED_IN_IMP_SUBSET, CLOSED_IN_UNION, .. } :=
    D.pmet1
  let { OPEN_IN_UNION, OPEN_IN_UNIONS, .. } := D.pmet2
  let { CLOSED_IN_REFL, .. } := D.ptop1
  let { LOCALLY_IMP_COUNTABLE_UNION_OF, LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { DIMENSION_GE, DIMENSION_LE_EQ, .. } := BWH
  let { DIMENSION_EQ_MINUS1, DIMENSION_POS_LE, DIMENSION_EMPTY, DIMENSION_SUBSET,
        DIMENSION_LE_EQ_ALT, DIMENSION_EQ_LOCALLY_CLOPEN, .. } := BWI
  -- @@SCOPE END

  let DIMENSION_SUBSET_EXISTS ← prove
   r"!s:real^N->bool n.
        -- &1 <= n /\ n <= dimension s
        ==> ?t. closed_in (subtopology euclidean s) t /\
                t SUBSET s /\
                dimension t = n"
   (← do
    let lemma ← prove
     r"!s:real^N->bool.
            ~(s = {})
            ==> ?t. closed_in (subtopology euclidean s) t /\
                    dimension t = dimension s - &1"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← INT_ARITH
       (← q r"dimension(s:real^N->bool) <= dimension(s) /\
        ~(dimension s <= dimension s - &1)")) THEN
      ONCE_REWRITE_TAC [DIMENSION_LE_EQ_ALT] THEN
      ASM_REWRITE_TAC [DIMENSION_GE, DIMENSION_POS_LE,
                      ← INT_ARITH (← q r"--a:int <= d - a <=> &0 <= d")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!x y. P x y ==> Q x y) /\ ~(!x y. P x y ==> R x y)
        ==> (?x y. P x y) ==> ~(!x y. Q x y ==> R x y)"))) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [OPEN_UNIV, IN_UNIV, MEMBER_NOT_EMPTY], ALL_TAC] THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN
      DISCH_TAC THEN REPEAT GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN
      GEN_TAC THEN REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
      MATCH_MP_TAC (← INT_ARITH
       (← q r"~(x:int = s - &1) ==> x <= s - &1 ==> x <= s - &1 - &1")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [CLOSED_IN_FRONTIER_OF])
    pure (
    REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← INT_ARITH
     (← q r"-- &1:int <= n /\ n <= s <=> &0 <= s - n /\ -- &1 <= s - (s - n)")] THEN
    ASM_CASES_TAC
     (← q r"!t:real^N->bool.
         dimension t = n <=>
         dimension t = dimension(s:real^N->bool) - (dimension s - n)")
    THENL
     [POP_ASSUM (fun th => ONCE_REWRITE_TAC [th]), ASM_INT_ARITH_TAC] THEN
    SPEC_TAC (← q r"dimension(s:real^N->bool) - n", ← q r"d:int") THEN
    REWRITE_TAC [IMP_CONJ, ← GSYM INT_FORALL_POS] THEN
    MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
     [REWRITE_TAC [INT_SUB_RZERO] THEN MESON_TAC [CLOSED_IN_REFL, SUBSET_REFL],
      X_GEN_TAC (← q r"d:num")] THEN
    REWRITE_TAC [← GSYM INT_OF_NUM_SUC, ← INT_ARITH
     (← q r"--a:int <= d - (x + a) <=> x <= d")] THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP (← INT_ARITH
     (← q r"d:int <= s ==> d = s \/ d < s")))
    THENL
     [DISCH_THEN (K ALL_TAC : thm → tactic) THEN EXISTS_TAC (← q r"{}:real^N->bool") THEN
      ASM_REWRITE_TAC [CLOSED_IN_EMPTY, EMPTY_SUBSET, DIMENSION_EMPTY] THEN
      INT_ARITH_TAC,
      ANTS_TAC THENL [ASM_INT_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"t:real^N->bool") lemma) THEN
      ASM_REWRITE_TAC [← GSYM DIMENSION_EQ_MINUS1] THEN
      ANTS_TAC THENL [ASM_INT_ARITH_TAC, MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
       [ASM_MESON_TAC [CLOSED_IN_TRANS],
        ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET, SUBSET_TRANS],
        INT_ARITH_TAC]]))

  let DIMENSION_UNION_LE_BASIC ← prove
   r"!s t:real^N->bool.
        dimension(s UNION t) <= dimension s + dimension t + &1"
   (SUBGOAL_THEN
     (← q r"!n s t. dimension s + dimension t + &2 <= &n
              ==> dimension(s UNION t:real^N->bool) <= &n - &1")
    ASSUME_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN
      SUBGOAL_THEN
        (← q r"?n. dimension(s:real^N->bool) + dimension(t:real^N->bool) + &2 = &n")
      CHOOSE_TAC THENL
       [REWRITE_TAC [INT_OF_NUM_EXISTS] THEN MATCH_MP_TAC (← INT_ARITH
         (← q r"-- &1:int <= x /\ -- &1 <= y ==> &0 <= x + y + &2")) THEN
        REWRITE_TAC [DIMENSION_GE],
        ASM_SIMP_TAC [INT_LE_REFL, ← INT_ARITH
         (← q r"x:int <= a + b + &1 <=> x <= (a + b + &2) - &1")]]] THEN
    INDUCT_TAC THEN
    SIMP_TAC [DIMENSION_GE, DIMENSION_EQ_MINUS1, UNION_EMPTY, DIMENSION_EMPTY,
             INT_SUB_LZERO, INT_LE_REFL, ← GSYM INT_OF_NUM_SUC, ← INT_ARITH
              (← q r"-- &1:int <= x /\ -- &1 <= y
               ==> (x + y + &2 <= &0 <=> x = -- &1 /\ y = -- &1)")] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"t:real^N->bool"] THEN
    REWRITE_TAC [← INT_ARITH (← q r"(n + &1) - &1:int = n")] THEN
    REWRITE_TAC [← INT_ARITH (← q r"s + t + &2:int <= n + &1 <=> s + t <= n - &1")] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [DIMENSION_LE_EQ] THEN
    CONJ_TAC THENL [INT_ARITH_TAC, ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"p /\ q /\ x IN s UNION t ==> r <=>
      (x IN s \/ x IN t ==> p /\ q ==> r)")] THEN
    UNDISCH_TAC
     (← q r"dimension(s:real^N->bool) + dimension(t:real^N->bool) <= &n - &1") THEN
    MAP_EVERY (fun t => SPEC_TAC (t, t)) [← q r"t:real^N->bool", ← q r"s:real^N->bool"] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!s t. R s t ==> R t s) /\ (!s t. P s ==> R s t)
      ==> (!s t. P s \/ P t ==> R s t)")) THEN
    CONJ_TAC THENL [REWRITE_TAC [INT_ADD_SYM, UNION_COMM], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"dimension(s:real^N->bool)") INT_LE_REFL) THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"a:real^N"] o CONJUNCT2) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [INTER_COMM] UNION_OVER_INTER] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    MP_TAC (← ISPECL [← q r"t INTER frontier u:real^N->bool", ← q r"t:real^N->bool"]
          DIMENSION_SUBSET) THEN
    REWRITE_TAC [INTER_SUBSET] THEN ASM_INT_ARITH_TAC)

  let DIMENSION_ZERO_REDUCTION_THEOREM ← prove
   r"!s:real^N->bool v.
        dimension s <= &0 /\
        (!n:num. open_in (subtopology euclidean s) (v n))
        ==> ?u. (!n. open_in (subtopology euclidean s) (u n)) /\
                (!n. u n SUBSET v n) /\
                pairwise (\m n. DISJOINT (u m) (u n)) (:num) /\
                UNIONS {u n | n IN (:num)} = UNIONS {v n | n IN (:num)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"\u:real^N->bool. closed_in (subtopology euclidean s) u /\
                                   open_in (subtopology euclidean s) u")
          GENERAL_REDUCTION_THEOREM) THEN
    REWRITE_TAC [OPEN_IN_EMPTY, CLOSED_IN_EMPTY] THEN ANTS_TAC THENL
     [SIMP_TAC [OPEN_IN_UNION, CLOSED_IN_UNION, CLOSED_IN_DIFF, OPEN_IN_DIFF],
      DISCH_THEN (MP_TAC o SPEC (← q r"v:num->real^N->bool"))] THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DIMENSION_EQ_LOCALLY_CLOPEN]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(v:num->real^N->bool) n") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] LOCALLY_OPEN_SUBSET)) THEN
      ASM_REWRITE_TAC [LOCALLY_IMP_COUNTABLE_UNION_OF],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:num->real^N->bool") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [UNION_OF] THEN MESON_TAC [OPEN_IN_UNIONS]])

  let DIMENSION_ZERO_REDUCTION_THEOREM_2 ← prove
   r"!u s t:real^N->bool.
        dimension u <= &0 /\
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t
        ==> ?s' t'. open_in (subtopology euclidean u) s' /\
                    open_in (subtopology euclidean u) t' /\
                    s' SUBSET s /\ t' SUBSET t /\ DISJOINT s' t' /\
                    s' UNION t' = s UNION t"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"\v:real^N->bool. closed_in (subtopology euclidean u) v /\
                                   open_in (subtopology euclidean u) v")
          GENERAL_REDUCTION_THEOREM_2) THEN
    REWRITE_TAC [OPEN_IN_EMPTY, CLOSED_IN_EMPTY] THEN ANTS_TAC THENL
     [SIMP_TAC [OPEN_IN_UNION, CLOSED_IN_UNION, CLOSED_IN_DIFF, OPEN_IN_DIFF],
      DISCH_THEN (MP_TAC o SPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"])] THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC LOCALLY_IMP_COUNTABLE_UNION_OF THEN
      MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_REWRITE_TAC [← GSYM DIMENSION_EQ_LOCALLY_CLOPEN],
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
      REWRITE_TAC [UNION_OF] THEN MESON_TAC [OPEN_IN_UNIONS]])

  let DIMENSION_ZERO_SEPARATION_THEOREM ← prove
   r"!u s t:real^N->bool.
        dimension u <= &0 /\
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        DISJOINT s t
        ==> ?s' t'. closed_in (subtopology euclidean u) s' /\
                    open_in (subtopology euclidean u) s' /\
                    closed_in (subtopology euclidean u) t' /\
                    open_in (subtopology euclidean u) t' /\
                    s SUBSET s' /\ t SUBSET t' /\ DISJOINT s' t' /\
                    s' UNION t' = u"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"u:real^N->bool", ← q r"u DIFF s:real^N->bool", ← q r"u DIFF t:real^N->bool"]
     DIMENSION_ZERO_REDUCTION_THEOREM_2) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"s':real^N->bool", ← q r"t':real^N->bool"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"u DIFF s':real^N->bool", ← q r"u DIFF t':real^N->bool"] THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_REFL] THEN
    SUBGOAL_THEN
     (← q r"u DIFF s':real^N->bool = t' /\ u DIFF t' = s'")
    (CONJUNCTS_THEN SUBST1_TAC) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
    ASM SET_TAC [])

  return { DIMENSION_SUBSET_EXISTS, DIMENSION_UNION_LE_BASIC, DIMENSION_ZERO_REDUCTION_THEOREM,
           DIMENSION_ZERO_REDUCTION_THEOREM_2, DIMENSION_ZERO_SEPARATION_THEOREM }

/- ------------------------------------------------------------------------- -/
/- Countable closed unions and the decomposition theorem.                    -/
/- (paths.ml 22909-23250)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWL where
  DIMENSION_LE_CLOSED_IN_UNIONS : thm
  DIMENSION_DECOMPOSITION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWL [HolBase] (D : PathsDeps) (BWI : PWI) (BWJ : PWJ) (BWK : PWK) :
    ExceptT String IO PWL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, MESON, SET_RULE,
        SET_TAC, INT_REDUCE_CONV, .. } := D.cvx
  let { CONJ_ASSOC, DIFF_EMPTY, ETA_AX, EXISTS_PAIR_THM, EXTENSION, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET,
        INT_LE_TRANS, INT_OF_NUM_EXISTS, INT_OF_NUM_SUC, INT_POS, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.cvx.core3
  let { RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET_ANTISYM_EQ,
        SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNIONS_0, UNIONS_IMAGE, UNIONS_SUBSET, UNION_SUBSET, UNWIND_THM2, o_THM, .. } :=
    D.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.cvx.lib
  let { CLOSED_IN_TRANS, CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } :=
    D.cvx.top5
  let { DEPENDENT_CHOICE, .. } := D.pses1
  let { NOT_SUC, TRANSITIVE_STEPWISE_LE, UNIONS_DIFF, UNION_OF, UNION_OF_MONO, .. } := D.pses2
  let { COUNTABLE_UNION_OF_RELATIVE_TO, .. } := D.pmisc
  let { COUNTABLE_AS_IMAGE, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_UNIONS, .. } := D.pcard
  let { CLOSED_IN_CLOSURE_OF, CLOSED_IN_EMPTY, CLOSED_IN_FRONTIER_OF, CLOSED_IN_IMP_SUBSET,
        CLOSED_IN_INTER, CLOSED_IN_SUBSET_TRANS, CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET,
        CLOSED_IN_UNION, CLOSURE_OF_SUBSET, FRONTIER_OF_CLOSURES, .. } := D.pmet1
  let { OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := D.pmet2
  let { CLOSED_IN_REFL, CLOSED_IN_SING, CLOSED_RELATIVE_TO, .. } := D.ptop1
  let { LOCALLY_OPEN_BASIS, .. } := D.ptop4
  let { SEPARATION_NORMAL_LOCAL_CLOSURES, fsigma, .. } := D.ptop5
  let { DIMENSION_LE_MINUS1, DIMENSION_EMPTY, DIMENSION_SUBSET, DIMENSION_LE_EQ_LOCAL,
        DIMENSION_LE_EQ_LOCALLY, .. } := BWI
  let { SMALL_INDUCTIVE_DIMENSION, .. } := BWJ
  let { DIMENSION_UNION_LE_BASIC, DIMENSION_ZERO_SEPARATION_THEOREM, .. } := BWK
  -- @@SCOPE END

  let (DIMENSION_LE_CLOSED_IN_UNIONS, DIMENSION_DECOMPOSITION) ← (do
    let lemma ← prove
     r"!s:real^N->bool n.
            dimension s <= n /\ &0 <= n
            ==> ?t. (COUNTABLE UNION_OF
                     (\c. closed_in (subtopology euclidean s) c /\
                          dimension c <= n - &1)) t /\
                    dimension(s DIFF t) <= &0"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DIMENSION_LE_EQ_LOCALLY]) THEN
      DISCH_THEN (MP_TAC o REWRITE_RULE [LOCALLY_OPEN_BASIS] o CONJUNCT2) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      ABBREV_TAC
       (← q r"t = UNIONS(IMAGE
          (\c:real^N->bool. subtopology euclidean s frontier_of c) b)") THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN CONJ_TAC THENL
       [EXPAND_TAC "t" THEN MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
        ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
        MATCH_MP_TAC COUNTABLE_UNION_OF_INC THEN
        ASM_SIMP_TAC [CLOSED_IN_FRONTIER_OF],
        GEN_REWRITE_TAC id [DIMENSION_LE_EQ_LOCAL] THEN
        CONV_TAC INT_REDUCE_CONV THEN REWRITE_TAC [DIMENSION_LE_MINUS1] THEN
        MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N->bool")
         (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTER]) THEN
        REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"?c. c SUBSET b /\ s INTER w:real^N->bool = UNIONS c")
        MP_TAC THENL [ASM_SIMP_TAC [OPEN_IN_OPEN_INTER], ALL_TAC] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o MATCH_MP (← SET_RULE
         (← q r"(?c. c SUBSET b /\ x = UNIONS c)
          ==> !a. a IN x ==> ?d. d IN b /\ d SUBSET x /\ a IN d"))) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INTER, SUBSET_INTER] THEN
        X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
        ANTE_RES_THEN MP_TAC (← ASSUME (← q r"(d:real^N->bool) IN b")) THEN
        REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
          let _ ← liftExcept (check HolCore.Basics.is_forall (concl th))
          pure ALL_TAC)) THEN
        STRIP_TAC THEN EXISTS_TAC (← q r"d DIFF t:real^N->bool") THEN
        REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
        CONJ_TAC THENL
         [UNDISCH_TAC (← q r"open_in (subtopology euclidean s) (d:real^N->bool)") THEN
          REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
          SET_TAC [],
          ALL_TAC] THEN
        REWRITE_TAC [FRONTIER_OF_CLOSURES, CLOSURE_OF_SUBTOPOLOGY,
                    EUCLIDEAN_CLOSURE_OF, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [← SET_RULE
         (← q r"d SUBSET s ==> (s DIFF t) INTER (d DIFF t) = d DIFF t")] THEN
        ASM_SIMP_TAC [← SET_RULE
         (← q r"d SUBSET s
          ==> (s DIFF t) INTER (s DIFF t DIFF (d DIFF t)) =
              s DIFF (t UNION d)")] THEN
        REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_DIFF] THEN
        X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
        MP_TAC (← ASSUME (← q r"~((x:real^N) IN t)")) THEN EXPAND_TAC "t" THEN
        REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
