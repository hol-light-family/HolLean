      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      ASM_MESON_TAC [REAL_LE_TRANS]]))

  return { HOMEOMORPHIC_MONOTONE_IMAGE_INTERVAL }

