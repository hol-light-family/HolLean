          PATH_COMPONENT_SUBSET) THEN ASM SET_TAC []]])

  let LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER_GEN ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
