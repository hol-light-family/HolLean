        ORTHOGONAL_TRANSFORMATION_LINEAR, .. } := D.cvx.det
  let { BETWEEN_IN_SEGMENT, .. } := D.cvx.top1
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_MUL, CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_WITHIN, EVENTUALLY_AT, EVENTUALLY_WITHIN, .. } := D.cvx.top3
  let { IN_INTERVAL_1, LIM_NULL_COMPARISON, LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } :=
    D.cvx.top4
