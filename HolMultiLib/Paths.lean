    REWRITE_TAC [NORM_1, ← REAL_ARITH (← q r"B < abs x <=> x < -- B \/ B < x")] THEN
    ASM SET_TAC [])

  let HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT ← prove
   r"!s. bounded s
       ==> {c | c IN components((:real^N) DIFF s) /\ ~bounded c} HAS_SIZE
           (if s = {} \/ 2 <= dimindex(:N) then 1 else 2)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [DIFF_EMPTY, COMPONENTS_UNIV, IN_SING] THEN
      REWRITE_TAC [← MESON [] (← q r"c = u /\ ~bounded c <=> c = u /\ ~bounded u")] THEN
      REWRITE_TAC [NOT_BOUNDED_UNIV, SING_GSPEC] THEN
      CONV_TAC HAS_SIZE_CONV THEN MESON_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"2 <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THENL
     [CONV_TAC HAS_SIZE_CONV THEN
      MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") COBOUNDED_UNBOUNDED_COMPONENTS) THEN
      ASM_REWRITE_TAC [COMPL_COMPL] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [← SET_RULE
       (← q r"{x | P x} = {a} <=> P a /\ !b. P b ==> b = a")] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS THEN
      EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
      ASM_REWRITE_TAC [COMPL_COMPL],
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(2 <= n) ==> 1 <= n ==> n = 1"))) THEN
      REWRITE_TAC [DIMINDEX_GE_1] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM DIMINDEX_1] THEN
      DISCH_THEN (MATCH_MP_TAC o C GEOM_EQUAL_DIMENSION_RULE
        HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT_1) THEN
      ASM_REWRITE_TAC []])

  return { HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT_1, HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT }

/- ------------------------------------------------------------------------- -/
/- The "inside" and "outside" of a set, i.e. the points respectively in a    -/
/- bounded or unbounded connected component of the set's complement.         -/
/- (paths.ml 15263-15571)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVA where
  inside : thm
  outside : thm
  INSIDE_TRANSLATION : thm
  OUTSIDE_TRANSLATION : thm
  INSIDE_LINEAR_IMAGE : thm
  OUTSIDE_LINEAR_IMAGE : thm
  OUTSIDE : thm
  INSIDE_NO_OVERLAP : thm
  OUTSIDE_NO_OVERLAP : thm
  INSIDE_INTER_OUTSIDE : thm
  INSIDE_UNION_OUTSIDE : thm
  INSIDE_EQ_OUTSIDE : thm
  INSIDE_OUTSIDE : thm
  OUTSIDE_INSIDE : thm
  INSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT : thm
  OUTSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT : thm
  INSIDE_SELF_OUTSIDE_EVERSION : thm
  UNION_WITH_INSIDE : thm
  UNION_WITH_OUTSIDE : thm
  OUTSIDE_MONO : thm
  INSIDE_MONO : thm
  INSIDE_MONO_ALT : thm
  COBOUNDED_OUTSIDE : thm
  UNBOUNDED_OUTSIDE : thm
  BOUNDED_INSIDE : thm
  CONNECTED_OUTSIDE : thm
  OUTSIDE_CONNECTED_COMPONENT_LT : thm
  OUTSIDE_CONNECTED_COMPONENT_LE : thm
  NOT_OUTSIDE_CONNECTED_COMPONENT_LT : thm
  NOT_OUTSIDE_CONNECTED_COMPONENT_LE : thm
  INSIDE_CONNECTED_COMPONENT_LT : thm
  INSIDE_CONNECTED_COMPONENT_LE : thm
  OUTSIDE_UNION_OUTSIDE_UNION : thm
  INSIDE_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVA [HolBase] (D : PathsDeps) (BUQ : PUQ) (BUS : PUS) : ExceptT String IO PVA := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, add_linear_invariants, add_translation_invariants,
        GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DIMINDEX_GE_1, EXTENSION, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, IN, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE_REFL, MONO_EXISTS, MONO_FORALL, NOT_IMP, REAL_ABS_DIV,
        REAL_ABS_MUL, REAL_ADD_RDISTRIB, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RADD, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } :=
    D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LE, SUBSET, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.cvx.core5
  let { NORM_0, NORM_BASIS, NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.cvx.vec3
  let { VECTOR_ADD_RDISTRIB, VECTOR_MUL_ASSOC, .. } := D.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_CBALL, BOUNDED_EMPTY, BOUNDED_POS, BOUNDED_SUBSET,
        BOUNDED_SUBSET_BALL, .. } := D.cvx.top1
  let { CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_SUBSET, CONNECTED_SEGMENT, .. } :=
    D.cvx.top2
  let { ENDS_IN_SEGMENT, .. } := D.cvx.top3
  let { IN_BALL_0, IN_CBALL_0, .. } := D.cvx.top4
  let { bounded, components, segment, .. } := D.cvx.top5
  let { COMPL_COMPL, .. } := D.pses1
  let { BOUNDED_UNION, COBOUNDED_IMP_UNBOUNDED, .. } := D.ptop1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_IDEMP,
        CONNECTED_COMPONENT_MONO, CONNECTED_COMPONENT_OF_SUBSET, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_COMPONENT_TRANS, CONNECTED_IFF_CONNECTED_COMPONENT, .. } := D.ptop2
  let { connected_component, .. } := D.ptop5
  let { CONVEX_CBALL, .. } := D.pcvx1
  let { CONNECTED_COMPLEMENT_BOUNDED_CONVEX, .. } := BUQ
  let { COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT, .. } := BUS
  -- @@SCOPE END

  let inside ← new_definition
   r"inside s = {x | ~(x IN s) /\
                  bounded(connected_component ((:real^N) DIFF s) x)}"

  let outside ← new_definition
   r"outside s = {x | ~(x IN s) /\
                   ~bounded(connected_component ((:real^N) DIFF s) x)}"

  let INSIDE_TRANSLATION ← prove
   r"!a s. inside(IMAGE (\x. a + x) s) = IMAGE (\x. a + x) (inside s)"
   (REWRITE_TAC [inside] THEN GEOM_TRANSLATE_TAC [])

  let OUTSIDE_TRANSLATION ← prove
   r"!a s. outside(IMAGE (\x. a + x) s) = IMAGE (\x. a + x) (outside s)"
   (REWRITE_TAC [outside] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [INSIDE_TRANSLATION, OUTSIDE_TRANSLATION]

  let INSIDE_LINEAR_IMAGE ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
         ==> inside(IMAGE f s) = IMAGE f (inside s)"
   (REWRITE_TAC [inside] THEN GEOM_TRANSFORM_TAC [])

  let OUTSIDE_LINEAR_IMAGE ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
         ==> outside(IMAGE f s) = IMAGE f (outside s)"
   (REWRITE_TAC [outside] THEN GEOM_TRANSFORM_TAC [])

  add_linear_invariants [INSIDE_LINEAR_IMAGE, OUTSIDE_LINEAR_IMAGE]

  let OUTSIDE ← prove
   r"!s. outside s = {x | ~bounded(connected_component((:real^N) DIFF s) x)}"
   (GEN_TAC THEN REWRITE_TAC [outside, EXTENSION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [BOUNDED_EMPTY, CONNECTED_COMPONENT_EQ_EMPTY, IN_DIFF])

  let INSIDE_NO_OVERLAP ← prove
   r"!s. inside s INTER s = {}"
   (REWRITE_TAC [inside] THEN SET_TAC [])

  let OUTSIDE_NO_OVERLAP ← prove
   r"!s. outside s INTER s = {}"
   (REWRITE_TAC [outside] THEN SET_TAC [])

  let INSIDE_INTER_OUTSIDE ← prove
   r"!s. inside s INTER outside s = {}"
   (REWRITE_TAC [inside, outside] THEN SET_TAC [])

  let INSIDE_UNION_OUTSIDE ← prove
   r"!s. inside s UNION outside s = (:real^N) DIFF s"
   (REWRITE_TAC [inside, outside] THEN SET_TAC [])

  let INSIDE_EQ_OUTSIDE ← prove
   r"!s. inside s = outside s <=> s = (:real^N)"
   (REWRITE_TAC [inside, outside] THEN SET_TAC [])

  let INSIDE_OUTSIDE ← prove
   r"!s. inside s = (:real^N) DIFF (s UNION outside s)"
   (GEN_TAC THEN MAP_EVERY (MP_TAC o ISPEC (← q r"s:real^N->bool"))
     [INSIDE_INTER_OUTSIDE, INSIDE_UNION_OUTSIDE] THEN
    SET_TAC [])

  let OUTSIDE_INSIDE ← prove
   r"!s. outside s = (:real^N) DIFF (s UNION inside s)"
   (GEN_TAC THEN MAP_EVERY (MP_TAC o ISPEC (← q r"s:real^N->bool"))
     [INSIDE_INTER_OUTSIDE, INSIDE_UNION_OUTSIDE] THEN
    SET_TAC [])

  let INSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT ← prove
   r"!s. inside s = {} <=>
       !c. c IN components((:real^N) DIFF s) ==> ~bounded c"
   (REWRITE_TAC [components, FORALL_IN_GSPEC, inside] THEN SET_TAC [])

  let OUTSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT ← prove
   r"!s. outside s = {} <=>
       !c. c IN components((:real^N) DIFF s) ==> bounded c"
   (REWRITE_TAC [components, FORALL_IN_GSPEC, outside] THEN SET_TAC [])

  let INSIDE_SELF_OUTSIDE_EVERSION ← prove
   r"!s t:real^N->bool.
        s UNION inside s SUBSET inside t <=>
        t UNION outside t SUBSET outside s"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← SET_RULE (← q r"s SUBSET t <=>
      UNIV DIFF t SUBSET UNIV DIFF s")] THEN
    REWRITE_TAC [← GSYM INSIDE_OUTSIDE] THEN
    REWRITE_TAC [OUTSIDE_INSIDE] THEN ASM SET_TAC [])

  let UNION_WITH_INSIDE ← prove
   r"!s. s UNION inside s = (:real^N) DIFF outside s"
   (REWRITE_TAC [OUTSIDE_INSIDE] THEN SET_TAC [])

  let UNION_WITH_OUTSIDE ← prove
   r"!s. s UNION outside s = (:real^N) DIFF inside s"
   (REWRITE_TAC [INSIDE_OUTSIDE] THEN SET_TAC [])

  let OUTSIDE_MONO ← prove
   r"!s t. s SUBSET t ==> outside t SUBSET outside s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OUTSIDE, SUBSET, IN_ELIM_THM] THEN
    DISCH_TAC THEN GEN_TAC THEN REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN ASM SET_TAC [])

  let INSIDE_MONO ← prove
   r"!s t. s SUBSET t ==> inside s DIFF t SUBSET inside t"
   (REPEAT STRIP_TAC THEN SIMP_TAC [SUBSET, IN_DIFF, inside, IN_ELIM_THM] THEN
    GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)
      ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN ASM SET_TAC [])

  let INSIDE_MONO_ALT ← prove
   r"!s t:real^N->bool. s SUBSET t ==> inside s SUBSET t UNION inside t"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP INSIDE_MONO) THEN
    SET_TAC [])

  let COBOUNDED_OUTSIDE ← prove
   r"!s:real^N->bool. bounded s ==> bounded((:real^N) DIFF outside s)"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [outside] THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF {x | ~(x IN s) /\ ~P x} =
                          s UNION {x | P x}")] THEN
    ASM_REWRITE_TAC [BOUNDED_UNION] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"ball(vec 0:real^N,B)") THEN
    REWRITE_TAC [BOUNDED_BALL, SUBSET, IN_ELIM_THM, IN_BALL_0] THEN
    X_GEN_TAC (← q r"x:real^N") THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [REAL_NOT_LT] THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [ASM_REWRITE_TAC [NORM_0] THEN ASM_REAL_ARITH_TAC, DISCH_TAC] THEN
    REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(B + C) / norm(x) % x:real^N")) THEN
    REWRITE_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, NOT_IMP] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    REWRITE_TAC [IN] THEN REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"segment[x:real^N,(B + C) / norm(x) % x]") THEN
    REWRITE_TAC [ENDS_IN_SEGMENT, CONNECTED_SEGMENT] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"(:real^N) DIFF ball(vec 0,B)") THEN
    ASM_REWRITE_TAC [← SET_RULE
     (← q r"UNIV DIFF s SUBSET UNIV DIFF t <=> t SUBSET s")] THEN
    REWRITE_TAC [SUBSET, IN_DIFF, IN_UNIV, IN_BALL_0] THEN
    REWRITE_TAC [segment, FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:real") THEN
    STRIP_TAC THEN REWRITE_TAC [REAL_NOT_LT] THEN
    REWRITE_TAC [← GSYM VECTOR_ADD_RDISTRIB, NORM_MUL, VECTOR_MUL_ASSOC] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM REAL_ABS_NORM] THEN
    REWRITE_TAC [← GSYM REAL_ABS_MUL] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 < B /\ B <= x ==> B <= abs x")) THEN
    ASM_SIMP_TAC [REAL_ADD_RDISTRIB, REAL_DIV_RMUL, NORM_EQ_0, ← GSYM
                 REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"(&1 - u) * B + u * (B + C)") THEN
    ASM_SIMP_TAC [REAL_LE_RADD, REAL_LE_LMUL, REAL_SUB_LE] THEN
    SIMP_TAC [← REAL_ARITH (← q r"B <= (&1 - u) * B + u * (B + C) <=> &0 <= u * C")] THEN
    MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC)

  let UNBOUNDED_OUTSIDE ← prove
   r"!s:real^N->bool. bounded s ==> ~bounded(outside s)"
   (MESON_TAC [COBOUNDED_IMP_UNBOUNDED, COBOUNDED_OUTSIDE])

  let BOUNDED_INSIDE ← prove
   r"!s:real^N->bool. bounded s ==> bounded(inside s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"(:real^N) DIFF outside s") THEN
    ASM_SIMP_TAC [COBOUNDED_OUTSIDE] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") INSIDE_INTER_OUTSIDE) THEN SET_TAC [])

  let CONNECTED_OUTSIDE ← prove
   r"!s:real^N->bool. 2 <= dimindex(:N) /\ bounded s ==> connected(outside s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REWRITE_TAC [outside, IN_ELIM_THM] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_OF_SUBSET THEN
    EXISTS_TAC (← q r"connected_component ((:real^N) DIFF s) x") THEN
    REWRITE_TAC [SUBSET, IN_UNIV, IN_DIFF, IN_ELIM_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"z:real^N") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
        CONNECTED_COMPONENT_SUBSET)) THEN
      REWRITE_TAC [IN_DIFF] THEN ASM_MESON_TAC [CONNECTED_COMPONENT_EQ],
      REWRITE_TAC [CONNECTED_COMPONENT_IDEMP] THEN
      SUBGOAL_THEN (← q r"connected_component ((:real^N) DIFF s) x =
                    connected_component ((:real^N) DIFF s) y")
      SUBST1_TAC THENL
       [MATCH_MP_TAC COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT THEN
        ASM_REWRITE_TAC [COMPL_COMPL],
        ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ, IN_DIFF, IN_UNIV]]])

  let OUTSIDE_CONNECTED_COMPONENT_LT ← prove
   r"!s. outside s =
            {x | !B. ?y. B < norm(y) /\
                         connected_component((:real^N) DIFF s) x y}"
   (REWRITE_TAC [OUTSIDE, bounded, EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [IN] THEN ASM_MESON_TAC [REAL_NOT_LE])

  let OUTSIDE_CONNECTED_COMPONENT_LE ← prove
   r"!s. outside s =
            {x | !B. ?y. B <= norm(y) /\
                         connected_component((:real^N) DIFF s) x y}"
   (GEN_TAC THEN REWRITE_TAC [OUTSIDE_CONNECTED_COMPONENT_LT] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^N") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    MESON_TAC [REAL_LT_IMP_LE, ← REAL_ARITH (← q r"B + &1 <= x ==> B < x")])

  let NOT_OUTSIDE_CONNECTED_COMPONENT_LT ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s
       ==> (:real^N) DIFF (outside s) =
           {x | !B. ?y. B < norm(y) /\
                        ~(connected_component((:real^N) DIFF s) x y)}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OUTSIDE] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [bounded] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_TAC (← q r"C:real")) THEN X_GEN_TAC (← q r"B:real") THEN
      EXISTS_TAC (← q r"(abs B + abs C + &1) % basis 1:real^N") THEN
      RULE_ASSUM_TAC (ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
      CONJ_TAC THENL [ALL_TAC, FIRST_X_ASSUM MATCH_MP_TAC] THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      REAL_ARITH_TAC,
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [BOUNDED_POS]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN] THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B:real")) THEN DISCH_THEN
       (X_CHOOSE_THEN (← q r"z:real^N") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_TRANS THEN
      EXISTS_TAC (← q r"y:real^N") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_OF_SUBSET THEN
      EXISTS_TAC (← q r"(:real^N) DIFF cball(vec 0,B)") THEN
      ASM_REWRITE_TAC [SUBSET, IN_DIFF, IN_CBALL_0, IN_UNIV, CONTRAPOS_THM] THEN
      REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"(:real^N) DIFF cball(vec 0,B)") THEN
      ASM_SIMP_TAC [SUBSET_REFL, IN_DIFF, IN_UNIV, IN_CBALL_0, REAL_NOT_LE] THEN
      MATCH_MP_TAC CONNECTED_COMPLEMENT_BOUNDED_CONVEX THEN
      ASM_SIMP_TAC [BOUNDED_CBALL, CONVEX_CBALL]])

  let NOT_OUTSIDE_CONNECTED_COMPONENT_LE ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s
       ==> (:real^N) DIFF (outside s) =
           {x | !B. ?y. B <= norm(y) /\
                        ~(connected_component((:real^N) DIFF s) x y)}"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [NOT_OUTSIDE_CONNECTED_COMPONENT_LT] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:real^N") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    MESON_TAC [REAL_LT_IMP_LE, ← REAL_ARITH (← q r"B + &1 <= x ==> B < x")])

  let INSIDE_CONNECTED_COMPONENT_LT ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s
       ==> inside s =
            {x:real^N | ~(x IN s) /\
                        !B. ?y. B < norm(y) /\
                                ~(connected_component((:real^N) DIFF s) x y)}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INSIDE_OUTSIDE] THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF (s UNION t) = (UNIV DIFF t) DIFF s")] THEN
    ASM_SIMP_TAC [NOT_OUTSIDE_CONNECTED_COMPONENT_LT] THEN SET_TAC [])

  let INSIDE_CONNECTED_COMPONENT_LE ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s
       ==> inside s =
            {x:real^N | ~(x IN s) /\
                        !B. ?y. B <= norm(y) /\
                                ~(connected_component((:real^N) DIFF s) x y)}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INSIDE_OUTSIDE] THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF (s UNION t) = (UNIV DIFF t) DIFF s")] THEN
    ASM_SIMP_TAC [NOT_OUTSIDE_CONNECTED_COMPONENT_LE] THEN SET_TAC [])

  let OUTSIDE_UNION_OUTSIDE_UNION ← prove
   r"!c c1 c2:real^N->bool.
        c INTER outside(c1 UNION c2) = {}
        ==> outside(c1 UNION c2) SUBSET outside(c1 UNION c)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET] THEN
    X_GEN_TAC (← q r"x:real^N") THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    REWRITE_TAC [OUTSIDE_CONNECTED_COMPONENT_LT, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"B:real") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [connected_component] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"t SUBSET outside(c1 UNION c2:real^N->bool)")
    MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"connected_component((:real^N) DIFF (c1 UNION c2)) x") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONNECTED_COMPONENT_MAXIMAL], ALL_TAC] THEN
    UNDISCH_TAC (← q r"(x:real^N) IN outside(c1 UNION c2)") THEN
    REWRITE_TAC [OUTSIDE, IN_ELIM_THM, SUBSET] THEN
    MESON_TAC [CONNECTED_COMPONENT_EQ])

  let INSIDE_SUBSET ← prove
   r"!s t u. connected u /\ ~bounded u /\ t UNION u = (:real^N) DIFF s
           ==> inside s SUBSET t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, inside, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"~bounded(u:real^N->bool)") THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"connected_component((:real^N) DIFF s) x") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { inside, outside, INSIDE_TRANSLATION, OUTSIDE_TRANSLATION, INSIDE_LINEAR_IMAGE,
           OUTSIDE_LINEAR_IMAGE, OUTSIDE, INSIDE_NO_OVERLAP, OUTSIDE_NO_OVERLAP,
           INSIDE_INTER_OUTSIDE, INSIDE_UNION_OUTSIDE, INSIDE_EQ_OUTSIDE, INSIDE_OUTSIDE,
           OUTSIDE_INSIDE, INSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT,
           OUTSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT, INSIDE_SELF_OUTSIDE_EVERSION,
           UNION_WITH_INSIDE, UNION_WITH_OUTSIDE, OUTSIDE_MONO, INSIDE_MONO, INSIDE_MONO_ALT,
           COBOUNDED_OUTSIDE, UNBOUNDED_OUTSIDE, BOUNDED_INSIDE, CONNECTED_OUTSIDE,
           OUTSIDE_CONNECTED_COMPONENT_LT, OUTSIDE_CONNECTED_COMPONENT_LE,
           NOT_OUTSIDE_CONNECTED_COMPONENT_LT, NOT_OUTSIDE_CONNECTED_COMPONENT_LE,
           INSIDE_CONNECTED_COMPONENT_LT, INSIDE_CONNECTED_COMPONENT_LE,
           OUTSIDE_UNION_OUTSIDE_UNION, INSIDE_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Inside and outside (continued).  (paths.ml 15572-15804)                   -/
/- ------------------------------------------------------------------------- -/

structure PVB where
  INSIDE_UNIQUE : thm
  INSIDE_OUTSIDE_UNIQUE : thm
  INTERIOR_INSIDE_FRONTIER : thm
  INSIDE_EMPTY : thm
  OUTSIDE_EMPTY : thm
  INSIDE_SAME_COMPONENT : thm
  OUTSIDE_SAME_COMPONENT : thm
  CONNECTED_COMPONENT_INSIDE : thm
  CONNECTED_COMPONENT_OUTSIDE : thm
  BOUNDED_COMPONENTS_INSIDE : thm
  UNBOUNDED_COMPONENTS_OUTSIDE : thm
  INSIDE_WITH_INSIDE : thm
  OUTSIDE_WITH_OUTSIDE : thm
  OUTSIDE_CONVEX : thm
  INSIDE_CONVEX : thm
  OUTSIDE_SUBSET_CONVEX : thm
  INSIDE_SUBSET_CONVEX : thm
  INSIDE_SUBSET_CONVEX_HULL : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVB [HolBase] (D : PathsDeps) (BVA : PVA) : ExceptT String IO PVB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DIFF_EMPTY, EMPTY_GSPEC, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { IN, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_INV_LE_1, REAL_LE_INV_EQ, REAL_LT_DIV, REAL_LT_DIV2_EQ, REAL_LT_IMP_LE,
        REAL_LT_LDIV_EQ, REAL_LT_MUL, .. } := D.cvx.core4
  let { REAL_MUL_LINV, REAL_NOT_LE, REAL_SUB_RZERO, SET_PROVE_CASES, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { NORM_MUL, NORM_POS_LT, .. } := D.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, .. } := D.cvx.vec4
  let { BOUNDED_POS, BOUNDED_SUBSET, .. } := D.cvx.top1
  let { CONNECTED_COMPONENT_SUBSET, CONNECTED_INTER_FRONTIER, CONNECTED_SEGMENT, .. } :=
    D.cvx.top2
  let { ENDS_IN_SEGMENT, .. } := D.cvx.top3
  let { INTERIOR_SUBSET, NOT_BOUNDED_UNIV, .. } := D.cvx.top4
  let { components, frontier, segment, .. } := D.cvx.top5
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_IDEMP,
        CONNECTED_COMPONENT_IN, CONNECTED_COMPONENT_MONO, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS, CONNECTED_COMPONENT_UNIV,
        CONNECTED_CONNECTED_COMPONENT, CONNECTED_IFF_CONNECTED_COMPONENT, CONNECTED_UNION,
        .. } := D.ptop2
  let { connected_component, .. } := D.ptop5
  let { CONVEX_CONVEX_HULL, IN_CONVEX_SET, .. } := D.pcvx2
  let { inside, outside, INSIDE_NO_OVERLAP, OUTSIDE_NO_OVERLAP, INSIDE_OUTSIDE, OUTSIDE_INSIDE,
        INSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT,
        OUTSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT, OUTSIDE_MONO, INSIDE_SUBSET, .. } :=
    BVA
  -- @@SCOPE END

  let INSIDE_UNIQUE ← prove
   r"!s t u. connected t /\ bounded t /\
           connected u /\ ~(bounded u) /\
           ~connected((:real^N) DIFF s) /\
           t UNION u = (:real^N) DIFF s
           ==> inside s = t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [ASM_MESON_TAC [INSIDE_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, inside, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!s u. c INTER s = {} /\ c INTER u = {} /\ t UNION u = UNIV DIFF s
            ==> c SUBSET t")) THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"u:real^N->bool"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"c INTER s = {} <=> c SUBSET (UNIV DIFF s)")] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
      (← q r"(!x. x IN s /\ x IN t ==> F) ==> s INTER t = {}")) THEN
    X_GEN_TAC (← q r"y:real^N") THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [IN] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"~connected((:real^N) DIFF s)") THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
    SUBGOAL_THEN
     (← q r"(!w. w IN t ==> connected_component ((:real^N) DIFF s) x w) /\
      (!w. w IN u ==> connected_component ((:real^N) DIFF s) y w)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [connected_component] THENL
       [EXISTS_TAC (← q r"t:real^N->bool"), EXISTS_TAC (← q r"u:real^N->bool")] THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      FIRST_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [IN_UNION] THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_TRANS, CONNECTED_COMPONENT_SYM]])

  let INSIDE_OUTSIDE_UNIQUE ← prove
   r"!s t u. connected t /\ bounded t /\
           connected u /\ ~(bounded u) /\
           ~connected((:real^N) DIFF s) /\
           t UNION u = (:real^N) DIFF s
           ==> inside s = t /\ outside s = u"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [OUTSIDE_INSIDE] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [INSIDE_UNIQUE],
      MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") INSIDE_NO_OVERLAP) THEN
      SUBGOAL_THEN (← q r"t INTER u:real^N->bool = {}") MP_TAC THENL
       [ALL_TAC, ASM SET_TAC []] THEN
      UNDISCH_TAC (← q r"~connected ((:real^N) DIFF s)") THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_UNION THEN
      ASM_REWRITE_TAC []])

  let INTERIOR_INSIDE_FRONTIER ← prove
   r"!s:real^N->bool. bounded s ==> interior s SUBSET inside(frontier s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [inside, SUBSET, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [frontier, IN_DIFF], DISCH_TAC] THEN
    MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(connected_component((:real^N) DIFF frontier s) x INTER
                    frontier s = {})")
    MP_TAC THENL
     [MATCH_MP_TAC CONNECTED_INTER_FRONTIER THEN
      REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT, ← GSYM MEMBER_NOT_EMPTY] THEN
      CONJ_TAC THENL [REWRITE_TAC [IN_INTER], ASM SET_TAC []] THEN
      EXISTS_TAC (← q r"x:real^N") THEN CONJ_TAC THENL
       [REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ] THEN
        GEN_REWRITE_TAC id [← GSYM IN] THEN ASM SET_TAC [],
        ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET]],
      REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> s SUBSET (UNIV DIFF t)")] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET]])

  let INSIDE_EMPTY ← prove
   r"inside {} = {}"
   (REWRITE_TAC [inside, NOT_IN_EMPTY, DIFF_EMPTY, CONNECTED_COMPONENT_UNIV] THEN
    REWRITE_TAC [NOT_BOUNDED_UNIV, EMPTY_GSPEC])

  let OUTSIDE_EMPTY ← prove
   r"outside {} = (:real^N)"
   (REWRITE_TAC [OUTSIDE_INSIDE, INSIDE_EMPTY] THEN SET_TAC [])

  let INSIDE_SAME_COMPONENT ← prove
   r"!s x y. connected_component((:real^N) DIFF s) x y /\ x IN inside s
           ==> y IN inside s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o GEN_REWRITE_RULE id [← GSYM IN])
          MP_TAC) THEN
    REWRITE_TAC [inside, IN_ELIM_THM] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP CONNECTED_COMPONENT_EQ) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENT_IN) THEN
    SIMP_TAC [IN_DIFF])

  let OUTSIDE_SAME_COMPONENT ← prove
   r"!s x y. connected_component((:real^N) DIFF s) x y /\ x IN outside s
           ==> y IN outside s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o GEN_REWRITE_RULE id [← GSYM IN])
          MP_TAC) THEN
    REWRITE_TAC [outside, IN_ELIM_THM] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP CONNECTED_COMPONENT_EQ) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENT_IN) THEN
    SIMP_TAC [IN_DIFF])

  let CONNECTED_COMPONENT_INSIDE ← prove
   r"!s a. connected_component (inside s) a =
         if a IN inside s then connected_component ((:real^N) DIFF s) a
         else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
      REWRITE_TAC [INSIDE_NO_OVERLAP],
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONNECTED_COMPONENT_IDEMP] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
      REWRITE_TAC [SUBSET] THEN ASM_MESON_TAC [IN, INSIDE_SAME_COMPONENT]])

  let CONNECTED_COMPONENT_OUTSIDE ← prove
   r"!s a. connected_component (outside s) a =
         if a IN outside s then connected_component ((:real^N) DIFF s) a
         else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
      REWRITE_TAC [OUTSIDE_NO_OVERLAP],
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONNECTED_COMPONENT_IDEMP] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
      REWRITE_TAC [SUBSET] THEN ASM_MESON_TAC [IN, OUTSIDE_SAME_COMPONENT]])

  let BOUNDED_COMPONENTS_INSIDE ← prove
   r"!c:real^N->bool. c IN components(inside s) ==> bounded c"
   (SIMP_TAC [components, FORALL_IN_GSPEC, CONNECTED_COMPONENT_INSIDE] THEN
    REWRITE_TAC [inside] THEN SET_TAC [])

  let UNBOUNDED_COMPONENTS_OUTSIDE ← prove
   r"!s c:real^N->bool. c IN components(outside s) ==> ~bounded c"
   (SIMP_TAC [components, FORALL_IN_GSPEC, CONNECTED_COMPONENT_OUTSIDE] THEN
    REWRITE_TAC [outside] THEN SET_TAC [])

  let INSIDE_WITH_INSIDE ← prove
   r"!s:real^N->bool. inside(s UNION inside s) = {}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [INSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT] THEN
    REWRITE_TAC [← GSYM OUTSIDE_INSIDE, UNBOUNDED_COMPONENTS_OUTSIDE])

  let OUTSIDE_WITH_OUTSIDE ← prove
   r"!s:real^N->bool. outside(s UNION outside s) = {}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [OUTSIDE_EMPTY_EQ_NO_BOUNDED_COMPONENT_COMPLEMENT] THEN
    REWRITE_TAC [← GSYM INSIDE_OUTSIDE] THEN
    REWRITE_TAC [BOUNDED_COMPONENTS_INSIDE])

  let OUTSIDE_CONVEX ← prove
   r"!s. convex s ==> outside s = (:real^N) DIFF s"
   (REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ,
                ← REWRITE_RULE [← SET_RULE (← q r"t INTER s = {} <=> t SUBSET UNIV DIFF s")]
                            OUTSIDE_NO_OVERLAP] THEN
    REWRITE_TAC [SUBSET, IN_UNIV, IN_DIFF] THEN
    MATCH_MP_TAC SET_PROVE_CASES THEN REWRITE_TAC [OUTSIDE_EMPTY, IN_UNIV] THEN
    X_GEN_TAC (← q r"a:real^N") THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MP_TAC (← SET_RULE (← q r"(vec 0:real^N) IN (vec 0 INSERT t)")) THEN
    SPEC_TAC (← q r"(vec 0:real^N) INSERT t", ← q r"s:real^N->bool") THEN
    GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [outside, IN_ELIM_THM] THEN
    SUBGOAL_THEN (← q r"~(x:real^N = vec 0)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [BOUNDED_POS, NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"B:real") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(max (&2) ((B + &1) / norm(x))) % x:real^N")) THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [REWRITE_TAC [IN] THEN REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"segment[x:real^N,(max (&2) ((B + &1) / norm(x))) % x]") THEN
      REWRITE_TAC [ENDS_IN_SEGMENT, CONNECTED_SEGMENT] THEN
      REWRITE_TAC [segment, SUBSET, FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:real") THEN
      ASM_CASES_TAC (← q r"u = &0") THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID, REAL_SUB_RZERO,
                      VECTOR_ADD_RID, IN_DIFF, IN_UNIV] THEN
      DISCH_TAC THEN
      REWRITE_TAC [← VECTOR_ARITH
        (← q r"a % x + b % c % x:real^N = (a + b * c) % x")] THEN
      ABBREV_TAC (← q r"c = &1 - u + u * max (&2) ((B + &1) / norm(x:real^N))") THEN
      DISCH_TAC THEN SUBGOAL_THEN (← q r"&1 < c") ASSUME_TAC THENL
       [EXPAND_TAC "c" THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&1 < &1 - u + u * x <=> &0 < u * (x - &1)")] THEN
        MATCH_MP_TAC REAL_LT_MUL THEN ASM_REAL_ARITH_TAC,
        UNDISCH_TAC (← q r"~((x:real^N) IN s)") THEN REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"x:real^N = (&1 - inv c) % vec 0 + inv c % c % x")
        SUBST1_TAC THENL
         [REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID, VECTOR_MUL_ASSOC] THEN
          ASM_SIMP_TAC [REAL_MUL_LINV, ← REAL_ARITH (← q r"&1 < x ==> ~(x = &0)")] THEN
          REWRITE_TAC [VECTOR_MUL_LID],
          MATCH_MP_TAC IN_CONVEX_SET THEN
          ASM_SIMP_TAC [REAL_LE_INV_EQ, REAL_INV_LE_1, REAL_LT_IMP_LE] THEN
          ASM_REAL_ARITH_TAC]],
      ASM_SIMP_TAC [NORM_MUL, REAL_NOT_LE, ← GSYM REAL_LT_LDIV_EQ, NORM_POS_LT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < b /\ b < c ==> b < abs(max (&2) c)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, NORM_POS_LT, REAL_LT_DIV2_EQ] THEN
      REAL_ARITH_TAC])

  let INSIDE_CONVEX ← prove
   r"!s. convex s ==> inside s = {}"
   (SIMP_TAC [INSIDE_OUTSIDE, OUTSIDE_CONVEX] THEN SET_TAC [])

  let OUTSIDE_SUBSET_CONVEX ← prove
   r"!s t. convex t /\ s SUBSET t ==> (:real^N) DIFF t SUBSET outside s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"outside(t:real^N->bool)") THEN
    ASM_SIMP_TAC [OUTSIDE_MONO] THEN
    ASM_SIMP_TAC [OUTSIDE_CONVEX, SUBSET_REFL])

  let INSIDE_SUBSET_CONVEX ← prove
   r"!s c:real^N->bool. convex c /\ s SUBSET c ==> inside s SUBSET c"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INSIDE_OUTSIDE] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"c:real^N->bool"]
      OUTSIDE_SUBSET_CONVEX) THEN
    ASM SET_TAC [])

  let INSIDE_SUBSET_CONVEX_HULL ← prove
   r"!s:real^N->bool. inside s SUBSET convex hull s"
   (SIMP_TAC [INSIDE_SUBSET_CONVEX, CONVEX_CONVEX_HULL, HULL_SUBSET])

  return { INSIDE_UNIQUE, INSIDE_OUTSIDE_UNIQUE, INTERIOR_INSIDE_FRONTIER, INSIDE_EMPTY,
           OUTSIDE_EMPTY, INSIDE_SAME_COMPONENT, OUTSIDE_SAME_COMPONENT,
           CONNECTED_COMPONENT_INSIDE, CONNECTED_COMPONENT_OUTSIDE, BOUNDED_COMPONENTS_INSIDE,
           UNBOUNDED_COMPONENTS_OUTSIDE, INSIDE_WITH_INSIDE, OUTSIDE_WITH_OUTSIDE,
           OUTSIDE_CONVEX, INSIDE_CONVEX, OUTSIDE_SUBSET_CONVEX, INSIDE_SUBSET_CONVEX,
           INSIDE_SUBSET_CONVEX_HULL }

/- ------------------------------------------------------------------------- -/
/- Inside and outside (continued): convex hulls, frontiers, openness and     -/
/- closures.  (paths.ml 15805-16056)                                         -/
/- ------------------------------------------------------------------------- -/

structure PVC where
  UNBOUNDED_DISJOINT_IN_OUTSIDE : thm
  INSIDE_SUBSET_INTERIOR_CONVEX : thm
  INSIDE_SUBSET_INTERIOR_CONVEX_HULL : thm
  OUTSIDE_FRONTIER_MISSES_CLOSURE : thm
  OUTSIDE_FRONTIER_EQ_COMPLEMENT_CLOSURE : thm
  INSIDE_FRONTIER_EQ_INTERIOR : thm
  INSIDE_SPHERE : thm
  OUTSIDE_SPHERE : thm
  OPEN_INSIDE : thm
  OPEN_OUTSIDE : thm
  CLOSURE_INSIDE_SUBSET : thm
  FRONTIER_INSIDE_SUBSET : thm
  FRONTIER_WITH_INSIDE_SUBSET : thm
  CLOSURE_OUTSIDE_SUBSET : thm
  FRONTIER_OUTSIDE_SUBSET : thm
  FRONTIER_WITH_OUTSIDE_SUBSET : thm
  CLOSED_WITH_INSIDE : thm
  BOUNDED_WITH_INSIDE : thm
  COMPACT_WITH_INSIDE : thm
  INSIDE_COMPLEMENT_UNBOUNDED_CONNECTED_EMPTY : thm
  INSIDE_BOUNDED_COMPLEMENT_CONNECTED_EMPTY : thm
  INSIDE_INSIDE : thm
  INSIDE_INSIDE_SUBSET : thm
  INSIDE_OUTSIDE_INTERSECT_CONNECTED : thm
  OUTSIDE_BOUNDED_NONEMPTY : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVC [HolBase] (D : PathsDeps) (BUG : PUG) (BVA : PVA) (BVB : PVB) :
    ExceptT String IO PVC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, IN, INSERT_SUBSET, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IMP, .. } := D.cvx.core3
  let { REAL_NOT_LT, SUBSET, SUBSET_ANTISYM, SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { DIST_SYM, .. } := D.cvx.vec1
  let { BOUNDED_BALL, BOUNDED_CBALL, BOUNDED_INSERT, BOUNDED_SUBSET, BOUNDED_SUBSET_BALL,
        CLOSED_CLOSURE, .. } := D.cvx.top1
  let { CLOSURE_HALFSPACE_LT, CLOSURE_INC, CLOSURE_MINIMAL, CLOSURE_SUBSET,
        COMPACT_EQ_BOUNDED_CLOSED, CONNECTED_COMPONENT_MAXIMAL, .. } := D.cvx.top2
  let { FRONTIER_CBALL, .. } := D.cvx.top3
  let { INTERIOR_CBALL, INTERIOR_OPEN, INTERIOR_SUBSET, IN_BALL, NOT_BOUNDED_UNIV,
        OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { closed, frontier, .. } := D.cvx.top5
  let { BOUNDED_HALFSPACE_LT, BOUNDED_UNION, CLOSED_UNION, COBOUNDED_IMP_UNBOUNDED, .. } :=
    D.ptop1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EQ, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_CONNECTED_COMPONENT, CONNECTED_CONNECTED_COMPONENT_SET,
        CONNECTED_INTERMEDIATE_CLOSURE, .. } := D.ptop2
  let { FRONTIER_SUBSET_CLOSED, FRONTIER_UNION_SUBSET, .. } := D.ptop3
  let { SET_DIFF_FRONTIER, SPHERE_UNION_BALL, connected_component, open_def, .. } := D.ptop5
  let { CONVEX_BALL, CONVEX_CBALL, CONVEX_CLOSURE, CONVEX_CONNECTED, .. } := D.pcvx1
  let { CONVEX_CONVEX_HULL, CONVEX_HALFSPACE_LT, SUPPORTING_HYPERPLANE_FRONTIER, .. } :=
    D.pcvx2
  let { OPEN_CONNECTED_COMPONENT, .. } := BUG
  let { inside, outside, INSIDE_NO_OVERLAP, OUTSIDE_NO_OVERLAP, INSIDE_INTER_OUTSIDE,
        INSIDE_OUTSIDE, OUTSIDE_INSIDE, BOUNDED_INSIDE, .. } := BVA
  let { INTERIOR_INSIDE_FRONTIER, INSIDE_SAME_COMPONENT, OUTSIDE_SAME_COMPONENT,
        OUTSIDE_SUBSET_CONVEX, INSIDE_SUBSET_CONVEX, .. } := BVB
  -- @@SCOPE END

  let UNBOUNDED_DISJOINT_IN_OUTSIDE ← prove
   r"!s t x:real^N.
       connected t /\ ~bounded t /\ x IN t /\ DISJOINT s t ==> x IN outside s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [outside, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~bounded(t:real^N->bool)") THEN REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN ASM SET_TAC [])

  let INSIDE_SUBSET_INTERIOR_CONVEX ← prove
   r"!s c:real^N->bool. convex c /\ s SUBSET c ==> inside s SUBSET interior c"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SET_DIFF_FRONTIER] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET t DIFF u <=> s SUBSET t /\ DISJOINT s u")] THEN
    ASM_SIMP_TAC [INSIDE_SUBSET_CONVEX] THEN
    REWRITE_TAC [← SET_RULE (← q r"DISJOINT s t <=> !x. x IN s ==> ~(x IN t)")] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REPEAT DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"x:real^N"]
      SUPPORTING_HYPERPLANE_FRONTIER) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x INSERT {y:real^N | a dot y < a dot x}",
                   ← q r"x:real^N"] UNBOUNDED_DISJOINT_IN_OUTSIDE) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
      EXISTS_TAC (← q r"{y:real^N | a dot y < a dot x}") THEN
      ASM_SIMP_TAC [CLOSURE_HALFSPACE_LT, CONVEX_CONNECTED, CONVEX_HALFSPACE_LT,
                   INSERT_SUBSET, IN_ELIM_THM, SUBSET, IN_INSERT] THEN
      REAL_ARITH_TAC,
      ASM_REWRITE_TAC [BOUNDED_INSERT, BOUNDED_HALFSPACE_LT],
      REWRITE_TAC [IN_INSERT],
      REWRITE_TAC [← SET_RULE
      (← q r"DISJOINT s (x INSERT t) <=> ~(x IN s) /\ (!y. y IN s ==> ~(y IN t))")] THEN
      CONJ_TAC THENL
       [MP_TAC (← ISPEC (← q r"s:real^N->bool") INSIDE_NO_OVERLAP) THEN ASM SET_TAC [],
        REWRITE_TAC [IN_ELIM_THM, REAL_NOT_LT] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        MATCH_MP_TAC CLOSURE_INC THEN ASM SET_TAC []],
      MP_TAC (← ISPEC (← q r"s:real^N->bool") INSIDE_INTER_OUTSIDE) THEN ASM SET_TAC []])

  let INSIDE_SUBSET_INTERIOR_CONVEX_HULL ← prove
   r"!s:real^N->bool. inside s SUBSET interior(convex hull s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INSIDE_SUBSET_INTERIOR_CONVEX THEN
    REWRITE_TAC [CONVEX_CONVEX_HULL, HULL_SUBSET])

  let OUTSIDE_FRONTIER_MISSES_CLOSURE ← prove
   r"!s. bounded s ==> outside(frontier s) SUBSET (:real^N) DIFF closure s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OUTSIDE_INSIDE] THEN
    SIMP_TAC [← SET_RULE (← q r"(UNIV DIFF s) SUBSET (UNIV DIFF t) <=> t SUBSET s")] THEN
    REWRITE_TAC [frontier] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"i SUBSET ins ==> c SUBSET (c DIFF i) UNION ins")) THEN
    ASM_SIMP_TAC [← GSYM frontier, INTERIOR_INSIDE_FRONTIER])

  let OUTSIDE_FRONTIER_EQ_COMPLEMENT_CLOSURE ← prove
   r"!s. bounded s /\ convex s
       ==> outside(frontier s) = (:real^N) DIFF closure s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [OUTSIDE_FRONTIER_MISSES_CLOSURE] THEN
    MATCH_MP_TAC OUTSIDE_SUBSET_CONVEX THEN
    ASM_SIMP_TAC [CONVEX_CLOSURE, frontier] THEN SET_TAC [])

  let INSIDE_FRONTIER_EQ_INTERIOR ← prove
   r"!s:real^N->bool.
        bounded s /\ convex s ==> inside(frontier s) = interior s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [INSIDE_OUTSIDE, OUTSIDE_FRONTIER_EQ_COMPLEMENT_CLOSURE] THEN
    REWRITE_TAC [frontier] THEN
    MAP_EVERY (MP_TAC o ISPEC (← q r"s:real^N->bool"))
     [CLOSURE_SUBSET, INTERIOR_SUBSET] THEN
    ASM SET_TAC [])

  let INSIDE_SPHERE ← prove
   r"!a:real^N r. inside(sphere(a,r)) = ball(a,r)"
   (REWRITE_TAC [← GSYM FRONTIER_CBALL] THEN
    SIMP_TAC [INSIDE_FRONTIER_EQ_INTERIOR, BOUNDED_CBALL, CONVEX_CBALL] THEN
    REWRITE_TAC [INTERIOR_CBALL])

  let OUTSIDE_SPHERE ← prove
   r"!a r. outside(sphere(a,r)) = (:real^N) DIFF cball(a,r)"
   (REWRITE_TAC [OUTSIDE_INSIDE, INSIDE_SPHERE, SPHERE_UNION_BALL])

  let OPEN_INSIDE ← prove
   r"!s:real^N->bool. closed s ==> open(inside s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"open(connected_component ((:real^N) DIFF s) x)") MP_TAC THENL
     [MATCH_MP_TAC OPEN_CONNECTED_COMPONENT THEN ASM_REWRITE_TAC [← GSYM closed],
      REWRITE_TAC [open_def] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ] THEN
        GEN_REWRITE_TAC id [← GSYM IN] THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") INSIDE_NO_OVERLAP) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [SUBSET, IN_BALL] THEN
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        MATCH_MP_TAC INSIDE_SAME_COMPONENT THEN
        EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [DIST_SYM]]])

  let OPEN_OUTSIDE ← prove
   r"!s:real^N->bool. closed s ==> open(outside s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"open(connected_component ((:real^N) DIFF s) x)") MP_TAC THENL
     [MATCH_MP_TAC OPEN_CONNECTED_COMPONENT THEN ASM_REWRITE_TAC [← GSYM closed],
      REWRITE_TAC [open_def] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ] THEN
        GEN_REWRITE_TAC id [← GSYM IN] THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") OUTSIDE_NO_OVERLAP) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [SUBSET, IN_BALL] THEN
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        MATCH_MP_TAC OUTSIDE_SAME_COMPONENT THEN
        EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN]) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [DIST_SYM]]])

  let CLOSURE_INSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> closure(inside s) SUBSET s UNION inside s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
    ASM_SIMP_TAC [closed, ← GSYM OUTSIDE_INSIDE, OPEN_OUTSIDE] THEN SET_TAC [])

  let FRONTIER_INSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> frontier(inside s) SUBSET s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [frontier, OPEN_INSIDE, INTERIOR_OPEN] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSURE_INSIDE_SUBSET) THEN SET_TAC [])

  let FRONTIER_WITH_INSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> frontier(s UNION inside s) SUBSET s"
   (REPEAT STRIP_TAC THEN TRANS_TAC SUBSET_TRANS
     (← q r"frontier s UNION frontier(inside s):real^N->bool") THEN
    REWRITE_TAC [FRONTIER_UNION_SUBSET, UNION_SUBSET] THEN
    ASM_SIMP_TAC [FRONTIER_INSIDE_SUBSET, FRONTIER_SUBSET_CLOSED])

  let CLOSURE_OUTSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> closure(outside s) SUBSET s UNION outside s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
    ASM_SIMP_TAC [closed, ← GSYM INSIDE_OUTSIDE, OPEN_INSIDE] THEN SET_TAC [])

  let FRONTIER_OUTSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> frontier(outside s) SUBSET s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [frontier, OPEN_OUTSIDE, INTERIOR_OPEN] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSURE_OUTSIDE_SUBSET) THEN SET_TAC [])

  let FRONTIER_WITH_OUTSIDE_SUBSET ← prove
   r"!s:real^N->bool. closed s ==> frontier(s UNION outside s) SUBSET s"
   (REPEAT STRIP_TAC THEN TRANS_TAC SUBSET_TRANS
     (← q r"frontier s UNION frontier(outside s):real^N->bool") THEN
    REWRITE_TAC [FRONTIER_UNION_SUBSET, UNION_SUBSET] THEN
    ASM_SIMP_TAC [FRONTIER_OUTSIDE_SUBSET, FRONTIER_SUBSET_CLOSED])

  let CLOSED_WITH_INSIDE ← prove
   r"!s:real^N->bool. closed s ==> closed(s UNION inside s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s UNION inside s:real^N->bool = s UNION closure(inside s)")
    SUBST1_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CLOSURE_INSIDE_SUBSET) THEN
      MP_TAC (← ISPEC (← q r"inside s:real^N->bool") CLOSURE_SUBSET) THEN SET_TAC [],
      ASM_SIMP_TAC [CLOSED_UNION, CLOSED_CLOSURE]])

  let BOUNDED_WITH_INSIDE ← prove
   r"!s:real^N->bool. bounded s ==> bounded(s UNION inside s)"
   (SIMP_TAC [BOUNDED_UNION, BOUNDED_INSIDE])

  let COMPACT_WITH_INSIDE ← prove
   r"!s:real^N->bool. compact s ==> compact(s UNION inside s)"
   (SIMP_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_WITH_INSIDE,
             CLOSED_WITH_INSIDE])

  let INSIDE_COMPLEMENT_UNBOUNDED_CONNECTED_EMPTY ← prove
   r"!s. connected((:real^N) DIFF s) /\ ~bounded((:real^N) DIFF s)
       ==> inside s = {}"
   (REWRITE_TAC [inside, CONNECTED_CONNECTED_COMPONENT_SET] THEN
    REWRITE_TAC [← SET_RULE (← q r"s = {} <=> !x. x IN s ==> F")] THEN
    SIMP_TAC [IN_ELIM_THM, IN_DIFF, IN_UNIV, ← TAUT (← q r"~(a /\ b) <=> a ==> ~b")])

  let INSIDE_BOUNDED_COMPLEMENT_CONNECTED_EMPTY ← prove
   r"!s. connected((:real^N) DIFF s) /\ bounded s
       ==> inside s = {}"
   (MESON_TAC [INSIDE_COMPLEMENT_UNBOUNDED_CONNECTED_EMPTY,
              COBOUNDED_IMP_UNBOUNDED])

  let INSIDE_INSIDE ← prove
   r"!s t:real^N->bool.
        s SUBSET inside t ==> inside s DIFF t SUBSET inside t"
   (REPEAT STRIP_TAC THEN SIMP_TAC [SUBSET, inside, IN_DIFF, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s INTER connected_component ((:real^N) DIFF t) x = {}") THENL
     [MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"connected_component ((:real^N) DIFF s) x") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT, IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s INTER t = {}) ==> ?x. x IN s /\ x IN t"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (SUBST_ALL_TAC o SYM o MATCH_MP CONNECTED_COMPONENT_EQ) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N")) THEN
      ASM_SIMP_TAC [inside, IN_ELIM_THM]])

  let INSIDE_INSIDE_SUBSET ← prove
   r"!s:real^N->bool. inside(inside s) SUBSET s"
   (GEN_TAC THEN MP_TAC
     (← ISPECL [← q r"inside s:real^N->bool", ← q r"s:real^N->bool"] INSIDE_INSIDE) THEN
    REWRITE_TAC [SUBSET_REFL] THEN
    MP_TAC (← ISPEC (← q r"inside s:real^N->bool") INSIDE_NO_OVERLAP) THEN SET_TAC [])

  let INSIDE_OUTSIDE_INTERSECT_CONNECTED ← prove
   r"!s t:real^N->bool.
        connected t /\ ~(inside s INTER t = {}) /\ ~(outside s INTER t = {})
        ==> ~(s INTER t = {})"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
    REWRITE_TAC [inside, outside, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"x:real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC)) THEN
    SUBGOAL_THEN
     (← q r"connected_component ((:real^N) DIFF s) y =
      connected_component ((:real^N) DIFF s) x")
     (fun th => ASM_MESON_TAC [th]) THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_EQ_EQ, IN_DIFF, IN_UNIV] THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM SET_TAC [])

  let OUTSIDE_BOUNDED_NONEMPTY ← prove
   r"!s:real^N->bool. bounded s ==> ~(outside s = {})"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] OUTSIDE_SUBSET_CONVEX)) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    SIMP_TAC [CONVEX_BALL, SUBSET_EMPTY] THEN
    REWRITE_TAC [← SET_RULE (← q r"s DIFF t = {} <=> s SUBSET t")] THEN
    MESON_TAC [BOUNDED_BALL, BOUNDED_SUBSET, NOT_BOUNDED_UNIV])

  return { UNBOUNDED_DISJOINT_IN_OUTSIDE, INSIDE_SUBSET_INTERIOR_CONVEX,
           INSIDE_SUBSET_INTERIOR_CONVEX_HULL, OUTSIDE_FRONTIER_MISSES_CLOSURE,
           OUTSIDE_FRONTIER_EQ_COMPLEMENT_CLOSURE, INSIDE_FRONTIER_EQ_INTERIOR, INSIDE_SPHERE,
           OUTSIDE_SPHERE, OPEN_INSIDE, OPEN_OUTSIDE, CLOSURE_INSIDE_SUBSET,
           FRONTIER_INSIDE_SUBSET, FRONTIER_WITH_INSIDE_SUBSET, CLOSURE_OUTSIDE_SUBSET,
           FRONTIER_OUTSIDE_SUBSET, FRONTIER_WITH_OUTSIDE_SUBSET, CLOSED_WITH_INSIDE,
           BOUNDED_WITH_INSIDE, COMPACT_WITH_INSIDE, INSIDE_COMPLEMENT_UNBOUNDED_CONNECTED_EMPTY,
           INSIDE_BOUNDED_COMPLEMENT_CONNECTED_EMPTY, INSIDE_INSIDE, INSIDE_INSIDE_SUBSET,
           INSIDE_OUTSIDE_INTERSECT_CONNECTED, OUTSIDE_BOUNDED_NONEMPTY }

/- ------------------------------------------------------------------------- -/
/- Inside and outside (continued): compact connected sets, components.       -/
/- (paths.ml 16052-16386)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVD where
  OUTSIDE_COMPACT_IN_OPEN : thm
  INSIDE_INSIDE_COMPACT_CONNECTED : thm
  INSIDE_SELF_OUTSIDE_COMPACT_CONNECTED : thm
  INSIDE_OUTSIDE_COMPACT_CONNECTED : thm
  CONNECTED_WITH_INSIDE : thm
  CONNECTED_WITH_OUTSIDE : thm
  INSIDE_INSIDE_EQ_EMPTY : thm
  INSIDE_IN_COMPONENTS : thm
  OUTSIDE_IN_COMPONENTS : thm
  BOUNDED_UNIQUE_OUTSIDE : thm
  EMPTY_INSIDE_PSUBSET_CONVEX_FRONTIER : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVD [HolBase] (D : PathsDeps) (BB : PTB) (BH : PTH) (BI : PTI) (BUS : PUS)
    (BVA : PVA) (BVB : PVB) (BVC : PVC) : ExceptT String IO PVD := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { DIMINDEX_GE_1, EMPTY_SUBSET, EXTENSION, .. } := D.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, INSERT_SUBSET, INTER_COMM, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, IN_UNIV,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, .. } :=
    D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_NOT_LT, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { HULL_MINIMAL, .. } := D.cvx.misc
  let { DIST_SYM, .. } := D.cvx.vec1
  let { BOUNDED_BALL, BOUNDED_INSERT, BOUNDED_SUBSET, BOUNDED_SUBSET_BALL, CENTRE_IN_CBALL,
        CLOSURE_APPROACHABLE, CLOSURE_CLOSED, .. } := D.cvx.top1
  let { CLOSURE_HALFSPACE_LT, CLOSURE_SUBSET, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED,
        COMPACT_IMP_CLOSED, CONNECTED_COMPONENT_MAXIMAL, CONNECTED_INSERT, CONNECTED_SEGMENT,
        .. } := D.cvx.top2
  let { ENDS_IN_SEGMENT, FRONTIER_COMPLEMENT, .. } := D.cvx.top3
  let { INTERIOR_OPEN, INTERIOR_UNIV, IN_CBALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET,
        NOT_BOUNDED_UNIV, OPEN_CONTAINS_CBALL, .. } := D.cvx.top4
  let { UNIONS_COMPONENTS, closed, frontier, .. } := D.cvx.top5
  let { COMPL_COMPL, .. } := D.pses1
  let { BOUNDED_HALFSPACE_LT, BOUNDED_UNION, .. } := D.ptop1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_SELF, CONNECTED_COMPONENT_SET,
        CONNECTED_IFF_CONNECTED_COMPONENT, CONNECTED_SING, CONNECTED_UNION, CONNECTED_UNIV,
        .. } := D.ptop2
  let { INTERIOR_DIFF, IN_COMPONENTS_MAXIMAL, .. } := D.ptop4
  let { OPEN_CLOSED, connected_component, .. } := D.ptop5
  let { CONNECTED_CONVEX_1_GEN, CONVEX_BALL, CONVEX_CBALL, CONVEX_CLOSURE,
        CONVEX_CLOSURE_INTERIOR, CONVEX_CONNECTED, .. } := D.pcvx1
  let { CONVEX_HALFSPACE_LT, CONVEX_INTERIOR, SEGMENT_CONVEX_HULL,
        SUPPORTING_HYPERPLANE_FRONTIER, UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX, .. } := D.pcvx2
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE, .. } := BB
  let { EXISTS_PATH_SUBPATH_TO_FRONTIER, .. } := BH
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  let { COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS, .. } := BUS
  let { inside, INSIDE_NO_OVERLAP, OUTSIDE_NO_OVERLAP, INSIDE_OUTSIDE,
        INSIDE_SELF_OUTSIDE_EVERSION, UNBOUNDED_OUTSIDE, BOUNDED_INSIDE, CONNECTED_OUTSIDE,
        .. } := BVA
  let { INSIDE_EMPTY, INSIDE_SAME_COMPONENT, OUTSIDE_SAME_COMPONENT, INSIDE_CONVEX,
        OUTSIDE_SUBSET_CONVEX, .. } := BVB
  let { OPEN_INSIDE, OPEN_OUTSIDE, FRONTIER_INSIDE_SUBSET, FRONTIER_OUTSIDE_SUBSET,
        INSIDE_INSIDE, INSIDE_OUTSIDE_INTERSECT_CONNECTED, OUTSIDE_BOUNDED_NONEMPTY, .. } := BVC
  -- @@SCOPE END

  let OUTSIDE_COMPACT_IN_OPEN ← prove
   r"!s t:real^N->bool.
        compact s /\ open t /\ s SUBSET t /\ ~(t = {})
        ==> ~(outside s INTER t = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OUTSIDE_BOUNDED_NONEMPTY o
          MATCH_MP COMPACT_IMP_BOUNDED) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM, IN_INTER] THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN t") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"linepath(a:real^N,b)", ← q r"(:real^N) DIFF t"]
          EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
    REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^1->real^N") THEN REWRITE_TAC [FRONTIER_COMPLEMENT] THEN
    REWRITE_TAC [PATH_IMAGE_LINEPATH, INTERIOR_DIFF, INTERIOR_UNIV] THEN
    ABBREV_TAC (← q r"c:real^N = pathfinish g") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"frontier t SUBSET (:real^N) DIFF s") MP_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM FRONTIER_COMPLEMENT] THEN
      REWRITE_TAC [frontier] THEN
      ASM_SIMP_TAC [CLOSURE_CLOSED, ← GSYM OPEN_CLOSED] THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, IN_DIFF, IN_UNIV]] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") OPEN_CONTAINS_CBALL) THEN
    ASM_SIMP_TAC [← GSYM closed, COMPACT_IMP_CLOSED, IN_DIFF, IN_UNIV] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"c:real^N", ← q r"t:real^N->bool"]
          CLOSURE_APPROACHABLE) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [frontier, IN_DIFF]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC OUTSIDE_SAME_COMPONENT THEN
    EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"path_image(g) UNION segment[c:real^N,d]") THEN
    REWRITE_TAC [IN_UNION, ENDS_IN_SEGMENT] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_UNION THEN
      ASM_SIMP_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY,
                   CONNECTED_PATH_IMAGE] THEN
      EXISTS_TAC (← q r"c:real^N") THEN REWRITE_TAC [ENDS_IN_SEGMENT, IN_INTER] THEN
      ASM_MESON_TAC [PATHFINISH_IN_PATH_IMAGE, SUBSET],
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE]] THEN
      REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"~(c IN s)
          ==> (t DELETE c) SUBSET (UNIV DIFF s)
              ==> t SUBSET (UNIV DIFF s)"))) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
        SIMP_TAC [← SET_RULE (← q r"UNIV DIFF s SUBSET UNIV DIFF t <=> t SUBSET s")] THEN
        ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_SUBSET],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          SUBSET_TRANS)) THEN
       REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
        ASM_SIMP_TAC [CONVEX_CBALL, INSERT_SUBSET, REAL_LT_IMP_LE,
                     EMPTY_SUBSET, CENTRE_IN_CBALL] THEN
        REWRITE_TAC [IN_CBALL] THEN
        ASM_MESON_TAC [DIST_SYM, REAL_LT_IMP_LE]]])

  let INSIDE_INSIDE_COMPACT_CONNECTED ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t /\ s SUBSET inside t /\ connected t
        ==> inside s SUBSET inside t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"inside t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [INSIDE_EMPTY, SUBSET_EMPTY, EMPTY_SUBSET] THEN
    SUBGOAL_THEN (← q r"1 <= dimindex(:N)") MP_TAC THENL
     [REWRITE_TAC [DIMINDEX_GE_1],
      REWRITE_TAC [← ARITH_RULE (← q r"1 <= n <=> n = 1 \/ 2 <= n")]] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [CONNECTED_CONVEX_1_GEN] THENL
     [ASM_MESON_TAC [INSIDE_CONVEX], ALL_TAC] THEN
    STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP INSIDE_INSIDE) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s INTER t = {} ==> s DIFF t SUBSET u ==> s SUBSET u")) THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET, BOUNDED_INSIDE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          INSIDE_OUTSIDE_INTERSECT_CONNECTED) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT
     (← q r"r /\ q ==> (~p /\ q ==> ~r) ==> p")) THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPEC (← q r"t:real^N->bool") INSIDE_NO_OVERLAP) THEN ASM SET_TAC [],
      ONCE_REWRITE_TAC [INTER_COMM]] THEN
    MATCH_MP_TAC INSIDE_OUTSIDE_INTERSECT_CONNECTED THEN
    ASM_SIMP_TAC [CONNECTED_OUTSIDE, COMPACT_IMP_BOUNDED] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [INTER_COMM] THEN MATCH_MP_TAC OUTSIDE_COMPACT_IN_OPEN THEN
      ASM_SIMP_TAC [OPEN_INSIDE, COMPACT_IMP_CLOSED],
      MP_TAC (← ISPECL [← q r"s UNION t:real^N->bool", ← q r"vec 0:real^N"]
          BOUNDED_SUBSET_BALL) THEN
      ASM_SIMP_TAC [BOUNDED_UNION, COMPACT_IMP_BOUNDED] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"!u. ~(u = UNIV) /\ UNIV DIFF u SUBSET s /\ UNIV DIFF u SUBSET t
            ==> ~(s INTER t = {})")) THEN
      EXISTS_TAC (← q r"ball(vec 0:real^N,r)") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [NOT_BOUNDED_UNIV, BOUNDED_BALL], ALL_TAC] THEN
      CONJ_TAC THEN MATCH_MP_TAC OUTSIDE_SUBSET_CONVEX THEN
      REWRITE_TAC [CONVEX_BALL] THEN ASM SET_TAC []])

  let INSIDE_SELF_OUTSIDE_COMPACT_CONNECTED ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t /\ s SUBSET inside t /\ connected t
        ==> t UNION outside t SUBSET outside s"
   (REWRITE_TAC [← GSYM INSIDE_SELF_OUTSIDE_EVERSION] THEN
    SIMP_TAC [UNION_SUBSET] THEN
    REWRITE_TAC [INSIDE_INSIDE_COMPACT_CONNECTED])

  let INSIDE_OUTSIDE_COMPACT_CONNECTED ← prove
   r"!s t:real^N->bool.
        closed s /\ compact t /\ s SUBSET inside t /\ connected t
        ==> t SUBSET outside s"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS (← q r"t UNION outside t:real^N->bool") THEN
    ASM_SIMP_TAC [INSIDE_SELF_OUTSIDE_COMPACT_CONNECTED] THEN SET_TAC [])

  let CONNECTED_WITH_INSIDE ← prove
   r"!s:real^N->bool. closed s /\ connected s ==> connected(s UNION inside s)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s UNION inside s = (:real^N)") THEN
    ASM_REWRITE_TAC [CONNECTED_UNIV] THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SET, IN_ELIM_THM] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN (s UNION inside s)
          ==> ?y:real^N t. y IN s /\ connected t /\ x IN t /\ y IN t /\
                           t SUBSET (s UNION inside s)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_UNION] THEN STRIP_TAC THENL
       [MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"{a:real^N}"] THEN
        ASM_REWRITE_TAC [IN_SING, CONNECTED_SING] THEN ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"~(s UNION t = UNIV) ==> ?b. ~(b IN s) /\ ~(b IN t)"))) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"linepath(a:real^N,b)", ← q r"inside s:real^N->bool"]
          EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
        ASM_SIMP_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
                     IN_UNION, OPEN_INSIDE, INTERIOR_OPEN] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"pathfinish g :real^N") THEN
        EXISTS_TAC (← q r"path_image g :real^N->bool") THEN
        ASM_SIMP_TAC [PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE] THEN
        MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
        REPEAT STRIP_TAC THENL
         [ASM_MESON_TAC [FRONTIER_INSIDE_SUBSET, SUBSET],
          ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE],
          ASM SET_TAC []]],
      DISCH_THEN (fun th => tactic_of do pure (
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
        MP_TAC (← SPEC (← q r"y:real^N") th) THEN
        MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"t:real^N->bool"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"u:real^N->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t UNION v UNION u:real^N->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT (MATCH_MP_TAC CONNECTED_UNION THEN
             ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC) THEN
      ASM SET_TAC []])

  let CONNECTED_WITH_OUTSIDE ← prove
   r"!s:real^N->bool. closed s /\ connected s ==> connected(s UNION outside s)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s UNION outside s = (:real^N)") THEN
    ASM_REWRITE_TAC [CONNECTED_UNIV] THEN
    REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SET, IN_ELIM_THM] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN (s UNION outside s)
          ==> ?y:real^N t. y IN s /\ connected t /\ x IN t /\ y IN t /\
                           t SUBSET (s UNION outside s)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_UNION] THEN STRIP_TAC THENL
       [MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"{a:real^N}"] THEN
        ASM_REWRITE_TAC [IN_SING, CONNECTED_SING] THEN ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"~(s UNION t = UNIV) ==> ?b. ~(b IN s) /\ ~(b IN t)"))) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"linepath(a:real^N,b)", ← q r"outside s:real^N->bool"]
          EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
        ASM_SIMP_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
                     IN_UNION, OPEN_OUTSIDE, INTERIOR_OPEN] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"pathfinish g :real^N") THEN
        EXISTS_TAC (← q r"path_image g :real^N->bool") THEN
        ASM_SIMP_TAC [PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE] THEN
        MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
        REPEAT STRIP_TAC THENL
         [ASM_MESON_TAC [FRONTIER_OUTSIDE_SUBSET, SUBSET],
          ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE],
          ASM SET_TAC []]],
      DISCH_THEN (fun th => tactic_of do pure (
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
        MP_TAC (← SPEC (← q r"y:real^N") th) THEN
        MP_TAC (← SPEC (← q r"x:real^N") th))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"t:real^N->bool"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"u:real^N->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t UNION v UNION u:real^N->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT (MATCH_MP_TAC CONNECTED_UNION THEN
             ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC) THEN
      ASM SET_TAC []])

  let INSIDE_INSIDE_EQ_EMPTY ← prove
   r"!s:real^N->bool.
        closed s /\ connected s ==> inside(inside s) = {}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    X_GEN_TAC (← q r"x:real^N") THEN ONCE_REWRITE_TAC [inside] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    ONCE_REWRITE_TAC [INSIDE_OUTSIDE] THEN
    REWRITE_TAC [COMPL_COMPL] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENT_EQ_SELF, CONNECTED_WITH_OUTSIDE] THEN
    REWRITE_TAC [BOUNDED_UNION] THEN MESON_TAC [UNBOUNDED_OUTSIDE])

  let INSIDE_IN_COMPONENTS ← prove
   r"!s. (inside s) IN components((:real^N) DIFF s) <=>
       connected(inside s) /\ ~(inside s = {})"
   (X_GEN_TAC (← q r"s:real^N->bool") THEN REWRITE_TAC [IN_COMPONENTS_MAXIMAL] THEN
    ASM_CASES_TAC (← q r"inside s:real^N->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"connected(inside s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
    REWRITE_TAC [INSIDE_NO_OVERLAP] THEN
    X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC INSIDE_SAME_COMPONENT THEN
    UNDISCH_TAC (← q r"~(inside s:real^N->bool = {})") THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"d:real^N->bool") THEN ASM SET_TAC [])

  let OUTSIDE_IN_COMPONENTS ← prove
   r"!s. (outside s) IN components((:real^N) DIFF s) <=>
       connected(outside s) /\ ~(outside s = {})"
   (X_GEN_TAC (← q r"s:real^N->bool") THEN REWRITE_TAC [IN_COMPONENTS_MAXIMAL] THEN
    ASM_CASES_TAC (← q r"outside s:real^N->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"connected(outside s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
    REWRITE_TAC [OUTSIDE_NO_OVERLAP] THEN
    X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    MATCH_MP_TAC OUTSIDE_SAME_COMPONENT THEN
    UNDISCH_TAC (← q r"~(outside s:real^N->bool = {})") THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"d:real^N->bool") THEN ASM SET_TAC [])

  let BOUNDED_UNIQUE_OUTSIDE ← prove
   r"!c s. 2 <= dimindex(:N) /\ bounded s
         ==> (c IN components ((:real^N) DIFF s) /\ ~bounded c <=>
              c = outside s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [MATCH_MP_TAC COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS THEN
      EXISTS_TAC (← q r"(:real^N) DIFF s") THEN
      ASM_REWRITE_TAC [COMPL_COMPL] THEN
      ASM_REWRITE_TAC [OUTSIDE_IN_COMPONENTS],
      ASM_REWRITE_TAC [OUTSIDE_IN_COMPONENTS]] THEN
    ASM_SIMP_TAC [UNBOUNDED_OUTSIDE, OUTSIDE_BOUNDED_NONEMPTY,
                 CONNECTED_OUTSIDE])

  let EMPTY_INSIDE_PSUBSET_CONVEX_FRONTIER ← prove
   r"!s t:real^N->bool.
        convex s /\ t PSUBSET frontier s ==> inside t = {}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [inside] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN closure s") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      SUBGOAL_THEN (← q r"x IN UNIONS(components((:real^N) DIFF closure s))")
      MP_TAC THENL
       [ASM_REWRITE_TAC [← GSYM UNIONS_COMPONENTS, IN_DIFF, IN_UNIV],
        REWRITE_TAC [IN_UNIONS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          UNBOUNDED_COMPLEMENT_COMPONENT_CONVEX)) THEN
        ASM_SIMP_TAC [CONVEX_CLOSURE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC []]] THEN
    SUBGOAL_THEN
     (← q r"?y:real^N.
          y IN frontier s /\ ~(y IN t) /\
          connected_component ((:real^N) DIFF t) x =
          connected_component ((:real^N) DIFF t) y")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"(x:real^N) IN frontier s") THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"t PSUBSET s ==> ?x. x IN s /\ ~(x IN t)"))) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_EQ THEN REWRITE_TAC [IN] THEN
      REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"(y:real^N) INSERT interior s") THEN
      ASM_REWRITE_TAC [IN_INSERT] THEN
      ASM_SIMP_TAC [IN_INSERT, CONNECTED_INSERT, CONVEX_CONNECTED,
                   CONVEX_INTERIOR, INSERT_SUBSET, IN_DIFF, IN_UNIV] THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN interior s /\ ~(interior s = {})")
      STRIP_ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [CONVEX_CLOSURE_INTERIOR] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC [],
      FIRST_X_ASSUM SUBST_ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"y:real^N"]
          SUPPORTING_HYPERPLANE_FRONTIER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"y INSERT {u:real^N | a dot u < a dot y}") o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] BOUNDED_SUBSET)) THEN
    ASM_REWRITE_TAC [NOT_IMP, BOUNDED_INSERT, BOUNDED_HALFSPACE_LT] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
    ASM_SIMP_TAC [IN_INSERT, CONNECTED_INSERT, CONVEX_CONNECTED,
                 CONVEX_HALFSPACE_LT, CLOSURE_HALFSPACE_LT] THEN
    REWRITE_TAC [INSERT_SUBSET, IN_ELIM_THM, REAL_LE_REFL] THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_ELIM_THM, REAL_NOT_LT, IN_UNIV, ← SET_RULE
     (← q r"s SUBSET UNIV DIFF t <=> !x. x IN t ==> ~(x IN s)")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC [])

  return { OUTSIDE_COMPACT_IN_OPEN, INSIDE_INSIDE_COMPACT_CONNECTED,
           INSIDE_SELF_OUTSIDE_COMPACT_CONNECTED, INSIDE_OUTSIDE_COMPACT_CONNECTED,
           CONNECTED_WITH_INSIDE, CONNECTED_WITH_OUTSIDE, INSIDE_INSIDE_EQ_EMPTY,
           INSIDE_IN_COMPONENTS, OUTSIDE_IN_COMPONENTS, BOUNDED_UNIQUE_OUTSIDE,
           EMPTY_INSIDE_PSUBSET_CONVEX_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- A Euclidean-centric formulation of homotopy; trivial properties.          -/
/- (paths.ml 16387-16643)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVE where
  HOMOTOPIC_WITH_EUCLIDEAN : thm
  HOMOTOPIC_WITH_EUCLIDEAN_ALT : thm
  HOMOTOPIC_WITH_RESTRICT : thm
  HOMOTOPIC_WITH_IMP_CONTINUOUS : thm
  HOMOTOPIC_WITH_IMP_SUBSET : thm
  HOMOTOPIC_WITH_MONO : thm
  HOMOTOPIC_WITH_SUBSET_LEFT : thm
  HOMOTOPIC_WITH_SUBSET_RIGHT : thm
  HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT : thm
  HOMOTOPIC_COMPOSE_CONTINUOUS_RIGHT : thm
  HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT : thm
  HOMOTOPIC_COMPOSE_CONTINUOUS_LEFT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVE [HolBase] (D : PathsDeps) : ExceptT String IO PVE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D.cvx
  let { ARITH_EQ, CONJ_ASSOC, CONJ_SYM, EQ_IMP, ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PAIR_THM, FSTCART_PASTECART, FUN_IN_IMAGE,
        IMP_CONJ, IMP_CONJ_ALT, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        PASTECART_IN_PCROSS, PCROSS, .. } := D.cvx.core3
  let { REAL_LE_REFL, .. } := D.cvx.core4
  let { REAL_POS, RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_PCROSS, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNWIND_THM1, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_NUM, .. } := D.cvx.vec2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { IN_CROSS, .. } := D.pses1
  let { VEC_EQ, .. } := D.pvec
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_FST,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND,
        HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT,
        HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT, .. } := D.pmet1
  let { SUBTOPOLOGY_CROSS, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY,
        homotopic_with, .. } := D.pmet2
  let { CONTINUOUS_MAP_DROP, CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN,
        CONTINUOUS_MAP_LIFT, CONTINUOUS_MAP_PASTECART, .. } := D.ptop2
  let { CONTINUOUS_ON_FSTCART, CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_SNDCART, .. } := D.ptop3
  let { INTERVAL_REAL_INTERVAL, .. } := D.ptop4
  -- @@SCOPE END

  let HOMOTOPIC_WITH_EUCLIDEAN ← prove
   r"!P X Y (p:real^M->real^N) q.
    homotopic_with P (subtopology euclidean X,subtopology euclidean Y) p q <=>
        ?h:real^(1,M)finite_sum->real^N.
                h continuous_on (interval[vec 0,vec 1] PCROSS X) /\
                IMAGE h (interval[vec 0,vec 1] PCROSS X) SUBSET Y /\
                (!x. h(pastecart (vec 0) x) = p x) /\
                (!x. h(pastecart (vec 1) x) = q x) /\
                (!t. t IN interval[vec 0,vec 1] ==> P(\x. h(pastecart t x)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_with] THEN
    REWRITE_TAC [CONJ_ASSOC, ← GSYM CONTINUOUS_MAP_EUCLIDEAN2] THEN
    REWRITE_TAC [INTERVAL_REAL_INTERVAL, FORALL_IN_IMAGE, DROP_VEC] THEN
    EQ_TAC THEN REWRITE_TAC [← GSYM CONJ_ASSOC, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"h:real#real^M->real^N") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(h:real#real^M->real^N) o (\z. drop(fstcart z),sndcart z)") THEN
      ASM_REWRITE_TAC [o_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      ASM_REWRITE_TAC [LIFT_DROP, DROP_VEC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONTINUOUS_MAP_COMPOSE)) THEN
      REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF] THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, FORALL_IN_PCROSS,
                  FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, LIFT_DROP] THEN
      CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN] THEN
      SIMP_TAC [CONTINUOUS_ON_SNDCART, CONTINUOUS_ON_ID] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"euclidean:(real^1)topology") THEN
      REWRITE_TAC [CONTINUOUS_MAP_DROP] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
      REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN] THEN
      SIMP_TAC [CONTINUOUS_ON_FSTCART, CONTINUOUS_ON_ID],
      X_GEN_TAC (← q r"h:real^(1,M)finite_sum->real^N") THEN STRIP_TAC THEN EXISTS_TAC
       (← q r"(h:real^(1,M)finite_sum->real^N) o
        (\(x,y). pastecart x y) o (\z. lift(FST z),SND z)") THEN
      ASM_REWRITE_TAC [o_THM, LIFT_NUM] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONTINUOUS_MAP_COMPOSE)) THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_PROD_TOPOLOGY,
                  FORALL_PAIR_THM, IN_CROSS, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                  PASTECART_IN_PCROSS, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      SIMP_TAC [FUN_IN_IMAGE, o_THM, PASTECART_IN_PCROSS] THEN
      REWRITE_TAC [← GSYM SUBTOPOLOGY_CROSS] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology (euclidean:(real^1)topology)
                                (euclidean:(real^M)topology)") THEN
      REWRITE_TAC [CONTINUOUS_MAP_PASTECART] THEN
      REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF] THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
        MESON_TAC [CONTINUOUS_MAP_LIFT, CONTINUOUS_MAP_FST],
        REWRITE_TAC [CONTINUOUS_MAP_SND, ETA_AX]]])

  /- We often want to just localize the ending function equality or whatever. -/

  let HOMOTOPIC_WITH_EUCLIDEAN_ALT ← prove
   r"(!h k. (!x. x IN X ==> h x = k x) ==> (P h <=> P k))
   ==> (homotopic_with P
           (subtopology euclidean X,subtopology euclidean Y) p q <=>
        ?h:real^(1,M)finite_sum->real^N.
          h continuous_on (interval[vec 0,vec 1] PCROSS X) /\
          IMAGE h (interval[vec 0,vec 1] PCROSS X) SUBSET Y /\
          (!x. x IN X ==> h(pastecart (vec 0) x) = p x) /\
          (!x. x IN X ==> h(pastecart (vec 1) x) = q x) /\
          (!t. t IN interval[vec 0,vec 1] ==> P(\x. h(pastecart t x))))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
      REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,M)finite_sum->real^N")
        (fun th => tactic_of do pure (EXISTS_TAC
          (← q r"\y. if sndcart(y) IN X then (h:real^(1,M)finite_sum->real^N) y
               else if fstcart(y) = vec 0 then p(sndcart y)
               else q(sndcart y)") THEN
        MP_TAC th))) THEN
       REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, VEC_EQ, ARITH_EQ] THEN
       REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THENL
        [MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_EQ) THEN
         SIMP_TAC [FORALL_IN_GSPEC, SNDCART_PASTECART],
         SIMP_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC, SUBSET] THEN
         SIMP_TAC [FORALL_IN_GSPEC, SNDCART_PASTECART],
         ASM_MESON_TAC [],
         ASM_MESON_TAC [],
         MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"t:real^1") THEN
         MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
         MATCH_MP_TAC EQ_IMP THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         SIMP_TAC []]])

  /- Trivial properties. -/

  let HOMOTOPIC_WITH_RESTRICT ← prove
   r"!P s t s' t' f g:real^M->real^N.
        homotopic_with P
         (subtopology euclidean s,subtopology euclidean t) f g /\
        s' SUBSET s /\
        (!h. P h /\ IMAGE h s SUBSET t ==> IMAGE h s' SUBSET t')
        ==> homotopic_with P
             (subtopology euclidean s',subtopology euclidean t') f g"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_PCROSS] THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"x:real^M"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"\x. (h:real^(1,M)finite_sum->real^N)(pastecart a x)")) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS]) THEN
      ASM_SIMP_TAC []])

  let HOMOTOPIC_WITH_IMP_CONTINUOUS ← prove
   r"!P X Y (f:real^M->real^N) g.
      homotopic_with P (subtopology euclidean X,subtopology euclidean Y) f g
      ==> f continuous_on X /\ g continuous_on X"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,M)finite_sum->real^N") MP_TAC) THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"((h:real^(1,M)finite_sum->real^N) o (\x. pastecart (vec 0) x))
      continuous_on X /\
      ((h:real^(1,M)finite_sum->real^N) o (\x. pastecart (vec 1) x))
      continuous_on X")
    MP_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [o_DEF, ETA_AX]] THEN
    CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    SIMP_TAC [RIGHT_EXISTS_AND_THM, UNWIND_THM1, IN_INTERVAL_1] THEN
    REWRITE_TAC [DROP_VEC, REAL_POS, REAL_LE_REFL])

  let HOMOTOPIC_WITH_IMP_SUBSET ← prove
   r"!P X Y (f:real^M->real^N) g.
      homotopic_with P (subtopology euclidean X,subtopology euclidean Y) f g
      ==> IMAGE f X SUBSET Y /\ IMAGE g X SUBSET Y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,M)finite_sum->real^N") MP_TAC) THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_PCROSS, SUBSET] THEN DISCH_THEN
     (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"vec 0:real^1") th) THEN
                MP_TAC (← SPEC (← q r"vec 1:real^1") th))) THEN
    ASM_SIMP_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL])

  let HOMOTOPIC_WITH_MONO ← prove
   r"!P Q X Y f g:real^M->real^N.
        homotopic_with P
          (subtopology euclidean X,subtopology euclidean Y) f g /\
        (!h. h continuous_on X /\ IMAGE h X SUBSET Y /\ P h ==> Q h)
        ==> homotopic_with Q
             (subtopology euclidean X,subtopology euclidean Y) f g"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
               CONTINUOUS_ON_CONST] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      ASM SET_TAC []])

  let HOMOTOPIC_WITH_SUBSET_LEFT ← prove
   r"!P X Y Z f g.
        homotopic_with P
         (subtopology euclidean X,subtopology euclidean Y) f g /\
        Z SUBSET X
        ==> homotopic_with P
             (subtopology euclidean Z,subtopology euclidean Y) f g"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      ASM SET_TAC []])

  let HOMOTOPIC_WITH_SUBSET_RIGHT ← prove
   r"!P X Y Z (f:real^M->real^N) g.
        homotopic_with P
         (subtopology euclidean X,subtopology euclidean Y) f g /\
        Y SUBSET Z
        ==> homotopic_with P
             (subtopology euclidean X,subtopology euclidean Z) f g"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN
    ASM_MESON_TAC [SUBSET_TRANS])

  let HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT ← prove
   r"!p f:real^N->real^P g h:real^M->real^N W X Y.
      homotopic_with (\f. p(f o h))
       (subtopology euclidean X,subtopology euclidean Y) f g /\
      h continuous_on W /\ IMAGE h W SUBSET X
      ==> homotopic_with p
           (subtopology euclidean W,subtopology euclidean Y) (f o h) (g o h)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2])

  let HOMOTOPIC_COMPOSE_CONTINUOUS_RIGHT ← prove
   r"!f:real^N->real^P g h:real^M->real^N W X Y.
        homotopic_with (\f. T)
         (subtopology euclidean X,subtopology euclidean Y) f g /\
        h continuous_on W /\ IMAGE h W SUBSET X
        ==> homotopic_with (\f. T)
            (subtopology euclidean W,subtopology euclidean Y) (f o h) (g o h)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
    EXISTS_TAC (← q r"X:real^N->bool") THEN ASM_REWRITE_TAC [])

  let HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT ← prove
   r"!p f:real^M->real^N g h:real^N->real^P X Y Z.
      homotopic_with (\f. p(h o f))
       (subtopology euclidean X,subtopology euclidean Y) f g /\
      h continuous_on Y /\ IMAGE h Y SUBSET Z
      ==> homotopic_with p
           (subtopology euclidean X,subtopology euclidean Z) (h o f) (h o g)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2])

  let HOMOTOPIC_COMPOSE_CONTINUOUS_LEFT ← prove
   r"!f:real^M->real^N g h:real^N->real^P X Y Z.
        homotopic_with (\f. T)
         (subtopology euclidean X,subtopology euclidean Y) f g /\
        h continuous_on Y /\ IMAGE h Y SUBSET Z
        ==> homotopic_with (\f. T)
             (subtopology euclidean X,subtopology euclidean Z)
             (h o f) (h o g)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"Y:real^N->bool") THEN ASM_REWRITE_TAC [])

  return { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_RESTRICT,
           HOMOTOPIC_WITH_IMP_CONTINUOUS, HOMOTOPIC_WITH_IMP_SUBSET, HOMOTOPIC_WITH_MONO,
           HOMOTOPIC_WITH_SUBSET_LEFT, HOMOTOPIC_WITH_SUBSET_RIGHT,
           HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT, HOMOTOPIC_COMPOSE_CONTINUOUS_RIGHT,
           HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_LEFT }

/- ------------------------------------------------------------------------- -/
/- Products, composition, homotopic triviality, clopen unions.               -/
/- (paths.ml 16644-16923)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVF where
  HOMOTOPIC_WITH_PCROSS : thm
  HOMOTOPIC_WITH_COMPOSE : thm
  HOMOTOPIC_COMPOSE : thm
  HOMOTOPIC_TRIVIALITY : thm
  HOMOTOPIC_ON_CLOPEN_UNIONS : thm
  INESSENTIAL_ON_CLOPEN_UNIONS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVF [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BVE : PVE) :
    ExceptT String IO PVF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, EMPTY_SUBSET, EMPTY_UNIONS, FINITE_IMAGE, FORALL_AND_THM, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_IN_UNIONS, FORALL_PASTECART,
        FSTCART_PASTECART, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, INTER_ACI,
        IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        MONO_FORALL, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, PASTECART_IN_PCROSS, PCROSS_EMPTY,
        .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SKOLEM_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_DIFF, SUBSET_EMPTY, SUBSET_PCROSS, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, SWAP_FORALL_THM, UNIONS_0, UNIONS_GSPEC, UNIONS_IMAGE, num_WOP, o_DEF,
        .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { OPEN_IN_PCROSS, OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { FINITE_NUMSEG_LT, INTER_PCROSS, .. } := D.pses1
  let { WLOG_LT, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { COUNTABLE_AS_IMAGE, .. } := D.pcard
  let { CLOSED_IN_UNIONS, HOMOTOPIC_CONSTANT_MAPS, HOMOTOPIC_ON_EMPTY,
        HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.pmet1
  let { HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS, PASTING_LEMMA_EXISTS,
        SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN, .. } := D.ptop2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { LINDELOF_OPEN_IN, .. } := D.ptop4
  let { PATH_COMPONENT_OF_EUCLIDEAN, PATH_CONNECTED_IFF_PATH_COMPONENT, .. } := BK
  let { PATH_CONNECTED_EMPTY, .. } := BL
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, HOMOTOPIC_WITH_MONO, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT,
        HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, .. } := BVE
  -- @@SCOPE END

  let HOMOTOPIC_WITH_PCROSS ← prove
   r"!f:real^M->real^N f':real^P->real^Q g g' p p' q s s' t t'.
     homotopic_with p
       (subtopology euclidean s,subtopology euclidean t) f g /\
     homotopic_with p'
       (subtopology euclidean s',subtopology euclidean t') f' g' /\
     (!f g. p f /\ p' g ==> q(\x. pastecart (f(fstcart x)) (g(sndcart x))))
     ==> homotopic_with q
          (subtopology euclidean (s PCROSS s'),
           subtopology euclidean (t PCROSS t'))
          (\z. pastecart (f(fstcart z)) (f'(sndcart z)))
          (\z. pastecart (g(fstcart z)) (g'(sndcart z)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"k:real^(1,M)finite_sum->real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"k':real^(1,P)finite_sum->real^Q") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC
     (← q r"\z:real^(1,(M,P)finite_sum)finite_sum.
          pastecart (k(pastecart (fstcart z) (fstcart(sndcart z))):real^N)
                    (k'(pastecart (fstcart z) (sndcart(sndcart z))):real^Q)") THEN
    ASM_REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS]) THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS,
                 IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN CONJ_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    (CONJ_TAC THENL
      [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
       SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
       GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
       MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
       SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
       REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS,
                   IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
       ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART,
                    PASTECART_IN_PCROSS]]))

  /- Homotopy with P is an equivalence relation (on continuous functions
     mapping X into Y that satisfy P, though this only affects reflexivity). -/

  let HOMOTOPIC_WITH_COMPOSE ← prove
   r"!P Q R f f':real^M->real^N g g':real^N->real^P s t u.
           (!f g. f continuous_on s /\ IMAGE f s SUBSET t /\ P f /\
                  g continuous_on t /\ IMAGE g t SUBSET u /\ Q g
                  ==> R(g o f)) /\
           homotopic_with P
            (subtopology euclidean s,subtopology euclidean t) f f' /\
           homotopic_with Q
            (subtopology euclidean t,subtopology euclidean u) g g'
           ==> homotopic_with R
                (subtopology euclidean s,subtopology euclidean u)
                (g o f) (g' o f')"
   (REPEAT STRIP_TAC THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_TRANS THEN
    EXISTS_TAC (← q r"(g:real^N->real^P) o (f':real^M->real^N)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT,
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT] THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    (CONJ_TAC THENL
      [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← ONCE_REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_MONO)) THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
       ASM_SIMP_TAC [],
       ASM_MESON_TAC [HOMOTOPIC_WITH_IMP_CONTINUOUS,
                     HOMOTOPIC_WITH_IMP_SUBSET]]))

  let HOMOTOPIC_COMPOSE ← prove
   r"!f f':real^M->real^N g g':real^N->real^P s t u.
        homotopic_with (\x. T)
          (subtopology euclidean s,subtopology euclidean t) f f' /\
        homotopic_with (\x. T)
          (subtopology euclidean t,subtopology euclidean u) g g'
        ==> homotopic_with (\x. T)
             (subtopology euclidean s,subtopology euclidean u)
             (g o f) (g' o f')"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_COMPOSE) THEN
    REWRITE_TAC [])

  /- Two characterizations of homotopic triviality, one of which
     implicitly incorporates path-connectedness. -/

  let HOMOTOPIC_TRIVIALITY ← prove
   r"!s:real^M->bool t:real^N->bool.
        (!f g. f continuous_on s /\ IMAGE f s SUBSET t /\
               g continuous_on s /\ IMAGE g s SUBSET t
               ==> homotopic_with (\x. T)
                    (subtopology euclidean s,subtopology euclidean t) f g) <=>
        (s = {} \/ path_connected t) /\
        (!f. f continuous_on s /\ IMAGE f s SUBSET t
             ==> ?c. homotopic_with (\x. T)
                      (subtopology euclidean s,subtopology euclidean t)
                      f (\x. c))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [ASM_SIMP_TAC [CONTINUOUS_ON_EMPTY, HOMOTOPIC_WITH_EUCLIDEAN_ALT,
                   NOT_IN_EMPTY, PCROSS_EMPTY, IMAGE_CLAUSES, EMPTY_SUBSET],
      ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY, PATH_CONNECTED_EMPTY]] THEN
    EQ_TAC THEN REPEAT STRIP_TAC THENL
     [REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN] THEN
      MP_TAC (← ISPECL
       [← q r"subtopology euclidean (s:real^M->bool)",
        ← q r"subtopology euclidean (t:real^N->bool)"]
       HOMOTOPIC_CONSTANT_MAPS) THEN
      ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_ON_CONST] THEN
      ASM SET_TAC [],
      SUBGOAL_THEN (← q r"?c:real^N. c IN t") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_ON_CONST],
      FIRST_X_ASSUM (fun th => tactic_of do pure (
        MP_TAC (← ISPEC (← q r"g:real^M->real^N") th) THEN
        MP_TAC (← ISPEC (← q r"f:real^M->real^N") th))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"d:real^N") THEN DISCH_TAC THEN
      TRANS_TAC HOMOTOPIC_WITH_TRANS (← q r"(\x. c):real^M->real^N") THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN
      TRANS_TAC HOMOTOPIC_WITH_TRANS (← q r"(\x. d):real^M->real^N") THEN
      ASM_REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS, PATH_COMPONENT_OF_EUCLIDEAN,
                      TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o
        REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET)) THEN
      ASM SET_TAC []])

  /- Homotopy on a union of closed-open sets. -/

  let HOMOTOPIC_ON_CLOPEN_UNIONS ← prove
   r"!f:real^M->real^N g t u.
        (!s. s IN u
             ==> closed_in (subtopology euclidean (UNIONS u)) s /\
                 open_in (subtopology euclidean (UNIONS u)) s /\
                 homotopic_with (\x. T)
                  (subtopology euclidean s,subtopology euclidean t) f g)
        ==> homotopic_with (\x. T)
             (subtopology euclidean (UNIONS u),subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?v. v SUBSET u /\ COUNTABLE v /\ UNIONS v :real^M->bool = UNIONS u")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC LINDELOF_OPEN_IN THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM (SUBST_ALL_TAC o SYM)] THEN
    ASM_CASES_TAC (← q r"v:(real^M->bool)->bool = {}") THEN
    ASM_SIMP_TAC [HOMOTOPIC_ON_EMPTY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                 UNIONS_0] THEN
    MP_TAC (← ISPEC (← q r"v:(real^M->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:num->real^M->bool") THEN DISCH_THEN SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"(f:num->real^M->bool) n")) THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONO_FORALL) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [FORALL_AND_THM]] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    SIMP_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, HOMOTOPIC_WITH_EUCLIDEAN_ALT] THEN
    X_GEN_TAC (← q r"h:num->real^(1,M)finite_sum->real^N") THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology euclidean
         ((interval[vec 0,vec 1] PCROSS UNIONS(IMAGE f (:num)))
          :real^(1,M)finite_sum->bool)",
      ← q r"euclidean:(real^N)topology",
      ← q r"h:num->real^(1,M)finite_sum->real^N",
      ← q r"(\n. interval[vec 0,vec 1] PCROSS (f n DIFF UNIONS {f m | m < n}))
       :num->real^(1,M)finite_sum->bool",
      ← q r"(:num)"] PASTING_LEMMA_EXISTS) THEN
    REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"open_in a b /\ c <=> ~(open_in a b ==> ~c)")] THEN
    SIMP_TAC [← ISPEC (← q r"euclidean") OPEN_IN_IMP_SUBSET,
             ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
    REWRITE_TAC [NOT_IMP] THEN
    REWRITE_TAC [IN_UNIV, FORALL_AND_THM, SUBSET_UNIV, INTER_PCROSS] THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_GSPEC, SUBSET, IN_ELIM_THM, FORALL_PASTECART] THEN
        REWRITE_TAC [PASTECART_IN_PCROSS, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                    FORALL_IN_UNIONS, FORALL_IN_IMAGE, IN_UNIV, IMP_CONJ] THEN
        X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"y:real^M") THEN
        REWRITE_TAC [LEFT_FORALL_IMP_THM, IN_DIFF, IN_ELIM_THM] THEN
        GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN MESON_TAC [],
        X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC OPEN_IN_PCROSS THEN
        REWRITE_TAC [OPEN_IN_REFL] THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_IN_UNIONS THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        SIMP_TAC [FINITE_NUMSEG_LT, FINITE_IMAGE] THEN ASM SET_TAC [],
        X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (fun th => tactic_of do pure (
          MATCH_MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET)
          (← SPEC (← q r"n:num") th)))) THEN
        REWRITE_TAC [SUBSET_PCROSS, SUBSET_REFL, SUBSET_DIFF],
        MATCH_MP_TAC WLOG_LT THEN REWRITE_TAC [] THEN CONJ_TAC THENL
         [REWRITE_TAC [INTER_ACI] THEN MESON_TAC [],
          REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS] THEN SET_TAC []]],
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"g:real^(1,M)finite_sum->real^N") THEN
      REWRITE_TAC [INTER_ACI, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [FORALL_IN_UNIONS, FORALL_IN_IMAGE, IMP_CONJ, SUBSET,
                  RIGHT_FORALL_IMP_THM, IN_UNIV, FORALL_IN_PCROSS] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC, CONJ_TAC] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN X_GEN_TAC (← q r"y:real^M") THEN
      REWRITE_TAC [LEFT_FORALL_IMP_THM] THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t:real^1", ← q r"y:real^M", ← q r"n:num"]),
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 0:real^1", ← q r"y:real^M", ← q r"n:num"]),
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 1:real^1", ← q r"y:real^M", ← q r"n:num"])] THEN
      ASM_REWRITE_TAC [IN_INTER, UNIONS_IMAGE, IN_UNIV, IN_DIFF,
                      UNIONS_GSPEC, IN_ELIM_THM, ENDS_IN_UNIT_INTERVAL] THEN
      (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC]) THEN
      REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [SUBSET]) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN ASM SET_TAC []])

  let INESSENTIAL_ON_CLOPEN_UNIONS ← prove
   r"!f:real^M->real^N t u.
        path_connected t /\
        (!s. s IN u
             ==> closed_in (subtopology euclidean (UNIONS u)) s /\
                 open_in (subtopology euclidean (UNIONS u)) s /\
                 ?a. homotopic_with (\x. T)
                      (subtopology euclidean s,subtopology euclidean t) f (\x. a))
        ==> ?a. homotopic_with (\x. T)
                 (subtopology euclidean (UNIONS u),subtopology euclidean t)
                 f (\x. a)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"UNIONS u:real^M->bool = {}") THEN
    ASM_SIMP_TAC [UNIONS_0, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                 HOMOTOPIC_ON_EMPTY] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [EMPTY_UNIONS]) THEN
    REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
    X_GEN_TAC (← q r"c:real^M->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"c:real^M->bool")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE (\x. a) s SUBSET t ==> ~(s = {}) ==> a IN t"))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN EXISTS_TAC (← q r"a:real^N") THEN
    MATCH_MP_TAC HOMOTOPIC_ON_CLOPEN_UNIONS THEN
    X_GEN_TAC (← q r"s:real^M->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^M->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [HOMOTOPIC_ON_EMPTY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_TRANS) THEN
    REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS, PATH_COMPONENT_OF_EUCLIDEAN] THEN
    DISJ2_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE (\x. a) s SUBSET t ==> ~(s = {}) ==> a IN t"))) THEN
    ASM_MESON_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT])

  return { HOMOTOPIC_WITH_PCROSS, HOMOTOPIC_WITH_COMPOSE, HOMOTOPIC_COMPOSE,
           HOMOTOPIC_TRIVIALITY, HOMOTOPIC_ON_CLOPEN_UNIONS, INESSENTIAL_ON_CLOPEN_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Homotopy within the space of linear maps.  (paths.ml 16924-17093)         -/
/- ------------------------------------------------------------------------- -/

structure PVG where
  HOMOTOPIC_WITH_REFLECTIONS_ALONG : thm
  HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVG [HolBase] (D : PathsDeps) (BVE : PVE) (BVF : PVF) : ExceptT String IO PVG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        .. } := D.cvx
  let { AND_FORALL_THM, CONJ_ASSOC, DIMINDEX_GE_1, EQ_IMP, ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_SING, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_REFL, PASTECART_IN_PCROSS, .. } :=
    D.cvx.core3
  let { REAL_LT_01, .. } := D.cvx.core4
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { BASIS_NONZERO, BETWEEN_IMP_COLLINEAR, COLLINEAR_LEMMA_ALT, DOT_EQ_0, .. } := D.cvx.vec1
  let { DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_SUB, MATRIX_COMPOSE, NORM_BASIS, .. } :=
    D.cvx.vec2
  let { NORM_LIFT, .. } := D.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        .. } := D.cvx.vec4
  let { DET_I, DET_MATRIX_REFLECT_ALONG, DET_MUL, DET_ORTHOGONAL_MATRIX, LINEAR_REFLECT_ALONG,
        ORTHOGONAL_MATRIX_MATRIX, ORTHOGONAL_TRANSFORMATION_COMPOSE,
        ORTHOGONAL_TRANSFORMATION_ID, ORTHOGONAL_TRANSFORMATION_LINEAR,
        ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG, REFLECT_ALONG_INVOLUTION, .. } := D.cvx.det
  let { BETWEEN_IN_SEGMENT, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT, .. } := D.cvx.top3
  let { IN_SEGMENT, IN_SPHERE_0, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { FORALL_IN_CROSS, I_DEF, LAMBDA_PAIR, .. } := D.pses1
  let { ENDS_IN_UNIT_INTERVAL, MATRIX_I, matrix, .. } := D.pvec
  let { NORM_REFLECT_ALONG, ORTHOGONAL_TRANSFORMATION_I, ORTHOGONAL_TRANSFORMATION_REFLECT_INDUCT,
        REFLECT_ALONG_SCALE, reflect_along, .. } := D.pdet
  let { IN_REAL_INTERVAL, .. } := D.pmisc
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND,
        CONTINUOUS_MAP_PROD, CONTINUOUS_MAP_REAL_DIV, CONTINUOUS_MAP_REAL_LMUL,
        HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.pmet1
  let { HOMOTOPIC_WITH_REFL, HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS,
        TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY, homotopic_with, .. } :=
    D.pmet2
  let { CONTINUOUS_DISCRETE_RANGE_CONSTANT, CONTINUOUS_MAP_DOT, CONTINUOUS_MAP_DROP_EQ,
        CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN, CONTINUOUS_MAP_VECTOR_MUL,
        CONTINUOUS_MAP_VECTOR_SUB, .. } := D.ptop2
  let { CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE, CONTINUOUS_ON_LIFT_DET, CONTINUOUS_ON_PASTECART,
        CONTINUOUS_ON_VMUL, .. } := D.ptop3
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { HOMOTOPIC_WITH_COMPOSE, .. } := BVF
  -- @@SCOPE END

  let HOMOTOPIC_WITH_REFLECTIONS_ALONG ← prove
   r"!P s t a b:real^N.
        ~(a = vec 0) /\ ~(b = vec 0) /\
        (!c. c IN segment[a,b]
             ==> P(reflect_along c) /\ IMAGE (reflect_along c) s SUBSET t)
        ==> homotopic_with P (subtopology euclidean s,subtopology euclidean t)
                             (reflect_along a) (reflect_along b)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"vec 0 IN segment[a:real^N,b]") THENL
     [SUBGOAL_THEN (← q r"reflect_along (b:real^N) = reflect_along a") SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM BETWEEN_IN_SEGMENT]) THEN
        DISCH_THEN (MP_TAC o MATCH_MP BETWEEN_IMP_COLLINEAR) THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,z,b} = {z,a,b}")] THEN
        ASM_REWRITE_TAC [COLLINEAR_LEMMA_ALT] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:real") SUBST_ALL_TAC) THEN
        REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
        MATCH_MP_TAC REFLECT_ALONG_SCALE THEN
        ASM_MESON_TAC [VECTOR_MUL_EQ_0],
        ASM_SIMP_TAC [HOMOTOPIC_WITH_REFL, ENDS_IN_SEGMENT, LINEAR_CONTINUOUS_ON,
                     CONTINUOUS_MAP_EUCLIDEAN2, LINEAR_REFLECT_ALONG]],
      ALL_TAC] THEN
    REWRITE_TAC [homotopic_with] THEN
    EXISTS_TAC
     (← q r"(\(c,x). reflect_along (c:real^N) x) o
      (\(t,x). (&1 - t) % a + t % b,x)") THEN
    REWRITE_TAC [o_THM] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID] THEN
    REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID, ETA_AX] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_CROSS, o_THM] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IMP_CONJ] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology
                   (subtopology euclidean ((:real^N) DIFF {vec 0}))
                   (euclidean:(real^N)topology)") THEN
      REWRITE_TAC [CONTINUOUS_MAP_PROD] THEN CONJ_TAC THENL
       [DISJ2_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
        SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE,
                    TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
          REWRITE_TAC [CONTINUOUS_MAP_DROP_EQ, o_DEF, ← GSYM DROP_VEC] THEN
          REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN_EUCLIDEAN, ← GSYM DROP_SUB] THEN
          MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
          MATCH_MP_TAC CONTINUOUS_ON_VMUL THEN REWRITE_TAC [o_DEF, LIFT_DROP] THEN
          SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [IN_SEGMENT]) THEN
          REWRITE_TAC [IN_REAL_INTERVAL] THEN SET_TAC []],
        REWRITE_TAC [reflect_along, LAMBDA_PAIR] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_VECTOR_SUB THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
        REWRITE_TAC [CONTINUOUS_MAP_OF_SND, CONTINUOUS_MAP_ID] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_VECTOR_MUL THEN
        GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
        REWRITE_TAC [CONTINUOUS_MAP_OF_FST] THEN
        SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_LMUL THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_DIV THEN
        REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, FORALL_IN_CROSS] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, DOT_EQ_0] THEN
        SIMP_TAC [IN_DIFF, IN_SING] THEN
        CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_DOT THEN CONJ_TAC THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
        REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND] THEN
        SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY]],
      REWRITE_TAC [AND_FORALL_THM, RIGHT_FORALL_IMP_THM, IN_REAL_INTERVAL, ← TAUT
                   (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
      X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 - t) % a + t % b:real^N")) THEN
      REWRITE_TAC [IN_SEGMENT, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      ASM SET_TAC []])

  let HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS ← prove
   r"!f g:real^N->real^N.
        homotopic_with orthogonal_transformation
         (subtopology euclidean (sphere(vec 0,&1)),
          subtopology euclidean (sphere(vec 0,&1)))
         f g <=>
        orthogonal_transformation f /\ orthogonal_transformation g /\
        det(matrix f) = det(matrix g)"
   (← do
    let lemma ← prove
     r"!f:real^N->real^N.
          orthogonal_transformation f
          ==> homotopic_with orthogonal_transformation
               (subtopology euclidean (sphere(vec 0,&1)),
                subtopology euclidean (sphere(vec 0,&1)))
               f
               (if det(matrix f) = &1 then I else reflect_along(basis 1))"
     (MATCH_MP_TAC ORTHOGONAL_TRANSFORMATION_REFLECT_INDUCT THEN CONJ_TAC THENL
       [REWRITE_TAC [MATRIX_I, DET_I, HOMOTOPIC_WITH_REFL] THEN
        REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_I, CONTINUOUS_MAP_EUCLIDEAN2] THEN
        REWRITE_TAC [I_DEF, CONTINUOUS_ON_ID, IMAGE_ID, SUBSET_REFL],
        MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"a:real^N"] THEN STRIP_TAC THEN
        MP_TAC (← ISPECL
         [← q r"orthogonal_transformation:(real^N->real^N)->bool",
          ← q r"orthogonal_transformation:(real^N->real^N)->bool",
          ← q r"orthogonal_transformation:(real^N->real^N)->bool",
          ← q r"f:real^N->real^N",
          ← q r"if det(matrix f:real^N^N) = &1 then I
          else reflect_along (basis 1:real^N)",
          ← q r"reflect_along(a:real^N)", ← q r"reflect_along(basis 1:real^N)",
          ← q r"sphere(vec 0:real^N,&1)",
          ← q r"sphere(vec 0:real^N,&1)", ← q r"sphere(vec 0:real^N,&1)"]
            HOMOTOPIC_WITH_COMPOSE) THEN
        ASM_SIMP_TAC [ORTHOGONAL_TRANSFORMATION_COMPOSE] THEN ANTS_TAC THENL
         [MATCH_MP_TAC HOMOTOPIC_WITH_REFLECTIONS_ALONG THEN
          ASM_SIMP_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1] THEN
          REWRITE_TAC [ORTHOGONAL_TRANSFORMATION_REFLECT_ALONG, SUBSET] THEN
