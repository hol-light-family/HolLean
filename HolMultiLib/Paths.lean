/- ------------------------------------------------------------------------- -/
/- Paths and arcs; relate to topological general case; invariance theorems.  -/
/- (paths.ml 10-248)                                                          -/
/- ------------------------------------------------------------------------- -/

structure PTA where
  path : thm
  pathstart : thm
  pathfinish : thm
  path_image : thm
  reversepath : thm
  joinpaths : thm
  simple_path : thm
  arc : thm
  PATH_IN_EUCLIDEAN : thm
  PATH_EUCLIDEAN : thm
  PATH_PATH_IN : thm
  PATH_EQ : thm
  PATH_CONTINUOUS_IMAGE : thm
  PATH_TRANSLATION_EQ : thm
  PATH_LINEAR_IMAGE_EQ : thm
  PATHSTART_TRANSLATION : thm
  PATHSTART_LINEAR_IMAGE_EQ : thm
  PATHFINISH_TRANSLATION : thm
  PATHFINISH_LINEAR_IMAGE : thm
  PATH_IMAGE_TRANSLATION : thm
  PATH_IMAGE_LINEAR_IMAGE : thm
  REVERSEPATH_TRANSLATION : thm
  REVERSEPATH_LINEAR_IMAGE : thm
  JOINPATHS_TRANSLATION : thm
  JOINPATHS_LINEAR_IMAGE : thm
  SIMPLE_PATH_TRANSLATION_EQ : thm
  SIMPLE_PATH_LINEAR_IMAGE_EQ : thm
  ARC_TRANSLATION_EQ : thm
  ARC_LINEAR_IMAGE_EQ : thm
  SIMPLE_PATH_CONTINUOUS_IMAGE : thm
  ARC_CONTINUOUS_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPTA [HolBase] (D : PathsDeps) : ExceptT String IO PTA := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC,
        add_linear_invariants, add_translation_invariants, .. } := D.cvx
  let { ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ_ALT, INJECTIVE_ON_ALT, .. } := D.cvx.core2
  let { SUBSET, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_ASSOC, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_VEC, LIFT_DROP, LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.cvx.vec2
  let { SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_ID, .. } := D.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { I_O_ID, .. } := D.pses1
  let { IMAGE_LIFT_DROP, .. } := D.pvec
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := D.pmet1
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, path_in, .. } := D.pmet2
  let { CONTINUOUS_MAP_DROP, CONTINUOUS_MAP_EUCLIDEAN, CONTINUOUS_MAP_LIFT, .. } := D.ptop2
  let { INTERVAL_REAL_INTERVAL, .. } := D.ptop4
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Paths and arcs.                                                         -/
  /- ----------------------------------------------------------------------- -/

  let path ← new_definition
   r"!g:real^1->real^N. path g <=> g continuous_on interval[vec 0,vec 1]"

  let pathstart ← new_definition
   r"pathstart (g:real^1->real^N) = g(vec 0)"

  let pathfinish ← new_definition
   r"pathfinish (g:real^1->real^N) = g(vec 1)"

  let path_image ← new_definition
   r"path_image (g:real^1->real^N) = IMAGE g (interval[vec 0,vec 1])"

  let reversepath ← new_definition
   r"reversepath (g:real^1->real^N) = \x. g(vec 1 - x)"

  let joinpaths ← new_definition
   r"(g1 ++ g2) = \x. if drop x <= &1 / &2 then g1(&2 % x)
                   else g2(&2 % x - vec 1)"

  let simple_path ← new_definition
   r"simple_path (g:real^1->real^N) <=>
        path g /\
        !x y. x IN interval[vec 0,vec 1] /\
              y IN interval[vec 0,vec 1] /\
              g x = g y
              ==> x = y \/ x = vec 0 /\ y = vec 1 \/ x = vec 1 /\ y = vec 0"

  let arc ← new_definition
   r"arc (g:real^1->real^N) <=>
        path g /\
        !x y. x IN interval [vec 0,vec 1] /\
              y IN interval [vec 0,vec 1] /\
              g x = g y
              ==> x = y"

  /- ----------------------------------------------------------------------- -/
  /- Relate to topological general case.                                     -/
  /- ----------------------------------------------------------------------- -/

  let PATH_IN_EUCLIDEAN ← prove
   r"!s:real^N->bool g.
        path_in (subtopology euclidean s) g <=>
        path (g o drop) /\ path_image (g o drop) SUBSET s"
   (REWRITE_TAC [path_in, path, ← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [path_image, INTERVAL_REAL_INTERVAL, DROP_VEC] THEN
    REWRITE_TAC [← GSYM IMAGE_o, ← GSYM o_ASSOC] THEN
    ONCE_REWRITE_TAC [IMAGE_o] THEN
    REWRITE_TAC [IMAGE_LIFT_DROP, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      SUBGOAL_THEN (← q r"g:real->real^N = (g o drop) o lift") SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, LIFT_DROP], ALL_TAC]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      CONTINUOUS_MAP_COMPOSE)) THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
             CONTINUOUS_MAP_LIFT, CONTINUOUS_MAP_DROP] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL,
                TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_DEF, LIFT_DROP])

  let PATH_EUCLIDEAN ← prove
   r"!s g:real^1->real^N.
        path g /\ path_image g SUBSET s <=>
        path_in (subtopology euclidean s) (g o lift)"
   (REWRITE_TAC [PATH_IN_EUCLIDEAN] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX])

  let PATH_PATH_IN ← prove
   r"!g:real^1->real^N. path g <=> path_in euclidean (g o lift)"
   (GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [← GSYM PATH_EUCLIDEAN, SUBSET_UNIV])

  /- ----------------------------------------------------------------------- -/
  /- Invariance theorems.                                                    -/
  /- ----------------------------------------------------------------------- -/

  let PATH_EQ ← prove
   r"!p q. (!t. t IN interval[vec 0,vec 1] ==> p t = q t) /\ path p
         ==> path q"
   (REWRITE_TAC [path, CONTINUOUS_ON_EQ])

  let PATH_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N g.
     path g /\ f continuous_on path_image g ==> path(f o g)"
   (REWRITE_TAC [path, path_image, CONTINUOUS_ON_COMPOSE])

  let PATH_TRANSLATION_EQ ← prove
   r"!a g:real^1->real^N. path((\x. a + x) o g) <=> path g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"(g:real^1->real^N) = (\x. --a + x) o (\x. a + x) o g")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN VECTOR_ARITH_TAC, ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST])

  add_translation_invariants [PATH_TRANSLATION_EQ]

  let PATH_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N g.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (path(f o g) <=> path g)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"h:real^N->real^M") STRIP_ASSUME_TAC o
          MATCH_MP LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    REWRITE_TAC [path] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"g:real^1->real^M = h o (f:real^M->real^N) o g")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [o_ASSOC, I_O_ID], ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON])

  add_linear_invariants [PATH_LINEAR_IMAGE_EQ]

  let PATHSTART_TRANSLATION ← prove
   r"!a g. pathstart((\x. a + x) o g) = a + pathstart g"
   (REWRITE_TAC [pathstart, o_THM])

  add_translation_invariants [PATHSTART_TRANSLATION]

  let PATHSTART_LINEAR_IMAGE_EQ ← prove
   r"!f g. linear f ==> pathstart(f o g) = f(pathstart g)"
   (REWRITE_TAC [pathstart, o_THM])

  add_linear_invariants [PATHSTART_LINEAR_IMAGE_EQ]

  let PATHFINISH_TRANSLATION ← prove
   r"!a g. pathfinish((\x. a + x) o g) = a + pathfinish g"
   (REWRITE_TAC [pathfinish, o_THM])

  add_translation_invariants [PATHFINISH_TRANSLATION]

  let PATHFINISH_LINEAR_IMAGE ← prove
   r"!f g. linear f ==> pathfinish(f o g) = f(pathfinish g)"
   (REWRITE_TAC [pathfinish, o_THM])

  add_linear_invariants [PATHFINISH_LINEAR_IMAGE]

  let PATH_IMAGE_TRANSLATION ← prove
   r"!a g. path_image((\x. a + x) o g) = IMAGE (\x. a + x) (path_image g)"
   (REWRITE_TAC [path_image, IMAGE_o])

  add_translation_invariants [PATH_IMAGE_TRANSLATION]

  let PATH_IMAGE_LINEAR_IMAGE ← prove
   r"!f g. linear f ==> path_image(f o g) = IMAGE f (path_image g)"
   (REWRITE_TAC [path_image, IMAGE_o])

  add_linear_invariants [PATH_IMAGE_LINEAR_IMAGE]

  let REVERSEPATH_TRANSLATION ← prove
   r"!a g. reversepath((\x. a + x) o g) = (\x. a + x) o reversepath g"
   (REWRITE_TAC [FUN_EQ_THM, reversepath, o_THM])

  add_translation_invariants [REVERSEPATH_TRANSLATION]

  let REVERSEPATH_LINEAR_IMAGE ← prove
   r"!f g. linear f ==> reversepath(f o g) = f o reversepath g"
   (REWRITE_TAC [FUN_EQ_THM, reversepath, o_THM])

  add_linear_invariants [REVERSEPATH_LINEAR_IMAGE]

  let JOINPATHS_TRANSLATION ← prove
   r"!a:real^N g1 g2. ((\x. a + x) o g1) ++ ((\x. a + x) o g2) =
                    (\x. a + x) o (g1 ++ g2)"
   (REWRITE_TAC [joinpaths, FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [o_THM])

  add_translation_invariants [JOINPATHS_TRANSLATION]

  let JOINPATHS_LINEAR_IMAGE ← prove
   r"!f g1 g2. linear f ==> (f o g1) ++ (f o g2) = f o (g1 ++ g2)"
   (REWRITE_TAC [joinpaths, FUN_EQ_THM] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [o_THM])

  add_linear_invariants [JOINPATHS_LINEAR_IMAGE]

  let SIMPLE_PATH_TRANSLATION_EQ ← prove
   r"!a g:real^1->real^N. simple_path((\x. a + x) o g) <=> simple_path g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [simple_path, PATH_TRANSLATION_EQ] THEN
    REWRITE_TAC [o_THM, ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")])

  add_translation_invariants [SIMPLE_PATH_TRANSLATION_EQ]

  let SIMPLE_PATH_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N g.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (simple_path(f o g) <=> simple_path g)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [simple_path, PATH_TRANSLATION_EQ] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [PATH_LINEAR_IMAGE_EQ], ALL_TAC] THEN
    REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [])

  add_linear_invariants [SIMPLE_PATH_LINEAR_IMAGE_EQ]

  let ARC_TRANSLATION_EQ ← prove
   r"!a g:real^1->real^N. arc((\x. a + x) o g) <=> arc g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [arc, PATH_TRANSLATION_EQ] THEN
    REWRITE_TAC [o_THM, ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")])

  add_translation_invariants [ARC_TRANSLATION_EQ]

  let ARC_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N g.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (arc(f o g) <=> arc g)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [arc, PATH_TRANSLATION_EQ] THEN
    BINOP_TAC THENL [ASM_MESON_TAC [PATH_LINEAR_IMAGE_EQ], ALL_TAC] THEN
    REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [])

  add_linear_invariants [ARC_LINEAR_IMAGE_EQ]

  let SIMPLE_PATH_CONTINUOUS_IMAGE ← prove
   r"!f g. simple_path g /\
         f continuous_on path_image g /\
         (!x y.
              x IN path_image g /\ y IN path_image g /\ f x = f y ==> x = y)
         ==> simple_path(f o g)"
   (REWRITE_TAC [simple_path, INJECTIVE_ON_ALT] THEN
    SIMP_TAC [PATH_CONTINUOUS_IMAGE] THEN
    REWRITE_TAC [path_image, o_THM] THEN SET_TAC [])

  let ARC_CONTINUOUS_IMAGE ← prove
   r"!f g:real^1->real^N.
        arc g /\
        f continuous_on path_image g /\
        (!x y. x IN path_image g /\ y IN path_image g /\ f x = f y ==> x = y)
        ==> arc(f o g)"
   (REWRITE_TAC [arc, INJECTIVE_ON_ALT] THEN SIMP_TAC [PATH_CONTINUOUS_IMAGE] THEN
    REWRITE_TAC [path_image, o_THM] THEN SET_TAC [])

  return { path, pathstart, pathfinish, path_image, reversepath, joinpaths, simple_path, arc,
           PATH_IN_EUCLIDEAN, PATH_EUCLIDEAN, PATH_PATH_IN, PATH_EQ, PATH_CONTINUOUS_IMAGE,
           PATH_TRANSLATION_EQ, PATH_LINEAR_IMAGE_EQ, PATHSTART_TRANSLATION,
           PATHSTART_LINEAR_IMAGE_EQ, PATHFINISH_TRANSLATION, PATHFINISH_LINEAR_IMAGE,
           PATH_IMAGE_TRANSLATION, PATH_IMAGE_LINEAR_IMAGE, REVERSEPATH_TRANSLATION,
           REVERSEPATH_LINEAR_IMAGE, JOINPATHS_TRANSLATION, JOINPATHS_LINEAR_IMAGE,
           SIMPLE_PATH_TRANSLATION_EQ, SIMPLE_PATH_LINEAR_IMAGE_EQ, ARC_TRANSLATION_EQ,
           ARC_LINEAR_IMAGE_EQ, SIMPLE_PATH_CONTINUOUS_IMAGE, ARC_CONTINUOUS_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Basic lemmas about paths.  (paths.ml 249-421)                             -/
/- ------------------------------------------------------------------------- -/

structure PTB where
  ARC_IMP_SIMPLE_PATH : thm
  ARC_IMP_PATH : thm
  SIMPLE_PATH_IMP_PATH : thm
  SIMPLE_PATH_CASES : thm
  SIMPLE_PATH_IMP_ARC : thm
  ARC_DISTINCT_ENDS : thm
  ARC_SIMPLE_PATH : thm
  SIMPLE_PATH_EQ_ARC : thm
  PATH_IMAGE_NONEMPTY : thm
  PATHSTART_IN_PATH_IMAGE : thm
  PATHFINISH_IN_PATH_IMAGE : thm
  CONNECTED_PATH_IMAGE : thm
  COMPACT_PATH_IMAGE : thm
  BOUNDED_PATH_IMAGE : thm
  CLOSED_PATH_IMAGE : thm
  CONNECTED_SIMPLE_PATH_IMAGE : thm
  COMPACT_SIMPLE_PATH_IMAGE : thm
  BOUNDED_SIMPLE_PATH_IMAGE : thm
  CLOSED_SIMPLE_PATH_IMAGE : thm
  CONNECTED_ARC_IMAGE : thm
  COMPACT_ARC_IMAGE : thm
  BOUNDED_ARC_IMAGE : thm
  CLOSED_ARC_IMAGE : thm
  PATHSTART_COMPOSE : thm
  PATHFINISH_COMPOSE : thm
  PATH_IMAGE_COMPOSE : thm
  PATH_COMPOSE_JOIN : thm
  PATH_COMPOSE_REVERSEPATH : thm
  JOIN_PATHS_EQ : thm
  CARD_EQ_SIMPLE_PATH_IMAGE : thm
  INFINITE_SIMPLE_PATH_IMAGE : thm
  CARD_EQ_ARC_IMAGE : thm
  INFINITE_ARC_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPTB [HolBase] (D : PathsDeps) (BA : PTA) : ExceptT String IO PTB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE,
        REAL_RAT_REDUCE_CONV, .. } := D.cvx
  let { ARITH, CONJ_ASSOC, DIMINDEX_1, .. } := D.cvx.core1
  let { FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, .. } := D.cvx.core2
  let { LE_ANTISYM, .. } := D.cvx.core3
  let { REAL_OF_NUM_LT, REAL_POS, .. } := D.cvx.core5
  let { UNWIND_THM1, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.cvx.vec2
  let { VEC_COMPONENT, .. } := D.cvx.vec4
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_INTERVAL,
        CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { IN_INTERVAL_1, .. } := D.cvx.top4
  let { INFINITE, .. } := D.pses1
  let { INTERVAL_EQ_EMPTY, .. } := D.pvec
  let { CARD_COUNTABLE_CONG, FINITE_IMP_COUNTABLE, UNCOUNTABLE_REAL, .. } := D.pcard
  let { CONNECTED_CARD_EQ_IFF_NONTRIVIAL, .. } := D.ptop2
  let { CONVEX_CONNECTED, .. } := D.pcvx1
  let { CONVEX_INTERVAL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, reversepath, joinpaths, simple_path, arc,
        .. } := BA
  -- @@SCOPE END

  let ARC_IMP_SIMPLE_PATH ← prove
   r"!g. arc g ==> simple_path g"
   (REWRITE_TAC [arc, simple_path] THEN MESON_TAC [])

  let ARC_IMP_PATH ← prove
   r"!g. arc g ==> path g"
   (REWRITE_TAC [arc] THEN MESON_TAC [])

  let SIMPLE_PATH_IMP_PATH ← prove
   r"!g. simple_path g ==> path g"
   (REWRITE_TAC [simple_path] THEN MESON_TAC [])

  let SIMPLE_PATH_CASES ← prove
   r"!g:real^1->real^N. simple_path g ==> arc g \/ pathfinish g = pathstart g"
   (REWRITE_TAC [simple_path, arc, pathfinish, pathstart] THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(g:real^1->real^N) (vec 0) = g(vec 1)") THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^1", ← q r"v:real^1"]) THEN
    ASM_MESON_TAC [])

  let SIMPLE_PATH_IMP_ARC ← prove
   r"!g:real^1->real^N.
        simple_path g /\ ~(pathfinish g = pathstart g) ==> arc g"
   (MESON_TAC [SIMPLE_PATH_CASES])

  let ARC_DISTINCT_ENDS ← prove
   r"!g:real^1->real^N. arc g ==> ~(pathfinish g = pathstart g)"
   (GEN_TAC THEN REWRITE_TAC [arc, pathfinish, pathstart] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b /\ ~d ==> ~c")] THEN
    DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [← GSYM DROP_EQ, IN_INTERVAL_1, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let ARC_SIMPLE_PATH ← prove
   r"!g:real^1->real^N.
        arc g <=> simple_path g /\ ~(pathfinish g = pathstart g)"
   (MESON_TAC [SIMPLE_PATH_CASES, ARC_IMP_SIMPLE_PATH, ARC_DISTINCT_ENDS])

  let SIMPLE_PATH_EQ_ARC ← prove
   r"!g. ~(pathstart g = pathfinish g) ==> (simple_path g <=> arc g)"
   (SIMP_TAC [ARC_SIMPLE_PATH])

  let PATH_IMAGE_NONEMPTY ← prove
   r"!g. ~(path_image g = {})"
   (REWRITE_TAC [path_image, IMAGE_EQ_EMPTY, INTERVAL_EQ_EMPTY] THEN
    SIMP_TAC [DIMINDEX_1, CONJ_ASSOC, LE_ANTISYM, UNWIND_THM1, VEC_COMPONENT,
             ARITH, REAL_OF_NUM_LT])

  let PATHSTART_IN_PATH_IMAGE ← prove
   r"!g. (pathstart g) IN path_image g"
   (GEN_TAC THEN REWRITE_TAC [pathstart, path_image] THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS])

  let PATHFINISH_IN_PATH_IMAGE ← prove
   r"!g. (pathfinish g) IN path_image g"
   (GEN_TAC THEN REWRITE_TAC [pathfinish, path_image] THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN REAL_ARITH_TAC)

  let CONNECTED_PATH_IMAGE ← prove
   r"!g. path g ==> connected(path_image g)"
   (REWRITE_TAC [path, path_image] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [CONVEX_CONNECTED, CONVEX_INTERVAL])

  let COMPACT_PATH_IMAGE ← prove
   r"!g. path g ==> compact(path_image g)"
   (REWRITE_TAC [path, path_image] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
    ASM_REWRITE_TAC [COMPACT_INTERVAL])

  let BOUNDED_PATH_IMAGE ← prove
   r"!g. path g ==> bounded(path_image g)"
   (MESON_TAC [COMPACT_PATH_IMAGE, COMPACT_IMP_BOUNDED])

  let CLOSED_PATH_IMAGE ← prove
   r"!g. path g ==> closed(path_image g)"
   (MESON_TAC [COMPACT_PATH_IMAGE, COMPACT_IMP_CLOSED])

  let CONNECTED_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> connected(path_image g)"
   (MESON_TAC [CONNECTED_PATH_IMAGE, SIMPLE_PATH_IMP_PATH])

  let COMPACT_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> compact(path_image g)"
   (MESON_TAC [COMPACT_PATH_IMAGE, SIMPLE_PATH_IMP_PATH])

  let BOUNDED_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> bounded(path_image g)"
   (MESON_TAC [BOUNDED_PATH_IMAGE, SIMPLE_PATH_IMP_PATH])

  let CLOSED_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> closed(path_image g)"
   (MESON_TAC [CLOSED_PATH_IMAGE, SIMPLE_PATH_IMP_PATH])

  let CONNECTED_ARC_IMAGE ← prove
   r"!g. arc g ==> connected(path_image g)"
   (MESON_TAC [CONNECTED_PATH_IMAGE, ARC_IMP_PATH])

  let COMPACT_ARC_IMAGE ← prove
   r"!g. arc g ==> compact(path_image g)"
   (MESON_TAC [COMPACT_PATH_IMAGE, ARC_IMP_PATH])

  let BOUNDED_ARC_IMAGE ← prove
   r"!g. arc g ==> bounded(path_image g)"
   (MESON_TAC [BOUNDED_PATH_IMAGE, ARC_IMP_PATH])

  let CLOSED_ARC_IMAGE ← prove
   r"!g. arc g ==> closed(path_image g)"
   (MESON_TAC [CLOSED_PATH_IMAGE, ARC_IMP_PATH])

  let PATHSTART_COMPOSE ← prove
   r"!f p. pathstart(f o p) = f(pathstart p)"
   (REWRITE_TAC [pathstart, o_THM])

  let PATHFINISH_COMPOSE ← prove
   r"!f p. pathfinish(f o p) = f(pathfinish p)"
   (REWRITE_TAC [pathfinish, o_THM])

  let PATH_IMAGE_COMPOSE ← prove
   r"!f p. path_image (f o p) = IMAGE f (path_image p)"
   (REWRITE_TAC [path_image, IMAGE_o])

  let PATH_COMPOSE_JOIN ← prove
   r"!f p q. f o (p ++ q) = (f o p) ++ (f o q)"
   (REWRITE_TAC [joinpaths, o_DEF, FUN_EQ_THM] THEN MESON_TAC [])

  let PATH_COMPOSE_REVERSEPATH ← prove
   r"!f p. f o reversepath p = reversepath(f o p)"
   (REWRITE_TAC [reversepath, o_DEF, FUN_EQ_THM] THEN MESON_TAC [])

  let JOIN_PATHS_EQ ← prove
   r"!p q:real^1->real^N.
   (!t. t IN interval[vec 0,vec 1] ==> p t = p' t) /\
   (!t. t IN interval[vec 0,vec 1] ==> q t = q' t)
   ==> !t. t IN interval[vec 0,vec 1] ==> (p ++ q) t = (p' ++ q') t"
   (REWRITE_TAC [joinpaths, IN_INTERVAL_1, DROP_VEC] THEN REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
    ASM_REAL_ARITH_TAC)

  let CARD_EQ_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> path_image g =_c (:real)"
   (SIMP_TAC [CONNECTED_CARD_EQ_IFF_NONTRIVIAL, CONNECTED_SIMPLE_PATH_IMAGE] THEN
    GEN_TAC THEN REWRITE_TAC [simple_path, path_image] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(?u v. u IN s /\ v IN s /\ ~(u = a) /\ ~(v = a) /\ ~(u = v))
      ==> P /\ (!x y. x IN s /\ y IN s /\ f x = f y
                      ==> x = y \/ x = a /\ y = b \/ x = b /\ y = a)
          ==> ~(?c. IMAGE f s SUBSET {c})")) THEN
    MAP_EVERY EXISTS_TAC [← q r"lift(&1 / &3)", ← q r"lift(&1 / &2)"] THEN
    REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM, LIFT_EQ] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let INFINITE_SIMPLE_PATH_IMAGE ← prove
   r"!g. simple_path g ==> INFINITE(path_image g)"
   (MESON_TAC [CARD_EQ_SIMPLE_PATH_IMAGE, INFINITE, FINITE_IMP_COUNTABLE,
              UNCOUNTABLE_REAL, CARD_COUNTABLE_CONG])

  let CARD_EQ_ARC_IMAGE ← prove
   r"!g. arc g ==> path_image g =_c (:real)"
   (MESON_TAC [ARC_IMP_SIMPLE_PATH, CARD_EQ_SIMPLE_PATH_IMAGE])

  let INFINITE_ARC_IMAGE ← prove
   r"!g. arc g ==> INFINITE(path_image g)"
   (MESON_TAC [ARC_IMP_SIMPLE_PATH, INFINITE_SIMPLE_PATH_IMAGE])

  return { ARC_IMP_SIMPLE_PATH, ARC_IMP_PATH, SIMPLE_PATH_IMP_PATH, SIMPLE_PATH_CASES,
           SIMPLE_PATH_IMP_ARC, ARC_DISTINCT_ENDS, ARC_SIMPLE_PATH, SIMPLE_PATH_EQ_ARC,
           PATH_IMAGE_NONEMPTY, PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE,
           CONNECTED_PATH_IMAGE, COMPACT_PATH_IMAGE, BOUNDED_PATH_IMAGE, CLOSED_PATH_IMAGE,
           CONNECTED_SIMPLE_PATH_IMAGE, COMPACT_SIMPLE_PATH_IMAGE, BOUNDED_SIMPLE_PATH_IMAGE,
           CLOSED_SIMPLE_PATH_IMAGE, CONNECTED_ARC_IMAGE, COMPACT_ARC_IMAGE,
           BOUNDED_ARC_IMAGE, CLOSED_ARC_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
           PATH_IMAGE_COMPOSE, PATH_COMPOSE_JOIN, PATH_COMPOSE_REVERSEPATH, JOIN_PATHS_EQ,
           CARD_EQ_SIMPLE_PATH_IMAGE, INFINITE_SIMPLE_PATH_IMAGE, CARD_EQ_ARC_IMAGE,
           INFINITE_ARC_IMAGE }

/- ------------------------------------------------------------------------- -/
/- The operations on paths.  (paths.ml 422-812)                              -/
/- ------------------------------------------------------------------------- -/

structure PTC where
  JOINPATHS : thm
  REVERSEPATH_REVERSEPATH : thm
  PATHSTART_REVERSEPATH : thm
  PATHFINISH_REVERSEPATH : thm
  PATHSTART_JOIN : thm
  PATHFINISH_JOIN : thm
  PATH_IMAGE_REVERSEPATH : thm
  PATH_REVERSEPATH : thm
  PATH_JOIN : thm
  PATH_JOIN_IMP : thm
  PATH_IMAGE_JOIN_SUBSET : thm
  SUBSET_PATH_IMAGE_JOIN : thm
  PATH_IMAGE_JOIN : thm
  NOT_IN_PATH_IMAGE_JOIN : thm
  ARC_REVERSEPATH : thm
  ARC_REVERSEPATH_EQ : thm
  SIMPLE_PATH_REVERSEPATH : thm
  SIMPLE_PATH_REVERSEPATH_EQ : thm
  SIMPLE_PATH_JOIN_LOOP : thm
  ARC_JOIN : thm
  REVERSEPATH_JOINPATHS : thm
  deriving Inhabited

@[nospecialize]
def setupPTC [HolBase] (D : PathsDeps) (BA : PTA) : ExceptT String IO PTC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.cvx
  let { CONJ_ASSOC, EQ_TRANS, ETA_AX, EXTENSION, FORALL_AND_THM, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.cvx.core2
  let { IN_IMAGE, IN_INSERT, IN_INTER, IN_UNION, MONO_FORALL, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_REFL, .. } := D.cvx.core4
  let { REAL_POS, SUBSET, SUBSET_ANTISYM, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, LIFT_SUB, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_RZERO,
        VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, .. } := D.cvx.top4
  let { DROP_WLOG_LE, .. } := D.pvec
  let { CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_UNION, .. } := D.ptop3
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.ptop4
  let { path, pathstart, pathfinish, path_image, reversepath, joinpaths, simple_path, arc,
        .. } := BA
  -- @@SCOPE END

  let JOINPATHS ← prove
   r"!g1 g2. pathfinish g1 = pathstart g2
           ==> g1 ++ g2 = \x. if drop x < &1 / &2 then g1(&2 % x)
                              else g2 (&2 % x - vec 1)"
   (REWRITE_TAC [pathstart, pathfinish] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [joinpaths, FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"x:real^1") THEN ASM_CASES_TAC (← q r"drop x = &1 / &2") THENL
     [FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"lift")) THEN
      REWRITE_TAC [LIFT_DROP] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL, ← GSYM LIFT_CMUL, REAL_LT_REFL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [LIFT_NUM, VECTOR_SUB_REFL],
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN ASM_REAL_ARITH_TAC])

  let REVERSEPATH_REVERSEPATH ← prove
   r"!g:real^1->real^N. reversepath(reversepath g) = g"
   (REWRITE_TAC [reversepath, ETA_AX,
                ← VECTOR_ARITH (← q r"vec 1 - (vec 1 - x):real^1 = x")])

  let PATHSTART_REVERSEPATH ← prove
   r"pathstart(reversepath g) = pathfinish g"
   (REWRITE_TAC [pathstart, reversepath, pathfinish, VECTOR_SUB_RZERO])

  let PATHFINISH_REVERSEPATH ← prove
   r"pathfinish(reversepath g) = pathstart g"
   (REWRITE_TAC [pathstart, reversepath, pathfinish, VECTOR_SUB_REFL])

  let PATHSTART_JOIN ← prove
   r"!g1 g2. pathstart(g1 ++ g2) = pathstart g1"
   (REWRITE_TAC [joinpaths, pathstart, pathstart, DROP_VEC, VECTOR_MUL_RZERO] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let PATHFINISH_JOIN ← prove
   r"!g1 g2. pathfinish(g1 ++ g2) = pathfinish g2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [joinpaths, pathfinish, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN AP_TERM_TAC THEN VECTOR_ARITH_TAC)

  let PATH_IMAGE_REVERSEPATH ← prove
   r"!g:real^1->real^N. path_image(reversepath g) = path_image g"
   (SUBGOAL_THEN (← q r"!g:real^1->real^N.
        path_image(reversepath g) SUBSET path_image g")
     (fun th => MESON_TAC [th, REVERSEPATH_REVERSEPATH, SUBSET_ANTISYM]) THEN
    REWRITE_TAC [SUBSET, path_image, FORALL_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^N", ← q r"x:real^1"] THEN
    DISCH_TAC THEN REWRITE_TAC [reversepath, IN_IMAGE] THEN
    EXISTS_TAC (← q r"vec 1 - x:real^1") THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC)

  let PATH_REVERSEPATH ← prove
   r"!g:real^1->real^N. path(reversepath g) <=> path g"
   (SUBGOAL_THEN (← q r"!g:real^1->real^N. path g ==> path(reversepath g)")
     (fun th => MESON_TAC [th, REVERSEPATH_REVERSEPATH]) THEN
    GEN_TAC THEN REWRITE_TAC [path, reversepath] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
    REWRITE_TAC [DROP_VEC, DROP_SUB] THEN REAL_ARITH_TAC)

  let PATH_JOIN ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g1 = pathstart g2
        ==> (path(g1 ++ g2) <=> path g1 /\ path g2)"
   (REWRITE_TAC [path, pathfinish, pathstart] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THENL
     [STRIP_TAC THEN CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"(g1:real^1->real^N) = (\x. g1 (&2 % x)) o (\x. &1 / &2 % x)")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN GEN_TAC THEN AP_TERM_TAC THEN
          VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID] THEN
        MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
        EXISTS_TAC (← q r"(g1 ++ g2):real^1->real^N") THEN CONJ_TAC THENL
         [REWRITE_TAC [FORALL_IN_IMAGE, joinpaths, IN_INTERVAL_1, DROP_CMUL] THEN
          SIMP_TAC [DROP_VEC, ← REAL_ARITH (← q r"&1 / &2 * x <= &1 / &2 <=> x <= &1")],
          ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_CMUL] THEN
        REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC,
        SUBGOAL_THEN
         (← q r"(g2:real^1->real^N) =
          (\x. g2 (&2 % x - vec 1)) o (\x. &1 / &2 % (x + vec 1))")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN GEN_TAC THEN AP_TERM_TAC THEN
          VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST,
                 CONTINUOUS_ON_ADD] THEN
        MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
        EXISTS_TAC (← q r"(g1 ++ g2):real^1->real^N") THEN CONJ_TAC THENL
         [REWRITE_TAC [FORALL_IN_IMAGE, joinpaths, IN_INTERVAL_1, DROP_CMUL] THEN
          REWRITE_TAC [DROP_VEC, DROP_ADD, ← REAL_ARITH
           (← q r"&1 / &2 * (x + &1) <= &1 / &2 <=> x <= &0")] THEN
          SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> (x:real <= &0 <=> x = &0)"), LIFT_NUM,
            VECTOR_MUL_ASSOC, ← GSYM LIFT_EQ, LIFT_DROP, ← GSYM LIFT_CMUL] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN
          ASM_REWRITE_TAC [VECTOR_ADD_LID, VECTOR_MUL_LID] THEN
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"(x + vec 1):real^N - vec 1 = x")],
          ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_CMUL] THEN
        REWRITE_TAC [DROP_VEC, DROP_ADD] THEN REAL_ARITH_TAC],
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"interval[vec 0,vec 1] =
                    interval[vec 0,lift(&1 / &2)] UNION
                    interval[lift(&1 / &2),vec 1]")
      SUBST1_TAC THENL
       [SIMP_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_UNION THEN REWRITE_TAC [CLOSED_INTERVAL] THEN
      CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THENL
       [EXISTS_TAC (← q r"\x. (g1:real^1->real^N) (&2 % x)"),
        EXISTS_TAC (← q r"\x. (g2:real^1->real^N) (&2 % x - vec 1)")] THEN
      REWRITE_TAC [joinpaths] THEN SIMP_TAC [IN_INTERVAL_1, LIFT_DROP] THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID] THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % (x:real^1) = &2 % x + vec 0")] THEN
        REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
        REWRITE_TAC [REAL_POS, INTERVAL_EQ_EMPTY_1, LIFT_DROP, DROP_VEC] THEN
        REWRITE_TAC [← GSYM LIFT_CMUL, VECTOR_ADD_RID, VECTOR_MUL_RZERO] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [LIFT_NUM],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [SIMP_TAC [← REAL_ARITH (← q r"&1 / &2 <= x ==> (x <= &1 / &2 <=> x = &1 / &2)"),
                 ← GSYM LIFT_EQ, LIFT_DROP, ← GSYM LIFT_CMUL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        ASM_REWRITE_TAC [LIFT_NUM] THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [← GSYM LIFT_CMUL] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [LIFT_NUM, VECTOR_SUB_REFL],
        ALL_TAC] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
               CONTINUOUS_ON_ID] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"&2 % x:real^N - vec 1 = &2 % x + --vec 1")] THEN
      REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      REWRITE_TAC [REAL_POS, INTERVAL_EQ_EMPTY_1, LIFT_DROP, DROP_VEC] THEN
      REWRITE_TAC [← GSYM LIFT_CMUL, VECTOR_ADD_RID, VECTOR_MUL_RZERO] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [LIFT_NUM] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH
       (← q r"&2 % x + --x:real^N = x /\ x + --x = vec 0")]])

  let PATH_JOIN_IMP ← prove
   r"!g1 g2:real^1->real^N.
        path g1 /\ path g2 /\ pathfinish g1 = pathstart g2
        ==> path(g1 ++ g2)"
   (MESON_TAC [PATH_JOIN])

  let PATH_IMAGE_JOIN_SUBSET ← prove
   r"!g1 g2:real^1->real^N.
        path_image(g1 ++ g2) SUBSET (path_image g1 UNION path_image g2)"
   (REWRITE_TAC [path_image, FORALL_IN_IMAGE, SUBSET] THEN
    GEN_TAC THEN GEN_TAC THEN X_GEN_TAC (← q r"x:real^1") THEN
    REWRITE_TAC [IN_INTERVAL_1, IN_UNION, IN_IMAGE, DROP_VEC, joinpaths] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"drop x <= &1 / &2") THEN ASM_REWRITE_TAC [] THENL
     [DISJ1_TAC THEN EXISTS_TAC (← q r"&2 % x:real^1") THEN REWRITE_TAC [DROP_CMUL],
      DISJ2_TAC THEN EXISTS_TAC (← q r"&2 % x - vec 1:real^1") THEN
      REWRITE_TAC [DROP_CMUL, DROP_SUB, DROP_VEC]] THEN
    ASM_REAL_ARITH_TAC)

  let SUBSET_PATH_IMAGE_JOIN ← prove
   r"!g1 g2:real^1->real^N s.
        path_image g1 SUBSET s /\ path_image g2 SUBSET s
        ==> path_image(g1 ++ g2) SUBSET s"
   (MP_TAC PATH_IMAGE_JOIN_SUBSET THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    SET_TAC [])

  let PATH_IMAGE_JOIN ← prove
   r"!g1 g2. pathfinish g1 = pathstart g2
           ==> path_image(g1 ++ g2) = path_image g1 UNION path_image g2"
   (REWRITE_TAC [pathfinish, pathstart] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [PATH_IMAGE_JOIN_SUBSET] THEN
    REWRITE_TAC [path_image, SUBSET, FORALL_AND_THM, IN_UNION, ← TAUT
                  (← q r"a \/ b ==> c <=> (a ==> c) /\ (b ==> c)")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, joinpaths] THEN
    REWRITE_TAC [IN_INTERVAL_1, IN_IMAGE, DROP_VEC] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:real^1") THEN REPEAT STRIP_TAC THENL
     [EXISTS_TAC (← q r"(&1 / &2) % x:real^1") THEN
      ASM_REWRITE_TAC [DROP_CMUL, ← REAL_ARITH
       (← q r"&1 / &2 * x <= &1 / &2 <=> x <= &1")] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LID],
      EXISTS_TAC (← q r"(&1 / &2) % (x + vec 1):real^1") THEN
      ASM_REWRITE_TAC [DROP_CMUL, DROP_ADD, DROP_VEC] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [VECTOR_MUL_LID, ← VECTOR_ARITH (← q r"(x + vec 1) - vec 1 = x")] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> (&1 / &2 * (x + &1) <= &1 / &2 <=>
                                            x = &0)")] THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP, LIFT_NUM] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_ADD_LID, DROP_VEC]] THEN
    ASM_REAL_ARITH_TAC)

  let NOT_IN_PATH_IMAGE_JOIN ← prove
   r"!g1 g2 x. ~(x IN path_image g1) /\ ~(x IN path_image g2)
             ==> ~(x IN path_image(g1 ++ g2))"
   (MESON_TAC [PATH_IMAGE_JOIN_SUBSET, SUBSET, IN_UNION])

  let ARC_REVERSEPATH ← prove
   r"!g. arc g ==> arc(reversepath g)"
   (GEN_TAC THEN SIMP_TAC [arc, PATH_REVERSEPATH] THEN
    REWRITE_TAC [arc, reversepath] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 1 - x:real^1", ← q r"vec 1 - y:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ, DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let ARC_REVERSEPATH_EQ ← prove
   r"!g:real^1->real^N. arc(reversepath g) <=> arc g"
   (MESON_TAC [ARC_REVERSEPATH, REVERSEPATH_REVERSEPATH])

  let SIMPLE_PATH_REVERSEPATH ← prove
   r"!g. simple_path g ==> simple_path (reversepath g)"
   (GEN_TAC THEN SIMP_TAC [simple_path, PATH_REVERSEPATH] THEN
    REWRITE_TAC [simple_path, reversepath] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 1 - x:real^1", ← q r"vec 1 - y:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ, DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let SIMPLE_PATH_REVERSEPATH_EQ ← prove
   r"!g:real^1->real^N. simple_path(reversepath g) <=> simple_path g"
   (MESON_TAC [SIMPLE_PATH_REVERSEPATH, REVERSEPATH_REVERSEPATH])

  let SIMPLE_PATH_JOIN_LOOP ← prove
   r"!g1 g2:real^1->real^N.
        arc g1 /\ arc g2 /\
        pathfinish g1 = pathstart g2 /\
        pathfinish g2 = pathstart g1 /\
        (path_image g1 INTER path_image g2) SUBSET
            {pathstart g1,pathstart g2}
        ==> simple_path(g1 ++ g2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [arc, simple_path] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(a /\ b /\ c /\ d ==> f) /\
      (a' /\ b' /\ c /\ d /\ e ==> g)
      ==> (a /\ a') /\ (b /\ b') /\ c /\ d /\ e ==> f /\ g")) THEN
    CONJ_TAC THENL [MESON_TAC [PATH_JOIN], ALL_TAC] THEN
    REWRITE_TAC [arc, simple_path, SUBSET, IN_INTER, pathstart,
      pathfinish, IN_INTERVAL_1, DROP_VEC, IN_INSERT, NOT_IN_EMPTY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "G1") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "G2") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "G0")) THEN
    MATCH_MP_TAC DROP_WLOG_LE THEN CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [joinpaths] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"drop x <= &1 / &2", ← q r"drop y <= &1 / &2"] THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THENL
     [REMOVE_THEN "G1" (MP_TAC o SPECL [← q r"&2 % x:real^1", ← q r"&2 % y:real^1"]) THEN
      ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, DROP_SUB] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (fun th => DISJ1_TAC THEN MP_TAC th) THEN VECTOR_ARITH_TAC,
      ALL_TAC,
      ASM_REAL_ARITH_TAC,
      REMOVE_THEN "G2" (MP_TAC o SPECL
       [← q r"&2 % x:real^1 - vec 1", ← q r"&2 % y:real^1 - vec 1"]) THEN
      ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, DROP_SUB] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (fun th => DISJ1_TAC THEN MP_TAC th) THEN VECTOR_ARITH_TAC] THEN
    REMOVE_THEN "G0" (MP_TAC o SPEC (← q r"(g1:real^1->real^N) (&2 % x)")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [path_image, IN_IMAGE] THEN EXISTS_TAC (← q r"&2 % x:real^1") THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL] THEN
        ASM_REAL_ARITH_TAC,
        ASM_REWRITE_TAC [path_image, IN_IMAGE] THEN
        EXISTS_TAC (← q r"&2 % y:real^1 - vec 1") THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    STRIP_TAC THENL
     [DISJ2_TAC THEN DISJ1_TAC,
      DISJ1_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"&1 / &2 % vec 1:real^1")] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"&2 % x:real^1 = vec 0") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G1" MATCH_MP_TAC,
      DISCH_THEN SUBST_ALL_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [VECTOR_MUL_RZERO]) THEN
      UNDISCH_TAC (← q r"T") THEN REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"&2 % y:real^1 - vec 1 = vec 1") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G2" MATCH_MP_TAC,
      SUBGOAL_THEN (← q r"&2 % x:real^1 = vec 1") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G1" MATCH_MP_TAC,
      DISCH_THEN SUBST_ALL_TAC THEN
      SUBGOAL_THEN (← q r"&2 % y:real^1 - vec 1 = vec 0") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G2" MATCH_MP_TAC] THEN
    (REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
      [ALL_TAC, ASM_MESON_TAC []] THEN
     ASM_REWRITE_TAC [DROP_CMUL, DROP_SUB, DROP_VEC] THEN
     ASM_REAL_ARITH_TAC))

  let ARC_JOIN ← prove
   r"!g1 g2:real^1->real^N.
        arc g1 /\ arc g2 /\
        pathfinish g1 = pathstart g2 /\
        (path_image g1 INTER path_image g2) SUBSET {pathstart g2}
        ==> arc(g1 ++ g2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [arc, simple_path] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(a /\ b /\ c /\ d ==> f) /\
      (a' /\ b' /\ c /\ d ==> g)
      ==> (a /\ a') /\ (b /\ b') /\ c /\ d ==> f /\ g")) THEN
    CONJ_TAC THENL [MESON_TAC [PATH_JOIN], ALL_TAC] THEN
    REWRITE_TAC [arc, simple_path, SUBSET, IN_INTER, pathstart,
      pathfinish, IN_INTERVAL_1, DROP_VEC, IN_INSERT, NOT_IN_EMPTY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "G1") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "G2") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "G0")) THEN
    MATCH_MP_TAC DROP_WLOG_LE THEN CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [joinpaths] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"drop x <= &1 / &2", ← q r"drop y <= &1 / &2"] THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THENL
     [REMOVE_THEN "G1" (MP_TAC o SPECL [← q r"&2 % x:real^1", ← q r"&2 % y:real^1"]) THEN
      ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, DROP_SUB] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC,
      ASM_REAL_ARITH_TAC,
      REMOVE_THEN "G2" (MP_TAC o SPECL
       [← q r"&2 % x:real^1 - vec 1", ← q r"&2 % y:real^1 - vec 1"]) THEN
      ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, DROP_SUB] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      VECTOR_ARITH_TAC] THEN
    REMOVE_THEN "G0" (MP_TAC o SPEC (← q r"(g1:real^1->real^N) (&2 % x)")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [path_image, IN_IMAGE] THEN EXISTS_TAC (← q r"&2 % x:real^1") THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL] THEN
        ASM_REAL_ARITH_TAC,
        ASM_REWRITE_TAC [path_image, IN_IMAGE] THEN
        EXISTS_TAC (← q r"&2 % y:real^1 - vec 1") THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"x:real^1 = &1 / &2 % vec 1") SUBST_ALL_TAC THENL
     [SUBGOAL_THEN (← q r"&2 % x:real^1 = vec 1") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G1" MATCH_MP_TAC,
      SUBGOAL_THEN (← q r"&2 % y:real^1 - vec 1 = vec 0") MP_TAC THENL
       [ALL_TAC, VECTOR_ARITH_TAC] THEN
      REMOVE_THEN "G2" MATCH_MP_TAC] THEN
    (REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
      [ALL_TAC, ASM_MESON_TAC []] THEN
     ASM_REWRITE_TAC [DROP_CMUL, DROP_SUB, DROP_VEC] THEN
     ASM_REAL_ARITH_TAC))

  let REVERSEPATH_JOINPATHS ← prove
   r"!g1 g2. pathfinish g1 = pathstart g2
           ==> reversepath(g1 ++ g2) = reversepath g2 ++ reversepath g1"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [reversepath, joinpaths, pathfinish, pathstart, FUN_EQ_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"t:real^1") THEN
    REWRITE_TAC [DROP_VEC, DROP_SUB, ← REAL_ARITH
     (← q r"&1 - x <= &1 / &2 <=> &1 / &2 <= x")] THEN
    ASM_CASES_TAC (← q r"t = lift(&1 / &2)") THENL
     [ASM_REWRITE_TAC [LIFT_DROP, REAL_LE_REFL, ← GSYM LIFT_NUM, ← GSYM LIFT_SUB,
                      ← GSYM LIFT_CMUL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [LIFT_NUM],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM DROP_EQ]) THEN
      REWRITE_TAC [LIFT_DROP] THEN DISCH_TAC THEN
      ASM_SIMP_TAC [← REAL_ARITH
       (← q r"~(x = &1 / &2) ==> (&1 / &2 <= x <=> ~(x <= &1 / &2))")] THEN
      ASM_CASES_TAC (← q r"drop t <= &1 / &2") THEN ASM_REWRITE_TAC [] THEN
      AP_TERM_TAC THEN REWRITE_TAC [VECTOR_SUB_LDISTRIB] THEN VECTOR_ARITH_TAC])

  return { JOINPATHS, REVERSEPATH_REVERSEPATH, PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
           PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH,
           PATH_JOIN, PATH_JOIN_IMP, PATH_IMAGE_JOIN_SUBSET, SUBSET_PATH_IMAGE_JOIN,
           PATH_IMAGE_JOIN, NOT_IN_PATH_IMAGE_JOIN, ARC_REVERSEPATH, ARC_REVERSEPATH_EQ,
           SIMPLE_PATH_REVERSEPATH, SIMPLE_PATH_REVERSEPATH_EQ, SIMPLE_PATH_JOIN_LOOP,
           ARC_JOIN, REVERSEPATH_JOINPATHS }

/- ------------------------------------------------------------------------- -/
/- Some reversed and "if and only if" versions of joining theorems;          -/
/- reassociating a joined path; in the case of a loop, symmetry.             -/
/- (paths.ml 813-1043)                                                       -/
/- ------------------------------------------------------------------------- -/

structure PTD where
  PATH_JOIN_PATH_ENDS : thm
  PATH_JOIN_EQ : thm
  SIMPLE_PATH_JOIN_IMP : thm
  SIMPLE_PATH_JOIN_LOOP_EQ : thm
  SIMPLE_PATH_JOIN_LOOP_EQ_ALT : thm
  ARC_JOIN_EQ : thm
  ARC_JOIN_EQ_ALT : thm
  PATH_ASSOC : thm
  SIMPLE_PATH_ASSOC : thm
  ARC_ASSOC : thm
  PATH_SYM : thm
  SIMPLE_PATH_SYM : thm
  PATH_IMAGE_SYM : thm
  deriving Inhabited

@[nospecialize]
def setupPTD [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) :
    ExceptT String IO PTD := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, NORM_ARITH_TAC, .. } := D.cvx
  let { CONJ_ACI, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, INSERT_AC, INTER_ACI, INTER_COMM, .. } := D.cvx.core2
  let { IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, REAL_ADD_LDISTRIB, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.cvx.core4
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_0, DIST_LIFT, .. } := D.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, .. } := D.cvx.vec2
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_RID, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_RZERO, drop, .. } := D.cvx.vec4
  let { IN_INTERVAL_1, .. } := D.cvx.top4
  let { continuous_on, .. } := D.cvx.top5
  let { UNION_ACI, UNION_OVER_INTER, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, NORM_REAL, VEC_EQ, .. } := D.pvec
  let { path, pathstart, pathfinish, path_image, joinpaths, simple_path, arc, .. } := BA
  let { SIMPLE_PATH_IMP_PATH, ARC_DISTINCT_ENDS, ARC_SIMPLE_PATH, SIMPLE_PATH_EQ_ARC,
        PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, .. } := BB
  let { JOINPATHS, PATHSTART_JOIN, PATHFINISH_JOIN, PATH_JOIN, PATH_JOIN_IMP, PATH_IMAGE_JOIN,
        SIMPLE_PATH_JOIN_LOOP, ARC_JOIN, .. } := BC
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Some reversed and "if and only if" versions of joining theorems.        -/
  /- ----------------------------------------------------------------------- -/

  let PATH_JOIN_PATH_ENDS ← prove
   r"!g1 g2:real^1->real^N.
        path g2 /\ path(g1 ++ g2) ==> pathfinish g1 = pathstart g2"
   (REPEAT GEN_TAC THEN DISJ_CASES_TAC (← NORM_ARITH
     (← q r"pathfinish g1:real^N = pathstart g2 \/
      &0 < dist(pathfinish g1,pathstart g2)")) THEN
    ASM_REWRITE_TAC [path, continuous_on, joinpaths] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    REWRITE_TAC [pathstart, pathfinish] THEN
    ABBREV_TAC (← q r"e = dist((g1:real^1->real^N)(vec 1),g2(vec 0:real^1))") THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"vec 0:real^1")) (MP_TAC o SPEC (← q r"lift(&1 / &2)"))) THEN
    REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, LIFT_DROP, REAL_LE_REFL] THEN
    REWRITE_TAC [← GSYM LIFT_CMUL, IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_NUM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1"))) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "2"))) THEN
    REMOVE_THEN "2" (MP_TAC o SPEC (← q r"lift(min (&1 / &2) (min d1 d2) / &2)")) THEN
    REWRITE_TAC [LIFT_DROP, DIST_LIFT, DIST_0, NORM_REAL, ← GSYM drop] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REMOVE_THEN "1" (MP_TAC o SPEC
     (← q r"lift(&1 / &2 + min (&1 / &2) (min d1 d2) / &4)")) THEN
    REWRITE_TAC [LIFT_DROP, DIST_LIFT] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    COND_CASES_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [← GSYM LIFT_CMUL, LIFT_ADD, REAL_ADD_LDISTRIB] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_NUM] THEN
    REWRITE_TAC [VECTOR_ADD_SUB, ← REAL_ARITH (← q r"&2 * x / &4 = x / &2")] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN NORM_ARITH_TAC)

  let PATH_JOIN_EQ ← prove
   r"!g1 g2:real^1->real^N.
        path g1 /\ path g2
        ==> (path(g1 ++ g2) <=> pathfinish g1 = pathstart g2)"
   (MESON_TAC [PATH_JOIN_PATH_ENDS, PATH_JOIN_IMP])

  let SIMPLE_PATH_JOIN_IMP ← prove
   r"!g1 g2:real^1->real^N.
        simple_path(g1 ++ g2) /\ pathfinish g1 = pathstart g2
        ==> arc g1 /\ arc g2 /\
            path_image g1 INTER path_image g2 SUBSET
            {pathstart g1, pathstart g2}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"path(g1:real^1->real^N) /\ path(g2:real^1->real^N)") THENL
     [ALL_TAC, ASM_MESON_TAC [PATH_JOIN, SIMPLE_PATH_IMP_PATH]] THEN
    REWRITE_TAC [simple_path, pathstart, pathfinish, arc] THEN
    STRIP_TAC THEN REPEAT CONJ_TAC THEN ASM_REWRITE_TAC [] THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"&1 / &2 % x:real^1", ← q r"&1 / &2 % y:real^1"]) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, joinpaths, DROP_CMUL] THEN
      REPEAT (COND_CASES_TAC THEN TRY ASM_REAL_ARITH_TAC) THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, VECTOR_MUL_LID, DROP_VEC] THEN
      ASM_REAL_ARITH_TAC,
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"&1 / &2 % (x + vec 1):real^1", ← q r"&1 / &2 % (y + vec 1):real^1"]) THEN
      ASM_SIMP_TAC [JOINPATHS, pathstart, pathfinish] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_ADD, DROP_CMUL] THEN
      REPEAT (COND_CASES_TAC THEN TRY ASM_REAL_ARITH_TAC) THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LID, ← VECTOR_ARITH (← q r"(a + b) - b:real^N = a")] THEN
      ASM_REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, VECTOR_MUL_LID, DROP_VEC,
                      DROP_ADD] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← SET_RULE
       (← q r"s INTER t SUBSET u <=> !x. x IN s ==> x IN t ==> x IN u")] THEN
      REWRITE_TAC [path_image, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"y:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      SUBST1_TAC (← SYM (← ASSUME
       (← q r"(g1:real^1->real^N)(vec 1) = g2(vec 0:real^1)"))) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"x = a \/ x = b ==> f x IN {f a,f b}")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"&1 / &2 % x:real^1", ← q r"&1 / &2 % (y + vec 1):real^1"]) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_ADD] THEN
        REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
        GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [joinpaths] THEN
        ASM_SIMP_TAC [JOINPATHS, pathstart, pathfinish] THEN
        REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_VEC] THEN
        REPEAT (COND_CASES_TAC THEN TRY ASM_REAL_ARITH_TAC) THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % &1 / &2 % x:real^N = x")] THEN
        ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"(a + b) - b:real^N = a")],
        REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_VEC] THEN
        ASM_REAL_ARITH_TAC]])

  let SIMPLE_PATH_JOIN_LOOP_EQ ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g2 = pathstart g1 /\
        pathfinish g1 = pathstart g2
        ==> (simple_path(g1 ++ g2) <=>
             arc g1 /\ arc g2 /\
             path_image g1 INTER path_image g2 SUBSET
             {pathstart g1, pathstart g2})"
   (MESON_TAC [SIMPLE_PATH_JOIN_IMP, SIMPLE_PATH_JOIN_LOOP])

  let SIMPLE_PATH_JOIN_LOOP_EQ_ALT ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g2 = pathstart g1 /\
        pathfinish g1 = pathstart g2
        ==> (simple_path(g1 ++ g2) <=>
             arc g1 /\ arc g2 /\
             path_image g1 INTER path_image g2 =
             {pathstart g1, pathstart g2})"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SIMPLE_PATH_JOIN_LOOP_EQ] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"a IN s /\ b IN s ==> (s SUBSET {a,b} <=> s = {a,b})")) THEN
    REWRITE_TAC [IN_INTER] THEN
    ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE])

  let ARC_JOIN_EQ ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g1 = pathstart g2
        ==> (arc(g1 ++ g2) <=>
             arc g1 /\ arc g2 /\
             path_image g1 INTER path_image g2 SUBSET {pathstart g2})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [ARC_JOIN] THEN
    GEN_REWRITE_TAC LAND_CONV [ARC_SIMPLE_PATH] THEN
    REWRITE_TAC [PATHFINISH_JOIN, PATHSTART_JOIN] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g1:real^1->real^N", ← q r"g2:real^1->real^N"]
          SIMPLE_PATH_JOIN_IMP) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"~((pathstart g1:real^N) IN path_image g2)")
     (fun th => MP_TAC th THEN ASM SET_TAC []) THEN
    REWRITE_TAC [path_image, IN_IMAGE, IN_INTERVAL_1, DROP_VEC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^1") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [simple_path]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"vec 0:real^1", ← q r"lift(&1 / &2) + inv(&2) % u"] o
      CONJUNCT2) THEN
    REWRITE_TAC [← GSYM DROP_EQ, IN_INTERVAL_1, DROP_ADD, DROP_VEC,
                DROP_CMUL, LIFT_DROP, joinpaths] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LT_IMP_NZ,
                 ← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 / &2 + &1 / &2 * x")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&1 / &2 + &1 / &2 * u = &1 <=> u = &1")] THEN
    ASM_SIMP_TAC [← REAL_ARITH
     (← q r"&0 <= u ==> (&1 / &2 + &1 / &2 * u <= &1 / &2 <=> u = &0)")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_RZERO] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"u <= &1 ==> &1 / &2 + &1 / &2 * u <= &1")] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP] THEN COND_CASES_TAC THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID, ← GSYM LIFT_CMUL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_NUM] THEN
      ASM_REWRITE_TAC [VEC_EQ] THEN ARITH_TAC,
      REWRITE_TAC [VECTOR_ADD_LDISTRIB, ← GSYM LIFT_CMUL] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [LIFT_NUM, VECTOR_MUL_LID, VECTOR_ADD_SUB] THEN
      ASM_MESON_TAC []])

  let ARC_JOIN_EQ_ALT ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g1 = pathstart g2
        ==> (arc(g1 ++ g2) <=>
             arc g1 /\ arc g2 /\
             path_image g1 INTER path_image g2 = {pathstart g2})"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [ARC_JOIN_EQ] THEN
    MP_TAC (← ISPEC (← q r"g1:real^1->real^N") PATHFINISH_IN_PATH_IMAGE) THEN
    MP_TAC (← ISPEC (← q r"g2:real^1->real^N") PATHSTART_IN_PATH_IMAGE) THEN
    ASM SET_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- Reassociating a joined path doesn't matter for various properties.      -/
  /- ----------------------------------------------------------------------- -/

  let PATH_ASSOC ← prove
   r"!p q r:real^1->real^N.
        pathfinish p = pathstart q /\ pathfinish q = pathstart r
        ==> (path(p ++ (q ++ r)) <=> path((p ++ q) ++ r))"
   (SIMP_TAC [PATH_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN] THEN CONV_TAC (fun t => TAUT t))

  let SIMPLE_PATH_ASSOC ← prove
   r"!p q r:real^1->real^N.
        pathfinish p = pathstart q /\ pathfinish q = pathstart r
        ==> (simple_path(p ++ (q ++ r)) <=> simple_path((p ++ q) ++ r))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"pathstart(p:real^1->real^N) = pathfinish r") THENL
     [ALL_TAC,
      ASM_SIMP_TAC [SIMPLE_PATH_EQ_ARC, PATHSTART_JOIN, PATHFINISH_JOIN]] THEN
    ASM_SIMP_TAC [SIMPLE_PATH_JOIN_LOOP_EQ, PATHSTART_JOIN, PATHFINISH_JOIN,
                 ARC_JOIN_EQ, PATH_IMAGE_JOIN] THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"arc(p:real^1->real^N)", ← q r"arc(q:real^1->real^N)",
      ← q r"arc(r:real^1->real^N)"] THEN
    ASM_REWRITE_TAC [UNION_OVER_INTER, UNION_SUBSET,
                    ← ONCE_REWRITE_RULE [INTER_COMM] UNION_OVER_INTER] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP ARC_DISTINCT_ENDS)) THEN
    MAP_EVERY (fun t => (MP_TAC o ISPEC t) PATHSTART_IN_PATH_IMAGE THEN
                        (MP_TAC o ISPEC t) PATHFINISH_IN_PATH_IMAGE)
     [← q r"p:real^1->real^N", ← q r"q:real^1->real^N", ← q r"r:real^1->real^N"] THEN
    ASM SET_TAC [])

  let ARC_ASSOC ← prove
   r"!p q r:real^1->real^N.
        pathfinish p = pathstart q /\ pathfinish q = pathstart r
        ==> (arc(p ++ (q ++ r)) <=> arc((p ++ q) ++ r))"
   (SIMP_TAC [ARC_SIMPLE_PATH, SIMPLE_PATH_ASSOC] THEN
    SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN])

  /- ----------------------------------------------------------------------- -/
  /- In the case of a loop, neither does symmetry.                           -/
  /- ----------------------------------------------------------------------- -/

  let PATH_SYM ← prove
   r"!p q. pathfinish p = pathstart q /\ pathfinish q = pathstart p
         ==> (path(p ++ q) <=> path(q ++ p))"
   (SIMP_TAC [PATH_JOIN, CONJ_ACI])

  let SIMPLE_PATH_SYM ← prove
   r"!p q. pathfinish p = pathstart q /\ pathfinish q = pathstart p
         ==> (simple_path(p ++ q) <=> simple_path(q ++ p))"
   (SIMP_TAC [SIMPLE_PATH_JOIN_LOOP_EQ, INTER_ACI, CONJ_ACI, INSERT_AC])

  let PATH_IMAGE_SYM ← prove
   r"!p q. pathfinish p = pathstart q /\ pathfinish q = pathstart p
         ==> path_image(p ++ q) = path_image(q ++ p)"
   (SIMP_TAC [PATH_IMAGE_JOIN, UNION_ACI])

  return { PATH_JOIN_PATH_ENDS, PATH_JOIN_EQ, SIMPLE_PATH_JOIN_IMP, SIMPLE_PATH_JOIN_LOOP_EQ,
           SIMPLE_PATH_JOIN_LOOP_EQ_ALT, ARC_JOIN_EQ, ARC_JOIN_EQ_ALT, PATH_ASSOC,
           SIMPLE_PATH_ASSOC, ARC_ASSOC, PATH_SYM, SIMPLE_PATH_SYM, PATH_IMAGE_SYM }

/- ------------------------------------------------------------------------- -/
/- Reparametrizing a closed curve to start at some chosen point.             -/
/- (paths.ml 1044-1194)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTE where
  shiftpath : thm
  SHIFTPATH_TRANSLATION : thm
  SHIFTPATH_LINEAR_IMAGE : thm
  PATHSTART_SHIFTPATH : thm
  PATHFINISH_SHIFTPATH : thm
  ENDPOINTS_SHIFTPATH : thm
  CLOSED_SHIFTPATH : thm
  PATH_SHIFTPATH : thm
  SHIFTPATH_SHIFTPATH : thm
  PATH_IMAGE_SHIFTPATH : thm
  SIMPLE_PATH_SHIFTPATH : thm
  deriving Inhabited

@[nospecialize]
def setupPTE [HolBase] (D : PathsDeps) (BA : PTA) : ExceptT String IO PTE := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, add_linear_invariants, add_translation_invariants,
        .. } := D.cvx
  let { COND_ID, COND_RAND, EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.cvx.core2
  let { IN_IMAGE, IN_UNION, .. } := D.cvx.core3
  let { SUBSET, SUBSET_ANTISYM, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_ADD, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_ADD, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } :=
    D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_SUB_REFL, .. } := D.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, .. } := D.cvx.top4
  let { DROP_EQ_0, .. } := D.pvec
  let { CONTINUOUS_ON_UNION, .. } := D.ptop3
  let { path, pathstart, pathfinish, path_image, simple_path, .. } := BA
  -- @@SCOPE END

  let shiftpath ← new_definition
   r"shiftpath a (f:real^1->real^N) =
        \x. if drop(a + x) <= &1 then f(a + x)
            else f(a + x - vec 1)"

  let SHIFTPATH_TRANSLATION ← prove
   r"!a t g. shiftpath t ((\x. a + x) o g) = (\x. a + x) o shiftpath t g"
   (REWRITE_TAC [FUN_EQ_THM, shiftpath, o_THM] THEN MESON_TAC [])

  add_translation_invariants [SHIFTPATH_TRANSLATION]

  let SHIFTPATH_LINEAR_IMAGE ← prove
   r"!f t g. linear f ==> shiftpath t (f o g) = f o shiftpath t g"
   (REWRITE_TAC [FUN_EQ_THM, shiftpath, o_THM] THEN MESON_TAC [])

  add_linear_invariants [SHIFTPATH_LINEAR_IMAGE]

  let PATHSTART_SHIFTPATH ← prove
   r"!a g. drop a <= &1 ==> pathstart(shiftpath a g) = g(a)"
   (SIMP_TAC [pathstart, shiftpath, VECTOR_ADD_RID])

  let PATHFINISH_SHIFTPATH ← prove
   r"!a g. &0 <= drop a /\ pathfinish g = pathstart g
         ==> pathfinish(shiftpath a g) = g(a)"
   (SIMP_TAC [pathfinish, shiftpath, pathstart, DROP_ADD, DROP_VEC] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + vec 1 - vec 1 = a")] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> (x + &1 <= &1 <=> x = &0)")] THEN
    SIMP_TAC [DROP_EQ_0, VECTOR_ADD_LID] THEN MESON_TAC [])

  let ENDPOINTS_SHIFTPATH ← prove
   r"!a g. pathfinish g = pathstart g /\ a IN interval[vec 0,vec 1]
         ==> pathfinish(shiftpath a g) = g a /\
             pathstart(shiftpath a g) = g a"
   (SIMP_TAC [IN_INTERVAL_1, DROP_VEC,
             PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH])

  let CLOSED_SHIFTPATH ← prove
   r"!a g. pathfinish g = pathstart g /\ a IN interval[vec 0,vec 1]
         ==> pathfinish(shiftpath a g) = pathstart(shiftpath a g)"
   (SIMP_TAC [IN_INTERVAL_1, PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH,
             DROP_VEC])

  let PATH_SHIFTPATH ← prove
   r"!g a. path g /\ pathfinish g:real^N = pathstart g /\
         a IN interval[vec 0,vec 1]
         ==> path(shiftpath a g)"
   (REWRITE_TAC [shiftpath, path] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"interval[vec 0,vec 1] = interval[vec 0,vec 1 - a:real^1] UNION
                              interval[vec 1 - a,vec 1]")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
      REWRITE_TAC [DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_UNION THEN REWRITE_TAC [CLOSED_INTERVAL] THEN
    CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THENL
     [EXISTS_TAC (← q r"(\x. g(a + x)):real^1->real^N") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_VEC, DROP_SUB] THEN
      SIMP_TAC [← REAL_ARITH (← q r"a + x <= &1 <=> x <= &1 - a")],
      EXISTS_TAC (← q r"(\x. g(a + x - vec 1)):real^1->real^N") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_VEC, DROP_SUB] THEN
      SIMP_TAC [← REAL_ARITH (← q r"&1 - a <= x ==> (a + x <= &1 <=> a + x = &1)")] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + x - vec 1 = (a + x) - vec 1")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [← GSYM LIFT_EQ, LIFT_ADD, LIFT_NUM, LIFT_DROP] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, COND_ID]] THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
             CONTINUOUS_ON_SUB] THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, DROP_ADD] THEN
    REAL_ARITH_TAC)

  let SHIFTPATH_SHIFTPATH ← prove
   r"!g a x. a IN interval[vec 0,vec 1] /\ pathfinish g = pathstart g /\
           x IN interval[vec 0,vec 1]
           ==> shiftpath (vec 1 - a) (shiftpath a g) x = g x"
   (REWRITE_TAC [shiftpath, pathfinish, pathstart] THEN
    REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
    REWRITE_TAC [DROP_VEC] THEN REPEAT STRIP_TAC THENL
     [ALL_TAC,
      AP_TERM_TAC THEN VECTOR_ARITH_TAC,
      AP_TERM_TAC THEN VECTOR_ARITH_TAC,
      ASM_REAL_ARITH_TAC] THEN
    SUBGOAL_THEN (← q r"x:real^1 = vec 0") SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
      ASM_REAL_ARITH_TAC,
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + vec 1 - a + vec 0:real^1 = vec 1")]])

  let PATH_IMAGE_SHIFTPATH ← prove
   r"!a g:real^1->real^N.
        a IN interval[vec 0,vec 1] /\ pathfinish g = pathstart g
        ==> path_image(shiftpath a g) = path_image g"
   (REWRITE_TAC [IN_INTERVAL_1, pathfinish, pathstart] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THEN
    REWRITE_TAC [path_image, shiftpath, FORALL_IN_IMAGE, SUBSET] THEN
    REWRITE_TAC [IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_IMAGE] THENL
     [EXISTS_TAC (← q r"a + x:real^1"),
      EXISTS_TAC (← q r"a + x - vec 1:real^1"),
      ALL_TAC] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_SUB, DROP_ADD] THEN
    TRY REAL_ARITH_TAC THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"drop a <= drop x") THENL
     [EXISTS_TAC (← q r"x - a:real^1") THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + x - a:real^1 = x"), DROP_SUB] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_REAL_ARITH_TAC,
      EXISTS_TAC (← q r"vec 1 + x - a:real^1") THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a + (v + x - a) - v:real^1 = x")] THEN
      REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC] THEN
      ASM_CASES_TAC (← q r"x:real^1 = vec 0") THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + v + x - a:real^1 = v + x")] THEN
      ASM_REWRITE_TAC [VECTOR_ADD_RID, DROP_VEC, COND_ID] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"a + &1 + x - a <= &1 <=> x <= &0")] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
      TRY (COND_CASES_TAC THEN POP_ASSUM MP_TAC) THEN REWRITE_TAC [] THEN
      REAL_ARITH_TAC])

  let SIMPLE_PATH_SHIFTPATH ← prove
   r"!g a. simple_path g /\ pathfinish g = pathstart g /\
         a IN interval[vec 0,vec 1]
         ==> simple_path(shiftpath a g)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [simple_path] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(a /\ c /\ d ==> e) /\ (b /\ c /\ d ==> f)
      ==>  (a /\ b) /\ c /\ d ==> e /\ f")) THEN
    CONJ_TAC THENL [MESON_TAC [PATH_SHIFTPATH], ALL_TAC] THEN
    REWRITE_TAC [simple_path, shiftpath, IN_INTERVAL_1, DROP_VEC,
                DROP_ADD, DROP_SUB] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> c ==> a /\ b ==> d")] THEN
    STRIP_TAC THEN REPEAT GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    DISCH_THEN (fun th => FIRST_X_ASSUM (MP_TAC o C MATCH_MP th)) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC, ← GSYM DROP_EQ] THEN
    REAL_ARITH_TAC)

  return { shiftpath, SHIFTPATH_TRANSLATION, SHIFTPATH_LINEAR_IMAGE, PATHSTART_SHIFTPATH,
           PATHFINISH_SHIFTPATH, ENDPOINTS_SHIFTPATH, CLOSED_SHIFTPATH, PATH_SHIFTPATH,
           SHIFTPATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH, SIMPLE_PATH_SHIFTPATH }

/- ------------------------------------------------------------------------- -/
/- Choosing a sub-path of an existing path.  (paths.ml 1195-1400)            -/
/- ------------------------------------------------------------------------- -/

structure PTF where
  subpath : thm
  SUBPATH_SCALING_LEMMA : thm
  PATH_IMAGE_SUBPATH_GEN : thm
  PATH_IMAGE_SUBPATH : thm
  PATH_IMAGE_SUBPATH_COMBINE : thm
  PATH_SUBPATH : thm
  PATHSTART_SUBPATH : thm
  PATHFINISH_SUBPATH : thm
  SUBPATH_TRIVIAL : thm
  SUBPATH_REVERSEPATH : thm
  REVERSEPATH_SUBPATH : thm
  SUBPATH_TRANSLATION : thm
  SUBPATH_LINEAR_IMAGE : thm
  SIMPLE_PATH_SUBPATH_EQ : thm
  ARC_SUBPATH_EQ : thm
  SIMPLE_PATH_SUBPATH : thm
  ARC_SIMPLE_PATH_SUBPATH : thm
  ARC_SUBPATH_ARC : thm
  ARC_SIMPLE_PATH_SUBPATH_INTERIOR : thm
  PATH_IMAGE_SUBPATH_SUBSET : thm
  JOIN_SUBPATHS_MIDDLE : thm
  deriving Inhabited

@[nospecialize]
def setupPTF [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) : ExceptT String IO PTF := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC,
        REAL_RING, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, add_linear_invariants,
        add_translation_invariants, .. } := D.cvx
  let { CONTRAPOS_THM, EMPTY_SUBSET, ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_SUBSET, IMAGE_UNION, IMAGE_o, IMP_CONJ,
        INSERT_SUBSET, .. } := D.cvx.core2
  let { REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_SUB_0, REAL_SUB_LE, REAL_SUB_REFL, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { SUBSET_HULL, .. } := D.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, FORALL_DROP, FORALL_LIFT, LIFT_DROP,
        LIFT_SUB, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_ADD_SYM, VECTOR_MUL_EQ_0, VECTOR_MUL_LCANCEL,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, VECTOR_SUB_LDISTRIB,
        VECTOR_SUB_LZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, .. } := D.cvx.top4
  let { SEGMENT_1, SEGMENT_SYM, .. } := D.cvx.top5
  let { REAL_WLOG_LT, .. } := D.pses2
  let { DROP_EQ_0, DROP_NEG, LIFT_EQ_CMUL, .. } := D.pvec
  let { CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.ptop4
  let { SUBSET_INTERVAL_1, UNION_INTERVAL_1, .. } := D.ptop5
  let { CONVEX_INTERVAL, SEGMENT_CONVEX_HULL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, reversepath, joinpaths, simple_path, arc,
        .. } := BA
  let { ARC_IMP_SIMPLE_PATH, SIMPLE_PATH_IMP_PATH, SIMPLE_PATH_IMP_ARC, .. } := BB
  -- @@SCOPE END

  let subpath ← new_definition
   r"subpath u v g = \x. g(u + drop(v - u) % x)"

  let SUBPATH_SCALING_LEMMA ← prove
   r"!u v.
    IMAGE (\x. u + drop(v - u) % x) (interval[vec 0,vec 1]) = segment[u,v]"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, SEGMENT_1] THEN
    REWRITE_TAC [DROP_SUB, REAL_SUB_LE, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    BINOP_TAC THEN REWRITE_TAC [← GSYM LIFT_EQ_CMUL, VECTOR_MUL_RZERO] THEN
    REWRITE_TAC [LIFT_DROP, LIFT_SUB] THEN VECTOR_ARITH_TAC)

  let PATH_IMAGE_SUBPATH_GEN ← prove
   r"!u v g:real^1->real^N. path_image(subpath u v g) = IMAGE g (segment[u,v])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_image, subpath] THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    REWRITE_TAC [IMAGE_o, SUBPATH_SCALING_LEMMA])

  let PATH_IMAGE_SUBPATH ← prove
   r"!u v g:real^1->real^N.
        drop u <= drop v
        ==> path_image(subpath u v g) = IMAGE g (interval[u,v])"
   (SIMP_TAC [PATH_IMAGE_SUBPATH_GEN, SEGMENT_1])

  let PATH_IMAGE_SUBPATH_COMBINE ← prove
   r"!g:real^1->real^N u.
        path g /\ u IN interval[vec 0,vec 1]
        ==> path_image(subpath (vec 0) u g) UNION
            path_image(subpath u (vec 1) g) =
            path_image g"
   (REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [PATH_IMAGE_SUBPATH] THEN
    REWRITE_TAC [path_image, ← GSYM IMAGE_UNION] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC UNION_INTERVAL_1 THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1])

  let PATH_SUBPATH ← prove
   r"!u v g:real^1->real^N.
        path g /\ u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1]
        ==> path(subpath u v g)"
   (REWRITE_TAC [path, subpath] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID,
             CONTINUOUS_ON_CONST] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBPATH_SCALING_LEMMA, SEGMENT_1] THEN
    COND_CASES_TAC THEN REWRITE_TAC [SUBSET_INTERVAL_1] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let PATHSTART_SUBPATH ← prove
   r"!u v g:real^1->real^N. pathstart(subpath u v g) = g(u)"
   (REWRITE_TAC [pathstart, subpath, VECTOR_MUL_RZERO, VECTOR_ADD_RID])

  let PATHFINISH_SUBPATH ← prove
   r"!u v g:real^1->real^N. pathfinish(subpath u v g) = g(v)"
   (REWRITE_TAC [pathfinish, subpath, ← GSYM LIFT_EQ_CMUL] THEN
    REWRITE_TAC [LIFT_DROP, ← VECTOR_ARITH (← q r"u + v - u:real^N = v")])

  let SUBPATH_TRIVIAL ← prove
   r"!g. subpath (vec 0) (vec 1) g = g"
   (REWRITE_TAC [subpath, VECTOR_SUB_RZERO, DROP_VEC, VECTOR_MUL_LID,
                VECTOR_ADD_LID, ETA_AX])

  let SUBPATH_REVERSEPATH ← prove
   r"!g. subpath (vec 1) (vec 0) g = reversepath g"
   (REWRITE_TAC [subpath, reversepath, VECTOR_SUB_LZERO, DROP_NEG, DROP_VEC] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + -- &1 % b:real^N = a - b")])

  let REVERSEPATH_SUBPATH ← prove
   r"!g u v. reversepath(subpath u v g) = subpath v u g"
   (REWRITE_TAC [reversepath, subpath, FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
    AP_TERM_TAC THEN REWRITE_TAC [DROP_SUB, VECTOR_SUB_LDISTRIB] THEN
    REWRITE_TAC [← GSYM LIFT_EQ_CMUL, LIFT_SUB, LIFT_DROP] THEN
    VECTOR_ARITH_TAC)

  let SUBPATH_TRANSLATION ← prove
   r"!a g:real^1->real^N u v.
        subpath u v ((\x. a + x) o g) = (\x. a + x) o subpath u v g"
   (REWRITE_TAC [FUN_EQ_THM, subpath, o_THM])

  add_translation_invariants [SUBPATH_TRANSLATION]

  let SUBPATH_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N g u v.
    linear f ==> subpath u v (f o g) = f o subpath u v g"
   (REWRITE_TAC [FUN_EQ_THM, subpath, o_THM])

  add_linear_invariants [SUBPATH_LINEAR_IMAGE]

  let SIMPLE_PATH_SUBPATH_EQ ← prove
   r"!g u v. simple_path(subpath u v g) <=>
           path(subpath u v g) /\ ~(u = v) /\
           (!x y. x IN segment[u,v] /\ y IN segment[u,v] /\ g x = g y
                  ==> x = y \/ x = u /\ y = v \/ x = v /\ y = u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [simple_path, subpath] THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM SUBPATH_SCALING_LEMMA] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"u + a % x = u <=> a % x = vec 0"),
                ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")] THEN
    REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_MUL_LCANCEL] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_SUB,
                ← REAL_RING (← q r"u + (v - u) * y = v <=> v = u \/ y = &1")] THEN
    REWRITE_TAC [REAL_SUB_0, DROP_EQ, ← GSYM DROP_VEC] THEN
    ASM_CASES_TAC (← q r"v:real^1 = u") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [REAL_SUB_REFL, DROP_VEC, VECTOR_MUL_LZERO] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &2)", ← q r"lift(&3 / &4)"]) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ, LIFT_DROP] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let ARC_SUBPATH_EQ ← prove
   r"!g u v. arc(subpath u v g) <=>
           path(subpath u v g) /\ ~(u = v) /\
           (!x y. x IN segment[u,v] /\ y IN segment[u,v] /\ g x = g y
                  ==> x = y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [arc, subpath] THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM SUBPATH_SCALING_LEMMA] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"u + a % x = u + a % y <=> a % (x - y) = vec 0"),
                VECTOR_MUL_EQ_0, DROP_EQ_0, VECTOR_SUB_EQ] THEN
    ASM_CASES_TAC (← q r"v:real^1 = u") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [VECTOR_SUB_REFL, DROP_VEC, VECTOR_MUL_LZERO] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &2)", ← q r"lift(&3 / &4)"]) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ, LIFT_DROP] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let SIMPLE_PATH_SUBPATH ← prove
   r"!g u v. simple_path g /\
           u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
           ~(u = v)
           ==> simple_path(subpath u v g)"
   (SIMP_TAC [SIMPLE_PATH_SUBPATH_EQ, PATH_SUBPATH, SIMPLE_PATH_IMP_PATH] THEN
    REWRITE_TAC [simple_path] THEN GEN_TAC THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
    CONJ_TAC THENL [MESON_TAC [SEGMENT_SYM], ALL_TAC] THEN
    SIMP_TAC [SEGMENT_1, REAL_LT_IMP_LE] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN DISCH_TAC THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
    SUBGOAL_THEN
     (← q r"!x:real^1. x IN interval[u,v] ==> x IN interval[vec 0,vec 1]")
    ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM SUBSET, SUBSET_INTERVAL_1] THEN
      ASM_MESON_TAC [IN_INTERVAL_1, DROP_VEC, REAL_LE_TRANS],
      ASM_SIMP_TAC []] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
    REWRITE_TAC [DROP_VEC, ← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC)

  let ARC_SIMPLE_PATH_SUBPATH ← prove
   r"!g u v. simple_path g /\
           u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
           ~(g u = g v)
           ==> arc(subpath u v g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SIMPLE_PATH_IMP_ARC THEN
    ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
    ASM_MESON_TAC [SIMPLE_PATH_SUBPATH])

  let ARC_SUBPATH_ARC ← prove
   r"!u v g. arc g /\
           u IN interval [vec 0,vec 1] /\ v IN interval [vec 0,vec 1] /\
           ~(u = v)
           ==> arc(subpath u v g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
    ASM_MESON_TAC [ARC_IMP_SIMPLE_PATH, arc])

  let ARC_SIMPLE_PATH_SUBPATH_INTERIOR ← prove
   r"!g u v. simple_path g /\
           u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
           ~(u = v) /\ abs(drop u - drop v) < &1
           ==> arc(subpath u v g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [simple_path]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u:real^1", ← q r"v:real^1"] o CONJUNCT2) THEN
    ASM_REWRITE_TAC [] THEN POP_ASSUM_LIST (MP_TAC o HolLight.end_itlist CONJ) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC)

  let PATH_IMAGE_SUBPATH_SUBSET ← prove
   r"!u v g:real^1->real^N.
        path g /\ u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1]
        ==> path_image(subpath u v g) SUBSET path_image g"
   (SIMP_TAC [PATH_IMAGE_SUBPATH_GEN] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [path_image] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
    SIMP_TAC [SEGMENT_CONVEX_HULL, SUBSET_HULL, CONVEX_INTERVAL] THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET])

  let JOIN_SUBPATHS_MIDDLE ← prove
   r"!p:real^1->real^N.
   subpath (vec 0) (lift(&1 / &2)) p ++ subpath (lift(&1 / &2)) (vec 1) p = p"
   (REWRITE_TAC [FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [joinpaths, subpath] THEN COND_CASES_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_SUB, DROP_CMUL, LIFT_DROP,
                DROP_VEC] THEN
    REAL_ARITH_TAC)

  return { subpath, SUBPATH_SCALING_LEMMA, PATH_IMAGE_SUBPATH_GEN, PATH_IMAGE_SUBPATH,
           PATH_IMAGE_SUBPATH_COMBINE, PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
           SUBPATH_TRIVIAL, SUBPATH_REVERSEPATH, REVERSEPATH_SUBPATH, SUBPATH_TRANSLATION,
           SUBPATH_LINEAR_IMAGE, SIMPLE_PATH_SUBPATH_EQ, ARC_SUBPATH_EQ, SIMPLE_PATH_SUBPATH,
           ARC_SIMPLE_PATH_SUBPATH, ARC_SUBPATH_ARC, ARC_SIMPLE_PATH_SUBPATH_INTERIOR,
           PATH_IMAGE_SUBPATH_SUBSET, JOIN_SUBPATHS_MIDDLE }

/- ------------------------------------------------------------------------- -/
/- Some additional lemmas about choosing sub-paths.  (paths.ml 1401-1767)    -/
/- ------------------------------------------------------------------------- -/

structure PTG where
  EXISTS_SUBPATH_OF_PATH : thm
  EXISTS_SUBPATH_OF_ARC_NOENDS : thm
  EXISTS_SUBARC_OF_ARC_NOENDS : thm
  EXISTS_ARC_PSUBSET_SIMPLE_PATH : thm
  EXISTS_DOUBLE_ARC_EXPLICIT : thm
  deriving Inhabited

@[nospecialize]
def setupPTG [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BE : PTE)
    (BF : PTF) : ExceptT String IO PTG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.cvx
  let { EMPTY_SUBSET, EXISTS_IN_IMAGE, EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, INSERT_SUBSET, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, IN_UNIV, .. } := D.cvx.core3
  let { REAL_LE_REFL, .. } := D.cvx.core4
  let { REAL_POS, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.cvx.core5
  let { SUBSET_HULL, .. } := D.cvx.misc
  let { DROP_EQ, DROP_VEC, ENDS_IN_INTERVAL, LIFT_DROP, LIFT_EQ, .. } := D.cvx.vec2
  let { VEC_COMPONENT, drop, .. } := D.cvx.vec4
  let { INTERVAL_NE_EMPTY_1, IN_INTERVAL_1, .. } := D.cvx.top4
  let { SEGMENT_1, closed, open_in, .. } := D.cvx.top5
  let { PSUBSET_ALT, .. } := D.pses2
  let { DIST_REAL, ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CONTINUOUS_OPEN_IN_PREIMAGE, .. } := D.ptop3
  let { CONVEX_INTERVAL, SEGMENT_CONVEX_HULL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, simple_path, arc, .. } := BA
  let { ARC_IMP_SIMPLE_PATH, ARC_IMP_PATH, SIMPLE_PATH_IMP_PATH, SIMPLE_PATH_CASES, .. } := BB
  let { PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_JOIN, ARC_JOIN, .. } := BC
  let { PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH, PATH_IMAGE_SHIFTPATH,
        SIMPLE_PATH_SHIFTPATH, .. } := BE
  let { PATH_IMAGE_SUBPATH_GEN, PATH_IMAGE_SUBPATH, PATH_SUBPATH, PATHSTART_SUBPATH,
        PATHFINISH_SUBPATH, ARC_SIMPLE_PATH_SUBPATH, ARC_SIMPLE_PATH_SUBPATH_INTERIOR,
        PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  -- @@SCOPE END

  let EXISTS_SUBPATH_OF_PATH ← prove
   r"!g a b:real^N.
        path g /\ a IN path_image g /\ b IN path_image g
        ==> ?h. path h /\ pathstart h = a /\ pathfinish h = b /\
                path_image h SUBSET path_image g"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, path_image, FORALL_IN_IMAGE] THEN
    GEN_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:real^1") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"v:real^1") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"subpath u v (g:real^1->real^N)") THEN
    ASM_REWRITE_TAC [← GSYM path_image, PATH_IMAGE_SUBPATH_GEN] THEN
    ASM_SIMP_TAC [PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
    REWRITE_TAC [path_image] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
    SIMP_TAC [SEGMENT_CONVEX_HULL, SUBSET_HULL, CONVEX_INTERVAL] THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET])

  let EXISTS_SUBPATH_OF_ARC_NOENDS ← prove
   r"!g a b:real^N.
        arc g /\ a IN path_image g /\ b IN path_image g /\
        {a,b} INTER {pathstart g,pathfinish g} = {}
        ==> ?h. path h /\ pathstart h = a /\ pathfinish h = b /\
                path_image h SUBSET
                (path_image g) DIFF {pathstart g,pathfinish g}"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, path_image, FORALL_IN_IMAGE] THEN
    GEN_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:real^1") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"v:real^1") THEN DISCH_TAC THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"subpath u v (g:real^1->real^N)") THEN
    ASM_SIMP_TAC [PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                 ARC_IMP_PATH, ← GSYM path_image, PATH_IMAGE_SUBPATH_GEN] THEN
    REWRITE_TAC [path_image, pathstart, pathfinish] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"s SUBSET t DIFF {a,b} <=> s SUBSET t /\ ~(a IN s) /\ ~(b IN s)")] THEN
    REWRITE_TAC [IN_IMAGE] THEN
    SUBGOAL_THEN (← q r"~(vec 0 IN segment[u:real^1,v]) /\ ~(vec 1 IN segment[u,v])")
    STRIP_ASSUME_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
      REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      SIMP_TAC [← REAL_ARITH (← q r"a:real <= b ==> (b <= a <=> a = b)")] THEN
      REWRITE_TAC [← GSYM DROP_VEC, DROP_EQ] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [arc, pathstart, pathfinish]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"segment[u:real^1,v] SUBSET interval[vec 0,vec 1]") MP_TAC THENL
     [SIMP_TAC [SEGMENT_CONVEX_HULL, SUBSET_HULL, CONVEX_INTERVAL] THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET],
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [arc, pathstart, pathfinish]) THEN
    SUBGOAL_THEN (← q r"(vec 0:real^1) IN interval[vec 0,vec 1] /\
                  (vec 1:real^1) IN interval[vec 0,vec 1]")
    MP_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL],
      ASM SET_TAC []])

  let EXISTS_SUBARC_OF_ARC_NOENDS ← prove
   r"!g a b:real^N.
        arc g /\ a IN path_image g /\ b IN path_image g /\ ~(a = b) /\
        {a,b} INTER {pathstart g,pathfinish g} = {}
        ==> ?h. arc h /\ pathstart h = a /\ pathfinish h = b /\
                path_image h SUBSET
                (path_image g) DIFF {pathstart g,pathfinish g}"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, path_image, FORALL_IN_IMAGE] THEN
    GEN_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:real^1") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"v:real^1") THEN REPEAT DISCH_TAC THEN
    EXISTS_TAC (← q r"subpath u v (g:real^1->real^N)") THEN
    ASM_SIMP_TAC [PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                 ARC_IMP_PATH, ← GSYM path_image, PATH_IMAGE_SUBPATH_GEN] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
      ASM_SIMP_TAC [ARC_IMP_SIMPLE_PATH],
      ALL_TAC] THEN
    REWRITE_TAC [path_image, pathstart, pathfinish] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"s SUBSET t DIFF {a,b} <=> s SUBSET t /\ ~(a IN s) /\ ~(b IN s)")] THEN
    REWRITE_TAC [IN_IMAGE] THEN
    SUBGOAL_THEN (← q r"~(vec 0 IN segment[u:real^1,v]) /\ ~(vec 1 IN segment[u,v])")
    STRIP_ASSUME_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
      REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      SIMP_TAC [← REAL_ARITH (← q r"a:real <= b ==> (b <= a <=> a = b)")] THEN
      REWRITE_TAC [← GSYM DROP_VEC, DROP_EQ] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [arc, pathstart, pathfinish]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"segment[u:real^1,v] SUBSET interval[vec 0,vec 1]") MP_TAC THENL
     [SIMP_TAC [SEGMENT_CONVEX_HULL, SUBSET_HULL, CONVEX_INTERVAL] THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET],
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [arc, pathstart, pathfinish]) THEN
    SUBGOAL_THEN (← q r"(vec 0:real^1) IN interval[vec 0,vec 1] /\
                  (vec 1:real^1) IN interval[vec 0,vec 1]")
    MP_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL],
      ASM SET_TAC []])

  let EXISTS_ARC_PSUBSET_SIMPLE_PATH ← prove
   r"!g:real^1->real^N.
        simple_path g /\ closed s /\ s PSUBSET path_image g
        ==> ?h. arc h /\
                s SUBSET path_image h /\
                path_image h SUBSET path_image g"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP SIMPLE_PATH_CASES) THENL
     [EXISTS_TAC (← q r"g:real^1->real^N") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [PSUBSET_ALT]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [path_image] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^1") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"(h:real^1->real^N) = shiftpath u g") THEN
    SUBGOAL_THEN
     (← q r"simple_path(h:real^1->real^N) /\
      pathstart h = (g:real^1->real^N) u /\
      pathfinish h = (g:real^1->real^N) u /\
      path_image h = path_image g")
    MP_TAC THENL
     [EXPAND_TAC "h" THEN
      ASM_MESON_TAC [SIMPLE_PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH,
                    PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH,
                    IN_INTERVAL_1, DROP_VEC],
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
      UNDISCH_THEN (← q r"pathstart(h:real^1->real^N) = (g:real^1->real^N) u")
          (SUBST_ALL_TAC o SYM)] THEN
    SUBGOAL_THEN
     (← q r"open_in (subtopology euclidean (interval[vec 0,vec 1]))
              {x:real^1 | x IN interval[vec 0,vec 1] /\
                          (h x) IN ((:real^N) DIFF s)}")
    MP_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE THEN
      ASM_SIMP_TAC [← GSYM path, ← GSYM closed, SIMPLE_PATH_IMP_PATH],
      REWRITE_TAC [open_in] THEN DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN
    DISCH_THEN (fun th => tactic_of do
      pure ((MP_TAC o SPEC (← q r"vec 0:real^1")) th THEN
            (MP_TAC o SPEC (← q r"vec 1:real^1")) th)) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
    REWRITE_TAC [DIST_REAL, VEC_COMPONENT, REAL_SUB_RZERO] THEN
    SIMP_TAC [← GSYM drop] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [pathfinish], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [pathstart], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"subpath (lift(min d1 (&1 / &4))) (lift(&1 - min d2 (&1 / &4)))
              (h:real^1->real^N)") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH_INTERIOR THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP, LIFT_EQ] THEN
      ASM_REAL_ARITH_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET t ==> t INTER s SUBSET u ==> s SUBSET u"))) THEN
      REWRITE_TAC [SUBSET, IN_INTER, IMP_CONJ] THEN
      SIMP_TAC [PATH_IMAGE_SUBPATH, LIFT_DROP,
               ← REAL_ARITH (← q r"min d1 (&1 / &4) <= &1 - min d2 (&1 / &4)")] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, path_image, IN_INTERVAL_1, DROP_VEC] THEN
      X_GEN_TAC (← q r"x:real^1") THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"x:real^1") THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1"))) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC PATH_IMAGE_SUBPATH_SUBSET THEN
      ASM_SIMP_TAC [SIMPLE_PATH_IMP_PATH, IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
      ASM_REAL_ARITH_TAC])

  let EXISTS_DOUBLE_ARC_EXPLICIT ← prove
   r"!g:real^1->real^N a b.
        simple_path g /\ pathfinish g = pathstart g /\
        a IN interval[vec 0,vec 1] /\ b IN interval[vec 0,vec 1] /\
        drop a <= drop b /\ ~(g a = g b)
        ==> ?u d. arc u /\ arc d /\
                  pathstart u = g a /\ pathfinish u = g b /\
                  pathstart d = g b /\ pathfinish d = g a /\
                  path_image u =
                    IMAGE g (interval[a,b]) /\
                  path_image d =
                    IMAGE g (interval[vec 0,vec 1] DIFF interval(a,b)) /\
                  (path_image u) INTER (path_image d) = {g a,g b} /\
                  (path_image u) UNION (path_image d) = path_image g"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"a:real^1 = vec 0") THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"subpath (vec 0) b (g:real^1->real^N)",
        ← q r"subpath b (vec 1) (g:real^1->real^N)"] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        ASM_MESON_TAC [pathfinish, pathstart],
        ASM_REWRITE_TAC [PATHSTART_SUBPATH],
        ASM_REWRITE_TAC [PATHFINISH_SUBPATH],
        ASM_REWRITE_TAC [PATHSTART_SUBPATH],
        ASM_REWRITE_TAC [PATHFINISH_SUBPATH] THEN
        ASM_MESON_TAC [pathfinish, pathstart],
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH],
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, DROP_VEC, ← GSYM IMAGE_UNION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"g u = g l
          ==> u IN s /\ u IN t /\
              (!x. ~(x = l) ==> (x IN s <=> x IN t))
              ==> IMAGE g s = IMAGE g t"))) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ, IN_DIFF] THEN
        ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, DROP_VEC, ← GSYM IMAGE_UNION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"g c = g a
          ==> a IN ab /\ b IN ab /\ b IN b1 /\ c IN b1 /\
              (!x y. g x = g y /\ x IN ab /\ y IN b1
                     ==> x = a \/ x = b)
          ==> IMAGE g ab INTER IMAGE g b1 = {g a,g b}"))) THEN
        ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1, DROP_VEC] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
        FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
        ASM_CASES_TAC (← q r"(g:real^1->real^N) x = g y") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [DROP_VEC]) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ] THEN
        ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION, DROP_VEC] THEN
        REWRITE_TAC [path_image] THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1, DROP_VEC] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"b:real^1 = vec 1") THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"subpath a b (g:real^1->real^N)",
        ← q r"subpath (vec 0) a (g:real^1->real^N)"] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        ASM_MESON_TAC [pathfinish, pathstart],
        ASM_REWRITE_TAC [PATHSTART_SUBPATH],
        ASM_REWRITE_TAC [PATHFINISH_SUBPATH],
        ASM_REWRITE_TAC [PATHSTART_SUBPATH] THEN
        ASM_MESON_TAC [pathfinish, pathstart],
        ASM_REWRITE_TAC [PATHFINISH_SUBPATH],
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH],
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, DROP_VEC, ← GSYM IMAGE_UNION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"g u = g l
          ==> l IN s /\ u IN t /\
              (!x. ~(x = u) ==> (x IN s <=> x IN t))
              ==> IMAGE g s = IMAGE g t"))) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ, IN_DIFF] THEN
        ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, DROP_VEC, ← GSYM IMAGE_UNION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"g b = g c
          ==> a IN a1 /\ b IN a1 /\ a IN a0 /\ c IN a0 /\
              (!x y. g x = g y /\ x IN a0 /\ y IN a1
                     ==> x = a \/ x = c)
          ==> IMAGE g a1 INTER IMAGE g a0 = {g a,g b}"))) THEN
        ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1, DROP_VEC] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
        FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
        ASM_CASES_TAC (← q r"(g:real^1->real^N) x = g y") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [DROP_VEC]) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ] THEN
        ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION, DROP_VEC] THEN
        REWRITE_TAC [path_image] THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1, DROP_VEC] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"subpath a b (g:real^1->real^N)",
      ← q r"subpath b (vec 1) (g:real^1->real^N) ++ subpath (vec 0) a g"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC ARC_JOIN THEN
      REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"b:real^1", ← q r"vec 1:real^1"]) THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ, IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"vec 0:real^1"]) THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ, IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REAL_ARITH_TAC,
        ASM_MESON_TAC [pathstart, pathfinish],
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"g u = g l
          ==> (!x y. x IN b1 /\ y IN a0 /\ g x = g y
                     ==> x = l \/ x = u)
              ==> IMAGE g b1 INTER IMAGE g a0 SUBSET {g l}"))) THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
        FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
        ASM_CASES_TAC (← q r"(g:real^1->real^N) x = g y") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"a:real^1 = b") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [DROP_VEC, ← GSYM DROP_EQ]) THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ] THEN
        ASM_REAL_ARITH_TAC],
      REWRITE_TAC [PATHSTART_SUBPATH],
      REWRITE_TAC [PATHFINISH_SUBPATH],
      REWRITE_TAC [PATHSTART_JOIN, PATHSTART_SUBPATH],
      REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_SUBPATH],
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH],
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION] THEN
      AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_UNION, IN_DIFF, IN_INTERVAL_1] THEN
      ASM_REAL_ARITH_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"a IN ab /\ b IN ab /\ a IN a0 /\ b IN b1 /\
        (!x y. g x = g y /\ x IN ab /\ (y IN b1 \/ y IN a0)
               ==> x = a \/ x = b)
        ==> IMAGE g ab INTER IMAGE g (b1 UNION a0) = {g a,g b}")) THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [simple_path]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_CASES_TAC (← q r"(g:real^1->real^N) x = g y") THEN ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [DROP_VEC]) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ] THEN
      ASM_REAL_ARITH_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM IMAGE_UNION] THEN
      REWRITE_TAC [path_image] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC])

  return { EXISTS_SUBPATH_OF_PATH, EXISTS_SUBPATH_OF_ARC_NOENDS, EXISTS_SUBARC_OF_ARC_NOENDS,
           EXISTS_ARC_PSUBSET_SIMPLE_PATH, EXISTS_DOUBLE_ARC_EXPLICIT }

/- ------------------------------------------------------------------------- -/
/- Double arcs; subpaths up to the frontier; combining subpaths.             -/
/- (paths.ml 1768-1996)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTH where
  EXISTS_DOUBLE_ARC : thm
  SUBPATH_TO_FRONTIER_EXPLICIT : thm
  SUBPATH_TO_FRONTIER_STRONG : thm
  SUBPATH_TO_FRONTIER : thm
  EXISTS_PATH_SUBPATH_TO_FRONTIER : thm
  EXISTS_PATH_SUBPATH_TO_FRONTIER_CLOSED : thm
  PATH_COMBINE : thm
  deriving Inhabited

@[nospecialize]
def setupPTH [HolBase] (D : PathsDeps) (BA : PTA) (BF : PTF) (BG : PTG) :
    ExceptT String IO PTH := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.cvx
  let { EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, INSERT_AC, INSERT_SUBSET, INTER_COMM,
        IN_DELETE, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, PAIR_EQ, .. } := D.cvx.core3
  let { REAL_LE_INV_EQ, REAL_LE_MUL, REAL_LE_REFL, REAL_LT_LE, REAL_LT_MUL, .. } := D.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RINV, REAL_NOT_LE, REAL_POS, REAL_SUB_LE, REAL_SUB_LT, SUBSET,
        SUBSET_INTER, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNION_COMM, o_THM, .. } := D.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, EXISTS_DROP, FORALL_DROP, LIFT_DROP,
        LIFT_EQ, LIFT_NUM, LINEAR_SCALING, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_ADD_RID, VECTOR_SUB_EQ, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, drop, .. } :=
    D.cvx.vec4
  let { BOUNDED_SUBSET, CLOSED_CLOSURE, CLOSED_INTERVAL, CLOSURE_APPROACHABLE,
        CLOSURE_COMPLEMENT, CLOSURE_EQ, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_EQ_BOUNDED_CLOSED, .. } := D.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } :=
    D.cvx.top4
  let { continuous_on, frontier, .. } := D.cvx.top5
  let { CONS_11, .. } := D.pses1
  let { DIST_REAL, DROP_NEG, ENDS_IN_UNIT_INTERVAL, LIFT_EQ_CMUL, .. } := D.pvec
  let { BOUNDED_INTERVAL, COMPACT_ATTAINS_INF, .. } := D.ptop1
  let { CONTINUOUS_CLOSED_PREIMAGE, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_UNION, .. } := D.ptop3
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.ptop4
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { subpath, PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH, SUBPATH_TRIVIAL,
        PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  let { EXISTS_DOUBLE_ARC_EXPLICIT, .. } := BG
  -- @@SCOPE END

  let EXISTS_DOUBLE_ARC ← prove
   r"!g:real^1->real^N a b.
        simple_path g /\ pathfinish g = pathstart g /\
        a IN path_image g /\ b IN path_image g /\ ~(a = b)
        ==> ?u d. arc u /\ arc d /\
                  pathstart u = a /\ pathfinish u = b /\
                  pathstart d = b /\ pathfinish d = a /\
                  (path_image u) INTER (path_image d) = {a,b} /\
                  (path_image u) UNION (path_image d) = path_image g"
   (REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"(b:real^N) IN path_image g") THEN
    GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [path_image] THEN
    UNDISCH_TAC (← q r"(a:real^N) IN path_image g") THEN
    GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [path_image] THEN
    REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^1") THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    X_GEN_TAC (← q r"v:real^1") THEN
    DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC) THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop u <= drop v \/ drop v <= drop u")) THENL
     [MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"u:real^1", ← q r"v:real^1"]
          EXISTS_DOUBLE_ARC_EXPLICIT) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [],
      MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"v:real^1", ← q r"u:real^1"]
          EXISTS_DOUBLE_ARC_EXPLICIT) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [INTER_COMM, UNION_COMM, INSERT_AC]])

  let SUBPATH_TO_FRONTIER_EXPLICIT ← prove
   r"!g:real^1->real^N s.
        path g /\ pathstart g IN s /\ ~(pathfinish g IN s)
        ==> ?u. u IN interval[vec 0,vec 1] /\
                (!x. &0 <= drop x /\ drop x < drop u ==> g x IN interior s) /\
                ~(g u IN interior s) /\
                (u = vec 0 \/ g u IN closure s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"{u | lift u IN interval[vec 0,vec 1] /\
                       g(lift u) IN closure((:real^N) DIFF s)}")
           COMPACT_ATTAINS_INF) THEN
    SIMP_TAC [LIFT_DROP, ← SET_RULE
     (← q r"(!x. lift(drop x) = x) ==> IMAGE lift {x | P(lift x)} = {x | P x}")] THEN
    ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [path, pathstart, pathfinish, SUBSET,
                                  path_image, FORALL_IN_IMAGE]) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
         [MATCH_MP_TAC BOUNDED_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          REWRITE_TAC [BOUNDED_INTERVAL] THEN SET_TAC [],
          MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
          ASM_REWRITE_TAC [CLOSED_CLOSURE, CLOSED_INTERVAL]],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [LIFT_NUM] THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
        MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_UNIV]],
      ALL_TAC] THEN
    REWRITE_TAC [EXISTS_DROP, FORALL_DROP, IN_ELIM_THM, LIFT_DROP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^1") THEN
    REWRITE_TAC [CLOSURE_COMPLEMENT, IN_DIFF, IN_UNIV] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [subpath, VECTOR_SUB_RZERO, VECTOR_ADD_LID] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_EQ_CMUL, LIFT_DROP] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, ← GSYM DROP_EQ] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE BINDER_CONV
       [← TAUT (← q r"a /\ ~b ==> c <=> a /\ ~c ==> b")]) THEN
      ASM_REAL_ARITH_TAC,
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"x:real^1")) THEN DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"drop u = &0") THEN
    ASM_REWRITE_TAC [frontier, IN_DIFF, CLOSURE_APPROACHABLE] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [path, pathstart, pathfinish]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_on]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"u:real^1")) THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"lift(max (&0) (drop u - d / &2))")) THEN
    REWRITE_TAC [LIFT_DROP, DIST_REAL, ← GSYM drop] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN MATCH_MP_TAC
     (← MESON [] (← q r"P a ==> dist(a,y) < e ==> ?x. P x /\ dist(x,y) < e")) THEN
    MATCH_MP_TAC (← REWRITE_RULE [SUBSET] INTERIOR_SUBSET) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [LIFT_DROP] THEN ASM_ARITH_TAC)

  let SUBPATH_TO_FRONTIER_STRONG ← prove
   r"!g:real^1->real^N s.
        path g /\ pathstart g IN s /\ ~(pathfinish g IN s)
        ==> ?u. u IN interval[vec 0,vec 1] /\
                 ~(pathfinish(subpath (vec 0) u g) IN interior s) /\
                (u = vec 0 \/
                 (!x. x IN interval[vec 0,vec 1] /\ ~(x = vec 1)
                      ==> (subpath (vec 0) u g x) IN interior s) /\
                 pathfinish(subpath (vec 0) u g) IN closure s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBPATH_TO_FRONTIER_EXPLICIT) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^1") THEN
    REWRITE_TAC [subpath, pathfinish, VECTOR_SUB_RZERO, VECTOR_ADD_LID] THEN
    ASM_CASES_TAC (← q r"u:real^1 = vec 0") THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [DROP_VEC, VECTOR_MUL_LZERO] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_EQ_CMUL, LIFT_DROP] THEN
    X_GEN_TAC (← q r"x:real^1") THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ, DROP_VEC] THEN STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    ASM_SIMP_TAC [DROP_CMUL, REAL_LE_MUL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"u * x < u <=> &0 < u * (&1 - x)")] THEN
    MATCH_MP_TAC REAL_LT_MUL THEN REWRITE_TAC [REAL_SUB_LT] THEN
    ASM_REWRITE_TAC [REAL_LT_LE] THEN
    ASM_REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP, LIFT_NUM])

  let SUBPATH_TO_FRONTIER ← prove
   r"!g:real^1->real^N s.
        path g /\ pathstart g IN s /\ ~(pathfinish g IN s)
        ==> ?u. u IN interval[vec 0,vec 1] /\
                pathfinish(subpath (vec 0) u g) IN frontier s /\
                (path_image(subpath (vec 0) u g) DELETE
                 pathfinish(subpath (vec 0) u g))
                SUBSET interior s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [frontier, IN_DIFF] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SUBPATH_TO_FRONTIER_STRONG) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^1") THEN
    ASM_CASES_TAC (← q r"u:real^1 = vec 0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart]) THEN STRIP_TAC THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
      REWRITE_TAC [subpath, path_image, VECTOR_SUB_REFL, DROP_VEC,
                  VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
      SET_TAC [],
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, path_image, FORALL_IN_IMAGE, IN_DELETE, IMP_CONJ] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, pathfinish] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN ASM_MESON_TAC []])

  let EXISTS_PATH_SUBPATH_TO_FRONTIER ← prove
   r"!g:real^1->real^N s.
        path g /\ pathstart g IN s /\ ~(pathfinish g IN s)
        ==> ?h. path h /\ pathstart h = pathstart g /\
                (path_image h) SUBSET (path_image g) /\
                (path_image h DELETE (pathfinish h)) SUBSET interior s /\
                pathfinish h IN frontier s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP SUBPATH_TO_FRONTIER) THEN
    EXISTS_TAC (← q r"subpath (vec 0) u (g:real^1->real^N)") THEN
    ASM_SIMP_TAC [PATH_SUBPATH, IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL,
                 PATHSTART_SUBPATH, PATH_IMAGE_SUBPATH_SUBSET] THEN
    REWRITE_TAC [pathstart])

  let EXISTS_PATH_SUBPATH_TO_FRONTIER_CLOSED ← prove
   r"!g:real^1->real^N s.
        closed s /\ path g /\ pathstart g IN s /\ ~(pathfinish g IN s)
        ==> ?h. path h /\ pathstart h = pathstart g /\
                (path_image h) SUBSET (path_image g) INTER s /\
                pathfinish h IN frontier s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [SUBSET_INTER] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
     (← q r"(pathfinish h:real^N) INSERT (path_image h DELETE pathfinish h)") THEN
    CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [INSERT_SUBSET]] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [frontier, CLOSURE_EQ, IN_DIFF],
      ASM_MESON_TAC [SUBSET_TRANS, INTERIOR_SUBSET]])

  let PATH_COMBINE ← prove
   r"!u g:real^1->real^N.
        u IN interval[vec 0,vec 1]
        ==> (path g <=>
             path(subpath (vec 0) u g) /\ path(subpath u (vec 1) g))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [PATH_SUBPATH, ENDS_IN_UNIT_INTERVAL] THEN
    ASM_CASES_TAC (← q r"u:real^1 = vec 0") THEN ASM_SIMP_TAC [SUBPATH_TRIVIAL] THEN
    ASM_CASES_TAC (← q r"u:real^1 = vec 1") THEN ASM_SIMP_TAC [SUBPATH_TRIVIAL] THEN
    REWRITE_TAC [path, subpath, VECTOR_ADD_LID, VECTOR_SUB_RZERO] THEN
    STRIP_TAC THEN SUBGOAL_THEN
     (← q r"interval[vec 0:real^1,vec 1] = interval[vec 0,u] UNION interval[u,vec 1]")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
      REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1] THEN REAL_ARITH_TAC,
      MATCH_MP_TAC CONTINUOUS_ON_UNION THEN REWRITE_TAC [CLOSED_INTERVAL] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"(g:real^1->real^N) = (\x. g(drop u % x)) o (\x. inv(drop u) % x)")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM, VECTOR_MUL_ASSOC] THEN
          ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID,
                       ← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP],
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [LINEAR_SCALING, LINEAR_CONTINUOUS_ON] THEN
          ONCE_REWRITE_TAC [← VECTOR_ARITH
           (← q r"inv u % x:real^N = inv u % x + vec 0")] THEN
          REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1,
                          ← GSYM DROP_EQ, DROP_VEC]) THEN
          ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC, ← GSYM REAL_NOT_LE,
                          REAL_LE_INV_EQ] THEN
          REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          MATCH_MP_TAC (← SET_RULE (← q r"s = t ==> s SUBSET t")) THEN
          AP_TERM_TAC THEN REWRITE_TAC [CONS_11, PAIR_EQ] THEN
          ASM_SIMP_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC, REAL_MUL_LINV]],
        SUBGOAL_THEN
         (← q r"(g:real^1->real^N) = (\x. g(u + drop(vec 1 - u) % x)) o
                               (\x. inv(drop(vec 1 - u)) % (x - u))")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM, VECTOR_MUL_ASSOC] THEN
          ASM_SIMP_TAC [REAL_MUL_RINV, VECTOR_MUL_LID, VECTOR_SUB_EQ,
                       ← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP] THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"u + x - u:real^N = x")],
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_SUB,
                   CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          MATCH_MP_TAC (← SET_RULE (← q r"s = t ==> s SUBSET t")) THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"c % (x - u):real^N = c % x + --(c % u)")] THEN
          REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
          REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1,
                          ← GSYM DROP_EQ, DROP_VEC]) THEN
          ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC, ← GSYM REAL_NOT_LE,
                          REAL_LE_INV_EQ, DROP_SUB, REAL_SUB_LE] THEN
          AP_TERM_TAC THEN REWRITE_TAC [CONS_11, PAIR_EQ] THEN
          REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC, DROP_ADD, DROP_NEG] THEN
          REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => REAL_FIELD t)]]])

  return { EXISTS_DOUBLE_ARC, SUBPATH_TO_FRONTIER_EXPLICIT, SUBPATH_TO_FRONTIER_STRONG,
           SUBPATH_TO_FRONTIER, EXISTS_PATH_SUBPATH_TO_FRONTIER,
           EXISTS_PATH_SUBPATH_TO_FRONTIER_CLOSED, PATH_COMBINE }

/- ------------------------------------------------------------------------- -/
/- Special case of straight-line paths; bounding a point away from a path.   -/
/- (paths.ml 1997-2166)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTI where
  linepath : thm
  LINEPATH_TRANSLATION : thm
  LINEPATH_LINEAR_IMAGE : thm
  PATHSTART_LINEPATH : thm
  PATHFINISH_LINEPATH : thm
  CONTINUOUS_LINEPATH_AT : thm
  CONTINUOUS_ON_LINEPATH : thm
  PATH_LINEPATH : thm
  PATH_IMAGE_LINEPATH : thm
  REVERSEPATH_LINEPATH : thm
  ARC_LINEPATH : thm
  SIMPLE_PATH_LINEPATH : thm
  SIMPLE_PATH_LINEPATH_EQ : thm
  ARC_LINEPATH_EQ : thm
  LINEPATH_REFL : thm
  PATH_IMAGE_CONST : thm
  SHIFTPATH_TRIVIAL : thm
  SUBPATH_REFL : thm
  SEGMENT_TO_FRONTIER : thm
  NOT_ON_PATH_BALL : thm
  NOT_ON_PATH_CBALL : thm
  deriving Inhabited

@[nospecialize]
def setupPTI [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BE : PTE) (BF : PTF)
    (BH : PTH) : ExceptT String IO PTI := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { ARITH, COND_ID, CONTRAPOS_THM, DIMINDEX_1, EXTENSION, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ_ALT, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_NOT_LE, REAL_SUB_0, SUBSET, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_POS_LT, .. } := D.cvx.vec1
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, EXISTS_DROP, EXISTS_LIFT, FORALL_1,
        IN_INTERVAL, LIFT_DROP, LINEAR_ADD, LINEAR_CMUL, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RDISTRIB, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, VECTOR_SUB_REFL,
        VECTOR_SUB_RZERO, VEC_COMPONENT, drop, .. } := D.cvx.vec4
  let { COMPACT_IMP_CLOSED, CONTINUOUS_ADD, CONTINUOUS_AT_ID,
        CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_VMUL, DISTANCE_ATTAINS_INF, .. } := D.cvx.top3
  let { IN_BALL, IN_CBALL, IN_INTERVAL_1, IN_SEGMENT, .. } := D.cvx.top4
  let { SEGMENT_REFL, frontier, segment, .. } := D.cvx.top5
  let { FRONTIER_INTERIOR_SUBSET, .. } := D.ptop3
  let { INTERIOR_INTERIOR, .. } := D.ptop4
  let { path, pathstart, pathfinish, path_image, reversepath, simple_path, arc, .. } := BA
  let { ARC_IMP_SIMPLE_PATH, PATH_IMAGE_NONEMPTY, COMPACT_PATH_IMAGE, .. } := BB
  let { shiftpath, .. } := BE
  let { subpath, .. } := BF
  let { SUBPATH_TO_FRONTIER, .. } := BH
  -- @@SCOPE END

  let linepath ← new_definition
   r"linepath(a,b) = \x. (&1 - drop x) % a + drop x % b"

  let LINEPATH_TRANSLATION ← prove
   r"!a b c. linepath(a + b,a + c) = (\x. a + x) o linepath(b,c)"
   (REWRITE_TAC [linepath, o_THM, FUN_EQ_THM] THEN VECTOR_ARITH_TAC)

  add_translation_invariants [LINEPATH_TRANSLATION]

  let LINEPATH_LINEAR_IMAGE ← prove
   r"!f. linear f ==> !b c. linepath(f b,f c) = f o linepath(b,c)"
   (REWRITE_TAC [linepath, o_THM, FUN_EQ_THM] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP LINEAR_ADD) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP LINEAR_CMUL) THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  add_linear_invariants [LINEPATH_LINEAR_IMAGE]

  let PATHSTART_LINEPATH ← prove
   r"!a b. pathstart(linepath(a,b)) = a"
   (REWRITE_TAC [linepath, pathstart, DROP_VEC] THEN VECTOR_ARITH_TAC)

  let PATHFINISH_LINEPATH ← prove
   r"!a b. pathfinish(linepath(a,b)) = b"
   (REWRITE_TAC [linepath, pathfinish, DROP_VEC] THEN VECTOR_ARITH_TAC)

  let CONTINUOUS_LINEPATH_AT ← prove
   r"!a b x. linepath(a,b) continuous (at x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [linepath] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - u) % x + y = x + u % --x + y")] THEN
    MATCH_MP_TAC CONTINUOUS_ADD THEN REWRITE_TAC [CONTINUOUS_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC CONTINUOUS_VMUL THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_AT_ID])

  let CONTINUOUS_ON_LINEPATH ← prove
   r"!a b s. linepath(a,b) continuous_on s"
   (MESON_TAC [CONTINUOUS_AT_IMP_CONTINUOUS_ON, CONTINUOUS_LINEPATH_AT])

  let PATH_LINEPATH ← prove
   r"!a b. path(linepath(a,b))"
   (REWRITE_TAC [path, CONTINUOUS_ON_LINEPATH])

  let PATH_IMAGE_LINEPATH ← prove
   r"!a b. path_image(linepath (a,b)) = segment[a,b]"
   (REWRITE_TAC [segment, path_image, linepath] THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, IN_INTERVAL] THEN
    SIMP_TAC [DIMINDEX_1, FORALL_1, VEC_COMPONENT, ARITH] THEN
    REWRITE_TAC [EXISTS_LIFT, ← GSYM drop, LIFT_DROP] THEN MESON_TAC [])

  let REVERSEPATH_LINEPATH ← prove
   r"!a b. reversepath(linepath(a,b)) = linepath(b,a)"
   (REWRITE_TAC [reversepath, linepath, DROP_SUB, DROP_VEC, FUN_EQ_THM] THEN
    VECTOR_ARITH_TAC)

  let ARC_LINEPATH ← prove
   r"!a b. ~(a = b) ==> arc(linepath(a,b))"
   (REWRITE_TAC [arc, PATH_LINEPATH] THEN REWRITE_TAC [linepath] THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"(&1 - x) % a + x % b:real^N = (&1 - y) % a + y % b <=>
      (x - y) % (a - b) = vec 0")] THEN
    SIMP_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, DROP_EQ, REAL_SUB_0])

  let SIMPLE_PATH_LINEPATH ← prove
   r"!a b. ~(a = b) ==> simple_path(linepath(a,b))"
   (MESON_TAC [ARC_IMP_SIMPLE_PATH, ARC_LINEPATH])

  let SIMPLE_PATH_LINEPATH_EQ ← prove
   r"!a b:real^N. simple_path(linepath(a,b)) <=> ~(a = b)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [SIMPLE_PATH_LINEPATH] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [simple_path] THEN
    DISCH_THEN SUBST1_TAC THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [linepath, ← GSYM VECTOR_ADD_RDISTRIB] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&0)", ← q r"lift(&1 / &2)"]) THEN
    REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM DROP_EQ, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let ARC_LINEPATH_EQ ← prove
   r"!a b. arc(linepath(a,b)) <=> ~(a = b)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [ARC_LINEPATH] THEN
    MESON_TAC [SIMPLE_PATH_LINEPATH_EQ, ARC_IMP_SIMPLE_PATH])

  let LINEPATH_REFL ← prove
   r"!a. linepath(a,a) = \x. a"
   (REWRITE_TAC [linepath, ← VECTOR_ARITH (← q r"(&1 - u) % x + u % x:real^N = x")])

  let PATH_IMAGE_CONST ← prove
   r"!a:real^N. path_image (\x. a) = {a}"
   (REWRITE_TAC [← GSYM LINEPATH_REFL, PATH_IMAGE_LINEPATH] THEN
    REWRITE_TAC [SEGMENT_REFL])

  let SHIFTPATH_TRIVIAL ← prove
   r"!t a. shiftpath t (linepath(a,a)) = linepath(a,a)"
   (REWRITE_TAC [shiftpath, LINEPATH_REFL, COND_ID])

  let SUBPATH_REFL ← prove
   r"!g a. subpath a a g = linepath(g a,g a)"
   (REWRITE_TAC [subpath, linepath, VECTOR_SUB_REFL, DROP_VEC, VECTOR_MUL_LZERO,
                FUN_EQ_THM, VECTOR_ADD_RID] THEN
    VECTOR_ARITH_TAC)

  let SEGMENT_TO_FRONTIER ← prove
   r"!s a b:real^N.
        a IN interior s /\ ~(b IN interior s)
        ==> ?c. c IN segment[a,b] /\ ~(c = a) /\ c IN frontier s /\
                segment(a,c) SUBSET interior s"
   (GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x. R x ==> Q x) /\ (?x. P x /\ R x /\ S x)
      ==> ?x. P x /\ Q x /\ R x /\ S x")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [frontier, IN_DIFF], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"linepath(vec 0:real^N,b)", ← q r"interior s:real^N->bool"]
      SUBPATH_TO_FRONTIER) THEN
    ASM_REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    REWRITE_TAC [PATH_IMAGE_LINEPATH, INTERIOR_INTERIOR] THEN
    REWRITE_TAC [subpath, linepath, VECTOR_ADD_LID, VECTOR_SUB_RZERO,
                VECTOR_MUL_RZERO, pathstart, pathfinish] THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM EXISTS_DROP, DROP_VEC] THEN
    REWRITE_TAC [DROP_CMUL, path_image, DROP_VEC, REAL_MUL_RID] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"u % b:real^N") THEN
    REWRITE_TAC [IN_SEGMENT, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
      [ASM_MESON_TAC [FRONTIER_INTERIOR_SUBSET, SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
     SUBSET_TRANS)) THEN
    ONCE_REWRITE_TAC [segment] THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET t ==> s DIFF {a,b} SUBSET t DELETE b")) THEN
    REWRITE_TAC [segment, SUBSET, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"v:real") THEN STRIP_TAC THEN
    REWRITE_TAC [IN_IMAGE, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
    EXISTS_TAC (← q r"lift v") THEN REWRITE_TAC [IN_INTERVAL_1] THEN
    ASM_REWRITE_TAC [LIFT_DROP, DROP_VEC, VECTOR_MUL_ASSOC] THEN
    REWRITE_TAC [REAL_MUL_SYM])

  /- ----------------------------------------------------------------------- -/
  /- Bounding a point away from a path.                                      -/
  /- ----------------------------------------------------------------------- -/

  let NOT_ON_PATH_BALL ← prove
   r"!g z:real^N.
        path g /\ ~(z IN path_image g)
        ==> ?e. &0 < e /\ ball(z,e) INTER (path_image g) = {}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"path_image g:real^N->bool", ← q r"z:real^N"]
       DISTANCE_ATTAINS_INF) THEN
    REWRITE_TAC [PATH_IMAGE_NONEMPTY] THEN
    ASM_SIMP_TAC [COMPACT_PATH_IMAGE, COMPACT_IMP_CLOSED] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"dist(z:real^N,a)") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIST_POS_LT], ALL_TAC] THEN
    REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_BALL, IN_INTER] THEN
    ASM_MESON_TAC [REAL_NOT_LE])

  let NOT_ON_PATH_CBALL ← prove
   r"!g z:real^N.
        path g /\ ~(z IN path_image g)
        ==> ?e. &0 < e /\ cball(z,e) INTER (path_image g) = {}"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP NOT_ON_PATH_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / &2") THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s INTER u = {} ==> t SUBSET s ==> t INTER u = {}"))) THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN
    UNDISCH_TAC (← q r"&0 < e") THEN REAL_ARITH_TAC)

  return { linepath, LINEPATH_TRANSLATION, LINEPATH_LINEAR_IMAGE, PATHSTART_LINEPATH,
           PATHFINISH_LINEPATH, CONTINUOUS_LINEPATH_AT, CONTINUOUS_ON_LINEPATH, PATH_LINEPATH,
           PATH_IMAGE_LINEPATH, REVERSEPATH_LINEPATH, ARC_LINEPATH, SIMPLE_PATH_LINEPATH,
           SIMPLE_PATH_LINEPATH_EQ, ARC_LINEPATH_EQ, LINEPATH_REFL, PATH_IMAGE_CONST,
           SHIFTPATH_TRIVIAL, SUBPATH_REFL, SEGMENT_TO_FRONTIER, NOT_ON_PATH_BALL,
           NOT_ON_PATH_CBALL }

/- ------------------------------------------------------------------------- -/
/- Homeomorphisms of arc images.  (paths.ml 2167-2494)                       -/
/- ------------------------------------------------------------------------- -/

structure PTJ where
  HOMEOMORPHISM_ARC : thm
  HOMEOMORPHIC_ARC_IMAGE_INTERVAL : thm
  HOMEOMORPHIC_ARC_IMAGES : thm
  HOMEOMORPHIC_ARC_IMAGE_SEGMENT : thm
  HOMEOMORPHIC_ARC_IMAGE_SEGMENT_EQ : thm
  CONNECTED_SUBSET_PATH_IMAGE_ARC : thm
  ARC_IMAGE_UNIQUE : thm
  CONNECTED_SUBSET_ARC_PAIR : thm
  HOMEOMORPHIC_SIMPLE_PATH_IMAGES : thm
  HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ : thm
  HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE : thm
  deriving Inhabited

@[nospecialize]
def setupPTJ [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BD : PTD)
    (BF : PTF) (BI : PTI) : ExceptT String IO PTJ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        INT_REDUCE_CONV, .. } := D.cvx
  let { ARITH, CARD_CLAUSES, CONJ_ASSOC, DE_MORGAN_THM, DIMINDEX_2, EQ_TRANS,
        EXISTS_IN_IMAGE, FINITE_EMPTY, FINITE_INSERT, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, INSERT_AC, IN_DIFF, .. } := D.cvx.core2
  let { IN_IMAGE, IN_INSERT, IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL,
        NOT_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LT_01, REAL_LT_IMP_NZ, .. } := D.cvx.core4
  let { SUBSET, SUBSET_ANTISYM_EQ, .. } := D.cvx.core5
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { BASIS_COMPONENT, BASIS_INJ_EQ, BASIS_NONZERO, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } := D.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VEC_COMPONENT, independent, .. } :=
    D.cvx.vec4
  let { BOUNDED_CBALL, BOUNDED_EMPTY, BOUNDED_INSERT, .. } := D.cvx.top1
  let { COMPACT_INTERVAL, CONNECTED_CONTINUOUS_IMAGE, CONNECTED_OPEN_IN, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_COMPACT, INTERVAL_NE_EMPTY_1,
        INTERVAL_SUBSET_IS_INTERVAL, IN_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_REFL, SEGMENT_SYM, UNIT_INTERVAL_NONEMPTY, homeomorphic, homeomorphism, .. } :=
    D.cvx.top5
  let { DELETE_INSERT, EMPTY_DELETE, .. } := D.pses1
  let { UNION_OVER_INTER, .. } := D.pses2
  let { DEPENDENT_2, ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CLOSED_UNION, .. } := D.ptop1
  let { CONTINUOUS_IMP_QUOTIENT_MAP_EXPLICIT, .. } := D.ptop2
  let { LIFT_TO_QUOTIENT_SPACE_UNIQUE, .. } := D.ptop4
  let { OPEN_IN_DIFF_CLOSED, .. } := D.ptop5
  let { AFF_DIM_AFFINE_INDEPENDENT, AFF_DIM_CBALL, AFF_DIM_CONVEX_HULL,
        BOUNDED_CONVEX_HULL_EQ, COLLINEAR_3_EQ_AFFINE_DEPENDENT, CONVEX_CBALL, .. } := D.pcvx1
  let { CONVEX_CONVEX_HULL, HOMEOMORPHIC_CLOSED_INTERVALS,
        HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS, INDEPENDENT_IMP_AFFINE_DEPENDENT_0,
        INTER_SEGMENT, IS_INTERVAL_CONNECTED_1, RELATIVE_FRONTIER_CBALL,
        RELATIVE_FRONTIER_OF_CONVEX_HULL, SEGMENT_CONVEX_HULL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, simple_path, arc,
        SIMPLE_PATH_CONTINUOUS_IMAGE, ARC_CONTINUOUS_IMAGE, .. } := BA
  let { ARC_IMP_PATH, SIMPLE_PATH_IMP_PATH, PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE,
        CONNECTED_PATH_IMAGE, CLOSED_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
        PATH_IMAGE_COMPOSE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_IMAGE_JOIN, ARC_REVERSEPATH_EQ, .. } := BC
  let { SIMPLE_PATH_JOIN_LOOP_EQ, ARC_JOIN_EQ, .. } := BD
  let { PATH_IMAGE_SUBPATH, PATH_IMAGE_SUBPATH_COMBINE, PATH_SUBPATH, .. } := BF
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH, ARC_LINEPATH_EQ, .. } := BI
  -- @@SCOPE END

  let HOMEOMORPHISM_ARC ← prove
   r"!g:real^1->real^N.
     arc g ==> ?h. homeomorphism (interval[vec 0,vec 1],path_image g) (g,h)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
    ASM_REWRITE_TAC [path_image, COMPACT_INTERVAL, ← GSYM path, ← GSYM arc])

  let HOMEOMORPHIC_ARC_IMAGE_INTERVAL ← prove
   r"!g:real^1->real^N a b:real^1.
      arc g /\ drop a < drop b ==> (path_image g) homeomorphic interval[a,b]"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC HOMEOMORPHIC_TRANS (← q r"interval[vec 0:real^1,vec 1]") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
      EXISTS_TAC (← q r"g:real^1->real^N") THEN ASM_SIMP_TAC [HOMEOMORPHISM_ARC],
      MATCH_MP_TAC HOMEOMORPHIC_CLOSED_INTERVALS THEN
      ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1, DROP_VEC, REAL_LT_01]])

  let HOMEOMORPHIC_ARC_IMAGES ← prove
   r"!g:real^1->real^M h:real^1->real^N.
        arc g /\ arc h ==> (path_image g) homeomorphic (path_image h)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC HOMEOMORPHIC_TRANS (← q r"interval[vec 0:real^1,vec 1]") THEN
    CONJ_TAC THENL [ALL_TAC, ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM]] THEN
    MATCH_MP_TAC HOMEOMORPHIC_ARC_IMAGE_INTERVAL THEN
    ASM_REWRITE_TAC [DROP_VEC, REAL_LT_01])

  let HOMEOMORPHIC_ARC_IMAGE_SEGMENT ← prove
   r"!g:real^1->real^N a b:real^M.
        arc g /\ ~(a = b) ==> (path_image g) homeomorphic segment[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM PATH_IMAGE_LINEPATH] THEN
    MATCH_MP_TAC HOMEOMORPHIC_ARC_IMAGES THEN
    ASM_REWRITE_TAC [ARC_LINEPATH_EQ])

  let HOMEOMORPHIC_ARC_IMAGE_SEGMENT_EQ ← prove
   r"!s:real^N->bool a b:real^M.
        ~(a = b)
        ==> (s homeomorphic segment[a,b] <=>
             ?g. arc g /\ path_image g = s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [HOMEOMORPHIC_ARC_IMAGE_SEGMENT]] THEN
    REWRITE_TAC [homeomorphic, homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^M", ← q r"g:real^M->real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"(g:real^M->real^N) o linepath(a,b)") THEN
    ASM_REWRITE_TAC [PATH_IMAGE_COMPOSE, PATH_IMAGE_LINEPATH] THEN
    MATCH_MP_TAC ARC_CONTINUOUS_IMAGE THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, ARC_LINEPATH_EQ] THEN ASM SET_TAC [])

  let CONNECTED_SUBSET_PATH_IMAGE_ARC ← prove
   r"!s g:real^1->real^N.
        arc g /\ connected s /\
        s SUBSET path_image g /\ pathstart g IN s /\ pathfinish g IN s
        ==> s = path_image g"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHISM_ARC) THEN
    REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^N->real^1") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:real^N->real^1) (path_image g) SUBSET IMAGE h s")
    MP_TAC THENL [ASM_REWRITE_TAC [], ASM SET_TAC []] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) INTERVAL_SUBSET_IS_INTERVAL o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [IS_INTERVAL_CONNECTED_1] THEN
      MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      REWRITE_TAC [UNIT_INTERVAL_NONEMPTY] THEN DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN
     (← q r"vec 0 IN interval[vec 0:real^1,vec 1] /\
      vec 1 IN interval[vec 0:real^1,vec 1]")
    MP_TAC THENL [REWRITE_TAC [ENDS_IN_UNIT_INTERVAL], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish, path_image]) THEN
    ASM SET_TAC [])

  let ARC_IMAGE_UNIQUE ← prove
   r"!g h:real^1->real^N.
        path g /\ arc h /\ path_image g SUBSET path_image h /\
        {pathstart g,pathfinish g} = {pathstart h,pathfinish h}
        ==> path_image g = path_image h"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"{a,b} = {c,d} ==> a = c /\ b = d \/ a = d /\ b = c"))) THEN
    STRIP_TAC THENL
     [ALL_TAC, GEN_REWRITE_TAC RAND_CONV [← GSYM PATH_IMAGE_REVERSEPATH]] THEN
    MATCH_MP_TAC CONNECTED_SUBSET_PATH_IMAGE_ARC THEN
    ASM_REWRITE_TAC [ARC_REVERSEPATH_EQ, PATH_IMAGE_REVERSEPATH] THEN
    REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH] THEN
    ASM_MESON_TAC [CONNECTED_PATH_IMAGE, ARC_IMP_PATH,
                  PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE])

  let CONNECTED_SUBSET_ARC_PAIR ← prove
   r"!g h s:real^N->bool.
        arc g /\ arc h /\
        pathstart g = pathstart h /\ pathfinish g = pathfinish h /\
        path_image g INTER path_image h = {pathstart g,pathfinish g} /\
        connected s /\
        s SUBSET path_image g UNION path_image h /\
        pathstart g IN s /\ pathfinish g IN s
        ==> path_image g SUBSET s \/ path_image h SUBSET s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"((?x. x IN t /\ ~(x IN s)) /\ (?y. y IN u /\ ~(y IN s)) ==> F)
      ==> t SUBSET s \/ u SUBSET s")) THEN
    REWRITE_TAC [path_image, EXISTS_IN_IMAGE] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"p:real^1") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"q:real^1") STRIP_ASSUME_TAC)) THEN
    UNDISCH_TAC (← q r"connected(s:real^N->bool)") THEN
    REWRITE_TAC [CONNECTED_OPEN_IN] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"s DIFF (path_image (subpath p (vec 1) g) UNION
               path_image (subpath q (vec 1) h)):real^N->bool",
      ← q r"s DIFF (path_image (subpath (vec 0) p g) UNION
               path_image (subpath (vec 0) q h)):real^N->bool"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_DIFF_CLOSED THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC CLOSED_UNION THEN CONJ_TAC THEN
      MATCH_MP_TAC CLOSED_PATH_IMAGE THEN MATCH_MP_TAC PATH_SUBPATH THEN
      ASM_SIMP_TAC [ARC_IMP_PATH, ENDS_IN_UNIT_INTERVAL],
      MATCH_MP_TAC OPEN_IN_DIFF_CLOSED THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC CLOSED_UNION THEN CONJ_TAC THEN
      MATCH_MP_TAC CLOSED_PATH_IMAGE THEN MATCH_MP_TAC PATH_SUBPATH THEN
      ASM_SIMP_TAC [ARC_IMP_PATH, ENDS_IN_UNIT_INTERVAL],
      REWRITE_TAC [SUBSET, IN_UNION, IN_DIFF] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ← GSYM DE_MORGAN_THM] THEN
      DISCH_THEN (REPEAT_TCL (HolCore.Tactics.STRIP_THM_THEN HolBase.B) MP_TAC) THEN
      REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^1") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      X_GEN_TAC (← q r"b:real^1") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THENL
       [UNDISCH_TAC (← q r"arc(g:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"] o CONJUNCT2) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
        ASM_CASES_TAC (← q r"a:real^1 = p") THENL [ASM SET_TAC [], ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
        REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE f s INTER IMAGE g s = a
          ==> !x y. x IN s /\ y IN s /\ f x = g y ==> f(x) IN a"))) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"b:real^1", ← q r"a:real^1"]) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
          ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
          REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM]] THEN
        REPEAT STRIP_TAC THENL
         [UNDISCH_TAC (← q r"arc(g:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"b:real^1", ← q r"vec 0:real^1"] o CONJUNCT2),
          UNDISCH_TAC (← q r"arc(h:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
          DISCH_THEN (MP_TAC o SPECL
           [← q r"a:real^1", ← q r"vec 1:real^1"] o CONJUNCT2)],
        RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE f s INTER IMAGE g s = a
          ==> !x y. x IN s /\ y IN s /\ f x = g y ==> f(x) IN a"))) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
          ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
          REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM]] THEN
        REPEAT STRIP_TAC THENL
         [UNDISCH_TAC (← q r"arc(h:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"b:real^1", ← q r"vec 0:real^1"] o CONJUNCT2),
          UNDISCH_TAC (← q r"arc(g:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
          DISCH_THEN (MP_TAC o SPECL
           [← q r"a:real^1", ← q r"vec 1:real^1"] o CONJUNCT2)],
        UNDISCH_TAC (← q r"arc(h:real^1->real^N)") THEN REWRITE_TAC [arc] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"] o CONJUNCT2) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
        ASM_CASES_TAC (← q r"a:real^1 = q") THENL [ASM SET_TAC [], ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
        REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC],
      MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"p:real^1"]
          PATH_IMAGE_SUBPATH_COMBINE) THEN
      MP_TAC (← ISPECL [← q r"h:real^1->real^N", ← q r"q:real^1"]
          PATH_IMAGE_SUBPATH_COMBINE) THEN
      ASM_SIMP_TAC [ARC_IMP_PATH] THEN ASM SET_TAC [],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"pathstart g:real^N") THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ARC_IMP_PATH] THEN
      CONJ_TAC THENL
       [UNDISCH_TAC (← q r"arc(g:real^1->real^N)"),
        UNDISCH_TAC (← q r"arc(h:real^1->real^N)")] THEN
      REWRITE_TAC [arc, path_image, IN_IMAGE, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"a:real^1") THEN
      DISCH_THEN (fun th => tactic_of do
        pure (STRIP_TAC THEN MP_TAC (← SPEC (← q r"vec 0:real^1") th))) THEN
      ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, NOT_IMP],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"pathfinish g:real^N") THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH, ARC_IMP_PATH] THEN
      CONJ_TAC THENL
       [UNDISCH_TAC (← q r"arc(g:real^1->real^N)"),
        UNDISCH_TAC (← q r"arc(h:real^1->real^N)")] THEN
      REWRITE_TAC [arc, path_image, IN_IMAGE, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"a:real^1") THEN
      DISCH_THEN (fun th => tactic_of do
        pure (STRIP_TAC THEN MP_TAC (← SPEC (← q r"vec 1:real^1") th))) THEN
      ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, NOT_IMP]] THEN
    (REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, NOT_IMP] THEN REPEAT CONJ_TAC THENL
        [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
         ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
         ASM_MESON_TAC [pathstart, pathfinish],
         DISCH_THEN SUBST_ALL_TAC THEN
         RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
         ASM_MESON_TAC [REAL_LE_ANTISYM, LIFT_EQ, LIFT_NUM, LIFT_DROP,
                       pathstart, pathfinish]]))

  let HOMEOMORPHIC_SIMPLE_PATH_IMAGES ← prove
   r"!g:real^1->real^M h:real^1->real^N.
        simple_path g /\ pathfinish g = pathstart g /\
        simple_path h /\ pathfinish h = pathstart h
        ==> (path_image g) homeomorphic (path_image h)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->real^M", ← q r"h:real^1->real^N", ← q r"interval[vec 0:real^1,vec 1]",
      ← q r"path_image g:real^M->bool", ← q r"path_image h:real^N->bool"]
     LIFT_TO_QUOTIENT_SPACE_UNIQUE) THEN
    REWRITE_TAC [path_image, CONJ_ASSOC] THEN DISCH_THEN MATCH_MP_TAC THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_IMP_QUOTIENT_MAP_EXPLICIT THEN
      ASM_SIMP_TAC [← GSYM path, COMPACT_INTERVAL, SIMPLE_PATH_IMP_PATH],
      RULE_ASSUM_TAC (REWRITE_RULE [simple_path, pathstart, pathfinish]) THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"x:real^1", ← q r"y:real^1"] o CONJUNCT2)) THEN
      ASM_MESON_TAC []])

  let HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ ← prove
   r"!s:real^N->bool a:real^2 r.
        &0 < r
        ==> (s homeomorphic sphere(a,r) <=>
             ?g. simple_path g /\ pathfinish g = pathstart g /\
                 path_image g = s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?p. simple_path p /\ pathfinish p = pathstart p /\
          (path_image p:real^2->bool) homeomorphic(sphere(a:real^2,r))")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC
       (← q r"linepath(vec 0:real^2,basis 1) ++ linepath(basis 1,basis 2) ++
        linepath(basis 2,vec 0)") THEN
      SUBGOAL_THEN
       (← q r"~(basis 2:real^2 = basis 1) /\
        ~(basis 1:real^2 = vec 0) /\
        ~(basis 2:real^2 = vec 0)")
      STRIP_ASSUME_TAC THENL
       [SIMP_TAC [BASIS_INJ_EQ, BASIS_NONZERO, DIMINDEX_2, ARITH], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~affine_dependent {vec 0:real^2,basis 1,basis 2}")
      ASSUME_TAC THENL
       [MATCH_MP_TAC INDEPENDENT_IMP_AFFINE_DEPENDENT_0 THEN
        ASM_REWRITE_TAC [independent, DEPENDENT_2] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
         pure (MP_TAC (← AP_TERM (← q r"\x:real^2. x$1") th) THEN
               MP_TAC (← AP_TERM (← q r"\x:real^2. x$2") th))) THEN
        REWRITE_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
        SIMP_TAC [BASIS_COMPONENT, VEC_COMPONENT, DIMINDEX_2, ARITH] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SIMP_TAC [SIMPLE_PATH_JOIN_LOOP_EQ, ARC_JOIN_EQ,
               PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_JOIN,
               PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      ASM_REWRITE_TAC [ARC_LINEPATH_EQ, PATH_IMAGE_LINEPATH] THEN
      REWRITE_TAC [UNION_OVER_INTER, UNION_SUBSET, CONJ_ASSOC] THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC (fun c => RAND_CONV (ONCE_DEPTH_CONV c)) [SEGMENT_SYM] THEN
        REPEAT CONJ_TAC THEN
        W (MP_TAC o PART_MATCH (lhand o rand) INTER_SEGMENT o lhand o snd) THEN
        (ANTS_TAC THENL [DISJ2_TAC, SET_TAC []]) THEN
        ASM_REWRITE_TAC [COLLINEAR_3_EQ_AFFINE_DEPENDENT] THEN
        ASM_MESON_TAC [INSERT_AC],
        TRANS_TAC HOMEOMORPHIC_TRANS
         (← q r"relative_frontier(convex hull {vec 0:real^2,basis 1,basis 2})") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← MESON [HOMEOMORPHIC_REFL]
           (← q r"s = t ==> s homeomorphic t")) THEN
          ASM_SIMP_TAC [RELATIVE_FRONTIER_OF_CONVEX_HULL] THEN
          REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {a,b,c}} = {f a,f b,f c}")] THEN
          ASM_REWRITE_TAC [DELETE_INSERT, ← GSYM SEGMENT_CONVEX_HULL,
                          EMPTY_DELETE, SEGMENT_SYM] THEN SET_TAC [],
          MP_TAC (← ISPECL [← q r"convex hull {vec 0:real^2,basis 1,basis 2}",
                          ← q r"cball(a:real^2,r)"]
            HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS) THEN
          ASM_REWRITE_TAC [CONVEX_CBALL, BOUNDED_CBALL, CONVEX_CONVEX_HULL] THEN
          ASM_REWRITE_TAC [CONVEX_CONVEX_HULL, BOUNDED_CONVEX_HULL_EQ] THEN
          REWRITE_TAC [AFF_DIM_CONVEX_HULL, BOUNDED_INSERT, BOUNDED_EMPTY] THEN
          ASM_SIMP_TAC [RELATIVE_FRONTIER_CBALL, REAL_LT_IMP_NZ] THEN
          DISCH_THEN MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [AFF_DIM_CBALL, DIMINDEX_2] THEN
          ASM_SIMP_TAC [AFF_DIM_AFFINE_INDEPENDENT] THEN
          SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
          ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, ARITH] THEN
          CONV_TAC INT_REDUCE_CONV]],
      TRANS_TAC EQ_TRANS
       (← q r"(s:real^N->bool) homeomorphic (path_image p:real^2->bool)") THEN
      CONJ_TAC THENL
       [EQ_TAC THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMEOMORPHIC_TRANS) THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      EQ_TAC THENL
       [REWRITE_TAC [homeomorphic, homeomorphism, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"g:real^N->real^2", ← q r"f:real^2->real^N"] THEN
        STRIP_TAC THEN
        EXISTS_TAC (← q r"(f:real^2->real^N) o (p:real^1->real^2)") THEN
        REWRITE_TAC [PATHFINISH_COMPOSE, PATHSTART_COMPOSE] THEN
        ASM_REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN
        MATCH_MP_TAC SIMPLE_PATH_CONTINUOUS_IMAGE THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N")
          (STRIP_ASSUME_TAC o GSYM)) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMEOMORPHIC_SIMPLE_PATH_IMAGES THEN
        ASM_REWRITE_TAC []]])

  let HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE ← prove
   r"!g:real^1->real^N a:real^2 r.
        simple_path g /\ pathfinish g = pathstart g /\ &0 < r
        ==> (path_image g) homeomorphic sphere(a,r)"
   (MESON_TAC [HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ])

  return { HOMEOMORPHISM_ARC, HOMEOMORPHIC_ARC_IMAGE_INTERVAL, HOMEOMORPHIC_ARC_IMAGES,
           HOMEOMORPHIC_ARC_IMAGE_SEGMENT, HOMEOMORPHIC_ARC_IMAGE_SEGMENT_EQ,
           CONNECTED_SUBSET_PATH_IMAGE_ARC, ARC_IMAGE_UNIQUE, CONNECTED_SUBSET_ARC_PAIR,
           HOMEOMORPHIC_SIMPLE_PATH_IMAGES, HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ,
           HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE }

/- ------------------------------------------------------------------------- -/
/- Path component, as a "joinability" relation and as a set; path            -/
/- connectedness of a space; general "locally connected implies connected"   -/
/- type results.  (paths.ml 2495-2868)                                       -/
/- ------------------------------------------------------------------------- -/

structure PTK where
  path_component : thm
  path_components : thm
  PATH_COMPONENT_OF_EUCLIDEAN : thm
  PATH_COMPONENTS_OF_EUCLIDEAN : thm
  PATH_COMPONENT_IN : thm
  PATH_COMPONENT_REFL_EQ : thm
  PATH_COMPONENT_REFL : thm
  PATH_COMPONENT_SYM_EQ : thm
  PATH_COMPONENT_SYM : thm
  PATH_COMPONENT_TRANS : thm
  PATH_COMPONENT_OF_SUBSET : thm
  PATH_COMPONENT_SET : thm
  PATH_COMPONENT_SUBSET : thm
  PATH_COMPONENT_EQ_EMPTY : thm
  PATH_COMPONENT_EMPTY : thm
  UNIONS_PATH_COMPONENT : thm
  PATH_COMPONENT_TRANSLATION : thm
  PATH_COMPONENT_LINEAR_IMAGE : thm
  path_connected : thm
  PATH_CONNECTED_IFF_PATH_COMPONENT : thm
  PATH_CONNECTED_IN_EUCLIDEAN : thm
  PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY : thm
  PATH_CONNECTED_IMP_PATH_COMPONENT : thm
  PATH_CONNECTED_COMPONENT_SET : thm
  PATH_COMPONENT_MONO : thm
  PATH_COMPONENT_MAXIMAL : thm
  PATH_COMPONENT_EQ : thm
  PATH_CONNECTED_PATH_IMAGE : thm
  PATH_COMPONENT_PATH_IMAGE_PATHSTART : thm
  PATH_CONNECTED_PATH_COMPONENT : thm
  PATH_COMPONENT : thm
  PATH_COMPONENT_PATH_COMPONENT : thm
  PATH_CONNECTED_LINEPATH : thm
  PATH_COMPONENT_DISJOINT : thm
  PATH_COMPONENT_EQ_EQ : thm
  PATH_COMPONENT_UNIQUE : thm
  PATH_COMPONENT_INTERMEDIATE_SUBSET : thm
  COMPLEMENT_PATH_COMPONENT_UNIONS : thm
  OPEN_GENERAL_COMPONENT : thm
  OPEN_NON_GENERAL_COMPONENT : thm
  GENERAL_CONNECTED_OPEN : thm
  deriving Inhabited

@[nospecialize]
def setupPTK [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BI : PTI) :
    ExceptT String IO PTK := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, add_linear_invariants,
        add_translation_invariants, GEOM_TRANSFORM_TAC, GEOM_TRANSLATE_TAC, .. } := D.cvx
  let { DISJOINT, ETA_AX, EXTENSION, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FUN_EQ_THM, IMAGE_o, IMP_CONJ, IN, IN_DELETE, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY,
        .. } := D.cvx.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_NUM, .. } := D.cvx.vec2
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { IN_BALL, OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, connected, .. } := D.cvx.top5
  let { EMPTY, LEFT_IMP_FORALL_THM, .. } := D.pses1
  let { PATH_COMPONENT_IN_TOPSPACE, PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_SYM,
        PATH_COMPONENT_OF_TRANS, PATH_CONNECTED_IN_PATH_COMPONENT_OF,
        PATH_CONNECTED_IN_PATH_IMAGE, PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_TOPSPACE,
        PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT, UNIONS_PATH_COMPONENTS_OF, path_component_of,
        path_components_of, path_connected_in, .. } := D.pmet2
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.ptop4
  let { pathstart, pathfinish, path_image, PATH_IN_EUCLIDEAN, PATH_PATH_IN, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, .. } := BB
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Path component, considered as a "joinability" relation (from Tom       -/
  /- Hales).                                                                 -/
  /- ----------------------------------------------------------------------- -/

  let path_component ← new_definition
   r"path_component s x y <=>
        ?g. path g /\ path_image g SUBSET s /\
            pathstart g = x /\ pathfinish g = y"

  let path_components ← new_definition
   r"path_components s = {path_component s x | x | x IN s}"

  let PATH_COMPONENT_OF_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        path_component_of (subtopology euclidean s) = path_component s"
   (REWRITE_TAC [FUN_EQ_THM, path_component, path_component_of] THEN
    REWRITE_TAC [PATH_IN_EUCLIDEAN, pathstart, pathfinish, ← GSYM DROP_VEC] THEN
    REPEAT GEN_TAC THEN EQ_TAC THENL [MESON_TAC [o_THM], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(g:real^1->real^N) o lift") THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX])

  let PATH_COMPONENTS_OF_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        path_components_of (subtopology euclidean s) = path_components s"
   (REWRITE_TAC [path_components_of, path_components] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, PATH_COMPONENT_OF_EUCLIDEAN])

  let PATH_COMPONENT_IN ← prove
   r"!s x y. path_component s x y ==> x IN s /\ y IN s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN] THEN
    DISCH_THEN (MP_TAC o MATCH_MP PATH_COMPONENT_IN_TOPSPACE) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let PATH_COMPONENT_REFL_EQ ← prove
   r"!s x:real^N. path_component s x x <=> x IN s"
   (REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN, PATH_COMPONENT_OF_REFL] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let PATH_COMPONENT_REFL ← prove
   r"!s x:real^N. x IN s ==> path_component s x x"
   (REWRITE_TAC [PATH_COMPONENT_REFL_EQ])

  let PATH_COMPONENT_SYM_EQ ← prove
   r"!s x y. path_component s x y <=> path_component s y x"
   (REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN] THEN
    MATCH_ACCEPT_TAC PATH_COMPONENT_OF_SYM)

  let PATH_COMPONENT_SYM ← prove
   r"!s x y:real^N. path_component s x y ==> path_component s y x"
   (MESON_TAC [PATH_COMPONENT_SYM_EQ])

  let PATH_COMPONENT_TRANS ← prove
   r"!s x y:real^N.
      path_component s x y /\ path_component s y z ==> path_component s x z"
   (REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN, PATH_COMPONENT_OF_TRANS])

  let PATH_COMPONENT_OF_SUBSET ← prove
   r"!s t x. s SUBSET t /\ path_component s x y ==> path_component t x y"
   (REWRITE_TAC [path_component] THEN SET_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- Can also consider it as a set, as the name suggests.                    -/
  /- ----------------------------------------------------------------------- -/

  let PATH_COMPONENT_SET ← prove
   r"!s x. path_component s x =
            { y | ?g. path g /\ path_image g SUBSET s /\
                      pathstart g = x /\ pathfinish g = y }"
   (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REWRITE_TAC [IN, path_component])

  let PATH_COMPONENT_SUBSET ← prove
   r"!s x. (path_component s x) SUBSET s"
   (REWRITE_TAC [SUBSET, IN] THEN MESON_TAC [PATH_COMPONENT_IN, IN])

  let PATH_COMPONENT_EQ_EMPTY ← prove
   r"!s x. path_component s x = {} <=> ~(x IN s)"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [IN, PATH_COMPONENT_REFL, PATH_COMPONENT_IN])

  let PATH_COMPONENT_EMPTY ← prove
   r"!x. path_component {} x = {}"
   (REWRITE_TAC [PATH_COMPONENT_EQ_EMPTY, NOT_IN_EMPTY])

  let UNIONS_PATH_COMPONENT ← prove
   r"!s:real^N->bool. UNIONS {path_component s x |x| x IN s} = s"
   (GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← GSYM UNIONS_PATH_COMPONENTS_OF] THEN
    REWRITE_TAC [path_components_of, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EUCLIDEAN])

  let PATH_COMPONENT_TRANSLATION ← prove
   r"!a s x. path_component (IMAGE (\x. a + x) s) (a + x) =
                IMAGE (\x. a + x) (path_component s x)"
   (REWRITE_TAC [PATH_COMPONENT_SET] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [PATH_COMPONENT_TRANSLATION]

  let PATH_COMPONENT_LINEAR_IMAGE ← prove
   r"!f s x. linear f /\ (!x y. f x = f y ==> x = y) /\ (!y. ?x. f x = y)
           ==> path_component (IMAGE f s) (f x) =
               IMAGE f (path_component s x)"
   (REWRITE_TAC [PATH_COMPONENT_SET] THEN
    GEOM_TRANSFORM_TAC [])

  add_linear_invariants [PATH_COMPONENT_LINEAR_IMAGE]

  /- ----------------------------------------------------------------------- -/
  /- Path connectedness of a space.                                          -/
  /- ----------------------------------------------------------------------- -/

  let path_connected ← new_definition
   r"path_connected s <=>
        !x y. x IN s /\ y IN s
              ==> ?g. path g /\ (path_image g) SUBSET s /\
                      pathstart g = x /\ pathfinish g = y"

  let PATH_CONNECTED_IFF_PATH_COMPONENT ← prove
   r"!s. path_connected s <=> !x y. x IN s /\ y IN s ==> path_component s x y"
   (REWRITE_TAC [path_connected, path_component])

  let PATH_CONNECTED_IN_EUCLIDEAN ← prove
   r"!s:real^N->bool. path_connected_in euclidean s <=> path_connected s"
   (REWRITE_TAC [path_connected_in, PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← GSYM PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY ← prove
   r"!s:real^N->bool.
       path_connected_space(subtopology euclidean s) <=> path_connected s"
   (REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEAN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_REFL])

  let PATH_CONNECTED_IMP_PATH_COMPONENT ← prove
   r"!s a b:real^N.
     path_connected s /\ a IN s /\ b IN s ==> path_component s a b"
   (MESON_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT])

  let PATH_CONNECTED_COMPONENT_SET ← prove
   r"!s. path_connected s <=> !x. x IN s ==> path_component s x = s"
   (REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [PATH_COMPONENT_SUBSET] THEN SET_TAC [])

  let PATH_COMPONENT_MONO ← prove
   r"!s t x. s SUBSET t ==> (path_component s x) SUBSET (path_component t x)"
   (REWRITE_TAC [PATH_COMPONENT_SET] THEN SET_TAC [])

  let PATH_COMPONENT_MAXIMAL ← prove
   r"!s t x. x IN t /\ path_connected t /\ t SUBSET s
           ==> t SUBSET (path_component s x)"
   (REWRITE_TAC [path_connected, PATH_COMPONENT_SET, SUBSET, IN_ELIM_THM] THEN
    MESON_TAC [])

  let PATH_COMPONENT_EQ ← prove
   r"!s x y. y IN path_component s x
           ==> path_component s y = path_component s x"
   (REWRITE_TAC [EXTENSION, IN] THEN
    MESON_TAC [PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS])

  let PATH_CONNECTED_PATH_IMAGE ← prove
   r"!p:real^1->real^N. path p ==> path_connected(path_image p)"
   (GEN_TAC THEN REWRITE_TAC [PATH_PATH_IN] THEN
    DISCH_THEN (MP_TAC o MATCH_MP PATH_CONNECTED_IN_PATH_IMAGE) THEN
    REWRITE_TAC [IMAGE_o, IMAGE_LIFT_REAL_INTERVAL, LIFT_NUM] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEAN, path_image])

  let PATH_COMPONENT_PATH_IMAGE_PATHSTART ← prove
   r"!p x:real^N.
        path p /\ x IN path_image p
        ==> path_component (path_image p) (pathstart p) x"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PATH_CONNECTED_PATH_IMAGE) THEN
    REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [PATHSTART_IN_PATH_IMAGE])

  let PATH_CONNECTED_PATH_COMPONENT ← prove
   r"!s x:real^N. path_connected(path_component s x)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (s:real^N->bool)", ← q r"x:real^N"]
          PATH_CONNECTED_IN_PATH_COMPONENT_OF) THEN
    REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_EUCLIDEAN] THEN
    SIMP_TAC [PATH_COMPONENT_OF_EUCLIDEAN])

  let PATH_COMPONENT ← prove
   r"!s x y:real^N.
        path_component s x y <=>
        ?t. path_connected t /\ t SUBSET s /\ x IN t /\ y IN t"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"path_component s (x:real^N)") THEN
      REWRITE_TAC [PATH_CONNECTED_PATH_COMPONENT, PATH_COMPONENT_SUBSET] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENT_IN) THEN
      ASM_SIMP_TAC [IN, PATH_COMPONENT_REFL_EQ],
      REWRITE_TAC [path_component] THEN ASM_MESON_TAC [path_connected, SUBSET]])

  let PATH_COMPONENT_PATH_COMPONENT ← prove
   r"!s x:real^N.
        path_component (path_component s x) x = path_component s x"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN
      SIMP_TAC [PATH_COMPONENT_MONO, PATH_COMPONENT_SUBSET] THEN
      MATCH_MP_TAC PATH_COMPONENT_MAXIMAL THEN
      REWRITE_TAC [SUBSET_REFL, PATH_CONNECTED_PATH_COMPONENT] THEN
      ASM_REWRITE_TAC [IN, PATH_COMPONENT_REFL_EQ],
      MATCH_MP_TAC (← SET_RULE (← q r"s = {} /\ t = {} ==> s = t")) THEN
      ASM_REWRITE_TAC [PATH_COMPONENT_EQ_EMPTY] THEN
      ASM_MESON_TAC [SUBSET, PATH_COMPONENT_SUBSET]])

  let PATH_CONNECTED_LINEPATH ← prove
   r"!s a b:real^N. segment[a,b] SUBSET s ==> path_component s a b"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [path_component] THEN
    EXISTS_TAC (← q r"linepath(a:real^N,b)") THEN
    ASM_REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH])

  let PATH_COMPONENT_DISJOINT ← prove
   r"!s a b. DISJOINT (path_component s a) (path_component s b) <=>
             ~(a IN path_component s b)"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    REWRITE_TAC [IN] THEN MESON_TAC [PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS])

  let PATH_COMPONENT_EQ_EQ ← prove
   r"!s x y:real^N.
        path_component s x = path_component s y <=>
        ~(x IN s) /\ ~(y IN s) \/
        x IN s /\ y IN s /\ path_component s x y"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(y:real^N) IN s") THENL
     [ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THENL
       [REWRITE_TAC [FUN_EQ_THM] THEN
        ASM_MESON_TAC [PATH_COMPONENT_TRANS, PATH_COMPONENT_REFL,
                      PATH_COMPONENT_SYM],
        ASM_MESON_TAC [PATH_COMPONENT_EQ_EMPTY]],
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM PATH_COMPONENT_EQ_EMPTY]) THEN
      ASM_REWRITE_TAC [PATH_COMPONENT_EQ_EMPTY] THEN
      ONCE_REWRITE_TAC [PATH_COMPONENT_SYM_EQ] THEN
      ASM_REWRITE_TAC [EMPTY] THEN ASM_MESON_TAC [PATH_COMPONENT_EQ_EMPTY]])

  let PATH_COMPONENT_UNIQUE ← prove
   r"!s c x:real^N.
        x IN c /\ c SUBSET s /\ path_connected c /\
        (!c'. x IN c' /\ c' SUBSET s /\ path_connected c'
              ==> c' SUBSET c)
        ==> path_component s x = c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [PATH_COMPONENT_SUBSET, PATH_CONNECTED_PATH_COMPONENT] THEN
      REWRITE_TAC [IN] THEN ASM_REWRITE_TAC [PATH_COMPONENT_REFL_EQ] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC PATH_COMPONENT_MAXIMAL THEN ASM_REWRITE_TAC []])

  let PATH_COMPONENT_INTERMEDIATE_SUBSET ← prove
   r"!t u a:real^N.
        path_component u a SUBSET t /\ t SUBSET u
        ==> path_component t a = path_component u a"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN u") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_COMPONENT_UNIQUE THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_PATH_COMPONENT] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [PATH_COMPONENT_REFL, IN], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_COMPONENT_MAXIMAL THEN
      ASM SET_TAC [],
      ASM_MESON_TAC [PATH_COMPONENT_EQ_EMPTY, SUBSET]])

  let COMPLEMENT_PATH_COMPONENT_UNIONS ← prove
   r"!s x:real^N.
     s DIFF path_component s x =
     UNIONS({path_component s y | y | y IN s} DELETE (path_component s x))"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (fun c => LAND_CONV (LAND_CONV c)) [← GSYM UNIONS_PATH_COMPONENT] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN s DELETE a ==> DISJOINT a x)
       ==> UNIONS s DIFF a = UNIONS (s DELETE a)")) THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_GSPEC, IN_DELETE] THEN
    SIMP_TAC [PATH_COMPONENT_DISJOINT, PATH_COMPONENT_EQ_EQ] THEN
    MESON_TAC [IN, SUBSET, PATH_COMPONENT_SUBSET])

  /- ----------------------------------------------------------------------- -/
  /- General "locally connected implies connected" type results.             -/
  /- ----------------------------------------------------------------------- -/

  let OPEN_GENERAL_COMPONENT ← prove
   r"!c. (!s x y. c s x y ==> x IN s /\ y IN s) /\
       (!s x y. c s x y ==> c s y x) /\
       (!s x y z. c s x y /\ c s y z ==> c s x z) /\
       (!s t x y. s SUBSET t /\ c s x y ==> c t x y) /\
       (!s x y e. y IN ball(x,e) /\ ball(x,e) SUBSET s
                  ==> c (ball(x,e)) x y)
       ==> !s x:real^N. open s ==> open(c s x)"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "IN") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "SYM") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "TRANS") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "SUBSET") (LABEL_TAC "BALL")) THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL, SUBSET, IN_BALL] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [SUBSET, IN] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:real^N) IN s /\ y IN s") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"(y:real^N) IN s"))) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
    REMOVE_THEN "TRANS" MATCH_MP_TAC THEN EXISTS_TAC (← q r"y:real^N") THEN
    ASM_REWRITE_TAC [] THEN REMOVE_THEN "SUBSET" MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"ball(y:real^N,e)") THEN ASM_REWRITE_TAC [SUBSET, IN_BALL] THEN
    REMOVE_THEN "BALL" MATCH_MP_TAC THEN
    REWRITE_TAC [SUBSET, IN_BALL] THEN ASM_MESON_TAC [])

  let OPEN_NON_GENERAL_COMPONENT ← prove
   r"!c. (!s x y. c s x y ==> x IN s /\ y IN s) /\
       (!s x y. c s x y ==> c s y x) /\
       (!s x y z. c s x y /\ c s y z ==> c s x z) /\
       (!s t x y. s SUBSET t /\ c s x y ==> c t x y) /\
       (!s x y e. y IN ball(x,e) /\ ball(x,e) SUBSET s
                  ==> c (ball(x,e)) x y)
       ==> !s x:real^N. open s ==> open(s DIFF c s x)"
   (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "IN") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "SYM") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "TRANS") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "SUBSET") (LABEL_TAC "BALL")) THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL, SUBSET, IN_BALL] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_DIFF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (ASSUME_TAC o REWRITE_RULE [IN])) THEN
    FIRST_X_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"(y:real^N) IN s"))) THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN ASM_SIMP_TAC [] THEN
    REWRITE_TAC [IN] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN REWRITE_TAC [] THEN
    REMOVE_THEN "TRANS" MATCH_MP_TAC THEN EXISTS_TAC (← q r"z:real^N") THEN
    ASM_REWRITE_TAC [] THEN REMOVE_THEN "SUBSET" MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"ball(y:real^N,e)") THEN ASM_REWRITE_TAC [SUBSET, IN_BALL] THEN
    REMOVE_THEN "SYM" MATCH_MP_TAC THEN
    REMOVE_THEN "BALL" MATCH_MP_TAC THEN
    REWRITE_TAC [SUBSET, IN_BALL] THEN ASM_MESON_TAC [])

  let GENERAL_CONNECTED_OPEN ← prove
   r"!c. (!s x y. c s x y ==> x IN s /\ y IN s) /\
       (!s x y. c s x y ==> c s y x) /\
       (!s x y z. c s x y /\ c s y z ==> c s x z) /\
       (!s t x y. s SUBSET t /\ c s x y ==> c t x y) /\
       (!s x y e. y IN ball(x,e) /\ ball(x,e) SUBSET s
                  ==> c (ball(x,e)) x y)
       ==> !s x y:real^N. open s /\ connected s /\ x IN s /\ y IN s
                          ==> c s x y"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [connected]) THEN
    REWRITE_TAC [IN] THEN REWRITE_TAC [NOT_EXISTS_THM, LEFT_IMP_FORALL_THM] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"c (s:real^N->bool) (x:real^N):real^N->bool",
      ← q r"s DIFF (c (s:real^N->bool) (x:real^N))"] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ b /\ c /\ d /\ e /\ (f ==> g)
                       ==> ~(a /\ b /\ c /\ d /\ e /\ ~f) ==> g")) THEN
    REPEAT CONJ_TAC THENL
     [MP_TAC (← SPEC (← q r"c:(real^N->bool)->real^N->real^N->bool")
          OPEN_GENERAL_COMPONENT) THEN ASM_MESON_TAC [],
      MP_TAC (← SPEC (← q r"c:(real^N->bool)->real^N->real^N->bool")
          OPEN_NON_GENERAL_COMPONENT) THEN ASM_MESON_TAC [],
      SET_TAC [],
      SET_TAC [],
      ALL_TAC,
      ASM SET_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"x:real^N") THEN
    ASM_REWRITE_TAC [IN_INTER] THEN REWRITE_TAC [IN] THEN
    FIRST_ASSUM (MATCH_MP_TAC o
      SPECL [← q r"ball(x:real^N,e)", ← q r"s:real^N->bool"]) THEN
    ASM_MESON_TAC [CENTRE_IN_BALL])

  return { path_component, path_components, PATH_COMPONENT_OF_EUCLIDEAN,
           PATH_COMPONENTS_OF_EUCLIDEAN, PATH_COMPONENT_IN, PATH_COMPONENT_REFL_EQ,
           PATH_COMPONENT_REFL, PATH_COMPONENT_SYM_EQ, PATH_COMPONENT_SYM,
           PATH_COMPONENT_TRANS, PATH_COMPONENT_OF_SUBSET, PATH_COMPONENT_SET,
           PATH_COMPONENT_SUBSET, PATH_COMPONENT_EQ_EMPTY, PATH_COMPONENT_EMPTY,
           UNIONS_PATH_COMPONENT, PATH_COMPONENT_TRANSLATION, PATH_COMPONENT_LINEAR_IMAGE,
           path_connected, PATH_CONNECTED_IFF_PATH_COMPONENT, PATH_CONNECTED_IN_EUCLIDEAN,
           PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, PATH_CONNECTED_IMP_PATH_COMPONENT,
           PATH_CONNECTED_COMPONENT_SET, PATH_COMPONENT_MONO, PATH_COMPONENT_MAXIMAL,
           PATH_COMPONENT_EQ, PATH_CONNECTED_PATH_IMAGE, PATH_COMPONENT_PATH_IMAGE_PATHSTART,
           PATH_CONNECTED_PATH_COMPONENT, PATH_COMPONENT, PATH_COMPONENT_PATH_COMPONENT,
           PATH_CONNECTED_LINEPATH, PATH_COMPONENT_DISJOINT, PATH_COMPONENT_EQ_EQ,
           PATH_COMPONENT_UNIQUE, PATH_COMPONENT_INTERMEDIATE_SUBSET,
           COMPLEMENT_PATH_COMPONENT_UNIONS, OPEN_GENERAL_COMPONENT,
           OPEN_NON_GENERAL_COMPONENT, GENERAL_CONNECTED_OPEN }

/- ------------------------------------------------------------------------- -/
/- Some useful lemmas about path-connectedness; bounds on components of a    -/
/- continuous image.  (paths.ml 2869-3226)                                   -/
/- ------------------------------------------------------------------------- -/

structure PTL where
  CONVEX_IMP_PATH_CONNECTED : thm
  PATH_CONNECTED_UNIV : thm
  IS_INTERVAL_PATH_CONNECTED : thm
  PATH_CONNECTED_INTERVAL : thm
  PATH_COMPONENT_UNIV : thm
  PATH_CONNECTED_IMP_CONNECTED : thm
  OPEN_PATH_COMPONENT : thm
  OPEN_NON_PATH_COMPONENT : thm
  PATH_CONNECTED_CONTINUOUS_IMAGE : thm
  HOMEOMORPHIC_PATH_CONNECTEDNESS : thm
  PATH_CONNECTED_LINEAR_IMAGE : thm
  PATH_CONNECTED_LINEAR_IMAGE_EQ : thm
  HOMEOMORPHISM_PATH_CONNECTEDNESS : thm
  PATH_CONNECTED_EMPTY : thm
  PATH_CONNECTED_SING : thm
  PATH_CONNECTED_UNION : thm
  PATH_CONNECTED_UNIONS : thm
  PATH_CONNECTED_TRANSLATION : thm
  PATH_CONNECTED_TRANSLATION_EQ : thm
  PATH_CONNECTED_PCROSS : thm
  PATH_CONNECTED_PCROSS_EQ : thm
  PATH_COMPONENT_PCROSS : thm
  PATH_CONNECTED_SCALING : thm
  PATH_CONNECTED_SCALING_EQ : thm
  PATH_CONNECTED_AFFINITY_EQ : thm
  PATH_CONNECTED_AFFINITY : thm
  PATH_CONNECTED_NEGATIONS : thm
  PATH_CONNECTED_SUMS : thm
  IS_INTERVAL_PATH_CONNECTED_1 : thm
  CARD_LE_PATH_COMPONENTS : thm
  CARD_LE_CONNECTED_COMPONENTS : thm
  CARD_LE_COMPONENTS : thm
  deriving Inhabited

@[nospecialize]
def setupPTL [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BI : PTI)
    (BK : PTK) : ExceptT String IO PTL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, LINEAR_INVARIANT_RULE,
        add_linear_invariants, add_translation_invariants, GEOM_TRANSLATE_TAC, .. } := D.cvx
  let { EQ_IMP, ETA_AX, EXISTS_IN_GSPEC, EXISTS_PASTECART, EXTENSION, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, FUN_IN_IMAGE, IMAGE_CONST,
        IMAGE_ID, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IN, IN_ELIM_PASTECART_THM,
        .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, IN_UNIV,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IN_EMPTY, PASTECART_INJ,
        PASTECART_IN_PCROSS, PCROSS, PCROSS_EMPTY, PCROSS_EQ_EMPTY, .. } := D.cvx.core3
  let { REAL_MUL_LINV, REAL_NOT_LE, RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_PCROSS, SUBSET_REFL, SUBSET_UNION, .. } := D.cvx.core5
  let { o_DEF, .. } := D.cvx.core6
  let { AFFINITY_SCALING_TRANSLATION, .. } := D.cvx.vec1
  let { DROP_VEC, FORALL_DROP, LIFT_DROP, LIFT_NUM, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART,
        .. } := D.cvx.vec2
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, linear, .. } := D.cvx.vec4
  let { BALL_EQ_EMPTY, CENTRE_IN_BALL, .. } := D.cvx.top1
  let { CONNECTED_COMPONENT_SUBSET, CONNECTED_CONTINUOUS_IMAGE,
        CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, IN_INTERVAL_1, IS_INTERVAL_INTERVAL,
        LINEAR_CONTINUOUS_AT, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { SEGMENT_REFL, components, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { LE_C, .. } := D.pses1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_CONNECTED_COMPONENT,
        CONNECTED_IFF_CONNECTED_COMPONENT, .. } := D.ptop2
  let { CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_VMUL, .. } := D.ptop3
  let { connected_component, .. } := D.ptop5
  let { CONVEX_ALT, CONVEX_BALL, .. } := D.pcvx1
  let { CONVEX_UNIV, IS_INTERVAL_CONNECTED_1, IS_INTERVAL_CONVEX, IS_INTERVAL_CONVEX_1, .. } :=
    D.pcvx2
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE, .. } := BB
  let { PATHSTART_JOIN, PATHFINISH_JOIN, PATH_JOIN_IMP, SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  let { PATH_COMPONENT_IN, PATH_COMPONENT_REFL_EQ, PATH_COMPONENT_SYM_EQ, PATH_COMPONENT_SYM,
        PATH_COMPONENT_TRANS, PATH_COMPONENT_OF_SUBSET, PATH_COMPONENT_SUBSET,
        PATH_COMPONENT_EQ_EMPTY, path_connected, PATH_CONNECTED_IFF_PATH_COMPONENT,
        PATH_CONNECTED_COMPONENT_SET, PATH_COMPONENT_MONO, PATH_COMPONENT_EQ,
        PATH_CONNECTED_PATH_COMPONENT, PATH_COMPONENT, PATH_COMPONENT_UNIQUE,
        OPEN_GENERAL_COMPONENT, OPEN_NON_GENERAL_COMPONENT, .. } := BK
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Some useful lemmas about path-connectedness.                            -/
  /- ----------------------------------------------------------------------- -/

  let CONVEX_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. convex s ==> path_connected s"
   (REWRITE_TAC [CONVEX_ALT, path_connected] THEN REPEAT GEN_TAC THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"\u. (&1 - drop u) % x + drop u % y:real^N") THEN
    ASM_SIMP_TAC [pathstart, pathfinish, DROP_VEC, path, path_image,
                 SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, ← GSYM FORALL_DROP] THEN
    CONJ_TAC THENL [ALL_TAC, CONJ_TAC THEN VECTOR_ARITH_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC CONTINUOUS_ON_VMUL THEN
    REWRITE_TAC [o_DEF, LIFT_SUB, LIFT_DROP, LIFT_NUM] THEN
    SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID])

  let PATH_CONNECTED_UNIV ← prove
   r"path_connected(:real^N)"
   (SIMP_TAC [CONVEX_IMP_PATH_CONNECTED, CONVEX_UNIV])

  let IS_INTERVAL_PATH_CONNECTED ← prove
   r"!s. is_interval s ==> path_connected s"
   (SIMP_TAC [CONVEX_IMP_PATH_CONNECTED, IS_INTERVAL_CONVEX])

  let PATH_CONNECTED_INTERVAL ← prove
   r"(!a b:real^N. path_connected(interval[a,b])) /\
   (!a b:real^N. path_connected(interval(a,b)))"
   (SIMP_TAC [IS_INTERVAL_PATH_CONNECTED, IS_INTERVAL_INTERVAL])

  let PATH_COMPONENT_UNIV ← prove
   r"!x. path_component(:real^N) x = (:real^N)"
   (MESON_TAC [PATH_CONNECTED_COMPONENT_SET, PATH_CONNECTED_UNIV, IN_UNIV])

  let PATH_CONNECTED_IMP_CONNECTED ← prove
   r"!s:real^N->bool. path_connected s ==> connected s"
   (GEN_TAC THEN
    REWRITE_TAC [path_connected, CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^N") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"path_image(g:real^1->real^N)") THEN
    ASM_MESON_TAC [CONNECTED_PATH_IMAGE, PATHSTART_IN_PATH_IMAGE,
                  PATHFINISH_IN_PATH_IMAGE])

  let OPEN_PATH_COMPONENT ← prove
   r"!s x:real^N. open s ==> open(path_component s x)"
   (MATCH_MP_TAC OPEN_GENERAL_COMPONENT THEN
    REWRITE_TAC [PATH_COMPONENT_IN, PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS,
                PATH_COMPONENT_OF_SUBSET] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]
     (← MATCH_MP CONVEX_IMP_PATH_CONNECTED (← SPEC_ALL CONVEX_BALL))) THEN
    ASM_MESON_TAC [CENTRE_IN_BALL, BALL_EQ_EMPTY, REAL_NOT_LE, NOT_IN_EMPTY])

  let OPEN_NON_PATH_COMPONENT ← prove
   r"!s x:real^N. open s ==> open(s DIFF path_component s x)"
   (MATCH_MP_TAC OPEN_NON_GENERAL_COMPONENT THEN
    REWRITE_TAC [PATH_COMPONENT_IN, PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS,
                PATH_COMPONENT_OF_SUBSET] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]
     (← MATCH_MP CONVEX_IMP_PATH_CONNECTED (← SPEC_ALL CONVEX_BALL))) THEN
    ASM_MESON_TAC [CENTRE_IN_BALL, BALL_EQ_EMPTY, REAL_NOT_LE, NOT_IN_EMPTY])

  let PATH_CONNECTED_CONTINUOUS_IMAGE ← prove
   r"!f:real^M->real^N s.
        f continuous_on s /\ path_connected s ==> path_connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_connected] THEN STRIP_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"]) THEN
    ASM_REWRITE_TAC [path, path_image, pathstart, pathfinish] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^M") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o (g:real^1->real^M)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      ASM_REWRITE_TAC [o_DEF] THEN ASM SET_TAC []])

  let HOMEOMORPHIC_PATH_CONNECTEDNESS ← prove
   r"!s t. s homeomorphic t ==> (path_connected s <=> path_connected t)"
   (REWRITE_TAC [homeomorphic, homeomorphism] THEN
    MESON_TAC [PATH_CONNECTED_CONTINUOUS_IMAGE])

  let PATH_CONNECTED_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
     path_connected s /\ linear f ==> path_connected(IMAGE f s)"
   (SIMP_TAC [LINEAR_CONTINUOUS_ON, PATH_CONNECTED_CONTINUOUS_IMAGE])

  let PATH_CONNECTED_LINEAR_IMAGE_EQ ← prove
   r"!f s. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (path_connected (IMAGE f s) <=> path_connected s)"
   (MATCH_ACCEPT_TAC (← LINEAR_INVARIANT_RULE PATH_CONNECTED_LINEAR_IMAGE))

  add_linear_invariants [PATH_CONNECTED_LINEAR_IMAGE_EQ]

  let HOMEOMORPHISM_PATH_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (path_connected(IMAGE f k) <=> path_connected k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_PATH_CONNECTEDNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let PATH_CONNECTED_EMPTY ← prove
   r"path_connected {}"
   (REWRITE_TAC [path_connected, NOT_IN_EMPTY])

  let PATH_CONNECTED_SING ← prove
   r"!a:real^N. path_connected {a}"
   (GEN_TAC THEN REWRITE_TAC [path_connected, IN_SING] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"linepath(a:real^N,a)") THEN
    ASM_REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    REWRITE_TAC [SEGMENT_REFL, PATH_IMAGE_LINEPATH, SUBSET_REFL])

  let PATH_CONNECTED_UNION ← prove
   r"!s t. path_connected s /\ path_connected t /\ ~(s INTER t = {})
         ==> path_connected (s UNION t)"
   (REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    REWRITE_TAC [IN_INTER, IN_UNION] THEN
    MESON_TAC [PATH_COMPONENT_OF_SUBSET, SUBSET_UNION, PATH_COMPONENT_TRANS])

  let PATH_CONNECTED_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> path_connected s) /\ ~(INTERS f = {})
        ==> path_connected(UNIONS f)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    MATCH_MP_TAC PATH_COMPONENT_TRANS THEN EXISTS_TAC (← q r"a:real^N") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [PATH_COMPONENT_SYM_EQ] THEN
      UNDISCH_TAC (← q r"(x:real^N) IN UNIONS f"),
      UNDISCH_TAC (← q r"(y:real^N) IN UNIONS f")] THEN
    REWRITE_TAC [IN_UNIONS, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")),
      DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N"))] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s x ==> t x")) THEN
    REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC PATH_COMPONENT_MONO THEN
    ASM SET_TAC [])

  let PATH_CONNECTED_TRANSLATION ← prove
   r"!a s. path_connected s ==> path_connected (IMAGE (\x:real^N. a + x) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST])

  let PATH_CONNECTED_TRANSLATION_EQ ← prove
   r"!a s. path_connected (IMAGE (\x:real^N. a + x) s) <=> path_connected s"
   (REWRITE_TAC [path_connected] THEN GEOM_TRANSLATE_TAC [])

  add_translation_invariants [PATH_CONNECTED_TRANSLATION_EQ]

  let PATH_CONNECTED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        path_connected s /\ path_connected t
        ==> path_connected (s PCROSS t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PCROSS, path_connected] THEN DISCH_TAC THEN
    REWRITE_TAC [FORALL_PASTECART, IN_ELIM_PASTECART_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x1:real^M", ← q r"y1:real^N", ← q r"x2:real^M",
                         ← q r"y2:real^N"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPECL [← q r"x1:real^M", ← q r"x2:real^M"])
     (MP_TAC o SPECL [← q r"y1:real^N", ← q r"y2:real^N"])) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^1->real^N") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"g:real^1->real^M") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(\t. pastecart (x1:real^M) ((h:real^1->real^N) t)) ++
                (\t. pastecart ((g:real^1->real^M) t) (y2:real^N))") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish, path]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [path_image, FORALL_IN_IMAGE, SUBSET]) THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC PATH_JOIN_IMP THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [path] THEN MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_CONST],
        REWRITE_TAC [path] THEN MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_CONST],
        ASM_REWRITE_TAC [pathstart, pathfinish]],
      MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN
      ASM_SIMP_TAC [path_image, FORALL_IN_IMAGE, SUBSET, IN_ELIM_PASTECART_THM],
      REWRITE_TAC [PATHSTART_JOIN] THEN ASM_REWRITE_TAC [pathstart],
      REWRITE_TAC [PATHFINISH_JOIN] THEN ASM_REWRITE_TAC [pathfinish]])

  let PATH_CONNECTED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        path_connected(s PCROSS t) <=>
        s = {} \/ t = {} \/ path_connected s /\ path_connected t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, PATH_CONNECTED_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, PATH_CONNECTED_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [PATH_CONNECTED_PCROSS] THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
                      ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"]
         PATH_CONNECTED_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_FSTCART],
      MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
                     ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)"]
         PATH_CONNECTED_LINEAR_IMAGE) THEN
      ASM_REWRITE_TAC [LINEAR_SNDCART]] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS,
                FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM SET_TAC [])

  let PATH_COMPONENT_PCROSS ← prove
   r"!s t a:real^M b:real^N.
        path_component (s PCROSS t) (pastecart a b) =
        path_component s a PCROSS path_component t b"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:real^M) IN s /\ (b:real^N) IN t") THENL
     [MATCH_MP_TAC PATH_COMPONENT_UNIQUE THEN
      REWRITE_TAC [PASTECART_IN_PCROSS, SUBSET_PCROSS,
                  PATH_CONNECTED_PCROSS_EQ] THEN
      REWRITE_TAC [PATH_COMPONENT_SUBSET, PATH_CONNECTED_PATH_COMPONENT] THEN
      GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [IN] THEN
      ASM_REWRITE_TAC [PATH_COMPONENT_REFL_EQ] THEN
      X_GEN_TAC (← q r"c:real^(M,N)finite_sum->bool") THEN
      REWRITE_TAC [SUBSET, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^N"] THEN DISCH_TAC THEN
      REWRITE_TAC [IN] THEN REWRITE_TAC [PATH_COMPONENT] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"IMAGE fstcart (c:real^(M,N)finite_sum->bool)"),
        EXISTS_TAC (← q r"IMAGE sndcart (c:real^(M,N)finite_sum->bool)")] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_PASTECART, EXISTS_PASTECART, IN_IMAGE] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []]) THEN
      MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
      MATCH_MP_TAC (← SET_RULE (← q r"s = {} /\ t = {} ==> s = t")) THEN
      REWRITE_TAC [PCROSS_EQ_EMPTY, PATH_COMPONENT_EQ_EMPTY] THEN
      REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM_MESON_TAC []])

  let PATH_CONNECTED_SCALING ← prove
   r"!s:real^N->bool c.
        path_connected s ==> path_connected (IMAGE (\x. c % x) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let PATH_CONNECTED_SCALING_EQ ← prove
   r"!s:real^N->bool c.
        path_connected (IMAGE (\x. c % x) s) <=> c = &0 \/ path_connected s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [IMAGE_CONST, VECTOR_MUL_LZERO] THEN
      MESON_TAC [PATH_CONNECTED_SING, PATH_CONNECTED_EMPTY],
      EQ_TAC THEN REWRITE_TAC [PATH_CONNECTED_SCALING] THEN
      DISCH_THEN (MP_TAC o
        SPEC (← q r"inv(c):real") o MATCH_MP PATH_CONNECTED_SCALING) THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, VECTOR_MUL_LID, IMAGE_ID]])

  let PATH_CONNECTED_AFFINITY_EQ ← prove
   r"!s m c:real^N.
        path_connected (IMAGE (\x. m % x + c) s) <=>
        m = &0 \/ path_connected s"
   (REWRITE_TAC [AFFINITY_SCALING_TRANSLATION, PATH_CONNECTED_TRANSLATION_EQ,
                PATH_CONNECTED_SCALING_EQ, IMAGE_o])

  let PATH_CONNECTED_AFFINITY ← prove
   r"!s m c:real^N.
     path_connected s ==> path_connected (IMAGE (\x. m % x + c) s)"
   (SIMP_TAC [PATH_CONNECTED_AFFINITY_EQ])

  let PATH_CONNECTED_NEGATIONS ← prove
   r"!s:real^N->bool.
        path_connected s ==> path_connected (IMAGE (--) s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
    REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let PATH_CONNECTED_SUMS ← prove
   r"!s t:real^N->bool.
        path_connected s /\ path_connected t
        ==> path_connected {x + y | x IN s /\ y IN t}"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP PATH_CONNECTED_PCROSS) THEN
    DISCH_THEN (MP_TAC o ISPEC
     (← q r"\z. (fstcart z + sndcart z:real^N)") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        PATH_CONNECTED_CONTINUOUS_IMAGE)) THEN
    SIMP_TAC [CONTINUOUS_ON_ADD, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART,
             LINEAR_SNDCART, PCROSS] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, EXISTS_PASTECART] THEN
    REWRITE_TAC [PASTECART_INJ, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    MESON_TAC [])

  let IS_INTERVAL_PATH_CONNECTED_1 ← prove
   r"!s:real^1->bool. is_interval s <=> path_connected s"
   (MESON_TAC [CONVEX_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED,
              IS_INTERVAL_CONNECTED_1, IS_INTERVAL_CONVEX_1])

  /- ----------------------------------------------------------------------- -/
  /- Bounds on components of a continuous image.                             -/
  /- ----------------------------------------------------------------------- -/

  let CARD_LE_PATH_COMPONENTS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> {path_component (IMAGE f s) y | y | y IN IMAGE f s}
            <=_c {path_component s x | x | x IN s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LE_C] THEN
    SIMP_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, FORALL_IN_IMAGE] THEN EXISTS_TAC
     (← q r"\c. path_component (IMAGE (f:real^M->real^N) s) (f(@x. x IN c))") THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:real^M") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC PATH_COMPONENT_EQ THEN
    REWRITE_TAC [IN] THEN ONCE_REWRITE_TAC [PATH_COMPONENT] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (path_component s x)") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, PATH_COMPONENT_SUBSET,
                    PATH_CONNECTED_PATH_COMPONENT],
      MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [PATH_COMPONENT_SUBSET],
      ALL_TAC, ALL_TAC] THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN] THEN
    ASM_MESON_TAC [PATH_COMPONENT_REFL_EQ])

  let CARD_LE_CONNECTED_COMPONENTS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s
        ==> {connected_component (IMAGE f s) y | y | y IN IMAGE f s}
            <=_c {connected_component s x | x | x IN s}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LE_C] THEN
    SIMP_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, FORALL_IN_IMAGE] THEN EXISTS_TAC
     (← q r"\c. connected_component (IMAGE (f:real^M->real^N) s) (f(@x. x IN c))") THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:real^M") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_EQ THEN
    REWRITE_TAC [IN] THEN ONCE_REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (connected_component s x)") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, CONNECTED_COMPONENT_SUBSET,
                    CONNECTED_CONNECTED_COMPONENT],
      MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [CONNECTED_COMPONENT_SUBSET],
      ALL_TAC, ALL_TAC] THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_REFL_EQ])

  let CARD_LE_COMPONENTS ← prove
   r"!f:real^M->real^N s.
        f continuous_on s ==> components(IMAGE f s) <=_c components s"
   (REWRITE_TAC [components, CARD_LE_CONNECTED_COMPONENTS])

  return { CONVEX_IMP_PATH_CONNECTED, PATH_CONNECTED_UNIV, IS_INTERVAL_PATH_CONNECTED,
           PATH_CONNECTED_INTERVAL, PATH_COMPONENT_UNIV, PATH_CONNECTED_IMP_CONNECTED,
           OPEN_PATH_COMPONENT, OPEN_NON_PATH_COMPONENT, PATH_CONNECTED_CONTINUOUS_IMAGE,
           HOMEOMORPHIC_PATH_CONNECTEDNESS, PATH_CONNECTED_LINEAR_IMAGE,
           PATH_CONNECTED_LINEAR_IMAGE_EQ, HOMEOMORPHISM_PATH_CONNECTEDNESS,
           PATH_CONNECTED_EMPTY, PATH_CONNECTED_SING, PATH_CONNECTED_UNION,
           PATH_CONNECTED_UNIONS, PATH_CONNECTED_TRANSLATION, PATH_CONNECTED_TRANSLATION_EQ,
           PATH_CONNECTED_PCROSS, PATH_CONNECTED_PCROSS_EQ, PATH_COMPONENT_PCROSS,
           PATH_CONNECTED_SCALING, PATH_CONNECTED_SCALING_EQ, PATH_CONNECTED_AFFINITY_EQ,
           PATH_CONNECTED_AFFINITY, PATH_CONNECTED_NEGATIONS, PATH_CONNECTED_SUMS,
           IS_INTERVAL_PATH_CONNECTED_1, CARD_LE_PATH_COMPONENTS,
           CARD_LE_CONNECTED_COMPONENTS, CARD_LE_COMPONENTS }

/- ------------------------------------------------------------------------- -/
/- More stuff about segments.  (paths.ml 3227-3560)                          -/
/- ------------------------------------------------------------------------- -/

structure PTM where
  PATH_CONNECTED_SEGMENT : thm
  PATH_CONNECTED_SEMIOPEN_SEGMENT : thm
  SUBSET_CONTINUOUS_IMAGE_SEGMENT_1 : thm
  CONTINUOUS_INJECTIVE_IMAGE_SEGMENT_1 : thm
  CONTINUOUS_INJECTIVE_IMAGE_OPEN_SEGMENT_1 : thm
  CONTINUOUS_IVT_LOCAL_EXTREMUM : thm
  FRONTIER_UNIONS_SUBSET_CLOSURE : thm
  FRONTIER_UNIONS_SUBSET : thm
  CLOSURE_CONVEX_INTER_AFFINE : thm
  RELATIVE_FRONTIER_CONVEX_INTER_AFFINE : thm
  RELATIVE_FRONTIER_CBALL_INTER_AFFINE : thm
  CONNECTED_COMPONENT_1_GEN : thm
  CONNECTED_COMPONENT_1 : thm
  HOMEOMORPHIC_SEGMENTS : thm
  HOMEOMORPHISM_SEGMENT : thm
  CONNECTED_SUBSET_SEGMENT : thm
  DIAMETER_SEGMENT : thm
  deriving Inhabited

@[nospecialize]
def setupPTM [HolBase] (D : PathsDeps) (BA : PTA) (BL : PTL) : ExceptT String IO PTM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DIMINDEX_1, ETA_AX, EXISTS_IN_GSPEC, FINITE_IMAGE, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ, INTER_EMPTY, INTER_SUBSET, IN_DIFF,
        .. } := D.cvx.core2
  let { IN_IMAGE, IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LET_TRANS, REAL_LE_ANTISYM, .. } := D.cvx.core4
  let { REAL_SUB_0, RIGHT_EXISTS_AND_THM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { BETWEEN_SYM, DIST_POS_LE, DIST_REFL, DIST_SYM, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_VEC, FORALL_LIFT, LIFT_DROP, LIFT_EQ, LIFT_SUB, .. } := D.cvx.vec2
  let { SUBSPACE_MUL, .. } := D.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_EQ_0, VECTOR_MUL_RCANCEL, VECTOR_MUL_RZERO, VECTOR_SUB_EQ,
        dist, .. } := D.cvx.vec4
  let { BETWEEN_IN_SEGMENT, CBALL_EMPTY, CENTRE_IN_BALL, CLOSURE_APPROACHABLE,
        CLOSURE_CLOSED, CLOSURE_EQ, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_INTERVAL, CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INTER_FRONTIER,
        CONNECTED_SEGMENT, CONTINUOUS_ATTAINS_INF, CONTINUOUS_ATTAINS_SUP, .. } := D.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_INVERSE,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, DIAMETER_BOUNDED_BOUND,
        DIAMETER_CLOSURE, DIAMETER_EMPTY, DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT,
        FRONTIER_CBALL, FRONTIER_CLOSED, HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_REFL, .. } :=
    D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_COMPACT, INTERIOR_CBALL,
        INTERVAL_SUBSET_IS_INTERVAL, IN_INTERVAL_1, IN_SEGMENT, MIDPOINT_IN_SEGMENT, .. } :=
    D.cvx.top4
  let { SEGMENT_1, SEGMENT_REFL, SPHERE_EMPTY, SUBSET_CLOSURE, SUBSET_INTERIOR,
        UNIT_INTERVAL_NONEMPTY, frontier, homeomorphism, segment, .. } := D.cvx.top5
  let { EXISTS_IN_UNIONS, INJECTIVE_ON_LEFT_INVERSE, .. } := D.pses1
  let { BETWEEN_ANTISYM, ENDS_IN_UNIT_INTERVAL, LINEAR_ID, LINEAR_VMUL_DROP, .. } := D.pvec
  let { CLOSED_UNIONS, .. } := D.ptop1
  let { DIAMETER_LE, DIAMETER_SING, DIST_IN_CLOSED_SEGMENT_2, HOMEOMORPHIC_COMPACTNESS,
        HOMEOMORPHIC_FINITENESS, HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ, .. } := D.ptop3
  let { HOMEOMORPHIC_SING, HOMEOMORPHIC_TRANSLATION_LEFT_EQ, .. } := D.ptop4
  let { connected_component, .. } := D.ptop5
  let { AFFINE_EQ_SUBSPACE, BOUNDED_SEGMENT, CLOSED_AFFINE, CLOSURE_SEGMENT, COMPACT_SEGMENT,
        CONNECTED_CONVEX_1_GEN, CONVEX_CBALL, .. } := D.pcvx1
  let { CONVEX_CONTAINS_SEGMENT, CONVEX_SEGMENT, CONVEX_SEMIOPEN_SEGMENT, FINITE_SEGMENT,
        INTERIOR_SUBSET_RELATIVE_INTERIOR, IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT,
        IS_INTERVAL_CONNECTED_1, IS_INTERVAL_CONVEX_1, RELATIVE_FRONTIER_EMPTY,
        RELATIVE_INTERIOR_CONVEX_INTER_AFFINE, RELATIVE_INTERIOR_SUBSET, SEGMENT_EQ_EMPTY,
        SEGMENT_IMAGE_INTERVAL, SUBSET_SEGMENT, relative_frontier, .. } := D.pcvx2
  let { pathstart, pathfinish, path_image, .. } := BA
  let { CONVEX_IMP_PATH_CONNECTED, .. } := BL
  -- @@SCOPE END

  let PATH_CONNECTED_SEGMENT ← prove
   r"(!a b. path_connected(segment[a,b])) /\
   (!a b. path_connected(segment(a,b)))"
   (SIMP_TAC [CONVEX_IMP_PATH_CONNECTED, CONVEX_SEGMENT])

  let PATH_CONNECTED_SEMIOPEN_SEGMENT ← prove
   r"(!a b:real^N. path_connected(segment[a,b] DELETE a)) /\
   (!a b:real^N. path_connected(segment[a,b] DELETE b))"
   (SIMP_TAC [CONVEX_IMP_PATH_CONNECTED, CONVEX_SEMIOPEN_SEGMENT])

  let SUBSET_CONTINUOUS_IMAGE_SEGMENT_1 ← prove
   r"!f:real^N->real^1 a b.
        f continuous_on segment[a,b]
        ==> segment[f a,f b] SUBSET IMAGE f (segment[a,b])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONNECTED_CONTINUOUS_IMAGE)) THEN
    REWRITE_TAC [CONNECTED_SEGMENT] THEN
    REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_CONVEX_1] THEN
    REWRITE_TAC [CONVEX_CONTAINS_SEGMENT] THEN
    MESON_TAC [IN_IMAGE, ENDS_IN_SEGMENT])

  let CONTINUOUS_INJECTIVE_IMAGE_SEGMENT_1 ← prove
   r"!f:real^N->real^1 a b.
        f continuous_on segment[a,b] /\
        (!x y. x IN segment[a,b] /\ y IN segment[a,b] /\ f x = f y ==> x = y)
        ==> IMAGE f (segment[a,b]) = segment[f a,f b]"
   (← do
    let lemma ← prove
     r"!a b c:real^1.
        ~(a = b) /\ ~(a IN segment(c,b)) /\ ~(b IN segment(a,c))
        ==> c IN segment[a,b]"
     (REWRITE_TAC [FORALL_LIFT, SEGMENT_1, LIFT_DROP] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [SEGMENT_1, LIFT_EQ] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP]) THEN
      ASM_REAL_ARITH_TAC)
    pure (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^1->real^N") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^N->real^1", ← q r"g:real^1->real^N",
                   ← q r"segment[a:real^N,b]"]
          CONTINUOUS_ON_INVERSE) THEN
    ASM_REWRITE_TAC [COMPACT_SEGMENT] THEN DISCH_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [SUBSET_CONTINUOUS_IMAGE_SEGMENT_1], DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL] THENL [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"c:real^N") THEN
    DISCH_TAC THEN MATCH_MP_TAC lemma THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [ENDS_IN_SEGMENT], DISCH_TAC] THEN
    ONCE_REWRITE_TAC [segment] THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:real^N->real^1", ← q r"c:real^N", ← q r"b:real^N"]
          SUBSET_CONTINUOUS_IMAGE_SEGMENT_1) THEN
      SUBGOAL_THEN (← q r"segment[c:real^N,b] SUBSET segment[a,b]") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_SEGMENT, ENDS_IN_SEGMENT], ALL_TAC] THEN
      REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], REWRITE_TAC [SUBSET]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^N->real^1) a")) THEN
      ASM_REWRITE_TAC [IN_IMAGE, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real^N") THEN ASM_CASES_TAC (← q r"d:real^N = a") THENL
       [ASM_MESON_TAC [BETWEEN_ANTISYM, BETWEEN_IN_SEGMENT],
        ASM_MESON_TAC [ENDS_IN_SEGMENT, SUBSET]],
      MP_TAC (← ISPECL [← q r"f:real^N->real^1", ← q r"a:real^N", ← q r"c:real^N"]
          SUBSET_CONTINUOUS_IMAGE_SEGMENT_1) THEN
      SUBGOAL_THEN (← q r"segment[a:real^N,c] SUBSET segment[a,b]") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_SEGMENT, ENDS_IN_SEGMENT], ALL_TAC] THEN
      REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], REWRITE_TAC [SUBSET]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^N->real^1) b")) THEN
      ASM_REWRITE_TAC [IN_IMAGE, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real^N") THEN ASM_CASES_TAC (← q r"d:real^N = b") THENL
       [ASM_MESON_TAC [BETWEEN_ANTISYM, BETWEEN_IN_SEGMENT, BETWEEN_SYM],
        ASM_MESON_TAC [ENDS_IN_SEGMENT, SUBSET]]]))

  let CONTINUOUS_INJECTIVE_IMAGE_OPEN_SEGMENT_1 ← prove
   r"!f:real^N->real^1 a b.
        f continuous_on segment[a,b] /\
        (!x y. x IN segment[a,b] /\ y IN segment[a,b] /\ f x = f y ==> x = y)
        ==> IMAGE f (segment(a,b)) = segment(f a,f b)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [segment] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_INJECTIVE_IMAGE_SEGMENT_1) THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] ENDS_IN_SEGMENT) THEN
    MP_TAC (← ISPECL [← q r"(f:real^N->real^1) a", ← q r"(f:real^1->real^1) b"]
      ENDS_IN_SEGMENT) THEN
    ASM SET_TAC [])

  let CONTINUOUS_IVT_LOCAL_EXTREMUM ← prove
   r"!f:real^N->real^1 a b.
        f continuous_on segment[a,b] /\ ~(a = b) /\ f(a) = f(b)
         ==> ?z. z IN segment(a,b) /\
                 ((!w. w IN segment[a,b] ==> drop(f w) <= drop(f z)) \/
                  (!w. w IN segment[a,b] ==> drop(f z) <= drop(f w)))"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY (MP_TAC o ISPECL
              [← q r"drop o (f:real^N->real^1)", ← q r"segment[a:real^N,b]"])
              [CONTINUOUS_ATTAINS_SUP, CONTINUOUS_ATTAINS_INF] THEN
    ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX] THEN
    REWRITE_TAC [COMPACT_SEGMENT, SEGMENT_EQ_EMPTY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"(d:real^N) IN segment(a,b)") THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"(c:real^N) IN segment(a,b)") THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"midpoint(a:real^N,b)") THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [MIDPOINT_IN_SEGMENT], DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← CONJUNCT2 segment]) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE (fun c => RAND_CONV (RAND_CONV c)) [segment])) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
    REPEAT (DISCH_THEN (DISJ_CASES_THEN SUBST_ALL_TAC)) THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN ASM_MESON_TAC [REAL_LE_ANTISYM, DROP_EQ])

  let FRONTIER_UNIONS_SUBSET_CLOSURE ← prove
   r"!f:(real^N->bool)->bool.
        frontier(UNIONS f) SUBSET closure(UNIONS {frontier t | t IN f})"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [frontier] THEN
    REWRITE_TAC [SUBSET, IN_DIFF, CLOSURE_APPROACHABLE] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [EXISTS_IN_UNIONS, EXISTS_IN_GSPEC, RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    ASM_CASES_TAC (← q r"(t:real^N->bool) IN f") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN t") THENL
     [DISCH_THEN (K ALL_TAC : thm → tactic) THEN EXISTS_TAC (← q r"x:real^N") THEN
      ASM_REWRITE_TAC [frontier, DIST_REFL, IN_DIFF] THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
      SPEC_TAC (← q r"x:real^N", ← q r"z:real^N") THEN
      REWRITE_TAC [CONTRAPOS_THM, ← GSYM SUBSET] THEN
      MATCH_MP_TAC SUBSET_INTERIOR THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"segment[x:real^N,y]", ← q r"t:real^N->bool"]
          CONNECTED_INTER_FRONTIER) THEN
      SIMP_TAC [CONNECTED_SEGMENT, ← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_DIFF] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [ENDS_IN_SEGMENT], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:real^N") THEN
      ASM_MESON_TAC [DIST_IN_CLOSED_SEGMENT, DIST_SYM, REAL_LET_TRANS]])

  let FRONTIER_UNIONS_SUBSET ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f ==> frontier(UNIONS f) SUBSET UNIONS {frontier t | t IN f}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"s SUBSET closure t /\ closure t = t ==> s SUBSET t")) THEN
    REWRITE_TAC [FRONTIER_UNIONS_SUBSET_CLOSURE, CLOSURE_EQ] THEN
    MATCH_MP_TAC CLOSED_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE, FRONTIER_CLOSED])

  let CLOSURE_CONVEX_INTER_AFFINE ← prove
   r"!s t:real^N->bool.
      convex s /\ affine t /\ ~(relative_interior s INTER t = {})
      ==> closure(s INTER t) = closure(s) INTER t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [SUBSET_INTER] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_CLOSURE THEN SET_TAC [],
      TRANS_TAC SUBSET_TRANS (← q r"closure t:real^N->bool") THEN
      SIMP_TAC [SUBSET_CLOSURE, INTER_SUBSET] THEN
      ASM_SIMP_TAC [CLOSURE_CLOSED, CLOSED_AFFINE, SUBSET_REFL],
      ALL_TAC] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:real^N") MP_TAC o
          GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    POP_ASSUM_LIST (MP_TAC o HolLight.end_itlist CONJ) THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [IN_INTER] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_SIMP_TAC [AFFINE_EQ_SUBSPACE] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
      RELATIVE_INTERIOR_SUBSET)) THEN
    REWRITE_TAC [SUBSET, IN_INTER] THEN X_GEN_TAC (← q r"x:real^N") THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      ASM_REWRITE_TAC [IN_INTER],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"x IN closure(segment(vec 0:real^N,x))") MP_TAC THENL
     [ASM_REWRITE_TAC [CLOSURE_SEGMENT, ENDS_IN_SEGMENT], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
    MATCH_MP_TAC SUBSET_CLOSURE THEN REWRITE_TAC [SUBSET_INTER] THEN
    CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"relative_interior s:real^N->bool") THEN
      REWRITE_TAC [RELATIVE_INTERIOR_SUBSET] THEN
      MATCH_MP_TAC IN_RELATIVE_INTERIOR_CLOSURE_CONVEX_SEGMENT THEN
      ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [SUBSET, IN_SEGMENT, VECTOR_MUL_RZERO, VECTOR_ADD_LID,
                   SUBSPACE_MUL, LEFT_IMP_EXISTS_THM]])

  let RELATIVE_FRONTIER_CONVEX_INTER_AFFINE ← prove
   r"!s t:real^N->bool.
        convex s /\ affine t /\ ~(interior s INTER t = {})
        ==> relative_frontier(s INTER t) = frontier s INTER t"
   (SIMP_TAC [relative_frontier, RELATIVE_INTERIOR_CONVEX_INTER_AFFINE,
             frontier] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(relative_interior s INTER t:real^N->bool = {})")
    ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"s:real^N->bool") INTERIOR_SUBSET_RELATIVE_INTERIOR) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [CLOSURE_CONVEX_INTER_AFFINE] THEN SET_TAC []])

  let RELATIVE_FRONTIER_CBALL_INTER_AFFINE ← prove
   r"!s a:real^N r.
        affine s /\ a IN s /\ ~(r = &0)
        ==> relative_frontier(cball(a,r) INTER s) = sphere(a,r) INTER s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"r < &0") THENL
     [ASM_SIMP_TAC [CBALL_EMPTY, SPHERE_EMPTY, INTER_EMPTY] THEN
      REWRITE_TAC [RELATIVE_FRONTIER_EMPTY],
      W (MP_TAC o PART_MATCH (lhand o rand)
        RELATIVE_FRONTIER_CONVEX_INTER_AFFINE o lhand o snd) THEN
      REWRITE_TAC [FRONTIER_CBALL] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [CONVEX_CBALL, INTERIOR_CBALL, ← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"a:real^N") THEN ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REAL_ARITH_TAC])

  let CONNECTED_COMPONENT_1_GEN ← prove
   r"!s a b:real^N.
        dimindex(:N) = 1
        ==> (connected_component s a b <=> segment[a,b] SUBSET s)"
   (SIMP_TAC [connected_component, CONNECTED_CONVEX_1_GEN] THEN
    MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET, CONVEX_SEGMENT,
              ENDS_IN_SEGMENT])

  let CONNECTED_COMPONENT_1 ← prove
   r"!s a b:real^1. connected_component s a b <=> segment[a,b] SUBSET s"
   (SIMP_TAC [CONNECTED_COMPONENT_1_GEN, DIMINDEX_1])

  let HOMEOMORPHIC_SEGMENTS ← prove
   r"(!a b:real^M c d:real^N.
        segment[a,b] homeomorphic segment[c,d] <=> (a = b <=> c = d)) /\
   (!a b:real^M c d:real^N.
        ~(segment[a,b] homeomorphic segment(c,d))) /\
   (!a b:real^M c d:real^N.
        ~(segment(a,b) homeomorphic segment[c,d])) /\
   (!a b:real^M c d:real^N.
        segment(a,b) homeomorphic segment(c,d) <=> (a = b <=> c = d))"
   (← do
    let lemma ← prove
     r"!a b:real^N. (\u:real^1. (&1 - drop u) % a + drop u % b) =
                    (\u. a + u) o (\u. drop u % (b - a))"
     (REWRITE_TAC [FUN_EQ_THM, o_THM] THEN VECTOR_ARITH_TAC)
    pure (ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (q /\ r) /\ (p /\ s)")] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_COMPACTNESS) THEN
      REWRITE_TAC [COMPACT_SEGMENT] THEN POP_ASSUM MP_TAC THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [SEGMENT_REFL, HOMEOMORPHIC_EMPTY, SEGMENT_EQ_EMPTY],
      REPEAT STRIP_TAC THEN
      (EQ_TAC THENL
        [DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_FINITENESS) THEN
         REWRITE_TAC [FINITE_SEGMENT],
         ASM_CASES_TAC (← q r"c:real^N = d") THEN
         ASM_SIMP_TAC [SEGMENT_REFL, HOMEOMORPHIC_SING, HOMEOMORPHIC_EMPTY] THEN
         DISCH_TAC])] THEN
    ASM_SIMP_TAC [SEGMENT_IMAGE_INTERVAL] THENL
     [TRANS_TAC HOMEOMORPHIC_TRANS (← q r"interval[vec 0:real^1,vec 1]"),
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"interval(vec 0:real^1,vec 1)")] THEN
    (CONJ_TAC THENL [ALL_TAC, ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM]]) THEN
    REWRITE_TAC [lemma, IMAGE_o, HOMEOMORPHIC_TRANSLATION_LEFT_EQ] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ o snd) THEN
    REWRITE_TAC [HOMEOMORPHIC_REFL] THEN DISCH_THEN MATCH_MP_TAC THEN
    SIMP_TAC [LINEAR_VMUL_DROP, LINEAR_ID, VECTOR_MUL_RCANCEL] THEN
    ASM_REWRITE_TAC [DROP_EQ, VECTOR_SUB_EQ]))

  let HOMEOMORPHISM_SEGMENT ← prove
   r"!a b:real^N.
        ~(a = b)
        ==> ?h. homeomorphism (interval[vec 0:real^1,vec 1],segment[a,b])
                              ((\t. (&1 - drop t) % a + drop t % b),h)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
    REWRITE_TAC [COMPACT_INTERVAL, ← GSYM SEGMENT_IMAGE_INTERVAL] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      SIMP_TAC [o_DEF, CONTINUOUS_ON_CONST, LIFT_DROP, CONTINUOUS_ON_ID,
               LIFT_SUB, CONTINUOUS_ON_SUB],
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&1 - x) % a + x % b:real^N = (&1 - y) % a + y % b <=>
        (x - y) % (a - b) = vec 0")] THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, REAL_SUB_0, VECTOR_SUB_EQ, DROP_EQ]])

  let CONNECTED_SUBSET_SEGMENT ← prove
   r"!s a b:real^N.
        connected s /\ s SUBSET segment[a,b] /\ a IN s /\ b IN s
        ==> s = segment[a,b]"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THENL
     [ASM_REWRITE_TAC [SEGMENT_REFL] THEN SET_TAC [], STRIP_TAC] THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHISM_SEGMENT) THEN
    ABBREV_TAC (← q r"g = \x. (&1 - drop x) % a + drop x % (b:real^N)") THEN
    REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^N->real^1") THEN
    SUBGOAL_THEN (← q r"(g:real^1->real^N)(vec 0) = a /\ g(vec 1) = b")
    MP_TAC THENL
     [EXPAND_TAC "g" THEN REWRITE_TAC [DROP_VEC] THEN CONV_TAC (fun t => VECTOR_ARITH t),
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SYM) THEN REPEAT STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (h:real^N->real^1) (segment[a,b]) SUBSET IMAGE h s")
    MP_TAC THENL [ASM_REWRITE_TAC [], ASM SET_TAC []] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) INTERVAL_SUBSET_IS_INTERVAL o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [IS_INTERVAL_CONNECTED_1] THEN
      MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      REWRITE_TAC [UNIT_INTERVAL_NONEMPTY] THEN DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN
     (← q r"vec 0 IN interval[vec 0:real^1,vec 1] /\
      vec 1 IN interval[vec 0:real^1,vec 1]")
    MP_TAC THENL [REWRITE_TAC [ENDS_IN_UNIT_INTERVAL], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish, path_image]) THEN
    ASM SET_TAC [])

  let DIAMETER_SEGMENT ← prove
   r"(!a b:real^N. diameter(segment[a,b]) = dist(a,b)) /\
   (!a b:real^N. diameter(segment(a,b)) = dist(a,b))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, DIST_REFL, DIAMETER_SING, DIAMETER_EMPTY] THENL
     [ALL_TAC,
      GEN_REWRITE_TAC LAND_CONV [← GSYM DIAMETER_CLOSURE] THEN
      ASM_REWRITE_TAC [CLOSURE_SEGMENT]] THEN
    (REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
      [MATCH_MP_TAC DIAMETER_LE,
       REWRITE_TAC [dist] THEN MATCH_MP_TAC DIAMETER_BOUNDED_BOUND]) THEN
    REWRITE_TAC [BOUNDED_SEGMENT, ENDS_IN_SEGMENT, DIST_POS_LE] THEN
    REWRITE_TAC [← GSYM dist, DIST_IN_CLOSED_SEGMENT_2])

  return { PATH_CONNECTED_SEGMENT, PATH_CONNECTED_SEMIOPEN_SEGMENT,
           SUBSET_CONTINUOUS_IMAGE_SEGMENT_1, CONTINUOUS_INJECTIVE_IMAGE_SEGMENT_1,
           CONTINUOUS_INJECTIVE_IMAGE_OPEN_SEGMENT_1, CONTINUOUS_IVT_LOCAL_EXTREMUM,
           FRONTIER_UNIONS_SUBSET_CLOSURE, FRONTIER_UNIONS_SUBSET, CLOSURE_CONVEX_INTER_AFFINE,
           RELATIVE_FRONTIER_CONVEX_INTER_AFFINE, RELATIVE_FRONTIER_CBALL_INTER_AFFINE,
           CONNECTED_COMPONENT_1_GEN, CONNECTED_COMPONENT_1, HOMEOMORPHIC_SEGMENTS,
           HOMEOMORPHISM_SEGMENT, CONNECTED_SUBSET_SEGMENT, DIAMETER_SEGMENT }

/- ------------------------------------------------------------------------- -/
/- Removing points from arcs and simple paths; injective functions into R;   -/
/- monotonicity; Darboux continuity.  (paths.ml 3561-4031)                   -/
/- ------------------------------------------------------------------------- -/

structure PTN where
  SIMPLE_PATH_ENDLESS : thm
  PATH_CONNECTED_SIMPLE_PATH_ENDLESS : thm
  CONNECTED_SIMPLE_PATH_ENDLESS : thm
  NONEMPTY_SIMPLE_PATH_ENDLESS : thm
  CONNECTED_ARC_IMAGE_DELETE : thm
  CONNECTED_SIMPLE_PATH_IMAGE_DELETE : thm
  HOMEOMORPHIC_SIMPLE_PATH_ARC : thm
  HOMEOMORPHIC_SIMPLE_PATH_ARC_EQ : thm
  ARC_ENDS_UNIQUE : thm
  ARC_HOMEOMORPHISM_ENDS : thm
  HOMEOMORPHISM_ARC_IMAGES : thm
  COLLINEAR_SIMPLE_PATH_IMAGE : thm
  INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM : thm
  INJECTIVE_INTO_1D_IMP_OPEN_MAP : thm
  HOMEOMORPHISM_INTO_1D : thm
  CONTINUOUS_INJECTIVE_IFF_MONOTONIC : thm
  CONTINUOUS_INJECTIVE_IMP_MONOTONIC : thm
  HOMEOMORPHISM_1D_IMP_MONOTONIC : thm
  CONVEXITY_PRESERVING : thm
  CONVEXITY_PRESERVING_ALT : thm
  DARBOUX_AND_REGULATED_IMP_CONTINUOUS : thm
  deriving Inhabited

@[nospecialize]
def setupPTN [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BE : PTE) (BI : PTI)
    (BJ : PTJ) (BK : PTK) (BL : PTL) : ExceptT String IO PTN := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, CONJ_SYM, CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP, EQ_TRANS, EXISTS_IN_IMAGE,
        EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY,
        IMAGE_o, IMP_CONJ, IMP_IMP, INJECTIVE_ON_ALT, INSERT_SUBSET, IN_DELETE, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_OR,
        NOT_IMP, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_LT, REAL_LE_REFL, REAL_LT_ANTISYM, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_NOT_LT, REAL_POS, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, .. } :=
    D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_1, DIST_NZ, DIST_SYM, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_VEC, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP, LIFT_EQ, .. } := D.cvx.vec2
  let { CLOSURE_BALL, .. } := D.cvx.top1
  let { CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INSERT, CONNECTED_SEGMENT, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT, HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_IMP_OPEN_MAP,
        HOMEOMORPHISM_OF_SUBSETS, HOMEOMORPHISM_SYM, INTERVAL_EQ_EMPTY_1, IN_BALL, IN_CBALL,
        IN_INTERVAL_1, IS_INTERVAL_1, IS_INTERVAL_INTERVAL, LIMPT_APPROACHABLE, LIM_WITHIN,
        .. } := D.cvx.top4
  let { SEGMENT_1, SEGMENT_REFL, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        TRIVIAL_LIMIT_WITHIN, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, EXISTS_FUN_DROP, FORALL_FUN_DROP, FORALL_LIFT_FUN,
        FORALL_LIFT_IMAGE, LIFT_IN_IMAGE_LIFT, .. } := D.pvec
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, EMBEDDING_MAP_INTO_EUCLIDEANREAL,
        HOMEOMORPHIC_MAP_MAPS, .. } := D.pmet1
  let { INJECTIVE_EQ_MONOTONE_MAP, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, embedding_map,
        homeomorphic_maps, .. } := D.pmet2
  let { CONTINUOUS_MAP_DROP_EQ_GEN, CONTINUOUS_MAP_EQ_LIFT, CONTINUOUS_MAP_EUCLIDEAN,
        CONTINUOUS_ON, .. } := D.ptop2
  let { CONTINUOUS_ON_COMPONENTWISE_LIFT, CONTINUOUS_ON_LIFT_COMPONENT,
        HOMEOMORPHIC_CONNECTEDNESS, HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY, .. } := D.ptop3
  let { HOMEOMORPHISM_INJECTIVE_OPEN_MAP, IS_REALINTERVAL_IS_INTERVAL, LIM_COMPONENT,
        LIM_TRIVIAL, .. } := D.ptop4
  let { OPEN_CLOSED_INTERVAL_1, TWO_SIDED_LIMIT_WITHIN, .. } := D.ptop5
  let { CLOSURE_SEGMENT, COMPACT_CONVEX_COLLINEAR_SEGMENT, .. } := D.pcvx1
  let { CONVEX_CONNECTED_COLLINEAR, CONVEX_CONTAINS_OPEN_SEGMENT, CONVEX_CONTAINS_SEGMENT,
        CONVEX_CONTAINS_SEGMENT_IMP, CONVEX_SEGMENT, IS_INTERVAL_CONNECTED_1,
        IS_INTERVAL_CONVEX_1, SEGMENT_EQ, SEGMENT_EQ_EMPTY, SEGMENT_SUBSET_CONVEX, .. } :=
    D.pcvx2
  let { path, pathstart, pathfinish, path_image, simple_path, arc, ARC_CONTINUOUS_IMAGE, .. } :=
    BA
  let { ARC_IMP_SIMPLE_PATH, SIMPLE_PATH_IMP_PATH, ARC_SIMPLE_PATH, PATH_IMAGE_NONEMPTY,
        PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE,
        COMPACT_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE, PATH_IMAGE_COMPOSE, .. } := BB
  let { PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH, PATH_IMAGE_SHIFTPATH,
        SIMPLE_PATH_SHIFTPATH, .. } := BE
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH, ARC_LINEPATH, .. } := BI
  let { HOMEOMORPHISM_ARC, .. } := BJ
  let { PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_CONTINUOUS_IMAGE,
        IS_INTERVAL_PATH_CONNECTED_1, .. } := BL
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Removing points from arcs and simple paths, hence allowing us to        -/
  /- distinguish simple closed curves and arcs topologically.                -/
  /- ----------------------------------------------------------------------- -/

  let SIMPLE_PATH_ENDLESS ← prove
   r"!c:real^1->real^N.
        simple_path c
        ==> path_image c DIFF {pathstart c,pathfinish c} =
            IMAGE c (interval(vec 0,vec 1))"
   (REWRITE_TAC [simple_path, path_image, pathstart, pathfinish] THEN
    REWRITE_TAC [OPEN_CLOSED_INTERVAL_1, path] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"(!x y. x IN s /\ y IN s /\ c x = c y
             ==> x = y \/ x = a /\ y = b \/ x = b /\ y = a) /\
      a IN s /\ b IN s
      ==>  IMAGE c s DIFF {c a,c b} = IMAGE c (s DIFF {a,b})")) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL])

  let PATH_CONNECTED_SIMPLE_PATH_ENDLESS ← prove
   r"!c:real^1->real^N.
        simple_path c
        ==> path_connected(path_image c DIFF {pathstart c,pathfinish c})"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SIMPLE_PATH_ENDLESS] THEN
    MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
    REWRITE_TAC [← GSYM IS_INTERVAL_PATH_CONNECTED_1, IS_INTERVAL_INTERVAL] THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [simple_path, path]) THEN
    ASM_REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED])

  let CONNECTED_SIMPLE_PATH_ENDLESS ← prove
   r"!c:real^1->real^N.
        simple_path c
        ==> connected(path_image c DIFF {pathstart c,pathfinish c})"
   (SIMP_TAC [PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_SIMPLE_PATH_ENDLESS])

  let NONEMPTY_SIMPLE_PATH_ENDLESS ← prove
   r"!c:real^1->real^N.
      simple_path c ==> ~(path_image c DIFF {pathstart c,pathfinish c} = {})"
   (SIMP_TAC [SIMPLE_PATH_ENDLESS, IMAGE_EQ_EMPTY, INTERVAL_EQ_EMPTY_1] THEN
    REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC)

  let CONNECTED_ARC_IMAGE_DELETE ← prove
   r"!g a:real^N.
        arc g /\ a IN path_image g
        ==> (connected(path_image g DELETE a) <=>
             a IN {pathstart g,pathfinish g})"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHISM_ARC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->real^1") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [path_image]) THEN
    REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:real^1") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    TRANS_TAC EQ_TRANS
     (← q r"connected(IMAGE (h:real^N->real^1) (path_image g DELETE a))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_CONNECTEDNESS THEN REWRITE_TAC [homeomorphic] THEN
      MAP_EVERY EXISTS_TAC [← q r"h:real^N->real^1", ← q r"g:real^1->real^N"] THEN
      RULE_ASSUM_TAC (ONCE_REWRITE_RULE [HOMEOMORPHISM_SYM]) THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    TRANS_TAC EQ_TRANS (← q r"connected(interval[vec 0:real^1,vec 1] DELETE t)") THEN
    CONJ_TAC THENL
     [AP_TERM_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [pathstart, pathfinish]] THEN
    TRANS_TAC EQ_TRANS (← q r"t IN {vec 0:real^1,vec 1}") THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1],
      EXPAND_TAC "a" THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s
        ==> (!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) /\ a IN s /\ b IN s
            ==> (x IN {a,b} <=> g x IN {g a,g b})"))) THEN
      REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC []] THEN
    EQ_TAC THENL
     [DISCH_THEN (MP_TAC o SPECL
        [← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"t:real^1"]) THEN
      ASM_REWRITE_TAC [← GSYM IN_INTERVAL_1, IN_DELETE, ENDS_IN_UNIT_INTERVAL] THEN
      SET_TAC [],
      REWRITE_TAC [IN_DELETE, IN_INSERT, NOT_IN_EMPTY, IN_INTERVAL_1,
                  ← GSYM DROP_EQ, DROP_VEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_REAL_ARITH_TAC])

  let CONNECTED_SIMPLE_PATH_IMAGE_DELETE ← prove
   r"!g a:real^N.
        simple_path g /\ pathfinish g = pathstart g
        ==> connected(path_image g DELETE a)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN path_image g") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s"),
                 CONNECTED_PATH_IMAGE, SIMPLE_PATH_IMP_PATH] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_IMAGE]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") (STRIP_ASSUME_TAC o GSYM)) THEN
    MP_TAC (← ISPEC (← q r"shiftpath t (g:real^1->real^N)")
      CONNECTED_SIMPLE_PATH_ENDLESS) THEN
    ASM_SIMP_TAC [SIMPLE_PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    ASM_SIMP_TAC [PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH] THEN
    REWRITE_TAC [← SET_RULE (← q r"s DIFF {a,a} = s DELETE a")])

  let HOMEOMORPHIC_SIMPLE_PATH_ARC ← prove
   r"!g:real^1->real^M h:real^1->real^N.
        arc g /\ simple_path h /\ (path_image g) homeomorphic (path_image h)
        ==> arc h"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [ARC_SIMPLE_PATH] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?a:real^M. a IN path_image g /\ ~connected(path_image g DELETE a)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [CONNECTED_ARC_IMAGE_DELETE,
                   ← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN
      REWRITE_TAC [path_image, NOT_IMP, EXISTS_IN_IMAGE] THEN
      EXISTS_TAC (← q r"lift(&1 / &2)") THEN
      REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [IN_INSERT, pathstart, pathfinish, NOT_IN_EMPTY] THEN
      REWRITE_TAC [DE_MORGAN_THM] THEN
      FIRST_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [arc]) THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"p /\ q /\ r ==> s <=> p /\ q /\ ~s ==> ~r")] THEN
      DISCH_TAC THEN CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1, ← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"i:real^M->real^N", ← q r"j:real^N->real^M"] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"h:real^1->real^N", ← q r"(i:real^M->real^N) a"]
          CONNECTED_SIMPLE_PATH_IMAGE_DELETE) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_CONNECTEDNESS THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"i:real^M->real^N", ← q r"j:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_SIMPLE_PATH_ARC_EQ ← prove
   r"!g:real^1->real^M h:real^1->real^N.
        simple_path g /\ simple_path h /\
        (path_image g) homeomorphic (path_image h)
        ==> (arc g <=> arc h)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MP_TAC (← ISPECL [← q r"g:real^1->real^M", ← q r"h:real^1->real^N"]
          HOMEOMORPHIC_SIMPLE_PATH_ARC),
      MP_TAC (← ISPECL [← q r"h:real^1->real^N", ← q r"g:real^1->real^M"]
          HOMEOMORPHIC_SIMPLE_PATH_ARC)] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_SYM])

  let ARC_ENDS_UNIQUE ← prove
   r"!g h:real^1->real^N.
        arc g /\ simple_path h /\ path_image g = path_image h
        ==> {pathstart g, pathfinish g} = {pathstart h, pathfinish h}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"h:real^1->real^N"]
          HOMEOMORPHIC_SIMPLE_PATH_ARC) THEN
    ASM_REWRITE_TAC [HOMEOMORPHIC_REFL] THEN DISCH_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"{x:real^N | x IN path_image g /\ connected(path_image g DELETE x)}") THEN
    CONJ_TAC THENL [CONV_TAC SYM_CONV, ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"a IN s /\ b IN s /\ (!x. x IN s ==> (P x <=> x IN {a,b}))
      ==> {x | x IN s /\ P x} = {a,b}")) THEN
    REWRITE_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE] THEN
    ASM_SIMP_TAC [CONNECTED_ARC_IMAGE_DELETE])

  let ARC_HOMEOMORPHISM_ENDS ← prove
   r"!g h f f':real^N->real^N.
        homeomorphism (path_image g,path_image h) (f,f') /\ arc g /\ arc h
        ==> f(pathstart g) = pathstart h /\
            f(pathfinish g) = pathfinish h /\
            f'(pathstart h) = pathstart g /\
            f'(pathfinish h) = pathfinish g \/
            f(pathstart g) = pathfinish h /\
            f(pathfinish g) = pathstart h /\
            f'(pathstart h) = pathfinish g /\
            f'(pathfinish h) = pathstart g"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(f:real^N->real^N) o (g:real^1->real^N)",
                    ← q r"h:real^1->real^N"]
          ARC_ENDS_UNIQUE) THEN
    ASM_REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [ARC_IMP_SIMPLE_PATH] THEN
      MATCH_MP_TAC ARC_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
      ASM SET_TAC [],
      REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE, ← SET_RULE
       (← q r"{a,b} = {a',b'} <=> a = a' /\ b = b' \/ a = b' /\ b = a'")] THEN
      MATCH_MP_TAC MONO_OR THEN SIMP_TAC [] THEN CONJ_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN (SUBST1_TAC o SYM)) THEN CONJ_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE]])

  let HOMEOMORPHISM_ARC_IMAGES ← prove
   r"!g:real^1->real^M h:real^1->real^N.
        arc g /\ arc h
        ==> ?f f'. homeomorphism (path_image g,path_image h) (f,f') /\
                   f(pathstart g) = pathstart h /\
                   f(pathfinish g) = pathfinish h /\
                   f'(pathstart h) = pathstart g /\
                   f'(pathfinish h) = pathfinish g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"h:real^1->real^N") HOMEOMORPHISM_ARC) THEN
    MP_TAC (← ISPEC (← q r"g:real^1->real^M") HOMEOMORPHISM_ARC) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g':real^M->real^1") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"h':real^N->real^1") THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(h:real^1->real^N) o (g':real^M->real^1)",
      ← q r"(g:real^1->real^M) o (h':real^N->real^1)"] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN ASM_MESON_TAC [HOMEOMORPHISM_SYM],
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      ASM_SIMP_TAC [o_THM, pathstart, pathfinish, ENDS_IN_UNIT_INTERVAL]])

  let COLLINEAR_SIMPLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N.
        simple_path g /\ collinear(path_image g)
        ==> path_image g = segment[pathstart g,pathfinish g]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"path_image g:real^N->bool")
      COMPACT_CONVEX_COLLINEAR_SEGMENT) THEN
    ASM_SIMP_TAC [CONVEX_CONNECTED_COLLINEAR, CONNECTED_PATH_IMAGE,
      COMPACT_PATH_IMAGE, PATH_IMAGE_NONEMPTY, SIMPLE_PATH_IMP_PATH] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [SEGMENT_EQ] THEN
    MP_TAC (← ISPECL [← q r"linepath(a:real^N,b)", ← q r"g:real^1->real^N"]
          ARC_ENDS_UNIQUE) THEN
    ASM_REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN DISCH_THEN MATCH_MP_TAC THEN
    MATCH_MP_TAC ARC_LINEPATH THEN DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SEGMENT_REFL]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_SIMPLE_PATH_ENDLESS) THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s = {a} ==> x IN s ==> {a} DIFF {x,y} = {}"))) THEN
    REWRITE_TAC [PATHSTART_IN_PATH_IMAGE])

  /- ----------------------------------------------------------------------- -/
  /- An injective function into R is a homeomorphism and so an open map.     -/
  /- ----------------------------------------------------------------------- -/

  let INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM ← prove
   r"!f:real^N->real^1 s.
        f continuous_on s /\ path_connected s
        ==>  ((!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) <=>
              ?g. homeomorphism (s,IMAGE f s) (f,g))"
   (REWRITE_TAC [FORALL_LIFT_FUN, EXISTS_FUN_DROP] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EUCLIDEAN, ← GSYM CONTINUOUS_MAP_EQ_LIFT] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [o_THM, LIFT_EQ] THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> (p /\ r <=> s)) ==> p /\ q ==> (r <=> s)")) THEN
    DISCH_TAC THEN W (MP_TAC o PART_MATCH (lhand o rand o rand)
      EMBEDDING_MAP_INTO_EUCLIDEANREAL o lhand o lhand o snd) THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [embedding_map, ← GSYM HOMEOMORPHIC_MAPS_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, FORALL_IN_IMAGE, o_THM,
                LIFT_DROP, LIFT_EQ, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
                CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_DROP_EQ_GEN, IMAGE_o] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EQ_LIFT, LIFT_IN_IMAGE_LIFT])

  let INJECTIVE_INTO_1D_IMP_OPEN_MAP ← prove
   r"!f:real^N->real^1 s t.
        f continuous_on s /\ path_connected s /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        open_in (subtopology euclidean s) t
        ==> open_in (subtopology euclidean (IMAGE f s)) (IMAGE f t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
    ASM_MESON_TAC [INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM])

  let HOMEOMORPHISM_INTO_1D ← prove
   r"!f:real^N->real^1 s t.
        path_connected s /\
        f continuous_on s /\ IMAGE f s = t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> ?g. homeomorphism(s,t) (f,g)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INJECTIVE_INTO_1D_IMP_OPEN_MAP THEN
    ASM_MESON_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- Injective function on an interval is strictly increasing or decreasing. -/
  /- ----------------------------------------------------------------------- -/

  let CONTINUOUS_INJECTIVE_IFF_MONOTONIC ← prove
   r"!f:real^1->real^1 s.
        f continuous_on s /\ is_interval s
        ==> ((!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) <=>
             (!x y. x IN s /\ y IN s /\ drop x < drop y
                    ==> drop(f x) < drop(f y)) \/
             (!x y. x IN s /\ y IN s /\ drop x < drop y
                    ==> drop(f y) < drop(f x)))"
   (REWRITE_TAC [FORALL_LIFT_IMAGE] THEN
    REWRITE_TAC [FORALL_LIFT_FUN, FORALL_FUN_DROP] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM IS_REALINTERVAL_IS_INTERVAL] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EUCLIDEAN] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_DROP_EQ_GEN] THEN
    REWRITE_TAC [← GSYM CONTINUOUS_MAP_EQ_LIFT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [o_THM, LIFT_DROP, LIFT_EQ] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    GEN_REWRITE_TAC LAND_CONV [CONJ_SYM] THEN REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [INJECTIVE_EQ_MONOTONE_MAP])

  let CONTINUOUS_INJECTIVE_IMP_MONOTONIC ← prove
   r"!f s.
        f continuous_on s /\ is_interval s /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (!x y. x IN s /\ y IN s
                   ==> (drop(f x) < drop(f y) <=> drop x < drop y)) \/
            (!x y. x IN s /\ y IN s
                   ==> (drop(f x) < drop(f y) <=> drop y < drop x))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC th THEN ASM_SIMP_TAC [CONTINUOUS_INJECTIVE_IFF_MONOTONIC] THEN
      ASSUME_TAC (← REWRITE_RULE [INJECTIVE_ON_ALT] th))) THEN
    MATCH_MP_TAC MONO_OR THEN CONJ_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [REAL_NOT_LT] THEN REWRITE_TAC [REAL_LE_LT] THEN
    ASM_MESON_TAC [DROP_EQ])

  let HOMEOMORPHISM_1D_IMP_MONOTONIC ← prove
   r"!f g s t.
        homeomorphism(s,t) (f,g) /\ is_interval s
        ==> (!x y. x IN s /\ y IN s
                   ==> (drop(f x) < drop(f y) <=> drop x < drop y)) /\
            (!x y. x IN t /\ y IN t
                   ==> (drop(g x) < drop(g y) <=> drop x < drop y)) \/
            (!x y. x IN s /\ y IN s
                   ==> (drop(f x) < drop(f y) <=> drop y < drop x)) /\
            (!x y. x IN t /\ y IN t
                   ==> (drop(g x) < drop(g y) <=> drop y < drop x))"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool"]
          CONTINUOUS_INJECTIVE_IMP_MONOTONIC) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC]) THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [EXTENSION, IN_IMAGE]) THEN
    ASM_MESON_TAC [REAL_LT_ANTISYM])

  /- ----------------------------------------------------------------------- -/
  /- Topological rendering of Darboux continuity, proof it implies          -/
  /- continuity for a regulated function from R^1 (having left and right     -/
  /- limits).                                                                -/
  /- ----------------------------------------------------------------------- -/

  let CONVEXITY_PRESERVING ← prove
   r"!f:real^M->real^N s.
        (!c. c SUBSET s /\ convex c ==> convex(IMAGE f c)) <=>
        (!a b. segment[a,b] SUBSET s ==> convex(IMAGE f (segment[a,b])))"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONVEX_SEGMENT] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, FORALL_IN_IMAGE_2] THEN
    ASM_SIMP_TAC [← GSYM CONVEX_CONTAINS_SEGMENT_IMP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONVEX_CONTAINS_SEGMENT_IMP) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"(f:real^M->real^N) a", ← q r"(f:real^M->real^N) b"]) THEN
    SIMP_TAC [FUN_IN_IMAGE, ENDS_IN_SEGMENT] THEN ASM SET_TAC [])

  let CONVEXITY_PRESERVING_ALT ← prove
   r"!f:real^M->real^N s.
        (!c. c SUBSET s /\ convex c ==> convex(IMAGE f c)) <=>
        (!a b. segment[a,b] SUBSET s
               ==> segment[f a,f b] SUBSET IMAGE f (segment[a,b]))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC SEGMENT_SUBSET_CONVEX THEN
      SIMP_TAC [FUN_IN_IMAGE, ENDS_IN_SEGMENT] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [CONVEX_SEGMENT],
      REWRITE_TAC [CONVEX_CONTAINS_SEGMENT, FORALL_IN_IMAGE_2] THEN
      ASM_SIMP_TAC [← GSYM CONVEX_CONTAINS_SEGMENT_IMP] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
      ASM SET_TAC []])

  let DARBOUX_AND_REGULATED_IMP_CONTINUOUS ← prove
   r"!f:real^1->real^N s.
      is_interval s /\
      (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
      (!a. a IN s
           ==> (?l. (f --> l) (at a within s INTER {x | drop x <= drop a})) /\
               (?r. (f --> r) (at a within s INTER {x | drop a <= drop x})))
      ==> f continuous_on s"
   (SUBGOAL_THEN
     (← q r"!f:real^1->real^1 s.
        is_interval s /\
        (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)) /\
        (!a. a IN s
             ==> (?l. (f --> l) (at a within s INTER {x | drop x <= drop a})) /\
                 (?r. (f --> r) (at a within s INTER {x | drop a <= drop x})))
        ==> f continuous_on s")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [CONTINUOUS_ON_COMPONENTWISE_LIFT] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"c:real^1->bool") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(\x. lift(((f:real^1->real^N) x)$i)) = (\x. lift(x$i)) o f")
         (fun th => ONCE_REWRITE_TAC [th])
        THENL [REWRITE_TAC [o_DEF], REWRITE_TAC [IMAGE_o]] THEN
        MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_COMPONENT],
        X_GEN_TAC (← q r"a:real^1") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^1")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
        EXISTS_TAC (← q r"lift((y:real^N)$i)") THEN ASM_SIMP_TAC [LIM_COMPONENT]]] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_ON] THEN
    X_GEN_TAC (← q r"a:real^1") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [TWO_SIDED_LIMIT_WITHIN] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^1")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:real^1") MP_TAC) THEN
    MATCH_MP_TAC (← MESON [LIM_TRIVIAL]
     (← q r"(~trivial_limit net /\ (f --> l) net ==> m = l)
      ==> (f --> l) net ==> (f --> m) net")) THEN
    REWRITE_TAC [TRIVIAL_LIMIT_WITHIN] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"~(&0 < norm(x - y:real^N)) ==> x = y")) THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_WITHIN]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:real^1->real^1) a - m) / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, IN_INTER, IN_ELIM_THM, ← GSYM DIST_NZ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMPT_APPROACHABLE]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN
    ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM, ← GSYM DIST_NZ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^1") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"IMAGE (f:real^1->real^1) (segment(a,b))", ← q r"(f:real^1->real^1) a"]
     CONNECTED_INSERT) THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, SEGMENT_EQ_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q) /\ ~r ==> ~(p ==> (q <=> r))")) THEN
    (CONJ_TAC THENL
      [REWRITE_TAC [← GSYM (← CONJUNCT2 IMAGE_CLAUSES)] THEN
       CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_SIMP_TAC [CONNECTED_INSERT, CONNECTED_SEGMENT] THEN
       ASM_REWRITE_TAC [CLOSURE_SEGMENT, ENDS_IN_SEGMENT, INSERT_SUBSET] THEN
       ASM_MESON_TAC [CONVEX_CONTAINS_OPEN_SEGMENT, IS_INTERVAL_CONVEX_1],
       DISCH_THEN (MP_TAC o
         SPEC (← q r"closure(ball(m,norm((f:real^1->real^1) a - m) / &2))") o
         MATCH_MP (← SET_RULE (← q r"a IN s ==> !t. s SUBSET t ==> a IN t"))) THEN
       REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
        [MATCH_MP_TAC SUBSET_CLOSURE THEN
         REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:real^1") THEN
         REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
         TRY (RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
             ASM_REAL_ARITH_TAC) THEN
         REWRITE_TAC [IN_INTERVAL_1, IN_BALL] THEN STRIP_TAC THEN
         ONCE_REWRITE_TAC [DIST_SYM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         ASM_REWRITE_TAC [← GSYM DROP_EQ, DIST_1, ← GSYM CONJ_ASSOC] THEN
         RULE_ASSUM_TAC (REWRITE_RULE [DIST_1, IS_INTERVAL_1]) THEN
         (CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC]) THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [REAL_LT_IMP_LE],
         ASM_SIMP_TAC [CLOSURE_BALL, REAL_HALF, IN_CBALL] THEN
         MATCH_MP_TAC (← NORM_ARITH
          (← q r"&0 < norm(y - x) ==> ~(dist(x:real^N,y) <= norm(y - x) / &2)")) THEN
         ASM_REWRITE_TAC []]]))

  return { SIMPLE_PATH_ENDLESS, PATH_CONNECTED_SIMPLE_PATH_ENDLESS,
           CONNECTED_SIMPLE_PATH_ENDLESS, NONEMPTY_SIMPLE_PATH_ENDLESS,
           CONNECTED_ARC_IMAGE_DELETE, CONNECTED_SIMPLE_PATH_IMAGE_DELETE,
           HOMEOMORPHIC_SIMPLE_PATH_ARC, HOMEOMORPHIC_SIMPLE_PATH_ARC_EQ, ARC_ENDS_UNIQUE,
           ARC_HOMEOMORPHISM_ENDS, HOMEOMORPHISM_ARC_IMAGES, COLLINEAR_SIMPLE_PATH_IMAGE,
           INJECTIVE_INTO_1D_EQ_HOMEOMORPHISM, INJECTIVE_INTO_1D_IMP_OPEN_MAP,
           HOMEOMORPHISM_INTO_1D, CONTINUOUS_INJECTIVE_IFF_MONOTONIC,
           CONTINUOUS_INJECTIVE_IMP_MONOTONIC, HOMEOMORPHISM_1D_IMP_MONOTONIC,
           CONVEXITY_PRESERVING, CONVEXITY_PRESERVING_ALT,
           DARBOUX_AND_REGULATED_IMP_CONTINUOUS }

/- ------------------------------------------------------------------------- -/
/- Some handy facts about Lipschitz functions; some uncountability results   -/
/- for relevant sets.  (paths.ml 4032-4449)                                  -/
/- ------------------------------------------------------------------------- -/

structure PTO where
  LIPSCHITZ_ON_UNION : thm
  LIPSCHITZ_ON_COMBINE : thm
  LOCALLY_LIPSCHITZ_GEN : thm
  LOCALLY_LIPSCHITZ : thm
  CARD_EQ_SEGMENT : thm
  UNCOUNTABLE_SEGMENT : thm
  CARD_EQ_PATH_CONNECTED : thm
  UNCOUNTABLE_PATH_CONNECTED : thm
  CARD_EQ_CONVEX : thm
  UNCOUNTABLE_CONVEX : thm
  CARD_EQ_NONEMPTY_INTERIOR : thm
  UNCOUNTABLE_NONEMPTY_INTERIOR : thm
  COUNTABLE_EMPTY_INTERIOR : thm
  CONNECTED_FINITE_IFF_SING : thm
  CONNECTED_FINITE_IFF_COUNTABLE : thm
  CONNECTED_INFINITE_IFF_CARD_EQ : thm
  CONNECTED_FINITE_EQ_LOWDIM : thm
  CLOSED_AS_FRONTIER_OF_SUBSET : thm
  CLOSED_AS_FRONTIER : thm
  CARD_EQ_PERFECT_SET : thm
  CARD_EQ_CLOSED : thm
  CONDENSATION_POINTS_EQ_EMPTY : thm
  CARD_EQ_CONDENSATION_POINTS : thm
  UNCOUNTABLE_HAS_CONDENSATION_POINT : thm
  deriving Inhabited

@[nospecialize]
def setupPTO [HolBase] (D : PathsDeps) (BL : PTL) : ExceptT String IO PTO := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, NORM_ARITH,
        .. } := D.cvx
  let { AND_FORALL_THM, CONTRAPOS_THM, DE_MORGAN_THM, EXTENSION, FINITE_EMPTY, FINITE_INSERT,
        .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT,
        INTERS_GSPEC, INTER_SUBSET, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, REAL_ADD_LDISTRIB, .. } := D.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_LDIV_EQ, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } :=
    D.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_SUB_0, REAL_SUB_LE, SIMPLE_IMAGE,
        SUBSET, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNION_EMPTY, UNIV_NOT_EMPTY, o_DEF, real_ge, .. } := D.cvx.core6
  let { BETWEEN_SYM, COLLINEAR_BETWEEN_CASES, DIST_EQ_0, DIST_NZ, DIST_POS_LE, DIST_REFL,
        DIST_SYM, .. } := D.cvx.vec1
  let { DROP_EQ, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB, NORM_0, .. } :=
    D.cvx.vec2
  let { NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.cvx.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, VECTOR_SUB_REFL, dist, drop, .. } := D.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.cvx.met
  let { BETWEEN_IN_SEGMENT, CLOSED_HALFSPACE_COMPONENT_GE, CLOSED_SING, CLOSURE_CLOSED, .. } :=
    D.cvx.top1
  let { CONNECTED_CLOPEN, CONNECTED_SEGMENT, .. } := D.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_SUB,
        CONTINUOUS_WITHIN_SUBSET, DIST_IN_CLOSED_SEGMENT, ENDS_IN_SEGMENT, ENDS_NOT_IN_SEGMENT,
        EVENTUALLY_WITHIN, FRONTIER_CLOSED, .. } := D.cvx.top3
  let { INTERIOR_SUBSET, INTERVAL_NE_EMPTY_1, IN_INTERVAL_1, IS_INTERVAL_INTERVAL, .. } :=
    D.cvx.top4
  let { OPEN_INTERIOR, OPEN_UNIV, SEGMENT_CLOSED_OPEN, SEGMENT_OPEN_SUBSET_CLOSED,
        SEGMENT_REFL, SUBSET_CLOSURE, UNIT_INTERVAL_NONEMPTY, continuous_within, frontier,
        open_in, .. } := D.cvx.top5
  let { COUNTABLE, INFINITE, .. } := D.pses1
  let { REAL_LE_TRANS_LTE, ge_c, real_INFINITE, .. } := D.pses2
  let { BETWEEN_TRANS, COLLINEAR_1, between, .. } := D.pvec
  let { CARD_COUNTABLE_CONG, CARD_EQ_IMAGE, CARD_EQ_IMP_LE, CARD_EQ_REAL_IMP_UNCOUNTABLE,
        CARD_EQ_SYM, CARD_EQ_TRANS, CARD_FINITE_CONG, CARD_LE_ANTISYM,
        CARD_LE_COUNTABLE_INFINITE, CARD_LE_SUBSET, CARD_LE_TRANS, CARD_LE_UNIV,
        CARD_LT_IMP_LE, CARD_LT_NUM_REAL, CARD_UNION_ABSORB_RIGHT, COUNTABLE_ALT,
        COUNTABLE_SUBSET, FINITE_IMP_COUNTABLE, INFINITE_CARD_LE, .. } := D.pcard
  let { CARD_GE_PERFECT_SET, CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_INTERS,
        CLOSED_IN_UNION, .. } := D.pmet1
  let { CANTOR_BENDIXSON, CARD_EQ_CONDENSATION_POINTS_IN_SET, CARD_EQ_CONNECTED,
        CARD_EQ_EUCLIDEAN, CARD_EQ_INTERVAL, CARD_EQ_OPEN, CLOSED_CONDENSATION_POINTS,
        CLOSED_IN_REFL, CLOSED_LIMPT, COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN, .. } := D.ptop1
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_LIFT_DIST, EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF,
        FORALL_IN_CLOSURE_EQ, .. } := D.ptop3
  let { INTER_INTERVAL_1, .. } := D.ptop4
  let { SEPARABLE, SUBSET_INTERVAL_1, UNION_INTERVAL_1, condensation_point_of, .. } := D.ptop5
  let { AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFF_DIM_GE, CLOSURE_SEGMENT, .. } := D.pcvx1
  let { CONVEX_CONTAINS_SEGMENT, IS_INTERVAL_CONVEX_1, SEGMENT_EQ_EMPTY, SEGMENT_IMAGE_INTERVAL,
        SUBSET_SEGMENT, UNION_SEGMENT, .. } := D.pcvx2
  let { CONVEX_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED, .. } := BL
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Some handy facts about Lipschitz functions.                             -/
  /- ----------------------------------------------------------------------- -/

  let LIPSCHITZ_ON_UNION ← prove
   r"!(f:real^1->real^N) s t l.
        is_interval s /\ is_interval t /\ ~(s INTER t = {}) /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= l * norm(x - y)) /\
        (!x y. x IN t /\ y IN t ==> norm(f x - f y) <= l * norm(x - y))
        ==> !x y. x IN s UNION t /\ y IN s UNION t
                  ==> norm(f x - f y) <= l * norm(x - y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← MESON []
     (← q r"!Q. (!x y. P x y <=> P y x) /\
          (!x y. ~Q x /\ ~Q y ==> P x y) /\
          (!x y. Q x /\ Q y ==> P x y) /\
          (!x y. ~Q x /\ Q y ==> P x y)
      ==> !x y. P x y")) THEN
    EXISTS_TAC (← q r"\x:real^1. x IN s") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(x IN s) ==> (x IN s UNION t <=> x IN t)")] THEN
    CONJ_TAC THENL [MESON_TAC [NORM_SUB], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    STRIP_TAC THEN DISCH_THEN (ASSUME_TAC o CONJUNCT1) THEN
    ASM_CASES_TAC (← q r"(y:real^1) IN t") THEN ASM_SIMP_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:real^1") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"{z:real^1,x,y}") COLLINEAR_1) THEN
    REWRITE_TAC [COLLINEAR_BETWEEN_CASES] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
     [REWRITE_TAC [between, dist] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [REAL_ADD_LDISTRIB] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"norm((f:real^1->real^N) x - f z) + norm(f z - f y)") THEN
      CONJ_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), ASM_MESON_TAC [REAL_LE_ADD2]],
      RULE_ASSUM_TAC (REWRITE_RULE [IS_INTERVAL_CONVEX_1]) THEN
      REWRITE_TAC [BETWEEN_IN_SEGMENT] THEN
      ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET]])

  let LIPSCHITZ_ON_COMBINE ← prove
   r"!(f:real^1->real^N) a b c l.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b]
               ==> norm(f x - f y) <= l * norm(x - y)) /\
        (!x y. x IN interval[b,c] /\ y IN interval[b,c]
               ==> norm(f x - f y) <= l * norm(x - y))
        ==> !x y. x IN interval[a,c] /\ y IN interval[a,c]
                  ==> norm(f x - f y) <= l * norm(x - y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,c] = {}") THENL
     [ASM_MESON_TAC [NOT_IN_EMPTY],
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1])] THEN
    ASM_CASES_TAC (← q r"interval[a,c] SUBSET interval[a,b] \/
                   interval[a:real^1,c] SUBSET interval[b,c]")
    THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"b IN interval[a:real^1,c]") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL, IN_INTERVAL_1] THEN
      ASM_REAL_ARITH_TAC,
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP UNION_INTERVAL_1) THEN
      MATCH_MP_TAC LIPSCHITZ_ON_UNION THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
      REWRITE_TAC [INTER_INTERVAL_1, INTERVAL_NE_EMPTY_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC])

  let LOCALLY_LIPSCHITZ_GEN ← prove
   r"!f:real^M->real^N s b.
        convex s /\
        (!x c. x IN s /\ b < c
               ==> eventually (\y. norm(f y - f x) <= c * norm(y - x))
                              (at x within s))
        ==> !x y. x IN s /\ y IN s ==> norm(f x - f y) <= b * norm(x - y)"
   (← do
    let lemma ← prove
     r"{x | x IN s /\ !y. P x y} =
       s INTER INTERS {{x | x IN s /\ P x y} | y IN UNIV}"
     (REWRITE_TAC [INTERS_GSPEC] THEN SET_TAC [])
    pure (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x:real^M = y") THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO, REAL_LE_REFL] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    GEN_REWRITE_TAC id [REAL_LE_TRANS_LTE] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
    X_GEN_TAC (← q r"c:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"x:real^M", ← q r"y:real^M"] (← CONJUNCT1 CONNECTED_SEGMENT)) THEN
    REWRITE_TAC [CONNECTED_CLOPEN] THEN DISCH_THEN (MP_TAC o SPEC
     (← q r"{z | z IN segment[x,y] /\
          !t. t IN segment[x,z]
              ==> norm((f:real^M->real^N) t - f x) <= c * norm(t - x)}")) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"] o MATCH_MP (← SET_RULE
       (← q r"!a b. {x | x IN s /\ P x} = {} \/ {x | x IN s /\ P x} = s
              ==> a IN s /\ b IN s /\ P a ==> P b"))) THEN
      REWRITE_TAC [ENDS_IN_SEGMENT, DIST_REFL, DIST_POS_LE] THEN
      REWRITE_TAC [SEGMENT_REFL, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO, REAL_LE_REFL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y:real^M")) THEN
      REWRITE_TAC [ENDS_IN_SEGMENT, NORM_SUB]] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [open_in, SUBSET_RESTRICT, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"z:real^M") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"z:real^M", ← q r"c:real"]) THEN
      ASM_REWRITE_TAC [EVENTUALLY_WITHIN] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"u:real^M") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"v:real^M") THEN
      DISCH_TAC THEN
      ASM_CASES_TAC (← q r"v IN segment[x:real^M,z]") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o C MATCH_MP
       (← MESON [ENDS_IN_SEGMENT] (← q r"z IN segment[x:real^M,z]"))) THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(v - z:real^N) <= d - c
        ==> norm(z - x) <= c ==> norm(v - x) <= d")) THEN
      SUBGOAL_THEN (← q r"v IN segment[x:real^M,y] /\ ~(u IN segment[x:real^M,z])")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [BETWEEN_TRANS, BETWEEN_IN_SEGMENT, BETWEEN_SYM],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"u IN segment[z:real^M,y] /\ v IN segment[z,y]")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"x:real^M", ← q r"z:real^M", ← q r"y:real^M"]
          UNION_SEGMENT) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"c * norm(v - z:real^M)") THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [← GSYM DIST_NZ] THEN CONJ_TAC
        THENL [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET], ALL_TAC] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [ENDS_IN_SEGMENT], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"v IN segment[z:real^M,u]") ASSUME_TAC THENL
         [ALL_TAC,
          ASM_MESON_TAC [DIST_IN_CLOSED_SEGMENT, REAL_LET_TRANS, DIST_SYM]],
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC (← REAL_RING
         (← q r"z = x + y:real ==> c * x = c * z - c * y"))] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM BETWEEN_IN_SEGMENT, between]) THEN
      REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, ← GSYM dist, between] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [DIST_SYM] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"{z | z IN segment [x,y] /\
           !t. t IN segment[x,z]
               ==> norm((f:real^M->real^N) t - f x) <= c * norm (t - x)} =
      {z | z IN segment [x,y] /\
           !t. t IN segment(x,z) ==> norm(f t - f x) <= c * norm(t - x)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"z:real^M") THEN
      ASM_CASES_TAC (← q r"z IN segment[x:real^M,y]") THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"z:real^M = x") THEN
      ASM_REWRITE_TAC [SEGMENT_REFL, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO, REAL_LE_REFL] THEN
      MP_TAC (← ISPECL
       [← q r"\t. lift(c * norm(t - x) - norm((f:real^M->real^N) t - f x))",
        ← q r"segment(x:real^M,z)", ← q r"{t | &0 <= drop t}"]
       FORALL_IN_CLOSURE_EQ) THEN
      ASM_REWRITE_TAC [CLOSURE_SEGMENT, IN_ELIM_THM, LIFT_DROP, REAL_SUB_LE] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [CLOSED_SING, drop,
                  ← REWRITE_RULE [real_ge] CLOSED_HALFSPACE_COMPONENT_GE] THEN
      REWRITE_TAC [LIFT_SUB, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUB THEN CONJ_TAC THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_CMUL) THEN
      MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"w:real^M") THEN DISCH_TAC THEN
      MATCH_MP_TAC CONTINUOUS_WITHIN_SUBSET THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"segment[x:real^M,y]") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT]] THEN
        ASM_REWRITE_TAC [SUBSET_SEGMENT, ENDS_IN_SEGMENT],
        DISCH_TAC] THEN
      REWRITE_TAC [continuous_within] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^M", ← q r"abs b + &1"]) THEN
      REWRITE_TAC [← ARITH_RULE (← q r"b < abs b + &1")] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [EVENTUALLY_WITHIN]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d (e / (abs b + &1))") THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_MUL_LZERO, dist, REAL_LT_MIN,
                   ← REAL_ARITH (← q r"&0 < abs b + &1")] THEN
      X_GEN_TAC (← q r"v:real^M") THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^M")) THEN
      ASM_CASES_TAC (← q r"v:real^M = w") THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, ← GSYM DIST_NZ] THEN
      ASM_REWRITE_TAC [dist] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [lemma] THEN
    MATCH_MP_TAC CLOSED_IN_INTER THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
    MATCH_MP_TAC CLOSED_IN_INTERS THEN
    REWRITE_TAC [SIMPLE_IMAGE, IMAGE_EQ_EMPTY, SEGMENT_EQ_EMPTY] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, UNIV_NOT_EMPTY, ← SET_RULE
     (← q r"{x | x IN s /\ (P x ==> Q x)} =
      {x | x IN s /\ ~P x} UNION {x | x IN s /\ Q x}")] THEN
    X_GEN_TAC (← q r"z:real^M") THEN MATCH_MP_TAC CLOSED_IN_UNION THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P} = if P then s else {}")] THEN
    CONJ_TAC THENL [ALL_TAC, MESON_TAC [CLOSED_IN_REFL, CLOSED_IN_EMPTY]] THEN
    ASM_CASES_TAC (← q r"z IN segment[x:real^M,y]") THENL
     [SUBGOAL_THEN
       (← q r"{w:real^M | w IN segment[x,y] /\ ~(z IN segment (x,w))} =
        {w | w IN segment[x,y] /\ (z = x \/ z IN segment[w,y])}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN X_GEN_TAC (← q r"w:real^M") THEN
        MP_TAC (← ISPECL [← q r"x:real^M", ← q r"w:real^M", ← q r"y:real^M"]
          UNION_SEGMENT) THEN
        ASM_CASES_TAC (← q r"w IN segment[x:real^M,y]") THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"z:real^M") o REWRITE_RULE [EXTENSION]) THEN
        ASM_REWRITE_TAC [IN_UNION] THEN
        MP_TAC (← ISPECL [← q r"x:real^M", ← q r"w:real^M"] SEGMENT_CLOSED_OPEN) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"z:real^M") o REWRITE_RULE [EXTENSION]) THEN
        ASM_REWRITE_TAC [IN_UNION, IN_INSERT, NOT_IN_EMPTY] THEN
        MAP_EVERY ASM_CASES_TAC [← q r"z:real^M = x", ← q r"z:real^M = w"] THEN
        ASM_REWRITE_TAC [ENDS_NOT_IN_SEGMENT, ENDS_IN_SEGMENT] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC (← TAUT (← q r"~(p /\ q) ==> p \/ q ==> (~p <=> q)")) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM BETWEEN_IN_SEGMENT, between]) THEN
        REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, ← GSYM dist, between] THEN
        REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [DIST_SYM] THEN
        REWRITE_TAC [← GSYM DIST_EQ_0, DIST_SYM] THEN REAL_ARITH_TAC,
        ASM_CASES_TAC (← q r"z:real^M = x") THEN
        ASM_REWRITE_TAC [CLOSED_IN_REFL, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
        REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, between] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH
          (← q r"a:real = b /\ c = d <=> a = b /\ d - c = &0")] THEN
        REWRITE_TAC [← GSYM between, BETWEEN_IN_SEGMENT] THEN
        REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
        REWRITE_TAC [← GSYM IN_SING] THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE THEN
        REWRITE_TAC [CLOSED_SING, LIFT_SUB, LIFT_ADD] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUB THEN CONJ_TAC THEN
        TRY (MATCH_MP_TAC CONTINUOUS_ON_ADD) THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_DIST]],
      MATCH_MP_TAC (← MESON [CLOSED_IN_REFL]
       (← q r"s = t ==> closed_in (subtopology euclidean t) s")) THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      X_GEN_TAC (← q r"w:real^M") THEN
      EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
         SEGMENT_OPEN_SUBSET_CLOSED)) THEN
      ASM_MESON_TAC [BETWEEN_TRANS, BETWEEN_IN_SEGMENT, BETWEEN_SYM]]))

  let LOCALLY_LIPSCHITZ ← prove
   r"!f:real^M->real^N s b.
        convex s /\
        (!x. x IN s
             ==> eventually (\y. norm(f y - f x) <= b * norm(y - x))
                            (at x within s))
        ==> !x y. x IN s /\ y IN s ==> norm(f x - f y) <= b * norm(x - y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_LIPSCHITZ_GEN THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"c:real"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"y:real^M") THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE])

  /- ----------------------------------------------------------------------- -/
  /- Some uncountability results for relevant sets.                          -/
  /- ----------------------------------------------------------------------- -/

  let CARD_EQ_SEGMENT ← prove
   r"(!a b:real^N. ~(a = b) ==> segment[a,b] =_c (:real)) /\
   (!a b:real^N. ~(a = b) ==> segment(a,b) =_c (:real))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SEGMENT_IMAGE_INTERVAL] THENL
     [TRANS_TAC CARD_EQ_TRANS (← q r"interval[vec 0:real^1,vec 1]"),
      TRANS_TAC CARD_EQ_TRANS (← q r"interval(vec 0:real^1,vec 1)")] THEN
    SIMP_TAC [CARD_EQ_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
    MATCH_MP_TAC CARD_EQ_IMAGE THEN
    ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, ← VECTOR_ARITH
     (← q r"(&1 - x) % a + x % b:real^N = (&1 - y) % a + y % b <=>
      (x - y) % (a - b) = vec 0")] THEN
    SIMP_TAC [REAL_SUB_0, DROP_EQ])

  let UNCOUNTABLE_SEGMENT ← prove
   r"(!a b:real^N. ~(a = b) ==> ~COUNTABLE(segment[a,b])) /\
   (!a b:real^N. ~(a = b) ==> ~COUNTABLE(segment(a,b)))"
   (SIMP_TAC [CARD_EQ_REAL_IMP_UNCOUNTABLE, CARD_EQ_SEGMENT])

  let CARD_EQ_PATH_CONNECTED ← prove
   r"!s a b:real^N.
        path_connected s /\ a IN s /\ b IN s /\ ~(a = b) ==> s =_c (:real)"
   (MESON_TAC [CARD_EQ_CONNECTED, PATH_CONNECTED_IMP_CONNECTED])

  let UNCOUNTABLE_PATH_CONNECTED ← prove
   r"!s a b:real^N.
        path_connected s /\ a IN s /\ b IN s /\ ~(a = b) ==> ~COUNTABLE s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CARD_EQ_REAL_IMP_UNCOUNTABLE THEN
    MATCH_MP_TAC CARD_EQ_PATH_CONNECTED THEN
    ASM_MESON_TAC [])

  let CARD_EQ_CONVEX ← prove
   r"!s a b:real^N.
        convex s /\ a IN s /\ b IN s /\ ~(a = b) ==> s =_c (:real)"
   (MESON_TAC [CARD_EQ_PATH_CONNECTED, CONVEX_IMP_PATH_CONNECTED])

  let UNCOUNTABLE_CONVEX ← prove
   r"!s a b:real^N.
        convex s /\ a IN s /\ b IN s /\ ~(a = b) ==> ~COUNTABLE s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CARD_EQ_REAL_IMP_UNCOUNTABLE THEN
    MATCH_MP_TAC CARD_EQ_CONVEX THEN
    ASM_MESON_TAC [])

  let CARD_EQ_NONEMPTY_INTERIOR ← prove
   r"!s:real^N->bool. ~(interior s = {}) ==> s =_c (:real)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      SIMP_TAC [CARD_LE_UNIV, CARD_EQ_IMP_LE, CARD_EQ_EUCLIDEAN],
      TRANS_TAC CARD_LE_TRANS (← q r"interior(s:real^N->bool)") THEN
      SIMP_TAC [CARD_LE_SUBSET, INTERIOR_SUBSET] THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE) THEN
      MATCH_MP_TAC CARD_EQ_OPEN THEN ASM_REWRITE_TAC [OPEN_INTERIOR]])

  let UNCOUNTABLE_NONEMPTY_INTERIOR ← prove
   r"!s:real^N->bool. ~(interior s = {}) ==> ~(COUNTABLE s)"
   (SIMP_TAC [CARD_EQ_NONEMPTY_INTERIOR, CARD_EQ_REAL_IMP_UNCOUNTABLE])

  let COUNTABLE_EMPTY_INTERIOR ← prove
   r"!s:real^N->bool. COUNTABLE s ==> interior s = {}"
   (MESON_TAC [UNCOUNTABLE_NONEMPTY_INTERIOR])

  let [CONNECTED_FINITE_IFF_SING,
       CONNECTED_FINITE_IFF_COUNTABLE,
       CONNECTED_INFINITE_IFF_CARD_EQ] := CONJUNCTS (← prove
   r"(!s:real^N->bool. connected s ==> (FINITE s <=> s = {} \/ ?a. s = {a})) /\
   (!s:real^N->bool. connected s ==> (FINITE s <=> COUNTABLE s)) /\
   (!s:real^N->bool. connected s ==> (INFINITE s <=> s =_c (:real)))"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
    ASM_CASES_TAC (← q r"connected(s:real^N->bool)") THEN
    ASM_REWRITE_TAC [INFINITE] THEN MATCH_MP_TAC (← TAUT
     (← q r"(f ==> c) /\ (r ==> ~c) /\ (s ==> f) /\ (~s ==> r)
      ==> (f <=> s) /\ (f <=> c) /\ (~f <=> r)")) THEN
    REWRITE_TAC [FINITE_IMP_COUNTABLE] THEN
    REPEAT CONJ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CARD_EQ_REAL_IMP_UNCOUNTABLE, FINITE_INSERT, FINITE_EMPTY] THEN
    MATCH_MP_TAC CARD_EQ_CONNECTED THEN ASM SET_TAC []))
    | throw "CONNECTED_FINITE_IFF_SING: CONJUNCTS"

  let CONNECTED_FINITE_EQ_LOWDIM ← prove
   r"!s:real^N->bool. connected s ==> (FINITE s <=> aff_dim s <= &0)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [CONNECTED_FINITE_IFF_SING] THEN
    REWRITE_TAC [← GSYM AFF_DIM_EQ_0, ← GSYM AFF_DIM_EQ_MINUS1] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") AFF_DIM_GE) THEN INT_ARITH_TAC)

  let CLOSED_AS_FRONTIER_OF_SUBSET ← prove
   r"!s:real^N->bool. closed s <=> ?t. t SUBSET s /\ s = frontier t"
   (GEN_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC [FRONTIER_CLOSED]] THEN
    DISCH_TAC THEN MP_TAC (← ISPEC (← q r"s:real^N->bool") SEPARABLE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^N->bool") THEN
    SIMP_TAC [frontier] THEN STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET c /\ c SUBSET s /\ i = {} ==> s = c DIFF i")) THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SUBSET_CLOSURE, CLOSURE_CLOSED],
      ASM_MESON_TAC [UNCOUNTABLE_NONEMPTY_INTERIOR]])

  let CLOSED_AS_FRONTIER ← prove
   r"!s:real^N->bool. closed s <=> ?t. s = frontier t"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [CLOSED_AS_FRONTIER_OF_SUBSET], MESON_TAC [FRONTIER_CLOSED]])

  let CARD_EQ_PERFECT_SET ← prove
   r"!s:real^N->bool.
        closed s /\ (!x. x IN s ==> x limit_point_of s) /\ ~(s = {})
        ==> s =_c (:real)"
   (REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN REPEAT STRIP_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      SIMP_TAC [CARD_LE_UNIV, CARD_EQ_IMP_LE, CARD_EQ_EUCLIDEAN],
      MATCH_MP_TAC CARD_GE_PERFECT_SET THEN
      EXISTS_TAC (← q r"euclidean:(real^N)topology") THEN
      ASM_REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN] THEN
      REWRITE_TAC [EUCLIDEAN_DERIVED_SET_OF_IFF_LIMIT_POINT_OF] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      ASM_MESON_TAC [CLOSED_LIMPT]])

  let CARD_EQ_CLOSED ← prove
   r"!s:real^N->bool. closed s ==> s <=_c (:num) \/ s =_c (:real)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP CANTOR_BENDIXSON) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"d:real^N->bool"] THEN
    ASM_CASES_TAC (← q r"c:real^N->bool = {}") THEN
    ASM_SIMP_TAC [UNION_EMPTY, ← GSYM ge_c, ← GSYM COUNTABLE] THEN
    STRIP_TAC THEN DISJ2_TAC THEN TRANS_TAC CARD_EQ_TRANS (← q r"c:real^N->bool") THEN
    ASM_SIMP_TAC [CARD_EQ_PERFECT_SET] THEN
    MATCH_MP_TAC CARD_UNION_ABSORB_RIGHT THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    ASM_SIMP_TAC [CARD_LE_COUNTABLE_INFINITE] THEN
    REWRITE_TAC [INFINITE_CARD_LE] THEN TRANS_TAC CARD_LE_TRANS (← q r"(:real)") THEN
    SIMP_TAC [CARD_LT_NUM_REAL, CARD_LT_IMP_LE] THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    ASM_SIMP_TAC [CARD_EQ_PERFECT_SET])

  let (CONDENSATION_POINTS_EQ_EMPTY, CARD_EQ_CONDENSATION_POINTS) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        {x | x condensation_point_of s} = {} <=> COUNTABLE s) /\
   (!s:real^N->bool.
        {x | x condensation_point_of s} =_c (:real) <=> ~(COUNTABLE s))"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"(r ==> p) /\ (~r ==> q) /\ (p ==> ~q)
      ==> (p <=> r) /\ (q <=> ~r)")) THEN
    REPEAT CONJ_TAC THENL
     [DISCH_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      REWRITE_TAC [condensation_point_of] THEN
      ASM_MESON_TAC [COUNTABLE_SUBSET, INTER_SUBSET, IN_UNIV, OPEN_UNIV],
      DISCH_TAC THEN MATCH_MP_TAC (← REWRITE_RULE
       [← TAUT (← q r"p ==> q \/ r <=> p /\ ~q ==> r")] CARD_EQ_CLOSED) THEN
      REWRITE_TAC [CLOSED_CONDENSATION_POINTS, ← GSYM COUNTABLE_ALT] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CARD_EQ_CONDENSATION_POINTS_IN_SET) THEN
      DISCH_THEN (MP_TAC o MATCH_MP CARD_COUNTABLE_CONG) THEN
      ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN SET_TAC [],
      DISCH_THEN SUBST1_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP CARD_FINITE_CONG) THEN
      REWRITE_TAC [FINITE_EMPTY, ← GSYM INFINITE, real_INFINITE]]))

  let UNCOUNTABLE_HAS_CONDENSATION_POINT ← prove
   r"!s:real^N->bool. ~COUNTABLE s ==> ?x. x condensation_point_of s"
   (REWRITE_TAC [← GSYM CONDENSATION_POINTS_EQ_EMPTY] THEN SET_TAC [])

  return { LIPSCHITZ_ON_UNION, LIPSCHITZ_ON_COMBINE, LOCALLY_LIPSCHITZ_GEN, LOCALLY_LIPSCHITZ,
           CARD_EQ_SEGMENT, UNCOUNTABLE_SEGMENT, CARD_EQ_PATH_CONNECTED,
           UNCOUNTABLE_PATH_CONNECTED, CARD_EQ_CONVEX, UNCOUNTABLE_CONVEX,
           CARD_EQ_NONEMPTY_INTERIOR, UNCOUNTABLE_NONEMPTY_INTERIOR, COUNTABLE_EMPTY_INTERIOR,
           CONNECTED_FINITE_IFF_SING, CONNECTED_FINITE_IFF_COUNTABLE,
           CONNECTED_INFINITE_IFF_CARD_EQ, CONNECTED_FINITE_EQ_LOWDIM,
           CLOSED_AS_FRONTIER_OF_SUBSET, CLOSED_AS_FRONTIER, CARD_EQ_PERFECT_SET,
           CARD_EQ_CLOSED, CONDENSATION_POINTS_EQ_EMPTY, CARD_EQ_CONDENSATION_POINTS,
           UNCOUNTABLE_HAS_CONDENSATION_POINT }

/- ------------------------------------------------------------------------- -/
/- Density of sets with small complement, including irrationals.             -/
/- (paths.ml 4450-4575)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTP where
  COSMALL_APPROXIMATION : thm
  COCOUNTABLE_APPROXIMATION : thm
  OPEN_SET_COSMALL_COORDINATES : thm
  OPEN_SET_COCOUNTABLE_COORDINATES : thm
  OPEN_SET_IRRATIONAL_COORDINATES : thm
  CLOSURE_COSMALL_COORDINATES : thm
  CLOSURE_COCOUNTABLE_COORDINATES : thm
  CLOSURE_IRRATIONAL_COORDINATES : thm
  deriving Inhabited

@[nospecialize]
def setupPTP [HolBase] (D : PathsDeps) : ExceptT String IO PTP := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, .. } := D.cvx
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, EQ_IMP, EXTENSION, FINITE_NUMSEG, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LE_1, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_LT,
        NUMSEG_EMPTY, REAL_ABS_SUB, .. } := D.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_LT, SUBSET, .. } := D.cvx.core5
  let { LAMBDA_SKOLEM, .. } := D.cvx.misc
  let { DIST_SYM, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_SUB, EXISTS_DROP, FORALL_DROP, NORM_1, .. } := D.cvx.vec2
  let { NORM_LE_L1, .. } := D.cvx.vec3
  let { VECTOR_SUB_COMPONENT, dist, .. } := D.cvx.vec4
  let { BALL_EQ_EMPTY, CLOSURE_APPROACHABLE, .. } := D.cvx.top1
  let { IN_BALL, IN_CBALL, OPEN_BALL, OPEN_CONTAINS_CBALL, .. } := D.cvx.top4
  let { COUNTABLE, IMAGE_DIFF_INJ, .. } := D.pses1
  let { SUM_BOUND_GEN, ge_c, .. } := D.pses2
  let { DROP_IN_IMAGE_DROP, FORALL_DROP_IMAGE, IMAGE_DROP_UNIV, .. } := D.pvec
  let { COUNTABLE_RATIONAL, .. } := D.pmisc
  let { CANTOR_THM_UNIV, CARD_EQ_IMAGE, CARD_EQ_IMP_LE, CARD_EQ_REAL, CARD_EQ_REFL,
        CARD_EQ_SYM, CARD_LET_TRANS, CARD_LE_SUBSET, CARD_LTE_TRANS, CARD_LT_CONG,
        CARD_NOT_LE, COUNTABLE_ALT, .. } := D.pcard
  let { CARD_EQ_OPEN, .. } := D.ptop1
  let { ball, .. } := D.ptop5
  -- @@SCOPE END

  let COSMALL_APPROXIMATION ← prove
   r"!s. ((:real) DIFF s) <_c (:real)
       ==> !x e. &0 < e ==> ?y. y IN s /\ abs(y - x) < e"
   (← do
    let lemma ← prove
     r"!s. ((:real^1) DIFF s) <_c (:real)
           ==> !x e. &0 < e ==> ?y. y IN s /\ norm(y - x) < e"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE
        (← q r"~({x | P x} SUBSET UNIV DIFF s) ==> ?x. x IN s /\ P x")) THEN
      MP_TAC (← ISPEC (← q r"ball(x:real^1,e)") CARD_EQ_OPEN) THEN
      ASM_REWRITE_TAC [OPEN_BALL, BALL_EQ_EMPTY, REAL_NOT_LE] THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_SUBSET) THEN
      REWRITE_TAC [CARD_NOT_LE] THEN
      REWRITE_TAC [← GSYM (← ONCE_REWRITE_RULE [DIST_SYM] dist), ← GSYM ball] THEN
      TRANS_TAC CARD_LTE_TRANS (← q r"(:real)") THEN
      ASM_SIMP_TAC [← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE])
    pure (REWRITE_TAC [FORALL_DROP_IMAGE, FORALL_DROP, EXISTS_DROP] THEN
    REWRITE_TAC [← GSYM IMAGE_DROP_UNIV, ← GSYM DROP_SUB, ← GSYM NORM_1] THEN
    REWRITE_TAC [DROP_IN_IMAGE_DROP] THEN REWRITE_TAC [← GSYM FORALL_DROP] THEN
    SIMP_TAC [← GSYM IMAGE_DIFF_INJ, DROP_EQ] THEN GEN_TAC THEN
    DISCH_TAC THEN MATCH_MP_TAC lemma THEN POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_LT_CONG THEN
    REWRITE_TAC [IMAGE_DROP_UNIV, CARD_EQ_REFL] THEN
    MATCH_MP_TAC CARD_EQ_IMAGE THEN SIMP_TAC [DROP_EQ]))

  let COCOUNTABLE_APPROXIMATION ← prove
   r"!s. COUNTABLE((:real) DIFF s)
       ==> !x e. &0 < e ==> ?y. y IN s /\ abs(y - x) < e"
   (GEN_TAC THEN REWRITE_TAC [COUNTABLE, ge_c] THEN DISCH_TAC THEN
    MATCH_MP_TAC COSMALL_APPROXIMATION THEN
    TRANS_TAC CARD_LET_TRANS (← q r"(:num)") THEN ASM_REWRITE_TAC [] THEN
    TRANS_TAC CARD_LTE_TRANS (← q r"(:num->bool)") THEN SIMP_TAC [CANTOR_THM_UNIV] THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    REWRITE_TAC [CARD_EQ_REAL])

  let OPEN_SET_COSMALL_COORDINATES ← prove
   r"!P. (!i. 1 <= i /\ i <= dimindex(:N)
            ==> (:real) DIFF {x | P i x} <_c (:real))
       ==> !s:real^N->bool.
              open s /\ ~(s = {})
              ==> ?x. x IN s /\ !i. 1 <= i /\ i <= dimindex(:N) ==> P i (x$i)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?y:real. P i y /\ abs(y - (a:real^N)$i) < d / &(dimindex(:N))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP COSMALL_APPROXIMATION) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1],
      REWRITE_TAC [LAMBDA_SKOLEM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REPEAT STRIP_TAC THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_CBALL, dist] THEN
      W (MP_TAC o PART_MATCH lhand NORM_LE_L1 o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC SUM_BOUND_GEN THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      REWRITE_TAC [VECTOR_SUB_COMPONENT, NUMSEG_EMPTY, NOT_LT, DIMINDEX_GE_1] THEN
      ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, CARD_NUMSEG_1]])

  let OPEN_SET_COCOUNTABLE_COORDINATES ← prove
   r"!P. (!i. 1 <= i /\ i <= dimindex(:N)
            ==> COUNTABLE((:real) DIFF {x | P i x}))
       ==> !s:real^N->bool.
              open s /\ ~(s = {})
              ==> ?x. x IN s /\ !i. 1 <= i /\ i <= dimindex(:N) ==> P i (x$i)"
   (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC OPEN_SET_COSMALL_COORDINATES THEN
    REPEAT STRIP_TAC THEN
    TRANS_TAC CARD_LET_TRANS (← q r"(:num)") THEN ASM_SIMP_TAC [← GSYM COUNTABLE_ALT] THEN
    TRANS_TAC CARD_LTE_TRANS (← q r"(:num->bool)") THEN SIMP_TAC [CANTOR_THM_UNIV] THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    REWRITE_TAC [CARD_EQ_REAL])

  let OPEN_SET_IRRATIONAL_COORDINATES ← prove
   r"!s:real^N->bool.
        open s /\ ~(s = {})
        ==> ?x. x IN s /\ !i. 1 <= i /\ i <= dimindex(:N) ==> ~rational(x$i)"
   (MATCH_MP_TAC OPEN_SET_COCOUNTABLE_COORDINATES THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF {x | ~P x} = P"), COUNTABLE_RATIONAL])

  let CLOSURE_COSMALL_COORDINATES ← prove
   r"!P. (!i. 1 <= i /\ i <= dimindex(:N)
            ==> (:real) DIFF {x | P i x} <_c (:real))
       ==> closure {x | !i. 1 <= i /\ i <= dimindex (:N) ==> P i (x$i)} =
           (:real^N)"
   (GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [CLOSURE_APPROACHABLE, IN_UNIV, EXTENSION, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"e:real"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_SET_COSMALL_COORDINATES) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"ball(x:real^N,e)")) THEN
    ASM_REWRITE_TAC [OPEN_BALL, BALL_EQ_EMPTY, REAL_NOT_LE, IN_BALL] THEN
    MESON_TAC [DIST_SYM])

  let CLOSURE_COCOUNTABLE_COORDINATES ← prove
   r"!P. (!i. 1 <= i /\ i <= dimindex(:N)
            ==> COUNTABLE((:real) DIFF {x | P i x}))
       ==> closure {x | !i. 1 <= i /\ i <= dimindex (:N) ==> P i (x$i)} =
           (:real^N)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_COSMALL_COORDINATES THEN
    REPEAT STRIP_TAC THEN
    TRANS_TAC CARD_LET_TRANS (← q r"(:num)") THEN ASM_SIMP_TAC [← GSYM COUNTABLE_ALT] THEN
    TRANS_TAC CARD_LTE_TRANS (← q r"(:num->bool)") THEN SIMP_TAC [CANTOR_THM_UNIV] THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    REWRITE_TAC [CARD_EQ_REAL])

  let CLOSURE_IRRATIONAL_COORDINATES ← prove
   r"closure {x | !i. 1 <= i /\ i <= dimindex (:N) ==> ~rational(x$i)} =
   (:real^N)"
   (MATCH_MP_TAC CLOSURE_COCOUNTABLE_COORDINATES THEN
    REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF {x | ~P x} = P"), COUNTABLE_RATIONAL])

  return { COSMALL_APPROXIMATION, COCOUNTABLE_APPROXIMATION, OPEN_SET_COSMALL_COORDINATES,
           OPEN_SET_COCOUNTABLE_COORDINATES, OPEN_SET_IRRATIONAL_COORDINATES,
           CLOSURE_COSMALL_COORDINATES, CLOSURE_COCOUNTABLE_COORDINATES,
           CLOSURE_IRRATIONAL_COORDINATES }

/- ------------------------------------------------------------------------- -/
/- Every path between distinct points contains an arc, and hence that path   -/
/- connection is equivalent to arcwise connection, for distinct points. The  -/
/- proof is based on Whyburn's "Topological Analysis".  (paths.ml 4571-5947) -/
/- ------------------------------------------------------------------------- -/

structure PTQ where
  HOMEOMORPHIC_MONOTONE_IMAGE_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPTQ [HolBase] (D : PathsDeps) : ExceptT String IO PTQ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, NUM_REDUCE_CONV,
        REAL_RAT_REDUCE_CONV, NORM_ARITH, .. } := D.cvx
  let { prove_recursive_functions_exist, WF_INDUCT_TAC, .. } := D
  let { ADD1, ADD_SUB2, ADD_SYM, ARITH, ARITH_EQ, CONJ_ASSOC, DIMINDEX_1, EMPTY_SUBSET,
        EQ_SYM_EQ, ETA_AX, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXP, EXTENSION, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, INSERT_SUBSET, IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_1, LE_ADD, LE_REFL, LT_IMP_LE,
        LT_REFL, MONO_EXISTS, MONO_IMP, MULT_CLAUSES, PAIR_EQ, REAL_ABS_DIV, REAL_ABS_INV,
        REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_LID, REAL_ADD_RDISTRIB, REAL_ARCH_POW_INV,
        REAL_DIV_REFL, .. } := D.cvx.core3
  let { REAL_ENTIRE, REAL_INV_EQ_0, REAL_INV_MUL, REAL_INV_POW, REAL_LET_TRANS,
        REAL_LE_ANTISYM, REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LE_MUL,
        REAL_LE_MUL_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_DIV2_EQ,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ, REAL_LT_LE,
        REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LT_POW2, REAL_LT_RDIV_EQ, .. } := D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RINV,
        REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LT,
        REAL_OF_NUM_MUL, REAL_OF_NUM_POW, REAL_OF_NUM_SUB, REAL_POS, REAL_POW_EQ_0,
        REAL_POW_INV, REAL_POW_LE, REAL_SUB_LT, REAL_SUB_RDISTRIB, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.cvx.core5
  let { SWAP_FORALL_THM, WLOG_LE, num_INDUCTION, o_THM, real_div, real_pow, .. } :=
    D.cvx.core6
  let { INTEGER_POS, .. } := D.cvx.lib
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_LIFT, .. } := D.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, ENDS_IN_INTERVAL, EXISTS_LIFT, FORALL_1,
        FORALL_DROP, FORALL_LIFT, INTERVAL_OPEN_SUBSET_CLOSED, INTERVAL_SING, LIFT_CMUL,
        LIFT_DROP, NORM_0, .. } := D.cvx.vec2
  let { VECTOR_SUB_REFL, dist, drop, midpoint, .. } := D.cvx.vec4
  let { CLOSED_INTERVAL, CLOSURE_APPROACHABLE, .. } := D.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_OPEN_INTERVAL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED,
        COMPACT_INTERVAL, COMPACT_INTER_CLOSED, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, INTERIOR_OPEN, INTERVAL_NE_EMPTY_1, IN_INTERVAL_1, IS_INTERVAL_1,
        .. } := D.cvx.top4
  let { OPEN_INTERVAL, UNIT_INTERVAL_NONEMPTY, .. } := D.cvx.top5
  let { ADD_CLAUSES, ARITH_EVEN, ARITH_ODD, EVEN, EVEN_ADD, EVEN_EXISTS, EVEN_MULT,
        EVEN_OR_ODD, EXP_ADD, EXP_LT_0, FUNCTION_FACTORS_LEFT, LE_EXISTS, LE_EXP, LT_MULT,
        LT_MULT_LCANCEL, .. } := D.pses1
  let { MULT_ASSOC, NOT_SUC, ODD_ADD, ODD_EXISTS, ODD_EXP, ODD_MULT, ODD_SUB, PAIR,
        REAL_ABS_ABS, REAL_ABS_POW, REAL_DIV_POW2, REAL_EQ_MUL_RCANCEL, REAL_LE_MAX,
        REAL_LT_RMUL_EQ, REAL_MAX_LT, REAL_POW_1, REAL_POW_ADD, REAL_POW_MONO_INV,
        REAL_POW_SUB, REAL_WLOG_LT, num_RECURSION, num_WF, .. } := D.pses2
  let { SND, .. } := D.pses2
  let { DIST_REAL, ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { FLOOR, FLOOR_POS, INTEGER_ABS, INTEGER_CLOSED, REAL_ABS_INTEGER_LEMMA, REAL_LE_FLOOR,
        .. } := D.pfloor
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.ptop1
  let { CONTINUOUS_CLOSED_PREIMAGE_CONSTANT, .. } := D.ptop2
  let { HOMEOMORPHIC_COMPACT, .. } := D.ptop3
  let { IMAGE_CLOSURE_SUBSET, INTER_INTERVAL_1, .. } := D.ptop4
  let { SUBSET_INTERVAL_1, UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE,
        UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS, uniformly_continuous_on, .. } := D.ptop5
  let { CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET, CONNECTED_COMPACT_INTERVAL_1, .. } := D.pcvx1
  let { CONVEX_INTERVAL, IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Every path between distinct points contains an arc, and hence that      -/
  /- path connection is equivalent to arcwise connection, for distinct       -/
  /- points. The proof is based on Whyburn's "Topological Analysis".         -/
  /- ----------------------------------------------------------------------- -/

  let HOMEOMORPHIC_MONOTONE_IMAGE_INTERVAL ← prove
   r"!f:real^1->real^N.
       f continuous_on interval[vec 0,vec 1] /\
       (!y. connected {x | x IN interval[vec 0,vec 1] /\ f x = y}) /\
       ~(f(vec 1) = f(vec 0))
       ==> (IMAGE f (interval[vec 0,vec 1])) homeomorphic
           (interval[vec 0:real^1,vec 1])"
   (← do
    let closure_dyadic_rationals_in_convex_set_pos_1 ← prove
     r"!s. convex s /\ ~(interior s = {}) /\ (!x. x IN s ==> &0 <= drop x)
           ==> closure(s INTER { lift(&m / &2 pow n) |
                                 m IN (:num) /\ n IN (:num)}) =
               closure s"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"s:real^1->bool") CLOSURE_DYADIC_RATIONALS_IN_CONVEX_SET) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. x IN t ==> x IN u) /\ (!x. x IN u ==> x IN s ==> x IN t)
        ==> s INTER t = s INTER u")) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, DIMINDEX_1, FORALL_1] THEN
      REWRITE_TAC [IN_ELIM_THM, EXISTS_LIFT, ← GSYM drop, LIFT_DROP] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x / y:real = inv y * x"), LIFT_CMUL] THEN
      CONJ_TAC THENL [MESON_TAC [INTEGER_CLOSED], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^1"] THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&2 pow n) % x:real^1")) THEN
      ASM_SIMP_TAC [DROP_CMUL, REAL_LE_MUL_EQ, REAL_LT_POW2, REAL_LT_INV_EQ] THEN
      ASM_MESON_TAC [INTEGER_POS, LIFT_DROP])
    let function_on_dyadic_rationals ← prove
     r"!f:num->num->A.
            (!m n. f (2 * m) (n + 1) = f m n)
            ==> ?g. !m n. g(&m / &2 pow n) = f m n"
     (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN MP_TAC (← ISPECL
       [← q r"\(m,n). (f:num->num->A) m n", ← q r"\(m,n). &m / &2 pow n"]
       FUNCTION_FACTORS_LEFT) THEN
      REWRITE_TAC [FORALL_PAIR_THM, FUN_EQ_THM, o_THM] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      ONCE_REWRITE_TAC [← MESON []
        (← q r"(!a b c d. P a b c d) <=> (!b d a c. P a b c d)")] THEN
      MATCH_MP_TAC WLOG_LE THEN REPEAT CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      SIMP_TAC [← REAL_FIELD (← q r"~(y = &0) /\ ~(y' = &0)
                           ==> (x / y = x' / y' <=> y' / y * x = x')"),
         REAL_POW_EQ_0, REAL_OF_NUM_EQ, REAL_DIV_POW2, ARITH_EQ] THEN
