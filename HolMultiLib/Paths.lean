      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
      ALL_TAC,
      SUBGOAL_THEN (← q r"(x:real^N) IN c") MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
