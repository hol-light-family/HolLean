@[nospecialize]
def setupPTS [HolBase] (D : PathsDeps) (BB : PTB) (BK : PTK) (BL : PTL) :
    ExceptT String IO PTS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D.cvx
  let { AND_FORALL_THM, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN, IN_DELETE, .. } := D.cvx.core2
  let { IN_INTER, MONO_EXISTS, MONO_FORALL, MONO_IMP, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_SUBTOPOLOGY_REFL, closed_in, .. } := D.cvx.met
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { COMPONENTS_MAXIMAL, CONNECTED_COMPONENT_MAXIMAL, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { IN_COMPONENTS_SUBSET, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_EQ, OPEN_IN_REFL, OPEN_UNIV, TOPSPACE_EUCLIDEAN,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, components, .. } := D.cvx.top5
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := D.pmet1
  let { OPEN_IN_UNIONS, PATH_CONNECTED_IN_SUBTOPOLOGY, locally_connected_space,
        locally_path_connected_space, .. } := D.pmet2
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_REFL,
        CONNECTED_CONNECTED_COMPONENT, .. } := D.ptop2
  let { IN_COMPONENTS, LOCALLY_AND_SUBSET, LOCALLY_EMPTY, LOCALLY_MONO, LOCALLY_OPEN_SUBSET,
        .. } := D.ptop4
  let { NEIGHBOURHOOD_BASE_OF_EUCLIDEAN, locally, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_CONVEX, CONVEX_BALL, .. } := D.pcvx1
  let { CONVEX_INTER, .. } := D.pcvx2
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, .. } := BB
  let { PATH_COMPONENT_REFL, PATH_COMPONENT_SUBSET, PATH_COMPONENT_EQ_EMPTY, path_connected,
        PATH_CONNECTED_IN_EUCLIDEAN, PATH_COMPONENT_MAXIMAL, PATH_COMPONENT_EQ,
        PATH_CONNECTED_PATH_IMAGE, PATH_CONNECTED_PATH_COMPONENT,
        COMPLEMENT_PATH_COMPONENT_UNIONS, .. } := BK
  let { CONVEX_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED, .. } := BL
  -- @@SCOPE END

  let LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally_connected_space (subtopology euclidean s) <=>
        locally connected s"
   (GEN_TAC THEN
    SIMP_TAC [locally_connected_space, NEIGHBOURHOOD_BASE_OF_EUCLIDEAN] THEN
    GEN_REWRITE_TAC RAND_CONV [LOCALLY_AND_SUBSET] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_EUCLIDEAN] THEN
    CONV_TAC (fun t => TAUT t))

  let (LOCALLY_CONNECTED, LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT) ← CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        locally connected s <=>
        !v x. open_in (subtopology euclidean s) v /\ x IN v
              ==> ?u. open_in (subtopology euclidean s) u /\
                      connected u /\
                      x IN u /\ u SUBSET v) /\
   (!s:real^N->bool.
        locally connected s <=>
        !t x. open_in (subtopology euclidean s) t /\ x IN t
              ==> open_in (subtopology euclidean s)
                          (connected_component t x))"
   (REWRITE_TAC [AND_FORALL_THM, locally] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (p ==> r) /\ (r ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET_REFL],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"y:real^N"] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP CONNECTED_COMPONENT_EQ) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N->bool", ← q r"x:real^N"]) THEN ANTS_TAC
      THENL [ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET, SUBSET], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool")
        (X_CHOOSE_THEN (← q r"a:real^N->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"v:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"a:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"connected_component u (x:real^N)") THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET, CONNECTED_CONNECTED_COMPONENT] THEN
      ASM_SIMP_TAC [IN, CONNECTED_COMPONENT_REFL]]))

  let LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally_path_connected_space (subtopology euclidean s) <=>
        locally path_connected s"
   (GEN_TAC THEN
    SIMP_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF_EUCLIDEAN] THEN
    GEN_REWRITE_TAC RAND_CONV [LOCALLY_AND_SUBSET] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_EUCLIDEAN] THEN
    CONV_TAC (fun t => TAUT t))

  let (LOCALLY_PATH_CONNECTED, LOCALLY_PATH_CONNECTED_OPEN_PATH_COMPONENT) ←
    CONJ_PAIR (← prove
   r"(!s:real^N->bool.
        locally path_connected s <=>
        !v x. open_in (subtopology euclidean s) v /\ x IN v
              ==> ?u. open_in (subtopology euclidean s) u /\
                      path_connected u /\
                      x IN u /\ u SUBSET v) /\
   (!s:real^N->bool.
        locally path_connected s <=>
        !t x. open_in (subtopology euclidean s) t /\ x IN t
              ==> open_in (subtopology euclidean s)
                          (path_component t x))"
   (REWRITE_TAC [AND_FORALL_THM, locally] THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ (p ==> r) /\ (r ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET_REFL],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"y:real^N"] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP PATH_COMPONENT_EQ) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N->bool", ← q r"x:real^N"]) THEN ANTS_TAC
      THENL [ASM_MESON_TAC [PATH_COMPONENT_SUBSET, SUBSET], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool")
        (X_CHOOSE_THEN (← q r"a:real^N->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"v:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"a:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC PATH_COMPONENT_MAXIMAL THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"path_component u (x:real^N)") THEN
      REWRITE_TAC [PATH_COMPONENT_SUBSET, PATH_CONNECTED_PATH_COMPONENT] THEN
      ASM_SIMP_TAC [IN, PATH_COMPONENT_REFL]]))

  let LOCALLY_CONNECTED_OPEN_COMPONENT ← prove
   r"!s:real^N->bool.
        locally connected s <=>
        !t c. open_in (subtopology euclidean s) t /\ c IN components t
              ==> open_in (subtopology euclidean s) c"
   (REWRITE_TAC [LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, components, FORALL_IN_GSPEC])

  let LOCALLY_CONNECTED_IM_KLEINEN ← prove
   r"!s:real^N->bool.
      locally connected s <=>
      !v x. open_in (subtopology euclidean s) v /\ x IN v
            ==> ?u. open_in (subtopology euclidean s) u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?c. connected c /\ c SUBSET v /\ x IN c /\ y IN c"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [LOCALLY_CONNECTED] THEN MESON_TAC [SUBSET_REFL], DISCH_TAC] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_OPEN_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"c:real^N->bool"] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N->bool", ← q r"x:real^N"]) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_SUBSET, SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(k:real^N->bool) SUBSET c") MP_TAC THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM SET_TAC [])

  let LOCALLY_PATH_CONNECTED_IM_KLEINEN ← prove
   r"!s:real^N->bool.
      locally path_connected s <=>
      !v x. open_in (subtopology euclidean s) v /\ x IN v
            ==> ?u. open_in (subtopology euclidean s) u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?p. path p /\ path_image p SUBSET v /\
                                pathstart p = x /\ pathfinish p = y"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [LOCALLY_PATH_CONNECTED] THEN
      REWRITE_TAC [path_connected] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      REWRITE_TAC [LOCALLY_PATH_CONNECTED_OPEN_PATH_COMPONENT] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"z:real^N"] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^N->bool", ← q r"x:real^N"]) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [PATH_COMPONENT_SUBSET, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->real^N") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"(path_image p) SUBSET path_component u (z:real^N)") MP_TAC
      THENL [ALL_TAC, ASM_MESON_TAC [PATHFINISH_IN_PATH_IMAGE, SUBSET]] THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP PATH_COMPONENT_EQ) THEN
      MATCH_MP_TAC PATH_COMPONENT_MAXIMAL THEN
      ASM_SIMP_TAC [PATH_CONNECTED_PATH_IMAGE] THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE]])

  let LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. locally path_connected s ==> locally connected s"
   (MESON_TAC [LOCALLY_MONO, PATH_CONNECTED_IMP_CONNECTED])

  let LOCALLY_CONNECTED_COMPONENTS ← prove
   r"!s c:real^N->bool.
        locally connected s /\ c IN components s ==> locally connected c"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] LOCALLY_OPEN_SUBSET)) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o
     GEN_REWRITE_RULE id [LOCALLY_CONNECTED_OPEN_COMPONENT]) THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [OPEN_IN_REFL])

  let LOCALLY_CONNECTED_CONNECTED_COMPONENT ← prove
   r"!s x:real^N.
        locally connected s
        ==> locally connected (connected_component s x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"connected_component s (x:real^N) = {}") THEN
    ASM_REWRITE_TAC [LOCALLY_EMPTY] THEN
    MATCH_MP_TAC LOCALLY_CONNECTED_COMPONENTS THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [IN_COMPONENTS] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY])

  let LOCALLY_PATH_CONNECTED_COMPONENTS ← prove
   r"!s c:real^N->bool.
        locally path_connected s /\ c IN components s
        ==> locally path_connected c"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] LOCALLY_OPEN_SUBSET)) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o
     GEN_REWRITE_RULE id [LOCALLY_CONNECTED_OPEN_COMPONENT] o
     MATCH_MP LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED) THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [OPEN_IN_REFL])

  let LOCALLY_PATH_CONNECTED_CONNECTED_COMPONENT ← prove
   r"!s x:real^N.
        locally path_connected s
        ==> locally path_connected (connected_component s x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"connected_component s (x:real^N) = {}") THEN
    ASM_REWRITE_TAC [LOCALLY_EMPTY] THEN
    MATCH_MP_TAC LOCALLY_PATH_CONNECTED_COMPONENTS THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [IN_COMPONENTS] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_EQ_EMPTY])

  let OPEN_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool. open s ==> locally path_connected s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_MONO THEN
    EXISTS_TAC (← q r"convex:(real^N->bool)->bool") THEN
    REWRITE_TAC [CONVEX_IMP_PATH_CONNECTED] THEN
    ASM_SIMP_TAC [locally, OPEN_IN_OPEN_EQ] THEN
    ASM_MESON_TAC [OPEN_CONTAINS_BALL, CENTRE_IN_BALL, OPEN_BALL, CONVEX_BALL,
                  SUBSET])

  let OPEN_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. open s ==> locally connected s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_MONO THEN
    EXISTS_TAC (← q r"path_connected:(real^N->bool)->bool") THEN
    ASM_SIMP_TAC [OPEN_IMP_LOCALLY_PATH_CONNECTED,
                 PATH_CONNECTED_IMP_CONNECTED])

  let LOCALLY_PATH_CONNECTED_UNIV ← prove
   r"locally path_connected (:real^N)"
   (SIMP_TAC [OPEN_IMP_LOCALLY_PATH_CONNECTED, OPEN_UNIV])

  let LOCALLY_CONNECTED_UNIV ← prove
   r"locally connected (:real^N)"
   (SIMP_TAC [OPEN_IMP_LOCALLY_CONNECTED, OPEN_UNIV])

  let OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED ← prove
   r"!s x:real^N.
        locally connected s
        ==> open_in (subtopology euclidean s) (connected_component s x)"
   (REWRITE_TAC [LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, SUBSET_UNIV, TOPSPACE_EUCLIDEAN],
      ASM_MESON_TAC [OPEN_IN_EMPTY, CONNECTED_COMPONENT_EQ_EMPTY]])

  let OPEN_IN_COMPONENTS_LOCALLY_CONNECTED ← prove
   r"!s c:real^N->bool.
        locally connected s /\ c IN components s
        ==> open_in (subtopology euclidean s) c"
   (MESON_TAC [LOCALLY_CONNECTED_OPEN_COMPONENT, OPEN_IN_REFL])

  let OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED ← prove
   r"!s x:real^N.
        locally path_connected s
        ==> open_in (subtopology euclidean s) (path_component s x)"
   (REWRITE_TAC [LOCALLY_PATH_CONNECTED_OPEN_PATH_COMPONENT] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, SUBSET_UNIV, TOPSPACE_EUCLIDEAN],
      ASM_MESON_TAC [OPEN_IN_EMPTY, PATH_COMPONENT_EQ_EMPTY]])

  let CLOSED_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED ← prove
   r"!s x:real^N.
        locally path_connected s
        ==> closed_in (subtopology euclidean s) (path_component s x)"
   (REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                PATH_COMPONENT_SUBSET] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLEMENT_PATH_COMPONENT_UNIONS] THEN
    MATCH_MP_TAC OPEN_IN_UNIONS THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_GSPEC, IN_DELETE] THEN
    ASM_SIMP_TAC [OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED])

  let CONVEX_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool. convex s ==> locally path_connected s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LOCALLY_PATH_CONNECTED] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"s INTER ball(x:real^N,e)") THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [OPEN_IN_OPEN] THEN MESON_TAC [OPEN_BALL],
      MATCH_MP_TAC CONVEX_IMP_PATH_CONNECTED THEN
      ASM_SIMP_TAC [CONVEX_INTER, CONVEX_BALL],
      ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL],
      ASM SET_TAC []])

  let OPEN_IN_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool.
        open_in (subtopology euclidean (affine hull s)) s
        ==> locally path_connected s"
   (GEN_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_OPEN_SUBSET) THEN
    MATCH_MP_TAC CONVEX_IMP_LOCALLY_PATH_CONNECTED THEN
    SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL])

  return { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_CONNECTED,
           LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT,
           LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_PATH_CONNECTED,
           LOCALLY_PATH_CONNECTED_OPEN_PATH_COMPONENT, LOCALLY_CONNECTED_OPEN_COMPONENT,
           LOCALLY_CONNECTED_IM_KLEINEN, LOCALLY_PATH_CONNECTED_IM_KLEINEN,
           LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, LOCALLY_CONNECTED_COMPONENTS,
           LOCALLY_CONNECTED_CONNECTED_COMPONENT, LOCALLY_PATH_CONNECTED_COMPONENTS,
           LOCALLY_PATH_CONNECTED_CONNECTED_COMPONENT, OPEN_IMP_LOCALLY_PATH_CONNECTED,
           OPEN_IMP_LOCALLY_CONNECTED, LOCALLY_PATH_CONNECTED_UNIV, LOCALLY_CONNECTED_UNIV,
           OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED,
           OPEN_IN_COMPONENTS_LOCALLY_CONNECTED,
           OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED,
           CLOSED_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, CONVEX_IMP_LOCALLY_PATH_CONNECTED,
           OPEN_IN_IMP_LOCALLY_PATH_CONNECTED }

