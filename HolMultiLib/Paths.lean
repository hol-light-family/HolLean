  let { CONNECTED_IMP_PERFECT, .. } := D.cvx.top2
  let { LIM_SUBSEQUENCE, LIM_UNIQUE, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, homeomorphism, .. } := D.cvx.top5
  let { INFINITE, INTER_ASSOC, .. } := D.pses1
  let { CARD_LE_INFINITE, INFINITE_CARD_LE, .. } := D.pcard
  let { ALWAYS_EVENTUALLY, CLOSED_IN_SUBTOPOLOGY_EMPTY, .. } := D.pmet1
  let { OPEN_IN_SUBTOPOLOGY_EMPTY, .. } := D.pmet2
