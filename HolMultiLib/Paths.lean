  let { HOMEOMORPHIC_HYPERPLANE_UNIV, .. } := D.ptop3
  let { AFFINE_EXISTS, AFFINE_HYPERPLANE, AFFINE_IMP_CONVEX, AFFINE_UNIV, AFF_DIM_CBALL,
        AFF_DIM_CONVEX_INTER_OPEN, AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, AFF_DIM_GE,
