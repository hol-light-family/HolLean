        ==> (relative_frontier s DELETE a) homeomorphic t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_GE, ← INT_ARITH
     (← q r"--(&1):int <= s ==> ~(--(&1) = s + &1)")] THEN
