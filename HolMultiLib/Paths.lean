           [← q r"a(&(2 * m + 1) / &2 pow (n + 1)):real^1",
            ← q r"b(&(2 * m + 1) / &2 pow (n + 1)):real^1",
            ← q r"c(&(2 * m + 1) / &2 pow (n + 1)):real^1"]) THEN
