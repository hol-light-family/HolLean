          CONJ_TAC THENL
           [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, CONVEX_INTERVAL],
            X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
            SUBGOAL_THEN (← q r"segment(u:real^1,x) INTER t = {}")
              (fun th => ASM_MESON_TAC [th]) THEN
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
             (← q r"uv INTER t = {} ==> ux SUBSET uv ==> ux INTER t = {}"))) THEN
            UNDISCH_TAC (← q r"(x:real^1) IN segment[u,v]") THEN
