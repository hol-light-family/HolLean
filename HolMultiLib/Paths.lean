                   ASM_REWRITE_TAC [IN_INTERVAL_1, SUBSET_INTERVAL_1]) THEN
            ASM_REAL_ARITH_TAC],
          ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t DIFF segment(u:real^1,v)")) THEN
        ASM_REWRITE_TAC [← SET_RULE (← q r"t DIFF s PSUBSET t <=> ~(s INTER t = {})")] THEN
        MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
        REPEAT CONJ_TAC THENL
         [ASM SET_TAC [],
          MATCH_MP_TAC CLOSED_DIFF THEN ASM_REWRITE_TAC [OPEN_SEGMENT_1],
          ASM SET_TAC [],
          ASM_REWRITE_TAC [IN_DIFF] THEN MAP_EVERY UNDISCH_TAC
           [← q r"(u:real^1) IN interval[vec 0,vec 1]",
