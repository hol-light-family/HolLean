          ASM_REWRITE_TAC [IN_DIFF] THEN MAP_EVERY UNDISCH_TAC
           [← q r"(u:real^1) IN interval[vec 0,vec 1]",
            ← q r"(v:real^1) IN interval[vec 0,vec 1]"] THEN
          REWRITE_TAC [SEGMENT_1] THEN
          REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1]) THEN
          ASM_REAL_ARITH_TAC,
          MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
