  -- @@SCOPE END

  let COVERING_SPACE_FINITE_SHEETS_EQ_CLOSED_MAP_STRONG ← prove
   r"!p:real^M->real^N c s.
          covering_space (c,p) s /\ (!b. b IN s ==> b limit_point_of s)
