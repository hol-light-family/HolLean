structure PUU where
  HOMEOMORPHISM_MOVING_POINTS_EXISTS_GEN : thm
  HOMEOMORPHISM_MOVING_POINTS_EXISTS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUU [HolBase] (D : PathsDeps) (BO : PTO) (BUO : PUO) (BUT : PUT) :
    ExceptT String IO PUU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, SET_RULE, SET_TAC, INT_REDUCE_CONV, .. } := D.cvx
  let { CONTRAPOS_THM, EMPTY_GSPEC, EMPTY_SUBSET, FINITE_IMAGE, FINITE_INDUCT_STRONG,
        FINITE_SUBSET, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ_ALT, INT_OF_NUM_LE, IN_DIFF, .. } :=
    D.cvx.core2
  let { I_THM, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, PAIRWISE_INSERT, .. } := D.cvx.core3
  let { SUBSET, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_THM, .. } := D.cvx.core6
  let { HULL_INC, .. } := D.cvx.misc
  let { OPEN_IN_DIFF, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { BOUNDED_EMPTY, BOUNDED_SUBSET, .. } := D.cvx.top1
  let { HOMEOMORPHISM_COMPOSE, .. } := D.cvx.top4
  let { OPEN_IN, OPEN_IN_REFL, homeomorphism, .. } := D.cvx.top5
  let { real_INFINITE, .. } := D.pses2
  let { CARD_LT_FINITE_INFINITE, .. } := D.pcard
  let { BOUNDED_UNION, .. } := D.ptop1
  let { FINITE_IMP_CLOSED_IN, .. } := D.ptop3
  let { HOMEOMORPHISM_I, .. } := D.ptop4
  let { AFFINE_HULL_OPEN, AFFINE_HULL_OPEN_IN, AFF_DIM_AFFINE_HULL, AFF_DIM_EMPTY,
        AFF_DIM_SING, AFF_DIM_UNIV, COLLINEAR_AFF_DIM, .. } := D.pcvx1
  let { CONNECTED_FINITE_IFF_SING, .. } := BO
  let { CONNECTED_OPEN_IN_DIFF_CARD_LT, .. } := BUO
  let { HOMEOMORPHISM_MOVING_POINT_EXISTS, .. } := BUT
  -- @@SCOPE END

  let HOMEOMORPHISM_MOVING_POINTS_EXISTS_GEN ← prove
   r"!s t x (y:A->real^N) k.
        &2 <= aff_dim s /\ open_in (subtopology euclidean (affine hull s)) s /\
        s SUBSET t /\ t SUBSET affine hull s /\ connected s /\
        FINITE k /\ (!i. i IN k ==> x i IN s /\ y i IN s) /\
        pairwise (\i j. ~(x i = x j) /\ ~(y i = y j)) k
        ==> ?f g. homeomorphism (t,t) (f,g) /\
                  (!i. i IN k ==> f(x i) = y i) /\
                  {x | ~(f x = x /\ g x = x)} SUBSET s /\
                  bounded {x | ~(f x = x /\ g x = x)}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"FINITE(k:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    SPEC_TAC (← q r"s:real^N->bool", ← q r"s:real^N->bool") THEN POP_ASSUM MP_TAC THEN
    SPEC_TAC (← q r"k:A->bool", ← q r"k:A->bool") THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    CONJ_TAC THENL
     [GEN_TAC THEN STRIP_TAC THEN REPEAT (EXISTS_TAC (← q r"I:real^N->real^N")) THEN
      REWRITE_TAC [HOMEOMORPHISM_I, NOT_IN_EMPTY, I_THM, EMPTY_GSPEC] THEN
      REWRITE_TAC [EMPTY_SUBSET, BOUNDED_EMPTY],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"i:A", ← q r"k:A->bool"] THEN STRIP_TAC THEN
