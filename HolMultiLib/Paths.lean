structure PXB where
  CLOSED_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP : thm
  PROPER_LOCAL_HOMEOMORPHISM_GLOBAL : thm
  CLOSED_LOCAL_HOMEOMORPHISM_GLOBAL : thm
  PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP : thm
  PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP_GEN : thm
