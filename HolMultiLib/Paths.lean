        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER]) THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMPT_INFINITE_OPEN]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"w:real^M->bool")) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
