        matrix, .. } := D.pvec
  let { HOMOGENEOUS_LINEAR_EQUATIONS_DET, INVERTIBLE_DET_NZ, ORTHOGONAL_MATRIX_TRANSFORMATION,
        POSITIVE_DEFINITE_ADD, POSITIVE_DEFINITE_CMUL, .. } := D.pdet
  let { HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.pmet1
  let { CONTINUOUS_AT_WITHIN, CONTINUOUS_AT_WITHIN_INV, CONTINUOUS_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE, CONTINUOUS_ON_LIFT_DET, CONTINUOUS_ON_PASTECART,
        CONTINUOUS_PASTECART, CONTINUOUS_TRANSFORM_WITHIN_SET_IMP, CONTINUOUS_WITHIN_COMPOSE,
        DET_POSITIVE_DEFINITE, .. } := D.ptop3
  let { LINEAR_CONTINUOUS_WITHIN, .. } := D.ptop4
  let { POSITIVE_DEFINITE_EIGENVALUES, RIGHT_POLAR_DECOMPOSITION_INVERTIBLE, sphere, .. } :=
    D.ptop5
  let { CONNECTED_INTERVAL, CONVEX_CONNECTED_1, .. } := D.pcvx1
  let { CONVEX_CONTAINS_SEGMENT, .. } := D.pcvx2
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_RESTRICT, .. } := BVE
  let { HOMOTOPIC_WITH_COMPOSE, .. } := BVF
  let { HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS, .. } := BVG
  -- @@SCOPE END

  let HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_GEN ← prove
   r"!P f g:real^N->real^N.
        (?r. &0 < r /\ P r)
        ==> (homotopic_with orthogonal_transformation
               (subtopology euclidean {x | P(norm x)},
                subtopology euclidean {x | P(norm x)})
               f g <=>
             orthogonal_transformation f /\ orthogonal_transformation g /\
             det(matrix f) = det(matrix g))"
   (SUBGOAL_THEN
     (← q r"!P f g:real^N->real^N.
          (?r. &0 < r /\ P r)
          ==> (homotopic_with orthogonal_transformation
                 (subtopology euclidean {x | P(norm x)},
                  subtopology euclidean {x | P(norm x)})
                 f g <=>
               homotopic_with orthogonal_transformation
                (subtopology euclidean (:real^N),
                 subtopology euclidean (:real^N)) f g)")
    ASSUME_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [← GSYM HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      CONV_TAC SYM_CONV THEN REWRITE_TAC [sphere, DIST_0] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"&1") THEN
      CONV_TAC REAL_RAT_REDUCE_CONV] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_RESTRICT THEN
      REPEAT (EXISTS_TAC (← q r"(:real^N)")) THEN ASM_REWRITE_TAC [SUBSET_UNIV] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      MESON_TAC [ORTHOGONAL_TRANSFORMATION]] THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"h:real^(1,N)finite_sum->real^N") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [SUBSET_UNIV] THEN
    MATCH_MP_TAC CONTINUOUS_ON_EQ THEN EXISTS_TAC
     (← q r"\z. norm(sndcart z) / r %
          (h:real^(1,N)finite_sum->real^N)
          (pastecart (fstcart z) (r / norm(sndcart z) % sndcart z))") THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, FORALL_IN_PCROSS, IN_UNIV,
                FSTCART_PASTECART, SNDCART_PASTECART] THEN
    CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"x:real^N"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^1")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP ORTHOGONAL_TRANSFORMATION_LINEAR) THEN
      DISCH_THEN (MP_TAC o MATCH_MP LINEAR_CMUL) THEN
      SIMP_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"&0")) THEN
      REWRITE_TAC [VECTOR_MUL_LZERO] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"x:real^N = vec 0") THEN
      ASM_REWRITE_TAC [NORM_0, VECTOR_MUL_LZERO, real_div, REAL_MUL_LZERO] THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, NORM_EQ_0, VECTOR_MUL_LID, ← REAL_FIELD
       (← q r"~(x = &0) /\ &0 < r ==> (x * inv r) * r * inv x = &1")],
      ALL_TAC] THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"x:real^N"] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:real^N = vec 0") THENL
     [ASM_REWRITE_TAC [CONTINUOUS_WITHIN, SNDCART_PASTECART] THEN
      REWRITE_TAC [NORM_0, real_div, REAL_MUL_LZERO, VECTOR_MUL_LZERO] THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON THEN
      EXISTS_TAC (← q r"(norm o sndcart):real^(1,N)finite_sum->real") THEN
      CONJ_TAC THENL
       [SIMP_TAC [EVENTUALLY_WITHIN, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
        EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_UNIV] THEN
        REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        MAP_EVERY X_GEN_TAC [← q r"b:real^1", ← q r"y:real^N"] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"y:real^N = vec 0") THEN
        ASM_SIMP_TAC [NORM_0, VECTOR_MUL_LZERO, REAL_MUL_LZERO, REAL_LE_REFL] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^1")) THEN
        ASM_REWRITE_TAC [ORTHOGONAL_TRANSFORMATION] THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        DISCH_THEN (MP_TAC o MATCH_MP LINEAR_CMUL) THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [NORM_EQ_0, REAL_LE_REFL, ← REAL_FIELD
         (← q r"&0 < r /\ ~(y = &0) ==> (y * inv(abs r)) * (abs r * inv y) * y = y")],
        MATCH_MP_TAC (← MESON [CONTINUOUS_WITHIN, CONTINUOUS_AT_WITHIN]
         (← q r"f continuous at a /\ f a = l ==> (f --> l) (at a within s)")) THEN
        REWRITE_TAC [o_DEF, SNDCART_PASTECART, NORM_0, LIFT_NUM] THEN
        SIMP_TAC [CONTINUOUS_LIFT_NORM_COMPOSE, LINEAR_CONTINUOUS_AT,
                 LINEAR_SNDCART]],
      MATCH_MP_TAC CONTINUOUS_MUL THEN REWRITE_TAC [o_DEF, real_div] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"norm(x:real^N) * inv r = inv r * norm x")] THEN
      SIMP_TAC [LIFT_CMUL, CONTINUOUS_CMUL, CONTINUOUS_LIFT_NORM_COMPOSE,
               LINEAR_CONTINUOUS_WITHIN, LINEAR_SNDCART] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_WITHIN_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_PASTECART THEN
        SIMP_TAC [LINEAR_CONTINUOUS_WITHIN, LINEAR_FSTCART] THEN
        MATCH_MP_TAC CONTINUOUS_MUL THEN
        SIMP_TAC [LINEAR_CONTINUOUS_WITHIN, LINEAR_SNDCART] THEN
        REWRITE_TAC [o_DEF, LIFT_CMUL] THEN MATCH_MP_TAC CONTINUOUS_CMUL THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_AT_WITHIN_INV) THEN
        SIMP_TAC [CONTINUOUS_LIFT_NORM_COMPOSE, LINEAR_CONTINUOUS_WITHIN,
                 LINEAR_SNDCART, o_DEF] THEN
        ASM_REWRITE_TAC [NORM_EQ_0, SNDCART_PASTECART],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
          [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
        REWRITE_TAC [FORALL_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"r / norm(x) % x:real^N"]) THEN
        ASM_SIMP_TAC [IN_ELIM_THM, NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM,
                     REAL_MUL_LINV, NORM_EQ_0, real_div, REAL_ABS_INV,
                     REAL_ABS_MUL, ← REAL_ARITH (← q r"&0 < r ==> abs r = r"),
                  ← REAL_FIELD (← q r"&0 < r /\ ~(x = &0) ==> (r * inv x) * x = r")] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_TRANSFORM_WITHIN_SET_IMP) THEN
        REWRITE_TAC [EVENTUALLY_AT] THEN
        REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
        REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, FORALL_IN_PCROSS, IN_UNIV] THEN
        EXISTS_TAC (← q r"r:real") THEN ASM_REWRITE_TAC [] THEN
        SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS] THEN
        MAP_EVERY X_GEN_TAC [← q r"b:real^1", ← q r"y:real^N"] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [IN_ELIM_THM, NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM,
                     REAL_ABS_MUL, ← REAL_ARITH (← q r"&0 < r ==> abs r = r"),
                     ← REAL_RING (← q r"(r * x) * y = r <=> r = &0 \/ x * y = &1"),
                     REAL_LT_IMP_NZ, ← REAL_FIELD (← q r"inv x * x = &1 <=> ~(x = &0)"),
                     NORM_EQ_0] THEN
        ASM_CASES_TAC (← q r"y:real^N = vec 0") THEN
        ASM_SIMP_TAC [← GSYM REAL_MUL_ASSOC, REAL_MUL_LINV,
                    REAL_MUL_RID, NORM_EQ_0] THEN
        DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← MESON [DIST_LE_PASTECART, REAL_LET_TRANS]
          (← q r"dist(pastecart a b,pastecart c d) < r ==> dist(b,d) < r"))) THEN
        REWRITE_TAC [DIST_0, VECTOR_MUL_RZERO] THEN
        REWRITE_TAC [NORM_MUL, REAL_ABS_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [← GSYM REAL_MUL_ASSOC, REAL_MUL_LINV, NORM_EQ_0] THEN
        ASM_REAL_ARITH_TAC]])

  let HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_ALT ← prove
   r"!f g:real^N->real^N.
        homotopic_with orthogonal_transformation
          (subtopology euclidean ((:real^N) DELETE vec 0),
           subtopology euclidean ((:real^N) DELETE vec 0))
          f g <=>
        orthogonal_transformation f /\ orthogonal_transformation g /\
        det(matrix f) = det(matrix g)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM NORM_EQ_0, ← SET_RULE (← q r"UNIV DELETE a = {x | ~(x = a)}")] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_GEN THEN
    EXISTS_TAC (← q r"&1") THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_UNIV ← prove
   r"!P f g:real^N->real^N.
        homotopic_with orthogonal_transformation
          (subtopology euclidean (:real^N),
           subtopology euclidean (:real^N)) f g <=>
        orthogonal_transformation f /\ orthogonal_transformation g /\
        det(matrix f) = det(matrix g)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM NORM_EQ_0, ← SET_RULE (← q r"UNIV = {x | T}")] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_GEN THEN
    EXISTS_TAC (← q r"&1") THEN CONV_TAC REAL_RAT_REDUCE_CONV)

  let HOMOTOPIC_WITH_LINEAR_POSITIVE_DEFINITE_MAPS ← prove
   r"!f g. homotopic_with (\f. linear f /\ positive_definite(matrix f))
           (subtopology euclidean ((:real^N) DELETE vec 0),
            subtopology euclidean ((:real^N) DELETE vec 0)) f g <=>
           linear f /\ linear g /\
           positive_definite(matrix f) /\
           positive_definite(matrix g)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN SIMP_TAC [],
      REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN]] THEN
    EXISTS_TAC (← q r"\z. (&1 - drop(fstcart z)) % (f:real^N->real^N) (sndcart z) +
                    drop(fstcart z) % (g:real^N->real^N) (sndcart z)") THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC,
                SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART, PASTECART_IN_PCROSS,
                IN_UNIV, IN_DELETE, REAL_SUB_RZERO, REAL_SUB_REFL, VECTOR_MUL_LID,
                VECTOR_MUL_LZERO, VECTOR_ADD_LID, VECTOR_ADD_RID] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      SIMP_TAC [o_DEF, LIFT_SUB, LIFT_DROP, CONTINUOUS_ON_SUB, LINEAR_FSTCART,
        ETA_AX, LINEAR_SNDCART, CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, ← GSYM FORALL_DROP, DROP_VEC] THEN
      ASM_SIMP_TAC [LINEAR_COMPOSE_ADD, MATRIX_ADD, LINEAR_COMPOSE_CMUL,
                   MATRIX_CMUL] THEN
      X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN ASM_CASES_TAC (← q r"t = &0") THEN
      ASM_REWRITE_TAC [REAL_SUB_RZERO, MATRIX_CMUL_LZERO, MATRIX_ADD_RID,
                      MATRIX_CMUL_LID] THEN
      ASM_CASES_TAC (← q r"t = &1") THEN
      ASM_REWRITE_TAC [REAL_SUB_REFL, MATRIX_CMUL_LZERO, MATRIX_ADD_LID,
                      MATRIX_CMUL_LID] THEN
      MATCH_MP_TAC POSITIVE_DEFINITE_ADD THEN
      CONJ_TAC THEN MATCH_MP_TAC POSITIVE_DEFINITE_CMUL THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [FORALL_LIFT, LIFT_DROP] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"x:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real")) THEN
      ASM_REWRITE_TAC [POSITIVE_DEFINITE_EIGENVALUES] THEN
      DISCH_THEN (fun th => tactic_of do pure (
        MP_TAC (← SPECL [← q r"&0", ← q r"x:real^N"] (← liftExcept (last (CONJUNCTS th)))))) THEN
      ASM_REWRITE_TAC [VECTOR_MUL_LZERO, REAL_LT_REFL, CONTRAPOS_THM] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM] MATRIX_WORKS) THEN
      ASM_SIMP_TAC [LINEAR_COMPOSE_ADD, LINEAR_COMPOSE_CMUL]])

  let HOMOTOPIC_WITH_LINEAR_MAPS ← prove
   r"!f g:real^N->real^N.
     homotopic_with linear
       (subtopology euclidean ((:real^N) DELETE vec 0),
        subtopology euclidean ((:real^N) DELETE vec 0)) f g <=>
     linear f /\ linear g /\ &0 < det(matrix f) * det(matrix g)"
   (← do
    let lemma ← prove
     r"!f:real^N->real^N.
        linear f /\ ~(det(matrix f) = &0)
        ==> ?f' P. orthogonal_transformation f' /\ positive_definite P /\
                   f = f' o (\x. P ** x)"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM INVERTIBLE_DET_NZ]) THEN
      REWRITE_TAC [RIGHT_POLAR_DECOMPOSITION_INVERTIBLE] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"S:real^N^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"P:real^N^N") (STRIP_ASSUME_TAC o GSYM)) THEN
      EXISTS_TAC (← q r"(\x. P ** x):real^N->real^N") THEN
      ASM_REWRITE_TAC [← GSYM ORTHOGONAL_MATRIX_TRANSFORMATION] THEN
      FIRST_ASSUM (ASSUME_TAC o GSYM o MATCH_MP MATRIX_WORKS) THEN
      ASM_REWRITE_TAC [FUN_EQ_THM, o_THM, ← GSYM MATRIX_VECTOR_MUL_ASSOC])
    pure (
    REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"h:real^(1,N)finite_sum->real^N") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(\t. lift(det(matrix((h:real^(1,N)finite_sum->real^N) o pastecart t))))
        continuous_on interval[vec 0,vec 1]")
      MP_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_LIFT_DET THEN
        SIMP_TAC [matrix, LAMBDA_BETA, o_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"j:num"] THEN STRIP_TAC THEN
        MATCH_MP_TAC CONTINUOUS_ON_LIFT_COMPONENT_COMPOSE THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
                 CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, IN_UNIV,
                     IN_DELETE, BASIS_NONZERO],
        DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONNECTED_CONTINUOUS_IMAGE)) THEN
        REWRITE_TAC [CONNECTED_INTERVAL] THEN
        REWRITE_TAC [← GSYM CONVEX_CONNECTED_1, CONVEX_CONTAINS_SEGMENT] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, o_DEF] THEN
        REWRITE_TAC [FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
        REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 1:real^1")) THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, ETA_AX] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_MUL_POS_LT] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"~(&0 < x /\ &0 < y \/ x < &0 /\ y < &0)
          ==> abs(x - y) = abs(x - &0) + abs(&0 - y)"))) THEN
        REWRITE_TAC [← GSYM DIST_LIFT, LIFT_NUM, ← GSYM between] THEN
        REWRITE_TAC [BETWEEN_IN_SEGMENT] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"~(z IN t) ==> z IN s ==> ~(s SUBSET t)")) THEN
        REWRITE_TAC [IN_IMAGE, ← GSYM LIFT_NUM, LIFT_EQ] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") (STRIP_ASSUME_TAC o GSYM)) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"t:real^1")) THEN
        ASM_REWRITE_TAC [← GSYM LIFT_NUM, IN_DELETE, IN_UNIV, CONTRAPOS_THM] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
         [← GSYM HOMOGENEOUS_LINEAR_EQUATIONS_DET]) THEN
        ASM_SIMP_TAC [MATRIX_WORKS, ← GSYM LIFT_NUM] THEN MESON_TAC []],
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q r"det(matrix f:real^N^N) = &0") THEN
      ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_LT_REFL] THEN
      ASM_CASES_TAC (← q r"det(matrix g:real^N^N) = &0") THEN
      ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_REFL] THEN
      MP_TAC (← ISPEC (← q r"g:real^N->real^N") lemma) THEN
      MP_TAC (← ISPEC (← q r"f:real^N->real^N") lemma) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"h:real^N->real^N", ← q r"P:real^N^N"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real^N->real^N", ← q r"Q:real^N^N"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [MATRIX_COMPOSE, MATRIX_VECTOR_MUL_LINEAR,
                   ORTHOGONAL_TRANSFORMATION_LINEAR, DET_MUL,
                   MATRIX_OF_MATRIX_VECTOR_MUL] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH
       (← q r"(a * b) * (c * d):real = (a * c) * b * d")] THEN
      ASM_SIMP_TAC [DET_POSITIVE_DEFINITE, REAL_LT_MUL, REAL_LT_MUL_EQ] THEN
      REWRITE_TAC [REAL_MUL_POS_LT] THEN DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"&0 < x /\ &0 < y \/ x < &0 /\ y < &0
        ==> (x = &1 \/ x = -- &1) /\ (y = &1 \/ y = -- &1)
            ==> x = y"))) THEN
      ASM_SIMP_TAC [DET_ORTHOGONAL_MATRIX, ORTHOGONAL_MATRIX_MATRIX] THEN
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\f:real^N->real^N. linear f /\ positive_definite(matrix f)",
        ← q r"orthogonal_transformation:(real^N->real^N)->bool",
        ← q r"(:real^N) DELETE vec 0"] THEN
      ASM_REWRITE_TAC [HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_ALT] THEN
      SIMP_TAC [LINEAR_COMPOSE, ORTHOGONAL_TRANSFORMATION_LINEAR] THEN
      REWRITE_TAC [HOMOTOPIC_WITH_LINEAR_POSITIVE_DEFINITE_MAPS] THEN
      REWRITE_TAC [MATRIX_VECTOR_MUL_LINEAR] THEN
      ASM_REWRITE_TAC [MATRIX_OF_MATRIX_VECTOR_MUL]]))

  return { HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_GEN,
           HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_ALT,
           HOMOTOPIC_WITH_ORTHOGONAL_TRANSFORMATIONS_UNIV,
           HOMOTOPIC_WITH_LINEAR_POSITIVE_DEFINITE_MAPS, HOMOTOPIC_WITH_LINEAR_MAPS }

/- ------------------------------------------------------------------------- -/
/- Homotopy of paths, maintaining the same endpoints.  (paths.ml 17396-17554) -/
/- ------------------------------------------------------------------------- -/

structure PVI where
  homotopic_paths : thm
  HOMOTOPIC_PATHS : thm
  HOMOTOPIC_PATHS_IMP_PATHSTART : thm
  HOMOTOPIC_PATHS_IMP_PATHFINISH : thm
  HOMOTOPIC_PATHS_IMP_PATH : thm
  HOMOTOPIC_PATHS_IMP_SUBSET : thm
  HOMOTOPIC_PATHS_REFL : thm
  HOMOTOPIC_PATHS_SYM : thm
  HOMOTOPIC_PATHS_TRANS : thm
  HOMOTOPIC_PATHS_EQ : thm
  HOMOTOPIC_PATHS_REPARAMETRIZE : thm
  HOMOTOPIC_PATHS_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVI [HolBase] (D : PathsDeps) (BA : PTA) (BVE : PVE) : ExceptT String IO PVI := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH, .. } := D.cvx
  let { ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMAGE_o, IMP_CONJ, .. } := D.cvx.core2
  let { IN_IMAGE, PCROSS, .. } := D.cvx.core3
  let { REAL_LE_REFL, .. } := D.cvx.core4
  let { REAL_POS, SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        .. } := D.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { HOMOTOPIC_WITH_EQ, HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.pmet1
  let { HOMOTOPIC_WITH_REFL, HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := D.ptop2
  let { CONVEX_ALT, .. } := D.pcvx1
  let { CONVEX_INTERVAL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, HOMOTOPIC_WITH_SUBSET_RIGHT, .. } := BVE
  -- @@SCOPE END

  let homotopic_paths ← new_definition
   r"homotopic_paths s p q =
     homotopic_with
       (\r. pathstart r = pathstart p /\ pathfinish r = pathfinish p)
       (subtopology euclidean (interval[vec 0:real^1,vec 1]),
        subtopology euclidean s)
       p q"

  let HOMOTOPIC_PATHS ← prove
   r"!s p q:real^1->real^N.
      homotopic_paths s p q <=>
      ?h. h continuous_on
          interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1] /\
          IMAGE h (interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1])
          SUBSET s /\
          (!x. x IN interval[vec 0,vec 1] ==> h(pastecart (vec 0) x) = p x) /\
          (!x. x IN interval[vec 0,vec 1] ==> h(pastecart (vec 1) x) = q x) /\
          (!t. t IN interval[vec 0:real^1,vec 1]
               ==> pathstart(h o pastecart t) = pathstart p /\
                   pathfinish(h o pastecart t) = pathfinish p)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopic_paths] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOMOTOPIC_WITH_EUCLIDEAN_ALT o
      lhand o snd) THEN
    ANTS_TAC THENL
     [SIMP_TAC [pathstart, pathfinish, ENDS_IN_UNIT_INTERVAL],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [o_DEF]])

  let HOMOTOPIC_PATHS_IMP_PATHSTART ← prove
   r"!s p q. homotopic_paths s p q ==> pathstart p = pathstart q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_paths] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
    SIMP_TAC [])

  let HOMOTOPIC_PATHS_IMP_PATHFINISH ← prove
   r"!s p q. homotopic_paths s p q ==> pathfinish p = pathfinish q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_paths] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
    SIMP_TAC [])

  let HOMOTOPIC_PATHS_IMP_PATH ← prove
   r"!s p q. homotopic_paths s p q ==> path p /\ path q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_paths] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
    SIMP_TAC [path])

  let HOMOTOPIC_PATHS_IMP_SUBSET ← prove
   r"!s p q.
     homotopic_paths s p q ==> path_image p SUBSET s /\ path_image q SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_paths] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    SIMP_TAC [path_image])

  let HOMOTOPIC_PATHS_REFL ← prove
   r"!s p. homotopic_paths s p p <=>
           path p /\ path_image p SUBSET s"
   (REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2,
                path, path_image])

  let HOMOTOPIC_PATHS_SYM ← prove
   r"!s p q. homotopic_paths s p q <=> homotopic_paths s q p"
   (REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_paths]) THEN
    ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN ASM_SIMP_TAC [homotopic_paths])

  let HOMOTOPIC_PATHS_TRANS ← prove
   r"!s p q r.
        homotopic_paths s p q /\ homotopic_paths s q r
        ==> homotopic_paths s p r"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (CONJUNCTS_THEN
     (fun th => tactic_of do pure (
                ASSUME_TAC (← MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART th) THEN
                ASSUME_TAC (← MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH th)))) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE BINOP_CONV [homotopic_paths]) THEN
    ASM_REWRITE_TAC [HOMOTOPIC_WITH_TRANS, homotopic_paths])

  let HOMOTOPIC_PATHS_EQ ← prove
   r"!p:real^1->real^N q s.
        path p /\ path_image p SUBSET s /\
        (!t. t IN interval[vec 0,vec 1] ==> p(t) = q(t))
        ==> homotopic_paths s p q"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homotopic_paths] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REPEAT (EXISTS_TAC (← q r"p:real^1->real^N")) THEN
    ASM_SIMP_TAC [HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2] THEN
    ASM_REWRITE_TAC [← GSYM path, ← GSYM path_image] THEN
    REWRITE_TAC [pathstart, pathfinish] THEN
    MESON_TAC [ENDS_IN_UNIT_INTERVAL])

  let HOMOTOPIC_PATHS_REPARAMETRIZE ← prove
   r"!p:real^1->real^N q.
        path p /\ path_image p SUBSET s /\
        (?f. f continuous_on interval[vec 0,vec 1] /\
             IMAGE f (interval[vec 0,vec 1]) SUBSET interval[vec 0,vec 1] /\
             f(vec 0) = vec 0 /\ f(vec 1) = vec 1 /\
             !t. t IN interval[vec 0,vec 1] ==> q(t) = p(f t))
        ==> homotopic_paths s p q"
   (REWRITE_TAC [path, path_image] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
    EXISTS_TAC (← q r"(p:real^1->real^N) o (f:real^1->real^1)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_EQ THEN
      ASM_SIMP_TAC [o_THM, pathstart, pathfinish, o_THM,
                   IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
      REWRITE_TAC [path, path_image] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
        EXISTS_TAC (← q r"(p:real^1->real^N) o (f:real^1->real^1)") THEN
        ASM_SIMP_TAC [o_THM] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        ASM SET_TAC []],
      REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
      EXISTS_TAC (← q r"(p:real^1->real^N) o
                  (\y. (&1 - drop(fstcart y)) % f(sndcart y) +
                       drop(fstcart y) % sndcart y)") THEN
      ASM_REWRITE_TAC [o_THM, FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC,
                      pathstart, pathfinish] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_ADD_LID,
                  VECTOR_MUL_LID, VECTOR_ADD_RID] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - u) % x + u % x:real^N = x")] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
          MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX, LIFT_SUB] THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, CONTINUOUS_ON_CONST, LINEAR_FSTCART,
                   LINEAR_SNDCART, CONTINUOUS_ON_SUB] THEN
          MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, SNDCART_PASTECART],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET))],
        ONCE_REWRITE_TAC [IMAGE_o] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE p i SUBSET s
          ==> IMAGE f x SUBSET i
              ==> IMAGE p (IMAGE f x) SUBSET s")))] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, SNDCART_PASTECART,
               FSTCART_PASTECART] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [CONVEX_ALT] (← CONJUNCT1 (← SPEC_ALL
        CONVEX_INTERVAL))) THEN
      ASM_MESON_TAC [IN_INTERVAL_1, DROP_VEC, SUBSET, IN_IMAGE]])

  let HOMOTOPIC_PATHS_SUBSET ← prove
   r"!s p q.
        homotopic_paths s p q /\ s SUBSET t
        ==> homotopic_paths t p q"
   (REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_SUBSET_RIGHT])

  return { homotopic_paths, HOMOTOPIC_PATHS, HOMOTOPIC_PATHS_IMP_PATHSTART,
           HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
           HOMOTOPIC_PATHS_REFL, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS, HOMOTOPIC_PATHS_EQ,
           HOMOTOPIC_PATHS_REPARAMETRIZE, HOMOTOPIC_PATHS_SUBSET }

/- ------------------------------------------------------------------------- -/
/- A slightly ad-hoc but useful lemma in constructing homotopies; congruence -/
/- properties w.r.t. path-combining operations.  (paths.ml 17555-17687)      -/
/- ------------------------------------------------------------------------- -/

structure PVJ where
  HOMOTOPIC_JOIN_LEMMA : thm
  HOMOTOPIC_PATHS_REVERSEPATH : thm
  HOMOTOPIC_PATHS_JOIN : thm
  HOMOTOPIC_PATHS_CONTINUOUS_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVJ [HolBase] (D : PathsDeps) (BA : PTA) (BC : PTC) (BVE : PVE) (BVI : PVI) :
    ExceptT String IO PVJ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMAGE_o, IMP_CONJ, IN_ELIM_PASTECART_THM, .. } :=
    D.cvx.core2
  let { PCROSS, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_CMUL, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LINEAR_FSTCART,
        LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_MUL_RZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        .. } := D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { PASTECART_FST_SND, .. } := D.pses2
  let { CONTINUOUS_ON_CASES_LE, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { pathstart, pathfinish, path_image, reversepath, joinpaths, .. } := BA
  let { REVERSEPATH_REVERSEPATH, SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_MONO, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT,
        .. } := BVE
  let { homotopic_paths, .. } := BVI
  -- @@SCOPE END

  let HOMOTOPIC_JOIN_LEMMA ← prove
   r"!p q:real^1->real^1->real^N.
  (\y. p (fstcart y) (sndcart y)) continuous_on
  (interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1]) /\
  (\y. q (fstcart y) (sndcart y)) continuous_on
  (interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1]) /\
  (!t. t IN interval[vec 0,vec 1] ==> pathfinish(p t) = pathstart(q t))
  ==> (\y. (p(fstcart y) ++ q(fstcart y)) (sndcart y)) continuous_on
      (interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1])"
   (REWRITE_TAC [joinpaths, PCROSS] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_ON_CASES_LE THEN REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN
      (← q r"(\y. p (fstcart y) (&2 % sndcart y)):real^(1,1)finite_sum->real^N =
       (\y. p (fstcart y) (sndcart y)) o
       (\y. pastecart (fstcart y) (&2 % sndcart y))")
      SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART], ALL_TAC],
      SUBGOAL_THEN
      (← q r"(\y. q (fstcart y) (&2 % sndcart y - vec 1)):real^(1,1)finite_sum->real^N =
       (\y. q (fstcart y) (sndcart y)) o
       (\y. pastecart (fstcart y) (&2 % sndcart y - vec 1))")
      SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART], ALL_TAC],
      SIMP_TAC [o_DEF, LIFT_DROP, LINEAR_CONTINUOUS_ON, LINEAR_SNDCART, ETA_AX],
      SIMP_TAC [IMP_CONJ, FORALL_IN_GSPEC, FSTCART_PASTECART, SNDCART_PASTECART,
               ← GSYM LIFT_EQ, LIFT_DROP, ← GSYM LIFT_CMUL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [LIFT_NUM, VECTOR_SUB_REFL]] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    (CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_ON_PASTECART, ALL_TAC]) THEN
    SIMP_TAC [CONTINUOUS_ON_CMUL, LINEAR_CONTINUOUS_ON, CONTINUOUS_ON_SUB,
             CONTINUOUS_ON_CONST, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, IMP_CONJ] THEN
    SIMP_TAC [IN_ELIM_PASTECART_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  /- Congruence properties of homotopy w.r.t. path-combining operations. -/

  let HOMOTOPIC_PATHS_REVERSEPATH ← prove
   r"!s p q:real^1->real^N.
     homotopic_paths s (reversepath p) (reversepath q) <=>
     homotopic_paths s p q"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(!p. f(f p) = p) /\
      (!a b. homotopic_paths s a b ==> homotopic_paths s (f a) (f b))
      ==> !a b. homotopic_paths s (f a) (f b) <=>
                homotopic_paths s a b")) THEN
    REWRITE_TAC [REVERSEPATH_REVERSEPATH] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS, o_DEF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,1)finite_sum->real^N")
      STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\y:real^(1,1)finite_sum.
                   (h:real^(1,1)finite_sum->real^N)
                   (pastecart(fstcart y) (vec 1 - sndcart y))") THEN
    ASM_REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    ASM_SIMP_TAC [reversepath, pathstart, pathfinish, VECTOR_SUB_REFL,
                 VECTOR_SUB_RZERO] THEN
    CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
                 CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC,
          IN_ELIM_PASTECART_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC],
       GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
       REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"IMAGE h s SUBSET t ==> IMAGE g s SUBSET s
        ==> IMAGE h (IMAGE g s) SUBSET t"))) THEN
       SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC,
          IN_ELIM_PASTECART_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
       REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC])

  let HOMOTOPIC_PATHS_JOIN ← prove
   r"!s p q p' q':real^1->real^N.
     homotopic_paths s p p' /\ homotopic_paths s q q' /\
     pathfinish p = pathstart q
     ==> homotopic_paths s (p ++ q) (p' ++ q')"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"k1:real^(1,1)finite_sum->real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"k2:real^(1,1)finite_sum->real^N") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"(\y. ((k1 o pastecart (fstcart y)) ++
                      (k2 o pastecart (fstcart y))) (sndcart y))
                :real^(1,1)finite_sum->real^N") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [PCROSS] HOMOTOPIC_JOIN_LEMMA) THEN
      ASM_REWRITE_TAC [o_DEF, PASTECART_FST_SND, ETA_AX] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_REWRITE_TAC [pathstart, pathfinish] THEN ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [ETA_AX, ← GSYM path_image, ← SET_RULE
        (← q r"(!x. x IN i ==> f x IN s) <=> IMAGE f i SUBSET s")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN
      REWRITE_TAC [path_image, SUBSET, FORALL_IN_IMAGE, o_DEF] THEN ASM SET_TAC [],
      ALL_TAC, ALL_TAC, ALL_TAC] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    ASM_REWRITE_TAC [joinpaths, o_DEF] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    REWRITE_TAC [pathstart, pathfinish, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_SIMP_TAC [← VECTOR_ARITH (← q r"&2 % x - x:real^N = x"), VECTOR_MUL_RZERO])

  let HOMOTOPIC_PATHS_CONTINUOUS_IMAGE ← prove
   r"!f:real^1->real^M g h:real^M->real^N s t.
        homotopic_paths s f g /\
        h continuous_on s /\ IMAGE h s SUBSET t
        ==> homotopic_paths t (h o f) (h o g)"
   (REWRITE_TAC [homotopic_paths] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    SIMP_TAC [pathstart, pathfinish, o_THM])

  return { HOMOTOPIC_JOIN_LEMMA, HOMOTOPIC_PATHS_REVERSEPATH, HOMOTOPIC_PATHS_JOIN,
           HOMOTOPIC_PATHS_CONTINUOUS_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Group properties for homotopy of paths (so taking equivalence classes     -/
/- under homotopy would give the fundamental group).  (paths.ml 17688-17876) -/
/- ------------------------------------------------------------------------- -/

structure PVK where
  HOMOTOPIC_PATHS_RID : thm
  HOMOTOPIC_PATHS_LID : thm
  HOMOTOPIC_PATHS_ASSOC : thm
  HOMOTOPIC_PATHS_RINV : thm
  HOMOTOPIC_PATHS_LINV : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVK [HolBase] (D : PathsDeps) (BA : PTA) (BC : PTC) (BF : PTF) (BI : PTI)
    (BVE : PVE) (BVI : PVI) (BVJ : PVJ) : ExceptT String IO PVK := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.cvx
  let { COND_ID, CONJ_ASSOC, CONJ_SYM, EMPTY_SUBSET, ETA_AX, EXTENSION, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMP_CONJ, INSERT_SUBSET, .. } := D.cvx.core2
  let { IN_UNION, PCROSS, .. } := D.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_REFL, REAL_LE_TRANS, .. } := D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_POS, REAL_SUB_LE, RIGHT_FORALL_IMP_THM,
        SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { UNION_SUBSET, o_DEF, .. } := D.cvx.core6
  let { HULL_MINIMAL, .. } := D.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } := D.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { CONTINUOUS_ON_CASES, CONTINUOUS_ON_CASES_1, CONTINUOUS_ON_CASES_LE,
        CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONVEX_INTERVAL, SEGMENT_CONVEX_HULL, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, joinpaths, .. } := BA
  let { REVERSEPATH_REVERSEPATH, PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN,
        PATHFINISH_JOIN, PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN,
        SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_JOIN, REVERSEPATH_JOINPATHS, .. } := BC
  let { subpath, PATH_IMAGE_SUBPATH_GEN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
        SUBPATH_TRIVIAL, REVERSEPATH_SUBPATH, .. } := BF
  let { linepath, PATHSTART_LINEPATH, PATHFINISH_LINEPATH, REVERSEPATH_LINEPATH, .. } := BI
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { homotopic_paths, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_REPARAMETRIZE, .. } := BVI
  let { HOMOTOPIC_PATHS_REVERSEPATH, .. } := BVJ
  -- @@SCOPE END

  let HOMOTOPIC_PATHS_RID ← prove
   r"!s p. path p /\ path_image p SUBSET s
         ==> homotopic_paths s (p ++ linepath(pathfinish p,pathfinish p)) p"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_REPARAMETRIZE THEN
    ASM_REWRITE_TAC [joinpaths] THEN
    EXISTS_TAC (← q r"\t. if drop t <= &1 / &2 then &2 % t else vec 1") THEN
    ASM_REWRITE_TAC [DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [VECTOR_MUL_RZERO, linepath, pathfinish,
                ← VECTOR_ARITH (← q r"(&1 - t) % x + t % x:real^N = x")] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"interval[vec 0:real^1,vec 1] =
        interval[vec 0,lift(&1 / &2)] UNION interval[lift(&1 / &2),vec 1]")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
        REAL_ARITH_TAC,
        MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
        SIMP_TAC [CLOSED_INTERVAL, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID,
                 CONTINUOUS_ON_CONST, IN_INTERVAL_1, DROP_VEC, LIFT_DROP,
                 ← GSYM DROP_EQ, DROP_CMUL] THEN
        REAL_ARITH_TAC],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_VEC] THEN
      GEN_TAC THEN COND_CASES_TAC THEN REWRITE_TAC [DROP_CMUL, DROP_VEC] THEN
      ASM_REAL_ARITH_TAC])

  let HOMOTOPIC_PATHS_LID ← prove
   r"!s p:real^1->real^N.
        path p /\ path_image p SUBSET s
        ==> homotopic_paths s (linepath(pathstart p,pathstart p) ++ p) p"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM HOMOTOPIC_PATHS_REVERSEPATH] THEN
    REWRITE_TAC [o_DEF, PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH] THEN
    SIMP_TAC [REVERSEPATH_JOINPATHS, REVERSEPATH_LINEPATH,
             PATHFINISH_LINEPATH] THEN
    ONCE_REWRITE_TAC [CONJ_SYM] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"reversepath p :real^1->real^N"]
      HOMOTOPIC_PATHS_RID) THEN
    ASM_SIMP_TAC [PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH,
                 PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH])

  let HOMOTOPIC_PATHS_ASSOC ← prove
   r"!s p q r:real^1->real^N.
        path p /\ path_image p SUBSET s /\
        path q /\ path_image q SUBSET s /\
        path r /\ path_image r SUBSET s /\
        pathfinish p = pathstart q /\ pathfinish q = pathstart r
        ==> homotopic_paths s (p ++ (q ++ r)) ((p ++ q) ++ r)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_REPARAMETRIZE THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET,
                 PATHSTART_JOIN, PATHFINISH_JOIN] THEN
    REWRITE_TAC [joinpaths] THEN
    EXISTS_TAC (← q r"\t. if drop t <= &1 / &2 then inv(&2) % t
                    else if drop t <= &3 / &4 then t - lift(&1 / &4)
                    else &2 % t - vec 1") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_CASES_1 THEN
      SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID, LIFT_DROP] THEN
      REWRITE_TAC [← GSYM LIFT_SUB, ← GSYM LIFT_CMUL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES_1 THEN
      SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID,
               CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [← GSYM LIFT_SUB, ← GSYM LIFT_CMUL, ← GSYM LIFT_NUM] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_VEC] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      REWRITE_TAC [DROP_CMUL, DROP_VEC, LIFT_DROP, DROP_SUB] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [VECTOR_MUL_RZERO],
      REWRITE_TAC [DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      VECTOR_ARITH_TAC,
      X_GEN_TAC (← q r"t:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      STRIP_TAC THEN
      ASM_CASES_TAC (← q r"drop t <= &1 / &2") THEN ASM_REWRITE_TAC [DROP_CMUL] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"inv(&2) * t <= &1 / &2 <=> t <= &1")] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC, REAL_MUL_ASSOC] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [REAL_MUL_LID] THEN
      ASM_CASES_TAC (← q r"drop t <= &3 / &4") THEN
      ASM_REWRITE_TAC [DROP_SUB, DROP_VEC, DROP_CMUL, LIFT_DROP,
                      ← REAL_ARITH (← q r"&2 * (t - &1 / &4) <= &1 / &2 <=> t <= &1 / &2"),
                      ← REAL_ARITH (← q r"&2 * t - &1 <= &1 / &2 <=> t <= &3 / &4"),
                      ← REAL_ARITH (← q r"t - &1 / &4 <= &1 / &2 <=> t <= &3 / &4")] THEN
      REWRITE_TAC [VECTOR_SUB_LDISTRIB, VECTOR_MUL_ASSOC, ← GSYM LIFT_CMUL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_NUM] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a - b - b:real^N = a - &2 % b")]])

  let HOMOTOPIC_PATHS_RINV ← prove
   r"!s p:real^1->real^N.
        path p /\ path_image p SUBSET s
        ==> homotopic_paths s
              (p ++ reversepath p) (linepath(pathstart p,pathstart p))"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
    REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    EXISTS_TAC (← q r"(\y. (subpath (vec 0) (fstcart y) p ++
                      reversepath(subpath (vec 0) (fstcart y) p)) (sndcart y))
                : real^(1,1)finite_sum->real^N") THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, SUBPATH_TRIVIAL] THEN
    REWRITE_TAC [ETA_AX, PATHSTART_JOIN, PATHFINISH_JOIN] THEN
    REWRITE_TAC [REVERSEPATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [joinpaths] THEN MATCH_MP_TAC CONTINUOUS_ON_CASES_LE THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path, path_image]) THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [subpath, VECTOR_ADD_LID, VECTOR_SUB_RZERO] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX] THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
                   CONTINUOUS_ON_CMUL],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [FORALL_IN_IMAGE, SUBSET, FORALL_IN_GSPEC, IMP_CONJ] THEN
          REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_VEC] THEN
          REPEAT STRIP_TAC THEN ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS] THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"drop x * &2 * &1 / &2") THEN CONJ_TAC THEN
          REPEAT (MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC) THEN
          ASM_REAL_ARITH_TAC],
        REWRITE_TAC [subpath, VECTOR_ADD_LID, VECTOR_SUB_RZERO] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
          MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX] THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
                   CONTINUOUS_ON_CMUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [FORALL_IN_IMAGE, SUBSET, FORALL_IN_GSPEC, IMP_CONJ] THEN
          REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_CMUL, DROP_VEC, DROP_ADD,
           ← REAL_ARITH (← q r"t + (&0 - t) * (&2 * x - &1) =
                       t * &2 * (&1 - x)")] THEN
          REPEAT STRIP_TAC THEN
          ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS, REAL_SUB_LE] THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"drop x * &2 * &1 / &2") THEN CONJ_TAC THEN
          REPEAT (MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC) THEN
          ASM_REAL_ARITH_TAC],
        SIMP_TAC [o_DEF, LIFT_DROP, ETA_AX, LINEAR_CONTINUOUS_ON, LINEAR_SNDCART],
        REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP] THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [subpath] THEN AP_TERM_TAC THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_SUB, DROP_VEC, DROP_ADD, DROP_CMUL,
                    LIFT_DROP] THEN
        REAL_ARITH_TAC],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX,
        ← SET_RULE (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
      REWRITE_TAC [← GSYM path_image] THEN MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN
      REWRITE_TAC [PATH_IMAGE_SUBPATH_GEN] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [path_image]) THEN
      MATCH_MP_TAC (← SET_RULE
        (← q r"t SUBSET s /\ u SUBSET s
         ==> IMAGE p s SUBSET v
             ==> IMAGE p t SUBSET v /\ IMAGE p u SUBSET v")) THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN CONJ_TAC THEN
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_INTERVAL] THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL],
      REWRITE_TAC [subpath, linepath, pathstart, joinpaths] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, DROP_VEC, VECTOR_MUL_LZERO] THEN
      REWRITE_TAC [VECTOR_ADD_RID, COND_ID] THEN VECTOR_ARITH_TAC,
      REWRITE_TAC [pathstart, PATHFINISH_LINEPATH, PATHSTART_LINEPATH]])

  let HOMOTOPIC_PATHS_LINV ← prove
   r"!s p:real^1->real^N.
        path p /\ path_image p SUBSET s
        ==> homotopic_paths s
              (reversepath p ++ p) (linepath(pathfinish p,pathfinish p))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"reversepath p:real^1->real^N"]
          HOMOTOPIC_PATHS_RINV) THEN
    ASM_SIMP_TAC [PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH] THEN
    REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                REVERSEPATH_REVERSEPATH])

  return { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_ASSOC,
           HOMOTOPIC_PATHS_RINV, HOMOTOPIC_PATHS_LINV }

/- ------------------------------------------------------------------------- -/
/- Cancellation for homotopy of paths.  (paths.ml 17877-17978)               -/
/- ------------------------------------------------------------------------- -/

structure PVL where
  HOMOTOPIC_PATHS_LCANCEL : thm
  HOMOTOPIC_PATHS_LCANCEL_EQ : thm
  HOMOTOPIC_PATHS_RCANCEL : thm
  HOMOTOPIC_PATHS_RCANCEL_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVL [HolBase] (D : PathsDeps) (BC : PTC) (BVI : PVI) (BVJ : PVJ) (BVK : PVK) :
    ExceptT String IO PVL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, .. } := D.cvx
  let { IMP_CONJ, IMP_CONJ_ALT, .. } := D.cvx.core2
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET, HOMOTOPIC_PATHS_REFL,
        HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS, .. } := BVI
  let { HOMOTOPIC_PATHS_JOIN, .. } := BVJ
  let { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_ASSOC, HOMOTOPIC_PATHS_RINV,
        HOMOTOPIC_PATHS_LINV, .. } := BVK
  -- @@SCOPE END

  let HOMOTOPIC_PATHS_LCANCEL ← prove
   r"!p q r s:real^N->bool.
        homotopic_paths s (p ++ q) (p ++ r) /\
        pathstart q = pathfinish p /\ pathstart r = pathfinish p
        ==> homotopic_paths s q r"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"homotopic_paths (s:real^N->bool)
                      (reversepath p ++ p ++ q) (reversepath p ++ p ++ r)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_REWRITE_TAC [PATHFINISH_REVERSEPATH, PATHSTART_JOIN] THEN
      ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATH_REVERSEPATH,
                      PATH_IMAGE_REVERSEPATH],
      MATCH_MP_TAC (← MESON [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]
       (← q r"homotopic_paths s p p' /\ homotopic_paths s q q'
        ==> homotopic_paths s p q ==> homotopic_paths s p' q'")) THEN
      CONJ_TAC THEN
      W (MP_TAC o PART_MATCH (rator o rand) HOMOTOPIC_PATHS_ASSOC o
        rator o snd) THEN
      ASM_REWRITE_TAC [PATH_REVERSEPATH, PATHFINISH_REVERSEPATH,
                      PATH_IMAGE_REVERSEPATH] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") HOMOTOPIC_PATHS_LID) THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"q:real^1->real^N")),
        DISCH_THEN (MP_TAC o SPEC (← q r"r:real^1->real^N"))] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_PATHS_TRANS) THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATHFINISH_JOIN] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_LINV THEN ASM_REWRITE_TAC []])

  let HOMOTOPIC_PATHS_LCANCEL_EQ ← prove
   r"!p q r s:real^N->bool.
        pathstart q = pathfinish p /\ pathstart r = pathfinish p
        ==> (homotopic_paths s (p ++ q) (p ++ r) <=>
              path p /\ path_image p SUBSET s /\ homotopic_paths s q r)"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [HOMOTOPIC_PATHS_JOIN, HOMOTOPIC_PATHS_REFL] THEN
    ASM_MESON_TAC [HOMOTOPIC_PATHS_LCANCEL])

  let HOMOTOPIC_PATHS_RCANCEL ← prove
   r"!p q r s:real^N->bool.
        homotopic_paths s (p ++ r) (q ++ r) /\
        pathfinish p = pathstart r /\ pathfinish q = pathstart r
        ==> homotopic_paths s p q"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"homotopic_paths (s:real^N->bool)
                      ((p ++ r) ++ reversepath r) ((q ++ r) ++ reversepath r)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_JOIN] THEN
      ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATH_REVERSEPATH,
                      PATH_IMAGE_REVERSEPATH],
      MATCH_MP_TAC (← MESON [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]
       (← q r"homotopic_paths s p p' /\ homotopic_paths s q q'
        ==> homotopic_paths s p q ==> homotopic_paths s p' q'")) THEN
      CONJ_TAC THEN
      W (MP_TAC o PART_MATCH (rator o rand)
        (← ONCE_REWRITE_RULE [HOMOTOPIC_PATHS_SYM] HOMOTOPIC_PATHS_ASSOC) o
        rator o snd) THEN
      ASM_REWRITE_TAC [PATH_REVERSEPATH, PATHSTART_REVERSEPATH,
                      PATH_IMAGE_REVERSEPATH] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") HOMOTOPIC_PATHS_RID) THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"p:real^1->real^N")),
        DISCH_THEN (MP_TAC o SPEC (← q r"q:real^1->real^N"))] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_PATHS_TRANS) THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATHSTART_JOIN] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_RINV THEN ASM_REWRITE_TAC []])

  let HOMOTOPIC_PATHS_RCANCEL_EQ ← prove
   r"!p q r s:real^N->bool.
        pathfinish p = pathstart r /\ pathfinish q = pathstart r
        ==> (homotopic_paths s (p ++ r) (q ++ r) <=>
             homotopic_paths s p q /\ path r /\ path_image r SUBSET s)"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET] THEN
    REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [HOMOTOPIC_PATHS_JOIN, HOMOTOPIC_PATHS_REFL] THEN
    ASM_MESON_TAC [HOMOTOPIC_PATHS_RCANCEL])

  return { HOMOTOPIC_PATHS_LCANCEL, HOMOTOPIC_PATHS_LCANCEL_EQ, HOMOTOPIC_PATHS_RCANCEL,
           HOMOTOPIC_PATHS_RCANCEL_EQ }

/- ------------------------------------------------------------------------- -/
/- Homotopy of loops without requiring preservation of endpoints.            -/
/- (paths.ml 17979-18150)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVM where
  homotopic_loops : thm
  HOMOTOPIC_LOOPS : thm
  HOMOTOPIC_LOOPS_IMP_LOOP : thm
  HOMOTOPIC_LOOPS_IMP_PATH : thm
  HOMOTOPIC_LOOPS_IMP_SUBSET : thm
  HOMOTOPIC_LOOPS_REFL : thm
  HOMOTOPIC_LOOPS_SYM : thm
  HOMOTOPIC_LOOPS_TRANS : thm
  HOMOTOPIC_LOOPS_SUBSET : thm
  HOMOTOPIC_LOOPS_EQ : thm
  HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE : thm
  HOMOTOPIC_LOOPS_SHIFTPATH_SELF : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVM [HolBase] (D : PathsDeps) (BA : PTA) (BE : PTE) (BVE : PVE) :
    ExceptT String IO PVM := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, VECTOR_ARITH, .. } :=
    D.cvx
  let { ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, PASTECART_IN_PCROSS, .. } := D.cvx.core3
  let { REAL_LE_ADD, REAL_LE_MUL, REAL_LE_MUL2, .. } := D.cvx.core4
  let { REAL_MUL_RID, REAL_POS, SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_MUL_RZERO, VECTOR_SUB_REFL, .. } := D.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, LIFT_EQ_CMUL, .. } := D.pvec
  let { HOMOTOPIC_WITH_EQ, HOMOTOPIC_WITH_IMP_PROPERTY, .. } := D.pmet1
  let { HOMOTOPIC_WITH_REFL, HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_ON_CASES_LE, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { shiftpath, CLOSED_SHIFTPATH, PATH_IMAGE_SHIFTPATH, .. } := BE
  let { HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS, HOMOTOPIC_WITH_IMP_SUBSET,
        HOMOTOPIC_WITH_MONO, HOMOTOPIC_WITH_SUBSET_RIGHT,
        HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, .. } := BVE
  -- @@SCOPE END

  let homotopic_loops ← new_definition
   r"homotopic_loops s p q =
     homotopic_with
       (\r. pathfinish r = pathstart r)
       (subtopology euclidean (interval[vec 0:real^1,vec 1]),
        subtopology euclidean s)
       p q"

  let HOMOTOPIC_LOOPS ← prove
   r"!s p q:real^1->real^N.
      homotopic_loops s p q <=>
      ?h. h continuous_on
          interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1] /\
          IMAGE h (interval[vec 0,vec 1] PCROSS interval[vec 0,vec 1])
          SUBSET s /\
          (!x. x IN interval[vec 0,vec 1] ==> h(pastecart (vec 0) x) = p x) /\
          (!x. x IN interval[vec 0,vec 1] ==> h(pastecart (vec 1) x) = q x) /\
          (!t. t IN interval[vec 0:real^1,vec 1]
               ==> pathfinish(h o pastecart t) = pathstart(h o pastecart t))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopic_loops] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) HOMOTOPIC_WITH_EUCLIDEAN_ALT o
      lhand o snd) THEN
    ANTS_TAC THENL
     [SIMP_TAC [pathstart, pathfinish, ENDS_IN_UNIT_INTERVAL],
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [o_DEF]])

  let HOMOTOPIC_LOOPS_IMP_LOOP ← prove
   r"!s p q. homotopic_loops s p q
           ==> pathfinish p = pathstart p /\
               pathfinish q = pathstart q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_loops] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_PROPERTY) THEN
    SIMP_TAC [])

  let HOMOTOPIC_LOOPS_IMP_PATH ← prove
   r"!s p q. homotopic_loops s p q ==> path p /\ path q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_loops] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
    SIMP_TAC [path])

  let HOMOTOPIC_LOOPS_IMP_SUBSET ← prove
   r"!s p q.
     homotopic_loops s p q ==> path_image p SUBSET s /\ path_image q SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_loops] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    SIMP_TAC [path_image])

  let HOMOTOPIC_LOOPS_REFL ← prove
   r"!s p. homotopic_loops s p p <=>
           path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p"
   (REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2,
                path, path_image] THEN
    CONV_TAC (fun t => TAUT t))

  let HOMOTOPIC_LOOPS_SYM ← prove
   r"!s p q. homotopic_loops s p q <=> homotopic_loops s q p"
   (REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_SYM])

  let HOMOTOPIC_LOOPS_TRANS ← prove
   r"!s p q r.
        homotopic_loops s p q /\ homotopic_loops s q r
        ==> homotopic_loops s p r"
   (REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_TRANS])

  let HOMOTOPIC_LOOPS_SUBSET ← prove
   r"!s p q.
        homotopic_loops s p q /\ s SUBSET t
        ==> homotopic_loops t p q"
   (REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_SUBSET_RIGHT])

  let HOMOTOPIC_LOOPS_EQ ← prove
   r"!p:real^1->real^N q s.
        path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p /\
        (!t. t IN interval[vec 0,vec 1] ==> p(t) = q(t))
        ==> homotopic_loops s p q"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homotopic_loops] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REPEAT (EXISTS_TAC (← q r"p:real^1->real^N")) THEN
    ASM_SIMP_TAC [HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2] THEN
    ASM_REWRITE_TAC [← GSYM path, ← GSYM path_image] THEN
    REWRITE_TAC [pathstart, pathfinish] THEN
    MESON_TAC [ENDS_IN_UNIT_INTERVAL])

  let HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE ← prove
   r"!f:real^1->real^M g h:real^M->real^N s t.
        homotopic_loops s f g /\
        h continuous_on s /\ IMAGE h s SUBSET t
        ==> homotopic_loops t (h o f) (h o g)"
   (REWRITE_TAC [homotopic_loops] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    SIMP_TAC [pathstart, pathfinish, o_THM])

  let HOMOTOPIC_LOOPS_SHIFTPATH_SELF ← prove
   r"!p:real^1->real^N t s.
        path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p /\
        t IN interval[vec 0,vec 1]
        ==> homotopic_loops s p (shiftpath t p)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMOTOPIC_LOOPS] THEN EXISTS_TAC
     (← q r"\z. shiftpath (drop t % fstcart z) (p:real^1->real^N) (sndcart z)") THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, o_DEF] THEN
    REWRITE_TAC [← GSYM LIFT_EQ_CMUL, VECTOR_MUL_RZERO, ETA_AX] THEN
    REPEAT CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE p t SUBSET u /\
        (!x. x IN s ==> IMAGE(shiftpath (f x) p) t = IMAGE p t)
        ==> (!x y. x IN s /\ y IN t ==> shiftpath (f x) p y  IN u)")) THEN
      ASM_REWRITE_TAC [← GSYM path_image] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC PATH_IMAGE_SHIFTPATH THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_VEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [REAL_LE_MUL] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_SIMP_TAC [],
      SIMP_TAC [shiftpath, VECTOR_ADD_LID, IN_INTERVAL_1, DROP_VEC],
      REWRITE_TAC [LIFT_DROP],
      X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN MATCH_MP_TAC CLOSED_SHIFTPATH THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_VEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [REAL_LE_MUL] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_SIMP_TAC []] THEN
    REWRITE_TAC [shiftpath, DROP_ADD, DROP_CMUL] THEN
    MATCH_MP_TAC CONTINUOUS_ON_CASES_LE THEN REPEAT CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_MUL, o_DEF, LIFT_DROP,
               LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
               CONTINUOUS_ON_CONST] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART] THEN
      REWRITE_TAC [IN_ELIM_THM, PASTECART_IN_PCROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_INTERVAL_1,
                   DROP_ADD, DROP_CMUL, DROP_VEC, REAL_LE_ADD, REAL_LE_MUL],
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_MUL, o_DEF, LIFT_DROP,
               LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
               CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART] THEN
      REWRITE_TAC [IN_ELIM_THM, PASTECART_IN_PCROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_INTERVAL_1, DROP_SUB,
                   DROP_ADD, DROP_CMUL, DROP_VEC, REAL_LE_ADD, REAL_LE_MUL] THEN
      SIMP_TAC [← REAL_ARITH (← q r"&0 <= x + y - &1 <=> &1 <= x + y")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"t * x <= &1 * &1 /\ y <= &1 ==> t * x + y - &1 <= &1")) THEN
      ASM_SIMP_TAC [REAL_LE_MUL2, REAL_POS],
      REWRITE_TAC [o_DEF, LIFT_ADD, LIFT_CMUL, LIFT_DROP] THEN
      SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, LINEAR_CONTINUOUS_ON,
               LINEAR_FSTCART, LINEAR_SNDCART],
      SIMP_TAC [← GSYM LIFT_EQ, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
               ← VECTOR_ARITH (← q r"a + b - c:real^1 = (a + b) - c")] THEN
      ASM_MESON_TAC [VECTOR_SUB_REFL, pathstart, pathfinish]])

  return { homotopic_loops, HOMOTOPIC_LOOPS, HOMOTOPIC_LOOPS_IMP_LOOP, HOMOTOPIC_LOOPS_IMP_PATH,
           HOMOTOPIC_LOOPS_IMP_SUBSET, HOMOTOPIC_LOOPS_REFL, HOMOTOPIC_LOOPS_SYM,
           HOMOTOPIC_LOOPS_TRANS, HOMOTOPIC_LOOPS_SUBSET, HOMOTOPIC_LOOPS_EQ,
           HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE, HOMOTOPIC_LOOPS_SHIFTPATH_SELF }

/- ------------------------------------------------------------------------- -/
/- Relations between the two variants of homotopy.  (paths.ml 18151-18393)   -/
/- ------------------------------------------------------------------------- -/

structure PVN where
  HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS : thm
  HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL : thm
  HOMOTOPIC_LOOPS_CONJUGATE : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVN [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BF : PTF) (BI : PTI)
    (BVE : PVE) (BVI : PVI) (BVJ : PVJ) (BVK : PVK) (BVM : PVM) : ExceptT String IO PVN := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, SET_RULE, GEN_SIMPLIFY_CONV,
        TOP_DEPTH_SQCONV, basic_ss, .. } := D.cvx
  let { CONJ_ASSOC, EMPTY_SUBSET, ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT,
        INSERT_SUBSET, IN_ELIM_PASTECART_THM, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, PCROSS, REAL_ADD_LID, .. } := D.cvx.core3
  let { REAL_LE_ADD, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_MUL2, .. } := D.cvx.core4
  let { REAL_MUL_RID, REAL_POS, REAL_SUB_LE, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SING_SUBSET,
        SNDCART_PASTECART, SUBSET, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNION_SUBSET, o_DEF, .. } := D.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_SUB, LINEAR_FSTCART,
        LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_SUB_LZERO, VECTOR_SUB_RZERO, .. } := D.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } :=
    D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { SEGMENT_REFL, .. } := D.cvx.top5
  let { PASTECART_FST_SND, .. } := D.pses2
  let { DROP_NEG, ENDS_IN_UNIT_INTERVAL, LIFT_NEG, .. } := D.pvec
  let { CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_REVERSEPATH,
        PATH_REVERSEPATH, PATH_JOIN, SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { subpath, PATHSTART_SUBPATH, PATHFINISH_SUBPATH, SUBPATH_TRIVIAL, SUBPATH_REVERSEPATH,
        PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH,
        LINEPATH_REFL, SUBPATH_REFL, .. } := BI
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_MONO, .. } := BVE
  let { homotopic_paths, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS, .. } := BVI
  let { HOMOTOPIC_JOIN_LEMMA, HOMOTOPIC_PATHS_JOIN, .. } := BVJ
  let { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_RINV, .. } := BVK
  let { homotopic_loops, HOMOTOPIC_LOOPS_IMP_LOOP, HOMOTOPIC_LOOPS_IMP_PATH,
        HOMOTOPIC_LOOPS_IMP_SUBSET, HOMOTOPIC_LOOPS_TRANS, .. } := BVM
  -- @@SCOPE END

  let HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS ← prove
   r"!s p q. homotopic_paths s p q /\
           pathfinish p = pathstart p /\
           pathfinish q = pathstart p
           ==> homotopic_loops s p q"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [homotopic_paths, homotopic_loops] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_MONO) THEN
    ASM_SIMP_TAC [])

  let HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL ← prove
   r"!s p a:real^N.
        homotopic_loops s p (linepath(a,a))
        ==> homotopic_paths s p (linepath(pathstart p,pathstart p))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o MATCH_MP HOMOTOPIC_LOOPS_IMP_LOOP) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_PATH) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_loops]) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^(1,1)finite_sum->real^N") THEN STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN EXISTS_TAC
     (← q r"(p:real^1->real^N) ++ linepath(pathfinish p,pathfinish p)") THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_SYM], ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN EXISTS_TAC
     (← q r"linepath(pathstart p,pathstart p) ++ (p:real^1->real^N) ++
      linepath(pathfinish p,pathfinish p)") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool",
         ← q r"(p:real^1->real^N) ++ linepath(pathfinish p,pathfinish p)"]
       HOMOTOPIC_PATHS_LID) THEN
      REWRITE_TAC [PATHSTART_JOIN] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [PATH_JOIN, PATH_LINEPATH, PATHSTART_LINEPATH] THEN
      MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN
      ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
      REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET] THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN EXISTS_TAC
     (← q r"((\u. (h:real^(1,1)finite_sum->real^N) (pastecart u (vec 0))) ++
       linepath(a,a) ++
       reversepath(\u. h (pastecart u (vec 0))))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC (← MESON [HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_JOIN,
                         HOMOTOPIC_PATHS_TRANS, HOMOTOPIC_PATHS_SYM,
                         HOMOTOPIC_PATHS_RINV]
         (← q r"(path p /\ path(reversepath p)) /\
          (path_image p SUBSET s /\ path_image(reversepath p) SUBSET s) /\
          (pathfinish p = pathstart(linepath(b,b) ++ reversepath p) /\
           pathstart(reversepath p) = b) /\
          pathstart p = a
          ==> homotopic_paths s (p ++ linepath(b,b) ++ reversepath p)
                                (linepath(a,a))")) THEN
      REWRITE_TAC [PATHSTART_REVERSEPATH, PATHSTART_JOIN, PATH_REVERSEPATH,
                  PATH_IMAGE_REVERSEPATH, PATHSTART_LINEPATH] THEN
      ASM_REWRITE_TAC [path, path_image, pathstart, pathfinish,
                      LINEPATH_REFL] THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
                 CONTINUOUS_ON_CONST] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM,
                 ENDS_IN_UNIT_INTERVAL],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            SUBSET_TRANS)) THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM,
                 ENDS_IN_UNIT_INTERVAL]]] THEN
    REWRITE_TAC [homotopic_paths, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    EXISTS_TAC
     (← q r"\y:real^(1,1)finite_sum.
          (subpath (vec 0) (fstcart y) (\u. h(pastecart u (vec 0))) ++
           (\u. (h:real^(1,1)finite_sum->real^N) (pastecart (fstcart y) u)) ++
           subpath (fstcart y) (vec 0) (\u. h(pastecart u (vec 0))))
          (sndcart y)") THEN
    ASM_REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, SUBPATH_TRIVIAL,
                    SUBPATH_REFL, SUBPATH_REVERSEPATH, ETA_AX,
                    PATHSTART_JOIN, PATHFINISH_JOIN,
                    PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                    PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC, REWRITE_TAC [pathstart]] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE [PCROSS] HOMOTOPIC_JOIN_LEMMA) THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC (← REWRITE_RULE [PCROSS] HOMOTOPIC_JOIN_LEMMA) THEN
        ASM_REWRITE_TAC [PASTECART_FST_SND, ETA_AX] THEN CONJ_TAC THENL
         [ALL_TAC,
          RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
          REWRITE_TAC [PATHSTART_SUBPATH] THEN
          ASM_SIMP_TAC [pathstart, pathfinish]],
        RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
        REWRITE_TAC [PATHFINISH_SUBPATH, PATHSTART_JOIN] THEN
        ASM_SIMP_TAC [pathstart]] THEN
      REWRITE_TAC [subpath] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      REWRITE_TAC [VECTOR_SUB_RZERO, VECTOR_SUB_LZERO, VECTOR_ADD_LID] THEN
      CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV (← ExceptT.mk (basic_ss [])) 5
         [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ADD, CONTINUOUS_ON_MUL,
          LIFT_DROP, CONTINUOUS_ON_NEG, DROP_NEG, CONTINUOUS_ON_CONST,
          CONTINUOUS_ON_ID, LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
          LIFT_NEG, o_DEF, ETA_AX])) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_ELIM_PASTECART_THM] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_INTERVAL_1] THEN
      REWRITE_TAC [DROP_ADD, DROP_NEG, DROP_VEC, DROP_CMUL, REAL_POS] THEN
      SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE, ← REAL_ARITH
       (← q r"t + --t * x = t * (&1 - x)")] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"t * x <= t * &1 /\ &1 * t <= &1 * &1 ==> t * x <= &1")) THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, IMP_CONJ,
        RIGHT_FORALL_IMP_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE
       (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
      REWRITE_TAC [← GSYM path_image, ETA_AX] THEN
      REPEAT (MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN CONJ_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        SUBSET_TRANS)) THEN
      REWRITE_TAC [path_image, subpath] THEN
      GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
      REWRITE_TAC [IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM] THEN
      SIMP_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, DROP_CMUL, DROP_ADD] THEN
      REWRITE_TAC [REAL_ADD_LID, REAL_SUB_RZERO, REAL_POS] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"t + (&0 - t) * x = t * (&1 - x)")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE] THEN
      REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_REAL_ARITH_TAC])

  let HOMOTOPIC_LOOPS_CONJUGATE ← prove
   r"!p q s:real^N->bool.
        path p /\ path_image p SUBSET s /\
        path q /\ path_image q SUBSET s /\
        pathfinish p = pathstart q /\ pathfinish q = pathstart q
        ==> homotopic_loops s (p ++ q ++ reversepath p) q"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN EXISTS_TAC
     (← q r"linepath(pathstart q,pathstart q) ++ (q:real^1->real^N) ++
      linepath(pathstart q,pathstart q)") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool",
         ← q r"(q:real^1->real^N) ++ linepath(pathfinish q,pathfinish q)"]
       HOMOTOPIC_PATHS_LID) THEN
      ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, UNION_SUBSET, SING_SUBSET,
                   PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH,
                   PATH_JOIN, PATH_IMAGE_JOIN, PATH_LINEPATH, SEGMENT_REFL] THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      ASM_MESON_TAC [HOMOTOPIC_PATHS_RID]] THEN
    REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    EXISTS_TAC
     (← q r"(\y. (subpath (fstcart y) (vec 1) p ++ q ++ subpath (vec 1) (fstcart y) p)
           (sndcart y)):real^(1,1)finite_sum->real^N") THEN
    ASM_REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, SUBPATH_TRIVIAL,
                    SUBPATH_REFL, SUBPATH_REVERSEPATH, ETA_AX,
                   PATHSTART_JOIN, PATHFINISH_JOIN,
                    PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                    PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    ASM_REWRITE_TAC [pathstart, pathfinish] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [path, path_image]) THEN
      MATCH_MP_TAC (← REWRITE_RULE [PCROSS] HOMOTOPIC_JOIN_LEMMA) THEN
      REPEAT CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC (← REWRITE_RULE [PCROSS] HOMOTOPIC_JOIN_LEMMA) THEN
        REPEAT CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
          SIMP_TAC [SNDCART_PASTECART],
          ALL_TAC,
          REWRITE_TAC [PATHSTART_SUBPATH] THEN ASM_REWRITE_TAC [pathfinish]],
        REWRITE_TAC [PATHSTART_JOIN, PATHFINISH_SUBPATH] THEN
        ASM_REWRITE_TAC [pathstart]] THEN
      REWRITE_TAC [subpath] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      (CONJ_TAC THENL
        [REWRITE_TAC [DROP_SUB] THEN MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
         SIMP_TAC [LINEAR_CONTINUOUS_ON, CONTINUOUS_ON_CONST, LINEAR_FSTCART] THEN
         MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
         SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
         REWRITE_TAC [o_DEF, LIFT_SUB, LIFT_DROP] THEN
         SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON,
                  LINEAR_FSTCART],
         FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
         REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
         REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_INTERVAL_1] THEN
         REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC, DROP_CMUL]])
      THENL
       [REPEAT STRIP_TAC THENL
         [MATCH_MP_TAC REAL_LE_ADD THEN CONJ_TAC THEN
          TRY (MATCH_MP_TAC REAL_LE_MUL) THEN ASM_REAL_ARITH_TAC,
          REWRITE_TAC [← REAL_ARITH (← q r"t + (&1 - t) * x <= &1 <=>
                                  (&1 - t) * x <= (&1 - t) * &1")] THEN
          MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REAL_ARITH_TAC],
        REPEAT STRIP_TAC THENL
         [MATCH_MP_TAC (← REAL_ARITH
           (← q r"x * (&1 - t) <= x * &1 /\ x <= &1
            ==> &0 <= &1 + (t - &1) * x")) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [← REAL_ARITH
           (← q r"a + (t - &1) * x <= a <=> &0 <= (&1 - t) * x")] THEN
          MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC]],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [ETA_AX, ← GSYM path_image, ← SET_RULE
        (← q r"(!x. x IN i ==> f x IN s) <=> IMAGE f i SUBSET s")] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN CONJ_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"path_image p:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC PATH_IMAGE_SUBPATH_SUBSET THEN
      ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL]])

  return { HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS, HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL,
           HOMOTOPIC_LOOPS_CONJUGATE }

/- ------------------------------------------------------------------------- -/
/- Relating homotopy of trivial loops to path-connectedness; homotopy of     -/
/- "nearby" function, paths and loops.  (paths.ml 18394-18603)               -/
/- ------------------------------------------------------------------------- -/

structure PVO where
  PATH_COMPONENT_IMP_HOMOTOPIC_POINTS : thm
  HOMOTOPIC_LOOPS_IMP_PATH_COMPONENT_VALUE : thm
  HOMOTOPIC_POINTS_EQ_PATH_COMPONENT : thm
  PATH_CONNECTED_EQ_HOMOTOPIC_POINTS : thm
  HOMOTOPIC_WITH_LINEAR : thm
  HOMOTOPIC_PATHS_LINEAR : thm
  HOMOTOPIC_LOOPS_LINEAR : thm
  HOMOTOPIC_PATHS_NEARBY_EXPLICIT : thm
  HOMOTOPIC_LOOPS_NEARBY_EXPLICIT : thm
  HOMOTOPIC_NEARBY_PATHS : thm
  HOMOTOPIC_NEARBY_LOOPS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVO [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BI : PTI) (BK : PTK)
    (BVE : PVE) (BVI : PVI) (BVM : PVM) : ExceptT String IO PVO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, VECTOR_ARITH, .. } := D.cvx
  let { ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FSTCART_PASTECART, IMP_CONJ, IMP_IMP, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_UNIV, MONO_EXISTS, PCROSS, .. } := D.cvx.core3
  let { REAL_LTE_TRANS, .. } := D.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_POS, REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_IMP_FORALL_THM,
        SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, .. } := D.cvx.core6
  let { DIST_SYM, .. } := D.cvx.vec1
  let { DROP_VEC, LIFT_DROP, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_LID, VECTOR_MUL_LZERO, dist, .. } := D.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, DIST_IN_CLOSED_SEGMENT, .. } :=
    D.cvx.top3
  let { IN_INTERVAL_1, IN_SEGMENT, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { SEPARATE_COMPACT_CLOSED, segment, .. } := D.cvx.top5
  let { CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { OPEN_CLOSED, .. } := D.ptop5
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { COMPACT_PATH_IMAGE, .. } := BB
  let { linepath, .. } := BI
  let { path_component, path_connected, .. } := BK
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { homotopic_paths, .. } := BVI
  let { homotopic_loops, .. } := BVM
  -- @@SCOPE END

  let PATH_COMPONENT_IMP_HOMOTOPIC_POINTS ← prove
   r"!s a b:real^N.
        path_component s a b
        ==> homotopic_loops s (linepath(a,a)) (linepath(b,b))"
   (REWRITE_TAC [path_component, homotopic_loops,
                HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [pathstart, pathfinish, path_image, path] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\y:real^(1,1)finite_sum. (g(fstcart y):real^N)") THEN
    ASM_SIMP_TAC [FSTCART_PASTECART, linepath] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - x) % a + x % a:real^N = a")] THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
    SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC, FSTCART_PASTECART])

  let HOMOTOPIC_LOOPS_IMP_PATH_COMPONENT_VALUE ← prove
   r"!s p q:real^1->real^N t.
        homotopic_loops s p q /\ t IN interval[vec 0,vec 1]
        ==> path_component s (p t) (q t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [path_component, homotopic_loops,
                HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,1)finite_sum->real^N") MP_TAC) THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"\u. (h:real^(1,1)finite_sum->real^N) (pastecart u t)") THEN
    ASM_REWRITE_TAC [pathstart, pathfinish] THEN CONJ_TAC THENL
     [REWRITE_TAC [path] THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
        ASM SET_TAC []],
      REWRITE_TAC [path_image] THEN ASM SET_TAC []])

  let HOMOTOPIC_POINTS_EQ_PATH_COMPONENT ← prove
   r"!s a b:real^N.
        homotopic_loops s (linepath(a,a)) (linepath(b,b)) <=>
        path_component s a b"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [PATH_COMPONENT_IMP_HOMOTOPIC_POINTS] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      HOMOTOPIC_LOOPS_IMP_PATH_COMPONENT_VALUE)) THEN
    REWRITE_TAC [linepath, IN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - &0) % a + &0 % b:real^N = a")])

  let PATH_CONNECTED_EQ_HOMOTOPIC_POINTS ← prove
   r"!s:real^N->bool.
        path_connected s <=>
        !a b. a IN s /\ b IN s
              ==> homotopic_loops s (linepath(a,a)) (linepath(b,b))"
   (GEN_TAC THEN REWRITE_TAC [HOMOTOPIC_POINTS_EQ_PATH_COMPONENT] THEN
    REWRITE_TAC [path_connected, path_component])

  /- Homotopy of "nearby" function, paths and loops. -/

  let HOMOTOPIC_WITH_LINEAR ← prove
   r"!f g:real^M->real^N s t.
        f continuous_on s /\ g continuous_on s /\
        (!x. x IN s ==> segment[f x,g x] SUBSET t)
        ==> homotopic_with (\z. T)
             (subtopology euclidean s,subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN] THEN
    EXISTS_TAC
      (← q r"\y. ((&1 - drop(fstcart y)) % (f:real^M->real^N)(sndcart y) +
           drop(fstcart y) % g(sndcart y):real^N)") THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC] THEN
    ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_SUB_RZERO] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - t) % a + t % a:real^N = a")] THEN
    REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID] THEN
    REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, LIFT_SUB] THEN
      SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON,
               LINEAR_FSTCART, ETA_AX] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      SIMP_TAC [SNDCART_PASTECART, FORALL_IN_PCROSS],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^1", ← q r"u:real^M"] THEN STRIP_TAC THEN
      SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, RIGHT_IMP_FORALL_THM, IMP_IMP]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"u:real^M") THEN
      ASM_REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"drop t") THEN
      ASM_MESON_TAC [IN_INTERVAL_1, DROP_VEC]])

  let (HOMOTOPIC_PATHS_LINEAR, HOMOTOPIC_LOOPS_LINEAR) ← CONJ_PAIR (← prove
   r"(!g s:real^N->bool h.
        path g /\ path h /\
        pathstart h = pathstart g /\ pathfinish h = pathfinish g /\
        (!t x. t IN interval[vec 0,vec 1] ==> segment[g t,h t] SUBSET s)
        ==> homotopic_paths s g h) /\
   (!g s:real^N->bool h.
        path g /\ path h /\
        pathfinish g = pathstart g /\ pathfinish h = pathstart h /\
        (!t x. t IN interval[vec 0,vec 1] ==> segment[g t,h t] SUBSET s)
        ==> homotopic_loops s g h)"
   (CONJ_TAC THEN
   (REWRITE_TAC [pathstart, pathfinish] THEN
    REWRITE_TAC [SUBSET, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [homotopic_paths, homotopic_loops,
                HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    EXISTS_TAC
     (← q r"\y:real^(1,1)finite_sum.
        ((&1 - drop(fstcart y)) % g(sndcart y) +
         drop(fstcart y) % h(sndcart y):real^N)") THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC] THEN
    ASM_REWRITE_TAC [pathstart, pathfinish, REAL_SUB_REFL, REAL_SUB_RZERO] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - t) % a + t % a:real^N = a")] THEN
    REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_MUL_LID] THEN
    REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [o_DEF, LIFT_DROP, LIFT_SUB] THEN
      SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON,
               LINEAR_FSTCART, ETA_AX] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      SIMP_TAC [SNDCART_PASTECART],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^1", ← q r"u:real^1"] THEN STRIP_TAC THEN
      SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"u:real^1") THEN
      ASM_REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"drop t") THEN
      ASM_MESON_TAC [IN_INTERVAL_1, DROP_VEC]])))

  let (HOMOTOPIC_PATHS_NEARBY_EXPLICIT, HOMOTOPIC_LOOPS_NEARBY_EXPLICIT) ← CONJ_PAIR (← prove
   r"(!g s:real^N->bool h.
        path g /\ path h /\
        pathstart h = pathstart g /\ pathfinish h = pathfinish g /\
        (!t x. t IN interval[vec 0,vec 1] /\ ~(x IN s)
               ==> norm(h t - g t) < norm(g t - x))
        ==> homotopic_paths s g h) /\
   (!g s:real^N->bool h.
        path g /\ path h /\
        pathfinish g = pathstart g /\ pathfinish h = pathstart h /\
        (!t x. t IN interval[vec 0,vec 1] /\ ~(x IN s)
               ==> norm(h t - g t) < norm(g t - x))
        ==> homotopic_loops s g h)"
   (ONCE_REWRITE_TAC [← TAUT (← q r"p /\ ~q ==> r <=> p /\ ~r ==> q")] THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_LINEAR,
      MATCH_MP_TAC HOMOTOPIC_LOOPS_LINEAR] THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET, segment, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"t:real^1") THEN
    ASM_REWRITE_TAC [REAL_NOT_LT] THEN
    MP_TAC (← ISPECL [← q r"(g:real^1->real^N) t", ← q r"(h:real^1->real^N) t"]
        DIST_IN_CLOSED_SEGMENT) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    REWRITE_TAC [segment, FORALL_IN_GSPEC,
                ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
    ASM_MESON_TAC []))

  let (HOMOTOPIC_NEARBY_PATHS, HOMOTOPIC_NEARBY_LOOPS) ← CONJ_PAIR (← prove
   r"(!g s:real^N->bool.
        path g /\ open s /\ path_image g SUBSET s
        ==> ?e. &0 < e /\
                !h. path h /\
                    pathstart h = pathstart g /\
                    pathfinish h = pathfinish g /\
                    (!t. t IN interval[vec 0,vec 1] ==> norm(h t - g t) < e)
                    ==> homotopic_paths s g h) /\
   (!g s:real^N->bool.
        path g /\ pathfinish g = pathstart g /\ open s /\ path_image g SUBSET s
        ==> ?e. &0 < e /\
                !h. path h /\
                    pathfinish h = pathstart h /\
                    (!t. t IN interval[vec 0,vec 1] ==> norm(h t - g t) < e)
                    ==> homotopic_loops s g h)"
   (CONJ_TAC THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"path_image g:real^N->bool", ← q r"(:real^N) DIFF s"]
          SEPARATE_COMPACT_CLOSED) THEN
    ASM_SIMP_TAC [COMPACT_PATH_IMAGE, ← GSYM OPEN_CLOSED] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_DIFF, IN_UNIV, dist]]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    REWRITE_TAC [REAL_NOT_LE] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"h:real^1->real^N") THEN STRIP_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_NEARBY_EXPLICIT,
      MATCH_MP_TAC HOMOTOPIC_LOOPS_NEARBY_EXPLICIT] THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:real^1", ← q r"x:real^N"] THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"e:real") THEN
    ASM_SIMP_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [path_image] THEN ASM SET_TAC []))

  return { PATH_COMPONENT_IMP_HOMOTOPIC_POINTS, HOMOTOPIC_LOOPS_IMP_PATH_COMPONENT_VALUE,
           HOMOTOPIC_POINTS_EQ_PATH_COMPONENT, PATH_CONNECTED_EQ_HOMOTOPIC_POINTS,
           HOMOTOPIC_WITH_LINEAR, HOMOTOPIC_PATHS_LINEAR, HOMOTOPIC_LOOPS_LINEAR,
           HOMOTOPIC_PATHS_NEARBY_EXPLICIT, HOMOTOPIC_LOOPS_NEARBY_EXPLICIT,
           HOMOTOPIC_NEARBY_PATHS, HOMOTOPIC_NEARBY_LOOPS }

/- ------------------------------------------------------------------------- -/
/- Homotopy of non-antipodal sphere maps; retracts, in a general sense,      -/
/- preserve (co)homotopic triviality.  (paths.ml 18604-18841)                -/
/- ------------------------------------------------------------------------- -/

structure PVP where
  HOMOTOPIC_NON_MIDPOINT_SPHEREMAPS : thm
  HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS : thm
  HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN : thm
  HOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN : thm
  COHOMOTOPICALLY_TRIVIAL_RETRACTION_GEN : thm
  COHOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVP [HolBase] (D : PathsDeps) (BVE : PVE) (BVO : PVO) : ExceptT String IO PVP := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, .. } := D.cvx
  let { AND_FORALL_THM, EMPTY_SUBSET, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DELETE, .. } := D.cvx.core2
  let { IN_UNIV, MONO_EXISTS, REAL_ABS_DIV, REAL_DIV_REFL, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_LE_RMUL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LE, .. } := D.cvx.core4
  let { REAL_NOT_LE, SUBSET, SUBSET_REFL, .. } := D.cvx.core5
  let { o_DEF, o_THM, real_abs, real_div, .. } := D.cvx.core6
  let { DIST_SYM, .. } := D.cvx.vec1
  let { LIFT_CMUL, NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.cvx.vec3
  let { VECTOR_SUB_EQ, midpoint, .. } := D.cvx.vec4
  let { BETWEEN_IN_SEGMENT, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_SPHERE, .. } := D.cvx.top4
  let { SPHERE_EMPTY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { MIDPOINT_BETWEEN, .. } := D.pvec
  let { HOMOTOPIC_WITH_EQ, .. } := D.pmet1
  let { HOMOTOPIC_WITH_REFL, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { SPHERE_SING, .. } := D.ptop5
  let { HOMOTOPIC_WITH_MONO, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT,
        HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_LEFT, .. } := BVE
  let { HOMOTOPIC_WITH_LINEAR, .. } := BVO
  -- @@SCOPE END

  let HOMOTOPIC_NON_MIDPOINT_SPHEREMAPS ← prove
   r"!f g:real^M->real^N s a r.
        f continuous_on s /\ IMAGE f s SUBSET sphere(a,r) /\
        g continuous_on s /\ IMAGE g s SUBSET sphere(a,r) /\
        (!x. x IN s ==> ~(midpoint(f x,g x) = a))
    ==> homotopic_with (\x. T)
         (subtopology euclidean s,subtopology euclidean (sphere(a,r))) f g"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r <= &0") THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      REPEAT (EXISTS_TAC (← q r"g:real^M->real^N")) THEN
      ASM_REWRITE_TAC [HOMOTOPIC_WITH_REFL, CONTINUOUS_MAP_EUCLIDEAN2] THEN
      SUBGOAL_THEN (← q r"?c:real^N. sphere(a,r) SUBSET {c}") MP_TAC THENL
       [ALL_TAC, ASM SET_TAC []] THEN
      ASM_CASES_TAC (← q r"r = &0") THEN
      ASM_SIMP_TAC [SPHERE_SING, SPHERE_EMPTY, REAL_LT_LE] THEN
      MESON_TAC [SUBSET_REFL, EMPTY_SUBSET],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE]) THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"homotopic_with (\z. T)
       (subtopology euclidean (s:real^M->bool),
        subtopology euclidean ((:real^N) DELETE a)) f g")
    MP_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_WITH_LINEAR THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DELETE a <=> ~(a IN s)")] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_SPHERE, IMP_IMP] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
      FIRST_X_ASSUM (MP_TAC o GSYM o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, MIDPOINT_BETWEEN] THEN
      MESON_TAC [DIST_SYM],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o
      ISPECL [← q r"\y:real^N. a + r / norm(y - a) % (y - a)",
              ← q r"sphere(a:real^N,r)"] o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      HOMOTOPIC_COMPOSE_CONTINUOUS_LEFT)) THEN
    REWRITE_TAC [o_DEF] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [real_div, o_DEF, LIFT_CMUL] THEN
        MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [IN_DELETE, NORM_EQ_0, VECTOR_SUB_EQ] THEN
        MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_DELETE, IN_SPHERE] THEN
        REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a + b) = norm b")] THEN
        SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
        ASM_SIMP_TAC [real_abs, REAL_LE_RMUL, REAL_DIV_RMUL,
                     NORM_EQ_0, VECTOR_SUB_EQ, REAL_LT_IMP_LE]],
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_EQ) THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE, IN_SPHERE]) THEN
        ASM_SIMP_TAC [← NORM_ARITH (← q r"norm(a - b:real^N) = dist(b,a)")] THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ] THEN REPEAT STRIP_TAC THEN
        VECTOR_ARITH_TAC])

  let HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS ← prove
   r"!f g:real^M->real^N s r.
        f continuous_on s /\ IMAGE f s SUBSET sphere(vec 0,r) /\
        g continuous_on s /\ IMAGE g s SUBSET sphere(vec 0,r) /\
        (!x. x IN s ==> ~(f x = --g x))
    ==> homotopic_with (\x. T)
         (subtopology euclidean s,subtopology euclidean (sphere(vec 0,r))) f g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_NON_MIDPOINT_SPHEREMAPS THEN
    ASM_REWRITE_TAC [midpoint, ← VECTOR_ARITH
     (← q r"inv(&2) % (a + b):real^N = vec 0 <=> a = --b")])

  /- Retracts, in a general sense, preserve (co)homotopic triviality. -/

  let HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN ← prove
   r"!P Q s:real^M->bool t:real^N->bool u:real^P->bool h k.
        (h continuous_on s /\ IMAGE h s = t /\
         k continuous_on t /\ IMAGE k t SUBSET s /\
         (!y. y IN t ==> h(k y) = y) /\
         (!f. f continuous_on u /\ IMAGE f u SUBSET t /\ Q f ==> P(k o f)) /\
         (!f. f continuous_on u /\ IMAGE f u SUBSET s /\ P f ==> Q(h o f)) /\
         (!h k. (!x. x IN u ==> h x = k x) ==> (Q h <=> Q k))) /\
        (!f g. f continuous_on u /\ IMAGE f u SUBSET s /\ P f /\
               g continuous_on u /\ IMAGE g u SUBSET s /\ P g
               ==> homotopic_with P
                    (subtopology euclidean u,subtopology euclidean s)  f g)
        ==> (!f g. f continuous_on u /\ IMAGE f u SUBSET t /\ Q f /\
                   g continuous_on u /\ IMAGE g u SUBSET t /\ Q g
                   ==> homotopic_with Q
                        (subtopology euclidean u,subtopology euclidean t) f g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"p:real^P->real^N", ← q r"q:real^P->real^N"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(k:real^N->real^M) o (p:real^P->real^N)",
      ← q r"(k:real^N->real^M) o (q:real^P->real^N)"]) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [IMAGE_o] THEN REPEAT CONJ_TAC THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN ASM_REWRITE_TAC [] THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC [],
      DISCH_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(h:real^M->real^N) o (k:real^N->real^M) o (p:real^P->real^N)",
      ← q r"(h:real^M->real^N) o (k:real^N->real^M) o (q:real^P->real^N)"] THEN
    ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    ASM_SIMP_TAC [])

  let HOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN ← prove
   r"!P Q s:real^M->bool t:real^N->bool u:real^P->bool h k.
        (h continuous_on s /\ IMAGE h s = t /\
         k continuous_on t /\ IMAGE k t SUBSET s /\
         (!y. y IN t ==> h(k y) = y) /\
         (!f. f continuous_on u /\ IMAGE f u SUBSET t /\ Q f ==> P(k o f)) /\
         (!f. f continuous_on u /\ IMAGE f u SUBSET s /\ P f ==> Q(h o f)) /\
         (!h k. (!x. x IN u ==> h x = k x) ==> (Q h <=> Q k))) /\
        (!f. f continuous_on u /\ IMAGE f u SUBSET s /\ P f
             ==> ?c. homotopic_with P
                      (subtopology euclidean u,subtopology euclidean s)
                      f (\x. c))
        ==> (!f. f continuous_on u /\ IMAGE f u SUBSET t /\ Q f
                 ==> ?c. homotopic_with Q
                          (subtopology euclidean u,subtopology euclidean t)
                          f (\x. c))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"p:real^P->real^N") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"(k:real^N->real^M) o (p:real^P->real^N)")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [IMAGE_o] THEN CONJ_TAC THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN ASM_REWRITE_TAC [] THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^M"))] THEN
    EXISTS_TAC (← q r"(h:real^M->real^N) c") THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(h:real^M->real^N) o (k:real^N->real^M) o (p:real^P->real^N)",
      ← q r"(h:real^M->real^N) o ((\x. c):real^P->real^M)"] THEN
    ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    ASM_SIMP_TAC [])

  let COHOMOTOPICALLY_TRIVIAL_RETRACTION_GEN ← prove
   r"!P Q s:real^M->bool t:real^N->bool u:real^P->bool h k.
        (h continuous_on s /\ IMAGE h s = t /\
         k continuous_on t /\ IMAGE k t SUBSET s /\
         (!y. y IN t ==> h(k y) = y) /\
         (!f. f continuous_on t /\ IMAGE f t SUBSET u /\ Q f ==> P(f o h)) /\
         (!f. f continuous_on s /\ IMAGE f s SUBSET u /\ P f ==> Q(f o k)) /\
         (!h k. (!x. x IN t ==> h x = k x) ==> (Q h <=> Q k))) /\
        (!f g. f continuous_on s /\ IMAGE f s SUBSET u /\ P f /\
               g continuous_on s /\ IMAGE g s SUBSET u /\ P g
               ==> homotopic_with P
                    (subtopology euclidean s,
                     subtopology euclidean u) f g)
        ==> (!f g. f continuous_on t /\ IMAGE f t SUBSET u /\ Q f /\
                   g continuous_on t /\ IMAGE g t SUBSET u /\ Q g
                   ==> homotopic_with Q
                       (subtopology euclidean t,subtopology euclidean u) f g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"p:real^N->real^P", ← q r"q:real^N->real^P"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(p:real^N->real^P) o (h:real^M->real^N)",
      ← q r"(q:real^N->real^P) o (h:real^M->real^N)"]) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [IMAGE_o] THEN REPEAT CONJ_TAC THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN ASM_REWRITE_TAC [] THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC [],
      DISCH_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"((p:real^N->real^P) o (h:real^M->real^N)) o (k:real^N->real^M)",
      ← q r"((q:real^N->real^P) o (h:real^M->real^N)) o (k:real^N->real^M)"] THEN
    ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    ASM_SIMP_TAC [])

  let COHOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN ← prove
   r"!P Q s:real^M->bool t:real^N->bool u:real^P->bool h k.
        (h continuous_on s /\ IMAGE h s = t /\
         k continuous_on t /\ IMAGE k t SUBSET s /\
         (!y. y IN t ==> h(k y) = y) /\
         (!f. f continuous_on t /\ IMAGE f t SUBSET u /\ Q f ==> P(f o h)) /\
         (!f. f continuous_on s /\ IMAGE f s SUBSET u /\ P f ==> Q(f o k)) /\
         (!h k. (!x. x IN t ==> h x = k x) ==> (Q h <=> Q k))) /\
        (!f. f continuous_on s /\ IMAGE f s SUBSET u /\ P f
             ==> ?c. homotopic_with P
                      (subtopology euclidean s,subtopology euclidean u)
                      f (\x. c))
        ==> (!f. f continuous_on t /\ IMAGE f t SUBSET u /\ Q f
                 ==> ?c. homotopic_with Q
                           (subtopology euclidean t,subtopology euclidean u)
                           f (\x. c))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"p:real^N->real^P") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"(p:real^N->real^P) o (h:real^M->real^N)")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [IMAGE_o] THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN ASM_REWRITE_TAC [] THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^P") THEN DISCH_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"((p:real^N->real^P) o (h:real^M->real^N)) o (k:real^N->real^M)",
      ← q r"((\x. c):real^M->real^P) o (k:real^N->real^M)"] THEN
    ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_MONO)) THEN
    ASM_SIMP_TAC [])

  return { HOMOTOPIC_NON_MIDPOINT_SPHEREMAPS, HOMOTOPIC_NON_ANTIPODAL_SPHEREMAPS,
           HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN, HOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN,
           COHOMOTOPICALLY_TRIVIAL_RETRACTION_GEN, COHOMOTOPICALLY_TRIVIAL_RETRACTION_NULL_GEN }

/- ------------------------------------------------------------------------- -/
/- Another useful lemma; shifting and adding loops.  (paths.ml 18842-19138)  -/
/- ------------------------------------------------------------------------- -/

structure PVQ where
  HOMOTOPIC_JOIN_SUBPATHS : thm
  HOMOTOPIC_LOOPS_SHIFTPATH : thm
  HOMOTOPIC_PATHS_LOOP_PARTS : thm
  HOMOTOPIC_LOOPS_ADD_SYM : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVQ [HolBase] (D : PathsDeps) (BA : PTA) (BC : PTC) (BD : PTD) (BE : PTE) (BF : PTF)
    (BI : PTI) (BVE : PVE) (BVI : PVI) (BVJ : PVJ) (BVK : PVK) (BVM : PVM) (BVN : PVN) :
    ExceptT String IO PVQ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss, VECTOR_ARITH, .. } :=
    D.cvx
  let { EMPTY_SUBSET, ETA_AX, EXTENSION, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, IMP_CONJ, INSERT_SUBSET, IN_ELIM_PASTECART_THM, .. } :=
    D.cvx.core2
  let { IN_IMAGE, IN_UNION, PCROSS, .. } := D.cvx.core3
  let { REAL_LE_ADD, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LT_LE,
        .. } := D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_SYM,
        REAL_SUB_0, REAL_SUB_LT, SING_SUBSET, SNDCART_PASTECART, SUBSET, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { UNION_SUBSET, o_DEF, real_div, .. } := D.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, .. } := D.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { SEGMENT_REFL, .. } := D.cvx.top5
  let { DROP_EQ_0, .. } := D.pvec
  let { CLOSED_PCROSS, .. } := D.ptop1
  let { CONTINUOUS_ON_CASES, CONTINUOUS_ON_CASES_1, .. } := D.ptop2
  let { CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { pathstart, pathfinish, path_image, joinpaths, .. } := BA
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_IMAGE_JOIN,
        REVERSEPATH_JOINPATHS, .. } := BC
  let { PATH_JOIN_PATH_ENDS, .. } := BD
  let { shiftpath, CLOSED_SHIFTPATH, PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH, .. } := BE
  let { subpath, PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH, REVERSEPATH_SUBPATH,
        PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  let { PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, LINEPATH_REFL, SUBPATH_REFL,
        .. } := BI
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
        HOMOTOPIC_PATHS_REFL, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS,
        HOMOTOPIC_PATHS_REPARAMETRIZE, HOMOTOPIC_PATHS_SUBSET, .. } := BVI
  let { HOMOTOPIC_PATHS_REVERSEPATH, HOMOTOPIC_PATHS_JOIN, .. } := BVJ
  let { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_ASSOC, HOMOTOPIC_PATHS_RINV,
        HOMOTOPIC_PATHS_LINV, .. } := BVK
  let { homotopic_loops, HOMOTOPIC_LOOPS_TRANS, HOMOTOPIC_LOOPS_EQ,
        HOMOTOPIC_LOOPS_SHIFTPATH_SELF, .. } := BVM
  let { HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL, .. } := BVN
  -- @@SCOPE END

  let HOMOTOPIC_JOIN_SUBPATHS ← prove
   r"!g:real^1->real^N s.
       path g /\ path_image g SUBSET s /\
       u IN interval[vec 0,vec 1] /\
       v IN interval[vec 0,vec 1] /\
       w IN interval[vec 0,vec 1]
       ==> homotopic_paths s (subpath u v g ++ subpath v w g) (subpath u w g)"
   (← do
    let lemma1 ← prove
     r"!g:real^1->real^N s.
         drop u <= drop v /\ drop v <= drop w
         ==> path g /\ path_image g SUBSET s /\
             u IN interval[vec 0,vec 1] /\
             v IN interval[vec 0,vec 1] /\
             w IN interval[vec 0,vec 1] /\
             drop u <= drop v /\ drop v <= drop w
             ==> homotopic_paths s
                 (subpath u v g ++ subpath v w g) (subpath u w g)"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_SUBSET THEN
      EXISTS_TAC (← q r"path_image g:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"w:real^1 = u") THENL
       [MP_TAC (← ISPECL
        [← q r"path_image g:real^N->bool",
         ← q r"subpath u v (g:real^1->real^N)"] HOMOTOPIC_PATHS_RINV) THEN
        ASM_REWRITE_TAC [REVERSEPATH_SUBPATH, SUBPATH_REFL] THEN
        REWRITE_TAC [LINEPATH_REFL, PATHSTART_SUBPATH] THEN
        ASM_SIMP_TAC [PATH_SUBPATH, PATH_IMAGE_SUBPATH_SUBSET],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_REPARAMETRIZE THEN
      ASM_SIMP_TAC [PATH_SUBPATH, PATH_IMAGE_SUBPATH_SUBSET] THEN
      EXISTS_TAC
      (← q r"\t. if drop t <= &1 / &2
           then inv(drop(w - u)) % (&2 * drop(v - u)) % t
           else inv(drop(w - u)) %
                ((v - u) + drop(w - v) % (&2 % t - vec 1))") THEN
      REWRITE_TAC [DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [VECTOR_MUL_RZERO] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_CASES_1 THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, LIFT_DROP, ← GSYM LIFT_NUM,
                    DROP_ADD, DROP_SUB] THEN
        CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV (← ExceptT.mk (basic_ss [])) 5
          [CONTINUOUS_ON_MUL, o_DEF, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
           CONTINUOUS_ON_SUB, CONTINUOUS_ON_ADD])) THEN
        REPEAT STRIP_TAC THEN REAL_ARITH_TAC,
        SUBGOAL_THEN (← q r"drop u < drop w") ASSUME_TAC THENL
         [ASM_SIMP_TAC [REAL_LT_LE, DROP_EQ] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN COND_CASES_TAC THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_VEC, DROP_ADD, DROP_SUB] THEN
        ONCE_REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_SUB_LT] THEN
        REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        (CONJ_TAC THENL
          [REPEAT (MATCH_MP_TAC REAL_LE_ADD THEN CONJ_TAC) THEN
           REPEAT (MATCH_MP_TAC REAL_LE_MUL THEN CONJ_TAC) THEN
           ASM_REAL_ARITH_TAC,
           ALL_TAC]) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"v - u + x * t <= w - u <=> x * t <= w - v"),
                    ← REAL_ARITH (← q r"(&2 * x) * t = x * &2 * t")] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a * t <= a * &1 /\ a <= b ==> a * t <= b")) THEN
        (CONJ_TAC THENL [MATCH_MP_TAC REAL_LE_LMUL, ALL_TAC]) THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, DROP_ADD, DROP_CMUL, DROP_SUB] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(v - u) + (w - v) * &1 = w - u")] THEN
        ASM_SIMP_TAC [REAL_SUB_0, DROP_EQ, REAL_MUL_LINV],
        X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
        REWRITE_TAC [subpath, joinpaths] THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_ASSOC] THEN
        ASM_SIMP_TAC [REAL_MUL_RINV, DROP_EQ_0, VECTOR_SUB_EQ] THEN
        AP_TERM_TAC THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, DROP_ADD, DROP_CMUL, DROP_SUB] THEN
        REAL_ARITH_TAC])
    let lemma2 ← prove
     r"path g /\ path_image g SUBSET s /\
       u IN interval[vec 0,vec 1] /\
       v IN interval[vec 0,vec 1] /\
       w IN interval[vec 0,vec 1] /\
       homotopic_paths s (subpath u v g ++ subpath v w g) (subpath u w g)
       ==> homotopic_paths s (subpath w v g ++ subpath v u g) (subpath w u g)"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← GSYM HOMOTOPIC_PATHS_REVERSEPATH] THEN
      SIMP_TAC [REVERSEPATH_JOINPATHS, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      ASM_REWRITE_TAC [REVERSEPATH_SUBPATH])
    let lemma3 ← prove
     r"path (g:real^1->real^N) /\ path_image g SUBSET s /\
       u IN interval[vec 0,vec 1] /\
       v IN interval[vec 0,vec 1] /\
       w IN interval[vec 0,vec 1] /\
       homotopic_paths s (subpath u v g ++ subpath v w g) (subpath u w g)
       ==> homotopic_paths s (subpath v w g ++ subpath w u g) (subpath v u g)"
     (← do
      let tac :=
        ASM_MESON_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH, PATH_SUBPATH,
                   HOMOTOPIC_PATHS_REFL, PATH_IMAGE_SUBPATH_SUBSET, SUBSET_TRANS,
                   PATHSTART_JOIN, PATHFINISH_JOIN]
      pure (
      REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← GSYM HOMOTOPIC_PATHS_REVERSEPATH] THEN
      SIMP_TAC [REVERSEPATH_JOINPATHS, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      ASM_REWRITE_TAC [REVERSEPATH_SUBPATH] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC
       (← q r"(subpath u v g ++ subpath v w g) ++ subpath w v g:real^1->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
        ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL] THEN tac,
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC
       (← q r"subpath u v g ++ (subpath v w g ++ subpath w v g):real^1->real^N") THEN
      CONJ_TAC THENL
       [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
        MATCH_MP_TAC HOMOTOPIC_PATHS_ASSOC THEN tac,
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC
       (← q r"(subpath u v g :real^1->real^N) ++
        linepath(pathfinish(subpath u v g),pathfinish(subpath u v g))") THEN
      CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC HOMOTOPIC_PATHS_RID THEN tac] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      REPEAT CONJ_TAC THENL [tac, ALL_TAC, tac] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC
       (← q r"linepath(pathstart(subpath v w g):real^N,pathstart(subpath v w g))") THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM REVERSEPATH_SUBPATH] THEN
        MATCH_MP_TAC HOMOTOPIC_PATHS_RINV THEN tac,
        ALL_TAC] THEN
      REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH, HOMOTOPIC_PATHS_REFL,
                  PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL,
                  INSERT_SUBSET, EMPTY_SUBSET] THEN
      ASM_MESON_TAC [path_image, IN_IMAGE, SUBSET]))
    pure (
    REPEAT STRIP_TAC THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
       (← REAL_ARITH (← q r"(drop u <= drop v /\ drop v <= drop w \/
                     drop w <= drop v /\ drop v <= drop u) \/
                    (drop u <= drop w /\ drop w <= drop v \/
                     drop v <= drop w /\ drop w <= drop u) \/
                    (drop v <= drop u /\ drop u <= drop w \/
                     drop w <= drop u /\ drop u <= drop v)")) THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"g:real^1->real^N", ← q r"s:real^N->bool"] o
      MATCH_MP lemma1) THEN
    ASM_MESON_TAC [lemma2, lemma3]))

  let HOMOTOPIC_LOOPS_SHIFTPATH ← prove
   r"!s:real^N->bool p q u.
        homotopic_loops s p q /\ u IN interval[vec 0,vec 1]
        ==> homotopic_loops s (shiftpath u p) (shiftpath u q)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopic_loops, HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN DISCH_THEN (
     (X_CHOOSE_THEN (← q r"h:real^(1,1)finite_sum->real^N") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC
     (← q r"\z. shiftpath u (\t. (h:real^(1,1)finite_sum->real^N)
                           (pastecart (fstcart z) t)) (sndcart z)") THEN
    ASM_REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ETA_AX] THEN
    ASM_SIMP_TAC [CLOSED_SHIFTPATH] THEN CONJ_TAC THENL
     [REWRITE_TAC [shiftpath, DROP_ADD, ← REAL_ARITH
       (← q r"u + z <= &1 <=> z <= &1 - u")] THEN
      SUBGOAL_THEN
       (← q r"{ pastecart (t:real^1) (x:real^1) |
          t IN interval[vec 0,vec 1] /\ x IN interval[vec 0,vec 1]} =
        { pastecart (t:real^1) (x:real^1) |
          t IN interval[vec 0,vec 1] /\ x IN interval[vec 0,vec 1 - u]} UNION
        { pastecart (t:real^1) (x:real^1) |
          t IN interval[vec 0,vec 1] /\ x IN interval[vec 1 - u,vec 1]}")
      SUBST1_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"s UNION s' = u
          ==> {f t x | t IN i /\ x IN u} =
              {f t x | t IN i /\ x IN s} UNION
              {f t x | t IN i /\ x IN s'}")) THEN
        UNDISCH_TAC (← q r"(u:real^1) IN interval[vec 0,vec 1]") THEN
        REWRITE_TAC [EXTENSION, IN_INTERVAL_1, IN_UNION, DROP_SUB, DROP_VEC] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
      SIMP_TAC [← REWRITE_RULE [PCROSS] CLOSED_PCROSS, CLOSED_INTERVAL] THEN
      REWRITE_TAC [FORALL_AND_THM, FORALL_IN_GSPEC, ← TAUT
       (← q r"p /\ q \/ r /\ s ==> t <=> (p ==> q ==> t) /\ (r ==> s ==> t)")] THEN
      SIMP_TAC [SNDCART_PASTECART, IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN
      SIMP_TAC [← REAL_ARITH (← q r"&1 - u <= x ==> (x <= &1 - u <=> x = &1 - u)")] THEN
      SIMP_TAC [← GSYM LIFT_EQ, LIFT_SUB, LIFT_DROP, LIFT_NUM] THEN
      REWRITE_TAC [FSTCART_PASTECART, ← VECTOR_ARITH (← q r"u + v - u:real^N = v"),
                  ← VECTOR_ARITH (← q r"u + v - u - v:real^N = vec 0")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
      ASM_SIMP_TAC [← GSYM IN_INTERVAL_1, ← GSYM DROP_VEC] THEN CONJ_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST,
               LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART,
               ← VECTOR_ARITH (← q r"u + z - v:real^N = (u - v) + z")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
      UNDISCH_TAC (← q r"(u:real^1) IN interval[vec 0,vec 1]") THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_INTERVAL_1,
                  IN_ELIM_PASTECART_THM, DROP_ADD, DROP_SUB, DROP_VEC] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, ← SET_RULE
       (← q r"(!t x. t IN i /\ x IN i ==> f t x IN s) <=>
        (!t. t IN i ==> IMAGE (f t) i SUBSET s)")] THEN
      X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN REWRITE_TAC [← GSYM path_image] THEN
      ASM_SIMP_TAC [PATH_IMAGE_SHIFTPATH, ETA_AX] THEN
      REWRITE_TAC [path_image] THEN ASM SET_TAC []])

  let HOMOTOPIC_PATHS_LOOP_PARTS ← prove
   r"!s p q a:real^N.
        homotopic_loops s (p ++ reversepath q) (linepath(a,a)) /\ path q
        ==> homotopic_paths s p q"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
      MATCH_MP HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL) THEN
    REWRITE_TAC [PATHSTART_JOIN] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    ASM_CASES_TAC (← q r"pathfinish p:real^N = pathstart(reversepath q)") THENL
     [ASM_SIMP_TAC [PATH_JOIN, PATH_REVERSEPATH] THEN STRIP_TAC,
      ASM_MESON_TAC [PATH_JOIN_PATH_ENDS, PATH_REVERSEPATH]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [PATHSTART_REVERSEPATH]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    ASM_SIMP_TAC [PATH_IMAGE_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN,
      PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, UNION_SUBSET, SING_SUBSET,
      PATH_IMAGE_REVERSEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
    EXISTS_TAC (← q r"p ++ (linepath(pathfinish p:real^N,pathfinish p))") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_RID THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
    EXISTS_TAC (← q r"p ++ (reversepath q ++ q):real^1->real^N") THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_SIMP_TAC [HOMOTOPIC_PATHS_LINV, PATHSTART_JOIN, PATHSTART_REVERSEPATH,
                   HOMOTOPIC_PATHS_REFL],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
    EXISTS_TAC (← q r"(p ++ reversepath q) ++ q:real^1->real^N") THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_ASSOC THEN
      ASM_REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                      PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
    EXISTS_TAC (← q r"linepath(pathstart p:real^N,pathstart p) ++ q") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
      ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL] THEN
      REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_REVERSEPATH],
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
      REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_LINEPATH,
                  PATHFINISH_REVERSEPATH] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_LID THEN ASM_REWRITE_TAC []])

  let HOMOTOPIC_LOOPS_ADD_SYM ← prove
   r"!p q:real^1->real^N.
        path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p /\
        path q /\ path_image q SUBSET s /\ pathfinish q = pathstart q /\
        pathstart q = pathstart p
        ==> homotopic_loops s (p ++ q) (q ++ p)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
    SUBGOAL_THEN (← q r"lift(&1 / &2) IN interval[vec 0,vec 1]") ASSUME_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    EXISTS_TAC (← q r"shiftpath (lift(&1 / &2)) (p ++ q:real^1->real^N)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOMOTOPIC_LOOPS_SHIFTPATH_SELF,
      MATCH_MP_TAC HOMOTOPIC_LOOPS_EQ] THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN,
                 UNION_SUBSET, IN_INTERVAL_1, DROP_VEC, LIFT_DROP,
                 PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH, CLOSED_SHIFTPATH] THEN
    SIMP_TAC [shiftpath, joinpaths, LIFT_DROP, DROP_ADD, DROP_SUB, DROP_VEC,
             ← REAL_ARITH (← q r"&0 <= t ==> (a + t <= a <=> t = &0)"),
             ← REAL_ARITH (← q r"t <= &1 ==> &1 / &2 + t - &1 <= &1 / &2"),
             ← REAL_ARITH (← q r"&1 / &2 + t <= &1 <=> t <= &1 / &2")] THEN
    X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"drop t <= &1 / &2") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM, LIFT_DROP] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_ADD_RID] THENL
       [REWRITE_TAC [← GSYM LIFT_CMUL, VECTOR_MUL_RZERO] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_MESON_TAC [LIFT_NUM, pathstart, pathfinish],
        ALL_TAC],
      ALL_TAC] THEN
    AP_TERM_TAC THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_SUB, DROP_ADD, DROP_VEC, DROP_CMUL,
                LIFT_DROP] THEN REAL_ARITH_TAC)

  return { HOMOTOPIC_JOIN_SUBPATHS, HOMOTOPIC_LOOPS_SHIFTPATH, HOMOTOPIC_PATHS_LOOP_PARTS,
           HOMOTOPIC_LOOPS_ADD_SYM }

/- ------------------------------------------------------------------------- -/
/- Simply connected sets defined as "all loops are homotopic (as loops)".    -/
/- (paths.ml 19139-19375)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVR where
  simply_connected : thm
  SIMPLY_CONNECTED_EMPTY : thm
  SIMPLY_CONNECTED_IMP_PATH_CONNECTED : thm
  SIMPLY_CONNECTED_IMP_CONNECTED : thm
  SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY : thm
  SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_SOME : thm
  SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ALL : thm
  SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH : thm
  SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS : thm
  SIMPLY_CONNECTED_RETRACTION_GEN : thm
  HOMEOMORPHIC_SIMPLY_CONNECTED : thm
  HOMEOMORPHIC_SIMPLY_CONNECTED_EQ : thm
  SIMPLY_CONNECTED_TRANSLATION : thm
  SIMPLY_CONNECTED_INJECTIVE_LINEAR_IMAGE : thm
  HOMEOMORPHISM_SIMPLE_CONNECTEDNESS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVR [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BI : PTI) (BK : PTK)
    (BL : PTL) (BVI : PVI) (BVJ : PVJ) (BVK : PVK) (BVM : PVM) (BVN : PVN) (BVO : PVO)
    (BVP : PVP) : ExceptT String IO PVR := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_TAC, add_linear_invariants,
        add_translation_invariants, .. } := D.cvx
  let { CONJ_ASSOC, .. } := D.cvx.core1
  let { IMP_CONJ, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.cvx.core3
  let { SING_SUBSET, SUBSET, SUBSET_EMPTY, SUBSET_REFL, .. } := D.cvx.core5
  let { UNION_SUBSET, .. } := D.cvx.core6
  let { HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, .. } := D.cvx.top4
  let { SEGMENT_REFL, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ, .. } := D.ptop3
  let { HOMEOMORPHIC_TRANSLATION, .. } := D.ptop4
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATH_IMAGE_NONEMPTY, PATHSTART_IN_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
        .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  let { PATH_CONNECTED_IFF_PATH_COMPONENT, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, .. } := BL
  let { HOMOTOPIC_PATHS_REFL, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS, .. } := BVI
  let { HOMOTOPIC_PATHS_JOIN, .. } := BVJ
  let { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_LID, HOMOTOPIC_PATHS_ASSOC, HOMOTOPIC_PATHS_RINV,
        HOMOTOPIC_PATHS_LINV, .. } := BVK
  let { homotopic_loops, HOMOTOPIC_LOOPS_SYM, HOMOTOPIC_LOOPS_TRANS, .. } := BVM
  let { HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS, HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL, .. } := BVN
  let { HOMOTOPIC_POINTS_EQ_PATH_COMPONENT, PATH_CONNECTED_EQ_HOMOTOPIC_POINTS, .. } := BVO
  let { HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN, .. } := BVP
  -- @@SCOPE END

  let simply_connected ← new_definition
   r"simply_connected(s:real^N->bool) <=>
        !p q. path p /\ pathfinish p = pathstart p /\ path_image p SUBSET s /\
              path q /\ pathfinish q = pathstart q /\ path_image q SUBSET s
              ==> homotopic_loops s p q"

  let SIMPLY_CONNECTED_EMPTY ← prove
   r"simply_connected {}"
   (REWRITE_TAC [simply_connected, SUBSET_EMPTY] THEN
    MESON_TAC [PATH_IMAGE_NONEMPTY])

  let SIMPLY_CONNECTED_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. simply_connected s ==> path_connected s"
   (REWRITE_TAC [simply_connected, PATH_CONNECTED_EQ_HOMOTOPIC_POINTS] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
                    PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
    ASM SET_TAC [])

  let SIMPLY_CONNECTED_IMP_CONNECTED ← prove
   r"!s:real^N->bool. simply_connected s ==> connected s"
   (SIMP_TAC [SIMPLY_CONNECTED_IMP_PATH_CONNECTED,
             PATH_CONNECTED_IMP_CONNECTED])

  let SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        !p a. path p /\ path_image p SUBSET s /\
              pathfinish p = pathstart p /\ a IN s
              ==> homotopic_loops s p (linepath(a,a))"
   (GEN_TAC THEN REWRITE_TAC [simply_connected] THEN EQ_TAC THEN DISCH_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET],
      MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^N", ← q r"q:real^1->real^N"] THEN
      STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"linepath(pathstart p:real^N,pathstart p)") THEN
      CONJ_TAC THENL [ALL_TAC, ONCE_REWRITE_TAC [HOMOTOPIC_LOOPS_SYM]] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET]])

  let SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_SOME ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        path_connected s /\
        !p. path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p
            ==> ?a. a IN s /\ homotopic_loops s p (linepath(a,a))"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_IMP_PATH_CONNECTED] THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY]) THEN
      MESON_TAC [SUBSET, PATHSTART_IN_PATH_IMAGE],
      REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^N", ← q r"a:real^N"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^1->real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
      STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"linepath(b:real^N,b)") THEN
      ASM_REWRITE_TAC [HOMOTOPIC_POINTS_EQ_PATH_COMPONENT] THEN
      ASM_MESON_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT]])

  let SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ALL ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        s = {} \/
        ?a. a IN s /\
            !p. path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p
                ==> homotopic_loops s p (linepath(a,a))"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SIMPLY_CONNECTED_EMPTY] THEN
    REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_SOME] THEN
    EQ_TAC THENL
     [STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"p:real^1->real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^1->real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
      STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"linepath(b:real^N,b)") THEN
      ASM_REWRITE_TAC [HOMOTOPIC_POINTS_EQ_PATH_COMPONENT] THEN
      ASM_MESON_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT],
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [PATH_CONNECTED_EQ_HOMOTOPIC_POINTS] THEN
      MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"c:real^N"] THEN STRIP_TAC THEN
      MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"linepath(a:real^N,a)") THEN
      GEN_REWRITE_TAC RAND_CONV [HOMOTOPIC_LOOPS_SYM] THEN
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL,
                  PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      ASM SET_TAC []])

  let SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        path_connected s /\
        !p. path p /\ path_image p SUBSET s /\ pathfinish p = pathstart p
            ==> homotopic_paths s p (linepath(pathstart p,pathstart p))"
   (GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [ASM_SIMP_TAC [SIMPLY_CONNECTED_IMP_PATH_CONNECTED] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL THEN
      EXISTS_TAC (← q r"pathstart p :real^N") THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o
        REWRITE_RULE [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY]) THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET],
      REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^N", ← q r"a:real^N"] THEN
      STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"linepath(pathstart p:real^N,pathfinish p)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS THEN
        ASM_SIMP_TAC [PATHFINISH_LINEPATH],
        ASM_REWRITE_TAC [HOMOTOPIC_POINTS_EQ_PATH_COMPONENT] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [PATH_CONNECTED_IFF_PATH_COMPONENT]) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET]]])

  let SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        path_connected s /\
        !p q. path p /\ path_image p SUBSET s /\
              path q /\ path_image q SUBSET s /\
              pathstart q = pathstart p /\ pathfinish q = pathfinish p
              ==> homotopic_paths s p q"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"p:real^1->real^N") THENL
     [X_GEN_TAC (← q r"q:real^1->real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p ++ reversepath q :real^1->real^N")) THEN
      ASM_SIMP_TAC [PATH_JOIN, PATHSTART_REVERSEPATH, PATH_REVERSEPATH,
                   PATHSTART_JOIN, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH,
                   PATH_IMAGE_JOIN, UNION_SUBSET, PATH_IMAGE_REVERSEPATH] THEN
      DISCH_TAC THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC (← q r"p ++ linepath(pathfinish p,pathfinish p):real^1->real^N") THEN
      GEN_REWRITE_TAC LAND_CONV [HOMOTOPIC_PATHS_SYM] THEN
      ASM_SIMP_TAC [HOMOTOPIC_PATHS_RID] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC (← q r"p ++ (reversepath q ++ q):real^1->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATHSTART_LINEPATH] THEN
        ASM_MESON_TAC [HOMOTOPIC_PATHS_LINV, HOMOTOPIC_PATHS_SYM],
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC (← q r"(p ++ reversepath q) ++ q:real^1->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_ASSOC THEN
        ASM_SIMP_TAC [PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH] THEN
        ASM_REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH],
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC (← q r"linepath(pathstart q,pathstart q) ++ q:real^1->real^N") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_SIMP_TAC [HOMOTOPIC_PATHS_RINV, HOMOTOPIC_PATHS_REFL] THEN
        ASM_REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_REVERSEPATH],
        ASM_MESON_TAC [HOMOTOPIC_PATHS_LID]],
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH] THEN
      REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET] THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET]])

  let SIMPLY_CONNECTED_RETRACTION_GEN ← prove
   r"!s:real^M->bool t:real^N->bool h k.
        h continuous_on s /\ IMAGE h s = t /\
        k continuous_on t /\ IMAGE k t SUBSET s /\
        (!y. y IN t ==> h(k y) = y) /\
        simply_connected s
        ==> simply_connected t"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [simply_connected, path, path_image, homotopic_loops] THEN
    ONCE_REWRITE_TAC [← TAUT
     (← q r"a /\ b /\ c /\ a' /\ b' /\ c' <=> a /\ c /\ b /\ a' /\ c' /\ b'")] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
      HOMOTOPICALLY_TRIVIAL_RETRACTION_GEN) THEN
    MAP_EVERY EXISTS_TAC [← q r"h:real^M->real^N", ← q r"k:real^N->real^M"] THEN
    ASM_SIMP_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
    REWRITE_TAC [pathfinish, pathstart] THEN MESON_TAC [ENDS_IN_UNIT_INTERVAL])

  let HOMEOMORPHIC_SIMPLY_CONNECTED ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t /\ simply_connected s
        ==> simply_connected t"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] SIMPLY_CONNECTED_RETRACTION_GEN)) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    SIMP_TAC [homeomorphism, SUBSET_REFL])

  let HOMEOMORPHIC_SIMPLY_CONNECTED_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t
        ==> (simply_connected s <=> simply_connected t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_SIMPLY_CONNECTED) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    ASM_REWRITE_TAC [])

  let SIMPLY_CONNECTED_TRANSLATION ← prove
   r"!a:real^N s. simply_connected (IMAGE (\x. a + x) s) <=> simply_connected s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_SIMPLY_CONNECTED_EQ THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION])

  add_translation_invariants [SIMPLY_CONNECTED_TRANSLATION]

  let SIMPLY_CONNECTED_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (simply_connected (IMAGE f s) <=> simply_connected s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_SIMPLY_CONNECTED_EQ THEN
    ASM_MESON_TAC [HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
                  HOMEOMORPHIC_REFL])

  add_linear_invariants [SIMPLY_CONNECTED_INJECTIVE_LINEAR_IMAGE]

  let HOMEOMORPHISM_SIMPLE_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (simply_connected(IMAGE f k) <=> simply_connected k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_SIMPLY_CONNECTED_EQ THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  return { simply_connected, SIMPLY_CONNECTED_EMPTY, SIMPLY_CONNECTED_IMP_PATH_CONNECTED,
           SIMPLY_CONNECTED_IMP_CONNECTED, SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY,
           SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_SOME, SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ALL,
           SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH, SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS,
           SIMPLY_CONNECTED_RETRACTION_GEN, HOMEOMORPHIC_SIMPLY_CONNECTED,
           HOMEOMORPHIC_SIMPLY_CONNECTED_EQ, SIMPLY_CONNECTED_TRANSLATION,
           SIMPLY_CONNECTED_INJECTIVE_LINEAR_IMAGE, HOMEOMORPHISM_SIMPLE_CONNECTEDNESS }

/- ------------------------------------------------------------------------- -/
/- Simple connectedness of products and nested unions.  (paths.ml 19376-19507) -/
/- ------------------------------------------------------------------------- -/

structure PVS where
  SIMPLY_CONNECTED_PCROSS : thm
  SIMPLY_CONNECTED_PCROSS_EQ : thm
  SIMPLY_CONNECTED_NESTED_UNIONS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVS [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BI : PTI) (BVE : PVE)
    (BVM : PVM) (BVR : PVR) : ExceptT String IO PVS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FORALL_IN_PCROSS, FORALL_PASTECART,
        FSTCART_PASTECART, IMAGE_o, INTERS_IMAGE, .. } := D.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IMP,
        PASTECART_INJ, PASTECART_IN_PCROSS, PCROSS, PCROSS_EMPTY, .. } := D.cvx.core3
  let { SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { COMPACT_CHAIN, .. } := D.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, .. } := D.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { PASTECART_FST_SND, .. } := D.pses2
  let { COMPACT_DIFF, COMPACT_UNION, .. } := D.ptop1
  let { CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATH_IMAGE_NONEMPTY, COMPACT_PATH_IMAGE, .. } := BB
  let { LINEPATH_REFL, .. } := BI
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { homotopic_loops, HOMOTOPIC_LOOPS_SUBSET, HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE, .. } := BVM
  let { simply_connected, SIMPLY_CONNECTED_EMPTY, SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY,
        .. } := BVR
  -- @@SCOPE END

  let SIMPLY_CONNECTED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        simply_connected s /\ simply_connected t
        ==> simply_connected(s PCROSS t)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY] THEN
    REWRITE_TAC [path, path_image, pathstart, pathfinish, FORALL_PASTECART] THEN
    DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC
     [← q r"p:real^1->real^(M,N)finite_sum", ← q r"a:real^M", ← q r"b:real^N"] THEN
    REWRITE_TAC [PASTECART_IN_PCROSS, FORALL_IN_IMAGE, SUBSET] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPECL [← q r"fstcart o (p:real^1->real^(M,N)finite_sum)", ← q r"a:real^M"])
     (MP_TAC o SPECL [← q r"sndcart o (p:real^1->real^(M,N)finite_sum)",
                      ← q r"b:real^N"])) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, LINEAR_FSTCART, LINEAR_SNDCART,
                 LINEAR_CONTINUOUS_ON, homotopic_loops, HOMOTOPIC_WITH_EUCLIDEAN,
                 pathfinish, pathstart, IMAGE_o, o_THM] THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [PCROSS, IN_ELIM_THM]) THEN
      ASM_MESON_TAC [SNDCART_PASTECART],
      DISCH_THEN (X_CHOOSE_THEN
        (← q r"k:real^(1,1)finite_sum->real^N") STRIP_ASSUME_TAC)] THEN
    ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [PCROSS, IN_ELIM_THM]) THEN
      ASM_MESON_TAC [FSTCART_PASTECART],
      DISCH_THEN (X_CHOOSE_THEN
        (← q r"h:real^(1,1)finite_sum->real^M") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC
     (← q r"(\z. pastecart (h z) (k z))
      :real^(1,1)finite_sum->real^(M,N)finite_sum") THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_PASTECART, ETA_AX] THEN
    REWRITE_TAC [LINEPATH_REFL, PASTECART_FST_SND] THEN
    ASM_SIMP_TAC [PASTECART_IN_PCROSS])

  let SIMPLY_CONNECTED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        simply_connected(s PCROSS t) <=>
        s = {} \/ t = {} \/ simply_connected s /\ simply_connected t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, SIMPLY_CONNECTED_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, SIMPLY_CONNECTED_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [SIMPLY_CONNECTED_PCROSS] THEN REPEAT STRIP_TAC THENL
     [REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^M", ← q r"a:real^M"] THEN
      REWRITE_TAC [path, path_image, pathstart, pathfinish, SUBSET,
                  FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN UNDISCH_TAC (← q r"~(t:real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"(\t. pastecart (p t) (b)):real^1->real^(M,N)finite_sum",
        ← q r"pastecart (a:real^M) (b:real^N)"]) THEN
      ASM_REWRITE_TAC [PASTECART_IN_PCROSS] THEN
      ASM_SIMP_TAC [path, path_image, pathstart, pathfinish, SUBSET,
                   FORALL_IN_IMAGE, PASTECART_IN_PCROSS, PASTECART_INJ,
                   CONTINUOUS_ON_PASTECART, ETA_AX, CONTINUOUS_ON_CONST] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(\t. pastecart (p t) b):real^1->real^(M,N)finite_sum",
        ← q r"linepath (pastecart (a:real^M) (b:real^N),pastecart a b)",
        ← q r"fstcart:real^(M,N)finite_sum->real^M",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)", ← q r"s:real^M->bool"]
          HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE) THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
      SIMP_TAC [o_DEF, LINEPATH_REFL, FSTCART_PASTECART, ETA_AX,
               SUBSET, FORALL_IN_PCROSS, FORALL_IN_IMAGE],
      REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^N", ← q r"b:real^N"] THEN
      REWRITE_TAC [path, path_image, pathstart, pathfinish, SUBSET,
                  FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN UNDISCH_TAC (← q r"~(s:real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^M") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ANY]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"(\t. pastecart a (p t)):real^1->real^(M,N)finite_sum",
        ← q r"pastecart (a:real^M) (b:real^N)"]) THEN
      ASM_REWRITE_TAC [PASTECART_IN_PCROSS] THEN
      ASM_SIMP_TAC [path, path_image, pathstart, pathfinish, SUBSET,
                   FORALL_IN_IMAGE, PASTECART_IN_PCROSS, PASTECART_INJ,
                   CONTINUOUS_ON_PASTECART, ETA_AX, CONTINUOUS_ON_CONST] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(\t. pastecart a (p t)):real^1->real^(M,N)finite_sum",
        ← q r"linepath (pastecart (a:real^M) (b:real^N),pastecart a b)",
        ← q r"sndcart:real^(M,N)finite_sum->real^N",
        ← q r"(s:real^M->bool) PCROSS (t:real^N->bool)", ← q r"t:real^N->bool"]
          HOMOTOPIC_LOOPS_CONTINUOUS_IMAGE) THEN
      ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      SIMP_TAC [o_DEF, LINEPATH_REFL, SNDCART_PASTECART, ETA_AX,
               SUBSET, FORALL_IN_PCROSS, FORALL_IN_IMAGE]])

  let SIMPLY_CONNECTED_NESTED_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        (!s. s IN f ==> open s /\ simply_connected s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> simply_connected(UNIONS f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [simply_connected] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:real^1->real^N", ← q r"q:real^1->real^N"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPEC
     (← q r"IMAGE (\u:real^N->bool. (path_image p UNION path_image q) DIFF u) f")
     COMPACT_CHAIN) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_IMAGE_2] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ r /\ (~p ==> s) ==> (p /\ q ==> ~r) ==> s")) THEN
    REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      MP_TAC (← ISPEC (← q r"p:real^1->real^N") PATH_IMAGE_NONEMPTY) THEN
      REWRITE_TAC [INTERS_IMAGE] THEN ASM SET_TAC [],
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:real^N->bool"))) THEN
    ASM_REWRITE_TAC [] THEN REPLICATE_TAC 2 STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      let _ ← liftExcept (check HolCore.Basics.is_forall (concl th))
      pure ALL_TAC) THEN
    ASM_SIMP_TAC [COMPACT_DIFF, COMPACT_UNION, COMPACT_PATH_IMAGE] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"(s UNION t) DIFF u = {} <=> s SUBSET u /\ t SUBSET u")] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_LOOPS_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [simply_connected]) THEN
    ASM_REWRITE_TAC [])

  return { SIMPLY_CONNECTED_PCROSS, SIMPLY_CONNECTED_PCROSS_EQ, SIMPLY_CONNECTED_NESTED_UNIONS }

/- ------------------------------------------------------------------------- -/
/- The (carrier of) the fundamental group: homotopy classes of loops at a.   -/
/- (paths.ml 19508-19622)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVT where
  fundamental_group : thm
  FUNDAMENTAL_GROUP_EQ_EMPTY : thm
  CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS : thm
  SIMPLY_CONNECTED_FUNDAMENTAL_GROUP : thm
  FUNDAMENTAL_GROUP_SIMPLY_CONNECTED : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVT [HolBase] (D : PathsDeps) (BB : PTB) (BC : PTC) (BI : PTI) (BK : PTK)
    (BVI : PVI) (BVL : PVL) (BVR : PVR) : ExceptT String IO PVT := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, SELECT_CONV, .. } :=
    D.cvx
  let { CONJ_ASSOC, EQ_SYM_EQ, ETA_AX, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.cvx.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, .. } := D.cvx.core5
  let { SWAP_FORALL_THM, le_c, .. } := D.cvx.core6
  let { SEGMENT_REFL, .. } := D.cvx.top5
  let { FORALL_UNWIND_THM1, .. } := D.pses1
  let { CARD_LE_ANTISYM, .. } := D.pcard
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  let { path_connected, .. } := BK
  let { HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_IMP_PATH,
        HOMOTOPIC_PATHS_IMP_SUBSET, HOMOTOPIC_PATHS_REFL, HOMOTOPIC_PATHS_SYM,
        HOMOTOPIC_PATHS_TRANS, .. } := BVI
  let { HOMOTOPIC_PATHS_LCANCEL, HOMOTOPIC_PATHS_RCANCEL, .. } := BVL
  let { SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH, .. } := BVR
  -- @@SCOPE END

  let fundamental_group ← new_definition
   r"fundamental_group(s,a:real^N) =
    { homotopic_paths s p | p |  path p /\ path_image p SUBSET s /\
                                 pathstart p = a /\ pathfinish p = a}"

  let FUNDAMENTAL_GROUP_EQ_EMPTY ← prove
   r"!s a:real^N. fundamental_group (s,a) = {} <=> ~(a IN s)"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"s = {} <=> !x. x IN s ==> F")] THEN
    PURE_REWRITE_TAC [fundamental_group, FORALL_IN_GSPEC] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [SUBSET, PATHSTART_IN_PATH_IMAGE]] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"linepath(a:real^N,a)")) THEN
    REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
    SET_TAC [])

  let CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS ← prove
   r"!s a b:real^N.
        path_connected s /\ a IN s /\ b IN s
        ==> fundamental_group(s,a) =_c fundamental_group(s,b)"
   (← do
    let lemma ← prove
     r"!g:real^1->real^N.
        path g /\ path_image g SUBSET s
        ==> homotopic_paths s g ((@) (homotopic_paths s g)) /\
            path ((@) (homotopic_paths s g)) /\
            path_image ((@) (homotopic_paths s g)) SUBSET s /\
            pathstart ((@) (homotopic_paths s g)) = pathstart g /\
            pathfinish ((@) (homotopic_paths s g)) = pathfinish g"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
        CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
        ASM MESON_TAC [HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
                  HOMOTOPIC_PATHS_IMP_PATHSTART,
                  HOMOTOPIC_PATHS_IMP_PATHFINISH]])
    let tac :=
      ASM_SIMP_TAC [HOMOTOPIC_PATHS_REFL, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_REVERSEPATH, SUBSET_PATH_IMAGE_JOIN, PATHSTART_REVERSEPATH,
        PATHFINISH_REVERSEPATH, PATH_IMAGE_REVERSEPATH, PATH_JOIN]
    pure (
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM, FORALL_AND_THM, ← TAUT
     (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> b) /\ a ==> a /\ b")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [le_c] THEN
    SUBGOAL_THEN
     (← q r"?f:real^1->real^N.
          path f /\ path_image f SUBSET s /\
          pathstart f = a /\ pathfinish f = b")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [path_connected], ALL_TAC] THEN
    REWRITE_TAC [fundamental_group, FORALL_IN_GSPEC,
                IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    EXISTS_TAC
      (← q r"\g. homotopic_paths (s:real^N->bool) (reversepath f ++ (@) g ++ f)") THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN REPEAT DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"g:real^1->real^N") lemma) THEN ASM_REWRITE_TAC [] THEN
    ABBREV_TAC (← q r"g':real^1->real^N = (@) (homotopic_paths s g)") THEN
    STRIP_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"P q ==> homotopic_paths s q IN {homotopic_paths s p | P p}")) THEN
      tac,
      X_GEN_TAC (← q r"h:real^1->real^N") THEN
      REPLICATE_TAC 4 DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"h:real^1->real^N") lemma) THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"h':real^1->real^N = (@) (homotopic_paths s h)") THEN
      STRIP_TAC THEN
      DISCH_THEN (MP_TAC o C AP_THM (← q r"reversepath f ++ h' ++ f:real^1->real^N")) THEN
      tac THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_PATHS_LCANCEL)) THEN tac THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_PATHS_RCANCEL)) THEN tac THEN
      REWRITE_TAC [FUN_EQ_THM] THEN
      ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]]))

  let SIMPLY_CONNECTED_FUNDAMENTAL_GROUP ← prove
   r"!s:real^N->bool.
        simply_connected s <=>
        path_connected s /\
        !a. a IN s
            ==> fundamental_group(s,a) = {homotopic_paths s (linepath(a,a))}"
   (GEN_TAC THEN REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH] THEN
    ASM_CASES_TAC (← q r"path_connected(s:real^N->bool)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← SET_RULE (← q r"s = {a} <=> a IN s /\ !x. x IN s ==> x = a")] THEN
    REWRITE_TAC [fundamental_group, FORALL_IN_GSPEC] THEN
    SIMP_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
      PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET,
      ← SET_RULE (← q r"P q ==> homotopic_paths s q IN {homotopic_paths s p | P p}")] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s /\ t <=> t /\ q /\ p /\ r /\ s")] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_UNWIND_THM1] THEN
    REWRITE_TAC [← MESON [PATHFINISH_IN_PATH_IMAGE, SUBSET]
     (← q r"pathfinish p IN s ==> path_image p SUBSET s ==> P <=>
      path_image p SUBSET s ==> P")] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    REWRITE_TAC [← ISPEC (← q r"pathfinish p:real^N") EQ_SYM_EQ] THEN
    X_GEN_TAC (← q r"p:real^1->real^N") THEN REPEAT
      (MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> ((p ==> q) <=> (p ==> r))")) THEN
       DISCH_TAC) THEN
    REPEAT (EQ_TAC ORELSE STRIP_TAC) THEN
    ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL, PATH_LINEPATH] THEN
    REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET] THEN
    ASM_MESON_TAC [HOMOTOPIC_PATHS_TRANS, HOMOTOPIC_PATHS_SYM,
                  PATHFINISH_IN_PATH_IMAGE, SUBSET])

  let FUNDAMENTAL_GROUP_SIMPLY_CONNECTED ← prove
   r"!s a:real^N.
     simply_connected s /\ a IN s
     ==> fundamental_group(s,a) = {homotopic_paths s (linepath(a,a))}"
   (SIMP_TAC [SIMPLY_CONNECTED_FUNDAMENTAL_GROUP])

  return { fundamental_group, FUNDAMENTAL_GROUP_EQ_EMPTY, CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS,
           SIMPLY_CONNECTED_FUNDAMENTAL_GROUP, FUNDAMENTAL_GROUP_SIMPLY_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- A mapping out of a sphere is nullhomotopic iff it extends to the ball.    -/
/- This even works out in the degenerate cases when the radius is <= 0, and  -/
/- we also don't need to explicitly assume continuity since it's already     -/
/- implicit in both sides of the equivalence.  (paths.ml 19623-19851)        -/
/- ------------------------------------------------------------------------- -/

structure PVU where
  NULLHOMOTOPIC_FROM_SPHERE_EXTENSION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVU [HolBase] (D : PathsDeps) (BVE : PVE) : ExceptT String IO PVU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, DIMINDEX_GE_1, EMPTY_GSPEC, EMPTY_SUBSET, ETA_AX, EXISTS_IN_GSPEC,
        FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM2, FSTCART_PASTECART, IMAGE_CLAUSES, IMAGE_o,
        IMP_CONJ, IMP_IMP, IN_DELETE, IN_ELIM_PASTECART_THM, .. } := D.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        PCROSS, REAL_ABS_DIV, REAL_ADD_RID, REAL_DIV_REFL, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL_EQ, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_MIN, REAL_LT_MUL, .. } := D.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SNDCART_PASTECART, SUBSET, .. } :=
    D.cvx.core5
  let { UNWIND_THM2, o_DEF, real_div, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_SYM, .. } := D.cvx.vec1
  let { DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_NUM, LINEAR_FSTCART, LINEAR_SNDCART, NORM_0,
        NORM_BASIS, NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, REAL_ABS_NORM, .. } :=
    D.cvx.vec3
  let { VECTOR_ADD_RID, VECTOR_ADD_SUB, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_ADD2,
        VECTOR_SUB_EQ, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, dist, .. } := D.cvx.vec4
  let { CBALL_EQ_EMPTY, CBALL_SING, .. } := D.cvx.top1
  let { COMPACT_INTERVAL, COMPACT_PCROSS, COMPACT_SPHERE, CONTINUOUS_AT_ID, .. } := D.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, CONTINUOUS_SUB, .. } := D.cvx.top3
  let { IN_CBALL, IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { continuous_on, continuous_within, .. } := D.cvx.top5
  let { POW_2_SQRT_ABS, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, NORM_PASTECART, PASTECART_SUB, .. } := D.pvec
  let { HOMOTOPIC_WITH_SYM, .. } := D.pmet2
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.ptop1
  let { CONTINUOUS_AT_WITHIN, CONTINUOUS_INV, CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_SING,
        CONTINUOUS_TRANSFORM_WITHIN, .. } := D.ptop3
  let { NETLIMIT_AT, sphere, uniformly_continuous_on, .. } := D.ptop5
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_CONTINUOUS,
        HOMOTOPIC_WITH_IMP_SUBSET, .. } := BVE
  -- @@SCOPE END

  let NULLHOMOTOPIC_FROM_SPHERE_EXTENSION ← prove
   r"!f:real^M->real^N s a r.
        (?c. homotopic_with (\x. T)
              (subtopology euclidean (sphere(a,r)),
               subtopology euclidean s) f (\x. c)) <=>
        (?g. g continuous_on cball(a,r) /\ IMAGE g (cball(a,r)) SUBSET s /\
             !x. x IN sphere(a,r) ==> g x = f x)"
   (← do
    let lemma ← prove
     r"!f:real^M->real^N g a r.
        (!e. &0 < e
             ==> ?d. &0 < d /\
                     !x. ~(x = a) /\ norm(x - a) < d ==> norm(g x - f a) < e) /\
        g continuous_on (cball(a,r) DELETE a) /\
        (!x. x IN cball(a,r) /\ ~(x = a) ==> f x = g x)
        ==> f continuous_on cball(a,r)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"x:real^M") THEN REWRITE_TAC [IN_CBALL, dist] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"x:real^M = a") THENL
       [ASM_REWRITE_TAC [continuous_within, IN_CBALL, dist] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_CBALL, dist]) THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        GEN_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"y:real^M") THEN ASM_CASES_TAC (← q r"y:real^M = a") THEN
        ASM_MESON_TAC [VECTOR_SUB_REFL, NORM_0],
        MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN THEN
        EXISTS_TAC (← q r"g:real^M->real^N") THEN EXISTS_TAC (← q r"norm(x - a:real^M)") THEN
        ASM_SIMP_TAC [NORM_POS_LT, VECTOR_SUB_EQ, IN_CBALL, dist] THEN
        CONJ_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_CBALL, dist]),
          UNDISCH_TAC
           (← q r"(g:real^M->real^N) continuous_on (cball(a,r) DELETE a)") THEN
          REWRITE_TAC [continuous_on, continuous_within] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN
          ASM_REWRITE_TAC [IN_DELETE, IN_CBALL, dist] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
          ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"min d (norm(x - a:real^M))") THEN
          ASM_REWRITE_TAC [REAL_LT_MIN, NORM_POS_LT, VECTOR_SUB_EQ]] THEN
         ASM_MESON_TAC [NORM_SUB, ← NORM_ARITH
          (← q r"norm(y - x:real^N) < norm(x - a) ==> ~(y = a)")]])
    pure (
    REWRITE_TAC [sphere, ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
    REPEAT GEN_TAC THEN REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← REAL_ARITH (← q r"r < &0 \/ r = &0 \/ &0 < r"))
    THENL
     [ASM_SIMP_TAC [← NORM_ARITH (← q r"r < &0 ==> ~(norm x = r)")] THEN
      FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE id [← GSYM CBALL_EQ_EMPTY]) THEN
      ASM_SIMP_TAC [HOMOTOPIC_WITH_EUCLIDEAN_ALT, IMAGE_CLAUSES, EMPTY_GSPEC,
       NOT_IN_EMPTY, PCROSS, ← SET_RULE (← q r"{f t x |x,t| F} = {}"), EMPTY_SUBSET] THEN
      REWRITE_TAC [CONTINUOUS_ON_EMPTY],
      ASM_SIMP_TAC [NORM_EQ_0, VECTOR_SUB_EQ, CBALL_SING] THEN
      SIMP_TAC [HOMOTOPIC_WITH_EUCLIDEAN_ALT, PCROSS,
               FORALL_IN_GSPEC, FORALL_UNWIND_THM2] THEN
      ASM_CASES_TAC (← q r"(f:real^M->real^N) a IN s") THENL
       [MATCH_MP_TAC (← TAUT (← q r"p /\ q ==> (p <=> q)")) THEN CONJ_TAC THENL
         [EXISTS_TAC (← q r"(f:real^M->real^N) a") THEN
          EXISTS_TAC (← q r"\y:real^(1,M)finite_sum. (f:real^M->real^N) a") THEN
          ASM_REWRITE_TAC [CONTINUOUS_ON_CONST, SUBSET, FORALL_IN_IMAGE],
          EXISTS_TAC (← q r"f:real^M->real^N") THEN REWRITE_TAC [CONTINUOUS_ON_SING] THEN
          ASM SET_TAC []],
        MATCH_MP_TAC (← TAUT (← q r"~q /\ ~p ==> (p <=> q)")) THEN CONJ_TAC THENL
         [ASM SET_TAC [], STRIP_TAC] THEN
        UNDISCH_TAC (← q r"~((f:real^M->real^N) a IN s)") THEN REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE h t SUBSET s ==> (?y. y IN t /\ z = h y) ==> z IN s"))) THEN
        REWRITE_TAC [EXISTS_IN_GSPEC] THEN
        EXISTS_TAC (← q r"vec 0:real^1") THEN ASM_SIMP_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        ASM_REWRITE_TAC [EXISTS_IN_GSPEC, UNWIND_THM2]],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"!p. (q ==> p) /\ (r ==> p) /\ (p ==> (q <=> r)) ==> (q <=> r)")) THEN
    EXISTS_TAC
     (← q r"(f:real^M->real^N) continuous_on {x | norm(x - a) = r} /\
      IMAGE f {x | norm(x - a) = r} SUBSET s") THEN
    REPEAT CONJ_TAC THENL
     [STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS) THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_EQ THEN EXISTS_TAC (← q r"g:real^M->real^N") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"cball(a:real^M,r)"),
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
          (← q r"IMAGE g t SUBSET s
           ==> u SUBSET t /\ (!x. x IN u ==> f x = g x)
               ==> IMAGE f u SUBSET s"))) THEN
        ASM_SIMP_TAC []] THEN
      ASM_SIMP_TAC [SUBSET, IN_CBALL, dist, IN_ELIM_THM] THEN
      MESON_TAC [REAL_LE_REFL, NORM_SUB],
      STRIP_TAC] THEN
    ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN EQ_TAC THENL
     [REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:real^N", ← q r"h:real^(1,M)finite_sum->real^N"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x. (h:real^(1,M)finite_sum->real^N)
                      (pastecart (lift(inv(r) * norm(x - a)))
                                 (a + (if x = a then r % basis 1
                                       else r / norm(x - a) % (x - a))))") THEN
      ASM_SIMP_TAC [IN_ELIM_THM, REAL_MUL_LINV, REAL_DIV_REFL, REAL_LT_IMP_NZ,
                   LIFT_NUM, ← VECTOR_ARITH (← q r"a + &1 % (x - a):real^N = x")] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC lemma THEN
        EXISTS_TAC (← q r"\x. (h:real^(1,M)finite_sum->real^N)
                      (pastecart (lift(inv(r) * norm(x - a)))
                                 (a + r / norm(x - a) % (x - a)))") THEN
        SIMP_TAC [] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
          ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO, LIFT_NUM] THEN
          FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COMPACT_UNIFORMLY_CONTINUOUS)) THEN
          SIMP_TAC [← REWRITE_RULE [PCROSS] COMPACT_PCROSS,
              ← REWRITE_RULE [← REWRITE_RULE [← ONCE_REWRITE_RULE [DIST_SYM] dist] sphere]
                   COMPACT_SPHERE, COMPACT_INTERVAL] THEN
          REWRITE_TAC [uniformly_continuous_on] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"min r (d * r):real") THEN
          ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_MIN] THEN
          X_GEN_TAC (← q r"x:real^M") THEN REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
          REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, RIGHT_IMP_FORALL_THM] THEN
          ASM_REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
          DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
           (← q r"(!x t y. P x t y) ==> (!t x. P x t x)"))) THEN
          REWRITE_TAC [dist] THEN DISCH_THEN MATCH_MP_TAC THEN
          REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
          REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
          ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
          ASM_SIMP_TAC [REAL_MUL_LID, REAL_MUL_LZERO, NORM_POS_LE] THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE, CONJ_ASSOC] THEN
          REWRITE_TAC [VECTOR_ADD_SUB, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
          ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < r ==> abs r = r")] THEN
          REWRITE_TAC [PASTECART_SUB, VECTOR_SUB_REFL, NORM_PASTECART] THEN
          REWRITE_TAC [NORM_0, VECTOR_SUB_RZERO] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [REAL_ADD_RID] THEN
          REWRITE_TAC [POW_2_SQRT_ABS, REAL_ABS_NORM, NORM_LIFT] THEN
          ASM_SIMP_TAC [REAL_ABS_DIV, REAL_LT_LDIV_EQ, REAL_ABS_NORM,
                       ← REAL_ARITH (← q r"&0 < r ==> abs r = r")],
          GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
           [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
            SIMP_TAC [CONTINUOUS_ON_CMUL, LIFT_CMUL, CONTINUOUS_ON_SUB,
                     CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST,
                     CONTINUOUS_ON_LIFT_NORM_COMPOSE] THEN
            MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
            REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
            MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
            SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST,
                     o_DEF, real_div, LIFT_CMUL] THEN
            MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
            REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
            GEN_TAC THEN REWRITE_TAC [IN_DELETE] THEN DISCH_TAC THEN
            MATCH_MP_TAC CONTINUOUS_AT_WITHIN THEN
            MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_INV) THEN
            ASM_SIMP_TAC [NETLIMIT_AT, NORM_EQ_0, VECTOR_SUB_EQ] THEN
            MATCH_MP_TAC CONTINUOUS_LIFT_NORM_COMPOSE THEN
            SIMP_TAC [CONTINUOUS_SUB, CONTINUOUS_AT_ID, CONTINUOUS_CONST],
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
            REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_GSPEC, SUBSET] THEN
            REWRITE_TAC [IN_ELIM_PASTECART_THM, IN_DELETE, IN_ELIM_THM] THEN
            SIMP_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(a:real^M,a + x) = norm x")] THEN
            REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
            REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
            REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
            ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
            ASM_SIMP_TAC [REAL_MUL_LID, REAL_MUL_LZERO, NORM_POS_LE] THEN
            SIMP_TAC [VECTOR_ADD_SUB, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM,
                     REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
            ASM_REAL_ARITH_TAC]],
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE g s SUBSET u ==> t SUBSET s ==> IMAGE g t SUBSET u"))) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [IN_ELIM_PASTECART_THM, IN_CBALL, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^M") THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN REPEAT STRIP_TAC THENL
         [REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
          REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
          ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
          ASM_REWRITE_TAC [REAL_MUL_LID, REAL_MUL_LZERO, NORM_POS_LE],
          REWRITE_TAC [VECTOR_ADD_SUB] THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL,
                       REAL_ABS_DIV, REAL_ABS_NORM,
                       REAL_MUL_RID, ← REAL_ARITH (← q r"&0 < r ==> abs r = r")] THEN
          ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ]],
        GEN_TAC THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [VECTOR_SUB_REFL, NORM_0, REAL_LT_IMP_NZ] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + &1 % (x - a):real^N = x")]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^M->real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(g:real^M->real^N) a") THEN
      ASM_SIMP_TAC [HOMOTOPIC_WITH_EUCLIDEAN_ALT, PCROSS] THEN
      EXISTS_TAC (← q r"\y:real^(1,M)finite_sum.
                     (g:real^M->real^N)
                     (a + drop(fstcart y) % (sndcart y - a))") THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC] THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_RID, VECTOR_MUL_LID] THEN
      ASM_SIMP_TAC [VECTOR_SUB_ADD2] THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN SIMP_TAC [CONTINUOUS_ON_CONST] THEN
          MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          SIMP_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                   LINEAR_CONTINUOUS_ON, LINEAR_SNDCART, LINEAR_FSTCART, ETA_AX],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET))],
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE g s SUBSET u ==> t SUBSET s ==> IMAGE g t SUBSET u")))] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(a:real^M,a + x) = norm x")] THEN
      ASM_SIMP_TAC [NORM_MUL, IN_INTERVAL_1, DROP_VEC, REAL_LE_RMUL_EQ,
                   ← REAL_ARITH (← q r"x * r <= r <=> x * r <= &1 * r")] THEN
      REAL_ARITH_TAC]))

  return { NULLHOMOTOPIC_FROM_SPHERE_EXTENSION }

/- ------------------------------------------------------------------------- -/
/- Homotopy equivalence.  (paths.ml 19852-20024)                             -/
/- ------------------------------------------------------------------------- -/

structure PVV where
  homotopy_equivalent : thm
  HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN : thm
  HOMOTOPY_EQUIVALENT : thm
  HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT : thm
  HOMOTOPY_EQUIVALENT_REFL : thm
  HOMOTOPY_EQUIVALENT_SYM : thm
  HOMOTOPY_EQUIVALENT_TRANS : thm
  HOMOTOPY_EQUIVALENT_PCROSS : thm
  HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_SELF : thm
  HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_LEFT_EQ : thm
  HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ : thm
  HOMOTOPY_EQUIVALENT_TRANSLATION_SELF : thm
  HOMOTOPY_EQUIVALENT_TRANSLATION_LEFT_EQ : thm
  HOMOTOPY_EQUIVALENT_TRANSLATION_RIGHT_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVV [HolBase] (D : PathsDeps) (BVE : PVE) (BVF : PVF) : ExceptT String IO PVV := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, MESON, MESON_TAC, SET_TAC, add_linear_invariants,
        add_translation_invariants, .. } := D.cvx
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FSTCART_PASTECART, IMAGE_o, IMP_CONJ, IMP_IMP, .. } :=
    D.cvx.core2
  let { LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, PASTECART_IN_PCROSS, .. } := D.cvx.core3
  let { RIGHT_AND_EXISTS_THM, SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_ASSOC, o_DEF, .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS, I_DEF, I_O_ID, .. } := D.pses1
  let { PASTECART_FST_SND, .. } := D.pses2
  let { HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE, .. } := D.pmet1
  let { HOMOTOPIC_WITH_TRANS, HOMOTOPY_EQUIVALENT_SPACE_SYM, HOMOTOPY_EQUIVALENT_SPACE_TRANS,
        homotopy_equivalent_space, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := D.ptop2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF,
        .. } := D.ptop3
  let { HOMEOMORPHIC_SPACE_EUCLIDEAN, HOMEOMORPHIC_TRANSLATION_SELF, .. } := D.ptop4
  let { HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, .. } :=
    BVE
  let { HOMOTOPIC_WITH_PCROSS, .. } := BVF
  -- @@SCOPE END

  parse_as_infix ("homotopy_equivalent", (12, "right"))

  let homotopy_equivalent ← new_definition
   r"(s:real^M->bool) homotopy_equivalent (t:real^N->bool) <=>
        ?f g. f continuous_on s /\ IMAGE f s SUBSET t /\
              g continuous_on t /\ IMAGE g t SUBSET s /\
              homotopic_with (\x. T)
               (subtopology euclidean s,subtopology euclidean s) (g o f) I /\
              homotopic_with (\x. T)
               (subtopology euclidean t,subtopology euclidean t) (f o g) I"

  let HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN ← prove
   r"!(s:real^M->bool) (t:real^N->bool).
     (subtopology euclidean s) homotopy_equivalent_space
     (subtopology euclidean t) <=>
     s homotopy_equivalent t"
   (REWRITE_TAC [homotopy_equivalent_space, homotopy_equivalent] THEN
    REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2] THEN MESON_TAC [])

  let HOMOTOPY_EQUIVALENT ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t <=>
        ?f g h. f continuous_on s /\ IMAGE f s SUBSET t /\
                g continuous_on t /\ IMAGE g t SUBSET s /\
                h continuous_on t /\ IMAGE h t SUBSET s /\
                homotopic_with (\x. T)
                 (subtopology euclidean s,subtopology euclidean s) (g o f) I /\
                homotopic_with (\x. T)
                 (subtopology euclidean t,subtopology euclidean t) (f o h) I"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopy_equivalent] THEN
    MATCH_MP_TAC (← MESON [] (← q r"(!x. P x <=> Q x) ==> ((?x. P x) <=> (?x. Q x))")) THEN
    X_GEN_TAC (← q r"f:real^M->real^N") THEN
    EQ_TAC THENL [MESON_TAC [], STRIP_TAC] THEN
    EXISTS_TAC (← q r"(g:real^N->real^M) o f o (h:real^N->real^M)") THEN
    ASM_REWRITE_TAC [IMAGE_o] THEN REPEAT CONJ_TAC THENL
     [REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC) THEN
      REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
      ASM SET_TAC [],
      TRANS_TAC HOMOTOPIC_WITH_TRANS
        (← q r"((g:real^N->real^M) o I) o (f:real^M->real^N)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [I_O_ID]] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [],
      TRANS_TAC HOMOTOPIC_WITH_TRANS
        (← q r"(f:real^M->real^N) o I o (h:real^N->real^M)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [I_O_ID]] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [o_ASSOC] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC []])

  let HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> s homotopy_equivalent t"
   (REWRITE_TAC [← GSYM HOMEOMORPHIC_SPACE_EUCLIDEAN,
                ← GSYM HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE])

  let HOMOTOPY_EQUIVALENT_REFL ← prove
   r"!s:real^N->bool. s homotopy_equivalent s"
   (SIMP_TAC [HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, HOMEOMORPHIC_REFL])

  let HOMOTOPY_EQUIVALENT_SYM ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t <=> t homotopy_equivalent s"
   (REWRITE_TAC [← GSYM HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [HOMOTOPY_EQUIVALENT_SPACE_SYM])

  let HOMOTOPY_EQUIVALENT_TRANS ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homotopy_equivalent t /\ t homotopy_equivalent u
        ==> s homotopy_equivalent u"
   (REWRITE_TAC [← GSYM HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [HOMOTOPY_EQUIVALENT_SPACE_TRANS])

  let HOMOTOPY_EQUIVALENT_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool s':real^P->bool t':real^Q->bool.
         s homotopy_equivalent s' /\ t homotopy_equivalent t'
         ==> s PCROSS t homotopy_equivalent s' PCROSS t'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopy_equivalent] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f1:real^M->real^P", ← q r"g1:real^P->real^M",
      ← q r"f2:real^N->real^Q", ← q r"g2:real^Q->real^N"] THEN
    DISCH_TAC THEN
    EXISTS_TAC (← q r"\z. pastecart ((f1:real^M->real^P) (fstcart z))
                              ((f2:real^N->real^Q) (sndcart z))") THEN
    EXISTS_TAC (← q r"\z. pastecart ((g1:real^P->real^M) (fstcart z))
                              ((g2:real^Q->real^N) (sndcart z))") THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN
     (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC o
      GEN_REWRITE_RULE id [← TAUT
        (← q r"p /\ q /\ r /\ s /\ t <=> (p /\ q /\ r /\ s) /\ t")])) THEN
    ONCE_REWRITE_TAC [← TAUT
     (← q r"p /\ q ==> p' /\ q' ==> r <=> (p' /\ p) /\ (q' /\ q) ==> r")] THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o
      MATCH_MP (← MESON [] (← q r"(!x. p x) ==> (!x. p(\a. T))")) o
      MATCH_MP (← ONCE_REWRITE_RULE [← TAUT
       (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] HOMOTOPIC_WITH_PCROSS))) THEN
    REWRITE_TAC [I_DEF, PASTECART_FST_SND, o_DEF] THEN
    REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART] THEN
    DISCH_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (p /\ r) /\ (q /\ s)")] THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN CONJ_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      REWRITE_TAC [IMAGE_FSTCART_PCROSS, IMAGE_SNDCART_PCROSS] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [CONTINUOUS_ON_EMPTY],
      CONJ_TAC THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      REWRITE_TAC [PASTECART_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      ASM SET_TAC []])

  let HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_SELF ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (IMAGE f s) homotopy_equivalent s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT THEN
    MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_SELF THEN
    ASM_REWRITE_TAC [])

  let HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_LEFT_EQ ← prove
   r"!f:real^M->real^N s t.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> ((IMAGE f s) homotopy_equivalent t <=> s homotopy_equivalent t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (ASSUME_TAC o SPEC (← q r"s:real^M->bool") o
      MATCH_MP HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_SELF) THEN
    EQ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMOTOPY_EQUIVALENT_SYM]),
      POP_ASSUM MP_TAC] THEN
    REWRITE_TAC [IMP_IMP, HOMOTOPY_EQUIVALENT_TRANS])

  let HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ ← prove
   r"!f:real^M->real^N s t.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (s homotopy_equivalent (IMAGE f t) <=> s homotopy_equivalent t)"
   (ONCE_REWRITE_TAC [HOMOTOPY_EQUIVALENT_SYM] THEN
    REWRITE_TAC [HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_LEFT_EQ])

  add_linear_invariants
    [HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
     HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ]

  let HOMOTOPY_EQUIVALENT_TRANSLATION_SELF ← prove
   r"!a:real^N s. (IMAGE (\x. a + x) s) homotopy_equivalent s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_SELF])

  let HOMOTOPY_EQUIVALENT_TRANSLATION_LEFT_EQ ← prove
   r"!a:real^N s t.
      (IMAGE (\x. a + x) s) homotopy_equivalent t <=> s homotopy_equivalent t"
   (MESON_TAC [HOMOTOPY_EQUIVALENT_TRANSLATION_SELF,
              HOMOTOPY_EQUIVALENT_SYM, HOMOTOPY_EQUIVALENT_TRANS])

  let HOMOTOPY_EQUIVALENT_TRANSLATION_RIGHT_EQ ← prove
   r"!a:real^N s t.
      s homotopy_equivalent (IMAGE (\x. a + x) t) <=> s homotopy_equivalent t"
   (ONCE_REWRITE_TAC [HOMOTOPY_EQUIVALENT_SYM] THEN
    REWRITE_TAC [HOMOTOPY_EQUIVALENT_TRANSLATION_LEFT_EQ])

  add_translation_invariants
    [HOMOTOPY_EQUIVALENT_TRANSLATION_LEFT_EQ,
     HOMOTOPY_EQUIVALENT_TRANSLATION_RIGHT_EQ]

  return { homotopy_equivalent, HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN, HOMOTOPY_EQUIVALENT,
           HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, HOMOTOPY_EQUIVALENT_REFL, HOMOTOPY_EQUIVALENT_SYM,
           HOMOTOPY_EQUIVALENT_TRANS, HOMOTOPY_EQUIVALENT_PCROSS,
           HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_SELF,
           HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
           HOMOTOPY_EQUIVALENT_INJECTIVE_LINEAR_IMAGE_RIGHT_EQ,
           HOMOTOPY_EQUIVALENT_TRANSLATION_SELF, HOMOTOPY_EQUIVALENT_TRANSLATION_LEFT_EQ,
           HOMOTOPY_EQUIVALENT_TRANSLATION_RIGHT_EQ }

/- ------------------------------------------------------------------------- -/
/- Homotopy equivalence preserves (co)homotopic triviality.                  -/
/- (paths.ml 20025-20243)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PVW where
  HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY : thm
  HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY : thm
  HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY_NULL : thm
  HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY_NULL : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVW [HolBase] (D : PathsDeps) (BVE : PVE) (BVV : PVV) : ExceptT String IO PVW := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D.cvx
  let { IMAGE_o, IMP_CONJ, .. } := D.cvx.core2
  let { MONO_EXISTS, .. } := D.cvx.core3
  let { o_ASSOC, o_DEF, .. } := D.cvx.core6
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { I_O_ID, .. } := D.pses1
  let { HOMOTOPIC_WITH_SYM, HOMOTOPIC_WITH_TRANS, .. } := D.pmet2
  let { HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT, .. } :=
    BVE
  let { homotopy_equivalent, HOMOTOPY_EQUIVALENT_SYM, .. } := BVV
  -- @@SCOPE END

  let HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homotopy_equivalent t
        ==> ((!f g. f continuous_on u /\ IMAGE f u SUBSET s /\
                    g continuous_on u /\ IMAGE g u SUBSET s
                    ==> homotopic_with (\x. T)
                         (subtopology euclidean u,subtopology euclidean s)
                         f g) <=>
             (!f g. f continuous_on u /\ IMAGE f u SUBSET t /\
                    g continuous_on u /\ IMAGE g u SUBSET t
                    ==> homotopic_with (\x. T)
                         (subtopology euclidean u,subtopology euclidean t)
                         f g))"
   (← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool u:real^P->bool.
          s homotopy_equivalent t /\
          (!f g. f continuous_on u /\ IMAGE f u SUBSET s /\
                 g continuous_on u /\ IMAGE g u SUBSET s
                 ==> homotopic_with (\x. T)
                      (subtopology euclidean u,subtopology euclidean s) f g)
          ==> (!f g. f continuous_on u /\ IMAGE f u SUBSET t /\
                     g continuous_on u /\ IMAGE g u SUBSET t
                     ==> homotopic_with (\x. T)
                          (subtopology euclidean u,subtopology euclidean t)
                          f g)"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopy_equivalent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N")
       (X_CHOOSE_THEN (← q r"k:real^N->real^M") STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN
       (← q r"homotopic_with (\x. T)
            (subtopology euclidean u,subtopology euclidean t)
            ((h:real^M->real^N) o (k:real^N->real^M) o (f:real^P->real^N))
            (h o k o g)")
      MP_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IMAGE_o] THEN
        REPEAT CONJ_TAC THEN TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN
        ASM_REWRITE_TAC [] THEN
        TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC (← MESON [HOMOTOPIC_WITH_TRANS, HOMOTOPIC_WITH_SYM]
         (← q r"homotopic_with P
           (subtopology euclidean u,subtopology euclidean t) f f' /\
          homotopic_with P (subtopology euclidean u,subtopology euclidean t) g g'
          ==> homotopic_with P
               (subtopology euclidean u,subtopology euclidean t) f g
              ==> homotopic_with P
                   (subtopology euclidean u,subtopology euclidean t) f' g'")) THEN
        CONJ_TAC THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT1 (← SPEC_ALL I_O_ID))] THEN
        REWRITE_TAC [o_ASSOC] THEN
        MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC []])
    pure (
    REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] lemma) THEN
    ASM_MESON_TAC [HOMOTOPY_EQUIVALENT_SYM]))

  let HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homotopy_equivalent t
        ==> ((!f g. f continuous_on s /\ IMAGE f s SUBSET u /\
                    g continuous_on s /\ IMAGE g s SUBSET u
                    ==> homotopic_with (\x. T)
                         (subtopology euclidean s,subtopology euclidean u)
                         f g) <=>
             (!f g. f continuous_on t /\ IMAGE f t SUBSET u /\
                    g continuous_on t /\ IMAGE g t SUBSET u
                    ==> homotopic_with (\x. T)
                         (subtopology euclidean t,subtopology euclidean u)
                         f g))"
   (← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool u:real^P->bool.
          s homotopy_equivalent t /\
          (!f g. f continuous_on s /\ IMAGE f s SUBSET u /\
                 g continuous_on s /\ IMAGE g s SUBSET u
                 ==> homotopic_with (\x. T)
                      (subtopology euclidean s,subtopology euclidean u) f g)
           ==> (!f g. f continuous_on t /\ IMAGE f t SUBSET u /\
                      g continuous_on t /\ IMAGE g t SUBSET u
                      ==> homotopic_with (\x. T)
                           (subtopology euclidean t,subtopology euclidean u)
                           f g)"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopy_equivalent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N")
       (X_CHOOSE_THEN (← q r"k:real^N->real^M") STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN
       (← q r"homotopic_with (\x. T) (subtopology euclidean t,subtopology euclidean u)
            (((f:real^N->real^P) o h) o (k:real^N->real^M)) ((g o h) o k)")
      MP_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IMAGE_o] THEN
        REPEAT CONJ_TAC THEN TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE) THEN
        ASM_REWRITE_TAC [] THEN
        TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET))) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC (← MESON [HOMOTOPIC_WITH_TRANS, HOMOTOPIC_WITH_SYM]
         (← q r"homotopic_with P
           (subtopology euclidean u,subtopology euclidean t) f f' /\
          homotopic_with P (subtopology euclidean u,subtopology euclidean t) g g'
          ==> homotopic_with P
                (subtopology euclidean u,subtopology euclidean t) f g
              ==> homotopic_with P
                   (subtopology euclidean u,subtopology euclidean t) f' g'")) THEN
        CONJ_TAC THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT2 (← SPEC_ALL I_O_ID))] THEN
        REWRITE_TAC [← GSYM o_ASSOC] THEN
        MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC []])
    pure (
    REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] lemma) THEN
    ASM_MESON_TAC [HOMOTOPY_EQUIVALENT_SYM]))

  let HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY_NULL ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homotopy_equivalent t
        ==> ((!f. f continuous_on u /\ IMAGE f u SUBSET s
                  ==> ?c. homotopic_with (\x. T)
                           (subtopology euclidean u,subtopology euclidean s)
                           f (\x. c)) <=>
             (!f. f continuous_on u /\ IMAGE f u SUBSET t
                  ==> ?c. homotopic_with (\x. T)
                           (subtopology euclidean u,subtopology euclidean t)
                           f (\x. c)))"
   (← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool u:real^P->bool.
          s homotopy_equivalent t /\
          (!f. f continuous_on u /\ IMAGE f u SUBSET s
               ==> ?c. homotopic_with (\x. T)
                        (subtopology euclidean u,subtopology euclidean s)
                        f (\x. c))
          ==> (!f. f continuous_on u /\ IMAGE f u SUBSET t
                   ==> ?c. homotopic_with (\x. T)
                            (subtopology euclidean u,subtopology euclidean t)
                            f (\x. c))"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopy_equivalent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N")
       (X_CHOOSE_THEN (← q r"k:real^N->real^M") STRIP_ASSUME_TAC)) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(k:real^N->real^M) o (f:real^P->real^N)")) THEN
      REWRITE_TAC [IMAGE_o] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE, ASM SET_TAC []] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^M")) THEN
        EXISTS_TAC (← q r"(h:real^M->real^N) c")] THEN
      SUBGOAL_THEN
       (← q r"homotopic_with (\x. T)
            (subtopology euclidean u,subtopology euclidean t)
            ((h:real^M->real^N) o (k:real^N->real^M) o (f:real^P->real^N))
            (h o (\x. c))")
      MP_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [],
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [o_DEF] THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_TRANS) THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM (← CONJUNCT1 (← SPEC_ALL I_O_ID))] THEN
        REWRITE_TAC [o_ASSOC] THEN ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN
        MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC []])
    pure (
    REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] lemma) THEN
    ASM_MESON_TAC [HOMOTOPY_EQUIVALENT_SYM]))

  let HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY_NULL ← prove
   r"!s:real^M->bool t:real^N->bool u:real^P->bool.
        s homotopy_equivalent t
        ==> ((!f. f continuous_on s /\ IMAGE f s SUBSET u
                  ==> ?c. homotopic_with (\x. T)
                            (subtopology euclidean s,subtopology euclidean u)
                            f (\x. c)) <=>
             (!f. f continuous_on t /\ IMAGE f t SUBSET u
                  ==> ?c. homotopic_with (\x. T)
                           (subtopology euclidean t,subtopology euclidean u)
                           f (\x. c)))"
   (← do
    let lemma ← prove
     r"!s:real^M->bool t:real^N->bool u:real^P->bool.
          s homotopy_equivalent t /\
          (!f. f continuous_on s /\ IMAGE f s SUBSET u
               ==> ?c. homotopic_with (\x. T)
                        (subtopology euclidean s,subtopology euclidean u)
                        f (\x. c))
          ==> (!f. f continuous_on t /\ IMAGE f t SUBSET u
                   ==> ?c. homotopic_with (\x. T)
                            (subtopology euclidean t,subtopology euclidean u)
                            f (\x. c))"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopy_equivalent]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N")
       (X_CHOOSE_THEN (← q r"k:real^N->real^M") STRIP_ASSUME_TAC)) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:real^N->real^P) o (h:real^M->real^N)")) THEN
      REWRITE_TAC [IMAGE_o] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE, ASM SET_TAC []] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^P") THEN DISCH_TAC] THEN
      SUBGOAL_THEN
       (← q r"homotopic_with (\x. T) (subtopology euclidean t,subtopology euclidean u)
            (((f:real^N->real^P) o h) o (k:real^N->real^M)) ((\x. c) o k)")
      MP_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_RIGHT THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [],
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [o_DEF] THEN
        REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_WITH_TRANS) THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM (← CONJUNCT2 (← SPEC_ALL I_O_ID))] THEN
        REWRITE_TAC [← GSYM o_ASSOC] THEN ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN
        MATCH_MP_TAC HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC []])
    pure (
    REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] lemma) THEN
    ASM_MESON_TAC [HOMOTOPY_EQUIVALENT_SYM]))

  return { HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY, HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY,
           HOMOTOPY_EQUIVALENT_HOMOTOPIC_TRIVIALITY_NULL,
           HOMOTOPY_EQUIVALENT_COHOMOTOPIC_TRIVIALITY_NULL }

/- ------------------------------------------------------------------------- -/
/- Homotopy invariance of (path) components.  (paths.ml 20244-20545)         -/
/- ------------------------------------------------------------------------- -/

structure PVX where
  HOMOTOPIC_WITH_IMP_PATH_COMPONENT : thm
  HOMOTOPY_INVARIANT_CARD_COMPONENTS : thm
  HOMOTOPY_INVARIANT_CONNECTEDNESS : thm
  HOMOTOPY_EQUIVALENT_CONNECTEDNESS : thm
  HOMOTOPY_EQUIVALENT_CARD_EQ_COMPONENTS : thm
  HOMEOMORPHIC_CARD_EQ_COMPONENTS : thm
  HOMOTOPY_INVARIANT_CARD_PATH_COMPONENTS : thm
  HOMOTOPY_INVARIANT_PATH_CONNECTEDNESS : thm
  HOMOTOPY_EQUIVALENT_PATH_CONNECTEDNESS : thm
  HOMOTOPY_EQUIVALENT_CARD_EQ_PATH_COMPONENTS : thm
  HOMEOMORPHIC_CARD_EQ_PATH_COMPONENTS : thm
  FINITE_COMPONENTS_PUNCTURED_CONVEX : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVX [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BUG : PUG) (BUN : PUN)
    (BVE : PVE) (BVV : PVV) : ExceptT String IO PVX := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        HAS_SIZE_CONV, .. } := D.cvx
  let { CARD_SING, CONJ_ASSOC, DIMINDEX_1, ETA_AX, EXISTS_IN_GSPEC, EXISTS_PASTECART,
        FINITE_EMPTY, FINITE_INSERT, FINITE_SING, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FUN_IN_IMAGE, HAS_SIZE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_SING, I_THM, LEFT_IMP_EXISTS_THM, LEFT_OR_DISTRIB, LE_TRANS,
        MONO_EXISTS, PASTECART_IN_PCROSS, .. } := D.cvx.core3
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, SUBSET_EMPTY, SUBSET_PCROSS, .. } :=
    D.cvx.core5
  let { SUBSET_UNIV, SWAP_EXISTS_THM, o_THM, .. } := D.cvx.core6
  let { CARD_LE_RELATIONAL_FULL, .. } := D.cvx.lib
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { DROP_EQ, .. } := D.cvx.vec2
  let { CONNECTED_COMPONENT_SUBSET, CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { HOMEOMORPHISM_OF_SUBSETS, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, .. } :=
    D.cvx.top4
  let { components, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CARD_EMPTY_LE, CARD_FINITE_CONG, CARD_LE_ANTISYM, CARD_LE_CARD, CARD_LE_CARD_IMP,
        CARD_LE_FINITE, .. } := D.pcard
  let { COMPONENTS_EMPTY, .. } := D.ptop1
  let { COMPONENTS_UNIQUE_2, CONNECTED_COMPONENT_EQ_EQ, CONNECTED_COMPONENT_REFL,
        CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS, CONNECTED_CONNECTED_COMPONENT,
        CONNECTED_EQ_CARD_COMPONENTS, .. } := D.ptop2
  let { EXISTS_COMPONENT_SUPERSET, HOMEOMORPHIC_CONNECTEDNESS, .. } := D.ptop3
  let { IS_INTERVAL_1_CLAUSES, IS_INTERVAL_INTER, .. } := D.ptop4
  let { connected_component, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_UNIV, AFF_DIM_AFFINE_HULL, AFF_DIM_UNIV, CONVEX_CONNECTED,
        .. } := D.pcvx1
  let { HOMEOMORPHIC_AFFINE_SETS, IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { PATH_COMPONENT_REFL, PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS, PATH_COMPONENT_OF_SUBSET,
        PATH_COMPONENT_SUBSET, PATH_CONNECTED_IFF_PATH_COMPONENT, PATH_CONNECTED_COMPONENT_SET,
        PATH_COMPONENT_MAXIMAL, PATH_CONNECTED_PATH_COMPONENT, PATH_COMPONENT,
        PATH_COMPONENT_EQ_EQ, .. } := BK
  let { PATH_CONNECTED_INTERVAL, PATH_CONNECTED_CONTINUOUS_IMAGE, PATH_CONNECTED_EMPTY,
        PATH_CONNECTED_SING, PATH_CONNECTED_PCROSS_EQ, .. } := BL
  let { PATH_COMPONENT_IMP_CONNECTED_COMPONENT, .. } := BUG
  let { CONNECTED_PUNCTURED_CONVEX, .. } := BUN
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { homotopy_equivalent, HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, .. } := BVV
  -- @@SCOPE END

  let HOMOTOPIC_WITH_IMP_PATH_COMPONENT ← prove
   r"!f g:real^M->real^N s t a.
        homotopic_with (\x. T)
         (subtopology euclidean s,subtopology euclidean t) f g /\
        a IN s
        ==> path_component t (f a) (g a)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    REWRITE_TAC [o_THM, I_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,M)finite_sum->real^N")
          STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC PATH_COMPONENT_OF_SUBSET THEN
    EXISTS_TAC
     (← q r"IMAGE (h:real^(1,M)finite_sum->real^N)
            (interval[vec 0,vec 1] PCROSS {a})") THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"IMAGE f s' SUBSET t ==> s SUBSET s' ==> IMAGE f s SUBSET t"))) THEN
      REWRITE_TAC [SUBSET_PCROSS] THEN ASM SET_TAC [],
      W (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1) o PART_MATCH (rand o lhand)
         PATH_CONNECTED_IFF_PATH_COMPONENT o lhand o rator o snd) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [PATH_CONNECTED_PCROSS_EQ, PATH_CONNECTED_INTERVAL,
                    PATH_CONNECTED_SING] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_PCROSS] THEN ASM SET_TAC [],
        DISCH_THEN MATCH_MP_TAC THEN
        REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, PASTECART_IN_PCROSS] THEN
        ASM_MESON_TAC [ENDS_IN_UNIT_INTERVAL, IN_SING]]])

  let HOMOTOPY_INVARIANT_CARD_COMPONENTS ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        homotopic_with (\x. T)
         (subtopology euclidean t,subtopology euclidean t) (f o g) I
        ==> components t <=_c components s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY, COMPONENTS_EMPTY] THEN
    REWRITE_TAC [CARD_EMPTY_LE] THEN STRIP_TAC THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\c d. IMAGE (g:real^N->real^M) d SUBSET c") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC EXISTS_COMPONENT_SUPERSET THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN ASM SET_TAC [],
        MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [IN_COMPONENTS_SUBSET, CONTINUOUS_ON_SUBSET,
                      IN_COMPONENTS_CONNECTED]],
      ALL_TAC] THEN
    REWRITE_TAC [IMP_CONJ, components, FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [CONNECTED_COMPONENT_EQ_EQ] THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN REPEAT DISCH_TAC THEN
    MATCH_MP_TAC (← MESON [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS]
     (← q r"!f. connected_component s (f b) (f c) /\
          connected_component s (f b) b /\
          connected_component s (f c) c
          ==> connected_component s b c")) THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o (g:real^N->real^M)") THEN CONJ_TAC THENL
     [ALL_TAC,
      CONJ_TAC THEN
      MATCH_MP_TAC PATH_COMPONENT_IMP_CONNECTED_COMPONENT THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM I_THM] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_IMP_PATH_COMPONENT THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [ETA_AX]] THEN
    REWRITE_TAC [connected_component] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (connected_component s a)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET, CONTINUOUS_ON_SUBSET],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"a:real^M"]
          CONNECTED_COMPONENT_SUBSET) THEN ASM SET_TAC [],
      REWRITE_TAC [o_THM] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENT_REFL)) THEN
      ASM SET_TAC []])

  let HOMOTOPY_INVARIANT_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        homotopic_with (\x. T)
         (subtopology euclidean t,subtopology euclidean t) (f o g) I /\
        connected s
        ==> connected t"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [CONNECTED_EQ_CARD_COMPONENTS] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"g:real^N->real^M", ← q r"s:real^M->bool",
      ← q r"t:real^N->bool"]
     HOMOTOPY_INVARIANT_CARD_COMPONENTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CARD_LE_FINITE)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CARD_LE_CARD_IMP, LE_TRANS])

  let HOMOTOPY_EQUIVALENT_CONNECTEDNESS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t ==> (connected s <=> connected t)"
   (REWRITE_TAC [homotopy_equivalent] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] HOMOTOPY_INVARIANT_CONNECTEDNESS)) THEN
    ASM_MESON_TAC [])

  let HOMOTOPY_EQUIVALENT_CARD_EQ_COMPONENTS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t ==> components s =_c components t"
   (REWRITE_TAC [homotopy_equivalent] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC HOMOTOPY_INVARIANT_CARD_COMPONENTS THEN ASM_MESON_TAC [])

  let HOMEOMORPHIC_CARD_EQ_COMPONENTS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> components s =_c components t"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENT_CARD_EQ_COMPONENTS THEN
    MATCH_MP_TAC HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT THEN
    ASM_REWRITE_TAC [])

  let HOMOTOPY_INVARIANT_CARD_PATH_COMPONENTS ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        homotopic_with (\x. T)
         (subtopology euclidean t,subtopology euclidean t) (f o g) I
        ==> {path_component t x | x | x IN t}
            <=_c {path_component s x | x | x IN s}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\c d. IMAGE (g:real^N->real^M) d SUBSET c") THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(g:real^N->real^M) y") THEN
      CONJ_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC PATH_COMPONENT_MAXIMAL] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN] THEN
        ASM_SIMP_TAC [PATH_COMPONENT_REFL],
        MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [PATH_CONNECTED_PATH_COMPONENT] THEN
        ASM_MESON_TAC [PATH_COMPONENT_SUBSET, CONTINUOUS_ON_SUBSET],
        MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"y:real^N"]
          PATH_COMPONENT_SUBSET) THEN ASM SET_TAC []],
      ALL_TAC] THEN
    SIMP_TAC [PATH_COMPONENT_EQ_EQ] THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN REPEAT DISCH_TAC THEN
    MATCH_MP_TAC (← MESON [PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS]
     (← q r"!f. path_component s (f b) (f c) /\
          path_component s (f b) b /\
          path_component s (f c) c
          ==> path_component s b c")) THEN
    EXISTS_TAC (← q r"(f:real^M->real^N) o (g:real^N->real^M)") THEN CONJ_TAC THENL
     [ALL_TAC,
      CONJ_TAC THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM I_THM] THEN
      MATCH_MP_TAC HOMOTOPIC_WITH_IMP_PATH_COMPONENT THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [ETA_AX]] THEN
    REWRITE_TAC [PATH_COMPONENT] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) (path_component s a)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [PATH_CONNECTED_PATH_COMPONENT] THEN
      ASM_MESON_TAC [PATH_COMPONENT_SUBSET, CONTINUOUS_ON_SUBSET],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"a:real^M"]
          PATH_COMPONENT_SUBSET) THEN ASM SET_TAC [],
      REWRITE_TAC [o_THM] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENT_REFL)) THEN
      ASM SET_TAC []])

  let HOMOTOPY_INVARIANT_PATH_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET s /\
        homotopic_with (\x. T)
         (subtopology euclidean t,subtopology euclidean t) (f o g) I /\
        path_connected s
        ==> path_connected t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY, IMAGE_EQ_EMPTY, COMPONENTS_EMPTY] THEN
    REWRITE_TAC [PATH_CONNECTED_EMPTY] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{path_component s (x:real^M) | x | x IN s} = {s}")
    ASSUME_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"s = {a} <=> a IN s /\ !x. x IN s ==> x = a")] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MP_TAC (← ISPEC (← q r"s:real^M->bool") PATH_CONNECTED_COMPONENT_SET) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"g:real^N->real^M", ← q r"s:real^M->bool",
      ← q r"t:real^N->bool"]
     HOMOTOPY_INVARIANT_CARD_PATH_COMPONENTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CARD_LE_FINITE)) THEN
    REWRITE_TAC [FINITE_SING] THEN DISCH_TAC THEN
    UNDISCH_TAC
     (← q r"{path_component t (x:real^N) | x | x IN t} <=_c {s:real^M->bool}") THEN
    ASM_SIMP_TAC [CARD_LE_CARD, FINITE_SING, CARD_SING] THEN
    UNDISCH_TAC (← q r"FINITE {path_component t (x:real^N) | x | x IN t}") THEN
    REWRITE_TAC [← ARITH_RULE (← q r"n <= 1 <=> n = 0 \/ n = 1")] THEN
    REWRITE_TAC [IMP_IMP, LEFT_OR_DISTRIB, ← GSYM HAS_SIZE] THEN
    CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s = {} \/ (?a. s = {a}) ==> !x. x IN s ==> !y. y IN s ==> x = y"))) THEN
    SIMP_TAC [FORALL_IN_GSPEC, PATH_COMPONENT_EQ_EQ] THEN
    REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN MESON_TAC [])

  let HOMOTOPY_EQUIVALENT_PATH_CONNECTEDNESS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t ==> (path_connected s <=> path_connected t)"
   (REWRITE_TAC [homotopy_equivalent] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] HOMOTOPY_INVARIANT_PATH_CONNECTEDNESS)) THEN
    ASM_MESON_TAC [])

  let HOMOTOPY_EQUIVALENT_CARD_EQ_PATH_COMPONENTS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t
        ==> {path_component s x | x | x IN s} =_c
            {path_component t x | x | x IN t}"
   (REWRITE_TAC [homotopy_equivalent] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC HOMOTOPY_INVARIANT_CARD_PATH_COMPONENTS THEN ASM_MESON_TAC [])

  let HOMEOMORPHIC_CARD_EQ_PATH_COMPONENTS ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t
        ==> {path_component s x | x | x IN s} =_c
            {path_component t x | x | x IN t}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOMOTOPY_EQUIVALENT_CARD_EQ_PATH_COMPONENTS THEN
    MATCH_MP_TAC HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT THEN
    ASM_REWRITE_TAC [])

  let FINITE_COMPONENTS_PUNCTURED_CONVEX ← prove
   r"!s a:real^N. convex s ==> FINITE(components(s DELETE a))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"aff_dim(s:real^N->bool) = &1") THENL
     [ALL_TAC,
      ASM_MESON_TAC [CONNECTED_PUNCTURED_CONVEX,
                    CONNECTED_EQ_CARD_COMPONENTS]] THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [ALL_TAC,
      ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")] THEN
      MATCH_MP_TAC (← MESON [CONNECTED_EQ_CARD_COMPONENTS]
       (← q r"connected(c:real^N->bool) ==> FINITE(components c)")) THEN
      ASM_SIMP_TAC [CONVEX_CONNECTED]] THEN
    SUBGOAL_THEN (← q r"?t. (s:real^N->bool) homeomorphic (t:real^1->bool)")
    CHOOSE_TAC THENL
     [MP_TAC (← ISPECL [← q r"affine hull s:real^N->bool", ← q r"(:real^1)"]
          HOMEOMORPHIC_AFFINE_SETS) THEN
      ASM_REWRITE_TAC [AFFINE_AFFINE_HULL, AFFINE_UNIV, AFF_DIM_AFFINE_HULL] THEN
      SIMP_TAC [AFF_DIM_UNIV, DIMINDEX_1, homeomorphic, LEFT_IMP_EXISTS_THM] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool") o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
      REWRITE_TAC [HULL_SUBSET, SUBSET_UNIV] THEN MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"?b. b IN t /\ (s DELETE (a:real^N)) homeomorphic (t DELETE (b:real^1))")
    (X_CHOOSE_THEN (← q r"b:real^1") MP_TAC) THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [homeomorphic, RIGHT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^N->real^1") THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(f:real^N->real^1) a") THEN CONJ_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS))] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN MP_TAC) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_CARD_EQ_COMPONENTS) THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP CARD_FINITE_CONG) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_CONNECTEDNESS) THEN
      ASM_SIMP_TAC [CONVEX_CONNECTED] THEN
      REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1]] THEN
    POP_ASSUM_LIST (K ALL_TAC : List thm → tactic) THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"connected(t DELETE (b:real^1))") THENL
     [ASM_MESON_TAC [CONNECTED_EQ_CARD_COMPONENTS], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"t DELETE (b:real^1)",
      ← q r"t INTER {x | drop x < drop b}", ← q r"t INTER {x | drop b < drop x}"]
     COMPONENTS_UNIQUE_2) THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC [FINITE_INSERT, FINITE_EMPTY]] THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1] THEN
    ASM_SIMP_TAC [IS_INTERVAL_INTER, IS_INTERVAL_1_CLAUSES] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. ~P x /\ ~Q x <=> x = b)
      ==> t INTER {x | P x} UNION t INTER {x | Q x} = t DELETE b")) THEN
    REWRITE_TAC [← GSYM DROP_EQ] THEN REAL_ARITH_TAC)

  return { HOMOTOPIC_WITH_IMP_PATH_COMPONENT, HOMOTOPY_INVARIANT_CARD_COMPONENTS,
           HOMOTOPY_INVARIANT_CONNECTEDNESS, HOMOTOPY_EQUIVALENT_CONNECTEDNESS,
           HOMOTOPY_EQUIVALENT_CARD_EQ_COMPONENTS, HOMEOMORPHIC_CARD_EQ_COMPONENTS,
           HOMOTOPY_INVARIANT_CARD_PATH_COMPONENTS, HOMOTOPY_INVARIANT_PATH_CONNECTEDNESS,
           HOMOTOPY_EQUIVALENT_PATH_CONNECTEDNESS, HOMOTOPY_EQUIVALENT_CARD_EQ_PATH_COMPONENTS,
           HOMEOMORPHIC_CARD_EQ_PATH_COMPONENTS, FINITE_COMPONENTS_PUNCTURED_CONVEX }

/- ------------------------------------------------------------------------- -/
/- Contractible sets.  (paths.ml 20546-20804)                                -/
/- ------------------------------------------------------------------------- -/

structure PVY where
  contractible : thm
  CONTRACTIBLE_SPACE_EUCLIDEAN : thm
  CONTRACTIBLE_IMP_SIMPLY_CONNECTED : thm
  CONTRACTIBLE_IMP_CONNECTED : thm
  CONTRACTIBLE_IMP_PATH_CONNECTED : thm
  NULLHOMOTOPIC_THROUGH_CONTRACTIBLE : thm
  NULLHOMOTOPIC_INTO_CONTRACTIBLE : thm
  NULLHOMOTOPIC_FROM_CONTRACTIBLE : thm
  HOMOTOPIC_THROUGH_CONTRACTIBLE : thm
  HOMOTOPIC_INTO_CONTRACTIBLE : thm
  HOMOTOPIC_FROM_CONTRACTIBLE : thm
  HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS : thm
  STARLIKE_IMP_CONTRACTIBLE_GEN : thm
  STARLIKE_IMP_CONTRACTIBLE : thm
  CONTRACTIBLE_UNIV : thm
  STARLIKE_IMP_SIMPLY_CONNECTED : thm
  CONVEX_IMP_SIMPLY_CONNECTED : thm
  STARLIKE_IMP_PATH_CONNECTED : thm
  STARLIKE_IMP_CONNECTED : thm
  CONIC_IMP_PATH_CONNECTED : thm
  CONIC_IMP_CONNECTED : thm
  IS_INTERVAL_SIMPLY_CONNECTED_1 : thm
  CONTRACTIBLE_EMPTY : thm
  CONIC_IMP_CONTRACTIBLE : thm
  CONIC_IMP_SIMPLY_CONNECTED : thm
  CONTRACTIBLE_CONVEX_TWEAK_BOUNDARY_POINTS : thm
  CONVEX_IMP_CONTRACTIBLE : thm
  CONTRACTIBLE_SING : thm
  SIMPLY_CONNECTED_SING : thm
  IS_INTERVAL_CONTRACTIBLE_1 : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVY [HolBase] (D : PathsDeps) (BA : PTA) (BI : PTI) (BK : PTK) (BL : PTL)
    (BVE : PVE) (BVM : PVM) (BVR : PVR) (BVV : PVV) : ExceptT String IO PVY := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH, .. } := D.cvx
  let { ETA_AX, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FSTCART_PASTECART, FUN_EQ_THM, IMAGE_ID, IMP_CONJ,
        IN_ELIM_PASTECART_THM, .. } := D.cvx.core2
  let { MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, PCROSS, PCROSS_EMPTY, .. } := D.cvx.core3
  let { REAL_SUB_REFL, REAL_SUB_RZERO, SNDCART_PASTECART, SUBSET, SUBSET_EMPTY, SUBSET_REFL,
        .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_VEC, LIFT_DROP, LIFT_SUB, LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_LID, VECTOR_MUL_LZERO, .. } := D.cvx.vec4
  let { CLOSURE_EMPTY, .. } := D.cvx.top1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, .. } :=
    D.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { SEGMENT_SYM, segment, .. } := D.cvx.top5
  let { I_DEF, .. } := D.pses1
  let { HOMOTOPIC_FROM_CONTRACTIBLE_SPACE, HOMOTOPIC_INTO_CONTRACTIBLE_SPACE,
        HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE, .. } := D.pmet1
  let { NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE, contractible_space, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := D.ptop2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { CONIC_IMP_STARLIKE, .. } := D.pcvx1
  let { CONVEX_IMP_STARLIKE, CONVEX_SING, IS_INTERVAL_CONVEX_1,
        STARLIKE_CONVEX_TWEAK_BOUNDARY_POINTS, STARLIKE_UNIV, starlike, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { linepath, .. } := BI
  let { PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_EMPTY, IS_INTERVAL_PATH_CONNECTED_1, .. } :=
    BL
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_EUCLIDEAN_ALT, HOMOTOPIC_WITH_IMP_SUBSET, .. } :=
    BVE
  let { homotopic_loops, .. } := BVM
  let { SIMPLY_CONNECTED_EMPTY, SIMPLY_CONNECTED_IMP_PATH_CONNECTED,
        SIMPLY_CONNECTED_IMP_CONNECTED, SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ALL, .. } := BVR
  let { homotopy_equivalent, HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, .. } := BVV
  -- @@SCOPE END

  let contractible ← new_definition
   r"contractible s <=>
    ?a. homotopic_with (\x. T)
         (subtopology euclidean s,subtopology euclidean s) (\x. x) (\x. a)"

  let CONTRACTIBLE_SPACE_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        contractible_space(subtopology euclidean s) <=> contractible s"
   (REWRITE_TAC [contractible, contractible_space])

  let CONTRACTIBLE_IMP_SIMPLY_CONNECTED ← prove
   r"!s:real^N->bool. contractible s ==> simply_connected s"
   (GEN_TAC THEN REWRITE_TAC [contractible] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [SIMPLY_CONNECTED_EMPTY] THEN
    ASM_REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_LOOP_ALL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_TAC THEN REWRITE_TAC [homotopic_loops, PCROSS] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    X_GEN_TAC (← q r"p:real^1->real^N") THEN
    REWRITE_TAC [path, path_image, pathfinish, pathstart] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, SUBSET, FORALL_IN_IMAGE, PCROSS] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^(1,N)finite_sum->real^N")
      STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(h o (\y. pastecart (fstcart y) (p(sndcart y):real^N)))
                :real^(1,1)finite_sum->real^N") THEN
    ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, linepath, o_THM] THEN
    CONJ_TAC THENL [ALL_TAC, CONV_TAC (fun t => VECTOR_ARITH t)] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [IN_ELIM_PASTECART_THM, FSTCART_PASTECART, SNDCART_PASTECART])

  let CONTRACTIBLE_IMP_CONNECTED ← prove
   r"!s:real^N->bool. contractible s ==> connected s"
   (SIMP_TAC [CONTRACTIBLE_IMP_SIMPLY_CONNECTED,
             SIMPLY_CONNECTED_IMP_CONNECTED])

  let CONTRACTIBLE_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. contractible s ==> path_connected s"
   (SIMP_TAC [CONTRACTIBLE_IMP_SIMPLY_CONNECTED,
             SIMPLY_CONNECTED_IMP_PATH_CONNECTED])

  let NULLHOMOTOPIC_THROUGH_CONTRACTIBLE ← prove
   r"!f:real^M->real^N g:real^N->real^P s t u.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on t /\ IMAGE g t SUBSET u /\
        contractible t
        ==> ?c. homotopic_with (\h. T)
                 (subtopology euclidean s,subtopology euclidean u)
                 (g o f) (\x. c)"
   (REWRITE_TAC [← GSYM CONTRACTIBLE_SPACE_EUCLIDEAN] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE THEN
    EXISTS_TAC (← q r"subtopology euclidean (t:real^N->bool)") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2])

  let NULLHOMOTOPIC_INTO_CONTRACTIBLE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ contractible t
        ==> ?c. homotopic_with (\h. T)
                 (subtopology euclidean s,subtopology euclidean t) f (\x. c)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) = (\x. x) o f") SUBST1_TAC THENL
     [REWRITE_TAC [o_THM, FUN_EQ_THM],
      MATCH_MP_TAC NULLHOMOTOPIC_THROUGH_CONTRACTIBLE THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [CONTINUOUS_ON_ID] THEN
      SET_TAC []])

  let NULLHOMOTOPIC_FROM_CONTRACTIBLE ← prove
   r"!f:real^M->real^N s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\ contractible s
        ==> ?c. homotopic_with (\h. T)
                 (subtopology euclidean s,subtopology euclidean t) f (\x. c)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) = f o (\x. x)") SUBST1_TAC THENL
     [REWRITE_TAC [o_THM, FUN_EQ_THM],
      MATCH_MP_TAC NULLHOMOTOPIC_THROUGH_CONTRACTIBLE THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [CONTINUOUS_ON_ID] THEN
      SET_TAC []])

  let HOMOTOPIC_THROUGH_CONTRACTIBLE ← prove
   r"!f1:real^M->real^N g1:real^N->real^P f2 g2 s t u.
        f1 continuous_on s /\ IMAGE f1 s SUBSET t /\
        g1 continuous_on t /\ IMAGE g1 t SUBSET u /\
        f2 continuous_on s /\ IMAGE f2 s SUBSET t /\
        g2 continuous_on t /\ IMAGE g2 t SUBSET u /\
        contractible t /\ path_connected u
        ==> homotopic_with (\h. T)
             (subtopology euclidean s,subtopology euclidean u)
             (g1 o f1) (g2 o f2)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE THEN
    EXISTS_TAC (← q r"subtopology euclidean (t:real^N->bool)") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2] THEN
    ASM_REWRITE_TAC [CONTRACTIBLE_SPACE_EUCLIDEAN] THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY])

  let HOMOTOPIC_INTO_CONTRACTIBLE ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on s /\ IMAGE g s SUBSET t /\
        contractible t
        ==> homotopic_with (\h. T)
             (subtopology euclidean s,subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_INTO_CONTRACTIBLE_SPACE THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2, CONTRACTIBLE_SPACE_EUCLIDEAN])

  let HOMOTOPIC_FROM_CONTRACTIBLE ← prove
   r"!f:real^M->real^N g s t.
        f continuous_on s /\ IMAGE f s SUBSET t /\
        g continuous_on s /\ IMAGE g s SUBSET t /\
        contractible s /\ path_connected t
        ==> homotopic_with (\h. T)
             (subtopology euclidean s,subtopology euclidean t) f g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPIC_FROM_CONTRACTIBLE_SPACE THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2, CONTRACTIBLE_SPACE_EUCLIDEAN,
                    PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY])

  let HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS ← prove
   r"!s:real^M->bool t:real^N->bool.
        contractible s /\ contractible t /\ (s = {} <=> t = {})
        ==> s homotopy_equivalent t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, HOMEOMORPHIC_EMPTY] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"b:real^N") o
      GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    STRIP_TAC THEN REWRITE_TAC [homotopy_equivalent] THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:real^M") o
      GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    EXISTS_TAC (← q r"(\x. b):real^M->real^N") THEN
    EXISTS_TAC (← q r"(\y. a):real^N->real^M") THEN
    REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    CONJ_TAC THEN MATCH_MP_TAC HOMOTOPIC_INTO_CONTRACTIBLE THEN
    ASM_REWRITE_TAC [o_DEF, IMAGE_ID, I_DEF, SUBSET_REFL, CONTINUOUS_ON_ID,
                    CONTINUOUS_ON_CONST] THEN
    ASM SET_TAC [])

  let STARLIKE_IMP_CONTRACTIBLE_GEN ← prove
   r"!P s.
        (!a t. a IN s /\ &0 <= t /\ t <= &1 ==> P(\x. (&1 - t) % x + t % a)) /\
        starlike s
        ==> ?a:real^N. homotopic_with P
            (subtopology euclidean s,subtopology euclidean s) (\x. x) (\x. a)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [starlike] THEN ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
    REWRITE_TAC [segment, SUBSET, FORALL_IN_GSPEC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS] THEN
    EXISTS_TAC (← q r"\y:real^(1,N)finite_sum.
               (&1 - drop(fstcart y)) % sndcart y +
               drop(fstcart y) % a") THEN
    ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, DROP_VEC, IN_INTERVAL_1,
      SUBSET, FORALL_IN_IMAGE, REAL_SUB_RZERO, REAL_SUB_REFL, FORALL_IN_GSPEC,
      VECTOR_MUL_LZERO, VECTOR_MUL_LID, VECTOR_ADD_LID, VECTOR_ADD_RID] THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
    SIMP_TAC [o_DEF, LIFT_DROP, ETA_AX, LIFT_SUB, CONTINUOUS_ON_SUB,
             CONTINUOUS_ON_CONST, LINEAR_CONTINUOUS_ON, ETA_AX,
             LINEAR_FSTCART, LINEAR_SNDCART])

  let STARLIKE_IMP_CONTRACTIBLE ← prove
   r"!s:real^N->bool. starlike s ==> contractible s"
   (SIMP_TAC [contractible, STARLIKE_IMP_CONTRACTIBLE_GEN])

  let CONTRACTIBLE_UNIV ← prove
   r"contractible(:real^N)"
   (SIMP_TAC [STARLIKE_IMP_CONTRACTIBLE, STARLIKE_UNIV])

  let STARLIKE_IMP_SIMPLY_CONNECTED ← prove
   r"!s:real^N->bool. starlike s ==> simply_connected s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTRACTIBLE_IMP_SIMPLY_CONNECTED THEN
    MATCH_MP_TAC STARLIKE_IMP_CONTRACTIBLE THEN ASM_REWRITE_TAC [])

  let CONVEX_IMP_SIMPLY_CONNECTED ← prove
   r"!s:real^N->bool. convex s ==> simply_connected s"
   (MESON_TAC [CONVEX_IMP_STARLIKE, STARLIKE_IMP_SIMPLY_CONNECTED,
              SIMPLY_CONNECTED_EMPTY])

  let STARLIKE_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. starlike s ==> path_connected s"
   (MESON_TAC [STARLIKE_IMP_SIMPLY_CONNECTED,
              SIMPLY_CONNECTED_IMP_PATH_CONNECTED])

  let STARLIKE_IMP_CONNECTED ← prove
   r"!s:real^N->bool. starlike s ==> connected s"
   (MESON_TAC [STARLIKE_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED])

  let CONIC_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool. conic s ==> path_connected s"
   (MESON_TAC [STARLIKE_IMP_PATH_CONNECTED, CONIC_IMP_STARLIKE,
              PATH_CONNECTED_EMPTY])

  let CONIC_IMP_CONNECTED ← prove
   r"!s:real^N->bool. conic s ==> connected s"
   (MESON_TAC [CONIC_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED])

  let IS_INTERVAL_SIMPLY_CONNECTED_1 ← prove
   r"!s:real^1->bool. is_interval s <=> simply_connected s"
   (MESON_TAC [SIMPLY_CONNECTED_IMP_PATH_CONNECTED, IS_INTERVAL_PATH_CONNECTED_1,
              CONVEX_IMP_SIMPLY_CONNECTED, IS_INTERVAL_CONVEX_1])

  let CONTRACTIBLE_EMPTY ← prove
   r"contractible {}"
   (SIMP_TAC [contractible, HOMOTOPIC_WITH_EUCLIDEAN_ALT, PCROSS_EMPTY,
             NOT_IN_EMPTY] THEN
    REWRITE_TAC [CONTINUOUS_ON_EMPTY] THEN SET_TAC [])

  let CONIC_IMP_CONTRACTIBLE ← prove
   r"!s:real^N->bool. conic s ==> contractible s"
   (MESON_TAC [CONIC_IMP_STARLIKE, STARLIKE_IMP_CONTRACTIBLE,
              CONTRACTIBLE_EMPTY])

  let CONIC_IMP_SIMPLY_CONNECTED ← prove
   r"!s:real^N->bool. conic s ==> simply_connected s"
   (MESON_TAC [CONIC_IMP_CONTRACTIBLE, CONTRACTIBLE_IMP_SIMPLY_CONNECTED])

  let CONTRACTIBLE_CONVEX_TWEAK_BOUNDARY_POINTS ← prove
   r"!s t:real^N->bool.
        convex s /\ relative_interior s SUBSET t /\ t SUBSET closure s
        ==> contractible t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY, CLOSURE_EMPTY, CONTRACTIBLE_EMPTY] THEN
    STRIP_TAC THEN MATCH_MP_TAC STARLIKE_IMP_CONTRACTIBLE THEN
    MATCH_MP_TAC STARLIKE_CONVEX_TWEAK_BOUNDARY_POINTS THEN ASM_MESON_TAC [])

  let CONVEX_IMP_CONTRACTIBLE ← prove
   r"!s:real^N->bool. convex s ==> contractible s"
   (MESON_TAC [CONVEX_IMP_STARLIKE, CONTRACTIBLE_EMPTY,
              STARLIKE_IMP_CONTRACTIBLE])

  let CONTRACTIBLE_SING ← prove
   r"!a:real^N. contractible {a}"
   (SIMP_TAC [CONVEX_IMP_CONTRACTIBLE, CONVEX_SING])

  let SIMPLY_CONNECTED_SING ← prove
   r"!a:real^N. simply_connected {a}"
   (SIMP_TAC [CONTRACTIBLE_SING, CONTRACTIBLE_IMP_SIMPLY_CONNECTED])

  let IS_INTERVAL_CONTRACTIBLE_1 ← prove
   r"!s:real^1->bool. is_interval s <=> contractible s"
   (MESON_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED, IS_INTERVAL_PATH_CONNECTED_1,
              CONVEX_IMP_CONTRACTIBLE, IS_INTERVAL_CONVEX_1])

  return { contractible, CONTRACTIBLE_SPACE_EUCLIDEAN, CONTRACTIBLE_IMP_SIMPLY_CONNECTED,
           CONTRACTIBLE_IMP_CONNECTED, CONTRACTIBLE_IMP_PATH_CONNECTED,
           NULLHOMOTOPIC_THROUGH_CONTRACTIBLE, NULLHOMOTOPIC_INTO_CONTRACTIBLE,
           NULLHOMOTOPIC_FROM_CONTRACTIBLE, HOMOTOPIC_THROUGH_CONTRACTIBLE,
           HOMOTOPIC_INTO_CONTRACTIBLE, HOMOTOPIC_FROM_CONTRACTIBLE,
           HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS, STARLIKE_IMP_CONTRACTIBLE_GEN,
           STARLIKE_IMP_CONTRACTIBLE, CONTRACTIBLE_UNIV, STARLIKE_IMP_SIMPLY_CONNECTED,
           CONVEX_IMP_SIMPLY_CONNECTED, STARLIKE_IMP_PATH_CONNECTED, STARLIKE_IMP_CONNECTED,
           CONIC_IMP_PATH_CONNECTED, CONIC_IMP_CONNECTED, IS_INTERVAL_SIMPLY_CONNECTED_1,
           CONTRACTIBLE_EMPTY, CONIC_IMP_CONTRACTIBLE, CONIC_IMP_SIMPLY_CONNECTED,
           CONTRACTIBLE_CONVEX_TWEAK_BOUNDARY_POINTS, CONVEX_IMP_CONTRACTIBLE,
           CONTRACTIBLE_SING, SIMPLY_CONNECTED_SING, IS_INTERVAL_CONTRACTIBLE_1 }

/- ------------------------------------------------------------------------- -/
/- Contractibility of products, invariance under homotopy equivalence and    -/
/- homeomorphism.  (paths.ml 20805-20944)                                    -/
/- ------------------------------------------------------------------------- -/

structure PVZ where
  CONTRACTIBLE_PCROSS : thm
  CONTRACTIBLE_PCROSS_EQ : thm
  HOMOTOPY_EQUIVALENT_EMPTY : thm
  HOMOTOPY_EQUIVALENT_CONTRACTIBILITY : thm
  HOMOTOPY_EQUIVALENT_SING : thm
  HOMEOMORPHIC_CONTRACTIBLE_EQ : thm
  HOMEOMORPHIC_CONTRACTIBLE : thm
  CONTRACTIBLE_TRANSLATION : thm
  CONTRACTIBLE_INJECTIVE_LINEAR_IMAGE : thm
  HOMEOMORPHISM_CONTRACTIBILITY : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPVZ [HolBase] (D : PathsDeps) (BVE : PVE) (BVV : PVV) (BVY : PVY) :
    ExceptT String IO PVZ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, add_linear_invariants, add_translation_invariants,
        .. } := D.cvx
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART, IMP_CONJ, .. } :=
    D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, PASTECART_IN_PCROSS,
        PCROSS_EMPTY, .. } := D.cvx.core3
  let { SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUBSET,
        HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { PASTECART_FST_SND, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY, .. } := D.pmet2
  let { CONTINUOUS_ON_PASTECART, HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ, .. } := D.ptop3
  let { HOMEOMORPHIC_TRANSLATION, .. } := D.ptop4
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := BVE
  let { homotopy_equivalent, HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN,
        HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT, .. } := BVV
  let { contractible, CONTRACTIBLE_SPACE_EUCLIDEAN, HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS,
        CONTRACTIBLE_EMPTY, CONTRACTIBLE_SING, .. } := BVY
  -- @@SCOPE END

  let CONTRACTIBLE_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        contractible s /\ contractible t ==> contractible(s PCROSS t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [contractible, HOMOTOPIC_WITH_EUCLIDEAN] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"h:real^(1,M)finite_sum->real^M"] THEN
    REPEAT DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"k:real^(1,N)finite_sum->real^N"] THEN
    REPEAT DISCH_TAC THEN
    EXISTS_TAC (← q r"pastecart (a:real^M) (b:real^N)") THEN
    EXISTS_TAC (← q r"\z. pastecart
                     ((h:real^(1,M)finite_sum->real^M)
                      (pastecart (fstcart z) (fstcart(sndcart z))))
                     ((k:real^(1,N)finite_sum->real^N)
                      (pastecart (fstcart z) (sndcart(sndcart z))))") THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, FORALL_PASTECART, PASTECART_IN_PCROSS,
                 FSTCART_PASTECART, SNDCART_PASTECART] THEN
    MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN CONJ_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_PASTECART, LINEAR_CONTINUOUS_ON,
             LINEAR_FSTCART, LINEAR_SNDCART, CONTINUOUS_ON_ID,
             ← GSYM o_DEF, CONTINUOUS_ON_COMPOSE] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART] THEN
    SIMP_TAC [PASTECART_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART])

  let CONTRACTIBLE_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        contractible(s PCROSS t) <=>
        s = {} \/ t = {} \/ contractible s /\ contractible t"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONTRACTIBLE_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, CONTRACTIBLE_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [CONTRACTIBLE_PCROSS] THEN
    REWRITE_TAC [contractible, HOMOTOPIC_WITH_EUCLIDEAN, LEFT_IMP_EXISTS_THM] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"a:real^M", ← q r"b:real^N",
      ← q r"h:real^(1,(M,N)finite_sum)finite_sum->real^(M,N)finite_sum"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(a:real^M) IN s /\ (b:real^N) IN t") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM PASTECART_IN_PCROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
      ASM_MESON_TAC [ENDS_IN_UNIT_INTERVAL],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [EXISTS_TAC (← q r"a:real^M") THEN
      EXISTS_TAC
       (← q r"fstcart o
        (h:real^(1,(M,N)finite_sum)finite_sum->real^(M,N)finite_sum) o
        (\z. pastecart (fstcart z) (pastecart (sndcart z) b))"),
      EXISTS_TAC (← q r"b:real^N") THEN
      EXISTS_TAC
       (← q r"sndcart o
        (h:real^(1,(M,N)finite_sum)finite_sum->real^(M,N)finite_sum) o
        (\z. pastecart (fstcart z) (pastecart a (sndcart z)))")] THEN
    ASM_REWRITE_TAC [o_THM, FSTCART_PASTECART, SNDCART_PASTECART,
                    SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS, o_THM] THEN
    (CONJ_TAC THENL
      [ALL_TAC,  ASM_MESON_TAC [PASTECART_FST_SND, PASTECART_IN_PCROSS]]) THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
             LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
    ASM_SIMP_TAC [FSTCART_PASTECART, SNDCART_PASTECART, PASTECART_IN_PCROSS])

  let HOMOTOPY_EQUIVALENT_EMPTY ← prove
   r"(!s. (s:real^M->bool) homotopy_equivalent ({}:real^N->bool) <=> s = {}) /\
   (!t. ({}:real^M->bool) homotopy_equivalent (t:real^N->bool) <=> t = {})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS, CONTRACTIBLE_EMPTY] THEN
    REWRITE_TAC [homotopy_equivalent] THEN SET_TAC [])

  let HOMOTOPY_EQUIVALENT_CONTRACTIBILITY ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homotopy_equivalent t ==> (contractible s <=> contractible t)"
   (REWRITE_TAC [← GSYM HOMOTOPY_EQUIVALENT_SPACE_EUCLIDEAN,
                ← GSYM CONTRACTIBLE_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY])

  let HOMOTOPY_EQUIVALENT_SING ← prove
   r"!s:real^M->bool a:real^N.
        s homotopy_equivalent {a} <=> ~(s = {}) /\ contractible s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [HOMOTOPY_EQUIVALENT_EMPTY, NOT_INSERT_EMPTY] THEN
    EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP HOMOTOPY_EQUIVALENT_CONTRACTIBILITY) THEN
      REWRITE_TAC [CONTRACTIBLE_SING],
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPY_EQUIVALENT_CONTRACTIBLE_SETS THEN
      ASM_REWRITE_TAC [CONTRACTIBLE_SING, NOT_INSERT_EMPTY]])

  let HOMEOMORPHIC_CONTRACTIBLE_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t ==> (contractible s <=> contractible t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMOTOPY_EQUIVALENT_CONTRACTIBILITY THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT])

  let HOMEOMORPHIC_CONTRACTIBLE ← prove
   r"!s:real^M->bool t:real^N->bool.
        s homeomorphic t /\ contractible s ==> contractible t"
   (MESON_TAC [HOMEOMORPHIC_CONTRACTIBLE_EQ])

  let CONTRACTIBLE_TRANSLATION ← prove
   r"!a:real^N s. contractible (IMAGE (\x. a + x) s) <=> contractible s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONTRACTIBLE_EQ THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
    REWRITE_TAC [HOMEOMORPHIC_TRANSLATION])

  add_translation_invariants [CONTRACTIBLE_TRANSLATION]

  let CONTRACTIBLE_INJECTIVE_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (contractible (IMAGE f s) <=> contractible s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONTRACTIBLE_EQ THEN
    ASM_MESON_TAC [HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ,
                  HOMEOMORPHIC_REFL])

  add_linear_invariants [CONTRACTIBLE_INJECTIVE_LINEAR_IMAGE]

  let HOMEOMORPHISM_CONTRACTIBILITY ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (contractible(IMAGE f k) <=> contractible k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_CONTRACTIBLE_EQ THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  return { CONTRACTIBLE_PCROSS, CONTRACTIBLE_PCROSS_EQ, HOMOTOPY_EQUIVALENT_EMPTY,
           HOMOTOPY_EQUIVALENT_CONTRACTIBILITY, HOMOTOPY_EQUIVALENT_SING,
           HOMEOMORPHIC_CONTRACTIBLE_EQ, HOMEOMORPHIC_CONTRACTIBLE, CONTRACTIBLE_TRANSLATION,
           CONTRACTIBLE_INJECTIVE_LINEAR_IMAGE, HOMEOMORPHISM_CONTRACTIBILITY }

