@[nospecialize]
def setupPTZ [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BS : PTS) (BT : PTT)
    (BW : PTW) : ExceptT String IO PTZ := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { IMP_CONJ, .. } := D.cvx.core2
  let { IN_INTER, LEFT_IMP_EXISTS_THM, .. } := D.cvx.core3
  let { REAL_LT_01, .. } := D.cvx.core4
  let { SUBSET_INTER, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { OPEN_IN_INTER, .. } := D.cvx.met
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_IN, .. } :=
    D.cvx.top1
  let { COMPACT_IMP_CLOSED, CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { OPEN_BALL, OPEN_CONTAINS_CBALL, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, .. } := D.cvx.top5
  let { COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED,
