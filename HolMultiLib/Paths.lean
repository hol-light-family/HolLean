    ASM_CASES_TAC (← q r"s INTER u:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"{}:real^N->bool") THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_EMPTY, OPEN_IN_EMPTY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
