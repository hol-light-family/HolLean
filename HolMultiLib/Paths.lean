    DISCH_TAC THEN ONCE_REWRITE_TAC [DIMENSION_LE_EQ] THEN
    CONJ_TAC THENL [INT_ARITH_TAC, ALL_TAC] THEN
    X_GEN_TAC (← q r"w:real^(M,N)finite_sum->bool") THEN SIMP_TAC [FORALL_PASTECART] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^N"] THEN
