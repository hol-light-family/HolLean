        REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE [NORM_REAL, ← GSYM drop, DROP_SUB]) THEN
        REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"n:num") THEN
        ASM_REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THENL
         [MAP_EVERY UNDISCH_TAC
           [← q r"interval[w,z] INTER (s:num->real^1->bool) n = {}",
            ← q r"interval[u,w] DELETE u INTER (s:num->real^1->bool) n = {}",
            ← q r"interval[z,v] DELETE v INTER (s:num->real^1->bool) n = {}"] THEN
          REWRITE_TAC [IMP_IMP, ← SET_RULE
            (← q r"s1 INTER t = {} /\ s2 INTER t = {} <=>
             (s1 UNION s2) INTER t = {}")] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"t SUBSET s ==> s INTER u = {} ==> t INTER u = {}")) THEN
          REWRITE_TAC [SUBSET, IN_UNION, IN_DELETE,
                      ← GSYM DROP_EQ, IN_INTERVAL_1] THEN
          ASM_REAL_ARITH_TAC,
          RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"t:real^1->bool = {}") THENL
     [ASM_MESON_TAC [IN_IMAGE, NOT_IN_EMPTY], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"h = \x. (f:real^1->real^N)(@y. y IN t /\ segment(x,y) INTER t = {})") THEN
    SUBGOAL_THEN
     (← q r"!x y. y IN t /\ segment(x,y) INTER t = {} ==> h(x) = (f:real^1->real^N)(y)")
    ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!x y z. y IN t /\ segment(x,y) INTER t = {} /\
                z IN t /\ segment(x,z) INTER t = {}
