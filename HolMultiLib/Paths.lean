  -- @@SCOPE END

  let LOCALLY_FCCOVERABLE ← prove
   r"!s u a:real^N.
      (!e. &0 < e
           ==> ?c. FINITE c /\ UNIONS c = s /\
                   !t. t IN c
                       ==> connected t /\ bounded t /\ diameter t <= e) /\
      open_in (subtopology euclidean s) u /\ a IN u
      ==> ?v. open_in (subtopology euclidean s) v /\ connected v /\
              a IN v /\ v SUBSET u /\
              !e. &0 < e
                  ==> ?c. FINITE c /\ UNIONS c = v /\
                          !t. t IN c
                              ==> connected t /\ bounded t /\ diameter t <= e"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_CBALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:real^N"))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← MESON [← REAL_ARITH (← q r"&0 < e ==> &0 < e / &2 /\ &2 * e / &2 = e")]
         (← q r"(?e. &0 < e /\ P e) ==> ?r. &0 < r /\ P(&2 * r)"))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC
     (← q r"t = \k. {x | ?f. (!i. i <= k
                            ==> connected(f i) /\ f i SUBSET s /\
                                bounded(f i) /\ diameter(f i) < r / &2 pow i) /\
                       a IN f 0 /\ (x:real^N) IN f k /\
                       (!i. i < k ==> ~(f i INTER f(SUC i) = {}))}") THEN
    EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
    SUBGOAL_THEN (← q r"!k. a IN (t:num->real^N->bool) k") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"k:num") THEN EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"\i:num. {a:real^N}") THEN
      ASM_REWRITE_TAC [CONNECTED_SING, SING_SUBSET, BOUNDED_SING] THEN
      REWRITE_TAC [IN_SING, DIAMETER_SING] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!k. (t:num->real^N->bool) k SUBSET s") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"k:num") THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [IN_ELIM_THM, SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN
      DISCH_THEN (CHOOSE_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"k:num")) ASSUME_TAC)) THEN
      REWRITE_TAC [LE_REFL] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!k. (t:num->real^N->bool) k SUBSET ball(a,&2 * r)")
    ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!k. (t:num->real^N->bool) k SUBSET ball(a,(&2 - inv(&2 pow k)) * r)")
      MP_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
        MATCH_MP_TAC SUBSET_BALL THEN
        ASM_SIMP_TAC [REAL_LE_RMUL_EQ, ← REAL_ARITH (← q r"x - a <= x <=> &0 <= a")] THEN
        SIMP_TAC [REAL_POW_LE, REAL_POS, REAL_LE_INV_EQ]] THEN
      MATCH_MP_TAC num_INDUCTION THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM, REAL_MUL_LID] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [LE, LT, FORALL_UNWIND_THM2] THEN
        X_GEN_TAC (← q r"b:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [IN_BALL] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REAL_ARITH (← q r"x < r / &2 pow 0 ==> a <= x ==> a < r"))) THEN
        MATCH_MP_TAC DIST_LE_DIAMETER THEN ASM_REWRITE_TAC [],
        X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"c:real^N") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"~(f k INTER f(SUC k):real^N->bool = {})") MP_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^N")) THEN ANTS_TAC THENL
         [EXISTS_TAC (← q r"f:num->real^N->bool") THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
          REWRITE_TAC [IN_BALL]] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"!u. dist(b,c) <= u /\ x + u <= y
              ==> dist(a:real^N,b) < x ==> dist(a,c) < y")) THEN
        EXISTS_TAC (← q r"diameter((f:num->real^N->bool) (SUC k))") THEN
        ASM_SIMP_TAC [DIST_LE_DIAMETER, LE_REFL] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"r * k = r * &2 * k' /\ d < r * k'
          ==> (&2 - k) * r + d <= (&2 - k') * r")) THEN
        ASM_SIMP_TAC [← GSYM real_div, LE_REFL] THEN
        REWRITE_TAC [real_pow, real_div, REAL_INV_MUL] THEN REAL_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!k. (t:num->real^N->bool) k SUBSET t(SUC k)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"k:num") THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"b:real^N") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\i. if i <= k then (f:num->real^N->bool) i else {b}") THEN
      ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC k <= k)"), IN_SING] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num <= k") THEN
      ASM_SIMP_TAC [LT_SUC_LE] THENL
       [ASM_MESON_TAC [],
        REWRITE_TAC [CONNECTED_SING, IN_SING, BOUNDED_SING] THEN
        DISCH_TAC THEN ASM_REWRITE_TAC [FORALL_UNWIND_THM2, DIAMETER_SING] THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2] THEN ASM_MESON_TAC [LE_REFL],
        ASM_SIMP_TAC [← ARITH_RULE (← q r"i <= k ==> (SUC i <= k <=> ~(i = k))")] THEN
        REWRITE_TAC [COND_SWAP] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
         [ASM SET_TAC [], FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!k. connected((t:num->real^N->bool) k)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"k:num") THEN
      REWRITE_TAC [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
      MATCH_MP_TAC (← MESON [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS]
       (← q r"!a. (!x. x IN s ==> connected_component s a x)
            ==> (!x y. x IN s /\ y IN s ==> connected_component s x y)")) THEN
      EXISTS_TAC (← q r"a:real^N") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
      MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN EXPAND_TAC "t" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"connected_component (f 0) (a:real^N) x") MP_TAC THENL
         [REWRITE_TAC [connected_component] THEN
          EXISTS_TAC (← q r"f 0:real^N->bool") THEN
          ASM_SIMP_TAC [LE_REFL, SUBSET_REFL],
          MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s x ==> t x")) THEN
          REWRITE_TAC [ETA_AX]] THEN
        MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"f:num->real^N->bool") THEN
        ASM_REWRITE_TAC [← GSYM SUBSET],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"c:real^N") THEN
      FIRST_ASSUM (fun th =>
        tactic_of do pure (GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [← SYM th])) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"~(f k INTER f(SUC k):real^N->bool = {})") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:real^N") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^N")) THEN ANTS_TAC THENL
       [EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"f:num->real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        MATCH_MP_TAC (← SET_RULE
         (← q r"connected_component k a SUBSET connected_component k' a /\
          (connected_component k' a b ==> connected_component k' a c)
          ==> connected_component k a b ==> connected_component k' a c"))] THEN
      ASM_SIMP_TAC [CONNECTED_COMPONENT_MONO] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CONNECTED_COMPONENT_TRANS) THEN
      REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"f(SUC k):real^N->bool") THEN
      ASM_SIMP_TAC [LE_REFL] THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"f:num->real^N->bool") THEN
      ASM_REWRITE_TAC [← GSYM SUBSET],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      REWRITE_TAC [FORALL_IN_UNIONS, FORALL_IN_GSPEC,
                  IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      X_GEN_TAC (← q r"k:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      X_GEN_TAC (← q r"x:real^N") THEN FIRST_ASSUM (fun th =>
        tactic_of do pure (GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [← SYM th])) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FCCOVERABLE_IMP_LOCALLY_CONNECTED) THEN
      REWRITE_TAC [LOCALLY_CONNECTED] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"s INTER ball(x:real^N,r / &2 pow (k + 3))", ← q r"x:real^N"]) THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL] THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [SUBSET, LE_REFL], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
      REWRITE_TAC [SUBSET_INTER, UNIONS_GSPEC] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"SUC k") THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"\i. if i <= k then (f:num->real^N->bool) i else v") THEN
      ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC k <= k)"), IN_SING] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num <= k") THEN
      ASM_SIMP_TAC [LT_SUC_LE] THENL
       [DISCH_TAC THEN CONJ_TAC THENL
         [ASM_MESON_TAC [BOUNDED_SUBSET, BOUNDED_BALL], ALL_TAC] THEN
        TRANS_TAC REAL_LET_TRANS (← q r"r / &2 pow (k + 2)") THEN CONJ_TAC THENL
         [TRANS_TAC REAL_LE_TRANS
           (← q r"diameter(ball(x:real^N,r / &2 pow (k + 3)))") THEN
          ASM_SIMP_TAC [DIAMETER_SUBSET, BOUNDED_BALL] THEN
          ASM_SIMP_TAC [DIAMETER_BALL, REAL_LT_DIV, REAL_LT_POW2,
                       ← REAL_ARITH (← q r"&0 < x ==> ~(x < &0)")] THEN
          REWRITE_TAC [REAL_POW_ADD, real_div, REAL_INV_MUL] THEN
          REAL_ARITH_TAC,
          ASM_SIMP_TAC [real_div, REAL_LT_LMUL_EQ] THEN
          MATCH_MP_TAC REAL_LT_INV2 THEN REWRITE_TAC [REAL_LT_POW2] THEN
          MATCH_MP_TAC REAL_POW_MONO_LT THEN REWRITE_TAC [REAL_OF_NUM_LT] THEN
          ASM_ARITH_TAC],
        ASM_SIMP_TAC [← ARITH_RULE (← q r"i <= k ==> (SUC i <= k <=> ~(i = k))")] THEN
        REWRITE_TAC [COND_SWAP] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
         [ASM SET_TAC [], FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]],
      MATCH_MP_TAC CONNECTED_UNIONS THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM SET_TAC [],
      ASM SET_TAC [],
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
      X_GEN_TAC (← q r"k:num") THEN
      TRANS_TAC SUBSET_TRANS (← q r"s INTER cball(a:real^N,&2 * r)") THEN
      ASM_REWRITE_TAC [SUBSET_INTER] THEN
      ASM_MESON_TAC [SUBSET_TRANS, INTER_COMM, BALL_SUBSET_CBALL],
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"?k. r / &2 pow k < e / &4") STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
      ASM_SIMP_TAC [REAL_INV_POW, ← GSYM REAL_LT_RDIV_EQ] THEN
      MATCH_MP_TAC REAL_ARCH_POW_INV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 < (&1 / &4 * x) / y <=> &0 < x / y")] THEN
      ASM_SIMP_TAC [REAL_LT_DIV],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?ws. FINITE ws /\ (t:num->real^N->bool) k SUBSET UNIONS ws /\
           !w. w IN ws
               ==> w SUBSET s /\ ~(t k INTER w = {}) /\
                   connected w /\ bounded w /\ diameter w < r / &2 pow (k + 1)")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r / &2 pow (k + 2)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"ws:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{w:real^N->bool | w IN ws /\ ~(t(k:num) INTER w = {})}") THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, FORALL_IN_GSPEC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"w:real^N->bool") THEN REPEAT STRIP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      TRANS_TAC REAL_LET_TRANS (← q r"r / &2 pow (k + 2)") THEN
      ASM_SIMP_TAC [] THEN
      REWRITE_TAC [REAL_POW_ADD, real_div, REAL_INV_MUL] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < r / k
        ==> r * inv k * inv(&2 pow 2) < r * inv k * inv(&2 pow 1)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_POW2],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!w:real^N->bool. w IN ws ==> w SUBSET t(SUC k)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"w:real^N->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~((t:num->real^N->bool) k INTER w = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"y:real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:num->real^N->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"\i. if i <= k then (f:num->real^N->bool) i else w") THEN
      ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC k <= k)")] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num <= k") THEN
      ASM_SIMP_TAC [LT_SUC_LE] THENL
       [DISCH_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] REAL_LTE_TRANS)) THEN
