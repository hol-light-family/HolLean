                           open_in (subtopology euclidean t) v /\
                           homeomorphism (u,v) (f,q))
          ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [HOMEOMORPHISM, NOT_IN_EMPTY, CONTINUOUS_ON_EMPTY] THEN
      SET_TAC [],
      STRIP_TAC] THEN
    MATCH_MP_TAC COVERING_SPACE_HOMEOMORPHISM THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC PROPER_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP SIMPLY_CONNECTED_IMP_CONNECTED) THEN
    REWRITE_TAC [CONNECTED_CLOPEN] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) s")) THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN DISCH_THEN MATCH_MP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:real^M->bool")) THEN
    REWRITE_TAC [OPEN_IN_REFL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP PROPER_MAP o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_SIMP_TAC [CLOSED_IN_REFL] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP) THEN
    REWRITE_TAC [OPEN_IN_REFL])

  let CLOSED_LOCAL_HOMEOMORPHISM_GLOBAL ← prove
   r"!f:real^M->real^N s t.
          path_connected s /\ simply_connected t /\ (s = {} ==> t = {}) /\
          (!c. closed_in (subtopology euclidean s) c
               ==> closed_in (subtopology euclidean t) (IMAGE f c)) /\
          (!x. x IN s
               ==> ?u v g. x IN u /\
                           open_in (subtopology euclidean s) u /\
                           open_in (subtopology euclidean t) v /\
                           homeomorphism (u,v) (f,g))
          ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [HOMEOMORPHISM, NOT_IN_EMPTY, CONTINUOUS_ON_EMPTY] THEN
      SET_TAC [],
      STRIP_TAC] THEN
    MATCH_MP_TAC COVERING_SPACE_HOMEOMORPHISM THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN
      ASM_CASES_TAC (← q r"connected_component s (x:real^M) = {}") THEN
      ASM_REWRITE_TAC [NOT_INSERT_EMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [CONNECTED_COMPONENT_EQ_EMPTY]) THEN
      ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT_SET,
                    PATH_CONNECTED_IMP_CONNECTED],
      FIRST_ASSUM (MP_TAC o MATCH_MP SIMPLY_CONNECTED_IMP_CONNECTED) THEN
      REWRITE_TAC [CONNECTED_CLOPEN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (f:real^M->real^N) s")) THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [CLOSED_IN_REFL] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP LOCAL_HOMEOMORPHISM_IMP_OPEN_MAP) THEN
      REWRITE_TAC [OPEN_IN_REFL]])

  let PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP ← prove
   r"!p:real^M->real^N c s.
          p continuous_on c /\ IMAGE p c = s /\
          (!k. k SUBSET s /\ compact k ==> compact {x | x IN c /\ p x IN k}) /\
          (!u. open_in (subtopology euclidean c) u
               ==> open_in (subtopology euclidean s) (IMAGE p u)) /\
          (!x. x IN c
               ==> ?t. x IN t /\ open_in (subtopology euclidean c) t /\
                       (!y z. y IN t /\ z IN t /\ p y = p z ==> y = z))
          ==> covering_space (c,p) s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PROPER_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"IMAGE (p:real^M->real^N) t") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [OPEN_IN_TRANS],
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
        ASM SET_TAC []]])

  let PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP_GEN ← prove
   r"!p:real^M->real^N c s.
          p continuous_on c /\ IMAGE p c = s /\
          (!k. k SUBSET s /\ compact k ==> compact {x | x IN c /\ p x IN k}) /\
          (!u. open_in (subtopology euclidean c) u
               ==> open_in (subtopology euclidean c)
                           {x | x IN c /\ p x IN IMAGE p u}) /\
          (!x. x IN c
               ==> ?t. x IN t /\ open_in (subtopology euclidean c) t /\
                       (!y z. y IN t /\ z IN t /\ p y = p z ==> y = z))
          ==> covering_space (c,p) s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_MAP_IMP_OPEN_MAP THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [PROPER_MAP, SUBSET_REFL])

  let PROPER_LOCALLY_INJECTIVE_OPEN_IMP_HOMEOMORPHISM ← prove
   r"!f:real^M->real^N s t.
          path_connected s /\ simply_connected t /\
          f continuous_on s /\ IMAGE f s = t /\
          (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
          (!u. open_in (subtopology euclidean s) u
               ==> open_in (subtopology euclidean t) (IMAGE f u)) /\
          (!x. x IN s
               ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                       !y z. y IN u /\ z IN u /\ f y = f z ==> y = z)
          ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_HOMEOMORPHISM THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP THEN
    ASM_REWRITE_TAC [])

  let PROPER_LOCALLY_INJECTIVE_OPEN_IMP_HOMEOMORPHISM_GEN ← prove
   r"!f:real^M->real^N s t.
          path_connected s /\ simply_connected t /\
          f continuous_on s /\ IMAGE f s = t /\
          (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
          (!u. open_in (subtopology euclidean s) u
               ==> open_in (subtopology euclidean s)
                           {x | x IN s /\ f x IN IMAGE f u}) /\
          (!x. x IN s
               ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                       !y z. y IN u /\ z IN u /\ f y = f z ==> y = z)
          ==> ?g. homeomorphism (s,t) (f,g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_HOMEOMORPHISM THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP_GEN THEN
    ASM_REWRITE_TAC [])

  return { CLOSED_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP, PROPER_LOCAL_HOMEOMORPHISM_GLOBAL,
           CLOSED_LOCAL_HOMEOMORPHISM_GLOBAL, PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP,
           PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP_GEN,
           PROPER_LOCALLY_INJECTIVE_OPEN_IMP_HOMEOMORPHISM,
           PROPER_LOCALLY_INJECTIVE_OPEN_IMP_HOMEOMORPHISM_GEN }

/- ------------------------------------------------------------------------- -/
/- A simply connected covering space is universal.  (paths.ml 26624-26892)   -/
/- ------------------------------------------------------------------------- -/

structure PXC where
  UNIVERSAL_COVERING_SPACE : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXC [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BK : PTK) (BS : PTS) (BUG : PUG)
    (BVI : PVI) (BWR : PWR) (BWS : PWS) (BWU : PWU) (BWX : PWX) : ExceptT String IO PXC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, DE_MORGAN_THM, DISJOINT, EQ_IMP, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IN, INTER_UNIONS,
        IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, PAIRWISE_IMP, .. } := D.cvx.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL, .. } :=
    D.cvx.core5
  let { UNIONS_INSERT, o_DEF, o_THM, pairwise, .. } := D.cvx.core6
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
        OPEN_IN_TRANS, .. } := D.cvx.met
  let { CONNECTED_COMPONENT_SUBSET, CONNECTED_CONTINUOUS_IMAGE, CONNECTED_OPEN_IN, .. } :=
    D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_OF_SUBSETS, HOMEOMORPHISM_SYM, .. } := D.cvx.top4
  let { OPEN_IN_REFL, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { INTER_UNIONS_PAIRWISE_DISJOINT, .. } := D.pses1
  let { PAIRWISE_IMAGE, PAIRWISE_MONO, UNIONS_1, UNION_OVER_INTER, .. } := D.pses2
  let { OPEN_IN_UNIONS, .. } := D.pmet2
  let { CONNECTED_COMPONENT_REFL_EQ, CONNECTED_CONNECTED_COMPONENT, .. } := D.ptop2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET,
        HOMEOMORPHIC_CONNECTEDNESS, .. } := D.ptop3
  let { HOMEOMORPHISM_EQ, LOCALLY_INTER_OPEN, LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { path_image, PATH_CONTINUOUS_IMAGE, .. } := BA
  let { PATHFINISH_IN_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
        PATH_IMAGE_COMPOSE, .. } := BB
  let { path_connected, .. } := BK
  let { LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED,
        OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED, .. } := BS
  let { PATH_CONNECTED_EQ_CONNECTED_LPC, .. } := BUG
  let { HOMOTOPIC_PATHS_EQ, .. } := BVI
  let { covering_space, COVERING_SPACE_IMP_SURJECTIVE, .. } := BWR
  let { COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ, .. } := BWS
  let { COVERING_SPACE_LIFT_PATH_STRONG, COVERING_SPACE_MONODROMY, .. } := BWU
  let { COVERING_SPACE_LIFT_STRONG, .. } := BWX
  -- @@SCOPE END

  let UNIVERSAL_COVERING_SPACE ← prove
   r"!c p:real^M->real^P c' p':real^N->real^P s.
          covering_space (c,p) s /\ covering_space (c',p') s /\
          locally path_connected c /\ simply_connected c /\ connected c'
          ==> ?q. covering_space (c,q) c' /\ !x. x IN c ==> p'(q x) = p x"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^P->bool = {}") THENL
     [ASM_SIMP_TAC [covering_space, IMAGE_EQ_EMPTY, NOT_IN_EMPTY] THEN
      REWRITE_TAC [CONTINUOUS_ON_EMPTY],
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:real^P") o
        GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"path_connected(c':real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ,
                    PATH_CONNECTED_EQ_CONNECTED_LPC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"locally connected (s:real^P->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED,
                    COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?b:real^M b':real^N.
          b IN c /\ b' IN c' /\ (p:real^M->real^P) b = a /\ p' b' = a")
    STRIP_ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"p':real^N->real^P", ← q r"c':real^N->bool", ← q r"s:real^P->bool",
      ← q r"p:real^M->real^P", ← q r"c:real^M->bool", ← q r"b':real^N", ← q r"b:real^M"]
          COVERING_SPACE_LIFT_STRONG) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [covering_space, SUBSET_REFL], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q:real^M->real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [covering_space] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      REWRITE_TAC [SUBSET, IN_IMAGE] THEN X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"b':real^N", ← q r"z:real^N"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g':real^1->real^N") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"p:real^M->real^P", ← q r"c:real^M->bool",
                     ← q r"s:real^P->bool",
                     ← q r"(p':real^N->real^P) o (g':real^1->real^N)", ← q r"b:real^M"]
        COVERING_SPACE_LIFT_PATH_STRONG) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATH_IMAGE_COMPOSE] THEN
        CONJ_TAC THENL [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE, ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THENL
         [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []],
        REWRITE_TAC [o_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^M") STRIP_ASSUME_TAC)] THEN
      MP_TAC (← ISPECL [← q r"p':real^N->real^P", ← q r"c':real^N->bool",
                     ← q r"s:real^P->bool",
                     ← q r"(p':real^N->real^P) o (g':real^1->real^N)",
                     ← q r"(p':real^N->real^P) o q o (g:real^1->real^M)",
                     ← q r"g':real^1->real^N",
                     ← q r"(q:real^M->real^N) o (g:real^1->real^M)"]
        COVERING_SPACE_MONODROMY) THEN
      ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [o_THM, PATH_IMAGE_COMPOSE] THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
          MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN CONJ_TAC THENL
           [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
            RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
            ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
            REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o
             GEN_REWRITE_RULE id [covering_space])) THEN
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC []],
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
          MATCH_MP_TAC HOMOTOPIC_PATHS_EQ THEN ASM_SIMP_TAC [o_THM] THEN
          REPEAT CONJ_TAC THENL
           [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
            RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
            ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
            REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN
            RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
            RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN ASM SET_TAC []],
          MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC []],
        DISCH_THEN SUBST1_TAC THEN
        EXISTS_TAC (← q r"pathfinish(g:real^1->real^M)") THEN
        ASM_MESON_TAC [PATHFINISH_IN_PATH_IMAGE, SUBSET]],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?t vv vv'.
          connected t /\
          open_in (subtopology euclidean s) t /\
          (p':real^N->real^P) z IN t /\
          UNIONS vv = {x:real^M | x IN c /\ p x IN t} /\
          (!u. u IN vv ==> open_in (subtopology euclidean c) u) /\
          pairwise DISJOINT vv /\
          (!u. u IN vv ==> (?r. homeomorphism (u,t) (p,r))) /\
          UNIONS vv' = {x:real^N | x IN c' /\ p' x IN t} /\
          (!u. u IN vv' ==> open_in (subtopology euclidean c') u) /\
          pairwise DISJOINT vv' /\
          (!u. u IN vv' ==> (?r'. homeomorphism (u,t) (p',r')))")
    STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"covering_space (c,p:real^M->real^P) s") THEN
      REWRITE_TAC [covering_space] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(p':real^N->real^P) z")) THEN ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
        ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^P->bool") MP_TAC) THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"vv:(real^M->bool)->bool")
          STRIP_ASSUME_TAC)] THEN
      UNDISCH_TAC (← q r"covering_space (c',p':real^N->real^P) s") THEN
      REWRITE_TAC [covering_space] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(p':real^N->real^P) z")) THEN ANTS_TAC THENL
       [ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"t':real^P->bool") MP_TAC) THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"vv':(real^N->bool)->bool")
          STRIP_ASSUME_TAC)] THEN
      ABBREV_TAC
        (← q r"u = connected_component (t INTER t') ((p':real^N->real^P) z)") THEN
      SUBGOAL_THEN (← q r"(u:real^P->bool) SUBSET t INTER t'") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET], ALL_TAC] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"u:real^P->bool",
        ← q r"{{x | x IN v /\ (p:real^M->real^P) x IN u} | v IN vv}",
        ← q r"{{x | x IN v /\ (p':real^N->real^P) x IN u} | v IN vv'}"] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT],
        MATCH_MP_TAC OPEN_IN_TRANS THEN
        EXISTS_TAC (← q r"t INTER t':real^P->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_INTER] THEN EXPAND_TAC "u" THEN
        MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED THEN
        ASM_MESON_TAC [LOCALLY_INTER_OPEN, LOCALLY_OPEN_SUBSET],
        REWRITE_TAC [IN] THEN EXPAND_TAC "u" THEN
        REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
        ASM_REWRITE_TAC [IN_INTER],
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN v /\ P x} = v INTER {x | P x}")] THEN
        ASM_REWRITE_TAC [← GSYM INTER_UNIONS] THEN ASM SET_TAC [],
        REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET THEN
        EXISTS_TAC (← q r"s:real^P->bool") THEN ASM_SIMP_TAC [SUBSET_REFL] THEN
        MATCH_MP_TAC OPEN_IN_TRANS THEN
        EXISTS_TAC (← q r"t INTER t':real^P->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_INTER] THEN EXPAND_TAC "u" THEN
        MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED THEN
        ASM_MESON_TAC [LOCALLY_INTER_OPEN, LOCALLY_OPEN_SUBSET],
        REWRITE_TAC [PAIRWISE_IMAGE, SIMPLE_IMAGE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          PAIRWISE_IMP)) THEN SET_TAC [],
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"v:real^M->bool") THEN DISCH_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^M->bool"))) THEN
        ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let _ ← liftExcept (check HolCore.Basics.is_exists (concl th))
          pure (MP_TAC th)) THEN
        MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
        DISCH_THEN (fun th => tactic_of do
          pure (STRIP_ASSUME_TAC (← REWRITE_RULE [homeomorphism] th) THEN
          MP_TAC th THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
            HOMEOMORPHISM_OF_SUBSETS))) THEN ASM SET_TAC [],
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN v /\ P x} = v INTER {x | P x}")] THEN
        ASM_REWRITE_TAC [← GSYM INTER_UNIONS] THEN ASM SET_TAC [],
        REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_SUBSET THEN
        EXISTS_TAC (← q r"s:real^P->bool") THEN ASM_SIMP_TAC [SUBSET_REFL] THEN
        MATCH_MP_TAC OPEN_IN_TRANS THEN
        EXISTS_TAC (← q r"t INTER t':real^P->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_INTER] THEN EXPAND_TAC "u" THEN
        MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED THEN
        ASM_MESON_TAC [LOCALLY_INTER_OPEN, LOCALLY_OPEN_SUBSET],
        REWRITE_TAC [PAIRWISE_IMAGE, SIMPLE_IMAGE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          PAIRWISE_IMP)) THEN SET_TAC [],
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^N->bool"))) THEN
        ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          let _ ← liftExcept (check HolCore.Basics.is_exists (concl th))
          pure (MP_TAC th)) THEN
        MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
        DISCH_THEN (fun th => tactic_of do
          pure (STRIP_ASSUME_TAC (← REWRITE_RULE [homeomorphism] th) THEN
          MP_TAC th THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
            HOMEOMORPHISM_OF_SUBSETS))) THEN ASM SET_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?v':real^N->bool. v' IN vv' /\ z IN v'") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"v' SUBSET {x | x IN c' /\ (p':real^N->real^P) x IN t}")
    ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"open_in (subtopology euclidean c') (v':real^N->bool) /\
                  ?r':real^P->real^N. homeomorphism (v',t) (p',r')")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"v':real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"!u. u IN vv ==> ?u'. u' IN vv' /\ IMAGE (q:real^M->real^N) u SUBSET u'")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"IMAGE (q:real^M->real^N) u SUBSET UNIONS vv'") MP_TAC THENL
       [ASM_REWRITE_TAC [IN_ELIM_THM, SUBSET, FORALL_IN_IMAGE] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"~(UNIONS uu = {}) /\
        (!u. u IN uu
                ==> DISJOINT s u \/ DISJOINT s (UNIONS(uu DELETE u)))
        ==> s SUBSET UNIONS uu ==> ?u. u IN uu /\ s SUBSET u")) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"v:real^N->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"connected(IMAGE (q:real^M->real^N) u)") MP_TAC THENL
       [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN CONJ_TAC THENL
         [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, OPEN_IN_IMP_SUBSET], ALL_TAC] THEN
        UNDISCH_TAC (← q r"connected(t:real^P->bool)") THEN MATCH_MP_TAC EQ_IMP THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_CONNECTEDNESS THEN
        REWRITE_TAC [homeomorphic] THEN ASM_MESON_TAC [],
        REWRITE_TAC [CONNECTED_OPEN_IN, NOT_EXISTS_THM, ← TAUT
         (← q r"~(p /\ q /\ r /\ s /\ t) <=> p /\ q /\ r /\ s ==> ~t")] THEN
        REWRITE_TAC [DE_MORGAN_THM, DISJOINT]] THEN
      DISCH_THEN MATCH_MP_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
      CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"c':real^N->bool") THEN
        (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
        MATCH_MP_TAC OPEN_IN_INTER THEN ASM_SIMP_TAC [OPEN_IN_REFL] THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_SIMP_TAC [IN_DELETE],
        REWRITE_TAC [← GSYM UNION_OVER_INTER] THEN
        ASM_SIMP_TAC [← GSYM UNIONS_INSERT, ← SET_RULE
         (← q r"a IN s ==> a INSERT (s DELETE a) = s")] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"s INTER t = {} ==> (u INTER s) INTER (u INTER t) = {}")) THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM UNIONS_1] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) INTER_UNIONS_PAIRWISE_DISJOINT o
          lhand o snd) THEN
        ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> {a} UNION (s DELETE a) = s")] THEN
        SET_TAC []],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"{v:real^M->bool | v IN vv /\
                                  IMAGE (q:real^M->real^N) v SUBSET v'}") THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [ASM SET_TAC [], GEN_REWRITE_TAC id [SUBSET]] THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:real^M) IN UNIONS vv") MP_TAC THENL
       [ASM_REWRITE_TAC [] THEN ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^M->bool") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          PAIRWISE_MONO)) THEN SET_TAC [],
      X_GEN_TAC (← q r"v:real^M->bool") THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^M->bool"))) THEN
      ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"r:real^P->real^M")) THEN
      EXISTS_TAC (← q r"(r:real^P->real^M) o (p':real^N->real^P)") THEN
      MATCH_MP_TAC HOMEOMORPHISM_EQ THEN MAP_EVERY EXISTS_TAC
       [← q r"(r':real^P->real^N) o (p:real^M->real^P)",
        ← q r"(r:real^P->real^M) o (p':real^N->real^P)"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
        ASM_MESON_TAC [HOMEOMORPHISM_SYM],
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
        REWRITE_TAC [o_DEF] THEN ASM SET_TAC []]])

  return { UNIVERSAL_COVERING_SPACE }

/- ------------------------------------------------------------------------- -/
/- Size of fundamental group of a covering space.  (paths.ml 26893-27155)    -/
/- ------------------------------------------------------------------------- -/

structure PXD where
  CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE_ALT : thm
  CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE : thm
  COVERING_SPACE_SELF_FINITE_FUNDAMENTAL_GROUP : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXD [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BK : PTK) (BVI : PVI)
    (BVJ : PVJ) (BVK : PVK) (BVT : PVT) (BWR : PWR) (BWU : PWU) (BWV : PWV) :
    ExceptT String IO PXD := do
  -- @@SCOPE BEGIN
  let NUM_RING := D.NUM_RING
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, HAS_SIZE_CONV, SELECT_CONV, .. } :=
    D.cvx
  let { CARD_EQ_0, CONJ_ASSOC, ETA_AX, EXISTS_IN_GSPEC, FINITE_EMPTY, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FUN_EQ_THM, HAS_SIZE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_ELIM_PAIR_THM, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, PAIR_EQ, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.cvx.core5
  let { o_THM, .. } := D.cvx.core6
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { EXISTS_UNIQUE_DEF, .. } := D.pses1
  let { eq_c, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CARD_EQ_CARD_IMP, CARD_EQ_SYM, CARD_EQ_TRANS, CARD_FINITE_CONG, CARD_MUL_C,
        CARD_MUL_FINITE_EQ, EQ_C_BIJECTIONS, mul_c, .. } := D.pcard
  let { HOMEOMORPHISM_INJECTIVE_OPEN_MAP, .. } := D.ptop4
  let { pathfinish, PATH_CONTINUOUS_IMAGE, .. } := BA
  let { PATHFINISH_IN_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
        PATH_IMAGE_COMPOSE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { path_connected, .. } := BK
  let { HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_IMP_PATH,
        HOMOTOPIC_PATHS_IMP_SUBSET, HOMOTOPIC_PATHS_REFL, HOMOTOPIC_PATHS_SYM,
        HOMOTOPIC_PATHS_TRANS, HOMOTOPIC_PATHS_EQ, .. } := BVI
  let { HOMOTOPIC_PATHS_JOIN, HOMOTOPIC_PATHS_CONTINUOUS_IMAGE, .. } := BVJ
  let { HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_ASSOC, HOMOTOPIC_PATHS_RINV,
        HOMOTOPIC_PATHS_LINV, .. } := BVK
  let { fundamental_group, FUNDAMENTAL_GROUP_EQ_EMPTY,
        CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS, .. } := BVT
  let { covering_space, COVERING_SPACE_OPEN_MAP, .. } := BWR
  let { COVERING_SPACE_LIFT_PATH_STRONG, .. } := BWU
  let { COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL_EQ, .. } := BWV
  -- @@SCOPE END

  let CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE_ALT ← prove
   r"!p:real^M->real^N c s a.
          covering_space(c,p) s /\ path_connected c /\ a IN c
          ==> fundamental_group(s,p a) =_c
              {homotopic_paths c g |g| path g /\ path_image g SUBSET c /\
                                       pathstart g = a /\
                                       p(pathfinish g) = p a}"
   (← do
    let tac :=
      REPEAT
       (FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
        FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH)) THEN
      ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, PATH_CONTINUOUS_IMAGE], ALL_TAC] THEN
      REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN ASM SET_TAC []
    pure (
    REPEAT STRIP_TAC THEN REWRITE_TAC [fundamental_group] THEN
    ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN REWRITE_TAC [eq_c] THEN
    EXISTS_TAC (← q r"homotopic_paths s o ((o) (p:real^M->real^N)) o (@)") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, EXISTS_UNIQUE_DEF,
                ← GSYM CONJ_ASSOC, IMP_CONJ, o_THM, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"g:real^1->real^M") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"homotopic_paths (c:real^M->bool) g
                                    ((@) (homotopic_paths c g))")
      MP_TAC THENL
       [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
        CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
        ABBREV_TAC (← q r"h:real^1->real^M = (@) (homotopic_paths c g)") THEN
        ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN DISCH_TAC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"P q ==> homotopic_paths s q IN {homotopic_paths s p | P p}")) THEN
      tac,
      X_GEN_TAC (← q r"h:real^1->real^N") THEN STRIP_TAC THEN CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_PATH_STRONG)) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"h:real^1->real^N", ← q r"a:real^M"]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"g:real^1->real^M") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [pathfinish, ENDS_IN_UNIT_INTERVAL], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"homotopic_paths (c:real^M->bool) g
                                    ((@) (homotopic_paths c g))")
        MP_TAC THENL
         [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
          CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
          ABBREV_TAC (← q r"g':real^1->real^M = (@) (homotopic_paths c g)") THEN
          ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN DISCH_TAC] THEN
        ONCE_REWRITE_TAC [FUN_EQ_THM] THEN
        MATCH_MP_TAC (← MESON [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]
          (← q r"homotopic_paths s p q
           ==> !r. homotopic_paths s p r <=> homotopic_paths s q r")) THEN
        TRANS_TAC HOMOTOPIC_PATHS_TRANS
          (← q r"(p:real^M->real^N) o (g:real^1->real^M)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC HOMOTOPIC_PATHS_CONTINUOUS_IMAGE THEN
          EXISTS_TAC (← q r"c:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
          MATCH_MP_TAC HOMOTOPIC_PATHS_EQ THEN
          ASM_REWRITE_TAC [o_THM] THEN tac],
        X_GEN_TAC (← q r"g:real^1->real^M") THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        X_GEN_TAC (← q r"g':real^1->real^M") THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        SUBGOAL_THEN (← q r"homotopic_paths (c:real^M->bool) g
                                      ((@) (homotopic_paths c g))")
        MP_TAC THENL
         [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
          CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
          ABBREV_TAC (← q r"k:real^1->real^M = (@) (homotopic_paths c g)") THEN
          ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN DISCH_TAC] THEN
        SUBGOAL_THEN (← q r"homotopic_paths (c:real^M->bool) g'
                                      ((@) (homotopic_paths c g'))")
        MP_TAC THENL
         [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
          CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
          ABBREV_TAC (← q r"k':real^1->real^M = (@) (homotopic_paths c g')") THEN
          ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN DISCH_TAC] THEN
        DISCH_THEN (MP_TAC o C AP_THM
         (← q r"(p:real^M->real^N) o (k:real^1->real^M)")) THEN
        DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2)) THEN
        REWRITE_TAC [HOMOTOPIC_PATHS_REFL] THEN ANTS_TAC THENL [tac, ALL_TAC] THEN
        W (MP_TAC o PART_MATCH (lhand o rand)
          COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL_EQ o lhand o snd) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [tac, DISCH_THEN SUBST1_TAC] THEN
        REWRITE_TAC [FUN_EQ_THM] THEN
        ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]]]))

  let CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE ← prove
   r"!p:real^M->real^N c s a.
          covering_space(c,p) s /\ path_connected c /\ a IN c
          ==> fundamental_group(s,p a) =_c
              fundamental_group(c,a) *_c {a' | a' IN c /\ p a' = p a}"
   (← do
    let lemma ← prove
     r"!g:real^1->real^N.
          path g /\ path_image g SUBSET c
          ==> homotopic_paths c g ((@) (homotopic_paths c g)) /\
              path ((@) (homotopic_paths c g)) /\
              path_image ((@) (homotopic_paths c g)) SUBSET c /\
              pathstart ((@) (homotopic_paths c g)) = pathstart g /\
              pathfinish ((@) (homotopic_paths c g)) = pathfinish g"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
        CONV_TAC SELECT_CONV THEN ASM_MESON_TAC [HOMOTOPIC_PATHS_REFL],
        ASM MESON_TAC [HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
                  HOMOTOPIC_PATHS_IMP_PATHSTART,
                  HOMOTOPIC_PATHS_IMP_PATHFINISH]])
    pure (
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!b:real^M. b IN c
                 ==> ?g. path g /\ path_image g SUBSET c /\
                         pathstart g = a /\ pathfinish g = b")
    MP_TAC THENL [ASM_MESON_TAC [path_connected], ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:real^M->real^1->real^M") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^M") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE_ALT)) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
    REWRITE_TAC [EQ_C_BIJECTIONS] THEN REWRITE_TAC [mul_c, FORALL_IN_GSPEC] THEN
    MAP_EVERY EXISTS_TAC
      [← q r"\g. homotopic_paths c
        ((@) g ++ reversepath(f(pathfinish((@) g):real^M))),pathfinish((@) g)",
       ← q r"\(g,b:real^M). homotopic_paths (c:real^M->bool) ((@) g ++ f b)"] THEN
    REWRITE_TAC [fundamental_group, IMP_CONJ, RIGHT_FORALL_IMP_THM,
                FORALL_IN_GSPEC, IN_ELIM_PAIR_THM] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"g:real^1->real^M") THEN REPEAT DISCH_TAC THEN
    (SUBGOAL_THEN (← q r"(pathfinish g:real^M) IN c") ASSUME_TAC THENL
      [ASM_MESON_TAC [PATHFINISH_IN_PATH_IMAGE, SUBSET], ALL_TAC]) THEN
    MP_TAC (← ISPEC (← q r"g:real^1->real^M") lemma) THEN
    ABBREV_TAC (← q r"g':real^1->real^M = (@) (homotopic_paths c g)") THEN
    ASM_REWRITE_TAC [← GSYM CONJ_ASSOC] THEN STRIP_TAC THEN
    TRY (X_GEN_TAC (← q r"b:real^M") THEN REPEAT DISCH_TAC) THEN
    (CONJ_TAC THENL
      [MATCH_MP_TAC (← SET_RULE
        (← q r"P q ==> homotopic_paths s q IN {homotopic_paths s p | P p}")) THEN
       ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH,
                    PATH_JOIN, PATH_REVERSEPATH, SUBSET_PATH_IMAGE_JOIN,
                    PATHSTART_REVERSEPATH, PATH_IMAGE_REVERSEPATH],
       ALL_TAC]) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THENL
     [MP_TAC (← ISPEC (← q r"g' ++ reversepath(f(pathfinish g')):real^1->real^M")
          lemma) THEN
      ASM_SIMP_TAC [PATH_JOIN, SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_REVERSEPATH,
                   PATH_REVERSEPATH, PATHSTART_REVERSEPATH] THEN
      ABBREV_TAC
       (← q r"g'':real^1->real^M =
        (@) (homotopic_paths c
          (g' ++ reversepath(f(pathfinish(g:real^1->real^M)))))") THEN
      ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH] THEN
      STRIP_TAC,
      MP_TAC (← ISPEC (← q r"g' ++ f(b:real^M):real^1->real^M") lemma) THEN
      ASM_SIMP_TAC [PATH_JOIN, SUBSET_PATH_IMAGE_JOIN] THEN
      ABBREV_TAC (← q r"g'':real^1->real^M =
        (@) (homotopic_paths c (g' ++ f(b:real^M):real^1->real^M))") THEN
      ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PAIR_EQ] THEN STRIP_TAC] THEN
    ONCE_REWRITE_TAC [FUN_EQ_THM] THEN
    MATCH_MP_TAC (← MESON [HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS]
     (← q r"homotopic_paths s p q
      ==> !r. homotopic_paths s p r <=> homotopic_paths s q r"))
    THENL
     [TRANS_TAC HOMOTOPIC_PATHS_TRANS
       (← q r"(g' ++ reversepath(f(pathfinish g:real^M))) ++
        f(pathfinish g):real^1->real^M") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_SIMP_TAC [HOMOTOPIC_PATHS_REFL] THEN
        ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rator o rand)
        (← ONCE_REWRITE_RULE [HOMOTOPIC_PATHS_SYM] HOMOTOPIC_PATHS_ASSOC) o
        rator o snd) THEN
      ASM_SIMP_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                   PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      TRANS_TAC HOMOTOPIC_PATHS_TRANS
       (← q r"g' ++ linepath(pathfinish(f(pathfinish g:real^M)):real^M,
                       pathfinish(f(pathfinish g)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_SIMP_TAC [HOMOTOPIC_PATHS_LINV, HOMOTOPIC_PATHS_REFL,
                     PATHSTART_REVERSEPATH, PATHSTART_JOIN],
        ALL_TAC] THEN
      TRANS_TAC HOMOTOPIC_PATHS_TRANS (← q r"g':real^1->real^M") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM]] THEN
      ASM_SIMP_TAC [] THEN
      SUBST1_TAC (← SYM (← ASSUME (← q r"pathfinish g':real^M = pathfinish g"))) THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_RID THEN ASM_REWRITE_TAC [],
      TRANS_TAC HOMOTOPIC_PATHS_TRANS
       (← q r"(g' ++ f(b:real^M)) ++ reversepath(f b):real^1->real^M") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_SIMP_TAC [HOMOTOPIC_PATHS_REFL, PATH_REVERSEPATH,
                     PATH_IMAGE_REVERSEPATH, PATHSTART_REVERSEPATH] THEN
        ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM],
        ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rator o rand)
        (← ONCE_REWRITE_RULE [HOMOTOPIC_PATHS_SYM] HOMOTOPIC_PATHS_ASSOC) o
        rator o snd) THEN
      ASM_SIMP_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                   PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      TRANS_TAC HOMOTOPIC_PATHS_TRANS
       (← q r"g' ++ linepath(pathstart(f(b:real^M)),pathstart(f b))
        :real^1->real^M") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
        ASM_SIMP_TAC [HOMOTOPIC_PATHS_RINV, HOMOTOPIC_PATHS_REFL,
                     PATHSTART_REVERSEPATH, PATHSTART_JOIN],
        ALL_TAC] THEN
      TRANS_TAC HOMOTOPIC_PATHS_TRANS (← q r"g':real^1->real^M") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMOTOPIC_PATHS_SYM]] THEN
      ASM_SIMP_TAC [] THEN
      SUBST1_TAC (← SYM (← ASSUME (← q r"pathfinish g':real^M = a"))) THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_RID THEN ASM_REWRITE_TAC []]))

  let COVERING_SPACE_SELF_FINITE_FUNDAMENTAL_GROUP ← prove
   r"!p s a:real^N.
          covering_space (s,p) s /\ path_connected s /\
          a IN s /\ FINITE(fundamental_group(s,a))
          ==> ?q. homeomorphism (s,s) (p,q)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
    REPEAT CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM_MESON_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM_MESON_TAC [],
      ALL_TAC,
      ASM_MESON_TAC [COVERING_SPACE_OPEN_MAP]] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"c:real^N"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"]
          CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP CARD_FINITE_CONG) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"(p:real^N->real^N) b",
                   ← q r"b:real^N"]
          CARD_EQ_FUNDAMENTAL_GROUPS_BASEPOINTS) THEN
    ANTS_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN ASM SET_TAC [],
      DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP CARD_FINITE_CONG)] THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"p:real^N->real^N", ← q r"s:real^N->bool",
                   ← q r" s:real^N->bool",
                   ← q r"b:real^N"] CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_CARD_IMP) th) THEN
            MP_TAC (← MATCH_MP CARD_FINITE_CONG th))) THEN
    ASM_REWRITE_TAC [CARD_MUL_FINITE_EQ, FUNDAMENTAL_GROUP_EQ_EMPTY] THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP (← MESON [FINITE_EMPTY]
     (← q r"s = {} \/ FINITE s ==> FINITE s"))) THEN
    ASM_SIMP_TAC [CARD_MUL_C] THEN FIRST_ASSUM
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_CARD_IMP)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    ASM_REWRITE_TAC [← NUM_RING (← q r"a = a * b <=> a = 0 \/ b = 1")] THEN
    ASM_SIMP_TAC [CARD_EQ_0, FUNDAMENTAL_GROUP_EQ_EMPTY] THEN
    ASM_SIMP_TAC [← MESON [HAS_SIZE]
     (← q r"FINITE s ==> (CARD s = n <=> s HAS_SIZE n)")] THEN
    CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN ASM SET_TAC [])

  return { CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE_ALT,
           CARD_EQ_FUNDAMENTAL_GROUP_COVERING_SPACE,
           COVERING_SPACE_SELF_FINITE_FUNDAMENTAL_GROUP }

/- ------------------------------------------------------------------------- -/
/- Invariance of dimension and domain in setting of R^n.                     -/
/- (paths.ml 27155-27322)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXE where
  HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE : thm
  HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE_DIM : thm
  HOMEOMORPHIC_SUBSPACES_EQ : thm
  HOMEOMORPHIC_AFFINE_EUCLIDEAN_SPACE : thm
  HOMEOMORPHIC_AFFINE_SETS_EQ : thm
  INVARIANCE_OF_DOMAIN_SUBSPACES : thm
  INVARIANCE_OF_DOMAIN : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXE [HolBase] (D : PathsDeps) : ExceptT String IO PXE := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, INT_ARITH_TAC, MESON_TAC, SET_TAC, GEOM_ORIGIN_TAC, .. } :=
    D.cvx
  let { CARD_NUMSEG_1, EQ_IMP, EQ_SYM_EQ, EQ_TRANS, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, INTER_NUMSEG, INT_OF_NUM_EQ, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_ASSOC, o_DEF, o_THM, .. } := D.cvx.core6
  let { HULL_INC, .. } := D.cvx.misc
  let { DIM_BASIS_IMAGE, DIM_SPAN, DIM_SUBSET_UNIV, .. } := D.cvx.vec1
  let { SUBSPACE_SPAN, SUBSPACE_UNIV, .. } := D.cvx.vec3
  let { VECTOR_ADD_RID, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_REFL, HOMEOMORPHIC_SUBSPACES, .. } := D.cvx.top3
  let { OPEN_IN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { IN_TRANSLATION_GALOIS_ALT, .. } := D.pvec
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        HOMEOMORPHIC_EMPTY_SPACE_EQ, HOMEOMORPHIC_IMP_CONTINUOUS_MAP, HOMEOMORPHIC_MAPS_MAP,
        HOMEOMORPHIC_MAP_OPENNESS_EQ, HOMEOMORPHIC_SPACE_SYM, HOMEOMORPHIC_SPACE_TRANS, .. } :=
    D.pmet1
  let { NONEMPTY_EUCLIDEAN_SPACE, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
        continuous_map, homeomorphic_space, .. } := D.pmet2
  let { CONTINUOUS_MAP_EUCLIDEAN2, .. } := D.ptop2
  let { HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN, .. } := D.ptop3
  let { HOMEOMORPHIC_SPACE_EUCLIDEAN, HOMEOMORPHIC_TRANSLATION_LEFT_EQ,
        HOMEOMORPHIC_TRANSLATION_RIGHT_EQ, .. } := D.ptop4
  let { AFFINE_EQ_SUBSPACE, AFFINE_IMP_SUBSPACE, AFFINE_TRANSLATION, AFF_DIM_DIM_0,
        AFF_DIM_DIM_SUBSPACE, AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, AFF_DIM_TRANSLATION_EQ, .. } :=
    D.pcvx1
  let { INVARIANCE_OF_DIMENSION_EUCLIDEAN_SPACE, INVARIANCE_OF_DOMAIN_EUCLIDEAN_SPACE_GEN, .. } :=
    D.phom
  -- @@SCOPE END

  let HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE ← prove
   r"!(s:real^N->bool) n.
          subspace s
          ==> (subtopology euclidean s homeomorphic_space euclidean_space n <=>
               dim s = n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"subtopology euclidean (s:real^N->bool) homeomorphic_space
      euclidean_space (dim s)")
    ASSUME_TAC THENL
     [TRANS_TAC HOMEOMORPHIC_SPACE_TRANS
       (← q r"subtopology euclidean
          (span (IMAGE basis (1..dim(s:real^N->bool))):real^N->bool)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [HOMEOMORPHIC_SPACE_EUCLIDEAN] THEN
        MATCH_MP_TAC HOMEOMORPHIC_SUBSPACES THEN
        ASM_REWRITE_TAC [SUBSPACE_SPAN, DIM_SPAN, DIM_BASIS_IMAGE] THEN
        REWRITE_TAC [INTER_NUMSEG, ← ARITH_RULE (← q r"MAX 1 1 = 1")] THEN
        SIMP_TAC [DIM_SUBSET_UNIV, ← ARITH_RULE (← q r"s <= n ==> MIN n s = s")] THEN
        REWRITE_TAC [CARD_NUMSEG_1],
        ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
        MP_TAC (← SPEC (← q r"dim(s:real^N->bool)")
          HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN_GEN) THEN
        REWRITE_TAC [homeomorphic_space, DIM_SUBSET_UNIV] THEN
        MESON_TAC []],
      X_GEN_TAC (← q r"n:num") THEN EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [← GSYM INVARIANCE_OF_DIMENSION_EUCLIDEAN_SPACE] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_SPACE_TRANS) THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      ASM_REWRITE_TAC []])

  let HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE_DIM ← prove
   r"!(s:real^N->bool).
         subspace s
         ==> subtopology euclidean s homeomorphic_space euclidean_space (dim s)"
   (SIMP_TAC [HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE])

  let HOMEOMORPHIC_SUBSPACES_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
          subspace s /\ subspace t ==> (s homeomorphic t <=> dim s = dim t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [HOMEOMORPHIC_SUBSPACES]] THEN
    REWRITE_TAC [← GSYM INVARIANCE_OF_DIMENSION_EUCLIDEAN_SPACE] THEN
    TRANS_TAC HOMEOMORPHIC_SPACE_TRANS
     (← q r"subtopology euclidean (t:real^N->bool)") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE] THEN
    TRANS_TAC HOMEOMORPHIC_SPACE_TRANS
     (← q r"subtopology euclidean (s:real^M->bool)") THEN
    ASM_REWRITE_TAC [HOMEOMORPHIC_SPACE_EUCLIDEAN] THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE])

  let HOMEOMORPHIC_AFFINE_EUCLIDEAN_SPACE ← prove
   r"!(s:real^N->bool) n.
          affine s
          ==> (subtopology euclidean s homeomorphic_space euclidean_space n <=>
               aff_dim s = &n)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [HOMEOMORPHIC_EMPTY_SPACE_EQ, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                   NONEMPTY_EUCLIDEAN_SPACE, AFF_DIM_EMPTY] THEN
      INT_ARITH_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"subtopology euclidean (IMAGE (\x:real^N. --a + x) s) homeomorphic_space
      euclidean_space n") THEN
    CONJ_TAC THENL
     [EQ_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_SPACE_TRANS) THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE_EUCLIDEAN] THEN
      REWRITE_TAC [HOMEOMORPHIC_TRANSLATION_LEFT_EQ,
                  HOMEOMORPHIC_TRANSLATION_RIGHT_EQ, HOMEOMORPHIC_REFL],
      W (MP_TAC o PART_MATCH (lhand o rand)
       HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE o lhand o snd) THEN
      SIMP_TAC [← GSYM INT_OF_NUM_EQ, ← GSYM AFF_DIM_DIM_SUBSPACE] THEN
      REWRITE_TAC [AFF_DIM_TRANSLATION_EQ] THEN DISCH_THEN MATCH_MP_TAC THEN
      MATCH_MP_TAC AFFINE_IMP_SUBSPACE THEN
      ASM_SIMP_TAC [AFFINE_TRANSLATION, ← GSYM IN_TRANSLATION_GALOIS_ALT] THEN
      ASM_REWRITE_TAC [VECTOR_ADD_RID]])

  let HOMEOMORPHIC_AFFINE_SETS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
          affine s /\ affine t ==> (s homeomorphic t <=> aff_dim s = aff_dim t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, HOMEOMORPHIC_EMPTY] THEN
    POP_ASSUM MP_TAC THEN
    GEN_REWRITE_TAC (funpow 3 RAND_CONV) [EQ_SYM_EQ] THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_SIMP_TAC [AFF_DIM_EMPTY, AFF_DIM_EQ_MINUS1, HOMEOMORPHIC_EMPTY] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC
     [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^N"] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^M") THEN GEOM_ORIGIN_TAC (← q r"b:real^N") THEN
    SIMP_TAC [AFFINE_EQ_SUBSPACE, HOMEOMORPHIC_SUBSPACES_EQ, AFF_DIM_DIM_0,
             HULL_INC, INT_OF_NUM_EQ] THEN
    MESON_TAC [])

  let INVARIANCE_OF_DOMAIN_SUBSPACES ← prove
   r"!f:real^M->real^N u v s.
          subspace u /\ subspace v /\ dim v <= dim u /\
          f continuous_on s /\ IMAGE f s SUBSET v /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
          open_in (subtopology euclidean u) s
          ==> open_in (subtopology euclidean v) (IMAGE f s)"
   (X_GEN_TAC (← q r"h:real^M->real^N") THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    MAP_EVERY (fun t => tactic_of do
      pure (MP_TAC (← ISPEC t HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE_DIM)))
     [← q r"v:real^N->bool", ← q r"u:real^M->bool"] THEN
    ASM_REWRITE_TAC [homeomorphic_space, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->num->real", ← q r"f':(num->real)->real^M"] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^N->num->real", ← q r"g':(num->real)->real^N"] THEN
    STRIP_TAC THEN FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC id [← MATCH_MP HOMEOMORPHIC_MAP_OPENNESS_EQ th])) THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MP_TAC (← ISPECL
       [← q r"dim(u:real^M->bool)", ← q r"dim(v:real^N->bool)",
        ← q r"IMAGE (f:real^M->num->real) s",
        ← q r"(g:real^N->num->real) o h o (f':(num->real)->real^M)"]
            INVARIANCE_OF_DOMAIN_EUCLIDEAN_SPACE_GEN) THEN
      ASM_REWRITE_TAC [← GSYM IMAGE_o, ← GSYM o_ASSOC] THEN
      ANTS_TAC THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [HOMEOMORPHIC_MAP_OPENNESS_EQ],
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
        EXISTS_TAC (← q r"subtopology euclidean (v:real^N->bool)") THEN
        ASM_SIMP_TAC [HOMEOMORPHIC_IMP_CONTINUOUS_MAP] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
        EXISTS_TAC (← q r"subtopology euclidean (s:real^M->bool)") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2] THEN
        SUBGOAL_THEN
         (← q r"subtopology euclidean (s:real^M->bool) =
          subtopology (subtopology euclidean u) (s:real^M->bool)")
        SUBST1_TAC THENL
         [REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
          AP_TERM_TAC THEN ASM SET_TAC [],
          ONCE_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
          ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                       HOMEOMORPHIC_IMP_CONTINUOUS_MAP]],
        REWRITE_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_SIMP_TAC [o_THM],
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        REWRITE_TAC [IMAGE_o] THEN AP_TERM_TAC THEN AP_TERM_TAC]] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP
       HOMEOMORPHIC_IMP_CONTINUOUS_MAP)) THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [continuous_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                TOPSPACE_SUBTOPOLOGY, o_DEF] THEN
    SET_TAC [])

  let INVARIANCE_OF_DOMAIN ← prove
   r"!f:real^N->real^N s.
          f continuous_on s /\ open s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> open(IMAGE f s)"
   (ONCE_REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INVARIANCE_OF_DOMAIN_SUBSPACES THEN
    EXISTS_TAC (← q r"(:real^N)") THEN
    ASM_REWRITE_TAC [SUBSPACE_UNIV, SUBSET_UNIV, LE_REFL])

  return { HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE, HOMEOMORPHIC_SUBSPACE_EUCLIDEAN_SPACE_DIM,
           HOMEOMORPHIC_SUBSPACES_EQ, HOMEOMORPHIC_AFFINE_EUCLIDEAN_SPACE,
           HOMEOMORPHIC_AFFINE_SETS_EQ, INVARIANCE_OF_DOMAIN_SUBSPACES, INVARIANCE_OF_DOMAIN }

/- ------------------------------------------------------------------------- -/
/- Invariance of dimension: subspaces, affine sets, convex sets.             -/
/- (paths.ml 27323-27514)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXF where
  INVARIANCE_OF_DIMENSION_SUBSPACES : thm
  INVARIANCE_OF_DOMAIN_AFFINE_SETS : thm
  INVARIANCE_OF_DIMENSION_AFFINE_SETS : thm
  INVARIANCE_OF_DIMENSION : thm
  CONTINUOUS_INJECTIVE_IMAGE_SUBSPACE_DIM_LE : thm
  INVARIANCE_OF_DIMENSION_CONVEX_DOMAIN : thm
  HOMEOMORPHIC_CONVEX_SETS : thm
  HOMEOMORPHIC_CONVEX_COMPACT_SETS_EQ : thm
  INVARIANCE_OF_DOMAIN_GEN : thm
  INJECTIVE_INTO_1D_IMP_OPEN_MAP_UNIV : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXF [HolBase] (D : PathsDeps) (BXE : PXE) : ExceptT String IO PXF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, VECTOR_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, DIMINDEX_1, DIMINDEX_GE_1, ETA_AX, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_SUBSET, IMAGE_o,
        IMP_CONJ, IMP_IMP, INJECTIVE_ON_ALT, INT_LE_ANTISYM, INT_OF_NUM_LE, .. } := D.cvx.core2
  let { IN_IMAGE, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM, NOT_IMP, NOT_LT, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_ASSOC, o_DEF, o_THM, .. } := D.cvx.core6
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { CHOOSE_SUBSPACE_OF_SUBSPACE, DIM_SUBSET, DIM_UNIV, .. } := D.cvx.vec1
  let { SPAN_OF_SUBSPACE, SUBSPACE_IMP_NONEMPTY, SUBSPACE_UNIV, .. } := D.cvx.vec3
  let { OPEN_IN_EMPTY, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_SUBSPACES, .. } := D.cvx.top3
  let { OPEN_IN, OPEN_IN_REFL, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { LE_LT, .. } := D.pses1
  let { OPEN_IN_TRANSLATION_EQ, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_SUBSPACE, AFFINE_TRANSLATION_EQ, AFF_DIM_AFFINE_HULL,
        AFF_DIM_DIM_SUBSPACE, AFF_DIM_EMPTY, AFF_DIM_GE, AFF_DIM_TRANSLATION_EQ, .. } := D.pcvx1
  let { DIM_OPEN_IN, HOMEOMORPHIC_CONVEX_COMPACT_SETS, OPEN_IN_RELATIVE_INTERIOR,
        RELATIVE_INTERIOR_EQ_EMPTY, RELATIVE_INTERIOR_SUBSET, .. } := D.pcvx2
  let { INVARIANCE_OF_DOMAIN_SUBSPACES, .. } := BXE
  -- @@SCOPE END

  let INVARIANCE_OF_DIMENSION_SUBSPACES ← prove
   r"!f:real^M->real^N u v s.
        subspace u /\ subspace v /\
        ~(s = {}) /\ open_in (subtopology euclidean u) s /\
        f continuous_on s /\ IMAGE f s SUBSET v /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> dim u <= dim v"
   (REWRITE_TAC [← GSYM NOT_LT] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"u:real^M->bool", ← q r"dim(v:real^N->bool)"]
      CHOOSE_SUBSPACE_OF_SUBSPACE) THEN
    ASM_SIMP_TAC [SPAN_OF_SUBSPACE, LE_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"v:real^N->bool", ← q r"t:real^M->bool"]
          HOMEOMORPHIC_SUBSPACES) THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    ASM_REWRITE_TAC [homeomorphic, homeomorphism, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:real^N->real^M", ← q r"k:real^M->real^N"] THEN
    STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"(h:real^N->real^M) o (f:real^M->real^N)", ← q r"u:real^M->bool",
      ← q r"u:real^M->bool", ← q r"s:real^M->bool"]
          INVARIANCE_OF_DOMAIN_SUBSPACES) THEN
    ASM_REWRITE_TAC [LE_LT, NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      REWRITE_TAC [o_THM] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE ((h:real^N->real^M) o (f:real^M->real^N)) s SUBSET t")
    ASSUME_TAC THENL [REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [], ALL_TAC] THEN
    ABBREV_TAC (← q r"w = IMAGE ((h:real^N->real^M) o (f:real^M->real^N)) s") THEN
    DISCH_TAC THEN UNDISCH_TAC (← q r"dim(t:real^M->bool) < dim(u:real^M->bool)") THEN
    REWRITE_TAC [NOT_LT] THEN MP_TAC (← ISPECL
     [← q r"w:real^M->bool", ← q r"u:real^M->bool"] DIM_OPEN_IN) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [IMAGE_EQ_EMPTY], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    ASM_SIMP_TAC [DIM_SUBSET])

  let INVARIANCE_OF_DOMAIN_AFFINE_SETS ← prove
   r"!f:real^M->real^N u v s.
          affine u /\ affine v /\ aff_dim v <= aff_dim u /\
          f continuous_on s /\ IMAGE f s SUBSET v /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
          open_in (subtopology euclidean u) s
          ==> open_in (subtopology euclidean v) (IMAGE f s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, OPEN_IN_EMPTY, INJECTIVE_ON_ALT] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?a:real^M b:real^N. a IN s /\ a IN u /\ b IN v")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"(\x. --b + x) o (f:real^M->real^N) o (\x. a + x)",
      ← q r"IMAGE (\x:real^M. --a + x) u", ← q r"IMAGE (\x:real^N. --b + x) v",
      ← q r"IMAGE (\x:real^M. --a + x) s"] INVARIANCE_OF_DOMAIN_SUBSPACES) THEN
    REWRITE_TAC [IMAGE_o, INJECTIVE_ON_ALT, OPEN_IN_TRANSLATION_EQ] THEN
    SIMP_TAC [IMP_CONJ, ← GSYM INT_OF_NUM_LE, ← GSYM AFF_DIM_DIM_SUBSPACE] THEN
    ASM_REWRITE_TAC [AFF_DIM_TRANSLATION_EQ, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_IN_IMAGE, o_THM, ← GSYM IMAGE_o, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    ANTS_TAC THENL
     [ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC AFFINE_IMP_SUBSPACE THEN
        ASM_REWRITE_TAC [AFFINE_TRANSLATION_EQ] THEN REWRITE_TAC [IN_IMAGE,
          ← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
        ASM_MESON_TAC [],
        REPEAT CONJ_TAC THENL
         [REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
             SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID]),
          REWRITE_TAC [← GSYM o_ASSOC] THEN REWRITE_TAC [IMAGE_o] THEN
          MATCH_MP_TAC IMAGE_SUBSET,
          REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")]]],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← VECTOR_ARITH (← q r"a + --a + x:real^N = x"), ← GSYM IMAGE_o, o_DEF,
                 IMAGE_ID, ETA_AX])

  let INVARIANCE_OF_DIMENSION_AFFINE_SETS ← prove
   r"!f:real^M->real^N u v s.
        affine u /\ affine v /\
        ~(s = {}) /\ open_in (subtopology euclidean u) s /\
        f continuous_on s /\ IMAGE f s SUBSET v /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> aff_dim u <= aff_dim v"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, OPEN_IN_EMPTY, INJECTIVE_ON_ALT] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?a:real^M b:real^N. a IN s /\ a IN u /\ b IN v")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"(\x. --b + x) o (f:real^M->real^N) o (\x. a + x)",
      ← q r"IMAGE (\x:real^M. --a + x) u", ← q r"IMAGE (\x:real^N. --b + x) v",
      ← q r"IMAGE (\x:real^M. --a + x) s"] INVARIANCE_OF_DIMENSION_SUBSPACES) THEN
    REWRITE_TAC [IMAGE_o, INJECTIVE_ON_ALT, OPEN_IN_TRANSLATION_EQ] THEN
    SIMP_TAC [IMP_CONJ, ← GSYM INT_OF_NUM_LE, ← GSYM AFF_DIM_DIM_SUBSPACE] THEN
    ASM_REWRITE_TAC [AFF_DIM_TRANSLATION_EQ, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [FORALL_IN_IMAGE, o_THM, ← GSYM IMAGE_o, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    DISCH_THEN MATCH_MP_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC AFFINE_IMP_SUBSPACE THEN
      ASM_REWRITE_TAC [AFFINE_TRANSLATION_EQ] THEN REWRITE_TAC [IN_IMAGE,
        ← VECTOR_ARITH (← q r"vec 0:real^N = --a + x <=> x = a")] THEN
      ASM_MESON_TAC [],
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN REPEAT CONJ_TAC THENL
       [REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
           SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID]),
        REWRITE_TAC [← GSYM o_ASSOC] THEN REWRITE_TAC [IMAGE_o] THEN
        MATCH_MP_TAC IMAGE_SUBSET,
        REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y")]]] THEN
    ASM_SIMP_TAC [← VECTOR_ARITH (← q r"a + --a + x:real^N = x"), ← GSYM IMAGE_o, o_DEF,
                 IMAGE_ID, ETA_AX])

  let INVARIANCE_OF_DIMENSION ← prove
   r"!f:real^M->real^N s.
          f continuous_on s /\ open s /\ ~(s = {}) /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> dimindex(:M) <= dimindex(:N)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM DIM_UNIV] THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION_SUBSPACES THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
    ASM_REWRITE_TAC [SUBSPACE_UNIV, SUBSET_UNIV, SUBTOPOLOGY_UNIV,
                    ← GSYM OPEN_IN])

  let CONTINUOUS_INJECTIVE_IMAGE_SUBSPACE_DIM_LE ← prove
   r"!f:real^M->real^N s t.
          subspace s /\ subspace t /\
          f continuous_on s /\ IMAGE f s SUBSET t /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> dim(s) <= dim(t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INVARIANCE_OF_DIMENSION_SUBSPACES THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"s:real^M->bool"] THEN
    ASM_REWRITE_TAC [OPEN_IN_REFL] THEN ASM_SIMP_TAC [SUBSPACE_IMP_NONEMPTY])

  let INVARIANCE_OF_DIMENSION_CONVEX_DOMAIN ← prove
   r"!f:real^M->real^N s t.
          convex s /\ f continuous_on s /\ IMAGE f s SUBSET affine hull t /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> aff_dim(s) <= aff_dim(t)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [AFF_DIM_EMPTY, AFF_DIM_GE] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"affine hull s:real^M->bool",
      ← q r"affine hull t:real^N->bool", ← q r"relative_interior s:real^M->bool"]
          INVARIANCE_OF_DIMENSION_AFFINE_SETS) THEN
    ASM_REWRITE_TAC [AFFINE_AFFINE_HULL, AFF_DIM_AFFINE_HULL,
                    OPEN_IN_RELATIVE_INTERIOR] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    CONJ_TAC THENL [ASM_MESON_TAC [RELATIVE_INTERIOR_EQ_EMPTY], ALL_TAC] THEN
    ASSUME_TAC (← ISPEC (← q r"s:real^M->bool") RELATIVE_INTERIOR_SUBSET) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []])

  let HOMEOMORPHIC_CONVEX_SETS ← prove
   r"!s:real^M->bool t:real^N->bool.
          convex s /\ convex t /\ s homeomorphic t ==> aff_dim s = aff_dim t"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, ← GSYM INT_LE_ANTISYM, homeomorphism] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION_CONVEX_DOMAIN THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"), EXISTS_TAC (← q r"g:real^N->real^M")] THEN
    ASM_REWRITE_TAC [HULL_SUBSET] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_CONVEX_COMPACT_SETS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
          convex s /\ compact s /\ convex t /\ compact t
          ==> (s homeomorphic t <=> aff_dim s = aff_dim t)"
   (MESON_TAC [HOMEOMORPHIC_CONVEX_SETS, HOMEOMORPHIC_CONVEX_COMPACT_SETS])

  let INVARIANCE_OF_DOMAIN_GEN ← prove
   r"!f:real^M->real^N s.
          dimindex(:N) <= dimindex(:M) /\ f continuous_on s /\ open s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> open(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"(:real^M)", ← q r"(:real^N)", ← q r"s:real^M->bool"]
     INVARIANCE_OF_DOMAIN_SUBSPACES) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, SUBSPACE_UNIV,
                    DIM_UNIV, SUBSET_UNIV])

  let INJECTIVE_INTO_1D_IMP_OPEN_MAP_UNIV ← prove
   r"!f:real^N->real^1 s t.
          f continuous_on s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
          open t /\ t SUBSET s
          ==> open (IMAGE f t)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DOMAIN_GEN THEN
    ASM_REWRITE_TAC [DIMINDEX_1, DIMINDEX_GE_1] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []])

  return { INVARIANCE_OF_DIMENSION_SUBSPACES, INVARIANCE_OF_DOMAIN_AFFINE_SETS,
           INVARIANCE_OF_DIMENSION_AFFINE_SETS, INVARIANCE_OF_DIMENSION,
           CONTINUOUS_INJECTIVE_IMAGE_SUBSPACE_DIM_LE, INVARIANCE_OF_DIMENSION_CONVEX_DOMAIN,
           HOMEOMORPHIC_CONVEX_SETS, HOMEOMORPHIC_CONVEX_COMPACT_SETS_EQ,
           INVARIANCE_OF_DOMAIN_GEN, INJECTIVE_INTO_1D_IMP_OPEN_MAP_UNIV }

/- ------------------------------------------------------------------------- -/
/- Continuity of inverses from invariance of domain.  (paths.ml 27515-27703) -/
/- ------------------------------------------------------------------------- -/

structure PXG where
  CONTINUOUS_ON_INVERSE_OPEN : thm
  CONTINUOUS_ON_INVERSE_INTO_1D : thm
  INVARIANCE_OF_DOMAIN_HOMEOMORPHISM : thm
  INVARIANCE_OF_DOMAIN_HOMEOMORPHIC : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXG [HolBase] (D : PathsDeps) (BN : PTN) (BS : PTS) (BUC : PUC) (BXF : PXF) :
    ExceptT String IO PXG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { AND_FORALL_THM, CONJ_ASSOC, DIMINDEX_1, DIMINDEX_GE_1, EXISTS_IN_IMAGE, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMP_IMP, IN, INTER_SUBSET, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, MONO_EXISTS, NOT_EXISTS_THM, NOT_INSERT_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_01, REAL_LT_MIN, .. } := D.cvx.core4
  let { REAL_NOT_LE, RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_TRANS, .. } := D.cvx.core5
  let { SWAP_EXISTS_THM, real_ge, .. } := D.cvx.core6
  let { DIST_1, DIST_NZ, .. } := D.cvx.vec1
  let { drop, .. } := D.cvx.vec4
  let { CLOSED_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { COMPACT_EMPTY, COMPACT_SING, CONNECTED_CLOSED_IN, CONNECTED_COMPONENT_SUBSET,
        CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_INVERSE, CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IS_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_INTER, homeomorphic, homeomorphism, open_in, .. } := D.cvx.top5
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.pses1
  let { CLOSED_IN_INTER, CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, .. } := D.pmet1
  let { CLOSED_IN_REFL, CLOSED_IN_SING, .. } := D.ptop1
  let { CONNECTED_COMPONENT_REFL, CONNECTED_CONNECTED_COMPONENT, CONNECTED_EMPTY,
        CONNECTED_SING, CONTINUOUS_INVERSE_INJECTIVE_PROPER_MAP, .. } := D.ptop2
  let { CONTINUOUS_ON_INVERSE_OPEN_MAP, CONTINUOUS_OPEN_IN_PREIMAGE_EQ, .. } := D.ptop3
  let { OPEN_OPEN_IN_TRANS, .. } := D.ptop5
  let { CONVEX_CONNECTED_1, .. } := D.pcvx1
  let { CONVEX_HALFSPACE_COMPONENT_GE, CONVEX_HALFSPACE_COMPONENT_LE, CONVEX_INTER,
        IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { INJECTIVE_INTO_1D_IMP_OPEN_MAP, .. } := BN
  let { LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT, .. } := BS
  let { MONOTONE_TOPOLOGICALLY_INTO_1D, MONOTONE_INTO_1D_IMP_PROPER_MAP, .. } := BUC
  let { INVARIANCE_OF_DOMAIN_GEN, .. } := BXF
  -- @@SCOPE END

  let CONTINUOUS_ON_INVERSE_OPEN ← prove
   r"!f:real^M->real^N g s.
          dimindex(:N) <= dimindex(:M) /\
          f continuous_on s /\ open s /\
          (!x. x IN s ==> g(f x) = x)
          ==> g continuous_on IMAGE f s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_OPEN_IN_PREIMAGE_EQ] THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN IMAGE f s /\ g x IN t} = IMAGE (f:real^M->real^N) (s INTER t)")
    SUBST1_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC OPEN_OPEN_IN_TRANS] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    CONJ_TAC THEN MATCH_MP_TAC INVARIANCE_OF_DOMAIN_GEN THEN
    ASM_SIMP_TAC [OPEN_INTER, IN_INTER] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTER_SUBSET])

  let CONTINUOUS_ON_INVERSE_INTO_1D ← prove
   r"!f:real^N->real^1 g s t.
          f continuous_on s /\
          (path_connected s \/
           connected s /\ (locally compact s \/ locally connected s) \/
           compact s \/
           open s) /\
          IMAGE f s = t /\ (!x. x IN s ==> g(f x) = x)
          ==> g continuous_on t"
   (REPEAT STRIP_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_INVERSE_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^1", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC INJECTIVE_INTO_1D_IMP_OPEN_MAP THEN ASM SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_INVERSE_INJECTIVE_PROPER_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^1", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONOTONE_INTO_1D_IMP_PROPER_MAP THEN
      ASM_REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"y:real^1") THEN
      SUBGOAL_THEN
       (← q r"{x | x IN s /\ (f:real^N->real^1) x = y} = {} \/
        ?a. {x | x IN s /\ (f:real^N->real^1) x = y} = {a}")
      STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [],
        ASM_REWRITE_TAC [COMPACT_EMPTY, CONNECTED_EMPTY],
        ASM_REWRITE_TAC [COMPACT_SING, CONNECTED_SING]],
      MATCH_MP_TAC CONTINUOUS_ON_INVERSE_OPEN_MAP THEN
      MAP_EVERY EXISTS_TAC [← q r"f:real^N->real^1", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"w:real^N->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      REWRITE_TAC [open_in, SUBSET, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC] THEN
      ABBREV_TAC (← q r"u = connected_component w (x:real^N)") THEN
      SUBGOAL_THEN
       (← q r"connected u /\ (x:real^N) IN u /\ u SUBSET s /\ u SUBSET w /\
        open_in (subtopology euclidean s) u")
      STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "u" THEN REPEAT CONJ_TAC THENL
         [MESON_TAC [CONNECTED_CONNECTED_COMPONENT],
          ASM_MESON_TAC [IN, CONNECTED_COMPONENT_REFL],
          ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET, SUBSET_TRANS],
          ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET],
          ASM_MESON_TAC [LOCALLY_CONNECTED_OPEN_CONNECTED_COMPONENT]],
        SUBGOAL_THEN
         (← q r"?e. &0 < e /\ !y. y IN t /\ dist(y,(f:real^N->real^1) x) < e
              ==> y IN IMAGE f u")
        ASSUME_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
          let w ← q r"w:real^N->bool"
          let _ ← liftExcept (check (HolCore.Basics.free_in w) (concl th))
          pure ALL_TAC))] THEN
      SUBGOAL_THEN
       (← q r"(?e. &0 < e /\
             !y. y IN t /\ drop(f x) <= drop y /\ drop y < drop(f x) + e
                 ==> y IN IMAGE f (u:real^N->bool)) /\
        (?e. &0 < e /\
             !y. y IN t /\ drop(f x) - e < drop y /\ drop y <= drop(f x)
                 ==> y IN IMAGE f (u:real^N->bool))")
      MP_TAC THENL
       [ALL_TAC,
        DISCH_THEN (CONJUNCTS_THEN2
         (X_CHOOSE_THEN (← q r"d:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))
         (X_CHOOSE_THEN (← q r"e:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))) THEN
        REWRITE_TAC [IMP_IMP, AND_FORALL_THM, ← TAUT
         (← q r"(p ==> r) /\ (q ==> r) <=> (p \/ q ==> r)")] THEN
        DISCH_TAC THEN EXISTS_TAC (← q r"min d e:real") THEN
        ASM_REWRITE_TAC [REAL_LT_MIN, DIST_1] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:real^N->real^1", ← q r"s:real^N->bool"]
          MONOTONE_TOPOLOGICALLY_INTO_1D) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"y:real^1") THEN
        SUBGOAL_THEN
         (← q r"{x | x IN s /\ (f:real^N->real^1) x = y} = {} \/
          ?a. {x | x IN s /\ (f:real^N->real^1) x = y} = {a}")
        STRIP_ASSUME_TAC THENL
         [ASM SET_TAC [],
          ASM_REWRITE_TAC [COMPACT_EMPTY, CONNECTED_EMPTY],
          ASM_REWRITE_TAC [COMPACT_SING, CONNECTED_SING]],
        ALL_TAC] THEN
      DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
       [DISCH_THEN (MP_TAC o SPEC
         (← q r"{y | y IN IMAGE (f:real^N->real^1) s /\ drop(f x) <= drop y}")),
        DISCH_THEN (MP_TAC o SPEC
         (← q r"{y | y IN IMAGE (f:real^N->real^1) s /\ drop y <= drop(f x)}"))] THEN
      (ANTS_TAC THENL
        [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
         REWRITE_TAC [← GSYM CONVEX_CONNECTED_1] THEN MATCH_MP_TAC CONVEX_INTER THEN
         REWRITE_TAC [drop, CONVEX_HALFSPACE_COMPONENT_LE,
                     ← REWRITE_RULE [real_ge] CONVEX_HALFSPACE_COMPONENT_GE] THEN
         REWRITE_TAC [CONVEX_CONNECTED_1] THEN
         ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE],
         ALL_TAC]) THEN
      REWRITE_TAC [IN_ELIM_THM, ← SET_RULE
       (← q r"x IN s /\ f x IN IMAGE f s /\ P x <=> x IN s /\ P x")] THEN
      REWRITE_TAC [CONNECTED_CLOSED_IN, NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{x:real^N}")) THEN
      REWRITE_TAC [CLOSED_IN_SING, IN_ELIM_THM, REAL_LE_REFL] THEN
      REWRITE_TAC [NOT_INSERT_EMPTY] THENL
       [DISCH_THEN (MP_TAC o SPEC
         (← q r"{w:real^N | w IN s DIFF u /\ drop(f x) <= drop(f w)}")),
        DISCH_THEN (MP_TAC o SPEC
         (← q r"{w:real^N | w IN s DIFF u /\ drop(f w) <= drop(f x)}"))] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← TAUT
       (← q r"~(p /\ q /\ r /\ s /\ ~t) ==> p /\ q /\ s ==> t \/ ~r"))) THEN
      (ANTS_TAC THENL
        [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
         CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
         REWRITE_TAC [← SET_RULE
          (← q r"{x | x IN s DIFF u /\ P x} =
           {x | x IN s /\ P x} INTER (s DIFF u)")] THEN
         MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
         EXISTS_TAC (← q r"s:real^N->bool") THEN
         CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
         MATCH_MP_TAC CLOSED_IN_INTER THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
         MATCH_MP_TAC CLOSED_IN_DIFF THEN ASM_REWRITE_TAC [CLOSED_IN_REFL],
         ALL_TAC]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"{x | x IN s DIFF u /\ P x} = {} \/
        ~({x | x IN s /\ P x} SUBSET {a} UNION {x | x IN s DIFF u /\ P x})
        ==> u SUBSET s
            ==> (!x. x IN s /\ P x ==> x = a) \/
                ?x. x IN u /\ ~(x = a) /\ P x"))) THEN
      ASM_REWRITE_TAC [] THEN
      (DISCH_THEN (DISJ_CASES_THEN2 ASSUME_TAC MP_TAC) THENL
        [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN ASM SET_TAC [],
         ALL_TAC]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"dist((f:real^N->real^1) x,f y)") THEN
      ASM_REWRITE_TAC [← GSYM DIST_NZ] THEN
      (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      X_GEN_TAC (← q r"z:real^1") THEN STRIP_TAC THEN
      (SUBGOAL_THEN (← q r"is_interval(IMAGE (f:real^N->real^1) u)") MP_TAC THENL
        [REWRITE_TAC [IS_INTERVAL_CONNECTED_1] THEN
         MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
         ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
         REWRITE_TAC [IS_INTERVAL_1] THEN DISCH_THEN MATCH_MP_TAC])
      THENL
       [ALL_TAC,
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM]] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      ONCE_REWRITE_TAC [EXISTS_IN_IMAGE] THEN
      EXISTS_TAC (← q r"x:real^N") THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"(f:real^N->real^1) y") THEN
      ASM_SIMP_TAC [FUN_IN_IMAGE] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE]) THEN
      REWRITE_TAC [DIST_1] THEN ASM_REAL_ARITH_TAC,
      ASM_MESON_TAC [CONTINUOUS_ON_INVERSE],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC CONTINUOUS_ON_INVERSE_OPEN THEN
      ASM_REWRITE_TAC [DIMINDEX_1, DIMINDEX_GE_1]])

  let INVARIANCE_OF_DOMAIN_HOMEOMORPHISM ← prove
   r"!f:real^M->real^N s.
          dimindex(:N) <= dimindex(:M) /\ f continuous_on s /\ open s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> ?g. homeomorphism (s,IMAGE f s) (f,g)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [homeomorphism] THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_INVERSE_OPEN] THEN ASM SET_TAC [])

  let INVARIANCE_OF_DOMAIN_HOMEOMORPHIC ← prove
   r"!f:real^M->real^N s.
          dimindex(:N) <= dimindex(:M) /\ f continuous_on s /\ open s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> s homeomorphic (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP INVARIANCE_OF_DOMAIN_HOMEOMORPHISM) THEN
    REWRITE_TAC [homeomorphic] THEN MESON_TAC [])

  return { CONTINUOUS_ON_INVERSE_OPEN, CONTINUOUS_ON_INVERSE_INTO_1D,
           INVARIANCE_OF_DOMAIN_HOMEOMORPHISM, INVARIANCE_OF_DOMAIN_HOMEOMORPHIC }

/- ------------------------------------------------------------------------- -/
/- Homeomorphic intervals, interiors and frontiers.  (paths.ml 27704-27870)  -/
/- ------------------------------------------------------------------------- -/

structure PXH where
  HOMEOMORPHIC_INTERVALS_EQ : thm
  CONTINUOUS_IMAGE_SUBSET_INTERIOR : thm
  HOMEOMORPHIC_INTERIORS_SAME_DIMENSION : thm
  HOMEOMORPHIC_INTERIORS : thm
  HOMEOMORPHIC_FRONTIERS_SAME_DIMENSION : thm
  HOMEOMORPHIC_FRONTIERS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXH [HolBase] (D : PathsDeps) (BXF : PXF) (BXG : PXG) : ExceptT String IO PXH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CART_EQ, CONJ_ASSOC, DIFF_EMPTY, .. } := D.cvx.core1
  let { IMAGE_CLAUSES, IMAGE_SUBSET, .. } := D.cvx.core2
  let { LAMBDA_BETA, LE_ANTISYM, LE_REFL, MONO_EXISTS, .. } := D.cvx.core3
  let { SUBSET, .. } := D.cvx.core5
  let { SURJECTIVE_IMAGE_EQ, SWAP_EXISTS_THM, .. } := D.cvx.core6
  let { INTERVAL_NE_EMPTY, IN_INTERVAL, .. } := D.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, linear, .. } := D.cvx.vec4
  let { CLOSURE_CLOSED, .. } := D.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, .. } := D.cvx.top3
  let { HOMEOMORPHIC_TRANS, INTERIOR_EMPTY, INTERIOR_MAXIMAL, INTERIOR_SUBSET,
        LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { OPEN_INTERIOR, OPEN_INTERVAL, frontier, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { COMPACT_INTERVAL_EQ, .. } := D.ptop1
  let { FRONTIER_SUBSET_CLOSED, HOMEOMORPHIC_COMPACTNESS, HOMEOMORPHIC_MINIMAL, .. } := D.ptop3
  let { HOMEOMORPHIC_OPEN_INTERVALS, .. } := D.ptop4
  let { OPEN_EMPTY, .. } := D.ptop5
  let { CONVEX_INTERVAL, .. } := D.pcvx2
  let { INVARIANCE_OF_DIMENSION, HOMEOMORPHIC_CONVEX_COMPACT_SETS_EQ,
        INVARIANCE_OF_DOMAIN_GEN, .. } := BXF
  let { INVARIANCE_OF_DOMAIN_HOMEOMORPHIC, .. } := BXG
  -- @@SCOPE END

  let HOMEOMORPHIC_INTERVALS_EQ ← prove
   r"(!a b:real^M c d:real^N.
          interval[a,b] homeomorphic interval[c,d] <=>
          aff_dim(interval[a,b]) = aff_dim(interval[c,d])) /\
     (!a b:real^M c d:real^N.
          interval[a,b] homeomorphic interval(c,d) <=>
          interval[a,b] = {} /\ interval(c,d) = {}) /\
     (!a b:real^M c d:real^N.
          interval(a,b) homeomorphic interval[c,d] <=>
          interval(a,b) = {} /\ interval[c,d] = {}) /\
     (!a b:real^M c d:real^N.
          interval(a,b) homeomorphic interval(c,d) <=>
          interval(a,b) = {} /\ interval(c,d) = {} \/
          ~(interval(a,b) = {}) /\ ~(interval(c,d) = {}) /\
          dimindex(:M) = dimindex(:N))"
   (SIMP_TAC [HOMEOMORPHIC_CONVEX_COMPACT_SETS_EQ, CONVEX_INTERVAL,
             COMPACT_INTERVAL] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [HOMEOMORPHIC_EMPTY] THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_COMPACTNESS) THEN
      REWRITE_TAC [COMPACT_INTERVAL_EQ] THEN ASM_MESON_TAC [HOMEOMORPHIC_EMPTY],
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_COMPACTNESS) THEN
      REWRITE_TAC [COMPACT_INTERVAL_EQ] THEN ASM_MESON_TAC [HOMEOMORPHIC_EMPTY],
      MATCH_MP_TAC (← TAUT
       (← q r"(p <=> q) /\ (~p /\ ~q ==> r) ==> p /\ q \/ ~p /\ ~q /\ r")) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [HOMEOMORPHIC_EMPTY], STRIP_TAC] THEN
      REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THEN
      MATCH_MP_TAC INVARIANCE_OF_DIMENSION THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THENL
       [ALL_TAC, GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      REWRITE_TAC [homeomorphism] THEN STRIP_TAC THENL
       [EXISTS_TAC (← q r"interval(a:real^M,b)"),
        EXISTS_TAC (← q r"interval(c:real^N,d)")] THEN
      ASM_REWRITE_TAC [OPEN_INTERVAL] THEN ASM SET_TAC [],
      TRANS_TAC HOMEOMORPHIC_TRANS
       (← q r"IMAGE ((\x. lambda i. x$i):real^M->real^N)
              (interval(a,b))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INVARIANCE_OF_DOMAIN_HOMEOMORPHIC THEN
        REPEAT CONJ_TAC THENL
         [ASM_MESON_TAC [LE_REFL],
          MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
          SIMP_TAC [linear, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                   LAMBDA_BETA, CART_EQ],
          REWRITE_TAC [OPEN_INTERVAL],
          SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN ASM_MESON_TAC []],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"IMAGE ((\x. lambda i. x$i):real^M->real^N)
              (interval(a,b)) =
              interval((lambda i. a$i),(lambda i. b$i))")
      SUBST1_TAC THENL
       [MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
        SIMP_TAC [IN_INTERVAL, LAMBDA_BETA] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
        X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"(lambda i. (y:real^N)$i):real^M") THEN
        SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
        FIRST_ASSUM (SUBST1_TAC o SYM) THEN   SIMP_TAC [CART_EQ, LAMBDA_BETA],
        MATCH_MP_TAC HOMEOMORPHIC_OPEN_INTERVALS THEN
        GEN_REWRITE_TAC id [← TAUT (← q r"(p <=> q) <=> (~p <=> ~q)")] THEN
        SIMP_TAC [INTERVAL_NE_EMPTY, LAMBDA_BETA] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE id [INTERVAL_NE_EMPTY])) THEN
        ASM_MESON_TAC []]])

  let CONTINUOUS_IMAGE_SUBSET_INTERIOR ← prove
   r"!f:real^M->real^N s.
          f continuous_on s /\ dimindex(:N) <= dimindex(:M) /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> IMAGE f (interior s) SUBSET interior(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_MAXIMAL THEN
    SIMP_TAC [IMAGE_SUBSET, INTERIOR_SUBSET] THEN
    ASM_CASES_TAC (← q r"interior s:real^M->bool = {}") THENL
     [ASM_REWRITE_TAC [INTERIOR_EMPTY, OPEN_EMPTY, IMAGE_CLAUSES],
      MATCH_MP_TAC INVARIANCE_OF_DOMAIN_GEN] THEN
    ASM_REWRITE_TAC [OPEN_INTERIOR] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET, SUBSET])

  let HOMEOMORPHIC_INTERIORS_SAME_DIMENSION ← prove
   r"!s:real^M->bool t:real^N->bool.
          dimindex(:M) = dimindex(:N) /\ s homeomorphic t
          ==> (interior s) homeomorphic (interior t)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] INTERIOR_SUBSET] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
    REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"t = IMAGE (f:real^M->real^N) s") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_INTERIOR THEN
        ASM_MESON_TAC [LE_REFL]],
      SUBGOAL_THEN (← q r"s = IMAGE (g:real^N->real^M) t") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_INTERIOR THEN
        ASM_MESON_TAC [LE_REFL]],
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET]])

  let HOMEOMORPHIC_INTERIORS ← prove
   r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t /\ (interior s = {} <=> interior t = {})
          ==> (interior s) homeomorphic (interior t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"interior t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_EMPTY] THEN STRIP_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_INTERIORS_SAME_DIMENSION THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
     (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION THENL
     [MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"interior s:real^M->bool"],
      MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^M", ← q r"interior t:real^N->bool"]] THEN
    ASM_REWRITE_TAC [OPEN_INTERIOR] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET, SUBSET])

  let HOMEOMORPHIC_FRONTIERS_SAME_DIMENSION ← prove
   r"!s:real^M->bool t:real^N->bool.
          dimindex(:M) = dimindex(:N) /\
          s homeomorphic t /\ closed s /\ closed t
          ==> (frontier s) homeomorphic (frontier t)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] FRONTIER_SUBSET_CLOSED] THEN
    STRIP_TAC THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [FRONTIER_SUBSET_CLOSED, CONTINUOUS_ON_SUBSET]] THEN
    ASM_SIMP_TAC [frontier, CLOSURE_CLOSED] THEN
    SUBGOAL_THEN
     (← q r"(!x:real^M. x IN interior s ==> f x IN interior t) /\
      (!y:real^N. y IN interior t ==> g y IN interior s)")
    MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"t = IMAGE (f:real^M->real^N) s") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_INTERIOR THEN
        ASM_MESON_TAC [LE_REFL]],
      SUBGOAL_THEN (← q r"s = IMAGE (g:real^N->real^M) t") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_INTERIOR THEN
        ASM_MESON_TAC [LE_REFL]]])

  let HOMEOMORPHIC_FRONTIERS ← prove
   r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t /\ closed s /\ closed t /\
          (interior s = {} <=> interior t = {})
          ==> (frontier s) homeomorphic (frontier t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"interior t:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [frontier, CLOSURE_CLOSED, DIFF_EMPTY], STRIP_TAC] THEN
    MATCH_MP_TAC HOMEOMORPHIC_FRONTIERS_SAME_DIMENSION THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
     (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION THENL
     [MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"interior s:real^M->bool"],
      MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^M", ← q r"interior t:real^N->bool"]] THEN
    ASM_REWRITE_TAC [OPEN_INTERIOR] THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET, SUBSET])

  return { HOMEOMORPHIC_INTERVALS_EQ, CONTINUOUS_IMAGE_SUBSET_INTERIOR,
           HOMEOMORPHIC_INTERIORS_SAME_DIMENSION, HOMEOMORPHIC_INTERIORS,
           HOMEOMORPHIC_FRONTIERS_SAME_DIMENSION, HOMEOMORPHIC_FRONTIERS }

/- ------------------------------------------------------------------------- -/
/- Homeomorphic relative interiors and relative boundaries.                  -/
/- (paths.ml 27871-28025)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXI where
  CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR : thm
  HOMEOMORPHIC_RELATIVE_INTERIORS_SAME_DIMENSION : thm
  HOMEOMORPHIC_RELATIVE_INTERIORS : thm
  HOMEOMORPHIC_RELATIVE_BOUNDARIES_SAME_DIMENSION : thm
  HOMEOMORPHIC_RELATIVE_BOUNDARIES : thm
  UNIFORMLY_CONTINUOUS_HOMEOMORPHISM_UNIV_TRIVIAL : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXI [HolBase] (D : PathsDeps) (BXE : PXE) (BXF : PXF) : ExceptT String IO PXI := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, DIFF_EMPTY, .. } := D.cvx.core1
  let { IMAGE_SUBSET, INT_LE_ANTISYM, INT_LE_REFL, INT_LE_TRANS, IN_DIFF, .. } := D.cvx.core2
  let { IN_UNIV, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { SUBSET, SUBSET_DIFF, SUBSET_TRANS, .. } := D.cvx.core5
  let { o_DEF, .. } := D.cvx.core6
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, .. } := D.cvx.top3
  let { OPEN_UNIV, homeomorphism, .. } := D.cvx.top5
  let { ALWAYS_EVENTUALLY, .. } := D.pmet1
  let { CLOPEN, COMPLETE_EQ_CLOSED, .. } := D.ptop1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONVERGENT_EQ_CAUCHY, HOMEOMORPHIC_MINIMAL, .. } :=
    D.ptop3
  let { LIM_CONTINUOUS_FUNCTION, LIM_TRANSFORM_EVENTUALLY, .. } := D.ptop4
  let { UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS, complete, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFF_DIM_AFFINE_HULL, AFF_DIM_SUBSET, .. } := D.pcvx1
  let { OPEN_IN_RELATIVE_INTERIOR, RELATIVE_INTERIOR_MAXIMAL, RELATIVE_INTERIOR_SUBSET, .. } :=
    D.pcvx2
  let { INVARIANCE_OF_DOMAIN, .. } := BXE
  let { INVARIANCE_OF_DOMAIN_AFFINE_SETS, INVARIANCE_OF_DIMENSION_AFFINE_SETS, .. } := BXF
  -- @@SCOPE END

  let CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR ← prove
   r"!f:real^M->real^N s t.
          f continuous_on s /\ IMAGE f s SUBSET t /\ aff_dim t <= aff_dim s /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
          ==> IMAGE f (relative_interior s) SUBSET relative_interior(IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC RELATIVE_INTERIOR_MAXIMAL THEN
    SIMP_TAC [IMAGE_SUBSET, RELATIVE_INTERIOR_SUBSET] THEN
    MATCH_MP_TAC INVARIANCE_OF_DOMAIN_AFFINE_SETS THEN
    EXISTS_TAC (← q r"affine hull s:real^M->bool") THEN
    ASM_REWRITE_TAC [AFFINE_AFFINE_HULL, AFF_DIM_AFFINE_HULL] THEN
    REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [AFF_DIM_SUBSET, INT_LE_TRANS], ALL_TAC] THEN
    ASSUME_TAC (← ISPEC (← q r"s:real^M->bool") RELATIVE_INTERIOR_SUBSET) THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"IMAGE (f:real^M->real^N) s") THEN
    SIMP_TAC [IMAGE_SUBSET, RELATIVE_INTERIOR_SUBSET, HULL_SUBSET])

  let HOMEOMORPHIC_RELATIVE_INTERIORS_SAME_DIMENSION ← prove
   r"!s:real^M->bool t:real^N->bool.
          aff_dim s = aff_dim t /\ s homeomorphic t
          ==> (relative_interior s) homeomorphic (relative_interior t)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] RELATIVE_INTERIOR_SUBSET] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
    REPEAT CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"t = IMAGE (f:real^M->real^N) s") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [INT_LE_REFL] THEN
        ASM SET_TAC []],
      SUBGOAL_THEN (← q r"s = IMAGE (g:real^N->real^M) t") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [INT_LE_REFL] THEN
        ASM SET_TAC []],
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, RELATIVE_INTERIOR_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, RELATIVE_INTERIOR_SUBSET]])

  let HOMEOMORPHIC_RELATIVE_INTERIORS ← prove
   r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t /\
          (relative_interior s = {} <=> relative_interior t = {})
          ==> (relative_interior s) homeomorphic (relative_interior t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"relative_interior t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_EMPTY] THEN STRIP_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_RELATIVE_INTERIORS_SAME_DIMENSION THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
     (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    REWRITE_TAC [← GSYM INT_LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION_AFFINE_SETS THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"f:real^M->real^N", ← q r"relative_interior s:real^M->bool"],
      MAP_EVERY EXISTS_TAC
       [← q r"g:real^N->real^M", ← q r"relative_interior t:real^N->bool"]] THEN
    ASM_REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR, AFFINE_AFFINE_HULL] THEN
    (REPEAT CONJ_TAC THENL
      [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, RELATIVE_INTERIOR_SUBSET],
       ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, HULL_SUBSET, ← SET_RULE
        (← q r"(!x. x IN s ==> f x IN t) /\ s' SUBSET s /\ t SUBSET t'
         ==> IMAGE f s' SUBSET t'")],
       ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, SUBSET]]))

  let HOMEOMORPHIC_RELATIVE_BOUNDARIES_SAME_DIMENSION ← prove
   r"!s:real^M->bool t:real^N->bool.
          aff_dim s = aff_dim t /\ s homeomorphic t
          ==> (s DIFF relative_interior s) homeomorphic
              (t DIFF relative_interior t)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    REWRITE_TAC [HOMEOMORPHIC_MINIMAL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^M") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [IN_DIFF] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [SUBSET_DIFF, CONTINUOUS_ON_SUBSET]] THEN
    SUBGOAL_THEN
     (← q r"(!x:real^M. x IN relative_interior s ==> f x IN relative_interior t) /\
      (!y:real^N. y IN relative_interior t ==> g y IN relative_interior s)")
    MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"t = IMAGE (f:real^M->real^N) s") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [INT_LE_REFL] THEN
        ASM SET_TAC []],
      SUBGOAL_THEN (← q r"s = IMAGE (g:real^N->real^M) t") SUBST1_TAC THENL
       [ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [INT_LE_REFL] THEN
        ASM SET_TAC []]])

  let HOMEOMORPHIC_RELATIVE_BOUNDARIES ← prove
   r"!s:real^M->bool t:real^N->bool.
          s homeomorphic t /\
          (relative_interior s = {} <=> relative_interior t = {})
          ==> (s DIFF relative_interior s) homeomorphic
              (t DIFF relative_interior t)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"relative_interior t:real^N->bool = {}") THEN
    ASM_SIMP_TAC [DIFF_EMPTY] THEN STRIP_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_RELATIVE_BOUNDARIES_SAME_DIMENSION THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
     (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MINIMAL]) THEN
    ONCE_REWRITE_TAC [← GSYM AFF_DIM_AFFINE_HULL] THEN
    REWRITE_TAC [← GSYM INT_LE_ANTISYM] THEN CONJ_TAC THEN
    MATCH_MP_TAC INVARIANCE_OF_DIMENSION_AFFINE_SETS THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"f:real^M->real^N", ← q r"relative_interior s:real^M->bool"],
      MAP_EVERY EXISTS_TAC
       [← q r"g:real^N->real^M", ← q r"relative_interior t:real^N->bool"]] THEN
    ASM_REWRITE_TAC [OPEN_IN_RELATIVE_INTERIOR, AFFINE_AFFINE_HULL] THEN
    (REPEAT CONJ_TAC THENL
      [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, RELATIVE_INTERIOR_SUBSET],
       ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, HULL_SUBSET, ← SET_RULE
        (← q r"(!x. x IN s ==> f x IN t) /\ s' SUBSET s /\ t SUBSET t'
         ==> IMAGE f s' SUBSET t'")],
       ASM_MESON_TAC [RELATIVE_INTERIOR_SUBSET, SUBSET]]))

  let UNIFORMLY_CONTINUOUS_HOMEOMORPHISM_UNIV_TRIVIAL ← prove
   r"!f g s:real^N->bool.
          homeomorphism (s,(:real^N)) (f,g) /\ f uniformly_continuous_on s
          ==> s = (:real^N)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphism, IN_UNIV] THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THENL [SET_TAC [], STRIP_TAC] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOPEN) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM COMPLETE_EQ_CLOSED, complete] THEN
      X_GEN_TAC (← q r"x:num->real^N") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"cauchy ((f:real^N->real^N) o x)") MP_TAC THENL
       [ASM_MESON_TAC [UNIFORMLY_CONTINUOUS_IMP_CAUCHY_CONTINUOUS], ALL_TAC] THEN
      REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"l:real^N")) THEN
      EXISTS_TAC (← q r"(g:real^N->real^N) l") THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
      EXISTS_TAC (← q r"(g:real^N->real^N) o (f:real^N->real^N) o (x:num->real^N)") THEN
      REWRITE_TAC [o_DEF] THEN CONJ_TAC THENL
       [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM SET_TAC [],
        MATCH_MP_TAC LIM_CONTINUOUS_FUNCTION THEN ASM_SIMP_TAC [← GSYM o_DEF] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_UNIV, IN_UNIV]],
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      MATCH_MP_TAC INVARIANCE_OF_DOMAIN THEN
      ASM_REWRITE_TAC [OPEN_UNIV] THEN ASM SET_TAC []])

  return { CONTINUOUS_IMAGE_SUBSET_RELATIVE_INTERIOR,
           HOMEOMORPHIC_RELATIVE_INTERIORS_SAME_DIMENSION, HOMEOMORPHIC_RELATIVE_INTERIORS,
           HOMEOMORPHIC_RELATIVE_BOUNDARIES_SAME_DIMENSION, HOMEOMORPHIC_RELATIVE_BOUNDARIES,
           UNIFORMLY_CONTINUOUS_HOMEOMORPHISM_UNIV_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Invariance of domain for spheres; homeomorphic balls.                     -/
/- (paths.ml 28026-28276)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXJ where
  INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET_GEN : thm
  INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET : thm
  NO_EMBEDDING_SPHERE_LOWDIM : thm
  EMPTY_INTERIOR_LOWDIM_GEN : thm
  EMPTY_INTERIOR_LOWDIM_GEN_LE : thm
  HOMEOMORPHIC_HYPERPLANES_EQ : thm
  HOMEOMORPHIC_UNIV_UNIV : thm
  HOMEOMORPHIC_CBALLS_EQ : thm
  HOMEOMORPHIC_BALLS_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXJ [HolBase] (D : PathsDeps) (BWB : PWB) (BXE : PXE) (BXF : PXF) (BXH : PXH) :
    ExceptT String IO PXJ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, MESON, REAL_ARITH, SET_RULE, SET_TAC,
        GEOM_EQUAL_DIMENSION_RULE, .. } := D.cvx
  let { ARITH, CARD_CLAUSES, CONTRAPOS_THM, DIMINDEX_GE_1, EQ_IMP, EQ_TRANS, FINITE_EMPTY,
        FINITE_SING, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_UNION, IMAGE_o, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, INT_OF_NUM_EQ, INT_OF_NUM_LT, IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_ANTISYM, LE_REFL, LT_IMP_LE,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, NOT_LT, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_NE, REAL_LT_REFL, .. } := D.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.cvx.core5
  let { SUBSET_UNIV, o_THM, .. } := D.cvx.core6
  let { DIM_UNIV, DOT_BASIS, .. } := D.cvx.vec1
  let { PRESERVES_NORM_INJECTIVE, SUBSPACE_UNIV, .. } := D.cvx.vec3
  let { OPEN_IN_EMPTY, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { BALL_EMPTY, BALL_EQ_EMPTY, BALL_SUBSET_CBALL, BOUNDED_CBALL, CBALL_EMPTY, CBALL_EQ_EMPTY,
        CBALL_TRIVIAL, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_SPHERE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, EMPTY_INTERIOR_LOWDIM,
        HOMEOMORPHIC_EMPTY, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM, HOMEOMORPHISM_IMP_OPEN_MAP, OPEN_BALL, .. } :=
    D.cvx.top4
  let { OPEN_IN, OPEN_IN_OPEN, OPEN_IN_REFL, SUBSET_INTERIOR, homeomorphic, homeomorphism, .. } :=
    D.cvx.top5
  let { EQ_IMP_LE, LE_LT, .. } := D.pses1
  let { DIM_INJECTIVE_LINEAR_IMAGE, ISOMETRY_SUBSET_SUBSPACE, .. } := D.pvec
  let { OPEN_IN_SUBTOPOLOGY_EMPTY, OPEN_IN_UNION, .. } := D.pmet2
  let { COMPACT_OPEN, .. } := D.ptop1
  let { FINITE_CBALL, HOMEOMORPHIC_BALLS, HOMEOMORPHIC_CBALLS, HOMEOMORPHIC_FINITE_STRONG,
        HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ, .. } := D.ptop3
  let { SPHERE_EQ_EMPTY, .. } := D.ptop5
  let { AFFINE_HYPERPLANE, AFFINE_UNIV, AFF_DIM_CBALL, AFF_DIM_HYPERPLANE, AFF_DIM_LE_UNIV,
        AFF_DIM_POS_LE, AFF_DIM_UNIV, CHOOSE_AFFINE_SUBSET, CONVEX_CBALL, .. } := D.pcvx1
  let { RELATIVE_FRONTIER_CBALL, RELATIVE_FRONTIER_EMPTY, RELATIVE_FRONTIER_NOT_SING, .. } :=
    D.pcvx2
  let { HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE_GEN, .. } := BWB
  let { HOMEOMORPHIC_SUBSPACES_EQ, HOMEOMORPHIC_AFFINE_SETS_EQ, .. } := BXE
  let { INVARIANCE_OF_DOMAIN_AFFINE_SETS, INVARIANCE_OF_DIMENSION, .. } := BXF
  let { HOMEOMORPHIC_INTERIORS_SAME_DIMENSION, .. } := BXH
  -- @@SCOPE END

  let INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET_GEN ← prove
   r"!f:real^M->real^N u s t.
          f continuous_on s /\ IMAGE f s SUBSET t /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
          bounded u /\ convex u /\ affine t /\ aff_dim t < aff_dim u /\
          open_in (subtopology euclidean (relative_frontier u)) s
          ==> open_in (subtopology euclidean t) (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"relative_frontier u:real^M->bool = {}") THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_EMPTY, IMAGE_CLAUSES, OPEN_IN_EMPTY] THEN
    STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    SUBGOAL_THEN
     (← q r"?b c:real^M. b IN relative_frontier u /\ c IN relative_frontier u /\
                   ~(b = c)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"~(s = {} \/ ?x. s = {x}) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)")) THEN
      ASM_MESON_TAC [RELATIVE_FRONTIER_NOT_SING],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"aff_dim(u:real^M->bool) - &1"]
          CHOOSE_AFFINE_SUBSET) THEN
    REWRITE_TAC [SUBSET_UNIV, AFFINE_UNIV] THEN ANTS_TAC THENL
     [MATCH_MP_TAC (← INT_ARITH
       (← q r"&0:int <= t /\ t <= n ==> --a <= t - a /\ t - &1 <= n")) THEN
      REWRITE_TAC [AFF_DIM_LE_UNIV, AFF_DIM_UNIV, AFF_DIM_POS_LE] THEN
      ASM_MESON_TAC [RELATIVE_FRONTIER_EMPTY, NOT_IN_EMPTY],
      DISCH_THEN (X_CHOOSE_THEN (← q r"af:real^M->bool") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL [← q r"u:real^M->bool", ← q r"af:real^M->bool"]
          HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE_GEN) THEN
    ASM_REWRITE_TAC [← INT_ARITH (← q r"x - a + a:int = x")] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"c:real^M") th) THEN
            MP_TAC (← SPEC (← q r"b:real^M") th))) THEN
    ASM_REWRITE_TAC [homeomorphic, homeomorphism, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^M->real^M", ← q r"h:real^M->real^M"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"j:real^M->real^M", ← q r"k:real^M->real^M"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(f:real^M->real^N) o (k:real^M->real^M)",
      ← q r"(af:real^M->bool)",
      ← q r"t:real^N->bool", ← q r"IMAGE (j:real^M->real^M) (s DELETE c)"]
     INVARIANCE_OF_DOMAIN_AFFINE_SETS) THEN
    MP_TAC (← ISPECL
     [← q r"(f:real^M->real^N) o (h:real^M->real^M)",
      ← q r"(af:real^M->bool)",
      ← q r"t:real^N->bool", ← q r"IMAGE (g:real^M->real^M) (s DELETE b)"]
     INVARIANCE_OF_DOMAIN_AFFINE_SETS) THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_REWRITE_TAC [IMP_IMP, ← INT_ARITH (← q r"x:int <= y - &1 <=> x < y")] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p1 /\ p2) /\ (q1 /\ q2 ==> r) ==> (p1 ==> q1) /\ (p2 ==> q2) ==> r")) THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_DELETE]) THEN
      ASM_SIMP_TAC [o_THM, IN_DELETE, IMP_CONJ] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN MAP_EVERY EXISTS_TAC
       [← q r"h:real^M->real^M", ← q r"relative_frontier u DELETE (b:real^M)"] THEN
      ASM_SIMP_TAC [homeomorphism, DOT_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, OPEN_IN_OPEN] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_DELETE]) THEN
      ASM_SIMP_TAC [o_THM, IN_DELETE, IMP_CONJ] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN MAP_EVERY EXISTS_TAC
       [← q r"k:real^M->real^M", ← q r"relative_frontier u DELETE (c:real^M)"] THEN
      ASM_SIMP_TAC [homeomorphism, DOT_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, OPEN_IN_OPEN] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP OPEN_IN_UNION) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"IMAGE (f:real^M->real^N)
                        ((s DELETE b) UNION (s DELETE c))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IMAGE_UNION] THEN BINOP_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [IMAGE_o] THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET ← prove
   r"!f:real^M->real^N a r s t.
          f continuous_on s /\ IMAGE f s SUBSET t /\
          (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
          ~(r = &0) /\ affine t /\ aff_dim t < &(dimindex(:M)) /\
          open_in (subtopology euclidean (sphere(a,r))) s
          ==> open_in (subtopology euclidean t) (IMAGE f s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"sphere(a:real^M,r) = {}") THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_EMPTY, OPEN_IN_EMPTY, IMAGE_CLAUSES] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SPHERE_EQ_EMPTY, REAL_NOT_LT]) THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"cball(a:real^M,r)",
                   ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET_GEN) THEN
    ASM_REWRITE_TAC [AFF_DIM_CBALL, RELATIVE_FRONTIER_CBALL,
                    BOUNDED_CBALL, CONVEX_CBALL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let NO_EMBEDDING_SPHERE_LOWDIM ← prove
   r"!f:real^M->real^N a r.
          &0 < r /\
          f continuous_on sphere(a,r) /\
          (!x y. x IN sphere(a,r) /\ y IN sphere(a,r) /\ f x = f y ==> x = y)
          ==> dimindex(:M) <= dimindex(:N)"
   (REWRITE_TAC [← GSYM NOT_LT] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"IMAGE (f:real^M->real^N) (sphere(a:real^M,r))")
          COMPACT_OPEN) THEN
    ASM_SIMP_TAC [COMPACT_CONTINUOUS_IMAGE, IMAGE_EQ_EMPTY,
                 COMPACT_SPHERE, SPHERE_EQ_EMPTY,
                 ← REAL_ARITH (← q r"&0 < r ==> ~(r < &0)")] THEN
    ONCE_REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    MATCH_MP_TAC INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^M", ← q r"r:real"] THEN
    ASM_REWRITE_TAC [AFFINE_UNIV, SUBSET_UNIV, AFF_DIM_UNIV,
                    OPEN_IN_REFL, INT_OF_NUM_LT] THEN
    ASM_REAL_ARITH_TAC)

  let EMPTY_INTERIOR_LOWDIM_GEN ← prove
   r"!s:real^N->bool t:real^M->bool.
          dimindex(:M) < dimindex(:N) /\ s homeomorphic t ==> interior s = {}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:real^M)", ← q r"(:real^N)"] ISOMETRY_SUBSET_SUBSPACE) THEN
    ASM_SIMP_TAC [SUBSPACE_UNIV, DIM_UNIV, LT_IMP_LE, IN_UNIV, SUBSET_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^M->real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← MESON [HOMEOMORPHIC_EMPTY]
     (← q r"!t. interior(t:real^N->bool) homeomorphic interior(s:real^N->bool) /\
          interior t = {}
          ==> interior s = {}")) THEN
    EXISTS_TAC (← q r"IMAGE (h:real^M->real^N) t") THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_INTERIORS_SAME_DIMENSION THEN REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_SYM]) THEN
      MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC HOMEOMORPHIC_INJECTIVE_LINEAR_IMAGE_LEFT_EQ THEN
      ASM_MESON_TAC [PRESERVES_NORM_INJECTIVE],
      MATCH_MP_TAC (← SET_RULE (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
      EXISTS_TAC (← q r"interior(IMAGE (h:real^M->real^N) (:real^M))") THEN
      SIMP_TAC [SUBSET_INTERIOR, ← SET_RULE (← q r"IMAGE f s SUBSET IMAGE f UNIV")] THEN
      MATCH_MP_TAC EMPTY_INTERIOR_LOWDIM THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          LET_TRANS)) THEN
      REWRITE_TAC [← GSYM DIM_UNIV] THEN
      MATCH_MP_TAC EQ_IMP_LE THEN MATCH_MP_TAC DIM_INJECTIVE_LINEAR_IMAGE THEN
      ASM_MESON_TAC [PRESERVES_NORM_INJECTIVE]])

  let EMPTY_INTERIOR_LOWDIM_GEN_LE ← prove
   r"!s:real^N->bool t:real^M->bool.
          dimindex(:M) <= dimindex(:N) /\
          interior t = {} /\
          s homeomorphic t
          ==> interior s = {}"
   (REWRITE_TAC [LE_LT] THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [EMPTY_INTERIOR_LOWDIM_GEN],
      ASM_MESON_TAC [HOMEOMORPHIC_INTERIORS_SAME_DIMENSION,
                    HOMEOMORPHIC_EMPTY]])

  let HOMEOMORPHIC_HYPERPLANES_EQ ← prove
   r"!a:real^M b c:real^N d.
          ~(a = vec 0) /\ ~(c = vec 0)
          ==> ({x | a dot x = b} homeomorphic {x | c dot x = d} <=>
               dimindex(:M) = dimindex(:N))"
   (SIMP_TAC [HOMEOMORPHIC_AFFINE_SETS_EQ, AFFINE_HYPERPLANE] THEN
    SIMP_TAC [AFF_DIM_HYPERPLANE, INT_OF_NUM_EQ,
            ← INT_ARITH (← q r"x - &1:int = y - &1 <=> x = y")])

  let HOMEOMORPHIC_UNIV_UNIV ← prove
   r"(:real^M) homeomorphic (:real^N) <=> dimindex(:M) = dimindex(:N)"
   (SIMP_TAC [HOMEOMORPHIC_SUBSPACES_EQ, DIM_UNIV, SUBSPACE_UNIV])

  let HOMEOMORPHIC_CBALLS_EQ ← prove
   r"!a:real^M b:real^N r s.
          cball(a,r) homeomorphic cball(b,s) <=>
          r < &0 /\ s < &0 \/ r = &0 /\ s = &0 \/
          &0 < r /\ &0 < s /\ dimindex(:M) = dimindex(:N)"
   (← do
    let lemma ← (do
      let d ← q r"dimindex(:M) = dimindex(:N)"
      let t ← q r"?a:real^M b:real^N. ~(cball(a,r) homeomorphic cball(b,s))"
      DISCH d (← DISCH t (← GEOM_EQUAL_DIMENSION_RULE (← ASSUME d) (← ASSUME t)))
      : ExceptT String IO thm)
    pure (
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r < &0") THENL
     [ASM_SIMP_TAC [CBALL_EMPTY, HOMEOMORPHIC_EMPTY, CBALL_EQ_EMPTY] THEN
      EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN ASM_REWRITE_TAC [REAL_LT_REFL] THENL
     [ASM_SIMP_TAC [CBALL_TRIVIAL, FINITE_SING, HOMEOMORPHIC_FINITE_STRONG] THEN
      REWRITE_TAC [FINITE_CBALL] THEN
      ASM_CASES_TAC (← q r"s < &0") THEN
      ASM_SIMP_TAC [CBALL_EMPTY, CARD_CLAUSES, FINITE_EMPTY,
                   NOT_IN_EMPTY, ARITH, REAL_LT_IMP_NE] THEN
      ASM_CASES_TAC (← q r"s = &0") THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [CBALL_TRIVIAL, CARD_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY,
                   REAL_LE_REFL, ARITH],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s <= &0") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_FINITE_STRONG, FINITE_CBALL] THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < s") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [REWRITE_TAC [homeomorphic, HOMEOMORPHISM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THEN
      MATCH_MP_TAC INVARIANCE_OF_DIMENSION THENL
       [MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"ball(a:real^M,r)"] THEN
        MP_TAC (← ISPECL [← q r"a:real^M", ← q r"r:real"] BALL_SUBSET_CBALL),
        MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^M", ← q r"ball(b:real^N,s)"] THEN
        MP_TAC (← ISPECL [← q r"b:real^N", ← q r"s:real"] BALL_SUBSET_CBALL)] THEN
      ASM_REWRITE_TAC [BALL_EQ_EMPTY, OPEN_BALL, REAL_NOT_LE] THEN
      ASM_MESON_TAC [SUBSET, CONTINUOUS_ON_SUBSET],
      DISCH_THEN (MP_TAC o MATCH_MP lemma) THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN ASM_SIMP_TAC [HOMEOMORPHIC_CBALLS]]))

  let HOMEOMORPHIC_BALLS_EQ ← prove
   r"!a:real^M b:real^N r s.
          ball(a,r) homeomorphic ball(b,s) <=>
          r <= &0 /\ s <= &0 \/
          &0 < r /\ &0 < s /\ dimindex(:M) = dimindex(:N)"
   (← do
    let lemma ← (do
      let d ← q r"dimindex(:M) = dimindex(:N)"
      let t ← q r"?a:real^M b:real^N. ~(ball(a,r) homeomorphic ball(b,s))"
      DISCH d (← DISCH t (← GEOM_EQUAL_DIMENSION_RULE (← ASSUME d) (← ASSUME t)))
      : ExceptT String IO thm)
    pure (
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r <= &0") THENL
     [ASM_SIMP_TAC [BALL_EMPTY, HOMEOMORPHIC_EMPTY, BALL_EQ_EMPTY] THEN
      EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s <= &0") THENL
     [ASM_SIMP_TAC [BALL_EMPTY, HOMEOMORPHIC_EMPTY, BALL_EQ_EMPTY] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE]) THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [REWRITE_TAC [homeomorphic, HOMEOMORPHISM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
      STRIP_TAC THEN REWRITE_TAC [← GSYM LE_ANTISYM] THEN CONJ_TAC THEN
      MATCH_MP_TAC INVARIANCE_OF_DIMENSION THENL
       [MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"ball(a:real^M,r)"],
        MAP_EVERY EXISTS_TAC [← q r"g:real^N->real^M", ← q r"ball(b:real^N,s)"]] THEN
      ASM_REWRITE_TAC [BALL_EQ_EMPTY, OPEN_BALL, REAL_NOT_LE] THEN
      ASM SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP lemma) THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN ASM_SIMP_TAC [HOMEOMORPHIC_BALLS]]))

  return { INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET_GEN, INVARIANCE_OF_DOMAIN_SPHERE_AFFINE_SET,
           NO_EMBEDDING_SPHERE_LOWDIM, EMPTY_INTERIOR_LOWDIM_GEN, EMPTY_INTERIOR_LOWDIM_GEN_LE,
           HOMEOMORPHIC_HYPERPLANES_EQ, HOMEOMORPHIC_UNIV_UNIV, HOMEOMORPHIC_CBALLS_EQ,
           HOMEOMORPHIC_BALLS_EQ }

/- ------------------------------------------------------------------------- -/
/- General forms of the Jordan curve theorem in setting of R^n.              -/
/- (paths.ml 28277-28503)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXK where
  CARD_EQ_COMPONENTS_COMPLEMENTS : thm
  JORDAN_CURVE_THEOREM_GEN : thm
  JORDAN_INSIDE_OUTSIDE_GEN : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXK [HolBase] (D : PathsDeps) (BUG : PUG) (BUH : PUH) (BUQ : PUQ) (BUR : PUR)
    (BUS : PUS) (BVB : PVB) : ExceptT String IO PXK := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_TAC, HAS_SIZE_CONV,
        NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, .. } := D.cvx
  let { CONJ_ASSOC, DIMINDEX_GE_1, EQ_IMP, EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMP_CONJ, IMP_CONJ_ALT, INTER_UNIV, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS,
        PSUBSET, .. } := D.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_TOTAL, REAL_LT_01, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_NOT_LE, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.cvx.core5
  let { SUBSET_UNIV, UNIONS_2, .. } := D.cvx.core6
  let { FORALL_LIFT, LIFT_DROP, LIFT_EQ, NORM_0, NORM_BASIS, .. } := D.cvx.vec2
  let { NORM_MUL, .. } := D.cvx.vec3
  let { BOUNDED_BALL, BOUNDED_CBALL, BOUNDED_SUBSET, CLOSED_IN, CLOSURE_BALL,
        CLOSURE_COMPLEMENT, .. } := D.cvx.top1
  let { COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_SPHERE,
        CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, INTERIOR_CBALL, IN_BALL, IN_BALL_0,
        IN_CBALL, IN_CBALL_0, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_SPHERE,
        IN_SPHERE_0, IS_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_UNIV, TOPSPACE_EUCLIDEAN, UNIONS_COMPONENTS, closed, homeomorphic,
        homeomorphism, .. } := D.cvx.top5
  let { COMPL_COMPL, .. } := D.pses1
  let { PSUBSET_ALT, .. } := D.pses2
  let { CARD_EQ_CONG, CARD_EQ_IMAGE, CARD_HAS_SIZE_CONG, .. } := D.pcard
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, HOMEOMORPHIC_MAP_CLOSEDNESS,
        HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF, HOMEOMORPHIC_MAP_SUBTOPOLOGIES,
        HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, HOMEOMORPHIC_SPACE_TRANS, .. } := D.pmet1
  let { CLOSED_SPHERE, COBOUNDED_IMP_UNBOUNDED, .. } := D.ptop1
  let { COMPONENTS_NONOVERLAP, COMPONENTS_UNIQUE_2, CONNECTED_EQ_CARD_COMPONENTS,
        CONNECTED_INTERMEDIATE_CLOSURE, CONNECTED_OPEN_SET, CONNECTED_UNION,
        CONNECTED_UNIV, .. } := D.ptop2
  let { EUCLIDEAN_CONNECTED_COMPONENTS_OF, HOMEOMORPHIC_COMPACTNESS,
        HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN, .. } := D.ptop3
  let { HOMEOMORPHIC_SPACE_EUCLIDEAN, HOMEOMORPHISM_IMP_HOMEOMORPHIC, .. } := D.ptop4
  let { CONNECTED_BALL, CONVEX_CBALL, .. } := D.pcvx1
  let { IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { CARD_EQ_CONNECTED_COMPONENTS_EUCLIDEAN_COMPLEMENTS, .. } := D.phom
  let { OPEN_COMPONENTS, .. } := BUG
  let { FRONTIER_MINIMAL_SEPARATING_CLOSED, .. } := BUH
  let { CONNECTED_COMPLEMENT_BOUNDED_CONVEX, .. } := BUQ
  let { CONNECTED_OPEN_DIFF_CBALL, .. } := BUR
  let { COBOUNDED_UNBOUNDED_COMPONENTS, COBOUNDED_HAS_BOUNDED_COMPONENT, .. } := BUS
  let { INSIDE_OUTSIDE_UNIQUE, .. } := BVB
  -- @@SCOPE END

  let CARD_EQ_COMPONENTS_COMPLEMENTS ← prove
   r"!s t:real^N->bool.
          closed s /\ closed t /\ s homeomorphic t
          ==> components((:real^N) DIFF s) =_c components((:real^N) DIFF t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?f g. homeomorphic_maps (euclidean_space (dimindex (:N)),euclidean)
                              (f:(num->real)->real^N,g)")
    STRIP_ASSUME_TAC THENL
     [MESON_TAC [HOMEOMORPHIC_MAPS_EUCLIDEAN_SPACE_EUCLIDEAN], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"dimindex(:N)",
      ← q r"IMAGE (g:real^N->num->real) s",
      ← q r"IMAGE (g:real^N->num->real) t"]
     CARD_EQ_CONNECTED_COMPONENTS_EUCLIDEAN_COMPLEMENTS) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THENL
         [UNDISCH_TAC (← q r"closed(s:real^N->bool)"),
          UNDISCH_TAC (← q r"closed(t:real^N->bool)")] THEN
        REWRITE_TAC [CLOSED_IN] THEN MATCH_MP_TAC EQ_IMP THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSEDNESS THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
        ASM_MESON_TAC [HOMEOMORPHIC_MAPS_MAP],
        TRANS_TAC HOMEOMORPHIC_SPACE_TRANS
         (← q r"subtopology euclidean (s:real^N->bool)") THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM],
          TRANS_TAC HOMEOMORPHIC_SPACE_TRANS
           (← q r"subtopology euclidean (t:real^N->bool)") THEN
          ASM_REWRITE_TAC [HOMEOMORPHIC_SPACE_EUCLIDEAN]] THEN
        REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN
        EXISTS_TAC (← q r"g:real^N->num->real") THEN
        MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_MAPS_MAP]) THEN
        ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN, INTER_UNIV] THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [TOPSPACE_EUCLIDEAN, HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
        ASM SET_TAC []],
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC CARD_EQ_CONG] THEN
    W (fun g => tactic_of do
      let l ← liftExcept (lhand (snd g))
      let sv ← q r"s:real^N->bool"
      let tm ← liftExcept (HolCore.Bool.mk_forall sv l)
      pure (SUBGOAL_THEN tm (fun th => REWRITE_TAC [th]))) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAPS_MAP]) THEN
    POP_ASSUM_LIST (K ALL_TAC : List thm → tactic) THEN
    SPEC_TAC (← q r"dimindex(:N)", ← q r"n:num") THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [TOPSPACE_EUCLIDEAN, IN_UNIV] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"s:real^N->bool") THEN
    FIRST_ASSUM (MP_TAC o SPECL
     [← q r"(:real^N) DIFF s",
      ← q r"topspace (euclidean_space n) DIFF IMAGE g (s:real^N->bool)"] o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_MAP_SUBTOPOLOGIES)) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (SUBST1_TAC o
        MATCH_MP HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF) THEN
      REWRITE_TAC [EUCLIDEAN_CONNECTED_COMPONENTS_OF] THEN
      MATCH_MP_TAC CARD_EQ_IMAGE] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP, TOPSPACE_EUCLIDEAN] THEN
    SET_TAC [])

  let JORDAN_CURVE_THEOREM_GEN ← prove
   r"!s:real^N->bool.
          2 <= dimindex(:N) /\ s homeomorphic sphere(vec 0:real^N,&1)
          ==> ?ins out.
                   ~(ins = {}) /\ open ins /\ connected ins /\
                   ~(out = {}) /\ open out /\ connected out /\
                   bounded ins /\ ~bounded out /\
                   ins INTER out = {} /\
                   ins UNION out = (:real^N) DIFF s /\
                   frontier ins = s /\
                   frontier out = s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_SPHERE], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"sphere(vec 0:real^N,&1)"]
          CARD_EQ_COMPONENTS_COMPLEMENTS) THEN
    ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_SPHERE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"2") o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CARD_HAS_SIZE_CONG)) THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2)) THEN ANTS_TAC THENL
     [REWRITE_TAC [← HAS_SIZE_CONV (← q r"s HAS_SIZE 2")] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"ball(vec 0:real^N,&1)", ← q r"(:real^N) DIFF cball(vec 0,&1)"] THEN
      CONJ_TAC THENL
       [DISCH_THEN (MP_TAC o AP_TERM (← q r"bounded:(real^N->bool)->bool")) THEN
        REWRITE_TAC [BOUNDED_BALL] THEN
        MATCH_MP_TAC COBOUNDED_IMP_UNBOUNDED THEN
        REWRITE_TAC [BOUNDED_CBALL, COMPL_COMPL],
        MATCH_MP_TAC  COMPONENTS_UNIQUE_2 THEN REWRITE_TAC [CONNECTED_BALL] THEN
        ASM_SIMP_TAC [CONNECTED_COMPLEMENT_BOUNDED_CONVEX,
                     BOUNDED_CBALL, CONVEX_CBALL] THEN
        REWRITE_TAC [EXTENSION, IN_UNION, IN_DIFF, IN_UNIV] THEN
        REWRITE_TAC [IN_CBALL_0, IN_BALL_0, IN_SPHERE_0] THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, DISCH_TAC] THEN MP_TAC (← ISPECL
         [← q r"\x:real^N. lift(norm x)", ← q r"(:real^N) DIFF sphere(vec 0,&1)"]
         CONNECTED_CONTINUOUS_IMAGE) THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1] THEN
        REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^N")) THEN
        REWRITE_TAC [NORM_0, IN_DIFF, IN_SPHERE_0, IN_UNIV, IN_IMAGE] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"&2 % basis 1:real^N")) THEN
        REWRITE_TAC [FORALL_LIFT, LIFT_DROP, NORM_MUL, IN_IMAGE] THEN
        SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"&1:real")) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN MESON_TAC [LIFT_EQ]],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"~connected((:real^N) DIFF s)") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [CONNECTED_EQ_CARD_COMPONENTS] THEN CONV_TAC NUM_REDUCE_CONV,
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") COBOUNDED_HAS_BOUNDED_COMPONENT) THEN
    ASM_SIMP_TAC [COMPL_COMPL, COMPACT_IMP_BOUNDED] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"ins:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:real^N) DIFF s") COBOUNDED_UNBOUNDED_COMPONENTS) THEN
    ASM_SIMP_TAC [COMPL_COMPL, COMPACT_IMP_BOUNDED] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"out:real^N->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM CONNECTED_EQ_CARD_COMPONENTS] THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← TAUT
     (← q r"a /\ b /\ c /\ d /\ e /\ f /\ g <=>
      (a /\ d) /\ (b /\ e) /\ (c /\ f) /\ g")] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY], ALL_TAC] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_COMPONENTS, closed, COMPACT_IMP_CLOSED], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [COMPONENTS_NONOVERLAP], ALL_TAC] THEN
    CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [UNIONS_COMPONENTS] THEN
      ASM_REWRITE_TAC [← GSYM UNIONS_2] THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM (MP_TAC o CONV_RULE HAS_SIZE_CONV) THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!t. closed t /\ t PSUBSET s ==> connected ((:real^N) DIFF t)")
    ASSUME_TAC THENL
     [ALL_TAC,
      CONJ_TAC THEN MATCH_MP_TAC FRONTIER_MINIMAL_SEPARATING_CLOSED THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED]] THEN
    SUBGOAL_THEN
     (← q r"!t. t PSUBSET sphere(vec 0,&1) ==> connected((:real^N) DIFF t)")
    (LABEL_TAC "*") THENL
     [REWRITE_TAC [PSUBSET_ALT, SUBSET, IN_SPHERE, ← GSYM REAL_LE_ANTISYM] THEN
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(:real^N) DIFF t =
        {x:real^N | dist(vec 0,x) <= &1 /\ ~(x IN t)} UNION
        {x:real^N | &1 <= dist(vec 0,x) /\ ~(x IN t)}")
      SUBST1_TAC THENL
       [SET_TAC [REAL_LE_TOTAL], MATCH_MP_TAC CONNECTED_UNION] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
        EXISTS_TAC (← q r"ball(vec 0:real^N,&1)") THEN
        ASM_SIMP_TAC [CONNECTED_BALL, CLOSURE_BALL, SUBSET, IN_BALL, IN_CBALL,
                     REAL_LT_01, IN_ELIM_THM] THEN
        ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_NOT_LE],
        MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
        EXISTS_TAC (← q r"(:real^N) DIFF cball(vec 0,&1)") THEN
        REWRITE_TAC [CLOSURE_COMPLEMENT, SUBSET, IN_DIFF, IN_UNIV,
                    IN_BALL, IN_CBALL, IN_ELIM_THM, INTERIOR_CBALL] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_NOT_LE]] THEN
        MATCH_MP_TAC CONNECTED_OPEN_DIFF_CBALL THEN
        ASM_REWRITE_TAC [SUBSET_UNIV, CONNECTED_UNIV, OPEN_UNIV],
        ASM SET_TAC []],
      X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
      DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
       SPECL [← q r"t:real^N->bool", ← q r"IMAGE (f:real^N->real^N) t"] o
       MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        DISCH_THEN (ASSUME_TAC o MATCH_MP HOMEOMORPHISM_IMP_HOMEOMORPHIC)] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (f:real^N->real^N) t")) THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
        MATCH_MP_TAC EQ_IMP] THEN
      REWRITE_TAC [CONNECTED_EQ_CARD_COMPONENTS] THEN
      MATCH_MP_TAC (← MESON [HAS_SIZE]
        (← q r"(!n. s HAS_SIZE n <=> t HAS_SIZE n)
         ==> (FINITE s /\ CARD s <= m <=> FINITE t /\ CARD t <= m)")) THEN
      GEN_TAC THEN MATCH_MP_TAC CARD_HAS_SIZE_CONG THEN
      MATCH_MP_TAC CARD_EQ_COMPONENTS_COMPLEMENTS THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMEOMORPHIC_SYM]] THEN
      MATCH_MP_TAC COMPACT_IMP_CLOSED THEN
      SUBGOAL_THEN (← q r"compact(t:real^N->bool)") MP_TAC THENL
       [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET, PSUBSET],
        MATCH_MP_TAC EQ_IMP] THEN
      MATCH_MP_TAC HOMEOMORPHIC_COMPACTNESS THEN ASM_REWRITE_TAC []])

  let JORDAN_INSIDE_OUTSIDE_GEN ← prove
   r"!s:real^N->bool.
          2 <= dimindex(:N) /\ s homeomorphic sphere(vec 0:real^N,&1)
          ==> ~(inside s = {}) /\
              open(inside s) /\
              connected(inside s) /\
              ~(outside s = {}) /\
              open(outside s) /\
              connected(outside s) /\
              bounded(inside s) /\
              ~bounded(outside s) /\
              inside s INTER outside s = {} /\
              inside s UNION outside s = (:real^N) DIFF s /\
              frontier(inside s) = s /\
              frontier(outside s) = s"
   (GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP JORDAN_CURVE_THEOREM_GEN) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"ins:real^N->bool", ← q r"out:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"inside s :real^N->bool = ins /\
                  outside s:real^N->bool = out ")
     (fun th => ASM_REWRITE_TAC [th]) THEN
    MATCH_MP_TAC INSIDE_OUTSIDE_UNIQUE THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_SPHERE], ALL_TAC] THEN
    ASM_SIMP_TAC [CONNECTED_OPEN_SET, ← GSYM closed, COMPACT_IMP_CLOSED] THEN
    ASM_MESON_TAC [])

  return { CARD_EQ_COMPONENTS_COMPLEMENTS, JORDAN_CURVE_THEOREM_GEN, JORDAN_INSIDE_OUTSIDE_GEN }

/- ------------------------------------------------------------------------- -/
/- Jordan-Brouwer separation; the Jordan curve theorem.  (paths.ml 28504-28630) -/
/- ------------------------------------------------------------------------- -/

structure PXL where
  JORDAN_BROUWER_FRONTIER : thm
  JORDAN_BROUWER_NONSEPARATION : thm
  JORDAN_BROUWER_SEPARATION : thm
  JORDAN_CURVE_THEOREM : thm
  JORDAN_DISCONNECTED : thm
  JORDAN_INSIDE_OUTSIDE : thm
  JORDAN_COMPONENTS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXL [HolBase] (D : PathsDeps) (BJ : PTJ) (BUG : PUG) (BUO : PUO) (BVA : PVA)
    (BXK : PXK) : ExceptT String IO PXL := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } :=
    D.cvx
  let { CARD_CLAUSES, DIFF_EMPTY, DIMINDEX_2, DIMINDEX_GE_1, FINITE_EMPTY, FINITE_SING, .. } :=
    D.cvx.core1
  let { FORALL_IN_INSERT, HAS_SIZE, HAS_SIZE_CLAUSES, IMP_CONJ, .. } := D.cvx.core2
  let { IN_SING, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, NOT_IN_EMPTY,
        PAIRWISE_INSERT, .. } := D.cvx.core3
  let { REAL_LT_01, .. } := D.cvx.core4
  let { UNIONS_2, UNIV_NOT_EMPTY, UNWIND_THM2, .. } := D.cvx.core6
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_SPHERE, .. } := D.cvx.top2
  let { FRONTIER_COMPLEMENT, FRONTIER_SING, HOMEOMORPHIC_EMPTY, .. } := D.cvx.top3
  let { HOMEOMORPHIC_TRANS, NOT_BOUNDED_UNIV, .. } := D.cvx.top4
  let { SPHERE_EMPTY, closed, connected, .. } := D.cvx.top5
  let { PAIRWISE_EMPTY, .. } := D.pses2
  let { BOUNDED_SEPARATION_1D, BOUNDED_SING, .. } := D.ptop1
  let { COMPONENTS_EQ_SING, COMPONENTS_UNIQUE_2, CONNECTED_OPEN_SET, CONNECTED_UNIV, .. } :=
    D.ptop2
  let { FRONTIER_UNIV, HOMEOMORPHIC_COMPACTNESS, HOMEOMORPHIC_FINITE_STRONG, .. } := D.ptop3
  let { HOMEOMORPHIC_SPHERES, .. } := D.ptop4
  let { MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER, NOT_COMPACT_UNIV, SPHERE_EQ_EMPTY,
        SPHERE_SING, .. } := D.ptop5
  let { HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE, .. } := BJ
  let { COMPONENTS_OPEN_UNIQUE, .. } := BUG
  let { CONNECTED_PUNCTURED_UNIVERSE, .. } := BUO
  let { INSIDE_INTER_OUTSIDE, .. } := BVA
  let { JORDAN_CURVE_THEOREM_GEN, JORDAN_INSIDE_OUTSIDE_GEN, .. } := BXK
  -- @@SCOPE END

  let JORDAN_BROUWER_FRONTIER ← prove
   r"!s t a:real^N r.
       2 <= dimindex(:N) /\
       s homeomorphic sphere(a,r) /\ t IN components((:real^N) DIFF s)
       ==> frontier t = s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r < &0") THENL
     [ASM_SIMP_TAC [SPHERE_EMPTY, HOMEOMORPHIC_EMPTY, IMP_CONJ, DIFF_EMPTY] THEN
      SIMP_TAC [(← EQ_IMP_RULE (← SPEC_ALL COMPONENTS_EQ_SING)).2,
               UNIV_NOT_EMPTY, CONNECTED_UNIV, IN_SING, FRONTIER_UNIV],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THENL
     [ASM_SIMP_TAC [HOMEOMORPHIC_FINITE_STRONG, SPHERE_SING, FINITE_SING] THEN
      SIMP_TAC [CARD_CLAUSES, FINITE_EMPTY, ← GSYM HAS_SIZE, NOT_IN_EMPTY] THEN
      REWRITE_TAC [HAS_SIZE_CLAUSES, UNWIND_THM2, NOT_IN_EMPTY, IMP_CONJ] THEN
      SIMP_TAC [LEFT_IMP_EXISTS_THM, CONNECTED_PUNCTURED_UNIVERSE, IN_SING,
               (← EQ_IMP_RULE (← SPEC_ALL COMPONENTS_EQ_SING)).2, FRONTIER_SING,
               ← SET_RULE (← q r"UNIV DIFF s = {} <=> s = UNIV"), FRONTIER_COMPLEMENT,
               ← MESON [BOUNDED_SING, NOT_BOUNDED_UNIV] (← q r"~((:real^N) = {a})")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, STRIP_TAC] THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") JORDAN_CURVE_THEOREM_GEN) THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"sphere(a:real^N,r)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMEOMORPHIC_SPHERES THEN
      ASM_REWRITE_TAC [REAL_LT_01],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"ins:real^N->bool", ← q r"out:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"components((:real^N) DIFF s) = {ins,out}") SUBST_ALL_TAC THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC COMPONENTS_UNIQUE_2 THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_SPHERE], ALL_TAC] THEN
    ASM_SIMP_TAC [CONNECTED_OPEN_SET, ← GSYM closed, COMPACT_IMP_CLOSED] THEN
    ASM_MESON_TAC [])

  let JORDAN_BROUWER_NONSEPARATION ← prove
   r"!s t a:real^N r.
          2 <= dimindex(:N) /\
          s homeomorphic sphere(a,r) /\ t PSUBSET s
          ==> connected((:real^N) DIFF t)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC MINIMAL_SEPARATING_COMMON_COMPONENT_FRONTIER THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [DISCH_THEN SUBST_ALL_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_COMPACTNESS) THEN
      REWRITE_TAC [COMPACT_SPHERE, NOT_COMPACT_UNIV],
      REPEAT STRIP_TAC THEN MATCH_MP_TAC JORDAN_BROUWER_FRONTIER THEN
      ASM_MESON_TAC []])

  let JORDAN_BROUWER_SEPARATION ← prove
   r"!s a:real^N r.
          &0 < r /\ s homeomorphic sphere(a,r) ==> ~connected((:real^N) DIFF s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_COMPACTNESS, COMPACT_SPHERE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"1 <= dimindex(:N)") MP_TAC THENL
     [REWRITE_TAC [DIMINDEX_GE_1],
      REWRITE_TAC [← ARITH_RULE (← q r"1 <= n <=> n = 1 \/ 2 <= n")]] THEN
    STRIP_TAC THENL
     [ASM_SIMP_TAC [BOUNDED_SEPARATION_1D, COMPACT_IMP_BOUNDED] THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_EMPTY]) THEN
      REWRITE_TAC [SPHERE_EQ_EMPTY] THEN ASM_REAL_ARITH_TAC,
      ASM_SIMP_TAC [CONNECTED_OPEN_SET, ← GSYM closed, COMPACT_IMP_CLOSED] THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") JORDAN_CURVE_THEOREM_GEN) THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        TRANS_TAC HOMEOMORPHIC_TRANS (← q r"sphere(a:real^N,r)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMEOMORPHIC_SPHERES THEN
        ASM_REWRITE_TAC [REAL_LT_01],
        MESON_TAC []]])

  let JORDAN_CURVE_THEOREM ← prove
   r"!c:real^1->real^2.
          simple_path c /\ pathfinish c = pathstart c
          ==> ?ins out.
                   ~(ins = {}) /\ open ins /\ connected ins /\
                   ~(out = {}) /\ open out /\ connected out /\
                   bounded ins /\ ~bounded out /\
                   ins INTER out = {} /\
                   ins UNION out = (:real^2) DIFF path_image c /\
                   frontier ins = path_image c /\
                   frontier out = path_image c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC JORDAN_CURVE_THEOREM_GEN THEN
    REWRITE_TAC [DIMINDEX_2, LE_REFL] THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE, REAL_LT_01])

  let JORDAN_DISCONNECTED ← prove
   r"!c. simple_path c /\ pathfinish c = pathstart c
         ==> ~connected((:real^2) DIFF path_image c)"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [connected] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP JORDAN_CURVE_THEOREM) THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let JORDAN_INSIDE_OUTSIDE ← prove
   r"!c:real^1->real^2.
          simple_path c /\ pathfinish c = pathstart c
          ==> ~(inside(path_image c) = {}) /\
              open(inside(path_image c)) /\
              connected(inside(path_image c)) /\
              ~(outside(path_image c) = {}) /\
              open(outside(path_image c)) /\
              connected(outside(path_image c)) /\
              bounded(inside(path_image c)) /\
              ~bounded(outside(path_image c)) /\
              inside(path_image c) INTER outside(path_image c) = {} /\
              inside(path_image c) UNION outside(path_image c) =
              (:real^2) DIFF path_image c /\
              frontier(inside(path_image c)) = path_image c /\
              frontier(outside(path_image c)) = path_image c"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC JORDAN_INSIDE_OUTSIDE_GEN THEN
    REWRITE_TAC [DIMINDEX_2, LE_REFL] THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE, REAL_LT_01])

  let JORDAN_COMPONENTS ← prove
   r"!g. simple_path g /\ pathfinish g = pathstart g
         ==> components((:real^2) DIFF path_image g) =
             {inside(path_image g),outside(path_image g)}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COMPONENTS_OPEN_UNIQUE THEN
    REWRITE_TAC [UNIONS_2, PAIRWISE_INSERT, NOT_IN_EMPTY, FORALL_IN_INSERT,
                IMP_CONJ, PAIRWISE_EMPTY] THEN
    MP_TAC (← ISPEC (← q r"g:real^1->real^2") JORDAN_INSIDE_OUTSIDE) THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPEC (← q r"path_image g:real^2->bool") INSIDE_INTER_OUTSIDE) THEN
    REPLICATE_TAC 2 STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { JORDAN_BROUWER_FRONTIER, JORDAN_BROUWER_NONSEPARATION, JORDAN_BROUWER_SEPARATION,
           JORDAN_CURVE_THEOREM, JORDAN_DISCONNECTED, JORDAN_INSIDE_OUTSIDE, JORDAN_COMPONENTS }

/- ------------------------------------------------------------------------- -/
/- Separation results for homeomorphic sets.  (paths.ml 28631-28877)         -/
/- ------------------------------------------------------------------------- -/

structure PXM where
  HOMEOMORPHIC_SEPARATION_SPHERE_CARD_EQ : thm
  HOMEOMORPHIC_SEPARATION_SPHERE_HAS_SIZE_EQ : thm
  HOMEOMORPHIC_SEPARATION_SPHERE : thm
  HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS : thm
  HOMEOMORPHIC_SEPARATION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXM [HolBase] (D : PathsDeps) (BS : PTS) (BUP : PUP) (BUY : PUY) (BWB : PWB)
    (BWD : PWD) (BXK : PXK) (BXL : PXL) : ExceptT String IO PXM := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D.cvx
  let { CARD_DIFF, CARD_IMAGE_INJ, CARD_SING, CARD_UNION, CONJ_ACI, CONJ_ASSOC, DE_MORGAN_THM,
        DIFF_EQ_EMPTY, DIMINDEX_1, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1, EQ_ADD_LCANCEL,
        FINITE_DIFF, FINITE_IMAGE, FINITE_SING, FINITE_SUBSET, FINITE_UNION, .. } := D.cvx.core1
  let { HAS_SIZE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, LEFT_OR_DISTRIB, LE_REFL, NOT_IMP, PSUBSET, .. } := D.cvx.core3
  let { REAL_LT_01, .. } := D.cvx.core4
  let { REAL_NOT_LE, SIMPLE_IMAGE, SUBSET_RESTRICT, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { NORM_BASIS, .. } := D.cvx.vec2
  let { BOUNDED_SUBSET, CLOSED_UNIV, CLOSURE_CLOSED, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED,
        COMPACT_IMP_CLOSED, COMPACT_SPHERE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, HOMEOMORPHIC_REFL, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_SYM, IN_SPHERE_0, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { DIMINDEX_FINITE_DIFF, .. } := D.pses1
  let { CARD_ADD_C, CARD_ADD_CONG, CARD_ADD_FINITE_EQ, CARD_DIFF_CONG, CARD_EQ_CARD,
        CARD_EQ_REFL, CARD_EQ_SYM, CARD_EQ_TRANS, CARD_HAS_SIZE_CONG,
        CARD_LT_FINITE_INFINITE, .. } := D.pcard
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := D.pmet1
  let { KURATOWSKI_COMPONENT_NUMBER_INVARIANCE, METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE,
        METRIZABLE_SPACE_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { BOUNDED_IMAGE_IN_COMPACTIFICATION, BOUNDED_SPHERE, CLOSED_IN_CLOSED_EQ, CLOSED_SPHERE,
        COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY, COMPONENTS_EMPTY, .. } := D.ptop1
  let { COMPONENTS_FINITE, CONNECTED_EQ_CARD_COMPONENTS, .. } := D.ptop2
  let { EUCLIDEAN_CONNECTED_COMPONENTS_OF, HAUSDORFF_SPACE_EUCLIDEAN,
        HOMEOMORPHIC_IMP_CARD_EQ, .. } := D.ptop3
  let { HOMEOMORPHIC_SELF_IMAGE, HOMEOMORPHIC_SPACE_EUCLIDEAN, .. } := D.ptop4
  let { METRIZABLE_SPACE_EUCLIDEAN, .. } := D.ptop5
  let { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, .. } := BS
  let { FINITE_SPHERE, LOCALLY_CONNECTED_SPHERE, .. } := BUP
  let { HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT, .. } := BUY
  let { HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV, .. } := BWB
  let { CARD_EQ_COMPONENTS_IN_COMPACTIFICATION, .. } := BWD
  let { CARD_EQ_COMPONENTS_COMPLEMENTS, .. } := BXK
  let { JORDAN_BROUWER_NONSEPARATION, JORDAN_BROUWER_SEPARATION, .. } := BXL
  -- @@SCOPE END

  let HOMEOMORPHIC_SEPARATION_SPHERE_CARD_EQ ← prove
   r"!s t:real^N->bool a r.
        s SUBSET sphere(a,r) /\ t SUBSET sphere(a,r) /\
        closed s /\ closed t /\ s homeomorphic t
        ==> (components(sphere(a,r) DIFF s) =_c components(sphere(a,r) DIFF t))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact(s:real^N->bool) /\ compact(t:real^N->bool)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET, BOUNDED_SPHERE],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"FINITE(sphere(a:real^N,r))") THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CARD_EQ) THEN
      SUBGOAL_THEN (← q r"FINITE(s:real^N->bool) /\ FINITE(t:real^N->bool)")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [FINITE_SUBSET], ALL_TAC] THEN
      ASM_SIMP_TAC [COMPONENTS_FINITE, FINITE_DIFF, CARD_EQ_CARD, SIMPLE_IMAGE,
        FINITE_IMAGE, CARD_IMAGE_INJ, CARD_DIFF, ← SET_RULE (← q r"{a} = {b} <=> a = b")],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FINITE_SPHERE]) THEN
      REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LE] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(n = 1) ==> 1 <= n ==> 2 <= n"))) THEN
      REWRITE_TAC [DIMINDEX_GE_1] THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"s PSUBSET sphere(a:real^N,r) <=> t PSUBSET sphere(a:real^N,r)")
    ASSUME_TAC THENL
     [REPEAT (POP_ASSUM MP_TAC) THEN MAP_EVERY (fun x => SPEC_TAC (x, x))
       [← q r"t:real^N->bool", ← q r"s:real^N->bool"] THEN
      REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC (← MESON []
       (← q r"(!s t. R s t ==> R t s) /\ (!s t. R s t ==> P s ==> P t)
        ==> !s t. R s t ==> (P s <=> P t)")) THEN
      CONJ_TAC THENL [REWRITE_TAC [HOMEOMORPHIC_SYM, CONJ_ACI], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [PSUBSET] THEN
      DISCH_THEN SUBST_ALL_TAC THEN
      MP_TAC (← ISPECL
       [← q r"sphere(a:real^N,r)", ← q r"s:real^N->bool", ← q r"a:real^N", ← q r"r:real"]
       JORDAN_BROUWER_NONSEPARATION) THEN
      ASM_REWRITE_TAC [HOMEOMORPHIC_REFL] THEN
      MATCH_MP_TAC JORDAN_BROUWER_SEPARATION THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"(s PSUBSET u <=> t PSUBSET u)
      ==> s SUBSET u /\ t SUBSET u
          ==> s = u /\ t = u \/ s PSUBSET u /\ t PSUBSET u"))) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [DIFF_EQ_EMPTY, COMPONENTS_EMPTY, CARD_EQ_REFL] THEN
    SUBGOAL_THEN
    (← q r"?w z:real^N. w IN sphere(a,r) /\ z IN sphere(a,r) /\ ~(w IN s) /\ ~(z IN t)")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(sphere(a:real^N,r) DELETE w) homeomorphic (:real^(N,1)finite_diff)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [DIMINDEX_FINITE_DIFF, DIMINDEX_1] THEN ASM_ARITH_TAC,
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^N->real^(N,1)finite_diff", ← q r"g:real^(N,1)finite_diff->real^N"] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"(sphere(a:real^N,r) DELETE z) homeomorphic (:real^(N,1)finite_diff)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [DIMINDEX_FINITE_DIFF, DIMINDEX_1] THEN ASM_ARITH_TAC,
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"h:real^N->real^(N,1)finite_diff", ← q r"k:real^(N,1)finite_diff->real^N"] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^N->real^(N,1)finite_diff",
      ← q r"g:real^(N,1)finite_diff->real^N",
      ← q r"a:real^N", ← q r"r:real", ← q r"s:real^N->bool", ← q r"w:real^N"]
          CARD_EQ_COMPONENTS_IN_COMPACTIFICATION) THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
    MP_TAC (← ISPECL
     [← q r"h:real^N->real^(N,1)finite_diff",
      ← q r"k:real^(N,1)finite_diff->real^N",
      ← q r"a:real^N", ← q r"r:real", ← q r"t:real^N->bool", ← q r"z:real^N"]
          CARD_EQ_COMPONENTS_IN_COMPACTIFICATION) THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED] THEN
    GEN_REWRITE_TAC LAND_CONV [CARD_EQ_SYM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_EQ_TRANS) THEN
    MATCH_MP_TAC CARD_ADD_CONG THEN REWRITE_TAC [CARD_EQ_REFL] THEN
    SUBGOAL_THEN
     (← q r"compact(IMAGE (f:real^N->real^(N,1)finite_diff) s) /\
      compact(IMAGE (h:real^N->real^(N,1)finite_diff) t)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o
        GEN_REWRITE_RULE id [homeomorphism])) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"{x | x IN s /\ P x} = s DIFF {x | x IN s /\ ~P x}")] THEN
    MATCH_MP_TAC CARD_DIFF_CONG THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_COMPONENTS_COMPLEMENTS THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      TRANS_TAC HOMEOMORPHIC_TRANS (← q r"s:real^N->bool") THEN CONJ_TAC THENL
       [ALL_TAC,
        TRANS_TAC HOMEOMORPHIC_TRANS (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM]] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHIC_SELF_IMAGE)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT o rand o lhand o snd) THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT o lhand o lhand o rand o snd) THEN
    ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
    SIMP_TAC [CARD_EQ_CARD, HAS_SIZE] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON [HOMEOMORPHIC_EMPTY]
      (← q r"s homeomorphic t ==> (s = {} <=> t = {})"))) THEN
    SIMP_TAC [IMAGE_EQ_EMPTY, CARD_LT_FINITE_INFINITE])

  let HOMEOMORPHIC_SEPARATION_SPHERE_HAS_SIZE_EQ ← prove
   r"!s t:real^N->bool a r n.
        s SUBSET sphere(a,r) /\ t SUBSET sphere(a,r) /\ s homeomorphic t
        ==> (components(sphere(a,r) DIFF s) HAS_SIZE n <=>
             components(sphere(a,r) DIFF t) HAS_SIZE n)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC
      (← q r"subtopology euclidean (sphere(a:real^N,r))")
      KURATOWSKI_COMPONENT_NUMBER_INVARIANCE) THEN
    SIMP_TAC [METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE,
             METRIZABLE_SPACE_EUCLIDEAN, METRIZABLE_SPACE_SUBTOPOLOGY,
             HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_EUCLIDEAN] THEN
    REWRITE_TAC [COMPACT_SPACE_EUCLIDEAN_SUBTOPOLOGY, COMPACT_SPHERE] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                LOCALLY_CONNECTED_SPHERE] THEN
    SIMP_TAC [CLOSED_IN_CLOSED_EQ, CLOSED_SPHERE] THEN
    REWRITE_TAC [HOMEOMORPHIC_SPACE_EUCLIDEAN, SUBTOPOLOGY_SUBTOPOLOGY,
      EUCLIDEAN_CONNECTED_COMPONENTS_OF, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER (s DIFF t) = s DIFF t")] THEN
    DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_HAS_SIZE_CONG THEN
      MATCH_MP_TAC HOMEOMORPHIC_SEPARATION_SPHERE_CARD_EQ,
      ALL_TAC] THEN
    ASM_MESON_TAC [← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")])

  let HOMEOMORPHIC_SEPARATION_SPHERE ← prove
   r"!s t:real^N->bool a r.
        s SUBSET sphere(a,r) /\ t SUBSET sphere(a,r) /\ s homeomorphic t
        ==> (connected (sphere(a,r) DIFF s) <=> connected(sphere(a,r) DIFF t))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_EQ_CARD_COMPONENTS] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"c <= 1 <=> c = 0 \/ c = 1"), LEFT_OR_DISTRIB] THEN
    REWRITE_TAC [← GSYM HAS_SIZE] THEN BINOP_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_SEPARATION_SPHERE_HAS_SIZE_EQ THEN
    ASM_REWRITE_TAC [])

  let HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS ← prove
   r"!s (t:real^N->bool) n.
          (closed s /\ closed t \/ bounded s /\ bounded t) /\
          s homeomorphic t
          ==> (components((:real^N) DIFF s) HAS_SIZE n <=>
               components((:real^N) DIFF t) HAS_SIZE n)"
   (REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CARD_HAS_SIZE_CONG THEN
      ASM_SIMP_TAC [CARD_EQ_COMPONENTS_COMPLEMENTS],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← SET_RULE
     (← q r"s = {c | c IN s /\ ~bounded c} UNION {c | c IN s /\ bounded c}")] THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") HAS_SIZE_UNBOUNDED_COMPONENTS_COMPLEMENT) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← MESON [HOMEOMORPHIC_EMPTY]
      (← q r"s homeomorphic t ==> (s = {} <=> t = {})"))) THEN
    ABBREV_TAC
     (← q r"m = if t:real^N->bool = {} \/ 2 <= dimindex (:N) then 1 else 2") THEN
    REWRITE_TAC [HAS_SIZE, IMP_IMP] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
     [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
    SIMP_TAC [FINITE_UNION, CARD_UNION, ← SET_RULE
     (← q r"{x | x IN s /\ ~P x} INTER {x | x IN s /\ P x} = {}")] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    FIRST_X_ASSUM (fun th => tactic_of do let _ ← SYM th; pure ALL_TAC) THEN
    REWRITE_TAC [NOT_IMP] THEN MATCH_MP_TAC (← MESON [EQ_ADD_LCANCEL]
     (← q r"(!n. FINITE s /\ CARD s = n <=> FINITE t /\ CARD t = n)
      ==> (FINITE s /\ m + CARD s = n <=> FINITE t /\ m + CARD t = n)")) THEN
    X_GEN_TAC (← q r"n:num") THEN
    ABBREV_TAC (← q r"z:real^(N,1)finite_sum = basis 1") THEN
    SUBGOAL_THEN (← q r"z IN sphere(vec 0:real^(N,1)finite_sum,&1)") ASSUME_TAC THENL
     [EXPAND_TAC "z" THEN REWRITE_TAC [IN_SPHERE_0] THEN
      SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(sphere(vec 0:real^(N,1)finite_sum,&1) DELETE z) homeomorphic (:real^N)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV THEN
      ASM_REWRITE_TAC [REAL_LT_01, DIMINDEX_FINITE_SUM, DIMINDEX_1],
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^(N,1)finite_sum->real^N", ← q r"g:real^N->real^(N,1)finite_sum"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"IMAGE (g:real^N->real^(N,1)finite_sum) s",
      ← q r"IMAGE (g:real^N->real^(N,1)finite_sum) t",
      ← q r"vec 0:real^(N,1)finite_sum", ← q r"&1:real", ← q r"n + 1"]
     HOMEOMORPHIC_SEPARATION_SPHERE_HAS_SIZE_EQ) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (g:real^N->real^(N,1)finite_sum) s SUBSET sphere(vec 0,&1) /\
      IMAGE (g:real^N->real^(N,1)finite_sum) t SUBSET sphere(vec 0,&1)")
    STRIP_ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      ASM_REWRITE_TAC []] THEN
    ANTS_TAC THENL
     [TRANS_TAC HOMEOMORPHIC_TRANS (← q r"s:real^N->bool") THEN CONJ_TAC THENL
       [ALL_TAC,
        TRANS_TAC HOMEOMORPHIC_TRANS (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM]] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHIC_SELF_IMAGE) o GEN_REWRITE_RULE id [HOMEOMORPHISM_SYM]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
       CARD_EQ_COMPONENTS_IN_COMPACTIFICATION)) THEN
    DISCH_THEN (fun th => tactic_of do
     pure (MP_TAC (← SPEC (← q r"IMAGE (g:real^N->real^(N,1)finite_sum) t") th) THEN
           MP_TAC (← SPEC (← q r"IMAGE (g:real^N->real^(N,1)finite_sum) s") th))) THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] BOUNDED_IMAGE_IN_COMPACTIFICATION) o
      ONCE_REWRITE_RULE [← SET_RULE (← q r"s DELETE z = s DIFF {z}")] o
      GEN_REWRITE_RULE id [HOMEOMORPHISM_SYM]) THEN
    ASM_REWRITE_TAC [COMPACT_SPHERE, CLOSED_UNIV, SUBSET_UNIV] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {z} = {} <=> ~(z IN s)")] THEN
    DISCH_THEN (ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC id [IMP_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP CARD_HAS_SIZE_CONG th]))) THEN
    SUBGOAL_THEN
     (← q r"IMAGE f (IMAGE (g:real^N->real^(N,1)finite_sum) s) = s /\
      IMAGE f (IMAGE (g:real^N->real^(N,1)finite_sum) t) = t")
    (CONJUNCTS_THEN SUBST1_TAC) THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [HAS_SIZE]] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
    SIMP_TAC [CARD_ADD_C, FINITE_SING, CARD_ADD_FINITE_EQ] THEN
    REWRITE_TAC [CARD_SING, ← ARITH_RULE (← q r"1 + m = n + 1 <=> m = n")])

  let HOMEOMORPHIC_SEPARATION ← prove
   r"!s t. bounded s /\ bounded t /\ s homeomorphic t
           ==> (connected((:real^N) DIFF s) <=> connected((:real^N) DIFF t))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONNECTED_EQ_CARD_COMPONENTS] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"c <= 1 <=> c = 0 \/ c = 1"), LEFT_OR_DISTRIB] THEN
    REWRITE_TAC [← GSYM HAS_SIZE] THEN BINOP_TAC THEN
    MATCH_MP_TAC HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS THEN
    ASM_REWRITE_TAC [])

  return { HOMEOMORPHIC_SEPARATION_SPHERE_CARD_EQ, HOMEOMORPHIC_SEPARATION_SPHERE_HAS_SIZE_EQ,
           HOMEOMORPHIC_SEPARATION_SPHERE, HAS_SIZE_EQ_COMPONENTS_COMPLEMENTS,
           HOMEOMORPHIC_SEPARATION }

end HolMultiLib.Paths
