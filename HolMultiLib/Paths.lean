      pure (REWRITE_TAC [← MATCH_MP PROPER_MAP th])) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC
        [← GSYM (← MATCH_MP COVERING_SPACE_FINITE_EQ_COMPACT_FIBRE th)])) THEN
    REWRITE_TAC [← TAUT (← q r"(p <=> q /\ p) <=> (p ==> q)")] THEN
