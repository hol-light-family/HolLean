  HOMEOMORPHIC_LOCAL_CONNECTEDNESS : thm
  HOMEOMORPHISM_LOCAL_CONNECTEDNESS : thm
  HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS : thm
  HOMEOMORPHISM_LOCAL_PATH_CONNECTEDNESS : thm
  LOCALLY_PATH_CONNECTED_TRANSLATION_EQ : thm
  LOCALLY_CONNECTED_TRANSLATION_EQ : thm
  LOCALLY_PATH_CONNECTED_LINEAR_IMAGE_EQ : thm
  LOCALLY_CONNECTED_LINEAR_IMAGE_EQ : thm
  LOCALLY_CONNECTED_QUOTIENT_IMAGE : thm
  LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE : thm
  LOCALLY_CONNECTED_CONTINUOUS_IMAGE_COMPACT : thm
  LOCALLY_PATH_CONNECTED_CONTINUOUS_IMAGE_COMPACT : thm
  LOCALLY_PATH_CONNECTED_PATH_IMAGE : thm
  LOCALLY_CONNECTED_PATH_IMAGE : thm
  LOCALLY_CONNECTED_LEFT_INVERTIBLE_IMAGE : thm
  LOCALLY_CONNECTED_RIGHT_INVERTIBLE_IMAGE : thm
  LOCALLY_PATH_CONNECTED_LEFT_INVERTIBLE_IMAGE : thm
  LOCALLY_PATH_CONNECTED_RIGHT_INVERTIBLE_IMAGE : thm
  LOCALLY_CONNECTED_PCROSS : thm
  LOCALLY_PATH_CONNECTED_PCROSS : thm
  LOCALLY_CONNECTED_PCROSS_EQ : thm
  LOCALLY_PATH_CONNECTED_PCROSS_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupPTT [HolBase] (D : PathsDeps) (BA : PTA) (BK : PTK) (BL : PTL) (BS : PTS) :
    ExceptT String IO PTT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, add_linear_invariants,
        add_translation_invariants, .. } := D.cvx
  let { CONJ_ASSOC, EQ_IMP, EXISTS_PASTECART, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_PCROSS, FORALL_PASTECART, FSTCART_PASTECART, IMAGE_SUBSET, IMP_CONJ,
        INTER_UNIONS, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, PASTECART_IN_PCROSS,
        PCROSS_EMPTY, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SNDCART_PASTECART, SUBSET, SUBSET_INTER,
        SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, pairwise, .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { OPEN_IN_INTER, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_SUBTOPOLOGY_REFL, .. } :=
    D.cvx.met
  let { BOUNDED_SUBSET, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_CLOSED,
        COMPACT_INTERVAL, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM_OF_SUBSETS, IN_COMPONENTS_NONEMPTY,
        IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { OPEN_IN_REFL, PASTECART_IN_INTERIOR_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, UNIONS_COMPONENTS, components, homeomorphic,
        homeomorphism, .. } := D.cvx.top5
  let { EXISTS_FINITE_SUBSET_IMAGE, .. } := D.pses1
  let { PSUBSET_ALT, .. } := D.pses2
  let { LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
        LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, quotient_map, .. } := D.pmet2
  let { CLOSED_IN_CLOSED_EQ, CLOSED_MAP_IMP_QUOTIENT_MAP, COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY,
        .. } := D.ptop1
  let { CONNECTED_LINEAR_IMAGE, CONNECTED_LINEAR_IMAGE_EQ, CONNECTED_PCROSS,
        CONNECTED_TRANSLATION_EQ, CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP, .. } := D.ptop2
  let { CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP, HOMEOMORPHIC_CONNECTEDNESS,
        HOMEOMORPHIC_LOCALLY, .. } := D.ptop3
  let { LOCALLY_EMPTY, LOCALLY_INJECTIVE_LINEAR_IMAGE, LOCALLY_PCROSS, LOCALLY_TRANSLATION,
        .. } := D.ptop4
  let { OPEN_IN_CONNECTED_COMPONENT, OPEN_IN_PCROSS_EQ, PAIRWISE_DISJOINT_COMPONENTS, .. } :=
    D.ptop5
  let { CONVEX_INTERVAL, .. } := D.pcvx2
  let { path, path_image, .. } := BA
  let { UNIONS_PATH_COMPONENT, path_connected, PATH_COMPONENT_EQ, .. } := BK
  let { HOMEOMORPHIC_PATH_CONNECTEDNESS, PATH_CONNECTED_LINEAR_IMAGE,
        PATH_CONNECTED_LINEAR_IMAGE_EQ, PATH_CONNECTED_TRANSLATION_EQ,
        PATH_CONNECTED_PCROSS, .. } := BL
  let { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_CONNECTED,
        LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_PATH_CONNECTED,
        LOCALLY_CONNECTED_IM_KLEINEN, LOCALLY_PATH_CONNECTED_IM_KLEINEN,
        LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, OPEN_IN_COMPONENTS_LOCALLY_CONNECTED,
        OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, CONVEX_IMP_LOCALLY_PATH_CONNECTED,
        .. } := BS
  -- @@SCOPE END

  let OPEN_IN_CONNECTED_COMPONENTS ← prove
   r"!s c:real^N->bool.
        FINITE(components s) /\ c IN components s
        ==> open_in (subtopology euclidean s) c"
   (REWRITE_TAC [components, IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    SIMP_TAC [OPEN_IN_CONNECTED_COMPONENT])

  let FINITE_COMPONENTS_MEETING_COMPACT_SUBSET ← prove
   r"!k s:real^N->bool.
        compact k /\ locally connected s /\ k SUBSET s
        ==> FINITE {c | c IN components s /\ ~(c INTER k = {})}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"{k INTER c:real^N->bool |c|
       c IN {d | d IN components s /\ ~(d INTER k = {})}}")) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    REWRITE_TAC [← GSYM INTER_UNIONS] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
        MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC OPEN_IN_INTER THEN REWRITE_TAC [OPEN_IN_REFL] THEN
        ASM_SIMP_TAC [OPEN_IN_COMPONENTS_LOCALLY_CONNECTED],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"k SUBSET s ==> k INTER s SUBSET t ==> k SUBSET k INTER t"))) THEN
        GEN_REWRITE_TAC (fun c => LAND_CONV (RAND_CONV c)) [UNIONS_COMPONENTS] THEN
        SET_TAC []],
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [SIMPLE_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
      REWRITE_TAC [SUBSET_INTER, SUBSET_REFL, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"p:(real^N->bool)->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
     (← q r"FINITE s ==> t = s ==> FINITE t"))) THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
      (← q r"p SUBSET k ==> ~(p PSUBSET k) ==> k = p"))) THEN
    REWRITE_TAC [PSUBSET_ALT, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN UNIONS p") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS, NOT_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") PAIRWISE_DISJOINT_COMPONENTS) THEN
    REWRITE_TAC [pairwise] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"c:real^N->bool", ← q r"d:real^N->bool"]) THEN
    ASM_REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ASM SET_TAC []])

  let FINITE_COMPONENTS ← prove
   r"!s:real^N->bool. compact s /\ locally connected s ==> FINITE(components s)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s:real^N->bool"]
          FINITE_COMPONENTS_MEETING_COMPACT_SUBSET) THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s <=> !x. x IN s ==> P x")] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    ASM SET_TAC [])

  let FINITE_LOCALLY_CONNECTED_CONNECTED_COMPONENTS ← prove
   r"!s:real^N->bool.
        compact s /\ locally connected s
        ==> FINITE {connected_component s x |x|  x IN s}"
   (REWRITE_TAC [← GSYM components, FINITE_COMPONENTS])

  let FINITE_LOCALLY_PATH_CONNECTED_PATH_COMPONENTS ← prove
   r"!s:real^N->bool.
        compact s /\ locally path_connected s
        ==> FINITE {path_component s x |x|  x IN s}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{path_component s (x:real^N) |x| x IN s}") o
      GEN_REWRITE_RULE id [COMPACT_EQ_HEINE_BOREL_SUBTOPOLOGY]) THEN
    ASM_SIMP_TAC [OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, FORALL_IN_GSPEC,
                 UNIONS_PATH_COMPONENT, SUBSET_REFL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"cs:(real^N->bool)->bool") MP_TAC) THEN
    ASM_CASES_TAC (← q r"{path_component s (x:real^N) |x| x IN s} = cs") THEN
    ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> ~r) ==> p /\ q /\ r ==> s")) THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?x:real^N. x IN s /\ ~(path_component s x IN cs)")
    MP_TAC THENL [ASM SET_TAC [], SIMP_TAC [SUBSET, NOT_FORALL_THM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"?y:real^N. y IN s /\ x IN path_component s y /\
                             path_component s y IN cs")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENT_EQ) THEN
    ASM_MESON_TAC [])

  let CONVEX_IMP_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool. convex s ==> locally connected s"
   (MESON_TAC [CONVEX_IMP_LOCALLY_PATH_CONNECTED,
              LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let HOMEOMORPHIC_LOCAL_CONNECTEDNESS ← prove
   r"!s t. s homeomorphic t ==> (locally connected s <=> locally connected t)"
   (MATCH_MP_TAC HOMEOMORPHIC_LOCALLY THEN
    REWRITE_TAC [HOMEOMORPHIC_CONNECTEDNESS])

  let HOMEOMORPHISM_LOCAL_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (locally connected (IMAGE f k) <=> locally connected k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_LOCAL_CONNECTEDNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS ← prove
   r"!s t. s homeomorphic t
         ==> (locally path_connected s <=> locally path_connected t)"
   (MATCH_MP_TAC HOMEOMORPHIC_LOCALLY THEN
    REWRITE_TAC [HOMEOMORPHIC_PATH_CONNECTEDNESS])

  let HOMEOMORPHISM_LOCAL_PATH_CONNECTEDNESS ← prove
   r"!f:real^M->real^N g s t k.
        homeomorphism (s,t) (f,g) /\ k SUBSET s
        ==> (locally path_connected (IMAGE f k) <=> locally path_connected k)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN REWRITE_TAC [homeomorphic] THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"g:real^N->real^M"] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [])

  let LOCALLY_PATH_CONNECTED_TRANSLATION_EQ ← prove
   r"!a:real^N s. locally path_connected (IMAGE (\x. a + x) s) <=>
                locally path_connected s"
   (MATCH_MP_TAC LOCALLY_TRANSLATION THEN
    REWRITE_TAC [PATH_CONNECTED_TRANSLATION_EQ])

  add_translation_invariants [LOCALLY_PATH_CONNECTED_TRANSLATION_EQ]

  let LOCALLY_CONNECTED_TRANSLATION_EQ ← prove
   r"!a:real^N s. locally connected (IMAGE (\x. a + x) s) <=>
                locally connected s"
   (MATCH_MP_TAC LOCALLY_TRANSLATION THEN
    REWRITE_TAC [CONNECTED_TRANSLATION_EQ])

  add_translation_invariants [LOCALLY_CONNECTED_TRANSLATION_EQ]

  let LOCALLY_PATH_CONNECTED_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (locally path_connected (IMAGE f s) <=> locally path_connected s)"
   (MATCH_MP_TAC LOCALLY_INJECTIVE_LINEAR_IMAGE THEN
    REWRITE_TAC [PATH_CONNECTED_LINEAR_IMAGE_EQ])

  add_linear_invariants [LOCALLY_PATH_CONNECTED_LINEAR_IMAGE_EQ]

  let LOCALLY_CONNECTED_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (locally connected (IMAGE f s) <=> locally connected s)"
   (MATCH_MP_TAC LOCALLY_INJECTIVE_LINEAR_IMAGE THEN
    REWRITE_TAC [CONNECTED_LINEAR_IMAGE_EQ])

  add_linear_invariants [LOCALLY_CONNECTED_LINEAR_IMAGE_EQ]

  let LOCALLY_CONNECTED_QUOTIENT_IMAGE ← prove
   r"!f:real^M->real^N s.
      (!t. t SUBSET IMAGE f s
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN t} <=>
                open_in (subtopology euclidean (IMAGE f s)) t)) /\
      locally connected s
      ==> locally connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [← GSYM LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
      LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE) THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_REWRITE_TAC [quotient_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE ← prove
   r"!f:real^M->real^N s.
      (!t. t SUBSET IMAGE f s
           ==> (open_in (subtopology euclidean s) {x | x IN s /\ f x IN t} <=>
                open_in (subtopology euclidean (IMAGE f s)) t)) /\
      locally path_connected s
      ==> locally path_connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [← GSYM LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
      LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE) THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_REWRITE_TAC [quotient_map, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY])

  let LOCALLY_CONNECTED_CONTINUOUS_IMAGE_COMPACT ← prove
   r"!f:real^M->real^N s.
        locally connected s /\ compact s /\ f continuous_on s
        ==> locally connected (IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_CONNECTED_QUOTIENT_IMAGE THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_MAP_IMP_QUOTIENT_MAP THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_IMP_CLOSED,
                 COMPACT_CONTINUOUS_IMAGE, IMAGE_SUBSET] THEN
    ASM_MESON_TAC [COMPACT_IMP_CLOSED, COMPACT_CONTINUOUS_IMAGE,
      CONTINUOUS_ON_SUBSET, BOUNDED_SUBSET, COMPACT_EQ_BOUNDED_CLOSED])

  let LOCALLY_PATH_CONNECTED_CONTINUOUS_IMAGE_COMPACT ← prove
   r"!f:real^M->real^N s.
        locally path_connected s /\ compact s /\ f continuous_on s
        ==> locally path_connected (IMAGE f s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_MAP_IMP_QUOTIENT_MAP THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_IMP_CLOSED,
                 COMPACT_CONTINUOUS_IMAGE, IMAGE_SUBSET] THEN
    ASM_MESON_TAC [COMPACT_IMP_CLOSED, COMPACT_CONTINUOUS_IMAGE,
      CONTINUOUS_ON_SUBSET, BOUNDED_SUBSET, COMPACT_EQ_BOUNDED_CLOSED])

  let LOCALLY_PATH_CONNECTED_PATH_IMAGE ← prove
   r"!p:real^1->real^N. path p ==> locally path_connected (path_image p)"
   (REWRITE_TAC [path, path_image] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_PATH_CONNECTED_CONTINUOUS_IMAGE_COMPACT THEN
    ASM_SIMP_TAC [COMPACT_INTERVAL, CONVEX_INTERVAL,
                 CONVEX_IMP_LOCALLY_PATH_CONNECTED])

  let LOCALLY_CONNECTED_PATH_IMAGE ← prove
   r"!p:real^1->real^N. path p ==> locally connected (path_image p)"
   (SIMP_TAC [LOCALLY_PATH_CONNECTED_PATH_IMAGE,
             LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let LOCALLY_CONNECTED_LEFT_INVERTIBLE_IMAGE ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on (IMAGE f s) /\
        (!x. x IN s ==> g(f x) = x) /\
        locally connected s
        ==> locally connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP THEN ASM_MESON_TAC [])

  let LOCALLY_CONNECTED_RIGHT_INVERTIBLE_IMAGE ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on (IMAGE f s) /\
        IMAGE g (IMAGE f s) SUBSET s /\ (!x. x IN IMAGE f s ==> f(g x) = x) /\
        locally connected s
        ==> locally connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP THEN
    EXISTS_TAC (← q r"g:real^N->real^M") THEN ASM SET_TAC [])

  let LOCALLY_PATH_CONNECTED_LEFT_INVERTIBLE_IMAGE ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on (IMAGE f s) /\
        (!x. x IN s ==> g(f x) = x) /\
        locally path_connected s
        ==> locally path_connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
      LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC CONTINUOUS_LEFT_INVERSE_IMP_QUOTIENT_MAP THEN ASM_MESON_TAC [])

  let LOCALLY_PATH_CONNECTED_RIGHT_INVERTIBLE_IMAGE ← prove
   r"!f:real^M->real^N g s.
        f continuous_on s /\ g continuous_on (IMAGE f s) /\
        IMAGE g (IMAGE f s) SUBSET s /\ (!x. x IN IMAGE f s ==> f(g x) = x) /\
        locally path_connected s
        ==> locally path_connected (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
      LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE) THEN
    MATCH_MP_TAC CONTINUOUS_RIGHT_INVERSE_IMP_QUOTIENT_MAP THEN
    EXISTS_TAC (← q r"g:real^N->real^M") THEN ASM SET_TAC [])

  let LOCALLY_CONNECTED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally connected s /\ locally connected t
        ==> locally connected (s PCROSS t)"
   (MATCH_MP_TAC LOCALLY_PCROSS THEN REWRITE_TAC [CONNECTED_PCROSS])

  let LOCALLY_PATH_CONNECTED_PCROSS ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally path_connected s /\ locally path_connected t
        ==> locally path_connected (s PCROSS t)"
   (MATCH_MP_TAC LOCALLY_PCROSS THEN REWRITE_TAC [PATH_CONNECTED_PCROSS])

  let LOCALLY_CONNECTED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally connected (s PCROSS t) <=>
        s = {} \/ t = {} \/ locally connected s /\ locally connected t"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, LOCALLY_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, LOCALLY_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [LOCALLY_CONNECTED_PCROSS] THEN
    GEN_REWRITE_TAC LAND_CONV [LOCALLY_CONNECTED] THEN DISCH_TAC THEN
    REWRITE_TAC [LOCALLY_CONNECTED_IM_KLEINEN] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"x:real^M"] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~(t:real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(u:real^M->bool) PCROSS (t:real^N->bool)",
        ← q r"pastecart (x:real^M) (y:real^N)"]),
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"y:real^N"] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~(s:real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"x:real^M")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(s:real^M->bool) PCROSS (v:real^N->bool)",
        ← q r"pastecart (x:real^M) (y:real^N)"])] THEN
    ASM_SIMP_TAC [OPEN_IN_PCROSS_EQ, PASTECART_IN_PCROSS, SUBSET_UNIV,
      OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"w:real^(M,N)finite_sum->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"s:real^M->bool", ← q r"t:real^N->bool", ← q r"w:real^(M,N)finite_sum->bool",
      ← q r"x:real^M", ← q r"y:real^N"] PASTECART_IN_INTERIOR_SUBTOPOLOGY) THEN
    ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u':real^M->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"z:real^M") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"IMAGE fstcart (w:real^(M,N)finite_sum->bool)") THEN
        ASM_SIMP_TAC [CONNECTED_LINEAR_IMAGE, LINEAR_FSTCART] THEN
        REWRITE_TAC [SUBSET, IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"v':real^N->bool") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"IMAGE sndcart (w:real^(M,N)finite_sum->bool)") THEN
        ASM_SIMP_TAC [CONNECTED_LINEAR_IMAGE, LINEAR_SNDCART] THEN
        REWRITE_TAC [SUBSET, IN_IMAGE, EXISTS_PASTECART, SNDCART_PASTECART]]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [SUBSET, FORALL_IN_PCROSS, PASTECART_IN_PCROSS, FORALL_PASTECART]) THEN
    ASM SET_TAC [])

  let LOCALLY_PATH_CONNECTED_PCROSS_EQ ← prove
   r"!s:real^M->bool t:real^N->bool.
        locally path_connected (s PCROSS t) <=>
        s = {} \/ t = {} \/
        locally path_connected s /\ locally path_connected t"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^M->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, LOCALLY_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, LOCALLY_EMPTY] THEN
    EQ_TAC THEN REWRITE_TAC [LOCALLY_PATH_CONNECTED_PCROSS] THEN
    GEN_REWRITE_TAC LAND_CONV [LOCALLY_PATH_CONNECTED] THEN DISCH_TAC THEN
    REWRITE_TAC [LOCALLY_PATH_CONNECTED_IM_KLEINEN] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"x:real^M"] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~(t:real^N->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(u:real^M->bool) PCROSS (t:real^N->bool)",
        ← q r"pastecart (x:real^M) (y:real^N)"]),
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"y:real^N"] THEN STRIP_TAC THEN
      UNDISCH_TAC (← q r"~(s:real^M->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"x:real^M")) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(s:real^M->bool) PCROSS (v:real^N->bool)",
        ← q r"pastecart (x:real^M) (y:real^N)"])] THEN
    ASM_SIMP_TAC [OPEN_IN_PCROSS_EQ, PASTECART_IN_PCROSS, SUBSET_UNIV,
      OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"w:real^(M,N)finite_sum->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"s:real^M->bool", ← q r"t:real^N->bool", ← q r"w:real^(M,N)finite_sum->bool",
      ← q r"x:real^M", ← q r"y:real^N"] PASTECART_IN_INTERIOR_SUBTOPOLOGY) THEN
    ASM_REWRITE_TAC [] THENL
     [MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u':real^M->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"z:real^M") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"fstcart:real^(M,N)finite_sum->real^M",
                       ← q r"w:real^(M,N)finite_sum->bool"]
          PATH_CONNECTED_LINEAR_IMAGE) THEN ASM_REWRITE_TAC [LINEAR_FSTCART] THEN
        REWRITE_TAC [path_connected] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"z:real^M"]) THEN ANTS_TAC THENL
         [REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART],
          MATCH_MP_TAC MONO_EXISTS THEN
          REWRITE_TAC [SUBSET, IN_IMAGE, EXISTS_PASTECART, FSTCART_PASTECART] THEN
          REPEAT STRIP_TAC THEN ASM_REWRITE_TAC []]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M->bool") MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"v':real^N->bool") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"sndcart:real^(M,N)finite_sum->real^N",
                       ← q r"w:real^(M,N)finite_sum->bool"]
          PATH_CONNECTED_LINEAR_IMAGE) THEN ASM_REWRITE_TAC [LINEAR_SNDCART] THEN
        REWRITE_TAC [path_connected] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"y:real^N", ← q r"z:real^N"]) THEN ANTS_TAC THENL
         [REWRITE_TAC [IN_IMAGE, EXISTS_PASTECART, SNDCART_PASTECART],
          MATCH_MP_TAC MONO_EXISTS THEN
          REWRITE_TAC [SUBSET, IN_IMAGE, EXISTS_PASTECART, SNDCART_PASTECART] THEN
          REPEAT STRIP_TAC THEN ASM_REWRITE_TAC []]]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [SUBSET, FORALL_IN_PCROSS, PASTECART_IN_PCROSS, FORALL_PASTECART]) THEN
    ASM SET_TAC [])

  return { OPEN_IN_CONNECTED_COMPONENTS, FINITE_COMPONENTS_MEETING_COMPACT_SUBSET,
           FINITE_COMPONENTS, FINITE_LOCALLY_CONNECTED_CONNECTED_COMPONENTS,
           FINITE_LOCALLY_PATH_CONNECTED_PATH_COMPONENTS, CONVEX_IMP_LOCALLY_CONNECTED,
           HOMEOMORPHIC_LOCAL_CONNECTEDNESS, HOMEOMORPHISM_LOCAL_CONNECTEDNESS,
           HOMEOMORPHIC_LOCAL_PATH_CONNECTEDNESS, HOMEOMORPHISM_LOCAL_PATH_CONNECTEDNESS,
           LOCALLY_PATH_CONNECTED_TRANSLATION_EQ, LOCALLY_CONNECTED_TRANSLATION_EQ,
           LOCALLY_PATH_CONNECTED_LINEAR_IMAGE_EQ, LOCALLY_CONNECTED_LINEAR_IMAGE_EQ,
           LOCALLY_CONNECTED_QUOTIENT_IMAGE, LOCALLY_PATH_CONNECTED_QUOTIENT_IMAGE,
           LOCALLY_CONNECTED_CONTINUOUS_IMAGE_COMPACT,
           LOCALLY_PATH_CONNECTED_CONTINUOUS_IMAGE_COMPACT, LOCALLY_PATH_CONNECTED_PATH_IMAGE,
           LOCALLY_CONNECTED_PATH_IMAGE, LOCALLY_CONNECTED_LEFT_INVERTIBLE_IMAGE,
           LOCALLY_CONNECTED_RIGHT_INVERTIBLE_IMAGE,
           LOCALLY_PATH_CONNECTED_LEFT_INVERTIBLE_IMAGE,
           LOCALLY_PATH_CONNECTED_RIGHT_INVERTIBLE_IMAGE, LOCALLY_CONNECTED_PCROSS,
           LOCALLY_PATH_CONNECTED_PCROSS, LOCALLY_CONNECTED_PCROSS_EQ,
           LOCALLY_PATH_CONNECTED_PCROSS_EQ }

/- ------------------------------------------------------------------------- -/
/- Local connectedness (continued): subregions, cardinality, separation,     -/
/- closed unions.  (paths.ml 7117-7456)                                      -/
/- ------------------------------------------------------------------------- -/

structure PTU where
  LOCALLY_CONNECTED_SUBREGION : thm
  CARD_EQ_OPEN_IN : thm
  CARD_EQ_OPEN_IN_AFFINE : thm
  SEPARATION_BY_CLOSED_INTERMEDIATES : thm
  SEPARATION_BY_CLOSED_INTERMEDIATES_EQ : thm
  LOCALLY_CONNECTED_CLOSED_UNION_GEN : thm
  LOCALLY_CONNECTED_CLOSED_UNION : thm
  LOCALLY_CONNECTED_CLOSED_UNIONS : thm
  LOCALLY_CONNECTED_FROM_UNION_AND_INTER_GEN : thm
  LOCALLY_CONNECTED_FROM_UNION_AND_INTER : thm
  LOCALLY_CONNECTED_CLOSURE_FROM_FRONTIER : thm
  deriving Inhabited

@[nospecialize]
def setupPTU [HolBase] (D : PathsDeps) (BS : PTS) (BT : PTT) :
    ExceptT String IO PTU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, FINITE_INDUCT_STRONG, .. } := D.cvx.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, IN, INTER_SUBSET, IN_DIFF, .. } := D.cvx.core2
  let { IN_INTER, LEFT_AND_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, NOT_IN_EMPTY,
        .. } := D.cvx.core3
  let { SUBSET_ANTISYM_EQ, SUBSET_DIFF, SUBSET_INTER, SUBSET_UNION, .. } := D.cvx.core5
  let { SUBSET_UNIV, SWAP_EXISTS_THM, UNIONS_0, UNIONS_INSERT, UNWIND_THM2, .. } := D.cvx.core6
  let { OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_IN, CLOSED_IN_CLOSED, CLOSED_SUBSET, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { OPEN_INTER, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, OPEN_IN_REFL,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.cvx.top5
  let { INTER_ASSOC, .. } := D.pses1
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_ANTISYM, CARD_LE_SUBSET, CARD_LE_TRANS, .. } :=
    D.pcard
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER, CLOSED_IN_SUBSET_TRANS,
        CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, CONNECTED_IN_SUBTOPOLOGY, .. } := D.pmet1
  let { METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE, METRIZABLE_SPACE_SUBTOPOLOGY,
        SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_GEN, SEPARATION_BY_CLOSED_INTERMEDIATES_GEN,
        .. } := D.pmet2
  let { CARD_EQ_CONNECTED, CARD_EQ_EUCLIDEAN, CLOSED_IN_REFL, CLOSED_UNIONS, .. } := D.ptop1
  let { CONNECTED_COMPONENT_REFL_EQ, CONNECTED_CONNECTED_COMPONENT, CONNECTED_EMPTY,
        CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL, CONNECTED_UNION, .. } := D.ptop2
  let { EXISTS_COMPONENT_SUPERSET, FRONTIER_CLOSURES, .. } := D.ptop3
  let { LOCALLY_EMPTY, LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { METRIZABLE_SPACE_EUCLIDEAN, limit_point_of, locally, .. } := D.ptop5
  let { AFFINE_IMP_CONVEX, CONNECTED_IMP_PERFECT_AFF_DIM, CONVEX_CONNECTED, .. } := D.pcvx1
  let { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_CONNECTED,
        LOCALLY_CONNECTED_UNIV, OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED,
        OPEN_IN_COMPONENTS_LOCALLY_CONNECTED, .. } := BS
  let { CONVEX_IMP_LOCALLY_CONNECTED, .. } := BT
  -- @@SCOPE END

  let LOCALLY_CONNECTED_SUBREGION ← prove
   r"!s t c:real^N->bool.
        locally connected s /\ t SUBSET s /\
        connected c /\ open_in (subtopology euclidean t) c
        ==> ?c'. connected c' /\ open_in (subtopology euclidean s) c' /\
                 c = t INTER c'"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    ASM_CASES_TAC (← q r"s INTER u:real^N->bool = {}") THENL
     [EXISTS_TAC (← q r"{}:real^N->bool") THEN
      ASM_REWRITE_TAC [CONNECTED_EMPTY, OPEN_IN_EMPTY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s INTER u:real^N->bool", ← q r"t INTER u:real^N->bool"]
          EXISTS_COMPONENT_SUPERSET) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^N->bool") THEN
    REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED],
      MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"s INTER u:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER] THEN
      MATCH_MP_TAC OPEN_IN_COMPONENTS_LOCALLY_CONNECTED THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          LOCALLY_OPEN_SUBSET)) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER],
      ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER, INTER_SUBSET] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN SET_TAC []])

  let CARD_EQ_OPEN_IN ← prove
   r"!u s:real^N->bool.
      locally connected u /\
      open_in (subtopology euclidean u) s /\
      (?x. x IN s /\ x limit_point_of u)
      ==> s =_c (:real)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN CONJ_TAC THENL
     [TRANS_TAC CARD_LE_TRANS (← q r"(:real^N)") THEN
      SIMP_TAC [CARD_EQ_IMP_LE, CARD_EQ_EUCLIDEAN] THEN
      MATCH_MP_TAC CARD_LE_SUBSET THEN REWRITE_TAC [SUBSET_UNIV],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [IN_INTER] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u INTER t:real^N->bool", ← q r"x:real^N"]) THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, IN_INTER] THEN
    REWRITE_TAC [OPEN_IN_OPEN, ← GSYM CONJ_ASSOC, LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [UNWIND_THM2, IN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [limit_point_of]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"t INTER v:real^N->bool")) THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    TRANS_TAC CARD_LE_TRANS (← q r"u INTER v:real^N->bool") THEN
    ASM_SIMP_TAC [CARD_LE_SUBSET] THEN MATCH_MP_TAC CARD_EQ_IMP_LE THEN
    ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN MATCH_MP_TAC CARD_EQ_CONNECTED THEN
    ASM SET_TAC [])

  let CARD_EQ_OPEN_IN_AFFINE ← prove
   r"!u s:real^N->bool.
        affine u /\ ~(aff_dim u = &0) /\
        open_in (subtopology euclidean u) s /\ ~(s = {})
        ==> s =_c (:real)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_EQ_OPEN_IN THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN
    ASM_SIMP_TAC [CONVEX_IMP_LOCALLY_CONNECTED, AFFINE_IMP_CONVEX] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_IMP_PERFECT_AFF_DIM THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, CONVEX_CONNECTED] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN ASM SET_TAC [])

  let SEPARATION_BY_CLOSED_INTERMEDIATES ← prove
   r"!u s:real^N->bool.
        ~connected(u DIFF s)
        ==> ?t. closed_in (subtopology euclidean u) t /\ t SUBSET s /\
                !c. closed_in (subtopology euclidean u) c /\
                    t SUBSET c /\ c SUBSET s
                    ==> ~connected(u DIFF c)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (u:real^N->bool)", ← q r"s:real^N->bool"]
          SEPARATION_BY_CLOSED_INTERMEDIATES_GEN) THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEAN, SUBSET_DIFF] THEN
    SIMP_TAC [METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE,
             METRIZABLE_SPACE_SUBTOPOLOGY, METRIZABLE_SPACE_EUCLIDEAN])

  let SEPARATION_BY_CLOSED_INTERMEDIATES_EQ ← prove
   r"!u s:real^N->bool.
        locally connected u
        ==> (~connected(u DIFF s) <=>
             ?t. closed_in (subtopology euclidean u) t /\ t SUBSET s /\
                 !c. closed_in (subtopology euclidean u) c /\
                     t SUBSET c /\ c SUBSET s
                     ==> ~connected(u DIFF c))"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (u:real^N->bool)", ← q r"s:real^N->bool"]
          SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_GEN) THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEAN, SUBSET_DIFF] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    SIMP_TAC [METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE,
             METRIZABLE_SPACE_SUBTOPOLOGY, METRIZABLE_SPACE_EUCLIDEAN])

  let LOCALLY_CONNECTED_CLOSED_UNION_GEN ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        locally connected s /\ locally connected t
        ==> locally connected (s UNION t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [ALL_TAC,
      MATCH_MP_TAC (← MESON [] (← q r"(?x. P x x) ==> (?x y. P x y)")) THEN
      SUBGOAL_THEN (← q r"locally connected(t DIFF s:real^N->bool)") MP_TAC THENL
       [MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"t DIFF s = t DIFF (t INTER s)")] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
        MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_REFL] THEN
        ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET],
        REWRITE_TAC [LOCALLY_CONNECTED] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"v DIFF s:real^N->bool", ← q r"a:real^N"]) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
          REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"w:real^N->bool") THEN
          MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS) THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"t DIFF s = (s UNION t) DIFF s")] THEN
          MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
          MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
          EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
          SET_TAC []]]] THEN
    ASM_CASES_TAC (← q r"(a:real^N) IN t") THENL
     [ALL_TAC,
      MATCH_MP_TAC (← MESON [] (← q r"(?x. P x x) ==> (?x y. P x y)")) THEN
      SUBGOAL_THEN (← q r"locally connected(s DIFF t:real^N->bool)") MP_TAC THENL
       [MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"t DIFF s = t DIFF (t INTER s)")] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
        MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_REFL] THEN
        ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET],
        REWRITE_TAC [LOCALLY_CONNECTED] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"v DIFF t:real^N->bool", ← q r"a:real^N"]) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
          REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"w:real^N->bool") THEN
          MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS) THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = (s UNION t) DIFF t")] THEN
          MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
          MATCH_MP_TAC CLOSED_IN_SUBSET_TRANS THEN
          EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
          SET_TAC []]]] THEN
    UNDISCH_TAC (← q r"locally connected (t:real^N->bool)") THEN
    UNDISCH_TAC (← q r"locally connected (s:real^N->bool)") THEN
    REWRITE_TAC [LOCALLY_CONNECTED] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s INTER v:real^N->bool", ← q r"a:real^N"]) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN ANTS_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL, SUBSET_UNION],
      GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [OPEN_IN_OPEN] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [UNWIND_THM2, IN_INTER, SUBSET_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:real^N->bool") STRIP_ASSUME_TAC)] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"t INTER v:real^N->bool", ← q r"a:real^N"]) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN ANTS_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_REFL, SUBSET_UNION],
      GEN_REWRITE_TAC (fun c => LAND_CONV (ONCE_DEPTH_CONV c)) [OPEN_IN_OPEN] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [UNWIND_THM2, IN_INTER, SUBSET_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:real^N->bool") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"(s UNION t) INTER (m INTER n):real^N->bool") THEN
    EXISTS_TAC (← q r"(s INTER m) UNION (t INTER n):real^N->bool") THEN
    ASM_SIMP_TAC [OPEN_INTER, OPEN_IN_OPEN_INTER] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONNECTED_UNION THEN ASM SET_TAC [])

  let LOCALLY_CONNECTED_CLOSED_UNION ← prove
   r"!s t:real^N->bool.
        locally connected s /\ locally connected t /\ closed s /\ closed t
        ==> locally connected (s UNION t)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_CONNECTED_CLOSED_UNION_GEN THEN
    EXISTS_TAC (← q r"(:real^N)") THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM CLOSED_IN])

  let LOCALLY_CONNECTED_CLOSED_UNIONS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ (!s. s IN f ==> closed s /\ locally connected s)
        ==> locally connected (UNIONS f)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, UNIONS_0, UNIONS_INSERT] THEN
    REWRITE_TAC [LOCALLY_EMPTY] THEN
    ASM_SIMP_TAC [LOCALLY_CONNECTED_CLOSED_UNION, CLOSED_UNIONS])

  let LOCALLY_CONNECTED_FROM_UNION_AND_INTER_GEN ← prove
   r"!s t u:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        locally connected (s UNION t) /\ locally connected (s INTER t)
        ==> locally connected s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"closed_in (subtopology euclidean (s UNION t)) (s:real^N->bool) /\
      closed_in (subtopology euclidean (s UNION t)) (t:real^N->bool)")
    MP_TAC THENL
     [CONJ_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          CLOSED_IN_SUBSET_TRANS)) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
      SET_TAC [],
      REPEAT (FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
      REPEAT STRIP_TAC] THEN
    REWRITE_TAC [LOCALLY_CONNECTED] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"x:real^N"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN t") THENL
     [ALL_TAC,
      SUBGOAL_THEN (← q r"locally connected (s DIFF t:real^N->bool)") MP_TAC THENL
       [MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
        EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = (s UNION t) DIFF t")] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [OPEN_IN_REFL],
        REWRITE_TAC [LOCALLY_CONNECTED] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"u DIFF t:real^N->bool", ← q r"x:real^N"]) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
          REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
          MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN MATCH_MP_TAC MONO_AND THEN
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS) THEN
          MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
          EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN
          CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = (s UNION t) DIFF t")] THEN
          MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [OPEN_IN_REFL]]]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o REWRITE_RULE [IN_INTER]) THEN
    ABBREV_TAC (← q r"c = connected_component (s INTER t INTER g) (x:real^N)") THEN
    MP_TAC (← ISPECL [← q r"(s UNION t) INTER g:real^N->bool",
                   ← q r"s INTER t INTER g:real^N->bool",
                   ← q r"c:real^N->bool"] LOCALLY_CONNECTED_SUBREGION) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
        EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_OPEN_INTER],
        SET_TAC [],
        ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT],
        EXPAND_TAC "c" THEN
        MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED THEN
        MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
        EXISTS_TAC (← q r"s INTER t:real^N->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, ← GSYM INTER_ASSOC]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->bool") (STRIP_ASSUME_TAC o GSYM))] THEN
    EXISTS_TAC (← q r"s INTER h:real^N->bool") THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s UNION t:real^N->bool") THEN REWRITE_TAC [SUBSET_UNION] THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN
      EXISTS_TAC (← q r"(s UNION t) INTER g:real^N->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
      ALL_TAC,
      SUBGOAL_THEN (← q r"(x:real^N) IN c") MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_REFL_EQ, IN, IN_INTER],
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      ASM SET_TAC []] THEN
    MATCH_MP_TAC (← TAUT (← q r"!q. p /\ q ==> p")) THEN
    EXISTS_TAC (← q r"connected(t INTER h:real^N->bool)") THEN
    MATCH_MP_TAC CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL THEN
    EXISTS_TAC (← q r"h:real^N->bool") THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THENL
       [UNDISCH_TAC
         (← q r"closed_in (subtopology euclidean (s UNION t)) (s:real^N->bool)"),
        UNDISCH_TAC
         (← q r"closed_in (subtopology euclidean (s UNION t)) (t:real^N->bool)")] THEN
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN MATCH_MP_TAC MONO_EXISTS THEN
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
      ASM SET_TAC [],
      SUBGOAL_THEN (← q r"s INTER h UNION t INTER h:real^N->bool = h")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC []] THEN
      SUBGOAL_THEN (← q r"(s INTER h) INTER t INTER h:real^N->bool = c")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        ASM SET_TAC [],
        ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT]]])

  let LOCALLY_CONNECTED_FROM_UNION_AND_INTER ← prove
   r"!s t:real^N->bool.
        closed s /\ closed t /\
        locally connected (s UNION t) /\ locally connected (s INTER t)
        ==> locally connected s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_CONNECTED_FROM_UNION_AND_INTER_GEN THEN
    MAP_EVERY EXISTS_TAC [← q r"t:real^N->bool", ← q r"s UNION t:real^N->bool"] THEN
    ASM_SIMP_TAC [CLOSED_SUBSET, SUBSET_UNION])

  let LOCALLY_CONNECTED_CLOSURE_FROM_FRONTIER ← prove
   r"!s:real^N->bool.
        locally connected (frontier s) ==> locally connected (closure s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_CONNECTED_FROM_UNION_AND_INTER THEN
    EXISTS_TAC (← q r"closure((:real^N) DIFF s)") THEN
    ASM_REWRITE_TAC [← GSYM FRONTIER_CLOSURES, CLOSED_CLOSURE] THEN
    SUBGOAL_THEN
     (← q r"closure s UNION closure ((:real^N) DIFF s) = (:real^N)")
     (fun th => REWRITE_TAC [th, LOCALLY_CONNECTED_UNIV]) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET closure s /\ (:real^N) DIFF s SUBSET closure((:real^N) DIFF s)
      ==> closure s UNION closure ((:real^N) DIFF s) = (:real^N)")) THEN
    REWRITE_TAC [CLOSURE_SUBSET])

  return { LOCALLY_CONNECTED_SUBREGION, CARD_EQ_OPEN_IN, CARD_EQ_OPEN_IN_AFFINE,
           SEPARATION_BY_CLOSED_INTERMEDIATES, SEPARATION_BY_CLOSED_INTERMEDIATES_EQ,
           LOCALLY_CONNECTED_CLOSED_UNION_GEN, LOCALLY_CONNECTED_CLOSED_UNION,
           LOCALLY_CONNECTED_CLOSED_UNIONS, LOCALLY_CONNECTED_FROM_UNION_AND_INTER_GEN,
           LOCALLY_CONNECTED_FROM_UNION_AND_INTER, LOCALLY_CONNECTED_CLOSURE_FROM_FRONTIER }

/- ------------------------------------------------------------------------- -/
/- Path-connectedness from union and intersection; local path-connectedness  -/
/- of subregions and of pieces.  (paths.ml 7457-7849)                        -/
/- ------------------------------------------------------------------------- -/

structure PTV where
  PATH_CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL : thm
  PATH_CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL : thm
  PATH_CONNECTED_FROM_CLOSED_UNION_AND_INTER : thm
  PATH_CONNECTED_CLOSURE_FROM_FRONTIER : thm
  LOCALLY_PATH_CONNECTED_SUBREGION : thm
  LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER_GEN : thm
  LOCALLY_PATH_CONNECTED_FROM_UNION_AND_INTER : thm
  deriving Inhabited

@[nospecialize]
def setupPTV [HolBase] (D : PathsDeps) (BA : PTA) (BC : PTC) (BF : PTF) (BK : PTK)
    (BL : PTL) (BS : PTS) : ExceptT String IO PTV := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.cvx
  let { AND_FORALL_THM, CONJ_ACI, CONJ_ASSOC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN, INTER_COMM, INTER_EMPTY, INTER_SUBSET,
        IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        MONO_FORALL, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_LE, .. } := D.cvx.core4
  let { REAL_POS, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_UNION, .. } := D.cvx.core5
  let { UNION_COMM, o_THM, real_abs, .. } := D.cvx.core6
  let { DIST_0, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_SUB, DROP_VEC, ENDS_IN_INTERVAL, INTERVAL_SING, LIFT_DROP, LIFT_EQ,
        LIFT_NUM, NORM_1, .. } := D.cvx.vec2
  let { CLOSED_IN_DIFF, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_IN, CLOSED_INTERVAL, CLOSED_IN_CLOSED, CLOSED_IN_CLOSED_TRANS,
        CLOSED_SUBSET, .. } := D.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_OPEN_INTERVAL, CLOSURE_SUBSET, .. } := D.cvx.top2
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, DISTANCE_ATTAINS_INF, .. } := D.cvx.top3
  let { INTERVAL_NE_EMPTY_1, IN_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, OPEN_IN_REFL, .. } := D.cvx.top5
  let { INTER_ASSOC, .. } := D.pses1
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET_TRANS, .. } := D.pmet1
  let { CLOSED_IN_REFL, .. } := D.ptop1
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_GEN, .. } := D.ptop2
  let { FRONTIER_CLOSURES, .. } := D.ptop3
  let { LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { OPEN_IN_INTER_CLOSURE_EQ_EMPTY, SUBSET_INTERVAL_1, .. } := D.ptop5
  let { path, pathstart, pathfinish, path_image, reversepath, .. } := BA
  let { PATHSTART_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_REVERSEPATH,
        PATH_REVERSEPATH, PATH_JOIN, SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { PATH_IMAGE_SUBPATH, PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
        PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  let { PATH_COMPONENT_REFL_EQ, PATH_COMPONENT_SUBSET, path_connected, PATH_COMPONENT_MAXIMAL,
        PATH_CONNECTED_PATH_COMPONENT, .. } := BK
  let { PATH_CONNECTED_UNIV, PATH_CONNECTED_EMPTY, .. } := BL
  let { LOCALLY_PATH_CONNECTED, OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, .. } := BS
  -- @@SCOPE END

  let (PATH_CONNECTED_FROM_CLOSED_UNION_AND_INTER_LOCAL,
       PATH_CONNECTED_FROM_OPEN_UNION_AND_INTER_LOCAL) ← CONJ_PAIR (← prove
   r"(!u s t:real^N->bool.
        closed_in (subtopology euclidean u) s /\
        closed_in (subtopology euclidean u) t /\
        path_connected (s UNION t) /\
        path_connected (s INTER t)
        ==> path_connected s /\ path_connected t) /\
   (!u s t:real^N->bool.
        open_in (subtopology euclidean u) s /\
        open_in (subtopology euclidean u) t /\
        path_connected (s UNION t) /\
        path_connected (s INTER t)
        ==> path_connected s /\ path_connected t)"
   (← do
    let lemma0 ← prove
     r"!g u s:real^N->bool.
          closed_in (subtopology euclidean u) s /\
          path g /\ path_image g SUBSET u /\ ~DISJOINT (path_image g) s
          ==> ?p. p IN interval[vec 0,vec 1] /\ g p IN s /\
                  !x. x IN interval[vec 0,vec 1] /\ drop x < drop p
                      ==> ~(g x IN s)"
     (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
       [← q r"{x | x IN interval[vec 0,vec 1] /\ (g:real^1->real^N) x IN s}",
        ← q r"vec 0:real^1"] DISTANCE_ATTAINS_INF) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          REWRITE_TAC [CLOSED_INTERVAL] THEN
          MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_GEN THEN
          EXISTS_TAC (← q r"u:real^N->bool") THEN
          ASM_REWRITE_TAC [← GSYM path, ← GSYM path_image] THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET)) THEN
          ASM SET_TAC [],
          RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN ASM SET_TAC []],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [IN_ELIM_THM, DIST_0, NORM_1, IN_INTERVAL_1, DROP_VEC] THEN
        DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
        ASM_SIMP_TAC [real_abs] THEN MATCH_MP_TAC MONO_FORALL THEN
        X_GEN_TAC (← q r"y:real^1") THEN
        ASM_CASES_TAC (← q r"(g:real^1->real^N) y IN s") THEN ASM_REWRITE_TAC [] THEN
        REAL_ARITH_TAC])
    let lemma1 ← prove
     r"!g s t u:real^N->bool.
          (closed_in (subtopology euclidean u) s /\
           closed_in (subtopology euclidean u) t \/
           open_in (subtopology euclidean u) s /\
           open_in (subtopology euclidean u) t) /\
          path g /\ pathstart g IN s /\
          path_image g SUBSET s UNION t /\ ~(path_image g SUBSET s)
          ==> ?p. p IN interval[vec 0,vec 1] /\ g p IN t /\
                  !x. x IN interval[vec 0,p] ==> g x IN s"
     (REPEAT STRIP_TAC THENL
       [SUBGOAL_THEN (← q r"(s:real^N->bool) SUBSET u /\ (t:real^N->bool) SUBSET u")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [CLOSED_IN_IMP_SUBSET], ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"u:real^N->bool",
                          ← q r"t:real^N->bool"] lemma0) THEN
        ASM_REWRITE_TAC [] THEN
        ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
        X_GEN_TAC (← q r"p:real^1") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"q:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
        STRIP_TAC THEN ASM_CASES_TAC (← q r"q:real^1 = vec 0") THENL
         [ASM_MESON_TAC [pathstart], ALL_TAC] THEN
