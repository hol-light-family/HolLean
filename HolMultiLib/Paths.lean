     [← q r"s:real^N->bool", ← q r"ball(z:real^N,&1) INTER t"]
          HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS) THEN
    MP_TAC (← ISPECL [← q r"t:real^N->bool", ← q r"ball(z:real^N,&1)"]
          (← ONCE_REWRITE_RULE [INTER_COMM] AFF_DIM_CONVEX_INTER_OPEN)) THEN
    MP_TAC (← ISPECL [← q r"ball(z:real^N,&1)", ← q r"t:real^N->bool"]
          RELATIVE_FRONTIER_CONVEX_INTER_AFFINE) THEN
    ASM_SIMP_TAC [CONVEX_INTER, BOUNDED_INTER, BOUNDED_BALL, CONVEX_BALL,
                 AFFINE_IMP_CONVEX, INTERIOR_OPEN, OPEN_BALL,
                 FRONTIER_BALL, REAL_LT_01] THEN
    SUBGOAL_THEN (← q r"~(ball(z:real^N,&1) INTER t = {})") ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      EXISTS_TAC (← q r"z:real^N") THEN ASM_REWRITE_TAC [CENTRE_IN_BALL, REAL_LT_01],
      ASM_REWRITE_TAC [] THEN REPEAT (DISCH_THEN SUBST1_TAC) THEN SIMP_TAC []] THEN
    REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:real^N->real^N", ← q r"k:real^N->real^N"] THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM homeomorphic] THEN
    TRANS_TAC HOMEOMORPHIC_TRANS
      (← q r"(sphere(z,&1) INTER t) DELETE (h:real^N->real^N) a") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [homeomorphic] THEN
      MAP_EVERY EXISTS_TAC [← q r"h:real^N->real^N", ← q r"k:real^N->real^N"] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
      REWRITE_TAC [HOMEOMORPHISM] THEN STRIP_TAC THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, DELETE_SUBSET],
        ASM SET_TAC [],
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, DELETE_SUBSET],
        ASM SET_TAC [],
        ASM SET_TAC [],
        ASM SET_TAC []],
      MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_AFFINE_SPHERE_AFFINE THEN
      ASM_REWRITE_TAC [REAL_LT_01, ← GSYM IN_INTER] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
      ASM SET_TAC []])

  let HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE ← prove
   r"!a r b:real^N t:real^M->bool.
    &0 < r /\ b IN sphere(a,r) /\ affine t /\ aff_dim(t) + &1 = &(dimindex(:N))
    ==> (sphere(a:real^N,r) DELETE b) homeomorphic t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"cball(a:real^N,r)", ← q r"t:real^M->bool", ← q r"b:real^N"]
          HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE_GEN) THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_CBALL, REAL_LT_IMP_NZ, AFF_DIM_CBALL,
                 CONVEX_CBALL, BOUNDED_CBALL])

  let HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE ← prove
   r"!a r b c d.
        &0 < r /\ b IN sphere(a,r) /\ ~(c = vec 0)
        ==> (sphere(a:real^N,r) DELETE b) homeomorphic
             {x:real^N | c dot x = d}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE THEN
    ASM_SIMP_TAC [AFFINE_HYPERPLANE, AFF_DIM_HYPERPLANE] THEN INT_ARITH_TAC)

  let HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV ← prove
   r"!a r b.
        &0 < r /\ b IN sphere(a,r) /\ dimindex(:N) = dimindex(:M) + 1
        ==> (sphere(a:real^N,r) DELETE b) homeomorphic (:real^M)"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC HOMEOMORPHIC_TRANS (← q r"{x:real^N | basis 1 dot x = &0}") THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_HYPERPLANE_UNIV, BASIS_NONZERO, LE_REFL,
                 DIMINDEX_GE_1, HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE])

  let CONTRACTIBLE_PUNCTURED_SPHERE ← prove
   r"!a r b:real^N.
        &0 < r /\ b IN sphere(a,r) ==> contractible(sphere(a,r) DELETE b)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"contractible {x:real^N | basis 1 dot x = &0}") MP_TAC THENL
     [SIMP_TAC [CONVEX_IMP_CONTRACTIBLE, CONVEX_HYPERPLANE],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_CONTRACTIBLE) THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
      MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE THEN
      ASM_SIMP_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1]])

  let CONTRACTIBLE_PUNCTURED_SPHERE_GEN ← prove
   r"!s a:real^N.
        convex s /\ bounded s /\ a IN relative_frontier s
        ==> contractible(relative_frontier s DELETE a)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [RELATIVE_FRONTIER_EMPTY, EMPTY_DELETE,
                    CONTRACTIBLE_EMPTY] THEN
    MP_TAC (← SPEC (← q r"aff_dim(s:real^N->bool) - &1") AFFINE_EXISTS) THEN
    REWRITE_TAC [← INT_ARITH (← q r"--a:int <= s - a <=> &0 <= s")] THEN
    ASM_SIMP_TAC [AFF_DIM_POS_LE, AFF_DIM_LE_UNIV, LEFT_IMP_EXISTS_THM,
                 ← INT_ARITH (← q r"s:int <= n ==> s - &1 <= n")] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool", ← q r"a:real^N"]
      HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE_GEN) THEN
    ASM_REWRITE_TAC [INT_SUB_ADD] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP HOMEOMORPHIC_CONTRACTIBLE_EQ) THEN
    ASM_SIMP_TAC [AFFINE_IMP_CONVEX, CONVEX_IMP_CONTRACTIBLE])

  let NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP_GEN ← prove
   r"!f s:real^N->bool.
        convex s /\ bounded s /\
        f continuous_on (relative_frontier s) /\
        IMAGE f (relative_frontier s) PSUBSET relative_frontier s
        ==> ?a. homotopic_with (\x. T)
                 (subtopology euclidean (relative_frontier s),
                  subtopology euclidean (relative_frontier s)) f (\x. a)"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
      GEN_REWRITE_RULE id [PSUBSET_ALT]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"f:real^N->real^N", ← q r"\x:real^N. x",
      ← q r"relative_frontier s:real^N->bool",
      ← q r"relative_frontier s DELETE (a:real^N)",
      ← q r"relative_frontier s:real^N->bool"]
     NULLHOMOTOPIC_THROUGH_CONTRACTIBLE) THEN
    ASM_REWRITE_TAC [IMAGE_ID, SUBSET_DELETE, DELETE_SUBSET, o_DEF, ETA_AX] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ID, CONTRACTIBLE_PUNCTURED_SPHERE_GEN])

  return { HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE_GEN, HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE,
           HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE, HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV,
           CONTRACTIBLE_PUNCTURED_SPHERE, CONTRACTIBLE_PUNCTURED_SPHERE_GEN,
           NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP_GEN }

/- ------------------------------------------------------------------------- -/
/- Connectedness of punctured spheres and their open subsets.                -/
/- (paths.ml 21247-21436)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWC where
  CONNECTED_PUNCTURED_SPHERE : thm
  CONNECTED_IN_SPHERE_DELETE_INTERIOR_POINT_EQ : thm
  CONNECTED_OPEN_IN_SPHERE_DELETE_EQ : thm
  FINITE_COMPONENTS_PUNCTURED_CONNECTED_SUBSET_SPHERE : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWC [HolBase] (D : PathsDeps) (BUO : PUO) (BUP : PUP) (BUQ : PUQ) (BVX : PVX)
    (BWB : PWB) : ExceptT String IO PWC := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, SET_RULE, SET_TAC,
        HAS_SIZE_CONV, INT_REDUCE_CONV, .. } := D.cvx
  let { DE_MORGAN_THM, DIMINDEX_1, DIMINDEX_GE_1, EQ_IMP, FINITE_DELETE, FINITE_SUBSET, .. } :=
    D.cvx.core1
  let { IMAGE_SUBSET, IMP_CONJ, .. } := D.cvx.core2
  let { IN_INSERT, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.cvx.core3
  let { REAL_LT_REFL, .. } := D.cvx.core4
  let { REAL_NOT_LE, SUBSET, SUBSET_DELETE, SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, SWAP_EXISTS_THM, .. } := D.cvx.core6
  let { BASIS_NONZERO, .. } := D.cvx.vec1
  let { INTERIOR_OF_SUBSET, OPEN_IN_IMP_SUBSET, OPEN_IN_INTERIOR_OF, OPEN_IN_SUBSET_TRANS,
        SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { HOMEOMORPHISM_OF_SUBSETS, INTERIOR_MAXIMAL, .. } := D.cvx.top4
  let { OPEN_IN, SPHERE_EMPTY, homeomorphic, homeomorphism, .. } := D.cvx.top5
  let { DIMINDEX_FINITE_DIFF, EMPTY_DELETE, IMAGE_DELETE_INJ_ALT, INJECTIVE_ON_LEFT_INVERSE,
        .. } := D.pses1
  let { CARD_FINITE_CONG, .. } := D.pcard
  let { CONNECTED_2, CONNECTED_EMPTY, CONNECTED_EQ_CARD_COMPONENTS, CONNECTED_SING, .. } :=
    D.ptop2
  let { FINITE_COMPONENTS_FINITE, HOMEOMORPHIC_CONNECTEDNESS, .. } := D.ptop3
  let { HOMEOMORPHISM_CONNECTEDNESS, HOMEOMORPHISM_OPENNESS, .. } := D.ptop4
  let { SPHERE_EQ_EMPTY, SPHERE_EQ_SING, SPHERE_SING, .. } := D.ptop5
  let { AFFINE_UNIV, AFF_DIM_UNIV, CONVEX_CONNECTED, CONVEX_CONNECTED_1, .. } := D.pcvx1
  let { CONVEX_HYPERPLANE, .. } := D.pcvx2
  let { CONNECTED_SPHERE, CONNECTED_SPHERE_EQ, .. } := BUO
  let { FINITE_SPHERE, HAS_SIZE_SPHERE_2, .. } := BUP
  let { CONNECTED_DELETE_INTERIOR_POINT_EQ, .. } := BUQ
  let { HOMEOMORPHIC_CARD_EQ_COMPONENTS, FINITE_COMPONENTS_PUNCTURED_CONVEX, .. } := BVX
  let { HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE, HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE,
        HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV, .. } := BWB
  -- @@SCOPE END

  let CONNECTED_PUNCTURED_SPHERE ← prove
   r"!a r b:real^N.
     connected(sphere(a,r) DELETE b) <=>
     (dimindex(:N) = 1 /\ &0 < r ==> b IN sphere(a,r))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, EMPTY_DELETE, NOT_IN_EMPTY, CONNECTED_EMPTY] THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN ASM_SIMP_TAC [SPHERE_SING, REAL_LT_REFL] THENL
     [SUBGOAL_THEN (← q r"{a:real^N} DELETE b = {a} \/ {a} DELETE b = {}") MP_TAC THENL
       [SET_TAC [], DISCH_THEN (DISJ_CASES_THEN SUBST1_TAC)] THEN
      REWRITE_TAC [CONNECTED_EMPTY, CONNECTED_SING],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_CASES_TAC (← q r"dimindex(:N) = 1") THEN ASM_REWRITE_TAC [] THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] HAS_SIZE_SPHERE_2) THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_CASES_TAC (← q r"b:real^N = u") THENL
       [SUBGOAL_THEN (← q r"{u:real^N,v} DELETE b = {v}") SUBST1_TAC THENL
         [ASM SET_TAC [], ASM_REWRITE_TAC [CONNECTED_SING]],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"b:real^N = v") THENL
       [SUBGOAL_THEN (← q r"{u:real^N,v} DELETE b = {u}") SUBST1_TAC THENL
         [ASM SET_TAC [], ASM_REWRITE_TAC [CONNECTED_SING]],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"{u:real^N,v} DELETE b = {u,v}") SUBST1_TAC THENL
       [ASM SET_TAC [], ASM_REWRITE_TAC [CONNECTED_2] THEN ASM SET_TAC []],
      ASM_CASES_TAC (← q r"b IN sphere(a:real^N,r)") THENL
       [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real", ← q r"b:real^N",
                         ← q r"basis 1:real^N", ← q r"&0"]
         HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE) THEN
        ASM_SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
        DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_CONNECTEDNESS) THEN
        SIMP_TAC [CONVEX_HYPERPLANE, CONVEX_CONNECTED],
        ASM_SIMP_TAC [← SET_RULE (← q r"~(x IN s) ==> s DELETE x = s")] THEN
        MATCH_MP_TAC CONNECTED_SPHERE THEN
        MATCH_MP_TAC (← ARITH_RULE (← q r"1 <= n /\ ~(n = 1) ==> 2 <= n")) THEN
        ASM_REWRITE_TAC [DIMINDEX_GE_1]]])

  let CONNECTED_IN_SPHERE_DELETE_INTERIOR_POINT_EQ ← prove
   r"!a b r u s:real^N->bool.
        3 <= dimindex(:N) /\ open_in (subtopology euclidean (sphere(a,r))) u /\
        b IN u /\ u SUBSET s /\ s SUBSET sphere(a,r)
        ==> (connected(s DELETE b) <=> connected s)"
   (REPEAT STRIP_TAC THEN
    STRIP_ASSUME_TAC (← SET_RULE (← q r"s DELETE (b:real^N) = s \/ b IN s")) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ASM_CASES_TAC (← q r"s = {b:real^N}") THEN
    ASM_REWRITE_TAC [CONNECTED_SING, CONNECTED_EMPTY,
                    ← SET_RULE (← q r"{b} DELETE b = {}")] THEN
    ASM_CASES_TAC (← q r"r < &0") THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] SPHERE_EQ_EMPTY) THEN
      ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_NOT_LE])] THEN
    ASM_CASES_TAC (← q r"r = &0") THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real", ← q r"a:real^N"] SPHERE_EQ_SING) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]] THEN
    ASM_CASES_TAC (← q r"s = sphere(a:real^N,r)") THENL
     [FIRST_X_ASSUM SUBST_ALL_TAC THEN
      ASM_REWRITE_TAC [CONNECTED_PUNCTURED_SPHERE, CONNECTED_SPHERE_EQ] THEN
      DISJ1_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?c:real^N. c IN sphere(a,r) /\ ~(c IN s) /\ ~(c = b)")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"sphere(a:real^N,r) DELETE c homeomorphic (:real^(N,1)finite_diff)")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV THEN
      ASM_REWRITE_TAC [DIMINDEX_FINITE_DIFF, DIMINDEX_1] THEN ASM_ARITH_TAC,
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f:real^N->real^(N,1)finite_diff", ← q r"g:real^(N,1)finite_diff->real^N"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HOMEOMORPHISM_CONNECTEDNESS)) THEN
    DISCH_THEN (fun th => tactic_of do pure (
      MP_TAC (← SPEC (← q r"s DELETE (b:real^N)") th) THEN
      MP_TAC (← SPEC (← q r"s:real^N->bool") th))) THEN
    REPEAT (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:real^N->real^(N,1)finite_diff) (s DELETE b) =
      IMAGE f s DELETE f b")
    SUBST1_TAC THENL
     [MATCH_MP_TAC IMAGE_DELETE_INJ_ALT THEN
      ASM_REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, IN_UNIV]) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC CONNECTED_DELETE_INTERIOR_POINT_EQ THEN
    REWRITE_TAC [DIMINDEX_FINITE_DIFF, DIMINDEX_1] THEN
    CONJ_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [OPEN_IN]] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"!u. b IN u /\ IMAGE f u SUBSET t ==> f b IN t")) THEN
    EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC INTERIOR_MAXIMAL THEN ASM_SIMP_TAC [IMAGE_SUBSET] THEN
    REWRITE_TAC [OPEN_IN] THEN
    ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    SUBGOAL_THEN
      (← q r"open_in (subtopology euclidean (sphere(a:real^N,r) DELETE c)) u")
    MP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          OPEN_IN_SUBSET_TRANS)) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC HOMEOMORPHISM_OPENNESS THEN
      EXISTS_TAC (← q r"g:real^(N,1)finite_diff->real^N") THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let CONNECTED_OPEN_IN_SPHERE_DELETE_EQ ← prove
   r"!a b r s:real^N->bool.
        3 <= dimindex(:N) /\ open_in (subtopology euclidean (sphere(a,r))) s
        ==> (connected(s DELETE b) <=> connected s)"
   (REPEAT STRIP_TAC THEN
    STRIP_ASSUME_TAC (← SET_RULE (← q r"s DELETE (b:real^N) = s \/ b IN s")) THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    MATCH_MP_TAC CONNECTED_IN_SPHERE_DELETE_INTERIOR_POINT_EQ THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^N", ← q r"r:real", ← q r"s:real^N->bool"] THEN
    ASM_REWRITE_TAC [SUBSET_REFL])

  let FINITE_COMPONENTS_PUNCTURED_CONNECTED_SUBSET_SPHERE ← prove
   r"!r s a b:real^N.
        connected s /\ s SUBSET sphere(a,r) /\
        b IN (subtopology euclidean (sphere (a,r))) interior_of s
        ==> FINITE(components(s DELETE b))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"FINITE(sphere(a:real^N,r))") THENL
     [MATCH_MP_TAC FINITE_COMPONENTS_FINITE THEN
      ASM_MESON_TAC [FINITE_SUBSET, FINITE_DELETE],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FINITE_SPHERE])] THEN
    REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LE] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
     (← q r"~(n = 1) ==> 1 <= n ==> 3 <= n \/ n = 2"))) THEN
    REWRITE_TAC [DIMINDEX_GE_1] THEN STRIP_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"a:real^N", ← q r"b:real^N", ← q r"r:real",
        ← q r"subtopology euclidean (sphere(a:real^N,r)) interior_of s",
        ← q r"s:real^N->bool"] CONNECTED_IN_SPHERE_DELETE_INTERIOR_POINT_EQ) THEN
      ASM_REWRITE_TAC [OPEN_IN_INTERIOR_OF, INTERIOR_OF_SUBSET] THEN
      SIMP_TAC [CONNECTED_EQ_CARD_COMPONENTS],
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP
       (← REWRITE_RULE [SUBSET] INTERIOR_OF_SUBSET))] THEN
    ASM_CASES_TAC (← q r"s = sphere(a:real^N,r)") THENL
     [MATCH_MP_TAC (← MESON [CONNECTED_EQ_CARD_COMPONENTS]
       (← q r"connected(c:real^N->bool) ==> FINITE(components c)")) THEN
      MP_TAC (← ISPECL
       [← q r"a:real^N", ← q r"r:real", ← q r"b:real^N", ← q r"basis 1:real^N",
        ← q r"&0:real"]
          HOMEOMORPHIC_PUNCTURED_SPHERE_HYPERPLANE) THEN
      ASM_SIMP_TAC [BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP HOMEOMORPHIC_CONNECTEDNESS) THEN
      MATCH_MP_TAC CONVEX_CONNECTED THEN
      REWRITE_TAC [CONVEX_HYPERPLANE],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s = u) ==> s SUBSET u ==> ?z. z IN u /\ ~(z IN s)")))] THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?t. (s:real^N->bool) homeomorphic (t:real^1->bool)")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real", ← q r"c:real^N", ← q r"(:real^1)"]
          HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE) THEN
      ASM_REWRITE_TAC [AFFINE_UNIV, AFF_DIM_UNIV, DIMINDEX_1] THEN
      CONV_TAC INT_REDUCE_CONV THEN
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
      REWRITE_TAC [SUBSET_DELETE, SUBSET_UNIV] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"?d. (s DELETE (b:real^N)) homeomorphic (t DELETE (d:real^1))")
    (X_CHOOSE_THEN (← q r"d:real^1") MP_TAC) THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
      REWRITE_TAC [homeomorphic] THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^N->real^1") THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(f:real^N->real^1) b") THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_CARD_EQ_COMPONENTS) THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP CARD_FINITE_CONG) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHIC_CONNECTEDNESS) THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [← GSYM CONVEX_CONNECTED_1] THEN
      REWRITE_TAC [FINITE_COMPONENTS_PUNCTURED_CONVEX]])

  return { CONNECTED_PUNCTURED_SPHERE, CONNECTED_IN_SPHERE_DELETE_INTERIOR_POINT_EQ,
           CONNECTED_OPEN_IN_SPHERE_DELETE_EQ, FINITE_COMPONENTS_PUNCTURED_CONNECTED_SUBSET_SPHERE }

/- ------------------------------------------------------------------------- -/
/- Components of a sphere complement versus those of the stereographic image. -/
/- (paths.ml 21436-21607)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWD where
  CARD_EQ_COMPONENTS_IN_COMPACTIFICATION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWD [HolBase] (D : PathsDeps) (BS : PTS) (BUH : PUH) (BUP : PUP) (BWC : PWC) :
    ExceptT String IO PWD := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CARD_SING, EQ_TRANS, ETA_AX, FINITE_SING, .. } := D.cvx.core1
  let { FUN_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IN, IN_DELETE, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, NOT_IMP, .. } := D.cvx.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_DELETE, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, pairwise, .. } := D.cvx.core6
  let { interior_of, separated_in, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_UNIV, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_SPHERE, COMPONENTS_MAXIMAL, CONNECTED_CONTINUOUS_IMAGE, .. } :=
    D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { HOMEOMORPHISM_OF_SUBSETS, HOMEOMORPHISM_SYM, IN_COMPONENTS_CONNECTED,
        IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { components, homeomorphism, .. } := D.cvx.top5
  let { CARD_ADD_CONG, CARD_DISJOINT_UNION, CARD_EQ_CARD, CARD_EQ_TRANS, EQ_C_BIJECTIONS, .. } :=
    D.pcard
  let { PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF, SEPARATED_IN_SUBTOPOLOGY, .. } := D.pmet2
  let { BOUNDED_IMAGE_IN_COMPACTIFICATION, .. } := D.ptop1
  let { CONNECTED_COMPONENT_REFL_EQ, .. } := D.ptop2
  let { EUCLIDEAN_CONNECTED_COMPONENTS_OF, .. } := D.ptop3
  let { HOMEOMORPHISM_COMPONENTS, IN_COMPONENTS_MAXIMAL, IN_COMPONENTS_MAXIMAL_ALT, .. } :=
    D.ptop4
  let { OPEN_IN_DIFF_CLOSED, .. } := D.ptop5
  let { LOCALLY_CONNECTED, .. } := BS
  let { CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED, .. } := BUH
  let { LOCALLY_CONNECTED_SPHERE, .. } := BUP
  let { FINITE_COMPONENTS_PUNCTURED_CONNECTED_SUBSET_SPHERE, .. } := BWC
  -- @@SCOPE END

  let CARD_EQ_COMPONENTS_IN_COMPACTIFICATION ← prove
   r"!f g (a:real^N) r s z.
        homeomorphism (sphere(a,r) DELETE z,(:real^M)) (f,g) /\
        s SUBSET sphere(a,r) /\ z IN sphere(a,r) /\ ~(z IN closure s)
        ==> components(sphere(a,r) DIFF s) =_c
            {1} +_c {c | c IN components((:real^M) DIFF IMAGE f s) /\
                         bounded c}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~((z:real^N) IN s)") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, CLOSURE_SUBSET], ALL_TAC] THEN
    ABBREV_TAC (← q r"c = connected_component (sphere(a:real^N,r) DIFF s) z") THEN
    SUBGOAL_THEN (← q r"c IN components(sphere(a:real^N,r) DIFF s)") ASSUME_TAC THENL
     [EXPAND_TAC "c" THEN REWRITE_TAC [components, SIMPLE_IMAGE] THEN
      REWRITE_TAC [ETA_AX] THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
      ASM_REWRITE_TAC [IN_DIFF],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(z:real^N) IN c") ASSUME_TAC THENL
     [EXPAND_TAC "c" THEN REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      ASM_REWRITE_TAC [IN_DIFF],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"components(sphere(a,r) DIFF s) =
      {c} UNION (components(sphere(a:real^N,r) DIFF s) DELETE c)")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) CARD_DISJOINT_UNION o lhand o snd) THEN
    ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_EQ_TRANS) THEN
    MATCH_MP_TAC CARD_ADD_CONG THEN
    SIMP_TAC [CARD_EQ_CARD, CARD_SING, FINITE_SING] THEN
    REWRITE_TAC [EQ_C_BIJECTIONS] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^N->real^M)") THEN
    EXISTS_TAC (← q r"IMAGE (g:real^M->real^N)") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] BOUNDED_IMAGE_IN_COMPACTIFICATION) o
      ONCE_REWRITE_RULE [← SET_RULE (← q r"s DELETE z = s DIFF {z}")] o
      GEN_REWRITE_RULE id [HOMEOMORPHISM_SYM]) THEN
    REWRITE_TAC [COMPACT_SPHERE, CLOSED_UNIV, SUBSET_UNIV] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {z} = {} <=> ~(z IN s)")] THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"d:real^N->bool") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~((z:real^N) IN closure d)") ASSUME_TAC THENL
       [MP_TAC (← ISPEC
         (← q r"subtopology euclidean (sphere(a:real^N,r) DIFF s)")
         PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF) THEN
        REWRITE_TAC [EUCLIDEAN_CONNECTED_COMPONENTS_OF, pairwise] THEN
        REWRITE_TAC [SEPARATED_IN_SUBTOPOLOGY] THEN
        REWRITE_TAC [separated_in, EUCLIDEAN_CLOSURE_OF] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~((z:real^N) IN d)") ASSUME_TAC THENL
       [ASM_MESON_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN d ==> g(f x) = x) ==> IMAGE g (IMAGE f d) = d")) THEN
        REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [IN_DELETE] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
        ASM SET_TAC [],
        DISCH_THEN SUBST1_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_COMPONENTS_MAXIMAL_ALT] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [IMAGE_EQ_EMPTY, IN_COMPONENTS_NONEMPTY],
        REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"DISJOINT d s /\ IMAGE f (d INTER s) = IMAGE f d INTER IMAGE f s
          ==> IMAGE f d SUBSET UNIV DIFF IMAGE f s")) THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"(!x. x IN u ==> g(f x) = x)
          ==> d SUBSET u /\ s SUBSET u
              ==> IMAGE f (d INTER s) = IMAGE f d INTER IMAGE f s"))) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [IN_COMPONENTS_CONNECTED]] THEN
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"c':real^M->bool") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"IMAGE (g:real^M->real^N) c' SUBSET d") MP_TAC THENL
         [ALL_TAC,
          FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
           [homeomorphism]) THEN
          ASM SET_TAC []] THEN
        MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
        EXISTS_TAC (← q r"sphere (a:real^N,r) DIFF s") THEN
        ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
           [homeomorphism]) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          ASM SET_TAC [],
          FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
           [homeomorphism]) THEN
          ASM SET_TAC [],
          FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
            [homeomorphism]) THEN
          REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
          ASM SET_TAC []]],
      X_GEN_TAC (← q r"d:real^M->bool") THEN STRIP_TAC THEN CONJ_TAC THENL
       [ALL_TAC,
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
         [homeomorphism]) THEN
        ASM SET_TAC []] THEN
      REWRITE_TAC [IN_DELETE] THEN CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [CLOSURE_SUBSET, SUBSET]] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM_SYM]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_OF_SUBSETS)) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"(:real^M) DIFF IMAGE (f:real^N->real^M) s",
        ← q r"(sphere(a:real^N,r) DIFF s) DELETE z"]) THEN
      ANTS_TAC THENL
       [REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
        TRANS_TAC EQ_TRANS
         (← q r"IMAGE (g:real^M->real^N) (:real^M) DIFF
          IMAGE g (IMAGE (f:real^N->real^M) s)") THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphism]) THEN
        ASM SET_TAC [],
        DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHISM_COMPONENTS)] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"d:real^M->bool") o MATCH_MP (← SET_RULE
       (← q r"t = IMAGE f s ==> !d. d IN s ==> f d IN t"))) THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_COMPONENTS_MAXIMAL, SUBSET_DELETE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"c':real^N->bool") THEN
      ASM_CASES_TAC (← q r"(z:real^N) IN c'") THENL [STRIP_TAC, ASM_MESON_TAC []] THEN
      SUBGOAL_THEN
       (← q r"IMAGE (g:real^M->real^N) d IN components(c DELETE z)")
      MP_TAC THENL
       [ASM_REWRITE_TAC [IN_COMPONENTS_MAXIMAL, SUBSET_DELETE] THEN
        CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"c':real^N->bool") THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            COMPONENTS_MAXIMAL)) THEN
          ASM SET_TAC [],
          REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [] THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
          ASM SET_TAC []],
        MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"z:real^N"]
          CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [IN_COMPONENTS_CONNECTED]] THEN
      REPEAT DISJ2_TAC THEN
      MATCH_MP_TAC FINITE_COMPONENTS_PUNCTURED_CONNECTED_SUBSET_SPHERE THEN
      MAP_EVERY EXISTS_TAC [← q r"r:real", ← q r"a:real^N"] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
      CONJ_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET)) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] LOCALLY_CONNECTED_SPHERE) THEN
      REWRITE_TAC [LOCALLY_CONNECTED] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"sphere(a:real^N,r) DIFF closure s", ← q r"z:real^N"]) THEN
      SIMP_TAC [OPEN_IN_DIFF_CLOSED, CLOSED_CLOSURE] THEN
      ASM_REWRITE_TAC [IN_DIFF, interior_of, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^N->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            COMPONENTS_MAXIMAL)) THEN
      MP_TAC (← ISPEC (← q r"s:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC []])

  return { CARD_EQ_COMPONENTS_IN_COMPACTIFICATION }

/- ------------------------------------------------------------------------- -/
/- Complements of subsets of simple closed curves and circles.               -/
/- (paths.ml 21608-21670)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWE where
  CONNECTED_COMPLEMENT_SUBSET_SIMPLE_PATH_IMAGE : thm
  CONNECTED_COMPLEMENT_SUBSET_CIRCLE : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWE [HolBase] (D : PathsDeps) (BB : PTB) (BH : PTH) (BJ : PTJ) :
    ExceptT String IO PWE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { DIFF_EMPTY, DIFF_EQ_EMPTY, DIMINDEX_2, .. } := D.cvx.core1
  let { LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.cvx.core3
  let { REAL_LT_IMP_NZ, .. } := D.cvx.core4
  let { SUBSET_DIFF, SUBSET_EMPTY, .. } := D.cvx.core5
  let { BOUNDED_CBALL, .. } := D.cvx.top1
  let { CONNECTED_CLOSED, .. } := D.cvx.top2
  let { SPHERE_EMPTY, .. } := D.cvx.top5
  let { CONNECTED_COMPONENT_REFL_EQ, CONNECTED_EMPTY, CONNECTED_IFF_CONNECTED_COMPONENT,
        CONNECTED_SING, .. } := D.ptop2
  let { SPHERE_SING, connected_component, .. } := D.ptop5
  let { AFF_DIM_CBALL, CONVEX_CBALL, .. } := D.pcvx1
  let { HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS, RELATIVE_FRONTIER_CBALL, .. } :=
    D.pcvx2
  let { ARC_IMP_PATH, PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, CONNECTED_PATH_IMAGE,
        CLOSED_PATH_IMAGE, .. } := BB
  let { EXISTS_DOUBLE_ARC, .. } := BH
  let { HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ, .. } := BJ
  -- @@SCOPE END

  let CONNECTED_COMPLEMENT_SUBSET_SIMPLE_PATH_IMAGE ← prove
   r"!g s:real^N->bool.
        simple_path g /\ pathfinish g = pathstart g /\ s SUBSET path_image g
        ==> (connected(path_image g DIFF s) <=> connected s)"
   (SUBGOAL_THEN
     (← q r"!g s:real^N->bool.
          simple_path g /\ pathfinish g = pathstart g /\ s SUBSET path_image g
          ==> ~connected s ==> ~connected(path_image g DIFF s)")
    MP_TAC THENL
     [ALL_TAC,
      MESON_TAC [SUBSET_DIFF, ← SET_RULE
        (← q r"s SUBSET t ==> t DIFF (t DIFF s) = s")]] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV)
     [CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"a:real^N", ← q r"b:real^N"]
          EXISTS_DOUBLE_ARC) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"g1:real^1->real^N", ← q r"g2:real^1->real^N"] THEN
    STRIP_TAC THEN REWRITE_TAC [CONNECTED_CLOSED] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"path_image g1:real^N->bool", ← q r"path_image g2:real^N->bool"] THEN
    ASM_SIMP_TAC [CLOSED_PATH_IMAGE, ARC_IMP_PATH] THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"~connected_component s (a:real^N) b") THEN
    REWRITE_TAC [connected_component] THENL
     [EXISTS_TAC (← q r"path_image g1:real^N->bool"),
      EXISTS_TAC (← q r"path_image g2:real^N->bool")] THEN
    ASM_SIMP_TAC [CONNECTED_PATH_IMAGE, ARC_IMP_PATH] THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE])

  let CONNECTED_COMPLEMENT_SUBSET_CIRCLE ← prove
   r"!s a:real^N r.
        dimindex(:N) = 2 /\ s SUBSET sphere(a,r)
        ==> (connected(sphere(a,r) DIFF s) <=> connected s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, SUBSET_EMPTY, DIFF_EQ_EMPTY] THEN
    ASM_CASES_TAC (← q r"r = &0") THENL
     [ASM_SIMP_TAC [SPHERE_SING,
                   ← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
      STRIP_TAC THEN
      ASM_SIMP_TAC [DIFF_EMPTY, CONNECTED_EMPTY, CONNECTED_SING, DIFF_EQ_EMPTY],
      SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"cball(a:real^N,r)", ← q r"cball(vec 0:real^2,r)"]
     HOMEOMORPHIC_RELATIVE_FRONTIERS_CONVEX_BOUNDED_SETS) THEN
    REWRITE_TAC [CONVEX_CBALL, BOUNDED_CBALL] THEN
    ASM_SIMP_TAC [RELATIVE_FRONTIER_CBALL, REAL_LT_IMP_NZ, AFF_DIM_CBALL] THEN
    ASM_REWRITE_TAC [DIMINDEX_2] THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    ASM_MESON_TAC [CONNECTED_COMPLEMENT_SUBSET_SIMPLE_PATH_IMAGE])

  return { CONNECTED_COMPLEMENT_SUBSET_SIMPLE_PATH_IMAGE, CONNECTED_COMPLEMENT_SUBSET_CIRCLE }

/- ------------------------------------------------------------------------- -/
/- When dealing with AR, ANR and ANR later, it's useful to know that any set -/
/- at all is homeomorphic to a closed subset of a convex set, and if the     -/
/- set is locally compact we can take the convex set to be the universe.     -/
/- (paths.ml 21671-21790)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWF where
  HOMEOMORPHIC_CLOSED_IN_CONVEX : thm
  LOCALLY_COMPACT_HOMEOMORPHIC_CLOSED : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWF [HolBase] (D : PathsDeps) (BWB : PWB) : ExceptT String IO PWF := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INT_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC,
        GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CART_EQ, DIMINDEX_1, DIMINDEX_FINITE_SUM, DIMINDEX_GE_1, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, INT_OF_NUM_LT, IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_01, .. } := D.cvx.core4
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_UNION, .. } := D.cvx.core5
  let { UNION_SUBSET, UNIV_NOT_EMPTY, o_THM, .. } := D.cvx.core6
  let { HULL_INC, .. } := D.cvx.misc
  let { BASIS_NONZERO, CHOOSE_SUBSPACE_OF_SUBSPACE, DIM_SPAN, DIM_SPECIAL_HYPERPLANE,
        DOT_BASIS, .. } := D.cvx.vec1
  let { ISOMETRIES_SUBSPACES, NORM_BASIS, .. } := D.cvx.vec2
  let { SPAN_INC, SPAN_OF_SUBSPACE, SPAN_SUPERSET, SUBSPACE_SPAN, .. } := D.cvx.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, linear, .. } := D.cvx.vec4
  let { BALL_SUBSET_CBALL, CBALL_DIFF_SPHERE, CLOSED_IN_CLOSED, .. } := D.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, HOMEOMORPHIC_EMPTY, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM, IN_CBALL_0, IN_SPHERE_0,
        LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { homeomorphic, .. } := D.cvx.top5
  let { SUBSPACE_SPECIAL_HYPERPLANE, .. } := D.pvec
  let { CLOSED_IN_EMPTY, .. } := D.pmet1
  let { CLOSED_INJECTIVE_LINEAR_IMAGE, CLOSED_SPHERE, .. } := D.ptop1
  let { LOCALLY_COMPACT_HOMEOMORPHISM_PROJECTION_CLOSED, .. } := D.ptop4
  let { AFFINE_HYPERPLANE, AFF_DIM_DIM_0, AFF_DIM_HYPERPLANE, .. } := D.pcvx1
  let { CONVEX_INTERMEDIATE_BALL, CONVEX_UNIV, .. } := D.pcvx2
  let { HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE, .. } := BWB
  -- @@SCOPE END

  let HOMEOMORPHIC_CLOSED_IN_CONVEX ← prove
   r"!s:real^M->bool.
        aff_dim s < &(dimindex(:N))
        ==> ?u t:real^N->bool.
                convex u /\
                ~(u = {}) /\
                closed_in (subtopology euclidean u) t /\
                s homeomorphic t"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^M->bool = {}") THENL
     [REPEAT STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"(:real^N)", ← q r"{}:real^N->bool"] THEN
      REWRITE_TAC [CONVEX_UNIV, UNIV_NOT_EMPTY, CLOSED_IN_EMPTY] THEN
      ASM_REWRITE_TAC [HOMEOMORPHIC_EMPTY],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^M") MP_TAC) THEN
    GEOM_ORIGIN_TAC (← q r"a:real^M") THEN
    SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, INT_OF_NUM_LT] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{x:real^N | x$1 = &0}", ← q r"dim(s:real^M->bool)"]
          CHOOSE_SUBSPACE_OF_SUBSPACE) THEN
    SIMP_TAC [DIM_SPECIAL_HYPERPLANE, DIMINDEX_GE_1, LE_REFL, SUBSET, IN_ELIM_THM,
             SPAN_OF_SUBSPACE, SUBSPACE_SPECIAL_HYPERPLANE] THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"t:real^N->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"span s:real^M->bool", ← q r"t:real^N->bool"]
      ISOMETRIES_SUBSPACES) THEN
    ASM_REWRITE_TAC [SUBSPACE_SPAN, DIM_SPAN, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:real^M->real^N", ← q r"k:real^N->real^M"] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^N", ← q r"&1", ← q r"basis 1:real^N",
                   ← q r"{x:real^N | basis 1 dot x = &0}"]
          HOMEOMORPHIC_PUNCTURED_SPHERE_AFFINE) THEN
    SIMP_TAC [AFFINE_HYPERPLANE, AFF_DIM_HYPERPLANE, BASIS_NONZERO,
             DIMINDEX_GE_1, LE_REFL, REAL_LT_01, IN_SPHERE_0, NORM_BASIS] THEN
    ANTS_TAC THENL [INT_ARITH_TAC, ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM]] THEN
    SIMP_TAC [DOT_BASIS, DIMINDEX_GE_1, LE_REFL, homeomorphic] THEN
    REWRITE_TAC [HOMEOMORPHISM, LEFT_IMP_EXISTS_THM, IN_ELIM_THM,
                SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0, IN_DELETE] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"ball(vec 0,&1) UNION
                IMAGE ((f:real^N->real^N) o (h:real^M->real^N)) s") THEN
    EXISTS_TAC (← q r"IMAGE ((f:real^N->real^N) o (h:real^M->real^N)) s") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONVEX_INTERMEDIATE_BALL THEN
      MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"&1"] THEN
      REWRITE_TAC [SUBSET_UNION, UNION_SUBSET, BALL_SUBSET_CBALL] THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_THM, IN_CBALL_0] THEN
      ASM_MESON_TAC [SPAN_SUPERSET, REAL_LE_REFL],
      REWRITE_TAC [NOT_IN_EMPTY, IMAGE_o] THEN ASM SET_TAC [],
      REWRITE_TAC [CLOSED_IN_CLOSED] THEN
      EXISTS_TAC (← q r"sphere(vec 0:real^N,&1)") THEN
      REWRITE_TAC [CLOSED_SPHERE] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"b INTER t = {} /\ s SUBSET t ==> s = (b UNION s) INTER t")) THEN
      REWRITE_TAC [← GSYM CBALL_DIFF_SPHERE] THEN
      CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [SUBSET]] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, o_THM, IN_SPHERE_0] THEN
      ASM_MESON_TAC [SPAN_SUPERSET],
      MAP_EVERY EXISTS_TAC
       [← q r"(k:real^N->real^M) o (g:real^N->real^N)",
        ← q r"(f:real^N->real^N) o (h:real^M->real^N)"] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, o_THM, IMAGE_o] THEN
      REPEAT CONJ_TAC THEN
      TRY (MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON]) THEN
      TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       CONTINUOUS_ON_SUBSET))) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_SPHERE_0, IN_DELETE] THEN
      MP_TAC (← ISPEC (← q r"s:real^M->bool") SPAN_INC) THEN ASM SET_TAC []])

  let LOCALLY_COMPACT_HOMEOMORPHIC_CLOSED ← prove
   r"!s:real^M->bool.
        locally compact s /\ dimindex(:M) < dimindex(:N)
        ==> ?t:real^N->bool. closed t /\ s homeomorphic t"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"?t:real^(M,1)finite_sum->bool h.
              closed t /\ homeomorphism (s,t) (h,fstcart)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [LOCALLY_COMPACT_HOMEOMORPHISM_PROJECTION_CLOSED],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"f:real^(M,1)finite_sum->real^N =
          \x. lambda i. if i <= dimindex(:M) then x$i
                        else x$(dimindex(:M)+1)") THEN
    ABBREV_TAC
     (← q r"g:real^N->real^(M,1)finite_sum = (\x. lambda i. x$i)") THEN
    EXISTS_TAC (← q r"IMAGE (f:real^(M,1)finite_sum->real^N) t") THEN
    SUBGOAL_THEN (← q r"linear(f:real^(M,1)finite_sum->real^N)") ASSUME_TAC THENL
     [EXPAND_TAC "f" THEN REWRITE_TAC [linear, CART_EQ] THEN
      SIMP_TAC [LAMBDA_BETA, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"linear(g:real^N->real^(M,1)finite_sum)") ASSUME_TAC THENL
     [EXPAND_TAC "g" THEN REWRITE_TAC [linear, CART_EQ] THEN
      SIMP_TAC [LAMBDA_BETA, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. (g:real^N->real^(M,1)finite_sum)((f:real^(M,1)finite_sum->real^N) x) =
          x")
    ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["f", "g"] THEN FIRST_ASSUM (MP_TAC o MATCH_MP
       (← ARITH_RULE (← q r"m < n ==> !i. i <= m + 1 ==> i <= n"))) THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA, DIMINDEX_FINITE_SUM, DIMINDEX_1] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"i <= n + 1 <=> i <= n \/ i = n + 1")] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CLOSED_INJECTIVE_LINEAR_IMAGE], ALL_TAC] THEN
    TRANS_TAC HOMEOMORPHIC_TRANS (← q r"t:real^(M,1)finite_sum->bool") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [homeomorphic], ALL_TAC] THEN
    REWRITE_TAC [homeomorphic, HOMEOMORPHISM] THEN MAP_EVERY EXISTS_TAC
     [← q r"f:real^(M,1)finite_sum->real^N", ← q r"g:real^N->real^(M,1)finite_sum"] THEN
    ASM_SIMP_TAC [LINEAR_CONTINUOUS_ON] THEN ASM SET_TAC [])

  return { HOMEOMORPHIC_CLOSED_IN_CONVEX, LOCALLY_COMPACT_HOMEOMORPHIC_CLOSED }

/- ------------------------------------------------------------------------- -/
/- Simple connectedness of a union. This is essentially a stripped-down      -/
/- version of the Seifert - Van Kampen theorem.  (paths.ml 21791-22063)      -/
/- ------------------------------------------------------------------------- -/

structure PWG where
  SIMPLY_CONNECTED_UNION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWG [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BF : PTF) (BI : PTI)
    (BK : PTK) (BL : PTL) (BVI : PVI) (BVJ : PVJ) (BVN : PVN) (BVQ : PVQ) (BVR : PVR) :
    ExceptT String IO PWG := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, EMPTY_SUBSET, EXISTS_IN_INSERT, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_IN_IMAGE, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, INSERT_SUBSET, INTER_COMM, .. } := D.cvx.core2
  let { IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, LE_1, LE_REFL, LT_IMP_LE, MONO_EXISTS,
        MONO_IMP, NOT_IN_EMPTY, REAL_ABS_INV, REAL_ABS_NUM, REAL_ARCH_INV, REAL_DIV_REFL, .. } :=
    D.cvx.core3
  let { REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, .. } := D.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_OF_NUM_SUC, SUBSET, SUBSET_INTER, SUBSET_UNION, .. } := D.cvx.core5
  let { UNIONS_2, UNION_COMM, UNION_SUBSET, num_INDUCTION, num_MAX, real_div, .. } :=
    D.cvx.core6
  let { HULL_MINIMAL, .. } := D.cvx.misc
  let { DROP_VEC, LIFT_DROP, LIFT_NUM, LIFT_SUB, .. } := D.cvx.vec2
  let { dist, drop, .. } := D.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.cvx.top2
  let { ENDS_IN_SEGMENT, .. } := D.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, SEGMENT_1, SEGMENT_REFL, .. } := D.cvx.top5
  let { LT, .. } := D.pses1
  let { num_WF, .. } := D.pses2
  let { ENDS_IN_UNIT_INTERVAL, NORM_REAL, .. } := D.pvec
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.ptop1
  let { HEINE_BOREL_LEMMA, .. } := D.ptop3
  let { uniformly_continuous_on, .. } := D.ptop5
  let { CONVEX_BALL, .. } := D.pcvx1
  let { SEGMENT_CONVEX_HULL, UNION_SEGMENT, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, COMPACT_PATH_IMAGE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_JOIN_IMP,
        SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { PATH_IMAGE_SUBPATH_GEN, PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
        SUBPATH_TRIVIAL, PATH_IMAGE_SUBPATH_SUBSET, .. } := BF
  let { PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, SUBPATH_REFL, .. } := BI
  let { path_connected, .. } := BK
  let { PATH_CONNECTED_UNION, .. } := BL
  let { HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_REFL,
        HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS, HOMOTOPIC_PATHS_SUBSET, .. } := BVI
  let { HOMOTOPIC_PATHS_JOIN, .. } := BVJ
  let { HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS, .. } := BVN
  let { HOMOTOPIC_JOIN_SUBPATHS, HOMOTOPIC_PATHS_LOOP_PARTS, .. } := BVQ
  let { SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH, .. } := BVR
  -- @@SCOPE END

  let SIMPLY_CONNECTED_UNION ← prove
   r"!s t:real^N->bool.
    open_in (subtopology euclidean (s UNION t)) s /\
    open_in (subtopology euclidean (s UNION t)) t /\
    simply_connected s /\ simply_connected t /\
    path_connected (s INTER t) /\ ~(s INTER t = {})
    ==> simply_connected (s UNION t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_OPEN] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"u:real^N->bool")
     (STRIP_ASSUME_TAC o GSYM)) MP_TAC) THEN
     DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"v:real^N->bool")
     (STRIP_ASSUME_TAC o GSYM)) MP_TAC) THEN
    SIMP_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH, PATH_CONNECTED_UNION] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(pathstart p:real^N) IN s UNION t") MP_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET], REWRITE_TAC [IN_UNION]] THEN
    POP_ASSUM_LIST (MP_TAC o HolLight.end_itlist CONJ o HolLight.rev) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN
    MAP_EVERY (fun x => SPEC_TAC (x, x))
     [← q r"v:real^N->bool", ← q r"u:real^N->bool", ← q r"t:real^N->bool",
      ← q r"s:real^N->bool"] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!s t u v. x IN s ==> P x s t u v) /\
      (!x s t u v. P x s t u v ==> P x t s v u)
      ==> (!s t u v. x IN s \/ x IN t ==>  P x s t u v)")) THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC,
      REPEAT GEN_TAC THEN REWRITE_TAC [UNION_COMM, INTER_COMM] THEN
      MATCH_MP_TAC MONO_IMP THEN SIMP_TAC []] THEN
    SUBGOAL_THEN
     (← q r"?e. &0 < e /\
          !x y. x IN interval[vec 0,vec 1] /\ y IN interval[vec 0,vec 1] /\
                norm(x - y) < e
                ==> path_image(subpath x y p) SUBSET (s:real^N->bool) \/
                    path_image(subpath x y p) SUBSET t")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"path_image(p:real^1->real^N)") HEINE_BOREL_LEMMA) THEN
      ASM_SIMP_TAC [COMPACT_PATH_IMAGE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{u:real^N->bool,v}")) THEN
      SIMP_TAC [UNIONS_2, EXISTS_IN_INSERT, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"p:real^1->real^N", ← q r"interval[vec 0:real^1,vec 1]"]
          COMPACT_UNIFORMLY_CONTINUOUS) THEN
      ASM_REWRITE_TAC [← GSYM path, COMPACT_INTERVAL, uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [dist] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(p:real^1->real^N) x")) THEN
      ANTS_TAC THENL [REWRITE_TAC [path_image] THEN ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"!p'. p SUBSET b /\
             (s UNION t) INTER u = s /\ (s UNION t) INTER v = t /\
             p SUBSET p' /\ p' SUBSET s UNION t
             ==>  (b SUBSET u \/ b SUBSET v) ==> p SUBSET s \/ p SUBSET t")) THEN
      EXISTS_TAC (← q r"path_image(p:real^1->real^N)") THEN
      ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET] THEN
      REWRITE_TAC [PATH_IMAGE_SUBPATH_GEN, SUBSET, FORALL_IN_IMAGE] THEN
      SUBGOAL_THEN (← q r"segment[x,y] SUBSET ball(x:real^1,d)") MP_TAC THENL
       [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
        ASM_REWRITE_TAC [INSERT_SUBSET, CENTRE_IN_BALL] THEN
        ASM_REWRITE_TAC [IN_BALL, EMPTY_SUBSET, CONVEX_BALL, dist],
        REWRITE_TAC [IN_BALL, dist, SUBSET] THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"z:real^1") THEN DISCH_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [SEGMENT_1]) THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
        ASM_REAL_ARITH_TAC],
      MP_TAC (← SPEC (← q r"e:real") REAL_ARCH_INV) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"N:num") THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. n <= N /\ p(lift(&n / &N)) IN s
          ==> ?q. path(q:real^1->real^N) /\ path_image q SUBSET s /\
                  homotopic_paths (s UNION t)
                                  (subpath (vec 0) (lift(&n / &N)) p) q")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"N:num")) THEN
      ASM_SIMP_TAC [REAL_DIV_REFL, REAL_OF_NUM_EQ, LE_REFL, LIFT_NUM] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [pathfinish], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->real^N") MP_TAC) THEN
      REWRITE_TAC [SUBPATH_TRIVIAL] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_PATHS_TRANS) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMOTOPIC_PATHS_SUBSET THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_MESON_TAC [SUBSET_UNION]] THEN
    SUBGOAL_THEN
     (← q r"!n. n < N
          ==> path_image(subpath (lift(&n / &N)) (lift(&(SUC n) / &N)) p)
                SUBSET (s:real^N->bool) \/
              path_image(subpath (lift(&n / &N)) (lift(&(SUC n) / &N)) p)
                SUBSET t")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_SUB, DROP_VEC,
                  NORM_REAL, ← GSYM drop,
                  ← REAL_ARITH (← q r"abs(a / c - b / c) = abs((b - a) / c)")] THEN
      ASM_SIMP_TAC [← GSYM REAL_OF_NUM_SUC, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
                   REAL_OF_NUM_LT, LE_1, ← REAL_ARITH (← q r"(x + &1) - x = &1")] THEN
      ASM_REWRITE_TAC [real_div, REAL_MUL_LID, REAL_MUL_LZERO, REAL_ABS_INV,
        REAL_ABS_NUM, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"n:num") THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 / x = &0"), LIFT_NUM] THEN
      EXISTS_TAC (← q r"linepath((p:real^1->real^N)(vec 0),p(vec 0))") THEN
      REWRITE_TAC [SUBPATH_REFL, HOMOTOPIC_PATHS_REFL] THEN
      REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
      UNDISCH_TAC (← q r"(pathstart p:real^N) IN s") THEN REWRITE_TAC [pathstart] THEN
      SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"\m. m < n /\ (p(lift(&m / &N)):real^N) IN s") num_MAX) THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")) THEN
    CONJ_TAC THENL
     [CONJ_TAC THENL [EXISTS_TAC (← q r"0"), MESON_TAC [LT_IMP_LE]] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 / x = &0"), LIFT_NUM, LE_1] THEN
      ASM_MESON_TAC [pathstart],
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN
     (← q r"?q. path q /\
          path_image(q:real^1->real^N) SUBSET s /\
          homotopic_paths (s UNION t) (subpath (vec 0) (lift (&m / &N)) p) q")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. m < i /\ i <= n
          ==> path_image(subpath (lift(&m / &N)) (lift(&i / &N)) p) SUBSET s \/
              path_image(subpath (lift(&m / &N)) (lift(&i / &N)) p) SUBSET
                   (t:real^N->bool)")
    MP_TAC THENL
     [MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [← CONJUNCT1 LT] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_CASES_TAC (← q r"i:num = m") THENL
       [DISCH_THEN (K ALL_TAC : thm → tactic) THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC]] THEN
      SUBGOAL_THEN
       (← q r"p(lift(&i / &N)) IN t /\ ~((p(lift(&i / &N)):real^N) IN s)")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"x IN s UNION t /\ ~(x IN s) ==> x IN t /\ ~(x IN s)")) THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"s SUBSET t ==> x IN s ==> x IN t"))) THEN
          REWRITE_TAC [path_image] THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
          ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT,
                       LE_1, REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
          ASM_ARITH_TAC,
          SUBGOAL_THEN (← q r"i < n /\ ~(i:num <= m)") MP_TAC THENL
           [ASM_ARITH_TAC, ASM_MESON_TAC []]],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"path_image(subpath (lift(&i / &N)) (lift (&(SUC i) / &N)) p) SUBSET s \/
        path_image(subpath (lift(&i / &N)) (lift (&(SUC i) / &N)) p) SUBSET
          (t:real^N->bool)")
      MP_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(x IN s)
        ==> (x IN p /\ x IN q) /\ (q UNION p = r)
            ==> p SUBSET s \/ p SUBSET t
                ==> q SUBSET s \/ q SUBSET t
                    ==> r SUBSET s \/ r SUBSET t"))) THEN
      SIMP_TAC [PATH_IMAGE_SUBPATH_GEN, FUN_IN_IMAGE, ENDS_IN_SEGMENT] THEN
      REWRITE_TAC [← GSYM IMAGE_UNION] THEN AP_TERM_TAC THEN
      MATCH_MP_TAC UNION_SEGMENT THEN
      ASM_SIMP_TAC [SEGMENT_1, LIFT_DROP, REAL_LE_DIV2_EQ, REAL_OF_NUM_LT,
                   LE_1, REAL_OF_NUM_LE, LT_IMP_LE, IN_INTERVAL_1] THEN
      ASM_ARITH_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"n:num")) THEN ASM_REWRITE_TAC [LE_REFL]] THEN
    STRIP_TAC THENL
     [EXISTS_TAC (← q r"(q:real^1->real^N) ++
                  subpath (lift(&m / &N)) (lift (&n / &N)) p") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC PATH_JOIN_IMP THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
        ASM_SIMP_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
        DISCH_TAC THEN MATCH_MP_TAC PATH_SUBPATH THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT,
                     LE_1, REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
        ASM_ARITH_TAC,
        MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
        EXISTS_TAC (← q r"subpath (vec 0) (lift(&m / &N)) (p:real^1->real^N) ++
                    subpath (lift(&m / &N)) (lift(&n / &N)) p") THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
          MATCH_MP_TAC HOMOTOPIC_JOIN_SUBPATHS THEN
          ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL],
          MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
          ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
          MATCH_MP_TAC HOMOTOPIC_PATHS_SUBSET THEN
          EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_UNION] THEN
          ASM_REWRITE_TAC [HOMOTOPIC_PATHS_REFL] THEN
          MATCH_MP_TAC PATH_SUBPATH] THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT,
                     LE_1, REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
        ASM_ARITH_TAC],
      SUBGOAL_THEN
       (← q r"(p(lift(&m / &N)):real^N) IN t /\ (p(lift(&n / &N)):real^N) IN t")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE,
                      PATHSTART_SUBPATH, PATHFINISH_SUBPATH, SUBSET],
        ALL_TAC] THEN
      UNDISCH_TAC (← q r"path_connected(s INTER t:real^N->bool)") THEN
      REWRITE_TAC [path_connected] THEN DISCH_THEN (MP_TAC o SPECL
       [← q r"p(lift(&m / &N)):real^N", ← q r"p(lift(&n / &N)):real^N"]) THEN
      ASM_REWRITE_TAC [IN_INTER, SUBSET_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^1->real^N") STRIP_ASSUME_TAC) THEN
      UNDISCH_THEN
       (← q r"!p. path p /\ path_image p SUBSET t /\ pathfinish p:real^N = pathstart p
            ==> homotopic_paths t p (linepath (pathstart p,pathstart p))")
       (MP_TAC o SPEC (← q r"subpath (lift(&m / &N)) (lift(&n / &N)) p ++
                       reversepath(r:real^1->real^N)")) THEN
      ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                  PATHSTART_JOIN, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH] THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_REVERSEPATH] THEN
        MATCH_MP_TAC PATH_JOIN_IMP THEN
        ASM_SIMP_TAC [PATH_REVERSEPATH, PATHFINISH_SUBPATH,
                     PATHSTART_REVERSEPATH] THEN
        MATCH_MP_TAC PATH_SUBPATH THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT,
                     LE_1, REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
       DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS)) THEN
       ASM_REWRITE_TAC [PATHFINISH_LINEPATH, PATHSTART_SUBPATH,
         PATHSTART_JOIN, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH] THEN
       DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_PATHS_LOOP_PARTS)) THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
       FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
       REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
       REPLICATE_TAC 2 (DISCH_THEN (ASSUME_TAC o SYM)) THEN
       ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
       EXISTS_TAC (← q r"(q:real^1->real^N) ++ r") THEN
       ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, UNION_SUBSET] THEN
       MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
       EXISTS_TAC (← q r"subpath (vec 0) (lift(&m / &N)) (p:real^1->real^N) ++
                   subpath (lift(&m / &N)) (lift(&n / &N)) p") THEN
       CONJ_TAC THENL
        [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
         MATCH_MP_TAC HOMOTOPIC_JOIN_SUBPATHS THEN
         ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
         ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
         ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT,
                      LE_1, REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
         ASM_ARITH_TAC,
         MATCH_MP_TAC HOMOTOPIC_PATHS_JOIN THEN
         ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
         MATCH_MP_TAC HOMOTOPIC_PATHS_SUBSET THEN
         EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_UNION]]])

  return { SIMPLY_CONNECTED_UNION }

/- ------------------------------------------------------------------------- -/
/- Basic results about topological dimension.  (paths.ml 22064-22341)        -/
/- ------------------------------------------------------------------------- -/

structure PWH where
  dimension : thm
  DIMENSION_GE : thm
  DIMENSION_LE_IMP_GE : thm
  HOMEOMORPHIC_DIMENSION : thm
  DIMENSION_LE_EQ : thm
  LOCALLY_DIMENSION_LE : thm
  DIMENSION_LE_AFF_DIM : thm
  DIMENSION_DIMENSION_LE : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWH [HolBase] (D : PathsDeps) (BWA : PWA) : ExceptT String IO PWH := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH, INT_ARITH_TAC,
        MESON, MESON_TAC, SET_RULE, SET_TAC, INT_REDUCE_CONV, VECTOR_ARITH, NORM_ARITH, .. } :=
    D.cvx
  let { AND_FORALL_THM, CONTRAPOS_THM, EQ_IMP, EXISTS_REFL, .. } := D.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INTER_COMM, INTER_SUBSET, INT_LE_ANTISYM, INT_LE_REFL,
        INT_LE_TRANS, INT_OF_NUM_EXISTS, INT_OF_NUM_LE, INT_OF_NUM_SUC, IN_DELETE, .. } :=
    D.cvx.core2
  let { IN_INTER, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_LE, .. } :=
    D.cvx.core3
  let { REAL_LT_REFL, .. } := D.cvx.core4
  let { RIGHT_FORALL_IMP_THM, SUBSET_REFL, .. } := D.cvx.core5
  let { SWAP_FORALL_THM, .. } := D.cvx.core6
  let { HULL_SUBSET, .. } := D.cvx.misc
  let { CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { CENTRE_IN_BALL, CLOSED_CLOSURE, CLOSED_IN_CLOSED_INTER, CLOSURE_BALL, .. } := D.cvx.top1
  let { CLOSURE_MINIMAL_EQ, CLOSURE_SUBSET, .. } := D.cvx.top2
  let { EUCLIDEAN_CLOSURE_OF, FRONTIER_BALL, .. } := D.cvx.top3
  let { INTERIOR_OPEN, IN_SPHERE, OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { OPEN_IN, OPEN_INTER, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, OPEN_IN_REFL, SUBSET_CLOSURE,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, closed, frontier, .. } := D.cvx.top5
  let { INT_LE_TRANS_LE, .. } := D.pses1
  let { MINIMAL, .. } := D.pses2
  let { CLOSURE_OF_CLOSED_IN, DIMENSION_LE_BOUND, DIMENSION_LE_EQ_EMPTY,
        DIMENSION_LE_EQ_SUBTOPOLOGY, DIMENSION_LE_MONO, DIMENSION_LE_SUBTOPOLOGIES,
        DIMENSION_LE_SUBTOPOLOGY, FRONTIER_OF_CLOSURES, HOMEOMORPHIC_SPACE_DIMENSION_LE, .. } :=
    D.pmet1
  let { SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { HOMEOMORPHIC_SPACE_EUCLIDEAN, LOCALLY_CLOSED_IN_EXPLICIT, LOCALLY_ON_OPEN_SUBSETS, .. } :=
    D.ptop4
  let { OPEN_CLOSED, OPEN_IN_CONTAINS_CBALL, OPEN_IN_DELETE, SEPARATION_CLOSURES,
        SEPARATION_OPEN_IN_UNION, locally, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_EXISTS, AFF_DIM_AFFINE_HULL, AFF_DIM_EQ_MINUS1, AFF_DIM_GE,
        AFF_DIM_LE_UNIV, AFF_DIM_POS_LE, .. } := D.pcvx1
  let { IN_AFFINE_SUB_MUL_DIFF, .. } := D.pcvx2
  let { HOMEOMORPHIC_PUNCTURED_AFFINE_SPHERE_AFFINE, .. } := BWA
  -- @@SCOPE END

  let dimension ← new_definition
   r"(dimension:(real^N->bool)->int) s =
        if s = {} then --(&1)
        else &(minimal n. (subtopology euclidean s) dimension_le &n)"

  let DIMENSION_GE ← prove
   r"!s:real^N->bool. -- &1 <= dimension s"
   (GEN_TAC THEN REWRITE_TAC [dimension, INT_LE_REFL] THEN INT_ARITH_TAC)

  let DIMENSION_LE_IMP_GE ← prove
   r"!s:real^N->bool n. dimension s <= n ==> -- &1 <= n"
   (REWRITE_TAC [← GSYM INT_LE_TRANS_LE, DIMENSION_GE])

  let (HOMEOMORPHIC_DIMENSION, DIMENSION_LE_EQ, LOCALLY_DIMENSION_LE,
       DIMENSION_LE_AFF_DIM, DIMENSION_DIMENSION_LE) ← (do
    let HOMEOMORPHIC_DIMENSION_LE' ← prove
     r"!s:real^M->bool t:real^N->bool n.
            s homeomorphic t
            ==> (subtopology euclidean s dimension_le n <=>
                 subtopology euclidean t dimension_le n)"
     (REWRITE_TAC [← GSYM HOMEOMORPHIC_SPACE_EUCLIDEAN] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE_DIMENSION_LE])
    let DIMENSION_LE_EQ' ← prove
     r"!s:real^N->bool n.
            (subtopology euclidean s) dimension_le n <=>
            -- &1 <= n /\
            !v a. open v /\ a IN v /\ a IN s
                  ==> ?u. a IN u /\ u SUBSET v /\ open u /\
                          subtopology euclidean (s INTER frontier u)
                          dimension_le (n - &1)"
     (REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_EQ_SUBTOPOLOGY] THEN
      REWRITE_TAC [← GSYM OPEN_IN] THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC
        (BINOP_CONV o funpow 2 BINDER_CONV o RAND_CONV o ONCE_DEPTH_CONV)
       [← TAUT (← q r"open(u:real^N->bool) /\ p <=> ~(open u ==> ~p)")] THEN
      SIMP_TAC [frontier, INTERIOR_OPEN, FRONTIER_OF_CLOSURES] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF s INTER u = s INTER (UNIV DIFF u)")] THEN
      SIMP_TAC [CLOSURE_OF_CLOSED_IN, CLOSED_IN_CLOSED_INTER,
               ← GSYM OPEN_CLOSED] THEN
      REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
      REWRITE_TAC [← TAUT (← q r"~(p ==> ~q) <=> p /\ q")] THEN
      REWRITE_TAC [← SET_RULE (← q r"s INTER s INTER u = s INTER u")] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"(s INTER t) INTER (s INTER (UNIV DIFF u)) = (s INTER t) DIFF u")] THEN
      REWRITE_TAC [EUCLIDEAN_CLOSURE_OF] THEN
      EQ_TAC THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN STRIP_TAC THENL
       [ALL_TAC,
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"a:real^N"]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"u:real^N->bool") THEN
        REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] DIMENSION_LE_SUBTOPOLOGIES) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"t SUBSET t' ==> s INTER t DIFF u SUBSET s INTER (t' DIFF u)")) THEN
        MATCH_MP_TAC SUBSET_CLOSURE THEN REWRITE_TAC [INTER_SUBSET]] THEN
      SUBGOAL_THEN
       (← q r"?w:real^N->bool. a IN w /\ open w /\ closure w SUBSET v")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"(:real^N)", ← q r"v:real^N->bool", ← q r"a:real^N"]
          LOCALLY_CLOSED_IN_EXPLICIT) THEN
        ASM_SIMP_TAC [← GSYM OPEN_IN, SUBTOPOLOGY_UNIV, EUCLIDEAN_CLOSURE_OF] THEN
        MESON_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:real^N->bool", ← q r"a:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL
       [← q r"s INTER u:real^N->bool", ← q r"s DIFF closure(s INTER u):real^N->bool"]
       SEPARATION_CLOSURES) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [SEPARATION_OPEN_IN_UNION] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
            (← q r"s INTER t SUBSET u ==> DISJOINT (s INTER t) (s DIFF u)")) THEN
          REWRITE_TAC [CLOSURE_SUBSET],
          REWRITE_TAC [OPEN_IN_OPEN] THEN CONJ_TAC THENL
           [EXISTS_TAC (← q r"u:real^N->bool"),
            EXISTS_TAC (← q r"(:real^N) DIFF closure(s INTER u)")] THEN
          ASM_REWRITE_TAC [← GSYM closed, CLOSED_CLOSURE] THEN SET_TAC []],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"c:real^N->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"t INTER v:real^N->bool") THEN
      ASM_SIMP_TAC [IN_INTER, INTER_SUBSET, OPEN_INTER] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            DIMENSION_LE_SUBTOPOLOGIES)) THEN
      MATCH_MP_TAC (← SET_RULE
