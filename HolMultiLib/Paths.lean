  let DIMENSION_LE_UNIONS ← prove
   r"!c:(real^N->bool)->bool n.
        -- &1 <= n /\
        COUNTABLE c /\
        (!s. s IN c ==> fsigma s /\ dimension s <= n)
        ==> dimension(UNIONS c) <= n"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DIMENSION_LE_UNIONS_RELATIVE THEN
