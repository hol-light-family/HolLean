    SUBGOAL_THEN (← q r"INFINITE(vv:(real^M->bool)->bool)") MP_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CARD_LE_INFINITE)) THEN REWRITE_TAC [le_c] THEN
      SUBGOAL_THEN
        (← q r"!x. ?v. x IN c /\ (p:real^M->real^N) x = b ==> v IN vv /\ x IN v")
      MP_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SKOLEM_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^M->real^M->bool") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN CONJ_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"x:real^M") th) THEN
              MP_TAC (← SPEC (← q r"y:real^M") th))) THEN
      ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [INFINITE_CARD_LE, le_c, INJECTIVE_ON_ALT] THEN
    REWRITE_TAC [IN_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:num->real^M->bool") STRIP_ASSUME_TAC) THEN
    UNDISCH_THEN
      (← q r"!u. u IN vv ==> ?q:real^N->real^M. homeomorphism (u,t) (p,q)")
      (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"(v:num->real^M->bool) n")) THEN
    ASM_REWRITE_TAC [SKOLEM_THM, homeomorphism, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->real^N->real^M") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"closed_in (subtopology euclidean s)
                (IMAGE (p:real^M->real^N) (IMAGE (\n. q n (y n:real^N)) (:num)))")
    MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [CLOSED_IN_LIMPT, SUBSET, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"a:real^M")] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LIMPT_OF_SEQUENCE_SUBSEQUENCE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(p:real^M->real^N) a = b") ASSUME_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
        EXISTS_TAC
         (← q r"(p:real^M->real^N) o (\n:num. q n (y n :real^N)) o (r:num->num)") THEN
        REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← GEN_ALL (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          (← EQ_IMP_RULE (← SPEC_ALL CONTINUOUS_ON_SEQUENTIALLY)).1)) THEN
          EXISTS_TAC (← q r"c:real^M->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [COVERING_SPACE_IMP_CONTINUOUS],
            REWRITE_TAC [o_DEF] THEN ASM SET_TAC []],
          REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC LIM_SUBSEQUENCE THEN
          ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ_ALT] LIM_TRANSFORM_EVENTUALLY)) THEN
          MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [o_DEF] THEN
          ASM SET_TAC []],
        SUBGOAL_THEN (← q r"?u. u IN vv /\ (a:real^M) IN u") STRIP_ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?w:real^M->bool. open w /\ u = c INTER w")
