structure PUE where
  COMPONENT_INTERMEDIATE_CLOPEN : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUE [HolBase] (D : PathsDeps) (BS : PTS) (BUD : PUD) : ExceptT String IO PUE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, DIMINDEX_1, DISJ_ASSOC, .. } := D.cvx.core1
  let { FUN_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, .. } := D.cvx.core2
  let { IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS,
        NOT_FORALL_THM, NOT_IMP, .. } := D.cvx.core3
  let { REAL_LE_REFL, .. } := D.cvx.core4
  let { RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, .. } := D.cvx.core5
  let { SWAP_EXISTS_THM, UNION_SUBSET, .. } := D.cvx.core6
  let { DIM_UNIV, .. } := D.cvx.vec1
  let { DROP_ADD, DROP_SUB, ENDS_IN_INTERVAL, LIFT_DROP, .. } := D.cvx.vec2
  let { SUBSPACE_UNIV, .. } := D.cvx.vec3
  let { OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { BOUNDED_SUBSET, CLOSED_INTERVAL, CLOSED_INTER_COMPACT, CLOSED_IN_CLOSED,
        CLOSED_IN_CLOSED_INTER, CLOSED_SUBSET, .. } := D.cvx.top1
  let { COMPACT_IMP_CLOSED, COMPACT_INTERVAL, COMPONENTS_MAXIMAL, .. } := D.cvx.top2
  let { HOMEOMORPHIC_SUBSPACES, .. } := D.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHIC_TRANS, HOMEOMORPHISM_IMP_OPEN_MAP,
        HOMEOMORPHISM_OF_SUBSETS, HOMEOMORPHISM_SYM, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1,
        IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, IN_INTERVAL_1,
        IS_INTERVAL_INTERVAL, .. } := D.cvx.top4
  let { OPEN_INTERVAL, OPEN_IN_OPEN, UNIT_INTERVAL_NONEMPTY, homeomorphic, homeomorphism,
        .. } := D.cvx.top5
  let { UNION_OVER_INTER, .. } := D.pses2
  let { CLOSED_IN_IMP_SUBSET, .. } := D.pmet1
  let { BOUNDED_INTERVAL, BOUNDED_SUBSET_CLOSED_INTERVAL_SYMMETRIC, CBALL_INTERVAL,
        CLOSED_COMPONENTS, CLOSED_IN_COMPONENT, CLOSED_OPEN_INTERVAL_1, .. } := D.ptop1
  let { CONNECTED_UNION, .. } := D.ptop2
  let { EXISTS_COMPONENT_SUPERSET, .. } := D.ptop3
  let { HOMEOMORPHIC_OPEN_INTERVAL_UNIV, HOMEOMORPHISM_COMPONENTS,
        HOMEOMORPHISM_IMP_CLOSED_MAP, HOMEOMORPHISM_OPEN_IN_EQ, IS_INTERVAL_INTER, .. } :=
    D.ptop4
  let { OPEN_IN_CONTAINS_CBALL, SUBSET_INTERVAL_1, UNION_INTERVAL_1, .. } := D.ptop5
  let { CONNECTED_COMPACT_INTERVAL_1, .. } := D.pcvx1
  let { IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { OPEN_IN_COMPONENTS_LOCALLY_CONNECTED, .. } := BS
  let { SURA_BURA_CLOPEN_SUBSET, .. } := BUD
  -- @@SCOPE END

  let COMPONENT_INTERMEDIATE_CLOPEN ← prove
   r"!s t u:real^N->bool.
        t IN components s /\
        open_in (subtopology euclidean s) u /\
        t SUBSET u /\
        (dimindex(:N) = 1 \/ (?r:real^1->bool. s homeomorphic r) \/
         locally connected s \/
         (locally compact s /\ compact t))
        ==> ?c. closed_in (subtopology euclidean s) c /\
                open_in (subtopology euclidean s) c /\
                t SUBSET c /\ c SUBSET u"
   (← do
    let lemma ← prove
     r"!s t u:real^1->bool.
          bounded s /\ t IN components s /\
          open_in (subtopology euclidean s) u /\
          t SUBSET u
          ==> ?c. closed_in (subtopology euclidean s) c /\
                  open_in (subtopology euclidean s) c /\
                  t SUBSET c /\ c SUBSET u"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_COMPONENT) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
      REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?a b:real^1. s INTER interval[a,b] = t")
