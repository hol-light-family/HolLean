  let COMPONENTS_SUBSETS_CLOPEN_PARTITION ← prove
   r"!u s:real^N->bool.
        locally compact s /\
        FINITE u /\ ~(u = {}) /\ u SUBSET components s /\
        (!c. c IN u ==> compact c)
        ==> ?f. (!c. c IN u
                     ==> open_in (subtopology euclidean s) (f c) /\
                         closed_in (subtopology euclidean s) (f c) /\
                         c SUBSET f(c)) /\
                pairwise (\c c'. ~(f(c) = f(c'))) u /\
