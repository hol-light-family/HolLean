structure PUN where
  PATH_CONNECTED_CONVEX_DIFF_CARD_LT : thm
  CONNECTED_CONVEX_DIFF_CARD_LT : thm
  PATH_CONNECTED_CONVEX_DIFF_COUNTABLE : thm
  CONNECTED_CONVEX_DIFF_COUNTABLE : thm
  PATH_CONNECTED_PUNCTURED_CONVEX : thm
  CONNECTED_PUNCTURED_CONVEX : thm
  PATH_CONNECTED_COMPLEMENT_CARD_LT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUN [HolBase] (D : PathsDeps) (BC : PTC) (BI : PTI) (BK : PTK) (BL : PTL)
    (BO : PTO) : ExceptT String IO PUN := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INT_ARITH, MESON, MESON_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, GEOM_BASIS_MULTIPLE_TAC,
        GEOM_NORMALIZE_TAC, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CART_EQ, DIMINDEX_GE_1, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, INT_OF_NUM_LE, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIV, LE_REFL, MEMBER_NOT_EMPTY, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, .. } := D.cvx.core3
  let { REAL_ENTIRE, .. } := D.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_NEG_0, RIGHT_AND_EXISTS_THM, SUBSET, SUBSET_TRANS,
        .. } := D.cvx.core5
  let { real_abs, .. } := D.cvx.core6
  let { HULL_INC, HULL_MINIMAL, .. } := D.cvx.misc
  let { BASIS_COMPONENT, BASIS_NONZERO, .. } := D.cvx.vec1
  let { MIDPOINT_EQ_ENDPOINT, NORM_BASIS, .. } := D.cvx.vec2
  let { NORM_MUL, SPAN_INSERT_0, SPAN_SING, .. } := D.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_NEG_COMPONENT, VECTOR_NEG_EQ_0, VECTOR_SUB_RZERO, VEC_COMPONENT, midpoint, .. } :=
    D.cvx.vec4
  let { IN_SEGMENT, .. } := D.cvx.top4
  let { SEGMENT_REFL, SEGMENT_SYM, .. } := D.cvx.top5
  let { real_INFINITE, .. } := D.pses2
  let { CARD_ADD2_ABSORB_LT, CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LET_TRANS, CARD_LE_RELATIONAL,
        CARD_LE_SUBSET, CARD_LTE_TRANS, CARD_NOT_LE, COUNTABLE_IMP_CARD_LT_REAL,
        COUNTABLE_SING, UNION_LE_ADD_C, .. } := D.pcard
  let { AFFINE_AFFINE_HULL, AFFINE_HULL_2_ALT, AFFINE_HULL_EQ_SPAN, AFF_DIM_EQ_0,
        AFF_DIM_EQ_MINUS1, AFF_DIM_GE, AFF_DIM_UNIV, COLLINEAR_3_AFFINE_HULL,
        COLLINEAR_AFFINE_HULL, COLLINEAR_AFF_DIM, .. } := D.pcvx1
  let { CONVEX_HULL_SUBSET_AFFINE_HULL, CONVEX_UNIV, INTER_SEGMENT, SEGMENT_CONVEX_HULL, .. } :=
    D.pcvx2
  let { PATHSTART_JOIN, PATHFINISH_JOIN, PATH_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH, .. } := BI
  let { path_connected, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_EMPTY, PATH_CONNECTED_SING, .. } := BL
  let { CARD_EQ_SEGMENT, .. } := BO
  -- @@SCOPE END

  let PATH_CONNECTED_CONVEX_DIFF_CARD_LT ← prove
   r"!u s:real^N->bool.
    convex u /\ ~(collinear u) /\ s <_c (:real) ==> path_connected(u DIFF s)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [path_connected, IN_DIFF, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"a:real^N = b") THENL
     [EXISTS_TAC (← q r"linepath(a:real^N,b)") THEN
      REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH] THEN
      ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"m:real^N = midpoint(a,b)") THEN
    SUBGOAL_THEN (← q r"~(m:real^N = a) /\ ~(m = b)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [MIDPOINT_EQ_ENDPOINT], ALL_TAC] THEN
    POP_ASSUM_LIST (MP_TAC o end_itlist CONJ o HolLight.rev) THEN
    GEOM_ORIGIN_TAC (← q r"m:real^N") THEN REPEAT GEN_TAC THEN
    GEOM_NORMALIZE_TAC (← q r"b:real^N") THEN REWRITE_TAC [] THEN GEN_TAC THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:real^N") THEN X_GEN_TAC (← q r"bbb:real") THEN
    DISCH_TAC THEN SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
    ASM_REWRITE_TAC [real_abs, REAL_MUL_RID] THEN
    DISCH_THEN SUBST1_TAC THEN POP_ASSUM (K ALL_TAC : thm → tactic) THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [midpoint, VECTOR_MUL_LID] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"inv(&2) % (a + b):real^N = vec 0 <=> a = --b")] THEN
    ASM_CASES_TAC (← q r"a:real^N = --(basis 1)") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (K ALL_TAC : thm → tactic) THEN
    REPLICATE_TAC 7 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    SUBGOAL_THEN (← q r"segment[--basis 1:real^N,basis 1] SUBSET u") ASSUME_TAC THENL
     [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN u") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_SEGMENT] THEN EXISTS_TAC (← q r"&1 / &2") THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?c:real^N k. 1 <= k /\ ~(k = 1) /\ k <= dimindex(:N) /\
                               c IN u /\ ~(c$k = &0)")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM NOT_FORALL_THM, ← TAUT
       (← q r"a /\ ~b /\ c /\ d /\ ~e <=> ~(d ==> a /\ c ==> ~b ==> e)")] THEN
      DISCH_TAC THEN UNDISCH_TAC (← q r"~collinear(u:real^N->bool)") THEN
      REWRITE_TAC [COLLINEAR_AFFINE_HULL] THEN
      MAP_EVERY EXISTS_TAC [← q r"vec 0:real^N", ← q r"basis 1:real^N"] THEN
      SIMP_TAC [AFFINE_HULL_EQ_SPAN, HULL_INC, IN_INSERT, SPAN_INSERT_0] THEN
      REWRITE_TAC [SPAN_SING, SUBSET, IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"c:real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"(c:real^N)$1") THEN
      SIMP_TAC [CART_EQ, VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [REAL_MUL_RID, REAL_MUL_RZERO] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(c:real^N = vec 0)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [CART_EQ, VEC_COMPONENT] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"segment[vec 0:real^N,c] SUBSET u") ASSUME_TAC THENL
     [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?z:real^N. z IN segment[vec 0,c] /\
                 (segment[--basis 1,z] UNION segment[z,basis 1]) INTER s = {}")
    STRIP_ASSUME_TAC THENL
     [ALL_TAC,
      EXISTS_TAC (← q r"linepath(--basis 1:real^N,z) ++ linepath(z,basis 1)") THEN
      ASM_SIMP_TAC [PATH_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN, PATH_LINEPATH,
                   PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_JOIN] THEN
      REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"(t UNION v) INTER s = {}
        ==> t SUBSET u /\ v SUBSET u
            ==> (t UNION v) SUBSET u DIFF s"))) THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
      CONJ_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN ASM SET_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"~(s SUBSET {z | z IN s /\ ~P z}) ==> ?z. z IN s /\ P z")) THEN
    DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_SUBSET) THEN
    REWRITE_TAC [CARD_NOT_LE, ← SET_RULE
     (← q r"~((b UNION c) INTER s = {}) <=>
      ~(b INTER s = {}) \/ ~(c INTER s = {})")] THEN
    REWRITE_TAC [← SET_RULE
     (← q r"{x | P x /\ (Q x \/ R x)} = {x | P x /\ Q x} UNION {x | P x /\ R x}")] THEN
    W (MP_TAC o PART_MATCH lhand UNION_LE_ADD_C o lhand o snd) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] CARD_LET_TRANS) THEN
    TRANS_TAC CARD_LTE_TRANS (← q r"(:real)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_ADD2_ABSORB_LT THEN REWRITE_TAC [real_INFINITE],
      MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      ASM_SIMP_TAC [CARD_EQ_SEGMENT]] THEN
    REWRITE_TAC [← MESON [SEGMENT_SYM]
      (← q r"segment[--a:real^N,b] = segment[b,--a]")] THEN
    SUBGOAL_THEN
     (← q r"!b:real^N.
         b IN u /\ ~(b IN s) /\ ~(b = vec 0) /\ b$k = &0
         ==> {z | z IN segment[vec 0,c] /\ ~(segment[z,b] INTER s = {})} <_c
             (:real)")
     (fun th => CONJ_TAC THEN MATCH_MP_TAC th THEN
                REWRITE_TAC [VECTOR_NEG_EQ_0, VECTOR_NEG_COMPONENT] THEN
                ASM_SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL,
                             BASIS_COMPONENT] THEN
                REWRITE_TAC [REAL_NEG_0]) THEN
    REPEAT STRIP_TAC THEN TRANS_TAC CARD_LET_TRANS (← q r"s:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, RIGHT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ p /\ q")] THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N", ← q r"x1:real^N", ← q r"x2:real^N"] THEN
    REWRITE_TAC [SEGMENT_SYM] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x2:real^N = x1") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL
     [← q r"x1:real^N", ← q r"b:real^N", ← q r"x2:real^N"] INTER_SEGMENT) THEN
    REWRITE_TAC [NOT_IMP, SEGMENT_SYM] THEN
    CONJ_TAC THENL [DISJ2_TAC, REWRITE_TAC [SEGMENT_SYM] THEN ASM SET_TAC []] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"{x1,b,x2} = {x1,x2,b}")] THEN
    ASM_SIMP_TAC [COLLINEAR_3_AFFINE_HULL] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(b:real^N) IN affine hull {vec 0,c}") MP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"b IN s ==> s SUBSET t ==> b IN t"))) THEN
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [AFFINE_AFFINE_HULL] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"segment[c:real^N,vec 0]") THEN
      CONJ_TAC THENL [ASM SET_TAC [], ONCE_REWRITE_TAC [SEGMENT_SYM]] THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_SUBSET_AFFINE_HULL],
      REWRITE_TAC [AFFINE_HULL_2_ALT, IN_ELIM_THM, IN_UNIV] THEN
      REWRITE_TAC [VECTOR_ADD_LID, VECTOR_SUB_RZERO, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"r:real") THEN
      ASM_CASES_TAC (← q r"r = &0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN
      CONV_TAC (RAND_CONV SYM_CONV) THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"\x:real^N. x$k")) THEN
      ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, REAL_ENTIRE]])

  let CONNECTED_CONVEX_DIFF_CARD_LT ← prove
   r"!u s. convex u /\ ~collinear u /\ s <_c (:real) ==> connected(u DIFF s)"
   (SIMP_TAC [PATH_CONNECTED_CONVEX_DIFF_CARD_LT, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_CONVEX_DIFF_COUNTABLE ← prove
   r"!u s. convex u /\ ~collinear u /\ COUNTABLE s ==> path_connected(u DIFF s)"
   (MESON_TAC [COUNTABLE_IMP_CARD_LT_REAL, PATH_CONNECTED_CONVEX_DIFF_CARD_LT])

  let CONNECTED_CONVEX_DIFF_COUNTABLE ← prove
   r"!u s. convex u /\ ~collinear u /\ COUNTABLE s ==> connected(u DIFF s)"
   (MESON_TAC [COUNTABLE_IMP_CARD_LT_REAL, CONNECTED_CONVEX_DIFF_CARD_LT])

  let PATH_CONNECTED_PUNCTURED_CONVEX ← prove
   r"!s a:real^N. convex s /\ ~(aff_dim s = &1) ==> path_connected(s DELETE a)"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP (← INT_ARITH
     (← q r"~(x:int = &1) ==> --(&1) <= x ==> x = -- &1 \/ x = &0 \/ &2 <= x"))) THEN
    ASM_REWRITE_TAC [AFF_DIM_GE, AFF_DIM_EQ_MINUS1, AFF_DIM_EQ_0] THEN
    DISCH_THEN (REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC) THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_EMPTY, ← SET_RULE (← q r"{} DELETE a = {}")] THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"b:real^N") SUBST1_TAC) THEN
      ASM_CASES_TAC (← q r"b:real^N = a") THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_EMPTY, ← SET_RULE (← q r"{a} DELETE a = {}")] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"~(b = a) ==> {a} DELETE b = {a}")] THEN
      REWRITE_TAC [PATH_CONNECTED_SING],
      REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
      MATCH_MP_TAC PATH_CONNECTED_CONVEX_DIFF_COUNTABLE THEN
      ASM_REWRITE_TAC [COUNTABLE_SING, COLLINEAR_AFF_DIM] THEN
      ASM_INT_ARITH_TAC])

  let CONNECTED_PUNCTURED_CONVEX ← prove
   r"!s a:real^N. convex s /\ ~(aff_dim s = &1) ==> connected(s DELETE a)"
   (SIMP_TAC [PATH_CONNECTED_PUNCTURED_CONVEX, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_COMPLEMENT_CARD_LT ← prove
   r"!s. 2 <= dimindex(:N) /\ s <_c (:real)
       ==> path_connected((:real^N) DIFF s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_CONVEX_DIFF_CARD_LT THEN
    ASM_REWRITE_TAC [CONVEX_UNIV, COLLINEAR_AFF_DIM, AFF_DIM_UNIV] THEN
    REWRITE_TAC [INT_OF_NUM_LE] THEN ASM_ARITH_TAC)

  return { PATH_CONNECTED_CONVEX_DIFF_CARD_LT, CONNECTED_CONVEX_DIFF_CARD_LT,
           PATH_CONNECTED_CONVEX_DIFF_COUNTABLE, CONNECTED_CONVEX_DIFF_COUNTABLE,
           PATH_CONNECTED_PUNCTURED_CONVEX, CONNECTED_PUNCTURED_CONVEX,
           PATH_CONNECTED_COMPLEMENT_CARD_LT }

/- ------------------------------------------------------------------------- -/
/- Simple positive connection theorems (continued): open sets minus small    -/
/- sets, punctured balls, spheres.  (paths.ml 12601-12860)                   -/
/- ------------------------------------------------------------------------- -/

structure PUO where
  PATH_CONNECTED_CONNECTED_DIFF : thm
  PATH_CONNECTED_OPEN_IN_DIFF_CARD_LT : thm
  CONNECTED_OPEN_IN_DIFF_CARD_LT : thm
  PATH_CONNECTED_OPEN_DIFF_CARD_LT : thm
  CONNECTED_OPEN_DIFF_CARD_LT : thm
  PATH_CONNECTED_OPEN_DIFF_COUNTABLE : thm
  CONNECTED_OPEN_DIFF_COUNTABLE : thm
  PATH_CONNECTED_OPEN_DELETE : thm
  CONNECTED_OPEN_DELETE : thm
  PATH_CONNECTED_PUNCTURED_UNIVERSE : thm
  CONNECTED_PUNCTURED_UNIVERSE : thm
  PATH_CONNECTED_PUNCTURED_BALL : thm
  CONNECTED_PUNCTURED_BALL : thm
  PATH_CONNECTED_PUNCTURED_CBALL : thm
  CONNECTED_PUNCTURED_CBALL : thm
  PATH_CONNECTED_SPHERE : thm
  CONNECTED_SPHERE : thm
  CONNECTED_SPHERE_EQ : thm
  PATH_CONNECTED_SPHERE_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUO [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BO : PTO) (BUN : PUN) :
    ExceptT String IO PUO := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, MESON,
        MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, NORM_ARITH,
        GEOM_EQUAL_DIMENSION_RULE, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DIMINDEX_1, DIMINDEX_GE_1, EMPTY_DIFF, EMPTY_GSPEC, ETA_AX, EXTENSION,
        .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, INTER_COMM, INT_OF_NUM_EQ, INT_OF_NUM_LE, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_SING, IN_UNIV, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_IN_EMPTY,
        REAL_ABS_DIV, REAL_DIV_REFL, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN, .. } := D.cvx.core4
  let { REAL_NOT_LT, SUBSET, SUBSET_ANTISYM, .. } := D.cvx.core5
  let { o_DEF, real_div, .. } := D.cvx.core6
  let { HULL_INC, HULL_SUBSET, .. } := D.cvx.misc
  let { COLLINEAR_SING, DIST_SYM, .. } := D.cvx.vec1
  let { DROP_EQ, DROP_VEC, LIFT_CMUL, LIFT_DROP, NORM_0, NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_MUL, NORM_SUB, REAL_ABS_NORM, .. } := D.cvx.vec3
  let { VECTOR_MUL_LID, VECTOR_SUB_RZERO, dist, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.cvx.met
  let { BALL_MIN_INTER, CBALL_EMPTY, CBALL_SING, CENTRE_IN_BALL, CLOSURE_APPROACHABLE, .. } :=
    D.cvx.top1
  let { CONNECTED_IMP_PERFECT, CONTINUOUS_AT_LIFT_NORM, .. } := D.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_ID, CONTINUOUS_ON_MUL, .. } :=
    D.cvx.top3
  let { IN_BALL, IN_SPHERE, LIMPT_APPROACHABLE, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_IN, OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN, OPEN_UNIV, SPHERE_EMPTY, .. } :=
    D.cvx.top5
  let { SING_GSPEC, .. } := D.pses2
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_COUNTABLE, CARD_LE_SUBSET, CARD_LTE_TRANS,
        CARD_NOT_LE, COUNTABLE_SING, UNCOUNTABLE_REAL, .. } := D.pcard
  let { CLOSURE_NONEMPTY_OPEN_INTER, .. } := D.ptop1
  let { CONNECTED_EMPTY, CONNECTED_EQUIVALENCE_RELATION_GEN, CONNECTED_SING, CONNECTED_UNIV,
        CONTINUOUS_AT_WITHIN, CONTINUOUS_AT_WITHIN_INV, CONTINUOUS_CMUL, .. } := D.ptop2
  let { FINITE_SPHERE_1, .. } := D.ptop3
  let { SPHERE_1, SPHERE_SING, sphere, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_HULL_OPEN, AFFINE_IMP_CONVEX, AFF_DIM_AFFINE_HULL,
        AFF_DIM_CBALL, AFF_DIM_CONVEX_INTER_OPEN, AFF_DIM_OPEN, COLLINEAR_AFF_DIM,
        CONNECTED_BALL, CONVEX_BALL, CONVEX_CBALL, .. } := D.pcvx1
  let { CONVEX_INTER, .. } := D.pcvx2
  let { PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS, PATH_CONNECTED_IFF_PATH_COMPONENT,
        PATH_COMPONENT_MONO, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_CONTINUOUS_IMAGE, PATH_CONNECTED_EMPTY,
        PATH_CONNECTED_SING, .. } := BL
  let { CARD_EQ_CONVEX, CONNECTED_FINITE_IFF_SING, .. } := BO
  let { PATH_CONNECTED_CONVEX_DIFF_CARD_LT, PATH_CONNECTED_PUNCTURED_CONVEX, .. } := BUN
  -- @@SCOPE END

  let PATH_CONNECTED_CONNECTED_DIFF ← prove
   r"!s t:real^N->bool.
        connected s /\ s SUBSET closure(s DIFF t) /\
        (!x. x IN s
             ==> ?u. x IN u /\ open_in (subtopology euclidean s) u /\
                     path_connected(u DIFF t))
        ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT, IN_DIFF] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ (r /\ s) <=> p /\ r /\ q /\ s")] THEN
    MATCH_MP_TAC CONNECTED_EQUIVALENCE_RELATION_GEN THEN
    ASM_REWRITE_TAC [PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS] THEN CONJ_TAC THENL
     [REWRITE_TAC [OPEN_IN_OPEN, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"x:real^N", ← q r"u:real^N->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_REWRITE_TAC [CLOSURE_NONEMPTY_OPEN_INTER] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:real^N->bool")) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:real^N->bool") THEN
      ONCE_REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      MATCH_MP_TAC MONO_IMP THEN SIMP_TAC [] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"P SUBSET Q ==> P x ==> Q x")) THEN REWRITE_TAC [ETA_AX] THEN
      MATCH_MP_TAC PATH_COMPONENT_MONO THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN SET_TAC []])

  let PATH_CONNECTED_OPEN_IN_DIFF_CARD_LT ← prove
   r"!s t:real^N->bool.
        connected s /\ open_in (subtopology euclidean (affine hull s)) s /\
        ~collinear s /\ t <_c (:real)
        ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_CONNECTED_DIFF THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, CLOSURE_APPROACHABLE, IN_DIFF] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o
         REWRITE_RULE [OPEN_IN_CONTAINS_BALL]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"~((ball(x:real^N,min d e) INTER affine hull s) DIFF t = {})")
      MP_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"s DIFF t = {} <=> s SUBSET t")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_SUBSET) THEN
        REWRITE_TAC [CARD_NOT_LE] THEN
        TRANS_TAC CARD_LTE_TRANS (← q r"(:real)") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [CARD_EQ_SYM] CARD_EQ_IMP_LE) THEN
        MATCH_MP_TAC CARD_EQ_CONVEX THEN
        ASM_SIMP_TAC [CONVEX_BALL, CONVEX_INTER, AFFINE_IMP_CONVEX,
                     AFFINE_AFFINE_HULL] THEN
        EXISTS_TAC (← q r"x:real^N") THEN
        ASM_SIMP_TAC [CENTRE_IN_BALL, REAL_LT_MIN, IN_INTER, HULL_INC] THEN
        MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
          CONNECTED_IMP_PERFECT) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [COLLINEAR_SING], ALL_TAC] THEN
        REWRITE_TAC [LIMPT_APPROACHABLE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"min d e:real")) THEN
        ASM_REWRITE_TAC [REAL_LT_MIN, IN_BALL] THEN
        ASM_MESON_TAC [HULL_INC, DIST_SYM],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, BALL_MIN_INTER, IN_DIFF,
                    IN_BALL, REAL_LT_MIN] THEN MESON_TAC [DIST_SYM]],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o
         REWRITE_RULE [OPEN_IN_CONTAINS_BALL]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"ball(x:real^N,r) INTER affine hull s") THEN
      ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL, HULL_INC] THEN CONJ_TAC THENL
       [REWRITE_TAC [OPEN_IN_OPEN] THEN EXISTS_TAC (← q r"ball(x:real^N,r)") THEN
        REWRITE_TAC [OPEN_BALL] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← SET_RULE (← q r"b INTER t SUBSET s
                    ==> s SUBSET t ==> b INTER t = s INTER b"))) THEN
        REWRITE_TAC [HULL_SUBSET],
        MATCH_MP_TAC PATH_CONNECTED_CONVEX_DIFF_CARD_LT THEN
        ASM_SIMP_TAC [CONVEX_INTER, AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL,
                     CONVEX_BALL, COLLINEAR_AFF_DIM] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [COLLINEAR_AFF_DIM]) THEN
        MATCH_MP_TAC (← INT_ARITH (← q r"x:int = y ==> ~(y <= &1) ==> ~(x <= &1)")) THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM AFF_DIM_AFFINE_HULL] THEN
        ONCE_REWRITE_TAC [INTER_COMM] THEN
        MATCH_MP_TAC AFF_DIM_CONVEX_INTER_OPEN THEN
        ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL, OPEN_BALL] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        ASM_MESON_TAC [HULL_INC, CENTRE_IN_BALL]]])

  let CONNECTED_OPEN_IN_DIFF_CARD_LT ← prove
   r"!s t:real^N->bool.
        connected s /\ open_in (subtopology euclidean (affine hull s)) s /\
        ~collinear s /\ t <_c (:real)
        ==> connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_IMP_CONNECTED THEN
    MATCH_MP_TAC PATH_CONNECTED_OPEN_IN_DIFF_CARD_LT THEN
    ASM_REWRITE_TAC [])

  let PATH_CONNECTED_OPEN_DIFF_CARD_LT ← prove
   r"!s t:real^N->bool.
        2 <= dimindex(:N) /\ open s /\ connected s /\ t <_c (:real)
        ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_REWRITE_TAC [EMPTY_DIFF, PATH_CONNECTED_EMPTY] THEN
    MATCH_MP_TAC PATH_CONNECTED_OPEN_IN_DIFF_CARD_LT THEN
    ASM_REWRITE_TAC [COLLINEAR_AFF_DIM] THEN
    ASM_SIMP_TAC [AFFINE_HULL_OPEN, AFF_DIM_OPEN] THEN
    ASM_REWRITE_TAC [INT_OF_NUM_LE, SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN] THEN
    ASM_ARITH_TAC)

  let CONNECTED_OPEN_DIFF_CARD_LT ← prove
   r"!s t:real^N->bool.
        2 <= dimindex(:N) /\ open s /\ connected s /\ t <_c (:real)
        ==> connected(s DIFF t)"
   (SIMP_TAC [PATH_CONNECTED_OPEN_DIFF_CARD_LT, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_OPEN_DIFF_COUNTABLE ← prove
   r"!s t:real^N->bool.
        2 <= dimindex(:N) /\ open s /\ connected s /\ COUNTABLE t
        ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_OPEN_DIFF_CARD_LT THEN
    ASM_REWRITE_TAC [← GSYM CARD_NOT_LE] THEN
    ASM_MESON_TAC [UNCOUNTABLE_REAL, CARD_LE_COUNTABLE])

  let CONNECTED_OPEN_DIFF_COUNTABLE ← prove
   r"!s t:real^N->bool.
        2 <= dimindex(:N) /\ open s /\ connected s /\ COUNTABLE t
        ==> connected(s DIFF t)"
   (SIMP_TAC [PATH_CONNECTED_OPEN_DIFF_COUNTABLE, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_OPEN_DELETE ← prove
   r"!s a:real^N. 2 <= dimindex(:N) /\ open s /\ connected s
                ==> path_connected(s DELETE a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
    MATCH_MP_TAC PATH_CONNECTED_OPEN_DIFF_COUNTABLE THEN
    ASM_REWRITE_TAC [COUNTABLE_SING])

  let CONNECTED_OPEN_DELETE ← prove
   r"!s a:real^N. 2 <= dimindex(:N) /\ open s /\ connected s
                ==> connected(s DELETE a)"
   (SIMP_TAC [PATH_CONNECTED_OPEN_DELETE, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_PUNCTURED_UNIVERSE ← prove
   r"!a. 2 <= dimindex(:N) ==> path_connected((:real^N) DIFF {a})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_OPEN_DIFF_COUNTABLE THEN
    ASM_REWRITE_TAC [OPEN_UNIV, CONNECTED_UNIV, COUNTABLE_SING])

  let CONNECTED_PUNCTURED_UNIVERSE ← prove
   r"!a. 2 <= dimindex(:N) ==> connected((:real^N) DIFF {a})"
   (SIMP_TAC [PATH_CONNECTED_PUNCTURED_UNIVERSE, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_PUNCTURED_BALL ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> path_connected(ball(a,r) DELETE a)"
   (SIMP_TAC [PATH_CONNECTED_OPEN_DELETE, OPEN_BALL, CONNECTED_BALL])

  let CONNECTED_PUNCTURED_BALL ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> connected(ball(a,r) DELETE a)"
   (SIMP_TAC [CONNECTED_OPEN_DELETE, OPEN_BALL, CONNECTED_BALL])

  let PATH_CONNECTED_PUNCTURED_CBALL ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> path_connected(cball(a,r) DELETE a)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"&0 < r") THENL
     [MATCH_MP_TAC PATH_CONNECTED_PUNCTURED_CONVEX THEN
      ASM_REWRITE_TAC [CONVEX_CBALL, AFF_DIM_CBALL, INT_OF_NUM_EQ] THEN
      ASM_ARITH_TAC,
      MATCH_MP_TAC (← MESON [PATH_CONNECTED_EMPTY]
       (← q r"s = {} ==> path_connected s")) THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(&0 < r) ==> r = &0 \/ r < &0"))) THEN
      ASM_SIMP_TAC [CBALL_EMPTY, CBALL_SING] THEN ASM SET_TAC []])

  let CONNECTED_PUNCTURED_CBALL ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> connected(cball(a,r) DELETE a)"
   (SIMP_TAC [PATH_CONNECTED_PUNCTURED_CBALL, PATH_CONNECTED_IMP_CONNECTED])

  let PATH_CONNECTED_SPHERE ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> path_connected(sphere(a,r))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [sphere, dist] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN GEN_TAC THEN
    REWRITE_TAC [VECTOR_SUB_RZERO] THEN DISCH_TAC THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← REAL_ARITH (← q r"r < &0 \/ r = &0 \/ &0 < r"))
    THENL
     [ASM_SIMP_TAC [← NORM_ARITH (← q r"r < &0 ==> ~(norm(x:real^N) = r)")] THEN
      REWRITE_TAC [EMPTY_GSPEC, PATH_CONNECTED_EMPTY],
      ASM_REWRITE_TAC [NORM_EQ_0, SING_GSPEC, PATH_CONNECTED_SING],
      SUBGOAL_THEN
       (← q r"{x:real^N | norm x = r} =
        IMAGE (\x. r / norm x % x) ((:real^N) DIFF {vec 0})")
      SUBST1_TAC THENL
       [MATCH_MP_TAC SUBSET_ANTISYM THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [IN_IMAGE, IN_ELIM_THM, IN_DIFF, IN_SING, IN_UNIV] THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL,
                     NORM_EQ_0, ← REAL_ARITH (← q r"&0 < r ==> abs r = r")] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:real^N") THEN
        ASM_SIMP_TAC [REAL_DIV_REFL, REAL_LT_IMP_NZ, VECTOR_MUL_LID] THEN
        ASM_MESON_TAC [NORM_0, REAL_LT_IMP_NZ],
        MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [PATH_CONNECTED_PUNCTURED_UNIVERSE] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [o_DEF, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_DIFF, IN_UNIV, IN_SING] THEN
      DISCH_TAC THEN REWRITE_TAC [real_div, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_CMUL THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_AT_WITHIN_INV) THEN
      ASM_REWRITE_TAC [NORM_EQ_0] THEN MATCH_MP_TAC CONTINUOUS_AT_WITHIN THEN
      REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_AT_LIFT_NORM]]])

  let CONNECTED_SPHERE ← prove
   r"!a:real^N r. 2 <= dimindex(:N) ==> connected(sphere(a,r))"
   (SIMP_TAC [PATH_CONNECTED_SPHERE, PATH_CONNECTED_IMP_CONNECTED])

  let CONNECTED_SPHERE_EQ ← prove
   r"!a:real^N r. connected(sphere(a,r)) <=> 2 <= dimindex(:N) \/ r <= &0"
   (← do
    let lemma ← prove
     r"!a:real^1 r. &0 < r
           ==> ?x y. ~(x = y) /\ dist(a,x) = r /\ dist(a,y) = r"
     (MP_TAC SPHERE_1 THEN REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      COND_CASES_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [EXTENSION, IN_SPHERE, IN_INSERT, NOT_IN_EMPTY] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON []
      (← q r"~(a = b) ==> ?x y. ~(x = y) /\ (x = a \/ x = b) /\ (y = a \/ y = b)")) THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a - r:real^1 = a + r <=> r = vec 0")] THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN ASM_REAL_ARITH_TAC)
    pure (
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, CONNECTED_EMPTY, REAL_LT_IMP_LE] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_SIMP_TAC [SPHERE_SING, REAL_LE_REFL, CONNECTED_SING] THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ASM_REWRITE_TAC [← GSYM REAL_NOT_LT]] THEN
    EQ_TAC THEN SIMP_TAC [CONNECTED_SPHERE] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_FINITE_IFF_SING) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    SIMP_TAC [DIMINDEX_GE_1, ← ARITH_RULE (← q r"1 <= n ==> (2 <= n <=> ~(n = 1))")] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM DIMINDEX_1] THEN
    DISCH_TAC THEN FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GEOM_EQUAL_DIMENSION_RULE th FINITE_SPHERE_1])) THEN
    REWRITE_TAC [← SET_RULE
     (← q r"~(s = {} \/ ?a. s = {a}) <=> ?x y. ~(x = y) /\ x IN s /\ y IN s")] THEN
    REWRITE_TAC [IN_SPHERE] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o C GEOM_EQUAL_DIMENSION_RULE lemma) THEN
    ASM_REWRITE_TAC []))

  let PATH_CONNECTED_SPHERE_EQ ← prove
   r"!a:real^N r. path_connected(sphere(a,r)) <=> 2 <= dimindex(:N) \/ r <= &0"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [← GSYM CONNECTED_SPHERE_EQ, PATH_CONNECTED_IMP_CONNECTED],
      STRIP_TAC THEN ASM_SIMP_TAC [PATH_CONNECTED_SPHERE]] THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [SPHERE_EMPTY, PATH_CONNECTED_EMPTY] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_SIMP_TAC [SPHERE_SING, PATH_CONNECTED_SING] THEN
    ASM_REAL_ARITH_TAC)

  return { PATH_CONNECTED_CONNECTED_DIFF, PATH_CONNECTED_OPEN_IN_DIFF_CARD_LT,
           CONNECTED_OPEN_IN_DIFF_CARD_LT, PATH_CONNECTED_OPEN_DIFF_CARD_LT,
           CONNECTED_OPEN_DIFF_CARD_LT, PATH_CONNECTED_OPEN_DIFF_COUNTABLE,
           CONNECTED_OPEN_DIFF_COUNTABLE, PATH_CONNECTED_OPEN_DELETE, CONNECTED_OPEN_DELETE,
           PATH_CONNECTED_PUNCTURED_UNIVERSE, CONNECTED_PUNCTURED_UNIVERSE,
           PATH_CONNECTED_PUNCTURED_BALL, CONNECTED_PUNCTURED_BALL,
           PATH_CONNECTED_PUNCTURED_CBALL, CONNECTED_PUNCTURED_CBALL, PATH_CONNECTED_SPHERE,
           CONNECTED_SPHERE, CONNECTED_SPHERE_EQ, PATH_CONNECTED_SPHERE_EQ }

/- ------------------------------------------------------------------------- -/
/- Finiteness, size and local connectedness of spheres; sphere               -/
/- intersections.  (paths.ml 12861-13160)                                    -/
/- ------------------------------------------------------------------------- -/

structure PUP where
  FINITE_SPHERE : thm
  LIMIT_POINT_OF_SPHERE : thm
  CARD_EQ_SPHERE : thm
  HAS_SIZE_SPHERE_2 : thm
  LOCALLY_PATH_CONNECTED_SPHERE : thm
  LOCALLY_CONNECTED_SPHERE : thm
  FINITE_CIRCLE_INTERSECTION : thm
  CARD_CIRCLE_INTERSECTION_LE : thm
  INTER_SPHERE_EQ_EMPTY : thm
  HAS_SIZE_INTER_SPHERE_1 : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUP [HolBase] (D : PathsDeps) (BO : PTO) (BS : PTS) (BUO : PUO) :
    ExceptT String IO PUP := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RING, SET_RULE, SET_TAC, HAS_SIZE_CONV, NUM_REDUCE_CONV,
        VECTOR_ARITH, NORM_ARITH, GEOM_BASIS_MULTIPLE_TAC, GEOM_EQUAL_DIMENSION_RULE,
        GEOM_ORIGIN_TAC, .. } := D.cvx
  let { AND_FORALL_THM, ARITH, ARITH_EQ, CARD_CLAUSES, CARD_SING, CARD_SUBSET, CART_EQ,
        CHOOSE_SUBSET_STRONG, CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_1, DIMINDEX_2,
        DIMINDEX_GE_1, EMPTY_SUBSET, EXTENSION, FINITE_EMPTY, FINITE_INSERT, FINITE_SING,
        FINITE_SUBSET, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, IMP_CONJ_ALT, INSERT_SUBSET, INTER_IDEMPOT, IN_DELETE, .. } :=
    D.cvx.core2
  let { IN_INSERT, IN_INTER, IN_NUMSEG, IN_SING, IN_UNIV, LAMBDA_BETA, LEFT_IMP_EXISTS_THM,
        LE_1, LE_REFL, LE_TRANS, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_ABS_DIV, REAL_ABS_POS,
        REAL_DIV_REFL, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_EQ_SQUARE_ABS, REAL_LE_ADD, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_REFL, .. } :=
    D.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_NOT_LE, REAL_NOT_LT, REAL_POS, REAL_POW_2, SUBSET,
        .. } := D.cvx.core5
  let { o_DEF, real_abs, real_div, .. } := D.cvx.core6
  let { BASIS_COMPONENT, BASIS_NONZERO, COLLINEAR_BETWEEN_CASES, COLLINEAR_LEMMA_ALT, DIST_0,
        DIST_EQ_0, DIST_SYM, DOT_2, .. } := D.cvx.vec1
  let { FORALL_1, LIFT_CMUL, NORM_BASIS, NORM_EQ_0, NORM_EQ_SQUARE, .. } := D.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, .. } := D.cvx.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_EQ_0,
        VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_COMPONENT, VECTOR_SUB_RDISTRIB,
        VEC_COMPONENT, dist, dot, .. } := D.cvx.vec4
  let { CONNECTED_IMP_PERFECT, CONNECTED_INTER_FRONTIER, .. } := D.cvx.top2
  let { CONTINUOUS_ON_ID, CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM, CONTINUOUS_ON_MUL,
        FRONTIER_CBALL, .. } := D.cvx.top3
  let { IN_SPHERE, IN_SPHERE_0, LIMIT_POINT_FINITE, .. } := D.cvx.top4
  let { OPEN_IN, OPEN_UNIV, SPHERE_EMPTY, TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        .. } := D.cvx.top5
  let { POW_2_SQRT_ABS, REAL_ABS_ABS, .. } := D.pses2
  let { BASIS_EQ_0, NORM_EQ_COMPONENTWISE, SUM_1, VECTOR_CHOOSE_DIST, between, vector_norm,
        .. } := D.pvec
  let { LOCALLY_PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY, LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET,
        LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, RETRACTION_IMP_QUOTIENT_MAP,
        SUBTOPOLOGY_TOPSPACE, retraction_map, retraction_maps, .. } := D.pmet2
  let { CLOSED_LIMPT, CLOSED_SPHERE, .. } := D.ptop1
  let { CONNECTED_CARD_EQ_IFF_NONTRIVIAL, CONTINUOUS_MAP_EUCLIDEAN2, CONTINUOUS_ON_CMUL, .. } :=
    D.ptop2
  let { FINITE_SPHERE_1, HAS_SIZE_SPHERE_1, .. } := D.ptop3
  let { INTER_BALLS_EQ_EMPTY, .. } := D.ptop4
  let { OPEN_DELETE, SPHERE_SING, SPHERE_UNION_BALL, SUBSET_BALLS,
        SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE, .. } := D.ptop5
  let { CONNECTED_CBALL, CONVEX_BALL, .. } := D.pcvx1
  let { SPHERE_SUBSET_CONVEX, .. } := D.pcvx2
  let { CONNECTED_FINITE_IFF_SING, .. } := BO
  let { LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
        LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, LOCALLY_PATH_CONNECTED_UNIV, .. } := BS
  let { CONNECTED_SPHERE, CONNECTED_SPHERE_EQ, .. } := BUO
  -- @@SCOPE END

  let FINITE_SPHERE ← prove
   r"!a:real^N r. FINITE(sphere(a,r)) <=> r <= &0 \/ dimindex(:N) = 1"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"dimindex(:N) = 1") THEN
    ASM_REWRITE_TAC [] THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DIMINDEX_1]) THEN
      FIRST_ASSUM (MATCH_ACCEPT_TAC o C PROVE_HYP
        (← GEOM_EQUAL_DIMENSION_RULE (← ASSUME (← q r"dimindex(:N) = dimindex(:1)"))
        FINITE_SPHERE_1)),
      ASM_SIMP_TAC [CONNECTED_SPHERE, ← ARITH_RULE (← q r"2 <= n <=> 1 <= n /\ ~(n = 1)"),
                   DIMINDEX_GE_1, CONNECTED_FINITE_IFF_SING] THEN
      REWRITE_TAC [← SET_RULE (← q r"(s = {} \/ ?a. s = {a}) <=>
                            (!a b. a IN s /\ b IN s ==> a = b)")] THEN
      SIMP_TAC [IN_SPHERE] THEN EQ_TAC THENL
       [ALL_TAC, CONV_TAC (fun t => NORM_ARITH t)] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] VECTOR_CHOOSE_DIST) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"a - (x - a):real^N"]) THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o check (HolCore.Basics.is_neg o concl)) THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => NORM_ARITH t)])

  let LIMIT_POINT_OF_SPHERE ← prove
   r"!a r x:real^N. x limit_point_of sphere(a,r) <=>
                  &0 < r /\ 2 <= dimindex(:N) /\ x IN sphere(a,r)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"FINITE(sphere(a:real^N,r))") THENL
     [ASM_SIMP_TAC [LIMIT_POINT_FINITE], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o REWRITE_RULE [FINITE_SPHERE]) THEN
    REWRITE_TAC [DE_MORGAN_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [REAL_NOT_LE, ARITH, REAL_NOT_LT] THEN
    ASM_SIMP_TAC [← GSYM REAL_NOT_LE, DIMINDEX_GE_1,
                 ← ARITH_RULE (← q r"1 <= n ==> (2 <= n <=> ~(n = 1))")] THEN
    EQ_TAC THEN REWRITE_TAC [← REWRITE_RULE [CLOSED_LIMPT] CLOSED_SPHERE] THEN
    DISCH_TAC THEN MATCH_MP_TAC CONNECTED_IMP_PERFECT THEN
    ASM_SIMP_TAC [CONNECTED_SPHERE_EQ, DIMINDEX_GE_1,
                 ← ARITH_RULE (← q r"1 <= n ==> (2 <= n <=> ~(n = 1))")] THEN
    ASM_MESON_TAC [FINITE_SING])

  let CARD_EQ_SPHERE ← prove
   r"!a:real^N r. 2 <= dimindex(:N) /\ &0 < r ==> sphere(a,r) =_c (:real)"
   (SIMP_TAC [CONNECTED_CARD_EQ_IFF_NONTRIVIAL, CONNECTED_SPHERE] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET)) THEN
    ASM_REWRITE_TAC [FINITE_SING, FINITE_SPHERE, REAL_NOT_LE, DE_MORGAN_THM] THEN
    ASM_ARITH_TAC)

  let HAS_SIZE_SPHERE_2 ← prove
   r"!a:real^N r. sphere(a,r) HAS_SIZE 2 <=> dimindex(:N) = 1 /\ &0 < r"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [HAS_SIZE, SPHERE_EMPTY, CARD_CLAUSES] THENL
     [CONV_TAC NUM_REDUCE_CONV THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r = &0") THEN
    ASM_SIMP_TAC [SPHERE_SING, CARD_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY] THEN
    REWRITE_TAC [REAL_LT_REFL] THEN CONV_TAC NUM_REDUCE_CONV THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_CASES_TAC (← q r"r <= &0") THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [FINITE_SPHERE] THEN
    ASM_CASES_TAC (← q r"dimindex(:N) = 1") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"sphere(a:real^N,r) = {a - r % basis 1,a + r % basis 1}")
    SUBST1_TAC THENL
     [ASM_REWRITE_TAC [EXTENSION, IN_SPHERE, dist, vector_norm, dot] THEN
      REWRITE_TAC [SUM_1, ← GSYM REAL_POW_2, POW_2_SQRT_ABS] THEN
      ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, CART_EQ, FORALL_1] THEN
      REWRITE_TAC [VECTOR_SUB_COMPONENT, VECTOR_ADD_COMPONENT,
                  VECTOR_MUL_COMPONENT] THEN
      SIMP_TAC [BASIS_COMPONENT, LE_REFL, DIMINDEX_GE_1] THEN
      ASM_REAL_ARITH_TAC,
      SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, NOT_IN_EMPTY] THEN
      SIMP_TAC [IN_SING, ← VECTOR_ARITH (← q r"a - r:real^N = a + r <=> r = vec 0")] THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, BASIS_NONZERO, LE_REFL, DIMINDEX_GE_1] THEN
      CONV_TAC NUM_REDUCE_CONV])

  let LOCALLY_PATH_CONNECTED_SPHERE ← prove
   r"!(a:real^N) r. locally path_connected (sphere(a:real^N,r))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN GEN_TAC THEN
    REWRITE_TAC [← GSYM LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    ASM_CASES_TAC (← q r"FINITE(sphere(vec 0:real^N,r))") THEN
    ASM_SIMP_TAC [SUBTOPOLOGY_EUCLIDEAN_EQ_DISCRETE_TOPOLOGY_FINITE,
                 LOCALLY_PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FINITE_SPHERE]) THEN
    REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LE] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC
     (← q r"subtopology euclidean ((:real^N) DELETE vec 0)")
     LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE) THEN
    EXISTS_TAC (← q r"\x:real^N. r / norm(x) % x") THEN CONJ_TAC THENL
     [MATCH_MP_TAC RETRACTION_IMP_QUOTIENT_MAP THEN
      REWRITE_TAC [retraction_map, retraction_maps] THEN
      EXISTS_TAC (← q r"\x:real^N. x") THEN
      REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN2] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_DELETE, IN_SPHERE_0] THEN
      REWRITE_TAC [IN_UNIV, NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [← GSYM NORM_EQ_0, REAL_DIV_RMUL, REAL_DIV_REFL,
                   REAL_LT_IMP_NZ, VECTOR_MUL_LID,
                   ← REAL_ARITH (← q r"&0 < r ==> abs r = r")] THEN
      MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
      REWRITE_TAC [CONTINUOUS_ON_ID, o_DEF, real_div, LIFT_CMUL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
      REWRITE_TAC [NORM_EQ_0, IN_DELETE, IN_UNIV] THEN
      REWRITE_TAC [← REWRITE_RULE [o_DEF] CONTINUOUS_ON_LIFT_NORM],
      MATCH_MP_TAC LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET THEN
      SIMP_TAC [← GSYM OPEN_IN, OPEN_DELETE, OPEN_UNIV] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
      REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEAN, LOCALLY_PATH_CONNECTED_UNIV]])

  let LOCALLY_CONNECTED_SPHERE ← prove
   r"!a:real^N r. locally connected(sphere(a,r))"
   (SIMP_TAC [LOCALLY_PATH_CONNECTED_SPHERE,
             LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let (FINITE_CIRCLE_INTERSECTION, CARD_CIRCLE_INTERSECTION_LE) ← CONJ_PAIR (← prove
   r"(!a b:real^2 r s.
        FINITE(sphere(a,r) INTER sphere(b,s)) <=>
        ~(a = b /\ r = s /\ &0 < r /\ &0 < s)) /\
   (!a b:real^2 r s.
        ~(a = b /\ r = s /\ &0 < r /\ &0 < s)
        ==> CARD(sphere(a,r) INTER sphere(b,s)) <= 2)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"&0 < r") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      MATCH_MP_TAC (← MESON [FINITE_SUBSET, CARD_SUBSET, LE_TRANS]
       (← q r"!t. s SUBSET t /\ FINITE t /\ CARD t <= n
            ==> FINITE s /\ CARD s <= n")) THEN
      EXISTS_TAC (← q r"{a:real^2}") THEN
      REWRITE_TAC [FINITE_SING, CARD_SING, SUBSET, IN_SING, IN_INTER, ARITH] THEN
      REWRITE_TAC [IN_SPHERE] THEN POP_ASSUM MP_TAC THEN CONV_TAC (fun t => NORM_ARITH t)] THEN
    ASM_CASES_TAC (← q r"&0 < s") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC,
      MATCH_MP_TAC (← MESON [FINITE_SUBSET, CARD_SUBSET, LE_TRANS]
       (← q r"!t. s SUBSET t /\ FINITE t /\ CARD t <= n
            ==> FINITE s /\ CARD s <= n")) THEN
      EXISTS_TAC (← q r"{b:real^2}") THEN
      REWRITE_TAC [FINITE_SING, CARD_SING, SUBSET, IN_SING, IN_INTER, ARITH] THEN
      REWRITE_TAC [IN_SPHERE] THEN POP_ASSUM MP_TAC THEN CONV_TAC (fun t => NORM_ARITH t)] THEN
    ASM_CASES_TAC (← q r"a:real^2 = b /\ r:real = s") THEN
    ASM_REWRITE_TAC [INTER_IDEMPOT, FINITE_SPHERE] THEN
    ASM_REWRITE_TAC [DIMINDEX_2, ARITH_EQ, REAL_NOT_LE] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"n <= 2 <=> ~(3 <= n)")] THEN
    MP_TAC (← ISPECL [← q r"3", ← q r"sphere(a:real^2,r) INTER sphere(b,s)"]
          CHOOSE_SUBSET_STRONG) THEN
    MATCH_MP_TAC (← TAUT (← q r"~r ==> ((p ==> q) ==> r) ==> p /\ ~q")) THEN
    CONV_TAC (ONCE_DEPTH_CONV HAS_SIZE_CONV) THEN
    DISCH_THEN (CHOOSE_THEN (CONJUNCTS_THEN MP_TAC)) THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← TAUT (← q r"~(p /\ q) ==> p ==> ~q"))) THEN
    REPEAT (FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← REAL_ARITH
     (← q r"&0 < r ==> r = abs r")))) THEN
    REWRITE_TAC [REAL_EQ_SQUARE_ABS] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, IN_INTER, IN_SPHERE] THEN
    ONCE_REWRITE_TAC [← GSYM DIST_EQ_0] THEN
    REWRITE_TAC [dist, NORM_EQ_SQUARE, REAL_POS] THEN
    REWRITE_TAC [DOT_2, VECTOR_SUB_COMPONENT] THEN CONV_TAC (fun t => REAL_RING t)))

  let INTER_SPHERE_EQ_EMPTY ← prove
   r"!a b:real^N r s.
        sphere(a,r) INTER sphere(b,s) = {} <=>
        if dimindex(:N) = 1 then
          r < &0 \/ s < &0 \/ ~(dist(a,b) = abs(r - s)) /\ ~(dist(a,b) = r + s)
        else
          r < &0 \/ s < &0 \/ dist(a,b) < abs(r - s) \/ r + s < dist(a,b)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_INTER, IN_SPHERE, NOT_IN_EMPTY] THEN
      REWRITE_TAC [dist, NORM_EQ_SQUARE] THEN
      ASM_CASES_TAC (← q r"&0 <= r") THEN ASM_REWRITE_TAC [← GSYM REAL_NOT_LE] THEN
      ASM_CASES_TAC (← q r"&0 <= s") THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [dot, SUM_1, VECTOR_SUB_COMPONENT] THEN
      REWRITE_TAC [← GSYM REAL_POW_2, ← GSYM REAL_EQ_SQUARE_ABS] THEN
      ASM_SIMP_TAC [REAL_LE_ADD, REAL_ABS_POS, REAL_ABS_ABS] THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"abs(x - y) = abs r <=> y = x - r \/ y = x + r")] THEN
      EQ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      DISCH_THEN (fun th => tactic_of do pure (
          MP_TAC (← SPEC (← q r"(lambda i. (a:real^N)$1 + r):real^N") th) THEN
          MP_TAC (← SPEC (← q r"(lambda i. (a:real^N)$1 - r):real^N") th))) THEN
      ASM_SIMP_TAC [LAMBDA_BETA, ARITH] THEN REAL_ARITH_TAC,
      EQ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [EXTENSION, IN_INTER, IN_SPHERE, NOT_IN_EMPTY] THEN
        CONV_TAC (fun t => NORM_ARITH t)] THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(n = 1) ==> 1 <= n ==> 2 <= n"))) THEN
      REWRITE_TAC [DIMINDEX_GE_1] THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"sphere(a:real^N,r) SUBSET cball(b,s)") THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
         [← GSYM SPHERE_UNION_BALL]) THEN
        ASM_SIMP_TAC [← SET_RULE
         (← q r"a INTER b = {} ==> (a SUBSET b UNION c <=> a SUBSET c)")] THEN
        SIMP_TAC [SPHERE_SUBSET_CONVEX, CONVEX_BALL, SUBSET_BALLS] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"sphere(a:real^N,r)", ← q r"cball(b:real^N,s)"]
            CONNECTED_INTER_FRONTIER) THEN
      ASM_SIMP_TAC [CONNECTED_SPHERE, FRONTIER_CBALL, DE_MORGAN_THM] THEN
      DISCH_THEN DISJ_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MP_TAC (← ISPECL [← q r"cball(b:real^N,s)", ← q r"cball(a:real^N,r)"]
            CONNECTED_INTER_FRONTIER) THEN
      REWRITE_TAC [CONNECTED_CBALL, FRONTIER_CBALL] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [DE_MORGAN_THM]] THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF t = {} <=> s SUBSET t")] THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
       [REWRITE_TAC [INTER_BALLS_EQ_EMPTY, DIST_SYM] THEN REAL_ARITH_TAC,
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM SPHERE_UNION_BALL] THEN
        ASM_SIMP_TAC [← SET_RULE
         (← q r"a INTER b = {} ==> (b SUBSET a UNION c <=> b SUBSET c)")] THEN
        REWRITE_TAC [SUBSET_BALLS, DIST_SYM] THEN REAL_ARITH_TAC]])

  let HAS_SIZE_INTER_SPHERE_1 ← prove
   r"!a b:real^N r s.
        (sphere(a,r) INTER sphere(b,s)) HAS_SIZE 1 <=>
        &0 <= r /\ &0 <= s /\
        (a = b ==> r = &0 /\ s = &0) /\
        (dist(a,b) = r + s \/ dist(a,b) = abs(r - s))"
   (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
    GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:real^N") THEN
    SIMP_TAC [DIST_0, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
    SIMP_TAC [← REAL_ARITH (← q r"&0 <= b ==> (abs b * &1 = x <=> x = b)")] THEN
    X_GEN_TAC (← q r"b:real") THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"b = &0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO] THEN ASM_CASES_TAC (← q r"r:real = s") THEN
      ASM_REWRITE_TAC [INTER_IDEMPOT, HAS_SIZE_SPHERE_1] THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      EQ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s = {} ==> (?a. s = {a}) ==> P")) THEN
      REWRITE_TAC [EXTENSION, IN_INTER, IN_SPHERE_0, NOT_IN_EMPTY] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← CONV_RULE (LAND_CONV SYM_CONV) (← SPEC_ALL VECTOR_MUL_EQ_0)] THEN
      ASM_SIMP_TAC [BASIS_EQ_0, IN_NUMSEG, LE_1, DIMINDEX_GE_1, LE_REFL]] THEN
    ASM_CASES_TAC (← q r"sphere(vec 0:real^N,r) INTER sphere (b % basis 1,s) = {}") THEN
    ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [HAS_SIZE, CARD_CLAUSES, ARITH_EQ] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INTER_SPHERE_EQ_EMPTY]) THEN
      SIMP_TAC [DIST_0, NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= b ==> (abs b * &1 = x <=> x = b)")] THEN
      REAL_ARITH_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    REWRITE_TAC [IN_INTER, IN_SPHERE, DIST_0, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN MATCH_MP_TAC (← TAUT
     (← q r"!r. (p ==> r) /\ (r ==> q) /\ (q ==> p) ==> (p <=> q)")) THEN
    EXISTS_TAC (← q r"x:real^N = x$1 % basis 1") THEN REPEAT CONJ_TAC THENL
     [DISCH_TAC THEN REWRITE_TAC [CART_EQ] THEN
      SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MUL_RID, REAL_MUL_RZERO] THEN
      FIRST_X_ASSUM (MP_TAC o CONV_RULE HAS_SIZE_CONV) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"(?a. s = {a}) ==> !x y. x IN s /\ y IN s ==> x = y"))) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"x:real^N",
        ← q r"(lambda i. if i = k then --((x:real^N)$k) else x$i):real^N"]) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [IN_INTER, IN_SPHERE] THEN MATCH_MP_TAC (← MESON []
         (← q r"(x = r /\ y = s) /\ (x' = x /\ y' = y)
          ==> (x = r /\ y = s) /\ (x' = r /\ y' = s)")) THEN
        CONJ_TAC THENL [ASM_REWRITE_TAC [DIST_0], ALL_TAC] THEN
        REWRITE_TAC [dist] THEN CONJ_TAC THEN
        MATCH_MP_TAC NORM_EQ_COMPONENTWISE THEN
        SIMP_TAC [VECTOR_SUB_COMPONENT, VEC_COMPONENT, LAMBDA_BETA] THEN
        SIMP_TAC [VECTOR_MUL_COMPONENT, BASIS_COMPONENT] THEN
        REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_REAL_ARITH_TAC,
        SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC],
      DISCH_THEN SUBST_ALL_TAC THEN REPEAT (POP_ASSUM MP_TAC) THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL,
               dist, ← GSYM VECTOR_SUB_RDISTRIB] THEN
      REAL_ARITH_TAC,
      DISCH_TAC THEN CONV_TAC HAS_SIZE_CONV THEN EXISTS_TAC (← q r"x:real^N") THEN
      REWRITE_TAC [EXTENSION, IN_INTER, IN_SPHERE, DIST_0, IN_SING] THEN
      X_GEN_TAC (← q r"y:real^N") THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"x:real^N = x$1 % basis 1 /\ y:real^N = y$1 % basis 1")
       (CONJUNCTS_THEN SUBST_ALL_TAC)
      THENL
       [ALL_TAC,
        AP_THM_TAC THEN AP_TERM_TAC THEN REPEAT (POP_ASSUM MP_TAC) THEN
        REWRITE_TAC [dist, ← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL] THEN
        SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN REAL_ARITH_TAC] THEN
      CONJ_TAC THEN
      MP_TAC (← ISPEC (← q r"b % basis 1:real^N") COLLINEAR_LEMMA_ALT) THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")),
        DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N"))] THEN
      ASM_SIMP_TAC [VECTOR_MUL_EQ_0, BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")) THEN
      SIMP_TAC [LEFT_IMP_EXISTS_THM, VECTOR_MUL_COMPONENT, VECTOR_MUL_ASSOC] THEN
      SIMP_TAC [BASIS_COMPONENT, DIMINDEX_GE_1, LE_REFL, REAL_MUL_RID] THEN
      REWRITE_TAC [COLLINEAR_BETWEEN_CASES, between] THEN
      POP_ASSUM_LIST (MP_TAC o end_itlist CONJ o HolLight.rev) THEN
      REWRITE_TAC [DIST_SYM, DIST_0, NORM_MUL] THEN
      SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL, real_abs] THEN
      REAL_ARITH_TAC])

  return { FINITE_SPHERE, LIMIT_POINT_OF_SPHERE, CARD_EQ_SPHERE, HAS_SIZE_SPHERE_2,
           LOCALLY_PATH_CONNECTED_SPHERE, LOCALLY_CONNECTED_SPHERE, FINITE_CIRCLE_INTERSECTION,
           CARD_CIRCLE_INTERSECTION_LE, INTER_SPHERE_EQ_EMPTY, HAS_SIZE_INTER_SPHERE_1 }

/- ------------------------------------------------------------------------- -/
/- Annuli, complements of bounded convex sets, sets minus balls and          -/
/- interior points.  (paths.ml 13161-13465)                                  -/
/- ------------------------------------------------------------------------- -/

structure PUQ where
  PATH_CONNECTED_ANNULUS : thm
  CONNECTED_ANNULUS : thm
  PATH_CONNECTED_COMPLEMENT_BOUNDED_CONVEX : thm
  CONNECTED_COMPLEMENT_BOUNDED_CONVEX : thm
  CONNECTED_DIFF_BALL : thm
  PATH_CONNECTED_DIFF_BALL : thm
  CONNECTED_DELETE_INTERIOR_POINT : thm
  CONNECTED_DELETE_INTERIOR_POINT_EQ : thm
  CONNECTED_OPEN_DELETE_EQ : thm
  PATH_CONNECTED_DELETE_INTERIOR_POINT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUQ [HolBase] (D : PathsDeps) (BC : PTC) (BH : PTH) (BK : PTK) (BL : PTL)
    (BUO : PUO) : ExceptT String IO PUQ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { CONJ_SYM, DIFF_EMPTY, DIMINDEX_1, DIMINDEX_GE_1, EQ_IMP, ETA_AX, EXISTS_IN_GSPEC,
        EXTENSION, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FSTCART_PASTECART, IMAGE_ID, IMP_CONJ, INSERT_SUBSET, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY,
        NOT_IMP, PCROSS, REAL_ABS_DIV, REAL_ABS_INV, REAL_ABS_NUM, REAL_DIV_RMUL, .. } :=
    D.cvx.core3
  let { REAL_LE_ADDR, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_REFL, .. } := D.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_NOT_LE, REAL_POS,
        REAL_SUB_LE, SIMPLE_IMAGE_GEN, SNDCART_PASTECART, SUBSET, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { UNION_SUBSET, o_DEF, real_abs, .. } := D.cvx.core6
  let { DIST_SYM, .. } := D.cvx.vec1
  let { EXISTS_LIFT, FORALL_1, LIFT_DROP, LINEAR_FSTCART, LINEAR_SNDCART, NORM_0, NORM_BASIS,
        NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, REAL_ABS_NORM, .. } := D.cvx.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_ADD_SUB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_SUB_EQ, VECTOR_SUB_RZERO, dist, drop, .. } := D.cvx.vec4
  let { BALL_EQ_EMPTY, BALL_SUBSET_CBALL, BOUNDED_INSERT, BOUNDED_SUBSET_BALL, CENTRE_IN_BALL,
        CENTRE_IN_CBALL, CLOSED_CBALL, CLOSURE_BALL, .. } := D.cvx.top1
  let { CONTINUOUS_ON_MUL, FRONTIER_BALL, FRONTIER_COMPLEMENT, .. } := D.cvx.top3
  let { INTERIOR_OPEN, INTERIOR_SUBSET, IN_BALL, IN_CBALL, IN_INTERIOR_CBALL, IN_SPHERE,
        LINEAR_CONTINUOUS_ON, OPEN_BALL, .. } := D.cvx.top4
  let { is_interval, segment, .. } := D.cvx.top5
  let { IN_IMAGE_LIFT_DROP, LIFT_IN_IMAGE_LIFT, .. } := D.pvec
  let { CBALL_DIFF_BALL, .. } := D.ptop1
  let { CONNECTED_DIFF_OPEN_FROM_CLOSED, CONNECTED_INSERT_LIMPT, CONNECTED_UNION, .. } := D.ptop2
  let { INTERIOR_COMPLEMENT, INTERIOR_LIMIT_POINT, LIMPT_DELETE, .. } := D.ptop4
  let { SPHERE_EQ_EMPTY, sphere, .. } := D.ptop5
  let { CONVEX_ALT, .. } := D.pcvx1
  let { CONVEX_UNIV, IS_INTERVAL_CONVEX, .. } := D.pcvx2
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_IMAGE_JOIN, .. } := BC
  let { EXISTS_PATH_SUBPATH_TO_FRONTIER, .. } := BH
  let { PATH_COMPONENT_SYM, PATH_COMPONENT_TRANS, PATH_COMPONENT_OF_SUBSET, path_connected,
        PATH_CONNECTED_IFF_PATH_COMPONENT, PATH_CONNECTED_LINEPATH, .. } := BK
  let { CONVEX_IMP_PATH_CONNECTED, PATH_CONNECTED_IMP_CONNECTED,
        PATH_CONNECTED_CONTINUOUS_IMAGE, PATH_CONNECTED_UNION, PATH_CONNECTED_PCROSS, .. } := BL
  let { PATH_CONNECTED_PUNCTURED_CBALL, CONNECTED_PUNCTURED_CBALL, PATH_CONNECTED_SPHERE,
        CONNECTED_SPHERE, .. } := BUO
  -- @@SCOPE END

  let PATH_CONNECTED_ANNULUS ← prove
   r"(!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> path_connected {x | r1 < norm(x - a) /\ norm(x - a) < r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> path_connected {x | r1 < norm(x - a) /\ norm(x - a) <= r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> path_connected {x | r1 <= norm(x - a) /\ norm(x - a) < r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> path_connected {x | r1 <= norm(x - a) /\ norm(x - a) < r2})"
   (← do
    let lemma ← prove
     r"!a:real^N P.
      2 <= dimindex(:N) /\ path_connected {lift r | &0 <= r /\ P r}
      ==> path_connected {x | P(norm(x - a))}"
     (REPEAT GEN_TAC THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
      REWRITE_TAC [VECTOR_SUB_RZERO] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{x:real^N | P(norm(x))} =
        IMAGE (\z. drop(fstcart z) % sndcart z)
              {pastecart x y | x IN {lift x | &0 <= x /\ P x} /\
                               y IN {y | norm y = &1}}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_IMAGE] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
        REWRITE_TAC [EXISTS_IN_GSPEC, FSTCART_PASTECART, SNDCART_PASTECART] THEN
        X_GEN_TAC (← q r"z:real^N") THEN REWRITE_TAC [EXISTS_LIFT, LIFT_DROP] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        REWRITE_TAC [LIFT_IN_IMAGE_LIFT, IMAGE_ID] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [NORM_MUL, REAL_MUL_RID] THEN
        ASM_REWRITE_TAC [real_abs] THEN ASM_CASES_TAC (← q r"z:real^N = vec 0") THENL
         [MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"basis 1:real^N"] THEN
          ASM_SIMP_TAC [NORM_BASIS, DIMINDEX_GE_1, LE_REFL, VECTOR_MUL_LZERO] THEN
          ASM_MESON_TAC [NORM_0, REAL_ABS_NUM, REAL_LE_REFL],
          MAP_EVERY EXISTS_TAC [← q r"norm(z:real^N)", ← q r"inv(norm z) % z:real^N"] THEN
          ASM_SIMP_TAC [REAL_ABS_NORM, NORM_MUL, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
            NORM_POS_LE, REAL_ABS_INV, REAL_MUL_RINV, REAL_MUL_LINV, NORM_EQ_0]],
        MATCH_MP_TAC PATH_CONNECTED_CONTINUOUS_IMAGE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
          REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX] THEN
          SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART],
          REWRITE_TAC [← GSYM PCROSS] THEN
          MATCH_MP_TAC PATH_CONNECTED_PCROSS THEN ASM_REWRITE_TAC [] THEN
          ONCE_REWRITE_TAC [← NORM_ARITH (← q r"norm y = norm(y - vec 0:real^N)")] THEN
          ONCE_REWRITE_TAC [NORM_SUB] THEN
          REWRITE_TAC [← REWRITE_RULE [dist] (← GSYM sphere)] THEN
          ASM_SIMP_TAC [PATH_CONNECTED_SPHERE]]])
    pure (
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"a:real^N") lemma) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONVEX_IMP_PATH_CONNECTED THEN
    MATCH_MP_TAC IS_INTERVAL_CONVEX THEN
    REWRITE_TAC [is_interval] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    REWRITE_TAC [IN_IMAGE_LIFT_DROP, FORALL_1, DIMINDEX_1] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM drop] THEN REAL_ARITH_TAC))

  let CONNECTED_ANNULUS ← prove
   r"(!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> connected {x | r1 < norm(x - a) /\ norm(x - a) < r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> connected {x | r1 < norm(x - a) /\ norm(x - a) <= r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> connected {x | r1 <= norm(x - a) /\ norm(x - a) < r2}) /\
   (!a:real^N r1 r2.
        2 <= dimindex(:N)
        ==> connected {x | r1 <= norm(x - a) /\ norm(x - a) < r2})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_IMP_CONNECTED THEN
    ASM_SIMP_TAC [PATH_CONNECTED_ANNULUS])

  let PATH_CONNECTED_COMPLEMENT_BOUNDED_CONVEX ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s /\ convex s
       ==> path_connected((:real^N) DIFF s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
    ASM_SIMP_TAC [DIFF_EMPTY, CONVEX_IMP_PATH_CONNECTED, CONVEX_UNIV] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^N")) THEN
    REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(x:real^N = a) /\ ~(y = a)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"bounded((x:real^N) INSERT y INSERT s)") MP_TAC THENL
     [ASM_REWRITE_TAC [BOUNDED_INSERT], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    REWRITE_TAC [INSERT_SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC PATH_COMPONENT_TRANS THEN
    ABBREV_TAC (← q r"C = (B / norm(x - a:real^N))") THEN
    EXISTS_TAC (← q r"a + C % (x - a):real^N") THEN CONJ_TAC THENL
     [MATCH_MP_TAC PATH_CONNECTED_LINEPATH THEN
      REWRITE_TAC [SUBSET, segment, FORALL_IN_GSPEC, IN_DIFF, IN_UNIV] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&1 - u) % x + u % (a + B % (x - a)):real^N =
        a + (&1 + (B - &1) * u) % (x - a)")] THEN
      X_GEN_TAC (← q r"u:real") THEN STRIP_TAC THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"a:real^N", ← q r"a + (&1 + (C - &1) * u) % (x - a):real^N",
        ← q r"&1 / (&1 + (C - &1) * u)"]) THEN
      SUBGOAL_THEN (← q r"&1 <= &1 + (C - &1) * u") ASSUME_TAC THENL
       [REWRITE_TAC [REAL_LE_ADDR] THEN MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_REWRITE_TAC [REAL_SUB_LE] THEN
        EXPAND_TAC "C" THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_BALL, dist]) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, ← NORM_ARITH (← q r"&1 * norm(x - a) = norm(a - x)")],
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP
         (← REAL_ARITH (← q r"&1 <= a ==> &0 < a")))] THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_POS, REAL_LT_IMP_LE, REAL_LE_LDIV_EQ,
                   REAL_MUL_LID] THEN
      ASM_SIMP_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, REAL_DIV_RMUL,
                   REAL_LT_IMP_NZ] THEN
      UNDISCH_TAC (← q r"~((x:real^N) IN s)") THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC PATH_COMPONENT_SYM THEN
    MATCH_MP_TAC PATH_COMPONENT_TRANS THEN
    ABBREV_TAC (← q r"D = (B / norm(y - a:real^N))") THEN
    EXISTS_TAC (← q r"a + D % (y - a):real^N") THEN CONJ_TAC THENL
     [MATCH_MP_TAC PATH_CONNECTED_LINEPATH THEN
      REWRITE_TAC [SUBSET, segment, FORALL_IN_GSPEC, IN_DIFF, IN_UNIV] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&1 - u) % y + u % (a + B % (y - a)):real^N =
        a + (&1 + (B - &1) * u) % (y - a)")] THEN
      X_GEN_TAC (← q r"u:real") THEN STRIP_TAC THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONVEX_ALT]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"a:real^N", ← q r"a + (&1 + (D - &1) * u) % (y - a):real^N",
        ← q r"&1 / (&1 + (D - &1) * u)"]) THEN
      SUBGOAL_THEN (← q r"&1 <= &1 + (D - &1) * u") ASSUME_TAC THENL
       [REWRITE_TAC [REAL_LE_ADDR] THEN MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_REWRITE_TAC [REAL_SUB_LE] THEN
        EXPAND_TAC "D" THEN
        ASM_SIMP_TAC [REAL_LE_RDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_BALL, dist]) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, ← NORM_ARITH (← q r"&1 * norm(y - a) = norm(a - y)")],
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP
         (← REAL_ARITH (← q r"&1 <= a ==> &0 < a")))] THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_POS, REAL_LT_IMP_LE, REAL_LE_LDIV_EQ,
                   REAL_MUL_LID] THEN
      ASM_SIMP_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, REAL_DIV_RMUL,
                   REAL_LT_IMP_NZ] THEN
      UNDISCH_TAC (← q r"~((y:real^N) IN s)") THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC PATH_COMPONENT_OF_SUBSET THEN
    EXISTS_TAC (← q r"{x:real^N | norm(x - a) = B}") THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"s SUBSET ball(a:real^N,B)") THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_DIFF, IN_UNIV, IN_BALL, dist] THEN
      MESON_TAC [NORM_SUB, REAL_LT_REFL],
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"B:real"] PATH_CONNECTED_SPHERE) THEN
      REWRITE_TAC [← REWRITE_RULE [← ONCE_REWRITE_RULE [DIST_SYM] dist] sphere] THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [IN_ELIM_THM, VECTOR_ADD_SUB, NORM_MUL] THEN
      MAP_EVERY EXPAND_TAC ["C", "D"] THEN
      REWRITE_TAC [REAL_ABS_DIV, REAL_ABS_NORM] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_REAL_ARITH_TAC])

  let CONNECTED_COMPLEMENT_BOUNDED_CONVEX ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded s /\ convex s
       ==> connected((:real^N) DIFF s)"
   (SIMP_TAC [PATH_CONNECTED_IMP_CONNECTED,
             PATH_CONNECTED_COMPLEMENT_BOUNDED_CONVEX])

  let CONNECTED_DIFF_BALL ← prove
   r"!s a:real^N r.
        2 <= dimindex(:N) /\ connected s /\ cball(a,r) SUBSET s
        ==> connected(s DIFF ball(a,r))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_DIFF_OPEN_FROM_CLOSED THEN
    EXISTS_TAC (← q r"cball(a:real^N,r)") THEN
    ASM_REWRITE_TAC [OPEN_BALL, CLOSED_CBALL, BALL_SUBSET_CBALL] THEN
    REWRITE_TAC [CBALL_DIFF_BALL] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
    ASM_SIMP_TAC [CONNECTED_SPHERE])

  let PATH_CONNECTED_DIFF_BALL ← prove
   r"!s a:real^N r.
        2 <= dimindex(:N) /\ path_connected s /\ cball(a,r) SUBSET s
        ==> path_connected(s DIFF ball(a,r))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"ball(a:real^N,r) = {}") THEN
    ASM_SIMP_TAC [DIFF_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [BALL_EQ_EMPTY, REAL_NOT_LE]) THEN
    REWRITE_TAC [path_connected] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:real^N") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ASM_SIMP_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
    DISCH_THEN (fun th => tactic_of do pure (
     MP_TAC (← SPECL [← q r"x:real^N", ← q r"a:real^N"] th) THEN
     MP_TAC (← SPECL [← q r"y:real^N", ← q r"a:real^N"] th))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g2:real^1->real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g1:real^1->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g2:real^1->real^N", ← q r"(:real^N) DIFF ball(a,r)"]
          EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
    MP_TAC (← ISPECL [← q r"g1:real^1->real^N", ← q r"(:real^N) DIFF ball(a,r)"]
          EXISTS_PATH_SUBPATH_TO_FRONTIER) THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL, IN_DIFF, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    ASM_SIMP_TAC [FRONTIER_COMPLEMENT, INTERIOR_COMPLEMENT, CLOSURE_BALL] THEN
    ASM_SIMP_TAC [FRONTIER_BALL, IN_SPHERE] THEN
    X_GEN_TAC (← q r"h1:real^1->real^N") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"h2:real^1->real^N") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] PATH_CONNECTED_SPHERE) THEN
    ASM_REWRITE_TAC [path_connected] THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"pathfinish h1:real^N", ← q r"pathfinish h2:real^N"]) THEN
    ASM_SIMP_TAC [IN_SPHERE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^1->real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"h1 ++ h ++ reversepath h2:real^1->real^N") THEN
    ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_REVERSEPATH,
                 PATHFINISH_REVERSEPATH, PATH_JOIN, PATH_REVERSEPATH,
                 PATH_IMAGE_JOIN, PATH_IMAGE_REVERSEPATH] THEN
    REWRITE_TAC [UNION_SUBSET] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            SUBSET_TRANS)) THEN
      UNDISCH_TAC (← q r"cball(a:real^N,r) SUBSET s") THEN
      SIMP_TAC [SUBSET, IN_CBALL, IN_SPHERE, IN_BALL, IN_DIFF] THEN
      MESON_TAC [REAL_LE_REFL, REAL_LT_REFL],
      ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET t /\ s INTER u = {} ==> s SUBSET t DIFF u")) THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s DELETE a SUBSET (UNIV DIFF t) ==> ~(a IN u) /\ u SUBSET t
        ==> s INTER u = {}"))) THEN
    ASM_REWRITE_TAC [BALL_SUBSET_CBALL, IN_BALL, REAL_LT_REFL])

  let CONNECTED_DELETE_INTERIOR_POINT ← prove
   r"!s a:real^N.
        2 <= dimindex(:N) /\ connected s /\ a IN interior s
        ==> connected(s DELETE a)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR_CBALL]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"s DELETE a = (s DIFF ball(a:real^N,r)) UNION (cball(a,r) DELETE a)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] BALL_SUBSET_CBALL) THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] CENTRE_IN_BALL) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_UNION THEN
      ASM_SIMP_TAC [CONNECTED_DIFF_BALL, CONNECTED_PUNCTURED_CBALL] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"c SUBSET s ==> ~(c DIFF b = {}) /\ a IN b
                       ==> ~((s DIFF b) INTER (c DELETE a) = {})"))) THEN
      ASM_REWRITE_TAC [CBALL_DIFF_BALL, CENTRE_IN_BALL, SPHERE_EQ_EMPTY] THEN
      ASM_REAL_ARITH_TAC])

  let CONNECTED_DELETE_INTERIOR_POINT_EQ ← prove
   r"!s a:real^N.
        2 <= dimindex(:N) /\ a IN interior s
        ==> (connected (s DELETE a) <=> connected s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [CONNECTED_DELETE_INTERIOR_POINT] THEN FIRST_ASSUM
     (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [SUBSET] INTERIOR_SUBSET)) THEN
    SUBGOAL_THEN (← q r"s = (a:real^N) INSERT (s DELETE a)") SUBST1_TAC THENL
     [ASM SET_TAC [], MATCH_MP_TAC CONNECTED_INSERT_LIMPT] THEN
    ASM_SIMP_TAC [LIMPT_DELETE, INTERIOR_LIMIT_POINT])

  let CONNECTED_OPEN_DELETE_EQ ← prove
   r"!s a:real^N.
        2 <= dimindex(:N) /\ open s
        ==> (connected(s DELETE a) <=> connected s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s DELETE (a:real^N) = s \/ a IN s") STRIP_ASSUME_TAC THENL
     [SET_TAC [], ASM_REWRITE_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC CONNECTED_DELETE_INTERIOR_POINT_EQ THEN
    ASM_SIMP_TAC [INTERIOR_OPEN])

  let PATH_CONNECTED_DELETE_INTERIOR_POINT ← prove
   r"!s a:real^N.
        2 <= dimindex(:N) /\ path_connected s /\ a IN interior s
        ==> path_connected(s DELETE a)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR_CBALL]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"s DELETE a = (s DIFF ball(a:real^N,r)) UNION (cball(a,r) DELETE a)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] BALL_SUBSET_CBALL) THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] CENTRE_IN_BALL) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      MATCH_MP_TAC PATH_CONNECTED_UNION THEN
      ASM_SIMP_TAC [PATH_CONNECTED_DIFF_BALL, PATH_CONNECTED_PUNCTURED_CBALL] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"c SUBSET s ==> ~(c DIFF b = {}) /\ a IN b
                       ==> ~((s DIFF b) INTER (c DELETE a) = {})"))) THEN
      ASM_REWRITE_TAC [CBALL_DIFF_BALL, CENTRE_IN_BALL, SPHERE_EQ_EMPTY] THEN
      ASM_REAL_ARITH_TAC])

  return { PATH_CONNECTED_ANNULUS, CONNECTED_ANNULUS, PATH_CONNECTED_COMPLEMENT_BOUNDED_CONVEX,
           CONNECTED_COMPLEMENT_BOUNDED_CONVEX, CONNECTED_DIFF_BALL, PATH_CONNECTED_DIFF_BALL,
           CONNECTED_DELETE_INTERIOR_POINT, CONNECTED_DELETE_INTERIOR_POINT_EQ,
           CONNECTED_OPEN_DELETE_EQ, PATH_CONNECTED_DELETE_INTERIOR_POINT }

/- ------------------------------------------------------------------------- -/
/- Open sets minus closed balls; convex and open sets minus low-dimensional  -/
/- sets.  (paths.ml 13466-13724)                                             -/
/- ------------------------------------------------------------------------- -/

structure PUR where
  CONNECTED_OPEN_DIFF_CBALL : thm
  PATH_CONNECTED_CONVEX_DIFF_LOWDIM : thm
  PATH_CONNECTED_OPEN_IN_DIFF_LOWDIM : thm
  PATH_CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM : thm
  CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUR [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BS : PTS) (BUG : PUG)
    (BUO : PUO) (BUQ : PUQ) : ExceptT String IO PUR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH,
        INT_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { DIFF_EMPTY, DIMINDEX_GE_1, EMPTY_DIFF, EXISTS_IN_GSPEC, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_INSERT, IMP_CONJ, INTERS_GSPEC, INTER_COMM, INT_OF_NUM_ADD, INT_OF_NUM_LE,
        IN_DIFF, .. } := D.cvx.core2
  let { IN_INSERT, IN_INTER, IN_UNIV, LE_REFL, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_ABS_DIV,
        REAL_ABS_MUL, REAL_DIV_RMUL, .. } := D.cvx.core3
  let { REAL_LT_ADDR, REAL_LT_IMP_NE, REAL_LT_IMP_NZ, .. } := D.cvx.core4
  let { REAL_MUL_LINV, REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_0, REAL_SUB_RDISTRIB,
        RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, UNIONS_0, UNIONS_INSERT, .. } := D.cvx.core6
  let { HULL_INC, HULL_MONO, HULL_SUBSET, REAL_HALF, .. } := D.cvx.misc
  let { DIM_INSERT, DIM_SPAN, DIM_SUBSET, DIST_REFL, DIST_SYM, .. } := D.cvx.vec1
  let { NORM_BASIS, NORM_EQ_0, .. } := D.cvx.vec2
  let { NORM_MUL, REAL_ABS_NORM, SPAN_MUL, SPAN_SUB, SPAN_SUPERSET, .. } := D.cvx.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, dist, .. } :=
    D.cvx.vec4
  let { OPEN_IN_DIFF, OPEN_IN_SUBSET_TRANS, .. } := D.cvx.met
  let { BALL_SUBSET_CBALL, CBALL_EQ_EMPTY, CENTRE_IN_BALL, CLOSED_CLOSURE, .. } := D.cvx.top1
  let { CLOSURE_OPEN_IN_INTER_CLOSURE, CLOSURE_SUBSET, COMPACT_CBALL, .. } := D.cvx.top2
  let { IN_BALL, IN_CBALL, IN_SEGMENT, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, SEGMENT_CLOSED_OPEN,
        SEGMENT_SYM, SETDIST_LE_DIST, SETDIST_POS_LE, closed, open_segment, .. } := D.cvx.top5
  let { DIFF_UNIONS, .. } := D.pses1
  let { UNIONS_MONO, .. } := D.pses2
  let { CLOSED_IN_INTER_CLOSED, CLOSED_IN_REFL, CLOSED_UNIONS, .. } := D.ptop1
  let { CONNECTED_INTERMEDIATE_CLOSURE, CONNECTED_UNION, .. } := D.ptop2
  let { DENSE_OPEN_INTERS, .. } := D.ptop3
  let { OPEN_CLOSED, SETDIST_EQ_0_COMPACT_CLOSED, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_CONVEX, AFF_DIM_AFFINE_HULL, AFF_DIM_CLOSURE,
        AFF_DIM_CONVEX_INTER_OPEN, AFF_DIM_DIM_0, AFF_DIM_OPEN_IN, CONVEX_BALL, .. } := D.pcvx1
  let { CONVEX_CONTAINS_SEGMENT, CONVEX_CONTAINS_SEGMENT_IMP, CONVEX_INTER,
        DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL, .. } := D.pcvx2
  let { PATH_COMPONENT_TRANS, PATH_CONNECTED_IFF_PATH_COMPONENT, PATH_CONNECTED_COMPONENT_SET,
        PATH_CONNECTED_LINEPATH, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, PATH_CONNECTED_EMPTY, .. } := BL
  let { OPEN_IN_IMP_LOCALLY_PATH_CONNECTED, .. } := BS
  let { PATH_CONNECTED_EQ_CONNECTED_LPC, CONNECTED_OPEN_PATH_CONNECTED, .. } := BUG
  let { PATH_CONNECTED_CONNECTED_DIFF, .. } := BUO
  let { CONNECTED_ANNULUS, PATH_CONNECTED_DIFF_BALL, .. } := BUQ
  -- @@SCOPE END

  let CONNECTED_OPEN_DIFF_CBALL ← prove
   r"!s a:real^N r.
        2 <= dimindex (:N) /\ open s /\ connected s /\ cball(a,r) SUBSET s
        ==> connected(s DIFF cball(a,r))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"cball(a:real^N,r) = {}") THEN ASM_REWRITE_TAC [DIFF_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [CBALL_EQ_EMPTY, REAL_NOT_LT]) THEN
    SUBGOAL_THEN (← q r"?r'. r < r' /\ cball(a:real^N,r') SUBSET s")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"s = (:real^N)") THENL
       [EXISTS_TAC (← q r"r + &1") THEN ASM_SIMP_TAC [SUBSET_UNIV] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"cball(a:real^N,r)", ← q r"(:real^N) DIFF s"]
        SETDIST_POS_LE) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 <= x <=> &0 < x \/ x = &0")] THEN
      ASM_SIMP_TAC [SETDIST_EQ_0_COMPACT_CLOSED, ← GSYM OPEN_CLOSED,
                   COMPACT_CBALL, CBALL_EQ_EMPTY] THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF s = {} <=> s = UNIV")] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"b INTER (UNIV DIFF s) = {} <=> b SUBSET s"),
                   ← REAL_ARITH (← q r"&0 <= r ==> ~(r < &0)")] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"r + setdist(cball(a,r),(:real^N) DIFF s) / &2") THEN
      ASM_REWRITE_TAC [REAL_LT_ADDR, REAL_HALF, SUBSET, IN_CBALL] THEN
      X_GEN_TAC (← q r"x:real^N") THEN ASM_CASES_TAC (← q r"x:real^N = a") THENL
       [ASM_MESON_TAC [SUBSET, DIST_REFL, IN_CBALL], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [REAL_NOT_LE] THEN
      MP_TAC (← ISPECL [← q r"cball(a:real^N,r)", ← q r"(:real^N) DIFF s",
                     ← q r"a + r / dist(a,x) % (x - a):real^N", ← q r"x:real^N"]
        SETDIST_LE_DIST) THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, IN_CBALL] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x")] THEN
      ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, ← ONCE_REWRITE_RULE [DIST_SYM] dist,
                   REAL_ABS_NORM, REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"abs r <= r <=> &0 <= r")] THEN
      REWRITE_TAC [NORM_MUL, ← VECTOR_ARITH
       (← q r"x - (a + d % (x - a)):real^N = (&1 - d) % (x - a)")] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_ABS_NORM] THEN
      REWRITE_TAC [← GSYM REAL_ABS_MUL] THEN
      REWRITE_TAC [REAL_ABS_NORM, REAL_SUB_RDISTRIB] THEN
      ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o REWRITE_RULE [SUBSET]) THEN
      ASM_REWRITE_TAC [IN_CBALL, ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
      REAL_ARITH_TAC,
      SUBGOAL_THEN (← q r"s DIFF cball(a:real^N,r) =
                    s DIFF ball(a,r') UNION
                    {x | r < norm(x - a) /\ norm(x - a) <= r'}")
      SUBST1_TAC THENL
       [REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
        REWRITE_TAC [← GSYM REAL_NOT_LE, ← GSYM IN_CBALL] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"b' SUBSET c' /\ c' SUBSET s /\ c SUBSET b'
          ==> s DIFF c = (s DIFF b') UNION {x | ~(x IN c) /\ x IN c'}")) THEN
        ASM_REWRITE_TAC [BALL_SUBSET_CBALL] THEN
        REWRITE_TAC [SUBSET, IN_BALL, IN_CBALL] THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC CONNECTED_UNION THEN
        ASM_SIMP_TAC [CONNECTED_ANNULUS, PATH_CONNECTED_DIFF_BALL,
          PATH_CONNECTED_IMP_CONNECTED, CONNECTED_OPEN_PATH_CONNECTED] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
        REWRITE_TAC [← GSYM REAL_NOT_LE, ← GSYM IN_CBALL] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"c' SUBSET s /\ (?x. x IN c' /\ ~(x IN b') /\ ~(x IN c))
          ==> ~((s DIFF b') INTER {x | ~(x IN c) /\ x IN c'} = {})")) THEN
        ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"a + r' % basis 1:real^N") THEN
        REWRITE_TAC [IN_BALL, IN_CBALL] THEN
        REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,a + x) = norm x")] THEN
        SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
        ASM_REAL_ARITH_TAC]])

  let PATH_CONNECTED_CONVEX_DIFF_LOWDIM ← prove
   r"!s t:real^N->bool.
        convex s /\ aff_dim t + &2 <= aff_dim s ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
    REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_COMPONENT_SET] THEN
    ASM_CASES_TAC (← q r"segment[x:real^N,y] INTER t = {}") THENL
     [MATCH_MP_TAC PATH_CONNECTED_LINEPATH THEN
      ASM_SIMP_TAC [CONVEX_CONTAINS_SEGMENT_IMP, ← SET_RULE
       (← q r"s SUBSET t DIFF u <=> s INTER u = {} /\ s SUBSET t")],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (fun th => REPEAT (POP_ASSUM MP_TAC) THEN
          tactic_of do pure (X_CHOOSE_THEN (← q r"a:real^N") MP_TAC th)) THEN
    GEOM_ORIGIN_TAC (← q r"a:real^N") THEN REWRITE_TAC [IN_INTER] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(vec 0:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?z:real^N. z IN s /\ ~(z IN span(x INSERT y INSERT span t))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"~(t SUBSET s) ==> ?x. x IN t /\ ~(x IN s)")) THEN
      DISCH_THEN (MP_TAC o MATCH_MP DIM_SUBSET) THEN
      UNDISCH_TAC (← q r"aff_dim(t:real^N->bool) + &2 <= aff_dim(s:real^N->bool)") THEN
      ASM_SIMP_TAC [AFF_DIM_DIM_0, HULL_INC, INT_OF_NUM_ADD, INT_OF_NUM_LE] THEN
      MATCH_MP_TAC (← ARITH_RULE (← q r"x <= SUC y ==> y + 2 <= s ==> ~(s <= x)")) THEN
      ONCE_REWRITE_TAC [DIM_INSERT] THEN
      SUBGOAL_THEN (← q r"(x:real^N) IN span(y INSERT span t)")
       (fun th => REWRITE_TAC [th, DIM_INSERT, DIM_SPAN] THEN ARITH_TAC) THEN
      SUBGOAL_THEN (← q r"(vec 0:real^N) IN segment(x,y)") MP_TAC THENL
       [ASM_REWRITE_TAC [open_segment, IN_DIFF, IN_INSERT, NOT_IN_EMPTY] THEN
        ASM SET_TAC [],
        REWRITE_TAC [IN_SEGMENT]] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"u:real") (STRIP_ASSUME_TAC o GSYM))) THEN
      FIRST_ASSUM (MP_TAC o AP_TERM (← q r"(%) (inv(&1 - u)):real^N->real^N")) THEN
      REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_RZERO] THEN
      ASM_SIMP_TAC [REAL_MUL_LINV, REAL_SUB_0, REAL_LT_IMP_NE] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"&1 % x + a % y:real^N = vec 0 <=> x = --a % y")] THEN
      SIMP_TAC [SPAN_MUL, SPAN_SUPERSET, IN_INSERT],
      ALL_TAC] THEN
    MATCH_MP_TAC PATH_COMPONENT_TRANS THEN EXISTS_TAC (← q r"z:real^N") THEN
    SUBGOAL_THEN (← q r"~((z:real^N) IN t)") ASSUME_TAC THENL
     [ASM_MESON_TAC [SPAN_SUPERSET, IN_INSERT], ALL_TAC] THEN
    CONJ_TAC THEN MATCH_MP_TAC PATH_CONNECTED_LINEPATH THENL
     [ALL_TAC, ONCE_REWRITE_TAC [SEGMENT_SYM]] THEN
    ASM_SIMP_TAC [CONVEX_CONTAINS_SEGMENT_IMP, ← SET_RULE
     (← q r"s SUBSET t DIFF u <=> s INTER u = {} /\ s SUBSET t")] THEN
    ASM_REWRITE_TAC [SEGMENT_CLOSED_OPEN, ← SET_RULE
     (← q r"(s UNION {a,b}) INTER t = {} <=>
      ~(a IN t) /\ ~(b IN t) /\ s INTER t = {}")] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. x IN s ==> ~(x IN t)")] THEN
    X_GEN_TAC (← q r"w:real^N") THEN REWRITE_TAC [IN_SEGMENT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o AP_TERM (← q r"(%) (inv u):real^N->real^N")) THEN
    ASM_SIMP_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, REAL_MUL_LINV,
                 REAL_LT_IMP_NZ] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a:real^N = b + &1 % z <=> z = a - b")] THEN
    REPEAT DISCH_TAC THEN
    UNDISCH_TAC (← q r"~((z:real^N) IN span (x INSERT y INSERT span t))") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SPAN_SUB THEN CONJ_TAC THEN MATCH_MP_TAC SPAN_MUL THEN
    ASM_SIMP_TAC [SPAN_SUPERSET, IN_INSERT])

  let PATH_CONNECTED_OPEN_IN_DIFF_LOWDIM ← prove
   r"!s t:real^N->bool.
        connected s /\ open_in (subtopology euclidean (affine hull s)) s /\
        aff_dim t + &2 <= aff_dim s
        ==> path_connected(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_CONNECTED_DIFF THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"closure s:real^N->bool") THEN
      REWRITE_TAC [CLOSURE_SUBSET] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"t = s ==> s SUBSET t")) THEN
      MATCH_MP_TAC DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL THEN
      ASM_REWRITE_TAC [] THEN ASM_INT_ARITH_TAC,
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC o
         REWRITE_RULE [OPEN_IN_CONTAINS_BALL]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"ball(x:real^N,r) INTER affine hull s") THEN
      ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL, HULL_INC] THEN CONJ_TAC THENL
       [REWRITE_TAC [OPEN_IN_OPEN] THEN EXISTS_TAC (← q r"ball(x:real^N,r)") THEN
        REWRITE_TAC [OPEN_BALL] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← SET_RULE (← q r"b INTER t SUBSET s
                    ==> s SUBSET t ==> b INTER t = s INTER b"))) THEN
        REWRITE_TAC [HULL_SUBSET],
        MATCH_MP_TAC PATH_CONNECTED_CONVEX_DIFF_LOWDIM THEN
        ASM_SIMP_TAC [CONVEX_INTER, CONVEX_BALL, AFFINE_IMP_CONVEX,
                     AFFINE_AFFINE_HULL] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
          (← q r"t:int <= s ==> s' = s ==> t <= s'"))) THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM AFF_DIM_AFFINE_HULL] THEN
        ONCE_REWRITE_TAC [INTER_COMM] THEN
        MATCH_MP_TAC AFF_DIM_CONVEX_INTER_OPEN THEN
        ASM_SIMP_TAC [AFFINE_IMP_CONVEX, AFFINE_AFFINE_HULL, OPEN_BALL] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        ASM_MESON_TAC [HULL_INC, CENTRE_IN_BALL]]])

  let PATH_CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM ← prove
   r"!(s:real^N->bool) f.
        connected s /\ open_in (subtopology euclidean (affine hull s)) s /\
        FINITE f /\ (!t. t IN f ==> closed t /\ aff_dim t + &2 <= aff_dim s)
        ==> path_connected(s DIFF UNIONS f)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT DISCH_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [DISCH_THEN (K ALL_TAC : thm → tactic) THEN REWRITE_TAC [UNIONS_0, DIFF_EMPTY] THEN
      ASM_MESON_TAC [PATH_CONNECTED_EQ_CONNECTED_LPC,
                    OPEN_IN_IMP_LOCALLY_PATH_CONNECTED],
      MAP_EVERY X_GEN_TAC [← q r"t:real^N->bool", ← q r"g:(real^N->bool)->bool"] THEN
      REWRITE_TAC [FORALL_IN_INSERT, UNIONS_INSERT] THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      STRIP_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF (t UNION u) = (s DIFF u) DIFF t")] THEN
      ASM_CASES_TAC (← q r"s DIFF UNIONS g:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_EMPTY, EMPTY_DIFF] THEN
      MATCH_MP_TAC PATH_CONNECTED_OPEN_IN_DIFF_LOWDIM THEN
      ASM_SIMP_TAC [PATH_CONNECTED_IMP_CONNECTED] THEN
      SUBGOAL_THEN
       (← q r"open_in (subtopology euclidean (affine hull s))
                (s DIFF UNIONS g:real^N->bool)")
      ASSUME_TAC THENL
       [SUBGOAL_THEN
         (← q r"s DIFF UNIONS g:real^N->bool =
          s DIFF (affine hull s INTER UNIONS g)")
        SUBST1_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"s SUBSET t ==> s DIFF u = s DIFF (t INTER u)")) THEN
          REWRITE_TAC [HULL_SUBSET],
          MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC CLOSED_IN_INTER_CLOSED THEN
          REWRITE_TAC [CLOSED_IN_REFL] THEN MATCH_MP_TAC CLOSED_UNIONS THEN
          ASM_SIMP_TAC []],
        CONJ_TAC THENL
         [MATCH_MP_TAC OPEN_IN_SUBSET_TRANS THEN
          EXISTS_TAC (← q r"affine hull s:real^N->bool") THEN
          ASM_REWRITE_TAC [HULL_SUBSET] THEN
          MATCH_MP_TAC HULL_MONO THEN SET_TAC [],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
           (← q r"t:int <= s ==> u = s ==> t <= u"))) THEN
          GEN_REWRITE_TAC RAND_CONV [← GSYM AFF_DIM_AFFINE_HULL] THEN
          MATCH_MP_TAC AFF_DIM_OPEN_IN THEN
          ASM_REWRITE_TAC [AFFINE_AFFINE_HULL]]]])

  let CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM ← prove
   r"!f s:real^N->bool.
        connected s /\ open_in (subtopology euclidean (affine hull s)) s /\
        FINITE f /\ (!t. t IN f ==> aff_dim t + &2 <= aff_dim s)
        ==> connected(s DIFF UNIONS f)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
    EXISTS_TAC (← q r"s DIFF UNIONS {closure t:real^N->bool | t IN f}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC PATH_CONNECTED_IMP_CONNECTED THEN
      MATCH_MP_TAC PATH_CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM THEN
      ASM_SIMP_TAC [FORALL_IN_GSPEC, CLOSED_CLOSURE, AFF_DIM_CLOSURE] THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE],
      MATCH_MP_TAC (← SET_RULE (← q r"u SUBSET t ==> s DIFF t SUBSET s DIFF u")) THEN
      MATCH_MP_TAC UNIONS_MONO THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      MESON_TAC [CLOSURE_SUBSET],
      ASM_CASES_TAC (← q r"f:(real^N->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [UNIONS_0, ← SET_RULE (← q r"{f x |x| F} = {}"), NOT_IN_EMPTY,
                      DIFF_EMPTY, CLOSURE_SUBSET] THEN
      REWRITE_TAC [DIFF_UNIONS] THEN
      REWRITE_TAC [← SET_RULE (← q r"{f x | x IN {g y | P y}} = {f(g y) | P y}")] THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool",
                     ← q r"INTERS {s DIFF closure t:real^N->bool | t IN f}",
                     ← q r"affine hull s:real^N->bool"]
          CLOSURE_OPEN_IN_INTER_CLOSURE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"s:real^N->bool") THEN
        REWRITE_TAC [HULL_SUBSET, INTERS_GSPEC] THEN ASM SET_TAC [],
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"u SUBSET closure u /\ s = u ==> s INTER t SUBSET closure u")) THEN
      REWRITE_TAC [CLOSURE_SUBSET, ← SET_RULE (← q r"s = s INTER t <=> s SUBSET t")] THEN
      MATCH_MP_TAC DENSE_OPEN_INTERS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN REPEAT STRIP_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
        SIMP_TAC [OPEN_IN_OPEN_INTER, ← GSYM closed, CLOSED_CLOSURE],
        TRANS_TAC SUBSET_TRANS (← q r"closure s:real^N->bool") THEN
        REWRITE_TAC [CLOSURE_SUBSET] THEN
        MATCH_MP_TAC (← SET_RULE (← q r"t = s ==> s SUBSET t")) THEN
        MATCH_MP_TAC DENSE_COMPLEMENT_OPEN_IN_AFFINE_HULL THEN
        ASM_REWRITE_TAC [AFF_DIM_CLOSURE] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^N->bool")) THEN
        ASM_REWRITE_TAC [] THEN INT_ARITH_TAC]])

  return { CONNECTED_OPEN_DIFF_CBALL, PATH_CONNECTED_CONVEX_DIFF_LOWDIM,
           PATH_CONNECTED_OPEN_IN_DIFF_LOWDIM, PATH_CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM,
           CONNECTED_OPEN_IN_DIFF_UNIONS_LOWDIM }

/- ------------------------------------------------------------------------- -/
/- Bounded frontiers; interiors of arcs and simple paths; existence of       -/
/- unbounded components.  (paths.ml 13725-13928)                             -/
/- ------------------------------------------------------------------------- -/

structure PUS where
  BOUNDED_FRONTIER_BOUNDED_OR_COBOUNDED : thm
  BOUNDED_COMMON_FRONTIER_DOMAINS : thm
  INTERIOR_ARC_IMAGE : thm
  INTERIOR_SIMPLE_PATH_IMAGE : thm
  ENDPOINTS_NOT_IN_INTERIOR_SIMPLE_PATH_IMAGE : thm
  COBOUNDED_UNBOUNDED_COMPONENT : thm
  COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT : thm
  COBOUNDED_UNBOUNDED_COMPONENTS : thm
  COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS : thm
  COBOUNDED_HAS_BOUNDED_COMPONENT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUS [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BF : PTF) (BJ : PTJ)
    (BN : PTN) (BUQ : PUQ) : ExceptT String IO PUS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D.cvx
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DIFF_EMPTY, DIMINDEX_GE_1, EXISTS_IN_GSPEC,
        FINITE_EMPTY, FINITE_INSERT, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, IN, IN_DELETE,
        IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE_REFL, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        .. } := D.cvx.core3
  let { REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LT, REAL_POS, SUBSET, .. } := D.cvx.core5
  let { real_ge, .. } := D.cvx.core6
  let { BASIS_NONZERO, COMPONENT_LE_NORM, DOT_BASIS, DOT_BASIS_BASIS, DOT_RMUL, .. } :=
    D.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP,
        NORM_BASIS, .. } := D.cvx.vec2
  let { NORM_MUL, .. } := D.cvx.vec3
  let { midpoint, .. } := D.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_SUBSET, BOUNDED_SUBSET_BALL, CLOSED_EMPTY, .. } := D.cvx.top1
  let { COMPONENTS_EQ_EMPTY, CONNECTED_COMPONENT_MAXIMAL, CONNECTED_CONTINUOUS_IMAGE,
        CONNECTED_INTER_FRONTIER, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, EMPTY_INTERIOR_FINITE, ENDS_NOT_IN_SEGMENT, .. } := D.cvx.top3
  let { INTERIOR_SUBSET, IN_BALL_0, IN_INTERVAL_1, IS_INTERVAL_1, NOT_BOUNDED_UNIV, .. } :=
    D.cvx.top4
  let { bounded, components, .. } := D.cvx.top5
  let { DISJOINT_EMPTY, DISJOINT_INSERT, .. } := D.pses1
  let { BOUNDED_HALFSPACE_GE, BOUNDED_UNION, CLOSED_INSERT, CLOSED_OPEN_INTERVAL_1,
        COMMON_FRONTIER_DOMAINS, .. } := D.ptop1
  let { COMPONENTS_EQ_SING_EXISTS, CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_SYM,
        CONNECTED_COMPONENT_TRANS, .. } := D.ptop2
  let { HOMEOMORPHISM_CONNECTEDNESS, INTERIOR_UNION_EQ_EMPTY, .. } := D.ptop4
  let { connected_component, .. } := D.ptop5
  let { AFF_DIM_LE_UNIV, COLLINEAR_AFF_DIM, CONNECTED_INTERVAL, CONVEX_BALL, CONVEX_CONNECTED,
        .. } := D.pcvx1
  let { CONVEX_HALFSPACE_GE, INTERIOR_SEGMENT, IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { path, path_image, arc, .. } := BA
  let { ARC_IMP_PATH, SIMPLE_PATH_IMP_PATH, CLOSED_PATH_IMAGE, .. } := BB
  let { PATH_IMAGE_SUBPATH_COMBINE, PATH_SUBPATH, ARC_SIMPLE_PATH_SUBPATH_INTERIOR, .. } := BF
  let { HOMEOMORPHISM_ARC, .. } := BJ
  let { COLLINEAR_SIMPLE_PATH_IMAGE, .. } := BN
  let { CONNECTED_COMPLEMENT_BOUNDED_CONVEX, CONNECTED_DELETE_INTERIOR_POINT, .. } := BUQ
  -- @@SCOPE END

  let BOUNDED_FRONTIER_BOUNDED_OR_COBOUNDED ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded(frontier s)
       ==> bounded(s) \/ bounded((:real^N) DIFF s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [DE_MORGAN_THM] THEN
    STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"f SUBSET s <=> (UNIV DIFF s) INTER f = {}")] THEN
    MATCH_MP_TAC CONNECTED_INTER_FRONTIER THEN
    ASM_SIMP_TAC [CONNECTED_COMPLEMENT_BOUNDED_CONVEX, BOUNDED_BALL, CONVEX_BALL,
                 ← SET_RULE (← q r"UNIV DIFF s DIFF t = {} <=> UNIV DIFF t SUBSET s"),
                 ← SET_RULE (← q r"(UNIV DIFF s) INTER t = {} <=> t SUBSET s")] THEN
    ASM_MESON_TAC [BOUNDED_SUBSET, BOUNDED_BALL])

  let BOUNDED_COMMON_FRONTIER_DOMAINS ← prove
   r"!s t c:real^N->bool.
        2 <= dimindex(:N) /\ bounded c /\
        open s /\ connected s /\
        open t /\ connected t /\
        ~(s = t) /\ frontier s = c /\ frontier t = c
        ==> bounded s \/ bounded t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"t:real^N->bool") BOUNDED_FRONTIER_BOUNDED_OR_COBOUNDED) THEN
    MP_TAC (← ISPEC (← q r"s:real^N->bool") BOUNDED_FRONTIER_BOUNDED_OR_COBOUNDED) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (STRIP_TAC THEN ASM_REWRITE_TAC []) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool"]
          COMMON_FRONTIER_DOMAINS) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"~((UNIV DIFF s) UNION (UNIV DIFF t) = UNIV) ==> ~DISJOINT s t")) THEN
    MATCH_MP_TAC (← MESON [NOT_BOUNDED_UNIV] (← q r"bounded s ==> ~(s = (:real^N))")) THEN
    ASM_REWRITE_TAC [BOUNDED_UNION])

  let INTERIOR_ARC_IMAGE ← prove
   r"!g:real^1->real^N.
        2 <= dimindex(:N) /\ arc g ==> interior(path_image g) = {}"
   (REPEAT STRIP_TAC THEN
    SIMP_TAC [path_image, CLOSED_OPEN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
    REWRITE_TAC [IMAGE_UNION, IMAGE_CLAUSES] THEN
    SIMP_TAC [INTERIOR_UNION_EQ_EMPTY, CLOSED_INSERT, CLOSED_EMPTY] THEN
    SIMP_TAC [EMPTY_INTERIOR_FINITE, FINITE_INSERT, FINITE_EMPTY] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"(!a. ~(a IN s)) ==> s = {}")) THEN
    X_GEN_TAC (← q r"a:real^N") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
      (← REWRITE_RULE [CONJ_ASSOC] CONNECTED_DELETE_INTERIOR_POINT))) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [CONNECTED_INTERVAL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
      ASM_SIMP_TAC [INTERVAL_OPEN_SUBSET_CLOSED, ← GSYM path, ARC_IMP_PATH],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET] INTERIOR_SUBSET)) THEN
      SPEC_TAC (← q r"a:real^N", ← q r"a:real^N") THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"t:real^1") THEN
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMEOMORPHISM_ARC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^N->real^1") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"interval(vec 0,vec 1) DELETE (t:real^1)") o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHISM_CONNECTEDNESS)) THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ q /\ ~r ==> (p ==> (q <=> r)) ==> F")) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> s DELETE a SUBSET t")) THEN
        REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
         (← q r"connected s ==> s = t ==> connected t"))) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [arc]) THEN
        MP_TAC (← ISPECL [← q r"vec 0:real^1", ← q r"vec 1:real^1"]
           INTERVAL_OPEN_SUBSET_CLOSED) THEN
        ASM SET_TAC [],
        REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1] THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"midpoint(vec 0:real^1,t)",
          ← q r"midpoint(vec 1:real^1,t)", ← q r"t:real^1"]) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
        REWRITE_TAC [DROP_VEC, IN_DELETE, IN_INTERVAL_1, ← GSYM DROP_EQ,
                    midpoint, DROP_ADD, DROP_CMUL] THEN
        REAL_ARITH_TAC]])

  let INTERIOR_SIMPLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N.
        2 <= dimindex(:N) /\ simple_path g ==> interior(path_image g) = {}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"lift(&1 / &2)"]
          PATH_IMAGE_SUBPATH_COMBINE) THEN
    REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [SIMPLE_PATH_IMP_PATH] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    W (MP_TAC o PART_MATCH (lhs o rand) INTERIOR_UNION_EQ_EMPTY o snd) THEN
    ANTS_TAC THENL
     [DISJ1_TAC THEN MATCH_MP_TAC CLOSED_PATH_IMAGE THEN
      MATCH_MP_TAC PATH_SUBPATH THEN
      REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [SIMPLE_PATH_IMP_PATH],
      DISCH_THEN SUBST1_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC INTERIOR_ARC_IMAGE THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC ARC_SIMPLE_PATH_SUBPATH_INTERIOR THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC, ← GSYM DROP_EQ] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV])

  let ENDPOINTS_NOT_IN_INTERIOR_SIMPLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N.
     simple_path g
     ==> DISJOINT {pathstart g,pathfinish g} (interior(path_image g))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"2 <= dimindex(:N)") THENL
     [ASM_SIMP_TAC [INTERIOR_SIMPLE_PATH_IMAGE] THEN SET_TAC [],
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE
       (← q r"~(2 <= p) ==> 1 <= p ==> p = 1")))] THEN
    REWRITE_TAC [DIMINDEX_GE_1] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COLLINEAR_SIMPLE_PATH_IMAGE)) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [COLLINEAR_AFF_DIM] THEN ASM_MESON_TAC [AFF_DIM_LE_UNIV],
      DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [DISJOINT_INSERT, DISJOINT_EMPTY, INTERIOR_SEGMENT] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [ENDS_NOT_IN_SEGMENT, NOT_IN_EMPTY])

  let COBOUNDED_UNBOUNDED_COMPONENT ← prove
   r"!s. bounded((:real^N) DIFF s)
       ==> ?x. x IN s /\ ~bounded(connected_component s x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"B % basis 1:real^N") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B % basis 1:real^N") o
       GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_UNIV, IN_DIFF, IN_BALL_0] THEN
      SIMP_TAC [NORM_MUL, NORM_BASIS, DIMINDEX_GE_1, LE_REFL] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < B ==> ~(abs B * &1 < B)")],
      MP_TAC (← ISPECL [← q r"basis 1:real^N", ← q r"B:real"] BOUNDED_HALFSPACE_GE) THEN
      SIMP_TAC [BASIS_NONZERO, DIMINDEX_GE_1, LE_REFL, CONTRAPOS_THM] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      SIMP_TAC [CONVEX_HALFSPACE_GE, CONVEX_CONNECTED] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, DOT_RMUL, DOT_BASIS_BASIS, DIMINDEX_GE_1,
                   LE_REFL, real_ge, REAL_MUL_RID, REAL_LE_REFL] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
      (← q r"UNIV DIFF s SUBSET b ==> (!x. x IN h ==> ~(x IN b)) ==> h SUBSET s"))) THEN
      SIMP_TAC [IN_ELIM_THM, DOT_BASIS, IN_BALL_0, DIMINDEX_GE_1, LE_REFL] THEN
      GEN_TAC THEN REWRITE_TAC [REAL_NOT_LT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= n ==> b <= x ==> b <= n")) THEN
      SIMP_TAC [COMPONENT_LE_NORM, DIMINDEX_GE_1, LE_REFL]])

  let COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT ← prove
   r"!s x y:real^N.
        2 <= dimindex(:N) /\ bounded((:real^N) DIFF s) /\
        ~bounded(connected_component s x) /\
        ~bounded(connected_component s y)
        ==> connected_component s x = connected_component s y"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"vec 0:real^N") o MATCH_MP BOUNDED_SUBSET_BALL) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"ball(vec 0:real^N,B)") CONNECTED_COMPLEMENT_BOUNDED_CONVEX) THEN
    ASM_REWRITE_TAC [BOUNDED_BALL, CONVEX_BALL] THEN DISCH_TAC THEN
    MAP_EVERY
     (MP_TAC o SPEC (← q r"B:real") o REWRITE_RULE [bounded, NOT_EXISTS_THM] o ASSUME)
     [← q r"~bounded(connected_component s (y:real^N))",
      ← q r"~bounded(connected_component s (x:real^N))"] THEN
    REWRITE_TAC [NOT_FORALL_THM, IN, NOT_IMP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x':real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y':real^N") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_EQ THEN REWRITE_TAC [IN] THEN
    SUBGOAL_THEN (← q r"connected_component s (x':real^N) (y':real^N)") ASSUME_TAC THENL
     [REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"(:real^N) DIFF ball (vec 0,B)") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_DIFF, IN_UNIV]] THEN
      REWRITE_TAC [IN_BALL_0] THEN ASM_MESON_TAC [REAL_LT_IMP_LE],
      ASM_MESON_TAC [CONNECTED_COMPONENT_SYM, CONNECTED_COMPONENT_TRANS]])

  let COBOUNDED_UNBOUNDED_COMPONENTS ← prove
   r"!s. bounded ((:real^N) DIFF s) ==> ?c. c IN components s /\ ~bounded c"
   (REWRITE_TAC [components, EXISTS_IN_GSPEC, COBOUNDED_UNBOUNDED_COMPONENT])

  let COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS ← prove
   r"!s c c'.
        2 <= dimindex(:N) /\
        bounded ((:real^N) DIFF s) /\
        c IN components s /\ ~bounded c /\
        c' IN components s /\ ~bounded c'
        ==> c' = c"
   (REWRITE_TAC [components, IN_ELIM_THM] THEN
    MESON_TAC [COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT])

  let COBOUNDED_HAS_BOUNDED_COMPONENT ← prove
   r"!s. 2 <= dimindex(:N) /\ bounded((:real^N) DIFF s) /\ ~connected s
       ==> ?c. c IN components s /\ bounded c"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?c c':real^N->bool. c IN components s /\ c' IN components s /\ ~(c = c')")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"~(s = {}) /\ ~(?a. s = {a}) ==> ?x y. x IN s /\ y IN s /\ ~(x = y)")) THEN
      ASM_REWRITE_TAC [COMPONENTS_EQ_SING_EXISTS, COMPONENTS_EQ_EMPTY] THEN
      ASM_MESON_TAC [DIFF_EMPTY, NOT_BOUNDED_UNIV],
      ASM_MESON_TAC [COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS]])

  return { BOUNDED_FRONTIER_BOUNDED_OR_COBOUNDED, BOUNDED_COMMON_FRONTIER_DOMAINS,
           INTERIOR_ARC_IMAGE, INTERIOR_SIMPLE_PATH_IMAGE,
           ENDPOINTS_NOT_IN_INTERIOR_SIMPLE_PATH_IMAGE, COBOUNDED_UNBOUNDED_COMPONENT,
           COBOUNDED_UNIQUE_UNBOUNDED_COMPONENT, COBOUNDED_UNBOUNDED_COMPONENTS,
           COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS, COBOUNDED_HAS_BOUNDED_COMPONENT }

/- ------------------------------------------------------------------------- -/
/- Self-homeomorphisms shuffling points about in various ways.               -/
/- (paths.ml 13929-14161)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PUT where
  HOMEOMORPHISM_MOVING_POINT_EXISTS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUT [HolBase] (D : PathsDeps) : ExceptT String IO PUT := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_FIELD, SET_RULE, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, NORM_ARITH, GEOM_ORIGIN_TAC, .. } := D.cvx
  let { DIMINDEX_1, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, INTER_EMPTY, INTER_SUBSET, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS,
        NOT_IN_EMPTY, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_POS, REAL_DIV_REFL, .. } :=
    D.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ,
        REAL_LT_LMUL, .. } := D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_SYM, REAL_POS, REAL_SUB_LE,
        REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { SWAP_EXISTS_THM, o_DEF, o_THM, real_div, .. } := D.cvx.core6
  let { HULL_INC, .. } := D.cvx.misc
  let { DROP_VEC, EXISTS_DROP, LIFT_CMUL, LIFT_DROP, LIFT_SUB, NORM_0, .. } := D.cvx.vec2
  let { NORM_MUL, NORM_SUB, SUBSPACE_ADD, SUBSPACE_MUL, SUBSPACE_SUB, .. } := D.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_LZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO,
        dist, drop, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { BALL_EMPTY, BALL_SUBSET_CBALL, BOUNDED_BALL, BOUNDED_SUBSET, CBALL_DIFF_SPHERE,
        CENTRE_IN_BALL, CENTRE_IN_CBALL, CLOSED_CBALL, CLOSED_INTER, .. } := D.cvx.top1
  let { COMPACT_CBALL, COMPACT_INTER_CLOSED, CONTINUOUS_AT_ID, .. } := D.cvx.top2
  let { CONTINUOUS_CONST, CONTINUOUS_LIFT_NORM_COMPOSE, CONTINUOUS_MUL, CONTINUOUS_ON_ADD,
        CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_MUL, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, CONTINUOUS_SUB, .. } :=
    D.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_COMPACT, HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_SYM,
        IN_BALL_0, IN_CBALL_0, IN_INTERVAL_1, IN_SPHERE, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN_INTER, homeomorphism, .. } := D.cvx.top5
  let { BOUNDED_UNION, CBALL_DIFF_BALL, CLOSED_DIFF, .. } := D.ptop1
  let { CONNECTED_EQUIVALENCE_RELATION, CONTINUOUS_CMUL, CONTINUOUS_ON_CASES,
        CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { SPHERE_SUBSET_CBALL, .. } := D.ptop5
  let { AFFINE_AFFINE_HULL, AFFINE_IMP_SUBSPACE, CLOSED_AFFINE, .. } := D.pcvx1
  let { IVT_DECREASING_COMPONENT_1, .. } := D.pcvx2
  -- @@SCOPE END

  let HOMEOMORPHISM_MOVING_POINT_EXISTS ← prove
   r"!s t a b:real^N.
        open_in (subtopology euclidean (affine hull s)) s /\
        s SUBSET t /\ t SUBSET affine hull s /\
        connected s /\ a IN s /\ b IN s
        ==> ?f g. homeomorphism (t,t) (f,g) /\ f a = b /\
                  {x | ~(f x = x /\ g x = x)} SUBSET s /\
                  bounded {x | ~(f x = x /\ g x = x)}"
   (← do
    let lemma1 ← prove
     r"!a t r u:real^N.
          affine t /\ a IN t /\ u IN ball(a,r) INTER t
          ==> ?f g. homeomorphism (cball(a,r) INTER t,cball(a,r) INTER t)
                                  (f,g) /\
                    f(a) = u /\ (!x. x IN sphere(a,r) ==> f(x) = x)"
     (REPEAT STRIP_TAC THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"r <= &0 \/ &0 < r")) THENL
       [ASM_MESON_TAC [BALL_EMPTY, INTER_EMPTY, NOT_IN_EMPTY], ALL_TAC] THEN
      EXISTS_TAC (← q r"\x:real^N. (&1 - norm(x - a) / r) % (u - a) + x") THEN
      REWRITE_TAC [LEFT_EXISTS_AND_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPACT THEN
        ASM_SIMP_TAC [COMPACT_INTER_CLOSED, COMPACT_CBALL, CLOSED_AFFINE],
        ASM_SIMP_TAC [IN_SPHERE, ← ONCE_REWRITE_RULE [NORM_SUB] dist,
                     REAL_DIV_REFL, REAL_LT_IMP_NZ, IN_INTER] THEN
        REWRITE_TAC [real_div, VECTOR_SUB_REFL, NORM_0, REAL_MUL_LZERO] THEN
        REPEAT STRIP_TAC THEN VECTOR_ARITH_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_ID] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN REWRITE_TAC [o_DEF, LIFT_SUB] THEN
        SIMP_TAC [CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUB THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div, LIFT_CMUL] THEN
        MATCH_MP_TAC CONTINUOUS_ON_CMUL THEN
        MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x IN s) /\ (!y. y IN s ==> ?x. x IN s /\ f x = y)
          ==> IMAGE f s = s")) THEN REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH
         (← q r"(&1 - n) % (u - a) + x:real^N = a + (&1 - n) % (u - a) + (x - a)")],
        ALL_TAC] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN GEOM_ORIGIN_TAC (← q r"a:real^N") THEN
      REWRITE_TAC [IN_BALL_0, VECTOR_SUB_RZERO, IN_CBALL_0, IN_INTER] THEN
      REWRITE_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID,
                  ← VECTOR_ARITH (← q r"a + x:real^N = a + y <=> x = y"),
                  ← VECTOR_ARITH (← q r"(&1 - n) % u + a + x = (&1 - m) % u + a + y <=>
                                (n - m) % u:real^N = x - y")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x / r - y / r:real = (x - y) / r")] THENL
       [ALL_TAC,
        REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN REPEAT GEN_TAC THEN
        ASM_CASES_TAC (← q r"x:real^N = y") THEN ASM_REWRITE_TAC [] THEN
        ASM_CASES_TAC (← q r"norm(x:real^N) = norm(y:real^N)") THEN
        ASM_REWRITE_TAC [real_div, REAL_SUB_REFL, REAL_MUL_LZERO, VECTOR_MUL_LZERO,
                        ← VECTOR_ARITH (← q r"vec 0:real^N = x - y <=> x = y")] THEN
        STRIP_TAC THEN FIRST_ASSUM (MP_TAC o AP_TERM (← q r"norm:real^N->real")) THEN
        ASM_SIMP_TAC [NORM_MUL, REAL_ABS_MUL, REAL_ABS_INV] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← NORM_ARITH
         (← q r"r = norm(x - y:real^N) ==> r < abs(norm x - norm y) * &1 ==> F"))) THEN
        REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN MATCH_MP_TAC REAL_LT_LMUL THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ONCE_REWRITE_TAC [REAL_MUL_SYM]] THEN
        ASM_SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ,
                     ← REAL_ARITH (← q r"&0 < r ==> &0 < abs r")] THEN
        ASM_REAL_ARITH_TAC] THEN
      REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"subspace(t:real^N->bool)") THENL
       [ALL_TAC, ASM_MESON_TAC [AFFINE_IMP_SUBSPACE]] THEN
      ASM_SIMP_TAC [SUBSPACE_ADD, SUBSPACE_MUL] THEN
      REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(x) + norm(y) <= &1 * r ==> norm(x + y:real^N) <= r")) THEN
        ASM_SIMP_TAC [NORM_MUL, ← GSYM REAL_LE_LDIV_EQ, ← REAL_ARITH
         (← q r"(a * u + x) / r:real = a * u / r + x / r")] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"x <= &1 /\ a <= abs(&1 - x) * &1 ==> a + x <= &1")) THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_MUL_LID, REAL_LT_IMP_LE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"\a. lift((&1 - drop a) * r - norm(y - drop a % u:real^N))",
        ← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"&0", ← q r"1"]
            IVT_DECREASING_COMPONENT_1) THEN
      REWRITE_TAC [DIMINDEX_1, ← GSYM drop, LIFT_DROP, DROP_VEC] THEN
      REWRITE_TAC [REAL_POS, LE_REFL, REAL_SUB_REFL, VECTOR_MUL_LZERO] THEN
      REWRITE_TAC [REAL_SUB_RZERO, VECTOR_SUB_RZERO, REAL_MUL_LID] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"&0 * r - norm(x:real^N) <= &0")] THEN
      ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM EXISTS_DROP, IN_INTERVAL_1] THEN
      ANTS_TAC THENL
       [REPEAT STRIP_TAC THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(&1 - x) * r - b:real = r - r * x - b")] THEN
        REWRITE_TAC [LIFT_SUB, LIFT_CMUL, LIFT_DROP] THEN
        REPEAT (MATCH_MP_TAC CONTINUOUS_SUB THEN CONJ_TAC THEN
               REWRITE_TAC [CONTINUOUS_CONST]) THEN
        SIMP_TAC [CONTINUOUS_CMUL, CONTINUOUS_AT_ID] THEN
        MATCH_MP_TAC CONTINUOUS_LIFT_NORM_COMPOSE THEN
        MATCH_MP_TAC CONTINUOUS_SUB THEN REWRITE_TAC [CONTINUOUS_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_MUL THEN
        REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_AT_ID, CONTINUOUS_CONST],
        ASM_SIMP_TAC [DROP_VEC, ← REAL_FIELD
         (← q r"&0 < r ==> ((&1 - x) * r - n = &0 <=> &1 - n / r = x)")] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"a:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"y - a % u:real^N") THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL [ALL_TAC, VECTOR_ARITH_TAC] THEN
        ASM_SIMP_TAC [SUBSPACE_SUB, SUBSPACE_MUL] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ] THEN ASM_REAL_ARITH_TAC])
    let lemma2 ← prove
     r"!a t u v:real^N r.
          affine t /\ a IN t /\
          u IN ball(a,r) INTER t /\ v IN ball(a,r) INTER t
          ==> ?f g. homeomorphism (cball(a,r) INTER t,cball(a,r) INTER t)
                                  (f,g) /\ f(u) = v /\
                    !x. x IN sphere(a,r) /\ x IN t ==> f(x) = x"
     (REPEAT GEN_TAC THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"r <= &0 \/ &0 < r")) THENL
       [ASM_MESON_TAC [BALL_EMPTY, INTER_EMPTY, NOT_IN_EMPTY],
        REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"t:real^N->bool", ← q r"r:real"] lemma1) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th =>
          FIRST_ASSUM (CONJUNCTS_THEN (MP_TAC o MATCH_MP th))) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f1:real^N->real^N", ← q r"g1:real^N->real^N"] THEN
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f2:real^N->real^N", ← q r"g2:real^N->real^N"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"(f1:real^N->real^N) o (g2:real^N->real^N)") THEN
      EXISTS_TAC (← q r"(f2:real^N->real^N) o (g1:real^N->real^N)") THEN
      REWRITE_TAC [o_THM, SUBSET, IN_ELIM_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN ASM_MESON_TAC [HOMEOMORPHISM_SYM],
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, IN_INTER]) THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] CENTRE_IN_CBALL) THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN ASM SET_TAC [],
          MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] SPHERE_SUBSET_CBALL) THEN
          ASM SET_TAC []]])
    let lemma3 ← prove
     r"!a t u v:real^N r s.
        affine t /\ a IN t /\ ball(a,r) INTER t SUBSET s /\ s SUBSET t /\
        u IN ball(a,r) INTER t /\ v IN ball(a,r) INTER t
        ==> ?f g. homeomorphism (s,s) (f,g) /\ f(u) = v /\
                  {x | ~(f x = x /\ g x = x)} SUBSET ball(a,r) INTER t"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"t:real^N->bool", ← q r"u:real^N",
                     ← q r"v:real^N", ← q r"r:real"] lemma2) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:real^N->real^N", ← q r"g:real^N->real^N"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\x:real^N. if x IN ball(a,r) INTER t then f x else x") THEN
      EXISTS_TAC (← q r"\x:real^N. if x IN ball(a,r) INTER t then g x else x") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
      REWRITE_TAC [HOMEOMORPHISM, SUBSET, FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(!x:real^N. x IN ball(a,r) INTER t ==> f x IN ball(a,r)) /\
                    (!x:real^N. x IN ball(a,r) INTER t ==> g x IN ball(a,r))")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM CBALL_DIFF_SPHERE] THEN ASM SET_TAC [], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      REWRITE_TAC [IN_INTER] THEN REPEAT CONJ_TAC THEN
      TRY (X_GEN_TAC (← q r"x:real^N") THEN
          ASM_CASES_TAC (← q r"x IN ball(a:real^N,r)") THEN ASM_SIMP_TAC [] THEN
          MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] BALL_SUBSET_CBALL) THEN
          REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC []) THEN
          ASM SET_TAC []) THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"(cball(a,r) INTER t) UNION
                  ((t:real^N->bool) DIFF ball(a,r))") THEN
      (CONJ_TAC THENL
        [ALL_TAC,
         MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] BALL_SUBSET_CBALL) THEN
         ASM SET_TAC []]) THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
      ASM_SIMP_TAC [CLOSED_CBALL, CLOSED_DIFF, OPEN_BALL, CONTINUOUS_ON_ID,
               ← GSYM IN_DIFF, CBALL_DIFF_BALL, CLOSED_AFFINE, CLOSED_INTER] THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] SPHERE_SUBSET_CBALL) THEN
      MP_TAC (← ISPECL [← q r"a:real^N", ← q r"r:real"] CBALL_DIFF_BALL) THEN
      ASM SET_TAC [])
    pure (
    REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s /\ t ==> u <=>
                      p /\ q /\ r /\ s ==> t ==> u")] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q <=> p ==> p /\ q")] THEN
    MATCH_MP_TAC CONNECTED_EQUIVALENCE_RELATION THEN ASM_REWRITE_TAC [] THEN
    REPEAT CONJ_TAC THEN X_GEN_TAC (← q r"a:real^N") THENL
     [X_GEN_TAC (← q r"b:real^N") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^N->real^N") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^N") THEN
      REWRITE_TAC [HOMEOMORPHISM] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> ~(q /\ p)")] THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"c:real^N"] THEN
      MAP_EVERY (fun t => ASM_CASES_TAC t THEN ASM_REWRITE_TAC [])
       [← q r"(a:real^N) IN s", ← q r"(b:real^N) IN s", ← q r"(c:real^N) IN s"] THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f1:real^N->real^N", ← q r"g1:real^N->real^N"] THEN
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f2:real^N->real^N", ← q r"g2:real^N->real^N"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"(f2:real^N->real^N) o (f1:real^N->real^N)") THEN
      EXISTS_TAC (← q r"(g1:real^N->real^N) o (g2:real^N->real^N)") THEN
      ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [HOMEOMORPHISM_COMPOSE], ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"{x | ~(f1 x = x /\ g1 x = x)} UNION
                  {x:real^N | ~(f2 x = x /\ g2 x = x)}") THEN
      ASM_REWRITE_TAC [BOUNDED_UNION] THEN ASM SET_TAC [],
      DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^N") o CONJUNCT2) THEN ASM_SIMP_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"s INTER ball(a:real^N,r)") THEN
      ASM_SIMP_TAC [IN_INTER, CENTRE_IN_BALL, OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      X_GEN_TAC (← q r"b:real^N") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"a:real^N", ← q r"affine hull s:real^N->bool",
        ← q r"a:real^N", ← q r"b:real^N", ← q r"r:real", ← q r"t:real^N->bool"]
          lemma3) THEN
      ASM_SIMP_TAC [CENTRE_IN_BALL, AFFINE_AFFINE_HULL, HULL_INC, IN_INTER] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      ASM_MESON_TAC [BOUNDED_SUBSET, BOUNDED_BALL, INTER_SUBSET, SUBSET_TRANS]]))

  return { HOMEOMORPHISM_MOVING_POINT_EXISTS }

