      MATCH_MP_TAC HOMEOMORPHIC_DIMENSION_LE' THEN
      ASM_REWRITE_TAC [])
    let DIMENSION_LE_EQ ← prove
     r"!s:real^N->bool n.
            dimension s <= n <=>
            -- &1 <= n /\
