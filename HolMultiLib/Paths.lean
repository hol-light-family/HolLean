      SIMP_TAC [RELATIVE_TO_COMPL, SUBSET_UNION, FSIGMA_COMPLEMENT, ETA_AX] THEN
      MATCH_MP_TAC RELATIVE_TO_SUBSET_TRANS THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
