set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPXB [HolBase] (D : PathsDeps) (BL : PTL) (BVR : PVR) (BWX : PWX) (BXA : PXA) :
    ExceptT String IO PXB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D.cvx
  let { IMAGE_EQ_EMPTY, IMP_CONJ, .. } := D.cvx.core2
