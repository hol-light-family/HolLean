    SUBGOAL_THEN
     (← q r"!x y. segment(x,y) INTER t = {} ==> (h:real^1->real^N) x = h y")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"x':real^1"] THEN
