/- ------------------------------------------------------------------------- -/
/- Sufficient conditions for "semi-local connectedness"; Euclidean           -/
/- specializations of metric-space theorems; locally convex sets.            -/
/- (paths.ml 9133-9411)                                                      -/
/- ------------------------------------------------------------------------- -/

structure PTZ where
  SEMI_LOCALLY_CONNECTED : thm
  SEMI_LOCALLY_CONNECTED_GEN : thm
  SEMI_LOCALLY_CONNECTED_COMPACT : thm
  FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED_EUCLIDEAN : thm
  COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN : thm
  LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN : thm
  LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED_EUCLIDEAN : thm
  LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN : thm
  LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN : thm
  MCOMPLETE_IMP_LOCALLY_COMPACT_EUCLIDEAN : thm
  MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN : thm
  MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN : thm
  MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN : thm
  GDELTA_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED : thm
  GDELTA_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED : thm
