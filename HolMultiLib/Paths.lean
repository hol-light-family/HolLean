  let { REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO,
        REAL_SUB_REFL, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { SUBSET_UNIV, SWAP_EXISTS_THM, o_DEF, o_THM, real_div, .. } := D.cvx.core6
  let { BASIS_NONZERO, DIST_0, DIST_LIFT, .. } := D.cvx.vec1
  let { DROP_VEC, FORALL_DROP, FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, LIFT_SUB,
