      ASM_SIMP_TAC [PCROSS_MONO, SUBSET_REFL] THEN DISCH_TAC THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
        MAP_EVERY X_GEN_TAC [← q r"r:real^1", ← q r"z:real^P"] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(z:real^P) IN q'") ASSUME_TAC THENL
         [ASM SET_TAC [], ASM_REWRITE_TAC [PASTECART_IN_PCROSS]] THEN
        COND_CASES_TAC THEN REWRITE_TAC [o_THM] THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
          MATCH_MP_TAC FUN_IN_IMAGE THEN
          REWRITE_TAC [PASTECART_IN_PCROSS, IN_SING] THEN ASM SET_TAC [],
          FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET] o
            CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"IMAGE p w' = w ==> x IN w' ==> p x IN w")))],
        X_GEN_TAC (← q r"z:real^P") THEN REWRITE_TAC [PASTECART_IN_PCROSS] THEN
        DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL] THEN
        SUBGOAL_THEN (← q r"(z:real^P) IN q'") ASSUME_TAC THENL
         [ASM SET_TAC [], ASM_REWRITE_TAC [LIFT_DROP, DROP_VEC]] THEN
        SIMP_TAC [REAL_LE_DIV, REAL_POS] THEN ASM SET_TAC [],
        REWRITE_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS] THEN
        MAP_EVERY X_GEN_TAC [← q r"r:real^1", ← q r"z:real^P"] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(z:real^P) IN q'") ASSUME_TAC THENL
         [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [PASTECART_IN_PCROSS] THEN ASM SET_TAC [],
          REWRITE_TAC [o_THM] THEN CONV_TAC SYM_CONV THEN
          FIRST_X_ASSUM MATCH_MP_TAC]] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← SET_RULE (← q r"IMAGE h s SUBSET t ==> x IN s ==> h x IN t"))) THEN
      ASM_REWRITE_TAC [PASTECART_IN_PCROSS, IN_INTER] THEN
      REPEAT (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REAL_ARITH (← q r"a <= x /\ x <= b ==> b <= c ==> a <= x /\ x <= c"))) THEN
      ASM_SIMP_TAC [LIFT_DROP, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
      ASM_REWRITE_TAC [DROP_VEC, REAL_MUL_LID, REAL_OF_NUM_LE]])

  return { COVERING_SPACE_LIFT_HOMOTOPY }

/- ------------------------------------------------------------------------- -/
/- Lifting homotopic functions and paths; monodromy.  (paths.ml 24926-25194) -/
/- ------------------------------------------------------------------------- -/

structure PWU where
  COVERING_SPACE_LIFT_HOMOTOPIC_FUNCTION : thm
  COVERING_SPACE_LIFT_INESSENTIAL_FUNCTION : thm
  COVERING_SPACE_LIFT_HOMOTOPY_ALT : thm
  COVERING_SPACE_LIFT_PATH_STRONG : thm
  COVERING_SPACE_LIFT_PATH : thm
  COVERING_SPACE_LIFT_HOMOTOPIC_PATHS : thm
  COVERING_SPACE_MONODROMY : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWU [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BVE : PVE) (BVI : PVI)
    (BWR : PWR) (BWS : PWS) (BWT : PWT) : ExceptT String IO PWU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, EMPTY_SUBSET, FORALL_AND_THM, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_PCROSS, FSTCART_PASTECART, IMAGE_CLAUSES,
        IMAGE_o, IMP_CONJ, .. } := D.cvx.core2
  let { IN_IMAGE, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY,
        PASTECART_IN_PCROSS, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, SUBSET, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { LINEAR_FSTCART, LINEAR_SNDCART, .. } := D.cvx.vec2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { LINEAR_CONTINUOUS_ON, .. } := D.cvx.top4
  let { UNIT_INTERVAL_NONEMPTY, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { HOMOTOPIC_WITH_SYM, .. } := D.pmet2
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_PASTECART, .. } := D.ptop3
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE, .. } := BB
  let { HOMOTOPIC_WITH_EUCLIDEAN, HOMOTOPIC_WITH_IMP_SUBSET, .. } := BVE
  let { homotopic_paths, HOMOTOPIC_PATHS, HOMOTOPIC_PATHS_IMP_PATHFINISH, .. } := BVI
  let { COVERING_SPACE_IMP_SURJECTIVE, .. } := BWR
  let { COVERING_SPACE_LIFT_UNIQUE, .. } := BWS
  let { COVERING_SPACE_LIFT_HOMOTOPY, .. } := BWT
  -- @@SCOPE END

  let COVERING_SPACE_LIFT_HOMOTOPIC_FUNCTION ← prove
   r"!p:real^M->real^N c s f f' g u:real^P->bool.
          covering_space (c,p) s /\
          g continuous_on u /\ IMAGE g u SUBSET c /\
          (!y. y IN u ==> p(g y) = f y) /\
          homotopic_with (\x. T)
           (subtopology euclidean u,subtopology euclidean s) f f'
          ==> ?g'. g' continuous_on u /\ IMAGE g' u SUBSET c /\
                   (!y. y IN u ==> p(g' y) = f' y)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"h:real^(1,P)finite_sum->real^N")
      STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [HOMOTOPIC_WITH_EUCLIDEAN]) THEN
    FIRST_ASSUM (MP_TAC o
      ISPECL [← q r"h:real^(1,P)finite_sum->real^N",
              ← q r"g:real^P->real^M", ← q r"u:real^P->bool"] o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_HOMOTOPY)) THEN
    ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^(1,P)finite_sum->real^M")
          STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(k:real^(1,P)finite_sum->real^M) o
                (\x. pastecart (vec 1) x)") THEN
    ASM_REWRITE_TAC [IMAGE_o, o_THM] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
               CONTINUOUS_ON_ID] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
                  ENDS_IN_UNIT_INTERVAL],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"IMAGE k s SUBSET c ==> t SUBSET s ==> IMAGE k t SUBSET c"))) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
                  ENDS_IN_UNIT_INTERVAL],
      ASM_MESON_TAC [PASTECART_IN_PCROSS, ENDS_IN_UNIT_INTERVAL]])

  let COVERING_SPACE_LIFT_INESSENTIAL_FUNCTION ← prove
   r"!p:real^M->real^N c s f a u:real^P->bool.
          covering_space (c,p) s /\
          homotopic_with (\x. T)
           (subtopology euclidean u,subtopology euclidean s) f (\x. a)
          ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\
                  (!y. y IN u ==> p(g y) = f y)"
   (ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"u:real^P->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, IMAGE_CLAUSES, EMPTY_SUBSET,
                    CONTINUOUS_ON_EMPTY] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE
       [← TAUT (← q r"a /\ b /\ c /\ d /\ e ==> f <=> a /\ e ==> b /\ c /\ d ==> f")]
       COVERING_SPACE_LIFT_HOMOTOPIC_FUNCTION)) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_SUBSET) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    SUBGOAL_THEN (← q r"?b. b IN c /\ (p:real^M->real^N) b = a") CHOOSE_TAC THENL
     [ASM SET_TAC [],
      EXISTS_TAC (← q r"(\x. b):real^P->real^M")] THEN
    REWRITE_TAC [CONTINUOUS_ON_CONST] THEN ASM SET_TAC [])

  let COVERING_SPACE_LIFT_HOMOTOPY_ALT ← prove
   r"!p:real^M->real^N c s (h:real^(P,1)finite_sum->real^N) f u.
          covering_space (c,p) s /\
          h continuous_on (u PCROSS interval[vec 0,vec 1]) /\
          IMAGE h (u PCROSS interval[vec 0,vec 1]) SUBSET s /\
          (!y. y IN u ==> h (pastecart y (vec 0)) = p(f y)) /\
          f continuous_on u /\ IMAGE f u SUBSET c
          ==> ?k. k continuous_on (u PCROSS interval[vec 0,vec 1]) /\
                  IMAGE k (u PCROSS interval[vec 0,vec 1]) SUBSET c /\
                  (!y. y IN u ==> k(pastecart y (vec 0)) = f y) /\
                  (!z. z IN u PCROSS interval[vec 0,vec 1] ==> h z = p(k z))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o ISPECL
     [← q r"(h:real^(P,1)finite_sum->real^N) o
       (\z. pastecart (sndcart z) (fstcart z))",
      ← q r"f:real^P->real^M", ← q r"u:real^P->bool"] o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_HOMOTOPY)) THEN
    ASM_SIMP_TAC [o_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, LINEAR_CONTINUOUS_ON,
                 LINEAR_FSTCART, LINEAR_SNDCART] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)),
        REWRITE_TAC [IMAGE_o] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE k s SUBSET c ==> t SUBSET s ==> IMAGE k t SUBSET c")))] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, FORALL_IN_PCROSS,
               FSTCART_PASTECART, SNDCART_PASTECART],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^(1,P)finite_sum->real^M")
          STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(k:real^(1,P)finite_sum->real^M) o
                  (\z. pastecart (sndcart z) (fstcart z))") THEN
      ASM_SIMP_TAC [o_THM, FSTCART_PASTECART, SNDCART_PASTECART,
                   FORALL_IN_PCROSS, PASTECART_IN_PCROSS] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, LINEAR_CONTINUOUS_ON,
                 LINEAR_FSTCART, LINEAR_SNDCART] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)),
        REWRITE_TAC [IMAGE_o] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE k s SUBSET c ==> t SUBSET s ==> IMAGE k t SUBSET c"))),
        MAP_EVERY X_GEN_TAC [← q r"x:real^P", ← q r"t:real^1"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"pastecart (t:real^1) (x:real^P)"))] THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS,
                   FSTCART_PASTECART, SNDCART_PASTECART, FORALL_IN_PCROSS]])

  let COVERING_SPACE_LIFT_PATH_STRONG ← prove
   r"!p:real^M->real^N c s g a.
       covering_space (c,p) s /\
       path g /\ path_image g SUBSET s /\ pathstart g = p(a) /\ a IN c
       ==> ?h. path h /\ path_image h SUBSET c /\ pathstart h = a /\
               !t. t IN interval[vec 0,vec 1] ==> p(h t) = g t"
   (REWRITE_TAC [path_image, path, pathstart] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
      ISPECL [← q r"(g:real^1->real^N) o (fstcart:real^(1,P)finite_sum->real^1)",
              ← q r"(\y. a):real^P->real^M", ← q r"{arb:real^P}"] o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_HOMOTOPY)) THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, o_THM, FSTCART_PASTECART] THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [IMAGE_o, CONTINUOUS_ON_CONST] THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"IMAGE (\y. a) {b} SUBSET s <=> a IN s")] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [LINEAR_FSTCART, LINEAR_CONTINUOUS_ON] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)),
        ALL_TAC] THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_PCROSS] THEN
      SIMP_TAC [FSTCART_PASTECART] THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^(1,P)finite_sum->real^M")
          STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(k:real^(1,P)finite_sum->real^M) o (\t. pastecart t arb)") THEN
      ASM_REWRITE_TAC [o_THM, IMAGE_o] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART,
                 CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, IN_SING],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE k s SUBSET c ==> t SUBSET s ==> IMAGE k t SUBSET c"))) THEN
        SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, IN_SING],
        X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"pastecart (t:real^1) (arb:real^P)")) THEN
        ASM_SIMP_TAC [PASTECART_IN_PCROSS, FSTCART_PASTECART, IN_SING]]])

  let COVERING_SPACE_LIFT_PATH ← prove
   r"!p:real^M->real^N c s g.
       covering_space (c,p) s /\ path g /\ path_image g SUBSET s
       ==> ?h. path h /\ path_image h SUBSET c /\
               !t. t IN interval[vec 0,vec 1] ==> p(h t) = g t"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE g i SUBSET s ==> vec 0 IN i ==> g(vec 0) IN s")) o
     GEN_REWRITE_RULE LAND_CONV [path_image]) THEN
    REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    REWRITE_TAC [IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:real^M") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"p:real^M->real^N", ← q r"c:real^M->bool", ← q r"s:real^N->bool",
                  ← q r"g:real^1->real^N", ← q r"a:real^M"]
      COVERING_SPACE_LIFT_PATH_STRONG) THEN
    ASM_REWRITE_TAC [pathstart] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [])

  let COVERING_SPACE_LIFT_HOMOTOPIC_PATHS ← prove
   r"!p:real^M->real^N c s g1 g2 h1 h2.
       covering_space (c,p) s /\
       path g1 /\ path_image g1 SUBSET s /\
       path g2 /\ path_image g2 SUBSET s /\
       homotopic_paths s g1 g2 /\
       path h1 /\ path_image h1 SUBSET c /\
       (!t. t IN interval[vec 0,vec 1] ==> p(h1 t) = g1 t) /\
       path h2 /\ path_image h2 SUBSET c /\
       (!t. t IN interval[vec 0,vec 1] ==> p(h2 t) = g2 t) /\
       pathstart h1 = pathstart h2
       ==> homotopic_paths c h1 h2"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HOMOTOPIC_PATHS] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_paths]) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, pathstart, pathfinish] THEN
    DISCH_THEN (X_CHOOSE_THEN
     (← q r"h:real^(1,1)finite_sum->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o ISPECL
     [← q r"h:real^(1,1)finite_sum->real^N", ← q r"(\x. pathstart h2):real^1->real^M",
      ← q r"interval[vec 0:real^1,vec 1]"] o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_HOMOTOPY_ALT)) THEN
    ASM_SIMP_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [CONTINUOUS_ON_CONST, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [pathstart, ENDS_IN_UNIT_INTERVAL, PATHSTART_IN_PATH_IMAGE,
                    SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^(1,1)finite_sum->real^M") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [o_DEF] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q) /\ (p /\ q ==> r) ==> p /\ q /\ r")) THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o
        REWRITE_RULE [RIGHT_FORALL_IMP_THM] o
        ONCE_REWRITE_RULE [IMP_CONJ] o
        REWRITE_RULE [CONJ_ASSOC] o MATCH_MP
         (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_UNIQUE)) THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THENL
       [MAP_EVERY EXISTS_TAC [← q r"g1:real^1->real^N", ← q r"vec 0:real^1"],
        MAP_EVERY EXISTS_TAC [← q r"g2:real^1->real^N", ← q r"vec 0:real^1"]] THEN
      ASM_SIMP_TAC [ENDS_IN_UNIT_INTERVAL, UNIT_INTERVAL_NONEMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path_image, pathstart, pathfinish, path]) THEN
      ASM_REWRITE_TAC [CONNECTED_INTERVAL, pathstart, pathfinish] THEN
      REWRITE_TAC [CONJ_ASSOC] THEN
      (REPEAT CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
                 CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)),
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"IMAGE k s SUBSET c ==> t SUBSET s ==> IMAGE k t SUBSET c"))),
        ASM_MESON_TAC [PASTECART_IN_PCROSS, ENDS_IN_UNIT_INTERVAL]] THEN
       SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, FORALL_IN_PCROSS,
                FSTCART_PASTECART, SNDCART_PASTECART, ENDS_IN_UNIT_INTERVAL]),
       STRIP_TAC THEN
       REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
       REWRITE_TAC [FORALL_AND_THM] THEN CONJ_TAC THENL
        [ASM_MESON_TAC [pathstart, ENDS_IN_UNIT_INTERVAL], ALL_TAC] THEN
       FIRST_ASSUM (MATCH_MP_TAC o
        REWRITE_RULE [RIGHT_FORALL_IMP_THM] o
        ONCE_REWRITE_RULE [IMP_CONJ] o
        REWRITE_RULE [CONJ_ASSOC] o MATCH_MP
         (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_UNIQUE)) THEN
       MAP_EVERY EXISTS_TAC
        [← q r"(\x. pathfinish g1):real^1->real^N", ← q r"vec 0:real^1"] THEN
       ASM_SIMP_TAC [ENDS_IN_UNIT_INTERVAL, CONNECTED_INTERVAL] THEN
       REWRITE_TAC [CONTINUOUS_ON_CONST, pathfinish] THEN
       REPEAT CONJ_TAC THENL
        [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
         ASM_MESON_TAC [SUBSET, pathfinish, PATHFINISH_IN_PATH_IMAGE],
         GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
         MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
         SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_CONST,
                  CONTINUOUS_ON_ID] THEN
         FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
             CONTINUOUS_ON_SUBSET)) THEN
         SIMP_TAC [SUBSET, FORALL_IN_IMAGE, PASTECART_IN_PCROSS, FORALL_IN_PCROSS,
                  FSTCART_PASTECART, SNDCART_PASTECART, ENDS_IN_UNIT_INTERVAL],
         REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
         X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
         FIRST_X_ASSUM (MP_TAC o SPEC (← q r"pastecart (t:real^1) (vec 1:real^1)") o
           REWRITE_RULE [FORALL_IN_IMAGE] o GEN_REWRITE_RULE id [SUBSET]) THEN
         ASM_REWRITE_TAC [PASTECART_IN_PCROSS, ENDS_IN_UNIT_INTERVAL],
         ASM_MESON_TAC [PASTECART_IN_PCROSS, ENDS_IN_UNIT_INTERVAL],
         REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
         ASM_MESON_TAC [SUBSET, pathfinish, PATHFINISH_IN_PATH_IMAGE]]])

  let COVERING_SPACE_MONODROMY ← prove
   r"!p:real^M->real^N c s g1 g2 h1 h2.
       covering_space (c,p) s /\
       path g1 /\ path_image g1 SUBSET s /\
       path g2 /\ path_image g2 SUBSET s /\
       homotopic_paths s g1 g2 /\
       path h1 /\ path_image h1 SUBSET c /\
       (!t. t IN interval[vec 0,vec 1] ==> p(h1 t) = g1 t) /\
       path h2 /\ path_image h2 SUBSET c /\
       (!t. t IN interval[vec 0,vec 1] ==> p(h2 t) = g2 t) /\
       pathstart h1 = pathstart h2
       ==> pathfinish h1 = pathfinish h2"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP COVERING_SPACE_LIFT_HOMOTOPIC_PATHS) THEN
    REWRITE_TAC [HOMOTOPIC_PATHS_IMP_PATHFINISH])

  return { COVERING_SPACE_LIFT_HOMOTOPIC_FUNCTION, COVERING_SPACE_LIFT_INESSENTIAL_FUNCTION,
           COVERING_SPACE_LIFT_HOMOTOPY_ALT, COVERING_SPACE_LIFT_PATH_STRONG,
           COVERING_SPACE_LIFT_PATH, COVERING_SPACE_LIFT_HOMOTOPIC_PATHS,
           COVERING_SPACE_MONODROMY }

/- ------------------------------------------------------------------------- -/
/- Lifting homotopic paths; loops lift to loops.  (paths.ml 25195-25294)     -/
/- ------------------------------------------------------------------------- -/

structure PWV where
  COVERING_SPACE_LIFT_HOMOTOPIC_PATH : thm
  COVERING_SPACE_INESSENTIAL_LOOP_LIFT_IS_LOOP : thm
  COVERING_SPACE_SIMPLY_CONNECTED_LOOP_LIFT_IS_LOOP : thm
  COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL : thm
  COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWV [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BI : PTI) (BVI : PVI)
    (BVJ : PVJ) (BVR : PVR) (BWR : PWR) (BWU : PWU) : ExceptT String IO PWV := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D.cvx
  let { IMP_CONJ, .. } := D.cvx.core2
  let { MONO_EXISTS, .. } := D.cvx.core3
  let { SING_SUBSET, SUBSET, SUBSET_REFL, .. } := D.cvx.core5
  let { o_THM, .. } := D.cvx.core6
  let { SEGMENT_REFL, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { pathstart, .. } := BA
  let { PATHSTART_IN_PATH_IMAGE, .. } := BB
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH,
        LINEPATH_REFL, .. } := BI
  let { HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
        HOMOTOPIC_PATHS_SYM, .. } := BVI
  let { HOMOTOPIC_PATHS_CONTINUOUS_IMAGE, .. } := BVJ
  let { SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH, .. } := BVR
  let { covering_space, COVERING_SPACE_IMP_SURJECTIVE, .. } := BWR
  let { COVERING_SPACE_LIFT_PATH_STRONG, COVERING_SPACE_LIFT_HOMOTOPIC_PATHS,
        COVERING_SPACE_MONODROMY, .. } := BWU
  -- @@SCOPE END

  let COVERING_SPACE_LIFT_HOMOTOPIC_PATH ← prove
   r"!p:real^M->real^N c s f f' g a b.
          covering_space (c,p) s /\
          homotopic_paths s f f' /\
          path g /\ path_image g SUBSET c /\
          pathstart g = a /\ pathfinish g = b /\
          (!t. t IN interval[vec 0,vec 1] ==> p(g t) = f t)
          ==> ?g'. path g' /\ path_image g' SUBSET c /\
                   pathstart g' = a /\ pathfinish g' = b /\
                   (!t. t IN interval[vec 0,vec 1] ==> p(g' t) = f' t)"
   (ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o ISPECL [← q r"f':real^1->real^N", ← q r"a:real^M"] o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_PATH_STRONG)) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [pathstart, ENDS_IN_UNIT_INTERVAL,
                      HOMOTOPIC_PATHS_IMP_PATHSTART],
        ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g':real^1->real^M") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBST1_TAC (← SYM (← ASSUME (← q r"pathfinish g:real^M = b"))) THEN
      FIRST_ASSUM (MATCH_MP_TAC o
       MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_MONODROMY)) THEN
      MAP_EVERY EXISTS_TAC [← q r"f':real^1->real^N", ← q r"f:real^1->real^N"] THEN
      ASM_REWRITE_TAC []])

  let COVERING_SPACE_INESSENTIAL_LOOP_LIFT_IS_LOOP ← prove
   r"!p:real^M->real^N c s g h a.
          covering_space (c,p) s /\
          path g /\ path_image g SUBSET s /\ pathfinish g = pathstart g /\
          homotopic_paths s g (linepath(a,a)) /\
          path h /\ path_image h SUBSET c /\
          (!t. t IN interval[vec 0,vec 1] ==> p(h t) = g t)
          ==> pathfinish h = pathstart h"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
    REWRITE_TAC [PATHSTART_LINEPATH] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      ISPECL [← q r"g:real^1->real^N", ← q r"linepath(a:real^N,a)",
              ← q r"h:real^1->real^M", ← q r"linepath(pathstart h:real^M,pathstart h)"] o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_MONODROMY)) THEN
    ASM_REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
    ASM_REWRITE_TAC [SING_SUBSET, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [LINEPATH_REFL] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET],
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      REWRITE_TAC [pathstart] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [ENDS_IN_UNIT_INTERVAL]])

  let COVERING_SPACE_SIMPLY_CONNECTED_LOOP_LIFT_IS_LOOP ← prove
   r"!p:real^M->real^N c s g h.
          covering_space (c,p) s /\ simply_connected s /\
          path g /\ path_image g SUBSET s /\ pathfinish g = pathstart g /\
          path h /\ path_image h SUBSET c /\
          (!t. t IN interval[vec 0,vec 1] ==> p(h t) = g t)
          ==> pathfinish h = pathstart h"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_INESSENTIAL_LOOP_LIFT_IS_LOOP)) THEN
    EXISTS_TAC (← q r"g:real^1->real^N") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH])

  let COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL ← prove
   r"!p:real^M->real^N c s g h.
          covering_space (c,p) s /\
          path g /\ path_image g SUBSET c /\
          path h /\ path_image h SUBSET c /\
          pathstart g = pathstart h /\
          homotopic_paths s (p o g) (p o h)
          ==> homotopic_paths c g h"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_HOMOTOPIC_PATHS)) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(p:real^M->real^N) o (g:real^1->real^M)",
      ← q r"(p:real^M->real^N) o (h:real^1->real^M)"] THEN
    ASM_REWRITE_TAC [o_THM] THEN
    ASM_MESON_TAC [HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET])

  let COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL_EQ ← prove
   r"!p:real^M->real^N c s g h.
          covering_space (c,p) s /\
          path g /\ path_image g SUBSET c /\
          path h /\ path_image h SUBSET c /\
          pathstart g = pathstart h
          ==> (homotopic_paths s (p o g) (p o h) <=> homotopic_paths c g h)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL], DISCH_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_CONTINUOUS_IMAGE THEN
    EXISTS_TAC (← q r"c:real^M->bool") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
    ASM_REWRITE_TAC [SUBSET_REFL])

  return { COVERING_SPACE_LIFT_HOMOTOPIC_PATH, COVERING_SPACE_INESSENTIAL_LOOP_LIFT_IS_LOOP,
           COVERING_SPACE_SIMPLY_CONNECTED_LOOP_LIFT_IS_LOOP,
           COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL, COVERING_SPACE_HOMOTOPIC_PATHS_CANCEL_EQ }

/- ------------------------------------------------------------------------- -/
/- Lifting of general functions to covering space.  (paths.ml 25296-25642)   -/
/- ------------------------------------------------------------------------- -/

structure PWW where
  COVERING_SPACE_LIFT_GENERAL : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPWW [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BD : PTD) (BI : PTI)
    (BK : PTK) (BS : PTS) (BVI : PVI) (BWR : PWR) (BWS : PWS) (BWU : PWU) (BWV : PWV) :
    ExceptT String IO PWW := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D.cvx
  let { EXTENSION, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.cvx.core3
  let { REAL_NOT_LE, REAL_NOT_LT, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, .. } := D.cvx.vec2
  let { VECTOR_MUL_RZERO, .. } := D.cvx.vec4
  let { OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_TRANS, .. } := D.cvx.met
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } :=
    D.cvx.top3
  let { IN_INTERVAL_1, IS_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, SEGMENT_REFL, homeomorphism, open_in, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CONTINUOUS_ON_CMUL, .. } := D.ptop2
  let { CONTINUOUS_ON_OPEN_GEN, .. } := D.ptop3
  let { SUBSET_INTERVAL_1, .. } := D.ptop5
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { IS_INTERVAL_CONNECTED_1, .. } := D.pcvx2
  let { path, pathstart, pathfinish, path_image, reversepath, joinpaths, PATH_EQ,
        PATH_CONTINUOUS_IMAGE, .. } := BA
  let { PATHFINISH_IN_PATH_IMAGE, PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
        PATH_IMAGE_COMPOSE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_JOIN_IMP,
        SUBSET_PATH_IMAGE_JOIN, .. } := BC
  let { PATH_JOIN_EQ, .. } := BD
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH,
        LINEPATH_REFL, .. } := BI
  let { path_connected, .. } := BK
  let { LOCALLY_PATH_CONNECTED, .. } := BS
  let { HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET, HOMOTOPIC_PATHS_SYM, .. } := BVI
  let { covering_space, .. } := BWR
  let { COVERING_SPACE_LIFT_UNIQUE, .. } := BWS
  let { COVERING_SPACE_LIFT_PATH_STRONG, .. } := BWU
  let { COVERING_SPACE_LIFT_HOMOTOPIC_PATH, .. } := BWV
  -- @@SCOPE END

  let COVERING_SPACE_LIFT_GENERAL ← prove
   r"!p:real^M->real^N c s f:real^P->real^N u a z.
          covering_space (c,p) s /\ a IN c /\ z IN u /\
          path_connected u /\ locally path_connected u /\
          f continuous_on u /\ IMAGE f u SUBSET s /\ f z = p a /\
          (!r. path r /\ path_image r SUBSET u /\
               pathstart r = z /\ pathfinish r = z
               ==> ?q. path q /\ path_image q SUBSET c /\
                       pathstart q = a /\ pathfinish q = a /\
                       homotopic_paths s (f o r) (p o q))
          ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\ g z = a /\
                  (!y. y IN u ==> p(g y) = f y)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!y. y IN u
          ==> ?g h. path g /\ path_image g SUBSET u /\
                    pathstart g = z /\ pathfinish g = y /\
                    path h /\ path_image h SUBSET c /\ pathstart h = a /\
                    (!t. t IN interval[vec 0,vec 1]
                         ==> (p:real^M->real^N)(h t) = (f:real^P->real^N)(g t))")
     (LABEL_TAC "*")
    THENL
     [X_GEN_TAC (← q r"y:real^P") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"z:real^P", ← q r"y:real^P"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"g:real^1->real^P") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COVERING_SPACE_LIFT_PATH_STRONG THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [← GSYM o_DEF] THEN
      ASM_REWRITE_TAC [PATH_IMAGE_COMPOSE, PATHSTART_COMPOSE] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        ASM SET_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?l. !y g h. path g /\ path_image g SUBSET u /\
                  pathstart g = z /\ pathfinish g = y /\
                  path h /\ path_image h SUBSET c /\ pathstart h = a /\
                  (!t. t IN interval[vec 0,vec 1]
                       ==> (p:real^M->real^N)(h t) = (f:real^P->real^N)(g t))
                  ==> pathfinish h = l y")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM SKOLEM_THM] THEN X_GEN_TAC (← q r"y:real^P") THEN
      MATCH_MP_TAC (← MESON []
        (← q r"(!g h g' h'. P g h /\ P g' h' ==> f h = f h')
         ==> ?z. !g h. P g h ==> f h = z")) THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g ++ reversepath g'):real^1->real^P")) THEN
      ASM_SIMP_TAC [PATH_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_REVERSEPATH, PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
        SUBSET_PATH_IMAGE_JOIN, PATH_IMAGE_REVERSEPATH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->real^M") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o
       ISPECL [← q r"(p:real^M->real^N) o (q:real^1->real^M)",
               ← q r"(f:real^P->real^N) o (g ++ reversepath g')",
               ← q r"q:real^1->real^M", ← q r"pathstart q:real^M",
               ← q r"pathfinish q:real^M"] o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← ONCE_REWRITE_RULE [HOMOTOPIC_PATHS_SYM]
           COVERING_SPACE_LIFT_HOMOTOPIC_PATH))) THEN
      ASM_REWRITE_TAC [o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q':real^1->real^M") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"path(h ++ reversepath h':real^1->real^M)") MP_TAC THENL
       [ALL_TAC,
        ASM_SIMP_TAC [PATH_JOIN_EQ, PATH_REVERSEPATH, PATHSTART_REVERSEPATH]] THEN
      MATCH_MP_TAC PATH_EQ THEN EXISTS_TAC (← q r"q':real^1->real^M") THEN
      ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"t:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      STRIP_TAC THEN REWRITE_TAC [joinpaths] THEN COND_CASES_TAC THENL
       [FIRST_ASSUM (MP_TAC o
          ISPECL [← q r"(f:real^P->real^N) o (g:real^1->real^P) o (\t. &2 % t)",
                  ← q r"q':real^1->real^M",
                  ← q r"(h:real^1->real^M) o (\t. &2 % t)",
                  ← q r"interval[vec 0,lift(&1 / &2)]",
                  ← q r"vec 0:real^1", ← q r"t:real^1"] o
          MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_UNIQUE)) THEN
        REWRITE_TAC [o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
          EXISTS_TAC (← q r"(f:real^P->real^N) o (g ++ reversepath g')") THEN
          CONJ_TAC THENL
           [SIMP_TAC [IN_INTERVAL_1, LIFT_DROP, joinpaths, o_THM],
            ALL_TAC] THEN
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN CONJ_TAC THENL
           [ASM_MESON_TAC [HOMOTOPIC_PATHS_IMP_PATH, path],
            REWRITE_TAC [SUBSET_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
            REAL_ARITH_TAC],
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
           (← q r"path_image ((f:real^P->real^N) o (g ++ reversepath g'))") THEN
          CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMOTOPIC_PATHS_IMP_SUBSET]] THEN
          REWRITE_TAC [path_image] THEN MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s ==> f x = g x) /\ s SUBSET t
            ==> IMAGE f s SUBSET IMAGE g t")) THEN
          REWRITE_TAC [SUBSET_INTERVAL_1, LIFT_DROP, DROP_VEC, IN_INTERVAL_1] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN SIMP_TAC [joinpaths, o_THM],
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          ASM_REWRITE_TAC [← GSYM path] THEN
          REWRITE_TAC [SUBSET_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
           (← q r"path_image(q':real^1->real^M)") THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [path_image] THEN
          MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"t':real^1") THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (fun th =>
           W (MP_TAC o PART_MATCH (lhand o rand) th o rand o snd)) THEN
          ASM_SIMP_TAC [IN_INTERVAL_1, joinpaths, DROP_VEC] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, SIMP_TAC []],
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID] THEN
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          ASM_SIMP_TAC [← GSYM path] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, LIFT_DROP] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"path_image(h:real^1->real^M)") THEN
          CONJ_TAC THENL [ALL_TAC, ASM_SIMP_TAC []] THEN
          REWRITE_TAC [path_image, IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1] THEN
          REWRITE_TAC [DROP_VEC, DROP_CMUL, LIFT_DROP] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"t':real^1") THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN STRIP_TAC THEN
          CONV_TAC SYM_CONV THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL] THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [CONNECTED_INTERVAL],
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN REAL_ARITH_TAC,
          GEN_REWRITE_TAC LAND_CONV [← GSYM pathstart] THEN
          ASM_REWRITE_TAC [] THEN
          SUBST1_TAC (← SYM (← ASSUME (← q r"pathstart h:real^M = a"))) THEN
          REWRITE_TAC [pathstart] THEN AP_TERM_TAC THEN
          REWRITE_TAC [VECTOR_MUL_RZERO],
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
          ASM_REAL_ARITH_TAC],
        FIRST_ASSUM (MP_TAC o
          ISPECL [← q r"(f:real^P->real^N) o reversepath(g':real^1->real^P) o
                   (\t. &2 % t - vec 1)",
                  ← q r"q':real^1->real^M",
                  ← q r"reversepath(h':real^1->real^M) o (\t. &2 % t - vec 1)",
                  ← q r"{t | &1 / &2 < drop t /\ drop t <= &1}",
                  ← q r"vec 1:real^1", ← q r"t:real^1"] o
          MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_UNIQUE)) THEN
        REWRITE_TAC [o_THM] THEN DISCH_THEN MATCH_MP_TAC THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
          EXISTS_TAC (← q r"(f:real^P->real^N) o (g ++ reversepath g')") THEN
          CONJ_TAC THENL
           [SIMP_TAC [IN_ELIM_THM, ← GSYM REAL_NOT_LE, joinpaths, o_THM],
            ALL_TAC] THEN
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN CONJ_TAC THENL
           [ASM_MESON_TAC [HOMOTOPIC_PATHS_IMP_PATH, path],
            REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
            REAL_ARITH_TAC],
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
           (← q r"path_image ((f:real^P->real^N) o (g ++ reversepath g'))") THEN
          CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMOTOPIC_PATHS_IMP_SUBSET]] THEN
          REWRITE_TAC [path_image] THEN MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN s ==> f x = g x) /\ s SUBSET t
            ==> IMAGE f s SUBSET IMAGE g t")) THEN
          SIMP_TAC [IN_ELIM_THM, ← GSYM REAL_NOT_LE, joinpaths, o_THM] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          ASM_REWRITE_TAC [← GSYM path] THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
           (← q r"path_image(q':real^1->real^M)") THEN
          ASM_REWRITE_TAC [] THEN REWRITE_TAC [path_image] THEN
          MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"t':real^1") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (fun th =>
           W (MP_TAC o PART_MATCH (lhand o rand) th o rand o snd)) THEN
          ASM_SIMP_TAC [IN_INTERVAL_1, joinpaths, DROP_VEC, ← GSYM REAL_NOT_LT] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, SIMP_TAC []],
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID,
                   CONTINUOUS_ON_CONST] THEN
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          ASM_SIMP_TAC [← GSYM path, PATH_REVERSEPATH] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"path_image(reversepath h':real^1->real^M)") THEN
          CONJ_TAC THENL [ALL_TAC, ASM_SIMP_TAC [PATH_IMAGE_REVERSEPATH]] THEN
          REWRITE_TAC [path_image, IMAGE_o] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
          REAL_ARITH_TAC,
          X_GEN_TAC (← q r"t':real^1") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
          REWRITE_TAC [reversepath] THEN CONV_TAC SYM_CONV THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, DROP_CMUL] THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1, IS_INTERVAL_1] THEN
          REWRITE_TAC [IN_ELIM_THM] THEN REAL_ARITH_TAC,
          REWRITE_TAC [IN_ELIM_THM, DROP_VEC] THEN REAL_ARITH_TAC,
          GEN_REWRITE_TAC LAND_CONV [← GSYM pathfinish] THEN
          ASM_REWRITE_TAC [reversepath] THEN
          SUBST1_TAC (← SYM (← ASSUME (← q r"pathstart h':real^M = a"))) THEN
          REWRITE_TAC [pathstart] THEN AP_TERM_TAC THEN
          REWRITE_TAC [← GSYM DROP_EQ, DROP_SUB, DROP_CMUL, DROP_VEC] THEN
          REAL_ARITH_TAC,
          REWRITE_TAC [IN_ELIM_THM] THEN ASM_REAL_ARITH_TAC]],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^P->real^M") THEN
    DISCH_THEN (LABEL_TAC "+") THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")) THEN REPEAT CONJ_TAC THENL
     [STRIP_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"y:real^P") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^P")) THEN
      ASM_MESON_TAC [PATHFINISH_IN_PATH_IMAGE, SUBSET],
      FIRST_ASSUM (MP_TAC o SPECL
       [← q r"z:real^P", ← q r"linepath(z:real^P,z)", ← q r"linepath(a:real^M,a)"]) THEN
      REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
      REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      ASM_SIMP_TAC [LINEPATH_REFL, SING_SUBSET],
      X_GEN_TAC (← q r"y:real^P") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^P")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^P", ← q r"h:real^1->real^M"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"y:real^P", ← q r"g:real^1->real^P", ← q r"h:real^1->real^M"]) THEN
      ASM_MESON_TAC [pathfinish, ENDS_IN_UNIT_INTERVAL]] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC id [← MATCH_MP CONTINUOUS_ON_OPEN_GEN th])) THEN
    X_GEN_TAC (← q r"n:real^M->bool") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"y:real^P") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"(f:real^P->real^N) y") (← liftExcept (last (CONJUNCTS
        (← GEN_REWRITE_RULE id [covering_space] th))))))) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"vv:(real^M->bool)->bool") MP_TAC) THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN
    GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(l:real^P->real^M) y")) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w':real^M->bool") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"w':real^M->bool")) MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"w':real^M->bool") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"p':real^N->real^M")) THEN
    DISCH_TAC THEN UNDISCH_THEN (← q r"(w':real^M->bool) IN vv")
      (K ALL_TAC : thm → tactic) THEN
    SUBGOAL_THEN
     (← q r"?v. y IN v /\ y IN u /\ IMAGE (f:real^P->real^N) v SUBSET w /\
          v SUBSET u /\ path_connected v /\ open_in (subtopology euclidean u) v")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_PATH_CONNECTED]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"{x | x IN u /\ (f:real^P->real^N) x IN w}", ← q r"y:real^P"]) THEN
      ANTS_TAC THENL [ALL_TAC, MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o
     GEN_REWRITE_RULE id [homeomorphism]) THEN
    SUBGOAL_THEN (← q r"(w':real^M->bool) SUBSET c /\ (w:real^N->bool) SUBSET s")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [open_in], ALL_TAC] THEN
    EXISTS_TAC
     (← q r"v INTER
      {x | x IN u /\ (f:real^P->real^N) x IN
                     {x | x IN w /\ (p':real^N->real^M) x IN w' INTER n}}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"w:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"w':real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
      UNDISCH_TAC (← q r"open_in (subtopology euclidean c) (n:real^M->bool)") THEN
      REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
      ASM SET_TAC [],
      ALL_TAC] THEN
    SIMP_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"y':real^P") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"y:real^P", ← q r"y':real^P"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^1->real^P") STRIP_ASSUME_TAC) THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^P")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"pp:real^1->real^P", ← q r"qq:real^1->real^M"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPECL
     [← q r"y':real^P", ← q r"(pp:real^1->real^P) ++ r",
      ← q r"(qq:real^1->real^M) ++ ((p':real^N->real^M) o (f:real^P->real^N) o
                              (r:real^1->real^P))"]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"y:real^P", ← q r"pp:real^1->real^P", ← q r"qq:real^1->real^M"]) THEN
    ASM_SIMP_TAC [o_THM, PATHSTART_JOIN, PATHFINISH_JOIN] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"path_image ((pp:real^1->real^P) ++ r) SUBSET u")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN ASM SET_TAC [], ALL_TAC] THEN
    ANTS_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [PATHFINISH_COMPOSE] THEN ASM_MESON_TAC []] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [PATH_JOIN],
      ASM_SIMP_TAC [SUBSET_PATH_IMAGE_JOIN],
      MATCH_MP_TAC PATH_JOIN_IMP THEN ASM_SIMP_TAC [PATHSTART_COMPOSE] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [o_ASSOC] THEN MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        CONJ_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
               CONTINUOUS_ON_SUBSET)) THEN
        ASM SET_TAC [],
        REWRITE_TAC [pathfinish] THEN ASM SET_TAC []],
      MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN ASM_SIMP_TAC [] THEN
      REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"tt:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      STRIP_TAC THEN REWRITE_TAC [joinpaths, o_THM] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [] THENL
       [ABBREV_TAC (← q r"t:real^1 = &2 % tt"),
        ABBREV_TAC (← q r"t:real^1 = &2 % tt - vec 1")] THEN
      (SUBGOAL_THEN (← q r"t IN interval[vec 0:real^1,vec 1]") ASSUME_TAC THENL
        [EXPAND_TAC "t" THEN
         REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
         ASM_REAL_ARITH_TAC,
         ALL_TAC]) THEN
      ASM_SIMP_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN ASM SET_TAC []])

  return { COVERING_SPACE_LIFT_GENERAL }

/- ------------------------------------------------------------------------- -/
/- Lifting corollaries; additional lemmas about covering spaces.             -/
/- (paths.ml 25643-25851)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWX where
  COVERING_SPACE_LIFT_STRONGER : thm
  COVERING_SPACE_LIFT_STRONG : thm
  COVERING_SPACE_LIFT : thm
  CARD_EQ_COVERING_MAP_FIBRES : thm
  COVERING_SPACE_INJECTIVE : thm
  COVERING_SPACE_HOMEOMORPHISM : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWX [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BI : PTI) (BK : PTK)
    (BVI : PVI) (BVJ : PVJ) (BVR : PVR) (BWR : PWR) (BWS : PWS) (BWU : PWU) (BWW : PWW) :
    ExceptT String IO PWX := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, SET_TAC, .. } := D.cvx
  let { CONJ_SYM, EMPTY_SUBSET, EQ_IMP, EQ_TRANS, ETA_AX, EXTENSION, FORALL_AND_THM, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_CLAUSES, IMP_CONJ, IMP_IMP, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL,
        NOT_IN_EMPTY, .. } := D.cvx.core3
  let { RIGHT_EXISTS_IMP_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET,
        SKOLEM_THM, SUBSET, .. } := D.cvx.core5
  let { SWAP_FORALL_THM, le_c, o_DEF, o_THM, .. } := D.cvx.core6
  let { DROP_SUB, DROP_VEC, .. } := D.cvx.vec2
  let { CONTINUOUS_ON_SUBSET, .. } := D.cvx.top3
  let { IN_INTERVAL_1, .. } := D.cvx.top4
  let { SEGMENT_REFL, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CARD_LE_ANTISYM, .. } := D.pcard
  let { CONTINUOUS_ON_EMPTY, CONTINUOUS_ON_SING, .. } := D.ptop3
  let { HOMEOMORPHISM_INJECTIVE_OPEN_MAP, .. } := D.ptop4
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { path, pathstart, pathfinish, path_image, reversepath, PATH_CONTINUOUS_IMAGE, .. } := BA
  let { PATHSTART_COMPOSE, PATHFINISH_COMPOSE, PATH_IMAGE_COMPOSE, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATH_IMAGE_REVERSEPATH,
        PATH_REVERSEPATH, .. } := BC
  let { PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_LINEPATH, PATH_IMAGE_LINEPATH,
        LINEPATH_REFL, .. } := BI
  let { path_connected, .. } := BK
  let { HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_REFL, .. } := BVI
  let { HOMOTOPIC_PATHS_CONTINUOUS_IMAGE, .. } := BVJ
  let { SIMPLY_CONNECTED_IMP_PATH_CONNECTED, SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS, .. } := BVR
  let { COVERING_SPACE_IMP_CONTINUOUS, COVERING_SPACE_IMP_SURJECTIVE,
        COVERING_SPACE_OPEN_MAP, .. } := BWR
  let { COVERING_SPACE_LIFT_UNIQUE, .. } := BWS
  let { COVERING_SPACE_LIFT_PATH_STRONG, COVERING_SPACE_MONODROMY, .. } := BWU
  let { COVERING_SPACE_LIFT_GENERAL, .. } := BWW
  -- @@SCOPE END

  let COVERING_SPACE_LIFT_STRONGER ← prove
   r"!p:real^M->real^N c s f:real^P->real^N u a z.
          covering_space (c,p) s /\ a IN c /\ z IN u /\
          path_connected u /\ locally path_connected u /\
          f continuous_on u /\ IMAGE f u SUBSET s /\ f z = p a /\
          (!r. path r /\ path_image r SUBSET u /\
               pathstart r = z /\ pathfinish r = z
               ==> ?b. homotopic_paths s (f o r) (linepath(b,b)))
          ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\ g z = a /\
                  (!y. y IN u ==> p(g y) = f y)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_GENERAL)) THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"r:real^1->real^P") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:real^1->real^P")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"b:real^N")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
    ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHSTART_LINEPATH] THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    EXISTS_TAC (← q r"linepath(a:real^M,a)") THEN
    REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [o_DEF, LINEPATH_REFL]) THEN
    ASM_REWRITE_TAC [o_DEF, LINEPATH_REFL])

  let COVERING_SPACE_LIFT_STRONG ← prove
   r"!p:real^M->real^N c s f:real^P->real^N u a z.
          covering_space (c,p) s /\ a IN c /\ z IN u /\
          simply_connected u /\ locally path_connected u /\
          f continuous_on u /\ IMAGE f u SUBSET s /\ f z = p a
          ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\ g z = a /\
                  (!y. y IN u ==> p(g y) = f y)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_STRONGER)) THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_IMP_PATH_CONNECTED] THEN
    X_GEN_TAC (← q r"r:real^1->real^P") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(f:real^P->real^N) z") THEN
    SUBGOAL_THEN
     (← q r"linepath(f z,f z) = (f:real^P->real^N) o linepath(z,z)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF, LINEPATH_REFL], ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_CONTINUOUS_IMAGE THEN
    EXISTS_TAC (← q r"u:real^P->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id
     [SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS]) THEN
    ASM_REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET])

  let COVERING_SPACE_LIFT ← prove
   r"!p:real^M->real^N c s f:real^P->real^N u.
          covering_space (c,p) s /\
          simply_connected u /\ locally path_connected u /\
          f continuous_on u /\ IMAGE f u SUBSET s
          ==> ?g. g continuous_on u /\ IMAGE g u SUBSET c /\
                  (!y. y IN u ==> p(g y) = f y)"
   (MP_TAC COVERING_SPACE_LIFT_STRONG THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th THEN ASM_REWRITE_TAC []) THEN
    ASM_CASES_TAC (← q r"u:real^P->bool = {}") THEN
    ASM_REWRITE_TAC [CONTINUOUS_ON_EMPTY, IMAGE_CLAUSES, EMPTY_SUBSET,
                    NOT_IN_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real^P")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    GEN_REWRITE_TAC LAND_CONV [EXTENSION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^P->real^N) a")) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_IMAGE]] THEN
    ASM_MESON_TAC [])

  /- ----------------------------------------------------------------------- -/
  /- Some additional lemmas about covering spaces.                           -/
  /- ----------------------------------------------------------------------- -/

  let CARD_EQ_COVERING_MAP_FIBRES ← prove
   r"!p:real^M->real^N c s a b.
          covering_space (c,p) s /\ path_connected s /\ a IN s /\ b IN s
          ==> {x | x IN c /\ p(x) = a} =_c {x | x IN c /\ p(x) = b}"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
    REWRITE_TAC [← GSYM CARD_LE_ANTISYM] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, FORALL_AND_THM,
                ← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    GEN_REWRITE_TAC (LAND_CONV o funpow 2 BINDER_CONV o LAND_CONV)
     [CONJ_SYM] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!a b. P a b) ==> (!a b. P a b) /\ (!a b. P b a)")) THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"] o
      GEN_REWRITE_RULE id [path_connected]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^1->real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!z. ?h. z IN c /\ p z = a
              ==> path h /\ path_image h SUBSET c /\ pathstart h = z /\
                  !t. t IN interval[vec 0,vec 1]
                      ==> (p:real^M->real^N)(h t) = g t")
    MP_TAC THENL
     [REWRITE_TAC [RIGHT_EXISTS_IMP_THM] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_LIFT_PATH_STRONG THEN
      REWRITE_TAC [ETA_AX] THEN ASM_MESON_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"h:real^M->real^1->real^M") THEN DISCH_TAC] THEN
    REWRITE_TAC [le_c, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"\z. pathfinish((h:real^M->real^1->real^M) z)") THEN
    ASM_REWRITE_TAC [pathfinish] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN
      ASM_REWRITE_TAC [SUBSET, path_image, pathstart, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [pathfinish, ENDS_IN_UNIT_INTERVAL],
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"y:real^M"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"p:real^M->real^N", ← q r"c:real^M->bool", ← q r"s:real^N->bool",
        ← q r"reversepath(g:real^1->real^N)", ← q r"reversepath(g:real^1->real^N)",
        ← q r"reversepath((h:real^M->real^1->real^M) x)",
        ← q r"reversepath((h:real^M->real^1->real^M) y)"]
      COVERING_SPACE_MONODROMY) THEN
      ASM_SIMP_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH,
                   HOMOTOPIC_PATHS_REFL] THEN
      ASM_REWRITE_TAC [pathfinish, reversepath, IN_INTERVAL_1, DROP_VEC] THEN
      REPEAT STRIP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")),
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^M"))] THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => tactic_of do
        pure (MATCH_MP_TAC (← liftExcept (last (CONJUNCTS th))))) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN ASM_REAL_ARITH_TAC])

  let COVERING_SPACE_INJECTIVE ← prove
   r"!p:real^M->real^N c s.
          covering_space (c,p) s /\ path_connected c /\ simply_connected s
          ==> (!x y. x IN c /\ y IN c /\ p x = p y ==> x = y)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COVERING_SPACE_IMP_CONTINUOUS) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"y:real^M"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^M") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_PATH_STRONG)) THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"(p:real^M->real^N) o (g:real^1->real^M)") th) THEN
            MP_TAC (← SPEC (← q r"(p:real^M->real^N) o linepath(x:real^M,x)") th))) THEN
    SUBGOAL_THEN
     (← q r"(path ((p:real^M->real^N) o linepath(x,x)) /\
       path (p o g)) /\
      (path_image (p o linepath(x:real^M,x)) SUBSET s /\
       path_image (p o g) SUBSET s)")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_SING, SEGMENT_REFL] THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        REWRITE_TAC [PATH_IMAGE_COMPOSE, PATH_IMAGE_LINEPATH] THEN
        REWRITE_TAC [SEGMENT_REFL] THEN ASM SET_TAC []],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHSTART_LINEPATH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h1:real^1->real^M") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h2:real^1->real^M") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o
      SPECL [← q r"(p:real^M->real^N) o linepath(x:real^M,x)",
             ← q r"(p:real^M->real^N) o (g:real^1->real^M)",
             ← q r"h1:real^1->real^M", ← q r"h2:real^1->real^M"] o
    MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_MONODROMY)) THEN
    ASM_SIMP_TAC [] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
          GEN_REWRITE_RULE id [SIMPLY_CONNECTED_EQ_HOMOTOPIC_PATHS]) THEN
      ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
      ASM_REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH],
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
     [MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"pathfinish(linepath(x:real^M,x))") THEN
      CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [PATHFINISH_LINEPATH]],
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th]))] THEN
    REWRITE_TAC [pathfinish] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_UNIQUE))
    THENL
     [EXISTS_TAC (← q r"(p:real^M->real^N) o (h1:real^1->real^M)"),
      EXISTS_TAC (← q r"(p:real^M->real^N) o (h2:real^1->real^M)")] THEN
    MAP_EVERY EXISTS_TAC [← q r"interval[vec 0:real^1,vec 1]", ← q r"vec 0:real^1"] THEN
    REWRITE_TAC [CONNECTED_INTERVAL, ENDS_IN_UNIT_INTERVAL] THEN
    ASM_REWRITE_TAC [← GSYM path, PATH_LINEPATH, ← GSYM path_image] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [o_THM]) THEN ASM_REWRITE_TAC [o_THM] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL, SING_SUBSET] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart]) THEN
    ASM_REWRITE_TAC [LINEPATH_REFL, PATH_IMAGE_COMPOSE] THEN
    (CONJ_TAC THENL
      [ASM_MESON_TAC [PATH_CONTINUOUS_IMAGE, CONTINUOUS_ON_SUBSET],
       ASM SET_TAC []]))

  let COVERING_SPACE_HOMEOMORPHISM ← prove
   r"!p:real^M->real^N c s.
          covering_space (c,p) s /\ path_connected c /\ simply_connected s
          ==> ?q. homeomorphism (c,s) (p,q)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHISM_INJECTIVE_OPEN_MAP THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [COVERING_SPACE_IMP_CONTINUOUS],
      ASM_MESON_TAC [COVERING_SPACE_IMP_SURJECTIVE],
      ASM_MESON_TAC [COVERING_SPACE_INJECTIVE],
      ASM_MESON_TAC [COVERING_SPACE_OPEN_MAP]])

  return { COVERING_SPACE_LIFT_STRONGER, COVERING_SPACE_LIFT_STRONG, COVERING_SPACE_LIFT,
           CARD_EQ_COVERING_MAP_FIBRES, COVERING_SPACE_INJECTIVE,
           COVERING_SPACE_HOMEOMORPHISM }

/- ------------------------------------------------------------------------- -/
/- Results on finiteness of the number of sheets in a covering space.        -/
/- (paths.ml 25852-25981)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWY where
  COVERING_SPACE_FIBRE_NO_LIMPT : thm
  COVERING_SPACE_COUNTABLE_SHEETS : thm
  COVERING_SPACE_FINITE_EQ_COMPACT_FIBRE : thm
  COVERING_SPACE_CLOSED_MAP : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWY [HolBase] (D : PathsDeps) (BWR : PWR) : ExceptT String IO PWY := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, EQ_IMP, EXTENSION, FINITE_EMPTY, FINITE_IMAGE, FINITE_IMAGE_INJ_EQ,
        FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_CONJ, INTERS_GSPEC, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTERS, IN_UNIONS, LEFT_EXISTS_AND_THM,
        LEFT_IMP_EXISTS_THM, MONO_FORALL, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_REFL, .. } := D.cvx.core5
  let { SWAP_EXISTS_THM, UNIONS_0, pairwise, .. } := D.cvx.core6
  let { OPEN_IN_SUBOPEN, OPEN_IN_TRANS, closed_in, .. } := D.cvx.met
  let { CLOSED_IN_CLOSED, .. } := D.cvx.top1
  let { FINITE_IMP_COMPACT, .. } := D.cvx.top3
  let { HOMEOMORPHISM_IMP_OPEN_MAP, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, closed, homeomorphism, .. } := D.cvx.top5
  let { INFINITE, .. } := D.pses1
  let { CLOSED_IN_IMP_SUBSET, .. } := D.pmet1
  let { OPEN_IN_INTERS, .. } := D.pmet2
  let { COMPACT_EQ_BOLZANO_WEIERSTRASS, .. } := D.ptop1
  let { LIMPT_INFINITE_OPEN, .. } := D.ptop4
  let { UNCOUNTABLE_CONTAINS_LIMIT_POINT, .. } := D.ptop5
  let { covering_space, COVERING_SPACE_IMP_SURJECTIVE, .. } := BWR
  -- @@SCOPE END

  let COVERING_SPACE_FIBRE_NO_LIMPT ← prove
   r"!p:real^M->real^N c s a b.
          covering_space (c,p) s /\ a IN c
          ==> ~(a limit_point_of {x | x IN c /\ p x = b})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [covering_space]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(p:real^M->real^N) a")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"vv:(real^M->bool)->bool") MP_TAC) THEN
    GEN_REWRITE_TAC id [IMP_CONJ] THEN
    REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
    STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^M->bool"))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"q:real^N->real^M") MP_TAC) THEN
    REWRITE_TAC [homeomorphism] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"open_in (subtopology euclidean c) (t:real^M->bool)") THEN
    REWRITE_TAC [OPEN_IN_OPEN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^M->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^M->bool") o
          GEN_REWRITE_RULE id [LIMPT_INFINITE_OPEN]) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [INFINITE]] THEN
    MATCH_MP_TAC (← MESON [FINITE_SING, FINITE_SUBSET]
     (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
    ASM SET_TAC [])

  let COVERING_SPACE_COUNTABLE_SHEETS ← prove
   r"!p:real^M->real^N c s b.
          covering_space (c,p) s ==> COUNTABLE {x | x IN c /\ p x = b}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [] (← ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]
          UNCOUNTABLE_CONTAINS_LIMIT_POINT)) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [COVERING_SPACE_FIBRE_NO_LIMPT])

  let COVERING_SPACE_FINITE_EQ_COMPACT_FIBRE ← prove
   r"!p:real^M->real^N c s b.
          covering_space (c,p) s
          ==> (FINITE {x | x IN c /\ p x = b} <=>
               compact {x | x IN c /\ p x = b})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [FINITE_IMP_COMPACT] THEN
    DISCH_TAC THEN ASM_CASES_TAC (← q r"(b:real^N) IN s") THENL
     [ONCE_REWRITE_TAC [← TAUT (← q r"p <=> (~p ==> F)")] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o
       SPEC (← q r"{x | x IN c /\ (p:real^M->real^N) x = b}") o
       GEN_REWRITE_RULE id [COMPACT_EQ_BOLZANO_WEIERSTRASS]) THEN
      ASM_REWRITE_TAC [INFINITE, SUBSET_REFL, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:real^M") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^N"] o
         MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_FIBRE_NO_LIMPT)) THEN
      ASM_REWRITE_TAC [],
      SUBGOAL_THEN (← q r"{x  | x IN c /\ (p:real^M->real^N) x = b} = {}")
       (fun th => REWRITE_TAC [th, FINITE_EMPTY]) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
      ASM SET_TAC []])

  let COVERING_SPACE_CLOSED_MAP ← prove
   r"!p:real^M->real^N c s t.
          covering_space (c,p) s /\
          (!b. b IN s ==> FINITE {x | x IN c /\ p x = b}) /\
          closed_in (subtopology euclidean c) t
          ==> closed_in (subtopology euclidean s) (IMAGE p t)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN CONJ_TAC THENL
     [ASM SET_TAC [], ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN]] THEN
    X_GEN_TAC (← q r"y:real^N") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"y:real^N") (← liftExcept (last (CONJUNCTS
        (← GEN_REWRITE_RULE id [covering_space] th))))))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"uu:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"uu:(real^M->bool)->bool = {}") THENL
     [ASM_REWRITE_TAC [UNIONS_0, NOT_IN_EMPTY] THEN ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"INTERS {IMAGE (p:real^M->real^N) (u DIFF t) | u IN uu}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_INTERS THEN
      ASM_REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN
        SUBGOAL_THEN
         (← q r"!u. u IN uu ==> ?x. x IN u /\ (p:real^M->real^N) x = y")
        ASSUME_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"FINITE (IMAGE (\u. @x. x IN u /\ (p:real^M->real^N) x = y) uu)")
        MP_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            FINITE_SUBSET)) THEN ASM SET_TAC [],
          MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC FINITE_IMAGE_INJ_EQ THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
          REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN ASM SET_TAC []],
        X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
        MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"v:real^N->bool") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMEOMORPHISM_IMP_OPEN_MAP THEN
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"u:real^M->bool") THEN
        ASM_SIMP_TAC [LEFT_EXISTS_AND_THM] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CLOSED_IN_CLOSED]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^M->bool") STRIP_ASSUME_TAC) THEN
        ASM_REWRITE_TAC [OPEN_IN_OPEN] THEN
        EXISTS_TAC (← q r"(:real^M) DIFF k") THEN
        ASM_REWRITE_TAC [← GSYM closed] THEN ASM SET_TAC []],
      REWRITE_TAC [IN_INTERS, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"u:real^M->bool") THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^M->bool"))) THEN
      ASM_REWRITE_TAC [homeomorphism] THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"z:real^N") THEN DISCH_TAC THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_IMAGE]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^M") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"w:real^M")) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ r /\ ~s ==> ~(s <=> q /\ r)")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      REWRITE_TAC [IN_UNIONS] THEN ASM SET_TAC []])

  return { COVERING_SPACE_FIBRE_NO_LIMPT, COVERING_SPACE_COUNTABLE_SHEETS,
           COVERING_SPACE_FINITE_EQ_COMPACT_FIBRE, COVERING_SPACE_CLOSED_MAP }

/- ------------------------------------------------------------------------- -/
