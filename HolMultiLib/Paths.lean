           COVERING_SPACE_FINITE_SHEETS_EQ_PROPER_MAP }

/- ------------------------------------------------------------------------- -/
/- Compact special cases; a proper local homeomorphism is a covering map.    -/
/- (paths.ml 26127-26460)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PXA where
  COVERING_SPACE_FINITE_SHEETS : thm
  COVERING_SPACE_COMPACT : thm
  PROPER_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPXA [HolBase] (D : PathsDeps) (BWR : PWR) (BWY : PWY) (BWZ : PWZ) :
    ExceptT String IO PXA := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC, NORM_ARITH, .. } :=
    D.cvx
  let { CONJ_ASSOC, EQ_IMP, EXTENSION, FINITE_IMAGE, FORALL_AND_THM, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INTERS_IMAGE, INTER_COMM, INTER_SUBSET, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, LE_REFL,
        MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, REAL_ARCH_INV, .. } := D.cvx.core3
  let { REAL_LE_INV2, REAL_LE_TRANS, REAL_LTE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } :=
    D.cvx.core4
  let { REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SING_SUBSET, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_RESTRICT, .. } := D.cvx.core5
  let { UNIONS_IMAGE, o_ASSOC, o_DEF, o_THM, pairwise, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { DIST_SYM, .. } := D.cvx.vec1
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_TRANS, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
    D.cvx.met
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_SING, .. } := D.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, CONTINUOUS_WITHIN_OPEN,
        CONTINUOUS_WITHIN_SEQUENTIALLY, .. } := D.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_IMP_OPEN_MAP, HOMEOMORPHISM_OF_SUBSETS, IN_BALL,
        LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, LIM_UNIQUE, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_INTER, OPEN_IN_INTER_OPEN, OPEN_IN_OPEN, OPEN_IN_OPEN_INTER, compact,
        open_in, .. } := D.cvx.top5
  let { OPEN_IN_INTERS, .. } := D.pmet2
  let { BOLZANO_WEIERSTRASS_CONTRAPOS, COMPACT_SEQUENCE_WITH_LIMIT, .. } := D.ptop1
  let { FINITE_EQ_BOUNDED_DISCRETE, .. } := D.ptop3
  let { limit_point_of, .. } := D.ptop5
  let { covering_space, COVERING_SPACE_IMP_SURJECTIVE, .. } := BWR
  let { COVERING_SPACE_FIBRE_NO_LIMPT, .. } := BWY
  let { COVERING_SPACE_FINITE_SHEETS_EQ_PROPER_MAP, .. } := BWZ
  -- @@SCOPE END

  /- ----------------------------------------------------------------------- -/
  /- Special cases where one or both of the sets is compact.                 -/
  /- ----------------------------------------------------------------------- -/

  let COVERING_SPACE_FINITE_SHEETS ← prove
   r"!p:real^M->real^N c s b.
        covering_space (c,p) s /\ compact c ==> FINITE {x | x IN c /\ p x = b}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC BOLZANO_WEIERSTRASS_CONTRAPOS THEN
    EXISTS_TAC (← q r"c:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN
    ASM_MESON_TAC [COVERING_SPACE_FIBRE_NO_LIMPT])

  let COVERING_SPACE_COMPACT ← prove
   r"!p:real^M->real^N c s.
          covering_space (c,p) s
          ==> (compact c <=>
               compact s /\ (!b. b IN s ==> FINITE {x | x IN c /\ p x = b}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [covering_space, COMPACT_CONTINUOUS_IMAGE],
      MATCH_MP_TAC COVERING_SPACE_FINITE_SHEETS THEN ASM_MESON_TAC [],
      FIRST_ASSUM (MP_TAC o
        MATCH_MP COVERING_SPACE_FINITE_SHEETS_EQ_PROPER_MAP) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
      SET_TAC []])

  /- ----------------------------------------------------------------------- -/
  /- A proper (or closed) local homeomorphism is in fact a covering map.     -/
  /- ----------------------------------------------------------------------- -/

  let PROPER_LOCAL_HOMEOMORPHISM_IMP_COVERING_MAP ← prove
   r"!p:real^M->real^N c s.
          IMAGE p c = s /\
          (!k. k SUBSET s /\ compact k ==> compact {x | x IN c /\ p x IN k}) /\
          (!x. x IN c
               ==> ?t u q. x IN t /\
                           open_in (subtopology euclidean c) t /\
                           open_in (subtopology euclidean s) u /\
                           homeomorphism (t,u) (p,q))
          ==> covering_space (c,p) s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(p:real^M->real^N) continuous_on c") ASSUME_TAC THENL
     [REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"open_in (subtopology euclidean c) (t:real^M->bool)") THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_OPEN, OPEN_IN_OPEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^M->bool") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"w:real^N->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [HOMEOMORPHISM]) THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_OPEN] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"w:real^N->bool")) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"y INTER v:real^M->bool") THEN
      ASM_SIMP_TAC [OPEN_INTER, IN_INTER] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [covering_space] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN s ==> FINITE {x | x IN c /\ (p:real^M->real^N) x = y}")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC BOLZANO_WEIERSTRASS_CONTRAPOS THEN
      EXISTS_TAC (← q r"{x | x IN c /\ (p:real^M->real^N) x = y}") THEN
      REWRITE_TAC [SUBSET_REFL, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← GSYM IN_SING] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [SING_SUBSET, COMPACT_SING],
        X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
