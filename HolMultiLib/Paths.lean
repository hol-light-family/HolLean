set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWZ [HolBase] (D : PathsDeps) (BWR : PWR) (BWY : PWY) : ExceptT String IO PWZ := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, FINITE_SING, FINITE_SUBSET, FORALL_AND_THM, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INJECTIVE_ON_ALT, INTER_COMM, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP,
