      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_NEG, LIFT_DROP] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o ONCE_REWRITE_RULE [← GSYM CONTRAPOS_THM]) THEN
