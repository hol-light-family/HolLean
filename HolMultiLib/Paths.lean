        COMPLETELY_METRIZABLE_SPACE_GDELTA_IN,
        FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED, .. } := D.pmet1
  let { LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE,
        LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE,
        MCOMPLETE_IMP_CLOSED_IN, SEMI_LOCALLY_CONNECTED_CONNECTED,
        SEMI_LOCALLY_CONNECTED_GEN_SPACE, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { COMPACT_IN_EUCLIDEAN, COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN, .. } := D.ptop1
  let { CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := D.ptop2
  let { EUCLIDEAN_CONNECTED_COMPONENTS_OF, EUCLIDEAN_METRIC, GDELTA_IN_EUCLIDEAN, .. } :=
