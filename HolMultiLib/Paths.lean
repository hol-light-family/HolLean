    CONJ_TAC THENL
     [DISJ1_TAC THEN REWRITE_TAC [SUBSET_PCROSS, INTER_SUBSET] THEN
      MATCH_MP_TAC CLOSED_IN_PCROSS THEN
      SIMP_TAC [CLOSED_IN_CLOSED_INTER, FRONTIER_CLOSED, CLOSED_CLOSURE],
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC INT_LE_TRANS THENL
       [EXISTS_TAC (← q r"(dimension(s:real^M->bool) - &1) +
                    dimension(t:real^N->bool)"),
        EXISTS_TAC (← q r"dimension(s:real^M->bool) +
                    (dimension(t:real^N->bool) - &1)")] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_INT_ARITH_TAC]) THEN
      MATCH_MP_TAC INT_LE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [DIMENSION_SUBSET, INTER_SUBSET]])

  let DIMENSION_PCROSS_EQ_0 ← prove
   r"!s:real^M->bool t:real^N->bool.
        dimension(s PCROSS t) = &0 <=> dimension s = &0 /\ dimension t = &0"
   (REPEAT GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"s:real^M->bool = {}", ← q r"t:real^N->bool = {}"] THEN
    ASM_REWRITE_TAC [PCROSS_EMPTY, DIMENSION_EMPTY] THEN
    CONV_TAC INT_REDUCE_CONV THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MP_TAC (← ASSUME (← q r"~(t:real^N->bool = {})")) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"b:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"dimension((s:real^M->bool) PCROSS {b:real^N}) = &0")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
         (← q r"d2:int = &0 ==> d <= d2 /\ ~(d <= -- &1) ==> d = &0"))) THEN
        ASM_REWRITE_TAC [DIMENSION_LE_MINUS1, PCROSS_EQ_EMPTY,
                        NOT_INSERT_EMPTY] THEN
        MATCH_MP_TAC DIMENSION_SUBSET THEN
        REWRITE_TAC [SUBSET_PCROSS] THEN ASM SET_TAC [],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_DIMENSION THEN
        REWRITE_TAC [HOMEOMORPHIC_PCROSS_SING]],
      MP_TAC (← ASSUME (← q r"~(s:real^M->bool = {})")) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"dimension({a:real^M} PCROSS (t:real^N->bool)) = &0")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← INT_ARITH
         (← q r"d2:int = &0 ==> d <= d2 /\ ~(d <= -- &1) ==> d = &0"))) THEN
        ASM_REWRITE_TAC [DIMENSION_LE_MINUS1, PCROSS_EQ_EMPTY,
                        NOT_INSERT_EMPTY] THEN
        MATCH_MP_TAC DIMENSION_SUBSET THEN
        REWRITE_TAC [SUBSET_PCROSS] THEN ASM SET_TAC [],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_DIMENSION THEN
        REWRITE_TAC [HOMEOMORPHIC_PCROSS_SING]],
      MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          DIMENSION_PCROSS_LE) THEN
      MP_TAC (← ISPEC (← q r"(s:real^M->bool) PCROSS (t:real^N->bool)")
          DIMENSION_LE_MINUS1) THEN
      ASM_REWRITE_TAC [PCROSS_EQ_EMPTY] THEN ASM_INT_ARITH_TAC])

  return { DIMENSION_PCROSS_LE, DIMENSION_PCROSS_EQ_0 }

/- ------------------------------------------------------------------------- -/
/- The separation theorem for dimension.  (paths.ml 23578-23714)             -/
/- ------------------------------------------------------------------------- -/

structure PWO where
  DIMENSION_SEPARATION_THEOREM : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWO [HolBase] (D : PathsDeps) (BWI : PWI) (BWK : PWK) (BWL : PWL) :
    ExceptT String IO PWO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INT_ARITH, MESON, SET_RULE, SET_TAC, INT_REDUCE_CONV, .. } := D.cvx
  let { CONJ_ASSOC, .. } := D.cvx.core1
  let { IMP_CONJ, INT_LE_TRANS, INT_OF_NUM_SUC, INT_POS, .. } := D.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.cvx.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET_TRANS, .. } := D.cvx.core5
  let { SWAP_FORALL_THM, UNION_SUBSET, .. } := D.cvx.core6
  let { CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_IN_CLOSED_INTER, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, CLOSURE_UNION, .. } := D.cvx.top2
  let { EUCLIDEAN_CLOSURE_OF, FRONTIER_CLOSED, .. } := D.cvx.top3
  let { INTERIOR_OPEN, .. } := D.cvx.top4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_OPEN_INTER, SUBSET_CLOSURE,
        TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, closed, frontier, .. } := D.cvx.top5
  let { INT_FORALL_POS, .. } := D.pses1
  let { num_CASES, .. } := D.pses2
  let { CLOSED_IN_CLOSURE_OF, CLOSED_IN_IMP_SUBSET, CLOSED_IN_INTER,
        CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_SUBSET, .. } :=
    D.pmet1
  let { OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := D.pmet2
  let { CLOSED_IN_REFL, .. } := D.ptop1
  let { SEPARATION_CLOSED_IN_UNION, SEPARATION_CLOSURES, SEPARATION_NORMAL_LOCAL_CLOSURES, .. } :=
    D.ptop5
  let { DIMENSION_LE_MINUS1, DIMENSION_SUBSET, .. } := BWI
  let { DIMENSION_ZERO_SEPARATION_THEOREM, .. } := BWK
  let { DIMENSION_DECOMPOSITION, .. } := BWL
  -- @@SCOPE END

  let DIMENSION_SEPARATION_THEOREM ← prove
   r"!t s:real^N->bool n c d.
        &0 <= n /\
        s SUBSET t /\ dimension s <= n /\
        closed_in (subtopology euclidean t) c /\
        closed_in (subtopology euclidean t) d /\
        DISJOINT c d
        ==> ?b. closed_in (subtopology euclidean t) b /\
                dimension(b INTER s) <= n - &1 /\
                ?u v. open_in (subtopology euclidean t) u /\
                      open_in (subtopology euclidean t) v /\
                      DISJOINT u v /\ u UNION v = t DIFF b /\
                      c SUBSET u /\ d SUBSET v"
   (GEN_TAC THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, ← GSYM INT_FORALL_POS] THEN
    MATCH_MP_TAC (← MESON [num_CASES]
     (← q r"P 0 /\ (P 0 ==> !n. P(SUC n)) ==> !n. P n")) THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"d:real^N->bool", ← q r"t:real^N->bool"]
          SEPARATION_NORMAL_LOCAL_CLOSURES) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool",
          ← q r"s INTER (subtopology euclidean t closure_of u):real^N->bool",
          ← q r"s INTER (subtopology euclidean t closure_of v):real^N->bool"]
          DIMENSION_ZERO_SEPARATION_THEOREM) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_REFL, CLOSED_IN_CLOSURE_OF],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"c':real^N->bool", ← q r"d':real^N->bool"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"c SUBSET t /\ d SUBSET t /\ u SUBSET t /\ v SUBSET (t:real^N->bool) /\
        c' SUBSET t /\ d' SUBSET t")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_IMP_SUBSET, CLOSED_IN_IMP_SUBSET, SUBSET_TRANS],
        ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF]) THEN
      SUBGOAL_THEN
       (← q r"t INTER u:real^N->bool = u /\ t INTER v = v")
      (CONJUNCTS_THEN SUBST_ALL_TAC) THENL [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"c UNION c':real^N->bool", ← q r"d UNION d':real^N->bool"]
          SEPARATION_CLOSURES) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [CLOSURE_UNION] THEN
        SUBGOAL_THEN
         (← q r"c' INTER closure v:real^N->bool = {} /\
          d' INTER closure u:real^N->bool = {}")
        STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"c' INTER closure d':real^N->bool = {} /\
          d' INTER closure c':real^N->bool = {}")
        STRIP_ASSUME_TAC THENL
         [ASM_REWRITE_TAC [SEPARATION_CLOSED_IN_UNION], ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"c' INTER closure d:real^N->bool = {} /\
          d' INTER closure c:real^N->bool = {}")
        STRIP_ASSUME_TAC THENL
         [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP SUBSET_CLOSURE)) THEN
          ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"v INTER closure c':real^N->bool = {} /\
          u INTER closure d':real^N->bool = {}")
        STRIP_ASSUME_TAC THENL
         [MP_TAC (← ISPEC (← q r"subtopology euclidean (t:real^N->bool)")
             OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
          DISCH_THEN (fun th => tactic_of do pure (
            MP_TAC (← SPECL [← q r"v:real^N->bool", ← q r"c':real^N->bool"] th) THEN
            MP_TAC (← SPECL [← q r"u:real^N->bool", ← q r"d':real^N->bool"] th))) THEN
          MP_TAC (← ISPEC (← q r"subtopology euclidean (t:real^N->bool)")
           CLOSURE_OF_SUBSET) THEN
          DISCH_THEN (fun th => tactic_of do pure (
            MP_TAC (← SPEC (← q r"u:real^N->bool") th) THEN
            MP_TAC (← SPEC (← q r"v:real^N->bool") th))) THEN
          ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
          ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF,
                       ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")] THEN
          ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"d INTER closure c':real^N->bool = {} /\
          c INTER closure d':real^N->bool = {}")
        STRIP_ASSUME_TAC THENL
         [ASM SET_TAC [],
          ALL_TAC] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSURE_OF_CLOSED_IN)) THEN
        ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF,
                       ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")] THEN
        ASM SET_TAC [],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"z:real^N->bool"] THEN
        REWRITE_TAC [UNION_SUBSET] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"t INTER frontier w:real^N->bool") THEN
        SIMP_TAC [CLOSED_IN_CLOSED_INTER, FRONTIER_CLOSED] THEN
        CONV_TAC INT_REDUCE_CONV THEN ASM_REWRITE_TAC [DIMENSION_LE_MINUS1] THEN
        ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [← q r"z:real^N->bool", ← q r"w:real^N->bool"]
            OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
          ASM SET_TAC [],
          MAP_EVERY EXISTS_TAC
           [← q r"t INTER w:real^N->bool",
            ← q r"t INTER ((:real^N) DIFF closure w):real^N->bool"] THEN
          ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, ← GSYM closed, CLOSED_CLOSURE] THEN
          REPEAT CONJ_TAC THENL
           [MP_TAC (← ISPEC (← q r"w:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
            ASM SET_TAC [],
            ASM SET_TAC [],
            MP_TAC (← ISPECL [← q r"z:real^N->bool", ← q r"w:real^N->bool"]
              OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
            ASM SET_TAC []]]],
      REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"&(SUC n):int"]
        DIMENSION_DECOMPOSITION) THEN
      ASM_REWRITE_TAC [INT_POS, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:real^N->bool", ← q r"z:real^N->bool"] THEN
      REWRITE_TAC [← GSYM INT_OF_NUM_SUC, ← INT_ARITH (← q r"(x + y) - y:int = x")] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"z:real^N->bool", ← q r"c:real^N->bool", ← q r"d:real^N->bool"]) THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC INT_REDUCE_CONV THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [DIMENSION_LE_MINUS1]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^N->bool") THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      TRANS_TAC INT_LE_TRANS (← q r"dimension(l:real^N->bool)") THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC DIMENSION_SUBSET THEN ASM SET_TAC []])

  return { DIMENSION_SEPARATION_THEOREM }

/- ------------------------------------------------------------------------- -/
/- Large and "tiny" inductive dimension.  (paths.ml 23715-23906)             -/
/- ------------------------------------------------------------------------- -/

structure PWP where
  LARGE_INDUCTIVE_DIMENSION : thm
  TINY_INDUCTIVE_DIMENSION : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWP [HolBase] (D : PathsDeps) (BWH : PWH) (BWI : PWI) (BWJ : PWJ) (BWL : PWL)
    (BWO : PWO) : ExceptT String IO PWP := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_INT_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } :=
    D.cvx
  let { CONJ_ACI, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, FINITE_IMAGE, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET, INT_LE_TRANS, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_INTER, IN_SING, IN_UNIONS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.cvx.core3
  let { RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM,
        SUBSET_REFL, .. } := D.cvx.core5
  let { UNIONS_IMAGE, .. } := D.cvx.core6
  let { COUNTABLE_IMAGE, .. } := D.cvx.lib
  let { CLOSED_IN_DIFF, CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, OPEN_IN_INTER,
        OPEN_IN_SUBTOPOLOGY_INTER_SUBSET, .. } := D.cvx.met
  let { CLOSED_IN_CLOSED_TRANS, CLOSURE_EQ, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, COMPACT_IMP_CLOSED, .. } := D.cvx.top2
  let { EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { OPEN_IN_OPEN, OPEN_IN_REFL, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, .. } :=
    D.cvx.top5
  let { DISJOINT_EMPTY, EXISTS_FINITE_SUBSET_IMAGE, .. } := D.pses1
  let { FINITE_IMP_COUNTABLE, .. } := D.pcard
  let { CLOSED_IN_CLOSURE_OF, CLOSED_IN_EMPTY, CLOSED_IN_FRONTIER_OF, CLOSED_IN_IMP_SUBSET,
        CLOSED_IN_INTER, CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, CLOSURE_OF_SUBSET,
        FRONTIER_OF_CLOSURES, FRONTIER_OF_OPEN_IN, FRONTIER_OF_UNIONS_SUBSET, .. } := D.pmet1
  let { OPEN_IN_UNIONS, .. } := D.pmet2
  let { CLOSED_IN_COMPACT, CLOSED_IN_REFL, CLOSED_IN_SING, COMPACT_EQ_HEINE_BOREL_GEN, .. } :=
    D.ptop1
  let { LOCALLY_AND_SUBSET, LOCALLY_MONO, .. } := D.ptop4
  let { SEPARATION_OPEN_IN_UNION, .. } := D.ptop5
  let { DIMENSION_LE_IMP_GE, LOCALLY_DIMENSION_LE, .. } := BWH
  let { DIMENSION_LE_MINUS1, DIMENSION_POS_LE, DIMENSION_EMPTY, DIMENSION_SUBSET, .. } := BWI
  let { SMALL_INDUCTIVE_DIMENSION, .. } := BWJ
  let { DIMENSION_LE_CLOSED_IN_UNIONS, .. } := BWL
  let { DIMENSION_SEPARATION_THEOREM, .. } := BWO
  -- @@SCOPE END

  let LARGE_INDUCTIVE_DIMENSION ← prove
   r"!s:real^N->bool n.
        dimension s <= n <=>
        if s = {} then -- &1 <= n else
        !c d. closed_in (subtopology euclidean s) c /\
              closed_in (subtopology euclidean s) d /\
              DISJOINT c d
              ==> ?b. closed_in (subtopology euclidean s) b /\
                      dimension b <= n - &1 /\
                      ?u v. open_in (subtopology euclidean s) u /\
                            open_in (subtopology euclidean s) v /\
                            DISJOINT u v /\ u UNION v = s DIFF b /\
                            c SUBSET u /\ d SUBSET v"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [DIMENSION_EMPTY] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s:real^N->bool",
                     ← q r"n:int", ← q r"c:real^N->bool", ← q r"d:real^N->bool"]
          DIMENSION_SEPARATION_THEOREM) THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DIMENSION_POS_LE]) THEN
        ASM_INT_ARITH_TAC,
        MESON_TAC [CLOSED_IN_IMP_SUBSET,
                  ← SET_RULE (← q r"b SUBSET s ==> b INTER s = b")]],
      STRIP_TAC THEN GEN_REWRITE_TAC id [SMALL_INDUCTIVE_DIMENSION] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{}:real^N->bool", ← q r"{}:real^N->bool"]) THEN
        REWRITE_TAC [CLOSED_IN_EMPTY, DISJOINT_EMPTY] THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP DIMENSION_LE_IMP_GE) THEN ASM_ARITH_TAC,
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [← GSYM SING_SUBSET] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [CLOSED_IN_SING] THEN ASM SET_TAC []]])

  let TINY_INDUCTIVE_DIMENSION ← prove
   r"!s:real^N->bool n.
        locally compact s
        ==> (dimension s <= n <=>
             if s = {} then -- &1 <= n else
             &0 <= n /\
             !x y. x IN s /\ y IN s /\ ~(x = y)
                   ==> ?b. closed_in (subtopology euclidean s) b /\
                           dimension b <= n - &1 /\
                           ?u v. open_in (subtopology euclidean s) u /\
                                 open_in (subtopology euclidean s) v /\
                                 DISJOINT u v /\ u UNION v = s DIFF b /\
                                 x IN u /\ y IN v)"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [DIMENSION_EMPTY] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DIMENSION_LE_MINUS1]) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP DIMENSION_LE_IMP_GE) THEN
        ASM_INT_ARITH_TAC,
        MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
         [SMALL_INDUCTIVE_DIMENSION]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"{b:real^N}", ← q r"a:real^N"] o CONJUNCT2) THEN
        ASM_REWRITE_TAC [IN_SING, CLOSED_IN_SING] THEN
        REWRITE_TAC [SING_SUBSET, CONJ_ACI]],
      STRIP_TAC] THEN
    ONCE_REWRITE_TAC [LOCALLY_DIMENSION_LE] THEN
    CONJ_TAC THENL [ASM_INT_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_AND_SUBSET]) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LOCALLY_MONO) THEN
    X_GEN_TAC (← q r"k:real^N->bool") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [SMALL_INDUCTIVE_DIMENSION] THEN
    CONJ_TAC THENL [ASM_INT_ARITH_TAC, ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"p:real^N"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CLOSED_IN_COMPACT)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!q. q IN c
          ==> ?u. open_in (subtopology euclidean k) u /\
                  q IN u /\ ~((p:real^N) IN closure u) /\
                  dimension(subtopology euclidean k frontier_of u) <= n - &1")
    MP_TAC THENL
     [X_GEN_TAC (← q r"q:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:real^N", ← q r"q:real^N"]) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"b:real^N->bool") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"k INTER v:real^N->bool") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_INTER, OPEN_IN_REFL,
          OPEN_IN_SUBTOPOLOGY_INTER_SUBSET],
        ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← EQ_IMP_RULE (← ISPECL
       [← q r"k INTER u:real^N->bool", ← q r"k INTER v:real^N->bool"]
       SEPARATION_OPEN_IN_UNION)).2 THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
         [UNDISCH_TAC (← q r"open_in (subtopology euclidean s) (u:real^N->bool)"),
          UNDISCH_TAC (← q r"open_in (subtopology euclidean s) (v:real^N->bool)")] THEN
        REWRITE_TAC [OPEN_IN_OPEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
        ASM SET_TAC [],
        STRIP_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      TRANS_TAC INT_LE_TRANS (← q r"dimension(b:real^N->bool)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC DIMENSION_SUBSET THEN
      REWRITE_TAC [FRONTIER_OF_CLOSURES, CLOSURE_OF_SUBTOPOLOGY,
                  TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
      REWRITE_TAC [← SET_RULE (← q r"k INTER k INTER v = k INTER v"),
                  ← SET_RULE (← q r"k INTER (k DIFF k INTER v) = k DIFF v")] THEN
      SUBGOAL_THEN
       (← q r"closure(k DIFF v):real^N->bool = k DIFF v /\
        (k INTER v) SUBSET closure(k INTER v)")
      MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [CLOSURE_SUBSET, CLOSURE_EQ] THEN
      MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
      EXISTS_TAC (← q r"k:real^N->bool") THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      SUBGOAL_THEN (← q r"k DIFF v:real^N->bool = k INTER (s DIFF v)") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [CLOSED_IN_INTER, CLOSED_IN_DIFF, CLOSED_IN_REFL],
      FIRST_X_ASSUM (fun th => tactic_of do
        let _ ← SPEC (← q r"vec 0:real^N") th
        pure ALL_TAC)] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:real^N->real^N->bool") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"c:real^N->bool") COMPACT_EQ_HEINE_BOREL_GEN) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"IMAGE (u:real^N->real^N->bool) c", ← q r"k:real^N->bool"]) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, UNIONS_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N->bool") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"v = UNIONS (IMAGE (u:real^N->real^N->bool) d)") THEN
    EXISTS_TAC (← q r"subtopology euclidean k frontier_of v:real^N->bool") THEN
    REWRITE_TAC [CLOSED_IN_FRONTIER_OF, RIGHT_AND_EXISTS_THM] THEN
    EXISTS_TAC (← q r"k DIFF subtopology euclidean k closure_of v:real^N->bool") THEN
    EXISTS_TAC (← q r"v:real^N->bool") THEN
    SUBGOAL_THEN (← q r"open_in (subtopology euclidean k) (v:real^N->bool)")
    ASSUME_TAC THENL
     [EXPAND_TAC "v" THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL, CLOSED_IN_CLOSURE_OF] THEN
    ASM_REWRITE_TAC [IN_DIFF] THEN
    FIRST_ASSUM (ASSUME_TAC o SYM o MATCH_MP FRONTIER_OF_OPEN_IN) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"subtopology euclidean (k:real^N->bool)", ← q r"v:real^N->bool"]
      CLOSURE_OF_SUBSET) THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (q /\ r) /\ p /\ s")] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"subtopology euclidean k frontier_of (v:real^N->bool) SUBSET
      UNIONS {subtopology euclidean k frontier_of (u q) | (q:real^N) IN d}")
    ASSUME_TAC THENL
     [EXPAND_TAC "v" THEN
      W (MP_TAC o PART_MATCH (lhand o rand) FRONTIER_OF_UNIONS_SUBSET o
        lhand o snd) THEN
      ASM_SIMP_TAC [FINITE_IMAGE, ← SET_RULE
       (← q r"{f x | x IN IMAGE g s} = {f(g x) | x IN s}")],
      ALL_TAC] THEN
    CONJ_TAC THENL
      [TRANS_TAC INT_LE_TRANS
        (← q r"dimension(UNIONS { subtopology euclidean k frontier_of (u q) |
                            (q:real^N) IN d}:real^N->bool)") THEN
       ASM_SIMP_TAC [DIMENSION_SUBSET] THEN
       MATCH_MP_TAC DIMENSION_LE_CLOSED_IN_UNIONS THEN
       EXISTS_TAC (← q r"k:real^N->bool") THEN
       ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMP_COUNTABLE, COUNTABLE_IMAGE] THEN
       CONJ_TAC THENL [ASM_INT_ARITH_TAC, REWRITE_TAC [FORALL_IN_IMAGE]] THEN
       REWRITE_TAC [CLOSED_IN_FRONTIER_OF] THEN ASM SET_TAC [],
       FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
        (← q r"c DIFF v = f ==> ~(p IN v) /\ ~(p IN f) ==> ~(p IN c)"))) THEN
       CONJ_TAC THENL
        [EXPAND_TAC "v",
         FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
          (← q r"s SUBSET t ==> ~(p IN t) ==> ~(p IN s)")))] THEN
       (REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE, EXISTS_IN_GSPEC] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^N") STRIP_ASSUME_TAC) THEN
         FIRST_X_ASSUM (MP_TAC o SPEC (← q r"q:real^N")) THEN
         ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC])
       THENL
        [MP_TAC (← ISPEC (← q r"(u:real^N->real^N->bool) q") CLOSURE_SUBSET) THEN
         ASM SET_TAC [],
         DISCH_THEN (fun th => tactic_of do
           pure (MP_TAC (← liftExcept (el 2 (CONJUNCTS th))))) THEN
         FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
           [FRONTIER_OF_CLOSURES]) THEN
         REWRITE_TAC [IN_INTER, CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
         MATCH_MP_TAC (← SET_RULE
          (← q r"s SUBSET t ==> (x IN k /\ x IN s) /\ P ==> x IN t")) THEN
         MATCH_MP_TAC SUBSET_CLOSURE THEN REWRITE_TAC [INTER_SUBSET]]])

  return { LARGE_INDUCTIVE_DIMENSION, TINY_INDUCTIVE_DIMENSION }

/- ------------------------------------------------------------------------- -/
/- Points with a given number of rational coordinates.                       -/
/- (paths.ml 23907-24025)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWQ where
  DIMENSION_LE_RATIONAL_COORDINATES : thm
  DIMENSION_EXACTLY_RATIONAL_COORDINATES : thm
  deriving Inhabited

set_option maxRecDepth 2048 in
set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWQ [HolBase] (D : PathsDeps) (BWH : PWH) (BWI : PWI) (BWL : PWL) :
    ExceptT String IO PWQ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_TAC, INT_REDUCE_CONV,
        .. } := D.cvx
  let { CARD_SUBSET_LE, COND_RAND, EXISTS_IN_GSPEC, EXTENSION, FINITE_NUMSEG, FINITE_RESTRICT,
        FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { HAS_SIZE, INTERS_GSPEC, INTER_EMPTY, INT_LE_ANTISYM, INT_LE_TRANS, IN_DIFF, .. } :=
    D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, LE_REFL,
        NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_LT, REAL_LT_01, REAL_LT_MIN, .. } := D.cvx.core4
  let { REAL_SUB_LT, SIMPLE_IMAGE, SUBSET, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.cvx.core5
  let { UNIONS_GSPEC, numseg, .. } := D.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_PRODUCT_DEPENDENT, .. } := D.cvx.lib
  let { LAMBDA_SKOLEM, .. } := D.cvx.misc
  let { IN_INTERVAL, .. } := D.cvx.vec2
  let { CLOSED_INTERS, CLOSED_IN_CLOSED_INTER, .. } := D.cvx.top1
  let { OPEN_INTERVAL, .. } := D.cvx.top5
  let { HAS_SIZE_NUMSEG_1, .. } := D.pses1
  let { INTERVAL_EQ_EMPTY, SUBSET_INTERVAL, .. } := D.pvec
  let { COUNTABLE_RATIONAL_COORDINATES, IRRATIONAL_APPROXIMATION,
        IRRATIONAL_APPROXIMATION_STRADDLE, .. } := D.pmisc
  let { COUNTABLE_FINITE_SUBSETS, COUNTABLE_SUBSET, NUM_COUNTABLE, .. } := D.pcard
  let { RATIONAL_APPROXIMATION, RATIONAL_APPROXIMATION_STRADDLE, RATIONAL_NUM, .. } := D.pfloor
  let { CLOSED_STANDARD_HYPERPLANE, .. } := D.ptop1
  let { FRONTIER_OPEN_INTERVAL, .. } := D.ptop3
  let { OPEN_CONTAINS_INTERVAL, .. } := D.ptop5
  let { DIMENSION_LE_EQ, .. } := BWH
  let { DIMENSION_LE_MINUS1, DIMENSION_POS_LE, DIMENSION_SUBSET, .. } := BWI
  let { DIMENSION_LE_CLOSED_IN_UNIONS, .. } := BWL
  -- @@SCOPE END

  let DIMENSION_LE_RATIONAL_COORDINATES ← prove
   r"!n. dimension {x:real^N | {i | i IN 1..dimindex(:N) /\ rational(x$i)}
                             HAS_SIZE n} <= &0"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(!x. t = x ==> dimension x <= &0) ==> dimension t <= &0")) THEN
    X_GEN_TAC (← q r"s:real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"s =
      UNIONS {s INTER h |
              h IN  { INTERS {{x:real^N | x$i = q$i} | i IN k} |
         k IN {l | l SUBSET 1..dimindex(:N) /\ l HAS_SIZE n} /\
         q IN {y:real^N | !i. 1 <= i /\ i <= dimindex(:N) ==> rational(y$i)}}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, EXISTS_IN_GSPEC] THEN
      EXPAND_TAC "s" THEN GEN_REWRITE_TAC id [EXTENSION] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_ELIM_THM, IN_INTER] THEN
      ABBREV_TAC (← q r"k = {i | i IN 1..dimindex(:N) /\ rational((x:real^N)$i)}") THEN
      EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"k:num->bool") THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"(lambda i. if i IN k then (x:real^N)$i else &0):real^N") THEN
      SIMP_TAC [LAMBDA_BETA] THEN EXPAND_TAC "k" THEN
      REWRITE_TAC [IN_ELIM_THM, SUBSET_RESTRICT] THEN
      SIMP_TAC [IN_NUMSEG, LAMBDA_BETA] THEN MESON_TAC [RATIONAL_NUM],
      ALL_TAC] THEN
    MATCH_MP_TAC DIMENSION_LE_CLOSED_IN_UNIONS THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN CONV_TAC INT_REDUCE_CONV THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC COUNTABLE_IMAGE THEN
      MATCH_MP_TAC COUNTABLE_PRODUCT_DEPENDENT THEN
      REWRITE_TAC [COUNTABLE_RATIONAL_COORDINATES] THEN
      MATCH_MP_TAC COUNTABLE_SUBSET THEN
      EXISTS_TAC (← q r"{k | k SUBSET (:num) /\ FINITE k}") THEN
      SIMP_TAC [COUNTABLE_FINITE_SUBSETS, NUM_COUNTABLE] THEN
      REWRITE_TAC [HAS_SIZE] THEN SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"k:num->bool", ← q r"q:real^N"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_CLOSED_INTER THEN MATCH_MP_TAC CLOSED_INTERS THEN
      REWRITE_TAC [FORALL_IN_GSPEC, CLOSED_STANDARD_HYPERPLANE],
      ALL_TAC] THEN
    TRANS_TAC INT_LE_TRANS
     (← q r"dimension {x:real^N | !i. 1 <= i /\ i <= dimindex(:N)
                                ==> (rational(x$i) <=> i IN k)}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC DIMENSION_SUBSET THEN
      REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_INTER] THEN
      X_GEN_TAC (← q r"x:real^N") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"k:num->bool",
                     ← q r"{i | i IN 1..dimindex(:N) /\ rational((x:real^N)$i)}"]
        CARD_SUBSET_LE) THEN
      ANTS_TAC THENL [ALL_TAC, REWRITE_TAC [IN_NUMSEG] THEN SET_TAC []] THEN
      SIMP_TAC [FINITE_RESTRICT, FINITE_NUMSEG] THEN CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM IN_NUMSEG]) THEN ASM SET_TAC [],
        UNDISCH_TAC (← q r"(x:real^N) IN s") THEN EXPAND_TAC "s" THEN
        UNDISCH_TAC (← q r"(k:num->bool) HAS_SIZE n") THEN
        SIMP_TAC [IN_ELIM_THM, HAS_SIZE, LE_REFL]],
      ALL_TAC] THEN
    GEN_REWRITE_TAC id [DIMENSION_LE_EQ] THEN CONV_TAC INT_REDUCE_CONV THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"a:real^N"] THEN
    REWRITE_TAC [DIMENSION_LE_MINUS1, IN_ELIM_THM] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:real^N") o
      GEN_REWRITE_RULE id [OPEN_CONTAINS_INTERVAL]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real^N", ← q r"r:real^N"] THEN
    REWRITE_TAC [IN_INTERVAL] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. 1 <= i /\ i <= dimindex(:N)
          ==> ?u v. (rational u <=> ~(i IN k)) /\
                    (rational v <=> ~(i IN k)) /\
                    u < (a:real^N)$i /\ a$i < v /\
                    abs(v - u) < min ((r:real^N)$i - a$i) (a$i - (l:real^N)$i)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"(i:num) IN k") THEN ASM_REWRITE_TAC [] THENL
       [MATCH_MP_TAC IRRATIONAL_APPROXIMATION_STRADDLE,
        MATCH_MP_TAC RATIONAL_APPROXIMATION_STRADDLE] THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_SUB_LT],
      REWRITE_TAC [LAMBDA_SKOLEM, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"interval(x:real^N,y)") THEN
    ASM_SIMP_TAC [IN_INTERVAL, OPEN_INTERVAL] THEN CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"interval[l:real^N,r]") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET_INTERVAL] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [FRONTIER_OPEN_INTERVAL, INTERVAL_EQ_EMPTY] THEN
    COND_CASES_TAC THEN REWRITE_TAC [INTER_EMPTY] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_INTER, NOT_IN_EMPTY, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"z:real^N") THEN REWRITE_TAC [IN_INTERVAL] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(!x. ~R x ==> ~(P x /\ Q x))
      ==> ~((!x. P x) /\ (!x. Q x) /\ ~(!x. R x))")) THEN
    X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [REAL_LE_LT])

  let DIMENSION_EXACTLY_RATIONAL_COORDINATES ← prove
   r"!n. 1 <= n /\ n <= dimindex(:N)
       ==> dimension {x:real^N | {i | i IN 1..dimindex(:N) /\ rational(x$i)}
                                 HAS_SIZE n} = &0"
   (GEN_TAC THEN REWRITE_TAC [← GSYM INT_LE_ANTISYM] THEN
    REWRITE_TAC [DIMENSION_POS_LE, DIMENSION_LE_RATIONAL_COORDINATES] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?q r. rational q /\ ~rational r") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [RATIONAL_APPROXIMATION, IRRATIONAL_APPROXIMATION,
                    REAL_LT_01],
      REWRITE_TAC [EXTENSION, NOT_FORALL_THM, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      EXISTS_TAC (← q r"(lambda i. if i <= n then q else r):real^N") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
      SIMP_TAC [IN_NUMSEG, LAMBDA_BETA] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
      ASM_REWRITE_TAC [← TAUT (← q r"(if p then T else F) <=> p"), NOT_IMP] THEN
      ASM_SIMP_TAC [← ARITH_RULE
       (← q r"n <= m ==> ((1 <= i /\ i <= m) /\ i <= n <=> 1 <= i /\ i <= n)")] THEN
      REWRITE_TAC [← GSYM numseg, HAS_SIZE_NUMSEG_1]])

  return { DIMENSION_LE_RATIONAL_COORDINATES, DIMENSION_EXACTLY_RATIONAL_COORDINATES }

/- ------------------------------------------------------------------------- -/
/- Covering spaces and lifting results for them.  (paths.ml 24026-24199)     -/
/- ------------------------------------------------------------------------- -/

structure PWR where
  covering_space : thm
  COVERING_SPACE_IMP_CONTINUOUS : thm
  COVERING_SPACE_IMP_SURJECTIVE : thm
  HOMEOMORPHISM_IMP_COVERING_SPACE : thm
  COVERING_SPACE_LOCAL_HOMEOMORPHISM : thm
  COVERING_SPACE_LOCAL_HOMEOMORPHISM_ALT : thm
  COVERING_SPACE_OPEN_MAP : thm
  COVERING_SPACE_QUOTIENT_MAP : thm
  COVERING_SPACE_LOCALIZED_HOMEOMORPHISM : thm
  COVERING_SPACE_LOCALIZED_HOMEOMORPHISM_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWR [HolBase] (D : PathsDeps) : ExceptT String IO PWR := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, SET_TAC, .. } := D.cvx
  let { FORALL_IN_INSERT, FUN_IN_IMAGE, IMP_CONJ, INTER_COMM, INTER_SUBSET, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.cvx.core3
  let { SUBSET_REFL, .. } := D.cvx.core5
  let { SUBSET_UNIV, .. } := D.cvx.core6
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
        OPEN_IN_SUBTOPOLOGY_REFL, OPEN_IN_TRANS, .. } := D.cvx.met
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.cvx.top3
  let { HOMEOMORPHISM_OF_SUBSETS, .. } := D.cvx.top4
  let { TOPSPACE_EUCLIDEAN, homeomorphism, open_in, .. } := D.cvx.top5
  let { PAIRWISE_SING, UNIONS_1, .. } := D.pses2
  let { CONTINUOUS_ON_OPEN, .. } := D.ptop3
  let { OPEN_MAP_IMP_QUOTIENT_MAP, .. } := D.ptop5
  -- @@SCOPE END

  let covering_space ← new_definition
   r"covering_space(c,(p:real^M->real^N)) s <=>
        p continuous_on c /\ IMAGE p c = s /\
        !x. x IN s
            ==> ?t. x IN t /\ open_in (subtopology euclidean s) t /\
                    ?v. UNIONS v = {x | x IN c /\ p(x) IN t} /\
                        (!u. u IN v ==> open_in (subtopology euclidean c) u) /\
                        pairwise DISJOINT v /\
                        (!u. u IN v ==> ?q. homeomorphism (u,t) (p,q))"

  let COVERING_SPACE_IMP_CONTINUOUS ← prove
   r"!p:real^M->real^N c s. covering_space (c,p) s ==> p continuous_on c"
   (SIMP_TAC [covering_space])

  let COVERING_SPACE_IMP_SURJECTIVE ← prove
   r"!p:real^M->real^N c s. covering_space (c,p) s ==> IMAGE p c = s"
   (SIMP_TAC [covering_space])

  let HOMEOMORPHISM_IMP_COVERING_SPACE ← prove
   r"!f:real^M->real^N g s t.
        homeomorphism (s,t) (f,g) ==> covering_space (s,f) t"
   (REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [covering_space] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"t:real^N->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    EXISTS_TAC (← q r"{s:real^M->bool}") THEN
    REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, UNIONS_1, PAIRWISE_SING] THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN
    CONJ_TAC THENL [ASM SET_TAC [], EXISTS_TAC (← q r"g:real^N->real^M")] THEN
    ASM_REWRITE_TAC [homeomorphism])

  let COVERING_SPACE_LOCAL_HOMEOMORPHISM ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> !x. x IN c
                ==> ?t u. x IN t /\ open_in (subtopology euclidean c) t /\
                          p(x) IN u /\ open_in (subtopology euclidean s) u /\
                          ?q. homeomorphism (t,u) (p,q)"
   (REWRITE_TAC [covering_space] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(p:real^M->real^N) x")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(x:real^M) IN UNIONS v") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:real^M->bool") THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"t:real^N->bool") THEN ASM_SIMP_TAC [])

  let COVERING_SPACE_LOCAL_HOMEOMORPHISM_ALT ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> !y. y IN s
                ==> ?x t u. p(x) = y /\
                            x IN t /\ open_in (subtopology euclidean c) t /\
                            y IN u /\ open_in (subtopology euclidean s) u /\
                            ?q. homeomorphism (t,u) (p,q)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?x. x IN c /\ (p:real^M->real^N) x = y") MP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^M") o MATCH_MP
       COVERING_SPACE_LOCAL_HOMEOMORPHISM) THEN
      ASM_MESON_TAC []])

  let COVERING_SPACE_OPEN_MAP ← prove
   r"!p:real^M->real^N c s t.
        covering_space (c,p) s /\
        open_in (subtopology euclidean c) t
        ==> open_in (subtopology euclidean s) (IMAGE p t)"
   (REWRITE_TAC [covering_space] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [open_in]) THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"y:real^N") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"vs:(real^M->bool)->bool")
     (STRIP_ASSUME_TAC o GSYM)) THEN
    SUBGOAL_THEN
     (← q r"?x. x IN {x | x IN c /\ (p:real^M->real^N) x IN u} /\ x IN t /\ p x = y")
    MP_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^M") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNIONS]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^M->bool") STRIP_ASSUME_TAC) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:real^M->bool"))) THEN
    ASM_REWRITE_TAC [homeomorphism] THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"q:real^N->real^M") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (p:real^M->real^N) (t INTER v)") THEN CONJ_TAC THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (p:real^M->real^N) (t INTER v) =
      {z | z IN u /\ q z IN (t INTER v)}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"u:real^N->bool") THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [CONTINUOUS_ON_OPEN]) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_SUBSET THEN
    EXISTS_TAC (← q r"c:real^M->bool") THEN
    CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_INTER, ASM_MESON_TAC [open_in]] THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_EUCLIDEAN, SUBSET_UNIV])

  let COVERING_SPACE_QUOTIENT_MAP ← prove
   r"!p:real^M->real^N c s.
    covering_space (c,p) s
    ==> !u. u SUBSET s
            ==> (open_in (subtopology euclidean c) {x | x IN c /\ p x IN u} <=>
                 open_in (subtopology euclidean s) u)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    MATCH_MP_TAC OPEN_MAP_IMP_QUOTIENT_MAP THEN
    CONJ_TAC THENL [ASM_MESON_TAC [COVERING_SPACE_IMP_CONTINUOUS], ALL_TAC] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
    ASM_MESON_TAC [COVERING_SPACE_OPEN_MAP])

  let COVERING_SPACE_LOCALIZED_HOMEOMORPHISM ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> !w x. x IN w /\ open_in (subtopology euclidean c) w
                  ==> ?t u. x IN t /\ open_in (subtopology euclidean c) t /\
                            p(x) IN u /\ open_in (subtopology euclidean s) u /\
                            t SUBSET w /\
                            ?q. homeomorphism (t,u) (p,q)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^M") o MATCH_MP
      COVERING_SPACE_LOCAL_HOMEOMORPHISM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"q:real^N->real^M")) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"u INTER w:real^M->bool", ← q r"IMAGE (p:real^M->real^N) (u INTER w)"] THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER, INTER_SUBSET] THEN
    REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [FUN_IN_IMAGE, IN_INTER],
      ASM_MESON_TAC [COVERING_SPACE_OPEN_MAP, OPEN_IN_INTER],
      EXISTS_TAC (← q r"q:real^N->real^M") THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC []])

  let COVERING_SPACE_LOCALIZED_HOMEOMORPHISM_ALT ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> !w y. y IN w /\ open_in (subtopology euclidean s) w
                ==> ?x t u. p(x) = y /\
                            x IN t /\ open_in (subtopology euclidean c) t /\
                            y IN u /\ open_in (subtopology euclidean s) u /\
                            u SUBSET w /\
                            ?q. homeomorphism (t,u) (p,q)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    SUBGOAL_THEN (← q r"?x. x IN c /\ (p:real^M->real^N) x = y") MP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COVERING_SPACE_IMP_SURJECTIVE) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real^M") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o
        SPECL [← q r"{x | x IN c /\ (p:real^M->real^N) x IN w}", ← q r"x:real^M"] o
        MATCH_MP COVERING_SPACE_LOCALIZED_HOMEOMORPHISM) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
        RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
        ASM_MESON_TAC [SUBSET_REFL],
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
        SIMP_TAC [] THEN REWRITE_TAC [homeomorphism] THEN REPEAT STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
        ASM SET_TAC []]])

  return { covering_space, COVERING_SPACE_IMP_CONTINUOUS, COVERING_SPACE_IMP_SURJECTIVE,
           HOMEOMORPHISM_IMP_COVERING_SPACE, COVERING_SPACE_LOCAL_HOMEOMORPHISM,
           COVERING_SPACE_LOCAL_HOMEOMORPHISM_ALT, COVERING_SPACE_OPEN_MAP,
           COVERING_SPACE_QUOTIENT_MAP, COVERING_SPACE_LOCALIZED_HOMEOMORPHISM,
           COVERING_SPACE_LOCALIZED_HOMEOMORPHISM_ALT }

/- ------------------------------------------------------------------------- -/
/- Local properties of covering spaces; uniqueness of lifts.                 -/
/- (paths.ml 24200-24439)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PWS where
  COVERING_SPACE_LOCALLY_HOMEOMORPHIC : thm
  COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ : thm
  COVERING_SPACE_LOCALLY : thm
  COVERING_SPACE_LOCALLY_EQ : thm
  COVERING_SPACE_LOCALLY_COMPACT_EQ : thm
  COVERING_SPACE_LOCALLY_CONNECTED_EQ : thm
  COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ : thm
  COVERING_SPACE_LOCALLY_COMPACT : thm
  COVERING_SPACE_LOCALLY_CONNECTED : thm
  COVERING_SPACE_LOCALLY_PATH_CONNECTED : thm
  COVERING_SPACE_LIFT_UNIQUE_GEN : thm
  COVERING_SPACE_LIFT_UNIQUE : thm
  COVERING_SPACE_LIFT_UNIQUE_IDENTITY : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPWS [HolBase] (D : PathsDeps) (BA : PTA) (BK : PTK) (BL : PTL) (BWR : PWR) :
    ExceptT String IO PWS := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ASSOC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.cvx.core3
  let { SUBSET, .. } := D.cvx.core5
  let { o_THM, .. } := D.cvx.core6
  let { VECTOR_SUB_EQ, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_TRANS, .. } := D.cvx.met
  let { COMPACT_CONTINUOUS_IMAGE, CONNECTED_CLOPEN, CONNECTED_CONTINUOUS_IMAGE, .. } := D.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.cvx.top3
  let { HOMEOMORPHISM, HOMEOMORPHISM_OF_SUBSETS, IN_COMPONENTS_CONNECTED,
        IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { OPEN_IN_OPEN, homeomorphism, .. } := D.cvx.top5
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT, .. } := D.ptop2
  let { CONTINUOUS_ON_IMP_OPEN_IN, .. } := D.ptop3
  let { IN_COMPONENTS_SELF, .. } := D.ptop4
  let { locally, .. } := D.ptop5
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { path, pathstart, pathfinish, path_image, .. } := BA
  let { path_connected, .. } := BK
  let { PATH_CONNECTED_CONTINUOUS_IMAGE, .. } := BL
  let { covering_space, COVERING_SPACE_LOCAL_HOMEOMORPHISM, COVERING_SPACE_OPEN_MAP,
        COVERING_SPACE_LOCALIZED_HOMEOMORPHISM, COVERING_SPACE_LOCALIZED_HOMEOMORPHISM_ALT,
        .. } := BWR
  -- @@SCOPE END

  let COVERING_SPACE_LOCALLY_HOMEOMORPHIC ← prove
   r"!P Q p:real^M->real^N c s.
           covering_space (c,p) s /\
           (!q u v. ~(u = {}) /\ u SUBSET c /\ v SUBSET s /\
                    homeomorphism (u,v) (p,q) /\ P u
                    ==> Q v) /\
           locally P c
           ==> locally Q s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"w:real^N->bool", ← q r"y:real^N"] o
      MATCH_MP COVERING_SPACE_LOCALIZED_HOMEOMORPHISM_ALT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"q:real^N->real^M")) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^M->bool", ← q r"x:real^M"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:real^M->bool", ← q r"l:real^M->bool"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (p:real^M->real^N) n") THEN
    EXISTS_TAC (← q r"IMAGE (p:real^M->real^N) l") THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [COVERING_SPACE_OPEN_MAP, OPEN_IN_INTER],
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"q:real^N->real^M", ← q r"l:real^M->bool"] THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
         HOMEOMORPHISM_OF_SUBSETS))] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
      ASM SET_TAC [],
      ASM SET_TAC [],
      ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN ASM SET_TAC []])

  let COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ ← prove
   r"!P Q p:real^M->real^N c s.
           covering_space (c,p) s /\
           (!q u v. ~(u = {}) /\ u SUBSET c /\ v SUBSET s /\
                    homeomorphism (u,v) (p,q)
                    ==> (P u <=> Q v))
           ==> (locally P c <=> locally Q s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [COVERING_SPACE_LOCALLY_HOMEOMORPHIC], ALL_TAC] THEN
    REWRITE_TAC [locally] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real^M->bool", ← q r"x:real^M"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"w:real^M->bool", ← q r"x:real^M"] o
      MATCH_MP COVERING_SPACE_LOCALIZED_HOMEOMORPHISM) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M->bool", ← q r"v:real^N->bool"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"q:real^N->real^M")) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:real^N->bool", ← q r"(p:real^M->real^N) x"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:real^N->bool", ← q r"l:real^N->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN u /\ (p:real^M->real^N) x IN n}",
      ← q r"{x | x IN u /\ (p:real^M->real^N) x IN l}"] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"u:real^M->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ASM SET_TAC []],
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN FIRST_X_ASSUM (MP_TAC o
        SPECL [← q r"q:real^N->real^M",
               ← q r"{x | x IN u /\ (p:real^M->real^N) x IN l}",
               ← q r"l:real^N->bool"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET)) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
         HOMEOMORPHISM_OF_SUBSETS)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM]) THEN ASM SET_TAC []])

  let COVERING_SPACE_LOCALLY ← prove
   r"!P Q p:real^M->real^N c s.
        covering_space (c,p) s /\ (!t. t SUBSET c /\ P t ==> Q(IMAGE p t)) /\
        locally P c
        ==> locally Q s"
   (MP_TAC COVERING_SPACE_LOCALLY_HOMEOMORPHIC THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REWRITE_TAC [homeomorphism] THEN MESON_TAC [])

  let COVERING_SPACE_LOCALLY_EQ ← prove
   r"!P Q p:real^M->real^N c s.
        covering_space (c,p) s /\
        (!t. t SUBSET c /\ P t ==> Q(IMAGE p t)) /\
        (!q u. u SUBSET s /\ q continuous_on u /\ Q u ==> P(IMAGE q u))
        ==> (locally Q s <=> locally P c)"
   (MP_TAC COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REWRITE_TAC [homeomorphism] THEN MESON_TAC [])

  let COVERING_SPACE_LOCALLY_COMPACT_EQ ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> (locally compact s <=> locally compact c)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_LOCALLY_EQ THEN
    EXISTS_TAC (← q r"p:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, COMPACT_CONTINUOUS_IMAGE])

  let COVERING_SPACE_LOCALLY_CONNECTED_EQ ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> (locally connected s <=> locally connected c)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_LOCALLY_EQ THEN
    EXISTS_TAC (← q r"p:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, CONNECTED_CONTINUOUS_IMAGE])

  let COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s
        ==> (locally path_connected s <=> locally path_connected c)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC COVERING_SPACE_LOCALLY_EQ THEN
    EXISTS_TAC (← q r"p:real^M->real^N") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [covering_space]) THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, PATH_CONNECTED_CONTINUOUS_IMAGE])

  let COVERING_SPACE_LOCALLY_COMPACT ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s /\ locally compact c
        ==> locally compact s"
   (MESON_TAC [COVERING_SPACE_LOCALLY_COMPACT_EQ])

  let COVERING_SPACE_LOCALLY_CONNECTED ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s /\ locally connected c ==> locally connected s"
   (MESON_TAC [COVERING_SPACE_LOCALLY_CONNECTED_EQ])

  let COVERING_SPACE_LOCALLY_PATH_CONNECTED ← prove
   r"!p:real^M->real^N c s.
        covering_space (c,p) s /\ locally path_connected c
        ==> locally path_connected s"
   (MESON_TAC [COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ])

  let COVERING_SPACE_LIFT_UNIQUE_GEN ← prove
   r"!p:real^M->real^N f:real^P->real^N g1 g2 c s t u a x.
        covering_space (c,p) s /\
        f continuous_on t /\ IMAGE f t SUBSET s /\
        g1 continuous_on t /\ IMAGE g1 t SUBSET c /\
        (!x. x IN t ==> f(x) = p(g1 x)) /\
        g2 continuous_on t /\ IMAGE g2 t SUBSET c /\
        (!x. x IN t ==> f(x) = p(g2 x)) /\
        u IN components t /\ a IN u /\ g1(a) = g2(a) /\ x IN u
        ==> g1(x) = g2(x)"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    UNDISCH_TAC (← q r"(x:real^P) IN u") THEN SPEC_TAC (← q r"x:real^P", ← q r"x:real^P") THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(?a. a IN u /\ g a = z) /\
      ({x | x IN u /\ g x = z} = {} \/ {x | x IN u /\ g x = z} = u)
      ==> !x. x IN u ==> g x = z")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [VECTOR_SUB_EQ], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
    REWRITE_TAC [CONNECTED_CLOPEN] THEN DISCH_THEN MATCH_MP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:real^P") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"(g1:real^P->real^M) x") o
          MATCH_MP COVERING_SPACE_LOCAL_HOMEOMORPHISM) THEN
      ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:real^M->bool", ← q r"w:real^N->bool"] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [VECTOR_SUB_EQ]) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [homeomorphism] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^N->real^M") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{x | x IN u /\ (g1:real^P->real^M) x IN v} INTER
                  {x | x IN u /\ (g2:real^P->real^M) x IN v}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_INTER THEN ONCE_REWRITE_TAC [← SET_RULE
         (← q r"{x | x IN u /\ g x IN v} =
          {x | x IN u /\ g x IN (v INTER IMAGE g u)}")] THEN
        CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_IMP_OPEN_IN THEN
        (CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC]) THEN
        UNDISCH_TAC (← q r"open_in (subtopology euclidean c) (v:real^M->bool)") THEN
        REWRITE_TAC [OPEN_IN_OPEN] THEN
        MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN ASM SET_TAC [],
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_INTER, VECTOR_SUB_EQ] THEN
        ASM SET_TAC []],
      MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]])

  let COVERING_SPACE_LIFT_UNIQUE ← prove
   r"!p:real^M->real^N f:real^P->real^N g1 g2 c s t a x.
        covering_space (c,p) s /\
        f continuous_on t /\ IMAGE f t SUBSET s /\
        g1 continuous_on t /\ IMAGE g1 t SUBSET c /\
        (!x. x IN t ==> f(x) = p(g1 x)) /\
        g2 continuous_on t /\ IMAGE g2 t SUBSET c /\
        (!x. x IN t ==> f(x) = p(g2 x)) /\
        connected t /\ a IN t /\ g1(a) = g2(a) /\ x IN t
        ==> g1(x) = g2(x)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"p:real^M->real^N", ← q r"f:real^P->real^N",
      ← q r"g1:real^P->real^M", ← q r"g2:real^P->real^M",
      ← q r"c:real^M->bool", ← q r"s:real^N->bool", ← q r"t:real^P->bool",
      ← q r"t:real^P->bool",
      ← q r"a:real^P", ← q r"x:real^P"] COVERING_SPACE_LIFT_UNIQUE_GEN) THEN
    ASM_REWRITE_TAC [IN_COMPONENTS_SELF] THEN ASM SET_TAC [])

  let COVERING_SPACE_LIFT_UNIQUE_IDENTITY ← prove
   r"!p:real^M->real^N c f s a.
     covering_space (c,p) s /\
     path_connected c /\
     f continuous_on c /\ IMAGE f c SUBSET c /\
     (!x. x IN c ==> p(f x) = p x) /\
     a IN c /\ f(a) = a
     ==> !x. x IN c ==> f x = x"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"x:real^M"]) THEN
    ASM_REWRITE_TAC [path, path_image, pathstart, pathfinish] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^M") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"p:real^M->real^N", ← q r"(p:real^M->real^N) o (g:real^1->real^M)",
      ← q r"(f:real^M->real^M) o (g:real^1->real^M)", ← q r"g:real^1->real^M",
      ← q r"c:real^M->bool", ← q r"s:real^N->bool",
      ← q r"interval[vec 0:real^1,vec 1]",
      ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
     COVERING_SPACE_LIFT_UNIQUE) THEN
    ASM_REWRITE_TAC [o_THM, IMAGE_o] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, CONNECTED_INTERVAL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [covering_space]) THEN
    STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE p c = s ==> !x. x IN c ==> p(x) IN s"))) THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE])

  return { COVERING_SPACE_LOCALLY_HOMEOMORPHIC, COVERING_SPACE_LOCALLY_HOMEOMORPHIC_EQ,
           COVERING_SPACE_LOCALLY, COVERING_SPACE_LOCALLY_EQ, COVERING_SPACE_LOCALLY_COMPACT_EQ,
           COVERING_SPACE_LOCALLY_CONNECTED_EQ, COVERING_SPACE_LOCALLY_PATH_CONNECTED_EQ,
           COVERING_SPACE_LOCALLY_COMPACT, COVERING_SPACE_LOCALLY_CONNECTED,
           COVERING_SPACE_LOCALLY_PATH_CONNECTED, COVERING_SPACE_LIFT_UNIQUE_GEN,
           COVERING_SPACE_LIFT_UNIQUE, COVERING_SPACE_LIFT_UNIQUE_IDENTITY }

/- ------------------------------------------------------------------------- -/
/- Lifting homotopies through covering spaces.  (paths.ml 24440-24925)       -/
/- ------------------------------------------------------------------------- -/

structure PWT where
  COVERING_SPACE_LIFT_HOMOTOPY : thm
  deriving Inhabited

set_option maxRecDepth 4096 in
set_option maxHeartbeats 8000000 in
@[nospecialize]
def setupPWT [HolBase] (D : PathsDeps) (BWR : PWR) (BWS : PWS) : ExceptT String IO PWT := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_FIELD, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONJ_ACI, EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_PCROSS, FORALL_PASTECART, FORALL_UNWIND_THM2, FUN_IN_IMAGE,
        IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT,
        INTERS_IMAGE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, IN_UNIV, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, LE_1, LE_REFL, MONO_EXISTS, NOT_IMP, NOT_LE, PASTECART_IN_PCROSS,
        PCROSS, PCROSS_MONO, REAL_ABS_DIV, REAL_ABS_NUM, REAL_ARCH_INV, REAL_DIV_REFL, .. } :=
    D.cvx.core3
  let { REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LT_DIV2_EQ, REAL_LT_IMP_LE, .. } := D.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUB, REAL_POS, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM,
        RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SNDCART_PASTECART, SUBSET,
        SUBSET_EMPTY, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.cvx.core5
  let { SUBSET_UNIV, UNIONS_0, UNIONS_GSPEC, UNIONS_IMAGE, num_INDUCTION, o_DEF, o_THM,
        real_div, .. } := D.cvx.core6
  let { DROP_EQ, DROP_VEC, INTERVAL_SING, LIFT_DROP, LIFT_NUM, LIFT_SUB, LINEAR_SNDCART, .. } :=
    D.cvx.vec2
  let { NORM_LIFT, .. } := D.cvx.vec3
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBTOPOLOGY_REFL, OPEN_IN_TRANS, .. } := D.cvx.met
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, CLOSED_CBALL, CLOSED_INTERVAL, CLOSED_IN_CLOSED,
        CLOSED_UNIV, .. } := D.cvx.top1
  let { COMPACT_INTERVAL, COMPACT_PCROSS, COMPACT_SING, .. } := D.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.cvx.top3
  let { INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, OPEN_BALL,
        OPEN_CONTAINS_CBALL, .. } := D.cvx.top4
  let { OPEN_IN, OPEN_INTER, OPEN_IN_OPEN, OPEN_UNIV, PASTECART_IN_INTERIOR_SUBTOPOLOGY,
        TOPSPACE_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, UNIT_INTERVAL_NONEMPTY, homeomorphism,
        open_in, .. } := D.cvx.top5
  let { EXISTS_FINITE_SUBSET_IMAGE, .. } := D.pses1
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { LEBESGUE_COVERING_LEMMA, PASTING_LEMMA_EXISTS, SUBTOPOLOGY_SUBTOPOLOGY, .. } := D.pmet2
  let { CLOSED_PCROSS, COMPACT_IMP_HEINE_BOREL, COMPACT_IN_EUCLIDEAN, .. } := D.ptop1
  let { CONNECTED_PCROSS, CONNECTED_SING, CONTINUOUS_MAP_EUCLIDEAN, CONTINUOUS_ON_CASES_LOCAL,
        .. } := D.ptop2
  let { CONTINUOUS_ON_PASTECART, DIAMETER_INTERVAL, .. } := D.ptop3
  let { MDIAMETER_EUCLIDEAN, MTOPOLOGY_EUCLIDEAN_METRIC, OPEN_INTERS, OPEN_PCROSS,
        SUBSET_INTERVAL_1, .. } := D.ptop5
  let { CONNECTED_INTERVAL, .. } := D.pcvx1
  let { covering_space, .. } := BWR
  let { COVERING_SPACE_LIFT_UNIQUE, .. } := BWS
  -- @@SCOPE END

  let COVERING_SPACE_LIFT_HOMOTOPY ← prove
   r"!p:real^M->real^N c s (h:real^(1,P)finite_sum->real^N) f u.
        covering_space (c,p) s /\
        h continuous_on (interval[vec 0,vec 1] PCROSS u) /\
        IMAGE h (interval[vec 0,vec 1] PCROSS u) SUBSET s /\
        (!y. y IN u ==> h (pastecart (vec 0) y) = p(f y)) /\
        f continuous_on u /\ IMAGE f u SUBSET c
        ==> ?k. k continuous_on (interval[vec 0,vec 1] PCROSS u) /\
                IMAGE k (interval[vec 0,vec 1] PCROSS u) SUBSET c /\
                (!y. y IN u ==> k(pastecart (vec 0) y) = f y) /\
                (!z. z IN interval[vec 0,vec 1] PCROSS u ==> h z = p(k z))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!y. y IN u
          ==> ?v. open_in (subtopology euclidean u) v /\ y IN v /\
                  ?k:real^(1,P)finite_sum->real^M.
                      k continuous_on (interval[vec 0,vec 1] PCROSS v) /\
                      IMAGE k (interval[vec 0,vec 1] PCROSS v) SUBSET c /\
                      (!y. y IN v ==> k(pastecart (vec 0) y) = f y) /\
                      (!z. z IN interval[vec 0,vec 1] PCROSS v
                           ==> h z :real^N = p(k z))")
    MP_TAC THENL
     [ALL_TAC,
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
       [RIGHT_IMP_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"v:real^P->real^P->bool", ← q r"fs:real^P->real^(1,P)finite_sum->real^M"] THEN
      DISCH_THEN (LABEL_TAC "*") THEN
      MP_TAC (← ISPECL
       [← q r"subtopology euclidean
          ((interval[vec 0,vec 1] PCROSS u):real^(1,P)finite_sum->bool)",
        ← q r"euclidean:(real^M)topology",
        ← q r"fs:real^P->real^(1,P)finite_sum->real^M",
        ← q r"(\x. interval[vec 0,vec 1] PCROSS (v x))
            :real^P->real^(1,P)finite_sum->bool",
        ← q r"u:real^P->bool"] PASTING_LEMMA_EXISTS) THEN
      REWRITE_TAC [CONTINUOUS_MAP_EUCLIDEAN, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
                  SUBTOPOLOGY_SUBTOPOLOGY] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"open_in a b /\ c <=> ~(open_in a b ==> ~c)")] THEN
      SIMP_TAC [← ISPEC (← q r"euclidean") OPEN_IN_IMP_SUBSET,
               ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
      REWRITE_TAC [NOT_IMP] THEN
      ASM_SIMP_TAC [SUBSET_UNIV] THEN ANTS_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"k:real^(1,P)finite_sum->real^M") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_PCROSS, SUBSET] THEN
        REPEAT CONJ_TAC THEN TRY (X_GEN_TAC (← q r"t:real^1")) THEN
        X_GEN_TAC (← q r"y:real^P") THEN STRIP_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"pastecart (t:real^1) (y:real^P)", ← q r"y:real^P"]),
          FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"pastecart (vec 0:real^1) (y:real^P)", ← q r"y:real^P"]),
          FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"pastecart (t:real^1) (y:real^P)", ← q r"y:real^P"])] THEN
        ASM_SIMP_TAC [PASTECART_IN_PCROSS, IN_INTER, ENDS_IN_UNIT_INTERVAL] THEN
        DISCH_THEN SUBST1_TAC THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^P")) THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [PASTECART_IN_PCROSS]] THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_PCROSS, UNIONS_GSPEC, IN_ELIM_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"t:real^1", ← q r"y:real^P"] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"y:real^P") THEN ASM_SIMP_TAC [PASTECART_IN_PCROSS],
        X_GEN_TAC (← q r"y:real^P") THEN DISCH_TAC THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"y:real^P")) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
        REWRITE_TAC [OPEN_IN_OPEN] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^P->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(:real^1) PCROSS (t:real^P->bool)") THEN
        ASM_SIMP_TAC [← REWRITE_RULE [← GSYM PCROSS] OPEN_PCROSS, OPEN_UNIV] THEN
        REWRITE_TAC [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS,
                      IN_INTER, IN_UNIV] THEN
        REPEAT GEN_TAC THEN CONV_TAC (fun t => TAUT t),
        REWRITE_TAC [FORALL_PASTECART, IN_INTER, PASTECART_IN_PCROSS] THEN
        MAP_EVERY X_GEN_TAC
         [← q r"x:real^P", ← q r"z:real^P", ← q r"t:real^1", ← q r"y:real^P"] THEN
        REWRITE_TAC [CONJ_ACI] THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o
          ISPECL [← q r"h:real^(1,P)finite_sum->real^N",
                  ← q r"(fs:real^P->real^(1,P)finite_sum->real^M) x",
                  ← q r"(fs:real^P->real^(1,P)finite_sum->real^M) z",
                  ← q r"interval[vec 0:real^1,vec 1] PCROSS {y:real^P}",
                  ← q r"pastecart (vec 0:real^1) (y:real^P)",
                  ← q r"pastecart (t:real^1) (y:real^P)"] o
          MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_UNIQUE)) THEN
        DISCH_THEN MATCH_MP_TAC THEN
        ASM_SIMP_TAC [PASTECART_IN_PCROSS, IN_SING, ENDS_IN_UNIT_INTERVAL] THEN
        SIMP_TAC [← REWRITE_RULE [← GSYM PCROSS] CONNECTED_PCROSS,
                 CONNECTED_INTERVAL, CONNECTED_SING] THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          REWRITE_TAC [FORALL_PASTECART, SUBSET, PASTECART_IN_PCROSS] THEN
          ASM_SIMP_TAC [IN_SING],
          ALL_TAC] THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
          MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [FORALL_PASTECART, SUBSET, PASTECART_IN_PCROSS] THEN
          ASM_SIMP_TAC [IN_SING],
          ALL_TAC] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> (p /\ q /\ r) /\ s")] THEN
        CONJ_TAC THENL
         [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"x:real^P")),
          REMOVE_THEN "*" (MP_TAC o SPEC (← q r"z:real^P"))] THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC, SUBSET, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [FORALL_PASTECART, PASTECART_IN_PCROSS, IN_SING] THEN
        STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [FORALL_PASTECART, SUBSET, PASTECART_IN_PCROSS] THEN
        ASM_SIMP_TAC [IN_SING]]] THEN
    X_GEN_TAC (← q r"y:real^P") THEN DISCH_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← liftExcept (last (CONJUNCTS
        (← GEN_REWRITE_RULE id [covering_space] th)))))) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"uu:real^N->real^N->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!t. t IN interval[vec 0,vec 1]
          ==> ?k n i:real^N.
                  open_in (subtopology euclidean (interval[vec 0,vec 1])) k /\
                  open_in (subtopology euclidean u) n /\
                  t IN k /\ y IN n /\ i IN s /\
                  IMAGE (h:real^(1,P)finite_sum->real^N) (k PCROSS n) SUBSET uu i")
    MP_TAC THENL
     [X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(h:real^(1,P)finite_sum->real^N) (pastecart t y) IN s")
