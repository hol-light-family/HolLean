    SIMP_TAC [← GSYM INT_LE_ANTISYM, DIMENSION_SUBSET, DELETE_SUBSET] THEN
    TRANS_TAC INT_LE_TRANS (← q r"dimension((a:real^N) INSERT (s DELETE a))") THEN
    SIMP_TAC [DIMENSION_SUBSET, ← SET_RULE (← q r"s SUBSET a INSERT (s DELETE a)")] THEN
    ASM_REWRITE_TAC [DIMENSION_INSERT, INT_LE_REFL])

  let DIMENSION_LE_EQ_GEN ← prove
   r"!s:real^N->bool n.
        dimension s <= n <=>
