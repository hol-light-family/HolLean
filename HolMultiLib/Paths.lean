                          FINITE(components(s DIFF u))"
   (GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC SEMI_LOCALLY_CONNECTED_GEN THEN
    ASM_SIMP_TAC [FINITE_COMPONENTS, CLOSED_IMP_LOCALLY_COMPACT,
