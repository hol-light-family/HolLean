        X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CLOSED_IN_DIFF THEN ASM_SIMP_TAC [] THEN
          MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [],
          MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_SIMP_TAC [] THEN
          MATCH_MP_TAC CLOSED_IN_UNIONS THEN
          ASM_SIMP_TAC [FINITE_DELETE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
          ASM SET_TAC [],
          MATCH_MP_TAC (← SET_RULE
           (← q r"c SUBSET s /\ (!d. d IN u ==> DISJOINT c d)
            ==> c SUBSET s DIFF UNIONS u")) THEN
          CONJ_TAC THENL
           [ASM_MESON_TAC [IN_COMPONENTS_SUBSET, SUBSET],
            REWRITE_TAC [IN_DELETE, FORALL_IN_IMAGE] THEN
            ASM_MESON_TAC [← REWRITE_RULE [pairwise] PAIRWISE_DISJOINT_COMPONENTS,
                          SUBSET]],
          SET_TAC []]],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"d:real^N->bool")) THEN
    EXISTS_TAC (← q r"\c. if c = d then s DIFF UNIONS (IMAGE l (u DELETE d))
                    else (l:(real^N->bool)->(real^N->bool)) c") THEN
    REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r /\ s <=> p /\ (q /\ r) /\ s")] THEN
    REWRITE_TAC [PAIRWISE_AND] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
        MATCH_MP_TAC CLOSED_IN_UNIONS THEN
        ASM_SIMP_TAC [FINITE_DELETE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        ASM SET_TAC [],
        MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [],
        MATCH_MP_TAC (← SET_RULE
         (← q r"c SUBSET s /\ (!d. d IN u ==> DISJOINT c d)
          ==> c SUBSET s DIFF UNIONS u")) THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [IN_COMPONENTS_SUBSET, SUBSET], ALL_TAC] THEN
        REWRITE_TAC [IN_DELETE, FORALL_IN_IMAGE] THEN
        ASM_MESON_TAC [← SET_RULE (← q r"c SUBSET c' /\ DISJOINT c' d ==> DISJOINT c d")]],
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
       (← q r"a IN s ==> s = a INSERT (s DELETE a)"))) THEN
      REWRITE_TAC [PAIRWISE_INSERT] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT (s DELETE a) = s")] THEN
      SUBGOAL_THEN
       (← q r"!c:real^N->bool. c IN u ==> ~(l c:real^N->bool = {})")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET_EMPTY, IN_COMPONENTS_NONEMPTY, SUBSET],
        ALL_TAC] THEN
      ASM_SIMP_TAC [IN_DELETE, pairwise, ← SET_RULE
        (← q r"~(c' = {}) ==> ((~(c = c') /\ DISJOINT c c') /\
                         (~(c' = c) /\ DISJOINT c' c) <=> DISJOINT c c')")] THEN
      ASM SET_TAC [],
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
       (← q r"a IN s ==> s = a INSERT (s DELETE a)"))) THEN
      REWRITE_TAC [IMAGE_CLAUSES, UNIONS_INSERT] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT (s DELETE a) = s")] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"IMAGE (\x. if x = a then f x else g x) (s DELETE a) =
        IMAGE g (s DELETE a)")] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"u SUBSET s ==> (s DIFF u) UNION u = s")) THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE, IN_DELETE] THEN
      ASM_MESON_TAC [OPEN_IN_IMP_SUBSET]])

  return { COMPONENTS_SUBSETS_CLOPEN_PARTITION }

/- ------------------------------------------------------------------------- -/
/- Relations between components and path components.                         -/
/- (paths.ml 10677-10999)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PUG where
  OPEN_CONNECTED_COMPONENT : thm
  IN_CLOSURE_CONNECTED_COMPONENT : thm
  PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT : thm
  PATH_COMPONENT_EQ_CONNECTED_COMPONENT : thm
  PATH_COMPONENT_IMP_CONNECTED_COMPONENT : thm
  LOCALLY_PATH_CONNECTED_PATH_COMPONENT : thm
  OPEN_PATH_CONNECTED_COMPONENT : thm
  PATH_CONNECTED_EQ_CONNECTED_LPC : thm
  PATH_CONNECTED_EQ_CONNECTED : thm
  CONNECTED_OPEN_PATH_CONNECTED : thm
  CONNECTED_OPEN_ARC_CONNECTED : thm
  OPEN_COMPONENTS : thm
  COMPONENTS_OPEN_UNIQUE : thm
  COUNTABLE_OPEN_COMPONENTS : thm
  COUNTABLE_OPEN_CONNECTED_COMPONENTS : thm
  CONTINUOUS_ON_COMPONENTS : thm
  CONTINUOUS_ON_COMPONENTS_EQ : thm
  CONTINUOUS_ON_COMPONENTS_OPEN : thm
  CONTINUOUS_ON_COMPONENTS_OPEN_EQ : thm
  CLOSED_IN_UNION_COMPLEMENT_COMPONENTS : thm
  CLOSED_UNION_COMPLEMENT_COMPONENTS : thm
  CLOSED_IN_UNION_COMPLEMENT_COMPONENT : thm
  CLOSED_UNION_COMPLEMENT_COMPONENT : thm
  NONSEPARATED_CLOSED_COMPLEMENT_COMPONENTS : thm
  COUNTABLE_CONNECTED_COMPONENTS : thm
  COUNTABLE_PATH_COMPONENTS : thm
  COUNTABLE_COMPONENTS : thm
  deriving Inhabited

@[nospecialize]
def setupPUG [HolBase] (D : PathsDeps) (BK : PTK) (BR : PTR) (BS : PTS) :
    ExceptT String IO PUG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_UNIONS, ETA_AX, EXTENSION, FORALL_IN_GSPEC, .. } :=
    D.cvx.core1
  let { IN, IN_DIFF, .. } := D.cvx.core2
  let { IN_INSERT, IN_INTER, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_IMP, .. } :=
    D.cvx.core3
  let { SING_SUBSET, SUBSET, SUBSET_DIFF, .. } := D.cvx.core5
  let { UNIONS_UNION, UNION_SUBSET, pairwise, .. } := D.cvx.core6
  let { CLOSED_IN_DIFF, CLOSURE_OF_SUBTOPOLOGY, OPEN_IN_DIFF, OPEN_IN_TRANS, SUBTOPOLOGY_UNIV,
        closed_in, .. } := D.cvx.met
  let { CENTRE_IN_BALL, CLOSED_IN, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, CONNECTED_CLOPEN, CONNECTED_COMPONENT_MAXIMAL,
        CONNECTED_COMPONENT_OVERLAP, CONNECTED_COMPONENT_SUBSET, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, EUCLIDEAN_CLOSURE_OF, .. } := D.cvx.top3
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        OPEN_CONTAINS_BALL, .. } := D.cvx.top4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        UNIONS_COMPONENTS, components, .. } := D.cvx.top5
  let { SUBSET_UNIONS, UNIONS_1, .. } := D.pses2
  let { COUNTABLE_INSERT, COUNTABLE_SUBSET, .. } := D.pcard
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET, CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_UNION, .. } :=
    D.pmet1
  let { OPEN_IN_UNIONS, PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF,
        PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF, .. } := D.pmet2
  let { CLOSED_IN_REFL, COMPLEMENT_CONNECTED_COMPONENT_UNIONS, .. } := D.ptop1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_EQ_EMPTY, CONNECTED_COMPONENT_OF_EUCLIDEAN,
        CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE, CONNECTED_IFF_CONNECTED_COMPONENT,
        CONTINUOUS_ON_COMPONENTS_GEN, .. } := D.ptop2
  let { COUNTABLE_DISJOINT_OPEN_SUBSETS, .. } := D.ptop3
  let { IN_COMPONENTS, LINDELOF_OPEN_IN, LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { OPEN_UNIONS, PAIRWISE_DISJOINT_COMPONENTS, UNIONS_CONNECTED_COMPONENT, .. } := D.ptop5
  let { CONNECTED_BALL, .. } := D.pcvx1
  let { PATH_COMPONENT_OF_EUCLIDEAN, PATH_COMPONENT_REFL, PATH_COMPONENT_EQ_EMPTY,
        UNIONS_PATH_COMPONENT, PATH_CONNECTED_IFF_PATH_COMPONENT,
        COMPLEMENT_PATH_COMPONENT_UNIONS, .. } := BK
  let { PATH_CONNECTED_ARCWISE, .. } := BR
  let { LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_CONNECTED_OPEN_COMPONENT,
        LOCALLY_PATH_CONNECTED_CONNECTED_COMPONENT, OPEN_IMP_LOCALLY_PATH_CONNECTED,
        OPEN_IMP_LOCALLY_CONNECTED, LOCALLY_CONNECTED_UNIV,
        OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED, OPEN_IN_COMPONENTS_LOCALLY_CONNECTED,
        OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED, .. } := BS
  -- @@SCOPE END

  let OPEN_CONNECTED_COMPONENT ← prove
   r"!s x:real^N. open s ==> open(connected_component s x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET, CONNECTED_COMPONENT_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"connected_component s (x:real^N) = connected_component s y")
    SUBST1_TAC THENL
     [ASM_MESON_TAC [CONNECTED_COMPONENT_EQ],
      MATCH_MP_TAC CONNECTED_COMPONENT_MAXIMAL THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL, CONNECTED_BALL]])

  let IN_CLOSURE_CONNECTED_COMPONENT ← prove
   r"!x y:real^N.
        x IN s /\ open s
        ==> (x IN closure(connected_component s y) <=>
             x IN connected_component s y)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [← REWRITE_RULE [SUBSET] CLOSURE_SUBSET] THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"~((connected_component s (x:real^N)) INTER
        closure(connected_component s y) = {})")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"x:real^N") THEN
      ASM_REWRITE_TAC [IN_INTER] THEN
      ASM_REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ],
      ASM_SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_CONNECTED_COMPONENT] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_OVERLAP] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_REWRITE_TAC [IN, CONNECTED_COMPONENT_REFL_EQ]])

  let PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT ← prove
   r"!s x:real^N. (path_component s x) SUBSET (connected_component s x)"
   (REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN,
                ← GSYM CONNECTED_COMPONENT_OF_EUCLIDEAN] THEN
    REWRITE_TAC [PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF])

  let PATH_COMPONENT_EQ_CONNECTED_COMPONENT ← prove
   r"!s x:real^N.
        locally path_connected s
        ==> (path_component s x = connected_component s x)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM PATH_COMPONENT_OF_EUCLIDEAN,
                ← GSYM CONNECTED_COMPONENT_OF_EUCLIDEAN] THEN
    MATCH_MP_TAC PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF THEN
    ASM_REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN])

  let PATH_COMPONENT_IMP_CONNECTED_COMPONENT ← prove
   r"!s a b:real^N. path_component s a b ==> connected_component s a b"
   (REWRITE_TAC [← SET_RULE (← q r"(!x. P x ==> Q x) <=> P SUBSET Q")] THEN
    REWRITE_TAC [PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT, ETA_AX])

  let LOCALLY_PATH_CONNECTED_PATH_COMPONENT ← prove
   r"!s x:real^N.
        locally path_connected s
        ==> locally path_connected (path_component s x)"
   (MESON_TAC [LOCALLY_PATH_CONNECTED_CONNECTED_COMPONENT,
              PATH_COMPONENT_EQ_CONNECTED_COMPONENT])

  let OPEN_PATH_CONNECTED_COMPONENT ← prove
   r"!s x:real^N. open s ==> path_component s x = connected_component s x"
   (SIMP_TAC [PATH_COMPONENT_EQ_CONNECTED_COMPONENT,
    OPEN_IMP_LOCALLY_PATH_CONNECTED])

  let PATH_CONNECTED_EQ_CONNECTED_LPC ← prove
   r"!s. locally path_connected s ==> (path_connected s <=> connected s)"
   (REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT,
                CONNECTED_IFF_CONNECTED_COMPONENT] THEN
    SIMP_TAC [PATH_COMPONENT_EQ_CONNECTED_COMPONENT])

  let PATH_CONNECTED_EQ_CONNECTED ← prove
   r"!s. open s ==> (path_connected s <=> connected s)"
   (SIMP_TAC [PATH_CONNECTED_EQ_CONNECTED_LPC, OPEN_IMP_LOCALLY_PATH_CONNECTED])

  let CONNECTED_OPEN_PATH_CONNECTED ← prove
   r"!s:real^N->bool. open s /\ connected s ==> path_connected s"
   (SIMP_TAC [PATH_CONNECTED_EQ_CONNECTED])

  let CONNECTED_OPEN_ARC_CONNECTED ← prove
   r"!s:real^N->bool.
      open s /\ connected s
      ==> !x y. x IN s /\ y IN s
                ==> x = y \/
                    ?g. arc g /\
                        path_image g SUBSET s /\
                        pathstart g = x /\
                        pathfinish g = y"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_OPEN_PATH_CONNECTED) THEN
    REWRITE_TAC [PATH_CONNECTED_ARCWISE] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN MESON_TAC [])

  let OPEN_COMPONENTS ← prove
   r"!u:real^N->bool s. open u /\ s IN components u ==> open s"
   (REPEAT STRIP_TAC THEN STRIP_ASSUME_TAC (← MESON [IN_COMPONENTS,
    ← ASSUME (← q r"s:real^N->bool IN components u")] (← q r"?x. s:real^N->bool =
    connected_component u x")) THEN ASM_SIMP_TAC [OPEN_CONNECTED_COMPONENT])

  let COMPONENTS_OPEN_UNIQUE ← prove
   r"!f:(real^N->bool)->bool s.
        (!c. c IN f ==> open c /\ connected c /\ ~(c = {})) /\
        pairwise DISJOINT f /\ UNIONS f = s
        ==> components s = f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_DISJOINT_UNIONS_OPEN_UNIQUE THEN
    ASM_REWRITE_TAC [← GSYM UNIONS_COMPONENTS, PAIRWISE_DISJOINT_COMPONENTS] THEN
    ASM_MESON_TAC [OPEN_COMPONENTS, IN_COMPONENTS_NONEMPTY,
                  IN_COMPONENTS_CONNECTED, OPEN_UNIONS])

  let COUNTABLE_OPEN_COMPONENTS ← prove
   r"!s:real^N->bool. open s ==> COUNTABLE(components s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COUNTABLE_DISJOINT_OPEN_SUBSETS THEN
    REWRITE_TAC [PAIRWISE_DISJOINT_COMPONENTS] THEN
    ASM_MESON_TAC [OPEN_COMPONENTS])

  let COUNTABLE_OPEN_CONNECTED_COMPONENTS ← prove
   r"!s t:real^N->bool.
        open s ==> COUNTABLE {connected_component s x | x IN t}"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"{} INSERT components(s:real^N->bool)") THEN
    ASM_SIMP_TAC [COUNTABLE_INSERT, COUNTABLE_OPEN_COMPONENTS] THEN
    REWRITE_TAC [SUBSET, IN_INSERT, components, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY] THEN SET_TAC [])

  let CONTINUOUS_ON_COMPONENTS ← prove
   r"!f:real^M->real^N s.
        locally connected s /\ (!c. c IN components s ==> f continuous_on c)
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_COMPONENTS_GEN THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [OPEN_IN_COMPONENTS_LOCALLY_CONNECTED])

  let CONTINUOUS_ON_COMPONENTS_EQ ← prove
   r"!f s. locally connected s
         ==> (f continuous_on s <=>
              !c. c IN components s ==> f continuous_on c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONTINUOUS_ON_SUBSET, IN_COMPONENTS_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_COMPONENTS]])

  let CONTINUOUS_ON_COMPONENTS_OPEN ← prove
   r"!f:real^M->real^N s.
        open s /\ (!c. c IN components s ==> f continuous_on c)
        ==> f continuous_on s"
   (ASM_MESON_TAC [CONTINUOUS_ON_COMPONENTS, OPEN_IMP_LOCALLY_CONNECTED])

  let CONTINUOUS_ON_COMPONENTS_OPEN_EQ ← prove
   r"!f s. open s
         ==> (f continuous_on s <=>
              !c. c IN components s ==> f continuous_on c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONTINUOUS_ON_SUBSET, IN_COMPONENTS_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_COMPONENTS_OPEN]])

  let CLOSED_IN_UNION_COMPLEMENT_COMPONENTS ← prove
   r"!u s:real^N->bool c.
        locally connected u /\
        closed_in (subtopology euclidean u) s /\ c SUBSET components(u DIFF s)
        ==> closed_in (subtopology euclidean u) (s UNION UNIONS c)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"s UNION UNIONS c:real^N->bool =
      u DIFF (UNIONS(components(u DIFF s) DIFF c))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET u /\ u DIFF s = c UNION c' /\ DISJOINT c c'
        ==> s UNION c = u DIFF c'")) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      ASM_SIMP_TAC [← GSYM UNIONS_UNION, ← GSYM UNIONS_COMPONENTS, ← SET_RULE
       (← q r"s SUBSET t ==> s UNION (t DIFF s) = t")] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!s t. s IN c /\ t IN c' ==> DISJOINT s t)
        ==> DISJOINT (UNIONS c) (UNIONS c')")) THEN
      REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"(u:real^N->bool) DIFF s")
         PAIRWISE_DISJOINT_COMPONENTS) THEN
      REWRITE_TAC [pairwise] THEN DISCH_THEN MATCH_MP_TAC THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN ASM_MESON_TAC [],
      REWRITE_TAC [closed_in, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, SUBSET_DIFF] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_REFL] THEN
      MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [IN_DIFF] THEN
      X_GEN_TAC (← q r"d:real^N->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC OPEN_IN_TRANS THEN
      EXISTS_TAC (← q r"u DIFF s:real^N->bool") THEN CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_COMPONENTS_LOCALLY_CONNECTED THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
        EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_SIMP_TAC [OPEN_IN_REFL]])

  let CLOSED_UNION_COMPLEMENT_COMPONENTS ← prove
   r"!s c. closed s /\ c SUBSET components((:real^N) DIFF s)
         ==> closed(s UNION UNIONS c)"
   (ONCE_REWRITE_TAC [CLOSED_IN] THEN ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_UNION_COMPLEMENT_COMPONENTS THEN
    ASM_REWRITE_TAC [LOCALLY_CONNECTED_UNIV])

  let CLOSED_IN_UNION_COMPLEMENT_COMPONENT ← prove
   r"!u s c:real^N->bool.
        locally connected u /\
        closed_in (subtopology euclidean u) s /\
        c IN components(u DIFF s)
        ==> closed_in (subtopology euclidean u) (s UNION c)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (fun c => RAND_CONV (RAND_CONV c)) [← GSYM UNIONS_1] THEN
    MATCH_MP_TAC CLOSED_IN_UNION_COMPLEMENT_COMPONENTS THEN
    ASM_REWRITE_TAC [SING_SUBSET])

  let CLOSED_UNION_COMPLEMENT_COMPONENT ← prove
   r"!s c. closed s /\ c IN components((:real^N) DIFF s) ==> closed(s UNION c)"
   (ONCE_REWRITE_TAC [CLOSED_IN] THEN ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_UNION_COMPLEMENT_COMPONENT THEN
    ASM_REWRITE_TAC [LOCALLY_CONNECTED_UNIV])

  let NONSEPARATED_CLOSED_COMPLEMENT_COMPONENTS ← prove
   r"!u s:real^N->bool c.
        connected u /\ locally connected u /\
        closed_in (subtopology euclidean u) s /\ ~(s = {}) /\
        c SUBSET components(u DIFF s) /\ ~(c = {})
        ==> ~(s INTER closure(UNIONS c) = {})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"s:real^N->bool",
                    ← q r"c:(real^N->bool)->bool"]
          CLOSED_IN_UNION_COMPLEMENT_COMPONENTS) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY, UNION_SUBSET] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [CLOSURE_OF_UNION] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"DISJOINT t u /\ ~(t SUBSET v) ==> ~(s UNION t SUBSET u UNION v)")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, EUCLIDEAN_CLOSURE_OF] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"c SUBSET u ==> u INTER c = c")] THEN
      ASM SET_TAC [],
      W (MP_TAC o PART_MATCH (rand o lhand) CLOSURE_OF_SUBSET_EQ o
        rand o snd) THEN
      ASM_REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
      DISCH_THEN SUBST1_TAC THEN DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"UNIONS c:real^N->bool") o
      GEN_REWRITE_RULE id [CONNECTED_CLOPEN]) THEN
    ASM_REWRITE_TAC [NOT_IMP, DE_MORGAN_THM] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_UNIONS THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id
        [LOCALLY_CONNECTED_OPEN_COMPONENT]) THEN
      EXISTS_TAC (← q r"u DIFF (s:real^N->bool)") THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_REFL] THEN
      ASM SET_TAC [],
      REWRITE_TAC [EMPTY_UNIONS] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, IN_COMPONENTS_NONEMPTY, SUBSET],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s INTER closure c = {}
        ==> c SUBSET closure c /\ s SUBSET u /\ ~(s = {})
            ==>  ~(c = u)"))) THEN
      ASM_SIMP_TAC [CLOSURE_SUBSET, CLOSED_IN_SUBSET]])

  let COUNTABLE_CONNECTED_COMPONENTS ← prove
   r"!s:real^N->bool t.
    locally connected s ==> COUNTABLE {connected_component s x | x IN t}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{connected_component s (x:real^N) |x| x IN s}",
                    ← q r"s:real^N->bool"] LINDELOF_OPEN_IN) THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, OPEN_IN_CONNECTED_COMPONENT_LOCALLY_CONNECTED,
                 UNIONS_CONNECTED_COMPONENT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"({}:real^N->bool) INSERT u") THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_INSERT] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [CONNECTED_COMPONENT_EQ_EMPTY] THEN
    DISCH_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
      COMPLEMENT_CONNECTED_COMPONENT_UNIONS) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    REWRITE_TAC [EXTENSION] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_REWRITE_TAC [IN_DIFF] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN connected_component s x") THENL
     [ALL_TAC, ASM_MESON_TAC [IN, CONNECTED_COMPONENT_REFL]] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(x:real^N) IN UNIONS u") MP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
    MATCH_MP_TAC SUBSET_UNIONS THEN ASM SET_TAC [])

  let COUNTABLE_PATH_COMPONENTS ← prove
   r"!s:real^N->bool t.
    locally path_connected s ==> COUNTABLE {path_component s x | x IN t}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{path_component s (x:real^N) |x| x IN s}",
                    ← q r"s:real^N->bool"] LINDELOF_OPEN_IN) THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, OPEN_IN_PATH_COMPONENT_LOCALLY_PATH_CONNECTED,
                 UNIONS_PATH_COMPONENT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^N->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"({}:real^N->bool) INSERT u") THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_INSERT] THEN
    X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [PATH_COMPONENT_EQ_EMPTY] THEN
    DISCH_TAC THEN ASM_CASES_TAC (← q r"(x:real^N) IN s") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"x:real^N"]
      COMPLEMENT_PATH_COMPONENT_UNIONS) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
    REWRITE_TAC [EXTENSION] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN
    ASM_REWRITE_TAC [IN_DIFF] THEN
    ASM_CASES_TAC (← q r"(x:real^N) IN path_component s x") THENL
     [ALL_TAC, ASM_MESON_TAC [IN, PATH_COMPONENT_REFL]] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(x:real^N) IN UNIONS u") MP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
    MATCH_MP_TAC SUBSET_UNIONS THEN ASM SET_TAC [])

  let COUNTABLE_COMPONENTS ← prove
   r"!s:real^N->bool. locally connected s ==> COUNTABLE(components s)"
   (SIMP_TAC [components, COUNTABLE_CONNECTED_COMPONENTS])

  return { OPEN_CONNECTED_COMPONENT, IN_CLOSURE_CONNECTED_COMPONENT,
           PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT, PATH_COMPONENT_EQ_CONNECTED_COMPONENT,
           PATH_COMPONENT_IMP_CONNECTED_COMPONENT, LOCALLY_PATH_CONNECTED_PATH_COMPONENT,
           OPEN_PATH_CONNECTED_COMPONENT, PATH_CONNECTED_EQ_CONNECTED_LPC,
           PATH_CONNECTED_EQ_CONNECTED, CONNECTED_OPEN_PATH_CONNECTED,
           CONNECTED_OPEN_ARC_CONNECTED, OPEN_COMPONENTS, COMPONENTS_OPEN_UNIQUE,
           COUNTABLE_OPEN_COMPONENTS, COUNTABLE_OPEN_CONNECTED_COMPONENTS,
           CONTINUOUS_ON_COMPONENTS, CONTINUOUS_ON_COMPONENTS_EQ, CONTINUOUS_ON_COMPONENTS_OPEN,
           CONTINUOUS_ON_COMPONENTS_OPEN_EQ, CLOSED_IN_UNION_COMPLEMENT_COMPONENTS,
           CLOSED_UNION_COMPLEMENT_COMPONENTS, CLOSED_IN_UNION_COMPLEMENT_COMPONENT,
           CLOSED_UNION_COMPLEMENT_COMPONENT, NONSEPARATED_CLOSED_COMPLEMENT_COMPONENTS,
           COUNTABLE_CONNECTED_COMPONENTS, COUNTABLE_PATH_COMPONENTS, COUNTABLE_COMPONENTS }

/- ------------------------------------------------------------------------- -/
/- Minimal separating closed sets; "boundary bumping theorems" and           -/
/- relatives.  (paths.ml 11000-11292)                                        -/
/- ------------------------------------------------------------------------- -/

structure PUH where
  FRONTIER_MINIMAL_SEPARATING_CLOSED : thm
  FRONTIER_MINIMAL_SEPARATING_CLOSED_POINTWISE : thm
  CONNECTED_COMPONENT_DIFF_NONSEPARATED : thm
  CONNECTED_COMPONENT_DIFF_NONSEPARATED_ALT : thm
  CONNECTED_COMPONENT_DIFF_CLOSED_NONSEPARATED : thm
  NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT : thm
  CONNECTED_EQ_NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT : thm
  CONNECTED_EQ_COMPONENT_DIFF_CLOSED_NONSEPARATED : thm
  CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUH [HolBase] (D : PathsDeps) (BUD : PUD) (BUG : PUG) : ExceptT String IO PUH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, NORM_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DIFF_EQ_EMPTY, DISJ_ASSOC, EQ_TRANS,
        EXTENSION, FINITE_DELETE, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_INSERT, IMP_CONJ, IN, INTERS_GSPEC, INTERS_INSERT, INTER_COMM, IN_DELETE,
        IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, IN_UNIV, MEMBER_NOT_EMPTY,
        NOT_IMP, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_NOT_LT, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, .. } :=
    D.cvx.core5
  let { SUBSET_UNIV, UNIONS_GSPEC, UNIONS_INSERT, pairwise, .. } := D.cvx.core6
  let { REAL_HALF, .. } := D.cvx.misc
  let { VECTOR_ADD_RID, .. } := D.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS, .. } := D.cvx.met
  let { BOUNDED_SUBSET, CENTRE_IN_BALL, CLOSED_CLOSURE, CLOSED_IMP_LOCALLY_COMPACT,
        CLOSED_SUBSET, CLOSURE_CLOSED, .. } := D.cvx.top1
  let { CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_COMPONENTS,
        COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPONENTS_EQ_EMPTY, CONNECTED_CLOPEN,
        CONNECTED_INSERT, CONNECTED_INTER_FRONTIER, CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { EUCLIDEAN_CLOSURE_OF, FRONTIER_CLOSED, .. } := D.cvx.top3
  let { INTERIOR_MAXIMAL, INTERIOR_OPEN, INTERIOR_SUBSET, IN_BALL_0, IN_COMPONENTS_CONNECTED,
        IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET, OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_IN_OPEN_INTER, SETDIST_CLOSURE, SETDIST_LE_DIST, TOPSPACE_EUCLIDEAN,
        UNIONS_COMPONENTS, closed, connected, frontier, .. } := D.cvx.top5
  let { EMPTY_UNION, .. } := D.pses1
  let { UNIONS_1, .. } := D.pses2
  let { CLOSED_IN_IMP_SUBSET, CLOSED_IN_SUBSET, CONNECTED_IN_EQ_NOT_SEPARATED, .. } := D.pmet1
  let { SEPARATED_IN_SING, SEPARATED_IN_UNION, SEPARATED_IN_UNIONS, .. } := D.pmet2
  let { CLOSED_IN_CLOSED_EQ, CLOSED_IN_SING, COMPACT_DIFF, COMPONENTS_EMPTY, .. } := D.ptop1
  let { COMPONENTS_INTERMEDIATE_SUBSET, COMPONENTS_NONOVERLAP, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_EQ_CONNECTED_COMPONENTS_EQ, CONNECTED_SING, CONNECTED_UNIONS,
        CONNECTED_UNION_STRONG, .. } := D.ptop2
  let { INTERIOR_COMPLEMENT, IN_COMPONENTS, IN_COMPONENTS_UNIONS_COMPLEMENT, .. } := D.ptop4
  let { OPEN_SUMS, PAIRWISE_SEPARATED_COMPONENTS, SETDIST_EQ_0_COMPACT_CLOSED, SETDIST_POS_LT,
        T1_SPACE_EUCLIDEAN, connected_component, .. } := D.ptop5
  let { FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT, .. } := D.pcvx2
  let { COMPONENT_CLOPEN_HAUSDIST_EXPLICIT, .. } := BUD
  let { OPEN_COMPONENTS, NONSEPARATED_CLOSED_COMPLEMENT_COMPONENTS, .. } := BUG
  -- @@SCOPE END

  let FRONTIER_MINIMAL_SEPARATING_CLOSED ← prove
   r"!s c. closed s /\ ~connected((:real^N) DIFF s) /\
         (!t. closed t /\ t PSUBSET s ==> connected((:real^N) DIFF t)) /\
         c IN components ((:real^N) DIFF s)
         ==> frontier c = s"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
      GEN_REWRITE_RULE RAND_CONV [CONNECTED_EQ_CONNECTED_COMPONENTS_EQ]) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
     (← q r"~(!x x'. x IN s /\ x' IN s ==> x = x')
      ==> !x. x IN s ==> ?y. y IN s /\ ~(y = x)"))) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"frontier c:real^N->bool")) THEN
    REWRITE_TAC [← SET_RULE (← q r"s PSUBSET t <=> s SUBSET t /\ ~(t SUBSET s)"),
                ← GSYM SUBSET_ANTISYM_EQ] THEN
    ASM_SIMP_TAC [FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT, FRONTIER_CLOSED] THEN
    MATCH_MP_TAC (← TAUT (← q r"~r ==> (~p ==> r) ==> p")) THEN
    REWRITE_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC [← q r"c:real^N->bool", ← q r"(:real^N) DIFF closure c"] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_COMPONENTS, closed],
      REWRITE_TAC [← GSYM closed, CLOSED_CLOSURE],
      MP_TAC (← ISPEC (← q r"c:real^N->bool") INTERIOR_SUBSET) THEN
      REWRITE_TAC [frontier] THEN SET_TAC [],
      MATCH_MP_TAC (← SET_RULE
       (← q r"c SUBSET c' ==> c INTER (UNIV DIFF c') INTER s = {}")) THEN
      REWRITE_TAC [← GSYM INTERIOR_COMPLEMENT, CLOSURE_SUBSET],
      REWRITE_TAC [frontier] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"ci = c /\ ~(c = {})
        ==> ~(c INTER (UNIV DIFF (cc DIFF ci)) = {})")) THEN
      ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY, INTERIOR_OPEN, closed,
                    OPEN_COMPONENTS],
      REWRITE_TAC [frontier] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"~(UNIV DIFF c = {})
        ==> ~((UNIV DIFF c) INTER (UNIV DIFF (c DIFF i)) = {})")) THEN
      REWRITE_TAC [← GSYM INTERIOR_COMPLEMENT] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"!t. t SUBSET s /\ ~(t = {}) ==> ~(s = {})")) THEN
      EXISTS_TAC (← q r"d:real^N->bool") THEN CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY]] THEN
      MATCH_MP_TAC INTERIOR_MAXIMAL THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
      ASM_MESON_TAC [COMPONENTS_NONOVERLAP, OPEN_COMPONENTS, ← GSYM closed]])

  let FRONTIER_MINIMAL_SEPARATING_CLOSED_POINTWISE ← prove
   r"!s a b. closed s /\ ~(a IN s) /\
           ~connected_component ((:real^N) DIFF s) a b /\
           (!t. closed t /\ t PSUBSET s
                ==> connected_component((:real^N) DIFF t) a b)
           ==> frontier(connected_component ((:real^N) DIFF s) a) = s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t /\ ~(s PSUBSET t) ==> s = t")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC FRONTIER_OF_COMPONENTS_CLOSED_COMPLEMENT THEN
      ASM_REWRITE_TAC [IN_COMPONENTS, IN_UNIV, IN_DIFF] THEN ASM SET_TAC [],
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"frontier (connected_component ((:real^N) DIFF s) a)")) THEN
      ASM_REWRITE_TAC [FRONTIER_CLOSED] THEN
      GEN_REWRITE_TAC RAND_CONV [connected_component] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"t SUBSET UNIV DIFF f ==> ~(t INTER f = {}) ==> F"))) THEN
      MATCH_MP_TAC CONNECTED_INTER_FRONTIER THEN
      ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_DIFF] THEN
      CONJ_TAC THENL [EXISTS_TAC (← q r"a:real^N"), EXISTS_TAC (← q r"b:real^N")] THEN
      ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ, IN_UNIV, IN_DIFF]])

  let CONNECTED_COMPONENT_DIFF_NONSEPARATED ← prove
   r"!s t c:real^N->bool.
        compact s /\ connected s /\ t SUBSET s /\ ~(t = {}) /\
        c IN components(s DIFF t)
        ==> ~(closure(c) INTER closure(t) = {})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s DIFF {x + d | (x:real^N) IN t /\
                                    d IN ball(vec 0,setdist(c,t) / &2)}",
                   ← q r"c:real^N->bool", ← q r"setdist(c:real^N->bool,t) / &2"]
          COMPONENT_CLOPEN_HAUSDIST_EXPLICIT) THEN
    REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC, REAL_HALF] THEN
    ABBREV_TAC (← q r"t' = {x + d | (x:real^N) IN t /\
                              d IN ball(vec 0,setdist(c,t) / &2)}") THEN
    SUBGOAL_THEN (← q r"open(t':real^N->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "t'" THEN SIMP_TAC [OPEN_SUMS, OPEN_BALL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"compact(s DIFF t':real^N->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC COMPACT_DIFF THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, CLOSED_IMP_LOCALLY_COMPACT]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [REWRITE_TAC [SETDIST_POS_LT] THEN
      MP_TAC (← ISPECL [← q r"closure c:real^N->bool", ← q r"closure t:real^N->bool"]
          SETDIST_EQ_0_COMPACT_CLOSED) THEN
      ASM_REWRITE_TAC [SETDIST_CLOSURE, CLOSED_CLOSURE, CLOSURE_EQ_EMPTY] THEN
      DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [COMPACT_CLOSURE] THEN
      MATCH_MP_TAC BOUNDED_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN ASM SET_TAC [],
      DISCH_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COMPONENTS_INTERMEDIATE_SUBSET)) THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"c SUBSET s DIFF t
          ==> (!x. x IN t' ==> ~(x IN c))
          ==> c SUBSET s DIFF t'"))) THEN
        EXPAND_TAC "t'" THEN REWRITE_TAC [FORALL_IN_GSPEC, IN_BALL_0] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real^N"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [REAL_NOT_LT] THEN
        DISCH_TAC THEN
        SUBST1_TAC (← NORM_ARITH (← q r"norm(d:real^N) = dist(x + d,x)")) THEN
        MATCH_MP_TAC (← NORM_ARITH
          (← q r"a <= dist(p:real^N,q) ==> a / &2 <= dist(p,q)")) THEN
        MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET t' ==> s DIFF t' SUBSET s DIFF t")) THEN
        EXPAND_TAC "t'" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"x:real^N", ← q r"vec 0:real^N"] THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL, VECTOR_ADD_RID, REAL_HALF]],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"compact(c:real^N->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_COMPONENTS], ASM_REWRITE_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^N->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOPEN]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"k:real^N->bool")) THEN
    ASM_REWRITE_TAC [NOT_IMP, DE_MORGAN_THM] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC CLOSED_SUBSET THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN SET_TAC [],
      ASM SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"t SUBSET s ==> ~(t = {}) /\ DISJOINT t k ==> ~(k = s)"))) THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"k SUBSET k' ==> (!x. x IN k' ==> ~(x IN t)) ==> DISJOINT t k"))) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_BALL_0] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real^N"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [REAL_NOT_LT] THEN
      DISCH_TAC THEN
      SUBST1_TAC (← NORM_ARITH (← q r"norm(d:real^N) = dist(x,x + d)")) THEN
      MATCH_MP_TAC (← NORM_ARITH
        (← q r"a <= dist(p:real^N,q) ==> a / &2 <= dist(p,q)")) THEN
      MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC
     (← q r"s INTER {x + d:real^N | x IN c /\ d IN ball(vec 0,setdist(c,t) / &2)}") THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_SUMS, OPEN_BALL] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          OPEN_IN_SUBSET_TRANS)) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. x IN u ==> !y. y IN t ==> ~(x = y))
      ==> s INTER u SUBSET s DIFF t")) THEN
    EXPAND_TAC "t'" THEN REWRITE_TAC [FORALL_IN_GSPEC, IN_BALL_0] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"d:real^N", ← q r"x':real^N",
                         ← q r"d':real^N"] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^N) IN c", ← q r"(x':real^N) IN t"] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"k <= dist(x:real^N,x')
      ==> norm d < k / &2 ==> norm d' < k / &2 ==> ~(x + d = x' + d')")) THEN
    MATCH_MP_TAC SETDIST_LE_DIST THEN ASM_REWRITE_TAC [])

  let CONNECTED_COMPONENT_DIFF_NONSEPARATED_ALT ← prove
   r"!s t c:real^N->bool.
        compact s /\ connected s /\ t PSUBSET s /\ c IN components t
        ==> ~(closure(c) INTER closure(s DIFF t) = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_DIFF_NONSEPARATED THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"t PSUBSET s ==> s DIFF (s DIFF t) = t")] THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_DIFF_CLOSED_NONSEPARATED ← prove
   r"!s t c:real^N->bool.
        compact s /\ connected s /\ closed t /\ t SUBSET s /\ ~(t = {}) /\
        c IN components(s DIFF t)
        ==> ~(closure(c) INTER t = {})"
   (MESON_TAC [CONNECTED_COMPONENT_DIFF_NONSEPARATED, CLOSURE_CLOSED])

  let NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT ← prove
   r"!u s c:real^N->bool.
        (compact u \/ locally connected u) /\
        connected u /\
        closed_in (subtopology euclidean u) s /\ ~(s = {}) /\
        c IN components(u DIFF s)
        ==> ~(s INTER closure c = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THENL
     [ONCE_REWRITE_TAC [INTER_COMM] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_DIFF_CLOSED_NONSEPARATED THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [COMPACT_IMP_CLOSED, CLOSED_IN_CLOSED_EQ, CLOSED_IN_SUBSET],
      GEN_REWRITE_TAC (fun c => RAND_CONV (LAND_CONV (RAND_CONV (RAND_CONV c))))
       [← GSYM UNIONS_1] THEN
      MATCH_MP_TAC NONSEPARATED_CLOSED_COMPLEMENT_COMPONENTS THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN
      ASM_REWRITE_TAC [NOT_INSERT_EMPTY, SING_SUBSET]])

  let CONNECTED_EQ_NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT ← prove
   r"!u s:real^N->bool.
        (compact u \/ locally connected u) /\
        closed_in (subtopology euclidean u) s /\
        connected s /\
        ~(s = {})
        ==> (connected u <=>
             !c. c IN components(u DIFF s) ==> ~(s INTER closure c = {}))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"u:real^N->bool = s") THEN
    ASM_REWRITE_TAC [DIFF_EQ_EMPTY, COMPONENTS_EMPTY, NOT_IN_EMPTY] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [ASM_MESON_TAC [NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"u = UNIONS {c UNION s:real^N->bool |c| c IN components(u DIFF s)}")
    SUBST1_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
      TRANS_TAC EQ_TRANS (← q r"UNIONS(components(u DIFF s)) UNION s:real^N->bool") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM UNIONS_COMPONENTS] THEN ASM SET_TAC [],
        SUBGOAL_THEN (← q r"~(components(u DIFF s:real^N->bool) = {})") MP_TAC THENL
         [REWRITE_TAC [COMPONENTS_EQ_EMPTY] THEN ASM SET_TAC [], ALL_TAC] THEN
        ONCE_REWRITE_TAC [EXTENSION] THEN
        REWRITE_TAC [NOT_IN_EMPTY, UNIONS_GSPEC] THEN
        REWRITE_TAC [IN_UNION, IN_UNIONS, IN_ELIM_THM] THEN MESON_TAC []],
      MATCH_MP_TAC CONNECTED_UNIONS THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC CONNECTED_UNION_STRONG THEN
        ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, INTER_COMM],
        REWRITE_TAC [INTERS_GSPEC] THEN ASM SET_TAC []]])

  let CONNECTED_EQ_COMPONENT_DIFF_CLOSED_NONSEPARATED ← prove
   r"!s:real^N->bool t.
        compact s /\ closed t /\ connected t /\ t SUBSET s /\ ~(t = {})
        ==> (connected s <=>
             !c. c IN components (s DIFF t) ==> ~(closure c INTER t = {}))"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    MATCH_MP_TAC CONNECTED_EQ_NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT THEN
    ASM_MESON_TAC [CLOSED_IN_CLOSED_EQ, COMPACT_IMP_CLOSED])

  let CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED ← prove
   r"!s:real^N->bool a:real^N.
        (compact s \/ locally connected s \/ FINITE(components(s DELETE a))) /\
        a IN s
        ==> (connected s <=>
             !c. c IN components (s DELETE a) ==> a IN closure c)"
   (REWRITE_TAC [DISJ_ASSOC] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN EQ_TAC THEN DISCH_TAC THENL
     [FIRST_X_ASSUM DISJ_CASES_TAC THENL
       [MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"{a:real^N}"]
          CONNECTED_EQ_NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT) THEN
        ASM_REWRITE_TAC [CLOSED_IN_SING, CONNECTED_SING, NOT_INSERT_EMPTY] THEN
        REWRITE_TAC [← SET_RULE (← q r"s DIFF {a} = s DELETE a")] THEN
        REWRITE_TAC [← SET_RULE (← q r"~({a} INTER s = {}) <=> a IN s")],
        REPEAT STRIP_TAC THEN UNDISCH_TAC (← q r"connected(s:real^N->bool)") THEN
        GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEAN] THEN
        REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED] THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN, SUBSET_UNIV] THEN MAP_EVERY EXISTS_TAC
         [← q r"c:real^N->bool",
          ← q r"{a:real^N} UNION UNIONS (components(s DELETE a) DELETE c)"] THEN
        REWRITE_TAC [NOT_INSERT_EMPTY, EMPTY_UNION] THEN REPEAT CONJ_TAC THENL
         [ASM_SIMP_TAC [← GSYM IN_COMPONENTS_UNIONS_COMPLEMENT] THEN
          FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
          ASM SET_TAC [],
          ASM_MESON_TAC [IN_COMPONENTS_NONEMPTY],
          REWRITE_TAC [SEPARATED_IN_UNION] THEN
          ASM_SIMP_TAC [SEPARATED_IN_UNIONS, FINITE_DELETE] THEN
          ASM_SIMP_TAC [SEPARATED_IN_SING, T1_SPACE_EUCLIDEAN] THEN
          REWRITE_TAC [TOPSPACE_EUCLIDEAN, IN_UNIV, SUBSET_UNIV] THEN
          ASM_REWRITE_TAC [IN_DELETE, EUCLIDEAN_CLOSURE_OF] THEN
          MP_TAC (← ISPEC (← q r"s DELETE (a:real^N)") PAIRWISE_SEPARATED_COMPONENTS) THEN
          REWRITE_TAC [pairwise] THEN ASM_SIMP_TAC []]],
      SUBGOAL_THEN
       (← q r"s = {a} UNION
            UNIONS {(a:real^N) INSERT c |c| c IN components(s DELETE a)}")
      SUBST1_TAC THENL
       [MP_TAC (← ISPEC (← q r"s DELETE (a:real^N)") UNIONS_COMPONENTS) THEN
        REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
        REWRITE_TAC [← GSYM UNIONS_INSERT]] THEN
      MATCH_MP_TAC CONNECTED_UNIONS THEN
      REWRITE_TAC [FORALL_IN_INSERT, CONNECTED_SING] THEN
      REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM MEMBER_NOT_EMPTY] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, CONNECTED_INSERT],
        EXISTS_TAC (← q r"a:real^N") THEN
        REWRITE_TAC [INTERS_INSERT, IN_INTER, IN_SING] THEN
        REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM] THEN ASM SET_TAC []]])

  return { FRONTIER_MINIMAL_SEPARATING_CLOSED, FRONTIER_MINIMAL_SEPARATING_CLOSED_POINTWISE,
           CONNECTED_COMPONENT_DIFF_NONSEPARATED, CONNECTED_COMPONENT_DIFF_NONSEPARATED_ALT,
           CONNECTED_COMPONENT_DIFF_CLOSED_NONSEPARATED,
           NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT,
           CONNECTED_EQ_NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT,
           CONNECTED_EQ_COMPONENT_DIFF_CLOSED_NONSEPARATED,
           CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED }

/- ------------------------------------------------------------------------- -/
/- Boundary bumping theorems (continued).  (paths.ml 11293-11442)            -/
/- ------------------------------------------------------------------------- -/

structure PUI where
  CONNECTED_INSERT_COMPACT : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_CLOSED : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_ALT : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN_ALT : thm
  CONTINUUM_UNION_COMPONENTS_INTERMEDIATE_COMPLEMENT : thm
  CONTINUUM_UNION_COMPONENTS_COMPLEMENT : thm
  deriving Inhabited

@[nospecialize]
def setupPUI [HolBase] (D : PathsDeps) (BUH : PUH) : ExceptT String IO PUI := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D.cvx
  let { DIFF_EMPTY, .. } := D.cvx.core1
  let { IMP_CONJ_ALT, INTER_COMM, .. } := D.cvx.core2
  let { IN_INSERT, IN_INTERS, IN_SING, MEMBER_NOT_EMPTY, PSUBSET, .. } := D.cvx.core3
  let { SUBSET_EMPTY, SUBSET_REFL, .. } := D.cvx.core5
  let { UNION_EMPTY, .. } := D.cvx.core6
  let { CLOSED_IN_DIFF, OPEN_IN_DIFF, OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { BOUNDED_SUBSET, CLOSED_CLOSURE, CLOSED_SUBSET, CLOSURE_CLOSED, .. } := D.cvx.top1
  let { CLOSURE_INC, CLOSURE_MINIMAL, CLOSURE_SUBSET, COMPACT_CLOSURE, COMPACT_COMPONENTS,
        COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := D.cvx.top2
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_OPEN, OPEN_IN_REFL, SUBSET_CLOSURE,
        UNIONS_COMPONENTS, .. } := D.cvx.top5
  let { CLOSED_COMPONENTS, CLOSED_IN_COMPONENT, CLOSED_IN_INTER_CLOSURE, CLOSED_IN_REFL,
        COMPACT_UNION, .. } := D.ptop1
  let { COMPONENTS_EQ_SING, CONNECTED_CLOSURE, CONNECTED_UNION, CONNECTED_UNIONS, .. } :=
    D.ptop2
  let { CONNECTED_COMPONENT_DIFF_NONSEPARATED_ALT, NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT,
        CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED, .. } := BUH
  -- @@SCOPE END

  let CONNECTED_INSERT_COMPACT ← prove
   r"!s:real^N->bool a:real^N.
        compact(a INSERT s)
        ==> (connected(a INSERT s) <=>
             !c. c IN components s ==> a IN closure c)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN s") THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE (← q r"a IN s ==> ~(s = {})"))) THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"a IN s ==> a INSERT s = s")] THEN EQ_TAC THENL
       [DISCH_TAC THEN
        MP_TAC (← ISPEC (← q r"s:real^N->bool") COMPONENTS_EQ_SING) THEN
        ASM_SIMP_TAC [IN_SING, CLOSURE_INC],
        DISCH_TAC THEN GEN_REWRITE_TAC RAND_CONV [UNIONS_COMPONENTS] THEN
        MATCH_MP_TAC CONNECTED_UNIONS THEN
        REWRITE_TAC [IN_COMPONENTS_CONNECTED] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTERS] THEN
        EXISTS_TAC (← q r"a:real^N") THEN
        X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_COMPONENT) THEN
        ASM_REWRITE_TAC [CLOSED_IN_INTER_CLOSURE] THEN ASM SET_TAC []],
      MP_TAC (← ISPECL [← q r"(a:real^N) INSERT s", ← q r"a:real^N"]
          CONNECTED_EQ_COMPONENT_DELETE_NONSEPARATED) THEN
      ASM_REWRITE_TAC [IN_INSERT] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> (a INSERT s) DELETE a = s")]])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN ← prove
   r"!s t c:real^N->bool.
        compact s /\ connected s /\ t PSUBSET s /\ c IN components t
        ==> ~(closure(c) INTER closure(t) INTER closure(s DIFF t) = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"~(c INTER s = {}) /\ c SUBSET t
      ==> ~(c INTER t INTER s = {})")) THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENT_DIFF_NONSEPARATED_ALT,
                 SUBSET_CLOSURE, IN_COMPONENTS_SUBSET])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_CLOSED ← prove
   r"!s t c:real^N->bool.
      compact s /\ connected s /\ closed t /\ t PSUBSET s /\ c IN components t
      ==> ~(c INTER closure t INTER closure(s DIFF t) = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"t:real^N->bool", ← q r"c:real^N->bool"]
          BOUNDARY_BUMPING_THEOREM_EUCLIDEAN) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CLOSED_COMPONENTS)) THEN
    ASM_SIMP_TAC [CLOSURE_CLOSED])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_ALT ← prove
   r"!s t c:real^N->bool.
      compact s /\ connected s /\ open_in (subtopology euclidean s) t /\
      t PSUBSET s /\ c IN components(closure t)
      ==> ~(c INTER (s DIFF t) = {})"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"closure t:real^N->bool = s") THENL
     [REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MP_TAC (← EQ_IMP_RULE (← ISPEC (← q r"s:real^N->bool") COMPONENTS_EQ_SING)).2 THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [IN_SING] THEN ASM SET_TAC [],
      STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"closure t:real^N->bool",
                    ← q r"c:real^N->bool"]
          BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_CLOSED) THEN
    ASM_REWRITE_TAC [CLOSED_CLOSURE] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [PSUBSET] THEN MATCH_MP_TAC CLOSURE_MINIMAL THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET u ==> ~(c INTER t INTER s = {}) ==> ~(c INTER u = {})")) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_OPEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [← SET_RULE
     (← q r"k SUBSET s DIFF (s INTER u) <=> k SUBSET s /\ u INTER k = {}")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      SET_TAC [],
      ASM_SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY] THEN
      MP_TAC (← ISPEC (← q r"s INTER u:real^N->bool") CLOSURE_SUBSET) THEN
      SET_TAC []])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN ← prove
   r"!s t c:real^N->bool.
      (compact s \/ locally connected s) /\
      connected s /\
      open_in (subtopology euclidean s) t /\
      t PSUBSET s /\ c IN components t
      ==> ~(closure c INTER (s DIFF t) = {})"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN
    MATCH_MP_TAC NONSEPARATED_CLOSED_COMPLEMENT_COMPONENT THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN
    ASM_SIMP_TAC [← ISPEC (← q r"euclidean") OPEN_IN_IMP_SUBSET,
                 CLOSED_IN_DIFF, CLOSED_IN_REFL,
                 ← SET_RULE (← q r"t SUBSET s ==> (s DIFF t = {} <=> ~(t PSUBSET s))"),
                 ← SET_RULE (← q r"t SUBSET s ==> s DIFF (s DIFF t) = t")])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN_ALT ← prove
   r"!s t c:real^N->bool.
      (compact s \/ locally connected s) /\
      connected s /\ open_in (subtopology euclidean s) t /\
      t PSUBSET s /\ c IN components t
      ==> ~(closure c INTER (closure t DIFF t) = {})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"c SUBSET t'
      ==> ~(c INTER (s DIFF t) = {}) ==> ~(c INTER (t' DIFF t) = {})")) THEN
    ASM_SIMP_TAC [SUBSET_CLOSURE, IN_COMPONENTS_SUBSET])

  let CONTINUUM_UNION_COMPONENTS_INTERMEDIATE_COMPLEMENT ← prove
   r"!s t u c:real^N->bool.
        compact s /\ connected s /\ compact t /\ s SUBSET t /\
        compact u /\ connected u /\ t SUBSET u /\
        c IN components(u DIFF t) /\ closure c DIFF c SUBSET s
        ==> compact(c UNION s) /\ connected(c UNION s)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [ASM_SIMP_TAC [DIFF_EMPTY, SUBSET_EMPTY, UNION_EMPTY] THEN
      MESON_TAC [COMPACT_COMPONENTS, IN_COMPONENTS_CONNECTED],
      STRIP_TAC] THEN
    MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"u DIFF t:real^N->bool",
                    ← q r"c:real^N->bool"]
          BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_REFL] THEN
      MATCH_MP_TAC CLOSED_SUBSET THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET u ==> u DIFF (u DIFF t) = t")]] THEN
    DISCH_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    SUBGOAL_THEN (← q r"c UNION s:real^N->bool = closure c UNION s") SUBST1_TAC THENL
     [MP_TAC (← ISPEC (← q r"c:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC COMPACT_UNION THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [COMPACT_CLOSURE] THEN MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"u:real^N->bool") THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_UNION THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
      ASM_SIMP_TAC [CONNECTED_CLOSURE] THEN ASM SET_TAC []])

  let CONTINUUM_UNION_COMPONENTS_COMPLEMENT ← prove
   r"!s u c:real^N->bool.
        compact s /\ connected s /\ compact u /\ connected u /\ s SUBSET u /\
        c IN components(u DIFF s) /\ closure c DIFF c SUBSET s
        ==> compact(c UNION s) /\ connected(c UNION s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC CONTINUUM_UNION_COMPONENTS_INTERMEDIATE_COMPLEMENT THEN
    MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"u:real^N->bool"] THEN
    ASM_REWRITE_TAC [SUBSET_REFL])

  return { CONNECTED_INSERT_COMPACT, BOUNDARY_BUMPING_THEOREM_EUCLIDEAN,
           BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_CLOSED, BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_ALT,
           BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN, BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_OPEN_ALT,
           CONTINUUM_UNION_COMPONENTS_INTERMEDIATE_COMPLEMENT,
           CONTINUUM_UNION_COMPONENTS_COMPLEMENT }

/- ------------------------------------------------------------------------- -/
/- More compact component properties via the notion of "well-chained".       -/
/- (paths.ml 11443-11688)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PUJ where
  WELLCHAINED_ELEMENTS_EUCLIDEAN : thm
  WELLCHAINED_SETS_EUCLIDEAN : thm
  CONNECTED_IMP_WELLCHAINED : thm
  CONNECTED_COMPONENT_IMP_WELLCHAINED : thm
  CONNECTED_EQ_WELLCHAINED : thm
  CONNECTED_COMPONENT_EQ_WELLCHAINED : thm
  WELLCHAINED_INTERS_EUCLIDEAN : thm
  COMPACT_PARTITION_CONTAINING_CLOSED : thm
  COMPACT_PARTITION_CONTAINING_POINTS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUJ [HolBase] (D : PathsDeps) : ExceptT String IO PUJ := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE,
        SET_TAC, NUM_REDUCE_CONV, .. } := D.cvx
  let { AND_FORALL_THM, ARITH_EQ, CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, EXISTS_PASTECART,
        FORALL_AND_THM, .. } := D.cvx.core1
  let { FORALL_UNWIND_THM2, IMP_CONJ, IMP_IMP, IN, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LE, LEFT_IMP_EXISTS_THM, LE_REFL, LE_SUC, LT_IMP_LE, LT_REFL,
        MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, PASTECART_IN_PCROSS, .. } :=
    D.cvx.core3
  let { REAL_LTE_TRANS, REAL_LT_INV_EQ, .. } := D.cvx.core4
  let { REAL_NOT_LE, SING_SUBSET, SKOLEM_THM, SUBSET, .. } := D.cvx.core5
  let { num_INDUCTION, o_DEF, .. } := D.cvx.core6
  let { DIST_SYM, .. } := D.cvx.vec1
  let { EVENTUALLY_SEQUENTIALLY, .. } := D.cvx.met
  let { BOUNDED_SUBSET, CLOSED_SING, .. } := D.cvx.top1
  let { COMPACT_EMPTY, COMPACT_EQ_BOUNDED_CLOSED, CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, .. } := D.cvx.top4
  let { compact, components, .. } := D.cvx.top5
  let { ADD_EQ_0, LE_0, LE_SUC_LT, LT, .. } := D.pses1
  let { NOT_SUC, REAL_LT_TRANS, SUC_SUB1, .. } := D.pses2
  let { ARCH_EVENTUALLY_INV1, CONNECTED_COMPONENT_OF_EQ_WELLCHAINED,
        CONNECTED_COMPONENT_OF_IMP_WELLCHAINED, CONNECTED_EQ_WELLCHAINED_IN,
        CONNECTED_IN_IMP_WELLCHAINED, EVENTUALLY_AND, EVENTUALLY_SUBSEQUENCE, .. } := D.pmet1
  let { WELLCHAINED_ELEMENTS, WELLCHAINED_INTERS, WELLCHAINED_SETS, .. } := D.pmet2
  let { COMPACT_IN_EUCLIDEAN, COMPACT_IN_SEPARATED_UNION, COMPACT_PCROSS_EQ, .. } := D.ptop1
  let { CONNECTED_COMPONENT_OF_EUCLIDEAN, CONNECTED_COMPONENT_REFL_EQ, .. } := D.ptop2
  let { EUCLIDEAN_METRIC, .. } := D.ptop3
  let { LIM_PASTECART_EQ, .. } := D.ptop4
  let { MTOPOLOGY_EUCLIDEAN_METRIC, REAL_LE_SETDIST, connected_component, tendsto, .. } :=
    D.ptop5
  -- @@SCOPE END

  let WELLCHAINED_ELEMENTS_EUCLIDEAN ← prove
   r"!s:real^N->bool a b e.
        (?p n. p 0 = a /\ p n = b /\
               (!i. i <= n ==> p i IN s) /\
               (!i. i < n ==> dist(p i,p(SUC i)) < e)) <=>
        a IN s /\ b IN s /\
        (!c. c SUBSET s /\ a IN c /\
             (!x y. x IN c /\ y IN s /\ dist(x,y) < e ==> y IN c)
             ==> b IN c)"
   (REWRITE_TAC [← GSYM (← CONJUNCT1 EUCLIDEAN_METRIC), WELLCHAINED_ELEMENTS])

  let WELLCHAINED_SETS_EUCLIDEAN ← prove
   r"!s:real^N->bool e.
     (!a b. a IN s /\ b IN s
            ==> ?p n. p 0 = a /\ p n = b /\
                      (!i. i <= n ==> p i IN s) /\
                      (!i. i < n ==> dist(p i,p(SUC i)) < e)) <=>
     (!c. c SUBSET s /\ ~(c = {}) /\
          (!x y. x IN c /\ y IN s /\ dist(x,y) < e ==> y IN c)
          ==> c = s)"
   (REWRITE_TAC [← GSYM (← CONJUNCT1 EUCLIDEAN_METRIC), WELLCHAINED_SETS])

  let CONNECTED_IMP_WELLCHAINED ← prove
   r"!s e a b:real^N.
        connected s /\ &0 < e /\ a IN s /\ b IN s
        ==> ?p n. p 0 = a /\ p n = b /\
                  (!i. i <= n ==> p i IN s) /\
                  (!i. i < n ==> dist(p i,p(SUC i)) < e)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool",
                   ← q r"e:real", ← q r"a:real^N", ← q r"b:real^N"]
      CONNECTED_IN_IMP_WELLCHAINED) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, CONNECTED_IN_EUCLIDEAN,
                    EUCLIDEAN_METRIC])

  let CONNECTED_COMPONENT_IMP_WELLCHAINED ← prove
   r"!s a b:real^N e.
        &0 < e /\ connected_component s a b
        ==> ?p n. p 0 = a /\ p n = b /\
                  (!i. i <= n ==> p i IN s) /\
                  (!i. i < n ==> dist(p i,p (SUC i)) < e)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool",
                   ← q r"a:real^N", ← q r"b:real^N", ← q r"e:real"]
      CONNECTED_COMPONENT_OF_IMP_WELLCHAINED) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, EUCLIDEAN_METRIC,
                    CONNECTED_COMPONENT_OF_EUCLIDEAN])

  let CONNECTED_EQ_WELLCHAINED ← prove
   r"!s:real^N->bool.
        compact s
        ==> (connected s <=>
             !e. &0 < e
                 ==> !a b. a IN s /\ b IN s
                           ==> ?p n. p 0 = a /\ p n = b /\
                                     (!i. i <= n ==> p i IN s) /\
                                     (!i. i < n ==> dist(p i,p(SUC i)) < e))"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool"]
      CONNECTED_EQ_WELLCHAINED_IN) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN,
                    CONNECTED_IN_EUCLIDEAN, EUCLIDEAN_METRIC])

  let CONNECTED_COMPONENT_EQ_WELLCHAINED ← prove
   r"!s a b:real^N.
        compact s
        ==> (connected_component s a b <=>
             a IN s /\ b IN s /\
             !e. &0 < e
                 ==> ?p n. p 0 = a /\ p n = b /\
                           (!i. i <= n ==> p i IN s) /\
                           (!i. i < n ==> dist(p i,p(SUC i)) < e))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric", ← q r"s:real^N->bool",
                   ← q r"a:real^N", ← q r"b:real^N"]
      CONNECTED_COMPONENT_OF_EQ_WELLCHAINED) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN,
                    CONNECTED_COMPONENT_OF_EUCLIDEAN, EUCLIDEAN_METRIC])

  let WELLCHAINED_INTERS_EUCLIDEAN ← prove
   r"!s:num->(real^N->bool) d e.
        d < e /\
        (!m. compact (s m)) /\
        (!m. s(SUC m) SUBSET s m) /\
        (!m a b.
             a IN s m /\ b IN s m
             ==> ?p n. p 0 = a /\ p n = b /\
                        (!i. i <= n ==> p i IN s m) /\
                        (!i. i < n ==> dist(p i,p (SUC i)) < d))
        ==> !a b. a IN INTERS {s m | m IN (:num)} /\
                  b IN INTERS {s m | m IN (:num)}
                  ==> ?p n. p 0 = a /\ p n = b /\
                            (!i. i <= n ==> p i IN INTERS {s m | m IN (:num)}) /\
                            (!i. i < n ==> dist(p i,p (SUC i)) < e)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                   ← q r"s:num->real^N->bool", ← q r"d:real", ← q r"e:real"]
      WELLCHAINED_INTERS) THEN
    ASM_REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN,
                    EUCLIDEAN_METRIC])

  let COMPACT_PARTITION_CONTAINING_CLOSED ← prove
   r"!s t t':real^N->bool.
        compact s /\ closed t /\ closed t' /\ t SUBSET s /\ t' SUBSET s /\
        (!c. c IN components s ==> c INTER t = {} \/ c INTER t' = {})
        ==> ?k k'. compact k /\ compact k' /\ t SUBSET k /\ t' SUBSET k' /\
                   DISJOINT k k' /\ k UNION k' = s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"t:real^N->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"{}:real^N->bool", ← q r"s:real^N->bool"] THEN
      ASM_REWRITE_TAC [COMPACT_EMPTY] THEN SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t':real^N->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"s:real^N->bool", ← q r"{}:real^N->bool"] THEN
      ASM_REWRITE_TAC [COMPACT_EMPTY] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"compact(t:real^N->bool) /\ compact(t':real^N->bool)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_EQ_BOUNDED_CLOSED, BOUNDED_SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?e. &0 < e /\
          !x y. x IN t /\ (y:real^N) IN t'
                ==> ~(?p n. p 0 = x /\ p n = y /\
                            (!i. i <= n ==> p i IN s) /\
                            (!i. i < n ==> dist(p i,p (SUC i)) < e))")
    STRIP_ASSUME_TAC THENL
     [ONCE_REWRITE_TAC [← MESON [] (← q r"(?e. P e /\ Q e) <=> ~(!e. P e ==> ~Q e)")] THEN
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      GEN_REWRITE_TAC (fun c => RAND_CONV (TOP_DEPTH_CONV c)) [NOT_FORALL_THM] THEN
      REWRITE_TAC [SKOLEM_THM] THEN REWRITE_TAC [NOT_EXISTS_THM, NOT_IMP] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:num->real^N", ← q r"y:num->real^N"] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"(t:real^N->bool) PCROSS (t':real^N->bool)"]
          compact) THEN
      ASM_REWRITE_TAC [COMPACT_PCROSS_EQ] THEN
      DISCH_THEN (MP_TAC o SPEC
       (← q r"\n. pastecart((x:num->real^N) n) (y n:real^N)")) THEN
      ASM_REWRITE_TAC [PASTECART_IN_PCROSS, o_DEF, EXISTS_PASTECART] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"r:num->num"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(a:real^N) IN s /\ b IN s") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"connected_component s (a:real^N)")) THEN
      REWRITE_TAC [NOT_IMP, components, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [SUBSET], REWRITE_TAC [DE_MORGAN_THM]] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"a:real^N"), EXISTS_TAC (← q r"b:real^N")] THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      ASM_SIMP_TAC [CONNECTED_COMPONENT_EQ_WELLCHAINED] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_PASTECART_EQ]) THEN
      REWRITE_TAC [tendsto, AND_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
      SUBGOAL_THEN (← q r"eventually ((\n. inv(&n + &1) < e) o r) sequentially")
      MP_TAC THENL
       [MATCH_MP_TAC EVENTUALLY_SUBSEQUENCE THEN
        ASM_REWRITE_TAC [ARCH_EVENTUALLY_INV1],
        ASM_REWRITE_TAC [o_DEF, ← GSYM EVENTUALLY_AND, IMP_IMP]] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"NN:num") (MP_TAC o SPEC (← q r"NN:num"))) THEN
      REWRITE_TAC [LE_REFL] THEN ABBREV_TAC (← q r"N = (r:num->num) NN") THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"p:num->real^N") MP_TAC o SPEC (← q r"N:num")) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC
       (← q r"\i. if i = 0 then a:real^N else if i <= SUC n then p(i - 1) else b") THEN
      EXISTS_TAC (← q r"n + 2") THEN
      ASM_REWRITE_TAC [ADD_EQ_0, ARITH_EQ, ← ARITH_RULE (← q r"~(n + 2 <= SUC n)")] THEN
      MATCH_MP_TAC num_INDUCTION THEN CONV_TAC NUM_REDUCE_CONV THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n"), NOT_SUC, LE_SUC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      CONJ_TAC THENL
       [DISCH_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        SIMP_TAC [LE_SUC_LT, ← ARITH_RULE (← q r"SUC i < n + 2 <=> i = n \/ i < n")] THEN
        STRIP_TAC THEN ASM_SIMP_TAC [LT_IMP_LE, LE_REFL, LT_REFL, SUC_SUB1] THEN
        TRANS_TAC REAL_LT_TRANS (← q r"inv(&N + &1)") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC],
      ALL_TAC] THEN
    EXISTS_TAC
     (← q r"{x | (x:real^N) IN s /\
           ?p n. p 0 IN t /\
                 p n = x /\
                 (!i. i <= n ==> p i IN s) /\
                 (!i. i < n ==> dist (p i,p (SUC i)) < e)}") THEN
    EXISTS_TAC
     (← q r"{x | (x:real^N) IN s /\
           ~(?p n. p 0 IN t /\
                   p n = x /\
                   (!i. i <= n ==> p i IN s) /\
                   (!i. i < n ==> dist (p i,p (SUC i)) < e))}") THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN
    CONJ_TAC THENL
     [ALL_TAC, STRIP_TAC THEN MATCH_MP_TAC COMPACT_IN_SEPARATED_UNION] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} UNION {x | x IN s /\ ~P x} = s"),
      ← SET_RULE (← q r"DISJOINT {x | x IN s /\ P x} {x | x IN s /\ ~P x}")]
    THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN CONJ_TAC THENL
       [ALL_TAC, RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM MESON_TAC []] THEN
      X_GEN_TAC (← q r"x:real^N") THEN REPEAT STRIP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      MAP_EVERY EXISTS_TAC [← q r"(\i. x):num->real^N", ← q r"0"] THEN
      ASM_REWRITE_TAC [LT, LE] THEN ASM SET_TAC [],
      TRANS_TAC REAL_LTE_TRANS (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LE_SETDIST THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"!t u. t SUBSET t' /\ u SUBSET u' /\ ~(t = {}) /\ ~(u = {})
                  ==> ~(t' = {}) /\ ~(u' = {})")) THEN
        MAP_EVERY EXISTS_TAC [← q r"t:real^N->bool", ← q r"t':real^N->bool"] THEN
        ASM_REWRITE_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN
        REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN
        DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"p:num->real^N", ← q r"n:num"] THEN
        REPLICATE_TAC 5 DISCH_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN MAP_EVERY EXISTS_TAC
         [← q r"\i. if i <= n then (p:num->real^N) i else y", ← q r"SUC n"] THEN
        ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC n <= n)")] THEN
        REWRITE_TAC [LE, LT, ← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)"),
                    FORALL_AND_THM, FORALL_UNWIND_THM2] THEN
        REWRITE_TAC [LE_REFL, LE_SUC_LT, LT_REFL] THEN
        ASM_SIMP_TAC [LT_IMP_LE]]])

  let COMPACT_PARTITION_CONTAINING_POINTS ← prove
   r"!s a b:real^N.
        compact s /\ a IN s /\ b IN s /\ ~(connected_component s a b)
        ==> ?k k'. compact k /\ compact k' /\ a IN k /\ b IN k' /\
                   DISJOINT k k' /\ k UNION k' = s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SING_SUBSET] THEN
    MATCH_MP_TAC COMPACT_PARTITION_CONTAINING_CLOSED THEN
    ASM_REWRITE_TAC [SING_SUBSET, CLOSED_SING] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [connected_component]) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { WELLCHAINED_ELEMENTS_EUCLIDEAN, WELLCHAINED_SETS_EUCLIDEAN, CONNECTED_IMP_WELLCHAINED,
           CONNECTED_COMPONENT_IMP_WELLCHAINED, CONNECTED_EQ_WELLCHAINED,
           CONNECTED_COMPONENT_EQ_WELLCHAINED, WELLCHAINED_INTERS_EUCLIDEAN,
           COMPACT_PARTITION_CONTAINING_CLOSED, COMPACT_PARTITION_CONTAINING_POINTS }

/- ------------------------------------------------------------------------- -/
/- Well-chained (continued): limits of components, small continua,           -/
/- boundary bumping for intersections.  (paths.ml 11689-11954)               -/
/- ------------------------------------------------------------------------- -/

structure PUK where
  CONNECTED_COMPONENT_LIMIT : thm
  CLOSED_UNIONS_COMPONENTS_MEETING_CLOSED : thm
  ARBITRARILY_SMALL_CONTINUUM : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER : thm
  BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER_ALT : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUK [HolBase] (D : PathsDeps) (BUD : PUD) (BUJ : PUJ) : ExceptT String IO PUK := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, SET_RULE, SET_TAC, NUM_REDUCE_CONV, .. } :=
    D.cvx
  let { AND_FORALL_THM, ARITH_EQ, CONJ_ASSOC, DE_MORGAN_THM, FORALL_AND_THM, .. } := D.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, LE_REFL, LE_SUC, LT_IMP_LE,
        LT_REFL, MEMBER_NOT_EMPTY, MONO_AND, MONO_FORALL, NOT_EXISTS_THM, NOT_IMP, .. } :=
    D.cvx.core3
  let { SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_TRANS, .. } :=
    D.cvx.core5
  let { num_INDUCTION, o_THM, pairwise, .. } := D.cvx.core6
  let { DIST_SYM, .. } := D.cvx.vec1
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, OPEN_IN_SUBSET_TRANS, OPEN_IN_TRANS,
        TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.cvx.met
  let { CLOSED_CLOSURE, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_INTER, CLOSED_IN_CLOSED_INTER,
        CLOSED_IN_CLOSED_TRANS, CLOSED_SUBSET, .. } := D.cvx.top1
  let { CLOSURE_MINIMAL, CLOSURE_SUBSET, COMPACT_IMP_CLOSED, COMPACT_INTER_CLOSED, COMPACT_SING,
        COMPONENTS_MAXIMAL, CONNECTED_CLOPEN, CONNECTED_CLOSED_IN, CONNECTED_COMPONENT_SUBSET,
        .. } := D.cvx.top2
  let { FRONTIER_CLOSED, .. } := D.cvx.top3
  let { INTERIOR_OPEN, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        LIM_IN_CLOSED_SET, LIM_SUBSEQUENCE, .. } := D.cvx.top4
  let { OPEN_INTER_CLOSURE_EQ_EMPTY, OPEN_IN_OPEN_INTER, closure, compact, components, frontier,
        .. } := D.cvx.top5
  let { ADD_EQ_0, LEFT_AND_FORALL_THM, LE_SUC_LT, .. } := D.pses1
  let { NOT_SUC, SUC_SUB1, .. } := D.pses2
  let { ALWAYS_EVENTUALLY, EVENTUALLY_AND, .. } := D.pmet1
  let { CLOSED_COMPONENTS, CLOSED_IN_COMPONENT, CLOSED_IN_LIMPT, CLOSED_SEQUENTIAL_LIMITS,
        CLOSED_UNION, CLOSURE_UNION_FRONTIER, COMPACT_CONNECTED_COMPONENT, .. } := D.ptop1
  let { CONNECTED_COMPONENT_EQ, CONNECTED_COMPONENT_REFL, CONNECTED_COMPONENT_REFL_EQ,
        CONNECTED_CONNECTED_COMPONENT, .. } := D.ptop2
  let { EXISTS_COMPONENT_SUPERSET, .. } := D.ptop3
  let { OPEN_CLOSED, OPEN_DELETE, PAIRWISE_DISJOINT_COMPONENTS, SEPARATION_NORMAL,
        connected_component, locally, tendsto, .. } := D.ptop5
  let { SURA_BURA_CLOPEN_SUBSET_ALT, .. } := BUD
  let { CONNECTED_COMPONENT_EQ_WELLCHAINED, COMPACT_PARTITION_CONTAINING_CLOSED, .. } := BUJ
  -- @@SCOPE END

  let CONNECTED_COMPONENT_LIMIT ← prove
   r"!s x y a b:real^N.
        compact s /\ (x --> a) sequentially /\ (y --> b) sequentially /\
        eventually (\n. connected_component s (x n) (y n)) sequentially
        ==> connected_component s a b"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENT_EQ_WELLCHAINED] THEN
    DISCH_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (CONJUNCTS_THEN STRIP_ASSUME_TAC) THEN
      CONJ_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_IN_CLOSED_SET) THENL
       [EXISTS_TAC (← q r"x:num->real^N"), EXISTS_TAC (← q r"y:num->real^N")] THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, COMPACT_IMP_CLOSED] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
      SIMP_TAC [],
      STRIP_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_conj o concl)) THEN
    REWRITE_TAC [tendsto, CONJ_ASSOC, AND_FORALL_THM] THEN
    REWRITE_TAC [LEFT_AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N:num"))) THEN
    REWRITE_TAC [LE_REFL] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:num->real^N", ← q r"n:num"] THEN STRIP_TAC THEN
    EXISTS_TAC
       (← q r"\i. if i = 0 then a:real^N else if i <= SUC n then p(i - 1) else b") THEN
    EXISTS_TAC (← q r"n + 2") THEN
    ASM_REWRITE_TAC [ADD_EQ_0, ARITH_EQ, ← ARITH_RULE (← q r"~(n + 2 <= SUC n)")] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      MATCH_MP_TAC num_INDUCTION THEN CONV_TAC NUM_REDUCE_CONV THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n"), NOT_SUC, LE_SUC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC] THEN
      X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      SIMP_TAC [LE_SUC_LT, ← ARITH_RULE (← q r"SUC i < n + 2 <=> i = n \/ i < n")] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [LT_IMP_LE, LE_REFL, LT_REFL, SUC_SUB1]])

  let CLOSED_UNIONS_COMPONENTS_MEETING_CLOSED ← prove
   r"!s t:real^N->bool.
        compact s /\ closed t
        ==> closed (UNIONS {c | c IN components s /\ ~(c INTER t = {})})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSED_SEQUENTIAL_LIMITS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:num->real^N", ← q r"a:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [IN_UNIONS]) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"c:num->real^N->bool") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE BINDER_CONV [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, IN_INTER] THEN
    X_GEN_TAC (← q r"y:num->real^N") THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(!n. (x:num->real^N) n IN s) /\ (!n. (y:num->real^N) n IN s)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, IN_COMPONENTS_SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [CLOSED_SEQUENTIAL_LIMITS, COMPACT_IMP_CLOSED], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"y:num->real^N") o REWRITE_RULE [compact]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:real^N", ← q r"r:num->num"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"s:real^N->bool", ← q r"(x:num->real^N) o (r:num->num)",
      ← q r"(y:num->real^N) o (r:num->num)", ← q r"a:real^N", ← q r"b:real^N"]
     CONNECTED_COMPONENT_LIMIT) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [LIM_SUBSEQUENCE] THEN MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [o_THM] THEN
      REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"(c:num->real^N->bool)(r(n:num))") THEN
      ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET],
      DISCH_TAC THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"connected_component s (a:real^N)") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [IN, CONNECTED_COMPONENT_REFL]] THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP (← REWRITE_RULE [IN]
          CONNECTED_COMPONENT_EQ)) THEN
      REWRITE_TAC [components, IN_ELIM_THM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      EXISTS_TAC (← q r"b:real^N") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONNECTED_COMPONENT_REFL, IN], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id
       [CLOSED_SEQUENTIAL_LIMITS]) THEN
      EXISTS_TAC (← q r"(y:num->real^N) o (r:num->num)") THEN ASM_REWRITE_TAC [o_THM]])

  let ARBITRARILY_SMALL_CONTINUUM ← prove
   r"!s u a:real^N.
        connected s /\ locally compact s /\ open u /\ {a} PSUBSET s /\ a IN u
        ==> ?c. {a} PSUBSET c /\ c SUBSET s /\ c SUBSET u /\
                compact c /\ connected c"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN s") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?b:real^N. b IN s /\ ~(b = a)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s INTER (u DELETE (b:real^N))", ← q r"a:real^N"]) THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_DELETE, SUBSET_INTER] THEN
    ASM_REWRITE_TAC [IN_DELETE, IN_INTER, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:real^N->bool", ← q r"k:real^N->bool"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"connected_component k (a:real^N)") THEN
    REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC,
      TRANS_TAC SUBSET_TRANS (← q r"k:real^N->bool") THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET] THEN ASM SET_TAC [],
      TRANS_TAC SUBSET_TRANS (← q r"k:real^N->bool") THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET] THEN ASM SET_TAC [],
      MATCH_MP_TAC COMPACT_CONNECTED_COMPONENT THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"a IN s /\ ~(s = {a}) ==> {a} PSUBSET s")) THEN
    REWRITE_TAC [IN] THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
    CONJ_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"k:real^N->bool", ← q r"{a:real^N}", ← q r"v:real^N->bool"]
          SURA_BURA_CLOPEN_SUBSET_ALT) THEN
    ASM_REWRITE_TAC [COMPACT_SING, SING_SUBSET, IN_INTER] THEN
    REWRITE_TAC [NOT_IMP, NOT_EXISTS_THM] THEN REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [CLOSED_IMP_LOCALLY_COMPACT, COMPACT_IMP_CLOSED],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [components, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"a:real^N") THEN REWRITE_TAC [] THEN ASM SET_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          OPEN_IN_SUBSET_TRANS)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOPEN]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
    REWRITE_TAC [NOT_IMP, DE_MORGAN_THM, ← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_TRANS THEN EXISTS_TAC (← q r"v:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← ONCE_REWRITE_RULE [IMP_CONJ] OPEN_IN_SUBSET_TRANS)) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_SUBSET THEN ASM_SIMP_TAC [COMPACT_IMP_CLOSED],
      ALL_TAC] THEN
    ASM SET_TAC [])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER ← prove
   r"!s u c:real^N->bool.
        connected s /\ locally compact s /\
        open u /\ ~(s SUBSET u) /\ compact(s INTER closure u) /\
        c IN components(s INTER closure u)
        ==> ~(c INTER frontier u = {})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"s INTER closure u:real^N->bool", ← q r"c:real^N->bool",
      ← q r"s INTER frontier u:real^N->bool"]
          COMPACT_PARTITION_CONTAINING_CLOSED) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [CLOSED_COMPONENTS, COMPACT_IMP_CLOSED],
      SUBGOAL_THEN
       (← q r"s INTER frontier u:real^N->bool = (s INTER closure u) INTER frontier u")
       (fun th => ASM_SIMP_TAC [th, CLOSED_INTER, FRONTIER_CLOSED,
                               COMPACT_IMP_CLOSED]) THEN
      REWRITE_TAC [frontier] THEN SET_TAC [],
      ASM_SIMP_TAC [IN_COMPONENTS_SUBSET],
      REWRITE_TAC [frontier] THEN SET_TAC [],
      MP_TAC (← ISPEC (← q r"s INTER closure u:real^N->bool")
          PAIRWISE_DISJOINT_COMPONENTS) THEN
      REWRITE_TAC [pairwise] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"d:real^N->bool") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN ASM SET_TAC [],
      REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"l:real^N->bool"] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOSED_IN]) THEN
      REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
       [← q r"k:real^N->bool", ← q r"l UNION (s DIFF closure u):real^N->bool"] THEN
      ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_SUBSET THEN
        ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN ASM SET_TAC [],
        SUBGOAL_THEN
         (← q r"l UNION s DIFF closure u:real^N->bool =
          s INTER (l UNION closure(s DIFF closure u))")
         (fun th => ASM_SIMP_TAC [th, CLOSED_IN_CLOSED_INTER, CLOSED_UNION,
                                COMPACT_IMP_CLOSED, CLOSED_CLOSURE]) THEN
         MP_TAC (← ISPECL [← q r"u:real^N->bool", ← q r"s DIFF closure u:real^N->bool"]
              OPEN_INTER_CLOSURE_EQ_EMPTY) THEN
         ASM_REWRITE_TAC [] THEN
         MP_TAC (← ISPEC (← q r"u:real^N->bool") CLOSURE_UNION_FRONTIER) THEN MP_TAC
          (← ISPEC (← q r"s DIFF closure u:real^N->bool") CLOSURE_UNION_FRONTIER) THEN
         ASM SET_TAC [],
        ASM SET_TAC [],
        ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
        ASM SET_TAC [],
        SUBGOAL_THEN (← q r"frontier u:real^N->bool = closure u DIFF u")
        SUBST_ALL_TAC THENL
         [ASM_SIMP_TAC [frontier, INTERIOR_OPEN], ALL_TAC] THEN ASM SET_TAC []]])

  let BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER_ALT ← prove
   r"!s u c:real^N->bool.
        connected s /\ locally compact s /\
        open u /\ ~(s INTER u = {}) /\ ~(s SUBSET u) /\
        compact(s INTER closure u) /\
        c IN components(s INTER u)
        ==> ?x. x IN frontier u /\ x limit_point_of c"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~(closure c INTER frontier u:real^N->bool = {})") MP_TAC THENL
     [DISCH_TAC,
      REWRITE_TAC [closure] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"s INTER u = {}
        ==> ~((s UNION {x | P x}) INTER u = {}) ==> ?x. x IN u /\ P x")) THEN
      ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN SET_TAC []] THEN
    SUBGOAL_THEN (← q r"closed(c:real^N->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_CLOSED_TRANS THEN
      EXISTS_TAC (← q r"s INTER closure u:real^N->bool") THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_COMPONENT) THEN
      REWRITE_TAC [CLOSED_IN_LIMPT] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [REWRITE_TAC [closure] THEN SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (fun c => LAND_CONV (LAND_CONV c))
        [closure]) THEN
      ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"c:real^N->bool", ← q r"(:real^N) DIFF u"]
          SEPARATION_NORMAL) THEN
    ASM_REWRITE_TAC [← GSYM OPEN_CLOSED, NOT_IMP] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN SET_TAC [],
      REWRITE_TAC [NOT_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:real^N->bool", ← q r"k:real^N->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closure(h:real^N->bool) SUBSET u") ASSUME_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"(:real^N) DIFF k") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CLOSURE_MINIMAL THEN ASM_REWRITE_TAC [← GSYM OPEN_CLOSED] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"s INTER closure h:real^N->bool", ← q r"c:real^N->bool"]
          EXISTS_COMPONENT_SUPERSET) THEN
    REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_SUBSET) THEN
      REWRITE_TAC [closure] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c':real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"h:real^N->bool", ← q r"c':real^N->bool"]
          BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER) THEN
    ASM_REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"s INTER closure(h:real^N->bool) = (s INTER closure u) INTER closure h")
       (fun th => ASM_SIMP_TAC [COMPACT_INTER_CLOSED, th, CLOSED_CLOSURE]) THEN
      MP_TAC (← ISPEC (← q r"u:real^N->bool") CLOSURE_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"c':real^N->bool = c") SUBST_ALL_TAC THENL
     [ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      MATCH_MP_TAC COMPONENTS_MAXIMAL THEN
      EXISTS_TAC (← q r"s INTER u:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
      CONJ_TAC THENL
       [TRANS_TAC SUBSET_TRANS (← q r"s INTER closure h:real^N->bool") THEN
        ASM_SIMP_TAC [IN_COMPONENTS_SUBSET] THEN ASM SET_TAC [],
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY)) THEN
        ASM SET_TAC []],
      ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN ASM SET_TAC []])

  return { CONNECTED_COMPONENT_LIMIT, CLOSED_UNIONS_COMPONENTS_MEETING_CLOSED,
           ARBITRARILY_SMALL_CONTINUUM, BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER,
           BOUNDARY_BUMPING_THEOREM_EUCLIDEAN_INTER_ALT }

/- ------------------------------------------------------------------------- -/
/- Equivalence of LC and LPC for locally compact sets; irreducible           -/
/- separators; lower bounds on norms within segments.                        -/
/- (paths.ml 11955-12205)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PUL where
  LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED : thm
  LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED : thm
  LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED : thm
  LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED : thm
  LOCALLY_PATH_CONNECTED_CLOSURE_FROM_FRONTIER : thm
  CLOSED_IRREDUCIBLE_SEPARATOR : thm
  NORM_SEGMENT_LOWERBOUND : thm
  NORM_SEGMENT_ORTHOGONAL_LOWERBOUND : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUL [HolBase] (D : PathsDeps) (BK : PTK) (BL : PTL) (BS : PTS) (BU : PTU)
    (BUG : PUG) : ExceptT String IO PUL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.cvx
  let { CONJ_ASSOC, DE_MORGAN_THM, DIFF_EMPTY, .. } := D.cvx.core1
  let { IMP_CONJ, IN, INSERT_SUBSET, IN_DIFF, .. } := D.cvx.core2
  let { IN_INSERT, IN_INTER, IN_UNION, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL,
        NOT_EXISTS_THM, NOT_INSERT_EMPTY, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_RDISTRIB,
        REAL_ADD_RID, .. } := D.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ADD2, REAL_LE_LADD, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RMUL,
        REAL_LE_RMUL_EQ, REAL_LE_TRANS, .. } := D.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LNEG, REAL_MUL_RZERO, REAL_NEG_NEG, REAL_POS, REAL_POW2_ABS,
        REAL_POW_2, REAL_POW_LT, REAL_POW_MUL, REAL_SUB_LE, REAL_SUB_RDISTRIB, SING_SUBSET,
        SQRT_POW_2, SUBSET, SUBSET_TRANS, .. } := D.cvx.core5
  let { real_abs, real_ge, .. } := D.cvx.core6
  let { DOT_LMUL, DOT_RMUL, .. } := D.cvx.vec1
  let { NORM_CAUCHY_SCHWARZ_ABS, NORM_GE_SQUARE, .. } := D.cvx.vec2
  let { NORM_POW_2, .. } := D.cvx.vec3
  let { orthogonal, .. } := D.cvx.vec4
  let { CLOSED_CLOSURE, CLOSED_IMP_LOCALLY_COMPACT, CLOSED_SING, .. } := D.cvx.top1
  let { CLOSURE_SUBSET, CONNECTED_INTER_FRONTIER, CONNECTED_IN_EUCLIDEAN, .. } := D.cvx.top2
  let { FRONTIER_CLOSED, FRONTIER_CLOSURE_SUBSET, FRONTIER_COMPLEMENT, FRONTIER_SUBSET_EQ,
        .. } := D.cvx.top3
  let { IN_SEGMENT, .. } := D.cvx.top4
  let { closed, .. } := D.cvx.top5
  let { PSUBSET_ALT, REAL_ABS_POW, REAL_LE_SQUARE, UNIV, real_sub, .. } := D.pses2
  let { LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE, .. } := D.pmet2
  let { CLOSURE_UNION_FRONTIER, .. } := D.ptop1
  let { CONNECTED_COMPONENT_IN, CONNECTED_COMPONENT_REFL_EQ, CONNECTED_COMPONENT_UNIV,
        CONNECTED_CONNECTED_COMPONENT, CONNECTED_INTERMEDIATE_CLOSURE, CONNECTED_UNION, .. } :=
    D.ptop2
  let { FRONTIER_DISJOINT_EQ, .. } := D.ptop3
  let { LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_OPEN_SUBSET, .. } := D.ptop4
  let { MTOPOLOGY_EUCLIDEAN_METRIC, connected_component, .. } := D.ptop5
  let { FRONTIER_OF_CONNECTED_COMPONENT_SUBSET, .. } := D.pcvx2
  let { PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY, .. } := BK
  let { PATH_CONNECTED_IMP_CONNECTED, .. } := BL
  let { LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN, LOCALLY_CONNECTED,
        LOCALLY_PATH_CONNECTED, LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED, .. } := BS
  let { LOCALLY_CONNECTED_CLOSURE_FROM_FRONTIER, .. } := BU
  let { OPEN_CONNECTED_COMPONENT, .. } := BUG
  -- @@SCOPE END

  let LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool.
        locally compact s /\ locally connected s /\ connected s
        ==> path_connected s"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                   ← q r"s:real^N->bool"]
      LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE) THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC,
                LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                CONNECTED_IN_EUCLIDEAN,
                LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [])

  let LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED ← prove
   r"!s:real^N->bool.
        locally compact s /\ locally connected s
        ==> (path_connected s <=> connected s)"
   (MESON_TAC [LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED,
              PATH_CONNECTED_IMP_CONNECTED])

  let LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool.
        locally compact s /\ locally connected s
        ==> locally path_connected s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ASSUME (← q r"locally connected (s:real^N->bool)")) THEN
    REWRITE_TAC [LOCALLY_CONNECTED, LOCALLY_PATH_CONNECTED] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"v:real^N->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:real^N") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"u:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
    MATCH_MP_TAC LOCALLY_OPEN_SUBSET THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [])

  let LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool.
     locally compact s ==> (locally path_connected s <=> locally connected s)"
   (MESON_TAC [LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED,
              LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let LOCALLY_PATH_CONNECTED_CLOSURE_FROM_FRONTIER ← prove
   r"!s:real^N->bool.
        locally connected (frontier s)
        ==> locally path_connected (closure s)"
   (SIMP_TAC [LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED,
             CLOSED_IMP_LOCALLY_COMPACT, CLOSED_CLOSURE, FRONTIER_CLOSED] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_CLOSURE_FROM_FRONTIER])

  let CLOSED_IRREDUCIBLE_SEPARATOR ← prove
   r"!s a b:real^N.
      closed s /\ ~connected_component ((:real^N) DIFF s) a b
      ==> ?t. t SUBSET s /\ closed t /\ ~(t = {}) /\
              ~connected_component ((:real^N) DIFF t) a b /\
              !u. u PSUBSET t ==> connected_component ((:real^N) DIFF u) a b"
   (MAP_EVERY X_GEN_TAC [← q r"c:real^N->bool", ← q r"a:real^N", ← q r"b:real^N"] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:real^N) IN c") THENL
     [EXISTS_TAC (← q r"{a:real^N}") THEN ASM_REWRITE_TAC [CLOSED_SING, SING_SUBSET] THEN
      SIMP_TAC [← SET_RULE (← q r"s PSUBSET {a} <=> s = {}"), NOT_INSERT_EMPTY] THEN
      REWRITE_TAC [DIFF_EMPTY, CONNECTED_COMPONENT_UNIV] THEN
      CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [UNIV]] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_COMPONENT_IN) THEN SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(b:real^N) IN c") THENL
     [EXISTS_TAC (← q r"{b:real^N}") THEN ASM_REWRITE_TAC [CLOSED_SING, SING_SUBSET] THEN
      SIMP_TAC [← SET_RULE (← q r"s PSUBSET {a} <=> s = {}"), NOT_INSERT_EMPTY] THEN
      REWRITE_TAC [DIFF_EMPTY, CONNECTED_COMPONENT_UNIV] THEN
      CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [UNIV]] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_COMPONENT_IN) THEN SET_TAC [],
      ALL_TAC] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"r = connected_component ((:real^N) DIFF c) a",
      ← q r"s = connected_component ((:real^N) DIFF closure r) b"] THEN
    EXISTS_TAC (← q r"frontier s:real^N->bool") THEN REWRITE_TAC [FRONTIER_CLOSED] THEN
    SUBGOAL_THEN (← q r"(a:real^N) IN r") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN REWRITE_TAC [IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:real^N) IN s") ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN
      REWRITE_TAC [IN] THEN REWRITE_TAC [CONNECTED_COMPONENT_REFL_EQ] THEN
      ASM_REWRITE_TAC [IN_UNIV, IN_DIFF] THEN
      REWRITE_TAC [CLOSURE_UNION_FRONTIER, IN_UNION, DE_MORGAN_THM] THEN
      CONJ_TAC THENL [ASM_REWRITE_TAC [IN], EXPAND_TAC "r"] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
        FRONTIER_OF_CONNECTED_COMPONENT_SUBSET)) THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(b IN s) ==> t SUBSET s ==> b IN t ==> F"))) THEN
      ASM_REWRITE_TAC [FRONTIER_COMPLEMENT, FRONTIER_SUBSET_EQ],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"frontier(s:real^N->bool) SUBSET frontier r") ASSUME_TAC THENL
     [EXPAND_TAC "s" THEN
      MATCH_MP_TAC (← MESON [SUBSET_TRANS, FRONTIER_OF_CONNECTED_COMPONENT_SUBSET]
       (← q r"frontier s SUBSET t ==> frontier(connected_component s a) SUBSET t")) THEN
      REWRITE_TAC [FRONTIER_COMPLEMENT, FRONTIER_CLOSURE_SUBSET],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> r) /\ p /\ ~r /\ s ==> p /\ ~q /\ ~r /\ s")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [DIFF_EMPTY, CONNECTED_COMPONENT_UNIV] THEN REWRITE_TAC [UNIV],
      ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        SUBSET_TRANS)) THEN
      EXPAND_TAC "r" THEN
      MATCH_MP_TAC (← MESON [SUBSET_TRANS, FRONTIER_OF_CONNECTED_COMPONENT_SUBSET]
       (← q r"frontier s SUBSET t ==>frontier (connected_component s a) SUBSET t")) THEN
      ASM_REWRITE_TAC [FRONTIER_COMPLEMENT, FRONTIER_SUBSET_EQ],
      REWRITE_TAC [connected_component, NOT_EXISTS_THM, ← SET_RULE
                    (← q r"s SUBSET UNIV DIFF t <=> s INTER t = {}")] THEN
      X_GEN_TAC (← q r"t:real^N->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC)) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_INTER_FRONTIER THEN
      ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"b:real^N") THEN ASM_REWRITE_TAC [],
        EXISTS_TAC (← q r"a:real^N")] THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN EXPAND_TAC "s" THEN REWRITE_TAC [IN] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2 o MATCH_MP CONNECTED_COMPONENT_IN) THEN
      REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_SUBSET) THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"u:real^N->bool") THEN REWRITE_TAC [PSUBSET_ALT] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^N") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [connected_component] THEN
      EXISTS_TAC (← q r"(p:real^N) INSERT (s UNION r)") THEN
      ASM_REWRITE_TAC [IN_INSERT, IN_UNION] THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [← SET_RULE
         (← q r"a INSERT (s UNION t) = (a INSERT s) UNION (a INSERT t)")] THEN
        MATCH_MP_TAC CONNECTED_UNION THEN REWRITE_TAC [CONJ_ASSOC] THEN
        CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
        CONJ_TAC THEN MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THENL
         [EXISTS_TAC (← q r"s:real^N->bool"), EXISTS_TAC (← q r"r:real^N->bool")] THEN
        (CONJ_TAC THENL
          [ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT], ALL_TAC] THEN
         CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [INSERT_SUBSET]] THEN
         REWRITE_TAC [CLOSURE_SUBSET] THEN
         ASM_REWRITE_TAC [CLOSURE_UNION_FRONTIER, IN_UNION] THEN ASM SET_TAC []),
        MATCH_MP_TAC (← SET_RULE
         (← q r"s INTER u = {} /\ t INTER u = {} /\ ~(p IN u)
          ==> p INSERT (s UNION t) SUBSET UNIV DIFF u")) THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"u SUBSET t ==> t INTER s = {} ==> s INTER u = {}"))) THEN
          REWRITE_TAC [FRONTIER_DISJOINT_EQ] THEN EXPAND_TAC "s",
          SUBGOAL_THEN (← q r"frontier(r:real^N->bool) INTER r = {}")
           (fun th => ASM SET_TAC [th]) THEN
          REWRITE_TAC [FRONTIER_DISJOINT_EQ] THEN EXPAND_TAC "r"] THEN
        MATCH_MP_TAC OPEN_CONNECTED_COMPONENT THEN
        ASM_REWRITE_TAC [← GSYM closed, CLOSED_CLOSURE]]])

  let NORM_SEGMENT_LOWERBOUND ← prove
   r"!a b x:real^N r d.
        &0 < r /\
        norm(a) = r /\ norm(b) = r /\ x IN segment[a,b] /\
        a dot b = d * r pow 2
        ==> sqrt((&1 - abs d) / &2) * r <= norm(x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM real_ge] THEN
    REWRITE_TAC [NORM_GE_SQUARE] THEN DISJ2_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [real_ge, DOT_LMUL, DOT_RMUL, REAL_MUL_RZERO, ← VECTOR_ARITH
     (← q r"(a + b) dot (a + b) = a dot a + b dot b + &2 * a dot b")] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"(&1 - u) * (&1 - u) * r pow 2 + u * u * r pow 2 -
                &2 * (&1 - u) * u * abs d * r pow 2") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [REAL_POW_MUL, REAL_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM REAL_ADD_RDISTRIB, ← GSYM REAL_SUB_RDISTRIB] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_POW_2, REAL_LE_SQUARE] THEN
      REWRITE_TAC [← GSYM REAL_POW_2, ← REAL_ARITH
       (← q r"(&1 - u) pow 2 + u pow 2 - ((&2 * (&1 - u)) * u) * d =
        (&1 + d) * (&1 - &2 * u + &2 * u pow 2) - d")] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"(&1 + abs d) * &1 / &2 - abs d") THEN CONJ_TAC THENL
       [REWRITE_TAC [← REAL_ARITH (← q r"(&1 + d) * &1 / &2 - d = (&1 - d) / &2")] THEN
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC SQRT_POW_2 THEN
        MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N"] NORM_CAUCHY_SCHWARZ_ABS) THEN
        ASM_REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_POW, REAL_POW2_ABS] THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"r * r = &1 * r pow 2")] THEN
        ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_POW_LT] THEN REAL_ARITH_TAC,
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> x - a <= y - a")) THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC THENL
         [REAL_ARITH_TAC,
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"&0 <= (u - &1 / &2) * (u - &1 / &2)
            ==> &1 / &2 <= &1 - &2 * u + &2 * u pow 2")) THEN
          REWRITE_TAC [REAL_LE_SQUARE]]],
      ASM_REWRITE_TAC [← GSYM NORM_POW_2, REAL_LE_LADD, real_sub] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"abs(a) <= --x ==> x <= a")) THEN
      ASM_REWRITE_TAC [REAL_ABS_MUL, REAL_MUL_LNEG, REAL_NEG_NEG] THEN
      REWRITE_TAC [REAL_ABS_POW, REAL_POW2_ABS, REAL_ABS_NUM] THEN
      REWRITE_TAC [REAL_MUL_ASSOC] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
      REWRITE_TAC [REAL_POW_2, REAL_LE_SQUARE] THEN
      ASM_REWRITE_TAC [real_abs, ← GSYM real_sub, REAL_SUB_LE, REAL_POS] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN CONJ_TAC THEN
      REPEAT (MATCH_MP_TAC REAL_LE_MUL THEN
            CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC])

  let NORM_SEGMENT_ORTHOGONAL_LOWERBOUND ← prove
   r"!a b:real^N x r.
        r <= norm(a) /\ r <= norm(b) /\ orthogonal a b /\ x IN segment[a,b]
        ==> r / &2 <= norm(x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM real_ge] THEN
    REWRITE_TAC [NORM_GE_SQUARE] THEN REWRITE_TAC [real_ge] THEN
    ASM_CASES_TAC (← q r"r <= &0") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [orthogonal] THEN STRIP_TAC THEN DISJ2_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [DOT_LMUL, DOT_RMUL, REAL_MUL_RZERO, ← VECTOR_ARITH
     (← q r"(a + b) dot (a + b) = a dot a + b dot b + &2 * a dot b")] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"(&1 - u) * (&1 - u) * r pow 2 + u * u * r pow 2") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"(r / &2) pow 2 = &1 / &4 * r pow 2")] THEN
      REWRITE_TAC [← GSYM REAL_ADD_RDISTRIB, REAL_MUL_ASSOC] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_POW_2, REAL_LE_SQUARE] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 <= (u - &1 / &2) * (u - &1 / &2)
        ==> &1 / &4 <= (&1 - u) * (&1 - u) + u * u")) THEN
      REWRITE_TAC [REAL_LE_SQUARE],
      REWRITE_TAC [REAL_ADD_RID] THEN MATCH_MP_TAC REAL_LE_ADD2 THEN
      CONJ_TAC THEN
      REPEAT (MATCH_MP_TAC REAL_LE_LMUL THEN
          CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      ASM_REWRITE_TAC []])

  return { LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED,
           LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED,
           LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED,
           LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED,
           LOCALLY_PATH_CONNECTED_CLOSURE_FROM_FRONTIER, CLOSED_IRREDUCIBLE_SEPARATOR,
           NORM_SEGMENT_LOWERBOUND, NORM_SEGMENT_ORTHOGONAL_LOWERBOUND }

/- ------------------------------------------------------------------------- -/
/- Accessibility of frontier points.  (paths.ml 12206-12429)                 -/
/- ------------------------------------------------------------------------- -/

structure PUM where
  DENSE_ACCESSIBLE_FRONTIER_POINTS : thm
  DENSE_ACCESSIBLE_FRONTIER_POINTS_CONNECTED : thm
  DENSE_ACCESSIBLE_FRONTIER_POINT_PAIRS : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUM [HolBase] (D : PathsDeps) (BA : PTA) (BB : PTB) (BC : PTC) (BD : PTD)
    (BF : PTF) (BK : PTK) (BL : PTL) (BR : PTR) (BUG : PUG) : ExceptT String IO PUM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH_TAC, SET_RULE, SET_TAC, SIMP_RULE,
        .. } := D.cvx
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_SUBSET, EXISTS_IN_GSPEC,
        EXISTS_IN_IMAGE, FINITE_EMPTY, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        INSERT_SUBSET, IN_DELETE, IN_DIFF, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, .. } := D.cvx.core4
  let { SUBSET, SUBSET_ANTISYM_EQ, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.cvx.core5
  let { o_DEF, .. } := D.cvx.core6
  let { DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, .. } := D.cvx.vec2
  let { OPEN_IN_IMP_SUBSET, .. } := D.cvx.met
  let { BOUNDED_SUBSET, CENTRE_IN_BALL, CLOSED_INTERVAL, .. } := D.cvx.top1
  let { CLOSURE_INTERVAL, COMPACT_EQ_BOUNDED_CLOSED, CONNECTED_CONTINUOUS_IMAGE,
        CONNECTED_INTER_FRONTIER, .. } := D.cvx.top2
  let { CONTINUOUS_ON_SUBSET, FRONTIER_CLOSED, FRONTIER_EMPTY, .. } := D.cvx.top3
  let { INTERIOR_OPEN, INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, .. } := D.cvx.top4
  let { OPEN_IN_CONTAINS_BALL, closure, frontier, .. } := D.cvx.top5
  let { INFINITE, .. } := D.pses1
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.pvec
  let { OPEN_IN_SUBTOPOLOGY_EMPTY, .. } := D.pmet2
  let { BOUNDED_INTERVAL, COMPACT_ATTAINS_INF, .. } := D.ptop1
  let { CONNECTED_INTERMEDIATE_CLOSURE, CONTINUOUS_CLOSED_PREIMAGE, .. } := D.ptop2
  let { LIMPT_INFINITE_BALL, .. } := D.ptop4
  let { OPEN_CLOSED_INTERVAL_1, OPEN_IN_DELETE, .. } := D.ptop5
  let { CONNECTED_INTERVAL, CONVEX_BALL, .. } := D.pcvx1
  let { path, pathstart, pathfinish, path_image, reversepath, arc, .. } := BA
  let { ARC_IMP_PATH, .. } := BB
  let { PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
        PATH_IMAGE_REVERSEPATH, PATH_REVERSEPATH, PATH_JOIN, PATH_IMAGE_JOIN, ARC_REVERSEPATH,
        .. } := BC
  let { PATH_JOIN_EQ, .. } := BD
  let { PATH_IMAGE_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH, ARC_SUBPATH_ARC, .. } := BF
  let { path_component, PATH_CONNECTED_IFF_PATH_COMPONENT, .. } := BK
  let { CONVEX_IMP_PATH_CONNECTED, .. } := BL
  let { PATH_CONTAINS_ARC, PATH_CONNECTED_ARCWISE, .. } := BR
  let { CONNECTED_OPEN_PATH_CONNECTED, .. } := BUG
  -- @@SCOPE END

  let DENSE_ACCESSIBLE_FRONTIER_POINTS ← prove
   r"!s:real^N->bool v.
        open s /\ open_in (subtopology euclidean (frontier s)) v /\ ~(v = {})
        ==> ?g. arc g /\
                IMAGE g (interval [vec 0,vec 1] DELETE vec 1) SUBSET s /\
                pathstart g IN s /\ pathfinish g IN v"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:real^N")) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_CONTAINS_BALL]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"z:real^N"))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(z:real^N) IN frontier s") MP_TAC THENL
     [ASM SET_TAC [],
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
      REWRITE_TAC [frontier] THEN ASM_SIMP_TAC [IN_DIFF, INTERIOR_OPEN]] THEN
    REWRITE_TAC [closure, IN_UNION, ← TAUT (← q r"(p \/ q) /\ ~p <=> ~p /\ q")] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMPT_INFINITE_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"r:real")) THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"s INTER ball(z:real^N,r) = {}") THENL
     [ASM_MESON_TAC [INFINITE, FINITE_EMPTY], DISCH_THEN (K ALL_TAC : thm → tactic)] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [IN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~((y:real^N) IN frontier s)") ASSUME_TAC THENL
     [ASM_SIMP_TAC [IN_DIFF, INTERIOR_OPEN, frontier], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"path_connected(ball(z:real^N,r))") MP_TAC THENL
     [ASM_SIMP_TAC [CONVEX_BALL, CONVEX_IMP_PATH_CONNECTED], ALL_TAC] THEN
    REWRITE_TAC [PATH_CONNECTED_ARCWISE] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"y:real^N", ← q r"z:real^N"]) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC
      (← q r"IMAGE drop {t | t IN interval[vec 0,vec 1] /\
                       (g:real^1->real^N) t IN frontier s}")
     COMPACT_ATTAINS_INF) THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, IMP_CONJ] THEN
    REWRITE_TAC [IMP_IMP, FORALL_IN_GSPEC, EXISTS_IN_GSPEC, ← GSYM IMAGE_o] THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, IMAGE_ID] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
         [MATCH_MP_TAC BOUNDED_SUBSET THEN
          EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
          REWRITE_TAC [BOUNDED_INTERVAL, SUBSET_RESTRICT],
          MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE THEN
          REWRITE_TAC [FRONTIER_CLOSED, CLOSED_INTERVAL, ← GSYM path] THEN
          ASM_MESON_TAC [arc]],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"vec 1:real^1") THEN
        ASM_REWRITE_TAC [IN_ELIM_THM, ENDS_IN_UNIT_INTERVAL] THEN
        ASM_MESON_TAC [pathfinish, SUBSET]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"subpath (vec 0) t (g:real^1->real^N)") THEN
      ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC ARC_SUBPATH_ARC THEN
        ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        ASM_MESON_TAC [pathstart],
        REWRITE_TAC [arc] THEN STRIP_TAC] THEN
      GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o LAND_CONV) [← GSYM pathstart] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC, RULE_ASSUM_TAC (SIMP_RULE [path_image]) THEN ASM SET_TAC []] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"a IN s /\ IMAGE f s DELETE (f a) SUBSET t /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> IMAGE f (s DELETE a) SUBSET t")) THEN
      ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL, ← GSYM path_image] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) PATH_IMAGE_SUBPATH o lhand o lhand o
        snd) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1], DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [← REWRITE_RULE [pathfinish] PATHFINISH_SUBPATH] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE f (s DELETE a) DIFF t = {}
        ==> IMAGE f s DELETE f a SUBSET t")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [← TAUT
       (← q r"p /\ q /\ ~r ==> ~s <=> p /\ q /\ s ==> r")]
       CONNECTED_INTER_FRONTIER) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE id [arc]) THEN
          REWRITE_TAC [path] THEN MATCH_MP_TAC
           (← REWRITE_RULE [IMP_CONJ_ALT] CONTINUOUS_ON_SUBSET) THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
          REWRITE_TAC [SUBSET, IN_DELETE, ← GSYM DROP_EQ, IN_INTERVAL_1] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THEN
          EXISTS_TAC (← q r"interval(vec 0:real^1,t)") THEN
          REWRITE_TAC [CONNECTED_INTERVAL, CLOSURE_INTERVAL] THEN
          REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
          COND_CASES_TAC THEN
          ASM_REWRITE_TAC [SUBSET, IN_DELETE, ← GSYM DROP_EQ, IN_INTERVAL_1] THEN
          REWRITE_TAC [NOT_IN_EMPTY] THEN ASM_REAL_ARITH_TAC],
        REWRITE_TAC [← SET_RULE
          (← q r"~(IMAGE f s INTER t = {}) <=> ?x. x IN s /\ f x IN t")] THEN
        EXISTS_TAC (← q r"vec 0:real^1") THEN
        REWRITE_TAC [IN_INTERVAL_1, IN_DELETE, REAL_LE_REFL] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM SET_TAC [pathstart],
        REWRITE_TAC [← SET_RULE
         (← q r"IMAGE g i INTER s = {} <=> !x. x IN i ==> ~(g x IN s)")] THEN
