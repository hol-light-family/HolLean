     [REPEAT CONJ_TAC THENL
       [REWRITE_TAC [continuous_on] THEN X_GEN_TAC (← q r"u:real^1") THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_on]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"u:real^1")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"v:real^1") THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"segment(u:real^1,v) INTER t = {}") THENL
         [ASM_MESON_TAC [DIST_REFL], ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"(?w:real^1. w IN t /\ w IN segment[u,v] /\ segment(u,w) INTER t = {}) /\
