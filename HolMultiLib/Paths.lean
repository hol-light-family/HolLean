  let FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        compact s /\ locally connected s
        ==> FINITE(components s)"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric euclidean_metric (s:real^N->bool)")
      FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED) THEN
    SIMP_TAC [SUBMETRIC_EUCLIDEAN_METRIC,
             COMPACT_IN_SUBTOPOLOGY_EUCLIDEAN, SUBSET_REFL,
             LOCALLY_CONNECTED_SPACE_SUBMETRIC_EUCLIDEAN,
             MTOPOLOGY_SUBMETRIC_EUCLIDEAN,
             EUCLIDEAN_CONNECTED_COMPONENTS_OF] THEN
    DISCH_THEN MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  let COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        compact s /\ connected s /\ locally connected s
        ==> path_connected s"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                   ← q r"s:real^N->bool"]
      COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED) THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC, COMPACT_IN_EUCLIDEAN,
                CONNECTED_IN_EUCLIDEAN,
                LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    DISCH_THEN MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  let LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally compact s /\ connected s /\ locally connected s
        ==> path_connected s"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                   ← q r"s:real^N->bool"]
      LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE) THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC,
                LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                CONNECTED_IN_EUCLIDEAN,
                LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
    DISCH_THEN MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  let LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally compact s /\ locally connected s
        ==> (path_connected s <=> connected s)"
   (MESON_TAC [LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN,
              PATH_CONNECTED_IMP_CONNECTED])

  let LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally compact s /\ locally connected s
        ==> locally path_connected s"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"euclidean_metric:(real^N)metric",
                   ← q r"s:real^N->bool"]
      LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE) THEN
    REWRITE_TAC [MTOPOLOGY_EUCLIDEAN_METRIC,
                LOCALLY_COMPACT_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN] THEN
    DISCH_THEN MATCH_MP_TAC THEN FIRST_ASSUM ACCEPT_TAC)

  let LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        locally compact s
        ==> (locally path_connected s <=>
             locally connected s)"
   (MESON_TAC [
     LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN,
     LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let MCOMPLETE_IMP_LOCALLY_COMPACT_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        mcomplete(submetric euclidean_metric s)
        ==> locally compact s"
   (GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC CLOSED_IMP_LOCALLY_COMPACT THEN
    REWRITE_TAC [CLOSED_IN, ← GSYM MTOPOLOGY_EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC MCOMPLETE_IMP_CLOSED_IN THEN
    ASM_REWRITE_TAC [EUCLIDEAN_METRIC, SUBSET_UNIV])

  let MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        mcomplete(submetric euclidean_metric s) /\
        connected s /\ locally connected s
        ==> path_connected s"
   (GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC
      LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN THEN
    ASM_SIMP_TAC [MCOMPLETE_IMP_LOCALLY_COMPACT_EUCLIDEAN])

  let MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        mcomplete(submetric euclidean_metric s) /\
        locally connected s
        ==> locally path_connected s"
   (GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC
     LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN THEN
    ASM_SIMP_TAC [MCOMPLETE_IMP_LOCALLY_COMPACT_EUCLIDEAN])

  let MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN ← prove
   r"!s:real^N->bool.
        mcomplete(submetric euclidean_metric s)
        ==> (locally path_connected s <=>
             locally connected s)"
   (MESON_TAC [
     MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN,
     LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED])

  let GDELTA_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED ← prove
   r"!s:real^N->bool.
        gdelta s
        ==> (locally path_connected s <=>
             locally connected s)"
   (GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"subtopology euclidean (s:real^N->bool)")
      COMPLETELY_METRIZABLE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_GDELTA_IN THEN
      ASM_REWRITE_TAC [GDELTA_IN_EUCLIDEAN,
                      COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN],
      REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN,
                  LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN]])

  let GDELTA_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!s:real^N->bool.
        gdelta s /\ locally connected s
        ==> locally path_connected s"
   (MESON_TAC [GDELTA_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED])

  let GDELTA_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED ← prove
   r"!s:real^N->bool.
        gdelta s /\ connected s /\ locally connected s
        ==> path_connected s"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"subtopology euclidean (s:real^N->bool)")
      COMPLETELY_METRIZABLE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_GDELTA_IN THEN
        ASM_REWRITE_TAC [GDELTA_IN_EUCLIDEAN,
                        COMPLETELY_METRIZABLE_SPACE_EUCLIDEAN],
        ASM_REWRITE_TAC [CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY,
                        LOCALLY_CONNECTED_SPACE_SUBTOPOLOGY_EUCLIDEAN]],
      REWRITE_TAC [PATH_CONNECTED_SPACE_EUCLIDEAN_SUBTOPOLOGY]])

  let LOCALLY_CONVEX ← prove
   r"!s:real^N->bool.
        locally convex s <=>
        !x. x IN s ==> ?u v. x IN u /\ u SUBSET v /\ v SUBSET s /\
                             open_in (subtopology euclidean s) u /\
                             convex v"
   (GEN_TAC THEN REWRITE_TAC [locally] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN FIRST_X_ASSUM
       (MP_TAC o SPECL [← q r"s INTER ball(x:real^N,&1)", ← q r"x:real^N"]) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL] THEN
      ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL, REAL_LT_01] THEN
      MESON_TAC [SUBSET_INTER],
      MAP_EVERY X_GEN_TAC [← q r"w:real^N->bool", ← q r"x:real^N"] THEN
      REWRITE_TAC [IMP_CONJ] THEN GEN_REWRITE_TAC LAND_CONV [OPEN_IN_OPEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^N->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N->bool", ← q r"v:real^N->bool"] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(s INTER ball(x:real^N,e)) INTER u") THEN
      EXISTS_TAC (← q r"cball(x:real^N,e) INTER v") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_OPEN_INTER, OPEN_BALL, CENTRE_IN_BALL,
                   CONVEX_INTER, CONVEX_CBALL, IN_INTER] THEN
      MP_TAC (← ISPECL [← q r"x:real^N", ← q r"e:real"] BALL_SUBSET_CBALL) THEN
      ASM SET_TAC []])

  return { SEMI_LOCALLY_CONNECTED, SEMI_LOCALLY_CONNECTED_GEN, SEMI_LOCALLY_CONNECTED_COMPACT,
           FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED_EUCLIDEAN,
           COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN,
           LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN,
           LOCALLY_COMPACT_PATH_CONNECTED_EQ_CONNECTED_EUCLIDEAN,
           LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN,
           LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN,
           MCOMPLETE_IMP_LOCALLY_COMPACT_EUCLIDEAN,
           MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_EUCLIDEAN,
           MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_EUCLIDEAN,
           MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_EUCLIDEAN,
           GDELTA_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED,
           GDELTA_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED,
           GDELTA_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED, LOCALLY_CONVEX }

/- ------------------------------------------------------------------------- -/
/- Various sufficient conditions for continuity. These are mainly from the   -/
/- papers by Klee & Utz, Pervin & Levine, and Tanaka.  (paths.ml 9413-9682)  -/
/- ------------------------------------------------------------------------- -/

structure PUA where
  PROPER_MAP_TO_COMPACT : thm
  CONTINUOUS_WITHIN_SEQUENTIALLY_COMPACT_MAP : thm
  COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON : thm
  COMPACT_CONTINUOUS_IMAGE_EQ : thm
  CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN : thm
  CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPUA [HolBase] (D : PathsDeps) : ExceptT String IO PUA := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, SELECT_CONV, .. } := D.cvx
  let { AND_FORALL_THM, CONTRAPOS_THM, EXISTS_IN_IMAGE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_UNIONS, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMAGE_CLAUSES, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT,
        INTER_SUBSET, IN_DELETE, .. } := D.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        .. } := D.cvx.core3
  let { REAL_LE_INV2, REAL_LT_INV_EQ, .. } := D.cvx.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE,
        SKOLEM_THM, SUBSET_INTER, SUBSET_REFL, SUBSET_RESTRICT, .. } := D.cvx.core5
  let { o_DEF, o_THM, .. } := D.cvx.core6
  let { DIST_REFL, DIST_SYM, .. } := D.cvx.vec1
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.cvx.met
  let { CENTRE_IN_BALL, .. } := D.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED, CONNECTED_CONTINUOUS_IMAGE,
        CONNECTED_IMP_PERFECT, .. } := D.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET,
        CONTINUOUS_WITHIN_SEQUENTIALLY, .. } := D.cvx.top3
  let { IN_BALL, LIMPT_APPROACHABLE, LIM_CONST, LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, LIM_UNIQUE,
        OPEN_BALL, .. } := D.cvx.top4
  let { OPEN_IN_CONTAINS_BALL, OPEN_IN_OPEN_INTER, .. } := D.cvx.top5
  let { FINITE_NUMSEG_LT, INFINITE, INFINITE_ENUMERATE, INFINITE_IMAGE, .. } := D.pses1
  let { REAL_LT_TRANS, WF_REC, WF_num, WLOG_LT, num_INFINITE, .. } := D.pses2
  let { FORALL_POS_MONO_1, UPPER_BOUND_FINITE_SET, .. } := D.pmisc
  let { CLOSED_IN_EMPTY, CLOSED_IN_IMP_SUBSET, .. } := D.pmet1
  let { CLOSED_IN_COMPACT, CLOSED_IN_LIMPT, CLOSED_IN_SING, CLOSED_LIMPT, CLOSED_SUBSET_EQ,
        COMPACT_DIFF, COMPACT_EQ_BOLZANO_WEIERSTRASS, COMPACT_SEQUENCE_WITH_LIMIT,
        COMPACT_SEQUENCE_WITH_LIMIT_GEN, .. } := D.ptop1
  let { CONTINUOUS_ON_CLOSED_GEN, .. } := D.ptop2
  let { CONTINUOUS_WITHIN_SEQUENTIALLY_ALT, .. } := D.ptop3
  let { LIMPT_DELETE, LIMPT_INSERT, LIMPT_SEQUENTIAL, .. } := D.ptop4
  let { SUBSET_BALL, limit_point_of, locally, .. } := D.ptop5
  -- @@SCOPE END

  let PROPER_MAP_TO_COMPACT ← prove
   r"!f:real^M->real^N s t.
        (!k. k SUBSET t /\ compact k ==> compact {x | x IN s /\ f x IN k}) /\
        compact t /\ IMAGE f s SUBSET t
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"t:real^N->bool"]
          CONTINUOUS_ON_CLOSED_GEN) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    X_GEN_TAC (← q r"c:real^N->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CLOSED_IN_COMPACT)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_IMP_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"c:real^N->bool")) THEN
    ASM_SIMP_TAC [CLOSED_SUBSET_EQ, COMPACT_IMP_CLOSED, SUBSET_RESTRICT])

  let CONTINUOUS_WITHIN_SEQUENTIALLY_COMPACT_MAP ← prove
   r"!f:real^M->real^N s x.
        (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\ x IN s
        ==> (f continuous (at x within s) <=>
             !p y. (!n. p n IN s) /\ (p --> x) sequentially /\ (!n. f(p n) = y)
                   ==> f x = y)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"p:num->real^M") THEN
      DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"(f:real^M->real^N) o (p:num->real^M)") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      ASM_REWRITE_TAC [o_DEF, LIM_CONST],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY_ALT] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_DELETE, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"p:num->real^M"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"?y. INFINITE {n:num | (f:real^M->real^N) (p n) = y}") THENL
     [FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"y:real^N")) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC [← q r"(p:num->real^M) o (r:num->num)", ← q r"y:real^N"] THEN
      ASM_SIMP_TAC [o_THM, LIM_SUBSEQUENCE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (fun th => if HolCore.Basics.is_neg (concl th)
        then UNDISCH_TAC (concl th) else HolCore.Tactics.FAIL_TAC "check") THEN
      REWRITE_TAC [CONTRAPOS_THM] THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP (← MESON [INFINITE, FINITE_EMPTY]
        (← q r"INFINITE s ==> ~(s = {})"))) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [DIST_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?r. (!n m. m < n ==> (r:num->num) m < r n) /\
          (!n m. m < n ==> ~((f:real^M->real^N)(p(r m)) = f(p(r n))))")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"?r. !n. r n = @y.
                      !m. m < n
                          ==> (r:num->num) m < y /\
                             ~((f:real^M->real^N)(p(r m)) = f(p y))")
      MP_TAC THENL
       [MATCH_MP_TAC (← MATCH_MP WF_REC WF_num) THEN
        REPEAT STRIP_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
        REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
        CONV_TAC SELECT_CONV THEN
        MP_TAC (← ISPECL
         [← q r"\i:num. i",
          ← q r"UNIONS {{i | (f:real^M->real^N)(p i) = f(p(r m:num))}
                  | m |
                   m IN {m:num | m < n}}"]
          UPPER_BOUND_FINITE_SET) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [NOT_EXISTS_THM, INFINITE]) THEN
        ASM_REWRITE_TAC [FINITE_UNIONS, FORALL_IN_GSPEC] THEN
        ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, FINITE_NUMSEG_LT] THEN
        REWRITE_TAC [FORALL_IN_UNIONS, FORALL_IN_IMAGE, IMP_CONJ,
                    RIGHT_FORALL_IMP_THM, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N + 1") THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
        REWRITE_TAC [← ARITH_RULE (← q r"m < N + 1 <=> m <= N")] THEN
        MESON_TAC [← ARITH_RULE (← q r"~(N + 1 <= N)")]],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC
     (← q r"(x:real^M) INSERT IMAGE (p o (r:num->num)) (:num)")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [COMPACT_SEQUENCE_WITH_LIMIT, LIM_SUBSEQUENCE] THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"ball((f:real^M->real^N) x,e)") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ] COMPACT_DIFF)) THEN
    REWRITE_TAC [OPEN_BALL] THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL, ← SET_RULE
     (← q r"f x IN b ==> IMAGE f (x INSERT s) DIFF b = IMAGE f s DIFF b")] THEN
    REWRITE_TAC [IMAGE_o] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM IN_BALL), NOT_EXISTS_THM]) THEN
    ASM_SIMP_TAC [← SET_RULE
     (← q r"(!n. ~(f(p n) IN s))
      ==> IMAGE f (IMAGE p t) DIFF s = IMAGE f (IMAGE p t)")] THEN
    GEN_REWRITE_TAC LAND_CONV [COMPACT_EQ_BOLZANO_WEIERSTRASS] THEN
    SUBGOAL_THEN
     (← q r"!m n. (f:real^M->real^N) (p ((r:num->num) m)) = f (p (r n)) <=> m = n")
    ASSUME_TAC THENL [MATCH_MP_TAC WLOG_LT THEN ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC
      (← q r"IMAGE (f:real^M->real^N) (IMAGE p (IMAGE (r:num->num) (:num)))")) THEN
    REWRITE_TAC [SUBSET_REFL] THEN ANTS_TAC THENL
     [REWRITE_TAC [← GSYM IMAGE_o] THEN MATCH_MP_TAC INFINITE_IMAGE THEN
      REWRITE_TAC [num_INFINITE, IN_UNIV, o_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IN_UNIV] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"i:num")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"(x:real^M) INSERT (IMAGE (p o (r:num->num)) (:num) DELETE p(r i))")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          COMPACT_SEQUENCE_WITH_LIMIT_GEN)) THEN
      REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [IMAGE_CLAUSES] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
     (← SET_RULE (← q r"(!i. i IN s /\ f i = f a ==> i = a)
                ==> IMAGE f (s DELETE a) = IMAGE f s DELETE f a")) o
     rand o rand o lhand o snd) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [IMAGE_o] THEN ASM SET_TAC [], DISCH_THEN SUBST1_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_CLOSED) THEN
    REWRITE_TAC [CLOSED_LIMPT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:real^M->real^N) (p((r:num->num) i))")) THEN
    ASM_SIMP_TAC [LIMPT_INSERT, LIMPT_DELETE, IMAGE_o, IN_DELETE, IN_INSERT] THEN
    ASM_MESON_TAC [CENTRE_IN_BALL])

  let COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON ← prove
   r"!f:real^M->real^N s.
        (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\
        (!y. closed_in (subtopology euclidean s) {x | x IN s /\ f x = y})
        ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p <=> ~ ~p")] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"s:real^M->bool", ← q r"x:real^M"]
          CONTINUOUS_WITHIN_SEQUENTIALLY_COMPACT_MAP) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:num->real^M", ← q r"y:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^N")) THEN
    REWRITE_TAC [CLOSED_IN_LIMPT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN REWRITE_TAC [LIMPT_SEQUENTIAL] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"p:num->real^M")) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, IN_DELETE] THEN ASM_MESON_TAC [])

  let COMPACT_CONTINUOUS_IMAGE_EQ ← prove
   r"!f:real^M->real^N s.
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (f continuous_on s <=>
             !t. compact t /\ t SUBSET s ==> compact(IMAGE f t))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [COMPACT_CONTINUOUS_IMAGE, CONTINUOUS_ON_SUBSET], DISCH_TAC] THEN
    MATCH_MP_TAC COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], X_GEN_TAC (← q r"y:real^N")] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN s /\ (f:real^M->real^N) x = y} = {} \/
      ?x. x IN s /\ {x | x IN s /\ (f:real^M->real^N) x = y} = {x}")
    STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [],
      ASM_REWRITE_TAC [CLOSED_IN_EMPTY],
      ASM_REWRITE_TAC [CLOSED_IN_SING]])

  let CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN ← prove
   r"!P f:real^M->real^N s.
     locally P s /\ (!c. P c ==> connected c)
     ==> (f continuous_on s <=>
          (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\
          (!c. c SUBSET s /\ P c ==> connected(IMAGE f c)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [COMPACT_CONTINUOUS_IMAGE, CONNECTED_CONTINUOUS_IMAGE,
                    CONTINUOUS_ON_SUBSET],
      STRIP_TAC] THEN
    REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
    X_GEN_TAC (← q r"a:real^M") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY_COMPACT_MAP] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:num->real^M", ← q r"b:real^N"] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!n. ?c x. a IN c /\ x IN c /\ (f:real^M->real^N) x = b /\
                P c /\ c SUBSET s /\ c SUBSET ball(a,inv(&n + &1))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally]) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"s INTER ball(a:real^M,inv(&n + &1))", ← q r"a:real^M"]) THEN
      SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_BALL, IN_INTER, CENTRE_IN_BALL] THEN
      ASM_REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->bool") MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^M->bool") THEN
      REWRITE_TAC [SUBSET_INTER] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_SEQUENTIALLY]) THEN
      FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
       [OPEN_IN_CONTAINS_BALL]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:real^M")) THEN
      ASM_REWRITE_TAC [INTER_SUBSET] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (MP_TAC o SPEC (← q r"m:num"))) THEN
      REWRITE_TAC [LE_REFL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
      REWRITE_TAC [← GSYM IN_BALL] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(p:num->real^M) m") THEN ASM SET_TAC [],
      PURE_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:num->real^M->bool", ← q r"x:num->real^M"] THEN
      STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. ?u. u IN c n /\ (f:real^M->real^N) u IN ball(b,inv(&n + &1)) DELETE b")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      SUBGOAL_THEN (← q r"connected (IMAGE (f:real^M->real^N) (c(n:num)))")
      MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N") o
       MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] CONNECTED_IMP_PERFECT)) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [limit_point_of]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"ball(b:real^N,inv(&n + &1))")) THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, REAL_LT_INV_EQ] THEN
      ANTS_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [],
      PURE_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      X_GEN_TAC (← q r"u:num->real^M") THEN
      REWRITE_TAC [FORALL_AND_THM, IN_DELETE] THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"compact(IMAGE (f:real^M->real^N) (a INSERT IMAGE u (:num)))")
    MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_SEQUENCE_WITH_LIMIT THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN MATCH_MP_TAC FORALL_POS_MONO_1 THEN
      CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ONCE_REWRITE_TAC [DIST_SYM]] THEN
      REWRITE_TAC [← GSYM IN_BALL] THEN
      X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"ball(a:real^M,inv(&m + &1)) SUBSET ball(a,inv(&n + &1))")
        (fun th => ASM SET_TAC [th]) THEN
      MATCH_MP_TAC SUBSET_BALL THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LT, REAL_OF_NUM_LE] THEN
      ASM_ARITH_TAC,
     DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_CLOSED) THEN
     REWRITE_TAC [CLOSED_LIMPT] THEN DISCH_THEN (MP_TAC o SPEC (← q r"b:real^N")) THEN
     REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
     REWRITE_TAC [LIMPT_APPROACHABLE, EXISTS_IN_IMAGE] THEN
     MATCH_MP_TAC FORALL_POS_MONO_1 THEN
     CONJ_TAC THENL [MESON_TAC [REAL_LT_TRANS], ONCE_REWRITE_TAC [DIST_SYM]] THEN
     REWRITE_TAC [← GSYM IN_BALL] THEN ASM SET_TAC []])

  let CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING ← prove
   r"!f:real^M->real^N s.
        locally connected s
        ==> (f continuous_on s <=>
             (!c. c SUBSET s /\ compact c ==> compact(IMAGE f c)) /\
             (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c)))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN THEN
    ASM_REWRITE_TAC [])

  return { PROPER_MAP_TO_COMPACT, CONTINUOUS_WITHIN_SEQUENTIALLY_COMPACT_MAP,
           COMPACT_CLOSED_POINTIMAGES_IMP_CONTINUOUS_ON, COMPACT_CONTINUOUS_IMAGE_EQ,
           CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING_GEN,
           CONTINUOUS_EQ_COMPACT_CONNECTED_PRESERVING }

