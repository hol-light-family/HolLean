    MP_TAC (← ISPECL
     [← q r"\n. (f:num->real^N->real^1) (N + n)", ← q r"g:real^N->real^1",
      ← q r"s:real^N->bool", ← q r"t:real^N->bool", ← q r"B:real"]
          FATOU) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\n:num. N + n") o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] LIM_SUBSEQUENCE)) THEN
      REWRITE_TAC [o_DEF, LT_ADD_LCANCEL],
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE THEN
      EXISTS_TAC (← q r"t:real^N->bool") THEN
      ASM_REWRITE_TAC [DIMINDEX_1, RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
      REWRITE_TAC [IMP_IMP, FORALL_1, ← GSYM drop] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LBOUND) THEN
      EXISTS_TAC (← q r"\n. (f:num->real^N->real^1) n x") THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"N:num") THEN REWRITE_TAC [LE_EXISTS, LEFT_IMP_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN ASM_SIMP_TAC [FORALL_UNWIND_THM2]])

  pure { FATOU, LIEB, FATOU_STRONG }

/- ------------------------------------------------------------------------- -/
/- Fundamental theorem of calculus, starting with strong forms.             -/
/- (integration.ml 12900-13285)                                             -/
/- ------------------------------------------------------------------------- -/

structure INAJ where
  FUNDAMENTAL_THEOREM_OF_CALCULUS_BARTLE : thm
  FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAJ [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINK : INK) (BINL : INL) (BINP : INP) (BINAG : INAG) : ExceptT String IO INAJ := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_EQ_0_1, INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, .. } :=
        BINA
  let { GAUGE_BALL_DEPENDENT, GAUGE_INTER, .. } := BINB
  let { fine, has_integral, TAGGED_DIVISION_OF, tagged_division_of,
        TAGGED_DIVISION_OF_FINITE, tagged_partial_division_of, .. } := BINC
  let { HAS_INTEGRAL_REFL, .. } := BINE
  let { HAS_INTEGRAL_SPIKE, .. } := BINK
  let { ADDITIVE_TAGGED_DIVISION_1, .. } := BINL
  let { TAGGED_PARTIAL_DIVISION_COMMON_TAGS, .. } := BINP
  let { NEGLIGIBLE_COUNTABLE, .. } := BINAG
  let { CARD_CLAUSES, DIMINDEX_1, EXISTS_PAIR_THM, EXTENSION, FINITE_IMAGE,
        FINITE_INDEX_NUMSEG, FINITE_INTER, FINITE_NUMSEG, FINITE_SUBSET, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_IN_IMAGE, IMP_CONJ, IMP_IMP, IN_DIFF,
        IN_ELIM_PAIR_THM, INTER_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM,
        PAIR_EQ, REAL_DIV_RMUL, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_INV_MUL, REAL_INV_POW, REAL_LE_DIV,
        REAL_LE_INV_EQ, REAL_LE_LMUL_EQ, REAL_LE_MUL, REAL_LE_RMUL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_LE,
        REAL_LT_MUL, REAL_LT_POW2, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LE, REAL_POS, REAL_POW_LE,
        REAL_SUB_LE, REAL_SUB_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, SUM_CONST, SUM_EQ, SUM_EQ_SUPERSET, SUM_IMAGE, SUM_LE,
        SUM_LMUL, SUM_RMUL, SUM_SUBSET_SIMPLE, SUM_SUPERSET, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_EQ, DROP_SUB, DROP_VSUM, ENDS_IN_INTERVAL, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_POS_LT, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL,
        VSUM_EQ, VSUM_EQ_SUPERSET, VSUM_NEG, VSUM_SUB, VSUM_UNION, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { IN_BALL, IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { continuous_on, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        NORM_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { LE_0, LT, SUB_0, .. } := D.dv.dg.qsession
  let { INFINITE, INJECTIVE_ON_LEFT_INVERSE, .. } := D.dv.qsession
  let { HAS_DERIVATIVE_WITHIN_ALT, has_vector_derivative, .. } := D.qderivatives
  let { COUNTABLE_AS_INJECTIVE_IMAGE, .. } := D.qcard
  let { SUM_GP, UPPER_BOUND_FINITE_SET, .. } := D.qmisc
  let { LAMBDA_PAIR_THM, REAL_POW_ADD, SUM_GROUP, SUM_SUBSET, .. } := D.qsession
  let { INTERVAL_EQ_EMPTY, VSUM_NORM_LE, .. } := D.qvec
  -- @@SCOPE END

  let FUNDAMENTAL_THEOREM_OF_CALCULUS_BARTLE ← prove
   r"!f:real^1->real^N f' s a b.
      negligible s /\ drop a <= drop b /\
      (!x. x IN interval[a,b] DIFF s
           ==> (f has_vector_derivative f'(x)) (at x within interval[a,b])) /\
      (!e. &0 < e
           ==> ?g. gauge g /\
                   !p. p tagged_partial_division_of interval[a,b] /\
                       g fine p /\ IMAGE FST p SUBSET s
                       ==> norm (vsum p (\(x,k). f(interval_upperbound k) -
                                                 f(interval_lowerbound k)))
                           < e)
      ==> (f' has_integral (f(b) - f(a))) (interval[a,b])"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"b:real^1 = a") THEN
    ASM_REWRITE_TAC [HAS_INTEGRAL_REFL, VECTOR_SUB_REFL] THEN
    SUBGOAL_THEN (← q r"drop a < drop b") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [REAL_LT_LE, DROP_EQ], ALL_TAC] THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    EXISTS_TAC (← q r"(\x. if x IN s then vec 0 else f' x):real^1->real^N") THEN
    EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_SIMP_TAC [IN_DIFF] THEN
    ABBREV_TAC (← q r"g = \x. if x IN s then vec 0 else (f':real^1->real^N) x") THEN
    REWRITE_TAC [has_integral] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g1:real^1->real^1->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!x. ?d. &0 < d /\
            (x IN interval[a,b] DIFF s
             ==> !y. norm(y - x) < d /\ y IN interval[a:real^1,b]
                     ==> norm(f y - f x - drop(y - x) % g x:real^N) <=
                         e / &2 / (drop b - drop a) * norm(y - x))")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF] THEN
      ASM_CASES_TAC (← q r"(x:real^1) IN interval[a,b]") THENL
       [ALL_TAC, EXISTS_TAC (← q r"&1") THEN ASM_REWRITE_TAC [REAL_LT_01]] THEN
      ASM_CASES_TAC (← q r"(x:real^1) IN s") THEN ASM_REWRITE_TAC [] THENL
       [MESON_TAC [REAL_LT_01], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
