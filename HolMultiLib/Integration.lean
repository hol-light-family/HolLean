    ASM_MESON_TAC [HAS_BOUNDED_VARIATION_WORKS])

  let BOUNDED_VARIATION_FROM_PASTECART ← prove
   r"!f:real^1->real^N g:real^1->real^P s.
      (\x. pastecart (f x) (g x)) has_bounded_variation_on s
      ==> (f has_bounded_variation_on s /\
