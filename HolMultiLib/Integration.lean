/- Gauges; divisions.  (integration.ml 419-1377)                             -/
/- ------------------------------------------------------------------------- -/

structure INB where
  gauge : thm
  GAUGE_BALL_DEPENDENT : thm
  GAUGE_BALL : thm
  GAUGE_TRIVIAL : thm
  GAUGE_INTER : thm
  GAUGE_INTERS : thm
  GAUGE_EXISTENCE_LEMMA : thm
  division_of : thm
  DIVISION_OF : thm
  DIVISION_OF_FINITE : thm
  DIVISION_OF_SELF : thm
  DIVISION_OF_TRIVIAL : thm
  EMPTY_DIVISION_OF : thm
  DIVISION_OF_SING : thm
  ELEMENTARY_EMPTY : thm
  ELEMENTARY_INTERVAL : thm
  DIVISION_CONTAINS : thm
  FORALL_IN_DIVISION : thm
  FORALL_IN_DIVISION_NONEMPTY : thm
  DIVISION_OF_SUBSET : thm
  DIVISION_OF_UNION_SELF : thm
  DIVISION_OF_CONTENT_0 : thm
  DIVISION_INTER : thm
  DIVISION_INTER_1 : thm
  ELEMENTARY_INTER : thm
  ELEMENTARY_INTERS : thm
  DIVISION_DISJOINT_UNION : thm
  PARTIAL_DIVISION_EXTEND_1 : thm
  PARTIAL_DIVISION_EXTEND_INTERVAL : thm
  ELEMENTARY_BOUNDED : thm
  ELEMENTARY_SUBSET_INTERVAL : thm
  DIVISION_UNION_INTERVALS_EXISTS : thm
  DIVISION_OF_UNIONS : thm
  ELEMENTARY_UNION_INTERVAL_STRONG : thm
  ELEMENTARY_UNION_INTERVAL : thm
  ELEMENTARY_UNIONS_INTERVALS : thm
  ELEMENTARY_UNION : thm
  PARTIAL_DIVISION_EXTEND : thm
  INTERVAL_SUBDIVISION : thm
  DIVISION_OF_NONTRIVIAL : thm
  DIVISION_OF_AFFINITY : thm
  DIVISION_OF_TRANSLATION : thm
  DIVISION_OF_REFLECT : thm
  ELEMENTARY_COMPACT : thm
  OPEN_COUNTABLE_LIMIT_ELEMENTARY : thm
  DIVISION_1_SORT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINB [HolBase] (D : IntegrationDeps) (BINA : INA) : ExceptT String IO INB := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0, CONTENT_POS_LE, CONTENT_SUBSET, INTER_INTERIOR_UNIONS_INTERVALS,
        INTERVAL_LOWERBOUND_NONEMPTY, .. } := BINA
  let { AND_FORALL_THM, CARD_DELETE, CARD_EQ_0, CART_EQ, CONJ_ACI, CONJ_ASSOC,
        DE_MORGAN_THM, EMPTY_SUBSET, EQ_IMP, EQ_TRANS, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE,
        EXISTS_OR_THM, EXISTS_PAIR_THM, EXISTS_REFL, EXTENSION, FINITE_DELETE, FINITE_DIFF,
        FINITE_EMPTY, FINITE_IMAGE, FINITE_IMAGE_INJ_EQ, FINITE_INDUCT_STRONG,
        FINITE_INSERT, FINITE_NUMSEG, FINITE_POWERSET, FINITE_RESTRICT, FINITE_RULES,
        FINITE_SING, FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, FORALL_AND_THM,
        FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IN_DELETE, IN_DIFF, INTER_ACI,
        INTER_COMM, INTER_EMPTY, INTER_SUBSET, INTER_UNIV, INTERS_0, INTERS_INSERT, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_INTERS, IN_NUMSEG, IN_SING, IN_UNION,
        IN_UNIONS, IN_UNIV, LAMBDA_BETA, LE_REFL, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM,
        LT_REFL, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_OR,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, NOT_INSERT_EMPTY,
        OR_EXISTS_THM, PAIR_EQ, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_POW_2, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, RIGHT_OR_DISTRIB, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM, SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNION, .. }
        := D.dv.dg.pt.cvx.core5
  let { num_WOP, o_THM, SUM_DELTA, SWAP_FORALL_THM, UNION_COMM, UNION_EMPTY, UNIONS_0,
        UNIONS_GSPEC, UNIONS_IMAGE, UNIONS_INSERT, UNIONS_SUBSET, WLOG_LE, .. } :=
        D.dv.dg.pt.cvx.core6
  let { DIST_REFL, .. } := D.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, INTERVAL_SING, LIFT_DROP, LINEAR_SCALING, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { dist, dot, VECTOR_ADD_LID, VECTOR_MUL_LCANCEL, VECTOR_MUL_LZERO,
        VECTOR_SUB_COMPONENT, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top1
  let { COMPACT_INTERVAL, .. } := D.dv.dg.pt.cvx.top2
  let { IN_BALL, IN_INTERVAL_1, INTERIOR_CLOSED_INTERVAL, INTERIOR_INTER, INTERIOR_SUBSET,
        INTERIOR_TRANSLATION, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, LIMPT_APPROACHABLE,
        OPEN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTER, OPEN_INTERIOR, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON,
        MESON_TAC, new_definition, parse_as_infix, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { DELETE_SUBSET, UNIONS_1, .. } := D.dv.dg.pt.qses
  let { BOUNDED_INTERVAL, BOUNDED_UNIONS, CLOSED_UNIONS, OPEN_INTERS, .. } :=
        D.dv.dg.pt.qtop
  let { WF_INDUCT_TAC, .. } := D.dv.dg.pt
  let { COUNTABLE_AS_IMAGE, .. } := D.dv.dg.qcard
  let { SUBSET_UNIONS, .. } := D.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { CLOSED_LIMPT, .. } := D.dv.qtopology1
  let { CONS_11, FINITE_CROSS, FINITE_HAS_SIZE, FINITE_NUMSEG_LE, IMAGE_I, IMAGE_UNIONS, IN_CROSS,
        LE_LT, POW_2_SQRT_ABS, TOPOLOGICAL_SORT, .. } := D.qsession
  let { AFFINITY_INVERSES, BOUNDED_SUBSET_CLOSED_INTERVAL, COMPACT_UNIONS, EQ_INTERVAL_1,
        IMAGE_AFFINITY_INTERVAL, INTER_INTERVAL_1, INTERIOR_FINITE_INTERS,
        INTERIOR_INJECTIVE_LINEAR_IMAGE, INTERIOR_INTERVAL,
        OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, .. } := D.qtopology
  let { INTER_INTERVAL, INTERVAL_EQ_EMPTY, vector_norm, .. } := D.qvec
  -- @@SCOPE END

  -- `el n o CONJUNCTS` and `last o CONJUNCTS` as theorem functions.
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))
  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let gauge ← new_definition
   r"gauge d <=> !x. x IN d(x) /\ open(d(x))"

  let GAUGE_BALL_DEPENDENT ← prove
   r"!e. (!x. &0 < e(x)) ==> gauge(\x. ball(x,e(x)))"
   (SIMP_TAC [gauge, OPEN_BALL, IN_BALL, DIST_REFL])

  let GAUGE_BALL ← prove
   r"!e. &0 < e ==> gauge (\x. ball(x,e))"
   (SIMP_TAC [gauge, OPEN_BALL, IN_BALL, DIST_REFL])

  let GAUGE_TRIVIAL ← prove
   r"gauge (\x. ball(x,&1))"
   (SIMP_TAC [GAUGE_BALL, REAL_LT_01])

  let GAUGE_INTER ← prove
   r"!d1 d2. gauge d1 /\ gauge d2 ==> gauge (\x. (d1 x) INTER (d2 x))"
   (SIMP_TAC [gauge, IN_INTER, OPEN_INTER])

  let GAUGE_INTERS ← prove
   r"!s. FINITE s /\ (!d. d IN s ==> gauge (f d))
       ==> gauge(\x. INTERS {f d x | d IN s})"
   (REWRITE_TAC [gauge, IN_INTERS] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f d x | d IN s} = IMAGE (\d. f d x) s")] THEN
    SIMP_TAC [FORALL_IN_IMAGE, OPEN_INTERS, FINITE_IMAGE])

  let GAUGE_EXISTENCE_LEMMA ← prove
   r"(!x. ?d. p x ==> &0 < d /\ q d x) <=>
   (!x. ?d. &0 < d /\ (p x ==> q d x))"
   (MESON_TAC [REAL_LT_01])

  parse_as_infix ("division_of", (12, "right"))

  let division_of ← new_definition
   r"s division_of i <=>
        FINITE s /\
        (!k. k IN s
             ==> k SUBSET i /\ ~(k = {}) /\ ?a b. k = interval[a,b]) /\
        (!k1 k2. k1 IN s /\ k2 IN s /\ ~(k1 = k2)
                 ==> interior(k1) INTER interior(k2) = {}) /\
        (UNIONS s = i)"

  let DIVISION_OF ← prove
   r"s division_of i <=>
        FINITE s /\
        (!k. k IN s ==> ~(k = {}) /\ ?a b. k = interval[a,b]) /\
        (!k1 k2. k1 IN s /\ k2 IN s /\ ~(k1 = k2)
                 ==> interior(k1) INTER interior(k2) = {}) /\
        UNIONS s = i"
   (REWRITE_TAC [division_of] THEN SET_TAC [])

  let DIVISION_OF_FINITE ← prove
   r"!s i. s division_of i ==> FINITE s"
   (MESON_TAC [division_of])

  let DIVISION_OF_SELF ← prove
   r"!a b. ~(interval[a,b] = {}) ==> {interval[a,b]} division_of interval[a,b]"
   (REWRITE_TAC [division_of, FINITE_INSERT, FINITE_RULES, IN_SING, UNIONS_1] THEN
    MESON_TAC [SUBSET_REFL])

  let DIVISION_OF_TRIVIAL ← prove
   r"!s. s division_of {} <=> s = {}"
   (REWRITE_TAC [division_of, SUBSET_EMPTY, CONJ_ASSOC] THEN
    REWRITE_TAC [← TAUT (← q r"~(p /\ ~p)"), ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [← AC CONJ_ACI (← q r"((a /\ b) /\ c) /\ d <=> b /\ a /\ c /\ d")] THEN
    GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(a ==> b) ==> (a /\ b <=> a)")) THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [FINITE_RULES, UNIONS_0, NOT_IN_EMPTY])

  let EMPTY_DIVISION_OF ← prove
   r"!s. {} division_of s <=> s = {}"
   (REWRITE_TAC [division_of, UNIONS_0, FINITE_EMPTY, NOT_IN_EMPTY] THEN
    MESON_TAC [])

  let DIVISION_OF_SING ← (do
    let lemma ← prove
     r"s SUBSET {{a}} /\ p /\ UNIONS s = {a} <=> s = {{a}} /\ p"
     (EQ_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"UNIONS {a} = a")] THEN ASM SET_TAC [])
    prove
     r"!s a. s division_of interval[a,a] <=> s = {interval[a,a]}"
     (REWRITE_TAC [division_of, INTERVAL_SING] THEN
      REWRITE_TAC [← SET_RULE (← q r"k SUBSET {a} /\ ~(k = {}) /\ p <=> k = {a} /\ p")] THEN
      REWRITE_TAC [← GSYM INTERVAL_SING] THEN
      REWRITE_TAC [← MESON [] (← q r"(k = interval[a,b] /\ ?c d. k = interval[c,d]) <=>
                           (k = interval[a,b])")] THEN
      REWRITE_TAC [← SET_RULE (← q r"(!k. k IN s ==> k = a) <=> s SUBSET {a}")] THEN
      REWRITE_TAC [INTERVAL_SING, lemma] THEN MESON_TAC [FINITE_RULES, IN_SING]))

  let ELEMENTARY_EMPTY ← prove
   r"?p. p division_of {}"
   (REWRITE_TAC [DIVISION_OF_TRIVIAL, EXISTS_REFL])

  let ELEMENTARY_INTERVAL ← prove
   r"!a b. ?p. p division_of interval[a,b]"
   (MESON_TAC [DIVISION_OF_TRIVIAL, DIVISION_OF_SELF])

  let DIVISION_CONTAINS ← prove
   r"!s i. s division_of i ==> !x. x IN i ==> ?k. x IN k /\ k IN s"
   (REWRITE_TAC [division_of, EXTENSION, IN_UNIONS] THEN MESON_TAC [])

  let FORALL_IN_DIVISION ← prove
   r"!P d i. d division_of i
           ==> ((!x. x IN d ==> P x) <=>
               (!a b. interval[a,b] IN d ==> P(interval[a,b])))"
   (REWRITE_TAC [division_of] THEN MESON_TAC [])

  let FORALL_IN_DIVISION_NONEMPTY ← prove
   r"!P d i.
         d division_of i
         ==> ((!x. x IN d ==> P x) <=>
              (!a b. interval [a,b] IN d /\ ~(interval[a,b] = {})
                     ==> P (interval [a,b])))"
   (REWRITE_TAC [division_of] THEN MESON_TAC [])

  let DIVISION_OF_SUBSET ← prove
   r"!p q:(real^N->bool)->bool.
        p division_of (UNIONS p) /\ q SUBSET p ==> q division_of (UNIONS q)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [division_of] THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THENL
     [ASM_MESON_TAC [FINITE_SUBSET], ASM SET_TAC [], ASM SET_TAC []])

  let DIVISION_OF_UNION_SELF ← prove
   r"!p s. p division_of s ==> p division_of (UNIONS p)"
   (REWRITE_TAC [division_of] THEN MESON_TAC [])

  let DIVISION_OF_CONTENT_0 ← prove
   r"!a b d. content(interval[a,b]) = &0 /\ d division_of interval[a,b]
           ==> !k. k IN d ==> content k = &0"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM, CONTENT_POS_LE] THEN
    ASM_MESON_TAC [CONTENT_SUBSET, division_of])

  let DIVISION_INTER ← (do
    let lemma ← prove
     r"{k1 INTER k2 | k1 IN p1 /\ k2 IN p2 /\ ~(k1 INTER k2 = {})} =
        {s | s IN IMAGE (\(k1,k2). k1 INTER k2) (p1 CROSS p2) /\
             ~(s = {})}"
     (REWRITE_TAC [EXTENSION] THEN
      REWRITE_TAC [IN_IMAGE, IN_ELIM_THM, EXISTS_PAIR_THM, IN_CROSS] THEN
      MESON_TAC [])
    prove
     r"!s1 s2:real^N->bool p1 p2.
        p1 division_of s1 /\
        p2 division_of s2
        ==> {k1 INTER k2 | k1 IN p1 /\ k2 IN p2 /\ ~(k1 INTER k2 = {})}
            division_of (s1 INTER s2)"
     (REPEAT GEN_TAC THEN REWRITE_TAC [DIVISION_OF] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [lemma, FINITE_RESTRICT, FINITE_CROSS, FINITE_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [INTER_INTERVAL],
        REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(interior x1 INTER interior x2 = {} \/
           interior y1 INTER interior y2 = {}) /\
          interior(x1 INTER y1) SUBSET interior(x1) /\
          interior(x1 INTER y1) SUBSET interior(y1) /\
          interior(x2 INTER y2) SUBSET interior(x2) /\
          interior(x2 INTER y2) SUBSET interior(y2)
          ==> interior(x1 INTER y1) INTER interior(x2 INTER y2) = {}")) THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REPEAT CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC [],
        REWRITE_TAC [← SET_RULE (← q r"UNIONS {x | x IN s /\ ~(x = {})} = UNIONS s")] THEN
        REPEAT (FIRST_X_ASSUM (SUBST_ALL_TAC o SYM)) THEN
        GEN_REWRITE_TAC I [EXTENSION] THEN
        REWRITE_TAC [IN_UNIONS, IN_IMAGE, EXISTS_PAIR_THM, IN_CROSS, IN_INTER] THEN
        MESON_TAC [IN_INTER]]))

  let DIVISION_INTER_1 ← prove
   r"!d i a b:real^N.
        d division_of i /\ interval[a,b] SUBSET i
        ==> { interval[a,b] INTER k | k |
                 k IN d /\ ~(interval[a,b] INTER k = {}) }
            division_of interval[a,b]"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THEN
    ASM_REWRITE_TAC [INTER_EMPTY, ← SET_RULE (← q r"{{} | F} = {}"),
                     DIVISION_OF_TRIVIAL] THEN
    MP_TAC (← ISPECL [← q r"interval[a:real^N,b]", ← q r"i:real^N->bool",
                      ← q r"{interval[a:real^N,b]}", ← q r"d:(real^N->bool)->bool"]
                  DIVISION_INTER) THEN
    ASM_SIMP_TAC [DIVISION_OF_SELF, ← SET_RULE (← q r"s SUBSET t ==> s INTER t = s")] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let ELEMENTARY_INTER ← prove
   r"!s t. (?p. p division_of s) /\ (?p. p division_of t)
         ==> ?p. p division_of (s INTER t)"
   (MESON_TAC [DIVISION_INTER])

  let ELEMENTARY_INTERS ← prove
   r"!f:(real^N->bool)->bool.
        FINITE f /\ ~(f = {}) /\
        (!s. s IN f ==> ?p. p division_of s)
        ==> ?p. p division_of (INTERS f)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:real^N->bool", ← q r"s:(real^N->bool)->bool"] THEN
    ASM_CASES_TAC (← q r"s:(real^N->bool)->bool = {}") THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [INTERS_0, INTER_UNIV, IN_SING] THEN MESON_TAC [],
      REWRITE_TAC [IN_INSERT] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC ELEMENTARY_INTER THEN ASM_MESON_TAC []])

  let DIVISION_DISJOINT_UNION ← prove
   r"!s1 s2:real^N->bool p1 p2.
        p1 division_of s1 /\
        p2 division_of s2 /\
        interior s1 INTER interior s2 = {}
        ==> (p1 UNION p2) division_of (s1 UNION s2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [division_of] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [FINITE_UNION, IN_UNION, EXISTS_OR_THM, ← SET_RULE
     (← q r"UNIONS {x | P x \/ Q x} = UNIONS {x | P x} UNION UNIONS {x | Q x}")] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REPEAT STRIP_TAC THENL
     [ASM SET_TAC [], ALL_TAC, ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!s' t'. s SUBSET s' /\ t SUBSET t' /\ s' INTER t' = {}
              ==> s INTER t = {}"))
    THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"interior s1:real^N->bool", ← q r"interior s2:real^N->bool"],
      MAP_EVERY EXISTS_TAC
       [← q r"interior s2:real^N->bool", ← q r"interior s1:real^N->bool"]] THEN
    REPEAT CONJ_TAC THEN TRY (MATCH_MP_TAC SUBSET_INTERIOR) THEN
    ASM SET_TAC [])

  let PARTIAL_DIVISION_EXTEND_1 ← (do
    let tac1 :=
      UNDISCH_TAC (← q r"l:num <= m") THEN GEN_REWRITE_TAC LAND_CONV [LE_LT] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"l:num")) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_REWRITE_TAC [LT_REFL] THEN REAL_ARITH_TAC
    let tac2 :=
      UNDISCH_TAC (← q r"l:num <= m") THEN GEN_REWRITE_TAC LAND_CONV [LE_LT] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
       [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"l:num")) THEN ANTS_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN
        ASM_REWRITE_TAC [LT_REFL] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i:num = l") THEN
      ASM_REWRITE_TAC [LT_REFL] THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
      DISCH_TAC THEN REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"l:num"))) THEN
      ASM_REWRITE_TAC [LT_REFL] THEN REAL_ARITH_TAC
    prove
     r"!a b c d:real^N.
        interval[c,d] SUBSET interval[a,b] /\ ~(interval[c,d] = {})
        ==> ?p. p division_of interval[a,b] /\
                interval[c,d] IN p"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o
        GEN_REWRITE_RULE I [INTERVAL_NE_EMPTY])) THEN
      EXISTS_TAC
       (← q r"{interval
          [(lambda i. if i < l then (c:real^N)$i else (a:real^N)$i):real^N,
           (lambda i. if i < l then d$i else if i = l then c$l else b$i)] |
           l IN 1..(dimindex(:N)+1)} UNION
        {interval
          [(lambda i. if i < l then c$i else if i = l then d$l else a$i),
           (lambda i. if i < l then (d:real^N)$i else (b:real^N)$i):real^N] |
           l IN 1..(dimindex(:N)+1)}") THEN
      MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_UNION] THEN DISJ1_TAC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"dimindex(:N)+1") THEN
        REWRITE_TAC [IN_NUMSEG, LE_REFL, ← ARITH_RULE (← q r"1 <= n + 1")] THEN
        AP_TERM_TAC THEN SIMP_TAC [CONS_11, PAIR_EQ, CART_EQ, LAMBDA_BETA] THEN
        SIMP_TAC [← ARITH_RULE (← q r"i <= n ==> i < n + 1")],
        DISCH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET_INTERVAL]) THEN
      ASM_REWRITE_TAC [DIVISION_OF] THEN DISCH_TAC THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SIMPLE_IMAGE] THEN
        SIMP_TAC [FINITE_UNION, FINITE_IMAGE, FINITE_NUMSEG],
        REWRITE_TAC [IN_UNION, ← TAUT (← q r"a \/ b ==> c <=> (a ==> c) /\ (b ==> c)")] THEN
        REWRITE_TAC [SIMPLE_IMAGE, FORALL_AND_THM, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [IN_NUMSEG, INTERVAL_NE_EMPTY, LAMBDA_BETA] THEN
        CONJ_TAC THEN X_GEN_TAC (← q r"l:num") THEN DISCH_TAC THEN
        (CONJ_TAC THENL [ALL_TAC, MESON_TAC []]) THEN
        REPEAT STRIP_TAC THEN
        REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC []) THEN
        ASM_MESON_TAC [REAL_LE_TRANS],
        REWRITE_TAC [IN_UNION, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [← SET_RULE
          (← q r"(!y. y IN {f x | x IN s} \/ y IN {g x | x IN s} ==> P y) <=>
           (!x. x IN s ==> P(f x) /\ P(g x))")] THEN
        REWRITE_TAC [AND_FORALL_THM, IN_NUMSEG] THEN
        REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c")] THEN
        REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
        MATCH_MP_TAC WLOG_LE THEN CONJ_TAC THENL
         [REPEAT GEN_TAC THEN
          REWRITE_TAC [← TAUT (← q r"a ==> b ==> c <=> b ==> a ==> c")] THEN
          REWRITE_TAC [INTER_ACI, CONJ_ACI] THEN MESON_TAC [],
          ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"l:num", ← q r"m:num"] THEN
        DISCH_TAC THEN STRIP_TAC THEN STRIP_TAC THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"(~p ==> q) <=> (~q ==> p)")] THEN
         REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN
        REWRITE_TAC [← SET_RULE (← q r"s INTER t = {} <=> !x. ~(x IN s /\ x IN t)")] THEN
        ASM_SIMP_TAC [IN_NUMSEG, INTERVAL_NE_EMPTY, LAMBDA_BETA, IN_INTERVAL,
                      INTERIOR_CLOSED_INTERVAL] THEN
        REWRITE_TAC [AND_FORALL_THM] THEN
        REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c")] THEN
        REWRITE_TAC [NOT_FORALL_THM] THEN REPEAT CONJ_TAC THEN
