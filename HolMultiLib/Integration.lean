                vector_variation s f + vector_variation s g"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SIMP_TAC [HAS_BOUNDED_VECTOR_VARIATION] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum d (\k. norm((f:real^1->real^N)(interval_upperbound k) -
                    (f:real^1->real^N)(interval_lowerbound k)) +
