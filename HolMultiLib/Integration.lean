    REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"u:real^1->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
