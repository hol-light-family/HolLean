        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"M:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"y < i + e ==> i <= ix /\ ix <= y ==> abs(ix - i) < e"))) THEN
        CONJ_TAC THENL
         [EXPAND_TAC "i" THEN MATCH_MP_TAC REAL_LE_INF_SUBSET THEN
          REWRITE_TAC [IMAGE_EQ_EMPTY, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
          REWRITE_TAC [NUMSEG_EMPTY, NOT_LT, LE_ADD] THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN CONJ_TAC THENL
           [MATCH_MP_TAC IMAGE_SUBSET THEN
            REWRITE_TAC [SUBSET, IN_NUMSEG, IN_ELIM_THM] THEN ARITH_TAC,
            REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN ASM_MESON_TAC []],
          ALL_TAC] THEN
        specRandLhand INF THEN ANTS_TAC THENL
         [REWRITE_TAC [IMAGE_EQ_EMPTY, ← SET_RULE (← q r"{x | x IN s} = s")] THEN
          REWRITE_TAC [NUMSEG_EMPTY, NOT_LT, LE_ADD] THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          EXISTS_TAC (← q r"i:real") THEN GEN_TAC THEN REWRITE_TAC [IN_NUMSEG] THEN
