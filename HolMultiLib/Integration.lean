  let { dist, drop, VECTOR_SUB, VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_VSUM, CONTINUOUS_WITHIN, EVENTUALLY_WITHIN, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, LIM_SUB, LIM_UNIQUE, LIM_WITHIN, .. } :=
