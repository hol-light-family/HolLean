  let { CONJ_ASSOC, EMPTY_SUBSET, EXTENSION, FINITE_IMAGE, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM2, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INSERT_SUBSET,
