     [← q r"\n x. lift(norm((f:num->real^M->real^N) n x - g x) -
                (norm(f n x) - norm(g x)))",
      ← q r"(\x. vec 0):real^M->real^1",
      ← q r"\x. &2 % lift(norm((g:real^M->real^N) x))",
