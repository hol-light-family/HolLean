/- Dominated convergence variants; countable unions; more properties of     -/
/- negligible sets; almost-everywhere variants.  (integration.ml 11691-12152)-/
/- ------------------------------------------------------------------------- -/

structure INAG where
  DOMINATED_CONVERGENCE_INTEGRABLE : thm
  DOMINATED_CONVERGENCE_ABSOLUTELY_INTEGRABLE : thm
  DOMINATED_CONVERGENCE_AE : thm
  INTEGRAL_COUNTABLE_UNIONS : thm
  NEGLIGIBLE_ON_UNIV : thm
  NEGLIGIBLE_COUNTABLE_UNIONS : thm
  HAS_INTEGRAL_NEGLIGIBLE_EQ : thm
  INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE : thm
  NEGLIGIBLE_COUNTABLE : thm
  HAS_INTEGRAL_COMPONENT_LE_AE : thm
  INTEGRAL_COMPONENT_LE_AE : thm
  HAS_INTEGRAL_DROP_LE_AE : thm
  INTEGRAL_DROP_LE_AE : thm
  NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE : thm
  INTEGRAL_NORM_BOUND_INTEGRAL_AE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAG [HolBase] (D : IntegrationDeps) (BINC : INC) (BINE : INE) (BINI : INI) (BINJ : INJ) (BINK : INK) (BINN : INN) (BINP : INP) (BINQ : INQ) (BINR : INR) (BINU : INU) (BINV : INV) (BINW : INW) (BINZ : INZ) (BINAB : INAB) (BINAC : INAC) (BINAD : INAD) (BINAE : INAE) (BINAF : INAF) : ExceptT String IO INAG := do
  -- @@SCOPE BEGIN
  let { HAS_INTEGRAL_INTEGRAL, INTEGRABLE_INTEGRAL, integrable_on, .. } := BINC
  let { HAS_INTEGRAL_CMUL, HAS_INTEGRAL_EMPTY, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        HAS_INTEGRAL_LINEAR, INTEGRAL_EQ_HAS_INTEGRAL, INTEGRAL_UNIQUE, .. } := BINE
  let { HAS_INTEGRAL_COMPONENT_LE, INTEGRAL_DROP_POS, .. } := BINI
  let { negligible, .. } := BINJ
  let { HAS_INTEGRAL_NEGLIGIBLE, HAS_INTEGRAL_SPIKE, INTEGRABLE_SPIKE, INTEGRAL_SPIKE,
        NEGLIGIBLE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_SING, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNIONS,
        .. } := BINK
  let { HAS_INTEGRAL_RESTRICT_UNIV, INTEGRABLE_RESTRICT_UNIV, INTEGRABLE_SPIKE_SET,
        INTEGRAL_RESTRICT_UNIV, INTEGRAL_SPIKE_SET, .. } := BINN
  let { INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { INTEGRABLE_ON_SUBINTERVAL, INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_LEFT, .. } := BINQ
  let { HAS_INTEGRAL_STRADDLE_NULL, HAS_INTEGRAL_UNIONS_IMAGE, .. } := BINR
  let { MONOTONE_CONVERGENCE_INCREASING, .. } := BINU
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := BINV
  let { HAS_BOUNDED_SETVARIATION_ON_0, HAS_BOUNDED_SETVARIATION_ON_EQ, SET_VARIATION_0,
        SET_VARIATION_EQ, .. } := BINW
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NEG,
        ABSOLUTELY_INTEGRABLE_SPIKE, .. } := BINZ
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ, ABSOLUTELY_INTEGRABLE_SET_VARIATION,
        .. } := BINAB
  let { ABSOLUTELY_INTEGRABLE_MAX_1, ABSOLUTELY_INTEGRABLE_MIN_1, .. } := BINAC
  let { ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND, NONNEGATIVE_ABSOLUTELY_INTEGRABLE, .. } :=
        BINAD
  let { ABSOLUTELY_INTEGRABLE_COMPONENTWISE, INTEGRABLE_COMPONENTWISE, .. } := BINAE
  let { DOMINATED_CONVERGENCE, .. } := BINAF
  let { CART_EQ, DIMINDEX_1, EMPTY_GSPEC, EQ_IMP, EQ_TRANS, ETA_AX, EXISTS_IN_GSPEC,
        EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_SING, IN_UNIONS, IN_UNIV, LAMBDA_BETA, LE_1,
        LE_REFL, MONO_AND, MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IN_EMPTY,
        REAL_ARCH_INV, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD, REAL_LE_ANTISYM, REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_SYM, REAL_OF_NUM_ADD, REAL_POS, RIGHT_FORALL_IMP_THM,
        SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, real_ge, SUBSET_UNIV, UNIONS_GSPEC, UNIONS_IMAGE, .. } :=
        D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_REFL, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, ENDS_IN_INTERVAL, FORALL_1, IN_INTERVAL,
        INTERVAL_NE_EMPTY, LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_0,
        NORM_1, NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_POS_LE, NORM_POS_LT, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
        VECTOR_MUL_EQ_0, VSUM_EQ_0, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_MONO, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.met
  let { BOUNDED_EMPTY, BOUNDED_INSERT, .. } := D.dv.dg.pt.cvx.top1
  let { LIM_CONST, LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { COUNTABLE_AS_IMAGE, .. } := D.dv.dg.qcard
  let { LE_0, SUB_ADD, SUBSET_UNIONS, .. } := D.dv.dg.qsession
  let { tendsto, .. } := D.dv.dg.qtopology2
  let { LIFT_NEG, SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { LIM_COMPONENTWISE_LIFT, LIM_EVENTUALLY, .. } := D.dv.qtopology2
  let { FINITE_NUMSEG_LE, PAIRWISE_MONO, .. } := D.qsession
  let { LIM_CONST_EQ, .. } := D.qtopology
  let { DROP_INDICATOR_POS_LE, indicator, .. } := D.qvec
  -- @@SCOPE END

  let DOMINATED_CONVERGENCE_INTEGRABLE ← (do
    let lemma ← prove
     r"!f:num->real^N->real^1 g h s.
          (!k. f k absolutely_integrable_on s) /\
          h integrable_on s /\
          (!x. x IN s ==> norm(g x) <= drop(h x)) /\
          (!x. x IN s ==> ((\k. f k x) --> g x) sequentially)
          ==> g integrable_on s"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(h:real^N->real^1) absolutely_integrable_on s")
      ASSUME_TAC THENL
       [MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
        ASM_REWRITE_TAC [DIMINDEX_1, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, IMP_IMP] THEN
        ASM_MESON_TAC [REAL_LE_TRANS, NORM_POS_LE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"\n:num x:real^N.
         lift(min (max (--(drop(h x))) (drop(f n x))) (drop(h x)))",
        ← q r"g:real^N->real^1",
        ← q r"h:real^N->real^1",
        ← q r"s:real^N->bool"] DOMINATED_CONVERGENCE) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], SIMP_TAC []] THEN REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MIN_1 THEN
        ASM_REWRITE_TAC [LIFT_DROP, ETA_AX] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MAX_1 THEN
        ASM_SIMP_TAC [LIFT_NEG, LIFT_DROP, ETA_AX, ABSOLUTELY_INTEGRABLE_NEG],
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
        REWRITE_TAC [LIFT_DROP, NORM_1] THEN
        SUBGOAL_THEN (← q r"&0 <= drop((h:real^N->real^1) x)") MP_TAC THENL
         [ASM_MESON_TAC [REAL_LE_TRANS, NORM_POS_LE], REAL_ARITH_TAC],
        X_GEN_TAC (← q r"x:real^N") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        UNDISCH_TAC
         (← q r"!x. x IN s ==> ((\n. (f:num->real^N->real^1) n x) --> g x)
                          sequentially") THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [tendsto] THEN MATCH_MP_TAC MONO_FORALL THEN
        X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [dist, NORM_1, DROP_SUB, LIFT_DROP] THEN
        REAL_ARITH_TAC])
    prove
     r"!f:num->real^M->real^N g h s.
         (!k. f k absolutely_integrable_on s) /\
         h integrable_on s /\
         (!x. x IN s ==> norm(g x) <= drop(h x)) /\
         (!x. x IN s ==> ((\k. f k x) --> g x) sequentially)
         ==> g integrable_on s"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      ONCE_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE,
                        INTEGRABLE_COMPONENTWISE] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC lemma THEN
      EXISTS_TAC (← q r"\i x. lift(((f:num->real^M->real^N) i x)$k)") THEN
      EXISTS_TAC (← q r"h:real^M->real^1") THEN ASM_SIMP_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [COMPONENT_LE_NORM, NORM_LIFT, REAL_LE_TRANS],
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE [LIM_COMPONENTWISE_LIFT]) THEN
        RULE_ASSUM_TAC BETA_RULE THEN ASM_SIMP_TAC []]))

  let DOMINATED_CONVERGENCE_ABSOLUTELY_INTEGRABLE ← prove
   r"!f:num->real^M->real^N g h s.
         (!k. f k absolutely_integrable_on s) /\
         h integrable_on s /\
         (!x. x IN s ==> norm(g x) <= drop(h x)) /\
         (!x. x IN s ==> ((\k. f k x) --> g x) sequentially)
         ==> g absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND THEN
    EXISTS_TAC (← q r"h:real^M->real^1") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC DOMINATED_CONVERGENCE_INTEGRABLE THEN
    EXISTS_TAC (← q r"f:num->real^M->real^N") THEN
    EXISTS_TAC (← q r"h:real^M->real^1") THEN ASM_REWRITE_TAC [])

  let DOMINATED_CONVERGENCE_AE ← prove
   r"!f:num->real^M->real^N g h s t.
        (!k. (f k) integrable_on s) /\ h integrable_on s /\ negligible t /\
        (!k x. x IN s DIFF t ==> norm(f k x) <= drop(h x)) /\
        (!x. x IN s DIFF t ==> ((\k. f k x) --> g x) sequentially)
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N",
                      ← q r"h:real^M->real^1", ← q r"s DIFF t:real^M->bool"]
          DOMINATED_CONVERGENCE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_SPIKE_SET,
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
        TRY ABS_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE_SET]] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      NEGLIGIBLE_SUBSET)) THEN
    SET_TAC [])

  let INTEGRAL_COUNTABLE_UNIONS ← prove
   r"!f:real^M->real^N s.
        (!n. f integrable_on (s n)) /\
        pairwise (\i j. negligible (s i INTER s j)) (:num) /\
        f absolutely_integrable_on (UNIONS {s n | n IN (:num)})
        ==> ((\n. vsum(0..n) (\i. integral (s i) f))
             --> integral (UNIONS {s n | n IN (:num)}) f) sequentially"
   (REPEAT STRIP_TAC THEN MP_TAC (← GEN (← q r"n:num") (← ISPECL
     [← q r"f:real^M->real^N", ← q r"s:num->real^M->bool",
      ← q r"\k:num. integral (s k) (f:real^M->real^N)", ← q r"0..n"]
     HAS_INTEGRAL_UNIONS_IMAGE)) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG, ← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONO_FORALL) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [PAIRWISE_MONO, SUBSET_UNIV], ALL_TAC] THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL, FORALL_AND_THM] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"!p. p /\ q ==> q")) THEN
    EXISTS_TAC
     (← q r"(f:real^M->real^N) integrable_on UNIONS {s n | n IN (:num)}") THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRAL_RESTRICT_UNIV,
                      ← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    MATCH_MP_TAC DOMINATED_CONVERGENCE THEN
    EXISTS_TAC (← q r"\x. if x IN UNIONS {s n | n IN (:num)}
                  then lift(norm((f:real^M->real^N) x))
                  else vec 0") THEN
    ASM_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV] THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    REWRITE_TAC [IN_UNIV] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^M"] THEN
      REWRITE_TAC [UNIONS_GSPEC, UNIONS_IMAGE, IN_ELIM_THM] THEN
      ASM_CASES_TAC (← q r"!n. ~(x IN (s:num->real^M->bool) n)") THEN
      ASM_REWRITE_TAC [NORM_0, DROP_VEC, REAL_LE_REFL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [NOT_FORALL_THM]) THEN
      ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL, NORM_0, NORM_POS_LE],
      X_GEN_TAC (← q r"x:real^M") THEN
      REWRITE_TAC [UNIONS_GSPEC, UNIONS_IMAGE, IN_ELIM_THM] THEN
      ASM_CASES_TAC (← q r"!n. ~(x IN (s:num->real^M->bool) n)") THEN
      ASM_REWRITE_TAC [LIM_CONST] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_FORALL_THM]) THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"N:num") THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN REWRITE_TAC [IN_NUMSEG, LE_0] THEN
      REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [DIST_REFL]) THEN
      ASM SET_TAC []])

  let NEGLIGIBLE_ON_UNIV ← prove
   r"!s. negligible s <=> (indicator s has_integral vec 0) (:real^N)"
   (GEN_TAC THEN EQ_TAC THENL [SIMP_TAC [NEGLIGIBLE], ALL_TAC] THEN
    DISCH_TAC THEN REWRITE_TAC [negligible] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    SUBGOAL_THEN (← q r"indicator s integrable_on interval[a:real^N,b]")
    ASSUME_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"(:real^N)") THEN ASM_MESON_TAC [SUBSET_UNIV, integrable_on],
      ASM_SIMP_TAC [← GSYM INTEGRAL_EQ_HAS_INTEGRAL] THEN
      REWRITE_TAC [← GSYM DROP_EQ, ← GSYM REAL_LE_ANTISYM] THEN
      CONJ_TAC THENL
       [FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP INTEGRAL_UNIQUE) THEN
        MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE,
        REWRITE_TAC [DROP_VEC] THEN MATCH_MP_TAC INTEGRAL_DROP_POS] THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, DROP_INDICATOR_POS_LE] THEN
      ASM_MESON_TAC [integrable_on]])

  let NEGLIGIBLE_COUNTABLE_UNIONS ← prove
   r"!s:num->real^N->bool.
        (!n. negligible(s n)) ==> negligible(UNIONS {s(n) | n IN (:num)})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n. indicator(UNIONS {(s:num->real^N->bool)(m) | m <= n})",
               ← q r"indicator(UNIONS {(s:num->real^N->bool)(m) | m IN (:num)})",
                      ← q r"(:real^N)"] MONOTONE_CONVERGENCE_INCREASING) THEN
    SUBGOAL_THEN
     (← q r"!n. negligible(UNIONS {(s:num->real^N->bool)(m) | m <= n})")
    ASSUME_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LE, FORALL_IN_IMAGE],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n:num. (indicator (UNIONS {s m | m <= n})) integrable_on (:real^N)")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [NEGLIGIBLE_ON_UNIV, integrable_on], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n:num. integral (:real^N) (indicator (UNIONS {s m | m <= n})) = vec 0")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [NEGLIGIBLE_ON_UNIV, INTEGRAL_UNIQUE], ALL_TAC] THEN
    ASM_SIMP_TAC [NEGLIGIBLE_ON_UNIV, LIM_CONST_EQ,
                  TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC [INTEGRAL_EQ_HAS_INTEGRAL]] THEN
    REPEAT CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"k:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
      REWRITE_TAC [indicator] THEN
      SUBGOAL_THEN
       (← q r"x IN UNIONS {(s:num->real^N->bool) m | m <= k}
      ==> x IN UNIONS {s m | m <= SUC k}")
      MP_TAC THENL
       [SPEC_TAC (← q r"x:real^N", ← q r"x:real^N") THEN
        REWRITE_TAC [← GSYM SUBSET] THEN MATCH_MP_TAC SUBSET_UNIONS THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ARITH_TAC,
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        REWRITE_TAC [DROP_VEC, REAL_LE_REFL, REAL_POS]],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_THEN (K ALL_TAC) THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, indicator] THEN
      ASM_CASES_TAC (← q r"x IN UNIONS {(s:num->real^N->bool) m | m IN (:num)}") THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [UNIONS_GSPEC]) THEN
        REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN ASM_MESON_TAC [],
        EXISTS_TAC (← q r"0") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (RAND_CONV o RAND_CONV)
          [UNIONS_GSPEC]) THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN MESON_TAC []],
      REWRITE_TAC [← SET_RULE (← q r"{c | x | x IN UNIV} = {c}"),
                   BOUNDED_INSERT, BOUNDED_EMPTY]])

  let HAS_INTEGRAL_NEGLIGIBLE_EQ ← (do
    let lemma ← prove
     r"!f:real^N->real^1 s.
          (!x. x IN s ==> &0 <= drop(f x)) /\ (f has_integral vec 0) s
          ==> negligible {x | x IN s /\ ~(f x = vec 0)}"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC
       (← q r"UNIONS {{x | x IN s /\ norm((f:real^N->real^1) x) >= &1 / (&n + &1)} |
              n IN (:num)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
        X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [NEGLIGIBLE_ON_UNIV, indicator] THEN
        MATCH_MP_TAC HAS_INTEGRAL_STRADDLE_NULL THEN
        EXISTS_TAC (← q r"(\x. if x IN s then (&n + &1) % f(x) else vec 0):
                  real^N->real^1") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [IN_UNIV, IN_ELIM_THM, real_ge] THEN
          X_GEN_TAC (← q r"x:real^N") THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [DROP_VEC, DROP_CMUL, REAL_POS] THENL
           [ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
            ASM_SIMP_TAC [← GSYM REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
            MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ a <= abs x ==> a <= x")) THEN
            ASM_SIMP_TAC [← GSYM NORM_1],
            COND_CASES_TAC THEN REWRITE_TAC [DROP_VEC, REAL_POS, DROP_CMUL] THEN
            ASM_SIMP_TAC [REAL_POS, REAL_LE_MUL, REAL_LE_ADD]],
          REWRITE_TAC [HAS_INTEGRAL_RESTRICT_UNIV] THEN
          SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^1 = (&n + &1) % vec 0")) THEN
          MATCH_MP_TAC HAS_INTEGRAL_CMUL THEN ASM_REWRITE_TAC []],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
        REWRITE_TAC [← GSYM NORM_POS_LT] THEN ONCE_REWRITE_TAC [REAL_ARCH_INV] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"n:num")
          STRIP_ASSUME_TAC)) THEN
        REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC] THEN
        EXISTS_TAC (← q r"n - 1") THEN ASM_SIMP_TAC [IN_UNIV, IN_ELIM_THM, real_ge] THEN
        ASM_SIMP_TAC [REAL_OF_NUM_ADD, SUB_ADD, LE_1] THEN
        ASM_SIMP_TAC [real_div, REAL_MUL_LID, REAL_LT_IMP_LE]])
    prove
     r"!f:real^M->real^N s.
        (!x i. x IN s /\ 1 <= i /\ i <= dimindex(:N) ==> &0 <= f(x)$i)
        ==> ((f has_integral vec 0) s <=>
             negligible {x | x IN s /\ ~(f x = vec 0)})"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
        EXISTS_TAC (← q r"{x | x IN s /\ ~((f:real^M->real^N) x = vec 0)}") THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN MESON_TAC []] THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
      EXISTS_TAC (← q r"UNIONS {{x | x IN s /\ ~(((f:real^M->real^N) x)$k = &0)} |
                      k IN 1..dimindex(:N)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
        SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
        REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN MATCH_MP_TAC lemma THEN
        ASM_SIMP_TAC [LIFT_DROP] THEN
        FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"\y:real^N. lift(y$k)") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_LINEAR)) THEN
        REWRITE_TAC [o_DEF, VEC_COMPONENT, LIFT_NUM] THEN
        DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [linear] THEN
        SIMP_TAC [LIFT_ADD, VECTOR_ADD_COMPONENT, LIFT_CMUL, VECTOR_MUL_COMPONENT],
        REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_GSPEC, CART_EQ, IN_NUMSEG] THEN
        REWRITE_TAC [VEC_COMPONENT, IN_ELIM_THM] THEN MESON_TAC []]))

  let INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE ← prove
   r"!f:real^M->real^N a b.
        (!x. x IN interval[a,b] ==> (f has_integral vec 0) (interval[a,x]))
        ==> negligible {x | x IN interval[a,b] /\ ~(f x = vec 0)}"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^M,b] = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, NEGLIGIBLE_EMPTY] THEN
    REWRITE_TAC [← GSYM NORM_EQ_0, NORM_0] THEN
    REWRITE_TAC [← GSYM LIFT_EQ, LIFT_NUM] THEN
    W (MP_TAC o PART_MATCH (rand o rand) HAS_INTEGRAL_NEGLIGIBLE_EQ o snd) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, DIMINDEX_1] THEN
    REWRITE_TAC [IMP_IMP, FORALL_1, ← GSYM drop, LIFT_DROP, NORM_POS_LE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) integrable_on interval[a,b]")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [ENDS_IN_INTERVAL, integrable_on], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!u v. u IN interval[a,b] /\ v IN interval[a,b]
          ==> ((f:real^M->real^N) has_integral (vec 0)) (interval[u,v])")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"interval[u:real^M,v] = {}") THEN
      ASM_REWRITE_TAC [HAS_INTEGRAL_EMPTY] THEN
      REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          INTEGRABLE_ON_SUBINTERVAL)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL, INTERVAL_NE_EMPTY]) THEN
        REWRITE_TAC [SUBSET_INTERVAL] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"v:real^M",
                        ← q r"u:real^M"]
          INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_LEFT) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           INTEGRABLE_ON_SUBINTERVAL)) THEN REWRITE_TAC [SUBSET_INTERVAL],
          REWRITE_TAC [IN_INTERVAL]] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL, INTERVAL_NE_EMPTY]) THEN
        ASM_MESON_TAC [REAL_LE_REFL],
        DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC VSUM_EQ_0 THEN
      X_GEN_TAC (← q r"k:num->bool") THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL, INTERVAL_NE_EMPTY]) THEN
      SIMP_TAC [IN_INTERVAL, LAMBDA_BETA] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(f:real^M->real^N) absolutely_integrable_on interval[a,b]")
    ASSUME_TAC THENL
     [ASM_REWRITE_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ] THEN
      MATCH_MP_TAC HAS_BOUNDED_SETVARIATION_ON_EQ THEN
      EXISTS_TAC (← q r"(\x. vec 0):(real^M->bool)->real^N") THEN
      REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_0] THEN
      REWRITE_TAC [INTERVAL_NE_EMPTY, SUBSET_INTERVAL] THEN REPEAT STRIP_TAC THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL, INTERVAL_NE_EMPTY]) THEN
      REWRITE_TAC [IN_INTERVAL] THEN ASM_MESON_TAC [REAL_LE_REFL, REAL_LE_TRANS],
      ALL_TAC] THEN
    ASM_SIMP_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
                  ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o
      MATCH_MP ABSOLUTELY_INTEGRABLE_SET_VARIATION) THEN
    TRANS_TAC EQ_TRANS
     (← q r"set_variation (interval[a:real^M,b]) (\x. (vec 0:real^N))") THEN
    CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [SET_VARIATION_0]] THEN
    MATCH_MP_TAC SET_VARIATION_EQ THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY, SUBSET_INTERVAL] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL, INTERVAL_NE_EMPTY]) THEN
    REWRITE_TAC [IN_INTERVAL] THEN ASM_MESON_TAC [REAL_LE_REFL, REAL_LE_TRANS])

  let NEGLIGIBLE_COUNTABLE ← (do
    let lemma ← prove
     r"IMAGE f s = UNIONS {{f x} | x IN s}"
     (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_UNIONS, IN_SING, IN_ELIM_THM] THEN
      MESON_TAC [IN_SING])
    prove
     r"!s:real^N->bool. COUNTABLE s ==> negligible s"
     (GEN_TAC THEN ASM_CASES_TAC (← q r"s:real^N->bool = {}") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_EMPTY] THEN
      POP_ASSUM MP_TAC THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->real^N") SUBST1_TAC o
        MATCH_MP COUNTABLE_AS_IMAGE) THEN
      ONCE_REWRITE_TAC [lemma] THEN MATCH_MP_TAC NEGLIGIBLE_COUNTABLE_UNIONS THEN
      REWRITE_TAC [NEGLIGIBLE_SING]))

  let HAS_INTEGRAL_COMPONENT_LE_AE ← prove
   r"!f:real^M->real^N g:real^M->real^N s i j k t.
        1 <= k /\ k <= dimindex(:N) /\ negligible t /\
        (f has_integral i) s /\ (g has_integral j) s /\
        (!x. x IN s DIFF t ==> (f x)$k <= (g x)$k)
        ==> i$k <= j$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE THEN
    EXISTS_TAC (← q r"\x. if x IN t then vec 0 else (f:real^M->real^N) x") THEN
    EXISTS_TAC (← q r"\x. if x IN t then vec 0 else (g:real^M->real^N) x") THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN EXISTS_TAC (← q r"f:real^M->real^N") THEN
      EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_SIMP_TAC [IN_DIFF],
      MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN EXISTS_TAC (← q r"g:real^M->real^N") THEN
      EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_SIMP_TAC [IN_DIFF],
      COND_CASES_TAC THEN ASM_SIMP_TAC [IN_DIFF, REAL_LE_REFL]])

  let INTEGRAL_COMPONENT_LE_AE ← prove
   r"!f:real^M->real^N g:real^M->real^N s k t.
        1 <= k /\ k <= dimindex(:N) /\ negligible t /\
        f integrable_on s /\ g integrable_on s /\
        (!x. x IN s DIFF t ==> (f x)$k <= (g x)$k)
        ==> (integral s f)$k <= (integral s g)$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE_AE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_DROP_LE_AE ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s i j t.
        (f has_integral i) s /\ (g has_integral j) s /\
        negligible t /\ (!x. x IN s DIFF t ==> drop(f x) <= drop(g x))
        ==> drop i <= drop j"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE_AE THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN ASM_MESON_TAC [])

  let INTEGRAL_DROP_LE_AE ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s t.
        f integrable_on s /\ g integrable_on s /\
        negligible t /\ (!x. x IN s DIFF t ==> drop(f x) <= drop(g x))
        ==> drop(integral s f) <= drop(integral s g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_DROP_LE_AE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE ← prove
   r"!f:real^M->real^N s t.
        negligible t /\
        (!x i. x IN s DIFF t /\ 1 <= i /\ i <= dimindex(:N)
               ==> &0 <= f(x)$i) /\
        f integrable_on s
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] ABSOLUTELY_INTEGRABLE_SPIKE) THEN
    EXISTS_TAC (← q r"\x. if x IN s DIFF t then (f:real^M->real^N) x else vec 0") THEN
    EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LE_REFL, VEC_COMPONENT], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
    MAP_EVERY EXISTS_TAC [← q r"f:real^M->real^N", ← q r"t:real^M->bool"] THEN
    ASM_SIMP_TAC [])

  let INTEGRAL_NORM_BOUND_INTEGRAL_AE ← prove
   r"!f:real^M->real^N g s t.
        f integrable_on s /\ g integrable_on s /\
        negligible t /\ (!x. x IN s DIFF t ==> norm(f x) <= drop(g x))
        ==> norm(integral s f) <= drop(integral s g)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. if x IN s DIFF t then (f:real^M->real^N) x else vec 0",
      ← q r"\x. if x IN s DIFF t then (g:real^M->real^1) x else vec 0",
      ← q r"s:real^M->bool"]
      INTEGRAL_NORM_BOUND_INTEGRAL) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"f:real^M->real^N"),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"g:real^M->real^1"),
        ASM_MESON_TAC [REAL_LE_REFL, NORM_0, DROP_VEC]] THEN
      EXISTS_TAC (← q r"t:real^M->bool") THEN ASM_SIMP_TAC [],
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN AP_TERM_TAC THEN
      MATCH_MP_TAC INTEGRAL_SPIKE THEN EXISTS_TAC (← q r"t:real^M->bool") THEN
      ASM_SIMP_TAC []])

  pure { DOMINATED_CONVERGENCE_INTEGRABLE, DOMINATED_CONVERGENCE_ABSOLUTELY_INTEGRABLE,
         DOMINATED_CONVERGENCE_AE, INTEGRAL_COUNTABLE_UNIONS, NEGLIGIBLE_ON_UNIV,
         NEGLIGIBLE_COUNTABLE_UNIONS, HAS_INTEGRAL_NEGLIGIBLE_EQ,
         INTEGRAL_ZERO_ON_SUBINTERVALS_IMP_ZERO_AE, NEGLIGIBLE_COUNTABLE,
         HAS_INTEGRAL_COMPONENT_LE_AE, INTEGRAL_COMPONENT_LE_AE, HAS_INTEGRAL_DROP_LE_AE,
         INTEGRAL_DROP_LE_AE, NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE,
         INTEGRAL_NORM_BOUND_INTEGRAL_AE }

/- ------------------------------------------------------------------------- -/
/- Beppo Levi theorem.  (integration.ml 12153-12652)                        -/
/- ------------------------------------------------------------------------- -/

structure INAH where
  BEPPO_LEVI_INCREASING : thm
  BEPPO_LEVI_DECREASING : thm
  BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING : thm
  BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING : thm
  BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING_AE : thm
  BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING_AE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAH [HolBase] (D : IntegrationDeps) (BINE : INE) (BINI : INI) (BINK : INK) (BINN : INN) (BINU : INU) (BINV : INV) (BINAD : INAD) (BINAG : INAG) : ExceptT String IO INAH := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_CMUL, INTEGRABLE_NEG, INTEGRABLE_SUB, INTEGRAL_CMUL,
