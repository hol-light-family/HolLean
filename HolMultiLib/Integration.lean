   (REPEAT STRIP_TAC THEN
    (FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← HolLight.INST_TYPE [(← qty "Q", ← qty "N")] HAS_BOUNDED_VARIATION_COMPARISON))) ORELSE
     FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← HolLight.INST_TYPE [(← qty "Q", ← qty "N")] VECTOR_VARIATION_COMPARISON)))) THEN
    ASM_REWRITE_TAC [← GSYM dist, DIST_LE_PASTECART])

  let HAS_BOUNDED_VARIATION_ON_PASTECART ← prove
   r"!f:real^1->real^N g:real^1->real^P s.
        (\x. pastecart (f x) (g x)) has_bounded_variation_on s <=>
