      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"sum d ((\x. norm(((f:(real^M->bool)->real^N) x))) o
             (\l. l INTER {x | x$k <= c})) +
      sum d ((\x. norm(((f:(real^M->bool)->real^N) x))) o
