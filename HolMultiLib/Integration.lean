  TAGGED_DIVISION_OF_FINITE : thm
  TAGGED_DIVISION_OF : thm
  DIVISION_OF_TAGGED_DIVISION : thm
  PARTIAL_DIVISION_OF_TAGGED_DIVISION : thm
  TAGGED_PARTIAL_DIVISION_SUBSET : thm
  VSUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA : thm
  VSUM_OVER_TAGGED_DIVISION_LEMMA : thm
  SUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA : thm
  SUM_OVER_TAGGED_DIVISION_LEMMA : thm
  TAG_IN_INTERVAL : thm
  TAGGED_DIVISION_OF_EMPTY : thm
  TAGGED_PARTIAL_DIVISION_OF_TRIVIAL : thm
  TAGGED_DIVISION_OF_TRIVIAL : thm
  TAGGED_DIVISION_OF_SELF : thm
  TAGGED_DIVISION_UNION : thm
  TAGGED_DIVISION_UNIONS : thm
  TAGGED_PARTIAL_DIVISION_OF_UNION_SELF : thm
  TAGGED_DIVISION_OF_UNION_SELF : thm
  TAGGED_DIVISION_UNION_IMAGE_SND : thm
  TAGGED_DIVISION_OF_ALT : thm
  TAGGED_DIVISION_OF_ANOTHER : thm
  TAGGED_PARTIAL_DIVISION_OF_SUBSET : thm
  TAGGED_DIVISION_OF_NONTRIVIAL : thm
  fine : thm
  FINE_INTER : thm
  FINE_INTERS : thm
  FINE_UNION : thm
  FINE_UNIONS : thm
  FINE_SUBSET : thm
  has_integral_compact_interval : thm
  has_integral_def : thm
  has_integral : thm
  has_integral_alt : thm
  integrable_on : thm
  integral : thm
  INTEGRABLE_INTEGRAL : thm
  HAS_INTEGRAL_INTEGRABLE : thm
  HAS_INTEGRAL_INTEGRAL : thm
  VSUM_CONTENT_NULL : thm
  TAGGED_DIVISION_UNIONS_EXISTS : thm
  DIVISION_OF_CLOSED : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupINC [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) : ExceptT String IO INC := do
  let { LAMBDA_PAIR_THM, .. } := D.qsession
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_INTERIOR, CONTENT_POS_LE, CONTENT_SUBSET, .. } := BINA
  let { division_of, DIVISION_OF_NONTRIVIAL, .. } := BINB
  let { CONJ_ACI, CONJ_ASSOC, DE_MORGAN_THM, EXISTS_IN_IMAGE, EXISTS_OR_THM,
        EXISTS_PAIR_THM, EXTENSION, FINITE_IMAGE, FINITE_INSERT, FINITE_RULES,
        FINITE_SUBSET, FINITE_UNION, FINITE_UNIONS, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ,
        IN_ELIM_PAIR_THM, INTER_ACI, INTER_COMM, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_FORALL, NOT_EXISTS_THM,
        NOT_IN_EMPTY, PAIR_EQ, .. } := D.dv.dg.pt.cvx.core3
  let { RIGHT_AND_EXISTS_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        SUBSET, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, UNIONS_0, UNWIND_THM2, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, LIFT_DROP, LIFT_EQ, .. } := D.dv.dg.pt.cvx.vec2
  let { VECTOR_MUL_EQ_0, VSUM_EQ_0, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top1
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH, SELECT_CONV,
        SET_RULE, SET_TAC, UNWIND_CONV, .. } := D.dv.dg.pt.cvx
  let { UNIONS_1, .. } := D.dv.dg.pt.qses
  let { CLOSED_UNIONS, .. } := D.dv.dg.pt.qtop
  let { LIFT_SUM, .. } := D.dv.dg.qvec
  let { VSUM_IMAGE_NONZERO, .. } := D.qvec
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  parse_as_infix ("tagged_partial_division_of", (12, "right"))
  parse_as_infix ("tagged_division_of", (12, "right"))

  let tagged_partial_division_of ← new_definition
    r"s tagged_partial_division_of i <=>
        FINITE s /\
        (!x k. (x,k) IN s
               ==> x IN k /\ k SUBSET i /\ ?a b. k = interval[a,b]) /\
        (!x1 k1 x2 k2. (x1,k1) IN s /\ (x2,k2) IN s /\ ~((x1,k1) = (x2,k2))
                       ==> (interior(k1) INTER interior(k2) = {}))"

  let tagged_division_of ← new_definition
    r"s tagged_division_of i <=>
        s tagged_partial_division_of i /\ (UNIONS {k | ?x. (x,k) IN s} = i)"

  let TAGGED_DIVISION_OF_FINITE ← prove
   r"!s i. s tagged_division_of i ==> FINITE s"
   (SIMP_TAC [tagged_division_of, tagged_partial_division_of])

  let TAGGED_DIVISION_OF ← prove
   r"s tagged_division_of i <=>
        FINITE s /\
        (!x k. (x,k) IN s
               ==> x IN k /\ k SUBSET i /\ ?a b. k = interval[a,b]) /\
        (!x1 k1 x2 k2. (x1,k1) IN s /\ (x2,k2) IN s /\ ~((x1,k1) = (x2,k2))
                       ==> (interior(k1) INTER interior(k2) = {})) /\
        (UNIONS {k | ?x. (x,k) IN s} = i)"
   (REWRITE_TAC [tagged_division_of, tagged_partial_division_of, CONJ_ASSOC])

  let DIVISION_OF_TAGGED_DIVISION ← prove
   r"!s i. s tagged_division_of i ==> (IMAGE SND s) division_of i"
   (REWRITE_TAC [TAGGED_DIVISION_OF, division_of] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE, FORALL_PAIR_THM, PAIR_EQ] THEN
    REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY],
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_IMAGE, IN_UNIONS] THEN
      REWRITE_TAC [FORALL_PAIR_THM, EXISTS_PAIR_THM] THEN MESON_TAC []])

  let PARTIAL_DIVISION_OF_TAGGED_DIVISION ← prove
   r"!s i. s tagged_partial_division_of i
         ==> (IMAGE SND s) division_of UNIONS(IMAGE SND s)"
   (REWRITE_TAC [tagged_partial_division_of, division_of] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ, DE_MORGAN_THM] THEN
    GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN REPEAT DISCH_TAC THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [FINITE_IMAGE],
      ALL_TAC,
      ASM_MESON_TAC []] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [MEMBER_NOT_EMPTY]] THEN
    REWRITE_TAC [SUBSET, IN_UNIONS, IN_IMAGE, EXISTS_PAIR_THM] THEN
    CONV_TAC (ONCE_DEPTH_CONV UNWIND_CONV) THEN ASM SET_TAC [])

  let TAGGED_PARTIAL_DIVISION_SUBSET ← prove
   r"!s t i. s tagged_partial_division_of i /\ t SUBSET s
           ==> t tagged_partial_division_of i"
   (REWRITE_TAC [tagged_partial_division_of] THEN
    MESON_TAC [FINITE_SUBSET, SUBSET])

  let VSUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA ← prove
   r"!d:(real^M->bool)->real^N p i.
        p tagged_partial_division_of i /\
        (!u v. ~(interval[u,v] = {}) /\ content(interval[u,v]) = &0
               ==> d(interval[u,v]) = vec 0)
        ==> vsum p (\(x,k). d k) = vsum (IMAGE SND p) d"
   (REWRITE_TAC [CONTENT_EQ_0_INTERIOR] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\(x:real^M,k:real^M->bool). d k:real^N) = d o SND")
    SUBST1_TAC THENL [SIMP_TAC [FUN_EQ_THM, FORALL_PAIR_THM, o_THM], ALL_TAC] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_IMAGE_NONZERO THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [tagged_partial_division_of]) THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:real^M") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k':real^M->bool") THEN
    ASM_CASES_TAC (← q r"k':real^M->bool = k") THEN
    ASM_REWRITE_TAC [PAIR_EQ, INTER_ACI] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    ASM_MESON_TAC [])

  let VSUM_OVER_TAGGED_DIVISION_LEMMA ← prove
   r"!d:(real^M->bool)->real^N p i.
        p tagged_division_of i /\
        (!u v. ~(interval[u,v] = {}) /\ content(interval[u,v]) = &0
               ==> d(interval[u,v]) = vec 0)
        ==> vsum p (\(x,k). d k) = vsum (IMAGE SND p) d"
   (REWRITE_TAC [tagged_division_of] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VSUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA THEN
    EXISTS_TAC (← q r"i:real^M->bool") THEN ASM_REWRITE_TAC [])

  let SUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA ← prove
   r"!d:(real^N->bool)->real p i.
        p tagged_partial_division_of i /\
        (!u v. ~(interval[u,v] = {}) /\ content(interval[u,v]) = &0
               ==> d(interval[u,v]) = &0)
        ==> sum p (\(x,k). d k) = sum (IMAGE SND p) d"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o
      REWRITE_RULE [tagged_partial_division_of]) THEN
    ONCE_REWRITE_TAC [← GSYM LIFT_EQ] THEN
    ASM_SIMP_TAC [LIFT_SUM, FINITE_IMAGE, o_DEF, LAMBDA_PAIR_THM] THEN
    MATCH_MP_TAC VSUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA THEN
    ASM_SIMP_TAC [← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN ASM_MESON_TAC [])

  let SUM_OVER_TAGGED_DIVISION_LEMMA ← prove
   r"!d:(real^N->bool)->real p i.
        p tagged_division_of i /\
        (!u v. ~(interval[u,v] = {}) /\ content(interval[u,v]) = &0
               ==> d(interval[u,v]) = &0)
        ==> sum p (\(x,k). d k) = sum (IMAGE SND p) d"
   (REWRITE_TAC [tagged_division_of] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA THEN
    EXISTS_TAC (← q r"i:real^N->bool") THEN ASM_REWRITE_TAC [])

  let TAG_IN_INTERVAL ← prove
   r"!p i k. p tagged_division_of i /\ (x,k) IN p ==> x IN i"
   (REWRITE_TAC [TAGGED_DIVISION_OF] THEN SET_TAC [])

  let TAGGED_DIVISION_OF_EMPTY ← prove
   r"{} tagged_division_of {}"
   (REWRITE_TAC [tagged_division_of, tagged_partial_division_of] THEN
    REWRITE_TAC [FINITE_RULES, EXTENSION, NOT_IN_EMPTY, IN_UNIONS, IN_ELIM_THM])

  let TAGGED_PARTIAL_DIVISION_OF_TRIVIAL ← prove
   r"!p. p tagged_partial_division_of {} <=> p = {}"
   (REWRITE_TAC [tagged_partial_division_of, SUBSET_EMPTY, CONJ_ASSOC] THEN
    REWRITE_TAC [← SET_RULE (← q r"x IN k /\ k = {} <=> F")] THEN
    REWRITE_TAC [← GSYM FORALL_PAIR_THM, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [← AC CONJ_ACI (← q r"(a /\ b) /\ c <=> b /\ a /\ c")] THEN
    GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(a ==> b) ==> (a /\ b <=> a)")) THEN
    DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [FINITE_RULES, UNIONS_0, NOT_IN_EMPTY])

  let TAGGED_DIVISION_OF_TRIVIAL ← prove
   r"!p. p tagged_division_of {} <=> p = {}"
   (REWRITE_TAC [tagged_division_of, TAGGED_PARTIAL_DIVISION_OF_TRIVIAL] THEN
    GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(a ==> b) ==> (a /\ b <=> a)")) THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [NOT_IN_EMPTY] THEN SET_TAC [])

  let TAGGED_DIVISION_OF_SELF ← prove
   r"!x a b. x IN interval[a,b]
           ==> {(x,interval[a,b])} tagged_division_of interval[a,b]"
   (REWRITE_TAC [TAGGED_DIVISION_OF, FINITE_INSERT, FINITE_RULES, IN_SING] THEN
    REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [SUBSET_REFL, UNWIND_THM2, ← SET_RULE (← q r"{k | k = a} = {a}")] THEN
    REWRITE_TAC [UNIONS_1] THEN ASM_MESON_TAC [])

  let TAGGED_DIVISION_UNION ← prove
   r"!s1 s2:real^N->bool p1 p2.
        p1 tagged_division_of s1 /\
        p2 tagged_division_of s2 /\
        interior s1 INTER interior s2 = {}
        ==> (p1 UNION p2) tagged_division_of (s1 UNION s2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TAGGED_DIVISION_OF] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [FINITE_UNION, IN_UNION, EXISTS_OR_THM, ← SET_RULE
     (← q r"UNIONS {x | P x \/ Q x} = UNIONS {x | P x} UNION UNIONS {x | Q x}")] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC,
      ONCE_REWRITE_TAC [INTER_COMM], ASM_MESON_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"!s' t'. s SUBSET s' /\ t SUBSET t' /\ s' INTER t' = {}
              ==> s INTER t = {}")) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"interior s1:real^N->bool", ← q r"interior s2:real^N->bool"] THEN
    ASM_SIMP_TAC [] THEN CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN
    ASM_MESON_TAC [])

  let TAGGED_DIVISION_UNIONS ← (do
    let lemma1 ← prove
      r"(?t. (?x. (t = f x) /\ P x) /\ Q t) <=> ?x. P x /\ Q(f x)"
      (MESON_TAC [])
    let lemma2 ← prove
     r"!s1 t1 s2 t2. s1 SUBSET t1 /\ s2 SUBSET t2 /\ (t1 INTER t2 = {})
                   ==> (s1 INTER s2 = {})"
     (SET_TAC [])
    prove
     r"!iset pfn. FINITE iset /\
              (!i:real^M->bool. i IN iset ==> pfn(i) tagged_division_of i) /\
              (!i1 i2. i1 IN iset /\ i2 IN iset /\ ~(i1 = i2)
                       ==> (interior(i1) INTER interior(i2) = {}))
              ==> UNIONS(IMAGE pfn iset) tagged_division_of (UNIONS iset)"
     (REPEAT GEN_TAC THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [EXTENSION] tagged_division_of] THEN
      REWRITE_TAC [tagged_partial_division_of, IN_UNIONS, IN_ELIM_THM] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIONS, IN_IMAGE] THEN
      SIMP_TAC [FINITE_UNIONS, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC, ASM_MESON_TAC []] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [lemma1] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"i1:real^M->bool", ← q r"i2:real^M->bool"] THEN
      ASM_CASES_TAC (← q r"i1 = i2:real^M->bool") THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma2 THEN
      MAP_EVERY EXISTS_TAC
       [← q r"interior(i1:real^M->bool)", ← q r"interior(i2:real^M->bool)"] THEN
      ASM_MESON_TAC [SUBSET, SUBSET_INTERIOR]))

  let TAGGED_PARTIAL_DIVISION_OF_UNION_SELF ← prove
   r"!p s. p tagged_partial_division_of s
         ==> p tagged_division_of (UNIONS(IMAGE SND p))"
   (SIMP_TAC [tagged_partial_division_of, TAGGED_DIVISION_OF] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT CONJ_TAC THENL
     [REPEAT STRIP_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [SUBSET, IN_UNIONS, IN_IMAGE, EXISTS_PAIR_THM] THEN
      ASM_MESON_TAC [],
      ASM_MESON_TAC [],
      AP_TERM_TAC THEN GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC []])

  let TAGGED_DIVISION_OF_UNION_SELF ← prove
   r"!p s. p tagged_division_of s
         ==> p tagged_division_of (UNIONS(IMAGE SND p))"
   (SIMP_TAC [TAGGED_DIVISION_OF] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(c ==> a /\ b) /\ c ==> a /\ b /\ c")) THEN CONJ_TAC THENL
     [DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_SIMP_TAC [] THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC []])

  let TAGGED_DIVISION_UNION_IMAGE_SND ← prove
   r"!p s. p tagged_division_of s ==> s = UNIONS(IMAGE SND p)"
   (MESON_TAC [TAGGED_PARTIAL_DIVISION_OF_UNION_SELF, tagged_division_of])

  let TAGGED_DIVISION_OF_ALT ← prove
   r"!p s. p tagged_division_of s <=>
         p tagged_partial_division_of s /\
         (!x. x IN s ==> ?t k. (t,k) IN p /\ x IN k)"
   (REWRITE_TAC [tagged_division_of, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_UNIONS, IN_ELIM_THM] THEN
    REWRITE_TAC [IN_UNIONS, EXISTS_PAIR_THM, IN_ELIM_THM] THEN
    REWRITE_TAC [tagged_partial_division_of, SUBSET] THEN MESON_TAC [])

  let TAGGED_DIVISION_OF_ANOTHER ← prove
   r"!p s s'.
        p tagged_partial_division_of s' /\
        (!t k. (t,k) IN p ==> k SUBSET s) /\
        (!x. x IN s ==> ?t k. (t,k) IN p /\ x IN k)
        ==> p tagged_division_of s"
   (REWRITE_TAC [TAGGED_DIVISION_OF_ALT, tagged_partial_division_of] THEN
    SET_TAC [])

  let TAGGED_PARTIAL_DIVISION_OF_SUBSET ← prove
   r"!p s t. p tagged_partial_division_of s /\ s SUBSET t
           ==> p tagged_partial_division_of t"
   (REWRITE_TAC [tagged_partial_division_of] THEN SET_TAC [])

  let TAGGED_DIVISION_OF_NONTRIVIAL ← prove
   r"!s a b:real^N.
        s tagged_division_of interval[a,b] /\ ~(content(interval[a,b]) = &0)
        ==> {(x,k) | (x,k) IN s /\ ~(content k = &0)}
            tagged_division_of interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TAGGED_DIVISION_OF_ALT] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC TAGGED_PARTIAL_DIVISION_SUBSET THEN
      EXISTS_TAC (← q r"s:(real^N#(real^N->bool))->bool") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [tagged_division_of]) THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      FIRST_ASSUM (MP_TAC o MATCH_MP DIVISION_OF_TAGGED_DIVISION) THEN
      DISCH_THEN (MP_TAC o
       MATCH_MP (← REWRITE_RULE [IMP_CONJ] DIVISION_OF_NONTRIVIAL)) THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [division_of] THEN DISCH_THEN (MP_TAC o lastc) THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET, IN_ELIM_PAIR_THM] THEN
      REWRITE_TAC [IN_UNIONS, EXISTS_IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_THM,
                   ← GSYM CONJ_ASSOC] THEN
      MESON_TAC []])

  parse_as_infix ("fine", (12, "right"))

  let fine ← new_definition
    r"d fine s <=> !x k. (x,k) IN s ==> k SUBSET d(x)"

  let FINE_INTER ← (do
    let lemma ← prove
     r"s SUBSET (t INTER u) <=> s SUBSET t /\ s SUBSET u" (SET_TAC [])
    prove
     r"!p d1 d2. (\x. d1(x) INTER d2(x)) fine p <=> d1 fine p /\ d2 fine p"
     (REWRITE_TAC [fine, IN_INTER, lemma] THEN MESON_TAC []))

  let FINE_INTERS ← prove
   r"!f s p. (\x. INTERS {f d x | d IN s}) fine p <=>
           !d. d IN s ==> (f d) fine p"
   (REWRITE_TAC [fine, ← SET_RULE (← q r"s SUBSET INTERS u <=> !t. t IN u ==> s SUBSET t"),
                 IN_ELIM_THM] THEN MESON_TAC [])

  let FINE_UNION ← prove
   r"!d p1 p2. d fine p1 /\ d fine p2 ==> d fine (p1 UNION p2)"
   (REWRITE_TAC [fine, IN_UNION] THEN MESON_TAC [])

  let FINE_UNIONS ← prove
   r"!d ps. (!p. p IN ps ==> d fine p) ==> d fine (UNIONS ps)"
   (REWRITE_TAC [fine, IN_UNIONS] THEN MESON_TAC [])

  let FINE_SUBSET ← prove
   r"!d p q. p SUBSET q /\ d fine q ==> d fine p"
   (REWRITE_TAC [fine, SUBSET] THEN MESON_TAC [])

  parse_as_infix ("has_integral_compact_interval", (12, "right"))
  parse_as_infix ("has_integral", (12, "right"))
  parse_as_infix ("integrable_on", (12, "right"))

  let has_integral_compact_interval ← new_definition
    r"(f has_integral_compact_interval y) i <=>
        !e. &0 < e
            ==> ?d. gauge d /\
                    !p. p tagged_division_of i /\ d fine p
                        ==> norm(vsum p (\(x,k). content(k) % f(x)) - y) < e"

  let has_integral_def ← new_definition
    r"(f has_integral y) i <=>
        if ?a b. i = interval[a,b] then (f has_integral_compact_interval y) i
        else !e. &0 < e
                 ==> ?B. &0 < B /\
                         !a b. ball(vec 0,B) SUBSET interval[a,b]
                               ==> ?z. ((\x. if x IN i then f(x) else vec 0)
                                        has_integral_compact_interval z)
                                        (interval[a,b]) /\
                                       norm(z - y) < e"

  let has_integral ← prove
   r"(f has_integral y) (interval[a,b]) <=>
        !e. &0 < e
            ==> ?d. gauge d /\
                    !p. p tagged_division_of interval[a,b] /\ d fine p
                        ==> norm(vsum p (\(x,k). content(k) % f(x)) - y) < e"
   (REWRITE_TAC [has_integral_def, has_integral_compact_interval] THEN
    MESON_TAC [])

  let has_integral_alt ← prove
   r"(f has_integral y) i <=>
        if ?a b. i = interval[a,b] then (f has_integral y) i
        else !e. &0 < e
                 ==> ?B. &0 < B /\
                         !a b. ball(vec 0,B) SUBSET interval[a,b]
                               ==> ?z. ((\x. if x IN i then f(x) else vec 0)
                                        has_integral z) (interval[a,b]) /\
                                       norm(z - y) < e"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [has_integral_def] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [POP_ASSUM (REPEAT_TCL CHOOSE_THEN SUBST1_TAC), ALL_TAC] THEN
    REWRITE_TAC [has_integral_compact_interval, has_integral])

  let integrable_on ← new_definition
   r"f integrable_on i <=> ?y. (f has_integral y) i"

  let integral ← new_definition
   r"integral i f = @y. (f has_integral y) i"

  let INTEGRABLE_INTEGRAL ← prove
   r"!f i. f integrable_on i ==> (f has_integral (integral i f)) i"
   (REPEAT GEN_TAC THEN REWRITE_TAC [integrable_on, integral] THEN
    CONV_TAC (RAND_CONV SELECT_CONV) THEN REWRITE_TAC [])

  let HAS_INTEGRAL_INTEGRABLE ← prove
   r"!f i s. (f has_integral i) s ==> f integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [])

  let HAS_INTEGRAL_INTEGRAL ← prove
   r"!f s. f integrable_on s <=> (f has_integral (integral s f)) s"
   (MESON_TAC [INTEGRABLE_INTEGRAL, HAS_INTEGRAL_INTEGRABLE])

  let VSUM_CONTENT_NULL ← prove
   r"!f:real^M->real^N a b p.
        content(interval[a,b]) = &0 /\
        p tagged_division_of interval[a,b]
        ==> vsum p (\(x,k). content k % f x) = vec 0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC VSUM_EQ_0 THEN
    REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"p:real^M", ← q r"k:real^M->bool"] THEN
    DISCH_TAC THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ1_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
    DISCH_THEN (MP_TAC o CONJUNCT1 o CONJUNCT2) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"p:real^M", ← q r"k:real^M->bool"]) THEN
    ASM_MESON_TAC [CONTENT_SUBSET, CONTENT_POS_LE, ← REAL_ARITH
     (← q r"&0 <= x /\ x <= y /\ y = &0 ==> x = &0")])

  let TAGGED_DIVISION_UNIONS_EXISTS ← prove
   r"!d iset i:real^M->bool.
        FINITE iset /\
        (!i. i IN iset ==> ?p. p tagged_division_of i /\ d fine p) /\
        (!i1 i2. i1 IN iset /\ i2 IN iset /\ ~(i1 = i2)
                 ==> (interior(i1) INTER interior(i2) = {})) /\
        (UNIONS iset = i)
        ==> ?p. p tagged_division_of i /\ d fine p"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE(p:(real^M->bool)->((real^M#(real^M->bool))->bool))
                      iset)") THEN
    ASM_SIMP_TAC [TAGGED_DIVISION_UNIONS] THEN
    ASM_MESON_TAC [FINE_UNIONS, IN_IMAGE])

  let DIVISION_OF_CLOSED ← prove
   r"!s i. s division_of i ==> closed i"
   (REWRITE_TAC [division_of] THEN MESON_TAC [CLOSED_UNIONS, CLOSED_INTERVAL])

  pure { tagged_partial_division_of, tagged_division_of, TAGGED_DIVISION_OF_FINITE,
         TAGGED_DIVISION_OF, DIVISION_OF_TAGGED_DIVISION,
         PARTIAL_DIVISION_OF_TAGGED_DIVISION, TAGGED_PARTIAL_DIVISION_SUBSET,
         VSUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA, VSUM_OVER_TAGGED_DIVISION_LEMMA,
         SUM_OVER_TAGGED_PARTIAL_DIVISION_LEMMA, SUM_OVER_TAGGED_DIVISION_LEMMA,
         TAG_IN_INTERVAL, TAGGED_DIVISION_OF_EMPTY, TAGGED_PARTIAL_DIVISION_OF_TRIVIAL,
         TAGGED_DIVISION_OF_TRIVIAL, TAGGED_DIVISION_OF_SELF, TAGGED_DIVISION_UNION,
         TAGGED_DIVISION_UNIONS, TAGGED_PARTIAL_DIVISION_OF_UNION_SELF,
         TAGGED_DIVISION_OF_UNION_SELF, TAGGED_DIVISION_UNION_IMAGE_SND,
         TAGGED_DIVISION_OF_ALT, TAGGED_DIVISION_OF_ANOTHER,
         TAGGED_PARTIAL_DIVISION_OF_SUBSET, TAGGED_DIVISION_OF_NONTRIVIAL, fine,
         FINE_INTER, FINE_INTERS, FINE_UNION, FINE_UNIONS, FINE_SUBSET,
         has_integral_compact_interval, has_integral_def, has_integral, has_integral_alt,
         integrable_on, integral, INTEGRABLE_INTEGRAL, HAS_INTEGRAL_INTEGRABLE,
         HAS_INTEGRAL_INTEGRAL, VSUM_CONTENT_NULL, TAGGED_DIVISION_UNIONS_EXISTS,
         DIVISION_OF_CLOSED }

/- ------------------------------------------------------------------------- -/
/- General bisection principle for intervals; Cousin's lemma.               -/
/- (integration.ml 1799-2079)                                                -/
/- ------------------------------------------------------------------------- -/

structure IND where
  INTERVAL_BISECTION_STEP : thm
  INTERVAL_BISECTION : thm
  FINE_DIVISION_EXISTS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupIND [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) : ExceptT String IO IND := do
  -- @@SCOPE BEGIN
  let { INTER_INTERIOR_UNIONS_INTERVALS, .. } := BINA
  let { gauge, .. } := BINB
  let { fine, FINE_UNION, TAGGED_DIVISION_OF_EMPTY, TAGGED_DIVISION_OF_SELF,
        TAGGED_DIVISION_UNION, .. } := BINC
  let { AND_FORALL_THM, ARITH, CART_EQ, CONJ_ASSOC, CONTRAPOS_THM, EQ_IMP, EXISTS_OR_THM,
        EXISTS_REFL, EXTENSION, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG,
        FINITE_POWERSET, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_INSERT, FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_NUMSEG, IN_SING, IN_UNIONS,
        LAMBDA_BETA, LEFT_AND_EXISTS_THM, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, PAIR_EQ, REAL_DIV_1, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_LDIV_EQ, REAL_INV_MUL, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_LDIV_EQ, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_SYM, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_POW_LT,
        RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { real_div, real_pow, SUM_LE_NUMSEG, SUM_LMUL, SWAP_EXISTS_THM, SWAP_FORALL_THM,
        UNIONS_0, UNIONS_INSERT, UNWIND_THM2, .. } := D.dv.dg.pt.cvx.core6
  let { LAMBDA_SKOLEM, .. } := D.dv.dg.pt.cvx.misc
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_SUB_COMPONENT, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top1
  let { IN_BALL, INTERIOR_CLOSED_INTERVAL, OPEN_CONTAINS_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { num_RECURSION, .. } := D.dv.dg.pt.qses
  let { prove_recursive_functions_exist, .. } := D.dv.dg.pt
  let { ADD_CLAUSES, LE_0, TRANSITIVE_STEPWISE_LE, .. } := D.dv.dg.qsession
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { CONS_11, LE_EXISTS, REAL_ARCH_POW2, REAL_EQ_RDIV_EQ, .. } := D.qsession
  let { DECREASING_CLOSED_NEST, .. } := D.qtopology
  let { INTERVAL_EQ_EMPTY, .. } := D.qvec
  -- @@SCOPE END

  let INTERVAL_BISECTION_STEP ← prove
   r"!P. P {} /\
       (!s t. P s /\ P t /\ interior(s) INTER interior(t) = {}
              ==> P(s UNION t))
       ==> !a b:real^N.
                ~(P(interval[a,b]))
                ==> ?c d. ~(P(interval[c,d])) /\
                          !i. 1 <= i /\ i <= dimindex(:N)
                              ==> a$i <= c$i /\ c$i <= d$i /\ d$i <= b$i /\
                                  &2 * (d$i - c$i) <= b$i - a$i"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"!i. 1 <= i /\ i <= dimindex(:N)
                     ==> (a:real^N)$i <= (b:real^N)$i") THENL
     [ALL_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM INTERVAL_NE_EMPTY]) THEN
      ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN
     (← q r"!f. FINITE f /\
        (!s:real^N->bool. s IN f ==> P s) /\
        (!s:real^N->bool. s IN f ==> ?a b. s = interval[a,b]) /\
        (!s t. s IN f /\ t IN f /\ ~(s = t)
               ==> interior(s) INTER interior(t) = {})
        ==> P(UNIONS f)")
    ASSUME_TAC THENL
     [ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
      ASM_SIMP_TAC [UNIONS_0, UNIONS_INSERT, NOT_IN_EMPTY, FORALL_IN_INSERT] THEN
      REWRITE_TAC [IMP_IMP] THEN REPEAT GEN_TAC THEN DISCH_THEN (fun th =>
        FIRST_X_ASSUM MATCH_MP_TAC THEN STRIP_ASSUME_TAC th) THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC INTER_INTERIOR_UNIONS_INTERVALS THEN
      ASM_REWRITE_TAC [OPEN_INTERIOR] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INSERT] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{ interval[c,d] |
      !i. 1 <= i /\ i <= dimindex(:N)
          ==> ((c:real^N)$i = (a:real^N)$i) /\ (d$i = (a$i + b$i) / &2) \/
              (c$i = (a$i + b$i) / &2) /\ ((d:real^N)$i = (b:real^N)$i)}")) THEN
    ONCE_REWRITE_TAC [IMP_CONJ] THEN ANTS_TAC THENL
     [MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
       (← q r"IMAGE (\s. closed_interval
       [(lambda i. if i IN s then (a:real^N)$i else (a$i + b$i) / &2):real^N,
        (lambda i. if i IN s then (a$i + b$i) / &2 else (b:real^N)$i)])
         {s | s SUBSET (1..dimindex(:N))}") THEN
      CONJ_TAC THENL
       [SIMP_TAC [FINITE_POWERSET, FINITE_IMAGE, FINITE_NUMSEG], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
      X_GEN_TAC (← q r"k:real^N->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:real^N") (X_CHOOSE_THEN (← q r"d:real^N")
        (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC))) THEN
      EXISTS_TAC (← q r"{i | 1 <= i /\ i <= dimindex(:N) /\
                     ((c:real^N)$i = (a:real^N)$i)}") THEN
      CONJ_TAC THENL [ALL_TAC, SIMP_TAC [IN_ELIM_THM, IN_NUMSEG]] THEN
      AP_TERM_TAC THEN REWRITE_TAC [CONS_11, PAIR_EQ] THEN
      SIMP_TAC [CART_EQ, LAMBDA_BETA, IN_ELIM_THM] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN (← q r"i:num") o SPEC (← q r"i:num"))) THEN
      REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> (a ==> b /\ c)")] THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [REAL_EQ_RDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN ANTS_TAC THENL
     [UNDISCH_TAC (← q r"~P(interval[a:real^N,b])") THEN MATCH_MP_TAC EQ_IMP THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^N") THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c <=> b /\ a /\ c")] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [UNWIND_THM2, IN_INTERVAL] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN
      REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> (a ==> b /\ c)")] THEN
      REWRITE_TAC [← GSYM LAMBDA_SKOLEM] THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"i:num") THEN
      REWRITE_TAC [] THEN
      MATCH_MP_TAC (← TAUT (← q r"(a ==> (b <=> c)) ==> ((a ==> b) <=> (a ==> c))")) THEN
      STRIP_TAC THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"(a \/ b) /\ c <=> ~(a ==> ~c) \/ ~(b ==> ~c)")] THEN
      SIMP_TAC [] THEN
      REWRITE_TAC [← TAUT (← q r"~(a ==> ~b) <=> a /\ b"), ← GSYM CONJ_ASSOC] THEN
      REWRITE_TAC [EXISTS_OR_THM, RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [LEFT_EXISTS_AND_THM, EXISTS_REFL] THEN
      SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MATCH_MP_TAC (← TAUT (← q r"b /\ (~a ==> e) /\ c ==> ~(a /\ b /\ c) ==> e")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
      DISCH_THEN (fun th => REPEAT DISCH_TAC THEN MP_TAC th) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_IMP, INTERIOR_CLOSED_INTERVAL] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"c1:real^N", ← q r"d1:real^N", ← q r"c2:real^N", ← q r"d2:real^N"] THEN
    ASM_CASES_TAC (← q r"(c1 = c2:real^N) /\ (d1 = d2:real^N)") THENL
     [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (fun th =>
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (K ALL_TAC)) THEN MP_TAC th) THEN
    REWRITE_TAC [IMP_IMP] THEN
    UNDISCH_TAC (← q r"~((c1 = c2:real^N) /\ (d1 = d2:real^N))") THEN
    REWRITE_TAC [CART_EQ, INTERIOR_CLOSED_INTERVAL] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> (a ==> b /\ c)")] THEN
    REWRITE_TAC [NOT_FORALL_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"j:num") (fun th => tactic_of do
      pure (DISCH_THEN (MP_TAC o SPEC (← q r"j:num")) THEN MP_TAC th))) THEN
    REWRITE_TAC [NOT_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [EXTENSION, IN_INTERVAL, NOT_IN_EMPTY, IN_INTER] THEN
    SIMP_TAC [REAL_EQ_RDIV_EQ, REAL_EQ_LDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
    REWRITE_TAC [
      ← REAL_ARITH (← q r"~((a * &2 = a + b) /\ (a + b = b * &2)) <=> ~(a = b)"),
      ← REAL_ARITH (← q r"~((a + b = a * &2) /\ (b * &2 = a + b)) <=> ~(a = b)")] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (X_GEN_TAC (← q r"x:real^N") THEN MP_TAC th)) THEN
    REWRITE_TAC [AND_FORALL_THM] THEN
    REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> (a ==> b /\ c)")] THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
    REAL_ARITH_TAC)

  let INTERVAL_BISECTION ← prove
   r"!P. P {} /\
       (!s t. P s /\ P t /\ interior(s) INTER interior(t) = {}
              ==> P(s UNION t))
       ==> !a b:real^N.
                ~(P(interval[a,b]))
                ==> ?x. x IN interval[a,b] /\
                        !e. &0 < e
                            ==> ?c d. x IN interval[c,d] /\
                                      interval[c,d] SUBSET ball(x,e) /\
                                      interval[c,d] SUBSET interval[a,b] /\
                                      ~P(interval[c,d])"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?A B. (A(0) = a:real^N) /\ (B(0) = b) /\
          !n. ~(P(interval[A(SUC n),B(SUC n)])) /\
              !i. 1 <= i /\ i <= dimindex(:N)
                       ==> A(n)$i <= A(SUC n)$i /\
                           A(SUC n)$i <= B(SUC n)$i /\
                           B(SUC n)$i <= B(n)$i /\
                           &2 * (B(SUC n)$i - A(SUC n)$i) <= B(n)$i - A(n)$i")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"P:(real^N->bool)->bool") INTERVAL_BISECTION_STEP) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:real^N->real^N->real^N")
       (X_CHOOSE_THEN (← q r"D:real^N->real^N->real^N") ASSUME_TAC)) THEN
      MP_TAC (← prove_recursive_functions_exist num_RECURSION
       (← q r"(E 0 = a:real^N,b:real^N) /\
        (!n. E(SUC n) = C (FST(E n)) (SND(E n)),
                        D (FST(E n)) (SND(E n)))")) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"E:num->real^N#real^N") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\n. FST((E:num->real^N#real^N) n)") THEN
      EXISTS_TAC (← q r"\n. SND((E:num->real^N#real^N) n)") THEN
      ASM_REWRITE_TAC [] THEN INDUCT_TAC THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!e. &0 < e
        ==> ?n:num. !x y. x IN interval[A(n),B(n)] /\ y IN interval[A(n),B(n)]
                          ==> dist(x,y:real^N) < e")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN MP_TAC (← SPEC
       (← q r"sum(1..dimindex(:N)) (\i. (b:real^N)$i - (a:real^N)$i) / e")
       REAL_ARCH_POW2) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"y:real^N"] THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"sum(1..dimindex(:N))(\i. abs((x - y:real^N)$i))") THEN
      REWRITE_TAC [dist, NORM_LE_L1] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"sum(1..dimindex(:N))
                   (\i. (B:num->real^N)(n)$i - (A:num->real^N)(n)$i)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE_NUMSEG THEN SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
        REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= x /\ x <= b /\ a <= y /\ y <= b
                               ==> abs(x - y) <= b - a")) THEN
        UNDISCH_TAC (← q r"x IN interval[(A:num->real^N) n,B n]") THEN
        UNDISCH_TAC (← q r"y IN interval[(A:num->real^N) n,B n]") THEN
        REWRITE_TAC [IN_INTERVAL] THEN ASM_SIMP_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
       (← q r"sum(1..dimindex(:N)) (\i. (b:real^N)$i - (a:real^N)$i) /
      &2 pow n") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        SIMP_TAC [REAL_LT_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ]] THEN
      REWRITE_TAC [real_div] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [← GSYM SUM_LMUL] THEN MATCH_MP_TAC SUM_LE_NUMSEG THEN
      X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
      SPEC_TAC (← q r"n:num", ← q r"m:num") THEN INDUCT_TAC THEN
      ASM_REWRITE_TAC [real_pow, REAL_DIV_1, REAL_LE_REFL] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [real_div, REAL_INV_MUL, REAL_MUL_ASSOC] THEN
      SIMP_TAC [← GSYM real_div, REAL_LE_RDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN
      ASM_MESON_TAC [REAL_LE_TRANS, REAL_MUL_SYM],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?a:real^N. !n:num. a IN interval[A(n),B(n)]") MP_TAC THENL
     [MATCH_MP_TAC DECREASING_CLOSED_NEST THEN
      ASM_REWRITE_TAC [CLOSED_INTERVAL] THEN CONJ_TAC THENL
       [REWRITE_TAC [INTERVAL_EQ_EMPTY] THEN
        ASM_MESON_TAC [REAL_NOT_LT, REAL_LE_TRANS],
        ALL_TAC] THEN
      REWRITE_TAC [LE_EXISTS] THEN SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"m:num") THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      REWRITE_TAC [← GSYM LEFT_IMP_EXISTS_THM, EXISTS_REFL] THEN
      INDUCT_TAC THEN REWRITE_TAC [ADD_CLAUSES, SUBSET_REFL] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"interval[A(m + d:num):real^N,B(m + d)]") THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_INTERVAL] THEN ASM_MESON_TAC [REAL_LE_TRANS],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x0:real^N") THEN
    DISCH_TAC THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
    MAP_EVERY EXISTS_TAC [← q r"(A:num->real^N) n", ← q r"(B:num->real^N) n"] THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_BALL] THEN ASM_MESON_TAC [],
      ALL_TAC,
      SPEC_TAC (← q r"n:num", ← q r"p:num") THEN INDUCT_TAC THEN ASM_REWRITE_TAC []] THEN
    SUBGOAL_THEN
     (← q r"!m n. m <= n ==> interval[(A:num->real^N) n,B n] SUBSET interval[A m,B m]")
     (fun th => ASM_MESON_TAC [SUBSET, LE_0, th]) THEN
    MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
    REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [SUBSET_INTERVAL] THEN ASM_MESON_TAC [])

  let FINE_DIVISION_EXISTS ← prove
   r"!g a b:real^M.
        gauge g ==> ?p. p tagged_division_of (interval[a,b]) /\ g fine p"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"\s:real^M->bool. ?p. p tagged_division_of s /\ g fine p")
          INTERVAL_BISECTION) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [MESON_TAC [TAGGED_DIVISION_UNION, FINE_UNION,
                 TAGGED_DIVISION_OF_EMPTY, fine, NOT_IN_EMPTY],
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"])] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^M") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^M") o REWRITE_RULE [gauge]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [OPEN_CONTAINS_BALL, NOT_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^M", ← q r"d:real^M"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{(x:real^M,interval[c:real^M,d])}")) THEN
    ASM_SIMP_TAC [TAGGED_DIVISION_OF_SELF] THEN
    REWRITE_TAC [fine, IN_SING, PAIR_EQ] THEN ASM_MESON_TAC [SUBSET_TRANS])

  pure { INTERVAL_BISECTION_STEP, INTERVAL_BISECTION, FINE_DIVISION_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Basic theorems about integrals.  (integration.ml 2080-2514)              -/
/- ------------------------------------------------------------------------- -/

structure INE where
  HAS_INTEGRAL_UNIQUE : thm
  INTEGRAL_UNIQUE : thm
  HAS_INTEGRAL_INTEGRABLE_INTEGRAL : thm
  INTEGRAL_EQ_HAS_INTEGRAL : thm
  HAS_INTEGRAL_IS_0 : thm
  HAS_INTEGRAL_0 : thm
  HAS_INTEGRAL_0_EQ : thm
  HAS_INTEGRAL_LINEAR : thm
  HAS_INTEGRAL_CMUL : thm
  HAS_INTEGRAL_NEG : thm
  HAS_INTEGRAL_ADD : thm
  HAS_INTEGRAL_SUB : thm
  INTEGRAL_0 : thm
  INTEGRAL_ADD : thm
  INTEGRAL_CMUL : thm
  INTEGRAL_NEG : thm
  INTEGRAL_SUB : thm
  INTEGRABLE_0 : thm
  INTEGRABLE_ADD : thm
  INTEGRABLE_CMUL : thm
  INTEGRABLE_CMUL_EQ : thm
  INTEGRABLE_NEG : thm
  INTEGRABLE_NEG_EQ : thm
  INTEGRABLE_SUB : thm
  INTEGRABLE_LINEAR : thm
  INTEGRAL_LINEAR : thm
  HAS_INTEGRAL_VSUM : thm
  INTEGRAL_VSUM : thm
  INTEGRABLE_VSUM : thm
  HAS_INTEGRAL_EQ : thm
  INTEGRABLE_EQ : thm
  HAS_INTEGRAL_EQ_EQ : thm
  HAS_INTEGRAL_NULL : thm
  HAS_INTEGRAL_NULL_EQ : thm
  INTEGRAL_NULL : thm
  INTEGRABLE_ON_NULL : thm
  HAS_INTEGRAL_EMPTY : thm
  HAS_INTEGRAL_EMPTY_EQ : thm
  INTEGRABLE_ON_EMPTY : thm
  INTEGRAL_EMPTY : thm
  HAS_INTEGRAL_REFL : thm
  INTEGRABLE_ON_REFL : thm
  INTEGRAL_REFL : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupINE [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) : ExceptT String IO INE := do
  let { LAMBDA_PAIR, .. } := D.qsession
  let GEN_BETA_CONV := D.GEN_BETA_CONV
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, .. } := BINA
  let { gauge, GAUGE_INTER, GAUGE_TRIVIAL, .. } := BINB
  let { fine, FINE_INTER, has_integral, has_integral_alt, HAS_INTEGRAL_INTEGRAL,
        INTEGRABLE_INTEGRAL, integrable_on, integral, tagged_division_of,
        TAGGED_DIVISION_OF_FINITE, tagged_partial_division_of, VSUM_CONTENT_NULL, .. } :=
        BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { AND_FORALL_THM, CONTRAPOS_THM, ETA_AX, FINITE_INDUCT_STRONG, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_INSERT, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_RDIV_EQ, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_SYM, REAL_NOT_LE, REAL_SUB_RZERO, SUBSET, SUBSET_INTER, .. }
        := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, UNION_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { INTERVAL_SING, LINEAR_0, LINEAR_CMUL, LINEAR_SUB, LINEAR_VSUM, NORM_0, NORM_EQ_0, ..
        } := D.dv.dg.pt.cvx.vec2
  let { NORM_POS_LT, NORM_SUB, NORM_TRIANGLE, .. } := D.dv.dg.pt.cvx.vec3
  let { linear, VECTOR_ADD_LDISTRIB, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_NEG_NEG, VECTOR_SUB, VECTOR_SUB_EQ,
        VECTOR_SUB_REFL, VECTOR_SUB_RZERO, VSUM_ADD, VSUM_CLAUSES, VSUM_EQ_0, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, CENTRE_IN_BALL, .. } := D.dv.dg.pt.cvx.top1
  let { INTERIOR_CLOSED_INTERVAL, OPEN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { NORM_TRIANGLE_LT, .. } := D.dv.dg.pt.qvec
  let { BOUNDED_UNION, .. } := D.dv.dg.qtopology1
  let { LINEAR_BOUNDED_POS, VECTOR_NEG_MINUS1, .. } := D.dv.qvec
  let { LAMBDA_PAIR_THM, REAL_LT_MAX, SELECT_UNIQUE, .. } := D.qsession
  let { BALL_MAX_UNION, BOUNDED_SUBSET_CLOSED_INTERVAL, EMPTY_AS_INTERVAL, .. } :=
        D.qtopology
  -- @@SCOPE END

  let HAS_INTEGRAL_UNIQUE ← prove
   r"!f:real^M->real^N i k1 k2.
        (f has_integral k1) i /\ (f has_integral k2) i ==> k1 = k2"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"!f:real^M->real^N a b k1 k2.
       (f has_integral k1) (interval[a,b]) /\
       (f has_integral k2) (interval[a,b])
       ==> k1 = k2")
    MP_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC [has_integral] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN
      REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c")] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
      REWRITE_TAC [← GSYM NORM_POS_LT] THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"norm(k1 - k2 :real^N) / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool") STRIP_ASSUME_TAC)) THEN
      MP_TAC (← ISPEC (← q r"\x. ((d1:real^M->real^M->bool) x) INTER (d2 x)")
                   FINE_DIVISION_EXISTS) THEN
      ASM_SIMP_TAC [GAUGE_INTER] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) =>
        HolCore.Basics.is_forall (concl t)))) THEN
      REWRITE_TAC [] THEN REWRITE_TAC [IMP_IMP, NOT_EXISTS_THM] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
      GEN_TAC THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(f0 ==> f1 /\ f2) /\ ~(n1 /\ n2)
        ==> (t /\ f1 ==> n1) /\ (t /\ f2 ==> n2) ==> ~(t /\ f0)")) THEN
      CONJ_TAC THENL [SIMP_TAC [fine, SUBSET_INTER], ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"c <= a + b ==> ~(a < c / &2 /\ b < c / &2)")) THEN
      MESON_TAC [NORM_SUB, NORM_TRIANGLE, ← VECTOR_ARITH
       (← q r"k1 - k2:real^N = (k1 - x) + (x - k2)")],
      ALL_TAC] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"~(&0 < norm(x - y)) ==> x = y")) THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"norm(k1 - k2:real^N) / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC
     (← q r"ball(vec 0,B1) UNION ball(vec 0:real^M,B2)")
     BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [BOUNDED_UNION, BOUNDED_BALL, UNION_SUBSET, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    DISCH_THEN (CONJUNCTS_THEN (ANTE_RES_THEN MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"w:real^N = z:real^N") SUBST_ALL_TAC THEN
    ASM_MESON_TAC [← NORM_ARITH
     (← q r"~(norm(z - k1) < norm(k1 - k2) / &2 /\
        norm(z - k2) < norm(k1 - k2) / &2)")])

  let INTEGRAL_UNIQUE ← prove
   r"!f y k.
      (f has_integral y) k ==> integral k f = y"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integral] THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN ASM_MESON_TAC [HAS_INTEGRAL_UNIQUE])

  let HAS_INTEGRAL_INTEGRABLE_INTEGRAL ← prove
   r"!f:real^M->real^N i s.
        (f has_integral i) s <=> f integrable_on s /\ integral s f = i"
   (MESON_TAC [INTEGRABLE_INTEGRAL, INTEGRAL_UNIQUE, integrable_on])

  let INTEGRAL_EQ_HAS_INTEGRAL ← prove
   r"!s f y. f integrable_on s ==> (integral s f = y <=> (f has_integral y) s)"
   (MESON_TAC [INTEGRABLE_INTEGRAL, INTEGRAL_UNIQUE])

  let HAS_INTEGRAL_IS_0 ← prove
   r"!f:real^M->real^N s.
        (!x. x IN s ==> (f(x) = vec 0)) ==> (f has_integral vec 0) s"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N a b.
        (!x. x IN interval[a,b] ==> (f(x) = vec 0))
        ==> (f has_integral vec 0) (interval[a,b])")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [has_integral] THEN
      REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"\x:real^M. ball(x,&1)") THEN
      SIMP_TAC [gauge, OPEN_BALL, CENTRE_IN_BALL, REAL_LT_01] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_SUB_RZERO] THEN
      UNDISCH_TAC (← q r"&0 < e") THEN MATCH_MP_TAC (← TAUT (← q r"(a <=> b) ==> b ==> a")) THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [NORM_EQ_0, VECTOR_SUB_EQ, VECTOR_ADD_LID] THEN
      MATCH_MP_TAC VSUM_EQ_0 THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
      CONV_TAC (ONCE_DEPTH_CONV GEN_BETA_CONV) THEN
      X_GEN_TAC (← q r"x:real^M") THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:real^M) IN interval[a,b]")
       (fun th => ASM_SIMP_TAC [th, VECTOR_MUL_RZERO]) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [tagged_division_of]) THEN
      REWRITE_TAC [tagged_partial_division_of, SUBSET] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [])

  let HAS_INTEGRAL_0 ← prove
   r"!s. ((\x. vec 0) has_integral vec 0) s"
   (SIMP_TAC [HAS_INTEGRAL_IS_0])

  let HAS_INTEGRAL_0_EQ ← prove
   r"!i s. ((\x. vec 0) has_integral i) s <=> i = vec 0"
   (MESON_TAC [HAS_INTEGRAL_UNIQUE, HAS_INTEGRAL_0])

  let HAS_INTEGRAL_LINEAR ← prove
   r"!f:real^M->real^N y s h:real^N->real^P.
        (f has_integral y) s /\ linear h ==> ((h o f) has_integral h(y)) s"
   (SUBGOAL_THEN
      (← q r"!f:real^M->real^N y a b h:real^N->real^P.
          (f has_integral y) (interval[a,b]) /\ linear h
          ==> ((h o f) has_integral h(y)) (interval[a,b])")
    MP_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC [has_integral] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP LINEAR_BOUNDED_POS) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real / B")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      STRIP_TAC THEN ASM_SIMP_TAC [] THEN
      X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^M#(real^M->bool)->bool")) THEN
      ASM_SIMP_TAC [REAL_LT_RDIV_EQ] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> y < e ==> x < e")) THEN
      FIRST_ASSUM (fun th => W (fun (_, w) => tactic_of do
        pure (MP_TAC (← PART_MATCH rand th (← liftExcept (rand w)))))) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> y <= e ==> x <= e")) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      ASM_SIMP_TAC [LINEAR_SUB, LINEAR_VSUM, o_DEF, LAMBDA_PAIR_THM,
                    LINEAR_CMUL, REAL_LE_REFL],
      ALL_TAC] THEN
    DISCH_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o MATCH_MP
      LINEAR_BOUNDED_POS) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / B:real")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"M:real") THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(h:real^N->real^P) z") THEN
    SUBGOAL_THEN
     (← q r"(\x. if x IN s then ((h:real^N->real^P) o (f:real^M->real^N)) x else vec 0)
    = h o (\x. if x IN s then f x else vec 0)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN ASM_MESON_TAC [LINEAR_0], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM LINEAR_SUB] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"B * norm(z - y:real^N)") THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ])

  let HAS_INTEGRAL_CMUL ← prove
   r"!(f:real^M->real^N) k s c.
        (f has_integral k) s
        ==> ((\x. c % f(x)) has_integral (c % k)) s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC
     (← REWRITE_RULE [o_DEF] HAS_INTEGRAL_LINEAR) THEN
    ASM_REWRITE_TAC [linear] THEN CONJ_TAC THEN VECTOR_ARITH_TAC)

  let HAS_INTEGRAL_NEG ← prove
   r"!f k s. (f has_integral k) s ==> ((\x. --(f x)) has_integral (--k)) s"
   (ONCE_REWRITE_TAC [VECTOR_NEG_MINUS1] THEN REWRITE_TAC [HAS_INTEGRAL_CMUL])

  let HAS_INTEGRAL_ADD ← prove
   r"!f:real^M->real^N g s.
        (f has_integral k) s /\ (g has_integral l) s
        ==> ((\x. f(x) + g(x)) has_integral (k + l)) s"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N g k l a b.
        (f has_integral k) (interval[a,b]) /\
        (g has_integral l) (interval[a,b])
        ==> ((\x. f(x) + g(x)) has_integral (k + l)) (interval[a,b])")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN REWRITE_TAC [has_integral, AND_FORALL_THM] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"\x. ((d1:real^M->real^M->bool) x) INTER (d2 x)") THEN
      ASM_SIMP_TAC [GAUGE_INTER] THEN
      REWRITE_TAC [tagged_division_of, tagged_partial_division_of] THEN
      SIMP_TAC [VSUM_ADD, VECTOR_ADD_LDISTRIB, LAMBDA_PAIR] THEN
      REWRITE_TAC [← GSYM LAMBDA_PAIR] THEN
      REWRITE_TAC [← GSYM tagged_partial_division_of] THEN
      REWRITE_TAC [← GSYM tagged_division_of, FINE_INTER] THEN
      SIMP_TAC [← VECTOR_ARITH (← q r"(a + b) - (c + d) = (a - c) + (b - d):real^N")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC NORM_TRIANGLE_LT THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e")) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"max B1 B2:real") THEN ASM_REWRITE_TAC [REAL_LT_MAX] THEN
    REWRITE_TAC [BALL_MAX_UNION, UNION_SUBSET] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    DISCH_THEN (CONJUNCTS_THEN (ANTE_RES_THEN MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"w + z:real^N") THEN
    SUBGOAL_THEN
      (← q r"(\x. if x IN s then (f:real^M->real^N) x + g x else vec 0) =
     (\x. (if x IN s then f x else vec 0) + (if x IN s then g x else vec 0))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_NOT_LE])) THEN
    NORM_ARITH_TAC)

  let HAS_INTEGRAL_SUB ← prove
   r"!f:real^M->real^N g s.
        (f has_integral k) s /\ (g has_integral l) s
        ==> ((\x. f(x) - g(x)) has_integral (k - l)) s"
   (SIMP_TAC [VECTOR_SUB, HAS_INTEGRAL_NEG, HAS_INTEGRAL_ADD])

  let INTEGRAL_0 ← prove
   r"!s. integral s (\x. vec 0) = vec 0"
   (MESON_TAC [INTEGRAL_UNIQUE, HAS_INTEGRAL_0])

  let INTEGRAL_ADD ← prove
   r"!f:real^M->real^N g s.
        f integrable_on s /\ g integrable_on s
        ==> integral s (\x. f x + g x) = integral s f + integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_ADD THEN ASM_SIMP_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRAL_CMUL ← prove
   r"!f:real^M->real^N c s.
        f integrable_on s ==> integral s (\x. c % f(x)) = c % integral s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_CMUL THEN ASM_SIMP_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRAL_NEG ← prove
   r"!f:real^M->real^N s.
        f integrable_on s ==> integral s (\x. --f(x)) = --integral s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_NEG THEN ASM_SIMP_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRAL_SUB ← prove
   r"!f:real^M->real^N g s.
        f integrable_on s /\ g integrable_on s
        ==> integral s (\x. f x - g x) = integral s f - integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_SUB THEN ASM_SIMP_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRABLE_0 ← prove
   r"!s. (\x. vec 0) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_0])

  let INTEGRABLE_ADD ← prove
   r"!f:real^M->real^N g s.
        f integrable_on s /\ g integrable_on s
        ==> (\x. f x + g x) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_ADD])

  let INTEGRABLE_CMUL ← prove
   r"!f:real^M->real^N c s.
        f integrable_on s ==> (\x. c % f(x)) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_CMUL])

  let INTEGRABLE_CMUL_EQ ← prove
   r"!f:real^M->real^N s c.
      (\x. c % f x) integrable_on s <=> c = &0 \/ f integrable_on s"
   (REPEAT (STRIP_TAC ORELSE EQ_TAC) THEN
    ASM_SIMP_TAC [INTEGRABLE_CMUL, VECTOR_MUL_LZERO, INTEGRABLE_0] THEN
    ASM_CASES_TAC (← q r"c = &0") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv c:real") o MATCH_MP INTEGRABLE_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_LINV, ETA_AX])

  let INTEGRABLE_NEG ← prove
   r"!f:real^M->real^N s.
        f integrable_on s ==> (\x. --f(x)) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_NEG])

  let INTEGRABLE_NEG_EQ ← prove
   r"!f:real^M->real^N s. (\x. --f x) integrable_on s <=> f integrable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_NEG) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX])

  let INTEGRABLE_SUB ← prove
   r"!f:real^M->real^N g s.
        f integrable_on s /\ g integrable_on s
        ==> (\x. f x - g x) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_SUB])

  let INTEGRABLE_LINEAR ← prove
   r"!f h s. f integrable_on s /\ linear h ==> (h o f) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_LINEAR])

  let INTEGRAL_LINEAR ← prove
   r"!f:real^M->real^N s h:real^N->real^P.
        f integrable_on s /\ linear h
        ==> integral s (h o f) = h(integral s f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_UNIQUE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(h:real^N->real^P) o (f:real^M->real^N)", ← q r"s:real^M->bool"] THEN
    CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC HAS_INTEGRAL_LINEAR] THEN
    ASM_SIMP_TAC [← GSYM HAS_INTEGRAL_INTEGRAL, INTEGRABLE_LINEAR])

  let HAS_INTEGRAL_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\
        (!a. a IN t ==> ((f a) has_integral (i a)) s)
        ==> ((\x. vsum t (\a. f a x)) has_integral (vsum t i)) s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, HAS_INTEGRAL_0, IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_ADD THEN
    ASM_REWRITE_TAC [ETA_AX] THEN CONJ_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [])

  let INTEGRAL_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\
        (!a. a IN t ==> (f a) integrable_on s)
        ==> integral s (\x. vsum t (\a. f a x)) =
                vsum t (\a. integral s (f a))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_VSUM THEN ASM_SIMP_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRABLE_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\
        (!a. a IN t ==> (f a) integrable_on s)
        ==>  (\x. vsum t (\a. f a x)) integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_VSUM])

  let HAS_INTEGRAL_EQ ← prove
   r"!f:real^M->real^N g k s.
        (!x. x IN s ==> (f(x) = g(x))) /\
        (f has_integral k) s
        ==> (g has_integral k) s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o MATCH_MP HAS_INTEGRAL_IS_0) MP_TAC) THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB) THEN
    SIMP_TAC [← VECTOR_ARITH (← q r"x - (x - y:real^N) = y"), ETA_AX, VECTOR_SUB_RZERO])

  let INTEGRABLE_EQ ← prove
   r"!f:real^M->real^N g s.
        (!x. x IN s ==> (f(x) = g(x))) /\
        f integrable_on s
        ==> g integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_EQ])

  let HAS_INTEGRAL_EQ_EQ ← prove
   r"!f:real^M->real^N g k s.
        (!x. x IN s ==> (f(x) = g(x)))
        ==> ((f has_integral k) s <=> (g has_integral k) s)"
   (MESON_TAC [HAS_INTEGRAL_EQ])

  let HAS_INTEGRAL_NULL ← prove
   r"!f:real^M->real^N a b.
    content(interval[a,b]) = &0 ==> (f has_integral vec 0) (interval[a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_integral] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"\x:real^M. ball(x,&1)") THEN REWRITE_TAC [GAUGE_TRIVIAL] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_SUB_RZERO] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 /\ &0 < e ==> x < e")) THEN
    ASM_REWRITE_TAC [NORM_EQ_0] THEN ASM_MESON_TAC [VSUM_CONTENT_NULL])

  let HAS_INTEGRAL_NULL_EQ ← prove
   r"!f a b i. content(interval[a,b]) = &0
             ==> ((f has_integral i) (interval[a,b]) <=> i = vec 0)"
   (ASM_MESON_TAC [INTEGRAL_UNIQUE, HAS_INTEGRAL_NULL])

  let INTEGRAL_NULL ← prove
   r"!f a b. content(interval[a,b]) = &0
           ==> integral(interval[a,b]) f = vec 0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    ASM_MESON_TAC [HAS_INTEGRAL_NULL])

  let INTEGRABLE_ON_NULL ← prove
   r"!f a b. content(interval[a,b]) = &0
           ==> f integrable_on interval[a,b]"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_NULL])

  let HAS_INTEGRAL_EMPTY ← prove
   r"!f. (f has_integral vec 0) {}"
   (MESON_TAC [HAS_INTEGRAL_NULL, CONTENT_EMPTY, EMPTY_AS_INTERVAL])

  let HAS_INTEGRAL_EMPTY_EQ ← prove
   r"!f i. (f has_integral i) {} <=> i = vec 0"
   (MESON_TAC [HAS_INTEGRAL_UNIQUE, HAS_INTEGRAL_EMPTY])

  let INTEGRABLE_ON_EMPTY ← prove
   r"!f. f integrable_on {}"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_EMPTY])

  let INTEGRAL_EMPTY ← prove
   r"!f. integral {} f = vec 0"
   (MESON_TAC [EMPTY_AS_INTERVAL, INTEGRAL_UNIQUE, HAS_INTEGRAL_EMPTY])

  let HAS_INTEGRAL_REFL ← prove
   r"!f a. (f has_integral vec 0) (interval[a,a])"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_NULL THEN
    SIMP_TAC [INTERVAL_SING, INTERIOR_CLOSED_INTERVAL, CONTENT_EQ_0_INTERIOR])

  let INTEGRABLE_ON_REFL ← prove
   r"!f a. f integrable_on interval[a,a]"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_REFL])

  let INTEGRAL_REFL ← prove
   r"!f a. integral (interval[a,a]) f = vec 0"
   (MESON_TAC [INTEGRAL_UNIQUE, HAS_INTEGRAL_REFL])

  pure { HAS_INTEGRAL_UNIQUE, INTEGRAL_UNIQUE, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
         INTEGRAL_EQ_HAS_INTEGRAL, HAS_INTEGRAL_IS_0, HAS_INTEGRAL_0, HAS_INTEGRAL_0_EQ,
         HAS_INTEGRAL_LINEAR, HAS_INTEGRAL_CMUL, HAS_INTEGRAL_NEG, HAS_INTEGRAL_ADD,
         HAS_INTEGRAL_SUB, INTEGRAL_0, INTEGRAL_ADD, INTEGRAL_CMUL, INTEGRAL_NEG,
         INTEGRAL_SUB, INTEGRABLE_0, INTEGRABLE_ADD, INTEGRABLE_CMUL, INTEGRABLE_CMUL_EQ,
         INTEGRABLE_NEG, INTEGRABLE_NEG_EQ, INTEGRABLE_SUB, INTEGRABLE_LINEAR,
         INTEGRAL_LINEAR, HAS_INTEGRAL_VSUM, INTEGRAL_VSUM, INTEGRABLE_VSUM,
         HAS_INTEGRAL_EQ, INTEGRABLE_EQ, HAS_INTEGRAL_EQ_EQ, HAS_INTEGRAL_NULL,
         HAS_INTEGRAL_NULL_EQ, INTEGRAL_NULL, INTEGRABLE_ON_NULL, HAS_INTEGRAL_EMPTY,
         HAS_INTEGRAL_EMPTY_EQ, INTEGRABLE_ON_EMPTY, INTEGRAL_EMPTY, HAS_INTEGRAL_REFL,
         INTEGRABLE_ON_REFL, INTEGRAL_REFL }

/- ------------------------------------------------------------------------- -/
/- Cauchy-type criterion; additivity of integral on abutting intervals.     -/
/- (integration.ml 2515-2916)                                                -/
/- ------------------------------------------------------------------------- -/

structure INF where
  INTEGRABLE_CAUCHY : thm
  INTERVAL_SPLIT : thm
  CONTENT_SPLIT : thm
  DIVISION_SPLIT_LEFT_INJ : thm
  DIVISION_SPLIT_RIGHT_INJ : thm
  TAGGED_DIVISION_SPLIT_LEFT_INJ : thm
  TAGGED_DIVISION_SPLIT_RIGHT_INJ : thm
  DIVISION_SPLIT : thm
  HAS_INTEGRAL_SPLIT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINF [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) : ExceptT String IO INF := do
  -- @@SCOPE BEGIN
  let { CONTENT_CLOSED_INTERVAL_CASES, CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, .. } := BINA
  let { division_of, gauge, GAUGE_INTERS, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, fine, FINE_INTERS, has_integral, integrable_on,
        TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { AND_FORALL_THM, CONTRAPOS_THM, EQ_IMP, EQ_TRANS, EXISTS_PAIR_THM, EXTENSION,
        FINITE_DELETE, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT, FINITE_SUBSET,
        FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, GE, IMP_CONJ, IMP_IMP, IN_DELETE,
        INTER_UNIONS, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNIONS, LAMBDA_BETA,
        LE_REFL, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        PAIR_EQ, REAL_ADD_LID, REAL_ADD_RID, REAL_ARCH_INV, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LE_MIN, REAL_LE_REFL, REAL_LE_TOTAL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LTE_TRANS, REAL_MAX_LE, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_SUB_0, RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_THM, real_ge, WLOG_LE, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_REFL, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_ADD_RDISTRIB, VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_SUB_COMPONENT,
        VSUM_ADD, VSUM_EQ, VSUM_SUPERSET, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_BALL, LIM_SEQUENTIALLY, OPEN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTER, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { NORM_TRIANGLE_LT, .. } := D.dv.dg.pt.qvec
  let { LE_0, .. } := D.dv.dg.qsession
  let { REAL_ABS_NZ, .. } := D.dv.qsession
  let { CONVERGENT_EQ_CAUCHY, .. } := D.dv.qtopology1
  let { cauchy, .. } := D.dv.qtopology2
  let { PRODUCT_EQ, .. } := D.qproducts
  let { LEFT_AND_FORALL_THM, PRODUCT_CLAUSES, SND, .. } := D.qsession
  let { DIST_TRIANGLE_HALF_L, VSUM_IMAGE_NONZERO, .. } := D.qvec
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let INTEGRABLE_CAUCHY ← prove
   r"!f:real^M->real^N a b.
    f integrable_on interval[a,b] <=>
        !e. &0 < e
            ==> ?d. gauge d /\
                    !p1 p2. p1 tagged_division_of interval[a,b] /\ d fine p1 /\
                            p2 tagged_division_of interval[a,b] /\ d fine p2
                            ==> norm(vsum p1 (\(x,k). content k % f x) -
                                     vsum p2 (\(x,k). content k % f x)) < e"
   (REPEAT GEN_TAC THEN REWRITE_TAC [integrable_on, has_integral] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"y:real^N") (MP_TAC o SPEC (← q r"e / &2"))) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
      REWRITE_TAC [← GSYM dist] THEN MESON_TAC [DIST_TRIANGLE_HALF_L],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1"), SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real^M->real^M->bool") MP_TAC) THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
    MP_TAC (← GEN (← q r"n:num")
     (← ISPECL [← q r"\x. INTERS {(d:num->real^M->real^M->bool) i x | i IN 0..n}",
               ← q r"a:real^M", ← q r"b:real^M"]
       FINE_DIVISION_EXISTS)) THEN
    ASM_SIMP_TAC [GAUGE_INTERS, FINE_INTERS, FINITE_NUMSEG, SKOLEM_THM] THEN
    REWRITE_TAC [IN_NUMSEG, LE_0, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:num->(real^M#(real^M->bool))->bool")
      STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
      (← q r"cauchy (\n. vsum (p n)
                   (\(x,k:real^M->bool). content k % (f:real^M->real^N) x))")
    MP_TAC THENL
     [REWRITE_TAC [cauchy] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_ARCH_INV]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
      MATCH_MP_TAC WLOG_LE THEN CONJ_TAC THENL
       [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN REWRITE_TAC [GE] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"inv(&m + &1)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [dist] THEN ASM_MESON_TAC [LE_REFL], ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY, LIM_SEQUENTIALLY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real^N") THEN
    REWRITE_TAC [dist] THEN STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"e / &2") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN EXISTS_TAC
     (← q r"(d:num->real^M->real^M->bool) (N1 + N2)") THEN
    ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"q:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM dist] THEN MATCH_MP_TAC DIST_TRIANGLE_HALF_L THEN
    EXISTS_TAC (← q r"vsum (p(N1+N2:num))
                  (\(x,k:real^M->bool). content k % (f:real^M->real^N) x)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [dist] THEN MATCH_MP_TAC REAL_LTE_TRANS THEN
      EXISTS_TAC (← q r"inv(&(N1 + N2) + &1)") THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [LE_REFL], ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"inv(&N1)") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [dist] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC])

  let INTERVAL_SPLIT ← prove
   r"!a b:real^N c k.
    1 <= k /\ k <= dimindex(:N)
    ==> interval[a,b] INTER {x | x$k <= c} =
        interval[a,(lambda i. if i = k then min (b$k) c else b$i)] /\
        interval[a,b] INTER {x | x$k >= c} =
        interval[(lambda i. if i = k then max (a$k) c else a$i),b]"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_INTERVAL, IN_INTER, IN_ELIM_THM] THEN
    ASM_SIMP_TAC [LAMBDA_BETA] THEN X_GEN_TAC (← q r"y:real^N") THEN
    MATCH_MP_TAC (← TAUT (← q r"(c ==> b) /\ (c ==> a) /\ (a /\ b ==> c)
                     ==> (a /\ b <=> c)")) THEN
    (CONJ_TAC THENL
      [ASM_MESON_TAC [REAL_MAX_LE, REAL_LE_MIN, real_ge],  ALL_TAC]) THEN
    REWRITE_TAC [LEFT_AND_FORALL_THM, real_ge] THEN CONJ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN ASM_MESON_TAC [REAL_MAX_LE, REAL_LE_MIN])

  let CONTENT_SPLIT ← prove
   r"!a b:real^N k.
    1 <= k /\ k <= dimindex(:N)
    ==> content(interval[a,b]) =
        content(interval[a,b] INTER {x | x$k <= c}) +
        content(interval[a,b] INTER {x | x$k >= c})"
   (SIMP_TAC [INTERVAL_SPLIT, CONTENT_CLOSED_INTERVAL_CASES, LAMBDA_BETA] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [← REAL_ARITH
     (← q r"((a <= if p then b else c) <=> (p ==> a <= b) /\ (~p ==> a <= c)) /\
      ((if p then b else c) <= a <=> (p ==> b <= a) /\ (~p ==> c <= a))")] THEN
    REWRITE_TAC [REAL_LE_MIN, REAL_MAX_LE] THEN
    REWRITE_TAC [← MESON [] (← q r"(i = k ==> p i k) <=> (i = k ==> p i i)")] THEN
    REWRITE_TAC [← TAUT (← q r"(p ==> a /\ b) /\ (~p ==> a) <=> a /\ (p ==> b)")] THEN
    REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    ASM_CASES_TAC
     (← q r"!i. 1 <= i /\ i <= dimindex(:N) ==> (a:real^N)$i <= (b:real^N)$i") THEN
    ASM_REWRITE_TAC [REAL_ADD_RID] THEN
    REWRITE_TAC [← MESON [] (← q r"(!i. P i ==> i = k ==> Q i) <=> (P k ==> Q k)")] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"min b c = if c <= b then c else b"),
                 ← REAL_ARITH (← q r"max a c = if a <= c then c else a")] THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_ADD_LID, REAL_ADD_RID]) THEN
    REWRITE_TAC [← MESON [] (← q r"(if i = k then a k else a i) = a i")] THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_TOTAL]] THEN
    SUBGOAL_THEN (← q r"1..dimindex(:N) = k INSERT ((1..dimindex(:N)) DELETE k)")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_INSERT, IN_DELETE, IN_NUMSEG] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SIMP_TAC [PRODUCT_CLAUSES, FINITE_DELETE, FINITE_NUMSEG, IN_DELETE] THEN
    MATCH_MP_TAC (← REAL_RING
     (← q r"p'' = p /\ p':real = p
      ==> (b - a) * p = (c - a) * p' + (b - c) * p''")) THEN
    CONJ_TAC THEN MATCH_MP_TAC PRODUCT_EQ THEN SIMP_TAC [IN_DELETE])

  let (DIVISION_SPLIT_LEFT_INJ, DIVISION_SPLIT_RIGHT_INJ) ← CONJ_PAIR (← (do
    let lemma ← prove
     r"!a b:real^N c k.
      1 <= k /\ k <= dimindex(:N)
      ==> (content(interval[a,b] INTER {x | x$k <= c}) = &0 <=>
           interior(interval[a,b] INTER {x | x$k <= c}) = {}) /\
          (content(interval[a,b] INTER {x | x$k >= c}) = &0 <=>
           interior(interval[a,b] INTER {x | x$k >= c}) = {})"
     (SIMP_TAC [INTERVAL_SPLIT, CONTENT_EQ_0_INTERIOR])
    prove
     r"(!d i k1 k2 k c.
        d division_of i /\ 1 <= k /\ k <= dimindex(:N) /\
        k1 IN d /\ k2 IN d /\ ~(k1 = k2) /\
        k1 INTER {x | x$k <= c} = k2 INTER {x | x$k <= c}
        ==> content(k1 INTER {x:real^N | x$k <= c}) = &0) /\
   (!d i k1 k2 k c.
        d division_of i /\ 1 <= k /\ k <= dimindex(:N) /\
        k1 IN d /\ k2 IN d /\ ~(k1 = k2) /\
        k1 INTER {x | x$k >= c} = k2 INTER {x | x$k >= c}
        ==> content(k1 INTER {x:real^N | x$k >= c}) = &0)"
     (REPEAT STRIP_TAC THEN
      REWRITE_TAC [CONTENT_EQ_0_INTERIOR] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (MP_TAC o CONJUNCT1) o CONJUNCT2) THEN
      DISCH_THEN (MP_TAC o SPECL
        [← q r"k1:real^N->bool", ← q r"k2:real^N->bool"]) THEN
      ASM_REWRITE_TAC [PAIR_EQ] THEN DISCH_TAC THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"k2:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N") (X_CHOOSE_THEN (← q r"v:real^N")
        SUBST_ALL_TAC)) THEN
      ASM_SIMP_TAC [lemma] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s INTER t = {}
        ==> u SUBSET s /\ u SUBSET t ==> u = {}"))) THEN
      CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN ASM SET_TAC [])))

  let TAGGED_DIVISION_SPLIT_LEFT_INJ ← prove
   r"!d i x1 k1 x2 k2 k c.
        d tagged_division_of i /\ 1 <= k /\ k <= dimindex(:N) /\
        (x1,k1) IN d /\ (x2,k2) IN d /\ ~(k1 = k2) /\
        k1 INTER {x | x$k <= c} = k2 INTER {x | x$k <= c}
        ==> content(k1 INTER {x:real^N | x$k <= c}) = &0"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_TAGGED_DIVISION) THEN
    MATCH_MP_TAC DIVISION_SPLIT_LEFT_INJ THEN
    EXISTS_TAC (← q r"IMAGE SND (d:(real^N#(real^N->bool))->bool)") THEN
    ASM_REWRITE_TAC [IN_IMAGE] THEN ASM_MESON_TAC [SND])

  let TAGGED_DIVISION_SPLIT_RIGHT_INJ ← prove
   r"!d i x1 k1 x2 k2 k c.
        d tagged_division_of i /\ 1 <= k /\ k <= dimindex(:N) /\
        (x1,k1) IN d /\ (x2,k2) IN d /\ ~(k1 = k2) /\
        k1 INTER {x | x$k >= c} = k2 INTER {x | x$k >= c}
        ==> content(k1 INTER {x:real^N | x$k >= c}) = &0"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_TAGGED_DIVISION) THEN
    MATCH_MP_TAC DIVISION_SPLIT_RIGHT_INJ THEN
    EXISTS_TAC (← q r"IMAGE SND (d:(real^N#(real^N->bool))->bool)") THEN
    ASM_REWRITE_TAC [IN_IMAGE] THEN ASM_MESON_TAC [SND])

  let DIVISION_SPLIT ← prove
   r"!p s:real^N->bool k c.
     p division_of s /\ 1 <= k /\ k <= dimindex(:N)
     ==> {l INTER {x | x$k <= c} |l| l IN p /\ ~(l INTER {x | x$k <= c} = {})}
         division_of (s INTER {x | x$k <= c}) /\
         {l INTER {x | x$k >= c} |l| l IN p /\ ~(l INTER {x | x$k >= c} = {})}
         division_of (s INTER {x | x$k >= c})"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    SIMP_TAC [division_of, FINITE_IMAGE] THEN
    SIMP_TAC [← SET_RULE (← q r"(!x. x IN {f x | P x} ==> Q x) <=> (!x. P x ==> Q (f x))"),
              ← MESON [] (← q r"(!x y. x IN s /\ y IN t /\ Q x y ==> P x y) <=>
                    (!x. x IN s ==> !y. y IN t ==> Q x y ==> P x y)"),
              RIGHT_FORALL_IMP_THM] THEN
    REPEAT (MATCH_MP_TAC (← TAUT
     (← q r"(a ==> a' /\ a'') /\ (b ==> b' /\ b'')
      ==> a /\ b ==> (a' /\ b') /\ (a'' /\ b'')")) THEN CONJ_TAC)
    THENL
     [ONCE_REWRITE_TAC [← SET_RULE
      (← q r"{f x |x| x IN s /\ ~(f x = {})} = {y | y IN IMAGE f s /\ ~(y = {})}")] THEN
      SIMP_TAC [FINITE_RESTRICT, FINITE_IMAGE],
      REWRITE_TAC [AND_FORALL_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"l:real^N->bool") THEN
      DISCH_THEN (fun th => CONJ_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
      (ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_AND THEN
       CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
       STRIP_TAC THEN ASM_MESON_TAC [INTERVAL_SPLIT]),
      DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      (REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
       DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
       REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
       DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
       DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
       ANTS_TAC THENL [ASM_MESON_TAC [PAIR_EQ], ALL_TAC] THEN
       MATCH_MP_TAC (← SET_RULE
        (← q r"s SUBSET s' /\ t SUBSET t'
         ==> s' INTER t' = {} ==> s INTER t = {}")) THEN
       CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC []),
     DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [INTER_UNIONS] THEN
     ONCE_REWRITE_TAC [EXTENSION] THEN REWRITE_TAC [IN_UNIONS] THEN
     CONJ_TAC THEN GEN_TAC THEN AP_TERM_TAC THEN
     GEN_REWRITE_TAC I [FUN_EQ_THM] THEN GEN_TAC THEN
     REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN MESON_TAC [NOT_IN_EMPTY]])

  let HAS_INTEGRAL_SPLIT ← (do
    let lemma1 ← prove
     r"(!x k. (x,k) IN {x,f k | P x k} ==> Q x k) <=>
     (!x k. P x k ==> Q x (f k))"
     (REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN
      SET_TAC [])
    let lemma2 ← prove
     r"!f:B->B s:(A#B)->bool.
      FINITE s ==> FINITE {x,f k | (x,k) IN s /\ P x k}"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (\(x:A,k:B). x,(f k:B)) s") THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, lemma1, IN_IMAGE] THEN
      REWRITE_TAC [EXISTS_PAIR_THM, PAIR_EQ] THEN MESON_TAC [])
    let lemma3 ← prove
     r"!f:real^M->real^N g:(real^M->bool)->(real^M->bool) p.
     FINITE p
     ==> vsum {x,g k |x,k| (x,k) IN p /\ ~(g k = {})}
              (\(x,k). content k % f x) =
         vsum (IMAGE (\(x,k). x,g k) p) (\(x,k). content k % f x)"
     (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_SUPERSET THEN
      ASM_SIMP_TAC [FINITE_IMAGE, lemma2] THEN
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_PAIR_THM, SUBSET, IN_IMAGE, EXISTS_PAIR_THM] THEN
      REWRITE_TAC [IN_ELIM_THM, PAIR_EQ, VECTOR_MUL_EQ_0] THEN
      MESON_TAC [CONTENT_EMPTY])
    let lemma4 ← prove
     r"(\(x,l). content (g l) % f x) =
     (\(x,l). content l % f x) o (\(x,l). x,g l)"
     (REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM])
    prove
     r"!f:real^M->real^N k a b c.
      (f has_integral i) (interval[a,b] INTER {x | x$k <= c}) /\
      (f has_integral j) (interval[a,b] INTER {x | x$k >= c}) /\
      1 <= k /\ k <= dimindex(:M)
      ==> (f has_integral (i + j)) (interval[a,b])"
     (REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:M)") THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [INTERVAL_SPLIT] THEN REWRITE_TAC [has_integral] THEN
      ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT] THEN FIRST_X_ASSUM STRIP_ASSUME_TAC THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"e / &2")) STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "I2"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "I1"))) THEN
      EXISTS_TAC (← q r"\x. if x$k = c then (d1(x:real^M) INTER d2(x)):real^M->bool
                  else ball(x,abs(x$k - c)) INTER d1(x) INTER d2(x)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [gauge] THEN GEN_TAC THEN
        RULE_ASSUM_TAC (REWRITE_RULE [gauge]) THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [OPEN_INTER, IN_INTER, OPEN_BALL, IN_BALL] THEN
        ASM_REWRITE_TAC [DIST_REFL, ← GSYM REAL_ABS_NZ, REAL_SUB_0],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"p:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"(!x:real^M kk. (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k <= c} = {})
                    ==> x$k <= c) /\
     (!x:real^M kk. (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k >= c} = {})
                    ==> x$k >= c)")
      STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL, real_ge] THEN DISCH_THEN
         (MP_TAC o MATCH_MP (← SET_RULE (← q r"k SUBSET (a INTER b) ==> k SUBSET a"))) THEN
        REWRITE_TAC [SUBSET, IN_BALL, dist] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M") MP_TAC) THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^M")) THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_NOT_LE, REAL_NOT_LT] THEN STRIP_TAC THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"abs((x - u:real^M)$k)") THEN
        ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
        ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REMOVE_THEN "I2" (MP_TAC o SPEC
       (← q r"{(x:real^M,kk INTER {x:real^M | x$k >= c}) |x,kk|
         (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k >= c} = {})}")) THEN
      REMOVE_THEN "I1" (MP_TAC o SPEC
       (← q r"{(x:real^M,kk INTER {x:real^M | x$k <= c}) |x,kk|
         (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k <= c} = {})}")) THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(a /\ b) /\ (a' /\ b' ==> c) ==> (a ==> a') ==> (b ==> b') ==> c")) THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        REWRITE_TAC [TAGGED_DIVISION_OF] THEN
        REPEAT (MATCH_MP_TAC (← TAUT
         (← q r"(a ==> (a' /\ a'')) /\ (b ==> (b' /\ d) /\ (b'' /\ e))
          ==> a /\ b ==> ((a' /\ b') /\ d) /\ ((a'' /\ b'') /\ e)")) THEN
          CONJ_TAC) THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [lemma1] THEN REWRITE_TAC [IMP_IMP] THENL
         [SIMP_TAC [lemma2],
          REWRITE_TAC [AND_FORALL_THM] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
          DISCH_THEN (fun th => CONJ_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
          (ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
            [SIMP_TAC [IN_INTER, IN_ELIM_THM] THEN ASM_MESON_TAC [], ALL_TAC]) THEN
          (MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
          ASM_MESON_TAC [INTERVAL_SPLIT],
          DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
          (REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
           DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
           REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
           DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
           ANTS_TAC THENL [ASM_MESON_TAC [PAIR_EQ], ALL_TAC] THEN
           MATCH_MP_TAC (← SET_RULE
            (← q r"s SUBSET s' /\ t SUBSET t'
             ==> s' INTER t' = {} ==> s INTER t = {}")) THEN
           CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC []),
          ALL_TAC] THEN
        MATCH_MP_TAC (← TAUT (← q r"(a ==> b /\ c) /\ d /\ e
                           ==> (a ==> (b /\ d) /\ (c /\ e))")) THEN
        CONJ_TAC THENL
         [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [INTER_UNIONS] THEN
          ONCE_REWRITE_TAC [EXTENSION] THEN REWRITE_TAC [IN_UNIONS] THEN
          X_GEN_TAC (← q r"x:real^M") THEN AP_TERM_TAC THEN
          GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
          REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN MESON_TAC [NOT_IN_EMPTY],
          ALL_TAC] THEN
        CONJ_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
        REWRITE_TAC [fine, lemma1] THEN
        REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_SIMP_TAC [] THEN SET_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e"))) THEN
      DISCH_THEN (MP_TAC o MATCH_MP NORM_TRIANGLE_LT) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(a - i) + (b - j) = c - (i + j) <=> a + b = c:real^N")] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"vsum p (\(x,l). content (l INTER {x:real^M | x$k <= c}) %
                     (f:real^M->real^N) x) +
    vsum p (\(x,l). content (l INTER {x:real^M | x$k >= c}) %
                     (f:real^M->real^N) x)") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        ASM_SIMP_TAC [← GSYM VSUM_ADD] THEN MATCH_MP_TAC VSUM_EQ THEN
        REWRITE_TAC [FORALL_PAIR_THM, ← GSYM VECTOR_ADD_RDISTRIB] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN
        DISCH_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"l:real^M->bool"] o
                   elc 1) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [← GSYM CONTENT_SPLIT]] THEN
      ASM_SIMP_TAC [lemma3] THEN BINOP_TAC THEN
      (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [lemma4] THEN
       MATCH_MP_TAC VSUM_IMAGE_NONZERO THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
       REWRITE_TAC [PAIR_EQ] THEN
       ASM_MESON_TAC [TAGGED_DIVISION_SPLIT_LEFT_INJ, VECTOR_MUL_LZERO,
                      TAGGED_DIVISION_SPLIT_RIGHT_INJ])))

  pure { INTEGRABLE_CAUCHY, INTERVAL_SPLIT, CONTENT_SPLIT, DIVISION_SPLIT_LEFT_INJ,
         DIVISION_SPLIT_RIGHT_INJ, TAGGED_DIVISION_SPLIT_LEFT_INJ,
         TAGGED_DIVISION_SPLIT_RIGHT_INJ, DIVISION_SPLIT, HAS_INTEGRAL_SPLIT }

/- ------------------------------------------------------------------------- -/
/- Integrability on subintervals; generalized additivity; lifted functions; -/
/- division points.  (integration.ml 2917-3233)                              -/
/- ------------------------------------------------------------------------- -/

structure ING where
  TAGGED_DIVISION_UNION_INTERVAL : thm
  HAS_INTEGRAL_SEPARATE_SIDES : thm
  INTEGRABLE_SPLIT : thm
  operative : thm
  OPERATIVE_TRIVIAL : thm
  PROPERTY_EMPTY_INTERVAL : thm
  OPERATIVE_EMPTY : thm
  FORALL_OPTION : thm
  EXISTS_OPTION : thm
  lifted : thm
  NEUTRAL_LIFTED : thm
  MONOIDAL_LIFTED : thm
  ITERATE_SOME : thm
  OPERATIVE_CONTENT : thm
  OPERATIVE_INTEGRAL : thm
  division_points : thm
  DIVISION_POINTS_FINITE : thm
  DIVISION_POINTS_SUBSET : thm
  DIVISION_POINTS_PSUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupING [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINF : INF) : ExceptT String IO ING := do
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, .. }
        := BINA
  let { division_of, FORALL_IN_DIVISION, .. } := BINB
  let { FINE_UNION, has_integral, INTEGRABLE_INTEGRAL, integrable_on, integral,
        TAGGED_DIVISION_OF, TAGGED_DIVISION_UNION, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { HAS_INTEGRAL_NULL, HAS_INTEGRAL_NULL_EQ, HAS_INTEGRAL_UNIQUE, .. } := BINE
  let { CONTENT_SPLIT, HAS_INTEGRAL_SPLIT, INTEGRABLE_CAUCHY, INTERVAL_SPLIT, .. } := BINF
  let { COND_ID, CONJ_ASSOC, ETA_AX, EXTENSION, FINITE_IMAGE, FINITE_INDUCT_STRONG,
        FINITE_NUMSEG, FINITE_SUBSET, FINITE_UNION, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, IMP_CONJ, IN, IN_ELIM_PAIR_THM, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIV, LAMBDA_BETA,
        LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        NEUTRAL_REAL_ADD, NOT_IN_EMPTY, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LT_IMP_LE, REAL_LT_REFL, .. } := D.dv.dg.pt.cvx.core4
  let { SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { SWAP_EXISTS_THM, SWAP_FORALL_THM, UNWIND_THM2, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_NEG, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_MUL_EQ_0, VECTOR_SUB_LZERO, VECTOR_SUB_RZERO, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { INTERIOR_CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top4
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, new_definition, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { FINITE_PRODUCT_DEPENDENT, PSUBSET_ALT, .. } := D.dv.dg.pt.qses
  let { ITERATE_CLAUSES, monoidal, neutral, SELECT_UNIQUE, .. } := D.qsession
  let { EMPTY_AS_INTERVAL, .. } := D.qtopology
  let { DIST_TRIANGLE_HALF_L, INTER_INTERVAL, INTERVAL_EQ_EMPTY, MONOIDAL_VECTOR_ADD,
        NEUTRAL_VECTOR_ADD, VSUM_UNION_NONZERO, .. } := D.qvec
  let { cases, define, distinctness, injectivity, .. } := D
  -- @@SCOPE END

  let TAGGED_DIVISION_UNION_INTERVAL ← prove
   r"!a b:real^N p1 p2 c k.
        1 <= k /\ k <= dimindex(:N) /\
        p1 tagged_division_of (interval[a,b] INTER {x | x$k <= c}) /\
        p2 tagged_division_of (interval[a,b] INTER {x | x$k >= c})
        ==> (p1 UNION p2) tagged_division_of (interval[a,b])"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"interval[a,b] = (interval[a,b] INTER {x:real^N | x$k <= c}) UNION
                    (interval[a,b] INTER {x:real^N | x$k >= c})")
    SUBST1_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"(t UNION u = UNIV) ==> s = (s INTER t) UNION (s INTER u)")) THEN
      REWRITE_TAC [EXTENSION, IN_UNIV, IN_UNION, IN_ELIM_THM] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC TAGGED_DIVISION_UNION THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT, INTERIOR_CLOSED_INTERVAL] THEN
    REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_INTERVAL] THEN
    GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"k:num"))) THEN
      ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC)

  let HAS_INTEGRAL_SEPARATE_SIDES ← prove
   r"!f:real^M->real^N i a b k.
        (f has_integral i) (interval[a,b]) /\
        1 <= k /\ k <= dimindex(:M)
        ==> !e. &0 < e
                ==> ?d. gauge d /\
                        !p1 p2. p1 tagged_division_of
                                     (interval[a,b] INTER {x | x$k <= c}) /\
                                d fine p1 /\
                                p2 tagged_division_of
                                     (interval[a,b] INTER {x | x$k >= c}) /\
                                d fine p2
                                ==> norm((vsum p1 (\(x,k). content k % f x) +
                                          vsum p2 (\(x,k). content k % f x)) -
                                         i) < e"
   (REWRITE_TAC [has_integral] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"vsum p1 (\(x,k). content k % f x) + vsum p2 (\(x,k). content k % f x) =
    vsum (p1 UNION p2) (\(x,k:real^M->bool). content k % (f:real^M->real^N) x)")
    SUBST1_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [TAGGED_DIVISION_UNION_INTERVAL, FINE_UNION]] THEN
    CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_UNION_NONZERO THEN
    REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I
     [TAGGED_DIVISION_OF])) THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN
    REWRITE_TAC [IN_INTER, VECTOR_MUL_EQ_0] THEN STRIP_TAC THEN DISJ1_TAC THEN
    SUBGOAL_THEN
     (← q r"(?a b:real^M. l = interval[a,b]) /\
    l SUBSET (interval[a,b] INTER {x | x$k <= c}) /\
    l SUBSET (interval[a,b] INTER {x | x$k >= c})")
    MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [← SET_RULE
     (← q r"s SUBSET t /\ s SUBSET u <=> s SUBSET (t INTER u)")] THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT, INTER_INTERVAL] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SUBSET_INTERIOR) THEN
    REWRITE_TAC [INTERIOR_CLOSED_INTERVAL, CONTENT_EQ_0_INTERIOR] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"t = {} ==> s SUBSET t ==> s = {}")) THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY] THEN EXISTS_TAC (← q r"k:num") THEN
    ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC)

  let INTEGRABLE_SPLIT ← (do
    let lemma ← prove
     r"b - a = c
     ==> norm(a:real^N) < e / &2 ==> norm(b) < e / &2 ==> norm(c) < e"
     (DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [← GSYM dist] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC DIST_TRIANGLE_HALF_L THEN
      EXISTS_TAC (← q r"vec 0:real^N") THEN
      ASM_REWRITE_TAC [dist, VECTOR_SUB_LZERO, VECTOR_SUB_RZERO, NORM_NEG])
    prove
     r"!f:real^M->real^N a b.
        f integrable_on (interval[a,b]) /\ 1 <= k /\ k <= dimindex(:M)
        ==> f integrable_on (interval[a,b] INTER {x | x$k <= c}) /\
            f integrable_on (interval[a,b] INTER {x | x$k >= c})"
     (REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [integrable_on] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
      X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN CONJ_TAC THEN
      ASM_SIMP_TAC [INTERVAL_SPLIT, INTEGRABLE_CAUCHY] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"e / &2") o
        MATCH_MP HAS_INTEGRAL_SEPARATE_SIDES) THEN
      MAP_EVERY ABBREV_TAC
       [← q r"b' = (lambda i. if i = k then min ((b:real^M)$k) c else b$i):real^M",
        ← q r"a' = (lambda i. if i = k then max ((a:real^M)$k) c else a$i):real^M"] THEN
      ASM_SIMP_TAC [REAL_HALF, INTERVAL_SPLIT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FINE_DIVISION_EXISTS) THENL
       [DISCH_THEN (MP_TAC o SPECL [← q r"a':real^M", ← q r"b:real^M"]) THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE [SWAP_FORALL_THM]),
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b':real^M"])] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:(real^M#(real^M->bool))->bool")
        STRIP_ASSUME_TAC) THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPECL [← q r"p:(real^M#(real^M->bool))->bool",
                      ← q r"p1:(real^M#(real^M->bool))->bool"] th) THEN
              MP_TAC (← SPECL [← q r"p:(real^M#(real^M->bool))->bool",
                      ← q r"p2:(real^M#(real^M->bool))->bool"] th))) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC lemma THEN VECTOR_ARITH_TAC))

  let operative ← new_definition
   r"operative op (f:(real^N->bool)->A) <=>
    (!a b. content(interval[a,b]) = &0 ==> f(interval[a,b]) = neutral(op)) /\
    (!a b c k. 1 <= k /\ k <= dimindex(:N)
               ==> f(interval[a,b]) =
                   op (f(interval[a,b] INTER {x | x$k <= c}))
                      (f(interval[a,b] INTER {x | x$k >= c})))"

  let OPERATIVE_TRIVIAL ← prove
   r"!op f a b.
        operative op f /\ content(interval[a,b]) = &0
        ==> f(interval[a,b]) = neutral op"
   (REWRITE_TAC [operative] THEN MESON_TAC [])

  let PROPERTY_EMPTY_INTERVAL ← prove
   r"!P. (!a b:real^N. content(interval[a,b]) = &0 ==> P(interval[a,b]))
       ==> P {}"
   (MESON_TAC [EMPTY_AS_INTERVAL, CONTENT_EMPTY])

  let OPERATIVE_EMPTY ← prove
   r"!op f:(real^N->bool)->A. operative op f ==> f {} = neutral op"
   (REPEAT GEN_TAC THEN REWRITE_TAC [operative] THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP PROPERTY_EMPTY_INTERVAL o CONJUNCT1))

  let FORALL_OPTION ← prove
   r"(!x. P x) <=> P NONE /\ !x. P(SOME x)"
   (MESON_TAC [← cases "option"])

  let EXISTS_OPTION ← prove
   r"(?x. P x) <=> P NONE \/ ?x. P(SOME x)"
   (MESON_TAC [← cases "option"])

  let lifted ← define
   r"(lifted op NONE _ = NONE) /\
  (lifted op _ NONE = NONE) /\
  (lifted op (SOME x) (SOME y) = SOME(op x y))"

  let NEUTRAL_LIFTED ← prove
   r"!op. monoidal op ==> neutral(lifted op) = SOME(neutral op)"
   (REWRITE_TAC [neutral, monoidal] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SELECT_UNIQUE THEN
    REWRITE_TAC [FORALL_OPTION, lifted, ← distinctness "option",
                 ← injectivity "option"] THEN
    ASM_MESON_TAC [])

  let MONOIDAL_LIFTED ← prove
   r"!op. monoidal op ==> monoidal(lifted op)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [NEUTRAL_LIFTED, monoidal] THEN
    REWRITE_TAC [FORALL_OPTION, lifted, ← distinctness "option",
                 ← injectivity "option"] THEN
    ASM_MESON_TAC [monoidal])

  let ITERATE_SOME ← prove
   r"!op. monoidal op
        ==> !f s. FINITE s
                  ==> iterate (lifted op) s (\x. SOME(f x)) =
                      SOME(iterate op s f)"
   (GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_LIFTED, NEUTRAL_LIFTED] THEN
    REWRITE_TAC [lifted])

  let OPERATIVE_CONTENT ← prove
   r"operative(+) content"
   (REWRITE_TAC [operative, NEUTRAL_REAL_ADD, CONTENT_SPLIT])

  let OPERATIVE_INTEGRAL ← prove
   r"!f:real^M->real^N.
       operative(lifted(+))
         (\i. if f integrable_on i then SOME(integral i f) else NONE)"
   (SIMP_TAC [operative, NEUTRAL_LIFTED, MONOIDAL_VECTOR_ADD] THEN
    REWRITE_TAC [NEUTRAL_VECTOR_ADD] THEN
    REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    REWRITE_TAC [lifted, ← distinctness "option", ← injectivity "option"] THENL
     [REWRITE_TAC [integral] THEN ASM_MESON_TAC [HAS_INTEGRAL_NULL_EQ],
      RULE_ASSUM_TAC (REWRITE_RULE [integrable_on]) THEN
      ASM_MESON_TAC [HAS_INTEGRAL_NULL],
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL)) THEN
      ASM_MESON_TAC [HAS_INTEGRAL_SPLIT, HAS_INTEGRAL_UNIQUE],
      ASM_MESON_TAC [INTEGRABLE_SPLIT, integrable_on],
      ASM_MESON_TAC [INTEGRABLE_SPLIT],
      ASM_MESON_TAC [INTEGRABLE_SPLIT],
      RULE_ASSUM_TAC (REWRITE_RULE [integrable_on]) THEN
      ASM_MESON_TAC [HAS_INTEGRAL_SPLIT]])

  let division_points ← new_definition
   r"division_points (k:real^N->bool) (d:(real^N->bool)->bool) =
    {j,x | 1 <= j /\ j <= dimindex(:N) /\
           (interval_lowerbound k)$j < x /\ x < (interval_upperbound k)$j /\
           ?i. i IN d /\
               ((interval_lowerbound i)$j = x \/
                (interval_upperbound i)$j = x)}"

  let DIVISION_POINTS_FINITE ← prove
   r"!d i:real^N->bool. d division_of i ==> FINITE(division_points i d)"
   (REWRITE_TAC [division_of, division_points] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [CONJ_ASSOC, ← GSYM IN_NUMSEG] THEN
    REWRITE_TAC [IN, ← GSYM CONJ_ASSOC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IN] FINITE_PRODUCT_DEPENDENT) THEN
    REWRITE_TAC [ETA_AX, FINITE_NUMSEG] THEN
    X_GEN_TAC (← q r"j:num") THEN GEN_REWRITE_TAC LAND_CONV [← GSYM IN] THEN
    REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
     (← q r"IMAGE (\i:real^N->bool. (interval_lowerbound i)$j) d UNION
    IMAGE (\i:real^N->bool. (interval_upperbound i)$j) d") THEN
    ASM_SIMP_TAC [FINITE_UNION, FINITE_IMAGE] THEN
    REWRITE_TAC [SUBSET, IN_IMAGE, IN_UNION, IN_ELIM_THM] THEN MESON_TAC [IN])

  let DIVISION_POINTS_SUBSET ← prove
   r"!a b:real^N c d k.
        d division_of interval[a,b] /\
        (!i. 1 <= i /\ i <= dimindex(:N) ==> a$i < b$i) /\
        1 <= k /\ k <= dimindex(:N) /\ a$k < c /\ c < b$k
        ==> division_points (interval[a,b] INTER {x | x$k <= c})
                            {l INTER {x | x$k <= c} | l |
                             l IN d /\ ~(l INTER {x | x$k <= c} = {})}
            SUBSET division_points (interval[a,b]) d /\
            division_points (interval[a,b] INTER {x | x$k >= c})
                            {l INTER {x | x$k >= c} | l |
                             l IN d /\ ~(l INTER {x | x$k >= c} = {})}
            SUBSET division_points (interval[a,b]) d"
   (REPEAT STRIP_TAC THEN
    (REWRITE_TAC [SUBSET, division_points, FORALL_PAIR_THM] THEN
     MAP_EVERY X_GEN_TAC [← q r"j:num", ← q r"x:real"] THEN
     REWRITE_TAC [IN_ELIM_PAIR_THM] THEN REWRITE_TAC [IN_ELIM_THM] THEN
     ASM_SIMP_TAC [INTERVAL_SPLIT, INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND,
                   REAL_LT_IMP_LE] THEN
     ASM_SIMP_TAC [← REAL_ARITH (← q r"a < c ==> max a c = c"),
                   ← REAL_ARITH (← q r"c < b ==> min b c = c")] THEN
     REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
     ASM_SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND, LAMBDA_BETA,
       REAL_LT_IMP_LE, COND_ID,
       ← TAUT (← q r"(a <= if p then x else y) <=> (if p then a <= x else a <= y)"),
       ← TAUT (← q r"(if p then x else y) <= a <=> (if p then x <= a else y <= a)")] THEN
     REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
     DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
      [DISCH_THEN (K ALL_TAC) THEN REPEAT (POP_ASSUM MP_TAC) THEN
       COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
       ALL_TAC] THEN
     REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
     MATCH_MP_TAC MONO_EXISTS THEN
     ONCE_REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ c <=> b /\ a /\ c")] THEN
     REWRITE_TAC [UNWIND_THM2] THEN SIMP_TAC [← GSYM CONJ_ASSOC] THEN
     ONCE_REWRITE_TAC [IMP_CONJ] THEN
     FIRST_ASSUM (fun th => tactic_of do
       pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
     MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
     ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
     SUBGOAL_THEN
      (← q r"!i. 1 <= i /\ i <= dimindex(:N) ==> (u:real^N)$i <= (v:real^N)$i")
     ASSUME_TAC THENL
      [REWRITE_TAC [← GSYM INTERVAL_NE_EMPTY] THEN ASM_MESON_TAC [division_of],
       ALL_TAC] THEN
     REWRITE_TAC [INTERVAL_NE_EMPTY] THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
     ASM_SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND] THEN
     ASM_SIMP_TAC [LAMBDA_BETA] THEN REPEAT (POP_ASSUM MP_TAC) THEN
     COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC))

  let DIVISION_POINTS_PSUBSET ← prove
   r"!a b:real^N c d k.
        d division_of interval[a,b] /\
        (!i. 1 <= i /\ i <= dimindex(:N) ==> a$i < b$i) /\
        1 <= k /\ k <= dimindex(:N) /\ a$k < c /\ c < b$k /\
        (?l. l IN d /\
             (interval_lowerbound l$k = c \/ interval_upperbound l$k = c))
        ==> division_points (interval[a,b] INTER {x | x$k <= c})
                            {l INTER {x | x$k <= c} | l |
                             l IN d /\ ~(l INTER {x | x$k <= c} = {})}
            PSUBSET division_points (interval[a,b]) d /\
            division_points (interval[a,b] INTER {x | x$k >= c})
                            {l INTER {x | x$k >= c} | l |
                             l IN d /\ ~(l INTER {x | x$k >= c} = {})}
            PSUBSET division_points (interval[a,b]) d"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [PSUBSET_ALT, DIVISION_POINTS_SUBSET] THENL
     [EXISTS_TAC (← q r"k,(interval_lowerbound l:real^N)$k"),
      EXISTS_TAC (← q r"k,(interval_lowerbound l:real^N)$k"),
      EXISTS_TAC (← q r"k,(interval_upperbound l:real^N)$k"),
      EXISTS_TAC (← q r"k,(interval_upperbound l:real^N)$k")] THEN
    ASM_REWRITE_TAC [division_points, IN_ELIM_PAIR_THM] THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, REAL_LT_IMP_LE] THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT, INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND,
                  REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"a < c ==> max a c = c"),
                  ← REAL_ARITH (← q r"c < b ==> min b c = c")] THEN
    ASM_SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND, LAMBDA_BETA,
      REAL_LT_IMP_LE, COND_ID,
      ← TAUT (← q r"(a <= if p then x else y) <=> (if p then a <= x else a <= y)"),
      ← TAUT (← q r"(if p then x else y) <= a <=> (if p then x <= a else y <= a)")] THEN
    REWRITE_TAC [REAL_LT_REFL])

  pure { TAGGED_DIVISION_UNION_INTERVAL, HAS_INTEGRAL_SEPARATE_SIDES, INTEGRABLE_SPLIT,
         operative, OPERATIVE_TRIVIAL, PROPERTY_EMPTY_INTERVAL, OPERATIVE_EMPTY,
         FORALL_OPTION, EXISTS_OPTION, lifted, NEUTRAL_LIFTED, MONOIDAL_LIFTED,
         ITERATE_SOME, OPERATIVE_CONTENT, OPERATIVE_INTEGRAL, division_points,
         DIVISION_POINTS_FINITE, DIVISION_POINTS_SUBSET, DIVISION_POINTS_PSUBSET }

/- ------------------------------------------------------------------------- -/
/- Preservation by divisions; additivity of content; integral of a constant;-/
/- bounds on Riemann sums.  (integration.ml 3234-3621)                       -/
/- ------------------------------------------------------------------------- -/

structure INH where
  OPERATIVE_DIVISION : thm
  OPERATIVE_TAGGED_DIVISION : thm
  ADDITIVE_CONTENT_DIVISION : thm
  ADDITIVE_CONTENT_TAGGED_DIVISION : thm
  SUBADDITIVE_CONTENT_DIVISION : thm
  HAS_INTEGRAL_CONST : thm
  INTEGRABLE_CONST : thm
  INTEGRAL_CONST : thm
  INTEGRAL_PASTECART_CONST : thm
  DSUM_BOUND : thm
  RSUM_BOUND : thm
  RSUM_DIFF_BOUND : thm
  HAS_INTEGRAL_BOUND : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINH [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINF : INF) (BING : ING) : ExceptT String IO INH := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0, CONTENT_EQ_0_INTERIOR, CONTENT_LT_NZ, CONTENT_PASTECART,
        CONTENT_POS_LE, CONTENT_POS_LT_EQ, INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND,
        ITERATE_NONZERO_IMAGE_LEMMA, .. } := BINA
  let { DIVISION_OF, division_of, DIVISION_OF_CONTENT_0, DIVISION_OF_FINITE,
        DIVISION_OF_UNION_SELF, FORALL_IN_DIVISION, GAUGE_TRIVIAL,
        PARTIAL_DIVISION_EXTEND_INTERVAL, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, has_integral, integrable_on, TAG_IN_INTERVAL,
        TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { HAS_INTEGRAL_NULL_EQ, INTEGRAL_UNIQUE, .. } := BINE
  let { DIVISION_SPLIT, DIVISION_SPLIT_LEFT_INJ, DIVISION_SPLIT_RIGHT_INJ, INTERVAL_SPLIT,
        .. } := BINF
  let { division_points, DIVISION_POINTS_FINITE, DIVISION_POINTS_PSUBSET, operative,
        OPERATIVE_CONTENT, OPERATIVE_EMPTY, OPERATIVE_TRIVIAL, .. } := BING
  let { AND_FORALL_THM, CARD_PSUBSET, CART_EQ, CONTRAPOS_THM, EQ_TRANS, ETA_AX, EXTENSION,
        FINITE_DELETE, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DELETE, IN_DIFF,
        IN_ELIM_PAIR_THM, INTER_ACI, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IN_EMPTY, OR_EXISTS_THM, PAIR_EQ, REAL_ABS_POS,
        REAL_ABS_REFL, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_SYM, REAL_NOT_LT, REAL_SUB_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, sum, SUM_LE, SUM_LMUL, SUM_RMUL, SUM_SUBSET_SIMPLE, SWAP_FORALL_THM,
        UNIONS_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_COMPONENT, VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_SUB_LDISTRIB,
        VECTOR_SUB_REFL, VSUM_0, VSUM_SUB, VSUM_VMUL, .. } := D.dv.dg.pt.cvx.vec4
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, .. } :=
        D.dv.dg.pt.cvx
  let { WF_INDUCT_TAC, .. } := D.dv.dg.pt
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { NORM_TRIANGLE_SUB, .. } := D.dv.qvec
  let { CONS_11, ITERATE_CLAUSES, ITERATE_EQ, ITERATE_EQ_NEUTRAL, ITERATE_IMAGE_NONZERO,
        ITERATE_OP, LAMBDA_PAIR_THM, monoidal, MONOIDAL_REAL_ADD, .. } := D.qsession
  let { VSUM_NORM, .. } := D.qvec
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let OPERATIVE_DIVISION ← prove
   r"!op d a b f:(real^N->bool)->A.
    monoidal op /\ operative op f /\ d division_of interval[a,b]
    ==> iterate(op) d f = f(interval[a,b])"
   (REPEAT GEN_TAC THEN CONV_TAC (RAND_CONV SYM_CONV) THEN WF_INDUCT_TAC
     (← q r"CARD (division_points (interval[a,b]:real^N->bool) d)") THEN
    POP_ASSUM (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"content(interval[a:real^N,b]) = &0") THENL
     [SUBGOAL_THEN (← q r"iterate op d (f:(real^N->bool)->A) = neutral op")
       (fun th => ASM_MESON_TAC [th, operative]) THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
       ITERATE_EQ_NEUTRAL) THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      ASM_MESON_TAC [operative, DIVISION_OF_CONTENT_0],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM CONTENT_LT_NZ]) THEN
    REWRITE_TAC [CONTENT_POS_LT_EQ] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_CASES_TAC (← q r"division_points (interval[a,b]:real^N->bool) d = {}") THENL
     [DISCH_THEN (K ALL_TAC) THEN
      SUBGOAL_THEN
       (← q r"!i. i IN d
          ==> ?u v:real^N. i = interval[u,v] /\
                           !j. 1 <= j /\ j <= dimindex(:N)
                               ==> u$j = (a:real^N)$j /\ v$j = a$j \/
                                   u$j = (b:real^N)$j /\ v$j = b$j \/
                                   u$j = a$j /\ v$j = b$j")
      (LABEL_TAC "*") THENL
       [FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN REWRITE_TAC [] THEN
        REPEAT STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"interval[u:real^N,v]") o CONJUNCT1) THEN
        ASM_REWRITE_TAC [INTERVAL_NE_EMPTY] THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (ASSUME_TAC o CONJUNCT1)) THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL] THEN STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"a <= u /\ u <= v /\ v <= b /\ ~(a < u /\ u < b \/ a < v /\ v < b)
          ==> u = a /\ v = a \/ u = b /\ v = b \/ u = a /\ v = b")) THEN
        ASM_SIMP_TAC [] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [EXTENSION]) THEN
        REWRITE_TAC [division_points, NOT_IN_EMPTY, FORALL_PAIR_THM] THEN
        REWRITE_TAC [IN_ELIM_PAIR_THM] THEN DISCH_THEN (MP_TAC o SPEC (← q r"j:num")) THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
        REWRITE_TAC [NOT_EXISTS_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"interval[u:real^N,v]")) THEN
        ASM_SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND,
                      REAL_LT_IMP_LE] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"(u:real^N)$j") th) THEN
                MP_TAC (← SPEC (← q r"(v:real^N)$j") th))) THEN
        FIRST_X_ASSUM (DISJ_CASES_THEN MP_TAC) THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"interval[a:real^N,b] IN d") MP_TAC THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o lastc) THEN
        REWRITE_TAC [EXTENSION, IN_INTERVAL, IN_UNIONS] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"inv(&2) % (a + b:real^N)")) THEN
        MATCH_MP_TAC (← TAUT (← q r"b /\ (a ==> c) ==> (a <=> b) ==> c")) THEN
        CONJ_TAC THENL
         [SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
          X_GEN_TAC (← q r"j:num") THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
          REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"i:real^N->bool")
         (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"i:real^N->bool")) THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC) THEN
        SIMP_TAC [IN_INTERVAL, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
        REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
        REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c")] THEN
        ASM_SIMP_TAC [← REAL_ARITH
         (← q r"a < b
          ==> ((u = a /\ v = a \/ u = b /\ v = b \/ u = a /\ v = b) /\
               u <= inv(&2) * (a + b) /\ inv(&2) * (a +  b) <= v <=>
               u = a /\ v = b)")] THEN
        ASM_MESON_TAC [CART_EQ],
        ALL_TAC] THEN
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
      DISCH_THEN (SUBST1_TAC o MATCH_MP (← SET_RULE
       (← q r"a IN d ==> d = a INSERT (d DELETE a)"))) THEN
      ASM_SIMP_TAC [ITERATE_CLAUSES, FINITE_DELETE, IN_DELETE] THEN
      SUBGOAL_THEN
       (← q r"iterate op (d DELETE interval[a,b]) (f:(real^N->bool)->A) = neutral op")
       (fun th => ASM_MESON_TAC [th, monoidal]) THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
       ITERATE_EQ_NEUTRAL) THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"l:real^N->bool") THEN
      REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"content(l:real^N->bool) = &0")
       (fun th => ASM_MESON_TAC [th, operative]) THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"l:real^N->bool")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 SUBST_ALL_TAC MP_TAC) THEN
      UNDISCH_TAC (← q r"~(interval[u:real^N,v] = interval[a,b])") THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [] THEN DISCH_THEN (fun th => AP_TERM_TAC THEN MP_TAC th) THEN
      REWRITE_TAC [CONS_11, PAIR_EQ, CART_EQ, CONTENT_EQ_0] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
       [← TAUT (← q r"a ==> b <=> ~a \/ b")] THEN
      REWRITE_TAC [NOT_FORALL_THM, OR_EXISTS_THM] THEN
      REWRITE_TAC [NOT_EXISTS_THM, AND_FORALL_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"j:num") THEN
      ASM_CASES_TAC (← q r"1 <= j /\ j <= dimindex(:N)") THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [division_points] THEN
    REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"whatever:num#real", ← q r"k:num", ← q r"c:real"] THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, REAL_LT_IMP_LE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (K ALL_TAC)) THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"c:real",
                      ← q r"d:(real^N->bool)->bool", ← q r"k:num"]
                  DIVISION_POINTS_PSUBSET) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (CONJUNCTS_THEN
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] CARD_PSUBSET))) THEN
    MP_TAC (← ISPECL [← q r"d:(real^N->bool)->bool", ← q r"interval[a:real^N,b]",
                      ← q r"k:num", ← q r"c:real"]
        DIVISION_SPLIT) THEN
    ASM_SIMP_TAC [DIVISION_POINTS_FINITE] THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"a < c ==> max a c = c"),
                  ← REAL_ARITH (← q r"c < b ==> min b c = c")] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"d1:(real^N->bool)->bool =
     {l INTER {x | x$k <= c} | l | l IN d /\ ~(l INTER {x | x$k <= c} = {})}",
      ← q r"d2:(real^N->bool)->bool =
     {l INTER {x | x$k >= c} | l | l IN d /\ ~(l INTER {x | x$k >= c} = {})}",
      ← q r"cb:real^N = (lambda i. if i = k then c else (b:real^N)$i)",
      ← q r"ca:real^N = (lambda i. if i = k then c else (a:real^N)$i)"] THEN
    STRIP_TAC THEN STRIP_TAC THEN STRIP_TAC THEN DISCH_THEN (fun th => tactic_of do
     pure (MP_TAC (← SPECL [← q r"a:real^N", ← q r"cb:real^N",
                            ← q r"d1:(real^N->bool)->bool"] th) THEN
           MP_TAC (← SPECL [← q r"ca:real^N", ← q r"b:real^N",
                            ← q r"d2:(real^N->bool)->bool"] th))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"op (iterate op d1 (f:(real^N->bool)->A))
                 (iterate op d2 (f:(real^N->bool)->A))") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [operative]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"c:real",
                                  ← q r"k:num"]) THEN
      ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"a < c ==> max a c = c"),
                    ← REAL_ARITH (← q r"c < b ==> min b c = c")],
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC
     (← q r"op (iterate op d (\l. f(l INTER {x | x$k <= c}):A))
       (iterate op d (\l. f(l INTER {x:real^N | x$k >= c})))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [← GSYM ITERATE_OP] THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
       ITERATE_EQ) THEN
      ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION
       (← ASSUME (← q r"d division_of interval[a:real^N,b]"))] THEN
      ASM_MESON_TAC [operative]] THEN
    MAP_EVERY EXPAND_TAC ["d1", "d2"] THEN BINOP_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
    MATCH_MP_TAC ITERATE_NONZERO_IMAGE_LEMMA THEN ASM_REWRITE_TAC [] THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [OPERATIVE_EMPTY], ALL_TAC] THEN
     MAP_EVERY X_GEN_TAC [← q r"l:real^N->bool", ← q r"m:real^N->bool"] THEN STRIP_TAC THEN
     MATCH_MP_TAC (← MESON [OPERATIVE_TRIVIAL]
      (← q r"operative op f /\ (?a b. l = interval[a,b]) /\ content l = &0
       ==> f l = neutral op")) THEN
     ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
      [ALL_TAC, ASM_MESON_TAC [DIVISION_SPLIT_LEFT_INJ,
                                   DIVISION_SPLIT_RIGHT_INJ]] THEN
     SUBGOAL_THEN (← q r"?a b:real^N. m = interval[a,b]") STRIP_ASSUME_TAC THENL
      [ASM_MESON_TAC [division_of], ALL_TAC] THEN
     ASM_SIMP_TAC [INTERVAL_SPLIT] THEN MESON_TAC []))

  let OPERATIVE_TAGGED_DIVISION ← (do
    let lemma ← prove
     r"(\(x,l). f l) = (f o SND)"
     (REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM])
    prove
     r"!op d a b f:(real^N->bool)->A.
    monoidal op /\ operative op f /\ d tagged_division_of interval[a,b]
    ==> iterate(op) d (\(x,l). f l) = f(interval[a,b])"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"iterate op (IMAGE SND (d:(real^N#(real^N->bool)->bool))) f :A") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        ASM_MESON_TAC [DIVISION_OF_TAGGED_DIVISION, OPERATIVE_DIVISION]] THEN
      REWRITE_TAC [lemma] THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
                   ITERATE_IMAGE_NONZERO) THEN
      ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [TAGGED_DIVISION_OF_FINITE], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o CONJUNCT1 o CONJUNCT2)) THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN REWRITE_TAC [PAIR_EQ] THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_SIMP_TAC [INTER_ACI] THEN
      ASM_MESON_TAC [CONTENT_EQ_0_INTERIOR, OPERATIVE_TRIVIAL,
                     TAGGED_DIVISION_OF]))

  let ADDITIVE_CONTENT_DIVISION ← (do
    let mc ← CONJ MONOIDAL_REAL_ADD OPERATIVE_CONTENT
    let od ← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                  OPERATIVE_DIVISION
    let odm ← MATCH_MP od mc
    prove
     r"!d a b:real^N.
    d division_of interval[a,b]
    ==> sum d content = content(interval[a,b])"
     (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP odm) THEN
      REWRITE_TAC [sum]))

  let ADDITIVE_CONTENT_TAGGED_DIVISION ← (do
    let mc ← CONJ MONOIDAL_REAL_ADD OPERATIVE_CONTENT
    let od ← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                  OPERATIVE_TAGGED_DIVISION
    let odm ← MATCH_MP od mc
    prove
     r"!d a b:real^N.
    d tagged_division_of interval[a,b]
    ==> sum d (\(x,l). content l) = content(interval[a,b])"
     (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP odm) THEN
      REWRITE_TAC [sum]))

  let SUBADDITIVE_CONTENT_DIVISION ← prove
   r"!d s a b:real^M.
        d division_of s /\ s SUBSET interval[a,b]
        ==> sum d content <= content(interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"d:(real^M->bool)->bool", ← q r"a:real^M", ← q r"b:real^M"]
          PARTIAL_DIVISION_EXTEND_INTERVAL) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET] THEN
      ASM_MESON_TAC [division_of, DIVISION_OF_UNION_SELF, SUBSET_TRANS],
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum (p:(real^M->bool)->bool) content") THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
        ASM_MESON_TAC [division_of, CONTENT_POS_LE, IN_DIFF],
        ASM_MESON_TAC [ADDITIVE_CONTENT_DIVISION, REAL_LE_REFL]]])

  let HAS_INTEGRAL_CONST ← prove
   r"!a b:real^M c:real^N.
    ((\x. c) has_integral (content(interval[a,b]) % c)) (interval[a,b])"
   (REWRITE_TAC [has_integral] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x:real^M. ball(x,&1)") THEN REWRITE_TAC [GAUGE_TRIVIAL] THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP ADDITIVE_CONTENT_TAGGED_DIVISION th)])) THEN
    ASM_SIMP_TAC [VSUM_VMUL, ← GSYM VSUM_SUB] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM, VECTOR_SUB_REFL] THEN
    ASM_REWRITE_TAC [← GSYM LAMBDA_PAIR_THM, VSUM_0, NORM_0])

  let INTEGRABLE_CONST ← prove
   r"!a b:real^M c:real^N. (\x. c) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integrable_on] THEN
    EXISTS_TAC (← q r"content(interval[a:real^M,b]) % c:real^N") THEN
    REWRITE_TAC [HAS_INTEGRAL_CONST])

  let INTEGRAL_CONST ← prove
   r"!a b c. integral (interval[a,b]) (\x. c) = content(interval[a,b]) % c"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    REWRITE_TAC [HAS_INTEGRAL_CONST])

  let INTEGRAL_PASTECART_CONST ← prove
   r"!a b:real^M c d:real^N k:real^P.
     integral (interval[pastecart a c,pastecart b d]) (\x. k) =
     integral (interval[a,b])
              (\x. integral (interval[c,d]) (\y. k))"
   (REWRITE_TAC [INTEGRAL_CONST, CONTENT_PASTECART, VECTOR_MUL_ASSOC])

  let DSUM_BOUND ← prove
   r"!p a b:real^M c:real^N e.
       p division_of interval[a,b] /\ norm(c) <= e
       ==> norm(vsum p (\l. content l % c)) <= e * content(interval[a,b])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"y <= e ==> x <= y ==> x <= e")) THEN
    REWRITE_TAC [LAMBDA_PAIR_THM, NORM_MUL] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum p (\k:real^M->bool. content k * e)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
      X_GEN_TAC (← q r"l:real^M->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN SIMP_TAC [REAL_ABS_POS, NORM_POS_LE] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> abs(x) <= x")) THEN
      ASM_MESON_TAC [DIVISION_OF, CONTENT_POS_LE],
      REWRITE_TAC [SUM_RMUL, ETA_AX] THEN
      ASM_MESON_TAC [ADDITIVE_CONTENT_DIVISION, REAL_LE_REFL, REAL_MUL_SYM]])

  let RSUM_BOUND ← prove
   r"!p a b f:real^M->real^N e.
       p tagged_division_of interval[a,b] /\
       (!x. x IN interval[a,b] ==> norm(f x) <= e)
       ==> norm(vsum p (\(x,k). content k % f x))
            <= e * content(interval[a,b])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"y <= e ==> x <= y ==> x <= e")) THEN
    REWRITE_TAC [LAMBDA_PAIR_THM, NORM_MUL] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum p (\(x:real^M,k:real^M->bool). content k * e)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN SIMP_TAC [REAL_ABS_POS, NORM_POS_LE] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [TAGGED_DIVISION_OF, CONTENT_POS_LE, REAL_ABS_REFL,
                       REAL_LE_REFL],
        ASM_MESON_TAC [TAG_IN_INTERVAL]],
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← GSYM (← MATCH_MP ADDITIVE_CONTENT_TAGGED_DIVISION th)])) THEN
      REWRITE_TAC [← GSYM SUM_LMUL, LAMBDA_PAIR_THM] THEN
      REWRITE_TAC [REAL_MUL_AC, REAL_LE_REFL]])

  let RSUM_DIFF_BOUND ← prove
   r"!p a b f g:real^M->real^N.
       p tagged_division_of interval[a,b] /\
       (!x. x IN interval[a,b] ==> norm(f x - g x) <= e)
       ==> norm(vsum p (\(x,k). content k % f x) -
                vsum p (\(x,k). content k % g x))
           <= e * content(interval[a,b])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC
     (← q r"norm(vsum p (\(x,k).
      content(k:real^M->bool) % ((f:real^M->real^N) x - g x)))") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM VSUM_SUB, VECTOR_SUB_LDISTRIB] THEN
      REWRITE_TAC [LAMBDA_PAIR_THM, REAL_LE_REFL],
      ASM_SIMP_TAC [RSUM_BOUND]])

  let HAS_INTEGRAL_BOUND ← (do
    let lemma ← prove
     r"norm(s) <= B ==> ~(norm(s - i) < norm(i) - B)"
     (MATCH_MP_TAC (← REAL_ARITH (← q r"n1 <= n + n2 ==> n <= B ==> ~(n2 < n1 - B)")) THEN
      ONCE_REWRITE_TAC [NORM_SUB] THEN REWRITE_TAC [NORM_TRIANGLE_SUB])
    prove
     r"!f:real^M->real^N a b i B.
        &0 <= B /\
        (f has_integral i) (interval[a,b]) /\
        (!x. x IN interval[a,b] ==> norm(f x) <= B)
        ==> norm i <= B * content(interval[a,b])"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"&0 < content(interval[a:real^M,b])") THENL
       [ALL_TAC,
        SUBGOAL_THEN (← q r"i:real^N = vec 0") SUBST1_TAC THEN
        ASM_SIMP_TAC [REAL_LE_MUL, NORM_0, CONTENT_POS_LE] THEN
        ASM_MESON_TAC [HAS_INTEGRAL_NULL_EQ, CONTENT_LT_NZ]] THEN
      ONCE_REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [has_integral]) THEN
      DISCH_THEN (MP_TAC o SPEC
        (← q r"norm(i:real^N) - B * content(interval[a:real^M,b])")) THEN
      ASM_REWRITE_TAC [REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPECL [← q r"d:real^M->real^M->bool", ← q r"a:real^M", ← q r"b:real^M"]
            FINE_DIVISION_EXISTS) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN
       (X_CHOOSE_THEN (← q r"p:(real^M#(real^M->bool)->bool)") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool)->bool)")) THEN
      ASM_MESON_TAC [lemma, RSUM_BOUND]))

  pure { OPERATIVE_DIVISION, OPERATIVE_TAGGED_DIVISION, ADDITIVE_CONTENT_DIVISION,
         ADDITIVE_CONTENT_TAGGED_DIVISION, SUBADDITIVE_CONTENT_DIVISION, HAS_INTEGRAL_CONST,
         INTEGRABLE_CONST, INTEGRAL_CONST, INTEGRAL_PASTECART_CONST, DSUM_BOUND, RSUM_BOUND,
         RSUM_DIFF_BOUND, HAS_INTEGRAL_BOUND }

/- ------------------------------------------------------------------------- -/
/- Relationships among components; uniform limit of integrable functions.  -/
/- (integration.ml 3622-3960)                                                -/
/- ------------------------------------------------------------------------- -/

structure INI where
  RSUM_COMPONENT_LE : thm
  HAS_INTEGRAL_COMPONENT_LE : thm
  INTEGRAL_COMPONENT_LE : thm
  HAS_INTEGRAL_DROP_LE : thm
  INTEGRAL_DROP_LE : thm
  HAS_INTEGRAL_COMPONENT_POS : thm
  INTEGRAL_COMPONENT_POS : thm
  HAS_INTEGRAL_DROP_POS : thm
  INTEGRAL_DROP_POS : thm
  HAS_INTEGRAL_COMPONENT_NEG : thm
  HAS_INTEGRAL_DROP_NEG : thm
  HAS_INTEGRAL_COMPONENT_LBOUND : thm
  HAS_INTEGRAL_COMPONENT_UBOUND : thm
  INTEGRAL_COMPONENT_LBOUND : thm
  INTEGRAL_COMPONENT_UBOUND : thm
  INTEGRABLE_UNIFORM_LIMIT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINI [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINH : INH) : ExceptT String IO INI := do
  -- @@SCOPE BEGIN
  let { CONTENT_LT_NZ, CONTENT_POS_LE, .. } := BINA
  let { GAUGE_INTER, .. } := BINB
  let { FINE_INTER, has_integral, has_integral_alt, HAS_INTEGRAL_INTEGRAL,
        INTEGRABLE_INTEGRAL, integrable_on, TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE,
        .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_NULL, .. } := BINE
  let { HAS_INTEGRAL_CONST, RSUM_DIFF_BOUND, .. } := BINH
  let { ARITH, CONJ_ASSOC, DIMINDEX_1, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, GE, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { LAMBDA_BETA, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_EXISTS_THM, REAL_ADD_AC,
        REAL_ADD_RID, REAL_ARCH_INV, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ADD2, REAL_LE_INV2, REAL_LE_LMUL, REAL_LE_RADD,
        REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_AC, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_SUB_LT, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { SUM_LE, SWAP_FORALL_THM, UNION_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { NORM_SUB, NORM_TRIANGLE, NORM_TRIANGLE_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, VEC_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, .. } := D.dv.dg.pt.cvx.top1
  let { LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        NORM_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { BOUNDED_UNION, .. } := D.dv.dg.qtopology1
  let { CONVERGENT_EQ_CAUCHY, .. } := D.dv.qtopology1
  let { cauchy, .. } := D.dv.qtopology2
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, .. } := D.qtopology
  let { NORM_BOUND_COMPONENT_LE, VSUM_COMPONENT, .. } := D.qvec
  -- @@SCOPE END

  let RSUM_COMPONENT_LE ← prove
   r"!p a b f:real^M->real^N g:real^M->real^N.
       p tagged_division_of interval[a,b] /\ 1 <= i /\ i <= dimindex(:N) /\
       (!x. x IN interval[a,b] ==> (f x)$i <= (g x)$i)
       ==> vsum p (\(x,k). content k % f x)$i <=
           vsum p (\(x,k). content k % g x)$i"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [VSUM_COMPONENT] THEN
    MATCH_MP_TAC SUM_LE THEN
    ASM_SIMP_TAC [FORALL_PAIR_THM, VECTOR_MUL_COMPONENT] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
    ASM_MESON_TAC [SUBSET, REAL_LE_LMUL, CONTENT_POS_LE])

  let HAS_INTEGRAL_COMPONENT_LE ← prove
   r"!f:real^M->real^N g:real^M->real^N s i j k.
        1 <= k /\ k <= dimindex(:N) /\
        (f has_integral i) s /\ (g has_integral j) s /\
        (!x. x IN s ==> (f x)$k <= (g x)$k)
        ==> i$k <= j$k"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N g:real^M->real^N a b i j k.
        1 <= k /\ k <= dimindex(:N) /\
        (f has_integral i) (interval[a,b]) /\
        (g has_integral j) (interval[a,b]) /\
        (!x. x IN interval[a,b] ==> (f x)$k <= (g x)$k)
        ==> i$k <= j$k")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"~(&0 < i - j) ==> i <= j")) THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"((i:real^N)$k - (j:real^N)$k) / &3") o
         GEN_REWRITE_RULE I [has_integral])) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"?p. p tagged_division_of interval[a:real^M,b] /\
                      d1 fine p /\ d2 fine p")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM FINE_INTER] THEN MATCH_MP_TAC FINE_DIVISION_EXISTS THEN
        ASM_SIMP_TAC [GAUGE_INTER],
        ALL_TAC] THEN
      REPEAT
       (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^M#(real^M->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP REAL_LT_IMP_LE) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k:num") o MATCH_MP NORM_BOUND_COMPONENT_LE) THEN
        ASM_SIMP_TAC [VECTOR_SUB_COMPONENT]) THEN
      SUBGOAL_THEN
       (← q r"vsum p (\(x,l:real^M->bool). content l % (f:real^M->real^N) x)$k <=
      vsum p (\(x,l). content l % (g:real^M->real^N) x)$k")
      MP_TAC THENL
       [MATCH_MP_TAC RSUM_COMPONENT_LE THEN ASM_MESON_TAC [],
        UNDISCH_TAC (← q r"&0 < (i:real^N)$k - (j:real^N)$k") THEN
        SPEC_TAC (← q r"vsum p (\(x:real^M,l:real^M->bool).
                                content l % (f x):real^N)$k",
                 ← q r"fs:real") THEN
        SPEC_TAC (← q r"vsum p (\(x:real^M,l:real^M->bool).
                                content l % (g x):real^N)$k",
                 ← q r"gs:real") THEN
        REAL_ARITH_TAC],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"((i:real^N)$k - (j:real^N)$k) / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC
     (← q r"ball(vec 0,B1) UNION ball(vec 0:real^M,B2)")
     BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [BOUNDED_UNION, BOUNDED_BALL, UNION_SUBSET, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    DISCH_THEN (CONJUNCTS_THEN (ANTE_RES_THEN MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^N") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(z:real^N)$k <= (w:real^N)$k") MP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\x. if x IN s then f x else vec 0):real^M->real^N",
        ← q r"(\x. if x IN s then g x else vec 0):real^M->real^N",
        ← q r"a:real^M", ← q r"b:real^M"] THEN
      ASM_MESON_TAC [REAL_LE_REFL],
      MP_TAC (← ISPECL [← q r"w - j:real^N", ← q r"k:num"] COMPONENT_LE_NORM) THEN
      MP_TAC (← ISPECL [← q r"z - i:real^N", ← q r"k:num"] COMPONENT_LE_NORM) THEN
      ASM_REWRITE_TAC [] THEN
      SIMP_TAC [VECTOR_SUB_COMPONENT, ← ASSUME (← q r"1 <= k"),
                ← ASSUME (← q r"k <= dimindex(:N)")] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM REAL_NOT_LE])) THEN
      NORM_ARITH_TAC])

  let INTEGRAL_COMPONENT_LE ← prove
   r"!f:real^M->real^N g:real^M->real^N s k.
        1 <= k /\ k <= dimindex(:N) /\
        f integrable_on s /\ g integrable_on s /\
        (!x. x IN s ==> (f x)$k <= (g x)$k)
        ==> (integral s f)$k <= (integral s g)$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_DROP_LE ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s i j.
        (f has_integral i) s /\ (g has_integral j) s /\
        (!x. x IN s ==> drop(f x) <= drop(g x))
        ==> drop i <= drop j"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN ASM_MESON_TAC [])

  let INTEGRAL_DROP_LE ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s.
        f integrable_on s /\ g integrable_on s /\
        (!x. x IN s ==> drop(f x) <= drop(g x))
        ==> drop(integral s f) <= drop(integral s g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_DROP_LE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_COMPONENT_POS ← prove
   r"!f:real^M->real^N s i k.
        1 <= k /\ k <= dimindex(:N) /\
        (f has_integral i) s /\
        (!x. x IN s ==> &0 <= (f x)$k)
        ==> &0 <= i$k"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\x. vec 0):real^M->real^N", ← q r"f:real^M->real^N",
                      ← q r"s:real^M->bool", ← q r"vec 0:real^N",
                      ← q r"i:real^N", ← q r"k:num"] HAS_INTEGRAL_COMPONENT_LE) THEN
    ASM_SIMP_TAC [VEC_COMPONENT, HAS_INTEGRAL_0])

  let INTEGRAL_COMPONENT_POS ← prove
   r"!f:real^M->real^N s k.
        1 <= k /\ k <= dimindex(:N) /\
        f integrable_on s /\
        (!x. x IN s ==> &0 <= (f x)$k)
        ==> &0 <= (integral s f)$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_POS THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_DROP_POS ← prove
   r"!f:real^M->real^1 s i.
        (f has_integral i) s /\
        (!x. x IN s ==> &0 <= drop(f x))
        ==> &0 <= drop i"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_POS THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN ASM_MESON_TAC [])

  let INTEGRAL_DROP_POS ← prove
   r"!f:real^M->real^1 s.
        f integrable_on s /\
        (!x. x IN s ==> &0 <= drop(f x))
        ==> &0 <= drop(integral s f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_DROP_POS THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_COMPONENT_NEG ← prove
   r"!f:real^M->real^N s i k.
        1 <= k /\ k <= dimindex(:N) /\
        (f has_integral i) s /\
        (!x. x IN s ==> (f x)$k <= &0)
        ==> i$k <= &0"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(\x. vec 0):real^M->real^N",
                      ← q r"s:real^M->bool", ← q r"i:real^N", ← q r"vec 0:real^N",
                      ← q r"k:num"] HAS_INTEGRAL_COMPONENT_LE) THEN
    ASM_SIMP_TAC [VEC_COMPONENT, HAS_INTEGRAL_0])

  let HAS_INTEGRAL_DROP_NEG ← prove
   r"!f:real^M->real^1 s i.
        (f has_integral i) s /\
        (!x. x IN s ==> drop(f x) <= &0)
        ==> drop i <= &0"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_NEG THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN ASM_MESON_TAC [])

  let HAS_INTEGRAL_COMPONENT_LBOUND ← prove
   r"!f:real^M->real^N a b i k.
        (f has_integral i) (interval[a,b]) /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> B <= f(x)$k)
        ==> B * content(interval[a,b]) <= i$k"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(\x. lambda i. B):real^M->real^N", ← q r"f:real^M->real^N",
                      ← q r"interval[a:real^M,b]",
                      ← q r"content(interval[a:real^M,b]) % (lambda i. B):real^N",
                      ← q r"i:real^N", ← q r"k:num"]
                  HAS_INTEGRAL_COMPONENT_LE) THEN
    ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, LAMBDA_BETA, HAS_INTEGRAL_CONST] THEN
    REWRITE_TAC [REAL_MUL_AC])

  let HAS_INTEGRAL_COMPONENT_UBOUND ← prove
   r"!f:real^M->real^N a b i k.
        (f has_integral i) (interval[a,b]) /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> f(x)$k <= B)
        ==> i$k <= B * content(interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(\x. lambda i. B):real^M->real^N",
                      ← q r"interval[a:real^M,b]", ← q r"i:real^N",
                      ← q r"content(interval[a:real^M,b]) % (lambda i. B):real^N",
                      ← q r"k:num"]
                  HAS_INTEGRAL_COMPONENT_LE) THEN
    ASM_SIMP_TAC [VECTOR_MUL_COMPONENT, LAMBDA_BETA, HAS_INTEGRAL_CONST] THEN
    REWRITE_TAC [REAL_MUL_AC])

  let INTEGRAL_COMPONENT_LBOUND ← prove
   r"!f:real^M->real^N a b k.
        f integrable_on interval[a,b] /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> B <= f(x)$k)
        ==> B * content(interval[a,b]) <= (integral(interval[a,b]) f)$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LBOUND THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let INTEGRAL_COMPONENT_UBOUND ← prove
   r"!f:real^M->real^N a b k.
        f integrable_on interval[a,b] /\ 1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN interval[a,b] ==> f(x)$k <= B)
        ==> (integral(interval[a,b]) f)$k <= B * content(interval[a,b])"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_UBOUND THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let INTEGRABLE_UNIFORM_LIMIT ← (do
    let lemma ← prove
     r"x <= norm(a + b) + c ==> x <= norm(a) + norm(b) + c"
     (MESON_TAC [REAL_ADD_AC, NORM_TRIANGLE, REAL_LE_TRANS, REAL_LE_RADD])
    let (lemma1, lemma2) ← CONJ_PAIR (← prove
     r"(norm(s2 - s1) <= e / &2 /\
      norm(s1 - i1) < e / &4 /\ norm(s2 - i2) < e / &4
      ==> norm(i1 - i2) < e) /\
     (norm(sf - sg) <= e / &3
      ==> norm(i - s) < e / &3 ==> norm(sg - i) < e / &3 ==> norm(sf - s) < e)"
     (CONJ_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC] THEN
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV o ONCE_DEPTH_CONV) [NORM_SUB] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"w <= x + y + z + &0
          ==> (x <= e / &2 /\ y < e / &4) /\ z < e / &4 ==> w < e")),
        MATCH_MP_TAC (← REAL_ARITH
        (← q r"w <= x + y + z + &0
        ==> x <= e / &3 ==> y < e / &3 ==> z < e / &3 ==> w < e"))] THEN
      REPEAT (MATCH_MP_TAC lemma) THEN REWRITE_TAC [REAL_ADD_RID] THEN
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN VECTOR_ARITH_TAC))
    let n12 ← ARITH_RULE (← q r"N1:num <= N1 + N2")
    prove
     r"!f a b. (!e. &0 < e
                ==> ?g. (!x. x IN interval[a,b] ==> norm(f x - g x) <= e) /\
                        g integrable_on interval[a,b] )
           ==> (f:real^M->real^N) integrable_on interval[a,b]"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"&0 < content(interval[a:real^M,b])") THENL
       [ALL_TAC,
        ASM_MESON_TAC [HAS_INTEGRAL_NULL, CONTENT_LT_NZ, integrable_on]] THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [FORALL_AND_THM, SKOLEM_THM, integrable_on] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:num->real^M->real^N") (CONJUNCTS_THEN2
       ASSUME_TAC (X_CHOOSE_TAC (← q r"i:num->real^N")))) THEN
      SUBGOAL_THEN (← q r"cauchy(i:num->real^N)") MP_TAC THENL
       [REWRITE_TAC [cauchy] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← SPEC (← q r"e / &4 / content(interval[a:real^M,b])")
            REAL_ARCH_INV) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN REWRITE_TAC [GE] THEN
        STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [has_integral]) THEN
        ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"m:num") th) THEN
                MP_TAC (← SPEC (← q r"n:num") th))) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"gn:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"gm:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"(\x. gm(x) INTER gn(x)):real^M->real^M->bool",
                          ← q r"a:real^M", ← q r"b:real^M"] FINE_DIVISION_EXISTS) THEN
        ASM_SIMP_TAC [GAUGE_INTER, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"p:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool))->bool"))) THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← CONV_RULE (REWR_CONV FINE_INTER) th])) THEN
        SUBGOAL_THEN (← q r"norm(vsum p (\(x,k:real^M->bool). content k % g (n:num) x) -
                       vsum p (\(x:real^M,k). content k % g m x :real^N))
                  <= e / &2")
        MP_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [dist] THEN MESON_TAC [lemma1]] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"&2 / &N * content(interval[a:real^M,b])") THEN CONJ_TAC THENL
         [MATCH_MP_TAC RSUM_DIFF_BOUND,
          ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
          ASM_REAL_ARITH_TAC] THEN
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (MP_TAC (← SPECL [← q r"n:num", ← q r"x:real^M"] th) THEN
                MP_TAC (← SPECL [← q r"m:num", ← q r"x:real^M"] th))) THEN
        ASM_REWRITE_TAC [IMP_IMP] THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV) [NORM_SUB] THEN
        DISCH_THEN (MP_TAC o MATCH_MP REAL_LE_ADD2) THEN
        DISCH_THEN (MP_TAC o MATCH_MP NORM_TRIANGLE_LE) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"u = v /\ a <= inv(x) /\ b <= inv(x) ==>
                                u <= a + b ==> v <= &2 / x")) THEN
        CONJ_TAC THENL [AP_TERM_TAC THEN VECTOR_ARITH_TAC, ALL_TAC] THEN
        CONJ_TAC THEN MATCH_MP_TAC REAL_LE_INV2 THEN
        REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"s:real^N") THEN DISCH_TAC THEN
      REWRITE_TAC [has_integral] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3") o GEN_REWRITE_RULE I
       [LIM_SEQUENTIALLY]) THEN
      ASM_SIMP_TAC [dist, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N1:num")) THEN
      MP_TAC (← SPEC (← q r"e / &3 / content(interval[a:real^M,b])") REAL_ARCH_INV) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [has_integral]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"N1 + N2:num", ← q r"e / &3"]) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^M->real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^M#(real^M->bool)->bool")) THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o (fun th => MATCH_MP th n12)) THEN
      MATCH_MP_TAC lemma2 THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"inv(&(N1 + N2) + &1) * content(interval[a:real^M,b])") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC RSUM_DIFF_BOUND THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < a ==> y <= x ==> y <= a"))) THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC))

  pure { RSUM_COMPONENT_LE, HAS_INTEGRAL_COMPONENT_LE, INTEGRAL_COMPONENT_LE,
         HAS_INTEGRAL_DROP_LE, INTEGRAL_DROP_LE, HAS_INTEGRAL_COMPONENT_POS,
         INTEGRAL_COMPONENT_POS, HAS_INTEGRAL_DROP_POS, INTEGRAL_DROP_POS,
         HAS_INTEGRAL_COMPONENT_NEG, HAS_INTEGRAL_DROP_NEG, HAS_INTEGRAL_COMPONENT_LBOUND,
         HAS_INTEGRAL_COMPONENT_UBOUND, INTEGRAL_COMPONENT_LBOUND, INTEGRAL_COMPONENT_UBOUND,
         INTEGRABLE_UNIFORM_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Negligible sets; negligibility of a hyperplane; refinement of divisions. -/
/- (integration.ml 3961-4276)                                                -/
/- ------------------------------------------------------------------------- -/

structure INJ where
  negligible : thm
  VSUM_NONZERO_IMAGE_LEMMA : thm
  INTERVAL_DOUBLESPLIT : thm
  DIVISION_DOUBLESPLIT : thm
  CONTENT_DOUBLESPLIT : thm
  NEGLIGIBLE_STANDARD_HYPERPLANE : thm
  TAGGED_DIVISION_FINER : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINJ [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINF : INF) (BINH : INH) : ExceptT String IO INJ := do
  -- @@SCOPE BEGIN
  let { content, CONTENT_EMPTY, CONTENT_EQ_0, CONTENT_EQ_0_INTERIOR, CONTENT_POS_LE,
        CONTENT_SUBSET, INTER_INTERIOR_UNIONS_INTERVALS, INTERVAL_LOWERBOUND,
        INTERVAL_UPPERBOUND, ITERATE_NONZERO_IMAGE_LEMMA, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION, GAUGE_BALL, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, fine, FINE_UNION, has_integral, TAGGED_DIVISION_OF,
        tagged_division_of, TAGGED_DIVISION_OF_EMPTY, TAGGED_DIVISION_OF_FINITE,
        TAGGED_DIVISION_OF_SELF, TAGGED_DIVISION_UNION, tagged_partial_division_of,
        TAGGED_PARTIAL_DIVISION_SUBSET, VSUM_OVER_TAGGED_DIVISION_LEMMA, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { DIVISION_SPLIT, INTERVAL_SPLIT, .. } := BINF
  let { DSUM_BOUND, .. } := BINH
  let { ARITH, CONJ_ASSOC, DIMINDEX_1, EQ_IMP, EXISTS_PAIR_THM, EXTENSION, FINITE_DELETE,
        FINITE_IMAGE, FINITE_INDEX_INRANGE, FINITE_INDUCT_STRONG, FINITE_INSERT,
        FINITE_NUMSEG, FINITE_SUBSET, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, IMP_CONJ, IMP_IMP, IN_DELETE, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIONS,
        LAMBDA_BETA, LE_REFL, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, NOT_EXISTS_THM,
        NOT_IN_EMPTY, PAIR_EQ, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_RDIV_EQ, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, REAL_OF_NUM_LT, REAL_SUB_LT, RIGHT_FORALL_IMP_THM,
        SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, SUM_LE, SUM_POS_LE, SWAP_EXISTS_THM, UNWIND_THM2, .. } :=
        D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_VEC, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VEC_COMPONENT, VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_SUB_COMPONENT, VECTOR_SUB_RZERO, VSUM_EQ, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_BALL, INTERIOR_CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, new_definition, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D.dv.dg.pt.cvx
  let { PRODUCT_EQ, PRODUCT_POS_LT, .. } := D.qproducts
  let { LAMBDA_PAIR_THM, PRODUCT_CLAUSES, .. } := D.qsession
  let { DROP_INDICATOR_LE_1, DROP_INDICATOR_POS_LE, indicator, MONOIDAL_VECTOR_ADD,
        NEUTRAL_VECTOR_ADD, NORM_REAL, VSUM, VSUM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let negligible ← new_definition
   r"negligible s <=> !a b. (indicator s has_integral (vec 0)) (interval[a,b])"

  let VSUM_NONZERO_IMAGE_LEMMA ← prove
   r"!s f:A->B g:B->real^N a.
        FINITE s /\ g(a) = vec 0 /\
        (!x y. x IN s /\ y IN s /\ f x = f y /\ ~(x = y) ==> g(f x) = vec 0)
       ==> vsum {f x |x| x IN s /\ ~(f x = a)} g =
           vsum s (g o f)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"FINITE {(f:A->B) x |x| x IN s /\ ~(f x = a)}")
    ASSUME_TAC THENL
     [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"IMAGE (f:A->B) s") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, SUBSET, IN_IMAGE, IN_ELIM_THM] THEN MESON_TAC [],
      ASM_SIMP_TAC [VSUM] THEN MATCH_MP_TAC ITERATE_NONZERO_IMAGE_LEMMA THEN
      ASM_REWRITE_TAC [NEUTRAL_VECTOR_ADD, MONOIDAL_VECTOR_ADD]])

  let INTERVAL_DOUBLESPLIT ← prove
   r"1 <= k /\ k <= dimindex(:N)
      ==> interval[a,b] INTER {x:real^N | abs(x$k - c) <= e} =
          interval[(lambda i. if i = k then max (a$k) (c - e) else a$i),
                   (lambda i. if i = k then min (b$k) (c + e) else b$i)]"
   (REWRITE_TAC [← REAL_ARITH (← q r"abs(x - c) <= e <=> x >= c - e /\ x <= c + e")] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x /\ Q x} =
                        (s INTER {x | Q x}) INTER {x | P x}")] THEN
    SIMP_TAC [INTERVAL_SPLIT])

  let DIVISION_DOUBLESPLIT ← prove
   r"!p a b:real^N k c e.
        p division_of interval[a,b] /\ 1 <= k /\ k <= dimindex(:N)
        ==> {l INTER {x | abs(x$k - c) <= e} |l|
                l IN p /\ ~(l INTER {x | abs(x$k - c) <= e} = {})}
            division_of (interval[a,b] INTER {x | abs(x$k - c) <= e})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"c + e:real") o MATCH_MP DIVISION_SPLIT) THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
    FIRST_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← TAUT
     (← q r"(a /\ b /\ c) /\ d ==> d /\ b /\ c"))) THEN
    DISCH_THEN (MP_TAC o CONJUNCT2 o SPEC (← q r"c - e:real") o
      MATCH_MP DIVISION_SPLIT) THEN
    ASM_SIMP_TAC [INTERVAL_DOUBLESPLIT, INTERVAL_SPLIT] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(x - c) <= e <=> x >= c - e /\ x <= c + e")] THEN
    GEN_REWRITE_TAC I [EXTENSION] THEN REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
    GEN_TAC THEN REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c /\ d <=> c /\ a /\ b /\ d")] THEN
    REWRITE_TAC [UNWIND_THM2] THEN AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let CONTENT_DOUBLESPLIT ← prove
   r"!a b:real^N k c e.
        &0 < e /\ 1 <= k /\ k <= dimindex(:N)
        ==> ?d. &0 < d /\
                content(interval[a,b] INTER {x | abs(x$k - c) <= d}) < e"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"content(interval[a:real^N,b]) = &0") THENL
     [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"content(interval[a:real^N,b])") THEN
      CONJ_TAC THENL [FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SYM), ASM_REWRITE_TAC []] THEN
      ASM_SIMP_TAC [INTERVAL_DOUBLESPLIT] THEN MATCH_MP_TAC CONTENT_SUBSET THEN
      ASM_SIMP_TAC [← GSYM INTERVAL_DOUBLESPLIT] THEN SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CONTENT_EQ_0]) THEN
    REWRITE_TAC [NOT_EXISTS_THM, ← TAUT (← q r"~(a /\ b /\ c) <=> a /\ b ==> ~c")] THEN
    REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"&0 < product ((1..dimindex (:N)) DELETE k)
                              (\i. (b:real^N)$i - (a:real^N)$i)")
    ASSUME_TAC THENL
     [MATCH_MP_TAC PRODUCT_POS_LT THEN
      ASM_SIMP_TAC [FINITE_DELETE, FINITE_NUMSEG, IN_DELETE, IN_NUMSEG,
                    REAL_SUB_LT],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"d = e / &3 / product ((1..dimindex (:N)) DELETE k)
                                   (\i. (b:real^N)$i - (a:real^N)$i)") THEN
    EXISTS_TAC (← q r"d:real") THEN SUBGOAL_THEN (← q r"&0 < d") ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN MATCH_MP_TAC REAL_LT_DIV THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH],
      ALL_TAC] THEN
    ASM_SIMP_TAC [content, INTERVAL_DOUBLESPLIT] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE I [INTERVAL_NE_EMPTY]) THEN
    SUBGOAL_THEN (← q r"1..dimindex(:N) = k INSERT ((1..dimindex(:N)) DELETE k)")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_INSERT, IN_DELETE, IN_NUMSEG] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SIMP_TAC [PRODUCT_CLAUSES, FINITE_NUMSEG, FINITE_DELETE, IN_DELETE] THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, REAL_LT_IMP_LE,
                  LAMBDA_BETA, IN_DELETE, IN_NUMSEG] THEN
    SUBGOAL_THEN
     (← q r"product ((1..dimindex (:N)) DELETE k)
     (\j. ((lambda i. if i = k then min (b$k) (c + d) else b$i):real^N)$j -
          ((lambda i. if i = k then max (a$k) (c - d) else a$i):real^N)$j) =
    product ((1..dimindex (:N)) DELETE k)
            (\i. (b:real^N)$i - (a:real^N)$i)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC PRODUCT_EQ THEN
      SIMP_TAC [IN_DELETE, IN_NUMSEG, LAMBDA_BETA],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"&2 * d") THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < d /\ &3 * d <= x ==> &2 * d < x")) THEN
    ASM_REWRITE_TAC [] THEN EXPAND_TAC "d" THEN REAL_ARITH_TAC)

  let NEGLIGIBLE_STANDARD_HYPERPLANE ← prove
   r"!c k. negligible {x:real^N | x$k = c}"
   (MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"i:num"] THEN
    SUBGOAL_THEN (← q r"?k. 1 <= k /\ k <= dimindex(:N) /\ !x:real^N. x$i = x$k")
    (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THENL
     [ASM_REWRITE_TAC [FINITE_INDEX_INRANGE], ASM_REWRITE_TAC []] THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"x:real^N")) THEN
    REWRITE_TAC [negligible, has_integral] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_SUB_RZERO] THEN
    MP_TAC (← ISPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"k:num", ← q r"c:real",
                      ← q r"e:real"]
          CONTENT_DOUBLESPLIT) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\x:real^N. ball(x,d)") THEN ASM_SIMP_TAC [GAUGE_BALL] THEN
    ABBREV_TAC (← q r"i = indicator {x:real^N | x$k = c}") THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"vsum p (\(x,l). content l % i x) =
    vsum p (\(x,l). content(l INTER {x:real^N | abs(x$k - c) <= d}) %
                    (i:real^N->real^1) x)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC VSUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"l:real^N->bool"] THEN
      DISCH_TAC THEN EXPAND_TAC "i" THEN REWRITE_TAC [indicator] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_MUL_RZERO] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"l:real^N->bool"]) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> l SUBSET s ==> l = l INTER t")) THEN
      REWRITE_TAC [SUBSET, IN_BALL, IN_ELIM_THM, dist] THEN
      UNDISCH_THEN (← q r"(x:real^N)$k = c") (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC [← GSYM VECTOR_SUB_COMPONENT] THEN
      ONCE_REWRITE_TAC [NORM_SUB] THEN
      ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
     (← q r"norm(vsum p (\(x:real^N,l).
          content(l INTER {x:real^N | abs(x$k - c) <= d}) %
         vec 1:real^1))") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      ASM_SIMP_TAC [VSUM_REAL, NORM_LIFT] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= y ==> abs(x) <= abs(y)")) THEN
      REWRITE_TAC [o_DEF, LAMBDA_PAIR_THM, DROP_CMUL] THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUM_POS_LE, MATCH_MP_TAC SUM_LE] THEN
      ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"l:real^N->bool"] THEN STRIP_TAC THENL
       [MATCH_MP_TAC REAL_LE_MUL, MATCH_MP_TAC REAL_LE_LMUL] THEN
      EXPAND_TAC "i" THEN REWRITE_TAC [DROP_VEC] THEN
      REWRITE_TAC [DROP_INDICATOR_POS_LE, DROP_INDICATOR_LE_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^N", ← q r"l:real^N->bool"] o
          elc 1) THEN
      ASM_REWRITE_TAC [] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [INTERVAL_DOUBLESPLIT, CONTENT_POS_LE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(\l. content (l INTER {x | abs (x$k - c) <= d}) % vec 1):
                  (real^N->bool)->real^1",
                      ← q r"p:real^N#(real^N->bool)->bool",
                      ← q r"interval[a:real^N,b]"]
          VSUM_OVER_TAGGED_DIVISION_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN STRIP_TAC THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ1_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"!x. x = &0 /\ &0 <= y /\ y <= x ==> y = &0")) THEN
      EXISTS_TAC (← q r"content(interval[u:real^N,v])") THEN
      CONJ_TAC THEN POP_ASSUM MP_TAC THEN REWRITE_TAC [] THEN
      DISCH_THEN (K ALL_TAC) THEN
      ASM_SIMP_TAC [CONTENT_POS_LE, INTERVAL_DOUBLESPLIT] THEN
      MATCH_MP_TAC CONTENT_SUBSET THEN
      ASM_SIMP_TAC [← GSYM INTERVAL_DOUBLESPLIT] THEN SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    MP_TAC (← ISPECL
       [← q r"IMAGE SND (p:real^N#(real^N->bool)->bool)",
        ← q r"\l. l INTER {x:real^N | abs (x$k - c) <= d}",
        ← q r"\l:real^N->bool. content l % vec 1 :real^1",
        ← q r"{}:real^N->bool"] VSUM_NONZERO_IMAGE_LEMMA) THEN
      REWRITE_TAC [o_DEF] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_TAGGED_DIVISION) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_FINITE], ALL_TAC] THEN
      REWRITE_TAC [CONTENT_EMPTY, VECTOR_MUL_LZERO] THEN
      ONCE_REWRITE_TAC [IMP_CONJ] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^N", ← q r"v:real^N"] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"m:real^N->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ1_TAC THEN
      SIMP_TAC [INTERVAL_DOUBLESPLIT, ← ASSUME (← q r"1 <= k"),
                ← ASSUME (← q r"k <= dimindex(:N)")] THEN
      REWRITE_TAC [CONTENT_EQ_0_INTERIOR] THEN
      ASM_SIMP_TAC [← GSYM INTERVAL_DOUBLESPLIT] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"interval[u:real^N,v]", ← q r"m:real^N->bool"] o
        elc 2) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE
        (← q r"u SUBSET s /\ u SUBSET t ==> s INTER t = {} ==> u = {}")) THEN
      CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [o_DEF] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC
     (← q r"&1 * content(interval[a,b] INTER {x:real^N | abs (x$k - c) <= d})") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [REAL_MUL_LID]] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      DIVISION_DOUBLESPLIT)) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"k:num", ← q r"c:real", ← q r"d:real"]) THEN
    ASM_SIMP_TAC [INTERVAL_DOUBLESPLIT] THEN DISCH_TAC THEN
    MATCH_MP_TAC DSUM_BOUND THEN
    ASM_SIMP_TAC [NORM_REAL, VEC_COMPONENT, DIMINDEX_1, LE_REFL] THEN
    REAL_ARITH_TAC)

  let TAGGED_DIVISION_FINER ← (do
    let lemma1 ← prove
     r"{k | ?x. (x,k) IN p} = IMAGE SND p"
     (REWRITE_TAC [EXTENSION, EXISTS_PAIR_THM, IN_IMAGE, IN_ELIM_THM] THEN
      MESON_TAC [])
    prove
     r"!p a b:real^N d. p tagged_division_of interval[a,b] /\ gauge d
             ==> ?q. q tagged_division_of interval[a,b] /\ d fine q /\
                     !x k. (x,k) IN p /\ k SUBSET d(x) ==> (x,k) IN q"
     (SUBGOAL_THEN
       (← q r"!a b:real^N d p.
       FINITE p
       ==> p tagged_partial_division_of interval[a,b] /\ gauge d
           ==> ?q. q tagged_division_of (UNIONS {k | ?x. x,k IN p}) /\
                   d fine q /\
                   !x k. (x,k) IN p /\ k SUBSET d(x) ==> (x,k) IN q")
      ASSUME_TAC THENL
       [ALL_TAC,
        REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        GEN_REWRITE_TAC LAND_CONV [tagged_division_of] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (SUBST1_TAC o SYM)) THEN
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [IMP_IMP]) THEN
        ASM_MESON_TAC [tagged_partial_division_of]] THEN
      GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
       [DISCH_THEN (K ALL_TAC) THEN
        REWRITE_TAC [← SET_RULE (← q r"UNIONS {k | ?x. x,k IN {}} = {}")] THEN
        EXISTS_TAC (← q r"{}:real^N#(real^N->bool)->bool") THEN
        REWRITE_TAC [fine, NOT_IN_EMPTY, TAGGED_DIVISION_OF_EMPTY],
        ALL_TAC] THEN
      GEN_REWRITE_TAC I [FORALL_PAIR_THM] THEN MAP_EVERY X_GEN_TAC
       [← q r"x:real^N", ← q r"k:real^N->bool", ← q r"p:real^N#(real^N->bool)->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC TAGGED_PARTIAL_DIVISION_SUBSET THEN
        EXISTS_TAC (← q r"(x:real^N,k:real^N->bool) INSERT p") THEN ASM SET_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q1:real^N#(real^N->bool)->bool")
        STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"UNIONS {l:real^N->bool | ?y:real^N. (y,l) IN (x,k) INSERT p} =
    k UNION UNIONS {l | ?y. (y,l) IN p}")
      SUBST1_TAC THENL
       [GEN_REWRITE_TAC I [EXTENSION] THEN REWRITE_TAC [IN_UNION, IN_UNIONS] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_INSERT, PAIR_EQ] THEN MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"?u v:real^N. k = interval[u,v]") MP_TAC THENL
       [ASM_MESON_TAC [IN_INSERT, tagged_partial_division_of], ALL_TAC] THEN
      DISCH_THEN (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
      ASM_CASES_TAC (← q r"interval[u,v] SUBSET ((d:real^N->real^N->bool) x)") THENL
       [EXISTS_TAC (← q r"{(x:real^N,interval[u:real^N,v])} UNION q1") THEN CONJ_TAC THENL
         [MATCH_MP_TAC TAGGED_DIVISION_UNION THEN ASM_REWRITE_TAC [] THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC TAGGED_DIVISION_OF_SELF THEN
            FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
             [tagged_partial_division_of]) THEN
            REWRITE_TAC [IN_INSERT, PAIR_EQ] THEN MESON_TAC [],
            ALL_TAC],
          CONJ_TAC THENL
           [MATCH_MP_TAC FINE_UNION THEN ASM_REWRITE_TAC [] THEN
            REWRITE_TAC [fine, IN_SING, PAIR_EQ] THEN ASM_MESON_TAC [],
            ALL_TAC] THEN
          ASM_REWRITE_TAC [IN_INSERT, PAIR_EQ, IN_UNION, IN_SING] THEN
          ASM_MESON_TAC []],
        FIRST_ASSUM (MP_TAC o SPECL [← q r"u:real^N", ← q r"v:real^N"] o MATCH_MP
          FINE_DIVISION_EXISTS) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"q2:real^N#(real^N->bool)->bool")
          STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"q2 UNION q1:real^N#(real^N->bool)->bool") THEN CONJ_TAC THENL
         [MATCH_MP_TAC TAGGED_DIVISION_UNION THEN ASM_REWRITE_TAC [],
          ASM_SIMP_TAC [FINE_UNION] THEN
          ASM_REWRITE_TAC [IN_INSERT, PAIR_EQ, IN_UNION, IN_SING] THEN
          ASM_MESON_TAC []]] THEN
      (MATCH_MP_TAC INTER_INTERIOR_UNIONS_INTERVALS THEN
       REWRITE_TAC [lemma1, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
          [tagged_partial_division_of]) THEN
       REWRITE_TAC [IN_INSERT, FINITE_INSERT, PAIR_EQ] THEN
       STRIP_TAC THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN CONJ_TAC THENL
        [REWRITE_TAC [INTERIOR_CLOSED_INTERVAL, OPEN_INTERVAL], ALL_TAC] THEN
       CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_MESON_TAC [])))

  pure { negligible, VSUM_NONZERO_IMAGE_LEMMA, INTERVAL_DOUBLESPLIT, DIVISION_DOUBLESPLIT,
         CONTENT_DOUBLESPLIT, NEGLIGIBLE_STANDARD_HYPERPLANE, TAGGED_DIVISION_FINER }

/- ------------------------------------------------------------------------- -/
/- The main theorem about negligible sets; spike theorems; negligible-set   -/
/- trivialities; the frontier of an interval.  (integration.ml 4277-4682)    -/
/- ------------------------------------------------------------------------- -/

structure INK where
  HAS_INTEGRAL_NEGLIGIBLE : thm
  HAS_INTEGRAL_ON_NEGLIGIBLE : thm
  INTEGRABLE_ON_NEGLIGIBLE : thm
  INTEGRAL_ON_NEGLIGIBLE : thm
  HAS_INTEGRAL_SPIKE : thm
  HAS_INTEGRAL_SPIKE_EQ : thm
  INTEGRABLE_SPIKE : thm
  INTEGRABLE_SPIKE_EQ : thm
  INTEGRAL_SPIKE : thm
  NEGLIGIBLE_SUBSET : thm
  NEGLIGIBLE_DIFF : thm
  NEGLIGIBLE_INTER : thm
  NEGLIGIBLE_UNION : thm
  NEGLIGIBLE_UNION_EQ : thm
  NEGLIGIBLE_SING : thm
  NEGLIGIBLE_INSERT : thm
  NEGLIGIBLE_EMPTY : thm
  NEGLIGIBLE_FINITE : thm
  NEGLIGIBLE_UNIONS : thm
  NEGLIGIBLE : thm
  HAS_INTEGRAL_SPIKE_FINITE : thm
  HAS_INTEGRAL_SPIKE_FINITE_EQ : thm
  INTEGRABLE_SPIKE_FINITE : thm
  INTEGRAL_EQ : thm
  INTEGRAL_EQ_0 : thm
  NEGLIGIBLE_FRONTIER_INTERVAL : thm
  HAS_INTEGRAL_SPIKE_INTERIOR : thm
  HAS_INTEGRAL_SPIKE_INTERIOR_EQ : thm
  INTEGRABLE_SPIKE_INTERIOR : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINK [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINJ : INJ) : ExceptT String IO INK := do
  -- @@SCOPE BEGIN
  let { CONTENT_POS_LE, .. } := BINA
  let { gauge, .. } := BINB
  let { fine, has_integral, has_integral_alt, integrable_on, integral, TAGGED_DIVISION_OF,
        TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_ADD, HAS_INTEGRAL_EQ, INTEGRAL_0, INTEGRAL_UNIQUE, .. }
        := BINE
  let { negligible, NEGLIGIBLE_STANDARD_HYPERPLANE, TAGGED_DIVISION_FINER, .. } := BINJ
  let { AND_FORALL_THM, ARITH, DIMINDEX_GE_1, EMPTY_SUBSET, EQ_IMP, EQ_TRANS, ETA_AX,
        EXISTS_IN_IMAGE, EXISTS_PAIR_THM, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_NUMSEG,
        FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMAGE_EQ_EMPTY, IMP_CONJ, IN_DIFF,
        IN_ELIM_PAIR_THM, INTER_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNION, IN_UNIONS, LE_REFL,
        LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP, REAL_ARCH_SIMPLE,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_INV_EQ,
        REAL_LT_LE, REAL_LT_MUL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POW_INV, REAL_POW_LT, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_DIFF, SUBSET_UNION, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, real_div, SUM_LE_NUMSEG, SUM_LMUL, SUM_POS_LE, UNIONS_0,
        UNIONS_INSERT, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_VEC, IN_INTERVAL, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_LID, VECTOR_MUL_RZERO, VECTOR_SUB_EQ, VECTOR_SUB_REFL, VECTOR_SUB_RZERO,
        VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { FINITE_PRODUCT_DEPENDENT, NUM_OF_INT_OF_NUM, .. } := D.dv.dg.pt.qses
  let { LE_0, LT, .. } := D.dv.dg.qsession
  let { FLOOR, FLOOR_POS, .. } := D.qfloor
  let { SUM_GP, .. } := D.qmisc
  let { int_of_num, LAMBDA_PAIR_THM, REAL_MUL_POS_LT, REAL_SUP_LE_FINITE, SUM_LE_INCLUDED,
        SUM_SUM_PRODUCT, .. } := D.qsession
  let { DROP_INDICATOR_POS_LE, indicator, VSUM_NORM, VSUM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let HAS_INTEGRAL_NEGLIGIBLE ← (do
    let lemma ← prove
     r"!f:B->real g:A#B->real s t.
          FINITE s /\ FINITE t /\
          (!x y. (x,y) IN t ==> &0 <= g(x,y)) /\
          (!y. y IN s ==> ?x. (x,y) IN t /\ f(y) <= g(x,y))
          ==> sum s f <= sum t g"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_LE_INCLUDED THEN
      EXISTS_TAC (← q r"SND:A#B->B") THEN
      REWRITE_TAC [EXISTS_PAIR_THM, FORALL_PAIR_THM] THEN
      ASM_MESON_TAC [])
    prove
     r"!f:real^M->real^N s t.
        negligible s /\ (!x. x IN (t DIFF s) ==> f x = vec 0)
        ==> (f has_integral (vec 0)) t"
     (SUBGOAL_THEN
       (← q r"!f:real^M->real^N s a b.
        negligible s /\ (!x. ~(x IN s) ==> f x = vec 0)
        ==> (f has_integral (vec 0)) (interval[a,b])")
      ASSUME_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
        ONCE_REWRITE_TAC [has_integral_alt] THEN COND_CASES_TAC THENL
         [MATCH_MP_TAC HAS_INTEGRAL_EQ THEN
          EXISTS_TAC (← q r"\x. if x IN t then (f:real^M->real^N) x else vec 0") THEN
          SIMP_TAC [] THEN
          FIRST_X_ASSUM (CHOOSE_THEN (CHOOSE_THEN SUBST_ALL_TAC)) THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [],
          ALL_TAC] THEN
        GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"&1") THEN
        REWRITE_TAC [REAL_LT_01] THEN
        REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"vec 0:real^N") THEN
        ASM_REWRITE_TAC [NORM_0, VECTOR_SUB_REFL] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_MESON_TAC []] THEN
      REWRITE_TAC [negligible, has_integral, RIGHT_FORALL_IMP_THM] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      MAP_EVERY (fun t => MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC t)
       [← q r"a:real^M", ← q r"b:real^M"] THEN
      REWRITE_TAC [VECTOR_SUB_RZERO] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o
          SPEC (← q r"e / &2 / ((&n + &1) * &2 pow n)")) THEN
      REWRITE_TAC [real_div, REAL_MUL_POS_LT] THEN REWRITE_TAC [← GSYM real_div] THEN
      ASM_SIMP_TAC [REAL_LT_INV_EQ, REAL_LT_MUL, REAL_POW_LT, REAL_OF_NUM_LT,
               FORALL_AND_THM, ARITH, ← REAL_ARITH (← q r"&0 < &n + &1"), SKOLEM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:num->real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. (d:num->real^M->real^M->bool)
                  (num_of_int(int_of_real(floor(norm(f x:real^N))))) x") THEN
      CONJ_TAC THENL [REWRITE_TAC [gauge] THEN ASM_MESON_TAC [gauge], ALL_TAC] THEN
      X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      ASM_CASES_TAC (← q r"p:real^M#(real^M->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [VSUM_CLAUSES, NORM_0] THEN
      MP_TAC (← SPEC (← q r"sup(IMAGE (\(x,k:real^M->bool). norm((f:real^M->real^N) x)) p)")
        REAL_ARCH_SIMPLE) THEN
      ASM_SIMP_TAC [REAL_SUP_LE_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
      MP_TAC (← GEN (← q r"i:num")
       (← ISPECL [← q r"p:real^M#(real^M->bool)->bool", ← q r"a:real^M", ← q r"b:real^M",
                  ← q r"(d:num->real^M->real^M->bool) i"]
                    TAGGED_DIVISION_FINER)) THEN
      ASM_REWRITE_TAC [SKOLEM_THM, RIGHT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->real^M#(real^M->bool)->bool")
            STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
       (← q r"sum(0..N+1) (\i. (&i + &1) *
                     norm(vsum (q i) (\(x:real^M,k:real^M->bool).
                                            content k % indicator s x)))") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"sum (0..N+1) (\i. e / &2 / &2 pow i)") THEN CONJ_TAC THENL
         [ALL_TAC,
          REWRITE_TAC [real_div, SUM_LMUL, ← GSYM REAL_POW_INV] THEN
          REWRITE_TAC [SUM_GP, LT] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          REWRITE_TAC [← REAL_ARITH (← q r"(e * &1 / &2) * (&1 - x) / (&1 / &2) < e <=>
                                &0 < e * x")] THEN
          ASM_SIMP_TAC [REAL_LT_MUL, REAL_POW_LT, ← REAL_ARITH (← q r"&0 < &1 / &2")]] THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        REWRITE_TAC [real_div] THEN ONCE_REWRITE_TAC [← GSYM REAL_MUL_ASSOC] THEN
        REWRITE_TAC [← GSYM REAL_INV_MUL] THEN REWRITE_TAC [← GSYM real_div] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC []] THEN
      FIRST_ASSUM (ASSUME_TAC o GEN (← q r"i:num") o
        MATCH_MP TAGGED_DIVISION_OF_FINITE o SPEC (← q r"i:num")) THEN
      ASM_SIMP_TAC [VSUM_REAL, NORM_LIFT] THEN
      REWRITE_TAC [o_DEF, LAMBDA_PAIR_THM, DROP_CMUL] THEN
      REWRITE_TAC [real_abs] THEN
      SUBGOAL_THEN
       (← q r"!i:num. &0 <= sum (q i) (\(x:real^M,y:real^M->bool).
              content y * drop (indicator s x))")
      ASSUME_TAC THENL
       [REPEAT GEN_TAC THEN MATCH_MP_TAC SUM_POS_LE THEN
        ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_MUL THEN
        REWRITE_TAC [DROP_INDICATOR_POS_LE] THEN
        ASM_MESON_TAC [TAGGED_DIVISION_OF, CONTENT_POS_LE],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [← GSYM SUM_LMUL] THEN
      REWRITE_TAC [LAMBDA_PAIR_THM] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> n <= x ==> n <= y")) THEN
      ASM_SIMP_TAC [SUM_SUM_PRODUCT, FINITE_NUMSEG] THEN
      MATCH_MP_TAC lemma THEN
      ASM_SIMP_TAC [FINITE_PRODUCT_DEPENDENT, FORALL_PAIR_THM, FINITE_NUMSEG] THEN
      REWRITE_TAC [IN_ELIM_PAIR_THM] THEN CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, MATCH_MP_TAC REAL_LE_MUL] THEN
        REWRITE_TAC [DROP_INDICATOR_POS_LE] THEN
        ASM_MESON_TAC [TAGGED_DIVISION_OF, CONTENT_POS_LE],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"k:real^M->bool"]) THEN
      ASM_REWRITE_TAC [] THEN ABBREV_TAC
       (← q r"n = num_of_int(int_of_real(floor(norm((f:real^M->real^N) x))))") THEN
      SUBGOAL_THEN (← q r"&n <= norm((f:real^M->real^N) x) /\
                norm(f x) < &n + &1")
      STRIP_ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"&n = floor(norm((f:real^M->real^N) x))")
         (fun th => MESON_TAC [th, FLOOR]) THEN
        EXPAND_TAC "n" THEN
        MP_TAC (← ISPEC (← q r"norm((f:real^M->real^N) x)") FLOOR_POS) THEN
        REWRITE_TAC [NORM_POS_LE, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"m:num") THEN DISCH_THEN SUBST1_TAC THEN
        REWRITE_TAC [← GSYM int_of_num, NUM_OF_INT_OF_NUM],
        ALL_TAC] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"n:num") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [IN_NUMSEG, LE_0] THEN
        REWRITE_TAC [← GSYM REAL_OF_NUM_LE, ← GSYM REAL_OF_NUM_ADD] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"norm((f:real^M->real^N) x)") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= n ==> x <= n + &1")) THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"(x:real^M) IN s") THEN ASM_SIMP_TAC [indicator] THEN
      REWRITE_TAC [DROP_VEC, REAL_MUL_RZERO, NORM_0,
                   VECTOR_MUL_RZERO, REAL_LE_REFL] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [DROP_VEC, REAL_MUL_RID, NORM_MUL] THEN
      SUBGOAL_THEN (← q r"&0 <= content(k:real^M->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [TAGGED_DIVISION_OF, CONTENT_POS_LE], ALL_TAC] THEN
      ASM_REWRITE_TAC [real_abs] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE]))

  let HAS_INTEGRAL_ON_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s. negligible s ==> (f has_integral vec 0) s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM SET_TAC [])

  let INTEGRABLE_ON_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s. negligible s ==> f integrable_on s"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_ON_NEGLIGIBLE])

  let INTEGRAL_ON_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s. negligible s ==> integral s f = vec 0"
   (MESON_TAC [HAS_INTEGRAL_ON_NEGLIGIBLE, INTEGRAL_UNIQUE])

  let HAS_INTEGRAL_SPIKE ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x) /\
        (f has_integral y) t
        ==> (g has_integral y) t"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N g s a b y.
        negligible s /\ (!x. x IN (interval[a,b] DIFF s) ==> g x = f x)
        ==> (f has_integral y) (interval[a,b])
            ==> (g has_integral y) (interval[a,b])")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"((\x. (f:real^M->real^N)(x) + (g(x) - f(x))) has_integral (y + vec 0))
      (interval[a,b])")
      MP_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [← VECTOR_ARITH (← q r"f + g - f = g /\ f + vec 0 = f"), ETA_AX]] THEN
      MATCH_MP_TAC HAS_INTEGRAL_ADD THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [VECTOR_SUB_EQ] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ONCE_REWRITE_TAC [has_integral_alt] THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [] THENL
     [FIRST_X_ASSUM (CHOOSE_THEN (CHOOSE_THEN SUBST_ALL_TAC)) THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"s:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let HAS_INTEGRAL_SPIKE_EQ ← prove
   r"!f:real^M->real^N g s t y.
        negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> ((f has_integral y) t <=> (g has_integral y) t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"), EXISTS_TAC (← q r"g:real^M->real^N")] THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [NORM_SUB])

  let INTEGRABLE_SPIKE ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> f integrable_on t ==> g integrable_on  t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_INTEGRAL_SPIKE) THEN ASM_REWRITE_TAC [])

  let INTEGRABLE_SPIKE_EQ ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN t DIFF s ==> g x = f x)
        ==> (f integrable_on t <=> g integrable_on t)"
   (MESON_TAC [INTEGRABLE_SPIKE])

  let INTEGRAL_SPIKE ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> integral t f = integral t g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integral] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ THEN
    ASM_MESON_TAC [])

  let NEGLIGIBLE_SUBSET ← prove
   r"!s:real^N->bool t:real^N->bool.
        negligible s /\ t SUBSET s ==> negligible t"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [negligible] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    MAP_EVERY EXISTS_TAC [← q r"(\x. vec 0):real^N->real^1", ← q r"s:real^N->bool"] THEN
    ASM_REWRITE_TAC [HAS_INTEGRAL_0] THEN
    REWRITE_TAC [indicator] THEN ASM SET_TAC [])

  let NEGLIGIBLE_DIFF ← prove
   r"!s t:real^N->bool. negligible s ==> negligible(s DIFF t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [SUBSET_DIFF])

  let NEGLIGIBLE_INTER ← prove
   r"!s t. negligible s \/ negligible t ==> negligible(s INTER t)"
   (MESON_TAC [NEGLIGIBLE_SUBSET, INTER_SUBSET])

  let NEGLIGIBLE_UNION ← prove
   r"!s t:real^N->bool.
        negligible s /\ negligible t ==> negligible (s UNION t)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM MP_TAC THEN
    REWRITE_TAC [negligible, AND_FORALL_THM] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:real^N") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"b:real^N") THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_ADD) THEN
    REWRITE_TAC [VECTOR_ADD_LID] THEN MATCH_MP_TAC EQ_IMP THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ THEN
    EXISTS_TAC (← q r"s:real^N->bool") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [indicator, IN_UNION, IN_DIFF, VECTOR_ADD_LID])

  let NEGLIGIBLE_UNION_EQ ← prove
   r"!s t:real^N->bool.
        negligible (s UNION t) <=> negligible s /\ negligible t"
   (MESON_TAC [NEGLIGIBLE_UNION, SUBSET_UNION, NEGLIGIBLE_SUBSET])

  let NEGLIGIBLE_SING ← prove
   r"!a:real^N. negligible {a}"
   (GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"{x | (x:real^N)$1 = (a:real^N)$1}") THEN
    SIMP_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE, LE_REFL, DIMINDEX_GE_1] THEN
    SET_TAC [])

  let NEGLIGIBLE_INSERT ← prove
   r"!a:real^N s. negligible(a INSERT s) <=> negligible s"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"a INSERT s = {a} UNION s")] THEN
    REWRITE_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_SING])

  let NEGLIGIBLE_EMPTY ← prove
   r"negligible {}"
   (MESON_TAC [EMPTY_SUBSET, NEGLIGIBLE_SUBSET, NEGLIGIBLE_SING])

  let NEGLIGIBLE_FINITE ← prove
   r"!s. FINITE s ==> negligible s"
   (MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT])

  let NEGLIGIBLE_UNIONS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> negligible t)
       ==> negligible(UNIONS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, UNIONS_INSERT, NEGLIGIBLE_EMPTY, IN_INSERT] THEN
    SIMP_TAC [NEGLIGIBLE_UNION])

  let NEGLIGIBLE ← prove
   r"!s:real^N->bool. negligible s <=> !t. (indicator s has_integral vec 0) t"
   (GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, REWRITE_TAC [negligible] THEN SIMP_TAC []] THEN
    DISCH_TAC THEN GEN_TAC THEN ONCE_REWRITE_TAC [has_integral_alt] THEN
    COND_CASES_TAC THENL [ASM_MESON_TAC [negligible], ALL_TAC] THEN
    GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"vec 0:real^1") THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"s INTER t:real^N->bool"]
          NEGLIGIBLE_SUBSET) THEN
    ASM_REWRITE_TAC [INTER_SUBSET, negligible, VECTOR_SUB_REFL, NORM_0] THEN
    REWRITE_TAC [indicator, IN_INTER] THEN
    SIMP_TAC [← TAUT (← q r"(if p /\ q then r else s) =
                 (if q then if p then r else s else s)")])

  let HAS_INTEGRAL_SPIKE_FINITE ← prove
   r"!f:real^M->real^N g s t y.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x) /\
        (f has_integral y) t
        ==> (g has_integral y) t"
   (MESON_TAC [HAS_INTEGRAL_SPIKE, NEGLIGIBLE_FINITE])

  let HAS_INTEGRAL_SPIKE_FINITE_EQ ← prove
   r"!f:real^M->real^N g s y.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> ((f has_integral y) t <=> (g has_integral y) t)"
   (MESON_TAC [HAS_INTEGRAL_SPIKE_FINITE])

  let INTEGRABLE_SPIKE_FINITE ← prove
   r"!f:real^M->real^N g s.
        FINITE s /\ (!x. x IN (t DIFF s) ==> g x = f x)
        ==> f integrable_on t
            ==> g integrable_on  t"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_INTEGRAL_SPIKE_FINITE) THEN ASM_REWRITE_TAC [])

  let INTEGRAL_EQ ← prove
   r"!f:real^M->real^N g s.
        (!x. x IN s ==> f x = g x) ==> integral s f = integral s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE THEN
    EXISTS_TAC (← q r"{}:real^M->bool") THEN ASM_SIMP_TAC [NEGLIGIBLE_EMPTY, IN_DIFF])

  let INTEGRAL_EQ_0 ← prove
   r"!f:real^M->real^N s. (!x. x IN s ==> f x = vec 0) ==> integral s f = vec 0"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"integral s ((\x. vec 0):real^M->real^N)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_EQ THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [INTEGRAL_0]])

  let NEGLIGIBLE_FRONTIER_INTERVAL ← prove
   r"!a b:real^N. negligible(interval[a,b] DIFF interval(a,b))"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE (\k. {x:real^N | x$k = (a:real^N)$k} UNION
                                 {x:real^N | x$k = (b:real^N)$k})
                            (1..dimindex(:N)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, FORALL_IN_IMAGE] THEN
      SIMP_TAC [IN_NUMSEG, NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_STANDARD_HYPERPLANE],
      REWRITE_TAC [SUBSET, IN_DIFF, IN_INTERVAL, IN_UNIONS, EXISTS_IN_IMAGE] THEN
      REWRITE_TAC [IN_NUMSEG, IN_UNION, IN_ELIM_THM, REAL_LT_LE] THEN
      MESON_TAC []])

  let HAS_INTEGRAL_SPIKE_INTERIOR ← prove
   r"!f:real^M->real^N g a b y.
        (!x. x IN interval(a,b) ==> g x = f x) /\
        (f has_integral y) (interval[a,b])
        ==> (g has_integral y) (interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                             HAS_INTEGRAL_SPIKE) THEN
    EXISTS_TAC (← q r"interval[a:real^M,b] DIFF interval(a,b)") THEN
    REWRITE_TAC [NEGLIGIBLE_FRONTIER_INTERVAL] THEN ASM SET_TAC [])

  let HAS_INTEGRAL_SPIKE_INTERIOR_EQ ← prove
   r"!f:real^M->real^N g a b y.
        (!x. x IN interval(a,b) ==> g x = f x)
        ==> ((f has_integral y) (interval[a,b]) <=>
             (g has_integral y) (interval[a,b]))"
   (MESON_TAC [HAS_INTEGRAL_SPIKE_INTERIOR])

  let INTEGRABLE_SPIKE_INTERIOR ← prove
   r"!f:real^M->real^N g a b.
        (!x. x IN interval(a,b) ==> g x = f x)
        ==> f integrable_on (interval[a,b])
            ==> g integrable_on  (interval[a,b])"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [integrable_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MP_TAC (← SPEC_ALL HAS_INTEGRAL_SPIKE_INTERIOR) THEN ASM_REWRITE_TAC [])

  pure { HAS_INTEGRAL_NEGLIGIBLE, HAS_INTEGRAL_ON_NEGLIGIBLE, INTEGRABLE_ON_NEGLIGIBLE,
         INTEGRAL_ON_NEGLIGIBLE, HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_SPIKE_EQ, INTEGRABLE_SPIKE,
         INTEGRABLE_SPIKE_EQ, INTEGRAL_SPIKE, NEGLIGIBLE_SUBSET, NEGLIGIBLE_DIFF,
         NEGLIGIBLE_INTER, NEGLIGIBLE_UNION, NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_SING,
         NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY, NEGLIGIBLE_FINITE, NEGLIGIBLE_UNIONS, NEGLIGIBLE,
         HAS_INTEGRAL_SPIKE_FINITE, HAS_INTEGRAL_SPIKE_FINITE_EQ, INTEGRABLE_SPIKE_FINITE,
         INTEGRAL_EQ, INTEGRAL_EQ_0, NEGLIGIBLE_FRONTIER_INTERVAL, HAS_INTEGRAL_SPIKE_INTERIOR,
         HAS_INTEGRAL_SPIKE_INTERIOR_EQ, INTEGRABLE_SPIKE_INTERIOR }

/- ------------------------------------------------------------------------- -/
/- Integrability of continuous functions; additivity in one dimension;      -/
/- content factoring; gauge modification; subintervals; combining adjacent  -/
/- intervals; local integrability.  (integration.ml 4683-5124)               -/
/- ------------------------------------------------------------------------- -/

structure INL where
  NEUTRAL_AND : thm
  MONOIDAL_AND : thm
  ITERATE_AND : thm
  OPERATIVE_DIVISION_AND : thm
  OPERATIVE_APPROXIMABLE : thm
  APPROXIMABLE_ON_DIVISION : thm
  INTEGRABLE_CONTINUOUS : thm
  OPERATIVE_1_LT : thm
  OPERATIVE_1_LE : thm
  ADDITIVE_DIVISION_1 : thm
  ADDITIVE_TAGGED_DIVISION_1 : thm
  HAS_INTEGRAL_FACTOR_CONTENT : thm
  GAUGE_MODIFY : thm
  OPERATIVE_INTEGRABLE : thm
  INTEGRABLE_SUBINTERVAL : thm
  HAS_INTEGRAL_COMBINE : thm
  INTEGRAL_COMBINE : thm
  INTEGRABLE_COMBINE : thm
  INTEGRABLE_ON_LITTLE_SUBINTERVALS : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINL [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINF : INF) (BING : ING) (BINH : INH) (BINI : INI) (BINJ : INJ) (BINK : INK) : ExceptT String IO INL := do
  let { FORALL_BOOL_THM, .. } := D.qsession
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_1, CONTENT_LT_NZ, INTERVAL_LOWERBOUND_1,
        INTERVAL_UPPERBOUND_1, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, gauge, GAUGE_BALL, GAUGE_BALL_DEPENDENT,
        GAUGE_EXISTENCE_LEMMA, GAUGE_TRIVIAL, PARTIAL_DIVISION_EXTEND_1, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, fine, has_integral, INTEGRABLE_INTEGRAL, integrable_on,
        TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, VSUM_CONTENT_NULL, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { HAS_INTEGRAL_NULL, HAS_INTEGRAL_NULL_EQ, HAS_INTEGRAL_UNIQUE, INTEGRAL_UNIQUE, .. }
        := BINE
  let { HAS_INTEGRAL_SPLIT, INTERVAL_SPLIT, .. } := BINF
  let { INTEGRABLE_SPLIT, lifted, MONOIDAL_LIFTED, operative, OPERATIVE_INTEGRAL, .. } :=
        BING
  let { HAS_INTEGRAL_CONST, OPERATIVE_DIVISION, OPERATIVE_TAGGED_DIVISION, .. } := BINH
  let { INTEGRABLE_UNIFORM_LIMIT, .. } := BINI
  let { NEGLIGIBLE_STANDARD_HYPERPLANE, .. } := BINJ
  let { INTEGRABLE_SPIKE, .. } := BINK
  let { AND_FORALL_THM, ARITH, CART_EQ, COND_ID, CONJ_ACI, DIMINDEX_1, EQ_IMP, EQ_SYM_EQ,
        EXTENSION, FINITE_INDUCT_STRONG, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN, IN_DIFF, .. }
        := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LAMBDA_BETA, LE_REFL, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_FORALL, PAIR_EQ, REAL_DIV_RMUL, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MUL,
        .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_RZERO, REAL_NOT_LE, REAL_OF_NUM_LT, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { DROP_EQ, FORALL_1, LIFT_DROP, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LE_0, NORM_NEG, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, VECTOR_SUB_LZERO, VECTOR_SUB_REFL, VSUM_EQ, .. } := D.dv.dg.pt.cvx.vec4
  let { COMPACT_INTERVAL, .. } := D.dv.dg.pt.cvx.top2
  let { IN_BALL, INTERVAL_EQ_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { REAL_LT_TRANS, .. } := D.dv.dg.qsession
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, uniformly_continuous_on, .. } := D.dv.dg.qtopology2
  let { COND_SWAP, CONS_11, ITERATE_CLAUSES, monoidal, neutral, .. } := D.qsession
  let { EMPTY_AS_INTERVAL, .. } := D.qtopology
  let { MONOIDAL_VECTOR_ADD, NEUTRAL_VECTOR_ADD, VSUM, .. } := D.qvec
  let { distinctness, injectivity, .. } := D
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let NEUTRAL_AND ← prove
   r"neutral(/\) = T"
   (REWRITE_TAC [neutral, FORALL_BOOL_THM] THEN MESON_TAC [])

  let MONOIDAL_AND ← prove
   r"monoidal(/\)"
   (REWRITE_TAC [monoidal, NEUTRAL_AND, CONJ_ACI])

  let ITERATE_AND ← prove
   r"!p s. FINITE s ==> (iterate(/\) s p <=> !x. x IN s ==> p x)"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    ASM_SIMP_TAC [MONOIDAL_AND, NEUTRAL_AND, ITERATE_CLAUSES] THEN SET_TAC [])

  let OPERATIVE_DIVISION_AND ← prove
   r"!P d a b. operative(/\) P /\ d division_of interval[a,b]
             ==> ((!i. i IN d ==> P i) <=> P(interval[a,b]))"
   (REPEAT GEN_TAC THEN DISCH_THEN (ASSUME_TAC o CONJ MONOIDAL_AND) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPERATIVE_DIVISION) THEN
    ASM_MESON_TAC [ITERATE_AND, DIVISION_OF_FINITE])

  let OPERATIVE_APPROXIMABLE ← prove
   r"!f:real^M->real^N e.
        &0 <= e
        ==> operative(/\)
               (\i. ?g. (!x. x IN i ==> norm (f x - g x) <= e) /\
                        g integrable_on i)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [operative, NEUTRAL_AND] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"f:real^M->real^N") THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, integrable_on] THEN
      ASM_MESON_TAC [HAS_INTEGRAL_NULL],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M", ← q r"c:real", ← q r"k:num"] THEN
    STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_SPLIT, IN_INTER], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g1:real^M->real^N") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"g2:real^M->real^N") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"\x. if x$k = c then (f:real^M->real^N)(x) else
                  if x$k <= c then g1(x) else g2(x)") THEN
    CONJ_TAC THENL
     [GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER, IN_ELIM_THM]) THEN
      ASM_MESON_TAC [← REAL_ARITH (← q r"x <= c \/ x >= c")],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(\x:real^M. if x$k = c then f x else if x$k <= c then g1 x else g2 x)
    integrable_on (interval[u,v] INTER {x | x$k <= c}) /\
    (\x. if x$k = c then f x :real^N else if x$k <= c then g1 x else g2 x)
    integrable_on (interval[u,v] INTER {x | x$k >= c})")
    MP_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [integrable_on] THEN ASM_MESON_TAC [HAS_INTEGRAL_SPLIT]] THEN
    CONJ_TAC THENL
     [UNDISCH_TAC
       (← q r"(g1:real^M->real^N) integrable_on (interval[u,v] INTER {x | x$k <= c})"),
      UNDISCH_TAC
      (← q r"(g2:real^M->real^N) integrable_on (interval[u,v] INTER {x | x$k >= c})")
     ] THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT] THEN MATCH_MP_TAC INTEGRABLE_SPIKE THEN
    ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT] THEN
    EXISTS_TAC (← q r"{x:real^M | x$k = c}") THEN
    ASM_SIMP_TAC [NEGLIGIBLE_STANDARD_HYPERPLANE, IN_DIFF, IN_INTER, IN_ELIM_THM,
                  ← REAL_ARITH (← q r"x >= c /\ ~(x = c) ==> ~(x <= c)")] THEN
    EXISTS_TAC (← q r"e:real") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM])

  let APPROXIMABLE_ON_DIVISION ← prove
   r"!f:real^M->real^N d a b.
        &0 <= e /\
        (d division_of interval[a,b]) /\
        (!i. i IN d
             ==> ?g. (!x. x IN i ==> norm (f x - g x) <= e) /\
                     g integrable_on i)
        ==> ?g. (!x. x IN interval[a,b] ==> norm (f x - g x) <= e) /\
                g integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(/\)", ← q r"d:(real^M->bool)->bool",
                      ← q r"a:real^M", ← q r"b:real^M",
                      ← q r"\i. ?g:real^M->real^N.
                       (!x. x IN i ==> norm (f x - g x) <= e) /\
                       g integrable_on i"]
                  OPERATIVE_DIVISION) THEN
    ASM_SIMP_TAC [OPERATIVE_APPROXIMABLE, MONOIDAL_AND] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [ITERATE_AND])

  let INTEGRABLE_CONTINUOUS ← prove
   r"!f:real^M->real^N a b.
        f continuous_on interval[a,b] ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_UNIFORM_LIMIT THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MATCH_MP_TAC APPROXIMABLE_ON_DIVISION THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      COMPACT_UNIFORMLY_CONTINUOUS)) THEN
    REWRITE_TAC [COMPACT_INTERVAL, uniformly_continuous_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [dist] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?p. p tagged_division_of interval[a:real^M,b] /\ (\x. ball(x,d)) fine p")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [FINE_DIVISION_EXISTS, GAUGE_BALL], ALL_TAC] THEN
    EXISTS_TAC (← q r"IMAGE SND (p:real^M#(real^M->bool)->bool)") THEN
    ASM_SIMP_TAC [DIVISION_OF_TAGGED_DIVISION] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"\y:real^M. (f:real^M->real^N) x") THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
    DISCH_THEN (MP_TAC o
      SPECL [← q r"x:real^M", ← q r"l:real^M->bool"] o elc 1) THEN
    ASM_REWRITE_TAC [SUBSET] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
    REWRITE_TAC [SUBSET, IN_BALL, dist] THEN
     FIRST_X_ASSUM SUBST_ALL_TAC THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [REAL_LT_IMP_LE, NORM_SUB],
      REWRITE_TAC [integrable_on] THEN
      EXISTS_TAC (← q r"content(interval[a':real^M,b']) % (f:real^M->real^N) x") THEN
      REWRITE_TAC [HAS_INTEGRAL_CONST]])

  let OPERATIVE_1_LT ← prove
   r"!op. monoidal op
        ==> !f. operative op f <=>
                (!a b. drop b <= drop a ==> f(interval[a,b]) = neutral op) /\
                (!a b c. drop a < drop c /\ drop c < drop b
                         ==> op (f(interval[a,c])) (f(interval[c,b])) =
                             f(interval[a,b]))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [operative, CONTENT_EQ_0_1] THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> (b <=> c)) ==> (a /\ b <=> a /\ c)")) THEN
    DISCH_TAC THEN REWRITE_TAC [FORALL_1, DIMINDEX_1] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"a:real^1") THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"b:real^1") THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"c:real^1") THEN FIRST_ASSUM (SUBST1_TAC o SPEC (← q r"drop c")) THEN
      DISCH_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_LT_TRANS) THEN
      ASM_SIMP_TAC [INTERVAL_SPLIT, DIMINDEX_1, LE_REFL, REAL_LT_IMP_LE] THEN
      BINOP_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [CONS_11, PAIR_EQ] THEN
      SIMP_TAC [FORALL_1, CART_EQ, DIMINDEX_1, LAMBDA_BETA, LE_REFL] THEN
      REWRITE_TAC [← GSYM drop] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"d:real") THEN ABBREV_TAC (← q r"c = lift d") THEN
    SUBGOAL_THEN (← q r"d = drop c") SUBST1_TAC THENL
     [ASM_MESON_TAC [LIFT_DROP], ALL_TAC] THEN
    SIMP_TAC [INTERVAL_SPLIT, LE_REFL, drop, DIMINDEX_1] THEN
    REWRITE_TAC [← GSYM drop] THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop c <= drop a \/ drop a < drop c")) THENL
     [SUBGOAL_THEN
       (← q r"content(interval[a:real^1,
        (lambda i. if i = 1 then min (drop b) (drop c) else b$i)]) = &0 /\
      interval[(lambda i. if i = 1 then max (drop a) (drop c) else a$i),b] =
      interval[a,b]")
      (CONJUNCTS_THEN2 MP_TAC SUBST1_TAC) THENL
       [CONJ_TAC THENL
         [SIMP_TAC [CONTENT_EQ_0_1],
          AP_TERM_TAC THEN REWRITE_TAC [CONS_11, PAIR_EQ]] THEN
        SIMP_TAC [drop, CART_EQ, FORALL_1, LAMBDA_BETA, DIMINDEX_1, LE_REFL] THEN
        UNDISCH_TAC (← q r"drop c <= drop a") THEN REWRITE_TAC [drop] THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [CONTENT_EQ_0_1] THEN
        DISCH_THEN (ANTE_RES_THEN SUBST1_TAC) THEN ASM_MESON_TAC [monoidal]],
      ALL_TAC] THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop b <= drop c \/ drop c < drop b")) THENL
     [SUBGOAL_THEN
       (← q r"interval[a,(lambda i. if i = 1 then min (drop b) (drop c) else b$i)] =
      interval[a,b] /\
      content(interval
        [(lambda i. if i = 1 then max (drop a) (drop c) else a$i),b]) = &0")
        (CONJUNCTS_THEN2 SUBST1_TAC MP_TAC) THENL
       [CONJ_TAC THENL
         [AP_TERM_TAC THEN REWRITE_TAC [CONS_11, PAIR_EQ],
          SIMP_TAC [CONTENT_EQ_0_1]] THEN
        SIMP_TAC [drop, CART_EQ, FORALL_1, LAMBDA_BETA, DIMINDEX_1, LE_REFL] THEN
        UNDISCH_TAC (← q r"drop b <= drop c") THEN REWRITE_TAC [drop] THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [CONTENT_EQ_0_1] THEN
        DISCH_THEN (ANTE_RES_THEN SUBST1_TAC) THEN ASM_MESON_TAC [monoidal]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(lambda i. if i = 1 then min (drop b) (drop c) else b$i) = c /\
    (lambda i. if i = 1 then max (drop a) (drop c) else a$i) = c")
     (fun th => REWRITE_TAC [th] THEN ASM_MESON_TAC []) THEN
    SIMP_TAC [CART_EQ, FORALL_1, DIMINDEX_1, LE_REFL, LAMBDA_BETA] THEN
    REWRITE_TAC [← GSYM drop] THEN ASM_REAL_ARITH_TAC)

  let OPERATIVE_1_LE ← prove
   r"!op. monoidal op
        ==> !f. operative op f <=>
                (!a b. drop b <= drop a ==> f(interval[a,b]) = neutral op) /\
                (!a b c. drop a <= drop c /\ drop c <= drop b
                         ==> op (f(interval[a,c])) (f(interval[c,b])) =
                             f(interval[a,b]))"
   (GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_SIMP_TAC [OPERATIVE_1_LT] THEN MESON_TAC [REAL_LT_IMP_LE]] THEN
    REWRITE_TAC [operative, CONTENT_EQ_0_1] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [FORALL_1, DIMINDEX_1] THEN
    MAP_EVERY (fun t => MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC t)
     [← q r"a:real^1", ← q r"b:real^1"] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"c:real^1") THEN FIRST_ASSUM (SUBST1_TAC o SPEC (← q r"drop c")) THEN
    DISCH_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT, DIMINDEX_1, LE_REFL] THEN
    BINOP_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [CONS_11, PAIR_EQ] THEN
    SIMP_TAC [FORALL_1, CART_EQ, DIMINDEX_1, LAMBDA_BETA, LE_REFL] THEN
    REWRITE_TAC [← GSYM drop] THEN ASM_REAL_ARITH_TAC)

  let ADDITIVE_DIVISION_1 ← prove
   r"!f:real^1->real^N d a b.
        drop a <= drop b /\
        d division_of interval[a,b]
        ==> vsum d (\k. f(interval_upperbound k) - f(interval_lowerbound k)) =
            f b - f a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(+):real^N->real^N->real^N",
      ← q r"d:(real^1->bool)->bool",
      ← q r"a:real^1", ← q r"b:real^1",
      ← q r"(\k. if k = {} then vec 0
          else f(interval_upperbound k) - f(interval_lowerbound k)):
     ((real^1->bool)->real^N)"] OPERATIVE_DIVISION) THEN
    ASM_SIMP_TAC [MONOIDAL_VECTOR_ADD, OPERATIVE_1_LT, NEUTRAL_VECTOR_ADD,
                  INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← REAL_ARITH (← q r"a <= b ==> ~(b < a)"),
                    REAL_LT_IMP_LE, CONTENT_EQ_0_1,
                    INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
      SIMP_TAC [← REAL_ARITH (← q r"b <= a ==> (b < a <=> ~(b = a))")] THEN
      SIMP_TAC [DROP_EQ, COND_SWAP] THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, REAL_LE_REFL] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, COND_ID, EQ_SYM_EQ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_LT_TRANS) THEN
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1,
                    ← REAL_ARITH (← q r"b < a ==> ~(a < b)"), REAL_LT_IMP_LE] THEN
      MESON_TAC [← VECTOR_ARITH (← q r"(c - a) + (b - c):real^N = b - a")],
      ALL_TAC] THEN
    ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← GSYM REAL_NOT_LE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM VSUM] THEN MATCH_MP_TAC VSUM_EQ THEN
    ASM_MESON_TAC [division_of, MEMBER_NOT_EMPTY])

  let ADDITIVE_TAGGED_DIVISION_1 ← prove
   r"!f:real^1->real^N p a b.
        drop a <= drop b /\
        p tagged_division_of interval[a,b]
        ==> vsum p
             (\(x,k). f(interval_upperbound k) - f(interval_lowerbound k)) =
            f b - f a"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(+):real^N->real^N->real^N",
      ← q r"p:(real^1#(real^1->bool)->bool)",
      ← q r"a:real^1", ← q r"b:real^1",
      ← q r"(\k. if k = {} then vec 0
          else f(interval_upperbound k) - f(interval_lowerbound k)):
     ((real^1->bool)->real^N)"] OPERATIVE_TAGGED_DIVISION) THEN
    ASM_SIMP_TAC [MONOIDAL_VECTOR_ADD, OPERATIVE_1_LT, NEUTRAL_VECTOR_ADD,
                  INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← REAL_ARITH (← q r"a <= b ==> ~(b < a)"),
                    REAL_LT_IMP_LE, CONTENT_EQ_0_1,
                    INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
      SIMP_TAC [← REAL_ARITH (← q r"b <= a ==> (b < a <=> ~(b = a))")] THEN
      SIMP_TAC [DROP_EQ, COND_SWAP] THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, REAL_LE_REFL] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, COND_ID, EQ_SYM_EQ] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_LT_TRANS) THEN
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1,
                    ← REAL_ARITH (← q r"b < a ==> ~(a < b)"), REAL_LT_IMP_LE] THEN
      MESON_TAC [← VECTOR_ARITH (← q r"(c - a) + (b - c):real^N = b - a")],
      ALL_TAC] THEN
    ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← GSYM REAL_NOT_LE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM VSUM] THEN MATCH_MP_TAC VSUM_EQ THEN
    REWRITE_TAC [FORALL_PAIR_THM] THEN
    ASM_MESON_TAC [TAGGED_DIVISION_OF, MEMBER_NOT_EMPTY])

  let HAS_INTEGRAL_FACTOR_CONTENT ← prove
   r"!f:real^M->real^N i a b.
      (f has_integral i) (interval[a,b]) <=>
      (!e. &0 < e
           ==> ?d. gauge d /\
                   (!p. p tagged_division_of interval[a,b] /\ d fine p
                        ==> norm (vsum p (\(x,k). content k % f x) - i)
                            <= e * content(interval[a,b])))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"content(interval[a:real^M,b]) = &0") THENL
     [MP_TAC (← SPECL [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M"]
       VSUM_CONTENT_NULL) THEN
      ASM_SIMP_TAC [HAS_INTEGRAL_NULL_EQ, VECTOR_SUB_LZERO, NORM_NEG] THEN
      DISCH_TAC THEN REWRITE_TAC [REAL_MUL_RZERO, NORM_LE_0] THEN
      ASM_MESON_TAC [FINE_DIVISION_EXISTS, GAUGE_TRIVIAL, REAL_LT_01],
      ALL_TAC] THEN
    REWRITE_TAC [has_integral] THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e * content(interval[a:real^M,b])")) THEN
      ASM_SIMP_TAC [REAL_LT_MUL, CONTENT_LT_NZ] THEN MESON_TAC [REAL_LT_IMP_LE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2 / content(interval[a:real^M,b])")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, CONTENT_LT_NZ, REAL_OF_NUM_LT, ARITH] THEN
    ASM_SIMP_TAC [REAL_DIV_RMUL] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")])

  let GAUGE_MODIFY ← prove
   r"!f:real^M->real^N.
      (!s. open s ==> open {x | f(x) IN s})
      ==> !d. gauge d ==> gauge (\x y. d (f x) (f y))"
   (GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
    SIMP_TAC [gauge, IN] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:real^M->real^N) x")) THEN
    DISCH_THEN (ANTE_RES_THEN MP_TAC o CONJUNCT2) THEN
    MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [IN])

  let OPERATIVE_INTEGRABLE ← prove
   r"!f. operative (/\) (\i. f integrable_on i)"
   (GEN_TAC THEN REWRITE_TAC [operative, NEUTRAL_AND] THEN CONJ_TAC THENL
     [REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_NULL_EQ],
      REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [INTEGRABLE_SPLIT] THEN
      REWRITE_TAC [integrable_on] THEN ASM_MESON_TAC [HAS_INTEGRAL_SPLIT]])

  let INTEGRABLE_SUBINTERVAL ← prove
   r"!f:real^M->real^N a b c d.
        f integrable_on interval[a,b] /\
        interval[c,d] SUBSET interval[a,b]
        ==> f integrable_on interval[c,d]"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[c:real^M,d] = {}") THENL
     [ASM_REWRITE_TAC [integrable_on] THEN
      MESON_TAC [HAS_INTEGRAL_NULL, CONTENT_EMPTY, EMPTY_AS_INTERVAL],
      ASM_MESON_TAC [OPERATIVE_INTEGRABLE, OPERATIVE_DIVISION_AND,
                     PARTIAL_DIVISION_EXTEND_1]])

  let HAS_INTEGRAL_COMBINE ← prove
   r"!f i:real^N j a b c.
        drop a <= drop c /\ drop c <= drop b /\
        (f has_integral i) (interval[a,c]) /\
        (f has_integral j) (interval[c,b])
        ==> (f has_integral (i + j)) (interval[a,b])"
   (REPEAT STRIP_TAC THEN MP_TAC
     (← CONJUNCT2 (← GEN_REWRITE_RULE I
       [← MATCH_MP OPERATIVE_1_LE (← MATCH_MP MONOIDAL_LIFTED MONOIDAL_VECTOR_ADD)]
      (← ISPEC (← q r"f:real^1->real^N") OPERATIVE_INTEGRAL))) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (COND_CASES_TAC THEN
     ASM_REWRITE_TAC [lifted, ← distinctness "option", ← injectivity "option"]) THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL, HAS_INTEGRAL_UNIQUE, integrable_on,
                   INTEGRAL_UNIQUE])

  let INTEGRAL_COMBINE ← prove
   r"!f:real^1->real^N a b c.
        drop a <= drop c /\ drop c <= drop b /\ f integrable_on (interval[a,b])
        ==> integral(interval[a,c]) f + integral(interval[c,b]) f =
            integral(interval[a,b]) f"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN
    EXISTS_TAC (← q r"c:real^1") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
    MATCH_MP_TAC INTEGRABLE_INTEGRAL THEN
    MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL])

  let INTEGRABLE_COMBINE ← prove
   r"!f a b c.
        drop a <= drop c /\ drop c <= drop b /\
        f integrable_on interval[a,c] /\
        f integrable_on interval[c,b]
        ==> f integrable_on interval[a,b]"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_COMBINE])

  let INTEGRABLE_ON_LITTLE_SUBINTERVALS ← prove
   r"!f:real^M->real^N a b.
        (!x. x IN interval[a,b]
             ==> ?d. &0 < d /\
                     !u v. x IN interval[u,v] /\
                           interval[u,v] SUBSET ball(x,d) /\
                           interval[u,v] SUBSET interval[a,b]
                           ==> f integrable_on interval[u,v])
        ==> f integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, GAUGE_EXISTENCE_LEMMA] THEN
    REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"\x:real^M. ball(x,d x)", ← q r"a:real^M", ← q r"b:real^M"]
                  FINE_DIVISION_EXISTS) THEN
    ASM_SIMP_TAC [GAUGE_BALL_DEPENDENT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN STRIP_TAC THEN
    MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ] OPERATIVE_DIVISION_AND)
           (← ISPEC (← q r"f:real^M->real^N") OPERATIVE_INTEGRABLE)) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"IMAGE SND (p:real^M#(real^M->bool)->bool)", ← q r"a:real^M",
      ← q r"b:real^M"]) THEN
    ASM_SIMP_TAC [DIVISION_OF_TAGGED_DIVISION] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
    REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o elc 1 o
     GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
    REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"k:real^M->bool"]) THEN
    ASM_REWRITE_TAC [] THEN  ASM_MESON_TAC [SUBSET])

  pure { NEUTRAL_AND, MONOIDAL_AND, ITERATE_AND, OPERATIVE_DIVISION_AND,
         OPERATIVE_APPROXIMABLE, APPROXIMABLE_ON_DIVISION, INTEGRABLE_CONTINUOUS,
         OPERATIVE_1_LT, OPERATIVE_1_LE, ADDITIVE_DIVISION_1, ADDITIVE_TAGGED_DIVISION_1,
         HAS_INTEGRAL_FACTOR_CONTENT, GAUGE_MODIFY, OPERATIVE_INTEGRABLE,
         INTEGRABLE_SUBINTERVAL, HAS_INTEGRAL_COMBINE, INTEGRAL_COMBINE, INTEGRABLE_COMBINE,
         INTEGRABLE_ON_LITTLE_SUBINTERVALS }

/- ------------------------------------------------------------------------- -/
/- Second FCT; integrating the characteristic function of an interval; the  -/
/- uniform limit form HAS_INTEGRAL.  (integration.ml 5125-5425)              -/
/- ------------------------------------------------------------------------- -/

structure INM where
  INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE : thm
  INTEGRAL_HAS_VECTOR_DERIVATIVE : thm
  ANTIDERIVATIVE_CONTINUOUS : thm
  HAS_INTEGRAL_RESTRICT_OPEN_SUBINTERVAL : thm
  HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL : thm
  HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVALS_EQ : thm
  HAS_INTEGRAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINM [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BING : ING) (BINH : INH) (BINK : INK) (BINL : INL) : ExceptT String IO INM := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, PARTIAL_DIVISION_EXTEND_1, .. } := BINB
  let { has_integral_alt, HAS_INTEGRAL_INTEGRABLE, INTEGRABLE_INTEGRAL, integrable_on, .. }
        := BINC
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_0_EQ, HAS_INTEGRAL_EMPTY_EQ, HAS_INTEGRAL_SUB,
        HAS_INTEGRAL_UNIQUE, INTEGRABLE_EQ, INTEGRAL_UNIQUE, .. } := BINE
  let { lifted, MONOIDAL_LIFTED, NEUTRAL_LIFTED, OPERATIVE_INTEGRAL, .. } := BING
  let { HAS_INTEGRAL_BOUND, HAS_INTEGRAL_CONST, OPERATIVE_DIVISION, .. } := BINH
  let { HAS_INTEGRAL_SPIKE, HAS_INTEGRAL_SPIKE_INTERIOR, INTEGRABLE_SPIKE_INTERIOR,
        NEGLIGIBLE_FRONTIER_INTERVAL, .. } := BINK
  let { INTEGRABLE_CONTINUOUS, INTEGRABLE_SUBINTERVAL, INTEGRAL_COMBINE, .. } := BINL
  let { CONJ_SYM, FINITE_DELETE, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_IMP, IN_DELETE, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { LAMBDA_BETA, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, ..
        } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_01, REAL_LT_ADD, REAL_LT_IMP_LE, REAL_LT_REFL, .. } :=
        D.dv.dg.pt.cvx.core4
  let { SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_SUB, IN_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED, NORM_0, ..
        } := D.dv.dg.pt.cvx.vec2
  let { NORM_NEG, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, linear, VECTOR_ADD_RID, VECTOR_SUB_REFL, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, .. } := D.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, .. } := D.dv.dg.pt.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERIOR_CLOSED_INTERVAL, INTERIOR_EMPTY, .. } :=
        D.dv.dg.pt.cvx.top4
  let { continuous_within, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, .. } := D.dv.dg.pt.qses
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { HAS_DERIVATIVE_WITHIN_ALT, has_vector_derivative, .. } := D.qderivatives
  let { ITERATE_CLAUSES, ITERATE_EQ_NEUTRAL, .. } := D.qsession
  let { MONOIDAL_VECTOR_ADD, NEUTRAL_VECTOR_ADD, NORM_REAL, .. } := D.qvec
  let { distinctness, injectivity, .. } := D
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE ← prove
   r"!f:real^1->real^N a b x.
        f integrable_on interval[a,b] /\ x IN interval[a,b] /\
        f continuous (at x within interval[a,b])
        ==> ((\u. integral (interval [a,u]) f) has_vector_derivative f x)
            (at x within interval [a,b])"
   (REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [has_vector_derivative, HAS_DERIVATIVE_WITHIN_ALT] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [linear, DROP_ADD, DROP_CMUL] THEN
      CONJ_TAC THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [continuous_within]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop x <= drop y \/ drop y <= drop x")) THENL
     [ASM_SIMP_TAC [← REAL_ARITH (← q r"x <= y ==> abs(y - x) = y - x")],
      ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"fy - fx - (x - y) % c:real^N = --(fx - fy - (y - x) % c)")] THEN
      ASM_SIMP_TAC [NORM_NEG, ← REAL_ARITH (← q r"x <= y ==> abs(x - y) = y - x")]] THEN
    ASM_SIMP_TAC [← GSYM CONTENT_1] THEN MATCH_MP_TAC HAS_INTEGRAL_BOUND THEN
    EXISTS_TAC (← q r"(\u. f(u) - f(x)):real^1->real^N") THEN
    (ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN CONJ_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REPEAT (POP_ASSUM MP_TAC) THEN
      REWRITE_TAC [IN_INTERVAL_1, NORM_REAL, DROP_SUB, ← GSYM drop] THEN
      REAL_ARITH_TAC] THEN
     MATCH_MP_TAC HAS_INTEGRAL_SUB THEN REWRITE_TAC [HAS_INTEGRAL_CONST]) THENL
      [SUBGOAL_THEN
        (← q r"integral(interval[a,x]) f + integral(interval[x,y]) f =
       integral(interval[a,y]) f /\
       ((f:real^1->real^N) has_integral integral(interval[x,y]) f)
        (interval[x,y])")
        (fun th => tactic_of do
          pure (MESON_TAC [th,
            ← VECTOR_ARITH (← q r"a + b = c:real^N ==> c - a = b")])),
       SUBGOAL_THEN
        (← q r"integral(interval[a,y]) f + integral(interval[y,x]) f =
       integral(interval[a,x]) f /\
       ((f:real^1->real^N) has_integral integral(interval[y,x]) f)
        (interval[y,x])")
         (fun th => tactic_of do
           pure (MESON_TAC [th,
             ← VECTOR_ARITH (← q r"a + b = c:real^N ==> c - a = b")]))] THEN
     (CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRAL_COMBINE,
        MATCH_MP_TAC INTEGRABLE_INTEGRAL] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
      MAP_EVERY EXISTS_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      ASM_SIMP_TAC [INTEGRABLE_CONTINUOUS, SUBSET_INTERVAL_1] THEN
      ASM_REAL_ARITH_TAC))

  let INTEGRAL_HAS_VECTOR_DERIVATIVE ← prove
   r"!f:real^1->real^N a b.
     f continuous_on interval[a,b]
     ==> !x. x IN interval[a,b]
             ==> ((\u. integral (interval[a,u]) f) has_vector_derivative f(x))
                 (at x within interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE THEN
    ASM_MESON_TAC [INTEGRABLE_CONTINUOUS, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN])

  let ANTIDERIVATIVE_CONTINUOUS ← prove
   r"!f:real^1->real^N a b.
     f continuous_on interval[a,b]
     ==> ?g. !x. x IN interval[a,b]
                 ==> (g has_vector_derivative f(x))
                          (at x within interval[a,b])"
   (MESON_TAC [INTEGRAL_HAS_VECTOR_DERIVATIVE])

  let HAS_INTEGRAL_RESTRICT_OPEN_SUBINTERVAL ← prove
   r"!f:real^M->real^N a b c d i.
        (f has_integral i) (interval[c,d]) /\
        interval[c,d] SUBSET interval[a,b]
        ==> ((\x. if x IN interval(c,d) then f x else vec 0) has_integral i)
             (interval[a,b])"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"interval[c:real^M,d] = {}") THENL
     [FIRST_ASSUM (MP_TAC o AP_TERM
       (← q r"interior:(real^M->bool)->(real^M->bool)")) THEN
      SIMP_TAC [INTERIOR_CLOSED_INTERVAL, INTERIOR_EMPTY] THEN
      ASM_SIMP_TAC [NOT_IN_EMPTY, HAS_INTEGRAL_0_EQ, HAS_INTEGRAL_EMPTY_EQ],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"g:real^M->real^N =
                 \x. if x IN interval(c,d) then f x else vec 0") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) =>
      HolCore.Basics.is_neg (concl t))) THEN
    REWRITE_TAC [← TAUT (← q r"a ==> b ==> c <=> b /\ a ==> c")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP PARTIAL_DIVISION_EXTEND_1) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"lifted((+):real^N->real^N->real^N)",
      ← q r"p:(real^M->bool)->bool",
      ← q r"a:real^M", ← q r"b:real^M",
      ← q r"\i. if (g:real^M->real^N) integrable_on i
         then SOME (integral i g) else NONE"]
     OPERATIVE_DIVISION) THEN
    ASM_SIMP_TAC [OPERATIVE_INTEGRAL, MONOIDAL_LIFTED, MONOIDAL_VECTOR_ADD] THEN
    SUBGOAL_THEN
     (← q r"iterate (lifted (+)) p
     (\i. if (g:real^M->real^N) integrable_on i
          then SOME (integral i g) else NONE) =
    SOME i")
    SUBST1_TAC THENL
     [ALL_TAC,
      COND_CASES_TAC THEN
      REWRITE_TAC [← distinctness "option", ← injectivity "option"] THEN
      ASM_MESON_TAC [INTEGRABLE_INTEGRAL]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← SET_RULE
     (← q r"x IN s ==> s = x INSERT (s DELETE x)"))) THEN
    ASM_SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_LIFTED, MONOIDAL_VECTOR_ADD,
                  FINITE_DELETE, IN_DELETE] THEN
    SUBGOAL_THEN (← q r"(g:real^M->real^N) integrable_on interval[c,d]")
    ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP HAS_INTEGRAL_INTEGRABLE) THEN
      MATCH_MP_TAC INTEGRABLE_SPIKE_INTERIOR THEN
      EXPAND_TAC "g" THEN SIMP_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"iterate (lifted (+)) (p DELETE interval[c,d])
      (\i. if (g:real^M->real^N) integrable_on i
           then SOME (integral i g) else NONE) = SOME(vec 0)")
    SUBST1_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [lifted, VECTOR_ADD_RID] THEN AP_TERM_TAC THEN
      MATCH_MP_TAC INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC HAS_INTEGRAL_SPIKE_INTERIOR THEN
      EXISTS_TAC (← q r"f:real^M->real^N") THEN
      EXPAND_TAC "g" THEN ASM_SIMP_TAC []] THEN
    SIMP_TAC [← GSYM NEUTRAL_VECTOR_ADD, ← GSYM NEUTRAL_LIFTED,
              MONOIDAL_VECTOR_ADD] THEN
    MATCH_MP_TAC (← MATCH_MP ITERATE_EQ_NEUTRAL
          (← MATCH_MP MONOIDAL_LIFTED (← SPEC_ALL MONOIDAL_VECTOR_ADD))) THEN
    SIMP_TAC [NEUTRAL_LIFTED, NEUTRAL_VECTOR_ADD, MONOIDAL_VECTOR_ADD] THEN
    X_GEN_TAC (← q r"k:real^M->bool") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"((g:real^M->real^N) has_integral (vec 0)) k")
     (fun th => MESON_TAC [th, integrable_on, INTEGRAL_UNIQUE]) THEN
    SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]") MP_TAC THENL
     [ASM_MESON_TAC [division_of], ALL_TAC] THEN
    DISCH_THEN (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC) THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE_INTERIOR THEN
    EXISTS_TAC (← q r"(\x. vec 0):real^M->real^N") THEN
    REWRITE_TAC [HAS_INTEGRAL_0] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
    DISCH_THEN (MP_TAC o elc 2) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"interval[c:real^M,d]", ← q r"interval[u:real^M,v]"]) THEN
    ASM_REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN
    EXPAND_TAC "g" THEN REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM SET_TAC [])

  let HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL ← prove
   r"!f:real^M->real^N a b c d i.
        (f has_integral i) (interval[c,d]) /\
        interval[c,d] SUBSET interval[a,b]
        ==> ((\x. if x IN interval[c,d] then f x else vec 0) has_integral i)
             (interval[a,b])"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_RESTRICT_OPEN_SUBINTERVAL) THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
      HAS_INTEGRAL_SPIKE) THEN
    EXISTS_TAC (← q r"interval[c:real^M,d] DIFF interval(c,d)") THEN
    REWRITE_TAC [NEGLIGIBLE_FRONTIER_INTERVAL] THEN REWRITE_TAC [IN_DIFF] THEN
    MP_TAC (← ISPECL [← q r"c:real^M", ← q r"d:real^M"] INTERVAL_OPEN_SUBSET_CLOSED) THEN
    SET_TAC [])

  let HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVALS_EQ ← prove
   r"!f:real^M->real^N a b c d i.
        interval[c,d] SUBSET interval[a,b]
        ==> (((\x. if x IN interval[c,d] then f x else vec 0) has_integral i)
              (interval[a,b]) <=>
             (f has_integral i) (interval[c,d]))"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interval[c:real^M,d] = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, HAS_INTEGRAL_0_EQ, HAS_INTEGRAL_EMPTY_EQ],
      ALL_TAC] THEN
    EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL] THEN
    SUBGOAL_THEN (← q r"(f:real^M->real^N) integrable_on interval[c,d]") MP_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_EQ THEN
      EXISTS_TAC (← q r"\x. if x IN interval[c:real^M,d]
                    then f x:real^N else vec 0") THEN
      SIMP_TAC [] THEN MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
      ASM_MESON_TAC [integrable_on],
      ALL_TAC] THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
    MP_TAC (← ASSUME (← q r"interval[c:real^M,d] SUBSET interval[a,b]")) THEN
    REWRITE_TAC [IMP_IMP] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL) THEN
    ASM_MESON_TAC [HAS_INTEGRAL_UNIQUE, INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL ← prove
   r"!f:real^M->real^N i s.
     (f has_integral i) s <=>
        !e. &0 < e
            ==> ?B. &0 < B /\
                    !a b. ball(vec 0,B) SUBSET interval[a,b]
                          ==> ?z. ((\x. if x IN s then f(x) else vec 0)
                                   has_integral z) (interval[a,b]) /\
                                  norm(z - i) < e"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [has_integral_alt] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (X_CHOOSE_THEN (← q r"a:real^M") (X_CHOOSE_THEN (← q r"b:real^M")
     SUBST_ALL_TAC)) THEN
    MP_TAC (← ISPECL [← q r"a:real^M", ← q r"b:real^M"] (← CONJUNCT1 BOUNDED_INTERVAL)) THEN
    REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"B + &1") THEN ASM_SIMP_TAC [REAL_LT_ADD, REAL_LT_01] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:real^M", ← q r"d:real^M"] THEN
      REWRITE_TAC [SUBSET, IN_BALL, ← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"i:real^N") THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      MATCH_MP_TAC HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL THEN
      ASM_MESON_TAC [SUBSET, ← REAL_ARITH (← q r"n <= B ==> n < B + &1")],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?y. ((f:real^M->real^N) has_integral y) (interval[a,b])")
    MP_TAC THENL
     [SUBGOAL_THEN
       (← q r"?c d. interval[a,b] SUBSET interval[c,d] /\
            (\x. if x IN interval[a,b] then (f:real^M->real^N) x
                 else vec 0) integrable_on interval[c,d]")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o (fun th => MATCH_MP th REAL_LT_01)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
        ABBREV_TAC (← q r"c:real^M = lambda i. --(max B C)") THEN
        ABBREV_TAC (← q r"d:real^M = lambda i. max B C") THEN
        MAP_EVERY EXISTS_TAC [← q r"c:real^M", ← q r"d:real^M"] THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^M") THEN
          DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL] THEN
          X_GEN_TAC (← q r"k:num") THEN MAP_EVERY EXPAND_TAC ["c", "d"] THEN
          SIMP_TAC [LAMBDA_BETA, REAL_BOUNDS_LE] THEN STRIP_TAC THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^M)") THEN
          ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x <= B ==> x <= max B C")) THEN
          ASM_SIMP_TAC [],
          ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:real^M", ← q r"d:real^M"]) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [SUBSET, IN_BALL, ← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
          X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL] THEN
          X_GEN_TAC (← q r"k:num") THEN MAP_EVERY EXPAND_TAC ["c", "d"] THEN
          SIMP_TAC [LAMBDA_BETA, REAL_BOUNDS_LE] THEN STRIP_TAC THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^M)") THEN
          ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x < C ==> x <= max B C")) THEN
          ASM_SIMP_TAC [],
          ALL_TAC] THEN
        MESON_TAC [integrable_on],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [integrable_on]) THEN
        ASM_SIMP_TAC [HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVALS_EQ]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"y:real^N")) THEN
    SUBGOAL_THEN (← q r"i:real^N = y") ASSUME_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"~(&0 < norm(y - i)) ==> i = y")) THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"norm(y - i:real^N)")) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"C:real") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
    ABBREV_TAC (← q r"c:real^M = lambda i. --(max B C)") THEN
    ABBREV_TAC (← q r"d:real^M = lambda i. max B C") THEN
    MAP_EVERY EXISTS_TAC [← q r"c:real^M", ← q r"d:real^M"] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_BALL, ← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL] THEN
      X_GEN_TAC (← q r"k:num") THEN MAP_EVERY EXPAND_TAC ["c", "d"] THEN
      SIMP_TAC [LAMBDA_BETA, REAL_BOUNDS_LE] THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^M)") THEN
      ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x < C ==> x <= max B C")) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"interval[a:real^M,b] SUBSET interval[c,d]") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real^M") THEN
      DISCH_TAC THEN REWRITE_TAC [IN_INTERVAL] THEN
      X_GEN_TAC (← q r"k:num") THEN MAP_EVERY EXPAND_TAC ["c", "d"] THEN
      SIMP_TAC [LAMBDA_BETA, REAL_BOUNDS_LE] THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^M)") THEN
      ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= B ==> x <= max B C")) THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVALS_EQ] THEN
    ASM_MESON_TAC [REAL_LT_REFL, HAS_INTEGRAL_UNIQUE])

  pure { INTEGRAL_HAS_VECTOR_DERIVATIVE_POINTWISE, INTEGRAL_HAS_VECTOR_DERIVATIVE,
         ANTIDERIVATIVE_CONTINUOUS, HAS_INTEGRAL_RESTRICT_OPEN_SUBINTERVAL,
         HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVAL,
         HAS_INTEGRAL_RESTRICT_CLOSED_SUBINTERVALS_EQ, HAS_INTEGRAL }

/- ------------------------------------------------------------------------- -/
/- A general restriction property; spike sets.  (integration.ml 5426-5622)  -/
/- ------------------------------------------------------------------------- -/

structure INN where
  HAS_INTEGRAL_RESTRICT : thm
  INTEGRAL_RESTRICT : thm
  INTEGRABLE_RESTRICT : thm
  HAS_INTEGRAL_RESTRICT_UNIV : thm
  INTEGRAL_RESTRICT_UNIV : thm
  INTEGRABLE_RESTRICT_UNIV : thm
  HAS_INTEGRAL_RESTRICT_INTER : thm
  INTEGRAL_RESTRICT_INTER : thm
  INTEGRABLE_RESTRICT_INTER : thm
  HAS_INTEGRAL_ON_SUPERSET : thm
  INTEGRABLE_ON_SUPERSET : thm
  NEGLIGIBLE_ON_INTERVALS : thm
  NEGLIGIBLE_BOUNDED_SUBSETS : thm
  NEGLIGIBLE_ON_COUNTABLE_INTERVALS : thm
  HAS_INTEGRAL_SPIKE_SET_EQ : thm
  HAS_INTEGRAL_SPIKE_SET : thm
  INTEGRABLE_SPIKE_SET : thm
  INTEGRABLE_SPIKE_SET_EQ : thm
  INTEGRAL_SPIKE_SET : thm
  HAS_INTEGRAL_INTERIOR : thm
  HAS_INTEGRAL_CLOSURE : thm
  INTEGRABLE_CASES : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupINN [HolBase] (D : IntegrationDeps) (BINC : INC) (BINE : INE) (BINJ : INJ) (BINK : INK) (BINM : INM) : ExceptT String IO INN := do
  -- @@SCOPE BEGIN
  let { integrable_on, integral, .. } := BINC
  let { INTEGRABLE_ADD, INTEGRABLE_EQ, .. } := BINE
  let { negligible, .. } := BINJ
  let { HAS_INTEGRAL_NEGLIGIBLE, HAS_INTEGRAL_SPIKE_EQ, NEGLIGIBLE_SUBSET, .. } := BINK
  let { HAS_INTEGRAL, .. } := BINM
  let { EQ_IMP, .. } := D.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DIFF, INTER_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, MONO_EXISTS, REAL_ARCH_SIMPLE, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { SUBSET_UNIV, UNION_COMM, .. } := D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { IN_INTERVAL, .. } := D.dv.dg.pt.cvx.vec2
  let { VEC_COMPONENT, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_NEG_COMPONENT, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { BOUNDED_SUBSET, BOUNDED_SUBSET_CBALL, .. } := D.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { IN_CBALL_0, INTERIOR_SUBSET, .. } := D.dv.dg.pt.cvx.top4
  let { frontier, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { REAL_ABS_BOUNDS, .. } := D.qsession
  let { indicator, .. } := D.qvec
  -- @@SCOPE END

  let HAS_INTEGRAL_RESTRICT ← prove
   r"!f:real^M->real^N s t i.
        s SUBSET t
        ==> (((\x. if x IN s then f x else vec 0) has_integral i) t <=>
             (f has_integral i) s)"
   (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL] THEN REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(if p then if q then x else y else y) =
                            (if q then if p then x else y else y)")] THEN
    ASM_SIMP_TAC [])

  let INTEGRAL_RESTRICT ← prove
   r"!f:real^M->real^N s t.
        s SUBSET t
        ==> integral t (\x. if x IN s then f x else vec 0) =
            integral s f"
   (SIMP_TAC [integral, HAS_INTEGRAL_RESTRICT])

  let INTEGRABLE_RESTRICT ← prove
   r"!f:real^M->real^N s t.
        s SUBSET t
        ==> ((\x. if x IN s then f x else vec 0) integrable_on t <=>
             f integrable_on s)"
   (SIMP_TAC [integrable_on, HAS_INTEGRAL_RESTRICT])

  let HAS_INTEGRAL_RESTRICT_UNIV ← prove
   r"!f:real^M->real^N s i.
        ((\x. if x IN s then f x else vec 0) has_integral i) (:real^M) <=>
         (f has_integral i) s"
   (SIMP_TAC [HAS_INTEGRAL_RESTRICT, SUBSET_UNIV])

  let INTEGRAL_RESTRICT_UNIV ← prove
   r"!f:real^M->real^N s.
        integral (:real^M) (\x. if x IN s then f x else vec 0) =
        integral s f"
   (REWRITE_TAC [integral, HAS_INTEGRAL_RESTRICT_UNIV])

  let INTEGRABLE_RESTRICT_UNIV ← prove
   r"!f s. (\x. if x IN s then f x else vec 0) integrable_on (:real^M) <=>
         f integrable_on s"
   (REWRITE_TAC [integrable_on, HAS_INTEGRAL_RESTRICT_UNIV])

  let HAS_INTEGRAL_RESTRICT_INTER ← prove
   r"!f:real^M->real^N s t.
        ((\x. if x IN s then f x else vec 0) has_integral i) t <=>
        (f has_integral i) (s INTER t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [IN_INTER] THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN MESON_TAC [])

  let INTEGRAL_RESTRICT_INTER ← prove
   r"!f:real^M->real^N s t.
        integral t (\x. if x IN s then f x else vec 0) =
        integral (s INTER t) f"
   (REWRITE_TAC [integral, HAS_INTEGRAL_RESTRICT_INTER])

  let INTEGRABLE_RESTRICT_INTER ← prove
   r"!f:real^M->real^N s t.
        (\x. if x IN s then f x else vec 0) integrable_on t <=>
        f integrable_on (s INTER t)"
   (REWRITE_TAC [integrable_on, HAS_INTEGRAL_RESTRICT_INTER])

  let HAS_INTEGRAL_ON_SUPERSET ← prove
   r"!f s t.
        (!x. ~(x IN s) ==> f x = vec 0) /\ s SUBSET t /\ (f has_integral i) s
        ==> (f has_integral i) t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SUBSET] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN
    AP_TERM_TAC THEN ABS_TAC THEN ASM_MESON_TAC [])

  let INTEGRABLE_ON_SUPERSET ← prove
   r"!f s t.
        (!x. ~(x IN s) ==> f x = vec 0) /\ s SUBSET t /\ f integrable_on s
        ==> f integrable_on t"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_ON_SUPERSET])

  let NEGLIGIBLE_ON_INTERVALS ← prove
   r"!s. negligible s <=> !a b:real^N. negligible(s INTER interval[a,b])"
   (GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [negligible] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
    FIRST_ASSUM (ASSUME_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
    MATCH_MP_TAC HAS_INTEGRAL_NEGLIGIBLE THEN
    EXISTS_TAC (← q r"s INTER interval[a:real^N,b]") THEN
    ASM_REWRITE_TAC [] THEN SIMP_TAC [indicator, IN_DIFF, IN_INTER] THEN
    MESON_TAC [])

  let NEGLIGIBLE_BOUNDED_SUBSETS ← prove
   r"!s:real^N->bool.
    negligible s <=> !t. bounded t /\ t SUBSET s ==> negligible t"
   (MESON_TAC [NEGLIGIBLE_ON_INTERVALS, INTER_SUBSET, BOUNDED_SUBSET,
               BOUNDED_INTERVAL, NEGLIGIBLE_SUBSET])

  let NEGLIGIBLE_ON_COUNTABLE_INTERVALS ← prove
   r"!s:real^N->bool.
        negligible s <=>
        !n. negligible (s INTER interval[--vec n,vec n])"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [NEGLIGIBLE_ON_INTERVALS] THEN
    EQ_TAC THEN SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!a b:real^N. ?n. s INTER interval[a,b] =
                     ((s INTER interval[--vec n,vec n]) INTER interval[a,b])")
     (fun th => ASM_MESON_TAC [th, NEGLIGIBLE_ON_INTERVALS]) THEN
    REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"interval[a:real^N,b]", ← q r"vec 0:real^N"]
          BOUNDED_SUBSET_CBALL) THEN
    REWRITE_TAC [BOUNDED_INTERVAL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← SPEC (← q r"r:real") REAL_ARCH_SIMPLE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"i SUBSET b ==> b SUBSET n ==> s INTER i = (s INTER n) INTER i"))) THEN
    REWRITE_TAC [SUBSET, IN_CBALL_0, IN_INTERVAL, VEC_COMPONENT,
                 VECTOR_NEG_COMPONENT, ← GSYM REAL_ABS_BOUNDS]  THEN
    ASM_MESON_TAC [COMPONENT_LE_NORM, REAL_LE_TRANS])

  let HAS_INTEGRAL_SPIKE_SET_EQ ← prove
   r"!f:real^M->real^N s t y.
        negligible(s DIFF t UNION t DIFF s)
        ==> ((f has_integral y) s <=> (f has_integral y) t)"
   (REPEAT STRIP_TAC THEN  ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ THEN
    EXISTS_TAC (← q r"s DIFF t UNION t DIFF s:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let HAS_INTEGRAL_SPIKE_SET ← prove
   r"!f:real^M->real^N s t y.
        negligible(s DIFF t UNION t DIFF s) /\
        (f has_integral y) s
        ==> (f has_integral y) t"
   (MESON_TAC [HAS_INTEGRAL_SPIKE_SET_EQ])

  let INTEGRABLE_SPIKE_SET ← prove
   r"!f:real^M->real^N s t.
        negligible(s DIFF t UNION t DIFF s)
        ==> f integrable_on s ==> f integrable_on t"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_SPIKE_SET_EQ])

  let INTEGRABLE_SPIKE_SET_EQ ← prove
   r"!f:real^M->real^N s t.
        negligible(s DIFF t UNION t DIFF s)
        ==> (f integrable_on s <=> f integrable_on t)"
   (MESON_TAC [INTEGRABLE_SPIKE_SET, UNION_COMM])

  let INTEGRAL_SPIKE_SET ← prove
   r"!f:real^M->real^N g s t.
        negligible(s DIFF t UNION t DIFF s)
        ==> integral s f = integral t f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [integral] THEN
    AP_TERM_TAC THEN ABS_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_SET_EQ THEN
    ASM_MESON_TAC [])

  let HAS_INTEGRAL_INTERIOR ← prove
   r"!f:real^M->real^N y s.
        negligible(frontier s)
        ==> ((f has_integral y) (interior s) <=> (f has_integral y) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_SET_EQ THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      NEGLIGIBLE_SUBSET)) THEN
    REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_SUBSET) THEN
    SET_TAC [])

  let HAS_INTEGRAL_CLOSURE ← prove
   r"!f:real^M->real^N y s.
        negligible(frontier s)
        ==> ((f has_integral y) (closure s) <=> (f has_integral y) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_SET_EQ THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      NEGLIGIBLE_SUBSET)) THEN
    REWRITE_TAC [frontier] THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") INTERIOR_SUBSET) THEN
    MP_TAC (← ISPEC (← q r"s:real^M->bool") CLOSURE_SUBSET) THEN
    SET_TAC [])

  let INTEGRABLE_CASES ← prove
   r"!f g:real^M->real^N s.
        f integrable_on {x | x IN s /\ P x} /\
        g integrable_on {x | x IN s /\ ~P x}
        ==> (\x. if P x then f x else g x) integrable_on s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_ADD) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_EQ) THEN
    REWRITE_TAC [IN_UNIV, IN_ELIM_THM] THEN
    MESON_TAC [VECTOR_ADD_LID, VECTOR_ADD_RID])

  pure { HAS_INTEGRAL_RESTRICT, INTEGRAL_RESTRICT, INTEGRABLE_RESTRICT,
         HAS_INTEGRAL_RESTRICT_UNIV, INTEGRAL_RESTRICT_UNIV, INTEGRABLE_RESTRICT_UNIV,
         HAS_INTEGRAL_RESTRICT_INTER, INTEGRAL_RESTRICT_INTER, INTEGRABLE_RESTRICT_INTER,
         HAS_INTEGRAL_ON_SUPERSET, INTEGRABLE_ON_SUPERSET, NEGLIGIBLE_ON_INTERVALS,
         NEGLIGIBLE_BOUNDED_SUBSETS, NEGLIGIBLE_ON_COUNTABLE_INTERVALS,
         HAS_INTEGRAL_SPIKE_SET_EQ, HAS_INTEGRAL_SPIKE_SET, INTEGRABLE_SPIKE_SET,
         INTEGRABLE_SPIKE_SET_EQ, INTEGRAL_SPIKE_SET, HAS_INTEGRAL_INTERIOR,
         HAS_INTEGRAL_CLOSURE, INTEGRABLE_CASES }

/- ------------------------------------------------------------------------- -/
/- General twiddling for interval-to-interval images; trivial changes of    -/
/- variables (twizzle, pastecart symmetry, affinity, stretch, reflection,   -/
/- translation).  (integration.ml 5623-6170)                                 -/
/- ------------------------------------------------------------------------- -/

structure INO where
  HAS_INTEGRAL_TWIDDLE : thm
  HAS_INTEGRAL_TWIDDLE_GEN : thm
  HAS_INTEGRAL_TWIZZLE_INTERVAL : thm
  HAS_INTEGRAL_TWIZZLE : thm
  HAS_INTEGRAL_TWIZZLE_EQ : thm
  INTEGRABLE_TWIZZLE_EQ : thm
  INTEGRAL_TWIZZLE_EQ : thm
  HAS_INTEGRAL_PASTECART_SYM_ALT : thm
  HAS_INTEGRAL_PASTECART_SYM : thm
  INTEGRAL_PASTECART_SYM : thm
  INTEGRABLE_PASTECART_SYM : thm
  INTERVAL_IMAGE_AFFINITY_INTERVAL : thm
  CONTENT_IMAGE_AFFINITY_INTERVAL : thm
  HAS_INTEGRAL_AFFINITY : thm
  INTEGRABLE_AFFINITY : thm
  CONTENT_IMAGE_STRETCH_INTERVAL : thm
  HAS_INTEGRAL_STRETCH : thm
  INTEGRABLE_STRETCH : thm
  HAS_INTEGRAL_REFLECT_LEMMA : thm
  HAS_INTEGRAL_REFLECT : thm
  INTEGRABLE_REFLECT : thm
  INTEGRAL_REFLECT : thm
  HAS_INTEGRAL_TRANSLATION : thm
  INTEGRAL_TRANSLATION : thm
  INTEGRABLE_TRANSLATION : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINO [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINM : INM) : ExceptT String IO INO := do
  -- @@SCOPE BEGIN
  let { content, CONTENT_CLOSED_INTERVAL, CONTENT_CLOSED_INTERVAL_CASES, CONTENT_EMPTY,
        INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, .. } := BINA
  let { gauge, .. } := BINB
  let { fine, has_integral, has_integral_compact_interval, has_integral_def, integrable_on,
        integral, TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { HAS_INTEGRAL_EMPTY_EQ, .. } := BINE
  let { HAS_INTEGRAL, .. } := BINM
  let { ADD_SYM, CART_EQ, CONJ_ASSOC, DIMINDEX_FINITE_SUM, EQ_IMP, ETA_AX, EXISTS_PAIR_THM,
        EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, FSTCART_PASTECART, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY,
        IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_IMP, IN, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, LAMBDA_BETA, MONO_AND, MONO_EXISTS, MONO_IMP,
        PAIR_EQ, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NEG, REAL_ABS_NUM, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_INV_1, REAL_INV_NEG, REAL_LE_LMUL, REAL_LE_RADD, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_DIV2_EQ, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LCANCEL_IMP,
        REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_NEG2, REAL_LTE_ADD, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_RZERO,
        REAL_MUL_SYM, REAL_POW_LT, REAL_POW_ONE, REAL_SUB_LDISTRIB, RIGHT_FORALL_IMP_THM,
        SNDCART_PASTECART, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, real_div, .. } := D.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { dot, linear, VECTOR_ADD_COMPONENT, VECTOR_ADD_LDISTRIB, VECTOR_ADD_SYM,
        VECTOR_MUL_ASSOC, VECTOR_MUL_COMPONENT, VECTOR_MUL_LID, VECTOR_MUL_RNEG,
        VECTOR_MUL_RZERO, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, VECTOR_SUB_LDISTRIB,
        VSUM_EQ, VSUM_IMAGE, VSUM_LMUL, .. } := D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ADD, CONTINUOUS_AT_ID, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_CONST, .. } := D.dv.dg.pt.cvx.top3
  let { IN_BALL_0, LINEAR_CONTINUOUS_AT, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { VECTOR_NEG_0, .. } := D.dv.dg.pt.qvec
  let { CONTINUOUS_CMUL, .. } := D.dv.dg.pt.qtop
  let { PASTECART_FST_SND, .. } := D.dv.dg.qsession
  let { REAL_ABS_NZ, .. } := D.dv.qsession
  let { NORM_LT_SQUARE, .. } := D.dv.qvec
  let { PRODUCT_PERMUTE, .. } := D.qdet
  let { PRODUCT_ABS, PRODUCT_CONST_NUMSEG_1, PRODUCT_EQ, PRODUCT_EQ_0_NUMSEG,
        PRODUCT_EQ_NUMSEG, PRODUCT_MUL, PRODUCT_MUL_NUMSEG, .. } := D.qproducts
  let { PERMUTES_BIJECTIONS, PERMUTES_IN_IMAGE, PERMUTES_INVERSE, PERMUTES_INVERSES,
        SUM_PERMUTE, .. } := D.qpermutations
  let { fstcart, IMAGE_UNIONS, LAMBDA_PAIR_THM, pastecart, sndcart, .. } := D.qsession
  let { CONTINUOUS_OPEN_PREIMAGE_UNIV, EMPTY_AS_INTERVAL, IMAGE_AFFINITY_INTERVAL,
        IMAGE_STRETCH_INTERVAL, IMAGE_TWIZZLE_INTERVAL, INTERIOR_IMAGE_SUBSET, .. } :=
        D.qtopology
  let { INTERVAL_EQ_EMPTY, .. } := D.qvec
  let { IMP_REWRITE_TAC, .. } := D
  -- @@SCOPE END

  let MK_COMB_TAC := HolCore.Tactics.MK_COMB_TAC HolBase.B

  let HAS_INTEGRAL_TWIDDLE ← (do
    let lemma0 ← prove
     r"(!x k. (x,k) IN IMAGE (\(x,k). f x,g k) p ==> P x k) <=>
     (!x k. (x,k) IN p ==> P (f x) (g k))"
     (REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, PAIR_EQ] THEN MESON_TAC [])
    let lemma1 ← prove
     r"{k | ?x. (x,k) IN p} = IMAGE SND p"
     (REWRITE_TAC [EXTENSION, EXISTS_PAIR_THM, IN_IMAGE, IN_ELIM_THM] THEN
      MESON_TAC [])
    let lemma2 ← prove
     r"SND o (\(x,k). f x,g k) = g o SND"
     (REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM, o_DEF])
    prove
     r"!f:real^N->real^P (g:real^M->real^N) h r i a b.
      &0 < r /\
      (!x. h(g x) = x) /\ (!x. g(h x) = x) /\ (!x. g continuous at x) /\
      (!u v. ?w z. IMAGE g (interval[u,v]) = interval[w,z]) /\
      (!u v. ?w z. IMAGE h (interval[u,v]) = interval[w,z]) /\
      (!u v. content(IMAGE g (interval[u,v])) = r * content(interval[u,v])) /\
      (f has_integral i) (interval[a,b])
      ==> ((\x. f(g x)) has_integral (inv r) % i) (IMAGE h (interval[a,b]))"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^N,b] = {}") THEN
      ASM_SIMP_TAC [IMAGE_CLAUSES, HAS_INTEGRAL_EMPTY_EQ, VECTOR_MUL_RZERO] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [has_integral] THEN
      ASM_REWRITE_TAC [has_integral_def, has_integral_compact_interval] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e * r:real")) THEN
      ASM_SIMP_TAC [REAL_LT_MUL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^N->real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x y:real^M. (d:real^N->real^N->bool) (g x) (g y)") THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [gauge]) THEN
        SIMP_TAC [gauge, IN, FORALL_AND_THM] THEN
        STRIP_TAC THEN X_GEN_TAC (← q r"x:real^M") THEN
        SUBGOAL_THEN (← q r"(\y:real^M. (d:real^N->real^N->bool) (g x) (g y)) =
                  {y | g y IN (d (g x))}") SUBST1_TAC
        THENL [SET_TAC [], ASM_SIMP_TAC [CONTINUOUS_OPEN_PREIMAGE_UNIV]],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"IMAGE (\(x,k). (g:real^M->real^N) x, IMAGE g k) p")) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [ALL_TAC,
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
          REWRITE_TAC [fine, lemma0] THEN
          STRIP_TAC THEN REPEAT GEN_TAC THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
          ASM SET_TAC []] THEN
        SUBGOAL_THEN
         (← q r"interval[a,b] = IMAGE ((g:real^M->real^N) o h) (interval[a,b])")
        SUBST1_TAC THENL [SIMP_TAC [o_DEF] THEN ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?u v. IMAGE (h:real^N->real^M) (interval[a,b]) =
                        interval[u,v]")
        (REPEAT_TCL CHOOSE_THEN
          (fun th => SUBST_ALL_TAC th THEN ASSUME_TAC th)) THENL
          [ASM_MESON_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        REWRITE_TAC [TAGGED_DIVISION_OF, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
