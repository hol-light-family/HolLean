  let { INDEFINITE_INTEGRAL_CONTINUOUS_LEFT, .. } := BINAS
  let { ARITH_EQ, COND_RAND, COND_RATOR, DIMINDEX_1, DISJ_ASSOC, ETA_AX, EXTENSION,
        FINITE_NUMSEG, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
