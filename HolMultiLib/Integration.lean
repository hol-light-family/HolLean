  let VECTOR_VARIATION_ON_EMPTY ← prove
   r"!f:real^1->real^N. vector_variation {} f = &0"
   (REWRITE_TAC [vector_variation, SET_VARIATION_ON_EMPTY])

  let VECTOR_VARIATION_SING ← prove
   r"!f:real^1->real^N a. vector_variation {a} f = &0"
