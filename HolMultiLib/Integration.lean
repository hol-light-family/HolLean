      MATCH_MP_TAC REAL_LE_RMUL THEN
      SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS, REAL_OF_NUM_LE] THEN
      GEN_REWRITE_TAC RAND_CONV [← ARITH_RULE (← q r"2 = 2 EXP 1")] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM DIMINDEX_1] THEN
      MATCH_MP_TAC TAGGED_PARTIAL_DIVISION_COMMON_TAGS THEN
      ASM_MESON_TAC [tagged_division_of],
      ALL_TAC] THEN
    REWRITE_TAC [real_div, SUM_LMUL, ← REAL_ARITH (← q r"&2 * x <= &4 <=> x <= &2"),
                 REAL_INV_POW] THEN
    SUBGOAL_THEN
     (← q r"(\x:real^1. inv (&2) pow n x) = (\n. inv(&2) pow n) o n")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (rand o rand) SUM_IMAGE o lhand o snd) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    SUBGOAL_THEN
     (← q r"?m. IMAGE (n:real^1->num)
              (IMAGE (r:num->real^1) t INTER
              IMAGE (FST:real^1#(real^1->bool)->real^1) p) SUBSET 0..m")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, IN_NUMSEG, LE_0] THEN
      MATCH_MP_TAC UPPER_BOUND_FINITE_SET THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_INTER],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(0..m) (\n. inv(&2) pow n)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUM_SUBSET THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_INTER, FINITE_NUMSEG] THEN
      SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN ASM SET_TAC [],
      REWRITE_TAC [SUM_GP, LT, SUB_0] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(&1 - x) / (&1 / &2) <= &2 <=> &0 <= x")] THEN
      MATCH_MP_TAC REAL_POW_LE THEN CONV_TAC REAL_RAT_REDUCE_CONV])

  pure { FUNDAMENTAL_THEOREM_OF_CALCULUS_BARTLE, FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG }

/- ------------------------------------------------------------------------- -/
/- Remaining FTC forms; uniqueness for zero derivative; integration by      -/
/- parts.  (integration.ml 13286-13565)                                     -/
/- ------------------------------------------------------------------------- -/

structure INAK where
  FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG : thm
  FUNDAMENTAL_THEOREM_OF_CALCULUS : thm
  FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR : thm
  ANTIDERIVATIVE_INTEGRAL_CONTINUOUS : thm
  HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL : thm
  HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX : thm
  HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONNECTED : thm
  INTEGRATION_BY_PARTS : thm
  INTEGRATION_BY_PARTS_SIMPLE : thm
  INTEGRABLE_BY_PARTS : thm
  INTEGRABLE_BY_PARTS_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINAK [HolBase] (D : IntegrationDeps) (BINA : INA) (BINC : INC) (BINE : INE) (BINM : INM) (BINAJ : INAJ) : ExceptT String IO INAK := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_1, .. } := BINA
  let { integrable_on, .. } := BINC
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_SUB, HAS_INTEGRAL_UNIQUE, INTEGRABLE_ON_NULL, .. } :=
        BINE
  let { ANTIDERIVATIVE_CONTINUOUS, .. } := BINM
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG, .. } := BINAJ
  let { DE_MORGAN_THM, DIFF_EMPTY, EQ_IMP, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, MONO_EXISTS, MONO_FORALL, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LT_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_POS, REAL_SUB_0, RIGHT_FORALL_IMP_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_SUB, DROP_VEC, FORALL_DROP, INTERVAL_OPEN_SUBSET_CLOSED, LIFT_DROP,
        LIFT_SUB, .. } := D.dv.dg.pt.cvx.vec2
  let { bilinear, VECTOR_ADD_SUB, VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_SUB_EQ, VECTOR_SUB_RDISTRIB, .. } := D.dv.dg.pt.cvx.vec4
  let { CENTRE_IN_BALL, CLOSED_SING, .. } := D.dv.dg.pt.cvx.top1
  let { CONNECTED_CLOPEN, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, OPEN_CONTAINS_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { CONVEX_ALT, CONVEX_BALL, .. } := D.dv.dg.pt.qcvx2
  let { CONTINUOUS_CLOSED_IN_PREIMAGE, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { CONTINUOUS_ON_VMUL, .. } := D.dv.qtopology1
  let { DIFF_CHAIN_WITHIN, differentiable, DIFFERENTIABLE_IMP_CONTINUOUS_ON,
        differentiable_on, HAS_DERIVATIVE_ADD, HAS_DERIVATIVE_CONST, HAS_DERIVATIVE_ID,
        HAS_DERIVATIVE_SUB, HAS_DERIVATIVE_VMUL_DROP, HAS_DERIVATIVE_WITHIN_OPEN,
        HAS_DERIVATIVE_WITHIN_SUBSET, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_BILINEAR_AT,
        HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, .. } :=
        D.qderivatives
  let { COUNTABLE_EMPTY, COUNTABLE_IMAGE_INJ, COUNTABLE_INSERT, .. } := D.qcard
  let { OPEN_OPEN_IN_TRANS, .. } := D.qtopology
  -- @@SCOPE END

  let FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG ← prove
   r"!f:real^1->real^N f' s a b.
        COUNTABLE s /\
        drop a <= drop b /\ f continuous_on interval[a,b] /\
        (!x. x IN interval(a,b) DIFF s
             ==> (f has_vector_derivative f'(x)) (at x))
        ==> (f' has_integral (f(b) - f(a))) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG THEN
    EXISTS_TAC (← q r"(a:real^1) INSERT (b:real^1) INSERT s") THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT, IN_INTERVAL_1, IN_DIFF] THEN
    REWRITE_TAC [DE_MORGAN_THM, IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_AT_WITHIN THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, IN_DIFF, IN_INSERT] THEN
    ASM_REWRITE_TAC [REAL_LT_LE, DROP_EQ])

  let FUNDAMENTAL_THEOREM_OF_CALCULUS ← prove
   r"!f:real^1->real^N f' a b.
        drop a <= drop b /\
        (!x. x IN interval[a,b]
             ==> (f has_vector_derivative f'(x)) (at x within interval[a,b]))
        ==> (f' has_integral (f(b) - f(a))) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG THEN
    EXISTS_TAC (← q r"{}:real^1->bool") THEN
    ASM_REWRITE_TAC [COUNTABLE_EMPTY, DIFF_EMPTY] THEN
    MATCH_MP_TAC DIFFERENTIABLE_IMP_CONTINUOUS_ON THEN
    REWRITE_TAC [differentiable_on] THEN
    ASM_MESON_TAC [has_vector_derivative, differentiable])

  let FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR ← prove
   r"!f:real^1->real^N f' a b.
        drop a <= drop b /\ f continuous_on interval[a,b] /\
        (!x. x IN interval(a,b)
             ==> (f has_vector_derivative f'(x)) (at x))
        ==> (f' has_integral (f(b) - f(a))) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG THEN
    EXISTS_TAC (← q r"{}:real^1->bool") THEN
    ASM_REWRITE_TAC [COUNTABLE_EMPTY, DIFF_EMPTY])

  let ANTIDERIVATIVE_INTEGRAL_CONTINUOUS ← prove
   r"!f:real^1->real^N a b.
     (f continuous_on interval[a,b])
     ==> ?g. !u v. u IN interval[a,b] /\ v IN interval[a,b] /\ drop u <= drop v
                   ==> (f has_integral (g(v) - g(u))) (interval[u,v])"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ANTIDERIVATIVE_CONTINUOUS) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN
    STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"interval[a:real^1,b]") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC, ALL_TAC] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    REWRITE_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1] THEN REAL_ARITH_TAC)

  let HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL ← prove
   r"!f:real^1->real^N a b k y.
        COUNTABLE k /\ f continuous_on interval[a,b] /\ f a = y /\
        (!x. x IN (interval[a,b] DIFF k)
             ==> (f has_derivative (\h. vec 0)) (at x within interval[a,b]))
        ==> !x. x IN interval[a,b] ==> f x = y"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
    MATCH_MP_TAC (← ISPEC (← q r"(\x. vec 0):real^1->real^N") HAS_INTEGRAL_UNIQUE) THEN
    EXISTS_TAC (← q r"interval[a:real^1,x]") THEN
    REWRITE_TAC [HAS_INTEGRAL_0] THEN FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG THEN
    EXISTS_TAC (← q r"k:real^1->bool") THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL_1])) THEN
      REAL_ARITH_TAC,
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL_1])) THEN
      REAL_ARITH_TAC,
      X_GEN_TAC (← q r"y:real^1") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^1")) THEN ANTS_TAC THENL
       [REPEAT (POP_ASSUM MP_TAC) THEN
        SIMP_TAC [IN_DIFF, IN_INTERVAL_1] THEN REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HAS_DERIVATIVE_WITHIN_SUBSET)) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"interval(a:real^1,b)")) THEN
      REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED] THEN
      REWRITE_TAC [has_vector_derivative, VECTOR_MUL_RZERO] THEN
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_OPEN THEN
      REPEAT (POP_ASSUM MP_TAC) THEN
      SIMP_TAC [OPEN_INTERVAL, IN_INTERVAL_1, IN_DIFF] THEN REAL_ARITH_TAC])

  let HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX ← prove
   r"!f:real^M->real^N s k c y.
      convex s /\ COUNTABLE k /\ f continuous_on s /\ c IN s /\ f c = y /\
      (!x. x IN (s DIFF k) ==> (f has_derivative (\h. vec 0)) (at x within s))
      ==> !x. x IN s ==> f x = y"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"z:real^N"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (SUBST_ALL_TAC o SYM) THEN
    X_GEN_TAC (← q r"y:real^M") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:real^M = y") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"(f:real^M->real^N) o (\t. (&1 - drop t) % x + drop t % y)",
                      ← q r"vec 0:real^1", ← q r"vec 1:real^1",
                      ← q r"{t | ((&1 - drop t) % (x:real^M) + drop t % y) IN k}",
                      ← q r"(f:real^M->real^N) x"]
                  HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL) THEN
    REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"vec 1:real^1")) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN AP_TERM_TAC THEN VECTOR_ARITH_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_IMAGE_INJ THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, REAL_SUB_0, DROP_EQ,
      ← VECTOR_ARITH (← q r"(&1 - t) % x + t % y = (&1 - u) % x + u % y <=>
                  (t - u) % (x - y) = vec 0")],
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_ADD THEN CONJ_TAC THEN
        MATCH_MP_TAC CONTINUOUS_ON_VMUL THEN
        REWRITE_TAC [o_DEF, LIFT_DROP, CONTINUOUS_ON_ID, LIFT_SUB] THEN
        SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_INTERVAL_1, ← GSYM FORALL_DROP] THEN
        REWRITE_TAC [DROP_VEC] THEN ASM_MESON_TAC [CONVEX_ALT]],
      AP_TERM_TAC THEN REWRITE_TAC [DROP_VEC] THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(\h. vec 0) = ((\h. vec 0):real^M->real^N) o
                               (\t. drop t % (y - x))")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC DIFF_CHAIN_WITHIN THEN CONJ_TAC THENL
     [REWRITE_TAC [← VECTOR_ARITH (← q r"t % (y - x) = ((&0 - t) % x) + t % y")] THEN
      MATCH_MP_TAC HAS_DERIVATIVE_ADD THEN
      REWRITE_TAC [← GSYM DROP_NEG, ← GSYM DROP_VEC, ← GSYM DROP_SUB] THEN
      SIMP_TAC [HAS_DERIVATIVE_VMUL_DROP, HAS_DERIVATIVE_ID] THEN
      REWRITE_TAC [DROP_SUB, VECTOR_SUB_RDISTRIB] THEN
      MATCH_MP_TAC HAS_DERIVATIVE_SUB THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, DROP_VEC, HAS_DERIVATIVE_CONST] THEN
      SIMP_TAC [HAS_DERIVATIVE_VMUL_DROP, HAS_DERIVATIVE_ID],
      ALL_TAC] THEN
    MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM FORALL_DROP, DROP_VEC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [CONVEX_ALT]] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_DIFF]) THEN
    SIMP_TAC [IN_ELIM_THM, IN_DIFF] THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_INTERVAL_1, ← GSYM FORALL_DROP, DROP_VEC] THEN
    ASM_MESON_TAC [CONVEX_ALT])

  let HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONNECTED ← prove
   r"!f:real^M->real^N s k c y.
      connected s /\ open s /\ COUNTABLE k /\ f continuous_on s /\
      c IN s /\ f c = y /\
      (!x. x IN (s DIFF k) ==> (f has_derivative (\h. vec 0)) (at x within s))
      ==> !x. x IN s ==> f x = y"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONNECTED_CLOPEN]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"{x | x IN s /\ (f:real^M->real^N) x IN {y}}")) THEN
    ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_CLOSED_IN_PREIMAGE, CLOSED_SING] THEN
    MATCH_MP_TAC OPEN_OPEN_IN_TRANS THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    UNDISCH_TAC (← q r"open(s:real^M->bool)") THEN REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^M") THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX THEN
    MAP_EVERY EXISTS_TAC [← q r"k:real^M->bool", ← q r"u:real^M"] THEN
    ASM_REWRITE_TAC [CONVEX_BALL, IN_DIFF, CENTRE_IN_BALL] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [IN_DIFF])

  let INTEGRATION_BY_PARTS ← prove
   r"!(bop:real^M->real^N->real^P) f g f' g' a b c y.
        bilinear bop /\ drop a <= drop b /\ COUNTABLE c /\
        (\x. bop (f x) (g x)) continuous_on interval[a,b] /\
        (!x. x IN interval(a,b) DIFF c
             ==> (f has_vector_derivative f'(x)) (at x) /\
                 (g has_vector_derivative g'(x)) (at x)) /\
        ((\x. bop (f x) (g' x)) has_integral
         ((bop (f b) (g b) - bop (f a) (g a)) - y))
            (interval[a,b])
        ==> ((\x. bop (f' x) (g x)) has_integral y) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^1. (bop:real^M->real^N->real^P) (f x) (g x)",
                      ← q r"\x:real^1. (bop:real^M->real^N->real^P) (f x) (g' x) +
                             (bop:real^M->real^N->real^P) (f' x) (g x)",
                      ← q r"c:real^1->bool", ← q r"a:real^1", ← q r"b:real^1"]
      FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG) THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_BILINEAR_AT] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC th THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
            DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB))) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"b - a - (b - a - y):real^N = y"), VECTOR_ADD_SUB])

  let INTEGRATION_BY_PARTS_SIMPLE ← prove
   r"!(bop:real^M->real^N->real^P) f g f' g' a b y.
        bilinear bop /\ drop a <= drop b /\
        (!x. x IN interval[a,b]
             ==> (f has_vector_derivative f'(x)) (at x within interval[a,b]) /\
                 (g has_vector_derivative g'(x)) (at x within interval[a,b])) /\
        ((\x. bop (f x) (g' x)) has_integral
         ((bop (f b) (g b) - bop (f a) (g a)) - y))
            (interval[a,b])
        ==> ((\x. bop (f' x) (g x)) has_integral y) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x:real^1. (bop:real^M->real^N->real^P) (f x) (g x)",
                      ← q r"\x:real^1. (bop:real^M->real^N->real^P) (f x) (g' x) +
                             (bop:real^M->real^N->real^P) (f' x) (g x)",
                      ← q r"a:real^1", ← q r"b:real^1"]
      FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC th THEN REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
            DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB))) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"b - a - (b - a - y):real^N = y"), VECTOR_ADD_SUB])

  let INTEGRABLE_BY_PARTS ← prove
   r"!(bop:real^M->real^N->real^P) f g f' g' a b c.
        bilinear bop /\ COUNTABLE c /\
        (\x. bop (f x) (g x)) continuous_on interval[a,b] /\
        (!x. x IN interval(a,b) DIFF c
             ==> (f has_vector_derivative f'(x)) (at x) /\
                 (g has_vector_derivative g'(x)) (at x)) /\
        (\x. bop (f x) (g' x)) integrable_on interval[a,b]
        ==> (\x. bop (f' x) (g x)) integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop b <= drop a \/ drop a <= drop b")) THENL
     [DISCH_THEN (K ALL_TAC) THEN MATCH_MP_TAC INTEGRABLE_ON_NULL THEN
      ASM_REWRITE_TAC [CONTENT_EQ_0_1],
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [integrable_on] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^P") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(bop ((f:real^1->real^M) b) ((g:real^1->real^N) b) -
                 bop (f a) (g a)) - (y:real^P)") THEN
      MATCH_MP_TAC INTEGRATION_BY_PARTS THEN MAP_EVERY EXISTS_TAC
       [← q r"f:real^1->real^M", ← q r"g':real^1->real^N", ← q r"c:real^1->bool"] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"b - a - ((b - a) - y):real^N = y")]])

  let INTEGRABLE_BY_PARTS_EQ ← prove
   r"!(bop:real^M->real^N->real^P) f g f' g' a b c.
        bilinear bop /\ COUNTABLE c /\
        (\x. bop (f x) (g x)) continuous_on interval[a,b] /\
        (!x. x IN interval(a,b) DIFF c
             ==> (f has_vector_derivative f'(x)) (at x) /\
                 (g has_vector_derivative g'(x)) (at x))
        ==> ((\x. bop (f x) (g' x)) integrable_on interval[a,b] <=>
             (\x. bop (f' x) (g x)) integrable_on interval[a,b])"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_BY_PARTS], DISCH_TAC] THEN
    MP_TAC (← ISPEC (← q r"\x y. (bop:real^M->real^N->real^P) y x")
          INTEGRABLE_BY_PARTS) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    UNDISCH_TAC (← q r"bilinear(bop:real^M->real^N->real^P)") THEN
    REWRITE_TAC [bilinear] THEN MESON_TAC [])

  pure { FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG, FUNDAMENTAL_THEOREM_OF_CALCULUS,
         FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR, ANTIDERIVATIVE_INTEGRAL_CONTINUOUS,
         HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL, HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONVEX,
         HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_CONNECTED, INTEGRATION_BY_PARTS,
         INTEGRATION_BY_PARTS_SIMPLE, INTEGRABLE_BY_PARTS, INTEGRABLE_BY_PARTS_EQ }

/- ------------------------------------------------------------------------- -/
/- Equiintegrability: definition and basic combining theorems for the       -/
/- interval of integration.  (integration.ml 13566-13844)                   -/
/- ------------------------------------------------------------------------- -/

structure INAL where
  equiintegrable_on : thm
  EQUIINTEGRABLE_ON_SING : thm
  EQUIINTEGRABLE_ON_NULL : thm
  EQUIINTEGRABLE_ON_SPLIT : thm
  EQUIINTEGRABLE_DIVISION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAL [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINF : INF) (BING : ING) (BINL : INL) (BINS : INS) : ExceptT String IO INAL := do
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, .. } := BINA
  let { gauge, GAUGE_TRIVIAL, .. } := BINB
  let { fine, has_integral, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_INTEGRAL, integrable_on,
        TAGGED_DIVISION_OF, tagged_division_of, TAGGED_DIVISION_OF_FINITE,
        TAGGED_PARTIAL_DIVISION_OF_SUBSET, VSUM_CONTENT_NULL, .. } := BINC
  let { INTEGRABLE_ON_NULL, INTEGRAL_NULL, INTEGRAL_UNIQUE, .. } := BINE
  let { CONTENT_SPLIT, HAS_INTEGRAL_SPLIT, INTERVAL_SPLIT, TAGGED_DIVISION_SPLIT_LEFT_INJ,
        TAGGED_DIVISION_SPLIT_RIGHT_INJ, .. } := BINF
  let { INTEGRABLE_SPLIT, operative, .. } := BING
  let { NEUTRAL_AND, OPERATIVE_DIVISION_AND, .. } := BINL
  let { HENSTOCK_LEMMA_PART1, INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN, .. } := BINS
  let { AND_FORALL_THM, CONTRAPOS_THM, EQ_IMP, EQ_TRANS, EXISTS_PAIR_THM, EXTENSION,
        FINITE_IMAGE, FINITE_SUBSET, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FORALL_UNWIND_THM2, FUN_EQ_THM, IMP_CONJ, IMP_IMP,
        INTER_SUBSET, INTER_UNIONS, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNIONS, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY, PAIR_EQ, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_0, RIGHT_FORALL_IMP_THM, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_THM, real_ge, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_REFL, .. } := D.dv.dg.pt.cvx.vec1
  let { NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_ADD_RDISTRIB, VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VECTOR_SUB_COMPONENT,
        VECTOR_SUB_REFL, VECTOR_SUB_RZERO, VSUM_ADD, VSUM_EQ, VSUM_EQ_0, VSUM_SUB,
        VSUM_SUPERSET, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_BALL, OPEN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTER, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, NORM_ARITH,
        parse_as_infix, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { NORM_TRIANGLE_LT, .. } := D.dv.dg.pt.qvec
  let { REAL_ABS_NZ, .. } := D.dv.qsession
  let { VSUM_IMAGE_NONZERO, .. } := D.qvec
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  parse_as_infix ("equiintegrable_on", (12, "right"))

  let equiintegrable_on ← new_definition
   r"fs equiintegrable_on i <=>
        (!f:real^M->real^N. f IN fs ==> f integrable_on i) /\
        (!e. &0 < e
             ==> ?d. gauge d /\
                    !f p. f IN fs /\ p tagged_division_of i /\ d fine p
                        ==> norm(vsum p (\(x,k). content(k) % f(x)) -
                                 integral i f) < e)"

  let EQUIINTEGRABLE_ON_SING ← prove
   r"!f:real^M->real^N a b.
        {f} equiintegrable_on interval[a,b] <=>
        f integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [equiintegrable_on] THEN
    REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2] THEN
    ASM_CASES_TAC (← q r"(f:real^M->real^N) integrable_on interval[a,b]") THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_UNWIND_THM2] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
    REWRITE_TAC [has_integral, IMP_IMP])

  let EQUIINTEGRABLE_ON_NULL ← prove
   r"!fs:(real^M->real^N)->bool a b.
     content(interval[a,b]) = &0 ==> fs equiintegrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [equiintegrable_on] THEN
    ASM_SIMP_TAC [INTEGRABLE_ON_NULL] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"\x:real^M. ball(x,&1)") THEN REWRITE_TAC [GAUGE_TRIVIAL] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (SIMP_TAC [← MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                                              VSUM_CONTENT_NULL) th])) THEN
    ASM_SIMP_TAC [INTEGRAL_NULL, VECTOR_SUB_REFL, NORM_0])

  let EQUIINTEGRABLE_ON_SPLIT ← (do
    let lemma1 ← prove
     r"(!x k. (x,k) IN {x,f k | P x k} ==> Q x k) <=>
     (!x k. P x k ==> Q x (f k))"
     (REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN
      SET_TAC [])
    let lemma2 ← prove
     r"!f:B->B s:(A#B)->bool.
      FINITE s ==> FINITE {x,f k | (x,k) IN s /\ P x k}"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (\(x:A,k:B). x,(f k:B)) s") THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, lemma1, IN_IMAGE] THEN
      REWRITE_TAC [EXISTS_PAIR_THM, PAIR_EQ] THEN MESON_TAC [])
    let lemma3 ← prove
     r"!f:real^M->real^N g:(real^M->bool)->(real^M->bool) p.
     FINITE p
     ==> vsum {x,g k |x,k| (x,k) IN p /\ ~(g k = {})}
              (\(x,k). content k % f x) =
         vsum (IMAGE (\(x,k). x,g k) p) (\(x,k). content k % f x)"
     (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC VSUM_SUPERSET THEN
      ASM_SIMP_TAC [FINITE_IMAGE, lemma2] THEN
      REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_PAIR_THM, SUBSET, IN_IMAGE, EXISTS_PAIR_THM] THEN
      REWRITE_TAC [IN_ELIM_THM, PAIR_EQ, VECTOR_MUL_EQ_0] THEN
      MESON_TAC [CONTENT_EMPTY])
    let lemma4 ← prove
     r"(\(x,l). content (g l) % f x) =
     (\(x,l). content l % f x) o (\(x,l). x,g l)"
     (REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM])
    prove
     r"!fs:(real^M->real^N)->bool k a b c.
      fs equiintegrable_on (interval[a,b] INTER {x | x$k <= c}) /\
      fs equiintegrable_on (interval[a,b] INTER {x | x$k >= c}) /\
      1 <= k /\ k <= dimindex(:M)
      ==> fs equiintegrable_on (interval[a,b])"
     (REPEAT GEN_TAC THEN
      ASM_CASES_TAC (← q r"1 <= k /\ k <= dimindex(:M)") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [equiintegrable_on] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(a /\ b ==> c) /\ (a /\ b /\ c ==> a' /\ b' ==> c')
    ==> (a /\ a') /\ (b /\ b') ==> c /\ c'")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [integrable_on] THEN ASM MESON_TAC [HAS_INTEGRAL_SPLIT],
        STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"!f:real^M->real^N.
        f IN fs
        ==> integral (interval[a,b]) f =
                integral (interval [a,b] INTER {x | x$k <= c}) f +
                integral (interval [a,b] INTER {x | x$k >= c}) f")
       (fun th => SIMP_TAC [th])
      THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
        MATCH_MP_TAC HAS_INTEGRAL_SPLIT THEN
        MAP_EVERY EXISTS_TAC [← q r"k:num", ← q r"c:real"] THEN
        ASM_SIMP_TAC [← GSYM HAS_INTEGRAL_INTEGRAL],
        ALL_TAC] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"e / &2")) STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "I2"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "I1"))) THEN
      EXISTS_TAC (← q r"\x. if x$k = c then (d1(x:real^M) INTER d2(x)):real^M->bool
                  else ball(x,abs(x$k - c)) INTER d1(x) INTER d2(x)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [gauge] THEN GEN_TAC THEN
        RULE_ASSUM_TAC (REWRITE_RULE [gauge]) THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [OPEN_INTER, IN_INTER, OPEN_BALL, IN_BALL] THEN
        ASM_REWRITE_TAC [DIST_REFL, ← GSYM REAL_ABS_NZ, REAL_SUB_0],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"f:real^M->real^N") THEN
      X_GEN_TAC (← q r"p:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"(!x:real^M kk. (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k <= c} = {})
                    ==> x$k <= c) /\
     (!x:real^M kk. (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k >= c} = {})
                    ==> x$k >= c)")
      STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL, real_ge] THEN DISCH_THEN
         (MP_TAC o MATCH_MP (← SET_RULE (← q r"k SUBSET (a INTER b) ==> k SUBSET a"))) THEN
        REWRITE_TAC [SUBSET, IN_BALL, dist] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^M") MP_TAC) THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:real^M")) THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [REAL_NOT_LE, REAL_NOT_LT] THEN STRIP_TAC THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"abs((x - u:real^M)$k)") THEN
        ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
        ASM_SIMP_TAC [VECTOR_SUB_COMPONENT] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REMOVE_THEN "I2" (MP_TAC o SPEC
       (← q r"{(x:real^M,kk INTER {x:real^M | x$k >= c}) |x,kk|
     (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k >= c} = {})}") o
       SPEC (← q r"f:real^M->real^N")) THEN
      REMOVE_THEN "I1" (MP_TAC o SPEC
       (← q r"{(x:real^M,kk INTER {x:real^M | x$k <= c}) |x,kk|
     (x,kk) IN p /\ ~(kk INTER {x:real^M | x$k <= c} = {})}") o
       SPEC (← q r"f:real^M->real^N")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT
       (← q r"(a /\ b) /\ (a' /\ b' ==> c) ==> (a ==> a') ==> (b ==> b') ==> c")) THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        REWRITE_TAC [TAGGED_DIVISION_OF] THEN
        REPEAT (MATCH_MP_TAC (← TAUT
         (← q r"(a ==> (a' /\ a'')) /\ (b ==> (b' /\ d) /\ (b'' /\ e))
      ==> a /\ b ==> ((a' /\ b') /\ d) /\ ((a'' /\ b'') /\ e)")) THEN
          CONJ_TAC) THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [lemma1] THEN REWRITE_TAC [IMP_IMP] THENL
         [SIMP_TAC [lemma2],
          REWRITE_TAC [AND_FORALL_THM] THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^M") THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
          DISCH_THEN (fun th => CONJ_TAC THEN STRIP_TAC THEN MP_TAC th) THEN
          (ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
            [SIMP_TAC [IN_INTER, IN_ELIM_THM] THEN ASM_MESON_TAC [], ALL_TAC]) THEN
          (MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
          ASM_MESON_TAC [INTERVAL_SPLIT],
          DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
          (REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
           DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
           REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
           DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_SIMP_TAC [] THEN
           ANTS_TAC THENL [ASM_MESON_TAC [PAIR_EQ], ALL_TAC] THEN
           MATCH_MP_TAC (← SET_RULE
            (← q r"s SUBSET s' /\ t SUBSET t'
         ==> s' INTER t' = {} ==> s INTER t = {}")) THEN
           CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC []),
          ALL_TAC] THEN
        MATCH_MP_TAC (← TAUT (← q r"(a ==> b /\ c) /\ d /\ e
                       ==> (a ==> (b /\ d) /\ (c /\ e))")) THEN
        CONJ_TAC THENL
         [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
          DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [INTER_UNIONS] THEN
          ONCE_REWRITE_TAC [EXTENSION] THEN REWRITE_TAC [IN_UNIONS] THEN
          X_GEN_TAC (← q r"x:real^M") THEN AP_TERM_TAC THEN
          GEN_REWRITE_TAC I [FUN_EQ_THM] THEN X_GEN_TAC (← q r"kk:real^M->bool") THEN
          REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN MESON_TAC [NOT_IN_EMPTY],
          ALL_TAC] THEN
        CONJ_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
        REWRITE_TAC [fine, lemma1] THEN
        REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ASM_SIMP_TAC [] THEN SET_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e"))) THEN
      DISCH_THEN (MP_TAC o MATCH_MP NORM_TRIANGLE_LT) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"(a - i) + (b - j) = c - (i + j) <=> a + b = c:real^N")] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
     MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC
       (← q r"vsum p (\(x,l). content (l INTER {x:real^M | x$k <= c}) %
                     (f:real^M->real^N) x) +
    vsum p (\(x,l). content (l INTER {x:real^M | x$k >= c}) %
                     (f:real^M->real^N) x)") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        ASM_SIMP_TAC [← GSYM VSUM_ADD] THEN MATCH_MP_TAC VSUM_EQ THEN
        REWRITE_TAC [FORALL_PAIR_THM, ← GSYM VECTOR_ADD_RDISTRIB] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN
        DISCH_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^M", ← q r"l:real^M->bool"] o
                   elc 1) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [← GSYM CONTENT_SPLIT]] THEN
      ASM_SIMP_TAC [lemma3] THEN BINOP_TAC THEN
      (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [lemma4] THEN
       MATCH_MP_TAC VSUM_IMAGE_NONZERO THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
       REWRITE_TAC [PAIR_EQ] THEN
       ASM_MESON_TAC [TAGGED_DIVISION_SPLIT_LEFT_INJ, VECTOR_MUL_LZERO,
                      TAGGED_DIVISION_SPLIT_RIGHT_INJ])))

  let EQUIINTEGRABLE_DIVISION ← prove
   r"!fs:(real^M->real^N)->bool d a b.
        d division_of interval[a,b]
        ==> (fs equiintegrable_on interval[a,b] <=>
             !i. i IN d ==> fs equiintegrable_on i)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC OPERATIVE_DIVISION_AND THEN
    ASM_REWRITE_TAC [operative, NEUTRAL_AND] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
      ASM_SIMP_TAC [equiintegrable_on, INTEGRABLE_ON_NULL] THEN
      GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"\x:real^M. ball(x,&1)") THEN
      ASM_SIMP_TAC [GAUGE_TRIVIAL, INTEGRAL_NULL, VECTOR_SUB_RZERO] THEN
      REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"&0 < e ==> x = vec 0 ==> norm x < e"))) THEN
      MATCH_MP_TAC VSUM_EQ_0 THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ1_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [TAGGED_DIVISION_OF]) THEN
      ASM_MESON_TAC [CONTENT_EQ_0_INTERIOR, SUBSET_INTERIOR,
                     ← SET_RULE (← q r"s = {} <=> s SUBSET {}")],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M", ← q r"c:real", ← q r"k:num"] THEN
    STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [EQUIINTEGRABLE_ON_SPLIT]] THEN
    ASM_SIMP_TAC [INTEGRABLE_SPLIT, equiintegrable_on] THEN
    STRIP_TAC THEN CONJ_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
     ASM_CASES_TAC (← q r"gauge(d:real^M->real^M->bool)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"f:real^M->real^N") THEN
     ASM_CASES_TAC (← q r"(f:real^M->real^N) IN fs") THEN ASM_REWRITE_TAC [] THEN
     DISCH_TAC THEN
     MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M",
                       ← q r"d:real^M->real^M->bool", ← q r"e / &2"]
           HENSTOCK_LEMMA_PART1) THEN ASM_SIMP_TAC [REAL_HALF] THEN
     MATCH_MP_TAC MONO_FORALL THEN
     X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN
     DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ANTS_TAC THENL
      [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC TAGGED_PARTIAL_DIVISION_OF_SUBSET THEN
       RULE_ASSUM_TAC (REWRITE_RULE [tagged_division_of]) THEN
       ASM_MESON_TAC [INTER_SUBSET],
       ALL_TAC] THEN
     MATCH_MP_TAC (← NORM_ARITH
      (← q r"&0 < e /\ x:real^N = y ==> norm(x) <= e / &2 ==> norm(y) < e")) THEN
     ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
     W (MP_TAC o PART_MATCH (lhand o rand)
       INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN o rand o rand o snd) THEN
     ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT, INTEGRABLE_SPLIT] THEN
     DISCH_THEN SUBST1_TAC THEN
     FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
     ASM_SIMP_TAC [← GSYM VSUM_SUB] THEN MATCH_MP_TAC VSUM_EQ THEN
     REWRITE_TAC [FORALL_PAIR_THM]))

  pure { equiintegrable_on, EQUIINTEGRABLE_ON_SING, EQUIINTEGRABLE_ON_NULL,
         EQUIINTEGRABLE_ON_SPLIT, EQUIINTEGRABLE_DIVISION }

/- ------------------------------------------------------------------------- -/
/- Main limit theorem for an equiintegrable sequence; combining theorems for-/
/- the set of equiintegrable functions.  (integration.ml 13845-14157)       -/
/- ------------------------------------------------------------------------- -/

structure INAM where
  EQUIINTEGRABLE_LIMIT : thm
  EQUIINTEGRABLE_SUBSET : thm
  EQUIINTEGRABLE_UNION : thm
  EQUIINTEGRABLE_EQ : thm
  EQUIINTEGRABLE_CMUL : thm
  EQUIINTEGRABLE_ADD : thm
  EQUIINTEGRABLE_NEG : thm
  EQUIINTEGRABLE_SUB : thm
  EQUIINTEGRABLE_SUM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAM [HolBase] (D : IntegrationDeps) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINK : INK) (BINL : INL) (BINS : INS) (BINAL : INAL) : ExceptT String IO INAM := do
  -- @@SCOPE BEGIN
  let { GAUGE_INTER, .. } := BINB
  let { FINE_INTER, has_integral, integrable_on, TAGGED_DIVISION_OF,
        TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { INTEGRABLE_ADD, INTEGRABLE_CMUL, INTEGRABLE_ON_NULL, INTEGRABLE_VSUM, INTEGRAL_ADD,
        INTEGRAL_CMUL, INTEGRAL_NULL, INTEGRAL_UNIQUE, INTEGRAL_VSUM, .. } := BINE
  let { INTEGRABLE_SPIKE, INTEGRAL_EQ, NEGLIGIBLE_EMPTY, .. } := BINK
  let { INTEGRABLE_SUBINTERVAL, .. } := BINL
  let { INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN, .. } := BINS
  let { equiintegrable_on, .. } := BINAL
  let { CONJ_ASSOC, ETA_AX, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, GE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        REAL_ABS_POS, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_RMUL, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_RDIV_EQ, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_SYM, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { real_abs, SUM_RMUL, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { NORM_MUL, NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_SUB,
        VECTOR_SUB_LDISTRIB, VSUM_ADD, VSUM_EQ, VSUM_LMUL, VSUM_SUB, VSUM_SWAP, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { LIM_CMUL, LIM_CONST, LIM_SUB, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, basic_ss, GEN_SIMPLIFY_CONV, MESON, MESON_TAC,
        NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, TOP_DEPTH_SQCONV, .. } := D.dv.dg.pt.cvx
  let { CONVERGENT_EQ_CAUCHY, CONVERGENT_IMP_CAUCHY, .. } := D.dv.qtopology1
  let { cauchy, LIM_NORM_UBOUND, .. } := D.dv.qtopology2
  let { LAMBDA_PAIR_THM, .. } := D.qsession
  let { LIM_VSUM, .. } := D.qtopology
  let { VSUM_NORM_LE, .. } := D.qvec
  -- @@SCOPE END

  let EQUIINTEGRABLE_LIMIT ← prove
   r"!f g:real^M->real^N a b.
        {f n | n IN (:num)} equiintegrable_on interval[a,b] /\
        (!x. x IN interval[a,b] ==> ((\n. f n x) --> g x) sequentially)
        ==> g integrable_on interval[a,b] /\
            ((\n. integral(interval[a,b]) (f n)) --> integral(interval[a,b]) g)
            sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"content(interval[a:real^M,b]) = &0") THEN
    ASM_SIMP_TAC [INTEGRABLE_ON_NULL, INTEGRAL_NULL, LIM_CONST] THEN
    SUBGOAL_THEN (← q r"cauchy (\n. integral(interval[a,b]) (f n :real^M->real^N))")
    MP_TAC THENL
     [REWRITE_TAC [cauchy] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [equiintegrable_on]) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
      DISCH_TAC THEN REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP FINE_DIVISION_EXISTS) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:(real^M#(real^M->bool))->bool")
          STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPECL
       [← q r"n:num", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN SUBGOAL_THEN
       (← q r"cauchy (\n. vsum p (\(x,k:real^M->bool).
               content k % (f:num->real^M->real^N) n x))")
      MP_TAC THENL
       [MATCH_MP_TAC CONVERGENT_IMP_CAUCHY THEN
        EXISTS_TAC (← q r"vsum p (\(x,k:real^M->bool).
          content k % (g:real^M->real^N) x)") THEN
        MATCH_MP_TAC
         (← REWRITE_RULE [LAMBDA_PAIR_THM]
          (← REWRITE_RULE [FORALL_PAIR_THM]
           (← ISPECL [← q r"sequentially", ← q r"\(x:real^M,k:real^M->bool) (n:num).
                  content k % (f n x:real^N)"] LIM_VSUM))) THEN
        ASM_REWRITE_TAC [] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
        MATCH_MP_TAC LIM_CMUL THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        ASM_SIMP_TAC [SUBSET] THEN ASM_MESON_TAC [],
        REWRITE_TAC [cauchy] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM, GE] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"m:num") THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
        ASM_CASES_TAC (← q r"N:num <= m /\ N <= n") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(sm - gm:real^N) < e / &3 /\ norm(sn - gn) < e / &3
        ==> dist(sm,sn) < e / &3 ==> dist(gm,gn) < e")) THEN
        ASM_REWRITE_TAC []],
      REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"l:real^N")) THEN
      SUBGOAL_THEN (← q r"((g:real^M->real^N) has_integral l) (interval[a,b])")
       (fun th => ASM_MESON_TAC [th, integrable_on, INTEGRAL_UNIQUE]) THEN
      REWRITE_TAC [has_integral] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [equiintegrable_on]) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
      DISCH_TAC THEN REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"p:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
      EXISTS_TAC (← q r"\n:num. vsum p (\(x,k:real^M->bool). content k % f n x) -
                       integral (interval [a,b]) (f n :real^M->real^N)") THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [EVENTUALLY_TRUE] THEN
      MATCH_MP_TAC LIM_SUB THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      MATCH_MP_TAC
       (← REWRITE_RULE [LAMBDA_PAIR_THM]
        (← REWRITE_RULE [FORALL_PAIR_THM]
         (← ISPECL [← q r"sequentially", ← q r"\(x:real^M,k:real^M->bool) (n:num).
                content k % (f n x:real^N)"] LIM_VSUM))) THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
      MATCH_MP_TAC LIM_CMUL THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
      ASM_SIMP_TAC [SUBSET] THEN ASM_MESON_TAC []])

  let EQUIINTEGRABLE_SUBSET ← prove
   r"!fs gs s.
   fs equiintegrable_on s /\ gs SUBSET fs ==> gs equiintegrable_on s"
   (REWRITE_TAC [equiintegrable_on, SUBSET] THEN MESON_TAC [])

  let EQUIINTEGRABLE_UNION ← prove
   r"!fs:(real^M->real^N)->bool gs s.
        fs equiintegrable_on s /\ gs equiintegrable_on s
        ==> (fs UNION gs) equiintegrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [equiintegrable_on, IN_UNION] THEN
    REWRITE_TAC [← TAUT (← q r"a \/ b ==> c <=> (a ==> c) /\ (b ==> c)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real"))) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. (d1:real^M->real^M->bool) x INTER d2 x") THEN
    ASM_SIMP_TAC [GAUGE_INTER, FINE_INTER] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [])

  let EQUIINTEGRABLE_EQ ← prove
   r"!fs gs:(real^M->real^N)->bool s.
        fs equiintegrable_on s /\
        (!g. g IN gs ==> ?f. f IN fs /\ (!x. x IN s ==> f x = g x))
        ==> gs equiintegrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [equiintegrable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (LABEL_TAC "*")) THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"g:real^M->real^N") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"g:real^M->real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:real^M->real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:real^M->real^N")) THEN
      ASM_MESON_TAC [INTEGRABLE_SPIKE, IN_DIFF, NEGLIGIBLE_EMPTY],
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"g:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"] THEN
      STRIP_TAC THEN REMOVE_THEN "*" (MP_TAC o SPEC (← q r"g:real^M->real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:real^M->real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"f:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON []
       (← q r"x:real^N = y /\ a = b ==> norm(x - a) < e ==> norm(y - b) < e")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VSUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [TAGGED_DIVISION_OF, SUBSET]) THEN
        ASM_MESON_TAC [],
        ASM_MESON_TAC [INTEGRAL_EQ]]])

  let EQUIINTEGRABLE_CMUL ← prove
   r"!fs:(real^M->real^N)->bool s k.
        fs equiintegrable_on s
        ==> {(\x. c % f x) | abs(c) <= k /\ f IN fs} equiintegrable_on s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [equiintegrable_on, INTEGRABLE_CMUL, FORALL_IN_GSPEC] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RIGHT_IMP_FORALL_THM, INTEGRAL_CMUL, IMP_IMP] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / (abs(k) + &1)")) THEN
    ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_MUL_LZERO,
                  ← REAL_ARITH (← q r"&0 < abs(k) + &1")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"f:real^M->real^N",
                         ← q r"p:(real^M#(real^M->bool))->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o
     SPECL [← q r"f:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y /\ x <= c * y ==> x <= y * (c + &1)")) THEN
    REWRITE_TAC [NORM_POS_LE] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"!c. x = c * y /\ c *  y <= k * y ==> x <= k * y")) THEN
    EXISTS_TAC (← q r"abs c:real") THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM NORM_MUL, ← GSYM VSUM_LMUL, VECTOR_SUB_LDISTRIB] THEN
      REWRITE_TAC [LAMBDA_PAIR_THM, VECTOR_MUL_ASSOC, REAL_MUL_SYM],
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      ASM_REAL_ARITH_TAC])

  let EQUIINTEGRABLE_ADD ← prove
   r"!fs:(real^M->real^N)->bool gs s.
        fs equiintegrable_on s /\ gs equiintegrable_on s
        ==> {(\x. f x + g x) | f IN fs /\ g IN gs} equiintegrable_on s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [equiintegrable_on, INTEGRABLE_ADD, FORALL_IN_GSPEC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "f"))
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "g"))) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [RIGHT_IMP_FORALL_THM, INTEGRAL_ADD, IMP_IMP] THEN
    REMOVE_THEN "g" (MP_TAC o SPEC (← q r"e / &2")) THEN
    REMOVE_THEN "f" (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "f"))) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool")
     (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "g"))) THEN
    EXISTS_TAC (← q r"\x. (d1:real^M->real^M->bool) x INTER d2 x") THEN
    ASM_SIMP_TAC [GAUGE_INTER, FINE_INTER] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^M->real^N",
                         ← q r"p:(real^M#(real^M->bool))->bool"] THEN STRIP_TAC THEN
    REMOVE_THEN "g" (MP_TAC o SPECL
     [← q r"g:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
    REMOVE_THEN "f" (MP_TAC o SPECL
     [← q r"f:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
     (← q r"s + s' = t
    ==> norm(s - i) < e / &2 ==> norm(s' - i') < e / &2
        ==> norm(t - (i + i')) < e")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM VSUM_ADD] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM, VECTOR_ADD_LDISTRIB])

  let EQUIINTEGRABLE_NEG ← prove
   r"!fs:(real^M->real^N)->bool s.
        fs equiintegrable_on s
        ==> {(\x. --(f x)) | f IN fs} equiintegrable_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"&1") o MATCH_MP EQUIINTEGRABLE_CMUL) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] EQUIINTEGRABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"f:real^M->real^N") THEN DISCH_TAC THEN EXISTS_TAC (← q r"-- &1") THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LNEG, VECTOR_MUL_LID] THEN REAL_ARITH_TAC)

  let EQUIINTEGRABLE_SUB ← prove
   r"!fs:(real^M->real^N)->bool gs s.
        fs equiintegrable_on s /\ gs equiintegrable_on s
        ==> {(\x. f x - g x) | f IN fs /\ g IN gs} equiintegrable_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2
     MP_TAC (MP_TAC o MATCH_MP EQUIINTEGRABLE_NEG)) THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EQUIINTEGRABLE_ADD) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] EQUIINTEGRABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:real^M->real^N", ← q r"g:real^M->real^N"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"f:real^M->real^N") THEN
    EXISTS_TAC (← q r"\x. --((g:real^M->real^N) x)") THEN
    ASM_REWRITE_TAC [VECTOR_SUB] THEN EXISTS_TAC (← q r"g:real^M->real^N") THEN
    ASM_REWRITE_TAC [])

  let EQUIINTEGRABLE_SUM ← prove
   r"!fs:(real^M->real^N)->bool a b.
        fs equiintegrable_on interval[a,b]
        ==> {(\x. vsum t (\i. c i % f i x)) |
               FINITE t /\
               (!i:A. i IN t ==> &0 <= c i /\ (f i) IN fs) /\
               sum t c = &1}
            equiintegrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [equiintegrable_on] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, RIGHT_IMP_FORALL_THM] THEN
    STRIP_TAC THEN
    ASM (fun ths => tactic_of do
      pure (CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV
        (← ExceptT.mk (basic_ss [])) 5 ths))))
     [INTEGRABLE_CMUL, INTEGRABLE_VSUM, ETA_AX, INTEGRAL_VSUM] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MAP_EVERY X_GEN_TAC
     [← q r"t:A->bool", ← q r"c:A->real", ← q r"f:A->real^M->real^N",
      ← q r"p:(real^M#(real^M->bool))->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i:A. i IN t
          ==> integral (interval[a,b]) (\x:real^M. c i % f i x:real^N) =
              vsum p (\(x:real^M,k).
                       integral (k:real^M->bool) (\x:real^M. c i % f i x))")
     (fun th => SIMP_TAC [th])
    THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN THEN
      ASM_SIMP_TAC [INTEGRABLE_CMUL, ETA_AX],
      ALL_TAC] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    SUBGOAL_THEN
     (← q r"vsum p (\(x,k:real^M->bool). content k % vsum t (\i. c i % f i x)) =
    vsum t (\i. c i %
                vsum p (\(x,k). content k % (f:A->real^M->real^N) i x))")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM VSUM_LMUL] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) VSUM_SWAP o
        rand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC VSUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
      REWRITE_TAC [VECTOR_MUL_ASSOC, REAL_MUL_SYM],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"sum t (\i:A. c i * e / &2)") THEN CONJ_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [SUM_RMUL, ETA_AX, REAL_MUL_LID] THEN ASM_REAL_ARITH_TAC] THEN
    ASM_SIMP_TAC [← GSYM VSUM_SUB] THEN MATCH_MP_TAC VSUM_NORM_LE THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:A") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← GSYM VSUM_LMUL, ← GSYM VSUM_SUB] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM] THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(f:A->real^M->real^N) i", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
    ASM_SIMP_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP REAL_LT_IMP_LE) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"abs((c:A->real) i)") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_LMUL)) THEN
    ASM_REWRITE_TAC [REAL_ABS_POS, ← GSYM NORM_MUL] THEN
    ASM_SIMP_TAC [← GSYM VSUM_LMUL, VECTOR_SUB_LDISTRIB, real_abs] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= a ==> y <= a")) THEN
    AP_TERM_TAC THEN
    SUBGOAL_THEN
     (← q r"integral (interval[a,b]) ((f:A->real^M->real^N) i) =
    vsum p (\(x:real^M,k). integral (k:real^M->bool) (f i))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM VSUM_LMUL, ← GSYM VSUM_SUB] THEN
    MATCH_MP_TAC VSUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
    AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_CMUL THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TAGGED_DIVISION_OF]) THEN
    ASM_MESON_TAC [INTEGRABLE_SUBINTERVAL])

  pure { EQUIINTEGRABLE_LIMIT, EQUIINTEGRABLE_SUBSET, EQUIINTEGRABLE_UNION,
         EQUIINTEGRABLE_EQ, EQUIINTEGRABLE_CMUL, EQUIINTEGRABLE_ADD, EQUIINTEGRABLE_NEG,
         EQUIINTEGRABLE_SUB, EQUIINTEGRABLE_SUM }

/- ------------------------------------------------------------------------- -/
/- Equiintegrability under uniform limits and reflection.                   -/
/- (integration.ml 14158-14349)                                             -/
/- ------------------------------------------------------------------------- -/

structure INAN where
  EQUIINTEGRABLE_UNIFORM_LIMIT : thm
  EQUIINTEGRABLE_REFLECT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAN [HolBase] (D : IntegrationDeps) (BINB : INB) (BINC : INC) (BINI : INI) (BINO : INO) (BINAL : INAL) (BINAM : INAM) : ExceptT String IO INAN := do
  -- @@SCOPE BEGIN
  let { gauge, .. } := BINB
  let { fine, TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { INTEGRABLE_UNIFORM_LIMIT, .. } := BINI
  let { CONTENT_IMAGE_AFFINITY_INTERVAL, INTEGRABLE_REFLECT, INTEGRAL_REFLECT, .. } := BINO
  let { equiintegrable_on, .. } := BINAL
  let { EQUIINTEGRABLE_LIMIT, EQUIINTEGRABLE_SUBSET, .. } := BINAM
  let { EXISTS_PAIR_THM, EXTENSION, FINITE_IMAGE, FORALL_AND_THM, FORALL_IN_GSPEC, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, FUN_EQ_THM, FUN_IN_IMAGE, IMAGE_ID, IMAGE_o,
        IMP_CONJ, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIONS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, PAIR_EQ, REAL_ABS_NEG, REAL_ABS_NUM, REAL_ARCH_INV, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_INV2, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POW_ONE,
        RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, UNWIND_THM1, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { dist, VECTOR_NEG_NEG, VSUM_EQ, VSUM_IMAGE, .. } := D.dv.dg.pt.cvx.vec4
  let { LIM_CMUL, LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { REAL_LT_TRANS, .. } := D.dv.dg.qsession
  let { LAMBDA_PAIR_THM, .. } := D.qsession
  let { INTERIOR_NEGATIONS, LIM_VSUM, OPEN_NEGATIONS, .. } := D.qtopology
  let { IN_INTERVAL_REFLECT, .. } := D.qvec
  -- @@SCOPE END

  let EQUIINTEGRABLE_UNIFORM_LIMIT ← prove
   r"!fs:(real^M->real^N)->bool a b.
        fs equiintegrable_on interval[a,b]
        ==> {g | !e. &0 < e
                     ==> ?f. f IN fs /\
                             !x. x IN interval[a,b] ==> norm(g x - f x) < e}
            equiintegrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [equiintegrable_on]) THEN
    REWRITE_TAC [equiintegrable_on, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_UNIFORM_LIMIT, REAL_LT_IMP_LE], ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN MAP_EVERY X_GEN_TAC
     [← q r"g:real^M->real^N", ← q r"p:(real^M#(real^M->bool))->bool"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    SUBGOAL_THEN (← q r"(g:real^M->real^N) integrable_on interval[a,b]")
    ASSUME_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_UNIFORM_LIMIT, REAL_LT_IMP_LE], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:num->real^M->real^N") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN interval[a,b]
        ==> ((\n. f n x) --> (g:real^M->real^N) x) sequentially")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN X_GEN_TAC (← q r"k:real") THEN DISCH_TAC THEN
      MP_TAC (← SPEC (← q r"k:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      REWRITE_TAC [← NORM_ARITH (← q r"dist(a:real^N,b) = norm(b - a)")] THEN
      MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"inv(&n + &1)") THEN
      ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:num->real^M->real^N", ← q r"g:real^M->real^N",
                      ← q r"a:real^M", ← q r"b:real^M"] EQUIINTEGRABLE_LIMIT) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQUIINTEGRABLE_SUBSET THEN
      EXISTS_TAC (← q r"fs:(real^M->real^N)->bool") THEN ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*"))] THEN
    SUBGOAL_THEN
     (← q r"((\n. vsum p (\(x,k:real^M->bool).
                    content k % (f:num->real^M->real^N) n x)) -->
     vsum p (\(x,k). content k % g x)) sequentially")
     (LABEL_TAC "+")
    THENL
     [MATCH_MP_TAC
         (← REWRITE_RULE [LAMBDA_PAIR_THM]
          (← REWRITE_RULE [FORALL_PAIR_THM]
           (← ISPECL [← q r"sequentially", ← q r"\(x:real^M,k:real^M->bool) (n:num).
                  content k % (f n x:real^N)"] LIM_VSUM))) THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
      MATCH_MP_TAC LIM_CMUL THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
      ASM_SIMP_TAC [SUBSET] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o REWRITE_RULE [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [dist]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") (LABEL_TAC "*")) THEN
    REMOVE_THEN "+" (MP_TAC o REWRITE_RULE [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [dist]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") (LABEL_TAC "+")) THEN
    SUBGOAL_THEN (← q r"?n:num. N1 <= n /\ N2 <= n") STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"N1 + N2:num") THEN ARITH_TAC, ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"n:num")) THEN
    REMOVE_THEN "+" (MP_TAC o SPEC (← q r"n:num")) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(f:num->real^M->real^N) n", ← q r"p:(real^M#(real^M->bool))->bool"]) THEN
    ASM_REWRITE_TAC [] THEN NORM_ARITH_TAC)

  let EQUIINTEGRABLE_REFLECT ← (do
    let lemma ← prove
     r"(!x k. (x,k) IN IMAGE (\(x,k). f x k,g x k) s ==> Q x k) <=>
     (!x k. (x,k) IN s ==> Q (f x k) (g x k))"
     (REWRITE_TAC [IN_IMAGE, PAIR_EQ, EXISTS_PAIR_THM] THEN SET_TAC [])
    prove
     r"!fs:(real^M->real^N)->bool a b.
        fs equiintegrable_on interval[a,b]
        ==> {(\x. f(--x)) | f IN fs} equiintegrable_on interval[--b,--a]"
     (REPEAT GEN_TAC THEN REWRITE_TAC [equiintegrable_on] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
      DISCH_TAC THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [INTEGRABLE_REFLECT, INTEGRAL_REFLECT] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o
        check (fun (t : thm) => HolCore.Basics.is_forall (concl t))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. IMAGE (--) ((d:real^M->real^M->bool) (--x))") THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [gauge]) THEN
        SIMP_TAC [gauge, OPEN_NEGATIONS] THEN DISCH_TAC THEN
        GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_NEG_NEG] THEN
        MATCH_MP_TAC FUN_IN_IMAGE THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"f:real^M->real^N") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"p:real^M#(real^M->bool)->bool") THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:real^M->real^N")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC
       (← q r"IMAGE (\(x,k). (--x:real^M,IMAGE (--) (k:real^M->bool))) p")) THEN
      ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [TAGGED_DIVISION_OF]) THEN
        REWRITE_TAC [TAGGED_DIVISION_OF] THEN
        STRIP_TAC THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
        REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, lemma] THEN
        REPEAT CONJ_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
          ASM_SIMP_TAC [FUN_IN_IMAGE] THEN CONJ_TAC THENL
           [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
            ONCE_REWRITE_TAC [← GSYM IN_INTERVAL_REFLECT] THEN
            ASM_SIMP_TAC [VECTOR_NEG_NEG, ← GSYM SUBSET] THEN ASM_MESON_TAC [],
            REWRITE_TAC [EXTENSION, IN_IMAGE] THEN
            REWRITE_TAC [← VECTOR_ARITH (← q r"x:real^N = --y <=> --x = y")] THEN
            ONCE_REWRITE_TAC [← GSYM IN_INTERVAL_REFLECT] THEN
            REWRITE_TAC [UNWIND_THM1] THEN
            SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]")
             (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
            THENL [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC] THEN
            ASM_MESON_TAC [VECTOR_NEG_NEG]],
          MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
          MAP_EVERY X_GEN_TAC [← q r"y:real^M", ← q r"l:real^M->bool"] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"x:real^M", ← q r"k:real^M->bool",
            ← q r"y:real^M", ← q r"l:real^M->bool"]) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_IMP THEN
          CONJ_TAC THENL [MESON_TAC [PAIR_EQ], ALL_TAC] THEN
          REWRITE_TAC [INTERIOR_NEGATIONS] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. f(f x) = x)
        ==> s INTER t = {} ==> IMAGE f s INTER IMAGE f t = {}")) THEN
          REWRITE_TAC [VECTOR_NEG_NEG],
          GEN_REWRITE_TAC I [EXTENSION] THEN
          ONCE_REWRITE_TAC [← GSYM IN_INTERVAL_REFLECT] THEN
          FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN X_GEN_TAC (← q r"y:real^M") THEN
          REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
          MATCH_MP_TAC (← MESON []
           (← q r"!f. (!x. f(f x) = x) /\ (!x. P x <=> Q(f x))
            ==> ((?x. P x) <=> (?x. Q x))")) THEN
          EXISTS_TAC (← q r"IMAGE ((--):real^M->real^M)") THEN CONJ_TAC THENL
           [REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_NEG_NEG, IMAGE_ID],
            ALL_TAC] THEN
          X_GEN_TAC (← q r"t:real^M->bool") THEN BINOP_TAC THENL
           [REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, PAIR_EQ] THEN
            SUBGOAL_THEN (← q r"!k:real^M->bool. IMAGE (--) (IMAGE (--) k) = k")
            MP_TAC THENL
             [REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_NEG_NEG, IMAGE_ID],
              MESON_TAC []],
            MATCH_MP_TAC (← SET_RULE
             (← q r"(!x. f(f x) = x) ==> (y IN s <=> f y IN IMAGE f s)")) THEN
            REWRITE_TAC [VECTOR_NEG_NEG]]],
        ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
          REWRITE_TAC [fine, lemma] THEN
          REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
          MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. f(f x) = x) ==> k SUBSET IMAGE f s ==> IMAGE f k SUBSET s")) THEN
          REWRITE_TAC [VECTOR_NEG_NEG],
          ALL_TAC] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"x:real^N = y ==> norm(x - i) < e ==> norm(y - i) < e")) THEN
        W (MP_TAC o PART_MATCH (lhs o rand) VSUM_IMAGE o lhs o snd) THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [MATCH_MP_TAC (← MESON []
           (← q r"(!x. f(f x) = x)
        ==> !x y. x IN p /\ y IN p /\ f x = f y ==> x = y")) THEN
          REWRITE_TAC [FORALL_PAIR_THM, ← GSYM IMAGE_o, o_DEF, VECTOR_NEG_NEG,
                       IMAGE_ID],
          DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC VSUM_EQ THEN
          REWRITE_TAC [FORALL_PAIR_THM, o_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]")
           (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
          THENL [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC] THEN
          AP_THM_TAC THEN AP_TERM_TAC THEN
          SUBGOAL_THEN (← q r"(--):real^M->real^M = (\x. --(&1) % x + vec 0)") SUBST1_TAC
          THENL [REWRITE_TAC [FUN_EQ_THM] THEN VECTOR_ARITH_TAC, ALL_TAC] THEN
          REWRITE_TAC [CONTENT_IMAGE_AFFINITY_INTERVAL, REAL_ABS_NEG] THEN
          REWRITE_TAC [REAL_POW_ONE, REAL_MUL_LID, REAL_ABS_NUM]]]))

  pure { EQUIINTEGRABLE_UNIFORM_LIMIT, EQUIINTEGRABLE_REFLECT }

/- ------------------------------------------------------------------------- -/
/- Some technical lemmas about minimizing a "flat" part of a sum over a     -/
/- division.  (integration.ml 14350-14733)                                  -/
/- ------------------------------------------------------------------------- -/

structure INAO where
  SUM_CONTENT_AREA_OVER_THIN_DIVISION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAO [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINF : INF) (BINH : INH) : ExceptT String IO INAO := do
  -- @@SCOPE BEGIN
  let { content, CONTENT_0_SUBSET, CONTENT_EMPTY, CONTENT_EQ_0, CONTENT_EQ_0_INTERIOR,
        CONTENT_LT_NZ, CONTENT_POS_LE, CONTENT_POS_LT_EQ, CONTENT_SUBSET,
        INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION, .. } := BINB
  let { CONTENT_SPLIT, DIVISION_SPLIT_LEFT_INJ, DIVISION_SPLIT_RIGHT_INJ, INTERVAL_SPLIT, ..
        } := BINF
  let { SUBADDITIVE_CONTENT_DIVISION, .. } := BINH
  let { AND_FORALL_THM, CONTRAPOS_THM, FINITE_DELETE, FINITE_IMAGE, FINITE_NUMSEG,
        FINITE_RESTRICT, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, IN_DELETE, INTER_IDEMPOT, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIONS, LAMBDA_BETA, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_FORALL, MONO_IMP, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE,
        REAL_SUB_LE, REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET,
        SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_THM, real_div, real_ge, SUM_ADD, SUM_EQ, SUM_EQ_0, SUM_LE, SUM_LMUL, SUM_SUPERSET,
        UNIONS_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { INTERIOR_CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top4
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, REAL_RING, SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { PRODUCT_EQ, PRODUCT_EQ_0_NUMSEG, PRODUCT_POS_LE, .. } := D.qproducts
  let { PRODUCT_CLAUSES, SUM_IMAGE_NONZERO, .. } := D.qsession
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let SUM_CONTENT_AREA_OVER_THIN_DIVISION ← (do
    let lemma0 ← prove
     r"!k:real^M->bool i.
          1 <= i /\ i <= dimindex(:M)
          ==> content k / (interval_upperbound k$i - interval_lowerbound k$i) =
              if content k = &0 then &0
              else product ((1..dimindex(:M)) DELETE i)
                           (\j. interval_upperbound k$j -
                                interval_lowerbound k$j)"
     (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN
      REWRITE_TAC [content] THEN
      COND_CASES_TAC THENL [ASM_MESON_TAC [CONTENT_EMPTY], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"1..dimindex(:M) = i INSERT ((1..dimindex(:M)) DELETE i)")
      MP_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"s = x INSERT (s DELETE x) <=> x IN s")] THEN
        ASM_REWRITE_TAC [IN_NUMSEG],
        DISCH_THEN (fun th => GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
         [th])] THEN
      ASM_SIMP_TAC [PRODUCT_CLAUSES, IN_NUMSEG, FINITE_DELETE, FINITE_NUMSEG,
                    IN_DELETE] THEN
      MATCH_MP_TAC (← REAL_FIELD (← q r"~(y = &0) ==> (y * x) * inv y = x")) THEN
      DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(content(k:real^M->bool) = &0)") THEN
      ASM_REWRITE_TAC [content, PRODUCT_EQ_0_NUMSEG] THEN ASM_MESON_TAC [])
    let lemma1 ← prove
     r"!d a b:real^M s i.
          d division_of s /\ s SUBSET interval[a,b] /\
          1 <= i /\ i <= dimindex(:M) /\
          ((!k. k IN d
                ==> ~(content k = &0) /\ ~(k INTER {x | x$i = a$i} = {})) \/
           (!k. k IN d
                ==> ~(content k = &0) /\ ~(k INTER {x | x$i = b$i} = {})))
          ==> (b$i - a$i) *
              sum d (\k. content k /
                         (interval_upperbound k$i - interval_lowerbound k$i))
              <= content(interval[a,b])"
     (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      ABBREV_TAC
       (← q r"extend =
      \k:real^M->bool. interval
           [(lambda j. if j = i then (a:real^M)$i
                       else interval_lowerbound k$j):real^M,
            (lambda j. if j = i then (b:real^M)$i
                       else interval_upperbound k$j)]") THEN
      SUBGOAL_THEN (← q r"!k. k IN d ==> k SUBSET interval[a:real^M,b]")
      ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!k:real^M->bool. k IN d ==> ~(k = {})") ASSUME_TAC THENL
       [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(!k. k IN d ==> ~((extend:(real^M->bool)->(real^M->bool)) k = {})) /\
      (!k. k IN d ==> extend k SUBSET interval[a,b])")
      STRIP_ASSUME_TAC THENL
       [FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
        CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN
        (DISCH_TAC THEN EXPAND_TAC "extend" THEN
         SUBGOAL_THEN (← q r"interval[u:real^M,v] SUBSET interval[a,b]") MP_TAC THENL
          [ASM_SIMP_TAC [], ALL_TAC] THEN
         SUBGOAL_THEN (← q r"~(interval[u:real^M,v] = {})") MP_TAC THENL
          [ASM_SIMP_TAC [], ALL_TAC] THEN
         SIMP_TAC [SUBSET_INTERVAL, INTERVAL_NE_EMPTY, LAMBDA_BETA,
                   INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND] THEN
         MESON_TAC [REAL_LE_TRANS, REAL_LE_REFL]),
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!k1 k2. k1 IN d /\ k2 IN d /\ ~(k1 = k2)
              ==> interior((extend:(real^M->bool)->(real^M->bool)) k1) INTER
                  interior(extend k2) = {}")
      ASSUME_TAC THENL
       [REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"w:real^M", ← q r"z:real^M"] THEN DISCH_TAC THEN
        DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        DISCH_THEN (MP_TAC o elc 2) THEN DISCH_THEN (MP_TAC o SPECL
         [← q r"interval[u:real^M,v]", ← q r"interval[w:real^M,z]"]) THEN
        ASM_REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
        EXPAND_TAC "extend" THEN
        SIMP_TAC [INTERIOR_CLOSED_INTERVAL, IN_INTERVAL, LAMBDA_BETA] THEN
        SUBGOAL_THEN (← q r"~(interval[u:real^M,v] = {}) /\
                    ~(interval[w:real^M,z] = {})")
        MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
        SIMP_TAC [SUBSET_INTERVAL, INTERVAL_NE_EMPTY, LAMBDA_BETA,
                  INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND] THEN
        STRIP_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"x:real^M") MP_TAC) THEN
        MP_TAC (← MESON []
         (← q r"(!P. (!j:num. P j) <=> P i /\ (!j. ~(j = i) ==> P j))")) THEN
        DISCH_THEN (fun th => GEN_REWRITE_TAC
         (LAND_CONV o ONCE_DEPTH_CONV) [th]) THEN
        ASM_SIMP_TAC [IMP_IMP] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (DISJ_CASES_THEN
         (fun th => tactic_of do
           pure (MP_TAC (← SPEC (← q r"interval[u:real^M,v]") th) THEN
                 MP_TAC (← SPEC (← q r"interval[w:real^M,z]") th)))) THEN
        ASM_REWRITE_TAC [CONTENT_EQ_0_INTERIOR, INTERIOR_CLOSED_INTERVAL] THEN
        REWRITE_TAC [IMP_CONJ, ← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_ELIM_THM] THEN
        REWRITE_TAC [IN_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"q:real^M") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"r:real^M") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"s:real^M") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"t:real^M") THEN STRIP_TAC THENL
         [EXISTS_TAC (← q r"(lambda j. if j = i then min ((q:real^M)$i) ((s:real^M)$i)
                               else (x:real^M)$j):real^M"),
          EXISTS_TAC (← q r"(lambda j. if j = i then max ((q:real^M)$i) ((s:real^M)$i)
                               else (x:real^M)$j):real^M")] THEN
        (SIMP_TAC [AND_FORALL_THM, LAMBDA_BETA] THEN X_GEN_TAC (← q r"j:num") THEN
         ASM_CASES_TAC (← q r"j:num = i") THEN ASM_SIMP_TAC [] THEN
         UNDISCH_THEN (← q r"j:num = i") SUBST_ALL_TAC THEN
         SUBGOAL_THEN (← q r"interval[u:real^M,v] SUBSET interval[a,b] /\
                     interval[w:real^M,z] SUBSET interval[a,b]")
         MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
         SUBGOAL_THEN (← q r"~(interval[u:real^M,v] = {}) /\
                     ~(interval[w:real^M,z] = {})")
         MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
         SIMP_TAC [INTERVAL_NE_EMPTY, SUBSET_INTERVAL] THEN
         REPEAT STRIP_TAC THEN
         REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN ASM_REWRITE_TAC [] THEN
         ASM_REAL_ARITH_TAC),
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
       (← q r"sum (IMAGE (extend:(real^M->bool)->(real^M->bool)) d) content") THEN
      CONJ_TAC THENL
       [W (MP_TAC o PART_MATCH (lhs o rand) SUM_IMAGE_NONZERO o rand o snd) THEN
        ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN
          MAP_EVERY X_GEN_TAC [← q r"k1:real^M->bool", ← q r"k2:real^M->bool"] THEN
          STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
           [← q r"k1:real^M->bool", ← q r"k2:real^M->bool"]) THEN
          ASM_REWRITE_TAC [INTER_IDEMPOT] THEN
          EXPAND_TAC "extend" THEN REWRITE_TAC [CONTENT_EQ_0_INTERIOR],
          DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [← GSYM SUM_LMUL] THEN
          MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
          MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN DISCH_TAC THEN
          ASM_CASES_TAC (← q r"content(interval[u:real^M,v]) = &0") THENL
           [ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO, REAL_MUL_RZERO, o_THM] THEN
            EXPAND_TAC "extend" THEN REWRITE_TAC [CONTENT_POS_LE],
            ALL_TAC] THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM CONTENT_LT_NZ]) THEN
          DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
          REWRITE_TAC [CONTENT_POS_LT_EQ] THEN STRIP_TAC THEN
          ASM_SIMP_TAC [INTERVAL_LOWERBOUND, INTERVAL_UPPERBOUND,
                        REAL_LT_IMP_LE, real_div, REAL_MUL_ASSOC] THEN
          ASM_SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_SUB_LT] THEN
          SUBGOAL_THEN
           (← q r"~((extend:(real^M->bool)->(real^M->bool)) (interval[u,v]) = {})")
          MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
          EXPAND_TAC "extend" THEN ASM_SIMP_TAC [content, o_THM] THEN
          ASM_SIMP_TAC [INTERVAL_NE_EMPTY, INTERVAL_LOWERBOUND,
                        INTERVAL_UPPERBOUND, REAL_LT_IMP_LE] THEN
          DISCH_THEN (K ALL_TAC) THEN
          SUBGOAL_THEN
           (← q r"1..dimindex(:M) = i INSERT ((1..dimindex(:M)) DELETE i)")
          SUBST1_TAC THENL
           [MATCH_MP_TAC (← SET_RULE (← q r"x IN s ==> s = x INSERT (s DELETE x)")) THEN
            ASM_REWRITE_TAC [IN_NUMSEG],
            ALL_TAC] THEN
          SIMP_TAC [PRODUCT_CLAUSES, FINITE_NUMSEG, FINITE_DELETE] THEN
          ASM_SIMP_TAC [IN_DELETE, IN_NUMSEG, LAMBDA_BETA] THEN
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC (← REAL_RING
            (← q r"x:real = y ==> ab * uv * x = (ab * y) * uv")) THEN
          MATCH_MP_TAC PRODUCT_EQ THEN
          SIMP_TAC [IN_DELETE, IN_NUMSEG, LAMBDA_BETA]],
        MATCH_MP_TAC SUBADDITIVE_CONTENT_DIVISION THEN EXISTS_TAC
         (← q r"UNIONS (IMAGE (extend:(real^M->bool)->(real^M->bool)) d)") THEN
        ASM_SIMP_TAC [UNIONS_SUBSET, division_of, FINITE_IMAGE] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
        REPEAT CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN
        DISCH_TAC THENL
         [CONJ_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC []] THEN
          EXPAND_TAC "extend" THEN REWRITE_TAC [] THEN MESON_TAC [],
          ASM_MESON_TAC [],
          ASM_SIMP_TAC []]])
    prove
     r"!d a b:real^M s i c.
        d division_of s /\ s SUBSET interval[a,b] /\
        1 <= i /\ i <= dimindex(:M) /\ a$i <= c /\ c <= b$i /\
        (!k. k IN d ==> ~(k INTER {x | x$i = c} = {}))
        ==> (b$i - a$i) *
            sum d (\k. content k /
                       (interval_upperbound k$i - interval_lowerbound k$i))
            <= &2 * content(interval[a,b])"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"content(interval[a:real^M,b]) = &0") THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 /\ &0 <= y ==> x <= &2 * y")) THEN
        REWRITE_TAC [CONTENT_POS_LE, REAL_ENTIRE] THEN DISJ2_TAC THEN
        MATCH_MP_TAC SUM_EQ_0 THEN X_GEN_TAC (← q r"k:real^M->bool") THEN
        DISCH_TAC THEN REWRITE_TAC [real_div, REAL_ENTIRE] THEN DISJ1_TAC THEN
        MATCH_MP_TAC CONTENT_0_SUBSET THEN
        MAP_EVERY EXISTS_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
        ASM_MESON_TAC [division_of, SUBSET_TRANS],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [← GSYM CONTENT_LT_NZ]) THEN
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
      REWRITE_TAC [CONTENT_POS_LT_EQ] THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      MP_TAC (← ISPECL
       [← q r"{k | k IN {l INTER {x | x$i <= c} | l |
                l IN d /\ ~(l INTER {x:real^M | x$i <= c} = {})} /\
          ~(content k = &0)}",
        ← q r"a:real^M",
        ← q r"(lambda j. if j = i then c else (b:real^M)$j):real^M",
        ← q r"UNIONS {k | k IN {l INTER {x | x$i <= c} | l |
                       l IN d /\ ~(l INTER {x:real^M | x$i <= c} = {})} /\
                 ~(content k = &0)}",
        ← q r"i:num"] lemma1) THEN
      MP_TAC (← ISPECL
       [← q r"{k | k IN {l INTER {x | x$i >= c} | l |
                l IN d /\ ~(l INTER {x:real^M | x$i >= c} = {})} /\
          ~(content k = &0)}",
        ← q r"(lambda j. if j = i then c else (a:real^M)$j):real^M",
        ← q r"b:real^M",
        ← q r"UNIONS {k | k IN {l INTER {x | x$i >= c} | l |
                       l IN d /\ ~(l INTER {x:real^M | x$i >= c} = {})} /\
                 ~(content k = &0)}",
        ← q r"i:num"] lemma1) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT
       (← q r"(p1 /\ p2) /\ (q1 /\ q2 ==> r) ==> (p2 ==> q2) ==> (p1 ==> q1) ==> r")) THEN
      CONJ_TAC THENL
       [CONJ_TAC THEN
        (REPEAT CONJ_TAC THENL
         [REWRITE_TAC [division_of] THEN CONJ_TAC THENL
           [MATCH_MP_TAC FINITE_RESTRICT THEN
            ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
            MATCH_MP_TAC FINITE_IMAGE THEN MATCH_MP_TAC FINITE_RESTRICT THEN
            ASM_REWRITE_TAC [],
            ALL_TAC] THEN
          REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
          CONJ_TAC THENL
           [FIRST_ASSUM (fun th => tactic_of do
              pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
            MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN
            REPEAT DISCH_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
             [REWRITE_TAC [IN_ELIM_THM, SUBSET, IN_UNIONS] THEN ASM_MESON_TAC [],
