structure INAR where
  EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_GE : thm
  EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_LT : thm
  EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_GT : thm
  EQUIINTEGRABLE_OPEN_INTERVAL_RESTRICTIONS : thm
  EQUIINTEGRABLE_CLOSED_INTERVAL_RESTRICTIONS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAR [HolBase] (D : IntegrationDeps) (BINAL : INAL) (BINAM : INAM) (BINAN : INAN) (BINAQ : INAQ) : ExceptT String IO INAR := do
  -- @@SCOPE BEGIN
  let { EQUIINTEGRABLE_ON_SING, .. } := BINAL
  let { EQUIINTEGRABLE_SUB, EQUIINTEGRABLE_SUBSET, EQUIINTEGRABLE_UNION, .. } := BINAM
  let { EQUIINTEGRABLE_REFLECT, .. } := BINAN
  let { EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_LE, .. } := BINAQ
  let { ETA_AX, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIV, LE,
        LE_REFL, LEFT_OR_DISTRIB, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { num_INDUCTION, real_ge, real_gt, .. } := D.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { IN_INTERVAL_REFLECT, .. } := D.qvec
  -- @@SCOPE END

  let EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_GE ← prove
   r"!fs f:real^M->real^N a b.
        fs equiintegrable_on interval[a,b] /\ f IN fs /\
        (!h x. h IN fs /\ x IN interval[a,b] ==> norm(h x) <= norm(f x))
        ==> { (\x. if x$i >= c then h x else vec 0) |
              i IN 1..dimindex(:M) /\ c IN (:real) /\ h IN fs }
            equiintegrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"{\x. (f:real^M->real^N) (--x) | f IN fs}",
      ← q r"\x. (f:real^M->real^N)(--x)",
      ← q r"--b:real^M", ← q r"--a:real^M"]
          EQUIINTEGRABLE_HALFSPACE_RESTRICTIONS_LE) THEN
    ASM_SIMP_TAC [EQUIINTEGRABLE_REFLECT] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      ONCE_REWRITE_TAC [← GSYM IN_INTERVAL_REFLECT] THEN
