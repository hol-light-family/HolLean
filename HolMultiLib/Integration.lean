  let HENSTOCK_LEMMA ← prove
   r"!f:real^M->real^N a b.
        f integrable_on interval[a,b]
        ==> !e. &0 < e
                ==> ?d. gauge d /\
                        !p. p tagged_partial_division_of interval[a,b] /\
                            d fine p
                            ==> sum p (\(x,k). norm(content k % f x -
                                                    integral k f)) < e"
   (MP_TAC HENSTOCK_LEMMA_PART2 THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN
            STRIP_TAC THEN MP_TAC th)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
    GEN_REWRITE_TAC LAND_CONV [has_integral] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / (&2 * (&(dimindex(:N)) + &1))")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &2 * (&n + &1)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"d:real^M->real^M->bool", ← q r"e / (&2 * (&(dimindex(:N)) + &1))"]) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &2 * (&n + &1)")] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (EXISTS_TAC (← q r"d:real^M->real^M->bool") THEN MP_TAC th)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"d < e ==> x <= d ==> x < e")) THEN
    REWRITE_TAC [real_div, REAL_INV_MUL, REAL_INV_INV, REAL_MUL_ASSOC] THEN
    SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    UNDISCH_TAC (← q r"&0 < e") THEN REAL_ARITH_TAC)

  pure { HAS_INTEGRAL_COMBINE_DIVISION, INTEGRAL_COMBINE_DIVISION_BOTTOMUP,
         HAS_INTEGRAL_COMBINE_DIVISION_TOPDOWN, INTEGRAL_COMBINE_DIVISION_TOPDOWN,
         INTEGRABLE_COMBINE_DIVISION, INTEGRABLE_ON_SUBDIVISION,
         HAS_INTEGRAL_COMBINE_TAGGED_DIVISION, INTEGRAL_COMBINE_TAGGED_DIVISION_BOTTOMUP,
         HAS_INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN,
         INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN, HENSTOCK_LEMMA_PART1,
         HENSTOCK_LEMMA_PART2, HENSTOCK_LEMMA }

/- ------------------------------------------------------------------------- -/
/- Monotone convergence, bounded interval first.  (integration.ml 7790-8022) -/
/- ------------------------------------------------------------------------- -/

structure INT where
  MONOTONE_CONVERGENCE_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINT [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINH : INH) (BINI : INI) (BINL : INL) (BINS : INS) : ExceptT String IO INT := do
  -- @@SCOPE BEGIN
  let { CONTENT_LT_NZ, CONTENT_POS_LE, .. } := BINA
  let { gauge, .. } := BINB
  let { fine, has_integral, HAS_INTEGRAL_INTEGRAL, integrable_on, TAGGED_DIVISION_OF,
        tagged_division_of, TAGGED_DIVISION_OF_FINITE, TAGGED_PARTIAL_DIVISION_SUBSET, .. }
        := BINC
  let { INTEGRABLE_ON_NULL, INTEGRAL_NULL, INTEGRAL_UNIQUE, .. } := BINE
  let { ADDITIVE_CONTENT_TAGGED_DIVISION, .. } := BINH
  let { INTEGRAL_DROP_LE, .. } := BINI
  let { INTEGRABLE_SUBINTERVAL, .. } := BINL
  let { HENSTOCK_LEMMA_PART1, INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN, .. } := BINS
  let { ARITH, EXTENSION, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMP_IMP, IN_ELIM_PAIR_THM, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, REAL_ABS_POS, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_LMUL_EQ, REAL_LT_MUL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_OF_NUM_LT, REAL_POW_INV, REAL_POW_LT, REAL_SUB_LE,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, SUM_LE, SUM_LMUL, SUM_RMUL, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_SUB, DROP_VSUM, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_SUB_LDISTRIB, VSUM_EQ, VSUM_SUB, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { LIM_CONST, LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_FIELD,
        REAL_RAT_REDUCE_CONV, .. } := D.dv.dg.pt.cvx
  let { LE_0, LT, TRANSITIVE_STEPWISE_LE, .. } := D.dv.dg.qsession
  let { LIM_DROP_LBOUND, .. } := D.dv.qtopology2
  let { SUM_GP, UPPER_BOUND_FINITE_SET, .. } := D.qmisc
  let { LAMBDA_PAIR, LAMBDA_PAIR_THM, REAL_POW_ADD, .. } := D.qsession
  let { BOUNDED_INCREASING_CONVERGENT, .. } := D.qtopology
  let { VSUM_GROUP, VSUM_NORM, VSUM_NORM_LE, .. } := D.qvec
  -- @@SCOPE END

  let MONOTONE_CONVERGENCE_INTERVAL ← (do
    let lemma ← prove
     r"{(x,y) | P x y} = {p | P (FST p) (SND p)}"
     (REWRITE_TAC [EXTENSION, FORALL_PAIR_THM, IN_ELIM_PAIR_THM, IN_ELIM_THM])
    prove
     r"!f:num->real^N->real^1 g a b.
        (!k. (f k) integrable_on interval[a,b]) /\
        (!k x. x IN interval[a,b] ==> drop(f k x) <= drop(f (SUC k) x)) /\
        (!x. x IN interval[a,b] ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral (interval[a,b]) (f k) | k IN (:num)}
        ==> g integrable_on interval[a,b] /\
            ((\k. integral (interval[a,b]) (f k))
             --> integral (interval[a,b]) g) sequentially"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"content(interval[a:real^N,b]) = &0") THENL
       [ASM_SIMP_TAC [INTEGRAL_NULL, INTEGRABLE_ON_NULL, LIM_CONST],
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM CONTENT_LT_NZ])] THEN
      SUBGOAL_THEN
       (← q r"!x:real^N k:num. x IN interval[a,b] ==> drop(f k x) <= drop(g x)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LBOUND) THEN
        EXISTS_TAC (← q r"\k. (f:num->real^N->real^1) k x") THEN
        ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
        EXISTS_TAC (← q r"k:num") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN REWRITE_TAC [REAL_LE_TRANS] THEN
        ASM_SIMP_TAC [REAL_LE_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?i. ((\k. integral (interval[a,b]) (f k:real^N->real^1)) --> i)
        sequentially")
      CHOOSE_TAC THENL
       [MATCH_MP_TAC BOUNDED_INCREASING_CONVERGENT THEN ASM_REWRITE_TAC [] THEN
        GEN_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!k. drop(integral(interval[a,b]) ((f:num->real^N->real^1) k)) <= drop i")
      ASSUME_TAC THENL
        [GEN_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LBOUND) THEN
         EXISTS_TAC (← q r"\k. integral(interval[a,b]) ((f:num->real^N->real^1) k)") THEN
         ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
         EXISTS_TAC (← q r"k:num") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
         MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
         ASM_REWRITE_TAC [REAL_LE_REFL, REAL_LE_TRANS] THEN
         GEN_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [],
         ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"((g:real^N->real^1) has_integral i) (interval[a,b])")
      ASSUME_TAC THENL
       [REWRITE_TAC [has_integral] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV
         [HAS_INTEGRAL_INTEGRAL]) THEN
        REWRITE_TAC [has_integral] THEN
        DISCH_THEN (MP_TAC o GEN (← q r"k:num") o
          SPECL [← q r"k:num", ← q r"e / &2 pow (k + 2)"]) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
        GEN_REWRITE_TAC LAND_CONV [SKOLEM_THM] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
        X_GEN_TAC (← q r"b:num->real^N->real^N->bool") THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"?r. !k. r:num <= k
               ==> &0 <= drop i - drop(integral(interval[a:real^N,b]) (f k)) /\
                   drop i - drop(integral(interval[a,b]) (f k)) < e / &4")
        STRIP_ASSUME_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_SEQUENTIALLY]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
          ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
          MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
          MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
          MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [NORM_1, dist, DROP_SUB] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"x <= y ==> abs(x - y) < e ==> &0 <= y - x /\ y - x < e")) THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"!x. x IN interval[a:real^N,b]
          ==> ?n. r:num <= n /\
                  !k. n <= k ==> &0 <= drop(g x) - drop(f k x) /\
                                 drop(g x) - drop(f k x) <
                                   e / (&4 * content(interval[a,b]))")
        MP_TAC THENL
         [X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV)
            [LIM_SEQUENTIALLY]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"x:real^N")) THEN ASM_SIMP_TAC [REAL_SUB_LE] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"e / (&4 * content(interval[a:real^N,b]))")) THEN
          ASM_SIMP_TAC [REAL_LT_DIV, REAL_LT_MUL, REAL_OF_NUM_LT, ARITH] THEN
          REWRITE_TAC [dist, NORM_1, DROP_SUB] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"f <= g ==> abs(f - g) = g - f")] THEN
          DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
          EXISTS_TAC (← q r"N + r:num") THEN CONJ_TAC THENL [ARITH_TAC, ALL_TAC] THEN
          ASM_MESON_TAC [← ARITH_RULE (← q r"N + r:num <= k ==> N <= k")],
          ALL_TAC] THEN
        GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM] THEN
        REWRITE_TAC [FORALL_AND_THM, ← TAUT
         (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
        REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"m:real^N->num") STRIP_ASSUME_TAC) THEN
        ABBREV_TAC (← q r"d:real^N->real^N->bool = \x. b(m x:num) x") THEN
        EXISTS_TAC (← q r"d:real^N->real^N->bool") THEN CONJ_TAC THENL
         [EXPAND_TAC "d" THEN REWRITE_TAC [gauge] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [gauge]) THEN
          SIMP_TAC [],
          ALL_TAC] THEN
        X_GEN_TAC (← q r"p:(real^N#(real^N->bool))->bool") THEN STRIP_TAC THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"!b c. norm(a - b) <= e / &4 /\
            norm(b - c) < e / &2 /\
            norm(c - d) < e / &4
            ==> norm(a - d) < e")) THEN
        EXISTS_TAC (← q r"vsum p (\(x:real^N,k:real^N->bool).
                  content k % (f:num->real^N->real^1) (m x) x)") THEN
        EXISTS_TAC (← q r"vsum p (\(x:real^N,k:real^N->bool).
                  integral k ((f:num->real^N->real^1) (m x)))") THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
        SUBGOAL_THEN (← q r"?s:num. !t:real^N#(real^N->bool). t IN p ==> m(FST t) <= s")
        MP_TAC THENL [ASM_SIMP_TAC [UPPER_BOUND_FINITE_SET], ALL_TAC] THEN
        REWRITE_TAC [FORALL_PAIR_THM] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"s:num")) THEN
        REPEAT CONJ_TAC THENL
         [ASM_SIMP_TAC [← GSYM VSUM_SUB] THEN REWRITE_TAC [LAMBDA_PAIR_THM] THEN
          REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB] THEN
          W (MP_TAC o PART_MATCH (lhand o rand) VSUM_NORM o lhand o snd) THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"y <= e ==> x <= y ==> x <= e")) THEN
          REWRITE_TAC [LAMBDA_PAIR_THM] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC
           (← q r"sum p (\(x:real^N,k:real^N->bool).
                 content k * e / (&4 * content (interval[a:real^N,b])))") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
            MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"k:real^N->bool"] THEN
            DISCH_TAC THEN REWRITE_TAC [NORM_MUL, ← GSYM VECTOR_SUB_LDISTRIB] THEN
            MATCH_MP_TAC REAL_LE_MUL2 THEN
            REWRITE_TAC [REAL_ABS_POS, NORM_POS_LE] THEN
            REWRITE_TAC [NORM_1, DROP_SUB] THEN
            REWRITE_TAC [← REAL_ARITH (← q r"abs(x) <= x <=> &0 <= x")] THEN CONJ_TAC THENL
             [ASM_MESON_TAC [CONTENT_POS_LE, TAGGED_DIVISION_OF], ALL_TAC] THEN
            MATCH_MP_TAC (← REAL_ARITH
             (← q r"&0 <= g - f /\ g - f < e ==> abs(g - f) <= e")) THEN
            CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            REWRITE_TAC [LE_REFL] THEN ASM_MESON_TAC [TAGGED_DIVISION_OF, SUBSET],
            ALL_TAC] THEN
          REWRITE_TAC [LAMBDA_PAIR, SUM_RMUL] THEN REWRITE_TAC [LAMBDA_PAIR_THM] THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (REWRITE_TAC [← MATCH_MP ADDITIVE_CONTENT_TAGGED_DIVISION th])) THEN
          MATCH_MP_TAC REAL_EQ_IMP_LE THEN
          UNDISCH_TAC (← q r"&0 < content(interval[a:real^N,b])") THEN
          CONV_TAC (fun t => REAL_FIELD t),
          ASM_SIMP_TAC [← GSYM VSUM_SUB] THEN REWRITE_TAC [LAMBDA_PAIR_THM] THEN
          MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
            (← q r"norm(vsum (0..s)
               (\j. vsum {(x:real^N,k:real^N->bool) | (x,k) IN p /\ m(x) = j}
                         (\(x,k). content k % f (m x) x :real^1 -
                                  integral k (f (m x)))))") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC REAL_EQ_IMP_LE THEN REWRITE_TAC [lemma] THEN
            AP_TERM_TAC THEN MATCH_MP_TAC (← GSYM VSUM_GROUP) THEN
            ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_NUMSEG, LE_0] THEN
            ASM_REWRITE_TAC [FORALL_PAIR_THM],
            ALL_TAC] THEN
          MATCH_MP_TAC REAL_LET_TRANS THEN
          EXISTS_TAC (← q r"sum (0..s) (\i. e / &2 pow (i + 2))") THEN CONJ_TAC THENL
           [ALL_TAC,
            REWRITE_TAC [real_div, ← GSYM REAL_POW_INV, SUM_LMUL] THEN
            REWRITE_TAC [REAL_POW_ADD, SUM_RMUL] THEN REWRITE_TAC [SUM_GP] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN
            ASM_SIMP_TAC [REAL_LT_LMUL_EQ, ← CONJUNCT1 LT] THEN
            REWRITE_TAC [real_div, ← GSYM REAL_MUL_ASSOC] THEN
            CONV_TAC REAL_RAT_REDUCE_CONV THEN
            MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x * y ==> (&1 - x) * y < y")) THEN
            MATCH_MP_TAC REAL_LT_MUL THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
            MATCH_MP_TAC REAL_POW_LT THEN CONV_TAC REAL_RAT_REDUCE_CONV] THEN
          MATCH_MP_TAC VSUM_NORM_LE THEN REWRITE_TAC [FINITE_NUMSEG] THEN
          X_GEN_TAC (← q r"t:num") THEN REWRITE_TAC [IN_NUMSEG, LE_0] THEN DISCH_TAC THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
           (← q r"norm(vsum {x:real^N,k:real^N->bool | x,k IN p /\ m x:num = t}
                  (\(x,k). content k % f t x - integral k (f t)):real^1)") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
            MATCH_MP_TAC VSUM_EQ THEN SIMP_TAC [FORALL_PAIR_THM, IN_ELIM_PAIR_THM],
            ALL_TAC] THEN
          MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
            HENSTOCK_LEMMA_PART1) THEN
          MAP_EVERY EXISTS_TAC
           [← q r"a:real^N", ← q r"b:real^N", ← q r"(b(t:num)):real^N->real^N->bool"] THEN
          ASM_REWRITE_TAC [] THEN
          ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC TAGGED_PARTIAL_DIVISION_SUBSET THEN
            EXISTS_TAC (← q r"p:(real^N#(real^N->bool))->bool") THEN
            SIMP_TAC [SUBSET, FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
            ASM_MESON_TAC [tagged_division_of],
            ALL_TAC] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [fine]) THEN
          EXPAND_TAC "d" THEN REWRITE_TAC [fine, IN_ELIM_PAIR_THM] THEN MESON_TAC [],
          MP_TAC (← ISPECL [← q r"(f:num->real^N->real^1) s", ← q r"a:real^N",
                            ← q r"b:real^N", ← q r"p:(real^N#(real^N->bool))->bool"]
                        INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN) THEN
          MP_TAC (← ISPECL [← q r"(f:num->real^N->real^1) r", ← q r"a:real^N",
                            ← q r"b:real^N", ← q r"p:(real^N#(real^N->bool))->bool"]
                        INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN) THEN
          ASM_SIMP_TAC [NORM_1, DROP_SUB, DROP_VSUM, ← GSYM DROP_EQ] THEN
          REWRITE_TAC [o_DEF, LAMBDA_PAIR_THM] THEN MATCH_MP_TAC (← REAL_ARITH
           (← q r"sr <= sx /\ sx <= ss /\ ks <= i /\ &0 <= i - kr /\ i - kr < e
            ==> kr = sr ==> ks = ss ==> abs(sx - i) < e")) THEN
          ASM_SIMP_TAC [LE_REFL] THEN CONJ_TAC THEN MATCH_MP_TAC SUM_LE THEN
          ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"i:real^N->bool"] THEN DISCH_TAC THEN
          (SUBGOAL_THEN (← q r"i SUBSET interval[a:real^N,b]") ASSUME_TAC THENL
            [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC] THEN
           SUBGOAL_THEN (← q r"?u v:real^N. i = interval[u,v]")
            (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
           THENL [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC]) THEN
          MATCH_MP_TAC INTEGRAL_DROP_LE THEN
          REPEAT (CONJ_TAC THENL
           [ASM_MESON_TAC [INTEGRABLE_SUBINTERVAL], ALL_TAC]) THEN
          X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
          MP_TAC (← ISPEC
            (← q r"\m n:num. drop (f m (y:real^N)) <= drop (f n y)")
            TRANSITIVE_STEPWISE_LE) THEN
          REWRITE_TAC [REAL_LE_TRANS, REAL_LE_REFL] THEN
          (ANTS_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC]) THEN
          DISCH_THEN MATCH_MP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [TAGGED_DIVISION_OF, SUBSET]],
        ALL_TAC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [integrable_on], ALL_TAC] THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN
      ASM_REWRITE_TAC []))

  pure { MONOTONE_CONVERGENCE_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Monotone convergence on arbitrary sets.  (integration.ml 8023-8338)      -/
/- ------------------------------------------------------------------------- -/

structure INU where
  MONOTONE_CONVERGENCE_INCREASING : thm
  MONOTONE_CONVERGENCE_DECREASING : thm
  MONOTONE_CONVERGENCE_INCREASING_AE : thm
  MONOTONE_CONVERGENCE_DECREASING_AE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINU [HolBase] (D : IntegrationDeps) (BINC : INC) (BINE : INE) (BINI : INI) (BINK : INK) (BINN : INN) (BINP : INP) (BINQ : INQ) (BINT : INT) : ExceptT String IO INU := do
  -- @@SCOPE BEGIN
  let { HAS_INTEGRAL_INTEGRAL, integrable_on, .. } := BINC
  let { INTEGRABLE_ADD, INTEGRABLE_NEG, INTEGRABLE_SUB, INTEGRAL_NEG, INTEGRAL_SUB,
        INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRAL_DROP_LE, INTEGRAL_DROP_POS, .. } := BINI
  let { INTEGRABLE_SPIKE, INTEGRAL_SPIKE, .. } := BINK
  let { INTEGRABLE_RESTRICT_UNIV, INTEGRAL_RESTRICT_UNIV, .. } := BINN
  let { INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { HAS_INTEGRAL_ALT, INTEGRABLE_ALT, .. } := BINQ
  let { MONOTONE_CONVERGENCE_INTERVAL, .. } := BINT
  let { ADD1, ARITH, EQ_IMP, ETA_AX, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ, IMP_IMP, IN_DIFF, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_UNIV, LE_ADD, MONO_AND, MONO_EXISTS, MONO_FORALL, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_OF_NUM_LT, REAL_SUB_LE, SIMPLE_IMAGE, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_THM, SUBSET_UNIV, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_SUB, DROP_VEC, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { BOUNDED_LINEAR_IMAGE, BOUNDED_SUBSET, .. } := D.dv.dg.pt.cvx.top1
  let { LIM_ADD, LIM_CONST, LIM_SEQUENTIALLY, LIM_SUB, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, SEQ_OFFSET, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON, NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { LE_0, TRANSITIVE_STEPWISE_LE, .. } := D.dv.dg.qsession
  let { LINEAR_COMPOSE_NEG, LINEAR_ID, .. } := D.dv.dg.qvec
  let { LIM_DROP_LBOUND, .. } := D.dv.qtopology2
  let { BOUNDED_INCREASING_CONVERGENT, LIM_NEG, SEQ_OFFSET_REV, .. } := D.qtopology
  -- @@SCOPE END

  let MONOTONE_CONVERGENCE_INCREASING ← (do
    let nn ← ARITH_RULE (← q r"N:num <= N")
    prove
     r"!f:num->real^N->real^1 g s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f k x) <= drop(f (SUC k) x)) /\
        (!x. x IN s ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially"
     (SUBGOAL_THEN
       (← q r"!f:num->real^N->real^1 g s.
        (!k x. x IN s ==> &0 <= drop(f k x)) /\
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f k x) <= drop(f (SUC k) x)) /\
        (!x. x IN s ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially")
      ASSUME_TAC THENL
       [ALL_TAC,
        REPEAT GEN_TAC THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o ISPECL
         [← q r"\n x:real^N. f(SUC n) x - f 0 x:real^1",
          ← q r"\x. (g:real^N->real^1) x - f 0 x", ← q r"s:real^N->bool"]) THEN
        REWRITE_TAC [] THEN ANTS_TAC THEN REPEAT CONJ_TAC THENL
         [REPEAT STRIP_TAC THEN REWRITE_TAC [DROP_SUB, REAL_SUB_LE] THEN
          MP_TAC (← ISPEC
            (← q r"\m n:num. drop (f m (x:real^N)) <= drop (f n x)")
            TRANSITIVE_STEPWISE_LE) THEN
          REWRITE_TAC [REAL_LE_TRANS, REAL_LE_REFL] THEN ASM_MESON_TAC [LE_0],
          GEN_TAC THEN MATCH_MP_TAC INTEGRABLE_SUB THEN ASM_REWRITE_TAC [ETA_AX],
          REPEAT STRIP_TAC THEN REWRITE_TAC [DROP_SUB, REAL_SUB_LE] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"x - a <= y - a <=> x <= y")],
          REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_SUB THEN SIMP_TAC [LIM_CONST] THEN
          REWRITE_TAC [ADD1] THEN
          MATCH_MP_TAC (← ISPECL [← q r"f:num->real^1", ← q r"l:real^1", ← q r"1"]
            SEQ_OFFSET) THEN
          ASM_SIMP_TAC [],
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
          ASM_SIMP_TAC [INTEGRAL_SUB, ETA_AX, bounded] THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"B:real")
            (fun th => tactic_of do
              pure (EXISTS_TAC (← q r"B + norm(integral s (f 0:real^N->real^1))") THEN
                    X_GEN_TAC (← q r"k:num") THEN
                    MP_TAC (← SPEC (← q r"SUC k") th)))) THEN
          NORM_ARITH_TAC,
          ASM_SIMP_TAC [INTEGRAL_SUB, ETA_AX, IMP_CONJ] THEN
          SUBGOAL_THEN (← q r"(f 0:real^N->real^1) integrable_on s") MP_TAC THENL
           [ASM_REWRITE_TAC [], ONCE_REWRITE_TAC [IMP_IMP]] THEN
          DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_ADD) THEN
          REWRITE_TAC [ETA_AX, ← VECTOR_ARITH (← q r"f + (g - f):real^N = g")] THEN
          DISCH_TAC THEN ASM_SIMP_TAC [INTEGRAL_SUB, ETA_AX] THEN
          MP_TAC (← ISPECL [← q r"sequentially", ← q r"integral s (f 0:real^N->real^1)"]
                        LIM_CONST) THEN
          REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP LIM_ADD) THEN
          REWRITE_TAC [ETA_AX, ← VECTOR_ARITH (← q r"f + (g - f):real^N = g")] THEN
          REWRITE_TAC [ADD1] THEN
          SIMP_TAC [← ISPECL [← q r"f:num->real^1", ← q r"l:real^1", ← q r"1"]
            SEQ_OFFSET_REV]]] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!x:real^N k:num. x IN s ==> drop(f k x) <= drop(g x)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LBOUND) THEN
        EXISTS_TAC (← q r"\k. (f:num->real^N->real^1) k x") THEN
        ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
        EXISTS_TAC (← q r"k:num") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN REWRITE_TAC [REAL_LE_TRANS] THEN
        ASM_SIMP_TAC [REAL_LE_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?i. ((\k. integral s (f k:real^N->real^1)) --> i)
        sequentially")
      CHOOSE_TAC THENL
       [MATCH_MP_TAC BOUNDED_INCREASING_CONVERGENT THEN ASM_REWRITE_TAC [] THEN
        GEN_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!k. drop(integral s ((f:num->real^N->real^1) k)) <= drop i")
      ASSUME_TAC THENL
        [GEN_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LBOUND) THEN
         EXISTS_TAC (← q r"\k. integral(s) ((f:num->real^N->real^1) k)") THEN
         ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
         EXISTS_TAC (← q r"k:num") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
         MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
         ASM_REWRITE_TAC [REAL_LE_REFL, REAL_LE_TRANS] THEN
         GEN_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [],
         ALL_TAC] THEN
      SUBGOAL_THEN (← q r"((g:real^N->real^1) has_integral i) s") ASSUME_TAC THENL
       [ALL_TAC,
        CONJ_TAC THENL [ASM_MESON_TAC [integrable_on], ALL_TAC] THEN
        FIRST_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN
        ASM_REWRITE_TAC []] THEN
      REWRITE_TAC [HAS_INTEGRAL_ALT] THEN
      MP_TAC (← ISPECL
       [← q r"\k x. if x IN s then (f:num->real^N->real^1) k x else vec 0",
        ← q r"\x. if x IN s then (g:real^N->real^1) x else vec 0"]
       (← MATCH_MP (← MESON [] (← q r"(!a b c d. P a b c d ==> Q a b c d)
                      ==> !a b. (!c d. P a b c d) ==> (!c d. Q a b c d)"))
                MONOTONE_CONVERGENCE_INTERVAL)) THEN
      ANTS_TAC THENL
       [REPEAT GEN_TAC THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
         [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [INTEGRABLE_ALT]) THEN
          SIMP_TAC [],
          DISCH_TAC] THEN
        CONJ_TAC THENL
         [REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [REAL_LE_REFL],
          ALL_TAC] THEN
        CONJ_TAC THENL
         [REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [LIM_CONST],
          ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        REWRITE_TAC [bounded, FORALL_IN_IMAGE, IN_UNIV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
        MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
        REWRITE_TAC [NORM_1] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= y /\ y <= x ==> abs(x) <= a ==> abs(y) <= a")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC INTEGRAL_DROP_POS THEN ASM_REWRITE_TAC [] THEN
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [REAL_LE_REFL, DROP_VEC],
          ALL_TAC] THEN
        GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
        MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
        ASM_REWRITE_TAC [SUBSET_UNIV, IN_UNIV] THEN
        ASM_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV, ETA_AX] THEN
        GEN_TAC THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [REAL_LE_REFL, DROP_VEC, REAL_LE_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_SEQUENTIALLY]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
      ASM_SIMP_TAC [dist, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE BINDER_CONV
       [HAS_INTEGRAL_INTEGRAL]) THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [HAS_INTEGRAL_ALT] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"N:num", ← q r"e / &4"]) THEN
      ASM_SIMP_TAC [dist, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N"]) THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o (fun th => MATCH_MP th nn)) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"norm(x - y) < e / &4 /\ norm(z - x) < e / &4
        ==> norm(z - y) < e / &2"))) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (BINDER_CONV o BINDER_CONV)
            [LIM_SEQUENTIALLY]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real^N", ← q r"b:real^N", ← q r"e / &2"]) THEN
      ASM_REWRITE_TAC [dist, REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"M:num") (MP_TAC o SPEC (← q r"M + N:num"))) THEN
      REWRITE_TAC [LE_ADD, NORM_1, DROP_SUB] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"f1 <= f2 /\ f2 <= i
        ==> abs(f2 - g) < e / &2 ==> abs(f1 - i) < e / &2 ==> abs(g - i) < e")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
        MP_TAC (← ISPEC
            (← q r"\m n:num. drop (f m (x:real^N)) <= drop (f n x)")
            TRANSITIVE_STEPWISE_LE) THEN
        REWRITE_TAC [REAL_LE_REFL, REAL_LE_TRANS] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        DISCH_THEN MATCH_MP_TAC THEN ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"drop(integral s ((f:num->real^N->real^1) (M + N)))") THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM INTEGRAL_RESTRICT_UNIV] THEN
      MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, IN_UNIV] THEN
      ASM_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV, ETA_AX] THEN
      GEN_TAC THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_LE_REFL, DROP_VEC, REAL_LE_REFL]))

  let MONOTONE_CONVERGENCE_DECREASING ← prove
   r"!f:num->real^N->real^1 g s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f (SUC k) x) <= drop(f k x)) /\
        (!x. x IN s ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"(\k x. --(f k x)):num->real^N->real^1",
      ← q r"(\x. --(g x)):real^N->real^1", ← q r"s:real^N->bool"]
          MONOTONE_CONVERGENCE_INCREASING) THEN
    FIRST_ASSUM MP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> b) /\ (c ==> d) ==> a ==> (b ==> c) ==> d")) THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THENL
       [MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
        DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_NEG) THEN REWRITE_TAC [],
        SIMP_TAC [DROP_NEG, REAL_LE_NEG2],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC LIM_NEG THEN ASM_SIMP_TAC [],
        ALL_TAC] THEN
      DISCH_TAC THEN MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (\x. --x)
                      {integral s (f k:real^N->real^1) | k IN (:num)}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC BOUNDED_LINEAR_IMAGE THEN
        ASM_SIMP_TAC [LINEAR_COMPOSE_NEG, LINEAR_ID],
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN REWRITE_TAC [← GSYM IMAGE_o] THEN
        REWRITE_TAC [SUBSET, IN_IMAGE] THEN
        GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [o_THM] THEN
        MATCH_MP_TAC INTEGRAL_NEG THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o MATCH_MP INTEGRABLE_NEG) (MP_TAC o MATCH_MP LIM_NEG)) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN
    BINOP_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN TRY GEN_TAC THEN
    MATCH_MP_TAC (← VECTOR_ARITH (← q r"x:real^N = --y ==> --x = y")) THEN
    MATCH_MP_TAC INTEGRAL_NEG THEN ASM_REWRITE_TAC [])

  let MONOTONE_CONVERGENCE_INCREASING_AE ← prove
   r"!f:num->real^N->real^1 g s t.
        (!k. (f k) integrable_on s) /\
        negligible t /\
        (!k x. x IN s DIFF t ==> drop(f k x) <= drop(f (SUC k) x)) /\
        (!x. x IN s DIFF t ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\n x. if x IN t then vec 0
           else (f:num->real^N->real^1) n x",
      ← q r"\x. if x IN t then vec 0
           else (g:real^N->real^1) x", ← q r"s:real^N->bool"]
          MONOTONE_CONVERGENCE_INCREASING) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"(f:num->real^N->real^1) k") THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_LE_REFL] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"(x:real^N) IN t") THEN ASM_REWRITE_TAC [LIM_CONST] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_DIFF],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x = g x)
          ==> {f x | x IN s} SUBSET {g x | x IN s}")) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]],
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_SPIKE THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
        REWRITE_TAC [FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
        MATCH_MP_TAC INTEGRAL_SPIKE THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]]])

  let MONOTONE_CONVERGENCE_DECREASING_AE ← prove
   r"!f:num->real^N->real^1 g s t.
        (!k. (f k) integrable_on s) /\
        negligible t /\
        (!k x. x IN s DIFF t ==> drop(f (SUC k) x) <= drop(f k x)) /\
        (!x. x IN s DIFF t ==> ((\k. f k x) --> g x) sequentially) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> g integrable_on s /\
            ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\n x. if x IN t then vec 0
           else (f:num->real^N->real^1) n x",
      ← q r"\x. if x IN t then vec 0
           else (g:real^N->real^1) x", ← q r"s:real^N->bool"]
          MONOTONE_CONVERGENCE_DECREASING) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"(f:num->real^N->real^1) k") THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_LE_REFL] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"(x:real^N) IN t") THEN ASM_REWRITE_TAC [LIM_CONST] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_DIFF],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x = g x)
          ==> {f x | x IN s} SUBSET {g x | x IN s}")) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]],
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_SPIKE THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THEN
        REWRITE_TAC [FUN_EQ_THM] THEN REPEAT GEN_TAC THEN
        MATCH_MP_TAC INTEGRAL_SPIKE THEN EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]]])

  pure { MONOTONE_CONVERGENCE_INCREASING, MONOTONE_CONVERGENCE_DECREASING,
         MONOTONE_CONVERGENCE_INCREASING_AE, MONOTONE_CONVERGENCE_DECREASING_AE }

/- ------------------------------------------------------------------------- -/
/- Existence and bounds between integrals; explicit limit statements for    -/
/- integrals over [0,inf).  (integration.ml 8339-8654)                       -/
/- ------------------------------------------------------------------------- -/

structure INV where
  INTEGRAL_NORM_BOUND_INTEGRAL : thm
  INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT : thm
  HAS_INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT : thm
  INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND : thm
  HAS_INTEGRAL_LIM_AT_POSINFINITY : thm
  HAS_INTEGRAL_LIM_AT_POSINFINITY_GEN : thm
  HAS_INTEGRAL_LIM_SEQUENTIALLY : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINV [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINH : INH) (BINK : INK) (BINL : INL) (BINM : INM) (BINN : INN) (BINO : INO) (BINQ : INQ) (BINR : INR) : ExceptT String IO INV := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_POS_LE, .. } := BINA
  let { GAUGE_INTER, .. } := BINB
  let { FINE_INTER, has_integral, HAS_INTEGRAL_INTEGRABLE, INTEGRABLE_INTEGRAL,
        integrable_on, TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { INTEGRABLE_LINEAR, INTEGRAL_LINEAR, INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRABLE_CONST, INTEGRAL_CONST, .. } := BINH
  let { NEGLIGIBLE_EMPTY, .. } := BINK
  let { INTEGRABLE_SUBINTERVAL, INTEGRAL_COMBINE, .. } := BINL
  let { HAS_INTEGRAL, .. } := BINM
  let { INTEGRABLE_RESTRICT_INTER, INTEGRABLE_RESTRICT_UNIV, INTEGRAL_RESTRICT_INTER, .. }
        := BINN
  let { HAS_INTEGRAL_TRANSLATION, INTEGRABLE_TRANSLATION, INTEGRAL_TRANSLATION, .. } := BINO
  let { HAS_INTEGRAL_ALT, INTEGRABLE_ALT, INTEGRABLE_ALT_SUBSET, INTEGRABLE_ON_SUBINTERVAL,
        .. } := BINQ
  let { HAS_INTEGRAL_DIFF, INTEGRAL_DIFF, .. } := BINR
  let { CONJ_ASSOC, ETA_AX, EXTENSION, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_PAIR_THM, IMP_CONJ_ALT, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS,
        MONO_FORALL, MONO_IMP, REAL_ABS_POS, REAL_ARCH_SIMPLE, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADDR, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS,
        REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_LE, REAL_POS, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_ge, SURJECTIVE_IMAGE_EQ, UNION_SUBSET, .. } :=
        D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_0, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, DROP_VSUM, FORALL_DROP, FORALL_LIFT,
        LIFT_ADD, LIFT_CMUL, LIFT_DROP, LIFT_NUM, NORM_0, NORM_1, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, linear, VECTOR_ADD_COMPONENT, VECTOR_ADD_RID, VECTOR_MUL_COMPONENT,
        VECTOR_SUB_ADD2, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_BALL, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, .. } := D.dv.dg.pt.cvx
  let { BALL_1, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { FLOOR, FLOOR_POS, .. } := D.qfloor
  let { REAL_SUB_ADD2, .. } := D.qsession
  let { BALL_MAX_UNION, BOUNDED_SUBSET_CLOSED_INTERVAL, INTERVAL_TRANSLATION,
        LIM_AT_POSINFINITY, .. } := D.qtopology
  let { VSUM_NORM_LE, .. } := D.qvec
  let { IMP_REWRITE_TAC, .. } := D
  -- @@SCOPE END

  let INTEGRAL_NORM_BOUND_INTEGRAL ← (do
    let lemma ← prove
     r"(!e. &0 < e ==> x < y + e) ==> x <= y"
     (DISCH_THEN (MP_TAC o SPEC (← q r"x - y:real")) THEN REAL_ARITH_TAC)
    prove
     r"!f:real^M->real^N g s.
        f integrable_on s /\ g integrable_on s /\
        (!x. x IN s ==> norm(f x) <= drop(g x))
        ==> norm(integral s f) <= drop(integral s g)"
     (SUBGOAL_THEN
       (← q r"!f:real^M->real^N g a b.
        f integrable_on interval[a,b] /\ g integrable_on interval[a,b] /\
        (!x. x IN interval[a,b] ==> norm(f x) <= drop(g x))
        ==> norm(integral(interval[a,b]) f) <= drop(integral(interval[a,b]) g)")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"(f:real^M->real^N) integrable_on interval[a,b]") THEN
        DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
        REWRITE_TAC [has_integral] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
        ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"d1:real^M->real^M->bool") THEN STRIP_TAC THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
        ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"d2:real^M->real^M->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        MP_TAC (← ISPECL [← q r"d1:real^M->real^M->bool", ← q r"d2:real^M->real^M->bool"]
                      GAUGE_INTER) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o MATCH_MP FINE_DIVISION_EXISTS) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
        REWRITE_TAC [FINE_INTER, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"p:(real^M#(real^M->bool))->bool") THEN STRIP_TAC THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool))->bool")) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool))->bool")) THEN
        ASM_REWRITE_TAC [NORM_1, DROP_SUB] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(sg) <= dsa
          ==> abs(dsa - dia) < e / &2 ==> norm(sg - ig) < e / &2
              ==> norm(ig) < dia + e")) THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
        ASM_SIMP_TAC [DROP_VSUM] THEN MATCH_MP_TAC VSUM_NORM_LE THEN
        ASM_REWRITE_TAC [o_DEF, FORALL_PAIR_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"k:real^M->bool"] THEN DISCH_TAC THEN
        REWRITE_TAC [NORM_MUL, DROP_CMUL] THEN
        MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [REAL_ABS_POS, NORM_POS_LE] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs x <= x <=> &0 <= x")] THEN
        ASM_MESON_TAC [CONTENT_POS_LE, TAGGED_DIVISION_OF, SUBSET],
        ALL_TAC] THEN
      REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN (fun th => tactic_of do
         pure (ASSUME_TAC (← CONJUNCT1 (← GEN_REWRITE_RULE I [INTEGRABLE_ALT] th)) THEN
               MP_TAC (← MATCH_MP INTEGRABLE_INTEGRAL th)))) THEN
      ONCE_REWRITE_TAC [HAS_INTEGRAL] THEN
      DISCH_THEN (LABEL_TAC "A") THEN DISCH_TAC THEN MATCH_MP_TAC lemma THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "A" (MP_TAC o SPEC (← q r"e / &2")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "F"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "A"))) THEN
      MP_TAC (← ISPEC (← q r"ball(vec 0,max B1 B2):real^M->bool")
        BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
      REWRITE_TAC [BOUNDED_BALL, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [BALL_MAX_UNION, UNION_SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
      DISCH_THEN (CONJUNCTS_THEN (ANTE_RES_THEN MP_TAC)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:real^1") (CONJUNCTS_THEN2 ASSUME_TAC
         (fun th => tactic_of do
           pure (DISCH_THEN (X_CHOOSE_THEN (← q r"w:real^N")
                  (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN MP_TAC th)))) THEN
      ASM_REWRITE_TAC [NORM_1, DROP_SUB] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(sg) <= dsa
          ==> abs(dsa - dia) < e / &2 ==> norm(sg - ig) < e / &2
              ==> norm(ig) < dia + e")) THEN
      REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM o MATCH_MP INTEGRAL_UNIQUE)) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [NORM_0, DROP_VEC, REAL_LE_REFL]))

  let INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT ← prove
   r"!f:real^M->real^N g:real^M->real^P s k.
        1 <= k /\ k <= dimindex(:P) /\
        f integrable_on s /\ g integrable_on s /\
        (!x. x IN s ==> norm(f x) <= (g x)$k)
        ==> norm(integral s f) <= (integral s g)$k"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"drop(integral s ((\y. lift(y$k)) o (g:real^M->real^P)))") THEN
    SUBGOAL_THEN (← q r"linear(\y:real^P. lift(y$k))") ASSUME_TAC THENL
     [ASM_SIMP_TAC [linear, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                    LIFT_ADD, LIFT_CMUL],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_SIMP_TAC [o_THM, LIFT_DROP] THEN MATCH_MP_TAC INTEGRABLE_LINEAR THEN
      ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"integral s ((\y. lift (y$k)) o (g:real^M->real^P)) =
        (\y. lift (y$k)) (integral s g)")
    SUBST1_TAC THENL
     [MATCH_MP_TAC INTEGRAL_LINEAR THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL]])

  let HAS_INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT ← prove
   r"!f:real^M->real^N g:real^M->real^P s i j k.
        1 <= k /\ k <= dimindex(:P) /\
        (f has_integral i) s /\ (g has_integral j) s /\
        (!x. x IN s ==> norm(f x) <= (g x)$k)
        ==> norm(i) <= j$k"
   (REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
     pure (SUBST1_TAC (← SYM (← MATCH_MP INTEGRAL_UNIQUE th)) THEN
           ASSUME_TAC (← MATCH_MP HAS_INTEGRAL_INTEGRABLE th)))) THEN
    MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT THEN
    ASM_REWRITE_TAC [])

  let INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND ← (do
    let lemma ← prove
     r"!f:real^M->real^N g.
          (!a b. f integrable_on interval[a,b]) /\
          (!x. norm(f x) <= drop(g x)) /\
          g integrable_on (:real^M)
          ==> f integrable_on (:real^M)"
     (REPEAT GEN_TAC THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ONCE_REWRITE_TAC [INTEGRABLE_ALT_SUBSET] THEN
      ASM_REWRITE_TAC [IN_UNIV, ETA_AX] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> b < c ==> a < c")) THEN
      ONCE_REWRITE_TAC [NORM_SUB] THEN
      ASM_SIMP_TAC [← GSYM INTEGRAL_DIFF, NEGLIGIBLE_EMPTY,
                    ← SET_RULE (← q r"s SUBSET t ==> s DIFF t = {}")] THEN
      REWRITE_TAC [NORM_1] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> x <= abs y")) THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_MESON_TAC [integrable_on, HAS_INTEGRAL_DIFF, NEGLIGIBLE_EMPTY,
                     ← SET_RULE (← q r"s SUBSET t ==> s DIFF t = {}")])
    prove
     r"!f:real^M->real^N g s.
        (!a b. (\x. if x IN s then f x else vec 0)
               integrable_on interval[a,b]) /\
        (!x. x IN s ==> norm(f x) <= drop(g x)) /\
        g integrable_on s
        ==> f integrable_on s"
     (REPEAT GEN_TAC THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
      DISCH_TAC THEN MATCH_MP_TAC lemma THEN
      EXISTS_TAC (← q r"(\x. if x IN s then g x else vec 0):real^M->real^1") THEN
      ASM_REWRITE_TAC [] THEN
      GEN_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [NORM_0, DROP_VEC, REAL_POS]))

  let HAS_INTEGRAL_LIM_AT_POSINFINITY ← prove
   r"!f l:real^N.
        (f has_integral l) {t | &0 <= drop t} <=>
        (!a. f integrable_on interval[vec 0,a]) /\
        ((\a. integral (interval[vec 0,lift a]) f) --> l) at_posinfinity"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_INTEGRAL_ALT] THEN
    REWRITE_TAC [INTEGRAL_RESTRICT_INTER, INTEGRABLE_RESTRICT_INTER] THEN
    SUBGOAL_THEN
     (← q r"!a b. {t | &0 <= drop t} INTER interval[a,b] =
          interval[lift(max (&0) (drop a)),b]")
     (fun th => REWRITE_TAC [th])
    THENL
     [REWRITE_TAC [EXTENSION, FORALL_LIFT, IN_INTER, IN_INTERVAL_1,
                   LIFT_DROP, IN_ELIM_THM] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [LIM_AT_POSINFINITY, dist, real_ge] THEN
    EQ_TAC THEN STRIP_TAC THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"a:real^1") THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"vec 0:real^1", ← q r"a:real^1"]) THEN
      REWRITE_TAC [DROP_VEC, LIFT_NUM, ← REAL_ARITH (← q r"max x x = x")],
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
      X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPECL [← q r"lift(--b)", ← q r"lift b"]) THEN
      REWRITE_TAC [DROP_VEC, LIFT_NUM, LIFT_DROP] THEN
      SUBGOAL_THEN (← q r"max (&0) (--b) = &0") SUBST1_TAC THENL
       [ASM_REAL_ARITH_TAC, REWRITE_TAC [LIFT_NUM]] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [BALL_1, SUBSET_INTERVAL_1] THEN
      REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC, LIFT_DROP] THEN
      ASM_REAL_ARITH_TAC,
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:real^1")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTEGRABLE_SUBINTERVAL) THEN
      SIMP_TAC [SUBSET_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_VEC, LIFT_DROP] THEN
      REAL_ARITH_TAC,
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") (LABEL_TAC "*")) THEN
      EXISTS_TAC (← q r"abs B + &1") THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      REWRITE_TAC [BALL_1, SUBSET_INTERVAL_1] THEN
      REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_VEC, LIFT_DROP] THEN
      STRIP_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"max (&0) (drop a) = &0") SUBST1_TAC THENL
       [ASM_REAL_ARITH_TAC, REWRITE_TAC [LIFT_NUM]] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"drop b")) THEN
      REWRITE_TAC [LIFT_DROP] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REAL_ARITH_TAC])

  let HAS_INTEGRAL_LIM_AT_POSINFINITY_GEN ← prove
   r"!f a l:real^N.
        (f has_integral l) {t | a <= drop t} <=>
        (!b. f integrable_on interval[lift a,lift b]) /\
        ((\b. integral (interval[lift a,lift b]) f) --> l) at_posinfinity"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"{t | a <= drop t} = IMAGE (\x. lift a + x) {t | &0 <= drop t}")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
      REWRITE_TAC [IN_ELIM_THM, DROP_ADD, LIFT_DROP, REAL_LE_ADDR] THEN
      MESON_TAC [VECTOR_SUB_ADD2],
      REWRITE_TAC [← GSYM HAS_INTEGRAL_TRANSLATION]] THEN
    REWRITE_TAC [HAS_INTEGRAL_LIM_AT_POSINFINITY] THEN
    REWRITE_TAC [INTEGRABLE_TRANSLATION, INTEGRAL_TRANSLATION] THEN
    REWRITE_TAC [← GSYM INTERVAL_TRANSLATION, VECTOR_ADD_RID] THEN
    REWRITE_TAC [FORALL_LIFT, ← GSYM LIFT_ADD] THEN
    MP_TAC (← MESON [REAL_SUB_ADD2] (← q r"!P. (!b:real. P(a + b)) <=> (!b. P b)")) THEN
    SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    DISCH_TAC THEN
    REWRITE_TAC [LIM_AT_POSINFINITY, real_ge] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"b:real")) THEN
    EXISTS_TAC (← q r"abs a + abs b:real") THEN
    X_GEN_TAC (← q r"c:real") THEN DISCH_TAC THENL
     [SUBST1_TAC (← REAL_ARITH (← q r"c:real = a + (c - a)")) THEN
      REWRITE_TAC [← GSYM LIFT_ADD],
      ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC)

  let HAS_INTEGRAL_LIM_SEQUENTIALLY ← prove
   r"!f:real^1->real^N l.
           (f o lift --> vec 0) at_posinfinity /\
           (!n. f integrable_on interval[vec 0,vec n]) /\
           ((\n. integral (interval[vec 0,vec n]) f) --> l) sequentially
           ==> (f has_integral l) {t | &0 <= drop t}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL_LIM_AT_POSINFINITY] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"a:real^1") THEN MP_TAC (← SPEC (← q r"drop a") REAL_ARCH_SIMPLE) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTEGRABLE_SUBINTERVAL) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
      DISCH_TAC] THEN
    REWRITE_TAC [LIM_AT_POSINFINITY, real_ge] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_AT_POSINFINITY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, o_THM, real_ge, FORALL_DROP, LIFT_DROP] THEN
    REWRITE_TAC [DIST_0, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"max (&N) B + &1") THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"drop x") FLOOR_POS) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
    SUBGOAL_THEN
     (← q r"integral(interval[vec 0,x]) (f:real^1->real^N) =
    integral(interval[vec 0,vec n]) f + integral(interval[vec n,x]) f")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_COMBINE THEN
      ASM_REWRITE_TAC [DROP_VEC] THEN
      MP_TAC (← SPEC (← q r"drop x") FLOOR) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC (← NORM_ARITH
     (← q r"dist(a:real^N,l) < e / &2 /\ norm b <= e / &2 ==> dist(a + b,l) < e")) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN
      MP_TAC (← SPEC (← q r"drop x") FLOOR) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS
      (← q r"drop(integral(interval[vec n:real^1,x]) (\x. lift(e / &2)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_REWRITE_TAC [INTEGRABLE_CONST, IN_INTERVAL_1, LIFT_DROP] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"interval[vec 0:real^1,x]") THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [DROP_VEC] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        MP_TAC (← SPEC (← q r"drop x") FLOOR) THEN ASM_REAL_ARITH_TAC],
      REWRITE_TAC [INTEGRAL_CONST] THEN IMP_REWRITE_TAC [CONTENT_1] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM LIFT_CMUL, LIFT_DROP, DROP_VEC] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN
        MP_TAC (← SPEC (← q r"drop x") FLOOR) THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [DROP_VEC] THEN MP_TAC (← SPEC (← q r"drop x") FLOOR) THEN
        ASM_REAL_ARITH_TAC]])

  pure { INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT,
         HAS_INTEGRAL_NORM_BOUND_INTEGRAL_COMPONENT,
         INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND, HAS_INTEGRAL_LIM_AT_POSINFINITY,
         HAS_INTEGRAL_LIM_AT_POSINFINITY_GEN, HAS_INTEGRAL_LIM_SEQUENTIALLY }

/- ------------------------------------------------------------------------- -/
/- Interval functions of bounded variation on a set: basic properties.      -/
/- (integration.ml 8655-8982)                                                -/
/- ------------------------------------------------------------------------- -/

structure INW where
  set_variation : thm
  has_bounded_setvariation_on : thm
  SET_VARIATION_DEGENERATES : thm
  HAS_BOUNDED_SETVARIATION_ON : thm
  HAS_BOUNDED_SET_VARIATION : thm
  HAS_BOUNDED_SETVARIATION_COMPARISON : thm
  HAS_BOUNDED_SETVARIATION_ON_EQ : thm
  SET_VARIATION_EQ : thm
  HAS_BOUNDED_SETVARIATION_ON_COMPONENTWISE : thm
  HAS_BOUNDED_SETVARIATION_ON_LIFT_ABS : thm
  SETVARIATION_EQUAL_LEMMA : thm
  HAS_BOUNDED_SETVARIATION_ON_ELEMENTARY : thm
  HAS_BOUNDED_SETVARIATION_ON_INTERVAL : thm
  HAS_BOUNDED_SETVARIATION_ON_UNIV : thm
  HAS_BOUNDED_SETVARIATION_ON_SUBSET : thm
  HAS_BOUNDED_SETVARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS : thm
  HAS_BOUNDED_SETVARIATION_ON_NORM : thm
  HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR : thm
  HAS_BOUNDED_SETVARIATION_ON_0 : thm
  SET_VARIATION_0 : thm
  HAS_BOUNDED_SETVARIATION_ON_CMUL : thm
  HAS_BOUNDED_SETVARIATION_ON_NEG : thm
  HAS_BOUNDED_SETVARIATION_ON_ADD : thm
  HAS_BOUNDED_SETVARIATION_ON_SUB : thm
  HAS_BOUNDED_SETVARIATION_ON_MUL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINW [HolBase] (D : IntegrationDeps) (BINB : INB) : ExceptT String IO INW := do
  -- @@SCOPE BEGIN
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_SELF, DIVISION_OF_UNION_SELF,
        ELEMENTARY_EMPTY, ELEMENTARY_INTERVAL, FORALL_IN_DIVISION_NONEMPTY,
        PARTIAL_DIVISION_EXTEND, .. } := BINB
  let { EMPTY_SUBSET, EXTENSION, FINITE_NUMSEG, FORALL_IN_GSPEC, .. } :=
        D.dv.dg.pt.cvx.core1
  let { IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_SING, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        MONO_FORALL, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_LMUL_EQ, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_MUL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_SUP_LE_EQ, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE_GEN, SKOLEM_THM,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, SUM_0, SUM_ADD, SUM_EQ, SUM_IMAGE, SUM_LE, SUM_LE_NUMSEG,
        SUM_LMUL, SUM_POS_LE, SUM_SING, SUM_SUBSET_SIMPLE, SUM_SWAP, SUP_EQ, .. } :=
        D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { LIFT_DROP, NORM_0, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, NORM_MUL, NORM_NEG, NORM_POS_LE, NORM_TRIANGLE,
        REAL_ABS_NORM, .. } := D.dv.dg.pt.cvx.vec3
  let { drop, linear, .. } := D.dv.dg.pt.cvx.vec4
  let { bounded, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { REAL_ABS_ABS, .. } := D.dv.qsession
  let { LINEAR_BOUNDED_POS, .. } := D.dv.qvec
  let { SUM_MUL_BOUND, SUP_SING, .. } := D.qsession
  let { NORM_REAL, .. } := D.qvec
  -- @@SCOPE END

  parse_as_infix ("has_bounded_setvariation_on", (12, "right"))

  let set_variation ← new_definition
   r"set_variation s (f:(real^M->bool)->real^N) =
        sup { sum d (\k. norm(f k)) | ?t. d division_of t /\ t SUBSET s}"

  let has_bounded_setvariation_on ← new_definition
    r"(f:(real^M->bool)->real^N) has_bounded_setvariation_on s <=>
        ?B. !d t. d division_of t /\ t SUBSET s
                  ==> sum d (\k. norm(f k)) <= B"

  let SET_VARIATION_DEGENERATES ← prove
   r"!f:(real^M->bool)->real^N g s.
        ~(f has_bounded_setvariation_on s) /\
        ~(g has_bounded_setvariation_on s)
        ==> set_variation s f = set_variation s g"
   (REWRITE_TAC [has_bounded_setvariation_on, set_variation] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUP_EQ THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [])

  let HAS_BOUNDED_SETVARIATION_ON ← prove
   r"!f:(real^M->bool)->real^N s.
        f  has_bounded_setvariation_on s <=>
        ?B. &0 < B /\ !d t. d division_of t /\ t SUBSET s
                            ==> sum d (\k. norm(f k)) <= B"
   (REWRITE_TAC [has_bounded_setvariation_on] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < abs B + &1 /\ (x <= B ==> x <= abs B + &1)")])

  let HAS_BOUNDED_SET_VARIATION ← prove
   r"!f:(real^M->bool)->real^N s c.
        f has_bounded_setvariation_on s /\ set_variation s f <= c <=>
        !d t. d division_of t /\ t SUBSET s ==> sum d (\k. norm(f k)) <= c"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_setvariation_on, set_variation] THEN
    MATCH_MP_TAC (← TAUT (← q r"(r ==> p) /\ (p ==> (q <=> r)) ==> (p /\ q <=> r)")) THEN
    CONJ_TAC THENL [MESON_TAC [], DISCH_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) REAL_SUP_LE_EQ o lhand o snd) THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC, LEFT_IMP_EXISTS_THM] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    MESON_TAC [ELEMENTARY_EMPTY, EMPTY_SUBSET])

  let HAS_BOUNDED_SETVARIATION_COMPARISON ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
        f has_bounded_setvariation_on s /\
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> norm(g(interval[a,b])) <= norm(f(interval[a,b])))
        ==> g has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [has_bounded_setvariation_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC SUM_LE THEN
    CONJ_TAC THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN FIRST_ASSUM
     (fun th => tactic_of do
       pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let HAS_BOUNDED_SETVARIATION_ON_EQ ← prove
   r"!f g:(real^M->bool)->real^N s.
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> f(interval[a,b]) = g(interval[a,b])) /\
        f has_bounded_setvariation_on s
        ==> g has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      HAS_BOUNDED_SETVARIATION_COMPARISON) THEN
    ASM_SIMP_TAC [REAL_LE_REFL])

  let SET_VARIATION_EQ ← prove
   r"!f g:(real^M->bool)->real^N s.
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> f(interval[a,b]) = g(interval[a,b]))
        ==> set_variation s f = set_variation s g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [set_variation] THEN AP_TERM_TAC THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC SUM_EQ THEN FIRST_ASSUM (fun th => tactic_of do
      pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let HAS_BOUNDED_SETVARIATION_ON_COMPONENTWISE ← prove
   r"!f:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\k. lift(f k$i)) has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_setvariation_on, NORM_LIFT] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN EXISTS_TAC (← q r"B:real") THEN
      MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"]) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC SUM_LE THEN ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
      ASM_MESON_TAC [DIVISION_OF_FINITE],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:num->real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"sum (1..dimindex(:N)) B") THEN
      MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
      STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum d (\k. sum (1..dimindex(:N))
                           (\i. abs(((f:(real^M->bool)->real^N) k)$i)))") THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      ASM_SIMP_TAC [SUM_LE, NORM_LE_L1] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) SUM_SWAP o lhand o snd) THEN
      ASM_SIMP_TAC [FINITE_NUMSEG] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC SUM_LE_NUMSEG THEN ASM_MESON_TAC []])

  let HAS_BOUNDED_SETVARIATION_ON_LIFT_ABS ← prove
   r"!f:(real^N->bool)->real s.
        (\x. lift(abs(f x))) has_bounded_setvariation_on s <=>
        (\x. lift(f x)) has_bounded_setvariation_on s"
   (REWRITE_TAC [has_bounded_setvariation_on] THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_ABS])

  let SETVARIATION_EQUAL_LEMMA ← prove
   r"!mf:((real^M->bool)->real^N)->((real^M->bool)->real^N) ms ms'.
        (!s. ms'(ms s) = s /\ ms(ms' s) = s) /\
        (!f a b. ~(interval[a,b] = {})
                 ==> mf f (ms (interval[a,b])) = f (interval[a,b]) /\
                     ?a' b'. ~(interval[a',b'] = {}) /\
                             ms' (interval[a,b]) = interval[a',b']) /\
        (!t u. t SUBSET u ==> ms t SUBSET ms u /\ ms' t SUBSET ms' u) /\
        (!d t. d division_of t
               ==> (IMAGE ms d) division_of ms t /\
                   (IMAGE ms' d) division_of ms' t)
   ==> (!f s. (mf f) has_bounded_setvariation_on (ms s) <=>
              f has_bounded_setvariation_on s) /\
       (!f s. set_variation (ms s) (mf f) = set_variation s f)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [has_bounded_setvariation_on, set_variation] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"((!f s. s1 f s = s2 f s) ==> P) /\
      (!f s. s1 f s = s2 f s)
      ==> P /\ (!f s. sup (s1 f s) = sup (s2 f s))")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN REPEAT GEN_TAC THEN EQ_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [EXISTS_TAC (← q r"IMAGE (ms':(real^M->bool)->real^M->bool) d"),
      EXISTS_TAC (← q r"IMAGE (ms:(real^M->bool)->real^M->bool) d")] THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
     W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE o rand o snd) THEN
     ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC]) THEN
    MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [o_THM] THEN FIRST_ASSUM
     (fun th => tactic_of do
       pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN STRIP_TAC THEN
    AP_TERM_TAC THEN ASM_SIMP_TAC [] THEN
    SUBGOAL_THEN (← q r"?a' b':real^M. ~(interval[a',b'] = {}) /\
                        ms' (interval[a:real^M,b]) = interval[a',b']")
    STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  let HAS_BOUNDED_SETVARIATION_ON_ELEMENTARY ← prove
   r"!f:(real^M->bool)->real^N s.
        (?d. d division_of s)
        ==> (f has_bounded_setvariation_on s <=>
             ?B. !d. d division_of s ==> sum d (\k. norm(f k)) <= B)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [has_bounded_setvariation_on] THEN EQ_TAC THEN
    MATCH_MP_TAC MONO_EXISTS THENL [MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    GEN_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"d':(real^M->bool)->bool")) THEN
    MP_TAC (← ISPECL [← q r"d:(real^M->bool)->bool", ← q r"d':(real^M->bool)->bool",
               ← q r"t:real^M->bool", ← q r"s:real^M->bool"] PARTIAL_DIVISION_EXTEND) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"d'':(real^M->bool)->bool")) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d'' (\k:real^M->bool. norm(f k:real^N))") THEN
    ASM_SIMP_TAC [] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
    ASM_REWRITE_TAC [NORM_POS_LE] THEN ASM_MESON_TAC [DIVISION_OF_FINITE])

  let HAS_BOUNDED_SETVARIATION_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b.
        f has_bounded_setvariation_on interval[a,b] <=>
        ?B. !d. d division_of interval[a,b] ==> sum d (\k. norm(f k)) <= B"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HAS_BOUNDED_SETVARIATION_ON_ELEMENTARY THEN
    REWRITE_TAC [ELEMENTARY_INTERVAL])

  let HAS_BOUNDED_SETVARIATION_ON_UNIV ← prove
   r"!f:(real^M->bool)->real^N.
        f has_bounded_setvariation_on (:real^M) <=>
        ?B. !d. d division_of UNIONS d ==> sum d (\k. norm(f k)) <= B"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_setvariation_on, SUBSET_UNIV] THEN
    MESON_TAC [DIVISION_OF_UNION_SELF])

  let HAS_BOUNDED_SETVARIATION_ON_SUBSET ← prove
   r"!f:(real^M->bool)->real^N s t.
        f has_bounded_setvariation_on s /\ t SUBSET s
        ==> f has_bounded_setvariation_on t"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [has_bounded_setvariation_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM_MESON_TAC [SUBSET_TRANS])

  let HAS_BOUNDED_SETVARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS ← prove
   r"!f:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s
        ==> bounded { f(interval[c,d]) | interval[c,d] SUBSET s}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_setvariation_on, bounded] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
    EXISTS_TAC (← q r"max (abs B) (norm((f:(real^M->bool)->real^N) {}))") THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^M", ← q r"d:real^M"] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"interval[c:real^M,d] = {}") THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"a <= max b a")] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{interval[c:real^M,d]}", ← q r"interval[c:real^M,d]"]) THEN
    ASM_SIMP_TAC [DIVISION_OF_SELF, SUM_SING] THEN REAL_ARITH_TAC)

  let HAS_BOUNDED_SETVARIATION_ON_NORM ← prove
   r"!f:(real^M->bool)->real^N s.
        (\x. lift(norm(f x))) has_bounded_setvariation_on s <=>
        f has_bounded_setvariation_on s"
   (REWRITE_TAC [has_bounded_setvariation_on, NORM_REAL, ← GSYM drop] THEN
    REWRITE_TAC [REAL_ABS_NORM, LIFT_DROP])

  let HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR ← prove
   r"!f:(real^M->bool)->real^N g:real^N->real^P s.
        f has_bounded_setvariation_on s /\ linear g
        ==> (g o f) has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"B:real")) ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"C:real") o MATCH_MP LINEAR_BOUNDED_POS) THEN
    EXISTS_TAC (← q r"B * C:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN REWRITE_TAC [o_THM] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. C * norm((f:(real^M->bool)->real^N) k))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_MESON_TAC [DIVISION_OF_FINITE],
      GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
      REWRITE_TAC [SUM_LMUL] THEN ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
      ASM_MESON_TAC []])

  let HAS_BOUNDED_SETVARIATION_ON_0 ← prove
   r"!s:real^N->bool. (\x. vec 0) has_bounded_setvariation_on s"
   (REWRITE_TAC [has_bounded_setvariation_on, NORM_0, SUM_0] THEN
    MESON_TAC [REAL_LE_REFL])

  let SET_VARIATION_0 ← prove
   r"!s:real^N->bool. set_variation s (\x. vec 0) = &0"
   (GEN_TAC THEN REWRITE_TAC [set_variation, NORM_0, SUM_0] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM SUP_SING] THEN
    AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING] THEN
    MESON_TAC [ELEMENTARY_EMPTY, EMPTY_SUBSET])

  let HAS_BOUNDED_SETVARIATION_ON_CMUL ← prove
   r"!f:(real^M->bool)->real^N c s.
        f has_bounded_setvariation_on s
        ==> (\x. c % f x) has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT, o_DEF]
       HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR) THEN
    REWRITE_TAC [linear] THEN VECTOR_ARITH_TAC)

  let HAS_BOUNDED_SETVARIATION_ON_NEG ← prove
   r"!f:(real^M->bool)->real^N s.
        (\x. --(f x)) has_bounded_setvariation_on s <=>
        f has_bounded_setvariation_on s"
   (REWRITE_TAC [has_bounded_setvariation_on, NORM_NEG])

  let HAS_BOUNDED_SETVARIATION_ON_ADD ← prove
   r"!f:(real^M->bool)->real^N g s.
        f has_bounded_setvariation_on s /\
        g has_bounded_setvariation_on s
        ==> (\x. f x + g x) has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_setvariation_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"B + C:real") THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. norm((f:(real^M->bool)->real^N) k)) +
              sum d (\k. norm((g:(real^M->bool)->real^N) k))") THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LE_ADD2]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM SUM_ADD] THEN
    MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [NORM_TRIANGLE])

  let HAS_BOUNDED_SETVARIATION_ON_SUB ← prove
   r"!f:(real^M->bool)->real^N g s.
        f has_bounded_setvariation_on s /\
        g has_bounded_setvariation_on s
        ==> (\x. f x - g x) has_bounded_setvariation_on s"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = x + --y")] THEN
    SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_ADD, HAS_BOUNDED_SETVARIATION_ON_NEG])

  let HAS_BOUNDED_SETVARIATION_ON_MUL ← prove
   r"!f g:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s /\
        g has_bounded_setvariation_on s
        ==> (\x. drop(f x) % g x) has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_setvariation_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"B1:real")) (X_CHOOSE_TAC (← q r"B2:real"))) THEN
    EXISTS_TAC (← q r"B1 * B2:real") THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"])) THEN
    ASM_REWRITE_TAC [NORM_MUL, ← GSYM NORM_1, IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [← TAUT
     (← q r"p /\ q /\ r /\ s ==> t <=> q /\ s ==> p /\ r ==> t")] REAL_LE_MUL2)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [SUM_POS_LE, NORM_POS_LE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC SUM_MUL_BOUND THEN ASM_REWRITE_TAC [NORM_POS_LE])

  pure { set_variation, has_bounded_setvariation_on, SET_VARIATION_DEGENERATES,
         HAS_BOUNDED_SETVARIATION_ON, HAS_BOUNDED_SET_VARIATION,
         HAS_BOUNDED_SETVARIATION_COMPARISON, HAS_BOUNDED_SETVARIATION_ON_EQ,
         SET_VARIATION_EQ, HAS_BOUNDED_SETVARIATION_ON_COMPONENTWISE,
         HAS_BOUNDED_SETVARIATION_ON_LIFT_ABS, SETVARIATION_EQUAL_LEMMA,
         HAS_BOUNDED_SETVARIATION_ON_ELEMENTARY, HAS_BOUNDED_SETVARIATION_ON_INTERVAL,
         HAS_BOUNDED_SETVARIATION_ON_UNIV, HAS_BOUNDED_SETVARIATION_ON_SUBSET,
         HAS_BOUNDED_SETVARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS,
         HAS_BOUNDED_SETVARIATION_ON_NORM, HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR,
         HAS_BOUNDED_SETVARIATION_ON_0, SET_VARIATION_0, HAS_BOUNDED_SETVARIATION_ON_CMUL,
         HAS_BOUNDED_SETVARIATION_ON_NEG, HAS_BOUNDED_SETVARIATION_ON_ADD,
         HAS_BOUNDED_SETVARIATION_ON_SUB, HAS_BOUNDED_SETVARIATION_ON_MUL }

/- ------------------------------------------------------------------------- -/
/- Set variation: null sets, bounds, triangle inequality, sums, pastecart.  -/
/- (integration.ml 8983-9345)                                                -/
/- ------------------------------------------------------------------------- -/

structure INX where
  HAS_BOUNDED_SETVARIATION_ON_NULL : thm
  SET_VARIATION_ON_EMPTY : thm
  SET_VARIATION_ELEMENTARY_LEMMA : thm
  SET_VARIATION_ON_ELEMENTARY : thm
  SET_VARIATION_ON_INTERVAL : thm
  SET_VARIATION_INTERVAL_LEMMA : thm
  HAS_BOUNDED_SETVARIATION_WORKS : thm
  HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY : thm
  HAS_BOUNDED_SETVARIATION_WORKS_ON_INTERVAL : thm
  SET_VARIATION_UBOUND : thm
  SET_VARIATION_UBOUND_ON_INTERVAL : thm
  SET_VARIATION_LBOUND : thm
  SET_VARIATION_LBOUND_ON_INTERVAL : thm
  SET_VARIATION : thm
  SET_VARIATION_WORKS_ON_INTERVAL : thm
  SET_VARIATION_POS_LE : thm
  SET_VARIATION_CMUL : thm
  SET_VARIATION_COMPARISON : thm
  SET_VARIATION_GE_FUNCTION : thm
  SET_VARIATION_ON_NULL : thm
  SET_VARIATION_TRIANGLE : thm
  HAS_BOUNDED_SETVARIATION_ON_VSUM : thm
  SET_VARIATION_SUM_LE : thm
  BOUNDED_SET_VARIATION_ON_PASTECART : thm
  BOUNDED_SET_VARIATION_FROM_PASTECART : thm
  HAS_BOUNDED_SETVARIATION_ON_PASTECART : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINX [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) : ExceptT String IO INX := do
  -- @@SCOPE BEGIN
  let { CONTENT_0_SUBSET_GEN, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_SELF, DIVISION_OF_TRIVIAL,
        ELEMENTARY_EMPTY, ELEMENTARY_INTERVAL, FORALL_IN_DIVISION,
        FORALL_IN_DIVISION_NONEMPTY, PARTIAL_DIVISION_EXTEND, .. } := BINB
  let { HAS_BOUNDED_SET_VARIATION, HAS_BOUNDED_SETVARIATION_COMPARISON,
        has_bounded_setvariation_on, HAS_BOUNDED_SETVARIATION_ON_0,
        HAS_BOUNDED_SETVARIATION_ON_ADD, set_variation, SET_VARIATION_0, .. } := BINW
  let { AND_FORALL_THM, CONJ_SYM, EMPTY_SUBSET, ETA_AX, FINITE_EMPTY, FINITE_INDUCT_STRONG,
        FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL,
        NOT_IN_EMPTY, REAL_ABS_NUM, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_LADD, REAL_LE_RDIV_EQ, REAL_LE_REFL,
        REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_SYM, REAL_SUP_LE_EQ, SIMPLE_IMAGE_GEN, SUBSET_EMPTY,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { SUM_ADD, SUM_CLAUSES, SUM_EQ_0, SUM_LE, SUM_LMUL, SUM_SING, SUM_SUBSET_SIMPLE, SUP,
        SUP_UNIQUE, UNIONS_0, UNIONS_INSERT, UNWIND_THM2, .. } := D.dv.dg.pt.cvx.core6
  let { NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_TRIANGLE, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_MUL_LZERO, VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { NORM_PASTECART_LE, .. } := D.dv.qvec
  let { sup, SUP_SING, .. } := D.qsession
  let { EMPTY_AS_INTERVAL, UNION_INTERVAL_SUBSET_INTERVAL, .. } := D.qtopology
  let { NORM_LE_PASTECART, .. } := D.qvec
  -- @@SCOPE END

  let HAS_BOUNDED_SETVARIATION_ON_NULL ← prove
   r"!f:(real^M->bool)->real^N s.
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s /\
               content(interval[a,b]) = &0
               ==> f(interval[a,b]) = vec 0) /\
        content s = &0 /\ bounded s
        ==> f has_bounded_setvariation_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_BOUNDED_SETVARIATION_COMPARISON THEN
    EXISTS_TAC (← q r"(\x. vec 0):(real^M->bool)->real^N") THEN
    REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_0, ← NORM_ARITH
     (← q r"norm(x:real^N) <= norm(vec 0:real^M) <=> x = vec 0")] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTENT_0_SUBSET_GEN THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let SET_VARIATION_ON_EMPTY ← prove
   r"!f:(real^M->bool)->real^N. set_variation {} f = &0"
   (REWRITE_TAC [set_variation, SUBSET_EMPTY, DIVISION_OF_TRIVIAL,
                 ← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM2] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x | x = a} = {f a}"), SUM_CLAUSES, SUP_SING])

  let SET_VARIATION_ELEMENTARY_LEMMA ← prove
   r"!f:(real^M->bool)->real^N s.
        (?d. d division_of s)
        ==> ((!d t. d division_of t /\ t SUBSET s
                    ==> sum d (\k. norm(f k)) <= b) <=>
             (!d. d division_of s ==> sum d (\k. norm(f k)) <= b))"
   (REPEAT GEN_TAC THEN DISCH_THEN (X_CHOOSE_TAC (← q r"d1:(real^M->bool)->bool")) THEN
    EQ_TAC THENL [MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"d2:(real^M->bool)->bool") THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"d2:(real^M->bool)->bool", ← q r"d1:(real^M->bool)->bool",
      ← q r"t:real^M->bool", ← q r"s:real^M->bool"] PARTIAL_DIVISION_EXTEND) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"d3:(real^M->bool)->bool")) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d3 (\k:real^M->bool. norm(f k:real^N))") THEN
    ASM_SIMP_TAC [] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
    ASM_REWRITE_TAC [NORM_POS_LE] THEN ASM_MESON_TAC [DIVISION_OF_FINITE])

  let SET_VARIATION_ON_ELEMENTARY ← prove
   r"!f:(real^M->bool)->real^N s.
        (?d. d division_of s)
        ==> set_variation s f =
             sup { sum d (\k. norm(f k)) | d division_of s}"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [set_variation, sup] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, LEFT_IMP_EXISTS_THM] THEN
    ASM_SIMP_TAC [SET_VARIATION_ELEMENTARY_LEMMA])

  let SET_VARIATION_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b.
        set_variation (interval[a,b]) f =
        sup { sum d (\k. norm(f k)) | d division_of interval[a,b]}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SET_VARIATION_ON_ELEMENTARY THEN
    REWRITE_TAC [ELEMENTARY_INTERVAL])

  let SET_VARIATION_INTERVAL_LEMMA ← prove
   r"!f:(real^M->bool)->real^N s c.
        is_interval s
        ==> ((!d t. d division_of t /\ t SUBSET s
                    ==> sum d (\k. norm(f k)) <= c) <=>
             (!d a b. d division_of interval[a,b] /\ interval[a,b] SUBSET s
                      ==>  sum d (\k. norm(f k)) <= c))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?u v:real^M. UNIONS d SUBSET interval[u,v] /\ interval[u,v] SUBSET s")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!k. k IN d ==> k SUBSET s /\ ?u v:real^M. k = interval[u,v]")
      MP_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"FINITE(d:(real^M->bool)->bool)") MP_TAC THENL
       [ASM_MESON_TAC [DIVISION_OF_FINITE],
        UNDISCH_TAC (← q r"is_interval(s:real^M->bool)") THEN
        POP_ASSUM_LIST (K ALL_TAC) THEN DISCH_TAC THEN
        SPEC_TAC (← q r"d:(real^M->bool)->bool", ← q r"d:(real^M->bool)->bool")] THEN
      ONCE_REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
      CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_0, EMPTY_SUBSET] THEN
        MESON_TAC [EMPTY_AS_INTERVAL, EMPTY_SUBSET],
        MAP_EVERY X_GEN_TAC [← q r"k:real^M->bool", ← q r"d:(real^M->bool)->bool"] THEN
        REWRITE_TAC [UNIONS_INSERT, FORALL_IN_INSERT] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
                MP_TAC (← CONJUNCT1 th) THEN
                ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM])) THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^M", ← q r"v:real^M"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"w:real^M")
         (X_CHOOSE_THEN (← q r"z:real^M") MP_TAC)) THEN
        DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"s:real^M->bool", ← q r"w:real^M", ← q r"z:real^M",
                          ← q r"u:real^M", ← q r"v:real^M"]
          UNION_INTERVAL_SUBSET_INTERVAL) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC []],
      MP_TAC (← ISPECL [← q r"u:real^M", ← q r"v:real^M"] ELEMENTARY_INTERVAL) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"d':(real^M->bool)->bool")) THEN
      MP_TAC (← ISPECL
       [← q r"d:(real^M->bool)->bool", ← q r"d':(real^M->bool)->bool",
        ← q r"t:real^M->bool", ← q r"interval[u:real^M,v]"]
          PARTIAL_DIVISION_EXTEND) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d'':(real^M->bool)->bool") STRIP_ASSUME_TAC) THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"sum d'' (\k. norm((f:(real^M->bool)->real^N) k))") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
      ASM_REWRITE_TAC [NORM_POS_LE] THEN
      ASM_MESON_TAC [DIVISION_OF_FINITE]])

  let HAS_BOUNDED_SETVARIATION_WORKS ← prove
   r"!f:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s
        ==> (!d t. d division_of t /\ t SUBSET s
                   ==> sum d (\k. norm(f k)) <= set_variation s f) /\
            (!B. (!d t. d division_of t /\ t SUBSET s
                        ==> sum d (\k. norm (f k)) <= B)
                 ==> set_variation s f <= B)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_setvariation_on] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"{ sum d (\k. norm((f:(real^M->bool)->real^N) k)) |
                  ?t. d division_of t /\ t SUBSET s}")
           SUP) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [set_variation] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"{}:(real^M->bool)->bool"] THEN
    REWRITE_TAC [SUM_CLAUSES] THEN EXISTS_TAC (← q r"{}:real^M->bool") THEN
    SIMP_TAC [division_of, EMPTY_SUBSET, NOT_IN_EMPTY, FINITE_EMPTY, UNIONS_0])

  let HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY ← prove
   r"!f:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s /\ (?d. d division_of s)
        ==> (!d. d division_of s
                 ==> sum d (\k. norm(f k)) <= set_variation s f) /\
            (!B. (!d. d division_of s ==> sum d (\k. norm(f k)) <= B)
                 ==> set_variation s f <= B)"
   (SIMP_TAC [← GSYM SET_VARIATION_ELEMENTARY_LEMMA] THEN
    MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS])

  let HAS_BOUNDED_SETVARIATION_WORKS_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b.
      f has_bounded_setvariation_on interval[a,b]
      ==> (!d. d division_of interval[a,b]
               ==> sum d (\k. norm(f k)) <= set_variation (interval[a,b]) f) /\
          (!B. (!d. d division_of interval[a,b]
                    ==> sum d (\k. norm(f k)) <= B)
               ==> set_variation (interval[a,b]) f <= B)"
   (SIMP_TAC [HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY, ELEMENTARY_INTERVAL])

  let SET_VARIATION_UBOUND ← prove
   r"!f:(real^M->bool)->real^N s B.
        f has_bounded_setvariation_on s /\
        (!d t. d division_of t /\ t SUBSET s ==> sum d (\k. norm(f k)) <= B)
        ==> set_variation s f <= B"
   (MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS])

  let SET_VARIATION_UBOUND_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b B.
        f has_bounded_setvariation_on interval[a,b] /\
        (!d. d division_of interval[a,b] ==> sum d (\k. norm(f k)) <= B)
        ==> set_variation (interval[a,b]) f <= B"
   (SIMP_TAC [← GSYM SET_VARIATION_ELEMENTARY_LEMMA, ELEMENTARY_INTERVAL] THEN
    MESON_TAC [SET_VARIATION_UBOUND])

  let SET_VARIATION_LBOUND ← prove
   r"!f:(real^M->bool)->real^N s B.
        f has_bounded_setvariation_on s /\
        (?d t. d division_of t /\ t SUBSET s /\ B <= sum d (\k. norm(f k)))
        ==> B <= set_variation s f"
   (MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS, REAL_LE_TRANS])

  let SET_VARIATION_LBOUND_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b B.
        f has_bounded_setvariation_on interval[a,b] /\
        (?d. d division_of interval[a,b] /\ B <= sum d (\k. norm(f k)))
        ==> B <= set_variation (interval[a,b]) f"
   (MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS_ON_INTERVAL, REAL_LE_TRANS])

  let SET_VARIATION ← prove
   r"!f:(real^M->bool)->real^N s d t.
        f has_bounded_setvariation_on s /\ d division_of t /\ t SUBSET s
        ==> sum d (\k. norm(f k)) <= set_variation s f"
   (MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS])

  let SET_VARIATION_WORKS_ON_INTERVAL ← prove
   r"!f:(real^M->bool)->real^N a b d.
        f has_bounded_setvariation_on interval[a,b] /\
        d division_of interval[a,b]
        ==> sum d (\k. norm(f k)) <= set_variation (interval[a,b]) f"
   (MESON_TAC [HAS_BOUNDED_SETVARIATION_WORKS_ON_INTERVAL])

  let SET_VARIATION_POS_LE ← prove
   r"!f:(real^M->bool)->real^N s.
        f has_bounded_setvariation_on s ==> &0 <= set_variation s f"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] SET_VARIATION)) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"{}:(real^M->bool)->bool", ← q r"{}:real^M->bool"]) THEN
    REWRITE_TAC [EMPTY_SUBSET, SUM_CLAUSES, DIVISION_OF_TRIVIAL])

  let SET_VARIATION_CMUL ← prove
   r"!f:(real^M->bool)->real^N s c.
        f has_bounded_setvariation_on s
        ==> set_variation s (\x. c % f x) = abs c * set_variation s f"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, SET_VARIATION_0, REAL_ABS_NUM,
                     REAL_MUL_LZERO] THEN
    REWRITE_TAC [has_bounded_setvariation_on, set_variation] THEN
    DISCH_TAC THEN REWRITE_TAC [NORM_MUL, SUM_LMUL] THEN
    MATCH_MP_TAC SUP_UNIQUE THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"r:real") THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 < abs x <=> ~(x = &0)")] THEN
    CONV_TAC SYM_CONV THEN
    W (MP_TAC o PART_MATCH (lhs o rand) REAL_SUP_LE_EQ o lhand o snd) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    ASM_MESON_TAC [ELEMENTARY_EMPTY, EMPTY_SUBSET])

  let SET_VARIATION_COMPARISON ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
        f has_bounded_setvariation_on s /\
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> norm(g(interval[a,b])) <= norm(f(interval[a,b])))
        ==> set_variation s g <= set_variation s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SET_VARIATION_UBOUND THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HAS_BOUNDED_SETVARIATION_COMPARISON], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o MATCH_MP
     HAS_BOUNDED_SETVARIATION_WORKS) THEN
     REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC SUM_LE THEN
    CONJ_TAC THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN FIRST_ASSUM
     (fun th => tactic_of do
       pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let SET_VARIATION_GE_FUNCTION ← prove
   r"!f:(real^M->bool)->real^N s a b.
        f has_bounded_setvariation_on s /\
        interval[a,b] SUBSET s /\ ~(interval[a,b] = {})
        ==> norm(f(interval[a,b])) <= set_variation s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SET_VARIATION_LBOUND THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"{interval[a:real^M,b]}") THEN
    EXISTS_TAC (← q r"interval[a:real^M,b]") THEN
    ASM_REWRITE_TAC [SUM_SING, REAL_LE_REFL] THEN
    ASM_SIMP_TAC [DIVISION_OF_SELF])

  let SET_VARIATION_ON_NULL ← prove
   r"!f:(real^M->bool)->real^N s.
        (!a b. content(interval[a,b]) = &0 ==> f(interval[a,b]) = vec 0) /\
        content s = &0 /\ bounded s
        ==> set_variation s f = &0"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SET_VARIATION_UBOUND THEN
      ASM_SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_NULL] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = &0 ==> x <= &0")) THEN
      MATCH_MP_TAC SUM_EQ_0 THEN REWRITE_TAC [NORM_EQ_0] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC CONTENT_0_SUBSET_GEN THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [division_of, SUBSET_TRANS],
      MATCH_MP_TAC SET_VARIATION_POS_LE THEN
      ASM_SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_NULL]])

  let SET_VARIATION_TRIANGLE ← prove
   r"!f:(real^M->bool)->real^N g s.
        f has_bounded_setvariation_on s /\
        g has_bounded_setvariation_on s
        ==> set_variation s (\x. f x + g x)
             <= set_variation s f + set_variation s g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SET_VARIATION_UBOUND THEN
    ASM_SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_ADD] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. norm((f:(real^M->bool)->real^N) k)) +
              sum d (\k. norm((g:(real^M->bool)->real^N) k))") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      ASM_SIMP_TAC [← GSYM SUM_ADD] THEN
      MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [NORM_TRIANGLE],
      MATCH_MP_TAC REAL_LE_ADD2 THEN
      CONJ_TAC THEN MATCH_MP_TAC SET_VARIATION THEN ASM_MESON_TAC []])

  let (HAS_BOUNDED_SETVARIATION_ON_VSUM, SET_VARIATION_SUM_LE) ← CONJ_PAIR (← prove
   r"(!f:A->(real^M->bool)->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i has_bounded_setvariation_on s)
        ==> (\x. vsum k (\i. f i x)) has_bounded_setvariation_on s) /\
   (!f:A->(real^M->bool)->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i has_bounded_setvariation_on s)
        ==> set_variation s (\x. vsum k (\i. f i x))
            <= sum k (\i. set_variation s (f i)))"
   (REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [SET_VARIATION_0, REAL_LE_REFL, HAS_BOUNDED_SETVARIATION_ON_0,
              HAS_BOUNDED_SETVARIATION_ON_ADD, ETA_AX] THEN
    REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      SET_VARIATION_TRIANGLE o lhand o snd) THEN
    ASM_SIMP_TAC [ETA_AX] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [REAL_LE_LADD]))

  let BOUNDED_SET_VARIATION_ON_PASTECART ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
        f has_bounded_setvariation_on s /\
        g has_bounded_setvariation_on s
        ==> (\x. pastecart (f x) (g x)) has_bounded_setvariation_on s /\
            set_variation s (\x. pastecart (f x) (g x)) <=
                set_variation s f + set_variation s g"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN SIMP_TAC [HAS_BOUNDED_SET_VARIATION] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum d (\k. norm((f:(real^M->bool)->real^N) k) +
               norm((g:(real^M->bool)->real^P) k))") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [NORM_PASTECART_LE, SUM_LE] THEN
    ASM_SIMP_TAC [SUM_ADD] THEN MATCH_MP_TAC REAL_LE_ADD2 THEN
    CONJ_TAC THEN MATCH_MP_TAC SET_VARIATION THEN ASM_MESON_TAC [])

  let BOUNDED_SET_VARIATION_FROM_PASTECART ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
      (\x. pastecart (f x) (g x)) has_bounded_setvariation_on s
      ==> (f has_bounded_setvariation_on s /\
           set_variation s f <= set_variation s (\x. pastecart (f x) (g x))) /\
          (g has_bounded_setvariation_on s /\
           set_variation s g <= set_variation s (\x. pastecart (f x) (g x)))"
   (REPEAT STRIP_TAC THEN
    (FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← HolLight.INST_TYPE [(← qty "Q", ← qty "P")]
            HAS_BOUNDED_SETVARIATION_COMPARISON))) ORELSE
     FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← HolLight.INST_TYPE [(← qty "Q", ← qty "P")] SET_VARIATION_COMPARISON)))) THEN
    ASM_REWRITE_TAC [NORM_LE_PASTECART])

  let HAS_BOUNDED_SETVARIATION_ON_PASTECART ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
        (\x. pastecart (f x) (g x)) has_bounded_setvariation_on s <=>
        f has_bounded_setvariation_on s /\ g has_bounded_setvariation_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [BOUNDED_SET_VARIATION_ON_PASTECART] THEN
    DISCH_THEN (MP_TAC o MATCH_MP BOUNDED_SET_VARIATION_FROM_PASTECART) THEN
    SIMP_TAC [])

  pure { HAS_BOUNDED_SETVARIATION_ON_NULL, SET_VARIATION_ON_EMPTY,
         SET_VARIATION_ELEMENTARY_LEMMA, SET_VARIATION_ON_ELEMENTARY,
         SET_VARIATION_ON_INTERVAL, SET_VARIATION_INTERVAL_LEMMA,
         HAS_BOUNDED_SETVARIATION_WORKS, HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY,
         HAS_BOUNDED_SETVARIATION_WORKS_ON_INTERVAL, SET_VARIATION_UBOUND,
         SET_VARIATION_UBOUND_ON_INTERVAL, SET_VARIATION_LBOUND,
         SET_VARIATION_LBOUND_ON_INTERVAL, SET_VARIATION, SET_VARIATION_WORKS_ON_INTERVAL,
         SET_VARIATION_POS_LE, SET_VARIATION_CMUL, SET_VARIATION_COMPARISON,
         SET_VARIATION_GE_FUNCTION, SET_VARIATION_ON_NULL, SET_VARIATION_TRIANGLE,
         HAS_BOUNDED_SETVARIATION_ON_VSUM, SET_VARIATION_SUM_LE,
         BOUNDED_SET_VARIATION_ON_PASTECART, BOUNDED_SET_VARIATION_FROM_PASTECART,
         HAS_BOUNDED_SETVARIATION_ON_PASTECART }

/- ------------------------------------------------------------------------- -/
/- Set variation is operative; divisions; monotonicity; reflection and      -/
/- translation.  (integration.ml 9346-9661)                                  -/
/- ------------------------------------------------------------------------- -/

structure INY where
  OPERATIVE_LIFTED_SETVARIATION : thm
  OPERATIVE_HAS_BOUNDED_SETVARIATION_ON : thm
  HAS_BOUNDED_SETVARIATION_ON_DIVISION : thm
  SET_VARIATION_ON_DIVISION : thm
  SET_VARIATION_MONOTONE : thm
  HAS_BOUNDED_SETVARIATION_REFLECT2_EQ : thm
  SET_VARIATION_REFLECT2 : thm
  HAS_BOUNDED_SETVARIATION_TRANSLATION2_EQ : thm
  SET_VARIATION_TRANSLATION2 : thm
  HAS_BOUNDED_SETVARIATION_TRANSLATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINY [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINF : INF) (BING : ING) (BINH : INH) (BINL : INL) (BINW : INW) (BINX : INX) : ExceptT String IO INY := do
  -- @@SCOPE BEGIN
  let { CONTENT_0_SUBSET_GEN, CONTENT_EMPTY, CONTENT_EQ_0, .. } := BINA
  let { DIVISION_DISJOINT_UNION, division_of, DIVISION_OF_FINITE, DIVISION_OF_REFLECT,
        DIVISION_OF_TRANSLATION, DIVISION_OF_TRIVIAL, FORALL_IN_DIVISION, .. } := BINB
  let { DIVISION_SPLIT, DIVISION_SPLIT_LEFT_INJ, DIVISION_SPLIT_RIGHT_INJ, INTERVAL_SPLIT,
        .. } := BINF
  let { lifted, MONOIDAL_LIFTED, NEUTRAL_LIFTED, operative, .. } := BING
  let { OPERATIVE_DIVISION, .. } := BINH
  let { NEUTRAL_AND, OPERATIVE_DIVISION_AND, .. } := BINL
  let { has_bounded_setvariation_on, HAS_BOUNDED_SETVARIATION_ON_INTERVAL,
        HAS_BOUNDED_SETVARIATION_ON_SUBSET, set_variation, SETVARIATION_EQUAL_LEMMA, .. } :=
        BINW
  let { HAS_BOUNDED_SETVARIATION_ON_NULL, SET_VARIATION_ON_NULL,
        SET_VARIATION_UBOUND_ON_INTERVAL, SET_VARIATION_WORKS_ON_INTERVAL, .. } := BINX
  let { AND_FORALL_THM, CONTRAPOS_THM, EMPTY_SUBSET, ETA_AX, FINITE_INDUCT_STRONG,
        FINITE_RESTRICT, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { IMAGE_ID, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_IMP, INTER_SUBSET, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND,
        MONO_FORALL, NEUTRAL_REAL_ADD, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_TRANS, REAL_LT_LADD, REAL_LT_NEG2, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_SUP_LE_SUBSET, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE_GEN,
        SUBSET, SUBSET_INTER, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, sum, SUM_ADD, SUM_CLAUSES, SUM_LE, SUM_SUPERSET, UNWIND_THM1, .. } :=
        D.dv.dg.pt.cvx.core6
  let { NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { VECTOR_ADD_COMPONENT, VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { INTERIOR_INTER, .. } := D.dv.dg.pt.cvx.top4
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { INTER_ASSOC, .. } := D.dv.dg.pt.qses
  let { BOUNDED_INTER, BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { ITERATE_CLAUSES, MONOIDAL_REAL_ADD, option_INDUCT, SUM_IMAGE_NONZERO,
        SUM_UNION_NONZERO, .. } := D.qsession
  let { EMPTY_AS_INTERVAL, EQ_INTERVAL, INTERIOR_STANDARD_HYPERPLANE, INTERVAL_TRANSLATION,
        .. } := D.qtopology
  let { INTERVAL_EQ_EMPTY, NEUTRAL_VECTOR_ADD, REFLECT_INTERVAL, .. } := D.qvec
  let { distinctness, injectivity, .. } := D
  -- @@SCOPE END

  let OPERATIVE_LIFTED_SETVARIATION ← (do
    let lemma1 ← prove
     r"!f:(real^M->bool)->real B1 B2 k a b.
      1 <= k /\ k <= dimindex(:M) /\
      (!a b. content(interval[a,b]) = &0 ==> f(interval[a,b]) = &0) /\
      (!a b c. f(interval[a,b]) <=
               f(interval[a,b] INTER {x | x$k <= c}) +
               f(interval[a,b] INTER {x | x$k >= c})) /\
      (!d. d division_of (interval[a,b] INTER {x | x$k <= c})
           ==> sum d f <= B1) /\
      (!d. d division_of (interval[a,b] INTER {x | x$k >= c})
           ==> sum d f <= B2)
      ==> !d. d division_of interval[a,b] ==> sum d f <= B1 + B2"
     (REPEAT GEN_TAC THEN
      REPLICATE_TAC 4 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "L") (LABEL_TAC "R")) THEN
      GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"sum {l INTER {x:real^M | x$k <= c} | l | l IN d /\
                                        ~(l INTER {x | x$k <= c} = {})} f +
      sum {l INTER {x | x$k >= c} | l | l IN d /\
                                        ~(l INTER {x | x$k >= c} = {})} f") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [DIVISION_SPLIT]] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      W (fun (_, w) => tactic_of do
           let rw ← liftExcept (rand w)
           pure (MP_TAC (← PART_MATCH (lhs o rand) SUM_IMAGE_NONZERO
                            (← liftExcept (lhand rw))) THEN
                 MP_TAC (← PART_MATCH (lhs o rand) SUM_IMAGE_NONZERO
                            (← liftExcept (rand rw))))) THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(a1 /\ a2) /\ (b1 /\ b2 ==> c)
        ==> (a1 ==> b1) ==> (a2 ==> b2) ==> c")) THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [FINITE_RESTRICT, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [FORALL_IN_GSPEC, IMP_CONJ] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
        REPEAT STRIP_TAC THEN ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT] THENL
         [MATCH_MP_TAC DIVISION_SPLIT_RIGHT_INJ,
          MATCH_MP_TAC DIVISION_SPLIT_LEFT_INJ] THEN
        ASM_MESON_TAC [],
        DISCH_THEN (CONJUNCTS_THEN SUBST1_TAC)] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"sum d (f o (\l. l INTER {x | x$k <= c})) +
      sum d (f o (\l. l INTER {x:real^M | x$k >= c}))") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM SUM_ADD] THEN MATCH_MP_TAC SUM_LE THEN
        ASM_REWRITE_TAC [o_THM] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])),
        MATCH_MP_TAC (← REAL_ARITH (← q r"x = y /\ w = z ==> x + w <= y + z")) THEN
        CONJ_TAC THEN MATCH_MP_TAC SUM_SUPERSET THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} SUBSET s")] THEN
        REWRITE_TAC [← SET_RULE (← q r"(x IN s /\ ~(x IN {x | x IN s /\ ~P x}) ==> Q x) <=>
                            (x IN s ==> P x ==> Q x)")] THEN
        SIMP_TAC [o_THM] THEN ASM_MESON_TAC [EMPTY_AS_INTERVAL, CONTENT_EMPTY]])
    let lemma2 ← prove
     r"!f:(real^M->bool)->real B k.
      1 <= k /\ k <= dimindex(:M) /\
      (!a b. content(interval[a,b]) = &0 ==> f(interval[a,b]) = &0) /\
      (!d. d division_of interval[a,b] ==> sum d f <= B)
      ==> !d1 d2. d1 division_of (interval[a,b] INTER {x | x$k <= c}) /\
                  d2 division_of (interval[a,b] INTER {x | x$k >= c})
                  ==> sum d1 f + sum d2 f <= B"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d1 UNION d2:(real^M->bool)->bool")) THEN
      ANTS_TAC THENL
       [SUBGOAL_THEN
         (← q r"interval[a,b] = (interval[a,b] INTER {x:real^M | x$k <= c}) UNION
                        (interval[a,b] INTER {x:real^M | x$k >= c})")
        SUBST1_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"(!x. x IN t \/ x IN u) ==> (s = s INTER t UNION s INTER u)")) THEN
          REWRITE_TAC [IN_ELIM_THM] THEN REAL_ARITH_TAC,
          MATCH_MP_TAC DIVISION_DISJOINT_UNION THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [← GSYM INTERIOR_INTER] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"!t. interior s SUBSET interior t /\ interior t = {}
              ==> interior s = {}")) THEN
          EXISTS_TAC (← q r"{x:real^M | x$k = c}") THEN CONJ_TAC THENL
           [ALL_TAC, REWRITE_TAC [INTERIOR_STANDARD_HYPERPLANE]] THEN
          MATCH_MP_TAC SUBSET_INTERIOR THEN
          REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC],
        MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= b ==> y <= b")) THEN
        MATCH_MP_TAC SUM_UNION_NONZERO THEN
        REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_FINITE], ALL_TAC]) THEN
        X_GEN_TAC (← q r"k:real^M->bool") THEN REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]")
          (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
        THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC CONTENT_0_SUBSET_GEN THEN
        EXISTS_TAC (← q r"interval[a,b] INTER {x:real^M | x$k = c}") THEN CONJ_TAC THENL
         [MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"(interval[a,b] INTER {x:real^M | x$k <= c}) INTER
                    (interval[a,b] INTER {x:real^M | x$k >= c})") THEN
          CONJ_TAC THENL
           [ONCE_REWRITE_TAC [SUBSET_INTER] THEN ASM_MESON_TAC [division_of],
            REWRITE_TAC [← SET_RULE
              (← q r"(s INTER t) INTER (s INTER u) = s INTER t INTER u")] THEN
            SIMP_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN REAL_ARITH_TAC],
          SIMP_TAC [BOUNDED_INTER, BOUNDED_INTERVAL] THEN
          GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
           [← REAL_ARITH (← q r"x = y <=> x <= y /\ x >= y")] THEN
          REWRITE_TAC [← SET_RULE
           (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
          ASM_SIMP_TAC [← GSYM INTER_ASSOC, INTERVAL_SPLIT] THEN
          REWRITE_TAC [CONTENT_EQ_0] THEN EXISTS_TAC (← q r"k:num") THEN
          ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC]])
    let l1 ← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM] lemma1
    let l2 ← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM] lemma2
    prove
     r"!f:(real^M->bool)->real^N.
        operative(+) f
        ==> operative (lifted(+))
                      (\i. if f has_bounded_setvariation_on i
                           then SOME(set_variation i f) else NONE)"
     (REWRITE_TAC [operative, NEUTRAL_VECTOR_ADD] THEN REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (ASSUME_TAC o GSYM)) THEN
      ASM_SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_NULL, BOUNDED_INTERVAL,
       MONOIDAL_REAL_ADD, SET_VARIATION_ON_NULL, NEUTRAL_LIFTED,
       NEUTRAL_REAL_ADD] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M", ← q r"c:real", ← q r"k:num"] THEN
      STRIP_TAC THEN ASM_CASES_TAC
       (← q r"(f:(real^M->bool)->real^N) has_bounded_setvariation_on interval[a,b]") THEN
      ASM_REWRITE_TAC [] THENL
       [SUBGOAL_THEN
         (← q r"(f:(real^M->bool)->real^N) has_bounded_setvariation_on
      interval[a,b] INTER {x | x$k <= c} /\
      (f:(real^M->bool)->real^N) has_bounded_setvariation_on
      interval[a,b] INTER {x | x$k >= c}")
        ASSUME_TAC THENL
         [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_SETVARIATION_ON_SUBSET)) THEN
          REWRITE_TAC [INTER_SUBSET],
          ALL_TAC] THEN
        ASM_REWRITE_TAC [lifted] THEN AP_TERM_TAC THEN
        REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
         [MATCH_MP_TAC SET_VARIATION_UBOUND_ON_INTERVAL THEN ASM_REWRITE_TAC [] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC l1 THEN
          MAP_EVERY EXISTS_TAC [← q r"k:num", ← q r"a:real^M", ← q r"b:real^M"] THEN
          ASM_SIMP_TAC [NORM_0] THEN CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            MATCH_MP_TAC (← NORM_ARITH
              (← q r"x:real^N = y + z ==> norm(x) <= norm y + norm z")) THEN
            ASM_SIMP_TAC [],
            FIRST_X_ASSUM (fun th => MP_TAC th THEN MATCH_MP_TAC MONO_AND) THEN
            ASM_SIMP_TAC [INTERVAL_SPLIT, SET_VARIATION_WORKS_ON_INTERVAL]],
          ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x + y <= z <=> x <= z - y")] THEN
          ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
          MATCH_MP_TAC SET_VARIATION_UBOUND_ON_INTERVAL THEN
          ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT] THEN
          X_GEN_TAC (← q r"d1:(real^M->bool)->bool") THEN STRIP_TAC THEN
          ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x <= y - z <=> z <= y - x")] THEN
          ASM_SIMP_TAC [INTERVAL_SPLIT] THEN
          MATCH_MP_TAC SET_VARIATION_UBOUND_ON_INTERVAL THEN
          ASM_SIMP_TAC [← GSYM INTERVAL_SPLIT] THEN
          X_GEN_TAC (← q r"d2:(real^M->bool)->bool") THEN STRIP_TAC THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x <= y - z <=> z + x <= y")] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC l2 THEN
          EXISTS_TAC (← q r"k:num") THEN
          ASM_SIMP_TAC [NORM_0, SET_VARIATION_WORKS_ON_INTERVAL]],
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [lifted]) THEN
        FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) =>
          HolCore.Basics.is_neg (concl t))) THEN
        MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
        REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_INTERVAL] THEN
        EXISTS_TAC (← q r"set_variation (interval[a,b] INTER {x | x$k <= c})
                              (f:(real^M->bool)->real^N) +
                set_variation (interval[a,b] INTER {x | x$k >= c}) f") THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC l1 THEN
          MAP_EVERY EXISTS_TAC [← q r"k:num", ← q r"a:real^M", ← q r"b:real^M"] THEN
          ASM_SIMP_TAC [NORM_0] THEN REPEAT CONJ_TAC THENL
           [REPEAT GEN_TAC THEN
            MATCH_MP_TAC (← NORM_ARITH
              (← q r"x:real^N = y + z ==> norm(x) <= norm y + norm z")) THEN
            ASM_SIMP_TAC [],
            UNDISCH_TAC
             (← q r"(f:(real^M->bool)->real^N) has_bounded_setvariation_on
          (interval[a,b] INTER {x | x$k <= c})") THEN
            ASM_SIMP_TAC [INTERVAL_SPLIT, SET_VARIATION_WORKS_ON_INTERVAL],
            UNDISCH_TAC
             (← q r"(f:(real^M->bool)->real^N) has_bounded_setvariation_on
          (interval[a,b] INTER {x | x$k >= c})") THEN
            ASM_SIMP_TAC [INTERVAL_SPLIT, SET_VARIATION_WORKS_ON_INTERVAL]]]))

  let OPERATIVE_HAS_BOUNDED_SETVARIATION_ON ← prove
   r"!f:(real^M->bool)->real^N.
        operative (+) f ==> operative (/\) ((has_bounded_setvariation_on) f)"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP OPERATIVE_LIFTED_SETVARIATION) THEN
    SIMP_TAC [operative, NEUTRAL_LIFTED, NEUTRAL_AND, MONOIDAL_REAL_ADD,
              NEUTRAL_REAL_ADD] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    REPEAT (COND_CASES_TAC THEN
           ASM_REWRITE_TAC [← distinctness "option", lifted])))

  let HAS_BOUNDED_SETVARIATION_ON_DIVISION ← prove
   r"!f:(real^M->bool)->real^N a b d.
        operative (+) f /\ d division_of interval[a,b]
        ==> ((!k. k IN d ==> f has_bounded_setvariation_on k) <=>
             f has_bounded_setvariation_on interval[a,b])"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC OPERATIVE_DIVISION_AND THEN
    ASM_REWRITE_TAC [operative, NEUTRAL_AND] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [operative, NEUTRAL_VECTOR_ADD]) THEN
      ASM_SIMP_TAC [HAS_BOUNDED_SETVARIATION_ON_NULL, BOUNDED_INTERVAL],
      FIRST_ASSUM (MP_TAC o MATCH_MP OPERATIVE_LIFTED_SETVARIATION) THEN
      REWRITE_TAC [operative] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      REPEAT (COND_CASES_TAC THEN
             ASM_REWRITE_TAC [lifted, ← distinctness "option"])])

  let SET_VARIATION_ON_DIVISION ← (do
    let lemma0 ← prove
     r"!op x y. lifted op (SOME x) y = SOME z <=> ?w. y = SOME w /\ op x w = z"
     (GEN_TAC THEN GEN_TAC THEN MATCH_MP_TAC option_INDUCT THEN
      REWRITE_TAC [lifted, ← distinctness "option", ← injectivity "option"] THEN
      MESON_TAC [])
    let lemma ← prove
     r"!P op f s z.
          monoidal op /\ FINITE s /\
          iterate(lifted op) s (\i. if P i then SOME(f i) else NONE) = SOME z
          ==> iterate op s f = z"
     (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
      ASM_SIMP_TAC [ITERATE_CLAUSES, MONOIDAL_LIFTED, NEUTRAL_LIFTED] THEN
      REWRITE_TAC [← injectivity "option"] THEN REPEAT GEN_TAC THEN
      STRIP_TAC THEN GEN_TAC THEN COND_CASES_TAC THEN
      REWRITE_TAC [lifted, ← distinctness "option"] THEN ASM_MESON_TAC [lemma0])
    prove
     r"!f:(real^M->bool)->real^N a b d.
        operative (+) f /\ d division_of interval[a,b] /\
        f has_bounded_setvariation_on interval[a,b]
        ==> sum d (\k. set_variation k f) = set_variation (interval[a,b]) f"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPERATIVE_LIFTED_SETVARIATION) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"d:(real^M->bool)->bool", ← q r"a:real^M",
                                  ← q r"b:real^M"] o
        MATCH_MP (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> b ==> a /\ c ==> d")]
            OPERATIVE_DIVISION)) THEN
      ASM_SIMP_TAC [MONOIDAL_LIFTED, MONOIDAL_REAL_ADD] THEN
      MP_TAC (← ISPECL
       [← q r"\k. (f:(real^M->bool)->real^N) has_bounded_setvariation_on k",
        ← q r"(+):real->real->real",
        ← q r"\k. set_variation k (f:(real^M->bool)->real^N)",
        ← q r"d:(real^M->bool)->bool",
        ← q r"set_variation (interval[a,b]) (f:(real^M->bool)->real^N)"]
       lemma) THEN
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      ASM_REWRITE_TAC [sum, MONOIDAL_REAL_ADD]))

  let SET_VARIATION_MONOTONE ← prove
   r"!f:(real^M->bool)->real^N s t.
        f has_bounded_setvariation_on s /\ t SUBSET s
        ==> set_variation t f <= set_variation s f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [set_variation] THEN
    MATCH_MP_TAC REAL_SUP_LE_SUBSET THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
      MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"{}:(real^M->bool)->bool"] THEN
      REWRITE_TAC [SUM_CLAUSES] THEN EXISTS_TAC (← q r"{}:real^M->bool") THEN
      REWRITE_TAC [EMPTY_SUBSET, DIVISION_OF_TRIVIAL],
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!d. P d ==> Q d) ==> {f d | P d} SUBSET {f d | Q d}")) THEN
      ASM_MESON_TAC [SUBSET_TRANS],
      REWRITE_TAC [FORALL_IN_GSPEC, LEFT_IMP_EXISTS_THM] THEN
      ASM_REWRITE_TAC [← GSYM has_bounded_setvariation_on]])

  let (HAS_BOUNDED_SETVARIATION_REFLECT2_EQ, SET_VARIATION_REFLECT2) ←
   CONJ_PAIR (← prove
   r"(!f:(real^M->bool)->real^N s.
        (\k. f(IMAGE (--) k)) has_bounded_setvariation_on (IMAGE (--) s) <=>
        f has_bounded_setvariation_on s) /\
   (!f:(real^M->bool)->real^N s.
        set_variation (IMAGE (--) s) (\k. f(IMAGE (--) k)) =
        set_variation s f)"
   (MATCH_MP_TAC SETVARIATION_EQUAL_LEMMA THEN
    EXISTS_TAC (← q r"IMAGE ((--):real^M->real^M)") THEN
    SIMP_TAC [IMAGE_SUBSET, ← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [VECTOR_NEG_NEG, IMAGE_ID, REFLECT_INTERVAL] THEN
    SIMP_TAC [ETA_AX, DIVISION_OF_REFLECT] THEN
    SIMP_TAC [EQ_INTERVAL, ← TAUT (← q r"~q /\ (p /\ q \/ r) <=> ~q /\ r")] THEN
    REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ q /\ p")] THEN
    REWRITE_TAC [UNWIND_THM1, CONTRAPOS_THM] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY, VECTOR_NEG_COMPONENT, REAL_LT_NEG2]))

  let (HAS_BOUNDED_SETVARIATION_TRANSLATION2_EQ, SET_VARIATION_TRANSLATION2) ←
   CONJ_PAIR (← prove
   r"(!a f:(real^M->bool)->real^N s.
          (\k. f(IMAGE (\x. a + x) k))
          has_bounded_setvariation_on (IMAGE (\x. --a + x) s) <=>
          f has_bounded_setvariation_on s) /\
   (!a f:(real^M->bool)->real^N s.
          set_variation (IMAGE (\x. --a + x) s) (\k. f(IMAGE (\x. a + x) k)) =
          set_variation s f)"
   (GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"a:real^M") THEN
    MATCH_MP_TAC SETVARIATION_EQUAL_LEMMA THEN
    EXISTS_TAC (← q r"\s. IMAGE (\x:real^M. a + x) s") THEN
    SIMP_TAC [IMAGE_SUBSET, ← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + --a + x:real^N = x"), IMAGE_ID,
                 ← VECTOR_ARITH (← q r"--a + a + x:real^N = x")] THEN
    REWRITE_TAC [← GSYM INTERVAL_TRANSLATION] THEN
    SIMP_TAC [EQ_INTERVAL, ← TAUT (← q r"~q /\ (p /\ q \/ r) <=> ~q /\ r")] THEN
    REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ q /\ p")] THEN
    REWRITE_TAC [UNWIND_THM1, CONTRAPOS_THM] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY, VECTOR_ADD_COMPONENT, REAL_LT_LADD] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [ETA_AX] THEN
    ASM_SIMP_TAC [DIVISION_OF_TRANSLATION]))

  let HAS_BOUNDED_SETVARIATION_TRANSLATION ← prove
   r"!f:(real^M->bool)->real^N s a.
        f has_bounded_setvariation_on s
        ==> (\k. f(IMAGE (\x. a + x) k))
            has_bounded_setvariation_on (IMAGE (\x. --a + x) s)"
   (REWRITE_TAC [HAS_BOUNDED_SETVARIATION_TRANSLATION2_EQ])

  pure { OPERATIVE_LIFTED_SETVARIATION, OPERATIVE_HAS_BOUNDED_SETVARIATION_ON,
         HAS_BOUNDED_SETVARIATION_ON_DIVISION, SET_VARIATION_ON_DIVISION,
         SET_VARIATION_MONOTONE, HAS_BOUNDED_SETVARIATION_REFLECT2_EQ,
         SET_VARIATION_REFLECT2, HAS_BOUNDED_SETVARIATION_TRANSLATION2_EQ,
         SET_VARIATION_TRANSLATION2, HAS_BOUNDED_SETVARIATION_TRANSLATION }

/- ------------------------------------------------------------------------- -/
/- Absolute integrability (the same as Lebesgue integrability): basics.     -/
/- (integration.ml 9662-9915)                                                -/
/- ------------------------------------------------------------------------- -/

structure INZ where
  absolutely_integrable_on : thm
  ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE : thm
  ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE : thm
  ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV : thm
  ABSOLUTELY_INTEGRABLE_RESTRICT_INTER : thm
  HAS_ABSOLUTE_INTEGRAL : thm
  ABSOLUTELY_INTEGRABLE_LE : thm
  ABSOLUTELY_INTEGRABLE_ON_NULL : thm
  ABSOLUTELY_INTEGRABLE_ON_EMPTY : thm
  ABSOLUTELY_INTEGRABLE_0 : thm
  ABSOLUTELY_INTEGRABLE_CMUL : thm
  ABSOLUTELY_INTEGRABLE_CMUL_EQ : thm
  ABSOLUTELY_INTEGRABLE_NEG : thm
  ABSOLUTELY_INTEGRABLE_NEG_EQ : thm
  ABSOLUTELY_INTEGRABLE_NORM : thm
  ABSOLUTELY_INTEGRABLE_ABS_1 : thm
  ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL : thm
  ABSOLUTELY_INTEGRABLE_COMBINE : thm
  ABSOLUTELY_INTEGRABLE_ON_NEGLIGIBLE : thm
  ABSOLUTELY_INTEGRABLE_SPIKE : thm
  ABSOLUTELY_INTEGRABLE_SPIKE_EQ : thm
  ABSOLUTELY_INTEGRABLE_SPIKE_SET_EQ : thm
  ABSOLUTELY_INTEGRABLE_SPIKE_SET : thm
  ABSOLUTELY_INTEGRABLE_EQ : thm
  ABSOLUTELY_INTEGRABLE_TWIZZLE_EQ : thm
  ABSOLUTELY_INTEGRABLE_AFFINITY : thm
  ABSOLUTELY_INTEGRABLE_TRANSLATION : thm
  ABSOLUTELY_INTEGRABLE_REFLECT_GEN : thm
  ABSOLUTELY_INTEGRABLE_REFLECT : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION : thm
  lemma : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINZ [HolBase] (D : IntegrationDeps) (BINB : INB) (BINE : INE) (BINK : INK) (BINL : INL) (BINN : INN) (BINO : INO) (BINP : INP) (BINQ : INQ) (BINS : INS) (BINV : INV) (BINW : INW) : ExceptT String IO INZ := do
  let { NORM_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  -- @@SCOPE BEGIN
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_SUBSET, DIVISION_OF_UNION_SELF,
        FORALL_IN_DIVISION, .. } := BINB
  let { HAS_INTEGRAL_INTEGRABLE_INTEGRAL, INTEGRABLE_0, INTEGRABLE_CMUL, INTEGRABLE_CMUL_EQ,
        INTEGRABLE_EQ, INTEGRABLE_NEG, INTEGRABLE_NEG_EQ, INTEGRABLE_ON_EMPTY,
        INTEGRABLE_ON_NULL, .. } := BINE
  let { INTEGRABLE_ON_NEGLIGIBLE, INTEGRABLE_SPIKE, .. } := BINK
  let { INTEGRABLE_COMBINE, .. } := BINL
  let { INTEGRABLE_RESTRICT_INTER, INTEGRABLE_RESTRICT_UNIV, .. } := BINN
  let { INTEGRABLE_AFFINITY, INTEGRABLE_TRANSLATION, INTEGRABLE_TWIZZLE_EQ, .. } := BINO
  let { INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { INTEGRABLE_ON_SUBINTERVAL, INTEGRABLE_REFLECT_GEN, .. } := BINQ
  let { INTEGRABLE_ON_SUBDIVISION, INTEGRAL_COMBINE_DIVISION_TOPDOWN, .. } := BINS
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := BINV
  let { has_bounded_setvariation_on, .. } := BINW
  let { COND_RAND, .. } := D.dv.dg.pt.cvx.core1
  let { MONO_AND, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_REFL, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_THM, SUM_LE, SUM_SUB, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_VSUM, LIFT_CMUL, LIFT_DROP, LIFT_NUM, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_NEG, NORM_POS_LE, REAL_ABS_NORM, .. } :=
        D.dv.dg.pt.cvx.vec3
  let { VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { ASM_MESON_TAC, MESON_TAC, new_definition, parse_as_infix, REAL_ARITH, SET_TAC, .. }
        := D.dv.dg.pt.cvx
  let { REAL_ABS_ZERO, SUM_ABS, .. } := D.qsession
  let { REFLECT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  parse_as_infix ("absolutely_integrable_on", (12, "right"))

  let absolutely_integrable_on ← new_definition
   r"f absolutely_integrable_on s <=>
        f integrable_on s /\ (\x. lift(norm(f x))) integrable_on s"

  let ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE ← prove
   r"!f s. f absolutely_integrable_on s ==> f integrable_on s"
   (SIMP_TAC [absolutely_integrable_on])

  let ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE ← prove
   r"!f:real^M->real^N s.
     f absolutely_integrable_on s ==> (\x. lift (norm (f x))) integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on] THEN MESON_TAC [])

  let ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV ← prove
   r"!f s. (\x. if x IN s then f x else vec 0)
              absolutely_integrable_on (:real^M) <=>
         f absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_RESTRICT_UNIV,
                 COND_RAND, NORM_0, LIFT_NUM])

  let ABSOLUTELY_INTEGRABLE_RESTRICT_INTER ← prove
   r"!f:real^M->real^N s t.
        (\x. if x IN s then f x else vec 0) absolutely_integrable_on t <=>
        f absolutely_integrable_on (s INTER t)"
   (REWRITE_TAC [absolutely_integrable_on, ← GSYM INTEGRABLE_RESTRICT_INTER] THEN
    REWRITE_TAC [COND_RAND, NORM_0, LIFT_NUM])

  let HAS_ABSOLUTE_INTEGRAL ← prove
   r"!(f:real^M->real^N) s y.
        f absolutely_integrable_on s /\ integral s f = y <=>
        f absolutely_integrable_on s /\ (f has_integral y) s"
   (MESON_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
               HAS_INTEGRAL_INTEGRABLE_INTEGRAL])

  let ABSOLUTELY_INTEGRABLE_LE ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s
        ==> norm(integral s f) <= drop(integral s (\x. lift(norm(f x))))"
   (REWRITE_TAC [absolutely_integrable_on] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
    ASM_REWRITE_TAC [LIFT_DROP, REAL_LE_REFL])

  let ABSOLUTELY_INTEGRABLE_ON_NULL ← prove
   r"!f a b. content(interval[a,b]) = &0
           ==> f absolutely_integrable_on interval[a,b]"
   (SIMP_TAC [absolutely_integrable_on, INTEGRABLE_ON_NULL])

  let ABSOLUTELY_INTEGRABLE_ON_EMPTY ← prove
   r"!f:real^M->real^N. f absolutely_integrable_on {}"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_ON_EMPTY])

  let ABSOLUTELY_INTEGRABLE_0 ← prove
   r"!s. (\x. vec 0) absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on, NORM_0, LIFT_NUM, INTEGRABLE_0])

  let ABSOLUTELY_INTEGRABLE_CMUL ← prove
   r"!f s c. f absolutely_integrable_on s
           ==> (\x. c % f(x)) absolutely_integrable_on s"
   (SIMP_TAC [absolutely_integrable_on, INTEGRABLE_CMUL, NORM_MUL, LIFT_CMUL])

  let ABSOLUTELY_INTEGRABLE_CMUL_EQ ← prove
   r"!f:real^M->real^N s c.
      (\x. c % f x) absolutely_integrable_on s <=>
      c = &0 \/ f absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_CMUL_EQ,
                 NORM_MUL, LIFT_CMUL, REAL_ABS_ZERO] THEN
    CONV_TAC (fun t => TAUT t))

  let ABSOLUTELY_INTEGRABLE_NEG ← prove
   r"!f s. f absolutely_integrable_on s
         ==> (\x. --f(x)) absolutely_integrable_on s"
   (SIMP_TAC [absolutely_integrable_on, INTEGRABLE_NEG, NORM_NEG])

  let ABSOLUTELY_INTEGRABLE_NEG_EQ ← prove
   r"!f:real^M->real^N s.
        (\x. --f x) absolutely_integrable_on s <=>
        f absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on, NORM_NEG, INTEGRABLE_NEG_EQ])

  let ABSOLUTELY_INTEGRABLE_NORM ← prove
   r"!f s. f absolutely_integrable_on s
         ==> (\x. lift(norm(f x))) absolutely_integrable_on s"
   (SIMP_TAC [absolutely_integrable_on, NORM_LIFT, REAL_ABS_NORM])

  let ABSOLUTELY_INTEGRABLE_ABS_1 ← prove
   r"!f s. f absolutely_integrable_on s
         ==> (\x. lift(abs(drop(f x)))) absolutely_integrable_on s"
   (REWRITE_TAC [← GSYM NORM_LIFT, LIFT_DROP, ABSOLUTELY_INTEGRABLE_NORM])

  let ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL ← prove
   r"!f:real^M->real^N s a b.
        f absolutely_integrable_on s /\ interval[a,b] SUBSET s
        ==> f absolutely_integrable_on interval[a,b]"
   (REWRITE_TAC [absolutely_integrable_on] THEN
    MESON_TAC [INTEGRABLE_ON_SUBINTERVAL])

  let ABSOLUTELY_INTEGRABLE_COMBINE ← prove
   r"!f a b c.
        drop a <= drop c /\ drop c <= drop b /\
        f absolutely_integrable_on interval[a,c] /\
        f absolutely_integrable_on interval[c,b]
        ==> f absolutely_integrable_on interval[a,b]"
   (REWRITE_TAC [absolutely_integrable_on] THEN
    MESON_TAC [INTEGRABLE_COMBINE])

  let ABSOLUTELY_INTEGRABLE_ON_NEGLIGIBLE ← prove
   r"!f:real^M->real^N s. negligible s ==> f absolutely_integrable_on s"
   (SIMP_TAC [INTEGRABLE_ON_NEGLIGIBLE, absolutely_integrable_on])

  let ABSOLUTELY_INTEGRABLE_SPIKE ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN t DIFF s ==> g x = f x)
        ==> f absolutely_integrable_on t ==> g absolutely_integrable_on t"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [absolutely_integrable_on] THEN MATCH_MP_TAC MONO_AND THEN
    CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_SPIKE THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_SIMP_TAC [])

  let ABSOLUTELY_INTEGRABLE_SPIKE_EQ ← prove
   r"!f:real^M->real^N g s t.
        negligible s /\ (!x. x IN t DIFF s ==> g x = f x)
        ==> (f absolutely_integrable_on t <=> g absolutely_integrable_on t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SPIKE THEN ASM_MESON_TAC [])

  let ABSOLUTELY_INTEGRABLE_SPIKE_SET_EQ ← prove
   r"!f:real^M->real^N s t.
        negligible(s DIFF t UNION t DIFF s)
        ==> (f absolutely_integrable_on s <=> f absolutely_integrable_on t)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SPIKE_EQ THEN
    EXISTS_TAC (← q r"s DIFF t UNION t DIFF s:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let ABSOLUTELY_INTEGRABLE_SPIKE_SET ← prove
   r"!f:real^M->real^N s t.
        negligible(s DIFF t UNION t DIFF s)
        ==> f absolutely_integrable_on s ==> f absolutely_integrable_on t"
   (MESON_TAC [ABSOLUTELY_INTEGRABLE_SPIKE_SET_EQ])

  let ABSOLUTELY_INTEGRABLE_EQ ← prove
   r"!f:real^M->real^N g s.
        (!x. x IN s ==> f x = g x) /\ f absolutely_integrable_on s
        ==> g absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRABLE_EQ THENL
     [EXISTS_TAC (← q r"f:real^M->real^N"),
      EXISTS_TAC (← q r"\x. lift(norm((f:real^M->real^N) x))")] THEN
    ASM_SIMP_TAC [])

  let ABSOLUTELY_INTEGRABLE_TWIZZLE_EQ ← prove
   r"!f:real^N->real^P s:real^M->bool p.
        dimindex(:M) = dimindex(:N) /\ p permutes 1..dimindex(:N)
        ==> (f absolutely_integrable_on IMAGE (\x. lambda i. x$p i) s <=>
             (\x. f(lambda i. x$p i)) absolutely_integrable_on s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [absolutely_integrable_on] THEN
    BINOP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      INTEGRABLE_TWIZZLE_EQ o lhand o snd) THEN
    FIRST_X_ASSUM SUBST1_TAC THEN ASM_REWRITE_TAC [])

  let ABSOLUTELY_INTEGRABLE_AFFINITY ← prove
   r"!f:real^M->real^N s m c.
        f absolutely_integrable_on s /\ ~(m = &0)
        ==> (\x. f(m % x + c)) absolutely_integrable_on
            (IMAGE (\x. inv m % x + --(inv(m) % c)) s)"
   (REWRITE_TAC [absolutely_integrable_on] THEN
    SIMP_TAC [INTEGRABLE_AFFINITY])

  let ABSOLUTELY_INTEGRABLE_TRANSLATION ← prove
   r"!f:real^M->real^N s a.
        (\x. f(a + x)) absolutely_integrable_on s <=>
        f absolutely_integrable_on (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [absolutely_integrable_on, ← GSYM INTEGRABLE_TRANSLATION])

  let ABSOLUTELY_INTEGRABLE_REFLECT_GEN ← prove
   r"!f:real^M->real^N s.
        (\x. f(--x)) absolutely_integrable_on s <=>
        f absolutely_integrable_on (IMAGE (--) s)"
   (REWRITE_TAC [absolutely_integrable_on, ← GSYM INTEGRABLE_REFLECT_GEN])

  let ABSOLUTELY_INTEGRABLE_REFLECT ← prove
   r"!f:real^M->real^N a b.
     (\x. f(--x)) absolutely_integrable_on (interval[--b,--a]) <=>
     f absolutely_integrable_on (interval[a,b])"
   (REWRITE_TAC [ABSOLUTELY_INTEGRABLE_REFLECT_GEN] THEN
    REWRITE_TAC [REFLECT_INTERVAL, VECTOR_NEG_NEG])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s
        ==> (\k. integral k f) has_bounded_setvariation_on s"
   (REWRITE_TAC [has_bounded_setvariation_on] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC
     (← q r"drop(integral (s:real^M->bool) (\x. lift(norm(f x:real^N))))") THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN
    X_GEN_TAC (← q r"t:real^M->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(UNIONS d:real^M->bool) SUBSET s") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET_TRANS, division_of], ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC
     (← q r"drop(integral (UNIONS d) (\x. lift(norm((f:real^M->real^N) x))))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
      ASM_REWRITE_TAC [LIFT_DROP, NORM_POS_LE] THEN CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
        EXISTS_TAC (← q r"s:real^M->bool") THEN
        EXISTS_TAC (← q r"d:(real^M->bool)->bool") THEN CONJ_TAC THENL
         [ASM_MESON_TAC [DIVISION_OF_SUBSET, division_of], ALL_TAC] THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC
     (← q r"drop(vsum d (\i. integral i (\x:real^M. lift(norm(f x:real^N)))))") THEN
    CONJ_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      ASM_SIMP_TAC [DROP_VSUM] THEN MATCH_MP_TAC SUM_LE THEN
      ASM_REWRITE_TAC [o_THM] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_LE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_MESON_TAC [division_of, SUBSET_TRANS],
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_COMBINE_DIVISION_TOPDOWN THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [DIVISION_OF_UNION_SELF]] THEN
      MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
      MAP_EVERY EXISTS_TAC [← q r"s:real^M->bool", ← q r"d:(real^M->bool)->bool"] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_UNION_SELF], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN ASM_REWRITE_TAC []])

  let lemma ← prove
   r"!f:A->real^N g s e.
        sum s (\x. norm(f x - g x)) < e
        ==> FINITE s
            ==> abs(sum s (\x. norm(f x)) - sum s (\x. norm(g x))) < e"
   (REPEAT GEN_TAC THEN SIMP_TAC [← GSYM SUM_SUB] THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> y < e ==> x < e")) THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SUM_ABS o lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"y <= z ==> x <= y ==> x <= z")) THEN
    MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN NORM_ARITH_TAC)

  pure { absolutely_integrable_on, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
         ABSOLUTELY_INTEGRABLE_IMP_LIFT_NORM_INTEGRABLE,
         ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, ABSOLUTELY_INTEGRABLE_RESTRICT_INTER,
         HAS_ABSOLUTE_INTEGRAL, ABSOLUTELY_INTEGRABLE_LE, ABSOLUTELY_INTEGRABLE_ON_NULL,
         ABSOLUTELY_INTEGRABLE_ON_EMPTY, ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_CMUL,
         ABSOLUTELY_INTEGRABLE_CMUL_EQ, ABSOLUTELY_INTEGRABLE_NEG,
         ABSOLUTELY_INTEGRABLE_NEG_EQ, ABSOLUTELY_INTEGRABLE_NORM,
         ABSOLUTELY_INTEGRABLE_ABS_1, ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL,
         ABSOLUTELY_INTEGRABLE_COMBINE, ABSOLUTELY_INTEGRABLE_ON_NEGLIGIBLE,
         ABSOLUTELY_INTEGRABLE_SPIKE, ABSOLUTELY_INTEGRABLE_SPIKE_EQ,
         ABSOLUTELY_INTEGRABLE_SPIKE_SET_EQ, ABSOLUTELY_INTEGRABLE_SPIKE_SET,
         ABSOLUTELY_INTEGRABLE_EQ, ABSOLUTELY_INTEGRABLE_TWIZZLE_EQ,
         ABSOLUTELY_INTEGRABLE_AFFINITY, ABSOLUTELY_INTEGRABLE_TRANSLATION,
         ABSOLUTELY_INTEGRABLE_REFLECT_GEN, ABSOLUTELY_INTEGRABLE_REFLECT,
         ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION, lemma }

/- ------------------------------------------------------------------------- -/
/- Bounded set variation of the integral implies absolute integrability on  -/
/- an interval.  (integration.ml 9917-10420)                                 -/
/- ------------------------------------------------------------------------- -/

structure INAA where
  BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAA [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINH : INH) (BINQ : INQ) (BINS : INS) (BINW : INW) (BINZ : INZ) : ExceptT String IO INAA := do
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, CONTENT_POS_LE, .. } := BINA
  let { DIVISION_INTER_1, division_of, DIVISION_OF_FINITE, ELEMENTARY_INTERVAL,
        FORALL_IN_DIVISION, gauge, GAUGE_INTER, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, fine, FINE_INTER, has_integral, integrable_on,
        SUM_OVER_TAGGED_DIVISION_LEMMA, TAGGED_DIVISION_OF, tagged_division_of,
        TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { INTEGRAL_EMPTY, INTEGRAL_NULL, .. } := BINE
  let { ADDITIVE_CONTENT_DIVISION, .. } := BINH
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { HENSTOCK_LEMMA, INTEGRAL_COMBINE_DIVISION_TOPDOWN, .. } := BINS
  let { HAS_BOUNDED_SETVARIATION_ON_INTERVAL, .. } := BINW
  let { absolutely_integrable_on, lemma, .. } := BINZ
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, EQ_TRANS, ETA_AX, EXISTS_PAIR_THM,
        EXTENSION, FINITE_IMAGE, FINITE_RESTRICT, FINITE_SUBSET, FORALL_AND_THM, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_EQ_EMPTY,
        IMP_CONJ, IN_ELIM_PAIR_THM, INTER, INTER_COMM, INTER_SUBSET, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, LEFT_AND_EXISTS_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, PAIR_EQ, REAL_ABS_NUM, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_IMP_LE, REAL_LE_REFL, REAL_LE_TRANS, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_NOT_LE, REAL_NOT_LT, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_abs, SUM_EQ, SUM_LE, SUM_RMUL, SUM_SUB, SUM_SUPERSET, SUP,
        SWAP_EXISTS_THM, UNIONS_SUBSET, UNWIND_THM1, UNWIND_THM2, .. } :=
        D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_CMUL, DROP_SUB, DROP_VSUM, LIFT_DROP, NORM_0, NORM_1, NORM_EQ_0, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, .. } := D.dv.dg.pt.cvx.vec3
  let { CENTRE_IN_BALL, CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top1
  let { IN_BALL, INTERIOR_INTER, OPEN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, UNWIND_CONV, .. } :=
        D.dv.dg.pt.cvx
  let { CLOSED_UNIONS, .. } := D.dv.dg.pt.qtop
  let { FINITE_PRODUCT, LAMBDA_PAIR, LAMBDA_PAIR_THM, REAL_ABS_ZERO, SUM_IMAGE_NONZERO,
        SUM_SUM_PRODUCT, .. } := D.qsession
  let { SEPARATE_POINT_CLOSED, .. } := D.qtopology
  let { INTER_INTERVAL, VSUM_NORM_LE, .. } := D.qvec
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))
  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))
  let isNegC : thm → Bool := fun t => HolCore.Basics.is_neg (concl t)

  let BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL ← prove
   r"!f:real^M->real^N a b.
        f integrable_on interval[a,b] /\
        (\k. integral k f) has_bounded_setvariation_on interval[a,b]
        ==> f absolutely_integrable_on interval[a,b]"
   (REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_INTERVAL] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [absolutely_integrable_on] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\d. sum d (\k. norm(integral k (f:real^M->real^N))))
                      {d | d division_of interval[a,b] }")
           SUP) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    ABBREV_TAC
     (← q r"i = sup (IMAGE (\d. sum d (\k. norm(integral k (f:real^M->real^N))))
                      {d | d division_of interval[a,b] })") THEN
    ANTS_TAC THENL
     [REWRITE_TAC [ELEMENTARY_INTERVAL] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [integrable_on] THEN EXISTS_TAC (← q r"lift i") THEN
