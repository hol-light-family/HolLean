      SUBGOAL_THEN (← q r"?u v:real^M. k = interval[u,v]")
       (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
      THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"interval[u:real^M,v] SUBSET interval[a,b]") ASSUME_TAC THENL
       [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      ABBREV_TAC (← q r"d' =
        {interval[u,v] INTER l |l|
                l IN IMAGE SND (p:(real^M#(real^M->bool))->bool) /\
                ~(interval[u,v] INTER l = {})}") THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"sum d' (\k. norm (integral k (f:real^M->real^N)))") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC SUM_SUPERSET THEN
        EXPAND_TAC "d'" THEN REWRITE_TAC [SUBSET, ← SET_RULE
         (← q r"a IN {f x |x| x IN s /\ ~(f x = b)} <=>
          a IN {f x | x IN s} /\ ~(a = b)")] THEN
        SIMP_TAC [IMP_CONJ, INTEGRAL_EMPTY, NORM_0]] THEN
      SUBGOAL_THEN (← q r"d' division_of interval[u:real^M,v]") ASSUME_TAC THENL
       [EXPAND_TAC "d'" THEN MATCH_MP_TAC DIVISION_INTER_1 THEN
        EXISTS_TAC (← q r"interval[a:real^M,b]") THEN
        ASM_SIMP_TAC [DIVISION_OF_TAGGED_DIVISION],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"norm(vsum d' (\i. integral i (f:real^M->real^N)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
        MATCH_MP_TAC INTEGRAL_COMBINE_DIVISION_TOPDOWN THEN
        ASM_MESON_TAC [INTEGRABLE_ON_SUBINTERVAL],
        ALL_TAC] THEN
      MATCH_MP_TAC VSUM_NORM_LE THEN
      REWRITE_TAC [REAL_LE_REFL] THEN ASM_MESON_TAC [division_of],
      ALL_TAC] THEN
    REMOVE_THEN "p'" SUBST_ALL_TAC THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"sum {x,i INTER l | (x,l) IN p /\ i IN d}
                  (\(x,k:real^M->bool).
                      abs(content k) * norm((f:real^M->real^N) x))") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_SUPERSET THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"i:real^M->bool"] THEN
      ASM_CASES_TAC (← q r"i:real^M->bool = {}") THEN
      ASM_SIMP_TAC [CONTENT_EMPTY, REAL_ABS_NUM, REAL_MUL_LZERO] THEN
      MATCH_MP_TAC (← TAUT (← q r"(a <=> b) ==> a /\ ~b ==> c")) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
      REWRITE_TAC [PAIR_EQ] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"{x,i INTER l | x,l IN (p:(real^M#(real^M->bool))->bool) /\ i IN d} =
    IMAGE (\((x,l),k). x,k INTER l) {m,k | m IN p /\ k IN d}")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC I [EXTENSION] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_IMAGE, EXISTS_PAIR_THM, FORALL_PAIR_THM] THEN
      REWRITE_TAC [PAIR_EQ] THEN
      CONV_TAC (REDEPTH_CONV UNWIND_CONV) THEN MESON_TAC [],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SUM_IMAGE_NONZERO o lhand o snd) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [FINITE_PRODUCT] THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"x1:real^M", ← q r"l1:real^M->bool", ← q r"k1:real^M->bool",
        ← q r"x2:real^M", ← q r"l2:real^M->bool", ← q r"k2:real^M->bool"] THEN
      REWRITE_TAC [PAIR_EQ] THEN
      ASM_CASES_TAC (← q r"x1:real^M = x2") THEN ASM_REWRITE_TAC [] THEN
      STRIP_TAC THEN
      REWRITE_TAC [REAL_ENTIRE] THEN DISJ1_TAC THEN
      REWRITE_TAC [REAL_ABS_ZERO] THEN
      SUBGOAL_THEN (← q r"interior(k2 INTER l2:real^M->bool) = {}") MP_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k2:real^M->bool") o elc 1) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MP_TAC (← ASSUME (← q r"p tagged_division_of interval[a:real^M,b]")) THEN
        REWRITE_TAC [TAGGED_DIVISION_OF] THEN
        DISCH_THEN (MP_TAC o elc 1) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x2:real^M", ← q r"l2:real^M->bool"]) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [INTER_INTERVAL, CONTENT_EQ_0_INTERIOR]] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(interior(k1) INTER interior(k2) = {} \/
         interior(l1) INTER interior(l2) = {}) /\
        interior(k1 INTER l1) SUBSET interior(k1) /\
        interior(k2 INTER l2) SUBSET interior(k2) /\
        interior(k1 INTER l1) SUBSET interior(l1) /\
        interior(k2 INTER l2) SUBSET interior(l2) /\
        interior(k1 INTER l1) = interior(k2 INTER l2)
        ==> interior(k2 INTER l2) = {}")) THEN
      SIMP_TAC [SUBSET_INTERIOR, INTER_SUBSET] THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (MP_TAC o elc 2) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"k1:real^M->bool", ← q r"k2:real^M->bool"]) THEN
      MP_TAC (← ASSUME (← q r"p tagged_division_of interval[a:real^M,b]")) THEN
      REWRITE_TAC [TAGGED_DIVISION_OF] THEN
      DISCH_THEN (MP_TAC o elc 2) THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"x2:real^M", ← q r"l1:real^M->bool", ← q r"x2:real^M",
        ← q r"l2:real^M->bool"]) THEN
      ASM_REWRITE_TAC [PAIR_EQ] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [LAMBDA_PAIR_THM] THEN
    ASM_SIMP_TAC [← GSYM SUM_SUM_PRODUCT] THEN
    MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^M", ← q r"l:real^M->bool"] THEN
    DISCH_TAC THEN REWRITE_TAC [o_THM, SUM_RMUL] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    SUBGOAL_THEN (← q r"?u v:real^M. l = interval[u,v]")
     (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
    THENL [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. content(k INTER interval[u:real^M,v]))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [real_abs] THEN
      X_GEN_TAC (← q r"k:real^M->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?w z:real^M. k = interval[w,z]")
        (REPEAT_TCL CHOOSE_THEN SUBST_ALL_TAC)
      THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      REWRITE_TAC [INTER_INTERVAL, CONTENT_POS_LE],
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"sum {k INTER interval[u:real^M,v] | k IN d} content") THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC SUM_IMAGE_NONZERO THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"k1:real^M->bool", ← q r"k2:real^M->bool"] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"interior(k2 INTER interval[u:real^M,v]) = {}") MP_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k2:real^M->bool") o elc 1) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [INTER_INTERVAL, CONTENT_EQ_0_INTERIOR]] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"interior(k2 INTER i) SUBSET interior(k1 INTER k2) /\
        interior(k1 INTER k2) = {}
        ==> interior(k2 INTER i) = {}")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_INTERIOR THEN ASM SET_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (MP_TAC o elc 2) THEN
      REWRITE_TAC [INTERIOR_INTER] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"interval[u:real^M,v] SUBSET interval[a,b]") ASSUME_TAC THENL
     [ASM_MESON_TAC [TAGGED_DIVISION_OF], ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"sum {k INTER interval[u:real^M,v] |k|
                      k IN d /\ ~(k INTER interval[u,v] = {})} content") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_SUPERSET THEN
      REWRITE_TAC [SUBSET, ← SET_RULE
       (← q r"a IN {f x |x| x IN s /\ ~(f x = b)} <=>
        a IN {f x | x IN s} /\ ~(a = b)")] THEN
      SIMP_TAC [IMP_CONJ, CONTENT_EMPTY],
      ALL_TAC] THEN
    MATCH_MP_TAC ADDITIVE_CONTENT_DIVISION THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN MATCH_MP_TAC DIVISION_INTER_1 THEN
    EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_REWRITE_TAC [])

  pure { BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Bounded set variation and absolute integrability over the whole space;   -/
/- set variation of the integral.  (integration.ml 10421-10682)              -/
/- ------------------------------------------------------------------------- -/

structure INAB where
  BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_UNIV_EQ : thm
  ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ : thm
  ABSOLUTELY_INTEGRABLE_SET_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAB [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINP : INP) (BINQ : INQ) (BINS : INS) (BINV : INV) (BINW : INW) (BINZ : INZ) (BINAA : INAA) : ExceptT String IO INAB := do
  -- @@SCOPE BEGIN
  let { CONTENT_POS_LE, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_TRIVIAL, DIVISION_OF_UNION_SELF,
        ELEMENTARY_BOUNDED, FORALL_IN_DIVISION, GAUGE_INTER, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, FINE_INTER, has_integral, HAS_INTEGRAL_INTEGRAL,
        integrable_on, PARTIAL_DIVISION_OF_TAGGED_DIVISION, SUM_OVER_TAGGED_DIVISION_LEMMA,
        TAGGED_DIVISION_OF, tagged_division_of, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { INTEGRAL_NULL, .. } := BINE
  let { INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { HAS_INTEGRAL_ALT, INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { HENSTOCK_LEMMA, INTEGRABLE_ON_SUBDIVISION, INTEGRAL_COMBINE_DIVISION_BOTTOMUP,
        INTEGRAL_COMBINE_DIVISION_TOPDOWN, INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN, .. } :=
        BINS
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := BINV
  let { HAS_BOUNDED_SETVARIATION_ON_INTERVAL, HAS_BOUNDED_SETVARIATION_ON_UNIV,
        set_variation, .. } := BINW
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_LE, absolutely_integrable_on,
        ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL, lemma, .. } := BINZ
  let { BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL, .. } := BINAA
  let { EXISTS_IN_GSPEC, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_FORALL_THM,
        NOT_IMP, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_ADD, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_SUB_LT, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_abs, SUBSET_UNIV, SUM_ABS_LE, SUM_EQ, SUM_LE, SUM_SUB, SUP,
        UNIONS_0, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_CMUL, DROP_SUB, DROP_VSUM, LIFT_CMUL, LIFT_DROP, LIFT_SUB, NORM_0, NORM_1, .. }
        := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { BOUNDED_POS, .. } := D.dv.dg.pt.cvx.top1
  let { IN_BALL, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON, NORM_ARITH, REAL_ARITH, .. } := D.dv.dg.pt.cvx
  let { LIFT_SUM, .. } := D.dv.dg.qvec
  let { LAMBDA_PAIR, LAMBDA_PAIR_THM, REAL_SUP_UNIQUE, .. } := D.qsession
  -- @@SCOPE END

  let BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE ← prove
   r"!f:real^M->real^N.
        f integrable_on UNIV /\
        (\k. integral k f) has_bounded_setvariation_on (:real^M)
        ==> f absolutely_integrable_on UNIV"
   (REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_UNIV] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [absolutely_integrable_on] THEN
    MP_TAC (← ISPEC (← q r"IMAGE (\d. sum d (\k. norm(integral k (f:real^M->real^N))))
                      {d | d division_of (UNIONS d) }")
           SUP) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    ABBREV_TAC
     (← q r"i = sup (IMAGE (\d. sum d (\k. norm(integral k (f:real^M->real^N))))
                      {d | d division_of (UNIONS d) })") THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      EXISTS_TAC (← q r"{}:(real^M->bool)->bool") THEN
      REWRITE_TAC [UNIONS_0, DIVISION_OF_TRIVIAL],
      ALL_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [integrable_on] THEN EXISTS_TAC (← q r"lift i") THEN
    REWRITE_TAC [HAS_INTEGRAL_ALT, IN_UNIV] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
      MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M"]
        (← REWRITE_RULE [HAS_BOUNDED_SETVARIATION_ON_INTERVAL]
         BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL)) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC [absolutely_integrable_on]] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN EXISTS_TAC (← q r"(:real^M)") THEN
        ASM_REWRITE_TAC [SUBSET_UNIV],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"B:real") THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [DIVISION_OF_UNION_SELF],
      ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i - e")) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> ~(i <= i - e)")] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"bounded(UNIONS d:real^M->bool)") MP_TAC THENL
     [ASM_MESON_TAC [ELEMENTARY_BOUNDED], ALL_TAC] THEN
    REWRITE_TAC [BOUNDED_POS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"K:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"K + &1") THEN ASM_SIMP_TAC [REAL_LT_ADD, REAL_LT_01] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
    REWRITE_TAC [NORM_1, DROP_SUB, LIFT_DROP] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"!s1. i - e < s1 /\ s1 <= s /\ s < i + e ==> abs(s - i) < e")) THEN
    EXISTS_TAC (← q r"sum (d:(real^M->bool)->bool) (\k. norm (integral k
                    (f:real^M->real^N)))") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum d
      (\k. drop(integral k (\x. lift(norm((f:real^M->real^N) x)))))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUM_LE THEN
        FIRST_ASSUM (fun t => tactic_of do
          pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION t])) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_LE THEN
        ASM_REWRITE_TAC [absolutely_integrable_on] THEN
        MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"drop(integral (UNIONS d)
                      (\x. lift(norm((f:real^M->real^N) x))))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC (← MESON [REAL_LE_REFL, LIFT_DROP]
         (← q r"lift x = y ==> x <= drop y")) THEN
        ASM_SIMP_TAC [LIFT_SUM, o_DEF, LIFT_DROP] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC INTEGRAL_COMBINE_DIVISION_BOTTOMUP THEN
        FIRST_ASSUM (fun t => tactic_of do
          pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION t])),
        ALL_TAC] THEN
      MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
      ASM_REWRITE_TAC [LIFT_DROP, NORM_POS_LE] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"ball(vec 0:real^M,K + &1)") THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET, IN_BALL] THEN
        ASM_SIMP_TAC [← NORM_ARITH (← q r"norm(x) <= K ==> dist(vec 0,x) < K + &1")],
        ALL_TAC] THEN
      DISCH_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
      EXISTS_TAC (← q r"interval[a:real^M,b]") THEN
      EXISTS_TAC (← q r"d:(real^M->bool)->bool") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRAL, has_integral] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M"]
                  HENSTOCK_LEMMA) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "+")) THEN
    SUBGOAL_THEN (← q r"?p. p tagged_division_of interval[a:real^M,b] /\
                    d1 fine p /\ d2 fine p")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM FINE_INTER] THEN MATCH_MP_TAC FINE_DIVISION_EXISTS THEN
      ASM_SIMP_TAC [GAUGE_INTER],
      ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool)->bool)")) THEN
    REMOVE_THEN "+" (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool)->bool)")) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [tagged_division_of], ALL_TAC] THEN
    REWRITE_TAC [NORM_1, DROP_SUB] THEN
    REWRITE_TAC [LAMBDA_PAIR] THEN DISCH_THEN (MP_TAC o MATCH_MP lemma) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [DROP_VSUM, o_DEF, SUM_SUB] THEN
    REWRITE_TAC [LAMBDA_PAIR_THM, DROP_CMUL, NORM_MUL, LIFT_DROP] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"sf' = sf /\ si <= i
      ==> abs(sf - si) < e / &2
          ==> abs(sf' - di) < e / &2
              ==> di < i + e")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [FORALL_PAIR_THM, real_abs] THEN
      ASM_MESON_TAC [CONTENT_POS_LE, TAGGED_DIVISION_OF],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"sum p (\(x:real^M,k). norm(integral k f)) =
    sum (IMAGE SND p) (\k. norm(integral k (f:real^M->real^N)))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC SUM_OVER_TAGGED_DIVISION_LEMMA THEN
      EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [INTEGRAL_NULL, NORM_0],
      ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    MATCH_MP_TAC PARTIAL_DIVISION_OF_TAGGED_DIVISION THEN
    EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_MESON_TAC [tagged_division_of])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_UNIV_EQ ← prove
   r"!f:real^M->real^N.
        f absolutely_integrable_on (:real^M) <=>
        f integrable_on (:real^M) /\
        (\k. integral k f) has_bounded_setvariation_on (:real^M)"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION,
              BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE,
              ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE])

  let ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ ← prove
   r"!f:real^M->real^N a b.
        f absolutely_integrable_on interval[a,b] <=>
        f integrable_on interval[a,b] /\
        (\k. integral k f) has_bounded_setvariation_on interval[a,b]"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION,
              BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE_INTERVAL,
              ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE])

  let ABSOLUTELY_INTEGRABLE_SET_VARIATION ← prove
   r"!f:real^M->real^N a b.
        f absolutely_integrable_on interval[a,b]
        ==> set_variation (interval[a,b]) (\k. integral k f) =
                 drop(integral (interval[a,b]) (\x. lift(norm(f x))))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [set_variation] THEN
    MATCH_MP_TAC REAL_SUP_UNIQUE THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^M->bool") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"drop(integral s (\x. lift(norm((f:real^M->real^N) x))))") THEN
      CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"\x. lift(norm((f:real^M->real^N) x))",
                          ← q r"d:(real^M->bool)->bool", ← q r"s:real^M->bool"]
          INTEGRAL_COMBINE_DIVISION_TOPDOWN) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
          ASM_REWRITE_TAC [] THEN
          MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
          EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_MESON_TAC [],
          DISCH_THEN SUBST1_TAC] THEN
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
        ASM_SIMP_TAC [DROP_VSUM] THEN MATCH_MP_TAC SUM_LE THEN
        ASM_REWRITE_TAC [o_THM] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
        REWRITE_TAC [LIFT_DROP, REAL_LE_REFL, ← GSYM absolutely_integrable_on] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN
        ASM_MESON_TAC [ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL, SUBSET_TRANS],
        MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
        ASM_REWRITE_TAC [LIFT_DROP, NORM_POS_LE] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
        EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_MESON_TAC []],
      X_GEN_TAC (← q r"B:real") THEN ONCE_REWRITE_TAC [← GSYM REAL_SUB_LT] THEN
      ABBREV_TAC (← q r"e = drop(integral (interval [a,b])
                                  (\x. lift(norm((f:real^M->real^N) x)))) -
                    B") THEN
      DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2") o MATCH_MP HENSTOCK_LEMMA) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "F"))) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [absolutely_integrable_on]) THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      REWRITE_TAC [HAS_INTEGRAL_INTEGRAL, has_integral] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^M->real^M->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "A"))) THEN
      MP_TAC (← ISPECL
       [← q r"\x. (d1:real^M->real^M->bool) x INTER d2 x",
        ← q r"a:real^M", ← q r"b:real^M"]
       FINE_DIVISION_EXISTS) THEN
      ASM_SIMP_TAC [GAUGE_INTER, FINE_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^M#(real^M->bool)->bool")
          STRIP_ASSUME_TAC) THEN
      REMOVE_THEN "A" (MP_TAC o SPEC  (← q r"p:real^M#(real^M->bool)->bool")) THEN
      REMOVE_THEN "F" (MP_TAC o SPEC  (← q r"p:real^M#(real^M->bool)->bool")) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [tagged_division_of], ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"\x. lift(norm((f:real^M->real^N) x))",
        ← q r"a:real^M", ← q r"b:real^M", ← q r"p:real^M#(real^M->bool)->bool"]
        INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN) THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN SUBST_ALL_TAC] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP TAGGED_DIVISION_OF_FINITE) THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"abs(sum p (\(x,k). content k * norm((f:real^M->real^N) x)) -
          sum p (\(x,k:real^M->bool). norm(integral k f))) < e / &2")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          REAL_LET_TRANS)) THEN
        ASM_SIMP_TAC [← GSYM SUM_SUB] THEN MATCH_MP_TAC SUM_ABS_LE THEN
        ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"x = norm u ==> abs(x - norm v) <= norm(u - v:real^N)")) THEN
        REWRITE_TAC [NORM_MUL, real_abs] THEN
        ASM_MESON_TAC [CONTENT_POS_LE, TAGGED_DIVISION_OF],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM NORM_LIFT] THEN
      ASM_SIMP_TAC [LIFT_SUB, LIFT_SUM] THEN
      REWRITE_TAC [LAMBDA_PAIR_THM, o_DEF, LIFT_CMUL, IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"norm(x - y:real^N) < e / &2 /\ norm(x - z) < e / &2
        ==> norm(y - z) < e"))) THEN
      REWRITE_TAC [NORM_1, DROP_SUB] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"B:real") o MATCH_MP
       (← REAL_ARITH (← q r"!B. abs(x - y) < e ==> y - B = e ==> &0 < x - B"))) THEN
      ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [DROP_VSUM, REAL_SUB_LT] THEN
      REWRITE_TAC [o_DEF, LAMBDA_PAIR_THM, LIFT_DROP] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"IMAGE SND (p:real^M#(real^M->bool)->bool)") THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"interval[a:real^M,b]") THEN
        ASM_SIMP_TAC [DIVISION_OF_TAGGED_DIVISION, SUBSET_REFL],
        FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUM_OVER_TAGGED_DIVISION_LEMMA)) THEN
        DISCH_THEN (fun th =>
         W (MP_TAC o PART_MATCH (rand o rand) th o rand o snd)) THEN
        SIMP_TAC [INTEGRAL_NULL, NORM_0] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN ASM_REWRITE_TAC []]])

  pure { BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE,
         ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_UNIV_EQ,
         ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ,
         ABSOLUTELY_INTEGRABLE_SET_VARIATION }

/- ------------------------------------------------------------------------- -/
/- Closure properties of absolute integrability: constants, sums, linear    -/
/- images, componentwise abs, max and min.  (integration.ml 10682-10980)     -/
/- ------------------------------------------------------------------------- -/

structure INAC where
  ABSOLUTELY_INTEGRABLE_CONST : thm
  ABSOLUTELY_INTEGRABLE_ADD : thm
  ABSOLUTELY_INTEGRABLE_SUB : thm
  ABSOLUTELY_INTEGRABLE_LINEAR : thm
  ABSOLUTELY_INTEGRABLE_VSUM : thm
  ABSOLUTELY_INTEGRABLE_ABS : thm
  ABSOLUTELY_INTEGRABLE_MAX : thm
  ABSOLUTELY_INTEGRABLE_MAX_1 : thm
  ABSOLUTELY_INTEGRABLE_MIN : thm
  ABSOLUTELY_INTEGRABLE_MIN_1 : thm
  ABSOLUTELY_INTEGRABLE_ABS_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAC [HolBase] (D : IntegrationDeps) (BINB : INB) (BINC : INC) (BINE : INE) (BINH : INH) (BINI : INI) (BINN : INN) (BINP : INP) (BINQ : INQ) (BINS : INS) (BINW : INW) (BINZ : INZ) (BINAB : INAB) : ExceptT String IO INAC := do
  -- @@SCOPE BEGIN
  let { DIVISION_OF_FINITE, FORALL_IN_DIVISION, .. } := BINB
  let { HAS_INTEGRAL_INTEGRAL, .. } := BINC
  let { HAS_INTEGRAL_LINEAR, INTEGRABLE_ADD, INTEGRABLE_LINEAR, INTEGRABLE_NEG,
        INTEGRAL_ADD, INTEGRAL_NEG, INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRABLE_CONST, .. } := BINH
  let { INTEGRAL_COMPONENT_LE, .. } := BINI
  let { INTEGRABLE_RESTRICT_UNIV, .. } := BINN
  let { INTEGRAL_SUBSET_COMPONENT_LE, .. } := BINP
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { INTEGRABLE_ON_SUBDIVISION, INTEGRAL_COMBINE_DIVISION_TOPDOWN, .. } := BINS
  let { HAS_BOUNDED_SETVARIATION_ON_UNIV, .. } := BINW
  let { ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION,
        ABSOLUTELY_INTEGRABLE_CMUL, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        ABSOLUTELY_INTEGRABLE_NEG, ABSOLUTELY_INTEGRABLE_NORM, absolutely_integrable_on,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, .. } := BINZ
  let { BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE, .. } := BINAB
  let { CART_EQ, COND_RAND, EQ_IMP, EQ_SYM_EQ, EQ_TRANS, ETA_AX, FINITE_INDUCT_STRONG,
        FINITE_NUMSEG, .. } := D.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_NUMSEG, LAMBDA_BETA, MONO_AND, REAL_ABS_POS, REAL_ADD_LID, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL_EQ, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_POW_2, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, SUM_ADD, SUM_DELTA, SUM_EQ, SUM_LE, SUM_LE_NUMSEG,
        SUM_LMUL, SUM_SWAP, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, LIFT_DROP, LINEAR_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, .. } := D.dv.dg.pt.cvx.vec3
  let { dot, linear, VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_ADD_LID,
        VECTOR_MUL_COMPONENT, VECTOR_NEG_COMPONENT, VECTOR_SUB, VECTOR_SUB_COMPONENT,
        VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { LINEAR_BOUNDED_POS, .. } := D.dv.qvec
  let { POW_2_SQRT_ABS, REAL_ABS_0, .. } := D.qsession
  let { COND_COMPONENT, lift, vector_norm, VSUM_COMPONENT, .. } := D.qvec
  -- @@SCOPE END

  let ABSOLUTELY_INTEGRABLE_CONST ← prove
   r"!a b c. (\x. c) absolutely_integrable_on interval[a,b]"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_CONST])

  let ABSOLUTELY_INTEGRABLE_ADD ← prove
   r"!f:real^M->real^N g s.
        f absolutely_integrable_on s /\
        g absolutely_integrable_on s
        ==> (\x. f(x) + g(x)) absolutely_integrable_on s"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N g.
        f absolutely_integrable_on (:real^M) /\
        g absolutely_integrable_on (:real^M)
        ==> (\x. f(x) + g(x)) absolutely_integrable_on (:real^M)")
    ASSUME_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
      GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_ADD_LID]] THEN
    REPEAT STRIP_TAC THEN
    EVERY_ASSUM (STRIP_ASSUME_TAC o
     GEN_REWRITE_RULE I [absolutely_integrable_on]) THEN
    MATCH_MP_TAC BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE THEN
    ASM_SIMP_TAC [INTEGRABLE_ADD] THEN
    MP_TAC (← ISPECL [← q r"g:real^M->real^N", ← q r"(:real^M)"]
       ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION) THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^N", ← q r"(:real^M)"]
       ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION) THEN
    ASM_REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_UNIV] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B1:real")) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"B2:real")) THEN EXISTS_TAC (← q r"B1 + B2:real") THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:(real^M->bool)->bool"))) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"a <= B1 ==> x <= a + B2 ==> x <= B1 + B2"))) THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"b <= B2 ==> x <= a + b ==> x <= a + B2"))) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM SUM_ADD] THEN MATCH_MP_TAC SUM_LE THEN
    FIRST_ASSUM (fun t => tactic_of do
      pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION t])) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"x = y + z ==> norm(x) <= norm(y) + norm(z)")) THEN
    MATCH_MP_TAC INTEGRAL_ADD THEN CONJ_TAC THEN
    MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV])

  let ABSOLUTELY_INTEGRABLE_SUB ← prove
   r"!f:real^M->real^N g s.
        f absolutely_integrable_on s /\
        g absolutely_integrable_on s
        ==> (\x. f(x) - g(x)) absolutely_integrable_on s"
   (REWRITE_TAC [VECTOR_SUB] THEN
    SIMP_TAC [ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_NEG])

  let ABSOLUTELY_INTEGRABLE_LINEAR ← prove
   r"!f:real^M->real^N h:real^N->real^P s.
        f absolutely_integrable_on s /\ linear h
        ==> (h o f) absolutely_integrable_on s"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N h:real^N->real^P.
        f absolutely_integrable_on (:real^M) /\ linear h
        ==> (h o f) absolutely_integrable_on (:real^M)")
    ASSUME_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      REPEAT GEN_TAC THEN DISCH_THEN (fun th => tactic_of do
       pure (ANTE_RES_THEN MP_TAC th THEN
             ASSUME_TAC (← MATCH_MP LINEAR_0 (← CONJUNCT2 th)))) THEN
      ASM_REWRITE_TAC [o_DEF, COND_RAND]] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [absolutely_integrable_on]) THEN
    ASM_SIMP_TAC [INTEGRABLE_LINEAR, HAS_BOUNDED_SETVARIATION_ON_UNIV] THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC o MATCH_MP
                LINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"b:real")) THEN EXISTS_TAC (← q r"B * b:real") THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"B * sum d (\k. norm(integral k (f:real^M->real^N)))") THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN REWRITE_TAC [← GSYM SUM_LMUL] THEN
    MATCH_MP_TAC SUM_LE THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    FIRST_ASSUM (fun t => tactic_of do
      pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION t])) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"norm(h(integral (interval[a,b]) (f:real^M->real^N)):real^P)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN MATCH_MP_TAC HAS_INTEGRAL_LINEAR THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV])

  let ABSOLUTELY_INTEGRABLE_VSUM ← prove
   r"!f:A->real^M->real^N s t.
        FINITE t /\
        (!a. a IN t ==> (f a) absolutely_integrable_on s)
        ==>  (\x. vsum t (\a. f a x)) absolutely_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, ABSOLUTELY_INTEGRABLE_0, IN_INSERT,
              ABSOLUTELY_INTEGRABLE_ADD, ETA_AX])

  let ABSOLUTELY_INTEGRABLE_ABS ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s
        ==> (\x. (lambda i. abs(f(x)$i)):real^N) absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\x. (lambda i. abs(f(x)$i))):real^M->real^N =
    (\x. vsum (1..dimindex(:N))
        (\i. (((\y. (lambda j. if j = i then drop y else &0)) o
               (\x. lift(norm((lambda j. if j = i then x$i else &0):real^N))) o
               (f:real^M->real^N)) x)))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:real^M") THEN
      GEN_REWRITE_TAC I [CART_EQ] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [LAMBDA_BETA, VSUM_COMPONENT, o_THM] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
      ASM_SIMP_TAC [SUM_DELTA, IN_NUMSEG, LIFT_DROP] THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
      REWRITE_TAC [vector_norm, dot] THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"sqrt(sum (1..dimindex(:N))
                         (\k. if k = i then ((f:real^M->real^N) x)$i pow 2
                              else &0))") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [SUM_DELTA, IN_NUMSEG, POW_2_SQRT_ABS], ALL_TAC] THEN
      AP_TERM_TAC THEN MATCH_MP_TAC SUM_EQ THEN
      SIMP_TAC [IN_NUMSEG, LAMBDA_BETA] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_POW_2],
      ALL_TAC] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_VSUM THEN
    REWRITE_TAC [IN_NUMSEG, FINITE_NUMSEG] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [ETA_AX] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_LINEAR THEN CONJ_TAC THENL
     [ALL_TAC,
      SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
                LAMBDA_BETA] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [DROP_ADD, REAL_ADD_LID, DROP_CMUL, REAL_MUL_RZERO]] THEN
    REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_NORM THEN
    SUBGOAL_THEN
      (← q r"(\x. lambda j. if j = i then (f x:real^N)$i else &0):real^M->real^N =
     (\x. lambda j. if j = i then x$i else &0) o f")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_LINEAR THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [linear, CART_EQ, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT,
              LAMBDA_BETA] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_ADD_LID] THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    ASM_SIMP_TAC [VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT])

  let ABSOLUTELY_INTEGRABLE_MAX ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f absolutely_integrable_on s /\ g absolutely_integrable_on s
        ==> (\x. (lambda i. max (f(x)$i) (g(x)$i)):real^N)
            absolutely_integrable_on s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ABS) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ADD) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ADD) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(&2)") o
       MATCH_MP ABSOLUTELY_INTEGRABLE_CMUL) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, CART_EQ] THEN
    SIMP_TAC [LAMBDA_BETA, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
              VECTOR_ADD_COMPONENT] THEN
    REPEAT STRIP_TAC THEN REAL_ARITH_TAC)

  let ABSOLUTELY_INTEGRABLE_MAX_1 ← prove
   r"!f:real^M->real g:real^M->real s.
        (\x. lift(f x)) absolutely_integrable_on s /\
        (\x. lift(g x)) absolutely_integrable_on s
        ==> (\x. lift(max (f x) (g x))) absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. (lambda i. max (lift(f x)$i) (lift(g x)$i)):real^1)
                absolutely_integrable_on (s:real^M->bool)")
    MP_TAC THENL [ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_MAX], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, CART_EQ] THEN SIMP_TAC [LAMBDA_BETA, lift])

  let ABSOLUTELY_INTEGRABLE_MIN ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        f absolutely_integrable_on s /\ g absolutely_integrable_on s
        ==> (\x. (lambda i. min (f(x)$i) (g(x)$i)):real^N)
            absolutely_integrable_on s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ABS) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_ADD) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SUB) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(&2)") o
       MATCH_MP ABSOLUTELY_INTEGRABLE_CMUL) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, CART_EQ] THEN
    SIMP_TAC [LAMBDA_BETA, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
              VECTOR_ADD_COMPONENT] THEN
    REPEAT STRIP_TAC THEN REAL_ARITH_TAC)

  let ABSOLUTELY_INTEGRABLE_MIN_1 ← prove
   r"!f:real^M->real g:real^M->real s.
        (\x. lift(f x)) absolutely_integrable_on s /\
        (\x. lift(g x)) absolutely_integrable_on s
        ==> (\x. lift(min (f x) (g x))) absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. (lambda i. min (lift(f x)$i) (lift(g x)$i)):real^1)
                absolutely_integrable_on (s:real^M->bool)")
    MP_TAC THENL [ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_MIN], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, CART_EQ] THEN SIMP_TAC [LAMBDA_BETA, lift])

  let ABSOLUTELY_INTEGRABLE_ABS_EQ ← prove
   r"!f:real^M->real^N s.
        f absolutely_integrable_on s <=>
          f integrable_on s /\
          (\x. (lambda i. abs(f(x)$i)):real^N) integrable_on s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [ABSOLUTELY_INTEGRABLE_ABS,
              ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    SUBGOAL_THEN
     (← q r"!f:real^M->real^N.
        f integrable_on (:real^M) /\
        (\x. (lambda i. abs(f(x)$i)):real^N) integrable_on (:real^M)
        ==> f absolutely_integrable_on (:real^M)")
    ASSUME_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV,
                        ← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
      DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
      REWRITE_TAC [CART_EQ] THEN REPEAT STRIP_TAC THEN
      ASM_SIMP_TAC [LAMBDA_BETA, COND_COMPONENT, VEC_COMPONENT] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_ABS_0]] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE THEN
    ASM_REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_UNIV] THEN
    EXISTS_TAC
     (← q r"sum (1..dimindex(:N))
        (\i. integral (:real^M)
              (\x. (lambda j. abs ((f:real^M->real^N) x$j)):real^N)$i)") THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. sum (1..dimindex(:N))
      (\i. integral k
              (\x. (lambda j. abs ((f:real^M->real^N) x$j)):real^N)$i))") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN
      FIRST_ASSUM (fun t => tactic_of do
        pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION t])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"sum (1..dimindex(:N))
             (\i. abs((integral (interval[a,b]) (f:real^M->real^N))$i))") THEN
      REWRITE_TAC [NORM_LE_L1] THEN MATCH_MP_TAC SUM_LE_NUMSEG THEN
      X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y /\ --x <= y ==> abs(x) <= y")) THEN
      ASM_SIMP_TAC [← GSYM VECTOR_NEG_COMPONENT] THEN
      SUBGOAL_THEN (← q r"(f:real^M->real^N) integrable_on interval[a,b] /\
        (\x. (lambda i. abs (f x$i)):real^N) integrable_on interval[a,b]")
      STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV],
        ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM INTEGRAL_NEG] THEN
      CONJ_TAC THEN MATCH_MP_TAC INTEGRAL_COMPONENT_LE THEN
      ASM_SIMP_TAC [INTEGRABLE_NEG, LAMBDA_BETA] THEN
      ASM_SIMP_TAC [VECTOR_NEG_COMPONENT] THEN
      REPEAT STRIP_TAC THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) SUM_SWAP o lhand o snd) THEN
    ASM_REWRITE_TAC [FINITE_NUMSEG] THEN DISCH_THEN SUBST_ALL_TAC THEN
    MATCH_MP_TAC SUM_LE_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC
     (← q r"(integral (UNIONS d)
              (\x. (lambda j. abs ((f:real^M->real^N) x$j)):real^N))$k") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM VSUM_COMPONENT] THEN
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_COMBINE_DIVISION_TOPDOWN THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC INTEGRAL_SUBSET_COMPONENT_LE THEN
      ASM_SIMP_TAC [LAMBDA_BETA, SUBSET_UNIV, REAL_ABS_POS]] THEN
    MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
    MAP_EVERY EXISTS_TAC [← q r"(:real^M)", ← q r"d:(real^M->bool)->bool"] THEN
    ASM_REWRITE_TAC [SUBSET_UNIV])

  pure { ABSOLUTELY_INTEGRABLE_CONST, ABSOLUTELY_INTEGRABLE_ADD, ABSOLUTELY_INTEGRABLE_SUB,
         ABSOLUTELY_INTEGRABLE_LINEAR, ABSOLUTELY_INTEGRABLE_VSUM, ABSOLUTELY_INTEGRABLE_ABS,
         ABSOLUTELY_INTEGRABLE_MAX, ABSOLUTELY_INTEGRABLE_MAX_1, ABSOLUTELY_INTEGRABLE_MIN,
         ABSOLUTELY_INTEGRABLE_MIN_1, ABSOLUTELY_INTEGRABLE_ABS_EQ }

/- ------------------------------------------------------------------------- -/
/- Absolute integrability from bounds; finite inf and sup; continuous       -/
/- functions; pastecart symmetry.  (integration.ml 10981-11231)              -/
/- ------------------------------------------------------------------------- -/

structure INAD where
  NONNEGATIVE_ABSOLUTELY_INTEGRABLE : thm
  ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_BOUND : thm
  ABSOLUTELY_INTEGRABLE_INF_1 : thm
  ABSOLUTELY_INTEGRABLE_SUP_1 : thm
  ABSOLUTELY_INTEGRABLE_CONTINUOUS : thm
  INTEGRABLE_MIN_CONST_1 : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_UBOUND : thm
  ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND : thm
  ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS : thm
  ABSOLUTELY_INTEGRABLE_PASTECART_SYM : thm
  HAS_INTEGRAL_PASTECART_SYM_UNIV : thm
  INTEGRAL_PASTECART_SYM_UNIV : thm
  INTEGRABLE_PASTECART_SYM_UNIV : thm
  ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINAD [HolBase] (D : IntegrationDeps) (BINB : INB) (BINE : INE) (BINH : INH) (BINL : INL) (BINN : INN) (BINO : INO) (BINP : INP) (BINQ : INQ) (BINS : INS) (BINV : INV) (BINW : INW) (BINZ : INZ) (BINAB : INAB) (BINAC : INAC) : ExceptT String IO INAD := do
  -- @@SCOPE BEGIN
  let { DIVISION_OF_FINITE, FORALL_IN_DIVISION, .. } := BINB
  let { INTEGRABLE_EQ, INTEGRABLE_SUB, .. } := BINE
  let { INTEGRABLE_CONST, .. } := BINH
  let { INTEGRABLE_CONTINUOUS, .. } := BINL
  let { INTEGRABLE_RESTRICT_UNIV, .. } := BINN
  let { HAS_INTEGRAL_PASTECART_SYM, INTEGRABLE_PASTECART_SYM, INTEGRAL_PASTECART_SYM, .. }
        := BINO
  let { INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { INTEGRABLE_ON_SUBDIVISION, INTEGRAL_COMBINE_DIVISION_BOTTOMUP, .. } := BINS
  let { INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND, INTEGRAL_NORM_BOUND_INTEGRAL, .. } :=
        BINV
  let { HAS_BOUNDED_SETVARIATION_ON_UNIV, .. } := BINW
  let { ABSOLUTELY_INTEGRABLE_0, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        absolutely_integrable_on, ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL,
        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV, .. } := BINZ
  let { BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE, .. } := BINAB
  let { ABSOLUTELY_INTEGRABLE_ABS_EQ, ABSOLUTELY_INTEGRABLE_ADD,
        ABSOLUTELY_INTEGRABLE_MAX_1, ABSOLUTELY_INTEGRABLE_MIN_1, ABSOLUTELY_INTEGRABLE_SUB,
        .. } := BINAC
  let { CART_EQ, COND_RAND, CONJ_ASSOC, DIMINDEX_1, EQ_IMP, ETA_AX, EXISTS_PASTECART,
        EXISTS_REFL, FINITE_IMAGE, FINITE_INDUCT_STRONG, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, FUN_EQ_THM, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMP_CONJ, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_SING, IN_UNIV, LAMBDA_BETA, LEFT_FORALL_IMP_THM, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_SUB_LE, RIGHT_FORALL_IMP_THM, SNDCART_PASTECART, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, SUBSET_UNIV, SUM_LE, SURJECTIVE_IMAGE_EQ, .. } :=
        D.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_VEC, FORALL_1, LIFT_DROP, LIFT_EQ, LIFT_NUM, NORM_0, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_SUB_COMPONENT, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, .. } := D.dv.dg.pt.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL, .. } :=
        D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_CONST, .. } := D.dv.dg.pt.cvx.top3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { LIFT_SUM, .. } := D.dv.dg.qvec
  let { INF_INSERT_FINITE, SUP_INSERT_FINITE, .. } := D.qsession
  let { NORM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let NONNEGATIVE_ABSOLUTELY_INTEGRABLE ← prove
   r"!f:real^M->real^N s.
        (!x i. x IN s /\ 1 <= i /\ i <= dimindex(:N)
               ==> &0 <= f(x)$i) /\
        f integrable_on s
        ==> f absolutely_integrable_on s"
   (SIMP_TAC [ABSOLUTELY_INTEGRABLE_ABS_EQ] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_EQ THEN
    EXISTS_TAC (← q r"f:real^M->real^N") THEN
    ASM_SIMP_TAC [CART_EQ, LAMBDA_BETA, real_abs])

  let ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND ← prove
   r"!f:real^M->real^N g s.
        (!x. x IN s ==> norm(f x) <= drop(g x)) /\
        f integrable_on s /\ g integrable_on s
        ==> f absolutely_integrable_on s"
   (SUBGOAL_THEN
     (← q r"!f:real^M->real^N g.
        (!x. norm(f x) <= drop(g x)) /\
        f integrable_on (:real^M) /\ g integrable_on (:real^M)
        ==> f absolutely_integrable_on (:real^M)")
    ASSUME_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV, ← GSYM
                        ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"(\x. if x IN s then g x else vec 0):real^M->real^1") THEN
      ASM_REWRITE_TAC [] THEN GEN_TAC THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [REAL_LE_REFL, NORM_0, DROP_VEC]] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC BOUNDED_SETVARIATION_ABSOLUTELY_INTEGRABLE THEN
    ASM_REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_UNIV] THEN
    EXISTS_TAC (← q r"drop(integral(:real^M) g)") THEN
    X_GEN_TAC (← q r"d:(real^M->bool)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. drop(integral k (g:real^M->real^1)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"drop(integral (UNIONS d:real^M->bool) g)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> y <= x")) THEN
      ASM_SIMP_TAC [← GSYM LIFT_EQ, LIFT_DROP, LIFT_SUM, o_DEF] THEN
      MATCH_MP_TAC INTEGRAL_COMBINE_DIVISION_BOTTOMUP THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ASM_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"(:real^M)") THEN ASM_REWRITE_TAC [SUBSET_UNIV],
      MATCH_MP_TAC INTEGRAL_SUBSET_DROP_LE THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, IN_UNIV] THEN CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [← NORM_ARITH (← q r"norm(x) <= y ==> &0 <= y")]] THEN
      MATCH_MP_TAC INTEGRABLE_ON_SUBDIVISION THEN
      MAP_EVERY EXISTS_TAC [← q r"(:real^M)", ← q r"d:(real^M->bool)->bool"] THEN
      ASM_REWRITE_TAC [SUBSET_UNIV]])

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_BOUND ← prove
   r"!f:real^M->real^N g:real^M->real^P s.
        (!x. x IN s ==> norm(f x) <= norm(g x)) /\
        f integrable_on s /\ g absolutely_integrable_on s
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I
      [absolutely_integrable_on]) THEN
    MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"(\x. lift(norm((g:real^M->real^P) x)))",
      ← q r"s:real^M->bool"] ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND) THEN
    ASM_REWRITE_TAC [LIFT_DROP])

  let ABSOLUTELY_INTEGRABLE_INF_1 ← prove
   r"!fs s:real^N->bool k:A->bool.
        FINITE k /\ ~(k = {}) /\
        (!i. i IN k ==> (\x. lift(fs x i)) absolutely_integrable_on s)
        ==> (\x. lift(inf (IMAGE (fs x) k))) absolutely_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [IMAGE_CLAUSES] THEN
    SIMP_TAC [INF_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [IN_SING, LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MIN_1 THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INSERT] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INSERT])

  let ABSOLUTELY_INTEGRABLE_SUP_1 ← prove
   r"!fs s:real^N->bool k:A->bool.
        FINITE k /\ ~(k = {}) /\
        (!i. i IN k ==> (\x. lift(fs x i)) absolutely_integrable_on s)
        ==> (\x. lift(sup (IMAGE (fs x) k))) absolutely_integrable_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [IMAGE_CLAUSES] THEN
    SIMP_TAC [SUP_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"k:A->bool"] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [IN_SING, LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_MAX_1 THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INSERT] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INSERT])

  let ABSOLUTELY_INTEGRABLE_CONTINUOUS ← prove
   r"!f:real^M->real^N a b.
        f continuous_on interval[a,b]
        ==> f absolutely_integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND THEN
    SUBGOAL_THEN (← q r"compact(IMAGE (f:real^M->real^N) (interval[a,b]))") MP_TAC THENL
     [ASM_SIMP_TAC [COMPACT_CONTINUOUS_IMAGE, COMPACT_INTERVAL], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x:real^M. lift(B)") THEN
    ASM_SIMP_TAC [INTEGRABLE_CONST, LIFT_DROP, INTEGRABLE_CONTINUOUS])

  let INTEGRABLE_MIN_CONST_1 ← prove
   r"!f s t.
        &0 <= t /\ (!x. x IN s ==> &0 <= f x) /\
        (\x:real^N. lift(f x)) integrable_on s
        ==> (\x. lift(min (f x) t)) integrable_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRABLE_ON_ALL_INTERVALS_INTEGRABLE_BOUND THEN
    EXISTS_TAC (← q r"\x:real^N. lift(f x)") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\x:real^N. if x IN s then f x else &0",
        ← q r"(\x. t):real^N->real",
        ← q r"interval[a:real^N,b]"] ABSOLUTELY_INTEGRABLE_MIN_1) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [SIMP_TAC [ABSOLUTELY_INTEGRABLE_CONTINUOUS, CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"(:real^N)") THEN REWRITE_TAC [SUBSET_UNIV] THEN
        REWRITE_TAC [COND_RAND, LIFT_DROP, LIFT_NUM] THEN
        REWRITE_TAC [ABSOLUTELY_INTEGRABLE_RESTRICT_UNIV] THEN
        MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
        ASM_SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        ASM_REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, LIFT_DROP, ← GSYM drop],
        DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
        MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
        COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN ASM_REAL_ARITH_TAC],
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
      ASM_REWRITE_TAC [NORM_REAL, ← GSYM drop, LIFT_DROP] THEN
      ASM_REAL_ARITH_TAC])

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        (!x i. x IN s /\ 1 <= i /\ i <= dimindex(:N) ==> f(x)$i <= g(x)$i) /\
        f integrable_on s /\ g absolutely_integrable_on s
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. (g:real^M->real^N)(x) - (g(x) - f(x))) absolutely_integrable_on s")
    MP_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_SUB THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
      ASM_REWRITE_TAC [REAL_SUB_LE, VECTOR_SUB_COMPONENT] THEN
      MATCH_MP_TAC INTEGRABLE_SUB THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
      REWRITE_TAC [← VECTOR_ARITH (← q r"x - (x - y):real^N = y"), ETA_AX]])

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND ← prove
   r"!f:real^M->real^N g:real^M->real^N s.
        (!x i. x IN s /\ 1 <= i /\ i <= dimindex(:N) ==> f(x)$i <= g(x)$i) /\
        f absolutely_integrable_on s /\ g integrable_on s
        ==> g absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. (f:real^M->real^N)(x) + (g(x) - f(x))) absolutely_integrable_on s")
    MP_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_ADD THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE THEN
      ASM_REWRITE_TAC [REAL_SUB_LE, VECTOR_SUB_COMPONENT] THEN
      MATCH_MP_TAC INTEGRABLE_SUB THEN
      ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE],
      REWRITE_TAC [← VECTOR_ARITH (← q r"y + (x - y):real^N = x"), ETA_AX]])

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_UBOUND ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s.
        (!x. x IN s ==> drop(f(x)) <= drop(g(x))) /\
        f integrable_on s /\ g absolutely_integrable_on s
        ==> f absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC
      ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND THEN
    EXISTS_TAC (← q r"g:real^M->real^1") THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_REWRITE_TAC [IMP_IMP, FORALL_1, DIMINDEX_1, ← GSYM drop])

  let ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND ← prove
   r"!f:real^M->real^1 g:real^M->real^1 s.
        (!x. x IN s ==> drop(f(x)) <= drop(g(x))) /\
        f absolutely_integrable_on s /\ g integrable_on s
        ==> g absolutely_integrable_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC
      ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND THEN
    EXISTS_TAC (← q r"f:real^M->real^1") THEN
    ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_REWRITE_TAC [IMP_IMP, FORALL_1, DIMINDEX_1, ← GSYM drop])

  let ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS ← prove
   r"!f:real^N->real^1 s.
        (!x. x IN s ==> &0 <= drop(f x))
        ==> (f absolutely_integrable_on s <=> f integrable_on s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")]
          ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND) THEN
    EXISTS_TAC (← q r"(\x. vec 0):real^N->real^1") THEN
    ASM_SIMP_TAC [ABSOLUTELY_INTEGRABLE_0, DROP_VEC])

  let ABSOLUTELY_INTEGRABLE_PASTECART_SYM ← prove
   r"!f:real^(M,N)finite_sum->real^P s y.
        (\z. f(pastecart (sndcart z) (fstcart z))) absolutely_integrable_on
        (IMAGE (\z. pastecart (sndcart z) (fstcart z)) s) <=>
        f absolutely_integrable_on s"
   (REWRITE_TAC [absolutely_integrable_on, INTEGRABLE_PASTECART_SYM])

  let (HAS_INTEGRAL_PASTECART_SYM_UNIV, INTEGRAL_PASTECART_SYM_UNIV,
       INTEGRABLE_PASTECART_SYM_UNIV, ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV) ←
    match CONJUNCTS (← prove
     r"(!f:real^(M,N)finite_sum->real^P s y.
        ((\z. f(pastecart (sndcart z) (fstcart z))) has_integral y) UNIV <=>
        (f has_integral y) UNIV) /\
   (!f:real^(M,N)finite_sum->real^P s y.
        integral UNIV (\z. f(pastecart (sndcart z) (fstcart z))) =
        integral UNIV f) /\
   (!f:real^(M,N)finite_sum->real^P s y.
        (\z. f(pastecart (sndcart z) (fstcart z))) integrable_on UNIV <=>
        f integrable_on UNIV) /\
   (!f:real^(M,N)finite_sum->real^P s y.
     (\z. f(pastecart (sndcart z) (fstcart z)))
     absolutely_integrable_on UNIV <=>
       f absolutely_integrable_on UNIV)"
     (REPEAT STRIP_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM HAS_INTEGRAL_PASTECART_SYM],
        GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGRAL_PASTECART_SYM],
        GEN_REWRITE_TAC RAND_CONV [← GSYM INTEGRABLE_PASTECART_SYM],
        GEN_REWRITE_TAC RAND_CONV [← GSYM ABSOLUTELY_INTEGRABLE_PASTECART_SYM]] THEN
      TRY AP_THM_TAC THEN AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN REWRITE_TAC [IN_UNIV] THEN
      REWRITE_TAC [EXISTS_PASTECART, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      REWRITE_TAC [FORALL_PASTECART] THEN MESON_TAC [])) with
    | [a, b, c, d] => pure (a, b, c, d)
    | _ => throw "HAS_INTEGRAL_PASTECART_SYM_UNIV: match failure"

  pure { NONNEGATIVE_ABSOLUTELY_INTEGRABLE, ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_BOUND, ABSOLUTELY_INTEGRABLE_INF_1,
         ABSOLUTELY_INTEGRABLE_SUP_1, ABSOLUTELY_INTEGRABLE_CONTINUOUS,
         INTEGRABLE_MIN_CONST_1,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_UBOUND,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_COMPONENT_LBOUND,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_UBOUND,
         ABSOLUTELY_INTEGRABLE_ABSOLUTELY_INTEGRABLE_DROP_LBOUND,
         ABSOLUTELY_INTEGRABLE_EQ_INTEGRABLE_POS, ABSOLUTELY_INTEGRABLE_PASTECART_SYM,
         HAS_INTEGRAL_PASTECART_SYM_UNIV, INTEGRAL_PASTECART_SYM_UNIV,
         INTEGRABLE_PASTECART_SYM_UNIV, ABSOLUTELY_INTEGRABLE_PASTECART_SYM_UNIV }

/- ------------------------------------------------------------------------- -/
/- Relating vector integrals to integrals of components.                    -/
/- (integration.ml 11232-11329)                                              -/
/- ------------------------------------------------------------------------- -/

structure INAE where
  HAS_INTEGRAL_COMPONENTWISE : thm
  INTEGRABLE_COMPONENTWISE : thm
  INTEGRABLE_LIFT_COMPONENT : thm
  LIFT_INTEGRAL_COMPONENT : thm
  INTEGRAL_COMPONENT : thm
  ABSOLUTELY_INTEGRABLE_COMPONENTWISE : thm
  ABSOLUTELY_INTEGRABLE_LIFT_COMPONENT : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupINAE [HolBase] (D : IntegrationDeps) (BINC : INC) (BINE : INE) (BINZ : INZ) (BINAD : INAD) : ExceptT String IO INAE := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_INTEGRAL, integrable_on, .. } := BINC
  let { HAS_INTEGRAL_LINEAR, HAS_INTEGRAL_VSUM, INTEGRABLE_VSUM, INTEGRAL_UNIQUE, .. } :=
        BINE
  let { absolutely_integrable_on, .. } := BINZ
  let { ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND, .. } := BINAD
  let { ETA_AX, FINITE_INDEX_INRANGE, FINITE_NUMSEG, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, .. } := D.dv.dg.pt.cvx.core2
  let { IN_NUMSEG, .. } := D.dv.dg.pt.cvx.core3
  let { o_DEF, .. } := D.dv.dg.pt.cvx.core6
  let { LAMBDA_SKOLEM, .. } := D.dv.dg.pt.cvx.misc
  let { BASIS_EXPANSION, COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_VSUM, EXISTS_LIFT, LIFT_DROP, LINEAR_LIFT_COMPONENT, NORM_1, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { MESON, MESON_TAC, .. } := D.dv.dg.pt.cvx
  let { LINEAR_ID, .. } := D.dv.dg.qvec
  let { LINEAR_VMUL_DROP, .. } := D.dv.qvec
  -- @@SCOPE END

  let HAS_INTEGRAL_COMPONENTWISE ← prove
   r"!f:real^M->real^N s y.
        (f has_integral y) s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> ((\x. lift((f x)$i)) has_integral (lift(y$i))) s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"\u:real^N. lift(u$i)") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_LINEAR)) THEN
      REWRITE_TAC [o_DEF] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [LINEAR_LIFT_COMPONENT],
      GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM BASIS_EXPANSION] THEN
      GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV o BINDER_CONV)
       [← GSYM BASIS_EXPANSION] THEN
      MATCH_MP_TAC HAS_INTEGRAL_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"\v. drop(v) % (basis i:real^N)") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_LINEAR)) THEN
      SIMP_TAC [o_DEF, LIFT_DROP, LINEAR_VMUL_DROP, LINEAR_ID]])

  let INTEGRABLE_COMPONENTWISE ← prove
   r"!f:real^M->real^N s.
        f integrable_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift((f x)$i)) integrable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [integrable_on] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [HAS_INTEGRAL_COMPONENTWISE] THEN
    REWRITE_TAC [← GSYM LAMBDA_SKOLEM, ← GSYM EXISTS_LIFT])

  let INTEGRABLE_LIFT_COMPONENT ← prove
   r"!(f:real^M->real^N) s.
        f integrable_on s /\
        1 <= i /\ i <= dimindex(:N)
        ==> (\x. lift(f x$i)) integrable_on s"
   (MESON_TAC [INTEGRABLE_COMPONENTWISE])

  let LIFT_INTEGRAL_COMPONENT ← prove
   r"!f:real^M->real^N.
        f integrable_on s
        ==> lift((integral s f)$k) = integral s (\x. lift((f x)$k))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?j. 1 <= j /\ j <= dimindex(:N) /\ !z:real^N. z$k = z$j")
    CHOOSE_TAC THENL [REWRITE_TAC [FINITE_INDEX_INRANGE], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_INTEGRAL_COMPONENTWISE] THEN
    ASM_SIMP_TAC [])

  let INTEGRAL_COMPONENT ← prove
   r"!f:real^M->real^N.
        f integrable_on s
        ==> (integral s f)$k = drop(integral s (\x. lift((f x)$k)))"
   (SIMP_TAC [← GSYM LIFT_INTEGRAL_COMPONENT, LIFT_DROP])

  let ABSOLUTELY_INTEGRABLE_COMPONENTWISE ← prove
   r"!f:real^M->real^N s.
     f absolutely_integrable_on s <=>
     (!i. 1 <= i /\ i <= dimindex(:N)
          ==> (\x. lift(f x$i)) absolutely_integrable_on s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_integrable_on] THEN
    MATCH_MP_TAC (← MESON []
     (← q r"(p <=> !i. a i ==> P i) /\
      (p /\ (!i. a i ==> P i) ==> (q <=> (!i. a i ==> Q i)))
      ==> (p /\ q <=> (!i. a i ==> P i /\ Q i))")) THEN
    CONJ_TAC THENL [REWRITE_TAC [← GSYM INTEGRABLE_COMPONENTWISE], ALL_TAC] THEN
    REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [SUBGOAL_THEN
       (← q r"(\x. lift((f:real^M->real^N) x$i)) absolutely_integrable_on s")
      MP_TAC THENL [ALL_TAC, SIMP_TAC [absolutely_integrable_on]] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND THEN
      EXISTS_TAC (← q r"\x. lift(norm((f:real^M->real^N) x))") THEN
      ASM_SIMP_TAC [NORM_1, LIFT_DROP, COMPONENT_LE_NORM],
      SUBGOAL_THEN
       (← q r"(f:real^M->real^N) absolutely_integrable_on s")
      MP_TAC THENL [ALL_TAC, SIMP_TAC [absolutely_integrable_on]] THEN
      MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND THEN
      EXISTS_TAC
       (← q r"\x. vsum (1..dimindex(:N))
               (\i. lift(norm(lift((f:real^M->real^N)(x)$i))))") THEN
      ASM_SIMP_TAC [INTEGRABLE_VSUM, IN_NUMSEG, FINITE_NUMSEG] THEN
      SIMP_TAC [DROP_VSUM, FINITE_NUMSEG, o_DEF, LIFT_DROP] THEN
      REWRITE_TAC [NORM_LIFT, NORM_LE_L1]])

  let ABSOLUTELY_INTEGRABLE_LIFT_COMPONENT ← prove
   r"!(f:real^M->real^N) s.
        f absolutely_integrable_on s /\
        1 <= i /\ i <= dimindex(:N)
        ==> (\x. lift(f x$i)) absolutely_integrable_on s"
   (MESON_TAC [ABSOLUTELY_INTEGRABLE_COMPONENTWISE])

  pure { HAS_INTEGRAL_COMPONENTWISE, INTEGRABLE_COMPONENTWISE, INTEGRABLE_LIFT_COMPONENT,
         LIFT_INTEGRAL_COMPONENT, INTEGRAL_COMPONENT, ABSOLUTELY_INTEGRABLE_COMPONENTWISE,
         ABSOLUTELY_INTEGRABLE_LIFT_COMPONENT }

/- ------------------------------------------------------------------------- -/
/- Dominated convergence.  (integration.ml 11330-11690)                     -/
/- ------------------------------------------------------------------------- -/

structure INAF where
  DOMINATED_CONVERGENCE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAF [HolBase] (D : IntegrationDeps) (BINI : INI) (BINU : INU) (BINV : INV) (BINZ : INZ) (BINAD : INAD) (BINAE : INAE) : ExceptT String IO INAF := do
  -- @@SCOPE BEGIN
  let { INTEGRAL_DROP_LE, .. } := BINI
  let { MONOTONE_CONVERGENCE_DECREASING, MONOTONE_CONVERGENCE_INCREASING, .. } := BINU
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := BINV
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, .. } := BINZ
  let { ABSOLUTELY_INTEGRABLE_INF_1, ABSOLUTELY_INTEGRABLE_INTEGRABLE_BOUND,
        ABSOLUTELY_INTEGRABLE_SUP_1, .. } := BINAD
  let { INTEGRABLE_COMPONENTWISE, LIFT_INTEGRAL_COMPONENT, .. } := BINAE
  let { ETA_AX, EXISTS_IN_IMAGE, EXTENSION, FINITE_NUMSEG, FORALL_AND_THM, .. } :=
        D.dv.dg.pt.cvx.core1
