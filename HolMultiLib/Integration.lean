      FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o REWRITE_RULE [equiintegrable_on]) THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [REPEAT GEN_TAC THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"x$i <= c <=> x IN {x:real^N | x$i <= c}")] THEN
        REWRITE_TAC [INTEGRABLE_RESTRICT_INTER] THEN
        ONCE_REWRITE_TAC [INTER_COMM] THEN SIMP_TAC [INTERVAL_SPLIT] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
        EXISTS_TAC (← q r"interval[a:real^M,b]") THEN ASM_SIMP_TAC [] THEN
        SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA, REAL_LE_REFL] THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        REAL_ARITH_TAC,
        DISCH_TAC] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"fs:(real^M->real^N)->bool", ← q r"f:real^M->real^N",
                        ← q r"a:real^M", ← q r"b:real^M", ← q r"e / &12"]
            BOUNDED_EQUIINTEGRAL_OVER_THIN_TAGGED_PARTIAL_DIVISION) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &12")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g0:real^M->real^M->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?d. gauge d /\
        !p h. p tagged_partial_division_of interval [a,b] /\
              d fine p /\ (h:real^M->real^N) IN fs
              ==> sum p (\(x,k). norm(content k % h x - integral k h)) <
                  e / &3")
       (X_CHOOSE_THEN (← q r"g1:real^M->real^M->bool") STRIP_ASSUME_TAC)
      THENL
       [FIRST_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [equiintegrable_on]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"e / &7 / (&(dimindex(:N)) + &1)")) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &7 /\ &0 < &n + &1")] THEN
        MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"d:real^M->real^M->bool") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN
        MAP_EVERY X_GEN_TAC
         [← q r"p:(real^M#(real^M->bool))->bool", ← q r"h:real^M->real^N"] THEN
        STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"h:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M",
               ← q r"d:real^M->real^M->bool", ← q r"e / &7 / (&(dimindex(:N)) + &1)"]
            HENSTOCK_LEMMA_PART2) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &7 /\ &0 < &n + &1")] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"p:(real^M#(real^M->bool))->bool")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"a < b ==> x <= a ==> x < b")) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&2 * d * e / &7 / (d + &1) =
                            (e * &2 / &7 * d) / (d + &1)")] THEN
        SIMP_TAC [REAL_LT_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 < e /\ &0 < e * d ==> e * &2 / &7 * d < e / &3 * (d + &1)")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LT_MUL THEN
        ASM_SIMP_TAC [REAL_OF_NUM_LT, LE_1, DIMINDEX_GE_1],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"\x. (g0:real^M->real^M->bool) x INTER g1 x") THEN
      ASM_SIMP_TAC [GAUGE_INTER, FINE_INTER] THEN
      X_GEN_TAC (← q r"i:num") THEN
      ASM_CASES_TAC (← q r"1 <= i") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"i <= dimindex(:M)") THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← MESON []
       (← q r"!P. ((!c. (a:real^M)$i <= c /\ c <= (b:real^M)$i ==> P c) ==> (!c. P c)) /\
        (!c. (a:real^M)$i <= c /\ c <= (b:real^M)$i ==> P c)
        ==> !c. P c")) THEN
      DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
       [DISCH_THEN (LABEL_TAC "*") THEN
        X_GEN_TAC (← q r"c:real") THEN
        ASM_CASES_TAC (← q r"(a:real^M)$i <= c /\ c <= (b:real^M)$i") THENL
