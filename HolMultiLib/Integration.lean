        MP_TAC (← SPEC (← q r"{drop((f:num->real^M->real^1) j x) | m <= j}") SUP) THEN
        ABBREV_TAC (← q r"i = sup {drop((f:num->real^M->real^1) j x) | m <= j}") THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
        REWRITE_TAC [IN_ELIM_THM, EXTENSION, NOT_IN_EMPTY] THEN ANTS_TAC THENL
         [CONJ_TAC THENL [MESON_TAC [LE_REFL], ALL_TAC] THEN
          EXISTS_TAC (← q r"drop(h(x:real^M))") THEN X_GEN_TAC (← q r"j:num") THEN
          FIRST_X_ASSUM (MP_TAC o SPECL [← q r"j:num", ← q r"x:real^M"]) THEN
          ASM_REWRITE_TAC [NORM_1] THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"i - e:real"))) THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> ~(i <= i - e)")] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, REAL_NOT_LE] THEN
