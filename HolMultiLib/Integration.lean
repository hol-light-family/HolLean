      FIRST_ASSUM (MP_TAC o
        GEN_REWRITE_RULE I [HAS_BOUNDED_VARIATION_DARBOUX]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"c:real^1"]
       INCREASING_LEFT_LIMIT_1) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"c:real^1"]
       INCREASING_LEFT_LIMIT_1) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"gc:real^1") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"hc:real^1") THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"k = gc - (g:real^1->real^1) c") THEN
      SUBGOAL_THEN (← q r"hc - (h:real^1->real^1) c = k") ASSUME_TAC THENL
       [EXPAND_TAC "k" THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH
         (← q r"hc' - hc:real^1 = gc' - gc <=> gc' - hc' = gc - hc")] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONTINUOUS_WITHIN]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE
          [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
          LIM_UNIQUE) THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_WITHIN] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
        ASM_SIMP_TAC [LIM_SUB],
        ALL_TAC] THEN
      MAP_EVERY ABBREV_TAC
       [← q r"g':real^1->real^1 = \x. if drop c <= drop x then g(x) + k else g(x)",
        ← q r"h':real^1->real^1 =
           \x. if drop c <= drop x then h(x) + k else h(x)"] THEN
      SUBGOAL_THEN
       (← q r"(!x y. x IN interval[a,c] /\ y IN interval[a,c] /\ drop x <= drop y
             ==> drop(g' x) <= drop(g' y)) /\
      (!x y. x IN interval[a,c] /\ y IN interval[a,c] /\ drop x <= drop y
             ==> drop(h' x) <= drop(h' y))")
      STRIP_ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g'", "h'"] THEN REWRITE_TAC [] THEN CONJ_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
        (ASM_CASES_TAC (← q r"drop c <= drop x") THENL
          [SUBGOAL_THEN (← q r"drop c <= drop y") ASSUME_TAC THENL
            [ASM_REAL_ARITH_TAC, ASM_REWRITE_TAC []] THEN
           REWRITE_TAC [DROP_ADD, REAL_LE_RADD] THEN
           FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
           RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
           ALL_TAC] THEN
         ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
          [ALL_TAC,
           FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
           RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
           ASM_REAL_ARITH_TAC] THEN
         SUBGOAL_THEN (← q r"y:real^1 = c") SUBST_ALL_TAC THENL
          [REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
         FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
          (← q r"gc - g c = k
         ==> b <= drop(g c + (gc - g c)) ==> b <= drop(g c + k)"))) THEN
         REWRITE_TAC [← VECTOR_ARITH (← q r"a + b - a:real^1 = b")] THEN
