        CONJ_TAC THENL [MESON_TAC [LE_REFL], GEN_TAC THEN DISCH_TAC] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(h - g) < e / &2 ==> g - e / &2 <= h /\ h <= g + e / &2")) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [LE_TRANS],
