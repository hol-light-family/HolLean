    ASM_REWRITE_TAC [UNION_EMPTY, VECTOR_VARIATION_ON_EMPTY] THEN
    REWRITE_TAC [REAL_ADD_LID, REAL_LE_REFL] THEN
    ASM_CASES_TAC (← q r"t:real^1->bool = {}") THEN
