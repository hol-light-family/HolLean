  let { REAL_ADD_SUB, .. } := D.dv.dg.qsession
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { LIM_DROP_LBOUND, LIM_TRANSFORM, LIM_TRIVIAL, .. } := D.dv.qtopology2
  let { CONTINUOUS_COMPONENTWISE_LIFT, CONTINUOUS_WITHIN_COMPARISON, .. } := D.qtopology
  let { DIST_REAL, NORM_REAL, VSUM_SUB_NUMSEG, .. } := D.qvec
  -- @@SCOPE END

  let VECTOR_VARIATION_CONTINUOUS_LEFT ← (do
    let lemma ← prove
     r"!f:real^1->real^1 a b c.
          f has_bounded_variation_on interval[a,b] /\ c IN interval[a,b]
          ==> ((\x. lift(vector_variation(interval[a,x]) f))
               continuous (at c within interval[a,c]) <=>
              f continuous (at c within interval[a,c]))"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [REWRITE_TAC [continuous_within] THEN
        REWRITE_TAC [DIST_LIFT, IN_ELIM_THM, DIST_REAL, ← GSYM drop] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        REWRITE_TAC [← GSYM DROP_SUB] THEN
        MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"c:real^1",
                          ← q r"x:real^1"]
            VECTOR_VARIATION_COMBINE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
