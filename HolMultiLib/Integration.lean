  let { continuous_within, SEGMENT_1, TRIVIAL_LIMIT_WITHIN, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, VECTOR_ARITH, VECTOR_ARITH_TAC, ..
