            REWRITE_TAC [IN_INTERVAL_1] THEN
            RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
            SUBGOAL_THEN (← q r"drop a <= drop c /\ drop c <= drop b \/
                        drop c <= drop a \/ drop b <= drop c")
            STRIP_ASSUME_TAC THENL
             [ASM_REAL_ARITH_TAC,
              ASM_MESON_TAC [],
              EXISTS_TAC (← q r"a:real^1") THEN
              UNDISCH_TAC (← q r"is_interval(t:real^1->bool)"),
              EXISTS_TAC (← q r"b:real^1") THEN
              UNDISCH_TAC (← q r"is_interval(s:real^1->bool)")] THEN
