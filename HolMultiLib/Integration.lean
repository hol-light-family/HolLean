        EXISTS_TAC (← q r"\n. integral (interval [c((s:num->num) n),b])
                               (f:real^1->real^1)") THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
        MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1"]
            INDEFINITE_INTEGRAL_CONTINUOUS_LEFT) THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"d:real^1")) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(c:num->real^1) o (s:num->num)")) THEN
        ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [o_DEF]])
    prove
     r"!f:real^1->real^1 g a b.
        ~(interval[a,b] = {}) /\
        f integrable_on interval [a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                ((\x. g x % f x) has_integral
                 (g(a) % integral (interval[a,c]) f +
                  g(b) % integral (interval[c,b]) f)) (interval[a,b])"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(g:real^1->real) a <= g b") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [ENDS_IN_INTERVAL] THEN
        ASM_MESON_TAC [INTERVAL_EQ_EMPTY_1, REAL_LET_TOTAL],
        ALL_TAC] THEN
      REWRITE_TAC [REAL_LE_LT] THEN STRIP_TAC THENL
       [ALL_TAC,
        SUBGOAL_THEN
         (← q r"!x. x IN interval[a,b] ==> g(x) % (f:real^1->real^1)(x) = g(a) % f x")
        ASSUME_TAC THENL
         [X_GEN_TAC (← q r"x:real^1") THEN
          REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
          AP_THM_TAC THEN AP_TERM_TAC THEN
          RULE_ASSUM_TAC (REWRITE_RULE
           [IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, REAL_NOT_LT]) THEN
          ASM_MESON_TAC [REAL_LE_ANTISYM, REAL_LE_TRANS, REAL_LE_TOTAL],
          ALL_TAC] THEN
        EXISTS_TAC (← q r"a:real^1") THEN ASM_REWRITE_TAC [ENDS_IN_INTERVAL] THEN
        MATCH_MP_TAC HAS_INTEGRAL_EQ THEN
        EXISTS_TAC (← q r"\x. g(a:real^1) % (f:real^1->real^1) x") THEN
        ASM_SIMP_TAC [INTEGRAL_NULL, CONTENT_EQ_0_1, REAL_LE_REFL] THEN
        ASM_SIMP_TAC [INTEGRAL_CMUL, VECTOR_MUL_RZERO, VECTOR_ADD_LID] THEN
        MATCH_MP_TAC HAS_INTEGRAL_CMUL THEN
        ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL]] THEN
      MP_TAC (← ISPECL
       [← q r"f:real^1->real^1",
        ← q r"\x. if drop x < drop a then &0
         else if drop b < drop x then &1
         else (g(x) - g(a)) / (g(b) - g(a))",
        ← q r"a:real^1", ← q r"b:real^1"]
       lemma4) THEN ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN
        REPEAT GEN_TAC THEN
        REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_POS, REAL_LE_REFL]) THEN
        TRY ASM_REAL_ARITH_TAC THEN
        ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_DIV2_EQ, REAL_SUB_LT] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_SUB_LT] THEN
        ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID, REAL_SUB_LE,
                         ← REAL_ARITH (← q r"x - a <= y - a <=> x <= y")] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^1") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> b ==> a /\ c ==> d")] THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(g:real^1->real) b - g a") o
            MATCH_MP HAS_INTEGRAL_CMUL) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP INTEGRABLE_INTEGRAL) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(g:real^1->real)(a)") o
          MATCH_MP HAS_INTEGRAL_CMUL) THEN REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_ADD) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"c:real^1"]
            INTEGRAL_COMBINE) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1], ALL_TAC] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"ga % (i1 + i2) + (gb - ga) % i2:real^N = ga % i1 + gb % i2")] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_EQ) THEN
      X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [← GSYM REAL_NOT_LE, VECTOR_MUL_ASSOC] THEN
      ASM_SIMP_TAC [REAL_DIV_LMUL, REAL_LT_IMP_NZ, REAL_SUB_LT] THEN
      VECTOR_ARITH_TAC))

  pure { SECOND_MEAN_VALUE_THEOREM_FULL }

/- ------------------------------------------------------------------------- -/
/- Corollaries of the second mean value theorem; integrability of monotone  -/
/- functions and products.  (integration.ml 16276-16600)                    -/
/- ------------------------------------------------------------------------- -/

structure INAU where
  SECOND_MEAN_VALUE_THEOREM : thm
  SECOND_MEAN_VALUE_THEOREM_GEN_FULL : thm
  SECOND_MEAN_VALUE_THEOREM_GEN : thm
  SECOND_MEAN_VALUE_THEOREM_BONNET_FULL : thm
  SECOND_MEAN_VALUE_THEOREM_BONNET : thm
  INTEGRABLE_INCREASING_PRODUCT : thm
  INTEGRABLE_INCREASING_PRODUCT_UNIV : thm
  INTEGRABLE_INCREASING : thm
  INTEGRABLE_INCREASING_1 : thm
  INTEGRABLE_DECREASING_PRODUCT : thm
  INTEGRABLE_DECREASING_PRODUCT_UNIV : thm
  INTEGRABLE_DECREASING : thm
  INTEGRABLE_DECREASING_1 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAU [HolBase] (D : IntegrationDeps) (BINA : INA) (BINC : INC) (BINE : INE) (BINH : INH) (BINK : INK) (BINL : INL) (BINQ : INQ) (BINAE : INAE) (BINAT : INAT) : ExceptT String IO INAU := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_1, .. } := BINA
  let { integrable_on, .. } := BINC
  let { HAS_INTEGRAL_NULL, INTEGRABLE_NEG, INTEGRABLE_ON_EMPTY, INTEGRAL_EMPTY,
        INTEGRAL_NULL, INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRABLE_CONST, .. } := BINH
  let { HAS_INTEGRAL_SPIKE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT, .. } := BINK
  let { INTEGRAL_COMBINE, .. } := BINL
  let { INTEGRABLE_ALT_SUBSET, .. } := BINQ
  let { INTEGRABLE_COMPONENTWISE, .. } := BINAE
  let { SECOND_MEAN_VALUE_THEOREM_FULL, .. } := BINAT
  let { DE_MORGAN_THM, DIMINDEX_1, ETA_AX, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_INSERT, IN_SING, IN_UNIV, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, NOT_IN_EMPTY,
        REAL_ABS_NEG, REAL_ABS_POS, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_MUL2, REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, REAL_LT_LE, REAL_LT_LMUL_EQ, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LE, REAL_NOT_LT, RIGHT_FORALL_IMP_THM, .. } :=
        D.dv.dg.pt.cvx.core5
  let { DROP_EQ, FORALL_1, INTERVAL_SING, LIFT_CMUL, LIFT_NUM, NORM_0, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { drop, VECTOR_ADD_LID, VECTOR_MUL_COMPONENT, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
        VECTOR_NEG_COMPONENT, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { BALL_EQ_EMPTY, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { INTERVAL_CASES_1, .. } := D.qtopology
  -- @@SCOPE END

  let SECOND_MEAN_VALUE_THEOREM ← prove
   r"!f:real^1->real^1 g a b.
        ~(interval[a,b] = {}) /\
        f integrable_on interval [a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                integral (interval[a,b]) (\x. g x % f x) =
                 g(a) % integral (interval[a,c]) f +
                 g(b) % integral (interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SECOND_MEAN_VALUE_THEOREM_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^1") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN REWRITE_TAC [])

  let SECOND_MEAN_VALUE_THEOREM_GEN_FULL ← prove
   r"!f:real^1->real^1 g a b u v.
        ~(interval[a,b] = {}) /\ f integrable_on interval [a,b] /\
        (!x. x IN interval(a,b) ==> u <= g x /\ g x <= v) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                ((\x. g x % f x) has_integral
                 (u % integral (interval[a,c]) f +
                  v % integral (interval[c,b]) f)) (interval[a,b])"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"b:real^1 = a") THENL
     [EXISTS_TAC (← q r"a:real^1") THEN ASM_REWRITE_TAC [INTERVAL_SING, IN_SING] THEN
      ASM_SIMP_TAC [← GSYM INTERVAL_SING, INTEGRAL_NULL, CONTENT_EQ_0_1,
        VECTOR_ADD_LID, REAL_LE_REFL, VECTOR_MUL_RZERO, HAS_INTEGRAL_NULL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"drop a < drop b") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LE, DROP_EQ, REAL_LT_LE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"u <= v") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTERVAL_EQ_EMPTY_1, MEMBER_NOT_EMPTY, REAL_NOT_LT,
                     REAL_LE_TRANS],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1",
      ← q r"\x:real^1. if x = a then u else if x = b then v else g x:real",
      ← q r"a:real^1", ← q r"b:real^1"] SECOND_MEAN_VALUE_THEOREM_FULL) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
      ASM_CASES_TAC (← q r"x:real^1 = a") THEN ASM_REWRITE_TAC [] THENL
       [ASM_MESON_TAC [REAL_LE_REFL, INTERVAL_CASES_1], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"y:real^1 = b") THEN ASM_REWRITE_TAC [] THENL
       [ASM_MESON_TAC [REAL_LE_REFL, INTERVAL_CASES_1], ALL_TAC] THEN
      REPEAT (COND_CASES_TAC THEN ASM_SIMP_TAC []) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^1") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN MATCH_MP_TAC
       (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
          HAS_INTEGRAL_SPIKE) THEN
      EXISTS_TAC (← q r"{a:real^1,b}") THEN
      SIMP_TAC [NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT, IN_DIFF, IN_INSERT,
                NOT_IN_EMPTY, DE_MORGAN_THM]])

  let SECOND_MEAN_VALUE_THEOREM_GEN ← prove
   r"!f:real^1->real^1 g a b u v.
        ~(interval[a,b] = {}) /\ f integrable_on interval [a,b] /\
        (!x. x IN interval(a,b) ==> u <= g x /\ g x <= v) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                integral (interval[a,b]) (\x. g x % f x) =
                u % integral (interval[a,c]) f +
                v % integral (interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SECOND_MEAN_VALUE_THEOREM_GEN_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^1") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN REWRITE_TAC [])

  let SECOND_MEAN_VALUE_THEOREM_BONNET_FULL ← prove
   r"!f:real^1->real^1 g a b.
        ~(interval[a,b] = {}) /\ f integrable_on interval [a,b] /\
        (!x. x IN interval[a,b] ==> &0 <= g x) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                ((\x. g x % f x) has_integral
                 (g(b) % integral (interval[c,b]) f)) (interval[a,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"g:real^1->real", ← q r"a:real^1", ← q r"b:real^1",
      ← q r"&0", ← q r"(g:real^1->real) b"] SECOND_MEAN_VALUE_THEOREM_GEN_FULL) THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_ADD_LID] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  let SECOND_MEAN_VALUE_THEOREM_BONNET ← prove
   r"!f:real^1->real^1 g a b.
        ~(interval[a,b] = {}) /\ f integrable_on interval[a,b] /\
        (!x. x IN interval[a,b] ==> &0 <= g x) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g x <= g y)
        ==> ?c. c IN interval [a,b] /\
                integral (interval[a,b]) (\x. g x % f x) =
                g(b) % integral (interval[c,b]) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP SECOND_MEAN_VALUE_THEOREM_BONNET_FULL) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^1") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN REWRITE_TAC [])

  let INTEGRABLE_INCREASING_PRODUCT ← prove
   r"!f:real^1->real^N g a b.
        f integrable_on interval[a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g(x) <= g(y))
        ==> (\x. g(x) % f(x)) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
    ASM_REWRITE_TAC [INTEGRABLE_ON_EMPTY] THEN
    ONCE_REWRITE_TAC [INTEGRABLE_COMPONENTWISE] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\x. lift((f:real^1->real^N) x$i)",
                      ← q r"g:real^1->real", ← q r"a:real^1", ← q r"b:real^1"]
      SECOND_MEAN_VALUE_THEOREM_FULL) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [RULE_ASSUM_TAC (ONCE_REWRITE_RULE [INTEGRABLE_COMPONENTWISE]) THEN
      ASM_SIMP_TAC [],
      REWRITE_TAC [VECTOR_MUL_COMPONENT, LIFT_CMUL, integrable_on] THEN
      MESON_TAC []])

  let INTEGRABLE_INCREASING_PRODUCT_UNIV ← (do
    let lemma ← prove
     r"!f:real^1->real^1 g B.
          f integrable_on (:real^1) /\
          (!x y. drop x <= drop y ==> g x <= g y) /\
          (!x. abs(g x) <= B)
           ==> (\x. g x % f x) integrable_on (:real^1)"
     (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [INTEGRABLE_ALT_SUBSET] THEN
      REWRITE_TAC [IN_UNIV, ETA_AX] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [REPEAT GEN_TAC THEN MATCH_MP_TAC INTEGRABLE_INCREASING_PRODUCT THEN
        ASM_SIMP_TAC [],
        DISCH_TAC] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / (&8 * abs B + &8)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &8 * abs B + &8")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"C:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"~(ball(vec 0:real^1,C) = {})") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [BALL_EQ_EMPTY, REAL_NOT_LE], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1",
                           ← q r"d:real^1"] THEN
      STRIP_TAC THEN SUBGOAL_THEN
       (← q r"~(interval[a:real^1,b] = {}) /\ ~(interval[c:real^1,d] = {})")
      MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [SUBSET_INTERVAL_1]) THEN
      ASM_REWRITE_TAC [← GSYM REAL_NOT_LE] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\x. g x % (f:real^1->real^1) x",
                        ← q r"c:real^1", ← q r"b:real^1", ← q r"a:real^1"]
            INTEGRAL_COMBINE) THEN
      MP_TAC (← ISPECL [← q r"\x. g x % (f:real^1->real^1) x",
                        ← q r"c:real^1", ← q r"d:real^1", ← q r"b:real^1"]
            INTEGRAL_COMBINE) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [REAL_NOT_LE, ← NORM_ARITH
       (← q r"norm(ab - ((ca + ab) + bd):real^1) = norm(ca + bd)")] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"g:real^1->real", ← q r"c:real^1",
                        ← q r"a:real^1"]
            SECOND_MEAN_VALUE_THEOREM) THEN
      ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^1") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"g:real^1->real", ← q r"b:real^1",
                        ← q r"d:real^1"]
            SECOND_MEAN_VALUE_THEOREM) THEN
      ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:real^1") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"!x y. drop y <= drop a
            ==> norm(integral (interval[x,y]) (f:real^1->real^1))
                < e / (&4 * abs B + &4)")
       (LABEL_TAC "L")
      THENL
       [REPEAT STRIP_TAC THEN
        ASM_CASES_TAC (← q r"drop x <= drop y") THENL
         [FIRST_X_ASSUM (fun th => tactic_of do
           pure (MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"y:real^1",
                                  ← q r"b:real^1"] th) THEN
                 MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"x:real^1",
                                  ← q r"b:real^1"] th))) THEN
          ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"x:real^1", ← q r"b:real^1",
                            ← q r"y:real^1"]
            INTEGRAL_COMBINE) THEN
          ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
           [ASM_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"&2 * d = e
          ==> norm(ab - (xy + yb)) < d
              ==> norm(ab - yb) < d
                  ==> norm(xy:real^1) < e")) THEN
          CONV_TAC (fun t => REAL_FIELD t),
          SUBGOAL_THEN (← q r"interval[x:real^1,y] = {}") SUBST1_TAC THENL
           [REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN ASM_REAL_ARITH_TAC,
            REWRITE_TAC [INTEGRAL_EMPTY, NORM_0] THEN
            MATCH_MP_TAC REAL_LT_DIV THEN ASM_REAL_ARITH_TAC]],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x y. drop b <= drop x
            ==> norm(integral (interval[x,y]) (f:real^1->real^1))
                < e / (&4 * abs B + &4)")
       (LABEL_TAC "R")
      THENL
       [REPEAT STRIP_TAC THEN
        ASM_CASES_TAC (← q r"drop x <= drop y") THENL
         [FIRST_X_ASSUM (fun th => tactic_of do
           pure (MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"a:real^1",
                                  ← q r"x:real^1"] th) THEN
                 MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"a:real^1",
                                  ← q r"y:real^1"] th))) THEN
          ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"y:real^1",
                            ← q r"x:real^1"]
            INTEGRAL_COMBINE) THEN
          ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
           [ASM_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"&2 * d = e
          ==> norm(ab - (ax + xy)) < d
              ==> norm(ab - ax) < d
                  ==> norm(xy:real^1) < e")) THEN
          CONV_TAC (fun t => REAL_FIELD t),
          SUBGOAL_THEN (← q r"interval[x:real^1,y] = {}") SUBST1_TAC THENL
           [REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN ASM_REAL_ARITH_TAC,
            REWRITE_TAC [INTEGRAL_EMPTY, NORM_0] THEN
            MATCH_MP_TAC REAL_LT_DIV THEN ASM_REAL_ARITH_TAC]],
        ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"&4 * B * e / (&4 * abs B + &4)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← NORM_ARITH
         (← q r"(norm a <= e /\ norm b <= e) /\ (norm c <= e /\ norm d <= e)
        ==> norm((a + b) + (c + d):real^1) <= &4 * e")) THEN
        REWRITE_TAC [NORM_MUL] THEN CONJ_TAC THENL
         [CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
          ASM_REWRITE_TAC [NORM_POS_LE, REAL_ABS_POS] THEN
          MATCH_MP_TAC REAL_LT_IMP_LE THEN
          REMOVE_THEN "L" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
          CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
          ASM_REWRITE_TAC [NORM_POS_LE, REAL_ABS_POS] THEN
          MATCH_MP_TAC REAL_LT_IMP_LE THEN
          REMOVE_THEN "R" MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC],
        REWRITE_TAC [← REAL_ARITH
         (← q r"&4 * B * e / y < e <=> e * (&4 * B) / y < e * &1")] THEN
        ASM_SIMP_TAC [REAL_LT_LMUL_EQ, REAL_LT_LDIV_EQ,
                      ← REAL_ARITH (← q r"&0 < &4 * abs B + &4")] THEN
        REAL_ARITH_TAC])
    prove
     r"!f:real^1->real^N g B.
        f integrable_on (:real^1) /\
        (!x y. drop x <= drop y ==> g x <= g y) /\
        (!x. abs(g x) <= B)
         ==> (\x. g x % f x) integrable_on (:real^1)"
     (GEN_TAC THEN ONCE_REWRITE_TAC [INTEGRABLE_COMPONENTWISE] THEN
      REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [VECTOR_MUL_COMPONENT, LIFT_CMUL] THEN
      MATCH_MP_TAC lemma THEN EXISTS_TAC (← q r"B:real") THEN ASM_SIMP_TAC []))

  let INTEGRABLE_INCREASING ← prove
   r"!f:real^1->real^N a b.
        (!x y i. x IN interval[a,b] /\ y IN interval[a,b] /\
                 drop x <= drop y /\ 1 <= i /\ i <= dimindex(:N)
                 ==> f(x)$i <= f(y)$i)
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [INTEGRABLE_COMPONENTWISE] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM REAL_MUL_RID] THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_NUM] THEN
    MATCH_MP_TAC INTEGRABLE_INCREASING_PRODUCT THEN
    ASM_SIMP_TAC [INTEGRABLE_CONST])

  let INTEGRABLE_INCREASING_1 ← prove
   r"!f:real^1->real^1 a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_INCREASING THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [IMP_IMP, FORALL_1, DIMINDEX_1, ← GSYM drop])

  let INTEGRABLE_DECREASING_PRODUCT ← prove
   r"!f:real^1->real^N g a b.
        f integrable_on interval[a,b] /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> g(y) <= g(x))
        ==> (\x. g(x) % f(x)) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x % y:real^N = --(--x % y)")] THEN
    MATCH_MP_TAC INTEGRABLE_NEG THEN
    MATCH_MP_TAC INTEGRABLE_INCREASING_PRODUCT THEN
    ASM_REWRITE_TAC [REAL_LE_NEG2])

  let INTEGRABLE_DECREASING_PRODUCT_UNIV ← prove
   r"!f:real^1->real^N g B.
        f integrable_on (:real^1) /\
        (!x y. drop x <= drop y ==> g y <= g x) /\
        (!x. abs(g x) <= B)
         ==> (\x. g x % f x) integrable_on (:real^1)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"x % y:real^N = --(--x % y)")] THEN
    MATCH_MP_TAC INTEGRABLE_NEG THEN
    MATCH_MP_TAC INTEGRABLE_INCREASING_PRODUCT_UNIV THEN
    EXISTS_TAC (← q r"B:real") THEN ASM_REWRITE_TAC [REAL_LE_NEG2, REAL_ABS_NEG])

  let INTEGRABLE_DECREASING ← prove
   r"!f:real^1->real^N a b.
        (!x y i. x IN interval[a,b] /\ y IN interval[a,b] /\
                 drop x <= drop y /\ 1 <= i /\ i <= dimindex(:N)
                 ==> f(y)$i <= f(x)$i)
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [← GSYM VECTOR_NEG_NEG] THEN
    MATCH_MP_TAC INTEGRABLE_NEG THEN MATCH_MP_TAC INTEGRABLE_INCREASING THEN
    ASM_SIMP_TAC [VECTOR_NEG_COMPONENT, REAL_LE_NEG2])

  let INTEGRABLE_DECREASING_1 ← prove
   r"!f:real^1->real^1 a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x))
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_DECREASING THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    ASM_SIMP_TAC [IMP_IMP, FORALL_1, DIMINDEX_1, ← GSYM drop])

  pure { SECOND_MEAN_VALUE_THEOREM, SECOND_MEAN_VALUE_THEOREM_GEN_FULL,
         SECOND_MEAN_VALUE_THEOREM_GEN, SECOND_MEAN_VALUE_THEOREM_BONNET_FULL,
         SECOND_MEAN_VALUE_THEOREM_BONNET, INTEGRABLE_INCREASING_PRODUCT,
         INTEGRABLE_INCREASING_PRODUCT_UNIV, INTEGRABLE_INCREASING, INTEGRABLE_INCREASING_1,
         INTEGRABLE_DECREASING_PRODUCT, INTEGRABLE_DECREASING_PRODUCT_UNIV,
         INTEGRABLE_DECREASING, INTEGRABLE_DECREASING_1 }

/- ------------------------------------------------------------------------- -/
/- Bounded variation and variation function, for real^1->real^N functions.  -/
/- (integration.ml 16601-16925)                                             -/
/- ------------------------------------------------------------------------- -/

structure INAV where
  has_bounded_variation_on : thm
  vector_variation : thm
  VECTOR_VARIATION_DEGENERATES : thm
  HAS_BOUNDED_VARIATION_ON_INTERVAL : thm
  VECTOR_VARIATION_ON_INTERVAL : thm
  HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL : thm
  HAS_BOUNDED_VECTOR_VARIATION : thm
  HAS_BOUNDED_VARIATION_WORKS : thm
  HAS_BOUNDED_VARIATION_WORKS_ON_ELEMENTARY : thm
  HAS_BOUNDED_VARIATION_WORKS_ON_INTERVAL : thm
  HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL_GEN : thm
  HAS_BOUNDED_VECTOR_VARIATION_ON_SUBINTERVALS : thm
  HAS_BOUNDED_VARIATION_ON_EQ : thm
  VECTOR_VARIATION_EQ : thm
  HAS_BOUNDED_VARIATION_ISOMETRIC : thm
  HAS_BOUNDED_VARIATION_ISOMETRIC_COMPOSE : thm
  VECTOR_VARIATION_ISOMETRIC : thm
  VECTOR_VARIATION_ISOMETRIC_COMPOSE : thm
  HAS_BOUNDED_VARIATION_ON_TRANSLATION : thm
  VECTOR_VARIATION_TRANSLATION : thm
  HAS_BOUNDED_VARIATION_ON_COMPONENTWISE : thm
  VARIATION_EQUAL_LEMMA : thm
  HAS_BOUNDED_VARIATION_COMPARISON : thm
  HAS_BOUNDED_VARIATION_ON_LIFT_ABS : thm
  VECTOR_VARIATION_COMPARISON : thm
  VECTOR_VARIATION_COMPONENT_LE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINAV [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) (BINX : INX) : ExceptT String IO INAV := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND, INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND, INTERVAL_UPPERBOUND_1, INTERVAL_UPPERBOUND_NONEMPTY, .. } :=
        BINA
  let { ELEMENTARY_INTERVAL, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { HAS_BOUNDED_SET_VARIATION, HAS_BOUNDED_SETVARIATION_COMPARISON,
        has_bounded_setvariation_on, HAS_BOUNDED_SETVARIATION_ON_COMPONENTWISE,
        HAS_BOUNDED_SETVARIATION_ON_EQ, HAS_BOUNDED_SETVARIATION_ON_INTERVAL, set_variation,
        SET_VARIATION_DEGENERATES, SET_VARIATION_EQ, SETVARIATION_EQUAL_LEMMA, .. } := BINW
  let { HAS_BOUNDED_SETVARIATION_WORKS, HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY,
        SET_VARIATION_COMPARISON, SET_VARIATION_INTERVAL_LEMMA, SET_VARIATION_ON_ELEMENTARY,
        .. } := BINX
  let { AND_FORALL_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { IMAGE_EQ_EMPTY, IMAGE_ID, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, MEMBER_NOT_EMPTY, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_SUP_LE_EQ, SIMPLE_IMAGE_GEN, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, SUM_EQ, .. } := D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, DIST_LIFT, DIST_REFL, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, INTERVAL_NE_EMPTY, LIFT_DROP, LIFT_SUB,
        .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_SUB_COMPONENT, .. } := D.dv.dg.pt.cvx.vec4
  let { INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, new_definition, NORM_ARITH_TAC, parse_as_infix,
        REAL_ARITH_TAC, SET_RULE, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  -- @@SCOPE END

  parse_as_infix ("has_bounded_variation_on", (12, "right"))

  let has_bounded_variation_on ← new_definition
   r"(f:real^1->real^N) has_bounded_variation_on s <=>
        (\k. f(interval_upperbound k) - f(interval_lowerbound k))
        has_bounded_setvariation_on s"

  let vector_variation ← new_definition
   r"vector_variation s (f:real^1->real^N) =
  set_variation s (\k. f(interval_upperbound k) - f(interval_lowerbound k))"

  let VECTOR_VARIATION_DEGENERATES ← prove
   r"!f:real^1->real^N g s.
        ~(f has_bounded_variation_on s) /\
        ~(g has_bounded_variation_on s)
        ==> vector_variation s f = vector_variation s g"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    REWRITE_TAC [SET_VARIATION_DEGENERATES])

  let HAS_BOUNDED_VARIATION_ON_INTERVAL ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b] <=>
        ?B. !d. d division_of interval[a,b]
                ==> sum d (\k. norm(f(interval_upperbound k) -
                                    f(interval_lowerbound k))) <= B"
   (REWRITE_TAC [has_bounded_variation_on,
                 HAS_BOUNDED_SETVARIATION_ON_INTERVAL])

  let VECTOR_VARIATION_ON_INTERVAL ← prove
   r"!f:real^1->real^N a b.
        vector_variation (interval[a,b]) f =
        sup {sum d (\k. norm(f(interval_upperbound k) -
                             f(interval_lowerbound k))) |
             d division_of interval[a,b]}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [vector_variation] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SET_VARIATION_ON_ELEMENTARY o
      lhand o snd) THEN
    REWRITE_TAC [ELEMENTARY_INTERVAL])

  let HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL ← prove
   r"!f:real^1->real^N a b c.
        f has_bounded_variation_on interval[a,b] /\
        vector_variation (interval[a,b]) f <= c <=>
        !d. d division_of interval[a,b]
                ==> sum d (\k. norm(f(interval_upperbound k) -
                                    f(interval_lowerbound k))) <= c"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_INTERVAL,
                 VECTOR_VARIATION_ON_INTERVAL] THEN
    MATCH_MP_TAC (← TAUT (← q r"(r ==> p) /\ (p ==> (q <=> r)) ==> (p /\ q <=> r)")) THEN
    CONJ_TAC THENL [MESON_TAC [], DISCH_TAC] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) REAL_SUP_LE_EQ o lhand o snd) THEN
    ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN DISCH_THEN MATCH_MP_TAC THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM, ELEMENTARY_INTERVAL])

  let HAS_BOUNDED_VECTOR_VARIATION ← prove
   r"!f:real^1->real^N s c.
        f has_bounded_variation_on s /\ vector_variation s f <= c <=>
        !d t. d division_of t /\ t SUBSET s
              ==> sum d (\k. norm(f(interval_upperbound k) -
                                  f(interval_lowerbound k))) <= c"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    REWRITE_TAC [HAS_BOUNDED_SET_VARIATION])

  let HAS_BOUNDED_VARIATION_WORKS ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s
        ==> (!d t. d division_of t /\ t SUBSET s
                   ==> sum d (\k. norm(f(interval_upperbound k) -
                                       f(interval_lowerbound k))) <=
                       vector_variation s f) /\
            (!B. (!d t. d division_of t /\ t SUBSET s
                        ==> sum d (\k. norm(f(interval_upperbound k) -
                                       f(interval_lowerbound k))) <= B)
                   ==> vector_variation s f <= B)"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation,
                 HAS_BOUNDED_SETVARIATION_WORKS])

  let HAS_BOUNDED_VARIATION_WORKS_ON_ELEMENTARY ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s /\ (?d. d division_of s)
        ==> (!d. d division_of s
                 ==> sum d (\k. norm(f(interval_upperbound k) -
                                     f(interval_lowerbound k))) <=
                     vector_variation s f) /\
            (!B. (!d. d division_of s
                      ==> sum d (\k. norm(f(interval_upperbound k) -
                                     f(interval_lowerbound k))) <= B)
                  ==> vector_variation s f <= B)"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation,
                 HAS_BOUNDED_SETVARIATION_WORKS_ON_ELEMENTARY])

  let HAS_BOUNDED_VARIATION_WORKS_ON_INTERVAL ← prove
   r"!f:real^1->real^N.
        f has_bounded_variation_on interval[a,b]
        ==> (!d. d division_of interval[a,b]
                 ==> sum d (\k. norm(f(interval_upperbound k) -
                                     f(interval_lowerbound k))) <=
                     vector_variation (interval[a,b]) f) /\
            (!B. (!d. d division_of interval[a,b]
                      ==> sum d (\k. norm(f(interval_upperbound k) -
                                     f(interval_lowerbound k))) <= B)
                  ==> vector_variation (interval[a,b]) f <= B)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_WORKS_ON_ELEMENTARY THEN
    ASM_MESON_TAC [ELEMENTARY_INTERVAL])

  let HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL_GEN ← prove
   r"!f:real^1->real^N s c.
        is_interval s
        ==> (f has_bounded_variation_on s /\ vector_variation s f <= c <=>
            !d a b. d division_of interval[a,b] /\ interval[a,b] SUBSET s
                    ==> sum d (\k. norm(f(interval_upperbound k) -
                                        f(interval_lowerbound k))) <= c)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION] THEN
    MATCH_MP_TAC SET_VARIATION_INTERVAL_LEMMA THEN
    ASM_REWRITE_TAC [])

  let HAS_BOUNDED_VECTOR_VARIATION_ON_SUBINTERVALS ← prove
   r"!f:real^1->real^N s c.
        is_interval s
        ==> (f has_bounded_variation_on s /\ vector_variation s f <= c <=>
             !a b. interval[a,b] SUBSET s
                   ==> f has_bounded_variation_on interval[a,b] /\
                       vector_variation (interval[a,b]) f <= c)"
   (REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL] THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL_GEN] THEN
    MESON_TAC [])

  let HAS_BOUNDED_VARIATION_ON_EQ ← prove
   r"!f g:real^1->real^N s.
        (!x. x IN s ==> f x = g x) /\ f has_bounded_variation_on s
        ==> g has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_SETVARIATION_ON_EQ) THEN
    SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND,
              ← GSYM INTERVAL_NE_EMPTY] THEN
    ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET])

  let VECTOR_VARIATION_EQ ← prove
   r"!f g:real^1->real^N s.
        (!x. x IN s ==> f x = g x)
        ==> vector_variation s f = vector_variation s g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [vector_variation] THEN
    MATCH_MP_TAC SET_VARIATION_EQ THEN
    SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND,
              ← GSYM INTERVAL_NE_EMPTY] THEN
    ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET])

  let HAS_BOUNDED_VARIATION_ISOMETRIC ← prove
   r"!f g:real^1->real^N s.
        (!x y. dist(f x,f y) = dist(g x,g y))
        ==> (f has_bounded_variation_on s <=> g has_bounded_variation_on s)"
   (SIMP_TAC [has_bounded_variation_on, has_bounded_setvariation_on,
              o_DEF, dist])

  let HAS_BOUNDED_VARIATION_ISOMETRIC_COMPOSE ← prove
   r"!f:real^M->real^N g s.
        (!x y. dist(f x,f y) = dist(x,y))
        ==> ((f o g) has_bounded_variation_on s <=>
             g has_bounded_variation_on s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_BOUNDED_VARIATION_ISOMETRIC THEN
    ASM_REWRITE_TAC [o_DEF])

  let VECTOR_VARIATION_ISOMETRIC ← prove
   r"!f g:real^1->real^N s.
        (!x y. dist(f x,f y) = dist(g x,g y))
        ==> vector_variation s f = vector_variation s g"
   (SIMP_TAC [vector_variation, set_variation, o_DEF, dist])

  let VECTOR_VARIATION_ISOMETRIC_COMPOSE ← prove
   r"!f:real^M->real^N g s.
        (!x y. dist(f x,f y) = dist(x,y))
        ==> vector_variation s (f o g) = vector_variation s g"
   (SIMP_TAC [vector_variation, set_variation, o_DEF, dist])

  let HAS_BOUNDED_VARIATION_ON_TRANSLATION ← prove
   r"!f:real^1->real^N s a.
   (\x. a + f x) has_bounded_variation_on s <=> f has_bounded_variation_on s"
   (REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  let VECTOR_VARIATION_TRANSLATION ← prove
   r"!f:real^1->real^N s a.
        vector_variation s (\x. a + f x) = vector_variation s f"
   (REWRITE_TAC [vector_variation] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  let HAS_BOUNDED_VARIATION_ON_COMPONENTWISE ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift(f x$i)) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    GEN_REWRITE_TAC LAND_CONV [HAS_BOUNDED_SETVARIATION_ON_COMPONENTWISE] THEN
    REWRITE_TAC [VECTOR_SUB_COMPONENT, LIFT_SUB])

  let VARIATION_EQUAL_LEMMA ← prove
   r"!ms ms'.
        (!s. ms'(ms s) = s /\ ms(ms' s) = s) /\
        (!d t. d division_of t
               ==> (IMAGE (IMAGE ms) d) division_of IMAGE ms t /\
                   (IMAGE (IMAGE ms') d) division_of IMAGE ms' t) /\
        (!a b. ~(interval[a,b] = {})
               ==> IMAGE ms' (interval [a,b]) = interval[ms' a,ms' b] \/
                   IMAGE ms' (interval [a,b]) = interval[ms' b,ms' a])
   ==> (!f:real^1->real^N s.
            (\x. f(ms' x)) has_bounded_variation_on (IMAGE ms s) <=>
            f has_bounded_variation_on s) /\
       (!f:real^1->real^N s.
            vector_variation (IMAGE ms s) (\x. f(ms' x)) =
            vector_variation s f)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"f:real^1->real^N") THEN
    MP_TAC (← ISPECL
     [← q r"\f k. (f:(real^1->bool)->real^N) (IMAGE (ms':real^1->real^1) k)",
      ← q r"IMAGE (ms:real^1->real^1)",
      ← q r"IMAGE (ms':real^1->real^1)"]
    SETVARIATION_EQUAL_LEMMA) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [← GSYM IMAGE_o, o_DEF, IMAGE_ID, IMAGE_SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [IMAGE_EQ_EMPTY],
      ALL_TAC] THEN
    REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [AND_FORALL_THM] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"\k. (f:real^1->real^N) (interval_upperbound k) -
                     f (interval_lowerbound k)") th))) THEN
    REWRITE_TAC [] THEN DISCH_THEN (fun th => tactic_of do
      pure (ONCE_REWRITE_TAC [← GSYM th])) THEN
    GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:real^1->bool") THEN
    REWRITE_TAC [has_bounded_setvariation_on, set_variation] THEN
    CONJ_TAC THENL
     [REPLICATE_TAC 3 (AP_TERM_TAC THEN ABS_TAC) THEN
      REWRITE_TAC [← TAUT (← q r"((p ==> q) <=> (p ==> r)) <=> p ==> (q <=> r)")] THEN
      STRIP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC,
      AP_TERM_TAC THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}")) THEN
      GEN_TAC THEN STRIP_TAC] THEN
    MATCH_MP_TAC SUM_EQ THEN FIRST_ASSUM (fun th => tactic_of do
     pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"IMAGE f s = s' ==> ~(s = {}) ==> IMAGE f s = s' /\ ~(s' = {})"))) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
    ASM_SIMP_TAC [INTERVAL_UPPERBOUND_1, INTERVAL_LOWERBOUND_1] THEN
    NORM_ARITH_TAC)

  let HAS_BOUNDED_VARIATION_COMPARISON ← prove
   r"!f:real^1->real^M g:real^1->real^N s.
        f has_bounded_variation_on s /\
        (!x y. x IN s /\ y IN s /\ drop x < drop y
               ==> dist(g x,g y) <= dist(f x,f y))
        ==> g has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     HAS_BOUNDED_SETVARIATION_COMPARISON) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM dist] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s
          ==> dist((g:real^1->real^N) x,g y)
              <= dist((f:real^1->real^M) x,f y)")
    MATCH_MP_TAC THENL
     [REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [DIST_REFL, REAL_LE_REFL] THEN
      CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN ASM_MESON_TAC [],
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                    INTERVAL_UPPERBOUND_NONEMPTY] THEN
      ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET]])

  let HAS_BOUNDED_VARIATION_ON_LIFT_ABS ← prove
   r"!f:real^1->real.
        (\x. lift(f x)) has_bounded_variation_on s
        ==> (\x. lift(abs(f x))) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      HAS_BOUNDED_VARIATION_COMPARISON) THEN
    REWRITE_TAC [DIST_LIFT] THEN REAL_ARITH_TAC)

  let VECTOR_VARIATION_COMPARISON ← prove
   r"!f:real^1->real^M g:real^1->real^N s.
        f has_bounded_variation_on s /\
        (!x y. x IN s /\ y IN s /\ drop x < drop y
               ==> dist(g x,g y) <= dist(f x,f y))
        ==> vector_variation s g <= vector_variation s f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [vector_variation] THEN
    MATCH_MP_TAC SET_VARIATION_COMPARISON THEN
    ASM_REWRITE_TAC [← GSYM has_bounded_variation_on] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM dist] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s
          ==> dist((g:real^1->real^N) x,g y)
              <= dist((f:real^1->real^M) x,f y)")
    MATCH_MP_TAC THENL
     [REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [DIST_REFL, REAL_LE_REFL] THEN
      CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN ASM_MESON_TAC [],
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                    INTERVAL_UPPERBOUND_NONEMPTY] THEN
      ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET]])

  let VECTOR_VARIATION_COMPONENT_LE ← prove
   r"!f:real^1->real^N s i.
        f has_bounded_variation_on s
        ==> vector_variation s (\x. lift(f x$i)) <= vector_variation s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_COMPARISON THEN
    ASM_REWRITE_TAC [DIST_LIFT] THEN
    REWRITE_TAC [dist, ← GSYM VECTOR_SUB_COMPONENT, COMPONENT_LE_NORM])

  pure { has_bounded_variation_on, vector_variation, VECTOR_VARIATION_DEGENERATES,
         HAS_BOUNDED_VARIATION_ON_INTERVAL, VECTOR_VARIATION_ON_INTERVAL,
         HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL, HAS_BOUNDED_VECTOR_VARIATION,
         HAS_BOUNDED_VARIATION_WORKS, HAS_BOUNDED_VARIATION_WORKS_ON_ELEMENTARY,
         HAS_BOUNDED_VARIATION_WORKS_ON_INTERVAL, HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL_GEN,
         HAS_BOUNDED_VECTOR_VARIATION_ON_SUBINTERVALS, HAS_BOUNDED_VARIATION_ON_EQ,
         VECTOR_VARIATION_EQ, HAS_BOUNDED_VARIATION_ISOMETRIC,
         HAS_BOUNDED_VARIATION_ISOMETRIC_COMPOSE, VECTOR_VARIATION_ISOMETRIC,
         VECTOR_VARIATION_ISOMETRIC_COMPOSE, HAS_BOUNDED_VARIATION_ON_TRANSLATION,
         VECTOR_VARIATION_TRANSLATION, HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
         VARIATION_EQUAL_LEMMA, HAS_BOUNDED_VARIATION_COMPARISON,
         HAS_BOUNDED_VARIATION_ON_LIFT_ABS, VECTOR_VARIATION_COMPARISON,
         VECTOR_VARIATION_COMPONENT_LE }

/- ------------------------------------------------------------------------- -/
/- Algebra of bounded variation; boundedness; variation bounds.             -/
/- (integration.ml 16926-17368)                                             -/
/- ------------------------------------------------------------------------- -/

structure INAW where
  VECTOR_VARIATION_LIFT_ABS : thm
  HAS_BOUNDED_VARIATION_ON_SUBSET : thm
  HAS_BOUNDED_VARIATION_ON_CONST : thm
  VECTOR_VARIATION_CONST : thm
  HAS_BOUNDED_VARIATION_ON_CMUL : thm
  HAS_BOUNDED_VARIATION_ON_CMUL_EQ : thm
  HAS_BOUNDED_VARIATION_ON_VMUL_EQ : thm
  HAS_BOUNDED_VARIATION_ON_VMUL : thm
  VECTOR_VARIATION_CMUL : thm
  VECTOR_VARIATION_VMUL : thm
  HAS_BOUNDED_VARIATION_ON_NEG : thm
  HAS_BOUNDED_VARIATION_ON_ADD : thm
  HAS_BOUNDED_VARIATION_ON_SUB : thm
  HAS_BOUNDED_VARIATION_ON_COMPOSE_LINEAR : thm
  HAS_BOUNDED_VARIATION_ON_NULL : thm
  HAS_BOUNDED_VARIATION_ON_EMPTY : thm
  VECTOR_VARIATION_ON_NULL : thm
  VECTOR_VARIATION_ON_EMPTY : thm
  VECTOR_VARIATION_SING : thm
  HAS_BOUNDED_VARIATION_ON_NORM : thm
  HAS_BOUNDED_VARIATION_ON_MAX : thm
  HAS_BOUNDED_VARIATION_ON_MIN : thm
  BOUNDED_VECTOR_VARIATION_ON_PASTECART : thm
  BOUNDED_VARIATION_FROM_PASTECART : thm
  HAS_BOUNDED_VARIATION_ON_PASTECART : thm
  HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS : thm
  HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED : thm
  HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL : thm
  HAS_BOUNDED_VARIATION_ON_BILINEAR : thm
  HAS_BOUNDED_VARIATION_ON_MUL : thm
  VECTOR_VARIATION_POS_LE : thm
  VECTOR_VARIATION_GE_NORM_FUNCTION : thm
  VECTOR_VARIATION_GE_DROP_FUNCTION : thm
  VECTOR_VARIATION_CONST_EQ : thm
  VECTOR_VARIATION_MONOTONE : thm
  VECTOR_VARIATION_NEG : thm
  VECTOR_VARIATION_TRIANGLE : thm
  HAS_BOUNDED_VARIATION_ON_VSUM : thm
  VECTOR_VARIATION_SUM_LE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINAW [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) (BINX : INX) (BINY : INY) (BINAV : INAV) : ExceptT String IO INAW := do
  -- @@SCOPE BEGIN
  let { CONTENT_EMPTY, CONTENT_EQ_0_1, INTERVAL_BOUNDS_NULL_1, INTERVAL_LOWERBOUND_1,
        INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_1, INTERVAL_UPPERBOUND_NONEMPTY,
        .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { has_bounded_setvariation_on, HAS_BOUNDED_SETVARIATION_ON_0,
        HAS_BOUNDED_SETVARIATION_ON_ADD, HAS_BOUNDED_SETVARIATION_ON_CMUL,
        HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR,
        HAS_BOUNDED_SETVARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS,
        HAS_BOUNDED_SETVARIATION_ON_NEG, HAS_BOUNDED_SETVARIATION_ON_SUB,
        HAS_BOUNDED_SETVARIATION_ON_SUBSET, set_variation, SET_VARIATION_0, .. } := BINW
  let { HAS_BOUNDED_SETVARIATION_ON_NULL, SET_VARIATION_CMUL, SET_VARIATION_GE_FUNCTION,
        SET_VARIATION_ON_EMPTY, SET_VARIATION_ON_NULL, SET_VARIATION_POS_LE,
        SET_VARIATION_TRIANGLE, .. } := BINX
  let { SET_VARIATION_MONOTONE, .. } := BINY
  let { HAS_BOUNDED_VARIATION_COMPARISON, HAS_BOUNDED_VARIATION_ISOMETRIC,
        has_bounded_variation_on, HAS_BOUNDED_VARIATION_WORKS, HAS_BOUNDED_VECTOR_VARIATION,
        vector_variation, VECTOR_VARIATION_COMPARISON, VECTOR_VARIATION_EQ,
        VECTOR_VARIATION_ISOMETRIC, .. } := BINAV
  let { AND_FORALL_THM, CONJ_ASSOC, EQ_TRANS, ETA_AX, FINITE_INDUCT_STRONG, FORALL_IN_GSPEC,
        .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES, IMP_CONJ, IMP_CONJ_ALT, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, .. }
        := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_LADD, REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_SYM, REAL_NOT_LT, REAL_WLOG_LE, SUBSET, SUBSET_TRANS, .. }
        := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_ADD, SUM_CLAUSES, SUM_LE, SUM_LMUL, .. } := D.dv.dg.pt.cvx.core6
  let { DIST_LIFT, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_SUB, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, INTERVAL_SING, LIFT_ADD,
        LIFT_CMUL, LIFT_DROP, LIFT_SUB, LINEAR_SUB, NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, NORM_SUB, REAL_ABS_NORM, .. } :=
        D.dv.dg.pt.cvx.vec3
  let { dist, drop, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB_LDISTRIB,
        VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL, VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_EMPTY, BOUNDED_POS_LT, BOUNDED_SUBSET, .. } := D.dv.dg.pt.cvx.top1
  let { INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, INTERVAL_SUBSET_IS_INTERVAL,
        IS_INTERVAL_INTERVAL, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, SEGMENT_1, SEGMENT_SYM, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON, MESON_TAC, NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH,
        REAL_ARITH_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { CONVEX_CONTAINS_SEGMENT, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { BILINEAR_BOUNDED_POS, BILINEAR_DROP_MUL, BILINEAR_LSUB, BILINEAR_RSUB, .. } :=
        D.dv.qvec
  let { BOUNDED_SING, .. } := D.qtopology
  let { DIST_LE_PASTECART, DIST_PASTECART_LE, NORM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let VECTOR_VARIATION_LIFT_ABS ← prove
   r"!f:real^1->real s.
        (\x. lift(f x)) has_bounded_variation_on s
        ==> vector_variation s (\x. lift(abs(f x)))
            <= vector_variation s (\x. lift(f x))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_COMPARISON THEN
    ASM_REWRITE_TAC [DIST_LIFT] THEN REAL_ARITH_TAC)

  let HAS_BOUNDED_VARIATION_ON_SUBSET ← prove
   r"!f:real^1->real^N s t.
        f has_bounded_variation_on s /\ t SUBSET s
        ==> f has_bounded_variation_on t"
   (REWRITE_TAC [HAS_BOUNDED_SETVARIATION_ON_SUBSET, has_bounded_variation_on])

  let HAS_BOUNDED_VARIATION_ON_CONST ← prove
   r"!s c:real^N. (\x. c) has_bounded_variation_on s"
   (REWRITE_TAC [has_bounded_variation_on, VECTOR_SUB_REFL,
                 HAS_BOUNDED_SETVARIATION_ON_0])

  let VECTOR_VARIATION_CONST ← prove
   r"!s c:real^N. vector_variation s (\x. c) = &0"
   (REWRITE_TAC [vector_variation, VECTOR_SUB_REFL, SET_VARIATION_0])

  let HAS_BOUNDED_VARIATION_ON_CMUL ← prove
   r"!f:real^1->real^N c s.
        f has_bounded_variation_on s
        ==> (\x. c % f x) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, HAS_BOUNDED_SETVARIATION_ON_CMUL])

  let HAS_BOUNDED_VARIATION_ON_CMUL_EQ ← prove
   r"!f:real^1->real^N c s.
        (\x. c % f x) has_bounded_variation_on s <=>
        c = &0 \/ f has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, HAS_BOUNDED_VARIATION_ON_CONST] THEN
    EQ_TAC THEN REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_CMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c:real)") o MATCH_MP
       HAS_BOUNDED_VARIATION_ON_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_LINV, ETA_AX])

  let HAS_BOUNDED_VARIATION_ON_VMUL_EQ ← prove
   r"!f s v:real^N.
        (\x. f(x) % v) has_bounded_variation_on s <=>
        v = vec 0 \/ (\x. lift(f x)) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"(\x. norm(v:real^N) % lift(f x)) has_bounded_variation_on s") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HAS_BOUNDED_VARIATION_ISOMETRIC THEN
      REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, ← GSYM VECTOR_SUB_RDISTRIB] THEN
      REWRITE_TAC [NORM_MUL, ← GSYM LIFT_SUB, NORM_LIFT, REAL_ABS_NORM] THEN
      REWRITE_TAC [REAL_MUL_SYM],
      REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_CMUL_EQ, NORM_EQ_0]])

  let HAS_BOUNDED_VARIATION_ON_VMUL ← prove
   r"!f s v:real^N.
        (\x. lift(f x)) has_bounded_variation_on s
        ==> (\x. f(x) % v) has_bounded_variation_on s"
   (SIMP_TAC [HAS_BOUNDED_VARIATION_ON_VMUL_EQ])

  let VECTOR_VARIATION_CMUL ← prove
   r"!f:real^1->real^N s c.
        f has_bounded_variation_on s
        ==> vector_variation s (\x. c % f x) = abs c * vector_variation s f"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, SET_VARIATION_CMUL])

  let VECTOR_VARIATION_VMUL ← prove
   r"!f s v:real^N.
        (\x. lift(f x)) has_bounded_variation_on s
        ==> vector_variation s (\x. f(x) % v) =
            norm(v) * vector_variation s (\x. lift(f x))"
   (ONCE_REWRITE_TAC [← GSYM REAL_ABS_NORM] THEN
    SIMP_TAC [← GSYM VECTOR_VARIATION_CMUL] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_ISOMETRIC THEN
    REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, ← GSYM VECTOR_SUB_RDISTRIB] THEN
    REWRITE_TAC [NORM_MUL, ← GSYM LIFT_SUB, NORM_LIFT, REAL_ABS_NORM] THEN
    REWRITE_TAC [REAL_MUL_SYM])

  let HAS_BOUNDED_VARIATION_ON_NEG ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s
        ==> (\x. --f x) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a - --b:real^N = --(a - b)"),
                 HAS_BOUNDED_SETVARIATION_ON_NEG])

  let HAS_BOUNDED_VARIATION_ON_ADD ← prove
   r"!f g:real^1->real^N s.
        f has_bounded_variation_on s /\ g has_bounded_variation_on s
        ==> (\x. f x + g x) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(f + g) - (f' + g'):real^N = (f - f') + (g - g')"),
                 HAS_BOUNDED_SETVARIATION_ON_ADD])

  let HAS_BOUNDED_VARIATION_ON_SUB ← prove
   r"!f g:real^1->real^N s.
        f has_bounded_variation_on s /\ g has_bounded_variation_on s
        ==> (\x. f x - g x) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(f - g) - (f' - g'):real^N = (f - f') - (g - g')"),
                 HAS_BOUNDED_SETVARIATION_ON_SUB])

  let HAS_BOUNDED_VARIATION_ON_COMPOSE_LINEAR ← prove
   r"!f:real^1->real^M g:real^M->real^N s.
        f has_bounded_variation_on s /\ linear g
        ==> (g o f) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    SIMP_TAC [o_THM, ← GSYM LINEAR_SUB] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_SETVARIATION_ON_COMPOSE_LINEAR) THEN
    REWRITE_TAC [o_DEF])

  let HAS_BOUNDED_VARIATION_ON_NULL ← prove
   r"!f:real^1->real^N s.
        content s = &0 /\ bounded s ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    MATCH_MP_TAC HAS_BOUNDED_SETVARIATION_ON_NULL THEN
    ASM_SIMP_TAC [INTERVAL_BOUNDS_NULL_1, VECTOR_SUB_REFL])

  let HAS_BOUNDED_VARIATION_ON_EMPTY ← prove
   r"!f:real^1->real^N. f has_bounded_variation_on {}"
   (MESON_TAC [CONTENT_EMPTY, BOUNDED_EMPTY, HAS_BOUNDED_VARIATION_ON_NULL])

  let VECTOR_VARIATION_ON_NULL ← prove
   r"!f s. content s = &0 /\ bounded s ==> vector_variation s f = &0"
