      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"l % x:real^1", ← q r"l % y:real^1"]) THEN
      REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, IN_INTERVAL_1, DROP_VEC] THEN
