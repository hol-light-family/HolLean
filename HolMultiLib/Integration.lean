@[nospecialize]
def setupINAY [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) : ExceptT String IO INAY := do
  -- @@SCOPE BEGIN
