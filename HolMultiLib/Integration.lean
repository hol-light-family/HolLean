             f absolutely_continuous_on s)"
   (MESON_TAC [ABSOLUTELY_CONTINUOUS_ON_CLOSURE, CLOSURE_SUBSET,
               ABSOLUTELY_CONTINUOUS_ON_SUBSET, INTERIOR_SUBSET])

