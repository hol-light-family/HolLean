structure INBW where
  rectifiable_path : thm
  path_length : thm
  RECTIFIABLE_PATH_LIPSCHITZ_IMAGE : thm
  RECTIFIABLE_PATH_TRANSLATION_EQ : thm
  RECTIFIABLE_PATH_LINEAR_IMAGE_EQ : thm
  PATH_LENGTH_TRANSLATION : thm
  PATH_LENGTH_ISOMETRIC_IMAGE : thm
  PATH_LENGTH_LINEAR_IMAGE : thm
  RECTIFIABLE_PATH_EQ : thm
  PATH_LENGTH_EQ : thm
  PATH_LENGTH_SCALING : thm
  BOUNDED_RECTIFIABLE_PATH_IMAGE : thm
  RECTIFIABLE_PATH_IMP_PATH : thm
  RECTIFIABLE_PATH_LINEPATH : thm
  RECTIFIABLE_PATH_REVERSEPATH : thm
  PATH_LENGTH_REVERSEPATH : thm
  RECTIFIABLE_PATH_SUBPATH_EQ : thm
  PATH_LENGTH_SUBPATH : thm
  RECTIFIABLE_PATH_SUBPATH : thm
  RECTIFIABLE_PATH_JOIN : thm
  RECTIFIABLE_PATH_JOIN_IMP : thm
  RECTIFIABLE_PATH_JOIN_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBW [HolBase] (D : IntegrationDeps) (BINW : INW) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) (BINAY : INAY) (BINBB : INBB) (BINBC : INBC) (BINBD : INBD) : ExceptT String IO INBW := do
  -- @@SCOPE BEGIN
  let { set_variation, .. } := BINW
  let { has_bounded_variation_on, HAS_BOUNDED_VARIATION_ON_EQ, vector_variation,
        VECTOR_VARIATION_EQ, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_ADD, HAS_BOUNDED_VARIATION_ON_COMPOSE_LINEAR,
        HAS_BOUNDED_VARIATION_ON_CONST, HAS_BOUNDED_VARIATION_ON_MUL,
        HAS_BOUNDED_VARIATION_ON_SUB, HAS_BOUNDED_VARIATION_ON_SUBSET,
        VECTOR_VARIATION_CMUL, VECTOR_VARIATION_SING, .. } := BINAW
  let { HAS_BOUNDED_VARIATION_ON_SING, .. } := BINAX
  let { HAS_BOUNDED_VARIATION_ON_COMBINE, .. } := BINAY
  let { HAS_BOUNDED_VARIATION_AFFINITY_EQ, VECTOR_VARIATION_AFFINITY,
        VECTOR_VARIATION_REFLECT, VECTOR_VARIATION_TRANSLATION_ALT, .. } := BINBB
  let { HAS_BOUNDED_VARIATION_COMPOSE_DECREASING, .. } := BINBC
  let { HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE, HAS_BOUNDED_VARIATION_ON_ID, .. } := BINBD
  let { EQ_TRANS, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, .. } := D.dv.dg.pt.cvx.core2
  let { MONO_AND, PAIR_EQ, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_SUB_0, REAL_SUB_LE, .. } := D.dv.dg.pt.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP,
        LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_ADD_SYM, VECTOR_SUB, VECTOR_SUB_EQ, VECTOR_SUB_REFL, VECTOR_SUB_RZERO,
        .. } := D.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, IS_INTERVAL_INTERVAL, .. } :=
        D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, SEGMENT_REFL, UNIT_INTERVAL_NONEMPTY, .. } := D.dv.dg.pt.cvx.top5
  let { add_linear_invariants, add_translation_invariants, ASM_MESON_TAC,
        ASM_REAL_ARITH_TAC, MESON, MESON_TAC, new_definition, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { BOUNDED_PATH_IMAGE, .. } := D.dv.dg.qpaths1
  let { joinpaths, path_image, PATH_JOIN, PATH_LINEPATH, PATH_REVERSEPATH, pathfinish,
        pathstart, .. } := D.dv.dg.qpaths2
  let { I_O_ID, .. } := D.dv.dg.qsession
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { linepath, PATH_CONTINUOUS_IMAGE, PATH_EQ, PATH_JOIN_PATH_ENDS, PATH_LINEAR_IMAGE_EQ,
        PATH_SUBPATH, PATH_TRANSLATION_EQ, reversepath, REVERSEPATH_REVERSEPATH, subpath, ..
        } := D.qpaths
  let { CONS_11, .. } := D.qsession
  let { IMAGE_AFFINITY_INTERVAL, INTERVAL_TRANSLATION, LIPSCHITZ_IMP_CONTINUOUS_ON, .. } :=
        D.qtopology
  let { PRESEVES_NORM_PRESERVES_DIST, REFLECT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let rectifiable_path ← new_definition
   r"rectifiable_path (g:real^1->real^N) <=>
    path g /\ g has_bounded_variation_on interval[vec 0,vec 1]"

  let path_length ← new_definition
   r"path_length (g:real^1->real^N) =
  vector_variation (interval[vec 0,vec 1]) g"

  let RECTIFIABLE_PATH_LIPSCHITZ_IMAGE ← prove
   r"!f:real^M->real^N g.
        rectifiable_path g /\
        (?B. !x y. x IN path_image g /\ y IN path_image g
                   ==> norm(f x - f y) <= B * norm(x - y))
        ==> rectifiable_path(f o g)"
   (REWRITE_TAC [rectifiable_path] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [LIPSCHITZ_IMP_CONTINUOUS_ON],
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE THEN
      ASM_REWRITE_TAC [← GSYM path_image] THEN ASM_MESON_TAC []])

  let RECTIFIABLE_PATH_TRANSLATION_EQ ← prove
   r"!a:real^N g. rectifiable_path((\x. a + x) o g) <=> rectifiable_path g"
   (REWRITE_TAC [rectifiable_path, has_bounded_variation_on, o_THM] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [PATH_TRANSLATION_EQ] THEN AP_TERM_TAC THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  add_translation_invariants [RECTIFIABLE_PATH_TRANSLATION_EQ]

  let RECTIFIABLE_PATH_LINEAR_IMAGE_EQ ← prove
   r"!f:real^M->real^N g.
        linear f /\ (!x y. f x = f y ==> x = y)
        ==> (rectifiable_path(f o g) <=> rectifiable_path g)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [rectifiable_path] THEN BINOP_TAC THENL
     [ASM_MESON_TAC [PATH_LINEAR_IMAGE_EQ], ALL_TAC] THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"h:real^N->real^M") STRIP_ASSUME_TAC o
          MATCH_MP LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"g:real^1->real^M = h o (f:real^M->real^N) o g")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [o_ASSOC, I_O_ID], ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_COMPOSE_LINEAR THEN
    ASM_REWRITE_TAC [])

  add_linear_invariants [RECTIFIABLE_PATH_LINEAR_IMAGE_EQ]

  let PATH_LENGTH_TRANSLATION ← prove
   r"!a g:real^1->real^N. path_length((\x. a + x) o g) = path_length g"
   (REWRITE_TAC [path_length, vector_variation, o_THM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  add_translation_invariants [PATH_LENGTH_TRANSLATION]

  let PATH_LENGTH_ISOMETRIC_IMAGE ← prove
   r"!f:real^M->real^N g.
     (!x y. dist(f x,f y) = dist(x,y)) ==> path_length(f o g) = path_length g"
   (SIMP_TAC [path_length, vector_variation, set_variation, o_THM, dist])

  let PATH_LENGTH_LINEAR_IMAGE ← prove
   r"!f:real^M->real^N g.
        linear f /\ (!x. norm(f x) = norm x)
        ==> path_length(f o g) = path_length g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_LENGTH_ISOMETRIC_IMAGE THEN
    ASM_MESON_TAC [PRESEVES_NORM_PRESERVES_DIST])

  add_linear_invariants [PATH_LENGTH_LINEAR_IMAGE]

  let RECTIFIABLE_PATH_EQ ← prove
   r"!p q:real^1->real^N.
        (!t. t IN interval[vec 0,vec 1] ==> p t = q t) /\ rectifiable_path p
        ==> rectifiable_path q"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [rectifiable_path] THEN
    ASM_MESON_TAC [PATH_EQ, HAS_BOUNDED_VARIATION_ON_EQ])

  let PATH_LENGTH_EQ ← prove
   r"!p q:real^1->real^N.
        (!t. t IN interval[vec 0,vec 1] ==> p t = q t)
        ==> path_length p = path_length q"
   (REWRITE_TAC [path_length] THEN MESON_TAC [VECTOR_VARIATION_EQ])

  let PATH_LENGTH_SCALING ← prove
   r"!g:real^1->real^N c.
        rectifiable_path g
        ==> path_length ((\x. c % x) o g) = abs c * path_length g"
   (REWRITE_TAC [rectifiable_path, path_length, o_THM] THEN
    REWRITE_TAC [IMP_CONJ, o_DEF, VECTOR_VARIATION_CMUL])

  let BOUNDED_RECTIFIABLE_PATH_IMAGE ← prove
   r"!g:real^1->real^N. rectifiable_path g ==> bounded(path_image g)"
   (SIMP_TAC [rectifiable_path, BOUNDED_PATH_IMAGE])

  let RECTIFIABLE_PATH_IMP_PATH ← prove
   r"!g:real^1->real^N. rectifiable_path g ==> path g"
   (SIMP_TAC [rectifiable_path])

  let RECTIFIABLE_PATH_LINEPATH ← prove
   r"!a b:real^N. rectifiable_path(linepath(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [rectifiable_path, PATH_LINEPATH] THEN
    REWRITE_TAC [linepath] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_ADD THEN
    REWRITE_TAC [← GSYM DROP_VEC, ← GSYM DROP_SUB] THEN
    CONJ_TAC THEN MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_MUL THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_CONST] THEN
    SIMP_TAC [HAS_BOUNDED_VARIATION_ON_ID, BOUNDED_INTERVAL] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUB THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_CONST] THEN
    SIMP_TAC [HAS_BOUNDED_VARIATION_ON_ID, BOUNDED_INTERVAL])

  let RECTIFIABLE_PATH_REVERSEPATH ← prove
   r"!g:real^1->real^N. rectifiable_path(reversepath g) <=> rectifiable_path g"
   (SUBGOAL_THEN
     (← q r"!g:real^1->real^N. rectifiable_path g ==> rectifiable_path(reversepath g)")
     (fun th => MESON_TAC [th, REVERSEPATH_REVERSEPATH]) THEN
    GEN_TAC THEN REWRITE_TAC [rectifiable_path] THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [PATH_REVERSEPATH] THEN
    REWRITE_TAC [reversepath] THEN DISCH_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_DECREASING THEN
    ASM_REWRITE_TAC [DROP_SUB, VECTOR_SUB_RZERO, VECTOR_SUB_REFL] THEN
    REAL_ARITH_TAC)

  let PATH_LENGTH_REVERSEPATH ← prove
   r"!g:real^1->real^N. path_length(reversepath g) = path_length g"
   (GEN_TAC THEN REWRITE_TAC [path_length, reversepath] THEN
    REWRITE_TAC [VECTOR_SUB, VECTOR_VARIATION_REFLECT] THEN
    REWRITE_TAC [VECTOR_VARIATION_TRANSLATION_ALT] THEN
    REWRITE_TAC [REFLECT_INTERVAL, ← GSYM INTERVAL_TRANSLATION] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB, VECTOR_SUB_REFL, VECTOR_SUB_RZERO])

  let RECTIFIABLE_PATH_SUBPATH_EQ ← prove
   r"!g:real^1->real^N s t.
        rectifiable_path(subpath s t g) <=>
        path(subpath s t g) /\ g has_bounded_variation_on segment[s,t]"
   (REPEAT GEN_TAC THEN REWRITE_TAC [rectifiable_path] THEN AP_TERM_TAC THEN
    REWRITE_TAC [subpath] THEN ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_AFFINITY_EQ, IMAGE_AFFINITY_INTERVAL] THEN
    REWRITE_TAC [UNIT_INTERVAL_NONEMPTY] THEN
    REWRITE_TAC [DROP_SUB, REAL_SUB_0, DROP_EQ] THEN
    ASM_CASES_TAC (← q r"s:real^1 = t") THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, HAS_BOUNDED_VARIATION_ON_SING] THEN
    REWRITE_TAC [SEGMENT_1, REAL_SUB_LE] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [CONS_11, PAIR_EQ, ← GSYM DROP_EQ] THEN
    REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let PATH_LENGTH_SUBPATH ← prove
   r"!g:real^1->real^N s t.
        path_length(subpath s t g) = vector_variation (segment[s,t]) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_length, subpath] THEN
    ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
    REWRITE_TAC [VECTOR_VARIATION_AFFINITY, IMAGE_AFFINITY_INTERVAL] THEN
    REWRITE_TAC [UNIT_INTERVAL_NONEMPTY] THEN
    REWRITE_TAC [DROP_SUB, REAL_SUB_0, DROP_EQ] THEN
    COND_CASES_TAC THEN
    ASM_REWRITE_TAC [SEGMENT_REFL, VECTOR_VARIATION_SING] THEN
    REWRITE_TAC [SEGMENT_1, REAL_SUB_LE] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [CONS_11, PAIR_EQ, ← GSYM DROP_EQ] THEN
    REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let RECTIFIABLE_PATH_SUBPATH ← prove
   r"!u v g:real^1->real^N.
        rectifiable_path g /\
        u IN interval[vec 0,vec 1] /\
        v IN interval[vec 0,vec 1]
        ==> rectifiable_path(subpath u v g)"
   (REPEAT GEN_TAC THEN SIMP_TAC [PATH_SUBPATH, rectifiable_path] THEN
    STRIP_TAC THEN REWRITE_TAC [subpath] THEN
    ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
    REWRITE_TAC [HAS_BOUNDED_VARIATION_AFFINITY_EQ, IMAGE_AFFINITY_INTERVAL] THEN
    REWRITE_TAC [UNIT_INTERVAL_NONEMPTY, DROP_SUB, REAL_SUB_LE, REAL_SUB_0] THEN
    DISJ2_TAC THEN COND_CASES_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
    REWRITE_TAC [SUBSET_INTERVAL_1] THEN
    REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_VEC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    ASM_REAL_ARITH_TAC)

  let RECTIFIABLE_PATH_JOIN ← prove
   r"!g1 g2:real^1->real^N.
        pathfinish g1 = pathstart g2
        ==> (rectifiable_path(g1 ++ g2) <=>
             rectifiable_path g1 /\ rectifiable_path g2)"
   (REPEAT GEN_TAC THEN SIMP_TAC [rectifiable_path, PATH_JOIN] THEN
    REWRITE_TAC [pathfinish, pathstart] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"path(g1:real^1->real^N)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"path(g2:real^1->real^N)") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"g1 ++ g2:real^1->real^N", ← q r"vec 0:real^1", ← q r"vec 1:real^1",
                      ← q r"lift(&1 / &2)"]
          HAS_BOUNDED_VARIATION_ON_COMBINE) THEN
    REWRITE_TAC [DROP_VEC, LIFT_DROP] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [joinpaths] THEN BINOP_TAC THEN
    MATCH_MP_TAC EQ_TRANS THENL
     [EXISTS_TAC
       (← q r"(\x. (g1:real^1->real^N)(&2 % x)) has_bounded_variation_on
      interval [vec 0,lift(&1 / &2)]") THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % x:real^N = &2 % x + vec 0")],
      EXISTS_TAC
       (← q r"(\x. (g2:real^1->real^N)(&2 % x - vec 1)) has_bounded_variation_on
      interval [lift (&1 / &2),vec 1]") THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % x - v:real^N = &2 % x + --v")]] THEN
    (CONJ_TAC THENL
      [ALL_TAC,
       REWRITE_TAC [HAS_BOUNDED_VARIATION_AFFINITY_EQ] THEN
       REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, INTERVAL_EQ_EMPTY_1] THEN
       REWRITE_TAC [DROP_VEC, LIFT_DROP] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
       AP_TERM_TAC THEN AP_TERM_TAC THEN
       REWRITE_TAC [CONS_11, PAIR_EQ, ← GSYM DROP_EQ] THEN
       REWRITE_TAC [DROP_ADD, DROP_CMUL, LIFT_DROP, DROP_VEC, DROP_NEG] THEN
       REAL_ARITH_TAC]) THEN
    MATCH_MP_TAC (← MESON [HAS_BOUNDED_VARIATION_ON_EQ]
     (← q r"(!x. x IN s ==> f x = g x)
    ==> (f has_bounded_variation_on s <=>
         g has_bounded_variation_on s)")) THEN
    SIMP_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC] THEN X_GEN_TAC (← q r"x:real^1") THEN
    COND_CASES_TAC THEN REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&2 % x + --vec 1:real^1 = vec 0 /\ &2 % x = vec 1")
      (fun th => ASM_REWRITE_TAC [th]) THEN
    REWRITE_TAC [VECTOR_SUB_EQ, ← GSYM VECTOR_SUB] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC] THEN ASM_REAL_ARITH_TAC)

  let RECTIFIABLE_PATH_JOIN_IMP ← prove
   r"!g1 g2:real^1->real^N.
        rectifiable_path g1 /\ rectifiable_path g2 /\
        pathfinish g1 = pathstart g2
        ==> rectifiable_path(g1 ++ g2)"
   (SIMP_TAC [RECTIFIABLE_PATH_JOIN])

  let RECTIFIABLE_PATH_JOIN_EQ ← prove
   r"!g1 g2:real^1->real^N.
        rectifiable_path g1 /\ rectifiable_path g2
        ==> (rectifiable_path (g1 ++ g2) <=> pathfinish g1 = pathstart g2)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [RECTIFIABLE_PATH_JOIN_IMP] THEN
    DISCH_TAC THEN MATCH_MP_TAC PATH_JOIN_PATH_ENDS THEN
    ASM_SIMP_TAC [RECTIFIABLE_PATH_IMP_PATH])

  pure { rectifiable_path, path_length, RECTIFIABLE_PATH_LIPSCHITZ_IMAGE,
         RECTIFIABLE_PATH_TRANSLATION_EQ, RECTIFIABLE_PATH_LINEAR_IMAGE_EQ,
         PATH_LENGTH_TRANSLATION, PATH_LENGTH_ISOMETRIC_IMAGE, PATH_LENGTH_LINEAR_IMAGE,
         RECTIFIABLE_PATH_EQ, PATH_LENGTH_EQ, PATH_LENGTH_SCALING,
         BOUNDED_RECTIFIABLE_PATH_IMAGE, RECTIFIABLE_PATH_IMP_PATH,
         RECTIFIABLE_PATH_LINEPATH, RECTIFIABLE_PATH_REVERSEPATH,
         PATH_LENGTH_REVERSEPATH, RECTIFIABLE_PATH_SUBPATH_EQ, PATH_LENGTH_SUBPATH,
         RECTIFIABLE_PATH_SUBPATH, RECTIFIABLE_PATH_JOIN, RECTIFIABLE_PATH_JOIN_IMP,
         RECTIFIABLE_PATH_JOIN_EQ }

/- ------------------------------------------------------------------------- -/
/- Path length: shiftpath, joins, combining, Lipschitz, endpoint bounds.    -/
/- (integration.ml 24072-24290)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBX where
  RECTIFIABLE_PATH_SYM : thm
  RECTIFIABLE_PATH_SHIFTPATH : thm
  PATH_LENGTH_SHIFTPATH : thm
  PATH_LENGTH_POS_LE : thm
  PATH_LENGTH_EQ_0 : thm
  SIMPLE_PATH_LENGTH_POS_LT : thm
  PATH_LENGTH_JOIN : thm
  PATH_LENGTH_COMBINE : thm
  RECTIFIABLE_PATH_COMBINE : thm
  LIPSCHITZ_IMP_RECTIFIABLE_PATH : thm
  PATH_LENGTH_LIPSCHITZ : thm
  DIST_POINTS_LE_PATH_LENGTH : thm
  DIST_ENDPOINTS_LE_PATH_LENGTH : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBX [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBB : INBB) (BINBC : INBC) (BINBD : INBD) (BINBW : INBW) : ExceptT String IO INBX := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_ON_EQ, VECTOR_VARIATION_EQ, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_CONST_EQ,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_POS_LE, .. } := BINAW
  let { HAS_BOUNDED_VARIATION_ON_COMBINE, VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { VECTOR_VARIATION_AFFINITY, VECTOR_VARIATION_TRANSLATION_INTERVAL, .. } := BINBB
  let { HAS_BOUNDED_VARIATION_COMPOSE_INCREASING, .. } := BINBC
  let { LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION, VECTOR_VARIATION_LIPSCHITZ, .. } := BINBD
  let { path_length, PATH_LENGTH_SUBPATH, rectifiable_path, RECTIFIABLE_PATH_JOIN,
        RECTIFIABLE_PATH_JOIN_IMP, RECTIFIABLE_PATH_SUBPATH_EQ, .. } := BINBW
  let { EMPTY_SUBSET, EQ_IMP, EQ_TRANS, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { PAIR_EQ, REAL_ADD_SYM, .. } := D.dv.dg.pt.cvx.core3
  let { RIGHT_FORALL_IMP_THM, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, .. } := D.dv.dg.pt.cvx.core6
  let { HULL_MINIMAL, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. }
        := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_ADD_RID, VECTOR_SUB_EQ, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, IS_INTERVAL_INTERVAL, .. } :=
        D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { SEGMENT_CONVEX_HULL, .. } := D.dv.dg.pt.qcvx3
  let { CONVEX_INTERVAL, .. } := D.dv.dg.qconvex
  let { joinpaths, path, pathfinish, pathstart, .. } := D.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.dv.dg.qvec
  let { PATH_COMBINE, PATH_SHIFTPATH, shiftpath, simple_path, .. } := D.qpaths
  let { CONS_11, .. } := D.qsession
  let { IMAGE_AFFINITY_INTERVAL, LIPSCHITZ_IMP_CONTINUOUS_ON, .. } := D.qtopology
  -- @@SCOPE END

  let RECTIFIABLE_PATH_SYM ← prove
   r"!p q:real^1->real^N.
        pathfinish p = pathstart q /\ pathfinish q = pathstart p
        ==> (rectifiable_path(p ++ q) <=> rectifiable_path(q ++ p))"
   (SIMP_TAC [RECTIFIABLE_PATH_JOIN] THEN CONV_TAC (fun t => TAUT t))

  let RECTIFIABLE_PATH_SHIFTPATH ← prove
   r"!g:real^1->real^N a.
           rectifiable_path g /\
           pathfinish g = pathstart g /\
           a IN interval[vec 0,vec 1]
           ==> rectifiable_path(shiftpath a g)"
   (SIMP_TAC [rectifiable_path, PATH_SHIFTPATH] THEN
    REWRITE_TAC [IN_INTERVAL_1, shiftpath, DROP_ADD, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← GEN (← q r"f:real^1->real^N")
      (← ISPECL [← q r"f:real^1->real^N", ← q r"vec 0:real^1", ← q r"vec 1:real^1",
                 ← q r"vec 1 - a:real^1"]
          HAS_BOUNDED_VARIATION_ON_COMBINE)) THEN
    REWRITE_TAC [DROP_SUB, DROP_VEC, RIGHT_FORALL_IMP_THM] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (fun th => REWRITE_TAC [th]) THEN CONJ_TAC THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_EQ THENL
     [EXISTS_TAC (← q r"\x. (g:real^1->real^N) (a + x)"),
      EXISTS_TAC (← q r"\x. (g:real^1->real^N) (a + x - vec 1)")] THEN
    (CONJ_TAC THENL
      [SIMP_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, ← REAL_ARITH
                  (← q r"x <= &1 - a <=> a + x <= &1")],
       MATCH_MP_TAC (← REWRITE_RULE [o_DEF]
         HAS_BOUNDED_VARIATION_COMPOSE_INCREASING) THEN
       SIMP_TAC [DROP_ADD, DROP_SUB, DROP_VEC] THEN
       CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
       REWRITE_TAC [SUBSET_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_VEC] THEN
       ASM_REAL_ARITH_TAC]) THEN
    X_GEN_TAC (← q r"x:real^1") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SYM o GEN_REWRITE_RULE RAND_CONV [pathstart]) THEN
    REWRITE_TAC [pathfinish] THEN MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
    AP_TERM_TAC THEN REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_SUB, DROP_VEC] THEN
    ASM_REAL_ARITH_TAC)

  let PATH_LENGTH_SHIFTPATH ← prove
   r"!g:real^1->real^N a.
           rectifiable_path g /\
           pathfinish g = pathstart g /\
           a IN interval[vec 0,vec 1]
           ==> path_length(shiftpath a g) = path_length g"
   (REWRITE_TAC [rectifiable_path] THEN
    REWRITE_TAC [IN_INTERVAL_1, shiftpath, path_length, DROP_ADD, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← GEN (← q r"f:real^1->real^N")
      (← ISPECL [← q r"f:real^1->real^N", ← q r"vec 0:real^1", ← q r"vec 1:real^1",
                 ← q r"vec 1 - a:real^1"]
          VECTOR_VARIATION_COMBINE)) THEN
    DISCH_THEN (fun th =>
      W (MP_TAC o PART_MATCH (rand o rand) th o lhand o snd)) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [DROP_SUB, DROP_VEC] THEN
      REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"a:real^1"]
          RECTIFIABLE_PATH_SHIFTPATH) THEN
      ASM_SIMP_TAC [rectifiable_path, shiftpath, DROP_ADD,
                    IN_INTERVAL_1, DROP_VEC],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    TRANS_TAC EQ_TRANS
     (← q r"vector_variation (interval[vec 0,vec 1 - a])
                     (\x. (g:real^1->real^N) (a + x)) +
    vector_variation (interval[vec 1 - a,vec 1]) (\x.  g (a + x - vec 1))") THEN
    CONJ_TAC THENL
     [BINOP_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_EQ THEN
      SIMP_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC, ← REAL_ARITH
                  (← q r"x <= &1 - a <=> a + x <= &1")] THEN
      X_GEN_TAC (← q r"x:real^1") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [pathstart]) THEN
      REWRITE_TAC [pathfinish] THEN MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
      AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_SUB, DROP_VEC] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x - vec 1:real^1 = (a - vec 1) + x")] THEN
    REWRITE_TAC [VECTOR_VARIATION_TRANSLATION_INTERVAL] THEN
    REWRITE_TAC [VECTOR_ADD_RID, ← VECTOR_ARITH (← q r"a + x - a:real^1 = x")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a - x + x:real^N = a")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a - x + x - a:real^N = vec 0")] THEN
    ONCE_REWRITE_TAC [REAL_ADD_SYM] THEN
    MATCH_MP_TAC VECTOR_VARIATION_COMBINE THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC])

  let PATH_LENGTH_POS_LE ← prove
   r"!g:real^1->real^N.
        rectifiable_path g ==> &0 <= path_length g"
   (SIMP_TAC [rectifiable_path, path_length, VECTOR_VARIATION_POS_LE])

  let PATH_LENGTH_EQ_0 ← prove
   r"!g:real^1->real^N.
        rectifiable_path g
        ==> (path_length g = &0 <=>
             ?c. !t. t IN interval[vec 0,vec 1] ==> g t = c)"
   (SIMP_TAC [VECTOR_VARIATION_CONST_EQ, rectifiable_path, path_length,
              IS_INTERVAL_INTERVAL])

  let SIMPLE_PATH_LENGTH_POS_LT ← prove
   r"!g:real^1->real^N.
        rectifiable_path g /\ simple_path g ==> &0 < path_length g"
   (GEN_TAC THEN REWRITE_TAC [← REAL_ARITH (← q r"&0 < l <=> &0 <= l /\ ~(l = &0)")] THEN
    SIMP_TAC [PATH_LENGTH_POS_LE, PATH_LENGTH_EQ_0, simple_path] THEN
    MATCH_MP_TAC (← TAUT (← q r"(s ==> ~r) ==> p /\ q /\ r ==> ~s")) THEN
    STRIP_TAC THEN ASM_SIMP_TAC [IMP_CONJ] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &3)", ← q r"lift(&1/ &2)"]) THEN
    REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM, LIFT_EQ] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let PATH_LENGTH_JOIN ← prove
   r"!g1 g2:real^1->real^N.
        rectifiable_path g1 /\ rectifiable_path g2 /\
        pathfinish g1 = pathstart g2
        ==> path_length(g1 ++ g2) = path_length g1 + path_length g2"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [path_length] THEN
    MP_TAC (← ISPECL [← q r"g1 ++ g2:real^1->real^N", ← q r"vec 0:real^1", ← q r"vec 1:real^1",
                      ← q r"lift(&1 / &2)"]
          VECTOR_VARIATION_COMBINE) THEN
    REWRITE_TAC [DROP_VEC, LIFT_DROP] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [rectifiable_path, RECTIFIABLE_PATH_JOIN_IMP],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
     (← q r"vector_variation (interval [vec 0,lift (&1 / &2)])
                     (\x. (g1:real^1->real^N)(&2 % x)) +
    vector_variation (interval [lift (&1 / &2),vec 1])
                     (\x.  (g2:real^1->real^N)(&2 % x - vec 1))") THEN
    CONJ_TAC THENL
     [BINOP_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_EQ THEN
      SIMP_TAC [IN_INTERVAL_1, LIFT_DROP, DROP_VEC, joinpaths] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pathfinish, pathstart]) THEN
      X_GEN_TAC (← q r"x:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      COND_CASES_TAC THEN REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"&2 % x - vec 1:real^1 = vec 0 /\ &2 % x = vec 1")
       (fun th => ASM_REWRITE_TAC [th]) THEN
      REWRITE_TAC [VECTOR_SUB_EQ] THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
      ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"&2 % x:real^N = &2 % x + vec 0")] THEN
      ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"(&2 % x + vec 0) - v:real^N = &2 % x + --v")] THEN
      REWRITE_TAC [VECTOR_VARIATION_AFFINITY, IMAGE_AFFINITY_INTERVAL] THEN
      REWRITE_TAC [INTERVAL_EQ_EMPTY_1, LIFT_DROP, DROP_VEC] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN BINOP_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [CONS_11, PAIR_EQ, ← GSYM DROP_EQ] THEN
      REWRITE_TAC [DROP_ADD, DROP_CMUL, LIFT_DROP, DROP_VEC, DROP_NEG] THEN
      REAL_ARITH_TAC])

  let PATH_LENGTH_COMBINE ← prove
   r"!g:real^1->real^N t.
        rectifiable_path g /\ t IN interval[vec 0,vec 1]
        ==> path_length(subpath (vec 0) t g) +
            path_length(subpath t (vec 1) g) =
            path_length g"
   (REWRITE_TAC [PATH_LENGTH_SUBPATH] THEN
    SIMP_TAC [IN_INTERVAL_1, SEGMENT_1, path_length] THEN
    SIMP_TAC [rectifiable_path, VECTOR_VARIATION_COMBINE])

  let RECTIFIABLE_PATH_COMBINE ← prove
   r"!g:real^1->real^N t.
        t IN interval[vec 0,vec 1]
        ==> (rectifiable_path g <=>
             rectifiable_path(subpath (vec 0) t g) /\
             rectifiable_path(subpath t (vec 1) g))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [RECTIFIABLE_PATH_SUBPATH_EQ] THEN
    REWRITE_TAC [rectifiable_path] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p <=> p0 /\ p1) /\ (g <=> g0 /\ g1)
    ==> (p /\ g <=> (p0 /\ g0) /\ (p1 /\ g1))")) THEN
    ASM_SIMP_TAC [← GSYM PATH_COMBINE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    ASM_SIMP_TAC [SEGMENT_1, DROP_VEC] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_COMBINE THEN
    ASM_REWRITE_TAC [DROP_VEC])

  let LIPSCHITZ_IMP_RECTIFIABLE_PATH ← prove
   r"!g:real^1->real^N b.
        (!x y. x IN interval[vec 0,vec 1] /\ y IN interval[vec 0,vec 1]
               ==> norm(g x - g y) <= b * norm(x - y))
        ==> rectifiable_path g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [rectifiable_path] THEN CONJ_TAC THENL
     [REWRITE_TAC [path] THEN ASM_MESON_TAC [LIPSCHITZ_IMP_CONTINUOUS_ON],
      ASM_MESON_TAC [LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION, BOUNDED_INTERVAL]])

  let PATH_LENGTH_LIPSCHITZ ← prove
   r"!g:real^1->real^N b.
        (!x y. x IN interval[vec 0,vec 1] /\ y IN interval[vec 0,vec 1]
               ==> norm(g x - g y) <= b * norm(x - y))
        ==> path_length g <= b"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      VECTOR_VARIATION_LIPSCHITZ)) THEN
    REWRITE_TAC [path_length, DROP_VEC] THEN REAL_ARITH_TAC)

  let DIST_POINTS_LE_PATH_LENGTH ← prove
   r"!g:real^1->real^N a b.
        rectifiable_path g /\
        a IN interval[vec 0,vec 1] /\
        b IN interval[vec 0,vec 1]
        ==> dist (g a,g b) <= path_length g"
   (REWRITE_TAC [rectifiable_path] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [dist, path_length] THEN
    MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
    ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
    MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, CONVEX_INTERVAL, EMPTY_SUBSET])

  let DIST_ENDPOINTS_LE_PATH_LENGTH ← prove
   r"!g:real^1->real^N.
      rectifiable_path g ==> dist(pathstart g,pathfinish g) <= path_length g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [pathstart, pathfinish] THEN
    MATCH_MP_TAC DIST_POINTS_LE_PATH_LENGTH THEN
    ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL])

  pure { RECTIFIABLE_PATH_SYM, RECTIFIABLE_PATH_SHIFTPATH, PATH_LENGTH_SHIFTPATH,
         PATH_LENGTH_POS_LE, PATH_LENGTH_EQ_0, SIMPLE_PATH_LENGTH_POS_LT,
         PATH_LENGTH_JOIN, PATH_LENGTH_COMBINE, RECTIFIABLE_PATH_COMBINE,
         LIPSCHITZ_IMP_RECTIFIABLE_PATH, PATH_LENGTH_LIPSCHITZ,
         DIST_POINTS_LE_PATH_LENGTH, DIST_ENDPOINTS_LE_PATH_LENGTH }

/- ------------------------------------------------------------------------- -/
/- Path length: segments, subpaths, linepaths, reparametrization, arcs.     -/
/- (integration.ml 24291-24486)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBY where
  PATH_LENGTH_EQ_LINE_SEGMENT : thm
  PATH_LENGTH_SUBPATH_LE : thm
  RECTIFIABLE_PATH_IMAGE_SUBSET_CBALL : thm
  PATH_LENGTH_LINEPATH : thm
  RECTIFIABLE_PATH_REPARAMETRIZATION : thm
  PATH_LENGTH_REPARAMETRIZATION : thm
  ARC_LENGTH_UNIQUE : thm
  CONTINUOUS_ON_PATH_LENGTH_SUBPATH_RIGHT : thm
  CONTINUOUS_ON_PATH_LENGTH_SUBPATH_LEFT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBY [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBA : INBA) (BINBC : INBC) (BINBD : INBD) (BINBH : INBH) (BINBW : INBW) : ExceptT String IO INBY := do
  -- @@SCOPE BEGIN
  let { VECTOR_VARIATION_TRANSLATION, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_GE_NORM_FUNCTION,
        VECTOR_VARIATION_MONOTONE, VECTOR_VARIATION_POS_LE, VECTOR_VARIATION_VMUL, .. } :=
        BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { VECTOR_VARIATION_ID, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM, VECTOR_VARIATION_COMPOSE_DECREASING,
        VECTOR_VARIATION_COMPOSE_HOMEOMORPHISM, VECTOR_VARIATION_COMPOSE_INCREASING, .. } :=
        BINBC
  let { HAS_BOUNDED_VARIATION_ON_ID, .. } := BINBD
  let { VECTOR_VARIATION_CONTINUOUS, .. } := BINBH
  let { path_length, PATH_LENGTH_EQ, PATH_LENGTH_REVERSEPATH, PATH_LENGTH_SUBPATH,
        rectifiable_path, RECTIFIABLE_PATH_IMP_PATH, .. } := BINBW
  let { EMPTY_SUBSET, EQ_TRANS, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_LADD, REAL_LE_LMUL, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_SUB_LE, SUBSET, SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { HULL_MINIMAL, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_SUB, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_ADD_RID, VECTOR_MUL_RZERO, .. } := D.dv.dg.pt.cvx.vec4
  let { BETWEEN_IN_SEGMENT, .. } := D.dv.dg.pt.cvx.top1
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUB, .. } := D.dv.dg.pt.cvx.top3
  let { HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_SYM, IN_CBALL, IN_INTERVAL_1,
        IS_INTERVAL_INTERVAL, .. } := D.dv.dg.pt.cvx.top4
  let { homeomorphism, SEGMENT_1, UNIT_INTERVAL_NONEMPTY, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { between, .. } := D.dv.dg.pt.qvec
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { SEGMENT_CONVEX_HULL, .. } := D.dv.dg.pt.qcvx3
  let { CONVEX_INTERVAL, .. } := D.dv.dg.qconvex
  let { CONNECTED_PATH_IMAGE, .. } := D.dv.dg.qpaths1
  let { path, path_image, pathfinish, PATHFINISH_IN_PATH_IMAGE, pathstart,
        PATHSTART_IN_PATH_IMAGE, .. } := D.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { CONNECTED_SUBSET_SEGMENT, HOMEOMORPHISM_ARC, linepath, REVERSEPATH_SUBPATH, subpath,
        .. } := D.qpaths
  let { CONTINUOUS_ON_LIFT_ABS, CONTINUOUS_TRANSFORM_WITHIN, .. } := D.qtopology
  let { LIFT_EQ_CMUL, .. } := D.qvec
  -- @@SCOPE END

  let PATH_LENGTH_EQ_LINE_SEGMENT ← prove
   r"!g:real^1->real^N.
        rectifiable_path g /\ path_length g = dist(pathstart g,pathfinish g)
        ==> path_image g = segment[pathstart g,pathfinish g]"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(s SUBSET t ==> s = t) /\ s SUBSET t ==> s = t")) THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CONNECTED_SUBSET_SEGMENT THEN
      ASM_SIMP_TAC [CONNECTED_PATH_IMAGE, PATHSTART_IN_PATH_IMAGE,
                    PATHFINISH_IN_PATH_IMAGE, RECTIFIABLE_PATH_IMP_PATH],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, path_image, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"t:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->real^N", ← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"t:real^1"]
     VECTOR_VARIATION_COMBINE) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [rectifiable_path, path_length]) THEN
    ASM_REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, between] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->real^N", ← q r"interval[vec 0:real^1,t]", ← q r"vec 0:real^1", ← q r"t:real^1"]
          VECTOR_VARIATION_GE_NORM_FUNCTION) THEN
    ASM_REWRITE_TAC [SEGMENT_1, pathstart, pathfinish, SUBSET_REFL] THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->real^N", ← q r"interval[t:real^1,vec 1]", ← q r"t:real^1", ← q r"vec 1:real^1"]
          VECTOR_VARIATION_GE_NORM_FUNCTION) THEN
    ASM_REWRITE_TAC [SEGMENT_1, pathstart, pathfinish, SUBSET_REFL] THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL],
      CONV_TAC (fun t => NORM_ARITH t)])

  let PATH_LENGTH_SUBPATH_LE ← prove
   r"!g:real^1->real^N s t.
        rectifiable_path g /\
        s IN interval[vec 0,vec 1] /\ t IN interval[vec 0,vec 1]
        ==> path_length (subpath s t g) <= path_length g"
   (REWRITE_TAC [path_length, rectifiable_path, subpath,
                 IN_INTERVAL_1, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM o_DEF] THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop s <= drop t \/ drop t <= drop s")) THENL
     [W (MP_TAC o PART_MATCH (lhand o rand) VECTOR_VARIATION_COMPOSE_INCREASING o
        lhand o snd),
      W (MP_TAC o PART_MATCH (lhand o rand) VECTOR_VARIATION_COMPOSE_DECREASING o
        lhand o snd)] THEN
    ASM_REWRITE_TAC [o_DEF, DROP_ADD, DROP_CMUL, DROP_SUB, LIFT_SUB, LIFT_DROP,
                     VECTOR_MUL_RZERO, VECTOR_ADD_RID, ← GSYM LIFT_EQ_CMUL] THEN
    ASM_SIMP_TAC [REAL_LE_LADD, REAL_LE_LMUL, REAL_SUB_LE] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH
      (← q r"(t - s) * y <= (t - s) * x <=> (s - t) * x <= (s - t) * y")] THEN
    ASM_SIMP_TAC [REAL_LE_LADD, REAL_LE_LMUL, REAL_SUB_LE] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"s + t - s:real^N = t")] THEN
    (ANTS_TAC THENL
      [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
       ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL, LIFT_DROP, DROP_VEC],
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS)]) THEN
    MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL, LIFT_DROP, DROP_VEC])

  let RECTIFIABLE_PATH_IMAGE_SUBSET_CBALL ← prove
   r"!g:real^1->real^N.
        rectifiable_path g
        ==> path_image g SUBSET cball(pathstart g,path_length g)"
   (GEN_TAC THEN REWRITE_TAC [pathstart, path_length] THEN
    REWRITE_TAC [rectifiable_path, path_image, FORALL_IN_IMAGE, SUBSET] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"t:real^1") THEN
    REWRITE_TAC [IN_INTERVAL_1, IN_CBALL, DROP_VEC] THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
      (← q r"vector_variation(interval[vec 0,t]) (g:real^1->real^N)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [dist] THEN MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL, LIFT_DROP, DROP_VEC],
        REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
        REWRITE_TAC [CONVEX_INTERVAL, INSERT_SUBSET, EMPTY_SUBSET] THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL, LIFT_DROP, DROP_VEC]],
      MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1, DROP_VEC, REAL_LE_REFL]])

  let PATH_LENGTH_LINEPATH ← prove
   r"!a b:real^N. path_length(linepath(a,b)) = dist(a,b)"
   (REWRITE_TAC [path_length, linepath] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - x) % a + x % b:real^N = a + x % (b - a)"),
                 VECTOR_VARIATION_TRANSLATION] THEN
    SIMP_TAC [VECTOR_VARIATION_VMUL, LIFT_DROP, HAS_BOUNDED_VARIATION_ON_ID,
              BOUNDED_INTERVAL, VECTOR_VARIATION_ID] THEN
    REWRITE_TAC [dist, UNIT_INTERVAL_NONEMPTY, DROP_VEC] THEN
    REWRITE_TAC [NORM_SUB] THEN REAL_ARITH_TAC)

  let RECTIFIABLE_PATH_REPARAMETRIZATION ← prove
   r"!g:real^1->real^N h h'.
        rectifiable_path g /\
        homeomorphism (interval[vec 0,vec 1],interval[vec 0,vec 1]) (h,h')
        ==> rectifiable_path(g o h)"
   (REWRITE_TAC [rectifiable_path] THEN REPEAT STRIP_TAC THENL
     [REWRITE_TAC [path] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, path]) THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM THEN
      EXISTS_TAC (← q r"h':real^1->real^1") THEN
      EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
      ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL]])

  let PATH_LENGTH_REPARAMETRIZATION ← prove
   r"!g:real^1->real^N h h'.
        rectifiable_path g /\
        homeomorphism (interval[vec 0,vec 1],interval[vec 0,vec 1]) (h,h')
        ==> path_length (g o h) = path_length g"
   (REWRITE_TAC [rectifiable_path, path_length] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_VARIATION_COMPOSE_HOMEOMORPHISM THEN
