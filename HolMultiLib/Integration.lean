  let BEPPO_LEVI_INCREASING ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f k x) <= drop(f (SUC k) x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  !x. x IN (s DIFF k) ==> ((\k. f k x) --> g x) sequentially"
   (SUBGOAL_THEN
     (← q r"!f:num->real^N->real^1 s.
        (!k x. x IN s ==> &0 <= drop(f k x)) /\
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f k x) <= drop(f (SUC k) x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  !x. x IN (s DIFF k) ==> ((\k. f k x) --> g x) sequentially")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT GEN_TAC THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o ISPECL
       [← q r"\n x:real^N. f(n:num) x - f 0 x:real^1", ← q r"s:real^N->bool"]) THEN
      REWRITE_TAC [] THEN ANTS_TAC THEN REPEAT CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN REWRITE_TAC [DROP_SUB, REAL_SUB_LE] THEN
        MP_TAC (← ISPEC
          (← q r"\m n:num. drop (f m (x:real^N)) <= drop (f n x)")
          TRANSITIVE_STEPWISE_LE) THEN
        REWRITE_TAC [REAL_LE_TRANS, REAL_LE_REFL] THEN ASM_MESON_TAC [LE_0],
        GEN_TAC THEN MATCH_MP_TAC INTEGRABLE_SUB THEN ASM_REWRITE_TAC [ETA_AX],
        REPEAT STRIP_TAC THEN REWRITE_TAC [DROP_SUB, REAL_SUB_LE] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"x - a <= y - a <=> x <= y")],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
        ASM_SIMP_TAC [INTEGRAL_SUB, ETA_AX, bounded] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B:real")
          (fun th => tactic_of do
            pure (EXISTS_TAC (← q r"B + norm(integral s (f 0:real^N->real^1))") THEN
                  X_GEN_TAC (← q r"k:num") THEN MP_TAC (← SPEC (← q r"k:num") th)))) THEN
        NORM_ARITH_TAC,
        ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
        GEN_TAC THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^1") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(\x. g x + f 0 x):real^N->real^1") THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [LIM_SEQUENTIALLY, dist] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a - b - c:real^1 = a - (c + b)")]]] THEN
    REPEAT STRIP_TAC THEN
    ABBREV_TAC
     (← q r"g = \i n:num x:real^N. lift(min (drop(f n x) / (&i + &1)) (&1))") THEN
    SUBGOAL_THEN
     (← q r"!i n. ((g:num->num->real^N->real^1) i n) integrable_on s")
    ASSUME_TAC THENL
     [REPEAT GEN_TAC THEN EXPAND_TAC "g" THEN
      MATCH_MP_TAC INTEGRABLE_MIN_CONST_1 THEN
      ASM_SIMP_TAC [REAL_POS, REAL_LE_DIV, REAL_LE_ADD] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
      ASM_SIMP_TAC [LIFT_CMUL, LIFT_DROP, INTEGRABLE_CMUL, ETA_AX],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i:num k:num x:real^N. x IN s ==> drop(g i k x) <= drop(g i (SUC k) x)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN REWRITE_TAC [LIFT_DROP] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> min x a <= min y a")) THEN
      ASM_SIMP_TAC [REAL_LE_DIV2_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!i:num k:num x:real^N. x IN s ==> norm(g i k x:real^1) <= &1")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN
      REWRITE_TAC [LIFT_DROP, NORM_REAL, ← GSYM drop] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> abs(min x (&1)) <= &1")) THEN
      ASM_SIMP_TAC [REAL_POS, REAL_LE_DIV, REAL_LE_ADD],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i:num x:real^N. x IN s ==> ?h:real^1. ((\n. g i n x) --> h) sequentially")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\n. drop(g (i:num) (n:num) (x:real^N))", ← q r"&1"]
       CONVERGENT_BOUNDED_MONOTONE) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [← GSYM NORM_1] THEN DISJ1_TAC THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_SIMP_TAC [REAL_LE_REFL, REAL_LE_TRANS] THEN REAL_ARITH_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"l:real") (fun th => tactic_of do
          pure (EXISTS_TAC (← q r"lift l") THEN MP_TAC th))) THEN
        REWRITE_TAC [LIM_SEQUENTIALLY, DIST_REAL, ← GSYM drop, LIFT_DROP]],
      GEN_REWRITE_TAC (LAND_CONV o REDEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"h:num->real^N->real^1") THEN STRIP_TAC THEN
    MP_TAC (← GEN (← q r"i:num") (← ISPECL
     [← q r"g(i:num):num->real^N->real^1", ← q r"h(i:num):real^N->real^1",
      ← q r"s:real^N->bool"] MONOTONE_CONVERGENCE_INCREASING)) THEN
    DISCH_THEN (MP_TAC o MATCH_MP MONO_FORALL) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [GEN_TAC THEN REWRITE_TAC [bounded] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"K:real") THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN REWRITE_TAC [IN_UNIV] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"k:num") THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"norm a = drop a /\ x <= drop a ==> x <= norm a")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [NORM_REAL, ← GSYM drop, REAL_ABS_REFL] THEN
        MATCH_MP_TAC INTEGRAL_DROP_POS THEN ASM_SIMP_TAC [],
        MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
        EXPAND_TAC "g" THEN REWRITE_TAC [NORM_REAL, ← GSYM drop, LIFT_DROP] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= x /\ x <= y ==> abs(min x (&1)) <= y")) THEN
        ASM_SIMP_TAC [REAL_LE_ADD, REAL_POS, REAL_LE_DIV] THEN
        SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &i + &1")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"a <= a * (x + &1) <=> &0 <= a * x")] THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS]],
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
    ABBREV_TAC
     (← q r"Z =
    {x:real^N | x IN s /\ ~(?l:real^1. ((\k. f k x) --> l) sequentially)}") THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"Z:real^N->bool") THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, ← GSYM SKOLEM_THM, RIGHT_EXISTS_IMP_THM] THEN
    CONJ_TAC THENL
     [ALL_TAC, EXPAND_TAC "Z" THEN REWRITE_TAC [IN_ELIM_THM] THEN SET_TAC []] THEN
    MP_TAC (← ISPECL
     [← q r"h:num->real^N->real^1",
      ← q r"(\x. if x IN Z then vec 1 else vec 0):real^N->real^1",
      ← q r"s:real^N->bool"]
          MONOTONE_CONVERGENCE_DECREASING) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"!i x:real^N. x IN s ==> drop(h (SUC i) x) <= drop(h i x)")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"i:num", ← q r"x:real^N"] THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LE) THEN
      EXISTS_TAC (← q r"\n. (g:num->num->real^N->real^1) (SUC i) n x") THEN
      EXISTS_TAC (← q r"\n. (g:num->num->real^N->real^1) i n x") THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
      EXPAND_TAC "g" THEN REWRITE_TAC [LIFT_DROP] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> min x a <= min y a")) THEN
      REWRITE_TAC [real_div] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [← GSYM REAL_OF_NUM_SUC] THEN REAL_ARITH_TAC,
      ASM_REWRITE_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!i. norm(integral s ((h:num->real^N->real^1) i)) <= B / (&i + &1)")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
      EXISTS_TAC (← q r"\k. integral s ((g:num->num->real^N->real^1) i k)") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
       (← q r"drop(integral s (\x. inv(&i + &1) % (f:num->real^N->real^1) n x))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
        ASM_SIMP_TAC [INTEGRABLE_CMUL, ETA_AX] THEN
        X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN EXPAND_TAC "g" THEN
        REWRITE_TAC [NORM_REAL, ← GSYM drop, LIFT_DROP, DROP_CMUL] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= x /\ x <= y ==> abs(min x (&1)) <= y")) THEN
        ASM_SIMP_TAC [REAL_LE_ADD, REAL_POS, REAL_LE_DIV] THEN
        REAL_ARITH_TAC,
        ASM_SIMP_TAC [INTEGRAL_CMUL, ETA_AX, DROP_CMUL] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [← GSYM real_div, REAL_LE_DIV2_EQ,
                      ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> x <= a")) THEN
        ASM_REWRITE_TAC [← GSYM NORM_1]],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [bounded, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
       [ALL_TAC,
        EXISTS_TAC (← q r"B:real") THEN X_GEN_TAC (← q r"i:num") THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"B / (&i + &1)") THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, ← REAL_ARITH (← q r"&0 < &i + &1")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"B <= B * (i + &1) <=> &0 <= i * B")] THEN
        ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS, REAL_LT_IMP_LE]] THEN
      X_GEN_TAC (← q r"x:real^N") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(x:real^N) IN Z") THEN ASM_REWRITE_TAC [] THENL
       [MATCH_MP_TAC LIM_EVENTUALLY THEN
        UNDISCH_TAC (← q r"(x:real^N) IN Z") THEN EXPAND_TAC "Z" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
        MP_TAC (← GEN (← q r"B:real") (← ISPECL
          [← q r"\n. drop(f (n:num) (x:real^N))", ← q r"B:real"]
          CONVERGENT_BOUNDED_MONOTONE)) THEN
        REWRITE_TAC [LEFT_FORALL_IMP_THM, LEFT_EXISTS_AND_THM] THEN
        MATCH_MP_TAC (← TAUT
         (← q r"q /\ ~r /\ (q ==> ~p ==> s)
        ==> (p /\ (q \/ q') ==> r) ==> s")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
          ASM_SIMP_TAC [REAL_LE_REFL, REAL_LE_TRANS] THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [NOT_EXISTS_THM]) THEN
          ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"l:real") STRIP_ASSUME_TAC) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"lift l")) THEN
          REWRITE_TAC [LIM_SEQUENTIALLY] THEN
          X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [DIST_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP],
          ALL_TAC] THEN
        DISCH_TAC THEN REWRITE_TAC [NOT_FORALL_THM, EVENTUALLY_SEQUENTIALLY] THEN
        REWRITE_TAC [NOT_EXISTS_THM, NOT_FORALL_THM, REAL_NOT_LE] THEN
        DISCH_TAC THEN
        EXISTS_TAC (← q r"0") THEN  X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
        EXISTS_TAC (← q r"(\n. (g:num->num->real^N->real^1) i n x)") THEN
        ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
        MATCH_MP_TAC LIM_EVENTUALLY THEN
        EXPAND_TAC "g" THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&i + &1")) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, LIFT_DROP] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"min a b = b <=> b <= a")] THEN
        SIMP_TAC [REAL_LE_RDIV_EQ, ← REAL_ARITH (← q r"&0 < &i + &1"), REAL_MUL_LID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"a < abs N ==> &0 <= N /\ N <= n ==> a <= n"))) THEN
        ASM_SIMP_TAC [],
        UNDISCH_TAC (← q r"~((x:real^N) IN Z)") THEN EXPAND_TAC "Z" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"l:real^1") THEN
        DISCH_THEN (MP_TAC o MATCH_MP CONVERGENT_IMP_BOUNDED) THEN
        REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE, IN_UNIV] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPEC (← q r"e / C:real") REAL_ARCH_INV) THEN
        ASM_SIMP_TAC [REAL_LT_DIV] THEN MATCH_MP_TAC MONO_EXISTS THEN
        X_GEN_TAC (← q r"N:num") THEN ASM_SIMP_TAC [REAL_LT_RDIV_EQ] THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N) * C") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"C / (&i + &1)") THEN
        CONJ_TAC THENL
         [ALL_TAC,
          REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] real_div] THEN
          ASM_SIMP_TAC [REAL_LE_RMUL_EQ] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
          ASM_REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN
          ASM_ARITH_TAC] THEN
        MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
        EXISTS_TAC (← q r"\n. (g:num->num->real^N->real^1) i n x") THEN
        ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
        MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
        EXPAND_TAC "g" THEN REWRITE_TAC [NORM_REAL, ← GSYM drop, LIFT_DROP] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= x /\ x <= a ==> abs(min x (&1)) <= a")) THEN
        ASM_SIMP_TAC [REAL_LE_DIV, REAL_LE_ADD, REAL_POS] THEN
        ASM_SIMP_TAC [REAL_LE_DIV2_EQ, ← REAL_ARITH (← q r"&0 < &i + &1")] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> x <= a")) THEN
        ASM_REWRITE_TAC [← GSYM NORM_LIFT, LIFT_DROP]],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← MESON [LIM_UNIQUE, TRIVIAL_LIMIT_SEQUENTIALLY]
       (← q r"(f --> vec 0) sequentially /\ (i = vec 0 ==> p)
      ==> (f --> i) sequentially ==> p")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC LIM_NULL_COMPARISON THEN
        EXISTS_TAC (← q r"\i. B / (&i + &1)") THEN
        ASM_SIMP_TAC [ALWAYS_EVENTUALLY] THEN
        REWRITE_TAC [real_div, LIFT_CMUL] THEN
        SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^1 = B % vec 0")) THEN
        MATCH_MP_TAC LIM_CMUL THEN
        REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0] THEN
        X_GEN_TAC (← q r"e:real") THEN GEN_REWRITE_TAC LAND_CONV [REAL_ARCH_INV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        REWRITE_TAC [NORM_LIFT, ← GSYM drop, LIFT_DROP, REAL_ABS_INV] THEN
        MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs(&n + &1) = &n + &1")] THEN
        REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT] THEN
        ASM_ARITH_TAC,
        ASM_SIMP_TAC [INTEGRAL_EQ_HAS_INTEGRAL] THEN
        W (MP_TAC o PART_MATCH (lhs o rand) HAS_INTEGRAL_NEGLIGIBLE_EQ o
          lhand o snd) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
          REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, ← GSYM drop] THEN
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
          REWRITE_TAC [DROP_VEC, REAL_POS],
          DISCH_THEN SUBST1_TAC THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] NEGLIGIBLE_SUBSET) THEN
          SIMP_TAC [SUBSET, IN_ELIM_THM, VEC_EQ, ARITH_EQ] THEN
          EXPAND_TAC "Z" THEN SIMP_TAC [IN_ELIM_THM]]]])

  let BEPPO_LEVI_DECREASING ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f (SUC k) x) <= drop(f k x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  !x. x IN (s DIFF k) ==> ((\k. f k x) --> g x) sequentially"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\n x. --((f:num->real^N->real^1) n x)", ← q r"s:real^N->bool"]
          BEPPO_LEVI_INCREASING) THEN
    ASM_SIMP_TAC [INTEGRABLE_NEG, DROP_NEG, ETA_AX, REAL_LE_NEG2] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [bounded] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [bounded]) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [INTEGRAL_NEG, ETA_AX, NORM_NEG],
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"k:real^N->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^N->real^1") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. --((g:real^N->real^1) x)") THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV o ABS_CONV)
        [← GSYM VECTOR_NEG_NEG] THEN
      ASM_SIMP_TAC [LIM_NEG_EQ]])

  let BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f k x) <= drop(f (SUC k) x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  (!x. x IN (s DIFF k)
                       ==> ((\k. f k x) --> g x) sequentially) /\
                  g integrable_on s /\
                  ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BEPPO_LEVI_INCREASING) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^1") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"(g:real^N->real^1) integrable_on (s DIFF k) /\
    ((\i. integral (s DIFF k) (f i)) --> integral (s DIFF k) g) sequentially")
    MP_TAC THENL
     [MATCH_MP_TAC MONOTONE_CONVERGENCE_INCREASING THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) => HolCore.Basics.is_conj (concl t))),
      ALL_TAC] THEN
    (SUBGOAL_THEN
      (← q r"!f:real^N->real^1. integral (s DIFF k) f = integral s f /\
                        (f integrable_on (s DIFF k) <=> f integrable_on s)")
      (fun th => SIMP_TAC [th, IN_DIFF]) THEN
     GEN_TAC THEN CONJ_TAC THEN TRY EQ_TAC THEN
     (MATCH_MP_TAC INTEGRABLE_SPIKE_SET ORELSE
      MATCH_MP_TAC INTEGRAL_SPIKE_SET) THEN
     FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
       SET_TAC []))

  let BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k x. x IN s ==> drop(f (SUC k) x) <= drop(f k x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  (!x. x IN (s DIFF k)
                       ==> ((\k. f k x) --> g x) sequentially) /\
                  g integrable_on s /\
                  ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BEPPO_LEVI_DECREASING) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^1") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^N->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"(g:real^N->real^1) integrable_on (s DIFF k) /\
    ((\i. integral (s DIFF k) (f i)) --> integral (s DIFF k) g) sequentially")
    MP_TAC THENL
     [MATCH_MP_TAC MONOTONE_CONVERGENCE_DECREASING THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) => HolCore.Basics.is_conj (concl t))),
      ALL_TAC] THEN
    (SUBGOAL_THEN
      (← q r"!f:real^N->real^1. integral (s DIFF k) f = integral s f /\
                        (f integrable_on (s DIFF k) <=> f integrable_on s)")
      (fun th => SIMP_TAC [th, IN_DIFF]) THEN
     GEN_TAC THEN CONJ_TAC THEN TRY EQ_TAC THEN
     (MATCH_MP_TAC INTEGRABLE_SPIKE_SET ORELSE
      MATCH_MP_TAC INTEGRAL_SPIKE_SET) THEN
     FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
       SET_TAC []))

  let BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING_AE ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k. ?t. negligible t /\
                 !x. x IN s DIFF t ==> drop(f k x) <= drop(f (SUC k) x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  (!x. x IN (s DIFF k)
                       ==> ((\k. f k x) --> g x) sequentially) /\
                  g integrable_on s /\
                  ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:num->real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"\n x. if x IN UNIONS {t k | k IN (:num)} then vec 0
           else (f:num->real^N->real^1) n x", ← q r"s:real^N->bool"]
          BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING) THEN
    SUBGOAL_THEN
     (← q r"negligible(UNIONS {t k | k IN (:num)}:real^N->bool)")
    ASSUME_TAC THENL [ASM_SIMP_TAC [NEGLIGIBLE_COUNTABLE_UNIONS], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"(f:num->real^N->real^1) k") THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_LE_REFL] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM SET_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x = g x)
        ==> {f x | x IN s} SUBSET {g x | x IN s}")) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^1") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"u UNION UNIONS {t k | k IN (:num)}:real^N->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN
        REWRITE_TAC [IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [IN_DIFF],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
           (← q r"(f --> l) sequentially ==> f = g ==> (g --> l) sequentially"))) THEN
        REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
        MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]]])

  let BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING_AE ← prove
   r"!f:num->real^N->real^1 s.
        (!k. (f k) integrable_on s) /\
        (!k. ?t. negligible t /\
                 !x. x IN s DIFF t ==> drop(f (SUC k) x) <= drop(f k x)) /\
        bounded {integral s (f k) | k IN (:num)}
        ==> ?g k. negligible k /\
                  (!x. x IN (s DIFF k)
                       ==> ((\k. f k x) --> g x) sequentially) /\
                  g integrable_on s /\
                  ((\k. integral s (f k)) --> integral s g) sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:num->real^N->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"\n x. if x IN UNIONS {t k | k IN (:num)} then vec 0
           else (f:num->real^N->real^1) n x", ← q r"s:real^N->bool"]
          BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING) THEN
    SUBGOAL_THEN
     (← q r"negligible(UNIONS {t k | k IN (:num)}:real^N->bool)")
    ASSUME_TAC THENL [ASM_SIMP_TAC [NEGLIGIBLE_COUNTABLE_UNIONS], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE) THEN
        EXISTS_TAC (← q r"(f:num->real^N->real^1) k") THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF],
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_LE_REFL] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM SET_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!x. x IN s ==> f x = g x)
        ==> {f x | x IN s} SUBSET {g x | x IN s}")) THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^N->real^1") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:real^N->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"u UNION UNIONS {t k | k IN (:num)}:real^N->bool") THEN
      ASM_REWRITE_TAC [NEGLIGIBLE_UNION_EQ] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^N") THEN
        REWRITE_TAC [IN_DIFF, IN_UNION, DE_MORGAN_THM] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^N")) THEN
        ASM_REWRITE_TAC [IN_DIFF],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
           (← q r"(f --> l) sequentially ==> f = g ==> (g --> l) sequentially"))) THEN
        REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
        MATCH_MP_TAC INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"UNIONS {t k | k IN (:num)}:real^N->bool") THEN
        ASM_SIMP_TAC [IN_DIFF]]])

  pure { BEPPO_LEVI_INCREASING, BEPPO_LEVI_DECREASING,
         BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING,
         BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING,
         BEPPO_LEVI_MONOTONE_CONVERGENCE_INCREASING_AE,
         BEPPO_LEVI_MONOTONE_CONVERGENCE_DECREASING_AE }

/- ------------------------------------------------------------------------- -/
/- Fatou's lemma and Lieb's extension.  (integration.ml 12653-12899)         -/
/- ------------------------------------------------------------------------- -/

structure INAI where
  FATOU : thm
  LIEB : thm
  FATOU_STRONG : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAI [HolBase] (D : IntegrationDeps) (BINE : INE) (BINI : INI) (BINP : INP) (BINU : INU) (BINZ : INZ) (BINAC : INAC) (BINAD : INAD) (BINAG : INAG) : ExceptT String IO INAI := do
  -- @@SCOPE BEGIN
  let { INTEGRABLE_0, INTEGRABLE_CMUL, INTEGRAL_0, INTEGRAL_SUB, .. } := BINE
  let { INTEGRAL_DROP_LE, .. } := BINI
  let { INTEGRAL_DROP_POS_AE, .. } := BINP
  let { MONOTONE_CONVERGENCE_DECREASING_AE, MONOTONE_CONVERGENCE_INCREASING_AE, .. } := BINU
  let { ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, ABSOLUTELY_INTEGRABLE_NORM, .. } := BINZ
  let { ABSOLUTELY_INTEGRABLE_SUB, .. } := BINAC
  let { ABSOLUTELY_INTEGRABLE_INF_1, .. } := BINAD
  let { DOMINATED_CONVERGENCE_AE, INTEGRAL_DROP_LE_AE, NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE,
        .. } := BINAG
  let { DIMINDEX_1, ETA_AX, EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FINITE_NUMSEG,
        FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM2, IMAGE_EQ_EMPTY, IMAGE_SUBSET, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, INF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LE_ADD, LE_REFL, LE_TRANS, LEFT_IMP_EXISTS_THM,
        LT_REFL, MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        NOT_INSERT_EMPTY, NOT_LE, NOT_LT, NUMSEG_EMPTY, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_INF_LE_FINITE, REAL_LE_INF, REAL_LE_REFL, REAL_LE_TRANS, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SING_SUBSET,
        SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, SWAP_FORALL_THM, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_CMUL, DROP_SUB, FORALL_1, LIFT_DROP, LIFT_SUB, NORM_1, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.met
  let { LIM_NORM, LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, basic_ss, GEN_SIMPLIFY_CONV, MESON_TAC,
        NORM_ARITH, REAL_ARITH, SET_RULE, TOP_DEPTH_SQCONV, .. } := D.dv.dg.pt.cvx
  let { EVENTUALLY_AND, .. } := D.dv.dg.qmetric
  let { SUBSET_NUMSEG, .. } := D.dv.dg.qsession
  let { LIM_DROP_LBOUND, LIM_NULL, LIM_NULL_NORM, LIM_NULL_SUB, .. } := D.dv.qtopology2
  let { LOWER_BOUND_FINITE_SET_REAL, .. } := D.qmisc
  let { INF_SING, LE_EXISTS, LT_ADD_LCANCEL, REAL_INF_BOUNDS, REAL_LE_INF_SUBSET, .. } :=
        D.qsession
  let { LIM_DROP_UBOUND, .. } := D.qtopology
  let { DIST_REAL, NORM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let FATOU ← prove
   r"!f:num->real^N->real^1 g s t B.
        negligible t /\
        (!n. (f n) integrable_on s) /\
        (!n x. x IN s DIFF t ==> &0 <= drop(f n x)) /\
        (!x. x IN s DIFF t ==> ((\n. f n x) --> g x) sequentially) /\
        (!n. drop(integral s (f n)) <= B)
        ==> g integrable_on s /\
            &0 <= drop(integral s g) /\ drop(integral s g) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC
     (← q r"h = \n x. lift(inf {drop((f:num->real^N->real^1) j x) | n <= j})") THEN
    MP_TAC (← MATCH_MP MONO_FORALL (← GEN (← q r"m:num")
     (← ISPECL [← q r"\k:num x:real^N. lift(inf {drop(f j x) | j IN m..(m+k)})",
                ← q r"(h:num->real^N->real^1) m",
                ← q r"s:real^N->bool", ← q r"t:real^N->bool"]
             MONOTONE_CONVERGENCE_DECREASING_AE))) THEN
    ASM_REWRITE_TAC [LIFT_DROP] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"m:num") THEN EXPAND_TAC "h" THEN REWRITE_TAC [] THEN
      REPEAT CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        MATCH_MP_TAC ABSOLUTELY_INTEGRABLE_INF_1 THEN
        REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, NOT_LT, LE_ADD] THEN
        ASM_REWRITE_TAC [LIFT_DROP, ETA_AX] THEN
        REPEAT STRIP_TAC THEN
        MATCH_MP_TAC NONNEGATIVE_ABSOLUTELY_INTEGRABLE_AE THEN
        EXISTS_TAC (← q r"t:real^N->bool") THEN
        ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        ASM_REWRITE_TAC [IMP_IMP, DIMINDEX_1, FORALL_1, ← GSYM drop],
        REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
        MATCH_MP_TAC REAL_LE_INF_SUBSET THEN
        REWRITE_TAC [IMAGE_EQ_EMPTY, NUMSEG_EMPTY, NOT_LT, LE_ADD] THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET_NUMSEG] THEN ARITH_TAC,
          ALL_TAC] THEN
        REWRITE_TAC [FORALL_IN_IMAGE] THEN
        MATCH_MP_TAC LOWER_BOUND_FINITE_SET_REAL THEN
        REWRITE_TAC [FINITE_NUMSEG],
