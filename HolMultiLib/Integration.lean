    FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
                  CONTENT_1, ← GSYM INTERVAL_NE_EMPTY_1] THEN
    REWRITE_TAC [REAL_SUB_0] THEN DISCH_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      REWRITE_TAC [INTERVAL_NE_EMPTY_1, DROP_ADD, DROP_SUB, DROP_CMUL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a + i * (b - a) <= b - i * (b - a) <=>
                            &0 <= (&1 - &2 * i) * (b - a)")] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM INTERVAL_NE_EMPTY_1] THEN
      SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&2 <= &1 * x <=> &2 pow 1 <= x")] THEN
      MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real^1", ← q r"d:real^1"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
                  CONTENT_1, ← GSYM INTERVAL_NE_EMPTY_1] THEN
    REWRITE_TAC [REAL_SUB_0] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"interval[a:real^1,b]", ← q r"interval[c:real^1,d]"] o elc 2) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_IMP THEN
    ASM_SIMP_TAC [CONTRAPOS_THM, EQ_INTERVAL_1, ← GSYM INTERVAL_EQ_EMPTY_1,
                  DROP_EQ] THEN
    REWRITE_TAC [← GSYM INTERIOR_INTER] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> t = {} ==> s = {}")) THEN
    MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC (← SET_RULE
     (← q r"s SUBSET s' /\ t SUBSET t' ==> s INTER t SUBSET s' INTER t'")) THEN
    CONJ_TAC THEN REWRITE_TAC [SUBSET_INTERVAL_1] THEN DISJ2_TAC THEN
    REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_CMUL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"b - i * (b - a) <= b <=> &0 <= i * (b - a)"),
                 ← REAL_ARITH (← q r"a <= a + i * (b - a) <=> &0 <= i * (b - a)"),
                 ← REAL_ARITH (← q r"a + i * (b - a) <= b - i * (b - a) <=>
                          &0 <= (&1 - &2 * i) * (b - a)")] THEN
    REPEAT CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
    ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM INTERVAL_NE_EMPTY_1] THEN
    SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
    SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&2 <= &1 * x <=> &2 pow 1 <= x")] THEN
    MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_ARITH_TAC)

  let HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ ← prove
   r"!f:real^1->real^N s.
        is_interval s \/ f continuous_on s
        ==> (f has_bounded_variation_on interior s <=>
             f has_bounded_variation_on s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THEN
    ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_INTERIOR,
                   HAS_BOUNDED_VARIATION_ON_SUBSET, INTERIOR_SUBSET])

  let CONVEX_HAS_BOUNDED_VARIATION_EQ ← prove
   r"!f s. (drop o f) convex_on s /\ is_interval s
         ==> (f has_bounded_variation_on s <=> bounded(IMAGE f s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED], DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"drop o (f:real^1->real^1)", ← q r"s:real^1->bool"]
          CONVEX_IMP_PIECEWISE_MONOTONE) THEN
    ASM_REWRITE_TAC [o_THM] THEN STRIP_TAC THENL
     [MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_INTERIOR THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INCREASING_BOUNDED_VARIATION_GEN,
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_INTERIOR THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC DECREASING_BOUNDED_VARIATION_GEN,
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool", ← q r"drop a"]
          HAS_BOUNDED_VARIATION_ON_COMBINE_GEN) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC DECREASING_BOUNDED_VARIATION_GEN,
        MATCH_MP_TAC INCREASING_BOUNDED_VARIATION_GEN] THEN
      REWRITE_TAC [IN_ELIM_THM, real_ge] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LE_TRANS]])] THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
      (← REWRITE_RULE [IMP_CONJ] BOUNDED_SUBSET)) THEN
    SIMP_TAC [IMAGE_SUBSET, INTERIOR_SUBSET, SUBSET_RESTRICT])

  let CONVEX_HAS_BOUNDED_VARIATION ← prove
   r"!f a b.
        f convex_on interval[a,b]
        ==> (lift o f) has_bounded_variation_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    IMP_REWRITE_TAC [CONVEX_HAS_BOUNDED_VARIATION_EQ] THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CONVEX_IMP_BOUNDED_ON_INTERVAL) THEN
      REWRITE_TAC [bounded, FORALL_IN_IMAGE, o_DEF, NORM_LIFT] THEN MESON_TAC [],
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX]])

  pure { HAS_BOUNDED_VARIATION_ON_INTERIOR, HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ,
         CONVEX_HAS_BOUNDED_VARIATION_EQ, CONVEX_HAS_BOUNDED_VARIATION }

/- ------------------------------------------------------------------------- -/
/- Limits preserve bounded variation; one-sided limits of monotone and      -/
/- bounded-variation functions.  (integration.ml 19572-19963)               -/
/- ------------------------------------------------------------------------- -/

structure INBF where
  HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM : thm
  INCREASING_LEFT_LIMIT_1 : thm
  DECREASING_LEFT_LIMIT_1 : thm
  INCREASING_RIGHT_LIMIT_1 : thm
  DECREASING_RIGHT_LIMIT_1 : thm
  HAS_BOUNDED_VECTOR_VARIATION_LEFT_LIMIT : thm
  HAS_BOUNDED_VECTOR_VARIATION_RIGHT_LIMIT : thm
  HAS_BOUNDED_VARIATION_RIGHT_LIMIT_GEN : thm
  HAS_BOUNDED_VARIATION_LEFT_LIMIT_GEN : thm
  INCREASING_LEFT_LIMIT_1_GEN : thm
  DECREASING_LEFT_LIMIT_1_GEN : thm
  INCREASING_RIGHT_LIMIT_1_GEN : thm
  DECREASING_RIGHT_LIMIT_1_GEN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBF [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) (BINBA : INBA) (BINBB : INBB) : ExceptT String IO INBF := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, HAS_BOUNDED_VECTOR_VARIATION, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, .. } := BINAW
  let { HAS_BOUNDED_VARIATION_ON_CLOSURE, .. } := BINAX
  let { INCREASING_BOUNDED_VARIATION_GEN, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_DARBOUX, .. } := BINBB
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, ETA_AX, EXTENSION, FINITE_IMAGE,
        FINITE_UNION, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_EQ_EMPTY, IMAGE_ID, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        MONO_FORALL, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_NEG2, REAL_LE_TRANS, REAL_LT_01,
        REAL_LT_DIV, REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_POS, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { SUM_BOUND, SUM_SUB, SUP, SWAP_FORALL_THM, UNION_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { LAMBDA_SKOLEM, REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_NZ, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_EQ, DROP_SUB, ENDS_IN_INTERVAL, EXISTS_LIFT, LIFT_DROP, NORM_1, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { dist, drop, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { CENTRE_IN_CBALL, CLOSED_CLOSURE, CLOSED_INTER_COMPACT, .. } := D.dv.dg.pt.cvx.top1
  let { CLOSURE_INC, COMPACT_CBALL, .. } := D.dv.dg.pt.cvx.top2
  let { EVENTUALLY_AT, .. } := D.dv.dg.pt.cvx.top3
  let { IN_CBALL, IN_INTERVAL_1, IS_INTERVAL_INTERVAL, LIM_SEQUENTIALLY, LIM_SUB,
        LIM_WITHIN, LIMPT_APPROACHABLE, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, closure, TRIVIAL_LIMIT_WITHIN, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { CONVEX_CBALL, CONVEX_CLOSURE, CONVEX_INTER, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { LIMPT_SUBSET, .. } := D.dv.qtopology1
  let { LIM_COMPONENTWISE_LIFT, LIM_TRIVIAL, .. } := D.dv.qtopology2
  let { CONNECTED_COMPACT_INTERVAL_1, CONNECTED_CONVEX_1, .. } := D.qconvex
  let { UPPER_BOUND_FINITE_SET, .. } := D.qmisc
  let { IS_INTERVAL_INTER, IS_INTERVAL_REFLECT, LIM_NEG_EQ, LIM_TRANSFORM_WITHIN_SET_IMP, ..
        } := D.qtopology
  let { DIST_REAL, IN_INTERVAL_REFLECT, .. } := D.qvec
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM ← prove
   r"!f:num->real^1->real^N g s b.
        (!n. (f n) has_bounded_variation_on s) /\
        (!n. vector_variation s (f n) <= b) /\
        (!x. x IN s ==> ((\n. f n x) --> g x) sequentially)
        ==> g has_bounded_variation_on s /\ vector_variation s g <= b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!e. &0 < e
        ==> (g:real^1->real^N) has_bounded_variation_on s /\
            vector_variation s g <= b + e")
     (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"(vector_variation s (g:real^1->real^N) - b) / &2") th) THEN
              REWRITE_TAC [← MATCH_MP th REAL_LT_01]))
    THENL [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC, REAL_ARITH_TAC] THEN
    REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    SUBGOAL_THEN
     (← q r"?n. !x:real^1. x IN ({interval_lowerbound k | k IN d} UNION
                         {interval_upperbound k | k IN d})
                   ==> norm((f:num->real^1->real^N) n x - g x)
                       <= e / (&(CARD(d:(real^1->bool)->bool)) + &1) / &2")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o
        REWRITE_RULE [RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, IMP_IMP] o
        GEN_REWRITE_RULE (BINDER_CONV o RAND_CONV) [LIM_SEQUENTIALLY]) THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o
        SPEC (← q r"e / (&(CARD(d:(real^1->bool)->bool)) + &1) / &2")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &n + &1"), REAL_HALF] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"M:real^1->num") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"M:real^1->num",
                        ← q r"{interval_lowerbound k:real^1 | k IN d} UNION
                    {interval_upperbound k | k IN d}"]
          UPPER_BOUND_FINITE_SET) THEN
      ASM_SIMP_TAC [FINITE_UNION, SIMPLE_IMAGE, FINITE_IMAGE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^1") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
      REWRITE_TAC [← GSYM dist] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      REWRITE_TAC [UNION_SUBSET] THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
