        ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^M")) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [LIM_SEQUENTIALLY] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
                MP_TAC (← SPEC (← q r"e / &2") th))) THEN
        ASM_REWRITE_TAC [REAL_HALF] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"M:num") THEN
        REWRITE_TAC [dist, NORM_1, DROP_SUB, LIFT_DROP] THEN
        STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_SUP_ASCLOSE THEN
        REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [LE_TRANS, REAL_LT_IMP_LE]] THEN
        REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
        MESON_TAC [LE_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [bounded, FORALL_IN_IMAGE, IN_ELIM_THM, IN_UNIV] THEN
      EXISTS_TAC (← q r"drop(integral s (h:real^M->real^1))") THEN
      X_GEN_TAC (← q r"p:num") THEN MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      REWRITE_TAC [NORM_1, LIFT_DROP] THEN
      MATCH_MP_TAC REAL_ABS_SUP_LE THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
      ASM_SIMP_TAC [← GSYM NORM_1, IN_ELIM_THM] THEN
      REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
      MESON_TAC [LE_REFL],
      DISCH_THEN (LABEL_TAC "B")] THEN
    ASM_REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REMOVE_THEN "A" (MP_TAC o REWRITE_RULE [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") (LABEL_TAC "N1")) THEN
    REMOVE_THEN "B" (MP_TAC o REWRITE_RULE [LIM_SEQUENTIALLY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") (LABEL_TAC "N2")) THEN
    EXISTS_TAC (← q r"N1 + N2:num") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    REMOVE_THEN "N1" (MP_TAC o SPEC (← q r"n:num")) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2 <= n ==> N1:num <= n")], ALL_TAC] THEN
    REMOVE_THEN "N2" (MP_TAC o SPEC (← q r"n:num")) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [← ARITH_RULE (← q r"N1 + N2 <= n ==> N2:num <= n")], ALL_TAC] THEN
    REWRITE_TAC [dist, NORM_1, DROP_SUB, LIFT_DROP] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"i0 <= i /\ i <= i1
      ==> abs(i1 - g) < e ==> abs(i0 - g) < e ==> abs(i - g) < e")) THEN
    CONJ_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN
    ASM_REWRITE_TAC [LIFT_DROP] THEN X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THENL
     [specRandLhand INF THEN
      REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
        CONJ_TAC THENL [MESON_TAC [LE_REFL], ALL_TAC] THEN
        EXISTS_TAC (← q r"--drop(h(x:real^M))") THEN GEN_TAC THEN DISCH_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) <= a ==> --a <= x")) THEN
        REWRITE_TAC [← GSYM NORM_1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN (MATCH_MP_TAC o CONJUNCT1) THEN REWRITE_TAC [LE_REFL]],
      specRandRand SUP THEN
      REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM, NOT_FORALL_THM] THEN
        CONJ_TAC THENL [MESON_TAC [LE_REFL], ALL_TAC] THEN
        EXISTS_TAC (← q r"drop(h(x:real^M))") THEN GEN_TAC THEN DISCH_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs(x) <= a ==> x <= a")) THEN
        REWRITE_TAC [← GSYM NORM_1] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [],
        DISCH_THEN (MATCH_MP_TAC o CONJUNCT1) THEN REWRITE_TAC [LE_REFL]]])

  pure { DOMINATED_CONVERGENCE }

