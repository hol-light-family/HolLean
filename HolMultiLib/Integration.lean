    MP_TAC (← ISPECL [← q r"\x. (f:real^1->real^1) (--x)",
                      ← q r"IMAGE (--) (s:real^1->bool)", ← q r"--a:real^1", ← q r"B:real"]
          DECREASING_LEFT_LIMIT_1_GEN) THEN
    ASM_REWRITE_TAC [IS_INTERVAL_REFLECT] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, VECTOR_NEG_NEG] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [VECTOR_NEG_NEG, DROP_NEG, REAL_LE_NEG2] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"l:real^1") THEN REWRITE_TAC [LIM_WITHIN] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← MESON [VECTOR_NEG_NEG] (← q r"(!x:real^1. P x) <=> (!x. P (--x))")] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(--x:real^1,--y) = dist(x,y)")] THEN
    REWRITE_TAC [IN_ELIM_THM, VECTOR_NEG_NEG, DROP_NEG, REAL_LE_NEG2] THEN
    REWRITE_TAC [IN_IMAGE] THEN MESON_TAC [])

  let DECREASING_RIGHT_LIMIT_1_GEN ← prove
   r"!f s a B.
     is_interval s /\
     (!x. x IN s ==> drop(f x) <= B) /\
     (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f y) <= drop(f x))
      ==> ?l. (f --> l) (at a within {x | x IN s /\ drop a <= drop x})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. --((f:real^1->real^1) x)", ← q r"s:real^1->bool", ← q r"a:real^1",
      ← q r"--B:real"]
          INCREASING_RIGHT_LIMIT_1_GEN) THEN
    ASM_REWRITE_TAC [REAL_LE_NEG2, DROP_NEG] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM LIM_NEG_EQ] THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX] THEN MESON_TAC [])

  pure { HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM, INCREASING_LEFT_LIMIT_1,
         DECREASING_LEFT_LIMIT_1, INCREASING_RIGHT_LIMIT_1, DECREASING_RIGHT_LIMIT_1,
         HAS_BOUNDED_VECTOR_VARIATION_LEFT_LIMIT, HAS_BOUNDED_VECTOR_VARIATION_RIGHT_LIMIT,
         HAS_BOUNDED_VARIATION_RIGHT_LIMIT_GEN, HAS_BOUNDED_VARIATION_LEFT_LIMIT_GEN,
         INCREASING_LEFT_LIMIT_1_GEN, DECREASING_LEFT_LIMIT_1_GEN,
         INCREASING_RIGHT_LIMIT_1_GEN, DECREASING_RIGHT_LIMIT_1_GEN }

/- ------------------------------------------------------------------------- -/
/- Left continuity of the variation function.  (integration.ml 19964-20247) -/
/- ------------------------------------------------------------------------- -/

structure INBG where
  VECTOR_VARIATION_CONTINUOUS_LEFT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBG [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBA : INBA) (BINBB : INBB) (BINBF : INBF) : ExceptT String IO INBG := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_COMPARISON, HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
        VECTOR_VARIATION_COMPARISON, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_NEG, HAS_BOUNDED_VARIATION_ON_SUBSET,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_NEG, VECTOR_VARIATION_POS_LE,
        VECTOR_VARIATION_SUM_LE, VECTOR_VARIATION_TRIANGLE, .. } := BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { INCREASING_BOUNDED_VARIATION, INCREASING_VECTOR_VARIATION, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_DARBOUX, .. } := BINBB
  let { INCREASING_LEFT_LIMIT_1, .. } := BINBF
  let { ETA_AX, FINITE_NUMSEG, .. } := D.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, LEFT_IMP_EXISTS_THM, MONO_EXISTS, REAL_ABS_NUM, .. } :=
