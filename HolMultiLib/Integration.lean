  ABSOLUTELY_CONTINUOUS_ON_CONST : thm
  ABSOLUTELY_CONTINUOUS_ON_CMUL : thm
  ABSOLUTELY_CONTINUOUS_ON_CMUL_EQ : thm
  ABSOLUTELY_CONTINUOUS_ON_VMUL_EQ : thm
  ABSOLUTELY_CONTINUOUS_ON_VMUL : thm
  ABSOLUTELY_CONTINUOUS_ON_NEG : thm
  ABSOLUTELY_CONTINUOUS_ON_ADD : thm
  ABSOLUTELY_CONTINUOUS_ON_SUB : thm
  ABSOLUTELY_CONTINUOUS_ON_COMPOSE_LINEAR : thm
  ABSOLUTELY_CONTINUOUS_ON_NULL : thm
  ABSOLUTELY_CONTINUOUS_ON_EMPTY : thm
  ABSOLUTELY_CONTINUOUS_ON_NORM : thm
  ABSOLUTELY_CONTINUOUS_ON_MAX : thm
  ABSOLUTELY_CONTINUOUS_ON_MIN : thm
  ABSOLUTELY_CONTINUOUS_LIPSCHITZ_COMPOSE : thm
  ABSOLUTELY_CONTINUOUS_ON_ID : thm
  LIPSCHITZ_IMP_ABSOLUTELY_CONTINUOUS : thm
  ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS : thm
  ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS : thm
  ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBT [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAX : INAX) (BINBR : INBR) (BINBS : INBS) : ExceptT String IO INBT := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_EMPTY, INTERVAL_BOUNDS_NULL_1, INTERVAL_LOWERBOUND,
        INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND,
        INTERVAL_UPPERBOUND_1, INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { DIVISION_OF_FINITE, DIVISION_OF_SELF, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { has_bounded_variation_on, .. } := BINAV
  let { OPERATIVE_FUNCTION_ENDPOINT_DIFF, .. } := BINAX
  let { ABSOLUTELY_SETCONTINUOUS_COMPARISON, absolutely_setcontinuous_on,
        ABSOLUTELY_SETCONTINUOUS_ON_0, ABSOLUTELY_SETCONTINUOUS_ON_ADD,
        ABSOLUTELY_SETCONTINUOUS_ON_CMUL, ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE,
        ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR, ABSOLUTELY_SETCONTINUOUS_ON_EQ,
        ABSOLUTELY_SETCONTINUOUS_ON_NEG, ABSOLUTELY_SETCONTINUOUS_ON_NULL,
        ABSOLUTELY_SETCONTINUOUS_ON_SUB, ABSOLUTELY_SETCONTINUOUS_ON_SUBSET, .. } := BINBR
  let { ABSOLUTELY_SETCONTINUOUS_ON_IMP_HAS_BOUNDED_SETVARIATION_ON, .. } := BINBS
  let { EQ_TRANS, ETA_AX, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } :=
        D.dv.dg.pt.cvx.core2
  let { MONO_EXISTS, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_SYM, REAL_WLOG_LE, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_LE, SUM_SING, .. } := D.dv.dg.pt.cvx.core6
  let { DIST_LIFT, DIST_REFL, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_SUB, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, INTERVAL_NE_EMPTY, LIFT_ADD,
        LIFT_CMUL, LIFT_DROP, LIFT_SUB, LINEAR_SUB, NORM_1, NORM_EQ_0, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_POS_LE, REAL_ABS_NORM, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_SUB_COMPONENT, VECTOR_SUB_LDISTRIB, VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL, ..
        } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_EMPTY, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, new_definition, NORM_ARITH, parse_as_infix, REAL_ARITH,
        REAL_ARITH_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { uniformly_continuous_on, .. } := D.dv.dg.qtopology2
  let { UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS, .. } := D.qtopology
  let { DIST_REAL, NORM_REAL, .. } := D.qvec
  -- @@SCOPE END

  parse_as_infix ("absolutely_continuous_on", (12, "right"))

  let absolutely_continuous_on ← new_definition
   r"(f:real^1->real^N) absolutely_continuous_on s <=>
        (\k. f(interval_upperbound k) - f(interval_lowerbound k))
        absolutely_setcontinuous_on s"

  let ABSOLUTELY_CONTINUOUS_ON_EQ ← prove
   r"!f g:real^1->real^N s.
        (!x. x IN s ==> f x = g x) /\ f absolutely_continuous_on s
        ==> g absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [absolutely_continuous_on] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] ABSOLUTELY_SETCONTINUOUS_ON_EQ) THEN
    SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND,
              ← GSYM INTERVAL_NE_EMPTY] THEN
    ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET])

  let ABSOLUTELY_CONTINUOUS_ISOMETRIC ← prove
   r"!f g:real^1->real^N s.
        (!x y. dist(f x,f y) = dist(g x,g y))
        ==> (f absolutely_continuous_on s <=> g absolutely_continuous_on s)"
   (SIMP_TAC [absolutely_continuous_on, absolutely_setcontinuous_on,
              o_DEF, dist])

  let ABSOLUTELY_CONTINUOUS_ISOMETRIC_COMPOSE ← prove
   r"!f:real^M->real^N g s.
        (!x y. dist(f x,f y) = dist(x,y))
        ==> ((f o g) absolutely_continuous_on s <=>
             g absolutely_continuous_on s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ISOMETRIC THEN
    ASM_REWRITE_TAC [o_DEF])

  let ABSOLUTELY_CONTINUOUS_ON_TRANSLATION ← prove
   r"!f:real^1->real^N s a.
   (\x. a + f x) absolutely_continuous_on s <=> f absolutely_continuous_on s"
   (REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (a + y):real^N = x - y")])

  let ABSOLUTELY_CONTINUOUS_ON_COMPONENTWISE ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\x. lift(f x$i)) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    GEN_REWRITE_TAC LAND_CONV [ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE] THEN
    REWRITE_TAC [VECTOR_SUB_COMPONENT, LIFT_SUB])

  let ABSOLUTELY_CONTINUOUS_ON_LIFT_COMPONENT ← prove
   r"!(f:real^1->real^N) s.
        f absolutely_continuous_on s /\
        1 <= i /\ i <= dimindex(:N)
        ==> (\x. lift(f x$i)) absolutely_continuous_on s"
   (MESON_TAC [ABSOLUTELY_CONTINUOUS_ON_COMPONENTWISE])

  let ABSOLUTELY_CONTINUOUS_COMPARISON ← prove
   r"!f:real^1->real^M g:real^1->real^N s.
        f absolutely_continuous_on s /\
        (!x y. x IN s /\ y IN s /\ drop x < drop y
               ==> dist(g x,g y) <= dist(f x,f y))
        ==> g absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [absolutely_continuous_on] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     ABSOLUTELY_SETCONTINUOUS_COMPARISON) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM dist] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s
          ==> dist((g:real^1->real^N) x,g y)
              <= dist((f:real^1->real^M) x,f y)")
    MATCH_MP_TAC THENL
     [REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [DIST_REFL, REAL_LE_REFL] THEN
      CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN ASM_MESON_TAC [],
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                    INTERVAL_UPPERBOUND_NONEMPTY] THEN
      ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET]])

  let ABSOLUTELY_CONTINUOUS_ON_LIFT_ABS ← prove
   r"!f:real^1->real.
        (\x. lift(f x)) absolutely_continuous_on s
        ==> (\x. lift(abs(f x))) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      ABSOLUTELY_CONTINUOUS_COMPARISON) THEN
    REWRITE_TAC [DIST_LIFT] THEN REAL_ARITH_TAC)

  let ABSOLUTELY_CONTINUOUS_ON_SUBSET ← prove
   r"!f:real^1->real^N s t.
        f absolutely_continuous_on s /\ t SUBSET s
        ==> f absolutely_continuous_on t"
   (REWRITE_TAC [ABSOLUTELY_SETCONTINUOUS_ON_SUBSET, absolutely_continuous_on])

  let ABSOLUTELY_CONTINUOUS_ON_CONST ← prove
   r"!s c:real^N. (\x. c) absolutely_continuous_on s"
   (REWRITE_TAC [absolutely_continuous_on, VECTOR_SUB_REFL,
                 ABSOLUTELY_SETCONTINUOUS_ON_0])

  let ABSOLUTELY_CONTINUOUS_ON_CMUL ← prove
   r"!f:real^1->real^N c s.
        f absolutely_continuous_on s
        ==> (\x. c % f x) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, ABSOLUTELY_SETCONTINUOUS_ON_CMUL])

  let ABSOLUTELY_CONTINUOUS_ON_CMUL_EQ ← prove
   r"!f:real^1->real^N c s.
        (\x. c % f x) absolutely_continuous_on s <=>
        c = &0 \/ f absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, ABSOLUTELY_CONTINUOUS_ON_CONST] THEN
    EQ_TAC THEN REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_CMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c:real)") o MATCH_MP
       ABSOLUTELY_CONTINUOUS_ON_CMUL) THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LID, REAL_MUL_LINV, ETA_AX])

  let ABSOLUTELY_CONTINUOUS_ON_VMUL_EQ ← prove
   r"!f s v:real^N.
        (\x. f(x) % v) absolutely_continuous_on s <=>
        v = vec 0 \/ (\x. lift(f x)) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN
    TRANS_TAC EQ_TRANS
     (← q r"(\x. norm(v:real^N) % lift(f x)) absolutely_continuous_on s") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ISOMETRIC THEN
      REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, ← GSYM VECTOR_SUB_RDISTRIB] THEN
      REWRITE_TAC [NORM_MUL, ← GSYM LIFT_SUB, NORM_LIFT, REAL_ABS_NORM] THEN
      REWRITE_TAC [REAL_MUL_SYM],
      REWRITE_TAC [ABSOLUTELY_CONTINUOUS_ON_CMUL_EQ, NORM_EQ_0]])

  let ABSOLUTELY_CONTINUOUS_ON_VMUL ← prove
   r"!f s v:real^N.
        (\x. lift(f x)) absolutely_continuous_on s
        ==> (\x. f(x) % v) absolutely_continuous_on s"
   (SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_VMUL_EQ])

  let ABSOLUTELY_CONTINUOUS_ON_NEG ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on s
        ==> (\x. --f x) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"--a - --b:real^N = --(a - b)"),
                 ABSOLUTELY_SETCONTINUOUS_ON_NEG])

  let ABSOLUTELY_CONTINUOUS_ON_ADD ← prove
   r"!f g:real^1->real^N s.
        f absolutely_continuous_on s /\ g absolutely_continuous_on s
        ==> (\x. f x + g x) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(f + g) - (f' + g'):real^N = (f - f') + (g - g')"),
                 ABSOLUTELY_SETCONTINUOUS_ON_ADD])

  let ABSOLUTELY_CONTINUOUS_ON_SUB ← prove
   r"!f g:real^1->real^N s.
        f absolutely_continuous_on s /\ g absolutely_continuous_on s
        ==> (\x. f x - g x) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(f - g) - (f' - g'):real^N = (f - f') - (g - g')"),
                 ABSOLUTELY_SETCONTINUOUS_ON_SUB])

  let ABSOLUTELY_CONTINUOUS_ON_COMPOSE_LINEAR ← prove
   r"!f:real^1->real^M g:real^M->real^N s.
        f absolutely_continuous_on s /\ linear g
        ==> (g o f) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    SIMP_TAC [o_THM, ← GSYM LINEAR_SUB] THEN
    DISCH_THEN (MP_TAC o MATCH_MP ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR) THEN
    REWRITE_TAC [o_DEF])

  let ABSOLUTELY_CONTINUOUS_ON_NULL ← prove
   r"!f:real^1->real^N s.
        content s = &0 /\ bounded s ==> f absolutely_continuous_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    MATCH_MP_TAC ABSOLUTELY_SETCONTINUOUS_ON_NULL THEN
    ASM_SIMP_TAC [INTERVAL_BOUNDS_NULL_1, VECTOR_SUB_REFL])

  let ABSOLUTELY_CONTINUOUS_ON_EMPTY ← prove
   r"!f:real^1->real^N. f absolutely_continuous_on {}"
   (MESON_TAC [CONTENT_EMPTY, BOUNDED_EMPTY, ABSOLUTELY_CONTINUOUS_ON_NULL])

  let ABSOLUTELY_CONTINUOUS_ON_NORM ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on s
        ==> (\x. lift(norm(f x))) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          ABSOLUTELY_CONTINUOUS_COMPARISON) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [DIST_LIFT] THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let ABSOLUTELY_CONTINUOUS_ON_MAX ← prove
   r"!f g s. f absolutely_continuous_on s /\ g absolutely_continuous_on s
           ==> (\x. lift(max (drop(f x)) (drop(g x))))
               absolutely_continuous_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"max a b = inv(&2) * (a + b + abs(a - b))")] THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_ADD, LIFT_DROP, ← GSYM DROP_SUB] THEN
    REWRITE_TAC [drop, ← GSYM NORM_REAL] THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_CMUL THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_ADD THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_ADD THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_NORM THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUB THEN ASM_REWRITE_TAC [])

  let ABSOLUTELY_CONTINUOUS_ON_MIN ← prove
   r"!f g s. f absolutely_continuous_on s /\ g absolutely_continuous_on s
           ==> (\x. lift(min (drop(f x)) (drop(g x))))
               absolutely_continuous_on s"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"min a b = inv(&2) * ((a + b) - abs(a - b))")] THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_ADD, LIFT_DROP, LIFT_SUB, ← GSYM DROP_SUB] THEN
    REWRITE_TAC [drop, ← GSYM NORM_REAL] THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_CMUL THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUB THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_ADD] THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_NORM THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_SUB THEN ASM_REWRITE_TAC [])

  let ABSOLUTELY_CONTINUOUS_LIPSCHITZ_COMPOSE ← prove
   r"!f:real^M->real^N g s B.
        g absolutely_continuous_on s /\
        (!x y. x IN IMAGE g s /\ y IN IMAGE g s
               ==> norm(f x - f y) <= B * norm(x - y))
        ==> (f o g) absolutely_continuous_on s"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"\x. B % (g:real^1->real^M) x")
          ABSOLUTELY_CONTINUOUS_COMPARISON) THEN
    ASM_REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_CMUL, o_DEF] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    REAL_ARITH_TAC)

  let ABSOLUTELY_CONTINUOUS_ON_ID ← prove
   r"!s:real^1->bool. (\x. x) absolutely_continuous_on s"
   (GEN_TAC THEN
    REWRITE_TAC [absolutely_continuous_on, absolutely_setcontinuous_on] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"e:real") THEN
    ASM_REWRITE_TAC [] THEN REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    MATCH_MP_TAC SUM_LE THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_FINITE], ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    SIMP_TAC [CONTENT_1, INTERVAL_NE_EMPTY_1, NORM_1, DROP_SUB] THEN
    REAL_ARITH_TAC)

  let LIPSCHITZ_IMP_ABSOLUTELY_CONTINUOUS ← prove
   r"!f:real^1->real^N s B.
        bounded s /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> f absolutely_continuous_on s"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^1->real^N", ← q r"\x:real^1. x", ← q r"s:real^1->bool", ← q r"B:real"]
     ABSOLUTELY_CONTINUOUS_LIPSCHITZ_COMPOSE) THEN
    ASM_REWRITE_TAC [o_DEF, IMAGE_ID, ETA_AX] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [ABSOLUTELY_CONTINUOUS_ON_ID])

  let ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on s /\ is_interval s
        ==> f uniformly_continuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [absolutely_continuous_on, uniformly_continuous_on,
                 absolutely_setcontinuous_on, IS_INTERVAL_1] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [FORALL_LIFT] THEN
    MATCH_MP_TAC REAL_WLOG_LE THEN
    CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{interval[a:real^1,b]}", ← q r"interval[a:real^1,b]"]) THEN
    ASM_SIMP_TAC [DIVISION_OF_SELF, INTERVAL_NE_EMPTY_1, SUM_SING, dist,
                  INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, CONTENT_1] THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV [DIST_REAL]) THEN
      REWRITE_TAC [drop] THEN REAL_ARITH_TAC])

  let ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS ← prove
   r"!f s. f absolutely_continuous_on s /\ is_interval s
         ==> f continuous_on s"
   (MESON_TAC [ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS,
               UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS])

  let ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on s /\ bounded s
        ==> f has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [absolutely_continuous_on, has_bounded_variation_on] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
          ABSOLUTELY_SETCONTINUOUS_ON_IMP_HAS_BOUNDED_SETVARIATION_ON) THEN
    REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  pure { absolutely_continuous_on, ABSOLUTELY_CONTINUOUS_ON_EQ,
         ABSOLUTELY_CONTINUOUS_ISOMETRIC, ABSOLUTELY_CONTINUOUS_ISOMETRIC_COMPOSE,
         ABSOLUTELY_CONTINUOUS_ON_TRANSLATION, ABSOLUTELY_CONTINUOUS_ON_COMPONENTWISE,
         ABSOLUTELY_CONTINUOUS_ON_LIFT_COMPONENT, ABSOLUTELY_CONTINUOUS_COMPARISON,
         ABSOLUTELY_CONTINUOUS_ON_LIFT_ABS, ABSOLUTELY_CONTINUOUS_ON_SUBSET,
         ABSOLUTELY_CONTINUOUS_ON_CONST, ABSOLUTELY_CONTINUOUS_ON_CMUL,
         ABSOLUTELY_CONTINUOUS_ON_CMUL_EQ, ABSOLUTELY_CONTINUOUS_ON_VMUL_EQ,
         ABSOLUTELY_CONTINUOUS_ON_VMUL, ABSOLUTELY_CONTINUOUS_ON_NEG,
         ABSOLUTELY_CONTINUOUS_ON_ADD, ABSOLUTELY_CONTINUOUS_ON_SUB,
         ABSOLUTELY_CONTINUOUS_ON_COMPOSE_LINEAR, ABSOLUTELY_CONTINUOUS_ON_NULL,
         ABSOLUTELY_CONTINUOUS_ON_EMPTY, ABSOLUTELY_CONTINUOUS_ON_NORM,
         ABSOLUTELY_CONTINUOUS_ON_MAX, ABSOLUTELY_CONTINUOUS_ON_MIN,
         ABSOLUTELY_CONTINUOUS_LIPSCHITZ_COMPOSE, ABSOLUTELY_CONTINUOUS_ON_ID,
         LIPSCHITZ_IMP_ABSOLUTELY_CONTINUOUS,
         ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS,
         ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
         ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON }

/- ------------------------------------------------------------------------- -/
/- Absolute continuity: bilinear products, sums, operativity, combining.    -/
/- (integration.ml 23362-23497)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBU where
  ABSOLUTELY_CONTINUOUS_ON_BILINEAR : thm
  ABSOLUTELY_CONTINUOUS_ON_MUL : thm
  ABSOLUTELY_CONTINUOUS_ON_VSUM : thm
  OPERATIVE_ABSOLUTELY_CONTINUOUS_ON : thm
  ABSOLUTELY_CONTINUOUS_ON_DIVISION : thm
  ABSOLUTELY_CONTINUOUS_ON_COMBINE : thm
  ABSOLUTELY_CONTINUOUS_ON_SING : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBU [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BING : ING) (BINAW : INAW) (BINAX : INAX) (BINBR : INBR) (BINBS : INBS) (BINBT : INBT) : ExceptT String IO INBU := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY, .. } :=
        BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { operative, .. } := BING
  let { HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED, .. } := BINAW
  let { OPERATIVE_FUNCTION_ENDPOINT_DIFF, .. } := BINAX
  let { absolutely_setcontinuous_on, .. } := BINBR
  let { ABSOLUTELY_SETCONTINUOUS_ON_DIVISION, OPERATIVE_ABSOLUTELY_SETCONTINUOUS_ON, .. } :=
        BINBS
  let { absolutely_continuous_on, ABSOLUTELY_CONTINUOUS_ON_ADD,
        ABSOLUTELY_CONTINUOUS_ON_CONST,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_NULL, .. } := BINBT
  let { CONJ_ASSOC, DIMINDEX_1, ETA_AX, EXTENSION, FINITE_INDUCT_STRONG, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, LE_REFL, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ADD2, REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_ADD2, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LTE_TRANS, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, SUBSET, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { SUM_ADD, SUM_CLAUSES, SUM_LE, SUM_LMUL, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { ENDS_IN_INTERVAL, INTERVAL_SING, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_POS_LE, .. } := D.dv.dg.pt.cvx.vec3
  let { drop, VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS_LT, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_FIELD, .. } := D.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { BILINEAR_BOUNDED_POS, BILINEAR_DROP_MUL, BILINEAR_LSUB, BILINEAR_RSUB, .. } :=
        D.dv.qvec
  -- @@SCOPE END

  let ABSOLUTELY_CONTINUOUS_ON_BILINEAR ← prove
   r"!bop:real^M->real^N->real^P f g s.
        bilinear bop /\
        f absolutely_continuous_on s /\
        g absolutely_continuous_on s /\
        is_interval s /\ bounded s
        ==> (\x. bop (f x) (g x)) absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
      (← q r"bounded(IMAGE (f:real^1->real^M) s) /\
     bounded(IMAGE (g:real^1->real^N) s)")
    MP_TAC THENL
     [ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED,
                     ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON],
      REWRITE_TAC [BOUNDED_POS_LT, FORALL_IN_IMAGE]] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
    REWRITE_TAC [absolutely_continuous_on, absolutely_setcontinuous_on] THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"e / &2 / B1 / D:real"))
     (MP_TAC o SPEC (← q r"e / &2 / B2 / D:real"))) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_HALF, LEFT_IMP_EXISTS_THM] THEN

    X_GEN_TAC (← q r"r1:real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"r2:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min r1 r2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    TRANS_TAC REAL_LTE_TRANS (← q r"D * B1 * e / &2 / B1 / D +
                            D * B2 * e / &2 / B2 / D") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP REAL_LT_IMP_NZ)) THEN
      CONV_TAC (fun t => REAL_FIELD t)] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC
     (← q r"D * B1 * sum d (\k. norm((g:real^1->real^N)(interval_upperbound k) -
                             g(interval_lowerbound k))) +
    D * B2 * sum d (\k. norm((f:real^1->real^M)(interval_upperbound k) -
                             f(interval_lowerbound k)))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_LT_ADD2 THEN ASM_MESON_TAC [REAL_LT_LMUL_EQ]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM SUM_LMUL, ← GSYM SUM_ADD] THEN
    MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"norm((bop:real^M->real^N->real^P) (f v) (g v) - bop (f v) (g u)) +
    norm(bop (f v) (g u) - bop (f(u:real^1)) (g u))") THEN
    CONJ_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP BILINEAR_LSUB th)] THEN
            REWRITE_TAC [← GSYM (← MATCH_MP BILINEAR_RSUB th)])) THEN
    FIRST_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THENL
     [ALL_TAC, GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM]] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    (SUBGOAL_THEN (← q r"interval[u:real^1,v] SUBSET s") MP_TAC THENL
     [ASM_MESON_TAC [division_of, SUBSET_TRANS], ALL_TAC]) THEN
    ASM_MESON_TAC [SUBSET, ENDS_IN_INTERVAL])

  let ABSOLUTELY_CONTINUOUS_ON_MUL ← prove
   r"!f g:real^1->real^N s.
        f absolutely_continuous_on s /\
        g absolutely_continuous_on s /\
        is_interval s /\ bounded s
        ==> (\x. drop(f x) % g x) absolutely_continuous_on s"
   (REWRITE_TAC [← REWRITE_RULE []
     (← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] ABSOLUTELY_CONTINUOUS_ON_BILINEAR)
          BILINEAR_DROP_MUL)])

  let ABSOLUTELY_CONTINUOUS_ON_VSUM ← prove
   r"!f:A->real^1->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i absolutely_continuous_on s)
        ==> (\x. vsum k (\i. f i x)) absolutely_continuous_on s"
   (
    GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [REAL_LE_REFL, ABSOLUTELY_CONTINUOUS_ON_CONST,
              ABSOLUTELY_CONTINUOUS_ON_ADD, ETA_AX, NOT_IN_EMPTY])

  let OPERATIVE_ABSOLUTELY_CONTINUOUS_ON ← prove
   r"!f:real^1->real^N.
        operative (/\) ((absolutely_continuous_on) f)"
   (GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    REWRITE_TAC [absolutely_continuous_on] THEN
    REWRITE_TAC [ETA_AX] THEN
    MATCH_MP_TAC OPERATIVE_ABSOLUTELY_SETCONTINUOUS_ON THEN
    REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  let ABSOLUTELY_CONTINUOUS_ON_DIVISION ← prove
   r"!f:real^1->real^N a b d.
        d division_of interval[a,b]
        ==> ((!k. k IN d ==> f absolutely_continuous_on k) <=>
             f absolutely_continuous_on interval[a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [absolutely_continuous_on] THEN
    MATCH_MP_TAC ABSOLUTELY_SETCONTINUOUS_ON_DIVISION THEN
    ASM_REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  let ABSOLUTELY_CONTINUOUS_ON_COMBINE ← prove
   r"!f:real^1->real^N a b c.
        drop a <= drop c /\ drop c <= drop b
        ==> (f absolutely_continuous_on interval[a,b] <=>
             f absolutely_continuous_on interval[a,c] /\
             f absolutely_continuous_on interval[c,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"f:real^1->real^N") OPERATIVE_ABSOLUTELY_CONTINUOUS_ON) THEN
    REWRITE_TAC [operative] THEN DISCH_THEN (MP_TAC o
     SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"drop c", ← q r"1"] o CONJUNCT2) THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN DISCH_THEN SUBST1_TAC THEN
    BINOP_TAC THEN AP_TERM_TAC THEN
    SIMP_TAC [EXTENSION, IN_INTER, ← GSYM drop, IN_INTERVAL_1, IN_ELIM_THM] THEN
    ASM_REAL_ARITH_TAC)

  let ABSOLUTELY_CONTINUOUS_ON_SING ← prove
   r"!f a. f absolutely_continuous_on {a}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_NULL THEN
    REWRITE_TAC [← GSYM INTERVAL_SING, BOUNDED_INTERVAL] THEN
    REWRITE_TAC [CONTENT_EQ_0_1, REAL_LE_REFL])

  pure { ABSOLUTELY_CONTINUOUS_ON_BILINEAR, ABSOLUTELY_CONTINUOUS_ON_MUL,
         ABSOLUTELY_CONTINUOUS_ON_VSUM, OPERATIVE_ABSOLUTELY_CONTINUOUS_ON,
         ABSOLUTELY_CONTINUOUS_ON_DIVISION, ABSOLUTELY_CONTINUOUS_ON_COMBINE,
         ABSOLUTELY_CONTINUOUS_ON_SING }

/- ------------------------------------------------------------------------- -/
/- Absolute continuity from the interior; closure; extension to closure.    -/
/- (integration.ml 23498-23822)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBV where
  ABSOLUTELY_CONTINUOUS_ON_INTERIOR : thm
  ABSOLUTELY_CONTINUOUS_ON_INTERIOR_EQ : thm
  ABSOLUTELY_CONTINUOUS_ON_CLOSURE : thm
  ABSOLUTELY_CONTINUOUS_ON_CLOSURE_EQ : thm
  ABSOLUTELY_CONTINUOUS_EXTENDS_TO_CLOSURE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBV [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINBR : INBR) (BINBT : INBT) : ExceptT String IO INBV := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_POS_LE, CONTENT_SUBSET, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { absolutely_setcontinuous_on, .. } := BINBR
  let { absolutely_continuous_on, ABSOLUTELY_CONTINUOUS_ON_EQ,
        ABSOLUTELY_CONTINUOUS_ON_IMP_UNIFORMLY_CONTINUOUS, ABSOLUTELY_CONTINUOUS_ON_SUBSET,
        .. } := BINBT
  let { CONTRAPOS_THM, FINITE_IMAGE, FINITE_RESTRICT, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, MONO_IMP, REAL_ABS_INV, REAL_ABS_NUM, REAL_ARCH_POW_INV,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_SQUARE_ABS, REAL_INV_LE_1, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_MUL, REAL_LET_TRANS, REAL_LT_INV_EQ, REAL_LT_MUL, REAL_LT_POW2, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_POS, REAL_POW_INV, REAL_POW_LE, REAL_SUB_0, REAL_SUB_LE,
        REAL_SUB_LT, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, real_div, SUM_EQ, SUM_IMAGE, SUM_LE, SUM_RESTRICT_SET, UNIONS_SUBSET, .. } :=
        D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_LIFT, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VSUM, ENDS_IN_INTERVAL, LIFT_DROP,
        NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { VECTOR_ADD_RID, VECTOR_MUL_RZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_INTER, INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1,
        INTERVAL_NE_EMPTY_1, LIM_ADD, LIM_CONST, LIM_NORM, LIM_SEQUENTIALLY, LIM_SUB, .. }
        := D.dv.dg.pt.cvx.top4
  let { SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_RAT_REDUCE_CONV,
        REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { REAL_ABS_POW, REAL_LT_INV2, REAL_POW_MONO, REAL_POW_MONO_LT, .. } :=
        D.dv.dg.qsession
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { LIM_VMUL, .. } := D.dv.qtopology2
  let { CONVEX_INTERIOR_CLOSURE, .. } := D.qconvex
  let { REAL_POW_1, REAL_POW_LE_1, .. } := D.qsession
  let { EQ_INTERVAL_1, INTERIOR_INTERVAL, LIM_DROP_UBOUND, LIM_VSUM,
        UNIFORMLY_CONTINUOUS_EXTENDS_TO_CLOSURE, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS, .. }
        := D.qtopology
  let { SUM_VSUM, .. } := D.qvec
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th => liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let ABSOLUTELY_CONTINUOUS_ON_INTERIOR ← prove
   r"!f:real^1->real^N s.
        f absolutely_continuous_on (interior s) /\
        f continuous_on s
        ==> f absolutely_continuous_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [absolutely_continuous_on, absolutely_setcontinuous_on] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUM_VSUM] THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_UBOUND) THEN
    EXISTS_TAC
     (← q r"\n. vsum d
         (\k. lift(norm
                 ((f:real^1->real^N)(interval_upperbound k -
                    inv(&2 pow n) %
                    (interval_upperbound k - interval_lowerbound k)) -
                  f(interval_lowerbound k +
                    inv(&2 pow n) %
                    (interval_upperbound k - interval_lowerbound k)))))") THEN
    REWRITE_TAC [o_DEF, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LIM_VSUM THEN ASM_REWRITE_TAC [] THEN FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      MATCH_MP_TAC LIM_NORM THEN MATCH_MP_TAC LIM_SUB THEN
      SUBGOAL_THEN (← q r"interval[a:real^1,b] SUBSET s") ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"(f:real^1->real^N) continuous (at b within s)") MP_TAC THENL
         [FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
           [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET],
          ALL_TAC],
        SUBGOAL_THEN (← q r"(f:real^1->real^N) continuous (at a within s)") MP_TAC THENL
         [FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
           [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET],
          ALL_TAC]] THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY, o_DEF] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      (CONJ_TAC THENL
        [GEN_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
         REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_CMUL,
           ← REAL_ARITH (← q r"a <= b - i * (b - a) <=> &0 <= (&1 - i) * (b - a)"),
