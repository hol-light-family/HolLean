   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SET_VARIATION_TRIANGLE) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(a + b) - (c + d):real^N = (a - c) + (b - d)")])

  let (HAS_BOUNDED_VARIATION_ON_VSUM, VECTOR_VARIATION_SUM_LE) ← CONJ_PAIR (← prove
   r"(!f:A->real^1->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i has_bounded_variation_on s)
        ==> (\x. vsum k (\i. f i x)) has_bounded_variation_on s) /\
   (!f:A->real^1->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i has_bounded_variation_on s)
        ==> vector_variation s (\x. vsum k (\i. f i x))
            <= sum k (\i. vector_variation s (f i)))"
   (REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [VECTOR_VARIATION_CONST, REAL_LE_REFL,
              HAS_BOUNDED_VARIATION_ON_CONST,
              HAS_BOUNDED_VARIATION_ON_ADD, ETA_AX] THEN
    REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      VECTOR_VARIATION_TRIANGLE o lhand o snd) THEN
    ASM_SIMP_TAC [ETA_AX] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [REAL_LE_LADD]))

  pure { VECTOR_VARIATION_LIFT_ABS, HAS_BOUNDED_VARIATION_ON_SUBSET,
         HAS_BOUNDED_VARIATION_ON_CONST, VECTOR_VARIATION_CONST, HAS_BOUNDED_VARIATION_ON_CMUL,
         HAS_BOUNDED_VARIATION_ON_CMUL_EQ, HAS_BOUNDED_VARIATION_ON_VMUL_EQ,
         HAS_BOUNDED_VARIATION_ON_VMUL, VECTOR_VARIATION_CMUL, VECTOR_VARIATION_VMUL,
         HAS_BOUNDED_VARIATION_ON_NEG, HAS_BOUNDED_VARIATION_ON_ADD,
         HAS_BOUNDED_VARIATION_ON_SUB, HAS_BOUNDED_VARIATION_ON_COMPOSE_LINEAR,
         HAS_BOUNDED_VARIATION_ON_NULL, HAS_BOUNDED_VARIATION_ON_EMPTY,
         VECTOR_VARIATION_ON_NULL, VECTOR_VARIATION_ON_EMPTY, VECTOR_VARIATION_SING,
         HAS_BOUNDED_VARIATION_ON_NORM, HAS_BOUNDED_VARIATION_ON_MAX,
         HAS_BOUNDED_VARIATION_ON_MIN, BOUNDED_VECTOR_VARIATION_ON_PASTECART,
         BOUNDED_VARIATION_FROM_PASTECART, HAS_BOUNDED_VARIATION_ON_PASTECART,
         HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS,
         HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED, HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL,
         HAS_BOUNDED_VARIATION_ON_BILINEAR, HAS_BOUNDED_VARIATION_ON_MUL,
         VECTOR_VARIATION_POS_LE, VECTOR_VARIATION_GE_NORM_FUNCTION,
         VECTOR_VARIATION_GE_DROP_FUNCTION, VECTOR_VARIATION_CONST_EQ,
         VECTOR_VARIATION_MONOTONE, VECTOR_VARIATION_NEG, VECTOR_VARIATION_TRIANGLE,
         HAS_BOUNDED_VARIATION_ON_VSUM, VECTOR_VARIATION_SUM_LE }

/- ------------------------------------------------------------------------- -/
/- Operativity of endpoint differences; bounded variation over divisions,   -/
/- closures and unions.  (integration.ml 17369-17614)                       -/
/- ------------------------------------------------------------------------- -/

structure INAX where
  OPERATIVE_FUNCTION_ENDPOINT_DIFF : thm
  OPERATIVE_REAL_FUNCTION_ENDPOINT_DIFF : thm
  OPERATIVE_HAS_BOUNDED_VARIATION_ON : thm
  OPERATIVE_LIFTED_VECTOR_VARIATION : thm
  HAS_BOUNDED_VARIATION_ON_DIVISION : thm
  VECTOR_VARIATION_ON_DIVISION : thm
  HAS_BOUNDED_VARIATION_ON_CLOSURE : thm
  HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ : thm
  HAS_BOUNDED_VARIATION_ON_SING : thm
  VECTOR_VARIATION_LE_UNION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAX [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINF : INF) (BING : ING) (BINP : INP) (BINW : INW) (BINY : INY) (BINAV : INAV) (BINAW : INAW) : ExceptT String IO INAX := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_EQ_0_1, INTERVAL_BOUNDS_EMPTY_1, INTERVAL_BOUNDS_NULL_1,
        INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_1,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { DIVISION_DISJOINT_UNION, division_of, DIVISION_OF_FINITE, DIVISION_OF_SUBSET,
        DIVISION_OF_UNION_SELF, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { INTERVAL_SPLIT, .. } := BINF
  let { operative, .. } := BING
  let { DIVISION_COMMON_POINT_BOUND, .. } := BINP
  let { has_bounded_setvariation_on, .. } := BINW
  let { HAS_BOUNDED_SETVARIATION_ON_DIVISION, OPERATIVE_HAS_BOUNDED_SETVARIATION_ON,
        OPERATIVE_LIFTED_SETVARIATION, SET_VARIATION_ON_DIVISION, .. } := BINY
  let { has_bounded_variation_on, HAS_BOUNDED_VARIATION_WORKS, HAS_BOUNDED_VECTOR_VARIATION,
        vector_variation, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED, HAS_BOUNDED_VARIATION_ON_NULL,
        HAS_BOUNDED_VARIATION_ON_SUBSET, .. } := BINAW
  let { CARD_SUBSET, CONJ_ASSOC, DIMINDEX_1, ETA_AX, EXTENSION, FINITE_IMAGE,
        FINITE_RESTRICT, FINITE_UNIONS, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, INTER_EMPTY, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, LAMBDA_BETA, LE_REFL, LE_TRANS,
        NEUTRAL_REAL_ADD, REAL_ADD_SYM, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_RMUL_EQ,
        REAL_LE_SUB_LADD, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_NOT_LT, REAL_OF_NUM_LE, REAL_SUB_0, SIMPLE_IMAGE, SUBSET,
        SUBSET_UNION, .. } := D.dv.dg.pt.cvx.core5
  let { o_THM, SUM_BOUND, SUM_SUPPORT, SUM_UNION, support, UNIONS_IMAGE, .. } :=
        D.dv.dg.pt.cvx.core6
  let { DROP_EQ, ENDS_IN_INTERVAL, FORALL_1, FORALL_DROP, INTERVAL_SING, LIFT_ADD, LIFT_EQ,
        LIFT_NUM, LIFT_SUB, NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_SUB_EQ, VECTOR_SUB_REFL, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, BOUNDED_SUBSET, .. } := D.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { FINITE_IMP_BOUNDED, .. } := D.dv.dg.pt.cvx.top3
  let { INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, .. } :=
        D.dv.dg.pt.cvx.top4
  let { frontier, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. }
        := D.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { BOUNDED_UNION, .. } := D.dv.dg.qtopology1
  let { CARD_UNIONS_LE, FINITE_HAS_SIZE, SUM_UNION_NONZERO, .. } := D.qsession
  let { CARD_FRONTIER_INTERVAL_1, INTERIOR_INTERVAL, .. } := D.qtopology
  let { NEUTRAL_VECTOR_ADD, .. } := D.qvec
  let { IMP_REWRITE_TAC, .. } := D
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let OPERATIVE_FUNCTION_ENDPOINT_DIFF ← prove
   r"!f:real^1->real^N.
    operative (+) (\k. f (interval_upperbound k) - f (interval_lowerbound k))"
   (GEN_TAC THEN
    SIMP_TAC [operative, INTERVAL_BOUNDS_NULL_1, VECTOR_SUB_REFL] THEN
    REWRITE_TAC [NEUTRAL_VECTOR_ADD, DIMINDEX_1, FORALL_1, ← GSYM drop] THEN
    REWRITE_TAC [FORALL_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1", ← q r"c:real^1"] THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THENL
     [ASM_REWRITE_TAC [INTER_EMPTY, INTERVAL_BOUNDS_EMPTY_1] THEN
      VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"interval[a,b] INTER {x | drop x <= drop c} = {}") THENL
     [ASM_REWRITE_TAC [INTERVAL_BOUNDS_EMPTY_1, VECTOR_SUB_REFL] THEN
      SUBGOAL_THEN (← q r"interval[a,b] INTER {x | drop x >= drop c} = interval[a,b]")
       (fun th => REWRITE_TAC [th, VECTOR_ADD_LID]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"i INTER s = {} ==> s UNION t = UNIV ==> i INTER t = i"))) THEN
      REWRITE_TAC [EXTENSION, IN_UNIV, IN_UNION, IN_ELIM_THM] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"interval[a,b] INTER {x | drop x >= drop c} = {}") THENL
     [ASM_REWRITE_TAC [INTERVAL_BOUNDS_EMPTY_1, VECTOR_SUB_REFL] THEN
      SUBGOAL_THEN (← q r"interval[a,b] INTER {x | drop x <= drop c} = interval[a,b]")
       (fun th => REWRITE_TAC [th, VECTOR_ADD_RID]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"i INTER s = {} ==> s UNION t = UNIV ==> i INTER t = i"))) THEN
      REWRITE_TAC [EXTENSION, IN_UNIV, IN_UNION, IN_ELIM_THM] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    POP_ASSUM_LIST (MP_TAC o HolLight.end_itlist CONJ) THEN
    SIMP_TAC [INTERVAL_SPLIT, drop, DIMINDEX_1, LE_REFL] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN
    SIMP_TAC [INTERVAL_UPPERBOUND_1, INTERVAL_LOWERBOUND_1] THEN
    SIMP_TAC [drop, LAMBDA_BETA, DIMINDEX_1, LE_REFL] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← VECTOR_ARITH
     (← q r"fx:real^N = fy ==> fb - fa = fx - fa + fb - fy")) THEN
    AP_TERM_TAC THEN REWRITE_TAC [← GSYM DROP_EQ, drop] THEN
    SIMP_TAC [LAMBDA_BETA, DIMINDEX_1, LE_REFL] THEN ASM_REAL_ARITH_TAC)

  let OPERATIVE_REAL_FUNCTION_ENDPOINT_DIFF ← prove
   r"!f:real^1->real.
    operative (+) (\k. f (interval_upperbound k) - f (interval_lowerbound k))"
   (GEN_TAC THEN
    MP_TAC (← ISPEC (← q r"lift o (f:real^1->real)") OPERATIVE_FUNCTION_ENDPOINT_DIFF) THEN
    REWRITE_TAC [operative, NEUTRAL_REAL_ADD, NEUTRAL_VECTOR_ADD] THEN
    REWRITE_TAC [o_THM, ← GSYM LIFT_SUB, ← GSYM LIFT_ADD, ← GSYM LIFT_NUM] THEN
    REWRITE_TAC [LIFT_EQ])

  let OPERATIVE_HAS_BOUNDED_VARIATION_ON ← prove
   r"!f:real^1->real^N.
        operative (/\) ((has_bounded_variation_on) f)"
   (GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [ETA_AX] THEN
    MATCH_MP_TAC OPERATIVE_HAS_BOUNDED_SETVARIATION_ON THEN
    REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  let OPERATIVE_LIFTED_VECTOR_VARIATION ← prove
   r"!f:real^1->real^N.
        operative (lifted(+))
                  (\i. if f has_bounded_variation_on i
                       then SOME(vector_variation i f) else NONE)"
   (GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    MATCH_MP_TAC OPERATIVE_LIFTED_SETVARIATION THEN
    REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  let HAS_BOUNDED_VARIATION_ON_DIVISION ← prove
   r"!f:real^1->real^N a b d.
        d division_of interval[a,b]
        ==> ((!k. k IN d ==> f has_bounded_variation_on k) <=>
             f has_bounded_variation_on interval[a,b])"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    MATCH_MP_TAC HAS_BOUNDED_SETVARIATION_ON_DIVISION THEN
    ASM_REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF])

  let VECTOR_VARIATION_ON_DIVISION ← prove
   r"!f:real^1->real^N a b d.
        d division_of interval[a,b] /\
        f has_bounded_variation_on interval[a,b]
        ==> sum d (\k. vector_variation k f) =
            vector_variation (interval[a,b]) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [vector_variation] THEN
    MATCH_MP_TAC SET_VARIATION_ON_DIVISION THEN
    ASM_REWRITE_TAC [OPERATIVE_FUNCTION_ENDPOINT_DIFF, ← GSYM
                     has_bounded_variation_on])

  let HAS_BOUNDED_VARIATION_ON_CLOSURE ← prove
   r"!f:real^1->real^N s.
        is_interval s /\ f has_bounded_variation_on s
        ==> f has_bounded_variation_on (closure s)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP CARD_FRONTIER_INTERVAL_1) THEN
    SUBGOAL_THEN (← q r"bounded (IMAGE (f:real^1->real^N) (closure s))") MP_TAC THENL
     [MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"IMAGE (f:real^1->real^N) (s UNION frontier s)") THEN
      CONJ_TAC THENL
       [ASM_REWRITE_TAC [IMAGE_UNION, BOUNDED_UNION] THEN
        ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED] THEN
        ASM_SIMP_TAC [FINITE_IMP_BOUNDED, FINITE_IMAGE],
        REWRITE_TAC [frontier] THEN
        MP_TAC (← ISPEC (← q r"s:real^1->bool") INTERIOR_SUBSET) THEN SET_TAC []],
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"(f:real^1->real^N) has_bounded_variation_on s") THEN
      REWRITE_TAC [has_bounded_setvariation_on, has_bounded_variation_on] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"K:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"K + &8 * B") THEN
      MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"u:real^1->bool"] THEN
      STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      SUBGOAL_THEN
       (← q r"d = { k:real^1->bool |
            k IN d /\ k SUBSET s} UNION {k | k IN d /\ ~(k SUBSET s)}")
      SUBST1_TAC THENL [SET_TAC [], ALL_TAC] THEN
      IMP_REWRITE_TAC [SUM_UNION] THEN ASM_SIMP_TAC [FINITE_RESTRICT] THEN
      CONJ_TAC THENL [MATCH_MP_TAC REAL_LE_ADD2, SET_TAC []] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        EXISTS_TAC (← q r"UNIONS {k:real^1->bool | k IN d /\ k SUBSET s}") THEN
        CONJ_TAC THENL [MATCH_MP_TAC DIVISION_OF_SUBSET, SET_TAC []] THEN
        EXISTS_TAC (← q r"d:(real^1->bool)->bool") THEN
        CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_UNION_SELF], SET_TAC []],
        ONCE_REWRITE_TAC [← GSYM SUM_SUPPORT] THEN
        REWRITE_TAC [support, IN_ELIM_THM, NEUTRAL_REAL_ADD] THEN
        REWRITE_TAC [NORM_EQ_0, VECTOR_SUB_EQ] THEN
        MP_TAC (← ISPECL
         [← q r"{k | (k IN d /\ ~(k SUBSET s)) /\
              ~((f:real^1->real^N)(interval_upperbound k) =
                f (interval_lowerbound k))}",
          ← q r"\k. norm ((f:real^1->real^N) (interval_upperbound k) -
                    f (interval_lowerbound k))",
          ← q r"&2 * B"] SUM_BOUND) THEN
        ASM_SIMP_TAC [← GSYM CONJ_ASSOC, FINITE_RESTRICT, FORALL_IN_GSPEC] THEN
        ANTS_TAC THENL
         [ONCE_REWRITE_TAC [IMP_CONJ] THEN FIRST_ASSUM (fun th => tactic_of do
            pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
          SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                    INTERVAL_UPPERBOUND_NONEMPTY] THEN
          MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
          STRIP_TAC THEN MATCH_MP_TAC (← NORM_ARITH
           (← q r"norm(x) <= B /\ norm(y) <= B ==> norm(y - x:real^N) <= &2 * B")) THEN
          CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
          DISCH_THEN (MP_TAC o SPEC
           (← q r"interval[a:real^1,b]") o elc 1) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← SET_RULE
           (← q r"u SUBSET s /\ x IN i ==> i SUBSET u /\ P x ==> x IN s")) THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL],
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
          ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_LE_RMUL_EQ] THEN
          REWRITE_TAC [← REAL_ARITH (← q r"x * &2 <= &8 <=> x <= &4")] THEN
          REWRITE_TAC [REAL_OF_NUM_LE] THEN
          TRANS_TAC LE_TRANS
           (← q r"CARD(UNIONS {{k | k IN d /\ ~(content k = &0) /\ x IN k}
                       | (x:real^1) IN frontier s})") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC CARD_SUBSET THEN
            ASM_SIMP_TAC [FINITE_UNIONS, FORALL_IN_GSPEC, FINITE_RESTRICT] THEN
            ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE, UNIONS_IMAGE] THEN
            GEN_REWRITE_TAC I [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
            ONCE_REWRITE_TAC [IMP_CONJ] THEN FIRST_ASSUM (fun th => tactic_of do
              pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
            SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                      INTERVAL_UPPERBOUND_NONEMPTY] THEN
            SIMP_TAC [INTERVAL_NE_EMPTY_1, CONTENT_1, REAL_SUB_0, DROP_EQ] THEN
            REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
             (← q r"~(s SUBSET t) ==> s SUBSET closure t
                ==> ?x. x IN (closure t DIFF t) /\ x IN s"))) THEN
            ANTS_TAC THENL [ASM_MESON_TAC [division_of, SUBSET], ALL_TAC] THEN
            REWRITE_TAC [frontier] THEN
            MP_TAC (← ISPEC (← q r"s:real^1->bool") INTERIOR_SUBSET) THEN ASM SET_TAC [],
            TRANS_TAC LE_TRANS (← q r"CARD(frontier s:real^1->bool) * 2") THEN
            CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
            MATCH_MP_TAC CARD_UNIONS_LE THEN
            ASM_SIMP_TAC [← GSYM FINITE_HAS_SIZE, FINITE_RESTRICT] THEN
            SUBST1_TAC (← ARITH_RULE (← q r"2 = 2 EXP 1")) THEN
            REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM DIMINDEX_1] THEN
            MATCH_MP_TAC DIVISION_COMMON_POINT_BOUND THEN ASM_MESON_TAC []]]]])

  let HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ ← prove
   r"!f:real^1->real^N s.
        is_interval s
        ==> (f has_bounded_variation_on closure s <=>
             f has_bounded_variation_on s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_CLOSURE] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
          HAS_BOUNDED_VARIATION_ON_SUBSET) THEN
    REWRITE_TAC [CLOSURE_SUBSET])

  let HAS_BOUNDED_VARIATION_ON_SING ← prove
   r"!f a. f has_bounded_variation_on {a}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_NULL THEN
    REWRITE_TAC [← GSYM INTERVAL_SING, BOUNDED_INTERVAL] THEN
    REWRITE_TAC [CONTENT_EQ_0_1, REAL_LE_REFL])

  let VECTOR_VARIATION_LE_UNION ← prove
   r"!f:real^1->real^N s t.
        f has_bounded_variation_on (s UNION t) /\
        interior s INTER interior t = {}
        ==> vector_variation s f + vector_variation t f
            <= vector_variation (s UNION t) f"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← GSYM REAL_LE_SUB_LADD] THEN
    SUBGOAL_THEN
     (← q r"(f:real^1->real^N) has_bounded_variation_on s /\
    (f:real^1->real^N) has_bounded_variation_on t")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_SUBSET, SUBSET_UNION], ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^N", ← q r"s:real^1->bool"] HAS_BOUNDED_VECTOR_VARIATION) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    MAP_EVERY X_GEN_TAC [← q r"ds:(real^1->bool)->bool", ← q r"s':real^1->bool"] THEN
    STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a <= b - c <=> c <= b - a")] THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^N", ← q r"t:real^1->bool"] HAS_BOUNDED_VECTOR_VARIATION) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
    MAP_EVERY X_GEN_TAC [← q r"dt:(real^1->bool)->bool", ← q r"t':real^1->bool"] THEN
    STRIP_TAC THEN MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"s UNION t:real^1->bool"]
          HAS_BOUNDED_VARIATION_WORKS) THEN
    ASM_REWRITE_TAC [REAL_LE_SUB_LADD] THEN DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"ds UNION dt:(real^1->bool)->bool", ← q r"s' UNION t':real^1->bool"]) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [MATCH_MP_TAC DIVISION_DISJOINT_UNION, ASM SET_TAC []] THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
      (← q r"s INTER t = {} ==> s' SUBSET s /\ t' SUBSET t ==> s' INTER t' = {}"))) THEN
      ASM_SIMP_TAC [SUBSET_INTERIOR],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      ONCE_REWRITE_TAC [REAL_ADD_SYM] THEN MATCH_MP_TAC SUM_UNION_NONZERO THEN
      REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_FINITE], ALL_TAC]) THEN
      REWRITE_TAC [IN_INTER, IMP_CONJ] THEN FIRST_ASSUM (fun th => tactic_of do
       pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
      SIMP_TAC [INTERVAL_UPPERBOUND_NONEMPTY, INTERVAL_LOWERBOUND_NONEMPTY] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [NORM_EQ_0, VECTOR_SUB_EQ] THEN
      AP_TERM_TAC THEN ASM_REWRITE_TAC [← GSYM DROP_EQ] THEN
      SUBGOAL_THEN (← q r"interior(interval[a:real^1,b]) = {}") MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"s INTER t = {} ==> u SUBSET s /\ u SUBSET t ==> u = {}"))) THEN
        CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN
        RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC [],
        REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_EQ_EMPTY_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
        ASM_REWRITE_TAC [← GSYM REAL_LE_ANTISYM]]])

  pure { OPERATIVE_FUNCTION_ENDPOINT_DIFF, OPERATIVE_REAL_FUNCTION_ENDPOINT_DIFF,
         OPERATIVE_HAS_BOUNDED_VARIATION_ON, OPERATIVE_LIFTED_VECTOR_VARIATION,
         HAS_BOUNDED_VARIATION_ON_DIVISION, VECTOR_VARIATION_ON_DIVISION,
         HAS_BOUNDED_VARIATION_ON_CLOSURE, HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ,
         HAS_BOUNDED_VARIATION_ON_SING, VECTOR_VARIATION_LE_UNION }

