        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        REWRITE_TAC [← GSYM DROP_SUB] THEN
        MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"c:real^1",
                          ← q r"x:real^1"]
            VECTOR_VARIATION_COMBINE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
          REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
             HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs(a - (a + b)) = abs b")] THEN
        REWRITE_TAC [dist] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs a")) THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HAS_BOUNDED_VARIATION_ON_SUBSET)),
          REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC] THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"c limit_point_of interval[a:real^1,c]") THENL
       [ALL_TAC,
        ASM_SIMP_TAC [CONTINUOUS_WITHIN, LIM_TRIVIAL, TRIVIAL_LIMIT_WITHIN]] THEN
      MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "P")]
        CONTINUOUS_WITHIN_COMPARISON) THEN
      EXISTS_TAC (← q r"\x. vsum (1..dimindex(:N))
                       (\i. lift(vector_variation (interval[a,x])
                            (\u. lift(((f:real^1->real^N) u)$i))))") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_VSUM THEN REWRITE_TAC [FINITE_NUMSEG] THEN
        REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        W (MP_TAC o PART_MATCH (lhs o rand) lemma o snd) THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE
         [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
          CONTINUOUS_COMPONENTWISE_LIFT]) THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN DISCH_TAC THEN
      REWRITE_TAC [dist, ← GSYM VSUM_SUB_NUMSEG, ← GSYM LIFT_SUB] THEN
      SUBGOAL_THEN
       (← q r"vector_variation(interval [a,c]) (f:real^1->real^N) =
    vector_variation(interval [a,x]) (f:real^1->real^N) +
    vector_variation(interval [x,c]) (f:real^1->real^N) /\
    !i. 1 <= i /\ i <= dimindex(:N)
        ==> vector_variation(interval [a,c])
                  (\x. lift((f:real^1->real^N) x $ i)) =
    vector_variation(interval [a,x]) (\x. lift(f x$i)) +
    vector_variation(interval [x,c]) (\x. lift(f x$i))")
       (fun th => ASM_SIMP_TAC [th])
      THENL
       [REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMBINE THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE
           [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [REAL_LE_REFL],
        REWRITE_TAC [REAL_ADD_SUB]] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[x:real^1,c]") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [REAL_LE_REFL],
        DISCH_TAC] THEN
      ASM_SIMP_TAC [NORM_LIFT, real_abs, VECTOR_VARIATION_POS_LE] THEN
      FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE I
       [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ABS_CONV)
       [← GSYM BASIS_EXPANSION] THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        VECTOR_VARIATION_SUM_LE o lhand o snd) THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN ANTS_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
            HAS_BOUNDED_VARIATION_COMPARISON),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        REWRITE_TAC [NORM_1, DROP_VSUM, LIFT_DROP, o_DEF] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> a <= abs b")) THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMPARISON] THEN
      ASM_SIMP_TAC [dist, ← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL, NORM_BASIS] THEN
      REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT, REAL_MUL_RID, REAL_LE_REFL]))

  pure { VECTOR_VARIATION_CONTINUOUS_LEFT }

/- ------------------------------------------------------------------------- -/
/- Right continuity and continuity of the variation function.               -/
/- (integration.ml 20248-20564)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBH where
  VECTOR_VARIATION_CONTINUOUS_RIGHT : thm
  VECTOR_VARIATION_CONTINUOUS : thm
  CONTINUOUS_ON_VECTOR_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBH [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBA : INBA) (BINBB : INBB) (BINBF : INBF) (BINBG : INBG) : ExceptT String IO INBH := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_COMPARISON, HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
        VECTOR_VARIATION_COMPARISON, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_NEG, HAS_BOUNDED_VARIATION_ON_SUBSET,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_NEG, VECTOR_VARIATION_POS_LE,
        VECTOR_VARIATION_SUM_LE, VECTOR_VARIATION_TRIANGLE, .. } := BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { INCREASING_BOUNDED_VARIATION, INCREASING_VECTOR_VARIATION, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_DARBOUX, .. } := BINBB
  let { INCREASING_RIGHT_LIMIT_1, .. } := BINBF
  let { VECTOR_VARIATION_CONTINUOUS_LEFT, .. } := BINBG
  let { ETA_AX, FINITE_NUMSEG, .. } := D.dv.dg.pt.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, REAL_ABS_NUM, ..
        } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_RADD, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_MIN,
        .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_NOT_LT, REAL_SUB_REFL, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, SUM_LE_NUMSEG, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { BASIS_EXPANSION, DIST_LIFT, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_EQ, DROP_SUB, DROP_VEC, DROP_VSUM, LIFT_DROP, LIFT_SUB, NORM_1,
        NORM_BASIS, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, NORM_MUL, NORM_NEG, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, drop, VECTOR_SUB, VECTOR_SUB_RDISTRIB, VECTOR_SUB_REFL, VSUM_NEG, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_VSUM, CONTINUOUS_WITHIN,
        EVENTUALLY_WITHIN, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, LIM_SUB, LIM_UNIQUE, LIM_WITHIN, .. } :=
        D.dv.dg.pt.cvx.top4
  let { continuous_within, SEGMENT_1, TRIVIAL_LIMIT_WITHIN, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, VECTOR_ARITH,
        VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { LIFT_NEG, .. } := D.dv.dg.qvec
  let { LIM_TRANSFORM, LIM_TRIVIAL, LIM_WITHIN_SUBSET, .. } := D.dv.qtopology2
  let { CONTINUOUS_COMPONENTWISE_LIFT, CONTINUOUS_WITHIN_COMPARISON, LIM_DROP_UBOUND,
        LIM_UNION, .. } := D.qtopology
  let { DIST_REAL, NORM_REAL, VSUM_SUB_NUMSEG, .. } := D.qvec
  -- @@SCOPE END

  let VECTOR_VARIATION_CONTINUOUS_RIGHT ← (do
    let lemma ← prove
     r"!f:real^1->real^1 a b c.
          f has_bounded_variation_on interval[a,b] /\ c IN interval[a,b]
          ==> ((\x. lift(vector_variation(interval[a,x]) f))
               continuous (at c within interval[c,b]) <=>
              f continuous (at c within interval[c,b]))"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [REWRITE_TAC [continuous_within] THEN
        REWRITE_TAC [DIST_LIFT, IN_ELIM_THM, DIST_REAL, ← GSYM drop] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        REWRITE_TAC [← GSYM DROP_SUB] THEN
        MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"x:real^1",
                          ← q r"c:real^1"]
            VECTOR_VARIATION_COMBINE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
          REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
             HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs((a + b) - a) = abs b")] THEN
        REWRITE_TAC [drop, ← GSYM NORM_REAL] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs a")) THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HAS_BOUNDED_VARIATION_ON_SUBSET)),
          REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC] THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"c limit_point_of interval[c:real^1,b]") THENL
       [ALL_TAC,
        ASM_SIMP_TAC [CONTINUOUS_WITHIN, LIM_TRIVIAL, TRIVIAL_LIMIT_WITHIN]] THEN
      FIRST_ASSUM (MP_TAC o
        GEN_REWRITE_RULE I [HAS_BOUNDED_VARIATION_DARBOUX]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"c:real^1"]
       INCREASING_RIGHT_LIMIT_1) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"c:real^1"]
       INCREASING_RIGHT_LIMIT_1) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"gc:real^1") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"hc:real^1") THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"k = gc - (g:real^1->real^1) c") THEN
      SUBGOAL_THEN (← q r"hc - (h:real^1->real^1) c = k") ASSUME_TAC THENL
       [EXPAND_TAC "k" THEN
        ONCE_REWRITE_TAC [← VECTOR_ARITH
         (← q r"hc' - hc:real^1 = gc' - gc <=> gc' - hc' = gc - hc")] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONTINUOUS_WITHIN]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE
          [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
          LIM_UNIQUE) THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_WITHIN] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
        ASM_SIMP_TAC [LIM_SUB],
        ALL_TAC] THEN
      MAP_EVERY ABBREV_TAC
       [← q r"g':real^1->real^1 = \x. if drop x <= drop c then g(x) + k else g(x)",
        ← q r"h':real^1->real^1 =
          \x. if drop x <= drop c then h(x) + k else h(x)"] THEN
      SUBGOAL_THEN
       (← q r"(!x y. x IN interval[c,b] /\ y IN interval[c,b] /\ drop x <= drop y
             ==> drop(g' x) <= drop(g' y)) /\
      (!x y. x IN interval[c,b] /\ y IN interval[c,b] /\ drop x <= drop y
             ==> drop(h' x) <= drop(h' y))")
      STRIP_ASSUME_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g'", "h'"] THEN REWRITE_TAC [] THEN CONJ_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
        (ASM_CASES_TAC (← q r"drop y <= drop c") THENL
          [SUBGOAL_THEN (← q r"drop x <= drop c") ASSUME_TAC THENL
            [ASM_REAL_ARITH_TAC, ASM_REWRITE_TAC []] THEN
           REWRITE_TAC [DROP_ADD, REAL_LE_RADD] THEN
           FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
           RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
           ALL_TAC] THEN
         ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
          [ALL_TAC,
           FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
           RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
           ASM_REAL_ARITH_TAC] THEN
         SUBGOAL_THEN (← q r"x:real^1 = c") SUBST_ALL_TAC THENL
          [REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
         FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
          (← q r"gc - g c = k
         ==> drop(g c + (gc - g c)) <= b ==> drop(g c + k) <= b"))) THEN
         REWRITE_TAC [← VECTOR_ARITH (← q r"a + b - a:real^1 = b")] THEN
         MATCH_MP_TAC (← ISPEC (← q r"at c within interval[c:real^1,b]")
            LIM_DROP_UBOUND))
        THENL [EXISTS_TAC (← q r"g:real^1->real^1"), EXISTS_TAC (← q r"h:real^1->real^1")] THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_WITHIN, EVENTUALLY_WITHIN] THEN
        EXISTS_TAC (← q r"drop y - drop c") THEN
        (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
        REWRITE_TAC [DIST_REAL, ← GSYM drop, IN_INTERVAL_1] THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(g':real^1->real^1) continuous (at c within interval[c,b]) /\
      (h':real^1->real^1) continuous (at c within interval[c,b])")
      MP_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g'", "h'"] THEN
        REWRITE_TAC [CONTINUOUS_WITHIN, REAL_LE_REFL] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← VECTOR_ARITH
         (← q r"g - g':real^1 = k <=> g' + k = g")]) THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ_ALT] LIM_TRANSFORM)) THEN
        MAP_EVERY EXPAND_TAC ["g'", "h'"] THEN
        REWRITE_TAC [LIM_WITHIN, DIST_REAL, ← GSYM drop, IN_INTERVAL_1] THEN
        SIMP_TAC [← REAL_ARITH (← q r"c <= x /\ &0 < abs(x - c) ==> ~(x <= c)")] THEN
        REWRITE_TAC [VECTOR_SUB_REFL, DROP_VEC, REAL_SUB_REFL, REAL_ABS_NUM] THEN
        MESON_TAC [REAL_LT_01],
        ALL_TAC] THEN
      REWRITE_TAC [continuous_within] THEN
      REWRITE_TAC [DIST_LIFT, IN_ELIM_THM, DIST_REAL, ← GSYM drop] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
              CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2")) th)) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d1 d2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"d:real^1") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"d:real^1",
                        ← q r"c:real^1"]
            VECTOR_VARIATION_COMBINE) THEN
      ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(a + b) - a:real = b")] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x < a ==> abs x < a")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_POS_LE THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"f:real^1->real^1 = \x. g' x - h' x") SUBST1_TAC THENL
       [MAP_EVERY EXPAND_TAC ["g'", "h'"] THEN REWRITE_TAC [FUN_EQ_THM] THEN
        GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"g':real^1->real^1", ← q r"\x. --((h':real^1->real^1) x)",
        ← q r"interval[c:real^1,d]"] VECTOR_VARIATION_TRIANGLE) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_NEG] THEN
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[c:real^1,b]") THEN
        ASM_SIMP_TAC [INCREASING_BOUNDED_VARIATION, SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN  ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [VECTOR_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"y < a / &2 /\ z < a / &2 ==> x <= y + z ==> x < a")) THEN
      REWRITE_TAC [VECTOR_VARIATION_NEG] THEN CONJ_TAC THEN
      W (MP_TAC o PART_MATCH (lhs o rand)
        INCREASING_VECTOR_VARIATION o lhand o snd) THEN
      (ANTS_TAC THENL
        [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
         ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, IN_INTERVAL_1, REAL_NOT_LT] THEN
         REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         ASM_REAL_ARITH_TAC,
         DISCH_THEN SUBST1_TAC]) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"abs x < e ==> x < e")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [])
    prove
     r"!f:real^1->real^N a b c.
        f has_bounded_variation_on interval[a,b] /\ c IN interval[a,b]
        ==> ((\x. lift(vector_variation(interval[a,x]) f))
             continuous (at c within interval[c,b]) <=>
            f continuous (at c within interval[c,b]))"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [REWRITE_TAC [continuous_within] THEN
        REWRITE_TAC [DIST_LIFT, IN_ELIM_THM, DIST_REAL, ← GSYM drop] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        REWRITE_TAC [← GSYM DROP_SUB] THEN
        MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"x:real^1",
                          ← q r"c:real^1"]
            VECTOR_VARIATION_COMBINE) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
          REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
             HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"abs((a + b) - a) = abs b")] THEN
        REWRITE_TAC [dist] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= a ==> x <= abs a")) THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HAS_BOUNDED_VARIATION_ON_SUBSET)),
          REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC] THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"c limit_point_of interval[c:real^1,b]") THENL
       [ALL_TAC,
        ASM_SIMP_TAC [CONTINUOUS_WITHIN, LIM_TRIVIAL, TRIVIAL_LIMIT_WITHIN]] THEN
      MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "P")]
        CONTINUOUS_WITHIN_COMPARISON) THEN
      EXISTS_TAC (← q r"\x. vsum (1..dimindex(:N))
                       (\i. lift(vector_variation (interval[a,x])
                            (\u. lift(((f:real^1->real^N) u)$i))))") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_VSUM THEN REWRITE_TAC [FINITE_NUMSEG] THEN
        REWRITE_TAC [IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
        W (MP_TAC o PART_MATCH (lhs o rand) lemma o snd) THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE
         [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE,
          CONTINUOUS_COMPONENTWISE_LIFT]) THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN DISCH_TAC THEN
      REWRITE_TAC [dist, ← GSYM VSUM_SUB_NUMSEG, ← GSYM LIFT_SUB] THEN
      SUBGOAL_THEN
       (← q r"vector_variation(interval [a,x]) (f:real^1->real^N) =
    vector_variation(interval [a,c]) (f:real^1->real^N) +
    vector_variation(interval [c,x]) (f:real^1->real^N) /\
    !i. 1 <= i /\ i <= dimindex(:N)
        ==> vector_variation(interval [a,x])
                  (\x. lift((f:real^1->real^N) x $ i)) =
    vector_variation(interval [a,c]) (\x. lift(f x$i)) +
    vector_variation(interval [c,x]) (\x. lift(f x$i))")
       (fun th => ASM_SIMP_TAC [th])
      THENL
       [REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMBINE THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (ONCE_REWRITE_RULE
           [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
        ASM_SIMP_TAC [REAL_LE_REFL] THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [← REAL_ARITH (← q r"a - (a + b):real = --b")]] THEN
      REWRITE_TAC [LIFT_NEG, VSUM_NEG, NORM_NEG] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[c:real^1,x]") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        ASM_SIMP_TAC [REAL_LE_REFL],
        DISCH_TAC] THEN
      ASM_SIMP_TAC [NORM_LIFT, real_abs, VECTOR_VARIATION_POS_LE] THEN
      FIRST_ASSUM (ASSUME_TAC o GEN_REWRITE_RULE I
       [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM ETA_AX] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ABS_CONV)
       [← GSYM BASIS_EXPANSION] THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        VECTOR_VARIATION_SUM_LE o lhand o snd) THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN ANTS_TAC THENL
       [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
            HAS_BOUNDED_VARIATION_COMPARISON),
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        REWRITE_TAC [NORM_1, DROP_VSUM, LIFT_DROP, o_DEF] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> a <= abs b")) THEN
        MATCH_MP_TAC SUM_LE_NUMSEG THEN REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC VECTOR_VARIATION_COMPARISON] THEN
      ASM_SIMP_TAC [dist, ← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL, NORM_BASIS] THEN
      REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT, REAL_MUL_RID, REAL_LE_REFL]))

  let VECTOR_VARIATION_CONTINUOUS ← (do
    let lemma ← prove
     r"!f:real^1->real^N a b c.
        c IN interval[a,b]
        ==> (f continuous (at c within interval[a,b]) <=>
             f continuous (at c within interval[a,c]) /\
             f continuous (at c within interval[c,b]))"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_WITHIN] THEN EQ_TAC THENL
       [DISCH_THEN (ASSUME_TAC o GEN_ALL o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] LIM_WITHIN_SUBSET)) THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC,
        DISCH_THEN (MP_TAC o MATCH_MP LIM_UNION) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] LIM_WITHIN_SUBSET)] THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_INTERVAL_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC)
    prove
     r"!f:real^1->real^N a b c.
        f has_bounded_variation_on interval[a,b] /\ c IN interval[a,b]
        ==> ((\x. lift(vector_variation(interval[a,x]) f))
             continuous (at c within interval[a,b]) <=>
            f continuous (at c within interval[a,b]))"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ONCE_REWRITE_TAC [← MATCH_MP lemma th])) THEN
      ASM_MESON_TAC [VECTOR_VARIATION_CONTINUOUS_LEFT,
                     VECTOR_VARIATION_CONTINUOUS_RIGHT]))

  let CONTINUOUS_ON_VECTOR_VARIATION ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b] /\
        f continuous_on interval[a,b]
        ==> (\x. lift (vector_variation (interval [a,x]) f)) continuous_on
            interval[a,b]"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, VECTOR_VARIATION_CONTINUOUS])

  pure { VECTOR_VARIATION_CONTINUOUS_RIGHT, VECTOR_VARIATION_CONTINUOUS,
         CONTINUOUS_ON_VECTOR_VARIATION }

/- ------------------------------------------------------------------------- -/
/- Strong Darboux decomposition; monotone and BV functions have countably   -/
/- many discontinuities.  (integration.ml 20565-20884)                      -/
/- ------------------------------------------------------------------------- -/

structure INBI where
  HAS_BOUNDED_VARIATION_DARBOUX_STRONG : thm
  INCREASING_COUNTABLE_DISCONTINUITIES : thm
  DECREASING_COUNTABLE_DISCONTINUITIES : thm
  HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBI [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAZ : INAZ) (BINBB : INBB) (BINBF : INBF) (BINBG : INBG) (BINBH : INBH) : ExceptT String IO INBI := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_MONOTONE, .. } := BINAW
  let { VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE, .. } := BINAZ
  let { HAS_BOUNDED_VARIATION_DARBOUX_GEN, .. } := BINBB
  let { INCREASING_LEFT_LIMIT_1, INCREASING_RIGHT_LIMIT_1, .. } := BINBF
  let { VECTOR_VARIATION_CONTINUOUS_LEFT, .. } := BINBG
  let { VECTOR_VARIATION_CONTINUOUS, VECTOR_VARIATION_CONTINUOUS_RIGHT, .. } := BINBH
  let { EMPTY_GSPEC, ETA_AX, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, INTER_UNIONS, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, ..
        } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_ANTISYM, REAL_LE_LT, REAL_LE_NEG2, REAL_LE_REFL,
        REAL_LE_TOTAL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_REFL,
        REAL_LTE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LT, REAL_SUB_LT, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, .. } := D.dv.dg.pt.cvx.core5
  let { le_c, o_THM, UNIONS_GSPEC, .. } := D.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNION, .. } := D.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, INTERVAL_OPEN_SUBSET_CLOSED, INTERVAL_SING,
        LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSURE_SUBSET, CONTINUOUS_ADD, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_SUB, CONTINUOUS_WITHIN_ID, EVENTUALLY_WITHIN, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1, IS_INTERVAL_INTERVAL, .. } :=
        D.dv.dg.pt.cvx.top4
  let { frontier, OPEN_INTERIOR, OPEN_INTERVAL, TRIVIAL_LIMIT_WITHIN, .. } :=
        D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { REAL_LTE_ADD2, .. } := D.dv.dg.pt.qses
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { FINITE_IMP_COUNTABLE, .. } := D.dv.dg.pt.qcard
  let { CONVEX_INTERVAL, .. } := D.dv.dg.qconvex
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { CONTINUOUS_AT, .. } := D.dv.qtopology1
  let { LIM_DROP_LBOUND, LIM_WITHIN_OPEN, LIM_WITHIN_SUBSET, .. } := D.dv.qtopology2
  let { LIMPT_OF_CONVEX, .. } := D.qconvex
  let { CARD_LE_TRANS, COUNTABLE_EMPTY, COUNTABLE_INSERT, COUNTABLE_SUBSET,
        COUNTABLE_UNIONS, .. } := D.qcard
  let { RATIONAL_APPROXIMATION, .. } := D.qfloor
  let { COUNTABLE_RATIONAL, .. } := D.qmisc
  let { COUNTABLE, ge_c, .. } := D.qsession
  let { CARD_FRONTIER_INTERVAL_1, CLOSED_OPEN_INTERVAL_1, CONTINUOUS_COMPONENTWISE_LIFT,
        CONTINUOUS_NEG, LIM_DROP_UBOUND, LIM_WITHIN_UNION,
        OPEN_COUNTABLE_UNION_CLOSED_INTERVALS, .. } := D.qtopology
  let { DIST_REAL, .. } := D.qvec
  -- @@SCOPE END

  let HAS_BOUNDED_VARIATION_DARBOUX_STRONG ← prove
   r"!f a b.
     f has_bounded_variation_on interval[a,b]
     ==> ?g h. (!x. f x = g x - h x) /\
               (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\
                      drop x <= drop y
                      ==> drop(g x) <= drop(g y)) /\
               (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\
                      drop x <= drop y
                      ==> drop(h x) <= drop(h y)) /\
               (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\
                      drop x < drop y
                      ==> drop(g x) < drop(g y)) /\
               (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\
                      drop x < drop y
                      ==> drop(h x) < drop(h y)) /\
               (!x. x IN interval[a,b] /\
                    f continuous (at x within interval[a,x])
                    ==> g continuous (at x within interval[a,x]) /\
                        h continuous (at x within interval[a,x])) /\
               (!x. x IN interval[a,b] /\
                    f continuous (at x within interval[x,b])
                    ==> g continuous (at x within interval[x,b]) /\
                        h continuous (at x within interval[x,b])) /\
               (!x. x IN interval[a,b] /\
                    f continuous (at x within interval[a,b])
                    ==> g continuous (at x within interval[a,b]) /\
                        h continuous (at x within interval[a,b]))"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:real^1. x + lift(vector_variation (interval[a,x]) (f:real^1->real^1))",
      ← q r"\x:real^1. x + lift(vector_variation (interval[a,x]) f) - f x"] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(x + l) - (x + l - f):real^1 = f")] THEN
    REWRITE_TAC [LIFT_DROP, DROP_SUB, DROP_ADD] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC VECTOR_VARIATION_MONOTONE,
      MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!x. a - (b - x) <= c - (d - x) ==> a - b <= c - d")) THEN
      EXISTS_TAC (← q r"drop(f(a:real^1))") THEN
      REWRITE_TAC [← GSYM DROP_SUB] THEN
      MATCH_MP_TAC VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE,
      MATCH_MP_TAC REAL_LTE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC VECTOR_VARIATION_MONOTONE,
      MATCH_MP_TAC REAL_LTE_ADD2 THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!x. a - (b - x) <= c - (d - x) ==> a - b <= c - d")) THEN
      EXISTS_TAC (← q r"drop(f(a:real^1))") THEN
      REWRITE_TAC [← GSYM DROP_SUB] THEN
      MATCH_MP_TAC VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE,
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS_LEFT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS_LEFT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS_RIGHT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS_RIGHT) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS) THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC CONTINUOUS_ADD THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_ID] THEN
      MATCH_MP_TAC CONTINUOUS_SUB THEN ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_CONTINUOUS) THEN
      ASM_REWRITE_TAC []] THEN
    (CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
         HAS_BOUNDED_VARIATION_ON_SUBSET)),
        ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1, INTERVAL_EQ_EMPTY_1] THEN
      ASM_REAL_ARITH_TAC))

  let INCREASING_COUNTABLE_DISCONTINUITIES ← prove
   r"!f s. is_interval s /\
         (!x y. x IN s /\ y IN s /\ drop x <= drop y
                ==> drop(f x) <= drop(f y))
         ==> COUNTABLE {x | x IN s /\ ~(f continuous at x)}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE {x | x IN frontier s /\ ~(f continuous at x)} /\
    COUNTABLE {x | x IN interior s /\
                    ~((f:real^1->real^1) continuous at x)}")
    MP_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM COUNTABLE_UNION] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
      REWRITE_TAC [frontier] THEN
      MP_TAC (← ISPEC (← q r"s:real^1->bool") CLOSURE_SUBSET) THEN SET_TAC []] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN MATCH_MP_TAC FINITE_RESTRICT THEN
      ASM_MESON_TAC [CARD_FRONTIER_INTERVAL_1],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"open(interior s) /\
    !x y. x IN interior s /\ y IN interior s /\ drop x <= drop y
          ==> drop(f x) <= drop(f y)")
    MP_TAC THENL
     [REWRITE_TAC [OPEN_INTERIOR] THEN
      MP_TAC (← ISPEC (← q r"s:real^1->bool") INTERIOR_SUBSET) THEN ASM SET_TAC [],
      POP_ASSUM_LIST (K ALL_TAC)] THEN
    SPEC_TAC (← q r"interior s:real^1->bool", ← q r"s:real^1->bool") THEN
    REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_COUNTABLE_UNION_CLOSED_INTERVALS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(real^1->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    REWRITE_TAC [INTER_UNIONS] THEN MATCH_MP_TAC COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"i:real^1->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:real^1->bool")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    DISCH_THEN SUBST_ALL_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
          ==> drop(f x) <= drop(f y)")
    MP_TAC THENL
     [ASM SET_TAC [], POP_ASSUM_LIST (K ALL_TAC) THEN DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, COUNTABLE_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT]) THEN
    ASM_SIMP_TAC [CLOSED_OPEN_INTERVAL_1] THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
     (← q r"a INSERT b INSERT
    {x | x IN interval(a,b) /\ ~((f:real^1->real^1) continuous at x)}") THEN
    CONJ_TAC THENL [REWRITE_TAC [COUNTABLE_INSERT], SET_TAC []] THEN
    SUBGOAL_THEN
     (← q r"(!c:real^1. c IN interval(a,b) ==> c limit_point_of interval[a,c]) /\
    (!c:real^1. c IN interval(a,b) ==> c limit_point_of interval[c,b])")
    STRIP_ASSUME_TAC THENL
     [SIMP_TAC [IN_INTERVAL_1, REAL_LE_REFL, LIMPT_OF_CONVEX,
                CONVEX_INTERVAL, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [← GSYM INTERVAL_SING, ← GSYM SUBSET_ANTISYM_EQ] THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1"]
          INCREASING_LEFT_LIMIT_1) THEN
    ASM_REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"l:real^1->real^1") (LABEL_TAC "l")) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"b:real^1"]
          INCREASING_RIGHT_LIMIT_1) THEN
    ASM_REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real^1->real^1") (LABEL_TAC "r")) THEN
    SUBGOAL_THEN
     (← q r"!c. c IN interval(a:real^1,b)
        ==> drop(l c) <= drop(f c) /\ drop(f c) <= drop(r c)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"at c within interval[a:real^1,c]")
          LIM_DROP_UBOUND),
        MATCH_MP_TAC (← ISPEC (← q r"at c within interval[c:real^1,b]")
          LIM_DROP_LBOUND)] THEN
      EXISTS_TAC (← q r"f:real^1->real^1") THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] INTERVAL_OPEN_SUBSET_CLOSED,
                    TRIVIAL_LIMIT_WITHIN, EVENTUALLY_WITHIN] THEN
      EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_INTERVAL_1] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
      SUBGOAL_THEN
     (← q r"(!c x. c IN interval(a:real^1,b) /\ x IN interval[a,b] /\ drop x < drop c
           ==> drop(f x) <= drop(l c)) /\
    (!c x. c IN interval(a:real^1,b) /\ x IN interval[a,b] /\ drop c < drop x
           ==> drop(r c) <= drop(f x))")
    STRIP_ASSUME_TAC THENL
     [REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"at c within interval[a:real^1,c]")
          LIM_DROP_LBOUND),
        MATCH_MP_TAC (← ISPEC (← q r"at c within interval[c:real^1,b]")
          LIM_DROP_UBOUND)] THEN
      EXISTS_TAC (← q r"f:real^1->real^1") THEN
      ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] INTERVAL_OPEN_SUBSET_CLOSED,
                    TRIVIAL_LIMIT_WITHIN, EVENTUALLY_WITHIN]
      THENL
       [EXISTS_TAC (← q r"drop c - drop x"), EXISTS_TAC (← q r"drop x - drop c")] THEN
      ASM_REWRITE_TAC [REAL_SUB_LT] THEN
      X_GEN_TAC (← q r"y:real^1") THEN
      REWRITE_TAC [IN_INTERVAL_1, IN_ELIM_THM, DIST_REAL, ← GSYM drop] THEN
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [COUNTABLE, ge_c] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"rational") THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ge_c] THEN
    REWRITE_TAC [COUNTABLE_RATIONAL, ← GSYM COUNTABLE, le_c] THEN
    SUBGOAL_THEN
     (← q r"!c. c IN interval(a,b) /\ ~((f:real^1->real^1) continuous at c)
          ==> drop(l(c:real^1)) < drop(r c)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_LT_LE] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [REAL_LE_TRANS], ALL_TAC] THEN
      REWRITE_TAC [DROP_EQ] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"l c = (f:real^1->real^1) c /\ r c = f c") ASSUME_TAC THENL
       [ASM_MESON_TAC [REAL_LE_ANTISYM, DROP_EQ], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CONTINUOUS_AT]) THEN
      REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"((f:real^1->real^1) --> f c) (at c within interval(a,b))")
      MP_TAC THENL
       [ALL_TAC, ASM_SIMP_TAC [OPEN_INTERVAL, LIM_WITHIN_OPEN]] THEN
      MATCH_MP_TAC LIM_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"interval[a:real^1,c] UNION interval[c,b]") THEN
      REWRITE_TAC [LIM_WITHIN_UNION] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [← REWRITE_RULE [SUBSET] INTERVAL_OPEN_SUBSET_CLOSED],
        REWRITE_TAC [SUBSET, IN_UNION, IN_INTERVAL_1] THEN REAL_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!c. c IN interval(a,b) /\ ~((f:real^1->real^1) continuous at c)
        ==> ?q. rational q /\ drop(l c) < q /\ q < drop(r c)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"drop(l(c:real^1)) < drop(r c)") ASSUME_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"(drop(l(c:real^1)) + drop(r c)) / &2",
                        ← q r"(drop(r c) - drop(l(c:real^1))) / &2"]
        RATIONAL_APPROXIMATION) THEN
      ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, IN_ELIM_THM, IN_INTERVAL_1] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q:real^1->real") THEN
    SIMP_TAC [IN] THEN DISCH_THEN (LABEL_TAC "*") THEN
    MATCH_MP_TAC (← MESON [REAL_LE_TOTAL]
     (← q r"(!x y. P x y ==> P y x) /\ (!x y. drop x <= drop y ==> P x y)
    ==> !x y. P x y")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    REWRITE_TAC [REAL_LE_LT, DROP_EQ] THEN
    ASM_CASES_TAC (← q r"x:real^1 = y") THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"q(x:real^1) < q(y)") MP_TAC THENL
     [ALL_TAC, ASM_REWRITE_TAC [REAL_LT_REFL]] THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"drop(r(x:real^1))") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"drop(l(y:real^1))") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"drop(f(inv(&2) % (x + y):real^1))") THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_ADD] THEN
    ASM_REAL_ARITH_TAC)

  let DECREASING_COUNTABLE_DISCONTINUITIES ← prove
   r"!f s. is_interval s /\
         (!x y. x IN s /\ y IN s /\ drop x <= drop y
                ==> drop(f y) <= drop(f x))
         ==> COUNTABLE {x | x IN s /\ ~(f continuous at x)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(--) o (f:real^1->real^1)", ← q r"s:real^1->bool"]
          INCREASING_COUNTABLE_DISCONTINUITIES) THEN
    ASM_REWRITE_TAC [o_THM, DROP_NEG, REAL_LE_NEG2] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
    REPEAT (STRIP_TAC THEN ASM_REWRITE_TAC []) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_NEG) THEN
    ASM_REWRITE_TAC [o_THM, VECTOR_NEG_NEG, ETA_AX])

  let HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s /\ is_interval s
        ==> COUNTABLE {x | x IN s /\ ~(f continuous at x)}"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [CONTINUOUS_COMPONENTWISE_LIFT] THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE(UNIONS
     {{x | x IN s /\ ~((\x. lift((f:real^1->real^N) x$i)) continuous at x)} |
           i IN 1..dimindex(:N)})")
    MP_TAC THENL
     [MATCH_MP_TAC COUNTABLE_UNIONS,
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_NUMSEG] THEN SET_TAC []] THEN
    SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, FINITE_IMP_COUNTABLE, FINITE_NUMSEG,
              FINITE_IMAGE, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num") o GEN_REWRITE_RULE I
     [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
    ASM_REWRITE_TAC [] THEN
    SPEC_TAC (← q r"\x. lift((f:real^1->real^N) x$i)", ← q r"f:real^1->real^1") THEN
    UNDISCH_TAC (← q r"is_interval(s:real^1->bool)") THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"s:real^1->bool"]
          HAS_BOUNDED_VARIATION_DARBOUX_GEN) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^1", ← q r"s:real^1->bool"]
          INCREASING_COUNTABLE_DISCONTINUITIES) THEN
    MP_TAC (← ISPECL [← q r"h:real^1->real^1", ← q r"s:real^1->bool"]
          INCREASING_COUNTABLE_DISCONTINUITIES) THEN
    ASM_REWRITE_TAC [IMP_IMP, IS_INTERVAL_INTERVAL, ← GSYM COUNTABLE_UNION] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(p /\ q ==> r) ==> a /\ ~r ==> a /\ ~p \/ a /\ ~q")) THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [← GSYM ETA_AX] THEN
    ASM_SIMP_TAC [CONTINUOUS_SUB])

  pure { HAS_BOUNDED_VARIATION_DARBOUX_STRONG, INCREASING_COUNTABLE_DISCONTINUITIES,
         DECREASING_COUNTABLE_DISCONTINUITIES,
         HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES }

/- ------------------------------------------------------------------------- -/
/- Bounded variation and the derivative; integrability of BV products;      -/
/- indefinite integrals have bounded variation.                             -/
/- (integration.ml 20885-21085)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBJ where
  HAS_BOUNDED_VARIATION_ABSOLUTELY_INTEGRABLE_DERIVATIVE : thm
  HAS_BOUNDED_VARIATION_INTEGRABLE_NORM_DERIVATIVE : thm
  VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE : thm
  INTEGRABLE_BOUNDED_VARIATION_PRODUCT : thm
  INTEGRABLE_BOUNDED_VARIATION_PRODUCT_ALT : thm
  INTEGRABLE_BOUNDED_VARIATION_BILINEAR_LMUL : thm
  INTEGRABLE_BOUNDED_VARIATION_BILINEAR_RMUL : thm
  INTEGRABLE_BOUNDED_VARIATION : thm
  HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_RIGHT : thm
  HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_LEFT : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBJ [HolBase] (D : IntegrationDeps) (BINA : INA) (BINC : INC) (BINE : INE) (BINH : INH) (BINL : INL) (BINQ : INQ) (BINW : INW) (BINZ : INZ) (BINAB : INAB) (BINAJ : INAJ) (BINAU : INAU) (BINAV : INAV) (BINBB : INBB) : ExceptT String IO INBJ := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND, INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND, INTERVAL_UPPERBOUND_1, INTERVAL_UPPERBOUND_NONEMPTY, .. } :=
        BINA
  let { integrable_on, .. } := BINC
  let { INTEGRABLE_LINEAR, INTEGRABLE_ON_EMPTY, INTEGRABLE_SUB, INTEGRABLE_VSUM,
        INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRABLE_CONST, .. } := BINH
  let { INTEGRAL_COMBINE, .. } := BINL
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { HAS_BOUNDED_SETVARIATION_ON_EQ, HAS_BOUNDED_SETVARIATION_ON_NEG, SET_VARIATION_EQ,
        .. } := BINW
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION, ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE,
        absolutely_integrable_on, .. } := BINZ
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ, ABSOLUTELY_INTEGRABLE_SET_VARIATION,
        .. } := BINAB
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG, .. } := BINAJ
  let { INTEGRABLE_INCREASING_PRODUCT, .. } := BINAU
  let { has_bounded_variation_on, HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, vector_variation,
        .. } := BINAV
  let { HAS_BOUNDED_VARIATION_DARBOUX, .. } := BINBB
  let { ETA_AX, FINITE_NUMSEG, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_NUMSEG, LEFT_IMP_EXISTS_THM, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_NOT_LE, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, SWAP_FORALL_THM, .. } := D.dv.dg.pt.cvx.core6
  let { BASIS_EXPANSION, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_SUB, DROP_VEC, INTERVAL_NE_EMPTY, LIFT_DROP, LIFT_EQ, LINEAR_CMUL, LINEAR_VSUM,
        .. } := D.dv.dg.pt.cvx.vec2
  let { bilinear, VECTOR_MUL_LID, VECTOR_SUB_RDISTRIB, .. } := D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_SUBSET, .. } := D.dv.dg.pt.cvx.top3
  let { INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_TAC, VECTOR_ARITH, .. } :=
        D.dv.dg.pt.cvx
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { BILINEAR_DROP_MUL, .. } := D.dv.qvec
  let { HAS_VECTOR_DERIVATIVE_AT_WITHIN, VECTOR_DERIVATIVE_WORKS, .. } := D.qderivatives
  let { BILINEAR_SWAP, .. } := D.qvec
  -- @@SCOPE END

  let HAS_BOUNDED_VARIATION_ABSOLUTELY_INTEGRABLE_DERIVATIVE ← prove
   r"!f:real^1->real^N s a b.
        COUNTABLE s /\ f continuous_on interval[a,b] /\
        (!x. x IN interval[a,b] DIFF s ==> f differentiable at x)
        ==> (f has_bounded_variation_on interval[a,b] <=>
             (\x. vector_derivative f (at x))
             absolutely_integrable_on interval[a,b])"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION_EQ] THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p <=> r) ==> (p <=> q /\ r)")) THEN CONJ_TAC THENL
     [ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [INTEGRABLE_ON_EMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N",
                        ← q r"\x. vector_derivative (f:real^1->real^N) (at x)",
                        ← q r"s:real^1->bool", ← q r"a:real^1", ← q r"b:real^1"]
        FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG) THEN
      ASM_MESON_TAC [VECTOR_DERIVATIVE_WORKS, integrable_on,
                     HAS_VECTOR_DERIVATIVE_AT_WITHIN],
      MATCH_MP_TAC (← MESON [HAS_BOUNDED_SETVARIATION_ON_EQ]
       (← q r"(!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> f(interval[a,b]) = g(interval[a,b]))
      ==> (f has_bounded_setvariation_on s <=>
           g has_bounded_setvariation_on s)")) THEN
      SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND,
                ← GSYM INTERVAL_NE_EMPTY] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN
      REWRITE_TAC [INTERVAL_NE_EMPTY_1] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N",
                        ← q r"\x. vector_derivative (f:real^1->real^N) (at x)",
                        ← q r"s:real^1->bool", ← q r"u:real^1", ← q r"v:real^1"]
        FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG) THEN
      ASM_REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC [INTEGRAL_UNIQUE]] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, IN_DIFF, SUBSET],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_AT_WITHIN THEN
        ASM_SIMP_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN ASM SET_TAC []]])

  let HAS_BOUNDED_VARIATION_INTEGRABLE_NORM_DERIVATIVE ← prove
   r"!f:real^1->real^N s a b.
        COUNTABLE s /\ f continuous_on interval[a,b] /\
        (!x. x IN interval[a,b] DIFF s ==> f differentiable at x)
        ==> (f has_bounded_variation_on interval[a,b] <=>
             (\x. lift(norm(vector_derivative f (at x))))
             integrable_on interval[a,b])"
   (REPEAT GEN_TAC THEN DISCH_THEN (fun th => tactic_of do
      pure (STRIP_ASSUME_TAC th THEN
            REWRITE_TAC [← MATCH_MP HAS_BOUNDED_VARIATION_ABSOLUTELY_INTEGRABLE_DERIVATIVE
                        th])) THEN
    REWRITE_TAC [absolutely_integrable_on] THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> (p /\ q <=> q)")) THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
    ASM_REWRITE_TAC [INTEGRABLE_ON_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N",
                      ← q r"\x. vector_derivative (f:real^1->real^N) (at x)",
                      ← q r"s:real^1->bool", ← q r"a:real^1", ← q r"b:real^1"]
      FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG) THEN
    ASM_MESON_TAC [VECTOR_DERIVATIVE_WORKS, integrable_on,
                   HAS_VECTOR_DERIVATIVE_AT_WITHIN])

  let VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE ← prove
   r"!f:real^1->real^N s a b.
        COUNTABLE s /\ f continuous_on interval[a,b] /\
        (!x. x IN interval[a,b] DIFF s ==> f differentiable at x) /\
        f has_bounded_variation_on interval[a,b]
        ==> vector_variation (interval[a,b]) f =
                drop(integral (interval[a,b])
                        (\x. lift(norm(vector_derivative f (at x)))))"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^1->real^N", ← q r"s:real^1->bool", ← q r"a:real^1", ← q r"b:real^1"]
     HAS_BOUNDED_VARIATION_ABSOLUTELY_INTEGRABLE_DERIVATIVE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_SET_VARIATION) THEN
    REWRITE_TAC [vector_variation] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC SET_VARIATION_EQ THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN
    SIMP_TAC [INTERVAL_NE_EMPTY_1, INTERVAL_LOWERBOUND_1,
              INTERVAL_UPPERBOUND_1] THEN
    STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG THEN
    EXISTS_TAC (← q r"s:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    ASM_MESON_TAC [VECTOR_DERIVATIVE_WORKS, HAS_VECTOR_DERIVATIVE_AT_WITHIN,
                   IN_DIFF, SUBSET])

  let INTEGRABLE_BOUNDED_VARIATION_PRODUCT ← prove
   r"!f:real^1->real^N g a b.
        f integrable_on interval[a,b] /\
        g has_bounded_variation_on interval[a,b]
        ==> (\x. drop(g x) % f x) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE I [HAS_BOUNDED_VARIATION_DARBOUX]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"h:real^1->real^1", ← q r"k:real^1->real^1"] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [DROP_SUB, VECTOR_SUB_RDISTRIB] THEN
    MATCH_MP_TAC INTEGRABLE_SUB THEN
    CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_INCREASING_PRODUCT THEN
    ASM_REWRITE_TAC [])

  let INTEGRABLE_BOUNDED_VARIATION_PRODUCT_ALT ← prove
   r"!f:real^1->real^N g a b.
        f integrable_on interval[a,b] /\
        (lift o g) has_bounded_variation_on interval[a,b]
        ==> (\x. g x % f x) integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_BOUNDED_VARIATION_PRODUCT) THEN
    REWRITE_TAC [o_DEF, LIFT_DROP])

  let INTEGRABLE_BOUNDED_VARIATION_BILINEAR_LMUL ← prove
   r"!op:real^M->real^N->real^P f g a b.
        bilinear op /\
        f integrable_on interval[a,b] /\
        g has_bounded_variation_on interval[a,b]
        ==> (\x. op (g x) (f x)) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o LAND_CONV)
     [← GSYM BASIS_EXPANSION] THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT2 o GEN_REWRITE_RULE I [bilinear]) THEN
    FIRST_ASSUM (MP_TAC o GEN_ALL o ISPEC (← q r"1..n") o
      ONCE_REWRITE_RULE [SWAP_FORALL_THM] o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          LINEAR_VSUM) o SPEC_ALL) THEN
    SIMP_TAC [FINITE_NUMSEG, o_DEF] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC INTEGRABLE_VSUM THEN REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
    X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_ALL o MATCH_MP LINEAR_CMUL o SPEC_ALL) THEN
    SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC INTEGRABLE_BOUNDED_VARIATION_PRODUCT_ALT THEN
    RULE_ASSUM_TAC (ONCE_REWRITE_RULE
      [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE]) THEN
    ASM_SIMP_TAC [o_DEF, IN_NUMSEG] THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC INTEGRABLE_LINEAR THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o GEN_REWRITE_RULE I [bilinear]) THEN
    SIMP_TAC [ETA_AX])

  let INTEGRABLE_BOUNDED_VARIATION_BILINEAR_RMUL ← prove
   r"!op:real^M->real^N->real^P f g a b.
        bilinear op /\
        f integrable_on interval[a,b] /\
        g has_bounded_variation_on interval[a,b]
        ==> (\x. op (f x) (g x)) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"\x y. (op:real^M->real^N->real^P) y x",
      ← q r"f:real^1->real^M", ← q r"g:real^1->real^N",
      ← q r"a:real^1", ← q r"b:real^1"] INTEGRABLE_BOUNDED_VARIATION_BILINEAR_LMUL) THEN
    ASM_REWRITE_TAC [BILINEAR_SWAP])

  let INTEGRABLE_BOUNDED_VARIATION ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x:real^1 y:real^N. drop x % y",
      ← q r"(\x. vec 1):real^1->real^1",
      ← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"b:real^1"]
          INTEGRABLE_BOUNDED_VARIATION_BILINEAR_RMUL) THEN
    ASM_REWRITE_TAC [BILINEAR_DROP_MUL, DROP_VEC, INTEGRABLE_CONST] THEN
    REWRITE_TAC [VECTOR_MUL_LID, ETA_AX])

  let HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_RIGHT ← prove
   r"!f:real^1->real^N a b.
        f absolutely_integrable_on interval[a,b]
        ==> (\c. integral (interval[a,c]) f) has_bounded_variation_on
            interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_SETVARIATION_ON_EQ) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, LIFT_EQ,
              INTERVAL_UPPERBOUND_NONEMPTY] THEN
    SIMP_TAC [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1, ← GSYM REAL_NOT_LE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← VECTOR_ARITH
     (← q r"a:real^N = b - c <=> c + a = b")] THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTEGRABLE_ON_SUBINTERVAL) THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  let HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_LEFT ← prove
   r"!f:real^1->real^N a b.
        f absolutely_integrable_on interval[a,b]
        ==> (\c. integral (interval[c,b]) f) has_bounded_variation_on
            interval[a,b]"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    ONCE_REWRITE_TAC [← GSYM HAS_BOUNDED_SETVARIATION_ON_NEG] THEN
    FIRST_ASSUM (MP_TAC o
      MATCH_MP ABSOLUTELY_INTEGRABLE_BOUNDED_SETVARIATION) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_SETVARIATION_ON_EQ) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, LIFT_EQ,
              INTERVAL_UPPERBOUND_NONEMPTY] THEN
    SIMP_TAC [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1, ← GSYM REAL_NOT_LE] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← VECTOR_ARITH
     (← q r"a:real^N = --(b - c) <=> a + b = c")] THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INTEGRABLE_ON_SUBINTERVAL) THEN
    ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)

  pure { HAS_BOUNDED_VARIATION_ABSOLUTELY_INTEGRABLE_DERIVATIVE,
         HAS_BOUNDED_VARIATION_INTEGRABLE_NORM_DERIVATIVE,
         VECTOR_VARIATION_INTEGRAL_NORM_DERIVATIVE, INTEGRABLE_BOUNDED_VARIATION_PRODUCT,
         INTEGRABLE_BOUNDED_VARIATION_PRODUCT_ALT,
         INTEGRABLE_BOUNDED_VARIATION_BILINEAR_LMUL,
         INTEGRABLE_BOUNDED_VARIATION_BILINEAR_RMUL, INTEGRABLE_BOUNDED_VARIATION,
         HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_RIGHT,
         HAS_BOUNDED_VARIATION_ON_INDEFINITE_INTEGRAL_LEFT }

/- ------------------------------------------------------------------------- -/
/- Continuous BV functions are uniformly continuous; Darboux BV functions   -/
/- are continuous.  (integration.ml 21086-21280)                            -/
/- ------------------------------------------------------------------------- -/

structure INBK where
  CONTINUOUS_BV_IMP_UNIFORMLY_CONTINUOUS : thm
  HAS_BOUNDED_VARIATION_ON_DARBOUX_IMP_CONTINUOUS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBK [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBF : INBF) : ExceptT String IO INBK := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, .. } := BINA
  let { DIVISION_OF_SING, DIVISION_OF_TRIVIAL, ELEMENTARY_COMPACT, .. } := BINB
  let { HAS_BOUNDED_VARIATION_WORKS, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_GE_NORM_FUNCTION,
        VECTOR_VARIATION_MONOTONE, .. } := BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { HAS_BOUNDED_VARIATION_LEFT_LIMIT_GEN, HAS_BOUNDED_VARIATION_RIGHT_LIMIT_GEN, .. } :=
        BINBF
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_LT, REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_MIN,
        REAL_LTE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_LT, SUBSET, SUBSET_REFL, .. } :=
        D.dv.dg.pt.cvx.core5
  let { SUM_CLAUSES, SUM_SING, .. } := D.dv.dg.pt.cvx.core6
  let { HULL_MINIMAL, HULL_SUBSET, REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_REFL, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_EQ, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, INTERVAL_SING, LIFT_DROP,
        NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, drop, VECTOR_SUB_REFL, .. } := D.dv.dg.pt.cvx.vec4
  let { COMPACT_INTERVAL, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_1,
        IS_INTERVAL_COMPACT, .. } := D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, SEGMENT_SYM, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_RULE,
        SET_TAC, .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { COMPACT_CONVEX_HULL, CONVEX_CONTAINS_SEGMENT, CONVEX_CONVEX_HULL,
        CONVEX_HULL_EQ_EMPTY, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.dv.dg.qtopology2
  let { CONVEX_HULL_EQ_SING, .. } := D.qconvex
  let { DARBOUX_AND_REGULATED_IMP_CONTINUOUS, .. } := D.qpaths
  let { DIST_REAL, .. } := D.qvec
  -- @@SCOPE END

  let CONTINUOUS_BV_IMP_UNIFORMLY_CONTINUOUS ← prove
   r"!f:real^1->real^N s.
        is_interval s /\
        f continuous_on s /\ f has_bounded_variation_on s
        ==> f uniformly_continuous_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [uniformly_continuous_on] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"vector_variation s (f:real^1->real^N) < e") THENL
     [EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS)) THEN
      REWRITE_TAC [dist] THEN MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
      ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, IS_INTERVAL_CONVEX_1],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT])] THEN
    SUBGOAL_THEN
     (← q r"?a b. a IN s /\ b IN s /\ drop a < drop b /\
          vector_variation s (f:real^1->real^N) - e / &2
          < vector_variation (interval[a,b]) f /\
          vector_variation (interval[a,b]) f <= vector_variation s f")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_WORKS) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC
       (MP_TAC o SPEC (← q r"vector_variation s (f:real^1->real^N) - e / &2"))) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"v <= v - e / &2 <=> ~(&0 < e)"), IMP_IMP] THEN
      DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM, NOT_IMP] THEN
      MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
      ASM_CASES_TAC (← q r"?c:real^1. t SUBSET {c}") THENL
       [FIRST_X_ASSUM (CHOOSE_THEN (STRIP_ASSUME_TAC o MATCH_MP (← SET_RULE
         (← q r"s SUBSET {a} ==> s = {} \/ s = {a}")))) THEN
        ASM_SIMP_TAC [IMP_CONJ, DIVISION_OF_TRIVIAL, SUM_CLAUSES] THENL
         [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        ONCE_REWRITE_TAC [← GSYM INTERVAL_SING] THEN
        REWRITE_TAC [DIVISION_OF_SING] THEN
        SIMP_TAC [SUM_SING, VECTOR_SUB_REFL, NORM_0, REAL_LE_REFL,
                  INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_REWRITE_TAC [REAL_NOT_LE] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"convex hull t:real^1->bool") IS_INTERVAL_COMPACT) THEN
      DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1)) THEN ANTS_TAC THENL
       [REWRITE_TAC [IS_INTERVAL_CONVEX_1, CONVEX_CONVEX_HULL] THEN
        MATCH_MP_TAC COMPACT_CONVEX_HULL THEN
        ASM_MESON_TAC [ELEMENTARY_COMPACT],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^1") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:real^1")] THEN
      ASM_CASES_TAC (← q r"drop b <= drop a") THENL
       [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [REAL_LE_LT]) THEN
        REWRITE_TAC [DROP_EQ, ← GSYM INTERVAL_EQ_EMPTY_1] THEN
        STRIP_TAC THEN
        ASM_REWRITE_TAC [CONVEX_HULL_EQ_SING, CONVEX_HULL_EQ_EMPTY,
                         INTERVAL_SING] THEN
        ASM SET_TAC [],
        RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE])] THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN  (← q r"convex hull (t:real^1->bool) SUBSET s") MP_TAC THENL
       [ASM_MESON_TAC [IS_INTERVAL_CONVEX_1, HULL_MINIMAL],
        ASM_REWRITE_TAC [] THEN DISCH_TAC] THEN
      REPLICATE_TAC 2 (MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
       CONJ_TAC THENL
        [ASM_MESON_TAC [SUBSET, ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1,
                        REAL_LT_IMP_LE],
         DISCH_TAC]) THEN
      ASM_SIMP_TAC [VECTOR_VARIATION_MONOTONE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        REAL_LTE_TRANS)) THEN
      SUBGOAL_THEN
       (← q r"(f:real^1->real^N) has_bounded_variation_on interval[a,b]")
      MP_TAC THENL
       [ASM_MESON_TAC [HAS_BOUNDED_VARIATION_ON_SUBSET],
        DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_WORKS)] THEN
      DISCH_THEN (MATCH_MP_TAC o CONJUNCT1) THEN
      EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_MESON_TAC [HULL_SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"interval[a:real^1,b] SUBSET s") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(f:real^1->real^N) uniformly_continuous_on interval[a,b]")
    MP_TAC THENL
     [ASM_MESON_TAC [COMPACT_UNIFORMLY_CONTINUOUS, COMPACT_INTERVAL,
                     CONTINUOUS_ON_SUBSET],
      REWRITE_TAC [uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d (drop b - drop a)") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s /\ drop b <= drop x ==> dist(f x:real^N,f b) < e / &2")
    STRIP_ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"x:real^1",
                        ← q r"b:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"d <= bx /\ ax - e < ab ==> ab + bx = ax ==> d < e")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
        ASM_REWRITE_TAC [SEGMENT_1, SUBSET_REFL] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)),
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"s - e < ab ==> t <= s ==> t - e < ab"))) THEN
        MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
        ASM_REWRITE_TAC []] THEN
      REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s /\ drop x <= drop a ==> dist(f x:real^N,f a) < e / &2")
    STRIP_ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"x:real^1", ← q r"b:real^1",
                        ← q r"a:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"d <= xa /\ xb - e < ab ==> xa + ab = xb ==> d < e")) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [dist] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
        ASM_REWRITE_TAC [SEGMENT_1, SUBSET_REFL] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)),
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"s - e < ab ==> t <= s ==> t - e < ab"))) THEN
        MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
        ASM_REWRITE_TAC []] THEN
      REWRITE_TAC [SUBSET, IN_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
    ASM_REWRITE_TAC [FORALL_DROP, LIFT_DROP, DIST_REFL] THEN
    CONJ_TAC THENL [MESON_TAC [DIST_SYM], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN
    REWRITE_TAC [DIST_REAL, ← GSYM drop] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(drop u <= drop a /\ drop v <= drop a \/
     drop u <= drop a /\ v IN interval[a,b]) \/
    u IN interval[a,b] /\ v IN interval[a,b] \/
    u IN interval[a,b] /\ drop b <= drop v \/
    drop b <= drop u /\ drop b <= drop v")
    MP_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
     [STRIP_TAC THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"!a:real^N. dist(u,a) < e / &2 /\ dist(v,a) < e / &2
                 ==> dist(u,v) < e")) THEN
      EXISTS_TAC (← q r"(f:real^1->real^N) a") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"v:real^1"]) THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, DIST_REAL, ← GSYM drop,
                       INTERVAL_NE_EMPTY_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (DISJ_CASES_THEN2 ASSUME_TAC MP_TAC) THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x < e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [DIST_REAL, ← GSYM drop] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [DIST_REAL, ← GSYM drop],
      STRIP_TAC THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"!a:real^N. dist(u,a) < e / &2 /\ dist(v,a) < e / &2
                 ==> dist(u,v) < e")) THEN
      EXISTS_TAC (← q r"(f:real^1->real^N) b") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"b:real^1", ← q r"u:real^1"]) THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, DIST_REAL, ← GSYM drop,
                       INTERVAL_NE_EMPTY_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN ASM_REAL_ARITH_TAC])

  let HAS_BOUNDED_VARIATION_ON_DARBOUX_IMP_CONTINUOUS ← prove
   r"!f:real^1->real^N s.
      is_interval s /\ f has_bounded_variation_on s /\
      (!c. c SUBSET s /\ connected c ==> connected(IMAGE f c))
      ==> f continuous_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC DARBOUX_AND_REGULATED_IMP_CONTINUOUS THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_LEFT_LIMIT_GEN,
                  HAS_BOUNDED_VARIATION_RIGHT_LIMIT_GEN])

  pure { CONTINUOUS_BV_IMP_UNIFORMLY_CONTINUOUS,
         HAS_BOUNDED_VARIATION_ON_DARBOUX_IMP_CONTINUOUS }

/- ------------------------------------------------------------------------- -/
/- Variation on the interior and closure; BV and monotone functions are     -/
/- Baire class 1.  (integration.ml 21281-21477)                             -/
/- ------------------------------------------------------------------------- -/

structure INBL where
  VECTOR_VARIATION_ON_INTERIOR : thm
  VECTOR_VARIATION_ON_CLOSURE : thm
  HAS_BOUNDED_VARIATION_IMP_BAIRE1 : thm
  INCREASING_IMP_BAIRE1 : thm
  DECREASING_IMP_BAIRE1 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBL [HolBase] (D : IntegrationDeps) (BINAW : INAW) (BINAX : INAX) (BINAY : INAY) (BINBB : INBB) (BINBE : INBE) (BINBH : INBH) (BINBI : INBI) : ExceptT String IO INBL := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_MONOTONE,
        VECTOR_VARIATION_ON_EMPTY, VECTOR_VARIATION_SING, .. } := BINAW
  let { HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ, .. } := BINAX
  let { VECTOR_VARIATION_SPLIT, .. } := BINAY
  let { HAS_BOUNDED_VARIATION_REFLECT_EQ_INTERVAL, VECTOR_VARIATION_REFLECT2, .. } := BINBB
  let { HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ, .. } := BINBE
  let { CONTINUOUS_ON_VECTOR_VARIATION, .. } := BINBH
  let { DECREASING_COUNTABLE_DISCONTINUITIES,
        HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES,
        INCREASING_COUNTABLE_DISCONTINUITIES, .. } := BINBI
  let { CONTRAPOS_THM, DIMINDEX_1, ETA_AX, EXTENSION, .. } := D.dv.dg.pt.cvx.core1
  let { IMAGE_DELETE_INJ, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DELETE, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_AND, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_LT, REAL_LT_IMP_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LT, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, SWAP_FORALL_THM, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, ENDS_IN_INTERVAL, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_EQ_NEG2, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSED_HALFSPACE_COMPONENT_LE, CLOSED_INTERVAL, .. } := D.dv.dg.pt.cvx.top1
  let { CLOSURE_INC, CLOSURE_INTERVAL, CLOSURE_MINIMAL, CLOSURE_SUBSET, .. } :=
        D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUBSET,
        FORALL_IN_CLOSURE, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_EMPTY, INTERIOR_SUBSET, .. } := D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INT_ARITH, MESON, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.dv.dg.pt.cvx
  let { DELETE_SUBSET, EMPTY_DELETE, .. } := D.dv.dg.pt.qses
  let { AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFF_DIM_GE, AFF_DIM_LE_UNIV, .. } :=
        D.dv.dg.pt.qcvx1
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { CONNECTED_INTERVAL, .. } := D.dv.qconvex
  let { CONTINUOUS_AT_WITHIN, .. } := D.dv.qtopology1
  let { AFF_DIM_NONEMPTY_INTERIOR_EQ, CONVEX_INTERIOR_CLOSURE,
        IN_INTERIOR_CLOSURE_CONVEX_SEGMENT, IS_INTERVAL_CLOSURE, IS_INTERVAL_INTERIOR, .. }
        := D.qconvex
  let { COUNTABLE_SUBSET, .. } := D.qcard
  let { CONNECTED_LIMIT_POINTS_EQ_CLOSURE, COUNTABLE_DISCONTINUITIES_IMP_BAIRE1,
        IN_CLOSURE_DELETE, .. } := D.qtopology
  let { REFLECT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let VECTOR_VARIATION_ON_INTERIOR ← (do
    let lemma1 ← prove
     r"!f:real^1->real^N a b.
          f has_bounded_variation_on interval[a,b] /\
          f continuous_on interval[a,b]
          ==> vector_variation (interval[a,b] DELETE b) f =
              vector_variation(interval[a,b]) f"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [EMPTY_DELETE] THEN
      MP_TAC (← ISPECL
       [← q r"\x. lift(vector_variation (interval[a,x]) (f:real^1->real^N))",
        ← q r"interval[a:real^1,b] DELETE b",
        ← q r"{x | drop x <=
            vector_variation (interval[a,b] DELETE b) (f:real^1->real^N)}"]
       FORALL_IN_CLOSURE) THEN
      REWRITE_TAC [IN_ELIM_THM, LIFT_DROP] THEN
      REWRITE_TAC [drop, CLOSED_HALFSPACE_COMPONENT_LE] THEN ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
          ASM_SIMP_TAC [CONTINUOUS_ON_VECTOR_VARIATION] THEN
          MATCH_MP_TAC CLOSURE_MINIMAL THEN
          REWRITE_TAC [CLOSED_INTERVAL] THEN SET_TAC [],
          REWRITE_TAC [IN_INTERVAL_1, IN_DELETE, ← GSYM DROP_EQ] THEN
          REPEAT STRIP_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
          CONJ_TAC THENL
           [ASM_MESON_TAC [DELETE_SUBSET, HAS_BOUNDED_VARIATION_ON_SUBSET],
            REWRITE_TAC [SUBSET, IN_INTERVAL_1, IN_DELETE, ← GSYM DROP_EQ] THEN
            ASM_REAL_ARITH_TAC]],
        DISCH_THEN (MP_TAC o SPEC (← q r"b:real^1")) THEN MP_TAC
         (← ISPEC (← q r"interval[a:real^1,b]") CONNECTED_LIMIT_POINTS_EQ_CLOSURE) THEN
        REWRITE_TAC [CONNECTED_INTERVAL] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"b IN s /\ (s = {b} ==> Q) /\ (P ==> Q)
       ==> (~(?a. s = {a}) ==> P) ==> Q")) THEN
        ASM_SIMP_TAC [ENDS_IN_INTERVAL, ← SET_RULE (← q r"{a} DELETE a = {}")] THEN
        REWRITE_TAC [VECTOR_VARIATION_SING, VECTOR_VARIATION_ON_EMPTY] THEN
        SIMP_TAC [CLOSURE_INTERVAL, EXTENSION,
                  IN_ELIM_THM, IN_CLOSURE_DELETE] THEN
        DISCH_THEN (K ALL_TAC) THEN ASM_REWRITE_TAC [ENDS_IN_INTERVAL] THEN
        ASM_SIMP_TAC [← GSYM REAL_LE_ANTISYM] THEN DISCH_TAC THEN
        MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN ASM SET_TAC []])
    let lemma2 ← prove
     r"!f:real^1->real^N a b.
          f has_bounded_variation_on interval[a,b] /\
          f continuous_on interval[a,b]
          ==> vector_variation (interval[a,b] DELETE a) f =
              vector_variation(interval[a,b]) f"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← GSYM VECTOR_VARIATION_REFLECT2] THEN
      SIMP_TAC [IMAGE_DELETE_INJ, VECTOR_EQ_NEG2, REFLECT_INTERVAL] THEN
      MATCH_MP_TAC lemma1 THEN
      ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_REFLECT_EQ_INTERVAL, VECTOR_NEG_NEG] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [REFLECT_INTERVAL, VECTOR_NEG_NEG] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
      SIMP_TAC [CONTINUOUS_ON_NEG, CONTINUOUS_ON_ID])
    prove
     r"!f:real^1->real^N s.
        is_interval s /\
        f has_bounded_variation_on (interior s) /\
        f continuous_on s
        ==> vector_variation (interior s) f = vector_variation s f"
     (REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ] THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s:real^1->bool = {}") THEN
      ASM_REWRITE_TAC [INTERIOR_EMPTY] THEN
      ASM_CASES_TAC (← q r"interior s:real^1->bool = {}") THENL
       [MP_TAC (← ISPEC (← q r"s:real^1->bool") AFF_DIM_NONEMPTY_INTERIOR_EQ) THEN
        ASM_REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← INT_ARITH
         (← q r"~(s:int = d)
      ==> ~(s = -- &1) /\ --(&1) <= s /\ s <= d /\ d = &1 ==> s = &0"))) THEN
        REWRITE_TAC [AFF_DIM_EQ_MINUS1, AFF_DIM_LE_UNIV, AFF_DIM_GE] THEN
        ASM_REWRITE_TAC [DIMINDEX_1, AFF_DIM_EQ_0] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [VECTOR_VARIATION_SING, VECTOR_VARIATION_ON_EMPTY],
        UNDISCH_TAC (← q r"~(interior s:real^1->bool = {})")] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^1") THEN DISCH_TAC THEN
      MP_TAC (← ISPEC (← q r"f:real^1->real^N") VECTOR_VARIATION_SPLIT) THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"drop a")) THEN DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"interior s:real^1->bool") th) THEN
              MP_TAC (← SPEC (← q r"s:real^1->bool") th))) THEN
      ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ, IS_INTERVAL_INTERIOR] THEN
      REPEAT (DISCH_THEN (SUBST1_TAC o SYM)) THEN BINOP_TAC THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(~(s = t) ==> vector_variation s f = vector_variation t f)
    ==> vector_variation s f = vector_variation t f")) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~({x | x IN i /\ P x} = {x | x IN s /\ P x})
    ==> i SUBSET s ==> ?b. b IN s /\ P b /\ ~(b IN i)"))) THEN
      REWRITE_TAC [INTERIOR_SUBSET, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"b:real^1") THEN
      ASM_CASES_TAC (← q r"b:real^1 = a") THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [REAL_LE_LT] THEN
      ASM_REWRITE_TAC [DROP_EQ] THEN STRIP_TAC THENL
       [SUBGOAL_THEN
         (← q r"{x | x IN interior s /\ drop x <= drop a} = interval[b,a] DELETE b /\
      {x | x IN s /\ drop x <= drop a} = interval[b,a]")
        STRIP_ASSUME_TAC THENL
         [ALL_TAC,
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC lemma2 THEN CONJ_TAC THENL
           [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              HAS_BOUNDED_VARIATION_ON_SUBSET)),
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET))] THEN
          ASM SET_TAC []],
        SUBGOAL_THEN
         (← q r"{x | x IN interior s /\ drop a <= drop x} = interval[a,b] DELETE b /\
      {x | x IN s /\ drop a <= drop x} = interval[a,b]")
        STRIP_ASSUME_TAC THENL
         [ALL_TAC,
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC lemma1 THEN CONJ_TAC THENL
           [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              HAS_BOUNDED_VARIATION_ON_SUBSET)),
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET))] THEN
          ASM SET_TAC []]] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"b IN s /\ ~(b IN si) /\ si SUBSET s /\
    s SUBSET i /\ i DELETE b SUBSET si
    ==> si = i DELETE b /\ s = i")) THEN
      ASM_SIMP_TAC [IN_ELIM_THM, SUBSET, REAL_LT_IMP_LE, IN_INTERVAL_1,
                    IN_DELETE, ← REWRITE_RULE [SUBSET] INTERIOR_SUBSET] THEN
      REWRITE_TAC [← GSYM DROP_EQ, ← REAL_ARITH
       (← q r"((b <= x /\ x <= a) /\ ~(x = b) <=> b < x /\ x <= a) /\
    ((a <= x /\ x <= b) /\ ~(x = b) <=> a <= x /\ x < b)")] THEN
     (CONJ_TAC THEN X_GEN_TAC (← q r"c:real^1") THEN STRIP_TAC THENL
       [REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"~((b:real^1) IN interior s)") THEN REWRITE_TAC [],
        ASM_CASES_TAC (← q r"c:real^1 = a") THEN ASM_REWRITE_TAC [] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ])] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET, RIGHT_IMP_FORALL_THM, IMP_IMP]
        IN_INTERIOR_CLOSURE_CONVEX_SEGMENT) THEN
      EXISTS_TAC (← q r"a:real^1") THENL
       [EXISTS_TAC (← q r"c:real^1"), EXISTS_TAC (← q r"b:real^1")] THEN
      ASM_SIMP_TAC [CLOSURE_INC, ← GSYM IS_INTERVAL_CONVEX_1] THEN
      REWRITE_TAC [SEGMENT_1] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC)))

  let VECTOR_VARIATION_ON_CLOSURE ← prove
   r"!f:real^1->real^N s.
        is_interval s /\
        f has_bounded_variation_on s /\
        f continuous_on closure s
        ==> vector_variation (closure s) f = vector_variation s f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"closure s:real^1->bool"]
          VECTOR_VARIATION_ON_INTERIOR) THEN
    ASM_SIMP_TAC [IS_INTERVAL_CLOSURE, HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ,
                  HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ] THEN
    ASM_SIMP_TAC [CONVEX_INTERIOR_CLOSURE, ← GSYM IS_INTERVAL_CONVEX_1] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"s <= c /\ i <= s ==> i = c ==> c = s")) THEN
    CONJ_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
    ASM_SIMP_TAC [INTERIOR_SUBSET, CLOSURE_SUBSET,
                  HAS_BOUNDED_VARIATION_ON_CLOSURE_EQ])

  let HAS_BOUNDED_VARIATION_IMP_BAIRE1 ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s /\ is_interval s ==> baire 1 s f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_DISCONTINUITIES_IMP_BAIRE1 THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP
     HAS_BOUNDED_VARIATION_COUNTABLE_DISCONTINUITIES) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [CONTRAPOS_THM, CONTINUOUS_AT_WITHIN])

  let INCREASING_IMP_BAIRE1 ← prove
   r"!f s.
        is_interval s /\
        (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f x) <= drop(f y))
        ==> baire 1 s f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_DISCONTINUITIES_IMP_BAIRE1 THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP INCREASING_COUNTABLE_DISCONTINUITIES) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [CONTRAPOS_THM, CONTINUOUS_AT_WITHIN])

  let DECREASING_IMP_BAIRE1 ← prove
   r"!f s.
        is_interval s /\
        (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f y) <= drop(f x))
        ==> baire 1 s f"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC COUNTABLE_DISCONTINUITIES_IMP_BAIRE1 THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP DECREASING_COUNTABLE_DISCONTINUITIES) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] COUNTABLE_SUBSET) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [CONTRAPOS_THM, CONTINUOUS_AT_WITHIN])

  pure { VECTOR_VARIATION_ON_INTERIOR, VECTOR_VARIATION_ON_CLOSURE,
         HAS_BOUNDED_VARIATION_IMP_BAIRE1, INCREASING_IMP_BAIRE1, DECREASING_IMP_BAIRE1 }

/- ------------------------------------------------------------------------- -/
/- We can factor a BV function through its variation.                       -/
/- (integration.ml 21478-21661)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBM where
  FACTOR_THROUGH_VARIATION : thm
  FACTOR_CONTINUOUS_THROUGH_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBM [HolBase] (D : IntegrationDeps) (BINA : INA) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBA : INBA) (BINBC : INBC) (BINBD : INBD) (BINBH : INBH) : ExceptT String IO INBM := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_1, .. } := BINA
  let { VECTOR_VARIATION_COMPARISON, VECTOR_VARIATION_EQ, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_CONST_EQ,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_MONOTONE,
        VECTOR_VARIATION_ON_NULL, VECTOR_VARIATION_POS_LE, .. } := BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { VECTOR_VARIATION_ID, .. } := BINBA
  let { VECTOR_VARIATION_COMPOSE_INCREASING, .. } := BINBC
  let { HAS_BOUNDED_VARIATION_ON_ID, LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION, .. } := BINBD
  let { CONTINUOUS_ON_VECTOR_VARIATION, .. } := BINBH
  let { CONJ_ACI, FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { IMAGE_o, IMP_CONJ, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { MONO_EXISTS, NOT_IN_EMPTY, REAL_ABS_SUB, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, .. }
        := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, REAL_WLOG_LE, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM,
        SIMPLE_IMAGE, SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, .. } := D.dv.dg.pt.cvx.core6
  let { DIST_LIFT, DIST_SYM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_VEC, FORALL_DROP, FORALL_LIFT, LIFT_ADD, LIFT_DROP, LIFT_EQ, LIFT_NUM, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { dist, .. } := D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_ID, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, IS_INTERVAL_INTERVAL, .. }
        := D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, SEGMENT_SYM, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { CONTINUOUS_INCREASING_IMAGE_INTERVAL_1, .. } := D.qconvex
  let { FUNCTION_FACTORS_LEFT_GEN, .. } := D.qsession
  let { CONTINUOUS_ON_COMPARISON, .. } := D.qtopology
  -- @@SCOPE END

  let FACTOR_THROUGH_VARIATION ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> ?g. (!x. x IN interval[a,b]
                     ==> f(x) = g(lift(vector_variation(interval[a,x]) f))) /\
                g continuous_on
                 { lift(vector_variation(interval[a,u]) f) |u|
                   u IN interval[a,b]} /\
                (!x y. x IN { lift(vector_variation(interval[a,u]) f) |u|
                              u IN interval[a,b]} /\
                       y IN { lift(vector_variation(interval[a,u]) f) |u|
                              u IN interval[a,b]}
                       ==> dist(g x,g y) <= dist(x,y))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON []
     (← q r"(?x. P x) /\ (!x. R x ==> Q x) /\ (!x. P x ==> R x)
    ==> ?x. P x /\ Q x /\ R x")) THEN
    REPEAT CONJ_TAC THENL
     [ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
      REWRITE_TAC [← GSYM FUNCTION_FACTORS_LEFT_GEN] THEN
      REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP, IN_INTERVAL_1] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"y:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
      ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LT_IMP_LE] THEN ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [LIFT_EQ, ← GSYM LIFT_ADD, ← REAL_ARITH
         (← q r"a = a + b <=> b = &0")] THEN
        W (MP_TAC o PART_MATCH (lhand o rand) VECTOR_VARIATION_CONST_EQ o
          lhand o snd) THEN
        REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN ANTS_TAC THENL
         [ALL_TAC,
          DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← MESON []
           (← q r"P x /\ P y ==> (?c. !x. P x ==> f x = c) ==> f x = f y")) THEN
          ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LT_IMP_LE, REAL_LE_REFL]]] THEN
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
      EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
      ASM_SIMP_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      X_GEN_TAC (← q r"g:real^1->real^N") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"\x:real^1. x"]
          CONTINUOUS_ON_COMPARISON) THEN
      ASM_REWRITE_TAC [CONTINUOUS_ON_ID],
      X_GEN_TAC (← q r"g:real^1->real^N") THEN DISCH_THEN (ASSUME_TAC o GSYM) THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, FORALL_IN_GSPEC] THEN
      ASM_SIMP_TAC [] THEN REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
      REWRITE_TAC [DIST_LIFT, FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LE THEN
      CONJ_TAC THENL
       [REWRITE_TAC [DIST_SYM, CONJ_ACI, REAL_ABS_SUB], ALL_TAC] THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP, IN_INTERVAL_1] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"y:real^1",
                        ← q r"x:real^1"]
         VECTOR_VARIATION_COMBINE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC (← REAL_ARITH
          (← q r"a <= d ==> a <= abs(x - (x + d))")) THEN REWRITE_TAC [dist] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
        ASM_REWRITE_TAC [SEGMENT_1, SUBSET_REFL]] THEN
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
      EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
      ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL]])

  let FACTOR_CONTINUOUS_THROUGH_VARIATION ← prove
   r"!f:real^1->real^N a b l.
        drop a <= drop b /\
        f continuous_on interval[a,b] /\
        f has_bounded_variation_on interval[a,b] /\
        vector_variation(interval[a,b]) f = drop l
        ==> ?g. (!x. x IN interval[a,b]
                     ==> f(x) = g(lift(vector_variation(interval[a,x]) f))) /\
                g continuous_on interval[vec 0,l] /\
                (!u v. u IN interval[vec 0,l] /\ v IN interval[vec 0,l]
                       ==> dist(g u,g v) <= dist(u,v)) /\
                g has_bounded_variation_on interval[vec 0,l] /\
                IMAGE (\x. lift(vector_variation(interval[a,x]) f))
                      (interval[a,b]) = interval[vec 0,l] /\
                IMAGE g (interval[vec 0,l]) = IMAGE f (interval[a,b]) /\
                (!x. x IN interval[vec 0,l]
                     ==> vector_variation (interval[vec 0,x]) g = drop x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP FACTOR_THROUGH_VARIATION) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"IMAGE (\x. f x) s = {f x | x IN s}")] THEN
    SUBGOAL_THEN
     (← q r"{ lift(vector_variation (interval[a,u]) (f:real^1->real^N)) | u |
      u IN interval [a,b]} = interval[vec 0,l]")
     (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN ASM_REWRITE_TAC [th] THEN
                ASSUME_TAC th)
    THENL
     [REWRITE_TAC [SIMPLE_IMAGE] THEN
      W (MP_TAC o PART_MATCH (lhs o rand)
        CONTINUOUS_INCREASING_IMAGE_INTERVAL_1 o lhand o snd) THEN
      ASM_REWRITE_TAC [INTERVAL_NE_EMPTY_1, LIFT_DROP] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [CONTINUOUS_ON_VECTOR_VARIATION] THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL],
        DISCH_THEN SUBST1_TAC THEN
        AP_TERM_TAC THEN REPEAT (AP_THM_TAC THEN AP_TERM_TAC) THEN
        REWRITE_TAC [← GSYM LIFT_NUM, LIFT_EQ] THEN
        MATCH_MP_TAC VECTOR_VARIATION_ON_NULL THEN
        REWRITE_TAC [BOUNDED_INTERVAL, CONTENT_EQ_0_1, REAL_LE_REFL]],
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [MATCH_MP_TAC LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION THEN
        EXISTS_TAC (← q r"&1") THEN
        ASM_REWRITE_TAC [BOUNDED_INTERVAL, REAL_MUL_LID, ← GSYM dist],
        DISCH_TAC] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← SYM th])) THEN
        REWRITE_TAC [SIMPLE_IMAGE, ← GSYM IMAGE_o, o_DEF] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM, FORALL_AND_THM, ← TAUT
       (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
      CONJ_TAC THENL
       [FIRST_ASSUM (fun th => tactic_of do
         pure (GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o RAND_CONV) [← SYM th])) THEN
        REWRITE_TAC [FORALL_IN_GSPEC, LIFT_DROP] THEN
        X_GEN_TAC (← q r"u:real^1") THEN REWRITE_TAC [IN_INTERVAL_1] THEN STRIP_TAC THEN
        TRANS_TAC REAL_LE_TRANS
          (← q r"vector_variation(interval[a,u])
           ((g:real^1->real^N) o
            (\x. lift(vector_variation(interval[a,x])
                     (f:real^1->real^N))))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC VECTOR_VARIATION_EQ THEN
          X_GEN_TAC (← q r"v:real^1") THEN
          REWRITE_TAC [IN_INTERVAL_1, o_DEF] THEN STRIP_TAC THEN
          CONV_TAC SYM_CONV THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
          W (MP_TAC o PART_MATCH (lhand o rand)
              VECTOR_VARIATION_COMPOSE_INCREASING o lhand o snd) THEN
          SIMP_TAC [VECTOR_VARIATION_ON_NULL, BOUNDED_INTERVAL, LIFT_DROP,
                    CONTENT_EQ_0_1, REAL_LE_REFL, LIFT_NUM] THEN
          DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
           [REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC,
            FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
            ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL, LIFT_DROP] THEN
            DISJ2_TAC THEN REWRITE_TAC [DROP_VEC] THEN CONJ_TAC THENL
             [MATCH_MP_TAC VECTOR_VARIATION_POS_LE THEN
              FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
              ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
              FIRST_X_ASSUM (fun th => tactic_of do
                pure (GEN_REWRITE_TAC RAND_CONV [← SYM th]))]] THEN
          MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN
          (CONJ_TAC THENL
            [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
               HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
             ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
             ASM_REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC])],
        X_GEN_TAC (← q r"u:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
        DISCH_TAC THEN TRANS_TAC REAL_LE_TRANS
         (← q r"vector_variation (interval[vec 0,u]) (\x. x)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC VECTOR_VARIATION_COMPARISON THEN
          SIMP_TAC [HAS_BOUNDED_VARIATION_ON_ID, BOUNDED_INTERVAL] THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN REPEAT STRIP_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN ASM_REAL_ARITH_TAC,
          REWRITE_TAC [VECTOR_VARIATION_ID, INTERVAL_EQ_EMPTY_1] THEN
          ASM_REWRITE_TAC [DROP_VEC, ← GSYM REAL_NOT_LE] THEN
          ASM_REAL_ARITH_TAC]]])

  pure { FACTOR_THROUGH_VARIATION, FACTOR_CONTINUOUS_THROUGH_VARIATION }

/- ------------------------------------------------------------------------- -/
/- The Helly selection theorem (increasing case).                           -/
/- (integration.ml 21662-21862)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBN where
  HELLY_SELECTION_INCREASING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBN [HolBase] (D : IntegrationDeps) (BINBI : INBI) : ExceptT String IO INBN := do
  -- @@SCOPE BEGIN
  let { INCREASING_COUNTABLE_DISCONTINUITIES, .. } := BINBI
  let { AND_FORALL_THM, DE_MORGAN_THM, DIMINDEX_1, EXISTS_IN_GSPEC, FINITE_SUBSET,
        FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ_ALT, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. }
        := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_MIN, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_SUP_LE_SUBSET, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, SUBSET_ANTISYM,
        SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { COUNTABLE_UNION, .. } := D.dv.dg.pt.cvx.lib
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, DIST_1, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_EQ, EXISTS_DROP, FORALL_1, FORALL_DROP, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_TRUE, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.met
  let { CLOSURE_INC, CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { IN_BALL, IN_INTERIOR, LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } := D.dv.dg.pt.cvx.top4
  let { continuous_at, frontier, SUBSET_CLOSURE, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { FINITE_IMP_COUNTABLE, .. } := D.dv.dg.pt.qcard
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { COUNTABLE_INTER, .. } := D.dv.dg.qcard
  let { EVENTUALLY_AND, .. } := D.dv.dg.qmetric
  let { COUNTABLE_RATIONAL_COORDINATES, .. } := D.dv.dg.qmisc
  let { tendsto, .. } := D.dv.dg.qtopology2
  let { ALWAYS_EVENTUALLY, SEQUENTIALLY, .. } := D.dv.qmetric
  let { LIM_DROP_LE, LIM_NORM_UBOUND, .. } := D.dv.qtopology2
  let { CLOSURE_RATIONALS_IN_CONVEX_SET, .. } := D.qconvex
  let { RATIONAL_APPROXIMATION_BELOW, RATIONAL_APPROXIMATION_STRADDLE, .. } := D.qfloor
  let { REAL_SUP_UNIQUE, .. } := D.qsession
  let { CARD_FRONTIER_INTERVAL_1, FUNCTION_CONVERGENT_SUBSEQUENCE, LIM_DROP_UBOUND, .. } :=
        D.qtopology
  -- @@SCOPE END

  let HELLY_SELECTION_INCREASING ← prove
   r"!f:num->real^1->real^1 s k.
      is_interval s /\
      (!n x. x IN s ==> norm(f n x) <= k) /\
      (!n x y. x IN s /\ y IN s /\ drop x <= drop y
               ==> drop(f n x) <= drop(f n y))
      ==> ?r g. (!m n. m < n ==> r m < r n) /\
                (!x. x IN s ==> ((\n. f (r n) x) --> g x) sequentially) /\
                (!x. x IN s ==> norm(g x) <= k) /\
                (!x y. x IN s /\ y IN s /\ drop x <= drop y
                       ==> drop(g x) <= drop(g y))"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC
     (← q r"t = (s DIFF interior s) UNION
        s INTER {x:real^1 | !i. 1 <= i /\ i <= dimindex(:1)
                                ==> rational(x$i)}") THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE t /\ t SUBSET s /\ closure t = closure s /\
    !x. x IN s ==> ?a. a IN t /\ drop a <= drop x")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN
      REPEAT CONJ_TAC THENL
       [SIMP_TAC [COUNTABLE_UNION, COUNTABLE_INTER,
                  COUNTABLE_RATIONAL_COORDINATES] THEN
        MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"frontier s:real^1->bool") THEN
        ASM_SIMP_TAC [CARD_FRONTIER_INTERVAL_1] THEN
        REWRITE_TAC [frontier] THEN
        MP_TAC (← ISPEC (← q r"s:real^1->bool") CLOSURE_SUBSET) THEN SET_TAC [],
        SET_TAC [],
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [MATCH_MP_TAC SUBSET_CLOSURE THEN SET_TAC [], ALL_TAC] THEN
        ASM_CASES_TAC (← q r"interior s:real^1->bool = {}") THENL
         [REWRITE_TAC [← ASSUME (← q r"interior s:real^1->bool = {}")] THEN
          REWRITE_TAC [SUBSET_REFL, ← SET_RULE
           (← q r"(s DIFF {}) UNION s INTER t = s")],
          ALL_TAC] THEN
        MP_TAC (← ISPEC (← q r"s:real^1->bool") CLOSURE_RATIONALS_IN_CONVEX_SET) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [IS_INTERVAL_CONVEX_1], ALL_TAC] THEN
        DISCH_THEN (SUBST1_TAC o SYM) THEN MATCH_MP_TAC SUBSET_CLOSURE THEN
        SET_TAC [],
        X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
        REWRITE_TAC [DIMINDEX_1, FORALL_1] THEN
        REWRITE_TAC [IN_DIFF, IN_UNION, IN_INTER, IN_ELIM_THM] THEN
        ASM_CASES_TAC (← q r"(x:real^1) IN interior s") THENL
         [ALL_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERIOR]) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPECL [← q r"drop x", ← q r"e:real"] RATIONAL_APPROXIMATION_BELOW) THEN
        ASM_REWRITE_TAC [EXISTS_DROP, ← GSYM drop] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real^1") THEN
        STRIP_TAC THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN DISJ2_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
        REWRITE_TAC [IN_BALL, DIST_1] THEN ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:num->real^1->real^1", ← q r"t:real^1->bool", ← q r"k:real"]
          FUNCTION_CONVERGENT_SUBSEQUENCE) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC []] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [DIMINDEX_1, FORALL_1, ← GSYM drop]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num")
      (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real^1->real^1") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN t /\ y IN t /\ drop x <= drop y
          ==> drop((h:real^1->real^1) x) <= drop(h y)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LE) THEN
      EXISTS_TAC (← q r"\n:num. (f:num->real^1->real^1) (r n) x") THEN
      EXISTS_TAC (← q r"\n:num. (f:num->real^1->real^1) (r n) y") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, SEQUENTIALLY] THEN
      REWRITE_TAC [EVENTUALLY_TRUE],
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"g = \x. lift(sup {drop(h a) | a IN t /\ drop a <= drop x})") THEN
     SUBGOAL_THEN
     (← q r"!x y. x IN s /\ y IN s /\ drop x <= drop y
          ==> drop((g:real^1->real^1) x) <= drop(g y)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN REWRITE_TAC [LIFT_DROP] THEN
      MATCH_MP_TAC REAL_SUP_LE_SUBSET THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SUBSET, IN_ELIM_THM]] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [REAL_LE_TRANS], ALL_TAC] THEN
      EXISTS_TAC (← q r"k:real") THEN X_GEN_TAC (← q r"a:real^1") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_UBOUND) THEN
      EXISTS_TAC (← q r"\n:num. (f:num->real^1->real^1) (r n) a") THEN
      ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [] THEN GEN_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
        (← q r"abs(drop x) <= norm x /\ norm x <= k ==> drop x <= k")) THEN
      REWRITE_TAC [drop, COMPONENT_LE_NORM] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!x. x IN t ==> (h:real^1->real^1) x = g x") ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN
      REWRITE_TAC [← GSYM DROP_EQ, LIFT_DROP] THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC REAL_SUP_UNIQUE THEN
      REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
      ASM_MESON_TAC [REAL_LE_REFL],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"d = {x | x IN s /\ ~((g:real^1->real^1) continuous at x)}") THEN
    SUBGOAL_THEN (← q r"COUNTABLE(d:real^1->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN MATCH_MP_TAC INCREASING_COUNTABLE_DISCONTINUITIES THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s DIFF (d UNION frontier s)
        ==> ((\n. (f:num->real^1->real^1) (r n) x) --> g x) sequentially")
    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      EXPAND_TAC "d" THEN REWRITE_TAC [IN_ELIM_THM, IN_UNION, DE_MORGAN_THM] THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [continuous_at, LIM_SEQUENTIALLY] THEN
      ASM_SIMP_TAC [frontier, IN_DIFF, CLOSURE_INC] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERIOR]) THEN
      REWRITE_TAC [SUBSET, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d2:real") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"drop x", ← q r"min d1 d2:real"]
       RATIONAL_APPROXIMATION_STRADDLE) THEN
      ASM_REWRITE_TAC [REAL_LT_MIN, LEFT_IMP_EXISTS_THM, FORALL_DROP] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(a:real^1) IN t /\ b IN t") STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "t" THEN REWRITE_TAC [IN_INTER, IN_UNION, IN_ELIM_THM] THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THEN DISJ2_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_BALL, DIST_1]  THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"((\n:num. (f:num->real^1->real^1) (r n) a) --> g a) sequentially /\
      ((\n:num. (f:num->real^1->real^1) (r n) b) --> g b) sequentially")
      MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [tendsto, AND_FORALL_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, ← GSYM EVENTUALLY_AND] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      SUBGOAL_THEN
        (← q r"dist((g:real^1->real^1) a,g x) < e / &2 /\
       dist((g:real^1->real^1) b,g x) < e / &2")
      MP_TAC THENL
       [CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [DIST_1] THEN
        ASM_REAL_ARITH_TAC,
        ASM_REWRITE_TAC [DIST_1]] THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← ISPECL [← q r"(r:num->num) n", ← q r"a:real^1", ← q r"x:real^1"] th) THEN
              MP_TAC (← ISPECL [← q r"(r:num->num) n", ← q r"x:real^1", ← q r"b:real^1"] th))) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\n:num x. (f:num->real^1->real^1) (r n) x",
      ← q r"s INTER (d UNION frontier s):real^1->bool", ← q r"k:real"]
          FUNCTION_CONVERGENT_SUBSEQUENCE) THEN
    ASM_SIMP_TAC [IN_INTER] THEN ANTS_TAC THENL
     [MATCH_MP_TAC COUNTABLE_INTER THEN DISJ2_TAC THEN
      ASM_REWRITE_TAC [COUNTABLE_UNION] THEN
      ASM_SIMP_TAC [FINITE_IMP_COUNTABLE, CARD_FRONTIER_INTERVAL_1],
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:num->num") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
    ASM_SIMP_TAC [o_THM] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s
        ==> ?l. ((\n. (f:num->real^1->real^1) (r((q:num->num) n)) x) --> l)
                sequentially")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(x:real^1) IN d UNION frontier s") THEN ASM_SIMP_TAC [] THEN
      SUBGOAL_THEN
       (← q r"?l. ((\n. (f:num->real^1->real^1) (r n) x) --> l) sequentially")
      MP_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"l:real^1") THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"q:num->num") o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LIM_SUBSEQUENCE)) THEN
      ASM_REWRITE_TAC [o_DEF],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"ff:real^1->real^1") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:real^1") THENL
     [DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_NORM_UBOUND) THEN
      EXISTS_TAC
       (← q r"\n. (f:num->real^1->real^1) (r((q:num->num) n)) x"),
      X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_LE) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\n. (f:num->real^1->real^1) (r((q:num->num) n)) x",
        ← q r"\n. (f:num->real^1->real^1) (r((q:num->num) n)) y"]] THEN
    ASM_SIMP_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_TRUE])

  pure { HELLY_SELECTION_INCREASING }

/- ------------------------------------------------------------------------- -/
/- The Helly selection theorem.  (integration.ml 21863-22013)               -/
/- ------------------------------------------------------------------------- -/

structure INBO where
  HELLY_SELECTION_THEOREM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBO [HolBase] (D : IntegrationDeps) (BINAV : INAV) (BINAW : INAW) (BINAZ : INAZ) (BINBF : INBF) (BINBN : INBN) : ExceptT String IO INBO := do
  -- @@SCOPE BEGIN
  let { HAS_BOUNDED_VARIATION_ON_COMPONENTWISE, VECTOR_VARIATION_COMPONENT_LE, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_MONOTONE, VECTOR_VARIATION_POS_LE,
        .. } := BINAW
  let { VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT, .. } := BINAZ
  let { HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM, .. } := BINBF
  let { HELLY_SELECTION_INCREASING, .. } := BINBN
  let { ETA_AX, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, LAMBDA_BETA, LE, LEFT_IMP_EXISTS_THM, MONO_FORALL, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, SUBSET_RESTRICT, .. } :=
        D.dv.dg.pt.cvx.core5
  let { num_INDUCTION, o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_SUB, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { LIM_SUB, LIM_SUBSEQUENCE, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, NORM_ARITH, REAL_ARITH,
        VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { LIM_COMPONENTWISE_LIFT, .. } := D.dv.qtopology2
  -- @@SCOPE END

  let HELLY_SELECTION_THEOREM ← (do
    let lemma ← prove
     r"!f:num->real^1->real^1 s c d.
          is_interval s /\
          (!n. f n has_bounded_variation_on s) /\
          (!n. vector_variation s (f n) <= c) /\
          (!n x. x IN s ==> norm(f n x) <= d)
          ==> ?r g. (!m n. m < n ==> r m < r n) /\
                    (!x. x IN s ==> ((\n. f (r n) x) --> g x) sequentially)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!n. ?g h. (!x y. x IN s /\ y IN s /\ drop x <= drop y
                       ==> drop(g x) <= drop(g y)) /\
                (!x y. x IN s /\ y IN s /\ drop x <= drop y
                       ==> drop(h x) <= drop(h y)) /\
                (!x. x IN s ==> norm(g x) <= c) /\
                (!x. x IN s ==> norm(h x) <= c + d) /\
                (!x. (f:num->real^1->real^1) n x = g x - h x)")
      MP_TAC THENL
       [GEN_TAC THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\x. lift(vector_variation {a | a IN s /\ drop a <= drop x}
                                   ((f:num->real^1->real^1) n))",
          ← q r"\x. lift(vector_variation {a | a IN s /\ drop a <= drop x} (f n)) -
             f (n:num) x"] THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"a - (a - x):real^1 = x")] THEN
        REWRITE_TAC [LIFT_DROP, DROP_SUB] THEN MATCH_MP_TAC (← TAUT
         (← q r"p /\ q /\ r /\ (r ==> s) ==> p /\ q /\ r /\ s")) THEN
        REPEAT CONJ_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
          MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN CONJ_TAC THENL
           [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              HAS_BOUNDED_VARIATION_ON_SUBSET) o SPEC (← q r"n:num")) THEN
            REWRITE_TAC [SUBSET_RESTRICT],
            REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [REAL_LE_TRANS]],
          MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
          MATCH_MP_TAC VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT THEN
          ASM_REWRITE_TAC [],
          X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN TRANS_TAC REAL_LE_TRANS
           (← q r"vector_variation s ((f:num->real^1->real^1) n)") THEN
          ASM_REWRITE_TAC [NORM_LIFT] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= y ==> abs x <= y")) THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC VECTOR_VARIATION_POS_LE,
            MATCH_MP_TAC VECTOR_VARIATION_MONOTONE] THEN
          ASM_REWRITE_TAC [SUBSET_RESTRICT] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              HAS_BOUNDED_VARIATION_ON_SUBSET) o SPEC (← q r"n:num")) THEN
          REWRITE_TAC [SUBSET_RESTRICT],
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^1") THEN
          DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
           (← q r"norm(f:real^N) <= d ==> norm(v) <= c ==> norm(v - f) <= c + d")) THEN
          ASM_SIMP_TAC []],
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:num->real^1->real^1", ← q r"h:num->real^1->real^1"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"g:num->real^1->real^1", ← q r"s:real^1->bool", ← q r"c:real"]
        HELLY_SELECTION_INCREASING) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"r:num->num", ← q r"gg:real^1->real^1"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"\n:num x. (h:num->real^1->real^1) (r n) x",
                        ← q r"s:real^1->bool", ← q r"c + d:real"]
        HELLY_SELECTION_INCREASING) THEN
      ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"q:num->num", ← q r"hh:real^1->real^1"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
      EXISTS_TAC (← q r"\x. (gg:real^1->real^1) x - (hh:real^1->real^1) x") THEN
      ASM_SIMP_TAC [o_THM] THEN X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      MATCH_MP_TAC LIM_SUB THEN ASM_SIMP_TAC [] THEN
      SUBGOAL_THEN
        (← q r"((\n:num. (g:num->real^1->real^1) (r n) x) --> gg x) sequentially")
      MP_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"q:num->num") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LIM_SUBSEQUENCE)) THEN
      ASM_REWRITE_TAC [o_DEF])
    prove
     r"!f:num->real^1->real^N s c d.
        is_interval s /\
        (!n. f n has_bounded_variation_on s) /\
        (!n. vector_variation s (f n) <= c) /\
        (!n x. x IN s ==> norm(f n x) <= d)
        ==> ?r g. (!m n. m < n ==> r m < r n) /\
                  (!x. x IN s ==> ((\n. f (r n) x) --> g x) sequentially) /\
                  g has_bounded_variation_on s /\
                  vector_variation s g <= c"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(!r g. P r g /\ Q r g ==> R r g /\ S r g) /\ (?r g. P r g /\ Q r g)
    ==> ?r g. P r g /\ Q r g /\ R r g /\ S r g")) THEN
      CONJ_TAC THENL
       [REPEAT GEN_TAC THEN STRIP_TAC THEN
        MATCH_MP_TAC HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM THEN
        EXISTS_TAC (← q r"\n:num. (f:num->real^1->real^N) (r n)") THEN
        ASM_SIMP_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!n. ?r g:real^1->real^N.
     (!m n:num. m < n ==> r m < r n) /\
     (!x i. x IN s /\ 1 <= i /\ i <= n /\ i <= dimindex(:N)
            ==> ((\n. lift((f:num->real^1->real^N) (r n) x$i))
                 --> lift(g x$i)) sequentially)")
      MP_TAC THENL
       [ALL_TAC,
        DISCH_THEN (MP_TAC o SPEC (← q r"dimindex(:N)")) THEN REWRITE_TAC [] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
        REWRITE_TAC [IMP_IMP, ← GSYM LIM_COMPONENTWISE_LIFT]] THEN
      MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL
       [REWRITE_TAC [← ARITH_RULE (← q r"1 <= i /\ i <= 0 /\ i <= n <=> F")] THEN
        EXISTS_TAC (← q r"\n:num. n") THEN REWRITE_TAC [],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:num", ← q r"r:num->num", ← q r"g:real^1->real^N"] THEN
      STRIP_TAC THEN ASM_CASES_TAC (← q r"dimindex(:N) <= k") THENL
       [MAP_EVERY EXISTS_TAC [← q r"r:num->num", ← q r"g:real^1->real^N"] THEN
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
        FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← ARITH_RULE
         (← q r"~(n <= k) ==> SUC k <= n")))] THEN
      MP_TAC (← SPECL
       [← q r"\n:num x. lift((f:num->real^1->real^N) (r n) x$(SUC k))",
        ← q r"s:real^1->bool", ← q r"c:real", ← q r"d:real"]
       lemma) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [REPEAT CONJ_TAC THEN X_GEN_TAC (← q r"n:num") THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I
           [HAS_BOUNDED_VARIATION_ON_COMPONENTWISE] o SPEC (← q r"(r:num->num) n")) THEN
          DISCH_THEN MATCH_MP_TAC THEN ASM_ARITH_TAC,
          W (MP_TAC o PART_MATCH (lhand o rand)
            VECTOR_VARIATION_COMPONENT_LE o lhand o snd) THEN
          ASM_REWRITE_TAC [ETA_AX],
          REPEAT STRIP_TAC THEN REWRITE_TAC [NORM_LIFT] THEN
          W (MP_TAC o PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd)] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        ASM_SIMP_TAC [],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"q:num->num", ← q r"h:real^1->real^1"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"(r:num->num) o (q:num->num)") THEN
      EXISTS_TAC (← q r"(\x. lambda i. if i <= k then (g:real^1->real^N) x$i
                             else drop(h x)):real^1->real^N") THEN
      ASM_SIMP_TAC [o_THM, LAMBDA_BETA] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"i:num"] THEN
      REWRITE_TAC [LE] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(SUC k <= k)"), LIFT_DROP] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"i:num"]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"q:num->num") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LIM_SUBSEQUENCE)) THEN
      ASM_REWRITE_TAC [o_DEF]))

  pure { HELLY_SELECTION_THEOREM }

/- ------------------------------------------------------------------------- -/
/- Differentiability properties of convex functions.                        -/
/- (integration.ml 22014-22315)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBP where
  CONVEX_ON_RIGHT_DIFFERENTIABLE : thm
  CONVEX_ON_LEFT_DIFFERENTIABLE : thm
  CONVEX_ON_DIRECTIONAL_DERIVATIVES : thm
  CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS : thm
  CONVEX_ON_COUNTABLE_NONDIFFERENTIABLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBP [HolBase] (D : IntegrationDeps) (BINBF : INBF) : ExceptT String IO INBP := do
  -- @@SCOPE BEGIN
  let { INCREASING_LEFT_LIMIT_1_GEN, INCREASING_RIGHT_LIMIT_1_GEN, .. } := BINBF
  let { CONTRAPOS_THM, DISJOINT, EQ_IMP, ETA_AX, FORALL_AND_THM, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_INV_NEG, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_LE,
        REAL_LT_REFL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_NEG_SUB, REAL_NOT_LT, REAL_SUB_LE, REAL_SUB_LT,
        RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, .. }
        := D.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, real_abs, real_div, UNIONS_GSPEC, .. } := D.dv.dg.pt.cvx.core6
  let { COUNTABLE_IMAGE, COUNTABLE_UNION, .. } := D.dv.dg.pt.cvx.lib
  let { DIST_1, DIST_NZ, DIST_REFL, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, FORALL_DROP, FORALL_LIFT, LIFT_DROP, NORM_1,
        .. } := D.dv.dg.pt.cvx.vec2
  let { dist, drop, .. } := D.dv.dg.pt.cvx.vec4
  let { CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { EVENTUALLY_AT, EVENTUALLY_WITHIN, .. } := D.dv.dg.pt.cvx.top3
  let { IN_CBALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, IN_INTERIOR_CBALL,
        IN_INTERVAL_1, INTERIOR_OPEN, INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1,
        IS_INTERVAL_INTERVAL, LIMPT_APPROACHABLE, .. } := D.dv.dg.pt.cvx.top4
  let { frontier, OPEN_INTERIOR, OPEN_INTERVAL, SEGMENT_1, TRIVIAL_LIMIT_WITHIN,
        UNIONS_COMPONENTS, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { FINITE_IMP_COUNTABLE, .. } := D.dv.dg.pt.qcard
  let { CONVEX_INTERIOR, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { IS_INTERVAL_CONNECTED_1, .. } := D.dv.dg.qconvex
  let { DISJOINT_INTERVAL_1, .. } := D.dv.dg.qtopology1
  let { CONVEX_ON_LEFT_SECANT, .. } := D.dv.qconvex
  let { LIM_DROP_LBOUND, .. } := D.dv.qtopology2
  let { CONVEX_ON_MID_SECANT, CONVEX_ON_RIGHT_SECANT, CONVEX_ON_SUBSET, .. } := D.qconvex
  let { HAS_VECTOR_DERIVATIVE_AT_1D, HAS_VECTOR_DERIVATIVE_WITHIN_1D, VECTOR_DIFFERENTIABLE,
