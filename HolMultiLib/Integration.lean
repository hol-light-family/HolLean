       ALL_TAC]) THEN
    DISCH_THEN SUBST1_TAC THEN
    ONCE_REWRITE_TAC [← GSYM PRODUCT_CONST_NUMSEG_1] THEN
    ASM_SIMP_TAC [CONTENT_CLOSED_INTERVAL, ← GSYM PRODUCT_MUL_NUMSEG] THEN
    MATCH_MP_TAC PRODUCT_EQ THEN
    SIMP_TAC [IN_NUMSEG, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT] THEN
    ASM_REAL_ARITH_TAC)

  let HAS_INTEGRAL_AFFINITY ← prove
   r"!f:real^M->real^N i s m c.
        (f has_integral i) s /\ ~(m = &0)
        ==> ((\x. f(m % x + c)) has_integral
             (inv(abs(m) pow dimindex(:M)) % i))
            (IMAGE (\x. inv m % x + --(inv(m) % c)) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_TWIDDLE_GEN THEN
    ASM_SIMP_TAC [INTERVAL_IMAGE_AFFINITY_INTERVAL, ← GSYM REAL_ABS_NZ,
          REAL_POW_LT, PRODUCT_EQ_0_NUMSEG, CONTENT_IMAGE_AFFINITY_INTERVAL] THEN
    ASM_SIMP_TAC [CONTINUOUS_CMUL, CONTINUOUS_AT_ID, CONTINUOUS_CONST,
                  CONTINUOUS_ADD] THEN
    REWRITE_TAC [VECTOR_ADD_LDISTRIB, VECTOR_MUL_ASSOC, VECTOR_MUL_RNEG] THEN
    ASM_SIMP_TAC [REAL_MUL_LINV, REAL_MUL_RINV] THEN
    REPEAT (CONJ_TAC THENL [VECTOR_ARITH_TAC, ALL_TAC]) THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(b + norm(c:real^M)) / abs m") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LT_DIV THEN ASM_REWRITE_TAC [← GSYM REAL_ABS_NZ] THEN
      MATCH_MP_TAC REAL_LTE_ADD THEN ASM_REWRITE_TAC [NORM_POS_LE],
      REWRITE_TAC [SUBSET, IN_IMAGE, IN_BALL_0] THEN
      X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"inv(m) % (x - c):real^M") THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, NORM_MUL, REAL_ABS_INV] THEN
      CONJ_TAC THENL [CONV_TAC (fun t => VECTOR_ARITH t), ALL_TAC] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      ASM_SIMP_TAC [REAL_LT_DIV2_EQ, ← GSYM REAL_ABS_NZ] THEN
      UNDISCH_TAC (← q r"norm(x:real^M) < b") THEN CONV_TAC (fun t => NORM_ARITH t)])

  let INTEGRABLE_AFFINITY ← prove
   r"!f:real^M->real^N s m c.
        f integrable_on s /\ ~(m = &0)
        ==> (\x. f(m % x + c)) integrable_on
            (IMAGE (\x. inv m % x + --(inv(m) % c)) s)"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_AFFINITY])

  let CONTENT_IMAGE_STRETCH_INTERVAL ← prove
   r"!a b:real^N m.
        content(IMAGE (\x. lambda k. m k * x$k) (interval[a,b]):real^N->bool) =
        abs(product(1..dimindex(:N)) m) * content(interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [content, IMAGE_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_MUL_RZERO] THEN
    ASM_REWRITE_TAC [IMAGE_STRETCH_INTERVAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY]) THEN
    ASM_SIMP_TAC [INTERVAL_UPPERBOUND, INTERVAL_LOWERBOUND, LAMBDA_BETA,
                  ← REAL_ARITH (← q r"min a b <= max a b")] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"max a b - min a b = abs(b - a)"),
                     ← GSYM REAL_SUB_LDISTRIB, REAL_ABS_MUL] THEN
    ASM_SIMP_TAC [PRODUCT_MUL, FINITE_NUMSEG,
                  ← REAL_ARITH (← q r"a <= b ==> abs(b - a) = b - a")] THEN
    ASM_SIMP_TAC [PRODUCT_ABS, FINITE_NUMSEG])

  let HAS_INTEGRAL_STRETCH ← prove
   r"!f:real^M->real^N i m a b.
        (f has_integral i) (interval[a,b]) /\
        (!k. 1 <= k /\ k <= dimindex(:M) ==>  ~(m k = &0))
        ==> ((\x:real^M. f(lambda k. m k * x$k)) has_integral
             (inv(abs(product(1..dimindex(:M)) m)) % i))
            (IMAGE (\x. lambda k. inv(m k) * x$k) (interval[a,b]))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_TWIDDLE THEN
    SIMP_TAC [CART_EQ, LAMBDA_BETA] THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_RINV, REAL_MUL_LID] THEN
    ASM_REWRITE_TAC [← GSYM REAL_ABS_NZ, PRODUCT_EQ_0_NUMSEG] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [GEN_TAC THEN MATCH_MP_TAC LINEAR_CONTINUOUS_AT THEN
      SIMP_TAC [linear, LAMBDA_BETA, CART_EQ, VECTOR_ADD_COMPONENT,
                VECTOR_MUL_COMPONENT] THEN REAL_ARITH_TAC,
      REWRITE_TAC [CONTENT_IMAGE_STRETCH_INTERVAL] THEN
      REWRITE_TAC [IMAGE_STRETCH_INTERVAL] THEN MESON_TAC [EMPTY_AS_INTERVAL]])

  let INTEGRABLE_STRETCH ← prove
   r"!f:real^M->real^N m a b.
        f integrable_on interval[a,b] /\
        (!k. 1 <= k /\ k <= dimindex(:M) ==>  ~(m k = &0))
        ==> (\x:real^M. f(lambda k. m k * x$k)) integrable_on
            (IMAGE (\x. lambda k. inv(m k) * x$k) (interval[a,b]))"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_STRETCH])

  let HAS_INTEGRAL_REFLECT_LEMMA ← (do
    let ra ← REAL_ARITH (← q r"~(-- &1 = &0)")
    prove
     r"!f:real^M->real^N i a b.
     (f has_integral i) (interval[a,b])
     ==> ((\x. f(--x)) has_integral i) (interval[--b,--a])"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o (fun th => CONJ th ra)) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^M")) THEN
      REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [REAL_ABS_NEG, REAL_ABS_NUM, REAL_POW_ONE] THEN
      REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_NEG_0] THEN
      REWRITE_TAC [REAL_INV_NEG, REAL_INV_1] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"-- &1 % x + vec 0 = --x")] THEN
      REWRITE_TAC [VECTOR_MUL_LID] THEN MATCH_MP_TAC EQ_IMP THEN
      AP_TERM_TAC THEN POP_ASSUM (K ALL_TAC) THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN CONV_TAC SYM_CONV THEN
      POP_ASSUM MP_TAC THEN REWRITE_TAC [INTERVAL_EQ_EMPTY] THEN
      REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> ~(a /\ b ==> ~c)")] THEN
      SIMP_TAC [VECTOR_NEG_COMPONENT, REAL_LT_NEG2]))

  let HAS_INTEGRAL_REFLECT ← prove
   r"!f:real^M->real^N i a b.
     ((\x. f(--x)) has_integral i) (interval[--b,--a]) <=>
     (f has_integral i) (interval[a,b])"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_REFLECT_LEMMA) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX])

  let INTEGRABLE_REFLECT ← prove
   r"!f:real^M->real^N a b.
     (\x. f(--x)) integrable_on (interval[--b,--a]) <=>
     f integrable_on (interval[a,b])"
   (REWRITE_TAC [integrable_on, HAS_INTEGRAL_REFLECT])

  let INTEGRAL_REFLECT ← prove
   r"!f:real^M->real^N a b.
     integral (interval[--b,--a]) (\x. f(--x)) =
     integral (interval[a,b]) f"
   (REWRITE_TAC [integral, HAS_INTEGRAL_REFLECT])

  let HAS_INTEGRAL_TRANSLATION ← prove
   r"!f:real^M->real^N i s a.
        ((\x. f(a + x)) has_integral i) s <=>
        (f has_integral i) (IMAGE (\x. a + x) s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&1") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_INTEGRAL_AFFINITY))
    THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"--a:real^M")),
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^M"))] THEN
    REWRITE_TAC [REAL_INV_1, REAL_ABS_NUM, REAL_POW_ONE] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [VECTOR_MUL_LID] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a + x + --a:real^N = x"), ETA_AX, ← GSYM IMAGE_o,
                 ← VECTOR_ARITH (← q r"x + -- -- a:real^N = a + x"), o_DEF, IMAGE_ID,
                 ← VECTOR_ARITH (← q r"(a + x) + --a:real^N = x")] THEN
    REWRITE_TAC [VECTOR_ADD_SYM])

  let INTEGRAL_TRANSLATION ← prove
   r"!f:real^M->real^N s a.
       integral s (\x. f (a + x)) = integral (IMAGE (\x. a + x) s) f"
   (REWRITE_TAC [integral, ← GSYM HAS_INTEGRAL_TRANSLATION])

  let INTEGRABLE_TRANSLATION ← prove
   r"!f:real^M->real^N s a.
        (\x. f(a + x)) integrable_on s <=>
        f integrable_on (IMAGE (\x. a + x) s)"
   (REWRITE_TAC [integrable_on, ← GSYM HAS_INTEGRAL_TRANSLATION])

  pure { HAS_INTEGRAL_TWIDDLE, HAS_INTEGRAL_TWIDDLE_GEN, HAS_INTEGRAL_TWIZZLE_INTERVAL,
         HAS_INTEGRAL_TWIZZLE, HAS_INTEGRAL_TWIZZLE_EQ, INTEGRABLE_TWIZZLE_EQ,
         INTEGRAL_TWIZZLE_EQ, HAS_INTEGRAL_PASTECART_SYM_ALT, HAS_INTEGRAL_PASTECART_SYM,
         INTEGRAL_PASTECART_SYM, INTEGRABLE_PASTECART_SYM, INTERVAL_IMAGE_AFFINITY_INTERVAL,
         CONTENT_IMAGE_AFFINITY_INTERVAL, HAS_INTEGRAL_AFFINITY, INTEGRABLE_AFFINITY,
         CONTENT_IMAGE_STRETCH_INTERVAL, HAS_INTEGRAL_STRETCH, INTEGRABLE_STRETCH,
         HAS_INTEGRAL_REFLECT_LEMMA, HAS_INTEGRAL_REFLECT, INTEGRABLE_REFLECT,
         INTEGRAL_REFLECT, HAS_INTEGRAL_TRANSLATION, INTEGRAL_TRANSLATION,
         INTEGRABLE_TRANSLATION }

/- ------------------------------------------------------------------------- -/
/- How many non-trivial intervals of a division contain a point; more       -/
/- lemmas useful later.  (integration.ml 6171-6362)                          -/
/- ------------------------------------------------------------------------- -/

structure INP where
  DIVISION_COMMON_POINT_BOUND : thm
  TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND : thm
  TAGGED_PARTIAL_DIVISION_COMMON_TAGS : thm
  HAS_INTEGRAL_DROP_POS_AE : thm
  INTEGRAL_DROP_POS_AE : thm
  HAS_INTEGRAL_SUBSET_COMPONENT_LE : thm
  INTEGRAL_SUBSET_COMPONENT_LE : thm
  HAS_INTEGRAL_SUBSET_DROP_LE : thm
  INTEGRAL_SUBSET_DROP_LE : thm
  INTEGRAL_SUBSET_DROP_LE_AE : thm
  deriving Inhabited

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 4096 in
@[nospecialize]
def setupINP [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINI : INI) (BINK : INK) (BINN : INN) : ExceptT String IO INP := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_INTERIOR, .. } := BINA
  let { division_of, .. } := BINB
  let { INTEGRABLE_INTEGRAL, PARTIAL_DIVISION_OF_TAGGED_DIVISION,
        tagged_partial_division_of, .. } := BINC
  let { HAS_INTEGRAL_COMPONENT_LE, HAS_INTEGRAL_DROP_POS, .. } := BINI
  let { NEGLIGIBLE_SUBSET, .. } := BINK
  let { HAS_INTEGRAL_RESTRICT_UNIV, HAS_INTEGRAL_SPIKE_SET, INTEGRABLE_SPIKE_SET,
        INTEGRAL_SPIKE_SET, .. } := BINN
  let { CARD_IMAGE_INJ, CARD_SUBSET, CART_EQ, DIMINDEX_1, EQ_IMP, EXISTS_PAIR_THM,
        FINITE_IMAGE, FINITE_RESTRICT, FINITE_SUBSET, FORALL_IN_GSPEC, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, IN_ELIM_PAIR_THM, INTER_ACI, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, LAMBDA_BETA, LE_REFL, LE_TRANS, LEFT_IMP_EXISTS_THM, PAIR_EQ,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, .. } := D.dv.dg.pt.cvx.core4
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } :=
        D.dv.dg.pt.cvx.core5
  let { SUBSET_UNIV, .. } := D.dv.dg.pt.cvx.core6
  let { IN_INTERVAL, INTERVAL_NE_EMPTY, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VEC_COMPONENT, .. } := D.dv.dg.pt.cvx.vec4
  let { INTERIOR_CLOSED_INTERVAL, INTERIOR_INTER, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { CARD_BOOL, CARD_CART_UNIV, FINITE_BOOL, FINITE_CART_UNIV, .. } := D.qsession
  let { INTER_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let DIVISION_COMMON_POINT_BOUND ← (do
    let lemma ← prove
     r"!f s. (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
           FINITE s /\ CARD(IMAGE f s) <= n
           ==> CARD(s) <= n"
     (MESON_TAC [CARD_IMAGE_INJ])
    prove
     r"!d s:real^N->bool x.
        d division_of s
        ==> CARD {k | k IN d /\ ~(content k = &0) /\ x IN k}
            <= 2 EXP (dimindex(:N))"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!k. k IN d ==> ?a b:real^N. interval[a,b] = k") MP_TAC THENL
       [ASM_MESON_TAC [division_of], ALL_TAC] THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"A:(real^N->bool)->real^N", ← q r"B:(real^N->bool)->real^N"] THEN
      STRIP_TAC THEN MATCH_MP_TAC (← ISPEC
       (← q r"\d. (lambda i. (x:real^N)$i = (A:(real^N->bool)->real^N)(d)$i):bool^N")
       lemma) THEN
      REPEAT CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC FINITE_RESTRICT THEN ASM_MESON_TAC [division_of],
        MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC (← q r"CARD(:bool^N)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC CARD_SUBSET THEN REWRITE_TAC [SUBSET_UNIV] THEN
          SIMP_TAC [FINITE_CART_UNIV, FINITE_BOOL],
          SIMP_TAC [FINITE_BOOL, CARD_CART_UNIV, CARD_BOOL, LE_REFL]]] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real^N->bool", ← q r"l:real^N->bool"] THEN
      SIMP_TAC [IN_ELIM_THM, CART_EQ, LAMBDA_BETA] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"k:real^N->bool", ← q r"l:real^N->bool"] o
            elc 2) THEN
      ASM_REWRITE_TAC [← GSYM INTERIOR_INTER] THEN
      MATCH_MP_TAC (← TAUT (← q r"~q ==> (~p ==> q) ==> p")) THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"(x:real^N) IN k", ← q r"(x:real^N) IN l",
        ← q r"~(content(k:real^N->bool) = &0)",
        ← q r"~(content(l:real^N->bool) = &0)"] THEN
      SUBGOAL_THEN
       (← q r"k = interval[A k:real^N,B k] /\ l = interval[A l,B l]")
       (CONJUNCTS_THEN SUBST1_TAC)
      THENL [ASM_MESON_TAC [], REWRITE_TAC [INTER_INTERVAL]] THEN
      REWRITE_TAC [CONTENT_EQ_0_INTERIOR, INTERIOR_CLOSED_INTERVAL] THEN
      SIMP_TAC [IN_INTERVAL, INTERVAL_NE_EMPTY, LAMBDA_BETA] THEN
      REPEAT DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC))

  let TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND ← (do
    let lemma ← prove
     r"!f s. (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
           FINITE s /\ CARD(IMAGE f s) <= n
           ==> CARD(s) <= n"
     (MESON_TAC [CARD_IMAGE_INJ])
    prove
     r"!p s:real^N->bool y.
        p tagged_partial_division_of s
        ==> CARD {(x,k) | (x,k) IN p /\ y IN k /\ ~(content k = &0)}
            <= 2 EXP (dimindex(:N))"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"SND") lemma) THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [IMP_CONJ, FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM, PAIR_EQ] THEN
        MAP_EVERY X_GEN_TAC [← q r"x1:real^N", ← q r"k1:real^N->bool"] THEN
        REPEAT DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"x2:real^N", ← q r"k2:real^N->bool"] THEN
        REPEAT DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [tagged_partial_division_of]) THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"x1:real^N", ← q r"k1:real^N->bool", ← q r"x2:real^N",
          ← q r"k2:real^N->bool"] o
         CONJUNCT2 o CONJUNCT2) THEN
        ASM_REWRITE_TAC [PAIR_EQ] THEN
        MATCH_MP_TAC (← TAUT (← q r"~q ==> (~p ==> q) ==> p")) THEN
        REWRITE_TAC [INTER_ACI] THEN
        ASM_MESON_TAC [CONTENT_EQ_0_INTERIOR, tagged_partial_division_of],
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"p:real^N#(real^N->bool)->bool") THEN CONJ_TAC THENL
         [ASM_MESON_TAC [tagged_partial_division_of], SET_TAC []],
        FIRST_ASSUM (MP_TAC o MATCH_MP PARTIAL_DIVISION_OF_TAGGED_DIVISION) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"y:real^N") o
          MATCH_MP DIVISION_COMMON_POINT_BOUND) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LE_TRANS) THEN
        MATCH_MP_TAC CARD_SUBSET THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
          REWRITE_TAC [IN_ELIM_THM, IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC [],
          MATCH_MP_TAC FINITE_RESTRICT THEN MATCH_MP_TAC FINITE_IMAGE THEN
          ASM_MESON_TAC [tagged_partial_division_of]]]))

  let TAGGED_PARTIAL_DIVISION_COMMON_TAGS ← prove
   r"!p s:real^N->bool x.
        p tagged_partial_division_of s
        ==> CARD {(x,k) | k | (x,k) IN p /\ ~(content k = &0)}
            <= 2 EXP (dimindex(:N))"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"x:real^N") o
     MATCH_MP TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LE_TRANS) THEN
    MATCH_MP_TAC CARD_SUBSET THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_ELIM_PAIR_THM] THEN
      ASM_MESON_TAC [tagged_partial_division_of],
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"p:real^N#(real^N->bool)->bool") THEN CONJ_TAC THENL
       [ASM_MESON_TAC [tagged_partial_division_of], SET_TAC []]])

  let HAS_INTEGRAL_DROP_POS_AE ← prove
   r"!f:real^M->real^1 s t i.
        (f has_integral i) s /\
        negligible t /\ (!x. x IN s DIFF t ==> &0 <= drop(f x))
        ==> &0 <= drop i"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_DROP_POS THEN
    EXISTS_TAC (← q r"f:real^M->real^1") THEN EXISTS_TAC (← q r"s DIFF t:real^M->bool") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_SET THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
    SET_TAC [])

  let INTEGRAL_DROP_POS_AE ← prove
   r"!f:real^M->real^1 s t.
        f integrable_on s /\
        negligible t /\ (!x. x IN s DIFF t ==> &0 <= drop(f x))
        ==> &0 <= drop(integral s f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_DROP_POS_AE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_SUBSET_COMPONENT_LE ← prove
   r"!f:real^M->real^N s t i j k.
        s SUBSET t /\ (f has_integral i) s /\ (f has_integral j) t /\
        1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN t ==> &0 <= f(x)$k)
        ==> i$k <= j$k"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_COMPONENT_LE THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(\x. if x IN s then f x else vec 0):real^M->real^N",
      ← q r"(\x. if x IN t then f x else vec 0):real^M->real^N",
      ← q r"(:real^M)"] THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL]) THEN
    ASM_SIMP_TAC [VEC_COMPONENT] THEN ASM SET_TAC [])

  let INTEGRAL_SUBSET_COMPONENT_LE ← prove
   r"!f:real^M->real^N s t k.
        s SUBSET t /\ f integrable_on s /\ f integrable_on t /\
        1 <= k /\ k <= dimindex(:N) /\
        (!x. x IN t ==> &0 <= f(x)$k)
        ==> (integral s f)$k <= (integral t f)$k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SUBSET_COMPONENT_LE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let HAS_INTEGRAL_SUBSET_DROP_LE ← prove
   r"!f:real^M->real^1 s t i j.
        s SUBSET t /\ (f has_integral i) s /\ (f has_integral j) t /\
        (!x. x IN t ==> &0 <= drop(f x))
        ==> drop i <= drop j"
   (REWRITE_TAC [drop] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_SUBSET_COMPONENT_LE THEN
    REWRITE_TAC [DIMINDEX_1, LE_REFL] THEN ASM_MESON_TAC [])

  let INTEGRAL_SUBSET_DROP_LE ← prove
   r"!f:real^M->real^1 s t.
        s SUBSET t /\ f integrable_on s /\ f integrable_on t /\
        (!x. x IN t ==> &0 <= drop(f(x)))
        ==> drop(integral s f) <= drop(integral t f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SUBSET_DROP_LE THEN
    ASM_MESON_TAC [INTEGRABLE_INTEGRAL])

  let INTEGRAL_SUBSET_DROP_LE_AE ← prove
   r"!f:real^M->real^1 s t u.
        s SUBSET t /\ f integrable_on s /\ f integrable_on t /\
        negligible u /\ (!x. x IN t DIFF u ==> &0 <= drop(f(x)))
        ==> drop(integral s f) <= drop(integral t f)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^M->real^1",
                      ← q r"s DIFF u:real^M->bool", ← q r"t DIFF u:real^M->bool"]
          INTEGRAL_SUBSET_DROP_LE) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM SET_TAC [], CONJ_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP] INTEGRABLE_SPIKE_SET) THENL
       [EXISTS_TAC (← q r"s:real^M->bool"), EXISTS_TAC (← q r"t:real^M->bool")] THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
      AP_TERM_TAC THEN MATCH_MP_TAC INTEGRAL_SPIKE_SET] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          NEGLIGIBLE_SUBSET)) THEN
    SET_TAC [])

  pure { DIVISION_COMMON_POINT_BOUND, TAGGED_PARTIAL_DIVISION_COMMON_POINT_BOUND,
         TAGGED_PARTIAL_DIVISION_COMMON_TAGS, HAS_INTEGRAL_DROP_POS_AE, INTEGRAL_DROP_POS_AE,
         HAS_INTEGRAL_SUBSET_COMPONENT_LE, INTEGRAL_SUBSET_COMPONENT_LE,
         HAS_INTEGRAL_SUBSET_DROP_LE, INTEGRAL_SUBSET_DROP_LE, INTEGRAL_SUBSET_DROP_LE_AE }

/- ------------------------------------------------------------------------- -/
/- Alternative forms of the integral over arbitrary sets; splitting;        -/
/- inclusion-exclusion over intervals; general reflection.                  -/
/- (integration.ml 6363-6875)                                                -/
/- ------------------------------------------------------------------------- -/

structure INQ where
  HAS_INTEGRAL_ALT : thm
  INTEGRABLE_ALT : thm
  INTEGRABLE_ALT_SUBSET : thm
  INTEGRABLE_ON_SUBINTERVAL : thm
  INTEGRAL_SPLIT : thm
  INTEGRAL_SPLIT_SIGNED : thm
  INTEGRAL_INTERVALS_INCLUSION_EXCLUSION : thm
  INTEGRAL_INTERVALS_DIFF_INCLUSION_EXCLUSION : thm
  INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_RIGHT : thm
  INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_LEFT : thm
  HAS_INTEGRAL_REFLECT_GEN : thm
  INTEGRABLE_REFLECT_GEN : thm
  INTEGRAL_REFLECT_GEN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINQ [HolBase] (D : IntegrationDeps) (BINA : INA) (BINC : INC) (BINE : INE) (BINF : INF) (BINK : INK) (BINL : INL) (BINM : INM) (BINN : INN) (BINO : INO) : ExceptT String IO INQ := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0, .. } := BINA
  let { HAS_INTEGRAL_INTEGRAL, integrable_on, integral, .. } := BINC
  let { INTEGRABLE_EQ, INTEGRAL_NULL, INTEGRAL_UNIQUE, .. } := BINE
  let { HAS_INTEGRAL_SPLIT, INTERVAL_SPLIT, .. } := BINF
  let { INTEGRAL_EQ, .. } := BINK
  let { INTEGRABLE_SUBINTERVAL, .. } := BINL
  let { HAS_INTEGRAL, .. } := BINM
  let { INTEGRABLE_RESTRICT_UNIV, .. } := BINN
  let { INTEGRABLE_REFLECT, INTEGRAL_REFLECT, .. } := BINO
  let { AND_FORALL_THM, ARITH, CARD_CLAUSES, CART_EQ, EMPTY_GSPEC, EMPTY_SUBSET, EQ_IMP,
        EXTENSION, FINITE_IMAGE, FINITE_NUMSEG, FINITE_POWERSET, FINITE_RESTRICT,
        FINITE_SUBSET, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, INTER_SUBSET, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_NUMSEG, LAMBDA_BETA, LAMBDA_ETA, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, NUMSEG_CLAUSES, PAIR_EQ,
        REAL_ARCH_SIMPLE, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_LE, REAL_MAX_LE,
        REAL_MIN_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_LE, RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_EMPTY,
        SUBSET_INTER, SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, real_pow, SUBSET_UNIV, UNWIND_THM1, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { ENDS_IN_INTERVAL, IN_INTERVAL, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_NEG, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_MUL_ASSOC, VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_NEG_COMPONENT,
        VECTOR_NEG_NEG, VSUM_DELETE, VSUM_EQ, VSUM_IMAGE, VSUM_LMUL, VSUM_SING, VSUM_UNION,
        .. } := D.dv.dg.pt.cvx.vec4
  let { IN_BALL, IN_BALL_0, LIM_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.top4
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON, MESON_TAC, NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { REAL_BOUNDS_LE, SING_GSPEC, .. } := D.dv.dg.pt.qses
  let { SUBSET_BALL, .. } := D.dv.dg.pt.qtop
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { CONVERGENT_EQ_CAUCHY, .. } := D.dv.qtopology1
  let { cauchy, .. } := D.dv.qtopology2
  let { CONS_11, LTE_ANTISYM, POWERSET_CLAUSES, REAL_LE_MAX, REAL_OF_NUM_GE, .. } :=
        D.qsession
  let { IN_INTERVAL_REFLECT, INTER_INTERVAL, REFLECT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let HAS_INTEGRAL_ALT ← prove
   r"!f:real^M->real^N s i.
        (f has_integral i) s <=>
            (!a b. (\x. if x IN s then f x else vec 0)
                   integrable_on interval[a,b]) /\
            (!e. &0 < e
                 ==> ?B. &0 < B /\
                         !a b. ball (vec 0,B) SUBSET interval[a,b]
                               ==> norm(integral(interval[a,b])
                                          (\x. if x IN s then f x else vec 0) -
                                        i) < e)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [HAS_INTEGRAL] THEN
    SPEC_TAC (← q r"\x. if x IN s then (f:real^M->real^N) x else vec 0",
              ← q r"f:real^M->real^N") THEN
    GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [INTEGRAL_UNIQUE, integrable_on]] THEN
    DISCH_TAC THEN CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [INTEGRAL_UNIQUE]] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN
    POP_ASSUM (MP_TAC o (fun th => MATCH_MP th REAL_LT_01)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
    EXISTS_TAC (← q r"(lambda i. min ((a:real^M)$i) (--B)):real^M") THEN
    EXISTS_TAC (← q r"(lambda i. max ((b:real^M)$i) B):real^M") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(lambda i. min ((a:real^M)$i) (--B)):real^M",
        ← q r"(lambda i. max ((b:real^M)$i) B):real^M"]) THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC [integrable_on]],
      SIMP_TAC [SUBSET, IN_INTERVAL, IN_BALL, LAMBDA_BETA,
                REAL_MIN_LE, REAL_LE_MAX]] THEN
    SIMP_TAC [SUBSET, IN_BALL, IN_INTERVAL, LAMBDA_BETA] THEN
    GEN_TAC THEN REWRITE_TAC [← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH
      (← q r"abs(x) <= B ==> min a (--B) <= x /\ x <= max b B")) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^M)") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, COMPONENT_LE_NORM])

  let INTEGRABLE_ALT ← prove
   r"!f:real^M->real^N s.
        f integrable_on s <=>
          (!a b. (\x. if x IN s then f x else vec 0) integrable_on
                 interval[a,b]) /\
          (!e. &0 < e
               ==> ?B. &0 < B /\
                       !a b c d.
                          ball(vec 0,B) SUBSET interval[a,b] /\
                          ball(vec 0,B) SUBSET interval[c,d]
                          ==> norm(integral (interval[a,b])
                                    (\x. if x IN s then f x else vec 0) -
                                   integral (interval[c,d])
                                    (\x. if x IN s then f x else vec 0)) < e)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [integrable_on] THEN
    ONCE_REWRITE_TAC [HAS_INTEGRAL_ALT] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> (b <=> c)) ==> (a /\ b <=> a /\ c)")) THEN
    DISCH_TAC THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
      MESON_TAC [← NORM_ARITH (← q r"norm(a - y) < e / &2 /\ norm(b - y) < e / &2
                          ==> norm(a - b) < e")],
      ALL_TAC] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"cauchy (\n. integral (interval[(lambda i. --(&n)),(lambda i. &n)])
                         (\x. if x IN s then (f:real^M->real^N) x else vec 0))")
    MP_TAC THENL
     [REWRITE_TAC [cauchy] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPEC (← q r"B:real") REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [dist] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [SUBSET, IN_BALL, ← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
      CONJ_TAC,
      REWRITE_TAC [← GSYM CONVERGENT_EQ_CAUCHY] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"i:real^N") THEN
      REWRITE_TAC [LIM_SEQUENTIALLY] THEN DISCH_THEN (LABEL_TAC "C") THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "C" (MP_TAC o SPEC (← q r"e / &2")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") ASSUME_TAC) THEN
      MP_TAC (← SPEC (← q r"max (&N) B") REAL_ARCH_SIMPLE) THEN
      REWRITE_TAC [REAL_MAX_LE, REAL_OF_NUM_LE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"&n") THEN CONJ_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(i1 - i2) < e / &2 ==> dist(i1,i) < e / &2 ==> norm(i2 - i) < e")) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(vec 0:real^M,&n)") THEN
      ASM_SIMP_TAC [SUBSET_BALL] THEN
      REWRITE_TAC [SUBSET, IN_BALL, ← NORM_ARITH (← q r"dist(vec 0,x) = norm x")]] THEN
    X_GEN_TAC (← q r"x:real^M") THEN DISCH_TAC THEN
    SIMP_TAC [IN_INTERVAL, LAMBDA_BETA] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [REAL_BOUNDS_LE] THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"norm(x:real^M)") THEN ASM_SIMP_TAC [COMPONENT_LE_NORM] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [← GSYM REAL_OF_NUM_GE] THEN
    REAL_ARITH_TAC)

  let INTEGRABLE_ALT_SUBSET ← prove
   r"!f:real^M->real^N s.
        f integrable_on s <=>
          (!a b. (\x. if x IN s then f x else vec 0) integrable_on
                 interval[a,b]) /\
          (!e. &0 < e
               ==> ?B. &0 < B /\
                       !a b c d.
                          ball(vec 0,B) SUBSET interval[a,b] /\
                          interval[a,b] SUBSET interval[c,d]
                          ==> norm(integral (interval[a,b])
                                    (\x. if x IN s then f x else vec 0) -
                                   integral (interval[c,d])
                                    (\x. if x IN s then f x else vec 0)) < e)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [INTEGRABLE_ALT] THEN
    ABBREV_TAC (← q r"g:real^M->real^N = \x. if x IN s then f x else vec 0") THEN
    POP_ASSUM (K ALL_TAC) THEN
    MATCH_MP_TAC (← TAUT (← q r"(a ==> (b <=> c)) ==> (a /\ b <=> a /\ c)")) THEN
    DISCH_TAC THEN EQ_TAC THENL [MESON_TAC [SUBSET_TRANS], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^M", ← q r"b:real^M", ← q r"c:real^M",
                         ← q r"d:real^M"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"(lambda i. max ((a:real^M)$i) ((c:real^M)$i)):real^M",
      ← q r"(lambda i. min ((b:real^M)$i) ((d:real^M)$i)):real^M"]) THEN
    ASM_REWRITE_TAC [← GSYM INTER_INTERVAL, SUBSET_INTER] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← ISPECL [← q r"a:real^M", ← q r"b:real^M"] th) THEN
            MP_TAC (← ISPECL [← q r"c:real^M", ← q r"d:real^M"] th))) THEN
    ASM_REWRITE_TAC [INTER_SUBSET] THEN NORM_ARITH_TAC)

  let INTEGRABLE_ON_SUBINTERVAL ← prove
   r"!f:real^M->real^N s a b.
        f integrable_on s /\ interval[a,b] SUBSET s
        ==> f integrable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [INTEGRABLE_ALT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o CONJUNCT1) ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^M", ← q r"b:real^M"]) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_EQ) THEN
    ASM SET_TAC [])

  let INTEGRAL_SPLIT ← prove
   r"!f:real^M->real^N a b t k.
        f integrable_on interval[a,b] /\ 1 <= k /\ k <= dimindex(:M)
        ==> integral (interval[a,b]) f =
                integral(interval
                 [a,(lambda i. if i = k then min (b$k) t else b$i)]) f +
                integral(interval
                 [(lambda i. if i = k then max (a$k) t else a$i),b]) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPLIT THEN
    MAP_EVERY EXISTS_TAC [← q r"k:num", ← q r"t:real"] THEN
    ASM_SIMP_TAC [INTERVAL_SPLIT, ← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"interval[a:real^M,b]") THEN
    ASM_SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN
    REPEAT STRIP_TAC THEN TRY COND_CASES_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let INTEGRAL_SPLIT_SIGNED ← prove
   r"!f:real^M->real^N a b t k.
        1 <= k /\ k <= dimindex(:M) /\ a$k <= t /\ a$k <= b$k /\
        f integrable_on
        interval[a,(lambda i. if i = k then max (b$k) t else b$i)]
        ==> integral (interval[a,b]) f =
                integral(interval
                 [a,(lambda i. if i = k then t else b$i)]) f +
                (if b$k < t then -- &1 else &1) %
                integral(interval
                 [(lambda i. if i = k then min (b$k) t else a$i),
                  (lambda i. if i = k then max (b$k) t else b$i)]) f"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [MP_TAC (← ISPECL
      [← q r"f:real^M->real^N",
       ← q r"a:real^M",
       ← q r"(lambda i. if i = k then t else (b:real^M)$i):real^M",
       ← q r"(b:real^M)$k", ← q r"k:num"]
          INTEGRAL_SPLIT) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL)) THEN
        ASM_SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN
        REPEAT STRIP_TAC THEN TRY COND_CASES_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← VECTOR_ARITH
         (← q r"x = y /\ w = z
          ==> x:real^N = (y + z) + --(&1) % w")) THEN
        CONJ_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [CONS_11, PAIR_EQ, CART_EQ] THEN TRY CONJ_TAC THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        GEN_TAC THEN STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
        ASM_REAL_ARITH_TAC],
      MP_TAC (← ISPECL
      [← q r"f:real^M->real^N",
       ← q r"a:real^M",
       ← q r"b:real^M",
       ← q r"t:real", ← q r"k:num"]
          INTEGRAL_SPLIT) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL)) THEN
        ASM_SIMP_TAC [SUBSET_INTERVAL, LAMBDA_BETA] THEN
        REPEAT STRIP_TAC THEN TRY COND_CASES_TAC THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [VECTOR_MUL_LID] THEN
        BINOP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
        REWRITE_TAC [CONS_11, PAIR_EQ, CART_EQ] THEN TRY CONJ_TAC THEN
        ASM_SIMP_TAC [LAMBDA_BETA] THEN
        GEN_TAC THEN STRIP_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
        ASM_REAL_ARITH_TAC]])

  let INTEGRAL_INTERVALS_INCLUSION_EXCLUSION ← (do
    let lemma1 ← prove
     r"!f:(num->bool)->real^N n.
          vsum {s | s SUBSET 1..SUC n} f =
          vsum {s | s SUBSET 1..n} f +
          vsum {s | s SUBSET 1..n} (\s. f(SUC n INSERT s))"
     (REPEAT STRIP_TAC THEN
      REWRITE_TAC [NUMSEG_CLAUSES, ← ARITH_RULE (← q r"1 <= SUC n"), POWERSET_CLAUSES] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) VSUM_UNION o lhs o snd) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [FINITE_IMAGE, FINITE_POWERSET, FINITE_NUMSEG] THEN
        REWRITE_TAC [← SET_RULE
         (← q r"DISJOINT s (IMAGE f t) <=> !x. x IN t ==> ~(f x IN s)")] THEN
        GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM, SUBSET] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"SUC n")) THEN
        REWRITE_TAC [IN_INSERT, IN_NUMSEG] THEN ARITH_TAC,
        DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] VSUM_IMAGE) THEN
        SIMP_TAC [FINITE_POWERSET, FINITE_NUMSEG] THEN
        MAP_EVERY X_GEN_TAC [← q r"s:num->bool", ← q r"t:num->bool"] THEN
        REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"~(a IN i)
          ==> s SUBSET i /\ t SUBSET i /\ a INSERT s = a INSERT t
              ==> s = t")) THEN
        REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC])
    let lemma2 ← prove
     r"!f:real^M->real^N m a:real^M c:real^M d:real^M.
          f integrable_on (:real^M) /\ m <= dimindex(:M) /\
          (!i. m < i /\ i <= dimindex(:M) ==> a$i = c$i \/ d$i = c$i) /\
          (!i. m < i /\ i <= dimindex(:M) ==> a$i = c$i ==> a$i = d$i) /\
          (!i. 1 <= i /\ i <= dimindex(:M) ==> a$i <= c$i /\ a$i <= d$i)
          ==> integral(interval[a,d]) f =
                  vsum {s | s SUBSET 1..m}
                      (\s. --(&1) pow CARD {i | i IN s /\ d$i < c$i} %
                           integral
                            (interval[(lambda i. if i IN s
                                                 then min (c$i) (d$i)
                                                 else (a:real^M)$i),
                                      (lambda i. if i IN s
                                                 then max (c$i) (d$i)
                                                 else c$i)]) f)"
     (GEN_TAC THEN INDUCT_TAC THENL
       [REWRITE_TAC [NUMSEG_CLAUSES, ARITH, SUBSET_EMPTY, SING_GSPEC] THEN
        REWRITE_TAC [VSUM_SING, NOT_IN_EMPTY, EMPTY_GSPEC, CARD_CLAUSES] THEN
        REWRITE_TAC [real_pow, LAMBDA_ETA, VECTOR_MUL_LID] THEN
        REWRITE_TAC [← ARITH_RULE (← q r"0 < i <=> 1 <= i")] THEN REPEAT STRIP_TAC THEN
        ASM_CASES_TAC
         (← q r"?k. 1 <= k /\ k <= dimindex(:M) /\ (a:real^M)$k = (c:real^M)$k")
        THENL
         [MATCH_MP_TAC (← MESON [] (← q r"i = vec 0 /\ j = vec 0 ==> i:real^N = j")) THEN
          CONJ_TAC THEN MATCH_MP_TAC INTEGRAL_NULL THEN
          REWRITE_TAC [CONTENT_EQ_0] THEN ASM_MESON_TAC [],
          SUBGOAL_THEN (← q r"d:real^M = c:real^M") (fun th => REWRITE_TAC [th]) THEN
          REWRITE_TAC [CART_EQ] THEN ASM_MESON_TAC []],
        ALL_TAC] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [lemma1] THEN
      SUBGOAL_THEN
       (← q r"!s. s SUBSET 1..m
          ==> --(&1) pow CARD {i | i IN SUC m INSERT s /\ d$i < c$i} =
              (if (d:real^M)$(SUC m) < (c:real^M)$(SUC m) then -- &1 else &1) *
              --(&1) pow CARD {i | i IN s /\ d$i < c$i}")
       (fun th => SIMP_TAC [th, IN_ELIM_THM]) THENL
       [X_GEN_TAC (← q r"s:num->bool") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"FINITE(s:num->bool)") ASSUME_TAC THENL
         [ASM_MESON_TAC [FINITE_NUMSEG, FINITE_SUBSET], ALL_TAC] THEN
        COND_CASES_TAC THENL
         [ASM_SIMP_TAC [CARD_CLAUSES, FINITE_RESTRICT, ← SET_RULE
           (← q r"P a ==> {x | x IN a INSERT s /\ P x} =
                  a INSERT {x | x IN s /\ P x}")] THEN
          REWRITE_TAC [IN_ELIM_THM] THEN COND_CASES_TAC THEN
          ASM_REWRITE_TAC [real_pow] THEN
          SUBGOAL_THEN (← q r"~(SUC m IN 1..m)") (fun th => ASM SET_TAC [th]) THEN
          REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
          ASM_SIMP_TAC [REAL_MUL_LID, ← SET_RULE
           (← q r"~(P a) ==> {x | x IN a INSERT s /\ P x} = {x | x IN s /\ P x}")]],
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"d:real^M",
        ← q r"(c:real^M)$SUC m", ← q r"SUC m"]
           INTEGRAL_SPLIT_SIGNED) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [← ARITH_RULE (← q r"1 <= SUC n"), INTEGRABLE_ON_SUBINTERVAL,
                       SUBSET_UNIV],
        DISCH_THEN SUBST1_TAC] THEN
      REWRITE_TAC [VSUM_LMUL, ← GSYM VECTOR_MUL_ASSOC] THEN
      BINOP_TAC THENL [ALL_TAC, AP_TERM_TAC] THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"a:real^M",
          ← q r"c:real^M",
          ← q r"(lambda i. if i = SUC m then (c:real^M)$SUC m
                    else (d:real^M)$i):real^M"]),
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"(lambda i. if i = SUC m
                    then min ((d:real^M)$SUC m) ((c:real^M)$SUC m)
                    else (a:real^M)$i):real^M",
          ← q r"(lambda i. if i = SUC m
                    then max ((d:real^M)$SUC m) ((c:real^M)$SUC m)
                    else (c:real^M)$i):real^M",
          ← q r"(lambda i. if i = SUC m
                    then max ((d:real^M)$SUC m) ((c:real^M)$SUC m)
                    else d$i):real^M"])] THEN
      (ANTS_TAC THENL
        [ASM_REWRITE_TAC [] THEN
         CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
         CONJ_TAC THENL
          [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
           SUBGOAL_THEN (← q r"1 <= i") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
           ASM_SIMP_TAC [LAMBDA_BETA] THEN
           COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
           FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
           ALL_TAC] THEN
         CONJ_TAC THENL
          [X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
           SUBGOAL_THEN (← q r"1 <= i") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
           ASM_SIMP_TAC [LAMBDA_BETA] THEN
           COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
           ASM_MESON_TAC [← ARITH_RULE (← q r"m < i <=> i = SUC m \/ SUC m < i")],
           X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN
           COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN TRY REAL_ARITH_TAC THEN
           FIRST_X_ASSUM SUBST_ALL_TAC THEN ASM_REWRITE_TAC [] THEN
           ASM_MESON_TAC []],
         DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC VSUM_EQ THEN
         X_GEN_TAC (← q r"s:num->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN
         DISCH_TAC THEN BINOP_TAC THENL
          [AP_TERM_TAC THEN AP_TERM_TAC THEN
           REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
           X_GEN_TAC (← q r"i:num") THEN
           ASM_CASES_TAC (← q r"(i:num) IN s") THEN ASM_REWRITE_TAC [] THEN
           SUBGOAL_THEN (← q r"i IN 1..m") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
           REWRITE_TAC [IN_NUMSEG] THEN STRIP_TAC THEN
           SUBGOAL_THEN (← q r"i <= dimindex(:M)") ASSUME_TAC THENL
            [ASM_ARITH_TAC, ALL_TAC] THEN
           ASM_SIMP_TAC [LAMBDA_BETA] THEN
           COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
           AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
           REWRITE_TAC [CONS_11, PAIR_EQ] THEN
           SIMP_TAC [CART_EQ, LAMBDA_BETA, AND_FORALL_THM] THEN
           X_GEN_TAC (← q r"i:num") THEN
           ASM_CASES_TAC (← q r"1 <= i /\ i <= dimindex(:M)") THEN
           ASM_REWRITE_TAC [] THEN
           ASM_CASES_TAC (← q r"(i:num) IN s") THEN ASM_REWRITE_TAC [IN_INSERT] THEN
           COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN TRY REAL_ARITH_TAC THEN
           SUBGOAL_THEN (← q r"~(SUC m IN 1..m)") (fun th => ASM SET_TAC [th]) THEN
           REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC]]))
    prove
     r"!f:real^M->real^N a b c d.
        f integrable_on interval[a,b] /\
        c IN interval[a,b] /\ d IN interval[a,b]
        ==> integral(interval[a,d]) f =
                vsum {s | s SUBSET 1..dimindex(:M)}
                    (\s. --(&1) pow CARD {i | i IN s /\ d$i < c$i} %
                         integral
                          (interval[(lambda i. if i IN s
                                               then min (c$i) (d$i)
                                               else (a:real^M)$i),
                                    (lambda i. if i IN s
                                               then max (c$i) (d$i)
                                               else c$i)]) f)"
     (REWRITE_TAC [IN_INTERVAL] THEN REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\x. if x IN interval[a,b] then (f:real^M->real^N) x else vec 0",
        ← q r"dimindex(:M)", ← q r"a:real^M", ← q r"c:real^M", ← q r"d:real^M"]
       lemma2) THEN
      ASM_SIMP_TAC [LTE_ANTISYM, INTEGRABLE_RESTRICT_UNIV, LE_REFL] THEN
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC VSUM_EQ THEN X_GEN_TAC (← q r"s:num->bool") THEN
        REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN AP_TERM_TAC] THEN
      MATCH_MP_TAC INTEGRAL_EQ THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"i SUBSET j ==> !x. x IN i ==> (if x IN j then f x else b) = f x")) THEN
      ASM_SIMP_TAC [SUBSET_INTERVAL, REAL_LE_REFL, LAMBDA_BETA] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num"))) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC))

  let INTEGRAL_INTERVALS_DIFF_INCLUSION_EXCLUSION ← prove
   r"!f:real^M->real^N a b c d.
        f integrable_on interval[a,b] /\
        c IN interval[a,b] /\ d IN interval[a,b]
        ==> integral(interval[a,d]) f - integral(interval[a,c]) f =
                vsum {s | ~(s = {}) /\ s SUBSET 1..dimindex(:M)}
                    (\s. --(&1) pow CARD {i | i IN s /\ d$i < c$i} %
                         integral
                          (interval[(lambda i. if i IN s
                                               then min (c$i) (d$i)
                                               else (a:real^M)$i),
                                    (lambda i. if i IN s
                                               then max (c$i) (d$i)
                                               else c$i)]) f)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o
     MATCH_MP INTEGRAL_INTERVALS_INCLUSION_EXCLUSION) THEN
    REWRITE_TAC [← SET_RULE (← q r"{s | ~(s = a) /\ P s} = {s | P s} DELETE a")] THEN
    SIMP_TAC [VSUM_DELETE, FINITE_POWERSET, FINITE_NUMSEG, EMPTY_SUBSET,
              IN_ELIM_THM] THEN
    REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, CARD_CLAUSES, LAMBDA_ETA] THEN
    REWRITE_TAC [real_pow, VECTOR_MUL_LID])

  let INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_RIGHT ← prove
   r"!f:real^M->real^N a b c.
        f integrable_on interval[a,b] /\ c IN interval[a,b]
        ==> integral(interval[a,c]) f =
                vsum {s | s SUBSET 1..dimindex (:M)}
                     (\s. --(&1) pow CARD s %
                          integral
                           (interval[(lambda i. if i IN s then c$i else a$i),
                                     b])
                           f)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^M->real^N", ← q r"a:real^M", ← q r"b:real^M", ← q r"b:real^M",
      ← q r"c:real^M"]
          INTEGRAL_INTERVALS_INCLUSION_EXCLUSION) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [ENDS_IN_INTERVAL, MEMBER_NOT_EMPTY], ALL_TAC] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC VSUM_EQ THEN
    X_GEN_TAC (← q r"s:num->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"?k. k IN s /\ (c:real^M)$k = (b:real^M)$k") THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"1 <= k /\ k <= dimindex(:M)") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [IN_NUMSEG, SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC (← MESON [] (← q r"a:real^N = vec 0 /\ b = vec 0 ==> a = b")) THEN
      CONJ_TAC THEN REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
      MATCH_MP_TAC INTEGRAL_NULL THEN REWRITE_TAC [CONTENT_EQ_0] THEN
      EXISTS_TAC (← q r"k:num") THEN ASM_SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL]) THEN BINOP_TAC THENL
     [AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      ASM_MESON_TAC [REAL_LT_LE, SUBSET, IN_NUMSEG],
      AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN
      ASM_SIMP_TAC [CART_EQ, PAIR_EQ, LAMBDA_BETA] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN ASM_REWRITE_TAC [] THEN
      REAL_ARITH_TAC])

  let INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_LEFT ← prove
   r"!f:real^M->real^N a b c.
        f integrable_on interval[a,b] /\ c IN interval[a,b]
        ==> integral(interval[c,b]) f =
                vsum {s | s SUBSET 1..dimindex (:M)}
                     (\s. --(&1) pow CARD s %
                          integral
                           (interval[a,(lambda i. if i IN s then c$i else b$i)])
                           f)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"\x. (f:real^M->real^N) (--x)",
      ← q r"--b:real^M",
      ← q r"--a:real^M",
      ← q r"--c:real^M"]
          INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_RIGHT) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"min (--a) (--b) = --(max a b)"),
                 ← REAL_ARITH (← q r"max (--a) (--b) = --(min a b)"),
                 VECTOR_NEG_COMPONENT] THEN
    SUBGOAL_THEN
     (← q r"!P x y. (lambda i. if P i then --(x i) else --(y i)):real^M =
            --(lambda i. if P i then x i else y i)")
     (fun th => REWRITE_TAC [th])
    THENL
     [SIMP_TAC [CART_EQ, VECTOR_NEG_COMPONENT, LAMBDA_BETA] THEN MESON_TAC [],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [INTEGRAL_REFLECT, INTEGRABLE_REFLECT,
                     IN_INTERVAL_REFLECT])

  let HAS_INTEGRAL_REFLECT_GEN ← prove
   r"!f:real^M->real^N i s.
     ((\x. f(--x)) has_integral i) s <=> (f has_integral i) (IMAGE (--) s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [HAS_INTEGRAL_ALT] THEN
    REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← GSYM INTEGRABLE_REFLECT, ← GSYM INTEGRAL_REFLECT] THEN
    REWRITE_TAC [IN_IMAGE, VECTOR_NEG_NEG] THEN
    REWRITE_TAC [UNWIND_THM1, ← VECTOR_ARITH (← q r"x:real^N = --y <=> --x = y")] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← MESON [VECTOR_NEG_NEG]
     (← q r"(!x:real^N y:real^N. P x y) <=> (!x y. P (--y) (--x))")] THEN
    REWRITE_TAC [VECTOR_NEG_NEG] THEN
    REWRITE_TAC [SUBSET, IN_BALL_0, ← GSYM REFLECT_INTERVAL, IN_IMAGE] THEN
    REWRITE_TAC [UNWIND_THM1, ← VECTOR_ARITH (← q r"x:real^N = --y <=> --x = y")] THEN
    ONCE_REWRITE_TAC [← GSYM NORM_NEG] THEN
    REWRITE_TAC [← MESON [VECTOR_NEG_NEG] (← q r"(!x:real^N. P (--x)) <=> (!x. P x)")] THEN
    REWRITE_TAC [NORM_NEG])

  let INTEGRABLE_REFLECT_GEN ← prove
   r"!f:real^M->real^N s.
        (\x. f(--x)) integrable_on s <=> f integrable_on (IMAGE (--) s)"
   (REWRITE_TAC [integrable_on, HAS_INTEGRAL_REFLECT_GEN])

  let INTEGRAL_REFLECT_GEN ← prove
   r"!f:real^M->real^N s.
        integral s (\x. f(--x)) = integral (IMAGE (--) s) f"
   (REWRITE_TAC [integral, HAS_INTEGRAL_REFLECT_GEN])

  pure { HAS_INTEGRAL_ALT, INTEGRABLE_ALT, INTEGRABLE_ALT_SUBSET, INTEGRABLE_ON_SUBINTERVAL,
         INTEGRAL_SPLIT, INTEGRAL_SPLIT_SIGNED, INTEGRAL_INTERVALS_INCLUSION_EXCLUSION,
         INTEGRAL_INTERVALS_DIFF_INCLUSION_EXCLUSION,
         INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_RIGHT,
         INTEGRAL_INTERVALS_INCLUSION_EXCLUSION_LEFT, HAS_INTEGRAL_REFLECT_GEN,
         INTEGRABLE_REFLECT_GEN, INTEGRAL_REFLECT_GEN }

/- ------------------------------------------------------------------------- -/
/- A straddling criterion for integrability; adding integrals over several  -/
/- sets.  (integration.ml 6876-7356)                                         -/
/- ------------------------------------------------------------------------- -/

structure INR where
  INTEGRABLE_STRADDLE_INTERVAL : thm
  INTEGRABLE_STRADDLE : thm
  HAS_INTEGRAL_STRADDLE_NULL : thm
  HAS_INTEGRAL_UNION : thm
  INTEGRAL_UNION : thm
  INTEGRABLE_UNION : thm
  INTEGRABLE_UNION_EQ : thm
  HAS_INTEGRAL_UNIONS_IMAGE : thm
  HAS_INTEGRAL_UNIONS : thm
  INTEGRABLE_UNIONS_IMAGE : thm
  INTEGRABLE_UNIONS : thm
  HAS_INTEGRAL_DIFF : thm
  INTEGRAL_DIFF : thm
  INTEGRABLE_DIFF : thm
  INTEGRABLE_ON_SUBINTERVAL_GEN : thm
  INTEGRABLE_ON_SUBSET : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINR [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BINE : INE) (BINF : INF) (BINI : INI) (BINK : INK) (BINL : INL) (BINN : INN) (BINO : INO) (BINP : INP) (BINQ : INQ) : ExceptT String IO INR := do
  -- @@SCOPE BEGIN
  let { CONTENT_POS_LE, .. } := BINA
  let { GAUGE_INTER, .. } := BINB
  let { FINE_INTER, has_integral, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_INTEGRAL, integrable_on,
        TAGGED_DIVISION_OF, TAGGED_DIVISION_OF_FINITE, .. } := BINC
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_ADD, HAS_INTEGRAL_EMPTY_EQ,
        HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_SUB, INTEGRABLE_ADD,
        INTEGRABLE_ON_EMPTY, INTEGRABLE_SUB, INTEGRAL_SUB, INTEGRAL_UNIQUE, .. } := BINE
  let { INTEGRABLE_CAUCHY, .. } := BINF
  let { HAS_INTEGRAL_DROP_LE, HAS_INTEGRAL_DROP_POS, INTEGRAL_DROP_LE, .. } := BINI
  let { HAS_INTEGRAL_SPIKE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT, NEGLIGIBLE_SUBSET,
        NEGLIGIBLE_UNIONS, .. } := BINK
  let { INTEGRAL_COMBINE, .. } := BINL
  let { HAS_INTEGRAL_RESTRICT_UNIV, INTEGRABLE_RESTRICT_INTER, INTEGRABLE_RESTRICT_UNIV,
        INTEGRABLE_SPIKE_SET, INTEGRAL_RESTRICT_INTER, .. } := BINN
  let { INTEGRABLE_TRANSLATION, .. } := BINO
  let { HAS_INTEGRAL_SUBSET_DROP_LE, .. } := BINP
  let { HAS_INTEGRAL_ALT, INTEGRABLE_ALT, INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { ARITH, CONJ_ASSOC, DISJOINT, EQ_IMP, ETA_AX, EXISTS_REFL, EXTENSION, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_PAIR_THM, FUN_EQ_THM, IMAGE_CLAUSES,
        IMAGE_ID, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, INTER, INTER_UNIONS, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_UNION, IN_UNIV, LAMBDA_BETA,
        LEFT_AND_EXISTS_THM, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        MONO_FORALL, NOT_IMP, NOT_IN_EMPTY, PAIRWISE_IMP, PAIRWISE_INSERT, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_LMUL, REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_MAX_LE, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, REAL_OF_NUM_LT, REAL_POS, REAL_SUB_LE, RIGHT_AND_EXISTS_THM,
        RIGHT_IMP_EXISTS_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, pairwise, SUBSET_UNIV, SUM_LE, SWAP_FORALL_THM, UNION_SUBSET, UNIONS_0,
        UNIONS_INSERT, UNWIND_THM1, .. } := D.dv.dg.pt.cvx.core6
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, FORALL_LIFT, IN_INTERVAL, LIFT_DROP,
        LIFT_EQ, LIFT_NUM, LIFT_SUB, NORM_0, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { drop, VECTOR_ADD_LID, VECTOR_SUB_LZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO,
        VSUM_CLAUSES, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, IN_INTERVAL_1, .. } :=
        D.dv.dg.pt.cvx.top4
  let { UNIONS_COMPONENTS, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } :=
        D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { IS_INTERVAL_CONNECTED_1, .. } := D.dv.dg.qconvex
  let { BALL_1, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { LAMBDA_PAIR_THM, REAL_LE_MAX, REAL_LT_MAX, .. } := D.qsession
  let { BALL_MAX_UNION, IS_INTERVAL_1_CASES, PAIRWISE_DISJOINT_COMPONENTS, .. } :=
        D.qtopology
  let { NORM_REAL, TRANSLATION_UNIV, VSUM_REAL, .. } := D.qvec
  -- @@SCOPE END

  let INTEGRABLE_STRADDLE_INTERVAL ← prove
   r"!f:real^N->real^1 a b.
        (!e. &0 < e
             ==> ?g h i j. (g has_integral i) (interval[a,b]) /\
                           (h has_integral j) (interval[a,b]) /\
                           norm(i - j) < e /\
                           !x. x IN interval[a,b]
                               ==> drop(g x) <= drop(f x) /\
                                   drop(f x) <= drop(h x))
        ==> f integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTEGRABLE_CAUCHY] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"g:real^N->real^1", ← q r"h:real^N->real^1", ← q r"i:real^1",
      ← q r"j:real^1"] THEN
    REWRITE_TAC [has_integral] THEN REWRITE_TAC [IMP_CONJ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real^N->real^N->bool") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real^N->real^N->bool") STRIP_ASSUME_TAC) THEN
    DISCH_TAC THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(\x. d1 x INTER d2 x):real^N->real^N->bool") THEN
    ASM_SIMP_TAC [GAUGE_INTER, FINE_INTER] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"p1:(real^N#(real^N->bool))->bool",
      ← q r"p2:(real^N#(real^N->bool))->bool"] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC (← SPEC (← q r"p1:(real^N#(real^N->bool))->bool") th) THEN
           MP_TAC (← SPEC (← q r"p2:(real^N#(real^N->bool))->bool") th)))) THEN
    EVERY_ASSUM (fun th => tactic_of (tryWith
      (do pure (ASSUME_TAC (← MATCH_MP TAGGED_DIVISION_OF_FINITE th)))
      (pure ALL_TAC))) THEN
    ASM_SIMP_TAC [VSUM_REAL] THEN REWRITE_TAC [o_DEF, LAMBDA_PAIR_THM] THEN
    SUBST1_TAC (← SYM (← ISPEC (← q r"i:real^1") (← CONJUNCT1 LIFT_DROP))) THEN
    SUBST1_TAC (← SYM (← ISPEC (← q r"j:real^1") (← CONJUNCT1 LIFT_DROP))) THEN
    REWRITE_TAC [← GSYM LIFT_SUB, DROP_CMUL, NORM_LIFT] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"g1 - h2 <= f1 - f2 /\ f1 - f2 <= h1 - g2 /\
      abs(i - j) < e / &3
      ==> abs(g2 - i) < e / &3
          ==> abs(g1 - i) < e / &3
              ==> abs(h2 - j) < e / &3
                  ==> abs(h1 - j) < e / &3
                      ==> abs(f1 - f2) < e")) THEN
    ASM_REWRITE_TAC [← GSYM DROP_SUB, ← GSYM NORM_LIFT, LIFT_DROP] THEN CONJ_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x <= x' /\ y' <= y ==> x - y <= x' - y'")) THEN
    CONJ_TAC THEN MATCH_MP_TAC SUM_LE THEN
    REWRITE_TAC [FORALL_PAIR_THM] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_MESON_TAC [TAGGED_DIVISION_OF, CONTENT_POS_LE, SUBSET])

  let INTEGRABLE_STRADDLE ← (do
    let lemma ← prove
     r"&0 <= drop x /\ drop x <= drop y ==> norm x <= norm y"
     (REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN REAL_ARITH_TAC)
    prove
     r"!f:real^N->real^1 s.
        (!e. &0 < e
             ==> ?g h i j. (g has_integral i) s /\
                           (h has_integral j) s /\
                           norm(i - j) < e /\
                           !x. x IN s
                               ==> drop(g x) <= drop(f x) /\
                                   drop(f x) <= drop(h x))
        ==> f integrable_on s"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!a b. (\x. if x IN s then (f:real^N->real^1) x else vec 0)
          integrable_on interval[a,b]")
      ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [HAS_INTEGRAL_ALT]) THEN
        MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N"] THEN
        MATCH_MP_TAC INTEGRABLE_STRADDLE_INTERVAL THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &4")) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC
         [← q r"g:real^N->real^1", ← q r"h:real^N->real^1", ← q r"i:real^1",
          ← q r"j:real^1"] THEN
        REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"e / &4")) MP_TAC) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"e / &4")) STRIP_ASSUME_TAC) THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real")
         (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "H"))) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real")
         (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "G"))) THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\x. if x IN s then (g:real^N->real^1) x else vec 0",
          ← q r"\x. if x IN s then (h:real^N->real^1) x else vec 0",
          ← q r"integral(interval[a:real^N,b])
         (\x. if x IN s then (g:real^N->real^1) x else vec 0:real^1)",
          ← q r"integral(interval[a:real^N,b])
         (\x. if x IN s then (h:real^N->real^1) x else vec 0:real^1)"] THEN
        ASM_SIMP_TAC [INTEGRABLE_INTEGRAL] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [REAL_LE_REFL]] THEN
        ABBREV_TAC (← q r"c:real^N = lambda i. min ((a:real^N)$i) (--(max B1 B2))") THEN
        ABBREV_TAC (← q r"d:real^N = lambda i. max ((b:real^N)$i) (max B1 B2)") THEN
        REMOVE_THEN "H" (MP_TAC o SPECL [← q r"c:real^N", ← q r"d:real^N"]) THEN
        REMOVE_THEN "G" (MP_TAC o SPECL [← q r"c:real^N", ← q r"d:real^N"]) THEN
        MATCH_MP_TAC (← TAUT
            (← q r"(a /\ c) /\ (b /\ d ==> e) ==> (a ==> b) ==> (c ==> d) ==> e")) THEN
        CONJ_TAC THENL
         [CONJ_TAC THEN MAP_EVERY EXPAND_TAC ["c", "d"] THEN
          SIMP_TAC [SUBSET, IN_BALL, IN_INTERVAL, LAMBDA_BETA] THEN
          GEN_TAC THEN REWRITE_TAC [← NORM_ARITH (← q r"dist(vec 0,x) = norm x")] THEN
          DISCH_TAC THEN X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN
          MATCH_MP_TAC (← REAL_ARITH
            (← q r"abs(x) <= B ==> min a (--B) <= x /\ x <= max b B")) THEN
          MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"norm(x:real^N)") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE, COMPONENT_LE_NORM, REAL_LE_MAX],
          ALL_TAC] THEN
        MATCH_MP_TAC (← NORM_ARITH
           (← q r"norm(i - j) < e / &4 /\
            norm(ah - ag) <= norm(ch - cg)
            ==> norm(cg - i) < e / &4 /\
                norm(ch - j) < e / &4
                ==> norm(ag - ah) < e")) THEN
        ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [← GSYM INTEGRAL_SUB] THEN
        MATCH_MP_TAC lemma THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "N", ← qty "M")]
            HAS_INTEGRAL_DROP_POS) THEN
          MAP_EVERY EXISTS_TAC
           [← q r"(\x. (if x IN s then h x else vec 0) - (if x IN s then g x else vec 0))
         :real^N->real^1",
            ← q r"interval[a:real^N,b]"] THEN
          ASM_SIMP_TAC [INTEGRABLE_INTEGRAL, HAS_INTEGRAL_SUB] THEN
          ASM_SIMP_TAC [INTEGRABLE_SUB, INTEGRABLE_INTEGRAL] THEN
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [DROP_SUB, DROP_VEC, REAL_SUB_LE, REAL_POS] THEN
          ASM_MESON_TAC [REAL_LE_TRANS],
          ALL_TAC] THEN
        MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "N", ← qty "M")]
          HAS_INTEGRAL_SUBSET_DROP_LE) THEN
        MAP_EVERY EXISTS_TAC
         [← q r"(\x. (if x IN s then h x else vec 0) - (if x IN s then g x else vec 0))
       :real^N->real^1",
          ← q r"interval[a:real^N,b]", ← q r"interval[c:real^N,d]"] THEN
        ASM_SIMP_TAC [INTEGRABLE_SUB, INTEGRABLE_INTEGRAL] THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET_INTERVAL] THEN DISCH_TAC THEN
          MAP_EVERY EXPAND_TAC ["c", "d"] THEN
          SIMP_TAC [LAMBDA_BETA] THEN REAL_ARITH_TAC,
          ALL_TAC] THEN
        REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [DROP_SUB, DROP_VEC, REAL_SUB_LE, REAL_POS] THEN
        ASM_MESON_TAC [REAL_LE_TRANS],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [INTEGRABLE_ALT] THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, HAS_INTEGRAL_ALT] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"g:real^N->real^1", ← q r"h:real^N->real^1", ← q r"i:real^1",
        ← q r"j:real^1"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &3"))) THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &3"))) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B1:real")
        (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "G"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B2:real")
        (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "H"))) THEN
      EXISTS_TAC (← q r"max B1 B2") THEN
      ASM_REWRITE_TAC [REAL_LT_MAX, BALL_MAX_UNION, UNION_SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^N", ← q r"b:real^N", ← q r"c:real^N",
                           ← q r"d:real^N"] THEN
      STRIP_TAC THEN REWRITE_TAC [NORM_1, DROP_SUB] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"!ga gc ha hc i j.
        ga <= fa /\ fa <= ha /\
        gc <= fc /\ fc <= hc /\
        abs(ga - i) < e / &3 /\
        abs(gc - i) < e / &3 /\
        abs(ha - j) < e / &3 /\
        abs(hc - j) < e / &3 /\
        abs(i - j) < e / &3
        ==> abs(fa - fc) < e")) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"drop(integral(interval[a:real^N,b]) (\x. if x IN s then g x else vec 0))",
        ← q r"drop(integral(interval[c:real^N,d]) (\x. if x IN s then g x else vec 0))",
        ← q r"drop(integral(interval[a:real^N,b]) (\x. if x IN s then h x else vec 0))",
        ← q r"drop(integral(interval[c:real^N,d]) (\x. if x IN s then h x else vec 0))",
        ← q r"drop i", ← q r"drop j"] THEN
      REWRITE_TAC [← GSYM DROP_SUB, ← GSYM NORM_1] THEN ASM_SIMP_TAC [] THEN
      REPEAT CONJ_TAC THEN MATCH_MP_TAC INTEGRAL_DROP_LE THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_SIMP_TAC [REAL_LE_REFL]))

  let HAS_INTEGRAL_STRADDLE_NULL ← prove
   r"!f g:real^N->real^1 s.
        (!x. x IN s ==> &0 <= drop(f x) /\ drop(f x) <= drop(g x)) /\
        (g has_integral (vec 0)) s
        ==> (f has_integral (vec 0)) s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_STRADDLE THEN
      GEN_TAC THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\x. vec 0):real^N->real^1", ← q r"g:real^N->real^1",
        ← q r"vec 0:real^1", ← q r"vec 0:real^1"] THEN
      ASM_REWRITE_TAC [DROP_VEC, HAS_INTEGRAL_0, VECTOR_SUB_REFL, NORM_0],
      DISCH_TAC THEN ONCE_REWRITE_TAC [← GSYM DROP_EQ] THEN
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC (← ISPECL [← q r"f:real^N->real^1", ← q r"g:real^N->real^1"]
          HAS_INTEGRAL_DROP_LE),
        MATCH_MP_TAC (← ISPECL [← q r"(\x. vec 0):real^N->real^1",
                                ← q r"f:real^N->real^1"]
          HAS_INTEGRAL_DROP_LE)] THEN
      EXISTS_TAC (← q r"s:real^N->bool") THEN
      ASM_SIMP_TAC [← GSYM HAS_INTEGRAL_INTEGRAL, DROP_VEC, HAS_INTEGRAL_0]])

  let HAS_INTEGRAL_UNION ← prove
   r"!f:real^M->real^N i j s t.
        (f has_integral i) s /\ (f has_integral j) t /\ negligible(s INTER t)
        ==> (f has_integral (i + j)) (s UNION t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    EXISTS_TAC (← q r"(\x. if x IN (s INTER t) then &2 % f(x)
                   else if x IN (s UNION t) then f(x)
                   else vec 0):real^M->real^N") THEN
    EXISTS_TAC (← q r"s INTER t:real^M->bool") THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNION, IN_INTER, IN_UNIV] THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP HAS_INTEGRAL_ADD) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let INTEGRAL_UNION ← prove
   r"!f:real^M->real^N s t.
        f integrable_on s /\ f integrable_on t /\ negligible(s INTER t)
        ==> integral (s UNION t) f = integral s f + integral t f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_UNION THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let INTEGRABLE_UNION ← prove
   r"!f:real^M->real^N s t.
        f integrable_on s /\ f integrable_on t /\ negligible(s INTER t)
        ==> f integrable_on (s UNION t)"
   (REWRITE_TAC [integrable_on] THEN MESON_TAC [HAS_INTEGRAL_UNION])

  let INTEGRABLE_UNION_EQ ← prove
   r"!f:real^M->real^N s t.
        f integrable_on s /\ f integrable_on t
        ==> (f integrable_on (s UNION t) <=> f integrable_on (s INTER t))"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (ASSUME_TAC o MATCH_MP INTEGRABLE_ADD) THEN EQ_TAC THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_SUB) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [IN_INTER, IN_UNION] THEN CONV_TAC (fun t => VECTOR_ARITH t))

  let HAS_INTEGRAL_UNIONS_IMAGE ← prove
   r"!f:real^M->real^N k i t:A->bool.
        FINITE t /\
        (!s. s IN t ==> (f has_integral (i s)) (k s)) /\
        pairwise (\i j. negligible(k i INTER k j)) t
        ==> (f has_integral (vsum t i)) (UNIONS (IMAGE k t))"
   (REPLICATE_TAC 3 GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, UNIONS_INSERT] THEN
    REWRITE_TAC [HAS_INTEGRAL_EMPTY_EQ, VSUM_CLAUSES] THEN
    REWRITE_TAC [FORALL_IN_INSERT, PAIRWISE_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:A", ← q r"t:A->bool"] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_SIMP_TAC [VSUM_CLAUSES] THEN STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_UNION THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [INTER_UNIONS] THEN MATCH_MP_TAC NEGLIGIBLE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [])

  let HAS_INTEGRAL_UNIONS ← prove
   r"!f:real^M->real^N i t.
        FINITE t /\
        (!s. s IN t ==> (f has_integral (i s)) s) /\
        (!s s'. s IN t /\ s' IN t /\ ~(s = s') ==> negligible(s INTER s'))
        ==> (f has_integral (vsum t i)) (UNIONS t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM pairwise] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_UNIONS_IMAGE) THEN
    REWRITE_TAC [IMAGE_ID])

  let INTEGRABLE_UNIONS_IMAGE ← prove
   r"!f:real^M->real^N k t:A->bool.
        FINITE t /\
        (!s. s IN t ==> f integrable_on k s) /\
        pairwise (\i j. negligible(k i INTER k j)) t
        ==> f integrable_on UNIONS (IMAGE k t)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [integrable_on] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
    DISCH_THEN (CHOOSE_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_UNIONS_IMAGE)) THEN
    REWRITE_TAC [integrable_on] THEN MESON_TAC [])

  let INTEGRABLE_UNIONS ← prove
   r"!f:real^M->real^N u.
        FINITE u /\
        (!s. s IN u ==> f integrable_on s) /\
        pairwise (\s t. negligible(s INTER t)) u
        ==> f integrable_on UNIONS u"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_UNIONS_IMAGE) THEN
    REWRITE_TAC [IMAGE_ID])

  let HAS_INTEGRAL_DIFF ← prove
   r"!f:real^M->real^N i j s t.
    (f has_integral i) s /\
    (f has_integral j) t /\
    negligible (t DIFF s)
    ==> (f has_integral (i - j)) (s DIFF t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM HAS_INTEGRAL_RESTRICT_UNIV] THEN
    REWRITE_TAC [CONJ_ASSOC] THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
    EXISTS_TAC (← q r"(\x. if x IN (t DIFF s) then --(f x)
                   else if x IN (s DIFF t) then f x
                   else vec 0):real^M->real^N") THEN
    EXISTS_TAC (← q r"t DIFF s:real^M->bool") THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNION, IN_INTER, IN_UNIV] THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP HAS_INTEGRAL_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC)

  let INTEGRAL_DIFF ← prove
   r"!f:real^M->real^N s t.
        f integrable_on s /\ f integrable_on t /\ negligible(t DIFF s)
        ==> integral (s DIFF t) f = integral s f - integral t f"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_DIFF THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let INTEGRABLE_DIFF ← prove
   r"!f:real^M->real^N s t.
        f integrable_on s /\ f integrable_on t /\ t SUBSET s
        ==> f integrable_on (s DIFF t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INTEGRABLE_SUB) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [IN_DIFF] THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"x:real^M") THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(x:real^M) IN s", ← q r"(x:real^M) IN t"] THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_SUB_RZERO] THEN ASM SET_TAC [])

  let INTEGRABLE_ON_SUBINTERVAL_GEN ← prove
   r"!f:real^1->real^N s t.
        f integrable_on s /\ t SUBSET s /\ is_interval t
        ==> f integrable_on t"
   (REWRITE_TAC [SUBSET] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← GSYM INTEGRABLE_RESTRICT_UNIV] THEN
    SUBGOAL_THEN
     (← q r"(\x. if x IN t then (f:real^1->real^N) x else vec 0) =
    (\x. if x IN t then (if x IN s then (f:real^1->real^N) x else vec 0)
         else vec 0)")
    SUBST1_TAC THENL [ASM SIMP_TAC [], ALL_TAC] THEN
    ONCE_REWRITE_TAC [INTEGRABLE_RESTRICT_UNIV] THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE I [← GSYM INTEGRABLE_RESTRICT_UNIV]) THEN
    SPEC_TAC (← q r"\x. if x IN s then (f:real^1->real^N) x else vec 0",
              ← q r"f:real^1->real^N") THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o SPEC (← q r"vec 0:real^1")) THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1_CASES]) THEN
    REWRITE_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN ASM_SIMP_TAC [INTEGRABLE_ON_EMPTY] THEN
    SPEC_TAC (← q r"t:real^1->bool", ← q r"t:real^1->bool") THEN
    REWRITE_TAC [FORALL_AND_THM] THEN ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN ONCE_REWRITE_TAC [← MESON []
     (← q r"(!a t b. P a b t) <=> (!a b t. P a b t)")] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"r /\ ((p ==> q) /\ (p' ==> q')) /\ (p' ==> p) /\ p'
      ==> p /\ p' /\ q /\ q' /\ r")) THEN
    CONJ_TAC THENL
     [REPEAT CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q r"lift a", ← q r"lift b"] o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL)) THEN
      REWRITE_TAC [SUBSET_UNIV] THEN MATCH_MP_TAC INTEGRABLE_SPIKE_SET THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{lift a,lift b}") THEN
      REWRITE_TAC [NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY] THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_DIFF, IN_INTERVAL_1, IN_ELIM_THM] THEN
      REWRITE_TAC [FORALL_LIFT, IN_INSERT, NOT_IN_EMPTY, LIFT_EQ, LIFT_DROP] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:real") THEN
      UNDISCH_TAC (← q r"(f:real^1->real^N) integrable_on UNIV") THEN
      REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ]
          (← REWRITE_RULE [CONJ_ASSOC] INTEGRABLE_DIFF))) THEN
      REWRITE_TAC [SUBSET_UNIV] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM REAL_NOT_LE] THEN SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:real") THEN
      MATCH_MP_TAC INTEGRABLE_SPIKE_SET THEN
      MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN EXISTS_TAC (← q r"{lift a}") THEN
      REWRITE_TAC [NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY] THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_DIFF, IN_INTERVAL_1, IN_ELIM_THM] THEN
      REWRITE_TAC [FORALL_LIFT, IN_INSERT, NOT_IN_EMPTY, LIFT_EQ, LIFT_DROP] THEN
      REAL_ARITH_TAC,
      GEN_TAC THEN POP_ASSUM MP_TAC] THEN
    SUBGOAL_THEN (← q r"{t | a <= drop t} = IMAGE (\x. lift a + x) {t | &0 <= drop t}")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, UNWIND_THM1, DROP_SUB,
                   LIFT_DROP, ← VECTOR_ARITH (← q r"x:real^N = a + y <=> x - a = y")] THEN
      REAL_ARITH_TAC,
      SUBST1_TAC (← SYM (← ISPEC (← q r"lift a") TRANSLATION_UNIV)) THEN
      REWRITE_TAC [← GSYM INTEGRABLE_TRANSLATION] THEN
      SPEC_TAC (← q r"\x. (f:real^1->real^N) (lift a + x)", ← q r"f:real^1->real^N")] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [INTEGRABLE_ALT] THEN
    ONCE_REWRITE_TAC [INTEGRABLE_RESTRICT_INTER, INTEGRAL_RESTRICT_INTER] THEN
    REWRITE_TAC [INTER, IN_INTERVAL_1, IN_ELIM_THM] THEN
    REWRITE_TAC [CONJ_ASSOC, ← GSYM REAL_MAX_LE] THEN
    ONCE_REWRITE_TAC [← MESON [LIFT_DROP] (← q r"max a b = drop(lift(max a b))")] THEN
    SIMP_TAC [← GSYM IN_INTERVAL_1, ← SET_RULE (← q r"{x | x IN s} = s")] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [INTEGRABLE_ON_SUBINTERVAL, SUBSET_UNIV], ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INTEGRABLE_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [IN_UNIV, ETA_AX, BALL_1, SUBSET_INTERVAL_1] THEN
    REWRITE_TAC [VECTOR_ADD_LID, VECTOR_SUB_LZERO, LIFT_DROP, DROP_NEG] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
    SIMP_TAC [← REAL_ARITH (← q r"&0 < B ==> ~(B <= --B) /\ --B < B")] THEN
    REWRITE_TAC [NOT_IMP] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1", ← q r"w:real^1",
                         ← q r"x:real^1"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"max (&0) (drop u) = &0 /\ max (&0) (drop w) = &0")
    (CONJUNCTS_THEN SUBST1_TAC) THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"--lift B", ← q r"v:real^1", ← q r"--lift B", ← q r"x:real^1"]) THEN
    ASM_REWRITE_TAC [DROP_NEG, LIFT_DROP, REAL_LE_REFL] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      INTEGRABLE_ON_SUBINTERVAL)) THEN
    REWRITE_TAC [SUBSET_UNIV] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"--lift B", ← q r"v:real^1",
                      ← q r"vec 0:real^1"]
          INTEGRAL_COMBINE) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"--lift B", ← q r"x:real^1",
                      ← q r"vec 0:real^1"]
          INTEGRAL_COMBINE) THEN
    ASM_REWRITE_TAC [DROP_VEC, DROP_NEG, LIFT_DROP] THEN
    REPEAT
     (ANTS_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    REWRITE_TAC [LIFT_NUM] THEN CONV_TAC (fun t => VECTOR_ARITH t))

  let INTEGRABLE_ON_SUBSET ← prove
   r"!f:real^1->real^N s t.
        f integrable_on s /\ t SUBSET s /\ FINITE(components t)
        ==> f integrable_on t"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [UNIONS_COMPONENTS] THEN
    MATCH_MP_TAC INTEGRABLE_UNIONS THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL_GEN THEN
      REWRITE_TAC [IS_INTERVAL_CONNECTED_1] THEN
      ASM_MESON_TAC [IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, SUBSET],
      MP_TAC (← ISPEC (← q r"t:real^1->bool") PAIRWISE_DISJOINT_COMPONENTS) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] PAIRWISE_IMP) THEN
      SIMP_TAC [DISJOINT, NEGLIGIBLE_EMPTY]])

  pure { INTEGRABLE_STRADDLE_INTERVAL, INTEGRABLE_STRADDLE, HAS_INTEGRAL_STRADDLE_NULL,
         HAS_INTEGRAL_UNION, INTEGRAL_UNION, INTEGRABLE_UNION, INTEGRABLE_UNION_EQ,
         HAS_INTEGRAL_UNIONS_IMAGE, HAS_INTEGRAL_UNIONS, INTEGRABLE_UNIONS_IMAGE,
         INTEGRABLE_UNIONS, HAS_INTEGRAL_DIFF, INTEGRAL_DIFF, INTEGRABLE_DIFF,
         INTEGRABLE_ON_SUBINTERVAL_GEN, INTEGRABLE_ON_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Adding integrals over a division; tagged divisions; Henstock's lemma.    -/
/- (integration.ml 7357-7789)                                                -/
/- ------------------------------------------------------------------------- -/

structure INS where
  HAS_INTEGRAL_COMBINE_DIVISION : thm
  INTEGRAL_COMBINE_DIVISION_BOTTOMUP : thm
  HAS_INTEGRAL_COMBINE_DIVISION_TOPDOWN : thm
  INTEGRAL_COMBINE_DIVISION_TOPDOWN : thm
  INTEGRABLE_COMBINE_DIVISION : thm
  INTEGRABLE_ON_SUBDIVISION : thm
  HAS_INTEGRAL_COMBINE_TAGGED_DIVISION : thm
  INTEGRAL_COMBINE_TAGGED_DIVISION_BOTTOMUP : thm
  HAS_INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN : thm
  INTEGRAL_COMBINE_TAGGED_DIVISION_TOPDOWN : thm
  HENSTOCK_LEMMA_PART1 : thm
  HENSTOCK_LEMMA_PART2 : thm
  HENSTOCK_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINS [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINE : INE) (BINK : INK) (BINL : INL) (BINQ : INQ) (BINR : INR) : ExceptT String IO INS := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_INTERIOR, INTER_INTERIOR_UNIONS_INTERVALS, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION, GAUGE_INTER,
        PARTIAL_DIVISION_EXTEND_INTERVAL, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, FINE_INTER, FINE_SUBSET, FINE_UNION, FINE_UNIONS,
        has_integral, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_INTEGRAL, integrable_on,
        PARTIAL_DIVISION_OF_TAGGED_DIVISION, TAGGED_DIVISION_OF, tagged_division_of,
        TAGGED_DIVISION_OF_FINITE, TAGGED_DIVISION_UNION, TAGGED_DIVISION_UNIONS,
        tagged_partial_division_of, TAGGED_PARTIAL_DIVISION_OF_UNION_SELF,
        TAGGED_PARTIAL_DIVISION_SUBSET, VSUM_OVER_TAGGED_DIVISION_LEMMA, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { HAS_INTEGRAL_NULL, HAS_INTEGRAL_UNIQUE, INTEGRAL_NULL, INTEGRAL_UNIQUE, .. } := BINE
  let { NEGLIGIBLE_FRONTIER_INTERVAL, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION, .. } := BINK
  let { INTEGRABLE_SUBINTERVAL, .. } := BINL
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { HAS_INTEGRAL_UNIONS, .. } := BINR
  let { CONJ_SYM, EQ_IMP, EQ_TRANS, EXISTS_PAIR_THM, EXTENSION, FINITE_IMAGE, FINITE_UNION,
        FINITE_UNIONS, FORALL_AND_THM, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNIONS, FORALL_PAIR_THM, FUN_EQ_THM, IMP_CONJ, IMP_IMP,
        INTER_COMM, INTER_IDEMPOT, .. } := D.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_INTER, IN_UNION, MONO_FORALL, MONO_IMP, NOT_EXISTS_THM, NOT_IN_EMPTY,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_INV_MUL, REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ,
        REAL_LT_MUL, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM,
        SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, SUM_CONST, UNIONS_SUBSET, UNIONS_UNION, .. } :=
        D.dv.dg.pt.cvx.core6
  let { VECTOR_MUL_EQ_0, VECTOR_MUL_LZERO, VSUM_EQ, VSUM_EQ_0, VSUM_SUB, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { INTERIOR_CLOSED_INTERVAL, INTERIOR_INTER, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTERIOR, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        .. } := D.dv.dg.pt.cvx
  let { REAL_INV_INV, .. } := D.dv.qsession
  let { LAMBDA_PAIR, LAMBDA_PAIR_THM, .. } := D.qsession
  let { VSUM_IMAGE_NONZERO, VSUM_NORM_ALLSUBSETS_BOUND, VSUM_NORM_LE, VSUM_UNION_NONZERO,
        VSUM_UNIONS_NONZERO, .. } := D.qvec
  -- @@SCOPE END

  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))
  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let HAS_INTEGRAL_COMBINE_DIVISION ← prove
   r"!f:real^M->real^N s d i.
        d division_of s /\
        (!k. k IN d ==> (f has_integral (i k)) k)
        ==> (f has_integral (vsum d i)) s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o lastc o
                GEN_REWRITE_RULE I [division_of]) THEN
    MATCH_MP_TAC HAS_INTEGRAL_UNIONS THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_FINITE], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"k1:real^M->bool", ← q r"k2:real^M->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?u v:real^M x y:real^M.
                k1 = interval[u,v] /\ k2 = interval[x,y]")
     (REPEAT_TCL CHOOSE_THEN (CONJUNCTS_THEN SUBST_ALL_TAC))
    THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o elc 2 o
                GEN_REWRITE_RULE I [division_of]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"interval[u:real^M,v]", ← q r"interval[x:real^M,y]"]) THEN
    ASM_REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN DISCH_TAC THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"(interval[u,v:real^M] DIFF interval(u,v)) UNION
              (interval[x,y] DIFF interval(x,y))") THEN
    SIMP_TAC [NEGLIGIBLE_FRONTIER_INTERVAL, NEGLIGIBLE_UNION] THEN
    ASM SET_TAC [])

  let INTEGRAL_COMBINE_DIVISION_BOTTOMUP ← prove
   r"!f:real^M->real^N d s.
        d division_of s /\ (!k. k IN d ==> f integrable_on k)
        ==> integral s f = vsum d (\i. integral i f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE_DIVISION THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL])

  let HAS_INTEGRAL_COMBINE_DIVISION_TOPDOWN ← prove
   r"!f:real^M->real^N s d k.
        f integrable_on s /\ d division_of k /\ k SUBSET s
        ==> (f has_integral (vsum d (\i. integral i f))) k"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE_DIVISION THEN
    ASM_REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let INTEGRAL_COMBINE_DIVISION_TOPDOWN ← prove
   r"!f:real^M->real^N d s.
        f integrable_on s /\ d division_of s
        ==> integral s f = vsum d (\i. integral i f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE_DIVISION_TOPDOWN THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL])

  let INTEGRABLE_COMBINE_DIVISION ← prove
   r"!f d s.
        d division_of s /\ (!i. i IN d ==> f integrable_on i)
        ==> f integrable_on s"
