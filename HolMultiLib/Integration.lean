structure INA where
  INTERIOR_SUBSET_UNION_INTERVALS : thm
  INTER_INTERIOR_UNIONS_INTERVALS : thm
  ITERATE_NONZERO_IMAGE_LEMMA : thm
  interval_upperbound : thm
  interval_lowerbound : thm
  INTERVAL_UPPERBOUND : thm
  INTERVAL_LOWERBOUND : thm
  INTERVAL_UPPERBOUND_1 : thm
  INTERVAL_LOWERBOUND_1 : thm
  INTERVAL_LOWERBOUND_NONEMPTY : thm
  INTERVAL_UPPERBOUND_NONEMPTY : thm
  content : thm
  CONTENT_CLOSED_INTERVAL : thm
  CONTENT_1 : thm
  CONTENT_UNIT : thm
  CONTENT_UNIT_1 : thm
  CONTENT_POS_LE : thm
  CONTENT_POS_LT : thm
  CONTENT_POS_LT_1 : thm
  CONTENT_EQ_0_GEN : thm
  CONTENT_EQ_0 : thm
  CONTENT_0_SUBSET_GEN : thm
  CONTENT_0_SUBSET : thm
  CONTENT_CLOSED_INTERVAL_CASES : thm
  CONTENT_EQ_0_INTERIOR : thm
  CONTENT_EQ_0_1 : thm
  CONTENT_POS_LT_EQ : thm
  CONTENT_EMPTY : thm
  CONTENT_SUBSET : thm
  CONTENT_LT_NZ : thm
