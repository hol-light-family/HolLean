        HAS_BOUNDED_VARIATION_ON_SUBSET) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET s' /\ t SUBSET t' ==> s UNION t SUBSET s' UNION t'")) THEN
      REWRITE_TAC [CLOSURE_SUBSET]] THEN
