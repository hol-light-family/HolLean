        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, REAL_ARCH_INV, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_INV2, REAL_LE_LADD, REAL_LE_LMUL, REAL_LE_RADD,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, REAL_LT_RDIV_EQ, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUC, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { num_INDUCTION, o_DEF, .. } := D.dv.dg.pt.cvx.core6
  let { HULL_MINIMAL, MONOTONE_BIGGER, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_POS_LE, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_VEC, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, drop, .. } := D.dv.dg.pt.cvx.vec4
  let { COMPACT_INTERVAL, .. } := D.dv.dg.pt.cvx.top2
  let { IN_CBALL, IN_INTERVAL_1, LIM_SEQUENTIALLY, LIM_SUBSEQUENCE, .. } :=
        D.dv.dg.pt.cvx.top4
  let { bounded, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, .. } := D.dv.dg.pt.cvx
  let { CONVEX_CBALL, .. } := D.dv.dg.pt.qcvx2
  let { path, path_image, .. } := D.dv.dg.qpaths2
  let { LT_0, LT_ADD_LCANCEL, NOT_SUC, REAL_LE_LINV, .. } := D.qsession
  let { ARZELA_ASCOLI, .. } := D.qtopology
  let { DIST_REAL, .. } := D.qvec
  -- @@SCOPE END

  let SHORTEST_PATH_EXISTS_GEN ← prove
   r"!P. (!h g. (!n. rectifiable_path(h n) /\
                   P (path_image(h n)) (pathstart(h n)) (pathfinish(h n))) /\
               (!e. &0 < e
                    ==> ?N. !n:num x. n >= N /\ x IN interval[vec 0,vec 1]
                                      ==> norm (h n x - g x) < e)
               ==> P(path_image g) (pathstart g) (pathfinish g)) /\
       (?t. bounded t /\
            !g. rectifiable_path g /\
                P (path_image g) (pathstart g) (pathfinish g)
                ==> ~DISJOINT t (convex hull (path_image g))) /\
       (?g. rectifiable_path g /\
            P (path_image g) (pathstart g) (pathfinish g))
       ==> ?g. rectifiable_path g /\
               P (path_image g) (pathstart g) (pathfinish g) /\
               !h. rectifiable_path h /\
                   P (path_image h) (pathstart h) (pathfinish h)
                   ==> path_length(g:real^1->real^N) <= path_length h"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← SPEC
     (← q r"{path_length g | rectifiable_path g /\
                     P (path_image(g:real^1->real^N)) (pathstart g)
                       (pathfinish g)}") INF) THEN
    ABBREV_TAC
     (← q r"l = inf{path_length g | rectifiable_path g /\
                     P (path_image(g:real^1->real^N)) (pathstart g)
                       (pathfinish g)}") THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, FORALL_IN_GSPEC] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [PATH_LENGTH_POS_LE], STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"&0 <= l") ASSUME_TAC THENL
     [ASM_MESON_TAC [PATH_LENGTH_POS_LE], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!n. ?g. rectifiable_path g /\
            P (path_image(g:real^1->real^N))
              (pathstart g) (pathfinish g) /\
            path_length g < l + inv(&n + &1) /\
            !x y. x IN interval[vec 0,vec 1] /\ y IN interval[vec 0,vec 1]
                  ==> dist(g x,g y) <= (l + &1) * dist(x,y)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"l + inv(&n + &1)")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"l + i <= l <=> ~(&0 < i)"), REAL_LT_INV_EQ] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"&0 < &n + &1"), NOT_FORALL_THM,
                   NOT_IMP, REAL_NOT_LE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->real^N") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPEC (← q r"g:real^1->real^N") ARC_LENGTH_REPARAMETRIZATION) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"h:real^1->real^N") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [DIST_POS_LE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"g < l + i ==> i <= &1 ==> g <= l + &1"))) THEN
      MATCH_MP_TAC REAL_LE_LINV THEN REAL_ARITH_TAC,
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
      X_GEN_TAC (← q r"h:num->real^1->real^N") THEN STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"?B. !n x. x IN interval[vec 0,vec 1]
              ==> norm((h:num->real^1->real^N) n x) <= B")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"t:real^N->bool") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (LABEL_TAC "!")) THEN
      REWRITE_TAC [bounded, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"B + l + &1") THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"x:real^1"] THEN DISCH_TAC THEN
      REMOVE_THEN "!" (MP_TAC o SPEC (← q r"(h:num->real^1->real^N) n")) THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"~DISJOINT s t <=> ?x. x IN s /\ x IN t")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real^N") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"y IN cball((h:num->real^1->real^N) n x,l + &1)")
      MP_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"a IN s ==> s SUBSET t ==> a IN t"))) THEN
        MATCH_MP_TAC HULL_MINIMAL THEN
        REWRITE_TAC [CONVEX_CBALL, SUBSET, IN_CBALL] THEN
        REWRITE_TAC [path_image, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"z:real^1") THEN DISCH_TAC THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^1", ← q r"z:real^1"]) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [DIST_REAL, ← GSYM drop] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [IN_CBALL] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"norm(y:real^N) <= B ==> dist(x,y) <= l ==> norm(x) <= B + l")) THEN
        ASM_SIMP_TAC []],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"h:num->real^1->real^N", ← q r"interval[vec 0:real^1,vec 1]",
                      ← q r"B:real"] ARZELA_ASCOLI) THEN
    ASM_REWRITE_TAC [COMPACT_INTERVAL] THEN ANTS_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"e:real"] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"e / (l + &1)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LT_DIV THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"y:real^1"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, dist] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ,
                    ← REAL_ARITH (← q r"&0 <= l ==> &0 < l + &1")],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC))] THEN
    SUBGOAL_THEN
     (← q r"!n. (g:real^1->real^N) has_bounded_variation_on interval[vec 0,vec 1] /\
        vector_variation (interval[vec 0,vec 1]) g <= l + inv(&n + &1)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"N:num") THEN
      MATCH_MP_TAC HAS_BOUNDED_VECTOR_VARIATION_UNIFORM_LIM THEN
      EXISTS_TAC (← q r"\n:num. (h:num->real^1->real^N) (r(N + n))") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [rectifiable_path]) THEN
      ASM_REWRITE_TAC [← GSYM path_length] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"n:num") THEN
        TRANS_TAC REAL_LE_TRANS (← q r"l + inv(&((r:num->num)(N + n)) + &1)") THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_LADD] THEN
        MATCH_MP_TAC REAL_LE_INV2 THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, REWRITE_TAC [REAL_LE_RADD]] THEN
        REWRITE_TAC [REAL_OF_NUM_LE] THEN
        TRANS_TAC LE_TRANS (← q r"N + n:num") THEN REWRITE_TAC [LE_ADD] THEN
        ASM_SIMP_TAC [MONOTONE_BIGGER],
        X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"(\n:num. (h:num->real^1->real^N) (r(N + n)) x) =
                    (\n. h (r n) x) o (\n. N + n)")
        SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_DEF], ALL_TAC] THEN
        MATCH_MP_TAC LIM_SUBSEQUENCE THEN
        REWRITE_TAC [LT_ADD_LCANCEL, LIM_SEQUENTIALLY, dist] THEN
        ASM_MESON_TAC [GE]],
      REWRITE_TAC [FORALL_AND_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*"))] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [rectifiable_path, path], DISCH_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"\n:num. (h:num->real^1->real^N) (r n)") THEN
      ASM_REWRITE_TAC [],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"path_length(g:real^1->real^N) = l")
     (fun th => ASM_SIMP_TAC [th]) THEN
    ASM_SIMP_TAC [← GSYM REAL_LE_ANTISYM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"g <= l <=> ~(&0 < g - l)")] THEN
    ONCE_REWRITE_TAC [REAL_ARCH_INV] THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
    MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [NOT_SUC, REAL_LT_INV_EQ] THEN
    ASM_REWRITE_TAC [REAL_OF_NUM_LT, LT_0, path_length, ← GSYM REAL_OF_NUM_SUC,
                     ← ARITH_RULE (← q r"i < p - l <=> ~(p <= l + i)")])

  pure { SHORTEST_PATH_EXISTS_GEN }

/- ------------------------------------------------------------------------- -/
/- Shortest paths and arcs; minimality of arc length.                       -/
/- (integration.ml 24774-24980)                                             -/
/- ------------------------------------------------------------------------- -/

structure INCB where
  SHORTEST_PATH_EXISTS_STRADDLE : thm
  SHORTEST_PATH_EXISTS : thm
  SHORTEST_ARC_EXISTS : thm
  ARC_LENGTH_MINIMAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINCB [HolBase] (D : IntegrationDeps) (BINBW : INBW) (BINBX : INBX) (BINBY : INBY) (BINBZ : INBZ) (BINCA : INCA) : ExceptT String IO INCB := do
  -- @@SCOPE BEGIN
  let { PATH_LENGTH_REVERSEPATH, rectifiable_path, RECTIFIABLE_PATH_IMP_PATH,
        RECTIFIABLE_PATH_JOIN, RECTIFIABLE_PATH_SUBPATH, .. } := BINBW
  let { PATH_LENGTH_COMBINE, PATH_LENGTH_EQ_0, PATH_LENGTH_JOIN, PATH_LENGTH_POS_LE, .. } :=
        BINBX
  let { ARC_LENGTH_UNIQUE, PATH_LENGTH_SUBPATH_LE, .. } := BINBY
  let { ARC_LENGTH_REPARAMETRIZATION, .. } := BINBZ
  let { SHORTEST_PATH_EXISTS_GEN, .. } := BINCA
  let { CONJ_ASSOC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, GE, IMP_CONJ, .. } := D.dv.dg.pt.cvx.core2
  let { IN_IMAGE, IN_SING, LE_REFL, LE_TRANS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_TRANS, REAL_LT_LE, REAL_LT_LMUL, REAL_LT_RADD, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, .. } := D.dv.dg.pt.cvx.core6
  let { HULL_SUBSET, MONOTONE_BIGGER, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_0, .. } := D.dv.dg.pt.cvx.vec1
  let { FORALL_DROP, FORALL_LIFT, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { dist, VECTOR_SUB_EQ, .. } := D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { CLOSURE_APPROACHABLE, CLOSURE_EQ, .. } := D.dv.dg.pt.cvx.top1
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, COMPACT_INTERVAL, COMPACT_SING, .. } :=
        D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.top3
  let { LIM_CONST, LIM_IN_CLOSED_SET, LIM_SEQUENTIALLY, LIM_SUB, LIM_UNIQUE, .. } :=
        D.dv.dg.pt.cvx.top4
  let { compact, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { ARC_IMP_PATH, .. } := D.dv.dg.qpaths1
  let { arc, path, path_image, pathfinish, PATHFINISH_IN_PATH_IMAGE, PATHFINISH_JOIN,
        pathstart, PATHSTART_IN_PATH_IMAGE, PATHSTART_JOIN, .. } := D.dv.dg.qpaths2
  let { tendsto, .. } := D.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.dv.dg.qvec
  let { ALWAYS_EVENTUALLY, .. } := D.dv.qmetric
  let { ARC_DISTINCT_ENDS, ARC_IMAGE_UNIQUE, CLOSED_PATH_IMAGE, PATH_IMAGE_SUBPATH_SUBSET,
        PATHFINISH_SUBPATH, PATHSTART_SUBPATH, REVERSEPATH_SUBPATH, SUBSET_PATH_IMAGE_JOIN,
        .. } := D.qpaths
  let { CONTINUOUS_UNIFORM_LIMIT, .. } := D.qtopology
  -- @@SCOPE END

  let SHORTEST_PATH_EXISTS_STRADDLE ← prove
   r"!s t a b:real^N->bool.
        closed s /\ compact a /\ compact b /\
        (?g. rectifiable_path g /\
             t SUBSET path_image g /\ path_image g SUBSET s /\
             pathstart g IN a /\ pathfinish g IN b)
        ==> ?g. rectifiable_path g /\
                t SUBSET path_image g /\ path_image g SUBSET s /\
                pathstart g IN a /\ pathfinish g IN b /\
                !h. rectifiable_path h /\
                    t SUBSET path_image h /\ path_image h SUBSET s /\
                    pathstart h IN a /\ pathfinish h IN b
                    ==> path_length g <= path_length h"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT
     (← q r"p /\ q /\ r /\ s /\ t /\ u <=> p /\ (q /\ r /\ s /\ t) /\ u")] THEN
    MATCH_MP_TAC SHORTEST_PATH_EXISTS_GEN THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THENL
     [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:real^N") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"!n. ?t. t IN interval[vec 0,vec 1] /\
                          (h:num->real^1->real^N) n t = y")
      MP_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [path_image]) THEN ASM SET_TAC [],
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"x:num->real^1") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"interval[vec 0:real^1,vec 1]") compact) THEN
      REWRITE_TAC [COMPACT_INTERVAL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real^1")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:real^1", ← q r"r:num->num"] THEN
      STRIP_TAC THEN REWRITE_TAC [path_image, IN_IMAGE] THEN
      EXISTS_TAC (← q r"l:real^1") THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← GSYM VECTOR_SUB_EQ] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC
       (← q r"\n:num. (h:num->real^1->real^N) (r n) (x(r n)) - g(x(r n))") THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
       [MATCH_MP_TAC LIM_SUB THEN ASM_REWRITE_TAC [LIM_CONST] THEN
        SUBGOAL_THEN
         (← q r"(g:real^1->real^N) continuous (at l within interval[vec 0,vec 1])")
        MP_TAC THENL
         [SUBGOAL_THEN (← q r"(g:real^1->real^N) continuous_on interval[vec 0,vec 1]")
          MP_TAC THENL
           [MATCH_MP_TAC (← ISPEC (← q r"sequentially") CONTINUOUS_UNIFORM_LIMIT) THEN
            EXISTS_TAC (← q r"h:num->real^1->real^N") THEN
            ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
            ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
            ASM_MESON_TAC [rectifiable_path, path, GE],
            ASM_SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]],
          REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"(x:num->real^1) o (r:num->num)")) THEN
          ASM_REWRITE_TAC [o_THM] THEN REWRITE_TAC [o_DEF]],
        REWRITE_TAC [LIM_SEQUENTIALLY, DIST_0] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [GE] THEN TRANS_TAC LE_TRANS (← q r"n:num") THEN
        ASM_MESON_TAC [MONOTONE_BIGGER]],
      REWRITE_TAC [path_image, SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o GEN_REWRITE_RULE I [← GSYM CLOSURE_EQ]) THEN
      REWRITE_TAC [CLOSURE_APPROACHABLE] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o C MATCH_MP (← ASSUME (← q r"&0 < e"))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n:num"))) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [GE, LE_REFL, dist] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(h:num->real^1->real^N) n x") THEN
      ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, path_image, FORALL_IN_IMAGE]) THEN
      ASM_SIMP_TAC [],
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_IN_CLOSED_SET) THEN
      EXISTS_TAC (← q r"\n. (h:num->real^1->real^N) n (vec 0)") THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_MESON_TAC [pathstart],
        REWRITE_TAC [pathstart, tendsto]] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, dist, ← GSYM GE] THEN
      ASM_MESON_TAC [ENDS_IN_UNIT_INTERVAL],
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_IN_CLOSED_SET) THEN
      EXISTS_TAC (← q r"\n. (h:num->real^1->real^N) n (vec 1)") THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN ASM_MESON_TAC [pathfinish],
        REWRITE_TAC [pathfinish, tendsto]] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, dist, ← GSYM GE] THEN
      ASM_MESON_TAC [ENDS_IN_UNIT_INTERVAL],
      EXISTS_TAC (← q r"a:real^N->bool") THEN ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN
      X_GEN_TAC (← q r"g:real^1->real^N") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"a IN t ==> s SUBSET convex hull s /\ a IN s
      ==> ~DISJOINT t (convex hull s)"))) THEN
      REWRITE_TAC [HULL_SUBSET] THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, RECTIFIABLE_PATH_IMP_PATH]])

  let SHORTEST_PATH_EXISTS ← prove
   r"!s a b:real^N->bool.
        closed s /\ compact a /\ compact b /\
        (?g. rectifiable_path g /\ path_image g SUBSET s /\
             pathstart g IN a /\ pathfinish g IN b)
        ==> ?g. rectifiable_path g /\ path_image g SUBSET s /\
                pathstart g IN a /\ pathfinish g IN b /\
                !h. rectifiable_path h /\ path_image h SUBSET s /\
                    pathstart h IN a /\ pathfinish h IN b
                    ==> path_length g <= path_length h"
   (ONCE_REWRITE_TAC [← SET_RULE (← q r"s SUBSET t <=> {} SUBSET s /\ s SUBSET t")] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [SHORTEST_PATH_EXISTS_STRADDLE])

  let SHORTEST_ARC_EXISTS ← prove
   r"!s a b:real^N.
        closed s /\ ~(a = b) /\
        (?g. rectifiable_path g /\ path_image g SUBSET s /\
             pathstart g = a /\ pathfinish g = b)
        ==> ?g. rectifiable_path g /\ arc g /\ path_image g SUBSET s /\
                pathstart g = a /\ pathfinish g = b /\
                !h. rectifiable_path h /\ path_image h SUBSET s /\
                    pathstart h = a /\ pathfinish h = b
                    ==> path_length g <= path_length h"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"s:real^N->bool", ← q r"{a:real^N}", ← q r"{b:real^N}"]
          SHORTEST_PATH_EXISTS) THEN
    ASM_REWRITE_TAC [COMPACT_SING, IN_SING] THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o check (HolCore.Basics.is_exists o concl)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:real^1->real^N") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ARC_LENGTH_REPARAMETRIZATION) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real^1->real^N") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [arc, RECTIFIABLE_PATH_IMP_PATH] THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
    REPEAT (CONJ_TAC THENL [MESON_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"subpath (vec 0) a (g:real^1->real^N) ++ subpath b (vec 1) g")) THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ ~q ==> (p ==> q) ==> r")) THEN
    REWRITE_TAC [REAL_NOT_LE] THEN REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [RECTIFIABLE_PATH_JOIN,
                    PATHFINISH_SUBPATH, PATHSTART_SUBPATH] THEN
      CONJ_TAC THEN MATCH_MP_TAC RECTIFIABLE_PATH_SUBPATH THEN
      ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL],
      MATCH_MP_TAC SUBSET_PATH_IMAGE_JOIN THEN
      CONJ_TAC THEN TRANS_TAC SUBSET_TRANS (← q r"path_image (g:real^1->real^N)") THEN
      (CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []]) THEN
      MATCH_MP_TAC PATH_IMAGE_SUBPATH_SUBSET THEN
      ASM_SIMP_TAC [RECTIFIABLE_PATH_IMP_PATH, ENDS_IN_UNIT_INTERVAL],
      REWRITE_TAC [PATHSTART_JOIN, PATHSTART_SUBPATH] THEN
      ASM_MESON_TAC [pathstart],
      REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_SUBPATH] THEN
      ASM_MESON_TAC [pathfinish],
      MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"b:real^1"]
          PATH_LENGTH_COMBINE) THEN
      ASM_SIMP_TAC [PATH_LENGTH_JOIN, PATHSTART_SUBPATH, PATHFINISH_SUBPATH,
                    RECTIFIABLE_PATH_SUBPATH, ENDS_IN_UNIT_INTERVAL] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      REWRITE_TAC [REAL_LT_RADD] THEN MATCH_MP_TAC REAL_LT_LMUL THEN
      ASM_SIMP_TAC [REAL_LT_LE, PATH_LENGTH_POS_LE] THEN
      CONV_TAC (RAND_CONV SYM_CONV) THEN ASM_SIMP_TAC [PATH_LENGTH_EQ_0] THEN
      DISCH_THEN (CHOOSE_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"vec 0:real^1") th) THEN
              MP_TAC (← SPEC (← q r"vec 1:real^1") th)))) THEN
      REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
      ASM_MESON_TAC [pathstart, pathfinish]])

  let ARC_LENGTH_MINIMAL ← prove
   r"!g h:real^1->real^N.
        rectifiable_path g /\ arc g /\ rectifiable_path h /\
        path_image g = path_image h
        ==> path_length g <= path_length h"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"path_image g:real^N->bool", ← q r"pathstart g:real^N", ← q r"pathfinish g:real^N"]
     SHORTEST_ARC_EXISTS) THEN
    ASM_SIMP_TAC [CLOSED_PATH_IMAGE, RECTIFIABLE_PATH_IMP_PATH] THEN
    ASM_SIMP_TAC [ARC_DISTINCT_ENDS] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^1->real^N") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"k:real^1->real^N", ← q r"g:real^1->real^N"]
          ARC_IMAGE_UNIQUE) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [ARC_IMP_PATH, SUBSET_REFL], DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:real^1->real^N", ← q r"k:real^1->real^N"]
          ARC_LENGTH_UNIQUE) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN SUBST1_TAC] THEN
    SUBGOAL_THEN
     (← q r"(pathstart g:real^N) IN path_image h /\ pathfinish g IN path_image h")
    MP_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE,
                     RECTIFIABLE_PATH_IMP_PATH],
      REWRITE_TAC [path_image, IN_IMAGE, IMP_CONJ, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"s:real^1") THEN REPEAT DISCH_TAC THEN
    X_GEN_TAC (← q r"t:real^1") THEN REPEAT DISCH_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop s <= drop t \/ drop t <= drop s")) THEN
    MATCH_MP_TAC REAL_LE_TRANS THENL
     [EXISTS_TAC (← q r"path_length(subpath s t (h:real^1->real^N))"),
      EXISTS_TAC (← q r"path_length(subpath t s (h:real^1->real^N))")] THEN
    ASM_SIMP_TAC [PATH_LENGTH_SUBPATH_LE] THENL
     [ALL_TAC,
      GEN_REWRITE_TAC RAND_CONV [← GSYM PATH_LENGTH_REVERSEPATH] THEN
      REWRITE_TAC [REVERSEPATH_SUBPATH]] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
    ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET, RECTIFIABLE_PATH_IMP_PATH,
                  RECTIFIABLE_PATH_SUBPATH])

  pure { SHORTEST_PATH_EXISTS_STRADDLE, SHORTEST_PATH_EXISTS, SHORTEST_ARC_EXISTS,
         ARC_LENGTH_MINIMAL }

