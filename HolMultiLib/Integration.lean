  let { REAL_LE_ANTISYM, REAL_LE_DIV2_EQ, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_LT, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TOTAL,
        REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_ANTISYM, REAL_LT_IMP_NZ, REAL_LT_INV_EQ,
        REAL_LT_LCANCEL_IMP, REAL_LTE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT,
        REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POS,
        REAL_SUB_LDISTRIB, REAL_SUB_LE, REAL_SUB_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { numseg, o_DEF, real_div, real_ge, real_gt, SUM_RESTRICT_SET, .. } :=
        D.dv.dg.pt.cvx.core6
  let { MONOTONE_BIGGER, .. } := D.dv.dg.pt.cvx.misc
  let { DIST_LIFT, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_EQ, ENDS_IN_INTERVAL, EXISTS_DROP, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_ADD_LID, VECTOR_MUL_ASSOC, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO,
