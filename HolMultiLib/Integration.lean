structure INAT where
  SECOND_MEAN_VALUE_THEOREM_FULL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINAT [HolBase] (D : IntegrationDeps) (BINA : INA) (BINC : INC) (BINE : INE) (BINH : INH) (BINK : INK) (BINL : INL) (BINN : INN) (BINAL : INAL) (BINAM : INAM) (BINAR : INAR) (BINAS : INAS) : ExceptT String IO INAT := do
  -- @@SCOPE BEGIN
  let { CONTENT_EQ_0_1, .. } := BINA
