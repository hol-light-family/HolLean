              FIRST_X_ASSUM (MP_TAC o CONJUNCT2)] THEN
            MATCH_MP_TAC (← SET_RULE
             (← q r"s' SUBSET s /\ t' SUBSET t
            ==> s INTER t = {} ==> s' INTER t' = {}")) THEN
            REWRITE_TAC [INTER_SUBSET] THEN MATCH_MP_TAC SUBSET_CLOSURE THEN
            REWRITE_TAC [INTER_SUBSET]],
          EXISTS_TAC (← q r"interval[a:real^1,c]") THEN
          EXISTS_TAC (← q r"interval[c:real^1,b]") THEN
          ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
          MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
           [REWRITE_TAC [INTERVAL_NE_EMPTY_1] THEN
            RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1, IN_INTERVAL_1]) THEN
            ASM_REAL_ARITH_TAC,
            STRIP_TAC] THEN
          REPLICATE_TAC 2 (CONJ_TAC THENL [MESON_TAC [], ALL_TAC]) THEN
          ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                        INTERVAL_UPPERBOUND_NONEMPTY] THEN
          REWRITE_TAC [CONJ_ASSOC] THEN
          CONJ_TAC THENL [ALL_TAC, CONV_TAC (fun t => NORM_ARITH t)] THEN
          ONCE_REWRITE_TAC [← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
           [CONJ_TAC THEN
            W (MP_TAC o PART_MATCH lhand (← CONJUNCT1 INTERVAL_SUBSET_SEGMENT_1) o
              lhand o snd) THEN
            MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
            MATCH_MP_TAC SEGMENT_SUBSET_CONVEX THEN
            ASM_REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1],
            RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1, IN_INTERVAL_1]) THEN
            REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC]]],
      ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o BINDER_CONV)
      [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, SUBSET_INTER] THEN
    MAP_EVERY X_GEN_TAC
      [← q r"l:(real^1->bool)->real^1->bool", ← q r"r:(real^1->bool)->real^1->bool"] THEN
    DISCH_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"sum d (\k:real^1->bool. norm(((f:real^1->real^N)(interval_upperbound(l k)) -
                                 f(interval_lowerbound (l k)))) +
                            norm((f(interval_upperbound(r k)) -
                                 f(interval_lowerbound (r k)))))") THEN
    ASM_SIMP_TAC [SUM_LE] THEN ASM_SIMP_TAC [SUM_ADD] THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
    MP_TAC (← ISPECL [← q r"\k. norm((f:real^1->real^N)(interval_upperbound k) -
                    f(interval_lowerbound k))",
            ← q r"d:(real^1->bool)->bool"]
     (← GEN_REWRITE_RULE BINDER_CONV [SWAP_FORALL_THM] SUM_IMAGE_NONZERO)) THEN
    ASM_REWRITE_TAC [o_DEF] THEN DISCH_THEN (fun th =>
     W (MP_TAC o PART_MATCH (rand o rand) th o lhand o snd)) THEN
    REWRITE_TAC [] THEN
    (ANTS_TAC THENL
      [MAP_EVERY X_GEN_TAC [← q r"i:real^1->bool", ← q r"j:real^1->bool"] THEN
       REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
       DISCH_THEN (MP_TAC o AP_TERM (← q r"interior:(real^1->bool)->real^1->bool")) THEN
       SUBGOAL_THEN (← q r"interior i INTER interior j:real^1->bool = {}") MP_TAC THENL
        [ASM_MESON_TAC [division_of], REWRITE_TAC [IMP_IMP]] THEN
       DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
        (← q r"i INTER j = {} /\ i' = j'
       ==> (i' SUBSET i \/ i' = {}) /\ (j' SUBSET j \/ j' = {})
       ==> i' = {}"))) THEN
       ANTS_TAC THENL [ASM_MESON_TAC [SUBSET_INTERIOR], ALL_TAC] THEN
       MATCH_MP_TAC (← SET_RULE
        (← q r"~(s = {}) /\ (interior s = {} /\ ~(s = {}) ==> P)
       ==> interior s = {} ==> P")) THEN
       CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:real^1->bool")) THEN
       ASM_REWRITE_TAC [] THEN DISCH_THEN
        (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC o CONJUNCT2 o CONJUNCT2) THEN
       REPEAT (FIRST_X_ASSUM (CHOOSE_THEN STRIP_ASSUME_TAC)) THEN
       ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
                     NORM_EQ_0, VECTOR_SUB_EQ, INTERIOR_INTERVAL] THEN
       ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN STRIP_TAC THEN
       AP_TERM_TAC THEN REWRITE_TAC [← GSYM DROP_EQ] THEN ASM_REAL_ARITH_TAC,
       DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    MP_TAC (← ISPEC (← q r"f:real^1->real^N") HAS_BOUNDED_VARIATION_WORKS) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"s:real^1->bool")),
      DISCH_THEN (MP_TAC o SPEC (← q r"t:real^1->bool"))] THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MATCH_MP_TAC o CONJUNCT1) THENL
     [EXISTS_TAC (← q r"UNIONS(IMAGE (l:(real^1->bool)->real^1->bool) d)"),
      EXISTS_TAC (← q r"UNIONS(IMAGE (r:(real^1->bool)->real^1->bool) d)")] THEN
    (CONJ_TAC THENL
      [ASM_SIMP_TAC [DIVISION_OF, FINITE_IMAGE],
       REWRITE_TAC [UNIONS_IMAGE] THEN
       RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC []]) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    X_GEN_TAC (← q r"i:real^1->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"j:real^1->bool") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE I [division_of]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"i:real^1->bool", ← q r"j:real^1->bool"]) THEN
    ASM_REWRITE_TAC [] THEN (ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(s' SUBSET s \/ s' = {}) /\ (t' SUBSET t \/ t' = {})
    ==> s INTER t = {} ==> s' INTER t' = {}")) THEN
    ASM_MESON_TAC [SUBSET_INTERIOR]))

  let HAS_BOUNDED_VARIATION_ON_SPLIT ← prove
   r"!f:real^1->real^N s a.
        is_interval s
        ==> (f has_bounded_variation_on s <=>
             f has_bounded_variation_on {x | x IN s /\ drop x <= a} /\
             f has_bounded_variation_on {x | x IN s /\ a <= drop x})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE
       [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")]
       HAS_BOUNDED_VARIATION_ON_UNION)) THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
      ANTS_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC IS_INTERVAL_INTER THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [IS_INTERVAL_1, IN_ELIM_THM] THEN REAL_ARITH_TAC,
        REWRITE_TAC [← GSYM UNION_OVER_INTER] THEN REWRITE_TAC [UNION] THEN
        REWRITE_TAC [IN_ELIM_THM, REAL_LE_TOTAL, UNIV_GSPEC, INTER_UNIV]]])

  let VECTOR_VARIATION_SPLIT ← prove
   r"!f:real^1->real^N s a.
        is_interval s /\ f has_bounded_variation_on s
        ==> vector_variation {x | x IN s /\ drop x <= a} f +
            vector_variation {x | x IN s /\ a <= drop x} f =
            vector_variation s f"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"s = {x | x IN s /\ drop x <= a} UNION {x | x IN s /\ a <= drop x}")
    MP_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM] THEN
      MESON_TAC [REAL_LE_TOTAL],
      DISCH_THEN (fun th => GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [th])] THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [MATCH_MP_TAC VECTOR_VARIATION_LE_UNION THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        SET_TAC [],
        MATCH_MP_TAC (← SET_RULE (← q r"!t. s SUBSET t /\ t = {} ==> s = {}")) THEN
        EXISTS_TAC
         (← q r"interior {x:real^1 | x$1 <= a} INTER interior {x | x$1 >= a}") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE
           (← q r"s SUBSET s' /\ t SUBSET t' ==> s INTER t SUBSET s' INTER t'")) THEN
          CONJ_TAC THEN MATCH_MP_TAC SUBSET_INTERIOR THEN
          REWRITE_TAC [drop, real_ge] THEN SET_TAC [],
          REWRITE_TAC [INTERIOR_HALFSPACE_COMPONENT_LE,
                       INTERIOR_HALFSPACE_COMPONENT_GE] THEN
          REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_INTER, IN_ELIM_THM] THEN
          REAL_ARITH_TAC]],
      MATCH_MP_TAC VECTOR_VARIATION_UNION_LE THEN
      ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        CONJ_TAC THEN MATCH_MP_TAC IS_INTERVAL_INTER THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [IS_INTERVAL_1_CASES] THEN
        MESON_TAC [],
        CONJ_TAC THENL
         [REWRITE_TAC [← SET_RULE
           (← q r"{x | x IN s /\ P x} INTER {x | x IN s /\ Q x} = {} <=>
          (!x. P x /\ Q x ==> ~(x IN s))")] THEN
          REWRITE_TAC [REAL_LE_ANTISYM, ← GSYM LIFT_EQ, LIFT_DROP] THEN
          REWRITE_TAC [FORALL_UNWIND_THM2] THEN DISCH_TAC THEN
          SUBGOAL_THEN
           (← q r"{x | x IN s /\ drop x <= a} = {} \/
          {x | x IN s /\ a <= drop x} = {}")
           (fun th => DISJ_CASES_THEN SUBST1_TAC th THEN
                      REWRITE_TAC [CLOSURE_EMPTY] THEN SET_TAC []) THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"(!a b. a IN s /\ b IN t ==> F) ==> s = {} \/ t = {}")) THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_1]) THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"u:real^1") THEN
          MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"v:real^1") THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"lift a")) THEN
          ASM_REWRITE_TAC [IN_ELIM_THM, LIFT_DROP, REAL_LE_REFL] THEN
          CONV_TAC (fun t => TAUT t),
          CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
          SET_TAC []]]])

  let HAS_BOUNDED_VARIATION_ON_COMBINE ← prove
   r"!f:real^1->real^N a b c.
        drop a <= drop c /\ drop c <= drop b
        ==> (f has_bounded_variation_on interval[a,b] <=>
             f has_bounded_variation_on interval[a,c] /\
             f has_bounded_variation_on interval[c,b])"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"interval[a:real^1,b]", ← q r"drop c"]
          HAS_BOUNDED_VARIATION_ON_SPLIT) THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN DISCH_THEN SUBST1_TAC THEN
    BINOP_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTERVAL_1] THEN
    ASM_REAL_ARITH_TAC)

  let VECTOR_VARIATION_COMBINE ← prove
   r"!f:real^1->real^N a b c.
        drop a <= drop c /\
        drop c <= drop b /\
        f has_bounded_variation_on interval[a,b]
        ==> vector_variation (interval[a,c]) f +
            vector_variation (interval[c,b]) f =
            vector_variation (interval[a,b]) f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"interval[a:real^1,b]", ← q r"drop c"]
          VECTOR_VARIATION_SPLIT) THEN
    ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    BINOP_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_INTERVAL_1] THEN
    ASM_REAL_ARITH_TAC)

  pure { HAS_BOUNDED_VARIATION_ON_UNION, VECTOR_VARIATION_UNION_LE,
         HAS_BOUNDED_VARIATION_ON_SPLIT, VECTOR_VARIATION_SPLIT,
         HAS_BOUNDED_VARIATION_ON_COMBINE, VECTOR_VARIATION_COMBINE }

/- ------------------------------------------------------------------------- -/
/- Variation minus function is monotone; segment triangle inequality; the   -/
/- variation function itself has bounded variation.                         -/
/- (integration.ml 17948-18144)                                             -/
/- ------------------------------------------------------------------------- -/

structure INAZ where
  VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT : thm
  VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_RIGHT : thm
  VECTOR_VARIATION_SEGMENT_TRIANGLE : thm
  HAS_BOUNDED_VARIATION_ON_VECTOR_VARIATION : thm
  VECTOR_VARIATION_VECTOR_VARIATION : thm
  VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINAZ [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) (BINAY : INAY) : ExceptT String IO INAZ := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL, VECTOR_VARIATION_COMPARISON, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_GE_DROP_FUNCTION,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_POS_LE, .. } := BINAW
  let { VECTOR_VARIATION_ON_DIVISION, .. } := BINAX
  let { VECTOR_VARIATION_COMBINE, VECTOR_VARIATION_SPLIT, .. } := BINAY
  let { AND_FORALL_THM, CONJ_ASSOC, .. } := D.dv.dg.pt.cvx.core1
  let { IMP_CONJ, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, REAL_ADD_SYM, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LT, SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { SUM_LE, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_SUB, EXISTS_DROP, LIFT_SUB, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1,
        INTERVAL_SUBSET_IS_INTERVAL, IS_INTERVAL_1, .. } := D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, SEGMENT_SYM, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. }
        := D.dv.dg.pt.cvx
  let { CONVEX_INTER, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { SEGMENT_SUBSET_CONVEX, .. } := D.dv.dg.qconvex
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { IS_INTERVAL_1_CASES, IS_INTERVAL_INTER, .. } := D.qtopology
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT ← prove
   r"!f s a b.
        f has_bounded_variation_on s /\ is_interval s /\
        a IN s /\ b IN s /\ drop a <= drop b
        ==> vector_variation {x | x IN s /\ drop x <= drop a} f - drop(f a) <=
            vector_variation {x | x IN s /\ drop x <= drop b} f - drop(f b)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"{x | x IN s /\ drop x <= drop b}", ← q r"drop a"]
     VECTOR_VARIATION_SPLIT) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        MATCH_MP_TAC IS_INTERVAL_INTER THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [IS_INTERVAL_1_CASES] THEN
        REWRITE_TAC [EXISTS_DROP] THEN MESON_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        SET_TAC []],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN ASM_SIMP_TAC [← REAL_ARITH
     (← q r"a <= b ==> (x <= b /\ x <= a <=> x <= a)")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"v - a <= (v + c) - b <=> b - a <= c")] THEN
    MATCH_MP_TAC VECTOR_VARIATION_GE_DROP_FUNCTION THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      SET_TAC [],
      MATCH_MP_TAC SEGMENT_SUBSET_CONVEX THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ Q x /\ P x} = s INTER {x | P x /\ Q x}")] THEN
      MATCH_MP_TAC CONVEX_INTER THEN
      ASM_REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1] THEN
      REWRITE_TAC [IS_INTERVAL_1, IN_ELIM_THM] THEN REAL_ARITH_TAC])

  let VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_RIGHT ← prove
   r"!f s a b.
        f has_bounded_variation_on s /\ is_interval s /\
        a IN s /\ b IN s /\ drop a <= drop b
        ==> vector_variation {x | x IN s /\ drop b <= drop x} f - drop(f b) <=
            vector_variation {x | x IN s /\ drop a <= drop x} f - drop(f a)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1", ← q r"{x | x IN s /\ drop a <= drop x}", ← q r"drop b"]
     VECTOR_VARIATION_SPLIT) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        MATCH_MP_TAC IS_INTERVAL_INTER THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [IS_INTERVAL_1_CASES] THEN
        REWRITE_TAC [EXISTS_DROP] THEN MESON_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        SET_TAC []],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN ASM_SIMP_TAC [← REAL_ARITH
     (← q r"a <= b ==> (a <= x /\ b <= x <=> b <= x)")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"v - a <= (c + v) - b <=> b - a <= c")] THEN
    MATCH_MP_TAC VECTOR_VARIATION_GE_DROP_FUNCTION THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      SET_TAC [],
      MATCH_MP_TAC SEGMENT_SUBSET_CONVEX THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{x | x IN s /\ Q x /\ P x} = s INTER {x | P x /\ Q x}")] THEN
      MATCH_MP_TAC CONVEX_INTER THEN
      ASM_REWRITE_TAC [← GSYM IS_INTERVAL_CONVEX_1] THEN
      REWRITE_TAC [IS_INTERVAL_1, IN_ELIM_THM] THEN REAL_ARITH_TAC])

  let VECTOR_VARIATION_SEGMENT_TRIANGLE ← prove
   r"!f:real^1->real^N s a b c.
        f has_bounded_variation_on s /\
        is_interval s /\ a IN s /\ b IN s /\ c IN s
        ==> vector_variation (segment[a,c]) f <=
            vector_variation (segment[a,b]) f +
            vector_variation (segment[b,c]) f"
   (REPEAT STRIP_TAC THEN REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
     (← REAL_ARITH
       (← q r"drop a <= drop b /\ drop b <= drop c \/
      drop a <= drop c /\ drop c <= drop b \/
      drop b <= drop a /\ drop a <= drop c \/
      drop b <= drop c /\ drop c <= drop a \/
      drop c <= drop a /\ drop a <= drop b \/
      drop c <= drop b /\ drop b <= drop a")) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP REAL_LE_TRANS) THEN
    ASM_REWRITE_TAC [SEGMENT_1] THEN REWRITE_TAC [← GSYM SEGMENT_1] THEN
    ONCE_REWRITE_TAC [SEGMENT_SYM] THEN
    ASM_REWRITE_TAC [SEGMENT_1] THEN REWRITE_TAC [← GSYM SEGMENT_1] THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:real^1->real^N") o MATCH_MP
     (← ONCE_REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
          VECTOR_VARIATION_COMBINE)) THEN
    (ANTS_TAC THENL
      [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
       ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL],
       DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    REWRITE_TAC [REAL_ADD_SYM, REAL_LE_REFL] THEN
    REPEAT (MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y ==> x <= x + y")) ORELSE
           (MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y /\ x <= z ==> x <= y + z")) THEN
            CONJ_TAC)) THEN
    REWRITE_TAC [REAL_LE_REFL] THEN MATCH_MP_TAC VECTOR_VARIATION_POS_LE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
    ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL])

  let (HAS_BOUNDED_VARIATION_ON_VECTOR_VARIATION, VECTOR_VARIATION_VECTOR_VARIATION) ←
    CONJ_PAIR (← prove
   r"(!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> (\x. lift(vector_variation (interval [a,x]) f))
            has_bounded_variation_on interval[a,b]) /\
   (!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> vector_variation (interval[a,b])
                             (\x. lift(vector_variation (interval [a,x]) f)) =
            vector_variation (interval[a,b]) f)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN ASM_CASES_TAC
     (← q r"(f:real^1->real^N) has_bounded_variation_on interval[a,b]") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p /\ q) /\ (p ==> r) ==> p /\ q /\ r")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL] THEN
      X_GEN_TAC (← q r"d:(real^1->bool)->bool") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"b:real^1",
                        ← q r"d:(real^1->bool)->bool"] VECTOR_VARIATION_ON_DIVISION) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      STRIP_TAC THEN REWRITE_TAC [← GSYM LIFT_SUB, NORM_LIFT] THEN
      MP_TAC (← ISPECL
       [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"v:real^1", ← q r"u:real^1"]
       VECTOR_VARIATION_COMBINE) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [division_of]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o elc 1) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (ASSUME_TAC o CONJUNCT1) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1, SUBSET_INTERVAL_1]) THEN
      ANTS_TAC THENL
       [REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]),
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> abs((a + x) - a) <= x")) THEN
        MATCH_MP_TAC VECTOR_VARIATION_POS_LE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      DISCH_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_COMPARISON THEN
      ASM_REWRITE_TAC [dist, ← GSYM LIFT_SUB, NORM_LIFT] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"v:real^1", ← q r"u:real^1"]
       VECTOR_VARIATION_COMBINE) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
      ANTS_TAC THENL
       [REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]),
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= y ==> a <= abs(x - (x + y))")) THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ASM_REWRITE_TAC [SEGMENT_1, ← GSYM REAL_NOT_LT, SUBSET_REFL]] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC]))

  let VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE ← prove
   r"!f a b c d.
        f has_bounded_variation_on interval[a,b] /\
        interval[c,d] SUBSET interval[a,b] /\ ~(interval[c,d] = {})
        ==> vector_variation (interval[c,d]) f - drop(f d - f c) <=
            vector_variation (interval[a,b]) f - drop(f b - f a)"
   (REWRITE_TAC [SUBSET_INTERVAL_1, INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN
    REPEAT STRIP_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"drop(f c) - drop(f a) <= vector_variation(interval[a,c]) f /\
    drop(f b) - drop(f d) <= vector_variation(interval[d,b]) f")
    MP_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC VECTOR_VARIATION_GE_DROP_FUNCTION THEN
      ASM_REWRITE_TAC [SEGMENT_1, SUBSET_INTERVAL_1, INTERVAL_EQ_EMPTY_1] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [DROP_SUB] THEN
    MP_TAC (← ISPEC (← q r"f:real^1->real^1") VECTOR_VARIATION_COMBINE) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"a:real^1", ← q r"b:real^1", ← q r"d:real^1"] th) THEN
            MP_TAC (← SPECL [← q r"a:real^1", ← q r"d:real^1", ← q r"c:real^1"] th))) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      ASM_REAL_ARITH_TAC])

  pure { VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT,
         VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_RIGHT, VECTOR_VARIATION_SEGMENT_TRIANGLE,
         HAS_BOUNDED_VARIATION_ON_VECTOR_VARIATION, VECTOR_VARIATION_VECTOR_VARIATION,
         VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE }

/- ------------------------------------------------------------------------- -/
/- Monotone functions have bounded variation; their variation.              -/
/- (integration.ml 18145-18356)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBA where
  HAS_BOUNDED_VARIATION_NONTRIVIAL : thm
  INCREASING_BOUNDED_VARIATION_GEN : thm
  DECREASING_BOUNDED_VARIATION_GEN : thm
  INCREASING_BOUNDED_VARIATION : thm
  DECREASING_BOUNDED_VARIATION : thm
  INCREASING_VECTOR_VARIATION : thm
  DECREASING_VECTOR_VARIATION : thm
  VECTOR_VARIATION_ID : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBA [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINH : INH) (BINW : INW) (BINX : INX) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) : ExceptT String IO INBA := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_1,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { DIVISION_1_SORT, division_of, DIVISION_OF_SELF, DIVISION_OF_SUBSET,
        DIVISION_OF_UNION_SELF, FORALL_IN_DIVISION, FORALL_IN_DIVISION_NONEMPTY, .. } :=
        BINB
  let { OPERATIVE_DIVISION, .. } := BINH
  let { has_bounded_setvariation_on, .. } := BINW
  let { SET_VARIATION_ON_INTERVAL, .. } := BINX
  let { has_bounded_variation_on, vector_variation, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_NEG, VECTOR_VARIATION_NEG, VECTOR_VARIATION_ON_EMPTY, .. }
        := BINAW
  let { OPERATIVE_REAL_FUNCTION_ENDPOINT_DIFF, .. } := BINAX
  let { ARITH, CONJ_ASSOC, ETA_AX, FINITE_EMPTY, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_o, IMP_CONJ_ALT, IMP_IMP, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_FORALL,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_NEG2, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LT, SUBSET, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { num_INDUCTION, o_DEF, o_THM, sum, SUM_CLAUSES_NUMSEG, SUM_EQ, SUM_IMAGE,
        SUM_SUPERSET, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, DROP_SUB, ENDS_IN_INTERVAL, NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { drop, VECTOR_NEG_NEG, VECTOR_SUB_REFL, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, .. } := D.dv.dg.pt.cvx.top5
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { SUBSET_UNIONS, .. } := D.dv.dg.qsession
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { LT_CASES, MONOIDAL_REAL_ADD, SUP_INSERT_FINITE, .. } := D.qsession
  let { BOUNDED_NEGATIONS, INTERIOR_INTERVAL, .. } := D.qtopology
  let { NORM_REAL, .. } := D.qvec
  let { IMP_REWRITE_TAC, .. } := D
  -- @@SCOPE END

  let HAS_BOUNDED_VARIATION_NONTRIVIAL ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s <=>
        ?B. !d t.
                  d division_of t /\ t SUBSET s /\
                  (!k. k IN d ==> ~(interior k = {}))
                  ==> sum d (\k. norm(f(interval_upperbound k) -
                                      f (interval_lowerbound k))) <= B"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [has_bounded_setvariation_on] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC I [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN REWRITE_TAC [] THEN
    EQ_TAC THENL [MESON_TAC [], DISCH_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    ABBREV_TAC (← q r"d' = {k:real^1->bool | k IN d /\ ~(interior k = {})}") THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"d':(real^1->bool)->bool", ← q r"UNIONS d':real^1->bool"]) THEN
    ANTS_TAC THENL
     [EXPAND_TAC "d'" THEN SIMP_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
       [MATCH_MP_TAC DIVISION_OF_SUBSET THEN
        EXISTS_TAC (← q r"d:(real^1->bool)->bool") THEN
        REWRITE_TAC [SUBSET_RESTRICT] THEN ASM_MESON_TAC [DIVISION_OF_UNION_SELF],
        TRANS_TAC SUBSET_TRANS (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [] THEN
        TRANS_TAC SUBSET_TRANS (← q r"UNIONS d:real^1->bool") THEN CONJ_TAC THENL
         [MATCH_MP_TAC SUBSET_UNIONS THEN ASM SET_TAC [],
          ASM_MESON_TAC [division_of, SUBSET_REFL]]],
      MATCH_MP_TAC (← REAL_ARITH (← q r"y:real = x ==> x <= b ==> y <= b")) THEN
      MATCH_MP_TAC SUM_SUPERSET THEN EXPAND_TAC "d'" THEN
      REWRITE_TAC [SUBSET_RESTRICT, IN_ELIM_THM, ← TAUT
       (← q r"p /\ ~(p /\ ~q) ==> r <=> p ==> q ==> r")] THEN FIRST_ASSUM (fun th => tactic_of do
       pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REWRITE_TAC [INTERIOR_INTERVAL, INTERVAL_NE_EMPTY_1] THEN
      SIMP_TAC [INTERVAL_EQ_EMPTY_1, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      SIMP_TAC [REAL_LE_ANTISYM, DROP_EQ, VECTOR_SUB_REFL, NORM_0]])

  let INCREASING_BOUNDED_VARIATION_GEN ← prove
   r"!f s.
      bounded(IMAGE f s) /\
      (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f x) <= drop(f y))
       ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [HAS_BOUNDED_VARIATION_NONTRIVIAL] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [BOUNDED_POS]) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"&2 * B") THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"]
          DIVISION_1_SORT) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"t:num->real^1->bool"] THEN STRIP_TAC THEN
    EXPAND_TAC "d" THEN IMP_REWRITE_TAC [SUM_IMAGE] THEN
    CONJ_TAC THENL [REWRITE_TAC [o_DEF], ASM_MESON_TAC [LT_CASES]] THEN
    SUBGOAL_THEN
     (← q r"!k. k IN d
        ==> interval_lowerbound (k:real^1->bool) IN k INTER s /\
            interval_upperbound k IN k INTER s /\
            drop(interval_lowerbound k) <= drop(interval_upperbound k)")
    MP_TAC THENL
     [FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REWRITE_TAC [IN_INTER] THEN
      ASM_MESON_TAC [division_of, ENDS_IN_INTERVAL, SUBSET, INTERVAL_NE_EMPTY_1],
      EXPAND_TAC "d" THEN REWRITE_TAC [FORALL_IN_IMAGE, IN_INTER] THEN
      STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m. 1 <= m /\ m <= n
        ==> sum(1..m) (\i. norm(f(interval_upperbound(t i)) -
                                (f:real^1->real^1)(interval_lowerbound(t i))))
            <= drop(f(interval_upperbound(t m))) -
               drop(f(interval_lowerbound(t 1)))")
     (MP_TAC o SPEC (← q r"n:num"))
    THENL
     [MATCH_MP_TAC num_INDUCTION THEN
      SIMP_TAC [SUM_CLAUSES_NUMSEG, ARITH] THEN
      X_GEN_TAC (← q r"m:num") THEN
      ASM_CASES_TAC (← q r"m = 0") THEN ASM_REWRITE_TAC [ARITH, SUM_CLAUSES_NUMSEG] THENL
       [DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> &0 + x <= y")) THEN
        REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"y <= x ==> abs(x - y) = x - y")) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [IN_NUMSEG, LE_REFL],
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"b + x <= y ==> s <= b ==> s + x <= y")) THEN
        REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"um <= ls /\ ls <= us ==> (um - l1) + abs(us - ls) <= us - l1")) THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC, ASM_MESON_TAC [IN_NUMSEG]] THEN
        REPEAT (CONJ_TAC THENL
         [ASM_MESON_TAC [IN_NUMSEG, LE_1, ← ARITH_RULE (← q r"SUC m <= n ==> m <= n")],
         ALL_TAC]) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m:num", ← q r"SUC m"]) THEN
        REWRITE_TAC [IN_NUMSEG] THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN (MATCH_MP_TAC o CONJUNCT2)] THEN
        ASM_MESON_TAC [IN_NUMSEG, LE_1, ← ARITH_RULE (← q r"SUC m <= n ==> m <= n")]],
      ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_REWRITE_TAC [SUM_CLAUSES_NUMSEG, ARITH] THEN ASM_REAL_ARITH_TAC,
        ASM_SIMP_TAC [LE_1, LE_REFL]] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"(norm x = abs(drop x) /\ norm y = abs(drop y)) /\
      (norm(x) <= B /\ norm(y) <= B)
      ==> drop x - drop y <= &2 * B")) THEN
      CONJ_TAC THENL [REWRITE_TAC [NORM_REAL, ← GSYM drop], ALL_TAC] THEN
      CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [IN_NUMSEG, LE_REFL, LE_1]])

  let DECREASING_BOUNDED_VARIATION_GEN ← prove
   r"!f s.
      bounded(IMAGE f s) /\
      (!x y. x IN s /\ y IN s /\ drop x <= drop y ==> drop(f y) <= drop(f x))
       ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"(--) o (f:real^1->real^1)", ← q r"s:real^1->bool"]
          INCREASING_BOUNDED_VARIATION_GEN) THEN
    ASM_REWRITE_TAC [DROP_NEG, o_THM, REAL_LE_NEG2] THEN
    ASM_SIMP_TAC [BOUNDED_NEGATIONS, IMAGE_o] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_NEG) THEN
    REWRITE_TAC [o_DEF, VECTOR_NEG_NEG, ETA_AX])

  let INCREASING_BOUNDED_VARIATION ← prove
   r"!f a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> f has_bounded_variation_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INCREASING_BOUNDED_VARIATION_GEN THEN
    ASM_REWRITE_TAC [bounded, FORALL_IN_IMAGE] THEN EXISTS_TAC
     (← q r"max (norm((f:real^1->real^1) a)) (norm((f:real^1->real^1) b))") THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"a:real^1", ← q r"x:real^1"] th) THEN
            MP_TAC (← SPECL [← q r"x:real^1", ← q r"b:real^1"] th))) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERVAL_1]) THEN
    REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN REAL_ARITH_TAC)

  let DECREASING_BOUNDED_VARIATION ← prove
   r"!f a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x))
         ==> f has_bounded_variation_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o BINDER_CONV o RAND_CONV)
     [← GSYM REAL_LE_NEG2] THEN
    REWRITE_TAC [← GSYM DROP_NEG] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INCREASING_BOUNDED_VARIATION) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_ON_NEG) THEN
    REWRITE_TAC [VECTOR_NEG_NEG, ETA_AX])

  let INCREASING_VECTOR_VARIATION ← prove
   r"!f a b.
        ~(interval[a,b] = {}) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> vector_variation (interval[a,b]) f = drop(f b) - drop(f a)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [vector_variation] THEN
    REWRITE_TAC [SET_VARIATION_ON_INTERVAL] THEN
    SUBGOAL_THEN
     (← q r"{sum d (\k. norm (f (interval_upperbound k) - f (interval_lowerbound k))) |
     d division_of interval[a:real^1,b]} =
    {drop (f b) - drop(f a)}")
     (fun th => SIMP_TAC [SUP_INSERT_FINITE, FINITE_EMPTY, th]) THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"(?x. P x) /\ (!x. P x ==> f x = a) ==> {f x | P x} = {a}")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_SELF], ALL_TAC] THEN
    MP_TAC (← MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"a /\ b /\ c ==> d <=> b ==> a /\ c ==> d")]
     OPERATIVE_DIVISION) (← SPEC (← q r"drop o (f:real^1->real^1)")
        OPERATIVE_REAL_FUNCTION_ENDPOINT_DIFF)) THEN
     MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [← GSYM sum, MONOIDAL_REAL_ADD] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT]) THEN
    ASM_SIMP_TAC [o_THM, INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC SUM_EQ THEN REWRITE_TAC [NORM_REAL, ← GSYM drop] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(interval[u:real^1,v] = {})") ASSUME_TAC THENL
     [ASM_MESON_TAC [division_of], ALL_TAC] THEN
     RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT]) THEN
    ASM_SIMP_TAC [DROP_SUB, INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y ==> abs(y - x) = y - x")) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
    SUBGOAL_THEN (← q r"interval[u:real^1,v] SUBSET interval[a,b]") MP_TAC THENL
     [ASM_MESON_TAC [division_of], REWRITE_TAC [SUBSET_INTERVAL_1]] THEN
    ASM_REAL_ARITH_TAC)

  let DECREASING_VECTOR_VARIATION ← prove
   r"!f a b.
        ~(interval[a,b] = {}) /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x))
        ==> vector_variation (interval[a,b]) f = drop(f a) - drop(f b)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC
     (LAND_CONV o RAND_CONV o BINDER_CONV o BINDER_CONV o RAND_CONV)
     [← GSYM REAL_LE_NEG2] THEN
    REWRITE_TAC [← GSYM DROP_NEG] THEN
    DISCH_THEN (MP_TAC o MATCH_MP INCREASING_VECTOR_VARIATION) THEN
    SIMP_TAC [VECTOR_VARIATION_NEG, DROP_NEG] THEN
    DISCH_TAC THEN REAL_ARITH_TAC)

  let VECTOR_VARIATION_ID ← prove
   r"!a b. vector_variation (interval[a,b]) (\x. x) =
         if interval[a,b] = {} then &0 else drop b - drop a"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [VECTOR_VARIATION_ON_EMPTY] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) INCREASING_VECTOR_VARIATION o
      lhand o snd) THEN
    ASM_SIMP_TAC [])

  pure { HAS_BOUNDED_VARIATION_NONTRIVIAL, INCREASING_BOUNDED_VARIATION_GEN,
         DECREASING_BOUNDED_VARIATION_GEN, INCREASING_BOUNDED_VARIATION,
         DECREASING_BOUNDED_VARIATION, INCREASING_VECTOR_VARIATION,
         DECREASING_VECTOR_VARIATION, VECTOR_VARIATION_ID }

/- ------------------------------------------------------------------------- -/
/- Variation under translation, affinity and reflection; Darboux            -/
/- decomposition into monotone functions.  (integration.ml 18357-18599)     -/
/- ------------------------------------------------------------------------- -/

structure INBB where
  HAS_BOUNDED_VARIATION_TRANSLATION2_EQ : thm
  VECTOR_VARIATION_TRANSLATION2 : thm
  HAS_BOUNDED_VARIATION_AFFINITY2_EQ : thm
  VECTOR_VARIATION_AFFINITY2 : thm
  HAS_BOUNDED_VARIATION_AFFINITY_EQ : thm
  VECTOR_VARIATION_AFFINITY : thm
  HAS_BOUNDED_VARIATION_TRANSLATION_EQ : thm
  VECTOR_VARIATION_TRANSLATION_ALT : thm
  HAS_BOUNDED_VARIATION_TRANSLATION_EQ_INTERVAL : thm
  VECTOR_VARIATION_TRANSLATION_INTERVAL : thm
  HAS_BOUNDED_VARIATION_TRANSLATION : thm
  HAS_BOUNDED_VARIATION_REFLECT2_EQ : thm
  VECTOR_VARIATION_REFLECT2 : thm
  HAS_BOUNDED_VARIATION_REFLECT_EQ : thm
  VECTOR_VARIATION_REFLECT : thm
  HAS_BOUNDED_VARIATION_REFLECT_EQ_INTERVAL : thm
  VECTOR_VARIATION_REFLECT_INTERVAL : thm
  HAS_BOUNDED_VARIATION_DARBOUX_GEN : thm
  HAS_BOUNDED_VARIATION_DARBOUX : thm
  HAS_BOUNDED_VARIATION_DARBOUX_STRICT : thm
  HAS_BOUNDED_VARIATION_ON_REFLECT : thm
  HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBB [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) (BINAV : INAV) (BINAW : INAW) (BINAZ : INAZ) (BINBA : INBA) : ExceptT String IO INBB := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_1, INTERVAL_UPPERBOUND_1, .. } := BINA
  let { division_of, DIVISION_OF_AFFINITY, DIVISION_OF_REFLECT, DIVISION_OF_TRANSLATION,
        FORALL_IN_DIVISION, .. } := BINB
  let { has_bounded_setvariation_on, .. } := BINW
  let { has_bounded_variation_on, VARIATION_EQUAL_LEMMA, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_CONST, HAS_BOUNDED_VARIATION_ON_SUB,
        HAS_BOUNDED_VARIATION_ON_SUBSET, VECTOR_VARIATION_CONST, VECTOR_VARIATION_MONOTONE,
        .. } := BINAW
  let { VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE,
        VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT, .. } := BINAZ
  let { INCREASING_BOUNDED_VARIATION, .. } := BINBA
  let { AND_FORALL_THM, ETA_AX, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, IMAGE_o, IMP_CONJ, .. } :=
        D.dv.dg.pt.cvx.core2
  let { I_THM, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_INV_EQ_0, REAL_LE_LT, REAL_LE_NEG2, REAL_LE_TRANS, REAL_LT_IMP_LE, .. } :=
        D.dv.dg.pt.cvx.core4
  let { SUBSET, SUBSET_RESTRICT, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_EQ, SUM_IMAGE, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_EQ, DROP_SUB, LIFT_DROP, .. } := D.dv.dg.pt.cvx.vec2
  let { VECTOR_MUL_LZERO, VECTOR_NEG_NEG, .. } := D.dv.dg.pt.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH_TAC, REAL_ARITH, SET_TAC,
        VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.dv.dg.pt.cvx
  let { INJECTIVE_IMAGE, REAL_LET_ADD2, .. } := D.dv.dg.pt.qses
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { IMAGE_I, .. } := D.qsession
  let { AFFINITY_INVERSES, IMAGE_AFFINITY_INTERVAL, INTERVAL_TRANSLATION, .. } :=
        D.qtopology
  let { REFLECT_INTERVAL, .. } := D.qvec
  -- @@SCOPE END

  let (HAS_BOUNDED_VARIATION_TRANSLATION2_EQ, VECTOR_VARIATION_TRANSLATION2) ←
    CONJ_PAIR (← prove
   r"(!a f:real^1->real^N s.
        (\x. f(a + x)) has_bounded_variation_on (IMAGE (\x. --a + x) s) <=>
        f has_bounded_variation_on s) /\
   (!a f:real^1->real^N s.
        vector_variation (IMAGE (\x. --a + x) s) (\x. f(a + x)) =
        vector_variation s f)"
   (GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"a:real^1") THEN
    MATCH_MP_TAC VARIATION_EQUAL_LEMMA THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL [VECTOR_ARITH_TAC, ALL_TAC] THEN
    SIMP_TAC [DIVISION_OF_TRANSLATION, ← GSYM INTERVAL_TRANSLATION]))

  let (HAS_BOUNDED_VARIATION_AFFINITY2_EQ, VECTOR_VARIATION_AFFINITY2) ←
    CONJ_PAIR (← prove
   r"(!m c f:real^1->real^N s.
        (\x. f (m % x + c)) has_bounded_variation_on
        IMAGE (\x. inv m % x + --(inv m % c)) s <=>
        m = &0 \/ f has_bounded_variation_on s) /\
   (!m c f:real^1->real^N s.
        vector_variation (IMAGE (\x. inv m % x + --(inv m % c)) s)
                         (\x. f (m % x + c)) =
        if m = &0 then &0 else vector_variation s f)"
   (GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"m:real") THEN
    GEN_REWRITE_TAC I [AND_FORALL_THM] THEN X_GEN_TAC (← q r"c:real^1") THEN
    ASM_CASES_TAC (← q r"m = &0") THEN ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, HAS_BOUNDED_VARIATION_ON_CONST] THEN
      REWRITE_TAC [VECTOR_VARIATION_CONST],
      MATCH_MP_TAC VARIATION_EQUAL_LEMMA THEN
      ASM_SIMP_TAC [← REWRITE_RULE [FUN_EQ_THM, o_DEF] AFFINITY_INVERSES, I_THM] THEN
      ASM_SIMP_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      ASM_REWRITE_TAC [DIVISION_OF_AFFINITY, REAL_INV_EQ_0] THEN
      MESON_TAC []]))

  let (HAS_BOUNDED_VARIATION_AFFINITY_EQ, VECTOR_VARIATION_AFFINITY) ←
    CONJ_PAIR (← prove
   r"(!m c f:real^1->real^N s.
        (\x. f(m % x + c)) has_bounded_variation_on s <=>
        m = &0 \/ f has_bounded_variation_on (IMAGE (\x. m % x + c) s)) /\
   (!m c f:real^1->real^N s.
        vector_variation s (\x. f(m % x + c)) =
        if m = &0 then &0 else vector_variation (IMAGE (\x. m % x + c) s) f)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"m = &0") THEN
    ASM_REWRITE_TAC [VECTOR_MUL_LZERO, HAS_BOUNDED_VARIATION_ON_CONST,
                     VECTOR_VARIATION_CONST] THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"m:real", ← q r"c:real^1", ← q r"f:real^1->real^N",
                        ← q r"IMAGE (\x:real^1. m % x + c) s"]
            HAS_BOUNDED_VARIATION_AFFINITY2_EQ),
      MP_TAC (← ISPECL [← q r"m:real", ← q r"c:real^1", ← q r"f:real^1->real^N",
                        ← q r"IMAGE (\x:real^1. m % x + c) s"]
            VECTOR_VARIATION_AFFINITY2)] THEN
    ASM_SIMP_TAC [AFFINITY_INVERSES, ← GSYM IMAGE_o, IMAGE_I]))

  let (HAS_BOUNDED_VARIATION_TRANSLATION_EQ, VECTOR_VARIATION_TRANSLATION_ALT) ←
    CONJ_PAIR (← prove
   r"(!a f:real^1->real^N s.
        (\x. f(a + x)) has_bounded_variation_on s <=>
        f has_bounded_variation_on (IMAGE (\x. a + x) s)) /\
   (!a f:real^1->real^N s.
        vector_variation s (\x. f(a + x)) =
        vector_variation (IMAGE (\x. a + x) s) f)"
   (REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"a:real^1", ← q r"f:real^1->real^N",
                        ← q r"IMAGE (\x:real^1. a + x) s"]
            HAS_BOUNDED_VARIATION_TRANSLATION2_EQ),
      MP_TAC (← ISPECL [← q r"a:real^1", ← q r"f:real^1->real^N",
                        ← q r"IMAGE (\x:real^1. a + x) s"]
            VECTOR_VARIATION_TRANSLATION2)] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [IMAGE_ID, ← VECTOR_ARITH (← q r"--a + a + x:real^N = x"),
                 ← VECTOR_ARITH (← q r"a + --a + x:real^N = x")]))

  let (HAS_BOUNDED_VARIATION_TRANSLATION_EQ_INTERVAL,
       VECTOR_VARIATION_TRANSLATION_INTERVAL) ←
    CONJ_PAIR (← prove
   r"(!a f:real^1->real^N u v.
        (\x. f(a + x)) has_bounded_variation_on interval[u,v] <=>
        f has_bounded_variation_on interval[a+u,a+v]) /\
   (!a f:real^1->real^N u v.
        vector_variation (interval[u,v]) (\x. f(a + x)) =
        vector_variation (interval[a+u,a+v]) f)"
   (REWRITE_TAC [INTERVAL_TRANSLATION, HAS_BOUNDED_VARIATION_TRANSLATION_EQ,
                 VECTOR_VARIATION_TRANSLATION_ALT]))

  let HAS_BOUNDED_VARIATION_TRANSLATION ← prove
   r"!f:real^1->real^N s a.
        f has_bounded_variation_on s
        ==> (\x. f(a + x)) has_bounded_variation_on (IMAGE (\x. --a + x) s)"
   (REWRITE_TAC [HAS_BOUNDED_VARIATION_TRANSLATION2_EQ])

  let (HAS_BOUNDED_VARIATION_REFLECT2_EQ, VECTOR_VARIATION_REFLECT2) ←
    CONJ_PAIR (← prove
   r"(!f:real^1->real^N s.
        (\x. f(--x)) has_bounded_variation_on (IMAGE (--) s) <=>
        f has_bounded_variation_on s) /\
   (!f:real^1->real^N s.
        vector_variation (IMAGE (--) s) (\x. f(--x)) =
        vector_variation s f)"
   (MATCH_MP_TAC VARIATION_EQUAL_LEMMA THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL [VECTOR_ARITH_TAC, ALL_TAC] THEN
    SIMP_TAC [DIVISION_OF_REFLECT, REFLECT_INTERVAL]))

  let (HAS_BOUNDED_VARIATION_REFLECT_EQ, VECTOR_VARIATION_REFLECT) ←
    CONJ_PAIR (← prove
   r"(!f:real^1->real^N s.
        (\x. f(--x)) has_bounded_variation_on s <=>
        f has_bounded_variation_on (IMAGE (--) s)) /\
   (!f:real^1->real^N s.
        vector_variation s (\x. f(--x)) =
        vector_variation (IMAGE (--) s) f)"
   (REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"IMAGE (--) (s:real^1->bool)"]
            HAS_BOUNDED_VARIATION_REFLECT2_EQ),
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"IMAGE (--) (s:real^1->bool)"]
            VECTOR_VARIATION_REFLECT2)] THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
    REWRITE_TAC [IMAGE_ID, VECTOR_NEG_NEG]))

  let (HAS_BOUNDED_VARIATION_REFLECT_EQ_INTERVAL,
       VECTOR_VARIATION_REFLECT_INTERVAL) ←
    CONJ_PAIR (← prove
   r"(!f:real^1->real^N u v.
        (\x. f(--x)) has_bounded_variation_on interval[u,v] <=>
        f has_bounded_variation_on interval[--v,--u]) /\
   (!f:real^1->real^N u v.
        vector_variation (interval[u,v]) (\x. f(--x)) =
        vector_variation (interval[--v,--u]) f)"
   (REWRITE_TAC [← GSYM REFLECT_INTERVAL, HAS_BOUNDED_VARIATION_REFLECT_EQ,
                 VECTOR_VARIATION_REFLECT]))

  let HAS_BOUNDED_VARIATION_DARBOUX_GEN ← prove
   r"!f s. is_interval s /\ f has_bounded_variation_on s
         ==> ?g h. (!x y. x IN s /\ y IN s /\ drop x <= drop y
                          ==> drop(g x) <= drop(g y)) /\
                   (!x y. x IN s /\ y IN s /\ drop x <= drop y
                          ==> drop(h x) <= drop(h y)) /\
                   (!x. f x = g x - h x)"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x. lift(vector_variation {a | a IN s /\ drop a <= drop x}
                               (f:real^1->real^1))",
      ← q r"\x. lift(vector_variation {a | a IN s /\ drop a <= drop x} f) - f x"] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"a - (a - x):real^1 = x")] THEN
    REWRITE_TAC [LIFT_DROP, DROP_SUB] THEN CONJ_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THENL
     [MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_RESTRICT],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [REAL_LE_TRANS]],
      MATCH_MP_TAC VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE_LEFT THEN
      ASM_REWRITE_TAC []])

  let HAS_BOUNDED_VARIATION_DARBOUX ← prove
   r"!f a b.
     f has_bounded_variation_on interval[a,b] <=>
     ?g h. (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
                  ==> drop(g x) <= drop(g y)) /\
           (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
                  ==> drop(h x) <= drop(h y)) /\
           (!x. f x = g x - h x)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [MAP_EVERY EXISTS_TAC
       [← q r"\x:real^1. lift(vector_variation (interval[a,x]) (f:real^1->real^1))",
        ← q r"\x:real^1. lift(vector_variation (interval[a,x]) f) - f x"] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"a - (a - x):real^1 = x")] THEN
      REWRITE_TAC [LIFT_DROP, DROP_SUB] THEN REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_MONOTONE,
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"!x. a - (b - x) <= c - (d - x) ==> a - b <= c - d")) THEN
        EXISTS_TAC (← q r"drop(f(a:real^1))") THEN
        REWRITE_TAC [← GSYM DROP_SUB] THEN
        MATCH_MP_TAC VECTOR_VARIATION_MINUS_FUNCTION_MONOTONE] THEN
      (CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           HAS_BOUNDED_VARIATION_ON_SUBSET)),
          ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1]) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1, INTERVAL_EQ_EMPTY_1] THEN
        ASM_REAL_ARITH_TAC),
      GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUB THEN
      CONJ_TAC THEN MATCH_MP_TAC INCREASING_BOUNDED_VARIATION THEN
      ASM_REWRITE_TAC []])

  let HAS_BOUNDED_VARIATION_DARBOUX_STRICT ← prove
   r"!f a b.
     f has_bounded_variation_on interval[a,b] <=>
     ?g h. (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x < drop y
                  ==> drop(g x) < drop(g y)) /\
           (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x < drop y
                  ==> drop(h x) < drop(h y)) /\
           (!x. f x = g x - h x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_BOUNDED_VARIATION_DARBOUX] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
    STRIP_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"\x:real^1. g x + x", ← q r"\x:real^1. h x + x"] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"(a + x) - (b + x):real^1 = a - b")] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [DROP_ADD] THEN
      MATCH_MP_TAC REAL_LET_ADD2 THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [REAL_LT_IMP_LE],
      MAP_EVERY EXISTS_TAC [← q r"g:real^1->real^1", ← q r"h:real^1->real^1"] THEN
      ASM_REWRITE_TAC [REAL_LE_LT, DROP_EQ] THEN ASM_MESON_TAC []])

  let HAS_BOUNDED_VARIATION_ON_REFLECT ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on IMAGE (--) s
        ==> (\x. f(--x)) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [has_bounded_variation_on] THEN
    REWRITE_TAC [has_bounded_setvariation_on] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"IMAGE (IMAGE (--)) (d:(real^1->bool)->bool)",
      ← q r"IMAGE (--) (t:real^1->bool)"]) THEN
    ASM_SIMP_TAC [DIVISION_OF_REFLECT] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [← GSYM SUBSET] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) SUM_IMAGE o lhand o lhand o snd) THEN
    ANTS_TAC THENL
     [MESON_TAC [← VECTOR_ARITH (← q r"--x:real^N = --y <=> x = y"), INJECTIVE_IMAGE],
      DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x <= d ==> y <= d")) THEN
      MATCH_MP_TAC SUM_EQ THEN FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"drop u <= drop v") ASSUME_TAC THENL
       [ASM_MESON_TAC [INTERVAL_NE_EMPTY_1, division_of], ALL_TAC] THEN
      ASM_REWRITE_TAC [o_THM, REFLECT_INTERVAL] THEN
      ASM_SIMP_TAC [INTERVAL_UPPERBOUND_1, INTERVAL_LOWERBOUND_1,
                    DROP_NEG, REAL_LE_NEG2] THEN
      NORM_ARITH_TAC])

  let HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[--b,--a]
        ==> (\x. f(--x)) has_bounded_variation_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_REFLECT THEN
    ASM_REWRITE_TAC [REFLECT_INTERVAL])

  pure { HAS_BOUNDED_VARIATION_TRANSLATION2_EQ, VECTOR_VARIATION_TRANSLATION2,
         HAS_BOUNDED_VARIATION_AFFINITY2_EQ, VECTOR_VARIATION_AFFINITY2,
         HAS_BOUNDED_VARIATION_AFFINITY_EQ, VECTOR_VARIATION_AFFINITY,
         HAS_BOUNDED_VARIATION_TRANSLATION_EQ, VECTOR_VARIATION_TRANSLATION_ALT,
         HAS_BOUNDED_VARIATION_TRANSLATION_EQ_INTERVAL,
         VECTOR_VARIATION_TRANSLATION_INTERVAL, HAS_BOUNDED_VARIATION_TRANSLATION,
         HAS_BOUNDED_VARIATION_REFLECT2_EQ, VECTOR_VARIATION_REFLECT2,
         HAS_BOUNDED_VARIATION_REFLECT_EQ, VECTOR_VARIATION_REFLECT,
         HAS_BOUNDED_VARIATION_REFLECT_EQ_INTERVAL, VECTOR_VARIATION_REFLECT_INTERVAL,
         HAS_BOUNDED_VARIATION_DARBOUX_GEN, HAS_BOUNDED_VARIATION_DARBOUX,
         HAS_BOUNDED_VARIATION_DARBOUX_STRICT, HAS_BOUNDED_VARIATION_ON_REFLECT,
         HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Variation of compositions with monotone maps and homeomorphisms.         -/
/- (integration.ml 18600-18950)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBC where
  HAS_BOUNDED_VARIATION_COMPOSE_INCREASING : thm
  VECTOR_VARIATION_COMPOSE_INCREASING : thm
  HAS_BOUNDED_VARIATION_COMPOSE_DECREASING : thm
  VECTOR_VARIATION_COMPOSE_DECREASING : thm
  HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN : thm
  VECTOR_VARIATION_COMPOSE_INCREASING_GEN : thm
  HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM : thm
  HAS_BOUNDED_VARIATION_COMPOSE_INJECTIVE : thm
  VECTOR_VARIATION_COMPOSE_HOMEOMORPHISM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBC [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINAV : INAV) (BINAW : INAW) (BINBB : INBB) : ExceptT String IO INBC := do
  -- @@SCOPE BEGIN
  let { INTERVAL_LOWERBOUND_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_1,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { HAS_BOUNDED_VARIATION_ON_EQ, HAS_BOUNDED_VARIATION_WORKS,
        HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL,
        HAS_BOUNDED_VECTOR_VARIATION_ON_SUBINTERVALS, VECTOR_VARIATION_EQ, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_EMPTY, HAS_BOUNDED_VARIATION_ON_SUBSET,
        VECTOR_VARIATION_MONOTONE, VECTOR_VARIATION_ON_EMPTY, VECTOR_VARIATION_POS_LE, .. }
        := BINAW
  let { HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL, HAS_BOUNDED_VARIATION_REFLECT2_EQ,
        HAS_BOUNDED_VARIATION_REFLECT_EQ, VECTOR_VARIATION_REFLECT,
        VECTOR_VARIATION_REFLECT_INTERVAL, .. } := BINBB
  let { AND_FORALL_THM, CONJ_ASSOC, DE_MORGAN_THM, EMPTY_SUBSET, ETA_AX, FINITE_IMAGE, .. }
        := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_ID, IMAGE_o, IMP_CONJ, IMP_IMP, .. } :=
        D.dv.dg.pt.cvx.core2
  let { IN_IMAGE, MONO_OR, .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_ANTISYM, REAL_LE_LT, REAL_LE_NEG2, REAL_LE_TRANS,
        REAL_LT_NEG2, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_NOT_LE, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, SUM_EQ, SWAP_EXISTS_THM, UNIONS_SUBSET, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_EQ, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT, LIFT_DROP, NORM_EQ_0, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { VECTOR_NEG_NEG, VECTOR_SUB_EQ, .. } := D.dv.dg.pt.cvx.vec4
  let { CONNECTED_CONTINUOUS_IMAGE, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_NEG, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, INTERVAL_SUBSET_SEGMENT_1,
        LINEAR_CONTINUOUS_ON, .. } := D.dv.dg.pt.cvx.top4
  let { homeomorphism, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.dv.dg.pt.cvx
  let { REAL_WLOG_LT, .. } := D.dv.dg.pt.qses
  let { DROP_NEG, LINEAR_NEGATION, .. } := D.dv.dg.pt.qvec
  let { CONVEX_CONTAINS_SEGMENT, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { IS_INTERVAL_CONNECTED_1, .. } := D.dv.dg.qconvex
  let { DISJOINT_INTERVAL_1, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { HOMEOMORPHISM_1D_IMP_MONOTONIC, HOMEOMORPHISM_INTO_1D, IS_INTERVAL_PATH_CONNECTED_1,
        .. } := D.qpaths
  let { SUM_IMAGE_NONZERO, .. } := D.qsession
  let { EQ_INTERVAL, INTERIOR_INTERVAL, IS_INTERVAL_REFLECT, .. } := D.qtopology
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let (HAS_BOUNDED_VARIATION_COMPOSE_INCREASING, VECTOR_VARIATION_COMPOSE_INCREASING) ←
    CONJ_PAIR (← prove
   r"(!f g:real^1->real^N a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        g has_bounded_variation_on interval[f a,f b]
        ==> (g o f) has_bounded_variation_on interval[a,b]) /\
   (!f g:real^1->real^N a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        g has_bounded_variation_on interval[f a,f b]
        ==> vector_variation (interval[a,b]) (g o f)
            <= vector_variation (interval[f a,f b]) g)"
   (REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [HAS_BOUNDED_VECTOR_VARIATION_ON_INTERVAL] THEN
    X_GEN_TAC (← q r"d:(real^1->bool)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_WORKS) THEN
    ABBREV_TAC
     (← q r"D = IMAGE (\k:real^1->bool.
                   interval[(f:real^1->real^1) (interval_lowerbound k),
                   f(interval_upperbound k)]) d") THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"D:(real^1->bool)->bool", ← q r"UNIONS D:real^1->bool"] o CONJUNCT1) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [division_of, UNIONS_SUBSET, ← GSYM CONJ_ASSOC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [FINITE_IMAGE, division_of], ALL_TAC] THEN
      EXPAND_TAC "D" THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REPEAT CONJ_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THENL
       [REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE (← q r"s IN t ==> s SUBSET UNIONS t")) THEN
          REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"interval[u:real^1,v]") THEN
          ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                        INTERVAL_UPPERBOUND_NONEMPTY],
          REWRITE_TAC [INTERVAL_NE_EMPTY_1] THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [← GSYM INTERVAL_NE_EMPTY_1] THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o
                        elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (fun th => tactic_of do
            pure (STRIP_ASSUME_TAC (← REWRITE_RULE [SUBSET] th))) THEN
          CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL],
          MESON_TAC []],
        FIRST_ASSUM (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
        SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(x:real^1) IN interval[a,b] /\ y IN interval[a,b] /\
                    (u:real^1) IN interval[a,b] /\ v IN interval[a,b]")
        STRIP_ASSUME_TAC THENL
         [FIRST_ASSUM (MP_TAC o SPEC (← q r"interval[x:real^1,y]") o
                      elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o
                      elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          ASM_REWRITE_TAC [] THEN
          REPEAT (DISCH_THEN (fun th => tactic_of do
            pure (STRIP_ASSUME_TAC (← REWRITE_RULE [SUBSET]
              (← CONJUNCT1 th))))) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL],
          FIRST_ASSUM (MP_TAC o elc 2 o REWRITE_RULE [division_of]) THEN
          DISCH_THEN (MP_TAC o SPECL
             [← q r"interval[u:real^1,v]", ← q r"interval[x:real^1,y]"]) THEN
          ASM_REWRITE_TAC [INTERIOR_INTERVAL, DISJOINT_INTERVAL_1] THEN
          ASM_REWRITE_TAC [EQ_INTERVAL] THEN
          ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          REPEAT (MATCH_MP_TAC MONO_OR THEN CONJ_TAC) THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
        SUBGOAL_THEN (← q r"(u:real^1) IN interval[a,b] /\ v IN interval[a,b]")
        MP_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o
                        elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (fun th => tactic_of do
            pure (STRIP_ASSUME_TAC (← REWRITE_RULE [SUBSET] th))) THEN
          CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL],
          REWRITE_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN STRIP_TAC THEN
          DISJ2_TAC THEN REPEAT CONJ_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [IN_INTERVAL_1] THEN ASM_REAL_ARITH_TAC]],
      EXPAND_TAC "D" THEN
      W (MP_TAC o PART_MATCH (lhs o rand) SUM_IMAGE_NONZERO o
        lhand o lhand o snd) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ASM_MESON_TAC [FINITE_IMAGE, division_of], ALL_TAC] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
        SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
        SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(x:real^1) IN interval[a,b] /\ y IN interval[a,b] /\
                    (u:real^1) IN interval[a,b] /\ v IN interval[a,b]")
        STRIP_ASSUME_TAC THENL
         [FIRST_ASSUM (MP_TAC o SPEC (← q r"interval[x:real^1,y]") o
                      elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o
                      elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
          ASM_REWRITE_TAC [] THEN
          REPEAT (DISCH_THEN (fun th => tactic_of do
            pure (STRIP_ASSUME_TAC (← REWRITE_RULE [SUBSET]
              (← CONJUNCT1 th))))) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL],
          ASM_REWRITE_TAC [EQ_INTERVAL] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [INTERVAL_NE_EMPTY_1]) THEN
          ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_NE_EMPTY_1,
                        INTERVAL_UPPERBOUND_NONEMPTY] THEN
          REWRITE_TAC [NORM_EQ_0, VECTOR_SUB_EQ] THEN
          ASM_CASES_TAC (← q r"(f:real^1->real^1) y = f x") THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM DROP_EQ]) THEN
          ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← GSYM REAL_NOT_LE, ← REAL_ARITH
                          (← q r"x <= y ==> (~(y = x) <=> x < y)")] THEN
          REPEAT STRIP_TAC THEN
          FIRST_ASSUM (MP_TAC o elc 2 o REWRITE_RULE [division_of]) THEN
          DISCH_THEN (MP_TAC o SPECL
           [← q r"interval[u:real^1,v]", ← q r"interval[x:real^1,y]"]) THEN
          ASM_REWRITE_TAC [EQ_INTERVAL, INTERVAL_NE_EMPTY_1, DE_MORGAN_THM] THEN
          ASM_CASES_TAC (← q r"(f:real^1->real^1) y = f x") THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [INTERIOR_INTERVAL, DISJOINT_INTERVAL_1] THEN
          ASM_SIMP_TAC [← REAL_ARITH (← q r"x <= y ==> (y <= x <=> x = y)"), DROP_EQ] THEN
          ASM_MESON_TAC []],
        DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← REAL_ARITH
         (← q r"x = y ==> x <= a ==> y <= a")) THEN
        MATCH_MP_TAC SUM_EQ THEN
        FIRST_ASSUM (fun th => tactic_of do
          pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
        SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY,
                  o_DEF] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
        AP_TERM_TAC THEN BINOP_TAC THEN AP_TERM_TAC THENL
         [MATCH_MP_TAC INTERVAL_UPPERBOUND_1,
          MATCH_MP_TAC INTERVAL_LOWERBOUND_1] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [← GSYM INTERVAL_NE_EMPTY_1] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"interval[u:real^1,v]") o
                      elc 1 o GEN_REWRITE_RULE I [division_of]) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (ASSUME_TAC o REWRITE_RULE [SUBSET] o CONJUNCT1) THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [ENDS_IN_INTERVAL]]]))

  let HAS_BOUNDED_VARIATION_COMPOSE_DECREASING ← prove
   r"!f g:real^1->real^N a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x)) /\
        g has_bounded_variation_on interval[f b,f a]
        ==> (g o f) has_bounded_variation_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [VECTOR_NEG_NEG]
      (← ISPECL [← q r"f:real^1->real^N", ← q r"--b:real^1", ← q r"--a:real^1"]
          HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL))) THEN
    POP_ASSUM MP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o BINDER_CONV o RAND_CONV)
     [← GSYM REAL_LE_NEG2] THEN
    REWRITE_TAC [← GSYM DROP_NEG, IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_BOUNDED_VARIATION_COMPOSE_INCREASING) THEN
    REWRITE_TAC [o_DEF, VECTOR_NEG_NEG])

  let VECTOR_VARIATION_COMPOSE_DECREASING ← prove
   r"!f g:real^1->real^N a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f y) <= drop(f x)) /\
        g has_bounded_variation_on interval[f b,f a]
        ==> vector_variation (interval[a,b]) (g o f)
            <= vector_variation (interval[f b,f a]) g"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [VECTOR_NEG_NEG]
      (← ISPECL [← q r"f:real^1->real^N", ← q r"--b:real^1", ← q r"--a:real^1"]
          HAS_BOUNDED_VARIATION_ON_REFLECT_INTERVAL))) THEN
    POP_ASSUM MP_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o BINDER_CONV o RAND_CONV)
     [← GSYM REAL_LE_NEG2] THEN
    REWRITE_TAC [← GSYM DROP_NEG, IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP VECTOR_VARIATION_COMPOSE_INCREASING) THEN
    REWRITE_TAC [o_DEF, VECTOR_NEG_NEG, VECTOR_VARIATION_REFLECT_INTERVAL])

  let (HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN,
       VECTOR_VARIATION_COMPOSE_INCREASING_GEN) ← CONJ_PAIR (← prove
   r"(!f g:real^1->real^N s t.
        is_interval s /\ is_interval t /\ IMAGE f s SUBSET t /\
        (!x y. x IN s /\ y IN s /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        g has_bounded_variation_on t
        ==> (g o f) has_bounded_variation_on s) /\
   (!f g:real^1->real^N s t.
        is_interval s /\ is_interval t /\ IMAGE f s SUBSET t /\
        (!x y. x IN s /\ y IN s /\ drop x <= drop y
               ==> drop(f x) <= drop(f y)) /\
        g has_bounded_variation_on t
        ==> vector_variation s (g o f) <= vector_variation t g)"
   (REWRITE_TAC [AND_FORALL_THM, ← TAUT
     (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VECTOR_VARIATION_ON_SUBINTERVALS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THENL
     [ASM_REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_EMPTY, EMPTY_SUBSET] THEN
      REWRITE_TAC [VECTOR_VARIATION_ON_EMPTY] THEN
      ASM_MESON_TAC [VECTOR_VARIATION_POS_LE],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)),
      TRANS_TAC REAL_LE_TRANS
        (← q r"vector_variation (interval[(f:real^1->real^1) a,f b])
                        (g:real^1->real^N)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_COMPOSE_INCREASING THEN
        CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_SUBSET)),
        MATCH_MP_TAC VECTOR_VARIATION_MONOTONE THEN ASM_REWRITE_TAC []]] THEN
    MATCH_MP_TAC (← MESON [INTERVAL_SUBSET_SEGMENT_1, SUBSET]
     (← q r"segment[a:real^1,b] SUBSET s ==> interval[a,b] SUBSET s")) THEN
    RULE_ASSUM_TAC
     (REWRITE_RULE [IS_INTERVAL_CONVEX_1, CONVEX_CONTAINS_SEGMENT]) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o
     MATCH_MP (← SET_RULE (← q r"s SUBSET t ==> a IN s ==> a IN t"))) THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I [SUBSET]) THEN
    ASM_REWRITE_TAC [ENDS_IN_INTERVAL]))

  let HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM ← prove
   r"!f f' g:real^1->real^N s t.
        is_interval s /\ homeomorphism (s,t) (f,f') /\
        g has_bounded_variation_on t
        ==> (g o f) has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HOMEOMORPHISM_1D_IMP_MONOTONIC)) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
     [MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN THEN
      EXISTS_TAC (← q r"t:real^1->bool") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      ASM_REWRITE_TAC [SUBSET_REFL, REAL_LE_LT, DROP_EQ] THEN
      ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE, IS_INTERVAL_CONNECTED_1],
      ALL_TAC] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_EQ THEN
    EXISTS_TAC (← q r"((g:real^1->real^N) o (--)) o ((--) o (f:real^1->real^1))") THEN
    CONJ_TAC THENL [REWRITE_TAC [o_DEF, VECTOR_NEG_NEG], ALL_TAC] THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN THEN
    EXISTS_TAC (← q r"IMAGE (--) (t:real^1->bool)") THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [IS_INTERVAL_REFLECT] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE, IS_INTERVAL_CONNECTED_1],
      REWRITE_TAC [IMAGE_o] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      REWRITE_TAC [o_DEF, DROP_NEG, REAL_LE_NEG2] THEN
      REWRITE_TAC [REAL_LE_LT, DROP_EQ] THEN ASM_MESON_TAC [],
      ASM_REWRITE_TAC [HAS_BOUNDED_VARIATION_REFLECT2_EQ, o_DEF]])

  let HAS_BOUNDED_VARIATION_COMPOSE_INJECTIVE ← prove
   r"!f g:real^1->real^N s.
        is_interval s /\ f continuous_on s /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
        g has_bounded_variation_on (IMAGE f s)
        ==> (g o f) has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    EXISTS_TAC (← q r"IMAGE (f:real^1->real^1) s") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMEOMORPHISM_INTO_1D THEN
    ASM_REWRITE_TAC [← GSYM IS_INTERVAL_PATH_CONNECTED_1])

  let VECTOR_VARIATION_COMPOSE_HOMEOMORPHISM ← (do
    let lemma ← prove
     r"!f f' g:real^1->real^N s t.
          is_interval s /\ homeomorphism (s,t) (f,f') /\
          g has_bounded_variation_on t /\
          (!x y. x IN s /\ y IN s /\ drop x < drop y ==> drop(f x) < drop(f y))
          ==> vector_variation s (g o f) = vector_variation t g"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_COMPOSE_INCREASING_GEN THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN CONJ_TAC THENL
         [ALL_TAC, ASM_SIMP_TAC [REAL_LE_LT, DROP_EQ] THEN ASM_MESON_TAC []] THEN
        ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE, IS_INTERVAL_CONNECTED_1],
        ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"vector_variation t (((g:real^1->real^N) o f) o (f':real^1->real^1))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC VECTOR_VARIATION_EQ THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM_SIMP_TAC [o_THM],
        ALL_TAC] THEN
      MATCH_MP_TAC VECTOR_VARIATION_COMPOSE_INCREASING_GEN THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONNECTED_CONTINUOUS_IMAGE, IS_INTERVAL_CONNECTED_1],
        DISCH_TAC] THEN
      CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM homeomorphism]) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_1D_IMP_MONOTONIC)) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th =>
         FIRST_X_ASSUM (MP_TAC o check (fun (t : thm) => HolCore.Basics.is_forall (concl t))) THEN
         STRIP_ASSUME_TAC th) THEN
        ASM_SIMP_TAC [] THENL
         [ASM_REWRITE_TAC [REAL_LE_LT, DROP_EQ] THEN ASM_MESON_TAC [],
          ALL_TAC] THEN
        SIMP_TAC [← REAL_ARITH (← q r"a < b ==> ~(b < a)")] THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"!x y:real^1. x IN s /\ y IN s ==> x = y") MP_TAC THENL
         [REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
          REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN ASM_MESON_TAC [],
          RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
          REWRITE_TAC [REAL_LE_LT] THEN ASM SET_TAC []],
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN THEN
        EXISTS_TAC (← q r"t:real^1->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
        ASM_REWRITE_TAC [REAL_LE_LT, DROP_EQ] THEN ASM_MESON_TAC []])
    prove
     r"!f f' g:real^1->real^N s t.
        is_interval s /\ homeomorphism (s,t) (f,f') /\
        g has_bounded_variation_on t
        ==> vector_variation s (g o f) = vector_variation t g"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_1D_IMP_MONOTONIC)) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
       [MATCH_MP_TAC lemma THEN ASM_MESON_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"(--) o (f:real^1->real^1)",
        ← q r"(f':real^1->real^1) o (--)",
        ← q r"(g:real^1->real^N) o (--)",
        ← q r"s:real^1->bool", ← q r"IMAGE (--) t:real^1->bool"]
       lemma) THEN
      ASM_REWRITE_TAC [o_DEF, ← GSYM VECTOR_VARIATION_REFLECT, VECTOR_NEG_NEG,
                       ← GSYM HAS_BOUNDED_VARIATION_REFLECT_EQ, ETA_AX] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [DROP_NEG, REAL_LT_NEG2] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN
      ASM_SIMP_TAC [homeomorphism, VECTOR_NEG_NEG, FORALL_IN_IMAGE,
                    ← GSYM IMAGE_o, o_DEF, ETA_AX, CONTINUOUS_ON_NEG] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [← GSYM IMAGE_o, o_DEF, VECTOR_NEG_NEG, IMAGE_ID] THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_NEGATION]))

  pure { HAS_BOUNDED_VARIATION_COMPOSE_INCREASING, VECTOR_VARIATION_COMPOSE_INCREASING,
         HAS_BOUNDED_VARIATION_COMPOSE_DECREASING, VECTOR_VARIATION_COMPOSE_DECREASING,
         HAS_BOUNDED_VARIATION_COMPOSE_INCREASING_GEN,
         VECTOR_VARIATION_COMPOSE_INCREASING_GEN,
         HAS_BOUNDED_VARIATION_COMPOSE_HOMEOMORPHISM,
         HAS_BOUNDED_VARIATION_COMPOSE_INJECTIVE, VECTOR_VARIATION_COMPOSE_HOMEOMORPHISM }

/- ------------------------------------------------------------------------- -/
/- Identity, linear and Lipschitz functions; bounded derivative; linear     -/
/- image; combining over a split point.  (integration.ml 18951-19258)       -/
/- ------------------------------------------------------------------------- -/

structure INBD where
  HAS_BOUNDED_VARIATION_ON_ID : thm
  LINEAR_IMP_HAS_BOUNDED_VARIATION : thm
  VECTOR_VARIATION_LINEAR : thm
  HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE : thm
  LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION : thm
  VECTOR_VARIATION_LIPSCHITZ : thm
  LIPSCHITZ_VECTOR_VARIATION : thm
  HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_HAS_BOUNDED_VARIATION_ON : thm
  HAS_BOUNDED_VARIATION_ON_LINEAR_IMAGE : thm
  HAS_BOUNDED_VARIATION_ON_COMBINE_GEN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBD [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINH : INH) (BINP : INP) (BINW : INW) (BINAV : INAV) (BINAW : INAW) (BINAY : INAY) (BINBA : INBA) (BINBC : INBC) : ExceptT String IO INBD := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, CONTENT_EQ_0_1, INTERVAL_LOWERBOUND_NONEMPTY,
        INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_SUBSET, DIVISION_OF_UNION_SELF,
        FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { SUBADDITIVE_CONTENT_DIVISION, .. } := BINH
  let { DIVISION_COMMON_POINT_BOUND, .. } := BINP
  let { has_bounded_setvariation_on, .. } := BINW
  let { HAS_BOUNDED_VARIATION_COMPARISON, has_bounded_variation_on,
        VECTOR_VARIATION_COMPARISON, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_CMUL, HAS_BOUNDED_VARIATION_ON_CONST,
        HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED, HAS_BOUNDED_VARIATION_ON_SUBSET,
        HAS_BOUNDED_VARIATION_ON_VMUL, VECTOR_VARIATION_CMUL,
        VECTOR_VARIATION_GE_NORM_FUNCTION, VECTOR_VARIATION_POS_LE, VECTOR_VARIATION_SING,
        VECTOR_VARIATION_VMUL, .. } := BINAW
  let { VECTOR_VARIATION_COMBINE, .. } := BINAY
  let { HAS_BOUNDED_VARIATION_NONTRIVIAL, VECTOR_VARIATION_ID, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_COMPOSE_DECREASING, HAS_BOUNDED_VARIATION_COMPOSE_INCREASING,
        .. } := BINBC
  let { CARD_SUBSET, CONJ_ASSOC, DIMINDEX_1, ETA_AX, FINITE_RESTRICT, FINITE_SUBSET, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_ID, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT,
        IMP_IMP, IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, LE_TRANS, LEFT_IMP_EXISTS_THM, REAL_ABS_SUB, .. }
        := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL, REAL_LE_MUL_EQ, REAL_LE_REFL, REAL_LE_RMUL,
        REAL_LE_RMUL_EQ, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_LMUL, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LE,
        REAL_SUB_LE, REAL_SUB_REFL, REAL_WLOG_LE, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_RESTRICT, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, real_abs, real_ge, SUM_BOUND, SUM_DIFF, SUM_EQ, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_CMUL, DROP_EQ, DROP_SUB, ENDS_IN_INTERVAL, FORALL_DROP, FORALL_LIFT,
        INTERVAL_SING, LIFT_DROP, LIFT_EQ, NORM_1, NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.dv.dg.pt.cvx.vec3
  let { dist, VECTOR_ADD_RID, VECTOR_MUL_LZERO, VECTOR_SUB_EQ, VECTOR_SUB_LDISTRIB,
        VECTOR_SUB_RDISTRIB, .. } := D.dv.dg.pt.cvx.vec4
  let { BOUNDED_POS, BOUNDED_SUBSET, .. } := D.dv.dg.pt.cvx.top1
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_NE_EMPTY_1, .. } := D.dv.dg.pt.cvx.top4
  let { SEGMENT_1, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { BOUNDED_UNION, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_LIPSCHITZ, .. } := D.qderivatives
  let { EXP_1, SUM_UNION_NONZERO, .. } := D.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, IMAGE_AFFINITY_INTERVAL, IS_INTERVAL_1_CASES,
        IS_INTERVAL_INTER, .. } := D.qtopology
  let { LINEAR_1, LINEAR_FROM_1, .. } := D.qvec
  -- @@SCOPE END

  let HAS_BOUNDED_VARIATION_ON_ID ← prove
   r"!s:real^1->bool. bounded s ==> (\x. x) has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [has_bounded_variation_on] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BOUNDED_SUBSET_CLOSED_INTERVAL) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, has_bounded_setvariation_on] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"content(interval[a:real^1,b])") THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool",
                      ← q r"a:real^1", ← q r"b:real^1"] SUBADDITIVE_CONTENT_DIVISION) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN MATCH_MP_TAC SUM_EQ THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    SIMP_TAC [CONTENT_1, INTERVAL_NE_EMPTY_1, NORM_1, DROP_SUB] THEN
    REAL_ARITH_TAC)

  let LINEAR_IMP_HAS_BOUNDED_VARIATION ← prove
   r"!f:real^1->real^N.
        linear f /\ bounded s ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"c:real^N") SUBST1_TAC o
     GEN_REWRITE_RULE I [LINEAR_FROM_1]) THEN
    MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_VMUL THEN
    ASM_SIMP_TAC [LIFT_DROP, HAS_BOUNDED_VARIATION_ON_ID])

  let VECTOR_VARIATION_LINEAR ← prove
   r"!f:real^1->real^N a b.
        linear f /\ drop a <= drop b
        ==> vector_variation(interval[a,b]) f = dist(f a,f b)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"c:real^N") SUBST1_TAC o
     GEN_REWRITE_RULE I [LINEAR_FROM_1]) THEN
    ASM_SIMP_TAC [VECTOR_VARIATION_VMUL, LIFT_DROP, HAS_BOUNDED_VARIATION_ON_ID,
                  BOUNDED_INTERVAL, VECTOR_VARIATION_ID, INTERVAL_EQ_EMPTY_1,
                  ← GSYM REAL_NOT_LE, dist, ← GSYM VECTOR_SUB_RDISTRIB, NORM_MUL] THEN
    ASM_SIMP_TAC [NORM_1, ← REAL_ARITH (← q r"a <= b ==> abs(a - b) = b - a")] THEN
    REWRITE_TAC [REAL_MUL_SYM])

  let HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE ← prove
   r"!f:real^M->real^N g s B.
        g has_bounded_variation_on s /\
        (!x y. x IN IMAGE g s /\ y IN IMAGE g s
               ==> norm(f x - f y) <= B * norm(x - y))
        ==> (f o g) has_bounded_variation_on s"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"\x. B % (g:real^1->real^M) x")
          HAS_BOUNDED_VARIATION_COMPARISON) THEN
    ASM_REWRITE_TAC [dist, ← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_CMUL, o_DEF] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    REAL_ARITH_TAC)

  let LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION ← prove
   r"!f:real^1->real^N s B.
        bounded s /\
        (!x y. x IN s /\ y IN s ==> norm(f x - f y) <= B * norm(x - y))
        ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"f:real^1->real^N", ← q r"\x:real^1. x", ← q r"s:real^1->bool", ← q r"B:real"]
     HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE) THEN
    ASM_REWRITE_TAC [o_DEF, IMAGE_ID, ETA_AX] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_ID])

  let VECTOR_VARIATION_LIPSCHITZ ← prove
   r"!f:real^1->real^N a b l.
        drop a <= drop b /\
        (!x y. x IN interval[a,b] /\ y IN interval[a,b]
               ==> norm(f x - f y) <= l * norm(x - y))
        ==> vector_variation (interval[a,b]) f <= l * (drop b - drop a)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"b:real^1 = a") THEN
    ASM_REWRITE_TAC [REAL_SUB_REFL, VECTOR_VARIATION_SING, INTERVAL_SING,
                     REAL_MUL_RZERO, REAL_LE_REFL] THEN
    SUBGOAL_THEN (← q r"drop a < drop b") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [REAL_LT_LE, DROP_EQ], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 <= l") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
      ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_NE_EMPTY_1] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← NORM_ARITH
       (← q r"norm(x:real^N) <= a ==> &0 <= a"))) THEN
      ASM_SIMP_TAC [REAL_LE_MUL_EQ, NORM_POS_LT, VECTOR_SUB_EQ],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\x:real^1. l % x", ← q r"f:real^1->real^N",
                      ← q r"interval[a:real^1,b]"]
          VECTOR_VARIATION_COMPARISON) THEN
    ASM_SIMP_TAC [dist, HAS_BOUNDED_VARIATION_ON_CMUL,
                  HAS_BOUNDED_VARIATION_ON_ID, BOUNDED_INTERVAL,
                  VECTOR_VARIATION_CMUL, VECTOR_VARIATION_ID] THEN
    ASM_SIMP_TAC [INTERVAL_EQ_EMPTY_1, ← REAL_ARITH (← q r"a <= b ==> ~(b < a)")] THEN
    REWRITE_TAC [← GSYM VECTOR_SUB_LDISTRIB, NORM_MUL] THEN
    ASM_SIMP_TAC [real_abs])

  let LIPSCHITZ_VECTOR_VARIATION ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> ((!x y. x IN interval[a,b] /\ y IN interval[a,b]
                    ==> abs(vector_variation (interval[a,x]) f -
                            vector_variation (interval[a,y]) f)
                        <= B * norm(x - y)) <=>
             (!x y. x IN interval[a,b] /\ y IN interval[a,b]
                    ==> norm(f x - f y) <= B * norm(x - y)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LE THEN
    (CONJ_TAC THENL [MESON_TAC [NORM_SUB, REAL_ABS_SUB], ALL_TAC]) THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN
    REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"y:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ALL_TAC,
        DISCH_THEN (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= d ==> a <= abs(x - (x + d))")) THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        MATCH_MP_TAC VECTOR_VARIATION_GE_NORM_FUNCTION THEN
        ASM_REWRITE_TAC [SEGMENT_1, SUBSET_REFL]] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"a:real^1", ← q r"y:real^1",
                        ← q r"x:real^1"]
          VECTOR_VARIATION_COMBINE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 <= d /\ d <= a ==> abs(x - (x + d)) <= a")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC VECTOR_VARIATION_POS_LE THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HAS_BOUNDED_VARIATION_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET_INTERVAL_1] THEN ASM_REAL_ARITH_TAC,
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        ASM_REWRITE_TAC [NORM_1, real_abs, DROP_SUB, REAL_SUB_LE] THEN
        MATCH_MP_TAC VECTOR_VARIATION_LIPSCHITZ THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_INTERVAL_1] THEN
        ASM_REAL_ARITH_TAC]])

  let HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_HAS_BOUNDED_VARIATION_ON ← prove
   r"!f:real^1->real^N f' s.
        (!x. x IN s ==> (f has_vector_derivative f'(x)) (at x within s)) /\
        convex s /\ bounded s /\ bounded(IMAGE f' s)
        ==> f has_bounded_variation_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← MESON [] (← q r"(?x. &0 < x /\ P x) ==> ?x. P x")) THEN
    MATCH_MP_TAC HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_LIPSCHITZ THEN
    ASM_MESON_TAC [])

  let HAS_BOUNDED_VARIATION_ON_LINEAR_IMAGE ← prove
   r"!f:real^1->real^1 g:real^1->real^N a b.
        linear f /\ g has_bounded_variation_on IMAGE f (interval[a,b])
        ==> (g o f) has_bounded_variation_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [LINEAR_1]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:real") SUBST_ALL_TAC) THEN
    REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC (← REAL_ARITH
     (← q r"c = &0 \/ &0 <= c /\ &0 < c \/ ~(&0 <= c) /\ &0 < --c"))
    THENL
     [ASM_REWRITE_TAC [o_DEF, VECTOR_MUL_LZERO, HAS_BOUNDED_VARIATION_ON_CONST],
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_INCREASING THEN
      REWRITE_TAC [DROP_CMUL],
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_COMPOSE_DECREASING THEN
      REWRITE_TAC [DROP_CMUL] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"c * y <= c * x <=> --c * x <= --c * y")]] THEN
    ASM_SIMP_TAC [REAL_LE_LMUL, REAL_LT_IMP_LE] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON []
     (← q r"g has_bounded_variation_on s
    ==> s = t ==> g has_bounded_variation_on t"))) THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"c % x:real^N = c % x + vec 0")] THEN
    ASM_REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [VECTOR_ADD_RID] THEN
    CONV_TAC SYM_CONV THEN REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_CMUL] THENL
     [ALL_TAC,
     ONCE_REWRITE_TAC [← REAL_ARITH (← q r"c * y < c * x <=> --c * x < --c * y")]] THEN
    MATCH_MP_TAC REAL_LT_LMUL THEN
    ASM_REWRITE_TAC [← GSYM INTERVAL_EQ_EMPTY_1])

  let HAS_BOUNDED_VARIATION_ON_COMBINE_GEN ← prove
   r"!f:real^1->real^N s a.
        is_interval s
        ==> (f has_bounded_variation_on s <=>
             f has_bounded_variation_on {x | x IN s /\ drop x <= a} /\
             f has_bounded_variation_on {x | x IN s /\ drop x >= a})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
        HAS_BOUNDED_VARIATION_ON_SUBSET) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      ALL_TAC] THEN
    DISCH_TAC THEN REWRITE_TAC [HAS_BOUNDED_VARIATION_NONTRIVIAL] THEN
    SUBGOAL_THEN (← q r"bounded(IMAGE (f:real^1->real^N) s)") MP_TAC THENL
     [MATCH_MP_TAC BOUNDED_SUBSET THEN
      EXISTS_TAC
       (← q r"IMAGE (f:real^1->real^N)
            ({x | x IN s /\ drop x <= a} UNION
             {x | x IN s /\ drop x >= a})") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IMAGE_UNION, BOUNDED_UNION] THEN CONJ_TAC THEN
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
        MATCH_MP_TAC IS_INTERVAL_INTER THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [IS_INTERVAL_1_CASES, real_ge] THEN MESON_TAC [],
        MATCH_MP_TAC IMAGE_SUBSET THEN
        SIMP_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN REAL_ARITH_TAC],
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"D:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
      REWRITE_TAC [has_bounded_variation_on, has_bounded_setvariation_on] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"C:real") THEN DISCH_THEN (LABEL_TAC "R") THEN
      X_GEN_TAC (← q r"B:real") THEN DISCH_THEN (LABEL_TAC "L")] THEN
    EXISTS_TAC (← q r"&4 * D + B + C:real") THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    ABBREV_TAC (← q r"dl = {k:real^1->bool |
                    k IN d /\ k SUBSET {x | x IN s /\ drop x <= a}}") THEN
    ABBREV_TAC (← q r"dr = {k:real^1->bool |
                    k IN d /\ k SUBSET {x | x IN s /\ drop x >= a}}") THEN
    REMOVE_THEN "R" (MP_TAC o SPECL
     [← q r"dr:(real^1->bool)->bool", ← q r"UNIONS dr:real^1->bool"]) THEN
    REMOVE_THEN "L" (MP_TAC o SPECL
     [← q r"dl:(real^1->bool)->bool", ← q r"UNIONS dl:real^1->bool"]) THEN
    REPEAT (ANTS_TAC THENL
     [CONJ_TAC THENL [MATCH_MP_TAC DIVISION_OF_SUBSET, ASM SET_TAC []] THEN
      EXISTS_TAC (← q r"d:(real^1->bool)->bool") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [DIVISION_OF_UNION_SELF], ASM SET_TAC []],
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")]]) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"u <= (s + t) + d ==> s <= b ==> t <= c ==> u <= d + b + c")) THEN
    W (MP_TAC o PART_MATCH (rand o rand)
      SUM_UNION_NONZERO o lhand o rand o snd) THEN
    ANTS_TAC THENL
     [MAP_EVERY EXPAND_TAC ["dl", "dr"] THEN
      REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [FINITE_RESTRICT, IMP_CONJ] THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REWRITE_TAC [IMP_IMP, ← GSYM SUBSET_INTER, ← GSYM CONJ_ASSOC, ← SET_RULE
       (← q r"{x | P x /\ Q x} INTER {x | P x /\ R x} = {x | P x /\ Q x /\ R x}")] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x <= a /\ x >= a <=> x = a")] THEN
      REWRITE_TAC [← GSYM LIFT_EQ, LIFT_DROP] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [LIFT_EQ, NORM_EQ_0, VECTOR_SUB_EQ] THEN AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ] THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"s SUBSET {x | x IN t /\ x = a} ==> s SUBSET {a}"))) THEN
      REWRITE_TAC [← GSYM INTERVAL_SING, SUBSET_INTERVAL_1] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [INTERVAL_NE_EMPTY_1]) THEN
      REAL_ARITH_TAC,
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"s - t <= b ==> s <= t + b")) THEN
    W (MP_TAC o PART_MATCH (rand o rand) SUM_DIFF o lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    SUBGOAL_THEN
     (← q r"FINITE(d DIFF (dl UNION dr):(real^1->bool)->bool) /\
    CARD(d DIFF (dl UNION dr)) <= 2")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← MESON [CARD_SUBSET, LE_TRANS, FINITE_SUBSET]
       (← q r"!t. s SUBSET t /\ FINITE t /\ CARD t <= 2
          ==> FINITE s /\ CARD s <= 2")) THEN
      EXISTS_TAC (← q r"{k | k IN d /\ ~(content k = &0) /\ lift a IN k}") THEN
      ASM_SIMP_TAC [FINITE_RESTRICT] THEN
      SUBST1_TAC (← MESON [EXP_1, DIMINDEX_1] (← q r"2 = 2 EXP dimindex(:1)")) THEN
      CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC DIVISION_COMMON_POINT_BOUND THEN ASM_MESON_TAC []] THEN
      GEN_REWRITE_TAC I [SUBSET] THEN MAP_EVERY EXPAND_TAC ["dl", "dr"] THEN
      SIMP_TAC [IN_DIFF, IMP_CONJ, IN_ELIM_THM, IN_UNION] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"interval[u:real^1,v] SUBSET s") ASSUME_TAC THENL
       [ASM_MESON_TAC [division_of, SUBSET], ASM_REWRITE_TAC [SUBSET_INTER]] THEN
      REWRITE_TAC [CONTENT_EQ_0_1, IN_INTERVAL_1, SUBSET, IN_ELIM_THM] THEN
      REWRITE_TAC [LIFT_DROP] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"&(CARD(d DIFF (dl UNION dr):(real^1->bool)->bool)) * &2 * D") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUM_BOUND THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_DIFF, IMP_CONJ] THEN FIRST_ASSUM (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x:real^N) <= d /\ norm y <= d ==> norm(x - y) <= &2 * d")) THEN
      ASM_MESON_TAC [division_of, SUBSET, ENDS_IN_INTERVAL],
      ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_LE_RMUL_EQ] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x * &2 <= &4 <=> x <= &2")] THEN
      ASM_REWRITE_TAC [REAL_OF_NUM_LE]])

  pure { HAS_BOUNDED_VARIATION_ON_ID, LINEAR_IMP_HAS_BOUNDED_VARIATION,
         VECTOR_VARIATION_LINEAR, HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE,
         LIPSCHITZ_IMP_HAS_BOUNDED_VARIATION, VECTOR_VARIATION_LIPSCHITZ,
         LIPSCHITZ_VECTOR_VARIATION, HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_HAS_BOUNDED_VARIATION_ON,
         HAS_BOUNDED_VARIATION_ON_LINEAR_IMAGE, HAS_BOUNDED_VARIATION_ON_COMBINE_GEN }

/- ------------------------------------------------------------------------- -/
/- Bounded variation from the interior; convex functions.                   -/
/- (integration.ml 19259-19571)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBE where
  HAS_BOUNDED_VARIATION_ON_INTERIOR : thm
  HAS_BOUNDED_VARIATION_ON_INTERIOR_EQ : thm
  CONVEX_HAS_BOUNDED_VARIATION_EQ : thm
  CONVEX_HAS_BOUNDED_VARIATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBE [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) (BINAV : INAV) (BINAW : INAW) (BINAX : INAX) (BINBA : INBA) (BINBD : INBD) : ExceptT String IO INBE := do
  -- @@SCOPE BEGIN
  let { CONTENT_1, INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { HAS_BOUNDED_SETVARIATION_ON, .. } := BINW
  let { has_bounded_variation_on, .. } := BINAV
  let { HAS_BOUNDED_VARIATION_ON_EMPTY, HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED,
        HAS_BOUNDED_VARIATION_ON_SUBSET, .. } := BINAW
  let { HAS_BOUNDED_VARIATION_ON_CLOSURE, HAS_BOUNDED_VARIATION_ON_SING, .. } := BINAX
  let { DECREASING_BOUNDED_VARIATION_GEN, INCREASING_BOUNDED_VARIATION_GEN, .. } := BINBA
  let { HAS_BOUNDED_VARIATION_ON_COMBINE_GEN, .. } := BINBD
  let { CONTRAPOS_THM, DIMINDEX_1, ETA_AX, FINITE_IMAGE, FINITE_RESTRICT, .. } :=
        D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_SUBSET, IMP_CONJ, INT_SUB_REFL, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, MONO_IMP, REAL_ABS_INV, REAL_ABS_NUM, REAL_ARCH_POW_INV,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_EQ_SQUARE_ABS, REAL_INV_LE_1, REAL_LE_INV2, REAL_LE_INV_EQ,
        REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_INV_EQ,
        REAL_LT_MUL, REAL_LT_POW2, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_LID, REAL_POS, REAL_POW_INV, REAL_POW_LE, REAL_SUB_0, REAL_SUB_LE,
        REAL_SUB_LT, REAL_SUB_RZERO, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_RESTRICT,
        SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_div, real_ge, SUM_EQ, SUM_IMAGE, SUM_RESTRICT_SET, UNIONS_SUBSET,
        .. } := D.dv.dg.pt.cvx.core6
  let { DIST_LIFT, .. } := D.dv.dg.pt.cvx.vec1
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VSUM, ENDS_IN_INTERVAL, LIFT_DROP,
        NORM_0, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LIFT, .. } := D.dv.dg.pt.cvx.vec3
  let { VECTOR_ADD_RID, VECTOR_MUL_RZERO, VECTOR_SUB_REFL, VECTOR_SUB_RZERO, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := D.dv.dg.pt.cvx.met
  let { BOUNDED_SUBSET, .. } := D.dv.dg.pt.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.dv.dg.pt.cvx.top2
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_SEQUENTIALLY, .. } :=
        D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_INTER, INTERIOR_SUBSET, INTERVAL_EQ_EMPTY_1,
        INTERVAL_NE_EMPTY_1, IS_INTERVAL_INTERVAL, LIM_ADD, LIM_CONST, LIM_NORM,
        LIM_SEQUENTIALLY, LIM_SUB, .. } := D.dv.dg.pt.cvx.top4
  let { bounded, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_ARITH_TAC, ASM_MESON_TAC, INT_ARITH, MESON_TAC, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, REAL_RING, SET_RULE, SET_TAC, VECTOR_ARITH, .. } :=
        D.dv.dg.pt.cvx
  let { AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, AFF_DIM_GE, AFF_DIM_LE_UNIV, .. } :=
        D.dv.dg.pt.qcvx1
  let { CONVEX_CLOSURE_INTERIOR, CONVEX_INTERIOR, .. } := D.dv.dg.pt.qcvx2
  let { IS_INTERVAL_CONVEX_1, .. } := D.dv.dg.pt.qcvx3
  let { REAL_ABS_POW, REAL_LT_INV2, REAL_POW_MONO, REAL_POW_MONO_LT, .. } :=
        D.dv.dg.qsession
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { LIM_VMUL, .. } := D.dv.qtopology2
  let { AFF_DIM_NONEMPTY_INTERIOR_EQ, CONVEX_IMP_BOUNDED_ON_INTERVAL,
        CONVEX_IMP_PIECEWISE_MONOTONE, .. } := D.qconvex
  let { REAL_POW_1, REAL_POW_LE_1, .. } := D.qsession
  let { EQ_INTERVAL_1, INTERIOR_INTERVAL, LIM_DROP_UBOUND, LIM_VSUM, .. } := D.qtopology
  let { SUM_VSUM, .. } := D.qvec
  let { IMP_REWRITE_TAC, .. } := D
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th =>
    liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let HAS_BOUNDED_VARIATION_ON_INTERIOR ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on (interior s) /\
        (is_interval s \/ f continuous_on s)
        ==> f has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IS_INTERVAL_CONVEX_1]) THEN
      REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interior s:real^1->bool = {}") THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP AFF_DIM_NONEMPTY_INTERIOR_EQ) THEN
        ASM_SIMP_TAC [AFF_DIM_LE_UNIV, ← INT_ARITH
         (← q r"d:int <= n ==> (~(d = n) <=> d <= n - &1)")] THEN
        REWRITE_TAC [DIMINDEX_1, INT_SUB_REFL] THEN
        SIMP_TAC [AFF_DIM_GE, AFF_DIM_EQ_0, AFF_DIM_EQ_MINUS1, ← INT_ARITH
          (← q r"--(&1):int <= x ==> (x <= &0 <=> x = -- &1 \/ x = &0)")] THEN
        STRIP_TAC THEN
        ASM_REWRITE_TAC [HAS_BOUNDED_VARIATION_ON_SING,
                         HAS_BOUNDED_VARIATION_ON_EMPTY],
        MATCH_MP_TAC HAS_BOUNDED_VARIATION_ON_SUBSET THEN
        EXISTS_TAC (← q r"closure(interior s):real^1->bool") THEN
        ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_CLOSURE, IS_INTERVAL_CONVEX_1,
                      CONVEX_INTERIOR] THEN
        ASM_SIMP_TAC [CONVEX_CLOSURE_INTERIOR, CLOSURE_SUBSET]],
      ALL_TAC] THEN
    REWRITE_TAC [has_bounded_variation_on, HAS_BOUNDED_SETVARIATION_ON] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN REWRITE_TAC [SUM_VSUM] THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_DROP_UBOUND) THEN
    EXISTS_TAC
     (← q r"\n. vsum d
         (\k. lift(norm
                 ((f:real^1->real^N)(interval_upperbound k -
                    inv(&2 pow n) %
                    (interval_upperbound k - interval_lowerbound k)) -
                  f(interval_lowerbound k +
                    inv(&2 pow n) %
                    (interval_upperbound k - interval_lowerbound k)))))") THEN
    REWRITE_TAC [o_DEF, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LIM_VSUM THEN ASM_REWRITE_TAC [] THEN FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      MATCH_MP_TAC LIM_NORM THEN MATCH_MP_TAC LIM_SUB THEN
      SUBGOAL_THEN (← q r"interval[a:real^1,b] SUBSET s") ASSUME_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"(f:real^1->real^N) continuous (at b within s)") MP_TAC THENL
         [FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
           [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET],
          ALL_TAC],
        SUBGOAL_THEN (← q r"(f:real^1->real^N) continuous (at a within s)") MP_TAC THENL
         [FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE I
           [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
          ASM_MESON_TAC [ENDS_IN_INTERVAL, SUBSET],
          ALL_TAC]] THEN
      REWRITE_TAC [CONTINUOUS_WITHIN_SEQUENTIALLY, o_DEF] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      (CONJ_TAC THENL
        [GEN_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
         REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_CMUL,
           ← REAL_ARITH (← q r"a <= b - i * (b - a) <=> &0 <= (&1 - i) * (b - a)"),
           ← REAL_ARITH (← q r"b - i * (b - a) <= b <=> &0 <= i * (b - a)"),
           ← REAL_ARITH (← q r"a + i * (b - a) <= b <=> &0 <= (&1 - i) * (b - a)"),
           ← REAL_ARITH (← q r"a <= a + i * (b - a) <=> &0 <= i * (b - a)")] THEN
         CONJ_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
         ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM INTERVAL_NE_EMPTY_1] THEN
         SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
         MATCH_MP_TAC REAL_INV_LE_1 THEN MATCH_MP_TAC REAL_POW_LE_1 THEN
         CONV_TAC REAL_RAT_REDUCE_CONV,
        ALL_TAC])
      THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_SUB_RZERO] THEN
        MATCH_MP_TAC LIM_SUB,
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
        MATCH_MP_TAC LIM_ADD] THEN
      REWRITE_TAC [LIM_CONST] THEN
      SUBST1_TAC (← VECTOR_ARITH (← q r"vec 0:real^1 = &0 % (b - a)")) THEN
      MATCH_MP_TAC LIM_VMUL THEN
      REWRITE_TAC [LIM_SEQUENTIALLY, o_DEF, DIST_LIFT, REAL_SUB_RZERO] THEN
      REWRITE_TAC [REAL_ABS_INV, REAL_ABS_POW, REAL_ABS_NUM] THEN
      X_GEN_TAC (← q r"d:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"d:real"] REAL_ARCH_POW_INV) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      REWRITE_TAC [REAL_POW_INV, real_div, REAL_MUL_LID] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      TRANS_TAC REAL_LET_TRANS (← q r"inv(&2 pow N)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN REWRITE_TAC [REAL_LT_POW2] THEN
      MATCH_MP_TAC REAL_POW_MONO THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"2") THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    REWRITE_TAC [DROP_VSUM, o_DEF, LIFT_DROP] THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"d:(real^1->bool)->bool") o
        SPECL [← q r"d:(real^1->bool)->bool", ← q r"UNIONS d:real^1->bool"]) THEN
    DISCH_THEN (MP_TAC o SPEC
      (← q r"IMAGE (\k.
         interval[interval_lowerbound k +
                  inv(&2 pow n) %
                  (interval_upperbound k - interval_lowerbound k):real^1,
                  interval_upperbound k -
                  inv(&2 pow n) %
                  (interval_upperbound k - interval_lowerbound k)])
      {k | k IN d /\ ~(content k = &0)}")) THEN
    MP_TAC (← GEN (← q r"g:(real^1->bool)->real") (← ISPECL
     [← q r"\k. interval[interval_lowerbound k +
                  inv(&2 pow n) %
                  (interval_upperbound k - interval_lowerbound k):real^1,
                  interval_upperbound k -
                  inv(&2 pow n) %
                  (interval_upperbound k - interval_lowerbound k)]",
      ← q r"g:(real^1->bool)->real",
      ← q r"{k:real^1->bool | k IN d /\ ~(content k = &0)}"]
        SUM_IMAGE)) THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN ANTS_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM, RIGHT_FORALL_IMP_THM, ← TAUT
       (← q r"(p /\ q) /\ (r /\ s) /\ t ==> u <=> p ==> r ==> q /\ s /\ t ==> u")] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"c:real^1", ← q r"d:real^1"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY,
                    INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC) MP_TAC)) THEN
      REWRITE_TAC [EQ_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_CMUL] THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"b - i * (b - a) < a + i * (b - a) <=>
      ~(&0 <= (&1 - &2 * i) * (b - a))")] THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
       [MATCH_MP_TAC (← TAUT (← q r"p ==> ~p /\ q ==> r")) THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM INTERVAL_NE_EMPTY_1] THEN
        SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&2 <= &1 * x <=> &2 pow 1 <= x")] THEN
        MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_ARITH_TAC,
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_RING
        (← q r"a + n * (b - a) = c + n * (d - c) /\
       b - n * (b - a) = d - n * (d - c) ==>
       n pow 2 = (&1 - n) pow 2 \/ a = c /\ b = d"))) THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN SIMP_TAC [] THEN
      MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
      REWRITE_TAC [← GSYM REAL_EQ_SQUARE_ABS] THEN
      REWRITE_TAC [REAL_ABS_INV, REAL_ABS_POW, REAL_ABS_NUM] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"x = abs(&1 - x) ==> x = inv(&2)"))) THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x < y ==> x = y ==> F")) THEN
      MATCH_MP_TAC REAL_LT_INV2 THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_POW_1] THEN
      MATCH_MP_TAC REAL_POW_MONO_LT THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_ARITH_TAC,
      DISCH_THEN (fun th => REWRITE_TAC [th]) THEN REWRITE_TAC [o_DEF]] THEN
    ANTS_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
      MATCH_MP_TAC REAL_EQ_IMP_LE THEN CONV_TAC SYM_CONV THEN
      REWRITE_TAC [SUM_RESTRICT_SET] THEN MATCH_MP_TAC SUM_EQ THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, CONTENT_1, ← GSYM
                    INTERVAL_NE_EMPTY_1, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      REWRITE_TAC [REAL_SUB_0, DROP_EQ] THEN
      ASM_CASES_TAC (← q r"b:real^1 = a") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_MUL_RZERO, VECTOR_SUB_RZERO,
                   VECTOR_ADD_RID, NORM_0] THEN
      AP_TERM_TAC THEN BINOP_TAC THEN AP_TERM_TAC THENL
       [MATCH_MP_TAC INTERVAL_UPPERBOUND_NONEMPTY,
        MATCH_MP_TAC INTERVAL_LOWERBOUND_NONEMPTY] THEN
      REWRITE_TAC [INTERVAL_NE_EMPTY_1, DROP_ADD, DROP_SUB, DROP_CMUL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a + i * (b - a) <= b - i * (b - a) <=>
                            &0 <= (&1 - &2 * i) * (b - a)")] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN
      ASM_REWRITE_TAC [REAL_SUB_LE, ← GSYM INTERVAL_NE_EMPTY_1] THEN
      SIMP_TAC [← GSYM real_div, REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&2 <= &1 * x <=> &2 pow 1 <= x")] THEN
      MATCH_MP_TAC REAL_POW_MONO THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_ARITH_TAC] THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [IN_ELIM_THM, IMP_CONJ] THEN
      FIRST_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, CONTENT_1,
                    ← GSYM INTERVAL_NE_EMPTY_1, INTERVAL_UPPERBOUND_NONEMPTY] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"~(b - a = &0) ==> a <= b ==> a < b"))) THEN
      ASM_REWRITE_TAC [← GSYM (← CONJUNCT1 INTERVAL_NE_EMPTY_1)] THEN
      DISCH_TAC THEN TRANS_TAC SUBSET_TRANS (← q r"interval(a:real^1,b)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [SUBSET_INTERVAL_1] THEN DISJ2_TAC THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_SUB, DROP_CMUL,
           ← REAL_ARITH (← q r"b - i * (b - a) < b <=> &0 < i * (b - a)"),
           ← REAL_ARITH (← q r"a < a + i * (b - a) <=> &0 < i * (b - a)"),
           ← REAL_ARITH (← q r"a + i * (b - a) <= b - i * (b - a) <=>
