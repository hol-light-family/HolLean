  let { COUNTABLE_IMAGE_INJ_EQ, COUNTABLE_SUBSET, COUNTABLE_UNIONS, .. } := D.qcard
  let { PAIRWISE_IMAGE, .. } := D.qsession
  let { CARD_FRONTIER_INTERVAL_1, COUNTABLE_DISJOINT_OPEN_SUBSETS, EQ_INTERVAL,
        EVENTUALLY_WITHIN_INTERIOR_INTER, LIM_DROP_UBOUND, LIM_TRANSFORM_WITHIN_SET_IMP,
        LIMIT_PAIR_DROP_LE, NON_TRIVIAL_LIMIT_LEFT, NON_TRIVIAL_LIMIT_RIGHT,
        OPEN_CLOSED_INTERVAL_1, TWO_SIDED_LIMIT_AT, .. } := D.qtopology
  let { DIST_REAL, .. } := D.qvec
  -- @@SCOPE END

  let CONVEX_ON_RIGHT_DIFFERENTIABLE ← prove
   r"!f s a.
        f convex_on s /\ a IN interior s
        ==> (lift o f) differentiable (at a within {x | drop a <= drop x})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERIOR_CBALL]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"(lift o f) differentiable
    (at a within interval(a,a + lift e) INTER {x | drop a <= drop x})")
    MP_TAC THEN
    REWRITE_TAC [VECTOR_DIFFERENTIABLE, HAS_VECTOR_DERIVATIVE_WITHIN_1D] THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_WITHIN_SET_IMP) THEN
      REWRITE_TAC [EVENTUALLY_AT] THEN EXISTS_TAC (← q r"e:real") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, IN_INTERVAL_1] THEN
      REWRITE_TAC [DROP_ADD, LIFT_DROP, ← GSYM DIST_NZ, ← GSYM DROP_EQ] THEN
      REWRITE_TAC [DIST_REAL, ← GSYM drop] THEN REAL_ARITH_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    MATCH_MP_TAC INCREASING_RIGHT_LIMIT_1_GEN THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
    REWRITE_TAC [DROP_CMUL, o_DEF, DROP_SUB, LIFT_DROP] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
    EXISTS_TAC (← q r"(f a - f(a - lift e)) / norm(a - (a - lift e))") THEN
    SUBGOAL_THEN (← q r"f convex_on cball(a:real^1,e)") MP_TAC THENL
     [ASM_MESON_TAC [CONVEX_ON_SUBSET], ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (CONJ_TAC THEN X_GEN_TAC (← q r"x:real^1") THEN MP_TAC th)) THENL
     [SIMP_TAC [CONVEX_ON_MID_SECANT, IN_INTERVAL_1, DROP_ADD, LIFT_DROP] THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a - lift e", ← q r"x:real^1", ← q r"a:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, ← REAL_ARITH
       (← q r"a < x ==> abs(x - a) = x - a")] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [IN_CBALL, SEGMENT_1, DROP_SUB, LIFT_DROP] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"a < x /\ &0 < e ==> a - e <= x")] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, LIFT_DROP, dist, NORM_1] THEN
      ASM_REAL_ARITH_TAC,
      SIMP_TAC [CONVEX_ON_LEFT_SECANT, IN_INTERVAL_1, DROP_ADD, LIFT_DROP] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"y:real^1 = x") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"y:real^1", ← q r"x:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, ← REAL_ARITH
       (← q r"a < x ==> abs(x - a) = x - a")] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [SEGMENT_1, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [IN_CBALL, IN_INTERVAL_1, dist, NORM_1, DROP_SUB] THEN
      ASM_REAL_ARITH_TAC])

  let CONVEX_ON_LEFT_DIFFERENTIABLE ← prove
   r"!f s a.
        f convex_on s /\ a IN interior s
        ==> (lift o f) differentiable (at a within {x | drop x <= drop a})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [IN_INTERIOR_CBALL]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"(lift o f) differentiable
    (at a within interval(a - lift e,a) INTER {x | drop x <= drop a})")
    MP_TAC THEN
    REWRITE_TAC [VECTOR_DIFFERENTIABLE, HAS_VECTOR_DERIVATIVE_WITHIN_1D] THENL
     [ALL_TAC,
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] LIM_TRANSFORM_WITHIN_SET_IMP) THEN
      REWRITE_TAC [EVENTUALLY_AT] THEN EXISTS_TAC (← q r"e:real") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, IN_INTERVAL_1] THEN
      REWRITE_TAC [DROP_SUB, LIFT_DROP, ← GSYM DIST_NZ, ← GSYM DROP_EQ] THEN
      REWRITE_TAC [DIST_REAL, ← GSYM drop] THEN REAL_ARITH_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER {x | P x} = {x | x IN s /\ P x}")] THEN
    MATCH_MP_TAC INCREASING_LEFT_LIMIT_1_GEN THEN
    REWRITE_TAC [IS_INTERVAL_INTERVAL] THEN
    REWRITE_TAC [DROP_CMUL, o_DEF, DROP_SUB, LIFT_DROP] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
    EXISTS_TAC (← q r"(f(a + lift e) - f a) / norm((a + lift e) - a)") THEN
    SUBGOAL_THEN (← q r"f convex_on cball(a:real^1,e)") MP_TAC THENL
     [ASM_MESON_TAC [CONVEX_ON_SUBSET], ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (CONJ_TAC THEN X_GEN_TAC (← q r"x:real^1") THEN MP_TAC th)) THENL
     [SIMP_TAC [CONVEX_ON_MID_SECANT, IN_INTERVAL_1, DROP_SUB, LIFT_DROP] THEN
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"a + lift e", ← q r"a:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, ← REAL_ARITH
       (← q r"x < a ==> abs(a - x) = --(x - a)")] THEN
      REWRITE_TAC [real_div, REAL_INV_NEG] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(x - y) * --inv z:real = (y - x) / z")] THEN
      REWRITE_TAC [← GSYM real_div] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [IN_CBALL, SEGMENT_1, DROP_ADD, LIFT_DROP] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x < a /\ &0 < e ==> x <= a + e")] THEN
      SIMP_TAC [IN_INTERVAL_1, DROP_ADD, DROP_SUB, LIFT_DROP, dist, NORM_1] THEN
      ASM_REAL_ARITH_TAC,
      SIMP_TAC [CONVEX_ON_LEFT_SECANT, IN_INTERVAL_1, DROP_SUB, LIFT_DROP] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"y:real^1") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"y:real^1 = x") THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM DROP_EQ]) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:real^1", ← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, ← REAL_ARITH
       (← q r"x < a ==> abs(x - a) = --(x - a)")] THEN
      REWRITE_TAC [real_div, REAL_INV_NEG] THEN
      ANTS_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
      ASM_REWRITE_TAC [SEGMENT_1, ← GSYM REAL_NOT_LT] THEN
      REWRITE_TAC [IN_CBALL, IN_INTERVAL_1, dist, NORM_1, DROP_SUB] THEN
      ASM_REAL_ARITH_TAC])

  let CONVEX_ON_DIRECTIONAL_DERIVATIVES ← prove
   r"!f s a.
        f convex_on s /\ a IN interior s
        ==> ?l r. ((lift o f) has_vector_derivative l)
                   (at a within {x | drop x <= drop a}) /\
                  ((lift o f) has_vector_derivative r)
                   (at a within {x | drop a <= drop x}) /\
                  drop l <= drop r"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool", ← q r"a:real^1"]
          CONVEX_ON_RIGHT_DIFFERENTIABLE) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool", ← q r"a:real^1"]
          CONVEX_ON_LEFT_DIFFERENTIABLE) THEN
    ASM_REWRITE_TAC [VECTOR_DIFFERENTIABLE, IMP_IMP] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^1") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real^1") THEN
    SIMP_TAC [HAS_VECTOR_DERIVATIVE_WITHIN_1D] THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE
      [← TAUT (← q r"p /\ q /\ r /\ s /\ t ==> u <=> (p /\ q) /\ t ==> r /\ s ==> u")]
      LIMIT_PAIR_DROP_LE) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [TRIVIAL_LIMIT_WITHIN, LIMPT_APPROACHABLE, IN_ELIM_THM] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
       [EXISTS_TAC (← q r"a - lift(e / &2)"),
        EXISTS_TAC (← q r"a + lift(e / &2)")] THEN
      REWRITE_TAC [DIST_1, DROP_SUB, DROP_ADD, LIFT_DROP, ← GSYM DROP_EQ] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [] THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP EVENTUALLY_WITHIN_INTERIOR_INTER th)])) THEN
      GEN_REWRITE_TAC I [EVENTUALLY_WITHIN] THEN
      EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_INTER, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"u:real^1") THEN STRIP_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
       pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP EVENTUALLY_WITHIN_INTERIOR_INTER th)])) THEN
      REWRITE_TAC [EVENTUALLY_WITHIN] THEN
      EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_INTER, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"v:real^1") THEN STRIP_TAC THEN
      REWRITE_TAC [DROP_CMUL, DROP_SUB, LIFT_DROP, o_DEF] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONVEX_ON_MID_SECANT]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:real^1", ← q r"v:real^1", ← q r"a:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [SEGMENT_1] THEN
        COND_CASES_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
        ASM_REWRITE_TAC [OPEN_CLOSED_INTERVAL_1, IN_DIFF, IN_INSERT] THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, NOT_IN_EMPTY] THEN
        ASM_MESON_TAC [REAL_LT_REFL, DIST_REFL],
        GEN_REWRITE_TAC (LAND_CONV o LAND_CONV)
         [← REAL_ARITH (← q r"(a - u) / e:real = (u - a) * --inv e")] THEN
        MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THEN
        REWRITE_TAC [real_div, ← GSYM REAL_INV_NEG] THEN
        REPEAT AP_TERM_TAC THEN ASM_REAL_ARITH_TAC]])

  let CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS ← prove
   r"!f s. f convex_on s /\ is_interval s /\ open s
         ==> ?l r. (!x. x IN s ==> ((lift o f) has_vector_derivative l(x))
                                   (at x within {t | drop t <= drop x})) /\
                   (!x. x IN s ==> ((lift o f) has_vector_derivative r(x))
                                   (at x within {t | drop x <= drop t})) /\
                   (!x. x IN s ==> drop(l x) <= drop(r x)) /\
                   (!x y. x IN s /\ y IN s /\ drop x < drop y
                          ==> drop(r x) <= drop(l y))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool"]
          CONVEX_ON_DIRECTIONAL_DERIVATIVES) THEN
    ASM_SIMP_TAC [INTERIOR_OPEN] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:real^1->real^1") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real^1->real^1") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN TRANS_TAC REAL_LE_TRANS
     (← q r"(f y - f x) / norm(y - x:real^1)") THEN
    CONJ_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1"))),
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real^1")))] THEN
    ASM_REWRITE_TAC [VECTOR_DIFFERENTIABLE,
                     HAS_VECTOR_DERIVATIVE_WITHIN_1D] THEN
    REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] LIM_DROP_UBOUND)) THEN
      SUBGOAL_THEN (← q r"(x:real^1) IN interior s") MP_TAC THENL
       [ASM_MESON_TAC [INTERIOR_OPEN], ALL_TAC],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] LIM_DROP_LBOUND)) THEN
      SUBGOAL_THEN (← q r"(y:real^1) IN interior s") MP_TAC THENL
       [ASM_MESON_TAC [INTERIOR_OPEN], ALL_TAC]] THEN
    REWRITE_TAC [NON_TRIVIAL_LIMIT_LEFT, NON_TRIVIAL_LIMIT_RIGHT] THEN
    DISCH_THEN (fun th => tactic_of do
     pure (ONCE_REWRITE_TAC [← GSYM (← MATCH_MP EVENTUALLY_WITHIN_INTERIOR_INTER th)])) THEN
    REWRITE_TAC [EVENTUALLY_WITHIN, IN_INTER, IN_ELIM_THM, DROP_CMUL] THEN
    EXISTS_TAC (← q r"drop y - drop x") THEN ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    REWRITE_TAC [o_DEF, DROP_SUB, LIFT_DROP] THEN
    X_GEN_TAC (← q r"z:real^1") THEN REWRITE_TAC [← GSYM DIST_NZ, ← GSYM DROP_EQ] THEN
    STRIP_TAC THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM real_div)] THENL
     [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONVEX_ON_LEFT_SECANT]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1", ← q r"z:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB, real_abs, REAL_LT_IMP_LE, REAL_SUB_LE] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [SEGMENT_1, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [IN_INTERVAL_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [DIST_1]) THEN ASM_REAL_ARITH_TAC,
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE I [CONVEX_ON_RIGHT_SECANT]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1", ← q r"z:real^1"]) THEN
      ASM_SIMP_TAC [NORM_1, DROP_SUB] THEN ANTS_TAC THENL
       [ASM_SIMP_TAC [SEGMENT_1, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [IN_INTERVAL_1] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [DIST_1]) THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        ASM_SIMP_TAC [real_abs, REAL_SUB_LE] THEN
        GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM REAL_NEG_SUB] THEN
        REWRITE_TAC [real_div, REAL_INV_NEG] THEN REAL_ARITH_TAC]])

  let CONVEX_ON_COUNTABLE_NONDIFFERENTIABLE ← prove
   r"!f s.
      f convex_on s /\ COUNTABLE(components s)
      ==> COUNTABLE {x:real^1 | x IN s /\ ~((lift o f) differentiable at x)}"
   (REPEAT STRIP_TAC THEN
    SUBST1_TAC (← ISPEC (← q r"s:real^1->bool") UNIONS_COMPONENTS) THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC
     (← q r"UNIONS {{x:real^1 | x IN c /\ ~((lift o f) differentiable at x)} |
            c IN components s}") THEN
    CONJ_TAC THENL
     [ALL_TAC, REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC []] THEN
    MATCH_MP_TAC COUNTABLE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"c:real^1->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(f:real^1->real) convex_on c /\ connected c")  MP_TAC THENL
     [ASM_MESON_TAC [CONVEX_ON_SUBSET, IN_COMPONENTS_CONNECTED,
                     IN_COMPONENTS_SUBSET],
      REWRITE_TAC [← GSYM IS_INTERVAL_CONNECTED_1] THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN STRIP_TAC] THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC
     (← q r"frontier c UNION
    {x:real^1 | x IN interior c /\ ~((lift o f) differentiable at x)}") THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [COUNTABLE_UNION, FINITE_IMP_COUNTABLE,
                    CARD_FRONTIER_INTERVAL_1] THEN
      SUBGOAL_THEN (← q r"is_interval(interior c:real^1->bool)") MP_TAC THENL
       [ASM_MESON_TAC [IS_INTERVAL_CONVEX_1, CONVEX_INTERIOR],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(f:real^1->real) convex_on interior c") MP_TAC THENL
       [ASM_MESON_TAC [INTERIOR_SUBSET, CONVEX_ON_SUBSET],
        MP_TAC (← ISPEC (← q r"c:real^1->bool") OPEN_INTERIOR)] THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN
      SPEC_TAC (← q r"interior c:real^1->bool", ← q r"c:real^1->bool"),
      REWRITE_TAC [frontier] THEN
      MP_TAC (← ISPEC (← q r"c:real^1->bool") CLOSURE_SUBSET) THEN SET_TAC []] THEN
    X_GEN_TAC (← q r"s:real^1->bool") THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real", ← q r"s:real^1->bool"]
          CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real^1->real^1", ← q r"r:real^1->real^1"] THEN
    STRIP_TAC THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN
    EXISTS_TAC (← q r"{x:real^1 | x IN s /\ drop(l x) < drop(r x)}") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:real^1") THEN
      ASM_CASES_TAC (← q r"(x:real^1) IN s") THEN ASM_SIMP_TAC [REAL_LT_LE, DROP_EQ] THEN
      REWRITE_TAC [CONTRAPOS_THM, VECTOR_DIFFERENTIABLE] THEN DISCH_TAC THEN
      REWRITE_TAC [HAS_VECTOR_DERIVATIVE_AT_1D] THEN
      EXISTS_TAC (← q r"(r:real^1->real^1) x") THEN
      ONCE_REWRITE_TAC [TWO_SIDED_LIMIT_AT] THEN
      REWRITE_TAC [← GSYM HAS_VECTOR_DERIVATIVE_WITHIN_1D] THEN
      ASM_SIMP_TAC [ETA_AX] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      ASM_SIMP_TAC []] THEN
    MP_TAC (← ISPECL
     [← q r"\x. interval((l:real^1->real^1) x,r x)",
      ← q r"{x:real^1 | x IN s /\ drop (l x) < drop (r x)}"]
     COUNTABLE_IMAGE_INJ_EQ) THEN
    SIMP_TAC [EQ_INTERVAL, INTERVAL_EQ_EMPTY_1, IN_ELIM_THM] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REPEAT (CONJ_TAC THENL [MESON_TAC [], ALL_TAC]) THEN
      REWRITE_TAC [FORALL_DROP, LIFT_DROP] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN REPEAT STRIP_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC COUNTABLE_DISJOINT_OPEN_SUBSETS THEN
    REWRITE_TAC [FORALL_IN_IMAGE, OPEN_INTERVAL] THEN
    REWRITE_TAC [PAIRWISE_IMAGE] THEN REWRITE_TAC [pairwise, IN_ELIM_THM] THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LT THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP, DISJOINT, DISJOINT_INTERVAL_1] THEN
    ASM_MESON_TAC [])

  pure { CONVEX_ON_RIGHT_DIFFERENTIABLE, CONVEX_ON_LEFT_DIFFERENTIABLE,
         CONVEX_ON_DIRECTIONAL_DERIVATIVES, CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS,
         CONVEX_ON_COUNTABLE_NONDIFFERENTIABLE }

/- ------------------------------------------------------------------------- -/
/- Convex functions R^1->R^1 are indefinite integrals of increasing ones.   -/
/- (integration.ml 22316-22436)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBQ where
  CONVEX_ON_INDEFINITE_INTEGRAL_INCREASING : thm
  CONVEX_ON_IS_INDEFINITE_INTEGRAL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBQ [HolBase] (D : IntegrationDeps) (BINC : INC) (BINE : INE) (BINI : INI) (BINL : INL) (BINO : INO) (BINQ : INQ) (BINAJ : INAJ) (BINAS : INAS) (BINAU : INAU) (BINBP : INBP) : ExceptT String IO INBQ := do
  -- @@SCOPE BEGIN
  let { HAS_INTEGRAL_INTEGRAL, .. } := BINC
  let { HAS_INTEGRAL_INTEGRABLE_INTEGRAL, .. } := BINE
  let { INTEGRAL_DROP_LE, .. } := BINI
  let { INTEGRAL_COMBINE, .. } := BINL
  let { HAS_INTEGRAL_AFFINITY, .. } := BINO
  let { INTEGRABLE_ON_SUBINTERVAL, .. } := BINQ
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG, .. } := BINAJ
  let { INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, .. } := BINAS
  let { INTEGRABLE_INCREASING_1, .. } := BINAU
  let { CONVEX_ON_COUNTABLE_NONDIFFERENTIABLE, CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS,
        .. } := BINBP
  let { DE_MORGAN_THM, DIMINDEX_1, ETA_AX, .. } := D.dv.dg.pt.cvx.core1
  let { IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, PAIR_EQ, REAL_ADD_SYM, ..
        } := D.dv.dg.pt.cvx.core3
  let { REAL_LE_LT, REAL_LE_TRANS, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_POW_ONE, REAL_WLOG_LE, SUBSET, .. } := D.dv.dg.pt.cvx.core5
  let { o_DEF, .. } := D.dv.dg.pt.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, FORALL_DROP, FORALL_LIFT, LIFT_DROP, .. } :=
        D.dv.dg.pt.cvx.vec2
  let { VECTOR_MUL_ASSOC, VECTOR_MUL_LID, .. } := D.dv.dg.pt.cvx.vec4
  let { CONTINUOUS_ON_SUBSET, .. } := D.dv.dg.pt.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, INTERVAL_SUBSET_IS_INTERVAL, .. } :=
        D.dv.dg.pt.cvx.top4
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, .. } := D.dv.dg.pt.cvx
  let { DROP_NEG, .. } := D.dv.dg.pt.qvec
  let { CONVEX_INTERVAL, IS_INTERVAL_CONNECTED_1, .. } := D.dv.dg.qconvex
  let { COMPONENTS_EQ_SING, .. } := D.dv.dg.qtopology1
  let { SUBSET_INTERVAL_1, .. } := D.dv.dg.qtopology2
  let { CONTINUOUS_MIDPOINT_CONVEX, CONVEX_ON_CONTINUOUS, .. } := D.qconvex
  let { HAS_VECTOR_DERIVATIVE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET,
        VECTOR_DERIVATIVE_UNIQUE_WITHIN_CLOSED_INTERVAL, VECTOR_DIFFERENTIABLE, .. } :=
        D.qderivatives
  let { COUNTABLE_INSERT, COUNTABLE_SING, .. } := D.qcard
  let { CONS_11, .. } := D.qsession
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.qtopology
  let { DROP_MIDPOINT, MIDPOINT_SYM, .. } := D.qvec
  -- @@SCOPE END

  let CONVEX_ON_INDEFINITE_INTEGRAL_INCREASING ← prove
   r"!f a b.
        (!x y. x IN interval[a,b] /\ y IN interval[a,b] /\ drop x <= drop y
               ==> drop(f x) <= drop(f y))
        ==> (\x. drop(integral (interval[a,x]) f)) convex_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MIDPOINT_CONVEX THEN
    REWRITE_TAC [o_DEF, LIFT_DROP, CONVEX_INTERVAL] THEN
    ASM_SIMP_TAC [INTEGRABLE_INCREASING_1,
                  INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT] THEN
    REWRITE_TAC [FORALL_LIFT] THEN MATCH_MP_TAC REAL_WLOG_LE THEN
    CONJ_TAC THENL [MESON_TAC [REAL_ADD_SYM, MIDPOINT_SYM], ALL_TAC] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP, IN_INTERVAL_1] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^1", ← q r"y:real^1"] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:real^1->real^1",
      ← q r"integral(interval[midpoint(x,y),y]) (f:real^1->real^1)",
      ← q r"interval[midpoint(x:real^1,y),y:real^1]", ← q r"&1",
      ← q r"inv(&2) % (y - x):real^1"] HAS_INTEGRAL_AFFINITY) THEN
    REWRITE_TAC [← GSYM HAS_INTEGRAL_INTEGRAL, DIMINDEX_1, REAL_POW_ONE,
                 IMAGE_AFFINITY_INTERVAL, INTERVAL_EQ_EMPTY_1] THEN
    ASM_SIMP_TAC [DROP_MIDPOINT, ← REAL_ARITH
     (← q r"x <= y ==> ~(y < (x + y) / &2)")] THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"a:real^1"] INTEGRAL_COMBINE) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← ISPECL [← q r"y:real^1", ← q r"x:real^1"] th) THEN
            MP_TAC (← ISPECL [← q r"midpoint(x:real^1,y)", ← q r"x:real^1"] th))) THEN
    MP_TAC (← ISPECL [← q r"f:real^1->real^1", ← q r"x:real^1", ← q r"y:real^1",
                      ← q r"midpoint(x:real^1,y)"] INTEGRAL_COMBINE) THEN
    ASM_SIMP_TAC [DROP_MIDPOINT, ← REAL_ARITH (← q r"x <= (x + y) / &2 <=> x <= y"),
          ← REAL_ARITH (← q r"(x + y) / &2 <= y <=> x <= y")] THEN
    REPEAT (ANTS_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
      ASM_SIMP_TAC [INTEGRABLE_INCREASING_1, SUBSET_INTERVAL_1, DROP_MIDPOINT,
                    INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT] THEN
      ASM_REAL_ARITH_TAC,
      TRY (DISCH_THEN (SUBST1_TAC o SYM))]) THEN
    REWRITE_TAC [DROP_ADD, VECTOR_MUL_LID, ← REAL_ARITH
     (← q r"a + x <= (a + a + x + y) / &2 <=> x <= y")] THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (SUBST1_TAC o SYM)) THEN
    SUBGOAL_THEN
     (← q r"interval[midpoint(x,y) + --(&1 / &2 % (y - x)),y + --(&1 / &2 % (y - x))] =
    interval[x:real^1,midpoint(x,y)]")
    SUBST1_TAC THENL
     [AP_TERM_TAC THEN REWRITE_TAC [PAIR_EQ, CONS_11] THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_MIDPOINT, DROP_NEG,
                   DROP_SUB] THEN
      REAL_ARITH_TAC,
      DISCH_TAC] THEN
    MATCH_MP_TAC INTEGRAL_DROP_LE THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
      ASM_SIMP_TAC [INTEGRABLE_INCREASING_1, SUBSET_INTERVAL_1, DROP_MIDPOINT,
                    INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT] THEN
      ASM_REAL_ARITH_TAC,
      X_GEN_TAC (← q r"z:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_MIDPOINT] THEN
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_ADD, DROP_CMUL, DROP_SUB] THEN
      ASM_REAL_ARITH_TAC])

  let CONVEX_ON_IS_INDEFINITE_INTEGRAL ← prove
   r"!f s. (drop o f) convex_on s /\ is_interval s /\ open s
         ==> ?f'. (!x y. x IN s /\ y IN s /\ drop x <= drop y
                         ==> drop(f' x) <= drop(f' y)) /\
                  (!x y. x IN s /\ y IN s /\ drop x <= drop y
                         ==> (f' has_integral (f y - f x)) (interval[x,y]))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:real^1->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    MP_TAC (← ISPECL [← q r"(drop o f):real^1->real", ← q r"s:real^1->bool"]
          CONVEX_ON_DIRECTIONAL_DERIVATIVE_FUNCTIONS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_DEF, LIFT_DROP, ETA_AX] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real^1->real^1", ← q r"r:real^1->real^1"] THEN
    STRIP_TAC THEN EXISTS_TAC (← q r"l:real^1->real^1") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LE_TRANS, REAL_LE_LT, DROP_EQ], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_STRONG THEN
    MP_TAC (← ISPECL [← q r"(drop o f):real^1->real", ← q r"s:real^1->bool"]
          CONVEX_ON_COUNTABLE_NONDIFFERENTIABLE) THEN
    SUBGOAL_THEN (← q r"components(s:real^1->bool) = {s}") SUBST1_TAC THENL
     [ASM_REWRITE_TAC [COMPONENTS_EQ_SING, ← GSYM IS_INTERVAL_CONNECTED_1],
      ASM_REWRITE_TAC [COUNTABLE_SING, o_DEF, LIFT_DROP, ETA_AX]] THEN
    DISCH_TAC THEN
    EXISTS_TAC (← q r"a INSERT b INSERT
              {x | x IN s /\ ~((f:real^1->real^1) differentiable at x)}") THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:real^1->bool") THEN
      ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL] THEN
      MP_TAC (← ISPECL [← q r"(drop o f):real^1->real", ← q r"s:real^1->bool"]
          CONVEX_ON_CONTINUOUS) THEN
      ASM_REWRITE_TAC [o_DEF, LIFT_DROP, ETA_AX],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_DIFF, IN_INSERT, IN_ELIM_THM] THEN
    REWRITE_TAC [DE_MORGAN_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN (← q r"(x:real^1) IN s") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL],
      ASM_REWRITE_TAC [] THEN STRIP_TAC] THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_AT_WITHIN THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"l':real^1") o
      GEN_REWRITE_RULE I [VECTOR_DIFFERENTIABLE]) THEN
    SUBGOAL_THEN (← q r"(l:real^1->real^1) x = l'")
     (fun th => ASM_REWRITE_TAC [th]) THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_UNIQUE_WITHIN_CLOSED_INTERVAL THEN
    MAP_EVERY EXISTS_TAC
     [← q r"f:real^1->real^1", ← q r"a:real^1", ← q r"x:real^1", ← q r"x:real^1"] THEN
    REWRITE_TAC [IN_INTERVAL_1] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, ← GSYM DROP_EQ]) THEN
    ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_AT_WITHIN] THEN
    REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"{t | drop t <= drop x}") THEN ASM_SIMP_TAC [] THEN
    REWRITE_TAC [SUBSET, IN_INTERVAL_1, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  pure { CONVEX_ON_INDEFINITE_INTEGRAL_INCREASING, CONVEX_ON_IS_INDEFINITE_INTEGRAL }

/- ------------------------------------------------------------------------- -/
/- Absolute continuity, first a "set function" form.                        -/
/- (integration.ml 22437-22743)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBR where
  absolutely_setcontinuous_on : thm
  ABSOLUTELY_SETCONTINUOUS_COMPARISON : thm
  ABSOLUTELY_SETCONTINUOUS_ON_EQ : thm
  ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE : thm
  ABSOLUTELY_SETCONTINUOUS_ON_ALT : thm
  ABSOLUTELY_SETCONTINUOUS_ON_LIFT_ABS : thm
  ABSOLUTELY_SETCONTINUOUS_ON_SUBSET : thm
  ABSOLUTELY_SETCONTINUOUS_ON_NORM : thm
  ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR : thm
  ABSOLUTELY_SETCONTINUOUS_ON_0 : thm
  ABSOLUTELY_SETCONTINUOUS_ON_CMUL : thm
  ABSOLUTELY_SETCONTINUOUS_ON_NEG : thm
  ABSOLUTELY_SETCONTINUOUS_ON_ADD : thm
  ABSOLUTELY_SETCONTINUOUS_ON_SUB : thm
  ABSOLUTELY_SETCONTINUOUS_ON_NULL : thm
  ABSOLUTELY_SETCONTINUOUS_ON_VSUM : thm
  ABSOLUTELY_SETCONTINUOUS_ON_MUL : thm
  deriving Inhabited

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 8192 in
@[nospecialize]
def setupINBR [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINW : INW) (BINX : INX) : ExceptT String IO INBR := do
  -- @@SCOPE BEGIN
  let { CONTENT_0_SUBSET_GEN, CONTENT_POS_LE, .. } := BINA
  let { division_of, DIVISION_OF_FINITE, DIVISION_OF_SUBSET, DIVISION_OF_UNION_SELF,
        FORALL_IN_DIVISION_NONEMPTY, .. } := BINB
  let { SET_VARIATION_0, .. } := BINW
  let { SET_VARIATION_TRIANGLE, .. } := BINX
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, DISJOINT, ETA_AX, EXTENSION, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_NUMSEG, FINITE_RESTRICT, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_DIFF, .. } := D.dv.dg.pt.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNION, LE_1, LEFT_IMP_EXISTS_THM, MONO_AND,
        MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_IN_EMPTY, NOT_LE, NUMSEG_EMPTY, .. } :=
        D.dv.dg.pt.cvx.core3
  let { REAL_LE_LADD, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_DIV,
        REAL_LT_INF_FINITE, REAL_LT_MIN, REAL_LT_RDIV_EQ, .. } := D.dv.dg.pt.cvx.core4
  let { REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LT, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET_RESTRICT, SUBSET_TRANS, .. } :=
        D.dv.dg.pt.cvx.core5
  let { o_DEF, o_THM, real_abs, SUM_0, SUM_ADD, SUM_BOUND_LT_GEN, SUM_CLAUSES, SUM_LE,
        SUM_POS_LE, SUM_RMUL, SUM_SUBSET_SIMPLE, SUM_SWAP, SUM_UNION, SWAP_FORALL_THM, .. }
        := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { COMPONENT_LE_NORM, .. } := D.dv.dg.pt.cvx.vec1
  let { LIFT_DROP, NORM_0, NORM_1, .. } := D.dv.dg.pt.cvx.vec2
  let { NORM_LE_L1, NORM_LIFT, NORM_MUL, NORM_NEG, NORM_POS_LE, NORM_TRIANGLE,
        REAL_ABS_NORM, .. } := D.dv.dg.pt.cvx.vec3
  let { drop, linear, VECTOR_NEG_COMPONENT, VSUM_CLAUSES, VSUM_NEG, .. } :=
        D.dv.dg.pt.cvx.vec4
  let { ASM_MESON_TAC, MESON_TAC, new_definition, NORM_ARITH, parse_as_infix, REAL_ARITH,
        REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC, .. }
        := D.dv.dg.pt.cvx
  let { REAL_ABS_ABS, REAL_LT_MUL2, .. } := D.dv.qsession
  let { LINEAR_BOUNDED_POS, .. } := D.dv.qvec
  let { REAL_LET_TOTAL, SUM_MUL_BOUND, .. } := D.qsession
  let { NORM_REAL, VSUM_COMPONENT, VSUM_NORM, .. } := D.qvec
  -- @@SCOPE END

  parse_as_infix ("absolutely_setcontinuous_on", (12, "right"))

  let absolutely_setcontinuous_on ← new_definition
   r"(f:(real^M->bool)->real^N) absolutely_setcontinuous_on s <=>
        !e. &0 < e
            ==> ?r. &0 < r /\
                    !d t. d division_of t /\ t SUBSET s /\ sum d content < r
                          ==> sum d (\k. norm(f k)) < e"

  let ABSOLUTELY_SETCONTINUOUS_COMPARISON ← prove
   r"!f:(real^M->bool)->real^N g:(real^M->bool)->real^P s.
        f absolutely_setcontinuous_on s /\
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> norm(g(interval[a,b])) <= norm(f(interval[a,b])))
        ==> g absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [absolutely_setcontinuous_on] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    MATCH_MP_TAC SUM_LE THEN
    CONJ_TAC THENL [ASM_MESON_TAC [division_of], ALL_TAC] THEN FIRST_ASSUM
     (fun th => tactic_of do
        pure (ONCE_REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let ABSOLUTELY_SETCONTINUOUS_ON_EQ ← prove
   r"!f g:(real^M->bool)->real^N s.
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s
               ==> f(interval[a,b]) = g(interval[a,b])) /\
        f absolutely_setcontinuous_on s
        ==> g absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      ABSOLUTELY_SETCONTINUOUS_COMPARISON) THEN
    ASM_SIMP_TAC [REAL_LE_REFL])

  let ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE ← prove
   r"!f:(real^M->bool)->real^N s.
        f absolutely_setcontinuous_on s <=>
        !i. 1 <= i /\ i <= dimindex(:N)
            ==> (\k. lift(f k$i)) absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [absolutely_setcontinuous_on, NORM_LIFT] THEN EQ_TAC THENL
     [DISCH_TAC THEN
      X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
      MATCH_MP_TAC SUM_LE THEN REWRITE_TAC [COMPONENT_LE_NORM] THEN
      ASM_MESON_TAC [division_of],
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
      ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &(dimindex(:N))")) THEN
      ASM_SIMP_TAC [REAL_OF_NUM_LT, REAL_LT_DIV, LE_1, DIMINDEX_GE_1] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:num->real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"inf (IMAGE B (1..dimindex(:N)))") THEN
      SIMP_TAC [REAL_LT_INF_FINITE, FINITE_IMAGE, FINITE_NUMSEG,
                IMAGE_EQ_EMPTY, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, IN_NUMSEG] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real^M->bool", ← q r"d:(real^M->bool)->bool"] THEN
      STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
      TRANS_TAC REAL_LET_TRANS
        (← q r"sum (d:(real^M->bool)->bool)
           (\k. sum (1..dimindex (:N))
                    (\i. abs(((f:(real^M->bool)->real^N) k)$i)))") THEN
      ASM_SIMP_TAC [SUM_LE, NORM_LE_L1] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) SUM_SWAP o lhand o snd) THEN
      ASM_REWRITE_TAC [FINITE_NUMSEG] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC SUM_BOUND_LT_GEN THEN
      REWRITE_TAC [FINITE_NUMSEG, NUMSEG_EMPTY, ← GSYM NOT_LE, DIMINDEX_GE_1] THEN
      REWRITE_TAC [CARD_NUMSEG_1, IN_NUMSEG] THEN ASM_MESON_TAC []])

  let ABSOLUTELY_SETCONTINUOUS_ON_ALT ← prove
   r"!f:(real^M->bool)->real^N s.
         f absolutely_setcontinuous_on s <=>
         !e. &0 < e
             ==> ?r. &0 < r /\
                     !d t. d division_of t /\ t SUBSET s /\ sum d content < r
                           ==> norm(vsum d f) < e"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [absolutely_setcontinuous_on] THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
      MATCH_MP_TAC VSUM_NORM THEN ASM_MESON_TAC [DIVISION_OF_FINITE],
      ALL_TAC] THEN
    DISCH_TAC THEN
    ONCE_REWRITE_TAC [ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE] THEN
    X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
    REWRITE_TAC [absolutely_setcontinuous_on] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"d = {k | k IN d /\ &0 <= (f:(real^M->bool)->real^N) k$i} UNION
        {k | k IN d /\ (f:(real^M->bool)->real^N) k$i < &0}")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_UNION] THEN
      MESON_TAC [REAL_LET_TOTAL],
      ALL_TAC] THEN
    W (MP_TAC o PART_MATCH (lhs o rand) SUM_UNION o lhand o snd) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [FINITE_RESTRICT] THEN ANTS_TAC THENL
     [REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      REAL_ARITH_TAC,
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e")) THEN
    SIMP_TAC [NORM_LIFT, real_abs, ← GSYM REAL_NOT_LE] THEN
    REWRITE_TAC [REAL_NOT_LE] THEN
    ASM_SIMP_TAC [← GSYM VSUM_COMPONENT, ← GSYM VECTOR_NEG_COMPONENT] THEN
    CONJ_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"abs x < a ==> x < a")) THEN
    W (MP_TAC o PART_MATCH lhand COMPONENT_LE_NORM o lhand o snd) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LET_TRANS) THEN
    ASM_SIMP_TAC [VSUM_NEG, FINITE_RESTRICT, NORM_NEG] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o SPECL
     [← q r"d:(real^M->bool)->bool", ← q r"UNIONS d:real^M->bool"]) THEN
    (REPEAT CONJ_TAC THENL
      [MATCH_MP_TAC DIVISION_OF_SUBSET THEN
       EXISTS_TAC (← q r"d:(real^M->bool)->bool") THEN
       REWRITE_TAC [SUBSET_RESTRICT] THEN ASM_MESON_TAC [DIVISION_OF_UNION_SELF],
       MATCH_MP_TAC (← SET_RULE
        (← q r"UNIONS d SUBSET s ==> UNIONS {x | x IN d /\ P x} SUBSET s")) THEN
       RULE_ASSUM_TAC (REWRITE_RULE [division_of]) THEN ASM_REWRITE_TAC [],
       TRANS_TAC REAL_LET_TRANS (← q r"sum (d:(real^M->bool)->bool) content") THEN
       ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
       ASM_REWRITE_TAC [SUBSET_RESTRICT, IN_DIFF, IMP_CONJ] THEN
       FIRST_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC I [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
       REWRITE_TAC [CONTENT_POS_LE]]))

  let ABSOLUTELY_SETCONTINUOUS_ON_LIFT_ABS ← prove
   r"!f:(real^N->bool)->real s.
        (\x. lift(abs(f x))) absolutely_setcontinuous_on s <=>
        (\x. lift(f x)) absolutely_setcontinuous_on s"
   (REWRITE_TAC [absolutely_setcontinuous_on] THEN
    REWRITE_TAC [NORM_LIFT, REAL_ABS_ABS])

  let ABSOLUTELY_SETCONTINUOUS_ON_SUBSET ← prove
   r"!f:(real^M->bool)->real^N s t.
        f absolutely_setcontinuous_on s /\ t SUBSET s
        ==> f absolutely_setcontinuous_on t"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [absolutely_setcontinuous_on] THEN
    ASM_MESON_TAC [SUBSET_TRANS])

  let ABSOLUTELY_SETCONTINUOUS_ON_NORM ← prove
   r"!f:(real^M->bool)->real^N s.
        (\x. lift(norm(f x))) absolutely_setcontinuous_on s <=>
        f absolutely_setcontinuous_on s"
   (REWRITE_TAC [absolutely_setcontinuous_on, NORM_REAL, ← GSYM drop] THEN
    REWRITE_TAC [REAL_ABS_NORM, LIFT_DROP])

  let ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR ← prove
   r"!f:(real^M->bool)->real^N g:real^N->real^P s.
        f absolutely_setcontinuous_on s /\ linear g
        ==> (g o f) absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [absolutely_setcontinuous_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"B:real") o MATCH_MP LINEAR_BOUNDED_POS) THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / B:real")) THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_SIMP_TAC [REAL_LT_RDIV_EQ, ← GSYM SUM_RMUL] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
    MATCH_MP_TAC SUM_LE THEN REWRITE_TAC [o_THM] THEN
    ASM_MESON_TAC [division_of, REAL_MUL_SYM])

  let ABSOLUTELY_SETCONTINUOUS_ON_0 ← prove
   r"!s:real^N->bool. (\x. vec 0) absolutely_setcontinuous_on s"
   (REWRITE_TAC [absolutely_setcontinuous_on, NORM_0, SUM_0] THEN
    MESON_TAC [REAL_LE_REFL])

  let ABSOLUTELY_SETCONTINUOUS_ON_CMUL ← prove
   r"!f:(real^M->bool)->real^N c s.
        f absolutely_setcontinuous_on s
        ==> (\x. c % f x) absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT, o_DEF]
       ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR) THEN
    REWRITE_TAC [linear] THEN VECTOR_ARITH_TAC)

  let ABSOLUTELY_SETCONTINUOUS_ON_NEG ← prove
   r"!f:(real^M->bool)->real^N s.
        (\x. --(f x)) absolutely_setcontinuous_on s <=>
        f absolutely_setcontinuous_on s"
   (REWRITE_TAC [absolutely_setcontinuous_on, NORM_NEG])

  let ABSOLUTELY_SETCONTINUOUS_ON_ADD ← prove
   r"!f:(real^M->bool)->real^N g s.
        f absolutely_setcontinuous_on s /\
        g absolutely_setcontinuous_on s
        ==> (\x. f x + g x) absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_setcontinuous_on] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min B C:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"sum d (\k. norm((f:(real^M->bool)->real^N) k)) +
              sum d (\k. norm((g:(real^M->bool)->real^N) k))") THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    CONJ_TAC THENL
     [ASM_SIMP_TAC [← GSYM SUM_ADD] THEN
      MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [NORM_TRIANGLE],
      ASM_MESON_TAC [← REAL_ARITH (← q r"x < e / &2 /\ y < e / &2 ==> x + y < e")]])

  let ABSOLUTELY_SETCONTINUOUS_ON_SUB ← prove
   r"!f:(real^M->bool)->real^N g s.
        f absolutely_setcontinuous_on s /\
        g absolutely_setcontinuous_on s
        ==> (\x. f x - g x) absolutely_setcontinuous_on s"
   (REWRITE_TAC [← VECTOR_ARITH (← q r"x - y:real^N = x + --y")] THEN
    SIMP_TAC [ABSOLUTELY_SETCONTINUOUS_ON_ADD, ABSOLUTELY_SETCONTINUOUS_ON_NEG])

  let ABSOLUTELY_SETCONTINUOUS_ON_NULL ← prove
   r"!f:(real^M->bool)->real^N s.
        (!a b. ~(interval[a,b] = {}) /\ interval[a,b] SUBSET s /\
               content(interval[a,b]) = &0
               ==> f(interval[a,b]) = vec 0) /\
        content s = &0 /\ bounded s
        ==> f absolutely_setcontinuous_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC ABSOLUTELY_SETCONTINUOUS_COMPARISON THEN
    EXISTS_TAC (← q r"(\x. vec 0):(real^M->bool)->real^N") THEN
    REWRITE_TAC [ABSOLUTELY_SETCONTINUOUS_ON_0, ← NORM_ARITH
     (← q r"norm(x:real^N) <= norm(vec 0:real^M) <=> x = vec 0")] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTENT_0_SUBSET_GEN THEN
    EXISTS_TAC (← q r"s:real^M->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [division_of, SUBSET_TRANS])

  let ABSOLUTELY_SETCONTINUOUS_ON_VSUM ← prove
   r"!f:A->(real^M->bool)->real^N s k.
        FINITE k /\
        (!i. i IN k ==> f i absolutely_setcontinuous_on s)
        ==> (\x. vsum k (\i. f i x)) absolutely_setcontinuous_on s"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, VSUM_CLAUSES, FORALL_IN_INSERT] THEN
    SIMP_TAC [SET_VARIATION_0, REAL_LE_REFL, ABSOLUTELY_SETCONTINUOUS_ON_0,
              ABSOLUTELY_SETCONTINUOUS_ON_ADD, ETA_AX] THEN
    REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      SET_VARIATION_TRIANGLE o lhand o snd) THEN
    ASM_SIMP_TAC [ETA_AX] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [REAL_LE_LADD])

  let ABSOLUTELY_SETCONTINUOUS_ON_MUL ← prove
   r"!f g:(real^M->bool)->real^N s.
        f absolutely_setcontinuous_on s /\
        g absolutely_setcontinuous_on s
        ==> (\x. drop(f x) % g x) absolutely_setcontinuous_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [absolutely_setcontinuous_on] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"e / &2")) (MP_TAC o SPEC (← q r"&2"))) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r1:real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"r2:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min r1 r2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"] THEN
    STRIP_TAC THEN REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"d:(real^M->bool)->bool", ← q r"t:real^M->bool"])) THEN
    ASM_REWRITE_TAC [NORM_MUL, ← GSYM NORM_1, IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [← TAUT
     (← q r"p /\ q /\ r /\ s ==> t <=> s /\ q ==> p /\ r ==> t")] REAL_LT_MUL2)) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [SUM_POS_LE, NORM_POS_LE] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"y <= x ==> x < e / &2 * &2 ==> y < e")) THEN
    MATCH_MP_TAC SUM_MUL_BOUND THEN ASM_REWRITE_TAC [NORM_POS_LE])

  pure { absolutely_setcontinuous_on, ABSOLUTELY_SETCONTINUOUS_COMPARISON,
         ABSOLUTELY_SETCONTINUOUS_ON_EQ, ABSOLUTELY_SETCONTINUOUS_ON_COMPONENTWISE,
         ABSOLUTELY_SETCONTINUOUS_ON_ALT, ABSOLUTELY_SETCONTINUOUS_ON_LIFT_ABS,
         ABSOLUTELY_SETCONTINUOUS_ON_SUBSET, ABSOLUTELY_SETCONTINUOUS_ON_NORM,
         ABSOLUTELY_SETCONTINUOUS_ON_COMPOSE_LINEAR, ABSOLUTELY_SETCONTINUOUS_ON_0,
         ABSOLUTELY_SETCONTINUOUS_ON_CMUL, ABSOLUTELY_SETCONTINUOUS_ON_NEG,
         ABSOLUTELY_SETCONTINUOUS_ON_ADD, ABSOLUTELY_SETCONTINUOUS_ON_SUB,
         ABSOLUTELY_SETCONTINUOUS_ON_NULL, ABSOLUTELY_SETCONTINUOUS_ON_VSUM,
         ABSOLUTELY_SETCONTINUOUS_ON_MUL }

/- ------------------------------------------------------------------------- -/
/- Operativity of absolute set-continuity; bounded set variation.           -/
/- (integration.ml 22744-23051)                                             -/
/- ------------------------------------------------------------------------- -/

structure INBS where
  OPERATIVE_ABSOLUTELY_SETCONTINUOUS_ON : thm
  ABSOLUTELY_SETCONTINUOUS_ON_DIVISION : thm
  ABSOLUTELY_SETCONTINUOUS_ON_IMP_HAS_BOUNDED_SETVARIATION_ON : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupINBS [HolBase] (D : IntegrationDeps) (BINA : INA) (BINB : INB) (BINC : INC) (BIND : IND) (BINF : INF) (BING : ING) (BINH : INH) (BINL : INL) (BINW : INW) (BINX : INX) (BINBR : INBR) : ExceptT String IO INBS := do
  -- @@SCOPE BEGIN
  let { CONTENT_CLOSED_INTERVAL_CASES, CONTENT_EMPTY, CONTENT_EQ_0_INTERIOR, CONTENT_POS_LE,
        CONTENT_SUBSET, .. } := BINA
  let { DIVISION_INTER, division_of, DIVISION_OF_FINITE, DIVISION_OF_SELF,
        FORALL_IN_DIVISION, FORALL_IN_DIVISION_NONEMPTY, gauge, .. } := BINB
  let { DIVISION_OF_TAGGED_DIVISION, fine, .. } := BINC
  let { FINE_DIVISION_EXISTS, .. } := BIND
  let { DIVISION_SPLIT, DIVISION_SPLIT_LEFT_INJ, DIVISION_SPLIT_RIGHT_INJ, INTERVAL_SPLIT,
        .. } := BINF
  let { NEUTRAL_LIFTED, operative, OPERATIVE_EMPTY, .. } := BING
  let { OPERATIVE_DIVISION, SUBADDITIVE_CONTENT_DIVISION, .. } := BINH
  let { NEUTRAL_AND, OPERATIVE_DIVISION_AND, .. } := BINL
  let { has_bounded_setvariation_on, .. } := BINW
  let { SET_VARIATION_ON_NULL, .. } := BINX
  let { absolutely_setcontinuous_on, ABSOLUTELY_SETCONTINUOUS_ON_NULL,
        ABSOLUTELY_SETCONTINUOUS_ON_SUBSET, .. } := BINBR
  let { CARD_NUMSEG_1, DIMINDEX_GE_1, EQ_IMP, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT,
        FORALL_IN_GSPEC, .. } := D.dv.dg.pt.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PAIR_THM, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, INTER_SUBSET, ..
        } := D.dv.dg.pt.cvx.core2
  let { IN_IMAGE, LAMBDA_BETA, LEFT_IMP_EXISTS_THM, MONO_FORALL, MONO_IMP, NEUTRAL_REAL_ADD,
        .. } := D.dv.dg.pt.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01, REAL_LT_MIN, .. } :=
        D.dv.dg.pt.cvx.core4
  let { REAL_MUL_RID, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SUBSET_RESTRICT,
        SUBSET_TRANS, .. } := D.dv.dg.pt.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, SUM_ADD, SUM_BOUND, SUM_LE, SUM_SUBSET_SIMPLE, SUM_SUPERSET,
        SUM_SWAP, .. } := D.dv.dg.pt.cvx.core6
  let { REAL_HALF, .. } := D.dv.dg.pt.cvx.misc
  let { IN_INTERVAL, INTERVAL_OPEN_SUBSET_CLOSED, NORM_EQ_0, .. } := D.dv.dg.pt.cvx.vec2
  let { VEC_COMPONENT, VECTOR_ADD_COMPONENT, VECTOR_MUL_COMPONENT, VECTOR_SUB_COMPONENT,
        VSUM_EQ_SUPERSET, .. } := D.dv.dg.pt.cvx.vec4
  let { INTERIOR_INTER, .. } := D.dv.dg.pt.cvx.top4
  let { OPEN_INTERVAL, SUBSET_INTERIOR, .. } := D.dv.dg.pt.cvx.top5
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.dv.dg.pt.cvx
  let { BOUNDED_INTERVAL, .. } := D.dv.dg.pt.qtop
  let { SUBSET_INTERVAL, .. } := D.dv.dg.qvec
  let { REAL_POW_MONO_INV, .. } := D.dv.qsession
  let { PRODUCT_CONST, .. } := D.qproducts
  let { MONOIDAL_REAL_ADD, SUM_IMAGE_NONZERO, .. } := D.qsession
  let { BOUNDED_SUBSET_CLOSED_INTERVAL, EMPTY_AS_INTERVAL, .. } := D.qtopology
  let { INTER_INTERVAL, MONOIDAL_VECTOR_ADD, NEUTRAL_VECTOR_ADD, VSUM, VSUM_IMAGE_NONZERO,
        VSUM_NORM, .. } := D.qvec
  -- @@SCOPE END
  let elc : Nat → thm → ExceptT String IO thm := fun n th => liftExcept (HolCore.Lib.el n (CONJUNCTS th))

  let OPERATIVE_ABSOLUTELY_SETCONTINUOUS_ON ← prove
   r"!f:(real^M->bool)->real^N.
