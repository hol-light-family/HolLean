      HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_SUBINTERVALS) THEN
    REWRITE_TAC [bounded, FORALL_IN_GSPEC, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [INTERVAL_SUBSET_IS_INTERVAL, LEFT_IMP_EXISTS_THM,
                  ← TAUT (← q r"(p \/ q) /\ ~p <=> ~p /\ q")] THEN
    X_GEN_TAC (← q r"B:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"B + norm((f:real^1->real^N) a)") THEN
    X_GEN_TAC (← q r"b:real^1") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← MESON []
      (← q r"(!x y. P x y /\ Q x y ==> R x y)
     ==> (!x y. P x y \/ P y x) /\
         (!x y. (Q x y ==> R x y) <=> (Q y x ==> R y x))
         ==> !x y. Q x y ==> R x y"))) THEN
    REWRITE_TAC [INTERVAL_NE_EMPTY_1, REAL_LE_TOTAL] THEN
    ANTS_TAC THENL [MESON_TAC [NORM_SUB], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:real^1", ← q r"b:real^1"]) THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t))

  let HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED_ON_INTERVAL ← prove
   r"!f:real^1->real^N a b.
        f has_bounded_variation_on interval[a,b]
        ==> bounded(IMAGE f (interval[a,b]))"
   (MESON_TAC [HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED, IS_INTERVAL_INTERVAL])

  let HAS_BOUNDED_VARIATION_ON_BILINEAR ← prove
   r"!bop:real^M->real^N->real^P f g s.
        bilinear bop /\
        f has_bounded_variation_on s /\
        g has_bounded_variation_on s /\
        is_interval s
        ==> (\x. bop (f x) (g x)) has_bounded_variation_on s"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
      (← q r"bounded(IMAGE (f:real^1->real^M) s) /\
     bounded(IMAGE (g:real^1->real^N) s)")
    MP_TAC THENL
     [ASM_SIMP_TAC [HAS_BOUNDED_VARIATION_ON_IMP_BOUNDED],
      REWRITE_TAC [BOUNDED_POS_LT, FORALL_IN_IMAGE]] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"B1:real") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"B2:real") STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
    REWRITE_TAC [has_bounded_variation_on, has_bounded_setvariation_on] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C2:real") (LABEL_TAC "G")) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C1:real") (LABEL_TAC "F")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP BILINEAR_BOUNDED_POS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"D * B1 * C2 + D * B2 * C1:real") THEN
    MAP_EVERY X_GEN_TAC [← q r"d:(real^1->bool)->bool", ← q r"t:real^1->bool"] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
     (← q r"D * B1 * sum d (\k. norm((g:real^1->real^N)(interval_upperbound k) -
                             g(interval_lowerbound k))) +
    D * B2 * sum d (\k. norm((f:real^1->real^M)(interval_upperbound k) -
                             f(interval_lowerbound k)))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_MESON_TAC [REAL_LE_LMUL_EQ]] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIVISION_OF_FINITE) THEN
    ASM_SIMP_TAC [← GSYM SUM_LMUL, ← GSYM SUM_ADD] THEN
    MATCH_MP_TAC SUM_LE THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_IN_DIVISION_NONEMPTY th])) THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real^1", ← q r"v:real^1"] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [INTERVAL_LOWERBOUND_NONEMPTY, INTERVAL_UPPERBOUND_NONEMPTY] THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"norm((bop:real^M->real^N->real^P) (f v) (g v) - bop (f v) (g u)) +
    norm(bop (f v) (g u) - bop (f(u:real^1)) (g u))") THEN
    CONJ_TAC THENL [CONV_TAC (fun t => NORM_ARITH t), ALL_TAC] THEN
    MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← GSYM (← MATCH_MP BILINEAR_LSUB th)] THEN
            REWRITE_TAC [← GSYM (← MATCH_MP BILINEAR_RSUB th)])) THEN
    FIRST_ASSUM (fun th => W (MP_TAC o PART_MATCH lhand th o lhand o snd)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THENL
     [ALL_TAC, GEN_REWRITE_TAC LAND_CONV [REAL_MUL_SYM]] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    (SUBGOAL_THEN (← q r"interval[u:real^1,v] SUBSET s") MP_TAC THENL
     [ASM_MESON_TAC [division_of, SUBSET_TRANS], ALL_TAC]) THEN
    ASM_MESON_TAC [SUBSET, ENDS_IN_INTERVAL])

  let HAS_BOUNDED_VARIATION_ON_MUL ← prove
   r"!f g:real^1->real^N s.
        f has_bounded_variation_on s /\
        g has_bounded_variation_on s /\
        is_interval s
        ==> (\x. drop(f x) % g x) has_bounded_variation_on s"
   (REWRITE_TAC [← REWRITE_RULE []
     (← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] HAS_BOUNDED_VARIATION_ON_BILINEAR)
          BILINEAR_DROP_MUL)])

  let VECTOR_VARIATION_POS_LE ← prove
   r"!f:real^1->real^N s.
        f has_bounded_variation_on s ==> &0 <= vector_variation s f"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    REWRITE_TAC [SET_VARIATION_POS_LE])

  let VECTOR_VARIATION_GE_NORM_FUNCTION ← prove
   r"!f:real^1->real^N s a b.
        f has_bounded_variation_on s /\ segment[a,b] SUBSET s
        ==> norm(f b - f a) <= vector_variation s f"
   (REWRITE_TAC [FORALL_LIFT] THEN GEN_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC REAL_WLOG_LE THEN CONJ_TAC THENL
     [MESON_TAC [SEGMENT_SYM, NORM_SUB], ALL_TAC] THEN
    REWRITE_TAC [FORALL_DROP, LIFT_DROP, has_bounded_variation_on] THEN
    REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
    [← q r"\k. (f:real^1->real^N)(interval_upperbound k) - f(interval_lowerbound k)",
     ← q r"s:real^1->bool", ← q r"a:real^1", ← q r"b:real^1"] SET_VARIATION_GE_FUNCTION) THEN
    ASM_REWRITE_TAC [vector_variation, INTERVAL_NE_EMPTY_1] THEN
    ASM_SIMP_TAC [INTERVAL_UPPERBOUND_1, INTERVAL_LOWERBOUND_1] THEN
    ASM_MESON_TAC [SEGMENT_1])

  let VECTOR_VARIATION_GE_DROP_FUNCTION ← prove
   r"!f s a b.
        f has_bounded_variation_on s /\ segment[a,b] SUBSET s
        ==> drop(f b) - drop(f a) <= vector_variation s f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"norm((f:real^1->real^1) b - f a)") THEN
    ASM_SIMP_TAC [VECTOR_VARIATION_GE_NORM_FUNCTION] THEN
    REWRITE_TAC [NORM_REAL, DROP_SUB, ← GSYM drop] THEN REAL_ARITH_TAC)

  let VECTOR_VARIATION_CONST_EQ ← prove
   r"!f:real^1->real^N s.
        is_interval s /\ f has_bounded_variation_on s
        ==> (vector_variation s f = &0 <=> ?c. !x. x IN s ==> f x = c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN REWRITE_TAC [← MESON []
       (← q r"(?c. !x. P x ==> f x = c) <=> !a b. P a /\ P b ==> f a = f b")] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"s:real^1->bool",
          ← q r"a:real^1", ← q r"b:real^1"] VECTOR_VARIATION_GE_NORM_FUNCTION) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [IS_INTERVAL_CONVEX_1, CONVEX_CONTAINS_SEGMENT],
        ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t)],
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:real^N")) THEN
      MP_TAC (← ISPECL [← q r"f:real^1->real^N", ← q r"(\x. c):real^1->real^N",
                        ← q r"s:real^1->bool"] VECTOR_VARIATION_EQ) THEN
      ASM_SIMP_TAC [VECTOR_VARIATION_CONST]])

  let VECTOR_VARIATION_MONOTONE ← prove
   r"!f s t. f has_bounded_variation_on s /\ t SUBSET s
           ==> vector_variation t f <= vector_variation s f"
   (REWRITE_TAC [has_bounded_variation_on, vector_variation] THEN
    REWRITE_TAC [SET_VARIATION_MONOTONE])

  let VECTOR_VARIATION_NEG ← prove
   r"!f:real^1->real^N s.
        vector_variation s (\x. --(f x)) = vector_variation s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [vector_variation, set_variation] THEN
    REWRITE_TAC [← NORM_ARITH (← q r"norm(--x - --y:real^N) = norm(x - y)")])

  let VECTOR_VARIATION_TRIANGLE ← prove
   r"!f g:real^1->real^N s.
        f has_bounded_variation_on s /\ g has_bounded_variation_on s
        ==> vector_variation s (\x. f x + g x)
