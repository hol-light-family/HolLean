  let { INTEGRABLE_SPIKE_SET, INTEGRAL_SPIKE_SET, .. } := BINN
  let { MONOTONE_CONVERGENCE_DECREASING, MONOTONE_CONVERGENCE_INCREASING, .. } := BINU
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := BINV
