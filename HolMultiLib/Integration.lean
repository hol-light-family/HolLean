      COND_CASES_TAC THEN ASM_REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      ASM_SIMP_TAC [UNIT_INTERVAL_NONEMPTY, REAL_LE_MUL] THEN
      REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_RID, ← GSYM LIFT_EQ_CMUL] THEN
