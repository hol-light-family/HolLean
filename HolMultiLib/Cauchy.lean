      REWRITE_TAC [OPEN_BALL, IN_BALL, ← NORM_ARITH (← q r"dist(a,a + b) = norm b")] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < r ==> (abs r * z < r <=> &0 < r * (&1 - z))"),
                   REAL_LT_MUL, REAL_SUB_LT],
      ALL_TAC] THEN
    ANTS_TAC THENL
     [SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"Cx(&0)")) THEN
