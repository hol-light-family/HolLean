  let CEXP_LIMIT ← prove
   r"!z. ((\n. (Cx(&1) + z / Cx(&n)) pow n) --> cexp(z)) sequentially"
   (GEN_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. cexp(Cx(&n) * clog(Cx(&1) + z / Cx(&n)))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [CEXP_N, EVENTUALLY_SEQUENTIALLY] THEN
      MP_TAC (← SPEC (← q r"norm(z:complex) + &1") REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_REWRITE_TAC [LE] THEN DISCH_THEN SUBST_ALL_TAC THEN
        ASM_MESON_TAC [← NORM_ARITH (← q r"~(norm(z:complex) + &1 <= &0)")],
        DISCH_TAC] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC CEXP_CLOG THEN
      ASM_SIMP_TAC [CX_INJ, REAL_OF_NUM_EQ, ← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(n = Cx(&0)) ==> (Cx(&1) + z / n = Cx(&0) <=> z = --n)"))] THEN
      DISCH_THEN (MP_TAC o AP_TERM (← q r"norm:complex->real")) THEN
      REWRITE_TAC [NORM_NEG, COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN
      CONV_TAC (fun t => NORM_ARITH t),
      MATCH_MP_TAC (← ISPEC (← q r"cexp") LIM_CONTINUOUS_FUNCTION) THEN
      REWRITE_TAC [CONTINUOUS_AT_CEXP] THEN
      ONCE_REWRITE_TAC [LIM_NULL_COMPLEX] THEN
      MATCH_MP_TAC LIM_NULL_COMPARISON_COMPLEX THEN
      EXISTS_TAC (← q r"\n. Cx(&2 * norm(z:complex) pow 2) * inv(Cx(&n))") THEN
      SIMP_TAC [LIM_INV_N, LIM_NULL_COMPLEX_LMUL] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      MP_TAC (← SPEC (← q r"&2 * norm(z:complex) + &1") REAL_ARCH_SIMPLE) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
      EXISTS_TAC (← q r"MAX N (MAX 1 2)") THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [← ARITH_RULE (← q r"MAX a b <= c <=> a <= c /\ b <= c")] THEN
      STRIP_TAC THEN
      ASM_SIMP_TAC [CX_INJ, REAL_OF_NUM_EQ, LE_1,
        ← ExceptT.mk (COMPLEX_FIELD (← q r"~(n = Cx(&0)) ==> n * l - z = (l - z / n) * n"))] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, REAL_ABS_NUM,
                  COMPLEX_NORM_INV] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
      REWRITE_TAC [real_div, ← GSYM REAL_MUL_ASSOC, ← GSYM REAL_INV_MUL] THEN
      REWRITE_TAC [← GSYM REAL_POW_2] THEN
      MP_TAC (← ISPECL [← q r"1", ← q r"z / Cx(&n)"] TAYLOR_CLOG) THEN
      REWRITE_TAC [← GSYM CX_ADD, VSUM_SING_NUMSEG, COMPLEX_NORM_CX] THEN
      REWRITE_TAC [VSUM_CLAUSES_NUMSEG] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
      REWRITE_TAC [REAL_ABS_INV, REAL_ABS_NUM, COMPLEX_DIV_1] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [COMPLEX_POW_1, COMPLEX_POW_NEG, COMPLEX_POW_ONE, ARITH] THEN
      REWRITE_TAC [COMPLEX_MUL_LID, REAL_POW_DIV] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a / b / c:real = (a / c) * inv b")] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN
      SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_NORM,
                  REAL_ABS_POW, real_div] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN SIMP_TAC [REAL_POW_LE, NORM_POS_LE] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_INV] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"&1 / &2 <= &1 - x * &1 / n <=> x / n <= &1 / &2")] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN
      ASM_REAL_ARITH_TAC])

  let EXP_LIMIT ← prove
   r"!x. ((\n. (&1 + x / &n) pow n) ---> exp(x)) sequentially"
   (REWRITE_TAC [REALLIM_COMPLEX, o_DEF, CX_POW, CX_ADD, CX_DIV, CX_EXP] THEN
    REWRITE_TAC [CEXP_LIMIT])

  let LIM_LOGPLUS1_OVER_X ← prove
   r"((\x. clog(Cx(&1) + x) / x) --> Cx(&1)) (at(Cx(&0)))"
   (ONCE_REWRITE_TAC [LIM_NULL_COMPLEX] THEN
    MATCH_MP_TAC LIM_NULL_COMPARISON_COMPLEX THEN
    EXISTS_TAC (← q r"\x. Cx(&2) * x") THEN CONJ_TAC THENL
     [ALL_TAC, LIM_TAC THEN REWRITE_TAC [COMPLEX_MUL_RZERO]] THEN
    REWRITE_TAC [EVENTUALLY_AT] THEN EXISTS_TAC (← q r"&1 / &2") THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [dist, COMPLEX_SUB_RZERO, COMPLEX_NORM_NZ] THEN
    X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LE_LCANCEL_IMP THEN EXISTS_TAC (← q r"norm(z:complex)") THEN
    ASM_REWRITE_TAC [← GSYM COMPLEX_NORM_MUL, COMPLEX_NORM_NZ] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
      (← q r"~(z = Cx(&0)) ==> z * (l / z - Cx(&1)) = l - z"))] THEN
    MP_TAC (← ISPECL [← q r"1", ← q r"z:complex"] TAYLOR_CLOG) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [VSUM_SING_NUMSEG]] THEN
    CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [COMPLEX_POW_1, COMPLEX_DIV_1] THEN
    REWRITE_TAC [COMPLEX_POW_NEG, ARITH_EVEN, COMPLEX_POW_ONE] THEN
    REWRITE_TAC [COMPLEX_MUL_LID] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"z * Cx(&2) * z = z pow 2 * Cx(&2)"))] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, real_div, COMPLEX_NORM_CX] THEN
    REWRITE_TAC [← GSYM COMPLEX_NORM_POW] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    REWRITE_TAC [NORM_POS_LE] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_INV] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN ASM_REAL_ARITH_TAC)

  let LIM_N_MUL_SUB_CLOG ← prove
   r"!w z. ((\n. Cx(&n) * (clog(Cx(&n) + w) - clog(Cx(&n) + z))) --> w - z)
         sequentially"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"w:complex = z") THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_REFL, LIM_CONST, COMPLEX_MUL_RZERO] THEN
    MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. (Cx(&n) + z) / (Cx(&1) + z / Cx(&n)) *
                    clog(Cx(&1) + (w - z) / (Cx(&n) + z))") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
      MP_TAC (← SPEC (← q r"max (norm(w:complex)) (norm(z:complex)) + &1")
       REAL_ARCH_SIMPLE) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"&0 < Re(Cx(&n) + w) /\ &0 < Re(Cx(&n) + z)") MP_TAC THENL
       [REWRITE_TAC [RE_ADD, RE_CX] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM REAL_OF_NUM_LE]) THEN CONJ_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"norm z < n /\ abs(Re z) <= norm z ==> &0 < n + Re z")) THEN
        REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN ASM_REAL_ARITH_TAC,
        MAP_EVERY ASM_CASES_TAC
         [← q r"Cx(&n) + w = Cx(&0)", ← q r"Cx(&n) + z = Cx(&0)"] THEN
        ASM_REWRITE_TAC [RE_CX, REAL_LT_REFL] THEN STRIP_TAC] THEN
      SUBGOAL_THEN (← q r"~(Cx(&n) = Cx(&0))") ASSUME_TAC THENL
       [REWRITE_TAC [CX_INJ, REAL_OF_NUM_EQ] THEN DISCH_THEN SUBST_ALL_TAC THEN
        UNDISCH_TAC (← q r"max (norm(w:complex)) (norm (z:complex)) + &1 <= &N") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← CONJUNCT1 LE]) THEN
        ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t),
        ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(n + z = Cx(&0)) /\ ~(n = Cx(&0))
          ==> (n + z) / (Cx(&1) + z / n) = n"))] THEN
        AP_TERM_TAC THEN ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(n + z = Cx(&0))
          ==> Cx(&1) + (w - z) / (n + z) = (n + w) / (n + z)"))] THEN
        REWRITE_TAC [complex_div] THEN IMP_REWRITE_TAC [CLOG_MUL_SIMPLE] THEN
        ASM_REWRITE_TAC [COMPLEX_INV_EQ_0] THEN ASM_SIMP_TAC [CLOG_INV] THEN
        CONJ_TAC THENL [CONV_TAC COMPLEX_RING, REWRITE_TAC [IM_NEG]] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(x) < pi / &2 /\ abs(y) < pi / &2
          ==> --pi < x + --y /\ x + --y <= pi")) THEN
        ASM_SIMP_TAC [RE_CLOG_POS_LT]],
      REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a / b * c:complex = inv b * a * c")] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM COMPLEX_MUL_LID] THEN
      MATCH_MP_TAC LIM_COMPLEX_MUL THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM COMPLEX_INV_1] THEN
        MATCH_MP_TAC LIM_COMPLEX_INV THEN
        CONJ_TAC THENL [ALL_TAC, CONV_TAC COMPLEX_RING] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM COMPLEX_ADD_RID] THEN
        MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST, complex_div] THEN
        SIMP_TAC [LIM_NULL_COMPLEX_LMUL, LIM_INV_N],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(\n. (Cx(&n) + z) * clog (Cx(&1) + (w - z) / (Cx(&n) + z))) =
        (\x. (w - z) * clog(Cx(&1) + x) / x) o (\n. (w - z) / (Cx(&n) + z))")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, complex_div] THEN
        REWRITE_TAC [COMPLEX_INV_MUL, COMPLEX_INV_INV] THEN
        POP_ASSUM MP_TAC THEN CONV_TAC COMPLEX_FIELD,
        ALL_TAC] THEN
      MATCH_MP_TAC LIM_COMPOSE_AT THEN EXISTS_TAC (← q r"Cx(&0)") THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [complex_div] THEN
        SIMP_TAC [LIM_INV_N_OFFSET, LIM_NULL_COMPLEX_LMUL],
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        MP_TAC (← SPEC (← q r"norm(z:complex) + &1") REAL_ARCH_SIMPLE) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN X_GEN_TAC (← q r"n:num") THEN
        STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
        ASM_REWRITE_TAC [COMPLEX_DIV_EQ_0, COMPLEX_SUB_0] THEN
        REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"n + z = Cx(&0) <=> z = --n"))] THEN
        DISCH_TAC THEN UNDISCH_TAC (← q r"norm(z:complex) + &1 <= &N") THEN
        ASM_REWRITE_TAC [NORM_NEG, COMPLEX_NORM_CX] THEN ASM_REAL_ARITH_TAC,
        GEN_REWRITE_TAC LAND_CONV [← GSYM COMPLEX_MUL_RID] THEN
        SIMP_TAC [LIM_COMPLEX_LMUL, LIM_LOGPLUS1_OVER_X]]])

  let LIM_SUB_CLOG ← prove
   r"!w z. ((\n. clog(Cx(&n) + w) - clog(Cx(&n) + z)) --> Cx(&0)) sequentially"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    SUBST1_TAC (← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) = Cx(&0) * (w - z)"))) THEN EXISTS_TAC
     (← q r"\n. inv(Cx(&n)) * Cx(&n) * (clog(Cx(&n) + w) - clog(Cx(&n) + z))") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
      REWRITE_TAC [← ARITH_RULE (← q r"1 <= n <=> ~(n = 0)"), ← GSYM REAL_OF_NUM_EQ] THEN
      REWRITE_TAC [← GSYM CX_INJ] THEN CONV_TAC COMPLEX_FIELD,
      MATCH_MP_TAC LIM_COMPLEX_MUL THEN
      REWRITE_TAC [LIM_INV_N, LIM_N_MUL_SUB_CLOG]])

  pure { CEXP_LIMIT, EXP_LIMIT, LIM_LOGPLUS1_OVER_X, LIM_N_MUL_SUB_CLOG, LIM_SUB_CLOG }
/- ------------------------------------------------------------------------- -/
/- Equality between holomorphic functions, on open ball then connected set.  -/
/- (cauchy.ml 9982-10090)                                                   -/
/- ------------------------------------------------------------------------- -/

structure KYAU where
  HOLOMORPHIC_FUN_EQ_ON_BALL : thm
  HOLOMORPHIC_FUN_EQ_0_ON_BALL : thm
  HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED : thm
  HOLOMORPHIC_FUN_EQ_ON_CONNECTED : thm
  HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAU [HolBase] (D : CauchyDeps) (BKYAI : KYAI) (BKYAL : KYAL) (BKYAJ : KYAJ) : ExceptT String IO KYAU := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { HOLOMORPHIC_POWER_SERIES, .. } := BKYAL
  let { HIGHER_COMPLEX_DERIVATIVE_CONST,
        HIGHER_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE, HIGHER_COMPLEX_DERIVATIVE_SUB,
        .. } := BKYAJ
  let { INTERS, .. } := D.qsession
  let { higher_complex_derivative, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { COMPLEX_SUB_0, COMPLEX_SUB_REFL, .. } := D.mt.ra.ts.cn.cxb
  let { CLOSED_IN_INTERS, .. } := D.mt.ra.ts.cn.ms.qmetric
  let { SERIES_UNIQUE, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { EQ_IMP, ETA_AX, EXISTS_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_UNIV, LE_1, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { SWAP_FORALL_THM, UNIV_NOT_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { CONNECTED_CLOPEN, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  -- @@SCOPE END

  let HOLOMORPHIC_FUN_EQ_ON_BALL ← prove
   r"!f g z r w.
     f holomorphic_on ball(z,r) /\ g holomorphic_on ball(z,r) /\
     w IN ball(z,r) /\
     (!n. higher_complex_derivative n f z = higher_complex_derivative n g z)
     ==> f w = g w"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_UNIQUE THEN
    EXISTS_TAC (← q r"(\n. higher_complex_derivative n f z /
                     Cx(&(FACT n)) * (w - z) pow n)") THEN
    EXISTS_TAC (← q r"(from 0)") THEN CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC []] THEN
    ASM_MESON_TAC [HOLOMORPHIC_POWER_SERIES])

  let HOLOMORPHIC_FUN_EQ_0_ON_BALL ← prove
   r"!f z r w.
     w IN ball(z,r) /\ f holomorphic_on ball(z,r) /\
     (!n. higher_complex_derivative n f z = Cx(&0))
     ==> f w = Cx(&0)"
   (REPEAT STRIP_TAC THEN
    SUBST1_TAC (← GSYM (← ExceptT.mk (BETA_CONV (← q r"(\z:complex. Cx(&0)) w")))) THEN
    MATCH_MP_TAC HOLOMORPHIC_FUN_EQ_ON_BALL THEN
    REWRITE_TAC [HOLOMORPHIC_ON_CONST, HIGHER_COMPLEX_DERIVATIVE_CONST] THEN
    ASM_MESON_TAC [])

  let HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED ← prove
   r"!f s z.
        open s /\ connected s /\ f holomorphic_on s /\
        z IN s /\ (!n. higher_complex_derivative n f z = Cx(&0))
        ==> !w. w IN s ==> f w = Cx(&0)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONNECTED_CLOPEN] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{w | w IN s /\ !n. higher_complex_derivative n f w = Cx(&0)}")) THEN
    ANTS_TAC THENL [ALL_TAC, ASM SET_TAC [higher_complex_derivative]] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_SUBSET THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"open(s:complex->bool)") THEN
      REWRITE_TAC [OPEN_CONTAINS_BALL, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"w:complex") THEN
      DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
      X_GEN_TAC (← q r"u:complex") THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC HOLOMORPHIC_FUN_EQ_0_ON_BALL THEN
      MAP_EVERY EXISTS_TAC [← q r"w:complex", ← q r"e:real"] THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, OPEN_BALL, SUBSET],
        ASM_REWRITE_TAC [HIGHER_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE]],
      SUBGOAL_THEN
       (← q r"closed_in (subtopology euclidean s)
                  (INTERS (IMAGE
                (\n. {w | w IN s /\ higher_complex_derivative n f w = Cx(&0)})
                  (:num)))")
      MP_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_INTERS THEN
        REWRITE_TAC [IMAGE_EQ_EMPTY, UNIV_NOT_EMPTY] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC CONTINUOUS_CLOSED_IN_PREIMAGE_CONSTANT THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN SIMP_TAC [ETA_AX] THEN
        MATCH_MP_TAC HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        SIMP_TAC [INTERS, IN_IMAGE, IN_UNIV, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
        ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
        REWRITE_TAC [LEFT_FORALL_IMP_THM, EXISTS_REFL] THEN SET_TAC []]])

  let HOLOMORPHIC_FUN_EQ_ON_CONNECTED ← prove
   r"!f g z s w.
     open s /\ connected s /\ f holomorphic_on s /\ g holomorphic_on s /\
     w IN s /\ z IN s /\
     (!n. higher_complex_derivative n f z = higher_complex_derivative n g z)
     ==> f w = g w"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"\z. (f:complex->complex) z - g z", ← q r"s:complex->bool",
                   ← q r"z:complex"] HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED) THEN
    ASM_REWRITE_TAC [RIGHT_IMP_FORALL_THM, HOLOMORPHIC_ON_SUB] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"g:complex->complex", ← q r"s:complex->bool"]
          HIGHER_COMPLEX_DERIVATIVE_SUB) THEN
    ASM_SIMP_TAC [COMPLEX_SUB_0])

  let HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED ← prove
   r"!f s z.
        open s /\
        connected s /\
        f holomorphic_on s /\
        z IN s /\
        (!n. 0 < n ==> higher_complex_derivative n f z = Cx(&0))
        ==> !w. w IN s ==> f w = f z"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"\w. (f:complex->complex) w - f z", ← q r"s:complex->bool", ← q r"z:complex"]
     HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED) THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_0, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_CONST] THEN
    X_GEN_TAC (← q r"n:num") THEN ASM_CASES_TAC (← q r"n = 0") THEN
    ASM_REWRITE_TAC [higher_complex_derivative, COMPLEX_SUB_REFL] THEN
    MP_TAC (← ISPECL
     [← q r"f:complex->complex", ← q r"(\w. f(z:complex)):complex->complex",
      ← q r"s:complex->bool", ← q r"n:num", ← q r"z:complex"]
     HIGHER_COMPLEX_DERIVATIVE_SUB) THEN
    ASM_REWRITE_TAC [HOLOMORPHIC_ON_CONST] THEN DISCH_THEN SUBST1_TAC THEN
    ASM_SIMP_TAC [LE_1, HIGHER_COMPLEX_DERIVATIVE_CONST, COMPLEX_SUB_REFL])

  pure { HOLOMORPHIC_FUN_EQ_ON_BALL, HOLOMORPHIC_FUN_EQ_0_ON_BALL,
         HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED, HOLOMORPHIC_FUN_EQ_ON_CONNECTED,
         HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED }
/- ------------------------------------------------------------------------- -/
/- Some basic lemmas about poles/singularities.                              -/
/- (cauchy.ml 10091-10318)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYAV where
  POLE_LEMMA : thm
  POLE_LEMMA_OPEN : thm
  POLE_THEOREM : thm
  POLE_THEOREM_OPEN : thm
  POLE_THEOREM_0 : thm
  POLE_THEOREM_OPEN_0 : thm
  POLE_THEOREM_ANALYTIC : thm
  POLE_THEOREM_ANALYTIC_0 : thm
  POLE_THEOREM_ANALYTIC_OPEN_SUPERSET : thm
  POLE_THEOREM_ANALYTIC_OPEN_SUPERSET_0 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAV [HolBase] (D : CauchyDeps) (BKYAK : KYAK) : ExceptT String IO KYAV := do
  -- @@SCOPE BEGIN
  let { NO_ISOLATED_SINGULARITY, .. } := BKYAK
  let { LIM_TRANSFORM_AT, .. } := D.qtopology
  let { complex_differentiable, COMPLEX_DIFFERENTIABLE_AT_WITHIN,
        COMPLEX_DIFFERENTIABLE_IMP_CONTINUOUS_AT, COMPLEX_DIFFERENTIABLE_WITHIN_SUBSET,
        holomorphic_on, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_AT, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_DIV_WITHIN,
        COMPLEX_DIFFERENTIABLE_ID, COMPLEX_DIFFERENTIABLE_SUB,
        COMPLEX_DIFFERENTIABLE_TRANSFORM_WITHIN, HOLOMORPHIC_TRANSFORM,
        .. } := D.mt.ra.ts.kng
  let { HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE, .. } := D.mt.ra.ts.knh
  let { analytic_on, .. } := D.mt.ra.ts.kni
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONJ_ASSOC, EQ_IMP, FINITE_INSERT, FINITE_RULES, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DELETE, IN_DIFF, INTER_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_SING, MONO_FORALL, MONO_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_MIN, REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { DIST_NZ, DIST_POS_LT, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { BALL_MIN_INTER, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { IN_BALL, IN_INTERIOR, INTERIOR_OPEN, INTERIOR_SUBSET, OPEN_BALL,
        OPEN_CONTAINS_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONTINUOUS_AT, CONTINUOUS_ON_EQ_CONTINUOUS_AT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { FINITE_IMP_CLOSED, OPEN_DIFF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let POLE_LEMMA ← prove
   r"!f s a.
        f holomorphic_on s /\ a IN interior(s)
        ==> (\z. if z = a then complex_derivative f a
                 else (f(z) - f(a)) / (z - a)) holomorphic_on s"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"(a:complex) IN s") ASSUME_TAC THENL
     [ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z. z IN s /\ ~(z = a)
          ==> (\z. if z = a then complex_derivative f a
                   else (f(z) - f(a)) / (z - a))
              complex_differentiable (at z within s)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_TRANSFORM_WITHIN THEN
      EXISTS_TAC (← q r"\z:complex. (f(z) - f(a)) / (z - a)") THEN
      EXISTS_TAC (← q r"dist(a:complex,z)") THEN ASM_SIMP_TAC [DIST_POS_LT] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"w:complex") THEN COND_CASES_TAC THEN
        ASM_REWRITE_TAC [REAL_LT_REFL] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:complex")) THEN ASM_REWRITE_TAC [] THEN
        REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC COMPLEX_FIELD,
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_DIV_WITHIN THEN
        ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN CONJ_TAC THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_SUB THEN
        REWRITE_TAC [COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_ID] THEN
        ASM_MESON_TAC [holomorphic_on, complex_differentiable]],
      ALL_TAC] THEN
    REWRITE_TAC [holomorphic_on, ← GSYM complex_differentiable] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"z:complex = a") THENL [ALL_TAC, ASM_SIMP_TAC []] THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERIOR]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_AT_WITHIN THEN
    SUBGOAL_THEN
     (← q r"(\z. if z = a then complex_derivative f a else (f z - f a) / (z - a))
      holomorphic_on ball(a,e)")
    MP_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL, ← GSYM complex_differentiable,
                   CENTRE_IN_BALL, COMPLEX_DIFFERENTIABLE_AT_WITHIN]] THEN
    MATCH_MP_TAC NO_ISOLATED_SINGULARITY THEN
    EXISTS_TAC (← q r"{a:complex}") THEN SIMP_TAC [OPEN_BALL, FINITE_RULES] THEN
    MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
      EXISTS_TAC (← q r"s DELETE (a:complex)") THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"b SUBSET s ==> b DIFF {a} SUBSET s DELETE a")] THEN
      ASM_SIMP_TAC [holomorphic_on, ← GSYM complex_differentiable, IN_DELETE] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [] THEN SET_TAC [],
      ALL_TAC] THEN
    SIMP_TAC [HOLOMORPHIC_ON_OPEN, CONTINUOUS_ON_EQ_CONTINUOUS_AT,
             OPEN_DIFF, FINITE_IMP_CLOSED, OPEN_BALL, FINITE_INSERT,
             FINITE_RULES, ← GSYM complex_differentiable] THEN
    REWRITE_TAC [IN_DIFF, IN_BALL, IN_SING] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"w:complex") THEN
    ASM_CASES_TAC (← q r"w:complex = a") THENL
     [ALL_TAC, ASM_SIMP_TAC [COMPLEX_DIFFERENTIABLE_IMP_CONTINUOUS_AT]] THEN
    FIRST_X_ASSUM SUBST_ALL_TAC THEN REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"f holomorphic_on ball(a,e)") MP_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
    REWRITE_TAC [← GSYM complex_differentiable, IN_BALL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN
    ASM_REWRITE_TAC [← GSYM HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_AT, CONTINUOUS_AT] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                LIM_TRANSFORM_AT) THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [← GSYM DIST_NZ, REAL_LT_01] THEN
    X_GEN_TAC (← q r"u:complex") THEN STRIP_TAC THEN ASM_REWRITE_TAC [])

  let POLE_LEMMA_OPEN ← prove
   r"!f s a.
        open s /\ f holomorphic_on s
        ==> (\z. if z = a
                 then complex_derivative f a
                 else (f z - f a) / (z - a)) holomorphic_on s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:complex) IN s") THENL
     [MATCH_MP_TAC POLE_LEMMA THEN ASM_SIMP_TAC [INTERIOR_OPEN],
      ALL_TAC] THEN
    REWRITE_TAC [holomorphic_on, ← GSYM complex_differentiable] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_TRANSFORM_WITHIN THEN
    MAP_EVERY EXISTS_TAC [← q r"\z:complex. (f(z) - f(a)) / (z - a)", ← q r"&1"] THEN
    ASM_REWRITE_TAC [REAL_LT_01] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_DIV_WITHIN THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_0, CONJ_ASSOC] THEN
    CONJ_TAC THENL [CONJ_TAC, ASM_MESON_TAC []] THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_SUB THEN
    REWRITE_TAC [COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_ID] THEN
    ASM_MESON_TAC [holomorphic_on, complex_differentiable])

  let POLE_THEOREM ← prove
   r"!f g s a.
        g holomorphic_on s /\ a IN interior(s) /\
        (!z. z IN s /\ ~(z = a) ==> g(z) = (z - a) * f(z))
        ==> (\z. if z = a then complex_derivative g a
                 else f(z) - g(a) / (z - a)) holomorphic_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POLE_LEMMA) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOLOMORPHIC_TRANSFORM) THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex") o lastc) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    CONV_TAC COMPLEX_FIELD)

  let POLE_THEOREM_OPEN ← prove
   r"!f g s a.
        open s /\ g holomorphic_on s /\
        (!z. z IN s /\ ~(z = a) ==> g(z) = (z - a) * f(z))
        ==> (\z. if z = a then complex_derivative g a
                 else f(z) - g(a) / (z - a)) holomorphic_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:complex") o MATCH_MP POLE_LEMMA_OPEN) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOLOMORPHIC_TRANSFORM) THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex") o lastc) THEN
    ASM_REWRITE_TAC [] THEN REPEAT (POP_ASSUM MP_TAC) THEN
    CONV_TAC COMPLEX_FIELD)

  let POLE_THEOREM_0 ← prove
   r"!f g s a.
        g holomorphic_on s /\ a IN interior(s) /\
        (!z. z IN s /\ ~(z = a) ==> g(z) = (z - a) * f(z)) /\
        f a = complex_derivative g a /\ g(a) = Cx(&0)
        ==> f holomorphic_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\z. if z = a then complex_derivative g a
           else f(z) - g(a) / (z - a)) holomorphic_on s")
    MP_TAC THENL [ASM_SIMP_TAC [POLE_THEOREM], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOLOMORPHIC_TRANSFORM) THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [complex_div] THEN
    CONV_TAC COMPLEX_RING)

  let POLE_THEOREM_OPEN_0 ← prove
   r"!f g s a.
        open s /\ g holomorphic_on s /\
        (!z. z IN s /\ ~(z = a) ==> g(z) = (z - a) * f(z)) /\
        f a = complex_derivative g a /\ g(a) = Cx(&0)
        ==> f holomorphic_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\z. if z = a then complex_derivative g a
           else f(z) - g(a) / (z - a)) holomorphic_on s")
    MP_TAC THENL [ASM_SIMP_TAC [POLE_THEOREM_OPEN], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HOLOMORPHIC_TRANSFORM) THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [complex_div] THEN
    CONV_TAC COMPLEX_RING)

  let POLE_THEOREM_ANALYTIC ← prove
   r"!f g s a.
        g analytic_on s /\
        (!z. z IN s
             ==> ?d. &0 < d /\
                     !w. w IN ball(z,d) /\ ~(w = a) ==> g(w) = (w - a) * f(w))
        ==> (\z. if z = a then complex_derivative g a
                 else f(z) - g(a) / (z - a)) analytic_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [analytic_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "A") (LABEL_TAC "B")) THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    REMOVE_THEN "A" (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min (d:real) e") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    MATCH_MP_TAC POLE_THEOREM_OPEN THEN
    ASM_SIMP_TAC [BALL_MIN_INTER, OPEN_BALL, IN_INTER] THEN
    ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, INTER_SUBSET])

  let POLE_THEOREM_ANALYTIC_0 ← prove
   r"!f g s a.
        g analytic_on s /\
        (!z. z IN s
             ==> ?d. &0 < d /\
                     !w. w IN ball(z,d) /\ ~(w = a)
                         ==> g(w) = (w - a) * f(w)) /\
        f a = complex_derivative g a /\ g(a) = Cx(&0)
        ==> f analytic_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\z. if z = a then complex_derivative g a
           else f(z) - g(a) / (z - a)) analytic_on s")
    MP_TAC THENL [ASM_SIMP_TAC [POLE_THEOREM_ANALYTIC], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [complex_div] THEN CONV_TAC COMPLEX_RING)

  let POLE_THEOREM_ANALYTIC_OPEN_SUPERSET ← prove
   r"!f g s a t.
        s SUBSET t /\ open t /\ g analytic_on s /\
        (!z. z IN t /\ ~(z = a) ==> g(z) = (z - a) * f(z))
        ==> (\z. if z = a then complex_derivative g a
                 else f(z) - g(a) / (z - a)) analytic_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC POLE_THEOREM_ANALYTIC THEN
    ASM_MESON_TAC [OPEN_CONTAINS_BALL, SUBSET])

  let POLE_THEOREM_ANALYTIC_OPEN_SUPERSET_0 ← prove
   r"!f g s a t.
        s SUBSET t /\ open t /\ g analytic_on s /\
        (!z. z IN t /\ ~(z = a) ==> g(z) = (z - a) * f(z)) /\
        f a = complex_derivative g a /\ g(a) = Cx(&0)
        ==> f analytic_on s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(\z. if z = a then complex_derivative g a
           else f(z) - g(a) / (z - a)) analytic_on s")
    MP_TAC THENL
     [MATCH_MP_TAC POLE_THEOREM_ANALYTIC_OPEN_SUPERSET THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [complex_div] THEN CONV_TAC COMPLEX_RING)

  pure { POLE_LEMMA, POLE_LEMMA_OPEN, POLE_THEOREM, POLE_THEOREM_OPEN, POLE_THEOREM_0,
         POLE_THEOREM_OPEN_0, POLE_THEOREM_ANALYTIC, POLE_THEOREM_ANALYTIC_0,
         POLE_THEOREM_ANALYTIC_OPEN_SUPERSET, POLE_THEOREM_ANALYTIC_OPEN_SUPERSET_0 }
/- ------------------------------------------------------------------------- -/
/- Extending a holomorphic function across a removable singularity.         -/
/- (cauchy.ml 10319-10395)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYAW where
  HOLOMORPHIC_ON_EXTEND_LIM : thm
  HOLOMORPHIC_ON_EXTEND_BOUNDED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAW [HolBase] (D : CauchyDeps) (BKYAV : KYAV) : ExceptT String IO KYAW := do
  -- @@SCOPE BEGIN
  let { POLE_LEMMA, .. } := BKYAV
  let { EVENTUALLY_WITHIN_INTERIOR, LIM_TRANSFORM_AT, .. } := D.qtopology
  let { LIM_NULL_COMPLEX_RMUL_BOUNDED, .. } := D.mt.ra.ts.knb
  let { complex_differentiable, COMPLEX_DIFFERENTIABLE_AT_WITHIN, holomorphic_on,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_AT, HAS_COMPLEX_DERIVATIVE_WITHIN, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_MUL_WITHIN, .. } := D.mt.ra.ts.kng
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFFERENTIABLE_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { LIM_AT_ID, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONTINUOUS_ON, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { AND_FORALL_THM, EQ_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_DELETE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { MONO_EXISTS, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { DIST_NZ, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { CONTINUOUS_ON_SUBSET, EVENTUALLY_AT, EVENTUALLY_WITHIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { INTERIOR_SUBSET, LIM_CONST, LIM_SUB, LIM_TRANSFORM_WITHIN_SET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { EVENTUALLY_MP, .. } := D.mt.ra.ts.cn.ms.ig.dv.qmetric
  let { LIM_WITHIN_OPEN, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { tendsto, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let (HOLOMORPHIC_ON_EXTEND_LIM, HOLOMORPHIC_ON_EXTEND_BOUNDED) ←
    CONJ_PAIR (← prove
     r"(!f a s.
      f holomorphic_on (s DELETE a) /\ a IN interior s
      ==> ((?g. g holomorphic_on s /\ (!z. z IN s DELETE a ==> g z = f z)) <=>
           ((\z. (z - a) * f(z)) --> Cx(&0)) (at a))) /\
   (!f a s.
      f holomorphic_on (s DELETE a) /\ a IN interior s
      ==> ((?g. g holomorphic_on s /\ (!z. z IN s DELETE a ==> g z = f z)) <=>
           (?B. eventually (\z. norm(f z) <= B) (at a))))"
     (REWRITE_TAC [AND_FORALL_THM] THEN
      REWRITE_TAC [← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> (p ==> q /\ r)")] THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC (← TAUT
       (← q r"(p ==> r) /\ (r ==> q) /\ (q ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [IN_DELETE] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex")
         (CONJUNCTS_THEN2
           (MP_TAC o MATCH_MP HOLOMORPHIC_ON_IMP_CONTINUOUS_ON) ASSUME_TAC)) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"interior s:complex->bool") o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [INTERIOR_SUBSET, CONTINUOUS_ON] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN
        ASM_SIMP_TAC [LIM_WITHIN_OPEN, OPEN_INTERIOR, tendsto] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN REWRITE_TAC [REAL_LT_01] THEN
        DISCH_THEN (fun th => tactic_of do
          pure (EXISTS_TAC (← q r"norm((g:complex->complex) a) + &1") THEN
                MP_TAC th)) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
        FIRST_ASSUM (fun th => tactic_of do
         pure (REWRITE_TAC [← GSYM (← MATCH_MP EVENTUALLY_WITHIN_INTERIOR th)])) THEN
        ASM_SIMP_TAC [EVENTUALLY_WITHIN, ← GSYM DIST_NZ] THEN
        EXISTS_TAC (← q r"&1") THEN CONV_TAC (fun t => NORM_ARITH t),
        DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
        MATCH_MP_TAC LIM_NULL_COMPLEX_RMUL_BOUNDED THEN EXISTS_TAC (← q r"B:real") THEN
        SUBST1_TAC (← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) = a - a"))) THEN
        SIMP_TAC [LIM_AT_ID, LIM_CONST, LIM_SUB] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
            EVENTUALLY_MONO)) THEN
        SIMP_TAC [],
        DISCH_TAC THEN ABBREV_TAC (← q r"h = \z. (z - a) pow 2 * f z") THEN
        SUBGOAL_THEN (← q r"(h has_complex_derivative Cx(&0)) (at a)") ASSUME_TAC THENL
         [EXPAND_TAC "h" THEN REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_AT] THEN
          MATCH_MP_TAC LIM_TRANSFORM_AT THEN
          MAP_EVERY EXISTS_TAC [← q r"\z:complex. (z - a) * f z", ← q r"&1"] THEN
          ASM_SIMP_TAC [REAL_LT_01, ← GSYM DIST_NZ] THEN CONV_TAC COMPLEX_FIELD,
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"h holomorphic_on s") ASSUME_TAC THENL
         [REWRITE_TAC [holomorphic_on, ← GSYM complex_differentiable] THEN
          X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
          ASM_CASES_TAC (← q r"z:complex = a") THENL
           [ASM_MESON_TAC [complex_differentiable, COMPLEX_DIFFERENTIABLE_AT_WITHIN],
            ALL_TAC] THEN
          EXPAND_TAC "h" THEN MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_MUL_WITHIN THEN
          CONJ_TAC THENL [COMPLEX_DIFFERENTIABLE_TAC, ALL_TAC] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [holomorphic_on]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
          ASM_REWRITE_TAC [IN_DELETE, complex_differentiable] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:complex") THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN] THEN
          MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC LIM_TRANSFORM_WITHIN_SET THEN
          REWRITE_TAC [EVENTUALLY_AT] THEN EXISTS_TAC (← q r"dist(a:complex,z)") THEN
          ASM_REWRITE_TAC [IN_DELETE, ← NORM_ARITH (← q r"&0 < dist(a,b) <=> ~(a = b)")] THEN
          MESON_TAC [REAL_LT_REFL],
          MP_TAC (← SPECL [← q r"h:complex->complex", ← q r"s:complex->bool", ← q r"a:complex"]
                POLE_LEMMA) THEN ASM_REWRITE_TAC [] THEN
          ABBREV_TAC
           (← q r"g = \z. if z = a then complex_derivative h a
                    else (h z - h a) / (z - a)") THEN
          DISCH_TAC THEN
          EXISTS_TAC
           (← q r"\z. if z = a then complex_derivative g a
                else (g z - g a) / (z - a)") THEN
          ASM_SIMP_TAC [POLE_LEMMA, IN_DELETE] THEN EXPAND_TAC "g" THEN
          FIRST_ASSUM (fun th => tactic_of do
            pure (REWRITE_TAC [← MATCH_MP HAS_COMPLEX_DERIVATIVE_DERIVATIVE th])) THEN
          SIMP_TAC [COMPLEX_SUB_RZERO] THEN
          EXPAND_TAC "h" THEN SIMP_TAC [] THEN CONV_TAC COMPLEX_FIELD]]))

  pure { HOLOMORPHIC_ON_EXTEND_LIM, HOLOMORPHIC_ON_EXTEND_BOUNDED }
/- ------------------------------------------------------------------------- -/
/- Power series for z / (e^z - 1).                                           -/
/- (cauchy.ml 10396-10587)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYAX where
  ZBYEXPM1_CONVERGES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAX [HolBase] (D : CauchyDeps) (BKYAQ : KYAQ) (BKYAW : KYAW) : ExceptT String IO KYAX := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_IFF_POWER_SERIES, .. } := BKYAQ
  let { HOLOMORPHIC_ON_EXTEND_LIM, .. } := BKYAW
  let { LIMPT_DELETE, LIMPT_OF_OPEN, SERIES_FINITE_EQ, SUMS_OFFSET, SUMS_REINDEX,
        .. } := D.qtopology
  let { BINOM_EQ_0, REAL_OF_NUM_BINOM, .. } := D.qbinomial
  let { BERNOULLI_CONV, BERNOULLI_NUMBER_ALT, .. } := D.mt.rzbn
  let { CEXP_CONVERGES, HOLOMORPHIC_ON_CEXP, LIM_CEXP_MINUS_1, .. } := D.mt.ra.tsa
  let { CX_EXP, .. } := D.mt.ra.tsb
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { CEXP_EQ_1, .. } := D.mt.ra.tsf
  let { binom, .. } := D.mt.ra.qbinomial
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { LIM_COMPLEX_INV, LIM_COMPLEX_MUL, SERIES_CX_LIFT, .. } := D.mt.ra.ts.knb
  let { SERIES_COMPLEX_DIV, SERIES_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { POWER_SERIES_LIMIT_POINT_OF_ZEROS, .. } := D.mt.ra.ts.knr
  let { complex_div, COMPLEX_EQ, complex_pow, COMPLEX_SQNORM, SIMPLE_COMPLEX_ARITH,
        .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO,
        COMPLEX_SUB_0, COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_RDISTRIB, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_MUL_LINV, COMPLEX_NORM_CX, COMPLEX_POW_1, COMPLEX_POW_ADD,
        COMPLEX_POW_ZERO, COMPLEX_VEC_0, CX_ADD, CX_DIV, CX_INJ, CX_MUL, CX_POW, CX_SUB,
        IM_CX, RE_CX, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, COMPLEX_INV_1, COMPLEX_INV_DIV, COMPLEX_INV_MUL,
        .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_1, COMPLEX_INV_EQ_0, COMPLEX_NORM_DIV, COMPLEX_NORM_POW,
        COMPLEX_NORM_ZERO, .. } := D.mt.ra.ts.cn.cxf
  let { VSUM_COMPLEX_LMUL, VSUM_COMPLEX_RMUL, VSUM_CX, .. } := D.mt.ra.ts.cn.cxi
  let { SERIES_RESTRICT, SERIES_SUB, summable, .. } := D.mt.ra.ts.cn.qtopology
  let { VSUM_SING_NUMSEG, .. } := D.mt.ra.ts.cn.qvectors
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { FROM_0, .. } := D.mt.ra.ts.cn.ms.qmisc
  let { FACT_NZ, .. } := D.mt.ra.ts.cn.ms.qsession
  let { ARITH_RULE, ARITH_TAC, NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, NOT_SUC, num_WF, REAL_LT_RMUL_EQ, SUB_ADD, VSUM_EQ_NUMSEG,
        .. } := D.mt.ra.ts.cn.cx.cpx
  let { COND_RAND, COND_RATOR, CONTRAPOS_THM, EQ_IMP, ETA_AX, FINITE_NUMSEG, FINITE_SING,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DELETE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_LID,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_LT_IMP_NZ, REAL_LT_LMUL_EQ, REAL_LT_MUL, REAL_LT_SQUARE_ABS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, RIGHT_AND_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { num_INDUCTION, SUM_CLAUSES_NUMSEG, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_POW_2, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VSUM_CLAUSES_NUMSEG, VSUM_SING, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_AT_ID, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { INTERIOR_OPEN, LIM_CONST, LIM_SUB, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONTINUOUS_AT, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { NORM_LT_SQUARE, .. } := D.mt.ra.ts.cn.ms.ig.dv.qvec
  let { LT, LT_SUC_LE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let ZBYEXPM1_CONVERGES ← prove
   r"!z. norm z < &2 * pi
       ==> ((\n. Cx(bernoulli n (&0)) / Cx(&(FACT n)) * z pow n) sums
            (if z = Cx(&0) then Cx(&1) else z / (cexp z - Cx(&1)))) (from 0)"
   (REPEAT STRIP_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [REWRITE_TAC [COMPLEX_POW_ZERO, COND_RAND, COMPLEX_MUL_RZERO] THEN
      REWRITE_TAC [← GSYM IN_SING, FROM_0, SERIES_RESTRICT, ← GSYM COMPLEX_VEC_0] THEN
      SIMP_TAC [SERIES_FINITE_EQ, FINITE_SING, VSUM_SING] THEN
      CONV_TAC (ONCE_DEPTH_CONV BERNOULLI_CONV) THEN
      CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC COMPLEX_RING,
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"\z. z / (cexp z - Cx(&1))", ← q r"Cx(&0)", ← q r"ball(Cx(&0),&2 * pi)"]
     HOLOMORPHIC_ON_EXTEND_LIM) THEN
    SIMP_TAC [INTERIOR_OPEN, OPEN_BALL, CENTRE_IN_BALL] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, MP_TAC PI_POS THEN REAL_ARITH_TAC] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
      SIMP_TAC [HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_SUB,
               HOLOMORPHIC_ON_CEXP, ETA_AX] THEN
      REWRITE_TAC [IN_DELETE, COMPLEX_SUB_0, CEXP_EQ_1, COMPLEX_IN_BALL_0] THEN
      X_GEN_TAC (← q r"w:complex") THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"n:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [NORM_LT_SQUARE, COMPLEX_EQ, RE_CX, IM_CX] THEN
      ASM_REWRITE_TAC [COMPLEX_SQNORM, ← GSYM NORM_POW_2] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [REAL_ADD_LID, ← GSYM REAL_LT_SQUARE_ABS] THEN
      SIMP_TAC [REAL_ABS_MUL, REAL_ABS_NUM, REAL_LT_MUL, REAL_LT_LMUL_EQ,
               REAL_ABS_PI, PI_POS, REAL_LT_RMUL_EQ, ← REAL_ARITH (← q r"&0 < &2"),
               REAL_ENTIRE, REAL_LT_IMP_NZ, ← REAL_ARITH
                (← q r"abs m * pi < pi <=> abs m * pi < &1 * pi")] THEN
      MP_TAC (← SPEC (← q r"n:real") REAL_ABS_INTEGER_LEMMA) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2))] THEN
    ANTS_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← SIMPLE_COMPLEX_ARITH
       (← q r"Cx(&0) = (Cx(&0) - Cx(&0)) * inv(Cx(&1))")] THEN
      MATCH_MP_TAC LIM_COMPLEX_MUL THEN CONJ_TAC THENL
       [MATCH_MP_TAC LIM_SUB THEN REWRITE_TAC [LIM_CONST] THEN
        REWRITE_TAC [← GSYM CONTINUOUS_AT, CONTINUOUS_AT_ID],
        ONCE_REWRITE_TAC [← GSYM COMPLEX_INV_DIV] THEN
        MATCH_MP_TAC LIM_COMPLEX_INV THEN
        REWRITE_TAC [LIM_CEXP_MINUS_1] THEN CONV_TAC COMPLEX_RING],
      REWRITE_TAC [HOLOMORPHIC_IFF_POWER_SERIES, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"f:complex->complex") THEN
    ASM_REWRITE_TAC [IN_DELETE, COMPLEX_IN_BALL_0, COMPLEX_SUB_RZERO] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    MP_TAC (← ISPECL
     [← q r"\w:complex. (f(w) * (if w = Cx (&0) then Cx(&1)
                            else (cexp w - Cx(&1)) / w) - Cx(&1))",
      ← q r"\n. inv(Cx(&(FACT(n + 1)))) *
           (vsum(0..n)
                      (\k. Cx(&(binom(n+1,k))) *
                           higher_complex_derivative k f (Cx(&0))) -
            (if n = 0 then Cx(&1) else Cx(&0)))",
      ← q r"Cx(&0)",
      ← q r"from 0", ← q r"&2 * pi",
      ← q r"ball(Cx(&0),&2 * pi) DELETE Cx(&0)"]
     POWER_SERIES_LIMIT_POINT_OF_ZEROS) THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_RZERO, dist, LIMPT_DELETE] THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL, PI_POS, LIMPT_OF_OPEN, OPEN_BALL, ← REAL_ARITH
      (← q r"&0 < &2 * x <=> &0 < x")] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
        REWRITE_TAC [COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_RDISTRIB] THEN
        MATCH_MP_TAC SERIES_SUB THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL
           [← q r"\n. higher_complex_derivative n f (Cx(&0)) / Cx(&(FACT n)) *
                 w pow n",
            ← q r"\n. w pow n / Cx(&(FACT(n + 1)))",
            ← q r"(f:complex->complex) w",
            ← q r"if w = Cx(&0) then Cx(&1) else (cexp w - Cx(&1)) / w"]
           SERIES_COMPLEX_MUL) THEN
          ANTS_TAC THENL
           [SUBGOAL_THEN
             (← q r"!u. ((\n. u pow n / Cx(&(FACT(n + 1)))) sums
                   (if u = Cx(&0) then Cx(&1) else (cexp u - Cx (&1)) / u))
                  (from 0)")
            ASSUME_TAC THENL
             [X_GEN_TAC (← q r"u:complex") THEN COND_CASES_TAC THEN
              ASM_REWRITE_TAC [] THENL
               [REWRITE_TAC [COMPLEX_POW_ZERO, complex_div] THEN
                SIMP_TAC [COND_RAND, COND_RATOR, COMPLEX_MUL_LZERO] THEN
                REWRITE_TAC [← GSYM COMPLEX_VEC_0, ← GSYM IN_SING, FROM_0] THEN
                REWRITE_TAC [SERIES_RESTRICT] THEN
                SIMP_TAC [SERIES_FINITE_EQ, FINITE_SING, VSUM_SING] THEN
                CONV_TAC NUM_REDUCE_CONV THEN
                REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_INV_1],
                MP_TAC (← ISPEC (← q r"u:complex") CEXP_CONVERGES) THEN
                DISCH_THEN (MP_TAC o SPEC (← q r"1") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                 SUMS_OFFSET)) THEN
                CONV_TAC NUM_REDUCE_CONV THEN
                REWRITE_TAC [VSUM_SING_NUMSEG] THEN
                CONV_TAC NUM_REDUCE_CONV THEN
                REWRITE_TAC [complex_pow, COMPLEX_DIV_1] THEN
                GEN_REWRITE_TAC (LAND_CONV o funpow 2 RAND_CONV)
                  [← ARITH_RULE (← q r"1 = 0 + 1")] THEN
                REWRITE_TAC [← GSYM SUMS_REINDEX] THEN
                DISCH_THEN (MP_TAC o SPEC (← q r"u:complex") o
                  MATCH_MP SERIES_COMPLEX_DIV) THEN
                MATCH_MP_TAC EQ_IMP THEN
                AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
                REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"n:num") THEN
                REWRITE_TAC [COMPLEX_POW_ADD, complex_div, COMPLEX_POW_1] THEN
                MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
                 (← q r"~(w = Cx(&0)) ==> ((wn * w) * i) * inv w = wn * i"))) THEN
                ASM_REWRITE_TAC []],
              ASM_SIMP_TAC [summable] THEN DISJ2_TAC THEN
              EXISTS_TAC (← q r"lift(if w = Cx(&0) then &1
                               else (exp(norm w) - &1) / norm(w:complex))") THEN
              REWRITE_TAC [← GSYM SERIES_CX_LIFT] THEN
              ONCE_REWRITE_TAC [COND_RAND] THEN
              REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_POW] THEN
              REWRITE_TAC [CX_DIV, CX_POW, CX_SUB, CX_EXP] THEN
              REWRITE_TAC [← GSYM COMPLEX_NORM_ZERO] THEN
              ASM_REWRITE_TAC [← GSYM CX_INJ, COMPLEX_NORM_CX, REAL_ABS_NUM]],
            MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN
            AP_TERM_TAC THEN
            REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"n:num") THEN
            SIMP_TAC [← GSYM VSUM_COMPLEX_LMUL, ← GSYM VSUM_COMPLEX_RMUL,
                   FINITE_NUMSEG] THEN
            MATCH_MP_TAC VSUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"k:num") THEN
            STRIP_TAC THEN
            ASM_SIMP_TAC [REAL_OF_NUM_BINOM, CX_DIV, complex_div, COMPLEX_INV_MUL,
              ← ARITH_RULE (← q r"k <= n ==> k <= n + 1 /\ n - k + 1 = (n + 1) - k")] THEN
            REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC, CX_MUL, COMPLEX_INV_MUL] THEN
            MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
             (← q r"n' * n = Cx(&1) /\ v * w = z
              ==> d * k * w * v * nk = n' * n * nk * k * d * z"))) THEN
            ASM_SIMP_TAC [← GSYM COMPLEX_POW_ADD, SUB_ADD] THEN
            MATCH_MP_TAC COMPLEX_MUL_LINV THEN
            REWRITE_TAC [CX_INJ, REAL_OF_NUM_EQ, FACT_NZ]],
          REWRITE_TAC [COND_RAND, COND_RATOR] THEN
          REWRITE_TAC [COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO] THEN
          REWRITE_TAC [← GSYM COMPLEX_VEC_0, ← GSYM IN_SING, FROM_0] THEN
          REWRITE_TAC [SERIES_RESTRICT] THEN
          SIMP_TAC [SERIES_FINITE_EQ, FINITE_SING, VSUM_SING] THEN
          CONV_TAC NUM_REDUCE_CONV THEN
          REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_INV_1, complex_pow]],
        X_GEN_TAC (← q r"w:complex") THEN
        REWRITE_TAC [IN_DELETE, COMPLEX_IN_BALL_0] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN
        MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
         (← q r"w / e = f /\ ~(w = Cx(&0)) /\ ~(e = Cx(&0))
          ==> f * e / w = Cx(&1)"))) THEN
        ASM_SIMP_TAC [COMPLEX_SUB_0, CEXP_EQ_1, RIGHT_AND_EXISTS_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"n:real") STRIP_ASSUME_TAC) THEN
        UNDISCH_TAC (← q r"~(w = Cx(&0))") THEN
        UNDISCH_TAC (← q r"norm(w:complex) < &2 * pi") THEN
        ASM_REWRITE_TAC [NORM_LT_SQUARE, COMPLEX_EQ, RE_CX, IM_CX] THEN
        ASM_REWRITE_TAC [COMPLEX_SQNORM, ← GSYM NORM_POW_2] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [REAL_ADD_LID, ← GSYM REAL_LT_SQUARE_ABS] THEN
        SIMP_TAC [REAL_ABS_MUL, REAL_ABS_NUM, REAL_LT_MUL, REAL_LT_LMUL_EQ,
                 REAL_ABS_PI, PI_POS, REAL_LT_RMUL_EQ, ← REAL_ARITH (← q r"&0 < &2"),
                 REAL_ENTIRE, REAL_LT_IMP_NZ, ← REAL_ARITH
                  (← q r"abs m * pi < pi <=> abs m * pi < &1 * pi")] THEN
        MP_TAC (← SPEC (← q r"n:real") REAL_ABS_INTEGER_LEMMA) THEN
        ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC],
      REWRITE_TAC [FROM_0, IN_UNIV, COMPLEX_ENTIRE] THEN
      REWRITE_TAC [COMPLEX_INV_EQ_0, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ] THEN
      DISCH_TAC THEN REWRITE_TAC [← GSYM FROM_0]] THEN
    SUBGOAL_THEN
     (← q r"!n. higher_complex_derivative n f (Cx(&0)) =
          Cx(bernoulli n (&0))")
     (fun th => tactic_of do pure (ASM_SIMP_TAC [← GSYM th])) THEN
    MATCH_MP_TAC num_WF THEN MATCH_MP_TAC num_INDUCTION THEN
    REWRITE_TAC [← CONJUNCT1 LT, LT_SUC_LE] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"0")),
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (K ALL_TAC) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"SUC n")) THEN MP_TAC th))] THEN
    SIMP_TAC [VSUM_CLAUSES_NUMSEG, LE_0, NOT_SUC] THENL
     [SIMP_TAC [← CONJUNCT1 binom, COMPLEX_MUL_LID, COMPLEX_SUB_0]  THEN
      DISCH_TAC THEN AP_TERM_TAC THEN CONV_TAC (RAND_CONV BERNOULLI_CONV) THEN
      REFL_TAC,
      DISCH_THEN (K ALL_TAC) THEN
      MP_TAC (← ISPEC (← q r"SUC n") BERNOULLI_NUMBER_ALT) THEN
      SIMP_TAC [SUM_CLAUSES_NUMSEG, LE_0, NOT_SUC] THEN
      REWRITE_TAC [← GSYM CX_INJ, ← GSYM VSUM_CX, CX_MUL, CX_ADD] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"~(a = Cx(&0))
        ==> x + a * y = Cx(&0) ==> (x + a * z) - Cx(&0) = Cx(&0)
            ==> z = y"))) THEN
      REWRITE_TAC [CX_INJ, REAL_OF_NUM_EQ, BINOM_EQ_0] THEN ARITH_TAC])

  pure { ZBYEXPM1_CONVERGES }
/- ------------------------------------------------------------------------- -/
/- Hence the power series for cotangent and tangent.                         -/
/- (cauchy.ml 10588-10725)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYAY where
  ZBYEXPM1_CONVERGES_ALT : thm
  CCOT_CONVERGES : thm
  CTAN_CONVERGES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAY [HolBase] (D : CauchyDeps) (BKYAX : KYAX) : ExceptT String IO KYAY := do
  -- @@SCOPE BEGIN
  let { ZBYEXPM1_CONVERGES, .. } := BKYAX
  let { SUMS_OFFSET, .. } := D.qtopology
  let { BERNOULLI_CONV, .. } := D.mt.rzbn
  let { BERNOULLI_NUMBER_EQ_0, .. } := D.mt.rzbp
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { CEXP_EQ_1, .. } := D.mt.ra.tsf
  let { CTAN_0, CTAN_CCOT_DOUBLE, CTAN_CEXP, .. } := D.mt.ra.tsk
  let { SERIES_EVEN, .. } := D.mt.ra.qtopology
  let { SUMS_COMPLEX_0, .. } := D.mt.ra.ts.knb
  let { SERIES_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { NOT_EVEN, .. } := D.mt.ra.ts.qsession
  let { IN_FROM, .. } := D.mt.ra.ts.qmisc
  let { complex_div, COMPLEX_EQ, complex_pow, COMPLEX_SQNORM, SIMPLE_COMPLEX_ARITH,
        .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_MUL_AC, COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID,
        COMPLEX_MUL_LZERO, COMPLEX_MUL_RID, COMPLEX_MUL_RZERO, COMPLEX_SUB_0,
        COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_LZERO, COMPLEX_SUB_REFL, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_MUL_LINV, COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_POW_1,
        COMPLEX_POW_ADD, COMPLEX_POW_MUL, COMPLEX_POW_POW, COMPLEX_POW_ZERO, COMPLEX_VEC_0,
        CX_DIV, CX_NEG, II_NZ, IM_CX, IM_MUL_CX, IM_MUL_II, RE_CX, RE_MUL_CX, RE_MUL_II,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, COMPLEX_INV_0, COMPLEX_INV_INV, COMPLEX_INV_MUL,
        .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_1, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { SERIES_RESTRICT, SERIES_SUB, SUMS_0, .. } := D.mt.ra.ts.cn.qtopology
  let { VSUM_SING_NUMSEG, .. } := D.mt.ra.ts.cn.qvectors
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { SUMS_EQ, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ARITH_RULE, ASM_REAL_ARITH_TAC, MESON, num_CONV, NUM_REDUCE_CONV, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, .. } := D.mt.ra.ts.cn.cx.cvx
  let { COND_ID, COND_RAND, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { LE_1, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ADD_RID, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_LE_RMUL_EQ, REAL_LE_SQUARE_ABS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_NEG_EQ_0, REAL_NOT_LT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { NORM_POW_2, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VSUM_CLAUSES_NUMSEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { NORM_LT_SQUARE, .. } := D.mt.ra.ts.cn.ms.ig.dv.qvec
  let { EVEN_EXISTS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { REAL_EQ_MUL_LCANCEL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let ZBYEXPM1_CONVERGES_ALT ← prove
   r"!z. norm z < &2 * pi
       ==> ((\n. Cx(bernoulli (2 * n) (&0)) / Cx(&(FACT(2 * n))) *
                 z pow (2 * n)) sums
            (if z = Cx(&0) then Cx(&0)
             else z / (cexp z - Cx (&1)) + z / Cx(&2) - Cx(&1))) (from 1)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"z = Cx(&0)") THEN
    ASM_REWRITE_TAC [] THENL
     [ASM_REWRITE_TAC [COMPLEX_POW_ZERO, complex_div, COMPLEX_MUL_LZERO] THEN
      SIMP_TAC [COND_RAND, ← ARITH_RULE (← q r"2 * n = 0 <=> n = 0")] THEN
      REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_ADD_LID, COMPLEX_SUB_LZERO] THEN
      ONCE_REWRITE_TAC [← GSYM SERIES_RESTRICT] THEN
      SIMP_TAC [IN_FROM, LE_1, COMPLEX_VEC_0, COND_ID] THEN
      SIMP_TAC [SUMS_COMPLEX_0],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ZBYEXPM1_CONVERGES) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"2") o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          SUMS_OFFSET)) THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC [← ExceptT.mk (num_CONV (← q r"1")), VSUM_CLAUSES_NUMSEG, VSUM_SING_NUMSEG] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    CONV_TAC (ONCE_DEPTH_CONV BERNOULLI_CONV) THEN
    REWRITE_TAC [COMPLEX_DIV_1, complex_pow, COMPLEX_POW_1] THEN
    REWRITE_TAC [CX_DIV, COMPLEX_MUL_LID, CX_NEG] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"a - (Cx(&1) + --Cx(&1) / Cx(&2) * z) = a + (z / Cx(&2) - Cx(&1))"))] THEN
    GEN_REWRITE_TAC RAND_CONV [SERIES_EVEN] THEN CONV_TAC NUM_REDUCE_CONV THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMS_EQ) THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_FROM] THEN DISCH_TAC THEN
    COND_CASES_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVEN_EXISTS]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") SUBST_ALL_TAC) THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * m) DIV 2 = m")],
      MP_TAC (← ISPEC (← q r"n:num") BERNOULLI_NUMBER_EQ_0) THEN
      ASM_SIMP_TAC [← GSYM NOT_EVEN, ← ARITH_RULE (← q r"2 <= n ==> ~(n = 1)")] THEN
      REWRITE_TAC [COMPLEX_VEC_0, complex_div, COMPLEX_MUL_LZERO]])

  let CCOT_CONVERGES ← (do
    let lemma ← prove
     r"norm z < pi
     ==> (Cx(&2) * ii * z) / (cexp(Cx(&2) * ii * z) - Cx(&1)) =
         z / ctan z - ii * z"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"z = Cx(&0)") THENL
       [ASM_REWRITE_TAC [complex_div, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO] THEN
        REWRITE_TAC [COMPLEX_SUB_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~(cexp(Cx(&2) * ii * z) = Cx(&1))") ASSUME_TAC THENL
       [REWRITE_TAC [CEXP_EQ_1] THEN
        REWRITE_TAC [RE_MUL_CX, IM_MUL_CX, IM_MUL_II, RE_MUL_II] THEN
        REWRITE_TAC [REAL_ENTIRE, REAL_NEG_EQ_0, REAL_EQ_MUL_LCANCEL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN STRIP_TAC THEN
        UNDISCH_TAC (← q r"norm(z:complex) < pi") THEN
        ASM_REWRITE_TAC [NORM_LT_SQUARE, COMPLEX_SQNORM, ← GSYM NORM_POW_2] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [PI_POS, REAL_ADD_RID, REAL_NOT_LT] THEN
        REWRITE_TAC [← GSYM REAL_LE_SQUARE_ABS, REAL_ABS_MUL, REAL_ABS_PI] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_MUL_LID] THEN
        SIMP_TAC [REAL_LE_RMUL_EQ, PI_POS] THEN
        MATCH_MP_TAC REAL_ABS_INTEGER_LEMMA THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN SUBST_ALL_TAC THEN
        UNDISCH_TAC (← q r"~(z = Cx(&0))") THEN
        ASM_REWRITE_TAC [COMPLEX_EQ, RE_CX, IM_CX, REAL_MUL_LZERO],
        SIMP_TAC [CTAN_CEXP, complex_div, COMPLEX_INV_MUL, COMPLEX_INV_INV] THEN
        MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(z = Cx(&0)) /\ a * b * c = x * z + w
          ==> w * inv z = a * b * inv z * c - x"))) THEN
        ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN CONV_TAC COMPLEX_FIELD])
    prove
     r"!z. norm(z) < pi
       ==> ((\n. (--Cx(&4) pow n / Cx(&(FACT(2 * n))) *
                  Cx(bernoulli (2 * n) (&0))) * z pow (2 * n - 1))
            sums (Cx(&1) / ctan z - inv(z))) (from 1)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"z = Cx(&0)") THENL
       [ASM_REWRITE_TAC [complex_div, CTAN_0, COMPLEX_INV_0, COMPLEX_MUL_LZERO] THEN
        REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_SUB_REFL] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC SUMS_0 THEN
        SIMP_TAC [COMPLEX_VEC_0, IN_FROM, COMPLEX_POW_ZERO] THEN
        SIMP_TAC [← ARITH_RULE (← q r"1 <= n ==> ~(2 * n - 1 = 0)")] THEN
        REWRITE_TAC [COMPLEX_MUL_RZERO],
        MP_TAC (← SPEC (← q r"Cx(&2) * ii * z") ZBYEXPM1_CONVERGES_ALT) THEN
        ASM_SIMP_TAC [COMPLEX_ENTIRE, II_NZ] THEN
        REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"~(Cx(&2) = Cx(&0))"))]] THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_II, COMPLEX_NORM_CX] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LID] THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&2 * x < &2 * y <=> x < y")] THEN
      ASM_SIMP_TAC [lemma] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"y - ii * z + (Cx(&2) * ii * z) / Cx(&2) - Cx(&1) = y - Cx(&1)"))] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(z):complex") o
        MATCH_MP SERIES_COMPLEX_LMUL) THEN
      REWRITE_TAC [complex_div, COMPLEX_SUB_LDISTRIB, COMPLEX_MUL_ASSOC] THEN
      ASM_SIMP_TAC [COMPLEX_MUL_LID, COMPLEX_MUL_LINV, COMPLEX_MUL_RID] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMS_EQ) THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_FROM] THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM COMPLEX_POW_POW, ← GSYM COMPLEX_MUL_ASSOC] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
        (← q r"~(z = Cx(&0)) /\ a = b * z pow 1 ==> inv z * a = b"))) THEN
      ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"(a * b:complex) pow 2 = a pow 2 * b pow 2"))] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
        (← q r"Cx(&2) pow 2 * ii pow 2 * z = --Cx(&4) * z"))] THEN
      REWRITE_TAC [COMPLEX_POW_MUL, COMPLEX_POW_POW] THEN
      ASM_REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC, ← GSYM COMPLEX_POW_ADD] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"1 <= n ==> (2 * n - 1) + 1 = 2 * n")] THEN
      REWRITE_TAC [COMPLEX_MUL_AC]))

  let CTAN_CONVERGES ← prove
   r"!z. norm(z) < pi / &2
       ==> ((\n. ((Cx(&1) - Cx(&4) pow n) *
                  --Cx(&4) pow n / Cx(&(FACT(2 * n))) *
                  Cx(bernoulli (2 * n) (&0))) * z pow (2 * n - 1))
            sums ctan z) (from 1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"Cx(&2) * z") CCOT_CONVERGES) THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&2)") o MATCH_MP SERIES_COMPLEX_LMUL) THEN
    MP_TAC (← ISPEC (← q r"z:complex") CCOT_CONVERGES) THEN
    ASM_SIMP_TAC [PI_POS, ← REAL_ARITH (← q r"x < pi / &2 /\ &0 < pi ==> x < pi")] THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP SERIES_SUB) THEN
    REWRITE_TAC [COMPLEX_POW_MUL, COMPLEX_INV_MUL, ← ExceptT.mk (COMPLEX_RING
     (← q r"z - i - Cx(&2) * (p - inv(Cx(&2)) * i) = z - Cx(&2) * p"))] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"x * z - Cx(&2) * x * p2 * z = (Cx(&1) - Cx(&2) * p2) * x * z"))] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 complex_pow)] THEN
    MATCH_MP_TAC (← MESON [SUMS_EQ]
     (← q r"(!x. x IN s ==> f x = g x) /\ l = m
      ==> (f sums l) s ==> (g sums m) s")) THEN
    CONJ_TAC THENL
     [REWRITE_TAC [IN_FROM] THEN
      SIMP_TAC [← ARITH_RULE (← q r"1 <= n ==> SUC(2 * n - 1) = 2 * n")] THEN
      REWRITE_TAC [← GSYM COMPLEX_POW_POW, ← GSYM COMPLEX_MUL_ASSOC] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"Cx(&2) pow 2 = Cx(&4)"))],
      REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a * Cx(&1) / b = a / b")] THEN
      REWRITE_TAC [← GSYM CTAN_CCOT_DOUBLE]])

  pure { ZBYEXPM1_CONVERGES_ALT, CCOT_CONVERGES, CTAN_CONVERGES }
/- ------------------------------------------------------------------------- -/
/- General, homology form of Cauchy's theorem. Proof is based on Dixon's,    -/
/- as presented in Lang's "Complex Analysis" book.                           -/
/- (cauchy.ml 10726-11417)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYAZ where
  CAUCHY_INTEGRAL_FORMULA_GLOBAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAZ [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYH : KYH) (BKYI : KYI) (BKYL : KYL) (BKYM : KYM) (BKYN : KYN) (BKYR : KYR) (BKYS : KYS) (BKYAG : KYAG) (BKYAH : KYAH) (BKYAI : KYAI) (BKYAK : KYAK) (BKYAM : KYAM) : ExceptT String IO KYAZ := do
  -- @@SCOPE BEGIN
  let { COMPACT_VALID_PATH_IMAGE, VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on, PATH_INTEGRABLE_ON,
        PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, PATH_INTEGRAL_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { PATH_INTEGRAL_TRIVIAL, VALID_PATH_LINEPATH, VECTOR_DERIVATIVE_LINEPATH_AT,
        .. } := BKYE
  let { PATH_INTEGRAL_PRIMITIVE, SEGMENTS_SUBSET_CONVEX_HULL, .. } := BKYF
  let { HAS_PATH_INTEGRAL_ADD, HAS_PATH_INTEGRAL_BOUND_LINEPATH,
        HAS_PATH_INTEGRAL_COMPLEX_DIV, HAS_PATH_INTEGRAL_COMPLEX_LMUL,
        HAS_PATH_INTEGRAL_COMPLEX_RMUL, HAS_PATH_INTEGRAL_CONST_LINEPATH,
        HAS_PATH_INTEGRAL_EQ, HAS_PATH_INTEGRAL_SUB, PATH_INTEGRABLE_ADD,
        PATH_INTEGRABLE_CONTINUOUS_LINEPATH, PATH_INTEGRABLE_EQ, PATH_INTEGRABLE_SUB,
        PATH_INTEGRAL_ADD, PATH_INTEGRAL_EQ, PATH_INTEGRAL_EQ_0, PATH_INTEGRAL_SUB,
        .. } := BKYG
  let { PATH_INTEGRAL_SWAP, .. } := BKYH
  let { CAUCHY_THEOREM_TRIANGLE, .. } := BKYI
  let { PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE, .. } := BKYL
  let { PATH_INTEGRAL_BOUND_EXISTS, PATH_INTEGRAL_NEARBY_ENDS,
        VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { HAS_PATH_INTEGRAL_WINDING_NUMBER, WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { OPEN_WINDING_NUMBER_LEVELSETS, .. } := BKYR
  let { WINDING_NUMBER_ZERO_OUTSIDE, .. } := BKYS
  let { PATH_INTEGRAL_UNIFORM_LIMIT, .. } := BKYAG
  let { CAUCHY_NEXT_DERIVATIVE, .. } := BKYAH
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, MORERA_TRIANGLE, .. } := BKYAI
  let { NO_ISOLATED_SINGULARITY, .. } := BKYAK
  let { LIOUVILLE_WEAK, .. } := BKYAM
  let { CONTINUOUS_CLOSED_PREIMAGE_CONSTANT, .. } := D.qtopology
  let { NORM_PASTECART, .. } := D.qvectors
  let { CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbj
  let { HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbk
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { CONTINUOUS_COMPLEX_DIV_AT, CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { complex_differentiable, COMPLEX_DIFFERENTIABLE_IMP_CONTINUOUS_AT,
        HAS_COMPLEX_DERIVATIVE_AT_WITHIN, HOLOMORPHIC_ON_DIFFERENTIABLE,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT,
        HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_AT, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_DIV_AT,
        COMPLEX_DIFFERENTIABLE_ID, COMPLEX_DIFFERENTIABLE_SUB,
        COMPLEX_DIFFERENTIABLE_TRANSFORM_AT, .. } := D.mt.ra.ts.kng
