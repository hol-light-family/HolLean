                    REAL_ABS_NORM, REAL_ABS_INV] THEN
        ASM_MESON_TAC [REAL_MUL_LINV, NORM_EQ_0],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"(!x. x IN s ==> f(k x) = x)
        ==> (a IN s /\ b IN s) /\ (a = b ==> P)
            ==> k a = k b ==> P"))) THEN
      CONJ_TAC THENL
       [REWRITE_TAC [COMPLEX_IN_SPHERE_0, NORM_MUL,
                    REAL_ABS_NORM, REAL_ABS_INV] THEN
        ASM_MESON_TAC [REAL_MUL_LINV, NORM_EQ_0],
        ASM_REWRITE_TAC [VECTOR_MUL_LCANCEL, REAL_INV_EQ_0, NORM_EQ_0]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"r(Cx(&0)) = Cx(&0)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPLEX_NORM_ZERO], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(r:complex->complex) continuous_on UNIV") ASSUME_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
      X_GEN_TAC (← q r"x:complex") THEN REWRITE_TAC [IN_UNIV] THEN
      ASM_CASES_TAC (← q r"x = Cx(&0)") THENL
       [ASM_REWRITE_TAC [continuous_at, dist, COMPLEX_SUB_RZERO] THEN
