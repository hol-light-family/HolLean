@[nospecialize]
def setupKYBQ [HolBase] (D : CauchyDeps) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYBP : KYBP) : ExceptT String IO KYBQ := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_LINEPATH, .. } := BKYE
