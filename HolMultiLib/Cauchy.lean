      REWRITE_TAC [← NORM_ARITH (← q r"dist(a,b) = norm(b - a)")] THEN
      REWRITE_TAC [COMPLEX_SUB_RZERO] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:complex") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"norm(p - a:complex) < r") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [REAL_LT_LE] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:complex")) THEN
      ASM_SIMP_TAC [COMPLEX_SUB_REFL, COMPLEX_NORM_0, REAL_LT_IMP_LE] THEN
