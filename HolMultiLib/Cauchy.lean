  let { REAL_LE_LMUL, REAL_LT_MIN, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_POW_LE, SUBSET, SUBSET_TRANS,
