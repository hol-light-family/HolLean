  let { BALL_MIN_INTER, CBALL_EQ_EMPTY, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, DISTANCE_ATTAINS_INF, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, INTERIOR_OPEN, OPEN_BALL, OPEN_CONTAINS_BALL,
