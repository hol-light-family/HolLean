      EXPAND_TAC "ff" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN REPEAT CONJ_TAC THENL
       [REPEAT (MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN CONJ_TAC) THEN
        ASM_SIMP_TAC [] THEN
