  let { IN_IMAGE, NOT_EXISTS_THM, REAL_DIV_LMUL, REAL_DIV_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_LT_1, REAL_LE_ANTISYM, REAL_LE_DIV2_EQ, REAL_LE_LMUL,
        REAL_LE_REFL, REAL_LET_TRANS, REAL_LT_01, REAL_LT_DIV2_EQ, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_NOT_LT, REAL_SUB_LT, SUBSET, SUBSET_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_DEF, o_THM, real_abs, UNION, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_REFL, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_NEG, NORM_POS_LE, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
