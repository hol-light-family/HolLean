        ==> !z. Re z = u * a + v * b ==> norm(f z) <= ma rpow u * mb rpow v"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 <= ma /\ &0 <= mb") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [← NORM_ARITH (← q r"norm z <= a ==> &0 <= a"),
