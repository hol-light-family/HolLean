        REWRITE_TAC [PATH_IMAGE_NONEMPTY],
        DISCH_THEN (LABEL_TAC "+")] THEN
      SUBGOAL_THEN
        (← q r"!i:real^1. i IN k ==> &0 < ee((p i):complex)")
      ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, path_image, IN_IMAGE], ALL_TAC] THEN
      ABBREV_TAC (← q r"e = inf(IMAGE ((ee:complex->real) o (p:real^1->complex)) k)") THEN
