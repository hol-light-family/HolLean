  let HURWITZ_INJECTIVE ← prove
   r"!f:num->complex->complex g s.
    open s /\ connected s /\
    (!n. (f n) holomorphic_on s) /\ g holomorphic_on s /\
    (!k e. compact k /\ k SUBSET s /\ &0 < e
           ==> ?N. !n x. n >= N /\ x IN k ==> norm(f n x - g x) < e) /\
    ~(?c. !z. z IN s ==> g z = c) /\
    (!n w z. w IN s /\ z IN s /\ f n w = f n z ==> w = z)
    ==> (!w z. w IN s /\ z IN s /\ g w = g z ==> w = z)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"z1:complex", ← q r"z2:complex"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(g:complex->complex) z2")) THEN
    REWRITE_TAC [] THEN X_GEN_TAC (← q r"z0:complex") THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN REPEAT DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← MESON []
     (← q r"(!x y. x IN s /\ y IN s /\ g x = g y ==> x = y) <=>
      (!x y. x IN s /\ y IN s ==> (g x = g y <=> x = y))")]) THEN
    MP_TAC (← ISPECL
     [← q r"\z. (g:complex->complex) z - g z1", ← q r"s:complex->bool",
      ← q r"z2:complex", ← q r"z0:complex"]
          ISOLATED_ZEROS) THEN
    ASM_SIMP_TAC [COMPLEX_SUB_0, HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_ID,
                 HOLOMORPHIC_ON_CONST] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"\n z. (f:num->complex->complex) n z - f n z1",
      ← q r"\z. (g:complex->complex) z - g z1", ← q r"s DELETE (z1:complex)"]
          HURWITZ_NO_ZEROS) THEN
    REWRITE_TAC [NOT_IMP, COMPLEX_SUB_0] THEN REPEAT CONJ_TAC THENL
     [ASM_SIMP_TAC [OPEN_DELETE],
      ASM_SIMP_TAC [CONNECTED_OPEN_DELETE, DIMINDEX_2, LE_REFL],
      GEN_TAC THEN MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB, ETA_AX, HOLOMORPHIC_ON_CONST] THEN
      SET_TAC [],
      MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB, ETA_AX, HOLOMORPHIC_ON_CONST] THEN
      SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"k:complex->bool", ← q r"e:real"] THEN STRIP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE
       (← q r"k SUBSET s DELETE z ==> k SUBSET s"))) THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (
       MP_TAC (← SPECL [← q r"k:complex->bool", ← q r"e / &2"] th) THEN
       MP_TAC (← SPECL [← q r"{z1:complex}", ← q r"e / &2"] th))) THEN
      ASM_REWRITE_TAC [COMPACT_SING, SING_SUBSET, REAL_HALF] THEN
      SIMP_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_SING, FORALL_UNWIND_THM2] THEN
      REWRITE_TAC [IMP_IMP, RIGHT_IMP_FORALL_THM] THEN DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_TAC (← q r"N1:num")) (X_CHOOSE_TAC (← q r"N2:num"))) THEN
      EXISTS_TAC (← q r"MAX N1 N2") THEN REPEAT STRIP_TAC THEN
      UNDISCH_THEN (← q r"(g:complex->complex) z1 = g z2") (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x1 - x2) < e / &2 /\ norm(y1 - y2) < e / &2
        ==> norm(x1 - y1 - (x2 - y2)) < e")) THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"x >= MAX m n <=> x >= m /\ x >= n")],
      REWRITE_TAC [IN_DELETE, COMPLEX_EQ_SUB_RADD] THEN DISCH_THEN (CHOOSE_THEN
       (fun th => tactic_of do pure (MAP_EVERY
          (fun (t : term) => tactic_of do pure (MP_TAC (← SPEC t th)))
          [← q r"z0:complex", ← q r"z1:complex", ← q r"z2:complex"]))) THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC [],
      REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC []])

  pure { HURWITZ_NO_ZEROS, HURWITZ_INJECTIVE }
/- ------------------------------------------------------------------------- -/
/- The Great Picard theorem, and a thematic Montel variant.                  -/
/- (cauchy.ml 17612-18434)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBV where
  GREAT_PICARD : thm
  MONTEL_OMITTING : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBV [HolBase] (D : CauchyDeps) (BKYAW : KYAW) (BKYBE : KYBE) (BKYBQ : KYBQ) (BKYBS : KYBS) (BKYBU : KYBU) : ExceptT String IO KYBV := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_ON_EXTEND_BOUNDED, .. } := BKYAW
  let { MAXIMUM_MODULUS_FRONTIER, .. } := BKYBE
  let { SCHOTTKY, .. } := BKYBQ
  let { MONTEL, .. } := BKYBS
  let { HURWITZ_NO_ZEROS, .. } := BKYBU
  let { CLOSED_IN_LIMPT, COMPACT_IMP_HEINE_BOREL, .. } := D.qtopology
  let { INFINITE_ENUMERATE, .. } := D.qsession
  let { CONNECTED_OPEN_DELETE, .. } := D.qpaths
  let { INFINITE_ENUMERATE_WEAK, .. } := D.qmisc
  let { FRONTIER_UNION_SUBSET, OPEN_SUBOPEN, .. } := D.mt.qtopology
  let { REAL_EXP_POS_LT, .. } := D.mt.ra.tsb
  let { num_INFINITE, .. } := D.mt.ra.qsession
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, COMPLEX_IN_SPHERE_0, .. } := D.mt.ra.ts.kna
  let { LIM_COMPLEX_DIV, LIM_COMPLEX_INV, LIM_COMPLEX_MUL, UNIFORM_LIM_COMPLEX_INV,
        .. } := D.mt.ra.ts.knb
  let { HOLOMORPHIC_ON_EMPTY, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST,
        HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_INV, HOLOMORPHIC_ON_MUL,
        HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { COMPLEX_ADD_RID, COMPLEX_MUL_ASSOC, COMPLEX_MUL_RID, COMPLEX_MUL_RZERO,
        COMPLEX_SUB_0, COMPLEX_SUB_LZERO, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_VEC_0, CX_INJ, CX_MUL, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, COMPLEX_INV_DIV, COMPLEX_INV_INV, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_EQ_0, COMPLEX_DIV_LMUL, COMPLEX_INV_EQ_0, COMPLEX_INV_EQ_1,
        COMPLEX_NORM_DIV, COMPLEX_NORM_INV, COMPLEX_NORM_MUL, COMPLEX_NORM_NZ,
        .. } := D.mt.ra.ts.cn.cxf
  let { CLOSED_DIFF, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { INFINITE, .. } := D.mt.ra.ts.cn.cx.cpx
  let { SEPARATE_POINT_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, DIMINDEX_2, EQ_IMP, ETA_AX,
        EXISTS_IN_IMAGE, EXISTS_OR_THM, EXTENSION, FINITE_IMAGE, FINITE_UNION,
        FORALL_AND_THM, FORALL_IN_GSPEC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_UNWIND_THM2, GE, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DELETE, IN_DIFF,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_SING, IN_UNION, IN_UNIV, LE_1, LE_REFL, LEFT_IMP_EXISTS_THM,
        LEFT_OR_DISTRIB, MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL, MONO_IMP,
        MONO_OR, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, REAL_ABS_INV,
        REAL_ADD_LID, REAL_ARCH_INV, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_LE_1, REAL_LE_INV2, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_RADD,
        REAL_LE_RDIV_EQ, REAL_LE_SUP_FINITE, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_01,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ,
        REAL_LT_LMUL_EQ, REAL_LT_MUL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RINV, REAL_MUL_SYM, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_ADD,
        REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_SUB_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_FORALL_IMP_THM, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_EMPTY,
        SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_abs, real_div, real_ge, SWAP_EXISTS_THM, UNIONS_0, UNIONS_IMAGE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_NZ, DIST_REFL, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_NEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BOUNDED_CBALL, BOUNDED_DIFF, CENTRE_IN_BALL, CLOSED_CBALL, CLOSURE_CLOSED,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_CLOSED, COMPACT_SING, COMPACT_SPHERE,
        CONNECTED_CLOPEN, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, EVENTUALLY_AT, FRONTIER_BALL, FRONTIER_CBALL,
        FRONTIER_COMPLEMENT, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, INTERIOR_OPEN, INTERIOR_SUBSET, LIM_ADD, LIM_CONST,
        LIM_NULL_COMPARISON, LIM_SEQUENTIALLY, LIM_UNIQUE, LIMPT_APPROACHABLE, OPEN_BALL,
        OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, OPEN_SUBSET, SEQ_HARMONIC, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { REAL_INV_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { CONTINUOUS_AT, CONTINUOUS_ON_EQ_CONTINUOUS_AT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_TRANSFORM_WITHIN_OPEN, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { REAL_LT_INV2, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { OPEN_DELETE, SUBSET_BALLS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { EXISTS_FINITE_SUBSET_IMAGE, REAL_LT_RCANCEL_IMP,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let (GREAT_PICARD, MONTEL_OMITTING) ← (do
    let lemma1 ← prove
     r"!p q r s w.
            open s /\ connected s /\ w IN s /\ &0 < r /\
            (!h. h IN p
                 ==> h holomorphic_on s /\
                     !z. z IN s ==> ~(h z = Cx(&0)) /\ ~(h z = Cx(&1))) /\
            (!h. h IN q ==> h IN p /\ norm(h w) <= r)
            ==> ?B n. &0 < B /\ open n /\ w IN n /\ n SUBSET s /\
                      !h z. h IN q /\ z IN n ==> norm(h z) <= B"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"exp(pi * exp(pi * (&2 + &2 * r + &12)))",
        ← q r"ball(w:complex,e / &2)"] THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, REAL_HALF] THEN
      REWRITE_TAC [REAL_EXP_POS_LT] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
            SUBSET_TRANS)) THEN
        REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:complex->complex", ← q r"z:complex"] THEN
      STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:complex->complex"))) THEN
      ASM_CASES_TAC (← q r"(f:complex->complex) IN p") THEN ASM_REWRITE_TAC [] THEN
      REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\z. (f:complex->complex) (w + Cx e * z)", ← q r"r:real"]
       SCHOTTKY) THEN
      ASM_REWRITE_TAC [DE_MORGAN_THM, COMPLEX_MUL_RZERO, COMPLEX_ADD_RID] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
          MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
          SIMP_TAC [HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_MUL,
                   HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)) THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          X_GEN_TAC (← q r"u:complex") THEN DISCH_TAC,
          X_GEN_TAC (← q r"u:complex") THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        REWRITE_TAC [IN_CBALL, ← NORM_ARITH (← q r"dist(w,w + z) = norm z")] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← REAL_ARITH
         (← q r"&0 < e ==> (abs e * u <= e <=> e * u <= e * &1)")] THEN
        ASM_MESON_TAC [COMPLEX_IN_CBALL_0],
        DISCH_THEN (MP_TAC o SPECL [← q r"&1 / &2", ← q r"Cx(inv e) * (z - w)"]) THEN
        REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM CX_MUL] THEN
        ASM_SIMP_TAC [REAL_MUL_RINV, COMPLEX_NORM_MUL, REAL_LT_IMP_NZ] THEN
        REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"w + Cx(&1) * (z - w) = z"))] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN DISCH_THEN MATCH_MP_TAC THEN
        REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_INV] THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"inv e * x:real = x / e")] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
        CONV_TAC (fun t => NORM_ARITH t)])
    let lemma2 ← prove
     r"!s t:real^N->bool.
            connected t /\ ~(s = {}) /\ s SUBSET t /\ open s /\
            (!x. x limit_point_of s /\ x IN t ==> x IN s)
            ==> s = t"
     (REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_CLOPEN]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"s:real^N->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [CLOSED_IN_LIMPT] THEN ASM_SIMP_TAC [OPEN_SUBSET])
    let lemma3 ← prove
     r"!p s w q.
            open s /\ connected s /\ w IN s /\
            (!h. h IN p
                 ==> h holomorphic_on s /\
                     !z. z IN s ==> ~(h z = Cx(&0)) /\ ~(h z = Cx(&1))) /\
            (!h. h IN q ==> h IN p /\ norm(h w) <= &1)
            ==> !k. compact k /\ k SUBSET s
                    ==> ?b. !h z. h IN q /\ z IN k ==> norm(h z) <= b"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      ABBREV_TAC
       (← q r"u = {z | z IN s /\
                 ?B n. &0 < B /\ open n /\ z IN n /\ n SUBSET s /\
                       !h:complex->complex z'.
                         h IN q /\ z' IN n ==> norm(h z') <= B}") THEN
      SUBGOAL_THEN (← q r"(u:complex->bool) SUBSET s") ASSUME_TAC THENL
       [EXPAND_TAC "u" THEN REWRITE_TAC [SUBSET_RESTRICT], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"u:complex->bool = s") ASSUME_TAC THENL
       [MATCH_MP_TAC lemma2 THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"w:complex") THEN
          EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC lemma1 THEN
          MAP_EVERY EXISTS_TAC [← q r"p:(complex->complex)->bool", ← q r"&1"] THEN
          ASM_REWRITE_TAC [REAL_LT_01],
          ALL_TAC] THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [OPEN_SUBOPEN] THEN X_GEN_TAC (← q r"z:complex") THEN
          EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") MP_TAC) THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:complex->bool") THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EXPAND_TAC "u" THEN
          ONCE_REWRITE_TAC [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"v:complex") THEN DISCH_TAC THEN
          CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          MAP_EVERY EXISTS_TAC [← q r"B:real", ← q r"n:complex->bool"] THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"v:complex") THEN STRIP_TAC THEN
        EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC lemma1 THEN
        EXISTS_TAC (← q r"p:(complex->complex)->bool") THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← MESON []
         (← q r"(?r. P r /\ Q r) <=> ~(!r. P r ==> ~Q r)")] THEN
        DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"&n + &1:real")) THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [NOT_FORALL_THM] THEN
        ASM_SIMP_TAC [SKOLEM_THM] THEN
        REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC, REAL_NOT_LE] THEN
        REWRITE_TAC [FORALL_AND_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->complex->complex") STRIP_ASSUME_TAC) THEN
        ABBREV_TAC (← q r"g:num->complex->complex = \n z. inv(f n z)") THEN
        SUBGOAL_THEN (← q r"!n:num. (g n) holomorphic_on s") ASSUME_TAC THENL
         [GEN_TAC THEN EXPAND_TAC "g" THEN MATCH_MP_TAC HOLOMORPHIC_ON_INV THEN
          REWRITE_TAC [ETA_AX] THEN ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"!n:num z:complex. z IN s ==> ~(g n z = Cx(&0)) /\ ~(g n z = Cx(&1))")
        STRIP_ASSUME_TAC THENL
         [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "g" THEN
          REWRITE_TAC [COMPLEX_INV_EQ_0, COMPLEX_INV_EQ_1] THEN
          ASM SET_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"?B n. &0 < B /\
                open n /\
                v IN n /\
                n SUBSET s /\
                !h z. h IN {(g:num->complex->complex) n | n IN (:num)} /\ z IN n
                       ==> norm(h z) <= B")
        MP_TAC THENL
         [MATCH_MP_TAC lemma1 THEN
          EXISTS_TAC (← q r"{h |  h holomorphic_on s /\
                         !z. z IN s ==> ~(h z = Cx(&0)) /\ ~(h z = Cx(&1))}") THEN
          ASM_REWRITE_TAC [FORALL_IN_GSPEC] THEN EXISTS_TAC (← q r"&1") THEN
          ASM_REWRITE_TAC [IN_ELIM_THM, IN_UNIV, REAL_LT_01] THEN
          X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "g" THEN
          REWRITE_TAC [COMPLEX_NORM_INV] THEN MATCH_MP_TAC REAL_INV_LE_1 THEN
          ASM_MESON_TAC [← REAL_ARITH (← q r"&n + &1 < f ==> &1 <= f")],
          REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
          REWRITE_TAC [IN_UNIV] THEN STRIP_TAC] THEN
        UNDISCH_TAC (← q r"open(n:complex->bool)") THEN
        REWRITE_TAC [OPEN_CONTAINS_BALL] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"v:complex")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL [← q r"g:num->complex->complex",
