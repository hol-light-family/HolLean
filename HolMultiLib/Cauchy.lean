      ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
        REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN ASM SET_TAC [],
