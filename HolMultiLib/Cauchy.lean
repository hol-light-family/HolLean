  let { FRONTIER_OF_CONNECTED_COMPONENT_SUBSET, .. } := D.qconvex
  let { CONTINUOUS_ON_CEXP, HOLOMORPHIC_ON_CEXP, .. } := D.mt.ra.tsa
  let { REAL_EXP_MONO_LE, .. } := D.mt.ra.tsb
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, COMPLEX_IN_SPHERE_0, .. } := D.mt.ra.ts.kna
  let { CONTINUOUS_ON_COMPLEX_INV, .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_INV,
        HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { complex_norm, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_SUB2, COMPLEX_SUB_RZERO, COMPLEX_SUB_SUB2, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, IM_ADD, IM_CX, IM_SUB, RE_ADD, RE_CX, RE_SUB,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_INV_EQ_0, COMPLEX_NORM_INV, COMPLEX_NORM_NZ, COMPLEX_NORM_ZERO,
        .. } := D.mt.ra.ts.cn.cxf
  let { CONNECTED_CONNECTED_COMPONENT, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { SQRT_MONO_LT, .. } := D.mt.ra.ts.cn.cx.cpx
  let { DE_MORGAN_THM, FORALL_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN, IN_DIFF, INTER_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_INTER, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IN_EMPTY, REAL_ABS_REFL,
        REAL_ADD_RID, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_INV2, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_IMP_LE, REAL_LT_SQUARE_ABS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_SUB_RZERO, RIGHT_AND_EXISTS_THM, SUBSET,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_ge, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_NEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_SUBSET, CLOSED_CBALL, CLOSED_SING, CLOSURE_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_EQ_EMPTY, CLOSURE_SUBSET, COMPACT_CLOSURE, CONNECTED_COMPONENT_SUBSET,
        CONTINUOUS_ATTAINS_SUP, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_LE_ON_CLOSURE, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST,
        CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        FORALL_IN_CLOSURE, FRONTIER_BALL, FRONTIER_EQ_EMPTY,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, INTERIOR_OPEN, INTERIOR_SUBSET, NOT_BOUNDED_UNIV, OPEN_CONTAINS_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { closed, frontier, OPEN_INTERIOR, SUBSET_CLOSURE, SUBSET_INTERIOR,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { REAL_INV_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { CONNECTED_COMPONENT_REFL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { OPEN_CONNECTED_COMPONENT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CLOSURE_UNION_FRONTIER, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_INTER_CLOSURE_SUBSET, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { BOUNDED_INTER, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let MAXIMUM_MODULUS_PRINCIPLE ← prove
    r"!f a u w.
      open a /\ connected a /\ f holomorphic_on a /\
      open u /\ u SUBSET a /\ w IN u /\
      (!z. z IN u ==> norm(f z) <= norm(f w))
      ==> (?c. !z. z IN a ==> f z = c)"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
      (← q r"~(open (IMAGE (f:complex->complex) u))")
      (fun th => ASM_MESON_TAC [th, OPEN_MAPPING_THM]) THEN
    REWRITE_TAC [OPEN_CONTAINS_BALL, NOT_FORALL_THM] THEN
    EXISTS_TAC (← q r"(f:complex->complex) w") THEN
    MATCH_MP_TAC (← TAUT (← q r"!p q. (p /\ ~ q) ==> ~(p ==> q)")) THEN CONJ_TAC THENL
    [ASM_MESON_TAC [IN_IMAGE], ALL_TAC] THEN
    REWRITE_TAC [NOT_EXISTS_THM, DE_MORGAN_THM, SUBSET] THEN
    GEN_TAC THEN ASM_CASES_TAC (← q r"~(&0 < e)") THENL
    [ASM_REWRITE_TAC [], ALL_TAC] THEN POP_ASSUM MP_TAC THEN REWRITE_TAC [] THEN
    DISCH_TAC THEN DISJ2_TAC THEN REWRITE_TAC [NOT_FORALL_THM] THEN
    EXISTS_TAC (← q r"if &0 < Re((f:complex->complex) w)
                then f w + Cx(e / &2)
                else f w - Cx(e/ &2) ") THEN
    ABBREV_TAC (← q r"x = if &0<Re((f:complex->complex) w)
                    then f w + Cx(e / &2)
                    else f w - Cx(e / &2)") THEN
    MATCH_MP_TAC (← TAUT (← q r"!p q. (p /\ ~ q) ==> ~(p ==> q)")) THEN CONJ_TAC THENL
    [REWRITE_TAC [IN_BALL, dist] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!x y z:real. x = y /\ y < z ==> x < z ")) THEN
    EXISTS_TAC (← q r"e / &2") THEN EXPAND_TAC "x" THEN COND_CASES_TAC THENL
    [ASM_SIMP_TAC [NORM_NEG, COMPLEX_ADD_SUB2, ← REAL_ARITH (← q r"&0 < e ==> e / &2 <e"),
                    COMPLEX_NORM_CX, REAL_ABS_REFL,
                    ← REAL_ARITH (← q r"&0 < e ==> &0 <= e / &2")],
    ASM_SIMP_TAC [COMPLEX_SUB_SUB2, ← REAL_ARITH (← q r"&0 < e ==> e / &2 <e"),
                    COMPLEX_NORM_CX, REAL_ABS_REFL,
                    ← REAL_ARITH (← q r"&0 < e ==> &0 <= e / &2")]], ALL_TAC] THEN
    REWRITE_TAC [IN_IMAGE, NOT_EXISTS_THM, DE_MORGAN_THM] THEN
    GEN_TAC THEN ASM_CASES_TAC (← q r"~(x':complex IN u)") THENL
    [ASM_REWRITE_TAC [], ALL_TAC] THEN DISJ1_TAC THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← NORM_ARITH (← q r"!x y:complex. ~(norm x=norm y) ==> ~(x=y)")) THEN
    REWRITE_TAC [REAL_NOT_EQ] THEN DISJ2_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"norm ((f:complex->complex) w)") THEN ASM_SIMP_TAC [] THEN
    EXPAND_TAC "x" THEN COND_CASES_TAC THEN
    REWRITE_TAC [complex_norm, RE_ADD, IM_ADD, IM_CX, RE_CX, REAL_ADD_RID] THENL
    [MATCH_MP_TAC SQRT_MONO_LT THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!x:real y z. x < y ==> x + z < y + z")) THEN
    REWRITE_TAC [← GSYM REAL_LT_SQUARE_ABS] THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"!x y. &0 < x /\ &0 < y
                            ==> abs (x+y) = abs x + abs y"),
                  ← REAL_ARITH (← q r"!x:real. &0 < x ==> &0 < x / &2")] THEN
    ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [complex_norm, RE_SUB, IM_SUB, IM_CX, RE_CX, REAL_SUB_RZERO] THEN
    MATCH_MP_TAC SQRT_MONO_LT THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!x:real y z. x < y ==> x + z < y + z")) THEN
    REWRITE_TAC [← GSYM REAL_LT_SQUARE_ABS] THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [REAL_NOT_LT] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"!x y. x <= &0 /\ &0 < y
                              ==> abs (x - y) = abs x + abs y"),
                ← REAL_ARITH (← q r"!x. &0 < x ==> &0 < x/ &2")] THEN
    ASM_REAL_ARITH_TAC)

  let MAXIMUM_MODULUS_FRONTIER ← prove
   r"!f s B.
        bounded s /\
        f holomorphic_on (interior s) /\
        f continuous_on (closure s) /\
        (!z. z IN frontier s ==> norm(f z) <= B)
        ==> !z. z IN s ==> norm(f z) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"norm o (f:complex->complex)", ← q r"closure s:complex->bool"]
          CONTINUOUS_ATTAINS_SUP) THEN
    ASM_REWRITE_TAC [COMPACT_CLOSURE, CLOSURE_EQ_EMPTY] THEN
    ASM_CASES_TAC (← q r"s:complex->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_SIMP_TAC [o_DEF, CONTINUOUS_ON_LIFT_NORM_COMPOSE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:complex") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"norm((f:complex->complex) z) <= B") ASSUME_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [CLOSURE_SUBSET, SUBSET, REAL_LE_TRANS]] THEN
    ASM_CASES_TAC (← q r"(z:complex) IN frontier s") THEN ASM_SIMP_TAC [] THEN
    SUBGOAL_THEN (← q r"(z:complex) IN interior s") ASSUME_TAC THENL
     [ASM_MESON_TAC [frontier, IN_DIFF], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex",
                   ← q r"connected_component (interior s) (z:complex)",
                   ← q r"connected_component (interior s) (z:complex)",
                   ← q r"z:complex"]
          MAXIMUM_MODULUS_PRINCIPLE) THEN
    ASSUME_TAC (← ISPECL [← q r"interior s:complex->bool", ← q r"z:complex"]
          CONNECTED_COMPONENT_SUBSET) THEN
    ASSUME_TAC (← ISPEC (← q r"s:complex->bool") INTERIOR_SUBSET) THEN
    ASSUME_TAC (← ISPEC (← q r"s:complex->bool") CLOSURE_SUBSET) THEN
    SUBGOAL_THEN (← q r"(z:complex) IN connected_component (interior s) z")
    ASSUME_TAC THENL [ASM_MESON_TAC [IN, CONNECTED_COMPONENT_REFL], ALL_TAC] THEN
    SIMP_TAC [OPEN_CONNECTED_COMPONENT, OPEN_INTERIOR, SUBSET_REFL] THEN
    ASM_REWRITE_TAC [CONNECTED_CONNECTED_COMPONENT] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_TRANS],
      DISCH_THEN (X_CHOOSE_TAC (← q r"c:complex"))] THEN
    SUBGOAL_THEN
     (← q r"!w. w IN closure(connected_component (interior s) z)
          ==> (f:complex->complex) w IN {c}")
    MP_TAC THENL
     [MATCH_MP_TAC FORALL_IN_CLOSURE THEN
      ASM_REWRITE_TAC [IN_SING, CLOSED_SING] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      MATCH_MP_TAC SUBSET_CLOSURE THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET, SUBSET_TRANS],
      REWRITE_TAC [IN_SING]] THEN
    SUBGOAL_THEN
     (← q r"~(frontier(connected_component (interior s) (z:complex)) = {})")
    MP_TAC THENL
     [REWRITE_TAC [FRONTIER_EQ_EMPTY, DE_MORGAN_THM] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_MESON_TAC [BOUNDED_SUBSET, NOT_BOUNDED_UNIV],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"a:complex") THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN
    ASM_SIMP_TAC [CLOSURE_UNION_FRONTIER, IN_UNION] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
     (← q r"a IN s ==> s SUBSET t ==> a IN t"))) THEN
    TRANS_TAC SUBSET_TRANS (← q r"frontier(interior s:complex->bool)") THEN
    SIMP_TAC [FRONTIER_INTERIOR_SUBSET, FRONTIER_OF_CONNECTED_COMPONENT_SUBSET])

  let MAXIMUM_REAL_FRONTIER ← prove
   r"!f s B.
        bounded s /\
        f holomorphic_on (interior s) /\
        f continuous_on (closure s) /\
        (!z. z IN frontier s ==> Re(f z) <= B)
        ==> !z. z IN s ==> Re(f z) <= B"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"cexp o (f:complex->complex)", ← q r"s:complex->bool", ← q r"exp B"]
          MAXIMUM_MODULUS_FRONTIER) THEN
    ASM_SIMP_TAC [NORM_CEXP, o_THM, HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CEXP,
                 CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CEXP] THEN
    ASM_REWRITE_TAC [REAL_EXP_MONO_LE])

  let HOLOMORPHIC_CONSTANT_ON_FRONTIER ← prove
   r"!f s c.
        bounded s /\
        f holomorphic_on interior s /\
        f continuous_on closure s /\
        (!z. z IN frontier s ==> f z = c)
        ==> !z. z IN s ==> f z = c"
   (REWRITE_TAC [← NORM_ARITH (← q r"x:complex = c <=> norm(x - c) <= &0")] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC MAXIMUM_MODULUS_FRONTIER THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB, CONTINUOUS_ON_SUB,
                 HOLOMORPHIC_ON_CONST, CONTINUOUS_ON_CONST])

  let HOLOMORPHIC_CONSTANT_NORM ← prove
   r"!f s. open s /\ connected s /\
         f holomorphic_on s /\
         (?c. !z. z IN s ==> norm(f z) = c)
         ==> ?a. !z. z IN s ==> f z = a"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:complex->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"w:complex")) THEN
    MATCH_MP_TAC MAXIMUM_MODULUS_PRINCIPLE THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"w:complex"] THEN
    ASM_SIMP_TAC [SUBSET_REFL, REAL_LE_REFL])

  let HOLOMORPHIC_NONZERO_CONSTANT_NORM_ON_FRONTIER ← prove
   r"!f s.
        bounded s /\ open s /\ connected s /\
        f holomorphic_on s /\ f continuous_on closure s /\
        (!z. z IN s ==> ~(f z = Cx(&0))) /\
        (?c. !z. z IN frontier s ==> norm(f z) = c)
        ==> ?a. !z. z IN s ==> f z = a"
   (REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THENL
     [DISCH_THEN (fun th => tactic_of do pure (EXISTS_TAC (← q r"Cx(&0)") THEN MP_TAC th)) THEN
      ASM_REWRITE_TAC [← GSYM COMPLEX_NORM_ZERO] THEN
      REWRITE_TAC [← NORM_ARITH (← q r"norm(x) = &0 <=> norm(x) <= &0")] THEN
      ASM_MESON_TAC [MAXIMUM_MODULUS_FRONTIER, INTERIOR_OPEN],
      STRIP_TAC] THEN
    MATCH_MP_TAC HOLOMORPHIC_CONSTANT_NORM THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"c:real") THEN
    REWRITE_TAC [← GSYM REAL_LE_ANTISYM, FORALL_AND_THM, ← TAUT
     (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MAXIMUM_MODULUS_FRONTIER THEN
      ASM_SIMP_TAC [REAL_LE_REFL, INTERIOR_OPEN],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM REAL_INV_INV] THEN
    ONCE_REWRITE_TAC [← GSYM COMPLEX_NORM_INV] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN
    ASM_SIMP_TAC [COMPLEX_NORM_NZ, COMPLEX_INV_EQ_0] THEN
    UNDISCH_TAC (← q r"(w:complex) IN s") THEN SPEC_TAC (← q r"w:complex", ← q r"w:complex") THEN
    MATCH_MP_TAC MAXIMUM_MODULUS_FRONTIER THEN
    ASM_SIMP_TAC [REAL_LE_REFL, INTERIOR_OPEN, HOLOMORPHIC_ON_INV] THEN
    ASM_SIMP_TAC [COMPLEX_NORM_INV, REAL_LE_REFL] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_INV THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"w:complex") THEN ASM_CASES_TAC (← q r"(w:complex) IN frontier s") THENL
     [ASM_MESON_TAC [COMPLEX_NORM_ZERO],
      ASM_MESON_TAC [frontier, IN_DIFF, INTERIOR_SUBSET, SUBSET]])

  let MAXIMUM_MODULUS_LIMIT_ATINFINITY ← (do
    let lemma ← prove
     r"(!c. b < c ==> a <= c) ==> a <= b"
     (DISCH_THEN (MP_TAC o SPEC (← q r"(a + b) / &2")) THEN REAL_ARITH_TAC)
    prove
     r"!f s B.
          &0 <= B /\
          f holomorphic_on interior s /\
          f continuous_on closure s /\
          (!z. z IN frontier s ==> norm(f z) <= B) /\
          (f --> Cx(&0)) (at_infinity within s)
          ==> !z. z IN s ==> norm(f z) <= B"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC lemma THEN
    X_GEN_TAC (← q r"C:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_AT_INFINITY_WITHIN_POS]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"C:real")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_REWRITE_TAC [dist, COMPLEX_SUB_RZERO, real_ge] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"R:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"f:complex->complex", ← q r"s INTER ball(Cx(&0),R + &1)", ← q r"C:real"]
     MAXIMUM_MODULUS_FRONTIER) THEN
    ASM_SIMP_TAC [BOUNDED_INTER, BOUNDED_BALL] THEN ANTS_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [IN_INTER, COMPLEX_IN_BALL_0] THEN
      ASM_MESON_TAC [← REAL_ARITH (← q r"r <= z \/ z < r + &1"), REAL_LT_IMP_LE]] THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_INTERIOR, INTER_SUBSET],
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET_CLOSURE, INTER_SUBSET],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← REWRITE_RULE [SUBSET] FRONTIER_INTER_SUBSET_INTER)) THEN
    ASM_SIMP_TAC [IN_UNION, FRONTIER_BALL, COMPLEX_IN_SPHERE_0, IN_INTER,
      CLOSURE_BALL, COMPLEX_IN_CBALL_0, ← REAL_ARITH (← q r"&0 < r ==> &0 < r + &1")] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THEN ASM_SIMP_TAC [] THENL
     [ALL_TAC, ASM_MESON_TAC [REAL_LE_TRANS, REAL_LT_IMP_LE]] THEN
    REWRITE_TAC [IMP_CONJ_ALT] THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← REAL_ARITH (← q r"w = r + &1 ==> ~(w <= r)"))) THEN
    REWRITE_TAC [← GSYM COMPLEX_IN_CBALL_0, IMP_IMP] THEN
    REWRITE_TAC [← SET_RULE
      (← q r"~(x IN s) /\ x IN t <=> x IN (UNIV DIFF s) INTER t")] THEN
    MP_TAC (← ISPECL [← q r"(:complex) DIFF cball(Cx(&0),R)", ← q r"s:complex->bool"]
          OPEN_INTER_CLOSURE_SUBSET) THEN
    REWRITE_TAC [← GSYM closed, IMP_IMP, CLOSED_CBALL, COMPLEX_IN_CBALL_0] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE
     (← q r"s SUBSET t /\ x IN s ==> x IN t"))) THEN
    SPEC_TAC (← q r"w:complex", ← q r"w:complex") THEN
    MATCH_MP_TAC CONTINUOUS_LE_ON_CLOSURE THEN
    REWRITE_TAC [IN_INTER, COMPLEX_IN_CBALL_0, IN_UNIV, IN_DIFF, REAL_NOT_LE] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
    ASM_MESON_TAC [INTER_SUBSET, CONTINUOUS_ON_SUBSET, SUBSET_CLOSURE]))

  pure { MAXIMUM_MODULUS_PRINCIPLE, MAXIMUM_MODULUS_FRONTIER, MAXIMUM_REAL_FRONTIER,
         HOLOMORPHIC_CONSTANT_ON_FRONTIER, HOLOMORPHIC_CONSTANT_NORM,
         HOLOMORPHIC_NONZERO_CONSTANT_NORM_ON_FRONTIER, MAXIMUM_MODULUS_LIMIT_ATINFINITY }
/- ------------------------------------------------------------------------- -/
/- Bounded maximum modulus, constancy on sphere segments, proper images.    -/
/- (cauchy.ml 13277-13712)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBF where
  MAXIMUM_MODULUS_BOUNDED_FUNCTION : thm
  HOLOMORPHIC_CONSTANT_ON_SPHERE_SEGMENT : thm
  FRONTIER_PROPER_HOLOMORPHIC_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBF [HolBase] (D : CauchyDeps) (BKYBC : KYBC) (BKYBD : KYBD) (BKYBE : KYBE) : ExceptT String IO KYBF := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_FUNCTION_ENTIRE_PRODUCT, .. } := BKYBC
  let { OPEN_MAPPING_THM, .. } := BKYBD
  let { HOLOMORPHIC_CONSTANT_ON_FRONTIER, MAXIMUM_MODULUS_LIMIT_ATINFINITY, .. } := BKYBE
  let { CBALL_TRANSLATION, CLOSURE_INTER_SUBSET, EVENTUALLY_AT_INFINITY_WITHIN,
        FRONTIER_INTER_SUBSET_INTER, FRONTIER_PROPER_OPEN_MAP_IMAGE,
        LIM_AT_INFINITY_WITHIN, SPHERE_TRANSLATION, .. } := D.qtopology
  let { SEGMENT_TO_FRONTIER, .. } := D.qpaths
  let { REALLIM_NULL_LMUL, .. } := D.mt.rza
  let { REALLIM_SEQUENTIALLY, .. } := D.mt.rzb
  let { REALLIM_REAL_CONTINUOUS_FUNCTION, .. } := D.mt.rzj
  let { REAL_CONTINUOUS_AT_EXP, .. } := D.mt.rzp
  let { REALLIM_1_OVER_N, .. } := D.mt.rzr
  let { CEXP_0, CEXP_ADD, CEXP_NZ, CEXP_SUB, CONTINUOUS_ON_CEXP, .. } := D.mt.ra.tsa
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { ARG, .. } := D.mt.ra.tsh
  let { LIM_INV_Z_OFFSET, .. } := D.mt.ra.tsx
  let { REAL_POW_ROOT, root, ROOT_POS_LE, .. } := D.mt.ra.tsaa
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, COMPLEX_IN_SPHERE_0, .. } := D.mt.ra.ts.kna
  let { LIM_NULL_COMPLEX_LMUL, LIM_NULL_COMPLEX_RMUL_BOUNDED, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_ON_COMPLEX_DIV, CONTINUOUS_ON_COMPLEX_LMUL, CONTINUOUS_ON_COMPLEX_MUL,
        CONTINUOUS_ON_COMPLEX_POW, CONTINUOUS_ON_CPRODUCT, .. } := D.mt.ra.ts.knc
  let { CONTINUOUS_ON_CX_DROP, .. } := D.mt.ra.ts.knd
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST,
        HOLOMORPHIC_ON_CPRODUCT, HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID,
        HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_POW, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { complex_div, complex_sub, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_RID, COMPLEX_ADD_RINV, COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID,
        COMPLEX_MUL_RZERO, COMPLEX_SUB_0, COMPLEX_SUB_LDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, CX_MUL, CX_SUB, IM_CX, RE_MUL_II, RE_NEG,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_POW,
        .. } := D.mt.ra.ts.cn.cxf
  let { CPRODUCT_EQ_0, .. } := D.mt.ra.ts.cn.cxk
  let { LIM_AT_INFINITY, .. } := D.mt.ra.ts.cn.qtopology
  let { FLOOR_FRAC, REAL_FLOOR_LE, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { REAL_LT_BETWEEN, .. } := D.mt.ra.ts.cn.ms.qmisc
  let { ADD_EQ_0, REAL_POW_LE2_REV, real_sgn, .. } := D.mt.ra.ts.cn.ms.qsession
  let { BALL_TRANSLATION, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { FLOOR_POS, INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { ARITH_EQ, CONTRAPOS_THM, FINITE_NUMSEG, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ,
        IMP_CONJ_ALT, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIV, LE_ADD,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, NUMSEG_EMPTY,
        REAL_ABS_MUL, REAL_ABS_SUB, REAL_ARCH_SIMPLE, REAL_DIV_1, REAL_DIV_RMUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_EQ_0, REAL_INV_MUL, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LE_MIN,
        REAL_LE_MUL2, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_RMUL_EQ,
        REAL_LE_TRANS, REAL_LT_01, REAL_LT_DIV, REAL_LT_DIV2_EQ, REAL_LT_IMP_LE,
        REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_RDIV_EQ, REAL_MIN_LT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_RID, REAL_MUL_RINV, REAL_MUL_SYM, REAL_NEG_0,
        REAL_NOT_LT, REAL_OF_NUM_LE, REAL_POS, REAL_POW_LE, REAL_POW_LE2, REAL_POW_LT,
        REAL_POW_MUL, REAL_SUB_LT, SUBSET, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_LIFT, DIST_NZ, DIST_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { FORALL_LIFT, LIFT_DROP, LINEAR_SCALING, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_MUL_ASSOC, VECTOR_MUL_LCANCEL, VECTOR_SUB_EQ,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { OPEN_IN_IMP_SUBSET, SUBTOPOLOGY_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BOUNDED_BALL, CBALL_EMPTY, CBALL_SCALING, CBALL_SING, CENTRE_IN_BALL,
        CENTRE_IN_CBALL, CLOSED_SING, CLOSURE_BALL, CLOSURE_COMPLEMENT,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, CONTINUOUS_OPEN_IN_PREIMAGE_GEN,
        ENDS_NOT_IN_SEGMENT, FORALL_IN_CLOSURE, FRONTIER_BALL, FRONTIER_CBALL,
        FRONTIER_COMPLEMENT, FRONTIER_EMPTY, FRONTIER_EQ_EMPTY, FRONTIER_SING,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, IN_INTERIOR_CBALL, IN_SEGMENT, IN_SPHERE, INTERIOR_CBALL,
        INTERIOR_OPEN, INTERIOR_SUBSET, NOT_BOUNDED_UNIV, OPEN_BALL, OPEN_CONTAINS_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, continuous_on, frontier, open_in, OPEN_IN, OPEN_IN_INJECTIVE_LINEAR_IMAGE,
        SEGMENT_SYM, SUBSET_CBALL, SUBSET_CLOSURE, SUBSET_INTERIOR,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { REAL_INV_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { OPEN_IN_TRANSLATION_EQ, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { CONTINUOUS_ON_CMUL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { SPHERE_SCALING, SPHERE_SING, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { BALL_SCALING, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let MAXIMUM_MODULUS_BOUNDED_FUNCTION ← (do
    let lemma ← prove
     r"(!c. b < c ==> a <= c) ==> a <= b"
     (DISCH_THEN (MP_TAC o SPEC (← q r"(a + b) / &2")) THEN REAL_ARITH_TAC)
    prove
     r"!f s B.
          f holomorphic_on interior s /\
          f continuous_on closure s /\
          (!z. z IN frontier s ==> norm(f z) <= B) /\
          ~(s = (:complex)) /\ bounded(IMAGE f s)
          ==> !z. z IN s ==> norm(f z) <= B"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:complex->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"B < &0") THENL
     [SUBGOAL_THEN (← q r"~(frontier(s:complex->bool) = {})") MP_TAC THENL
       [ASM_REWRITE_TAC [FRONTIER_EQ_EMPTY], ALL_TAC] THEN
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, ← NORM_ARITH (← q r"B < &0 ==> ~(norm z <= B)")],
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LT])] THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(z:complex) IN interior s") THENL
     [ALL_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN
      MP_TAC (← ISPEC (← q r"s:complex->bool") CLOSURE_SUBSET) THEN ASM SET_TAC []] THEN
    MATCH_MP_TAC lemma THEN X_GEN_TAC (← q r"D:real") THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"B:real", ← q r"D:real"] REAL_LT_BETWEEN) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?p:complex r. &0 < r /\ p IN s /\ cball(p,r) SUBSET s /\
                    ~(z IN cball(p,r)) /\
                    !w. w IN cball(p,r) ==> norm(f w:complex) <= C")
    STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(s = UNIV) ==> interior s SUBSET s ==> ?a. ~(a IN interior s)"))) THEN
      REWRITE_TAC [INTERIOR_SUBSET] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"q:complex")) THEN
      MP_TAC (← ISPECL [← q r"s:complex->bool", ← q r"z:complex", ← q r"q:complex"]
          SEGMENT_TO_FRONTIER) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:complex") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_on]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"c:complex")) THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [frontier]) THEN ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"C - B:real")) THEN
      ASM_REWRITE_TAC [REAL_SUB_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?p:complex. p IN segment(z,c) /\ dist(p,c) < d / &2")
      MP_TAC THENL
       [EXISTS_TAC
         (← q r"c + min (&1 / &2) (d / &4 / dist(z,c)) % (z - c):complex") THEN
        CONJ_TAC THENL
         [ONCE_REWRITE_TAC [SEGMENT_SYM] THEN ASM_REWRITE_TAC [IN_SEGMENT] THEN
          EXISTS_TAC (← q r"min (&1 / &2) (d / &4 / dist(z:complex,c))") THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"c + a % (z - c) = (&1 - a) % c + a % z")] THEN
          REWRITE_TAC [REAL_LT_MIN, REAL_MIN_LT] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV,
          REWRITE_TAC [← NORM_ARITH (← q r"dist(c + z:complex,c) = norm z")] THEN
          REWRITE_TAC [NORM_MUL] THEN
          ASM_SIMP_TAC [← GSYM dist, ← GSYM REAL_LT_RDIV_EQ, ← GSYM DIST_NZ] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"&0 < a /\ &0 < b /\ c / &2 = b ==> abs(min a b) < c")) THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN
          CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC]] THEN
        REPEAT (MATCH_MP_TAC REAL_LT_DIV THEN CONJ_TAC) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [← GSYM DIST_NZ],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:complex") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(p:complex) IN interior s") MP_TAC THENL
         [ASM SET_TAC [], REWRITE_TAC [IN_INTERIOR_CBALL]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"min r (min (d / &2) (dist(p:complex,z) / &2))") THEN
        REPEAT CONJ_TAC THENL
         [ASM_REWRITE_TAC [REAL_LT_MIN, ← GSYM DIST_NZ, REAL_HALF] THEN
          ASM_MESON_TAC [ENDS_NOT_IN_SEGMENT],
          ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET],
          TRANS_TAC SUBSET_TRANS (← q r"cball(p:complex,r)") THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_CBALL THEN
          REAL_ARITH_TAC,
          REWRITE_TAC [IN_CBALL, REAL_LE_MIN, ← NORM_ARITH
           (← q r"dist(a,b) <= dist(a,b) / &2 <=> a = b")] THEN
          ASM_MESON_TAC [ENDS_NOT_IN_SEGMENT],
          X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [IN_CBALL, REAL_LE_MIN] THEN
          STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:complex")) THEN
          ANTS_TAC THENL
           [CONJ_TAC THENL
             [ASM_MESON_TAC [SUBSET, IN_CBALL, CLOSURE_SUBSET],
              MAP_EVERY UNDISCH_TAC
               [← q r"dist(p:complex,w) <= d / &2", ← q r"dist(p:complex,c) < d / &2"] THEN
              CONV_TAC (fun t => NORM_ARITH t)],
            FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:complex")) THEN
            ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t)]]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"&0 < C /\ &0 < D") STRIP_ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(z:complex = p)") ASSUME_TAC THENL
     [ASM_MESON_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"((\n. root n (norm(z - p) / r)) ---> &1) sequentially")
    MP_TAC THENL
     [REWRITE_TAC [root] THEN
      ASM_SIMP_TAC [real_sgn, real_abs, REAL_LT_DIV, NORM_POS_LT,
                   VECTOR_SUB_EQ, REAL_LT_IMP_LE, REAL_MUL_LID] THEN
      REWRITE_TAC [← GSYM REAL_EXP_0] THEN
      MATCH_MP_TAC (← SPEC (← q r"exp") REALLIM_REAL_CONTINUOUS_FUNCTION) THEN
      REWRITE_TAC [REAL_CONTINUOUS_AT_EXP, real_div] THEN
      MATCH_MP_TAC REALLIM_NULL_LMUL THEN
      REWRITE_TAC [REALLIM_1_OVER_N],
      ALL_TAC] THEN
    REWRITE_TAC [REALLIM_SEQUENTIALLY] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(D - C:real) / C")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (MP_TAC o SPEC (← q r"n + 1"))) THEN
    REWRITE_TAC [LE_ADD] THEN DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPECL
     [← q r"\w. Cx(r) / (w - p) * (f w) pow (n + 1)",
      ← q r"s DIFF cball(p:complex,r)",
      ← q r"(C:real) pow (n + 1)"]
      MAXIMUM_MODULUS_LIMIT_ATINFINITY) THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC REAL_POW_LE THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC HOLOMORPHIC_ON_MUL THEN CONJ_TAC THENL
         [MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
          SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_CONST,
                   HOLOMORPHIC_ON_ID] THEN
          GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
          SIMP_TAC [COMPLEX_SUB_0] THEN DISCH_TAC THEN
          DISCH_THEN (MP_TAC o MATCH_MP
           (← REWRITE_RULE [SUBSET] INTERIOR_SUBSET)) THEN
          ASM_SIMP_TAC [IN_DIFF, CENTRE_IN_CBALL, REAL_LT_IMP_LE],
          MATCH_MP_TAC HOLOMORPHIC_ON_POW THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)) THEN
          MATCH_MP_TAC SUBSET_INTERIOR THEN SET_TAC []],
        MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_DIV THEN
          SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST,
                   CONTINUOUS_ON_ID] THEN
          GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
          SIMP_TAC [COMPLEX_SUB_0] THEN DISCH_TAC THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
          DISCH_THEN (MP_TAC o MATCH_MP
           (← REWRITE_RULE [SUBSET] CLOSURE_INTER_SUBSET)) THEN
          REWRITE_TAC [CLOSURE_COMPLEMENT, INTERIOR_CBALL] THEN
          ASM_REWRITE_TAC [IN_INTER, IN_UNIV, IN_DIFF, CENTRE_IN_BALL],
          MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_POW THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          MATCH_MP_TAC SUBSET_CLOSURE THEN SET_TAC []],
        X_GEN_TAC (← q r"w:complex") THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s INTER (UNIV DIFF t)")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP
           (← REWRITE_RULE [SUBSET] FRONTIER_INTER_SUBSET_INTER)) THEN
        REWRITE_TAC [FRONTIER_COMPLEMENT, FRONTIER_CBALL, CLOSURE_COMPLEMENT] THEN
        ASM_REWRITE_TAC [IN_UNION, IN_INTER, IN_DIFF, IN_UNIV,
                        INTERIOR_CBALL, IN_BALL] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_DIV] THEN
        ASM_SIMP_TAC [COMPLEX_NORM_POW, real_abs, REAL_LT_IMP_LE] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a / b * c:real = (a * c) / b")] THEN
        ASM_CASES_TAC (← q r"w:complex = p") THEN
        ASM_SIMP_TAC [CENTRE_IN_BALL, IN_SPHERE, DIST_REFL, REAL_LT_IMP_NZ] THEN
        ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
        ASM_SIMP_TAC [REAL_LE_LDIV_EQ, NORM_POS_LT, VECTOR_SUB_EQ] THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        REWRITE_TAC [IN_BALL, dist, REAL_NOT_LT] THEN
        STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [REAL_LE_REFL, REAL_LT_IMP_LE] THEN
        SIMP_TAC [REAL_POW_LE, NORM_POS_LE] THEN
        MATCH_MP_TAC REAL_POW_LE2 THEN REWRITE_TAC [NORM_POS_LE] THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_REWRITE_TAC [IN_CBALL, dist, REAL_LE_REFL],
          TRANS_TAC REAL_LE_TRANS (← q r"B:real") THEN ASM_SIMP_TAC [REAL_LT_IMP_LE]],
        MATCH_MP_TAC LIM_NULL_COMPLEX_RMUL_BOUNDED THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [bounded]) THEN
        REWRITE_TAC [FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"E:real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"(E:real) pow (n + 1)") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [complex_div] THEN MATCH_MP_TAC LIM_NULL_COMPLEX_LMUL THEN
          MP_TAC (← ISPEC (← q r"--p:complex") LIM_INV_Z_OFFSET) THEN
          REWRITE_TAC [LIM_AT_INFINITY_WITHIN, LIM_AT_INFINITY, ← GSYM complex_sub,
                      IN_DIFF] THEN
          MESON_TAC [],
          REWRITE_TAC [EVENTUALLY_AT_INFINITY_WITHIN] THEN
          EXISTS_TAC (← q r"&0") THEN REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
          DISJ2_TAC THEN REWRITE_TAC [COMPLEX_NORM_POW] THEN
          MATCH_MP_TAC REAL_POW_LE2 THEN ASM_SIMP_TAC [NORM_POS_LE]]],
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_DIV, COMPLEX_NORM_CX] THEN
      ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LE_RDIV_EQ, REAL_LT_DIV,
                   NORM_POS_LT, VECTOR_SUB_EQ] THEN
      REWRITE_TAC [real_div, REAL_INV_MUL, REAL_INV_INV] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * inv b * c:real = c / b * a")] THEN
      DISCH_TAC] THEN
    MATCH_MP_TAC REAL_POW_LE2_REV THEN EXISTS_TAC (← q r"n + 1") THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, ADD_EQ_0, ARITH_EQ] THEN
    REWRITE_TAC [← GSYM COMPLEX_NORM_POW] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS)) THEN
    SUBGOAL_THEN (← q r"D:real = D / C * C") SUBST1_TAC THENL
     [ASM_SIMP_TAC [REAL_DIV_RMUL, REAL_LT_IMP_NZ], ALL_TAC] THEN
    REWRITE_TAC [REAL_POW_MUL] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
    ASM_SIMP_TAC [REAL_POW_LT, REAL_LT_IMP_LE] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REAL_FIELD
     (← q r"abs(x - &1) < (D - C) / C ==> &0 < C ==> x <= D / C"))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"n + 1") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] REAL_POW_LE2)) THEN
    ASM_SIMP_TAC [ROOT_POS_LE, REAL_LT_IMP_LE, REAL_LT_DIV,
                 NORM_POS_LT, VECTOR_SUB_EQ, REAL_POW_ROOT, ADD_EQ_0,
                 ARITH_EQ]))

  let HOLOMORPHIC_CONSTANT_ON_SPHERE_SEGMENT ← prove
   r"!f a r s c.
        f holomorphic_on ball(a,r) /\
        f continuous_on cball(a,r) /\
        open_in (subtopology euclidean (sphere(a,r))) s /\ ~(s = {}) /\
        (!z. z IN s ==> f z = c)
        ==> !z. z IN cball(a,r) ==> f z = c"
   (SUBGOAL_THEN
     (← q r"!f t. f holomorphic_on ball(Cx(&0),&1) /\
            f continuous_on cball(Cx(&0),&1) /\
            open_in (subtopology euclidean (sphere(Cx(&0),&1))) t /\ ~(t = {}) /\
            (!z. z IN t ==> f z = Cx(&0))
            ==> !z. z IN cball(Cx(&0),&1) ==> f z = Cx(&0)")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"r < &0") THEN
      ASM_SIMP_TAC [CBALL_EMPTY, NOT_IN_EMPTY] THEN
      ASM_CASES_TAC (← q r"r = &0") THENL
       [ASM_REWRITE_TAC [] THEN
        SIMP_TAC [CBALL_SING, open_in, IN_SING, SPHERE_SING] THEN SET_TAC [],
        SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL
         [ASM_REAL_ARITH_TAC, STRIP_TAC]] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\z. (f:complex->complex)(a + r % z) - c",
        ← q r"IMAGE (\z. inv(r) % (z - a)) s"]) THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_0, IMAGE_EQ_EMPTY] THEN
      SUBGOAL_THEN
       (← q r"cball(a,r) = IMAGE (\z. a + z) (IMAGE (\z. r % z) (cball(Cx(&0),&1))) /\
        ball(a,r) = IMAGE (\z. a + z) (IMAGE (\z. r % z) (ball(Cx(&0),&1)))")
      MP_TAC THENL
       [ASM_SIMP_TAC [← GSYM CBALL_TRANSLATION, ← GSYM CBALL_SCALING] THEN
        ASM_SIMP_TAC [← GSYM BALL_TRANSLATION, ← GSYM BALL_SCALING] THEN
        REWRITE_TAC [REAL_MUL_RID, COMPLEX_CMUL, COMPLEX_MUL_RZERO,
                    COMPLEX_ADD_RID],
        REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
        DISCH_THEN (CONJUNCTS_THEN
         (fun th => tactic_of do pure (SUBST1_TAC th THEN ASSUME_TAC (← SYM th))))] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_RINV, REAL_LT_IMP_NZ] THEN
      ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + &1 % (x - a):real^N = x")] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_SUB THEN
        REWRITE_TAC [HOLOMORPHIC_ON_CONST] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        ASM_REWRITE_TAC [] THEN
        SIMP_TAC [HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_CONST, COMPLEX_CMUL,
                 HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_ID],
        MATCH_MP_TAC CONTINUOUS_ON_SUB THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_REWRITE_TAC [] THEN
        SIMP_TAC [CONTINUOUS_ON_ADD, CONTINUOUS_ON_CMUL, CONTINUOUS_ON_ID,
                 CONTINUOUS_ON_CONST],
        SUBGOAL_THEN
         (← q r"sphere(Cx(&0),&1) =
          IMAGE (\x. inv r % x) (IMAGE (\x. --a + x) (sphere(a,r)))")
        SUBST1_TAC THENL
         [ASM_SIMP_TAC [← GSYM SPHERE_TRANSLATION, ← GSYM SPHERE_SCALING,
                       REAL_LT_INV_EQ, REAL_MUL_LINV, REAL_LT_IMP_NZ] THEN
          REWRITE_TAC [COMPLEX_CMUL, ← ExceptT.mk (COMPLEX_RING (← q r"a * (--x + x) = Cx(&0)"))],
          ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"(\x:complex. inv r % (x - a)) = (\x. inv r % x) o (\x. --a + x)")
        SUBST1_TAC THENL
         [REWRITE_TAC [o_DEF, FUN_EQ_THM] THEN CONV_TAC (fun t => VECTOR_ARITH t),
          REWRITE_TAC [IMAGE_o]] THEN
        W (MP_TAC o PART_MATCH (lhand o rand)
            OPEN_IN_INJECTIVE_LINEAR_IMAGE o snd) THEN
        ASM_REWRITE_TAC [LINEAR_SCALING, VECTOR_MUL_LCANCEL, REAL_INV_EQ_0] THEN
        DISCH_THEN SUBST1_TAC THEN ASM_REWRITE_TAC [OPEN_IN_TRANSLATION_EQ]]] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?a d. &0 < d /\ !x. abs(x - a) <= d ==> f(cexp(ii * Cx x)) = Cx(&0)")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"?a. cexp(ii * Cx a) IN t") MP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"w:complex")) THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_IMP_SUBSET) THEN
        REWRITE_TAC [SUBSET, COMPLEX_IN_SPHERE_0] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_TAC THEN MP_TAC (← ISPEC (← q r"w:complex") ARG) THEN
        ASM_REWRITE_TAC [COMPLEX_MUL_LID] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:real") THEN DISCH_TAC] THEN
      SUBGOAL_THEN (← q r"open_in (subtopology euclidean UNIV)
                            {x | x IN UNIV /\ cexp(ii * Cx(drop x)) IN t}")
      MP_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_OPEN_IN_PREIMAGE_GEN THEN
        EXISTS_TAC (← q r"sphere(Cx(&0),&1)") THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, COMPLEX_IN_SPHERE_0] THEN
        REWRITE_TAC [NORM_CEXP, RE_MUL_II, IM_CX, REAL_NEG_0, REAL_EXP_0] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_LMUL THEN
        MATCH_MP_TAC CONTINUOUS_ON_CX_DROP THEN
        REWRITE_TAC [CONTINUOUS_ON_ID],
        REWRITE_TAC [SUBTOPOLOGY_UNIV, ← GSYM OPEN_IN, IN_UNIV]] THEN
      REWRITE_TAC [OPEN_CONTAINS_CBALL, IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"lift a")) THEN ASM_REWRITE_TAC [LIFT_DROP] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      REWRITE_TAC [SUBSET, FORALL_LIFT, IN_CBALL, IN_ELIM_THM, LIFT_DROP] THEN
      REWRITE_TAC [DIST_LIFT] THEN ASM_MESON_TAC [REAL_ABS_SUB],
      ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"(&2 * pi) / d") REAL_ARCH_SIMPLE) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
    MP_TAC (← ISPECL
     [← q r"\z. cproduct (0..N) (\i. f(cexp(ii * Cx(&i * d)) * z))",
      ← q r"ball(Cx(&0),&1)", ← q r"Cx(&0)"]
     HOLOMORPHIC_CONSTANT_ON_FRONTIER) THEN
    SIMP_TAC [REAL_LT_01, FRONTIER_BALL, CLOSURE_BALL, BOUNDED_BALL] THEN
    SIMP_TAC [INTERIOR_OPEN, OPEN_BALL] THEN
    SUBGOAL_THEN
     (← q r"!i. (\z. f(cexp(ii * Cx(&i * d)) * z)) holomorphic_on ball(Cx(&0),&1)")
    ASSUME_TAC THENL
     [GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
      SIMP_TAC [HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_ID] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, COMPLEX_IN_BALL_0] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, NORM_CEXP, RE_MUL_II] THEN
      REWRITE_TAC [IM_CX, REAL_NEG_0, REAL_EXP_0, REAL_MUL_LID],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [HOLOMORPHIC_ON_CPRODUCT, FINITE_NUMSEG] THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_CPRODUCT THEN REWRITE_TAC [FINITE_NUMSEG] THEN
        X_GEN_TAC (← q r"i:num") THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_COMPLEX_LMUL, CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, COMPLEX_IN_CBALL_0] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL, NORM_CEXP, RE_MUL_II] THEN
        REWRITE_TAC [IM_CX, REAL_NEG_0, REAL_EXP_0, REAL_MUL_LID],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [COMPLEX_IN_SPHERE_0] THEN
      ASM_CASES_TAC (← q r"z = Cx(&0)") THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_0] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      DISCH_TAC THEN SIMP_TAC [CPRODUCT_EQ_0, FINITE_NUMSEG] THEN
      MP_TAC (← ISPEC (← q r"Arg(cexp(ii * Cx a) / z) / d") FLOOR_POS) THEN
      ASM_SIMP_TAC [ARG, REAL_LE_DIV, REAL_LT_IMP_LE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [IN_NUMSEG, ← GSYM REAL_OF_NUM_LE, REAL_POS] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN CONJ_TAC THENL
       [SIMP_TAC [REAL_FLOOR_LE, INTEGER_CLOSED] THEN FIRST_X_ASSUM
         (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"a <= n ==> b < a ==> b - &1 < n"))) THEN
        ASM_SIMP_TAC [REAL_LT_DIV2_EQ] THEN REWRITE_TAC [ARG],
        ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"Arg(cexp(ii * Cx a) / z) / d") FLOOR_FRAC) THEN
      STRIP_TAC THEN FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← REAL_ARITH
       (← q r"z:real = a + b ==> a = z - b"))) THEN
      ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < d ==> (x / d - y) * d = x - y * d")] THEN
      REWRITE_TAC [CX_SUB, CX_MUL, COMPLEX_SUB_LDISTRIB, CEXP_SUB] THEN
      MP_TAC (← lastc (← ISPEC (← q r"cexp(ii * Cx a) / z") (← GSYM ARG))) THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_DIV, REAL_DIV_1, NORM_CEXP] THEN
      REWRITE_TAC [RE_MUL_II, IM_CX, REAL_NEG_0, REAL_EXP_0, COMPLEX_MUL_LID] THEN
      DISCH_THEN SUBST1_TAC THEN ASM_SIMP_TAC [CEXP_NZ, ← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(w = Cx(&0)) /\ ~(z = Cx(&0)) ==> a / z / w * z = a / w"))] THEN
      REWRITE_TAC [← GSYM CEXP_SUB, ← GSYM COMPLEX_SUB_LDISTRIB] THEN
      REWRITE_TAC [← GSYM CX_MUL, ← GSYM CX_SUB] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [← REAL_ARITH (← q r"abs(a - x - a) <= d <=> abs(x) <= &1 * d")] THEN
      ASM_SIMP_TAC [REAL_ABS_MUL, ← REAL_ARITH (← q r"&0 < d ==> abs d = d")] THEN
      ASM_SIMP_TAC [REAL_LE_RMUL_EQ] THEN ASM_REAL_ARITH_TAC,
      DISCH_TAC THEN FIRST_ASSUM (fun th => tactic_of do pure (
        MP_TAC (← PART_MATCH (funpowM 5 rand o lhand)
          HOLOMORPHIC_FUNCTION_ENTIRE_PRODUCT (concl th)))) THEN
      ASM_REWRITE_TAC [FINITE_NUMSEG, OPEN_BALL, CONNECTED_BALL] THEN
      REWRITE_TAC [NUMSEG_EMPTY, ← CONJUNCT1 LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
      SIMP_TAC [← GSYM IN_SING, ← GSYM CLOSURE_BALL, REAL_LT_01] THEN
      MATCH_MP_TAC FORALL_IN_CLOSURE THEN
      ASM_SIMP_TAC [IN_SING, CLOSURE_BALL, CLOSED_SING, REAL_LT_01] THEN
      X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [COMPLEX_IN_BALL_0] THEN
      DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"cexp(--(ii * Cx(&k * d))) * z")) THEN
      ASM_SIMP_TAC [COMPLEX_IN_BALL_0, COMPLEX_NORM_MUL, NORM_CEXP, RE_NEG] THEN
      ASM_SIMP_TAC [RE_MUL_II, IM_CX, REAL_NEG_0, REAL_EXP_0, REAL_MUL_LID] THEN
      REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM CEXP_ADD, COMPLEX_ADD_RINV] THEN
      REWRITE_TAC [CEXP_0, COMPLEX_MUL_LID]])

  /- A proper holomorphic function maps frontier onto frontier. -/

  let FRONTIER_PROPER_HOLOMORPHIC_IMAGE ← prove
   r"!f s. open s /\ connected s /\ bounded s /\
         f holomorphic_on s /\ f continuous_on closure s /\
         (!k. compact k /\ k SUBSET IMAGE f s
              ==> compact {x | x IN s /\ f x IN k})
         ==> frontier(IMAGE f s) = IMAGE f (frontier s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:complex->bool = {}") THEN
    ASM_REWRITE_TAC [FRONTIER_EMPTY, IMAGE_CLAUSES] THEN
    ASM_CASES_TAC (← q r"?c. !z. z IN s ==> (f:complex->complex) z = c") THENL
     [FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"c:complex")) THEN
      SUBGOAL_THEN (← q r"!x. x IN closure s ==> (f:complex->complex) x IN {c}")
      ASSUME_TAC THENL
       [MATCH_MP_TAC FORALL_IN_CLOSURE THEN
        ASM_REWRITE_TAC [IN_SING, CLOSED_SING],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"IMAGE (f:complex->complex) s = {c}") SUBST1_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [FRONTIER_SING]] THEN
      SUBGOAL_THEN (← q r"~(frontier s:complex->bool = {})") MP_TAC THENL
       [ALL_TAC, REWRITE_TAC [frontier] THEN ASM SET_TAC []] THEN
      ASM_MESON_TAC [FRONTIER_EQ_EMPTY, NOT_BOUNDED_UNIV],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC FRONTIER_PROPER_OPEN_MAP_IMAGE THEN
      EXISTS_TAC (← q r"IMAGE (f:complex->complex) s") THEN
      ASM_SIMP_TAC [SUBSET_REFL] THEN
      MP_TAC (← ISPECL [← q r"s:complex->bool", ← q r"f:complex->complex"]
            OPEN_MAPPING_THM) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"s:complex->bool")) THEN
      ASM_REWRITE_TAC [SUBSET_REFL]])

  pure { MAXIMUM_MODULUS_BOUNDED_FUNCTION, HOLOMORPHIC_CONSTANT_ON_SPHERE_SEGMENT,
         FRONTIER_PROPER_HOLOMORPHIC_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Various forms of Hadamard's three-line theorem (explicit versions).      -/
/- (cauchy.ml 13713-13955)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBG where
  HADAMARD_THREE_LINE_EXPLICIT_RE : thm
  HADAMARD_THREE_LINE_EXPLICIT_IM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBG [HolBase] (D : CauchyDeps) (BKYBC : KYBC) (BKYBF : KYBF) : ExceptT String IO KYBG := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_FUNCTION_ENTIRE, .. } := BKYBC
  let { MAXIMUM_MODULUS_BOUNDED_FUNCTION, .. } := BKYBF
  let { CLOSURE_HALFSPACE_COMPONENT_GT, CLOSURE_HALFSPACE_COMPONENT_LT, .. } := D.qtopology
  let { CLOSURE_INTER_CONVEX_OPEN, .. } := D.qconvex
  let { CONTINUOUS_ON_CPOW_RIGHT, HOLOMORPHIC_ON_CPOW_RIGHT, .. } := D.mt.ra.tso
  let { NORM_CPOW, RPOW_ADD, RPOW_ADD_ALT, RPOW_DIV, RPOW_LE2, RPOW_MONO_INV, RPOW_MONO_LE,
        RPOW_POS_LE, RPOW_POS_LT, RPOW_POW, .. } := D.mt.ra.tsab
  let { CONTINUOUS_ON_COMPLEX_LMUL, CONTINUOUS_ON_COMPLEX_MUL, CONTINUOUS_ON_COMPLEX_RMUL,
        .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID,
        HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_RMUL, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { CONVEX_HALFSPACE_COMPONENT_GT, CONVEX_HALFSPACE_COMPONENT_LT,
        .. } := D.mt.ra.ts.qconvex
  let { complex_div, RE_DEF, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_SUB_SUB2, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_NORM_CX, COMPLEX_VEC_0, CX_SUB, IM_MUL_II, RE_CX,
        RE_DIV_CX, RE_MUL_II, RE_SUB, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_0, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { REAL_CX, .. } := D.mt.ra.ts.cn.cxi
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH_EQ, CONJ_ASSOC, DE_MORGAN_THM, DISJ_SYM, EXTENSION, FORALL_IN_GSPEC,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT,
        IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_FORALL,
        MONO_IMP, REAL_ADD_LID, REAL_ADD_RDISTRIB, REAL_ADD_RID, REAL_DIV_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_MIN,
        REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_LMUL, REAL_LT_MUL,
        REAL_LT_REFL, REAL_MIN_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_OF_NUM_EQ,
        REAL_SUB_0, REAL_SUB_LT, REAL_SUB_REFL, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, real_div, real_ge, real_gt, real_pow,
        .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
