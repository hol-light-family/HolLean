set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBR [HolBase] (D : CauchyDeps) (BKYAI : KYAI) (BKYBC : KYBC) (BKYBD : KYBD) (BKYBQ : KYBQ) : ExceptT String IO KYBR := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { ANALYTIC_CONTINUATION, CAUCHY_INEQUALITY, .. } := BKYBC
  let { OPEN_MAPPING_THM, .. } := BKYBD
  let { SCHOTTKY, .. } := BKYBQ
  let { LIMPT_OF_OPEN, .. } := D.qtopology
  let { REAL_EXP_POS_LT, .. } := D.mt.ra.tsb
  let { COMPLEX_IN_CBALL_0, .. } := D.mt.ra.ts.kna
  let { COMPLEX_DERIVATIVE_UNIQUE_AT, COMPLEX_DIFF_CHAIN_AT, complex_differentiable,
        HAS_COMPLEX_DERIVATIVE_ZERO_CONNECTED_CONSTANT, HIGHER_COMPLEX_DERIVATIVE_1,
        HOLOMORPHIC_ON_DIFFERENTIABLE, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_ID, HAS_COMPLEX_DERIVATIVE_LMUL_AT,
        HAS_COMPLEX_DERIVATIVE_RMUL_AT, HAS_COMPLEX_DERIVATIVE_SUB, .. } := D.mt.ra.ts.knf
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
        HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST,
        HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFF_TAC, COMPLEX_DIFFERENTIABLE_TAC, .. } := D.mt.ra.ts.knk
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RID, COMPLEX_ADD_SYM, COMPLEX_MUL_LID,
        COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO, COMPLEX_MUL_SYM, COMPLEX_SUB_0,
        COMPLEX_SUB_LZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_MUL_RINV, COMPLEX_NORM_CX, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { ASM_MESON_TAC, MESON, MESON_TAC, NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH_EQ, CONTRAPOS_THM, DE_MORGAN_THM, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, IN_UNIV, MONO_FORALL, NOT_EXISTS_THM, NOT_IMP, NOT_IN_EMPTY,
        REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LT_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, RIGHT_IMP_FORALL_THM, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_NEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { SUBSET_BALLS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let LANDAU_PICARD ← prove
   r"?R. (!z. &0 < R z) /\
       !f. f holomorphic_on cball(Cx(&0),R(f(Cx(&0)))) /\
           (!z. z IN cball(Cx(&0),R(f(Cx(&0))))
                ==> ~(f(z) = Cx(&0)) /\ ~(f(z) = Cx(&1)))
           ==> norm(complex_derivative f (Cx(&0))) < &1"
   (ABBREV_TAC
     (← q r"R = \z:complex. &3 * exp(pi * exp(pi * (&2 + &2 * norm(z) + &12)))") THEN
    EXISTS_TAC (← q r"R:complex->real") THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [EXPAND_TAC "R" THEN
      REWRITE_TAC [REAL_EXP_POS_LT, ← REAL_ARITH (← q r"&0 < &3 * x <=> &0 < x")],
      DISCH_TAC] THEN
    REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"r = (R:complex->real)(f(Cx(&0)))") THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    ABBREV_TAC (← q r"g = \z. (f:complex->complex)(Cx r * z)") THEN
    SUBGOAL_THEN
     (← q r"!z. z IN cball(Cx(&0),&1) ==> (Cx r * z) IN cball(Cx(&0),r)")
    ASSUME_TAC THENL
     [REWRITE_TAC [COMPLEX_IN_CBALL_0, COMPLEX_NORM_MUL, COMPLEX_NORM_CX] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← REAL_ARITH
       (← q r"&0 < r ==> (abs r * z <= r <=> r * z <= r * &1)")],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"g holomorphic_on cball(Cx(&0),&1)") ASSUME_TAC THENL
     [EXPAND_TAC "g" THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
      SIMP_TAC [HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HOLOMORPHIC_ON_SUBSET)) THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:complex->complex", ← q r"norm(f(Cx(&0)):complex)"]
      SCHOTTKY) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [EXPAND_TAC "g" THEN REWRITE_TAC [COMPLEX_MUL_RZERO, REAL_LE_REFL] THEN
      GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [DE_MORGAN_THM] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&1 / &2")) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    MP_TAC (← ASSUME (← q r"(R:complex->real)(f(Cx(&0))) = r")) THEN
    EXPAND_TAC "R" THEN
    SIMP_TAC [← REAL_ARITH (← q r"&3 * x = r <=> x = r / &3")] THEN
    DISCH_THEN SUBST1_TAC THEN DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPECL
     [← q r"g:complex->complex", ← q r"Cx(&0)", ← q r"&1 / &2", ← q r"r / &3", ← q r"1"]
          CAUCHY_INEQUALITY) THEN
    CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [HIGHER_COMPLEX_DERIVATIVE_1] THEN
    ASM_SIMP_TAC [COMPLEX_SUB_LZERO, NORM_NEG, REAL_EQ_IMP_LE] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        HOLOMORPHIC_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"complex_derivative g (Cx(&0)) = Cx r * complex_derivative f (Cx(&0))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN EXPAND_TAC "g" THEN
      REWRITE_TAC [] THEN ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
      ONCE_REWRITE_TAC [← GSYM o_DEF] THEN MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT THEN
      CONJ_TAC THENL
       [COMPLEX_DIFF_TAC THEN REWRITE_TAC [COMPLEX_MUL_LID], ALL_TAC] THEN
      REWRITE_TAC [COMPLEX_MUL_LZERO, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT THEN
      EXISTS_TAC (← q r"ball(Cx(&0),r)") THEN
      ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
      ASM_MESON_TAC [BALL_SUBSET_CBALL, HOLOMORPHIC_ON_SUBSET],
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX] THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← REAL_ARITH
       (← q r"&0 < r ==> (abs r * z <= &1 * r / &3 / (&1 / &2) <=>
                    r * z <= r * &2 / &3)")] THEN
      REAL_ARITH_TAC])

  let LITTLE_PICARD ← (do
    let lemma ← prove
     r"!f. f holomorphic_on (:complex) /\
           (!z. ~(f z = Cx(&0)) /\ ~(f z = Cx(&1)))
           ==> ?c. f = \x. c"
     (X_CHOOSE_THEN (← q r"R:complex->real") MP_TAC LANDAU_PICARD THEN
      REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"(:complex)"]
        HAS_COMPLEX_DERIVATIVE_ZERO_CONNECTED_CONSTANT) THEN
      REWRITE_TAC [IN_UNIV, FUN_EQ_THM, CONNECTED_UNIV, OPEN_UNIV] THEN
      DISCH_THEN MATCH_MP_TAC THEN X_GEN_TAC (← q r"w:complex") THEN
      ASM_CASES_TAC (← q r"complex_derivative f w = Cx(&0)") THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, OPEN_UNIV, IN_UNIV],
        MATCH_MP_TAC (← TAUT (← q r"F ==> p"))] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"\z. (f:complex->complex)(w + z / complex_derivative f w)")) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN CONJ_TAC THENL
         [ALL_TAC, ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV]] THEN
        REWRITE_TAC [HOLOMORPHIC_ON_DIFFERENTIABLE] THEN
        REPEAT STRIP_TAC THEN COMPLEX_DIFFERENTIABLE_TAC,
        SUBGOAL_THEN
         (← q r"complex_derivative (\z. f (w + z / complex_derivative f w)) (Cx(&0)) =
          complex_derivative f w * inv(complex_derivative f w)")
        SUBST1_TAC THENL
         [ALL_TAC,
          ASM_SIMP_TAC [COMPLEX_MUL_RINV, COMPLEX_NORM_CX, REAL_ABS_NUM,
                       REAL_LT_REFL]] THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
        MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT THEN CONJ_TAC THENL
         [COMPLEX_DIFF_TAC THEN
          REWRITE_TAC [COMPLEX_ADD_LID, COMPLEX_MUL_LID, complex_div],
          REWRITE_TAC [complex_div, COMPLEX_MUL_LZERO, COMPLEX_ADD_RID] THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
          ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, OPEN_UNIV,
                        IN_UNIV]]])
    prove
     r"!f a b.
        f holomorphic_on (:complex) /\
        ~(a = b) /\ IMAGE f (:complex) INTER {a,b} = {}
        ==> ?c. f = \x. c"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"\x:complex. Cx(&1) / (b - a) * (f x - b) + Cx(&1)") lemma) THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_SUB,
                   HOLOMORPHIC_ON_CONST] THEN
      ASM_SIMP_TAC [FUN_EQ_THM, ← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(a = b)
        ==> (Cx(&1) / (b - a) * (f - b) + Cx(&1) = c <=>
             f = b + (b - a) / Cx(&1) * (c - Cx(&1)))"))] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [← SET_RULE (← q r"IMAGE f UNIV INTER t = {} <=> !x. ~(f x IN t)")]) THEN
      MATCH_MP_TAC MONO_FORALL THEN
      REWRITE_TAC [CONTRAPOS_THM, IN_INSERT, NOT_IN_EMPTY] THEN
      CONV_TAC COMPLEX_RING))

  /- A couple of little applications of Little Picard. -/

  let HOLOMORPHIC_PERIODIC_FIXPOINT ← prove
   r"!f p. f holomorphic_on (:complex) /\ ~(p = Cx(&0)) /\ (!z. f(z + p) = f(z))
         ==> ?x. f(x) = x"
   (REWRITE_TAC [← MESON [] (← q r"(?x. P x) <=> ~(!x. ~P x)")] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\z:complex. f(z) - z", ← q r"Cx(&0)", ← q r"p:complex"] LITTLE_PICARD) THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_ID, NOT_IMP] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f UNIV INTER {a,b} = {} <=>
                            !x. ~(f x = a) /\ ~(f x = b)")] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a - b:complex = c <=> a = b + c")),
                  COMPLEX_ADD_RID] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [NOT_EXISTS_THM, FUN_EQ_THM] THEN GEN_TAC THEN
      DISCH_THEN (fun th => tactic_of do pure (
       MP_TAC (← SPEC (← q r"p + p:complex") th) THEN
       MP_TAC (← SPEC (← q r"p:complex") th))) THEN
      ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"~(p = Cx(&0))") THEN CONV_TAC COMPLEX_RING])

  let HOLOMORPHIC_INVOLUTION_POINT ← prove
   r"!f. f holomorphic_on (:complex) /\ ~(?a. f = \x. a + x) ==> ?x. f(f x) = x"
   (REWRITE_TAC [← MESON [] (← q r"(?x. P x) <=> ~(!x. ~P x)")] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!z:complex. ~(f z = z)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\x. (f(f x) - x) / (f x - x)", ← q r"Cx(&0)", ← q r"Cx(&1)"]
          LITTLE_PICARD) THEN
    REWRITE_TAC [NOT_IMP, CX_INJ, REAL_OF_NUM_EQ, ARITH_EQ] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f UNIV INTER {a,b} = {} <=>
                            !x. ~(f x = a) /\ ~(f x = b)")] THEN
    ASM_SIMP_TAC [FUN_EQ_THM, ← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(a:complex = b) ==> (x / (a - b) = c <=> x = c * (a - b))"))] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
      ASM_SIMP_TAC [COMPLEX_SUB_0] THEN CONJ_TAC THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_SUB THEN
      ASM_REWRITE_TAC [HOLOMORPHIC_ON_ID] THEN
      GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV],
      ASM_REWRITE_TAC [COMPLEX_MUL_LZERO, COMPLEX_MUL_LID, COMPLEX_SUB_0] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"x - a:complex = y - a <=> x = y"))] THEN
      ASM_MESON_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:complex") MP_TAC)] THEN
    ASM_CASES_TAC (← q r"c = Cx(&0)") THEN
    ASM_REWRITE_TAC [COMPLEX_MUL_LZERO, COMPLEX_SUB_0] THEN
    ASM_CASES_TAC (← q r"c = Cx(&1)") THEN
    ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"ffx - x = Cx(&1) * (fx - x) <=> ffx = fx"))] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"ffx - x = c * (fx - x) <=> (ffx - c * fx) = x * (Cx(&1) - c)"))] THEN
    DISCH_TAC THEN
    MP_TAC (← SPECL
     [← q r"complex_derivative f o f", ← q r"Cx(&0)", ← q r"c:complex"] LITTLE_PICARD) THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f UNIV INTER {a,b} = {} <=>
                            !x. ~(f x = a) /\ ~(f x = b)")] THEN
    ASM_REWRITE_TAC [o_THM, NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
      ASM_MESON_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, OPEN_UNIV, SUBSET_UNIV,
                    HOLOMORPHIC_ON_SUBSET],
      MP_TAC (← MATCH_MP MONO_FORALL (← GEN (← q r"z:complex") (← SPECL
       [← q r"\x:complex. f(f x) - c * f x", ← q r"z:complex",
        ← q r"complex_derivative f z * (complex_derivative f (f z) - c)",
        ← q r"Cx(&1) * (Cx(&1) - c)"] COMPLEX_DERIVATIVE_UNIQUE_AT))) THEN
      ANTS_TAC THENL
       [REPEAT STRIP_TAC THENL
         [REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a * (b - c):complex = b * a - c * a"))] THEN
          MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_SUB THEN CONJ_TAC THENL
           [ONCE_REWRITE_TAC [← GSYM o_DEF] THEN MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT,
            MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_LMUL_AT] THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
          ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, IN_UNIV, OPEN_UNIV],
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_RMUL_AT THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_ID]],
        DISCH_THEN (fun th => tactic_of do pure (X_GEN_TAC (← q r"z:complex") THEN REPEAT STRIP_TAC THEN
                          MP_TAC th))
        THENL [DISCH_THEN (MP_TAC o SPEC (← q r"(f:complex->complex) z")),
               DISCH_THEN (MP_TAC o SPEC (← q r"z:complex"))] THEN
        ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"~(c = Cx(&1))") THEN CONV_TAC COMPLEX_RING],
        REWRITE_TAC [FUN_EQ_THM, o_THM] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"k:complex")) THEN
        SUBGOAL_THEN (← q r"open(IMAGE (f:complex->complex) (:complex))")
        ASSUME_TAC THENL
         [MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
           OPEN_MAPPING_THM) THEN
          EXISTS_TAC (← q r"(:complex)") THEN
          ASM_REWRITE_TAC [OPEN_UNIV, CONNECTED_UNIV, SUBSET_UNIV, IN_UNIV] THEN
          ASM_MESON_TAC [],
          ALL_TAC] THEN
        MP_TAC (← ISPECL
          [← q r"\z. complex_derivative f z - k", ← q r"(:complex)",
           ← q r"IMAGE (f:complex->complex) (:complex)", ← q r"(f:complex->complex) z"]
          ANALYTIC_CONTINUATION) THEN
        REWRITE_TAC [OPEN_UNIV, CONNECTED_UNIV, SUBSET_UNIV, IN_UNIV] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE, COMPLEX_SUB_0, NOT_IMP] THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC HOLOMORPHIC_ON_SUB THEN REWRITE_TAC [ETA_AX] THEN
          ASM_MESON_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, OPEN_UNIV, SUBSET_UNIV,
                        HOLOMORPHIC_ON_SUBSET, HOLOMORPHIC_ON_CONST],
          MATCH_MP_TAC LIMPT_OF_OPEN THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
          DISCH_TAC] THEN
        MP_TAC (← ISPECL
         [← q r"\x:complex. f x - k * x", ← q r"(:complex)"]
          HAS_COMPLEX_DERIVATIVE_ZERO_CONNECTED_CONSTANT) THEN
        REWRITE_TAC [OPEN_UNIV, CONNECTED_UNIV, IN_UNIV, NOT_IMP] THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"z:complex") THEN
          SUBST1_TAC (← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) = k - k * Cx(&1)"))) THEN
          MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_SUB THEN CONJ_TAC THENL
           [ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
                          HOLOMORPHIC_ON_OPEN, OPEN_UNIV, IN_UNIV,
                          complex_differentiable],
            COMPLEX_DIFF_TAC THEN CONV_TAC COMPLEX_RING],
          DISCH_THEN (X_CHOOSE_THEN (← q r"l:complex") MP_TAC) THEN
          REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a - b:complex = c <=> a = b + c"))] THEN
          DISCH_THEN (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th, FUN_EQ_THM])) THEN
          ASM_CASES_TAC (← q r"k = Cx(&1)") THENL
           [UNDISCH_TAC (← q r"!a:complex. ~(!x. k * x + l = a + x)") THEN
            ASM_REWRITE_TAC [COMPLEX_MUL_LID] THEN MESON_TAC [COMPLEX_ADD_SYM],
            UNDISCH_TAC (← q r"!z:complex. ~(k * z + l = z)") THEN
            ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
             (← q r"~(k = Cx(&1)) ==> (k * z + l = z <=> z = l / (Cx(&1) - k))"))] THEN
            MESON_TAC []]]])

  pure { LANDAU_PICARD, LITTLE_PICARD, HOLOMORPHIC_PERIODIC_FIXPOINT,
         HOLOMORPHIC_INVOLUTION_POINT }
/- ------------------------------------------------------------------------- -/
/- Montel's theorem: a sequence of holomorphic functions uniformly bounded   -/
/- on compact subsets of an open set S has a subsequence that converges to a -/
/- holomorphic function, and converges *uniformly* on compact subsets of S.  -/
/- (cauchy.ml 16838-17046)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBS where
  MONTEL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBS [HolBase] (D : CauchyDeps) (BKYG : KYG) (BKYV : KYV) (BKYAE : KYAE) (BKYAP : KYAP) : ExceptT String IO KYBS := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_SUB, .. } := BKYG
  let { CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE, .. } := BKYV
  let { HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH, PATH_IMAGE_CIRCLEPATH, PATHFINISH_CIRCLEPATH,
        PATHSTART_CIRCLEPATH, VALID_PATH_CIRCLEPATH, WINDING_NUMBER_CIRCLEPATH,
        .. } := BKYAE
  let { HOLOMORPHIC_UNIFORM_SEQUENCE, .. } := BKYAP
  let { OPEN_UNION_COMPACT_SUBSETS, .. } := D.qtopology
  let { GE_REFL, SUBSEQUENCE_DIAGONALIZATION_LEMMA, .. } := D.qmisc
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { COMPLEX_MUL_LID, COMPLEX_SUB_LDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_FIELD, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARZELA_ASCOLI, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { ARITH, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_UNWIND_THM2, GE, IMP_CONJ, IMP_IMP, IN_DELETE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_REFL, LE_TRANS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        MONO_IMP, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_MIN, REAL_LT_MUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_OF_NUM_LT, RIGHT_AND_EXISTS_THM,
        RIGHT_EXISTS_AND_THM, RIGHT_FORALL_IMP_THM, RIGHT_IMP_EXISTS_THM,
        RIGHT_IMP_FORALL_THM, SING_SUBSET, SKOLEM_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_THM, SWAP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, NORM_POS_LT, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_SUB_EQ, VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { COMPACT_CBALL, COMPACT_SING, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { IN_BALL, IN_CBALL, INTERIOR_CBALL, LIM_SEQUENTIALLY, LIM_UNIQUE,
        OPEN_CONTAINS_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { I_O_ID, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { CONVEX_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let MONTEL ← prove
   r"!(f:num->complex->complex) p s.
    open s /\ (!h. h IN p ==> h holomorphic_on s) /\
    (!k. compact k /\ k SUBSET s
         ==> ?b. !h z. h IN p /\ z IN k ==> norm(h z) <= b) /\
    (!n. (f n) IN p)
    ==> ?g r. g holomorphic_on s /\
              (!m n:num. m < n ==> r m < r n) /\
              (!x. x IN s ==> ((\n. f (r n) x) --> g(x)) sequentially) /\
              (!k e. compact k /\ k SUBSET s /\ &0 < e
                     ==> ?N. !n x. n >= N /\ x IN k
                                   ==> norm(f (r n) x - g x) < e)"
   (REPEAT GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SPEC_TAC (← q r"f:num->complex->complex", ← q r"f:num->complex->complex") THEN
    REWRITE_TAC [LIM_SEQUENTIALLY] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM GE, dist] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_UNION_COMPACT_SUBSETS) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:num->complex->bool")
     (fun th => tactic_of do pure (FIRST_X_ASSUM (MP_TAC o GEN (← q r"i:num ") o
                  SPEC (← q r"(k:num->complex->bool) i")) THEN
                STRIP_ASSUME_TAC th))) THEN
    ASM_REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:num->real") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!(f:num->complex->complex) (i:num).
          (!n. f n IN p)
          ==>  ?r g. (!m n:num. m < n ==> r m < r n) /\
                     (!e. &0 < e ==> ?N. !n x. n >= N /\ x IN k i
                                               ==> norm((f o r) n x - g x) < e)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [o_THM] THEN
      MP_TAC (← ISPECL [← q r"f:num->complex->complex", ← q r"(k:num->complex->bool) i",
                     ← q r"(B:num->real) i"] ARZELA_ASCOLI) THEN
      ANTS_TAC THENL [ASM_SIMP_TAC [], MESON_TAC []] THEN
      MAP_EVERY X_GEN_TAC [← q r"z:complex", ← q r"e:real"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SUBSET, IN_CBALL]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"?M. &0 < M /\
            !n w. dist(z,w) <= &2 / &3 * r
                  ==> norm((f:num->complex->complex) n w) <= M")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"cball(z:complex,&2 / &3 * r)")) THEN
        ASM_SIMP_TAC [SUBSET, IN_CBALL, COMPACT_CBALL,
                ← NORM_ARITH (← q r"dist(a,b) <= &2 / &3 * r ==> dist(a,b) <= r")] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N:num"))) THEN
        REWRITE_TAC [GE, LE_REFL] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"abs(B(N:num)) + &1") THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&0 < abs x + &1")] THEN
        ASM_MESON_TAC [SUBSET, ← REAL_ARITH (← q r"x <= b ==> x <= abs b + &1")],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"min (r / &3) ((e * r) / (&6 * M))") THEN
      ASM_SIMP_TAC [REAL_LT_MIN, REAL_LT_DIV,
                   REAL_LT_MUL, REAL_OF_NUM_LT, ARITH] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"y:complex"] THEN STRIP_TAC THEN
      MP_TAC
       (← ISPECL [← q r"(f:num->complex->complex) n", ← q r"cball(z:complex,&2 / &3 * r)",
                ← q r"circlepath(z:complex,&2 / &3 * r)"]
          CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE) THEN
      REWRITE_TAC [CONVEX_CBALL, VALID_PATH_CIRCLEPATH] THEN
      REWRITE_TAC [PATHSTART_CIRCLEPATH, PATHFINISH_CIRCLEPATH] THEN
      SIMP_TAC [INTERIOR_CBALL, IN_BALL, WINDING_NUMBER_CIRCLEPATH,
               ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH,
                   ← REAL_ARITH (← q r"&0 < r ==> &0 <= &2 / &3 * r")] THEN
      REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
      SIMP_TAC [SUBSET, IN_CBALL, IN_DELETE, IN_ELIM_THM, REAL_LE_REFL,
               ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> q ==> ~p")] THEN
      SIMP_TAC [FORALL_UNWIND_THM2, IMP_CONJ, REAL_LT_IMP_NE] THEN
      REWRITE_TAC [RIGHT_FORALL_IMP_THM, COMPLEX_MUL_LID] THEN ANTS_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
        EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [SUBSET, IN_CBALL] THEN
        ASM_SIMP_TAC [← NORM_ARITH (← q r"dist(a,b) <= &2 / &3 * r ==> dist(a,b) <= r")],
        ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do pure (
        MP_TAC (← SPEC (← q r"y:complex") th) THEN MP_TAC (← SPEC (← q r"z:complex") th))) THEN
      ASM_SIMP_TAC [VECTOR_SUB_REFL, NORM_0, REAL_LT_MUL, REAL_LT_DIV,
        REAL_OF_NUM_LT, ARITH, ← NORM_ARITH
         (← q r"norm(z - y) < r / &3 ==> norm(y - z) < &2 / &3 * r")] THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_SUB) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH)) THEN
      REWRITE_TAC [← GSYM COMPLEX_SUB_LDISTRIB, COMPLEX_NORM_MUL] THEN
      REWRITE_TAC [COMPLEX_NORM_II, COMPLEX_NORM_CX, REAL_ABS_PI,
                  REAL_ABS_NUM, REAL_MUL_LID] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / r:real")) THEN
      ASM_SIMP_TAC [← REAL_FIELD
       (← q r"&0 < r ==> e / r * &2 * pi * c * r = &2 * pi * e * c")] THEN
      SIMP_TAC [REAL_LE_LMUL_EQ, REAL_OF_NUM_LT, ARITH, PI_POS] THEN
      ANTS_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LT_DIV, REAL_OF_NUM_LT, ARITH,
                   REAL_LT_MUL] THEN
      X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~(w:complex = z) /\ ~(w = y)") STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
        RULE_ASSUM_TAC (REWRITE_RULE [NORM_0, VECTOR_SUB_REFL]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [NORM_SUB]) THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(w:complex = z) /\ ~(w = y)
        ==> (a / (w - z) - a / (w - y) =
             (a * (z - y)) / ((w - z) * (w - y)))"))] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_DIV] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_MUL, NORM_POS_LT, VECTOR_SUB_EQ,
       ← REAL_FIELD (← q r"&0 < r ==> e / r * (&2 / &3 * r) * x = &2 / &3 * e * x")] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"M * (e * r) / (&6 * M)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, NORM_POS_LE] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [← NORM_ARITH (← q r"dist(x,y) = norm(y - x)"), REAL_LE_REFL],
        ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < M ==> M * e / (&6 * M) = e / &6")] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 < x /\ x <= y * &3 ==> x / &6 <= &2 / &3 * y")) THEN
        ASM_SIMP_TAC [REAL_LT_MUL, ← GSYM REAL_MUL_ASSOC, REAL_LE_LMUL_EQ] THEN
        MAP_EVERY UNDISCH_TAC
         [← q r"norm(w - z:complex) = &2 / &3 * r",
          ← q r"norm(z - y:complex) < r / &3"] THEN
        CONV_TAC (fun t => NORM_ARITH t)],
      ALL_TAC] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    DISCH_THEN (fun th => tactic_of do pure (X_GEN_TAC (← q r"f:num->complex->complex") THEN
                         DISCH_TAC THEN MP_TAC th)) THEN
    DISCH_THEN (MP_TAC o GENL [← q r"i:num", ← q r"r:num->num"] o
      SPECL [← q r"(f:num->complex->complex) o (r:num->num)", ← q r"i:num"]) THEN
    GEN_REWRITE_TAC
     (LAND_CONV o funpow 2 BINDER_CONV o LAND_CONV o ONCE_DEPTH_CONV)
     [o_THM] THEN ASM_REWRITE_TAC [← GSYM o_ASSOC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
      SUBSEQUENCE_DIAGONALIZATION_LEMMA)) THEN
    ANTS_TAC THENL
     [SIMP_TAC [o_THM, GE] THEN REPEAT GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"M:num")) THEN
      EXISTS_TAC (← q r"MAX M N") THEN
      REWRITE_TAC [← ARITH_RULE (← q r"MAX m n <= x <=> m <= x /\ n <= x")] THEN
      ASM_MESON_TAC [LE_TRANS],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"I:num->num")) THEN
    REWRITE_TAC [I_O_ID, RIGHT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    REWRITE_TAC [o_THM] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN s
          ==> ?l. !e. &0 < e
                      ==> ?N:num. !n. n >= N
                                  ==> norm((f:num->complex->complex) (r n) x - l)
                                      < e")
    MP_TAC THENL
     [X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{z:complex}")) THEN
      ASM_REWRITE_TAC [COMPACT_SING, SING_SUBSET] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SKOLEM_THM]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"G:num->complex->complex") MP_TAC) THEN
      DISCH_THEN (LABEL_TAC "*" o SPEC (← q r"N:num")) THEN
      EXISTS_TAC (← q r"(G:num->complex->complex) N z") THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"e:real")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"M:num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"MAX M N") THEN
      REWRITE_TAC [← ARITH_RULE (← q r"a >= MAX m n <=> a >= m /\ a >= n")] THEN
      ASM_MESON_TAC [GE_REFL],
      ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"b /\ (b ==> a) ==> a /\ b")) THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"t:complex->bool", ← q r"e:real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:complex->bool")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"h:complex->complex") (LABEL_TAC "*") o
        SPEC (← q r"N:num")) THEN
      SUBGOAL_THEN
       (← q r"!w. w IN t ==> g w = (h:complex->complex) w")
       (fun th => ASM_MESON_TAC [GE_REFL, SUBSET, th]) THEN
      X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIM_UNIQUE) THEN
      EXISTS_TAC (← q r"\n:num. (f:num->complex->complex)(r n) w") THEN
      ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, LIM_SEQUENTIALLY] THEN
      REWRITE_TAC [← GSYM GE, dist, o_THM] THEN
      ASM_MESON_TAC [SUBSET, GE_REFL],
      DISCH_THEN (LABEL_TAC "*")] THEN
    MATCH_MP_TAC HOLOMORPHIC_UNIFORM_SEQUENCE THEN
    EXISTS_TAC (← q r"(f:num->complex->complex) o (r:num->num)") THEN
    ASM_SIMP_TAC [o_THM] THEN X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN ASM_MESON_TAC [COMPACT_CBALL, GE])

  pure { MONTEL }
/- ------------------------------------------------------------------------- -/
/- Moebius functions are biholomorphisms of the unit disc.                   -/
/- (cauchy.ml 17047-17312)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBT where
  moebius_function : thm
  MOEBIUS_FUNCTION_SIMPLE : thm
  MOEBIUS_FUNCTION_EQ_ZERO : thm
  MOEBIUS_FUNCTION_OF_ZERO : thm
  MOEBIUS_FUNCTION_NORM_LT_1 : thm
  MOEBIUS_FUNCTION_HOLOMORPHIC : thm
  MOEBIUS_FUNCTION_COMPOSE : thm
  BALL_BIHOLOMORPHISM_EXISTS : thm
  BALL_BIHOLOMORPHISM_MOEBIUS_FUNCTION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBT [HolBase] (D : CauchyDeps) (BKYBB : KYBB) : ExceptT String IO KYBT := do
  -- @@SCOPE BEGIN
  let { SECOND_CARTAN_THM_DIM_1, .. } := BKYBB
  let { CEXP_0, CEXP_ADD, CEXP_NEG, CEXP_NEG_LMUL, CEXP_NZ, HOLOMORPHIC_ON_CEXP,
        .. } := D.mt.ra.tsa
  let { CNJ_CEXP, .. } := D.mt.ra.tsb
  let { NORM_CEXP_II, .. } := D.mt.ra.tsf
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { HOLOMORPHIC_ON_COMPOSE_GEN, HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV,
        HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { REAL_LT_SQUARE, .. } := D.mt.ra.ts.qsession
  let { complex_sub, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LDISTRIB, COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID, COMPLEX_MUL_LNEG,
        COMPLEX_MUL_RID, COMPLEX_MUL_RNEG, COMPLEX_MUL_RZERO, COMPLEX_NEG_LMUL,
        COMPLEX_NEG_NEG, COMPLEX_NEG_RMUL, COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_MUL_LINV, CX_ADD, CX_DIV, CX_INJ, CX_MUL, CX_NEG, CX_POW, CX_SUB,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_EQ_MUL_LCANCEL, COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_MUL, COMPLEX_NORM_NUM, COMPLEX_NORM_NZ,
        COMPLEX_NORM_ZERO, .. } := D.mt.ra.ts.cn.cxf
  let { CNJ_CNJ, CNJ_CX, CNJ_DIV, CNJ_EQ_0, CNJ_II, CNJ_MUL, CNJ_NEG, CNJ_SUB,
        COMPLEX_NORM_CNJ, COMPLEX_NORM_POW_2, .. } := D.mt.ra.ts.cn.cxg
  let { ASM_MESON_TAC, MESON_TAC, new_definition, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, REAL_RING, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_MUL_POS_LT, .. } := D.mt.ra.ts.cn.ms.ig.qsession
  let { EQ_TRANS, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IN_UNIV, REAL_ADD_LID, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_DIV, REAL_LT_MUL, REAL_LTE_ADD,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RZERO, REAL_SUB_LT, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_NEG, NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { REAL_LT_TRANS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { REAL_LT_RMUL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  -- EQ_TRANS_TAC (misc.ml 19), local: CauchyDeps carries no MiscDeps.
  let EQ_TRANS_TAC : term → tactic := fun tm =>
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC tm THEN CONJ_TAC

  let moebius_function ← new_definition
   r"!t w z. moebius_function t w z =
           cexp(ii * Cx t) * (z - w) / (Cx(&1) - cnj w * z)"

  let MOEBIUS_FUNCTION_SIMPLE ← prove
   r"!w z. moebius_function (&0) w z = (z - w) / (Cx(&1) - cnj w * z)"
   (REWRITE_TAC [moebius_function, COMPLEX_MUL_RZERO, CEXP_0, COMPLEX_MUL_LID])

  let MOEBIUS_FUNCTION_EQ_ZERO ← prove
    r"!t w. moebius_function t w w = Cx(&0)"
    (REWRITE_TAC [moebius_function] THEN CONV_TAC COMPLEX_FIELD)

  let MOEBIUS_FUNCTION_OF_ZERO ← prove
    r"!t w. moebius_function t w (Cx(&0)) = -- cexp(ii * Cx t) * w"
    (REWRITE_TAC [moebius_function] THEN CONV_TAC COMPLEX_FIELD)

  let MOEBIUS_FUNCTION_NORM_LT_1 ← prove
    r"!t w z. norm w < &1 /\ norm z < &1
            ==> norm (moebius_function t w z) < &1"
    (REPEAT STRIP_TAC THEN SUBGOAL_THEN
      (← q r"!a. &0 <= a /\ &0 < &1 - a pow 2 ==> a < &1") MATCH_MP_TAC THENL
    [GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= a") THEN
     ASM_REWRITE_TAC [← REAL_FIELD (← q r"&1 - a pow 2 = (&1 - a) * (&1 + a)"),
                      REAL_MUL_POS_LT] THEN
     REAL_ARITH_TAC,
     ALL_TAC] THEN
    REWRITE_TAC [NORM_POS_LE] THEN
    SUBGOAL_THEN (← q r"~(Cx(&1) - cnj w * z = Cx(&0))") ASSUME_TAC THENL
    [REWRITE_TAC [COMPLEX_SUB_0] THEN
     SUBGOAL_THEN (← q r"~(norm (Cx(&1)) = norm (cnj w * z))")
      (fun th => MESON_TAC [th]) THEN
     REWRITE_TAC [COMPLEX_NORM_NUM, COMPLEX_NORM_MUL, COMPLEX_NORM_CNJ] THEN
     MATCH_MP_TAC (← REAL_ARITH (← q r"a * b < &1  ==> ~(&1 = a * b)")) THEN
     STRIP_ASSUME_TAC (← NORM_ARITH (← q r"norm (z:complex) = &0 \/ &0 < norm z")) THENL
     [ASM_REWRITE_TAC [REAL_MUL_RZERO, REAL_LT_01],
      MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"&1 * norm (z:complex)") THEN
      ASM_SIMP_TAC [REAL_LT_RMUL, REAL_MUL_LID]],
    ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"&1 - norm (moebius_function t w z) pow 2 =
      ((&1 - norm w pow 2) / (norm (Cx(&1) - cnj w * z) pow 2)) *
      (&1 - norm z pow 2)")
    SUBST1_TAC THENL
    [REWRITE_TAC [moebius_function,
                  ← GSYM CX_INJ, CX_SUB, CX_MUL, CX_DIV, CX_POW, CNJ_SUB, CNJ_CX,
                  CNJ_MUL, CNJ_DIV, CNJ_CNJ, COMPLEX_NORM_POW_2] THEN
     SUBGOAL_THEN
       (← q r"cnj (cexp(ii * Cx t)) * (cexp(ii * Cx t)) = Cx(&1) /\
        ~(Cx(&1) - cnj w * z = Cx(&0)) /\ ~(Cx(&1) - w * cnj z = Cx(&0))")
      MP_TAC THENL [ALL_TAC, CONV_TAC COMPLEX_FIELD] THEN
     REWRITE_TAC [CNJ_CEXP, CNJ_MUL, CNJ_II, CNJ_CX,
                   COMPLEX_MUL_LNEG, CEXP_NEG_LMUL] THEN ASM_REWRITE_TAC [] THEN
     SUBGOAL_THEN (← q r"~(cnj (Cx(&1) - cnj w * z) = Cx(&0))") MP_TAC THENL
     [ASM_REWRITE_TAC [CNJ_EQ_0],
      REWRITE_TAC [CNJ_SUB, CNJ_CX, CNJ_MUL, CNJ_CNJ]],
     SUBGOAL_THEN (← q r"!u:complex. norm u < &1 ==> &0 < &1 - norm u pow 2")
       ASSUME_TAC THENL
     [REWRITE_TAC [← REAL_FIELD (← q r"!a. &1 - a pow 2 = (&1 - a) * (&1 + a)")] THEN
      ASM_SIMP_TAC [REAL_LT_MUL, REAL_SUB_LT, REAL_LTE_ADD, REAL_LT_01,
                    NORM_POS_LE],
      SUBGOAL_THEN (← q r"&0 < norm (Cx(&1) - cnj w * z) pow 2")
       (fun th => ASM_MESON_TAC [th, REAL_LT_MUL, REAL_LT_DIV]) THEN
      ASM_REWRITE_TAC [← REAL_RING (← q r"!a:real. a pow 2 =  a * a"),
                       REAL_LT_SQUARE, COMPLEX_NORM_ZERO]]])

  let MOEBIUS_FUNCTION_HOLOMORPHIC ← (do
    let LEMMA_1 ← prove
     r"!a b:complex. norm a < &1 /\ norm b < &1 ==> ~(Cx(&1) - a * b = Cx(&0))"
     (GEN_TAC THEN GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [COMPLEX_SUB_0] THEN
      SUBGOAL_THEN (← q r"~(norm (Cx(&1)) = norm (a * b))")
        (fun th => MESON_TAC [th]) THEN
      REWRITE_TAC [COMPLEX_NORM_NUM, COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"!x y. y < x ==> ~(x = y)")) THEN
      ASM_CASES_TAC (← q r"b = Cx(&0)") THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_NUM, REAL_MUL_RZERO, REAL_LT_01] THEN
      MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"&1 * norm (b:complex)") THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC REAL_LT_RMUL THEN ASM_REWRITE_TAC [COMPLEX_NORM_NZ],
       ASM_REWRITE_TAC [REAL_MUL_LID]])
    prove
     r"!t w. norm w < &1 ==> moebius_function t w holomorphic_on ball(Cx(&0),&1)"
     (REPEAT STRIP_TAC THEN
      SUBST1_TAC (← GSYM (← ISPEC (← q r"moebius_function t w") ETA_AX)) THEN
      REWRITE_TAC [moebius_function] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_MUL THEN  CONJ_TAC THENL
      [MATCH_MP_TAC (← REWRITE_RULE [o_DEF] HOLOMORPHIC_ON_COMPOSE_GEN) THEN
       EXISTS_TAC (← q r"(:complex)") THEN REWRITE_TAC [HOLOMORPHIC_ON_CEXP, IN_UNIV] THEN
       SIMP_TAC [HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_CONST],
       MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
       SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_CONST,
                HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_MUL] THEN
       ASM_SIMP_TAC [COMPLEX_IN_BALL_0, LEMMA_1, COMPLEX_NORM_CNJ]]))

  let MOEBIUS_FUNCTION_COMPOSE ← (do
    let LEMMA_1 ← prove
     r"!a b:complex. norm a < &1 /\ norm b < &1
                     ==> ~(Cx(&1) - a * b = Cx(&0))"
     (GEN_TAC THEN GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [COMPLEX_SUB_0] THEN
      SUBGOAL_THEN (← q r"~(norm (Cx(&1)) = norm (a * b))")
        (fun th => MESON_TAC [th]) THEN
      REWRITE_TAC [COMPLEX_NORM_NUM, COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"!x y. y < x ==> ~(x = y)")) THEN
      ASM_CASES_TAC (← q r"b = Cx(&0)") THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_NUM, REAL_MUL_RZERO, REAL_LT_01] THEN
      MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"&1 * norm (b:complex)") THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC REAL_LT_RMUL THEN ASM_REWRITE_TAC [COMPLEX_NORM_NZ],
       ASM_REWRITE_TAC [REAL_MUL_LID]])
    let LEMMA_1_ALT ← prove
     r"!a b:complex. norm a < &1 /\ norm b < &1
                      ==> ~(Cx(&1) + a * b = Cx(&0))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBST1_TAC (← ExceptT.mk (COMPLEX_RING (← q r"a : complex = -- (-- a)"))) THEN
      ABBREV_TAC (← q r"u : complex= -- a") THEN
      REWRITE_TAC [COMPLEX_MUL_LNEG, ← GSYM complex_sub] THEN
      MATCH_MP_TAC LEMMA_1 THEN EXPAND_TAC "u" THEN
      ASM_REWRITE_TAC [NORM_NEG])
    prove
     r"!w1 w2 z.
       -- w1 = w2  /\ norm w1 < &1 /\ norm z < &1
       ==> moebius_function (&0) w1 (moebius_function (&0) w2 z) = z"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"norm (w2:complex) < &1") ASSUME_TAC THENL
       [EXPAND_TAC "w2" THEN ASM_REWRITE_TAC [NORM_NEG], ALL_TAC] THEN
      REWRITE_TAC [moebius_function, COMPLEX_MUL_RZERO,
                   CEXP_0, COMPLEX_MUL_LID] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
         (← q r"!a b c. ~(b = Cx(&0)) /\ a = b * c ==> a / b = c"))) THEN
      CONJ_TAC THENL
       [ALL_TAC, MP_TAC (← SPECL [← q r"cnj w2", ← q r"z:complex"] LEMMA_1) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_CNJ] THEN EXPAND_TAC "w2" THEN
        REWRITE_TAC [CNJ_NEG] THEN CONV_TAC COMPLEX_FIELD] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
          (← q r"!a b c d. ~(d = Cx(&0)) /\ ~(d * a - b * c  = Cx(&0))
                     ==> ~(a - b * c / d  = Cx(&0))"))) THEN
      ASM_SIMP_TAC [LEMMA_1, COMPLEX_NORM_CNJ] THEN
      ASM_REWRITE_TAC [COMPLEX_MUL_RID] THEN
      SUBGOAL_THEN
          (← q r"Cx(&1) - cnj w2 * z - cnj w1 * (z - w2) =
           Cx(&1) + cnj w1 * w2") SUBST1_TAC THENL
       [EXPAND_TAC "w2" THEN REWRITE_TAC [CNJ_NEG] THEN CONV_TAC COMPLEX_RING,
        ASM_SIMP_TAC [LEMMA_1_ALT, COMPLEX_NORM_CNJ]]))

  let BALL_BIHOLOMORPHISM_EXISTS ← prove
   r"!a. a IN ball(Cx(&0),&1)
       ==> ?f g. f(a) = Cx(&0) /\
                 f holomorphic_on ball (Cx(&0),&1) /\
                 (!z. z IN ball (Cx(&0),&1) ==> f z IN ball (Cx(&0),&1)) /\
                 g holomorphic_on ball (Cx(&0),&1) /\
                 (!z. z IN ball (Cx(&0),&1) ==> g z IN ball (Cx(&0),&1)) /\
                 (!z. z IN ball (Cx(&0),&1) ==> f (g z) = z) /\
                 (!z. z IN ball (Cx(&0),&1) ==> g (f z) = z)"
   (REWRITE_TAC [COMPLEX_IN_BALL_0] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"moebius_function (&0) a") THEN
    EXISTS_TAC (← q r"moebius_function (&0) (--a)") THEN
    ASM_SIMP_TAC [COMPLEX_IN_BALL_0, MOEBIUS_FUNCTION_COMPOSE, COMPLEX_NEG_NEG,
                 NORM_NEG] THEN
    ASM_SIMP_TAC [MOEBIUS_FUNCTION_NORM_LT_1, NORM_NEG,
                 MOEBIUS_FUNCTION_HOLOMORPHIC, MOEBIUS_FUNCTION_EQ_ZERO])

  let BALL_BIHOLOMORPHISM_MOEBIUS_FUNCTION ← (do
    let LEMMA_1 ← prove
     r"!a b:complex. norm a < &1 /\ norm b < &1
                      ==> ~(Cx(&1) - a * b = Cx(&0))"
     (GEN_TAC THEN GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [COMPLEX_SUB_0] THEN
      SUBGOAL_THEN (← q r"~(norm (Cx(&1)) = norm (a * b))")
        (fun th => MESON_TAC [th]) THEN
      REWRITE_TAC [COMPLEX_NORM_NUM, COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"!x y. y < x ==> ~(x = y)")) THEN
      ASM_CASES_TAC (← q r"b = Cx(&0)") THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_NUM, REAL_MUL_RZERO, REAL_LT_01] THEN
      MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"&1 * norm (b:complex)") THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC REAL_LT_RMUL THEN ASM_REWRITE_TAC [COMPLEX_NORM_NZ],
       ASM_REWRITE_TAC [REAL_MUL_LID]])
    let LEMMA_2 ← prove
     r"!t w s z. norm w < &1 /\ norm z < &1
                 ==> moebius_function t w (cexp(ii * Cx s) * z) =
                     moebius_function (t + s) (cexp(-- (ii * Cx s)) * w) z"
     (REPEAT STRIP_TAC THEN
      REWRITE_TAC [moebius_function, CX_ADD, COMPLEX_ADD_LDISTRIB, CEXP_ADD,
                  ← GSYM COMPLEX_MUL_ASSOC, COMPLEX_EQ_MUL_LCANCEL, CEXP_NZ,
               CNJ_MUL] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
        (← q r"!a b c d e. ~(b = Cx(&0)) /\ ~(e = Cx(&0)) /\ e * a = b * c * d
                     ==> a / b = c * d / e"))) THEN CONJ_TAC THENL
      [MATCH_MP_TAC LEMMA_1 THEN
       ASM_REWRITE_TAC [COMPLEX_NORM_CNJ, COMPLEX_NORM_MUL, NORM_CEXP_II,
                        REAL_MUL_LID],
       ALL_TAC] THEN
      CONJ_TAC THENL
      [REWRITE_TAC [COMPLEX_MUL_ASSOC] THEN MATCH_MP_TAC LEMMA_1 THEN
       ASM_REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CNJ, COMPLEX_NEG_RMUL,
                        ← GSYM CX_NEG, NORM_CEXP_II, REAL_MUL_LID],
       REWRITE_TAC [CNJ_CEXP, CNJ_NEG, CNJ_MUL, CNJ_II, CNJ_CX,
                    COMPLEX_MUL_LNEG, COMPLEX_NEG_NEG, CEXP_NEG] THEN
       ABBREV_TAC (← q r"a = cexp(ii * Cx s)") THEN
       SUBGOAL_THEN (← q r"inv a * a = Cx(&1)") MP_TAC THENL
       [ALL_TAC, CONV_TAC COMPLEX_RING] THEN
       MATCH_MP_TAC COMPLEX_MUL_LINV THEN EXPAND_TAC "a" THEN
       REWRITE_TAC [CEXP_NZ]])
    prove
     r"!f g.
        f holomorphic_on ball (Cx(&0),&1) /\
        (!z. z IN ball (Cx(&0),&1) ==> f z IN ball (Cx(&0),&1)) /\
        g holomorphic_on ball (Cx(&0),&1) /\
        (!z. z IN ball (Cx(&0),&1) ==> g z IN ball (Cx(&0),&1)) /\
        (!z. z IN ball (Cx(&0),&1) ==> f (g z) = z) /\
        (!z. z IN ball (Cx(&0),&1) ==> g (f z) = z)
        ==> ?t w. w IN ball (Cx(&0),&1) /\
                  (!z. z IN ball (Cx(&0),&1) ==> f z = moebius_function t w z)"
     (REWRITE_TAC [COMPLEX_IN_BALL_0] THEN REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"w:complex = f (Cx(&0))") THEN
      SUBGOAL_THEN (← q r"norm(w:complex) < &1") ASSUME_TAC THENL
      [ASM_MESON_TAC [COMPLEX_NORM_NUM, REAL_LT_01], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?t. !z. z IN ball (Cx(&0),&1)
                ==> moebius_function (&0) w (f z) = cexp(ii * Cx t) * z")
       STRIP_ASSUME_TAC THENL
      [ALL_TAC,
       EXISTS_TAC (← q r"t:real") THEN EXISTS_TAC (← q r"-- (cexp(-- (ii * Cx t)) * w)") THEN
       ASM_REWRITE_TAC [NORM_NEG, COMPLEX_NORM_MUL, COMPLEX_NEG_RMUL,
                        ← GSYM CX_NEG, NORM_CEXP_II, REAL_MUL_LID] THEN
       GEN_TAC THEN DISCH_TAC THEN EQ_TRANS_TAC
         (← q r"moebius_function (&0) (--w)
            (moebius_function (&0) w (f (z:complex)))") THENL
       [MATCH_MP_TAC HolLight.HolBase.T.EQ_SYM THEN MATCH_MP_TAC MOEBIUS_FUNCTION_COMPOSE THEN
        ASM_SIMP_TAC [COMPLEX_NEG_NEG, NORM_NEG],
        ASM_SIMP_TAC [COMPLEX_IN_BALL_0] THEN ASM_SIMP_TAC [LEMMA_2, NORM_NEG] THEN
        REWRITE_TAC [REAL_ADD_LID, CX_NEG, COMPLEX_MUL_RNEG]]] THEN
      MATCH_MP_TAC SECOND_CARTAN_THM_DIM_1 THEN EXISTS_TAC
        (← q r"\z. g (moebius_function (&0) (--w) z) : complex") THEN
      REWRITE_TAC [COMPLEX_IN_BALL_0] THEN REWRITE_TAC [REAL_LT_01] THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC (← REWRITE_RULE [o_DEF] HOLOMORPHIC_ON_COMPOSE_GEN) THEN
       EXISTS_TAC (← q r"ball(Cx(&0),&1)") THEN
       ASM_SIMP_TAC [ETA_AX, MOEBIUS_FUNCTION_HOLOMORPHIC, COMPLEX_IN_BALL_0],
       ALL_TAC] THEN CONJ_TAC THENL [ASM_SIMP_TAC [MOEBIUS_FUNCTION_NORM_LT_1],
       ALL_TAC] THEN
      CONJ_TAC THENL [ASM_REWRITE_TAC [MOEBIUS_FUNCTION_EQ_ZERO], ALL_TAC] THEN
      CONJ_TAC THENL
      [MATCH_MP_TAC (← REWRITE_RULE [o_DEF] HOLOMORPHIC_ON_COMPOSE_GEN) THEN
       EXISTS_TAC (← q r"ball(Cx(&0),&1)") THEN
       ASM_SIMP_TAC [COMPLEX_IN_BALL_0, MOEBIUS_FUNCTION_NORM_LT_1,
                     NORM_NEG] THEN
       ASM_SIMP_TAC [ETA_AX, MOEBIUS_FUNCTION_HOLOMORPHIC, NORM_NEG],
       ALL_TAC] THEN CONJ_TAC THENL
      [ASM_SIMP_TAC [MOEBIUS_FUNCTION_NORM_LT_1, NORM_NEG], ALL_TAC] THEN
      CONJ_TAC THENL
      [ASM_REWRITE_TAC [MOEBIUS_FUNCTION_OF_ZERO, COMPLEX_MUL_RZERO, CEXP_0,
                        ← GSYM COMPLEX_NEG_LMUL, COMPLEX_MUL_LID,
                         COMPLEX_NEG_NEG] THEN
       ASM_MESON_TAC [COMPLEX_NORM_0, REAL_LT_01],
       ALL_TAC] THEN CONJ_TAC THENL
      [ALL_TAC,
       ASM_SIMP_TAC [← REWRITE_RULE [COMPLEX_NEG_NEG, NORM_NEG]
            (← SPECL [← q r"--w:complex", ← q r"w:complex"] MOEBIUS_FUNCTION_COMPOSE)]] THEN
       REPEAT STRIP_TAC THEN SUBGOAL_THEN
        (← q r"f (g (moebius_function (&0) (--w) z) : complex) =
         (moebius_function (&0) (--w) z)")
        SUBST1_TAC THENL
      [FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_SIMP_TAC [MOEBIUS_FUNCTION_NORM_LT_1, NORM_NEG],
       MATCH_MP_TAC MOEBIUS_FUNCTION_COMPOSE THEN ASM_REWRITE_TAC []]))

  pure { moebius_function, MOEBIUS_FUNCTION_SIMPLE, MOEBIUS_FUNCTION_EQ_ZERO,
         MOEBIUS_FUNCTION_OF_ZERO, MOEBIUS_FUNCTION_NORM_LT_1,
         MOEBIUS_FUNCTION_HOLOMORPHIC, MOEBIUS_FUNCTION_COMPOSE,
         BALL_BIHOLOMORPHISM_EXISTS, BALL_BIHOLOMORPHISM_MOEBIUS_FUNCTION }
/- ------------------------------------------------------------------------- -/
/- Some simple but useful cases of Hurwitz's theorem.                        -/
/- (cauchy.ml 17313-17611)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBU where
  HURWITZ_NO_ZEROS : thm
  HURWITZ_INJECTIVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBU [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYG : KYG) (BKYL : KYL) (BKYAE : KYAE) (BKYAF : KYAF) (BKYAG : KYAG) (BKYAI : KYAI) (BKYBB : KYBB) (BKYBC : KYBC) (BKYBI : KYBI) : ExceptT String IO KYBU := do
  -- @@SCOPE BEGIN
  let { path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { HAS_PATH_INTEGRAL_ADD, PATH_INTEGRAL_EQ, .. } := BKYG
  let { CAUCHY_THEOREM_DISC_SIMPLE, .. } := BKYL
  let { PATH_IMAGE_CIRCLEPATH, PATHFINISH_CIRCLEPATH, PATHSTART_CIRCLEPATH,
        VALID_PATH_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE, .. } := BKYAF
  let { PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH, .. } := BKYAG
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { CAUCHY_HIGHER_COMPLEX_DERIVATIVE_BOUND, .. } := BKYBB
  let { ISOLATED_ZEROS, .. } := BKYBC
  let { HOLOMORPHIC_FACTOR_ZERO_NONCONSTANT, .. } := BKYBI
  let { CONNECTED_OPEN_DELETE, .. } := D.qpaths
  let { COMPACT_ATTAINS_INF, .. } := D.mt.qtopology
  let { PI_NZ, .. } := D.mt.ra.tse
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { UNIFORM_LIM_COMPLEX_DIV, .. } := D.mt.ra.ts.knb
