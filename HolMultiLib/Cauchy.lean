      ASM_SIMP_TAC [COMPLEX_DIV_LMUL, COMPLEX_ENTIRE, CX_INJ, REAL_LT_IMP_NZ] THEN
      MATCH_MP_TAC REAL_LT_LCANCEL_IMP THEN EXISTS_TAC (← q r"norm(C * Cx r)") THEN
