    (CONJ_TAC THENL
      [REWRITE_TAC [← GSYM BALL_UNION_SPHERE] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
          MATCH_MP (← SET_RULE
        (← q r"(!x y. x IN b /\ y IN b ==> (f x = f y <=> x = y))
         ==> (?x y. x IN b /\ y IN b /\ ~(x = y))
             ==> ~(!x. x IN b UNION s ==> f x = a)"))) THEN
