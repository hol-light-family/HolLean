    ABBREV_TAC (← q r"t = (r - norm(p - a:complex)) / &2") THEN
    SUBGOAL_THEN (← q r"&0 < t") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    EXISTS_TAC (← q r"(f:complex->complex) p") THEN
    EXISTS_TAC (← q r"(&3 - &2 * sqrt (&2)) * t * norm (complex_derivative f p)") THEN
