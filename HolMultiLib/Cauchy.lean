    ABBREV_TAC (← q r"kg = (k:complex->complex) o (g:complex->complex)") THEN
    ABBREV_TAC (← q r"r = \z. norm z % (kg:complex->complex) (inv(norm z) % z)") THEN
    SUBGOAL_THEN (← q r"!w. norm((r:complex->complex) w) = norm w") ASSUME_TAC THENL
