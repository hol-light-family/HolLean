                         (n - w) / Cx(&k) - inv(x - w) pow (k + 1)) <
                        e)
           (at w)")
    ASSUME_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"bounded(IMAGE (f':complex->complex) (path_image g))")
      MP_TAC THENL
       [MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
        ASM_SIMP_TAC [COMPACT_VALID_PATH_IMAGE],
        ALL_TAC] THEN
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / C:real")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      X_GEN_TAC (← q r"u:complex") THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:complex") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [complex_div, ← GSYM COMPLEX_MUL_ASSOC] THEN
      REWRITE_TAC [← GSYM COMPLEX_SUB_LDISTRIB, COMPLEX_NORM_MUL] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_SIMP_TAC [REAL_LT_RDIV_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> b < x ==> a < x")) THEN
      REWRITE_TAC [COMPLEX_POW_INV] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE]] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN REWRITE_TAC [EVENTUALLY_AT] THEN
    EXISTS_TAC (← q r"min (d / &2) ((e * (d / &2) pow (k + 2)) / (&k + &1))") THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_HALF, REAL_POW_LT, REAL_LT_MUL, dist,
                 REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < &k + &1")] THEN
    X_GEN_TAC (← q r"u:complex") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:complex") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"\n w. if n = 0 then inv(x - w) pow k
                          else if n = 1 then Cx(&k) / (x - w) pow (k + 1)
                          else (Cx(&k) * Cx(&k + &1)) / (x - w) pow (k + 2)",
                   ← q r"1", ← q r"ball(w:complex,d / &2)",
                   ← q r"(&k * (&k + &1)) / (d / &2) pow (k + 2)"]
           COMPLEX_TAYLOR) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [CONVEX_BALL, ADD_EQ_0, ARITH] THEN CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"v:complex") THEN REWRITE_TAC [IN_BALL, dist] THEN DISCH_TAC THEN
        REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_DIV, COMPLEX_NORM_CX] THEN
        REWRITE_TAC [real_div, ← GSYM REAL_POW_INV, ← GSYM REAL_MUL_ASSOC] THEN
        REWRITE_TAC [REAL_ABS_NUM, ← REAL_ARITH (← q r"abs(&k + &1) = &k + &1")] THEN
        REPEAT (MATCH_MP_TAC REAL_LE_LMUL THEN
               CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC]) THEN
        REWRITE_TAC [REAL_POW_INV] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
        ASM_SIMP_TAC [← GSYM real_div, REAL_POW_LT, REAL_HALF] THEN
        REWRITE_TAC [COMPLEX_NORM_POW] THEN MATCH_MP_TAC REAL_POW_LE2 THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < d ==> &0 <= d / &2")] THEN
        UNDISCH_TAC (← q r"ball(w:complex,d) SUBSET s DIFF path_image g") THEN
        REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:complex")) THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_BALL] THEN
        UNDISCH_TAC (← q r"norm(w - v:complex) < d / &2") THEN
        CONV_TAC (fun t => NORM_ARITH t)] THEN
      GEN_TAC THEN X_GEN_TAC (← q r"y:complex") THEN
      REWRITE_TAC [IN_BALL, dist] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~(y:complex = x)") ASSUME_TAC THENL
       [DISCH_THEN SUBST_ALL_TAC THEN
        UNDISCH_TAC (← q r"ball(w:complex,d) SUBSET s DIFF path_image g") THEN
        REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:complex")) THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_BALL, dist] THEN ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      FIRST_X_ASSUM (DISJ_CASES_THEN SUBST_ALL_TAC o MATCH_MP
        (← ARITH_RULE (← q r"i <= 1 ==> i = 0 \/ i = 1"))) THEN
      REWRITE_TAC [ARITH] THEN
      MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_AT_WITHIN THEN
      COMPLEX_DIFF_TAC THEN
      REWRITE_TAC [COMPLEX_POW_EQ_0, COMPLEX_INV_EQ_0, CONJ_ASSOC,
         COMPLEX_MUL_LZERO, COMPLEX_SUB_0, ADD_EQ_0, ARITH] THEN
      REWRITE_TAC [COMPLEX_SUB_LZERO, COMPLEX_NEG_NEG, complex_div] THEN
      REWRITE_TAC [COMPLEX_MUL_LID, ← GSYM COMPLEX_MUL_ASSOC,
       ← GSYM COMPLEX_POW_INV, ← GSYM COMPLEX_INV_MUL, ← GSYM COMPLEX_POW_ADD] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(k = 0) ==> k - 1 + 2 = k + 1")] THEN
      REWRITE_TAC [COMPLEX_INV_INV, ADD_SUB, COMPLEX_MUL_RNEG,
                  COMPLEX_NEG_NEG, COMPLEX_MUL_RID, COMPLEX_POW_POW] THEN
      REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC, ← GSYM REAL_OF_NUM_ADD] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN REWRITE_TAC [COMPLEX_POW_INV] THEN
      ASM_SIMP_TAC [COMPLEX_POW_EQ_0, COMPLEX_INV_EQ_0, COMPLEX_SUB_0,
                   ← ExceptT.mk (COMPLEX_FIELD (← q r"~(x = Cx(&0)) /\ ~(y = Cx(&0))
                                  ==> (z * inv x = inv y <=> y * z = x)"))] THEN
      REWRITE_TAC [← GSYM COMPLEX_POW_ADD] THEN AP_TERM_TAC THEN ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"w:complex", ← q r"u:complex"]) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, REAL_HALF,
                    ← ExceptT.mk (NUMSEG_CONV (← q r"0..1"))] THEN
    ASM_SIMP_TAC [IN_BALL, dist, VSUM_CLAUSES, FINITE_RULES] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [NORM_SUB], ALL_TAC] THEN
    REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY, ARITH] THEN
    REWRITE_TAC [complex_pow, VECTOR_ADD_RID, ARITH, FACT] THEN
    CONV_TAC NUM_REDUCE_CONV THEN
    REWRITE_TAC [COMPLEX_DIV_1, COMPLEX_MUL_RID, COMPLEX_POW_1] THEN
    SUBGOAL_THEN (← q r"~(u:complex = w)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPLEX_SUB_REFL, COMPLEX_NORM_0, REAL_LT_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(x:complex = w)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [COMPLEX_SUB_0, COMPLEX_POW_EQ_0, CX_INJ, REAL_OF_NUM_EQ,
       ← ExceptT.mk (COMPLEX_FIELD
          (← q r"~(d = Cx(&0)) /\ ~(c = Cx(&0)) /\ ~(e = Cx(&0))
           ==> a - (b + c / d * e) = ((a - b) / e / c - inv d) * c * e"))] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, REAL_DIV_1] THEN
    REWRITE_TAC [REAL_ABS_NUM, ← GSYM COMPLEX_POW_INV] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LT_RCANCEL_IMP THEN
    EXISTS_TAC (← q r"&k * norm(u - w:complex)") THEN
    ASM_SIMP_TAC [REAL_LT_MUL, REAL_OF_NUM_LT, LT_NZ] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"n <= x ==> x < y ==> n < y"))) THEN
    REWRITE_TAC [REAL_POW_2, REAL_MUL_ASSOC] THEN
    ASM_SIMP_TAC [REAL_POW_2, REAL_MUL_ASSOC, REAL_LT_RMUL_EQ] THEN
    GEN_REWRITE_TAC RAND_CONV [REAL_MUL_SYM] THEN
    REWRITE_TAC [real_div, ← GSYM REAL_MUL_ASSOC] THEN
    MATCH_MP_TAC REAL_LT_LMUL THEN ASM_REWRITE_TAC [REAL_OF_NUM_LT, LT_NZ] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"a * b * c:real = (c * a) * b")] THEN
    ASM_SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ, REAL_HALF, REAL_POW_LT] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, ← REAL_ARITH (← q r"&0 < &k + &1")])

  let CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH ← prove
   r"!f g z r k.
        ~(k = 0) /\
        (f continuous_on path_image(circlepath(z,r))) /\
        (!w. w IN ball(z,r)
             ==> ((\u. f(u) / (u - w) pow k) has_path_integral g w)
                 (circlepath(z,r)))
        ==> !w. w IN ball(z,r)
                ==> (\u. f(u) / (u - w) pow (k + 1)) path_integrable_on
                            (circlepath(z,r)) /\
                    (g has_complex_derivative
                     (Cx(&k) * path_integral(circlepath(z,r))
                                 (\u. f(u) / (u - w) pow (k + 1))))
                    (at w)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_CASES_TAC (← q r"&0 <= r") THENL
     [ALL_TAC,
      GEN_TAC THEN REWRITE_TAC [IN_BALL] THEN
      MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN
      UNDISCH_TAC (← q r"~(&0 <= r)") THEN CONV_TAC (fun t => NORM_ARITH t)] THEN
    MP_TAC (← ISPECL
     [← q r"f:complex->complex", ← q r"g:complex->complex", ← q r"circlepath(z,r)",
      ← q r"ball(z:complex,r)", ← q r"k:num", ← q r"&2 * pi * r"] CAUCHY_NEXT_DERIVATIVE) THEN
    ASM_REWRITE_TAC [OPEN_BALL, VALID_PATH_CIRCLEPATH] THEN
    SUBGOAL_THEN (← q r"ball(z,r) DIFF path_image(circlepath (z,r)) = ball(z,r)")
    SUBST1_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s <=> !x. x IN t ==> ~(x IN s)")] THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, IN_SPHERE, IN_BALL, REAL_LT_REFL],
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [VECTOR_DERIVATIVE_CIRCLEPATH] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_II] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_ABS_PI, REAL_MUL_LID] THEN
      REWRITE_TAC [NORM_CEXP, RE_MUL_CX, RE_MUL_II, IM_CX] THEN
      REWRITE_TAC [REAL_NEG_0, REAL_MUL_RZERO, REAL_EXP_0, REAL_MUL_RID] THEN
      ASM_SIMP_TAC [real_abs, REAL_LE_REFL]])

  /- In particular, the first derivative formula. -/

  let CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH ← prove
   r"!f z r w.
        f continuous_on cball(z,r) /\
        f holomorphic_on ball(z,r) /\
        w IN ball(z,r)
        ==> (\u. f(u) / (u - w) pow 2) path_integrable_on circlepath(z,r) /\
            (f has_complex_derivative
                (Cx(&1) / (Cx(&2) * Cx(pi) * ii) *
                 path_integral(circlepath(z,r)) (\u. f(u) / (u - w) pow 2)))
            (at w)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"\x:complex. Cx(&2) * Cx(pi) * ii * f x",
                  ← q r"z:complex", ← q r"r:real", ← q r"1"]
           CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH) THEN
    ASM_SIMP_TAC [COMPLEX_POW_1, ARITH, CAUCHY_INTEGRAL_CIRCLEPATH] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"cball(z:complex,r)") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"n < r ==> &0 <= n ==> &0 <= r"))) THEN
      SIMP_TAC [DIST_POS_LE, PATH_IMAGE_CIRCLEPATH, SPHERE_SUBSET_CBALL],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [COMPLEX_MUL_LID] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii)") o
          MATCH_MP HAS_COMPLEX_DERIVATIVE_LMUL_AT) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM] THEN MP_TAC CX_2PII_NZ THEN CONV_TAC COMPLEX_FIELD)

  pure { CAUCHY_NEXT_DERIVATIVE, CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH,
         CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- Existence of all higher derivatives; Morera's theorem.                    -/
/- (cauchy.ml 8004-8153)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAI where
  HOLOMORPHIC_DERIVATIVE : thm
  HOLOMORPHIC_COMPLEX_DERIVATIVE : thm
  ANALYTIC_COMPLEX_DERIVATIVE : thm
  HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE : thm
  ANALYTIC_HIGHER_COMPLEX_DERIVATIVE : thm
  HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE : thm
  MORERA_LOCAL_TRIANGLE_GEN : thm
  MORERA_LOCAL_TRIANGLE : thm
  MORERA_TRIANGLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAI [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYG : KYG) (BKYK : KYK) (BKYAE : KYAE) (BKYAH : KYAH) : ExceptT String IO KYAI := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_INTEGRAL, .. } := BKYC
  let { HAS_PATH_INTEGRAL_COMPLEX_LMUL, .. } := BKYG
  let { TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE, .. } := BKYK
  let { PATH_IMAGE_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH, CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH,
        .. } := BKYAH
  let { CONTINUOUS_ON_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { COMPLEX_DERIVATIVE_UNIQUE_AT, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        higher_complex_derivative, holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
        .. } := D.mt.ra.ts.knh
  let { analytic_on, .. } := D.mt.ra.ts.kni
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, .. } := D.mt.ra.ts.cn.cxb
  let { ASM_MESON_TAC, INDUCT_TAC, NORM_ARITH_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, EMPTY_SUBSET, EQ_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ_ALT, INSERT_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_IMP_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { HULL_MINIMAL, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, OPEN_BALL, OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { SPHERE_SUBSET_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let HOLOMORPHIC_DERIVATIVE ← prove
   r"!f f' s. open s /\ (!z. z IN s ==> (f has_complex_derivative f'(z)) (at z))
            ==> f' holomorphic_on s"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← SPECL [← q r"\x. Cx(&1) / (Cx(&2) * Cx pi * ii) * f(x:complex)",
                  ← q r"f':complex->complex", ← q r"z:complex", ← q r"r:real", ← q r"2"]
                 CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH) THEN
    ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC [CENTRE_IN_BALL]] THEN
    SUBGOAL_THEN (← q r"f holomorphic_on cball(z,r)") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [holomorphic_on] THEN
      ASM_MESON_TAC [SUBSET, HAS_COMPLEX_DERIVATIVE_AT_WITHIN],
      ALL_TAC] THEN
    REWRITE_TAC [ARITH] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_LMUL THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"cball(z:complex,r)") THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE, SPHERE_SUBSET_CBALL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"z:complex", ← q r"r:real", ← q r"w:complex"]
                 CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
                    BALL_SUBSET_CBALL],
      ALL_TAC] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_INTEGRAL) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii)") o
      MATCH_MP HAS_PATH_INTEGRAL_COMPLEX_LMUL) THEN
    REWRITE_TAC [complex_div, ← GSYM COMPLEX_MUL_ASSOC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM complex_div] THEN
    MATCH_MP_TAC COMPLEX_DERIVATIVE_UNIQUE_AT THEN
    MAP_EVERY EXISTS_TAC [← q r"f:complex->complex", ← q r"w:complex"] THEN
    ASM_REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC] THEN
    ASM_MESON_TAC [SUBSET, BALL_SUBSET_CBALL])

  let HOLOMORPHIC_COMPLEX_DERIVATIVE ← prove
   r"!f s. open s /\ f holomorphic_on s
         ==> (complex_derivative f) holomorphic_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOLOMORPHIC_DERIVATIVE THEN
    EXISTS_TAC (← q r"f:complex->complex") THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HOLOMORPHIC_ON_OPEN])

  let ANALYTIC_COMPLEX_DERIVATIVE ← prove
   r"!f s. f analytic_on s ==> (complex_derivative f) analytic_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [analytic_on] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, OPEN_BALL])

  let HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE ← prove
   r"!f s n. open s /\ f holomorphic_on s
           ==> (higher_complex_derivative n f) holomorphic_on s"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, higher_complex_derivative])

  let ANALYTIC_HIGHER_COMPLEX_DERIVATIVE ← prove
   r"!f s n. f analytic_on s ==> (higher_complex_derivative n f) analytic_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [analytic_on] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_SIMP_TAC [HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE, OPEN_BALL])

  let HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE ← prove
   r"!f s x n. open s /\ f holomorphic_on s /\ x IN s
             ==> ((higher_complex_derivative n f) has_complex_derivative
                          (higher_complex_derivative (SUC n) f x)) (at x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [higher_complex_derivative] THEN
    REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
    MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN
    ASM_SIMP_TAC [HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE])

  /- Morera's theorem. -/

  let MORERA_LOCAL_TRIANGLE_GEN ← prove
   r"!f s.
     (!z. z IN s
          ==> ?e a. &0 < e /\ z IN ball(a,e) /\ f continuous_on ball(a,e) /\
                    !b c. segment[b,c] SUBSET ball(a,e)
                           ==> path_integral (linepath(a,b)) f +
                               path_integral (linepath(b,c)) f +
                               path_integral (linepath(c,a)) f = Cx(&0))
     ==> f analytic_on s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [analytic_on] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"a:complex"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"e - dist(a:complex,z)") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN NORM_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN EXISTS_TAC (← q r"ball(a:complex,e)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_DERIVATIVE THEN REWRITE_TAC [OPEN_BALL] THEN
      MATCH_MP_TAC TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE THEN
      EXISTS_TAC (← q r"a:complex") THEN ASM_REWRITE_TAC [CENTRE_IN_BALL, OPEN_BALL] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
      MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
      ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CENTRE_IN_BALL],
      REWRITE_TAC [SUBSET, IN_BALL] THEN NORM_ARITH_TAC])

  let MORERA_LOCAL_TRIANGLE ← prove
   r"!f s. (!z. z IN s
              ==> ?t. open t /\ z IN t /\ f continuous_on t /\
                      !a b c. convex hull {a,b,c} SUBSET t
                              ==> path_integral (linepath(a,b)) f +
                                  path_integral (linepath(b,c)) f +
                                  path_integral (linepath(c,a)) f = Cx(&0))
         ==> f analytic_on s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC MORERA_LOCAL_TRIANGLE_GEN THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:complex->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"z:complex") THEN ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:complex", ← q r"w:complex"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM
     (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
    MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CENTRE_IN_BALL] THEN
    MP_TAC (← ISPECL [← q r"x:complex", ← q r"w:complex"] ENDS_IN_SEGMENT) THEN
    ASM SET_TAC [])

  let MORERA_TRIANGLE ← prove
   r"!f s. open s /\ f continuous_on s /\
         (!a b c. convex hull {a,b,c} SUBSET s
                  ==> path_integral (linepath(a,b)) f +
                      path_integral (linepath(b,c)) f +
                      path_integral (linepath(c,a)) f = Cx(&0))
         ==> f analytic_on s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MORERA_LOCAL_TRIANGLE THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN EXISTS_TAC (← q r"s:complex->bool") THEN
    ASM_REWRITE_TAC [])

  pure { HOLOMORPHIC_DERIVATIVE, HOLOMORPHIC_COMPLEX_DERIVATIVE,
         ANALYTIC_COMPLEX_DERIVATIVE, HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE,
         ANALYTIC_HIGHER_COMPLEX_DERIVATIVE,
         HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE, MORERA_LOCAL_TRIANGLE_GEN,
         MORERA_LOCAL_TRIANGLE, MORERA_TRIANGLE }

/- ------------------------------------------------------------------------- -/
/- Combining theorems for higher derivatives including Leibniz rule.         -/
/- (cauchy.ml 8158-8408)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAJ where
  HIGHER_COMPLEX_DERIVATIVE_EQ_ITER : thm
  HIGHER_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE : thm
  higher_complex_derivative_alt : thm
  HIGHER_COMPLEX_DERIVATIVE_LINEAR : thm
  HIGHER_COMPLEX_DERIVATIVE_CONST : thm
  HIGHER_COMPLEX_DERIVATIVE_ID : thm
  HAS_COMPLEX_DERIVATIVE_ITER_1 : thm
  HIGHER_COMPLEX_DERIVATIVE_NEG : thm
  HIGHER_COMPLEX_DERIVATIVE_ADD : thm
  HIGHER_COMPLEX_DERIVATIVE_SUB : thm
  HIGHER_COMPLEX_DERIVATIVE_MUL : thm
  HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN : thm
  HIGHER_COMPLEX_DERIVATIVE_COMPOSE_LINEAR : thm
  HIGHER_COMPLEX_DERIVATIVE_ADD_AT : thm
  HIGHER_COMPLEX_DERIVATIVE_SUB_AT : thm
  HIGHER_COMPLEX_DERIVATIVE_NEG_AT : thm
  HIGHER_COMPLEX_DERIVATIVE_MUL_AT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAJ [HolBase] (D : CauchyDeps) (BKYAI : KYAI) : ExceptT String IO KYAJ := do
  -- @@SCOPE BEGIN
  let { ANALYTIC_HIGHER_COMPLEX_DERIVATIVE,
        HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE,
        HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { ADD_0, ONE, PRE, SUB, SUB_SUC, .. } := D.qsession
  let { VSUM_SUC, .. } := D.qvectors
  let { ITER, ITER_ADD, ITER_ALT, ITER_FIXPOINT, ITER_POINTLESS, .. } := D.qiter
  let { BINOM_EQ_0, .. } := D.qbinomial
  let { num_CASES, .. } := D.mt.ra.qsession
  let { binom, .. } := D.mt.ra.qbinomial
  let { COMPLEX_DIFF_CHAIN_AT, HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN,
        higher_complex_derivative, HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_ADD, HAS_COMPLEX_DERIVATIVE_ID,
        HAS_COMPLEX_DERIVATIVE_LMUL_AT, HAS_COMPLEX_DERIVATIVE_MUL_AT,
        HAS_COMPLEX_DERIVATIVE_NEG, HAS_COMPLEX_DERIVATIVE_SUB,
        HAS_COMPLEX_DERIVATIVE_VSUM, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_LINEAR, .. } := D.mt.ra.ts.kng
  let { COMPLEX_DERIVATIVE_CHAIN, COMPLEX_DERIVATIVE_CONST, COMPLEX_DERIVATIVE_ID,
        COMPLEX_DERIVATIVE_LINEAR, COMPLEX_DERIVATIVE_LMUL,
        COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN, HAS_COMPLEX_DERIVATIVE_DERIVATIVE,
        HOLOMORPHIC_ON_COMPOSE_GEN, HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID,
        HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_POW, .. } := D.mt.ra.ts.knh
  let { ANALYTIC_AT, ANALYTIC_AT_TWO, ANALYTIC_ON_COMPOSE_GEN,
        ANALYTIC_ON_IMP_DIFFERENTIABLE_AT, ANALYTIC_ON_LINEAR, ANALYTIC_ON_OPEN,
        .. } := D.mt.ra.ts.kni
  let { SUC_INJ, .. } := D.mt.ra.ts.qsession
  let { complex_pow, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LDISTRIB, COMPLEX_ADD_LID, COMPLEX_ADD_RDISTRIB, COMPLEX_MUL_AC,
        COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_MUL_SYM, .. } := D.mt.ra.ts.cn.cxb
  let { CX_ADD, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_EQ_MUL_LCANCEL, .. } := D.mt.ra.ts.cn.cxe
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, NOT_SUC, VSUM_CLAUSES_LEFT, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ADD1, ADD_SYM, EQ_TRANS, ETA_AX, FINITE_NUMSEG, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_NUMSEG, NUMSEG_SING, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_OF_NUM_ADD, RIGHT_FORALL_IMP_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { VSUM_ADD, VSUM_CLAUSES_NUMSEG, VSUM_SING, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { I_DEF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  -- EQ_TRANS_TAC (misc.ml 19), local: CauchyDeps carries no MiscDeps.
  let EQ_TRANS_TAC : term → tactic := fun tm =>
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC tm THEN CONJ_TAC


  let HIGHER_COMPLEX_DERIVATIVE_EQ_ITER ← prove
   r"!n. higher_complex_derivative n = ITER n complex_derivative"
   (INDUCT_TAC THEN
    ASM_REWRITE_TAC [FUN_EQ_THM, ITER, higher_complex_derivative])

  let HIGHER_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE ← prove
   r"!f m n. higher_complex_derivative m (higher_complex_derivative n f) =
           higher_complex_derivative (m + n) f"
   (REWRITE_TAC [HIGHER_COMPLEX_DERIVATIVE_EQ_ITER, ITER_ADD])

  let higher_complex_derivative_alt ← prove
   r"(!f. higher_complex_derivative 0 f = f) /\
   (!f n. higher_complex_derivative (SUC n) f =
          higher_complex_derivative n (complex_derivative f))"
   (REWRITE_TAC [HIGHER_COMPLEX_DERIVATIVE_EQ_ITER, ITER_ALT])

  let HIGHER_COMPLEX_DERIVATIVE_LINEAR ← prove
   r"!c n. higher_complex_derivative n (\w. c * w) =
    \z. if n = 0 then c * z else if n = 1 then c else (Cx(&0))"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [higher_complex_derivative, NOT_SUC, SUC_INJ, ONE] THEN
    STRUCT_CASES_TAC (← SPEC (← q r"n:num") num_CASES) THEN
    REWRITE_TAC [NOT_SUC, SUC_INJ,
                 COMPLEX_DERIVATIVE_LINEAR, COMPLEX_DERIVATIVE_CONST])

  let HIGHER_COMPLEX_DERIVATIVE_CONST ← prove
   r"!i c. higher_complex_derivative i (\w.c) = \w. if i=0 then c else Cx(&0)"
   (INDUCT_TAC THEN ASM_REWRITE_TAC [higher_complex_derivative_alt, NOT_SUC,
                                     COMPLEX_DERIVATIVE_CONST, FUN_EQ_THM] THEN
    MESON_TAC [])

  let HIGHER_COMPLEX_DERIVATIVE_ID ← prove
   r"!z i. higher_complex_derivative i (\w.w) z =
            if i = 0 then z else if i = 1 then Cx(&1) else Cx(&0)"
   (GEN_TAC THEN INDUCT_TAC THEN
    ASM_REWRITE_TAC [higher_complex_derivative_alt, NOT_SUC, ONE, SUC_INJ] THEN
    REWRITE_TAC [COMPLEX_DERIVATIVE_ID, HIGHER_COMPLEX_DERIVATIVE_CONST, ONE])

  let HAS_COMPLEX_DERIVATIVE_ITER_1 ← prove
   r"!f n z. f z = z /\ (f has_complex_derivative Cx(&1)) (at z)
           ==> (ITER n f has_complex_derivative Cx(&1)) (at z)"
   (GEN_TAC THEN INDUCT_TAC THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [ITER_POINTLESS, I_DEF, HAS_COMPLEX_DERIVATIVE_ID] THEN
    SUBGOAL_THEN (← q r"Cx(&1) = Cx(&1) * Cx(&1)") SUBST1_TAC THENL
    [REWRITE_TAC [COMPLEX_MUL_LID],
     ASM_SIMP_TAC [ITER_FIXPOINT, COMPLEX_DIFF_CHAIN_AT]])

  let HIGHER_COMPLEX_DERIVATIVE_NEG ← prove
   r"!f s n z.
     open s /\ f holomorphic_on s /\ z IN s
     ==> higher_complex_derivative n (\w. --(f w)) z =
                --(higher_complex_derivative n f z)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [higher_complex_derivative] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    EXISTS_TAC (← q r"(\w. --(higher_complex_derivative n f w))") THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_NEG THEN
    REWRITE_TAC [ETA_AX, ← GSYM higher_complex_derivative] THEN
    ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE])

  let HIGHER_COMPLEX_DERIVATIVE_ADD ← prove
   r"!f g s n z.
     open s /\ f holomorphic_on s /\ g holomorphic_on s /\ z IN s ==>
     higher_complex_derivative n (\w. f w + g w) z  =
     higher_complex_derivative n f z + higher_complex_derivative n g z"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [higher_complex_derivative] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    EXISTS_TAC (← q r"(\w. higher_complex_derivative n f w +
                     higher_complex_derivative n g w)") THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_ADD THEN
    REWRITE_TAC [ETA_AX, ← GSYM higher_complex_derivative] THEN
    ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE])

  let HIGHER_COMPLEX_DERIVATIVE_SUB ← prove
   r"!f g s n z.
     open s /\ f holomorphic_on s /\ g holomorphic_on s /\ z IN s ==>
     higher_complex_derivative n (\w. f w - g w) z  =
     higher_complex_derivative n f z - higher_complex_derivative n g z"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [higher_complex_derivative] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    EXISTS_TAC (← q r"(\w. higher_complex_derivative n f w -
                     higher_complex_derivative n g w)") THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_SUB THEN
    REWRITE_TAC [ETA_AX, ← GSYM higher_complex_derivative] THEN
    ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE])

  let HIGHER_COMPLEX_DERIVATIVE_MUL ← prove
   r"!f g s n z.
     open s /\ f holomorphic_on s /\ g holomorphic_on s /\ z IN s
     ==> higher_complex_derivative n (\w. f w * g w) z =
         vsum (0..n) (\i. Cx(&(binom(n,i))) *
                          higher_complex_derivative i f z *
                          higher_complex_derivative (n-i) g z)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [NUMSEG_SING, VSUM_SING, SUB] THEN
    REWRITE_TAC [higher_complex_derivative, binom, COMPLEX_MUL_LID] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    EXISTS_TAC (← q r"\w. vsum (0..n)
                      (\i. Cx(&(binom (n,i))) *
                           higher_complex_derivative i f w *
                           higher_complex_derivative (n-i) g w)") THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN ASM_SIMP_TAC [] THEN
    SUBGOAL_THEN (← q r"vsum (0..SUC n) (\i. Cx(&(binom (SUC n,i))) *
                                       higher_complex_derivative i f z *
                                       higher_complex_derivative (SUC n-i) g z) =
                  vsum (0..n) (\i. Cx(&(binom (n,i))) *
                                   (higher_complex_derivative i f z *
                                    higher_complex_derivative (SUC n-i) g z +
                                    higher_complex_derivative (SUC i) f z *
                                    higher_complex_derivative (n-i) g z))")
      SUBST1_TAC THENL
    [SUBGOAL_THEN
         (← q r"!i. binom(SUC n,i) = binom(n,i) + if i=0 then 0 else binom(n,PRE i)")
       (fun th => tactic_of do
          pure (REWRITE_TAC [th, ← GSYM REAL_OF_NUM_ADD, CX_ADD])) THENL
     [INDUCT_TAC THEN REWRITE_TAC [binom, NOT_SUC, PRE, ADD_SYM, ADD_0],
      REWRITE_TAC [COMPLEX_ADD_LDISTRIB, COMPLEX_ADD_RDISTRIB]] THEN
     SIMP_TAC [VSUM_ADD, FINITE_NUMSEG] THEN BINOP_TAC THENL
     [REWRITE_TAC [VSUM_CLAUSES_NUMSEG, LE_0] THEN
      SUBGOAL_THEN (← q r"binom(n,SUC n)=0") SUBST1_TAC THENL
      [REWRITE_TAC [BINOM_EQ_0] THEN ARITH_TAC, CONV_TAC COMPLEX_RING],
      SIMP_TAC [VSUM_CLAUSES_LEFT, ← SPEC (← q r"SUC n") LE_0] THEN
      REWRITE_TAC [COMPLEX_MUL_LZERO, COMPLEX_ADD_LID, ← GSYM ADD1,
                   VSUM_SUC, o_DEF, SUB_SUC, NOT_SUC, PRE]],
     MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_VSUM THEN
     REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
     MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_LMUL_AT THEN
     MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_MUL_AT THEN
     ASM_SIMP_TAC [ETA_AX, ← ARITH_RULE (← q r"i <= n ==> SUC n - i = SUC (n-i)")] THEN
     ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE]])

  let HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN ← prove
   r"!f g s i z.
     open s /\ f holomorphic_on s /\ g holomorphic_on s /\
     (!w. w IN s ==> f w = g w) /\ z IN s
     ==> higher_complex_derivative i f z = higher_complex_derivative i g z"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN
    REPEAT DISCH_TAC THEN INDUCT_TAC THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [higher_complex_derivative] THEN
    MATCH_MP_TAC COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    ASM_MESON_TAC [HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE])

  let HIGHER_COMPLEX_DERIVATIVE_COMPOSE_LINEAR ← prove
   r"!f u s t n z.
     f holomorphic_on t /\ open s /\ open t /\
     (!w. w IN s ==> u * w IN t) /\ z IN s
     ==> higher_complex_derivative n (\w. f (u * w)) z =
         u pow n * higher_complex_derivative n f (u * z)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN
    REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN INDUCT_TAC THEN
    REWRITE_TAC [higher_complex_derivative, complex_pow, COMPLEX_MUL_LID] THEN
    REPEAT STRIP_TAC THEN EQ_TRANS_TAC
      (← q r"complex_derivative
        (\z. u pow n * higher_complex_derivative n f (u * z)) z") THENL
    [MATCH_MP_TAC COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
     EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC
       (← REWRITE_RULE [o_DEF]
         (← SPECL [← q r"\z:complex. u * z", ← q r"f:complex->complex"]
                HOLOMORPHIC_ON_COMPOSE_GEN)) THEN
      EXISTS_TAC (← q r"t:complex->bool") THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC
       (← REWRITE_RULE [o_DEF]
         (← SPECL [← q r"\w:complex. u:complex", ← q r"\w:complex. w"]
                HOLOMORPHIC_ON_MUL)) THEN
      REWRITE_TAC [HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID],
      MATCH_MP_TAC HOLOMORPHIC_ON_MUL THEN
      SIMP_TAC [HOLOMORPHIC_ON_POW, HOLOMORPHIC_ON_CONST] THEN MATCH_MP_TAC
       (← REWRITE_RULE [o_DEF]
         (← SPECL [← q r"\w. u * w", ← q r"higher_complex_derivative f n"]
                HOLOMORPHIC_ON_COMPOSE_GEN)) THEN
      EXISTS_TAC (← q r"t:complex->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
      [MATCH_MP_TAC
        (← REWRITE_RULE [o_DEF]
          (← SPECL [← q r"\w:complex. u:complex", ← q r"\w:complex. w"]
                 HOLOMORPHIC_ON_MUL)) THEN
       REWRITE_TAC [HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID],
       ASM_SIMP_TAC [HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE]]],
     EQ_TRANS_TAC
       (← q r"u pow n * complex_derivative
          (\z. higher_complex_derivative n f (u * z)) z") THENL
     [MATCH_MP_TAC COMPLEX_DERIVATIVE_LMUL THEN
      MATCH_MP_TAC ANALYTIC_ON_IMP_DIFFERENTIABLE_AT THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] ANALYTIC_ON_COMPOSE_GEN) THEN
      EXISTS_TAC (← q r"t:complex->bool") THEN
      ASM_SIMP_TAC [ANALYTIC_ON_LINEAR, ANALYTIC_HIGHER_COMPLEX_DERIVATIVE,
                    ANALYTIC_ON_OPEN],
      ABBREV_TAC (← q r"a = u:complex pow n") THEN
      REWRITE_TAC [COMPLEX_MUL_AC, COMPLEX_EQ_MUL_LCANCEL] THEN
      ASM_CASES_TAC (← q r"a = Cx(&0)") THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC RAND_CONV [COMPLEX_MUL_SYM] THEN MATCH_MP_TAC
       (← REWRITE_RULE [o_DEF, COMPLEX_DIFFERENTIABLE_LINEAR,
                      COMPLEX_DERIVATIVE_LINEAR]
         (← SPECL [← q r"\w. u * w", ← q r"higher_complex_derivative n f"]
                COMPLEX_DERIVATIVE_CHAIN)) THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT,
                     HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE]]])

  let HIGHER_COMPLEX_DERIVATIVE_ADD_AT ← prove
   r"!f g n z.
     f analytic_on {z} /\ g analytic_on {z}
     ==> higher_complex_derivative n (\w. f w + g w) z =
         higher_complex_derivative n f z +
         higher_complex_derivative n g z"
   (REWRITE_TAC [ANALYTIC_AT_TWO] THEN
    MESON_TAC [HIGHER_COMPLEX_DERIVATIVE_ADD])

  let HIGHER_COMPLEX_DERIVATIVE_SUB_AT ← prove
   r"!f g n z.
     f analytic_on {z} /\ g analytic_on {z}
     ==> higher_complex_derivative n (\w. f w - g w) z =
         higher_complex_derivative n f z -
         higher_complex_derivative n g z"
   (REWRITE_TAC [ANALYTIC_AT_TWO] THEN
    MESON_TAC [HIGHER_COMPLEX_DERIVATIVE_SUB])

  let HIGHER_COMPLEX_DERIVATIVE_NEG_AT ← prove
   r"!f n z.
     f analytic_on {z}
     ==> higher_complex_derivative n (\w. --(f w)) z =
         --(higher_complex_derivative n f z)"
   (REWRITE_TAC [ANALYTIC_AT] THEN
    MESON_TAC [HIGHER_COMPLEX_DERIVATIVE_NEG])

  let HIGHER_COMPLEX_DERIVATIVE_MUL_AT ← prove
   r"!f g n z.
     f analytic_on {z} /\ g analytic_on {z}
     ==> higher_complex_derivative n (\w. f w * g w) z =
         vsum (0..n) (\i. Cx(&(binom(n,i))) *
                          higher_complex_derivative i f z *
                          higher_complex_derivative (n-i) g z)"
   (REWRITE_TAC [ANALYTIC_AT_TWO] THEN
    MESON_TAC [HIGHER_COMPLEX_DERIVATIVE_MUL])

  pure { HIGHER_COMPLEX_DERIVATIVE_EQ_ITER,
         HIGHER_COMPLEX_DERIVATIVE_HIGHER_COMPLEX_DERIVATIVE,
         higher_complex_derivative_alt, HIGHER_COMPLEX_DERIVATIVE_LINEAR,
         HIGHER_COMPLEX_DERIVATIVE_CONST, HIGHER_COMPLEX_DERIVATIVE_ID,
         HAS_COMPLEX_DERIVATIVE_ITER_1, HIGHER_COMPLEX_DERIVATIVE_NEG,
         HIGHER_COMPLEX_DERIVATIVE_ADD, HIGHER_COMPLEX_DERIVATIVE_SUB,
         HIGHER_COMPLEX_DERIVATIVE_MUL, HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN,
         HIGHER_COMPLEX_DERIVATIVE_COMPOSE_LINEAR, HIGHER_COMPLEX_DERIVATIVE_ADD_AT,
         HIGHER_COMPLEX_DERIVATIVE_SUB_AT, HIGHER_COMPLEX_DERIVATIVE_NEG_AT,
         HIGHER_COMPLEX_DERIVATIVE_MUL_AT }

/- ------------------------------------------------------------------------- -/
/- Nonexistence of isolated singularities and a stronger integral formula;   -/
/- formula for higher derivatives.                                           -/
/- (cauchy.ml 8409-8564)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAK where
  NO_ISOLATED_SINGULARITY : thm
  CAUCHY_INTEGRAL_FORMULA_CONVEX : thm
  CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH : thm
  CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAK [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYK : KYK) (BKYL : KYL) (BKYN : KYN) (BKYV : KYV) (BKYAE : KYAE) (BKYAF : KYAF) (BKYAH : KYAH) (BKYAI : KYAI) : ExceptT String IO KYAK := do
  -- @@SCOPE BEGIN
  let { path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { CAUCHY_THEOREM_TRIANGLE_COFINITE, .. } := BKYK
  let { PATHINTEGRAL_CONVEX_PRIMITIVE, .. } := BKYL
  let { CX_2PII_NZ, .. } := BKYN
  let { CAUCHY_INTEGRAL_FORMULA_WEAK, .. } := BKYV
  let { PATH_IMAGE_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH, .. } := BKYAF
  let { CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH, .. } := BKYAH
  let { HOLOMORPHIC_DERIVATIVE, .. } := BKYAI
  let { FINITE_SET_AVOID, .. } := D.qtopology
  let { complex_differentiable, HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN,
        higher_complex_derivative, HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_LMUL_AT, .. } := D.mt.ra.ts.knf
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, .. } := D.mt.ra.ts.knh
  let { COMPLEX_MUL_ASSOC, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_POW_1, CX_INJ, CX_MUL, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_1, .. } := D.mt.ra.ts.cn.cxf
  let { FACT, .. } := D.mt.ra.ts.cn.qsession
  let { ADD_EQ_0, FACT_NZ, .. } := D.mt.ra.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ADD1, ARITH, ARITH_EQ, DIFF_EMPTY, EQ_IMP, FINITE_RULES,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { LEFT_IMP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_IMP_LE, REAL_LT_MIN, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, REAL_OF_NUM_MUL, RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { HULL_MINIMAL, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, INTERIOR_SUBSET, OPEN_BALL, OPEN_CONTAINS_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { FINITE_IMP_CLOSED, OPEN_DIFF, SPHERE_SUBSET_CBALL,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let NO_ISOLATED_SINGULARITY ← prove
   r"!f s k. open s /\ FINITE k /\
           f continuous_on s /\ f holomorphic_on (s DIFF k)
           ==> f holomorphic_on s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_DIFF, FINITE_IMP_CLOSED, IMP_CONJ] THEN
    REWRITE_TAC [← GSYM complex_differentiable] THEN REPEAT DISCH_TAC THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(z:complex) IN k") THEN ASM_SIMP_TAC [IN_DIFF] THEN
    MP_TAC (← ISPECL [← q r"z:complex", ← q r"k:complex->bool"] FINITE_SET_AVOID) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"d:real") THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"f holomorphic_on ball(z,min d e)") MP_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL, CENTRE_IN_BALL, REAL_LT_MIN,
                   complex_differentiable]] THEN
    SUBGOAL_THEN
     (← q r"?g. !w. w IN ball(z,min d e)
              ==> (g has_complex_derivative f w) (at w within ball(z,min d e))")
    MP_TAC THENL
     [ALL_TAC,
      SIMP_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, OPEN_BALL] THEN
      MESON_TAC [HOLOMORPHIC_DERIVATIVE, OPEN_BALL]] THEN
    MATCH_MP_TAC PATHINTEGRAL_CONVEX_PRIMITIVE THEN
    REWRITE_TAC [CONVEX_BALL] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← SET_RULE (← q r"b SUBSET s ==> c SUBSET b ==> c SUBSET s"))) THEN
      REWRITE_TAC [SUBSET, IN_BALL] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE_COFINITE THEN
    EXISTS_TAC (← q r"k:complex->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"w:complex") THEN
      DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
      SPEC_TAC (← q r"w:complex", ← q r"w:complex") THEN ASM_REWRITE_TAC [← GSYM SUBSET] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> (s DIFF k) SUBSET (t DIFF k)")) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"interior s SUBSET s /\ s SUBSET t ==> interior s SUBSET t")) THEN
      REWRITE_TAC [INTERIOR_SUBSET]] THEN
    (MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(z:complex,e)") THEN
     ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(z:complex,min d e)") THEN
     CONJ_TAC THENL
      [MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
       ASM SET_TAC [],
       REWRITE_TAC [SUBSET, IN_BALL] THEN REAL_ARITH_TAC]))

  let CAUCHY_INTEGRAL_FORMULA_CONVEX ← prove
   r"!f s k g z.
        convex s /\ FINITE k /\ f continuous_on s /\
        (!x. x IN interior(s) DIFF k ==> f complex_differentiable at x) /\
        z IN interior(s) /\
        valid_path g /\ (path_image g) SUBSET (s DELETE z) /\
        pathfinish g = pathstart g
        ==> ((\w. f(w) / (w - z)) has_path_integral
             (Cx(&2) * Cx(pi) * ii * winding_number(g,z) * f(z))) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_INTEGRAL_FORMULA_WEAK THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"{}:complex->bool"] THEN
    ASM_REWRITE_TAC [DIFF_EMPTY, FINITE_RULES] THEN
    SIMP_TAC [← GSYM HOLOMORPHIC_ON_OPEN, complex_differentiable, OPEN_INTERIOR] THEN
    MATCH_MP_TAC NO_ISOLATED_SINGULARITY THEN
    EXISTS_TAC (← q r"k:complex->bool") THEN
    ASM_REWRITE_TAC [OPEN_INTERIOR] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [INTERIOR_SUBSET],
      ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_DIFF, FINITE_IMP_CLOSED,
                   OPEN_INTERIOR, ← GSYM complex_differentiable]])

  /- Formula for higher derivatives. -/

  let CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH ← prove
   r"!f z r k w.
        f continuous_on cball(z,r) /\
        f holomorphic_on ball(z,r) /\
        w IN ball(z,r)
        ==> ((\u. f(u) / (u - w) pow (k + 1))
             has_path_integral
             ((Cx(&2) * Cx(pi) * ii) / Cx(&(FACT k)) *
              higher_complex_derivative k f w))
            (circlepath(z,r))"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"&0 < r") THENL
     [ALL_TAC,
      REWRITE_TAC [IN_BALL] THEN
      ASM_MESON_TAC [← NORM_ARITH (← q r"~(&0 < r) ==> ~(dist(a,b) < r)")]] THEN
    INDUCT_TAC THEN REWRITE_TAC [higher_complex_derivative] THENL
     [REWRITE_TAC [ARITH, COMPLEX_POW_1, FACT, COMPLEX_DIV_1] THEN
      ASM_SIMP_TAC [← GSYM COMPLEX_MUL_ASSOC, CAUCHY_INTEGRAL_CIRCLEPATH],
      ALL_TAC] THEN
    MP_TAC (← SPECL
     [← q r"f:complex->complex",
      ← q r"\x. (Cx(&2) * Cx(pi) * ii) / Cx(&(FACT k)) *
           higher_complex_derivative k f x",
      ← q r"z:complex", ← q r"r:real", ← q r"k + 1"] CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH) THEN
    ASM_REWRITE_TAC [ADD1, ← ARITH_RULE (← q r"(k + 1) + 1 = k + 2")] THEN ANTS_TAC THENL
     [REWRITE_TAC [ADD_EQ_0, ARITH_EQ] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"cball(z:complex,r)") THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE, SPHERE_SUBSET_CBALL],
      ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do
      pure (X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
            MP_TAC (← SPEC (← q r"w:complex") th))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [path_integrable_on, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"y:complex") THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(a = Cx(&0)) /\ ~(b = Cx(&0)) /\ x = b / a * y ==> y = a / b * x"))) THEN
    REWRITE_TAC [CX_2PII_NZ, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HAS_COMPLEX_DERIVATIVE_LMUL_AT) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&(FACT k)) / (Cx(&2) * Cx pi * ii)")) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(a = Cx(&0)) /\ ~(b = Cx(&0)) ==> (a / b) * (b / a) * x = x"))) THEN
      REWRITE_TAC [CX_2PII_NZ, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ],
      REWRITE_TAC [FACT, ← GSYM REAL_OF_NUM_MUL, ← GSYM ADD1, CX_MUL] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
       (← q r"z:complex = y /\ ~(d = Cx(&0))
        ==> k / d * k1 * z = (k1 * k) / d * y"))) THEN
      REWRITE_TAC [CX_2PII_NZ] THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
      ASM_REWRITE_TAC []])

  let CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH ← prove
   r"!f z r k w.
        f continuous_on cball(z,r) /\
        f holomorphic_on ball(z,r) /\
        w IN ball(z,r)
        ==> (\u. f(u) / (u - w) pow (k + 1))
                path_integrable_on circlepath(z,r) /\
            higher_complex_derivative k f w =
              Cx(&(FACT k)) / (Cx(&2) * Cx(pi) * ii) *
              path_integral(circlepath(z,r)) (\u. f(u) / (u - w) pow (k + 1))"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP
      CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [path_integrable_on], ALL_TAC] THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(a = Cx(&0)) /\ ~(b = Cx(&0)) /\ x = b / a * y ==> y = a / b * x"))) THEN
    REWRITE_TAC [CX_2PII_NZ, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ] THEN
    MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN ASM_REWRITE_TAC [])

  pure { NO_ISOLATED_SINGULARITY, CAUCHY_INTEGRAL_FORMULA_CONVEX,
         CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH,
         CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- A holomorphic function is analytic, i.e. has local power series.          -/
/- (cauchy.ml 8565-8727)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAL where
  HOLOMORPHIC_POWER_SERIES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAL [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYG : KYG) (BKYN : KYN) (BKYAE : KYAE) (BKYAF : KYAF) (BKYAG : KYAG) (BKYAK : KYAK) : ExceptT String IO KYAL := do
  -- @@SCOPE BEGIN
  let { PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { PATH_INTEGRABLE_COMPLEX_LMUL, PATH_INTEGRABLE_VSUM, PATH_INTEGRAL_COMPLEX_RMUL,
        PATH_INTEGRAL_VSUM, .. } := BKYG
  let { CX_2PII_NZ, .. } := BKYN
  let { PATH_IMAGE_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE, .. } := BKYAF
  let { PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH, .. } := BKYAG
  let { CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH,
        CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH, .. } := BKYAK
  let { SERIES_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { complex_div, complex_pow, SIMPLE_COMPLEX_ARITH, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_SUB_LDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_POW_1, COMPLEX_POW_ADD, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, COMPLEX_INV_MUL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_POW, COMPLEX_POW_DIV,
        .. } := D.mt.ra.ts.cn.cxf
  let { VSUM_COMPLEX_LMUL, VSUM_COMPLEX_RMUL, .. } := D.mt.ra.ts.cn.cxi
  let { VSUM_GP, .. } := D.mt.ra.ts.cn.cxj
  let { FROM_0, .. } := D.mt.ra.ts.cn.ms.qmisc
  let { FACT_NZ, .. } := D.mt.ra.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, NORM_ARITH_TAC,
        REAL_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { EQ_IMP, FINITE_NUMSEG, FORALL_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, INTER_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, REAL_ARCH_POW_INV, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ,
        REAL_LE_MUL2, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LE_TRANS, REAL_LET_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, REAL_LT_MUL, REAL_LT_RDIV_EQ,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, REAL_OF_NUM_EQ, REAL_POW_LE, REAL_POW_LE2, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_NEG, NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VSUM_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BALL_SUBSET_CBALL, BOUNDED_POS, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { IN_BALL, IN_CBALL, IN_SPHERE, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { ALWAYS_EVENTUALLY, .. } := D.mt.ra.ts.cn.ms.ig.dv.qmetric
  let { REAL_POW_MONO_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { LIM_TRANSFORM_EVENTUALLY, sums, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let HOLOMORPHIC_POWER_SERIES ← prove
   r"!f z w r.
     f holomorphic_on ball(z,r) /\ w IN ball(z,r)
     ==> ((\n. higher_complex_derivative n f z / Cx(&(FACT n)) * (w - z) pow n)
          sums f(w)) (from 0)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?r. &0 < r /\ f holomorphic_on cball(z,r) /\ w IN ball(z,r)")
    MP_TAC THENL
     [EXISTS_TAC (← q r"(r + dist(w:complex,z)) / &2") THEN REPEAT CONJ_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
        EXISTS_TAC (← q r"ball(z:complex,r)") THEN ASM_REWRITE_TAC [SUBSET],
        ALL_TAC] THEN
      UNDISCH_TAC (← q r"(w:complex) IN ball(z,r)") THEN
      REWRITE_TAC [IN_BALL, IN_CBALL] THEN NORM_ARITH_TAC,
      ALL_TAC] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"f holomorphic_on ball(z,r) /\ f continuous_on cball(z,r)")
    STRIP_ASSUME_TAC THENL
     [ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN ASM_MESON_TAC [BALL_SUBSET_CBALL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"((\k. path_integral (circlepath(z,r)) (\u. f u / (u - z) pow (k + 1)) *
            (w - z) pow k)
       sums path_integral (circlepath(z,r)) (\u. f u / (u - w))) (from 0)")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(Cx(&2) * Cx(pi) * ii)") o
          MATCH_MP SERIES_COMPLEX_LMUL) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN BINOP_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"k:num") THEN
        MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"z:complex", ← q r"r:real",
                      ← q r"k:num", ← q r"z:complex"]
                     CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH) THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
        DISCH_THEN (SUBST1_TAC o MATCH_MP PATH_INTEGRAL_UNIQUE) THEN
        MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(pit = Cx(&0)) /\ ~(fact = Cx(&0))
          ==> inv(pit) * ((pit / fact) * d) * wz = d / fact * wz"))) THEN
        REWRITE_TAC [CX_2PII_NZ, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ],
        MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"z:complex", ← q r"r:real",
                      ← q r"w:complex"]
          CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (SUBST1_TAC o MATCH_MP PATH_INTEGRAL_UNIQUE) THEN
        MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(x * y * z = Cx(&0)) ==> inv(x * y * z) * x * y * z * w = w"))) THEN
        REWRITE_TAC [CX_2PII_NZ]]] THEN
    REWRITE_TAC [sums, FROM_0, INTER_UNIV] THEN
    MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"\n. path_integral (circlepath(z,r))
                     (\u. vsum (0..n)
                           (\k. f u * (w - z) pow k / (u - z) pow (k + 1)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [] THEN
      W (MP_TAC o PART_MATCH (lhs o rand) PATH_INTEGRAL_VSUM o lhand o snd) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [FINITE_NUMSEG] THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
        ONCE_REWRITE_TAC [← SIMPLE_COMPLEX_ARITH
         (← q r"a * b / c:complex = b * a / c")] THEN
        MATCH_MP_TAC PATH_INTEGRABLE_COMPLEX_LMUL THEN
        ASM_SIMP_TAC [CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH,
                     CENTRE_IN_BALL],
        ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC VSUM_EQ THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a * b / c:complex = a / c * b")] THEN
      MATCH_MP_TAC PATH_INTEGRAL_COMPLEX_RMUL THEN
      ASM_SIMP_TAC [CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH, CENTRE_IN_BALL],
      ALL_TAC] THEN
    MATCH_MP_TAC (← CONJUNCT2
     (← REWRITE_RULE [FORALL_AND_THM,
                     ← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")]
          PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH)) THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN CONJ_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC PATH_INTEGRABLE_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG] THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a * b / c:complex = b * a / c")] THEN
      MATCH_MP_TAC PATH_INTEGRABLE_COMPLEX_LMUL THEN
      ASM_SIMP_TAC [CAUCHY_HIGHER_DERIVATIVE_INTEGRAL_CIRCLEPATH, CENTRE_IN_BALL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE, IN_ELIM_THM] THEN
    SIMP_TAC [VSUM_COMPLEX_LMUL, FINITE_NUMSEG, complex_div] THEN
    REWRITE_TAC [← GSYM COMPLEX_SUB_LDISTRIB, COMPLEX_NORM_MUL] THEN
    REWRITE_TAC [COMPLEX_POW_ADD, COMPLEX_INV_MUL, COMPLEX_POW_1] THEN
    SIMP_TAC [COMPLEX_MUL_ASSOC, VSUM_COMPLEX_RMUL, FINITE_NUMSEG] THEN
    REWRITE_TAC [← GSYM complex_div, ← GSYM COMPLEX_POW_DIV] THEN
    REWRITE_TAC [VSUM_GP, ← CONJUNCT1 LT, ← CONJUNCT1 complex_pow] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    SUBGOAL_THEN
     (← q r"?B. &0 < B /\
          !u:complex. u IN cball(z,r) ==> norm(f u:complex) <= B")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"IMAGE (f:complex->complex) (cball(z,r))")
        COMPACT_IMP_BOUNDED) THEN
      ASM_SIMP_TAC [COMPACT_CONTINUOUS_IMAGE, COMPACT_CBALL] THEN
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?k. &0 < k /\ k <= r /\ norm(w - z) <= r - k /\
                      !u. norm(u - z) = r ==> k <= norm(u - w)")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"r - dist(z:complex,w)") THEN
      REPEAT (POP_ASSUM MP_TAC) THEN REWRITE_TAC [IN_BALL] THEN
      NORM_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [IN_SPHERE, ← NORM_ARITH (← q r"dist(z,x) = r <=> norm(x - z) = r")] THEN
    MP_TAC (← SPECL [← q r"(r - k) / r:real", ← q r"e / B * k:real"] REAL_ARCH_POW_INV) THEN
    ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_DIV, REAL_HALF, REAL_LT_MUL] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"r - k < &1 * r <=> &0 < k")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:complex") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(u:complex = z) /\ ~(u = w)") STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
      MAP_EVERY UNDISCH_TAC [← q r"&0 < r", ← q r"norm(u - z:complex) = r"] THEN
      NORM_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(u = z) /\ ~(u = w) ==> ~((w - z) / (u - z) = Cx(&1))"))] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(u = z) /\ ~(u = w)
      ==> x / (Cx(&1) - (w - z) / (u - z)) / (u - z) = x / (u - w)"))] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(u = w)
      ==> (Cx(&1) - e) / (u - w) - inv(u - w) = --(e / (u - w))"))] THEN
    REWRITE_TAC [COMPLEX_NORM_DIV, NORM_NEG, COMPLEX_NORM_POW] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"B * ((r - k) / r) pow N / k:real") THEN CONJ_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_LT_LDIV_EQ]] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_SIMP_TAC [NORM_POS_LE] THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_CBALL] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REWRITE_TAC [dist, REAL_LE_REFL],
      MATCH_MP_TAC REAL_LE_DIV THEN REWRITE_TAC [NORM_POS_LE] THEN
      MATCH_MP_TAC REAL_POW_LE THEN MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, NORM_POS_LE],
      ALL_TAC] THEN
    REWRITE_TAC [real_div] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
    REWRITE_TAC [← GSYM real_div] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC REAL_POW_LE THEN MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, NORM_POS_LE],
      ALL_TAC,
      REWRITE_TAC [REAL_LE_INV_EQ, NORM_POS_LE],
      MATCH_MP_TAC REAL_LE_INV2 THEN ASM_SIMP_TAC []] THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"((r - k) / r:real) pow (SUC n)") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_POW_LE2 THEN
      ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_LE_DIV, NORM_POS_LE, REAL_LT_IMP_LE],
      MATCH_MP_TAC REAL_POW_MONO_INV THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"N <= n ==> N <= SUC n")] THEN
      ASM_REAL_ARITH_TAC])

  pure { HOLOMORPHIC_POWER_SERIES }
/- ------------------------------------------------------------------------- -/
/- Weak Liouville versions; the Fundamental Theorem of Algebra.              -/
/- (cauchy.ml 8728-8822)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAM where
  LIOUVILLE_WEAK : thm
  LIOUVILLE_WEAK_INVERSE : thm
  FTA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAM [HolBase] (D : CauchyDeps) (BKYAE : KYAE) (BKYAF : KYAF) : ExceptT String IO KYAM := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH, .. } := BKYAF
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { complex_differentiable, holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { COMPLEX_DIFFERENTIABLE_INV_AT, .. } := D.mt.ra.ts.kng
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_POW,
        HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_VSUM, .. } := D.mt.ra.ts.knh
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO,
        COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_POW_ZERO, COMPLEX_VEC_0,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_NZ, .. } := D.mt.ra.ts.cn.cxf
  let { COMPLEX_POLYFUN_EXTREMAL, .. } := D.mt.ra.ts.cn.cxn
  let { LIM_AT_INFINITY, .. } := D.mt.ra.ts.cn.qtopology
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { ADD_CLAUSES, LE_0, VSUM_CLAUSES_LEFT, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH, CONJ_ASSOC, ETA_AX, FINITE_NUMSEG, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_UNIV, LE_1, NOT_EXISTS_THM, NOT_IMP, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_LDIV_EQ, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ,
        REAL_LT_LMUL_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, REAL_OF_NUM_LT, REAL_POS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_ge, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { NORM_NEG, NORM_POS_LE, NORM_TRIANGLE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_CHOOSE_SIZE, VECTOR_SUB, VECTOR_SUB_EQ, VSUM_0,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { INTERIOR_OPEN, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { LIM_NULL, WITHIN_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { tendsto, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { CONVEX_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  /- These weak Liouville versions don't even need the derivative formula. -/

  let LIOUVILLE_WEAK ← prove
   r"!f l. f holomorphic_on (:complex) /\ (f --> l) at_infinity
         ==> !z. f(z) = l"
   (SUBGOAL_THEN
     (← q r"!f.  f holomorphic_on (:complex) /\ (f --> Cx(&0)) at_infinity
           ==> !z. f(z) = Cx(&0)")
    MP_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o ISPEC
        (← q r"\z. (f:complex->complex) z - l")) THEN
      ASM_SIMP_TAC [VECTOR_SUB_EQ, HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_CONST,
                   ETA_AX, ← GSYM LIM_NULL, ← GSYM COMPLEX_VEC_0]] THEN
    REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [← TAUT (← q r"p = ~ ~ p")] THEN
    PURE_REWRITE_TAC [← GSYM COMPLEX_NORM_NZ] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIM_AT_INFINITY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:complex->complex) z) / &2")) THEN
    ASM_REWRITE_TAC [dist, REAL_HALF, COMPLEX_SUB_RZERO] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"z:complex",
                  ← q r"&1 + abs B + norm(z:complex)", ← q r"z:complex"]
                  CAUCHY_INTEGRAL_CIRCLEPATH) THEN
    ASM_SIMP_TAC [CONVEX_UNIV, INTERIOR_OPEN, OPEN_UNIV, IN_UNIV] THEN
    ABBREV_TAC (← q r"R = &1 + abs B + norm(z:complex)") THEN
    SUBGOAL_THEN (← q r"&0 < R") ASSUME_TAC THENL
     [ASM_MESON_TAC [NORM_POS_LE, REAL_ABS_POS, ← REAL_ARITH
       (← q r"&0 <= x /\ &0 <= y ==> &0 < &1 + x + y")], ALL_TAC] THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, NOT_IMP, CONJ_ASSOC] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
                    SUBSET_UNIV],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:complex->complex) z) / &2 / R")) THEN
    ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE, REAL_POS, REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"&0 < R ==> x / R * &2 * pi * R = &2 * pi * x")] THEN
    REWRITE_TAC [NOT_IMP, REAL_NOT_LE] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_SIMP_TAC [COMPLEX_NORM_DIV, REAL_LE_DIV2_EQ] THEN
      MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      UNDISCH_TAC (← q r"norm(x - z:complex) = R") THEN EXPAND_TAC "R" THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"d <= x + z ==> d = &1 + abs b + z ==> x >= b")) THEN
      REWRITE_TAC [VECTOR_SUB] THEN MESON_TAC [NORM_TRIANGLE, NORM_NEG],
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, REAL_ABS_NUM, REAL_ABS_PI,
                  COMPLEX_NORM_II] THEN
      SIMP_TAC [REAL_LT_LMUL_EQ, REAL_OF_NUM_LT, ARITH, PI_POS, REAL_MUL_LID] THEN
      SUBGOAL_THEN (← q r"?w:complex. norm w = abs B") MP_TAC THENL
       [MESON_TAC [VECTOR_CHOOSE_SIZE, REAL_ABS_POS], ALL_TAC] THEN
      ASM_MESON_TAC [NORM_POS_LE, ← REAL_ARITH
       (← q r"abs B >= B /\ (&0 <= x /\ x < z / &2 ==> z / &2 < z)")]])

  let LIOUVILLE_WEAK_INVERSE ← prove
   r"!f. f holomorphic_on (:complex) /\
       (!B. eventually (\x. norm(f x) >= B) at_infinity)
       ==> ?z. f(z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN
    PURE_REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"\x:complex. Cx(&1) / (f(x))", ← q r"Cx(&0)"] LIOUVILLE_WEAK) THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
      (← q r"~(y = Cx(&0)) ==> ~(Cx(&1) / y = Cx(&0))"))] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [holomorphic_on, complex_div, COMPLEX_MUL_LID, IN_UNIV] THEN
      GEN_TAC THEN REWRITE_TAC [← GSYM complex_differentiable, WITHIN_UNIV] THEN
      MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_INV_AT THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [OPEN_UNIV, HOLOMORPHIC_ON_OPEN, IN_UNIV,
                    complex_differentiable],
      REWRITE_TAC [tendsto] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&2/ e")) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      REWRITE_TAC [dist, COMPLEX_SUB_RZERO, real_ge, COMPLEX_NORM_DIV,
                  COMPLEX_NORM_CX, REAL_ABS_POS] THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LE_LDIV_EQ, COMPLEX_NORM_NZ] THEN
      REAL_ARITH_TAC])

  /- In particular we get the Fundamental Theorem of Algebra. -/

  let FTA ← prove
   r"!a n. a(0) = Cx(&0) \/ ~(!k. k IN 1..n ==> a(k) = Cx(&0))
         ==> ?z. vsum(0..n) (\i. a(i) * z pow i) = Cx(&0)"
   (REPEAT STRIP_TAC THENL
     [EXISTS_TAC (← q r"Cx(&0)") THEN
      SIMP_TAC [VSUM_CLAUSES_LEFT, LE_0] THEN
      ASM_SIMP_TAC [ADD_CLAUSES, COMPLEX_POW_ZERO, LE_1, COMPLEX_ADD_LID,
                   COMPLEX_MUL_RZERO, COMPLEX_MUL_LZERO] THEN
      REWRITE_TAC [← GSYM COMPLEX_VEC_0, VSUM_0],
      MATCH_MP_TAC LIOUVILLE_WEAK_INVERSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_VSUM THEN
        SIMP_TAC [FINITE_NUMSEG, HOLOMORPHIC_ON_POW, HOLOMORPHIC_ON_MUL,
                 HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID],
        ASM_MESON_TAC [COMPLEX_POLYFUN_EXTREMAL]]])

  pure { LIOUVILLE_WEAK, LIOUVILLE_WEAK_INVERSE, FTA }
/- ------------------------------------------------------------------------- -/
/- Weierstrass convergence theorem.                                          -/
/- (cauchy.ml 8823-8961)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAN where
  HOLOMORPHIC_UNIFORM_LIMIT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAN [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYG : KYG) (BKYN : KYN) (BKYAE : KYAE) (BKYAF : KYAF) (BKYAG : KYAG) (BKYAH : KYAH) : ExceptT String IO KYAN := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_INTEGRAL, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { HAS_PATH_INTEGRAL_COMPLEX_LMUL, .. } := BKYG
  let { CX_2PII_NZ, .. } := BKYN
  let { PATH_IMAGE_CIRCLEPATH, PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH, .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH, .. } := BKYAF
  let { PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH, .. } := BKYAG
  let { CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH, .. } := BKYAH
  let { DIST_TRIANGLE, .. } := D.qvectors
  let { LIM_COMPLEX_LMUL, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_ON_COMPLEX_DIV, CONTINUOUS_ON_COMPLEX_MUL, CONTINUOUS_ON_COMPLEX_POW,
        .. } := D.mt.ra.ts.knc
  let { holomorphic_on, HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_POW_1, COMPLEX_POW_EQ_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_NZ, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONTINUOUS_UNIFORM_LIMIT, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { ARITH, CONTRAPOS_THM, EQ_IMP, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_SING, MONO_FORALL, NOT_IN_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ,
        REAL_LT_MUL, REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_SUB_0, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { DIST_REFL, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BALL_EMPTY, BALL_SUBSET_CBALL, CBALL_EMPTY, CBALL_SING,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, LIM_UNIQUE, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_on, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { REAL_ABS_NZ, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { LIM_TRANSFORM_EVENTUALLY, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { EVENTUALLY_AND, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qmetric
  let { SPHERE_SUBSET_CBALL, tendsto, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let HOLOMORPHIC_UNIFORM_LIMIT ← prove
   r"!net:(A net) f g z r.
        ~(trivial_limit net) /\
        eventually
           (\n. (f n) continuous_on cball(z,r) /\
                (f n) holomorphic_on ball(z,r))
           net /\
        (!e. &0 < e
             ==> eventually (\n. !x. x IN cball(z,r) ==> norm(f n x - g x) < e)
                            net)
        ==> g continuous_on cball(z,r) /\ g holomorphic_on ball(z,r)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"r <= &0 \/ &0 < r")) THENL
     [ASM_SIMP_TAC [BALL_EMPTY, holomorphic_on, NOT_IN_EMPTY] THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o MATCH_MP (← REAL_ARITH
       (← q r"r <= &0 ==> r < &0 \/ r = &0"))) THEN
      ASM_SIMP_TAC [continuous_on, CBALL_EMPTY, CBALL_SING, NOT_IN_EMPTY] THEN
      SIMP_TAC [IN_SING, DIST_REFL] THEN MESON_TAC [REAL_LT_01],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_UNIFORM_LIMIT THEN
      MAP_EVERY EXISTS_TAC [← q r"net:A net", ← q r"f:A->complex->complex"] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [EVENTUALLY_AND]) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x. Cx(&1) / (Cx(&2) * Cx pi * ii) * g(x:complex)",
      ← q r"g:complex->complex", ← q r"z:complex", ← q r"r:real", ← q r"1"]
       CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH) THEN
    SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
    ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    REWRITE_TAC [ARITH] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
      EXISTS_TAC (← q r"cball(z:complex,r)") THEN ASM_REWRITE_TAC [ETA_AX] THEN
      SIMP_TAC [SPHERE_SUBSET_CBALL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN REWRITE_TAC [COMPLEX_POW_1] THEN
    REWRITE_TAC [complex_div, ← GSYM COMPLEX_MUL_ASSOC] THEN
    REWRITE_TAC [← GSYM complex_div] THEN REWRITE_TAC [COMPLEX_MUL_ASSOC] THEN
    REWRITE_TAC [← GSYM complex_div] THEN REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC] THEN
    SUBGOAL_THEN
     (← q r"(\u. g u / (u - w)) path_integrable_on circlepath(z,r) /\
      ((\n:A. path_integral(circlepath(z,r))
              (\u. f n u / (u - w))) -->
       path_integral(circlepath(z,r)) (\u. g u / (u - w))) net")
    MP_TAC THENL
     [MATCH_MP_TAC PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (fun th => tactic_of do pure (MP_TAC th THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO))) THEN
        X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
        MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH THEN
        ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_DIV THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"cball(z:complex,r)") THEN ASM_REWRITE_TAC [ETA_AX] THEN
          SIMP_TAC [SUBSET, IN_CBALL, IN_ELIM_THM, NORM_SUB, dist, REAL_LE_REFL],
          ALL_TAC] THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_COMPLEX_POW, CONTINUOUS_ON_SUB,
                     CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [COMPLEX_POW_EQ_0, ARITH, IN_ELIM_THM] THEN
        GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        SIMP_TAC [COMPLEX_SUB_0] THEN DISCH_THEN SUBST_ALL_TAC THEN
        ASM_MESON_TAC [IN_BALL, dist, REAL_LT_REFL, DIST_SYM],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e * abs(r - norm(w - z:complex))")) THEN
      SUBGOAL_THEN (← q r"&0 < e * abs(r - norm(w - z:complex))") ASSUME_TAC THENL
       [MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [← GSYM REAL_ABS_NZ] THEN
        SIMP_TAC [REAL_SUB_0] THEN
        ASM_MESON_TAC [IN_BALL, dist, REAL_LT_REFL, DIST_SYM],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:complex") THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [IN_CBALL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
      ASM_REWRITE_TAC [dist, REAL_LE_REFL] THEN
      SUBGOAL_THEN (← q r"~(x:complex = w)") ASSUME_TAC THENL
       [DISCH_THEN SUBST_ALL_TAC THEN
        ASM_MESON_TAC [IN_BALL, dist, NORM_SUB, REAL_LT_REFL],
        ALL_TAC] THEN
      ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(x = w) ==> a / (x - w) - b / (x - w) =
                     (a - b:complex) / (x - w)"))] THEN
      ASM_SIMP_TAC [COMPLEX_NORM_DIV, REAL_LT_LDIV_EQ, COMPLEX_NORM_NZ,
                   COMPLEX_POW_EQ_0, COMPLEX_SUB_0] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> x < a ==> x < b")) THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_IMP_LE, COMPLEX_NORM_POW] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"w < r /\ r <= x + w ==> abs(r - w) <= x")) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [IN_BALL, dist, NORM_SUB], ALL_TAC] THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [← GSYM dist] THEN MESON_TAC [DIST_TRIANGLE],
      ALL_TAC] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_INTEGRAL) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii)") o
      MATCH_MP HAS_PATH_INTEGRAL_COMPLEX_LMUL) THEN
    MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [] THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    MATCH_MP_TAC LIM_UNIQUE THEN
    MAP_EVERY EXISTS_TAC [← q r"net:A net", ← q r"\n. (f:A->complex->complex) n w"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [tendsto, dist] THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      REWRITE_TAC [] THEN ASM_MESON_TAC [SUBSET, BALL_SUBSET_CBALL]] THEN
    SUBGOAL_THEN
     (← q r"((\n:A. Cx(&2) * Cx pi * ii * f n w)
       --> path_integral (circlepath (z,r)) (\u. g u / (u - w))) net")
    MP_TAC THENL
     [MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN EXISTS_TAC
       (← q r"\n:A. path_integral (circlepath (z,r)) (\u. f n u / (u - w))") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (fun th => tactic_of do pure (MP_TAC th THEN
       MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO))) THEN
      X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC CAUCHY_INTEGRAL_CIRCLEPATH THEN
      ASM_REWRITE_TAC [ETA_AX],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii)") o
      MATCH_MP LIM_COMPLEX_LMUL) THEN
    SIMP_TAC [CX_2PII_NZ, ← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(x * y * z = Cx(&0)) ==> Cx(&1) / (x * y * z) * x * y * z * w = w"))])

  pure { HOLOMORPHIC_UNIFORM_LIMIT }
/- ------------------------------------------------------------------------- -/
/- Version showing that the limit is the limit of the derivatives.           -/
/- (cauchy.ml 8962-9076)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAO where
  HAS_COMPLEX_DERIVATIVE_UNIFORM_LIMIT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAO [HolBase] (D : CauchyDeps) (BKYAE : KYAE) (BKYAG : KYAG) (BKYAH : KYAH) (BKYAN : KYAN) : ExceptT String IO KYAO := do
  -- @@SCOPE BEGIN
  let { PATH_IMAGE_CIRCLEPATH, PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH, .. } := BKYAE
  let { PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH, .. } := BKYAG
  let { CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH, .. } := BKYAH
  let { HOLOMORPHIC_UNIFORM_LIMIT, .. } := BKYAN
  let { DIST_TRIANGLE, .. } := D.qvectors
  let { LIM_COMPLEX_MUL, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_ON_COMPLEX_DIV, CONTINUOUS_ON_COMPLEX_POW, .. } := D.mt.ra.ts.knc
  let { COMPLEX_DERIVATIVE_UNIQUE_AT, HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { COMPLEX_MUL_RZERO, COMPLEX_SUB_0, COMPLEX_SUB_LDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_POW_EQ_0, COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_NZ, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, CONTRAPOS_THM, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, MONO_FORALL, REAL_ABS_POS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, REAL_LT_MUL,
        REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_POW_LE2, REAL_POW_LT, REAL_SUB_0, RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, LIM_CONST, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { REAL_ABS_NZ, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { LIM_NULL, LIM_TRANSFORM_EVENTUALLY, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let HAS_COMPLEX_DERIVATIVE_UNIFORM_LIMIT ← prove
   r"!net:(A net) f f' g z r.
        &0 < r /\ ~(trivial_limit net) /\
        eventually
          (\n. (f n) continuous_on cball(z,r) /\
               (!w. w IN ball(z,r)
                    ==> ((f n) has_complex_derivative (f' n w)) (at w)))
          net /\
        (!e. &0 < e
             ==> eventually (\n. !x. x IN cball(z,r) ==> norm(f n x - g x) < e)
                            net)
        ==> g continuous_on cball(z,r) /\
            ?g'. !w. w IN ball(z,r)
                     ==> (g has_complex_derivative (g' w)) (at w) /\
                         ((\n. f' n w) --> g' w) net"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"net:(A)net", ← q r"f:A->complex->complex",
                  ← q r"g:complex->complex", ← q r"z:complex", ← q r"r:real"]
                 HOLOMORPHIC_UNIFORM_LIMIT) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC th THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
          EVENTUALLY_MONO))) THEN
      SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN MESON_TAC [],
      ALL_TAC] THEN
    SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM])) THEN
    REWRITE_TAC [SKOLEM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"g':complex->complex") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [] THEN X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [LIM_NULL] THEN MATCH_MP_TAC LIM_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC
     (← q r"\n. Cx(&1) / (Cx(&2) * Cx pi * ii) *
          (path_integral(circlepath(z,r)) (\x. f (n:A) x / (x - w) pow 2) -
           path_integral(circlepath(z,r)) (\x. g x / (x - w) pow 2))") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC th THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
          EVENTUALLY_MONO))) THEN
      X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
      REWRITE_TAC [COMPLEX_SUB_LDISTRIB] THEN BINOP_TAC THEN
      MATCH_MP_TAC COMPLEX_DERIVATIVE_UNIQUE_AT THENL
       [EXISTS_TAC (← q r"(f:A->complex->complex) a"),
        EXISTS_TAC (← q r"g:complex->complex")] THEN
      EXISTS_TAC (← q r"w:complex") THEN ASM_SIMP_TAC [] THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH o snd) THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
      ANTS_TAC THEN SIMP_TAC [] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [COMPLEX_VEC_0] THEN
    SUBST1_TAC (← SYM (← SPEC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii)") COMPLEX_MUL_RZERO)) THEN
    MATCH_MP_TAC LIM_COMPLEX_MUL THEN REWRITE_TAC [LIM_CONST] THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN REWRITE_TAC [← GSYM LIM_NULL] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
        PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH o snd) THEN
    ANTS_TAC THEN ASM_SIMP_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do pure (MP_TAC th THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO))) THEN
      X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH THEN
      ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
      REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_DIV THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"cball(z:complex,r)") THEN ASM_REWRITE_TAC [ETA_AX] THEN
        SIMP_TAC [SUBSET, IN_CBALL, IN_ELIM_THM, NORM_SUB, dist, REAL_LE_REFL],
        ALL_TAC] THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_COMPLEX_POW, CONTINUOUS_ON_SUB,
                   CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
      REWRITE_TAC [COMPLEX_POW_EQ_0, ARITH, IN_ELIM_THM] THEN
      GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [COMPLEX_SUB_0] THEN DISCH_THEN SUBST_ALL_TAC THEN
      ASM_MESON_TAC [IN_BALL, dist, REAL_LT_REFL, DIST_SYM],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e * abs(r - norm(w - z:complex)) pow 2")) THEN
    SUBGOAL_THEN (← q r"&0 < e * abs(r - norm(w - z:complex)) pow 2") ASSUME_TAC THENL
     [MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_POW_LT THEN REWRITE_TAC [← GSYM REAL_ABS_NZ] THEN
      SIMP_TAC [REAL_SUB_0] THEN
      ASM_MESON_TAC [IN_BALL, dist, REAL_LT_REFL, DIST_SYM],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:complex") THEN
    ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [IN_CBALL] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
    ASM_REWRITE_TAC [dist, REAL_LE_REFL] THEN
    SUBGOAL_THEN (← q r"~(x:complex = w)") ASSUME_TAC THENL
     [DISCH_THEN SUBST_ALL_TAC THEN
      ASM_MESON_TAC [IN_BALL, dist, NORM_SUB, REAL_LT_REFL],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(x = w) ==> a / (x - w) pow 2 - b / (x - w) pow 2 =
                   (a - b:complex) / (x - w) pow 2"))] THEN
    ASM_SIMP_TAC [COMPLEX_NORM_DIV, REAL_LT_LDIV_EQ, COMPLEX_NORM_NZ,
                 COMPLEX_POW_EQ_0, COMPLEX_SUB_0] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a <= b ==> x < a ==> x < b")) THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LT_IMP_LE, COMPLEX_NORM_POW] THEN
    MATCH_MP_TAC REAL_POW_LE2 THEN REWRITE_TAC [REAL_ABS_POS] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"w < r /\ r <= x + w ==> abs(r - w) <= x")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IN_BALL, dist, NORM_SUB], ALL_TAC] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← GSYM dist] THEN MESON_TAC [DIST_TRIANGLE])

  pure { HAS_COMPLEX_DERIVATIVE_UNIFORM_LIMIT }
/- ------------------------------------------------------------------------- -/
/- Uniform sequences; a one-stop shop for an analytic function defined by a  -/
/- series, with local and complex comparison versions.                       -/
/- (cauchy.ml 9077-9269)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAP where
  HOLOMORPHIC_UNIFORM_SEQUENCE : thm
  HAS_COMPLEX_DERIVATIVE_UNIFORM_SEQUENCE : thm
  SERIES_AND_DERIVATIVE_COMPARISON : thm
  SERIES_AND_DERIVATIVE_COMPARISON_LOCAL : thm
  SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX : thm
  SERIES_DIFFERENTIABLE_COMPARISON_COMPLEX : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAP [HolBase] (D : CauchyDeps) (BKYAN : KYAN) (BKYAO : KYAO) : ExceptT String IO KYAP := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_UNIFORM_LIMIT, .. } := BKYAN
  let { HAS_COMPLEX_DERIVATIVE_UNIFORM_LIMIT, .. } := BKYAO
  let { complex_differentiable, HAS_COMPLEX_DERIVATIVE_IMP_CONTINUOUS_AT,
        HAS_COMPLEX_DERIVATIVE_TRANSFORM_AT, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_VSUM, .. } := D.mt.ra.ts.knf
  let { RE_DEF, .. } := D.mt.ra.ts.cn.cxa
  let { REAL_NORM_POS, .. } := D.mt.ra.ts.cn.cxj
  let { INFSUM_UNIQUE, SERIES_COMPARISON_UNIFORM, SERIES_COMPONENT, summable, SUMS_INFSUM,
        .. } := D.mt.ra.ts.cn.qtopology
  let { SUMS_EQ, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, MESON_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, DIMINDEX_2, FORALL_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IN_INTER, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_EXISTS_IMP_THM,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, SWAP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BALL_SUBSET_CBALL, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { IN_BALL, LIM_SEQUENTIALLY, OPEN_BALL, OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTER, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { ALWAYS_EVENTUALLY, .. } := D.mt.ra.ts.cn.ms.ig.dv.qmetric
  let { FINITE_INTER_NUMSEG, .. } := D.mt.ra.ts.cn.ms.ig.dv.qmisc
  let { sums, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  -- @@SCOPE END

  let PAT_CONV : term → ioconv → ioconv := HolMultiLib.RealAnalysis.patConvRZ

  /- Some more simple/convenient versions for applications. -/

  let HOLOMORPHIC_UNIFORM_SEQUENCE ← prove
   r"!f g s.
        open s /\
        (!n. (f n) holomorphic_on s) /\
        (!x. x IN s
             ==> ?d. &0 < d /\ cball(x,d) SUBSET s /\
                     !e. &0 < e
                         ==> eventually (\n. !y. y IN cball(x,d)
                                                 ==> norm(f n y - g y) < e)
                                        sequentially)
        ==> g holomorphic_on s"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"sequentially", ← q r"f:num->complex->complex",
                   ← q r"g:complex->complex", ← q r"z:complex", ← q r"r:real"]
                  HOLOMORPHIC_UNIFORM_LIMIT) THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN ANTS_TAC THENL
     [MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
                    BALL_SUBSET_CBALL],
      SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
      ASM_MESON_TAC [CENTRE_IN_BALL]])

  let HAS_COMPLEX_DERIVATIVE_UNIFORM_SEQUENCE ← prove
   r"!f f' g s.
        open s /\
        (!n x. x IN s ==> ((f n) has_complex_derivative f' n x) (at x)) /\
        (!x. x IN s
             ==> ?d. &0 < d /\ cball(x,d) SUBSET s /\
                     !e. &0 < e
                         ==> eventually (\n. !y. y IN cball(x,d)
                                                 ==> norm(f n y - g y) < e)
                                        sequentially)
        ==> ?g'. !x. x IN s ==> (g has_complex_derivative g'(x)) (at x) /\
                                ((\n. f' n x) --> g'(x)) sequentially"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SKOLEM_THM, RIGHT_EXISTS_IMP_THM] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"sequentially", ← q r"f:num->complex->complex",
                   ← q r"f':num->complex->complex",
                   ← q r"g:complex->complex", ← q r"z:complex", ← q r"r:real"]
                  HAS_COMPLEX_DERIVATIVE_UNIFORM_LIMIT) THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN ANTS_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [CENTRE_IN_BALL]] THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN X_GEN_TAC (← q r"n:num") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_AT_IMP_CONTINUOUS_ON THEN
      ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_IMP_CONTINUOUS_AT, SUBSET],
      ASM_MESON_TAC [BALL_SUBSET_CBALL, SUBSET]])

  /- A one-stop shop for an analytic function defined by a series. -/

  let SERIES_AND_DERIVATIVE_COMPARISON ← prove
   r"!f f' s k h.
     open s /\
     (!n x. n IN k /\ x IN s ==> (f n has_complex_derivative f' n x) (at x)) /\
     (?l. (lift o h sums l) k) /\
     (?N. !n x. N <= n /\ n IN k /\ x IN s ==> norm(f n x) <= h n)
          ==> ?g g'. !x. x IN s
                         ==> ((\n. f n x) sums g x) k /\
                             ((\n. f' n x) sums g' x) k /\
                             (g has_complex_derivative g' x) (at x)"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (MP_TAC o MATCH_MP SERIES_COMPARISON_UNIFORM) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
    REWRITE_TAC [] THEN DISCH_TAC THEN
    REWRITE_TAC [← TAUT (← q r"a ==> b /\ c /\ d <=> (a ==> b) /\ (a ==> d /\ c)")] THEN
    REWRITE_TAC [FORALL_AND_THM, RIGHT_EXISTS_AND_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [sums, LIM_SEQUENTIALLY] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [sums] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_UNIFORM_SEQUENCE THEN
    EXISTS_TAC (← q r"\n x. vsum
      (k INTER (0..n)) (\n. (f:num->complex->complex) n x)") THEN
    ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_VSUM, FINITE_INTER_NUMSEG, IN_INTER] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_CBALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [← GSYM dist] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    ASM_MESON_TAC [SUBSET])

  /- A version where we only have local uniform/comparative convergence. -/

  let SERIES_AND_DERIVATIVE_COMPARISON_LOCAL ← prove
   r"!f f' s k.
     open s /\
     (!n x. n IN k /\ x IN s ==> (f n has_complex_derivative f' n x) (at x)) /\
     (!x. x IN s
          ==> ?d h N. &0 < d /\ (?l. (lift o h sums l) k) /\
                      !n y. N <= n /\ n IN k /\ y IN ball(x,d)
                               ==> norm(f n y) <= h n)
     ==> ?g g'. !x. x IN s
                    ==> ((\n. f n x) sums g x) k /\
                        ((\n. f' n x) sums g' x) k /\
                        (g has_complex_derivative g' x) (at x)"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. infsum k (\n. (f:num->complex->complex) n x)") THEN
    REWRITE_TAC [← GSYM SKOLEM_THM, RIGHT_EXISTS_IMP_THM] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:real", ← q r"h:num->real", ← q r"N:num"] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:num->complex->complex", ← q r"f':num->complex->complex",
                   ← q r"ball(z:complex,d) INTER s", ← q r"k:num->bool", ← q r"h:num->real"]
                  SERIES_AND_DERIVATIVE_COMPARISON) THEN
    ASM_SIMP_TAC [OPEN_INTER, OPEN_BALL, IN_INTER] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") MP_TAC) THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
    REWRITE_TAC [FORALL_AND_THM, RIGHT_EXISTS_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [← GSYM SKOLEM_THM, RIGHT_AND_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [CENTRE_IN_BALL] THEN
    X_GEN_TAC (← q r"g':complex") THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [SUMS_INFSUM, CENTRE_IN_BALL, summable], ALL_TAC] THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_AT THEN
    EXISTS_TAC (← q r"g:complex->complex") THEN
    MP_TAC (← ISPEC (← q r"ball(z:complex,d) INTER s") OPEN_CONTAINS_BALL) THEN
    ASM_SIMP_TAC [OPEN_INTER, OPEN_BALL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [SUBSET, IN_BALL, IN_INTER] THEN
    ASM_MESON_TAC [INFSUM_UNIQUE, SUBSET, IN_BALL, DIST_SYM])

  /- Sometimes convenient to compare with a complex series of +ve reals. -/

  let SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX ← prove
   r"!f f' s k.
     open s /\
     (!n x. n IN k /\ x IN s ==> (f n has_complex_derivative f' n x) (at x)) /\
     (!x. x IN s
          ==> ?d h N. &0 < d /\ summable k h /\
                      (!n. n IN k ==> real(h n) /\ &0 <= Re(h n)) /\
                      (!n y. N <= n /\ n IN k /\ y IN ball(x,d)
                             ==> norm(f n y) <= norm(h n)))
     ==> ?g g'. !x. x IN s
                    ==> ((\n. f n x) sums g x) k /\
                        ((\n. f' n x) sums g' x) k /\
                        (g has_complex_derivative g' x) (at x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SERIES_AND_DERIVATIVE_COMPARISON_LOCAL THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"d:real") THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:num->complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n. norm((h:num->complex) n)") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [summable]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"l:complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"lift(Re l)") THEN MATCH_MP_TAC SUMS_EQ THEN
    EXISTS_TAC (← q r"\i:num. lift(Re(h i))") THEN
    ASM_SIMP_TAC [REAL_NORM_POS, o_DEF] THEN
    REWRITE_TAC [RE_DEF] THEN MATCH_MP_TAC SERIES_COMPONENT THEN
    ASM_REWRITE_TAC [DIMINDEX_2, ARITH])

  let SERIES_DIFFERENTIABLE_COMPARISON_COMPLEX ← prove
   r"!f s k.
     open s /\
     (!n x. n IN k /\ x IN s ==> (f n) complex_differentiable (at x)) /\
     (!x. x IN s
          ==> ?d h N. &0 < d /\ summable k h /\
                      (!n. n IN k ==> real(h n) /\ &0 <= Re(h n)) /\
                      (!n y. N <= n /\ n IN k /\ y IN ball(x,d)
                             ==> norm(f n y) <= norm(h n)))
     ==> ?g. !x. x IN s
                 ==> ((\n. f n x) sums g x) k /\
                      g complex_differentiable (at x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [complex_differentiable, RIGHT_AND_EXISTS_THM] THEN
    GEN_REWRITE_TAC (PAT_CONV (← q r"\x. a /\ x /\ b ==> x") o ONCE_DEPTH_CONV)
     [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
    DISCH_THEN (CHOOSE_THEN (MP_TAC o MATCH_MP
       SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX)) THEN
    MESON_TAC [])

  pure { HOLOMORPHIC_UNIFORM_SEQUENCE, HAS_COMPLEX_DERIVATIVE_UNIFORM_SEQUENCE,
         SERIES_AND_DERIVATIVE_COMPARISON, SERIES_AND_DERIVATIVE_COMPARISON_LOCAL,
         SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX,
         SERIES_DIFFERENTIABLE_COMPARISON_COMPLEX }
/- ------------------------------------------------------------------------- -/
/- In particular, a power series is analytic inside circle of convergence.   -/
/- (cauchy.ml 9270-9430)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAQ where
  POWER_SERIES_AND_DERIVATIVE_0 : thm
  POWER_SERIES_AND_DERIVATIVE : thm
  POWER_SERIES_HOLOMORPHIC : thm
  HOLOMORPHIC_IFF_POWER_SERIES : thm
  POWER_SERIES_ANALYTIC : thm
  ANALYTIC_IFF_POWER_SERIES : thm
  HIGHER_COMPLEX_DERIVATIVE_POWER_SERIES : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAQ [HolBase] (D : CauchyDeps) (BKYAL : KYAL) (BKYAP : KYAP) : ExceptT String IO KYAQ := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_POWER_SERIES, .. } := BKYAL
  let { SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX, .. } := BKYAP
  let { LIMPT_BALL, .. } := D.qtopology
  let { COMPLEX_DIFF_CHAIN_AT, HAS_COMPLEX_DERIVATIVE_TRANSFORM_AT, HOLOMORPHIC_ON_OPEN,
        .. } := D.mt.ra.ts.kne
  let { ANALYTIC_ON_OPEN, .. } := D.mt.ra.ts.kni
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { POWER_SERIES_CONV_IMP_ABSCONV_WEAK, .. } := D.mt.ra.ts.kno
  let { POWER_SERIES_LIMIT_POINT_OF_ZEROS, .. } := D.mt.ra.ts.knr
  let { COMPLEX_MUL_LZERO, COMPLEX_MUL_RID, COMPLEX_SUB_0, COMPLEX_SUB_LZERO,
        COMPLEX_SUB_RDISTRIB, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_VEC_0, CX_MUL, CX_POW, RE_CX, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_MUL, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { REAL_CX, .. } := D.mt.ra.ts.cn.cxi
  let { SERIES_RESTRICT, SERIES_SUB, summable, .. } := D.mt.ra.ts.cn.qtopology
  let { FROM_0, .. } := D.mt.ra.ts.cn.ms.qmisc
  let { SERIES_UNIQUE, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, NORM_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { COND_RAND, COND_RATOR, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IN_UNIV, LEFT_IMP_EXISTS_THM, REAL_ABS_MUL, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_MUL, REAL_LT_IMP_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_POW_LE, REAL_POW_LE2, REAL_SUB_LT, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_NEG, NORM_POS_LE, NORM_SUB, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { IN_BALL, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { REAL_ABS_POW, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  -- ASM_NORM_ARITH_TAC (vectors.ml), local: copied from HolMultiLib/Vectors.lean
  -- because CauchyDeps exposes NORM_ARITH_TAC but not this one.
  let ASM_NORM_ARITH_TAC : tactic :=
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← liftExcept (check (fun (t : thm) => !(HolCore.Basics.is_forall (concl t))) th))))) THEN
    NORM_ARITH_TAC

  let POWER_SERIES_AND_DERIVATIVE_0 ← prove
   r"!k a r. summable k (\n. a(n) * Cx(r) pow n)
           ==> ?g g'.
                  !z. norm(z) < r
                      ==> ((\n. a(n) * z pow n) sums g(z)) k /\
                          ((\n. Cx(&n) * a(n) * z pow (n - 1)) sums g'(z)) k /\
                          (g has_complex_derivative g' z) (at z)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"&0 < r") THEN
    ASM_SIMP_TAC [← NORM_ARITH (← q r"~(&0 < r) ==> ~(norm z < r)")] THEN
    SUBGOAL_THEN (← q r"!z. norm(z) < r <=> z IN ball(Cx(&0),r)")
     (fun th => REWRITE_TAC [th])
    THENL
     [REWRITE_TAC [IN_BALL, dist, COMPLEX_SUB_LZERO, NORM_NEG], ALL_TAC] THEN
    MATCH_MP_TAC SERIES_AND_DERIVATIVE_COMPARISON_COMPLEX THEN
    REWRITE_TAC [OPEN_BALL, IN_BALL, dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN COMPLEX_DIFF_TAC THEN CONV_TAC COMPLEX_RING,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(r - norm(z:complex)) / &2",
      ← q r"\n. Cx(norm(a(n):complex) * ((r + norm(z:complex)) / &2) pow n)",
      ← q r"0"] THEN
    ASM_REWRITE_TAC [REAL_SUB_LT, REAL_HALF, REAL_CX, RE_CX] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [CX_MUL, CX_POW] THEN
      MATCH_MP_TAC POWER_SERIES_CONV_IMP_ABSCONV_WEAK THEN
      EXISTS_TAC (← q r"Cx r") THEN ASM_REWRITE_TAC [] THEN REWRITE_TAC [COMPLEX_NORM_CX],
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
      REWRITE_TAC [NORM_POS_LE] THEN MATCH_MP_TAC REAL_POW_LE,
      REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLEX_NORM_CX, COMPLEX_NORM_MUL] THEN
      REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NORM] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      REWRITE_TAC [COMPLEX_NORM_POW, REAL_ABS_POW] THEN
      MATCH_MP_TAC REAL_POW_LE2] THEN
    ASM_NORM_ARITH_TAC)

  let POWER_SERIES_AND_DERIVATIVE ← prove
   r"!k a r w.
        summable k (\n. a(n) * Cx(r) pow n)
        ==> ?g g'.
             !z. z IN ball(w,r)
                 ==> ((\n. a(n) * (z - w) pow n) sums g(z)) k /\
                     ((\n. Cx(&n) * a(n) * (z - w) pow (n - 1)) sums g'(z)) k /\
                     (g has_complex_derivative g' z) (at z)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP POWER_SERIES_AND_DERIVATIVE_0) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:complex->complex", ← q r"g':complex->complex"] THEN
    DISCH_TAC THEN
    EXISTS_TAC (← q r"(\z. g(z - w)):complex->complex") THEN
    EXISTS_TAC (← q r"(\z. g'(z - w)):complex->complex") THEN
    REWRITE_TAC [IN_BALL, dist] THEN X_GEN_TAC (← q r"z:complex") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z - w:complex")) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [NORM_SUB], ALL_TAC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    GEN_REWRITE_TAC (RATOR_CONV o RAND_CONV) [← GSYM COMPLEX_MUL_RID] THEN
    MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT THEN ASM_REWRITE_TAC [] THEN
    COMPLEX_DIFF_TAC THEN REWRITE_TAC [COMPLEX_SUB_RZERO])

  let POWER_SERIES_HOLOMORPHIC ← prove
   r"!a k f z r. (!w. w IN ball(z,r) ==> ((\n. a(n) * (w - z) pow n) sums f w) k)
               ==> f holomorphic_on ball(z,r)"
   (REPEAT STRIP_TAC THEN SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
    X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [IN_BALL, dist] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"k:num->bool", ← q r"a:num->complex",
                   ← q r"(norm(z - w:complex) + r) / &2", ← q r"z:complex"]
                  POWER_SERIES_AND_DERIVATIVE) THEN
    ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z + Cx((norm(z - w) + r) / &2)")) THEN
      REWRITE_TAC [IN_BALL, dist, ← ExceptT.mk (COMPLEX_RING (← q r"(z + w) - z:complex = w")),
                  ← NORM_ARITH (← q r"norm(z - (z + w)) = norm w"), summable] THEN
      ANTS_TAC THENL [REWRITE_TAC [COMPLEX_NORM_CX], MESON_TAC []] THEN
      POP_ASSUM MP_TAC THEN NORM_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g':complex->complex") (LABEL_TAC "*")) THEN
    EXISTS_TAC (← q r"(g':complex->complex) w") THEN
    MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_AT THEN
    MAP_EVERY EXISTS_TAC
     [← q r"g:complex->complex", ← q r"(r - norm(z - w:complex)) / &2"] THEN
    REPEAT CONJ_TAC THENL
     [UNDISCH_TAC (← q r"norm(z - w:complex) < r") THEN NORM_ARITH_TAC,
      ALL_TAC,
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"w:complex")) THEN ANTS_TAC THENL
       [ALL_TAC, SIMP_TAC []] THEN REWRITE_TAC [IN_BALL] THEN
      UNDISCH_TAC (← q r"norm(z - w:complex) < r") THEN NORM_ARITH_TAC] THEN
    X_GEN_TAC (← q r"u:complex") THEN REWRITE_TAC [dist] THEN DISCH_TAC THEN
    MATCH_MP_TAC SERIES_UNIQUE THEN
    EXISTS_TAC (← q r"(\n. a(n) * (u - z) pow n):num->complex") THEN
    EXISTS_TAC (← q r"k:num->bool") THEN CONJ_TAC THENL
     [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"u:complex")) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []],
      FIRST_X_ASSUM MATCH_MP_TAC] THEN
    REWRITE_TAC [IN_BALL] THEN ASM_NORM_ARITH_TAC)

  let HOLOMORPHIC_IFF_POWER_SERIES ← prove
   r"!f z r. f holomorphic_on ball(z,r) <=>
             !w. w IN ball(z,r)
                 ==> ((\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
                       (w - z) pow n) sums
                      f w)
                     (from 0)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_POWER_SERIES], ALL_TAC] THEN
    MATCH_MP_TAC POWER_SERIES_HOLOMORPHIC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\n. higher_complex_derivative n f z / Cx(&(FACT n))",
      ← q r"from 0"] THEN
    ASM_REWRITE_TAC [])

  let POWER_SERIES_ANALYTIC ← prove
   r"!a k f z r. (!w. w IN ball(z,r) ==> ((\n. a(n) * (w - z) pow n) sums f w) k)
               ==> f analytic_on ball(z,r)"
   (SIMP_TAC [ANALYTIC_ON_OPEN, OPEN_BALL] THEN
    REWRITE_TAC [POWER_SERIES_HOLOMORPHIC])

  let ANALYTIC_IFF_POWER_SERIES ← prove
   r"!f z r. f analytic_on ball(z,r) <=>
             !w. w IN ball(z,r)
                 ==> ((\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
                       (w - z) pow n) sums
                      f w)
                     (from 0)"
   (SIMP_TAC [ANALYTIC_ON_OPEN, OPEN_BALL] THEN
    REWRITE_TAC [HOLOMORPHIC_IFF_POWER_SERIES])

  let HIGHER_COMPLEX_DERIVATIVE_POWER_SERIES ← prove
   r"!f c r n.
        &0 < r /\ n IN k /\
        (!w. dist(w,z) < r ==> ((\i. c i * (w - z) pow i) sums f(w)) k)
        ==> higher_complex_derivative n f z / Cx(&(FACT n)) = c n"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"f holomorphic_on ball(z,r)") ASSUME_TAC THENL
     [MATCH_MP_TAC POWER_SERIES_HOLOMORPHIC THEN
      REWRITE_TAC [IN_BALL] THEN ASM_MESON_TAC [DIST_SYM],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!i. i IN (:num)
          ==> higher_complex_derivative i f z / Cx(&(FACT i)) -
              (if i IN k then c i else vec 0) = Cx(&0)")
    MP_TAC THENL [ALL_TAC, ASM_MESON_TAC [IN_UNIV, COMPLEX_SUB_0]] THEN
    MATCH_MP_TAC POWER_SERIES_LIMIT_POINT_OF_ZEROS THEN MAP_EVERY EXISTS_TAC
     [← q r"\w:complex. Cx(&0)", ← q r"z:complex", ← q r"r:real", ← q r"ball(z:complex,r)"] THEN
    ASM_SIMP_TAC [LIMPT_BALL, CENTRE_IN_CBALL, REAL_LT_IMP_LE] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    REWRITE_TAC [COMPLEX_SUB_RDISTRIB] THEN
    SUBST1_TAC (← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) = (f:complex->complex) w - f w"))) THEN
    MATCH_MP_TAC SERIES_SUB THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM FROM_0] THEN MATCH_MP_TAC HOLOMORPHIC_POWER_SERIES THEN
      ASM_MESON_TAC [IN_BALL, DIST_SYM],
      REWRITE_TAC [COND_RAND, COND_RATOR, COMPLEX_VEC_0] THEN
      REWRITE_TAC [COMPLEX_MUL_LZERO] THEN
      ASM_SIMP_TAC [← GSYM COMPLEX_VEC_0, SERIES_RESTRICT]])

  pure { POWER_SERIES_AND_DERIVATIVE_0, POWER_SERIES_AND_DERIVATIVE,
         POWER_SERIES_HOLOMORPHIC, HOLOMORPHIC_IFF_POWER_SERIES, POWER_SERIES_ANALYTIC,
         ANALYTIC_IFF_POWER_SERIES, HIGHER_COMPLEX_DERIVATIVE_POWER_SERIES }
/- ------------------------------------------------------------------------- -/
/- Taylor series for log. It's this late because we can more easily get      -/
/- a good error bound given the convergence of the series.                   -/
/- (cauchy.ml 9431-9684)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAR where
  CLOG_CONVERGES : thm
  CLOG_CONVERGES_STRONG : thm
  TAYLOR_CLOG : thm
  TAYLOR_CLOG_NEG : thm
  LOG2_APPROX_32 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAR [HolBase] (D : CauchyDeps) (BKYAQ : KYAQ) : ExceptT String IO KYAR := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_IFF_POWER_SERIES, .. } := BKYAQ
  let { LIMPT_OF_OPEN_CLOSURE, SUMS_OFFSET, .. } := D.qtopology
  let { EXPAND_SUM_CONV, .. } := D.mt.ra
  let { LOG_INV, .. } := D.mt.ra.tsd
  let { CONTINUOUS_AT_CLOG, CX_LOG, HOLOMORPHIC_ON_CLOG, .. } := D.mt.ra.tsm
  let { CLOG_1, .. } := D.mt.ra.tsn
  let { LIM_INV_N, .. } := D.mt.ra.tsx
  let { SERIES_BOUND, .. } := D.mt.ra.qtopology
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { SERIES_CX_LIFT, .. } := D.mt.ra.ts.knb
  let { HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN, higher_complex_derivative,
        HOLOMORPHIC_ON_DIFFERENTIABLE, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HOLOMORPHIC_ON_COMPOSE, .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFF_TAC, COMPLEX_DIFFERENTIABLE_TAC, .. } := D.mt.ra.ts.knk
  let { SERIES_DIRICHLET_COMPLEX, SUMS_GP, .. } := D.mt.ra.ts.knn
  let { ABEL_LIMIT_THEOREM, .. } := D.mt.ra.ts.knq
  let { REAL_POW_1_LE, .. } := D.mt.ra.ts.qsession
  let { IN_FROM, .. } := D.mt.ra.ts.qmisc
  let { complex_div, COMPLEX_EQ, complex_pow, SIMPLE_COMPLEX_ARITH,
        .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RID, COMPLEX_MUL_AC, COMPLEX_MUL_ASSOC,
        COMPLEX_MUL_LID, COMPLEX_MUL_LNEG, COMPLEX_MUL_LZERO, COMPLEX_MUL_RID,
        COMPLEX_MUL_RNEG, COMPLEX_NEG_NEG, COMPLEX_SUB_LZERO, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_MUL_RINV, COMPLEX_NORM_CX, COMPLEX_POW_1, COMPLEX_POW_ADD,
        COMPLEX_POW_EQ_0, COMPLEX_POW_MUL, COMPLEX_POW_NEG, COMPLEX_POW_ONE,
        COMPLEX_POW_POW, COMPLEX_VEC_0, CX_ADD, CX_DIV, CX_INJ, CX_INV, CX_MUL, CX_NEG,
        CX_POW, CX_SUB, IM_ADD, IM_CX, IM_NEG, RE_ADD, RE_CX, RE_NEG,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_INV_MUL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_1, COMPLEX_DIV_POW2, COMPLEX_NORM_0, COMPLEX_NORM_DIV,
        COMPLEX_NORM_MUL, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { COMPLEX_NORM_GE_RE_IM, .. } := D.mt.ra.ts.cn.cxg
  let { REAL_CX, REAL_INV_EQ, VSUM_CX, .. } := D.mt.ra.ts.cn.cxi
  let { VSUM_GP, .. } := D.mt.ra.ts.cn.cxj
  let { INFSUM_UNIQUE, summable, .. } := D.mt.ra.ts.cn.qtopology
  let { VSUM_SING_NUMSEG, .. } := D.mt.ra.ts.cn.qvectors
  let { FACT, .. } := D.mt.ra.ts.cn.qsession
  let { FACT_NZ, .. } := D.mt.ra.ts.cn.ms.qsession
  let { LIM_CONTINUOUS_FUNCTION, SERIES_UNIQUE, SUMS_EQ, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON,
        NORM_ARITH, NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, FORALL_IN_GSPEC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNIV, LE_1, LEFT_IMP_EXISTS_THM, REAL_ABS_NUM, REAL_ADD_LID,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_LDIV_EQ, REAL_LE_MUL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_MUL, REAL_POW_ONE, REAL_SUB_LE, RIGHT_IMP_EXISTS_THM, SKOLEM_THM,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { num_INDUCTION, o_DEF, o_THM, real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_LIFT, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { FORALL_LIFT, LIFT_DROP, LIFT_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_NEG, NORM_POS_LE, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_LID, VECTOR_SUB, VECTOR_SUB_EQ, VSUM_NEG,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CLOSURE_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { EVENTUALLY_WITHIN, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, LIM_ADD, LIM_CONST, LIM_UNIQUE, OPEN_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, OPEN_INTERVAL, TRIVIAL_LIMIT_WITHIN, UNIT_INTERVAL_NONEMPTY,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { LIM_COMPOSE_WITHIN, LIM_EVENTUALLY, LIM_TRANSFORM, LIM_VMUL, LIM_WITHIN_ID,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { ADD_SUB, LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  let { REAL_LT_RMUL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let CLOG_CONVERGES ← prove
   r"!z. norm(z) < &1
       ==> ((\n. --Cx(&1) pow (n + 1) * z pow n / Cx(&n)) sums clog(Cx(&1) + z))
           (from 1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"clog o (\z. Cx(&1) + z)", ← q r"Cx(&0)", ← q r"&1"]
          HOLOMORPHIC_IFF_POWER_SERIES) THEN
    REWRITE_TAC [COMPLEX_IN_BALL_0, o_THM] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN CONJ_TAC THENL
       [REWRITE_TAC [HOLOMORPHIC_ON_DIFFERENTIABLE] THEN
        REPEAT STRIP_TAC THEN COMPLEX_DIFFERENTIABLE_TAC,
        MATCH_MP_TAC HOLOMORPHIC_ON_CLOG THEN
        REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, RE_ADD, RE_CX] THEN
        REWRITE_TAC [COMPLEX_IN_BALL_0] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs(Re x) <= norm x /\ norm x < &1 ==> &0 < &1 + Re x")) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"1") o
      MATCH_MP (← REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
    CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [VSUM_SING_NUMSEG] THEN
    REWRITE_TAC [o_DEF, higher_complex_derivative, CLOG_1, COMPLEX_ADD_RID] THEN
    REWRITE_TAC [complex_div, COMPLEX_MUL_LZERO, COMPLEX_SUB_RZERO] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUMS_EQ) THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"(h * f) * z = p * z * g <=> z = Cx(&0) \/ h * f = p * g"))] THEN
    SUBGOAL_THEN
     (← q r"!n w. 1 <= n /\ norm w < &1
            ==> higher_complex_derivative n (\z. clog(Cx(&1) + z)) w =
                --Cx(&1) pow (n + 1) * Cx(&(FACT(n - 1))) / (Cx(&1) + w) pow n")
     (fun th => SIMP_TAC [IN_FROM, COMPLEX_NORM_0, REAL_LT_01, th])
    THENL
     [INDUCT_TAC THEN REWRITE_TAC [ARITH, higher_complex_derivative] THEN
      REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"n = 0") THENL
       [ASM_REWRITE_TAC [higher_complex_derivative] THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
        CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [COMPLEX_POW_1] THEN
        COMPLEX_DIFF_TAC THEN
        REWRITE_TAC [complex_div, COMPLEX_POW_NEG, COMPLEX_ADD_LID] THEN
        REWRITE_TAC [COMPLEX_POW_ONE, ARITH, COMPLEX_MUL_LID] THEN
        DISCH_TAC THEN REWRITE_TAC [RE_ADD, RE_CX] THEN
        MATCH_MP_TAC (← REAL_ARITH
          (← q r"abs(Re x) <= norm x /\ norm x < &1 ==> &0 < &1 + Re x")) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\w. --Cx(&1) pow (n + 1) * Cx(&(FACT(n - 1))) / (Cx(&1) + w) pow n",
          ← q r"ball(Cx(&0),&1)"] THEN
        ASM_SIMP_TAC [OPEN_BALL, LE_1, COMPLEX_IN_BALL_0] THEN
        COMPLEX_DIFF_TAC THEN
        ASM_SIMP_TAC [FACT, ← ARITH_RULE (← q r"~(n = 0) ==> SUC n - 1 = SUC(n - 1)")] THEN
        REWRITE_TAC [COMPLEX_MUL_LZERO, COMPLEX_ADD_LID, COMPLEX_MUL_RID] THEN
        REWRITE_TAC [COMPLEX_POW_ADD, complex_pow, COMPLEX_POW_1] THEN
        REWRITE_TAC [COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG, complex_div,
                    COMPLEX_SUB_LZERO] THEN
        REWRITE_TAC [← GSYM complex_div, COMPLEX_NEG_NEG, COMPLEX_MUL_RID] THEN
        REWRITE_TAC [COMPLEX_MUL_LID] THEN
        REWRITE_TAC [← GSYM (← CONJUNCT2 complex_pow), complex_div] THEN
        REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC] THEN
        ASM_REWRITE_TAC [← GSYM complex_div, COMPLEX_POW_EQ_0] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> p /\ (p ==> q)")] THEN
        SIMP_TAC [COMPLEX_DIV_POW2, COMPLEX_POW_POW] THEN
        ASM_REWRITE_TAC [← ARITH_RULE (← q r"n * 2 <= n - 1 <=> n = 0")] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n = 0) ==> n * 2 - (n - 1) = SUC n")] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n = 0) ==> SUC(n - 1) = n")] THEN
        REWRITE_TAC [complex_div, CX_MUL, ← GSYM REAL_OF_NUM_MUL] THEN
        REWRITE_TAC [COMPLEX_MUL_AC] THEN
        MP_TAC (← SPEC (← q r"&1") COMPLEX_NORM_CX) THEN
        UNDISCH_TAC (← q r"norm(w:complex) < &1") THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN CONV_TAC (fun t => NORM_ARITH t)],
      MATCH_MP_TAC num_INDUCTION THEN REWRITE_TAC [ARITH] THEN
      X_GEN_TAC (← q r"n:num") THEN REPEAT (DISCH_THEN (K ALL_TAC)) THEN DISJ2_TAC THEN
      REWRITE_TAC [FACT, ← ARITH_RULE (← q r"SUC n - 1 = n"), COMPLEX_ADD_RID] THEN
      REWRITE_TAC [COMPLEX_POW_ONE, COMPLEX_DIV_1, ← GSYM REAL_OF_NUM_MUL] THEN
      REWRITE_TAC [CX_MUL, COMPLEX_INV_MUL, ← ExceptT.mk (COMPLEX_RING
       (← q r"(a * f) * i * n = a * i <=> f * n = Cx(&1) \/ a * i = Cx(&0)"))] THEN
      SIMP_TAC [COMPLEX_MUL_RINV, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ]])

  let CLOG_CONVERGES_STRONG ← prove
   r"!z. norm(z) <= &1 /\ ~(z = --Cx(&1))
       ==> ((\n. --Cx(&1) pow (n + 1) * z pow n / Cx(&n)) sums
            clog(Cx(&1) + z)) (from 1)"
   (SUBGOAL_THEN
     (← q r"!z. norm(z) <= &1 /\ ~(z = --Cx(&1))
          ==> summable (from 1) (\n. --Cx(&1) pow (n + 1) * z pow n / Cx(&n))")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [complex_div, COMPLEX_MUL_ASSOC] THEN
      MATCH_MP_TAC SERIES_DIRICHLET_COMPLEX THEN
      MAP_EVERY EXISTS_TAC [← q r"1", ← q r"0"] THEN
      REWRITE_TAC [LIM_INV_N, REAL_INV_EQ, REAL_CX, ← GSYM CX_INV, RE_CX] THEN
      ASM_SIMP_TAC [REAL_LE_INV2, ← GSYM REAL_OF_NUM_ADD, REAL_OF_NUM_LT, LE_1,
                   ← REAL_ARITH (← q r"&n <= &n + &1")] THEN
      REWRITE_TAC [COMPLEX_POW_ADD, ← GSYM COMPLEX_POW_MUL, ← ExceptT.mk (COMPLEX_RING
       (← q r"(a * --Cx(&1) pow 1) * c = --(a * c)"))] THEN
      REWRITE_TAC [VSUM_NEG, COMPLEX_MUL_LNEG, COMPLEX_MUL_LID] THEN
      ASM_REWRITE_TAC [VSUM_GP, ← ExceptT.mk (COMPLEX_RING
        (← q r"--z = Cx(&1) <=> z = --Cx(&1)"))] THEN
      REWRITE_TAC [← CONJUNCT1 complex_pow, ← CONJUNCT1 LT, bounded] THEN
      EXISTS_TAC (← q r"&2 / norm(Cx(&1) + z)") THEN
      REWRITE_TAC [FORALL_IN_GSPEC, ← ExceptT.mk (COMPLEX_RING (← q r"w - --z:complex = w + z"))] THEN
      X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [IN_UNIV] THEN
      REWRITE_TAC [NORM_NEG, COMPLEX_NORM_DIV, real_div] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN
      REWRITE_TAC [REAL_LE_INV_EQ, NORM_POS_LE] THEN MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(x) = &1 /\ norm(y) <= &1 ==> norm(x - y) <= &2")) THEN
      REWRITE_TAC [COMPLEX_NORM_CX, COMPLEX_NORM_POW, REAL_ABS_NUM] THEN
      MATCH_MP_TAC REAL_POW_1_LE THEN ASM_REWRITE_TAC [NORM_NEG, NORM_POS_LE],
      REWRITE_TAC [summable] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"l:complex->complex") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!z. norm z < &1 ==> l z = clog(Cx(&1) + z)") ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CLOG_CONVERGES) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SERIES_UNIQUE) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      DISCH_THEN SUBST_ALL_TAC THEN POP_ASSUM MP_TAC THEN
      REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_NUM, NORM_NEG, REAL_LT_REFL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"norm(z:complex) < &1") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"norm(z:complex) = &1") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"clog(Cx(&1) + z) = l z") (fun th => ASM_MESON_TAC [th]) THEN
    MATCH_MP_TAC (← ISPEC (← q r"at (vec 1:real^1) within interval(vec 0,vec 1)")
          LIM_UNIQUE) THEN
    EXISTS_TAC (← q r"(l:complex->complex) o (\t. drop t % z)") THEN
    REWRITE_TAC [TRIVIAL_LIMIT_WITHIN] THEN
    SIMP_TAC [LIMPT_OF_OPEN_CLOSURE, CLOSURE_INTERVAL, OPEN_INTERVAL,
             UNIT_INTERVAL_NONEMPTY, ENDS_IN_UNIT_INTERVAL] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LIM_TRANSFORM THEN
      EXISTS_TAC (← q r"\t. clog(Cx(&1) + drop t % z)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [VECTOR_SUB_EQ, o_THM, EVENTUALLY_WITHIN] THEN
        EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, FORALL_LIFT] THEN
        REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM, DIST_LIFT] THEN
        X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
        CONV_TAC SYM_CONV THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"norm z = &1 ==> x < &1 * norm z ==> x < &1"))) THEN
        REWRITE_TAC [NORM_MUL] THEN MATCH_MP_TAC REAL_LT_RMUL THEN
        ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC (← ISPEC (← q r"clog") LIM_CONTINUOUS_FUNCTION) THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_AT_CLOG THEN
          REWRITE_TAC [RE_ADD, RE_CX, IM_ADD, IM_CX, REAL_ADD_LID] THEN
          MATCH_MP_TAC (← REAL_ARITH
           (← q r"abs(Re z) <= norm z /\ norm z = &1 /\
            ~(Re z = -- &1 /\ Im z = &0)
            ==> Im z = &0 ==> &0 < &1 + Re z")) THEN
          REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN ASM_REWRITE_TAC [] THEN
          UNDISCH_TAC (← q r"~(z = --Cx(&1))") THEN
          REWRITE_TAC [COMPLEX_EQ, RE_NEG, IM_NEG, RE_CX, IM_CX] THEN
          REAL_ARITH_TAC,
          MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST] THEN
          GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_MUL_LID] THEN
          MATCH_MP_TAC LIM_VMUL THEN
          REWRITE_TAC [LIFT_NUM, o_DEF, LIFT_DROP, LIM_WITHIN_ID]]],
      MATCH_MP_TAC LIM_COMPOSE_WITHIN THEN
      EXISTS_TAC (← q r"{w:complex | norm(z - w) <= &1 * (norm z - norm w)}") THEN
      EXISTS_TAC (← q r"&1 % z:complex") THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC LIM_VMUL THEN
        REWRITE_TAC [LIFT_NUM, o_DEF, LIFT_DROP, LIM_WITHIN_ID],
        REWRITE_TAC [EVENTUALLY_WITHIN, VECTOR_MUL_LID] THEN
        EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_ELIM_THM] THEN
        REWRITE_TAC [FORALL_LIFT, IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM] THEN
        X_GEN_TAC (← q r"t:real") THEN REWRITE_TAC [NORM_MUL, DIST_LIFT] THEN
        STRIP_TAC THEN
        REWRITE_TAC [← VECTOR_ARITH (← q r"z - t % z = (&1 - t) % z")] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x - t * x:real = (&1 - t) * x")] THEN
        REWRITE_TAC [NORM_MUL, REAL_MUL_LID] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
        REWRITE_TAC [NORM_POS_LE] THEN ASM_REAL_ARITH_TAC,
        MP_TAC (← ISPECL
         [← q r"&1", ← q r"from 1", ← q r"\n. --Cx(&1) pow (n + 1) / Cx(&n)", ← q r"z:complex"]
         ABEL_LIMIT_THEOREM) THEN
        REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a / c * b:complex = a * b / c")] THEN
        REWRITE_TAC [REAL_LT_01] THEN ANTS_TAC THENL
         [ASM_MESON_TAC [summable], DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
        REWRITE_TAC [VECTOR_MUL_LID] THEN MATCH_MP_TAC (← MESON [LIM_TRANSFORM]
         (← q r"l = m /\ ((\x. f x - g x) --> vec 0) net
          ==> (f --> l) net ==> (g --> m) net")) THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [MATCH_MP_TAC INFSUM_UNIQUE THEN ASM_MESON_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_WITHIN] THEN
        EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [REAL_MUL_LID] THEN STRIP_TAC THEN
        REWRITE_TAC [VECTOR_SUB_EQ] THEN MATCH_MP_TAC INFSUM_UNIQUE THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN REPEAT STRIP_TAC THEN
        UNDISCH_TAC (← q r"norm(z - w:complex) <= norm(z) - norm(w)") THEN
        ASM_REWRITE_TAC [NORM_NEG, COMPLEX_NORM_CX] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_REWRITE_TAC [← NORM_ARITH (← q r"norm(x - y) <= &0 <=> x = y")] THEN
        CONV_TAC (fun t => NORM_ARITH t)]])

  let TAYLOR_CLOG ← prove
   r"!n z. norm(z) < &1
         ==> norm(clog(Cx(&1) + z) -
                  vsum(1..n) (\k. --Cx(&1) pow (k + 1) * z pow k / Cx(&k)))
             <= norm z pow (n + 1) / (&1 - norm z)"
   (REPEAT STRIP_TAC THEN MP_TAC (← SPEC (← q r"z:complex") CLOG_CONVERGES) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o
      SPEC (← q r"n + 1") o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [ADD_SUB]] THEN
    DISCH_THEN (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          SERIES_BOUND)) THEN
    EXISTS_TAC (← q r"\k. norm(z:complex) pow k") THEN
    REWRITE_TAC [← GSYM SERIES_CX_LIFT, o_DEF, CX_POW, CX_DIV, CX_SUB] THEN
    ASM_SIMP_TAC [COMPLEX_NORM_CX, REAL_ABS_NORM, SUMS_GP] THEN
    X_GEN_TAC (← q r"m:num") THEN REWRITE_TAC [IN_FROM] THEN DISCH_TAC THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_POW, NORM_NEG] THEN
    REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
    REWRITE_TAC [REAL_POW_ONE, REAL_MUL_LID, ← GSYM COMPLEX_NORM_POW] THEN
    SUBGOAL_THEN (← q r"0 < m") ASSUME_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x * (m - &1) ==> x <= x * m")) THEN
    MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [NORM_POS_LE, REAL_SUB_LE] THEN
    ASM_SIMP_TAC [REAL_OF_NUM_LE, LE_1])

  let TAYLOR_CLOG_NEG ← prove
   r"!n z. norm(z) < &1
         ==> norm(clog(Cx(&1) - z) + vsum(1..n) (\k. z pow k / Cx(&k)))
              <= norm z pow (n + 1) / (&1 - norm z)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"n:num", ← q r"--z:complex"] TAYLOR_CLOG) THEN
    ASM_REWRITE_TAC [NORM_NEG] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS) THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN AP_TERM_TAC THEN
    REWRITE_TAC [VECTOR_SUB, ← GSYM VSUM_NEG] THEN AP_TERM_TAC THEN
    REWRITE_TAC [COMPLEX_POW_ADD, COMPLEX_POW_ONE, complex_div] THEN
    REWRITE_TAC [COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG, COMPLEX_POW_1] THEN
    REWRITE_TAC [COMPLEX_MUL_RID, COMPLEX_NEG_NEG] THEN
    REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM COMPLEX_POW_MUL] THEN
    REWRITE_TAC [COMPLEX_MUL_LNEG, COMPLEX_MUL_LID, COMPLEX_NEG_NEG])

  let LOG2_APPROX_32 ← prove
   r"abs(log(&2) - &2977044471 / &4294967296) <= inv(&2 pow 32)"
   (MP_TAC (← SPECL [← q r"35", ← q r"Cx(--inv(&2))"] TAYLOR_CLOG) THEN
    SIMP_TAC [← GSYM CX_DIV, ← GSYM CX_POW, ← GSYM CX_NEG, ← GSYM CX_ADD, ← GSYM CX_MUL,
             VSUM_CX, COMPLEX_NORM_CX, ← GSYM CX_LOG, ← GSYM CX_SUB,
              ← REAL_ARITH (← q r"&0 < &1 + --inv(&2)")] THEN
    CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a * b / c:real = a / c * b")] THEN
    CONV_TAC (ONCE_DEPTH_CONV EXPAND_SUM_CONV) THEN
    CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [real_div, REAL_MUL_LID] THEN
    SIMP_TAC [LOG_INV, ← REAL_ARITH (← q r"&0 < &2")] THEN REAL_ARITH_TAC)

  pure { CLOG_CONVERGES, CLOG_CONVERGES_STRONG, TAYLOR_CLOG, TAYLOR_CLOG_NEG,
         LOG2_APPROX_32 }
/- ------------------------------------------------------------------------- -/
/- Taylor series for arctan.                                                 -/
/- (cauchy.ml 9685-9793)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAS where
  CATN_CONVERGES_STRONG : thm
  CATN_CONVERGES : thm
  TAYLOR_CATN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAS [HolBase] (D : CauchyDeps) (BKYAR : KYAR) : ExceptT String IO KYAS := do
  -- @@SCOPE BEGIN
  let { CLOG_CONVERGES_STRONG, .. } := BKYAR
  let { SUMS_OFFSET, .. } := D.qtopology
  let { REAL_EQ_ADD_RCANCEL_0, .. } := D.qsession
  let { CLOG_DIV_POS, .. } := D.mt.ra.tso
  let { catn, .. } := D.mt.ra.tsp
  let { SERIES_BOUND, SERIES_ODD, .. } := D.mt.ra.qtopology
  let { SERIES_CX_LIFT, .. } := D.mt.ra.ts.knb
  let { SERIES_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { SUMS_GP, .. } := D.mt.ra.ts.knn
  let { NOT_EVEN, REAL_POW_POW, .. } := D.mt.ra.ts.qsession
  let { ABS_SQUARE_LT_1, IN_FROM, .. } := D.mt.ra.ts.qmisc
  let { complex_div, COMPLEX_EQ, COMPLEX_SQNORM, SIMPLE_COMPLEX_ARITH,
        SIMPLE_COMPLEX_ARITH_TAC, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_AC, COMPLEX_MUL_LID, COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG,
        COMPLEX_NEG_NEG, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_POW_1, COMPLEX_POW_ADD, COMPLEX_POW_II_2,
        COMPLEX_POW_MUL, COMPLEX_POW_NEG, COMPLEX_POW_POW, COMPLEX_VEC_0, CX_DIV, CX_MUL,
        CX_POW, CX_SUB, IM_II, IM_NEG, RE_ADD, RE_CX, RE_II, RE_MUL_II, RE_NEG, RE_SUB,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { COMPLEX_NORM_GE_RE_IM, .. } := D.mt.ra.ts.cn.cxg
  let { SERIES_SUB, .. } := D.mt.ra.ts.cn.qtopology
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { ADD_CLAUSES, REAL_ABS_ZERO, REAL_POW_1, REAL_POW_ADD, .. } := D.mt.ra.ts.cn.cx.cpx
  let { COND_SWAP, .. } := D.mt.ra.ts.cn.ms.ig.qsession
  let { ADD1, ARITH_EQ, EQ_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MULT_CLAUSES, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_MUL, REAL_LE_INV2, REAL_LE_RMUL, REAL_LT_IMP_LE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL,
        REAL_POS, REAL_POW2_ABS, REAL_POW_EQ_0, REAL_POW_LE, REAL_POW_ONE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, real_pow, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_EQ_SQUARE, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_NEG, NORM_POS_LE, NORM_POW_2, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { REAL_ABS_ABS, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { ADD_SUB, NOT_ODD, ODD_EXISTS, REAL_ABS_POW,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let CATN_CONVERGES_STRONG ← prove
   r"!z. norm z <= &1 /\ ~(z = ii) /\ ~(z = --ii)
       ==> ((\n. --Cx(&1) pow n / Cx(&(2 * n + 1)) * z pow (2 * n + 1))
            sums catn z) (from 0)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [SERIES_ODD] THEN
    MP_TAC (← ISPEC (← q r"ii * z") CLOG_CONVERGES_STRONG) THEN
    MP_TAC (← ISPEC (← q r"--ii * z") CLOG_CONVERGES_STRONG) THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_II, NORM_NEG] THEN
    ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"ii * z = --Cx(&1) <=> z = ii"))] THEN
    ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"--ii * z = --Cx(&1) <=> z = --ii"))] THEN
    ASM_REWRITE_TAC [REAL_MUL_LID, IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP SERIES_SUB) THEN REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"ii / Cx(&2)") o MATCH_MP SERIES_COMPLEX_LMUL) THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + --ii * z = a - ii * z"))] THEN
    REWRITE_TAC [ADD_CLAUSES, MULT_CLAUSES] THEN
    MATCH_MP_TAC (← MESON [] (← q r"f = g /\ l = m ==> (f sums l) s ==> (g sums m) s")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [FUN_EQ_THM, COMPLEX_POW_ADD, COMPLEX_POW_1, ← SIMPLE_COMPLEX_ARITH
      (← q r"(a * --Cx(&1)) * b / c - (a * --Cx(&1)) * b' / c =
       (a * b' - a * b) / c")] THEN
      X_GEN_TAC (← q r"n:num") THEN
      ONCE_REWRITE_TAC [← GSYM COND_SWAP] THEN REWRITE_TAC [COMPLEX_VEC_0] THEN
      REWRITE_TAC [← GSYM COMPLEX_POW_MUL, COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG] THEN
      REWRITE_TAC [COMPLEX_NEG_NEG, COMPLEX_MUL_LID] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COMPLEX_POW_NEG] THEN
      REWRITE_TAC [NOT_ODD] THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
       [SIMPLE_COMPLEX_ARITH_TAC, ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EVEN]) THEN
      REWRITE_TAC [ODD_EXISTS, LEFT_IMP_EXISTS_THM, ADD1] THEN
      X_GEN_TAC (← q r"m:num") THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * m + 1) DIV 2 = m"), ← SIMPLE_COMPLEX_ARITH
        (← q r"i / Cx(&2) * (--x - x) / y = --i * x / y")] THEN
      REWRITE_TAC [COMPLEX_POW_ADD, COMPLEX_POW_1, complex_div] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"--ii * (x * ii * z) * y = x * y * z"))] THEN
      REWRITE_TAC [COMPLEX_POW_MUL, ← GSYM COMPLEX_POW_POW, COMPLEX_POW_II_2] THEN
      REWRITE_TAC [COMPLEX_MUL_AC],
      REWRITE_TAC [catn] THEN AP_TERM_TAC THEN
      MATCH_MP_TAC (← GSYM CLOG_DIV_POS) THEN
      REWRITE_TAC [RE_SUB, RE_MUL_II, RE_ADD, RE_CX] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"abs x < &1 ==> &0 < &1 - --x /\ &0 < &1 + --x")) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"n <= &1 ==> a <= n /\ (a = &1 ==> ~(n = &1)) ==> a < &1"))) THEN
      REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN
      REWRITE_TAC [NORM_EQ_SQUARE, REAL_POS, ← GSYM NORM_POW_2] THEN
      REWRITE_TAC [COMPLEX_SQNORM] THEN ONCE_REWRITE_TAC [← GSYM REAL_POW2_ABS] THEN
      SIMP_TAC [REAL_POW_ONE, REAL_ABS_NUM, REAL_EQ_ADD_RCANCEL_0] THEN
      REWRITE_TAC [REAL_POW_EQ_0, ARITH_EQ, REAL_ABS_ZERO] THEN
      REPEAT STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl))) THEN
      ASM_REWRITE_TAC [COMPLEX_EQ, RE_II, IM_NEG, IM_II, RE_NEG] THEN
      ASM_REAL_ARITH_TAC])

  let CATN_CONVERGES ← prove
   r"!z. norm(z) < &1
       ==> ((\n. --(Cx(&1)) pow n / Cx(&(2 * n + 1)) * z pow (2 * n + 1))
            sums catn(z)) (from 0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CATN_CONVERGES_STRONG THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
    CONJ_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [NORM_NEG, COMPLEX_NORM_II] THEN REAL_ARITH_TAC)

  let TAYLOR_CATN ← prove
   r"!n z. norm(z) < &1
          ==> norm(catn z -
                   vsum(0..n) (\k. --(Cx(&1)) pow k / Cx(&(2 * k + 1)) *
                                   z pow (2 * k + 1)))
              <= norm(z) pow (2 * n + 3) /
                 ((&2 * &n + &3) * (&1 - norm z pow 2))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CATN_CONVERGES) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"n + 1") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"0 < n + 1"), ADD_SUB] THEN
    MATCH_MP_TAC (← MESON []
      (← q r"(!l. (f sums l) k ==> norm l <= e) ==> (f sums a) k ==> norm a <= e")) THEN
    GEN_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] SERIES_BOUND) THEN
    EXISTS_TAC
      (← q r"\i. norm(z:complex)  / (&2 * &n + &3) * (norm(z) pow 2) pow i") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM SERIES_CX_LIFT, o_DEF] THEN
      MP_TAC (← ISPECL [← q r"n + 1", ← q r"Cx(norm(z:complex) pow 2)"] SUMS_GP) THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_POW, REAL_ABS_NORM,
                      ABS_SQUARE_LT_1, REAL_ABS_ABS] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"Cx(norm(z:complex) / (&2 * &n + &3))") o
          MATCH_MP SERIES_COMPLEX_LMUL) THEN
      REWRITE_TAC [← GSYM CX_POW, ← GSYM CX_SUB, ← GSYM CX_DIV, ← GSYM CX_MUL] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM REAL_POW_POW, REAL_POW_ADD, REAL_POW_1, real_div,
                  REAL_INV_MUL] THEN
      REAL_ARITH_TAC,
      X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [IN_FROM] THEN STRIP_TAC THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_DIV, COMPLEX_NORM_POW] THEN
      REWRITE_TAC [NORM_NEG, COMPLEX_NORM_CX, REAL_ABS_NUM, REAL_POW_ONE] THEN
      GEN_REWRITE_TAC RAND_CONV
       [← REAL_ARITH (← q r"a / b * c:real = inv b * (a * c)")] THEN
      REWRITE_TAC [← GSYM (← CONJUNCT2 real_pow), REAL_POW_POW, ADD1] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN SIMP_TAC [REAL_POW_LE, NORM_POS_LE] THEN
      REWRITE_TAC [REAL_MUL_LID, real_div] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_ADD, REAL_OF_NUM_LE,
                  REAL_OF_NUM_LT, REAL_OF_NUM_MUL] THEN
      ASM_ARITH_TAC])

  pure { CATN_CONVERGES_STRONG, CATN_CONVERGES, TAYLOR_CATN }
