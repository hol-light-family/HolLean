        REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"z:complex") THEN
        ASM_SIMP_TAC [CENTRE_IN_BALL, ← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")],
        ALL_TAC] THEN
      REWRITE_TAC [path_image, ← GSYM IMAGE_o] THEN REWRITE_TAC [← GSYM path_image] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
      REWRITE_TAC [CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM, ← MESON []
       (← q r"(?f s. (P s /\ f = g s) /\ Q f) <=> ?s. P s /\ Q(g s)")] THEN
      REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:real^1->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM, o_THM] THEN
      ASM_CASES_TAC (← q r"k:real^1->bool = {}") THENL
