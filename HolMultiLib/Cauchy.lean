  -- ASSERT_TAC (misc.ml 16), local: CauchyDeps carries no MiscDeps.
  let ASSERT_TAC : term → tactic := fun tm => SUBGOAL_THEN tm STRIP_ASSUME_TAC


  -- EQ_TRANS_TAC (misc.ml 19), local: CauchyDeps carries no MiscDeps.
  let EQ_TRANS_TAC : term → tactic := fun tm =>
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC tm THEN CONJ_TAC

  let SCHWARZ_LEMMA ← (do
    let LEMMA1 ← prove
     r"!f a. open a /\ connected a /\ bounded a /\ ~(a = {}) /\
           f holomorphic_on a /\ f continuous_on (closure a)
           ==> (?w. w IN (frontier a) /\
                    (!z. z IN (closure a) ==> norm (f z) <= norm (f w)))"
     (REPEAT STRIP_TAC THEN ASSERT_TAC
       (← q r"?x. x IN closure a /\
            (!z. z IN closure a ==>
                 norm((f:complex->complex) z) <= norm(f x))") THENL
     [MATCH_MP_TAC CONTINUOUS_ATTAINS_SUP THEN
     ASM_SIMP_TAC [COMPACT_CLOSURE, CLOSURE_EQ_EMPTY] THEN
     SUBGOAL_THEN (← q r"lift o (\x. norm((f:complex->complex) x)) =
                    (lift o norm) o (\x. f x) ") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF], MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
     ASM_REWRITE_TAC [CONTINUOUS_ON_LIFT_NORM, ETA_AX]], ALL_TAC] THEN
     ASM_CASES_TAC (← q r"x:complex IN frontier a") THENL
     [EXISTS_TAC (← q r"x:complex") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
     SUBGOAL_THEN (← q r"x:complex IN interior a") MP_TAC THENL
     [POP_ASSUM MP_TAC THEN REWRITE_TAC [frontier, DIFF] THEN
     SET_TAC [← ASSUME (← q r"x:complex IN closure a")], ALL_TAC] THEN
     ASM_SIMP_TAC [INTERIOR_OPEN] THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"?c. !z. z IN a ==> (f:complex->complex) z = c")
     STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC MAXIMUM_MODULUS_PRINCIPLE THEN
     EXISTS_TAC (← q r"a:complex->bool") THEN
     EXISTS_TAC (← q r"x:complex") THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN GEN_TAC THEN
     DISCH_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [closure, UNION] THEN
     SET_TAC [← ASSUME (← q r"z:complex IN a")], ALL_TAC] THEN
     SUBGOAL_THEN (← q r"CHOICE(frontier(a:complex->bool)) IN frontier a")
     ASSUME_TAC THENL
     [MATCH_MP_TAC CHOICE_DEF THEN MATCH_MP_TAC FRONTIER_NOT_EMPTY THEN
      CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [NOT_BOUNDED_UNIV]],
      ALL_TAC] THEN
     EXISTS_TAC (← q r"CHOICE(frontier(a:complex->bool))") THEN ASM_REWRITE_TAC [] THEN
     REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_EQ_IMP_LE THEN
     SUBGOAL_THEN (← q r"!z. z IN closure a ==> (f:complex->complex) z = c")
     ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"closure (a:complex->bool)",
     ← q r"{c:complex}"] CONTINUOUS_CLOSED_PREIMAGE) THEN
     ASM_REWRITE_TAC [CLOSED_CLOSURE, CLOSED_SING] THEN
     ABBREV_TAC (← q r"s = {x | x IN closure(a:complex->bool) /\
     (f:complex->complex) x IN {c}}") THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"closure a SUBSET (s:complex->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSURE_MINIMAL THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET] THEN EXPAND_TAC "s" THEN
      ASSUME_TAC (← MESON [CLOSURE_SUBSET, ← GSYM SUBSET]
          (← q r"!x:complex. x IN a ==> x IN closure a")) THEN
     SET_TAC [← ASSUME (← q r"!x:complex. x IN a ==> x IN closure a"),
                 ← ASSUME (← q r"!z:complex. z IN a ==> f z = c:complex")],
     ASM_REWRITE_TAC []],
     POP_ASSUM MP_TAC THEN EXPAND_TAC "s" THEN SET_TAC []],
     EQ_TRANS_TAC (← q r"norm(c:complex)") THENL
     [ASM_SIMP_TAC [], ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
     MATCH_MP_TAC (← NORM_ARITH (← q r"!x y:complex. x = y ==> norm x = norm y")) THEN
     FIRST_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [frontier, IN_DIFF]]])
    let LEMMA2 ← prove
     r"!(f:complex->complex) r w s.
         &0 < r /\ f holomorphic_on ball(Cx(&0),r) /\
         &0 < s /\ ball(w,s) SUBSET ball(Cx(&0),r) /\
         (!z. norm (w-z) < s ==> norm(f z) <= norm(f w))
         ==> (?c. !z. norm z < r ==> f z = c)"
     (REPEAT STRIP_TAC THEN
     MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"ball (Cx(&0),r)", ← q r"ball (w:complex,s)",
                   ← q r"w:complex"] MAXIMUM_MODULUS_PRINCIPLE) THEN
     ASM_REWRITE_TAC [OPEN_BALL, CONNECTED_BALL, IN_BALL, DIST_REFL] THEN
     ASM_REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG])
    let LEMMA3 ← prove
     r"!r:real f. f holomorphic_on (ball(Cx(&0),r)) /\ f (Cx(&0))=Cx(&0)
      ==> (?h. h holomorphic_on (ball(Cx(&0),r)) /\
     ((!z. norm z < r ==> f z=z*(h z)) /\
     (complex_derivative f (Cx(&0)))= h (Cx(&0))))"
     (REPEAT STRIP_TAC THEN ABBREV_TAC (← q r"h = \z. if z = Cx(&0) then
     complex_derivative f (Cx(&0)) else f z/z") THEN EXISTS_TAC
     (← q r"h:complex->complex") THEN ASSERT_TAC (← q r"(!z:complex. norm z < r ==>
     (f:complex->complex) z = z * h z) /\ complex_derivative f (Cx(&0))
     = h (Cx(&0))") THENL [CONJ_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN EXPAND_TAC "h" THEN
     COND_CASES_TAC THENL [ASM_REWRITE_TAC [COMPLEX_MUL_LZERO],
     POP_ASSUM MP_TAC THEN CONV_TAC COMPLEX_FIELD],
     EXPAND_TAC "h" THEN ASM_REWRITE_TAC []], ALL_TAC] THEN ASM_REWRITE_TAC []
     THEN MATCH_MP_TAC  POLE_THEOREM_OPEN_0 THEN  EXISTS_TAC (← q r"(f:complex->complex)")
     THEN EXISTS_TAC (← q r"Cx(&0)") THEN
     ASM_SIMP_TAC [OPEN_BALL, IN_BALL, COMPLEX_SUB_RZERO,
      dist, COMPLEX_SUB_LZERO, NORM_NEG])
    prove
     r"!f. f holomorphic_on ball(Cx(&0),&1) /\
         (!z:complex. norm z < &1 ==> norm (f z) < &1) /\
         f(Cx(&0)) = Cx(&0)
         ==> (!z. norm z < &1 ==> norm(f z) <= norm z) /\
             norm(complex_derivative f(Cx(&0))) <= &1 /\
             ((?z. norm z < &1 /\ ~(z= Cx(&0)) /\ norm(f z) = norm z) \/
              norm(complex_derivative f (Cx(&0))) = &1
              ==> ?c. (!z. norm z < &1 ==> f z = c*z) /\ norm c = &1)"
     (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"&1", ← q r"f:complex->complex"] LEMMA3) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN SUBGOAL_THEN
      (← q r"!z. norm z < &1 ==> norm ((h:complex->complex) z) <= &1")
      ASSUME_TAC THENL
    [GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC
    (← prove
     r"!x y:real. (!a. y<a ==> x<a) ==> x <= y"
    (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
    ONCE_REWRITE_TAC [REAL_LT_BETWEEN] THEN REWRITE_TAC [NOT_EXISTS_THM,
    DE_MORGAN_THM] THEN X_GEN_TAC (← q r"z:real") THEN
    POP_ASSUM (MP_TAC o SPEC (← q r"z:real")) THEN REAL_ARITH_TAC)) THEN
    X_GEN_TAC (← q r"a:real") THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"?r. norm (z:complex) < r /\ inv r < a /\ r < &1") MP_TAC THENL
    [SUBGOAL_THEN (← q r"max (inv a) (norm(z:complex)) < &1") MP_TAC THENL
    [ASM_SIMP_TAC [REAL_MAX_LT, REAL_INV_LT_1],
    GEN_REWRITE_TAC LAND_CONV [REAL_LT_BETWEEN] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"r:real")) THEN EXISTS_TAC (← q r"r:real") THEN
    POP_ASSUM MP_TAC THEN ASM_REWRITE_TAC [REAL_MAX_LT] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LT_LINV THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC], ALL_TAC] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL
    [ASM_MESON_TAC [REAL_LET_TRANS, NORM_POS_LE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"inv (r:real) = &1/r") ASSUME_TAC THENL
    [MATCH_MP_TAC REAL_MUL_RINV_UNIQ THEN MATCH_MP_TAC REAL_DIV_LMUL THEN
    ASM_SIMP_TAC [REAL_LT_IMP_NZ], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?w. norm w = r /\ (!z. norm z < r
                      ==> norm((h:complex->complex) z) <= norm(h w))")
                    STRIP_ASSUME_TAC THENL
    [MATCH_MP_TAC (← prove r"!f r. &0 < r /\ f holomorphic_on ball(Cx(&0),r) /\
           f continuous_on cball(Cx(&0),r)
           ==> (?w. norm w = r /\ (!z. norm z < r ==> norm(f z) <= norm(f w)))"
    (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"ball(Cx(&0),r)"] LEMMA1) THEN
    ASM_REWRITE_TAC [OPEN_BALL, CONNECTED_BALL, BOUNDED_BALL, BALL_EQ_EMPTY,
                    ← REAL_ARITH (← q r"!r:real. ~(r <= &0) <=> &0 < r")] THEN
    ASM_SIMP_TAC [CLOSURE_BALL] THEN STRIP_TAC THEN EXISTS_TAC (← q r"w:complex") THEN
    CONJ_TAC THENL
    [UNDISCH_TAC (← q r"w:complex IN frontier(ball(Cx(&0),r))") THEN
    ASM_SIMP_TAC [FRONTIER_BALL, sphere, dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
    SET_TAC [],
    POP_ASSUM MP_TAC THEN
    REWRITE_TAC [IN_CBALL, dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
    MESON_TAC [REAL_LT_IMP_LE]])) THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET
    THEN EXISTS_TAC (← q r"ball(Cx(&0),&1)") THEN
    ASM_SIMP_TAC [SUBSET_BALL, REAL_LT_IMP_LE],
    MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
    MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN EXISTS_TAC (← q r"ball(Cx(&0),&1)") THEN
    ASM_REWRITE_TAC [SUBSET, IN_CBALL, IN_BALL] THEN
    ASM_MESON_TAC [REAL_LET_TRANS]], ALL_TAC] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"norm(h(w:complex):complex)") THEN CONJ_TAC THENL
    [ASM_SIMP_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"h w:complex = f w / w") SUBST1_TAC THENL
    [ASM_SIMP_TAC [] THEN
    MP_TAC (← MESON [← GSYM COMPLEX_NORM_ZERO, REAL_NOT_EQ,
                      ← ASSUME (← q r"norm(w:complex) =r"),
                      ← ASSUME (← q r"&0 < r")] (← q r"~(w=Cx(&0))")) THEN
    CONV_TAC COMPLEX_FIELD,
    ASM_REWRITE_TAC [COMPLEX_NORM_DIV] THEN MATCH_MP_TAC REAL_LT_TRANS THEN
    EXISTS_TAC (← q r"&1/(r:real)") THEN ASM_SIMP_TAC [REAL_LT_DIV2_EQ] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv (r:real)") THEN
    ASM_REWRITE_TAC [REAL_LE_REFL]], ALL_TAC] THEN
    CONJ_TAC THENL
    [GEN_TAC THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"z = Cx(&0)") THENL
    [ASM_SIMP_TAC [COMPLEX_MUL_LZERO, REAL_LE_REFL],
    SUBST1_TAC (← REAL_ARITH (← q r"norm (z:complex) = norm z * &1")) THEN
    ASM_SIMP_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_SIMP_TAC [NORM_POS_LE]], ALL_TAC] THEN CONJ_TAC THENL
    [ASM_MESON_TAC [COMPLEX_NORM_ZERO, REAL_LT_01], ALL_TAC] THEN
    REWRITE_TAC [← TAUT (← q r"((p \/ q) ==> r) <=> ((p ==> r) /\ (q ==> r))")] THEN
    CONJ_TAC THENL [STRIP_TAC THEN SUBGOAL_THEN
     (← q r"norm ((h:complex->complex) z) = &1") ASSUME_TAC THENL
    [SUBGOAL_THEN (← q r"(h:complex->complex) z = f z/z") SUBST1_TAC THENL
    [UNDISCH_THEN (← q r"!z:complex. norm z < &1  ==> f z = z * h z")
    (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"~(z = Cx(&0))") THEN CONV_TAC COMPLEX_FIELD,
    ASM_SIMP_TAC [COMPLEX_NORM_ZERO, REAL_DIV_REFL, COMPLEX_NORM_DIV]],
    SUBGOAL_THEN (← q r"?c. (!z. norm z < &1 ==> (h:complex->complex) z = c)")
    STRIP_ASSUME_TAC THENL [MATCH_MP_TAC LEMMA2
    THEN EXISTS_TAC (← q r"z:complex") THEN EXISTS_TAC (← q r"&1 - norm(z:complex)")
    THEN ASM_REWRITE_TAC [REAL_LT_01] THEN CONJ_TAC THENL
    [ASM_MESON_TAC [REAL_SUB_LT], CONJ_TAC THENL
    [REWRITE_TAC [SUBSET, IN_BALL] THEN GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"dist(Cx(&0), z) + dist(z,x)") THEN
    REWRITE_TAC [DIST_TRIANGLE] THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN REAL_ARITH_TAC,
    GEN_TAC THEN DISCH_TAC THEN FIRST_ASSUM MATCH_MP_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"norm(z:complex) + norm(z' - z)") THEN
    REWRITE_TAC [NORM_TRIANGLE_SUB] THEN REWRITE_TAC [NORM_SUB] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [NORM_SUB] THEN REAL_ARITH_TAC]],
    EXISTS_TAC (← q r"c:complex") THEN CONJ_TAC THENL
    [ASM_SIMP_TAC [COMPLEX_MUL_SYM],
    POP_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_MESON_TAC []]]],
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"?c. (!z. norm z < &1 ==> (h:complex->complex) z = c)")
    STRIP_ASSUME_TAC THENL [MATCH_MP_TAC LEMMA2 THEN EXISTS_TAC (← q r"Cx(&0)")
    THEN EXISTS_TAC (← q r"&1") THEN ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < &1"),
    SUBSET_REFL, COMPLEX_SUB_LZERO, NORM_NEG],
    EXISTS_TAC (← q r"c:complex") THEN CONJ_TAC THENL
    [ASM_SIMP_TAC [COMPLEX_MUL_SYM], POP_ASSUM (MP_TAC o SPEC (← q r"Cx(&0)")) THEN
    ASM_MESON_TAC [COMPLEX_NORM_0, REAL_LT_01]]]]))

  let HOLOMORPHIC_SUBORDINATION ← prove
   r"!f g a r s.
        r <= s /\ f a = g a /\
        f holomorphic_on ball(a,s) /\ g holomorphic_on ball(a,s) /\
        (!w z. w IN ball(a,s) /\ z IN ball(a,s) /\ g w = g z ==> w = z) /\
        IMAGE f (ball(a,s)) SUBSET IMAGE g (ball(a,s))
        ==> IMAGE f (ball(a,r)) SUBSET IMAGE g (ball(a,r))"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"r < &0") THEN
    ASM_SIMP_TAC [BALL_EMPTY, REAL_LT_IMP_LE, IMAGE_CLAUSES, EMPTY_SUBSET] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP, REAL_NOT_LT] THEN
    ASM_CASES_TAC (← q r"s = &0") THEN
    ASM_SIMP_TAC [CONJ_ASSOC, ← ONCE_REWRITE_RULE [CONJ_SYM] REAL_LE_ANTISYM] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 < s") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:complex->complex", ← q r"ball(a:complex,s)"]
          HOLOMORPHIC_ON_INVERSE) THEN
    ASM_REWRITE_TAC [OPEN_BALL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:complex->complex") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o GEN_REWRITE_RULE id [INJECTIVE_ON_ALT]) THEN
    MP_TAC (← SPEC
     (← q r"(\z. (z - a) / Cx s) o (h:complex->complex) o
      (f:complex->complex) o (\z. a + Cx s * z)") SCHWARZ_LEMMA) THEN
    REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        SIMP_TAC [complex_div, HOLOMORPHIC_ON_RMUL, HOLOMORPHIC_ON_SUB,
                 HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST, o_ASSOC] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        SIMP_TAC [HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_ADD,
                 HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN CONJ_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOLOMORPHIC_ON_SUBSET)) THEN
        ONCE_REWRITE_TAC [COMPLEX_ADD_SYM] THEN
        ASM_REWRITE_TAC [← GSYM COMPLEX_CMUL, IMAGE_AFFINITY_BALL] THEN
        REWRITE_TAC [COMPLEX_CMUL, COMPLEX_MUL_RZERO, COMPLEX_ADD_LID] THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_MUL_RID, SUBSET_REFL],
        SIMP_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_CX] THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ] THEN
        REWRITE_TAC [REAL_MUL_LID, ← GSYM (← ONCE_REWRITE_RULE [DIST_SYM] dist)] THEN
        REWRITE_TAC [← GSYM IN_BALL] THEN X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(a + Cx s * z) IN ball(a:complex,s)") ASSUME_TAC THENL
         [ALL_TAC, ASM SET_TAC []] THEN
        REWRITE_TAC [IN_BALL, ← NORM_ARITH (← q r"dist(a:complex,a + x) = norm x")] THEN
        REWRITE_TAC [COMPLEX_NORM_CX, COMPLEX_NORM_MUL] THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"&0 < s ==> s * z < s * &1 ==> abs s * z < s"))) THEN
        ASM_SIMP_TAC [REAL_LT_LMUL_EQ],
        REWRITE_TAC [COMPLEX_DIV_EQ_0] THEN DISJ1_TAC THEN
        ASM_REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_ADD_RID, COMPLEX_SUB_0] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL]],
      DISCH_THEN (LABEL_TAC "*" o CONJUNCT1) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"z:complex") THEN
      REWRITE_TAC [IN_BALL, dist, IN_IMAGE] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(h:complex->complex) (f(z:complex))") THEN CONJ_TAC THENL
       [CONV_TAC SYM_CONV THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN_BALL, dist] THEN
        ASM_REAL_ARITH_TAC,
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"(z - a) / Cx s")) THEN
        REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_CX] THEN
        ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_LE_DIV2_EQ] THEN
        ASM_SIMP_TAC [REAL_LT_LDIV_EQ, REAL_MUL_LID] THEN
        ONCE_REWRITE_TAC [NORM_SUB] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"a <= x /\ y < b ==> x <= y ==> a < b")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"y:real^2 = x ==> norm(x - a) <= norm(a - y)")) THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [← GSYM CX_INJ]) THEN
        CONV_TAC COMPLEX_FIELD]])

  pure { SCHWARZ_LEMMA, HOLOMORPHIC_SUBORDINATION }
/- ------------------------------------------------------------------------- -/
/- The Schwarz reflection principle.                                         -/
/- (cauchy.ml 15402-15702)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBN where
  HOLOMORPHIC_ON_PASTE_ACROSS_LINE : thm
  SCHWARZ_REFLECTION : thm
  SCHWARZ_REFLECTION_UNIQUE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBN [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYG : KYG) (BKYH : KYH) (BKYJ : KYJ) (BKYL : KYL) (BKYAI : KYAI) (BKYBC : KYBC) : ExceptT String IO KYBN := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_INTEGRABLE, PATH_INTEGRAL_REVERSEPATH, PATH_INTEGRAL_UNIQUE,
        .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, PATH_INTEGRAL_JOIN, VALID_PATH_JOIN_EQ, .. } := BKYD
  let { VALID_PATH_LINEPATH, .. } := BKYE
  let { PATH_INTEGRABLE_CONTINUOUS_LINEPATH, .. } := BKYG
  let { HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL, PATH_INTEGRAL_SPLIT_LINEPATH, .. } := BKYH
  let { CAUCHY_THEOREM_TRIANGLE_INTERIOR, .. } := BKYJ
  let { CAUCHY_THEOREM_CONVEX, .. } := BKYL
  let { MORERA_LOCAL_TRIANGLE, .. } := BKYAI
  let { ANALYTIC_CONTINUATION, .. } := BKYBC
  let { INTERIOR_HALFSPACE_GE, LIMPT_OF_OPEN, .. } := D.qtopology
  let { REVERSEPATH_LINEPATH, .. } := D.qpaths
  let { CONNECTED_IVT_HYPERPLANE, .. } := D.mt.qtopology
  let { CONVEX_CONTAINS_SEGMENT_EQ, .. } := D.mt.qconvex
  let { CLOSED_HALFSPACE_IM_GE, CLOSED_HALFSPACE_IM_LE, OPEN_HALFSPACE_IM_GT,
        .. } := D.mt.ra.ts.kna
  let { complex_differentiable, holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_WITHIN, .. } := D.mt.ra.ts.knf
  let { HOLOMORPHIC_EQ, .. } := D.mt.ra.ts.kng
  let { HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { ANALYTIC_IMP_HOLOMORPHIC, .. } := D.mt.ra.ts.kni
  let { CONTINUOUS_ON_CNJ, .. } := D.mt.ra.ts.knm
  let { IM_DEF, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { CNJ_CNJ, CNJ_DIV, CNJ_SUB, COMPLEX_NORM_CNJ, FORALL_CNJ, IM_CNJ,
        .. } := D.mt.ra.ts.cn.cxg
  let { real, REAL_CNJ, .. } := D.mt.ra.ts.cn.cxi
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, DIFF_EMPTY, DIMINDEX_2, EMPTY_SUBSET, EQ_IMP, FINITE_EMPTY,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, IMP_CONJ, INSERT_SUBSET, INTER_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTER, MONO_EXISTS, MONO_FORALL, MONO_IMP, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_NEG2, REAL_LE_REFL, REAL_LE_TOTAL, REAL_LT_IMP_LE, REAL_LT_NEG2,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, RIGHT_EXISTS_AND_THM, SUBSET, SUBSET_INTER,
        SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, real_ge, real_gt, UNION_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_MINIMAL, SUBSET_HULL, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { BASIS_NONZERO, DOT_BASIS, DOT_LNEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { dist, VECTOR_NEG_EQ_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, CLOSED_IN_CLOSED_INTER, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONNECTED_SEGMENT, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { INTERIOR_INTER, INTERIOR_OPEN, LIM_WITHIN, OPEN_BALL, OPEN_CONTAINS_BALL,
        OPEN_HALFSPACE_GT, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_HALFSPACE_LT, OPEN_INTER, SEGMENT_SYM, SUBSET_INTERIOR,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH, PATHFINISH_JOIN, PATHFINISH_LINEPATH,
        PATHSTART_JOIN, PATHSTART_LINEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONTINUOUS_ON_CASES_LOCAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { INTERIOR_HALFSPACE_LE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  let { CONVEX_BALL, CONVEX_CONTAINS_SEGMENT, CONVEX_HALFSPACE_GE, CONVEX_HALFSPACE_LE,
        CONVEX_INTER, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let HOLOMORPHIC_ON_PASTE_ACROSS_LINE ← (do
    let lemma0 ← prove
     r"!d a b:real^N k.
            d dot a <= k /\ k <= d dot b
            ==> ?c. c IN segment[a,b] /\ d dot c = k /\
                    (!z. z IN segment[a,c] ==> d dot z <= k) /\
                    (!z. z IN segment[c,b] ==> k <= d dot z)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"segment[a:real^N,b]", ← q r"a:real^N", ← q r"b:real^N",
                     ← q r"d:real^N", ← q r"k:real"] CONNECTED_IVT_HYPERPLANE) THEN
      ASM_REWRITE_TAC [CONNECTED_SEGMENT, ENDS_IN_SEGMENT] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real^N") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [← SET_RULE
       (← q r"(!z. z IN s ==> P z) <=> s SUBSET {x | P x}")] THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN CONJ_TAC THEN
      MATCH_MP_TAC HULL_MINIMAL THEN
      REWRITE_TAC [CONVEX_HALFSPACE_LE, ← REWRITE_RULE [real_ge] CONVEX_HALFSPACE_GE,
                  SUBSET, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL])
    let lemma1 ← prove
     r"!f s d k a b c.
            convex s /\ open s /\ a IN s /\ b IN s /\ c IN s /\ ~(d = vec 0) /\
            d dot a <= k /\ d dot b <= k /\ d dot c <= k /\
            f holomorphic_on {z | z IN s /\ d dot z < k} /\
            f holomorphic_on {z | z IN s /\ k < d dot z} /\
            f continuous_on s
            ==> path_integral (linepath (a,b)) f +
                path_integral (linepath (b,c)) f +
                path_integral (linepath (c,a)) f = Cx(&0)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
            CAUCHY_THEOREM_TRIANGLE_INTERIOR) THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"s:complex->bool") THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HULL_MINIMAL THEN ASM SET_TAC [],
          MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
          EXISTS_TAC (← q r"{z:complex | z IN s /\ d dot z < k}") THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
          EXISTS_TAC (← q r"interior(s INTER {x:complex | d dot x <= k})") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC HULL_MINIMAL THEN
            ASM_SIMP_TAC [CONVEX_INTER, CONVEX_HALFSPACE_LE] THEN ASM SET_TAC [],
            ASM_SIMP_TAC [INTERIOR_INTER, INTERIOR_HALFSPACE_LE,
                         INTERIOR_OPEN] THEN
            SET_TAC []]],
        REWRITE_TAC [HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL]])
    let lemma2 ← prove
     r"!f s d k a b c.
            convex s /\ open s /\ a IN s /\ b IN s /\ c IN s /\ ~(d = vec 0) /\
            d dot a <= k /\ d dot b <= k /\
            f holomorphic_on {z | z IN s /\ d dot z < k} /\
            f holomorphic_on {z | z IN s /\ k < d dot z} /\
            f continuous_on s
            ==> path_integral (linepath (a,b)) f +
                path_integral (linepath (b,c)) f +
                path_integral (linepath (c,a)) f = Cx(&0)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(d:complex) dot c <= k") THENL
       [MATCH_MP_TAC lemma1 THEN ASM_MESON_TAC [], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [REAL_NOT_LE]) THEN
      MP_TAC (← ISPECL [← q r"d:complex", ← q r"b:complex", ← q r"c:complex", ← q r"k:real"]
            lemma0) THEN
      MP_TAC (← ISPECL [← q r"d:complex", ← q r"a:complex", ← q r"c:complex", ← q r"k:real"]
            lemma0) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a':complex") STRIP_ASSUME_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b':complex") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(a':complex) IN s /\ b' IN s") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SEGMENT_SYM, SUBSET],
        ALL_TAC] THEN
      MP_TAC (← SPECL
       [← q r"f:complex->complex", ← q r"c:complex", ← q r"a:complex", ← q r"a':complex"]
            PATH_INTEGRAL_SPLIT_LINEPATH) THEN
      MP_TAC (← SPECL
       [← q r"f:complex->complex", ← q r"b:complex", ← q r"c:complex", ← q r"b':complex"]
            PATH_INTEGRAL_SPLIT_LINEPATH) THEN
      ASM_REWRITE_TAC [] THEN REPEAT (ANTS_TAC THENL
       [ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, SEGMENT_SYM,
                      CONTINUOUS_ON_SUBSET],
        ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")]]) THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"linepath(a':complex,b')"]
            PATH_INTEGRAL_REVERSEPATH) THEN
      REWRITE_TAC [REVERSEPATH_LINEPATH, VALID_PATH_LINEPATH] THEN ANTS_TAC THENL
       [MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
        ASM_MESON_TAC [CONVEX_CONTAINS_SEGMENT, CONTINUOUS_ON_SUBSET],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s INTER {x:complex | d dot x <= k}",
                     ← q r"{}:complex->bool",
                     ← q r"linepath(a:complex,b) ++ linepath(b,b') ++
                      linepath(b',a') ++ linepath(a',a)"]
            CAUCHY_THEOREM_CONVEX) THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s INTER {x:complex | k <= d dot x}",
                     ← q r"{}:complex->bool",
                     ← q r"linepath(b':complex,c) ++ linepath(c,a') ++
                      linepath(a',b')"]
            CAUCHY_THEOREM_CONVEX) THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(q /\ q' ==> r) /\ (p /\ p') ==> (p ==> q) ==> (p' ==> q') ==> r")) THEN
      CONJ_TAC THENL
       [DISCH_THEN (CONJUNCTS_THEN
         (fun th => tactic_of do pure (MP_TAC (← MATCH_MP PATH_INTEGRAL_UNIQUE th) THEN
                    MP_TAC (← MATCH_MP HAS_PATH_INTEGRAL_INTEGRABLE th)))),
        ASM_SIMP_TAC [DIFF_EMPTY, INTERIOR_INTER, INTERIOR_HALFSPACE_LE,
                     ← REWRITE_RULE [real_ge] INTERIOR_HALFSPACE_GE] THEN
        ASM_SIMP_TAC [CONVEX_INTER, CONVEX_HALFSPACE_LE, FINITE_EMPTY,
                     ← REWRITE_RULE [real_ge] CONVEX_HALFSPACE_GE]] THEN
      SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN_EQ,
               PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_JOIN,
               VALID_PATH_LINEPATH, PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
               PATH_INTEGRAL_JOIN]
      THENL [CONV_TAC COMPLEX_RING, ALL_TAC] THEN
      REWRITE_TAC [PATH_IMAGE_LINEPATH, UNION_SUBSET, SUBSET_INTER] THEN
      ASM_SIMP_TAC [(← EQ_IMP_RULE (← SPEC_ALL CONVEX_CONTAINS_SEGMENT_EQ)).1,
                 CONVEX_HALFSPACE_LE, ← REWRITE_RULE [real_ge] CONVEX_HALFSPACE_GE,
                   IN_ELIM_THM, REAL_LT_IMP_LE, REAL_LE_REFL] THEN
      ASM_SIMP_TAC [complex_differentiable, ← GSYM HOLOMORPHIC_ON_OPEN,
                   OPEN_INTER, INTERIOR_OPEN, OPEN_HALFSPACE_LT,
                   OPEN_HALFSPACE_GT] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← SET_RULE
       (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")]) THEN
      ASM_REWRITE_TAC [real_gt] THEN
      ASM_MESON_TAC [INTER_SUBSET, CONTINUOUS_ON_SUBSET])
    let lemma3 ← prove
     r"!f s d k a b c.
            convex s /\ open s /\ a IN s /\ b IN s /\ c IN s /\ ~(d = vec 0) /\
            d dot a <= k /\
            f holomorphic_on {z | z IN s /\ d dot z < k} /\
            f holomorphic_on {z | z IN s /\ k < d dot z} /\
            f continuous_on s
            ==> path_integral (linepath (a,b)) f +
                path_integral (linepath (b,c)) f +
                path_integral (linepath (c,a)) f = Cx(&0)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(d:complex) dot b <= k") THENL
       [MATCH_MP_TAC lemma2 THEN ASM_MESON_TAC [], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"(d:complex) dot c <= k") THENL
       [ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + b + c:complex = c + a + b"))] THEN
        MATCH_MP_TAC (← GEN_ALL lemma2) THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + b + c:complex = b + c + a"))] THEN
      MATCH_MP_TAC (← GEN_ALL lemma2) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"s:complex->bool", ← q r"--d:real^2", ← q r"--k:real"] THEN
      ASM_REWRITE_TAC [DOT_LNEG, REAL_LE_NEG2, REAL_LT_NEG2, VECTOR_NEG_EQ_0] THEN
      ASM_REAL_ARITH_TAC)
    let lemma4 ← prove
     r"!f s d k a b c.
            convex s /\ open s /\ a IN s /\ b IN s /\ c IN s /\ ~(d = vec 0) /\
            f holomorphic_on {z | z IN s /\ d dot z < k} /\
            f holomorphic_on {z | z IN s /\ k < d dot z} /\
            f continuous_on s
            ==> path_integral (linepath (a,b)) f +
                path_integral (linepath (b,c)) f +
                path_integral (linepath (c,a)) f = Cx(&0)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(d:complex) dot a <= k") THENL
       [MATCH_MP_TAC lemma3 THEN ASM_MESON_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC lemma3 THEN
      MAP_EVERY EXISTS_TAC
       [← q r"s:complex->bool", ← q r"--d:real^2", ← q r"--k:real"] THEN
      ASM_REWRITE_TAC [DOT_LNEG, REAL_LE_NEG2, REAL_LT_NEG2, VECTOR_NEG_EQ_0] THEN
      ASM_REAL_ARITH_TAC)
    prove
     r"!f s a k.
          open s /\ ~(a = vec 0) /\
          f holomorphic_on {z | z IN s /\ k < a dot z} /\
          f holomorphic_on {z | z IN s /\ a dot z < k} /\
          f continuous_on s
          ==> f holomorphic_on s"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC ANALYTIC_IMP_HOLOMORPHIC THEN
    MATCH_MP_TAC MORERA_LOCAL_TRIANGLE THEN
    X_GEN_TAC (← q r"p:complex") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"p:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"ball(p:complex,e)") THEN
    ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:complex", ← q r"v:complex", ← q r"w:complex"] THEN
    SIMP_TAC [SUBSET_HULL, CONVEX_BALL, INSERT_SUBSET, EMPTY_SUBSET] THEN
    STRIP_TAC THEN MATCH_MP_TAC lemma4 THEN
    MAP_EVERY EXISTS_TAC [← q r"ball(p:complex,e)", ← q r"a:complex", ← q r"k:real"] THEN
    ASM_REWRITE_TAC [CONVEX_BALL, OPEN_BALL] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
      EXISTS_TAC (← q r"{z:complex | z IN s /\ a dot z < k}"),
      MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
      EXISTS_TAC (← q r"{z:complex | z IN s /\ k < a dot z}"),
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool")] THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC []))

  let SCHWARZ_REFLECTION ← prove
   r"!f s. open s /\ (!z. z IN s ==> cnj z IN s) /\
         f holomorphic_on {z | z IN s /\ &0 < Im z} /\
         f continuous_on {z | z IN s /\ &0 <= Im z} /\
         (!z. z IN s /\ real z ==> real(f z))
         ==> (\z. if &0 <= Im z then f(z) else cnj(f(cnj z)))
             holomorphic_on s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HOLOMORPHIC_ON_PASTE_ACROSS_LINE THEN
    MAP_EVERY EXISTS_TAC [← q r"basis 2:complex", ← q r"&0"] THEN
    ASM_SIMP_TAC [BASIS_NONZERO, DOT_BASIS, DIMINDEX_2, ARITH] THEN
    REWRITE_TAC [← GSYM IM_DEF] THEN REPEAT CONJ_TAC THENL
     [UNDISCH_TAC (← q r"f holomorphic_on {z | z IN s /\ &0 < Im z}") THEN
      MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOLOMORPHIC_EQ THEN
      SIMP_TAC [IN_ELIM_THM, REAL_LT_IMP_LE],
      SUBGOAL_THEN
       (← q r"(cnj o f o cnj) holomorphic_on {z | z IN s /\ Im z < &0}")
      MP_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOLOMORPHIC_EQ THEN
        SIMP_TAC [IN_ELIM_THM, ← GSYM REAL_NOT_LE, o_THM]] THEN
      UNDISCH_TAC (← q r"f holomorphic_on {z | z IN s /\ &0 < Im z}") THEN
      REWRITE_TAC [holomorphic_on, IN_ELIM_THM] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"cnj z")) THEN
      ASM_SIMP_TAC [IM_CNJ, ← REAL_ARITH (← q r"&0 < --x <=> x < &0")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:complex")
        (fun th => tactic_of do pure (EXISTS_TAC (← q r"cnj w") THEN MP_TAC th))) THEN
      REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN, LIM_WITHIN] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM FORALL_CNJ] THEN
      REWRITE_TAC [IN_ELIM_THM, dist, ← GSYM CNJ_SUB, o_THM] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM COMPLEX_NORM_CNJ] THEN
      REWRITE_TAC [CNJ_SUB, CNJ_DIV, CNJ_CNJ] THEN
      MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_SIMP_TAC [IM_CNJ] THEN ASM_REAL_ARITH_TAC,
      SUBGOAL_THEN
       (← q r"s = {z | z IN s /\ &0 <= Im z} UNION
            {z | z IN s /\ Im z <= &0}")
       (fun th => tactic_of do pure (SUBST1_TAC th THEN ASSUME_TAC (← SYM th)))
      THENL [SET_TAC [REAL_LE_TOTAL], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES_LOCAL THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [← SET_RULE (← q r"{z | z IN s /\ P z} = s INTER {z | P z}")] THEN
      SIMP_TAC [CLOSED_IN_CLOSED_INTER, CLOSED_HALFSPACE_IM_LE,
               ← REWRITE_RULE [real_ge] CLOSED_HALFSPACE_IM_GE] THEN
      CONJ_TAC THENL
       [REPLICATE_TAC 2
         (MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_COMPOSE) THEN
          REWRITE_TAC [CONTINUOUS_ON_CNJ]) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
        ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_INTER, IM_CNJ] THEN
        REAL_ARITH_TAC,
        X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"real z") ASSUME_TAC THENL
         [REWRITE_TAC [real] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [REAL_CNJ]) THEN ASM_MESON_TAC []]])

  let SCHWARZ_REFLECTION_UNIQUE ← prove
   r"!f s. open s /\ connected s /\ (!z. z IN s ==> cnj z IN s) /\
         f holomorphic_on s /\ (!z. z IN s /\ real z ==> real(f z))
         ==> (!z. z IN s ==> f(cnj z) = cnj(f z))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"!z. z IN s ==> real z") THENL
     [ASM_MESON_TAC [REAL_CNJ, real],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
      REWRITE_TAC [real, NOT_IMP, ← REAL_ARITH (← q r"~(x = &0) <=> &0 < x \/ &0 < --x"),
                  ← GSYM IM_CNJ] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(?z. P z /\ (Q z \/ R z))
        ==> (!z. P z ==> P(cnj z)) /\ (!z. R z ==> Q(cnj z))
            ==> ?z. P z /\ Q z"))) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool"]
          SCHWARZ_REFLECTION) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [ALL_TAC, MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOLOMORPHIC_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z. z IN s
          ==> (if &0 <= Im z then f z else cnj (f (cnj z))) - f z = Cx(&0)")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (LABEL_TAC "*") THEN X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
      REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
       (← REAL_ARITH (← q r"Im z = &0 \/ &0 < Im z \/ Im z < &0"))
      THENL
       [ASM_MESON_TAC [REAL_CNJ, real],
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"cnj z")) THEN
        ASM_SIMP_TAC [IM_CNJ, ← REAL_ARITH (← q r"&0 <= --z <=> ~(&0 < z)"), CNJ_CNJ] THEN
        CONV_TAC COMPLEX_RING,
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"z:complex")) THEN
        ASM_SIMP_TAC [← GSYM REAL_NOT_LT, COMPLEX_SUB_0] THEN
        MESON_TAC [CNJ_CNJ]]] THEN
    MATCH_MP_TAC ANALYTIC_CONTINUATION THEN
    EXISTS_TAC (← q r"s INTER {w | Im w > &0}") THEN
    ASM_SIMP_TAC [IN_INTER, real_gt, REAL_LT_IMP_LE, COMPLEX_SUB_0, IN_ELIM_THM,
                 INTER_SUBSET, RIGHT_EXISTS_AND_THM, HOLOMORPHIC_ON_SUB] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"w:complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"w:complex") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LIMPT_OF_OPEN THEN ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
    MATCH_MP_TAC OPEN_INTER THEN
    ASM_REWRITE_TAC [← GSYM real_gt, OPEN_HALFSPACE_IM_GT])

  pure { HOLOMORPHIC_ON_PASTE_ACROSS_LINE, SCHWARZ_REFLECTION, SCHWARZ_REFLECTION_UNIQUE }

/- ------------------------------------------------------------------------- -/
/- Bloch's theorem: the main lemma.                                          -/
/- (cauchy.ml 15706-16050)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBO where
  BLOCH_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBO [HolBase] (D : CauchyDeps) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYV : KYV) (BKYAE : KYAE) (BKYAI : KYAI) (BKYBD : KYBD) : ExceptT String IO KYBO := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_LINEPATH, VALID_PATH_LINEPATH, .. } := BKYE
  let { PATH_INTEGRAL_PRIMITIVE, .. } := BKYF
  let { HAS_PATH_INTEGRAL_SUB, .. } := BKYG
  let { CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE, .. } := BKYV
  let { HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH, PATH_IMAGE_CIRCLEPATH, PATHFINISH_CIRCLEPATH,
        PATHSTART_CIRCLEPATH, VALID_PATH_CIRCLEPATH, WINDING_NUMBER_CIRCLEPATH,
        .. } := BKYAE
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { OPEN_MAPPING_THM, .. } := BKYBD
  let { SQRT_WORKS, .. } := D.qsession
  let { BALL_SUBSET_OPEN_MAP_IMAGE, .. } := D.qconvex
  let { REAL_DIFF_TAC, .. } := D.mt.rzq
  let { has_real_integral, .. } := D.mt.rzak
  let { REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS, .. } := D.mt.rzan
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { IMAGE_LIFT_REAL_INTERVAL, .. } := D.mt.ra.qtopology
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, .. } := D.mt.ra.ts.kna
  let { COMPLEX_DIFF_CHAIN_AT, complex_differentiable,
        COMPLEX_DIFFERENTIABLE_WITHIN_SUBSET, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_ADD, HAS_COMPLEX_DERIVATIVE_CONST,
        HAS_COMPLEX_DERIVATIVE_ID, HAS_COMPLEX_DERIVATIVE_LMUL_WITHIN,
        HAS_COMPLEX_DERIVATIVE_SUB, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_WITHIN_OPEN, .. } := D.mt.ra.ts.kng
  let { COMPLEX_DERIVATIVE_CONST, COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN,
        HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
        HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE_GEN, HOLOMORPHIC_ON_CONST,
        HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { REAL_LT_RSQRT, .. } := D.mt.ra.ts.qsession
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RID, COMPLEX_ADD_SUB, COMPLEX_MUL_LID,
        COMPLEX_MUL_RZERO, COMPLEX_MUL_SYM, COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_LZERO,
        COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, COMPLEX_NORM_II, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_NZ,
        .. } := D.mt.ra.ts.cn.cxf
  let { HAS_INTEGRAL_CMUL, HAS_INTEGRAL_INTEGRABLE_INTEGRAL,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { INTEGRAL_NORM_BOUND_INTEGRAL, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, NORM_ARITH, NORM_ARITH_TAC,
        NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { EMPTY_SUBSET, EQ_IMP, FORALL_IN_GSPEC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DELETE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, REAL_ABS_NUM, REAL_ADD_LID,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_MUL, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_INV_EQ,
        REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_MUL_EQ,
        REAL_LE_POW_2, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_RMUL_EQ, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_LSQRT, REAL_LT_MUL, REAL_LT_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RZERO, REAL_POS, REAL_SUB_LE, REAL_SUB_LT,
        REAL_SUB_RDISTRIB, RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_REFL,
        SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_REFL, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_CMUL, DROP_VEC, ENDS_IN_INTERVAL, FORALL_LIFT, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        LIFT_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_NEG, NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, drop, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BALL_SUBSET_CBALL, BALL_TRIVIAL, BOUNDED_BALL, CENTRE_IN_BALL, CLOSURE_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_CLOSURE_COMPONENT_GE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID,
        CONTINUOUS_ON_INV, CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_MUL,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, FRONTIER_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, IN_INTERVAL_1, INTERIOR_CBALL, INTERIOR_OPEN,
        INTERVAL_EQ_EMPTY_1, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { SUBSET_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { REAL_INV_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { PATH_IMAGE_LINEPATH, PATHFINISH_LINEPATH, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_BALLS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { SUBSET_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  let { CONVEX_BALL, CONVEX_CBALL, CONVEX_CONTAINS_SEGMENT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let BLOCH_LEMMA ← prove
   r"!f a r.
    &0 < r /\ f holomorphic_on cball(a,r) /\
    (!z. z IN ball(a,r)
         ==> norm(complex_derivative f z) <= &2 * norm(complex_derivative f a))
    ==> ball(f(a),(&3 - &2 * sqrt(&2)) * r * norm(complex_derivative f a))
        SUBSET IMAGE f (ball(a,r))"
   (SUBGOAL_THEN
     (← q r"!f r.
          &0 < r /\ f holomorphic_on cball(Cx(&0),r) /\ f(Cx(&0)) = Cx(&0) /\
          (!z. z IN ball(Cx(&0),r)
               ==> norm(complex_derivative f z)
                   <= &2 * norm(complex_derivative f (Cx(&0))))
          ==> ball(Cx(&0),
                   (&3 - &2 * sqrt(&2)) *
                   r * norm(complex_derivative f (Cx(&0))))
              SUBSET IMAGE f (ball(Cx(&0),r))")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"\z. (f:complex->complex)(a + z) - f(a)", ← q r"r:real"]) THEN
      ASM_REWRITE_TAC [COMPLEX_ADD_RID, COMPLEX_SUB_REFL] THEN
      SUBGOAL_THEN
       (← q r"!z. z IN ball(Cx(&0),r)
            ==> complex_derivative (\w. f (a + w) - f a) z =
                complex_derivative f (a + z)")
       (fun th => ASM_SIMP_TAC [CENTRE_IN_BALL, COMPLEX_ADD_RID, th])
      THENL
       [REWRITE_TAC [COMPLEX_IN_BALL_0] THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DERIVATIVE THEN
        ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
         (← q r"complex_derivative f z =
          complex_derivative f z * (Cx(&0) + Cx(&1)) - Cx(&0)"))] THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_SUB THEN
        REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_CONST] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT THEN
        SIMP_TAC [HAS_COMPLEX_DERIVATIVE_ADD, HAS_COMPLEX_DERIVATIVE_CONST,
          HAS_COMPLEX_DERIVATIVE_ID, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [holomorphic_on]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a + z:complex")) THEN
        ASM_SIMP_TAC [IN_CBALL, ← NORM_ARITH (← q r"norm z < r ==> dist(a,a+z) <= r")] THEN
        REWRITE_TAC [← GSYM complex_differentiable] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"ball(a:complex,r)") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          COMPLEX_DIFFERENTIABLE_WITHIN_SUBSET)) THEN
        ASM_REWRITE_TAC [BALL_SUBSET_CBALL] THEN MATCH_MP_TAC EQ_IMP THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_WITHIN_OPEN THEN
        ASM_REWRITE_TAC [IN_BALL, OPEN_BALL, ← NORM_ARITH (← q r"dist(a,a + z) = norm z")],
        ANTS_TAC THENL
         [CONJ_TAC THENL
           [MATCH_MP_TAC HOLOMORPHIC_ON_SUB THEN
            REWRITE_TAC [HOLOMORPHIC_ON_CONST] THEN
            GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
            MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN THEN
            EXISTS_TAC (← q r"cball(a:complex,r)") THEN
            ASM_SIMP_TAC [HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_ID,
                         HOLOMORPHIC_ON_CONST, COMPLEX_IN_CBALL_0] THEN
            REWRITE_TAC [IN_CBALL] THEN NORM_ARITH_TAC,
            X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [COMPLEX_IN_BALL_0] THEN
            STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            ASM_REWRITE_TAC [IN_BALL, ← NORM_ARITH (← q r"dist(a,a + z) = norm z")]],
          REWRITE_TAC [SUBSET, COMPLEX_IN_BALL_0, IN_IMAGE] THEN
          REWRITE_TAC [IN_BALL, ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
          DISCH_THEN (fun th => tactic_of do pure (
           X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
           MP_TAC (← SPEC (← q r"z - (f:complex->complex) a") th))) THEN
          ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"z - a:complex = w - a <=> z = w"))] THEN
          DISCH_THEN (X_CHOOSE_TAC (← q r"x:complex")) THEN
          EXISTS_TAC (← q r"a + x:complex") THEN
          ASM_REWRITE_TAC [COMPLEX_ADD_SUB]]]] THEN
    REPEAT GEN_TAC THEN
    SUBGOAL_THEN (← q r"&0 < &3 - &2 * sqrt(&2)") ASSUME_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"&0 < a - &2 * b <=> b < a / &2")] THEN
      MATCH_MP_TAC REAL_LT_LSQRT THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"&0 < r") THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"complex_derivative f (Cx(&0)) = Cx(&0)") THEN
    ASM_SIMP_TAC [COMPLEX_NORM_0, REAL_MUL_RZERO, BALL_TRIVIAL, EMPTY_SUBSET] THEN
    ABBREV_TAC (← q r"C = &2 * norm(complex_derivative f (Cx(&0)))") THEN
    SUBGOAL_THEN (← q r"&0 < C") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPLEX_NORM_NZ, ← REAL_ARITH (← q r"&0 < &2 * x <=> &0 < x")],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z. z IN ball(Cx(&0),r)
          ==> norm(complex_derivative f z - complex_derivative f (Cx(&0)))
              <= norm(z) / (r - norm(z)) * C")
    (LABEL_TAC "+") THENL
     [REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!R. norm z < R /\ R < r
            ==> norm(complex_derivative f z - complex_derivative f (Cx(&0)))
                <= norm(z) / (R - norm(z)) * C")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL
         [← q r"complex_derivative f",
          ← q r"cball(Cx(&0),R)",
          ← q r"circlepath(Cx(&0),R)"]
          CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE) THEN
        REWRITE_TAC [CONVEX_CBALL, VALID_PATH_CIRCLEPATH, INTERIOR_CBALL,
                    PATHSTART_CIRCLEPATH, PATHFINISH_CIRCLEPATH] THEN
        SUBGOAL_THEN (← q r"&0 < R") ASSUME_TAC THENL
         [ASM_MESON_TAC [REAL_LET_TRANS, NORM_POS_LE], ALL_TAC] THEN
        ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(z,w) = norm(w - z)")] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_CBALL, IN_BALL, IN_DELETE] THEN
        SIMP_TAC [WINDING_NUMBER_CIRCLEPATH, COMPLEX_SUB_RZERO, COMPLEX_SUB_LZERO,
                 dist, NORM_NEG,  REAL_LE_REFL, ← MESON [REAL_LT_REFL]
            (← q r"norm z < R /\ (!w. norm w = R ==> ~(w = z)) <=> norm z < R")] THEN
        REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ] THEN ANTS_TAC THENL
         [MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
          EXISTS_TAC (← q r"ball(Cx(&0),r)") THEN CONJ_TAC THENL
           [MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE THEN
            REWRITE_TAC [OPEN_BALL] THEN
            MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
            EXISTS_TAC (← q r"cball(Cx(&0),r)") THEN ASM_REWRITE_TAC [BALL_SUBSET_CBALL],
            ASM_REWRITE_TAC [SUBSET_BALLS, DIST_REFL, REAL_ADD_LID]],
          REWRITE_TAC [COMPLEX_MUL_LID]] THEN
        DISCH_THEN (fun th => tactic_of do pure (
          MP_TAC (← CONJ (← SPEC (← q r"z:complex") th) (← SPEC (← q r"Cx(&0)") th)))) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_0, COMPLEX_SUB_RZERO] THEN
        DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_SUB) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"C * norm(z) / (R * (R - norm(z:complex)))") o
          MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH)) THEN
        ASM_REWRITE_TAC [← GSYM COMPLEX_SUB_LDISTRIB] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_II] THEN
        REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LID, REAL_ABS_PI] THEN
        ASM_SIMP_TAC [← REAL_FIELD
         (← q r"&0 < R /\ z < R
          ==> (C * z / (R * (R - z))) * &2 * pi * R =
              &2 * pi * z / (R - z) * C")] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← REAL_ARITH (← q r"&0 < &2"), PI_POS] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        ASM_SIMP_TAC [REAL_LE_MUL_EQ, REAL_LE_DIV, REAL_LE_MUL, REAL_SUB_LE,
                     REAL_LT_IMP_LE, NORM_POS_LE, COMPLEX_SUB_RZERO] THEN
        X_GEN_TAC (← q r"x:complex") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"~(x = Cx(&0)) /\ ~(x = z)") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [REAL_LT_REFL, COMPLEX_NORM_0], ALL_TAC] THEN
        ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(x = Cx(&0)) /\ ~(x = z)
          ==> d / (x - z) - d / x = d * z / (x * (x - z))"))] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE, IN_BALL, dist, NORM_NEG,
                     COMPLEX_SUB_LZERO] THEN
        REWRITE_TAC [COMPLEX_NORM_DIV, real_div] THEN
        MATCH_MP_TAC REAL_LE_LMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
        MATCH_MP_TAC REAL_LE_INV2 THEN
        ASM_SIMP_TAC [REAL_LT_MUL, REAL_SUB_LT, COMPLEX_NORM_MUL] THEN
        ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
        UNDISCH_TAC (← q r"norm(x:complex) = R") THEN CONV_TAC (fun t => NORM_ARITH t),
        DISCH_TAC THEN MP_TAC (← ISPECL
         [← q r"\x. lift(norm(z:complex) / (drop x - norm z) * C)",
          ← q r"interval(lift((norm(z:complex) + r) / &2),lift r)", ← q r"lift r",
          ← q r"norm(complex_derivative f z - complex_derivative f (Cx(&0)))",
          ← q r"1"] CONTINUOUS_ON_CLOSURE_COMPONENT_GE) THEN
        REWRITE_TAC [← GSYM drop, LIFT_DROP, CLOSURE_INTERVAL] THEN
        DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [INTERVAL_EQ_EMPTY_1] THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
        REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN DISCH_TAC THEN
        ASM_SIMP_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, LIFT_DROP, ← REAL_ARITH
          (← q r"z < r ==> ~(r <= (z + r) / &2) /\ ~(r < (z + r) / &2)")] THEN
        REWRITE_TAC [FORALL_LIFT, LIFT_DROP, IN_INTERVAL_1] THEN
        CONJ_TAC THENL
         [ALL_TAC,
          ASM_MESON_TAC [← REAL_ARITH (← q r"(z + r) / &2 < R /\ R < r ==> z < R")]] THEN
        REWRITE_TAC [LIFT_CMUL, real_div] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST, o_DEF, LIFT_CMUL] THEN
        MATCH_MP_TAC CONTINUOUS_ON_MUL THEN
        REWRITE_TAC [CONTINUOUS_ON_CONST, o_DEF, LIFT_CMUL] THEN
        MATCH_MP_TAC (← REWRITE_RULE [o_DEF] CONTINUOUS_ON_INV) THEN
        SIMP_TAC [LIFT_SUB, CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, LIFT_DROP,
                 CONTINUOUS_ON_LIFT_NORM_COMPOSE, CONTINUOUS_ON_ID] THEN
        REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, LIFT_DROP] THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z.  z IN ball(Cx(&0),r)
           ==> (norm(z) - norm(z) pow 2 / (r - norm(z))) *
               norm(complex_derivative f (Cx(&0)))
               <= norm(f z)")
    (LABEL_TAC "*") THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
      REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"\z. f(z) - complex_derivative f (Cx(&0)) * z",
                    ← q r"\z. complex_derivative f z - complex_derivative f (Cx(&0))",
                    ← q r"linepath(Cx(&0),z)", ← q r"ball(Cx(&0),r)"]
          PATH_INTEGRAL_PRIMITIVE) THEN
      REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN ANTS_TAC THENL
       [REWRITE_TAC [VALID_PATH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
        ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
         (← q r"a - complex_derivative f b = a - complex_derivative f b * Cx(&1)"))] THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"x:complex") THEN STRIP_TAC THEN
          MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_SUB THEN
          SIMP_TAC [HAS_COMPLEX_DERIVATIVE_LMUL_WITHIN,
                   HAS_COMPLEX_DERIVATIVE_ID] THEN
          MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_AT_WITHIN THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [holomorphic_on]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"x:complex")) THEN
          ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] BALL_SUBSET_CBALL] THEN
          REWRITE_TAC [← GSYM complex_differentiable] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"ball(Cx(&0),r)") o
            MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COMPLEX_DIFFERENTIABLE_WITHIN_SUBSET)) THEN
          ASM_SIMP_TAC [COMPLEX_DIFFERENTIABLE_WITHIN_OPEN, OPEN_BALL] THEN
          REWRITE_TAC [BALL_SUBSET_CBALL],
          MATCH_MP_TAC (← REWRITE_RULE [CONVEX_CONTAINS_SEGMENT] CONVEX_BALL) THEN
          ASM_REWRITE_TAC [CENTRE_IN_BALL]],
        ALL_TAC] THEN
      SIMP_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_PATH_INTEGRAL_LINEPATH] THEN
      REWRITE_TAC [COMPLEX_SUB_RZERO, COMPLEX_MUL_RZERO] THEN
      REWRITE_TAC [linepath, COMPLEX_CMUL, COMPLEX_MUL_RZERO, LIFT_DROP] THEN
      REWRITE_TAC [COMPLEX_ADD_LID, FORALL_LIFT, IN_INTERVAL_1, LIFT_DROP] THEN
      STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
       SPEC (← q r"\t. lift(norm(z:complex) pow 2 * drop t / (r - norm(z)) * C)") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRAL_NORM_BOUND_INTEGRAL)) THEN
      REWRITE_TAC [linepath, COMPLEX_CMUL, COMPLEX_MUL_RZERO, LIFT_DROP] THEN
      REWRITE_TAC [COMPLEX_ADD_LID, FORALL_LIFT, IN_INTERVAL_1, LIFT_DROP] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"a * b / c * d:real = (a / c * d) * b")] THEN
      REWRITE_TAC [LIFT_CMUL, LIFT_DROP, DROP_VEC] THEN
      MP_TAC (← ISPECL
       [← q r"\x. inv(&2) * x pow 2", ← q r"\x:real. x", ← q r"&0", ← q r"&1"]
          REAL_FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
      REWRITE_TAC [REAL_POS] THEN ANTS_TAC THENL
       [REPEAT STRIP_TAC THEN REAL_DIFF_TAC THEN CONV_TAC NUM_REDUCE_CONV THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [has_real_integral, o_DEF, IMAGE_LIFT_REAL_INTERVAL] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_DROP, LIFT_NUM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"norm(z:complex) pow 2 / (r - norm z) * C") o
          MATCH_MP HAS_INTEGRAL_CMUL) THEN
        REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
      ANTS_TAC THENL
       [X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
        REWRITE_TAC [← REAL_ARITH
          (← q r"(z pow 2 / y * c) * t:real = (z / y * t * c) * z")] THEN
        REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
        REWRITE_TAC [NORM_POS_LE] THEN
        REMOVE_THEN "+" (MP_TAC o SPEC (← q r"Cx(t) * z")) THEN
        REWRITE_TAC [IN_BALL, dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
        SUBGOAL_THEN (← q r"norm(Cx t * z) <= norm z") ASSUME_TAC THENL
         [GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
          REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
          REWRITE_TAC [NORM_POS_LE, COMPLEX_NORM_CX] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LE_TRANS) THEN
        ASM_SIMP_TAC [REAL_LE_RMUL_EQ, REAL_MUL_ASSOC, real_div] THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, real_abs] THEN
        GEN_REWRITE_TAC LAND_CONV
         [← REAL_ARITH (← q r"(t * z) * w:real = (z * w) * t")] THEN
        MATCH_MP_TAC REAL_LE_RMUL THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_MUL2 THEN
        REWRITE_TAC [NORM_POS_LE, REAL_LE_INV_EQ, REAL_SUB_LE] THEN
        REWRITE_TAC [REAL_LE_REFL] THEN CONJ_TAC THENL
         [ALL_TAC, MATCH_MP_TAC REAL_LE_INV2] THEN
        ASM_REWRITE_TAC [REAL_SUB_LT] THEN FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE LAND_CONV [COMPLEX_NORM_MUL]) THEN
        REWRITE_TAC [COMPLEX_NORM_CX] THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [COMPLEX_SUB_RZERO]] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"abc <= norm d - e ==> norm(f - d) <= e ==> abc <= norm f")) THEN
      REWRITE_TAC [REAL_SUB_RDISTRIB,
                  ← ONCE_REWRITE_RULE [COMPLEX_MUL_SYM] COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"y <= x ==> a - x <= a - y")) THEN
      REWRITE_TAC [DROP_CMUL, ← GSYM REAL_MUL_ASSOC, LIFT_DROP] THEN
      MATCH_MP_TAC REAL_LE_LMUL THEN
      ASM_SIMP_TAC [REAL_LE_DIV, REAL_SUB_LE, REAL_LT_IMP_LE, REAL_LE_POW_2] THEN
      EXPAND_TAC "C" THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"IMAGE (f:complex->complex)
                      (ball(Cx(&0),(&1 - sqrt(&2) / &2) * r))") THEN
    SUBGOAL_THEN (← q r"&0 < &1 - sqrt(&2) / &2 /\  &1 - sqrt(&2) / &2 < &1")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← REAL_ARITH
       (← q r"&0 < &1 - s / &2 /\  &1 - s / &2 < &1 <=> &0 < s /\ s < &2")] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LT_RSQRT, MATCH_MP_TAC REAL_LT_LSQRT] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC IMAGE_SUBSET THEN MATCH_MP_TAC SUBSET_BALL THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x * r <= r <=> &0 <= r * (&1 - x)")] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC] THEN
    FIRST_ASSUM (fun th => tactic_of do pure (
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV) [← SYM th])) THEN
    MATCH_MP_TAC BALL_SUBSET_OPEN_MAP_IMAGE THEN
    ASM_SIMP_TAC [REAL_LT_MUL, BOUNDED_BALL, CLOSURE_BALL, CENTRE_IN_BALL] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"cball(Cx(&0),r)") THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      MATCH_MP_TAC SUBSET_CBALL THEN
      REWRITE_TAC [← REAL_ARITH (← q r"x * r <= r <=> &0 <= r * (&1 - x)")] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
          OPEN_MAPPING_THM) THEN
      EXISTS_TAC (← q r"ball(Cx(&0),r)") THEN
      ASM_SIMP_TAC [OPEN_BALL, CONNECTED_BALL, INTERIOR_OPEN, SUBSET_REFL] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, BALL_SUBSET_CBALL],
        ALL_TAC,
        MATCH_MP_TAC SUBSET_BALL THEN
        REWRITE_TAC [← REAL_ARITH (← q r"x * r <= r <=> &0 <= r * (&1 - x)")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:complex")) THEN
      MP_TAC (← ISPECL
       [← q r"f:complex->complex", ← q r"(\x. y):complex->complex",
        ← q r"ball(Cx(&0),r)", ← q r"Cx(&0)"]
       COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN) THEN
      ASM_REWRITE_TAC [OPEN_BALL, HOLOMORPHIC_ON_CONST, COMPLEX_DERIVATIVE_CONST,
                      CENTRE_IN_BALL] THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, BALL_SUBSET_CBALL],
      REPEAT (MATCH_MP_TAC REAL_LT_MUL THEN CONJ_TAC) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < &3 - &2 * s <=> s < &3 / &2")] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [FRONTIER_BALL, sphere, REAL_LT_MUL, dist, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [COMPLEX_SUB_LZERO, NORM_NEG] THEN
    DISCH_TAC THEN REMOVE_THEN "*" (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_BALL, dist, COMPLEX_SUB_LZERO, COMPLEX_SUB_RZERO] THEN
    ASM_REWRITE_TAC [NORM_NEG] THEN ANTS_TAC THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"x * r < r <=> &0 < r * (&1 - x)")] THEN
      MATCH_MP_TAC REAL_LT_MUL THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LE_TRANS)] THEN
    REWRITE_TAC [REAL_MUL_ASSOC] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
    REWRITE_TAC [NORM_POS_LE, ← REAL_ARITH (← q r"r - (&1 - s) * r = s * r")] THEN
    REWRITE_TAC [real_div, REAL_INV_MUL, REAL_INV_INV] THEN
    ASM_SIMP_TAC [REAL_LE_RMUL_EQ, ← REAL_FIELD
     (← q r"&0 < r
      ==> a * r - (b * r) pow 2 * x * inv r =  (a - b pow 2 * x) * r")] THEN
    MATCH_MP_TAC REAL_EQ_IMP_LE THEN
    MP_TAC (← SPEC (← q r"&2") SQRT_WORKS) THEN CONV_TAC REAL_FIELD)

  pure { BLOCH_LEMMA }
/- ------------------------------------------------------------------------- -/
/- Bloch's theorem: unit, general and corollary forms.                       -/
/- (cauchy.ml 16051-16252)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBP where
  BLOCH_UNIT : thm
  BLOCH : thm
  BLOCH_COROLLARY : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBP [HolBase] (D : CauchyDeps) (BKYAI : KYAI) (BKYBO : KYBO) : ExceptT String IO KYBP := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { BLOCH_LEMMA, .. } := BKYBO
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { CONTINUOUS_ON_CX_LIFT, .. } := D.mt.ra.ts.knd
  let { COMPLEX_DIFF_CHAIN_AT, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_CDIV_AT, .. } := D.mt.ra.ts.knf
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
        .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_ADD_RID, COMPLEX_MUL_RZERO, COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_REFL,
        COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_DIV_REFL, COMPLEX_ENTIRE, COMPLEX_NORM_CX, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_LMUL, COMPLEX_NORM_0, COMPLEX_NORM_MUL, COMPLEX_NORM_NZ,
        .. } := D.mt.ra.ts.cn.cxf
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, NORM_ARITH_TAC, REAL_ARITH,
        REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { EMPTY_SUBSET, ETA_AX, EXISTS_IN_IMAGE, EXTENSION, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IN_EMPTY, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LE_RDIV_EQ, REAL_LE_TRANS,
        REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_LCANCEL_IMP, REAL_LT_LDIV_EQ,
        REAL_LT_LE, REAL_LT_LSQRT, REAL_LT_MUL, REAL_LT_MUL_EQ, REAL_LTE_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_NOT_LE, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_REFL, REAL_SUB_RZERO, SUBSET,
        SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { LIFT_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BALL_EMPTY, CBALL_EQ_EMPTY, CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, CONNECTED_INTER_FRONTIER,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_SUB, CONTINUOUS_ON_SUBSET, DISTANCE_ATTAINS_SUP,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { SUBSET_BALLS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let BLOCH_UNIT ← prove
   r"!f a. f holomorphic_on ball(a,&1) /\
       complex_derivative f a = Cx(&1)
       ==> ?b r. &1 / &12 < r /\ ball(b,r) SUBSET IMAGE f (ball(a,&1))"
   (REPEAT STRIP_TAC THEN ABBREV_TAC (← q r"r = &249 / &256") THEN
    SUBGOAL_THEN (← q r"&0 < r") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ABBREV_TAC (← q r"g = \z. complex_derivative f z * Cx(r - norm(z - a))") THEN
    MP_TAC (← ISPECL [← q r"IMAGE (g:complex->complex) (cball(a,r))", ← q r"Cx(&0)"]
          DISTANCE_ATTAINS_SUP) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, CBALL_EQ_EMPTY] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN REWRITE_TAC [COMPACT_CBALL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"ball(a:complex,&1)") THEN
      REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN EXPAND_TAC "g" THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
        ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, ETA_AX, OPEN_BALL],
        REWRITE_TAC [CONTINUOUS_ON_CX_LIFT, LIFT_SUB] THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUB THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
        MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST]],
