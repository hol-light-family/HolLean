         SIMPLY_CONNECTED_EQ_HOLOMORPHIC_SQRT, SIMPLY_CONNECTED_EQ_INJECTIVE_HOLOMORPHIC_SQRT,
         SIMPLY_CONNECTED_EQ_BIHOLOMORPHIC_TO_DISC, SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC }
/- ------------------------------------------------------------------------- -/
/- Contractible = simply connected in 2D; Burckel 1.35 equivalents.          -/
/- (cauchy.ml 19349-19746)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBY where
  CONTRACTIBLE_EQ_SIMPLY_CONNECTED_2D : thm
  SIMPLY_CONNECTED_EQ_FRONTIER_PROPERTIES : thm
  SIMPLY_CONNECTED_EQ_UNBOUNDED_COMPLEMENT_COMPONENTS : thm
  SIMPLY_CONNECTED_EQ_EMPTY_INSIDE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBY [HolBase] (D : CauchyDeps) (BKYS : KYS) (BKYBX : KYBX) : ExceptT String IO KYBY := do
  -- @@SCOPE BEGIN
  let { WINDING_NUMBER_ZERO_IN_OUTSIDE, .. } := BKYS
  let { SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC, SIMPLY_CONNECTED_EQ_WINDING_NUMBER_ZERO,
        .. } := BKYBX
  let { CLOSED_COMPONENTS, CLOSED_CONNECTED_COMPONENT, CLOSURE_UNIV,
        CONNECTED_COMPONENT_EQ_SELF, CONNECTED_COMPONENT_EQ_UNIV, CONNECTED_NEST,
        JOINABLE_CONNECTED_COMPONENT_EQ, SEPARATION_NORMAL_COMPACT, .. } := D.qtopology
  let { CONNECTED_ANNULUS, inside, outside, OUTSIDE_BOUNDED_NONEMPTY, OUTSIDE_MONO,
        SURA_BURA, .. } := D.qpaths
  let { FRONTIER_OF_CONNECTED_COMPONENT_SUBSET, .. } := D.qconvex
  let { CONNECTED_COMPONENT_EQ, .. } := D.mt.qtopology
  let { CONTRACTIBLE_IMP_SIMPLY_CONNECTED, INSIDE_OUTSIDE, INVARIANCE_OF_DOMAIN,
        SIMPLY_CONNECTED_IMP_CONNECTED, .. } := D.mt.qpaths
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, .. } := D.mt.ra.ts.kna
  let { COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { CONNECTED_CLOSURE, CONNECTED_CONNECTED_COMPONENT,
        .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { UPPER_BOUND_FINITE_SET, .. } := D.mt.ra.ts.cn.ms.ig.qmisc
  let { AND_FORALL_THM, CONTRAPOS_THM, DE_MORGAN_THM, DIFF_EMPTY, DIMINDEX_2,
        EXISTS_IN_INSERT, EXTENSION, FINITE_INDUCT_STRONG, FINITE_SUBSET_IMAGE,
        FORALL_IN_GSPEC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_UNWIND_THM2, FUN_IN_IMAGE, IMAGE_CLAUSES,
        IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ, IMP_CONJ_ALT, IN, IN_DIFF, INTER_UNIV,
        INTERS_0, INTERS_GSPEC, INTERS_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, LE_1, LE_REFL, LE_TRANS,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_IN_EMPTY, NOT_INSERT_EMPTY, REAL_ARCH_INV,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_LE_1, REAL_INV_LT_1, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_RADD,
        REAL_LT_INV_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE,
        SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { SUBSET_UNIV, SWAP_FORALL_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { OPEN_IN_CLOSED_IN_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BOUNDED_CLOSURE, BOUNDED_EMPTY, BOUNDED_SUBSET, CLOSED_CLOSURE,
        CLOSED_IMP_LOCALLY_COMPACT, CLOSED_IN_CLOSED_INTER, CLOSED_IN_CLOSED_TRANS,
        CLOSED_INTER, CLOSED_INTERS, CLOSURE_BALL, CLOSURE_CLOSED, CLOSURE_EQ,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_SUBSET, CLOSURE_UNION, COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE,
        COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        COMPACT_IMP_FIP, CONNECTED_CLOPEN, CONNECTED_COMPONENT_MAXIMAL,
        CONNECTED_COMPONENT_SUBSET, CONNECTED_CONTINUOUS_IMAGE,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, FRONTIER_COMPLEMENT, FRONTIER_EMPTY, FRONTIER_EQ_EMPTY,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL_0, IN_CBALL_0, IN_COMPONENTS_NONEMPTY, INTERIOR_EQ, INTERIOR_OPEN,
        NOT_BOUNDED_UNIV, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { components, frontier, homeomorphic, homeomorphism, OPEN_IN_OPEN_INTER,
        OPEN_INTER_CLOSURE_EQ_EMPTY, SUBSET_CLOSURE, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTRACTIBLE_EMPTY, CONVEX_IMP_CONTRACTIBLE, HOMEOMORPHIC_CONTRACTIBLE_EQ,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { REAL_LT_INV2, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { BOUNDED_UNION, COMPACT_DIFF, CONNECTED_COMPONENT_EQ_EMPTY,
        CONNECTED_COMPONENT_REFL_EQ, CONNECTED_EMPTY, CONNECTED_UNIV,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { SUBSET_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let CONTRACTIBLE_EQ_SIMPLY_CONNECTED_2D ← prove
   r"!s:real^2->bool. open s ==> (contractible s <=> simply_connected s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [CONTRACTIBLE_IMP_SIMPLY_CONNECTED] THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [CONTRACTIBLE_EMPTY] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_CONTRACTIBLE_EQ, CONVEX_IMP_CONTRACTIBLE,
                  CONVEX_BALL])

  let [SIMPLY_CONNECTED_EQ_FRONTIER_PROPERTIES,
       SIMPLY_CONNECTED_EQ_UNBOUNDED_COMPLEMENT_COMPONENTS,
       SIMPLY_CONNECTED_EQ_EMPTY_INSIDE] := CONJUNCTS (← prove
   r"(!s:complex->bool.
        open s
        ==> (simply_connected s <=>
             connected s /\
             if bounded s then connected(frontier s)
             else !c. c IN components(frontier s) ==> ~bounded c)) /\
   (!s. open s
        ==> (simply_connected s <=>
             connected s /\
             !c. c IN components ((:complex) DIFF s) ==> ~bounded c)) /\
   (!s:complex->bool.
        open s ==> (simply_connected s <=> connected s /\ inside s = {}))"
   (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:complex->bool") THEN
    ASM_CASES_TAC (← q r"open(s:complex->bool)") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q3 ==> p) /\ (q2 ==> q3) /\ (q1 ==> q2) /\ (p ==> q1)
      ==> (p <=> q1) /\ (p <=> q2) /\ (p <=> q3)")) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [INSIDE_OUTSIDE] THEN
      REWRITE_TAC [← SET_RULE (← q r"UNIV DIFF (s UNION t) = {} <=>
                            !x. ~(x IN s) ==> x IN t")] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_WINDING_NUMBER_ZERO] THEN
      GEN_TAC THEN X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
      MATCH_MP_TAC WINDING_NUMBER_ZERO_IN_OUTSIDE THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OUTSIDE_MONO) THEN ASM SET_TAC [],
      REWRITE_TAC [components, FORALL_IN_GSPEC, inside] THEN SET_TAC [],
      ASM_CASES_TAC (← q r"connected(s:complex->bool)") THEN ASM_REWRITE_TAC [] THEN
      COND_CASES_TAC THENL
       [DISCH_TAC THEN
        REWRITE_TAC [components, FORALL_IN_GSPEC, IN_DIFF, IN_UNIV] THEN
        ASM_CASES_TAC (← q r"s:complex->bool = {}") THEN
        ASM_SIMP_TAC [DIFF_EMPTY, CONNECTED_COMPONENT_EQ_SELF,
                     CONNECTED_UNIV, IN_UNIV, NOT_BOUNDED_UNIV] THEN
        ASM_CASES_TAC (← q r"s = (:complex)") THENL
         [ASM_MESON_TAC [NOT_BOUNDED_UNIV], ALL_TAC] THEN
        X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OUTSIDE_BOUNDED_NONEMPTY) THEN
        REWRITE_TAC [outside, ← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:complex") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
         (← q r"connected_component ((:complex) DIFF s) w =
          connected_component ((:complex) DIFF s) z")
         (fun th => ASM_REWRITE_TAC [th]) THEN
        MATCH_MP_TAC JOINABLE_CONNECTED_COMPONENT_EQ THEN
        EXISTS_TAC (← q r"frontier s :complex->bool") THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [frontier] THEN MATCH_MP_TAC (← SET_RULE
           (← q r"i = s ==> s' DIFF i SUBSET UNIV DIFF s")) THEN
          ASM_REWRITE_TAC [INTERIOR_EQ],
          ALL_TAC] THEN
        ONCE_REWRITE_TAC [← GSYM FRONTIER_COMPLEMENT] THEN CONJ_TAC THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"frontier c SUBSET c /\ frontier c SUBSET f /\ ~(frontier c = {})
          ==> ~(c INTER f = {})")) THEN
        REWRITE_TAC [FRONTIER_OF_CONNECTED_COMPONENT_SUBSET] THEN
        ASM_REWRITE_TAC [FRONTIER_EQ_EMPTY, CONNECTED_COMPONENT_EQ_EMPTY,
                        IN_DIFF, IN_UNIV, CONNECTED_COMPONENT_EQ_UNIV,
                        ← SET_RULE (← q r"UNIV DIFF s = UNIV <=> s = {}")] THEN
        REWRITE_TAC [frontier] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"c = s ==> c DIFF i SUBSET s")) THEN
        ASM_REWRITE_TAC [CLOSURE_EQ] THEN
        MATCH_MP_TAC CLOSED_CONNECTED_COMPONENT THEN
        ASM_REWRITE_TAC [← GSYM OPEN_CLOSED],
        DISCH_TAC THEN REWRITE_TAC [components, FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
        DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"?z:complex. z IN frontier s /\
                      z IN connected_component ((:real^2) DIFF s) w")
