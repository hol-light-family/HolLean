                      ((r:complex->complex) o (sq:complex->complex) o
                       (t:complex->complex) o (f:complex->complex))") THEN
          EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [ASM_SIMP_TAC [o_THM], ALL_TAC] THEN
