      CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:real^1") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        AP_TERM_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_DIFF],
        ASM_REWRITE_TAC []]))

  pure { HAS_PATH_INTEGRAL_WINDING_NUMBER_AC }
/- ------------------------------------------------------------------------- -/
/- Winding number vs homotopy in C - {z}; corollaries; Riemann mapping.      -/
/- (cauchy.ml 20852-21222)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYCC where
  WINDING_NUMBER_HOMOTOPIC_LOOPS_NULL_EQ : thm
  WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EXPLICIT_EQ : thm
  WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EQ : thm
  WINDING_NUMBER_HOMOTOPIC_PATHS_EQ : thm
  WINDING_NUMBER_HOMOTOPIC_LOOPS_EQ : thm
  HOMOTOPIC_LOOPS_PARTCIRCLEPATH : thm
  SIMPLY_CONNECTED_INSIDE_SIMPLE_PATH : thm
  HOMEOMORPHIC_INSIDE_SIMPLE_PATH_BALL : thm
  SIMPLY_CONNECTED_INTER : thm
  FINITE_ORDER_FUNDAMENTAL_GROUP_IMP_BORSUKIAN : thm
  FINITE_FUNDAMENTAL_GROUP_IMP_BORSUKIAN : thm
  RIEMANN_MAPPING_THEOREM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYCC [HolBase] (D : CauchyDeps) (BKYN : KYN) (BKYQ : KYQ) (BKYY : KYY) (BKYAB : KYAB) (BKYAD : KYAD) (BKYBX : KYBX) (BKYBY : KYBY) (BKYCA : KYCA) : ExceptT String IO KYCC := do
  -- @@SCOPE BEGIN
  let { WINDING_NUMBER_JOIN, WINDING_NUMBER_REVERSEPATH, WINDING_NUMBER_TRIVIAL,
        .. } := BKYN
  let { INTEGER_WINDING_NUMBER_EQ, .. } := BKYQ
  let { WINDING_NUMBER_HOMOTOPIC_LOOPS, WINDING_NUMBER_HOMOTOPIC_PATHS, .. } := BKYY
  let { PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS, PATH_PARTCIRCLEPATH, .. } := BKYAB
  let { WINDING_NUMBER_PARTCIRCLEPATH, .. } := BKYAD
  let { SIMPLY_CONNECTED_EQ_BIHOLOMORPHIC_TO_DISC,
        SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC, SIMPLY_CONNECTED_EQ_WINDING_NUMBER_ZERO,
        .. } := BKYBX
  let { SIMPLY_CONNECTED_EQ_EMPTY_INSIDE, .. } := BKYBY
  let { WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM, .. } := BKYCA
  let { COVERING_SPACE_CEXP_PUNCTURED_PLANE, .. } := D.mon
  let { BORSUKIAN_CONTINUOUS_LOGARITHM, .. } := D.mor
  let { HOMEOMORPHIC_BALLS, .. } := D.qtopology
  let { LT_EXISTS, .. } := D.qsession
  let { COVERING_SPACE_LIFT_STRONGER, fundamental_group, HOMOTOPIC_LOOPS_CONJUGATE,
        HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL, HOMOTOPIC_LOOPS_IMP_SUBSET,
        HOMOTOPIC_LOOPS_LINEAR, HOMOTOPIC_PATHS_CONTINUOUS_IMAGE,
        HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS, HOMOTOPIC_PATHS_IMP_PATHFINISH,
        HOMOTOPIC_PATHS_IMP_PATHSTART, HOMOTOPIC_PATHS_IMP_SUBSET, HOMOTOPIC_PATHS_JOIN,
        HOMOTOPIC_PATHS_LCANCEL, HOMOTOPIC_PATHS_LOOP_PARTS, HOMOTOPIC_PATHS_REFL,
        HOMOTOPIC_PATHS_RID, HOMOTOPIC_PATHS_SYM, HOMOTOPIC_PATHS_TRANS,
        INSIDE_INSIDE_EQ_EMPTY, PATH_COMPOSE_JOIN, PATH_CONNECTED_OPEN_DELETE,
        PATH_IMAGE_COMPOSE, PATHFINISH_COMPOSE, PATHSTART_COMPOSE, .. } := D.qpaths
  let { INSIDE_ARC_EMPTY, .. } := D.qdegree
  let { ITER, ITER_ADD, ITER_ALT, .. } := D.qiter
  let { INVARIANCE_OF_DOMAIN, JORDAN_INSIDE_OUTSIDE, .. } := D.mt.qpaths
  let { CEXP_0, CEXP_NZ, CONTINUOUS_ON_CEXP, .. } := D.mt.ra.tsa
  let { PI_POS, .. } := D.mt.ra.tse
  let { CEXP_CLOG, .. } := D.mt.ra.tsm
  let { num_INFINITE, .. } := D.mt.ra.qsession
  let { HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.kne
  let { homotopic_loops, HOMOTOPIC_LOOPS_TRANS, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT,
        LINEPATH_REFL, .. } := D.mt.ra.ts.qpaths
  let { SIMPLE_COMPLEX_ARITH_TAC, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RINV, COMPLEX_EQ_ADD_LCANCEL_0, COMPLEX_MUL_LID,
        COMPLEX_MUL_RZERO, COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, CX_ADD, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { OPEN_INSIDE, .. } := D.mt.ra.ts.cn.ms.qpaths
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_FIELD, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { INFINITE, .. } := D.mt.ra.ts.cn.cx.cpx
  let { CLOSED_PATH_IMAGE, PATH_CONTINUOUS_IMAGE, SUBSET_PATH_IMAGE_JOIN,
        .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { AND_FORALL_THM, DIMINDEX_2, FINITE_IMAGE_INJ_EQ, FINITE_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_UNWIND_THM2, IMP_CONJ, IMP_CONJ_ALT, IN_DELETE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_UNION, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP,
        REAL_ADD_LID, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_IMP_NZ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_SUC, RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { HOMEOMORPHIC_TRANS, IN_SPHERE, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTER, OPEN_UNIV, SEGMENT_REFL, TOPSPACE_EUCLIDEAN_SUBTOPOLOGY,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_connected, .. } := D.mt.ra.ts.cn.ms.ig.dv.qpaths
  let { HOMOTOPIC_WITH_EQ, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qmetric
  let { ARC_SIMPLE_PATH, CONNECTED_PATH_IMAGE, HOMOTOPIC_WITH_MONO,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path, PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH, PATH_IMAGE_REVERSEPATH, PATH_JOIN,
        PATH_LINEPATH, PATH_REVERSEPATH, pathfinish, PATHFINISH_IN_PATH_IMAGE,
        PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHFINISH_REVERSEPATH, pathstart,
        PATHSTART_IN_PATH_IMAGE, PATHSTART_JOIN, PATHSTART_LINEPATH, PATHSTART_REVERSEPATH,
        SIMPLE_PATH_IMP_PATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { WLOG_LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { CONNECTED_EMPTY, CONNECTED_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_EMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let WINDING_NUMBER_HOMOTOPIC_LOOPS_NULL_EQ ← prove
   r"!p z. path p /\ ~(z IN path_image p)
         ==> (winding_number(p,z) = Cx(&0) <=>
              ?a. homotopic_loops ((:complex) DELETE z) p (\t. a))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← SPECL [← q r"p:real^1->complex", ← q r"z:complex"]
            WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM) THEN
      ASM_REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_ADD_LID, COMPLEX_SUB_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"z + Cx(&1)") THEN
      MP_TAC (← ISPECL [← q r"\r:real^1->complex. pathfinish r = pathstart r",
                     ← q r"q:real^1->complex", ← q r"\t:real^1. Cx(&0)",
                     ← q r"\w. z + cexp w",
                     ← q r"interval[vec 0:real^1,vec 1]", ← q r"(:complex)",
                     ← q r"(:complex) DELETE z"]
       HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_LEFT) THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_CEXP, CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST,
                   CEXP_0, homotopic_loops, o_DEF] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [CEXP_NZ, COMPLEX_EQ_ADD_LCANCEL_0, ← SET_RULE
         (← q r"IMAGE f UNIV SUBSET UNIV DELETE z <=> !x. ~(f x = z)")] THEN
        MATCH_MP_TAC HOMOTOPIC_WITH_MONO THEN
        EXISTS_TAC (← q r"\r:real^1->complex. pathfinish r = pathstart r") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [← GSYM homotopic_loops] THEN
          MATCH_MP_TAC HOMOTOPIC_LOOPS_LINEAR THEN
          ASM_REWRITE_TAC [SUBSET_UNIV] THEN
          REWRITE_TAC [path, pathstart, pathfinish, CONTINUOUS_ON_CONST],
          SIMP_TAC [pathstart, pathfinish]],
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_EQ) THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEAN_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [o_THM, pathstart, pathfinish, ENDS_IN_UNIT_INTERVAL]],
      FIRST_ASSUM (MP_TAC o MATCH_MP WINDING_NUMBER_HOMOTOPIC_LOOPS) THEN
      ASM_REWRITE_TAC [← GSYM LINEPATH_REFL] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC WINDING_NUMBER_TRIVIAL THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_SUBSET) THEN
      REWRITE_TAC [← GSYM LINEPATH_REFL, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
      SET_TAC []])

  let WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EXPLICIT_EQ ← prove
   r"!p z. path p /\ ~(z IN path_image p)
         ==> (winding_number(p,z) = Cx(&0) <=>
              homotopic_paths ((:complex) DELETE z)
                              p (linepath(pathstart p,pathstart p)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [WINDING_NUMBER_HOMOTOPIC_LOOPS_NULL_EQ] THEN
      REWRITE_TAC [← GSYM LINEPATH_REFL, HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL,
                  LEFT_IMP_EXISTS_THM],
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP WINDING_NUMBER_HOMOTOPIC_PATHS) THEN
      ASM_REWRITE_TAC [← GSYM LINEPATH_REFL] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC WINDING_NUMBER_TRIVIAL THEN
      ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE]])

  let WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EQ ← prove
   r"!p z. path p /\ ~(z IN path_image p)
         ==> (winding_number(p,z) = Cx(&0) <=>
              ?a. homotopic_paths ((:complex) DELETE z) p (\t. a))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EXPLICIT_EQ] THEN
      REWRITE_TAC [← GSYM LINEPATH_REFL] THEN MESON_TAC [],
      STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP WINDING_NUMBER_HOMOTOPIC_PATHS) THEN
      ASM_REWRITE_TAC [← GSYM LINEPATH_REFL] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC WINDING_NUMBER_TRIVIAL THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
      REWRITE_TAC [← GSYM LINEPATH_REFL, PATH_IMAGE_LINEPATH, SEGMENT_REFL] THEN
      SET_TAC []])

  let WINDING_NUMBER_HOMOTOPIC_PATHS_EQ ← prove
   r"!p q z.
        path p /\ ~(z IN path_image p) /\
        path q /\ ~(z IN path_image q) /\
        pathstart q = pathstart p /\ pathfinish q = pathfinish p
        ==> (winding_number(p,z) = winding_number(q,z) <=>
             homotopic_paths ((:complex) DELETE z) p q)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [WINDING_NUMBER_HOMOTOPIC_PATHS] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"p ++ reversepath q:real^1->complex", ← q r"z:complex"]
          WINDING_NUMBER_HOMOTOPIC_PATHS_NULL_EQ) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_REVERSEPATH, PATH_IMAGE_JOIN, IN_UNION,
                 PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                  PATH_IMAGE_REVERSEPATH, WINDING_NUMBER_JOIN,
                 WINDING_NUMBER_REVERSEPATH, COMPLEX_ADD_RINV] THEN
    REWRITE_TAC [← GSYM LINEPATH_REFL] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
    ASM_REWRITE_TAC [PATHSTART_JOIN, PATHFINISH_JOIN,
                    PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                    PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o MATCH_MP
      (← REWRITE_RULE [IMP_CONJ] HOMOTOPIC_PATHS_LOOP_PARTS)) THEN
    ASM_REWRITE_TAC [])

  let WINDING_NUMBER_HOMOTOPIC_LOOPS_EQ ← prove
   r"!p q z.
        path p /\ pathfinish p = pathstart p /\ ~(z IN path_image p) /\
        path q /\ pathfinish q = pathstart q /\ ~(z IN path_image q)
        ==> (winding_number(p,z) = winding_number(q,z) <=>
             homotopic_loops ((:complex) DELETE z) p q)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [WINDING_NUMBER_HOMOTOPIC_LOOPS] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(pathstart p:complex = z) /\ ~(pathstart q = z)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(:complex)", ← q r"z:complex"]
          PATH_CONNECTED_OPEN_DELETE) THEN
    REWRITE_TAC [OPEN_UNIV, CONNECTED_UNIV, DIMINDEX_2, LE_REFL] THEN
    REWRITE_TAC [path_connected] THEN DISCH_THEN (MP_TAC o SPECL
     [← q r"pathstart p:complex", ← q r"pathstart q:complex"]) THEN
    ASM_REWRITE_TAC [IN_UNIV, IN_DELETE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real^1->complex") THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    STRIP_TAC THEN SUBGOAL_THEN (← q r"~(pathstart r:complex = z)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE],
      ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
    EXISTS_TAC (← q r"r ++ q ++ reversepath r:real^1->complex") THEN
    ASM_SIMP_TAC [HOMOTOPIC_LOOPS_CONJUGATE, ← SET_RULE
      (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS THEN
    ASM_REWRITE_TAC [PATHFINISH_JOIN, PATHFINISH_REVERSEPATH] THEN
    W (MP_TAC o PART_MATCH (rand o rand) WINDING_NUMBER_HOMOTOPIC_PATHS_EQ o
      snd) THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_REVERSEPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
                 PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                 PATH_IMAGE_JOIN, IN_UNION, PATH_IMAGE_REVERSEPATH,
                 WINDING_NUMBER_JOIN, WINDING_NUMBER_REVERSEPATH] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN SIMPLE_COMPLEX_ARITH_TAC)

  let HOMOTOPIC_LOOPS_PARTCIRCLEPATH ← prove
   r"!g z r n.
        path g /\ pathfinish g = pathstart g /\ ~(z IN path_image g) /\
        &0 < r /\ winding_number(g,z) = Cx(n)
        ==> homotopic_loops ((:complex) DELETE z)
                            g (partcirclepath(z,r,&0,&2 * n * pi))"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) WINDING_NUMBER_HOMOTOPIC_LOOPS_EQ o
      snd) THEN
    ASM_REWRITE_TAC [PATH_PARTCIRCLEPATH] THEN
    MATCH_MP_TAC (← TAUT
     (← q r"(q ==> p) /\ q /\ r ==> ((p /\ q ==> (r <=> s)) ==> s)")) THEN
    REPEAT CONJ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          INTEGER_WINDING_NUMBER_EQ)) THEN
      REWRITE_TAC [PATH_PARTCIRCLEPATH] THEN DISCH_THEN (SUBST1_TAC o SYM),
      MATCH_MP_TAC (← SET_RULE (← q r"!s. ~(z IN s) /\ t SUBSET s ==> ~(z IN t)")) THEN
      EXISTS_TAC (← q r"sphere(z:complex,abs r)") THEN
      ASM_REWRITE_TAC [PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS, IN_SPHERE] THEN
      REWRITE_TAC [DIST_REFL] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [WINDING_NUMBER_PARTCIRCLEPATH, REAL_LT_IMP_NZ] THEN
    SIMP_TAC [PI_POS, ← REAL_FIELD
     (← q r"&0 < p ==> (&2 * n * p - &0) / (&2 * p) = n")] THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
      INTEGER_WINDING_NUMBER_EQ) THEN
    ASM_REWRITE_TAC [])

  let SIMPLY_CONNECTED_INSIDE_SIMPLE_PATH ← prove
   r"!p:real^1->real^2.
     simple_path p ==> simply_connected(inside(path_image p))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP SIMPLE_PATH_IMP_PATH) THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_EMPTY_INSIDE,
                 OPEN_INSIDE, CLOSED_PATH_IMAGE, INSIDE_INSIDE_EQ_EMPTY,
                 CONNECTED_PATH_IMAGE] THEN
    ASM_CASES_TAC (← q r"pathstart(p):real^2 = pathfinish p") THEN
    ASM_SIMP_TAC [JORDAN_INSIDE_OUTSIDE, INSIDE_ARC_EMPTY, ARC_SIMPLE_PATH] THEN
    REWRITE_TAC [CONNECTED_EMPTY])

  let HOMEOMORPHIC_INSIDE_SIMPLE_PATH_BALL ← prove
   r"!p:real^1->real^2 a:real^2 r.
        simple_path p /\ pathfinish p = pathstart p /\ &0 < r
        ==> inside(path_image p) homeomorphic ball(a,r)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"inside(path_image p):real^2->bool")
          SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC) THEN
    MP_TAC (← ISPEC (← q r"p:real^1->real^2") JORDAN_INSIDE_OUTSIDE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_INSIDE_SIMPLE_PATH] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMEOMORPHIC_TRANS) THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_BALLS, REAL_LT_01])

  let SIMPLY_CONNECTED_INTER ← prove
   r"!s t:real^2->bool.
        open s /\ open t /\ simply_connected s /\ simply_connected t /\
        connected (s INTER t)
        ==> simply_connected (s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    SIMP_TAC [SIMPLY_CONNECTED_EQ_WINDING_NUMBER_ZERO, OPEN_INTER] THEN
    REWRITE_TAC [SUBSET, IN_INTER] THEN MESON_TAC [])

  let FINITE_ORDER_FUNDAMENTAL_GROUP_IMP_BORSUKIAN ← (do
    let lemma ← prove
     r"!n f p q. f o ITER n ((++) p) q = ITER n ((++) (f o p)) (f o q)"
     (INDUCT_TAC THEN ASM_REWRITE_TAC [ITER, PATH_COMPOSE_JOIN])
    let wemma ← prove
     r"!p z n.
          path p /\ pathfinish p = pathstart p /\ ~(z IN path_image p)
          ==> winding_number(ITER n ((++) p) p,z) =
              Cx(&n + &1) * winding_number(p,z)"
     (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN STRIP_TAC THEN
      INDUCT_TAC THEN ASM_REWRITE_TAC [ITER, COMPLEX_MUL_LID, REAL_ADD_LID] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) WINDING_NUMBER_JOIN o
          lhand o snd) THEN
      ASM_REWRITE_TAC [CX_ADD, ← GSYM REAL_OF_NUM_SUC] THEN
      ANTS_TAC THENL [ALL_TAC, CONV_TAC COMPLEX_RING] THEN
      CONV_TAC (ONCE_DEPTH_CONV SYM_CONV) THEN
      SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
      ASM_SIMP_TAC [ITER, PATH_JOIN, PATHSTART_JOIN, PATH_IMAGE_JOIN] THEN
      ASM SET_TAC [])
    prove
     r"!s a:real^N.
        path_connected s /\ locally path_connected s /\ a IN s /\
        (!p. path p /\ path_image p SUBSET s /\
             pathstart p = a /\ pathfinish p = a
             ==> ?n. homotopic_paths s (ITER n ((++) p) p) (linepath(a,a)))
         ==> borsukian s"
      (REPEAT STRIP_TAC THEN
      ASM_REWRITE_TAC [BORSUKIAN_CONTINUOUS_LOGARITHM] THEN
      X_GEN_TAC (← q r"f:real^N->complex") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"f:real^N->complex", ← q r"s:real^N->bool", ← q r"clog(f(a:real^N))", ← q r"a:real^N"]
       (← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] COVERING_SPACE_LIFT_STRONGER)
         COVERING_SPACE_CEXP_PUNCTURED_PLANE)) THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, IN_UNIV] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN CONJ_TAC THENL
       [CONV_TAC SYM_CONV THEN MATCH_MP_TAC CEXP_CLOG THEN ASM SET_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"p:real^1->real^N") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(f:real^N->complex) a") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^1->real^N")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"path((f:real^N->complex) o p)") ASSUME_TAC THENL
       [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"~(Cx(&0) IN path_image((f:real^N->complex) o p))")
      ASSUME_TAC THENL
       [REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"ITER n ((++) p) p:real^1->real^N", ← q r"linepath(a:real^N,a)",
        ← q r"f:real^N->complex", ← q r"s:real^N->bool",
        ← q r"(:real^2) DIFF {Cx (&0)}"]
            HOMOTOPIC_PATHS_CONTINUOUS_IMAGE) THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"s DIFF {a} = s DELETE a"), LINEPATH_REFL] THEN
      DISCH_THEN (MP_TAC o MATCH_MP WINDING_NUMBER_HOMOTOPIC_PATHS) THEN
      REWRITE_TAC [lemma] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) wemma o lhand o lhand o snd) THEN
      ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
      DISCH_THEN SUBST1_TAC THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ONCE_DEPTH_CONV) [o_DEF] THEN
      REWRITE_TAC [← GSYM LINEPATH_REFL] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) WINDING_NUMBER_TRIVIAL o
