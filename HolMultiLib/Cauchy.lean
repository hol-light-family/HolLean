      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, AND_FORALL_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g:real^1->complex", ← q r"h:real^1->complex"] THEN
      MAP_EVERY (fun (t : term) => ASM_CASES_TAC t THEN ASM_REWRITE_TAC [])
       [← q r"!t. t IN interval[vec 0,vec 1]
             ==> norm((g:real^1->complex) t - p t) < e / &3 /\
                 norm((h:real^1->complex) t - p t) < e / &3",
        ← q r"valid_path(g:real^1->complex)", ← q r"valid_path(h:real^1->complex)"] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"q /\ (p1 \/ p2 ==> q ==> r) ==> (p1 ==> q /\ r) /\ (p2 ==> q /\ r)")) THEN
