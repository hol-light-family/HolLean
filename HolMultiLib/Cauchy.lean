          ASM_SIMP_TAC [COMPLEX_NORM_POW, ABS_SQUARE_LT_1, REAL_ABS_NORM, o_THM],
          UNDISCH_THEN (← q r"(r:complex->complex) ((sq:complex->complex)
                        ((t:complex->complex) (f(Cx(&0))))) = Cx(&0)")
           (fun th => tactic_of do pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
          ASM_SIMP_TAC [o_THM] THEN
          UNDISCH_TAC (← q r"(f:complex->complex) IN ff") THEN EXPAND_TAC "ff" THEN
