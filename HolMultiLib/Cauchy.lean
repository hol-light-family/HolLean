  let { CENTRE_IN_BALL, CENTRE_IN_CBALL, CLOSED_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_MINIMAL, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, LIM_CONST, LIMPT_APPROACHABLE, OPEN_BALL, OPEN_CONTAINS_BALL,
        OPEN_CONTAINS_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, closure, continuous_at, SEQ_OFFSET, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_TRANSFORM, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { ADD_SUB, REAL_LT_TRANS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  -- ASSERT_TAC (misc.ml 16), local: CauchyDeps carries no MiscDeps.
  let ASSERT_TAC : term → tactic := fun tm => SUBGOAL_THEN tm STRIP_ASSUME_TAC


  let CAUCHY_INEQUALITY ← prove
   r"!f z r (B:real) n.
     f continuous_on cball(z,r) /\
     f holomorphic_on ball(z,r) /\ &0 < r /\
     (!x:complex. norm(z-x) = r ==> norm(f x) <= B)
     ==> norm (higher_complex_derivative n f z) <= &(FACT n) * B / r pow n"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"&0 <= B") ASSUME_TAC THENL
    [SUBGOAL_THEN (← q r"?x:complex. norm (z-x) = r") STRIP_ASSUME_TAC THENL [
    EXISTS_TAC (← q r"z + Cx r") THEN ASM_SIMP_TAC [COMPLEX_ADD_SUB2, NORM_NEG,
    COMPLEX_NORM_CX, REAL_ABS_REFL, REAL_LT_IMP_LE], ALL_TAC] THEN
    ASM_MESON_TAC [NORM_POS_LE, REAL_LE_TRANS],
    SUBGOAL_THEN (← q r"norm ((Cx(&2) * Cx pi * ii) / Cx(&(FACT n))
            * higher_complex_derivative n f z)
      <= (B / r pow (n + 1)) * &2 * pi * r") MP_TAC THENL [
    MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH THEN
    EXISTS_TAC (← q r"\u. (f:complex->complex) u / (u - z) pow (n + 1)") THEN
    EXISTS_TAC (← q r"z:complex") THEN CONJ_TAC THENL [MATCH_MP_TAC
    CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH THEN
    ASM_SIMP_TAC [CENTRE_IN_BALL], ALL_TAC] THEN CONJ_TAC THENL
    [MATCH_MP_TAC REAL_LE_DIV THEN ASM_SIMP_TAC
    [REAL_POW_LE, REAL_LT_IMP_LE], ALL_TAC] THEN ASM_REWRITE_TAC []
    THEN GEN_TAC THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_POW] THEN MATCH_MP_TAC
    REAL_LE_TRANS THEN EXISTS_TAC (← q r"B:real / r pow (n+1)") THEN
    ASM_SIMP_TAC [REAL_LE_DIV2_EQ, REAL_POW_LT, NORM_SUB, REAL_LE_REFL],
    REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_II,
    COMPLEX_NORM_CX, REAL_ABS_NUM, REAL_ABS_PI, REAL_MUL_RID, REAL_ABS_NUM]
    THEN SUBGOAL_THEN (← q r"B / r pow (n + 1) * &2 * pi * r =
                  (&2 * pi) / &(FACT n) * (((&(FACT n) * B) * r/ r pow (n+1)))")
    SUBST1_TAC THENL [SUBGOAL_THEN (← q r"~(&(FACT n) = &0)") MP_TAC THENL
    [REWRITE_TAC [FACT_NZ, REAL_OF_NUM_EQ], ALL_TAC]
    THEN CONV_TAC REAL_FIELD, SUBGOAL_THEN (← q r"&0 < (&2 * pi) / &(FACT n)") ASSUME_TAC
    THENL [MATCH_MP_TAC REAL_LT_DIV THEN SIMP_TAC [FACT_LT, REAL_OF_NUM_LT] THEN
    MP_TAC PI_POS THEN REAL_ARITH_TAC, SUBGOAL_THEN (← q r"(&(FACT n) * B) * r / r pow
    (n + 1) = &(FACT n) * B / r pow n") SUBST1_TAC THENL
    [REWRITE_TAC [← GSYM ADD1, real_pow] THEN MP_TAC (← ASSUME (← q r"&0 < r")) THEN
    CONV_TAC REAL_FIELD, ASM_MESON_TAC [REAL_LE_LCANCEL_IMP]]]]]])

  let LIOUVILLE_POLYNOMIAL ← prove
   r"!f A B n.
        f holomorphic_on (:complex) /\
        (!z. A <= norm(z) ==> norm(f z) <= B * norm(z) pow n)
        ==> !z. f(z) = vsum (0..n)
                            (\k. higher_complex_derivative k f (Cx(&0)) /
                                 Cx(&(FACT k)) * z pow k)"
   (REPEAT STRIP_TAC THEN DISJ_CASES_TAC (← REAL_ARITH (← q r"B <= &0 \/ &0 < B")) THENL
     [MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"Cx(&0)"] LIOUVILLE_WEAK) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC LIM_EVENTUALLY THEN
        REWRITE_TAC [EVENTUALLY_AT_INFINITY, real_ge] THEN
        EXISTS_TAC (← q r"A:real") THEN X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC (← NORM_ARITH
         (← q r"r <= &0 ==> norm z <= r ==> z = vec 0")) THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= --b * x ==> b * x <= &0")) THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        SIMP_TAC [NORM_POS_LE, REAL_POW_LE] THEN ASM_REAL_ARITH_TAC,
        GEN_REWRITE_TAC LAND_CONV [← GSYM FUN_EQ_THM] THEN
        DISCH_THEN SUBST1_TAC THEN
        ASM_REWRITE_TAC [HIGHER_COMPLEX_DERIVATIVE_CONST] THEN
        REWRITE_TAC [COND_ID, complex_div, COMPLEX_MUL_LZERO] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0, VSUM_0]],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← GSYM COMPLEX_SUB_0] THEN
    SUBGOAL_THEN
     (← q r"((\n. higher_complex_derivative n f (Cx(&0)) / Cx(&(FACT n)) *
            (z - Cx(&0)) pow n) sums f(z)) (from 0)")
    MP_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_POWER_SERIES THEN
      EXISTS_TAC (← q r"norm(z:complex) + &1") THEN
      REWRITE_TAC [COMPLEX_IN_BALL_0, ← REAL_ARITH (← q r"x < x + &1")] THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV],
      REWRITE_TAC [COMPLEX_SUB_RZERO] THEN DISCH_TAC] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"n + 1") o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [ADD_SUB, ← ARITH_RULE (← q r"0 < n + 1")] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SERIES_UNIQUE) THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC SUMS_0 THEN
    X_GEN_TAC (← q r"k:num") THEN
    REWRITE_TAC [IN_FROM, ← ARITH_RULE (← q r"n + 1 <= k <=> n < k")] THEN
    DISCH_TAC THEN REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_ENTIRE] THEN
    REWRITE_TAC [COMPLEX_DIV_EQ_0] THEN REPEAT DISJ1_TAC THEN
    MATCH_MP_TAC (← MESON [COMPLEX_NORM_NZ] (← q r"~(&0 < norm w) ==> w = Cx(&0)")) THEN
    DISCH_TAC THEN ABBREV_TAC
      (← q r"w = Cx(&(FACT k) *
              B / norm(higher_complex_derivative k f (Cx(&0))) +
              abs A + &1)") THEN
    SUBGOAL_THEN (← q r"~(w = Cx(&0))") ASSUME_TAC THENL
     [EXPAND_TAC "w" THEN REWRITE_TAC [CX_INJ] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> ~(x + abs a + &1 = &0)")) THEN
      MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_POS] THEN
      MATCH_MP_TAC REAL_LE_DIV THEN ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    MP_TAC (← SPECL
     [← q r"f:complex->complex", ← q r"Cx(&0)", ← q r"norm(w:complex)",
      ← q r"B * norm(w:complex) pow n", ← q r"k:num"]
     CAUCHY_INEQUALITY) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
                    SUBSET_UNIV],
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV],
      ASM_REWRITE_TAC [COMPLEX_NORM_NZ],
      REWRITE_TAC [COMPLEX_SUB_LZERO, NORM_NEG] THEN
      X_GEN_TAC (← q r"x:complex") THEN DISCH_THEN (fun th => tactic_of do pure (
       SUBST1_TAC (← SYM th) THEN ASSUME_TAC th)) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "w" THEN REWRITE_TAC [COMPLEX_NORM_CX] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= k ==> a <= abs(k + abs a + &1)")) THEN
      MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_POS] THEN
      MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE],
      REWRITE_TAC [← REAL_ARITH
       (← q r"~(d:real <= f * (b * n) / k) <=> f * b * (n / k) < d")] THEN
      ASM_SIMP_TAC [REAL_DIV_POW2, COMPLEX_NORM_ZERO] THEN
      ASM_REWRITE_TAC [REAL_MUL_ASSOC, ← GSYM NOT_LT] THEN
      ASM_SIMP_TAC [← GSYM real_div, REAL_LT_LDIV_EQ, COMPLEX_NORM_NZ,
                   REAL_POW_LT] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      ASM_SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, COMPLEX_NORM_NZ] THEN
      TRANS_TAC REAL_LTE_TRANS (← q r"norm(w:complex) pow 1") THEN CONJ_TAC THENL
       [EXPAND_TAC "w" THEN REWRITE_TAC [REAL_POW_1, COMPLEX_NORM_CX] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= k * B / d ==> (B * k) / d < abs(k * B / d + abs a + &1)")),
        MATCH_MP_TAC REAL_POW_MONO THEN
        CONJ_TAC THENL [ALL_TAC, ASM_ARITH_TAC] THEN
        EXPAND_TAC "w" THEN REWRITE_TAC [REAL_POW_1, COMPLEX_NORM_CX] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"&0 <= k * B / d ==> &1 <= abs(k * B / d + abs a + &1)"))] THEN
      MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_POS] THEN
      MATCH_MP_TAC REAL_LE_DIV THEN
      ASM_SIMP_TAC [NORM_POS_LE, REAL_LT_IMP_LE]])

  let LIOUVILLE_THEOREM ← prove
   r"!f. f holomorphic_on (:complex) /\ bounded (IMAGE f (:complex))
       ==> ?c. !z. f(z) = c"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [bounded]) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"&0", ← q r"B:real", ← q r"0"]
          LIOUVILLE_POLYNOMIAL) THEN
    ASM_SIMP_TAC [VSUM_CLAUSES_NUMSEG, real_pow, REAL_MUL_RID, complex_pow] THEN
    MESON_TAC [])

  /- A holomorphic function f has only isolated zeros unless f is 0. -/

  let ISOLATED_ZEROS ← prove
   r"!f a z w.
     open a /\ connected a /\ f holomorphic_on a /\ z IN a /\ f z = Cx(&0) /\
     w IN a /\ ~(f w = Cx(&0))
     ==> (?r. &0 < r /\ ball(z,r) SUBSET a /\
              (!w. w IN ball(z,r) /\ ~(w=z) ==> ~(f w = Cx(&0))))"
   (REPEAT STRIP_TAC THEN ASSERT_TAC (← q r"?k.
           ~(higher_complex_derivative k f z = Cx(&0)) /\
           (!n. n < k ==> higher_complex_derivative n f z = Cx(&0))") THENL
    [EXISTS_TAC (← q r"minimal n. (~(higher_complex_derivative n f z = Cx(&0)))")
    THEN SUBGOAL_THEN (← q r"?k'. ~(higher_complex_derivative k' f z = Cx(&0))")
    (fun th => ASM_MESON_TAC [th, MINIMAL]) THEN REWRITE_TAC [← GSYM NOT_FORALL_THM]
    THEN STRIP_TAC THEN ASM_MESON_TAC [HOLOMORPHIC_FUN_EQ_0_ON_CONNECTED],
    ALL_TAC] THEN SUBGOAL_THEN (← q r"~(k = 0)") ASSUME_TAC THENL
    [STRIP_TAC THEN MP_TAC (← ASSUME (← q r"~(higher_complex_derivative k f z = Cx(&0))"))
    THEN ASM_MESON_TAC [higher_complex_derivative],
    STRIP_ASSUME_TAC (← MESON [OPEN_CONTAINS_BALL, ← ASSUME (← q r"open (a:complex->bool)"),
    ← ASSUME (← q r"z:complex IN a")] (← q r"?s. &0 < s /\ ball (z:complex,s) SUBSET a"))
    THEN ASSUME_TAC (← MESON [HOLOMORPHIC_POWER_SERIES,
    ← ASSUME (← q r"f holomorphic_on a"), ← ASSUME (← q r"ball (z:complex,s)
    SUBSET a"), HOLOMORPHIC_ON_SUBSET] (← q r"!w:complex. w IN ball(z,s) ==>
    ((\n. higher_complex_derivative n f z / Cx(&(FACT n))*(w -z) pow n) sums f w)
    (from 0)")) THEN ASSERT_TAC (← q r"?g:complex->complex. !x:complex.
                  x IN ball(z,s) ==>
          (((\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
            (x - z) pow (n-k))) sums g x) (from k)") THENL
    [EXISTS_TAC (← q r"\x:complex. lim sequentially
    (\m. vsum (k..m) (\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    (x - z) pow (n-k)))") THEN GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!m. k..m = (0..m) INTER from k") ASSUME_TAC THENL
    [REWRITE_TAC [EXTENSION, IN_FROM, IN_INTER, IN_ELIM_THM, IN_NUMSEG] THEN
    ARITH_TAC, ASM_REWRITE_TAC [] THEN REWRITE_TAC
    [← SET_RULE (← q r"!m. (0..m) INTER from k = from k INTER (0..m)"), SUMS_LIM]] THEN
    ASM_CASES_TAC (← q r"x:complex = z") THENL
    [ASM_REWRITE_TAC [COMPLEX_SUB_REFL, summable] THEN
    EXISTS_TAC (← q r"higher_complex_derivative k f z / Cx(&(FACT k))") THEN
    MATCH_MP_TAC SUMS_EQ THEN EXISTS_TAC (← q r"\n. if n = k then
    higher_complex_derivative k f z / Cx(&(FACT k)) else Cx(&0)")
    THEN CONJ_TAC THENL [REWRITE_TAC [IN_FROM] THEN GEN_TAC THEN DISCH_TAC
    THEN COND_CASES_TAC THENL
    [ASM_REWRITE_TAC [COMPLEX_POW_ZERO, SUB_REFL, COMPLEX_MUL_RID],
    ASM_SIMP_TAC [COMPLEX_POW_ZERO, ← ARITH_RULE (← q r"k <= x' /\ ~(x' = k) ==>
    ~(x' - k = 0)"), COMPLEX_MUL_RZERO]], MATCH_MP_TAC SERIES_VSUM THEN
    EXISTS_TAC (← q r"{k:num}") THEN SIMP_TAC [FINITE_SING, «from», IN_SING,
    COMPLEX_VEC_0, VSUM_SING] THEN SET_TAC [LE_REFL]],
    MATCH_MP_TAC SUMMABLE_EQ THEN EXISTS_TAC
    (← q r"\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    (x - z) pow n / (x-z) pow k") THEN CONJ_TAC THENL [REWRITE_TAC [IN_FROM]
    THEN GEN_TAC THEN DISCH_TAC THEN SUBGOAL_THEN (← q r"(x:complex - z) pow (x' - k)
    = (x - z) pow x' / (x - z) pow k") (fun th =>
    REWRITE_TAC [th, COMPLEX_EQ_MUL_LCANCEL]) THEN MATCH_MP_TAC
    COMPLEX_DIV_POW THEN ASM_SIMP_TAC [COMPLEX_SUB_0],
    SUBGOAL_THEN (← q r"(\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    (x - z) pow n / (x - z) pow k) = (\n. (higher_complex_derivative n f z /
    Cx(&(FACT n)) *(x - z) pow n) / (x - z) pow k) ") SUBST1_TAC
    THENL [REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN CONV_TAC COMPLEX_FIELD,
    MATCH_MP_TAC SUMMABLE_COMPLEX_DIV THEN MATCH_MP_TAC SUMMABLE_FROM_ELSEWHERE
    THEN EXISTS_TAC (← q r"0") THEN ASM_MESON_TAC [summable]]]], ALL_TAC] THEN
    ASSERT_TAC (← q r"~(g (z:complex) = Cx(&0)) /\
    (!x. x IN ball(z,s) ==> f x = (x - z) pow k * g(x))") THENL
    [CONJ_TAC THENL [MATCH_MP_TAC
    (← ExceptT.mk (COMPLEX_FIELD (← q r"!x y:complex. x = y /\ ~(y= Cx(&0)) ==> ~(x=Cx(&0))"))) THEN
    EXISTS_TAC (← q r"higher_complex_derivative k f z / Cx(&(FACT k))") THEN
    CONJ_TAC THENL [ONCE_REWRITE_TAC [← GSYM COMPLEX_SUB_0] THEN
    MATCH_MP_TAC SERIES_UNIQUE THEN EXISTS_TAC
    (← q r"(\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    Cx(&0) pow (n-k))") THEN EXISTS_TAC (← q r"from (k +1)") THEN
    CONJ_TAC THENL [SUBST1_TAC (← MESON [VSUM_SING_NUMSEG]
    (← q r"higher_complex_derivative k f z / Cx(&(FACT k)) =
    vsum (k..k) (\n. higher_complex_derivative n f z / Cx(&(FACT n))) "))
    THEN SUBGOAL_THEN  (← q r"vsum (k..k)  (\n. higher_complex_derivative n f z
    / Cx(&(FACT n))) = vsum (k..((k+1)-1)) (\n. higher_complex_derivative n f z
    / Cx(&(FACT n)) * Cx(&0) pow (n - k))") SUBST1_TAC THENL [
    REWRITE_TAC [VSUM_SING_NUMSEG, COMPLEX_POW_ZERO, SUB_REFL, COMPLEX_MUL_RID,
    ← ARITH_RULE (← q r"((k:num) + 1) -1 = k")],
    MATCH_MP_TAC SUMS_OFFSET THEN
    ASM_REWRITE_TAC [← ARITH_RULE (← q r"k:num <= k+1 /\ 0 < k+1")]
    THEN POP_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL, COMPLEX_SUB_REFL]], MATCH_MP_TAC
    SUMS_COMPLEX_0 THEN GEN_TAC THEN SIMP_TAC [IN_FROM, COMPLEX_POW_ZERO,
    ← ARITH_RULE (← q r"k + 1 <= n <=> ~(n-k= 0)"), COMPLEX_MUL_RZERO]],
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD (← q r"!x y. ~(x = Cx(&0)) /\ ~(y = Cx(&0))
    ==> ~(x / y = Cx(&0))"))) THEN ASM_REWRITE_TAC [← GSYM COMPLEX_NORM_ZERO] THEN
    SUBST1_TAC (← MESON [COMPLEX_NORM_CX]
    (← q r"norm (Cx(&(FACT k))) = abs ((&(FACT k)))")) THEN
    SIMP_TAC [REAL_ABS_ZERO, FACT_LT, REAL_OF_NUM_LT, REAL_LT_IMP_NZ]], ALL_TAC]
    THEN GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC SERIES_UNIQUE THEN
    EXISTS_TAC (← q r"(\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    (x - z) pow n)") THEN EXISTS_TAC (← q r"(from 0)") THEN
    CONJ_TAC  THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
    ASM_CASES_TAC (← q r"x:complex = z") THENL [
    ASM_REWRITE_TAC [COMPLEX_SUB_REFL] THEN MATCH_MP_TAC SUMS_EQ THEN
    EXISTS_TAC (← q r"\n:num. Cx(&0)") THEN  CONJ_TAC THENL
    [REWRITE_TAC [IN_FROM, COMPLEX_POW_ZERO] THEN X_GEN_TAC (← q r"n:num") THEN
    DISCH_TAC THEN  COND_CASES_TAC THENL [
    ASM_REWRITE_TAC [higher_complex_derivative] THEN CONV_TAC COMPLEX_FIELD,
    REWRITE_TAC [COMPLEX_MUL_RZERO]],
    ASM_REWRITE_TAC [COMPLEX_POW_ZERO, COMPLEX_MUL_LZERO] THEN
    ASM_REWRITE_TAC [SERIES_0, ← GSYM COMPLEX_VEC_0]], ALL_TAC] THEN
    MATCH_MP_TAC SUMS_EQ THEN EXISTS_TAC (← q r"\n.(x-z) pow k *
    higher_complex_derivative n f z / Cx(&(FACT n)) *(x - z) pow (n - k)")
    THEN CONJ_TAC THENL [REWRITE_TAC [IN_FROM] THEN X_GEN_TAC (← q r"n:num")
    THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"n:num < k") THENL [ASM_SIMP_TAC []
    THEN CONV_TAC COMPLEX_FIELD,
    SUBGOAL_THEN (← q r"(x:complex-z) pow (n-k) = (x-z) pow n / (x-z) pow k")
    SUBST1_TAC THENL [MATCH_MP_TAC COMPLEX_DIV_POW THEN
    ASM_SIMP_TAC [COMPLEX_SUB_0, ← ARITH_RULE (← q r"~(n:num < k) ==> k <= n")],
    SUBST1_TAC (← ExceptT.mk (COMPLEX_FIELD (← q r"(x - z) pow k *
       higher_complex_derivative n f z / Cx(&(FACT n)) *
       (x - z) pow n / (x - z) pow k =
           higher_complex_derivative n f z / Cx(&(FACT n)) * (x-z) pow k *
       (x - z) pow n / (x - z) pow k"))) THEN MESON_TAC [← ASSUME (← q r"~(x:complex = z)"),
    COMPLEX_DIV_LMUL, COMPLEX_SUB_0, COMPLEX_POW_EQ_0]]],
    MATCH_MP_TAC SERIES_COMPLEX_LMUL THEN SUBST1_TAC
    (← MESON [COMPLEX_ADD_RID] (← q r"(g:complex->complex) x = g x + Cx(&0)")) THEN
    SUBGOAL_THEN (← q r"Cx(&0) = vsum (0.. (k-1))
    (\n. higher_complex_derivative n f z / Cx(&(FACT n)) * (x - z) pow (n - k))")
    SUBST1_TAC THENL [ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC VSUM_EQ_0 THEN
    REWRITE_TAC [IN_NUMSEG] THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r" ~(k = 0) /\ n <= k - 1 ==> n < k")] THEN
    REWRITE_TAC [COMPLEX_VEC_0] THEN CONV_TAC COMPLEX_FIELD,
    MATCH_MP_TAC SUMS_OFFSET_REV THEN
    ASM_SIMP_TAC [← ARITH_RULE (← q r"0 <= k /\ ~(k = 0) ==> 0 < k"), LE_0]]]], ALL_TAC] THEN
    ASSERT_TAC (← q r"?r. &0 < r /\ (!x:complex. dist (z,x) < r ==>
                  ~((g:complex->complex) x = Cx(&0)))") THENL [
    MATCH_MP_TAC CONTINUOUS_ON_OPEN_AVOID THEN
    EXISTS_TAC (← q r"ball(z:complex, s)") THEN
    ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL]
    THEN MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
    MATCH_MP_TAC ANALYTIC_IMP_HOLOMORPHIC THEN MATCH_MP_TAC POWER_SERIES_ANALYTIC
    THEN EXISTS_TAC (← q r"\n. higher_complex_derivative (n+k) f z / Cx(&(FACT (n+k)))")
    THEN EXISTS_TAC (← q r"from 0") THEN REWRITE_TAC [] THEN GEN_TAC THEN DISCH_TAC
    THEN REWRITE_TAC [SERIES_FROM] THEN MATCH_MP_TAC LIM_TRANSFORM THEN
    EXISTS_TAC (← q r"(\n.vsum (k..(k+n))
    (\n. higher_complex_derivative n f z / Cx(&(FACT n)) *(w' - z) pow (n-k)))")
    THEN CONJ_TAC THENL [SIMP_TAC [VSUM_OFFSET_0, ← ARITH_RULE
    (← q r"!k n :num.(k + n) - k = n"), ← ARITH_RULE (← q r"!k n:num. k <= k + n"), ADD_ASSOC,
    ← ARITH_RULE (← q r"!k n :num.(n + k) - k = n")] THEN
    SUBGOAL_THEN (← q r"(\x. vsum (0..x) (\i. higher_complex_derivative (i + k)
           f z / Cx(&(FACT (i + k))) * (w' - z) pow i)
           - vsum (0..x) (\n. higher_complex_derivative (n + k) f z
          / Cx(&(FACT (n + k))) * (w' - z) pow n)) = (\x. Cx(&0))")
          (fun th => SIMP_TAC [th, COMPLEX_VEC_0, LIM_CONST]) THEN
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN REWRITE_TAC [COMPLEX_SUB_0],
    SUBGOAL_THEN (← q r"(\n. vsum (k..k + n)
    (\n. higher_complex_derivative n f z / Cx(&(FACT n)) *(w' - z) pow (n - k)))
    = (\n. vsum (k..n+k)(\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
    (w' - z) pow (n - k)))") SUBST1_TAC THENL [
    REWRITE_TAC [FUN_EQ_THM] THEN GEN_TAC THEN REWRITE_TAC [ADD_SYM],
    MP_TAC (← ISPECL [← q r"(\n. vsum (k..n)
          (\n. higher_complex_derivative n f z / Cx(&(FACT n)) *
          (w' - z) pow (n - k)))", ← q r"(g:complex->complex) w'", ← q r"k:num"]
    SEQ_OFFSET) THEN ONCE_REWRITE_TAC [← GSYM SERIES_FROM] THEN ASM_SIMP_TAC []]],
    ALL_TAC] THEN EXISTS_TAC (← q r"min r s") THEN CONJ_TAC THENL
    [MP_TAC (← CONJ (← ASSUME (← q r"&0 < r")) (← ASSUME (← q r"&0 < s"))) THEN REAL_ARITH_TAC,
    CONJ_TAC THENL [REWRITE_TAC [real_min] THEN COND_CASES_TAC
    THENL [MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(z:complex,s)")
    THEN ASM_REWRITE_TAC [ball] THEN SET_TAC [← ASSUME (← q r"r:real <= s"), REAL_LTE_TRANS],
    ASM_REWRITE_TAC []], GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:complex->complex) w' =
                  (w' - z) pow k * (g:complex->complex) w'") SUBST1_TAC
     THENL [FIRST_ASSUM MATCH_MP_TAC THEN
    MP_TAC (← ASSUME (← q r"w':complex IN ball (z,min r s)")) THEN REWRITE_TAC [real_min]
    THEN COND_CASES_TAC THENL [ASM_MESON_TAC [IN_BALL, REAL_LTE_TRANS],
    REWRITE_TAC []], SIMP_TAC [COMPLEX_ENTIRE, DE_MORGAN_THM] THEN
    CONJ_TAC THENL  [REWRITE_TAC [COMPLEX_POW_EQ_0, DE_MORGAN_THM]
    THEN DISJ1_TAC THEN ASM_REWRITE_TAC [COMPLEX_SUB_0],
    FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC (← ASSUME (← q r"w':complex IN
    ball (z,min r s)")) THEN REWRITE_TAC [real_min] THEN COND_CASES_TAC
    THENL [REWRITE_TAC [IN_BALL],
    ASM_MESON_TAC [REAL_NOT_LE, IN_BALL, REAL_LT_TRANS]]]]]]])

  /- Analytic continuation. -/

  let ANALYTIC_CONTINUATION ← prove
   r"!f a u z.
     open a /\ connected a /\ f holomorphic_on a /\ u SUBSET a /\ z IN a /\
     z limit_point_of u /\ (!w. w IN u ==> f w = Cx(&0))
     ==> (!w. w IN a ==> f w = Cx(&0))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [← TAUT (← q r" (p ==> q) <=> ~( p /\ (~ q))"), ← GSYM NOT_EXISTS_THM]
    THEN STRIP_TAC THEN SUBGOAL_THEN  (← q r"(f:complex->complex) z = Cx(&0)")
    ASSUME_TAC THENL [STRIP_ASSUME_TAC (← MESON [OPEN_CONTAINS_CBALL,
    ← ASSUME (← q r"open (a:complex->bool)"), ← ASSUME (← q r"z:complex IN a")]
    (← q r"?e. &0 < e /\ cball (z:complex,e) SUBSET a")) THEN ABBREV_TAC
    (← q r"s = cball(z:complex,e) INTER (u:complex->bool)") THEN
    ASSERT_TAC (← q r"f:complex->complex continuous_on closure s /\
                  (!x:complex. x IN s ==> f x = Cx(&0)) /\
                  z:complex IN closure s")
    THENL [CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"a:complex->bool") THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN MATCH_MP_TAC
    SUBSET_TRANS THEN EXISTS_TAC (← q r"cball(z:complex,e)") THEN
    ASM_MESON_TAC [CLOSED_CBALL, INTER_SUBSET, CLOSURE_MINIMAL],
    CONJ_TAC THENL [ASM_MESON_TAC [INTER_SUBSET, SUBSET],
    ASM_SIMP_TAC [closure, IN_UNION] THEN DISJ2_TAC THEN SUBGOAL_THEN
    (← q r"z:complex limit_point_of s") (fun thm => SET_TAC [thm]) THEN
    REWRITE_TAC [LIMPT_APPROACHABLE] THEN GEN_TAC THEN DISCH_TAC THEN
    ASSERT_TAC (← q r"?x:complex. x IN u /\ ~(x = z) /\ dist (x , z) < min e' e")
    THENL [MP_TAC (← ISPECL [← q r"z:complex", ← q r"u:complex->bool"] LIMPT_APPROACHABLE)
    THEN ASM_SIMP_TAC [REAL_LT_MIN], EXISTS_TAC (← q r"x:complex") THEN ASM_REWRITE_TAC []
    THEN CONJ_TAC THENL
    [REWRITE_TAC [← GSYM (← ASSUME (← q r"cball (z:complex,e) INTER u = s")), IN_INTER,
    ← ASSUME (← q r"x:complex IN u"), IN_CBALL] THEN ASM_MESON_TAC [REAL_LT_IMP_LE,
    REAL_LT_MIN, DIST_SYM], ASM_MESON_TAC [REAL_LT_MIN]]]]],
    ASM_MESON_TAC [CONTINUOUS_CONSTANT_ON_CLOSURE]],
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex->bool", ← q r"z:complex", ← q r"w:complex"]
    ISOLATED_ZEROS) THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?x:complex. x IN ball(z,r) /\ x IN u /\ ~(x=z) /\
      (f:complex->complex) x = Cx(&0)") (fun thm => ASM_MESON_TAC [thm]) THEN
    MP_TAC (← ISPECL [← q r"z:complex", ← q r"u:complex->bool"] LIMPT_APPROACHABLE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN POP_ASSUM (MP_TAC o SPEC (← q r"r:real"))
    THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THEN EXISTS_TAC (← q r"x':complex")
    THEN ASM_MESON_TAC [IN_BALL, DIST_SYM]])

  let HOLOMORPHIC_FUNCTION_ENTIRE ← prove
   r"!f g s.
        open s /\ connected s /\
        f continuous_on s /\ g holomorphic_on s /\
        (!z. z IN s ==> f z * g z = Cx(&0))
        ==> (!z. z IN s ==> f z = Cx(&0)) \/
            (!z. z IN s ==> g z = Cx(&0))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← MESON [] (← q r"(!x. P x) \/ (!x. Q x) <=> !x. ~P x ==> !x. Q x")] THEN
    X_GEN_TAC (← q r"a:complex") THEN REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"f:complex->complex") o MATCH_MP
     CONTINUOUS_ON_EQ_CONTINUOUS_AT) THEN
    ASM_REWRITE_TAC [continuous_at] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"norm((f:complex->complex) a)")) THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_NZ] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC ANALYTIC_CONTINUATION THEN
    MAP_EVERY EXISTS_TAC [← q r"ball(a:complex,min d e)", ← q r"a:complex"] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_BALL]) THEN
    ASM_SIMP_TAC [SUBSET, IN_BALL, REAL_LT_MIN] THEN
    ASM_SIMP_TAC [LIMPT_BALL, CENTRE_IN_CBALL, REAL_LT_MIN, REAL_LT_IMP_LE] THEN
    X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex"))) THEN
    ASM_CASES_TAC (← q r"(z:complex) IN s") THEN ASM_SIMP_TAC [] THEN
    ONCE_REWRITE_TAC [DIST_SYM, COMPLEX_ENTIRE] THEN
    ASM_REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN CONV_TAC (fun t => NORM_ARITH t))

  let HOLOMORPHIC_FUNCTION_ENTIRE_PRODUCT ← prove
   r"!f s k:A->bool.
        open s /\ connected s /\ FINITE k /\ ~(k = {}) /\
        (!i. i IN k ==> f i holomorphic_on s) /\
        (!z. z IN s ==> cproduct k (\i. f i z) = Cx(&0))
        ==> ?i. i IN k /\ !z. z IN s ==> f i z = Cx(&0)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REPEAT GEN_TAC THEN REPEAT DISCH_TAC THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, EXISTS_IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"i:A", ← q r"k:A->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC, NOT_INSERT_EMPTY] THEN
    ASM_SIMP_TAC [CPRODUCT_CLAUSES] THEN  ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_REWRITE_TAC [CPRODUCT_CLAUSES, COMPLEX_MUL_RID] THEN SIMP_TAC [] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do pure (
      MP_TAC (← PART_MATCH (funpowM 4 rand o lhand) HOLOMORPHIC_FUNCTION_ENTIRE
          (concl th)))) THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, ETA_AX] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_CPRODUCT] THEN MATCH_MP_TAC MONO_OR THEN
    REWRITE_TAC [] THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [])

  pure { CAUCHY_INEQUALITY, LIOUVILLE_POLYNOMIAL, LIOUVILLE_THEOREM, ISOLATED_ZEROS,
         ANALYTIC_CONTINUATION, HOLOMORPHIC_FUNCTION_ENTIRE,
         HOLOMORPHIC_FUNCTION_ENTIRE_PRODUCT }
/- ------------------------------------------------------------------------- -/
/- Open mapping theorem.                                                     -/
/- (cauchy.ml 12733-13026)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBD where
  OPEN_MAPPING_THM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBD [HolBase] (D : CauchyDeps) (BKYBC : KYBC) : ExceptT String IO KYBD := do
  -- @@SCOPE BEGIN
  let { ANALYTIC_CONTINUATION, CAUCHY_INEQUALITY, ISOLATED_ZEROS, .. } := BKYBC
  let { FRONTIER_SUBSET_CLOSED, INTERIOR_LIMIT_POINT, .. } := D.qtopology
  let { CHOICE_DEF, RAT_LEMMA4, .. } := D.qsession
  let { CONTINUOUS_COMPLEX_INV_WITHIN, .. } := D.mt.ra.ts.knc
  let { higher_complex_derivative, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_INV, HOLOMORPHIC_ON_SUB, .. } := D.mt.ra.ts.knh
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { COMPLEX_ADD_SUB2, COMPLEX_SUB_0, COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_INV, COMPLEX_NORM_NZ, COMPLEX_NORM_TRIANGLE_SUB, COMPLEX_NORM_ZERO,
        .. } := D.mt.ra.ts.cn.cxf
  let { FACT, .. } := D.mt.ra.ts.cn.qsession
  let { CONNECTED_CONNECTED_COMPONENT, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { OPEN_UNIONS, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_MUL_RINV_UNIQ, .. } := D.mt.ra.ts.cn.cx.cpx
  let { IMAGE_UNIONS, .. } := D.mt.ra.ts.cn.ms.ig.qsession
  let { BETA_THM, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMAGE_EQ_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, MEMBER_NOT_EMPTY, REAL_ABS_REFL, REAL_DIV_1, REAL_DIV_LMUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MUL,
        REAL_LTE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_NOT_LE, SUBSET, SUBSET_EMPTY, SUBSET_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_pow, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_NEG, NORM_POS_LT, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BALL_SUBSET_CBALL, CBALL_EQ_EMPTY, CENTRE_IN_BALL, CLOSED_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_FRONTIER, CONNECTED_COMPONENT_SUBSET,
        CONTINUOUS_ATTAINS_INF, CONTINUOUS_ATTAINS_SUP, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_LIFT_NORM,
        CONTINUOUS_ON_SUBSET, FRONTIER_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, INTERIOR_OPEN, OPEN_CONTAINS_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { UNIONS_COMPONENTS, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { OPEN_COMPONENTS, OPEN_CONNECTED_COMPONENT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { REAL_LT_TRANS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { CONNECTED_COMPONENT_EQ_EMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { IN_COMPONENTS, OPEN_EMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  -- ASSERT_TAC (misc.ml 16), local: CauchyDeps carries no MiscDeps.
  let ASSERT_TAC : term → tactic := fun tm => SUBGOAL_THEN tm STRIP_ASSUME_TAC


  let OPEN_MAPPING_THM ← (do
    let LEMMA_ZERO ← prove
     r"!f z r. f continuous_on cball(z,r) /\ f holomorphic_on ball(z,r) /\
        &0 < r /\ (!w. norm(z-w) =r ==> norm(f z) < norm(f w))
        ==> (?w. w IN ball(z,r) /\ f w = Cx(&0))"
     (REPEAT STRIP_TAC THEN SUBGOAL_THEN  (← q r" ((!x:complex. x IN ball(z,r) ==>
     ~((f:complex->complex) x = Cx(&0))) ==> F ) ==> ( ?w:complex. w IN ball(z,r)
     /\ f w = Cx(&0))") MATCH_MP_TAC THENL [MESON_TAC [],
     STRIP_TAC THEN SUBGOAL_THEN (← q r"&0 < norm ((f:complex->complex) z)") ASSUME_TAC
     THENL [ASM_SIMP_TAC [COMPLEX_NORM_NZ, CENTRE_IN_BALL, ← SPEC (← q r"z:complex")
     (← ASSUME (← q r"!x:complex. x IN ball(z,r) ==> ~((f:complex->complex) x = Cx(&0))"))],
     ALL_TAC] THEN SUBGOAL_THEN
       (← q r"(!x:complex. x IN cball(z,r) ==> ~((f:complex->complex) x = Cx(&0)))")
     ASSUME_TAC THENL [GEN_TAC THEN REWRITE_TAC [IN_CBALL, dist]
     THEN REWRITE_TAC [← REAL_ARITH (← q r"a <= b <=> a < b \/ a = b")] THEN
     REWRITE_TAC [← TAUT (← q r"((p \/ q) ==> r ) <=> ((p ==> r ) /\ (q ==> r))")] THEN
     CONJ_TAC THENL [ASM_MESON_TAC [IN_BALL, dist],
     DISCH_TAC THEN REWRITE_TAC [← GSYM COMPLEX_NORM_ZERO] THEN MATCH_MP_TAC
     REAL_LT_IMP_NZ THEN MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC
     (← q r"norm ((f:complex->complex) z)") THEN
     ASM_SIMP_TAC [← SPEC (← q r"z':complex") (← ASSUME (← q r"!w:complex. norm (w - z) = r
                   ==> norm ((f:complex->complex) z) < norm (f w)"))]],
     ALL_TAC] THEN SUBGOAL_THEN (← q r"~(frontier(cball(z:complex,r))={})") ASSUME_TAC
     THENL [REWRITE_TAC [FRONTIER_CBALL, sphere, dist] THEN SUBGOAL_THEN (← q r"?x:complex.
     norm(z-x) = r") (fun th => SET_TAC [MEMBER_NOT_EMPTY, th]) THEN EXISTS_TAC
     (← q r"z + Cx r") THEN ASM_SIMP_TAC [COMPLEX_ADD_SUB2, NORM_NEG, COMPLEX_NORM_CX,
     REAL_ABS_REFL, REAL_LT_IMP_LE], ALL_TAC] THEN
     ABBREV_TAC (← q r"g = \z. inv ((f:complex->complex) z)") THEN ASSERT_TAC
     (← q r"(g:complex->complex) continuous_on cball(z,r) /\ g holomorphic_on ball(z,r)")
      THENL [CONJ_TAC THENL [EXPAND_TAC "g" THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN GEN_TAC THEN DISCH_TAC
     THEN MATCH_MP_TAC CONTINUOUS_COMPLEX_INV_WITHIN THEN ASM_MESON_TAC
     [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN], EXPAND_TAC "g" THEN MATCH_MP_TAC
     HOLOMORPHIC_ON_INV THEN ASM_REWRITE_TAC []], ALL_TAC] THEN
     SUBGOAL_THEN (← q r"?w:complex. w IN frontier(cball(z,r)) /\
                   (!x:complex. x IN frontier(cball(z,r)) ==>
                   norm ((f:complex->complex) w) <= norm (f x))")
     STRIP_ASSUME_TAC THENL [MATCH_MP_TAC CONTINUOUS_ATTAINS_INF
     THEN ASM_SIMP_TAC [COMPACT_FRONTIER, COMPACT_CBALL, CBALL_EQ_EMPTY,
     ← REAL_ARITH (← q r"!r:real. &0 < r ==> ~(r < &0)") ] THEN
     SUBGOAL_THEN (← q r"lift o (\x. norm ((f:complex->complex) x)) =
                    (lift o norm) o (\x. f x) ") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF], MATCH_MP_TAC CONTINUOUS_ON_COMPOSE
     THEN CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC
     (← q r"cball(z:complex,r)") THEN ASM_REWRITE_TAC [ETA_AX] THEN
     ASM_SIMP_TAC [SUBSET_TRANS, CLOSED_CBALL, FRONTIER_SUBSET_CLOSED],
     ASM_MESON_TAC [CONTINUOUS_ON_LIFT_NORM, HOLOMORPHIC_ON_SUBSET,
     HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, SUBSET_TRANS, CLOSED_CBALL,
     FRONTIER_SUBSET_CLOSED]]], ALL_TAC] THEN
