          ASM_REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
          CONJ_TAC THEN MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT THENL
           [EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [],
