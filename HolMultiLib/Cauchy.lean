        REMOVE_THEN "*" (K ALL_TAC) THEN
        DISCH_THEN (CHOOSE_THEN (LABEL_TAC "*"))] THEN
      MP_TAC (← ISPEC (← q r"d:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!n. n <= N
            ==> path_integral(subpath (vec 0) (&n / &N % vec 1) h) f -
