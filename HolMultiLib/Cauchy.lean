         [MATCH_MP_TAC FORALL_IN_CLOSURE THEN
          REWRITE_TAC [CLOSED_CBALL, CONTINUOUS_ON_ID, IN_CBALL] THEN
          REPEAT STRIP_TAC THEN
          TRANS_TAC REAL_LE_TRANS (← q r"diameter(E:complex->bool)") THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC DIST_LE_DIAMETER THEN
          ASM_REWRITE_TAC [],
          MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
          REWRITE_TAC [IN_BALL, IN_CBALL] THEN ASM_REAL_ARITH_TAC],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?c. c IN {(f:complex->complex) z,f z'} /\ ~(c IN ball(a,e / &2))")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [EXISTS_IN_INSERT, NOT_IN_EMPTY, IN_BALL] THEN
        UNDISCH_TAC (← q r"e <= dist((f:complex->complex) z',f z)") THEN
        CONV_TAC (fun t => NORM_ARITH t),
        ALL_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"B:complex->bool", ← q r"(:complex) DIFF s", ← q r"c:complex",
        ← q r"f(Cx(&0)):complex"] JANISZEWSKI) THEN
      ASM_REWRITE_TAC [← GSYM OPEN_CLOSED] THEN
      REWRITE_TAC [COMPL_COMPL] THEN
      REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN REPEAT CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"connected(closure E:complex->bool)") MP_TAC THENL
         [ASM_SIMP_TAC [CONNECTED_CLOSURE], ALL_TAC] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN EXPAND_TAC "B" THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"!a b. a IN e /\ b IN e /\ s INTER e = {} /\ p DIFF {a,b} SUBSET s
                ==> e = (p UNION e) INTER (UNIV DIFF s)")) THEN
        MAP_EVERY EXISTS_TAC [← q r"a:complex", ← q r"b:complex"] THEN
        ASM_SIMP_TAC [CLOSURE_INC, OPEN_INTER_CLOSURE_EQ_EMPTY] THEN
        CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [path_image]] THEN
        MAP_EVERY EXPAND_TAC ["a", "b"] THEN
        REWRITE_TAC [pathstart, pathfinish] THEN MATCH_MP_TAC (← SET_RULE
         (← q r"IMAGE f (i DIFF {a,b}) SUBSET s
          ==> IMAGE f i DIFF {f a,f b} SUBSET s")) THEN
        REWRITE_TAC [← GSYM OPEN_CLOSED_INTERVAL_1] THEN ASM SET_TAC [],
        REWRITE_TAC [connected_component] THEN
        EXISTS_TAC (← q r"(:complex) DIFF ball(a,e / &2)") THEN
        SIMP_TAC [CONNECTED_COMPLEMENT_BOUNDED_CONVEX, DIMINDEX_2, ARITH,
                 BOUNDED_BALL, CONVEX_BALL] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ASM_REWRITE_TAC [IN_DIFF, IN_UNIV]] THEN
        REWRITE_TAC [IN_BALL, REAL_NOT_LT] THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
        TRANS_TAC REAL_LE_TRANS (← q r"setdist({f(Cx(&0)):complex},frontier s)") THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
        ASM_REWRITE_TAC [IN_SING],
        REWRITE_TAC [connected_component] THEN EXISTS_TAC (← q r"s:complex->bool") THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN CONJ_TAC THENL
         [EXPAND_TAC "s" THEN MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
          ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, CONNECTED_BALL],
          SUBGOAL_THEN (← q r"{Cx(&0),z,z'} SUBSET ball(Cx(&0),&1)") MP_TAC THENL
           [ALL_TAC, ASM SET_TAC []] THEN
          REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CENTRE_IN_BALL] THEN
          REWRITE_TAC [REAL_LT_01, COMPLEX_IN_BALL_0] THEN
          MAP_EVERY UNDISCH_TAC [← q r"(z:complex) IN A", ← q r"(z':complex) IN A"] THEN
          EXPAND_TAC "A" THEN REWRITE_TAC [IN_ELIM_THM] THEN SIMP_TAC []],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(:complex) DIFF (B UNION (:complex) DIFF s) = s DIFF path_image fg")
      SUBST1_TAC THENL
       [EXPAND_TAC "B" THEN MATCH_MP_TAC (← SET_RULE
         (← q r"s INTER e = {}
          ==> UNIV DIFF ((p UNION e) UNION (UNIV DIFF s)) = s DIFF p")) THEN
        ASM_SIMP_TAC [OPEN_INTER_CLOSURE_EQ_EMPTY] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM OPEN_PATH_CONNECTED_COMPONENT, OPEN_DIFF,
                  CLOSED_PATH_IMAGE] THEN
      ONCE_REWRITE_TAC [PATH_COMPONENT_SYM_EQ] THEN REWRITE_TAC [path_component] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
      ABBREV_TAC (← q r"q = (f':complex->complex) o (p:real^1->complex)") THEN
      SUBGOAL_THEN (← q r"path_image q SUBSET ball(Cx(&0),&1) DIFF path_image g")
      ASSUME_TAC THENL
       [EXPAND_TAC "q" THEN REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN
        TRANS_TAC SUBSET_TRANS
         (← q r"IMAGE (f':complex->complex) (s DIFF path_image fg)") THEN
        ASM_SIMP_TAC [IMAGE_SUBSET, BALL_SUBSET_CBALL, ← SET_RULE
        (← q r"b SUBSET c ==> b DIFF (c INTER s) = b DIFF s")] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"(!z. z IN b ==> f'(f z) = z) /\ IMAGE f b = s /\
          IMAGE f (b INTER p) SUBSET p'
          ==> IMAGE f' (s DIFF p') SUBSET (b DIFF p)")) THEN
        ASM_REWRITE_TAC [] THEN TRANS_TAC SUBSET_TRANS
         (← q r"IMAGE (f:complex->complex) (IMAGE g (interval(vec 0:real^1,vec 1)))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC IMAGE_SUBSET THEN REWRITE_TAC [OPEN_CLOSED_INTERVAL_1] THEN
          MATCH_MP_TAC (← SET_RULE
           (← q r"~(g a IN s) /\ ~(g b IN s) /\ s SUBSET IMAGE g i
            ==> s SUBSET IMAGE g (i DIFF {a,b})")) THEN
          ASM_REWRITE_TAC [← GSYM path_image, IN_INTER] THEN
          CONJ_TAC THENL [ASM_MESON_TAC [pathstart], ALL_TAC] THEN
          CONJ_TAC THENL [ASM_MESON_TAC [pathfinish], ALL_TAC] THEN
          MP_TAC (← ISPECL [← q r"Cx(&0)", ← q r"&1"] BALL_SUBSET_CBALL) THEN SET_TAC [],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"(!x. x IN i ==> f(g x) = fg x)
            ==> IMAGE fg i SUBSET s
                ==> IMAGE f (IMAGE g i) SUBSET s"))) THEN
          REWRITE_TAC [path_image] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED]],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"path_image q:complex->bool", ← q r"cball(z:complex,r)"]
            CONNECTED_INTER_FRONTIER) THEN
      REWRITE_TAC [NOT_IMP, FRONTIER_CBALL] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_PATH_IMAGE THEN EXPAND_TAC "q" THEN
        MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOLOMORPHIC_ON_SUBSET)) THEN
        ASM SET_TAC [],
        REWRITE_TAC [path_image, ← GSYM MEMBER_NOT_EMPTY] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_INTER] THEN
        EXISTS_TAC (← q r"vec 1:real^1") THEN REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        SUBST1_TAC (← SYM (← ISPEC (← q r"q:real^1->complex") pathfinish)) THEN
        EXPAND_TAC "q" THEN REWRITE_TAC [PATHFINISH_COMPOSE] THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"{z,z'} SUBSET cball(z,r) INTER ball(Cx(&0),&1)") MP_TAC THENL
         [ALL_TAC, ASM SET_TAC []] THEN
        MAP_EVERY UNDISCH_TAC [← q r"(z:complex) IN A", ← q r"(z':complex) IN A"] THEN
        EXPAND_TAC "A" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        SIMP_TAC [INSERT_SUBSET, EMPTY_SUBSET, IN_INTER, COMPLEX_IN_BALL_0] THEN
        REPEAT (DISCH_THEN (K ALL_TAC : thm → tactic)) THEN
        ASM_SIMP_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE] THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] IN_CBALL] THEN ASM_REAL_ARITH_TAC,
        REWRITE_TAC [path_image, ← GSYM MEMBER_NOT_EMPTY] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_DIFF] THEN
        EXISTS_TAC (← q r"vec 0:real^1") THEN REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
        SUBST1_TAC (← SYM (← ISPEC (← q r"q:real^1->complex") pathstart)) THEN
        EXPAND_TAC "q" THEN REWRITE_TAC [PATHSTART_COMPOSE] THEN
        ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"Cx(&0)", ← q r"&1"] CENTRE_IN_BALL) THEN
        ASM_SIMP_TAC [REAL_LT_01] THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"(z:complex) IN A") THEN EXPAND_TAC "A" THEN
        REWRITE_TAC [IN_ELIM_THM, IN_CBALL, dist, COMPLEX_SUB_RZERO] THEN
        ASM_REAL_ARITH_TAC,
        UNDISCH_TAC (← q r"path_image q SUBSET ball(Cx(&0),&1) DIFF path_image g") THEN
        ASM_SIMP_TAC [BALL_SUBSET_CBALL, ← SET_RULE
         (← q r"b SUBSET c ==> b DIFF (c INTER s) = b DIFF s")] THEN
        SET_TAC []]))

  pure { TORHORST_CONFORMAL_EXTENSION_THEOREM }
/- ------------------------------------------------------------------------- -/
/- Caratheodory's conformal extension lemma.                                 -/
/- (cauchy.ml 22899-23237)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYCE where
  CARATHEODORY_CONFORMAL_EXTENSION_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYCE [HolBase] (D : CauchyDeps) (BKYAE : KYAE) (BKYBF : KYBF) (BKYBL : KYBL) : ExceptT String IO KYCE := do
  -- @@SCOPE BEGIN
  let { PATH_IMAGE_CIRCLEPATH, PATHFINISH_CIRCLEPATH, PATHSTART_CIRCLEPATH,
        SIMPLE_PATH_CIRCLEPATH, .. } := BKYAE
  let { FRONTIER_PROPER_HOLOMORPHIC_IMAGE, HOLOMORPHIC_CONSTANT_ON_SPHERE_SEGMENT,
        .. } := BKYBF
  let { HOLOMORPHIC_ON_INVERSE, .. } := BKYBL
  let { BOUNDED_HALFSPACE_LT, FRONTIER_UNION_INTERIOR, INTERIOR_HALFSPACE_GE,
        .. } := D.qtopology
  let { ARC_LINEPATH, CONNECTED_SIMPLE_PATH_IMAGE_DELETE, PATH_IMAGE_COMPOSE,
        PATHFINISH_COMPOSE, PATHSTART_COMPOSE, .. } := D.qpaths
  let { AFF_DIM_2, AFF_LOWDIM_SUBSET_HYPERPLANE, CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED,
        OPEN_SEGMENT_SUBSET_BALL, .. } := D.qconvex
  let { CONNECTED_SPHERE_EQ, JORDAN_INSIDE_OUTSIDE, .. } := D.mt.qpaths
  let { COMPLEX_IN_BALL_0, COMPLEX_IN_CBALL_0, COMPLEX_IN_SPHERE_0, .. } := D.mt.ra.ts.kna
  let { HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.kne
  let { COMPLEX_NORM_CX, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { CONVEX_HALFSPACE_GT, CONVEX_HALFSPACE_LT, .. } := D.mt.ra.ts.cn.qconvex
  let { SEGMENT_EQ_EMPTY, .. } := D.mt.ra.ts.cn.ms.qconvex
  let { ASM_MESON_TAC, HAS_SIZE_CONV, INT_ARITH_TAC, INT_REDUCE_CONV, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, PATH_CONTINUOUS_IMAGE, simple_path, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { CLOSED_OPEN_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { ARITH, ARITH_EQ, DIMINDEX_2, EMPTY_SUBSET, EXTENSION,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_INSERT, FORALL_IN_UNION, FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_UNION,
        IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_DIFF, INJECTIVE_ON_ALT, INSERT_SUBSET,
        INTER_COMM, INTER_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INTER, IN_UNION, MEMBER_NOT_EMPTY, MONO_AND, NOT_IMP, NOT_IN_EMPTY,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, REAL_LT_01, REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, REAL_POS, RIGHT_FORALL_IMP_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_THM, real_gt, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_P, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { BOUNDED_BALL, BOUNDED_HALFSPACE_GT, BOUNDED_SUBSET, CBALL_DIFF_SPHERE,
        CLOSED_CBALL, CLOSURE_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, CONNECTED_CONTINUOUS_IMAGE, CONNECTED_INTER_FRONTIER,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, ENDS_IN_SEGMENT, FRONTIER_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, IN_SEGMENT, INTERIOR_OPEN, MIDPOINT_IN_SEGMENT, OPEN_BALL,
        OPEN_HALFSPACE_GT, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { connected, frontier, OPEN_HALFSPACE_LT, OPEN_IN_OPEN_INTER,
        OPEN_INTER_CLOSURE_EQ_EMPTY, SEGMENT_CLOSED_OPEN, SEGMENT_OPEN_SUBSET_CLOSED,
        SUBSET_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { CONVEX_CONNECTED, RELATIVE_FRONTIER_CBALL, SEGMENT_SUBSET_CONVEX,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qconvex
  let { arc, PATH_IMAGE_LINEPATH, PATH_LINEPATH, pathfinish, PATHFINISH_LINEPATH,
        pathstart, PATHSTART_LINEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { BALL_UNION_SPHERE, CONNECTED_INTERMEDIATE_CLOSURE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_INTER_CLOSURE_SUBSET, SPHERE_SUBSET_CBALL,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { INTER_ASSOC, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  let { INTERIOR_HALFSPACE_LE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  let { AFF_DIM_EQ_AFFINE_HULL, AFF_DIM_HYPERPLANE, AFF_DIM_SEGMENT, AFFINE_HYPERPLANE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx1
  let { CONVEX_BALL, CONVEX_CBALL, CONVEX_INTER, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { RELATIVE_INTERIOR_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let CARATHEODORY_CONFORMAL_EXTENSION_LEMMA ← prove
   r"!f s a.
        f holomorphic_on ball(Cx(&0),&1) /\
        f continuous_on cball(Cx(&0),&1) /\
        IMAGE f (ball(Cx(&0),&1)) = s /\
        (!w z. w IN ball(Cx(&0),&1) /\ z IN ball(Cx(&0),&1) /\ f w = f z
               ==> w = z) /\
        a IN closure s
        ==> ({x | x IN cball(Cx(&0),&1) /\ f x = a} HAS_SIZE 1 <=>
             connected (frontier(s) DELETE a))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"ball(Cx(&0),&1)"]
      HOLOMORPHIC_ON_INVERSE) THEN
    ASM_REWRITE_TAC [OPEN_BALL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [INJECTIVE_ON_ALT]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f':complex->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"ball(Cx(&0),&1)"]
      FRONTIER_PROPER_HOLOMORPHIC_IMAGE) THEN
    ASM_REWRITE_TAC [OPEN_BALL, CONNECTED_BALL, BOUNDED_BALL] THEN
    ASM_SIMP_TAC [CLOSURE_BALL, FRONTIER_BALL, REAL_LT_01] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"k:complex->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | x IN ball(Cx (&0),&1) /\ (f:complex->complex) x IN k} =
        IMAGE f' k")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                    CONTINUOUS_ON_SUBSET],
      DISCH_THEN (ASSUME_TAC o SYM)] THEN
    ASM_CASES_TAC (← q r"(a:complex) IN s") THENL
     [SUBGOAL_THEN (← q r"~((a:complex) IN frontier s)") ASSUME_TAC THENL
       [ASM_SIMP_TAC [frontier, IN_DIFF, INTERIOR_OPEN],
        ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")]] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ p ==> (p <=> q)")) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [CONNECTED_SPHERE_EQ, DIMINDEX_2, ARITH] THEN
        ASM_MESON_TAC [SPHERE_SUBSET_CBALL, CONTINUOUS_ON_SUBSET],
        ASM_SIMP_TAC [← GSYM BALL_UNION_SPHERE, ← SET_RULE
         (← q r"~(a IN IMAGE f s)
          ==> {x | x IN b UNION s /\ f x = a} = {x | x IN b /\ f x = a}")] THEN
        CONV_TAC HAS_SIZE_CONV THEN EXISTS_TAC (← q r"(f':complex->complex) a") THEN
        ASM SET_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(a:complex) IN frontier s") ASSUME_TAC THENL
     [ASM_SIMP_TAC [frontier, IN_DIFF, INTERIOR_OPEN], ALL_TAC] THEN
    ASM_SIMP_TAC [← GSYM BALL_UNION_SPHERE, ← SET_RULE
     (← q r"~(a IN IMAGE f b)
      ==> {x | x IN b UNION s /\ f x = a} = {x | x IN s /\ f x = a}")] THEN
    CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"u:complex") MP_TAC) THEN DISCH_THEN (MP_TAC o
       MATCH_MP (← SET_RULE
        (← q r"{x | x IN s /\ f x = y} = {a}
         ==> IMAGE f s DELETE y = IMAGE f (s DELETE a)"))) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SPHERE_SUBSET_CBALL,
                      ← SET_RULE (← q r"s SUBSET t ==> s DELETE a SUBSET t")],
        MP_TAC (← ISPECL [← q r"circlepath(Cx(&0),&1)", ← q r"u:complex"]
          CONNECTED_SIMPLE_PATH_IMAGE_DELETE) THEN
        SIMP_TAC [SIMPLE_PATH_CIRCLEPATH, PATH_IMAGE_CIRCLEPATH, REAL_OF_NUM_EQ,
                 REAL_POS, ARITH] THEN
        REWRITE_TAC [PATHSTART_CIRCLEPATH, PATHFINISH_CIRCLEPATH]],
      DISCH_TAC] THEN
    MATCH_MP_TAC (← SET_RULE
     (← q r"a IN IMAGE f s /\
      (!u v. ~(u IN s /\ v IN s /\ f u = a /\ f v = a /\ ~(u = v)))
      ==> ?w. {x | x IN s /\ f x = a} = {w}")) THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"segment(u,v) SUBSET ball(Cx(&0),&1)") ASSUME_TAC THENL
     [MATCH_MP_TAC OPEN_SEGMENT_SUBSET_BALL THEN
      RULE_ASSUM_TAC (REWRITE_RULE [COMPLEX_IN_SPHERE_0]) THEN
      ASM_REWRITE_TAC [COMPLEX_IN_CBALL_0, REAL_LE_REFL],
      ALL_TAC] THEN
    MP_TAC (← SPEC
     (← q r"(f:complex->complex) o linepath(u,v)") JORDAN_INSIDE_OUTSIDE) THEN
    ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE, PATH_IMAGE_COMPOSE,
      PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [REWRITE_TAC [simple_path] THEN CONJ_TAC THENL
       [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        REWRITE_TAC [PATH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)) THEN
        MATCH_MP_TAC SEGMENT_SUBSET_CONVEX THEN
        RULE_ASSUM_TAC (REWRITE_RULE [COMPLEX_IN_SPHERE_0]) THEN
        ASM_REWRITE_TAC [CONVEX_CBALL, COMPLEX_IN_CBALL_0, REAL_LE_REFL],
        SIMP_TAC [CLOSED_OPEN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
        SUBGOAL_THEN
         (← q r"!x. x IN interval(vec 0,vec 1) ==> linepath(u,v) x IN ball(Cx(&0),&1)")
        ASSUME_TAC THENL
         [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
          DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE
           (← q r"!t. x IN t /\ t SUBSET s ==> x IN s")) THEN
          EXISTS_TAC (← q r"segment(u:complex,v)") THEN
          ASM_REWRITE_TAC [linepath, IN_SEGMENT] THEN ASM_MESON_TAC [],
          ALL_TAC] THEN
        REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_UNION] THEN
        REWRITE_TAC [o_THM, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
        SUBST1_TAC (← SYM (← ISPEC (← q r"linepath(u:complex,v)") pathstart)) THEN
        SUBST1_TAC (← SYM (← ISPEC (← q r"linepath(u:complex,v)") pathfinish)) THEN
        ASM_REWRITE_TAC [PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        X_GEN_TAC (← q r"y:real^1") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (fun th =>
          W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
        ASM_SIMP_TAC [] THEN DISCH_THEN SUBST1_TAC THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"u:complex", ← q r"v:complex"] ARC_LINEPATH) THEN
        ASM_REWRITE_TAC [arc, PATH_LINEPATH] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:real^1", ← q r"y:real^1"]) THEN
        ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
        ASM_SIMP_TAC [CLOSED_OPEN_INTERVAL_1, DROP_VEC, REAL_POS] THEN
        ASM_REWRITE_TAC [IN_UNION]],
      ALL_TAC] THEN
    MAP_EVERY ABBREV_TAC
     [← q r"A = inside(IMAGE (f:complex->complex) (segment[u,v]))",
      ← q r"B = outside(IMAGE (f:complex->complex) (segment[u,v]))"] THEN
    STRIP_TAC THEN
    UNDISCH_TAC (← q r"connected(frontier s DELETE (a:complex))") THEN
    REWRITE_TAC [connected] THEN
    MAP_EVERY EXISTS_TAC [← q r"A:complex->bool", ← q r"B:complex->bool"] THEN
    ASM_REWRITE_TAC [← GSYM INTER_ASSOC, INTER_EMPTY] THEN CONJ_TAC THENL
     [REWRITE_TAC [SEGMENT_CLOSED_OPEN] THEN
      ASM_REWRITE_TAC [IMAGE_UNION, IMAGE_CLAUSES] THEN MATCH_MP_TAC (← SET_RULE
       (← q r"IMAGE f i INTER r = {}
        ==> r DELETE a SUBSET UNIV DIFF (IMAGE f i UNION {a,a})")) THEN
      ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?p q. ~(p = vec 0) /\
                        segment[u,v] SUBSET {z:complex | p dot z = q}")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC AFF_LOWDIM_SUBSET_HYPERPLANE THEN
      REWRITE_TAC [AFF_DIM_SEGMENT, DIMINDEX_2] THEN INT_ARITH_TAC,
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"cball(Cx(&0),&1)", ← q r"u:complex", ← q r"v:complex"]
          CONVEX_LINE_INTERSECTION_UNIQUE_CLOSED) THEN
    ASM_REWRITE_TAC [CONVEX_CBALL, CLOSED_CBALL, RELATIVE_FRONTIER_CBALL,
                    REAL_OF_NUM_EQ, ARITH_EQ, RELATIVE_INTERIOR_CBALL] THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"~(s = {}) /\ s SUBSET t ==> ~(s INTER t = {})")) THEN
      ASM_REWRITE_TAC [SEGMENT_EQ_EMPTY],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"{u:complex,v}", ← q r"{z:complex | p dot z = q}"]
          AFF_DIM_EQ_AFFINE_HULL) THEN
    ASM_REWRITE_TAC [AFF_DIM_2, INSERT_SUBSET, EMPTY_SUBSET] THEN
    ASM_SIMP_TAC [AFFINE_HYPERPLANE, AFF_DIM_HYPERPLANE, HULL_P] THEN
    REWRITE_TAC [DIMINDEX_2] THEN CONV_TAC INT_REDUCE_CONV THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET, ENDS_IN_SEGMENT], DISCH_THEN SUBST1_TAC] THEN
    DISCH_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"C = {x | x IN cball(Cx(&0),&1) /\ ~(f x:complex = a)} INTER
           {x | p dot x < q}",
      ← q r"D = {x | x IN cball(Cx(&0),&1) /\ ~(f x:complex = a)} INTER
           {x | p dot x > q}"] THEN
    SUBGOAL_THEN
     (← q r"connected(C:complex->bool) /\ connected(D:complex->bool)")
    STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["C", "D"] THEN CONJ_TAC THEN
      MATCH_MP_TAC CONNECTED_INTERMEDIATE_CLOSURE THENL
       [EXISTS_TAC (← q r"ball(Cx(&0),&1) INTER {x | p dot x < q}"),
        EXISTS_TAC (← q r"ball(Cx(&0),&1) INTER {x | p dot x > q}")] THEN
      SIMP_TAC [CONVEX_CONNECTED, CONVEX_INTER, CONVEX_BALL,
               CONVEX_HALFSPACE_LT, CONVEX_HALFSPACE_GT] THEN
      (CONJ_TAC THENL
        [REWRITE_TAC [← GSYM BALL_UNION_SPHERE] THEN ASM SET_TAC [], ALL_TAC]) THEN
      ONCE_REWRITE_TAC [INTER_COMM] THEN  MATCH_MP_TAC (← SET_RULE
       (← q r"u SUBSET closure t INTER s /\
         s INTER closure t SUBSET closure(s INTER t)
        ==> u SUBSET closure(s INTER t)")) THEN
      SIMP_TAC [OPEN_INTER_CLOSURE_SUBSET,
               OPEN_HALFSPACE_LT, OPEN_HALFSPACE_GT] THEN
      SIMP_TAC [CLOSURE_BALL, REAL_LT_01] THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:complex->complex) C INTER IMAGE f (segment [u,v]) = {} /\
      IMAGE f D INTER IMAGE f (segment[u,v]) = {}")
    STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["C", "D"] THEN CONJ_TAC THEN
      REWRITE_TAC [SEGMENT_CLOSED_OPEN, ← GSYM BALL_UNION_SPHERE] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"f u = a /\ f v = a /\ ~(a IN IMAGE f b) /\
        IMAGE f s INTER IMAGE f b = {} /\ i SUBSET b /\ i INTER h = {} /\
        (!x y. x IN b /\ y IN b ==> (f x = f y <=> x = y))
        ==> IMAGE f ({x | x IN b UNION s /\ ~(f x = a)} INTER h) INTER
            IMAGE f (i UNION {u,v}) = {}")) THEN
      ASM_REWRITE_TAC [] THEN ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN
      REWRITE_TAC [← SET_RULE (← q r"(t DIFF s) INTER s = {}")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"segment[u,v] SUBSET p
        ==> segment(u,v) SUBSET segment[u,v] /\ p INTER h = {}
