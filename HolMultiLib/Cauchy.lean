         [MATCH_MP_TAC SIMPLE_PATH_SUBPATH THEN
          ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN ASM_MESON_TAC [],
          ALL_TAC]) THEN
        ASM_REWRITE_TAC [SIMPLE_PATH_LINEPATH_EQ, PATH_IMAGE_LINEPATH] THEN
        REPEAT CONJ_TAC THENL
         [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
          SIMP_TAC [DROP_VEC, PATH_IMAGE_SUBPATH] THEN
          ONCE_REWRITE_TAC [← GSYM PATH_IMAGE_REVERSEPATH] THEN
          REWRITE_TAC [REVERSEPATH_SUBPATH] THEN
          SIMP_TAC [DROP_VEC, PATH_IMAGE_SUBPATH] THEN STRIP_TAC THEN
          MATCH_MP_TAC (← SET_RULE
            (← q r"a IN s /\ a IN t /\ b IN s /\ b IN t /\
             (!x. x IN s ==> !y. y IN t ==> x = y ==> x = a \/ x = b)
             ==> s INTER t = {a,b}")) THEN
          REPEAT CONJ_TAC THENL
           [REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"vec 0:real^1") THEN
            ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"vec 1:real^1") THEN
            ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"t:real^1") THEN
            ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"t:real^1") THEN
            ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
            ASM_REAL_ARITH_TAC,
            ALL_TAC] THEN
          REWRITE_TAC [FORALL_IN_IMAGE, IN_INTERVAL_1, DROP_VEC] THEN
          X_GEN_TAC (← q r"s:real^1") THEN STRIP_TAC THEN
          X_GEN_TAC (← q r"u:real^1") THEN STRIP_TAC THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [simple_path]) THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"s:real^1", ← q r"u:real^1"] o CONJUNCT2) THEN
          ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
          ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          DISCH_THEN (REPEAT_TCL DISJ_CASES_THEN
            (REPEAT_TCL CONJUNCTS_THEN SUBST_ALL_TAC)) THEN
          ASM_REWRITE_TAC [] THEN SUBGOAL_THEN (← q r"drop u = drop t") MP_TAC THENL
           [ASM_REAL_ARITH_TAC, ASM_MESON_TAC [DROP_EQ]],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"p INTER s = {a,b}
            ==> a IN q /\ b IN q /\ q SUBSET p ==> q INTER s = {a,b}"))) THEN
          ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET, SIMPLE_PATH_IMP_PATH,
                       ENDS_IN_UNIT_INTERVAL] THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
          SIMP_TAC [DROP_VEC, PATH_IMAGE_SUBPATH] THEN STRIP_TAC THEN
          REWRITE_TAC [IN_IMAGE] THEN CONJ_TAC THENL
           [EXISTS_TAC (← q r"vec 0:real^1"), EXISTS_TAC (← q r"t:real^1")] THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
          ASM_REAL_ARITH_TAC,
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"p INTER s = {a,b}
            ==> a IN q /\ b IN q /\ q SUBSET p ==> q INTER s = {a,b}"))) THEN
          ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET, SIMPLE_PATH_IMP_PATH,
                       ENDS_IN_UNIT_INTERVAL] THEN
          ONCE_REWRITE_TAC [← GSYM PATH_IMAGE_REVERSEPATH] THEN
          REWRITE_TAC [REVERSEPATH_SUBPATH] THEN
          FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
          SIMP_TAC [DROP_VEC, PATH_IMAGE_SUBPATH] THEN STRIP_TAC THEN
          REWRITE_TAC [IN_IMAGE] THEN CONJ_TAC THENL
           [EXISTS_TAC (← q r"vec 1:real^1"), EXISTS_TAC (← q r"t:real^1")] THEN
          ASM_REWRITE_TAC [ENDS_IN_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
          EXISTS_TAC (← q r"a:complex") THEN
          ASM_REWRITE_TAC [← GSYM BETWEEN_IN_SEGMENT, between] THEN
          REWRITE_TAC [← NORM_ARITH (← q r"dist(a - d:complex,a + e) = norm(d + e)"),
                ← NORM_ARITH (← q r"dist(a - d:complex,a) = norm(d)"),
                ← NORM_ARITH (← q r"dist(a:complex,a + e) = norm e")] THEN
          ASM_SIMP_TAC [← GSYM VECTOR_ADD_RDISTRIB, NORM_MUL,
                   NORM_BASIS, DIMINDEX_2, ARITH] THEN
          ASM_REAL_ARITH_TAC,
          ONCE_REWRITE_TAC [← GSYM PATH_IMAGE_REVERSEPATH] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [PATH_IMAGE_LINEPATH]) THEN
          ASM_REWRITE_TAC [REVERSEPATH_SUBPATH],
          W (MP_TAC o PART_MATCH (rand o rand) WINDING_NUMBER_REVERSEPATH o
            rand o snd) THEN
          ANTS_TAC THENL
           [ASM_SIMP_TAC [PATH_JOIN_EQ, PATH_IMAGE_JOIN, PATH_LINEPATH,
              SIMPLE_PATH_IMP_PATH, PATHSTART_LINEPATH, PATHFINISH_SUBPATH,
              PATH_SUBPATH, ENDS_IN_UNIT_INTERVAL] THEN
            ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY],
            DISCH_THEN (SUBST1_TAC o SYM) THEN
            ASM_SIMP_TAC [REVERSEPATH_JOINPATHS, REVERSEPATH_LINEPATH,
                         REVERSEPATH_SUBPATH, PATHFINISH_SUBPATH,
                         PATHSTART_LINEPATH] THEN
            MATCH_MP_TAC (← MESON [COMPLEX_ADD_SYM]
             (← q r"winding_number(g ++ h,z) =
              winding_number(g,z) + winding_number(h,z) /\
              winding_number(h ++ g,z) =
              winding_number(h,z) + winding_number(g,z)
              ==> winding_number(g ++ h,z) =winding_number(h ++ g,z)")) THEN
            CONJ_TAC THEN MATCH_MP_TAC WINDING_NUMBER_JOIN THEN
            ASM_SIMP_TAC [PATH_LINEPATH, PATH_SUBPATH, PATH_SUBPATH,
                         SIMPLE_PATH_IMP_PATH, ENDS_IN_UNIT_INTERVAL,
                         PATHSTART_LINEPATH, PATHFINISH_LINEPATH,
                         PATHSTART_SUBPATH, PATHFINISH_SUBPATH]
            THENL [ALL_TAC, ONCE_REWRITE_TAC [CONJ_SYM]] THEN
            REWRITE_TAC [← SET_RULE
             (← q r"~(z IN s) /\ ~(z IN t) <=> ~(z IN s UNION t)")] THEN
            ONCE_REWRITE_TAC [← GSYM PATH_IMAGE_REVERSEPATH] THEN
            REWRITE_TAC [REVERSEPATH_LINEPATH, REVERSEPATH_SUBPATH] THEN
            ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY]],
          REWRITE_TAC [COMPLEX_NEG_EQ_0] THEN DISCH_THEN SUBST_ALL_TAC THEN
          RULE_ASSUM_TAC (REWRITE_RULE
           [COMPLEX_NORM_CX, REAL_OF_NUM_EQ, REAL_ABS_NUM, ARITH]) THEN
          FIRST_X_ASSUM (HolCore.Tactics.CONTR_TAC HolLight.HolBase.B)],
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a:complex = --b <=> --a = b"))] THEN
        DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [NORM_NEG])] THEN
      EXISTS_TAC (← q r"z:complex") THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"winding_number(subpath (vec 0) t q ++ subpath t (vec 1) q,z) =
        winding_number(subpath (vec 0) (vec 1) q,z)")
       (fun th => ASM_MESON_TAC [th, SUBPATH_TRIVIAL]) THEN
      MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"winding_number(subpath (vec 0) t q,z) +
                  winding_number(subpath t (vec 1) q,z)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC WINDING_NUMBER_JOIN THEN
        ASM_SIMP_TAC [PATH_SUBPATH, ENDS_IN_UNIT_INTERVAL, SIMPLE_PATH_IMP_PATH,
                     PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
        SUBGOAL_THEN (← q r"~((z:complex) IN path_image q)") MP_TAC THENL
         [ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY],
          MATCH_MP_TAC (← SET_RULE
            (← q r"s1 SUBSET s /\ s2 SUBSET s
             ==> ~(z IN s) ==> ~(z IN s1) /\ ~(z IN s2)")) THEN
          ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET, ENDS_IN_UNIT_INTERVAL,
                    SIMPLE_PATH_IMP_PATH]],
        MATCH_MP_TAC WINDING_NUMBER_SUBPATH_COMBINE THEN
        ASM_REWRITE_TAC [ENDS_IN_INTERVAL, ← GSYM IN_INTERVAL_1] THEN
        ASM_SIMP_TAC [UNIT_INTERVAL_NONEMPTY, SIMPLE_PATH_IMP_PATH] THEN
        ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY]])
    prove
     r"!g. simple_path g
       ==> (!z. z IN inside(path_image g) ==> winding_number(g,z) = Cx(&1)) \/
           (!z. z IN inside(path_image g) ==> winding_number(g,z) = --Cx(&1))"
     (GEN_TAC THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"pathfinish g:complex = pathstart g") THENL
       [ALL_TAC, ASM_MESON_TAC [INSIDE_SIMPLE_CURVE_IMP_CLOSED]] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"(?k. !z. z IN s ==> f z = k) /\
        (?z. z IN s /\ (f z = a \/ f z = b))
        ==> (!z. z IN s ==> f z = a) \/ (!z. z IN s ==> f z = b)")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC WINDING_NUMBER_CONSTANT THEN
        ASM_SIMP_TAC [INSIDE_NO_OVERLAP, SIMPLE_PATH_IMP_PATH] THEN
        ASM_SIMP_TAC [JORDAN_INSIDE_OUTSIDE],
        MP_TAC (← SPEC (← q r"g:real^1->complex") lemma3) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:complex") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
        MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
          INTEGER_WINDING_NUMBER) THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [SIMPLE_PATH_IMP_PATH] THEN
          ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY],
          SIMP_TAC [complex_integer, COMPLEX_EQ, IM_NEG, IM_CX] THEN
          SIMP_TAC [← GSYM real, REAL_NORM, RE_NEG, RE_CX] THEN REAL_ARITH_TAC]]))

  pure { SIMPLE_CLOSED_PATH_WINDING_NUMBER_INSIDE }

/- ------------------------------------------------------------------------- -/
/- Consequences for simple closed paths; winding number zero conditions.    -/
/- (cauchy.ml 6788-6875)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAA where
  SIMPLE_CLOSED_PATH_ABS_WINDING_NUMBER_INSIDE : thm
  SIMPLE_CLOSED_PATH_NORM_WINDING_NUMBER_INSIDE : thm
  SIMPLE_CLOSED_PATH_WINDING_NUMBER_CASES : thm
  SIMPLE_CLOSED_PATH_WINDING_NUMBER_POS : thm
  SIMPLY_CONNECTED_IMP_WINDING_NUMBER_ZERO : thm
  NO_BOUNDED_CONNECTED_COMPONENT_IMP_WINDING_NUMBER_ZERO : thm
  NO_BOUNDED_PATH_COMPONENT_IMP_WINDING_NUMBER_ZERO : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAA [HolBase] (D : CauchyDeps) (BKYN : KYN) (BKYQ : KYQ) (BKYS : KYS) (BKYY : KYY) (BKYZ : KYZ) : ExceptT String IO KYAA := do
  -- @@SCOPE BEGIN
  let { WINDING_NUMBER_TRIVIAL, .. } := BKYN
  let { complex_integer, INTEGER_WINDING_NUMBER, .. } := BKYQ
  let { WINDING_NUMBER_ZERO_IN_OUTSIDE, .. } := BKYS
  let { WINDING_NUMBER_HOMOTOPIC_PATHS, .. } := BKYY
  let { SIMPLE_CLOSED_PATH_WINDING_NUMBER_INSIDE, .. } := BKYZ
  let { HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL, HOMOTOPIC_LOOPS_SUBSET,
        INSIDE_UNION_OUTSIDE, outside, PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT,
        .. } := D.qpaths
  let { INSIDE_SIMPLE_CURVE_IMP_CLOSED, .. } := D.qdegree
  let { INSIDE_NO_OVERLAP, .. } := D.mt.qpaths
  let { simply_connected, .. } := D.mt.ra.ts.qpaths
  let { RE_CX, RE_NEG, .. } := D.mt.ra.ts.cn.cxc
  let { real, .. } := D.mt.ra.ts.cn.cxi
  let { REAL_NORM, .. } := D.mt.ra.ts.cn.cxj
  let { ASM_MESON_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONTRAPOS_THM, EMPTY_SUBSET, EQ_TRANS, EXTENSION, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ_ALT, IN_DIFF, INSERT_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNION, IN_UNIV, NOT_EXISTS_THM, NOT_IN_EMPTY,
        REAL_ABS_NEG, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { BOUNDED_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { SEGMENT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { PATH_IMAGE_LINEPATH, PATH_LINEPATH, PATHFINISH_LINEPATH, PATHSTART_IN_PATH_IMAGE,
        PATHSTART_LINEPATH, SIMPLE_PATH_IMP_PATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONNECTED_COMPONENT_MONO, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  -- @@SCOPE END

  let SIMPLE_CLOSED_PATH_ABS_WINDING_NUMBER_INSIDE ← prove
   r"!g z. simple_path g /\ z IN inside(path_image g)
         ==> abs(Re(winding_number(g,z))) = &1"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (DISJ_CASES_TAC o MATCH_MP
      SIMPLE_CLOSED_PATH_WINDING_NUMBER_INSIDE) THEN
    ASM_SIMP_TAC [RE_NEG, RE_CX, REAL_ABS_NUM, REAL_ABS_NEG])

  let SIMPLE_CLOSED_PATH_NORM_WINDING_NUMBER_INSIDE ← prove
   r"!g z. simple_path g /\ z IN inside(path_image g)
         ==> norm(winding_number(g,z)) = &1"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"pathfinish g:complex = pathstart g") ASSUME_TAC THENL
     [ASM_MESON_TAC [INSIDE_SIMPLE_CURVE_IMP_CLOSED], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
        INTEGER_WINDING_NUMBER) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [SIMPLE_PATH_IMP_PATH] THEN
      ASM_MESON_TAC [INSIDE_NO_OVERLAP, IN_INTER, NOT_IN_EMPTY],
      ASM_SIMP_TAC [complex_integer, ← GSYM real, REAL_NORM,
                   SIMPLE_CLOSED_PATH_ABS_WINDING_NUMBER_INSIDE]])

  let SIMPLE_CLOSED_PATH_WINDING_NUMBER_CASES ← prove
   r"!g z. simple_path g /\ pathfinish g = pathstart g /\ ~(z IN path_image g)
         ==> winding_number(g,z) IN {--Cx(&1),Cx(&0),Cx(&1)}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"path_image g:complex->bool") INSIDE_UNION_OUTSIDE) THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_UNIV, IN_UNION] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [WINDING_NUMBER_ZERO_IN_OUTSIDE, SIMPLE_PATH_IMP_PATH] THEN
    ASM_MESON_TAC [SIMPLE_CLOSED_PATH_WINDING_NUMBER_INSIDE])

  let SIMPLE_CLOSED_PATH_WINDING_NUMBER_POS ← prove
   r"!g z. simple_path g /\ pathfinish g = pathstart g /\ ~(z IN path_image g) /\
         &0 < Re(winding_number(g,z))
         ==> winding_number(g,z) = Cx(&1)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
        SIMPLE_CLOSED_PATH_WINDING_NUMBER_CASES) THEN
    ASM_REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q r"&0 < Re(winding_number(g,z))") THEN
    ASM_REWRITE_TAC [RE_NEG, RE_CX] THEN REAL_ARITH_TAC)

  let SIMPLY_CONNECTED_IMP_WINDING_NUMBER_ZERO ← prove
   r"!s g z. simply_connected s /\
           path g /\ path_image g SUBSET s /\
           pathfinish g = pathstart g /\ ~(z IN s)
           ==> winding_number(g,z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"winding_number(linepath(pathstart g,pathstart g),z)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_PATHS THEN
      MATCH_MP_TAC HOMOTOPIC_LOOPS_IMP_HOMOTOPIC_PATHS_NULL THEN
      EXISTS_TAC (← q r"pathstart(g:real^1->complex)") THEN
      MATCH_MP_TAC HOMOTOPIC_LOOPS_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [simply_connected]) THEN
      ASM_REWRITE_TAC [PATH_LINEPATH, PATHSTART_LINEPATH,
                      PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL,
                      INSERT_SUBSET, EMPTY_SUBSET],
      MATCH_MP_TAC WINDING_NUMBER_TRIVIAL] THEN
    MP_TAC (← ISPEC (← q r"g:real^1->complex") PATHSTART_IN_PATH_IMAGE) THEN
    ASM SET_TAC [])

  let NO_BOUNDED_CONNECTED_COMPONENT_IMP_WINDING_NUMBER_ZERO ← prove
   r"!s. ~(?z. ~(z IN s) /\ bounded(connected_component ((:complex) DIFF s) z))
       ==> !g z. path g /\ path_image g SUBSET s /\
                 pathfinish g = pathstart g /\ ~(z IN s)
                 ==> winding_number(g,z) = Cx(&0)"
   (REWRITE_TAC [NOT_EXISTS_THM] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC WINDING_NUMBER_ZERO_IN_OUTSIDE THEN
    ASM_REWRITE_TAC [outside, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_MONO THEN ASM SET_TAC [])

  let NO_BOUNDED_PATH_COMPONENT_IMP_WINDING_NUMBER_ZERO ← prove
   r"!s. ~(?z. ~(z IN s) /\ bounded(path_component ((:complex) DIFF s) z))
       ==> !g z. path g /\ path_image g SUBSET s /\
                 pathfinish g = pathstart g /\ ~(z IN s)
                 ==> winding_number(g,z) = Cx(&0)"
   (GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC NO_BOUNDED_CONNECTED_COMPONENT_IMP_WINDING_NUMBER_ZERO THEN
    ASM_MESON_TAC [PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT, BOUNDED_SUBSET])

  pure { SIMPLE_CLOSED_PATH_ABS_WINDING_NUMBER_INSIDE,
         SIMPLE_CLOSED_PATH_NORM_WINDING_NUMBER_INSIDE,
         SIMPLE_CLOSED_PATH_WINDING_NUMBER_CASES, SIMPLE_CLOSED_PATH_WINDING_NUMBER_POS,
         SIMPLY_CONNECTED_IMP_WINDING_NUMBER_ZERO,
         NO_BOUNDED_CONNECTED_COMPONENT_IMP_WINDING_NUMBER_ZERO,
         NO_BOUNDED_PATH_COMPONENT_IMP_WINDING_NUMBER_ZERO }
/- ------------------------------------------------------------------------- -/
/- Partial circle path.                                                      -/
/- (cauchy.ml 6876-7020)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAB where
  partcirclepath : thm
  PATHSTART_PARTCIRCLEPATH : thm
  PATHFINISH_PARTCIRCLEPATH : thm
  HAS_VECTOR_DERIVATIVE_PARTCIRCLEPATH : thm
  VECTOR_DERIVATIVE_PARTCIRCLEPATH : thm
  VALID_PATH_PARTCIRCLEPATH : thm
  PATH_PARTCIRCLEPATH : thm
  PATH_IMAGE_PARTCIRCLEPATH : thm
  PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS : thm
  PATH_IMAGE_PARTCIRCLEPATH_SUBSET : thm
  IN_PATH_IMAGE_PARTCIRCLEPATH : thm
  RECTIFIABLE_PATH_PARTCIRCLEPATH : thm
  PATH_LENGTH_PARTCIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAB [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYE : KYE) : ExceptT String IO KYAB := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, .. } := BKYA
  let { PATH_LENGTH_VALID_PATH, valid_path, VALID_PATH_IMP_PATH, .. } := BKYB
  let { IM_LINEPATH_CX, .. } := BKYE
  let { HAS_VECTOR_DERIVATIVE_IMP_DIFFERENTIABLE, .. } := D.qderivatives
  let { HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_HAS_BOUNDED_VARIATION_ON, .. } := D.qintegration
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { CONTINUOUS_ON_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { HAS_VECTOR_DERIVATIVE_REAL_COMPLEX, .. } := D.mt.ra.ts.knj
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON, .. } := D.mt.ra.ts.qderivatives
  let { COMPLEX_ADD_LID, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, COMPLEX_NORM_II, CX_ADD, CX_DIV, CX_INJ, CX_MUL,
        CX_SUB, IM_ADD, IM_CMUL, IM_CX, RE_MUL_II, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { DIFFERENTIABLE_AT_WITHIN, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { CONTENT_UNIT, .. } := D.mt.ra.ts.cn.ms.qintegration1
  let { INTEGRAL_CONST, rectifiable_path, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, VECTOR_DERIVATIVE_WORKS,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ETA_AX, EXTENSION, FORALL_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, MONO_FORALL, REAL_ABS_MUL, REAL_ADD_RID,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_LT, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LT_IMP_NE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM,
        REAL_NEG_0, REAL_POS, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_RZERO, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_abs, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_VEC, LIFT_DROP, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_ADD_RID, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { IN_INTERVAL_1, IN_SPHERE, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONVEX_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qconvex
  let { path_image, pathfinish, PATHFINISH_LINEPATH, pathstart, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { BOUNDED_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let partcirclepath ← new_definition
   r"partcirclepath(z,r,s,t) =
    \x. z + Cx(r) * cexp(ii * linepath(Cx(s),Cx(t)) x)"

  let PATHSTART_PARTCIRCLEPATH ← prove
   r"!r z s t. pathstart(partcirclepath(z,r,s,t)) =
                z + Cx(r) * cexp(ii * Cx(s))"
   (REWRITE_TAC [pathstart, partcirclepath,
                ← REWRITE_RULE [pathstart] PATHSTART_LINEPATH])

  let PATHFINISH_PARTCIRCLEPATH ← prove
   r"!r z s t. pathfinish(partcirclepath(z,r,s,t)) =
                z + Cx(r) * cexp(ii * Cx(t))"
   (REWRITE_TAC [pathfinish, partcirclepath,
                ← REWRITE_RULE [pathfinish] PATHFINISH_LINEPATH])

  let HAS_VECTOR_DERIVATIVE_PARTCIRCLEPATH ← prove
   r"!z r s t x.
        ((partcirclepath(z,r,s,t)) has_vector_derivative
         (ii * Cx(r) * (Cx t - Cx s) * cexp(ii * linepath(Cx(s),Cx(t)) x)))
        (at x)"
   (REWRITE_TAC [partcirclepath, linepath, COMPLEX_CMUL, CX_SUB] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_REAL_COMPLEX THEN
    COMPLEX_DIFF_TAC THEN CONV_TAC COMPLEX_RING)

  let VECTOR_DERIVATIVE_PARTCIRCLEPATH ← prove
   r"!z r s t x.
        vector_derivative (partcirclepath(z,r,s,t)) (at x) =
        ii * Cx(r) * (Cx t - Cx s) * cexp(ii * linepath(Cx(s),Cx(t)) x)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    REWRITE_TAC [HAS_VECTOR_DERIVATIVE_PARTCIRCLEPATH])

  let VALID_PATH_PARTCIRCLEPATH ← prove
   r"!z r s t. valid_path(partcirclepath(z,r,s,t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [valid_path] THEN
    MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
    REWRITE_TAC [differentiable_on] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
    MATCH_MP_TAC DIFFERENTIABLE_AT_WITHIN THEN
    REWRITE_TAC [VECTOR_DERIVATIVE_WORKS, VECTOR_DERIVATIVE_PARTCIRCLEPATH,
                HAS_VECTOR_DERIVATIVE_PARTCIRCLEPATH])

  let PATH_PARTCIRCLEPATH ← prove
   r"!z r s t. path(partcirclepath(z,r,s,t))"
   (SIMP_TAC [VALID_PATH_PARTCIRCLEPATH, VALID_PATH_IMP_PATH])

  let PATH_IMAGE_PARTCIRCLEPATH ← prove
   r"!z r s t.
        &0 <= r /\ s <= t
        ==> path_image(partcirclepath(z,r,s,t)) =
                {z + Cx(r) * cexp(ii * Cx x) | s <= x /\ x <= t}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [path_image, partcirclepath] THEN
    REWRITE_TAC [EXTENSION, ← TAUT (← q r"(a <=> b) <=> (a ==> b) /\ (b ==> a)")] THEN
    REWRITE_TAC [FORALL_AND_THM, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:real^1") THEN REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN
      DISCH_TAC THEN EXISTS_TAC (← q r"(&1 - drop x) * s + drop x * t") THEN
      REWRITE_TAC [linepath, CX_ADD, CX_SUB, COMPLEX_CMUL, CX_MUL] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"s <= (&1 - x) * s + x * t <=> &0 <= x * (t - s)"),
        ← REAL_ARITH (← q r"(&1 - x) * s + x * t <= t <=> &0 <= (&1 - x) * (t - s)")] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:real") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [IN_IMAGE] THEN ASM_CASES_TAC (← q r"s:real < t") THENL
     [EXISTS_TAC (← q r"lift((x - s) / (t - s))") THEN
      ASM_SIMP_TAC [IN_INTERVAL_1, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_SUB_LT,
                   LIFT_DROP, DROP_VEC, linepath, REAL_MUL_LZERO, REAL_MUL_LID,
                   REAL_SUB_LE, ← REAL_ARITH (← q r"x - s:real <= t - s <=> x <= t")] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [COMPLEX_CMUL, CX_SUB, CX_DIV] THEN
      SUBGOAL_THEN (← q r"~(Cx(s) = Cx(t))") MP_TAC THENL
       [ASM_SIMP_TAC [CX_INJ, REAL_LT_IMP_NE], CONV_TAC COMPLEX_FIELD],
      UNDISCH_TAC (← q r"s:real <= t") THEN ASM_REWRITE_TAC [REAL_LE_LT] THEN
      DISCH_THEN SUBST_ALL_TAC THEN EXISTS_TAC (← q r"vec 0:real^1") THEN
      SIMP_TAC [IN_INTERVAL_1, DROP_VEC, linepath, VECTOR_MUL_LZERO,
               REAL_SUB_RZERO, VECTOR_MUL_LID, VECTOR_ADD_RID, REAL_POS] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [CX_INJ] THEN ASM_REAL_ARITH_TAC])

  let PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS ← prove
   r"!z r s t. path_image(partcirclepath(z,r,s,t)) SUBSET sphere(z,abs r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_image, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [partcirclepath, IN_SPHERE] THEN
    X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(z,z + x) = norm x"), COMPLEX_NORM_MUL] THEN
    REWRITE_TAC [NORM_CEXP, RE_MUL_II, IM_LINEPATH_CX, REAL_NEG_0] THEN
    REWRITE_TAC [COMPLEX_NORM_CX, REAL_EXP_0] THEN REAL_ARITH_TAC)

  let PATH_IMAGE_PARTCIRCLEPATH_SUBSET ← prove
   r"!z r s t.
        &0 <= r
        ==> path_image(partcirclepath(z,r,s,t)) SUBSET sphere(z,r)"
   (MESON_TAC [PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS, real_abs])

  let IN_PATH_IMAGE_PARTCIRCLEPATH ← prove
   r"!z r s t w.
        &0 <= r /\ w IN path_image(partcirclepath(z,r,s,t))
        ==> norm(w - z) = r"
   (MP_TAC PATH_IMAGE_PARTCIRCLEPATH_SUBSET THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    REWRITE_TAC [SUBSET, IN_SPHERE, dist, NORM_SUB] THEN SET_TAC [])

  let (RECTIFIABLE_PATH_PARTCIRCLEPATH, PATH_LENGTH_PARTCIRCLEPATH) ← (do
    let lemma ← prove
     r"(partcirclepath (z,r,s,t) has_vector_derivative
      ii * Cx(t - s) * partcirclepath (Cx(&0),r,s,t) u) (at u)"
     (REWRITE_TAC [partcirclepath, linepath, COMPLEX_CMUL, CX_SUB] THEN
      MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_REAL_COMPLEX THEN COMPLEX_DIFF_TAC THEN
      REWRITE_TAC [CX_MUL, CX_SUB, CX_ADD] THEN
      CONV_TAC COMPLEX_RING)
    let RECTIFIABLE_PATH_PARTCIRCLEPATH ← prove
     r"!z r s t. rectifiable_path(partcirclepath(z,r,s,t))"
     (REPEAT GEN_TAC THEN REWRITE_TAC [rectifiable_path, PATH_PARTCIRCLEPATH] THEN
      MATCH_MP_TAC
        HAS_BOUNDED_VECTOR_DERIVATIVE_IMP_HAS_BOUNDED_VARIATION_ON THEN
      EXISTS_TAC (← q r"\x. ii * Cx(t - s) *  partcirclepath (Cx(&0),r,s,t) x") THEN
      SIMP_TAC [lemma, HAS_VECTOR_DERIVATIVE_AT_WITHIN] THEN
      REWRITE_TAC [CONVEX_INTERVAL, BOUNDED_INTERVAL] THEN
      MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [COMPACT_INTERVAL] THEN
      REPLICATE_TAC 2 (MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_LMUL) THEN
      MATCH_MP_TAC DIFFERENTIABLE_IMP_CONTINUOUS_ON THEN
      MATCH_MP_TAC DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON THEN
      X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_IMP_DIFFERENTIABLE THEN
      REWRITE_TAC [ETA_AX] THEN MESON_TAC [lemma])
    let PATH_LENGTH_PARTCIRCLEPATH ← prove
     r"!z r s t. path_length(partcirclepath(z,r,s,t)) = abs(r * (t - s))"
     (SIMP_TAC [PATH_LENGTH_VALID_PATH, VALID_PATH_PARTCIRCLEPATH,
               RECTIFIABLE_PATH_PARTCIRCLEPATH] THEN
      REWRITE_TAC [← MATCH_MP VECTOR_DERIVATIVE_AT lemma] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_II, partcirclepath,
                  COMPLEX_ADD_LID, COMPLEX_NORM_CX, NORM_CEXP] THEN
      REWRITE_TAC [RE_MUL_II, linepath, IM_CMUL, IM_ADD, IM_CX] THEN
      REWRITE_TAC [REAL_MUL_RZERO, REAL_MUL_LID, REAL_ADD_RID] THEN
      REWRITE_TAC [REAL_EXP_0, REAL_NEG_0, REAL_MUL_RID] THEN
      REWRITE_TAC [INTEGRAL_CONST, CONTENT_UNIT, VECTOR_MUL_LID, LIFT_DROP] THEN
      REWRITE_TAC [← GSYM REAL_ABS_MUL, REAL_MUL_SYM])
    pure (RECTIFIABLE_PATH_PARTCIRCLEPATH, PATH_LENGTH_PARTCIRCLEPATH))

  pure { partcirclepath, PATHSTART_PARTCIRCLEPATH, PATHFINISH_PARTCIRCLEPATH,
         HAS_VECTOR_DERIVATIVE_PARTCIRCLEPATH, VECTOR_DERIVATIVE_PARTCIRCLEPATH,
         VALID_PATH_PARTCIRCLEPATH, PATH_PARTCIRCLEPATH, PATH_IMAGE_PARTCIRCLEPATH,
         PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS, PATH_IMAGE_PARTCIRCLEPATH_SUBSET,
         IN_PATH_IMAGE_PARTCIRCLEPATH, RECTIFIABLE_PATH_PARTCIRCLEPATH,
         PATH_LENGTH_PARTCIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- Bounds and integrability on a partial circle path.                        -/
/- (cauchy.ml 7021-7166)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAC where
  HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG : thm
  HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH : thm
  PATH_INTEGRABLE_CONTINUOUS_PARTCIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAC [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYE : KYE) (BKYAB : KYAB) : ExceptT String IO KYAC := do
  -- @@SCOPE BEGIN
  let { PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_PATH_INTEGRAL, path_integrable_on, .. } := BKYC
  let { IM_LINEPATH_CX, .. } := BKYE
  let { partcirclepath, VALID_PATH_PARTCIRCLEPATH, VECTOR_DERIVATIVE_PARTCIRCLEPATH,
        .. } := BKYAB
  let { CONTENT_UNIT_1, HAS_INTEGRAL_0_EQ, .. } := D.qintegration
  let { FINITE_FINITE_PREIMAGE_GENERAL, FINITE_IMAGE_INJ, .. } := D.qsession
  let { CEXP_ADD, CEXP_NZ, CONTINUOUS_ON_CEXP, .. } := D.mt.ra.tsa
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { CEXP_EQ, NORM_CEXP, .. } := D.mt.ra.tsf
  let { CEXP_CLOG, .. } := D.mt.ra.tsm
  let { HAS_INTEGRAL_BOUND, .. } := D.mt.ra.qintegration
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { COMPLEX_ADD_LDISTRIB, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO, COMPLEX_SUB_REFL,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_VEC_0, CX_ADD, CX_INJ,
        CX_MUL, CX_SUB, RE_MUL_II, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { HAS_INTEGRAL_SPIKE, INTEGRABLE_CONTINUOUS, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, NEGLIGIBLE_FINITE, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ETA_AX, FINITE_IMAGE, FINITE_RULES, FINITE_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, NOT_IN_EMPTY, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_LT, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_RDIV_EQ,
        REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_IMP_NZ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_SYM, REAL_NEG_0, REAL_POS,
        REAL_SUB_0, REAL_SUB_LE, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, UNWIND_THM1, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_VEC, NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { linear, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, LINEAR_CONTINUOUS_ON, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { REAL_BOUNDS_LE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  let { FINITE_INTSEG, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qfloor
  -- @@SCOPE END

  let HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG ← (do
    let lemma1 ← prove
     r"!b w. FINITE {z | norm(z) <= b /\ cexp(z) = w}"
     (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"w = Cx(&0)") THEN
      ASM_REWRITE_TAC [CEXP_NZ, ← SET_RULE (← q r"{x | F} = {}"), FINITE_RULES] THEN
      FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP CEXP_CLOG) THEN
      REWRITE_TAC [CEXP_EQ] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"{z | P z /\ ?n. Q n /\ z = f n} = IMAGE f {n | Q n /\ P(f n)}")] THEN
      MATCH_MP_TAC FINITE_IMAGE THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"{n | integer n /\
                       norm(Cx(&2 * n * pi) * ii) <= b + norm(clog w)}") THEN
      CONJ_TAC THENL
       [ALL_TAC, SIMP_TAC [SUBSET, IN_ELIM_THM] THEN NORM_ARITH_TAC] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_II] THEN
      REWRITE_TAC [REAL_MUL_RID, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_PI] THEN
      ASM_SIMP_TAC [REAL_MUL_ASSOC, ← GSYM REAL_LE_RDIV_EQ, PI_POS] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&2 * x <= a <=> x <= a / &2")] THEN
      REWRITE_TAC [← GSYM REAL_BOUNDS_LE, FINITE_INTSEG])
    let lemma2 ← prove
     r"!a b. ~(a = Cx(&0)) ==> FINITE {z | norm(z) <= b /\ cexp(a * z) = w}"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
       (← q r"IMAGE (\z. z / a) {z | norm(z) <= b * norm(a) /\ cexp(z) = w}") THEN
      SIMP_TAC [lemma1, FINITE_IMAGE] THEN ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
                     (← q r"~(a = Cx(&0)) ==> (x = y / a <=> a * x = y)")),
                   UNWIND_THM1, COMPLEX_NORM_MUL, REAL_LE_LMUL, NORM_POS_LE])
    prove
     r"!f i z r s t B k.
        FINITE k /\
        (f has_path_integral i) (partcirclepath(z,r,s,t)) /\
        &0 <= B /\ &0 < r /\ s <= t /\
        (!x. x IN path_image(partcirclepath(z,r,s,t)) DIFF k
             ==> norm(f x) <= B)
        ==> norm(i) <= B * r * (t - s)"
     (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_PATH_INTEGRAL] THEN STRIP_TAC THEN
      MP_TAC (← ASSUME (← q r"s <= t")) THEN GEN_REWRITE_TAC LAND_CONV [REAL_LE_LT] THEN
      STRIP_TAC THENL
       [ALL_TAC,
        FIRST_X_ASSUM SUBST_ALL_TAC THEN
        REPEAT (POP_ASSUM MP_TAC) THEN
        REWRITE_TAC [VECTOR_DERIVATIVE_PARTCIRCLEPATH] THEN
        REWRITE_TAC [COMPLEX_SUB_REFL, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO] THEN
        SIMP_TAC [← GSYM COMPLEX_VEC_0, HAS_INTEGRAL_0_EQ, NORM_0] THEN
        REAL_ARITH_TAC] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
      REWRITE_TAC [← GSYM CONTENT_UNIT_1] THEN MATCH_MP_TAC HAS_INTEGRAL_BOUND THEN
      EXISTS_TAC (← q r"\x. if (partcirclepath(z,r,s,t) x) IN k then Cx(&0)
                    else f(partcirclepath(z,r,s,t) x) *
                         vector_derivative (partcirclepath(z,r,s,t)) (at x)") THEN
      ASM_SIMP_TAC [] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [REAL_LE_MUL, REAL_POS, REAL_LT_IMP_LE, REAL_SUB_LE],
        ALL_TAC] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HAS_INTEGRAL_SPIKE THEN
        EXISTS_TAC (← q r"\x. f(partcirclepath(z,r,s,t) x) *
                        vector_derivative (partcirclepath(z,r,s,t)) (at x)") THEN
        EXISTS_TAC (← q r"{x | x IN interval[vec 0,vec 1] /\
                         (partcirclepath(z,r,s,t) x) IN k}") THEN
        ASM_SIMP_TAC [IN_DIFF, IN_ELIM_THM, IMP_CONJ] THEN
        MATCH_MP_TAC NEGLIGIBLE_FINITE THEN
        MATCH_MP_TAC FINITE_FINITE_PREIMAGE_GENERAL THEN ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"y:complex") THEN DISCH_TAC THEN
        REWRITE_TAC [partcirclepath] THEN
        ASM_SIMP_TAC [CX_INJ, REAL_LT_IMP_NZ, ← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(r = Cx(&0)) ==> (z + r * e = y <=> e = (y - z) / r)"))] THEN
        REWRITE_TAC [linepath, COMPLEX_CMUL] THEN
        REWRITE_TAC [← GSYM CX_MUL, ← GSYM CX_ADD] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(&1 - t) * x + t * y = x + t * (y - x)")] THEN
        REWRITE_TAC [CX_ADD, COMPLEX_ADD_LDISTRIB, CEXP_ADD] THEN
        SIMP_TAC [CEXP_NZ, ← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(e = Cx(&0)) ==> (e * x = y <=> x = y / e)"))] THEN
        ABBREV_TAC (← q r"w = (y - z) / Cx r / cexp(ii * Cx s)") THEN
        REWRITE_TAC [CX_MUL, ← ExceptT.mk (COMPLEX_RING
         (← q r"ii * Cx x * Cx(t - s) = (ii * Cx(t - s)) * Cx x"))] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC
         (← q r"{x | Cx(drop x) IN
               {z | norm(z) <= &1 /\ cexp((ii * Cx(t - s)) * z) = w}}") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_IMAGE_INJ THEN REWRITE_TAC [CX_INJ, DROP_EQ] THEN
          MATCH_MP_TAC lemma2 THEN
          REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"ii * x = Cx(&0) <=> x = Cx(&0)"))] THEN
          ASM_SIMP_TAC [CX_INJ, REAL_SUB_0, REAL_LT_IMP_NE],
          SIMP_TAC [SUBSET, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
          SIMP_TAC [COMPLEX_NORM_CX] THEN REAL_ARITH_TAC],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [COMPLEX_NORM_0] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_LT_IMP_LE, REAL_SUB_LE] THEN
      REWRITE_TAC [VECTOR_DERIVATIVE_PARTCIRCLEPATH] THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_II] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_MUL_LID] THEN
      REWRITE_TAC [NORM_CEXP, RE_MUL_II, IM_LINEPATH_CX] THEN
      REWRITE_TAC [REAL_EXP_0, REAL_NEG_0, REAL_MUL_RID] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [NORM_POS_LE] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [path_image] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SIMP_TAC [REAL_LE_MUL, NORM_POS_LE, REAL_ABS_POS] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN
      ASM_SIMP_TAC [NORM_POS_LE, ← GSYM CX_SUB, COMPLEX_NORM_CX] THEN
      ASM_REAL_ARITH_TAC))

  let HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH ← prove
   r"!f i z r s t B.
        (f has_path_integral i) (partcirclepath(z,r,s,t)) /\
        &0 <= B /\ &0 < r /\ s <= t /\
        (!x. x IN path_image(partcirclepath(z,r,s,t))
             ==> norm(f x) <= B)
        ==> norm(i) <= B * r * (t - s)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG THEN
    MAP_EVERY EXISTS_TAC
     [← q r"f:complex->complex", ← q r"z:complex", ← q r"{}:complex->bool"] THEN
    ASM_REWRITE_TAC [FINITE_RULES, IN_DIFF, NOT_IN_EMPTY])

  let PATH_INTEGRABLE_CONTINUOUS_PARTCIRCLEPATH ← prove
   r"!f z r s t. f continuous_on path_image(partcirclepath(z,r,s,t))
               ==> f path_integrable_on (partcirclepath(z,r,s,t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_integrable_on, HAS_PATH_INTEGRAL] THEN
    REWRITE_TAC [VECTOR_DERIVATIVE_PARTCIRCLEPATH, ← GSYM integrable_on] THEN
    DISCH_TAC THEN MATCH_MP_TAC INTEGRABLE_CONTINUOUS THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_REWRITE_TAC [← GSYM path_image, ETA_AX] THEN
      MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON THEN
      ASM_REWRITE_TAC [← GSYM valid_path, VALID_PATH_PARTCIRCLEPATH],
      ALL_TAC] THEN
    REWRITE_TAC [linepath] THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
           REWRITE_TAC [CONTINUOUS_ON_CONST]) THEN
    ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
           REWRITE_TAC [CONTINUOUS_ON_CONST]) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - x) % s + x % t = s + x % (t - s)")] THEN
    MATCH_MP_TAC CONTINUOUS_ON_ADD THEN REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
    MATCH_MP_TAC LINEAR_CONTINUOUS_ON THEN
    REWRITE_TAC [linear, DROP_ADD, DROP_CMUL, CX_ADD, COMPLEX_CMUL, CX_MUL,
                CX_SUB] THEN
    CONV_TAC COMPLEX_RING)

  pure { HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG,
         HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH,
         PATH_INTEGRABLE_CONTINUOUS_PARTCIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- Winding numbers, simplicity and arcs of partial circle paths.             -/
/- (cauchy.ml 7167-7338)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAD where
  WINDING_NUMBER_PARTCIRCLEPATH_POS_LT : thm
  SIMPLE_PATH_PARTCIRCLEPATH : thm
  ARC_PARTCIRCLEPATH : thm
  WINDING_NUMBER_PARTCIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAD [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYE : KYE) (BKYN : KYN) (BKYO : KYO) (BKYAB : KYAB) : ExceptT String IO KYAD := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { IM_LINEPATH_CX, LINEPATH_CX, .. } := BKYE
  let { WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { WINDING_NUMBER_POS_LT, .. } := BKYO
  let { IN_PATH_IMAGE_PARTCIRCLEPATH, partcirclepath, PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS,
        PATH_PARTCIRCLEPATH, VALID_PATH_PARTCIRCLEPATH, VECTOR_DERIVATIVE_PARTCIRCLEPATH,
        .. } := BKYAB
  let { CEXP_NZ, .. } := D.mt.ra.tsa
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { CEXP_EQ, NORM_CEXP, .. } := D.mt.ra.tsf
  let { INTEGER_ABS, .. } := D.mt.ra.ts.qfloor
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_SUB, COMPLEX_MUL_ASSOC, COMPLEX_MUL_RID, COMPLEX_SUB_0,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_POW_2, CX_ADD, CX_DIV, CX_INJ, CX_MUL, CX_SUB, II_NZ,
        IM_MUL_II, RE_CX, RE_MUL_CX, RE_MUL_II, RE_SUB, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, COMPLEX_INV_MUL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { CNJ_ADD, CNJ_CX, CNJ_MUL, CNJ_SUB, COMPLEX_MUL_CNJ, COMPLEX_NORM_CNJ,
        COMPLEX_NORM_GE_RE_IM, .. } := D.mt.ra.ts.cn.cxg
  let { CONTENT_1, .. } := D.mt.ra.ts.cn.ms.qintegration1
  let { HAS_INTEGRAL_CONST, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_RULE, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { linepath, simple_path, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, CONJ_SYM, CONTRAPOS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { REAL_ABS_DIV, REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_POS, REAL_ABS_SUB,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_EQ_LDIV_EQ, REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_RDIV_EQ,
        REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_RMUL_EQ, REAL_LET_TRANS, REAL_LT_IMP_LE,
        REAL_LT_MUL, REAL_LT_REFL, REAL_LTE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_NEG_0, REAL_OF_NUM_LT, REAL_POS,
        REAL_SUB_0, REAL_SUB_LT, REAL_SUB_RZERO, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { UNWIND_THM2, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_EQ, DROP_VEC, FORALL_DROP, LIFT_DROP, LIFT_EQ, LIFT_NUM,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_LID, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, IN_SPHERE, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { REAL_ABS_ABS, REAL_ABS_NZ, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { arc, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  -- @@SCOPE END

  let WINDING_NUMBER_PARTCIRCLEPATH_POS_LT ← prove
   r"!r z s t w.
        s < t /\ norm(w - z) < r
        ==> &0 < Re(winding_number(partcirclepath(z,r,s,t),w))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_POS_LT THEN
    EXISTS_TAC (← q r"r * (t - s) * (r - norm(w - z:complex))") THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"n < r ==> &0 <= n ==> &0 < r"))) THEN
    REWRITE_TAC [NORM_POS_LE] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [REAL_LT_MUL, REAL_SUB_LT, VALID_PATH_PARTCIRCLEPATH] THEN
    ASM_REWRITE_TAC [VALID_PATH_PARTCIRCLEPATH] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [IN_PATH_IMAGE_PARTCIRCLEPATH, REAL_LT_IMP_LE, REAL_LT_REFL],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
    REWRITE_TAC [VECTOR_DERIVATIVE_PARTCIRCLEPATH] THEN
    REWRITE_TAC [partcirclepath] THEN
    REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC, IM_MUL_II, RE_MUL_CX, ← GSYM CX_SUB] THEN
    REWRITE_TAC [CNJ_ADD, CNJ_SUB, CNJ_MUL, CNJ_CX] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"c * ((z + r * c') - w):complex = r * c * c' - c * (w - z)"))] THEN
    REWRITE_TAC [COMPLEX_MUL_CNJ, NORM_CEXP, RE_MUL_II] THEN
    REWRITE_TAC [IM_LINEPATH_CX, REAL_NEG_0, REAL_EXP_0, COMPLEX_MUL_RID,
                COMPLEX_POW_2] THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ, REAL_SUB_LT, RE_SUB, RE_CX] THEN
    MATCH_MP_TAC (← REAL_ARITH
     (← q r"norm(x) <= norm(y) /\ abs(Re(x)) <= norm(x)
      ==> r - norm(y) <= r - Re x")) THEN
    REWRITE_TAC [COMPLEX_NORM_GE_RE_IM] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, NORM_CEXP, RE_MUL_II, IM_LINEPATH_CX] THEN
    REWRITE_TAC [REAL_EXP_0, REAL_NEG_0, REAL_MUL_LID, ← GSYM CNJ_SUB] THEN
    REWRITE_TAC [COMPLEX_NORM_CNJ, REAL_LE_REFL])

  let SIMPLE_PATH_PARTCIRCLEPATH ← (do
    let lemma ← prove
     r"(!x y. (&0 <= x /\ x <= &1) /\ (&0 <= y /\ y <= &1) ==> P(abs(x - y))) <=>
     (!x. &0 <= x /\ x <= &1 ==> P x)"
     (MESON_TAC [← REAL_ARITH (← q r"(&0 <= x /\ x <= &1) /\ (&0 <= y /\ y <= &1)
                            ==> &0 <= abs(x - y) /\ abs(x - y) <= &1"),
                ← REAL_ARITH (← q r"&0 <= &0 /\ &0 <= &1"),
                ← REAL_ARITH (← q r"(&0 <= x ==> abs(x - &0) = x)")])
    prove
     r"!z r s t. simple_path(partcirclepath(z,r,s,t)) <=>
                ~(r = &0) /\ ~(s = t) /\ abs(s - t) <= &2 * pi"
     (REPEAT GEN_TAC THEN REWRITE_TAC [simple_path, PATH_PARTCIRCLEPATH] THEN
      REWRITE_TAC [partcirclepath] THEN
      SIMP_TAC [← ExceptT.mk (COMPLEX_RING
        (← q r"z + r * x = z + r * y <=> r * (x - y) = Cx(&0)"))] THEN
      REWRITE_TAC [COMPLEX_ENTIRE, CX_INJ] THEN
      ASM_CASES_TAC (← q r"r = &0") THEN ASM_REWRITE_TAC [] THENL
       [DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &3)", ← q r"lift(&1 / &2)"]) THEN
        REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM, LIFT_EQ] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV,
        ALL_TAC] THEN
      ASM_CASES_TAC (← q r"s:real = t") THEN ASM_REWRITE_TAC [] THENL
       [DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &3)", ← q r"lift(&1 / &2)"]) THEN
        REWRITE_TAC [linepath, ← VECTOR_ARITH (← q r"(&1 - t) % x + t % x = x")] THEN
        REWRITE_TAC [IN_INTERVAL_1, LIFT_DROP, ← GSYM LIFT_NUM, LIFT_EQ] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [COMPLEX_SUB_0],
        ALL_TAC] THEN
      REWRITE_TAC [COMPLEX_SUB_0, CEXP_EQ] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"ii * x = ii * y + z * ii <=> ii * (x - (y + z)) = Cx(&0)"))] THEN
      REWRITE_TAC [COMPLEX_ENTIRE, II_NZ, LINEPATH_CX] THEN
      REWRITE_TAC [← GSYM CX_SUB, ← GSYM CX_ADD, CX_INJ] THEN
      REWRITE_TAC [← REAL_ARITH
       (← q r"((&1 - x) * s + x * t) - (((&1 - y) * s + y * t) + z) = &0 <=>
        (x - y) * (t - s) = z")] THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, IN_INTERVAL_1] THEN
      SIMP_TAC [← REAL_ARITH
       (← q r"&0 <= x /\ x <= &1 /\ &0 <= y /\ y <= &1
        ==> (x = y \/ x = &0 /\ y = &1 \/ x = &1 /\ y = &0 <=>
             abs(x - y) = &0 \/ abs(x - y) = &1)")] THEN
      SIMP_TAC [PI_POS, ← REAL_FIELD
       (← q r"&0 < pi ==> (x = &2 * n * pi <=> n = x / (&2 * pi))")] THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [CONJ_SYM] UNWIND_THM2] THEN
      ONCE_REWRITE_TAC [← GSYM INTEGER_ABS] THEN
      REWRITE_TAC [← GSYM FORALL_DROP, REAL_ABS_MUL, REAL_ABS_DIV] THEN
      REWRITE_TAC [REAL_ABS_NUM, REAL_ABS_PI] THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")] THEN
      REWRITE_TAC [lemma] THEN EQ_TAC THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"(&2 * pi) / abs(t - s)")) THEN
        ASM_SIMP_TAC [REAL_ABS_SUB, ← REAL_FIELD
         (← q r"~(s = t) ==> x / abs(s - t) * abs(s - t) = x")] THEN
        ASM_SIMP_TAC [PI_POS, INTEGER_CLOSED, ← REAL_FIELD
         (← q r"&0 < pi ==> (&2 * pi) / (&2 * pi) = &1")] THEN
        ASM_SIMP_TAC [REAL_EQ_LDIV_EQ, REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ,
                     ← GSYM REAL_ABS_NZ, REAL_SUB_0] THEN
        MP_TAC PI_POS THEN REAL_ARITH_TAC,
        DISCH_TAC THEN X_GEN_TAC (← q r"x:real") THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
           REAL_ABS_INTEGER_LEMMA)) THEN
        SIMP_TAC [REAL_ABS_DIV, REAL_ABS_MUL, REAL_ABS_ABS, REAL_ABS_NUM,
                 REAL_ABS_PI] THEN
        SIMP_TAC [REAL_EQ_LDIV_EQ, REAL_LE_RDIV_EQ, PI_POS, REAL_LT_MUL,
                 REAL_OF_NUM_LT, ARITH] THEN
        ASM_CASES_TAC (← q r"x = &0") THEN ASM_REWRITE_TAC [REAL_MUL_LZERO] THEN
        ASM_REWRITE_TAC [REAL_ENTIRE, REAL_MUL_LID,
                        ← REAL_ARITH (← q r"abs(t - s) = &0 <=> s = t")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← REAL_ARITH
         (← q r"p <= x * abs(s - t)
          ==> abs(s - t) <= p ==> &1 * abs(s - t) <= x * abs(s - t)"))) THEN
        ONCE_REWRITE_TAC [REAL_ABS_SUB] THEN ASM_REWRITE_TAC [] THEN
        ASM_SIMP_TAC [REAL_LE_RMUL_EQ, ← GSYM REAL_ABS_NZ, REAL_SUB_0] THEN
        ASM_REAL_ARITH_TAC]))

  let ARC_PARTCIRCLEPATH ← prove
   r"!z r s t. ~(r = &0) /\ ~(s = t) /\ abs(s - t) < &2 * pi
             ==> arc(partcirclepath(z,r,s,t))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [arc, PATH_PARTCIRCLEPATH] THEN
    REWRITE_TAC [partcirclepath] THEN
    SIMP_TAC [← ExceptT.mk (COMPLEX_RING
      (← q r"z + r * x = z + r * y <=> r * (x - y) = Cx(&0)"))] THEN
    ASM_REWRITE_TAC [COMPLEX_ENTIRE, CX_INJ] THEN
    REWRITE_TAC [COMPLEX_SUB_0, CEXP_EQ] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"ii * x = ii * y + z * ii <=> ii * (x - (y + z)) = Cx(&0)"))] THEN
    REWRITE_TAC [COMPLEX_ENTIRE, II_NZ, LINEPATH_CX] THEN
    REWRITE_TAC [← GSYM CX_SUB, ← GSYM CX_ADD, CX_INJ] THEN
    REWRITE_TAC [← REAL_ARITH
     (← q r"((&1 - x) * s + x * t) - (((&1 - y) * s + y * t) + z) = &0 <=>
      (x - y) * (t - s) = z")] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"n:real") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"n = &0") THEN
    ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_ENTIRE, REAL_SUB_0,
                    DROP_EQ] THEN
    MP_TAC (← SPEC (← q r"n:real") REAL_ABS_INTEGER_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_THEN (K ALL_TAC) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"abs x < abs y ==> ~(x = y)")) THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NUM, REAL_ABS_PI] THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"&1 * &2 * pi") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"&2 * n * pi = n * &2 * pi")] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN ASM_REWRITE_TAC [] THEN
      MP_TAC PI_POS THEN REAL_ARITH_TAC] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"&1 * abs(t - s)") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [REAL_MUL_LID] THEN ASM_MESON_TAC [REAL_ABS_SUB]] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
    REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC)

  let WINDING_NUMBER_PARTCIRCLEPATH ← prove
   r"!z r s t.
        ~(r = &0)
        ==> winding_number (partcirclepath(z,r,s,t),z) =
            Cx((t - s) / (&2 * pi))"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      WINDING_NUMBER_VALID_PATH o lhand o snd) THEN
    REWRITE_TAC [VALID_PATH_PARTCIRCLEPATH] THEN ANTS_TAC THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"!s. ~(z IN s) /\ t SUBSET s ==> ~(z IN t)")) THEN
      EXISTS_TAC (← q r"sphere(z:complex,abs r)") THEN
      ASM_REWRITE_TAC [PATH_IMAGE_PARTCIRCLEPATH_SUBSET_ABS, IN_SPHERE] THEN
      POP_ASSUM MP_TAC THEN CONV_TAC (fun t => NORM_ARITH t),
      DISCH_THEN SUBST1_TAC] THEN
    REWRITE_TAC [complex_div, CX_DIV, CX_MUL, COMPLEX_INV_MUL] THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
     (← q r"i = ii * ts
      ==> (Cx(&1) * inv(Cx(&2)) * p * inv ii) * i = ts * inv(Cx(&2)) * p"))) THEN
    MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL, VECTOR_DERIVATIVE_PARTCIRCLEPATH] THEN
    REWRITE_TAC [partcirclepath, COMPLEX_ADD_SUB] THEN
    ASM_SIMP_TAC [CEXP_NZ, CX_INJ, CX_SUB, ← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(r = Cx(&0)) /\ ~(e = Cx(&0))
      ==> (Cx(&1) * inv(r * e)) * ii * r * ts * e = ii * ts"))] THEN
    MP_TAC (← ISPECL
     [← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"ii * (Cx t - Cx s)"]
     HAS_INTEGRAL_CONST) THEN
    SIMP_TAC [CONTENT_1, DROP_VEC, REAL_POS, REAL_SUB_RZERO, VECTOR_MUL_LID])

  pure { WINDING_NUMBER_PARTCIRCLEPATH_POS_LT, SIMPLE_PATH_PARTCIRCLEPATH,
         ARC_PARTCIRCLEPATH, WINDING_NUMBER_PARTCIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- Special case of one complete circle.                                      -/
/- (cauchy.ml 7339-7519)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAE where
  circlepath : thm
  CIRCLEPATH : thm
  PATH_CIRCLEPATH : thm
  PATHSTART_CIRCLEPATH : thm
  PATHFINISH_CIRCLEPATH : thm
  HAS_VECTOR_DERIVATIVE_CIRCLEPATH : thm
  VECTOR_DERIVATIVE_CIRCLEPATH : thm
  VALID_PATH_CIRCLEPATH : thm
  RECTIFIABLE_PATH_CIRCLEPATH : thm
  PATH_LENGTH_CIRCLEPATH : thm
  SHIFTPATH_CIRCLEPATH : thm
  PATH_IMAGE_CIRCLEPATH : thm
  HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH_STRONG : thm
  HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH : thm
  PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH : thm
  SIMPLE_PATH_CIRCLEPATH : thm
  WINDING_NUMBER_CIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAE [HolBase] (D : CauchyDeps) (BKYAA : KYAA) (BKYAB : KYAB) (BKYAC : KYAC) (BKYAD : KYAD) : ExceptT String IO KYAE := do
  -- @@SCOPE BEGIN
  let { SIMPLE_CLOSED_PATH_WINDING_NUMBER_POS, .. } := BKYAA
  let { partcirclepath, PATH_LENGTH_PARTCIRCLEPATH, PATH_PARTCIRCLEPATH,
        PATHFINISH_PARTCIRCLEPATH, PATHSTART_PARTCIRCLEPATH,
        RECTIFIABLE_PATH_PARTCIRCLEPATH, VALID_PATH_PARTCIRCLEPATH, .. } := BKYAB
  let { HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH,
        HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG,
        PATH_INTEGRABLE_CONTINUOUS_PARTCIRCLEPATH, .. } := BKYAC
  let { SIMPLE_PATH_PARTCIRCLEPATH, WINDING_NUMBER_PARTCIRCLEPATH_POS_LT, .. } := BKYAD
  let { CEXP_0, CEXP_SUB, .. } := D.mt.ra.tsa
  let { CEXP_EULER, REAL_EXP_0, REAL_EXP_NEG, .. } := D.mt.ra.tsb
  let { CX_COS, CX_SIN, .. } := D.mt.ra.tsc
  let { COS_NPI, PI_POS, REAL_ABS_PI, SIN_NPI, .. } := D.mt.ra.tse
  let { CEXP_INTEGER_2PI, CX_PI_NZ, NORM_CEXP, SINCOS_TOTAL_2PI, .. } := D.mt.ra.tsf
  let { HAS_VECTOR_DERIVATIVE_REAL_COMPLEX, .. } := D.mt.ra.ts.knj
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { complex_div, COMPLEX_SQNORM, SIMPLE_COMPLEX_ARITH, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LDISTRIB, COMPLEX_ADD_LID, COMPLEX_MUL_AC, COMPLEX_MUL_LZERO,
        COMPLEX_MUL_RID, COMPLEX_MUL_RZERO, COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_RDISTRIB,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_EXPAND, COMPLEX_NORM_CX, CX_ADD, CX_DIV, CX_INV, CX_MUL,
        CX_SUB, IM_CX, RE_MUL_II, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, COMPLEX_NORM_ZERO,
        .. } := D.mt.ra.ts.cn.cxf
  let { VECTOR_DERIVATIVE_AT, .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, new_definition, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_ABS_ZERO, .. } := D.mt.ra.ts.cn.cx.cpx
  let { INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { linepath, shiftpath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, CONJ_ASSOC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, MEMBER_NOT_EMPTY, REAL_ABS_MUL, REAL_ABS_NUM, REAL_DIV_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LT_IMP_LE, REAL_LT_MUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_AC, REAL_MUL_RID, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_POS, REAL_POW_ONE,
        REAL_SUB_RZERO, SUBSET, SUBSET_ANTISYM, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { DROP_ADD, DROP_SUB, DROP_VEC, LIFT_DROP, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { IN_INTERVAL_1, IN_SPHERE, INTERVAL_EQ_EMPTY_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { REAL_POW_NEG, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  let circlepath ← new_definition
   r"circlepath(z,r) = partcirclepath(z,r,&0,&2 * pi)"

  let CIRCLEPATH ← prove
   r"circlepath(z,r) = \x. z + Cx(r) * cexp(Cx(&2) * Cx pi * ii * Cx(drop x))"
   (REWRITE_TAC [circlepath, partcirclepath, linepath, COMPLEX_CMUL] THEN
    REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_ADD_LID] THEN
    REWRITE_TAC [CX_MUL, COMPLEX_MUL_AC])

  let PATH_CIRCLEPATH ← prove
   r"!z r. path(circlepath(z,r))"
   (REWRITE_TAC [circlepath, PATH_PARTCIRCLEPATH])

  let PATHSTART_CIRCLEPATH ← prove
   r"!r z. pathstart(circlepath(z,r)) = z + Cx(r)"
   (REWRITE_TAC [circlepath, PATHSTART_PARTCIRCLEPATH] THEN
    REWRITE_TAC [COMPLEX_MUL_RZERO, CEXP_0, COMPLEX_MUL_RID])

  let PATHFINISH_CIRCLEPATH ← prove
   r"!r z. pathfinish(circlepath(z,r)) = z + Cx(r)"
   (REWRITE_TAC [circlepath, PATHFINISH_PARTCIRCLEPATH] THEN
    REWRITE_TAC [CEXP_EULER, ← GSYM CX_COS, ← GSYM CX_SIN] THEN
    REWRITE_TAC [SIN_NPI, COS_NPI, REAL_POW_NEG, ARITH, REAL_POW_ONE] THEN
    CONV_TAC COMPLEX_RING)

  let HAS_VECTOR_DERIVATIVE_CIRCLEPATH ← prove
   r"((circlepath (z,r)) has_vector_derivative
    (Cx(&2) * Cx(pi) * ii * Cx(r) * cexp(Cx(&2) * Cx pi * ii * Cx(drop x))))
   (at x)"
   (REWRITE_TAC [CIRCLEPATH] THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_REAL_COMPLEX THEN
    COMPLEX_DIFF_TAC THEN CONV_TAC COMPLEX_RING)

  let VECTOR_DERIVATIVE_CIRCLEPATH ← prove
   r"vector_derivative (circlepath (z,r)) (at x) =
        Cx(&2) * Cx(pi) * ii * Cx(r) * cexp(Cx(&2) * Cx pi * ii * Cx(drop x))"
   (MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    REWRITE_TAC [HAS_VECTOR_DERIVATIVE_CIRCLEPATH])

  let VALID_PATH_CIRCLEPATH ← prove
   r"!z r. valid_path (circlepath(z,r))"
   (REWRITE_TAC [circlepath, VALID_PATH_PARTCIRCLEPATH])

  let RECTIFIABLE_PATH_CIRCLEPATH ← prove
   r"!z r. rectifiable_path(circlepath(z,r))"
   (REWRITE_TAC [circlepath, RECTIFIABLE_PATH_PARTCIRCLEPATH])

  let PATH_LENGTH_CIRCLEPATH ← prove
   r"!z r. path_length(circlepath(z,r)) = &2 * pi * abs r"
   (REWRITE_TAC [circlepath, PATH_LENGTH_PARTCIRCLEPATH] THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_SUB_RZERO, REAL_ABS_NUM, REAL_ABS_PI] THEN
    REWRITE_TAC [REAL_MUL_AC])

  let SHIFTPATH_CIRCLEPATH ← prove
   r"!a z r.
        shiftpath a (circlepath(z,r)) =
        partcirclepath(z,r,&2 * pi * drop a,&2 * pi * (drop a + &1))"
   (REWRITE_TAC [FUN_EQ_THM, circlepath] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [shiftpath, partcirclepath] THEN
    COND_CASES_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [linepath, COMPLEX_CMUL, COMPLEX_MUL_RZERO, COMPLEX_ADD_LID] THEN
    REWRITE_TAC [CX_MUL, DROP_ADD, DROP_SUB, DROP_VEC, CX_ADD, CX_SUB] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
      (← q r"(Cx(&1) - x) * t * p * a + x * t * p * (a + Cx(&1)) =
       (a + x) * t * p"))] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + x - Cx(&1) = (a + x) - Cx(&1)"))] THEN
    REWRITE_TAC [COMPLEX_SUB_RDISTRIB, COMPLEX_SUB_LDISTRIB, CEXP_SUB] THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD (← q r"y = Cx(&1) ==> x / y = x"))) THEN
    MP_TAC (← ISPEC (← q r"&1:real") CEXP_INTEGER_2PI) THEN
    REWRITE_TAC [INTEGER_CLOSED, CX_MUL, COMPLEX_MUL_AC])

  let PATH_IMAGE_CIRCLEPATH ← prove
   r"!z r. &0 <= r ==> path_image (circlepath(z,r)) = sphere(z,r)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CIRCLEPATH, path_image] THEN
    REWRITE_TAC [sphere, ← NORM_ARITH (← q r"dist(w,z) = norm(z - w)")] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_ELIM_THM, ← ExceptT.mk (COMPLEX_RING (← q r"(z + r) - z = r:complex"))] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, NORM_CEXP] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"Cx(&2) * p * i * z = (Cx(&2) * p * z) * i"))] THEN
      REWRITE_TAC [RE_MUL_II, ← GSYM CX_MUL, IM_CX] THEN
      REWRITE_TAC [REAL_EXP_NEG, REAL_EXP_0, REAL_MUL_RID, COMPLEX_NORM_CX] THEN
      POP_ASSUM MP_TAC THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:complex") THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"w:complex = x - z") THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← ExceptT.mk (COMPLEX_RING
     (← q r"x - z = w:complex ==> x = z + w")))) THEN
    REWRITE_TAC [IN_IMAGE, ← ExceptT.mk (COMPLEX_RING (← q r"z + a = z + b:complex <=> a = b"))] THEN
    ASM_CASES_TAC (← q r"w = Cx(&0)") THENL
     [UNDISCH_THEN (← q r"norm(w:complex) = r") (MP_TAC o SYM) THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_0, REAL_ABS_ZERO] THEN
      DISCH_THEN SUBST1_TAC THEN REWRITE_TAC [COMPLEX_MUL_LZERO] THEN
      REWRITE_TAC [MEMBER_NOT_EMPTY, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
      REWRITE_TAC [REAL_NOT_LT, REAL_POS],
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"Re(w / Cx(norm w))", ← q r"Im(w / Cx(norm w))"]
      SINCOS_TOTAL_2PI) THEN
    REWRITE_TAC [← GSYM COMPLEX_SQNORM] THEN
    REWRITE_TAC [COMPLEX_NORM_DIV, COMPLEX_NORM_CX, REAL_ABS_NORM] THEN
    ASM_SIMP_TAC [REAL_DIV_REFL, REAL_POW_ONE, COMPLEX_NORM_ZERO] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real") (STRIP_ASSUME_TAC o GSYM)) THEN
    EXISTS_TAC (← q r"lift(t / (&2 * pi))") THEN
    ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"Cx(&2) * p * i * z = i * (Cx(&2) * p * z)"))] THEN
    REWRITE_TAC [CEXP_EULER, LIFT_DROP, CX_DIV, CX_MUL] THEN
    ASM_SIMP_TAC [CX_PI_NZ, ← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(p = Cx(&0)) ==> Cx(&2) * p * t / (Cx(&2) * p) = t"))] THEN
    ASM_REWRITE_TAC [← GSYM CX_COS, ← GSYM CX_SIN] THEN CONJ_TAC THENL
     [REWRITE_TAC [complex_div, ← GSYM CX_INV] THEN
      REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"Re(w * Cx x) = Re(w) * x"),
                  ← SIMPLE_COMPLEX_ARITH (← q r"Im(w * Cx x) = Im(w) * x")] THEN
      REWRITE_TAC [COMPLEX_ADD_LDISTRIB, ← GSYM CX_MUL] THEN
      SUBGOAL_THEN (← q r"!z:real. r * z * inv r = z") MP_TAC THENL
       [SUBGOAL_THEN (← q r"~(r = &0)") MP_TAC THENL [ALL_TAC, CONV_TAC REAL_FIELD] THEN
        ASM_MESON_TAC [COMPLEX_NORM_ZERO],
        ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"t * ii * s = ii * t * s"))] THEN
        SIMP_TAC [← GSYM CX_MUL, ← GSYM COMPLEX_EXPAND]],
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LT_MUL,
                   PI_POS, REAL_OF_NUM_LT, ARITH] THEN
      ASM_REAL_ARITH_TAC])

  let HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH_STRONG ← prove
   r"!f i z r B k.
        FINITE k /\
        (f has_path_integral i) (circlepath(z,r)) /\
        &0 <= B /\ &0 < r /\
        (!x. norm(x - z) = r /\ ~(x IN k) ==> norm(f x) <= B)
        ==> norm(i) <= B * (&2 * pi * r)"
   (REWRITE_TAC [circlepath] THEN REPEAT STRIP_TAC THEN
    SUBST1_TAC (← REAL_ARITH (← q r"B * (&2 * pi * r) = B * r * (&2 * pi - &0)")) THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH_STRONG THEN
    MAP_EVERY EXISTS_TAC
     [← q r"f:complex->complex", ← q r"z:complex", ← q r"k:complex->bool"] THEN
    ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS, REAL_LT_IMP_LE, PI_POS, IN_DIFF] THEN
    ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, ← GSYM circlepath, REAL_LT_IMP_LE] THEN
    ASM_REWRITE_TAC [IN_SPHERE, ← NORM_ARITH (← q r"dist(w,z) = norm(z - w)")])

  let HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH ← prove
   r"!f i z r B.
        (f has_path_integral i) (circlepath(z,r)) /\
        &0 <= B /\ &0 < r /\ (!x. norm(x - z) = r ==> norm(f x) <= B)
        ==> norm(i) <= B * (&2 * pi * r)"
   (REWRITE_TAC [circlepath] THEN REPEAT STRIP_TAC THEN
    SUBST1_TAC (← REAL_ARITH (← q r"B * (&2 * pi * r) = B * r * (&2 * pi - &0)")) THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_PARTCIRCLEPATH THEN
    MAP_EVERY EXISTS_TAC [← q r"f:complex->complex", ← q r"z:complex"] THEN
    ASM_SIMP_TAC [REAL_LE_MUL, REAL_POS, REAL_LT_IMP_LE, PI_POS] THEN
    ASM_SIMP_TAC [PATH_IMAGE_CIRCLEPATH, ← GSYM circlepath, REAL_LT_IMP_LE] THEN
    ASM_REWRITE_TAC [IN_SPHERE, ← NORM_ARITH (← q r"dist(w,z) = norm(z - w)")])

  let PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH ← prove
   r"!f z r. f continuous_on path_image(circlepath(z,r))
           ==> f path_integrable_on (circlepath(z,r))"
   (SIMP_TAC [PATH_INTEGRABLE_CONTINUOUS_PARTCIRCLEPATH, circlepath])

  let SIMPLE_PATH_CIRCLEPATH ← prove
   r"!z r. simple_path(circlepath(z,r)) <=> ~(r = &0)"
   (REWRITE_TAC [circlepath, SIMPLE_PATH_PARTCIRCLEPATH] THEN
    MP_TAC PI_POS THEN REAL_ARITH_TAC)

  let WINDING_NUMBER_CIRCLEPATH ← prove
   r"!z r w. norm(w - z) < r ==> winding_number(circlepath(z,r),w) = Cx(&1)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SIMPLE_CLOSED_PATH_WINDING_NUMBER_POS THEN
    REWRITE_TAC [SIMPLE_PATH_CIRCLEPATH,
                PATHSTART_CIRCLEPATH, PATHFINISH_CIRCLEPATH, CONJ_ASSOC] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"n < r ==> (&0 <= n ==> &0 <= r /\ &0 < r) /\ n < r"))) THEN
      SIMP_TAC [NORM_POS_LE, PATH_IMAGE_CIRCLEPATH, IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [IN_SPHERE, ← NORM_ARITH (← q r"dist(w,z) = norm(z - w)")] THEN
      REAL_ARITH_TAC,
      REWRITE_TAC [circlepath] THEN
      MATCH_MP_TAC WINDING_NUMBER_PARTCIRCLEPATH_POS_LT THEN
      ASM_SIMP_TAC [REAL_LT_MUL, PI_POS, REAL_OF_NUM_LT, ARITH]])

  pure { circlepath, CIRCLEPATH, PATH_CIRCLEPATH, PATHSTART_CIRCLEPATH,
         PATHFINISH_CIRCLEPATH, HAS_VECTOR_DERIVATIVE_CIRCLEPATH,
         VECTOR_DERIVATIVE_CIRCLEPATH, VALID_PATH_CIRCLEPATH,
         RECTIFIABLE_PATH_CIRCLEPATH, PATH_LENGTH_CIRCLEPATH, SHIFTPATH_CIRCLEPATH,
         PATH_IMAGE_CIRCLEPATH, HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH_STRONG,
         HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH, PATH_INTEGRABLE_CONTINUOUS_CIRCLEPATH,
         SIMPLE_PATH_CIRCLEPATH, WINDING_NUMBER_CIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- Rectifiable loops round convex frontiers; the Cauchy formula for points   -/
/- inside a circle.                                                          -/
/- (cauchy.ml 7520-7643)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAF where
  RECTIFIABLE_LOOP_RELATIVE_FRONTIER_CONVEX : thm
  RECTIFIABLE_LOOP_FRONTIER_CONVEX : thm
  RECTIFIABLE_PATH_FRONTIER_CONVEX : thm
  CAUCHY_INTEGRAL_CIRCLEPATH : thm
  CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAF [HolBase] (D : CauchyDeps) (BKYV : KYV) (BKYAE : KYAE) : ExceptT String IO KYAF := do
  -- @@SCOPE BEGIN
  let { CAUCHY_INTEGRAL_FORMULA_WEAK, .. } := BKYV
  let { PATH_CIRCLEPATH, PATH_IMAGE_CIRCLEPATH, PATHFINISH_CIRCLEPATH,
        PATHSTART_CIRCLEPATH, RECTIFIABLE_PATH_CIRCLEPATH, SIMPLE_PATH_CIRCLEPATH,
        VALID_PATH_CIRCLEPATH, WINDING_NUMBER_CIRCLEPATH, .. } := BKYAE
  let { HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE, RECTIFIABLE_PATH_JOIN,
        RECTIFIABLE_PATH_LINEPATH, .. } := D.qintegration
  let { PATH_IMAGE_COMPOSE, PATHFINISH_COMPOSE, PATHSTART_COMPOSE, .. } := D.qpaths
  let { BILIPSCHITZ_HOMEOMORPHISM_RELATIVE_FRONTIERS, FRONTIER_SEGMENT, .. } := D.qconvex
  let { AFF_DIM_CBALL, .. } := D.mt.qconvex
  let { complex_differentiable, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_OPEN,
        HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { COMPLEX_MUL_LID, .. } := D.mt.ra.ts.cn.cxb
  let { rectifiable_path, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, INT_ARITH, MESON_TAC, NORM_ARITH, REAL_ARITH, REAL_RAT_REDUCE_CONV,
        SET_RULE, .. } := D.mt.ra.ts.cn.cx.cvx
  let { AFF_DIM_NONEMPTY_INTERIOR_EQ, .. } := D.mt.ra.ts.cn.ms.ig.qconvex
  let { PATH_CONTINUOUS_IMAGE, simple_path, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { CONJ_ASSOC, DIFF_EMPTY, DIMINDEX_2, EXTENSION, FINITE_RULES,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_IMP, INT_LT_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, LE_REFL, LEFT_IMP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_POS, RIGHT_EXISTS_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_THM, UNION_IDEMPOT, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BALL_SUBSET_CBALL, BOUNDED_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CLOSURE_EQ_EMPTY, COMPACT_CLOSURE, COMPACT_IMP_BOUNDED,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { IN_BALL, IN_SPHERE, INTERIOR_CBALL, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { homeomorphism, SEGMENT_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { RELATIVE_FRONTIER_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qconvex
  let { path_image, PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH, PATHFINISH_JOIN,
        PATHFINISH_LINEPATH, PATHSTART_JOIN, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SPHERE_SUBSET_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { AFF_DIM_LE_UNIV, COLLINEAR_AFF_DIM, COMPACT_CONVEX_COLLINEAR_SEGMENT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx1
  let { CONVEX_CBALL, CONVEX_CLOSURE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { FRONTIER_CLOSURE_CONVEX, RELATIVE_FRONTIER_NONEMPTY_INTERIOR,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  /- We can also deduce this; it's pushed to this late point in the build
     just for the convenience of using "circlepath". -/

  let RECTIFIABLE_LOOP_RELATIVE_FRONTIER_CONVEX ← prove
   r"!s:real^N->bool.
        bounded s /\ convex s /\ aff_dim s = &2
        ==> ?g. simple_path g /\
                rectifiable_path g /\
                pathfinish g = pathstart g /\
                path_image g = relative_frontier s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"cball(Cx(&0),&1)", ← q r"s:real^N->bool"]
          BILIPSCHITZ_HOMEOMORPHISM_RELATIVE_FRONTIERS) THEN
    ASM_REWRITE_TAC [CONVEX_CBALL, BOUNDED_CBALL, AFF_DIM_CBALL] THEN
    REWRITE_TAC [RELATIVE_FRONTIER_CBALL, DIMINDEX_2, homeomorphism] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:complex->real^N", ← q r"g:real^N->complex"] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(f:complex->real^N) o circlepath(Cx(&0),&1)") THEN
    ASM_SIMP_TAC [PATH_IMAGE_COMPOSE, PATH_IMAGE_CIRCLEPATH, REAL_POS] THEN
    REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE,
                PATHSTART_CIRCLEPATH, PATHFINISH_CIRCLEPATH] THEN
    REWRITE_TAC [simple_path, rectifiable_path, o_THM] THEN
    ASM_SIMP_TAC [PATH_CONTINUOUS_IMAGE, PATH_IMAGE_CIRCLEPATH, REAL_POS,
                 PATH_CIRCLEPATH] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← SPECL [← q r"Cx(&0)", ← q r"&1"] SIMPLE_PATH_CIRCLEPATH) THEN
      MP_TAC (← SPECL [← q r"Cx(&0)", ← q r"&1"] PATH_IMAGE_CIRCLEPATH) THEN
      REWRITE_TAC [simple_path] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [path_image, EXTENSION, IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [],
      MATCH_MP_TAC HAS_BOUNDED_VARIATION_LIPSCHITZ_COMPOSE THEN
      SIMP_TAC [← GSYM path_image, PATH_IMAGE_CIRCLEPATH, REAL_POS] THEN
      ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      MP_TAC (← SPECL [← q r"Cx(&0)", ← q r"&1"] RECTIFIABLE_PATH_CIRCLEPATH) THEN
      SIMP_TAC [rectifiable_path]])

  let RECTIFIABLE_LOOP_FRONTIER_CONVEX ← prove
   r"!s:real^2->bool.
        bounded s /\ convex s /\ ~(interior s = {})
        ==> ?g. simple_path g /\
                rectifiable_path g /\
                pathfinish g = pathstart g /\
                path_image g = frontier s"
   (SIMP_TAC [← GSYM RELATIVE_FRONTIER_NONEMPTY_INTERIOR] THEN
    SIMP_TAC [IMP_CONJ, ← GSYM AFF_DIM_NONEMPTY_INTERIOR_EQ, DIMINDEX_2] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [RECTIFIABLE_LOOP_RELATIVE_FRONTIER_CONVEX])

  let RECTIFIABLE_PATH_FRONTIER_CONVEX ← prove
   r"!s:real^2->bool.
        bounded s /\ convex s /\ ~(s = {})
        ==> ?g. rectifiable_path g /\
                pathfinish g = pathstart g /\
                path_image g = frontier s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [← GSYM FRONTIER_CLOSURE_CONVEX, ← GSYM COMPACT_CLOSURE] THEN
    SUBGOAL_THEN
     (← q r"compact(closure s:real^2->bool) /\ convex(closure s) /\ ~(closure s = {})")
    MP_TAC THENL
     [ASM_SIMP_TAC [CONVEX_CLOSURE, COMPACT_CLOSURE, CLOSURE_EQ_EMPTY],
      POP_ASSUM_LIST (K ALL_TAC) THEN
      SPEC_TAC (← q r"closure s:real^2->bool", ← q r"s:real^2->bool")] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"interior s:real^2->bool = {}") THENL
     [ALL_TAC,
      MP_TAC (← SPEC (← q r"s:real^2->bool") RECTIFIABLE_LOOP_FRONTIER_CONVEX) THEN
      ASM_SIMP_TAC [COMPACT_IMP_BOUNDED] THEN MESON_TAC []] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP AFF_DIM_NONEMPTY_INTERIOR_EQ) THEN
    ASM_REWRITE_TAC [DIMINDEX_2] THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"s:real^2->bool") COMPACT_CONVEX_COLLINEAR_SEGMENT) THEN
    ASM_REWRITE_TAC [COLLINEAR_AFF_DIM, ← INT_ARITH (← q r"x:int <= &1 <=> x < &2")] THEN
    ASM_REWRITE_TAC [INT_LT_LE] THEN REWRITE_TAC [← GSYM DIMINDEX_2] THEN
    REWRITE_TAC [AFF_DIM_LE_UNIV, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real^2", ← q r"b:real^2"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"linepath(a:real^2,b) ++ linepath(b,a)") THEN
    SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PATH_IMAGE_JOIN,
             RECTIFIABLE_PATH_JOIN, RECTIFIABLE_PATH_LINEPATH,
             PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
    ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH, FRONTIER_SEGMENT] THEN
    REWRITE_TAC [SEGMENT_SYM, DIMINDEX_2, LE_REFL, UNION_IDEMPOT])

  /- Hence the Cauchy formula for points inside a circle. -/

  let CAUCHY_INTEGRAL_CIRCLEPATH ← prove
   r"!f z r w.
        f continuous_on cball(z,r) /\
        f holomorphic_on ball(z,r) /\
        w IN ball(z,r)
        ==> ((\u. f(u) / (u - w)) has_path_integral
             (Cx(&2) * Cx(pi) * ii * f(w))) (circlepath(z,r))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"cball(z:complex,r)",
                  ← q r"{}:complex->bool", ← q r"circlepath(z,r)", ← q r"w:complex"]
                 CAUCHY_INTEGRAL_FORMULA_WEAK) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
    ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [dist] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [WINDING_NUMBER_CIRCLEPATH, COMPLEX_MUL_LID] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [VALID_PATH_CIRCLEPATH, PATHSTART_CIRCLEPATH, FINITE_RULES,
         PATHFINISH_CIRCLEPATH, CONVEX_CBALL, INTERIOR_CBALL, DIFF_EMPTY] THEN
    REWRITE_TAC [complex_differentiable] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REAL_ARITH
     (← q r"n < r ==> &0 <= n ==> &0 <= r"))) THEN
    SIMP_TAC [NORM_POS_LE, PATH_IMAGE_CIRCLEPATH] THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET c DELETE q <=> s SUBSET c /\ ~(q IN s)")] THEN
    REWRITE_TAC [SPHERE_SUBSET_CBALL, IN_SPHERE] THEN
    UNDISCH_TAC (← q r"norm(w - z:complex) < r") THEN CONV_TAC (fun t => NORM_ARITH t))

  let CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE ← prove
   r"!f z r w.
        f holomorphic_on cball(z,r) /\ w IN ball(z,r)
        ==> ((\u. f(u) / (u - w)) has_path_integral
             (Cx(&2) * Cx(pi) * ii * f(w))) (circlepath(z,r))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_INTEGRAL_CIRCLEPATH THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
    ASM_MESON_TAC [BALL_SUBSET_CBALL, HOLOMORPHIC_ON_SUBSET])

  pure { RECTIFIABLE_LOOP_RELATIVE_FRONTIER_CONVEX, RECTIFIABLE_LOOP_FRONTIER_CONVEX,
         RECTIFIABLE_PATH_FRONTIER_CONVEX, CAUCHY_INTEGRAL_CIRCLEPATH,
         CAUCHY_INTEGRAL_CIRCLEPATH_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Uniform convergence of path integral when the derivative of the path is   -/
/- bounded, and in particular for the special case of a circle.              -/
/- (cauchy.ml 7644-7737)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAG where
  PATH_INTEGRAL_UNIFORM_LIMIT : thm
  PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAG [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYF : KYF) (BKYAE : KYAE) : ExceptT String IO KYAG := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL, path_integrable_on, PATH_INTEGRABLE_ON, .. } := BKYC
  let { PATH_INTEGRAL_INTEGRAL, .. } := BKYF
  let { VALID_PATH_CIRCLEPATH, VECTOR_DERIVATIVE_CIRCLEPATH, .. } := BKYAE
  let { CONTENT_UNIT_1, .. } := D.qintegration
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { EVENTUALLY_HAPPENS, .. } := D.mt.ra.qmetric
  let { INTEGRABLE_UNIFORM_LIMIT, .. } := D.mt.ra.qintegration
  let { COMPLEX_SUB_RDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, IM_CX, RE_MUL_CX, RE_MUL_II,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { INTEGRABLE_CONST, INTEGRABLE_SUB, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, INTEGRAL_CONST, INTEGRAL_NORM_BOUND_INTEGRAL, INTEGRAL_SUB,
        .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { ARITH, ETA_AX, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_MUL, REAL_LE_MUL2, REAL_LE_REFL, REAL_LE_TRANS,
        REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_MUL_RZERO, REAL_NEG_0, REAL_OF_NUM_LT,
        REAL_SUB_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_abs, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { LIFT_DROP, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_LID, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { LIM_NULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { EVENTUALLY_AND, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qmetric
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { tendsto, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let PATH_INTEGRAL_UNIFORM_LIMIT ← prove
   r"!net f B g l.
     ~(trivial_limit net) /\ valid_path g /\
     (!t. t IN interval[vec 0,vec 1]
          ==> norm(vector_derivative g (at t)) <= B) /\
     eventually (\n:A. (f n) path_integrable_on g) net /\
     (!e. &0 < e
          ==> eventually (\n. !x. x IN path_image g
                                  ==> norm(f n x - l x) < e) net)
     ==> l path_integrable_on g /\
         ((\n. path_integral g (f n)) --> path_integral g l) net"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
     [REWRITE_TAC [path_integrable_on, HAS_PATH_INTEGRAL, ← GSYM integrable_on] THEN
      MATCH_MP_TAC INTEGRABLE_UNIFORM_LIMIT THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / (abs B + &1)")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < abs B + &1")] THEN
      UNDISCH_TAC (← q r"eventually (\n:A. (f n) path_integrable_on g) net") THEN
      REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      ASM_REWRITE_TAC [path_image, path_integrable_on, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [HAS_PATH_INTEGRAL, ← GSYM integrable_on] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. f (a:A) (g x) * vector_derivative g (at x)") THEN
      ASM_REWRITE_TAC [← GSYM COMPLEX_SUB_RDISTRIB] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"e / (abs B + &1) * B") THEN CONJ_TAC THENL
       [REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [NORM_POS_LE] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE],
        REWRITE_TAC [← REAL_ARITH (← q r"e / x * B <= e <=> &0 <= e * (&1 - B / x)")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_SUB_LE, REAL_LE_LDIV_EQ,
                     ← REAL_ARITH (← q r"&0 < abs B + &1")] THEN
        REAL_ARITH_TAC],
      ALL_TAC] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [LIM_NULL] THEN REWRITE_TAC [tendsto] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2 / (abs B + &1)")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, ← REAL_ARITH (← q r"&0 < abs B + &1"), REAL_HALF] THEN
    UNDISCH_TAC (← q r"eventually (\n:A. (f n) path_integrable_on g) net") THEN
    REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [PATH_INTEGRAL_INTEGRAL, DIST_0, ← GSYM INTEGRAL_SUB,
                 ← GSYM PATH_INTEGRABLE_ON, ETA_AX] THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC
     (← q r"drop(integral (interval[vec 0,vec 1]) (\x:real^1. lift(e / &2)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_SIMP_TAC [INTEGRABLE_SUB, ← GSYM PATH_INTEGRABLE_ON, ETA_AX] THEN
      REWRITE_TAC [INTEGRABLE_CONST, ← GSYM COMPLEX_SUB_RDISTRIB, LIFT_DROP] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC (← q r"e / &2 / (abs B + &1) * B") THEN CONJ_TAC THENL
       [REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [NORM_POS_LE] THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [IN_IMAGE, path_image] THEN ASM_MESON_TAC [],
        REWRITE_TAC [← REAL_ARITH (← q r"e / x * B <= e <=> &0 <= e * (&1 - B / x)")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_SUB_LE, REAL_LE_LDIV_EQ,
                     ← REAL_ARITH (← q r"&0 < abs B + &1")] THEN
        ASM_REAL_ARITH_TAC],
      REWRITE_TAC [INTEGRAL_CONST, CONTENT_UNIT_1, VECTOR_MUL_LID, LIFT_DROP] THEN
      ASM_REAL_ARITH_TAC])

  let PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH ← prove
   r"!net f l z r.
     &0 < r /\ ~(trivial_limit net) /\
     eventually (\n:A. (f n) path_integrable_on circlepath(z,r)) net /\
     (!e. &0 < e
          ==> eventually (\n. !x. x IN path_image (circlepath(z,r))
                                  ==> norm(f n x - l x) < e) net)
     ==> l path_integrable_on circlepath(z,r) /\
         ((\n. path_integral (circlepath(z,r)) (f n))
          --> path_integral (circlepath(z,r)) l) net"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC PATH_INTEGRAL_UNIFORM_LIMIT THEN EXISTS_TAC (← q r"&2 * pi * r") THEN
    ASM_SIMP_TAC [PI_POS, REAL_LT_MUL, REAL_OF_NUM_LT, ARITH] THEN
    REWRITE_TAC [VALID_PATH_CIRCLEPATH, VECTOR_DERIVATIVE_CIRCLEPATH] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_CX, COMPLEX_NORM_II] THEN
    REWRITE_TAC [REAL_ABS_NUM, REAL_ABS_PI, REAL_MUL_LID] THEN
    REWRITE_TAC [NORM_CEXP, RE_MUL_CX, RE_MUL_II, IM_CX] THEN
    REWRITE_TAC [REAL_NEG_0, REAL_MUL_RZERO, REAL_EXP_0, REAL_MUL_RID] THEN
    ASM_SIMP_TAC [real_abs, REAL_LE_REFL, REAL_LT_IMP_LE])

  pure { PATH_INTEGRAL_UNIFORM_LIMIT, PATH_INTEGRAL_UNIFORM_LIMIT_CIRCLEPATH }
/- ------------------------------------------------------------------------- -/
/- General stepping result for derivative formulas; in particular, the      -/
/- first derivative formula.                                                 -/
/- (cauchy.ml 7738-8003)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYAH where
  CAUCHY_NEXT_DERIVATIVE : thm
  CAUCHY_NEXT_DERIVATIVE_CIRCLEPATH : thm
  CAUCHY_DERIVATIVE_INTEGRAL_CIRCLEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYAH [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYC : KYC) (BKYG : KYG) (BKYN : KYN) (BKYAE : KYAE) (BKYAF : KYAF) (BKYAG : KYAG) : ExceptT String IO KYAH := do
  -- @@SCOPE BEGIN
  let { COMPACT_VALID_PATH_IMAGE, VALID_PATH_IMP_PATH, .. } := BKYB
  let { path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { HAS_PATH_INTEGRAL_COMPLEX_DIV, HAS_PATH_INTEGRAL_SUB, PATH_INTEGRABLE_COMPLEX_RMUL,
        PATH_INTEGRABLE_SUB, .. } := BKYG
  let { CX_2PII_NZ, .. } := BKYN
  let { PATH_IMAGE_CIRCLEPATH, VALID_PATH_CIRCLEPATH, VECTOR_DERIVATIVE_CIRCLEPATH,
        .. } := BKYAE
  let { CAUCHY_INTEGRAL_CIRCLEPATH, .. } := BKYAF
  let { PATH_INTEGRAL_UNIFORM_LIMIT, .. } := BKYAG
  let { LIM_TRANSFORM_AT, .. } := D.qtopology
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { REAL_ABS_PI, .. } := D.mt.ra.tse
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { LIM_COMPLEX_LMUL, .. } := D.mt.ra.ts.knb
  let { HAS_COMPLEX_DERIVATIVE_AT_WITHIN, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_AT, HAS_COMPLEX_DERIVATIVE_LMUL_AT, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_TAYLOR, .. } := D.mt.ra.ts.knl
  let { LT_NZ, .. } := D.mt.ra.ts.qsession
  let { complex_div, complex_pow, .. } := D.mt.ra.ts.cn.cxa
