  let HOLOMORPHIC_FACTOR_ORDER_OF_ZERO ← prove
   r"!f s n.
      open s /\ z IN s /\ f holomorphic_on s /\
      0 < n /\ ~(higher_complex_derivative n f z = Cx(&0)) /\
      (!m. 0 < m /\ m < n ==> higher_complex_derivative m f z = Cx(&0))
      ==> ?g r. &0 < r /\
                g holomorphic_on ball(z,r) /\
                (!w. w IN ball(z,r) ==> f(w) - f(z) = (w - z) pow n * g(w)) /\
                (!w. w IN ball(z,r) ==> ~(g w = Cx(&0)))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!w. w IN ball(z,r)
          ==> ((\m. higher_complex_derivative m f z / Cx(&(FACT m)) *
                    (w - z) pow m) sums f(w) - f(z)) (from n)")
    ASSUME_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"z:complex", ← q r"w:complex", ← q r"r:real"]
          HOLOMORPHIC_POWER_SERIES) THEN ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"1") o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [VSUM_SING_NUMSEG] THEN
      REWRITE_TAC [FACT, higher_complex_derivative, COMPLEX_DIV_1] THEN
      REWRITE_TAC [complex_pow, COMPLEX_MUL_RID] THEN
      ASM_CASES_TAC (← q r"n = 1") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"n:num") o
        MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, MATCH_MP_TAC EQ_IMP] THEN
      AP_THM_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"p = Cx(&0) ==> w - z - p = w - z"))) THEN
      REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC VSUM_EQ_0 THEN
      REWRITE_TAC [IN_NUMSEG, COMPLEX_VEC_0] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [COMPLEX_ENTIRE, complex_div] THEN REPEAT DISJ1_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      ALL_TAC] THEN
    ABBREV_TAC
     (← q r"g = \w. infsum (from 0)
                     (\m. higher_complex_derivative (m + n) f z /
                          Cx(&(FACT(m + n))) * (w - z) pow m)") THEN
    SUBGOAL_THEN
     (← q r"!w. w IN ball(z,r)
          ==> ((\m. higher_complex_derivative (m + n) f z /
                    Cx(&(FACT(m + n))) * (w - z) pow m)
               sums g(w)) (from 0)")
    (LABEL_TAC "*") THENL
     [REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN REWRITE_TAC [SUMS_INFSUM] THEN
      ASM_CASES_TAC (← q r"w:complex = z") THENL
       [MATCH_MP_TAC SUMMABLE_FROM_ELSEWHERE THEN EXISTS_TAC (← q r"1") THEN
        MATCH_MP_TAC SUMMABLE_EQ THEN EXISTS_TAC (← q r"\n:num. Cx(&0)") THEN
        REWRITE_TAC [SUMMABLE_0, ← GSYM COMPLEX_VEC_0] THEN
        ASM_SIMP_TAC [IN_FROM, COMPLEX_VEC_0, COMPLEX_SUB_REFL,
                     COMPLEX_POW_ZERO, LE_1, COMPLEX_MUL_RZERO],
        SUBGOAL_THEN
         (← q r"!x:complex m. x * (w - z) pow m =
                        (x * (w - z) pow (m + n)) / (w - z) pow n")
         (fun th => ONCE_REWRITE_TAC [th])
        THENL
         [REPEAT GEN_TAC THEN
          SIMP_TAC [complex_div, ← GSYM COMPLEX_MUL_ASSOC, COMPLEX_POW_ADD] THEN
          ASM_SIMP_TAC [COMPLEX_MUL_RINV, COMPLEX_POW_EQ_0, COMPLEX_SUB_0] THEN
          REWRITE_TAC [COMPLEX_MUL_RID],
          MATCH_MP_TAC SUMMABLE_COMPLEX_DIV THEN
          MP_TAC (← GEN (← q r"a:num->complex")
            (← ISPECL [← q r"n:num", ← q r"a:num->complex"] SUMMABLE_REINDEX)) THEN
          DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
          REWRITE_TAC [summable, ADD_CLAUSES] THEN ASM_MESON_TAC []]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"g holomorphic_on ball(z,r)") ASSUME_TAC THENL
     [MATCH_MP_TAC POWER_SERIES_HOLOMORPHIC THEN
      EXISTS_TAC (← q r"\m. higher_complex_derivative (m + n) f z /
                      Cx(&(FACT (m + n)))") THEN
      EXISTS_TAC (← q r"from 0") THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!w. w IN ball(z,r) ==> f w - f z = (w - z) pow n * g(w)")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC SERIES_UNIQUE THEN
      EXISTS_TAC (← q r"\m. higher_complex_derivative m f z / Cx(&(FACT m)) *
                      (w - z) pow m") THEN
      EXISTS_TAC (← q r"from n") THEN ASM_SIMP_TAC [] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← ARITH_RULE (← q r"n = 0 + n")] THEN
      REWRITE_TAC [← GSYM SUMS_REINDEX] THEN REWRITE_TAC [COMPLEX_POW_ADD] THEN
      ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a * b * c:complex = c * a * b"))] THEN
      MATCH_MP_TAC SERIES_COMPLEX_LMUL THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"g:complex->complex") THEN
    SUBGOAL_THEN (← q r"(g:complex->complex) continuous_on ball(z,r)") MP_TAC THENL
     [ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON], ALL_TAC] THEN
    REWRITE_TAC [continuous_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN DISCH_THEN (MP_TAC o SPEC
     (← q r"norm((g:complex->complex) z)")) THEN
    ANTS_TAC THENL
     [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_REWRITE_TAC [CENTRE_IN_BALL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"1") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] SUMS_OFFSET)) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      CONV_TAC NUM_REDUCE_CONV THEN REWRITE_TAC [VSUM_SING_NUMSEG] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&0)") o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] SERIES_UNIQUE)) THEN
      REWRITE_TAC [complex_pow, ADD_CLAUSES, COMPLEX_MUL_RID] THEN ANTS_TAC THENL
       [REWRITE_TAC [← GSYM COMPLEX_VEC_0] THEN MATCH_MP_TAC SUMS_0 THEN
        SIMP_TAC [IN_FROM, LE_1, COMPLEX_SUB_REFL, COMPLEX_POW_ZERO] THEN
        REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_MUL_RZERO],
        SIMP_TAC [COMPLEX_SUB_0, NORM_POS_LT] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        ASM_REWRITE_TAC [COMPLEX_VEC_0, complex_div, COMPLEX_ENTIRE] THEN
        REWRITE_TAC [COMPLEX_INV_EQ_0, CX_INJ, REAL_OF_NUM_EQ, FACT_NZ]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"min d r:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    SUBGOAL_THEN (← q r"ball(z,min d r) SUBSET ball(z:complex,r)") ASSUME_TAC THENL
     [SIMP_TAC [SUBSET_BALL, ← REAL_ARITH (← q r"min d r <= r")], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    REWRITE_TAC [IN_BALL, REAL_LT_MIN, ← GSYM COMPLEX_VEC_0] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_BALL]) THEN
    ASM_MESON_TAC [DIST_SYM, ← NORM_ARITH (← q r"dist(x,y) < norm y ==> ~(x = vec 0)")])

  let HOLOMORPHIC_FACTOR_ORDER_OF_ZERO_STRONG ← prove
   r"!f s n z.
      open s /\ z IN s /\ f holomorphic_on s /\
      0 < n /\ ~(higher_complex_derivative n f z = Cx(&0)) /\
      (!m. 0 < m /\ m < n ==> higher_complex_derivative m f z = Cx(&0))
      ==> ?g r. &0 < r /\
                g holomorphic_on ball(z,r) /\
                (!w. w IN ball(z,r)
                     ==> f(w) - f(z) = ((w - z) * g w) pow n) /\
                (!w. w IN ball(z,r) ==> ~(g w = Cx(&0)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"n:num"]
          HOLOMORPHIC_FACTOR_ORDER_OF_ZERO) THEN
    ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"r:real") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"\z. complex_derivative g z / g z", ← q r"ball(z:complex,r)",
      ← q r"{}:complex->bool"] HOLOMORPHIC_CONVEX_PRIMITIVE) THEN
    REWRITE_TAC [CONVEX_BALL, FINITE_RULES, DIFF_EMPTY] THEN ANTS_TAC THENL
     [SIMP_TAC [← GSYM HOLOMORPHIC_ON_OPEN, OPEN_BALL,
               INTERIOR_OPEN, complex_differentiable] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN
      REWRITE_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, OPEN_BALL,
                   HOLOMORPHIC_ON_DIV, ETA_AX],
      SIMP_TAC [OPEN_BALL, HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:complex->complex") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL [← q r"\z:complex. cexp(h z) / g z", ← q r"ball(z:complex,r)"]
      HAS_COMPLEX_DERIVATIVE_ZERO_CONNECTED_CONSTANT) THEN
    REWRITE_TAC [OPEN_BALL, CONNECTED_BALL] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"Cx(&0) = ((complex_derivative g w / g w * cexp(h w)) * g w -
                  cexp(h w) * complex_derivative g w) / g w pow 2")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(z = Cx(&0)) ==> (d / z * e) * z = e * d"))] THEN
        SIMPLE_COMPLEX_ARITH_TAC,
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_DIV_AT THEN
        ASM_SIMP_TAC [] THEN CONJ_TAC THENL
         [GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
          ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
          MATCH_MP_TAC COMPLEX_DIFF_CHAIN_AT THEN
          ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_CEXP],
          ASM_MESON_TAC [HOLOMORPHIC_ON_OPEN, complex_differentiable,
            OPEN_BALL, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE]]],
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:complex") MP_TAC) THEN
      ASM_CASES_TAC (← q r"c = Cx(&0)") THENL
       [ASM_SIMP_TAC [CEXP_NZ, ← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(x = Cx(&0)) /\ ~(y = Cx(&0)) ==> ~(x / y = Cx(&0))"))] THEN
        ASM_MESON_TAC [],
        ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
         (← q r"~(y = Cx(&0)) /\ ~(z = Cx(&0))
          ==> (x / y = z <=> y = inv(z) * x)"))] THEN
        DISCH_TAC THEN EXISTS_TAC
         (← q r"\z:complex. cexp((clog(inv c) + h z) / Cx(&n))") THEN
        REWRITE_TAC [CEXP_NZ, ← GSYM CEXP_N, COMPLEX_POW_MUL] THEN
        ASM_SIMP_TAC [COMPLEX_DIV_LMUL, CX_INJ, REAL_OF_NUM_EQ, LE_1] THEN
        ASM_SIMP_TAC [CEXP_ADD, CEXP_CLOG, COMPLEX_INV_EQ_0] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        REWRITE_TAC [HOLOMORPHIC_ON_CEXP] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
        ASM_SIMP_TAC [HOLOMORPHIC_ON_CONST, CX_INJ, REAL_OF_NUM_EQ, LE_1] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_ADD THEN
        REWRITE_TAC [HOLOMORPHIC_ON_CONST] THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL]]])

  let HOLOMORPHIC_FACTOR_ZERO_NONCONSTANT ← prove
   r"!f s z.
        open s /\ connected s /\ z IN s /\
        f holomorphic_on s /\ f(z) = Cx(&0) /\ ~(?c. !w. w IN s ==> f w = c)
        ==> ?g r n.
                0 < n /\ &0 < r /\ ball(z,r) SUBSET s /\
                g holomorphic_on ball(z,r) /\
                (!w. w IN ball(z,r) ==> f w = (w - z) pow n * g w) /\
                (!w. w IN ball(z,r) ==> ~(g w = Cx(&0)))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"!n. 0 < n ==> higher_complex_derivative n f z = Cx(&0)") THENL
     [MP_TAC (← ISPECL
       [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"z:complex"]
       HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED) THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r0:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
      REWRITE_TAC [NOT_IMP, ← GSYM IMP_CONJ_ALT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"n:num"]
          HOLOMORPHIC_FACTOR_ORDER_OF_ZERO) THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_RZERO] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"g:complex->complex") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r1:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min r0 r1:real") THEN EXISTS_TAC (← q r"n:num") THEN
      ASM_SIMP_TAC [BALL_MIN_INTER, IN_INTER, REAL_LT_MIN] THEN CONJ_TAC THENL
       [ASM SET_TAC [],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOLOMORPHIC_ON_SUBSET)) THEN
        ASM SET_TAC []]])

  let HOLOMORPHIC_LOWER_BOUND_DIFFERENCE ← prove
   r"!f s z.
        open s /\ connected s /\ z IN s /\ f holomorphic_on s /\
        ~(!w. w IN s ==> f w = f z)
        ==> ?k n r. &0 < k /\ &0 < r /\ ball(z,r) SUBSET s /\
                    !w. w IN ball(z,r)
                        ==> k * norm(w - z) pow n <= norm(f w - f z)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"z:complex"]
          HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED) THEN
    ASM_REWRITE_TAC [NOT_FORALL_THM] THEN GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
    REWRITE_TAC [NOT_IMP, IMP_IMP] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"n:num"]
          HOLOMORPHIC_FACTOR_ORDER_OF_ZERO) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:complex->complex", ← q r"r:real"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"d = min e r / &2") THEN
    SUBGOAL_THEN (← q r"ball(z,d) SUBSET cball(z,d) /\
                  cball(z:complex,d) SUBSET ball(z,r) /\
                  cball(z,d) SUBSET ball(z,e)") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET_BALLS, DIST_REFL] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"IMAGE (g:complex->complex) (cball(z,d))", ← q r"Cx(&0)"]
          DISTANCE_ATTAINS_INF) THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY] THEN
    REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_SUB, CBALL_EQ_EMPTY] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [MATCH_MP_TAC COMPACT_IMP_CLOSED, ASM_REAL_ARITH_TAC] THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN REWRITE_TAC [COMPACT_CBALL] THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                    SUBSET_TRANS],
      REWRITE_TAC [COMPLEX_SUB_RZERO] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:complex") STRIP_ASSUME_TAC)] THEN
    MAP_EVERY EXISTS_TAC [← q r"norm((g:complex->complex) p)", ← q r"d:real"] THEN
    ASM_REWRITE_TAC [COMPLEX_NORM_NZ] THEN REPEAT CONJ_TAC THENL
     [ASM SET_TAC [], ASM_REAL_ARITH_TAC, ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET]) THEN ASM_SIMP_TAC [] THEN
    ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_POW] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN SIMP_TAC [REAL_POW_LE, NORM_POS_LE] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  pure { HOLOMORPHIC_FACTOR_ORDER_OF_ZERO, HOLOMORPHIC_FACTOR_ORDER_OF_ZERO_STRONG,
         HOLOMORPHIC_FACTOR_ZERO_NONCONSTANT, HOLOMORPHIC_LOWER_BOUND_DIFFERENCE }
/- ------------------------------------------------------------------------- -/
/- Pole at infinity; entire proper functions are the polynomials.           -/
/- (cauchy.ml 14490-14731)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBJ where
  POLE_AT_INFINITY : thm
  PROPER_MAP_COMPLEX_POLYFUN : thm
  PROPER_MAP_COMPLEX_POLYFUN_UNIV : thm
  PROPER_MAP_COMPLEX_POLYFUN_EQ : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBJ [HolBase] (D : CauchyDeps) (BKYAM : KYAM) (BKYAW : KYAW) (BKYBC : KYBC) (BKYBI : KYBI) : ExceptT String IO KYBJ := do
  -- @@SCOPE BEGIN
  let { LIOUVILLE_WEAK, .. } := BKYAM
  let { HOLOMORPHIC_ON_EXTEND_BOUNDED, .. } := BKYAW
  let { LIOUVILLE_POLYNOMIAL, .. } := BKYBC
  let { HOLOMORPHIC_LOWER_BOUND_DIFFERENCE, .. } := BKYBI
  let { EVENTUALLY_AT_INFINITY_POS, .. } := D.qtopology
  let { REAL_LT_LINV, .. } := D.qsession
  let { CONNECTED_OPEN_DELETE, .. } := D.qpaths
  let { COMPLEX_IN_BALL_0, .. } := D.mt.ra.ts.kna
  let { LIM_COMPLEX_INV, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_COMPLEX_LMUL, CONTINUOUS_COMPLEX_POW, CONTINUOUS_ON_COMPLEX_INV,
        .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_INV,
        .. } := D.mt.ra.ts.knh
  let { LIM_AT_INFINITY_COMPLEX_0, .. } := D.mt.ra.ts.knp
  let { REAL_INV_1_LE, .. } := D.mt.ra.ts.qsession
  let { complex_pow, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_LZERO, COMPLEX_MUL_RID, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_NORM_CX, COMPLEX_VEC_0, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_INV_INV, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_INV_EQ_0, COMPLEX_NORM_0, COMPLEX_NORM_INV, COMPLEX_NORM_NZ,
        .. } := D.mt.ra.ts.cn.cxf
  let { COMPLEX_POLYFUN_EXTREMAL, .. } := D.mt.ra.ts.cn.cxn
  let { LIM_AT_INFINITY, .. } := D.mt.ra.ts.cn.qtopology
  let { CLOSED_DIFF, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { ADD_CLAUSES, LE_0, VSUM_CLAUSES_LEFT, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH, CONTRAPOS_THM, DIMINDEX_2, ETA_AX, FINITE_NUMSEG,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FUN_EQ_THM, IMP_CONJ, IN_DELETE, IN_DIFF,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIV, LE_1, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_AND, MONO_EXISTS, MONO_FORALL, NOT_EXISTS_THM,
        NOT_FORALL_THM, NOT_IMP, NOT_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_MUL, REAL_LE_INV2, REAL_LT_01, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_INV_EQ, REAL_LT_MUL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LT, REAL_POW_INV, REAL_POW_LT, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { num_MAX, o_ASSOC, o_DEF, o_THM, real_ge, SUBSET_UNIV, SWAP_EXISTS_THM, UNIV_GSPEC,
        .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { dist, VECTOR_ADD_RID, VSUM_0, VSUM_CLAUSES_NUMSEG, VSUM_EQ_SUPERSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { EVENTUALLY_MONO, .. } := D.mt.ra.ts.cn.cx.cvx.met
  let { BOUNDED_POS, CENTRE_IN_BALL, CLOSED_INTER_COMPACT, CLOSED_SING, CLOSED_UNIV,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_EQ_BOUNDED_CLOSED, COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED,
        COMPACT_SING, CONNECTED_CLOSED, CONNECTED_CONTINUOUS_IMAGE, CONTINUOUS_AT_ID,
        CONTINUOUS_CLOSED_PREIMAGE_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, CONTINUOUS_VSUM, EVENTUALLY_AT,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_CBALL_0, INTERIOR_OPEN, LIM_UNIQUE, NOT_BOUNDED_UNIV, OPEN_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { CONTINUOUS_AT, CONTINUOUS_ON_EQ_CONTINUOUS_AT, LIM_AT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_TRANSFORM_WITHIN_OPEN, TRIVIAL_LIMIT_AT,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { SUBSET_NUMSEG, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { tendsto, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let POLE_AT_INFINITY ← prove
   r"!f l. f holomorphic_on (:complex) /\ ((inv o f) --> l) at_infinity
         ==> ?a n. !z. f(z) = vsum(0..n) (\i. a i * z pow i)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"l = Cx(&0)") THENL
     [FIRST_X_ASSUM SUBST1_TAC THEN STRIP_TAC,
      REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] LIM_COMPLEX_INV)) THEN
      ASM_REWRITE_TAC [o_THM, COMPLEX_INV_INV, ETA_AX] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"inv(l:complex)"]
          LIOUVILLE_WEAK) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"(\n. inv l):num->complex") THEN EXISTS_TAC (← q r"0") THEN
      REWRITE_TAC [VSUM_CLAUSES_NUMSEG, complex_pow, COMPLEX_MUL_RID]] THEN
    ASM_CASES_TAC
     (← q r"?r. &0 < r /\
          !z. z IN ball(Cx(&0),r) DELETE Cx(&0) ==> ~(f(inv z) = Cx(&0))")
    THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"inv o (f:complex->complex) o inv", ← q r"Cx(&0)",
                     ← q r"ball(Cx(&0),r)"] HOLOMORPHIC_ON_EXTEND_BOUNDED) THEN
      ASM_SIMP_TAC [INTERIOR_OPEN, OPEN_BALL, CENTRE_IN_BALL] THEN ANTS_TAC THENL
       [REWRITE_TAC [o_DEF] THEN MATCH_MP_TAC HOLOMORPHIC_ON_INV THEN
        ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN CONJ_TAC THENL
         [ALL_TAC, ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV]] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_INV THEN
        REWRITE_TAC [HOLOMORPHIC_ON_ID] THEN SET_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"&1") THEN FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE id [LIM_AT_INFINITY_COMPLEX_0]) THEN
        REWRITE_TAC [tendsto] THEN DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
        REWRITE_TAC [REAL_LT_01] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        REWRITE_TAC [o_THM, dist, COMPLEX_SUB_RZERO] THEN CONV_TAC (fun t => NORM_ARITH t),
        REWRITE_TAC [o_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") STRIP_ASSUME_TAC)] THEN
      SUBGOAL_THEN (← q r"(g:complex->complex)(Cx(&0)) = Cx(&0)") ASSUME_TAC THENL
       [MATCH_MP_TAC (← ISPEC (← q r"at(Cx(&0))") LIM_UNIQUE) THEN
        EXISTS_TAC (← q r"g:complex->complex") THEN REWRITE_TAC [TRIVIAL_LIMIT_AT] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [← GSYM CONTINUOUS_AT] THEN
          ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_BALL,
                        CENTRE_IN_BALL, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON],
          MATCH_MP_TAC LIM_TRANSFORM_WITHIN_OPEN THEN
          EXISTS_TAC (← q r"inv o (f:complex->complex) o inv") THEN
          EXISTS_TAC (← q r"ball(Cx(&0),r)") THEN
          ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, o_ASSOC, o_THM,
                          ← GSYM LIM_AT_INFINITY_COMPLEX_0] THEN
          ASM SET_TAC []],
        ALL_TAC] THEN
      EXISTS_TAC (← q r"\k. higher_complex_derivative k f (Cx(&0)) / Cx(&(FACT k))") THEN
      MP_TAC (← ISPECL [← q r"g:complex->complex", ← q r"ball(Cx(&0),r)", ← q r"Cx(&0)"]
          HOLOMORPHIC_LOWER_BOUND_DIFFERENCE) THEN
      ASM_REWRITE_TAC [OPEN_BALL, CONNECTED_BALL, CENTRE_IN_BALL] THEN
      ANTS_TAC THENL
       [SUBGOAL_THEN (← q r"~(ball(Cx(&0),r) DELETE Cx(&0) = {})") MP_TAC THENL
         [ALL_TAC, ASM SET_TAC [COMPLEX_INV_EQ_0]] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, COMPLEX_IN_BALL_0, IN_DELETE] THEN
        EXISTS_TAC (← q r"Cx(r / &2)") THEN REWRITE_TAC [COMPLEX_NORM_CX, CX_INJ] THEN
        ASM_REAL_ARITH_TAC,
        REWRITE_TAC [COMPLEX_SUB_RZERO]] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      MATCH_MP_TAC LIOUVILLE_POLYNOMIAL THEN
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"B:real") (X_CHOOSE_THEN (← q r"e:real")
          STRIP_ASSUME_TAC)) THEN
      MAP_EVERY EXISTS_TAC [← q r"&2 / e", ← q r"inv(B:real)"] THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"inv(z) IN ball(Cx(&0),e) DELETE Cx(&0)") ASSUME_TAC THENL
       [REWRITE_TAC [IN_DELETE, COMPLEX_INV_EQ_0, COMPLEX_IN_BALL_0] THEN
        REWRITE_TAC [COMPLEX_NORM_INV] THEN CONJ_TAC THENL
         [MATCH_MP_TAC REAL_LT_LINV THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
           (← q r"&2 / e <= z ==> &0 < inv e ==> inv e < z"))) THEN
          ASM_REWRITE_TAC [REAL_LT_INV_EQ],
          UNDISCH_TAC (← q r"&2 / e <= norm(z:complex)") THEN
          ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
          SIMP_TAC [COMPLEX_NORM_0, REAL_NOT_LE] THEN
          ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH]],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"inv(z) IN ball(Cx(&0),r) DELETE Cx(&0)") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(f:complex->complex) z = inv(g(inv z))") SUBST1_TAC THENL
       [ASM_SIMP_TAC [COMPLEX_INV_INV], ALL_TAC] THEN
      GEN_REWRITE_TAC (RAND_CONV o RAND_CONV o LAND_CONV o RAND_CONV)
       [← GSYM COMPLEX_INV_INV] THEN
      ONCE_REWRITE_TAC [COMPLEX_NORM_INV] THEN
      REWRITE_TAC [REAL_POW_INV, ← GSYM REAL_INV_MUL] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_POW_LT THEN REWRITE_TAC [COMPLEX_NORM_NZ] THEN
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [LIM_AT_INFINITY_COMPLEX_0]) THEN
      REWRITE_TAC [LIM_AT, o_THM, dist, COMPLEX_SUB_RZERO] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN REWRITE_TAC [REAL_LT_01] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"r:real")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, IN_DELETE, COMPLEX_IN_BALL_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:complex") STRIP_ASSUME_TAC) THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"Cx(&0)"] LIOUVILLE_WEAK) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [],
        DISCH_TAC THEN MAP_EVERY EXISTS_TAC [← q r"\n:num. Cx(&0)", ← q r"0"] THEN
        ASM_REWRITE_TAC [VSUM_CLAUSES_NUMSEG, COMPLEX_MUL_LZERO]] THEN
      REWRITE_TAC [LIM_AT_INFINITY_COMPLEX_0] THEN
      MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_AT] THEN
      EXISTS_TAC (← q r"r:real") THEN ASM_REWRITE_TAC [dist, COMPLEX_SUB_RZERO] THEN
      X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [o_THM, COMPLEX_NORM_NZ] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPEC
       (← q r"IMAGE ((f:complex->complex) o inv) (ball(Cx(&0),r) DELETE Cx(&0))")
          CONNECTED_CLOSED) THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (q ==> r) ==> (p <=> q) ==> r")) THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_CONTINUOUS_IMAGE THEN
        SIMP_TAC [CONNECTED_OPEN_DELETE, OPEN_BALL, CONNECTED_BALL,
                 DIMINDEX_2, LE_REFL] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_INV THEN
          REWRITE_TAC [CONTINUOUS_ON_ID] THEN SET_TAC [],
          ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                        HOLOMORPHIC_ON_SUBSET, SUBSET_UNIV]],
        ALL_TAC] THEN
      REWRITE_TAC [NOT_EXISTS_THM] THEN DISCH_THEN (MP_TAC o SPECL
       [← q r"{Cx(&0)}", ← q r"(:complex) DIFF ball(Cx(&0),&1)"]) THEN
      SIMP_TAC [CLOSED_SING, CLOSED_DIFF, CLOSED_UNIV, OPEN_BALL] THEN
      SIMP_TAC [CENTRE_IN_BALL, REAL_LT_01, ← SET_RULE
        (← q r"a IN s ==> {a} INTER (UNIV DIFF s) INTER t = {}")] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, o_THM, ← SET_RULE
       (← q r"s INTER IMAGE f t = {} <=> !x. x IN t ==> ~(f x IN s)")] THEN
      REWRITE_TAC [IN_SING, IN_DIFF, IN_UNIV, IN_UNION] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [IN_DELETE, COMPLEX_IN_BALL_0, ← GSYM COMPLEX_NORM_NZ] THEN
        X_GEN_TAC (← q r"x:complex") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:complex")) THEN
        MATCH_MP_TAC (← TAUT (← q r"(~q /\ ~r ==> ~p)   ==> p ==> q \/ r")) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_INV, REAL_NOT_LT] THEN
        STRIP_TAC THEN MATCH_MP_TAC REAL_INV_1_LE THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, COMPLEX_NORM_NZ],
        REWRITE_TAC [COMPLEX_IN_BALL_0, IN_DELETE] THEN ASM SET_TAC [],
        DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN
        ASM_REWRITE_TAC [COMPLEX_IN_BALL_0, IN_DELETE] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:complex")) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_NZ, REAL_NOT_LT, COMPLEX_NORM_INV] THEN
        MATCH_MP_TAC REAL_INV_1_LE THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE, COMPLEX_NORM_NZ]]])

  /- Entire proper functions C->C are precisely the non-trivial polynomials. -/

  let PROPER_MAP_COMPLEX_POLYFUN ← prove
   r"!s k c n. closed s /\ compact k /\ (?i. i IN 1..n /\ ~(c i = Cx(&0)))
             ==> compact {z | z IN s /\ vsum(0..n) (\i. c i * z pow i) IN k}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"c:num->complex", ← q r"n:num"] COMPLEX_POLYFUN_EXTREMAL) THEN
    DISCH_THEN DISJ_CASES_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"{x | x IN s /\ P x} = s INTER {x | P x}")] THEN
    MATCH_MP_TAC CLOSED_INTER_COMPACT THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [COMPACT_EQ_BOUNDED_CLOSED] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B + &1")) THEN
      REWRITE_TAC [EVENTUALLY_AT_INFINITY_POS, real_ge, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:real") THEN
      MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"z:complex") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
        (← q r"vsum(0..n) (\i. c i * z pow i)") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      MATCH_MP_TAC CONTINUOUS_CLOSED_PREIMAGE_UNIV THEN
      ASM_SIMP_TAC [COMPACT_IMP_CLOSED] THEN
      GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_VSUM THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_COMPLEX_LMUL THEN
      MATCH_MP_TAC CONTINUOUS_COMPLEX_POW THEN
      REWRITE_TAC [CONTINUOUS_AT_ID]])

  let PROPER_MAP_COMPLEX_POLYFUN_UNIV ← prove
   r"!k c n. compact k /\ (?i. i IN 1..n /\ ~(c i = Cx(&0)))
           ==> compact {z | vsum(0..n) (\i. c i * z pow i) IN k}"
   (MP_TAC (← SPEC (← q r"(:complex)") PROPER_MAP_COMPLEX_POLYFUN) THEN
    REWRITE_TAC [IN_UNIV, CLOSED_UNIV])

  let PROPER_MAP_COMPLEX_POLYFUN_EQ ← prove
   r"!f. f holomorphic_on (:complex)
       ==> ((!k. compact k ==> compact {z | f z IN k}) <=>
            ?c n. 0 < n /\ ~(c n = Cx(&0)) /\
                  f = \z. vsum(0..n) (\i. c i * z pow i))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC PROPER_MAP_COMPLEX_POLYFUN_UNIV THEN
      ASM_REWRITE_TAC [IN_NUMSEG] THEN ASM_MESON_TAC [LE_REFL, LE_1]] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"Cx(&0)"] POLE_AT_INFINITY) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [REWRITE_TAC [LIM_AT_INFINITY, real_ge] THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN REWRITE_TAC [← GSYM COMPLEX_VEC_0, DIST_0, o_THM] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"cball(vec 0:complex,inv e)")) THEN
      REWRITE_TAC [COMPACT_CBALL] THEN
      DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
      REWRITE_TAC [BOUNDED_POS, IN_ELIM_THM, IN_CBALL_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"B + &1") THEN ASM_SIMP_TAC [REAL_LT_MUL, REAL_LT_01] THEN
      X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"B + &1 <= x ==> ~(x <= B)"), REAL_NOT_LE] THEN
      ASM_SIMP_TAC [COMPLEX_NORM_INV, REAL_LT_LINV],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:num->complex") THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
      ASM_CASES_TAC (← q r"!i. i IN 1..n ==> a i = Cx(&0)") THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{a 0:complex}")) THEN
        ASM_SIMP_TAC [VSUM_CLAUSES_LEFT, LE_0, ADD_CLAUSES, COMPACT_SING] THEN
        SIMP_TAC [IN_SING, COMPLEX_MUL_LZERO, complex_pow, COMPLEX_MUL_RID] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0, VSUM_0, VECTOR_ADD_RID, UNIV_GSPEC] THEN
        MESON_TAC [COMPACT_IMP_BOUNDED, NOT_BOUNDED_UNIV],
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM]) THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          (← EQ_IMP_RULE (← SPEC_ALL num_MAX)).1)) THEN
        REWRITE_TAC [NOT_IMP, IN_NUMSEG] THEN
        ANTS_TAC THENL [MESON_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
        X_GEN_TAC (← q r"m:num") THEN STRIP_TAC THEN ASM_SIMP_TAC [LE_1, FUN_EQ_THM] THEN
        GEN_TAC THEN MATCH_MP_TAC VSUM_EQ_SUPERSET THEN
        ASM_REWRITE_TAC [SUBSET_NUMSEG, FINITE_NUMSEG, IN_NUMSEG, LE_0] THEN
        X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [COMPLEX_VEC_0, NOT_LE] THEN
        STRIP_TAC THEN REWRITE_TAC [COMPLEX_ENTIRE] THEN DISJ1_TAC THEN
        MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN ASM_REWRITE_TAC [] THEN
        ASM_ARITH_TAC]])

  pure { POLE_AT_INFINITY, PROPER_MAP_COMPLEX_POLYFUN, PROPER_MAP_COMPLEX_POLYFUN_UNIV,
         PROPER_MAP_COMPLEX_POLYFUN_EQ }
/- ------------------------------------------------------------------------- -/
/- Power and squaring functions as covering maps.                            -/
/- (cauchy.ml 14732-14829)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBK where
  COVERING_SPACE_POW_PUNCTURED_PLANE : thm
  COVERING_SPACE_SQUARE_PUNCTURED_PLANE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBK [HolBase] (D : CauchyDeps) (BKYBD : KYBD) (BKYBJ : KYBJ) : ExceptT String IO KYBK := do
  -- @@SCOPE BEGIN
  let { OPEN_MAPPING_THM, .. } := BKYBD
  let { PROPER_MAP_COMPLEX_POLYFUN, .. } := BKYBJ
  let { CONTINUOUS_LOGARITHM_ON_SIMPLY_CONNECTED, .. } := D.mop
  let { PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP, .. } := D.qpaths
  let { CONVEX_IMP_SIMPLY_CONNECTED, .. } := D.mt.qpaths
  let { CEXP_N, .. } := D.mt.ra.tsa
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { CEXP_EQ, .. } := D.mt.ra.tsf
  let { EXISTS_COMPLEX_ROOT, .. } := D.mt.ra.tsm
  let { CONTINUOUS_ON_COMPLEX_POW, .. } := D.mt.ra.ts.knc
  let { HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_POW, .. } := D.mt.ra.ts.knh
  let { COMPLEX_ADD_RID, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_SUB_LDISTRIB,
        COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_POW_EQ_0, COMPLEX_POW_ZERO,
        COMPLEX_VEC_0, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_EQ_MUL_LCANCEL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, COMPLEX_NORM_NZ, .. } := D.mt.ra.ts.cn.cxf
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, NORM_ARITH, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH, COND_RAND, COND_RATOR, CONTRAPOS_THM, EQ_IMP, EXTENSION,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_IMP, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_NUMSEG, IN_SING, IN_UNIV, LE_1, LE_REFL, REAL_ABS_MUL,
        REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL_EQ, REAL_LE_RMUL_EQ, REAL_LT_DIV, REAL_LT_MIN, REAL_LT_RDIV_EQ,
        REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO, REAL_MUL_SYM, REAL_NOT_LT,
        REAL_OF_NUM_EQ, REAL_OF_NUM_LT, RIGHT_IMP_FORALL_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { dist, VSUM_DELTA, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, CLOSED_SING, CLOSED_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_ON_ID, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_at, OPEN_IN_OPEN_EQ, OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { CONVEX_IMP_LOCALLY_PATH_CONNECTED, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { CONNECTED_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { OPEN_DIFF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let COVERING_SPACE_POW_PUNCTURED_PLANE ← prove
   r"!n. 0 < n
       ==> covering_space ((:complex) DIFF {Cx(&0)},(\z. z pow n))
                          ((:complex) DIFF {Cx (&0)})"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PROPER_LOCALLY_INJECTIVE_OPEN_IMP_COVERING_MAP THEN
    REWRITE_TAC [IN_DIFF, IN_SING] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_POW THEN REWRITE_TAC [CONTINUOUS_ON_ID],
      REWRITE_TAC [EXTENSION, IN_IMAGE, IN_DIFF, IN_UNIV, IN_SING] THEN
      ASM_MESON_TAC [COMPLEX_POW_EQ_0, EXISTS_COMPLEX_ROOT, LE_1],
      X_GEN_TAC (← q r"k:complex->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"(:complex)", ← q r"k:complex->bool",
                     ← q r"\i:num. if i = n then Cx(&1) else Cx(&0)", ← q r"n:num"]
          PROPER_MAP_COMPLEX_POLYFUN) THEN
      ASM_REWRITE_TAC [CLOSED_UNIV] THEN ANTS_TAC THENL
       [EXISTS_TAC (← q r"n:num") THEN ASM_SIMP_TAC [IN_NUMSEG, LE_1, LE_REFL] THEN
        CONV_TAC COMPLEX_RING,
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_UNIV] THEN
        REWRITE_TAC [COND_RAND, COND_RATOR, COMPLEX_MUL_LZERO] THEN
        SIMP_TAC [← GSYM COMPLEX_VEC_0, VSUM_DELTA, IN_NUMSEG, LE_0, LE_REFL] THEN
        REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_VEC_0] THEN
        X_GEN_TAC (← q r"z:complex") THEN
        MP_TAC (← ISPECL [← q r"z:complex", ← q r"n:num"] COMPLEX_POW_EQ_0) THEN
        ASM_SIMP_TAC [LE_1] THEN ASM SET_TAC []],
      SIMP_TAC [OPEN_IN_OPEN_EQ, OPEN_DIFF, OPEN_UNIV, CLOSED_SING] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_DIFF, IN_UNIV, IN_SING] THEN
      ASM_SIMP_TAC [COMPLEX_POW_EQ_0] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
          OPEN_MAPPING_THM) THEN
      EXISTS_TAC (← q r"(:complex)") THEN
      ASM_REWRITE_TAC [SUBSET_UNIV, CONNECTED_UNIV, OPEN_UNIV, IN_UNIV] THEN
      SIMP_TAC [HOLOMORPHIC_ON_POW, HOLOMORPHIC_ON_ID] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"~(f(Cx(&1)) = f(Cx(&0))) ==> ~(?c. !z. f z = c)")) THEN
      ASM_SIMP_TAC [COMPLEX_POW_ZERO, COMPLEX_POW_EQ_0, LE_1] THEN
      CONV_TAC COMPLEX_RING,
      X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [IN_UNIV] THEN DISCH_TAC THEN
      SIMP_TAC [OPEN_IN_OPEN_EQ, OPEN_DIFF, OPEN_UNIV, CLOSED_SING] THEN
      MP_TAC (← ISPECL [← q r"\w:complex. w", ← q r"ball(z:complex,norm z)"]
          CONTINUOUS_LOGARITHM_ON_SIMPLY_CONNECTED) THEN
      REWRITE_TAC [CONTINUOUS_ON_ID] THEN ANTS_TAC THENL
       [SIMP_TAC [CONVEX_IMP_LOCALLY_PATH_CONNECTED, CONVEX_BALL,
                 CONVEX_IMP_SIMPLY_CONNECTED] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        SIMP_TAC [← GSYM COMPLEX_VEC_0, IN_BALL] THEN CONV_TAC (fun t => NORM_ARITH t),
        SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_BALL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"l:complex->complex")
         (STRIP_ASSUME_TAC o GSYM))] THEN
      SUBGOAL_THEN (← q r"(l:complex->complex) continuous at z") MP_TAC THENL
       [ASM_SIMP_TAC [CENTRE_IN_BALL, COMPLEX_NORM_NZ], ALL_TAC] THEN
      REWRITE_TAC [continuous_at] THEN DISCH_THEN (MP_TAC o SPEC (← q r"pi / &n")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, PI_POS, REAL_OF_NUM_LT] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"ball(z:complex,min r (norm z))") THEN
      ASM_SIMP_TAC [OPEN_BALL, CENTRE_IN_BALL, COMPLEX_NORM_NZ, REAL_LT_MIN] THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DIFF {a} <=> ~(a IN s)")] THEN
      SIMP_TAC [IN_BALL, REAL_LT_MIN, dist, COMPLEX_SUB_RZERO, REAL_LT_REFL] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:complex", ← q r"y:complex"] THEN
      REWRITE_TAC [← GSYM dist] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
      SUBGOAL_THEN (← q r"x = cexp(l x) /\ y = cexp(l y)")
         (CONJUNCTS_THEN SUBST1_TAC)
      THENL [ASM_MESON_TAC [IN_BALL], REWRITE_TAC [← GSYM CEXP_N]] THEN
      GEN_REWRITE_TAC LAND_CONV [CEXP_EQ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") MP_TAC) THEN ASM_CASES_TAC (← q r"k = &0") THENL
       [ASM_REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_RZERO, COMPLEX_MUL_LZERO,
                        COMPLEX_ADD_RID, COMPLEX_EQ_MUL_LCANCEL, CX_INJ] THEN
        ASM_SIMP_TAC [REAL_OF_NUM_EQ, LE_1],
        STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q r"F ==> p"))] THEN
      SUBGOAL_THEN (← q r"norm(Cx(&n) * l(x:complex) - Cx(&n) * l y) < &2 * pi")
      MP_TAC THENL
       [REWRITE_TAC [← GSYM COMPLEX_SUB_LDISTRIB, COMPLEX_NORM_MUL] THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
        ASM_SIMP_TAC [← ONCE_REWRITE_RULE [REAL_MUL_SYM] (← GSYM REAL_LT_RDIV_EQ),
                     REAL_OF_NUM_LT] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"(&2 * x) / y = &2 * x / y")] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"!z. dist(x,z) < a /\ dist(y,z) < a ==> norm(x - y) < &2 * a")) THEN
        ASM_MESON_TAC [DIST_SYM],
        ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"(y + z) - y:complex = z"))] THEN
        REWRITE_TAC [REAL_NOT_LT, COMPLEX_NORM_MUL, COMPLEX_NORM_II] THEN
        REWRITE_TAC [COMPLEX_NORM_CX, REAL_MUL_RID, REAL_ABS_MUL] THEN
        REWRITE_TAC [REAL_ABS_NUM, REAL_ABS_PI] THEN
        ONCE_REWRITE_TAC [← REAL_ARITH (← q r"&2 * pi = &2 * &1 * pi")] THEN
        SIMP_TAC [REAL_LE_LMUL_EQ, REAL_LE_RMUL_EQ, PI_POS,
                 ← REAL_ARITH (← q r"&0 < &2")] THEN
        ASM_SIMP_TAC [REAL_ABS_INTEGER_LEMMA]]])

  let COVERING_SPACE_SQUARE_PUNCTURED_PLANE ← prove
   r"covering_space ((:complex) DIFF {Cx(&0)},(\z. z pow 2))
                  ((:complex) DIFF {Cx (&0)})"
   (SIMP_TAC [COVERING_SPACE_POW_PUNCTURED_PLANE, ARITH])

  pure { COVERING_SPACE_POW_PUNCTURED_PLANE, COVERING_SPACE_SQUARE_PUNCTURED_PLANE }
/- ------------------------------------------------------------------------- -/
/- Invertibility vs nonvanishing derivative; inverse function theorem;      -/
/- holomorphism of covering maps and lifts.                                  -/
/- (cauchy.ml 14830-15121)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBL where
  HAS_COMPLEX_DERIVATIVE_LOCALLY_INJECTIVE : thm
  HAS_COMPLEX_DERIVATIVE_LOCALLY_INVERTIBLE : thm
  HOLOMORPHIC_INJECTIVE_IMP_REGULAR : thm
  HOLOMORPHIC_ON_INVERSE : thm
  COVERING_SPACE_LIFT_IS_HOLOMORPHIC : thm
  COVERING_SPACE_LIFT_HOLOMORPHIC : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBL [HolBase] (D : CauchyDeps) (BKYAI : KYAI) (BKYAU : KYAU) (BKYBI : KYBI) : ExceptT String IO KYBL := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED, .. } := BKYAU
  let { HOLOMORPHIC_FACTOR_ORDER_OF_ZERO_STRONG, .. } := BKYBI
  let { HAS_DERIVATIVE_LOCALLY_INJECTIVE, .. } := D.qderivatives
  let { INT_ABS_MUL_1, INT_ABS_NEG, .. } := D.qsession
  let { covering_space, COVERING_SPACE_LIFT, INVARIANCE_OF_DOMAIN, .. } := D.mt.qpaths
  let { REAL_EXP_0, .. } := D.mt.ra.tsb
  let { NORM_CEXP, .. } := D.mt.ra.tsf
  let { COMPLEX_ROOT_UNITY, COMPLEX_ROOT_UNITY_EQ, .. } := D.mt.ra.tsy
  let { complex_differentiable, COMPLEX_DIFFERENTIABLE_AT_WITHIN, has_complex_derivative,
        HIGHER_COMPLEX_DERIVATIVE_1, holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_WITHIN,
        HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_CONST, HAS_COMPLEX_DERIVATIVE_ID,
        HAS_COMPLEX_DERIVATIVE_MUL_AT, HAS_COMPLEX_DERIVATIVE_SUB, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_COMPOSE_WITHIN, COMPLEX_DIFFERENTIABLE_TRANSFORM_WITHIN,
        .. } := D.mt.ra.ts.kng
  let { HAS_COMPLEX_DERIVATIVE_DERIVATIVE, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE,
        .. } := D.mt.ra.ts.knh
  let { HAS_COMPLEX_DERIVATIVE_INVERSE_STRONG, .. } := D.mt.ra.ts.knj
  let { INT_ABS_NUM, int_congruent, num_congruent, .. } := D.mt.ra.ts.qsession
  let { COMPLEX_ADD_LID, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_SUB_LZERO,
        COMPLEX_SUB_RDISTRIB, COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_POW_MUL, CX_INJ, IM_CX, RE_MUL_CX, RE_MUL_II,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_EQ_MUL_LCANCEL, COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { LINEAR_COMPLEX_MUL, .. } := D.mt.ra.ts.cn.cxh
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { AND_FORALL_THM, CONJ_ASSOC, EQ_SYM_EQ, EXTENSION, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_CONJ_ALT, INT_OF_NUM_EQ, INT_SUB_LZERO,
        INTER_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, LE_1, LEFT_EXISTS_AND_THM, MONO_EXISTS,
        NOT_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_RMUL, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_MIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_NEG_0, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { num_WOP, o_THM, SWAP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { LINEAR_INJECTIVE_LEFT_INVERSE, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_NEG, NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_OPEN_IN_PREIMAGE_GEN, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, OPEN_BALL, OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_on, homeomorphism, open_in, OPEN_IN_OPEN_EQ, OPEN_INTER,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { ONORM, .. } := D.mt.ra.ts.cn.ms.ig.dv.qvec
  let { SUBSET_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let HAS_COMPLEX_DERIVATIVE_LOCALLY_INJECTIVE ← prove
   r"!f s z.
        f holomorphic_on s /\ open s /\ z IN s /\
        ~(complex_derivative f z = Cx(&0))
        ==> ?t. z IN t /\
                open t /\
                (!x x'. x IN t /\ x' IN t /\ f x' = f x ==> x' = x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_DERIVATIVE_LOCALLY_INJECTIVE THEN
    EXISTS_TAC (← q r"\z h. complex_derivative f z * h") THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN EXISTS_TAC (← q r"s:complex->bool") THEN
    ASM_REWRITE_TAC [← GSYM has_complex_derivative] THEN
    REWRITE_TAC [CONJ_ASSOC, LEFT_EXISTS_AND_THM] THEN
    ASM_REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC LINEAR_INJECTIVE_LEFT_INVERSE THEN
      ASM_SIMP_TAC [LINEAR_COMPLEX_MUL, COMPLEX_EQ_MUL_LCANCEL],
      ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT],
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(complex_derivative f) continuous_on s") MP_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
        ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE],
        ALL_TAC] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [dist, REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_REWRITE_TAC [SUBSET, IN_BALL, ← ONCE_REWRITE_RULE [DIST_SYM] dist] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d r:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [← GSYM COMPLEX_SUB_RDISTRIB] THEN MATCH_MP_TAC
       (← CONJUNCT2 (← MATCH_MP ONORM (← SPEC_ALL LINEAR_COMPLEX_MUL))) THEN
      GEN_TAC THEN REWRITE_TAC [COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, NORM_POS_LE]])

  let HAS_COMPLEX_DERIVATIVE_LOCALLY_INVERTIBLE ← prove
   r"!f s z.
        f holomorphic_on s /\ open s /\ z IN s /\
        ~(complex_derivative f z = Cx(&0))
        ==> ?t g. z IN t /\ open t /\ open(IMAGE f t) /\ t SUBSET s /\
                  (!w. w IN t ==> g(f w) = w) /\
                  (!y. y IN (IMAGE f t) ==> f(g y) = y)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HAS_COMPLEX_DERIVATIVE_LOCALLY_INJECTIVE) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:complex->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [EQ_SYM_EQ] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"g:complex->complex")) THEN
    EXISTS_TAC (← q r"s INTER t:complex->bool") THEN
    EXISTS_TAC (← q r"g:complex->complex") THEN
    ASM_SIMP_TAC [OPEN_INTER, IN_INTER, INTER_SUBSET, FORALL_IN_IMAGE] THEN
    MATCH_MP_TAC INVARIANCE_OF_DOMAIN THEN
    ASM_SIMP_TAC [OPEN_INTER, IN_INTER] THEN
    ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                  HOLOMORPHIC_ON_SUBSET, INTER_SUBSET])

  let HOLOMORPHIC_INJECTIVE_IMP_REGULAR ← prove
   r"!f s.
        f holomorphic_on s /\ open s /\
        (!w z. w IN s /\ z IN s /\ f w = f z ==> w = z)
        ==> !z. z IN s ==> ~(complex_derivative f z = Cx(&0))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"!n. 0 < n ==> higher_complex_derivative n f z = Cx(&0)") THENL
     [MP_TAC (← ISPECL
       [← q r"f:complex->complex", ← q r"ball(z:complex,r)", ← q r"z:complex"]
       HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED) THEN
      ASM_SIMP_TAC [OPEN_BALL, CONNECTED_BALL, CENTRE_IN_BALL, NOT_IMP] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z + Cx(r / &2)")) THEN
      REWRITE_TAC [IN_BALL, ← NORM_ARITH (← q r"dist(z,z + r) = norm r")] THEN
      REWRITE_TAC [COMPLEX_NORM_CX, NOT_IMP] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, DISCH_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"z:complex", ← q r"z + Cx(r / &2)"]) THEN
      ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"z = z + a <=> a = Cx(&0)"))] THEN
      REWRITE_TAC [NOT_IMP, CX_INJ] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [IN_BALL, ← NORM_ARITH (← q r"dist(z,z + r) = norm r")] THEN
      REWRITE_TAC [COMPLEX_NORM_CX] THEN ASM_REAL_ARITH_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM])] THEN
    GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
    REWRITE_TAC [NOT_IMP, ← GSYM IMP_CONJ_ALT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool", ← q r"n:num", ← q r"z:complex"]
       HOLOMORPHIC_FACTOR_ORDER_OF_ZERO_STRONG) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"g:complex->complex", ← q r"k:real"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"n = 1") THENL
     [ASM_MESON_TAC [HIGHER_COMPLEX_DERIVATIVE_1], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"\w:complex. (w - z) * g(w)", ← q r"ball(z:complex,min r k)",
                  ← q r"z:complex"] HAS_COMPLEX_DERIVATIVE_LOCALLY_INVERTIBLE) THEN
    ASM_REWRITE_TAC [OPEN_BALL, CENTRE_IN_BALL, NOT_IMP, REAL_LT_MIN] THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN
       (← q r"!w. w IN ball(z,min r k)
            ==> ((\w. (w - z) * g w) has_complex_derivative
                 ((w - z) * complex_derivative g w + (Cx(&1) - Cx(&0)) * g w))
                (at w)")
      (LABEL_TAC "*")
      THENL
       [REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"w IN ball(z:complex,k)") ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET, SUBSET_BALL, ← REAL_ARITH (← q r"min r k <= k")],
          ALL_TAC] THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_MUL_AT THEN
        SIMP_TAC [HAS_COMPLEX_DERIVATIVE_ID, HAS_COMPLEX_DERIVATIVE_SUB,
         HAS_COMPLEX_DERIVATIVE_CONST, HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE] THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT, OPEN_BALL],
        SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REMOVE_THEN "*" (MP_TAC o SPEC (← q r"z:complex")) THEN
        ASM_REWRITE_TAC [CENTRE_IN_BALL, REAL_LT_MIN] THEN
        DISCH_THEN (SUBST1_TAC o  MATCH_MP HAS_COMPLEX_DERIVATIVE_DERIVATIVE) THEN
        REWRITE_TAC [COMPLEX_SUB_REFL, COMPLEX_MUL_LZERO, COMPLEX_ADD_LID,
                    COMPLEX_SUB_RZERO, COMPLEX_MUL_LID] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [CENTRE_IN_BALL]],
      REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:complex->bool", ← q r"h:complex->complex"] THEN
      ABBREV_TAC (← q r"u = IMAGE (\w:complex. (w - z) * g w) t") THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"u:complex->bool") OPEN_CONTAINS_CBALL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"Cx(&0)")) THEN
      ANTS_TAC THENL
       [EXPAND_TAC "u" THEN REWRITE_TAC [IN_IMAGE] THEN
        EXISTS_TAC (← q r"z:complex") THEN ASM_REWRITE_TAC [] THEN
        CONV_TAC COMPLEX_RING,
        ALL_TAC] THEN
      REWRITE_TAC [NOT_EXISTS_THM, SUBSET, IN_CBALL, dist,
                  COMPLEX_SUB_LZERO, NORM_NEG] THEN
      X_GEN_TAC (← q r"e:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (fun th => tactic_of do pure (
       MP_TAC (← ISPEC (← q r"Cx(e) * cexp(Cx(&2) * Cx pi * ii * Cx(&0 / &n))") th) THEN
       MP_TAC (← ISPEC (← q r"Cx(e) * cexp(Cx(&2) * Cx pi * ii * Cx(&1 / &n))") th))) THEN
      REWRITE_TAC [COMPLEX_NORM_MUL, NORM_CEXP, RE_MUL_CX, RE_MUL_II] THEN
      REWRITE_TAC [IM_CX, REAL_NEG_0, REAL_MUL_RZERO, REAL_EXP_0] THEN
      REWRITE_TAC [COMPLEX_NORM_CX, REAL_MUL_RID] THEN
      SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> abs e <= e"), ← ASSUME (← q r"&0 < e")] THEN
      EXPAND_TAC "u" THEN REWRITE_TAC [IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y1:complex") (STRIP_ASSUME_TAC o GSYM)) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y0:complex") (STRIP_ASSUME_TAC o GSYM)) THEN
      UNDISCH_THEN (← q r"!w. w IN ball (z,k) ==> f w - f z = ((w - z) * g w) pow n")
        (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"y1:complex") th) THEN
                   MP_TAC (← SPEC (← q r"y0:complex") th))) THEN
      MATCH_MP_TAC (← TAUT (← q r"(p1 /\ p2) /\ ~(q1 /\ q2)
                         ==> (p1 ==> q1) ==> (p2 ==> q2) ==> F")) THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [SUBSET, SUBSET_BALL, ← REAL_ARITH (← q r"min r k <= k")],
        MATCH_MP_TAC (← MESON [] (← q r"x' = y' /\ ~(x = y) ==> ~(x = x' /\ y = y')"))] THEN
      CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [INJECTIVE_ON_LEFT_INVERSE]) THEN
        ASM_SIMP_TAC [] THEN REWRITE_TAC [COMPLEX_POW_MUL] THEN
        ASM_SIMP_TAC [COMPLEX_ROOT_UNITY, LE_1],
        REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"x - a:complex = y - a <=> x = y"))] THEN
        DISCH_TAC THEN UNDISCH_THEN
         (← q r"!w z. w IN s /\ z IN s /\ (f:complex->complex) w = f z ==> w = z")
         (MP_TAC o SPECL [← q r"y0:complex", ← q r"y1:complex"]) THEN
        ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [SUBSET, SUBSET_BALL, ← REAL_ARITH (← q r"min r k <= r")],
          DISCH_THEN SUBST_ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"n:num", ← q r"0", ← q r"1"] COMPLEX_ROOT_UNITY_EQ) THEN
        ASM_SIMP_TAC [LE_1] THEN MATCH_MP_TAC (← TAUT (← q r"a /\ ~b ==> ~(a <=> b)")) THEN
        CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ExceptT.mk (COMPLEX_RING
           (← q r"z = e * y ==> z = e * x /\ ~(e = Cx(&0)) ==> x = y")))) THEN
          ASM_SIMP_TAC [CX_INJ, REAL_LT_IMP_NZ],
          REWRITE_TAC [num_congruent, int_congruent] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"d:int")
           (MP_TAC o AP_TERM (← q r"abs:int->int") o SYM)) THEN
          REWRITE_TAC [INT_ABS_NUM, INT_SUB_LZERO, INT_ABS_NEG] THEN
          ASM_REWRITE_TAC [INT_ABS_MUL_1, INT_OF_NUM_EQ, INT_ABS_NUM]]]])

  /- Hence a nice clean inverse function theorem. -/

  let HOLOMORPHIC_ON_INVERSE ← prove
   r"!f s. f holomorphic_on s /\ open s /\
         (!w z. w IN s /\ z IN s /\ f w = f z ==> w = z)
         ==> open(IMAGE f s) /\
             ?g. g holomorphic_on (IMAGE f s) /\
                 (!z. z IN s
                      ==> complex_derivative f z * complex_derivative g (f z) =
                          Cx(&1)) /\
                 (!z. z IN s ==> g(f z) = z) /\
                 (!y. y IN (IMAGE f s) ==> f(g y) = y)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [MATCH_MP_TAC INVARIANCE_OF_DOMAIN THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON],
      DISCH_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INJECTIVE_ON_LEFT_INVERSE]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"z:complex") THEN
    ASM_CASES_TAC (← q r"(z:complex) IN s") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL
     [← q r"f:complex->complex", ← q r"g:complex->complex",
      ← q r"complex_derivative f z", ← q r"s:complex->bool",
      ← q r"z:complex"] HAS_COMPLEX_DERIVATIVE_INVERSE_STRONG) THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, IMP_CONJ] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE, HOLOMORPHIC_ON_OPEN,
                          complex_differentiable],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"s:complex->bool"]
          HOLOMORPHIC_INJECTIVE_IMP_REGULAR) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], DISCH_THEN (MP_TAC o SPEC (← q r"z:complex"))] THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(z = Cx(&0)) ==> (z * w = Cx(&1) <=> w = inv z)"))] THEN
    MESON_TAC [HAS_COMPLEX_DERIVATIVE_DERIVATIVE])

  /- Holomorphism of covering maps and lifts. -/

  let COVERING_SPACE_LIFT_IS_HOLOMORPHIC ← prove
   r"!p c s f g u.
        covering_space (c,p) s /\ open c /\ p holomorphic_on c /\
        f holomorphic_on u /\ IMAGE f u SUBSET s /\ IMAGE g u SUBSET c /\
        g continuous_on u /\ (!x. x IN u ==> p(g x) = f x)
        ==> g holomorphic_on u"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [holomorphic_on, ← GSYM complex_differentiable] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(f:complex->complex) z") o lastc o
                GEN_REWRITE_RULE id [covering_space]) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [OPEN_IN_OPEN_EQ]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:complex->bool") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"vv:(complex->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
    DISCH_THEN (fun th => tactic_of do pure (
      MP_TAC (← EQ_IMP_RULE (← SPEC (← q r"(g:complex->complex) z") th)).2)) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:complex->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"p:complex->complex", ← q r"v:complex->bool"]
          HOLOMORPHIC_ON_INVERSE) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism]) THEN ASM SET_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p':complex->complex") STRIP_ASSUME_TAC)] THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_TRANSFORM_WITHIN THEN
    EXISTS_TAC (← q r"(p':complex->complex) o (f:complex->complex)") THEN
    MP_TAC (← ISPECL
     [← q r"g:complex->complex", ← q r"u:complex->bool", ← q r"c:complex->bool",
      ← q r"v:complex->bool"] CONTINUOUS_OPEN_IN_PREIMAGE_GEN) THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_EQ] THEN REWRITE_TAC [open_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex") o CONJUNCT2) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [o_THM, IN_ELIM_THM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_COMPOSE_WITHIN THEN CONJ_TAC THENL
     [MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_WITHIN THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET],
      MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_AT_WITHIN THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT THEN
      EXISTS_TAC (← q r"IMAGE (p:complex->complex) v") THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let COVERING_SPACE_LIFT_HOLOMORPHIC ← prove
   r"!p c s f u.
        covering_space (c,p) s /\ p holomorphic_on c /\ open c /\
        simply_connected u /\ locally path_connected u /\
        f holomorphic_on u /\ IMAGE f u SUBSET s
        ==> ?g. g holomorphic_on u /\ IMAGE g u SUBSET c /\
                !y. y IN u ==> p(g y) = f y"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"p:complex->complex", ← q r"c:complex->bool", ← q r"s:complex->bool",
      ← q r"f:complex->complex", ← q r"u:complex->bool"] COVERING_SPACE_LIFT) THEN
      ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          COVERING_SPACE_LIFT_IS_HOLOMORPHIC)) THEN
    EXISTS_TAC (← q r"f:complex->complex") THEN ASM_REWRITE_TAC [])

  pure { HAS_COMPLEX_DERIVATIVE_LOCALLY_INJECTIVE, HAS_COMPLEX_DERIVATIVE_LOCALLY_INVERTIBLE,
         HOLOMORPHIC_INJECTIVE_IMP_REGULAR, HOLOMORPHIC_ON_INVERSE,
         COVERING_SPACE_LIFT_IS_HOLOMORPHIC, COVERING_SPACE_LIFT_HOLOMORPHIC }
/- ------------------------------------------------------------------------- -/
/- The Schwarz lemma and holomorphic subordination.                          -/
/- (cauchy.ml 15118-15401)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBM where
  SCHWARZ_LEMMA : thm
  HOLOMORPHIC_SUBORDINATION : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBM [HolBase] (D : CauchyDeps) (BKYAV : KYAV) (BKYBE : KYBE) (BKYBL : KYBL) : ExceptT String IO KYBM := do
  -- @@SCOPE BEGIN
  let { POLE_THEOREM_OPEN_0, .. } := BKYAV
  let { MAXIMUM_MODULUS_PRINCIPLE, .. } := BKYBE
  let { HOLOMORPHIC_ON_INVERSE, .. } := BKYBL
  let { FRONTIER_NOT_EMPTY, IMAGE_AFFINITY_BALL, .. } := D.qtopology
  let { CHOICE_DEF, REAL_LT_LINV, REAL_MAX_LT, REAL_NOT_EQ, .. } := D.qsession
  let { DIST_TRIANGLE, .. } := D.qvectors
  let { HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE, HOLOMORPHIC_ON_CONST,
        HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_RMUL, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { sphere, .. } := D.mt.ra.ts.qtopology
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RID, COMPLEX_ADD_SYM, COMPLEX_MUL_LZERO,
        COMPLEX_MUL_RZERO, COMPLEX_MUL_SYM, COMPLEX_SUB_0, COMPLEX_SUB_LZERO,
        COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_EQ_0, COMPLEX_NORM_0, COMPLEX_NORM_DIV, COMPLEX_NORM_MUL,
        COMPLEX_NORM_ZERO, .. } := D.mt.ra.ts.cn.cxf
  let { REAL_LT_BETWEEN, .. } := D.mt.ra.ts.cn.ms.qmisc
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_MUL_RINV_UNIQ, .. } := D.mt.ra.ts.cn.cx.cpx
