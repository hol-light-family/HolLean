          ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM],
          EXPAND_TAC "d" THEN
          REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART] THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_ON_EQ) THEN
          GEN_TAC THEN REWRITE_TAC [] THEN COND_CASES_TAC THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_TAC THEN REWRITE_TAC [complex_div] THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
           (← q r"x':complex = --x /\ y' = --y ==> x * y = x' * y'"))) THEN
          REWRITE_TAC [← GSYM COMPLEX_INV_NEG, COMPLEX_NEG_SUB]],
        ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_DELETE, IN_DELETE,
          ← SET_RULE (← q r"s DIFF {x} = s DELETE x"), ← GSYM complex_differentiable] THEN
        X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_TRANSFORM_AT THEN
        EXISTS_TAC (← q r"\w:complex. (f y - f w) / (y - w)") THEN
        EXISTS_TAC (← q r"dist(w:complex,y)") THEN ASM_SIMP_TAC [DIST_POS_LT] THEN
        (CONJ_TAC THENL [MESON_TAC [DIST_SYM, REAL_LT_REFL], ALL_TAC]) THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_DIV_AT THEN
        ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN CONJ_TAC THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_SUB THEN
        ASM_SIMP_TAC [ETA_AX, COMPLEX_DIFFERENTIABLE_CONST,
                     COMPLEX_DIFFERENTIABLE_ID] THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!w a b:complex. w IN u /\ segment[a,b] SUBSET u
                      ==> (\z. d z w) path_integrable_on (linepath(a,b))")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b:complex.
          segment[a,b] SUBSET u
          ==> (\w. path_integral (linepath(a,b)) (\z. d z w))
              continuous_on u")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"a:complex = b") THENL
       [ASM_SIMP_TAC [PATH_INTEGRAL_TRIVIAL, CONTINUOUS_ON_CONST], ALL_TAC] THEN
      REWRITE_TAC [continuous_on] THEN X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"ee:real") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [dist, ← GSYM PATH_INTEGRAL_SUB] THEN
      MP_TAC (← ISPEC (← q r"u:complex->bool") OPEN_CONTAINS_CBALL) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"w:complex")) THEN
      ASM_SIMP_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"dd:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"(\y. (d:complex->complex->complex) (fstcart y) (sndcart y))
        uniformly_continuous_on
        {pastecart z t | z IN segment[a,b] /\ t IN cball(w,dd)}")
      MP_TAC THENL
       [MATCH_MP_TAC COMPACT_UNIFORMLY_CONTINUOUS THEN
        ASM_SIMP_TAC [← REWRITE_RULE [PCROSS] COMPACT_PCROSS,
                     COMPACT_CBALL, COMPACT_SEGMENT] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_ELIM_PASTECART_THM] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"ee / &2 / norm(b - a:complex)")) THEN
      ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, COMPLEX_NORM_NZ, COMPLEX_SUB_0] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"kk:real")
        (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (MP_TAC o GENL [← q r"z:complex", ← q r"r:complex"] o
       SPECL [← q r"pastecart (r:complex) (z:complex)",
              ← q r"pastecart (r:complex) (w:complex)"]) THEN
      SIMP_TAC [IN_ELIM_PASTECART_THM, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      ASM_SIMP_TAC [CENTRE_IN_CBALL, REAL_LT_IMP_LE, dist, PASTECART_SUB] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, NORM_PASTECART] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← TAUT (← q r"(a /\ b) /\ a /\ c ==> d <=> a /\ b /\ c ==> d")] THEN
      SIMP_TAC [REAL_ADD_LID, POW_2_SQRT, NORM_POS_LE] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"min dd kk:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"x:complex") THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x <= e / &2 ==> x < e")) THEN
      ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"ee / &2 = ee / &2 / norm(b - a) * norm(b - a:complex)")
      SUBST1_TAC THENL
       [ASM_SIMP_TAC [REAL_DIV_RMUL, NORM_EQ_0, VECTOR_SUB_EQ], ALL_TAC] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
      EXISTS_TAC (← q r"\r. (d:complex->complex->complex) r x - d r w") THEN
      ASM_SIMP_TAC [REAL_LE_DIV, NORM_POS_LE, REAL_LT_IMP_LE, REAL_HALF] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
        MATCH_MP_TAC PATH_INTEGRABLE_SUB THEN ASM_SIMP_TAC [],
        REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [NORM_SUB] THEN
        MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_CBALL, dist] THEN
        ASM_MESON_TAC [NORM_SUB, REAL_LT_IMP_LE]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b. segment[a,b] SUBSET u
            ==> (\w. path_integral (linepath (a,b)) (\z. d z w))
                path_integrable_on g")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [PATH_INTEGRABLE_ON] THEN
      MATCH_MP_TAC INTEGRABLE_CONTINUOUS THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN CONJ_TAC THENL
       [SUBGOAL_THEN
         (← q r"((\w. path_integral (linepath(a,b)) (\z. d z w)) o (g:real^1->complex))
          continuous_on interval[vec 0,vec 1]")
        MP_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          ASM_SIMP_TAC [← GSYM path, VALID_PATH_IMP_PATH] THEN
          MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
          EXISTS_TAC (← q r"u:complex->bool") THEN ASM_SIMP_TAC [← GSYM path_image],
          REWRITE_TAC [o_DEF]],
        FIRST_ASSUM (fun th => tactic_of do pure (REWRITE_TAC
         [← MATCH_MP VECTOR_DERIVATIVE_AT (← SPEC_ALL th)])) THEN
        ASM_SIMP_TAC [ETA_AX, ← GSYM path, VALID_PATH_IMP_PATH,
                     VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b. segment[a,b] SUBSET u
            ==> path_integral (linepath(a,b)) h =
                path_integral g (\w. path_integral (linepath (a,b)) (\z. d z w))")
    ASSUME_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"] THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"segment[a:complex,b] SUBSET u /\
        segment[b,c] SUBSET u /\ segment[c,a] SUBSET u")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [SEGMENTS_SUBSET_CONVEX_HULL, SUBSET_TRANS], ALL_TAC] THEN
      ASM_SIMP_TAC [] THEN
      ASM_SIMP_TAC [← GSYM PATH_INTEGRAL_ADD, PATH_INTEGRABLE_ADD] THEN
      MATCH_MP_TAC PATH_INTEGRAL_EQ_0 THEN
      X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(w:complex) IN u") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [← GSYM PATH_INTEGRAL_JOIN, VALID_PATH_LINEPATH,
       VALID_PATH_JOIN, PATHSTART_JOIN,
       PATH_INTEGRABLE_JOIN, PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
      MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN EXISTS_TAC (← q r"u:complex->bool") THEN
      ASM_SIMP_TAC [] THEN ASM SET_TAC []] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:complex", ← q r"b:complex"] THEN DISCH_TAC THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"path_integral (linepath(a,b)) (\z. path_integral g (d z))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC PATH_INTEGRAL_EQ THEN
      REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN
      REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_MESON_TAC [SUBSET],
      MATCH_MP_TAC (← REWRITE_RULE [PCROSS] PATH_INTEGRAL_SWAP) THEN
      REWRITE_TAC [VALID_PATH_LINEPATH, VECTOR_DERIVATIVE_LINEPATH_AT,
                  CONTINUOUS_ON_CONST] THEN
      FIRST_ASSUM (fun th => tactic_of do pure (REWRITE_TAC
       [← MATCH_MP VECTOR_DERIVATIVE_AT (← SPEC_ALL th)])) THEN
      ASM_SIMP_TAC [ETA_AX, CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION,
                   CONTINUOUS_AT_IMP_CONTINUOUS_ON] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_ELIM_PASTECART_THM] THEN
      REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN ASM SET_TAC []])
  pure { CAUCHY_INTEGRAL_FORMULA_GLOBAL }

/- ------------------------------------------------------------------------- -/
/- Global Cauchy theorem, basic residue integrals, first Cartan lemmas.      -/
/- (cauchy.ml 11418-11830)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBA where
  CAUCHY_THEOREM_GLOBAL : thm
  CAUCHY_THEOREM_GLOBAL_OUTSIDE : thm
  HAS_RESIDUE_INTEGRAL : thm
  HAS_RESIDUE_INTEGRAL_INTEGER : thm
  HIGHER_COMPLEX_DERIVATIVE_COMP_LEMMA : thm
  HIGHER_COMPLEX_DERIVATIVE_COMP_ITER_LEMMA : thm
  HIGHER_COMPLEX_DERIVATIVE_ITER_TOP_LEMMA : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBA [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYF : KYF) (BKYG : KYG) (BKYQ : KYQ) (BKYS : KYS) (BKYAI : KYAI) (BKYAJ : KYAJ) (BKYAZ : KYAZ) : ExceptT String IO KYBA := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { CAUCHY_THEOREM_PRIMITIVE, .. } := BKYF
  let { HAS_PATH_INTEGRAL_EQ, .. } := BKYG
  let { COMPLEX_INTEGER, .. } := BKYQ
  let { WINDING_NUMBER_ZERO_IN_OUTSIDE, .. } := BKYS
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { higher_complex_derivative_alt, HIGHER_COMPLEX_DERIVATIVE_CONST,
        HIGHER_COMPLEX_DERIVATIVE_ID, HIGHER_COMPLEX_DERIVATIVE_MUL,
        HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN, .. } := BKYAJ
  let { CAUCHY_INTEGRAL_FORMULA_GLOBAL, .. } := BKYAZ
  let { CLOPEN, .. } := D.qtopology
  let { ADD_0, ADD_SUC, ONE, SUB, .. } := D.qsession
  let { ITER, ITER_ALT_POINTLESS, ITER_POINTLESS, .. } := D.qiter
  let { OUTSIDE_NO_OVERLAP, .. } := D.mt.qpaths
  let { CPOW_N, CPOW_NEG, .. } := D.mt.ra.tso
  let { binom, BINOM_REFL, .. } := D.mt.ra.qbinomial
  let { higher_complex_derivative, HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_ID, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DERIVATIVE_CHAIN, COMPLEX_DERIVATIVE_ID, HOLOMORPHIC_ON_COMPOSE_GEN,
        HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { is_int, .. } := D.mt.ra.ts.qsession
  let { complex_div, complex_pow, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_RID, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_MUL_RID,
        COMPLEX_MUL_RZERO, COMPLEX_SUB_0, COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_POW_1, COMPLEX_VEC_0, CX_ADD, CX_INJ, CX_NEG, CX_SUB,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_POLY_CLAUSES, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, COMPLEX_POW_INV, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_POW, COMPLEX_INV_EQ_0, .. } := D.mt.ra.ts.cn.cxf
  let { IN_NUMSEG_0, LE_SUC_LT, .. } := D.mt.ra.ts.cn.ms.qsession
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH,
        SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH_EQ, DE_MORGAN_THM, EMPTY_SUBSET, EQ_TRANS, ETA_AX, FINITE_RULES,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IMP_IMP, IN_DELETE, INSERT_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, IN_SING, IN_UNIV, LE_1, LE_REFL, LEFT_EXISTS_AND_THM, LT_REFL,
        NOT_IN_EMPTY, NUMSEG_SING, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_NEG2, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_SUB, RIGHT_FORALL_IMP_THM,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, SWAP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { VSUM_CLAUSES, VSUM_SING, VSUM_SUPERSET, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { COMPACT_EQ_BOUNDED_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { NOT_BOUNDED_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { COMPACT_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { PATH_IMAGE_NONEMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { ADD_SUB, I_DEF, LT, LT_SUC_LE, SUBSET_NUMSEG,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  -- @@SCOPE END

  -- ASSERT_TAC (misc.ml 16), local: CauchyDeps carries no MiscDeps.
  let ASSERT_TAC : term → tactic := fun tm => SUBGOAL_THEN tm STRIP_ASSUME_TAC


  -- EQ_TRANS_TAC (misc.ml 19), local: CauchyDeps carries no MiscDeps.
  let EQ_TRANS_TAC : term → tactic := fun tm =>
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC tm THEN CONJ_TAC


  let CAUCHY_THEOREM_GLOBAL ← prove
   r"!f s g.
        open s /\ f holomorphic_on s /\
        valid_path g /\ pathfinish g = pathstart g /\ path_image g SUBSET s /\
        (!z. ~(z IN s) ==> winding_number(g,z) = Cx(&0))
        ==> (f has_path_integral Cx(&0)) g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?z:complex. z IN s /\ ~(z IN path_image g)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET s /\ ~(t = s) ==> ?z. z IN s /\ ~(z IN t)")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← MESON
       [CLOPEN, COMPACT_EQ_BOUNDED_CLOSED, NOT_BOUNDED_UNIV]
       (← q r"open s /\ compact t /\ ~(t = {}) ==> ~(t = s)")) THEN
      ASM_SIMP_TAC [COMPACT_PATH_IMAGE, PATH_IMAGE_NONEMPTY, VALID_PATH_IMP_PATH],
      MP_TAC (← ISPECL [← q r"\w:complex. (w - z) * f(w)", ← q r"s:complex->bool",
                     ← q r"g:real^1->complex", ← q r"z:complex"]
        CAUCHY_INTEGRAL_FORMULA_GLOBAL) THEN
      ASM_SIMP_TAC [COMPLEX_SUB_REFL, COMPLEX_MUL_LZERO, COMPLEX_MUL_RZERO,
                   HOLOMORPHIC_ON_MUL, HOLOMORPHIC_ON_SUB,
                   HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_PATH_INTEGRAL_EQ) THEN
      X_GEN_TAC (← q r"w:complex") THEN ASM_CASES_TAC (← q r"w:complex = z") THEN
      ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(w:complex = z) ==> ((w - z) * f) / (w - z) = f"))]])

  let CAUCHY_THEOREM_GLOBAL_OUTSIDE ← prove
   r"!f s g.
        open s /\ f holomorphic_on s /\
        valid_path g /\ pathfinish g = pathstart g /\
        (!z. ~(z IN s) ==> z IN outside(path_image g))
        ==> (f has_path_integral Cx(&0)) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_GLOBAL THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN
    ASM_SIMP_TAC [WINDING_NUMBER_ZERO_IN_OUTSIDE, VALID_PATH_IMP_PATH] THEN
    MP_TAC (← ISPEC (← q r"path_image(g:real^1->complex)") OUTSIDE_NO_OVERLAP) THEN
    ASM SET_TAC [])

  /- Basic residue integrals. -/

  let HAS_RESIDUE_INTEGRAL ← prove
   r"!g z n. valid_path g /\ ~(z IN path_image g) /\ pathfinish g = pathstart g
           ==> ((\w. inv(w - z) pow n) has_path_integral
                (if n = 1 then Cx(&2) * Cx pi * ii * winding_number(g,z)
                 else Cx(&0))) g"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
     [MP_TAC (← ISPECL
       [← q r"\w:complex. Cx(&1)", ← q r"(:complex)", ← q r"g:real^1->complex", ← q r"z:complex"]
       CAUCHY_INTEGRAL_FORMULA_GLOBAL) THEN
      ASM_REWRITE_TAC [COMPLEX_MUL_LID, complex_div, IN_UNIV, OPEN_UNIV] THEN
      REWRITE_TAC [COMPLEX_POW_1, COMPLEX_MUL_RID] THEN
      DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [HOLOMORPHIC_ON_CONST] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CAUCHY_THEOREM_PRIMITIVE THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      EXISTS_TAC (← q r"(:complex) DELETE z") THEN
      ASM_REWRITE_TAC [IN_UNIV, IN_DELETE, LEFT_EXISTS_AND_THM] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN ASM_CASES_TAC (← q r"n = 0") THENL
       [EXISTS_TAC (← q r"\w:complex. w"),
        EXISTS_TAC (← q r"\w. --inv(Cx(&(n - 1))) * inv(w - z) pow (n - 1)")] THEN
      X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [complex_pow, HAS_COMPLEX_DERIVATIVE_ID] THEN
      COMPLEX_DIFF_TAC THEN
      ASM_SIMP_TAC [COMPLEX_SUB_0, ← GSYM REAL_OF_NUM_SUB, LE_1, CX_SUB] THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(n = 0) /\ ~(n = 1) ==> n - 1 - 1 = n - 2"),
                   ← ARITH_RULE (← q r"2 <= n <=> ~(n = 0) /\ ~(n = 1)"), ARITH_EQ,
                   COMPLEX_DIV_POW, COMPLEX_SUB_0, COMPLEX_INV_EQ_0] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(n1 = Cx(&0)) /\ ~(wz = Cx(&0))
        ==> --inv n1 * n1 * ip / inv wz pow 2 * --(Cx(&1) - Cx(&0)) / wz pow 2 =
          ip"))) THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_0, CX_INJ, REAL_OF_NUM_EQ]])

  let HAS_RESIDUE_INTEGRAL_INTEGER ← prove
   r"!g z n. valid_path g /\ ~(z IN path_image g) /\
           pathfinish g = pathstart g /\ complex_integer n
           ==> ((\w. (w - z) cpow n) has_path_integral
                (if n = --Cx(&1) then Cx(&2) * Cx pi * ii * winding_number(g,z)
                 else Cx(&0))) g"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPLEX_INTEGER]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:real") STRIP_ASSUME_TAC) THEN
    UNDISCH_THEN (← q r"n = Cx m") SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [is_int]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") (DISJ_CASES_THEN SUBST_ALL_TAC)) THEN
    ASM_REWRITE_TAC [CX_INJ, ← GSYM CX_NEG, CPOW_NEG] THENL
     [REWRITE_TAC [← REAL_ARITH (← q r"~(&n = -- &1)")] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_EQ THEN
      EXISTS_TAC (← q r"\w:complex. (w - z) pow n") THEN
      REWRITE_TAC [CPOW_N, COMPLEX_SUB_0] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CAUCHY_THEOREM_PRIMITIVE THEN
      EXISTS_TAC (← q r"\w. inv(Cx(&(n + 1))) * (w - z) pow (n + 1)") THEN
      EXISTS_TAC (← q r"(:complex)") THEN ASM_REWRITE_TAC [SUBSET_UNIV, IN_UNIV] THEN
      X_GEN_TAC (← q r"w:complex") THEN COMPLEX_DIFF_TAC THEN
      REWRITE_TAC [COMPLEX_SUB_RZERO, COMPLEX_MUL_RID, ADD_SUB] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD (← q r"~(n = Cx(&0)) ==> inv n * n * w = w"))) THEN
      REWRITE_TAC [CX_INJ, REAL_OF_NUM_EQ] THEN ARITH_TAC,
      REWRITE_TAC [REAL_EQ_NEG2, REAL_OF_NUM_EQ, CX_NEG, CPOW_NEG] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_EQ THEN
      EXISTS_TAC (← q r"\w:complex. inv(w - z) pow n") THEN
      ASM_SIMP_TAC [HAS_RESIDUE_INTEGRAL, CPOW_N, COMPLEX_SUB_0] THEN
      ASM_MESON_TAC [COMPLEX_POW_INV]])

  /- First Cartan Theorem. -/

  let HIGHER_COMPLEX_DERIVATIVE_COMP_LEMMA ← prove
   r"!f g z s t n i.
     open s /\ f holomorphic_on s /\ z IN s /\
     open t /\ g holomorphic_on t /\ (!w. w IN s ==> f w IN t) /\
     complex_derivative f z = Cx(&1) /\
     (!i. 1 < i /\ i <= n ==> higher_complex_derivative i f z = Cx(&0)) /\
     i <= n
     ==> higher_complex_derivative i (g o f) z =
         higher_complex_derivative i g (f z)"
   (REPEAT GEN_TAC  THEN
    SUBGOAL_THEN
     (← q r"open s /\ f holomorphic_on s /\ z IN s /\ open t /\
        (!w. w IN s ==> f w IN t) /\
        complex_derivative f z = Cx(&1) /\
        (!i. 1 < i /\ i <= n ==> higher_complex_derivative i f z = Cx(&0))
        ==> !i g. g holomorphic_on t /\ i <= n
            ==> higher_complex_derivative i (g o f) z =
                higher_complex_derivative i g (f z)")
      (fun th => MESON_TAC [th])  THEN
    STRIP_TAC  THEN
    INDUCT_TAC THEN
    REWRITE_TAC [LE_SUC_LT, higher_complex_derivative_alt, o_THM]  THEN
    REPEAT STRIP_TAC  THEN
    EQ_TRANS_TAC (← q r"higher_complex_derivative i
               (\w. complex_derivative g (f w) * complex_derivative f w) z") THENL
     [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN  THEN
      EXISTS_TAC (← q r"s:complex->bool")  THEN
      ASM_REWRITE_TAC []  THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
        ASM_REWRITE_TAC []  THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
        EXISTS_TAC (← q r"t:complex->bool")  THEN
        ASM_SIMP_TAC [],
        MATCH_MP_TAC HOLOMORPHIC_ON_MUL  THEN
        CONJ_TAC THENL
         [REWRITE_TAC [← GSYM o_DEF]  THEN
          MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
          EXISTS_TAC (← q r"t:complex->bool")  THEN
          ASM_REWRITE_TAC []  THEN
          MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
          ASM_REWRITE_TAC [],
          ASM_REWRITE_TAC [ETA_AX]  THEN
          MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
          ASM_REWRITE_TAC []],
        REPEAT STRIP_TAC  THEN
        MATCH_MP_TAC COMPLEX_DERIVATIVE_CHAIN  THEN
        ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT]],
      EQ_TRANS_TAC
       (← q r"vsum (0..i)
          (\j. Cx(&(binom (i,j))) *
               higher_complex_derivative j (\w. complex_derivative g (f w)) z *
               higher_complex_derivative (i - j) (complex_derivative f) z)") THENL
       [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_MUL  THEN
        EXISTS_TAC (← q r"s:complex->bool")  THEN
        ASM_REWRITE_TAC []  THEN
        ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE]  THEN
        REWRITE_TAC [← GSYM o_DEF]  THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
        EXISTS_TAC (← q r"t:complex->bool")  THEN
        ASM_REWRITE_TAC []  THEN
        ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE],
        REWRITE_TAC [← GSYM higher_complex_derivative_alt]  THEN
        EQ_TRANS_TAC
          (← q r"vsum (i..i)
             (\j. Cx(&(binom (i,j))) *
                  higher_complex_derivative j
                    (\w. complex_derivative g (f w)) z *
                  higher_complex_derivative (SUC (i - j)) f z)") THENL
         [MATCH_MP_TAC VSUM_SUPERSET  THEN
          REWRITE_TAC [SUBSET_NUMSEG, LT_REFL, LE_0,
                      LE_REFL, IN_NUMSEG_0, NUMSEG_SING, IN_SING]  THEN
          X_GEN_TAC (← q r"j:num")  THEN
          REWRITE_TAC [← ARITH_RULE (← q r"j:num <= i /\ ~(j = i) <=> j < i")]  THEN
          DISCH_TAC  THEN
          ASSERT_TAC (← q r"1 < SUC (i - j) /\ SUC (i - j) <= n")  THENL
           [ASM_SIMP_TAC [← ARITH_RULE
             (← q r"i < n /\ j < i ==> 1 < SUC (i - j) /\ SUC (i - j) <= n")]  THEN
            MATCH_MP_TAC (← ARITH_RULE (← q r"i < n /\ j < i ==> 1 < SUC (i - j)"))  THEN
            ASM_REWRITE_TAC [],
            ASM_SIMP_TAC [COMPLEX_MUL_RZERO, COMPLEX_VEC_0]],
          REWRITE_TAC [NUMSEG_SING, VSUM_SING, BINOM_REFL, SUB_REFL]  THEN
          ASM_REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_MUL_RID,
                           higher_complex_derivative]  THEN
          ASM_REWRITE_TAC [← GSYM o_DEF]  THEN
          REWRITE_TAC [← GSYM higher_complex_derivative,
                       higher_complex_derivative_alt]  THEN
          FIRST_X_ASSUM MATCH_MP_TAC  THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"i:num < n ==> i <= n")]  THEN
          MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
          ASM_REWRITE_TAC []]]])

  let HIGHER_COMPLEX_DERIVATIVE_COMP_ITER_LEMMA ← prove
   r"!f s z n m i.
     open s /\ f holomorphic_on s /\ (!w. w IN s ==> f w IN s) /\
     z IN s /\ f z = z /\ complex_derivative f z = Cx(&1) /\
     (!i. 1 < i /\ i <= n ==> higher_complex_derivative i f z = Cx(&0)) /\
     i <= n
     ==> higher_complex_derivative i (ITER m f) z =
         higher_complex_derivative i f z"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN GEN_TAC  THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ]  THEN
    REWRITE_TAC [IMP_IMP]  THEN
    STRIP_TAC  THEN
    ASSERT_TAC (← q r"!m. ITER m f z = z:complex")  THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [ITER], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m (w:complex). w IN s ==> ITER m f w IN s")  THENL
     [INDUCT_TAC THEN ASM_SIMP_TAC [ITER], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m. ITER m f holomorphic_on s")  THENL
     [INDUCT_TAC THEN REWRITE_TAC [ITER_POINTLESS] THENL
       [ASM_SIMP_TAC [I_DEF, HOLOMORPHIC_ON_ID],
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
        EXISTS_TAC (← q r"s:complex ->bool")  THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    INDUCT_TAC  THENL
     [REWRITE_TAC [ITER_POINTLESS, I_DEF, HIGHER_COMPLEX_DERIVATIVE_ID]  THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
       [ASM_REWRITE_TAC [higher_complex_derivative], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
       [ASM_REWRITE_TAC [higher_complex_derivative, ONE], ALL_TAC] THEN
      MATCH_MP_TAC HolLight.HolBase.T.EQ_SYM  THEN
      FIRST_X_ASSUM MATCH_MP_TAC  THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"~(i = 0) /\ ~(i = 1) ==> 1 < i")],
      GEN_TAC THEN DISCH_TAC  THEN
      REWRITE_TAC [ITER_ALT_POINTLESS]  THEN
      EQ_TRANS_TAC (← q r"higher_complex_derivative i (ITER m f) (f z)")  THENL
       [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_COMP_LEMMA  THEN
        EXISTS_TAC (← q r"s:complex ->bool")  THEN
        EXISTS_TAC (← q r"s:complex ->bool")  THEN
        EXISTS_TAC (← q r"n:num")  THEN
        ASM_REWRITE_TAC [],
        ASM_REWRITE_TAC []  THEN
        FIRST_X_ASSUM MATCH_MP_TAC  THEN
        ASM_REWRITE_TAC []]])

  let HIGHER_COMPLEX_DERIVATIVE_ITER_TOP_LEMMA ← prove
   r"!f s z n m.
     open s /\ f holomorphic_on s /\ (!w. w IN s ==> f w IN s) /\
     z IN s /\ f z = z /\ complex_derivative f z = Cx(&1) /\
     (!i. 1 < i /\ i < n ==> higher_complex_derivative i f z = Cx(&0)) /\
     1 < n
     ==> higher_complex_derivative n (ITER m f) z =
         Cx(&m) * higher_complex_derivative n f z"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC  THEN
    INDUCT_TAC THEN REWRITE_TAC [LT_SUC_LE] THEN REWRITE_TAC [LT]  THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM]  THEN
    STRIP_TAC  THEN
    ASSERT_TAC (← q r"!m. ITER m f z = z:complex")  THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [ITER], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m (w:complex). w IN s ==> ITER m f w IN s")  THENL
     [INDUCT_TAC THEN ASM_SIMP_TAC [ITER], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m. ITER m f holomorphic_on s")  THENL
     [INDUCT_TAC THEN REWRITE_TAC [ITER_POINTLESS]  THEN
      ASM_SIMP_TAC [I_DEF, HOLOMORPHIC_ON_ID]  THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
      EXISTS_TAC (← q r"s:complex ->bool")  THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASSERT_TAC (← q r"!w. w IN s ==> f complex_differentiable at w")  THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m w. w IN s ==> ITER m f complex_differentiable at w")  THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT], ALL_TAC] THEN
    ASSERT_TAC (← q r"!m. complex_derivative (ITER m f) z = Cx(&1)")  THENL
     [INDUCT_TAC THEN ASM_REWRITE_TAC [ITER_POINTLESS]  THENL
       [REWRITE_TAC [I_DEF, COMPLEX_DERIVATIVE_ID], ALL_TAC] THEN
      ASM_SIMP_TAC [COMPLEX_DERIVATIVE_CHAIN,
                    HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT]  THEN
      REWRITE_TAC [COMPLEX_MUL_LID],
      ALL_TAC] THEN
    INDUCT_TAC THEN
    REWRITE_TAC [higher_complex_derivative_alt, ITER_POINTLESS]  THENL
     [ASM_REWRITE_TAC [COMPLEX_MUL_LZERO, I_DEF, COMPLEX_DERIVATIVE_ID,
                       HIGHER_COMPLEX_DERIVATIVE_CONST,
                       ← ARITH_RULE (← q r"n = 0 <=> ~(1 <= n)")],
      ALL_TAC] THEN
    EQ_TRANS_TAC (← q r"higher_complex_derivative n
               (\w. complex_derivative f (ITER m f w) *
                    complex_derivative (ITER m f) w) z")  THENL
     [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN  THEN
      EXISTS_TAC (← q r"s:complex->bool")  THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC  THENL
       [REWRITE_TAC [o_DEF]  THEN
        MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
        ASM_REWRITE_TAC []  THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF]  THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
        EXISTS_TAC (← q r"s:complex->bool")  THEN
        ASM_REWRITE_TAC [ETA_AX],
        ALL_TAC] THEN
      CONJ_TAC  THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_MUL  THEN CONJ_TAC  THENL
         [ONCE_REWRITE_TAC [← GSYM o_DEF]  THEN
          MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
          EXISTS_TAC (← q r"s:complex->bool")  THEN
          ASM_REWRITE_TAC [ETA_AX]  THEN
          MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
          ASM_REWRITE_TAC [],
          ONCE_REWRITE_TAC [← GSYM o_DEF]  THEN
          MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
          EXISTS_TAC (← q r"s:complex->bool")  THEN
          ASM_REWRITE_TAC [HOLOMORPHIC_ON_ID]  THEN
          MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
          ASM_REWRITE_TAC []],
        GEN_TAC THEN DISCH_TAC  THEN
        MATCH_MP_TAC COMPLEX_DERIVATIVE_CHAIN  THEN
        CONJ_TAC  THENL
         [MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT  THEN
          ASM_MESON_TAC [],
          MATCH_MP_TAC HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT  THEN
          ASM_MESON_TAC []]],
      ALL_TAC] THEN
    EQ_TRANS_TAC
     (← q r"vsum (0..n)
        (\i. Cx(&(binom (n,i))) *
             higher_complex_derivative i
               (\w. complex_derivative f (ITER m f w)) z *
             higher_complex_derivative (n - i)
               (complex_derivative (ITER m f)) z)")  THENL
     [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_MUL  THEN
      EXISTS_TAC (← q r"s:complex->bool")  THEN
      ASM_REWRITE_TAC []  THEN CONJ_TAC  THENL
       [ONCE_REWRITE_TAC [← GSYM o_DEF]  THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE_GEN  THEN
        EXISTS_TAC (← q r"s:complex->bool")  THEN
        ASM_REWRITE_TAC [ETA_AX]  THEN
        MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC HOLOMORPHIC_COMPLEX_DERIVATIVE  THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    EQ_TRANS_TAC
     (← q r"vsum {0,n}
        (\i. Cx(&(binom (n,i))) *
             higher_complex_derivative i
               (\w. complex_derivative f (ITER m f w)) z *
             higher_complex_derivative (n - i)
               (complex_derivative (ITER m f)) z)")  THENL
     [MATCH_MP_TAC VSUM_SUPERSET  THEN
      REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, IN_NUMSEG_0, LE_0, LE_REFL,
                   IN_INSERT, NOT_IN_EMPTY, DE_MORGAN_THM]  THEN
      X_GEN_TAC (← q r"i:num")  THEN
      STRIP_TAC  THEN
      REWRITE_TAC [← GSYM higher_complex_derivative_alt]  THEN
      ASSERT_TAC (← q r"1 < SUC (n-i) /\ SUC (n-i) <= n")  THENL
       [ASM_SIMP_TAC [← ARITH_RULE (← q r"i <= n /\ ~(i=0) /\ ~(i=n)
                                  ==> 1 < SUC (n-i) /\ SUC (n-i) <= n")],
        ALL_TAC] THEN
      ASM_SIMP_TAC []  THEN
      SUBGOAL_THEN
        (← q r"higher_complex_derivative (SUC (n - i)) (ITER m f) z = Cx(&0)")
        SUBST1_TAC  THENL
       [EQ_TRANS_TAC (← q r"higher_complex_derivative (SUC (n - i)) f z")  THENL
         [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_COMP_ITER_LEMMA  THEN
          EXISTS_TAC (← q r"s:complex->bool")  THEN
          ASM_REWRITE_TAC []  THEN
          EXISTS_TAC (← q r"n:num")  THEN
          ASM_REWRITE_TAC [],
          FIRST_X_ASSUM MATCH_MP_TAC  THEN
          ASM_REWRITE_TAC []],
        ASM_REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_VEC_0]],
      ALL_TAC] THEN
    SIMP_TAC [VSUM_CLAUSES, FINITE_RULES, IN_INSERT, NOT_IN_EMPTY]  THEN
    REWRITE_TAC [binom, BINOM_REFL, COMPLEX_MUL_LID,
                 SUB_REFL, SUB, higher_complex_derivative]  THEN
    ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC []  THENL
     [REWRITE_TAC [higher_complex_derivative]  THEN
      POP_ASSUM SUBST_ALL_TAC  THEN
      RULE_ASSUM_TAC (REWRITE_RULE [higher_complex_derivative])  THEN
      ASM_REWRITE_TAC [COMPLEX_MUL_RID, COMPLEX_MUL_LID,
                       COMPLEX_VEC_0, COMPLEX_ADD_RID]  THEN
      ASM_MESON_TAC [← ARITH_RULE (← q r"~(1 <= 0)")],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_VEC_0, COMPLEX_ADD_RID]  THEN
    ASM_REWRITE_TAC [COMPLEX_MUL_RID]  THEN
    ASM_REWRITE_TAC [← GSYM higher_complex_derivative_alt]  THEN
    SUBGOAL_THEN
      (← q r"(\w. complex_derivative f (ITER m f w)) = complex_derivative f o ITER m f")
      SUBST1_TAC
    THENL [REWRITE_TAC [FUN_EQ_THM, o_THM], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"higher_complex_derivative n (complex_derivative f o ITER m f) z =
       higher_complex_derivative n (complex_derivative f) (ITER m f z)")
    SUBST1_TAC  THENL
     [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_COMP_LEMMA  THEN
      EXISTS_TAC (← q r"s:complex->bool")  THEN
      EXISTS_TAC (← q r"s:complex->bool")  THEN
      EXISTS_TAC (← q r"n:num")  THEN
      ASM_REWRITE_TAC []  THEN
      ASM_SIMP_TAC [HOLOMORPHIC_COMPLEX_DERIVATIVE, LE_REFL]  THEN
      REPEAT STRIP_TAC  THEN
      EQ_TRANS_TAC (← q r"higher_complex_derivative i f z")  THENL
       [MATCH_MP_TAC HIGHER_COMPLEX_DERIVATIVE_COMP_ITER_LEMMA  THEN
        EXISTS_TAC (← q r"s:complex->bool")  THEN
        EXISTS_TAC (← q r"n:num")  THEN
        ASM_REWRITE_TAC [],
        ASM_SIMP_TAC []],
      ALL_TAC] THEN
    ASSERT_TAC (← q r"Cx(&(SUC m)) = Cx(&m) +  Cx(&1)")  THENL
     [REWRITE_TAC [← GSYM CX_ADD, REAL_OF_NUM_ADD, ONE, ADD_SUC, ADD_0],
      ASM_REWRITE_TAC [COMPLEX_POLY_CLAUSES,
                      ← GSYM higher_complex_derivative_alt]])

  pure { CAUCHY_THEOREM_GLOBAL, CAUCHY_THEOREM_GLOBAL_OUTSIDE, HAS_RESIDUE_INTEGRAL,
         HAS_RESIDUE_INTEGRAL_INTEGER, HIGHER_COMPLEX_DERIVATIVE_COMP_LEMMA,
         HIGHER_COMPLEX_DERIVATIVE_COMP_ITER_LEMMA, HIGHER_COMPLEX_DERIVATIVE_ITER_TOP_LEMMA }
/- ------------------------------------------------------------------------- -/
/- Higher-derivative bound; first and second Cartan theorems.               -/
/- (cauchy.ml 11831-12306)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBB where
  CAUCHY_HIGHER_COMPLEX_DERIVATIVE_BOUND : thm
  FIRST_CARTAN_THM_DIM_1 : thm
  SECOND_CARTAN_THM_DIM_1 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBB [HolBase] (D : CauchyDeps) (BKYAE : KYAE) (BKYAI : KYAI) (BKYAK : KYAK) (BKYAJ : KYAJ) (BKYAU : KYAU) (BKYBA : KYBA) : ExceptT String IO KYBB := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_BOUND_CIRCLEPATH, .. } := BKYAE
  let { HOLOMORPHIC_HIGHER_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { CAUCHY_HAS_PATH_INTEGRAL_HIGHER_DERIVATIVE_CIRCLEPATH, .. } := BKYAK
  let { HIGHER_COMPLEX_DERIVATIVE_COMPOSE_LINEAR, HIGHER_COMPLEX_DERIVATIVE_CONST,
        HIGHER_COMPLEX_DERIVATIVE_ID, HIGHER_COMPLEX_DERIVATIVE_LINEAR,
        HIGHER_COMPLEX_DERIVATIVE_SUB, HIGHER_COMPLEX_DERIVATIVE_TRANSFORM_WITHIN_OPEN,
        .. } := BKYAJ
  let { HOLOMORPHIC_FUN_EQ_ON_CONNECTED, .. } := BKYAU
  let { HIGHER_COMPLEX_DERIVATIVE_ITER_TOP_LEMMA, .. } := BKYBA
  let { CONTINUOUS_ON_CLOSURE_NORM_LE, .. } := D.qtopology
  let { ARITH_LE, FACT_LE, ONE, RAT_LEMMA5, REAL_LE_INV, REAL_LT_INV, .. } := D.qsession
  let { ITER, ITER_POINTLESS, .. } := D.qiter
  let { REAL_ARCH_RDIV_EQ_0, .. } := D.qmisc
  let { PI_POS, REAL_ABS_PI, .. } := D.mt.ra.tse
  let { COMPLEX_NORM_EQ_1_CEXP, .. } := D.mt.ra.tsh
  let { COMPLEX_NOT_ROOT_UNITY, .. } := D.mt.ra.tsy
  let { num_CASES, .. } := D.mt.ra.qsession
