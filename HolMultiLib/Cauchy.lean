      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:complex->complex) (cball(Cx(&0),&1)) = closure s")
    ASSUME_TAC THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN
