/- ------------------------------------------------------------------------- -/
/- prioritize_complex(); piecewise differentiability on a 1-D interval.      -/
/- (cauchy.ml 1-187)                                                        -/
/- ------------------------------------------------------------------------- -/

structure KYA where
  piecewise_differentiable_on : thm
  PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON : thm
  PIECEWISE_DIFFERENTIABLE_ON_SUBSET : thm
  DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE : thm
  DIFFERENTIABLE_IMP_PIECEWISE_DIFFERENTIABLE : thm
  PIECEWISE_DIFFERENTIABLE_COMPOSE : thm
  DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE : thm
  PIECEWISE_DIFFERENTIABLE_AFFINE : thm
  PIECEWISE_DIFFERENTIABLE_CASES : thm
  PIECEWISE_DIFFERENTIABLE_NEG : thm
  PIECEWISE_DIFFERENTIABLE_ADD : thm
  PIECEWISE_DIFFERENTIABLE_SUB : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYA [HolBase] (D : CauchyDeps) : ExceptT String IO KYA := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_CMUL, DIFFERENTIABLE_ID, DIFFERENTIABLE_TRANSFORM_AT,
        .. } := D.qderivatives
  let { VECTOR_AFFINITY_EQ, .. } := D.qtopology
  let { DIFFERENTIABLE_ADD, DIFFERENTIABLE_CHAIN_AT, DIFFERENTIABLE_CONST,
        .. } := D.mt.ra.qderivatives
  let { prioritize_complex, .. } := D.mt.ra.ts.cn.cxa
  let { DIFFERENTIABLE_IMP_CONTINUOUS_AT, DIFFERENTIABLE_NEG,
        DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT, DIFFERENTIABLE_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, parse_as_infix,
        REAL_ARITH, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { OPEN_CLOSED_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { DE_MORGAN_THM, EXTENSION, FINITE_IMAGE, FINITE_INSERT, FINITE_RULES, FINITE_SUBSET,
        FINITE_UNION, FINITE_UNIONS, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNION, IN_UNIV, MONO_AND, MONO_EXISTS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ANTISYM, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, SUBSET_UNIV, UNIONS_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_NZ, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_EQ, DROP_SUB, INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { dist, drop, VECTOR_MUL_LZERO, VECTOR_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CLOSED_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_AT_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERVAL, OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_ON_CASES, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  -- @@SCOPE END

  prioritize_complex

  -- Piecewise differentiability on a 1-D interval. The definition doesn't
  -- tie it to real^1 but it's not obviously that useful elsewhere.

  parse_as_infix ("piecewise_differentiable_on", (12, "right"))

  let piecewise_differentiable_on ← new_definition
   r"f piecewise_differentiable_on i <=>
        f continuous_on i /\
        (?s. FINITE s /\ !x. x IN (i DIFF s) ==> f differentiable at x)"

  let PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON ← prove
   r"!f s. f piecewise_differentiable_on s ==> f continuous_on s"
   (SIMP_TAC [piecewise_differentiable_on])

  let PIECEWISE_DIFFERENTIABLE_ON_SUBSET ← prove
   r"!f s t.
        f piecewise_differentiable_on s /\ t SUBSET s
        ==> f piecewise_differentiable_on t"
   (REWRITE_TAC [piecewise_differentiable_on] THEN
    MESON_TAC [SUBSET, IN_DIFF, CONTINUOUS_ON_SUBSET])

  let DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE ← prove
   r"!f:real^1->real^N a b.
        f differentiable_on interval[a,b]
        ==> f piecewise_differentiable_on interval[a,b]"
   (SIMP_TAC [piecewise_differentiable_on,
              DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"{a,b}:real^1->bool") THEN
    ASM_REWRITE_TAC [FINITE_INSERT, FINITE_RULES] THEN
    REWRITE_TAC [← GSYM OPEN_CLOSED_INTERVAL_1] THEN
    SIMP_TAC [← GSYM DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT, OPEN_INTERVAL] THEN
    MATCH_MP_TAC DIFFERENTIABLE_ON_SUBSET THEN
    EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
    ASM_REWRITE_TAC [INTERVAL_OPEN_SUBSET_CLOSED])

  let DIFFERENTIABLE_IMP_PIECEWISE_DIFFERENTIABLE ← prove
   r"!f s. (!x. x IN s ==> f differentiable (at x))
         ==> f piecewise_differentiable_on s"
   (SIMP_TAC [piecewise_differentiable_on, DIFFERENTIABLE_IMP_CONTINUOUS_AT,
              CONTINUOUS_AT_IMP_CONTINUOUS_ON, IN_DIFF] THEN
    MESON_TAC [FINITE_RULES])

  let PIECEWISE_DIFFERENTIABLE_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        f piecewise_differentiable_on s /\
        g piecewise_differentiable_on (IMAGE f s) /\
        (!b. FINITE {x | x IN s /\ f(x) = b})
        ==> (g o f) piecewise_differentiable_on s"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [piecewise_differentiable_on, CONTINUOUS_ON_COMPOSE] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"ks:real^M->bool")
                                  STRIP_ASSUME_TAC))
     (CONJUNCTS_THEN2
       (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"kt:real^N->bool")
                                    STRIP_ASSUME_TAC))
       ASSUME_TAC)) THEN
    EXISTS_TAC
      (← q r"ks UNION
       UNIONS(IMAGE (\b. {x | x IN s /\ (f:real^M->real^N) x = b}) kt)") THEN
    ASM_SIMP_TAC [FINITE_UNION, FINITE_UNIONS, FINITE_IMAGE] THEN
    REWRITE_TAC [UNIONS_IMAGE, FORALL_IN_IMAGE, IN_DIFF, IN_UNION] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, DE_MORGAN_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
    CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [])

  let DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE ← prove
   r"!f:real^M->real^N g:real^N->real^P s.
        f piecewise_differentiable_on s /\
        g differentiable_on (:real^N)
        ==> (g o f) piecewise_differentiable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, SUBSET_UNIV,
                     DIFFERENTIABLE_IMP_CONTINUOUS_ON],
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_exists o concl)) THEN
      MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
      ASM_MESON_TAC [DIFFERENTIABLE_ON_EQ_DIFFERENTIABLE_AT,
                     OPEN_UNIV, IN_UNIV]])

  let PIECEWISE_DIFFERENTIABLE_AFFINE ← prove
   r"!f:real^M->real^N s m c.
        f piecewise_differentiable_on (IMAGE (\x. m % x + c) s)
        ==> (f o (\x. m % x + c)) piecewise_differentiable_on s"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"m = &0") THENL
     [ASM_REWRITE_TAC [o_DEF, VECTOR_MUL_LZERO] THEN
      MATCH_MP_TAC DIFFERENTIABLE_IMP_PIECEWISE_DIFFERENTIABLE THEN
      SIMP_TAC [DIFFERENTIABLE_CONST],
      MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_COMPOSE THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC DIFFERENTIABLE_IMP_PIECEWISE_DIFFERENTIABLE THEN
        SIMP_TAC [DIFFERENTIABLE_ADD, DIFFERENTIABLE_CMUL, DIFFERENTIABLE_CONST,
                  DIFFERENTIABLE_ID],
        X_GEN_TAC (← q r"b:real^M") THEN ASM_SIMP_TAC [VECTOR_AFFINITY_EQ] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{inv m % b + --(inv m % c):real^M}") THEN
        SIMP_TAC [FINITE_RULES] THEN SET_TAC []]])

  let PIECEWISE_DIFFERENTIABLE_CASES ← prove
   r"!f g:real^1->real^N a b c.
        drop a <= drop c /\ drop c <= drop b /\ f c = g c /\
        f piecewise_differentiable_on interval[a,c] /\
        g piecewise_differentiable_on interval[c,b]
        ==> (\x. if drop x <= drop c then f(x) else g(x))
            piecewise_differentiable_on interval[a,b]"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"s:real^1->bool")
                                  STRIP_ASSUME_TAC))
     (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"t:real^1->bool")
                                  STRIP_ASSUME_TAC))) THEN
    CONJ_TAC THENL
     [SUBGOAL_THEN (← q r"interval[a:real^1,b] = interval[a,c] UNION interval[c,b]")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNION, IN_INTERVAL_1] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_CASES THEN
      ASM_REWRITE_TAC [CLOSED_INTERVAL, IN_INTERVAL_1] THEN
      ASM_MESON_TAC [REAL_LE_ANTISYM, DROP_EQ],
      ALL_TAC] THEN
    EXISTS_TAC (← q r"(c:real^1) INSERT s UNION t") THEN
    ASM_REWRITE_TAC [FINITE_INSERT, FINITE_UNION] THEN
    REWRITE_TAC [DE_MORGAN_THM, IN_DIFF, IN_INTERVAL_1, IN_INSERT, IN_UNION] THEN
    X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
    DISJ_CASES_TAC (← REAL_ARITH (← q r"drop x <= drop c \/ drop c <= drop x")) THEN
    MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THENL
     [EXISTS_TAC (← q r"f:real^1->real^N"), EXISTS_TAC (← q r"g:real^1->real^N")] THEN
    EXISTS_TAC (← q r"dist(x:real^1,c)") THEN ASM_REWRITE_TAC [← GSYM DIST_NZ] THEN
    (CONJ_TAC THENL
      [GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
       REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB] THEN
       ASM_REAL_ARITH_TAC,
       FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_REWRITE_TAC [IN_INTERVAL_1, IN_DIFF]]))

  let PIECEWISE_DIFFERENTIABLE_NEG ← prove
   r"!f:real^M->real^N s.
        f piecewise_differentiable_on s
        ==> (\x. --(f x)) piecewise_differentiable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [piecewise_differentiable_on] THEN
    MATCH_MP_TAC MONO_AND THEN SIMP_TAC [CONTINUOUS_ON_NEG] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [DIFFERENTIABLE_NEG])

  let PIECEWISE_DIFFERENTIABLE_ADD ← prove
   r"!f g:real^M->real^N s.
        f piecewise_differentiable_on s /\
        g piecewise_differentiable_on s
        ==> (\x. f x + g x) piecewise_differentiable_on s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_ADD] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"t:real^M->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"u:real^M->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"t UNION u :real^M->bool") THEN
    ASM_SIMP_TAC [FINITE_UNION, DIFFERENTIABLE_ADD, IN_INTER,
                  ← SET_RULE (← q r"s DIFF (t UNION u) = (s DIFF t) INTER (s DIFF u)")])

  let PIECEWISE_DIFFERENTIABLE_SUB ← prove
   r"!f g:real^M->real^N s.
        f piecewise_differentiable_on s /\
        g piecewise_differentiable_on s
        ==> (\x. f x - g x) piecewise_differentiable_on s"
   (SIMP_TAC [VECTOR_SUB, PIECEWISE_DIFFERENTIABLE_ADD,
              PIECEWISE_DIFFERENTIABLE_NEG])

  pure { piecewise_differentiable_on, PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON,
         PIECEWISE_DIFFERENTIABLE_ON_SUBSET, DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE,
         DIFFERENTIABLE_IMP_PIECEWISE_DIFFERENTIABLE, PIECEWISE_DIFFERENTIABLE_COMPOSE,
         DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE, PIECEWISE_DIFFERENTIABLE_AFFINE,
         PIECEWISE_DIFFERENTIABLE_CASES, PIECEWISE_DIFFERENTIABLE_NEG,
         PIECEWISE_DIFFERENTIABLE_ADD, PIECEWISE_DIFFERENTIABLE_SUB }
/- ------------------------------------------------------------------------- -/
/- Valid paths, and their start and finish; results for paths; rectifiable  -/
/- valid paths; negligibility of valid_path image.                           -/
/- (cauchy.ml 188-365)                                                      -/
/- ------------------------------------------------------------------------- -/

structure KYB where
  valid_path : thm
  closed_path : thm
  VALID_PATH_EQ : thm
  VALID_PATH_COMPOSE : thm
  VALID_PATH_TRANSLATION_EQ : thm
  VALID_PATH_LINEAR_IMAGE_EQ : thm
  VALID_PATH_IMP_PATH : thm
  CONNECTED_VALID_PATH_IMAGE : thm
  COMPACT_VALID_PATH_IMAGE : thm
  BOUNDED_VALID_PATH_IMAGE : thm
  CLOSED_VALID_PATH_IMAGE : thm
  RECTIFIABLE_VALID_PATH : thm
  PATH_LENGTH_VALID_PATH : thm
  ABSOLUTELY_CONTINUOUS_RECTIFIABLE_VALID_PATH : thm
  NEGLIGIBLE_VALID_PATH_IMAGE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYB [HolBase] (D : CauchyDeps) (BKYA : KYA) : ExceptT String IO KYB := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE, piecewise_differentiable_on,
        .. } := BKYA
  let { DIFFERENTIABLE_ON_CONST, DIFFERENTIABLE_TRANSFORM_AT, .. } := D.qderivatives
  let { PATH_LENGTH_DIFFERENTIABLE, RECTIFIABLE_PATH_DIFFERENTIABLE, .. } := D.qintegration
  let { ABSOLUTELY_CONTINUOUS_DIFFERENTIABLE_BV_GEN,
        NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM, .. } := D.qmeasure
  let { DIFFERENTIABLE_ON_ADD, DIFFERENTIABLE_ON_ID, .. } := D.mt.qderivatives
  let { DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON, .. } := D.mt.ra.ts.qderivatives
  let { DIFFERENTIABLE_AT_WITHIN, DIFFERENTIABLE_CHAIN_WITHIN, DIFFERENTIABLE_ON_LINEAR,
        DIFFERENTIABLE_WITHIN_OPEN, DIFFERENTIABLE_WITHIN_SUBSET,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { NEGLIGIBLE_FINITE, NEGLIGIBLE_SUBSET, NEGLIGIBLE_UNION_EQ, rectifiable_path,
        .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { add_linear_invariants, add_translation_invariants, ASM_MESON_TAC, MESON_TAC,
        new_definition, SET_RULE, SET_TAC, VECTOR_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFFERENTIABLE_IMP_CONTINUOUS_ON, differentiable_on,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { CLOSED_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { OPEN_CLOSED_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { ARITH, DIMINDEX_1, DIMINDEX_2, FINITE_EMPTY, FINITE_IMAGE, FINITE_INSERT,
        FINITE_UNION, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMAGE_SUBSET, IMAGE_UNION, IMP_CONJ_ALT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, MONO_AND, MONO_EXISTS, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { o_ASSOC, o_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { INTERVAL_OPEN_SUBSET_CLOSED, LINEAR_INJECTIVE_LEFT_INVERSE,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IS_INTERVAL_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { open_def, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { BOUNDED_PATH_IMAGE, COMPACT_PATH_IMAGE, CONNECTED_PATH_IMAGE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path, path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { I_O_ID, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { FINITE_IMP_CLOSED, OPEN_DIFF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { FINITE_IMP_COUNTABLE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcard
  let { BOUNDED_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let valid_path ← new_definition
   r"valid_path (f:real^1->complex) <=>
     f piecewise_differentiable_on interval[vec 0,vec 1]"

  let closed_path ← new_definition
   r"closed_path g <=> pathstart g = pathfinish g"

  let VALID_PATH_EQ ← prove
   r"!p q. (!t. t IN interval[vec 0,vec 1] ==> p t = q t) /\ valid_path p
         ==> valid_path q"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [valid_path, piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_AND THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_EQ], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{vec 0:real^1,vec 1} UNION k") THEN
    ASM_REWRITE_TAC [FINITE_UNION, FINITE_INSERT, FINITE_EMPTY] THEN
    X_GEN_TAC (← q r"x:real^1") THEN
    STRIP_TAC THEN MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THEN
    EXISTS_TAC (← q r"p:real^1->real^2") THEN
    SUBGOAL_THEN
     (← q r"open(interval[vec 0:real^1,vec 1] DIFF ({vec 0:real^1,vec 1} UNION k))")
    MP_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"a DIFF (b UNION c) = (a DIFF b) DIFF c")] THEN
      REWRITE_TAC [← GSYM OPEN_CLOSED_INTERVAL_1] THEN MATCH_MP_TAC OPEN_DIFF THEN
      ASM_SIMP_TAC [OPEN_INTERVAL, FINITE_IMP_CLOSED],
      REWRITE_TAC [open_def] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^1"))] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let VALID_PATH_COMPOSE ← prove
   r"!f g. valid_path g /\ f differentiable_on (path_image g)
         ==> valid_path (f o g)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [valid_path, piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC)) THEN
    ASM_SIMP_TAC [CONTINUOUS_ON_COMPOSE, DIFFERENTIABLE_IMP_CONTINUOUS_ON] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      ASM_MESON_TAC [DIFFERENTIABLE_IMP_CONTINUOUS_ON, path_image],
      EXISTS_TAC (← q r"{vec 0:real^1,vec 1} UNION s") THEN
      ASM_REWRITE_TAC [FINITE_UNION, FINITE_INSERT, FINITE_EMPTY] THEN
      REWRITE_TAC [← SET_RULE (← q r"s DIFF (t UNION u) = (s DIFF t) DIFF u")] THEN
      REWRITE_TAC [← GSYM OPEN_CLOSED_INTERVAL_1] THEN
      X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"((f:complex->complex) o (g:real^1->complex))
        differentiable (at t within (interval(vec 0,vec 1) DIFF s))")
      MP_TAC THENL
       [MATCH_MP_TAC DIFFERENTIABLE_CHAIN_WITHIN THEN CONJ_TAC THENL
         [MATCH_MP_TAC DIFFERENTIABLE_AT_WITHIN THEN
          FIRST_X_ASSUM MATCH_MP_TAC,
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [differentiable_on]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"(g:real^1->complex) t")) THEN
          ANTS_TAC THENL
           [REWRITE_TAC [path_image, IN_IMAGE] THEN EXISTS_TAC (← q r"t:real^1"),
            MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
              DIFFERENTIABLE_WITHIN_SUBSET) THEN
            REWRITE_TAC [path_image] THEN MATCH_MP_TAC IMAGE_SUBSET]] THEN
        MP_TAC (← ISPECL [← q r"vec 0:real^1", ← q r"vec 1:real^1"]
          INTERVAL_OPEN_SUBSET_CLOSED) THEN ASM SET_TAC [],
        ASM_SIMP_TAC [DIFFERENTIABLE_WITHIN_OPEN, OPEN_DIFF, OPEN_INTERVAL,
                      FINITE_IMP_CLOSED]]])

  let VALID_PATH_TRANSLATION_EQ ← prove
   r"!a g. valid_path((\x. a + x) o g) <=> valid_path g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [valid_path] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"(g:real^1->complex) = (\x. --a + x) o (\x. a + x) o g")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN VECTOR_ARITH_TAC, ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE THEN
    ASM_REWRITE_TAC [] THEN
    SIMP_TAC [DIFFERENTIABLE_ON_ADD, DIFFERENTIABLE_ON_CONST,
              DIFFERENTIABLE_ON_ID])

  add_translation_invariants [VALID_PATH_TRANSLATION_EQ]

  let VALID_PATH_LINEAR_IMAGE_EQ ← prove
   r"!f g. linear f /\ (!x y. f x = f y ==> x = y)
         ==> (valid_path(f o g) <=> valid_path g)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"h:complex->complex") STRIP_ASSUME_TAC o
          MATCH_MP LINEAR_INJECTIVE_LEFT_INVERSE) THEN
    REWRITE_TAC [valid_path] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"g:real^1->complex = h o (f:complex->complex) o g")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [o_ASSOC, I_O_ID], ALL_TAC],
      ALL_TAC] THEN
    MATCH_MP_TAC DIFFERENTIABLE_PIECEWISE_DIFFERENTIABLE_COMPOSE THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_ON_LINEAR])

  add_linear_invariants [VALID_PATH_LINEAR_IMAGE_EQ]

  -- In particular, all results for paths apply.

  let VALID_PATH_IMP_PATH ← prove
   r"!g. valid_path g ==> path g"
   (SIMP_TAC [valid_path, path, piecewise_differentiable_on])

  let CONNECTED_VALID_PATH_IMAGE ← prove
   r"!g. valid_path g ==> connected(path_image g)"
   (MESON_TAC [CONNECTED_PATH_IMAGE, VALID_PATH_IMP_PATH])

  let COMPACT_VALID_PATH_IMAGE ← prove
   r"!g. valid_path g ==> compact(path_image g)"
   (MESON_TAC [COMPACT_PATH_IMAGE, VALID_PATH_IMP_PATH])

  let BOUNDED_VALID_PATH_IMAGE ← prove
   r"!g. valid_path g ==> bounded(path_image g)"
   (MESON_TAC [BOUNDED_PATH_IMAGE, VALID_PATH_IMP_PATH])

  let CLOSED_VALID_PATH_IMAGE ← prove
   r"!g. valid_path g ==> closed(path_image g)"
   (MESON_TAC [CLOSED_PATH_IMAGE, VALID_PATH_IMP_PATH])

  -- Theorems about rectifiable valid paths.

  let RECTIFIABLE_VALID_PATH ← prove
   r"!g. valid_path g
       ==> (rectifiable_path g <=>
              (\t. vector_derivative g (at t)) absolutely_integrable_on
              interval [vec 0,vec 1])"
   (REWRITE_TAC [valid_path, piecewise_differentiable_on, ← GSYM path] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC RECTIFIABLE_PATH_DIFFERENTIABLE THEN
    ASM_MESON_TAC [FINITE_IMP_COUNTABLE])

  let PATH_LENGTH_VALID_PATH ← prove
   r"!g. valid_path g /\ rectifiable_path g
       ==> path_length g =
                 drop(integral (interval[vec 0,vec 1])
                               (\t. lift(norm(vector_derivative g (at t)))))"
   (REWRITE_TAC [valid_path, piecewise_differentiable_on, ← GSYM path] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_LENGTH_DIFFERENTIABLE THEN
    ASM_MESON_TAC [FINITE_IMP_COUNTABLE])

  let ABSOLUTELY_CONTINUOUS_RECTIFIABLE_VALID_PATH ← prove
   r"!g:real^1->complex.
        valid_path g /\ rectifiable_path g
        ==> g absolutely_continuous_on interval[vec 0,vec 1]"
   (GEN_TAC THEN
    REWRITE_TAC [valid_path, rectifiable_path, piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"c:real^1->bool") STRIP_ASSUME_TAC)) THEN
    MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_DIFFERENTIABLE_BV_GEN THEN
    EXISTS_TAC (← q r"c:real^1->bool") THEN ASM_SIMP_TAC [FINITE_IMP_COUNTABLE] THEN
    ASM_REWRITE_TAC [IS_INTERVAL_INTERVAL, BOUNDED_INTERVAL] THEN
    ASM_MESON_TAC [DIFFERENTIABLE_AT_WITHIN])

  -- Negligibility of valid_path image

  let NEGLIGIBLE_VALID_PATH_IMAGE ← prove
   r"!g. valid_path g ==> negligible(path_image g)"
   (REWRITE_TAC [piecewise_differentiable_on, piecewise_differentiable_on,
                 valid_path, path_image] THEN
    GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^1->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC NEGLIGIBLE_SUBSET THEN
    EXISTS_TAC (← q r"IMAGE (g:real^1->real^2)
                      (k UNION (interval [vec 0,vec 1] DIFF k))") THEN
    CONJ_TAC THENL [REWRITE_TAC [IMAGE_UNION], SET_TAC []] THEN
    ASM_SIMP_TAC [NEGLIGIBLE_UNION_EQ, NEGLIGIBLE_FINITE, FINITE_IMAGE] THEN
    MATCH_MP_TAC NEGLIGIBLE_DIFFERENTIABLE_IMAGE_LOWDIM THEN
    REWRITE_TAC [DIMINDEX_1, DIMINDEX_2, ARITH] THEN
    ASM_SIMP_TAC [DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON])

  pure { valid_path, closed_path, VALID_PATH_EQ, VALID_PATH_COMPOSE,
         VALID_PATH_TRANSLATION_EQ, VALID_PATH_LINEAR_IMAGE_EQ, VALID_PATH_IMP_PATH,
         CONNECTED_VALID_PATH_IMAGE, COMPACT_VALID_PATH_IMAGE, BOUNDED_VALID_PATH_IMAGE,
         CLOSED_VALID_PATH_IMAGE, RECTIFIABLE_VALID_PATH, PATH_LENGTH_VALID_PATH,
         ABSOLUTELY_CONTINUOUS_RECTIFIABLE_VALID_PATH, NEGLIGIBLE_VALID_PATH_IMAGE }
/- ------------------------------------------------------------------------- -/
/- Integrals along a path (= piecewise differentiable function on [0,1]);   -/
/- forgetting the localized derivative; reversing a path.                    -/
/- (cauchy.ml 366-536)                                                      -/
/- ------------------------------------------------------------------------- -/

structure KYC where
  has_path_integral : thm
  path_integral : thm
  path_integrable_on : thm
  PATH_INTEGRAL_UNIQUE : thm
  HAS_PATH_INTEGRAL_INTEGRAL : thm
  HAS_PATH_INTEGRAL_UNIQUE : thm
  HAS_PATH_INTEGRAL_INTEGRABLE : thm
  HAS_PATH_INTEGRAL_INTEGRABLE_INTEGRAL : thm
  VECTOR_DERIVATIVE_WITHIN_INTERIOR : thm
  HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE : thm
  HAS_PATH_INTEGRAL : thm
  PATH_INTEGRABLE_ON : thm
  VALID_PATH_REVERSEPATH : thm
  HAS_PATH_INTEGRAL_REVERSEPATH : thm
  PATH_INTEGRABLE_REVERSEPATH : thm
  PATH_INTEGRABLE_REVERSEPATH_EQ : thm
  PATH_INTEGRAL_REVERSEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYC [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) : ExceptT String IO KYC := do
  -- @@SCOPE BEGIN
  let { piecewise_differentiable_on, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { DIFFERENTIABLE_ID, DIFFERENTIABLE_SUB, HAS_VECTOR_DERIVATIVE_ID,
        VECTOR_DIFF_CHAIN_AT, .. } := D.qderivatives
  let { HAS_INTEGRAL_SPIKE_FINITE, .. } := D.qintegration
  let { DIFFERENTIABLE_CHAIN_AT, DIFFERENTIABLE_CONST, .. } := D.mt.ra.qderivatives
  let { HAS_INTEGRAL_NEG, .. } := D.mt.ra.qintegration
  let { define, .. } := D.mt.ra.ts.cn.cx
  let { COMPLEX_MUL_RNEG, .. } := D.mt.ra.ts.cn.cxb
  let { vector_derivative, .. } := D.mt.ra.ts.cn.qderivatives
  let { HAS_VECTOR_DERIVATIVE_SUB, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_SPIKE_EQ, HAS_INTEGRAL_UNIQUE,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, integral, INTEGRAL_UNIQUE, NEGLIGIBLE_EMPTY, NEGLIGIBLE_INSERT,
        .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { MESON_TAC, new_definition, parse_as_infix, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { has_derivative, has_vector_derivative, HAS_VECTOR_DERIVATIVE_CONST,
        VECTOR_DERIVATIVE_WORKS, .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { reversepath, REVERSEPATH_REVERSEPATH, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { IMAGE_AFFINITY_INTERVAL, LIM_WITHIN_INTERIOR, NETLIMIT_AT,
        .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { CONTRAPOS_THM, DIMINDEX_1, EXTENSION, FINITE_IMAGE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_IN_IMAGE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_INSERT, MONO_AND, NOT_IN_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_1, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_POW_ONE, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_EQ, DROP_SUB, DROP_VEC, FORALL_1, IN_INTERVAL,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { drop, VECTOR_ADD_LID, VECTOR_MUL_LID, VECTOR_MUL_LNEG, VECTOR_MUL_RZERO,
        VECTOR_NEG_NEG, VECTOR_SUB_RZERO, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, INTERIOR_CLOSED_INTERVAL, INTERVAL_EQ_EMPTY_1,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { NETLIMIT_WITHIN, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { path, PATH_REVERSEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { DROP_NEG, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  parse_as_infix ("has_path_integral", (12, "right"))
  parse_as_infix ("path_integrable_on", (12, "right"))

  let has_path_integral ← define
   r"(f has_path_integral i) (g) <=>
       ((\x. f(g(x)) * vector_derivative g (at x within interval[vec 0,vec 1]))
        has_integral i)
       (interval[vec 0,vec 1])"

  let path_integral ← new_definition
   r"path_integral g f = @i. (f has_path_integral i) (g)"

  let path_integrable_on ← new_definition
   r"f path_integrable_on g <=> ?i. (f has_path_integral i) g"

  let PATH_INTEGRAL_UNIQUE ← prove
   r"!f g i. (f has_path_integral i) (g) ==> path_integral(g) f = i"
   (REWRITE_TAC [path_integral, has_path_integral, ← GSYM integral] THEN
    MESON_TAC [INTEGRAL_UNIQUE])

  let HAS_PATH_INTEGRAL_INTEGRAL ← prove
   r"!f i. f path_integrable_on i
         ==> (f has_path_integral (path_integral i f)) i"
   (REWRITE_TAC [path_integral, path_integrable_on] THEN
    MESON_TAC [PATH_INTEGRAL_UNIQUE])

  let HAS_PATH_INTEGRAL_UNIQUE ← prove
   r"!f i j g. (f has_path_integral i) g /\
             (f has_path_integral j) g
             ==> i = j"
   (REWRITE_TAC [has_path_integral] THEN MESON_TAC [HAS_INTEGRAL_UNIQUE])

  let HAS_PATH_INTEGRAL_INTEGRABLE ← prove
   r"!f g i. (f has_path_integral i) g ==> f path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN MESON_TAC [])

  let HAS_PATH_INTEGRAL_INTEGRABLE_INTEGRAL ← prove
   r"!f y g. (f has_path_integral y) g <=>
           f path_integrable_on g /\ path_integral g f = y"
   (MESON_TAC [PATH_INTEGRAL_UNIQUE, HAS_PATH_INTEGRAL_INTEGRAL,
               path_integrable_on])

  -- Show that we can forget about the localized derivative.

  let VECTOR_DERIVATIVE_WITHIN_INTERIOR ← prove
   r"!a b x.
        x IN interior(interval[a,b])
        ==> vector_derivative f (at x within interval[a,b]) =
            vector_derivative f (at x)"
   (SIMP_TAC [vector_derivative, has_vector_derivative, has_derivative,
              LIM_WITHIN_INTERIOR, NETLIMIT_WITHIN, NETLIMIT_AT])

  let HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE ← prove
   r"((\x. f' (g x) * vector_derivative g (at x within interval [a,b]))
    has_integral i) (interval [a,b]) <=>
    ((\x. f' (g x) * vector_derivative g (at x))
     has_integral i) (interval [a,b])"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ THEN
    EXISTS_TAC (← q r"{a:real^1,b}") THEN
    REWRITE_TAC [NEGLIGIBLE_INSERT, NEGLIGIBLE_EMPTY] THEN
    SUBGOAL_THEN (← q r"interval[a:real^1,b] DIFF {a,b} = interior(interval[a,b])")
     (fun th => SIMP_TAC [th, VECTOR_DERIVATIVE_WITHIN_INTERIOR]) THEN
    REWRITE_TAC [INTERIOR_CLOSED_INTERVAL] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_INTERVAL, IN_INSERT, NOT_IN_EMPTY] THEN
    REWRITE_TAC [DIMINDEX_1, FORALL_1, ← GSYM drop, ← GSYM DROP_EQ] THEN
    REAL_ARITH_TAC)

  let HAS_PATH_INTEGRAL ← prove
   r"(f has_path_integral i) g <=>
        ((\x. f (g x) * vector_derivative g (at x)) has_integral i)
        (interval[vec 0,vec 1])"
   (SIMP_TAC [HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE, has_path_integral])

  let PATH_INTEGRABLE_ON ← prove
   r"f path_integrable_on g <=>
        (\t. f(g t) * vector_derivative g (at t))
            integrable_on interval[vec 0,vec 1]"
   (REWRITE_TAC [path_integrable_on, HAS_PATH_INTEGRAL, ← GSYM integrable_on])

  -- Reversing a path.

  let VALID_PATH_REVERSEPATH ← prove
   r"!g. valid_path(reversepath g) <=> valid_path g"
   (SUBGOAL_THEN (← q r"!g. valid_path g ==> valid_path(reversepath g)")
     (fun th => MESON_TAC [th, REVERSEPATH_REVERSEPATH]) THEN GEN_TAC THEN
    SIMP_TAC [valid_path, piecewise_differentiable_on, ← GSYM path,
              PATH_REVERSEPATH] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC) MP_TAC) THEN
    REWRITE_TAC [IN_DIFF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (\x:real^1. vec 1 - x) s") THEN
    ASM_SIMP_TAC [FINITE_IMAGE, reversepath] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
    SIMP_TAC [DIFFERENTIABLE_SUB, DIFFERENTIABLE_CONST, DIFFERENTIABLE_ID] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"(x:real^1) IN interval[vec 0,vec 1]") THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC,
      DISCH_THEN (MP_TAC o ISPEC (← q r"\x:real^1. vec 1 - x") o
       MATCH_MP FUN_IN_IMAGE) THEN
      UNDISCH_TAC (← q r"~((x:real^1) IN IMAGE (\x. vec 1 - x) s)") THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"vec 1 - (vec 1 - x):real^1 = x")]])

  let HAS_PATH_INTEGRAL_REVERSEPATH ← prove
   r"!f g i. valid_path g /\ (f has_path_integral i) g
           ==> (f has_path_integral (--i)) (reversepath g)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_PATH_INTEGRAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o C CONJ (← REAL_ARITH (← q r"~(-- &1 = &0)"))) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"vec 1:real^1")) THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x + --x:real^1 = vec 0")] THEN
    REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_ADD_LID, VECTOR_MUL_LNEG] THEN
    REWRITE_TAC [VECTOR_MUL_LID, VECTOR_NEG_NEG, REAL_POW_ONE] THEN
    REWRITE_TAC [reversepath, ← VECTOR_ARITH (← q r"-- x + a:real^N = a - x")] THEN
    REWRITE_TAC [REAL_INV_1, VECTOR_MUL_LID] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_INTEGRAL_NEG) THEN
    REWRITE_TAC [VECTOR_SUB_RZERO] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
                  HAS_INTEGRAL_SPIKE_FINITE) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [valid_path]) THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    EXISTS_TAC (← q r"IMAGE (\x:real^1. vec 1 - x) s") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [← GSYM COMPLEX_MUL_RNEG] THEN
    AP_TERM_TAC THEN MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"--x = --(&1) % x")] THEN
    REWRITE_TAC [← GSYM DROP_VEC, ← GSYM DROP_NEG] THEN
    MATCH_MP_TAC VECTOR_DIFF_CHAIN_AT THEN REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"--x:real^N = vec 0 - x")] THEN
    SIMP_TAC [HAS_VECTOR_DERIVATIVE_SUB, HAS_VECTOR_DERIVATIVE_CONST,
              HAS_VECTOR_DERIVATIVE_ID] THEN
    REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_DIFF]) THEN
    REWRITE_TAC [IN_DIFF] THEN MATCH_MP_TAC MONO_AND THEN
    REWRITE_TAC [CONTRAPOS_THM, IN_DIFF, IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN
    CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN REWRITE_TAC [IN_IMAGE] THEN
    MESON_TAC [← VECTOR_ARITH (← q r"vec 1 - (vec 1 - x):real^1 = x")])

  let PATH_INTEGRABLE_REVERSEPATH ← prove
   r"!f g. valid_path g /\ f path_integrable_on g
         ==> f path_integrable_on (reversepath g)"
   (REWRITE_TAC [path_integrable_on] THEN
    MESON_TAC [HAS_PATH_INTEGRAL_REVERSEPATH])

  let PATH_INTEGRABLE_REVERSEPATH_EQ ← prove
   r"!f g. valid_path g
         ==> (f path_integrable_on (reversepath g) <=>
              f path_integrable_on g)"
   (MESON_TAC [PATH_INTEGRABLE_REVERSEPATH, VALID_PATH_REVERSEPATH,
               REVERSEPATH_REVERSEPATH])

  let PATH_INTEGRAL_REVERSEPATH ← prove
   r"!f g. valid_path g /\ f path_integrable_on g
         ==> path_integral (reversepath g) f = --(path_integral g f)"
   (MESON_TAC [PATH_INTEGRAL_UNIQUE, HAS_PATH_INTEGRAL_REVERSEPATH,
               HAS_PATH_INTEGRAL_INTEGRAL])

  pure { has_path_integral, path_integral, path_integrable_on, PATH_INTEGRAL_UNIQUE,
         HAS_PATH_INTEGRAL_INTEGRAL, HAS_PATH_INTEGRAL_UNIQUE,
         HAS_PATH_INTEGRAL_INTEGRABLE, HAS_PATH_INTEGRAL_INTEGRABLE_INTEGRAL,
         VECTOR_DERIVATIVE_WITHIN_INTERIOR, HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE,
         HAS_PATH_INTEGRAL, PATH_INTEGRABLE_ON, VALID_PATH_REVERSEPATH,
         HAS_PATH_INTEGRAL_REVERSEPATH, PATH_INTEGRABLE_REVERSEPATH,
         PATH_INTEGRABLE_REVERSEPATH_EQ, PATH_INTEGRAL_REVERSEPATH }
/- ------------------------------------------------------------------------- -/
/- Joining two paths together.                                               -/
/- (cauchy.ml 537-874)                                                      -/
/- ------------------------------------------------------------------------- -/

structure KYD where
  VALID_PATH_JOIN_EQ : thm
  VALID_PATH_JOIN : thm
  VALID_PATH_SYM : thm
  HAS_PATH_INTEGRAL_JOIN : thm
  PATH_INTEGRABLE_JOIN : thm
  PATH_INTEGRAL_JOIN : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYD [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) : ExceptT String IO KYD := do
  -- @@SCOPE BEGIN
  let { piecewise_differentiable_on, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_PATH_INTEGRAL, HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on,
        PATH_INTEGRABLE_ON, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { DIFFERENTIABLE_CMUL, DIFFERENTIABLE_ID, DIFFERENTIABLE_SUB,
        DIFFERENTIABLE_TRANSFORM_AT, HAS_VECTOR_DERIVATIVE_TRANSFORM_AT,
        VECTOR_DIFF_CHAIN_AT, .. } := D.qderivatives
  let { HAS_INTEGRAL_SPIKE_FINITE, INTEGRABLE_SPIKE_FINITE, .. } := D.qintegration
  let { FINITE_IMAGE_INJ, .. } := D.qsession
  let { DIFFERENTIABLE_ADD, DIFFERENTIABLE_CHAIN_AT, DIFFERENTIABLE_CONST,
        .. } := D.mt.ra.qderivatives
  let { HAS_INTEGRAL_COMBINE, .. } := D.mt.ra.qintegration
  let { SIMPLE_COMPLEX_ARITH, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_CMUL, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { HAS_DERIVATIVE_LINEAR, HAS_VECTOR_DERIVATIVE_SUB, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_CMUL, INTEGRABLE_AFFINITY, INTEGRABLE_CMUL,
        INTEGRABLE_ON_SUBINTERVAL, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { has_vector_derivative, HAS_VECTOR_DERIVATIVE_CONST, VECTOR_DERIVATIVE_WORKS,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { DIST_REAL, NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { CONJ_ASSOC, DE_MORGAN_THM, DIMINDEX_1, FINITE_IMAGE, FINITE_INSERT, FINITE_UNION,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_UNION, NOT_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_IMP_LE, REAL_LT_IMP_NE, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_SUB_0, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, LIFT_CMUL, LIFT_DROP, LIFT_NUM,
        LIFT_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { dist, drop, linear, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC,
        VECTOR_MUL_RNEG, VECTOR_MUL_RZERO, VECTOR_NEG_NEG, VECTOR_SUB, VECTOR_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { REAL_ABS_NZ, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { joinpaths, path, PATH_JOIN, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { DROP_NEG, VECTOR_NEG_0, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  let VALID_PATH_JOIN_EQ ← prove
   r"!g1 g2.
        pathfinish g1 = pathstart g2
        ==> (valid_path(g1 ++ g2) <=> valid_path g1 /\ valid_path g2)"
   (REWRITE_TAC [valid_path, piecewise_differentiable_on, ← GSYM path] THEN
    ASM_SIMP_TAC [PATH_JOIN] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"path(g1:real^1->complex)") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"path(g2:real^1->complex)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"(vec 0) INSERT (vec 1) INSERT
                    {x:real^1 | ((&1 / &2) % x) IN s}") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [FINITE_INSERT] THEN MATCH_MP_TAC FINITE_IMAGE_INJ THEN
          ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        X_GEN_TAC (← q r"x:real^1") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 / &2) % x:real^1")) THEN
        REWRITE_TAC [IN_DIFF, IN_ELIM_THM, IN_INTERVAL_1, DROP_CMUL, DROP_VEC,
                     IN_INSERT, DE_MORGAN_THM, ← GSYM DROP_EQ, NOT_EXISTS_THM] THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"(g1:real^1->complex) = (\x. g1 (&2 % x)) o (\x. &1 / &2 % x)")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN GEN_TAC THEN AP_TERM_TAC THEN
          VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
        SIMP_TAC [DIFFERENTIABLE_CMUL, DIFFERENTIABLE_ID] THEN
        MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THEN
        EXISTS_TAC (← q r"(g1 ++ g2):real^1->complex") THEN
        EXISTS_TAC (← q r"dist(&1 / &2 % x:real^1,lift(&1 / &2))") THEN
        ASM_REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB, DROP_CMUL,
                         LIFT_DROP] THEN
        REWRITE_TAC [joinpaths] THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC,
        EXISTS_TAC (← q r"(vec 0) INSERT (vec 1) INSERT
                    {x:real^1 | ((&1 / &2) % (x + vec 1)) IN s}") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [FINITE_INSERT] THEN MATCH_MP_TAC FINITE_IMAGE_INJ THEN
          ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        X_GEN_TAC (← q r"x:real^1") THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(&1 / &2) % (x + vec 1):real^1")) THEN
        REWRITE_TAC [IN_DIFF, IN_ELIM_THM, IN_INTERVAL_1, DROP_CMUL, DROP_VEC,
         DROP_ADD, IN_INSERT, DE_MORGAN_THM, ← GSYM DROP_EQ, NOT_EXISTS_THM] THEN
        DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_TAC THEN
        SUBGOAL_THEN
         (← q r"(g2:real^1->complex) =
          (\x. g2 (&2 % x - vec 1)) o (\x. &1 / &2 % (x + vec 1))")
        SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN GEN_TAC THEN AP_TERM_TAC THEN
          VECTOR_ARITH_TAC,
          ALL_TAC] THEN
        MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
        SIMP_TAC [DIFFERENTIABLE_CMUL, DIFFERENTIABLE_ADD,
                  DIFFERENTIABLE_CONST, DIFFERENTIABLE_ID] THEN
        MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THEN
        EXISTS_TAC (← q r"(g1 ++ g2):real^1->complex") THEN
        EXISTS_TAC (← q r"dist(&1 / &2 % (x + vec 1):real^1,lift(&1 / &2))") THEN
        ASM_REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB, DROP_CMUL,
                         DROP_ADD, DROP_VEC, LIFT_DROP] THEN
        REWRITE_TAC [joinpaths] THEN
        REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
        ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s1:real^1->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"s2:real^1->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"(&1 / &2 % vec 1:real^1) INSERT
                {x:real^1 | (&2 % x) IN s1} UNION
                {x:real^1 | (&2 % x - vec 1) IN s2}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [FINITE_INSERT, FINITE_UNION] THEN
      CONJ_TAC THEN MATCH_MP_TAC FINITE_IMAGE_INJ THEN
      ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN
    REWRITE_TAC [IN_INTERVAL_1, IN_DIFF, DROP_VEC, IN_INSERT, IN_ELIM_THM,
                 DE_MORGAN_THM, IN_UNION, ← GSYM DROP_EQ, DROP_CMUL] THEN
    STRIP_TAC THEN
    REWRITE_TAC [joinpaths] THEN ASM_CASES_TAC (← q r"drop x <= &1 / &2") THENL
     [MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THEN
      EXISTS_TAC (← q r"\x. (g1:real^1->complex)(&2 % x)") THEN
      EXISTS_TAC (← q r"abs(&1 / &2 - drop x)") THEN
      REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB, DROP_CMUL,
                   DROP_ADD, DROP_VEC, LIFT_DROP] THEN
      CONJ_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC],
      MATCH_MP_TAC DIFFERENTIABLE_TRANSFORM_AT THEN
      EXISTS_TAC (← q r"\x. (g2:real^1->complex)(&2 % x - vec 1)") THEN
      EXISTS_TAC (← q r"abs(&1 / &2 - drop x)") THEN
      REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB, DROP_CMUL,
                   DROP_ADD, DROP_VEC, LIFT_DROP] THEN
      CONJ_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC]] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC DIFFERENTIABLE_CHAIN_AT THEN
    SIMP_TAC [DIFFERENTIABLE_CMUL, DIFFERENTIABLE_SUB, DIFFERENTIABLE_CONST,
              DIFFERENTIABLE_ID] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_SUB, IN_DIFF, DROP_VEC, DROP_CMUL] THEN
    ASM_REAL_ARITH_TAC)

  let VALID_PATH_JOIN ← prove
   r"!g1 g2.
        valid_path g1 /\ valid_path g2 /\ pathfinish g1 = pathstart g2
        ==> valid_path(g1 ++ g2)"
   (MESON_TAC [VALID_PATH_JOIN_EQ])

  let VALID_PATH_SYM ← prove
   r"!p q:real^1->complex.
        pathfinish p = pathstart q /\ pathfinish q = pathstart p
        ==> (valid_path(p ++ q) <=> valid_path(q ++ p))"
   (SIMP_TAC [VALID_PATH_JOIN_EQ] THEN CONV_TAC (fun t => TAUT t))

  -- The chain-rule step shared by HAS_PATH_INTEGRAL_JOIN and
  -- PATH_INTEGRABLE_JOIN: the derivative of x |-> 2 % x (- vec 1).
  let affineDerivTac : tactic :=
    TRY (GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_SUB_RZERO] THEN
         MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_SUB THEN
         REWRITE_TAC [HAS_VECTOR_DERIVATIVE_CONST]) THEN
    REWRITE_TAC [has_vector_derivative] THEN
    MATCH_MP_TAC (← MESON [HAS_DERIVATIVE_LINEAR]
     (← q r"f = g /\ linear f ==> (f has_derivative g) net")) THEN
    REWRITE_TAC [linear, FUN_EQ_THM, DROP_VEC] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_CMUL, DROP_VEC] THEN
    REAL_ARITH_TAC

  let HAS_PATH_INTEGRAL_JOIN ← prove
   r"!f g1 g2 i1 i2.
        (f has_path_integral i1) g1 /\
        (f has_path_integral i2) g2 /\
        valid_path g1 /\ valid_path g2
        ==> (f has_path_integral (i1 + i2)) (g1 ++ g2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_PATH_INTEGRAL, CONJ_ASSOC] THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
    DISCH_THEN (CONJUNCTS_THEN
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_AFFINITY))) THEN
    DISCH_THEN (ASSUME_TAC o SPECL [← q r"&2", ← q r"--(vec 1):real^1"]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"&2", ← q r"vec 0:real^1"]) THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [DIMINDEX_1] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [VECTOR_MUL_RNEG, VECTOR_NEG_NEG, VECTOR_MUL_RZERO,
                 VECTOR_ADD_LID, VECTOR_NEG_0, VECTOR_ADD_RID,
                 ← VECTOR_ARITH (← q r"&1 / &2 % x + &1 / &2 % x = x:real^N")] THEN
    REWRITE_TAC [DROP_CMUL, DROP_ADD, DROP_NEG, DROP_VEC, VECTOR_MUL_ASSOC] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x % (a + b) + y % b = x % a + (x + y) % b"),
                 ← VECTOR_ARITH (← q r"x % a + y % (a + b) = (x + y) % a + y % b")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"(&1 - (&2 * x + --(&1))) * inv(&2) = &1 - x"),
                 ← REAL_ARITH (← q r"&1 - x + &2 * x + --(&1) = x"),
                 ← REAL_ARITH (← q r"&1 - &2 * x + (&2 * x) * inv(&2) = &1 - x"),
                 ← REAL_ARITH (← q r"(&2 * x) * inv(&2) = x")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"b - inv(&2) % (a + b) = inv(&2) % (b - a)"),
                 ← VECTOR_ARITH (← q r"inv(&2) % (a + b) - a = inv(&2) % (b - a)")] THEN
    REPEAT (DISCH_THEN (MP_TAC o SPEC (← q r"&2") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
           REWRITE_TAC [COMPLEX_CMUL, ← SIMPLE_COMPLEX_ARITH
            (← q r"Cx(&2) * Cx(&1 / &2) * j = j /\
             Cx(&2) * (a * Cx(inv(&2)) * b) = a * b")] THEN DISCH_TAC) THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN
    EXISTS_TAC (← q r"&1 / &2 % vec 1:real^1") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [DROP_CMUL, DROP_VEC] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    CONJ_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE
     [← TAUT (← q r"a1 /\ a2 /\ b ==> c <=> b ==> a1 /\ a2 ==> c")]
     HAS_INTEGRAL_SPIKE_FINITE)) THENL
     [MP_TAC (← REWRITE_RULE [valid_path] (← ASSUME (← q r"valid_path g1"))),
      MP_TAC (← REWRITE_RULE [valid_path] (← ASSUME (← q r"valid_path g2")))] THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"((&1 / &2) % vec 1) INSERT {x:real^1 | (&2 % x) IN s}"),
      EXISTS_TAC (← q r"((&1 / &2) % vec 1) INSERT
                  {x:real^1 | (&2 % x - vec 1) IN s}")] THEN
    (CONJ_TAC THENL
      [REWRITE_TAC [FINITE_INSERT] THEN MATCH_MP_TAC FINITE_IMAGE_INJ THEN
       ASM_REWRITE_TAC [] THEN VECTOR_ARITH_TAC,
       ALL_TAC]) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FINITE_INSERT, IN_DIFF, IN_INSERT, DE_MORGAN_THM,
                  joinpaths, IN_INTERVAL_1, DROP_VEC, DROP_CMUL, ← GSYM DROP_EQ] THEN
    SIMP_TAC [REAL_LT_IMP_LE, REAL_MUL_RID, IN_ELIM_THM,
              ← REAL_ARITH (← q r"&1 / &2 <= x /\ ~(x = &1 / &2) ==> ~(x <= &1 / &2)")] THEN
    REWRITE_TAC [LIFT_CMUL, LIFT_SUB, LIFT_DROP, LIFT_NUM, ← GSYM VECTOR_SUB] THEN
    X_GEN_TAC (← q r"x:real^1") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
     (← q r"x = Cx(&2) * y ==> g * x = Cx(&2) * g * y"))) THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_AT THENL
     [EXISTS_TAC (← q r"(\x. g1(&2 % x)):real^1->complex"),
      EXISTS_TAC (← q r"(\x. g2(&2 % x - vec 1)):real^1->complex")] THEN
    EXISTS_TAC (← q r"abs(drop x - &1 / &2)") THEN
    REWRITE_TAC [DIST_REAL, ← GSYM drop, ← GSYM REAL_ABS_NZ] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_NE, REAL_SUB_0] THEN
    (CONJ_TAC THENL
      [GEN_TAC THEN COND_CASES_TAC THEN REWRITE_TAC [] THEN
       ASM_REAL_ARITH_TAC,
       ALL_TAC]) THEN
    GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    REWRITE_TAC [← GSYM COMPLEX_CMUL] THEN
    SUBST1_TAC (← SYM (← SPEC (← q r"2") DROP_VEC)) THEN
    MATCH_MP_TAC VECTOR_DIFF_CHAIN_AT THEN
    (CONJ_TAC THENL
      [affineDerivTac,
       REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN
       ASM_SIMP_TAC [IN_DIFF, IN_INTERVAL_1, DROP_SUB, DROP_CMUL, DROP_VEC] THEN
       ASM_REAL_ARITH_TAC]))

  let PATH_INTEGRABLE_JOIN ← prove
   r"!f g1 g2.
        valid_path g1 /\ valid_path g2
        ==> (f path_integrable_on (g1 ++ g2) <=>
             f path_integrable_on g1 /\ f path_integrable_on g2)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [path_integrable_on] THEN
      ASM_MESON_TAC [HAS_PATH_INTEGRAL_JOIN]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [valid_path]) THEN
    REWRITE_TAC [PATH_INTEGRABLE_ON, joinpaths] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL))
    THENL
     [DISCH_THEN (MP_TAC o SPECL [← q r"lift(&0)", ← q r"lift(&1 / &2)"]),
      DISCH_THEN (MP_TAC o SPECL [← q r"lift(&1 / &2)", ← q r"lift(&1)"])] THEN
    REWRITE_TAC [SUBSET_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    DISCH_THEN (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_AFFINITY))
    THENL
     [DISCH_THEN (MP_TAC o SPECL [← q r"&1 / &2", ← q r"vec 0:real^1"]),
      DISCH_THEN (MP_TAC o SPECL [← q r"&1 / &2", ← q r"lift(&1 / &2)"])] THEN
    REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, INTERVAL_EQ_EMPTY_1] THEN
    REWRITE_TAC [LIFT_DROP, LIFT_NUM, VECTOR_MUL_RZERO, VECTOR_NEG_0,
                 ← GSYM LIFT_CMUL, VECTOR_ADD_RID, VECTOR_MUL_RNEG] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [LIFT_NUM] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"vec 2 + --vec 1:real^1 = vec 1"),
                 ← VECTOR_ARITH (← q r"vec 1 + --vec 1:real^1 = vec 0")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&1 / &2") o MATCH_MP INTEGRABLE_CMUL) THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC INTEGRABLE_SPIKE_FINITE THEN
    REWRITE_TAC [IN_DIFF, IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_ADD,
                 LIFT_DROP, COMPLEX_CMUL] THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a * b = Cx(&1 / &2) * x * y <=>
                                  x * y = a * Cx(&2) * b"))]
    THENL
     [UNDISCH_TAC (← q r"(g1:real^1->complex) piecewise_differentiable_on
                          interval[vec 0,vec 1]"),
      UNDISCH_TAC (← q r"(g2:real^1->complex) piecewise_differentiable_on
                          interval[vec 0,vec 1]")] THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(vec 0:real^1) INSERT (vec 1) INSERT s") THEN
    ASM_REWRITE_TAC [FINITE_INSERT, IN_INSERT, DE_MORGAN_THM] THEN
    REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC] THEN X_GEN_TAC (← q r"t:real^1") THEN
    STRIP_TAC THEN BINOP_TAC THENL
     [AP_TERM_TAC THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"x <= &1 ==> &1 / &2 * x <= &1 / &2")] THEN
      AP_TERM_TAC THEN VECTOR_ARITH_TAC,
      ALL_TAC,
      AP_TERM_TAC THEN ASM_SIMP_TAC [← REAL_ARITH
       (← q r"&0 <= t /\ ~(t = &0) ==> ~(&1 / &2 * t + &1 / &2 <= &1 / &2)")] THEN
      AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_SUB, LIFT_DROP] THEN
      REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_AT THENL
     [EXISTS_TAC (← q r"(\x. g1(&2 % x)):real^1->complex") THEN
      EXISTS_TAC (← q r"abs(drop t - &1) / &2") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < abs x / &2 <=> ~(x = &0)"), REAL_SUB_0] THEN
      REWRITE_TAC [DIST_REAL, ← GSYM drop, DROP_CMUL] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [← REAL_ARITH
         (← q r"t <= &1 /\ ~(t = &1) /\ abs(x - &1 / &2 * t) < abs(t - &1) / &2
          ==> x <= &1 / &2")],
        ALL_TAC],
      EXISTS_TAC (← q r"(\x. g2(&2 % x - vec 1)):real^1->complex") THEN
      EXISTS_TAC (← q r"abs(drop t) / &2") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < abs x / &2 <=> ~(x = &0)"), REAL_SUB_0] THEN
      REWRITE_TAC [DIST_REAL, ← GSYM drop, DROP_CMUL, DROP_ADD, LIFT_DROP] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [← REAL_ARITH
         (← q r"&0 <= t /\ abs(x - (&1 / &2 * t + &1 / &2)) < abs(t) / &2
          ==> ~(x <= &1 / &2)")],
        ALL_TAC]] THEN
    GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
    REWRITE_TAC [← GSYM COMPLEX_CMUL] THEN
    SUBST1_TAC (← SYM (← SPEC (← q r"2") DROP_VEC)) THEN
    MATCH_MP_TAC VECTOR_DIFF_CHAIN_AT THEN
    (CONJ_TAC THENL
      [affineDerivTac,
       MATCH_MP_TAC (← MESON [VECTOR_DERIVATIVE_WORKS]
         (← q r"f differentiable (at t) /\ t' = t
          ==> (f has_vector_derivative
                    (vector_derivative f (at t))) (at t')")) THEN
       CONJ_TAC THENL
        [FIRST_X_ASSUM MATCH_MP_TAC THEN
         ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1, DROP_VEC],
         ALL_TAC] THEN
       REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_SUB, LIFT_DROP,
                    DROP_VEC] THEN
       REAL_ARITH_TAC]))

  let PATH_INTEGRAL_JOIN ← prove
   r"!f g1 g2:real^1->complex.
        valid_path g1 /\ valid_path g2 /\
        f path_integrable_on g1 /\ f path_integrable_on g2
        ==> path_integral (g1 ++ g2) f =
            path_integral g1 f + path_integral g2 f"
   (MESON_TAC [PATH_INTEGRAL_UNIQUE, HAS_PATH_INTEGRAL_INTEGRAL,
               HAS_PATH_INTEGRAL_JOIN])

  pure { VALID_PATH_JOIN_EQ, VALID_PATH_JOIN, VALID_PATH_SYM, HAS_PATH_INTEGRAL_JOIN,
         PATH_INTEGRABLE_JOIN, PATH_INTEGRAL_JOIN }
/- ------------------------------------------------------------------------- -/
/- Reparametrizing to shift the starting point of a (closed) path; more      -/
/- about straight-line paths.                                                -/
/- (cauchy.ml 875-1168)                                                     -/
/- ------------------------------------------------------------------------- -/

structure KYE where
  VALID_PATH_SHIFTPATH : thm
  HAS_PATH_INTEGRAL_SHIFTPATH : thm
  HAS_PATH_INTEGRAL_SHIFTPATH_EQ : thm
  PATH_INTEGRAL_SHIFTPATH : thm
  HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN : thm
  HAS_VECTOR_DERIVATIVE_LINEPATH_AT : thm
  VALID_PATH_LINEPATH : thm
  VECTOR_DERIVATIVE_LINEPATH_WITHIN : thm
  VECTOR_DERIVATIVE_LINEPATH_AT : thm
  HAS_PATH_INTEGRAL_LINEPATH : thm
  LINEPATH_IN_PATH : thm
  RE_LINEPATH_CX : thm
  IM_LINEPATH_CX : thm
  LINEPATH_CX : thm
  HAS_PATH_INTEGRAL_TRIVIAL : thm
  PATH_INTEGRAL_TRIVIAL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYE [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) : ExceptT String IO KYE := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, PIECEWISE_DIFFERENTIABLE_AFFINE,
        PIECEWISE_DIFFERENTIABLE_CASES, piecewise_differentiable_on,
        PIECEWISE_DIFFERENTIABLE_ON_SUBSET, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_PATH_INTEGRAL, has_path_integral, path_integral, PATH_INTEGRAL_UNIQUE,
        .. } := BKYC
  let { HAS_VECTOR_DERIVATIVE_ID, HAS_VECTOR_DERIVATIVE_TRANSFORM_AT,
        VECTOR_DERIVATIVE_WITHIN_CLOSED_INTERVAL, VECTOR_DIFF_CHAIN_AT,
        .. } := D.qderivatives
  let { HAS_INTEGRAL_EQ_EQ, HAS_INTEGRAL_SPIKE_FINITE, HAS_INTEGRAL_SPIKE_FINITE_EQ,
        .. } := D.qintegration
  let { SHIFTPATH_SHIFTPATH, .. } := D.qpaths
  let { HAS_INTEGRAL_COMBINE, .. } := D.mt.ra.qintegration
  let { COMPLEX_EQ, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_SYM, COMPLEX_MUL_RZERO, COMPLEX_SUB_REFL, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_VEC_0, IM_ADD, IM_CX, IM_MUL_CX, RE_ADD, RE_CX, RE_MUL_CX,
        .. } := D.mt.ra.ts.cn.cxc
  let { INTEGRABLE_INTEGRAL, .. } := D.mt.ra.ts.cn.qintegration
  let { HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_UNIQUE, INTEGRABLE_SUBINTERVAL,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { differentiable, differentiable_on, HAS_DERIVATIVE_ADD, HAS_DERIVATIVE_CONST,
        HAS_DERIVATIVE_ID, HAS_DERIVATIVE_VMUL_DROP, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_ADD, HAS_VECTOR_DERIVATIVE_CONST, VECTOR_DERIVATIVE_WORKS,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { linepath, shiftpath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { IMAGE_AFFINITY_INTERVAL, OPEN_CLOSED_INTERVAL_1,
        .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, DE_MORGAN_THM, EMPTY_SUBSET, EQ_IMP,
        FINITE_IMAGE, FINITE_INSERT, FINITE_RULES, FINITE_UNION,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_1, REAL_LE_REFL, REAL_LT_01, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_POS, REAL_POW_ONE, REAL_SUB_LE, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, UNWIND_THM2, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, INTERVAL_OPEN_SUBSET_CLOSED,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { dist, drop, VECTOR_ADD_LID, VECTOR_MUL_LID, VECTOR_SUB, VECTOR_SUB_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERVAL, segment, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { WITHIN_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { pathfinish, pathstart, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { FINITE_IMP_CLOSED, OPEN_DIFF, SUBSET_INTERVAL_1,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let VALID_PATH_SHIFTPATH ← prove
   r"!g a. valid_path g /\ pathfinish g = pathstart g /\
         a IN interval[vec 0,vec 1]
         ==> valid_path(shiftpath a g)"
   (REWRITE_TAC [valid_path, shiftpath, DROP_ADD, ← GSYM DROP_VEC] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"a + x <= y <=> x <= y - a"), ← GSYM DROP_SUB] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_CASES THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
      REWRITE_TAC [DROP_SUB, DROP_VEC] THEN REAL_ARITH_TAC,
      ALL_TAC]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
    ASM_REWRITE_TAC [← VECTOR_ARITH (← q r"a + vec 1 - a - vec 1:real^1 = vec 0"),
                     ← VECTOR_ARITH (← q r"a + vec 1 - a:real^1 = vec 1")] THEN
    CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"a + x:real^1 = &1 % x + a")],
      ONCE_REWRITE_TAC [← VECTOR_ARITH
       (← q r"a + x - vec 1:real^1 = &1 % x + (a - vec 1)")]] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_AFFINE THEN
    MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_ON_SUBSET THEN
    EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, REAL_POS, INTERVAL_EQ_EMPTY_1,
                 IN_INTERVAL_1, DROP_SUB, DROP_VEC] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    REWRITE_TAC [EMPTY_SUBSET, SUBSET_INTERVAL_1, DROP_ADD, DROP_CMUL,
                 DROP_SUB, DROP_VEC] THEN
    REAL_ARITH_TAC)

  let HAS_PATH_INTEGRAL_SHIFTPATH ← prove
   r"!f g i a.
        (f has_path_integral i) g /\ valid_path g /\
        a IN interval[vec 0,vec 1]
        ==> (f has_path_integral i) (shiftpath a g)"
   (REWRITE_TAC [HAS_PATH_INTEGRAL, IN_INTERVAL_1, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"i = integral (interval[a,vec 1])
                   (\x. f ((g:real^1->real^2) x) * vector_derivative g (at x)) +
          integral (interval[vec 0,a])
                   (\x. f (g x) * vector_derivative g (at x))")
    SUBST1_TAC THENL
     [MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "M"), (← qty "2", ← qty "N")]
        HAS_INTEGRAL_UNIQUE) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"\x. f ((g:real^1->real^2) x) * vector_derivative g (at x)",
        ← q r"interval[vec 0:real^1,vec 1]"] THEN
      ONCE_REWRITE_TAC [COMPLEX_ADD_SYM] THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN EXISTS_TAC (← q r"a:real^1") THEN
      ASM_REWRITE_TAC [DROP_VEC] THEN
      CONJ_TAC THEN MATCH_MP_TAC INTEGRABLE_INTEGRAL THEN
      MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
      MAP_EVERY EXISTS_TAC [← q r"vec 0:real^1", ← q r"vec 1:real^1"] THEN
      (CONJ_TAC THENL [ASM_MESON_TAC [integrable_on], ALL_TAC]) THEN
      REWRITE_TAC [DROP_SUB, DROP_VEC, SUBSET_INTERVAL_1] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN EXISTS_TAC (← q r"vec 1 - a:real^1") THEN
    ASM_REWRITE_TAC [DROP_SUB, DROP_VEC, REAL_SUB_LE,
                     ← REAL_ARITH (← q r"&1 - x <= &1 <=> &0 <= x")] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [valid_path]) THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [shiftpath] THEN CONJ_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE_FINITE THENL
     [EXISTS_TAC (← q r"\x. f(g(a + x)) * vector_derivative g (at(a + x))") THEN
      EXISTS_TAC (← q r"(vec 1 - a) INSERT IMAGE (\x:real^1. x - a) s") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_INSERT] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [IN_DIFF, IN_INTERVAL_1, IN_INSERT, IN_IMAGE, UNWIND_THM2,
                     DROP_SUB, DROP_ADD, DROP_VEC, DE_MORGAN_THM,
                     ← VECTOR_ARITH (← q r"x:real^1 = y - a <=> y = a + x")] THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_VEC] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"x <= &1 - a ==> a + x <= &1")] THEN
        AP_TERM_TAC THEN MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_AT THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\x. (g:real^1->complex)(a + x)", ← q r"dist(vec 1 - a:real^1,x)"] THEN
        SIMP_TAC [CONJ_ASSOC, dist, NORM_REAL, ← GSYM drop, DROP_VEC, DROP_SUB] THEN
        CONJ_TAC THENL
         [REPEAT STRIP_TAC THEN REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_MUL_LID] THEN
        REWRITE_TAC [← GSYM DROP_VEC] THEN MATCH_MP_TAC VECTOR_DIFF_CHAIN_AT THEN
        SUBST1_TAC (← VECTOR_ARITH (← q r"vec 1:real^1 = vec 0 + vec 1")) THEN
        SIMP_TAC [HAS_VECTOR_DERIVATIVE_ADD, HAS_VECTOR_DERIVATIVE_CONST,
                  HAS_VECTOR_DERIVATIVE_ID] THEN
        REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_DIFF, IN_INTERVAL_1, DROP_VEC, DROP_ADD] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(\x. f (g x) * vector_derivative g (at x)) integrable_on
                    (interval [a,vec 1])")
      MP_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
        MAP_EVERY EXISTS_TAC [← q r"vec 0:real^1", ← q r"vec 1:real^1"] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [integrable_on], ALL_TAC] THEN
        ASM_REWRITE_TAC [DROP_SUB, DROP_VEC, SUBSET_INTERVAL_1, REAL_LE_REFL],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o C CONJ (← REAL_ARITH (← q r"~(&1 = &0)")) o MATCH_MP
        INTEGRABLE_INTEGRAL) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:real^1") o MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
      REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"&1 % x + a:real^1 = a + x")] THEN
      REWRITE_TAC [REAL_INV_1, REAL_POS, REAL_ABS_NUM, REAL_POW_ONE] THEN
      ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC, ← GSYM REAL_NOT_LE] THEN
      REWRITE_TAC [VECTOR_MUL_LID, ← GSYM VECTOR_SUB, VECTOR_SUB_REFL],
      EXISTS_TAC (← q r"\x. f(g(a + x - vec 1)) *
                      vector_derivative g (at(a + x - vec 1))") THEN
      EXISTS_TAC (← q r"(vec 1 - a) INSERT IMAGE (\x:real^1. x - a + vec 1) s") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_INSERT] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"x:real^1") THEN
        REWRITE_TAC [IN_DIFF, IN_INTERVAL_1, IN_INSERT, IN_IMAGE, UNWIND_THM2,
                     DROP_SUB, DROP_ADD, DROP_VEC, DE_MORGAN_THM,
                     ← VECTOR_ARITH (← q r"x:real^1 = y - a + z <=> y = a + (x - z)")] THEN
        REWRITE_TAC [← GSYM DROP_EQ, DROP_ADD, DROP_VEC, DROP_SUB] THEN
        STRIP_TAC THEN
        ASM_SIMP_TAC [← REAL_ARITH
         (← q r"&1 - a <= x /\ ~(x = &1 - a) ==> ~(a + x <= &1)")] THEN
        AP_TERM_TAC THEN MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_AT THEN
        MAP_EVERY EXISTS_TAC
         [← q r"\x. (g:real^1->complex)(a + x - vec 1)",
          ← q r"dist(vec 1 - a:real^1,x)"] THEN
        SIMP_TAC [CONJ_ASSOC, dist, NORM_REAL, ← GSYM drop, DROP_VEC, DROP_SUB] THEN
        CONJ_TAC THENL
         [REPEAT STRIP_TAC THEN REPEAT COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_MUL_LID] THEN
        REWRITE_TAC [← GSYM DROP_VEC] THEN MATCH_MP_TAC VECTOR_DIFF_CHAIN_AT THEN
        CONJ_TAC THENL
         [GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_LID] THEN
          ONCE_REWRITE_TAC [← VECTOR_ARITH
           (← q r"a + x - vec 1:real^1 = (a - vec 1) + x")] THEN
          SIMP_TAC [HAS_VECTOR_DERIVATIVE_ADD, HAS_VECTOR_DERIVATIVE_CONST,
                    HAS_VECTOR_DERIVATIVE_ID],
          ALL_TAC] THEN
        REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [IN_DIFF, DROP_SUB, IN_INTERVAL_1, DROP_VEC, DROP_ADD] THEN
        ASM_REAL_ARITH_TAC,
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(\x. f (g x) * vector_derivative g (at x)) integrable_on
                    (interval [vec 0,a])")
      MP_TAC THENL
       [MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
        MAP_EVERY EXISTS_TAC [← q r"vec 0:real^1", ← q r"vec 1:real^1"] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [integrable_on], ALL_TAC] THEN
        ASM_REWRITE_TAC [DROP_SUB, DROP_VEC, SUBSET_INTERVAL_1, REAL_LE_REFL],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o C CONJ (← REAL_ARITH (← q r"~(&1 = &0)")) o MATCH_MP
        INTEGRABLE_INTEGRAL) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a - vec 1:real^1") o
        MATCH_MP HAS_INTEGRAL_AFFINITY) THEN
      REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
      REWRITE_TAC [← VECTOR_ARITH (← q r"&1 % x + a - vec 1:real^1 = a + x - vec 1")] THEN
      REWRITE_TAC [REAL_INV_1, REAL_POS, REAL_ABS_NUM, REAL_POW_ONE] THEN
      ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC, ← GSYM REAL_NOT_LE] THEN
      REWRITE_TAC [VECTOR_MUL_LID,
                   ← VECTOR_ARITH (← q r"vec 0 + --(a - vec 1):real^1 = vec 1 - a"),
                   ← VECTOR_ARITH (← q r"a + --(a - vec 1):real^1 = vec 1")]])

  let HAS_PATH_INTEGRAL_SHIFTPATH_EQ ← prove
   r"!f g i a.
        valid_path g /\ pathfinish g = pathstart g /\
        a IN interval[vec 0,vec 1]
        ==> ((f has_path_integral i) (shiftpath a g) <=>
             (f has_path_integral i) g)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_SHIFTPATH] THEN
    SUBGOAL_THEN
     (← q r"(f has_path_integral i) (shiftpath (vec 1 - a) (shiftpath a g))")
    MP_TAC THENL
     [MATCH_MP_TAC HAS_PATH_INTEGRAL_SHIFTPATH THEN
      ASM_SIMP_TAC [VALID_PATH_SHIFTPATH] THEN REPEAT (POP_ASSUM MP_TAC) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_SUB] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL] THEN MATCH_MP_TAC EQ_IMP THEN
    MATCH_MP_TAC HAS_INTEGRAL_SPIKE_FINITE_EQ THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [valid_path]) THEN
    REWRITE_TAC [piecewise_differentiable_on] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:real^1->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(s:real^1->bool) UNION {vec 0,vec 1}") THEN
    ASM_SIMP_TAC [FINITE_UNION, FINITE_RULES] THEN
    REWRITE_TAC [← SET_RULE (← q r"s DIFF (t UNION u) = (s DIFF u) DIFF t")] THEN
    REWRITE_TAC [← GSYM OPEN_CLOSED_INTERVAL_1] THEN X_GEN_TAC (← q r"x:real^1") THEN
    STRIP_TAC THEN   BINOP_TAC THEN CONV_TAC SYM_CONV THENL
     [AP_TERM_TAC THEN MATCH_MP_TAC SHIFTPATH_SHIFTPATH THEN ASM_SIMP_TAC [] THEN
      ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET, IN_DIFF],
      ALL_TAC] THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_TRANSFORM_WITHIN_OPEN THEN
    MAP_EVERY EXISTS_TAC
     [← q r"g:real^1->real^2", ← q r"interval(vec 0,vec 1) DIFF s:real^1->bool"] THEN
    ASM_SIMP_TAC [← GSYM VECTOR_DERIVATIVE_WORKS, OPEN_DIFF, FINITE_IMP_CLOSED,
                  OPEN_INTERVAL] THEN
    REPEAT STRIP_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC SHIFTPATH_SHIFTPATH,
      FIRST_X_ASSUM MATCH_MP_TAC] THEN
    ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET, IN_DIFF])

  let PATH_INTEGRAL_SHIFTPATH ← prove
   r"!f g a. valid_path g /\ pathfinish g = pathstart g /\
           a IN interval[vec 0,vec 1]
           ==> path_integral (shiftpath a g) f = path_integral g f"
   (SIMP_TAC [path_integral, HAS_PATH_INTEGRAL_SHIFTPATH_EQ])

  -- More about straight-line paths.

  let HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN ← prove
   r"!a b:complex x s.
    (linepath(a,b) has_vector_derivative (b - a)) (at x within s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [linepath, has_vector_derivative] THEN
    ONCE_REWRITE_TAC [← VECTOR_ARITH (← q r"u % (b - a) = vec 0 + u % (b - a)")] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"(&1 - u) % a + u % b = a + u % (b - a)")] THEN
    MATCH_MP_TAC HAS_DERIVATIVE_ADD THEN REWRITE_TAC [HAS_DERIVATIVE_CONST] THEN
    MATCH_MP_TAC HAS_DERIVATIVE_VMUL_DROP THEN REWRITE_TAC [HAS_DERIVATIVE_ID])

  let HAS_VECTOR_DERIVATIVE_LINEPATH_AT ← prove
   r"!a b:complex x.
    (linepath(a,b) has_vector_derivative (b - a)) (at x)"
   (MESON_TAC [WITHIN_UNIV, HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN])

  let VALID_PATH_LINEPATH ← prove
   r"!a b. valid_path(linepath(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [valid_path] THEN
    MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
    REWRITE_TAC [differentiable_on, differentiable] THEN
    MESON_TAC [HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN, has_vector_derivative])

  let VECTOR_DERIVATIVE_LINEPATH_WITHIN ← prove
   r"!a b x. x IN interval[vec 0,vec 1]
           ==> vector_derivative (linepath(a,b))
                (at x within interval[vec 0,vec 1]) = b - a"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_WITHIN_CLOSED_INTERVAL THEN
    ASM_REWRITE_TAC [HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN] THEN
    REWRITE_TAC [DROP_VEC, REAL_LT_01])

  let VECTOR_DERIVATIVE_LINEPATH_AT ← prove
   r"!a b x. vector_derivative (linepath(a,b)) (at x) = b - a"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    ASM_REWRITE_TAC [HAS_VECTOR_DERIVATIVE_LINEPATH_AT])

  let HAS_PATH_INTEGRAL_LINEPATH ← prove
   r"!f i a b. (f has_path_integral i) (linepath(a,b)) <=>
             ((\x. f(linepath(a,b) x) * (b - a)) has_integral i)
             (interval[vec 0,vec 1])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_path_integral] THEN
    MATCH_MP_TAC HAS_INTEGRAL_EQ_EQ THEN
    SIMP_TAC [VECTOR_DERIVATIVE_LINEPATH_WITHIN])

  let LINEPATH_IN_PATH ← prove
   r"!x. x IN interval[vec 0,vec 1] ==> linepath(a,b) x IN segment[a,b]"
   (REWRITE_TAC [segment, linepath, IN_ELIM_THM, IN_INTERVAL_1, DROP_VEC] THEN
    MESON_TAC [])

  let RE_LINEPATH_CX ← prove
   r"!a b x. Re(linepath(Cx a,Cx b) x) = (&1 - drop x) * a + drop x * b"
   (REWRITE_TAC [linepath, RE_ADD, COMPLEX_CMUL, RE_MUL_CX, RE_CX])

  let IM_LINEPATH_CX ← prove
   r"!a b x. Im(linepath(Cx a,Cx b) x) = &0"
   (REWRITE_TAC [linepath, IM_ADD, COMPLEX_CMUL, IM_MUL_CX, IM_CX] THEN
    REAL_ARITH_TAC)

  let LINEPATH_CX ← prove
   r"!a b x. linepath(Cx a,Cx b) x = Cx((&1 - drop x) * a + drop x * b)"
   (REWRITE_TAC [COMPLEX_EQ, RE_LINEPATH_CX, IM_LINEPATH_CX, RE_CX, IM_CX])

  let HAS_PATH_INTEGRAL_TRIVIAL ← prove
   r"!f a. (f has_path_integral (Cx(&0))) (linepath(a,a))"
   (REWRITE_TAC [HAS_PATH_INTEGRAL_LINEPATH, COMPLEX_SUB_REFL,
                 COMPLEX_MUL_RZERO] THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0, HAS_INTEGRAL_0])

  let PATH_INTEGRAL_TRIVIAL ← prove
   r"!f a. path_integral (linepath(a,a)) f = Cx(&0)"
   (MESON_TAC [HAS_PATH_INTEGRAL_TRIVIAL, PATH_INTEGRAL_UNIQUE])

  pure { VALID_PATH_SHIFTPATH, HAS_PATH_INTEGRAL_SHIFTPATH, HAS_PATH_INTEGRAL_SHIFTPATH_EQ,
         PATH_INTEGRAL_SHIFTPATH, HAS_VECTOR_DERIVATIVE_LINEPATH_WITHIN,
         HAS_VECTOR_DERIVATIVE_LINEPATH_AT, VALID_PATH_LINEPATH,
         VECTOR_DERIVATIVE_LINEPATH_WITHIN, VECTOR_DERIVATIVE_LINEPATH_AT,
         HAS_PATH_INTEGRAL_LINEPATH, LINEPATH_IN_PATH, RE_LINEPATH_CX, IM_LINEPATH_CX,
         LINEPATH_CX, HAS_PATH_INTEGRAL_TRIVIAL, PATH_INTEGRAL_TRIVIAL }
/- ------------------------------------------------------------------------- -/
/- Relation to subpath construction; segments via convex hulls; Cauchy's     -/
/- theorem where there's a primitive.                                        -/
/- (cauchy.ml 1169-1499)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYF where
  VALID_PATH_SUBPATH : thm
  HAS_PATH_INTEGRAL_SUBPATH_REFL : thm
  PATH_INTEGRABLE_SUBPATH_REFL : thm
  PATH_INTEGRAL_SUBPATH_REFL : thm
  HAS_PATH_INTEGRAL_SUBPATH : thm
  PATH_INTEGRABLE_SUBPATH : thm
  HAS_INTEGRAL_PATH_INTEGRAL_SUBPATH : thm
  PATH_INTEGRAL_SUBPATH_INTEGRAL : thm
  PATH_INTEGRAL_SUBPATH_COMBINE : thm
  PATH_INTEGRAL_INTEGRAL : thm
  SEGMENTS_SUBSET_CONVEX_HULL : thm
  POINTS_IN_CONVEX_HULL : thm
  CONVEX_HULL_SUBSET : thm
  NOT_IN_INTERIOR_CONVEX_HULL_3 : thm
  PATH_INTEGRAL_PRIMITIVE_LEMMA : thm
  PATH_INTEGRAL_PRIMITIVE : thm
  CAUCHY_THEOREM_PRIMITIVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYF [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) : ExceptT String IO KYF := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, PIECEWISE_DIFFERENTIABLE_COMPOSE,
        piecewise_differentiable_on, PIECEWISE_DIFFERENTIABLE_ON_SUBSET, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_PATH_INTEGRAL, has_path_integral, path_integrable_on, PATH_INTEGRABLE_ON,
        PATH_INTEGRABLE_REVERSEPATH, path_integral, PATH_INTEGRAL_REVERSEPATH,
        PATH_INTEGRAL_UNIQUE, VALID_PATH_REVERSEPATH, .. } := BKYC
  let { DIFFERENTIABLE_CMUL, DIFFERENTIABLE_ID, DIFFERENTIABLE_ON_CONST,
        HAS_VECTOR_DERIVATIVE_CMUL, HAS_VECTOR_DERIVATIVE_ID, VECTOR_DERIVATIVE_CONST_AT,
        VECTOR_DIFF_CHAIN_AT, .. } := D.qderivatives
  let { HAS_INTEGRAL_SPIKE_FINITE, .. } := D.qintegration
  let { FINITE_IMAGE_INJ, .. } := D.qsession
  let { NOT_IN_INTERIOR_CONVEX_HULL, .. } := D.qconvex
  let { DIFFERENTIABLE_ADD, DIFFERENTIABLE_CONST, .. } := D.mt.ra.qderivatives
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG, .. } := D.mt.ra.qintegration
  let { has_complex_derivative, HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET, holomorphic_on,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.kne
  let { DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON, .. } := D.mt.ra.ts.qderivatives
  let { COMPLEX_MUL_AC, COMPLEX_MUL_RZERO, COMPLEX_SUB_REFL, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { DIFFERENTIABLE_AT_WITHIN, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_CMUL,
        HAS_INTEGRAL_INTEGRABLE_INTEGRAL, HAS_INTEGRAL_INTEGRAL, INTEGRABLE_ON_SUBINTERVAL,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, integral, INTEGRAL_COMBINE, INTEGRAL_REFL,
        .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_TAC, VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.mt.ra.ts.cn.cx.cpx
  let { DIFF_CHAIN_WITHIN, HAS_DERIVATIVE_WITHIN_OPEN, HAS_DERIVATIVE_WITHIN_SUBSET,
        has_vector_derivative, HAS_VECTOR_DERIVATIVE_ADD, HAS_VECTOR_DERIVATIVE_CONST,
        VECTOR_DERIVATIVE_WORKS, .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { PATH_SUBPATH, REVERSEPATH_SUBPATH, subpath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { IMAGE_AFFINITY_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { LIFT_EQ_CMUL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { CARD_CLAUSES, DIMINDEX_1, DIMINDEX_2, EMPTY_SUBSET, FINITE_EMPTY, FINITE_INSERT,
        FINITE_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, IN_SING, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_INV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_RADD,
        REAL_LE_TRANS, REAL_LT_IMP_LE, REAL_LT_LE, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LT, REAL_POS, REAL_SUB_LE, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_abs, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_MINIMAL, HULL_MONO, HULL_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_EQ, DROP_SUB, DROP_VEC, INTERVAL_OPEN_SUBSET_CLOSED,
        LIFT_DROP, LIFT_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { VECTOR_ADD_SYM, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO,
        VECTOR_MUL_RZERO, VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_image, pathfinish, pathstart, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { FINITE_IMP_COUNTABLE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcard
  let { CONVEX_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let VALID_PATH_SUBPATH ← prove
   r"!g u v. valid_path g /\
           u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1]
           ==> valid_path(subpath u v g)"
   (SIMP_TAC [valid_path, PATH_SUBPATH] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [subpath] THEN
    ASM_CASES_TAC (← q r"v:real^1 = u") THENL
     [MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_MUL_LZERO, DROP_VEC] THEN
      REWRITE_TAC [DIFFERENTIABLE_ON_CONST],
      MATCH_MP_TAC (← REWRITE_RULE [o_DEF] PIECEWISE_DIFFERENTIABLE_COMPOSE) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
        MATCH_MP_TAC DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC DIFFERENTIABLE_ADD THEN
        REWRITE_TAC [DIFFERENTIABLE_CONST] THEN
        MATCH_MP_TAC DIFFERENTIABLE_CMUL THEN REWRITE_TAC [DIFFERENTIABLE_ID],
        MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN ASM_REWRITE_TAC [] THEN
        ONCE_REWRITE_TAC [VECTOR_ADD_SYM] THEN
        REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
        REPEAT (COND_CASES_TAC THEN REWRITE_TAC [EMPTY_SUBSET]) THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
        SIMP_TAC [SUBSET_INTERVAL_1, DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC] THEN
        REAL_ARITH_TAC,
        REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_ADD, DROP_SUB] THEN
        ASM_SIMP_TAC [DROP_EQ, ← REAL_FIELD (← q r"~(u:real = v) ==>
          (u + (v - u) * x = b <=> x = (b - u) / (v - u))")] THEN
        X_GEN_TAC (← q r"b:real^1") THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{lift((drop b - drop u) / (drop v - drop u))}") THEN
        REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, SUBSET, IN_ELIM_THM] THEN
        SIMP_TAC [← GSYM LIFT_EQ, LIFT_DROP, IN_SING]]])

  let HAS_PATH_INTEGRAL_SUBPATH_REFL ← prove
   r"!f g u. (f has_path_integral (Cx(&0))) (subpath u u g)"
   (REWRITE_TAC [HAS_PATH_INTEGRAL, subpath, VECTOR_SUB_REFL] THEN
    REWRITE_TAC [DROP_VEC, VECTOR_MUL_LZERO, VECTOR_DERIVATIVE_CONST_AT] THEN
    REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_MUL_RZERO] THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0, HAS_INTEGRAL_0])

  let PATH_INTEGRABLE_SUBPATH_REFL ← prove
   r"!f g u. f path_integrable_on (subpath u u g)"
   (REWRITE_TAC [path_integrable_on] THEN
    MESON_TAC [HAS_PATH_INTEGRAL_SUBPATH_REFL])

  let PATH_INTEGRAL_SUBPATH_REFL ← prove
   r"!f g u. path_integral (subpath u u g) f = Cx(&0)"
   (MESON_TAC [PATH_INTEGRAL_UNIQUE, HAS_PATH_INTEGRAL_SUBPATH_REFL])

  let HAS_PATH_INTEGRAL_SUBPATH ← prove
   r"!f g u v.
        valid_path g /\ f path_integrable_on g /\
        u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
        drop u <= drop v
        ==> (f has_path_integral
             integral (interval[u,v])
                      (\x. f(g x) * vector_derivative g (at x)))
            (subpath u v g)"
   (REWRITE_TAC [path_integrable_on, HAS_PATH_INTEGRAL, subpath] THEN
    REWRITE_TAC [← GSYM integrable_on] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"v:real^1 = u") THENL
     [ASM_REWRITE_TAC [INTEGRAL_REFL, VECTOR_SUB_REFL, DROP_VEC] THEN
      REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_DERIVATIVE_CONST_AT] THEN
      REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_MUL_RZERO] THEN
      REWRITE_TAC [← GSYM COMPLEX_VEC_0, HAS_INTEGRAL_0],
      SUBGOAL_THEN (← q r"drop u < drop v") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [REAL_LT_LE, DROP_EQ], ALL_TAC]] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:real^1", ← q r"v:real^1"] o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] INTEGRABLE_ON_SUBINTERVAL)) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1, REAL_LT_IMP_LE],
      REWRITE_TAC [HAS_INTEGRAL_INTEGRAL]] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"drop(v - u)", ← q r"u:real^1"] o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_AFFINITY)) THEN
    ASM_SIMP_TAC [DROP_SUB, ← REAL_ARITH (← q r"u < v ==> ~(v - u = &0)")] THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL, INTERVAL_EQ_EMPTY_1, DROP_SUB] THEN
    ASM_SIMP_TAC [REAL_LE_INV_EQ, ← REAL_ARITH (← q r"u < v ==> ~(v < u) /\ &0 <= v - u"),
                  ← VECTOR_ARITH (← q r"a % u + --(a % v):real^N = a % (u - v)")] THEN
    REWRITE_TAC [VECTOR_SUB_REFL, VECTOR_MUL_RZERO] THEN
    SUBGOAL_THEN (← q r"inv(drop v - drop u) % (v - u) = vec 1") SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM DROP_EQ, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
      UNDISCH_TAC (← q r"drop u < drop v") THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"drop(v - u)") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
    ASM_SIMP_TAC [real_abs, REAL_LT_IMP_LE, REAL_SUB_LE] THEN
    REWRITE_TAC [DIMINDEX_1, REAL_POW_1, VECTOR_MUL_ASSOC, DROP_SUB] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q r"u < v ==> (v - u) * inv(v - u) = &1")] THEN
    REWRITE_TAC [VECTOR_MUL_LID] THEN
    MATCH_MP_TAC (← REWRITE_RULE [← TAUT (← q r"a /\ b /\ c ==> d <=> a /\ b ==> c ==> d")]
      HAS_INTEGRAL_SPIKE_FINITE) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [valid_path]) THEN
    REWRITE_TAC [piecewise_differentiable_on, IN_DIFF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:real^1->bool") STRIP_ASSUME_TAC o CONJUNCT2) THEN
    EXISTS_TAC (← q r"{t | ((drop v - drop u) % t + u) IN k}") THEN CONJ_TAC THENL
     [MATCH_MP_TAC FINITE_IMAGE_INJ THEN
      ASM_REWRITE_TAC [← GSYM DROP_EQ, DROP_CMUL, DROP_SUB, DROP_ADD] THEN
      UNDISCH_TAC (← q r"drop u < drop v") THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN REWRITE_TAC [COMPLEX_CMUL] THEN
    ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a * b * c:complex = b * a * c"))] THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"x + a % y:real^N = a % y + x")] THEN
    AP_TERM_TAC THEN REWRITE_TAC [← GSYM COMPLEX_CMUL, ← GSYM DROP_SUB] THEN
    MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
    MATCH_MP_TAC (← REWRITE_RULE [o_DEF] VECTOR_DIFF_CHAIN_AT) THEN
    REWRITE_TAC [DROP_SUB] THEN CONJ_TAC THENL
     [SUBST1_TAC (← VECTOR_ARITH (← q r"v - u:real^1 = (v - u) + vec 0")) THEN
      MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_ADD THEN
      REWRITE_TAC [HAS_VECTOR_DERIVATIVE_CONST] THEN
      SUBST1_TAC (← MESON [LIFT_DROP, LIFT_EQ_CMUL]
       (← q r"v - u = drop(v - u) % vec 1")) THEN REWRITE_TAC [← GSYM DROP_SUB] THEN
      MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_CMUL THEN
      REWRITE_TAC [HAS_VECTOR_DERIVATIVE_ID],
      REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INTERVAL_1] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1])) THEN
      REWRITE_TAC [DROP_ADD, DROP_SUB, DROP_CMUL, DROP_VEC] THEN
      REPEAT STRIP_TAC THENL
       [MATCH_MP_TAC REAL_LE_ADD THEN CONJ_TAC THEN
        TRY (MATCH_MP_TAC REAL_LE_MUL) THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"(drop v - drop u) * &1 + drop u") THEN
        ASM_SIMP_TAC [REAL_LE_RADD, REAL_LE_LMUL,
                      REAL_SUB_LE, REAL_LT_IMP_LE] THEN
        ASM_REAL_ARITH_TAC]])

  let PATH_INTEGRABLE_SUBPATH ← prove
   r"!f g u v.
        valid_path g /\ f path_integrable_on g /\
        u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1]
        ==> f path_integrable_on (subpath u v g)"
   (REPEAT STRIP_TAC THEN DISJ_CASES_TAC (← REAL_ARITH
     (← q r"drop u <= drop v \/ drop v <= drop u"))
    THENL
     [ASM_MESON_TAC [path_integrable_on, HAS_PATH_INTEGRAL_SUBPATH],
      ONCE_REWRITE_TAC [← GSYM REVERSEPATH_SUBPATH] THEN
      MATCH_MP_TAC PATH_INTEGRABLE_REVERSEPATH THEN
      ASM_SIMP_TAC [VALID_PATH_SUBPATH] THEN
      ASM_MESON_TAC [path_integrable_on, HAS_PATH_INTEGRAL_SUBPATH]])

  let HAS_INTEGRAL_PATH_INTEGRAL_SUBPATH ← prove
   r"!f g u v.
        valid_path g /\ f path_integrable_on g /\
        u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
        drop u <= drop v
        ==> (((\x. f(g x) * vector_derivative g (at x))) has_integral
             path_integral (subpath u v g) f)
            (interval[u,v])"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [HAS_INTEGRAL_INTEGRABLE_INTEGRAL] THEN CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
      EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
      ASM_REWRITE_TAC [← GSYM PATH_INTEGRABLE_ON, SUBSET_INTERVAL_1] THEN
      ASM_MESON_TAC [IN_INTERVAL_1],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
      ASM_SIMP_TAC [HAS_PATH_INTEGRAL_SUBPATH]])

  let PATH_INTEGRAL_SUBPATH_INTEGRAL ← prove
   r"!f g u v.
        valid_path g /\ f path_integrable_on g /\
        u IN interval[vec 0,vec 1] /\ v IN interval[vec 0,vec 1] /\
        drop u <= drop v
        ==> path_integral (subpath u v g) f =
            integral (interval[u,v])
                     (\x. f(g x) * vector_derivative g (at x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_SUBPATH])

  let PATH_INTEGRAL_SUBPATH_COMBINE ← prove
   r"!f g u v w.
        valid_path g /\ f path_integrable_on g /\
        u IN interval[vec 0,vec 1] /\
        v IN interval[vec 0,vec 1] /\
        w IN interval[vec 0,vec 1]
        ==> path_integral (subpath u v g) f + path_integral (subpath v w g) f =
            path_integral (subpath u w g) f"
   (REPLICATE_TAC 3 GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"!u v w.
          drop u <= drop v /\ drop v <= drop w
          ==> valid_path g /\ f path_integrable_on g /\
              u IN interval[vec 0,vec 1] /\
              v IN interval[vec 0,vec 1] /\
              w IN interval[vec 0,vec 1]
              ==> path_integral (subpath u v g) f +
                  path_integral (subpath v w g) f =
                  path_integral (subpath u w g) f")
    ASSUME_TAC THENL
     [ALL_TAC,
      REPEAT STRIP_TAC THEN REPEAT_TCL DISJ_CASES_THEN ASSUME_TAC
       (← REAL_ARITH (← q r"drop u <= drop v /\ drop v <= drop w \/
                    drop u <= drop w /\ drop w <= drop v \/
                    drop v <= drop u /\ drop u <= drop w \/
                    drop v <= drop w /\ drop w <= drop u \/
                    drop w <= drop u /\ drop u <= drop v \/
                    drop w <= drop v /\ drop v <= drop u")) THEN
      FIRST_ASSUM (ANTE_RES_THEN MP_TAC) THEN ASM_REWRITE_TAC [] THEN
      REPEAT_TCL CONJUNCTS_THEN SUBST1_TAC (← MESON [REVERSEPATH_SUBPATH]
       (← q r"subpath v u (g:real^1->complex) = reversepath(subpath u v g) /\
        subpath w u g = reversepath(subpath u w g) /\
        subpath w v g = reversepath(subpath v w g)")) THEN
      ASM_SIMP_TAC [PATH_INTEGRAL_REVERSEPATH, PATH_INTEGRABLE_SUBPATH,
                    VALID_PATH_REVERSEPATH, VALID_PATH_SUBPATH] THEN
      CONV_TAC COMPLEX_RING] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"drop u <= drop w") ASSUME_TAC THENL
     [ASM_REAL_ARITH_TAC, STRIP_TAC] THEN
    ASM_SIMP_TAC [PATH_INTEGRAL_SUBPATH_INTEGRAL] THEN
    MATCH_MP_TAC INTEGRAL_COMBINE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC INTEGRABLE_ON_SUBINTERVAL THEN
    EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
    ASM_REWRITE_TAC [← GSYM PATH_INTEGRABLE_ON, SUBSET_INTERVAL_1] THEN
    ASM_MESON_TAC [IN_INTERVAL_1])

  let PATH_INTEGRAL_INTEGRAL ← prove
   r"!f g. path_integral g f =
         integral (interval [vec 0,vec 1])
                  (\x. f (g x) * vector_derivative g (at x))"
   (REWRITE_TAC [path_integral, integral, HAS_PATH_INTEGRAL])

  -- Easier to reason about segments via convex hulls.

  let SEGMENTS_SUBSET_CONVEX_HULL ← prove
   r"!a b c. segment[a,b] SUBSET (convex hull {a,b,c}) /\
           segment[a,c] SUBSET (convex hull {a,b,c}) /\
           segment[b,c] SUBSET (convex hull {a,b,c}) /\
           segment[b,a] SUBSET (convex hull {a,b,c}) /\
           segment[c,a] SUBSET (convex hull {a,b,c}) /\
           segment[c,b] SUBSET (convex hull {a,b,c})"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
    MATCH_MP_TAC HULL_MONO THEN SET_TAC [])

  let POINTS_IN_CONVEX_HULL ← prove
   r"!x s. x IN s ==> x IN convex hull s"
   (MESON_TAC [SUBSET, HULL_SUBSET])

  let CONVEX_HULL_SUBSET ← prove
   r"(!x. x IN s ==> x IN convex hull t)
   ==> (convex hull s) SUBSET (convex hull t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HULL_MINIMAL THEN
    ASM_REWRITE_TAC [CONVEX_CONVEX_HULL, SUBSET])

  let NOT_IN_INTERIOR_CONVEX_HULL_3 ← prove
   r"!a b c:complex. ~(a IN interior(convex hull {a,b,c})) /\
                   ~(b IN interior(convex hull {a,b,c})) /\
                   ~(c IN interior(convex hull {a,b,c}))"
   (REPEAT GEN_TAC THEN REPEAT CONJ_TAC THEN
    MATCH_MP_TAC NOT_IN_INTERIOR_CONVEX_HULL THEN
    ASM_SIMP_TAC [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, IN_INSERT] THEN
    REWRITE_TAC [DIMINDEX_2] THEN ARITH_TAC)

  -- Cauchy's theorem where there's a primitive.

  let PATH_INTEGRAL_PRIMITIVE_LEMMA ← prove
   r"!f f' g a b s.
        ~(interval[a,b] = {}) /\
        (!x. x IN s ==> (f has_complex_derivative f'(x)) (at x within s)) /\
        g piecewise_differentiable_on interval[a,b] /\
        (!x. x IN interval[a,b] ==> g(x) IN s)
        ==> ((\x. f'(g x) * vector_derivative g (at x within interval[a,b]))
             has_integral (f(g b) - f(g a))) (interval[a,b])"
   (REPEAT GEN_TAC THEN REWRITE_TAC [valid_path, piecewise_differentiable_on] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY_1, REAL_NOT_LT] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"k:real^1->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS_INTERIOR_STRONG THEN
    EXISTS_TAC (← q r"k:real^1->bool") THEN ASM_REWRITE_TAC [DROP_VEC, REAL_POS] THEN
    ASM_SIMP_TAC [FINITE_IMP_COUNTABLE, ← GSYM o_DEF] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      MATCH_MP_TAC HOLOMORPHIC_ON_IMP_CONTINUOUS_ON THEN
      ASM_MESON_TAC [holomorphic_on],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [has_vector_derivative, COMPLEX_CMUL] THEN
    SUBGOAL_THEN (← q r"(f has_complex_derivative f'(g x))
                  (at (g x) within (IMAGE g (interval[a:real^1,b])))")
    MP_TAC THENL
     [MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET, IN_DIFF],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"(g:real^1->complex) differentiable (at x within interval[a,b])")
    MP_TAC THENL
     [MATCH_MP_TAC DIFFERENTIABLE_AT_WITHIN THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [INTERVAL_OPEN_SUBSET_CLOSED, SUBSET, IN_DIFF],
      ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [VECTOR_DERIVATIVE_WORKS] THEN
    REWRITE_TAC [has_vector_derivative, IMP_IMP, has_complex_derivative] THEN
    DISCH_THEN (MP_TAC o MATCH_MP DIFF_CHAIN_WITHIN) THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
      HAS_DERIVATIVE_WITHIN_SUBSET)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"interval(a:real^1,b)")) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_DIFF]) THEN
    ASM_SIMP_TAC [INTERVAL_OPEN_SUBSET_CLOSED, OPEN_INTERVAL,
                  HAS_DERIVATIVE_WITHIN_OPEN] THEN
    REWRITE_TAC [o_DEF, COMPLEX_CMUL] THEN REWRITE_TAC [COMPLEX_MUL_AC])

  let PATH_INTEGRAL_PRIMITIVE ← prove
   r"!f f' g s.
        (!x. x IN s ==> (f has_complex_derivative f'(x)) (at x within s)) /\
        valid_path g /\ (path_image g) SUBSET s
        ==> (f' has_path_integral (f(pathfinish g) - f(pathstart g))) (g)"
   (REWRITE_TAC [valid_path, path_image, pathfinish, pathstart] THEN
    REWRITE_TAC [has_path_integral] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_PRIMITIVE_LEMMA THEN
    ASM_REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC, REAL_POS, REAL_NOT_LT] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_MESON_TAC [])

  let CAUCHY_THEOREM_PRIMITIVE ← prove
   r"!f f' g s.
        (!x. x IN s ==> (f has_complex_derivative f'(x)) (at x within s)) /\
        valid_path g /\ (path_image g) SUBSET s /\
        pathfinish g = pathstart g
        ==> (f' has_path_integral Cx(&0)) (g)"
   (MESON_TAC [PATH_INTEGRAL_PRIMITIVE, COMPLEX_SUB_REFL])

  pure { VALID_PATH_SUBPATH, HAS_PATH_INTEGRAL_SUBPATH_REFL, PATH_INTEGRABLE_SUBPATH_REFL,
         PATH_INTEGRAL_SUBPATH_REFL, HAS_PATH_INTEGRAL_SUBPATH, PATH_INTEGRABLE_SUBPATH,
         HAS_INTEGRAL_PATH_INTEGRAL_SUBPATH, PATH_INTEGRAL_SUBPATH_INTEGRAL,
         PATH_INTEGRAL_SUBPATH_COMBINE, PATH_INTEGRAL_INTEGRAL,
         SEGMENTS_SUBSET_CONVEX_HULL, POINTS_IN_CONVEX_HULL, CONVEX_HULL_SUBSET,
         NOT_IN_INTERIOR_CONVEX_HULL_3, PATH_INTEGRAL_PRIMITIVE_LEMMA,
         PATH_INTEGRAL_PRIMITIVE, CAUCHY_THEOREM_PRIMITIVE }
/- ------------------------------------------------------------------------- -/
/- Existence of path integral for continuous function; arithmetical          -/
/- combining theorems, relational and not; integrability; reversal.          -/
/- (cauchy.ml 1500-1816)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYG where
  PATH_INTEGRABLE_CONTINUOUS_LINEPATH : thm
  HAS_PATH_INTEGRAL_CONST_LINEPATH : thm
  HAS_PATH_INTEGRAL_NEG : thm
  HAS_PATH_INTEGRAL_ADD : thm
  HAS_PATH_INTEGRAL_SUB : thm
  HAS_PATH_INTEGRAL_COMPLEX_LMUL : thm
  HAS_PATH_INTEGRAL_COMPLEX_RMUL : thm
  HAS_PATH_INTEGRAL_COMPLEX_DIV : thm
  HAS_PATH_INTEGRAL_EQ : thm
  HAS_PATH_INTEGRAL_BOUND_LINEPATH : thm
  HAS_PATH_INTEGRAL_BOUND_LINEPATH_STRONG : thm
  HAS_PATH_INTEGRAL_0 : thm
  HAS_PATH_INTEGRAL_IS_0 : thm
  HAS_PATH_INTEGRAL_VSUM : thm
  PATH_INTEGRAL_CONST_LINEPATH : thm
  PATH_INTEGRAL_NEG : thm
  PATH_INTEGRAL_ADD : thm
  PATH_INTEGRAL_SUB : thm
  PATH_INTEGRAL_COMPLEX_LMUL : thm
  PATH_INTEGRAL_COMPLEX_RMUL : thm
  PATH_INTEGRAL_COMPLEX_DIV : thm
  PATH_INTEGRAL_EQ : thm
  PATH_INTEGRAL_EQ_0 : thm
  PATH_INTEGRAL_BOUND_LINEPATH : thm
  PATH_INTEGRAL_0 : thm
  PATH_INTEGRAL_VSUM : thm
  PATH_INTEGRABLE_EQ : thm
  PATH_INTEGRABLE_NEG : thm
  PATH_INTEGRABLE_ADD : thm
  PATH_INTEGRABLE_SUB : thm
  PATH_INTEGRABLE_COMPLEX_LMUL : thm
  PATH_INTEGRABLE_COMPLEX_RMUL : thm
  PATH_INTEGRABLE_COMPLEX_DIV : thm
  PATH_INTEGRABLE_VSUM : thm
  HAS_PATH_INTEGRAL_REVERSE_LINEPATH : thm
  PATH_INTEGRAL_REVERSE_LINEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYG [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYE : KYE) : ExceptT String IO KYG := do
  -- @@SCOPE BEGIN
  let { has_path_integral, HAS_PATH_INTEGRAL_INTEGRAL, HAS_PATH_INTEGRAL_REVERSEPATH,
        HAS_PATH_INTEGRAL_UNIQUE, path_integrable_on, path_integral, PATH_INTEGRAL_UNIQUE,
        .. } := BKYC
  let { HAS_PATH_INTEGRAL_LINEPATH, HAS_PATH_INTEGRAL_TRIVIAL, VALID_PATH_LINEPATH,
        VECTOR_DERIVATIVE_LINEPATH_WITHIN, .. } := BKYE
  let { CONTENT_UNIT_1, .. } := D.qintegration
  let { FINITE_FINITE_PREIMAGE_GENERAL, .. } := D.qsession
  let { CONTINUOUS_ON_LINEPATH, REVERSEPATH_LINEPATH, .. } := D.qpaths
  let { HAS_INTEGRAL_BOUND, HAS_INTEGRAL_NEG, .. } := D.mt.ra.qintegration
  let { CONTINUOUS_ON_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { HAS_INTEGRAL_COMPLEX_LMUL, .. } := D.mt.ra.ts.kno
  let { complex_div, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_RDISTRIB, COMPLEX_MUL_ASSOC, COMPLEX_MUL_LNEG, COMPLEX_MUL_LZERO,
        COMPLEX_MUL_SYM, COMPLEX_SUB_RDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_NORM_0, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { CONTENT_UNIT, .. } := D.mt.ra.ts.cn.ms.qintegration1
  let { HAS_INTEGRAL_0, HAS_INTEGRAL_ADD, HAS_INTEGRAL_CONST, HAS_INTEGRAL_EQ,
        HAS_INTEGRAL_SPIKE_EQ, HAS_INTEGRAL_SUB, INTEGRABLE_CONTINUOUS,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, NEGLIGIBLE_FINITE, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { EQ_IMP, ETA_AX, FINITE_INDUCT_STRONG, FINITE_SING, FINITE_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_MUL, REAL_LE_REFL, REAL_LE_RMUL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RZERO, REAL_SUB_0, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_EQ, NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_EQ_0, VECTOR_MUL_LID, VECTOR_SUB_EQ, VECTOR_SUB_REFL, VSUM_CLAUSES,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { SEGMENT_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_image, PATH_IMAGE_LINEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  -- @@SCOPE END

  let PATH_INTEGRABLE_CONTINUOUS_LINEPATH ← prove
   r"!f a b. f continuous_on segment[a,b]
           ==> f path_integrable_on (linepath(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_integrable_on, has_path_integral] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM integrable_on] THEN MATCH_MP_TAC INTEGRABLE_CONTINUOUS THEN
    MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
    EXISTS_TAC (← q r"\x. f(linepath(a,b) x) * (b - a)") THEN
    SIMP_TAC [VECTOR_DERIVATIVE_LINEPATH_WITHIN] THEN
    ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_LMUL THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
    ASM_REWRITE_TAC [← GSYM path_image, ETA_AX, PATH_IMAGE_LINEPATH] THEN
    REWRITE_TAC [CONTINUOUS_ON_LINEPATH])

  -- Arithmetical combining theorems.

  let HAS_PATH_INTEGRAL_CONST_LINEPATH ← prove
   r"!a b c. ((\x. c) has_path_integral (c * (b - a))) (linepath(a,b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HAS_PATH_INTEGRAL_LINEPATH] THEN
    MP_TAC (← ISPECL [← q r"vec 0:real^1", ← q r"vec 1:real^1", ← q r"c * (b - a):complex"]
           HAS_INTEGRAL_CONST) THEN
    REWRITE_TAC [CONTENT_UNIT, VECTOR_MUL_LID])

  let HAS_PATH_INTEGRAL_NEG ← prove
   r"!f i g. (f has_path_integral i) g
           ==> ((\x. --(f x)) has_path_integral (--i)) g"
   (REWRITE_TAC [has_path_integral, COMPLEX_MUL_LNEG, HAS_INTEGRAL_NEG])

  let HAS_PATH_INTEGRAL_ADD ← prove
   r"!f1 i1 f2 i2 g.
        (f1 has_path_integral i1) g /\ (f2 has_path_integral i2) g
        ==> ((\x. f1(x) + f2(x)) has_path_integral (i1 + i2)) g"
   (REWRITE_TAC [has_path_integral, COMPLEX_ADD_RDISTRIB] THEN
    SIMP_TAC [HAS_INTEGRAL_ADD])

  let HAS_PATH_INTEGRAL_SUB ← prove
   r"!f1 i1 f2 i2 g.
        (f1 has_path_integral i1) g /\ (f2 has_path_integral i2) g
         ==> ((\x. f1(x) - f2(x)) has_path_integral (i1 - i2)) g"
   (REWRITE_TAC [has_path_integral, COMPLEX_SUB_RDISTRIB] THEN
    SIMP_TAC [HAS_INTEGRAL_SUB])

  let HAS_PATH_INTEGRAL_COMPLEX_LMUL ← prove
   r"!f g i c. (f has_path_integral i) g
             ==> ((\x. c * f x) has_path_integral (c * i)) g"
   (REWRITE_TAC [has_path_integral, HAS_INTEGRAL_COMPLEX_LMUL,
                 ← GSYM COMPLEX_MUL_ASSOC])

  let HAS_PATH_INTEGRAL_COMPLEX_RMUL ← prove
   r"!f g i c. (f has_path_integral i) g
             ==> ((\x. f x * c) has_path_integral (i * c)) g"
   (ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL_COMPLEX_LMUL])

  let HAS_PATH_INTEGRAL_COMPLEX_DIV ← prove
   r"!f g i c. (f has_path_integral i) g
             ==> ((\x. f x / c) has_path_integral (i / c)) g"
   (REWRITE_TAC [complex_div, HAS_PATH_INTEGRAL_COMPLEX_RMUL])

  let HAS_PATH_INTEGRAL_EQ ← prove
   r"!f g p y.
        (!x. x IN path_image p ==> f x = g x) /\
        (f has_path_integral y) p
        ==> (g has_path_integral y) p"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_image, IN_IMAGE, has_path_integral, IMP_CONJ] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_EQ) THEN
    ASM_SIMP_TAC [] THEN ASM_MESON_TAC [])

  let HAS_PATH_INTEGRAL_BOUND_LINEPATH ← prove
   r"!f i a b B.
        (f has_path_integral i) (linepath(a,b)) /\
        &0 <= B /\ (!x. x IN segment[a,b] ==> norm(f x) <= B)
        ==> norm(i) <= B * norm(b - a)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [has_path_integral] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
    REWRITE_TAC [← GSYM CONTENT_UNIT_1] THEN MATCH_MP_TAC HAS_INTEGRAL_BOUND THEN
    EXISTS_TAC (← q r"\x. f (linepath (a,b) x) *
                      vector_derivative (linepath (a,b))
                         (at x within interval [vec 0,vec 1])") THEN
    ASM_SIMP_TAC [REAL_LE_MUL, NORM_POS_LE,
                  VECTOR_DERIVATIVE_LINEPATH_WITHIN] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLEX_NORM_MUL] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [← GSYM PATH_IMAGE_LINEPATH, path_image] THEN
    ASM SET_TAC [])

  let HAS_PATH_INTEGRAL_BOUND_LINEPATH_STRONG ← prove
   r"!f i a b B k.
        FINITE k /\
        (f has_path_integral i) (linepath(a,b)) /\
        &0 <= B /\ (!x. x IN segment[a,b] DIFF k ==> norm(f x) <= B)
        ==> norm(i) <= B * norm(b - a)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"b:complex = a") THENL
     [ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0, REAL_MUL_RZERO] THEN
      STRIP_TAC THEN SUBGOAL_THEN (← q r"i = Cx(&0)")
        (fun th => REWRITE_TAC [th, COMPLEX_NORM_0, REAL_LE_REFL]) THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_UNIQUE THEN
      ASM_MESON_TAC [HAS_PATH_INTEGRAL_TRIVIAL],
      STRIP_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
      EXISTS_TAC (← q r"\x. if x IN k then Cx(&0) else (f:complex->complex) x") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ALL_TAC, ASM SET_TAC [COMPLEX_NORM_0]] THEN
      UNDISCH_TAC (← q r"(f has_path_integral i) (linepath (a,b))") THEN
      MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [has_path_integral] THEN
      MATCH_MP_TAC HAS_INTEGRAL_SPIKE_EQ THEN
      EXISTS_TAC (← q r"{t | t IN interval[vec 0,vec 1] /\
                       linepath(a:complex,b) t IN k}") THEN
      CONJ_TAC THENL [MATCH_MP_TAC NEGLIGIBLE_FINITE, SET_TAC []] THEN
      MATCH_MP_TAC FINITE_FINITE_PREIMAGE_GENERAL THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"c:complex") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← MESON [FINITE_SING, FINITE_SUBSET]
       (← q r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"(!a b. a IN s /\ b IN s ==> a = b) ==> (?a. s SUBSET {a})")) THEN
      MAP_EVERY X_GEN_TAC [← q r"s:real^1", ← q r"t:real^1"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SYM) THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [linepath, ← VECTOR_ARITH
       (← q r"(&1 - s) % a + s % b:real^N = (&1 - t) % a + t % b <=>
        (s - t) % (b - a) = vec 0")] THEN
      ASM_REWRITE_TAC [VECTOR_MUL_EQ_0, VECTOR_SUB_EQ, REAL_SUB_0] THEN
      REWRITE_TAC [DROP_EQ]])

  let HAS_PATH_INTEGRAL_0 ← prove
   r"!g. ((\x. Cx(&0)) has_path_integral Cx(&0)) g"
   (REWRITE_TAC [has_path_integral, COMPLEX_MUL_LZERO] THEN
    REWRITE_TAC [← GSYM COMPLEX_VEC_0, HAS_INTEGRAL_0])

  let HAS_PATH_INTEGRAL_IS_0 ← prove
   r"!f g. (!z. z IN path_image g ==> f(z) = Cx(&0))
         ==> (f has_path_integral Cx(&0)) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_EQ THEN
    EXISTS_TAC (← q r"\z:complex. Cx(&0)") THEN
    ASM_REWRITE_TAC [HAS_PATH_INTEGRAL_0] THEN ASM_MESON_TAC [])

  let HAS_PATH_INTEGRAL_VSUM ← prove
   r"!f p s. FINITE s /\ (!a. a IN s ==> (f a has_path_integral i a) p)
           ==> ((\x. vsum s (\a. f a x)) has_path_integral vsum s i) p"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [VSUM_CLAUSES, HAS_PATH_INTEGRAL_0, COMPLEX_VEC_0, IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_ADD THEN
    ASM_REWRITE_TAC [ETA_AX] THEN CONJ_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [])

  -- Same thing non-relationally.

  let PATH_INTEGRAL_CONST_LINEPATH ← prove
   r"!a b c. path_integral (linepath(a,b)) (\x. c) = c * (b - a)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL_CONST_LINEPATH])

  let PATH_INTEGRAL_NEG ← prove
   r"!f g. f path_integrable_on g
         ==> path_integral g (\x. --(f x)) = --(path_integral g f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_NEG THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_ADD ← prove
   r"!f1 f2 g.
        f1 path_integrable_on g /\ f2 path_integrable_on g
        ==> path_integral g (\x. f1(x) + f2(x)) =
                path_integral g f1 + path_integral g f2"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_ADD THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_SUB ← prove
   r"!f1 f2 g.
        f1 path_integrable_on g /\ f2 path_integrable_on g
        ==> path_integral g (\x. f1(x) - f2(x)) =
                path_integral g f1 - path_integral g f2"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_SUB THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_COMPLEX_LMUL ← prove
   r"!f g c.  f path_integrable_on g
           ==> path_integral g (\x. c * f x) = c * path_integral g f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_COMPLEX_LMUL THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_COMPLEX_RMUL ← prove
   r"!f g c.  f path_integrable_on g
           ==> path_integral g (\x. f x * c) = path_integral g f * c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_COMPLEX_RMUL THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_COMPLEX_DIV ← prove
   r"!f g c.  f path_integrable_on g
           ==> path_integral g (\x. f x / c) = path_integral g f / c"
   (REWRITE_TAC [complex_div, PATH_INTEGRAL_COMPLEX_RMUL])

  let PATH_INTEGRAL_EQ ← prove
   r"!f g p.
        (!x. x IN path_image p ==> f x = g x)
        ==> path_integral p f = path_integral p g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [path_integral] THEN
    AP_TERM_TAC THEN REWRITE_TAC [FUN_EQ_THM] THEN
    ASM_MESON_TAC [HAS_PATH_INTEGRAL_EQ])

  let PATH_INTEGRAL_EQ_0 ← prove
   r"!f g. (!z. z IN path_image g ==> f(z) = Cx(&0))
         ==> path_integral g f = Cx(&0)"
   (MESON_TAC [HAS_PATH_INTEGRAL_IS_0, PATH_INTEGRAL_UNIQUE])

  let PATH_INTEGRAL_BOUND_LINEPATH ← prove
   r"!f a b.
        f path_integrable_on (linepath(a,b)) /\
        &0 <= B /\ (!x. x IN segment[a,b] ==> norm(f x) <= B)
        ==> norm(path_integral (linepath(a,b)) f) <= B * norm(b - a)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
    EXISTS_TAC (← q r"f:complex->complex") THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRAL_0 ← prove
   r"!g. path_integral g (\x. Cx(&0)) = Cx(&0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL_0])

  let PATH_INTEGRAL_VSUM ← prove
   r"!f p s. FINITE s /\ (!a. a IN s ==> (f a) path_integrable_on p)
           ==> path_integral p (\x. vsum s (\a. f a x)) =
                vsum s (\a. path_integral p (f a))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_VSUM THEN
    ASM_SIMP_TAC [HAS_PATH_INTEGRAL_INTEGRAL])

  let PATH_INTEGRABLE_EQ ← prove
   r"!f g p. (!x. x IN path_image p ==> f x = g x) /\ f path_integrable_on p
           ==> g path_integrable_on p"
   (REWRITE_TAC [path_integrable_on] THEN MESON_TAC [HAS_PATH_INTEGRAL_EQ])

  -- Arithmetic theorems for path integrability.

  let PATH_INTEGRABLE_NEG ← prove
   r"!f g. f path_integrable_on g
           ==> (\x. --(f x)) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN MESON_TAC [HAS_PATH_INTEGRAL_NEG])

  let PATH_INTEGRABLE_ADD ← prove
   r"!f1 f2 g.
        f1 path_integrable_on g /\ f2 path_integrable_on g
        ==> (\x. f1(x) + f2(x)) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN MESON_TAC [HAS_PATH_INTEGRAL_ADD])

  let PATH_INTEGRABLE_SUB ← prove
   r"!f1 f2 g.
        f1 path_integrable_on g /\ f2 path_integrable_on g
        ==> (\x. f1(x) - f2(x)) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN MESON_TAC [HAS_PATH_INTEGRAL_SUB])

  let PATH_INTEGRABLE_COMPLEX_LMUL ← prove
   r"!f g c. f path_integrable_on g
             ==> (\x. c * f x) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN
    MESON_TAC [HAS_PATH_INTEGRAL_COMPLEX_LMUL])

  let PATH_INTEGRABLE_COMPLEX_RMUL ← prove
   r"!f g c. f path_integrable_on g
             ==> (\x. f x * c) path_integrable_on g"
   (ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
    REWRITE_TAC [PATH_INTEGRABLE_COMPLEX_LMUL])

  let PATH_INTEGRABLE_COMPLEX_DIV ← prove
   r"!f g c. f path_integrable_on g
             ==> (\x. f x / c) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN
    MESON_TAC [HAS_PATH_INTEGRAL_COMPLEX_DIV])

  let PATH_INTEGRABLE_VSUM ← prove
   r"!f g s. FINITE s /\ (!a. a IN s ==> f a path_integrable_on g)
           ==> (\x. vsum s (\a. f a x)) path_integrable_on g"
   (REWRITE_TAC [path_integrable_on] THEN
    MESON_TAC [HAS_PATH_INTEGRAL_VSUM])

  -- Considering a path integral "backwards".

  let HAS_PATH_INTEGRAL_REVERSE_LINEPATH ← prove
   r"!f a b i.
        (f has_path_integral i) (linepath(a,b))
        ==> (f has_path_integral (--i)) (linepath(b,a))"
   (MESON_TAC [REVERSEPATH_LINEPATH, VALID_PATH_LINEPATH,
               HAS_PATH_INTEGRAL_REVERSEPATH])

  let PATH_INTEGRAL_REVERSE_LINEPATH ← prove
   r"!f a b.
        f continuous_on (segment[a,b])
        ==> path_integral(linepath(a,b)) f =
            --(path_integral(linepath(b,a)) f)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_REVERSE_LINEPATH THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
    MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
    ASM_MESON_TAC [SEGMENT_SYM])

  pure { PATH_INTEGRABLE_CONTINUOUS_LINEPATH, HAS_PATH_INTEGRAL_CONST_LINEPATH,
         HAS_PATH_INTEGRAL_NEG, HAS_PATH_INTEGRAL_ADD, HAS_PATH_INTEGRAL_SUB,
         HAS_PATH_INTEGRAL_COMPLEX_LMUL, HAS_PATH_INTEGRAL_COMPLEX_RMUL,
         HAS_PATH_INTEGRAL_COMPLEX_DIV, HAS_PATH_INTEGRAL_EQ,
         HAS_PATH_INTEGRAL_BOUND_LINEPATH, HAS_PATH_INTEGRAL_BOUND_LINEPATH_STRONG,
         HAS_PATH_INTEGRAL_0, HAS_PATH_INTEGRAL_IS_0, HAS_PATH_INTEGRAL_VSUM,
         PATH_INTEGRAL_CONST_LINEPATH, PATH_INTEGRAL_NEG, PATH_INTEGRAL_ADD,
         PATH_INTEGRAL_SUB, PATH_INTEGRAL_COMPLEX_LMUL, PATH_INTEGRAL_COMPLEX_RMUL,
         PATH_INTEGRAL_COMPLEX_DIV, PATH_INTEGRAL_EQ, PATH_INTEGRAL_EQ_0,
         PATH_INTEGRAL_BOUND_LINEPATH, PATH_INTEGRAL_0, PATH_INTEGRAL_VSUM,
         PATH_INTEGRABLE_EQ, PATH_INTEGRABLE_NEG, PATH_INTEGRABLE_ADD,
         PATH_INTEGRABLE_SUB, PATH_INTEGRABLE_COMPLEX_LMUL,
         PATH_INTEGRABLE_COMPLEX_RMUL, PATH_INTEGRABLE_COMPLEX_DIV,
         PATH_INTEGRABLE_VSUM, HAS_PATH_INTEGRAL_REVERSE_LINEPATH,
         PATH_INTEGRAL_REVERSE_LINEPATH }
/- ------------------------------------------------------------------------- -/
/- Splitting a path integral in a flat way; midpoints; special case lemmas;  -/
/- reversing the order in a double path integral.                            -/
/- (cauchy.ml 1817-2118)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYH where
  HAS_PATH_INTEGRAL_SPLIT : thm
  PATH_INTEGRAL_SPLIT : thm
  PATH_INTEGRAL_SPLIT_LINEPATH : thm
  HAS_PATH_INTEGRAL_MIDPOINT : thm
  PATH_INTEGRAL_MIDPOINT : thm
  TRIANGLE_LINEAR_HAS_CHAIN_INTEGRAL : thm
  HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL : thm
  PATH_INTEGRAL_SWAP : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYH [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) : ExceptT String IO KYH := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_PATH_INTEGRAL_INTEGRABLE, HAS_PATH_INTEGRAL_INTEGRAL, PATH_INTEGRABLE_ON,
        PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { HAS_PATH_INTEGRAL_JOIN, PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { HAS_PATH_INTEGRAL_LINEPATH, HAS_PATH_INTEGRAL_TRIVIAL, VALID_PATH_LINEPATH,
        .. } := BKYE
  let { CAUCHY_THEOREM_PRIMITIVE, CONVEX_HULL_SUBSET, PATH_INTEGRAL_INTEGRAL,
        POINTS_IN_CONVEX_HULL, .. } := BKYF
  let { PATH_INTEGRABLE_CONTINUOUS_LINEPATH, PATH_INTEGRAL_COMPLEX_RMUL, .. } := BKYG
  let { INTEGRAL_SWAP_CONTINUOUS, .. } := D.qmeasure
  let { HAS_INTEGRAL_COMBINE, .. } := D.mt.ra.qintegration
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_ADD_LID, COMPLEX_ADD_RID, COMPLEX_MUL_AC, COMPLEX_MUL_LID,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, CX_MUL, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { HAS_INTEGRAL_AFFINITY, HAS_INTEGRAL_CMUL, INTEGRABLE_CONTINUOUS,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { INTEGRAL_EQ, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, NUM_REDUCE_CONV, REAL_ARITH, REAL_FIELD, REAL_RAT_REDUCE_CONV,
        SET_RULE, VECTOR_ARITH, VECTOR_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_POW_1, .. } := D.mt.ra.ts.cn.cx.cpx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { IMAGE_AFFINITY_INTERVAL, PCROSS_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { DIMINDEX_1, EQ_TRANS, FORALL_IN_GSPEC, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_PASTECART, FSTCART_PASTECART, FUN_IN_IMAGE, IMP_CONJ,
        IMP_IMP, IN_ELIM_PASTECART_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, MONO_EXISTS, NOT_IN_EMPTY, PCROSS, REAL_ABS_INV,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_EQ_0, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_SUB_0, REAL_SUB_LE, SIMPLE_IMAGE,
        SNDCART_PASTECART, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_ADD, DROP_CMUL, DROP_VEC, LINEAR_FSTCART, LINEAR_SNDCART,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { midpoint, VECTOR_ADD_LID, VECTOR_ADD_RID, VECTOR_MUL_ASSOC, VECTOR_MUL_LID,
        VECTOR_MUL_LNEG, VECTOR_MUL_LZERO, VECTOR_MUL_RZERO, VECTOR_NEG_NEG, VECTOR_SUB_EQ,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_SEGMENT, INTERVAL_EQ_EMPTY_1, LINEAR_CONTINUOUS_ON,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { REAL_INV_INV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { path, path_image, PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHSTART_JOIN,
        PATHSTART_LINEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONTINUOUS_ON_PASTECART, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { DROP_NEG, VECTOR_NEG_0, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qvec
  let { CONVEX_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { IN_CONVEX_SET, SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let HAS_PATH_INTEGRAL_SPLIT ← prove
   r"!f a b c i j k.
        &0 <= k /\ k <= &1 /\ c - a = k % (b - a) /\
        (f has_path_integral i) (linepath(a,c)) /\
        (f has_path_integral j) (linepath(c,b))
        ==> (f has_path_integral (i + j)) (linepath(a,b))"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_CASES_TAC (← q r"k = &0") THENL
     [ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_SUB_EQ] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [HAS_PATH_INTEGRAL_TRIVIAL, PATH_INTEGRAL_UNIQUE,
                     COMPLEX_ADD_LID],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"k = &1") THEN ASM_REWRITE_TAC [VECTOR_MUL_LID] THENL
     [REWRITE_TAC [← VECTOR_ARITH (← q r"c - a = b - a <=> c = b:real^N")] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [HAS_PATH_INTEGRAL_TRIVIAL, PATH_INTEGRAL_UNIQUE,
                     COMPLEX_ADD_RID],
      ALL_TAC] THEN
    REWRITE_TAC [HAS_PATH_INTEGRAL_LINEPATH] THEN
    REWRITE_TAC [linepath] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN
     (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] HAS_INTEGRAL_AFFINITY))) THEN
    DISCH_THEN (ASSUME_TAC o SPECL
      [← q r"inv(&1 - k):real", ← q r"--(k / (&1 - k)) % vec 1:real^1"]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"inv(k):real", ← q r"vec 0:real^1"]) THEN
    POP_ASSUM MP_TAC THEN ASM_REWRITE_TAC [REAL_INV_EQ_0, REAL_SUB_0] THEN
    REWRITE_TAC [REAL_INV_INV, DIMINDEX_1, REAL_POW_1, REAL_ABS_INV] THEN
    REWRITE_TAC [IMAGE_AFFINITY_INTERVAL] THEN
    REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN
    ASM_REWRITE_TAC [REAL_SUB_LE, ← REAL_ARITH (← q r"~(&1 < &0)")] THEN
    REWRITE_TAC [VECTOR_MUL_RZERO, VECTOR_NEG_0, VECTOR_ADD_RID] THEN
    REWRITE_TAC [VECTOR_MUL_ASSOC, VECTOR_MUL_LNEG] THEN
    ASM_SIMP_TAC [← REAL_FIELD
      (← q r"~(k = &1) ==> (&1 - k) * --(k / (&1 - k)) = --k")] THEN
    REWRITE_TAC [VECTOR_ADD_LID, VECTOR_MUL_LNEG, VECTOR_NEG_NEG,
                 ← VECTOR_ARITH (← q r"(&1 - k) % x + k % x:real^1 = x")] THEN
    REWRITE_TAC [DROP_ADD, DROP_CMUL, DROP_NEG, DROP_VEC, REAL_MUL_RID] THEN
    FIRST_X_ASSUM (SUBST1_TAC o MATCH_MP (← VECTOR_ARITH
      (← q r"c - a = x ==> c = x + a"))) THEN
    REWRITE_TAC [← VECTOR_ARITH (← q r"b - (k % (b - a) + a) = (&1 - k) % (b - a)")] THEN
    SUBGOAL_THEN
     (← q r"!x. (&1 - (inv (&1 - k) * drop x + --(k / (&1 - k)))) % (k % (b - a) + a) +
          (inv (&1 - k) * drop x + --(k / (&1 - k))) % b =
          (&1 - drop x) % a + drop x % b")
     (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"x % (k % (b - a) + a) + y % b =
        (x * (&1 - k)) % a + (y + x * k) % b")] THEN
      GEN_TAC THEN BINOP_TAC THEN BINOP_TAC THEN REWRITE_TAC [] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. (&1 - inv k * drop x) % a + (inv k * drop x) % (k % (b - a) + a) =
          (&1 - drop x) % a + drop x % b")
     (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [← VECTOR_ARITH
       (← q r"x % a + y % (k % (b - a) + a) =
        (x + y * (&1 - k)) % a + (y * k) % b")] THEN
      GEN_TAC THEN BINOP_TAC THEN BINOP_TAC THEN REWRITE_TAC [] THEN
      REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(k:real)") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"inv(&1 - k)") o MATCH_MP HAS_INTEGRAL_CMUL) THEN
    ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= k ==> abs k = k"),
                  ← REAL_ARITH (← q r"k <= &1 ==> abs(&1 - k) = &1 - k")] THEN
    ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_MUL_LINV, REAL_SUB_0] THEN
    REWRITE_TAC [IMP_IMP, VECTOR_MUL_LID] THEN
    REWRITE_TAC [COMPLEX_CMUL] THEN
    ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"Cx(inv a) * b * Cx(a) * c = (Cx(inv a) * Cx a) * b * c"))] THEN
    ASM_SIMP_TAC [← GSYM CX_MUL, REAL_MUL_LINV, REAL_SUB_0, COMPLEX_MUL_LID] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC HAS_INTEGRAL_COMBINE THEN EXISTS_TAC (← q r"k % vec 1:real^1") THEN
    ASM_REWRITE_TAC [DROP_CMUL, DROP_VEC, REAL_MUL_RID])

  let PATH_INTEGRAL_SPLIT ← prove
   r"!f a b c k.
        &0 <= k /\ k <= &1 /\ c - a = k % (b - a) /\
        f continuous_on (segment[a,b])
        ==> path_integral(linepath(a,b)) f =
            path_integral(linepath(a,c)) f +
            path_integral(linepath(c,b)) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_SPLIT THEN
    MAP_EVERY EXISTS_TAC [← q r"c:complex", ← q r"k:real"] THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
    MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
    MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"segment[a:complex,b]") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
    REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [POINTS_IN_CONVEX_HULL, IN_INSERT] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← VECTOR_ARITH
     (← q r"c - a = k % (b - a) ==> c = (&1 - k) % a + k % b"))) THEN
    MATCH_MP_TAC IN_CONVEX_SET THEN
    ASM_SIMP_TAC [CONVEX_CONVEX_HULL, POINTS_IN_CONVEX_HULL, IN_INSERT])

  let PATH_INTEGRAL_SPLIT_LINEPATH ← prove
   r"!f a b c.
        f continuous_on segment[a,b] /\ c IN segment[a,b]
        ==> path_integral(linepath (a,b)) f =
            path_integral(linepath (a,c)) f +
            path_integral(linepath (c,b)) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_SPLIT THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_SEGMENT]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    VECTOR_ARITH_TAC)

  -- The special case of midpoints used in the main quadrisection.

  let HAS_PATH_INTEGRAL_MIDPOINT ← prove
   r"!f a b i j.
        (f has_path_integral i) (linepath(a,midpoint(a,b))) /\
        (f has_path_integral j) (linepath(midpoint(a,b),b))
        ==> (f has_path_integral (i + j)) (linepath(a,b))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_SPLIT THEN
    MAP_EVERY EXISTS_TAC [← q r"midpoint(a:complex,b)", ← q r"&1 / &2"] THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [midpoint] THEN VECTOR_ARITH_TAC)

  let PATH_INTEGRAL_MIDPOINT ← prove
   r"!f a b.
        f continuous_on (segment[a,b])
        ==> path_integral(linepath(a,b)) f =
            path_integral(linepath(a,midpoint(a,b))) f +
            path_integral(linepath(midpoint(a,b),b)) f"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_SPLIT THEN
    EXISTS_TAC (← q r"&1 / &2") THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [midpoint] THEN VECTOR_ARITH_TAC)

  -- A couple of special case lemmas that are useful below.

  let TRIANGLE_LINEAR_HAS_CHAIN_INTEGRAL ← prove
   r"!a b c m d. ((\x. m * x + d) has_path_integral Cx(&0))
         (linepath(a,b) ++ linepath(b,c) ++ linepath(c,a))"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_PRIMITIVE THEN
    MAP_EVERY EXISTS_TAC [← q r"\x. m / Cx(&2) * x pow 2 + d * x", ← q r"(:complex)"] THEN
    SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH, SUBSET_UNIV,
              PATHFINISH_LINEPATH, VALID_PATH_JOIN, VALID_PATH_LINEPATH] THEN
    REPEAT STRIP_TAC THEN COMPLEX_DIFF_TAC THEN CONV_TAC NUM_REDUCE_CONV THEN
    CONV_TAC COMPLEX_RING)

  let HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL ← prove
   r"!f i a b c d.
        (f has_path_integral i)
        (linepath(a,b) ++ linepath(b,c) ++ linepath(c,d))
        ==> path_integral (linepath(a,b)) f +
            path_integral (linepath(b,c)) f +
            path_integral (linepath(c,d)) f = i"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP PATH_INTEGRAL_UNIQUE) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_INTEGRABLE) THEN
    SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_LINEPATH, VALID_PATH_JOIN,
              PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH,
              PATHFINISH_LINEPATH] THEN
    STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
    REPEAT (MATCH_MP_TAC HAS_PATH_INTEGRAL_JOIN THEN
           SIMP_TAC [VALID_PATH_LINEPATH, VALID_PATH_JOIN,
                     PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH,
                     PATHFINISH_LINEPATH] THEN
           CONJ_TAC) THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN ASM_REWRITE_TAC [])

  -- Reversing the order in a double path integral. The condition is
  -- stronger than needed but it's often true in typical situations.

  let PATH_INTEGRAL_SWAP ← prove
   r"!f g h.
    (\y. f (fstcart y) (sndcart y)) continuous_on
    (path_image g PCROSS path_image h) /\
    valid_path g /\ valid_path h /\
    (\t. vector_derivative g (at t)) continuous_on interval[vec 0,vec 1] /\
    (\t. vector_derivative h (at t)) continuous_on interval[vec 0,vec 1]
    ==> path_integral g (\w. path_integral h (f w)) =
        path_integral h (\z. path_integral g (\w. f w z))"
   (REWRITE_TAC [PCROSS] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [PATH_INTEGRAL_INTEGRAL] THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC
     (← q r"integral (interval[vec 0,vec 1])
               (\x. path_integral h
                      (\y. f (g x) y * vector_derivative g (at x)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_EQ THEN X_GEN_TAC (← q r"x:real^1") THEN
      DISCH_TAC THEN REWRITE_TAC [] THEN
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC PATH_INTEGRAL_COMPLEX_RMUL THEN
      REWRITE_TAC [PATH_INTEGRABLE_ON] THEN
      MATCH_MP_TAC INTEGRABLE_CONTINUOUS THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"(\t:real^1. (f:complex->complex->complex) (g x) (h t)) =
        (\y. f (fstcart y) (sndcart y)) o
        (\t. pastecart (g(x:real^1)) (h t))")
      SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART],
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_CONST, ← GSYM path, VALID_PATH_IMP_PATH],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM] THEN
        ASM_SIMP_TAC [path_image, FUN_IN_IMAGE]],
      ALL_TAC] THEN
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
     (← q r"integral (interval[vec 0,vec 1])
               (\y. path_integral g
                      (\x. f x (h y) * vector_derivative h (at y)))") THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC INTEGRAL_EQ THEN X_GEN_TAC (← q r"y:real^1") THEN
      DISCH_TAC THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC PATH_INTEGRAL_COMPLEX_RMUL THEN
      REWRITE_TAC [PATH_INTEGRABLE_ON] THEN
      MATCH_MP_TAC INTEGRABLE_CONTINUOUS THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"(\t:real^1. (f:complex->complex->complex) (g t) (h y)) =
        (\z. f (fstcart z) (sndcart z)) o
        (\t. pastecart (g t) (h(y:real^1)))")
      SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART],
        ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_CONST, ← GSYM path, VALID_PATH_IMP_PATH],
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           CONTINUOUS_ON_SUBSET)) THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM] THEN
        ASM_SIMP_TAC [path_image, FUN_IN_IMAGE]]] THEN
    REWRITE_TAC [PATH_INTEGRAL_INTEGRAL] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
       INTEGRAL_SWAP_CONTINUOUS o lhs o snd) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (fun th => GEN_REWRITE_TAC LAND_CONV [th]) THEN
      REPEAT (MATCH_MP_TAC INTEGRAL_EQ THEN
             REWRITE_TAC [] THEN REPEAT STRIP_TAC) THEN
      REWRITE_TAC [COMPLEX_MUL_AC]] THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN CONJ_TAC) THENL
     [ALL_TAC,
      SUBGOAL_THEN
       (← q r"(\z:real^(1,1)finite_sum. vector_derivative g (at (fstcart z))) =
        (\t. vector_derivative (g:real^1->complex) (at t)) o fstcart")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM, PCROSS,
                FORALL_PASTECART, ← GSYM PCROSS_INTERVAL, FSTCART_PASTECART],
      SUBGOAL_THEN
       (← q r"(\z:real^(1,1)finite_sum. vector_derivative h (at (sndcart z))) =
        (\t. vector_derivative (h:real^1->complex) (at t)) o sndcart")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_SNDCART] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM, PCROSS,
            FORALL_PASTECART, ← GSYM PCROSS_INTERVAL, SNDCART_PASTECART]] THEN
    SUBGOAL_THEN
     (← q r"(\z. f (g (fstcart z)) (h (sndcart z))) =
      (\y. (f:complex->complex->complex) (fstcart y) (sndcart y)) o
      (\p. pastecart (g(fstcart p:real^1)) (h(sndcart p:real^1)))")
    SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, FSTCART_PASTECART, SNDCART_PASTECART], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_PASTECART THEN
      CONJ_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [LINEAR_CONTINUOUS_ON, LINEAR_FSTCART, LINEAR_SNDCART] THEN
      REWRITE_TAC [← GSYM PCROSS_INTERVAL, PCROSS, ← GSYM SIMPLE_IMAGE] THEN
      REWRITE_TAC [FSTCART_PASTECART, SNDCART_PASTECART,
                   ← SET_RULE (← q r"{f x | x IN {g a b | P a /\ Q b}} =
                             {f(g a b) | P a /\ Q b}")] THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o REWRITE_RULE [path] o
          MATCH_MP VALID_PATH_IMP_PATH)) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
      SIMP_TAC [SUBSET, FORALL_IN_GSPEC],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PASTECART_THM,
                   FORALL_PASTECART, ← GSYM PCROSS_INTERVAL, PCROSS,
                   path_image, FSTCART_PASTECART, SNDCART_PASTECART] THEN
      SIMP_TAC [FUN_IN_IMAGE]])

  pure { HAS_PATH_INTEGRAL_SPLIT, PATH_INTEGRAL_SPLIT, PATH_INTEGRAL_SPLIT_LINEPATH,
         HAS_PATH_INTEGRAL_MIDPOINT, PATH_INTEGRAL_MIDPOINT,
         TRIANGLE_LINEAR_HAS_CHAIN_INTEGRAL, HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL,
         PATH_INTEGRAL_SWAP }
/- ------------------------------------------------------------------------- -/
/- The key quadrisection step; small triangles; Cauchy's theorem for a      -/
/- triangle.                                                                 -/
/- (cauchy.ml 2119-2514)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYI where
  NORM_SUM_LEMMA : thm
  CAUCHY_THEOREM_QUADRISECTION : thm
  TRIANGLE_POINTS_CLOSER : thm
  HOLOMORPHIC_POINT_SMALL_TRIANGLE : thm
  CAUCHY_THEOREM_TRIANGLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYI [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYH : KYH) : ExceptT String IO KYI := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { VALID_PATH_LINEPATH, .. } := BKYE
  let { CONVEX_HULL_SUBSET, POINTS_IN_CONVEX_HULL, SEGMENTS_SUBSET_CONVEX_HULL, .. } := BKYF
  let { HAS_PATH_INTEGRAL_BOUND_LINEPATH, HAS_PATH_INTEGRAL_SUB,
        PATH_INTEGRABLE_CONTINUOUS_LINEPATH, PATH_INTEGRAL_REVERSE_LINEPATH, .. } := BKYG
  let { HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL, PATH_INTEGRAL_MIDPOINT,
        TRIANGLE_LINEAR_HAS_CHAIN_INTEGRAL, .. } := BKYH
  let { BOUNDED_CLOSED_NEST, .. } := D.qtopology
  let { FINITE_IMP_COMPACT_CONVEX_HULL, MIDPOINTS_IN_CONVEX_HULL, SIMPLEX_EXTREMAL_LE,
        .. } := D.qconvex
  let { APPROACHABLE_LT_LE, .. } := D.mt.ra.qmisc
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { complex_differentiable, has_complex_derivative, holomorphic_on,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, .. } := D.mt.ra.ts.kne
  let { SIMPLE_COMPLEX_ARITH, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_NZ, .. } := D.mt.ra.ts.cn.cxf
  let { ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, NORM_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { HAS_DERIVATIVE_WITHIN_ALT, .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { REAL_ARCH_POW2, REAL_LE_MAX, .. } := D.mt.ra.ts.cn.ms.ig.qsession
  let { ARITH, CONJ_ASSOC, CONTRAPOS_THM, ETA_AX, EXISTS_PAIR_THM, FINITE_INSERT,
        FINITE_RULES, FORALL_AND_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_PAIR_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, MONO_EXISTS, NOT_IN_EMPTY, NOT_INSERT_EMPTY, REAL_DIV_1, REAL_DIV_RMUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_LMUL_EQ, REAL_LE_MUL, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, REAL_LT_INV_EQ, REAL_LT_LDIV_EQ,
        REAL_LT_LMUL_EQ, REAL_LT_MUL, REAL_LTE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_ASSOC, REAL_MUL_SYM, REAL_NOT_LE, REAL_OF_NUM_LT, REAL_POW_LE2,
        REAL_POW_LT, SUBSET, SUBSET_REFL, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_THM, real_div, real_ge, real_pow, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_POS_LE, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_SUB, NORM_TRIANGLE_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, midpoint, VECTOR_SUB_LDISTRIB, VECTOR_SUB_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { COMPACT_IMP_BOUNDED, COMPACT_IMP_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { prove_recursive_functions_exist, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt
  let { PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHSTART_JOIN, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { TRANSITIVE_STEPWISE_LE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { num_RECURSION, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  let { CONVEX_HULL_EQ_EMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let NORM_SUM_LEMMA ← prove
   r"norm(a + b + c + d:complex) >= e
   ==> norm(a) >= e / &4 \/
       norm(b) >= e / &4 \/
       norm(c) >= e / &4 \/
       norm(d) >= e / &4"
   NORM_ARITH_TAC

  let CAUCHY_THEOREM_QUADRISECTION ← prove
   r"!f a b c e K.
        f continuous_on (convex hull {a,b,c}) /\
        dist (a,b) <= K /\
        dist (b,c) <= K /\
        dist (c,a) <= K /\
        norm(path_integral(linepath(a,b)) f +
             path_integral(linepath(b,c)) f +
             path_integral(linepath(c,a)) f) >= e * K pow 2
        ==> ?a' b' c'. a' IN convex hull {a,b,c} /\
                       b' IN convex hull {a,b,c} /\
                       c' IN convex hull {a,b,c} /\
                       dist(a',b') <= K / &2 /\
                       dist(b',c') <= K / &2 /\
                       dist(c',a') <= K / &2 /\
                       norm(path_integral(linepath(a',b')) f +
                            path_integral(linepath(b',c')) f +
                            path_integral(linepath(c',a')) f)
                        >= e * (K / &2) pow 2"
   (REPEAT STRIP_TAC THEN MAP_EVERY ABBREV_TAC
     [← q r"a':complex = midpoint(b,c)",
      ← q r"b':complex = midpoint(c,a)",
      ← q r"c':complex = midpoint(a,b)"] THEN
    SUBGOAL_THEN
     (← q r"path_integral(linepath(a,b)) f +
      path_integral(linepath(b,c)) f +
      path_integral(linepath(c,a)) f =
      (path_integral(linepath(a,c')) f +
       path_integral(linepath(c',b')) f +
       path_integral(linepath(b',a)) f) +
      (path_integral(linepath(a',c')) f +
       path_integral(linepath(c',b)) f +
       path_integral(linepath(b,a')) f) +
      (path_integral(linepath(a',c)) f +
       path_integral(linepath(c,b')) f +
       path_integral(linepath(b',a')) f) +
      (path_integral(linepath(a',b')) f +
       path_integral(linepath(b',c')) f +
       path_integral(linepath(c',a')) f)")
    SUBST_ALL_TAC THENL
     [MP_TAC (← SPEC (← q r"f:complex->complex") PATH_INTEGRAL_MIDPOINT) THEN DISCH_THEN
       (fun th => tactic_of do
          pure (MP_TAC (← SPECL [← q r"a:complex", ← q r"b:complex"] th) THEN
                MP_TAC (← SPECL [← q r"b:complex", ← q r"c:complex"] th) THEN
                MP_TAC (← SPECL [← q r"c:complex", ← q r"a:complex"] th))) THEN
      MP_TAC (← SPEC (← q r"f:complex->complex") PATH_INTEGRAL_REVERSE_LINEPATH) THEN DISCH_THEN
       (fun th => tactic_of do
          pure (MP_TAC (← SPECL [← q r"a':complex", ← q r"b':complex"] th) THEN
                MP_TAC (← SPECL [← q r"b':complex", ← q r"c':complex"] th) THEN
                MP_TAC (← SPECL [← q r"c':complex", ← q r"a':complex"] th))) THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC (← TAUT
       (← q r"((a /\ c ==> b /\ d) ==> e) ==> (a ==> b) ==> (c ==> d) ==> e"))) THEN
      ANTS_TAC THENL [ALL_TAC, CONV_TAC COMPLEX_RING] THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
      REPEAT CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
      SIMP_TAC [IN_INSERT, NOT_IN_EMPTY,
               ← TAUT (← q r"(a \/ b ==> c) <=> (a ==> c) /\ (b ==> c)")] THEN
      MAP_EVERY EXPAND_TAC ["a'", "b'", "c'"] THEN
      SIMP_TAC [MIDPOINTS_IN_CONVEX_HULL, POINTS_IN_CONVEX_HULL, IN_INSERT],
      ALL_TAC] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"e * (K / &2) pow 2 = (e * K pow 2) / &4")] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP NORM_SUM_LEMMA) THEN STRIP_TAC THENL
     [MAP_EVERY EXISTS_TAC [← q r"a:complex", ← q r"c':complex", ← q r"b':complex"],
      MAP_EVERY EXISTS_TAC [← q r"a':complex", ← q r"c':complex", ← q r"b:complex"],
      MAP_EVERY EXISTS_TAC [← q r"a':complex", ← q r"c:complex", ← q r"b':complex"],
      MAP_EVERY EXISTS_TAC [← q r"a':complex", ← q r"b':complex", ← q r"c':complex"]] THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY EXPAND_TAC ["a'", "b'", "c'"] THEN
    SIMP_TAC [MIDPOINTS_IN_CONVEX_HULL, POINTS_IN_CONVEX_HULL, IN_INSERT] THEN
    REWRITE_TAC [midpoint, dist, ← GSYM VECTOR_SUB_LDISTRIB,
                ← VECTOR_ARITH (← q r"a - inv(&2) % (a + b) = inv(&2) % (a - b)"),
                ← VECTOR_ARITH (← q r"inv(&2) % (c + a) - a = inv(&2) % (c - a)"),
                ← VECTOR_ARITH (← q r"(a + b) - (c + a) = b - c"),
                ← VECTOR_ARITH (← q r"(b + c) - (c + a) = b - a")] THEN
    SIMP_TAC [NORM_MUL, ← REAL_ARITH (← q r"abs(inv(&2)) * x <= k / &2 <=> x <= k")] THEN
    ASM_REWRITE_TAC [← GSYM dist] THEN ASM_MESON_TAC [DIST_SYM])

  /- Yet at small enough scales this cannot be the case. -/

  let TRIANGLE_POINTS_CLOSER ← prove
   r"!a b c x y:real^N.
        x IN convex hull {a,b,c} /\
        y IN convex hull {a,b,c}
        ==> norm(x - y) <= norm(a - b) \/
            norm(x - y) <= norm(b - c) \/
            norm(x - y) <= norm(c - a)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPEC (← q r"{a:real^N,b,c}") SIMPLEX_EXTREMAL_LE) THEN
    REWRITE_TAC [FINITE_INSERT, FINITE_RULES, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:real^N", ← q r"y:real^N"]) THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
    ASM_MESON_TAC [NORM_POS_LE, REAL_LE_TRANS, NORM_SUB])

  let HOLOMORPHIC_POINT_SMALL_TRIANGLE ← prove
   r"!f s x e.
        x IN s /\ f continuous_on s /\
        f complex_differentiable (at x within s) /\
        &0 < e
        ==> ?k. &0 < k /\
                !a b c. dist(a,b) <= k /\ dist(b,c) <= k /\ dist(c,a) <= k /\
                        x IN convex hull {a,b,c} /\ convex hull {a,b,c} SUBSET s
                        ==> norm(path_integral(linepath(a,b)) f +
                                 path_integral(linepath(b,c)) f +
                                 path_integral(linepath(c,a)) f)
                            <= e * (dist(a,b) + dist(b,c) + dist(c,a)) pow 2"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [complex_differentiable]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f':complex") MP_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [has_complex_derivative] THEN
    REWRITE_TAC [HAS_DERIVATIVE_WITHIN_ALT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real") o CONJUNCT2) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← TAUT (← q r"a /\ b ==> c <=> b ==> a ==> c")] THEN
    REWRITE_TAC [APPROACHABLE_LT_LE] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"b ==> a ==> c <=> a /\ b ==> c")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [dist] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"path_integral (linepath(a,b)) f +
      path_integral (linepath(b,c)) f +
      path_integral (linepath(c,a)) f =
      path_integral (linepath(a,b)) (\y. f y - f x - f' * (y - x)) +
      path_integral (linepath(b,c)) (\y. f y - f x - f' * (y - x)) +
      path_integral (linepath(c,a)) (\y. f y - f x - f' * (y - x))")
    SUBST1_TAC THENL
     [SUBGOAL_THEN
       (← q r"path_integral (linepath(a,b)) (\y. f y - f x - f' * (y - x)) =
        path_integral (linepath(a,b)) f -
        path_integral (linepath(a,b)) (\y. f x + f' * (y - x)) /\
        path_integral (linepath(b,c)) (\y. f y - f x - f' * (y - x)) =
        path_integral (linepath(b,c)) f -
        path_integral (linepath(b,c)) (\y. f x + f' * (y - x)) /\
        path_integral (linepath(c,a)) (\y. f y - f x - f' * (y - x)) =
        path_integral (linepath(c,a)) f -
        path_integral (linepath(c,a)) (\y. f x + f' * (y - x))")
      (REPEAT_TCL CONJUNCTS_THEN SUBST1_TAC) THENL
       [REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"a - b - c = a - (b + c)")] THEN
        REPEAT CONJ_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
        MATCH_MP_TAC HAS_PATH_INTEGRAL_SUB THEN
        CONJ_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
        MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"s:complex->bool") THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_ID, CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST,
                     CONTINUOUS_ON_COMPLEX_MUL, CONTINUOUS_ON_SUB] THEN
        MATCH_MP_TAC SUBSET_TRANS THEN
        EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN
        ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
        MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
        REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN REPEAT STRIP_TAC THEN
        ASM_SIMP_TAC [MIDPOINTS_IN_CONVEX_HULL, POINTS_IN_CONVEX_HULL, IN_INSERT],
        ALL_TAC] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"x + y + z = (x - x') + (y - y') + (z - z') <=>
        x' + y' + z' = Cx(&0)"))] THEN
      MP_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex",
                     ← q r"f':complex", ← q r"f x - f' * x"]
             TRIANGLE_LINEAR_HAS_CHAIN_INTEGRAL) THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"f' * x' + f x - f' * x = f x + f' * (x' - x)"))] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL) THEN
      REWRITE_TAC [],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [NORM_SUB] THEN MATCH_MP_TAC (← REAL_ARITH
     (← q r"&0 <= x * y /\ &0 <= x * z /\ &0 <= y * z /\
      a <= (e * (x + y + z)) * x +
           (e * (x + y + z)) * y +
           (e * (x + y + z)) * z
      ==> a <= e * (x + y + z) pow 2")) THEN
    SIMP_TAC [REAL_LE_MUL, NORM_POS_LE] THEN
    REPEAT (MATCH_MP_TAC NORM_TRIANGLE_LE THEN
           MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC) THEN
    (MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
     EXISTS_TAC (← q r"\y:complex. f y - f x - f' * (y - x)") THEN
     ASM_SIMP_TAC [REAL_LE_MUL, REAL_LE_ADD, REAL_LT_IMP_LE, NORM_POS_LE] THEN
     CONJ_TAC THENL
      [MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
       MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
       MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
       ASM_SIMP_TAC [CONTINUOUS_ON_SUB, ETA_AX, CONTINUOUS_ON_COMPLEX_MUL,
                   CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
       MATCH_MP_TAC SUBSET_TRANS THEN
       EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN
       ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
       MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
       REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN REPEAT STRIP_TAC THEN
       ASM_SIMP_TAC [MIDPOINTS_IN_CONVEX_HULL, POINTS_IN_CONVEX_HULL, IN_INSERT],
       ALL_TAC] THEN
     X_GEN_TAC (← q r"y:complex") THEN STRIP_TAC THEN
     MATCH_MP_TAC REAL_LE_TRANS THEN
     EXISTS_TAC (← q r"e * norm(y - x:complex)") THEN CONJ_TAC THENL
      [FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
        [MATCH_MP_TAC (← SET_RULE (← q r"!t. y IN t /\ t SUBSET s ==> y IN s")) THEN
         EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN ASM_REWRITE_TAC [],
         MATCH_MP_TAC (← REAL_ARITH
          (← q r"!n1 n2 n3. n1 <= d /\ n2 <= d /\ n3 <= d /\
                      (n <= n1 \/ n <= n2 \/ n <= n3)
                      ==> n <= d")) THEN
         MAP_EVERY EXISTS_TAC
          [← q r"norm(a - b:complex)", ← q r"norm(b - c:complex)",
           ← q r"norm(c - a:complex)"] THEN
         ASM_REWRITE_TAC [] THEN MATCH_MP_TAC TRIANGLE_POINTS_CLOSER],
       ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN
       ONCE_REWRITE_TAC [NORM_SUB] THEN
       MATCH_MP_TAC (← REAL_ARITH
        (← q r"(x <= a \/ x <= b \/ x <= c) /\ (&0 <= a /\ &0 <= b /\ &0 <= c)
         ==> x <= a + b + c")) THEN
       REWRITE_TAC [NORM_POS_LE] THEN MATCH_MP_TAC TRIANGLE_POINTS_CLOSER THEN
       ASM_REWRITE_TAC []] THEN
      REPEAT CONJ_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN s ==> s SUBSET t ==> x IN t"))) THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
      REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN REPEAT STRIP_TAC THEN
      ASM_SIMP_TAC [MIDPOINTS_IN_CONVEX_HULL, POINTS_IN_CONVEX_HULL,
                   IN_INSERT]))

  /- Hence the most basic theorem for a triangle. -/

  let CAUCHY_THEOREM_TRIANGLE ← (do
    let lemma1 ← prove
     r"!P Q abc.
          P abc 0 /\
          (!abc:A n. P abc n ==> ?abc'. P abc' (SUC n) /\ Q abc' abc)
          ==> ?ABC. ABC 0 = abc /\ !n. P (ABC n) n /\ Q (ABC(SUC n)) (ABC n)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← prove_recursive_functions_exist num_RECURSION
        (← q r"ABC 0 = abc:A /\
         !n. ABC(SUC n) = @abc. P abc (SUC n) /\ Q abc (ABC n)")) THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      STRIP_TAC THEN CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [INDUCT_TAC THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])
    let lemma3 ← prove
     r"!P Q a:A b:A c:A.
          P a b c 0 /\
          (!a b c n. P a b c n
                     ==> ?a' b' c'. P a' b' c' (SUC n) /\ Q a' b' c' a b c)
          ==> ?A B C. A 0 = a /\ B 0 = b /\ C 0 = c /\
                      !n. P (A n) (B n) (C n) n /\
                          Q (A(SUC n)) (B(SUC n)) (C(SUC n)) (A n) (B n) (C n)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"\(a,b,c). (P:A->A->A->num->bool) a b c",
        ← q r"\(a,b,c) (a',b',c'). (Q:A->A->A->A->A->A->bool) a b c a' b' c'",
        ← q r"(a:A,b:A,c:A)"]
            lemma1) THEN
      REWRITE_TAC [FORALL_PAIR_THM, EXISTS_PAIR_THM] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"ABC:num->A#A#A") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(\(a,b,c). a) o (ABC:num->A#A#A)",
        ← q r"(\(a,b,c). b) o (ABC:num->A#A#A)",
        ← q r"(\(a,b,c). c) o (ABC:num->A#A#A)"] THEN
      REWRITE_TAC [o_THM] THEN
      REPEAT (CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC]) THEN
      X_GEN_TAC (← q r"n:num") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      SPEC_TAC (← q r"(ABC:num->A#A#A) (SUC n)", ← q r"y:A#A#A") THEN
      SPEC_TAC (← q r"(ABC:num->A#A#A) n", ← q r"x:A#A#A") THEN
      REWRITE_TAC [FORALL_PAIR_THM])
    prove
     r"!f a b c.
        f holomorphic_on (convex hull {a,b,c})
        ==> (f has_path_integral Cx(&0))
            (linepath(a,b) ++ linepath(b,c) ++ linepath(c,a))"
     (REPEAT STRIP_TAC THEN
      STRIP_ASSUME_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
                    SEGMENTS_SUBSET_CONVEX_HULL) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOLOMORPHIC_ON_IMP_CONTINUOUS_ON) THEN
      SUBGOAL_THEN
       (← q r"f path_integrable_on (linepath(a,b) ++ linepath(b,c) ++ linepath(c,a))")
      MP_TAC THENL
       [SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, VALID_PATH_LINEPATH,
                 PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH,
                 PATHFINISH_LINEPATH] THEN
        ASM_MESON_TAC [PATH_INTEGRABLE_CONTINUOUS_LINEPATH, CONTINUOUS_ON_SUBSET],
        ALL_TAC] THEN
      SIMP_TAC [path_integrable_on] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"y:complex")) THEN
      ASM_CASES_TAC (← q r"y = Cx(&0)") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      ABBREV_TAC
       (← q r"K = &1 + max (dist(a:complex,b)) (max (dist(b,c)) (dist(c,a)))") THEN
      SUBGOAL_THEN (← q r"&0 < K") ASSUME_TAC THENL
       [EXPAND_TAC "K" THEN MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x ==> &0 < &1 + x")) THEN
        REWRITE_TAC [REAL_LE_MAX, DIST_POS_LE],
        ALL_TAC] THEN
      ABBREV_TAC (← q r"e = norm(y:complex) / K pow 2") THEN
      SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
       [EXPAND_TAC "e" THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT, COMPLEX_NORM_NZ],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?A B C. A 0 = a /\ B 0 = b /\ C 0 = c /\
                !n. (convex hull {A n,B n,C n} SUBSET convex hull {a,b,c} /\
                     dist(A n,B n) <= K / &2 pow n /\
                     dist(B n,C n) <= K / &2 pow n /\
                     dist(C n,A n) <= K / &2 pow n /\
                     norm(path_integral(linepath (A n,B n)) f +
                          path_integral(linepath (B n,C n)) f +
                          path_integral(linepath (C n,A n)) f) >=
                     e * (K / &2 pow n) pow 2) /\
                    convex hull {A(SUC n),B(SUC n),C(SUC n)} SUBSET
                    convex hull {A n,B n,C n}")
      MP_TAC THENL
       [MATCH_MP_TAC lemma3 THEN CONJ_TAC THENL
         [ASM_REWRITE_TAC [real_pow, REAL_DIV_1, CONJ_ASSOC, SUBSET_REFL] THEN
          CONJ_TAC THENL [EXPAND_TAC "K" THEN REAL_ARITH_TAC, ALL_TAC] THEN
          EXPAND_TAC "e" THEN
          ASM_SIMP_TAC [REAL_DIV_RMUL, REAL_LT_IMP_NZ, REAL_POW_LT] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"x = y ==> x >= y")) THEN AP_TERM_TAC THEN
          FIRST_ASSUM (SUBST1_TAC o SYM o
            MATCH_MP HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL) THEN
          REWRITE_TAC [],
          ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC
         [← q r"a':complex", ← q r"b':complex", ← q r"c':complex", ← q r"n:num"] THEN
        REPEAT STRIP_TAC THEN
        MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a':complex", ← q r"b':complex",
           ← q r"c':complex", ← q r"e:real", ← q r"K / &2 pow n"]
           CAUCHY_THEOREM_QUADRISECTION) THEN
        ASM_REWRITE_TAC [] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [real_pow, ← REAL_FIELD (← q r"x / (&2 * y) = x / y / &2")] THEN
        MATCH_MP_TAC (← SET_RULE
         (← q r"s SUBSET t /\ t SUBSET u ==> s SUBSET u /\ s SUBSET t")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?x:complex. !n:num. x IN convex hull {A n,B n,C n}")
      STRIP_ASSUME_TAC THENL
       [MATCH_MP_TAC BOUNDED_CLOSED_NEST THEN REPEAT CONJ_TAC THENL
         [GEN_TAC THEN MATCH_MP_TAC COMPACT_IMP_CLOSED,
          REWRITE_TAC [CONVEX_HULL_EQ_EMPTY, NOT_INSERT_EMPTY],
          MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM_REWRITE_TAC [] THEN
          MESON_TAC [SUBSET_REFL, SUBSET_TRANS],
          MATCH_MP_TAC COMPACT_IMP_BOUNDED] THEN
        MATCH_MP_TAC FINITE_IMP_COMPACT_CONVEX_HULL THEN
        REWRITE_TAC [FINITE_INSERT, FINITE_RULES],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"convex hull {a:complex,b,c}",
                     ← q r"x:complex", ← q r"e / &10"] HOLOMORPHIC_POINT_SMALL_TRIANGLE) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, complex_differentiable] THEN
        ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
        ASM_MESON_TAC [holomorphic_on, SUBSET],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPEC (← q r"K:real / k") REAL_ARCH_POW2) THEN
      ASM_SIMP_TAC [REAL_LT_LDIV_EQ] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      SIMP_TAC [← GSYM REAL_LT_LDIV_EQ, REAL_POW_LT, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(A:num->complex) n", ← q r"(B:num->complex) n", ← q r"(C:num->complex) n"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [REAL_LE_TRANS, REAL_LT_IMP_LE], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [REAL_NOT_LE] THEN
      MATCH_MP_TAC REAL_LTE_TRANS THEN
      EXISTS_TAC (← q r"e * (K / &2 pow n) pow 2") THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [← GSYM real_ge]] THEN
      ASM_SIMP_TAC [real_div, ← GSYM REAL_MUL_ASSOC, REAL_LT_LMUL_EQ] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < x /\ y <= &9 * x ==> inv(&10) * y < x")) THEN
      ASM_SIMP_TAC [REAL_POW_LT, REAL_LT_MUL, REAL_LT_INV_EQ,
                    REAL_OF_NUM_LT, ARITH] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&9 * x pow 2 = (&3 * x) pow 2")] THEN
      MATCH_MP_TAC REAL_POW_LE2 THEN
      SIMP_TAC [REAL_LE_ADD, DIST_POS_LE, ← GSYM real_div] THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"x <= a /\ y <= a /\ z <= a ==> x + y + z <= &3 * a")) THEN
      ASM_REWRITE_TAC []))

  pure { NORM_SUM_LEMMA, CAUCHY_THEOREM_QUADRISECTION, TRIANGLE_POINTS_CLOSER,
         HOLOMORPHIC_POINT_SMALL_TRIANGLE, CAUCHY_THEOREM_TRIANGLE }
/- ------------------------------------------------------------------------- -/
/- Version needing function holomorphic in interior only.                    -/
/- (cauchy.ml 2515-2825)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYJ where
  CAUCHY_THEOREM_FLAT_LEMMA : thm
  CAUCHY_THEOREM_FLAT : thm
  CAUCHY_THEOREM_TRIANGLE_INTERIOR : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYJ [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYH : KYH) (BKYI : KYI) : ExceptT String IO KYJ := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on, .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { HAS_PATH_INTEGRAL_LINEPATH, LINEPATH_IN_PATH, VALID_PATH_LINEPATH, .. } := BKYE
  let { SEGMENTS_SUBSET_CONVEX_HULL, .. } := BKYF
  let { PATH_INTEGRABLE_CONTINUOUS_LINEPATH, PATH_INTEGRAL_REVERSE_LINEPATH, .. } := BKYG
  let { HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL, PATH_INTEGRAL_SPLIT, .. } := BKYH
  let { CAUCHY_THEOREM_TRIANGLE, .. } := BKYI
  let { CONTENT_UNIT_1, .. } := D.qintegration
  let { FINITE_IMP_COMPACT_CONVEX_HULL, IN_INTERIOR_CONVEX_SHRINK, .. } := D.qconvex
  let { COLLINEAR_3, .. } := D.qvectors
  let { HAS_INTEGRAL_BOUND, .. } := D.mt.ra.qintegration
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { REAL_MUL_2, .. } := D.mt.ra.ts.qsession
  let { COMPLEX_SUB_0, COMPLEX_SUB_LZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_NORM_MUL, COMPLEX_NORM_NZ, COMPLEX_NORM_ZERO, .. } := D.mt.ra.ts.cn.cxf
  let { HAS_INTEGRAL_SUB, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { ASM_MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC,
        VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, CARD_CLAUSES, CONTRAPOS_THM, DIMINDEX_2, FINITE_EMPTY, FINITE_INSERT,
        FINITE_RULES, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, HAS_SIZE, INSERT_AC, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_ABS_POS, REAL_CONVEX_BOUND_LT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_EQ_IMP_LE, REAL_INV_LE_1, REAL_LE_ADD2, REAL_LE_INV_EQ, REAL_LE_LMUL_EQ,
        REAL_LE_MUL2, REAL_LE_TRANS, REAL_LET_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE,
        REAL_LT_MIN, REAL_LT_MUL, REAL_LT_RDIV_EQ, REAL_LTE_ADD, REAL_MIN_LT,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LINV, REAL_MUL_RID, REAL_OF_NUM_LT, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { HULL_MINIMAL, HULL_SUBSET, REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { COLLINEAR_LEMMA, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_NEG, NORM_POS_LE, NORM_TRIANGLE_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_MUL_ASSOC, VECTOR_MUL_LID, VECTOR_MUL_LZERO, VECTOR_SUB,
        VECTOR_SUB_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_POS, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, INTERIOR_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHSTART_JOIN, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { COMPACT_UNIFORMLY_CONTINUOUS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { NORM_TRIANGLE_LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qvec
  let { COLLINEAR_3_EQ_AFFINE_DEPENDENT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx1
  let { CONVEX_CONVEX_HULL, CONVEX_INTERIOR, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { INTERIOR_CONVEX_HULL_EQ_EMPTY, SEGMENT_CONVEX_HULL,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let CAUCHY_THEOREM_FLAT_LEMMA ← prove
   r"!f a b c k.
        f continuous_on convex hull {a,b,c} /\ c - a = k % (b - a) /\ &0 <= k
        ==> path_integral (linepath(a,b)) f +
            path_integral (linepath(b,c)) f +
            path_integral (linepath(c,a)) f = Cx(&0)"
   (REPEAT STRIP_TAC THEN
    STRIP_ASSUME_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
                  SEGMENTS_SUBSET_CONVEX_HULL) THEN
    ASM_CASES_TAC (← q r"k <= &1") THENL
     [MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex", ← q r"b:complex",
                    ← q r"c:complex", ← q r"k:real"] PATH_INTEGRAL_SPLIT) THEN
      ASM_REWRITE_TAC [] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
      DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"x = --b /\ y = --a ==> (x + y) + (a + b) = Cx(&0)"))) THEN
      CONJ_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_REVERSE_LINEPATH THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
      MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex", ← q r"c:complex",
                    ← q r"b:complex", ← q r"inv k:real"] PATH_INTEGRAL_SPLIT) THEN
      ASM_SIMP_TAC [VECTOR_MUL_ASSOC, REAL_LE_INV_EQ, REAL_MUL_LINV, REAL_INV_LE_1,
        VECTOR_MUL_LID, ← REAL_ARITH (← q r"~(k <= &1) ==> ~(k = &0) /\ &1 <= k")] THEN
      ANTS_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"ac = --ca ==> ac = ab + bc ==> ab + bc + ca = Cx(&0)"))) THEN
      MATCH_MP_TAC PATH_INTEGRAL_REVERSE_LINEPATH THEN
      ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]])

  let CAUCHY_THEOREM_FLAT ← prove
   r"!f a b c k.
        f continuous_on convex hull {a,b,c} /\ c - a = k % (b - a)
        ==> path_integral (linepath(a,b)) f +
            path_integral (linepath(b,c)) f +
            path_integral (linepath(c,a)) f = Cx(&0)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"&0 <= k") THENL
     [ASM_MESON_TAC [CAUCHY_THEOREM_FLAT_LEMMA], ALL_TAC] THEN
    STRIP_ASSUME_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
                  SEGMENTS_SUBSET_CONVEX_HULL) THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"b:complex", ← q r"a:complex",
                   ← q r"c:complex", ← q r"&1 - k"] CAUCHY_THEOREM_FLAT_LEMMA) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [INSERT_AC, ← REAL_ARITH (← q r"~(&0 <= k) ==> &0 <= &1 - k"),
           ← VECTOR_ARITH (← q r"b - a = k % (c - a) ==> (b - c) = (&1 - k) % (a - c)")],
      ALL_TAC] THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"ab = --ba /\ ac = --ca /\ bc = --cb
        ==> ba + ac + cb = Cx(&0) ==> ab + bc + ca = Cx(&0)"))) THEN
    REPEAT CONJ_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_REVERSE_LINEPATH THEN
    ASM_MESON_TAC [CONTINUOUS_ON_SUBSET])

  let CAUCHY_THEOREM_TRIANGLE_INTERIOR ← prove
   r"!f a b c.
        f continuous_on (convex hull {a,b,c}) /\
        f holomorphic_on interior (convex hull {a,b,c})
        ==> (f has_path_integral Cx(&0))
            (linepath(a,b) ++ linepath(b,c) ++ linepath(c,a))"
   (REPEAT STRIP_TAC THEN
    STRIP_ASSUME_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
                  SEGMENTS_SUBSET_CONVEX_HULL) THEN
    SUBGOAL_THEN
      (← q r"?B. &0 < B /\
           !y. y IN IMAGE (f:complex->complex) (convex hull {a,b,c})
               ==> norm(y) <= B")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM BOUNDED_POS] THEN MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      ASM_SIMP_TAC [FINITE_IMP_COMPACT_CONVEX_HULL, FINITE_INSERT, FINITE_RULES],
      REWRITE_TAC [FORALL_IN_IMAGE] THEN STRIP_TAC] THEN
    SUBGOAL_THEN
      (← q r"?C. &0 < C /\ !x:complex. x IN convex hull {a,b,c} ==> norm(x) <= C")
    MP_TAC THENL
     [REWRITE_TAC [← GSYM BOUNDED_POS] THEN
      MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      ASM_SIMP_TAC [FINITE_IMP_COMPACT_CONVEX_HULL, FINITE_INSERT, FINITE_RULES],
      STRIP_TAC] THEN
    SUBGOAL_THEN
     (← q r"(f:complex->complex) uniformly_continuous_on (convex hull {a,b,c})")
    MP_TAC THENL
     [MATCH_MP_TAC COMPACT_UNIFORMLY_CONTINUOUS THEN
      ASM_SIMP_TAC [FINITE_IMP_COMPACT_CONVEX_HULL, FINITE_RULES, FINITE_INSERT],
      ALL_TAC] THEN
    REWRITE_TAC [uniformly_continuous_on] THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"f path_integrable_on
      (linepath (a,b) ++ linepath(b,c) ++ linepath(c,a))")
    MP_TAC THENL
     [SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, VALID_PATH_LINEPATH,
               PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH,
               PATHFINISH_LINEPATH] THEN
      ASM_MESON_TAC [PATH_INTEGRABLE_CONTINUOUS_LINEPATH, CONTINUOUS_ON_SUBSET],
      ALL_TAC] THEN
    SIMP_TAC [path_integrable_on] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"y:complex")) THEN
    ASM_CASES_TAC (← q r"y = Cx(&0)") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~(y = Cx(&0))") THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    DISCH_THEN (K ALL_TAC) THEN REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o SYM o MATCH_MP
       HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"c:complex = a") THENL
     [MATCH_MP_TAC CAUCHY_THEOREM_FLAT THEN
      EXISTS_TAC (← q r"&0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_SUB_EQ],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"b:complex = c") THENL
     [ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + b + c:complex = c + a + b"))] THEN
      MATCH_MP_TAC CAUCHY_THEOREM_FLAT THEN
      EXISTS_TAC (← q r"&0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_SUB_EQ] THEN
      ASM_MESON_TAC [INSERT_AC],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"a:complex = b") THENL
     [ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + b + c:complex = b + c + a"))] THEN
      MATCH_MP_TAC CAUCHY_THEOREM_FLAT THEN
      EXISTS_TAC (← q r"&0") THEN ASM_REWRITE_TAC [VECTOR_MUL_LZERO, VECTOR_SUB_EQ] THEN
      ASM_MESON_TAC [INSERT_AC],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"interior(convex hull {a:complex,b,c}) = {}") THENL
     [MATCH_MP_TAC CAUCHY_THEOREM_FLAT THEN
      SUBGOAL_THEN (← q r"{a:complex,b,c} HAS_SIZE (dimindex(:2) + 1)")
      MP_TAC THENL
       [ASM_SIMP_TAC [HAS_SIZE, CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY] THEN
        ASM_REWRITE_TAC [DIMINDEX_2, ARITH, IN_INSERT, NOT_IN_EMPTY],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP INTERIOR_CONVEX_HULL_EQ_EMPTY) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"collinear{a:complex,b,c}") MP_TAC THENL
       [ASM_REWRITE_TAC [COLLINEAR_3_EQ_AFFINE_DEPENDENT], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"{a,b,c} = {b,a,c}")] THEN
      ONCE_REWRITE_TAC [COLLINEAR_3] THEN
      ASM_REWRITE_TAC [COLLINEAR_LEMMA, VECTOR_SUB_EQ],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"d:complex")) THEN FIRST_X_ASSUM (MP_TAC o SYM) THEN
    DISCH_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"y = Cx(&0)") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"norm(y:complex) / &24 / C")) THEN
    SUBGOAL_THEN (← q r"&0 < norm(y:complex) / &24 / C") ASSUME_TAC THENL
     [ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH, NORM_POS_LE, REAL_LTE_ADD,
                   COMPLEX_NORM_NZ, COMPLEX_SUB_0],
      ASM_REWRITE_TAC [dist]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN ABBREV_TAC
     (← q r"e = min (&1)
              (min (d1 / (&4 * C))
                   ((norm(y:complex) / &24 / C) / B))") THEN
    SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
     [EXPAND_TAC "e" THEN
      ASM_SIMP_TAC [REAL_HALF, REAL_LT_MIN, REAL_LT_DIV, COMPLEX_NORM_NZ,
                   REAL_LT_MUL, REAL_OF_NUM_LT, ARITH],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"shrink = \x:complex. x - e % (x - d)") THEN
    SUBGOAL_THEN (← q r"shrink (a:complex) IN interior(convex hull {a,b,c}) /\
                  shrink b IN interior(convex hull {a,b,c}) /\
                  shrink c IN interior(convex hull {a,b,c})")
    STRIP_ASSUME_TAC THENL
     [REPEAT CONJ_TAC THEN EXPAND_TAC "shrink" THEN
      MATCH_MP_TAC IN_INTERIOR_CONVEX_SHRINK THEN
      ASM_REWRITE_TAC [CONVEX_CONVEX_HULL] THEN
      (CONJ_TAC THENL [ALL_TAC, EXPAND_TAC "e" THEN REAL_ARITH_TAC]) THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
      REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"norm((path_integral(linepath(shrink a,shrink b)) f -
            path_integral(linepath(a,b)) f) +
           (path_integral(linepath(shrink b,shrink c)) f -
            path_integral(linepath(b,c)) f) +
           (path_integral(linepath(shrink c,shrink a)) f -
            path_integral(linepath(c,a)) f)) <= norm(y:complex) / &2")
    MP_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
       (← q r"(ab' - ab) + (bc' - bc) + (ca' - ca) =
        (ab' + bc' + ca') - (ab + bc + ca)"))] THEN
      SUBGOAL_THEN
       (← q r"(f has_path_integral (Cx(&0)))
        (linepath (shrink a,shrink b) ++
         linepath (shrink b,shrink c) ++
         linepath (shrink c,shrink (a:complex)))")
      MP_TAC THENL
       [MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_SUBSET THEN
        EXISTS_TAC (← q r"interior(convex hull {a:complex,b,c})") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HULL_MINIMAL THEN
        SIMP_TAC [CONVEX_INTERIOR, CONVEX_CONVEX_HULL] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL) THEN
      SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
      REWRITE_TAC [COMPLEX_SUB_LZERO, NORM_NEG] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= y /\ ~(y = &0) ==> ~(y <= y / &2)")) THEN
      ASM_REWRITE_TAC [COMPLEX_NORM_ZERO, NORM_POS_LE]] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN convex hull {a,b,c} /\ y IN convex hull {a,b,c}
            ==> norm(x - y) <= &2 * C")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [REAL_MUL_2, VECTOR_SUB] THEN
      MATCH_MP_TAC NORM_TRIANGLE_LE THEN REWRITE_TAC [NORM_NEG] THEN
      MATCH_MP_TAC REAL_LE_ADD2 THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x / &2 = x / &6 + x / &6 + x / &6")] THEN
    REPEAT (MATCH_MP_TAC NORM_TRIANGLE_LE THEN
           MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC) THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_RID] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM CONTENT_UNIT_1] THEN
    MATCH_MP_TAC HAS_INTEGRAL_BOUND THENL
     [EXISTS_TAC (← q r"\x. f(linepath(shrink a,shrink b) x) *
                      (shrink b - shrink a) -
                      f(linepath(a,b) x) * (b - a)"),
      EXISTS_TAC (← q r"\x. f(linepath(shrink b,shrink c) x) *
                      (shrink c - shrink b) -
                      f(linepath(b,c) x) * (c - b)"),
      EXISTS_TAC (← q r"\x. f(linepath(shrink c,shrink a) x) *
                      (shrink a - shrink c) -
                      f(linepath(c,a) x) * (a - c)")] THEN
    ASM_SIMP_TAC [COMPLEX_NORM_NZ, ← REAL_ARITH (← q r"&0 < x ==> &0 <= x / &6")] THEN
    (CONJ_TAC THENL
      [MATCH_MP_TAC HAS_INTEGRAL_SUB THEN
       REWRITE_TAC [← GSYM HAS_PATH_INTEGRAL_LINEPATH] THEN
       CONJ_TAC THEN MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
       MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
       MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
       EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN
       ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
       MATCH_MP_TAC HULL_MINIMAL THEN
       REWRITE_TAC [CONVEX_CONVEX_HULL, SUBSET, IN_INSERT, NOT_IN_EMPTY] THEN
       ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET],
       ALL_TAC] THEN
     REPEAT STRIP_TAC THEN
     ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
      (← q r"f' * x' - f * x = f' * (x' - x) + x * (f' - f):complex"))] THEN
     MATCH_MP_TAC NORM_TRIANGLE_LE THEN REWRITE_TAC [COMPLEX_NORM_MUL] THEN
     MATCH_MP_TAC REAL_LE_TRANS THEN
     EXISTS_TAC (← q r"B * (norm(y:complex) / &24 / C / B) * &2 * C +
                 (&2 * C) * (norm y / &24 / C)") THEN
     CONJ_TAC THENL
      [ALL_TAC,
       MATCH_MP_TAC REAL_EQ_IMP_LE THEN
       MAP_EVERY UNDISCH_TAC [← q r"&0 < B", ← q r"&0 < C"] THEN CONV_TAC REAL_FIELD] THEN
     MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
     MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [NORM_POS_LE] THENL
      [CONJ_TAC THENL
        [FIRST_X_ASSUM MATCH_MP_TAC THEN
         W (MP_TAC o PART_MATCH (lhand o rand) LINEPATH_IN_PATH o lhand o snd) THEN
         ASM_REWRITE_TAC [] THEN
         W (fun (_asl, w) => tactic_of do
           pure (SPEC_TAC (← liftExcept (do lhand (← rand w)), ← q r"x:complex"))) THEN
         REWRITE_TAC [← GSYM SUBSET, SEGMENT_CONVEX_HULL] THEN
         MATCH_MP_TAC HULL_MINIMAL THEN
         REWRITE_TAC [CONVEX_CONVEX_HULL, SUBSET, IN_INSERT, NOT_IN_EMPTY] THEN
         ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET],
         ALL_TAC] THEN
       EXPAND_TAC "shrink" THEN
       REWRITE_TAC [← VECTOR_ARITH (← q r"(b - e % (b - d)) - (a - e % (a - d)) -
                             (b - a) = e % (a - b)")] THEN
       REWRITE_TAC [NORM_MUL] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
       ASM_SIMP_TAC [NORM_POS_LE, ← REAL_ARITH (← q r"&0 < x ==> abs x = x"),
                    REAL_ABS_POS] THEN
       CONJ_TAC THENL [EXPAND_TAC "e" THEN REAL_ARITH_TAC, ALL_TAC] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THEN
       MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
       REWRITE_TAC [IN_INSERT],
       ALL_TAC] THEN
     CONJ_TAC THENL
      [FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THEN
       MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
       REWRITE_TAC [IN_INSERT],
       ALL_TAC] THEN
     MATCH_MP_TAC REAL_LT_IMP_LE THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     CONJ_TAC THENL
      [W (MP_TAC o PART_MATCH (lhand o rand) LINEPATH_IN_PATH o lhand o snd) THEN
       ASM_MESON_TAC [SUBSET],
       ALL_TAC] THEN
     CONJ_TAC THENL
      [W (MP_TAC o PART_MATCH (lhand o rand) LINEPATH_IN_PATH o lhand o snd) THEN
       ASM_REWRITE_TAC [] THEN
       W (fun (_asl, w) => tactic_of do
         pure (SPEC_TAC (← liftExcept (do lhand (← rand w)), ← q r"x:complex"))) THEN
       REWRITE_TAC [← GSYM SUBSET, SEGMENT_CONVEX_HULL] THEN
       MATCH_MP_TAC HULL_MINIMAL THEN
       REWRITE_TAC [CONVEX_CONVEX_HULL, SUBSET, IN_INSERT, NOT_IN_EMPTY] THEN
       ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET],
       ALL_TAC] THEN
     REWRITE_TAC [linepath] THEN REWRITE_TAC [← VECTOR_ARITH
       (← q r"((&1 - x) % a' + x % b') - ((&1 - x) % a + x % b) =
        (&1 - x) % (a' - a) + x % (b' - b)")] THEN
     EXPAND_TAC "shrink" THEN REWRITE_TAC [← VECTOR_ARITH (← q r"a - b - a = --b")] THEN
     MATCH_MP_TAC NORM_TRIANGLE_LT THEN REWRITE_TAC [NORM_MUL, NORM_NEG] THEN
     MATCH_MP_TAC REAL_CONVEX_BOUND_LT THEN ONCE_REWRITE_TAC [← TAUT
      (← q r"a /\ b /\ c /\ d /\ e <=> (c /\ d /\ e) /\ a /\ b")] THEN
     CONJ_TAC THENL
      [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERVAL_1]) THEN
       REWRITE_TAC [DROP_VEC] THEN REAL_ARITH_TAC,
       ALL_TAC] THEN
     CONJ_TAC THEN
     MATCH_MP_TAC REAL_LET_TRANS THEN
     EXISTS_TAC (← q r"e * &2 * C") THEN
     ASM_SIMP_TAC [REAL_LE_LMUL_EQ, ← REAL_ARITH (← q r"&0 < x ==> abs x = x")] THEN
     (CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET, HULL_SUBSET, IN_INSERT],
        ALL_TAC]) THEN
     ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, REAL_LT_MUL, REAL_OF_NUM_LT, ARITH] THEN
     EXPAND_TAC "e" THEN REWRITE_TAC [REAL_MIN_LT] THEN
     DISJ2_TAC THEN DISJ1_TAC THEN
     REWRITE_TAC [← REAL_FIELD (← q r"d / (a * b) = inv(a:real) * d / b")] THEN
     REWRITE_TAC [← REAL_ARITH (← q r"inv(&4) * x < inv(&2) * x <=> &0 < x")] THEN
     ASM_SIMP_TAC [REAL_LT_DIV]))

  pure { CAUCHY_THEOREM_FLAT_LEMMA, CAUCHY_THEOREM_FLAT, CAUCHY_THEOREM_TRIANGLE_INTERIOR }
/- ------------------------------------------------------------------------- -/
/- Version allowing finite number of exceptional points; existence of a     -/
/- primitive.                                                                -/
/- (cauchy.ml 2826-3060)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYK where
  CAUCHY_THEOREM_TRIANGLE_COFINITE : thm
  STARLIKE_CONVEX_SUBSET : thm
  TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE : thm
  HOLOMORPHIC_STARLIKE_PRIMITIVE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYK [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYG : KYG) (BKYH : KYH) (BKYJ : KYJ) : ExceptT String IO KYK := do
  -- @@SCOPE BEGIN
  let { path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { VALID_PATH_LINEPATH, .. } := BKYE
  let { CONVEX_HULL_SUBSET, NOT_IN_INTERIOR_CONVEX_HULL_3, SEGMENTS_SUBSET_CONVEX_HULL,
        .. } := BKYF
  let { HAS_PATH_INTEGRAL_BOUND_LINEPATH, HAS_PATH_INTEGRAL_CONST_LINEPATH,
        HAS_PATH_INTEGRAL_NEG, HAS_PATH_INTEGRAL_SUB, PATH_INTEGRABLE_CONTINUOUS_LINEPATH,
        PATH_INTEGRAL_REVERSE_LINEPATH, .. } := BKYG
  let { HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL, .. } := BKYH
  let { CAUCHY_THEOREM_TRIANGLE_INTERIOR, .. } := BKYJ
  let { CONVEX_HULL_INSERT, starlike, .. } := D.qconvex
  let { complex_differentiable, has_complex_derivative, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        holomorphic_on, .. } := D.mt.ra.ts.kne
  let { COMPLEX_NEG_SUB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { LINEAR_COMPLEX_MUL, .. } := D.mt.ra.ts.cn.cxh
  let { SEGMENT_BOUND, .. } := D.mt.ra.ts.cn.qconvex
  let { has_derivative_at, .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { CARD_DELETE, CARD_EQ_0, DE_MORGAN_THM, FINITE_DELETE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ_ALT, IMP_IMP, IN_DELETE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IN_EMPTY, NOT_INSERT_EMPTY, REAL_ABS_INV, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_MIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_MINIMAL, HULL_SUBSET, REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_SUB, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_MUL_EQ_0, VECTOR_SUB_REFL, VECTOR_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_SUBSET, EVENTUALLY_AT, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, INTERIOR_OPEN, INTERIOR_SUBSET, OPEN_CONTAINS_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_at, SUBSET_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_ON_INTERIOR, LIM_AT, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_TRANSFORM, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { WF_INDUCT_TAC, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt
  let { PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHSTART_JOIN, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONVEX_BALL, CONVEX_HULL_2, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let CAUCHY_THEOREM_TRIANGLE_COFINITE ← prove
   r"!f s a b c.
        f continuous_on (convex hull {a,b,c}) /\
        FINITE s /\
        (!x. x IN interior(convex hull {a,b,c}) DIFF s
             ==> f complex_differentiable (at x))
        ==> (f has_path_integral Cx(&0))
            (linepath (a,b) ++ linepath(b,c) ++ linepath(c,a))"
   (GEN_TAC THEN GEN_TAC THEN WF_INDUCT_TAC (← q r"CARD(s:complex->bool)") THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:complex->bool = {}") THENL
     [MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE_INTERIOR THEN
      ASM_REWRITE_TAC [holomorphic_on] THEN X_GEN_TAC (← q r"z:complex") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_REWRITE_TAC [complex_differentiable, IN_DIFF, NOT_IN_EMPTY] THEN
      MESON_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"d:complex")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DELETE (d:complex)")) THEN
    ASM_SIMP_TAC [CARD_DELETE, CARD_EQ_0,
                   ← ARITH_RULE (← q r"n - 1 < n <=> ~(n = 0)")] THEN
    ASM_CASES_TAC (← q r"(d:complex) IN convex hull {a,b,c}") THENL
     [ALL_TAC,
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [FINITE_DELETE, IN_DIFF, IN_DELETE] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET]] THEN
    DISCH_TAC THEN SUBGOAL_THEN
     (← q r"(f has_path_integral Cx(&0))
      (linepath(a,b) ++ linepath(b,d) ++ linepath(d,a)) /\
      (f has_path_integral Cx(&0))
      (linepath(b,c) ++ linepath(c,d) ++ linepath(d,b)) /\
      (f has_path_integral Cx(&0))
      (linepath(c,a) ++ linepath(a,d) ++ linepath(d,c))")
    MP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]) THEN
      REPEAT CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [FINITE_DELETE] THEN
      (CONJ_TAC THENL
        [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
         EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN ASM_REWRITE_TAC [] THEN
         MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
         REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
         REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
         MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN
         REWRITE_TAC [IN_INSERT],
         ALL_TAC]) THEN
      ASM_REWRITE_TAC [FINITE_DELETE, IN_DIFF, IN_DELETE] THEN
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [DE_MORGAN_THM]) THEN
      (ASM_CASES_TAC (← q r"x:complex = d") THEN ASM_REWRITE_TAC [] THENL
        [ASM_MESON_TAC [NOT_IN_INTERIOR_CONVEX_HULL_3], ALL_TAC]) THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [IN_DIFF] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"x IN interior s
        ==> interior s SUBSET interior t ==> x IN interior t"))) THEN
      MATCH_MP_TAC SUBSET_INTERIOR THEN
      MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
      SIMP_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN REWRITE_TAC [IN_INSERT],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"f path_integrable_on
      (linepath (a,b) ++ linepath(b,c) ++ linepath(c,a))")
    MP_TAC THENL
     [SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN, VALID_PATH_LINEPATH,
               PATHSTART_JOIN, PATHFINISH_JOIN, PATHSTART_LINEPATH,
               PATHFINISH_LINEPATH] THEN
      STRIP_ASSUME_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"]
                    SEGMENTS_SUBSET_CONVEX_HULL) THEN
      ASM_MESON_TAC [PATH_INTEGRABLE_CONTINUOUS_LINEPATH, CONTINUOUS_ON_SUBSET],
      ALL_TAC] THEN
    REWRITE_TAC [path_integrable_on, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"y:complex") THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN
     (MP_TAC o MATCH_MP HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL)) THEN
    ASM_CASES_TAC (← q r"y = Cx(&0)") THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], UNDISCH_TAC (← q r"~(y = Cx(&0))")] THEN
    REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(f:complex->complex) continuous_on segment[a,d] /\
                  f continuous_on segment[b,d] /\
                  f continuous_on segment[c,d]")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN (MP_TAC o MATCH_MP
                 PATH_INTEGRAL_REVERSE_LINEPATH)) THEN
      CONV_TAC COMPLEX_RING] THEN
    REPEAT CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
    EXISTS_TAC (← q r"convex hull {a:complex,b,c}") THEN
    ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
    MATCH_MP_TAC CONVEX_HULL_SUBSET THEN
    SIMP_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [SUBSET] HULL_SUBSET) THEN REWRITE_TAC [IN_INSERT])

  /- Existence of a primitive. -/

  let STARLIKE_CONVEX_SUBSET ← prove
   r"!s a b c:real^N.
        a IN s /\ segment[b,c] SUBSET s /\
        (!x. x IN s ==> segment[a,x] SUBSET s)
        ==> convex hull {a,b,c} SUBSET s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"{b:real^N,c}", ← q r"a:real^N"] CONVEX_HULL_INSERT) THEN
    REWRITE_TAC [NOT_INSERT_EMPTY] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real^N", ← q r"u:real", ← q r"v:real", ← q r"d:real^N"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"d:real^N")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET, SEGMENT_CONVEX_HULL],
      ASM_REWRITE_TAC [SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [SEGMENT_CONVEX_HULL, CONVEX_HULL_2, IN_ELIM_THM] THEN
      ASM_MESON_TAC []])

  let TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE ← prove
   r"!f s a.
      a IN s /\ open s /\ f continuous_on s /\
      (!z. z IN s ==> segment[a,z] SUBSET s) /\
      (!b c. segment[b,c] SUBSET s
             ==> path_integral (linepath(a,b)) f +
                 path_integral (linepath(b,c)) f +
                 path_integral (linepath(c,a)) f = Cx(&0))
      ==> ?g. !z. z IN s ==> (g has_complex_derivative f(z)) (at z)"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. path_integral (linepath(a,x)) f") THEN
    X_GEN_TAC (← q r"x:complex") THEN STRIP_TAC THEN
    REWRITE_TAC [has_complex_derivative] THEN
    REWRITE_TAC [has_derivative_at, LINEAR_COMPLEX_MUL] THEN
    MATCH_MP_TAC LIM_TRANSFORM THEN
    EXISTS_TAC (← q r"\y. inv(norm(y - x)) % (path_integral(linepath(x,y)) f -
                     f x * (y - x))") THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"i % (x - a) - i % (y - (z + a)) = i % (x + z - y)")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_AT] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:complex")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:complex") THEN REWRITE_TAC [dist] THEN STRIP_TAC THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
      MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex", ← q r"y:complex"]
           PATH_INTEGRAL_REVERSE_LINEPATH) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        ASM_REWRITE_TAC [IN_BALL, ← ONCE_REWRITE_RULE [NORM_SUB] dist],
        REWRITE_TAC [COMPLEX_VEC_0] THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
          (← q r"ax + xy + ya = Cx(&0) ==> ay = --ya ==> xy + ax - ay = Cx(&0)"))) THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
        REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
        MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
        REWRITE_TAC [SUBSET, IN_BALL, IN_INSERT, NOT_IN_EMPTY] THEN
        REPEAT STRIP_TAC THEN
        ASM_REWRITE_TAC [dist, NORM_0, VECTOR_SUB_REFL] THEN
        ASM_MESON_TAC [NORM_SUB]],
      REWRITE_TAC [LIM_AT] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(f:complex->complex) continuous at x") MP_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_INTERIOR THEN ASM_MESON_TAC [INTERIOR_OPEN],
        ALL_TAC] THEN
      REWRITE_TAC [continuous_at, dist, VECTOR_SUB_RZERO] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:complex")) THEN
      ASM_REWRITE_TAC [SUBSET, IN_BALL, dist] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"min d1 d2") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      X_GEN_TAC (← q r"y:complex") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"f path_integrable_on linepath(x,y)") MP_TAC THENL
       [MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(x:complex,d2)") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
          MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
          REWRITE_TAC [SUBSET, IN_BALL, IN_INSERT, NOT_IN_EMPTY] THEN
          REPEAT STRIP_TAC THEN
          ASM_REWRITE_TAC [dist, NORM_0, VECTOR_SUB_REFL] THEN
          ASM_MESON_TAC [NORM_SUB],
          ASM_REWRITE_TAC [SUBSET, IN_BALL, dist]],
        ALL_TAC] THEN
      REWRITE_TAC [path_integrable_on, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:complex") THEN
      MP_TAC (← SPECL [← q r"x:complex", ← q r"y:complex", ← q r"(f:complex->complex) x"]
                    HAS_PATH_INTEGRAL_CONST_LINEPATH) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (fun th => tactic_of do pure (ASSUME_TAC (← CONJUNCT2 th) THEN MP_TAC th)) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP PATH_INTEGRAL_UNIQUE) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_SUB) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_NEG) THEN
      REWRITE_TAC [COMPLEX_NEG_SUB] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= e / &2 /\ &0 < e ==> x < e")) THEN
      ASM_REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
      EXISTS_TAC (← q r"\w. (f:complex->complex) w - f x") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> &0 <= e / &2")] THEN
      X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [REAL_LET_TRANS, SEGMENT_BOUND]])

  let HOLOMORPHIC_STARLIKE_PRIMITIVE ← prove
   r"!f s k. open s /\ starlike s /\ FINITE k /\ f continuous_on s /\
           (!x. x IN s DIFF k ==> f complex_differentiable at x)
           ==> ?g. !x. x IN s ==> (g has_complex_derivative f(x)) (at x)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:complex") STRIP_ASSUME_TAC o
          GEN_REWRITE_RULE id [starlike]) THEN
    MATCH_MP_TAC TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE THEN
    EXISTS_TAC (← q r"a:complex") THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:complex", ← q r"y:complex"] THEN STRIP_TAC THEN
    MATCH_MP_TAC HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL THEN
    MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE_COFINITE THEN
    EXISTS_TAC (← q r"k:complex->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"convex hull {a:complex,x,y} SUBSET s") ASSUME_TAC THENL
     [MATCH_MP_TAC STARLIKE_CONVEX_SUBSET THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_DIFF] THEN
    ASM_MESON_TAC [SUBSET, INTERIOR_SUBSET])

  pure { CAUCHY_THEOREM_TRIANGLE_COFINITE, STARLIKE_CONVEX_SUBSET,
         TRIANGLE_PATH_INTEGRALS_STARLIKE_PRIMITIVE, HOLOMORPHIC_STARLIKE_PRIMITIVE }
/- ------------------------------------------------------------------------- -/
/- Cauchy's theorem for starlike and convex sets and discs; local           -/
/- primitives; integrability of holomorphic functions.                       -/
/- (cauchy.ml 3061-3345)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYL where
  CAUCHY_THEOREM_STARLIKE : thm
  CAUCHY_THEOREM_STARLIKE_SIMPLE : thm
  TRIANGLE_PATH_INTEGRALS_CONVEX_PRIMITIVE : thm
  PATHINTEGRAL_CONVEX_PRIMITIVE : thm
  HOLOMORPHIC_CONVEX_PRIMITIVE : thm
  CAUCHY_THEOREM_CONVEX : thm
  CAUCHY_THEOREM_CONVEX_SIMPLE : thm
  CAUCHY_THEOREM_DISC : thm
  CAUCHY_THEOREM_DISC_SIMPLE : thm
  PATH_INTEGRAL_LOCAL_PRIMITIVE_LEMMA : thm
  PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY : thm
  PATH_INTEGRAL_LOCAL_PRIMITIVE : thm
  PATH_INTEGRABLE_HOLOMORPHIC : thm
  PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYL [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYF : KYF) (BKYG : KYG) (BKYH : KYH) (BKYK : KYK) : ExceptT String IO KYL := do
  -- @@SCOPE BEGIN
  let { PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON, PIECEWISE_DIFFERENTIABLE_ON_SUBSET,
        .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE, has_path_integral, path_integrable_on,
        PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { CAUCHY_THEOREM_PRIMITIVE, PATH_INTEGRAL_PRIMITIVE_LEMMA, .. } := BKYF
  let { HAS_PATH_INTEGRAL_BOUND_LINEPATH, HAS_PATH_INTEGRAL_CONST_LINEPATH,
        HAS_PATH_INTEGRAL_NEG, HAS_PATH_INTEGRAL_SUB, PATH_INTEGRABLE_CONTINUOUS_LINEPATH,
        PATH_INTEGRAL_REVERSE_LINEPATH, .. } := BKYG
  let { HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL, .. } := BKYH
  let { CAUCHY_THEOREM_TRIANGLE_COFINITE, HOLOMORPHIC_STARLIKE_PRIMITIVE, .. } := BKYK
  let { INTEGRABLE_ON_EMPTY, .. } := D.qintegration
  let { INTEGRABLE_ON_LITTLE_SUBINTERVALS, .. } := D.mt.ra.qintegration
  let { complex_differentiable, has_complex_derivative, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET,
        holomorphic_on, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_OPEN,
        HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { COMPLEX_NEG_SUB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { LINEAR_COMPLEX_MUL, .. } := D.mt.ra.ts.cn.cxh
  let { SEGMENT_BOUND, .. } := D.mt.ra.ts.cn.qconvex
  let { has_derivative_within, .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { integrable_on, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFF_EMPTY, FINITE_RULES, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMP_IMP, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, REAL_ABS_INV,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LET_TRANS, REAL_LT_01, REAL_LT_IMP_LE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_SYM, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_MINIMAL, REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_MUL, NORM_SUB, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_MUL_EQ_0, VECTOR_SUB_RZERO, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_SUBSET, EVENTUALLY_WITHIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, INTERIOR_CBALL, INTERIOR_SUBSET, LIM_WITHIN, OPEN_BALL,
        OPEN_CONTAINS_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_on, continuous_within, OPEN_INTERIOR, SUBSET_INTERIOR,
        .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { LIM_EVENTUALLY, LIM_TRANSFORM, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONVEX_BALL, CONVEX_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  /- Cauchy's theorem for an open starlike set. -/

  let CAUCHY_THEOREM_STARLIKE ← prove
   r"!f s k g. open s /\ starlike s /\ FINITE k /\ f continuous_on s /\
             (!x. x IN s DIFF k ==> f complex_differentiable at x) /\
             valid_path g /\ (path_image g) SUBSET s /\
             pathfinish g = pathstart g
             ==> (f has_path_integral Cx(&0)) (g)"
   (MESON_TAC [HOLOMORPHIC_STARLIKE_PRIMITIVE, CAUCHY_THEOREM_PRIMITIVE,
              HAS_COMPLEX_DERIVATIVE_AT_WITHIN])

  let CAUCHY_THEOREM_STARLIKE_SIMPLE ← prove
   r"!f s g. open s /\ starlike s /\ f holomorphic_on s /\
           valid_path g /\ (path_image g) SUBSET s /\
           pathfinish g = pathstart g
           ==> (f has_path_integral Cx(&0)) (g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_STARLIKE THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"{}:complex->bool"] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, FINITE_RULES] THEN
    REWRITE_TAC [IN_DIFF, NOT_IN_EMPTY, complex_differentiable] THEN
    ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, holomorphic_on])

  /- For a convex set we can avoid assuming openness and boundary analyticity. -/

  let TRIANGLE_PATH_INTEGRALS_CONVEX_PRIMITIVE ← prove
   r"!f s a.
      a IN s /\ convex s /\ f continuous_on s /\
      (!b c. b IN s /\ c IN s
             ==> path_integral (linepath(a,b)) f +
                 path_integral (linepath(b,c)) f +
                 path_integral (linepath(c,a)) f = Cx(&0))
      ==> ?g. !z. z IN s ==> (g has_complex_derivative f(z)) (at z within s)"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. path_integral (linepath(a,x)) f") THEN
    X_GEN_TAC (← q r"x:complex") THEN STRIP_TAC THEN
    REWRITE_TAC [has_complex_derivative] THEN
    REWRITE_TAC [has_derivative_within, LINEAR_COMPLEX_MUL] THEN
    MATCH_MP_TAC LIM_TRANSFORM THEN
    EXISTS_TAC (← q r"\y. inv(norm(y - x)) % (path_integral(linepath(x,y)) f -
                     f x * (y - x))") THEN
    REWRITE_TAC [← VECTOR_ARITH
     (← q r"i % (x - a) - i % (y - (z + a)) = i % (x + z - y)")] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_WITHIN] THEN
      EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
      X_GEN_TAC (← q r"y:complex") THEN STRIP_TAC THEN
      REWRITE_TAC [VECTOR_MUL_EQ_0] THEN DISJ2_TAC THEN
      MP_TAC (← SPECL [← q r"f:complex->complex", ← q r"a:complex", ← q r"y:complex"]
           PATH_INTEGRAL_REVERSE_LINEPATH) THEN
      ANTS_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
        EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
        MATCH_MP_TAC HULL_MINIMAL THEN ASM SET_TAC [],
        REWRITE_TAC [COMPLEX_VEC_0] THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
          (← q r"ax + xy + ya = Cx(&0) ==> ay = --ya ==> xy + ax - ay = Cx(&0)"))) THEN
        ASM_SIMP_TAC []],
      REWRITE_TAC [LIM_WITHIN] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:complex->complex) continuous (at x within s)") MP_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN], ALL_TAC] THEN
      REWRITE_TAC [continuous_within, dist, VECTOR_SUB_RZERO] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d1:real") THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"y:complex") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"f path_integrable_on linepath(x,y)") MP_TAC THENL
       [MATCH_MP_TAC PATH_INTEGRABLE_CONTINUOUS_LINEPATH THEN
        MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
        MATCH_MP_TAC HULL_MINIMAL THEN ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [path_integrable_on, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:complex") THEN
      MP_TAC (← SPECL [← q r"x:complex", ← q r"y:complex", ← q r"(f:complex->complex) x"]
                    HAS_PATH_INTEGRAL_CONST_LINEPATH) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (fun th => tactic_of do pure (ASSUME_TAC (← CONJUNCT2 th) THEN MP_TAC th)) THEN
      FIRST_ASSUM (SUBST1_TAC o MATCH_MP PATH_INTEGRAL_UNIQUE) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_SUB) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_NEG) THEN
      REWRITE_TAC [COMPLEX_NEG_SUB] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= e / &2 /\ &0 < e ==> x < e")) THEN
      ASM_REWRITE_TAC [NORM_MUL, REAL_ABS_INV, REAL_ABS_NORM] THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [← GSYM real_div] THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_BOUND_LINEPATH THEN
      EXISTS_TAC (← q r"\w. (f:complex->complex) w - f x") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < e ==> &0 <= e / &2")] THEN
      X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"w IN t ==> t SUBSET s ==> w IN s"))) THEN
        REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
        MATCH_MP_TAC HULL_MINIMAL THEN ASM SET_TAC [],
        ASM_MESON_TAC [REAL_LET_TRANS, SEGMENT_BOUND]]])

  let PATHINTEGRAL_CONVEX_PRIMITIVE ← prove
   r"!f s. convex s /\ f continuous_on s /\
         (!a b c. a IN s /\ b IN s /\ c IN s
                  ==>  (f has_path_integral Cx(&0))
                       (linepath (a,b) ++ linepath(b,c) ++ linepath(c,a)))
         ==> ?g. !x. x IN s
                     ==> (g has_complex_derivative f(x)) (at x within s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:complex->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:complex") STRIP_ASSUME_TAC o
          GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    MATCH_MP_TAC TRIANGLE_PATH_INTEGRALS_CONVEX_PRIMITIVE THEN
    EXISTS_TAC (← q r"a:complex") THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HAS_CHAIN_INTEGRAL_CHAIN_INTEGRAL THEN
    ASM_SIMP_TAC [])

  let HOLOMORPHIC_CONVEX_PRIMITIVE ← prove
   r"!f s k. convex s /\ FINITE k /\ f continuous_on s /\
           (!x. x IN interior(s) DIFF k ==> f complex_differentiable at x)
           ==> ?g. !x. x IN s
                       ==> (g has_complex_derivative f(x)) (at x within s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATHINTEGRAL_CONVEX_PRIMITIVE THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_TRIANGLE_COFINITE THEN
    EXISTS_TAC (← q r"k:complex->bool") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN EXISTS_TAC (← q r"s:complex->bool") THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"w:complex") THEN
      DISCH_THEN (fun th => FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
      SPEC_TAC (← q r"w:complex", ← q r"w:complex") THEN ASM_REWRITE_TAC [← GSYM SUBSET] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> (s DIFF k) SUBSET (t DIFF k)")) THEN
      MATCH_MP_TAC SUBSET_INTERIOR] THEN
    MATCH_MP_TAC HULL_MINIMAL THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let CAUCHY_THEOREM_CONVEX ← prove
   r"!f s k g. convex s /\ FINITE k /\ f continuous_on s /\
             (!x. x IN interior(s) DIFF k ==> f complex_differentiable at x) /\
             valid_path g /\ (path_image g) SUBSET s /\
             pathfinish g = pathstart g
             ==> (f has_path_integral Cx(&0)) (g)"
   (MESON_TAC [HOLOMORPHIC_CONVEX_PRIMITIVE, CAUCHY_THEOREM_PRIMITIVE])

  let CAUCHY_THEOREM_CONVEX_SIMPLE ← prove
   r"!f s g. convex s /\ f holomorphic_on s /\
           valid_path g /\ (path_image g) SUBSET s /\
           pathfinish g = pathstart g
           ==> (f has_path_integral Cx(&0)) (g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_CONVEX THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"{}:complex->bool"] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, FINITE_RULES] THEN
    REWRITE_TAC [IN_DIFF, NOT_IN_EMPTY, complex_differentiable] THEN
    SUBGOAL_THEN (← q r"f holomorphic_on (interior s)") MP_TAC THENL
     [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET, INTERIOR_SUBSET], ALL_TAC] THEN
    MESON_TAC [holomorphic_on, HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN,
              OPEN_INTERIOR])

  /- In particular for a disc. -/

  let CAUCHY_THEOREM_DISC ← prove
   r"!f g k a e.
        FINITE k /\ f continuous_on cball(a,e) /\
        (!x. x IN ball(a,e) DIFF k ==> f complex_differentiable at x) /\
        valid_path g /\ (path_image g) SUBSET cball(a,e) /\
        pathfinish g = pathstart g
        ==> (f has_path_integral Cx(&0)) (g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_CONVEX THEN
    MAP_EVERY EXISTS_TAC [← q r"cball(a:complex,e)", ← q r"k:complex->bool"] THEN
    ASM_REWRITE_TAC [INTERIOR_CBALL, CONVEX_CBALL])

  let CAUCHY_THEOREM_DISC_SIMPLE ← prove
   r"!f g a e.
        f holomorphic_on ball(a,e) /\
        valid_path g /\ (path_image g) SUBSET ball(a,e) /\
        pathfinish g = pathstart g
        ==> (f has_path_integral Cx(&0)) (g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_THEOREM_CONVEX_SIMPLE THEN
    EXISTS_TAC (← q r"ball(a:complex,e)") THEN ASM_REWRITE_TAC [CONVEX_BALL, OPEN_BALL])

  /- Generalize integrability to local primitives. -/

  let PATH_INTEGRAL_LOCAL_PRIMITIVE_LEMMA ← prove
   r"!f f' g s a b.
        (!x. x IN s ==> (f has_complex_derivative f' x) (at x within s)) /\
        g piecewise_differentiable_on interval[a,b] /\
        (!x. x IN interval[a,b] ==> g(x) IN s)
        ==> (\x. f' (g x) * vector_derivative g (at x within interval[a,b]))
            integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"interval[a:real^1,b] = {}") THENL
     [ASM_REWRITE_TAC [INTEGRABLE_ON_EMPTY],
      REWRITE_TAC [integrable_on] THEN
      EXISTS_TAC (← q r"(f:complex->complex) (g(b:real^1)) - f(g a)") THEN
      MATCH_MP_TAC PATH_INTEGRAL_PRIMITIVE_LEMMA THEN
      ASM_MESON_TAC []])

  let PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY ← prove
   r"!f g s a b.
    (!x. x IN s
         ==> ?d h. &0 < d /\
                   !y. norm(y - x) < d
                       ==> (h has_complex_derivative f(y)) (at y within s)) /\
    g piecewise_differentiable_on interval[a,b] /\
    (!x. x IN interval[a,b] ==> g(x) IN s)
    ==> (\x. f(g x) * vector_derivative g (at x)) integrable_on interval[a,b]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_ON_LITTLE_SUBINTERVALS THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:real^1->complex) x")) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:real", ← q r"h:complex->complex"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
      PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON) THEN
    REWRITE_TAC [continuous_on] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:real^1")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SIMP_TAC [integrable_on, ← GSYM HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE] THEN
    REWRITE_TAC [← GSYM integrable_on] THEN
    MATCH_MP_TAC PATH_INTEGRAL_LOCAL_PRIMITIVE_LEMMA THEN
    MAP_EVERY EXISTS_TAC
     [← q r"h:complex->complex", ← q r"IMAGE (g:real^1->complex) (interval[u,v])"] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN
      CONJ_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [← GSYM dist] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_MESON_TAC [SUBSET, IN_BALL, DIST_SYM],
      ASM_MESON_TAC [PIECEWISE_DIFFERENTIABLE_ON_SUBSET],
      ASM SET_TAC []])

  let PATH_INTEGRAL_LOCAL_PRIMITIVE ← prove
   r"!f g s.
        (!x. x IN s
         ==> ?d h. &0 < d /\
                   !y. norm(y - x) < d
                       ==> (h has_complex_derivative f(y)) (at y within s)) /\
        valid_path g /\ (path_image g) SUBSET s
        ==> f path_integrable_on g"
   (REWRITE_TAC [valid_path, path_image, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [path_integrable_on, has_path_integral] THEN
    REWRITE_TAC [HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE] THEN
    REWRITE_TAC [← GSYM integrable_on, PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY])

  /- In particular if a function is holomorphic. -/

  let PATH_INTEGRABLE_HOLOMORPHIC ← prove
   r"!f g s k.
        open s /\ FINITE k /\
        f continuous_on s /\
        (!x. x IN s DIFF k ==> f complex_differentiable at x) /\
        valid_path g /\ path_image g SUBSET s
        ==> f path_integrable_on g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRAL_LOCAL_PRIMITIVE THEN
    EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"ball(z:complex,d)",
                   ← q r"k:complex->bool"] HOLOMORPHIC_CONVEX_PRIMITIVE) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [CONVEX_BALL, DIFF_EMPTY] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET], ALL_TAC] THEN
      GEN_TAC THEN DISCH_THEN (fun th =>
          FIRST_X_ASSUM MATCH_MP_TAC THEN MP_TAC th) THEN
      SIMP_TAC [IN_DIFF] THEN ASM_MESON_TAC [INTERIOR_SUBSET, SUBSET],
      MATCH_MP_TAC MONO_EXISTS THEN
      SIMP_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, OPEN_BALL] THEN
      ONCE_REWRITE_TAC [NORM_SUB] THEN REWRITE_TAC [IN_BALL, dist] THEN
      ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN]])

  let PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE ← prove
   r"!f g s. open s /\ f holomorphic_on s /\ valid_path g /\ path_image g SUBSET s
           ==> f path_integrable_on g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRABLE_HOLOMORPHIC THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"{}:complex->bool"] THEN
    ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, FINITE_RULES, DIFF_EMPTY] THEN
    ASM_MESON_TAC [HOLOMORPHIC_ON_OPEN, complex_differentiable])

  pure { CAUCHY_THEOREM_STARLIKE, CAUCHY_THEOREM_STARLIKE_SIMPLE,
         TRIANGLE_PATH_INTEGRALS_CONVEX_PRIMITIVE, PATHINTEGRAL_CONVEX_PRIMITIVE,
         HOLOMORPHIC_CONVEX_PRIMITIVE, CAUCHY_THEOREM_CONVEX,
         CAUCHY_THEOREM_CONVEX_SIMPLE, CAUCHY_THEOREM_DISC, CAUCHY_THEOREM_DISC_SIMPLE,
         PATH_INTEGRAL_LOCAL_PRIMITIVE_LEMMA, PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY,
         PATH_INTEGRAL_LOCAL_PRIMITIVE, PATH_INTEGRABLE_HOLOMORPHIC,
         PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Key fact that path integral is the same for a "nearby" path; hence a     -/
/- "length" for bounds on analytic functions in open sets.                   -/
/- (cauchy.ml 3346-3697)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYM where
  PATH_INTEGRAL_NEARBY_ENDS : thm
  PATH_INTEGRAL_NEARBY_LOOP : thm
  VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION : thm
  PATH_INTEGRAL_BOUND_EXISTS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYM [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYL : KYL) : ExceptT String IO KYM := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, .. } := BKYA
  let { valid_path, VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_PATH_INTEGRAL_INTEGRABLE, PATH_INTEGRABLE_ON, PATH_INTEGRABLE_REVERSEPATH,
        PATH_INTEGRAL_REVERSEPATH, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { PATH_INTEGRABLE_JOIN, PATH_INTEGRAL_JOIN, VALID_PATH_JOIN_EQ, .. } := BKYD
  let { PATH_INTEGRAL_TRIVIAL, VALID_PATH_LINEPATH, .. } := BKYE
  let { CAUCHY_THEOREM_PRIMITIVE, PATH_INTEGRAL_INTEGRAL, PATH_INTEGRAL_SUBPATH_COMBINE,
        PATH_INTEGRAL_SUBPATH_REFL, VALID_PATH_SUBPATH, .. } := BKYF
  let { HOLOMORPHIC_CONVEX_PRIMITIVE, PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE, .. } := BKYL
  let { COMPACT_IMP_HEINE_BOREL, .. } := D.qtopology
  let { CONTENT_UNIT_1, .. } := D.qintegration
  let { REVERSEPATH_LINEPATH, .. } := D.qpaths
  let { CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbj
  let { HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbk
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { complex_differentiable, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, holomorphic_on,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON, .. } := D.mt.ra.ts.qderivatives
  let { complex_sub, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_SUB_REFL, .. } := D.mt.ra.ts.cn.cxb
