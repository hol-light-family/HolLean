    ASM_REWRITE_TAC [] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  pure { BLOCH_UNIT, BLOCH, BLOCH_COROLLARY }
