  let { REAL_LE_LCANCEL_IMP, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ_ALT, .. } := D.mt.ra.ts.cn.cx.cvx.core2
