    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:complex", ← q r"t:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(C * Cx r) * b") THEN
    FIRST_ASSUM (MP_TAC o ISPEC (← q r"\z. (C * Cx r) * z") o MATCH_MP IMAGE_SUBSET) THEN
