    ABBREV_TAC (← q r"C = complex_derivative f a") THEN
    SUBGOAL_THEN (← q r"&0 < norm(C:complex)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPLEX_NORM_NZ], STRIP_TAC] THEN
