def setupKYBE [HolBase] (D : CauchyDeps) (BKYBD : KYBD) : ExceptT String IO KYBE := do
  -- @@SCOPE BEGIN
  let { OPEN_MAPPING_THM, .. } := BKYBD
  let { FRONTIER_INTER_SUBSET_INTER, FRONTIER_INTERIOR_SUBSET, LIM_AT_INFINITY_WITHIN_POS,
        .. } := D.qtopology
