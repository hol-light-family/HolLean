          ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN, CENTRE_IN_BALL]],
        ALL_TAC] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ q /\ (p ==> r ==> s) ==> (p /\ q ==> r) ==> s")) THEN
      CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC VALID_PATH_SUBPATH THEN ASM_REWRITE_TAC [] THEN
