/- ------------------------------------------------------------------------- -/

structure KYBZ where
  SIMPLY_CONNECTED_IFF_SIMPLE : thm
  CONNECTED_COMPLEMENT_IFF_SIMPLY_CONNECTED_COMPONENTS : thm
  SIMPLY_CONNECTED_COMPONENT_PATH_COMPLEMENT : thm
  SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG : thm
  SIMPLY_CONNECTED_EQ_CONTINUOUS_SQRT : thm
  SIMPLY_CONNECTED_EQ_BORSUKIAN : thm
  BORSUKIAN_EQ_SIMPLY_CONNECTED : thm
  BORSUKIAN_SEPARATION_OPEN_CLOSED : thm
  WINDING_NUMBER_COMPOSE_CEXP : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBZ [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYF : KYF) (BKYN : KYN) (BKYY : KYY) (BKYBX : KYBX) (BKYBY : KYBY) : ExceptT String IO KYBZ := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { PATH_INTEGRAL_INTEGRAL, .. } := BKYF
  let { WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { WINDING_NUMBER_NEARBY_PATHS_EQ, .. } := BKYY
  let { SIMPLY_CONNECTED_EQ_HOLOMORPHIC_SQRT, SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC,
        .. } := BKYBX
  let { SIMPLY_CONNECTED_EQ_UNBOUNDED_COMPLEMENT_COMPONENTS, .. } := BKYBY
  let { CONTINUOUS_LOGARITHM_ON_BALL, .. } := D.mop
  let { BORSUKIAN_CONTINUOUS_LOGARITHM, .. } := D.mor
  let { BORSUKIAN_COMPONENTWISE_EQ, BORSUKIAN_SEPARATION_COMPACT, .. } := D.mos
  let { NONSEPARATION_BY_COMPONENT_EQ, .. } := D.mov
  let { CONNECTED_EQ_CONNECTED_COMPONENTS_EQ, SETDIST_EQ_0_CLOSED_COMPACT,
        .. } := D.qtopology
  let { COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS, PATHFINISH_COMPOSE, PATHSTART_COMPOSE,
        .. } := D.qpaths
  let { HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbk
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, PATH_VECTOR_POLYNOMIAL_FUNCTION,
        .. } := D.mt.rzbl
  let { COBOUNDED_IMP_UNBOUNDED, .. } := D.mt.qtopology
  let { SIMPLY_CONNECTED_IMP_CONNECTED, .. } := D.mt.qpaths
  let { COMPONENT_COMPLEMENT_CONNECTED, .. } := D.mt.qconvex
  let { DIFFERENTIABLE_ON_COMPOSE, .. } := D.mt.qderivatives
  let { CEXP_N, CEXP_NZ, CONTINUOUS_ON_CEXP, HAS_COMPLEX_DERIVATIVE_CEXP,
        .. } := D.mt.ra.tsa
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS, .. } := D.mt.ra.qintegration
  let { COMPLEX_IN_CBALL_0, .. } := D.mt.ra.ts.kna
  let { LIM_COMPLEX_DIV, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_ON_COMPLEX_DIV, .. } := D.mt.ra.ts.knc
  let { COMPLEX_DIFFERENTIABLE_IMP_DIFFERENTIABLE, has_complex_derivative,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT,
        HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_AT, .. } := D.mt.ra.ts.knf
  let { HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE, .. } := D.mt.ra.ts.knh
  let { COMPLEX_DIFFERENTIABLE_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_MUL_2, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_ENTIRE, COMPLEX_VEC_0, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_NZ, .. } := D.mt.ra.ts.cn.cxf
  let { DIFF_CHAIN_AT, .. } := D.mt.ra.ts.cn.qderivatives
  let { DIFFERENTIABLE_AT_WITHIN, VECTOR_DERIVATIVE_AT,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { INTEGRAL_EQ, INTEGRAL_UNIQUE, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { differentiable, differentiable_on, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, VECTOR_DERIVATIVE_WORKS,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { CLOSED_PATH_IMAGE, PATH_CONTINUOUS_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { AND_FORALL_THM, ARITH_EQ, DIMINDEX_2, EQ_IMP, EQ_TRANS, ETA_AX,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_INTER, IN_SING, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_IN_EMPTY, NOT_INSERT_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_MIN, REAL_LTE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, REAL_POS, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_NEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_SUBSET, BOUNDED_SUBSET_CBALL, CENTRE_IN_BALL, CLOSED_SING,
        .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_EQ_BOUNDED_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_SUBSET, INTERIOR_OPEN, LIM_ADD,
        LIM_CONST, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { closed, continuous_on, homeomorphic, homeomorphism, OPEN_INTER, SETDIST_LE_DIST,
        SETDIST_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONTINUOUS_AT, CONTINUOUS_ON_INTERIOR, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_TRANSFORM_WITHIN_OPEN, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { BOUNDED_PATH_IMAGE, COMPACT_PATH_IMAGE, CONNECTED_PATH_IMAGE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { OPEN_COMPONENTS, OPEN_IMP_LOCALLY_CONNECTED, path_image, PATH_IMAGE_NONEMPTY,
        pathfinish, pathstart, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { COMPL_COMPL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qsession
  let { COMPACT_UNIFORMLY_CONTINUOUS, COMPONENTS_EMPTY, COMPONENTS_EQ_SING, CONNECTED_UNIV,
        CONTINUOUS_ON_EMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let SIMPLY_CONNECTED_IFF_SIMPLE ← prove
   r"!s:real^2->bool.
        open s /\ bounded s
        ==> (simply_connected s <=>
             connected s /\ connected((:real^2) DIFF s))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_UNBOUNDED_COMPLEMENT_COMPONENTS] THEN
    ASM_CASES_TAC (← q r"connected(s:real^2->bool)") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL
     [REWRITE_TAC [CONNECTED_EQ_CONNECTED_COMPONENTS_EQ] THEN
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC COBOUNDED_UNIQUE_UNBOUNDED_COMPONENTS THEN
      EXISTS_TAC (← q r"(:real^2) DIFF s") THEN
      ASM_SIMP_TAC [COMPL_COMPL] THEN
      REWRITE_TAC [LE_REFL, DIMINDEX_2],
      DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(:real^2) DIFF s = {}") THEN
      ASM_REWRITE_TAC [COMPONENTS_EMPTY, NOT_IN_EMPTY] THEN
      SUBGOAL_THEN (← q r"components((:real^2) DIFF s) = {(:real^2) DIFF s}")
      SUBST1_TAC THENL [ASM_REWRITE_TAC [COMPONENTS_EQ_SING], ALL_TAC] THEN
      GEN_TAC THEN SIMP_TAC [IN_SING] THEN DISCH_TAC THEN
      MATCH_MP_TAC COBOUNDED_IMP_UNBOUNDED THEN
      ASM_REWRITE_TAC [COMPL_COMPL]])

  let CONNECTED_COMPLEMENT_IFF_SIMPLY_CONNECTED_COMPONENTS ← prove
   r"!s:real^2->bool.
        open s /\ bounded s
        ==> (connected((:real^2) DIFF s) <=>
             !c. c IN components s ==> simply_connected c)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"!c. c IN components s ==> connected((:real^2) DIFF c)") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [NONSEPARATION_BY_COMPONENT_EQ], ALL_TAC] THEN
    ASM_MESON_TAC [SIMPLY_CONNECTED_IFF_SIMPLE, OPEN_COMPONENTS,
              IN_COMPONENTS_SUBSET, BOUNDED_SUBSET, IN_COMPONENTS_CONNECTED])

  let SIMPLY_CONNECTED_COMPONENT_PATH_COMPLEMENT ← prove
   r"!g c. path g /\ c IN components((:real^2) DIFF path_image g) /\ bounded c
         ==> simply_connected c"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SIMPLY_CONNECTED_IFF_SIMPLE o snd) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          OPEN_COMPONENTS)) THEN
    ASM_SIMP_TAC [← GSYM closed, CLOSED_PATH_IMAGE] THEN DISCH_TAC THEN
    DISCH_THEN SUBST1_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP IN_COMPONENTS_CONNECTED) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC COMPONENT_COMPLEMENT_CONNECTED THEN
    EXISTS_TAC (← q r"path_image g:real^2->bool") THEN
    ASM_SIMP_TAC [SUBSET_UNIV, CONNECTED_UNIV, CONNECTED_PATH_IMAGE])

  let (SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG, SIMPLY_CONNECTED_EQ_CONTINUOUS_SQRT) ←
    CONJ_PAIR (← prove
     r"(!s. open s
        ==> (simply_connected s <=>
             connected s /\
             !f. f continuous_on s /\ (!z:complex. z IN s ==> ~(f z = Cx(&0)))
                 ==> ?g. g continuous_on s /\
                         !z. z IN s ==> f z = cexp(g z))) /\
   (!s. open s
        ==> (simply_connected s <=>
             connected s /\
             !f. f continuous_on s /\ (!z:complex. z IN s ==> ~(f z = Cx(&0)))
                 ==> ?g. g continuous_on s /\
                         !z. z IN s ==> f z = g z pow 2))"
     (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:complex->bool") THEN
      ASM_CASES_TAC (← q r"open(s:complex->bool)") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"connected(s:complex->bool)") THEN ASM_REWRITE_TAC [] THENL
       [ALL_TAC, ASM_MESON_TAC [SIMPLY_CONNECTED_IMP_CONNECTED]] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"(p ==> q) /\ (q ==> r) /\ (r ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
      REPEAT CONJ_TAC THENL
       [ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_HOMEOMORPHIC_TO_DISC] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [CONTINUOUS_ON_EMPTY, NOT_IN_EMPTY] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic]) THEN
        REWRITE_TAC [homeomorphism, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"k:complex->complex", ← q r"h:complex->complex"] THEN
        STRIP_TAC THEN X_GEN_TAC (← q r"f:complex->complex") THEN STRIP_TAC THEN
        MP_TAC (← ISPECL
         [← q r"(f:complex->complex) o (h:complex->complex)", ← q r"Cx(&0)", ← q r"&1"]
            CONTINUOUS_LOGARITHM_ON_BALL) THEN
        ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
         [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"(g:complex->complex) o (k:complex->complex)") THEN
          REWRITE_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]],
        DISCH_TAC THEN X_GEN_TAC (← q r"f:complex->complex") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:complex->complex")) THEN ASM_SIMP_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"\z:complex. cexp(g z / Cx(&2))") THEN
        ASM_SIMP_TAC [← GSYM CEXP_N, ← ExceptT.mk (COMPLEX_RING (← q r"Cx(&2) * z / Cx(&2) = z"))] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_DIV THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_CONST] THEN
        CONV_TAC COMPLEX_RING,
        DISCH_TAC THEN ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_HOLOMORPHIC_SQRT] THEN
        X_GEN_TAC (← q r"f:complex->complex") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:complex->complex")) THEN
        ASM_SIMP_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:complex->complex") THEN
        STRIP_TAC THEN ASM_SIMP_TAC [HOLOMORPHIC_ON_OPEN] THEN
        X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"~((g:complex->complex) z = Cx(&0))") ASSUME_TAC THENL
         [ASM_MESON_TAC [← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) pow 2 = Cx(&0)"))], ALL_TAC] THEN
        EXISTS_TAC (← q r"complex_derivative f z / (Cx(&2) * g z)") THEN
        REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_AT] THEN
        MATCH_MP_TAC LIM_TRANSFORM_WITHIN_OPEN THEN
        EXISTS_TAC (← q r"\x:complex. (f(x) - f(z)) / (x - z) / (g(x) + g(z))") THEN
        SUBGOAL_THEN
          (← q r"?d. &0 < d /\
               !w:complex. w IN s /\ w IN ball(z,d) ==> ~(g w + g z = Cx(&0))")
        STRIP_ASSUME_TAC THENL
         [FIRST_ASSUM (MP_TAC o SPEC (← q r"z:complex") o
          GEN_REWRITE_RULE id [continuous_on]) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"norm((g:complex->complex) z)")) THEN
          ASM_REWRITE_TAC [COMPLEX_NORM_NZ] THEN MATCH_MP_TAC MONO_EXISTS THEN
          ONCE_REWRITE_TAC [DIST_SYM] THEN
          REWRITE_TAC [IN_BALL, ← GSYM COMPLEX_VEC_0] THEN
          MESON_TAC [← NORM_ARITH (← q r"dist(z,x) < norm z ==> ~(x + z = vec 0)")],
          ALL_TAC] THEN
        EXISTS_TAC (← q r"ball(z:complex,d) INTER s") THEN
        ASM_REWRITE_TAC [IN_INTER, CENTRE_IN_BALL] THEN REPEAT CONJ_TAC THENL
         [ASM_SIMP_TAC [OPEN_INTER, OPEN_BALL],
          ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
           (← q r"~(x = z) /\ ~(gx + gz = Cx(&0))
            ==> (gx pow 2 - gz pow 2) / (x - z) / (gx + gz) =
                 (gx - gz) / (x - z)"))) THEN
          ASM_SIMP_TAC [],
          MATCH_MP_TAC LIM_COMPLEX_DIV THEN
          ASM_REWRITE_TAC [COMPLEX_ENTIRE, ← GSYM HAS_COMPLEX_DERIVATIVE_AT] THEN
          REWRITE_TAC [HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE, CX_INJ] THEN
          REWRITE_TAC [COMPLEX_MUL_2, REAL_OF_NUM_EQ, ARITH_EQ] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_DIFFERENTIABLE_AT], ALL_TAC] THEN
          MATCH_MP_TAC LIM_ADD THEN REWRITE_TAC [LIM_CONST, ← GSYM CONTINUOUS_AT] THEN
          ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                        CONTINUOUS_ON_INTERIOR, INTERIOR_OPEN]]]))

  let SIMPLY_CONNECTED_EQ_BORSUKIAN ← prove
   r"!s:real^2->bool.
        open s ==> (simply_connected s <=> connected s /\ borsukian s)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG] THEN
    AP_TERM_TAC THEN REWRITE_TAC [BORSUKIAN_CONTINUOUS_LOGARITHM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let BORSUKIAN_EQ_SIMPLY_CONNECTED ← prove
   r"!s:real^2->bool.
        open s
        ==> (borsukian s <=> !c. c IN components s ==> simply_connected c)"
   (ASM_SIMP_TAC [BORSUKIAN_COMPONENTWISE_EQ, OPEN_IMP_LOCALLY_CONNECTED] THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM
     (ASSUME_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ] OPEN_COMPONENTS)) THEN
    ASM_SIMP_TAC [SIMPLY_CONNECTED_EQ_BORSUKIAN] THEN
    ASM_MESON_TAC [IN_COMPONENTS_CONNECTED])

  let BORSUKIAN_SEPARATION_OPEN_CLOSED ← prove
   r"!s:real^2->bool.
        (open s \/ closed s) /\ bounded s
        ==> (borsukian s <=> connected((:real^2) DIFF s))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [BORSUKIAN_SEPARATION_COMPACT, COMPACT_EQ_BOUNDED_CLOSED] THEN
    ASM_SIMP_TAC [BORSUKIAN_EQ_SIMPLY_CONNECTED,
                 CONNECTED_COMPLEMENT_IFF_SIMPLY_CONNECTED_COMPONENTS])

  let WINDING_NUMBER_COMPOSE_CEXP ← prove
   r"!p. path p
       ==> winding_number(cexp o p,Cx(&0)) =
           Cx(&1) / (Cx(&2) * Cx pi * ii) * (pathfinish p - pathstart p)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?e. &0 < e /\
         !t:real^1. t IN interval[vec 0,vec 1] ==> e <= norm(cexp(p t))")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"setdist({Cx(&0)},path_image (cexp o p))") THEN
      REWRITE_TAC [SETDIST_POS_LE, ← REAL_ARITH
       (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
      ASM_SIMP_TAC [PATH_CONTINUOUS_IMAGE, CONTINUOUS_ON_CEXP, CLOSED_SING,
       SETDIST_EQ_0_CLOSED_COMPACT, COMPACT_PATH_IMAGE, PATH_IMAGE_NONEMPTY] THEN
      REWRITE_TAC [NOT_INSERT_EMPTY, path_image, IMAGE_o] THEN CONJ_TAC THENL
       [MP_TAC CEXP_NZ THEN SET_TAC [], REPEAT STRIP_TAC] THEN
      ONCE_REWRITE_TAC [← GSYM NORM_NEG] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"--x = Cx(&0) - x"))] THEN
      REWRITE_TAC [← GSYM dist] THEN MATCH_MP_TAC SETDIST_LE_DIST THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"path_image(p:real^1->complex)", ← q r"Cx(&0)"]
          BOUNDED_SUBSET_CBALL) THEN
    ASM_SIMP_TAC [BOUNDED_PATH_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN REWRITE_TAC [SUBSET, COMPLEX_IN_CBALL_0] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"cexp", ← q r"cball(Cx(&0),B + &1)"]
          COMPACT_UNIFORMLY_CONTINUOUS) THEN
    REWRITE_TAC [CONTINUOUS_ON_CEXP, COMPACT_CBALL] THEN
    REWRITE_TAC [uniformly_continuous_on] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN
    ASM_REWRITE_TAC [COMPLEX_IN_CBALL_0] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"p:real^1->complex", ← q r"min (&1) d"]
        PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_01, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^1->complex") THEN STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"winding_number(cexp o g,Cx(&0))") THEN CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC WINDING_NUMBER_NEARBY_PATHS_EQ THEN
      ASM_SIMP_TAC [PATH_CONTINUOUS_IMAGE, CONTINUOUS_ON_CEXP,
                   PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
      ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLEX_SUB_RZERO, o_THM] THEN
      REWRITE_TAC [← GSYM dist] THEN MATCH_MP_TAC REAL_LTE_TRANS THEN
      EXISTS_TAC (← q r"e:real") THEN ASM_SIMP_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [dist] THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"norm(g - p) < &1 /\ norm(p) <= B
        ==> norm(p) <= B + &1 /\ norm(g) <= B + &1")) THEN
      ASM_SIMP_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [path_image] THEN ASM SET_TAC [],
      W (MP_TAC o
        PART_MATCH (lhs o rand) WINDING_NUMBER_VALID_PATH o lhs o snd) THEN
      REWRITE_TAC [PATH_INTEGRAL_INTEGRAL, COMPLEX_SUB_RZERO] THEN ANTS_TAC THENL
       [REWRITE_TAC [path_image, IN_IMAGE, o_THM, CEXP_NZ] THEN
        REWRITE_TAC [valid_path] THEN
        MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
        MATCH_MP_TAC DIFFERENTIABLE_ON_COMPOSE THEN
        REWRITE_TAC [differentiable_on] THEN REPEAT STRIP_TAC THENL
         [MATCH_MP_TAC DIFFERENTIABLE_AT_WITHIN THEN
          REWRITE_TAC [differentiable] THEN
          ASM_MESON_TAC [has_vector_derivative,
                          HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION],
          GEN_REWRITE_TAC LAND_CONV [← GSYM ETA_AX] THEN
          MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_IMP_DIFFERENTIABLE THEN
          COMPLEX_DIFFERENTIABLE_TAC],
        DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
        EXISTS_TAC (← q r"integral (interval [vec 0,vec 1])
                      (\x. vector_derivative (g:real^1->complex) (at x))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC INTEGRAL_EQ THEN X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
          REWRITE_TAC [o_THM] THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
           (← q r"~(e = Cx(&0)) /\ v' = e * v ==> Cx(&1) / e * v' = v"))) THEN
          REWRITE_TAC [CEXP_NZ] THEN
          MATCH_MP_TAC VECTOR_DERIVATIVE_AT THEN
          MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"cexp",
           ← q r"\h. drop h % vector_derivative (g:real^1->complex) (at t)",
           ← q r"\w. cexp(g(t:real^1)) * w", ← q r"t:real^1"]
          DIFF_CHAIN_AT) THEN
          REWRITE_TAC [← GSYM has_vector_derivative, ← GSYM has_complex_derivative,
                      ← GSYM VECTOR_DERIVATIVE_WORKS,
                      HAS_COMPLEX_DERIVATIVE_CEXP, differentiable] THEN
          ANTS_TAC THENL
           [ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION,
                          has_vector_derivative],
            REWRITE_TAC [has_vector_derivative, o_DEF] THEN
            MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
            REWRITE_TAC [FUN_EQ_THM, COMPLEX_CMUL] THEN
            CONV_TAC COMPLEX_RING],
          MP_TAC (← ISPECL [← q r"g:real^1->complex",
                          ← q r"\x. vector_derivative (g:real^1->complex) (at x)",
                         ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
            FUNDAMENTAL_THEOREM_OF_CALCULUS) THEN
          ASM_REWRITE_TAC [DROP_VEC, REAL_POS] THEN ANTS_TAC THENL
           [REPEAT STRIP_TAC THEN
            MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_AT_WITHIN THEN
            REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
            REWRITE_TAC [differentiable] THEN
            ASM_MESON_TAC [has_vector_derivative,
                          HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION],
            DISCH_THEN (SUBST1_TAC o MATCH_MP INTEGRAL_UNIQUE) THEN
            RULE_ASSUM_TAC (REWRITE_RULE [pathstart, pathfinish]) THEN
            ASM_REWRITE_TAC [pathstart, pathfinish]]]]])

  pure { SIMPLY_CONNECTED_IFF_SIMPLE, CONNECTED_COMPLEMENT_IFF_SIMPLY_CONNECTED_COMPONENTS,
         SIMPLY_CONNECTED_COMPONENT_PATH_COMPLEMENT, SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG,
         SIMPLY_CONNECTED_EQ_CONTINUOUS_SQRT, SIMPLY_CONNECTED_EQ_BORSUKIAN,
         BORSUKIAN_EQ_SIMPLY_CONNECTED, BORSUKIAN_SEPARATION_OPEN_CLOSED,
         WINDING_NUMBER_COMPOSE_CEXP }

/- ------------------------------------------------------------------------- -/
/- Monodromy for continuous logs; winding number as a continuous log.        -/
/- (cauchy.ml 20031-20410)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYCA where
  MONODROMY_CONTINUOUS_LOG : thm
  WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYCA [HolBase] (D : CauchyDeps) (BKYN : KYN) (BKYP : KYP) (BKYY : KYY) (BKYBZ : KYBZ) : ExceptT String IO KYCA := do
  -- @@SCOPE BEGIN
  let { WINDING_NUMBER_EQUAL, WINDING_NUMBER_JOIN, WINDING_NUMBER_OFFSET,
        WINDING_NUMBER_REVERSEPATH, WINDING_NUMBER_TRIVIAL, .. } := BKYN
  let { WINDING_NUMBER_AHLFORS_FULL, .. } := BKYP
  let { WINDING_NUMBER_NEARBY_PATHS_EQ, WINDING_NUMBER_SUBPATH_COMBINE, .. } := BKYY
  let { SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG, WINDING_NUMBER_COMPOSE_CEXP, .. } := BKYBZ
  let { let_CONV, LET_TAC, .. } := D
  let { LIM_TRANSFORM_AT, .. } := D.qtopology
  let { SELECT_AX, .. } := D.qsession
  let { CONTINUOUS_ON_COMPONENTS_OPEN, PATH_COMPOSE_JOIN, PATH_COMPOSE_REVERSEPATH,
        PATH_IMAGE_COMPOSE, PATH_JOIN_EQ, PATHFINISH_COMPOSE, PATHSTART_COMPOSE,
        SUBPATH_REFL, .. } := D.qpaths
  let { CONNECTED_COMPONENT_EQ, .. } := D.mt.qtopology
  let { CONVEX_IMP_SIMPLY_CONNECTED, .. } := D.mt.qpaths
  let { CEXP_ADD, CEXP_NZ, CONTINUOUS_ON_CEXP, .. } := D.mt.ra.tsa
  let { CEXP_CLOG, .. } := D.mt.ra.tsm
  let { LIM_NULL_COMPLEX_LMUL, .. } := D.mt.ra.ts.knb
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { COMPLEX_MUL_RZERO, COMPLEX_SUB_0, COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { CONNECTED_CONNECTED_COMPONENT, .. } := D.mt.ra.ts.cn.ms.qtopology1
  let { ASM_MESON_TAC, NORM_ARITH, SELECT_CONV, SET_RULE, SET_TAC, VECTOR_ARITH,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { PATH_CONTINUOUS_IMAGE, PATH_IMAGE_SUBPATH_GEN, PATH_IMAGE_SUBPATH_SUBSET,
        PATH_SUBPATH, PATHFINISH_SUBPATH, PATHSTART_SUBPATH, SUBPATH_TRIVIAL,
        .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_SUBSET, EQ_TRANS, ETA_AX,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IN, INSERT_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNION, LEFT_IMP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { SUBSET, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, UNION_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { HULL_MINIMAL, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_POS_LT, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_ADD_ASSOC, VECTOR_SUB, VECTOR_SUB_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONNECTED_COMPONENT_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_ADD, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ,
        CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        CONTINUOUS_ON_SUBSET, CONTINUOUS_WITHIN, EVENTUALLY_AT,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_COMPONENTS_CONNECTED, IN_COMPONENTS_NONEMPTY, IN_COMPONENTS_SUBSET,
        OPEN_BALL, OPEN_CONTAINS_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_on, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_OPEN_PATH_CONNECTED, path_connected, .. } := D.mt.ra.ts.cn.ms.ig.dv.qpaths
  let { CONNECTED_COMPONENT_REFL, CONTINUOUS_AT, CONTINUOUS_AT_WITHIN,
        CONTINUOUS_ON_EQ_CONTINUOUS_AT, CONTINUOUS_WITHIN_COMPOSE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { LIM_EVENTUALLY, LIM_NULL, LIM_TRANSFORM, LIM_TRANSFORM_WITHIN,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { CONVEX_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qconvex
  let { OPEN_COMPONENTS, OPEN_CONNECTED_COMPONENT, path, path_image, PATH_IMAGE_JOIN,
        PATH_IMAGE_LINEPATH, PATH_IMAGE_REVERSEPATH, PATH_JOIN, PATH_LINEPATH,
        PATH_REVERSEPATH, pathfinish, PATHFINISH_IN_PATH_IMAGE, PATHFINISH_JOIN,
        PATHFINISH_LINEPATH, PATHFINISH_REVERSEPATH, pathstart, PATHSTART_IN_PATH_IMAGE,
        PATHSTART_JOIN, PATHSTART_LINEPATH, PATHSTART_REVERSEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { IN_COMPONENTS, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let MONODROMY_CONTINUOUS_LOG ← (do
    let lemma ← prove
     r"!f g s p.
             f continuous_on s /\ g continuous_on s /\
             (!z:complex. z IN s ==> f(z) = cexp(g z)) /\
             path p /\ path_image p SUBSET s
             ==> winding_number(f o p,Cx(&0)) =
                 Cx(&1) / (Cx(&2) * Cx pi * ii) *
                 (pathfinish(g o p) - pathstart(g o p))"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
      EXISTS_TAC (← q r"winding_number(cexp o g o (p:real^1->complex),Cx(&0))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC WINDING_NUMBER_NEARBY_PATHS_EQ THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
          MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          REWRITE_TAC [PATHSTART_COMPOSE] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [SUBSET, PATHSTART_IN_PATH_IMAGE],
          REWRITE_TAC [PATHFINISH_COMPOSE] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [SUBSET, PATHFINISH_IN_PATH_IMAGE],
          GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [o_THM, COMPLEX_SUB_RZERO] THEN
          MATCH_MP_TAC (← NORM_ARITH
           (← q r"x = y /\ ~(z = vec 0) ==> norm(x - y) < norm z")) THEN
          REWRITE_TAC [COMPLEX_VEC_0, CEXP_NZ] THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [SUBSET, path_image, IN_IMAGE]],
        MATCH_MP_TAC WINDING_NUMBER_COMPOSE_CEXP THEN
        ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
        MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
        ASM_MESON_TAC [CONTINUOUS_ON_SUBSET]])
    prove
     r"!f:complex->complex s.
        open s /\ f continuous_on s /\
        (!z. z IN s ==> ~(f z = Cx(&0)))
        ==> ((!p. path p /\ path_image p SUBSET s /\
                  pathfinish p = pathstart p
                  ==> winding_number(f o p,Cx(&0)) = Cx(&0)) <=>
             (?g. g continuous_on s /\ !z. z IN s ==> f(z) = cexp(g z)))"
      (REPEAT STRIP_TAC THEN EQ_TAC THENL
       [ALL_TAC,
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:complex->complex") STRIP_ASSUME_TAC) THEN
        X_GEN_TAC (← q r"p:real^1->complex") THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"g:complex->complex",
                       ← q r"s:complex->bool", ← q r"p:real^1->complex"]
            lemma) THEN
        ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
        REWRITE_TAC [COMPLEX_SUB_REFL, COMPLEX_MUL_RZERO]] THEN
      DISCH_TAC THEN
      EXISTS_TAC (← q r"\z. let c = connected_component s (z:complex) in
                      let z0 = (@) c in
                      let p = @p. path p /\ path_image p SUBSET c /\
                                  pathstart p = z0 /\ pathfinish p = z in
                      Cx(&2) * Cx(pi) * ii * winding_number(f o p,Cx(&0)) +
                      clog(f z0)") THEN

      CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
        REPEAT LET_TAC THEN
        SUBGOAL_THEN (← q r"(z:complex) IN c") ASSUME_TAC THENL
         [ASM_MESON_TAC [CONNECTED_COMPONENT_REFL, IN], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(z0:complex) IN c") ASSUME_TAC THENL
         [EXPAND_TAC "z0" THEN REWRITE_TAC [IN] THEN MATCH_MP_TAC SELECT_AX THEN
          ASM_MESON_TAC [IN],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(c:complex->bool) SUBSET s") ASSUME_TAC THENL
         [ASM_MESON_TAC [CONNECTED_COMPONENT_SUBSET], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"connected(c:complex->bool)") ASSUME_TAC THENL
         [ASM_MESON_TAC [CONNECTED_CONNECTED_COMPONENT], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"open(c:complex->bool)") ASSUME_TAC THENL
         [ASM_MESON_TAC [OPEN_CONNECTED_COMPONENT], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"path_connected(c:complex->bool)") ASSUME_TAC THENL
         [ASM_MESON_TAC [CONNECTED_OPEN_PATH_CONNECTED], ALL_TAC] THEN
        SUBGOAL_THEN
         (← q r"path p /\ path_image p SUBSET c /\
          pathstart p = z0 /\ pathfinish p = (z:complex)")
        STRIP_ASSUME_TAC THENL
         [EXPAND_TAC "p" THEN CONV_TAC SELECT_CONV THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [path_connected]) THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"(f:complex->complex) o (p:real^1->complex)", ← q r"Cx(&0)"]
          WINDING_NUMBER_AHLFORS_FULL) THEN
        REWRITE_TAC [CEXP_ADD] THEN ANTS_TAC THENL
         [CONJ_TAC THENL
           [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN
            ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
            REWRITE_TAC [path_image, IMAGE_o] THEN
            REWRITE_TAC [← GSYM path_image] THEN ASM SET_TAC []],
          ASM_REWRITE_TAC [PATHSTART_COMPOSE, PATHFINISH_COMPOSE] THEN
          REWRITE_TAC [COMPLEX_SUB_RZERO] THEN DISCH_THEN SUBST1_TAC THEN
          AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC CEXP_CLOG THEN
          ASM SET_TAC []]] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPONENTS_OPEN THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"c:complex->bool") THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"z0:complex = (@) c") THEN
      MATCH_MP_TAC CONTINUOUS_ON_EQ THEN
      ABBREV_TAC
       (← q r"g = \z. let p = @p. path p /\ path_image p SUBSET c /\
                            pathstart p = z0 /\ pathfinish p = z in
                Cx(&2) * Cx(pi) * ii * winding_number(f o p,Cx(&0)) +
                clog(f(z0:complex))") THEN
      EXISTS_TAC (← q r"g:complex->complex") THEN REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN EXPAND_TAC "g" THEN
        CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN EXPAND_TAC "z0" THEN
        SUBGOAL_THEN (← q r"connected_component s (z:complex) = c")
         (fun th => REWRITE_TAC [th]) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_COMPONENTS]) THEN
        ASM_MESON_TAC [CONNECTED_COMPONENT_EQ],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(z0:complex) IN c") ASSUME_TAC THENL
       [EXPAND_TAC "z0" THEN REWRITE_TAC [IN] THEN MATCH_MP_TAC SELECT_AX THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP IN_COMPONENTS_NONEMPTY) THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(c:complex->bool) SUBSET s") ASSUME_TAC THENL
       [ASM_MESON_TAC [IN_COMPONENTS_SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"connected(c:complex->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [IN_COMPONENTS_CONNECTED], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"open(c:complex->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [OPEN_COMPONENTS], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"path_connected(c:complex->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [CONNECTED_OPEN_PATH_CONNECTED], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x. x IN c
            ==> ?p. path (p:real^1->complex) /\ path_image p SUBSET c /\
                    pathstart p = z0 /\ pathfinish p = x /\
                    g(x) = Cx(&2) * Cx pi * ii * winding_number(f o p,Cx(&0)) +
                           clog (f z0)")
       (LABEL_TAC "*")
      THENL
       [X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN EXPAND_TAC "g" THEN
        ABBREV_TAC (← q r"p = @p. path p /\ path_image p SUBSET c /\
                            pathstart p = z0 /\ pathfinish p = (z:complex)") THEN
        EXISTS_TAC (← q r"p:real^1->complex") THEN
        CONV_TAC (TOP_DEPTH_CONV let_CONV) THEN REWRITE_TAC [] THEN
        EXPAND_TAC "p" THEN CONV_TAC SELECT_CONV THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [path_connected]) THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT] THEN
      X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"z:complex") o GEN_REWRITE_RULE id
       [OPEN_CONTAINS_BALL]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"e:real") THEN
      STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"ball(z:complex,e)") SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG) THEN
      SIMP_TAC [OPEN_BALL, CONVEX_BALL, CONVEX_IMP_SIMPLY_CONNECTED] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"f:complex->complex") o CONJUNCT2) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET],
        DISCH_THEN (X_CHOOSE_THEN (← q r"l:complex->complex") STRIP_ASSUME_TAC)] THEN
      REWRITE_TAC [CONTINUOUS_AT] THEN ONCE_REWRITE_TAC [LIM_NULL] THEN
      MATCH_MP_TAC LIM_TRANSFORM_AT THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN EXISTS_TAC
       (← q r"\w. Cx(&2) * Cx pi * ii *
            winding_number((f:complex->complex) o linepath(z,w),Cx(&0))") THEN
      EXISTS_TAC (← q r"e:real") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN REMOVE_THEN "*"
         (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"w:complex") th) THEN
                    MP_TAC (← SPEC (← q r"z:complex") th))) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"p:real^1->complex") THEN STRIP_TAC THEN
        ANTS_TAC THENL [ASM_MESON_TAC [SUBSET, IN_BALL, DIST_SYM], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
         (← q r"(z + x) - y = Cx(&0)
          ==> a * b * c * x = (a * b * c * y + l) - (a * b * c * z + l)"))) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"p ++ linepath(z:complex,w) ++ reversepath q")) THEN
        ASM_SIMP_TAC [PATHSTART_JOIN, PATHFINISH_JOIN,
                     PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                     PATH_JOIN_EQ, PATH_LINEPATH, PATH_REVERSEPATH,
                     PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_JOIN] THEN
        ASM_REWRITE_TAC [UNION_SUBSET, PATH_IMAGE_REVERSEPATH] THEN ANTS_TAC THENL
         [REPEAT STRIP_TAC THEN
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"c:complex->bool") THEN
          ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(z:complex,e)") THEN
          ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
          ASM_REWRITE_TAC [INSERT_SUBSET, CENTRE_IN_BALL, EMPTY_SUBSET] THEN
          ASM_REWRITE_TAC [IN_BALL, CONVEX_BALL],
          DISCH_THEN (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← GSYM th])) THEN
          REWRITE_TAC [PATH_COMPOSE_JOIN, PATH_COMPOSE_REVERSEPATH] THEN
          W (MP_TAC o PART_MATCH (lhand o rand) WINDING_NUMBER_JOIN o
            rand o snd) THEN
          ANTS_TAC THENL
           [ALL_TAC,
            DISCH_THEN SUBST1_TAC THEN
            REWRITE_TAC [VECTOR_SUB, ← GSYM VECTOR_ADD_ASSOC] THEN
            AP_TERM_TAC THEN
            W (MP_TAC o PART_MATCH (lhand o rand) WINDING_NUMBER_JOIN o
              rand o snd) THEN
            ANTS_TAC THENL
             [ALL_TAC,
              DISCH_THEN SUBST1_TAC THEN AP_TERM_TAC THEN
              MATCH_MP_TAC (← GSYM WINDING_NUMBER_REVERSEPATH)]] THEN
          ASM_SIMP_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                     PATHSTART_COMPOSE, PATHFINISH_COMPOSE, PATH_IMAGE_REVERSEPATH,
                     PATHSTART_JOIN, PATHFINISH_JOIN, PATH_REVERSEPATH,
                     PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_JOIN,
                     PATH_IMAGE_JOIN, IN_UNION, DE_MORGAN_THM] THEN
          REWRITE_TAC [PATH_IMAGE_COMPOSE, ← SET_RULE
           (← q r"~(z IN IMAGE f s) <=> !x. x IN s ==> ~(f x = z)")] THEN
          REPEAT CONJ_TAC THEN
          ((MATCH_MP_TAC PATH_CONTINUOUS_IMAGE)
           ORELSE
           (X_GEN_TAC (← q r"x:complex") THEN DISCH_TAC THEN
            FIRST_X_ASSUM MATCH_MP_TAC)) THEN
          ASM_REWRITE_TAC [PATH_LINEPATH] THEN
          TRY (FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
                CONTINUOUS_ON_SUBSET)) THEN
              REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:complex") THEN STRIP_TAC) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
          TRY (FIRST_X_ASSUM (fun th => tactic_of do pure (
                MATCH_MP_TAC (← GEN_REWRITE_RULE id [SUBSET] th) THEN
                FIRST_X_ASSUM ACCEPT_TAC))) THEN
          UNDISCH_TAC (← q r"(x:complex) IN path_image(linepath(z,w))") THEN
          SPEC_TAC (← q r"x:complex", ← q r"x:complex") THEN
          REWRITE_TAC [← GSYM SUBSET, PATH_IMAGE_LINEPATH, SEGMENT_CONVEX_HULL] THEN
          MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"ball(z:complex,e)") THEN
          ASM_REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
          ASM_REWRITE_TAC [INSERT_SUBSET, CENTRE_IN_BALL, EMPTY_SUBSET] THEN
          ASM_REWRITE_TAC [IN_BALL, CONVEX_BALL]],
        MATCH_MP_TAC LIM_TRANSFORM THEN
        EXISTS_TAC (← q r"\w. Cx(&2) * Cx pi * ii *
                        Cx(&1) / (Cx(&2) * Cx pi * ii) *
                        (pathfinish(l o linepath(z:complex,w)) -
                         pathstart (l o linepath(z,w)))") THEN
        REWRITE_TAC [] THEN CONJ_TAC THENL
         [MATCH_MP_TAC LIM_EVENTUALLY THEN REWRITE_TAC [EVENTUALLY_AT] THEN
          EXISTS_TAC (← q r"e:real") THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
          ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
          REWRITE_TAC [← VECTOR_ARITH (← q r"x - y = vec 0 <=> y = x")] THEN
          REPLICATE_TAC 3 AP_TERM_TAC THEN MATCH_MP_TAC lemma THEN
          EXISTS_TAC (← q r"ball(z:complex,e)") THEN ASM_REWRITE_TAC [PATH_LINEPATH] THEN
          CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_ON_SUBSET, SUBSET], ALL_TAC] THEN
          REWRITE_TAC [PATH_IMAGE_LINEPATH, SEGMENT_CONVEX_HULL] THEN
          MATCH_MP_TAC HULL_MINIMAL THEN REWRITE_TAC [CONVEX_BALL] THEN
          ASM_REWRITE_TAC [INSERT_SUBSET, CENTRE_IN_BALL, EMPTY_SUBSET] THEN
          ASM_REWRITE_TAC [IN_BALL],
          REWRITE_TAC [COMPLEX_VEC_0] THEN
          REPEAT (MATCH_MP_TAC LIM_NULL_COMPLEX_LMUL) THEN
          REWRITE_TAC [PATHSTART_COMPOSE, PATHSTART_LINEPATH,
                      PATHFINISH_COMPOSE, PATHFINISH_LINEPATH] THEN
          REWRITE_TAC [← GSYM COMPLEX_VEC_0, ← GSYM LIM_NULL, ← GSYM CONTINUOUS_AT] THEN
          ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_BALL,
                        CENTRE_IN_BALL]]]))

  let WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM ← prove
   r"!p z.
      path p /\ ~(z IN path_image p)
      ==> ?q. path q /\
              pathfinish q - pathstart q =
              Cx(&2) * Cx pi * ii * winding_number(p,z) /\
              !t. t IN interval[vec 0,vec 1] ==> p(t) = z + cexp(q t)"
   (REPEAT STRIP_TAC THEN EXISTS_TAC
    (← q r"\t:real^1. Cx(&2) * Cx pi * ii * winding_number(subpath (vec 0) t p,z) +
                clog(pathstart p - z)") THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [path] THEN MATCH_MP_TAC CONTINUOUS_ON_ADD THEN
      REWRITE_TAC [CONTINUOUS_ON_CONST] THEN
      REPEAT (MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
             REWRITE_TAC [CONTINUOUS_ON_CONST]) THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"~((p:real^1->complex) t = z)") ASSUME_TAC THENL
       [ASM_MESON_TAC [path_image, IN_IMAGE], ALL_TAC] THEN
      MP_TAC (← SPEC (← q r"ball((p:real^1->complex) t,norm(p t - z))")
        SIMPLY_CONNECTED_EQ_CONTINUOUS_LOG) THEN
      SIMP_TAC [OPEN_BALL, CONVEX_BALL, CONVEX_IMP_SIMPLY_CONNECTED] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"\w:complex. w - z") o CONJUNCT2) THEN
      SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID, CONTINUOUS_ON_CONST] THEN
      REWRITE_TAC [COMPLEX_SUB_0] THEN ANTS_TAC THENL
       [GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
        SIMP_TAC [IN_BALL, dist, REAL_LT_REFL],
        DISCH_THEN (X_CHOOSE_THEN (← q r"l:complex->complex") STRIP_ASSUME_TAC)] THEN
      ONCE_REWRITE_TAC [WINDING_NUMBER_OFFSET] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path]) THEN
      GEN_REWRITE_TAC LAND_CONV [continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"t:real^1")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"norm((p:real^1->complex) t - z)")) THEN
      ASM_REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN REWRITE_TAC [← GSYM IN_BALL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [CONTINUOUS_WITHIN] THEN ONCE_REWRITE_TAC [LIM_NULL] THEN
      MATCH_MP_TAC LIM_TRANSFORM_WITHIN THEN EXISTS_TAC
       (← q r"\u. Cx(&1) / (Cx(&2) * Cx pi * ii) *
            (pathfinish((l:complex->complex) o subpath t u p) -
             pathstart(l o subpath t u p))") THEN
      EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:real^1") THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"path_image(subpath t u p) SUBSET ball(p t:complex,norm (p t - z))")
        ASSUME_TAC THENL
         [REWRITE_TAC [PATH_IMAGE_SUBPATH_GEN] THEN
          REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
          SUBGOAL_THEN
           (← q r"segment[t,u] SUBSET interval[vec 0,vec 1] /\
            segment[t,u] SUBSET ball(t:real^1,d)")
          MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          CONJ_TAC THEN REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN
          MATCH_MP_TAC HULL_MINIMAL THEN
          REWRITE_TAC [CONVEX_BALL, CONVEX_INTERVAL] THEN
          ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, CENTRE_IN_BALL] THEN
          ASM_REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] IN_BALL],
          ALL_TAC] THEN
        W (MP_TAC o PART_MATCH (rand o rand) WINDING_NUMBER_COMPOSE_CEXP o
          lhand o snd) THEN
        ANTS_TAC THENL
         [MATCH_MP_TAC PATH_CONTINUOUS_IMAGE THEN ASM_SIMP_TAC [PATH_SUBPATH] THEN
          ASM_MESON_TAC [CONTINUOUS_ON_SUBSET],
          DISCH_THEN (SUBST1_TAC o SYM)] THEN
        MATCH_MP_TAC EQ_TRANS THEN
        EXISTS_TAC (← q r"winding_number((\w. subpath t u p w - z),Cx(&0))") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC WINDING_NUMBER_EQUAL THEN
          REWRITE_TAC [o_THM, ← GSYM path_image, ← SET_RULE
           (← q r"(!x. x IN s ==> cexp(l(subpath t u p x)) = subpath t u p x - z) <=>
            (!y. y IN IMAGE (subpath t u p) s ==> cexp(l y) = y - z)")] THEN
          ASM SET_TAC [],
          ONCE_REWRITE_TAC [← GSYM WINDING_NUMBER_OFFSET] THEN
          REWRITE_TAC [ETA_AX] THEN
          MP_TAC (← ISPECL [← q r"p:real^1->complex", ← q r"vec 0:real^1", ← q r"t:real^1",
                         ← q r"u:real^1", ← q r"z:complex"]
            WINDING_NUMBER_SUBPATH_COMBINE) THEN
          ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL] THEN
          CONV_TAC COMPLEX_RING],
        REWRITE_TAC [COMPLEX_VEC_0] THEN MATCH_MP_TAC LIM_NULL_COMPLEX_LMUL THEN
        REWRITE_TAC [PATHSTART_COMPOSE, PATHSTART_SUBPATH,
                    PATHFINISH_COMPOSE, PATHFINISH_SUBPATH] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0, ← GSYM LIM_NULL] THEN
        REWRITE_TAC [← GSYM CONTINUOUS_WITHIN] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_WITHIN_COMPOSE THEN CONJ_TAC THENL
         [ASM_MESON_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, path],
          MATCH_MP_TAC CONTINUOUS_AT_WITHIN THEN
          UNDISCH_TAC (← q r"(l:complex->complex) continuous_on
                       ball(p(t:real^1),norm(p t - z))") THEN
          SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, OPEN_BALL] THEN
          DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [CENTRE_IN_BALL] THEN
          ASM_REWRITE_TAC [VECTOR_SUB_EQ, NORM_POS_LT]]],
      REWRITE_TAC [pathstart, pathfinish, SUBPATH_REFL, SUBPATH_TRIVIAL] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
       (← q r"w' = Cx(&0)
        ==> (a * b * c * w + l) - (a * b * c * w' + l) = a * b * c * w"))) THEN
      MATCH_MP_TAC WINDING_NUMBER_TRIVIAL THEN
      MP_TAC (← ISPEC (← q r"p:real^1->complex") PATHSTART_IN_PATH_IMAGE) THEN
      REWRITE_TAC [pathstart] THEN ASM_MESON_TAC [],
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"subpath (vec 0) t (p:real^1->complex)", ← q r"z:complex"]
          WINDING_NUMBER_AHLFORS_FULL) THEN
      REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      ASM_SIMP_TAC [ENDS_IN_UNIT_INTERVAL, PATH_SUBPATH, CEXP_ADD,
        ← REWRITE_RULE [← SET_RULE (← q r"s SUBSET t <=> !x. ~(x IN t) ==> ~(x IN s)")]
                    PATH_IMAGE_SUBPATH_SUBSET] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
       (← q r"t:complex = s ==> p - z = e * s ==> p = z + e * t"))) THEN
      REWRITE_TAC [pathstart] THEN MATCH_MP_TAC CEXP_CLOG THEN
      REWRITE_TAC [COMPLEX_SUB_0] THEN
      ASM_MESON_TAC [pathstart, PATHSTART_IN_PATH_IMAGE]])

  pure { MONODROMY_CONTINUOUS_LOG, WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM }
/- ------------------------------------------------------------------------- -/
/- Winding number integral for absolutely continuous closed curves.          -/
/- (cauchy.ml 20411-20851)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYCB where
  HAS_PATH_INTEGRAL_WINDING_NUMBER_AC : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYCB [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYCA : KYCA) : ExceptT String IO KYCB := do
  -- @@SCOPE BEGIN
  let { has_path_integral, .. } := BKYC
  let { WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM, .. } := BKYCA
  let { VECTOR_DERIVATIVE_WITHIN_CLOSED_INTERVAL, .. } := D.qderivatives
  let { ABSOLUTELY_CONTINUOUS_LIPSCHITZ_COMPOSE, HAS_INTEGRAL_0_EQ, .. } := D.qintegration
  let { ABSOLUTELY_CONTINUOUS_IMP_PATH, ABSOLUTELY_CONTINUOUS_INDEFINITE_INTEGRAL_RIGHT,
        ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE,
        FUNDAMENTAL_THEOREM_OF_CALCULUS_ABSOLUTELY_CONTINUOUS, .. } := D.qmeasure
  let { CEXP_0, CEXP_ADD, HAS_COMPLEX_DERIVATIVE_CEXP, .. } := D.mt.ra.tsa
  let { REAL_EXP_POS_LE, .. } := D.mt.ra.tsb
  let { PI_POS, .. } := D.mt.ra.tse
  let { CEXP_EQ, CEXP_LIPSCHITZ_BOUNDED, .. } := D.mt.ra.tsf
  let { ABSOLUTELY_INTEGRABLE_BOUNDED_MEASURABLE_PRODUCT,
        CONTINUOUS_IMP_MEASURABLE_ON_CLOSED_SUBSET,
        HAS_VECTOR_DERIVATIVE_INDEFINITE_INTEGRAL, .. } := D.mt.ra.qmeasure
  let { CONTINUOUS_ON_COMPLEX_INV, .. } := D.mt.ra.ts.knc
  let { has_complex_derivative, .. } := D.mt.ra.ts.kne
  let { CONTINUOUS_DISCRETE_RANGE_CONSTANT, .. } := D.mt.ra.ts.qtopology
  let { complex_div, SIMPLE_COMPLEX_ARITH_TAC, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_RID, COMPLEX_MUL_LID, COMPLEX_MUL_LZERO, COMPLEX_SUB_0,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, COMPLEX_NORM_II, COMPLEX_VEC_0,
        .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { BILINEAR_COMPLEX_MUL, .. } := D.mt.ra.ts.cn.cxh
  let { INTEGRABLE_INTEGRAL, .. } := D.mt.ra.ts.cn.qintegration
  let { HAS_VECTOR_DERIVATIVE_NEG, HAS_VECTOR_DERIVATIVE_SUB,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { ABSOLUTELY_CONTINUOUS_ON_BILINEAR, ABSOLUTELY_CONTINUOUS_ON_CONST,
        ABSOLUTELY_CONTINUOUS_ON_IMP_CONTINUOUS,
        ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON,
        ABSOLUTELY_CONTINUOUS_ON_SUB, ABSOLUTELY_CONTINUOUS_ON_SUBSET,
        ABSOLUTELY_INTEGRABLE_IMP_INTEGRABLE, .. } := D.mt.ra.ts.cn.ms.qintegration1
  let { HAS_INTEGRAL_SPIKE, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { INTEGRAL_REFL, NEGLIGIBLE_UNION_EQ, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH_TAC, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV,
        VECTOR_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFF_CHAIN_WITHIN, HAS_DERIVATIVE_WITHIN_SUBSET, has_vector_derivative,
        HAS_VECTOR_DERIVATIVE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN,
        HAS_VECTOR_DERIVATIVE_CONST, HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { DE_MORGAN_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, FUN_EQ_THM, IN_DIFF,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNION, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS, MONO_FORALL,
        REAL_ABS_MUL, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LMUL, REAL_LE_RMUL, REAL_LE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_RZERO,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, SUBSET_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_NEG, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_SUB_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_POS, CLOSED_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, IS_INTERVAL_INTERVAL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { CONNECTED_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { WITHIN_UNIV, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { path, path_image, pathfinish, pathstart, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  let { BOUNDED_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  -- @@SCOPE END

  let HAS_PATH_INTEGRAL_WINDING_NUMBER_AC ← (do
    let vec_deriv_cexp_compose ← prove
     r"!f:real^1->complex v t s.
         (f has_vector_derivative v) (at t within s)
         ==> ((\x. cexp(f x)) has_vector_derivative (cexp(f t) * v))
             (at t within s)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [has_vector_derivative] THEN
      SUBGOAL_THEN
        (← q r"(\h:real^1. drop h % (cexp((f:real^1->complex) t) * v:complex)) =
         (\h. cexp(f t) * (drop h % v))")
        SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, COMPLEX_CMUL] THEN
        GEN_TAC THEN SIMPLE_COMPLEX_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\x:real^1. cexp((f:real^1->complex) x)) = cexp o f")
        SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"(\h:real^1. cexp((f:real^1->complex) t) * (drop h % v:complex)) =
         ((\w:complex. cexp(f t) * w) o (\h:real^1. drop h % v))")
        SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF] THEN REFL_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC DIFF_CHAIN_WITHIN THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [← GSYM has_vector_derivative], ALL_TAC] THEN
      MATCH_MP_TAC HAS_DERIVATIVE_WITHIN_SUBSET THEN
      EXISTS_TAC (← q r"(:complex)") THEN REWRITE_TAC [SUBSET_UNIV] THEN
      REWRITE_TAC [WITHIN_UNIV] THEN
      MP_TAC (← SPEC (← q r"(f:real^1->complex) t") HAS_COMPLEX_DERIVATIVE_CEXP) THEN
      REWRITE_TAC [has_complex_derivative])
    prove
     r"!g:real^1->complex z.
    g absolutely_continuous_on interval[vec 0,vec 1] /\
    pathfinish g = pathstart g /\
    ~(z IN path_image g)
    ==> ((\w. Cx(&1) / (w - z)) has_path_integral
         (Cx(&2) * Cx(pi) * ii * winding_number(g,z))) g"
      (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"path(g:real^1->complex)") ASSUME_TAC THENL
       [ASM_MESON_TAC [ABSOLUTELY_CONTINUOUS_IMP_PATH], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"g:real^1->complex has_bounded_variation_on interval[vec 0,vec 1]")
        ASSUME_TAC THENL
       [MATCH_MP_TAC ABSOLUTELY_CONTINUOUS_ON_IMP_HAS_BOUNDED_VARIATION_ON THEN
        ASM_REWRITE_TAC [BOUNDED_INTERVAL], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP
        ABSOLUTELY_INTEGRABLE_BOUNDED_VARIATION_DERIVATIVE) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"gd:real^1->complex", ← q r"s1:real^1->bool"] THEN
      STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
        WINDING_NUMBER_AS_CONTINUOUS_LOGARITHM) THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"q:real^1->complex") THEN STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"(\t:real^1. inv((g:real^1->complex) t - z))
