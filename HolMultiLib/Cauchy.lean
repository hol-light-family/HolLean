       (← q r"cball(vec 0,&1) UNION (:real^2) DIFF ball(vec 0,&1) = (:real^2)")
      SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM BALL_UNION_SPHERE] THEN SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closure s UNION closure ((:real^2) DIFF closure s) = (:real^2)")
      SUBST1_TAC THENL
       [MATCH_MP_TAC (← SET_RULE
         (← q r"UNIV DIFF c SUBSET closure(UNIV DIFF c)
          ==> c UNION closure(UNIV DIFF c) = UNIV")) THEN
        REWRITE_TAC [CLOSURE_SUBSET],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closure s INTER closure ((:real^2) DIFF closure s) = frontier s")
      SUBST1_TAC THENL
       [GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM CLOSURE_CLOSURE] THEN
        ASM_REWRITE_TAC [← GSYM FRONTIER_CLOSURES],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"cball(vec 0,&1) DIFF ((:real^2) DIFF ball (vec 0,&1)) = ball(vec 0,&1)")
      SUBST1_TAC THENL
       [MP_TAC (← ISPECL [← q r"vec 0:real^2", ← q r"&1"] BALL_SUBSET_CBALL) THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"cball(vec 0,&1) INTER ((:real^2) DIFF ball(vec 0,&1)) =
        sphere(vec 0,&1)")
      SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM CBALL_DIFF_BALL] THEN SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"(:real^2) DIFF ball(vec 0,&1) DIFF cball(vec 0,&1) =
        (:real^2) DIFF cball(vec 0,&1)")
      SUBST1_TAC THENL
       [MP_TAC (← ISPECL [← q r"vec 0:real^2", ← q r"&1"] BALL_SUBSET_CBALL) THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closure s DIFF closure ((:real^2) DIFF closure s) = s")
      SUBST1_TAC THENL
       [GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [CLOSURE_UNION_FRONTIER] THEN
        ASM_REWRITE_TAC [FRONTIER_COMPLEMENT, ← SET_RULE
         (← q r"c DIFF (UNIV DIFF c UNION s) = c DIFF s")] THEN
        ASM_SIMP_TAC [frontier, INTERIOR_OPEN] THEN
        MP_TAC (← ISPEC (← q r"s:real^2->bool") CLOSURE_SUBSET) THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"closure ((:real^2) DIFF closure s) DIFF closure s =
        (:real^2) DIFF closure s")
      SUBST1_TAC THENL
       [MP_TAC (← ISPEC (← q r"(:real^2) DIFF closure s") CLOSURE_SUBSET) THEN SET_TAC [],
        ALL_TAC] THEN
      SIMP_TAC [] THEN SIMP_TAC [← GSYM SPHERE_UNION_BALL, IN_UNION] THEN
      ASM_REWRITE_TAC []])

  let JORDAN_SCHOENFLIES_CIRCLE ← prove
   r"!g:real^2->real^2 h s.
        homeomorphism (sphere(vec 0,&1),s) (g,h)
        ==> ?g' h'. homeomorphism ((:real^2),(:real^2)) (g',h') /\
                    (!x. x IN sphere(vec 0,&1) ==> g' x = g x) /\
                    (!y. y IN s ==> h' y = h y) /\
                    IMAGE g' (ball(vec 0,&1)) = inside s /\
                    IMAGE g' (sphere(vec 0,&1)) = s /\
                    IMAGE g' ((:real^2) DIFF cball(vec 0,&1)) = outside s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP js_noball) THEN
    MP_TAC (← ISPECL [← q r"s:real^2->bool", ← q r"vec 0:real^2", ← q r"&1"]
      HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE_EQ) THEN
    REWRITE_TAC [REAL_LT_01] THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).1)) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [homeomorphic, HOMEOMORPHIC_SYM], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->real^2") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"p:real^1->real^2") JORDAN_INSIDE_OUTSIDE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?z:real^2. z IN inside s") CHOOSE_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"g:real^2->real^2", ← q r"h:real^2->real^2",
                   ← q r"s:real^2->bool", ← q r"z:real^2"]
          js_cball) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, ← GSYM COMPLEX_VEC_0] THEN
    MAP_EVERY X_GEN_TAC [← q r"g1:real^2->real^2", ← q r"h1:real^2->real^2"] THEN
    DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"g2:real^2->real^2", ← q r"h2:real^2->real^2"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (fun th => tactic_of do pure (STRIP_ASSUME_TAC th THEN
    MP_TAC (← MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← ONCE_REWRITE_RULE [CONJ_ASSOC] HOMOEOMORPHISM_PASTE)) th))) THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [DISJ2_TAC THEN REPEAT CONJ_TAC THEN MATCH_MP_TAC CLOSED_SUBSET THEN
        REWRITE_TAC [SUBSET_UNION, CLOSED_CBALL,
                    OPEN_BALL, ← GSYM OPEN_CLOSED] THEN
        REWRITE_TAC [CLOSED_CLOSURE],
        REWRITE_TAC [← GSYM SPHERE_UNION_BALL] THEN ASM SET_TAC [],
        ASM_SIMP_TAC [CLOSURE_UNION_FRONTIER] THEN ASM SET_TAC []],
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:real^2->real^2") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:real^2->real^2") THEN
      ASM_REWRITE_TAC [CLOSURE_UNION_FRONTIER, ← GSYM BALL_UNION_SPHERE] THEN
      REWRITE_TAC [← SET_RULE (← q r"(b UNION s) UNION (UNIV DIFF b) = UNIV")] THEN
      ASM_SIMP_TAC [← SET_RULE
       (← q r"i UNION e = UNIV DIFF s /\ i INTER e = {}
         ==> (i UNION s) UNION (e UNION s) = UNIV /\
             (i UNION s) DIFF (e UNION s) = i /\
             (e UNION s) DIFF (i UNION s) = e /\
             (i UNION s) INTER (e UNION s) = s")] THEN
      REWRITE_TAC [← SET_RULE (← q r"(b UNION s) INTER (UNIV DIFF b) = s DIFF b")] THEN
      REWRITE_TAC [← SET_RULE (← q r"(b UNION s) DIFF (UNIV DIFF b) = b")] THEN
      REWRITE_TAC [← SET_RULE
       (← q r"UNIV DIFF b DIFF (b UNION s) = UNIV DIFF (b UNION s)")] THEN
      REWRITE_TAC [← GSYM CBALL_DIFF_BALL,
        ← SET_RULE (← q r"c DIFF b DIFF b = c DIFF b")] THEN
      SIMP_TAC [CBALL_DIFF_BALL] THEN ASM SET_TAC []])

  pure { CARATHEODORY_CONFORMAL_EXTENSION_THEOREM, JORDAN_SCHOENFLIES_CIRCLE }
/- ------------------------------------------------------------------------- -/
/- The Jordan-Schoenflies theorem, in the plane and on the 2-sphere.         -/
/- (cauchy.ml 24256-24551)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYCG where
  JORDAN_SCHOENFLIES : thm
  JORDAN_SCHOENFLIES_S2 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYCG [HolBase] (D : CauchyDeps) (BKYCF : KYCF) : ExceptT String IO KYCG := do
  -- @@SCOPE BEGIN
  let { JORDAN_SCHOENFLIES_CIRCLE, .. } := BKYCF
  let { HOMEOMORPHIC_SPHERES_EQ, .. } := D.moc
  let { HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS, HOMOEOMORPHISM_PASTE, .. } := D.qtopology
  let { ARC_HOMEOMORPHISM_ENDS, HOMEOMORPHIC_ARC_IMAGE_SEGMENT,
        HOMEOMORPHIC_SIMPLE_PATH_ARC_EQ, HOMEOMORPHISM_ARC_IMAGES,
        INFINITE_SIMPLE_PATH_IMAGE, PATH_IMAGE_COMPOSE, SIMPLE_PATH_CONTINUOUS_IMAGE,
        SIMPLE_PATH_JOIN_LOOP_EQ_ALT, .. } := D.qpaths
  let { INSIDE_ARC_EMPTY, PATH_CONNECTED_OPEN_ARC_COMPLEMENT, .. } := D.qdegree
  let { ARC_REVERSEPATH_EQ, HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV, OUTSIDE_INSIDE,
        SIMPLE_PATH_JOIN_LOOP, .. } := D.mt.qpaths
  let { CONTRACTIBLE_SPHERE, .. } := D.mt.qdegree
  let { CONVEX_SEGMENT, .. } := D.mt.ra.ts.cn.ms.qconvex
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { INFINITE, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARC_DISTINCT_ENDS, CLOSED_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, ARITH_EQ, CONJ_ASSOC, CONTRAPOS_THM, DIMINDEX_2, DIMINDEX_3, EQ_TRANS,
        FINITE_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IN_DIFF,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, IN_UNION, IN_UNIV, LE_REFL, LEFT_IMP_EXISTS_THM, MONO_AND, MONO_EXISTS,
        MONO_FORALL, PSUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, SUBSET_UNION, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_ASSOC, o_THM, UNION_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { COMPACT_SPHERE, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { HOMEOMORPHIC_SYM, HOMEOMORPHISM, HOMEOMORPHISM_COMPOSE, HOMEOMORPHISM_OF_SUBSETS,
        HOMEOMORPHISM_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { homeomorphic, homeomorphism, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { INJECTIVE_ON_LEFT_INVERSE, .. } := D.mt.ra.ts.cn.ms.ig.dv.qsession
  let { ARC_IMP_PATH, ARC_SIMPLE_PATH, CONVEX_IMP_CONTRACTIBLE, FINITE_SPHERE,
        HOMEOMORPHIC_CONTRACTIBLE_EQ, HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path_component, PATH_CONNECTED_IFF_PATH_COMPONENT, PATH_CONTAINS_ARC,
        PATH_IMAGE_JOIN, PATH_IMAGE_REVERSEPATH, PATHFINISH_IN_PATH_IMAGE, PATHFINISH_JOIN,
        PATHFINISH_REVERSEPATH, PATHSTART_IN_PATH_IMAGE, PATHSTART_JOIN,
        PATHSTART_REVERSEPATH, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CLOSED_SUBSET_EQ, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { PSUBSET_ALT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  let { VEC_EQ, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qvec
  -- @@SCOPE END

  let JORDAN_SCHOENFLIES ← (do
    let lemma ← prove
     r"!g h f f'.
            simple_path g /\ pathfinish g = pathstart g /\
            simple_path h /\ pathfinish h = pathstart h /\
            homeomorphism (path_image g,path_image h) (f,f')
            ==> ?k k'. homeomorphism ((:real^2),(:real^2)) (k,k') /\
                       (!x. x IN path_image g ==> k x = f x) /\
                       (!y. y IN path_image h ==> k' y = f' y) /\
                       IMAGE k (path_image g) = path_image h /\
                       IMAGE k (inside(path_image g)) = inside(path_image h) /\
                       IMAGE k (outside(path_image g)) = outside(path_image h)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^2", ← q r"vec 0:real^2", ← q r"&1"]
            HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE) THEN
      ASM_REWRITE_TAC [REAL_LT_01] THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SYM] THEN
      REWRITE_TAC [homeomorphic, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g1:real^2->real^2", ← q r"g2:real^2->real^2"] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(f:real^2->real^2) o (g1:real^2->real^2)",
        ← q r"(g2:real^2->real^2) o (f':real^2->real^2)",
        ← q r"path_image h:real^2->bool"]
       JORDAN_SCHOENFLIES_CIRCLE) THEN
      MP_TAC (← ISPECL
       [← q r"g1:real^2->real^2", ← q r"g2:real^2->real^2", ← q r"path_image g:real^2->bool"]
       JORDAN_SCHOENFLIES_CIRCLE) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"g1':real^2->real^2", ← q r"g2':real^2->real^2"] THEN
      STRIP_TAC THEN ANTS_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
        ASM_MESON_TAC [HOMEOMORPHISM_SYM],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, o_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"h1':real^2->real^2", ← q r"h2':real^2->real^2"] THEN
      STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"(h1':real^2->real^2) o (g2':real^2->real^2)",
        ← q r"(g1':real^2->real^2) o (h2':real^2->real^2)"] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
        ASM_MESON_TAC [HOMEOMORPHISM_SYM],
        REWRITE_TAC [IMAGE_o, o_THM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphism, IN_UNIV]) THEN
        ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [CONJ_TAC THEN ASM_SIMP_TAC [] THENL [ALL_TAC, ASM SET_TAC []] THEN
          X_GEN_TAC (← q r"x:real^2") THEN DISCH_TAC THEN
          TRANS_TAC EQ_TRANS (← q r"(f:real^2->real^2)(g1((g2:real^2->real^2) x))") THEN
          ASM SET_TAC [],
          REPEAT CONJ_TAC THEN
          FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
          AP_TERM_TAC THEN
          REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN STRIP_ASSUME_TAC)) THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"(!x. g(f x) = x) ==> IMAGE f t = s
            ==> IMAGE g s = t"))) THEN
          ASM_REWRITE_TAC []]])
    prove
     r"!g h f f'.
        simple_path g /\ simple_path h /\
        homeomorphism (path_image g,path_image h) (f,f')
        ==> ?k k'. homeomorphism ((:real^2),(:real^2)) (k,k') /\
                   (!x. x IN path_image g ==> k x = f x) /\
                   (!y. y IN path_image h ==> k' y = f' y) /\
                   IMAGE k (path_image g) = path_image h /\
                   IMAGE k (inside(path_image g)) = inside(path_image h) /\
                   IMAGE k (outside(path_image g)) = outside(path_image h)"
      (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^2", ← q r"h:real^1->real^2"]
            HOMEOMORPHIC_SIMPLE_PATH_ARC_EQ) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [homeomorphic], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"arc(h:real^1->real^2)") THEN ASM_REWRITE_TAC [] THEN
      DISCH_TAC THENL
       [ALL_TAC,
        MATCH_MP_TAC lemma THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [ARC_SIMPLE_PATH]] THEN
      SUBGOAL_THEN
       (← q r"?g'. arc g' /\
             pathstart g':real^2 = pathfinish g /\
             pathfinish g' = pathstart g /\
             simple_path(g ++ g')")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"g:real^1->real^2")
          PATH_CONNECTED_OPEN_ARC_COMPLEMENT) THEN
        REWRITE_TAC [DIMINDEX_2, LE_REFL] THEN
        ASM_REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"pathfinish g:real^2", ← q r"pathstart g:real^2"]) THEN
        REWRITE_TAC [IN_DIFF, IN_UNIV, IN_INSERT, path_component] THEN
        REWRITE_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g':real^1->real^2") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL
         [← q r"g':real^1->real^2", ← q r"pathfinish g:real^2", ← q r"pathstart g:real^2"]
         PATH_CONTAINS_ARC) THEN
        ASM_SIMP_TAC [ARC_DISTINCT_ENDS] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g'':real^1->real^2") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC SIMPLE_PATH_JOIN_LOOP THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?h'. arc h' /\
             pathstart h':real^2 = pathfinish h /\
             pathfinish h' = pathstart h /\
             simple_path(h ++ h')")
      STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"h:real^1->real^2")
          PATH_CONNECTED_OPEN_ARC_COMPLEMENT) THEN
        REWRITE_TAC [DIMINDEX_2, LE_REFL] THEN
        ASM_REWRITE_TAC [PATH_CONNECTED_IFF_PATH_COMPONENT] THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"pathfinish h:real^2", ← q r"pathstart h:real^2"]) THEN
        REWRITE_TAC [IN_DIFF, IN_UNIV, IN_INSERT, path_component] THEN
        REWRITE_TAC [PATHSTART_IN_PATH_IMAGE, PATHFINISH_IN_PATH_IMAGE] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"h':real^1->real^2") STRIP_ASSUME_TAC) THEN
        MP_TAC (← ISPECL
         [← q r"h':real^1->real^2", ← q r"pathfinish h:real^2", ← q r"pathstart h:real^2"]
         PATH_CONTAINS_ARC) THEN
        ASM_SIMP_TAC [ARC_DISTINCT_ENDS] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"h'':real^1->real^2") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC SIMPLE_PATH_JOIN_LOOP THEN
        ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?k k':real^2->real^2.
            homeomorphism (path_image(g ++ g'),path_image(h ++ h')) (k,k') /\
            (!x. x IN path_image g ==> k x = f x) /\
            (!y. y IN path_image h ==> k' y = f' y)")
      STRIP_ASSUME_TAC THENL
       [ASM_SIMP_TAC [PATH_IMAGE_JOIN] THEN
        SUBGOAL_THEN
         (← q r"?q q':real^2->real^2.
            homeomorphism (path_image g',path_image h') (q,q') /\
            q(pathstart g') = f(pathstart g') /\
            q(pathfinish g') = f(pathfinish g') /\
            q'(pathstart h') = f'(pathstart h') /\
            q'(pathfinish h') = f'(pathfinish h')")
        STRIP_ASSUME_TAC THENL
         [MP_TAC (← ISPECL
           [← q r"g:real^1->real^2", ← q r"h:real^1->real^2",
            ← q r"f:real^2->real^2", ← q r"f':real^2->real^2"]
            ARC_HOMEOMORPHISM_ENDS) THEN
          ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
           [MP_TAC (← ISPECL [← q r"g':real^1->real^2", ← q r"h':real^1->real^2"]
              HOMEOMORPHISM_ARC_IMAGES),
            MP_TAC (← ISPECL [← q r"reversepath g':real^1->real^2", ← q r"h':real^1->real^2"]
              HOMEOMORPHISM_ARC_IMAGES)] THEN
          ASM_REWRITE_TAC [ARC_REVERSEPATH_EQ] THEN
          ASM_REWRITE_TAC [PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH] THEN
          REWRITE_TAC [PATH_IMAGE_REVERSEPATH] THEN MESON_TAC [],
          MP_TAC (← ISPECL
           [← q r"f:real^2->real^2", ← q r"f':real^2->real^2",
            ← q r"q:real^2->real^2", ← q r"q':real^2->real^2",
            ← q r"path_image g:real^2->bool", ← q r"path_image h:real^2->bool",
            ← q r"path_image g':real^2->bool", ← q r"path_image h':real^2->bool"]
           HOMOEOMORPHISM_PASTE) THEN
          ANTS_TAC THENL
           [ALL_TAC,
            REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
            STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
          ASM_SIMP_TAC [CLOSED_SUBSET_EQ, CLOSED_PATH_IMAGE, ARC_IMP_PATH] THEN
          REWRITE_TAC [SUBSET_UNION] THEN
          MAP_EVERY UNDISCH_TAC
           [← q r"simple_path(h ++ h':real^1->real^2)",
            ← q r"simple_path(g ++ g':real^1->real^2)"] THEN
          ASM_SIMP_TAC [SIMPLE_PATH_JOIN_LOOP_EQ_ALT] THEN ASM SET_TAC []],
        MP_TAC (← ISPECL
         [← q r"g ++ g':real^1->real^2", ← q r"h ++ h':real^1->real^2",
          ← q r"k:real^2->real^2", ← q r"k':real^2->real^2"]
         lemma) THEN
        ASM_REWRITE_TAC [PATHSTART_JOIN, PATHFINISH_JOIN] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q:real^2->real^2") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q':real^2->real^2") THEN
        ASM_SIMP_TAC [PATH_IMAGE_JOIN, IN_UNION] THEN STRIP_TAC THEN
        ASM_SIMP_TAC [INSIDE_ARC_EMPTY, OUTSIDE_INSIDE, UNION_EMPTY] THEN
        MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHISM, IN_UNIV]) THEN
        CONJ_TAC THEN ASM SET_TAC []]))

  let JORDAN_SCHOENFLIES_S2 ← (do
    let lemma ← prove
     r"!g:real^1->real^3 z r.
            simple_path g /\ path_image g SUBSET sphere(z,r)
            ==> &0 < r /\ path_image g PSUBSET sphere(z,r)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
         FINITE_SUBSET)) THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THEN
        ASM_SIMP_TAC [← GSYM INFINITE, INFINITE_SIMPLE_PATH_IMAGE] THEN
        REWRITE_TAC [INFINITE, FINITE_SPHERE, DIMINDEX_3, ARITH_EQ, REAL_NOT_LE],
        DISCH_TAC] THEN
      ASM_REWRITE_TAC [PSUBSET] THEN
      ASM_CASES_TAC (← q r"pathstart g:real^3 = pathfinish g") THENL
       [DISCH_THEN (MP_TAC o AP_TERM
          (← q r"\s:real^3->bool. s homeomorphic sphere(vec 0:real^2,&1)")) THEN
        ASM_SIMP_TAC [HOMEOMORPHIC_SIMPLE_PATH_IMAGE_CIRCLE, REAL_LT_01] THEN
        SIMP_TAC [HOMEOMORPHIC_SPHERES_EQ, DIMINDEX_2, DIMINDEX_3, ARITH_EQ] THEN
        ASM_REAL_ARITH_TAC,
        DISCH_THEN (MP_TAC o AP_TERM
          (← q r"\s:real^3->bool. s homeomorphic segment[vec 0:real^1,vec 1]")) THEN
        ASM_SIMP_TAC [ARC_SIMPLE_PATH, VEC_EQ, ARITH_EQ,
                     HOMEOMORPHIC_ARC_IMAGE_SEGMENT] THEN
        DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_CONTRACTIBLE_EQ) THEN
        SIMP_TAC [CONVEX_IMP_CONTRACTIBLE, CONVEX_SEGMENT,
                 CONTRACTIBLE_SPHERE] THEN
        ASM_REAL_ARITH_TAC])
    prove
     r"!g h f f' z:real^3 r.
        simple_path g /\ simple_path h /\
        path_image g SUBSET sphere(z,r) /\
        path_image h SUBSET sphere(z,r) /\
        homeomorphism (path_image g,path_image h) (f,f')
        ==> ?k k'. homeomorphism (sphere(z,r),sphere(z,r)) (k,k') /\
                   (!x. x IN path_image g ==> k x = f x) /\
                   (!y. y IN path_image h ==> k' y = f' y)"
      (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"h:real^1->real^3", ← q r"z:real^3", ← q r"r:real"] lemma) THEN
      MP_TAC (← ISPECL [← q r"g:real^1->real^3", ← q r"z:real^3", ← q r"r:real"] lemma) THEN
      ASM_CASES_TAC (← q r"&0 < r") THEN
      ASM_REWRITE_TAC [PSUBSET_ALT, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:real^3") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"b:real^3") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(sphere(z:real^3,r) DELETE a) homeomorphic (:real^2) /\
        (sphere(z:real^3,r) DELETE b) homeomorphic (:real^2)")
      MP_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_PUNCTURED_SPHERE_UNIV THEN
        ASM_REWRITE_TAC [DIMINDEX_2, DIMINDEX_3, ARITH],
        REWRITE_TAC [IMP_CONJ, homeomorphic, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"f1:real^3->real^2", ← q r"g1:real^2->real^3"] THEN
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"f2:real^3->real^2", ← q r"g2:real^2->real^3"] THEN
      DISCH_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(f1:real^3->real^2) o (g:real^1->real^3)",
        ← q r"(f2:real^3->real^2) o (h:real^1->real^3)",
        ← q r"(f2:real^3->real^2) o (f:real^3->real^3) o (g1:real^2->real^3)",
        ← q r"(f1:real^3->real^2) o (f':real^3->real^3) o (g2:real^2->real^3)"]
       JORDAN_SCHOENFLIES) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [CONJ_TAC THEN MATCH_MP_TAC SIMPLE_PATH_CONTINUOUS_IMAGE THEN
          ASM_REWRITE_TAC [] THEN REPEAT (FIRST_X_ASSUM
           (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism])) THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_UNIV]) THEN
          (CONJ_TAC THENL
            [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
               CONTINUOUS_ON_SUBSET)) THEN
             ASM SET_TAC [],
             REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN ASM SET_TAC []]),
          REWRITE_TAC [PATH_IMAGE_COMPOSE] THEN
          GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [o_ASSOC] THEN
          MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
          EXISTS_TAC (← q r"path_image h:real^3->bool") THEN CONJ_TAC THENL
           [MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN
            EXISTS_TAC (← q r"path_image g:real^3->bool") THEN
            ASM_REWRITE_TAC [] THEN
            ONCE_REWRITE_TAC [HOMEOMORPHISM_SYM],
            ALL_TAC] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
            HOMEOMORPHISM_OF_SUBSETS)) THEN
          ASM SET_TAC []],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:real^2->real^2", ← q r"k':real^2->real^2"] THEN
      REWRITE_TAC [PATH_IMAGE_COMPOSE, ← GSYM IMAGE_o] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"(g2:real^2->real^3) o (k:real^2->real^2) o (f1:real^3->real^2)",
        ← q r"(g1:real^2->real^3) o (k':real^2->real^2) o (f2:real^3->real^2)",
        ← q r"sphere(z:real^3,r)", ← q r"sphere(z:real^3,r)", ← q r"a:real^3", ← q r"b:real^3"]
       HOMEOMORPHISM_ONE_POINT_COMPACTIFICATIONS) THEN
      ASM_REWRITE_TAC [COMPACT_SPHERE] THEN ANTS_TAC THENL
       [GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [o_ASSOC] THEN
        MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"(:real^2)") THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [HOMEOMORPHISM_SYM]] THEN
        MATCH_MP_TAC HOMEOMORPHISM_COMPOSE THEN EXISTS_TAC (← q r"(:real^2)") THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"j:real^3->real^3") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"j':real^3->real^3") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
      REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:real^3") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN
      (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN SUBST1_TAC]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [FORALL_IN_IMAGE, o_THM]) THEN
      ASM_SIMP_TAC [o_THM] THEN
      MATCH_MP_TAC (← MESON []
       (← q r"g1(f1 x) = x /\ g2(f2(f x)) = f x ==> g2(f2(f(g1(f1 x)))) = f x")) THEN
      CONJ_TAC THEN
      ASM_REWRITE_TAC [] THEN REPEAT (FIRST_X_ASSUM
           (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphism])) THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_UNIV, o_THM]) THEN
      REWRITE_TAC [o_THM] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []))

  pure { JORDAN_SCHOENFLIES, JORDAN_SCHOENFLIES_S2 }

end HolMultiLib.Cauchy
