    ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
    SIMP_TAC [OPEN_IN_OPEN_INTER, OPEN_HALFSPACE_LT, OPEN_HALFSPACE_GT] THEN
