  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_EQ_MUL_LCANCEL, COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_LMUL, COMPLEX_NORM_DIV, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { COMPLEX_NORM_LE_RE_IM, .. } := D.mt.ra.ts.cn.cxg
  let { SEGMENT_BOUND, .. } := D.mt.ra.ts.cn.qconvex
  let { CONVEX_CONTAINS_SEGMENT_IMP, .. } := D.mt.ra.ts.cn.ms.qconvex
  let { integer, .. } := D.mt.ra.ts.cn.ms.qsession
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, NORM_ARITH,
        NUM_REDUCE_CONV, REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, REAL_RING,
        SET_RULE, .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, .. } := D.mt.ra.ts.cn.cx.cpx
  let { INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { REAL_POW_LE_1, .. } := D.mt.ra.ts.cn.ms.ig.qsession
  let { LIM_WITHIN_INTERIOR, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { ARITH, ARITH_EQ, EXISTS_IN_GSPEC, FORALL_AND_THM, FORALL_IN_GSPEC,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_UNION, LE_1, MONO_EXISTS, OR_EXISTS_THM, REAL_ABS_MUL, REAL_ABS_NUM,
