        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_THM, SURJECTIVE_IMAGE_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_LIFT, NORM_POS_LE, REAL_ABS_NORM, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { BOUNDED_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CBALL, COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_SPHERE,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_ID, CONTINUOUS_ON_LIFT_NORM_COMPOSE,
        CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, IN_SPHERE_0, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { COMPACT_DIFF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { REAL_SUP_LE, REAL_WLOG_LT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qses
  -- @@SCOPE END

  let HADAMARD_THREE_LINE_RE ← prove
   r"!f:complex->complex a b.
        f holomorphic_on {z | a < Re z /\ Re z < b} /\
        f continuous_on {z | a <= Re z /\ Re z <= b} /\
        bounded (IMAGE f {z | a <= Re z /\ Re z <= b})
        ==> (\y. sup {norm(f z) | Re z = y}) real_log_convex_on
            real_interval[a,b]"
   (MAP_EVERY X_GEN_TAC [← q r"f:complex->complex", ← q r"c:real", ← q r"d:real"] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"d < c") THENL
     [ASM_MESON_TAC [REAL_LOG_CONVEX_ON_EMPTY, REAL_INTERVAL_EQ_EMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!z x. c <= x /\ x <= d /\ Re z = x
            ==> norm(f z:complex) <= sup {norm(f w:complex) | Re w = x}")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"{norm(f w:complex) | Re w = x}") BOUNDED_HAS_SUP) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [bounded]) THEN
        REWRITE_TAC [bounded, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
        REWRITE_TAC [NORM_LIFT, REAL_ABS_NORM] THEN ASM_MESON_TAC [],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        EXISTS_TAC (← q r"norm(f(Cx x):complex)") THEN REWRITE_TAC [IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"Cx x") THEN ASM_REWRITE_TAC [RE_CX]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. c <= x /\ x <= d ==> &0 <= sup {norm(f w:complex) | Re w = x}")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"?z. Re z = x") STRIP_ASSUME_TAC THENL
       [EXISTS_TAC (← q r"Cx x") THEN REWRITE_TAC [RE_CX], ALL_TAC] THEN
      TRANS_TAC REAL_LE_TRANS (← q r"norm((f:complex->complex) z)") THEN
      ASM_SIMP_TAC [NORM_POS_LE],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"d:real = c") THEN
    ASM_SIMP_TAC [REAL_INTERVAL_SING, REAL_LOG_CONVEX_ON_SING, REAL_LE_REFL] THEN
    SUBGOAL_THEN (← q r"c < d") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REWRITE_TAC [real_log_convex_on] THEN
    MATCH_MP_TAC REAL_WLOG_LT THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [← GSYM REAL_ADD_RDISTRIB, REAL_MUL_LID] THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC,
        MATCH_MP_TAC REAL_EQ_IMP_LE THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM REAL_POW_1] THEN
        REWRITE_TAC [← GSYM RPOW_POW] THEN FIRST_ASSUM (SUBST1_TAC o SYM) THEN
        MATCH_MP_TAC RPOW_ADD_ALT THEN ASM_REWRITE_TAC [] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC],
      REPEAT GEN_TAC THEN GEN_REWRITE_TAC
       (RAND_CONV o ONCE_DEPTH_CONV) [REAL_ADD_SYM, REAL_MUL_SYM] THEN
      MESON_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN DISCH_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real"] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"(u + v) * a = a /\ (u + v) * b = b /\ c <= a /\ b <= d /\
        u * a <= u * b /\ v * a <= v * b
        ==> c <= u * a + v * b /\ u * a + v * b <= d")) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
      ASM_SIMP_TAC [REAL_MUL_LID, REAL_LE_LMUL, REAL_LT_IMP_LE],
      MATCH_MP_TAC REAL_SUP_LE THEN
      REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM MEMBER_NOT_EMPTY] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"norm(f(Cx(u * a + v * b)):complex)") THEN
        REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [RE_CX],
        MATCH_MP_TAC HADAMARD_THREE_LINE_EXPLICIT_RE THEN
        RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
        ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN REPEAT CONJ_TAC THENL
         [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)),
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)),
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ] BOUNDED_SUBSET)) THEN
          MATCH_MP_TAC IMAGE_SUBSET] THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_REAL_ARITH_TAC]])

  let HADAMARD_THREE_LINE_IM ← prove
   r"!f:complex->complex a b.
        f holomorphic_on {z | a < Im z /\ Im z < b} /\
        f continuous_on {z | a <= Im z /\ Im z <= b} /\
        bounded (IMAGE f {z | a <= Im z /\ Im z <= b})
        ==> (\y. sup {norm(f z) | Im z = y}) real_log_convex_on
            real_interval[a,b]"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"(f:complex->complex) o (\z. ii * z)",
      ← q r"a:real", ← q r"b:real"] HADAMARD_THREE_LINE_RE) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        SIMP_TAC [HOLOMORPHIC_ON_LMUL, HOLOMORPHIC_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)),
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_COMPLEX_LMUL, CONTINUOUS_ON_ID] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_ON_SUBSET)),
        REWRITE_TAC [IMAGE_o] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] BOUNDED_SUBSET)) THEN
        MATCH_MP_TAC IMAGE_SUBSET] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IM_MUL_II],
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM] THEN X_GEN_TAC (← q r"x:real") THEN
      AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"(!z. Q(ii * z) <=> P z) /\ (!z. ii * --ii * z = z)
        ==> {f(ii * z) | P z} = {f z | Q z}")) THEN
      REWRITE_TAC [IM_MUL_II] THEN CONV_TAC COMPLEX_RING])

  /- Likewise the three-circle theorem. -/

  let HADAMARD_THREE_CIRCLE_EXPLICIT ← prove
   r"!f a b u v ma mb.
        &0 < a /\ a <= b /\
        f holomorphic_on {z | a < norm z /\ norm z < b} /\
        f continuous_on {z | a <= norm z /\ norm z <= b} /\
        (!z. norm z = a ==> norm (f z) <= ma) /\
        (!z. norm z = b ==> norm (f z) <= mb) /\
        &0 <= u /\
        &0 <= v /\
        u + v = &1
        ==> !z. norm z = a rpow u * b rpow v
                ==> norm(f z) <= ma rpow u * mb rpow v"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"&0 < b") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"(f:complex->complex) o cexp", ← q r"log a", ← q r"log b",
                    ← q r"u:real", ← q r"v:real", ← q r"ma:real", ← q r"mb:real"]
          HADAMARD_THREE_LINE_EXPLICIT_RE) THEN
    ASM_REWRITE_TAC [o_THM] THEN ANTS_TAC THENL
     [ASM_SIMP_TAC [LOG_MONO_LE_IMP, IMAGE_o] THEN
      SUBGOAL_THEN
       (← q r"IMAGE cexp {z | log a < Re z /\ Re z < log b} =
                   {z | a < norm z /\ norm z < b} /\
        IMAGE cexp {z | log a <= Re z /\ Re z <= log b} =
                   {z | a <= norm z /\ norm z <= b}")
      STRIP_ASSUME_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC SURJECTIVE_IMAGE_EQ THEN
        REWRITE_TAC [IN_ELIM_THM, NORM_CEXP] THEN
        (CONJ_TAC THEN X_GEN_TAC (← q r"z:complex") THENL
          [ASM_CASES_TAC (← q r"z = Cx(&0)") THEN ASM_REWRITE_TAC [COMPLEX_NORM_0] THENL
            [ASM_REAL_ARITH_TAC, ASM_MESON_TAC [CEXP_CLOG]],
           GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
            [← GSYM REAL_EXP_MONO_LT, ← GSYM REAL_EXP_MONO_LE] THEN
           ASM_SIMP_TAC [EXP_LOG]]),
        ASM_REWRITE_TAC []] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_COMPOSE THEN
        ASM_REWRITE_TAC [HOLOMORPHIC_ON_CEXP],
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        ASM_REWRITE_TAC [CONTINUOUS_ON_CEXP],
        FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          COMPACT_CONTINUOUS_IMAGE)) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [← REAL_ARITH (← q r"a <= x /\ x <= b <=> x <= b /\ ~(x < a)")] THEN
          REWRITE_TAC [← NORM_ARITH (← q r"norm z = dist(vec 0,z)")] THEN
          REWRITE_TAC [← GSYM IN_BALL, ← GSYM IN_CBALL, ← GSYM DIFF] THEN
          SIMP_TAC [COMPACT_DIFF, COMPACT_CBALL, OPEN_BALL],
          DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IMP_BOUNDED) THEN
          MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] BOUNDED_SUBSET) THEN
          MATCH_MP_TAC IMAGE_SUBSET THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN REAL_ARITH_TAC],
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [NORM_CEXP, EXP_LOG],
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_SIMP_TAC [NORM_CEXP, EXP_LOG]],
      DISCH_THEN (LABEL_TAC "*") THEN X_GEN_TAC (← q r"z:complex") THEN
      ASM_CASES_TAC (← q r"z = Cx(&0)") THENL
       [MATCH_MP_TAC (← MESON [] (← q r"~(b = a) ==> a = b ==> p")) THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_0, REAL_ENTIRE, RPOW_EQ_0] THEN
        ASM_REAL_ARITH_TAC,
        DISCH_TAC THEN REMOVE_THEN "*" (MP_TAC o SPEC (← q r"clog z"))] THEN
      ASM_SIMP_TAC [CEXP_CLOG, RE_CLOG] THEN DISCH_THEN MATCH_MP_TAC THEN
      ASM_SIMP_TAC [LOG_MUL, RPOW_POS_LT, LOG_RPOW]])

  let HADAMARD_THREE_CIRCLE ← prove
   r"!f a b.
        &0 < a /\ a <= b /\
        f holomorphic_on {z | exp a < norm z /\ norm z < exp b} /\
        f continuous_on {z | exp a <= norm z /\ norm z <= exp b}
        ==> (\y. sup {norm (f z) | norm z = exp y}) real_log_convex_on
            real_interval [a,b]"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_log_convex_on] THEN
    MATCH_MP_TAC REAL_WLOG_LE THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN MATCH_MP_TAC (← MESON []
       (← q r"(!x y. P x y <=> Q y x) ==> ((!x y. P x y) <=> (!x y. Q x y))")) THEN
      REWRITE_TAC [REAL_ADD_SYM, REAL_MUL_SYM] THEN MESON_TAC [],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"d:real"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!z x. c <= x /\ x <= d /\ norm(z:complex) = exp x
            ==> norm(f z:complex) <= sup {norm(f w:complex) | norm w = exp x}")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"{norm((f:complex->complex) w) | norm w = exp x}")
        BOUNDED_HAS_SUP) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE
         (← q r"IMAGE lift {norm(f x) | P x} =
          IMAGE (\x. lift(norm(f x))) {x | P x}")] THEN
        MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
        MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_ON_LIFT_NORM_COMPOSE THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
          SIMP_TAC [SUBSET, IN_ELIM_THM, REAL_EXP_MONO_LE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [IN_REAL_INTERVAL]) THEN
          ASM_REAL_ARITH_TAC,
          REWRITE_TAC [← GSYM IN_SPHERE_0, COMPACT_SPHERE,
                      ← SET_RULE (← q r"{x | x IN s} = s")]],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN MAP_EVERY EXISTS_TAC
         [← q r"norm(f(Cx(exp x)):complex)", ← q r"Cx(exp x)"] THEN
        REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_EXP]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. c <= x /\ x <= d
          ==> &0 <= sup {norm((f:complex->complex) w) | norm w = exp x}")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?z:complex. norm z = exp x") STRIP_ASSUME_TAC THENL
       [EXISTS_TAC (← q r"Cx(exp x)") THEN
        REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_EXP],
        TRANS_TAC REAL_LE_TRANS (← q r"norm((f:complex->complex) z)") THEN
        ASM_SIMP_TAC [NORM_POS_LE]],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"(u + v) * c = c /\ (u + v) * d = d /\
        u * c <= u * d /\ v * c <= v * d
        ==> c <= u * c + v * d /\ u * c + v * d <= d")) THEN
      ASM_SIMP_TAC [REAL_LE_LMUL, REAL_MUL_LID],
      ALL_TAC] THEN
    MATCH_MP_TAC REAL_SUP_LE THEN CONJ_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN MAP_EVERY EXISTS_TAC
       [← q r"norm(f(Cx(exp(u * c + v * d))):complex)", ← q r"Cx(exp(u * c + v * d))"] THEN
      REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_EXP],
      ALL_TAC] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
          HADAMARD_THREE_CIRCLE_EXPLICIT) THEN
    MAP_EVERY EXISTS_TAC [← q r"exp c", ← q r"exp d"] THEN
    ASM_REWRITE_TAC [REAL_EXP_POS_LT, REAL_EXP_MONO_LE] THEN
    ASM_SIMP_TAC [REAL_LE_REFL] THEN REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            HOLOMORPHIC_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"c <= a /\ b <= d ==> a < x /\ x < b ==> c < x /\ x < d")) THEN
      REWRITE_TAC [REAL_EXP_MONO_LE] THEN ASM_MESON_TAC [IN_REAL_INTERVAL],
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            CONTINUOUS_ON_SUBSET)) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN
      MATCH_MP_TAC (← REAL_ARITH
       (← q r"c <= a /\ b <= d ==> a <= x /\ x <= b ==> c <= x /\ x <= d")) THEN
      REWRITE_TAC [REAL_EXP_MONO_LE] THEN ASM_MESON_TAC [IN_REAL_INTERVAL],
      REWRITE_TAC [rpow, REAL_EXP_POS_LT, LOG_EXP, REAL_EXP_ADD]])

  pure { HADAMARD_THREE_LINE_RE, HADAMARD_THREE_LINE_IM, HADAMARD_THREE_CIRCLE_EXPLICIT,
         HADAMARD_THREE_CIRCLE }
/- ------------------------------------------------------------------------- -/
/- Factoring out a zero according to its order.                              -/
/- (cauchy.ml 14214-14489)                                                  -/
/- ------------------------------------------------------------------------- -/

structure KYBI where
  HOLOMORPHIC_FACTOR_ORDER_OF_ZERO : thm
  HOLOMORPHIC_FACTOR_ORDER_OF_ZERO_STRONG : thm
  HOLOMORPHIC_FACTOR_ZERO_NONCONSTANT : thm
  HOLOMORPHIC_LOWER_BOUND_DIFFERENCE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYBI [HolBase] (D : CauchyDeps) (BKYL : KYL) (BKYAI : KYAI) (BKYAL : KYAL) (BKYAQ : KYAQ) (BKYAU : KYAU) : ExceptT String IO KYBI := do
  -- @@SCOPE BEGIN
  let { HOLOMORPHIC_CONVEX_PRIMITIVE, .. } := BKYL
  let { HOLOMORPHIC_COMPLEX_DERIVATIVE, .. } := BKYAI
  let { HOLOMORPHIC_POWER_SERIES, .. } := BKYAL
  let { POWER_SERIES_HOLOMORPHIC, .. } := BKYAQ
  let { HOLOMORPHIC_FUN_EQ_CONST_ON_CONNECTED, .. } := BKYAU
  let { SUMMABLE_0, SUMMABLE_REINDEX, SUMS_OFFSET, SUMS_REINDEX, .. } := D.qtopology
  let { CEXP_ADD, CEXP_N, CEXP_NZ, HAS_COMPLEX_DERIVATIVE_CEXP, HOLOMORPHIC_ON_CEXP,
        .. } := D.mt.ra.tsa
  let { CEXP_CLOG, .. } := D.mt.ra.tsm
  let { SERIES_COMPLEX_LMUL, SUMMABLE_COMPLEX_DIV, .. } := D.mt.ra.ts.knc
  let { COMPLEX_DIFF_CHAIN_AT, complex_differentiable, HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN,
        HAS_COMPLEX_DERIVATIVE_ZERO_CONNECTED_CONSTANT, higher_complex_derivative,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_DIV_AT, .. } := D.mt.ra.ts.knf
  let { HAS_COMPLEX_DERIVATIVE_DIFFERENTIABLE, HOLOMORPHIC_ON_ADD, HOLOMORPHIC_ON_COMPOSE,
        HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV, .. } := D.mt.ra.ts.knh
  let { SUMMABLE_EQ, SUMMABLE_FROM_ELSEWHERE, .. } := D.mt.ra.ts.qtopology
  let { IN_FROM, .. } := D.mt.ra.ts.qmisc
  let { complex_div, complex_pow, SIMPLE_COMPLEX_ARITH_TAC, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_MUL_RID, COMPLEX_MUL_RZERO, COMPLEX_MUL_SYM,
        COMPLEX_SUB_0, COMPLEX_SUB_LZERO, COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, COMPLEX_MUL_RINV, COMPLEX_POW_ADD, COMPLEX_POW_EQ_0,
        COMPLEX_POW_MUL, COMPLEX_POW_ZERO, COMPLEX_VEC_0, CX_INJ, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_1, COMPLEX_DIV_LMUL, COMPLEX_INV_EQ_0, COMPLEX_NORM_MUL,
        COMPLEX_NORM_NZ, COMPLEX_NORM_POW, .. } := D.mt.ra.ts.cn.cxf
  let { summable, SUMS_0, SUMS_INFSUM, .. } := D.mt.ra.ts.cn.qtopology
  let { VSUM_SING_NUMSEG, .. } := D.mt.ra.ts.cn.qvectors
  let { FACT, .. } := D.mt.ra.ts.cn.qsession
  let { FACT_NZ, .. } := D.mt.ra.ts.cn.ms.qsession
  let { SERIES_UNIQUE, .. } := D.mt.ra.ts.cn.ms.qtopology2
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH,
