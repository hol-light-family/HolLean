  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_MUL_RID, REAL_MUL_SYM, REAL_NEG_NEG,
        REAL_NOT_LE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_POS,
        REAL_POW_INV, REAL_POW_MUL, REAL_POW_ONE, REAL_SUB_LE, REAL_SUB_LT, REAL_SUB_RZERO,
        RIGHT_IMP_EXISTS_THM, SKOLEM_THM, SQRT_0, SQRT_POS_LE, SQRT_POW_2, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { num_MAX, real_abs, real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BALL_SUBSET_CBALL, CENTRE_IN_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
