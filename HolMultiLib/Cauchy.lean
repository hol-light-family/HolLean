        MATCH_MP_TAC REAL_LE_MUL2 THEN
        ASM_SIMP_TAC [RPOW_POS_LE, REAL_LE_MIN, RPOW_LE2, REAL_MIN_LE,
                     REAL_LE_REFL]],
      SUBGOAL_THEN (← q r"a < b") ASSUME_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]] THEN
    SUBGOAL_THEN
     (← q r"open {z | a < Re z /\ Re z < b} /\ convex  {z | a < Re z /\ Re z < b} /\
      closure {z | a < Re z /\ Re z < b} = {z | a <= Re z /\ Re z <= b}")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← SET_RULE (← q r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}")] THEN
      SIMP_TAC [CLOSURE_INTER_CONVEX_OPEN, RE_DEF, CONVEX_HALFSPACE_COMPONENT_LT,
