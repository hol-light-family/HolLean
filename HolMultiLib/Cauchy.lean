      REPEAT (FIRST_X_ASSUM (STRIP_ASSUME_TAC o
       GEN_REWRITE_RULE id [HOMEOMORPHISM])) THEN
      EXPAND_TAC "kg" THEN REWRITE_TAC [o_THM] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
