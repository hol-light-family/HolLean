        STRIP_TAC THEN DISCH_THEN (fun th => tactic_of do
            pure (MP_TAC (← MATCH_MP PATH_INTEGRAL_UNIQUE th) THEN
                  MP_TAC (← MATCH_MP HAS_PATH_INTEGRAL_INTEGRABLE th))) THEN
        ASM_SIMP_TAC [PATH_INTEGRABLE_JOIN, VALID_PATH_JOIN_EQ, VALID_PATH_LINEPATH,
          PATHSTART_SUBPATH, PATHFINISH_SUBPATH, PATHSTART_JOIN, PATHFINISH_JOIN,
          PATHSTART_LINEPATH, PATHFINISH_LINEPATH, VALID_PATH_LINEPATH,
          PATH_INTEGRAL_JOIN] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC n <= N ==> n <= N")] THEN
        MATCH_MP_TAC (← ExceptT.mk (COMPLEX_RING
         (← q r"hn - he = hn' /\ gn + gd = gn' /\ hgn = --ghn
          ==> hn - gn = ghn - gh0
              ==> gd + ghn' + he + hgn = Cx(&0)
                  ==> hn' - gn' = ghn' - gh0"))) THEN
        REPEAT CONJ_TAC THENL
         [ASM_SIMP_TAC [complex_sub, ← GSYM PATH_INTEGRAL_REVERSEPATH] THEN
          REWRITE_TAC [REVERSEPATH_SUBPATH] THEN
          MATCH_MP_TAC PATH_INTEGRAL_SUBPATH_COMBINE,
          MATCH_MP_TAC PATH_INTEGRAL_SUBPATH_COMBINE,
          GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
           [← GSYM REVERSEPATH_LINEPATH] THEN
          MATCH_MP_TAC PATH_INTEGRAL_REVERSEPATH] THEN
        ASM_REWRITE_TAC [VALID_PATH_LINEPATH] THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_CMUL, DROP_VEC, REAL_MUL_RID] THEN
        ASM_SIMP_TAC [REAL_LE_DIV, REAL_POS, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1,
                     REAL_MUL_LID, REAL_OF_NUM_LE] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"SUC n <= N ==> n <= N")] THEN
        TRY (MATCH_MP_TAC PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE THEN
            EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [] THEN HolCore.Tactics.NO_TAC) THEN
        ASM_MESON_TAC [PATH_INTEGRABLE_REVERSEPATH, VALID_PATH_LINEPATH,
                      REVERSEPATH_LINEPATH]]))

  /- Hence we can treat even non-rectifiable paths as having a "length"
     for bounds on analytic functions in open sets. -/

  let VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION ← prove
   r"!p:real^1->complex.
     vector_polynomial_function p ==> valid_path p"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [valid_path] THEN
    MATCH_MP_TAC DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE THEN
    MATCH_MP_TAC DIFFERENTIABLE_AT_IMP_DIFFERENTIABLE_ON THEN
    REWRITE_TAC [VECTOR_DERIVATIVE_WORKS] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [vector_derivative] THEN
    CONV_TAC SELECT_CONV THEN
    ASM_MESON_TAC [HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION])

  let PATH_INTEGRAL_BOUND_EXISTS ← prove
   r"!s g. open s /\ valid_path g /\ path_image g SUBSET s
         ==> ?L. &0 < L /\
                 !f B. f holomorphic_on s /\ (!z. z IN s ==> norm(f z) <= B)
                       ==> norm(path_integral g f) <= L * B"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:complex->bool", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_NEARBY_ENDS) THEN
    ASM_SIMP_TAC [VALID_PATH_IMP_PATH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"g:real^1->complex")) THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
    DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"d:real"]
     PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_SIMP_TAC [VALID_PATH_IMP_PATH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:real^1->complex")) THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN STRIP_TAC THEN
    FIRST_ASSUM (X_CHOOSE_THEN (← q r"p':real^1->complex") STRIP_ASSUME_TAC o
      MATCH_MP HAS_VECTOR_DERIVATIVE_VECTOR_POLYNOMIAL_FUNCTION) THEN
    SUBGOAL_THEN (← q r"bounded(IMAGE (p':real^1->complex) (interval[vec 0,vec 1]))")
    MP_TAC THENL
     [MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [COMPACT_INTERVAL] THEN
      ASM_MESON_TAC [CONTINUOUS_VECTOR_POLYNOMIAL_FUNCTION,
                    CONTINUOUS_AT_IMP_CONTINUOUS_ON],
      REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"L:real") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"f path_integrable_on p /\ valid_path p") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE,
                    VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"f:complex->complex", ← q r"p:real^1->complex"]
          PATH_INTEGRAL_INTEGRAL) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
     (← q r"drop(integral (interval[vec 0,vec 1]) (\x:real^1. lift(L * B)))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC INTEGRAL_NORM_BOUND_INTEGRAL THEN
      ASM_REWRITE_TAC [INTEGRABLE_CONST, ← GSYM PATH_INTEGRABLE_ON] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
      REWRITE_TAC [LIFT_DROP, COMPLEX_NORM_MUL] THEN
      MATCH_MP_TAC REAL_LE_MUL2 THEN REWRITE_TAC [NORM_POS_LE] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [path_image, SUBSET, IN_IMAGE],
        ASM_MESON_TAC [VECTOR_DERIVATIVE_AT]],
      REWRITE_TAC [INTEGRAL_CONST, CONTENT_UNIT_1, VECTOR_MUL_LID] THEN
      REWRITE_TAC [LIFT_DROP, REAL_LE_REFL]])

  pure { PATH_INTEGRAL_NEARBY_ENDS, PATH_INTEGRAL_NEARBY_LOOP,
         VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, PATH_INTEGRAL_BOUND_EXISTS }
/- ------------------------------------------------------------------------- -/
/- Winding number; a combined theorem deducing several things piecewise.    -/
/- (cauchy.ml 3694-4025)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYN where
  winding_number : thm
  CX_2PII_NZ : thm
  PATH_INTEGRABLE_INVERSEDIFF : thm
  WINDING_NUMBER : thm
  WINDING_NUMBER_UNIQUE : thm
  WINDING_NUMBER_UNIQUE_LOOP : thm
  WINDING_NUMBER_VALID_PATH : thm
  HAS_PATH_INTEGRAL_WINDING_NUMBER : thm
  WINDING_NUMBER_TRIVIAL : thm
  WINDING_NUMBER_JOIN : thm
  WINDING_NUMBER_REVERSEPATH : thm
  WINDING_NUMBER_SHIFTPATH : thm
  WINDING_NUMBER_SPLIT_LINEPATH : thm
  WINDING_NUMBER_EQUAL : thm
  WINDING_NUMBER_OFFSET : thm
  WINDING_NUMBER_JOIN_POS_COMBINED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYN [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYD : KYD) (BKYE : KYE) (BKYF : KYF) (BKYH : KYH) (BKYL : KYL) (BKYM : KYM) : ExceptT String IO KYN := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, PIECEWISE_DIFFERENTIABLE_ADD,
        PIECEWISE_DIFFERENTIABLE_SUB, .. } := BKYA
  let { valid_path, VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_PATH_INTEGRAL_INTEGRAL, PATH_INTEGRAL_REVERSEPATH, VALID_PATH_REVERSEPATH,
        .. } := BKYC
  let { PATH_INTEGRAL_JOIN, VALID_PATH_JOIN, .. } := BKYD
  let { PATH_INTEGRAL_SHIFTPATH, PATH_INTEGRAL_TRIVIAL, VALID_PATH_LINEPATH,
        VALID_PATH_SHIFTPATH, .. } := BKYE
  let { PATH_INTEGRAL_INTEGRAL, .. } := BKYF
  let { PATH_INTEGRAL_SPLIT_LINEPATH, .. } := BKYH
  let { PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE, .. } := BKYL
  let { PATH_INTEGRAL_NEARBY_ENDS, PATH_INTEGRAL_NEARBY_LOOP,
        VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { DIFFERENTIABLE_ON_CONST, HAS_DERIVATIVE_AT, .. } := D.qderivatives
  let { PATHFINISH_SHIFTPATH, .. } := D.qpaths
  let { SUBSET_SEGMENT, .. } := D.qconvex
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { CX_PI_NZ, .. } := D.mt.ra.tsf
  let { CONTINUOUS_ON_COMPLEX_DIV, .. } := D.mt.ra.ts.knc
  let { complex_differentiable, HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { COMPLEX_DIFF_CONV, COMPLEX_DIFFERENTIABLE_TAC, .. } := D.mt.ra.ts.knk
  let { COMPLEX_ADD_LDISTRIB, COMPLEX_MUL_RNEG, COMPLEX_MUL_RZERO, COMPLEX_SUB_0,
        COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_ENTIRE, CX_INJ, II_NZ, RE_ADD, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { vector_derivative, .. } := D.mt.ra.ts.cn.qderivatives
  let { INTEGRAL_EQ, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, new_definition, NORM_ARITH,
        REAL_ARITH, SELECT_CONV, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { has_vector_derivative, .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { PATH_IMAGE_SHIFTPATH, PATH_SHIFTPATH, PATHSTART_SHIFTPATH, reversepath, shiftpath,
        .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IMP_CONJ, IN_DELETE, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_MIN, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_EQ, RIGHT_FORALL_IMP_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DROP_ADD, DROP_CMUL, DROP_SUB, DROP_VEC, NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB, ENDS_IN_SEGMENT,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_UNIV, SEGMENT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { joinpaths, path_image, PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH,
        PATH_IMAGE_REVERSEPATH, PATH_JOIN, PATH_REVERSEPATH, pathfinish, PATHFINISH_JOIN,
        PATHFINISH_REVERSEPATH, pathstart, PATHSTART_JOIN, PATHSTART_REVERSEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { OPEN_DELETE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  -- @@SCOPE END

  let winding_number ← new_definition
   r"winding_number(g,z) =
    @n. !e. &0 < e
            ==> ?p. valid_path p /\ ~(z IN path_image p) /\
                    pathstart p = pathstart g /\
                    pathfinish p = pathfinish g /\
                    (!t. t IN interval[vec 0,vec 1] ==> norm(g t - p t) < e) /\
                    path_integral p (\w. Cx(&1) / (w - z)) =
                    Cx(&2) * Cx(pi) * ii * n"

  let CX_2PII_NZ ← prove
   r"~(Cx(&2) * Cx(pi) * ii = Cx(&0))"
   (SIMP_TAC [COMPLEX_ENTIRE, CX_PI_NZ, II_NZ, CX_INJ, REAL_OF_NUM_EQ, ARITH])

  let PATH_INTEGRABLE_INVERSEDIFF ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g)
         ==> (\w. Cx(&1) / (w - z)) path_integrable_on g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE THEN
    EXISTS_TAC (← q r"(:complex) DELETE z") THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, HOLOMORPHIC_ON_OPEN, ← SET_RULE
     (← q r"s SUBSET (UNIV DELETE x) <=> ~(x IN s)")] THEN
    X_GEN_TAC (← q r"w:complex") THEN REWRITE_TAC [IN_UNIV, IN_DELETE] THEN
    STRIP_TAC THEN
    W (fun (_asl, w) => tactic_of do
      pure (MP_TAC (← DISCH_ALL
        (← COMPLEX_DIFF_CONV (← liftExcept (HolCore.Basics.dest_exists w)).2)))) THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN MESON_TAC [])

  let WINDING_NUMBER ← prove
   r"!g z e.
        path g /\ ~(z IN path_image g) /\ &0 < e
         ==> ?p. valid_path p /\ ~(z IN path_image p) /\
                 pathstart p = pathstart g /\
                 pathfinish p = pathfinish g /\
                 (!t. t IN interval[vec 0,vec 1] ==> norm(g t - p t) < e) /\
                 path_integral p (\w. Cx(&1) / (w - z)) =
                 Cx(&2) * Cx(pi) * ii * winding_number(g,z)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN DISCH_TAC THEN GEN_TAC THEN DISCH_TAC THEN
    REWRITE_TAC [winding_number] THEN CONV_TAC SELECT_CONV THEN
    MP_TAC (← ISPECL [← q r"(:complex) DELETE z", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_NEARBY_ENDS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"d / &2"]
      PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real^1->complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii) *
                path_integral h (\w. Cx(&1) / (w - z))") THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"min d e / &2"]
      PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_LT_MIN] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:real^1->complex") THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, CX_2PII_NZ, ← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(a * b * c = Cx(&0))
      ==> a * b * c * Cx(&1) / (a * b * c) * z = z"))] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"h:real^1->complex", ← q r"p:real^1->complex"]) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
      ASM_MESON_TAC [← NORM_ARITH
       (← q r"norm(h - g) < d / &2 /\ norm(p - g) < min d e / &2
        ==> norm(h - g) < d /\ norm(p - g) < d")],
      ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"t SUBSET UNIV DELETE x <=> ~(x IN t)")] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [NORM_SUB, ← REAL_ARITH (← q r"&0 < e /\ x < min d e / &2 ==> x < e")],
      ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, HOLOMORPHIC_ON_OPEN] THEN
    REWRITE_TAC [IN_DELETE, IN_UNIV, ← GSYM complex_differentiable] THEN
    REPEAT STRIP_TAC THEN COMPLEX_DIFFERENTIABLE_TAC THEN
    ASM_REWRITE_TAC [COMPLEX_SUB_0])

  let WINDING_NUMBER_UNIQUE ← prove
   r"!g z n.
        path g /\ ~(z IN path_image g) /\
        (!e. &0 < e
             ==> ?p. valid_path p /\ ~(z IN path_image p) /\
                     pathstart p = pathstart g /\
                     pathfinish p = pathfinish g /\
                     (!t. t IN interval[vec 0,vec 1]
                          ==> norm(g t - p t) < e) /\
                     path_integral p (\w. Cx(&1) / (w - z)) =
                     Cx(&2) * Cx(pi) * ii * n)
        ==> winding_number(g,z) = n"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:complex) DELETE z", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_NEARBY_ENDS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"] WINDING_NUMBER) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:real^1->complex", ← q r"q:real^1->complex"]) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN ASM_SIMP_TAC [] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\w. Cx(&1) / (w - z)")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, HOLOMORPHIC_ON_OPEN] THEN
      REWRITE_TAC [IN_DELETE, IN_UNIV, ← GSYM complex_differentiable] THEN
      REPEAT STRIP_TAC THEN COMPLEX_DIFFERENTIABLE_TAC THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_0],
      ASM_REWRITE_TAC [] THEN MP_TAC CX_2PII_NZ THEN
      CONV_TAC COMPLEX_RING])

  let WINDING_NUMBER_UNIQUE_LOOP ← prove
   r"!g z e n.
        path g /\ ~(z IN path_image g) /\ pathfinish g = pathstart g /\
        (!e. &0 < e
             ==> ?p. valid_path p /\ ~(z IN path_image p) /\
                     pathfinish p = pathstart p /\
                     (!t. t IN interval[vec 0,vec 1]
                          ==> norm(g t - p t) < e) /\
                     path_integral p (\w. Cx(&1) / (w - z)) =
                     Cx(&2) * Cx(pi) * ii * n)
        ==> winding_number(g,z) = n"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"(:complex) DELETE z", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_NEARBY_LOOP) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"] WINDING_NUMBER) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:real^1->complex", ← q r"q:real^1->complex"]) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [NORM_SUB] THEN ASM_SIMP_TAC [] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"\w. Cx(&1) / (w - z)")) THEN
    ANTS_TAC THENL
     [ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, HOLOMORPHIC_ON_OPEN] THEN
      REWRITE_TAC [IN_DELETE, IN_UNIV, ← GSYM complex_differentiable] THEN
      REPEAT STRIP_TAC THEN COMPLEX_DIFFERENTIABLE_TAC THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_0],
      ASM_REWRITE_TAC [] THEN MP_TAC CX_2PII_NZ THEN
      CONV_TAC COMPLEX_RING])

  let WINDING_NUMBER_VALID_PATH ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g)
         ==> winding_number(g,z) =
             Cx(&1) / (Cx(&2) * Cx(pi) * ii) *
             path_integral g (\w. Cx(&1) / (w - z))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_UNIQUE THEN
    ASM_SIMP_TAC [VALID_PATH_IMP_PATH] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"g:real^1->complex") THEN
    ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
    MP_TAC CX_2PII_NZ THEN CONV_TAC COMPLEX_FIELD)

  let HAS_PATH_INTEGRAL_WINDING_NUMBER ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g)
         ==> ((\w. Cx(&1) / (w - z)) has_path_integral
              (Cx(&2) * Cx(pi) * ii * winding_number(g,z))) g"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH] THEN
    ASM_SIMP_TAC [CX_2PII_NZ, ← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(a * b * c = Cx(&0))
      ==> a * b * c * Cx(&1) / (a * b * c) * z = z"))] THEN
    MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
    ASM_SIMP_TAC [PATH_INTEGRABLE_INVERSEDIFF])

  let WINDING_NUMBER_TRIVIAL ← prove
   r"!a z. ~(z = a) ==> winding_number(linepath(a,a),z) = Cx(&0)"
   (SIMP_TAC [VALID_PATH_LINEPATH, PATH_INTEGRAL_TRIVIAL, COMPLEX_MUL_RZERO,
             WINDING_NUMBER_VALID_PATH, PATH_IMAGE_LINEPATH, SEGMENT_REFL,
             IN_SING])

  let WINDING_NUMBER_JOIN ← prove
   r"!g1 g2 z.
        path g1 /\ path g2 /\ pathfinish g1 = pathstart g2 /\
        ~(z IN path_image g1) /\ ~(z IN path_image g2)
        ==> winding_number(g1 ++ g2,z) =
            winding_number(g1,z) + winding_number(g2,z)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_UNIQUE THEN
    ASM_SIMP_TAC [PATH_JOIN, PATH_IMAGE_JOIN, IN_UNION] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g2:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN
    MP_TAC (← ISPECL [← q r"g1:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"p1:real^1->complex") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"p2:real^1->complex") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"p1 ++ p2:real^1->complex") THEN
    ASM_SIMP_TAC [VALID_PATH_JOIN, PATHSTART_JOIN, PATHFINISH_JOIN] THEN
    ASM_SIMP_TAC [PATH_IMAGE_JOIN, IN_UNION] THEN  CONJ_TAC THENL
     [REWRITE_TAC [joinpaths, IN_INTERVAL_1, DROP_VEC] THEN REPEAT STRIP_TAC THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_CMUL, DROP_SUB] THEN
      ASM_REAL_ARITH_TAC,
      W (MP_TAC o PART_MATCH (lhs o rand) PATH_INTEGRAL_JOIN o lhand o snd) THEN
      ASM_REWRITE_TAC [COMPLEX_ADD_LDISTRIB] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      CONJ_TAC THEN MATCH_MP_TAC PATH_INTEGRABLE_INVERSEDIFF THEN
      ASM_REWRITE_TAC []])

  let WINDING_NUMBER_REVERSEPATH ← prove
   r"!g z. path g /\ ~(z IN path_image g)
         ==> winding_number(reversepath g,z) = --(winding_number(g,z))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_UNIQUE THEN
    ASM_SIMP_TAC [PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"reversepath p:real^1->complex") THEN
    ASM_SIMP_TAC [VALID_PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH,
                 PATHSTART_REVERSEPATH, PATHFINISH_REVERSEPATH,
                 PATH_INTEGRAL_REVERSEPATH, PATH_INTEGRABLE_INVERSEDIFF] THEN
    REWRITE_TAC [COMPLEX_MUL_RNEG, reversepath, IN_INTERVAL_1, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_SUB] THEN ASM_REAL_ARITH_TAC)

  let WINDING_NUMBER_SHIFTPATH ← prove
   r"!g a z. path g /\ pathfinish g = pathstart g /\ ~(z IN path_image g) /\
           a IN interval[vec 0,vec 1]
           ==> winding_number(shiftpath a g,z) = winding_number(g,z)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_UNIQUE_LOOP THEN
    ASM_SIMP_TAC [PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
      ASM_SIMP_TAC [PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"shiftpath a p:real^1->complex") THEN
    ASM_SIMP_TAC [VALID_PATH_SHIFTPATH, PATH_IMAGE_SHIFTPATH,
                 PATH_INTEGRAL_SHIFTPATH, PATH_INTEGRABLE_INVERSEDIFF] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTERVAL_1, DROP_VEC]) THEN
    ASM_SIMP_TAC [PATHSTART_SHIFTPATH, PATHFINISH_SHIFTPATH] THEN
    SIMP_TAC [COMPLEX_MUL_RNEG, shiftpath, IN_INTERVAL_1, DROP_ADD, DROP_VEC] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, DROP_SUB, DROP_ADD] THEN
    ASM_REAL_ARITH_TAC)

  let WINDING_NUMBER_SPLIT_LINEPATH ← prove
   r"!a b c z.
    c IN segment[a,b] /\ ~(z IN segment[a,b])
    ==> winding_number(linepath(a,b),z) =
        winding_number(linepath(a,c),z) +
        winding_number(linepath(c,b),z)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~((z:complex) IN segment[a,c]) /\ ~(z IN segment[c,b])")
    STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
       (← q r"~(z IN s) ==> t SUBSET s ==> ~(z IN t)"))) THEN
      ASM_REWRITE_TAC [SUBSET_SEGMENT, ENDS_IN_SEGMENT],
      ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH, PATH_IMAGE_LINEPATH,
                   VALID_PATH_LINEPATH] THEN
      REWRITE_TAC [← GSYM COMPLEX_ADD_LDISTRIB] THEN AP_TERM_TAC THEN
      MATCH_MP_TAC PATH_INTEGRAL_SPLIT_LINEPATH THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_DIV THEN
      SIMP_TAC [CONTINUOUS_ON_CONST, CONTINUOUS_ON_SUB, CONTINUOUS_ON_ID] THEN
      ASM_MESON_TAC [COMPLEX_SUB_0]])

  let WINDING_NUMBER_EQUAL ← prove
   r"!p q z. (!t. t IN interval[vec 0,vec 1] ==> p t = q t)
           ==> winding_number(p,z) = winding_number(q,z)"
   (REPEAT STRIP_TAC THEN SIMP_TAC [winding_number, PATH_INTEGRAL_INTEGRAL] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"W:complex") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"g:real^1->complex") THEN
    ASM_SIMP_TAC [pathstart, pathfinish, ENDS_IN_UNIT_INTERVAL])

  let WINDING_NUMBER_OFFSET ← prove
   r"!p z. winding_number(p,z) = winding_number((\w. p w - z),Cx(&0))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [winding_number, PATH_INTEGRAL_INTEGRAL] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"W:complex") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"&0 < e") THEN
    ASM_REWRITE_TAC [path_image, valid_path, pathstart, pathfinish] THEN
    EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real^1->complex") STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"\t. (g:real^1->complex) t - z"),
      EXISTS_TAC (← q r"\t. (g:real^1->complex) t + z")] THEN
    ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"(p - z) - (g - z):complex = p - g")),
                    ← ExceptT.mk (COMPLEX_RING (← q r"p - (g + z):complex = p - z - g")),
                    ← ExceptT.mk (COMPLEX_RING (← q r"(p - z) + z:complex = p")),
                    COMPLEX_SUB_RZERO] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_IMAGE]) THEN
    ASM_SIMP_TAC [PIECEWISE_DIFFERENTIABLE_ADD, PIECEWISE_DIFFERENTIABLE_SUB,
                 DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE,
                 DIFFERENTIABLE_ON_CONST, IN_IMAGE] THEN
    ASM_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"Cx(&0) = w - z <=> z = w")),
                    ← ExceptT.mk (COMPLEX_RING (← q r"z = w + z <=> Cx(&0) = w"))] THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
    MATCH_MP_TAC INTEGRAL_EQ THEN X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"(w + z) - z = w - Cx(&0)"))] THEN
    AP_TERM_TAC THEN
    REWRITE_TAC [vector_derivative, has_vector_derivative, HAS_DERIVATIVE_AT,
                ← ExceptT.mk (COMPLEX_RING (← q r"(x - z) - (w - z):complex = x - w")),
                ← ExceptT.mk (COMPLEX_RING (← q r"(x + z) - (w + z):complex = x - w"))])

  /- A combined theorem deducing several things piecewise. -/

  let WINDING_NUMBER_JOIN_POS_COMBINED ← prove
   r"!g1 g2 z.
       (valid_path g1 /\
        ~(z IN path_image g1) /\
        &0 < Re(winding_number(g1,z))) /\
       (valid_path g2 /\
        ~(z IN path_image g2) /\
        &0 < Re(winding_number(g2,z))) /\
       pathfinish g1 = pathstart g2
       ==> valid_path(g1 ++ g2) /\
           ~(z IN path_image(g1 ++ g2)) /\
           &0 < Re(winding_number(g1 ++ g2,z))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [VALID_PATH_JOIN] THEN
    ASM_SIMP_TAC [PATH_IMAGE_JOIN, VALID_PATH_IMP_PATH, IN_UNION] THEN
    ASM_SIMP_TAC [WINDING_NUMBER_JOIN, VALID_PATH_IMP_PATH, RE_ADD] THEN
    ASM_REAL_ARITH_TAC)

  pure { winding_number, CX_2PII_NZ, PATH_INTEGRABLE_INVERSEDIFF, WINDING_NUMBER,
         WINDING_NUMBER_UNIQUE, WINDING_NUMBER_UNIQUE_LOOP, WINDING_NUMBER_VALID_PATH,
         HAS_PATH_INTEGRAL_WINDING_NUMBER, WINDING_NUMBER_TRIVIAL, WINDING_NUMBER_JOIN,
         WINDING_NUMBER_REVERSEPATH, WINDING_NUMBER_SHIFTPATH,
         WINDING_NUMBER_SPLIT_LINEPATH, WINDING_NUMBER_EQUAL, WINDING_NUMBER_OFFSET,
         WINDING_NUMBER_JOIN_POS_COMBINED }
/- ------------------------------------------------------------------------- -/
/- Useful sufficient conditions for the winding number to be positive etc.   -/
/- (cauchy.ml 4026-4122)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYO where
  RE_WINDING_NUMBER : thm
  WINDING_NUMBER_POS_LE : thm
  WINDING_NUMBER_POS_LT_LEMMA : thm
  WINDING_NUMBER_POS_LT : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYO [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYN : KYN) : ExceptT String IO KYO := do
  -- @@SCOPE BEGIN
  let { PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_PATH_INTEGRAL, HAS_PATH_INTEGRAL_INTEGRAL, .. } := BKYC
  let { PATH_INTEGRABLE_INVERSEDIFF, WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { CONTENT_UNIT_1, HAS_INTEGRAL_SPIKE_INTERIOR, .. } := D.qintegration
  let { PI_POS, .. } := D.mt.ra.tse
  let { HAS_INTEGRAL_COMPONENT_LE, .. } := D.mt.ra.qintegration
  let { complex_div, complex_inv, complex_mul, IM, IM_DEF, RE, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID, COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG,
        COMPLEX_MUL_SYM, .. } := D.mt.ra.ts.cn.cxb
  let { CX_INV, CX_MUL, CX_POW, IM_CX, IM_MUL_CX, IM_MUL_II, IM_NEG, RE_CX, RE_MUL_CX,
        RE_MUL_II, RE_NEG, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_INV_MUL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_INV_II, .. } := D.mt.ra.ts.cn.cxf
  let { cnj, COMPLEX_DIV_CNJ, .. } := D.mt.ra.ts.cn.cxg
  let { HAS_INTEGRAL_COMPONENT_POS, HAS_INTEGRAL_CONST,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_FIELD, REAL_RING,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { REAL_LE_SQUARE, .. } := D.mt.ra.ts.cn.cx.cpx
  let { ARITH, DIMINDEX_2, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_o, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD, REAL_LE_DIV, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_MUL, REAL_LE_MUL2,
        REAL_LE_REFL, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_MUL, REAL_LTE_TRANS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_OF_NUM_LT, REAL_POS, REAL_POW_2, REAL_POW_LE, REAL_POW_LE2, REAL_POW_LT,
        SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, NORM_POS_LT, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { VECTOR_MUL_LID, VECTOR_SUB_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_POS, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_CONTINUOUS_IMAGE, COMPACT_IMP_BOUNDED, COMPACT_INTERVAL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUB,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  -- @@SCOPE END

  let RE_WINDING_NUMBER ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g)
         ==> Re(winding_number(g,z)) =
             Im(path_integral g (\w. Cx(&1) / (w - z))) / (&2 * pi)"
   (SIMP_TAC [WINDING_NUMBER_VALID_PATH, complex_div, COMPLEX_MUL_LID] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM CX_MUL] THEN
    REWRITE_TAC [COMPLEX_INV_MUL, ← GSYM CX_INV, COMPLEX_INV_II] THEN
    REWRITE_TAC [COMPLEX_MUL_LNEG, COMPLEX_MUL_RNEG, RE_NEG] THEN
    REWRITE_TAC [← GSYM COMPLEX_MUL_ASSOC, RE_MUL_CX, RE_MUL_II] THEN
    MP_TAC PI_POS THEN CONV_TAC REAL_FIELD)

  let WINDING_NUMBER_POS_LE ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g) /\
         (!x. x IN interval(vec 0,vec 1)
              ==> &0 <= Im(vector_derivative g (at x) * cnj(g x - z)))
         ==> &0 <= Re(winding_number(g,z))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [RE_WINDING_NUMBER] THEN
    MATCH_MP_TAC REAL_LE_DIV THEN
    SIMP_TAC [REAL_LE_MUL, REAL_POS, PI_POS, REAL_LT_IMP_LE, IM_DEF] THEN
    MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "M"), (← qty "2", ← qty "N")]
      HAS_INTEGRAL_COMPONENT_POS) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\x:real^1. if x IN interval(vec 0,vec 1)
                  then Cx(&1) / (g x - z) * vector_derivative g (at x)
                  else Cx(&0)",
      ← q r"interval[vec 0:real^1,vec 1]"] THEN
    REWRITE_TAC [ARITH, DIMINDEX_2] THEN CONJ_TAC THENL
     [MATCH_MP_TAC HAS_INTEGRAL_SPIKE_INTERIOR THEN
      EXISTS_TAC (← q r"\x:real^1. Cx(&1) / (g x - z) * vector_derivative g (at x)") THEN
      ASM_SIMP_TAC [] THEN REWRITE_TAC [← GSYM HAS_PATH_INTEGRAL] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
      ASM_SIMP_TAC [PATH_INTEGRABLE_INVERSEDIFF],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [← GSYM IM_DEF, IM_CX, REAL_LE_REFL] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
    ASM_REWRITE_TAC [complex_div, COMPLEX_MUL_LID] THEN
    REWRITE_TAC [complex_inv, complex_inv, complex_mul, RE, IM, cnj] THEN
    REWRITE_TAC [real_div, ← REAL_RING
     (← q r"(a * x) * b + (--c * x) * d:real = x * (a * b - c * d)")] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_MUL THEN
    SIMP_TAC [REAL_POW_2, REAL_LE_INV_EQ, REAL_LE_ADD, REAL_LE_SQUARE] THEN
    ASM_REAL_ARITH_TAC)

  let WINDING_NUMBER_POS_LT_LEMMA ← prove
   r"!g z e. valid_path g /\ ~(z IN path_image g) /\ &0 < e /\
           (!x. x IN interval(vec 0,vec 1)
                ==> e <= Im(vector_derivative g (at x) / (g x - z)))
           ==> &0 < Re(winding_number(g,z))"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [RE_WINDING_NUMBER] THEN
    MATCH_MP_TAC REAL_LT_DIV THEN
    SIMP_TAC [REAL_LT_MUL, REAL_OF_NUM_LT, ARITH, PI_POS] THEN
    MATCH_MP_TAC REAL_LTE_TRANS THEN EXISTS_TAC (← q r"Im(ii * Cx e)") THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [COMPLEX_MUL_LNEG, IM_MUL_II, IM_NEG, RE_CX], ALL_TAC] THEN
    REWRITE_TAC [IM_DEF] THEN
    MATCH_MP_TAC (← ISPECL [← q r"\x:real^1. ii * Cx e",
          ← q r"\x:real^1. if x IN interval(vec 0,vec 1)
                      then Cx(&1) / (g x - z) * vector_derivative g (at x)
                      else ii * Cx e",
          ← q r"interval[vec 0:real^1,vec 1]", ← q r"ii * Cx e",
          ← q r"path_integral g (\w. Cx(&1) / (w - z))", ← q r"2"]
         HAS_INTEGRAL_COMPONENT_LE) THEN
    REWRITE_TAC [DIMINDEX_2, ARITH] THEN REPEAT CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_MUL_LID] THEN
      ONCE_REWRITE_TAC [← GSYM CONTENT_UNIT_1] THEN
      REWRITE_TAC [HAS_INTEGRAL_CONST],
      MATCH_MP_TAC HAS_INTEGRAL_SPIKE_INTERIOR THEN
      EXISTS_TAC (← q r"\x:real^1. Cx(&1) / (g x - z) * vector_derivative g (at x)") THEN
      ASM_SIMP_TAC [] THEN REWRITE_TAC [← GSYM HAS_PATH_INTEGRAL] THEN
      MATCH_MP_TAC HAS_PATH_INTEGRAL_INTEGRAL THEN
      ASM_SIMP_TAC [PATH_INTEGRABLE_INVERSEDIFF],
      X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [← GSYM IM_DEF, IM_CX, REAL_LE_REFL] THEN
      REWRITE_TAC [IM_MUL_II, RE_CX] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real^1")) THEN
      ASM_REWRITE_TAC [complex_div, COMPLEX_MUL_LID, COMPLEX_MUL_SYM]])

  let WINDING_NUMBER_POS_LT ← prove
   r"!g z e. valid_path g /\ ~(z IN path_image g) /\ &0 < e /\
           (!x. x IN interval(vec 0,vec 1)
                ==> e <= Im(vector_derivative g (at x) * cnj(g x - z)))
           ==> &0 < Re(winding_number(g,z))"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"bounded (IMAGE (\w. w - z) (path_image g))") MP_TAC THENL
     [REWRITE_TAC [path_image, ← GSYM IMAGE_o] THEN
      MATCH_MP_TAC COMPACT_IMP_BOUNDED THEN
      MATCH_MP_TAC COMPACT_CONTINUOUS_IMAGE THEN
      REWRITE_TAC [COMPACT_INTERVAL] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID] THEN
      MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON THEN
      ASM_REWRITE_TAC [← GSYM valid_path],
      ALL_TAC] THEN
    REWRITE_TAC [BOUNDED_POS, FORALL_IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC WINDING_NUMBER_POS_LT_LEMMA THEN
    EXISTS_TAC (← q r"e:real / B pow 2") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_POW_LT] THEN
    X_GEN_TAC (← q r"x:real^1") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [COMPLEX_DIV_CNJ] THEN
    REWRITE_TAC [real_div, complex_div, ← GSYM CX_INV, ← GSYM CX_POW] THEN
    REWRITE_TAC [IM_MUL_CX] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LE_INV_EQ, REAL_POW_LE] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_POW_LT THEN REWRITE_TAC [NORM_POS_LT, VECTOR_SUB_EQ] THEN
      UNDISCH_TAC (← q r"~((z:complex) IN path_image g)"),
      MATCH_MP_TAC REAL_POW_LE2 THEN REWRITE_TAC [NORM_POS_LE] THEN
      FIRST_X_ASSUM MATCH_MP_TAC] THEN
    REWRITE_TAC [path_image, IN_IMAGE] THEN
    ASM_MESON_TAC [SUBSET, INTERVAL_OPEN_SUBSET_CLOSED])

  pure { RE_WINDING_NUMBER, WINDING_NUMBER_POS_LE, WINDING_NUMBER_POS_LT_LEMMA,
         WINDING_NUMBER_POS_LT }
/- ------------------------------------------------------------------------- -/
/- The winding number is an integer (proof from Ahlfors's book).             -/
/- (cauchy.ml 4123-4448)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYP where
  WINDING_NUMBER_AHLFORS_LEMMA : thm
  WINDING_NUMBER_AHLFORS : thm
  WINDING_NUMBER_AHLFORS_FULL : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYP [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYF : KYF) (BKYL : KYL) (BKYN : KYN) : ExceptT String IO KYP := do
  -- @@SCOPE BEGIN
  let { DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE, piecewise_differentiable_on,
        PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON, .. } := BKYA
  let { valid_path, .. } := BKYB
  let { HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE, .. } := BKYC
  let { PATH_INTEGRAL_INTEGRAL, .. } := BKYF
  let { HOLOMORPHIC_CONVEX_PRIMITIVE, PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY, .. } := BKYL
  let { WINDING_NUMBER, .. } := BKYN
  let { FINITE_SET_AVOID, .. } := D.qtopology
  let { CEXP_0, CEXP_ADD, CONTINUOUS_ON_CEXP, HAS_COMPLEX_DERIVATIVE_CEXP,
        .. } := D.mt.ra.tsa
  let { FUNDAMENTAL_THEOREM_OF_CALCULUS, HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL,
        .. } := D.mt.ra.qintegration
  let { CONTINUOUS_ON_COMPLEX_MUL, .. } := D.mt.ra.ts.knc
  let { complex_differentiable, has_complex_derivative, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
        HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { COMPLEX_DIFF_TAC, .. } := D.mt.ra.ts.knk
  let { complex_div, complex_sub, SIMPLE_COMPLEX_ARITH, SIMPLE_COMPLEX_ARITH_TAC,
        .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID, COMPLEX_MUL_SYM, COMPLEX_NEG_0, COMPLEX_SUB_0,
        COMPLEX_SUB_REFL, COMPLEX_SUB_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_VEC_0, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_0, COMPLEX_NORM_NZ, .. } := D.mt.ra.ts.cn.cxf
  let { BILINEAR_COMPLEX_MUL, .. } := D.mt.ra.ts.cn.cxh
  let { HAS_DERIVATIVE_TRANSFORM_WITHIN, .. } := D.mt.ra.ts.cn.qderivatives
  let { DIFFERENTIABLE_AT_WITHIN, HAS_VECTOR_DERIVATIVE_NEG, HAS_VECTOR_DERIVATIVE_SUB,
        .. } := D.mt.ra.ts.cn.ms.qderivatives
  let { INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, INTEGRABLE_SUBINTERVAL,
        .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integrable_on, integral, INTEGRAL_COMBINE, INTEGRAL_REFL, INTEGRAL_UNIQUE,
        .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { DIFF_CHAIN_WITHIN, has_vector_derivative, HAS_VECTOR_DERIVATIVE_ADD,
        HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN, HAS_VECTOR_DERIVATIVE_CONST,
        HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET, VECTOR_DERIVATIVE_WORKS,
        .. } := D.mt.ra.ts.cn.ms.ig.qderivatives
  let { NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { CONJ_ASSOC, DIFF_EMPTY, ETA_AX, FINITE_RULES, FORALL_AND_THM,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_EQ_THM, IN_DELETE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNIV, LEFT_EXISTS_AND_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_MIN, REAL_LT_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LE, REAL_POS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, o_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_SUB, DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, drop, VECTOR_ADD_RID, VECTOR_MUL_RZERO, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN,
        CONTINUOUS_ON_NEG, CONTINUOUS_ON_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERIOR_OPEN, OPEN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_within, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONVEX_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qconvex
  let { path_image, pathfinish, pathstart, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_INTERVAL_1, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { FINITE_IMP_COUNTABLE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcard
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let WINDING_NUMBER_AHLFORS_LEMMA ← (do
    let lemma ← prove
     r"!f g g' s x z.
          (g has_vector_derivative g') (at x within s) /\
          (f has_vector_derivative (g' / (g x - z))) (at x within s) /\
          ~(g x = z)
          ==> ((\x. cexp(--f x) * (g x - z)) has_vector_derivative Cx(&0))
              (at x within s)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"cexp(--f x) * (g' - Cx(&0)) +
        (cexp(--f x) * --(g' / ((g:real^1->complex) x - z))) * (g x - z) = Cx(&0)")
       (SUBST1_TAC o SYM)
      THENL
       [FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
        CONV_TAC COMPLEX_FIELD,
        ALL_TAC] THEN
      MATCH_MP_TAC (← ISPEC (← q r"( * ):complex->complex->complex")
        HAS_VECTOR_DERIVATIVE_BILINEAR_WITHIN) THEN
      REWRITE_TAC [BILINEAR_COMPLEX_MUL, ← GSYM COMPLEX_VEC_0] THEN
      ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_SUB, ETA_AX,
                   HAS_VECTOR_DERIVATIVE_CONST] THEN
      GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
      REWRITE_TAC [has_vector_derivative] THEN
      SUBGOAL_THEN (← q r"!x y. (\z. drop z % (x * y :complex)) =
                          (\w. x * w) o (\z. drop z % y)")
       (fun th => REWRITE_TAC [th])
      THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, COMPLEX_CMUL] THEN
        SIMPLE_COMPLEX_ARITH_TAC,
        ALL_TAC] THEN
      MATCH_MP_TAC DIFF_CHAIN_WITHIN THEN
      REWRITE_TAC [← GSYM has_complex_derivative, ← GSYM has_vector_derivative] THEN
      SIMP_TAC [HAS_COMPLEX_DERIVATIVE_CEXP, HAS_COMPLEX_DERIVATIVE_AT_WITHIN] THEN
      ASM_SIMP_TAC [HAS_VECTOR_DERIVATIVE_NEG])
    prove
     r"!g a b.
        g piecewise_differentiable_on interval [a,b] /\
        drop a <= drop b /\ (!x. x IN interval [a,b] ==> ~(g x = z))
        ==> (\x. vector_derivative g (at x within interval[a,b]) / (g(x) - z))
            integrable_on interval[a,b] /\
            cexp(--(integral (interval[a,b])
                        (\x. vector_derivative g (at x within interval[a,b]) /
                               (g(x) - z)))) *
            (g(b) - z) = g(a) - z"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!w. ~(w = z)
            ==> ?h. !y. norm(y - w) < norm(w - z)
                        ==> (h has_complex_derivative inv(y - z)) (at y)")
       (LABEL_TAC "P")
      THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"\w:complex. inv(w - z)",
                   ← q r"ball(w:complex,norm(w - z))",
                   ← q r"{}:complex->bool"]
                  HOLOMORPHIC_CONVEX_PRIMITIVE) THEN
        SIMP_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, OPEN_BALL, INTERIOR_OPEN] THEN
        REWRITE_TAC [CONVEX_BALL, FINITE_RULES, DIFF_EMPTY] THEN ANTS_TAC THENL
         [SUBGOAL_THEN (← q r"(\w. inv(w - z)) holomorphic_on ball(w:complex,norm(w - z))")
           (fun th =>
            MESON_TAC [HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                      OPEN_BALL, complex_differentiable, th]) THEN
          SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL, IN_BALL] THEN
          X_GEN_TAC (← q r"u:complex") THEN DISCH_TAC THEN
          EXISTS_TAC (← q r"--Cx(&1) / (u - z) pow 2") THEN COMPLEX_DIFF_TAC THEN
          REWRITE_TAC [COMPLEX_SUB_RZERO, COMPLEX_SUB_0] THEN
          ASM_MESON_TAC [REAL_LT_REFL, dist],
          ALL_TAC] THEN
        REWRITE_TAC [IN_BALL, dist] THEN MESON_TAC [NORM_SUB],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!t. t IN interval[a,b]
            ==> (\x. vector_derivative g (at x within interval[a,b]) / (g(x) - z))
                integrable_on interval[a,t] /\
                cexp(--(integral (interval[a,t])
                             (\x. vector_derivative g (at x within interval[a,b]) /
                                  (g(x) - z)))) *
                (g(t) - z) = g(a) - z")
       (fun th => MATCH_MP_TAC th THEN
                  ASM_REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL]) THEN
      REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN MATCH_MP_TAC INTEGRABLE_SUBINTERVAL THEN
        MAP_EVERY EXISTS_TAC [← q r"a:real^1", ← q r"b:real^1"] THEN
        ASM_REWRITE_TAC [SUBSET_INTERVAL_1, REAL_LE_REFL] THEN
        CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [IN_INTERVAL_1]] THEN
        REWRITE_TAC [integrable_on, complex_div] THEN
        ONCE_REWRITE_TAC [COMPLEX_MUL_SYM] THEN
        REWRITE_TAC [HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE] THEN
        REWRITE_TAC [← GSYM integrable_on] THEN
        MATCH_MP_TAC PATH_INTEGRAL_LOCAL_PRIMITIVE_ANY THEN
        EXISTS_TAC (← q r"(:complex) DELETE z") THEN
        ASM_SIMP_TAC [IN_DELETE, IN_UNIV,
                     DIFFERENTIABLE_ON_IMP_PIECEWISE_DIFFERENTIABLE] THEN
        X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"norm(w - z:complex)") THEN
        ASM_REWRITE_TAC [COMPLEX_NORM_NZ, COMPLEX_SUB_0] THEN
        ASM_MESON_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN],
        ALL_TAC] THEN
      DISCH_TAC THEN MATCH_MP_TAC HAS_DERIVATIVE_ZERO_UNIQUE_STRONG_INTERVAL THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [piecewise_differentiable_on]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [IN_DIFF, FINITE_IMP_COUNTABLE] THEN
      X_GEN_TAC (← q r"k:real^1->bool") THEN STRIP_TAC THEN
      ASM_SIMP_TAC [CONVEX_INTERVAL, INTEGRAL_REFL] THEN
      REWRITE_TAC [COMPLEX_VEC_0, COMPLEX_NEG_0, CEXP_0, COMPLEX_MUL_LID] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_MUL THEN
        ASM_SIMP_TAC [CONTINUOUS_ON_SUB, CONTINUOUS_ON_CONST, ETA_AX,
                     PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        REWRITE_TAC [CONTINUOUS_ON_CEXP] THEN
        MATCH_MP_TAC CONTINUOUS_ON_NEG THEN
        MATCH_MP_TAC INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [IN_INTERVAL_1, REAL_LE_REFL],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"\w:complex. inv(w - z)",
                     ← q r"ball((g:real^1->complex) t,dist(g t,z))",
                     ← q r"{}:complex->bool"]
                    HOLOMORPHIC_CONVEX_PRIMITIVE) THEN
      SIMP_TAC [HAS_COMPLEX_DERIVATIVE_WITHIN_OPEN, OPEN_BALL, INTERIOR_OPEN] THEN
      REWRITE_TAC [CONVEX_BALL, FINITE_RULES, DIFF_EMPTY] THEN ANTS_TAC THENL
       [SUBGOAL_THEN (← q r"(\w. inv(w - z)) holomorphic_on ball(g(t:real^1),dist(g t,z))")
         (fun th =>
          MESON_TAC [HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                    OPEN_BALL, complex_differentiable, th]) THEN
        SIMP_TAC [HOLOMORPHIC_ON_OPEN, OPEN_BALL, IN_BALL] THEN
        X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"--Cx(&1) / (w - z) pow 2") THEN COMPLEX_DIFF_TAC THEN
        REWRITE_TAC [COMPLEX_SUB_RZERO, COMPLEX_SUB_0] THEN
        ASM_MESON_TAC [REAL_LT_REFL],
        ALL_TAC] THEN
      REWRITE_TAC [IN_BALL, dist] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"h:complex->complex")) THEN
      SUBGOAL_THEN (← q r"(\h. Cx(&0)) = (\h. drop h % Cx(&0))") SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, ← GSYM COMPLEX_VEC_0, VECTOR_MUL_RZERO],
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM has_vector_derivative] THEN MATCH_MP_TAC lemma THEN
      EXISTS_TAC (← q r"vector_derivative g (at t within interval[a,b]):complex") THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
        ASM_MESON_TAC [DIFFERENTIABLE_AT_WITHIN],
        ALL_TAC,
        ASM_MESON_TAC []] THEN
      REWRITE_TAC [has_vector_derivative] THEN
      MATCH_MP_TAC HAS_DERIVATIVE_TRANSFORM_WITHIN THEN
      ASM_REWRITE_TAC [← GSYM has_vector_derivative] THEN
      EXISTS_TAC (← q r"\u. integral (interval [a,t])
                      (\x. vector_derivative g (at x within interval [a,b]) /
                           ((g:real^1->complex) x - z)) + (h(g(u)) - h(g(t)))") THEN
      REWRITE_TAC [LEFT_EXISTS_AND_THM, CONJ_ASSOC] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
       [ALL_TAC,
        ONCE_REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + (b - c) = b + (a - c):complex"))] THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM VECTOR_ADD_RID] THEN
        MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_ADD THEN
        REWRITE_TAC [HAS_VECTOR_DERIVATIVE_CONST] THEN
        REWRITE_TAC [has_vector_derivative] THEN
        SUBGOAL_THEN (← q r"!x y. (\h. drop h % x / y) =
                            (\x. inv(y) * x) o (\h. drop h % x)")
         (fun th => REWRITE_TAC [th])
        THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM, COMPLEX_CMUL] THEN
          SIMPLE_COMPLEX_ARITH_TAC,
          ALL_TAC] THEN
        GEN_REWRITE_TAC (RATOR_CONV o LAND_CONV) [← GSYM o_DEF] THEN
        MATCH_MP_TAC DIFF_CHAIN_WITHIN THEN
        REWRITE_TAC [← GSYM has_complex_derivative, ← GSYM has_vector_derivative] THEN
        REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [DIFFERENTIABLE_AT_WITHIN], ALL_TAC] THEN
        MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_AT_WITHIN THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        REWRITE_TAC [COMPLEX_SUB_REFL, COMPLEX_NORM_0, COMPLEX_NORM_NZ] THEN
        ASM_SIMP_TAC [COMPLEX_SUB_0]] THEN
      SUBGOAL_THEN
       (← q r"?d. &0 < d /\
            !y:real^1. y IN interval[a,b] /\ dist(y,t) < d
                       ==> dist(g y:complex,g t) < norm(g t - z) /\ ~(y IN k)")
      MP_TAC THENL
       [SUBGOAL_THEN (← q r"(g:real^1->complex) continuous (at t within interval[a,b])")
        MP_TAC THENL
         [ASM_MESON_TAC [PIECEWISE_DIFFERENTIABLE_ON_IMP_CONTINUOUS_ON,
                        CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN],
          ALL_TAC] THEN
        REWRITE_TAC [continuous_within] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"norm((g:real^1->complex) t - z)")) THEN
        ASM_SIMP_TAC [COMPLEX_NORM_NZ, COMPLEX_SUB_0] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"d2:real") STRIP_ASSUME_TAC o
          SPEC (← q r"t:real^1") o MATCH_MP FINITE_SET_AVOID) THEN
        EXISTS_TAC (← q r"min d1 d2") THEN ASM_SIMP_TAC [REAL_LT_MIN] THEN
        ASM_MESON_TAC [DIST_SYM, REAL_NOT_LE],
        ALL_TAC] THEN
      REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
      REWRITE_TAC [FORALL_AND_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"u:real^1") THEN REWRITE_TAC [dist] THEN
      STRIP_TAC THEN
      DISJ_CASES_TAC (← REAL_ARITH (← q r"drop t <= drop u \/ drop u <= drop t")) THENL
       [SUBGOAL_THEN
         (← q r"integral (interval [a,u])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z)) =
          integral (interval [a,t])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z)) +
          integral (interval [t,u])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z))")
        SUBST1_TAC THENL
         [CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_COMBINE THEN
          ASM_MESON_TAC [IN_INTERVAL_1],
          ALL_TAC] THEN
        SIMP_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a + x = a + y <=> y:complex = x"))],
        SUBGOAL_THEN
         (← q r"integral (interval [a,t])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z)) =
          integral (interval [a,u])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z)) +
          integral (interval [u,t])
            (\x. vector_derivative g (at x within interval [a,b]) / (g x - z))")
        SUBST1_TAC THENL
         [CONV_TAC SYM_CONV THEN MATCH_MP_TAC INTEGRAL_COMBINE THEN
          ASM_MESON_TAC [IN_INTERVAL_1],
          ALL_TAC] THEN
        SIMP_TAC [← ExceptT.mk (COMPLEX_RING
          (← q r"(a + x) + (w - z) = a <=> x:complex = z - w"))]] THEN
      (MATCH_MP_TAC INTEGRAL_UNIQUE THEN
       MATCH_MP_TAC FUNDAMENTAL_THEOREM_OF_CALCULUS THEN
       ASM_REWRITE_TAC [← GSYM o_DEF] THEN X_GEN_TAC (← q r"x:real^1") THEN
       REPEAT STRIP_TAC THEN REWRITE_TAC [has_vector_derivative, COMPLEX_CMUL] THEN
       SUBGOAL_THEN (← q r"!x y. (\h. Cx(drop h) * x / y) =
                           (\x. inv(y) * x) o (\h. drop h % x)")
        (fun th => REWRITE_TAC [th])
       THENL
        [REWRITE_TAC [FUN_EQ_THM, o_THM, COMPLEX_CMUL] THEN
         SIMPLE_COMPLEX_ARITH_TAC,
         ALL_TAC] THEN
       MATCH_MP_TAC DIFF_CHAIN_WITHIN THEN
       REWRITE_TAC [← GSYM has_complex_derivative, ← GSYM has_vector_derivative] THEN
       CONJ_TAC THENL
        [MATCH_MP_TAC HAS_VECTOR_DERIVATIVE_WITHIN_SUBSET THEN
         EXISTS_TAC (← q r"interval[a:real^1,b]") THEN
         REWRITE_TAC [← GSYM VECTOR_DERIVATIVE_WORKS] THEN CONJ_TAC THENL
          [MATCH_MP_TAC DIFFERENTIABLE_AT_WITHIN THEN
           FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
            [ALL_TAC, FIRST_X_ASSUM MATCH_MP_TAC],
           ALL_TAC] THEN
         REPEAT (FIRST_X_ASSUM (MP_TAC o
            check (fun t => !(HolCore.Basics.is_forall (concl t))))) THEN
         REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB] THEN
         REWRITE_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1, REAL_LE_REFL] THEN
         REAL_ARITH_TAC,
         ALL_TAC] THEN
       MATCH_MP_TAC HAS_COMPLEX_DERIVATIVE_AT_WITHIN THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM dist] THEN
       ONCE_REWRITE_TAC [DIST_SYM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
       CONJ_TAC THENL [ASM_MESON_TAC [IN_INTERVAL_1, REAL_LE_TRANS], ALL_TAC] THEN
       REPEAT (FIRST_X_ASSUM (MP_TAC o
          check (fun t => !(HolCore.Basics.is_forall (concl t))))) THEN
       REWRITE_TAC [dist, NORM_REAL, ← GSYM drop, DROP_SUB] THEN
       REWRITE_TAC [SUBSET_INTERVAL_1, IN_INTERVAL_1, REAL_LE_REFL] THEN
       REAL_ARITH_TAC)))

  let WINDING_NUMBER_AHLFORS ← prove
   r"!g z a b.
        g piecewise_differentiable_on interval [a,b] /\
        drop a <= drop b /\ (!x. x IN interval [a,b] ==> ~(g x = z))
        ==> (\x. vector_derivative g (at x) / (g(x) - z))
            integrable_on interval[a,b] /\
            cexp(--(integral (interval[a,b])
                             (\x. vector_derivative g (at x) / (g(x) - z)))) *
            (g(b) - z) = g(a) - z"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [integrable_on, integral] THEN
    REWRITE_TAC [← ONCE_REWRITE_RULE [COMPLEX_MUL_SYM] complex_div] THEN
    REWRITE_TAC [← GSYM HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE] THEN
    ONCE_REWRITE_TAC [← ONCE_REWRITE_RULE [COMPLEX_MUL_SYM] (← GSYM complex_div)] THEN
    REWRITE_TAC [← GSYM integral, ← GSYM integrable_on] THEN
    MATCH_MP_TAC WINDING_NUMBER_AHLFORS_LEMMA THEN ASM_REWRITE_TAC [])

  let WINDING_NUMBER_AHLFORS_FULL ← prove
   r"!p z. path p /\ ~(z IN path_image p)
         ==> pathfinish p - z =
             cexp(Cx(&2) * Cx pi * ii * winding_number(p,z)) *
             (pathstart p - z)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"p:real^1->complex", ← q r"z:complex", ← q r"&1"] WINDING_NUMBER) THEN
    ASM_REWRITE_TAC [REAL_LT_01, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real^1->complex") THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (SUBST_ALL_TAC o SYM)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [valid_path, path_image, IN_IMAGE,
          NOT_EXISTS_THM]) THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->complex", ← q r"z:complex", ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
     WINDING_NUMBER_AHLFORS) THEN
    ASM_SIMP_TAC [DROP_VEC, REAL_POS, pathstart, pathfinish] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [], DISCH_THEN (SUBST1_TAC o SYM o CONJUNCT2)] THEN
    REWRITE_TAC [← GSYM CEXP_ADD, COMPLEX_MUL_ASSOC, PATH_INTEGRAL_INTEGRAL] THEN
    REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"Cx(&1) / z * w = w / z")] THEN
    REWRITE_TAC [← GSYM complex_sub, COMPLEX_SUB_REFL, CEXP_0, COMPLEX_MUL_LID])

  pure { WINDING_NUMBER_AHLFORS_LEMMA, WINDING_NUMBER_AHLFORS,
         WINDING_NUMBER_AHLFORS_FULL }
/- ------------------------------------------------------------------------- -/
/- Winding numbers as complex integers; |WN| >= 1 means the path meets      -/
/- every direction; one way of proving that WN=1 for a loop.                 -/
/- (cauchy.ml 4449-4656)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYQ where
  complex_integer : thm
  COMPLEX_INTEGER : thm
  INTEGER_WINDING_NUMBER_EQ : thm
  INTEGER_WINDING_NUMBER : thm
  WINDING_NUMBER_POS_MEETS : thm
  WINDING_NUMBER_BIG_MEETS : thm
  WINDING_NUMBER_LT_1 : thm
  WINDING_NUMBER_EQ_1 : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYQ [HolBase] (D : CauchyDeps) (BKYA : KYA) (BKYB : KYB) (BKYC : KYC) (BKYN : KYN) (BKYP : KYP) : ExceptT String IO KYQ := do
  -- @@SCOPE BEGIN
  let { PIECEWISE_DIFFERENTIABLE_ON_SUBSET, .. } := BKYA
  let { valid_path, VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE, has_path_integral, HAS_PATH_INTEGRAL,
        PATH_INTEGRABLE_ON, path_integral, VALID_PATH_REVERSEPATH, .. } := BKYC
  let { CX_2PII_NZ, PATH_INTEGRABLE_INVERSEDIFF, WINDING_NUMBER,
        WINDING_NUMBER_REVERSEPATH, WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { WINDING_NUMBER_AHLFORS, .. } := BKYP
  let { CEXP_ADD, CEXP_NEG, CEXP_NZ, .. } := D.mt.ra.tsa
  let { CX_EXP, REAL_EXP_NZ, REAL_EXP_POS_LT, .. } := D.mt.ra.tsb
  let { PI_POS, .. } := D.mt.ra.tse
  let { CEXP_EQ_1, .. } := D.mt.ra.tsf
  let { ARG, .. } := D.mt.ra.tsh
  let { complex_div, COMPLEX_EQ, IM_DEF, RE, SIMPLE_COMPLEX_ARITH, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_MUL_AC, COMPLEX_MUL_ASSOC, COMPLEX_MUL_LID, COMPLEX_MUL_LNEG,
        COMPLEX_MUL_RID, COMPLEX_MUL_RNEG, COMPLEX_MUL_SYM, COMPLEX_SUB_0,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_EXPAND, CX_INJ, CX_INV, CX_MUL, IM_CX, IM_MUL_CX, IM_MUL_II, IM_NEG, RE_CX,
        RE_MUL_CX, RE_MUL_II, RE_NEG, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, COMPLEX_INV_INV, COMPLEX_INV_MUL, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_DIV_RMUL, COMPLEX_INV_II, COMPLEX_INV_NEG, COMPLEX_NORM_NZ,
        COMPLEX_NORM_ZERO, .. } := D.mt.ra.ts.cn.cxf
  let { IVT_INCREASING_COMPONENT_ON_1, .. } := D.mt.ra.ts.cn.ms.qconvex
  let { INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { integral, INTEGRAL_REFL, .. } := D.mt.ra.ts.cn.ms.qintegration3
  let { REAL_LT_INTEGERS, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, MESON_TAC, new_definition, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { CLOSED_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, DIMINDEX_2, EQ_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_IMP, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_ENTIRE, REAL_INV_DIV, REAL_INV_EQ_0, REAL_LE_RDIV_EQ, REAL_LE_TRANS,
        REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_IMP_NZ, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RNEG, REAL_NEG_EQ_0, REAL_NEG_NEG, REAL_NOT_LE, REAL_OF_NUM_EQ, REAL_POS,
        SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_abs, real_div, real_ge, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_VEC, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { VEC_COMPONENT, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { IN_BALL, IN_INTERVAL_1, OPEN_CONTAINS_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { closed, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_image, PATH_IMAGE_REVERSEPATH, pathfinish, pathstart,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  -- @@SCOPE END

  let complex_integer ← new_definition
   r"complex_integer z <=> integer(Re z) /\ Im z = &0"

  let COMPLEX_INTEGER ← prove
   r"complex_integer z <=> ?n. integer n /\ z = Cx n"
   (REWRITE_TAC [COMPLEX_EQ, RE_CX, IM_CX, complex_integer] THEN MESON_TAC [])

  let INTEGER_WINDING_NUMBER_EQ ← prove
   r"!g z. path g /\ ~(z IN path_image g)
         ==> (complex_integer(winding_number(g,z)) <=>
              pathfinish g = pathstart g)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:complex) DIFF path_image g") OPEN_CONTAINS_BALL) THEN
    ASM_SIMP_TAC [← GSYM closed, CLOSED_PATH_IMAGE, VALID_PATH_IMP_PATH] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, SUBSET, IN_BALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"complex_integer(winding_number(p,z)) <=>
      pathfinish p = pathstart p")
    MP_TAC THENL
     [UNDISCH_THEN
       (← q r"path_integral p (\w. Cx(&1) / (w - z)) =
        Cx(&2) * Cx pi * ii * winding_number (g,z)") (K ALL_TAC) THEN
      ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH],
      ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH, CX_2PII_NZ, ← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(a * b * c = Cx(&0))
        ==> Cx(&1) / (a * b * c) * a * b * c * z = z"))]] THEN
    UNDISCH_THEN (← q r"pathstart p:complex = pathstart g") (SUBST_ALL_TAC o SYM) THEN
    UNDISCH_THEN (← q r"pathfinish p:complex = pathfinish g") (SUBST_ALL_TAC o SYM) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [valid_path, path_image]) THEN
    REWRITE_TAC [pathfinish, pathstart] THEN
    MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"cexp(path_integral p (\w. Cx(&1) / (w - z))) = Cx(&1)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [CEXP_EQ_1, complex_integer] THEN
      REWRITE_TAC [complex_div, COMPLEX_MUL_LID, COMPLEX_INV_MUL] THEN
      SIMP_TAC [← GSYM CX_INV, ← GSYM CX_MUL, COMPLEX_MUL_ASSOC, COMPLEX_INV_II] THEN
      REWRITE_TAC [RE_MUL_CX, IM_MUL_CX, ← GSYM COMPLEX_MUL_ASSOC] THEN
      REWRITE_TAC [COMPLEX_MUL_LNEG, RE_MUL_II, IM_MUL_II, RE_NEG, IM_NEG] THEN
      REWRITE_TAC [REAL_NEG_NEG, REAL_ENTIRE, REAL_INV_EQ_0, REAL_NEG_EQ_0] THEN
      SIMP_TAC [REAL_OF_NUM_EQ, ARITH, REAL_LT_IMP_NZ, PI_POS] THEN
      SIMP_TAC [PI_POS, ← REAL_FIELD
       (← q r"&0 < p ==> (x = &2 * n * p <=> (inv(&2) * inv(p)) * x = n)")] THEN
      MESON_TAC [],
      MP_TAC (← ISPECL [← q r"p:real^1->complex", ← q r"z:complex",
                     ← q r"vec 0:real^1", ← q r"vec 1:real^1"]
                    WINDING_NUMBER_AHLFORS) THEN
      ASM_REWRITE_TAC [DROP_VEC, REAL_POS] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      REWRITE_TAC [← ONCE_REWRITE_RULE [COMPLEX_MUL_SYM] complex_div] THEN
      REWRITE_TAC [integral, ← GSYM HAS_INTEGRAL_LOCALIZED_VECTOR_DERIVATIVE] THEN
      REWRITE_TAC [← GSYM has_path_integral, ← GSYM path_integral] THEN
      REWRITE_TAC [CEXP_NEG, COMPLEX_MUL_RID] THEN
      MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
       (← q r"~(i = Cx(&0)) /\ ~(g0 = z)
        ==> (inv i * (g1 - z) = g0 - z ==> (i = Cx(&1) <=> g1 = g0))"))) THEN
      REWRITE_TAC [CEXP_NZ] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [IN_IMAGE]) THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC] THEN MESON_TAC [REAL_POS, DROP_VEC]])

  let INTEGER_WINDING_NUMBER ← prove
   r"!g z. path g /\ pathfinish g = pathstart g /\ ~(z IN path_image g)
         ==> complex_integer(winding_number(g,z))"
   (MESON_TAC [INTEGER_WINDING_NUMBER_EQ])

  /- For |WN| >= 1 the path must contain points in every direction.
     We can thus bound the WN of a path that doesn't meet some "cut". -/

  let WINDING_NUMBER_POS_MEETS ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g) /\
         Re(winding_number(g,z)) >= &1
         ==> !w. ~(w = z)
                 ==> ?a. &0 < a /\ z + (Cx a * (w - z)) IN path_image g"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!t. t IN interval[vec 0,vec 1] ==> ~((g:real^1->complex) t = z)")
    ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"~((z:complex) IN path_image g)") THEN
      REWRITE_TAC [path_image, IN_IMAGE] THEN MESON_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"r:complex = (w - z) / (pathstart g - z)") THEN
    STRIP_ASSUME_TAC (← GSYM (← SPEC (← q r"r:complex") ARG)) THEN
    SUBGOAL_THEN
     (← q r"?t. t IN interval[vec 0,vec 1] /\
          Im(integral (interval[vec 0,t])
                      (\x. vector_derivative g (at x) / (g x - z))) = Arg r")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [IM_DEF] THEN MATCH_MP_TAC IVT_INCREASING_COMPONENT_ON_1 THEN
      ASM_SIMP_TAC [DIMINDEX_2, DROP_VEC, ARITH, INTEGRAL_REFL, REAL_POS,
                   VEC_COMPONENT] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT THEN
        REWRITE_TAC [← ONCE_REWRITE_RULE [COMPLEX_MUL_SYM] complex_div] THEN
        REWRITE_TAC [← GSYM PATH_INTEGRABLE_ON] THEN
        REWRITE_TAC [← SIMPLE_COMPLEX_ARITH (← q r"inv z = Cx(&1) / z")] THEN
        MATCH_MP_TAC PATH_INTEGRABLE_INVERSEDIFF THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"&2 * pi") THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
      UNDISCH_TAC (← q r"Re(winding_number (g,z)) >= &1") THEN
      ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH, ← GSYM IM_DEF] THEN
      REWRITE_TAC [path_integral, HAS_PATH_INTEGRAL, ← GSYM integral] THEN
      SUBST1_TAC (← ExceptT.mk (COMPLEX_FIELD (← q r"ii = --inv ii"))) THEN
      REWRITE_TAC [complex_div, COMPLEX_INV_MUL, COMPLEX_INV_NEG] THEN
      REWRITE_TAC [← GSYM CX_INV, ← GSYM CX_MUL, COMPLEX_MUL_ASSOC] THEN
      REWRITE_TAC [RE_MUL_CX, RE, COMPLEX_MUL_RNEG, RE_NEG, COMPLEX_MUL_LNEG,
                  COMPLEX_INV_INV, ← GSYM COMPLEX_MUL_ASSOC, RE_MUL_II] THEN
      REWRITE_TAC [REAL_MUL_RNEG, REAL_NEG_NEG] THEN
      SIMP_TAC [← REAL_ARITH (← q r"((&1 * inv(&2)) * p) * x >= &1 <=> &2 <= x * p")] THEN
      SIMP_TAC [← GSYM real_div, REAL_LE_RDIV_EQ, PI_POS] THEN
      REWRITE_TAC [COMPLEX_MUL_LID, COMPLEX_MUL_AC],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"g:real^1->complex", ← q r"z:complex", ← q r"vec 0:real^1", ← q r"t:real^1"]
     WINDING_NUMBER_AHLFORS) THEN
    ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC PIECEWISE_DIFFERENTIABLE_ON_SUBSET THEN
        EXISTS_TAC (← q r"interval[vec 0:real^1,vec 1]") THEN
        RULE_ASSUM_TAC (REWRITE_RULE [valid_path]) THEN ASM_REWRITE_TAC [],
        ALL_TAC,
        GEN_TAC THEN
        DISCH_THEN (fun th => FIRST_ASSUM MATCH_MP_TAC THEN MP_TAC th)] THEN
      UNDISCH_TAC (← q r"(t:real^1) IN interval[vec 0,vec 1]") THEN
      REWRITE_TAC [SUBSET, IN_INTERVAL_1, DROP_VEC] THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN REWRITE_TAC [CEXP_NEG] THEN
    ABBREV_TAC (← q r"i = integral (interval [vec 0,t])
      (\x. vector_derivative g (at x) / (g x - z))") THEN
    SUBST1_TAC (← SPEC (← q r"i:complex") COMPLEX_EXPAND) THEN
    ASM_REWRITE_TAC [CEXP_ADD, COMPLEX_INV_MUL, ← GSYM CX_EXP] THEN
    UNDISCH_TAC (← q r"Cx(norm r) * cexp(ii * Cx(Arg r)) = r") THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (MP_TAC o MATCH_MP (← ExceptT.mk (COMPLEX_FIELD
     (← q r"x * e = r /\ (y * inv e) * w = z
      ==> ~(e = Cx(&0)) ==> x * y * w = r * z")))) THEN
    REWRITE_TAC [CEXP_NZ] THEN
    EXPAND_TAC "r" THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ONCE_DEPTH_CONV) [pathstart] THEN
    SUBGOAL_THEN (← q r"~((g:real^1->complex)(vec 0) = z)") ASSUME_TAC THENL
     [FIRST_ASSUM MATCH_MP_TAC THEN SIMP_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS],
      ALL_TAC] THEN
    ASM_SIMP_TAC [COMPLEX_DIV_RMUL, COMPLEX_SUB_0, ← GSYM CX_INV, ← GSYM CX_MUL,
                 COMPLEX_MUL_ASSOC, ← GSYM real_div] THEN
    DISCH_TAC THEN
    EXISTS_TAC (← q r"exp(Re i) / norm(r:complex)") THEN
    SUBGOAL_THEN (← q r"~(r = Cx(&0))") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(x = Cx(&0)) /\ ~(y = Cx(&0)) ==> ~(x / y = Cx(&0))"))) THEN
      ASM_REWRITE_TAC [COMPLEX_SUB_0, pathstart],
      ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_EXP_POS_LT, COMPLEX_NORM_NZ] THEN
    REWRITE_TAC [path_image, IN_IMAGE] THEN
    EXISTS_TAC (← q r"t:real^1") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
     (← q r"inv i * (gt - z) = wz /\ ~(i = Cx(&0)) ==> z + i * wz = gt"))) THEN
    ASM_REWRITE_TAC [← GSYM CX_INV, REAL_INV_DIV, CX_INJ] THEN
    MATCH_MP_TAC (← REAL_FIELD (← q r"~(x = &0) /\ ~(y = &0) ==> ~(x / y = &0)")) THEN
    ASM_REWRITE_TAC [REAL_EXP_NZ, COMPLEX_NORM_ZERO])

  let WINDING_NUMBER_BIG_MEETS ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g) /\
         abs(Re(winding_number(g,z))) >= &1
         ==> !w. ~(w = z)
                 ==> ?a. &0 < a /\ z + (Cx a * (w - z)) IN path_image g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_abs] THEN COND_CASES_TAC THEN
    ASM_SIMP_TAC [WINDING_NUMBER_POS_MEETS] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_SIMP_TAC [← GSYM RE_NEG, VALID_PATH_IMP_PATH,
                 ← GSYM WINDING_NUMBER_REVERSEPATH] THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [← GSYM PATH_IMAGE_REVERSEPATH] THEN
    MATCH_MP_TAC WINDING_NUMBER_POS_MEETS THEN
    ASM_SIMP_TAC [PATH_IMAGE_REVERSEPATH, VALID_PATH_REVERSEPATH])

  let WINDING_NUMBER_LT_1 ← prove
   r"!g w z. valid_path g /\ ~(z IN path_image g) /\ ~(w = z) /\
           (!a. &0 < a ==> ~(z + (Cx a * (w - z)) IN path_image g))
           ==> Re(winding_number(g,z)) < &1"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM REAL_NOT_LE, ← GSYM real_ge] THEN
    ASM_MESON_TAC [WINDING_NUMBER_POS_MEETS])

  /- One way of proving that WN=1 for a loop. -/

  let WINDING_NUMBER_EQ_1 ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g) /\ pathfinish g = pathstart g /\
         &0 < Re(winding_number(g,z)) /\ Re(winding_number(g,z)) < &2
         ==> winding_number(g,z) = Cx(&1)"
   (REPEAT GEN_TAC THEN
    REPLICATE_TAC 3 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    SUBGOAL_THEN (← q r"complex_integer(winding_number(g,z))") MP_TAC THENL
     [ASM_SIMP_TAC [INTEGER_WINDING_NUMBER, VALID_PATH_IMP_PATH], ALL_TAC] THEN
    SIMP_TAC [complex_integer, COMPLEX_EQ, RE_CX, IM_CX] THEN
    SIMP_TAC [REAL_LT_INTEGERS, INTEGER_CLOSED] THEN REAL_ARITH_TAC)

  pure { complex_integer, COMPLEX_INTEGER, INTEGER_WINDING_NUMBER_EQ,
         INTEGER_WINDING_NUMBER, WINDING_NUMBER_POS_MEETS, WINDING_NUMBER_BIG_MEETS,
         WINDING_NUMBER_LT_1, WINDING_NUMBER_EQ_1 }
/- ------------------------------------------------------------------------- -/
/- Continuity of winding number and invariance on connected sets.            -/
/- (cauchy.ml 4657-4858)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYR where
  CONTINUOUS_AT_WINDING_NUMBER : thm
  CONTINUOUS_ON_WINDING_NUMBER : thm
  WINDING_NUMBER_CONSTANT : thm
  WINDING_NUMBER_EQ : thm
  OPEN_WINDING_NUMBER_LEVELSETS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYR [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYG : KYG) (BKYM : KYM) (BKYN : KYN) (BKYQ : KYQ) : ExceptT String IO KYR := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { PATH_INTEGRAL_SUB, .. } := BKYG
  let { PATH_INTEGRAL_BOUND_EXISTS, PATH_INTEGRAL_NEARBY_ENDS, .. } := BKYM
  let { PATH_INTEGRABLE_INVERSEDIFF, WINDING_NUMBER, WINDING_NUMBER_UNIQUE,
        WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { COMPLEX_INTEGER, INTEGER_WINDING_NUMBER, .. } := BKYQ
  let { CONTINUOUS_TRANSFORM_AT, .. } := D.qtopology
  let { REAL_ABS_PI, .. } := D.mt.ra.tse
  let { PI_APPROX_32, .. } := D.mt.ra.tsl
  let { complex_differentiable, HOLOMORPHIC_ON_OPEN, .. } := D.mt.ra.ts.kne
  let { COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_DIV_AT,
        COMPLEX_DIFFERENTIABLE_ID, COMPLEX_DIFFERENTIABLE_SUB, .. } := D.mt.ra.ts.kng
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { CONTINUOUS_DISCRETE_RANGE_CONSTANT, .. } := D.mt.ra.ts.qtopology
  let { COMPLEX_SUB_0, COMPLEX_SUB_LDISTRIB, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_NORM_CX, COMPLEX_NORM_II, CX_INJ, CX_SUB, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { COMPLEX_NORM_DIV, COMPLEX_NORM_INV, COMPLEX_NORM_MUL, .. } := D.mt.ra.ts.cn.cxf
  let { REAL_ABS_INTEGER_LEMMA, .. } := D.mt.ra.ts.cn.ms.qfloor
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { INTEGER_CLOSED, .. } := D.mt.ra.ts.cn.ms.ig.qfloor
  let { CLOSED_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { AND_FORALL_THM, CONTRAPOS_THM, EXTENSION, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_IN_IMAGE, IN_DELETE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIV, MONO_EXISTS, NOT_IN_EMPTY, REAL_ABS_NUM,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_INV_LE_1, REAL_LE_INV2, REAL_LE_MUL2, REAL_LE_RMUL, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_MIN, REAL_LT_MUL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_RID, REAL_NOT_LE, REAL_POW_2, REAL_POW_INV, REAL_POW_LT,
        REAL_SUB_0, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_div, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { REAL_HALF, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { DIST_REFL, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CLOSED_CBALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { CONTINUOUS_ON_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_CBALL, OPEN_CONTAINS_BALL, OPEN_CONTAINS_CBALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { closed, continuous_at, OPEN_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { CONNECTED_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.qconvex
  let { CONTINUOUS_ON_EQ_CONTINUOUS_AT, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology1
  let { open_def, .. } := D.mt.ra.ts.cn.ms.ig.dv.qtopology2
  let { path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { OPEN_DIFF, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let lastc : thm → ExceptT String IO thm := fun th =>
    liftExcept (HolCore.Lib.last (CONJUNCTS th))

  let CONTINUOUS_AT_WINDING_NUMBER ← prove
   r"!g z. path g /\ ~(z IN path_image g)
         ==> (\w. winding_number(g,w)) continuous (at z)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:complex) DIFF path_image g") OPEN_CONTAINS_CBALL) THEN
    ASM_SIMP_TAC [← GSYM closed, CLOSED_PATH_IMAGE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, SUBSET, IN_CBALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"(:complex) DIFF cball(z,e / &2)", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_NEARBY_ENDS) THEN
    ASM_SIMP_TAC [OPEN_DIFF, OPEN_UNIV, CLOSED_CBALL] THEN ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, IN_DIFF, IN_CBALL, SUBSET, IN_UNIV] THEN
      GEN_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [] THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"min d e / &2"]
      WINDING_NUMBER) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_LT_MIN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC CONTINUOUS_TRANSFORM_AT THEN
    MAP_EVERY EXISTS_TAC [← q r"\w. winding_number(p,w)", ← q r"min d e / &2"] THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_LT_MIN] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      MATCH_MP_TAC WINDING_NUMBER_UNIQUE THEN
      ASM_SIMP_TAC [VALID_PATH_IMP_PATH] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [REWRITE_TAC [path_image, IN_IMAGE] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:real^1->complex) t")) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^1")) THEN
        ASM_SIMP_TAC [path_image, FUN_IN_IMAGE] THEN
        UNDISCH_TAC (← q r"dist (w:complex,z) < min d e / &2") THEN
        ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t),
        DISCH_TAC THEN X_GEN_TAC (← q r"k:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"w:complex",
                       ← q r"min k (min d e) / &2"]
           WINDING_NUMBER) THEN
        ASM_REWRITE_TAC [REAL_HALF, REAL_LT_MIN] THEN ANTS_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
          ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"p:real^1->complex") THEN ASM_REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
        FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        CONV_TAC SYM_CONV THEN FIRST_X_ASSUM (MP_TAC o SPECL
          [← q r"p:real^1->complex", ← q r"q:real^1->complex"]) THEN
        ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
         [X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real^1"))) THEN
          ASM_REWRITE_TAC [] THEN CONV_TAC (fun t => NORM_ARITH t),
          DISCH_THEN (MATCH_MP_TAC o lastc)] THEN
        MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
        SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST,
                 IN_DELETE, IN_UNIV, COMPLEX_SUB_0] THEN
        ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN SIMP_TAC [IN_DIFF] THEN
        REWRITE_TAC [IN_UNIV, IN_CBALL] THEN
        ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC],
      UNDISCH_TAC (← q r"~((z:complex) IN path_image p)") THEN
      UNDISCH_TAC (← q r"valid_path(p:real^1->complex)") THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN SPEC_TAC (← q r"z:complex", ← q r"z:complex") THEN
      SPEC_TAC (← q r"p:real^1->complex", ← q r"g:real^1->complex")] THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:complex) DIFF path_image g") OPEN_CONTAINS_BALL) THEN
    ASM_SIMP_TAC [← GSYM closed, CLOSED_PATH_IMAGE, VALID_PATH_IMP_PATH] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, SUBSET, IN_BALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"(:complex) DIFF cball(z, &3 / &4 * d)", ← q r"g:real^1->complex"]
          PATH_INTEGRAL_BOUND_EXISTS) THEN
    ASM_REWRITE_TAC [← GSYM closed, CLOSED_CBALL, SUBSET, IN_DIFF,
                    IN_CBALL, IN_UNIV, REAL_NOT_LE] THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [← REAL_ARITH (← q r"&0 < d /\ ~(&3 / &4 * d < x) ==> x < d")],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"L:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [continuous_at] THEN X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min (d / &4) (e / &2 * d pow 2 / L / &4)") THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_POW_LT, REAL_LT_DIV, REAL_LT_MUL, REAL_HALF,
                 ← REAL_ARITH (← q r"&0 < x / &4 <=> &0 < x")] THEN
    X_GEN_TAC (← q r"w:complex") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"~((w:complex) IN path_image g)") ASSUME_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ONCE_REWRITE_TAC [DIST_SYM] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [dist, WINDING_NUMBER_VALID_PATH, ← GSYM COMPLEX_SUB_LDISTRIB] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL, COMPLEX_NORM_DIV, COMPLEX_NORM_CX] THEN
    REWRITE_TAC [REAL_ABS_NUM, COMPLEX_NORM_II, REAL_ABS_PI] THEN
    REWRITE_TAC [real_div, REAL_MUL_LID, REAL_MUL_RID] THEN
    MATCH_MP_TAC (← REAL_ARITH
      (← q r"inv p * x <= &1 * x /\ x < e ==> inv p * x < e")) THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      MATCH_MP_TAC REAL_INV_LE_1 THEN MP_TAC PI_APPROX_32 THEN REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"!d. &0 < e /\ d = e / &2 /\ x <= d ==> x < e")) THEN
    EXISTS_TAC (← q r"L * (e / &2 * d pow 2 / L / &4) * inv(d / &2) pow 2") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MAP_EVERY UNDISCH_TAC [← q r"&0 < d", ← q r"&0 < L"] THEN CONV_TAC REAL_FIELD,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"path_integral g (\x. Cx(&1) / (x - w)) -
      path_integral g (\x. Cx(&1) / (x - z)) =
      path_integral g (\x. Cx(&1) / (x - w) - Cx(&1) / (x - z))")
    SUBST1_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC PATH_INTEGRAL_SUB THEN
      CONJ_TAC THEN MATCH_MP_TAC PATH_INTEGRABLE_INVERSEDIFF THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ONCE_REWRITE_TAC [DIST_SYM] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    SIMP_TAC [HOLOMORPHIC_ON_OPEN, ← GSYM closed, CLOSED_CBALL] THEN
    REWRITE_TAC [IN_UNIV, IN_DIFF, IN_CBALL, REAL_NOT_LE, AND_FORALL_THM] THEN
    X_GEN_TAC (← q r"x:complex") THEN
    REWRITE_TAC [← TAUT (← q r"(a ==> b) /\ (a ==> c) <=> a ==> b /\ c")] THEN
    DISCH_TAC THEN REWRITE_TAC [← GSYM complex_differentiable] THEN
    SUBGOAL_THEN (← q r"~(x:complex = w) /\ ~(x = z)") STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE])) THEN
      CONV_TAC (fun t => NORM_ARITH t),
      ALL_TAC] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_SUB THEN
      CONJ_TAC THEN MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_DIV_AT THEN
      ASM_SIMP_TAC [COMPLEX_SUB_0, COMPLEX_DIFFERENTIABLE_SUB,
                   COMPLEX_DIFFERENTIABLE_ID, COMPLEX_DIFFERENTIABLE_CONST],
      ALL_TAC] THEN
    ASM_SIMP_TAC [← ExceptT.mk (COMPLEX_FIELD
     (← q r"~(x = w) /\ ~(x = z)
      ==> Cx(&1) / (x - w) - Cx(&1) / (x - z) =
          (w - z) * inv((x - w) * (x - z))"))] THEN
    REWRITE_TAC [COMPLEX_NORM_MUL] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
    ASM_SIMP_TAC [NORM_POS_LE, ← GSYM dist, REAL_LT_IMP_LE] THEN
    REWRITE_TAC [COMPLEX_NORM_INV, REAL_POW_INV] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN
    ASM_SIMP_TAC [REAL_POW_2, REAL_LT_MUL, REAL_HALF, COMPLEX_NORM_MUL] THEN
    MATCH_MP_TAC REAL_LE_MUL2 THEN ASM_SIMP_TAC [REAL_HALF, REAL_LT_IMP_LE] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM REAL_NOT_LE])) THEN
    CONV_TAC (fun t => NORM_ARITH t))

  let CONTINUOUS_ON_WINDING_NUMBER ← prove
   r"!g. path g
       ==> (\w. winding_number(g,w)) continuous_on
           ((:complex) DIFF path_image g)"
   (SIMP_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_AT, ← GSYM closed,
             OPEN_UNIV, CLOSED_PATH_IMAGE, VALID_PATH_IMP_PATH] THEN
    SIMP_TAC [IN_DIFF, IN_UNIV, CONTINUOUS_AT_WINDING_NUMBER])

  let WINDING_NUMBER_CONSTANT ← prove
   r"!s g. path g /\ pathfinish g = pathstart g /\
         connected s /\ s INTER path_image g = {}
         ==> ?k. !z. z IN s ==> winding_number(g,z) = k"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_DISCRETE_RANGE_CONSTANT THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_ON_SUBSET THEN
      EXISTS_TAC (← q r"(:complex) DIFF path_image g") THEN
      ASM_SIMP_TAC [CONTINUOUS_ON_WINDING_NUMBER] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"z:complex") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN
     (← q r"complex_integer(winding_number(g,w)) /\
      complex_integer(winding_number(g,z))")
    MP_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC INTEGER_WINDING_NUMBER THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      REWRITE_TAC [COMPLEX_INTEGER] THEN STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [← GSYM CX_SUB, CX_INJ, COMPLEX_NORM_CX] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_ABS_INTEGER_LEMMA THEN
    ASM_SIMP_TAC [REAL_SUB_0, INTEGER_CLOSED])

  let WINDING_NUMBER_EQ ← prove
   r"!g s w z.
        path g /\ pathfinish g = pathstart g /\
        w IN s /\ z IN s /\ connected s /\ s INTER path_image g = {}
        ==> winding_number(g,w) = winding_number(g,z)"
   (MESON_TAC [WINDING_NUMBER_CONSTANT])

  let OPEN_WINDING_NUMBER_LEVELSETS ← prove
   r"!g k. path g /\ pathfinish g = pathstart g
         ==> open {z | ~(z IN path_image g) /\ winding_number(g,z) = k}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [open_def, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"z:complex") THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"(:complex) DIFF path_image g") OPEN_CONTAINS_BALL) THEN
    ASM_SIMP_TAC [← GSYM closed, CLOSED_PATH_IMAGE, VALID_PATH_IMP_PATH] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
    ASM_REWRITE_TAC [IN_DIFF, IN_UNIV, SUBSET, IN_BALL] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"e:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"w:complex") THEN
    REPEAT STRIP_TAC THENL [ASM_MESON_TAC [DIST_SYM], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"ball(z:complex,e)", ← q r"g:real^1->complex"]
          WINDING_NUMBER_CONSTANT) THEN
    ASM_SIMP_TAC [CONNECTED_BALL, EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_BALL] THEN
    ASM_MESON_TAC [DIST_REFL, DIST_SYM])

  pure { CONTINUOUS_AT_WINDING_NUMBER, CONTINUOUS_ON_WINDING_NUMBER,
         WINDING_NUMBER_CONSTANT, WINDING_NUMBER_EQ, OPEN_WINDING_NUMBER_LEVELSETS }
/- ------------------------------------------------------------------------- -/
/- Winding number is zero "outside" a curve, in various senses; if a path   -/
/- winds round a set, it winds rounds its inside.                            -/
/- (cauchy.ml 4859-4989)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYS where
  WINDING_NUMBER_ZERO_IN_OUTSIDE : thm
  WINDING_NUMBER_ZERO_OUTSIDE : thm
  WINDING_NUMBER_ZERO_ATINFINITY : thm
  WINDING_NUMBER_ZERO_POINT : thm
  WINDING_NUMBER_AROUND_INSIDE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYS [HolBase] (D : CauchyDeps) (BKYC : KYC) (BKYL : KYL) (BKYM : KYM) (BKYN : KYN) (BKYR : KYR) : ExceptT String IO KYS := do
  -- @@SCOPE BEGIN
  let { PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { CAUCHY_THEOREM_CONVEX_SIMPLE, .. } := BKYL
  let { VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { WINDING_NUMBER_UNIQUE, .. } := BKYN
  let { WINDING_NUMBER_CONSTANT, WINDING_NUMBER_EQ, .. } := BKYR
  let { CONNECTED_OUTSIDE, CONNECTED_WITH_INSIDE, INSIDE_INSIDE_COMPACT_CONNECTED,
        OUTSIDE_COMPACT_IN_OPEN, OUTSIDE_SUBSET_CONVEX, .. } := D.qpaths
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { INSIDE_NO_OVERLAP, INSIDE_OUTSIDE, OUTSIDE_NO_OVERLAP, .. } := D.mt.qpaths
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { COMPLEX_MUL_RZERO, COMPLEX_SUB_0, COMPLEX_SUB_LZERO, .. } := D.mt.ra.ts.cn.cxb
  let { ASM_MESON_TAC, MESON_TAC, NORM_ARITH, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONTRAPOS_THM, DIMINDEX_2, EQ_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INTER, IN_UNION, IN_UNIV, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_MIN, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { SUBSET, SUBSET_EMPTY, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { NORM_NEG, NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { BOUNDED_BALL, BOUNDED_SUBSET_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { IN_BALL, IN_CBALL, NOT_BOUNDED_UNIV, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { bounded, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { BOUNDED_PATH_IMAGE, COMPACT_PATH_IMAGE, CONNECTED_PATH_IMAGE,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path_image, PATH_IMAGE_NONEMPTY, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { SUBSET_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qtop
  let { CONVEX_BALL, CONVEX_CBALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let WINDING_NUMBER_ZERO_IN_OUTSIDE ← prove
   r"!g z. path g /\ pathfinish g = pathstart g /\ z IN outside(path_image g)
         ==> winding_number(g,z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"path_image(g:real^1->complex)", ← q r"Cx(&0)"]
     BOUNDED_SUBSET_BALL) THEN ASM_SIMP_TAC [BOUNDED_PATH_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"?w. ~(w IN ball(Cx(&0),B + &1))") STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← SET_RULE (← q r"~(s = UNIV) ==> ?z. ~(z IN s)")) THEN
      MESON_TAC [BOUNDED_BALL, NOT_BOUNDED_UNIV],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"Cx(&0)", ← q r"B:real", ← q r"B + &1"] SUBSET_BALL) THEN
    REWRITE_TAC [← REAL_ARITH (← q r"B <= B + &1")] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"path_image(g:real^1->complex)", ← q r"ball(Cx(&0),B + &1)"]
          OUTSIDE_SUBSET_CONVEX) THEN
    ASM_REWRITE_TAC [CONVEX_BALL] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_UNIV, IN_DIFF] THEN DISCH_TAC THEN
    MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC (← q r"winding_number(g,w)") THEN
    CONJ_TAC THENL
     [MP_TAC (← ISPECL [← q r"outside(path_image(g:real^1->complex))",
                     ← q r"g:real^1->complex"] WINDING_NUMBER_CONSTANT) THEN
      ASM_SIMP_TAC [OUTSIDE_NO_OVERLAP, CONNECTED_OUTSIDE,
                   DIMINDEX_2, LE_REFL, BOUNDED_PATH_IMAGE] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC WINDING_NUMBER_UNIQUE THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← TAUT (← q r"a /\ (a ==> b) ==> a /\ b")) THEN CONJ_TAC THENL
       [ASM SET_TAC [], DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC] THEN
      MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"min e (&1)"]
          PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
      ASM_REWRITE_TAC [REAL_LT_MIN, REAL_LT_01] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:real^1->complex") THEN
      STRIP_TAC THEN ONCE_REWRITE_TAC [NORM_SUB] THEN
      ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN CONJ_TAC THENL
       [UNDISCH_TAC (← q r"~(w IN ball (Cx(&0),B + &1))") THEN
        REWRITE_TAC [CONTRAPOS_THM, path_image, IN_BALL] THEN
        SPEC_TAC (← q r"w:complex", ← q r"x:complex") THEN REWRITE_TAC [FORALL_IN_IMAGE],
        REWRITE_TAC [COMPLEX_MUL_RZERO] THEN
        MATCH_MP_TAC PATH_INTEGRAL_UNIQUE THEN
        MATCH_MP_TAC CAUCHY_THEOREM_CONVEX_SIMPLE THEN
        EXISTS_TAC (← q r"ball(Cx(&0),B + &1)") THEN
        ASM_SIMP_TAC [CONVEX_BALL, VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
          SIMP_TAC [HOLOMORPHIC_ON_SUB, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_CONST,
                   COMPLEX_SUB_0] THEN
          ASM_MESON_TAC [],
          REWRITE_TAC [path_image, SUBSET, FORALL_IN_IMAGE, IN_BALL]]] THEN
        X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
        REWRITE_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
        MATCH_MP_TAC (← NORM_ARITH
         (← q r"!g:real^1->complex. norm(p t - g t) < &1 /\ norm(g t) <= B
                              ==> norm(p t) < B + &1")) THEN
        EXISTS_TAC (← q r"g:real^1->complex") THEN
        UNDISCH_TAC (← q r"path_image g SUBSET ball (Cx(&0),B)") THEN
        ASM_SIMP_TAC [SUBSET, IN_BALL, path_image, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [dist, COMPLEX_SUB_LZERO, NORM_NEG, REAL_LT_IMP_LE]])

  let WINDING_NUMBER_ZERO_OUTSIDE ← prove
   r"!g s z. path g /\ convex s /\ pathfinish g = pathstart g /\
           ~(z IN s) /\ path_image g SUBSET s
           ==> winding_number(g,z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_ZERO_IN_OUTSIDE THEN
    ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"path_image(g:real^1->complex)", ← q r"s:complex->bool"]
          OUTSIDE_SUBSET_CONVEX) THEN
    ASM SET_TAC [])

  let WINDING_NUMBER_ZERO_ATINFINITY ← prove
   r"!g. path g /\ pathfinish g = pathstart g
       ==> ?B. !z. B <= norm(z) ==> winding_number(g,z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"bounded (path_image g :complex->bool)") MP_TAC THENL
     [ASM_SIMP_TAC [BOUNDED_PATH_IMAGE], ALL_TAC] THEN
    REWRITE_TAC [bounded] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
    EXISTS_TAC (← q r"B + &1") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC WINDING_NUMBER_ZERO_OUTSIDE THEN
    EXISTS_TAC (← q r"cball(Cx(&0),B)") THEN ASM_REWRITE_TAC [CONVEX_CBALL] THEN
    REWRITE_TAC [SUBSET, IN_CBALL, dist, COMPLEX_SUB_LZERO, NORM_NEG] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"~(B + &1 <= z /\ z <= B)")])

  let WINDING_NUMBER_ZERO_POINT ← prove
   r"!g s. path g /\ pathfinish g = pathstart g /\
         open s /\ path_image g SUBSET s
         ==> ?z. z IN s /\ winding_number(g,z) = Cx(&0)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"path_image g:complex->bool", ← q r"s:complex->bool"]
          OUTSIDE_COMPACT_IN_OPEN) THEN
    ASM_SIMP_TAC [COMPACT_PATH_IMAGE] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [SUBSET_EMPTY, PATH_IMAGE_NONEMPTY], ALL_TAC] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN REWRITE_TAC [IN_INTER] THEN
    ASM_SIMP_TAC [WINDING_NUMBER_ZERO_IN_OUTSIDE])

  /- If a path winds round a set, it winds rounds its inside. -/

  let WINDING_NUMBER_AROUND_INSIDE ← prove
   r"!g s z.
        path g /\ pathfinish g = pathstart g /\
        closed s /\ connected s /\ s INTER path_image g = {} /\
        z IN s /\ ~(winding_number(g,z) = Cx(&0))
        ==> !w. w IN s UNION inside(s)
                ==> winding_number(g,w) = winding_number(g,z)"
   (MAP_EVERY X_GEN_TAC
     [← q r"g:real^1->complex", ← q r"s:complex->bool", ← q r"z0:complex"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"!z. z IN s ==> winding_number(g,z) = winding_number(g,z0)")
    ASSUME_TAC THENL [ASM_MESON_TAC [WINDING_NUMBER_EQ], ALL_TAC] THEN
    ABBREV_TAC (← q r"k = winding_number (g,z0)") THEN
    SUBGOAL_THEN (← q r"(s:complex->bool) SUBSET inside(path_image g)") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, INSIDE_OUTSIDE, IN_DIFF, IN_UNIV, IN_UNION] THEN
      X_GEN_TAC (← q r"z:complex") THEN REPEAT STRIP_TAC THENL
       [ASM SET_TAC [], ASM_MESON_TAC [WINDING_NUMBER_ZERO_IN_OUTSIDE]],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"z:complex") THEN REWRITE_TAC [IN_UNION] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    MP_TAC (← ISPECL [← q r"s:complex->bool",
                   ← q r"path_image g:complex->bool"]
          INSIDE_INSIDE_COMPACT_CONNECTED) THEN
    ASM_SIMP_TAC [COMPACT_PATH_IMAGE, CONNECTED_PATH_IMAGE] THEN STRIP_TAC THEN
    EXPAND_TAC "k" THEN MATCH_MP_TAC WINDING_NUMBER_EQ THEN
    EXISTS_TAC (← q r"s UNION inside s :complex->bool") THEN
    ASM_SIMP_TAC [CONNECTED_WITH_INSIDE, IN_UNION] THEN
    MP_TAC (← ISPEC (← q r"path_image g :complex->bool") INSIDE_NO_OVERLAP) THEN
    ASM SET_TAC [])

  pure { WINDING_NUMBER_ZERO_IN_OUTSIDE, WINDING_NUMBER_ZERO_OUTSIDE,
         WINDING_NUMBER_ZERO_ATINFINITY, WINDING_NUMBER_ZERO_POINT,
         WINDING_NUMBER_AROUND_INSIDE }
/- ------------------------------------------------------------------------- -/
/- Bounding a WN by 1/2 for a path and point in opposite halfspaces.         -/
/- (cauchy.ml 4990-5174)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYT where
  WINDING_NUMBER_SUBPATH_CONTINUOUS : thm
  WINDING_NUMBER_IVT_POS : thm
  WINDING_NUMBER_IVT_NEG : thm
  WINDING_NUMBER_IVT_ABS : thm
  WINDING_NUMBER_LT_HALF : thm
  WINDING_NUMBER_LE_HALF : thm
  WINDING_NUMBER_LT_HALF_LINEPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYT [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYC : KYC) (BKYE : KYE) (BKYF : KYF) (BKYN : KYN) (BKYP : KYP) (BKYR : KYR) : ExceptT String IO KYT := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { PATH_INTEGRABLE_ON, VALID_PATH_REVERSEPATH, .. } := BKYC
  let { VALID_PATH_LINEPATH, .. } := BKYE
  let { PATH_INTEGRAL_SUBPATH_INTEGRAL, VALID_PATH_SUBPATH, .. } := BKYF
  let { PATH_INTEGRABLE_INVERSEDIFF, WINDING_NUMBER_REVERSEPATH, WINDING_NUMBER_TRIVIAL,
        WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { WINDING_NUMBER_AHLFORS_FULL, .. } := BKYP
  let { CONTINUOUS_AT_WINDING_NUMBER, .. } := BKYR
  let { SUBPATH_REFL, .. } := D.qpaths
  let { CLOSED_SEGMENT, .. } := D.mt.qconvex
  let { REAL_EXP_POS_LT, .. } := D.mt.ra.tsb
  let { EULER, .. } := D.mt.ra.tsc
  let { COS_PI, SIN_PI, .. } := D.mt.ra.tse
  let { CONTINUOUS_ON_COMPLEX_LMUL, .. } := D.mt.ra.ts.knc
  let { RE_DEF, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_ADD_RID, COMPLEX_MUL_ASSOC, COMPLEX_MUL_RZERO, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, CX_MUL, IM_MUL_CX, IM_MUL_II, RE_CX, RE_MUL_CX, RE_MUL_II, RE_NEG,
        RE_SUB, .. } := D.mt.ra.ts.cn.cxc
  let { CONVEX_SEGMENT, IVT_DECREASING_COMPONENT_ON_1, IVT_INCREASING_COMPONENT_ON_1,
        .. } := D.mt.ra.ts.cn.ms.qconvex
  let { INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT, .. } := D.mt.ra.ts.cn.ms.qintegration2
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, NORM_ARITH, REAL_ARITH, REAL_ARITH_TAC,
        REAL_FIELD, REAL_RAT_REDUCE_CONV, SET_RULE, .. } := D.mt.ra.ts.cn.cx.cvx
  let { PATH_IMAGE_SUBPATH_SUBSET, PATHFINISH_SUBPATH, PATHSTART_SUBPATH, SUBPATH_TRIVIAL,
        .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { ARITH, DIMINDEX_2, EQ_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FUN_IN_IMAGE, IMP_CONJ, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, MONO_EXISTS, NOT_EXISTS_THM, NOT_IMP, REAL_ABS_DIV, REAL_DIV_RMUL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_RMUL, REAL_LET_TRANS, REAL_LT_IMP_LE, REAL_LT_MUL, REAL_LT_MUL_EQ,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_RID, REAL_MUL_RNEG, REAL_NOT_LE, REAL_NOT_LT, REAL_POS, REAL_SUB_LT,
        SUBSET, SUBSET_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { real_abs, real_gt, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { COMPONENT_LE_NORM, DOT_RMUL, DOT_RSUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { DROP_VEC, NORM_EQ_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_MUL, NORM_POS_LE, NORM_POS_LT, NORM_POW_2, REAL_ABS_NORM,
        .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { CONTINUOUS_ON_EQ, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_INTERVAL_1, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { continuous_at, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_image, PATH_IMAGE_LINEPATH, PATH_IMAGE_REVERSEPATH, pathstart,
        PATHSTART_IN_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { ENDS_IN_UNIT_INTERVAL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qvec
  let { SEPARATING_HYPERPLANE_CLOSED_POINT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let WINDING_NUMBER_SUBPATH_CONTINUOUS ← prove
   r"!g z. valid_path g /\ ~(z IN path_image g)
         ==> (\a. winding_number(subpath (vec 0) a g,z)) continuous_on
             interval[vec 0,vec 1]"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_ON_EQ THEN EXISTS_TAC
      (← q r"\a. Cx(&1) / (Cx(&2) * Cx pi * ii) *
           integral (interval[vec 0,a])
                    (\t. Cx(&1) / (g t - z) * vector_derivative g (at t))") THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"a:real^1") THEN DISCH_TAC THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC EQ_TRANS THEN EXISTS_TAC
       (← q r"Cx(&1) / (Cx(&2) * Cx pi * ii) *
        path_integral (subpath (vec 0) a g) (\w. Cx(&1) / (w - z))") THEN
      CONJ_TAC THENL
       [AP_TERM_TAC THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC PATH_INTEGRAL_SUBPATH_INTEGRAL THEN
        ASM_SIMP_TAC [ENDS_IN_UNIT_INTERVAL, PATH_INTEGRABLE_INVERSEDIFF] THEN
        ASM_MESON_TAC [IN_INTERVAL_1],
        REPEAT STRIP_TAC THEN REWRITE_TAC [] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC WINDING_NUMBER_VALID_PATH THEN
        ASM_MESON_TAC [VALID_PATH_SUBPATH, SUBSET, VALID_PATH_IMP_PATH,
                   ENDS_IN_UNIT_INTERVAL, PATH_IMAGE_SUBPATH_SUBSET]],
      MATCH_MP_TAC CONTINUOUS_ON_COMPLEX_LMUL THEN
      MATCH_MP_TAC INDEFINITE_INTEGRAL_CONTINUOUS_RIGHT THEN
      REWRITE_TAC [← GSYM PATH_INTEGRABLE_ON] THEN
      ASM_SIMP_TAC [PATH_INTEGRABLE_INVERSEDIFF]])

  let WINDING_NUMBER_IVT_POS ← prove
   r"!g z w.
        valid_path g /\ ~(z IN path_image g) /\
        &0 <= w /\ w <= Re(winding_number(g,z))
        ==> ?t. t IN interval[vec 0,vec 1] /\
                Re(winding_number(subpath (vec 0) t g,z)) = w"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RE_DEF] THEN
    MATCH_MP_TAC IVT_INCREASING_COMPONENT_ON_1 THEN
    ASM_SIMP_TAC [WINDING_NUMBER_SUBPATH_CONTINUOUS] THEN
    ASM_REWRITE_TAC [SUBPATH_TRIVIAL, ← GSYM RE_DEF, DIMINDEX_2, ARITH] THEN
    REWRITE_TAC [DROP_VEC, REAL_POS, SUBPATH_REFL] THEN
    MP_TAC (← ISPECL [← q r"(g:real^1->complex) (vec 0)", ← q r"z:complex"]
          WINDING_NUMBER_TRIVIAL) THEN
    ASM_MESON_TAC [pathstart, PATHSTART_IN_PATH_IMAGE, RE_CX])

  let WINDING_NUMBER_IVT_NEG ← prove
   r"!g z w.
        valid_path g /\ ~(z IN path_image g) /\
        Re(winding_number(g,z)) <= w /\ w <= &0
        ==> ?t. t IN interval[vec 0,vec 1] /\
                Re(winding_number(subpath (vec 0) t g,z)) = w"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [RE_DEF] THEN
    MATCH_MP_TAC IVT_DECREASING_COMPONENT_ON_1 THEN
    ASM_SIMP_TAC [WINDING_NUMBER_SUBPATH_CONTINUOUS] THEN
    ASM_REWRITE_TAC [SUBPATH_TRIVIAL, ← GSYM RE_DEF, DIMINDEX_2, ARITH] THEN
    REWRITE_TAC [DROP_VEC, REAL_POS, SUBPATH_REFL] THEN
    MP_TAC (← ISPECL [← q r"(g:real^1->complex) (vec 0)", ← q r"z:complex"]
          WINDING_NUMBER_TRIVIAL) THEN
    ASM_MESON_TAC [pathstart, PATHSTART_IN_PATH_IMAGE, RE_CX])

  let WINDING_NUMBER_IVT_ABS ← prove
   r"!g z w.
        valid_path g /\ ~(z IN path_image g) /\
        &0 <= w /\ w <= abs(Re(winding_number(g,z)))
        ==> ?t. t IN interval[vec 0,vec 1] /\
                abs(Re(winding_number(subpath (vec 0) t g,z))) = w"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 <= Re(winding_number(g,z))") THEN
    ASM_REWRITE_TAC [real_abs] THEN REWRITE_TAC [← GSYM real_abs] THEN
    REPEAT STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"w:real"]
          WINDING_NUMBER_IVT_POS),
      MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"--w:real"]
          WINDING_NUMBER_IVT_NEG)] THEN
    (ANTS_TAC THENL [ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [] THEN ASM_REAL_ARITH_TAC)

  let WINDING_NUMBER_LT_HALF ← (do
    let lemma ← prove
     r"!g z a b.
          valid_path g /\ ~(z IN path_image g) /\
          a dot z <= b /\ path_image g SUBSET {w | a dot w > b}
          ==> Re(winding_number(g,z)) < &1 / &2"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LE] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"&1 / &2"]
        WINDING_NUMBER_IVT_POS) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"subpath (vec 0) t (g:real^1->complex)", ← q r"z:complex"]
            WINDING_NUMBER_AHLFORS_FULL) THEN
      ASM_SIMP_TAC [VALID_PATH_SUBPATH, VALID_PATH_IMP_PATH,
                   ENDS_IN_UNIT_INTERVAL, NOT_IMP] THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
         (← q r"~(z IN t) ==> s SUBSET t ==> ~(z IN s)"))) THEN
        ASM_SIMP_TAC [PATH_IMAGE_SUBPATH_SUBSET, ENDS_IN_UNIT_INTERVAL,
                     VALID_PATH_IMP_PATH],
        ASM_REWRITE_TAC [EULER, RE_MUL_CX, RE_MUL_II, IM_MUL_CX, IM_MUL_II] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"&2 * pi * &1 / &2 = pi"), SIN_PI, COS_PI] THEN
        REWRITE_TAC [COMPLEX_MUL_RZERO, COMPLEX_ADD_RID] THEN
        REWRITE_TAC [PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
        REWRITE_TAC [COMPLEX_MUL_ASSOC, ← GSYM CX_MUL] THEN
        REWRITE_TAC [REAL_MUL_RNEG, REAL_MUL_RID, ← GSYM COMPLEX_CMUL] THEN
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"&0 < a dot ((g:real^1->complex) t - z) /\
                      &0 < a dot (g(vec 0) - z)")
        MP_TAC THENL
         [REWRITE_TAC [DOT_RSUB, REAL_SUB_LT] THEN CONJ_TAC THEN
          MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"b:real") THEN
          ASM_REWRITE_TAC [← GSYM real_gt] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE
           (← q r"g SUBSET {z | a dot z > b} ==> t IN g ==> a dot t > b"))) THEN
          REWRITE_TAC [path_image] THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
          ASM_REWRITE_TAC [ENDS_IN_UNIT_INTERVAL],
          ASM_REWRITE_TAC [DOT_RMUL] THEN
          DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
          ASM_SIMP_TAC [REAL_LT_MUL_EQ] THEN
          MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(&0 < -- x)")) THEN
          REWRITE_TAC [REAL_EXP_POS_LT]]])
    prove
     r"!g z a b.
        valid_path g /\ a dot z <= b /\ path_image g SUBSET {w | a dot w > b}
        ==> abs(Re(winding_number(g,z))) < &1 / &2"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:complex")) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, ← REAL_ARITH (← q r"a:real > b <=> ~(a <= b)")] THEN
      DISCH_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"x < a /\ --x < a ==> abs x < a")) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [lemma], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"reversepath g:real^1->complex", ← q r"z:complex",
                     ← q r"a:complex", ← q r"b:real"] lemma) THEN
      ASM_SIMP_TAC [VALID_PATH_REVERSEPATH, PATH_IMAGE_REVERSEPATH,
                   WINDING_NUMBER_REVERSEPATH, VALID_PATH_IMP_PATH, RE_NEG] THEN
      REAL_ARITH_TAC))

  let WINDING_NUMBER_LE_HALF ← prove
   r"!g z a b.
        valid_path g /\ ~(z IN path_image g) /\
        ~(a = vec 0) /\ a dot z <= b /\ path_image g SUBSET {w | a dot w >= b}
        ==> abs(Re(winding_number(g,z))) <= &1 / &2"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex"]
     CONTINUOUS_AT_WINDING_NUMBER) THEN
    ASM_SIMP_TAC [VALID_PATH_IMP_PATH, continuous_at] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"abs(Re(winding_number(g,z))) - &1 / &2")) THEN
    ASM_REWRITE_TAC [REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z - d / &2 / norm(a) % a:complex")) THEN
    REWRITE_TAC [← NORM_ARITH (← q r"dist(z - d:complex,z) = norm d")] THEN
    ASM_SIMP_TAC [NORM_MUL, REAL_ABS_DIV, REAL_ABS_NORM, REAL_DIV_RMUL,
                 NORM_EQ_0, NOT_IMP] THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← NORM_ARITH
      (← q r"abs(Re w' - Re w) <= norm(w' - w) /\ abs(Re w') < &1 / &2
       ==> ~(dist(w',w) < abs(Re w) - &1 / &2)")) THEN
    REWRITE_TAC [← GSYM RE_SUB] THEN CONJ_TAC THENL
     [SIMP_TAC [COMPONENT_LE_NORM, RE_DEF, DIMINDEX_2, ARITH], ALL_TAC] THEN
    MATCH_MP_TAC WINDING_NUMBER_LT_HALF THEN EXISTS_TAC (← q r"a:complex") THEN
    EXISTS_TAC (← q r"b - d / &3 * norm(a:complex)") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [DOT_RSUB, DOT_RMUL, ← GSYM NORM_POW_2] THEN
      ASM_SIMP_TAC [NORM_EQ_0, ← REAL_FIELD
       (← q r"~(a = &0) ==> x / a * a pow 2 = x * a")] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH
       (← q r"a:real <= b ==> d <= e ==> a - e <= b - d"))) THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [NORM_POS_LE] THEN
      ASM_REAL_ARITH_TAC,
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          SUBSET_TRANS)) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MATCH_MP_TAC (← REAL_ARITH
       (← q r"&0 < e ==> !x. a dot x >= b ==> a dot x > b - e")) THEN
      MATCH_MP_TAC REAL_LT_MUL THEN ASM_SIMP_TAC [NORM_POS_LT] THEN
      ASM_REAL_ARITH_TAC])

  let WINDING_NUMBER_LT_HALF_LINEPATH ← prove
   r"!a b z.
        ~(z IN segment[a,b])
        ==> abs(Re(winding_number(linepath(a,b),z))) < &1 / &2"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_LT_HALF THEN
    MP_TAC (← ISPECL [← q r"segment[a:complex,b]", ← q r"z:complex"]
          SEPARATING_HYPERPLANE_CLOSED_POINT) THEN
    ASM_REWRITE_TAC [CONVEX_SEGMENT, CLOSED_SEGMENT] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    SIMP_TAC [VALID_PATH_LINEPATH, PATH_IMAGE_LINEPATH, SUBSET, IN_ELIM_THM,
             REAL_LT_IMP_LE])

  pure { WINDING_NUMBER_SUBPATH_CONTINUOUS, WINDING_NUMBER_IVT_POS,
         WINDING_NUMBER_IVT_NEG, WINDING_NUMBER_IVT_ABS, WINDING_NUMBER_LT_HALF,
         WINDING_NUMBER_LE_HALF, WINDING_NUMBER_LT_HALF_LINEPATH }
/- ------------------------------------------------------------------------- -/
/- Positivity of WN for a linepath; winding number for a triangle.           -/
/- (cauchy.ml 5175-5332)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYU where
  WINDING_NUMBER_LINEPATH_POS_LT : thm
  WINDING_NUMBER_TRIANGLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYU [HolBase] (D : CauchyDeps) (BKYE : KYE) (BKYF : KYF) (BKYN : KYN) (BKYO : KYO) (BKYQ : KYQ) (BKYT : KYT) : ExceptT String IO KYU := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_LINEPATH, VECTOR_DERIVATIVE_LINEPATH_AT, .. } := BKYE
  let { NOT_IN_INTERIOR_CONVEX_HULL_3, .. } := BKYF
  let { WINDING_NUMBER_JOIN, WINDING_NUMBER_JOIN_POS_COMBINED, WINDING_NUMBER_REVERSEPATH,
        .. } := BKYN
  let { WINDING_NUMBER_POS_LT, .. } := BKYO
  let { WINDING_NUMBER_EQ_1, .. } := BKYQ
  let { WINDING_NUMBER_LT_HALF_LINEPATH, .. } := BKYT
  let { REAL_NEG_RMUL, .. } := D.qsession
  let { REVERSEPATH_LINEPATH, .. } := D.qpaths
  let { INTERIOR_OF_TRIANGLE, .. } := D.qpolytope
  let { CONVEX_HALFSPACE_IM_LE, .. } := D.mt.ra.ts.kna
  let { complex_mul, IM, IM_DEF, RE, .. } := D.mt.ra.ts.cn.cxa
  let { COMPLEX_NEG_ADD, COMPLEX_SUB_LDISTRIB, COMPLEX_SUB_RDISTRIB,
        .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_CMUL, COMPLEX_NORM_CX, COMPLEX_VEC_0, CX_MUL, CX_POW, IM_ADD, IM_CMUL,
        IM_CX, IM_DIV_CX, IM_SUB, RE_ADD, RE_CMUL, RE_SUB, .. } := D.mt.ra.ts.cn.cxc
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_INV_DIV, .. } := D.mt.ra.ts.cn.cxe
  let { cnj, CNJ_CX, CNJ_MUL, CNJ_SUB, COMPLEX_MUL_CNJ, IM_COMPLEX_DIV_GT_0,
        IM_COMPLEX_DIV_LT_0, IM_COMPLEX_INV_GE_0, IM_COMPLEX_INV_GT_0, IM_COMPLEX_INV_LT_0,
        .. } := D.mt.ra.ts.cn.cxg
  let { COMPLEX_BASIS, .. } := D.mt.ra.ts.cn.cxh
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, GEOM_BASIS_MULTIPLE_TAC, GEOM_ORIGIN_TAC,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, VECTOR_ARITH, .. } := D.mt.ra.ts.cn.cx.cvx
  let { linepath, .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { CONJ_ASSOC, CONTRAPOS_THM, DE_MORGAN_THM, EMPTY_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IN_DIFF, INSERT_AC, INSERT_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, IN_UNION, REAL_ABS_NUM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_ADD2, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_LT, REAL_LE_REFL,
        REAL_LE_SUB_LADD, REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LZERO, REAL_MUL_RID, REAL_NEG_ADD, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { HULL_MINIMAL, .. } := D.mt.ra.ts.cn.cx.cvx.misc
  let { INTERVAL_OPEN_SUBSET_CLOSED, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { VEC_COMPONENT, VECTOR_SUB_RZERO, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { INTERIOR_HALFSPACE_COMPONENT_LE, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { SEGMENT_SYM, SUBSET_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { path_image, PATH_IMAGE_JOIN, PATH_IMAGE_LINEPATH, PATH_JOIN, PATH_LINEPATH,
        PATHFINISH_JOIN, PATHFINISH_LINEPATH, PATHSTART_JOIN, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { CONVEX_ALT, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  let { SEGMENT_CONVEX_HULL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx3
  -- @@SCOPE END

  let WINDING_NUMBER_LINEPATH_POS_LT ← prove
   r"!a b z. &0 < Im((b - a) * cnj(b - z))
           ==> &0 < Re(winding_number(linepath(a,b),z))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC WINDING_NUMBER_POS_LT THEN
    EXISTS_TAC (← q r"Im((b - a) * cnj(b - z))") THEN
    ASM_REWRITE_TAC [VALID_PATH_LINEPATH, VECTOR_DERIVATIVE_LINEPATH_AT] THEN
    CONJ_TAC THENL
     [POP_ASSUM MP_TAC THEN ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
      SPEC_TAC (← q r"z:complex", ← q r"z:complex") THEN
      REWRITE_TAC [path_image, FORALL_IN_IMAGE, linepath] THEN
      REWRITE_TAC [← VECTOR_ARITH
       (← q r"b - ((&1 - x) % a + x % b) = (&1 - x) % (b - a)")] THEN
      REWRITE_TAC [COMPLEX_CMUL, CNJ_MUL, CNJ_CX] THEN
      REWRITE_TAC [← ExceptT.mk (COMPLEX_RING (← q r"a * Cx x * cnj a = Cx x * a * cnj a"))] THEN
      SIMP_TAC [COMPLEX_MUL_CNJ, ← GSYM CX_POW, ← GSYM CX_MUL, IM_CX, REAL_LT_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"segment[a,b] SUBSET
        {y | Im((b - a) * cnj(b - z)) <= Im((b - a) * cnj(y - z))}")
    MP_TAC THENL
     [REWRITE_TAC [SEGMENT_CONVEX_HULL] THEN MATCH_MP_TAC HULL_MINIMAL THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q r"{a,b} SUBSET {y | P y} <=> P a /\ P b")] THEN
        POP_ASSUM MP_TAC THEN
        REWRITE_TAC [cnj, complex_mul, RE, IM, RE_SUB, IM_SUB] THEN
        REAL_ARITH_TAC,
        ALL_TAC] THEN
      REWRITE_TAC [COMPLEX_SUB_LDISTRIB, IM_SUB, CNJ_SUB, REAL_LE_SUB_LADD] THEN
      REWRITE_TAC [CONVEX_ALT, cnj, complex_mul, RE, IM, RE_SUB, IM_SUB] THEN
      REWRITE_TAC [IN_ELIM_THM, IM_ADD, RE_ADD, IM_CMUL, RE_CMUL] THEN
      REWRITE_TAC [REAL_NEG_ADD, REAL_NEG_RMUL] THEN
      ONCE_REWRITE_TAC [← REAL_ARITH
       (← q r"e <= ab * ((&1 - u) * x + u * y) + ab' * ((&1 - u) * x' + u * y') <=>
        (&1 - u) * e + u * e <=
          (&1 - u) * (ab * x + ab' * x') + u * (ab * y + ab' * y')")] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_ADD2 THEN
      CONJ_TAC THEN MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REWRITE_TAC [] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [← GSYM PATH_IMAGE_LINEPATH] THEN
      REWRITE_TAC [SUBSET, path_image, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ASM_MESON_TAC [SUBSET, INTERVAL_OPEN_SUBSET_CLOSED]])

  /- Winding number for a triangle. -/

  let WINDING_NUMBER_TRIANGLE ← (do
    let lemma1 ← prove
     r"!a b c. vec 0 IN interior(convex hull {a,b,c})
             ==> ~(Im(a / b) <= &0 /\ &0 <= Im(b / c))"
     (REPEAT GEN_TAC THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN SIMP_TAC [] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o ONCE_DEPTH_CONV)
       [← GSYM COMPLEX_INV_DIV] THEN
      REWRITE_TAC [IM_COMPLEX_INV_GE_0] THEN
      GEOM_BASIS_MULTIPLE_TAC 1 (← q r"b:complex") THEN
      REWRITE_TAC [COMPLEX_CMUL, COMPLEX_BASIS, ← GSYM CX_MUL, REAL_MUL_RID] THEN
      X_GEN_TAC (← q r"x:real") THEN GEN_REWRITE_TAC LAND_CONV [REAL_LE_LT] THEN
      REWRITE_TAC [IM_DIV_CX] THEN ASM_CASES_TAC (← q r"x = &0") THEN
      ASM_REWRITE_TAC [NOT_IN_INTERIOR_CONVEX_HULL_3, COMPLEX_VEC_0] THEN
      DISCH_TAC THEN REPEAT GEN_TAC THEN
      ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_MUL_LZERO] THEN STRIP_TAC THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"!s. ~(x IN s) /\ t SUBSET s ==> ~(x IN t)")) THEN
      EXISTS_TAC (← q r"interior {z | Im z <= &0}") THEN CONJ_TAC THENL
       [REWRITE_TAC [IM_DEF, INTERIOR_HALFSPACE_COMPONENT_LE] THEN
        REWRITE_TAC [← GSYM COMPLEX_VEC_0, IN_ELIM_THM, VEC_COMPONENT] THEN
        REAL_ARITH_TAC,
        MATCH_MP_TAC SUBSET_INTERIOR THEN MATCH_MP_TAC HULL_MINIMAL THEN
        REWRITE_TAC [CONVEX_HALFSPACE_IM_LE] THEN
        ASM_REWRITE_TAC [INSERT_SUBSET, EMPTY_SUBSET, IN_ELIM_THM] THEN
        REWRITE_TAC [IM_CX, REAL_LE_REFL]])
    let lemma2 ← prove
     r"z IN interior(convex hull {a,b,c})
     ==>  &0 < Im((b - a) * cnj (b - z)) /\
          &0 < Im((c - b) * cnj (c - z)) /\
          &0 < Im((a - c) * cnj (a - z)) \/
          Im((b - a) * cnj (b - z)) < &0 /\
          &0 < Im((b - c) * cnj (b - z)) /\
          &0 < Im((a - b) * cnj (a - z)) /\
          &0 < Im((c - a) * cnj (c - z))"
     (GEOM_ORIGIN_TAC (← q r"z:complex") THEN
      REWRITE_TAC [VECTOR_SUB_RZERO, COMPLEX_SUB_RDISTRIB] THEN
      REWRITE_TAC [COMPLEX_MUL_CNJ, IM_SUB, ← GSYM CX_POW, IM_CX] THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&0 < &0 - x <=> x < &0"),
                  ← REAL_ARITH (← q r"&0 - x < &0 <=> &0 < x")] THEN
      REWRITE_TAC [← GSYM IM_COMPLEX_DIV_GT_0, ← GSYM IM_COMPLEX_DIV_LT_0] THEN
      REPEAT STRIP_TAC THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM COMPLEX_INV_DIV] THEN
      REWRITE_TAC [IM_COMPLEX_INV_LT_0, IM_COMPLEX_INV_GT_0] THEN
      GEN_REWRITE_TAC (RAND_CONV o LAND_CONV o LAND_CONV o RAND_CONV)
       [← GSYM COMPLEX_INV_DIV] THEN
      REWRITE_TAC [IM_COMPLEX_INV_LT_0] THEN
      MP_TAC (← ISPECL [← q r"a:complex", ← q r"b:complex", ← q r"c:complex"] lemma1) THEN
      MP_TAC (← ISPECL [← q r"b:complex", ← q r"c:complex", ← q r"a:complex"] lemma1) THEN
      MP_TAC (← ISPECL [← q r"c:complex", ← q r"a:complex", ← q r"b:complex"] lemma1) THEN
      POP_ASSUM MP_TAC THEN SIMP_TAC [INSERT_AC] THEN REAL_ARITH_TAC)
    let lemma3 ← prove
     r"!a b c z.
          z IN interior(convex hull {a,b,c}) /\
          &0 < Im((b - a) * cnj (b - z)) /\
          &0 < Im((c - b) * cnj (c - z)) /\
          &0 < Im((a - c) * cnj (a - z))
          ==> winding_number
               (linepath(a,b) ++ linepath(b,c) ++ linepath(c,a),z) = Cx(&1)"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC WINDING_NUMBER_EQ_1 THEN
      REWRITE_TAC [PATHSTART_JOIN, PATHFINISH_JOIN, CONJ_ASSOC,
                  PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [← GSYM CONJ_ASSOC] THEN
        REPEAT (MATCH_MP_TAC WINDING_NUMBER_JOIN_POS_COMBINED THEN
               REWRITE_TAC [PATHSTART_JOIN, PATHFINISH_JOIN,
                           PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
               CONJ_TAC) THEN
        ASM_SIMP_TAC [WINDING_NUMBER_LINEPATH_POS_LT, VALID_PATH_LINEPATH] THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [INTERIOR_OF_TRIANGLE, IN_DIFF, IN_UNION, DE_MORGAN_THM]) THEN
        ASM_REWRITE_TAC [PATH_IMAGE_LINEPATH],
        RULE_ASSUM_TAC (REWRITE_RULE
           [INTERIOR_OF_TRIANGLE, IN_DIFF, IN_UNION, DE_MORGAN_THM]) THEN
        ASM_SIMP_TAC [WINDING_NUMBER_JOIN, PATH_IMAGE_JOIN, PATH_JOIN, IN_UNION,
               PATH_LINEPATH, PATHSTART_JOIN, PATHFINISH_JOIN, RE_ADD,
               PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
        MATCH_MP_TAC (← REAL_ARITH
         (← q r"abs a < &1 / &2 /\ abs b < &1 / &2 /\ abs c < &1 / &2
          ==> a + b + c < &2")) THEN
        REPEAT CONJ_TAC THEN MATCH_MP_TAC WINDING_NUMBER_LT_HALF_LINEPATH THEN
        ASM_REWRITE_TAC []])
    prove
     r"!a b c z.
        z IN interior(convex hull {a,b,c})
        ==> winding_number(linepath(a,b) ++ linepath(b,c) ++ linepath(c,a),z) =
            if &0 < Im((b - a) * cnj (b - z)) then Cx(&1) else --Cx(&1)"
     (REPEAT STRIP_TAC THEN
      FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP lemma2) THEN
      ASM_SIMP_TAC [lemma3, COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
      SUBGOAL_THEN
       (← q r"winding_number
          (linepath(c,b) ++ linepath(b,a) ++ linepath(a,c),z) = Cx(&1)")
      MP_TAC THENL
       [MATCH_MP_TAC lemma3 THEN ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [INSERT_AC],
        COND_CASES_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN CONV_TAC SYM_CONV THEN
      REWRITE_TAC [COMPLEX_NORM_CX, REAL_ABS_NUM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [INTERIOR_OF_TRIANGLE, IN_DIFF, IN_UNION, DE_MORGAN_THM]) THEN
      FIRST_ASSUM (ASSUME_TAC o ONCE_REWRITE_RULE [SEGMENT_SYM] o CONJUNCT2) THEN
      ASM_SIMP_TAC [WINDING_NUMBER_JOIN, PATH_IMAGE_JOIN, PATH_JOIN, IN_UNION,
             PATH_LINEPATH, PATHSTART_JOIN, PATHFINISH_JOIN, RE_ADD,
             PATHSTART_LINEPATH, PATHFINISH_LINEPATH, PATH_IMAGE_LINEPATH] THEN
      ASM_SIMP_TAC [COMPLEX_NEG_ADD, ← GSYM WINDING_NUMBER_REVERSEPATH,
                  PATH_IMAGE_LINEPATH, PATH_LINEPATH, REVERSEPATH_LINEPATH] THEN
      CONV_TAC COMPLEX_RING))

  pure { WINDING_NUMBER_LINEPATH_POS_LT, WINDING_NUMBER_TRIANGLE }
/- ------------------------------------------------------------------------- -/
/- Cauchy's integral formula, again for a convex enclosing set.              -/
/- (cauchy.ml 5333-5417)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYV where
  CAUCHY_INTEGRAL_FORMULA_WEAK : thm
  CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYV [HolBase] (D : CauchyDeps) (BKYG : KYG) (BKYL : KYL) (BKYN : KYN) : ExceptT String IO KYV := do
  -- @@SCOPE BEGIN
  let { HAS_PATH_INTEGRAL_ADD, HAS_PATH_INTEGRAL_COMPLEX_LMUL, HAS_PATH_INTEGRAL_EQ,
        .. } := BKYG
  let { CAUCHY_THEOREM_CONVEX, .. } := BKYL
  let { HAS_PATH_INTEGRAL_WINDING_NUMBER, .. } := BKYN
  let { LIM_TRANSFORM_AWAY_WITHIN, .. } := D.qtopology
  let { CONTINUOUS_COMPLEX_DIV_WITHIN, .. } := D.mt.ra.ts.knc
  let { complex_differentiable, HAS_COMPLEX_DERIVATIVE_AT_WITHIN,
        HOLOMORPHIC_ON_IMP_CONTINUOUS_ON, HOLOMORPHIC_ON_OPEN, HOLOMORPHIC_ON_SUBSET,
        .. } := D.mt.ra.ts.kne
  let { HAS_COMPLEX_DERIVATIVE_WITHIN, .. } := D.mt.ra.ts.knf
  let { COMPLEX_DIFFERENTIABLE_CONST, COMPLEX_DIFFERENTIABLE_DIV_AT,
        COMPLEX_DIFFERENTIABLE_ID, COMPLEX_DIFFERENTIABLE_SUB,
        COMPLEX_DIFFERENTIABLE_TRANSFORM_AT, .. } := D.mt.ra.ts.kng
  let { COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { CONTINUOUS_TRANSFORM_WITHIN, .. } := D.mt.ra.ts.cn.ms.ig.qtopology
  let { DE_MORGAN_THM, DIFF_EMPTY, ETA_AX, FINITE_INSERT, FINITE_RULES,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IMP_CONJ, IMP_IMP, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_INSERT, LEFT_IMP_EXISTS_THM, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { DIST_POS_LT, DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { CONTINUOUS_CONST, CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN, CONTINUOUS_SUB,
        CONTINUOUS_WITHIN, CONTINUOUS_WITHIN_ID, .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { INTERIOR_SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { OPEN_INTERIOR, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  -- @@SCOPE END

  let CAUCHY_INTEGRAL_FORMULA_WEAK ← prove
   r"!f s k g z.
        convex s /\ FINITE k /\ f continuous_on s /\
        (!x. x IN interior(s) DIFF k ==> f complex_differentiable at x) /\
        z IN interior(s) DIFF k /\
        valid_path g /\ (path_image g) SUBSET (s DELETE z) /\
        pathfinish g = pathstart g
        ==> ((\w. f(w) / (w - z)) has_path_integral
             (Cx(&2) * Cx(pi) * ii * winding_number(g,z) * f(z))) g"
   (REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"z:complex")) THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [], ALL_TAC] THEN
    REWRITE_TAC [complex_differentiable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f':complex") THEN DISCH_TAC THEN MP_TAC (← SPECL
     [← q r"\w:complex. if w = z then f' else (f w - f z) / (w - z)",
      ← q r"s:complex->bool",
      ← q r"(z:complex) INSERT k",
      ← q r"g:real^1->complex"] CAUCHY_THEOREM_CONVEX) THEN
    REWRITE_TAC [IN_DIFF, IN_INSERT, DE_MORGAN_THM] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [FINITE_INSERT] THEN REPEAT CONJ_TAC THENL
       [ALL_TAC,
        X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_TRANSFORM_AT THEN
        EXISTS_TAC (← q r"\w:complex. (f w - f z) / (w - z)") THEN
        EXISTS_TAC (← q r"dist(w:complex,z)") THEN ASM_SIMP_TAC [DIST_POS_LT] THEN
        CONJ_TAC THENL [MESON_TAC [DIST_SYM, REAL_LT_REFL], ALL_TAC] THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_DIV_AT THEN
        ASM_REWRITE_TAC [COMPLEX_SUB_0] THEN CONJ_TAC THEN
        MATCH_MP_TAC COMPLEX_DIFFERENTIABLE_SUB THEN
        ASM_SIMP_TAC [ETA_AX, COMPLEX_DIFFERENTIABLE_CONST,
                     COMPLEX_DIFFERENTIABLE_ID],
        ASM SET_TAC []] THEN
      REWRITE_TAC [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN] THEN
      X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"w:complex = z") THENL
       [ALL_TAC,
        MATCH_MP_TAC CONTINUOUS_TRANSFORM_WITHIN THEN
        EXISTS_TAC (← q r"\w:complex. (f w - f z) / (w - z)") THEN
        EXISTS_TAC (← q r"dist(w:complex,z)") THEN ASM_SIMP_TAC [DIST_POS_LT] THEN
        CONJ_TAC THENL [MESON_TAC [DIST_SYM, REAL_LT_REFL], ALL_TAC] THEN
        MATCH_MP_TAC CONTINUOUS_COMPLEX_DIV_WITHIN THEN
        RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_ON_EQ_CONTINUOUS_WITHIN]) THEN
        ASM_SIMP_TAC [CONTINUOUS_CONST, CONTINUOUS_SUB, CONTINUOUS_WITHIN_ID,
                     ETA_AX, COMPLEX_SUB_0]] THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN REWRITE_TAC [CONTINUOUS_WITHIN] THEN
      MATCH_MP_TAC LIM_TRANSFORM_AWAY_WITHIN THEN
      EXISTS_TAC (← q r"\w:complex. (f w - f z) / (w - z)") THEN SIMP_TAC [] THEN
      EXISTS_TAC (← q r"z + Cx(&1)") THEN
      CONJ_TAC THENL [CONV_TAC COMPLEX_RING, ALL_TAC] THEN
      REWRITE_TAC [← GSYM HAS_COMPLEX_DERIVATIVE_WITHIN] THEN
      ASM_SIMP_TAC [HAS_COMPLEX_DERIVATIVE_AT_WITHIN],
      ALL_TAC] THEN
    MP_TAC (← SPECL [← q r"g:real^1->complex", ← q r"z:complex"]
      HAS_PATH_INTEGRAL_WINDING_NUMBER) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(f:complex->complex) z") o MATCH_MP
      HAS_PATH_INTEGRAL_COMPLEX_LMUL) THEN REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP HAS_PATH_INTEGRAL_ADD) THEN
    REWRITE_TAC [← ExceptT.mk (COMPLEX_RING
     (← q r"f * Cx(&2) * a * b * c + Cx(&0) = Cx(&2) * a * b * c * f"))] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] HAS_PATH_INTEGRAL_EQ) THEN
    X_GEN_TAC (← q r"w:complex") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"~(w:complex = z)") MP_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC COMPLEX_FIELD)

  let CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE ← prove
   r"!f s g z.
        convex s /\ f holomorphic_on s /\
        z IN interior(s) /\
        valid_path g /\ (path_image g) SUBSET (s DELETE z) /\
        pathfinish g = pathstart g
        ==> ((\w. f(w) / (w - z)) has_path_integral
             (Cx(&2) * Cx(pi) * ii * winding_number(g,z) * f(z))) g"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CAUCHY_INTEGRAL_FORMULA_WEAK THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"{}:complex->bool"] THEN
    ASM_REWRITE_TAC [DIFF_EMPTY, FINITE_RULES] THEN
    SIMP_TAC [OPEN_INTERIOR, complex_differentiable, ← GSYM HOLOMORPHIC_ON_OPEN] THEN
    ASM_MESON_TAC [HOLOMORPHIC_ON_IMP_CONTINUOUS_ON,
                  HOLOMORPHIC_ON_SUBSET, INTERIOR_SUBSET])

  pure { CAUCHY_INTEGRAL_FORMULA_WEAK, CAUCHY_INTEGRAL_FORMULA_CONVEX_SIMPLE }
/- ------------------------------------------------------------------------- -/
/- Homotopy forms of Cauchy's theorem: homotopic paths.                      -/
/- (cauchy.ml 5418-5616)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYW where
  CAUCHY_THEOREM_HOMOTOPIC_PATHS : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYW [HolBase] (D : CauchyDeps) (BKYM : KYM) : ExceptT String IO KYW := do
  -- @@SCOPE BEGIN
  let { PATH_INTEGRAL_NEARBY_ENDS, VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { COMPACT_IMP_HEINE_BOREL, .. } := D.qtopology
  let { homotopic_paths, HOMOTOPIC_PATHS_IMP_PATHFINISH, HOMOTOPIC_PATHS_IMP_PATHSTART,
        .. } := D.qpaths
  let { NORM_PASTECART, .. } := D.qvectors
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, .. } := D.mt.ra.ts.cn.cx.cpx
  let { NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { CONJ_ASSOC, FINITE_IMAGE, FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, IMP_IMP, INF_FINITE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_1, LE_REFL, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, PCROSS, POW_2_SQRT,
        REAL_ABS_INV, REAL_ABS_NUM, REAL_ADD_RID, REAL_ARCH_INV, REAL_DIV_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_INF_FINITE, REAL_LT_MIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUB, REAL_POS, REAL_SUB_RDISTRIB, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, UNIONS_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_NUM, NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, drop, VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_INTERVAL, COMPACT_PCROSS, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, OPEN_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { PASTECART_SUB, .. } := D.mt.ra.ts.cn.ms.ig.dv.qvec
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path, path_image, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { COMPACT_UNIFORMLY_CONTINUOUS, CONTINUOUS_ON_PASTECART,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let CAUCHY_THEOREM_HOMOTOPIC_PATHS ← prove
   r"!f g h s.
        open s /\ f holomorphic_on s /\
        valid_path g /\ valid_path h /\ homotopic_paths s g h
        ==> path_integral g f = path_integral h f"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o SYM o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHSTART) THEN
    FIRST_ASSUM (ASSUME_TAC o SYM o MATCH_MP HOMOTOPIC_PATHS_IMP_PATHFINISH) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_paths]) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, LEFT_IMP_EXISTS_THM, PCROSS] THEN
    X_GEN_TAC (← q r"k:real^(1,1)finite_sum->complex") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!t. t IN interval[vec 0:real^1,vec 1]
          ==> ?e. &0 < e /\
                !t1 t2. t1 IN interval[vec 0:real^1,vec 1] /\
                        t2 IN interval[vec 0,vec 1] /\
                        norm(t1 - t) < e /\ norm(t2 - t) < e
                     ==> ?d. &0 < d /\
                          !g1 g2. valid_path g1 /\ valid_path g2 /\
                                  (!u. u IN interval[vec 0,vec 1]
                                       ==> norm(g1 u - k(pastecart t1 u)) < d /\
                                           norm(g2 u - k(pastecart t2 u)) < d) /\
                                  pathstart g1 = pathstart g /\
                                  pathfinish g1 = pathfinish g /\
                                  pathstart g2 = pathstart g /\
                                  pathfinish g2 = pathfinish g
                                  ==> path_image g1 SUBSET s /\
                                      path_image g2 SUBSET s /\
                                      path_integral g2 f = path_integral g1 f")
    MP_TAC THENL
     [X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"s:complex->bool", ← q r"\u. (k:real^(1,1)finite_sum->complex)(pastecart t u)"]
       PATH_INTEGRAL_NEARBY_ENDS) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        REWRITE_TAC [path_image, path, IMAGE_o] THEN CONJ_TAC THENL
         [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
                 CONTINUOUS_ON_CONST] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC)] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COMPACT_UNIFORMLY_CONTINUOUS)) THEN
      SIMP_TAC [← REWRITE_RULE [PCROSS] COMPACT_PCROSS, COMPACT_INTERVAL] THEN
      REWRITE_TAC [uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!t x t' x'. P t x t' x') ==> (!t t' u. P t u t' u)"))) THEN
      REWRITE_TAC [dist, NORM_PASTECART, PASTECART_SUB] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← TAUT (← q r"a /\ b /\ c /\ b /\ d <=> a /\ c /\ b /\ d")] THEN
      SIMP_TAC [REAL_ADD_RID, POW_2_SQRT, NORM_POS_LE] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"t1:real^1", ← q r"t2:real^1"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"e / &4") THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
      MAP_EVERY X_GEN_TAC [← q r"g1:real^1->complex", ← q r"g2:real^1->complex"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM
       (MP_TAC o SPECL [← q r"g1:real^1->complex", ← q r"g2:real^1->complex"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      X_GEN_TAC (← q r"u:real^1") THEN STRIP_TAC THEN
      ASM_MESON_TAC [← NORM_ARITH
       (← q r"norm(g1 - k1) < e / &4 /\ norm(g2 - k2) < e / &4 /\
        norm(k1 - kt) < e / &4 /\ norm(k2 - kt) < e / &4
        ==> norm(g1 - kt) < e /\ norm(g2 - kt) < e")],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"ee:real^1->real") THEN DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPEC (← q r"interval[vec 0:real^1,vec 1]") COMPACT_IMP_HEINE_BOREL) THEN
    REWRITE_TAC [COMPACT_INTERVAL] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE (\t:real^1. ball(t,ee t / &3)) (interval[vec 0,vec 1])")) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE, OPEN_BALL, SUBSET] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"t:real^1") THEN
      ASM_SIMP_TAC [CENTRE_IN_BALL, ← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, ← MESON []
     (← q r"(?f s. (P s /\ f = g s) /\ Q f) <=> ?s. P s /\ Q(g s)")] THEN
    REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real^1->bool") THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"k:real^1->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN REAL_ARITH_TAC,
      DISCH_THEN (LABEL_TAC "+")] THEN
    SUBGOAL_THEN (← q r"!i:real^1. i IN k ==> &0 < ee(i)")
    ASSUME_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    ABBREV_TAC (← q r"e = inf(IMAGE (ee:real^1->real) k)") THEN
    MP_TAC (← ISPEC (← q r"IMAGE (ee:real^1->real) k") INF_FINITE) THEN
    MP_TAC (← ISPECL [← q r"IMAGE (ee:real^1->real) k", ← q r"&0"]
      REAL_LT_INF_FINITE) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    DISCH_TAC THEN DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN
    MP_TAC (← ISPEC (← q r"e / &3") REAL_ARCH_INV) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!n. n <= N
          ==> ?d. &0 < d /\
                  !j. valid_path j /\
                      (!u. u IN interval [vec 0,vec 1]
                          ==> norm(j u - k(pastecart (lift(&n / &N)) u)) < d) /\
                      pathstart j = pathstart g /\
                      pathfinish j = pathfinish g
                      ==> path_image j SUBSET s /\
                          path_integral j f = path_integral g f")
    (MP_TAC o SPEC (← q r"N:num")) THENL
     [ALL_TAC,
      REWRITE_TAC [LE_REFL, LEFT_IMP_EXISTS_THM] THEN
      GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"h:real^1->complex")) THEN
      ASM_SIMP_TAC [REAL_DIV_REFL, REAL_OF_NUM_EQ, LIFT_NUM] THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN MESON_TAC []] THEN
    INDUCT_TAC THENL
     [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
      ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO, LE_0, LIFT_NUM] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REPEAT (DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
             REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL]) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"j:real^1->complex") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"g:real^1->complex", ← q r"j:real^1->complex"]) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN MESON_TAC [],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"lift(&n / &N) IN interval[vec 0,vec 1] /\
                  lift(&(SUC n) / &N) IN interval[vec 0,vec 1]")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
      REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    REMOVE_THEN "+" (MP_TAC o SPEC (← q r"lift(&n / &N)")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real")
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1"))) THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"t:real^1")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&n / &N)", ← q r"lift(&(SUC n) / &N)"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"!e. norm(n' - n:real^N) < e / &3 /\ e <= ee
       ==> dist(t,n) < ee / &3 ==> norm(n - t) < ee /\ norm(n' - t) < ee")) THEN
      EXISTS_TAC (← q r"e:real") THEN
      REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP] THEN
      REWRITE_TAC [real_div, ← GSYM REAL_SUB_RDISTRIB] THEN
      SIMP_TAC [REAL_OF_NUM_SUB, ← ARITH_RULE (← q r"n <= SUC n")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"SUC n - n = 1"), REAL_MUL_LID] THEN
      REWRITE_TAC [REAL_ABS_INV, REAL_ABS_NUM] THEN
      ASM_SIMP_TAC [← GSYM real_div],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d2:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"j:real^1->complex") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\u:real^1. (k(pastecart (lift (&n / &N)) u):complex)",
      ← q r"min d1 d2"] PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_SIMP_TAC [REAL_LT_MIN, ← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [path] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
               CONTINUOUS_ON_CONST] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC)] THEN
    REMOVE_THEN "1" (MP_TAC o SPEC (← q r"p:real^1->complex")) THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:real^1->complex", ← q r"j:real^1->complex"]) THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION])

  pure { CAUCHY_THEOREM_HOMOTOPIC_PATHS }
/- ------------------------------------------------------------------------- -/
/- Homotopy forms of Cauchy's theorem: homotopic loops; null-homotopic and  -/
/- simply connected cases.                                                   -/
/- (cauchy.ml 5617-5843)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYX where
  CAUCHY_THEOREM_HOMOTOPIC_LOOPS : thm
  CAUCHY_THEOREM_NULL_HOMOTOPIC : thm
  CAUCHY_THEOREM_SIMPLY_CONNECTED : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYX [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYC : KYC) (BKYE : KYE) (BKYL : KYL) (BKYM : KYM) : ExceptT String IO KYX := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on, PATH_INTEGRAL_UNIQUE, .. } := BKYC
  let { VALID_PATH_LINEPATH, .. } := BKYE
  let { CAUCHY_THEOREM_CONVEX_SIMPLE, PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE, .. } := BKYL
  let { PATH_INTEGRAL_NEARBY_LOOP, VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { COMPACT_IMP_HEINE_BOREL, .. } := D.qtopology
  let { HOMOTOPIC_LOOPS_IMP_LOOP, HOMOTOPIC_LOOPS_IMP_SUBSET,
        HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS, SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH,
        .. } := D.qpaths
  let { NORM_PASTECART, .. } := D.qvectors
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { HOLOMORPHIC_ON_SUBSET, .. } := D.mt.ra.ts.kne
  let { homotopic_loops, .. } := D.mt.ra.ts.qpaths
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, NORM_ARITH,
        REAL_ARITH, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, SET_TAC,
        .. } := D.mt.ra.ts.cn.cx.cvx
  let { LE_0, .. } := D.mt.ra.ts.cn.cx.cpx
  let { NORM_REAL, .. } := D.mt.ra.ts.cn.ms.ig.qvec
  let { CONJ_ASSOC, FINITE_IMAGE, FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, IMAGE_o, IMP_CONJ, IMP_IMP, INF_FINITE,
        .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_ELIM_THM, LE_1, LE_REFL, LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_EXISTS_THM, NOT_IN_EMPTY, PCROSS, POW_2_SQRT,
        REAL_ABS_INV, REAL_ABS_NUM, REAL_ADD_RID, REAL_ARCH_INV, REAL_DIV_REFL,
        .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LE_LDIV_EQ, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_INF_FINITE, REAL_LT_MIN,
        .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_MUL_LID, REAL_MUL_LZERO, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_SUB, REAL_POS, REAL_SUB_RDISTRIB, RIGHT_FORALL_IMP_THM,
        RIGHT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SKOLEM_THM, SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { o_DEF, real_div, UNIONS_IMAGE, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DROP_SUB, DROP_VEC, LIFT_DROP, LIFT_NUM, NORM_0, .. } := D.mt.ra.ts.cn.cx.cvx.vec2
  let { NORM_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, drop, VECTOR_SUB_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CENTRE_IN_BALL, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { COMPACT_INTERVAL, COMPACT_PCROSS, .. } := D.mt.ra.ts.cn.cx.cvx.top2
  let { CONTINUOUS_ON_COMPOSE, CONTINUOUS_ON_CONST, CONTINUOUS_ON_ID, CONTINUOUS_ON_SUBSET,
        .. } := D.mt.ra.ts.cn.cx.cvx.top3
  let { IN_BALL, IN_INTERVAL_1, INTERVAL_EQ_EMPTY_1, OPEN_BALL, OPEN_CONTAINS_BALL,
        .. } := D.mt.ra.ts.cn.cx.cvx.top4
  let { SEGMENT_REFL, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { PASTECART_SUB, .. } := D.mt.ra.ts.cn.ms.ig.dv.qvec
  let { HOMOTOPIC_WITH_EUCLIDEAN, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path, path_image, PATH_IMAGE_LINEPATH, PATHFINISH_LINEPATH,
        PATHSTART_IN_PATH_IMAGE, PATHSTART_LINEPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { COMPACT_UNIFORMLY_CONTINUOUS, CONTINUOUS_ON_PASTECART,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology1
  let { uniformly_continuous_on, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  let { CONVEX_BALL, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.pt.qcvx2
  -- @@SCOPE END

  let CAUCHY_THEOREM_HOMOTOPIC_LOOPS ← prove
   r"!f g h s.
        open s /\ f holomorphic_on s /\
        valid_path g /\ valid_path h /\ homotopic_loops s g h
        ==> path_integral g f = path_integral h f"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_LOOP) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homotopic_loops]) THEN
    REWRITE_TAC [HOMOTOPIC_WITH_EUCLIDEAN, PCROSS, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real^(1,1)finite_sum->complex") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!t. t IN interval[vec 0:real^1,vec 1]
          ==> ?e. &0 < e /\
                !t1 t2. t1 IN interval[vec 0:real^1,vec 1] /\
                        t2 IN interval[vec 0,vec 1] /\
                        norm(t1 - t) < e /\ norm(t2 - t) < e
                     ==> ?d. &0 < d /\
                          !g1 g2. valid_path g1 /\ valid_path g2 /\
                                  (!u. u IN interval[vec 0,vec 1]
                                       ==> norm(g1 u - k(pastecart t1 u)) < d /\
                                           norm(g2 u - k(pastecart t2 u)) < d) /\
                                  pathfinish g1 = pathstart g1 /\
                                  pathfinish g2 = pathstart g2
                                  ==> path_image g1 SUBSET s /\
                                      path_image g2 SUBSET s /\
                                      path_integral g2 f = path_integral g1 f")
    MP_TAC THENL
     [X_GEN_TAC (← q r"t:real^1") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"s:complex->bool", ← q r"\u. (k:real^(1,1)finite_sum->complex)(pastecart t u)"]
       PATH_INTEGRAL_NEARBY_LOOP) THEN
      REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        REWRITE_TAC [path_image, path, IMAGE_o] THEN CONJ_TAC THENL
         [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
        SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
                 CONTINUOUS_ON_CONST] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN ASM SET_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC)] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
            COMPACT_UNIFORMLY_CONTINUOUS)) THEN
      SIMP_TAC [← REWRITE_RULE [PCROSS] COMPACT_PCROSS, COMPACT_INTERVAL] THEN
      REWRITE_TAC [uniformly_continuous_on] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e / &4")) THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON []
       (← q r"(!t x t' x'. P t x t' x') ==> (!t t' u. P t u t' u)"))) THEN
      REWRITE_TAC [dist, NORM_PASTECART, PASTECART_SUB] THEN
      REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN
      REWRITE_TAC [← TAUT (← q r"a /\ b /\ c /\ b /\ d <=> a /\ c /\ b /\ d")] THEN
      SIMP_TAC [REAL_ADD_RID, POW_2_SQRT, NORM_POS_LE] THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"t1:real^1", ← q r"t2:real^1"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"e / &4") THEN
      ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
      MAP_EVERY X_GEN_TAC [← q r"g1:real^1->complex", ← q r"g2:real^1->complex"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM
       (MP_TAC o SPECL [← q r"g1:real^1->complex", ← q r"g2:real^1->complex"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      X_GEN_TAC (← q r"u:real^1") THEN STRIP_TAC THEN
      ASM_MESON_TAC [← NORM_ARITH
       (← q r"norm(g1 - k1) < e / &4 /\ norm(g2 - k2) < e / &4 /\
        norm(k1 - kt) < e / &4 /\ norm(k2 - kt) < e / &4
        ==> norm(g1 - kt) < e /\ norm(g2 - kt) < e")],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"ee:real^1->real") THEN DISCH_THEN (LABEL_TAC "*") THEN
    MP_TAC (← ISPEC (← q r"interval[vec 0:real^1,vec 1]") COMPACT_IMP_HEINE_BOREL) THEN
    REWRITE_TAC [COMPACT_INTERVAL] THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE (\t:real^1. ball(t,ee t / &3)) (interval[vec 0,vec 1])")) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE, OPEN_BALL, SUBSET] THEN
      X_GEN_TAC (← q r"t:real^1") THEN DISCH_TAC THEN
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"t:real^1") THEN
      ASM_SIMP_TAC [CENTRE_IN_BALL, ← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")],
      ALL_TAC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"a /\ b /\ c <=> b /\ a /\ c")] THEN
    REWRITE_TAC [CONJ_ASSOC, FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, ← MESON []
     (← q r"(?f s. (P s /\ f = g s) /\ Q f) <=> ?s. P s /\ Q(g s)")] THEN
    REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real^1->bool") THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"k:real^1->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, ← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [INTERVAL_EQ_EMPTY_1, DROP_VEC] THEN REAL_ARITH_TAC,
      DISCH_THEN (LABEL_TAC "+")] THEN
    SUBGOAL_THEN (← q r"!i:real^1. i IN k ==> &0 < ee(i)")
    ASSUME_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
    ABBREV_TAC (← q r"e = inf(IMAGE (ee:real^1->real) k)") THEN
    MP_TAC (← ISPEC (← q r"IMAGE (ee:real^1->real) k") INF_FINITE) THEN
    MP_TAC (← ISPECL [← q r"IMAGE (ee:real^1->real) k", ← q r"&0"]
      REAL_LT_INF_FINITE) THEN
    ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN
    DISCH_TAC THEN DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN
    MP_TAC (← ISPEC (← q r"e / &3") REAL_ARCH_INV) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"!n. n <= N
          ==> ?d. &0 < d /\
                  !j. valid_path j /\
                      (!u. u IN interval [vec 0,vec 1]
                          ==> norm(j u - k(pastecart (lift(&n / &N)) u)) < d) /\
                      pathfinish j = pathstart j
                      ==> path_image j SUBSET s /\
                          path_integral j f = path_integral g f")
    (MP_TAC o SPEC (← q r"N:num")) THENL
     [ALL_TAC,
      REWRITE_TAC [LE_REFL, LEFT_IMP_EXISTS_THM] THEN
      GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"h:real^1->complex")) THEN
      ASM_SIMP_TAC [REAL_DIV_REFL, REAL_OF_NUM_EQ, LIFT_NUM] THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN MESON_TAC []] THEN
    INDUCT_TAC THENL
     [REMOVE_THEN "*" (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
      ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO, LE_0, LIFT_NUM] THEN
      REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REPEAT (DISCH_THEN (MP_TAC o SPEC (← q r"vec 0:real^1")) THEN
             REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, REAL_POS, REAL_LE_REFL]) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"j:real^1->complex") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"g:real^1->complex", ← q r"j:real^1->complex"]) THEN
      ASM_REWRITE_TAC [VECTOR_SUB_REFL, NORM_0] THEN MESON_TAC [],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"lift(&n / &N) IN interval[vec 0,vec 1] /\
                  lift(&(SUC n) / &N) IN interval[vec 0,vec 1]")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [IN_INTERVAL_1, DROP_VEC, LIFT_DROP] THEN
      ASM_SIMP_TAC [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ, REAL_OF_NUM_LT, LE_1] THEN
      REWRITE_TAC [REAL_MUL_LZERO, REAL_MUL_LID, REAL_OF_NUM_LE] THEN
      ASM_ARITH_TAC,
      ALL_TAC] THEN
    REMOVE_THEN "+" (MP_TAC o SPEC (← q r"lift(&n / &N)")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real^1") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_imp o concl)) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d1:real")
      (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "1"))) THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"t:real^1")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"lift(&n / &N)", ← q r"lift(&(SUC n) / &N)"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_BALL]) THEN
      MATCH_MP_TAC (← NORM_ARITH
       (← q r"!e. norm(n' - n:real^N) < e / &3 /\ e <= ee
       ==> dist(t,n) < ee / &3 ==> norm(n - t) < ee /\ norm(n' - t) < ee")) THEN
      EXISTS_TAC (← q r"e:real") THEN
      REWRITE_TAC [NORM_REAL, ← GSYM drop, DROP_SUB, LIFT_DROP] THEN
      REWRITE_TAC [real_div, ← GSYM REAL_SUB_RDISTRIB] THEN
      SIMP_TAC [REAL_OF_NUM_SUB, ← ARITH_RULE (← q r"n <= SUC n")] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"SUC n - n = 1"), REAL_MUL_LID] THEN
      REWRITE_TAC [REAL_ABS_INV, REAL_ABS_NUM] THEN
      ASM_SIMP_TAC [← GSYM real_div],
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d2:real") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"j:real^1->complex") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\u:real^1. (k(pastecart (lift (&n / &N)) u):complex)",
      ← q r"min d1 d2"] PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
    ASM_SIMP_TAC [REAL_LT_MIN, ← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
    ANTS_TAC THENL
     [REWRITE_TAC [path] THEN GEN_REWRITE_TAC LAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_ON_COMPOSE THEN
      SIMP_TAC [CONTINUOUS_ON_PASTECART, CONTINUOUS_ON_ID,
               CONTINUOUS_ON_CONST] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_ON_SUBSET)) THEN
      ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC)] THEN
    REMOVE_THEN "1" (MP_TAC o SPEC (← q r"p:real^1->complex")) THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:real^1->complex", ← q r"j:real^1->complex"]) THEN
    ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION])


  let CAUCHY_THEOREM_NULL_HOMOTOPIC ← prove
   r"!f g s a.
        open s /\ f holomorphic_on s /\ a IN s /\ valid_path g /\
        homotopic_loops s g (linepath(a,a))
        ==> (f has_path_integral Cx(&0)) g"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_SUBSET) THEN
    MATCH_MP_TAC
     (← MESON [HAS_PATH_INTEGRAL_INTEGRAL, path_integrable_on, PATH_INTEGRAL_UNIQUE]
       (← q r"!p. f path_integrable_on g /\ (f has_path_integral y) p /\
            path_integral g f = path_integral p f
            ==> (f has_path_integral y) g")) THEN
    EXISTS_TAC (← q r"linepath(a:complex,a)") THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [PATH_INTEGRABLE_HOLOMORPHIC_SIMPLE],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_CONTAINS_BALL]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:complex")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MATCH_MP_TAC CAUCHY_THEOREM_CONVEX_SIMPLE THEN
      EXISTS_TAC (← q r"ball(a:complex,e)") THEN
      ASM_REWRITE_TAC [VALID_PATH_LINEPATH, CONVEX_BALL, PATH_IMAGE_LINEPATH,
                      PATHSTART_LINEPATH, PATHFINISH_LINEPATH] THEN
      ASM_REWRITE_TAC [SEGMENT_REFL, SING_SUBSET, IN_BALL, CENTRE_IN_BALL] THEN
      ASM_MESON_TAC [HOLOMORPHIC_ON_SUBSET],
      MATCH_MP_TAC CAUCHY_THEOREM_HOMOTOPIC_LOOPS THEN
      EXISTS_TAC (← q r"s:complex->bool") THEN ASM_REWRITE_TAC [VALID_PATH_LINEPATH]])

  let CAUCHY_THEOREM_SIMPLY_CONNECTED ← prove
   r"!f g s. open s /\ simply_connected s /\ f holomorphic_on s /\
           valid_path g /\ path_image g SUBSET s /\ pathfinish g = pathstart g
           ==> (f has_path_integral Cx(&0)) g"
   (REWRITE_TAC [SIMPLY_CONNECTED_EQ_CONTRACTIBLE_PATH] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CAUCHY_THEOREM_NULL_HOMOTOPIC THEN
    MAP_EVERY EXISTS_TAC [← q r"s:complex->bool", ← q r"pathstart g :complex"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [PATHSTART_IN_PATH_IMAGE, SUBSET],
      MATCH_MP_TAC HOMOTOPIC_PATHS_IMP_HOMOTOPIC_LOOPS THEN
      ASM_SIMP_TAC [PATHFINISH_LINEPATH, VALID_PATH_IMP_PATH]])

  pure { CAUCHY_THEOREM_HOMOTOPIC_LOOPS, CAUCHY_THEOREM_NULL_HOMOTOPIC,
         CAUCHY_THEOREM_SIMPLY_CONNECTED }
/- ------------------------------------------------------------------------- -/
/- More winding number properties: homotopy invariance, nearby paths,      -/
/- combining subpaths, polynomial approximation, inner paths.               -/
/- (cauchy.ml 5844-6091)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KYY where
  WINDING_NUMBER_HOMOTOPIC_PATHS : thm
  WINDING_NUMBER_HOMOTOPIC_LOOPS : thm
  WINDING_NUMBER_PATHS_LINEAR_EQ : thm
  WINDING_NUMBER_LOOPS_LINEAR_EQ : thm
  WINDING_NUMBER_NEARBY_PATHS_EQ : thm
  WINDING_NUMBER_NEARBY_LOOPS_EQ : thm
  WINDING_NUMBER_SUBPATH_COMBINE : thm
  WINDING_NUMBER_STRONG : thm
  WINDING_NUMBER_FROM_INNERPATH : thm
  deriving Inhabited

set_option maxHeartbeats 64000000 in
set_option maxRecDepth 16384 in
@[nospecialize]
def setupKYY [HolBase] (D : CauchyDeps) (BKYB : KYB) (BKYM : KYM) (BKYN : KYN) (BKYS : KYS) (BKYW : KYW) (BKYX : KYX) : ExceptT String IO KYY := do
  -- @@SCOPE BEGIN
  let { VALID_PATH_IMP_PATH, .. } := BKYB
  let { VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION, .. } := BKYM
  let { CX_2PII_NZ, WINDING_NUMBER, WINDING_NUMBER_JOIN, WINDING_NUMBER_REVERSEPATH,
        WINDING_NUMBER_VALID_PATH, .. } := BKYN
  let { WINDING_NUMBER_ZERO_IN_OUTSIDE, .. } := BKYS
  let { CAUCHY_THEOREM_HOMOTOPIC_PATHS, .. } := BKYW
  let { CAUCHY_THEOREM_HOMOTOPIC_LOOPS, .. } := BKYX
  let { SPLIT_INSIDE_SIMPLE_CLOSED_CURVE, .. } := D.moy
  let { SETDIST_EQ_0_CLOSED_COMPACT, .. } := D.qtopology
  let { HOMOTOPIC_JOIN_SUBPATHS, HOMOTOPIC_LOOPS_IMP_LOOP, HOMOTOPIC_LOOPS_IMP_PATH,
        HOMOTOPIC_LOOPS_IMP_SUBSET, HOMOTOPIC_LOOPS_LINEAR,
        HOMOTOPIC_LOOPS_NEARBY_EXPLICIT, HOMOTOPIC_LOOPS_SYM, HOMOTOPIC_NEARBY_LOOPS,
        HOMOTOPIC_NEARBY_PATHS, HOMOTOPIC_PATHS_IMP_PATH, HOMOTOPIC_PATHS_IMP_SUBSET,
        HOMOTOPIC_PATHS_LINEAR, HOMOTOPIC_PATHS_NEARBY_EXPLICIT, HOMOTOPIC_PATHS_SYM,
        HOMOTOPIC_PATHS_TRANS, .. } := D.qpaths
  let { PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION, .. } := D.mt.rzbl
  let { INSIDE_NO_OVERLAP, OUTSIDE_INSIDE, .. } := D.mt.qpaths
  let { HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_DIV, HOLOMORPHIC_ON_ID, HOLOMORPHIC_ON_SUB,
        .. } := D.mt.ra.ts.knh
  let { HOMOTOPIC_LOOPS_TRANS, .. } := D.mt.ra.ts.qpaths
  let { COMPLEX_SUB_0, .. } := D.mt.ra.ts.cn.cxb
  let { COMPLEX_RING, .. } := D.mt.ra.ts.cn.cxd
  let { COMPLEX_FIELD, .. } := D.mt.ra.ts.cn.cxe
  let { ASM_MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D.mt.ra.ts.cn.cx.cvx
  let { PATH_IMAGE_SUBPATH_SUBSET, PATH_SUBPATH, PATHFINISH_SUBPATH, PATHSTART_SUBPATH,
        .. } := D.mt.ra.ts.cn.ms.ig.qpaths
  let { EQ_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core1
  let { IN_DELETE, IN_DIFF, .. } := D.mt.ra.ts.cn.cx.cvx.core2
  let { IN_IMAGE, IN_UNION, IN_UNIV, MONO_EXISTS, .. } := D.mt.ra.ts.cn.cx.cvx.core3
  let { REAL_LT_MIN, REAL_LTE_TRANS, .. } := D.mt.ra.ts.cn.cx.cvx.core4
  let { REAL_NOT_LT, SUBSET, .. } := D.mt.ra.ts.cn.cx.cvx.core5
  let { UNION_COMM, .. } := D.mt.ra.ts.cn.cx.cvx.core6
  let { DIST_SYM, .. } := D.mt.ra.ts.cn.cx.cvx.vec1
  let { NORM_SUB, .. } := D.mt.ra.ts.cn.cx.cvx.vec3
  let { dist, .. } := D.mt.ra.ts.cn.cx.cvx.vec4
  let { CLOSED_SING, .. } := D.mt.ra.ts.cn.cx.cvx.top1
  let { OPEN_UNIV, SETDIST_LE_DIST, SETDIST_POS_LE, .. } := D.mt.ra.ts.cn.cx.cvx.top5
  let { COMPACT_PATH_IMAGE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths1
  let { path_image, PATH_IMAGE_JOIN, PATH_IMAGE_NONEMPTY, PATH_IMAGE_REVERSEPATH,
        PATH_JOIN, PATH_REVERSEPATH, PATHFINISH_JOIN, PATHFINISH_REVERSEPATH,
        PATHSTART_JOIN, PATHSTART_REVERSEPATH, SIMPLE_PATH_IMP_PATH,
        .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qpaths2
  let { OPEN_DELETE, .. } := D.mt.ra.ts.cn.ms.ig.dv.dg.qtopology2
  -- @@SCOPE END

  let WINDING_NUMBER_HOMOTOPIC_PATHS ← prove
   r"!g h z. homotopic_paths ((:complex) DELETE z) g h
           ==> winding_number(g,z) = winding_number(h,z)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_PATH) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_PATHS_IMP_SUBSET) THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"(:complex) DELETE z"]
       HOMOTOPIC_NEARBY_PATHS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, ← SET_RULE
     (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"d:real"]
      WINDING_NUMBER) THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:real^1->complex", ← q r"(:complex) DELETE z"]
       HOMOTOPIC_NEARBY_PATHS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, ← SET_RULE
     (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"path_integral p (\w. Cx(&1) / (w - z)) =
      path_integral q (\w. Cx(&1) / (w - z))")
    MP_TAC THENL
     [MATCH_MP_TAC CAUCHY_THEOREM_HOMOTOPIC_PATHS THEN
      EXISTS_TAC (← q r"(:complex) DELETE z") THEN
      ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
        SIMP_TAC [HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID,
                 HOLOMORPHIC_ON_SUB, IN_DELETE, COMPLEX_SUB_0],
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
      EXISTS_TAC (← q r"g:real^1->complex") THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [HOMOTOPIC_PATHS_SYM] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [NORM_SUB, VALID_PATH_IMP_PATH],
        MATCH_MP_TAC HOMOTOPIC_PATHS_TRANS THEN
        EXISTS_TAC (← q r"h:real^1->complex") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [NORM_SUB, VALID_PATH_IMP_PATH]],
      ASM_REWRITE_TAC [] THEN MP_TAC CX_2PII_NZ THEN CONV_TAC COMPLEX_RING])

  let WINDING_NUMBER_HOMOTOPIC_LOOPS ← prove
   r"!g h z. homotopic_loops ((:complex) DELETE z) g h
           ==> winding_number(g,z) = winding_number(h,z)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_PATH) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_LOOP) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_LOOPS_IMP_SUBSET) THEN
    REWRITE_TAC [← SET_RULE (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"(:complex) DELETE z"]
       HOMOTOPIC_NEARBY_LOOPS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, ← SET_RULE
     (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"z:complex", ← q r"d:real"]
      WINDING_NUMBER) THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:real^1->complex") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:real^1->complex", ← q r"(:complex) DELETE z"]
       HOMOTOPIC_NEARBY_LOOPS) THEN
    ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV, ← SET_RULE
     (← q r"s SUBSET UNIV DELETE z <=> ~(z IN s)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"h:real^1->complex", ← q r"z:complex", ← q r"e:real"]
      WINDING_NUMBER) THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:real^1->complex") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"path_integral p (\w. Cx(&1) / (w - z)) =
      path_integral q (\w. Cx(&1) / (w - z))")
    MP_TAC THENL
     [MATCH_MP_TAC CAUCHY_THEOREM_HOMOTOPIC_LOOPS THEN
      EXISTS_TAC (← q r"(:complex) DELETE z") THEN
      ASM_SIMP_TAC [OPEN_DELETE, OPEN_UNIV] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HOLOMORPHIC_ON_DIV THEN
        SIMP_TAC [HOLOMORPHIC_ON_CONST, HOLOMORPHIC_ON_ID,
                 HOLOMORPHIC_ON_SUB, IN_DELETE, COMPLEX_SUB_0],
        ALL_TAC] THEN
      MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
      EXISTS_TAC (← q r"g:real^1->complex") THEN CONJ_TAC THENL
       [ONCE_REWRITE_TAC [HOMOTOPIC_LOOPS_SYM] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [NORM_SUB, VALID_PATH_IMP_PATH],
        MATCH_MP_TAC HOMOTOPIC_LOOPS_TRANS THEN
        EXISTS_TAC (← q r"h:real^1->complex") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_MESON_TAC [NORM_SUB, VALID_PATH_IMP_PATH]],
      ASM_REWRITE_TAC [] THEN MP_TAC CX_2PII_NZ THEN CONV_TAC COMPLEX_RING])

  let WINDING_NUMBER_PATHS_LINEAR_EQ ← prove
   r"!g h z.
        path g /\ path h /\
        pathstart h = pathstart g /\
        pathfinish h = pathfinish g /\
        (!t. t IN interval[vec 0,vec 1] ==> ~(z IN segment[g t,h t]))
        ==> winding_number(h,z) = winding_number(g,z)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_PATHS THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_LINEAR THEN ASM SET_TAC [])

  let WINDING_NUMBER_LOOPS_LINEAR_EQ ← prove
   r"!g h z.
        path g /\ path h /\
        pathfinish g = pathstart g /\
        pathfinish h = pathstart h /\
        (!t. t IN interval[vec 0,vec 1] ==> ~(z IN segment[g t,h t]))
        ==> winding_number(h,z) = winding_number(g,z)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_LOOPS THEN
    MATCH_MP_TAC HOMOTOPIC_LOOPS_LINEAR THEN ASM SET_TAC [])

  let WINDING_NUMBER_NEARBY_PATHS_EQ ← prove
   r"!g h z.
        path g /\ path h /\
        pathstart h = pathstart g /\
        pathfinish h = pathfinish g /\
        (!t. t IN interval[vec 0,vec 1] ==> norm(h t - g t) < norm(g t - z))
        ==> winding_number(h,z) = winding_number(g,z)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_PATHS THEN
    MATCH_MP_TAC HOMOTOPIC_PATHS_NEARBY_EXPLICIT THEN ASM SET_TAC [])

  let WINDING_NUMBER_NEARBY_LOOPS_EQ ← prove
   r"!g h z.
        path g /\ path h /\
        pathfinish g = pathstart g /\
        pathfinish h = pathstart h /\
        (!t. t IN interval[vec 0,vec 1] ==> norm(h t - g t) < norm(g t - z))
        ==> winding_number(h,z) = winding_number(g,z)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_LOOPS THEN
    MATCH_MP_TAC HOMOTOPIC_LOOPS_NEARBY_EXPLICIT THEN ASM SET_TAC [])

  let WINDING_NUMBER_SUBPATH_COMBINE ← prove
   r"!g u v w z.
        path g /\ ~(z IN path_image g) /\
        u IN interval [vec 0,vec 1] /\
        v IN interval [vec 0,vec 1] /\
        w IN interval [vec 0,vec 1]
        ==> winding_number(subpath u v g,z) +
            winding_number(subpath v w g,z) =
            winding_number(subpath u w g,z)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EQ_TRANS THEN
    EXISTS_TAC (← q r"winding_number(subpath u v g ++ subpath v w g,z)") THEN
    CONJ_TAC THENL
     [CONV_TAC SYM_CONV THEN MATCH_MP_TAC WINDING_NUMBER_JOIN THEN
      ASM_SIMP_TAC [PATH_SUBPATH, PATHSTART_SUBPATH, PATHFINISH_SUBPATH] THEN
      ASM_MESON_TAC [SUBSET, PATH_IMAGE_SUBPATH_SUBSET],
      MATCH_MP_TAC WINDING_NUMBER_HOMOTOPIC_PATHS THEN
      MATCH_MP_TAC HOMOTOPIC_JOIN_SUBPATHS THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC []])

  let WINDING_NUMBER_STRONG ← prove
   r"!g z e.
        path g /\ ~(z IN path_image g) /\ &0 < e
         ==> ?p. vector_polynomial_function p /\ valid_path p /\
                 ~(z IN path_image p) /\
                 pathstart p = pathstart g /\
                 pathfinish p = pathfinish g /\
                 (!t. t IN interval[vec 0,vec 1] ==> norm(g t - p t) < e) /\
                 path_integral p (\w. Cx(&1) / (w - z)) =
                 Cx(&2) * Cx(pi) * ii * winding_number(g,z)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?d. &0 < d /\
         !t. t IN interval[vec 0,vec 1] ==> d <= norm((g:real^1->complex) t - z)")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"setdist({z:complex},path_image g)") THEN
      REWRITE_TAC [SETDIST_POS_LE, ← REAL_ARITH
       (← q r"&0 < x <=> &0 <= x /\ ~(x = &0)")] THEN
       ASM_SIMP_TAC [SETDIST_EQ_0_CLOSED_COMPACT, CLOSED_SING, COMPACT_PATH_IMAGE,
                    PATH_IMAGE_NONEMPTY] THEN
       CONJ_TAC THENL [ASM SET_TAC [], REPEAT STRIP_TAC] THEN
       REWRITE_TAC [← ONCE_REWRITE_RULE [DIST_SYM] (← GSYM dist)] THEN
       MATCH_MP_TAC SETDIST_LE_DIST THEN REWRITE_TAC [path_image] THEN
       ASM SET_TAC [],
       MP_TAC (← ISPECL [← q r"g:real^1->complex", ← q r"min d e"]
        PATH_APPROX_VECTOR_POLYNOMIAL_FUNCTION) THEN
       ASM_REWRITE_TAC [REAL_LT_MIN] THEN MATCH_MP_TAC MONO_EXISTS THEN
       X_GEN_TAC (← q r"p:real^1->complex") THEN STRIP_TAC THEN
       ONCE_REWRITE_TAC [NORM_SUB] THEN
       ASM_SIMP_TAC [VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
       MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
        [REWRITE_TAC [path_image, IN_IMAGE] THEN
         ASM_MESON_TAC [NORM_SUB, REAL_NOT_LT],
         DISCH_TAC THEN MATCH_MP_TAC (← ExceptT.mk (COMPLEX_FIELD
          (← q r"!w'. ~(a * b * c = Cx(&0)) /\ w' = w /\ w' = Cx(&1) / (a * b * c) * i
                ==> i = a * b * c * w"))) THEN
         EXISTS_TAC (← q r"winding_number(p,z)") THEN
         REWRITE_TAC [CX_2PII_NZ] THEN CONJ_TAC THENL
          [MATCH_MP_TAC WINDING_NUMBER_NEARBY_PATHS_EQ, ALL_TAC] THEN
         ASM_SIMP_TAC [WINDING_NUMBER_VALID_PATH, VALID_PATH_IMP_PATH,
                      VALID_PATH_VECTOR_POLYNOMIAL_FUNCTION] THEN
         ASM_MESON_TAC [REAL_LTE_TRANS, NORM_SUB]]])

  let WINDING_NUMBER_FROM_INNERPATH ← prove
   r"!c1 c2 c a b z:complex d.
        ~(a = b) /\
        simple_path c1 /\ pathstart c1 = a /\ pathfinish c1 = b /\
        simple_path c2 /\ pathstart c2 = a /\ pathfinish c2 = b /\
        simple_path c /\ pathstart c = a /\ pathfinish c = b /\
        path_image c1 INTER path_image c2 = {a,b} /\
        path_image c1 INTER path_image c = {a,b} /\
        path_image c2 INTER path_image c = {a,b} /\
        ~(path_image c INTER inside(path_image c1 UNION path_image c2) = {}) /\
        z IN inside(path_image c1 UNION path_image c) /\
        winding_number(c1 ++ reversepath c,z) = d /\ ~(d = Cx(&0))
        ==> z IN inside(path_image c1 UNION path_image c2) /\
            winding_number(c1 ++ reversepath c2,z) = d"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"c1:real^1->complex", ← q r"c2:real^1->complex",
                   ← q r"c:real^1->complex", ← q r"a:complex", ← q r"b:complex"]
           SPLIT_INSIDE_SIMPLE_CLOSED_CURVE) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"winding_number(c1 ++ reversepath c,z) = d") THEN
    MP_TAC (← ISPECL
     [← q r"c ++ reversepath(c2:real^1->complex)", ← q r"z:complex"]
     WINDING_NUMBER_ZERO_IN_OUTSIDE) THEN
