    (BConnected3 : Connected3) (BNbhdBase : NbhdBase) (BLocCompact2 : LocCompact2)
    (BRealTop1 : RealTop1) (BRealConn1 : RealConn1) (BLC1 : LC1) (BLC2 : LC2) (BCMS1 : CMS1)
    (BBAI2 : BAI2) : ExceptT String IO SIER := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_DIFF, IN_ELIM_THM, IN_INTER, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_POS, .. } := D.core3
  let { UNIONS_IMAGE, UNIONS_SUBSET, UNIONS_UNION, UNION_COMM, pairwise, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { REAL_INTERVAL_NE_EMPTY, .. } := D.misc
  let { COUNTABLE_IMAGE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, OPEN_IN_SUBTOPOLOGY_ALT, SUBTOPOLOGY_TOPSPACE,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_CLOSED_IN, CLOSURE_OF_EQ, .. } := BClosure
  let { INTERIOR_OF_SUBSET, INTERIOR_OF_TOPSPACE, OPEN_IN_INTERIOR_OF, interior_of, .. } :=
    BInterior
  let { CLOSED_IN_FRONTIER_OF, FRONTIER_OF_EQ_EMPTY, FRONTIER_OF_OPEN_IN_STRADDLE_INTER,
        FRONTIER_OF_SUBSET_CLOSED_IN, FRONTIER_OF_SUBSET_TOPSPACE,
        INTERIOR_OF_UNION_FRONTIER_OF, frontier_of, .. } := BFrontier
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_SPACE_CLOPEN_IN, CONNECTED_SPACE_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_INTER_FRONTIER_OF, .. } := BConnected3
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, .. } := BLocCompact2
  let { REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } :=
    BRealTop1
  let { CONNECTED_IN_EUCLIDEANREAL_INTERVAL, .. } := BRealConn1
  let { locally_connected_space, .. } := BLC1
  let { LOCALLY_CONNECTED_REAL_INTERVAL, .. } := BLC2
  let { COMPLETELY_METRIZABLE_SPACE_CLOSED_IN, COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL, .. } :=
    BCMS1
  let { BAIRE_CATEGORY_ALT, .. } := BBAI2
  -- @@SCOPE END

  let LOCALLY_CONNECTED_NOT_COUNTABLE_CLOSED_UNION ← do
    let lemma ← prove
     r"UNIONS (IMAGE f s UNION IMAGE g s) =
     UNIONS (IMAGE (\x. f x UNION g x) s)"
     (REWRITE_TAC [UNIONS_UNION, UNIONS_IMAGE] THEN SET_TAC [])
    prove
     r"!top u:(A->bool)->bool.
        ~(topspace top = {}) /\
        connected_space top /\
        locally_connected_space top /\
        (completely_metrizable_space top \/
         locally_compact_space top /\ hausdorff_space top) /\
        COUNTABLE u /\ pairwise DISJOINT u /\
        (!c. c IN u ==> closed_in top c /\ ~(c = {})) /\
        UNIONS u = topspace top
         ==> u = {topspace top}"
     (REWRITE_TAC [REAL_CLOSED_IN] THEN REPEAT GEN_TAC THEN
      DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      ABBREV_TAC (← q r"v = IMAGE (\c:A->bool. top frontier_of c) u") THEN
      ABBREV_TAC (← q r"b:A->bool = UNIONS v") THEN
      MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(b:A->bool) SUBSET topspace top") ASSUME_TAC THENL
       [EXPAND_TAC "b" THEN REWRITE_TAC [UNIONS_SUBSET] THEN
        EXPAND_TAC "v" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
        REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, FRONTIER_OF_SUBSET_TOPSPACE],
        ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"subtopology top (b:A->bool)", ← q r"v:(A->bool)->bool"]
            BAIRE_CATEGORY_ALT) THEN
      ASM_REWRITE_TAC [] THEN EXPAND_TAC "v" THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, NOT_IMP] THEN CONJ_TAC THENL
       [ALL_TAC,
        MP_TAC (← ISPEC (← q r"subtopology top (b:A->bool)")
            INTERIOR_OF_TOPSPACE) THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [TOPSPACE_MTOPOLOGY, ← SET_RULE (← q
         r"s SUBSET u ==> u INTER s = s")] THEN
        DISCH_THEN SUBST1_TAC THEN EXPAND_TAC "b" THEN
        EXPAND_TAC "v" THEN MATCH_MP_TAC (← SET_RULE (← q
         r"(!s. s IN u /\ s SUBSET UNIONS u /\ f s = {} ==> s = {}) /\
          ~(UNIONS u = {})
          ==> ~(UNIONS(IMAGE f u) = {})")) THEN
        ASM_SIMP_TAC [IMP_CONJ, FRONTIER_OF_EQ_EMPTY, ← GSYM TOPSPACE_MTOPOLOGY] THEN
        ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
        X_GEN_TAC (← q r"s:A->bool") THEN REPEAT STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_SPACE_CLOPEN_IN]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"s:A->bool")) THEN
        ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_SIMP_TAC [] THEN
        ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_THEN SUBST_ALL_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q
         r"~(u = {a}) ==> a IN u ==> ?b. b IN u /\ ~(b = a)"))) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"topspace top:A->bool", ← q r"t:A->bool"]) THEN
        ASM SET_TAC []] THEN
      SUBGOAL_THEN (← q r"closed_in top (b:A->bool)") ASSUME_TAC THENL
       [SUBGOAL_THEN
         (← q r"b = topspace top DIFF
              UNIONS (IMAGE (\c:A->bool. top interior_of c) u)")
        SUBST1_TAC THENL
         [MAP_EVERY EXPAND_TAC ["b", "v"] THEN MATCH_MP_TAC (← SET_RULE (← q
           r"s UNION t = u /\ DISJOINT s t ==> s = u DIFF t")) THEN
          CONJ_TAC THENL
           [REWRITE_TAC [← GSYM UNIONS_UNION, lemma] THEN
            ONCE_REWRITE_TAC [UNION_COMM] THEN
            REWRITE_TAC [INTERIOR_OF_UNION_FRONTIER_OF] THEN
            FIRST_X_ASSUM (fun th => tactic_of do
              pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
            AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
             r"(!x. x IN s ==> f x = x) ==> IMAGE f s = s")) THEN
            ASM_SIMP_TAC [CLOSURE_OF_EQ],
            REWRITE_TAC [← SET_RULE (← q
             r"DISJOINT (UNIONS s) (UNIONS t) <=>
              !x. x IN s ==> !y. y IN t ==> DISJOINT x y")] THEN
            REWRITE_TAC [FORALL_IN_IMAGE] THEN
            X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
            X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
            ASM_CASES_TAC (← q r"s:A->bool = t") THENL
             [ASM_REWRITE_TAC [frontier_of] THEN SET_TAC [],
              FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise])] THEN
            DISCH_THEN (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN
            ASM_SIMP_TAC [frontier_of, CLOSURE_OF_CLOSED_IN] THEN
            MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"]
              INTERIOR_OF_SUBSET) THEN
            SET_TAC []],
          MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
          MATCH_MP_TAC OPEN_IN_UNIONS THEN
          REWRITE_TAC [FORALL_IN_IMAGE, OPEN_IN_INTERIOR_OF]],
          ALL_TAC] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
                       LOCALLY_COMPACT_SPACE_CLOSED_SUBSET,
                       HAUSDORFF_SPACE_SUBTOPOLOGY],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
        REWRITE_TAC [CLOSED_IN_FRONTIER_OF, FRONTIER_OF_SUBSET_TOPSPACE] THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [EXTENSION, interior_of, IN_ELIM_THM, NOT_IN_EMPTY] THEN
      X_GEN_TAC (← q r"a:A") THEN
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC, IN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(a:A) IN top frontier_of s") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(a:A) IN s") ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"(a:A) IN top frontier_of s") THEN
        REWRITE_TAC [frontier_of, IN_DIFF] THEN ASM_SIMP_TAC [CLOSURE_OF_CLOSED_IN],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_connected_space]) THEN
      DISCH_THEN (MP_TAC o GEN_REWRITE_RULE id [NEIGHBOURHOOD_BASE_OF]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"a:A"]) THEN
      REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, SUBTOPOLOGY_TOPSPACE] THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"c:A->bool"] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool", ← q r"w:A->bool"]
            FRONTIER_OF_OPEN_IN_STRADDLE_INTER) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?t:A->bool. t IN u /\ ~(t = s) /\ ~(w INTER t = {})")
      STRIP_ASSUME_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
        REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"] o
        GEN_REWRITE_RULE id [pairwise]) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool", ← q r"t:A->bool"]
            CONNECTED_IN_INTER_FRONTIER_OF) THEN
      ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"top frontier_of (s:A->bool) SUBSET s /\
        top frontier_of (t:A->bool) SUBSET t")
      STRIP_ASSUME_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_SIMP_TAC [FRONTIER_OF_SUBSET_CLOSED_IN])

  let REAL_SIERPINSKI_LEMMA ← prove
   r"!a b u.
        a <= b /\
        COUNTABLE u /\ pairwise DISJOINT u /\
        (!c. c IN u ==> real_closed c /\ ~(c = {})) /\
        UNIONS u = real_interval[a,b]
         ==> u = {real_interval[a,b]}"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"subtopology euclideanreal (real_interval[a,b])")
      LOCALLY_CONNECTED_NOT_COUNTABLE_CLOSED_UNION) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [REAL_INTERVAL_NE_EMPTY, REAL_POS] THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_SUBTOPOLOGY,
                  CONNECTED_IN_EUCLIDEANREAL_INTERVAL,
                  LOCALLY_CONNECTED_REAL_INTERVAL] THEN
    CONJ_TAC THENL
     [DISJ1_TAC THEN MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_CLOSED_IN THEN
      REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL] THEN
      REWRITE_TAC [← GSYM REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL],
      REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
      ASM_SIMP_TAC [← GSYM REAL_CLOSED_IN] THEN ASM SET_TAC []])

  return { LOCALLY_CONNECTED_NOT_COUNTABLE_CLOSED_UNION, REAL_SIERPINSKI_LEMMA }

/- ------------------------------------------------------------------------- -/
/- Size bounds on connected or path-connected spaces.  (metric.ml 40816-41047) -/
/- ------------------------------------------------------------------------- -/

structure SIZE where
  CONNECTED_SPACE_IMP_CARD_GE_ALT : thm
  CONNECTED_SPACE_IMP_CARD_GE_GEN : thm
  CONNECTED_SPACE_IMP_CARD_GE : thm
  CONNECTED_SPACE_IMP_INFINITE_GEN : thm
  CONNECTED_SPACE_IMP_INFINITE : thm
  CONNECTED_SPACE_IMP_INFINITE_ALT : thm
  PATH_CONNECTED_SPACE_IMP_CARD_GE : thm
  CONNECTED_SPACE_IMP_UNCOUNTABLE : thm
  PATH_CONNECTED_SPACE_IMP_UNCOUNTABLE : thm
  deriving Inhabited

@[nospecialize]
def setupSIZE [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BCompact1 : Compact1) (BT1a : T1a)
    (BT1b : T1b) (BHausdorff1 : Hausdorff1) (BLindelof : Lindelof) (BConnected1 : Connected1)
    (BConnected3 : Connected3) (BNbhdBase : NbhdBase) (BRegular1 : Regular1)
    (BRealTop1 : RealTop1) (BRealConn1 : RealConn1) (BPaths1 : Paths1) (BPaths2 : Paths2)
    (BNormal1 : Normal1) (BUrysohn2 : Urysohn2) (BNormal3 : Normal3)
    (BCRegular1 : CRegular1) (BSIER : SIER) : ExceptT String IO SIZE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_SYM, DEPENDENT_CHOICE, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_UNIV, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_IMAGE,
        IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_C, LE_SUC_LT, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IMP, PAIRWISE_IMAGE, PAIRWISE_MONO, .. } := D.core2
  let { REAL_LT_01, REAL_LT_IMP_LE, REAL_POS, .. } := D.core3
  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET, TRANSITIVE_STEPWISE_LE, UNIONS_DELETE_EMPTY,
        UNIONS_IMAGE, WLOG_LT, le_c, pairwise, .. } := D.core4
  let { EQ_SYM_EQ, FORALL_AND_THM, NOT_EXISTS_THM, .. } := D.core5
  let { ENDS_IN_REAL_INTERVAL, ENDS_IN_UNIT_REAL_INTERVAL, IN_REAL_INTERVAL,
        REAL_INTERVAL_NE_EMPTY, is_realinterval, .. } := D.misc
  let { CARD_EQ_IMP_LE, CARD_EQ_REAL_SUBSET, CARD_EQ_SYM, CARD_LE_SUBSET, CARD_LE_TRANS,
        CARD_NOT_LE, COUNTABLE_DELETE, COUNTABLE_IMAGE, COUNTABLE_IMP_CARD_LT_REAL,
        INFINITE_CARD_LE, .. } := D.lib
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_TRANS_FULL, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } :=
    BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { INFINITE_PERFECT_SET_GEN, .. } := BT1b
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_SUBTOPOLOGY, T1_OR_HAUSDORFF_SPACE, .. } :=
    BHausdorff1
  let { COUNTABLE_IMP_LINDELOF_SPACE, .. } := BLindelof
  let { CONNECTED_IN_TOPSPACE, CONNECTED_SPACE_CLOPEN_IN, CONNECTED_SPACE_SUBTOPOLOGY, .. } :=
    BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, CONNECTED_IN_IMP_PERFECT_GEN, .. } := BConnected3
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  let { REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONNECTED_IN_EUCLIDEANREAL, .. } := BRealConn1
  let { path_connected_space, path_in, .. } := BPaths1
  let { COMPACT_IN_PATH_IMAGE, CONNECTED_IN_PATH_IMAGE, PATH_IMAGE_SUBSET_TOPSPACE, .. } :=
    BPaths2
  let { COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE, .. } := BNormal1
  let { NORMAL_SPACE_EQ_URYSOHN, .. } := BUrysohn2
  let { REGULAR_LINDELOF_IMP_NORMAL_SPACE, .. } := BNormal3
  let { NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN, completely_regular_space, .. } := BCRegular1
  let { REAL_SIERPINSKI_LEMMA, .. } := BSIER
  -- @@SCOPE END

  let CONNECTED_SPACE_IMP_CARD_GE_ALT ← prove
   r"!top s:A->bool.
        connected_space top /\ completely_regular_space top /\
        closed_in top s /\ ~(s = {}) /\ ~(s = topspace top)
        ==> (:real) <=_c topspace top"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    SUBGOAL_THEN (← q r"?a:A. a IN topspace top /\ ~(a IN s)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    TRANS_TAC CARD_LE_TRANS (← q r"real_interval[&0,&1]") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      MATCH_MP_TAC CARD_EQ_REAL_SUBSET THEN
      MAP_EVERY EXISTS_TAC [← q r"&0:real", ← q r"&1:real"] THEN
      ASM_SIMP_TAC [IN_REAL_INTERVAL, REAL_LT_01, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [completely_regular_space]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s:A->bool", ← q r"a:A"]) THEN
    ASM_REWRITE_TAC [LE_C, IN_DIFF, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"t:real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    FIRST_ASSUM
     (MP_TAC o SPEC (← q r"topspace top:A->bool") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
    ASM_REWRITE_TAC [CONNECTED_IN_TOPSPACE] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL, is_realinterval] THEN
    REWRITE_TAC [IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"&0:real", ← q r"&1:real"] THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CONNECTED_SPACE_IMP_CARD_GE_GEN ← prove
   r"!top s t:A->bool.
        connected_space top /\ normal_space top /\
        closed_in top s /\ closed_in top t /\
        ~(s = {}) /\ ~(t = {}) /\ DISJOINT s t
        ==> (:real) <=_c topspace top"
   (REPEAT STRIP_TAC THEN
    TRANS_TAC CARD_LE_TRANS (← q r"real_interval[&0,&1]") THEN CONJ_TAC THENL
     [MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
      MATCH_MP_TAC CARD_EQ_REAL_SUBSET THEN
      MAP_EVERY EXISTS_TAC [← q r"&0:real", ← q r"&1:real"] THEN
      ASM_SIMP_TAC [IN_REAL_INTERVAL, REAL_LT_01, REAL_LT_IMP_LE],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NORMAL_SPACE_EQ_URYSOHN]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN
    ASM_REWRITE_TAC [LE_C, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"t:real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN ONCE_REWRITE_TAC [CONJ_SYM] THEN
    FIRST_ASSUM
     (MP_TAC o SPEC (← q r"topspace top:A->bool") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
    ASM_REWRITE_TAC [CONNECTED_IN_TOPSPACE] THEN
    REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL, is_realinterval] THEN
    REWRITE_TAC [IN_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"&0:real", ← q r"&1:real"] THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CONNECTED_SPACE_IMP_CARD_GE ← prove
   r"!top:A topology.
        connected_space top /\ normal_space top /\
        (t1_space top \/ hausdorff_space top) /\
        ~(?a. topspace top SUBSET {a})
        ==> (:real) <=_c topspace top"
   (GEN_TAC THEN REWRITE_TAC [T1_OR_HAUSDORFF_SPACE] THEN STRIP_TAC THEN
    MATCH_MP_TAC CONNECTED_SPACE_IMP_CARD_GE_ALT THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q
     r"~(?a. s SUBSET {a}) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)"))) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"{a:A}") THEN
    ASM_SIMP_TAC [NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING], ASM SET_TAC []])

  let CONNECTED_SPACE_IMP_INFINITE_GEN ← prove
   r"!top:A topology.
        connected_space top /\ t1_space top /\
        ~(?a. topspace top SUBSET {a})
        ==> INFINITE(topspace top)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INFINITE_PERFECT_SET_GEN THEN
    EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONNECTED_IN_IMP_PERFECT_GEN THEN
    ASM_REWRITE_TAC [CONNECTED_IN_TOPSPACE] THEN ASM SET_TAC [])

  let CONNECTED_SPACE_IMP_INFINITE ← prove
   r"!top:A topology.
        connected_space top /\ hausdorff_space top /\
        ~(?a. topspace top SUBSET {a})
        ==> INFINITE(topspace top)"
   (MESON_TAC [CONNECTED_SPACE_IMP_INFINITE_GEN, HAUSDORFF_IMP_T1_SPACE])

  let CONNECTED_SPACE_IMP_INFINITE_ALT ← prove
   r"!top s:A->bool.
        connected_space top /\ regular_space top /\
        closed_in top s /\ ~(s = {}) /\ ~(s = topspace top)
        ==> INFINITE(topspace top)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    SUBGOAL_THEN (← q r"?a:A. a IN topspace top /\ ~(a IN s)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?u. (!n. DISJOINT (u n) s /\ (a:A) IN u n /\ open_in top (u n)) /\
          (!n. u(SUC n) PSUBSET u n)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"topspace top DIFF s:A->bool") THEN
        ASM_SIMP_TAC [IN_DIFF, OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
        SET_TAC [],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
      REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"v:A->bool", ← q r"a:A"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"u:A->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"c:A->bool = u") THENL
       [FIRST_X_ASSUM SUBST_ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool") o
          GEN_REWRITE_RULE id [CONNECTED_SPACE_CLOPEN_IN]) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      SUBGOAL_THEN (← q r"!n. ?x:A. x IN u n /\ ~(x IN u(SUC n))") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [SKOLEM_THM]] THEN
      REWRITE_TAC [INFINITE_CARD_LE, le_c, IN_UNIV, FORALL_AND_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"f:num->A") THEN STRIP_TAC THEN
      CONJ_TAC THENL [ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC WLOG_LT THEN
      SUBGOAL_THEN (← q r"!m n. m < n ==> ~((f:num->A) m IN u n)") MP_TAC THENL
       [X_GEN_TAC (← q r"m:num"), ASM SET_TAC []] THEN
      REWRITE_TAC [← GSYM LE_SUC_LT] THEN
      SUBGOAL_THEN (← q r"!m n. m <= n ==> (u:num->A->bool) n SUBSET u m")
      MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC []])

  let PATH_CONNECTED_SPACE_IMP_CARD_GE ← prove
   r"!top:A topology.
        path_connected_space top /\ hausdorff_space top /\
        ~(?a. topspace top SUBSET {a})
        ==> (:real) <=_c topspace top"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q
     r"~(?a. s SUBSET {a}) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)"))) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"a:A", ← q r"b:A"] o
      REWRITE_RULE [path_connected_space]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CARD_LE_SUBSET o
      MATCH_MP PATH_IMAGE_SUBSET_TOPSPACE) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CARD_LE_TRANS) THEN
    MP_TAC (← ISPEC
     (← q r"subtopology (top:A topology)
       (IMAGE g (topspace (subtopology euclideanreal (real_interval [&0,&1]))))")
     CONNECTED_SPACE_IMP_CARD_GE) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PATH_IMAGE_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
    SIMP_TAC [← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
    DISCH_TAC THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_SUBTOPOLOGY, CONNECTED_IN_PATH_IMAGE] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [COMPACT_IN_PATH_IMAGE, COMPACT_SPACE_SUBTOPOLOGY],
      MP_TAC ENDS_IN_UNIT_REAL_INTERVAL THEN ASM SET_TAC []])

  let CONNECTED_SPACE_IMP_UNCOUNTABLE ← prove
   r"!top:A topology.
        connected_space top /\ regular_space top /\ hausdorff_space top /\
        ~(?a. topspace top SUBSET {a})
        ==> ~COUNTABLE(topspace top)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"top:A topology") CONNECTED_SPACE_IMP_CARD_GE) THEN
    ASM_SIMP_TAC [NOT_IMP, CARD_NOT_LE, COUNTABLE_IMP_CARD_LT_REAL] THEN
    MATCH_MP_TAC REGULAR_LINDELOF_IMP_NORMAL_SPACE THEN
    ASM_SIMP_TAC [COUNTABLE_IMP_LINDELOF_SPACE])

  let PATH_CONNECTED_SPACE_IMP_UNCOUNTABLE ← prove
   r"!top:A topology.
        path_connected_space top /\ t1_space top /\
        ~(?a. topspace top SUBSET {a})
        ==> ~COUNTABLE(topspace top)"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q
     r"~(?a. s SUBSET {a}) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)"))) THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:A", ← q r"b:A"] o
      REWRITE_RULE [path_connected_space]) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM, path_in] THEN
    X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"&0:real", ← q r"&1:real",
      ← q r"{{x | x IN topspace(subtopology euclideanreal (real_interval[&0,&1])) /\
            (g:real->A) x IN {a}} |
       a IN topspace top} DELETE {}"] REAL_SIERPINSKI_LEMMA) THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, COUNTABLE_DELETE] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, IN_DELETE] THEN
    REWRITE_TAC [REAL_POS, NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC (← MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] PAIRWISE_MONO)
       (← SET_RULE (← q r"s DELETE a SUBSET s"))) THEN
      REWRITE_TAC [PAIRWISE_IMAGE] THEN REWRITE_TAC [pairwise] THEN SET_TAC [],
      X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IMP_IMP] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [REAL_CLOSED_IN] THEN
      MATCH_MP_TAC CLOSED_IN_TRANS_FULL THEN
      EXISTS_TAC (← q r"real_interval[&0,&1]") THEN
      REWRITE_TAC [← GSYM REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CLOSED_IN_CONTINUOUS_MAP_PREIMAGE)) THEN
      ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING],
      FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
      REWRITE_TAC [UNIONS_IMAGE, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [UNIONS_DELETE_EMPTY, UNIONS_IMAGE] THEN ASM SET_TAC [],
      MATCH_MP_TAC (← SET_RULE (← q
       r"!a b. a IN s /\ b IN s /\ ~(f a = z) /\ ~(f b = z) /\ ~(f a = f b)
              ==> ~(IMAGE f s DELETE z = {c})")) THEN
      MAP_EVERY EXISTS_TAC [← q r"a:A", ← q r"b:A"] THEN
      ASM_REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"(p /\ q ==> r) /\ p /\ q ==> p /\ q /\ r")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY]] THEN
      CONJ_TAC THENL [EXISTS_TAC (← q r"&0:real"), EXISTS_TAC (← q r"&1:real")] THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_SING] THEN
      REWRITE_TAC [ENDS_IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY, REAL_POS]])

  return { CONNECTED_SPACE_IMP_CARD_GE_ALT, CONNECTED_SPACE_IMP_CARD_GE_GEN,
           CONNECTED_SPACE_IMP_CARD_GE, CONNECTED_SPACE_IMP_INFINITE_GEN,
           CONNECTED_SPACE_IMP_INFINITE, CONNECTED_SPACE_IMP_INFINITE_ALT,
           PATH_CONNECTED_SPACE_IMP_CARD_GE, CONNECTED_SPACE_IMP_UNCOUNTABLE,
           PATH_CONNECTED_SPACE_IMP_UNCOUNTABLE }

/- ------------------------------------------------------------------------- -/
/- The Tychonoff embedding.  (metric.ml 41049-41179)                         -/
