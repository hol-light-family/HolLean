          REWRITE_TAC [real_pow, real_div, REAL_INV_MUL] THEN
          REWRITE_TAC [REAL_MUL_AC] THEN REWRITE_TAC [REAL_LE_REFL]]]], ALL_TAC] THEN
      /- Step 3: Take d = dl 0 -/
