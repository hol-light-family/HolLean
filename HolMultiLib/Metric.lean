        COMPACT_SPACE_SUBTOPOLOGY, compact_in, .. } := BCompact1
  let { COMPACT_IN_DISCRETE_TOPOLOGY, .. } := BCompact2
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { HAUSDORFF_IMP_KC_SPACE, .. } := BKC1
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, .. } := BNbhdBase
  let { LOCALLY_COMPACT_IMP_KC_EQ_HAUSDORFF_SPACE, NEIGHBOURHOOD_BASE_OF_CLOSED_IN,
