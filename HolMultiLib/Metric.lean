    (BOpenClosed1 : OpenClosed1) (BProduct1 : Product1) (BProduct2 : Product2)
    (BHomeo1 : Homeo1) (BEmbedding : Embedding) (BCountability : Countability)
    (BMetrizable : Metrizable) (BRegular1 : Regular1) (BRealTop1 : RealTop1)
    (BUrysohn : Urysohn) (BHerNormal : HerNormal) (BURY1 : URY1) :
    ExceptT String IO URY2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC, ETA_CONV, .. } := D
  let { EXTENSION, EXTENSIONAL_UNIV, .. } := D.core1
  let { INTER_UNIV, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, IN_UNIV,
        LEFT_IMP_EXISTS_THM, NUMPAIR_DEST, .. } := D.core2
  let { REAL_POS, .. } := D.core3
  let { SUBSET, SUBSET_REFL, SUBSET_TRANS, o_DEF, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { COUNTABLE_AS_IMAGE_SUBSET, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN, OPEN_IN_SUBSET,
        OPEN_IN_UNIONS, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET_INTER, .. } :=
    BClosure
  let { CONTINUOUS_MAP_CONST, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { open_map, .. } := BOpenClosed1
  let { TOPSPACE_PRODUCT_TOPOLOGY_ALT, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP, .. } := BHomeo1
  let { embedding_map, .. } := BEmbedding
  let { second_countable, .. } := BCountability
  let { METRIZABLE_IMP_HAUSDORFF_SPACE, .. } := BMetrizable
  let { METRIZABLE_IMP_REGULAR_SPACE, regular_space, .. } := BRegular1
  let { REAL_OPEN_HALFSPACE_GT, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { URYSOHN_LEMMA, .. } := BUrysohn
  let { REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE, .. } := BHerNormal
  let { EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE, METRIZABLE_PRODUCT_EUCLIDEANREAL_NUM,
        SEPARATING_FUNCTIONS_INJECTIVE, .. } := BURY1
  -- @@SCOPE END

  let URYSOHN_METRIZATION ← do
    -- Helper lemma: construct countable family of separating functions
    let CONSTRUCT_SEPARATING_FUNCTIONS ← prove
     r"!top:A topology.
          regular_space top /\ second_countable top /\ normal_space top
          ==> ?fs:(num->A->real).
                (!n. continuous_map
                       (top, subtopology euclideanreal (real_interval[&0,&1]))
                       (fs n)) /\
                (!x0 u. open_in top u /\ x0 IN u
                        ==> ?n. (fs n) x0 > &0 /\
                                (!x. x IN topspace top /\ ~(x IN u)
                                     ==> (fs n) x = &0))"
     (GEN_TAC THEN STRIP_TAC THEN
      /- Extract a countable basis -/
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [second_countable]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"cbasis:((A->bool)->bool)") STRIP_ASSUME_TAC) THEN
      /- Enumerate the basis: use countability to get a sequence -/
      SUBGOAL_THEN
       (← q r"?b:num->A->bool. !u. u IN cbasis ==> ?n. b n = u")
      STRIP_ASSUME_TAC THENL
      [MP_TAC (← ISPEC (← q r"cbasis:(A->bool)->bool") COUNTABLE_AS_IMAGE_SUBSET) THEN
       ASM_REWRITE_TAC [] THEN
       REWRITE_TAC [SUBSET, IN_IMAGE, IN_UNIV] THEN
       MESON_TAC [],
       ALL_TAC] THEN
      /- For pairs (n,m), construct functions using Urysohn lemma -/
      /- g always gives continuous functions; properties hold when
         open(b m) /\ closure(b n) SUBSET b m -/
      SUBGOAL_THEN
       (← q r"?g:(num#num)->A->real.
          (!n m. continuous_map
                   (top, subtopology euclideanreal (real_interval[&0,&1]))
                   (g(n,m))) /\
          (!n m. open_in top (b m) /\ top closure_of (b n) SUBSET (b m)
                 ==> (!x. x IN topspace top /\ x IN (b n) ==> g(n,m) x = &1) /\
                     (!x. x IN topspace top DIFF (b m) ==> g(n,m) x = &0))")
      STRIP_ASSUME_TAC THENL
      [/- Construct g by proving existence for each pair, then Skolemizing -/
       /- For each (n,m): if condition holds use Urysohn, else use constant -/
       SUBGOAL_THEN
        (← q r"!n m. ?f.
           continuous_map ((top:A topology), subtopology euclideanreal
             (real_interval[&0,&1])) f /\
           (open_in top ((b:num->A->bool) m) /\ top closure_of (b n) SUBSET (b m)
            ==> (!x. x IN topspace top /\ x IN (b n) ==> f x = &1) /\
                (!x. x IN topspace top DIFF (b m) ==> f x = &0))")
       MP_TAC THENL
       [/- Inner proof: for each (n,m), construct a suitable function -/
        REPEAT GEN_TAC THEN
        ASM_CASES_TAC (← q r"open_in top ((b:num->A->bool) m) /\
          top closure_of (b n) SUBSET (b m)") THENL
        [/- TRUE: condition holds, use Urysohn lemma -/
         FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC) THEN
         /- Apply Urysohn lemma with a=0, b=1 on (topspace DIFF b m,
            closure_of (b n)) -/
         MP_TAC (← ISPECL [← q r"top:A topology",
                           ← q r"topspace top DIFF (b:num->A->bool) m",
                           ← q r"top closure_of (b:num->A->bool) n",
                           ← q r"&0", ← q r"&1"] URYSOHN_LEMMA) THEN
         ASM_SIMP_TAC [REAL_POS, CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE,
           CLOSED_IN_CLOSURE_OF] THEN
         ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"f:A->real") STRIP_ASSUME_TAC) THEN
         EXISTS_TAC (← q r"f:A->real") THEN
         ASM_REWRITE_TAC [] THEN
         /- After ASM_REWRITE_TAC,
            the goal is: forall x. x IN topspace /\ x IN b n ==> f x = &1 -/
         /- Use CLOSURE_OF_SUBSET_INTER: topspace INTER (b n) SUBSET closure_of
           (b n), and f = 1 on closure -/
         X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
         FIRST_X_ASSUM MATCH_MP_TAC THEN
         ASM_MESON_TAC [CLOSURE_OF_SUBSET_INTER, SUBSET, IN_INTER],
         /- FALSE: condition doesn't hold, use constant 1/2 -/
         EXISTS_TAC (← q r"(\x:A. &1 / &2)") THEN CONJ_TAC THENL
         [REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_SUBTOPOLOGY, IN_INTER,
                       IN_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
          REAL_ARITH_TAC,
          ASM_REWRITE_TAC []]],
        ALL_TAC] THEN
       /- Use the proved statement to construct g directly -/
       DISCH_TAC THEN
       /- Use Hilbert choice to define g as the witness for each pair -/
       EXISTS_TAC
        (← q r"\(n:num,m:num). @f. continuous_map ((top:A topology), subtopology
          euclideanreal (real_interval[&0,&1])) f /\
           (open_in top ((b:num->A->bool) m) /\ top closure_of (b n) SUBSET (b m)
            ==> (!x. x IN topspace top /\ x IN (b n) ==> f x = &1) /\
                (!x. x IN topspace top DIFF (b m) ==> f x = &0))") THEN
       REWRITE_TAC [] THEN CONJ_TAC THENL
       [/- First conjunct: continuity of @f. P f /\ Q f -/
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"m:num"] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"m:num"]) THEN
        DISCH_THEN (MP_TAC o SELECT_RULE) THEN SIMP_TAC [],
        /- Second conjunct: properties when condition holds -/
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"m:num"] THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"m:num"]) THEN
        DISCH_THEN (MP_TAC o SELECT_RULE) THEN ASM_SIMP_TAC []],
       ALL_TAC] THEN
      /- Enumerate pairs (num#num) as num to get final sequence -/
      /- Use g composed with (NUMFST, NUMSND) to get fs:num->A->real -/
      SUBGOAL_THEN
       (← q r"?fs:num->A->real.
          (!n. continuous_map
                 (top, subtopology euclideanreal (real_interval[&0,&1]))
                 (fs n)) /\
          (!x0 u. open_in top u /\ x0 IN u
                  ==> ?k. (fs k) x0 > &0 /\
                          (!x. x IN topspace top /\
                            ~(x IN u) ==> (fs k) x = &0))")
      MP_TAC THENL
      [EXISTS_TAC (← q r"\(k:num) (x:A). (g:num#num->A->real) (NUMFST k, NUMSND k) x")
        THEN
       CONJ_TAC THENL
       [GEN_TAC THEN BETA_TAC THEN
        CONV_TAC (RAND_CONV ETA_CONV) THEN
        FIRST_X_ASSUM (MATCH_ACCEPT_TAC o SPECL [← q r"NUMFST (n:num)", ← q r"NUMSND
          (n:num)"]),
        MAP_EVERY X_GEN_TAC [← q r"x0:A", ← q r"u:A->bool"] THEN STRIP_TAC THEN
        /- Step 1: Find basis element V1 with x0 IN V1 SUBSET u (will be b m) -/
        SUBGOAL_THEN (← q r"?V1:A->bool. V1 IN cbasis /\ x0 IN V1 /\
          V1 SUBSET u") MP_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"V1:A->bool") STRIP_ASSUME_TAC) THEN
        /- V1 is a basis element, hence open -/
        SUBGOAL_THEN (← q r"open_in top (V1:A->bool)") ASSUME_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        /- Step 2: Use regularity at x0 with V1 to get W with closure(W) SUBSET
          V1 -/
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [regular_space]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"topspace top DIFF V1:A->bool", ← q r"x0:A"]) THEN
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN,
          IN_DIFF] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"W:A->bool") (X_CHOOSE_THEN (← q r"W':A->bool")
          STRIP_ASSUME_TAC)) THEN
        /- W and W' are disjoint opens with x0
           IN W and (topspace - V1) SUBSET W' -/
        /- So closure(W) SUBSET topspace - W' SUBSET V1 -/
        SUBGOAL_THEN (← q r"(W:A->bool) SUBSET topspace top") ASSUME_TAC THENL
        [ASM_MESON_TAC [OPEN_IN_SUBSET], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(W:A->bool) SUBSET topspace top DIFF W'") ASSUME_TAC THENL
        [ASM SET_TAC [], ALL_TAC] THEN
        /- topspace - W' SUBSET V1 (from complement inclusion) -/
        SUBGOAL_THEN (← q r"topspace top DIFF W':A->bool SUBSET V1") ASSUME_TAC THENL
        [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"top closure_of (W:A->bool) SUBSET V1") ASSUME_TAC THENL
        [ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_OF_MINIMAL, CLOSED_IN_DIFF,
          CLOSED_IN_TOPSPACE],
         ALL_TAC] THEN
        /- Step 3: Find basis element U with x0 IN U SUBSET W (will be b n') -/
        SUBGOAL_THEN (← q r"?U:A->bool. U IN cbasis /\ x0 IN U /\
          U SUBSET W") MP_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"U:A->bool") STRIP_ASSUME_TAC) THEN
        /- closure(U) SUBSET closure(W) SUBSET V1 -/
        SUBGOAL_THEN (← q r"top closure_of (U:A->bool) SUBSET V1") ASSUME_TAC THENL
        [ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_OF_MONO], ALL_TAC] THEN
        /- U and V1 are basis elements, so there exist indices n', m' -/
        SUBGOAL_THEN (← q r"?n':num. (b:num->A->bool) n' = U") MP_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"n':num")) THEN
        SUBGOAL_THEN (← q r"?m':num. (b:num->A->bool) m' = V1") MP_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"m':num")) THEN
        /- Now use k = NUMPAIR n' m' -/
        EXISTS_TAC (← q r"NUMPAIR (n':num) (m':num)") THEN
        SIMP_TAC [NUMPAIR_DEST] THEN
        /- Get the g properties for (n', m') -/
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n':num", ← q r"m':num"]) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (LABEL_TAC "g_one")
          (LABEL_TAC "g_zero")) THEN
        CONJ_TAC THENL
        [/- g(n', m') x0 > 0: since x0
           IN U = b n' and g = 1 on topspace INTER b n' -/
         USE_THEN "g_one" (MP_TAC o SPEC (← q r"x0:A")) THEN
         ANTS_TAC THENL
         [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], REAL_ARITH_TAC],
         /- g(n', m') y = 0 for y IN topspace /\ y NOTIN u -/
         X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN
         USE_THEN "g_zero" MATCH_MP_TAC THEN ASM SET_TAC []]],
       DISCH_THEN (X_CHOOSE_THEN (← q r"fs:num->A->real") STRIP_ASSUME_TAC) THEN
       EXISTS_TAC (← q r"fs:num->A->real") THEN ASM_REWRITE_TAC []])
    prove
     r"!top:A topology.
        regular_space top /\ second_countable top /\ hausdorff_space top
        ==> metrizable_space top"
     (GEN_TAC THEN STRIP_TAC THEN
      /- Our space is normal -/
      SUBGOAL_THEN (← q r"normal_space (top:A topology)") ASSUME_TAC THENL
      [MATCH_MP_TAC REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      /- Step 1: Construct countable family of continuous functions -/
      /- We need functions f_n: X -> [0,1] such that for any x_0 and neighborhood
         U, there exists n with f_n(x_0) > 0 and f_n vanishing outside U -/
      SUBGOAL_THEN
       (← q r"?fs:(num->A->real).
          (!n. continuous_map (top, subtopology euclideanreal
            (real_interval[&0,&1]))
                              (fs n)) /\
          (!x0 u. open_in top u /\ x0 IN u
                  ==> ?n. (fs n) x0 > &0 /\
                          (!x. x IN topspace top /\ ~(x IN u) ==> (fs n) x = &0))")
      ASSUME_TAC THENL
      [MATCH_MP_TAC CONSTRUCT_SEPARATING_FUNCTIONS THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      /- Step 2: Define embedding F: X -> (num -> real) using the product topology
        -/
      /- F(x) = (fs 0 x, fs 1 x, fs 2 x, ...) -/
      POP_ASSUM (X_CHOOSE_THEN (← q r"fs:num->A->real") STRIP_ASSUME_TAC) THEN
      /- Define the embedding map: emb(x)(n) = fs n x -/
      /- Then prove emb is an embedding -/
      SUBGOAL_THEN
       (← q r"?emb:A->num->real.
          embedding_map (top, product_topology (:num) (\n. euclideanreal)) emb")
      MP_TAC THENL
      [EXISTS_TAC (← q r"\(x:A) (n:num). (fs n:A->real) x") THEN
       /- Prove embedding: homeomorphism onto image with subtopology -/
       REWRITE_TAC [embedding_map] THEN
       MATCH_MP_TAC BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP THEN
       REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
       REPEAT CONJ_TAC THENL
       [/- Continuity into subtopology -/
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
        REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
        X_GEN_TAC (← q r"n:num") THEN
        CONV_TAC (RAND_CONV ETA_CONV) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
        MESON_TAC [],
        /- Open map into subtopology - KEY STEP -/
        REWRITE_TAC [open_map] THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
        /- Construct witness: union of basic opens {g : g(n) > 0} for separating n
          -/
        EXISTS_TAC
          (← q r"UNIONS {v | ?n x. x IN u /\ x IN topspace top /\
                             (fs:num->A->real) n x > &0 /\
                             (!y. y IN topspace top /\
                               ~(y IN u) ==> fs n y = &0) /\
                             v = {g:num->real | g n > &0}}") THEN
        CONJ_TAC THENL
        [/- Prove witness is open in product topology -/
         /- Each {g : g(n) > 0} is a basic open, UNIONS of opens is open -/
         MATCH_MP_TAC OPEN_IN_UNIONS THEN
         REWRITE_TAC [IN_ELIM_THM] THEN
         X_GEN_TAC (← q r"v:(num->real)->bool") THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"n':num") (X_CHOOSE_THEN (← q r"x':A")
           (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
             (CONJUNCTS_THEN2 ASSUME_TAC (CONJUNCTS_THEN2 ASSUME_TAC
               SUBST1_TAC)))))) THEN
         /- Need: open_in product_topology {g | g n' > &0} -/
         /- This is preimage of {y | y > 0} under projection -/
         SUBGOAL_THEN
          (← q r"{g:num->real | g n' > &0} =
           {g | g IN topspace(product_topology (:num) (\n. euclideanreal)) /\
                (\g. g n') g IN {y:real | y > &0}}")
         SUBST1_TAC THENL
         [REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, EXTENSIONAL_UNIV,
                       o_DEF, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
          SET_TAC [],
          MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
          EXISTS_TAC (← q r"euclideanreal") THEN
          SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV] THEN
          REWRITE_TAC [← GSYM REAL_OPEN_IN, REAL_OPEN_HALFSPACE_GT]],
         /- Prove set equality: IMAGE emb u = witness INTER IMAGE emb (topspace
           top) -/
         REWRITE_TAC [EXTENSION, IN_INTER, IN_IMAGE, IN_UNIONS] THEN
         REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"f:num->real") THEN
         EQ_TAC THENL
         [/- Forward: x IN u ==> emb(x) IN witness -/
          DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC) THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
          [/- Show f IN UNIONS - use separation to get n -/
           FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"u:A->bool"]) THEN
           ASM_REWRITE_TAC [] THEN
           DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
           EXISTS_TAC (← q r"{g:num->real | g n > &0}") THEN
           ASM_REWRITE_TAC [IN_ELIM_THM] THEN
           MAP_EVERY EXISTS_TAC [← q r"n:num", ← q r"x:A"] THEN
           ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET],
           /- Show f IN IMAGE emb (topspace top) -/
           EXISTS_TAC (← q r"x:A") THEN CONJ_TAC THENL
           [REFL_TAC, ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET]]],
          /- Backward: emb(x) IN witness ==> x IN u -/
          REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
          REPEAT GEN_TAC THEN
          DISCH_THEN (CONJUNCTS_THEN2
            (X_CHOOSE_THEN (← q r"t:(num->real)->bool") (CONJUNCTS_THEN2
              (X_CHOOSE_THEN (← q r"n:num") (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC))
              ASSUME_TAC))
            (X_CHOOSE_THEN (← q r"x':A") STRIP_ASSUME_TAC)) THEN
          /- Now we have all assumptions including x IN topspace top -/
          EXISTS_TAC (← q r"x':A") THEN
          ASM_REWRITE_TAC [] THEN
          /- Prove x' IN u: we have f(n) > &0, f = emb(x'), so fs n x' > &0 -/
          /- From witness: x IN u, x IN topspace top, fs n x > &0,
             t = {g | g n > &0}, f IN t -/
          /- From IMAGE: f = emb x', x' IN topspace top -/
          /- Since f IN t and t = {g | g n > &0}, we have f n > &0, i.e.,
             fs n x' > &0 -/
          /- By separation: if x' NOTIN u then fs n x' = 0, but fs n x' > &0,
             so x' IN u -/
          ASM_CASES_TAC (← q r"x':A IN u") THEN ASM_REWRITE_TAC [] THEN
          SUBGOAL_THEN (← q r"(fs:num->A->real) n x' = &0") ASSUME_TAC THENL
          [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"(fs:num->A->real) n x' > &0") MP_TAC THENL
          [ASM_MESON_TAC [IN_ELIM_THM], ASM_REAL_ARITH_TAC]]],
        /- Surjectivity onto subtopology topspace: IMAGE = topspace INTER IMAGE -/
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, o_DEF,
                     TOPSPACE_EUCLIDEANREAL, IN_UNIV, INTER_UNIV,
                     EXTENSIONAL_UNIV, IN_ELIM_THM] THEN
        SET_TAC [],
        /- Injectivity using separation property with Hausdorff -/
        REPEAT GEN_TAC THEN STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"fs:num->A->real", ← q r"x:A",
                          ← q r"y:A"]
                      SEPARATING_FUNCTIONS_INJECTIVE) THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
       ALL_TAC] THEN
      /- Apply EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE -/
      DISCH_THEN (X_CHOOSE_THEN (← q r"emb:A->num->real") ASSUME_TAC) THEN
      MATCH_MP_TAC (← HolLight.INST_TYPE [(← qty "num->real", ← qty "B")]
        EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"product_topology (:num) (\n. euclideanreal)",
        ← q r"emb:A->num->real"] THEN
      ASM_MESON_TAC [METRIZABLE_PRODUCT_EUCLIDEANREAL_NUM])

  -- Corollary: equivalential form of Urysohn metrization
  let URYSOHN_METRIZATION_EQ ← prove
   r"!top:A topology.
        second_countable top
        ==> (regular_space top /\ hausdorff_space top <=>
             metrizable_space top)"
   (GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
    [STRIP_TAC THEN MATCH_MP_TAC URYSOHN_METRIZATION THEN ASM_REWRITE_TAC [],
     MESON_TAC [METRIZABLE_IMP_REGULAR_SPACE, METRIZABLE_IMP_HAUSDORFF_SPACE]])

  return { URYSOHN_METRIZATION, URYSOHN_METRIZATION_EQ }

/- ------------------------------------------------------------------------- -/
/- A perfect set in common cases must have cardinality >= c.                 -/
/- (metric.ml 38899-39185)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CGP where
  CARD_GE_PERFECT_SET : thm
  deriving Inhabited

/-- `prove_recursive_functions_exist` is not part of `MetricDeps`, so it is
passed in separately from the session. -/
@[nospecialize]
def setupCGP [HolBase] (D : MetricDeps)
    (prove_recursive_functions_exist : thm → term → ExceptT String IO thm)
    (BTopology : Topology) (BSubtopology : Subtopology) (BDerived : Derived)
    (BClosure : Closure) (BInterior : Interior) (BCompact1 : Compact1) (BCompact2 : Compact2)
    (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricArith : MetricArithB) (BNbhdBase : NbhdBase) (BRegular1 : Regular1)
    (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2) (BCauchy1 : Cauchy1)
    (BCauchy3 : Cauchy3) (BMCompact3 : MCompact3) (BCMS1 : CMS1) : ExceptT String IO CGP := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { AND_FORALL_THM, COND_SWAP, CONJ_ASSOC, DISJOINT, DISJOINT_SYM, EXTENSION, FINITE_RULES,
        FINITE_SING, FINITE_SUBSET, FUN_EQ_THM, .. } := D.core1
  let { IMP_IMP, INFINITE, INTERS_GSPEC, IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM,
        LE_REFL, LT_IMP_LE, LT_SUC_LE, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL,
        NOT_FORALL_THM, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_INV_MUL, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE,
        REAL_POW_INV, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_INTER,
        SUBSET_REFL, TRANSITIVE_STEPWISE_LE, le_c, num_INDUCTION, num_RECURSION, num_WOP,
        real_pow, .. } := D.core4
  let { CONTRAPOS_THM, EXISTS_PAIR_FUN_THM, FORALL_AND_THM, PAIR_EQ, RIGHT_IMP_EXISTS_THM, .. } :=
    D.core5
  let { CARD_EQ_IMP_LE, CARD_EQ_REAL, CARD_LE_TRANS, .. } := D.lib
  let { CLOSED_IN_SUBSET, OPEN_IN_INTER, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { DERIVED_SET_OF_SUBSET_TOPSPACE, DERIVED_SET_OF_SUBTOPOLOGY, .. } := BDerived
  let { CLOSED_IN_CONTAINS_DERIVED_SET, .. } := BClosure
  let { INTERIOR_OF_EMPTY, INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_SUBSET,
        INTERIOR_OF_SUBSET_TOPSPACE, OPEN_IN_INTERIOR_OF, interior_of, .. } := BInterior
  let { COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { COMPACT_SPACE_IMP_NEST, .. } := BCompact2
  let { COMPACT_IN_IMP_CLOSED_IN, DERIVED_SET_OF_INFINITE_OPEN_IN, HAUSDORFF_SPACE_SUBTOPOLOGY,
        hausdorff_space, .. } := BHausdorff1
  let { IN_MBALL, SUBMETRIC, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, MCBALL_EQ_EMPTY, MCBALL_SUBMETRIC_EQ,
        MCBALL_SUBSET_CONCENTRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  let { LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, locally_compact_space, .. } :=
    BLocCompact1
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, .. } := BLocCompact2
  let { CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, .. } := BCauchy1
  let { MCOMPLETE_NEST_SING, .. } := BCauchy3
  let { DERIVED_SET_OF_INFINITE_MBALL, .. } := BMCompact3
  let { FORALL_MCOMPLETE_TOPOLOGY, .. } := BCMS1
  -- @@SCOPE END

  let CARD_GE_PERFECT_SET ← prove
   r"!top s:A->bool.
        (completely_metrizable_space top \/
         locally_compact_space top /\ hausdorff_space top) /\
        top derived_set_of s = s /\ ~(s = {})
        ==> (:real) <=_c s"
   (REWRITE_TAC [← TAUT (← q r"(p \/ q) /\ r ==> s <=>
                      (p ==> r ==> s) /\ (q /\ r ==> s)")] THEN
    REWRITE_TAC [FORALL_AND_THM, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM FORALL_MCOMPLETE_TOPOLOGY] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      TRANS_TAC CARD_LE_TRANS (← q r"(:num->bool)") THEN
      SIMP_TAC [CARD_EQ_REAL, CARD_EQ_IMP_LE] THEN
      SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x e. x IN s /\ &0 < e
              ==> ?y z d. y IN s /\ z IN s /\ &0 < d /\ d < e / &2 /\
                          mcball m (y,d) SUBSET mcball m (x,e) /\
                          mcball m (z,d) SUBSET mcball m (x,e) /\
                          DISJOINT (mcball m (y:A,d)) (mcball m (z,d))")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool"]
            DERIVED_SET_OF_INFINITE_MBALL) THEN
        ASM_REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &4"))) THEN
        ASM_REWRITE_TAC [INFINITE, ← REAL_ARITH (← q r"&0 < e / &4 <=> &0 < e")] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o MATCH_MP
         (← MESON [FINITE_RULES, FINITE_SUBSET] (← q
           r"~FINITE s ==> !a b c. ~(s SUBSET {a,b,c})"))) THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q
         r"(!b c. ~(s SUBSET {a,b,c}))
          ==> ?b c. b IN s /\ c IN s /\ ~(c = a) /\ ~(b = a) /\ ~(b = c)"))) THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:A") THEN
        REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"mdist m (l:A,r) / &3") THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_MBALL])) THEN
        UNDISCH_TAC (← q r"~(l:A = r)") THEN
        REWRITE_TAC [DISJOINT, SUBSET, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
        ASM_SIMP_TAC [IN_MCBALL] THEN UNDISCH_TAC (← q r"(x:A) IN mspace m") THEN
        POP_ASSUM_LIST (K ALL_TAC) THEN
        REPEAT (DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC)) THEN
        ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => METRIC_ARITH t), ALL_TAC] THEN
        REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"y:A") THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [ALL_TAC, REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => METRIC_ARITH t)] THEN
        REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o SPEC (← q r"e:real") o MATCH_MP
          (← REAL_ARITH (← q r"x <= y / &3 ==> !e. y < e / &2 ==> x < e / &6"))) THEN
        (ANTS_TAC THENL
          [REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => METRIC_ARITH t), ALL_TAC])
        THENL
         [UNDISCH_TAC (← q r"mdist m (x:A,l) < e / &4"),
          UNDISCH_TAC (← q r"mdist m (x:A,r) < e / &4")] THEN
        MAP_EVERY UNDISCH_TAC
         [← q r"(x:A) IN mspace m", ← q r"(y:A) IN mspace m",
          ← q r"(l:A) IN mspace m", ← q r"(r:A) IN mspace m"] THEN
        CONV_TAC (fun t => METRIC_ARITH t),
        REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"l:A->real->A", ← q r"r:A->real->A", ← q r"d:A->real->real"] THEN
      DISCH_TAC THEN FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:A") o
       REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
      SUBGOAL_THEN
        (← q r"!b. ?xe. xe 0 = (a:A,&1) /\
                  !n. xe(SUC n) = (if b(n) then r else l) (FST(xe n)) (SND(xe n)),
                                  d (FST(xe n)) (SND(xe n))")
      MP_TAC THENL
       [GEN_TAC THEN
        W (fun g => tactic_of do
          let t ← liftExcept (do let (_, b) ← HolCore.Basics.dest_exists (snd g); pure b)
          pure (ACCEPT_TAC (← prove_recursive_functions_exist num_RECURSION t))),
        REWRITE_TAC [EXISTS_PAIR_FUN_THM, PAIR_EQ] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"x:(num->bool)->num->A", ← q r"r:(num->bool)->num->real"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mcomplete (submetric m s:A metric)") MP_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN
        ASM_REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET, TOPSPACE_MTOPOLOGY] THEN
        ASM SET_TAC [],
        REWRITE_TAC [MCOMPLETE_NEST_SING]] THEN
      DISCH_THEN (MP_TAC o MATCH_MP MONO_FORALL o GEN (← q r"b:num->bool") o
        SPEC (← q r"\n. mcball (submetric m s)
                         ((x:(num->bool)->num->A) b n,r b n)")) THEN
      REWRITE_TAC [SKOLEM_THM] THEN
      SUBGOAL_THEN (← q r"(!b n. (x:(num->bool)->num->A) b n IN s) /\
                    (!b n. &0 < (r:(num->bool)->num->real) b n)")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN
        INDUCT_TAC THEN ASM_REWRITE_TAC [REAL_LT_01] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(!b n. (x:(num->bool)->num->A) b n IN mspace m)")
      ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ANTS_TAC THENL
       [X_GEN_TAC (← q r"b:num->bool") THEN REWRITE_TAC [CLOSED_IN_MCBALL] THEN
        ASM_REWRITE_TAC [MCBALL_EQ_EMPTY, SUBMETRIC, IN_INTER] THEN
        ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 < x ==> ~(x < &0)")] THEN CONJ_TAC THENL
         [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
          REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
          ASM_REWRITE_TAC [MCBALL_SUBMETRIC_EQ] THEN ASM SET_TAC [],
          X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
          MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
          ASM_REWRITE_TAC [REAL_POW_INV] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
          DISCH_TAC THEN EXISTS_TAC (← q r"(x:(num->bool)->num->A) b n") THEN
          MATCH_MP_TAC MCBALL_SUBSET_CONCENTRIC THEN
          TRANS_TAC REAL_LE_TRANS (← q r"inv(&2 pow n)") THEN
          ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
          SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
          MATCH_MP_TAC num_INDUCTION THEN ASM_REWRITE_TAC [real_pow] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [REAL_INV_MUL] THEN
          GEN_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q
           r"d < e / &2 ==> e <= i ==> d <= inv(&2) * i")) THEN
          ASM_SIMP_TAC []],
        REWRITE_TAC [SKOLEM_THM, le_c, IN_UNIV] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:(num->bool)->A") THEN
        SIMP_TAC [SUBMETRIC, IN_INTER, FORALL_AND_THM] THEN STRIP_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"b:num->bool", ← q r"c:num->bool"] THEN
        GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
        REWRITE_TAC [FUN_EQ_THM, NOT_FORALL_THM] THEN
        GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, ← TAUT (← q r"~(p <=> q) <=> p <=> ~q")] THEN
        X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
          GEN_REWRITE_RULE (BINDER_CONV o LAND_CONV) [INTERS_GSPEC]) THEN
        DISCH_THEN (fun th => tactic_of do
         pure (MP_TAC (← SPEC (← q r"c:num->bool") th) THEN
               MP_TAC (← SPEC (← q r"b:num->bool") th))) THEN
        ASM_REWRITE_TAC [← TAUT (← q r"p ==> ~q <=> ~(p /\ q)")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q
         r"s = {a} /\ t = {a} ==> a IN s INTER t"))) THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM, AND_FORALL_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"SUC n")) THEN ASM_REWRITE_TAC [COND_SWAP] THEN
        SUBGOAL_THEN
         (← q r"(x:(num->bool)->num->A) b n = x c n /\
          (r:(num->bool)->num->real) b n = r c n")
         (CONJUNCTS_THEN SUBST1_TAC)
        THENL
         [UNDISCH_TAC (← q r"!m:num. m < n ==> (b m <=> c m)") THEN
          SPEC_TAC (← q r"n:num", ← q r"p:num") THEN
          INDUCT_TAC THEN ASM_SIMP_TAC [LT_SUC_LE, LE_REFL, LT_IMP_LE],
          COND_CASES_TAC THEN ASM_REWRITE_TAC [MCBALL_SUBMETRIC_EQ, IN_INTER] THEN
          ASM SET_TAC []]],
      SUBGOAL_THEN
       (← q r"!top:A topology.
            locally_compact_space top /\ hausdorff_space top /\
            top derived_set_of topspace top = topspace top /\ ~(topspace top = {})
            ==> (:real) <=_c topspace top")
      ASSUME_TAC THENL
       [REPEAT STRIP_TAC,
        MAP_EVERY X_GEN_TAC [← q r"top:A topology", ← q r"s:A->bool"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"subtopology top (s:A->bool)")) THEN
        SUBGOAL_THEN (← q r"(s:A->bool) SUBSET topspace top") ASSUME_TAC THENL
         [ASM_MESON_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE], ALL_TAC] THEN
        ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_SUBTOPOLOGY,
                      DERIVED_SET_OF_SUBTOPOLOGY, ← SET_RULE (← q r"s INTER s = s"),
                      ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        MATCH_MP_TAC LOCALLY_COMPACT_SPACE_CLOSED_SUBSET THEN
        ASM_REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET, SUBSET_REFL]] THEN
      TRANS_TAC CARD_LE_TRANS (← q r"(:num->bool)") THEN
      SIMP_TAC [CARD_EQ_REAL, CARD_EQ_IMP_LE] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:A")) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"z:A") o REWRITE_RULE [locally_compact_space]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"~(u:A->bool = {})") ASSUME_TAC THENL
       [ASM SET_TAC [],
        REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
          let _ ← liftExcept (check (HolCore.Basics.free_in (← q r"z:A")) (concl th))
          pure ALL_TAC))] THEN
      SUBGOAL_THEN
       (← q r"!c. closed_in top c /\ c SUBSET k /\ ~(top interior_of c = {})
            ==> ?d e. closed_in top d /\ d SUBSET k /\
                      ~(top interior_of d = {}) /\
                      closed_in top e /\ e SUBSET k /\
                      ~(top interior_of e = {}) /\
                      DISJOINT d e /\ d SUBSET c /\ e SUBSET (c:A->bool)")
      MP_TAC THENL
       [REPEAT STRIP_TAC THEN
        UNDISCH_TAC (← q r"~(top interior_of c:A->bool = {})") THEN
        ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(z:A) IN topspace top") ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET, INTERIOR_OF_SUBSET_TOPSPACE], ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top:A->bool"]
              DERIVED_SET_OF_INFINITE_OPEN_IN) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o AP_TERM (← q r"\s. (z:A) IN s")) THEN
        ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"top interior_of c:A->bool")) THEN
        ASM_SIMP_TAC [OPEN_IN_INTERIOR_OF, INTERIOR_OF_SUBSET_TOPSPACE,
                      ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← MESON [INFINITE, FINITE_SING, FINITE_SUBSET] (← q
          r"INFINITE s ==> !a. ~(s SUBSET {a})"))) THEN
        DISCH_THEN (MP_TAC o MATCH_MP (← SET_RULE (← q
         r"(!a. ~(s SUBSET {a})) ==> ?a b. a IN s /\ b IN s /\ ~(a = b)"))) THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(x:A) IN topspace top /\ y IN topspace top")
        STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET, INTERIOR_OF_SUBSET_TOPSPACE], ALL_TAC] THEN
        FIRST_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"] o
          REWRITE_RULE [hausdorff_space]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"w:A->bool"] THEN STRIP_TAC THEN
        MP_TAC (← ISPEC (← q r"top:A topology")
          LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE) THEN
        ASM_REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
        REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN DISCH_THEN (fun th => tactic_of do
          pure (MP_TAC (← SPECL [← q r"top interior_of c INTER w:A->bool", ← q r"y:A"] th) THEN
                MP_TAC (← SPECL [← q r"top interior_of c INTER v:A->bool", ← q r"x:A"] th))) THEN
        ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER, OPEN_IN_INTERIOR_OF] THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET_INTER] THEN
        MAP_EVERY X_GEN_TAC [← q r"m:A->bool", ← q r"d:A->bool"] THEN STRIP_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"n:A->bool", ← q r"e:A->bool"] THEN STRIP_TAC THEN
        MAP_EVERY EXISTS_TAC [← q r"d:A->bool", ← q r"e:A->bool"] THEN
        ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← TAUT (← q
         r"p /\ q /\ r /\ s /\ t <=> (q /\ s) /\ p /\ r /\ t")] THEN
        CONJ_TAC THENL
         [CONJ_TAC THENL [EXISTS_TAC (← q r"x:A"), EXISTS_TAC (← q r"y:A")] THEN
          REWRITE_TAC [interior_of, IN_ELIM_THM] THEN ASM_MESON_TAC [],
          MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool"] INTERIOR_OF_SUBSET) THEN
          ASM SET_TAC []],
        ALL_TAC] THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:(A->bool)->A->bool", ← q r"r:(A->bool)->A->bool"] THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"!b. ?d:num->A->bool.
            d 0 = k /\
            (!n. d(SUC n) = (if b(n) then r else l) (d n))")
      MP_TAC THENL
       [GEN_TAC THEN
        W (fun g => tactic_of do
          let t ← liftExcept (do let (_, b) ← HolCore.Basics.dest_exists (snd g); pure b)
          pure (ACCEPT_TAC (← prove_recursive_functions_exist num_RECURSION t))),
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
      X_GEN_TAC (← q r"d:(num->bool)->num->A->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!b n. closed_in top (d b n) /\ d b n SUBSET k /\
              ~(top interior_of ((d:(num->bool)->num->A->bool) b n) = {})")
      MP_TAC THENL
       [GEN_TAC THEN INDUCT_TAC THENL
         [ASM_SIMP_TAC [SUBSET_REFL, COMPACT_IN_IMP_CLOSED_IN] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
           r"~(u = {}) ==> u SUBSET i ==> ~(i = {})"))) THEN
          ASM_SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ],
          ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN ASM_SIMP_TAC []],
        REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC] THEN
      SUBGOAL_THEN
       (← q r"!b. ~(INTERS {(d:(num->bool)->num->A->bool) b n | n IN (:num)} = {})")
      MP_TAC THENL
       [X_GEN_TAC (← q r"b:num->bool") THEN MATCH_MP_TAC COMPACT_SPACE_IMP_NEST THEN
        EXISTS_TAC (← q r"subtopology top (k:A->bool)") THEN
        ASM_SIMP_TAC [CLOSED_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [INTERIOR_OF_EMPTY], ALL_TAC] THEN
        MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        REPEAT (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
        ASM_SIMP_TAC [] THEN GEN_TAC THEN COND_CASES_TAC THEN
        ASM_SIMP_TAC [],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"x:(num->bool)->A") THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN DISCH_TAC THEN
      REWRITE_TAC [le_c, IN_UNIV] THEN EXISTS_TAC (← q r"x:(num->bool)->A") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"b:num->bool", ← q r"c:num->bool"] THEN
      GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, NOT_FORALL_THM] THEN
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, ← TAUT (← q r"~(p <=> q) <=> p <=> ~q")] THEN
      X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"DISJOINT ((d:(num->bool)->num->A->bool) b (SUC n)) (d c (SUC n))")
      MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_SIMP_TAC [COND_SWAP] THEN
      SUBGOAL_THEN (← q r"(d:(num->bool)->num->A->bool) b n = d c n") SUBST1_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [DISJOINT_SYM]] THEN
      UNDISCH_TAC (← q r"!m:num. m < n ==> (b m <=> c m)") THEN
      SPEC_TAC (← q r"n:num", ← q r"p:num") THEN
      INDUCT_TAC THEN ASM_SIMP_TAC [LT_SUC_LE, LE_REFL, LT_IMP_LE]])

  return { CARD_GE_PERFECT_SET }

/- ------------------------------------------------------------------------- -/
/- Euclidean space and n-spheres, as subtopologies of infinite product R^N.  -/
/- (metric.ml 39186-39315)                                                    -/
/- ------------------------------------------------------------------------- -/

structure EUC1 where
  euclidean_space : thm
  TOPSPACE_EUCLIDEAN_SPACE : thm
  NONEMPTY_EUCLIDEAN_SPACE : thm
  SUBSET_EUCLIDEAN_SPACE : thm
  CLOSED_IN_EUCLIDEAN_SPACE : thm
  COMPLETELY_METRIZABLE_EUCLIDEAN_SPACE : thm
  METRIZABLE_EUCLIDEAN_SPACE : thm
  CONTINUOUS_MAP_COMPONENTWISE_EUCLIDEAN_SPACE : thm
  CONTINUOUS_MAP_EUCLIDEAN_SPACE_ADD : thm
  CONTINUOUS_MAP_EUCLIDEAN_SPACE_SUB : thm
  HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupEUC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BProduct1 : Product1)
    (BProduct2 : Product2) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace)
    (BRealTop1 : RealTop1) (BRealCont : RealCont) (BCMS1 : CMS1) (BMSPT : MSPT) :
    ExceptT String IO EUC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CARTESIAN_PRODUCT_UNIV, EXTENSION, EXTENSIONAL, EXTENSIONAL_UNIV, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IN, INTERS_GSPEC, INTER_UNIV, IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LE_TRANS,
        MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IMP, NOT_LE, .. } := D.core2
  let { REAL_ADD_LID, .. } := D.core3
  let { REAL_SUB_RZERO, RESTRICTION, RESTRICTION_IN_EXTENSIONAL, SUBSET, cartesian_product,
        o_DEF, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { COUNTABLE_SUBSET_NUM, .. } := D.lib
  let { CLOSED_IN_INTERS, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_COMPONENTWISE_UNIV,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { homeomorphic_maps, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { REAL_CLOSED_IN, REAL_CLOSED_SING, TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_SUB, .. } :=
    BRealCont
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
        COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL, .. } := BCMS1
  let { COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY, .. } := BMSPT
  -- @@SCOPE END

  let euclidean_space ← new_definition
   r"euclidean_space n = subtopology (product_topology (:num) (\i. euclideanreal))
                         {x | !i. ~(i IN 1..n) ==> x i = &0}"

  let TOPSPACE_EUCLIDEAN_SPACE ← prove
   r"!n. topspace(euclidean_space n) = {x | !i. ~(i IN 1..n) ==> x i = &0}"
   (REWRITE_TAC [euclidean_space, TOPSPACE_SUBTOPOLOGY,
                 TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [o_DEF, TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
    REWRITE_TAC [INTER_UNIV])

  let NONEMPTY_EUCLIDEAN_SPACE ← prove
   r"!n. ~(topspace(euclidean_space n) = {})"
   (GEN_TAC THEN REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"(\i. &0):num->real") THEN REWRITE_TAC [])

  let SUBSET_EUCLIDEAN_SPACE ← prove
   r"!m n. topspace(euclidean_space m) SUBSET topspace(euclidean_space n) <=>
         m <= n"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE, SUBSET, IN_ELIM_THM, IN_NUMSEG] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [LE_TRANS]] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [NOT_LE] THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(\i. if i = m then &1 else &0):num->real")) THEN
    REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_ARITH_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"m:num")) THEN
      REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC])

  let CLOSED_IN_EUCLIDEAN_SPACE ← prove
   r"!n. closed_in (product_topology (:num) (\i. euclideanreal))
                 (topspace(euclidean_space n))"
   (GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"topspace(euclidean_space n) =
      INTERS {{x | x IN topspace(product_topology (:num) (\i. euclideanreal)) /\
                   x i IN {&0}}
              | ~(i IN 1..n)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE, INTERS_GSPEC, IN_ELIM_THM] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV] THEN
      SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_INTERS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      REWRITE_TAC [← SET_RULE (← q r"~({f x | P x} = {}) <=> ?x. P x"), IN_NUMSEG] THEN
      REPEAT STRIP_TAC THENL [EXISTS_TAC (← q r"0") THEN ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"euclideanreal") THEN
      SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV] THEN
      REWRITE_TAC [← GSYM REAL_CLOSED_IN, REAL_CLOSED_SING]])

  let COMPLETELY_METRIZABLE_EUCLIDEAN_SPACE ← prove
   r"!n. completely_metrizable_space(euclidean_space n)"
   (GEN_TAC THEN REWRITE_TAC [euclidean_space] THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_CLOSED_IN THEN
    REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEAN_SPACE, CLOSED_IN_EUCLIDEAN_SPACE] THEN
    REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [COUNTABLE_SUBSET_NUM])

  let METRIZABLE_EUCLIDEAN_SPACE ← prove
   r"!n. metrizable_space(euclidean_space n)"
   (SIMP_TAC [COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE,
              COMPLETELY_METRIZABLE_EUCLIDEAN_SPACE])

  let CONTINUOUS_MAP_COMPONENTWISE_EUCLIDEAN_SPACE ← prove
   r"!top (f:A->num->real) n.
        continuous_map (top,euclidean_space n)
                       (\x i. if 1 <= i /\ i <= n then f x i else &0) <=>
   !i. 1 <= i /\ i <= n ==> continuous_map(top,euclideanreal) (\x. f x i)"
   (REWRITE_TAC [euclidean_space, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_NUMSEG] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:num") THEN
    ASM_CASES_TAC (← q r"1 <= i /\ i <= n") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST])

  let CONTINUOUS_MAP_EUCLIDEAN_SPACE_ADD ← prove
   r"!f g:A->num->real.
        continuous_map(top,euclidean_space n) f /\
        continuous_map(top,euclidean_space n) g
        ==> continuous_map(top,euclidean_space n) (\x i. f x i + g x i)"
   (REWRITE_TAC [euclidean_space, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, REAL_ADD_LID] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
    SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, EXTENSIONAL_UNIV])

  let CONTINUOUS_MAP_EUCLIDEAN_SPACE_SUB ← prove
   r"!f g:A->num->real.
        continuous_map(top,euclidean_space n) f /\
        continuous_map(top,euclidean_space n) g
        ==> continuous_map(top,euclidean_space n) (\x i. f x i - g x i)"
   (REWRITE_TAC [euclidean_space, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, REAL_SUB_RZERO] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
    SIMP_TAC [CONTINUOUS_MAP_REAL_SUB, EXTENSIONAL_UNIV])

  let HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!n. euclidean_space n homeomorphic_space
       product_topology (1..n) (\i. euclideanreal)"
   (GEN_TAC THEN REWRITE_TAC [homeomorphic_space, homeomorphic_maps] THEN
    EXISTS_TAC (← q r"\f:num->real. RESTRICTION (1..n) f") THEN
    EXISTS_TAC (← q r"\(f:num->real) i. if i IN 1..n then f i else &0") THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEAN_SPACE, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [cartesian_product, o_THM, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [IN_ELIM_THM, EXTENSION, euclidean_space] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      SIMP_TAC [RESTRICTION, CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
      CONJ_TAC THENL [MESON_TAC [IN, EXTENSIONAL_UNIV, IN_UNIV], ALL_TAC] THEN
      X_GEN_TAC (← q r"i:num") THEN ASM_CASES_TAC (← q r"i IN 1..n") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION],
      REPEAT STRIP_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
      SIMP_TAC [RESTRICTION] THEN ASM_MESON_TAC [],
      REWRITE_TAC [EXTENSIONAL, FUN_EQ_THM, IN_UNIV, IN_ELIM_THM] THEN
      REWRITE_TAC [RESTRICTION] THEN MESON_TAC []])

  return { euclidean_space, TOPSPACE_EUCLIDEAN_SPACE, NONEMPTY_EUCLIDEAN_SPACE,
           SUBSET_EUCLIDEAN_SPACE, CLOSED_IN_EUCLIDEAN_SPACE,
           COMPLETELY_METRIZABLE_EUCLIDEAN_SPACE, METRIZABLE_EUCLIDEAN_SPACE,
           CONTINUOUS_MAP_COMPONENTWISE_EUCLIDEAN_SPACE, CONTINUOUS_MAP_EUCLIDEAN_SPACE_ADD,
           CONTINUOUS_MAP_EUCLIDEAN_SPACE_SUB, HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Euclidean space properties; n-spheres.  (metric.ml 39317-39426)           -/
/- ------------------------------------------------------------------------- -/

structure EUC2 where
  CONTRACTIBLE_EUCLIDEAN_SPACE : thm
  PATH_CONNECTED_EUCLIDEAN_SPACE : thm
  CONNECTED_EUCLIDEAN_SPACE : thm
  LOCALLY_COMPACT_EUCLIDEAN_SPACE : thm
  LOCALLY_PATH_CONNECTED_EUCLIDEAN_SPACE : thm
  LOCALLY_CONNECTED_EUCLIDEAN_SPACE : thm
  HAUSDORFF_EUCLIDEAN_SPACE : thm
  COMPACT_EUCLIDEAN_SPACE : thm
  nsphere : thm
  NSPHERE : thm
  NONEMPTY_NSPHERE : thm
  SUBTOPOLOGY_NSPHERE_EQUATOR : thm
  CONTINUOUS_MAP_NSPHERE_REFLECTION : thm
  deriving Inhabited

@[nospecialize]
def setupEUC2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap2 : ContMap2)
    (BProduct1 : Product1) (BProduct2 : Product2) (BCompact3 : Compact3)
    (BCompact4 : Compact4) (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2)
    (BLocCompact1 : LocCompact1) (BLocCompact3 : LocCompact3) (BRealTop1 : RealTop1)
    (BRealTop2 : RealTop2) (BRealConn2 : RealConn2) (BRealCont : RealCont) (BPaths1 : Paths1)
    (BLPC1 : LPC1) (BLPC2 : LPC2) (BLPC3 : LPC3) (BLC1 : LC1) (BCON1 : CON1) (BCON3 : CON3)
    (BEUC1 : EUC1) : ExceptT String IO EUC2 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, REAL_ARITH, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, COND_ID, COND_RAND, COND_RATOR, CONJ_ASSOC, EXTENSION,
        FINITE_NUMSEG, FINITE_RESTRICT, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, IN_INSERT, IN_INTER, IN_NUMSEG, IN_UNIV, MEMBER_NOT_EMPTY, NUMSEG_CLAUSES,
        NUMSEG_EMPTY, .. } := D.core2
  let { REAL_ADD_RID, REAL_NEG_EQ_0, .. } := D.core3
  let { SUBSET, SUM_CLAUSES_NUMSEG, SUM_DELTA, UNIV_NOT_EMPTY, o_DEF, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE_UNIV, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { HOMEOMORPHIC_COMPACT_SPACE, .. } := BCompact3
  let { COMPACT_SPACE_PRODUCT_TOPOLOGY, .. } := BCompact4
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_PRODUCT_TOPOLOGY, .. } := BHausdorff2
  let { HOMEOMORPHIC_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY, .. } := BLocCompact3
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, .. } := BRealTop2
  let { LOCALLY_COMPACT_SPACE_EUCLIDEANREAL, NOT_COMPACT_SPACE_EUCLIDEANREAL, .. } := BRealConn2
  let { CONTINUOUS_MAP_REAL_NEG, .. } := BRealCont
  let { PATH_CONNECTED_IMP_CONNECTED_SPACE, .. } := BPaths1
  let { HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE, .. } := BLPC1
  let { LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL, .. } := BLPC2
  let { LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY, .. } := BLPC3
  let { LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE, .. } := BCON1
  let { CONTRACTIBLE_SPACE_EUCLIDEANREAL, CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY,
        HOMEOMORPHIC_SPACE_CONTRACTIBILITY, .. } := BCON3
  let { HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY, TOPSPACE_EUCLIDEAN_SPACE,
        euclidean_space, .. } := BEUC1
  -- @@SCOPE END

  let CONTRACTIBLE_EUCLIDEAN_SPACE ← prove
   r"!n. contractible_space(euclidean_space n)"
   (GEN_TAC THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY) THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP HOMEOMORPHIC_SPACE_CONTRACTIBILITY) THEN
    REWRITE_TAC [CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [CONTRACTIBLE_SPACE_EUCLIDEANREAL])

  let PATH_CONNECTED_EUCLIDEAN_SPACE ← prove
   r"!n. path_connected_space(euclidean_space n)"
   (SIMP_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE,
              CONTRACTIBLE_EUCLIDEAN_SPACE])

  let CONNECTED_EUCLIDEAN_SPACE ← prove
   r"!n. connected_space(euclidean_space n)"
   (SIMP_TAC [PATH_CONNECTED_EUCLIDEAN_SPACE,
              PATH_CONNECTED_IMP_CONNECTED_SPACE])

  let LOCALLY_COMPACT_EUCLIDEAN_SPACE ← prove
   r"!n. locally_compact_space(euclidean_space n)"
   (X_GEN_TAC (← q r"n:num") THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY) THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP HOMEOMORPHIC_LOCALLY_COMPACT_SPACE) THEN
    REWRITE_TAC [LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY] THEN
    DISJ2_TAC THEN REWRITE_TAC [LOCALLY_COMPACT_SPACE_EUCLIDEANREAL] THEN
    SIMP_TAC [FINITE_NUMSEG, FINITE_RESTRICT])

  let LOCALLY_PATH_CONNECTED_EUCLIDEAN_SPACE ← prove
   r"!n. locally_path_connected_space(euclidean_space n)"
   (X_GEN_TAC (← q r"n:num") THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY) THEN
    DISCH_THEN (SUBST1_TAC o
      MATCH_MP HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE) THEN
    REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY] THEN
    DISJ2_TAC THEN REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL] THEN
    SIMP_TAC [FINITE_NUMSEG, FINITE_RESTRICT])

  let LOCALLY_CONNECTED_EUCLIDEAN_SPACE ← prove
   r"!n. locally_connected_space(euclidean_space n)"
   (SIMP_TAC [LOCALLY_PATH_CONNECTED_EUCLIDEAN_SPACE,
              LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE])

  let HAUSDORFF_EUCLIDEAN_SPACE ← prove
   r"!n. hausdorff_space (euclidean_space n)"
   (GEN_TAC THEN REWRITE_TAC [euclidean_space] THEN
    MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
    REWRITE_TAC [HAUSDORFF_SPACE_PRODUCT_TOPOLOGY,
                 HAUSDORFF_SPACE_EUCLIDEANREAL])

  let COMPACT_EUCLIDEAN_SPACE ← prove
   r"!n. compact_space(euclidean_space n) <=> n = 0"
   (X_GEN_TAC (← q r"n:num") THEN
    MP_TAC (← SPEC (← q r"n:num") HOMEOMORPHIC_EUCLIDEAN_SPACE_PRODUCT_TOPOLOGY) THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP HOMEOMORPHIC_COMPACT_SPACE) THEN
    REWRITE_TAC [COMPACT_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    REWRITE_TAC [NOT_COMPACT_SPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [o_DEF, TOPSPACE_EUCLIDEANREAL, UNIV_NOT_EMPTY] THEN
    REWRITE_TAC [← GSYM NOT_EXISTS_THM, MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [NUMSEG_EMPTY] THEN ARITH_TAC)

  let nsphere ← new_definition
   r"nsphere n = subtopology (euclidean_space (n + 1))
                          { x | sum(1..n+1) (\i. x i pow 2) = &1 }"

  let NSPHERE ← prove
   r"!n. nsphere n = subtopology (product_topology (:num) (\i. euclideanreal))
                               {x | sum(1..n+1) (\i. x i pow 2) = &1 /\
                                    !i. ~(i IN 1..n+1) ==> x i = &0}"
   (REWRITE_TAC [nsphere, euclidean_space, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    GEN_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let NONEMPTY_NSPHERE ← prove
   r"!n. ~(topspace(nsphere n) = {})"
   (GEN_TAC THEN REWRITE_TAC [nsphere, ← GSYM MEMBER_NOT_EMPTY] THEN
    EXISTS_TAC (← q r"(\n. if n = 1 then &1 else &0):num->real") THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEAN_SPACE] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN CONJ_TAC THENL
     [GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_NUMSEG] THEN ARITH_TAC,
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [SUM_DELTA] THEN
      REWRITE_TAC [IN_NUMSEG, ← ARITH_RULE (← q r"1 <= 1 /\ 1 <= n + 1")]])

  let SUBTOPOLOGY_NSPHERE_EQUATOR ← prove
   r"!n. subtopology (nsphere (n + 1)) {x | x(n+2) = &0} = nsphere n"
   (GEN_TAC THEN
    REWRITE_TAC [NSPHERE, SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:num->real") THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = SUC(n + 1)"), SUM_CLAUSES_NUMSEG] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"1 <= SUC n"), NUMSEG_CLAUSES] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"SUC(n + 1) = n + 2"), IN_INSERT, IN_NUMSEG] THEN
    ASM_CASES_TAC (← q r"(x:num->real)(n + 2) = &0") THENL
     [ALL_TAC, ASM_MESON_TAC [← ARITH_RULE (← q r"~(n + 2 <= n + 1)")]] THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [REAL_ADD_RID] THEN ASM_MESON_TAC [])

  let CONTINUOUS_MAP_NSPHERE_REFLECTION ← prove
   r"!n k. continuous_map (nsphere n,nsphere n)
                        (\x i. if i = k then --x i else x i)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NSPHERE, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      ASM_CASES_TAC (← q r"i:num = k") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_NEG, CONTINUOUS_MAP_PRODUCT_PROJECTION,
                    IN_UNIV],
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [REAL_NEG_EQ_0, ← REAL_ARITH (← q r"(--x:real) pow 2 = x pow 2")] THEN
      SIMP_TAC [COND_ID, TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM]])

  return { CONTRACTIBLE_EUCLIDEAN_SPACE, PATH_CONNECTED_EUCLIDEAN_SPACE,
           CONNECTED_EUCLIDEAN_SPACE, LOCALLY_COMPACT_EUCLIDEAN_SPACE,
           LOCALLY_PATH_CONNECTED_EUCLIDEAN_SPACE, LOCALLY_CONNECTED_EUCLIDEAN_SPACE,
           HAUSDORFF_EUCLIDEAN_SPACE, COMPACT_EUCLIDEAN_SPACE, nsphere, NSPHERE,
           NONEMPTY_NSPHERE, SUBTOPOLOGY_NSPHERE_EQUATOR, CONTINUOUS_MAP_NSPHERE_REFLECTION }

/- ------------------------------------------------------------------------- -/
/- Hemispheres and nonsurjective sphere maps.  (metric.ml 39428-39636)       -/
/- ------------------------------------------------------------------------- -/

structure NSPH where
  CONTRACTIBLE_SPACE_UPPER_HEMISPHERE : thm
  CONTRACTIBLE_SPACE_LOWER_HEMISPHERE : thm
  NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupNSPH [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BProd2 : Prod2) (BProduct1 : Product1)
    (BProduct2 : Product2) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace)
    (BRealTop1 : RealTop1) (BRealCont : RealCont) (BHOM1 : HOM1) (BCON1 : CON1)
    (BCON3 : CON3) (BCC9 : CC9) (BEUC1 : EUC1) (BEUC2 : EUC2) : ExceptT String IO NSPH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, REAL_ARITH, REAL_ARITH_TAC, REAL_RING,
        SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { ARITH, CARTESIAN_PRODUCT_UNIV, COND_RAND, COND_RATOR, CONJ_ASSOC, ETA_AX,
        EXTENSIONAL_UNIV, FINITE_NUMSEG, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, IN_CROSS, IN_DELETE, IN_ELIM_THM, IN_INTER, IN_NUMSEG,
        IN_UNIV, .. } := D.core2
  let { REAL_ADD_LID, REAL_ADD_RID, REAL_DIV_1, REAL_DIV_EQ_1, REAL_DIV_REFL, REAL_ENTIRE,
        REAL_LE_ADD, REAL_LE_DIV, REAL_LE_MUL, REAL_LE_POW_2, REAL_MUL_LID, REAL_MUL_LZERO,
        REAL_MUL_RID, REAL_MUL_RZERO, REAL_NEG_NEG, REAL_POW_EQ_0, REAL_POW_INV,
        REAL_POW_MUL, .. } := D.core3
  let { REAL_SUB_0, REAL_SUB_REFL, REAL_SUB_RZERO, SQRT_1, SQRT_EQ_0, SQRT_POS_LE, SQRT_POW_2,
        SUBSET, SUM_0, SUM_DELTA, SUM_LMUL, SUM_POS_EQ_0_NUMSEG, SUM_POS_LE_NUMSEG, SUM_RMUL,
        o_DEF, o_THM, real_div, real_ge, .. } := D.core4
  let { CONTRAPOS_THM, EQ_IMP, FORALL_PAIR_THM, LAMBDA_PAIR, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { CONTINUOUS_MAP_FST, SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_COMPONENTWISE_UNIV,
        CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { homeomorphic_maps, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_DIV,
        CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_POW, CONTINUOUS_MAP_REAL_SUB,
        CONTINUOUS_MAP_SUM, .. } := BRealCont
  let { HOMOTOPIC_WITH, .. } := BHOM1
  let { contractible_space, .. } := BCON1
  let { HOMEOMORPHIC_SPACE_CONTRACTIBILITY, .. } := BCON3
  let { CONTINUOUS_MAP_SQRT, .. } := BCC9
  let { euclidean_space, .. } := BEUC1
  let { CONTINUOUS_MAP_NSPHERE_REFLECTION, NSPHERE, nsphere, .. } := BEUC2
  -- @@SCOPE END

  let CONTRACTIBLE_SPACE_UPPER_HEMISPHERE ← prove
   r"!n k. k IN 1..n+1
         ==> contractible_space(subtopology (nsphere n) {x | x k >= &0})"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"p:num->real = \i. if i = k then &1 else &0") THEN
    REWRITE_TAC [contractible_space] THEN EXISTS_TAC (← q r"p:num->real") THEN
    SUBGOAL_THEN (← q r"p IN topspace(nsphere n)") ASSUME_TAC THENL
     [EXPAND_TAC "p" THEN REWRITE_TAC [NSPHERE, TOPSPACE_SUBTOPOLOGY] THEN
      REWRITE_TAC [IN_INTER, TOPSPACE_PRODUCT_TOPOLOGY, IN_ELIM_THM, o_DEF] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, CARTESIAN_PRODUCT_UNIV, IN_UNIV] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      REWRITE_TAC [COND_RAND, COND_RATOR] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      ASM_REWRITE_TAC [SUM_DELTA],
      ALL_TAC] THEN
    SIMP_TAC [HOMOTOPIC_WITH] THEN
    EXISTS_TAC (← q r"(\x i. x i / sqrt(sum(1..n+1) (\j. x j pow 2))) o
                (\(t,q) i. (&1 - t) * q i + t * p i)") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE,
      UNDISCH_TAC (← q r"p IN topspace(nsphere n)") THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, NSPHERE, o_THM] THEN
      REWRITE_TAC [REAL_SUB_REFL, REAL_MUL_LID, REAL_MUL_LZERO, REAL_SUB_RZERO,
                   REAL_ADD_LID, REAL_ADD_RID, IN_INTER, IN_ELIM_THM] THEN
      SIMP_TAC [SQRT_1, REAL_DIV_1, ETA_AX]] THEN
    EXISTS_TAC (← q r"subtopology (euclidean_space (n + 1))
                 {x | x k >= &0 /\ ~(!i. i IN 1..n+1 ==> x i = &0)}") THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, euclidean_space] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [LAMBDA_PAIR] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_ADD THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_MUL THEN
      REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND] THEN
      SIMP_TAC [← GSYM SUBTOPOLOGY_CROSS, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_FST] THEN
      REPEAT CONJ_TAC THEN DISJ2_TAC THEN
      MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      SIMP_TAC [CONTINUOUS_MAP_REAL_SUB, CONTINUOUS_MAP_REAL_CONST,
                CONTINUOUS_MAP_ID] THEN
      REWRITE_TAC [NSPHERE] THEN MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY, NSPHERE,
                   FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS,
                   IN_INTER, IN_ELIM_THM] THEN
      EXPAND_TAC "p" THEN SIMP_TAC [REAL_MUL_RZERO, REAL_ADD_LID, REAL_ENTIRE] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_PROD_TOPOLOGY] THEN
      REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, TOPSPACE_SUBTOPOLOGY] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_INTER, IN_UNIV] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"x:num->real"] THEN
      REWRITE_TAC [IN_REAL_INTERVAL, IN_ELIM_THM] THEN STRIP_TAC THEN
      REWRITE_TAC [real_ge] THEN CONJ_TAC THENL
       [EXPAND_TAC "p" THEN REWRITE_TAC [REAL_MUL_RID] THEN
        MATCH_MP_TAC REAL_LE_ADD THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN ASM_REAL_ARITH_TAC,
        ASM_CASES_TAC (← q r"t = &0") THENL
         [ASM_REWRITE_TAC [REAL_SUB_RZERO, REAL_MUL_LID, REAL_MUL_LZERO] THEN
          REWRITE_TAC [REAL_ADD_RID] THEN DISCH_TAC THEN
          UNDISCH_TAC (← q r"x IN topspace(nsphere n)") THEN
          ASM_SIMP_TAC [NSPHERE, TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV THEN REWRITE_TAC [SUM_0] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV,
          DISCH_THEN (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
          EXPAND_TAC "p" THEN REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH (← q
            r"&0 <= x /\ &0 <= t /\ ~(t = &0) ==> ~(x + t * &1 = &0)")) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_MUL THEN
          ASM_REAL_ARITH_TAC]],
        ALL_TAC,
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY] THEN
        REWRITE_TAC [IN_INTER, IN_ELIM_THM, real_ge] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LE_DIV THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SQRT_POS_LE THEN
        MATCH_MP_TAC SUM_POS_LE_NUMSEG THEN
        REWRITE_TAC [REAL_LE_POW_2]] THEN
    REWRITE_TAC [NSPHERE, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN
      X_GEN_TAC (← q r"i:num") THEN MATCH_MP_TAC CONTINUOUS_MAP_REAL_DIV THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_MAP_SQRT THEN
        MATCH_MP_TAC CONTINUOUS_MAP_SUM THEN
        REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
        REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_REAL_POW THEN
        REPEAT (MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY) THEN
        SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
        REWRITE_TAC [SQRT_EQ_0, TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM]],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY] THEN
      SIMP_TAC [IN_INTER, IN_ELIM_THM, real_ge, IN_NUMSEG] THEN
      REWRITE_TAC [real_div, REAL_MUL_LZERO, REAL_POW_MUL, SUM_RMUL] THEN
      REWRITE_TAC [REAL_POW_INV, ← GSYM real_div] THEN
      SIMP_TAC [SQRT_POW_2, SUM_POS_LE_NUMSEG, REAL_LE_POW_2] THEN
      REWRITE_TAC [REAL_DIV_EQ_1]] THEN
    REWRITE_TAC [IMP_CONJ, CONTRAPOS_THM] THEN
    GEN_TAC THEN REPLICATE_TAC 3 DISCH_TAC THEN REWRITE_TAC [IN_NUMSEG] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      SUM_POS_EQ_0_NUMSEG)) THEN
    SIMP_TAC [REAL_POW_EQ_0, REAL_LE_POW_2, ARITH])

  let CONTRACTIBLE_SPACE_LOWER_HEMISPHERE ← prove
   r"!n k. k IN 1..n+1
         ==> contractible_space(subtopology (nsphere n) {x | x k <= &0})"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTRACTIBLE_SPACE_UPPER_HEMISPHERE) THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOMEOMORPHIC_SPACE_CONTRACTIBILITY THEN
    REWRITE_TAC [homeomorphic_space] THEN
    REPEAT (EXISTS_TAC (← q r"\(x:num->real) i. if i = k then --(x i) else x i")) THEN
    REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
              CONTINUOUS_MAP_NSPHERE_REFLECTION] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, REAL_NEG_NEG,
                 TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    REWRITE_TAC [FUN_EQ_THM] THEN REPEAT STRIP_TAC THEN
    TRY COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP ← prove
   r"!p f. continuous_map(nsphere p,nsphere p) f /\
         ~(IMAGE f (topspace(nsphere p)) = topspace(nsphere p))
         ==> ?a. homotopic_with (\x. T) (nsphere p,nsphere p) f (\x. a)"
   (SIMP_TAC [IMP_CONJ, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, ← SET_RULE (← q
              r"s SUBSET t ==> (~(s = t) <=> ?a. a IN t /\ ~(a IN s))")] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:num->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(\i. --(a i)):num->real") THEN SIMP_TAC [HOMOTOPIC_WITH] THEN
    EXISTS_TAC
     (← q r"(\x i. x i / sqrt(sum(1..p+1) (\j. x j pow 2))) o
      (\(t,x) i. (&1 - t) * f(x:num->real) i - t * a i)") THEN
    REWRITE_TAC [o_THM, ← REAL_ARITH (← q
     r"(&1 - &1) * x - &1 * a = --a /\ (&1 - &0) * x - &0 * a = x")] THEN
    MP_TAC (← ASSUME (← q r"a IN topspace(nsphere p)")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [NSPHERE, TOPSPACE_SUBTOPOLOGY, SUBSET] THEN
    REWRITE_TAC [← GSYM NSPHERE, IN_ELIM_THM, IN_INTER, FORALL_IN_IMAGE] THEN
    SIMP_TAC [← REAL_ARITH (← q r"(--x:real) pow 2 = x pow 2")] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    DISCH_THEN (STRIP_ASSUME_TAC o CONJUNCT2) THEN
    REWRITE_TAC [SQRT_1, REAL_DIV_1, ETA_AX] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"subtopology (euclidean_space(p + 1)) (UNIV DELETE (\i. &0))") THEN
    REWRITE_TAC [euclidean_space, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE_UNIV] THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [LAMBDA_PAIR] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN CONJ_TAC THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_MUL THEN
      REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND] THEN
      SIMP_TAC [← GSYM SUBTOPOLOGY_CROSS, nsphere, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_FST] THEN
      REPEAT CONJ_TAC THEN DISJ2_TAC THEN
      SIMP_TAC [CONTINUOUS_MAP_REAL_SUB, CONTINUOUS_MAP_REAL_CONST,
                CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      REWRITE_TAC [← GSYM nsphere] THEN
      SUBGOAL_THEN (← q r"(\x:num->real. f x i) = (\y:num->real. y i) o f")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"nsphere p") THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [NSPHERE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV],
      FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [NSPHERE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY,
                   FORALL_PAIR_THM, IN_CROSS, TOPSPACE_PROD_TOPOLOGY] THEN
      ASM_SIMP_TAC [IN_ELIM_THM, IN_INTER] THEN
      REPEAT STRIP_TAC THEN REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"b:num->real"] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [IN_UNIV, IN_REAL_INTERVAL, IN_DELETE] THEN
      STRIP_TAC THEN REWRITE_TAC [FUN_EQ_THM, REAL_SUB_0] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM FUN_EQ_THM] THEN
      MATCH_MP_TAC (← MESON [] (← q
       r"(a = b ==> t = &1 / &2) /\ (t = &1 / &2 ==> ~(a = b))
        ==> ~(a = b)")) THEN
      CONJ_TAC THENL
       [DISCH_THEN (MP_TAC o AP_TERM (← q r"\x. sum(1..p+1) (\i. x i pow 2)")) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
        GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o RAND_CONV) [NSPHERE] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY,
                     FORALL_PAIR_THM, IN_CROSS, TOPSPACE_PROD_TOPOLOGY] THEN
        ASM_SIMP_TAC [IN_ELIM_THM, IN_INTER, REAL_POW_MUL, SUM_LMUL] THEN
        DISCH_TAC THEN CONV_TAC (fun t => REAL_RING t),
        DISCH_THEN SUBST1_TAC THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [FUN_EQ_THM, ← REAL_ARITH (← q
         r"&1 / &2 * x = &1 / &2 * y <=> x = y")] THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM FUN_EQ_THM] THEN
        REWRITE_TAC [ETA_AX] THEN ASM SET_TAC []],
      REWRITE_TAC [NSPHERE, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE, IN_UNIV] THEN
        REWRITE_TAC [EXTENSIONAL_UNIV, IN, SUBSET] THEN
        X_GEN_TAC (← q r"k:num") THEN MATCH_MP_TAC CONTINUOUS_MAP_REAL_DIV THEN
        REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [CONJ_TAC THEN REPEAT (MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY) THEN
          SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_UNIV] THEN
          MATCH_MP_TAC CONTINUOUS_MAP_SQRT THEN
          MATCH_MP_TAC CONTINUOUS_MAP_SUM THEN
          SIMP_TAC [CONTINUOUS_MAP_REAL_POW, CONTINUOUS_MAP_PRODUCT_PROJECTION,
                    IN_UNIV, FINITE_NUMSEG],
          ALL_TAC],
        ALL_TAC] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY, IN_INTER,
                IN_ELIM_THM, IN_DELETE, IN_UNIV, real_div, REAL_POW_MUL,
                REAL_MUL_LZERO, SUM_RMUL, REAL_POW_INV, SQRT_POW_2,
                SUM_POS_LE_NUMSEG, REAL_LE_POW_2, SQRT_EQ_0] THEN
      X_GEN_TAC (← q r"x:num->real") THEN STRIP_TAC THEN
      REWRITE_TAC [← GSYM real_div] THEN TRY (MATCH_MP_TAC REAL_DIV_REFL) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          SUM_POS_EQ_0_NUMSEG)) THEN
      REWRITE_TAC [REAL_LE_POW_2, ← GSYM IN_NUMSEG, REAL_POW_EQ_0] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
      ASM_MESON_TAC [IN]])

  return { CONTRACTIBLE_SPACE_UPPER_HEMISPHERE, CONTRACTIBLE_SPACE_LOWER_HEMISPHERE,
           NULLHOMOTOPIC_NONSURJECTIVE_SPHERE_MAP }

/- ------------------------------------------------------------------------- -/
/- Contractions; Banach fixed-point theorem.  (metric.ml 39638-39773)        -/
/- ------------------------------------------------------------------------- -/

structure BAN where
  CONTRACTION_IMP_UNIQUE_FIXPOINT : thm
  BANACH_FIXPOINT_THM : thm
  deriving Inhabited

@[nospecialize]
def setupBAN [HolBase] (D : MetricDeps) (BTactics : Tactics) (BSequential : Sequential)
    (BMetricSpace : MetricSpace) (BLimits1 : Limits1) (BMetricLim : MetricLim)
    (BCauchy1 : Cauchy1) (BLIP1 : LIP1) (BCC2 : CC2) (BCC4 : CC4) :
    ExceptT String IO BAN := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, INTRO_TAC, HYP_TAC, .. } := D
  let { ADD1, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { LE_LT, LT, LT_IMP_LE, LT_SUC_LE, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_LET_TRANS, REAL_LE_LMUL_EQ, REAL_LE_RADD, REAL_LE_REFL,
        REAL_LE_TRANS, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_LDIV_EQ, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, REAL_MUL_RID, REAL_POW_ADD, REAL_POW_LE, REAL_POW_MONO_INV, .. } :=
    D.core3
  let { REAL_SUB_LDISTRIB, REAL_SUB_LE, SUBSET, SUM_CLAUSES_NUMSEG, SUM_LE_NUMSEG, SUM_LMUL,
        SUM_SING_NUMSEG, WLOG_LT, o_THM, real_pow, .. } := D.core4
  let { EXISTS_UNIQUE_THM, .. } := D.core5
  let { SUM_GP, .. } := D.misc
  let { ITER, .. } := D.lib
  let { CLAIM_TAC, CUT_TAC, LABEL_INDUCT_TAC, .. } := BTactics
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { MDIST_POS_LT, MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { CONTINUOUS_MAP_LIMIT, LIMIT_SEQUENTIALLY_OFFSET_REV, .. } := BLimits1
  let { LIMIT_IN_MSPACE, LIMIT_METRIC_UNIQUE, .. } := BMetricLim
  let { cauchy_in, mcomplete, .. } := BCauchy1
  let { lipschitz_continuous_map, .. } := BLIP1
  let { LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP, .. } := BCC2
  let { LIPSCHITZ_COEFFICIENT_POS, .. } := BCC4
  -- @@SCOPE END

  let CONTRACTION_IMP_UNIQUE_FIXPOINT ← prove
   r"!m (f:A->A) k x y.
     k < &1 /\
     (!x. x IN mspace m ==> f x IN mspace m) /\
     (!x y. x IN mspace m /\ y IN mspace m
            ==> mdist m (f x, f y) <= k * mdist m (x,y)) /\
     x IN mspace m /\ y IN mspace m /\ f x = x /\ f y = y
     ==> x = y"
   (INTRO_TAC "!m f k x y; k f le x y xeq yeq" THEN
    ASM_CASES_TAC (← q r"x:A = y") THENL [POP_ASSUM ACCEPT_TAC, ALL_TAC] THEN
    REMOVE_THEN "le" (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN ASM_REWRITE_TAC [] THEN
    CUT_TAC (← q r"&0 < (&1 - k) * mdist m (x:A,y:A)") THENL
    [REAL_ARITH_TAC,
     MATCH_MP_TAC REAL_LT_MUL THEN ASM_SIMP_TAC [MDIST_POS_LT] THEN
     ASM_REAL_ARITH_TAC])

  -- Banach Fixed-Point Theorem (aka, Contraction Mapping Principle).

  let BANACH_FIXPOINT_THM ← prove
   r"!m f:A->A k.
     ~(mspace m = {}) /\
     mcomplete m /\
     (!x. x IN mspace m ==> f x IN mspace m) /\
     k < &1 /\
     (!x y. x IN mspace m /\ y IN mspace m
            ==> mdist m (f x, f y) <= k * mdist m (x,y))
     ==> (?!x. x IN mspace m /\ f x = x)"
   (INTRO_TAC "!m f k; ne compl 4 k1 contr" THEN REMOVE_THEN "ne" MP_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN INTRO_TAC "@a. aINm" THEN
    REWRITE_TAC [EXISTS_UNIQUE_THM] THEN CONJ_TAC THENL
    [ALL_TAC,
     REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTRACTION_IMP_UNIQUE_FIXPOINT THEN
     ASM_MESON_TAC []] THEN
    ASM_CASES_TAC (← q r"!x:A. x IN mspace m ==> f x:A = f a") THENL
    [ASM_MESON_TAC [], POP_ASSUM (LABEL_TAC "nonsing")] THEN
    CLAIM_TAC "kpos" (← q r"&0 < k") THENL
    [MATCH_MP_TAC (← ISPECL [← q r"m:A metric", ← q r"m:A metric", ← q r"f:A->A"]
       LIPSCHITZ_COEFFICIENT_POS) THEN
     ASM_SIMP_TAC [] THEN ASM_MESON_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "fINm" (← q r"!n:num. (ITER n f (a:A)) IN mspace m") THENL
    [LABEL_INDUCT_TAC THEN ASM_SIMP_TAC [ITER], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"f a = a:A") THENL
    [ASM_MESON_TAC [], POP_ASSUM (LABEL_TAC "aneq")] THEN
    CUT_TAC (← q r"cauchy_in (m:A metric) (\n. ITER n f (a:A))") THENL
    [DISCH_THEN (fun cauchy => HYP_TAC "compl : @l. lim"
      (C MATCH_MP cauchy o REWRITE_RULE [mcomplete])) THEN
     EXISTS_TAC (← q r"l:A") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [LIMIT_IN_MSPACE], ALL_TAC] THEN
     MATCH_MP_TAC
       (← ISPECL [← q r"sequentially", ← q r"m:A metric", ← q r"(\n. ITER n f a:A)"]
               LIMIT_METRIC_UNIQUE) THEN
     ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
     MATCH_MP_TAC LIMIT_SEQUENTIALLY_OFFSET_REV THEN
     EXISTS_TAC (← q r"1") THEN REWRITE_TAC [← GSYM ADD1] THEN
     SUBGOAL_THEN (← q r"(\i. ITER (SUC i) f (a:A)) = f o (\i. ITER i f a)")
       SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_THM, ITER], ALL_TAC] THEN
     MATCH_MP_TAC CONTINUOUS_MAP_LIMIT THEN
     EXISTS_TAC (← q r"mtopology (m:A metric)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
     ASM_REWRITE_TAC [lipschitz_continuous_map, SUBSET, FORALL_IN_IMAGE] THEN
     EXISTS_TAC (← q r"k:real") THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "k1'" (← q r"&0 < &1 - k") THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    ASM_SIMP_TAC [cauchy_in] THEN INTRO_TAC "!e; e" THEN
    CLAIM_TAC "@N. N" (← q r"?N. k pow N < ((&1 - k) * e) / mdist m (a:A,f a)") THENL
    [MATCH_MP_TAC REAL_ARCH_POW_INV THEN
     ASM_SIMP_TAC [REAL_LT_DIV, MDIST_POS_LT, REAL_LT_MUL],
     EXISTS_TAC (← q r"N:num")] THEN
    MATCH_MP_TAC WLOG_LT THEN ASM_SIMP_TAC [MDIST_REFL] THEN CONJ_TAC THENL
    [HYP MESON_TAC "fINm" [MDIST_SYM], ALL_TAC] THEN
    INTRO_TAC "!n n'; lt; le le'" THEN
    TRANS_TAC REAL_LET_TRANS
      (← q r"sum (n..n'-1) (\i. mdist m (ITER i f a:A, ITER (SUC i) f a))") THEN
    CONJ_TAC THENL
    [REMOVE_THEN "lt" MP_TAC THEN SPEC_TAC (← q r"n':num", ← q r"n':num") THEN
     LABEL_INDUCT_TAC THENL [REWRITE_TAC [LT], REWRITE_TAC [LT_SUC_LE]] THEN
     INTRO_TAC "nle" THEN HYP_TAC "nle : nlt | neq" (REWRITE_RULE [LE_LT]) THENL
     [ALL_TAC,
      POP_ASSUM SUBST_ALL_TAC THEN
      REWRITE_TAC [ITER,
        ← ARITH_RULE (← q r"SUC n'' - 1 = n''"), SUM_SING_NUMSEG, REAL_LE_REFL]] THEN
     USE_THEN "nlt" (HYP_TAC "ind_n'" o C MATCH_MP) THEN REWRITE_TAC [ITER] THEN
     TRANS_TAC REAL_LE_TRANS
       (← q r"mdist m (ITER n f a:A,ITER n'' f a) +
        mdist m (ITER n'' f a,f (ITER n'' f a))") THEN
     ASM_SIMP_TAC [MDIST_TRIANGLE] THEN
     SUBGOAL_THEN (← q r"SUC n'' - 1 = SUC (n'' - 1)") SUBST1_TAC THENL
     [ASM_ARITH_TAC, ASM_SIMP_TAC [SUM_CLAUSES_NUMSEG]] THEN
     SUBGOAL_THEN (← q r"SUC (n'' - 1) = n''") SUBST1_TAC THENL
     [ASM_ARITH_TAC, ASM_SIMP_TAC [LT_IMP_LE, REAL_LE_RADD]] THEN
     REMOVE_THEN "ind_n'" (ACCEPT_TAC o REWRITE_RULE [ITER]),
     ALL_TAC] THEN
    TRANS_TAC REAL_LET_TRANS
       (← q r"sum (n..n'-1) (\i. mdist m (a:A, f a) * k pow i)") THEN CONJ_TAC THENL
    [MATCH_MP_TAC SUM_LE_NUMSEG THEN
     CUT_TAC (← q r"!i. mdist m (ITER i f a,ITER (SUC i) f a) <=
                  mdist m (a:A,f a) * k pow i") THENL
     [SIMP_TAC [ITER], ALL_TAC] THEN
     LABEL_INDUCT_TAC THENL
     [REWRITE_TAC [ITER, real_pow, REAL_MUL_RID, REAL_LE_REFL],
      HYP_TAC "ind_i" (REWRITE_RULE [ITER]) THEN
      TRANS_TAC REAL_LE_TRANS (← q r"k * mdist m (ITER i f a:A, f (ITER i f a))") THEN
      ASM_SIMP_TAC [real_pow, REAL_LE_LMUL_EQ, ITER,
        ← REAL_ARITH (← q r"!x. x * k * k pow i = k * x * k pow i")]],
     ALL_TAC] THEN
    REWRITE_TAC [SUM_LMUL, SUM_GP] THEN
    HYP SIMP_TAC "lt" [← ARITH_RULE (← q r"n < n' ==> ~(n' - 1 < n)")] THEN
    HYP SIMP_TAC "k1" [← REAL_ARITH (← q r"k < &1 ==> ~(k = &1)")] THEN
    USE_THEN "lt" (SUBST1_TAC o
      MATCH_MP (← ARITH_RULE (← q r"n < n' ==> SUC (n' - 1) = n'"))) THEN
    SUBGOAL_THEN (← q r"k pow n - k pow n' = k pow n * (&1 - k pow (n' - n))")
      SUBST1_TAC THENL
    [REWRITE_TAC [REAL_SUB_LDISTRIB, REAL_MUL_RID, ← GSYM REAL_POW_ADD] THEN
     HYP SIMP_TAC "lt" [← ARITH_RULE (← q r"n < n' ==> n + n' - n = n':num")],
     SUBST1_TAC (← REAL_ARITH (← q
       r"mdist m (a:A,f a) * (k pow n * (&1 - k pow (n' - n))) / (&1 - k) =
        ((k pow n * (&1 - k pow (n' - n))) / (&1 - k)) * mdist m (a,f a)"))] THEN
    ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ, MDIST_POS_LT, REAL_LT_LDIV_EQ] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"k pow n") THEN CONJ_TAC THENL
    [ONCE_REWRITE_TAC [← GSYM REAL_SUB_LE] THEN
     REWRITE_TAC [← GSYM REAL_POW_ADD,
       ← REAL_ARITH (← q r"k pow n - k pow n * (&1 - k pow (n' - n)) =
                   k pow n * k pow (n' - n)")] THEN
     HYP SIMP_TAC "lt" [← ARITH_RULE (← q r"n < n' ==> n + n' - n = n':num")] THEN
     HYP SIMP_TAC "kpos" [REAL_POW_LE, REAL_LT_IMP_LE],
     TRANS_TAC REAL_LET_TRANS (← q r"k pow N") THEN
     ASM_SIMP_TAC [REAL_POW_MONO_INV, REAL_LT_IMP_LE,
       ← REAL_ARITH (← q r"e / mdist m (a:A,f a) * (&1 - k) =
                   ((&1 - k) * e) / mdist m (a,f a)")]])

  return { CONTRACTION_IMP_UNIQUE_FIXPOINT, BANACH_FIXPOINT_THM }

/- ------------------------------------------------------------------------- -/
/- Metric space of bounded functions.  (metric.ml 39775-39938)               -/
/- ------------------------------------------------------------------------- -/

structure FUN1 where
  funspace : thm
  FUNSPACE : thm
  FUNSPACE_IMP_WELLDEFINED : thm
  FUNSPACE_IMP_EXTENSIONAL : thm
  FUNSPACE_IMP_BOUNDED_IMAGE : thm
  FUNSPACE_IMP_BOUNDED : thm
  FUNSPACE_IMP_BOUNDED2 : thm
  FUNSPACE_MDIST_LE : thm
  deriving Inhabited

@[nospecialize]
def setupFUN1 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BMetricSpace : MetricSpace)
    (BBounded : Bounded) : ExceptT String IO FUN1 := do
  -- @@SCOPE BEGIN
  let { new_definition, MESON_TAC, REAL_ARITH_TAC, SET_TAC, DESTRUCT_TAC, FIX_TAC, INTRO_TAC,
        HYP_TAC, REFUTE_THEN, .. } := D
  let { EXTENSION, EXTENSIONAL_EQ, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_ELIM_THM, IN_EXTENSIONAL, IN_INSERT, IN_UNION, IN_UNIV, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { REAL_ADD_LID, REAL_LE_REFL, REAL_LE_SUP, .. } := D.core3
  let { REAL_SUP_LE, REAL_SUP_LE_EQ, SUBSET, SUP_SING, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { CLAIM_TAC, CONJ_LIST, CUT_TAC, LABEL_ABBREV_TAC, .. } := BTactics
  let { MDIST_POS_LE, MDIST_POS_LT, MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE, METRIC,
        is_metric_space, .. } := BMetricSpace
  let { MBOUNDED, MBOUNDED_ALT, MBOUNDED_EMPTY, MBOUNDED_UNION, .. } := BBounded
  -- @@SCOPE END

  let funspace ← new_definition
   r"funspace s m =
   metric ({f:A->B | (!x. x IN s ==> f x IN mspace m) /\
                     f IN EXTENSIONAL s /\
                     mbounded m (IMAGE f s)},
           (\(f,g). if s = {} then &0 else
                    sup {mdist m (f x,g x) | x | x IN s}))"

  let FUNSPACE ← REWRITE_RULE [← GSYM FORALL_AND_THM] (← prove
   r"!s m.
     mspace (funspace s m) =
       {f:A->B | (!x. x IN s ==> f x IN mspace m) /\
                 f IN EXTENSIONAL s /\
                 mbounded m (IMAGE f s)} /\
     (!f g. mdist (funspace s m) (f,g) =
              if s = {} then &0 else
              sup {mdist m (f x,g x) | x | x IN s})"
   (REPEAT GEN_TAC THEN MAP_EVERY LABEL_ABBREV_TAC
      [← q r"fspace = {f:A->B | (!x. x IN s ==> f x IN mspace m) /\
                           f IN EXTENSIONAL s /\
                           mbounded m (IMAGE f s)}",
       ← q r"fdist =
          \(f,g). if s = {} then &0 else
                  sup {mdist m (f x:B,g x) | x | x:A IN s}"] THEN
    CUT_TAC (← q r"mspace (funspace s m) = fspace:(A->B)->bool /\
             mdist (funspace s m:(A->B)metric) = fdist") THENL
    [EXPAND_TAC "fdist" THEN DISCH_THEN (fun th => REWRITE_TAC [th]),
     ASM_REWRITE_TAC [funspace] THEN MATCH_MP_TAC METRIC] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
    [POP_ASSUM SUBST_ALL_TAC THEN MAP_EVERY EXPAND_TAC ["fspace", "fdist"] THEN
     SIMP_TAC [is_metric_space, NOT_IN_EMPTY, IN_EXTENSIONAL, IMAGE_CLAUSES,
       MBOUNDED_EMPTY, IN_ELIM_THM, REAL_LE_REFL, REAL_ADD_LID, FUN_EQ_THM],
     POP_ASSUM (LABEL_TAC "nempty")] THEN
    REMOVE_THEN "nempty" (fun th =>
      RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN LABEL_TAC "nempty" th) THEN
    CLAIM_TAC "wd ext bound"
      (← q r"(!f x:A. f IN fspace /\ x IN s ==> f x:B IN mspace m) /\
       (!f. f IN fspace ==> f IN EXTENSIONAL s) /\
       (!f. f IN fspace
            ==> (?c b. c IN mspace m /\
                       (!x. x IN s ==> mdist m (c,f x) <= b)))") THENL
    [EXPAND_TAC "fspace" THEN
     ASM_SIMP_TAC [IN_ELIM_THM, MBOUNDED, IMAGE_EQ_EMPTY] THEN SET_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "bound2"
      (← q r"!f g:A->B. f IN fspace /\ g IN fspace
                  ==> (?b. !x. x IN s ==> mdist m (f x,g x) <= b)") THENL
    [REMOVE_THEN "fspace" (SUBST_ALL_TAC o GSYM) THEN
     REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
     CUT_TAC (← q r"mbounded m (IMAGE (f:A->B) s UNION IMAGE g s)") THENL
     [REWRITE_TAC [MBOUNDED_ALT, SUBSET, IN_UNION] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"b:real") THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [MBOUNDED_UNION]],
     ALL_TAC] THEN
    HYP_TAC "nempty -> @a. a" (REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [is_metric_space] THEN CONJ_TAC THENL
    [INTRO_TAC "![f] [g]; f  g" THEN EXPAND_TAC "fdist" THEN
     REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_SUP THEN
     CLAIM_TAC "@b. b" (← q r"?b. !x:A. x IN s ==> mdist m (f x:B,g x) <= b") THENL
     [HYP SIMP_TAC "bound2 f g" [],
      ALL_TAC] THEN
      MAP_EVERY EXISTS_TAC [← q r"b:real", ← q r"mdist m (f(a:A):B,g a)"] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN HYP SIMP_TAC "wd f g a" [MDIST_POS_LE] THEN
      HYP MESON_TAC "a b" [],
      ALL_TAC] THEN
    CONJ_TAC THENL
    [INTRO_TAC "![f] [g]; f  g" THEN EXPAND_TAC "fdist" THEN
     REWRITE_TAC [] THEN EQ_TAC THENL
     [INTRO_TAC "sup0" THEN MATCH_MP_TAC (← SPEC (← q r"s:A->bool") EXTENSIONAL_EQ) THEN
      HYP SIMP_TAC "f g ext" [] THEN INTRO_TAC "!x; x" THEN
      REFUTE_THEN (LABEL_TAC "neq") THEN
      CUT_TAC
        (← q r"&0 < mdist m (f (x:A):B, g x) /\
         mdist m (f x, g x) <= sup {mdist m (f x,g x) | x IN s}") THENL
      [HYP REWRITE_TAC "sup0" [] THEN REAL_ARITH_TAC, ALL_TAC] THEN
      HYP SIMP_TAC "wd f g x neq" [MDIST_POS_LT] THEN
      MATCH_MP_TAC REAL_LE_SUP THEN
      CLAIM_TAC "@B. B" (← q r"?b. !x:A. x IN s ==> mdist m (f x:B,g x) <= b") THENL
      [HYP SIMP_TAC "bound2 f g" [], ALL_TAC] THEN
      MAP_EVERY EXISTS_TAC [← q r"B:real", ← q r"mdist m (f (x:A):B,g x)"] THEN
      REWRITE_TAC [IN_ELIM_THM, IN_UNIV, REAL_LE_REFL] THEN
      HYP MESON_TAC "B x" [],
      DISCH_THEN (SUBST1_TAC o GSYM) THEN
      SUBGOAL_THEN (← q r"{mdist m (f x:B,f x) | x:A IN s} = {&0}")
        (fun th => REWRITE_TAC [th, SUP_SING]) THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, IN_UNIV, IN_INSERT] THEN
      HYP MESON_TAC "wd f a" [MDIST_REFL]],
     ALL_TAC] THEN
    CONJ_TAC THENL
    [INTRO_TAC "![f] [g]; f g" THEN EXPAND_TAC "fdist" THEN REWRITE_TAC [] THEN
     AP_TERM_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
     HYP MESON_TAC "wd f g" [MDIST_SYM],
     ALL_TAC] THEN
    INTRO_TAC "![f] [g] [h]; f g h" THEN EXPAND_TAC "fdist" THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC REAL_SUP_LE THEN CONJ_TAC THENL
    [REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, IN_UNIV] THEN
     HYP MESON_TAC "a" [],
     ALL_TAC] THEN
    FIX_TAC "[d]" THEN REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
    INTRO_TAC "@x. x d" THEN POP_ASSUM SUBST1_TAC THEN
    CUT_TAC
      (← q r"mdist m (f (x:A):B,h x) <= mdist m (f x,g x) + mdist m (g x, h x) /\
       mdist m (f x, g x) <= fdist (f,g) /\
       mdist m (g x, h x) <= fdist (g,h)") THEN
    EXPAND_TAC "fdist" THEN REWRITE_TAC [] THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    HYP SIMP_TAC "wd f g h x" [MDIST_TRIANGLE] THEN
    CONJ_TAC THEN MATCH_MP_TAC REAL_LE_SUP THENL
    [CLAIM_TAC "@B. B" (← q r"?b. !x:A. x IN s ==> mdist m (f x:B,g x) <= b") THENL
     [HYP SIMP_TAC "bound2 f g" [],
      MAP_EVERY EXISTS_TAC [← q r"B:real", ← q r"mdist m (f(x:A):B,g x)"]] THEN
     REWRITE_TAC [IN_ELIM_THM, IN_UNIV, REAL_LE_REFL] THEN HYP MESON_TAC "B x" [],
     CLAIM_TAC "@B. B" (← q r"?b. !x:A. x IN s ==> mdist m (g x:B,h x) <= b") THENL
     [HYP SIMP_TAC "bound2 g h" [], ALL_TAC] THEN
     MAP_EVERY EXISTS_TAC [← q r"B:real", ← q r"mdist m (g(x:A):B,h x)"] THEN
     REWRITE_TAC [IN_ELIM_THM, IN_UNIV, REAL_LE_REFL] THEN
     HYP MESON_TAC "B x" []]))

  let FUNSPACE_IMP_WELLDEFINED ← prove
   r"!s m f:A->B x. f IN mspace (funspace s m) /\ x IN s ==> f x IN mspace m"
   (SIMP_TAC [FUNSPACE, IN_ELIM_THM])

  let FUNSPACE_IMP_EXTENSIONAL ← prove
   r"!s m f:A->B. f IN mspace (funspace s m) ==> f IN EXTENSIONAL s"
   (SIMP_TAC [FUNSPACE, IN_ELIM_THM])

  let FUNSPACE_IMP_BOUNDED_IMAGE ← prove
   r"!s m f:A->B. f IN mspace (funspace s m) ==> mbounded m (IMAGE f s)"
   (SIMP_TAC [FUNSPACE, IN_ELIM_THM])

  let FUNSPACE_IMP_BOUNDED ← prove
   r"!s m f:A->B. f IN mspace (funspace s m)
                ==> s = {} \/ (?c b. !x. x IN s ==> mdist m (c,f x) <= b)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [FUNSPACE, MBOUNDED, IMAGE_EQ_EMPTY, IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let FUNSPACE_IMP_BOUNDED2 ← prove
   r"!s m f g:A->B. f IN mspace (funspace s m) /\ g IN mspace (funspace s m)
                  ==> (?b. !x. x IN s ==> mdist m (f x,g x) <= b)"
   (REWRITE_TAC [FUNSPACE, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    CUT_TAC (← q r"mbounded m (IMAGE (f:A->B) s UNION IMAGE g s)") THENL
    [REWRITE_TAC [MBOUNDED_ALT, SUBSET, IN_UNION] THEN
     STRIP_TAC THEN EXISTS_TAC (← q r"b:real") THEN ASM SET_TAC [],
     ASM_REWRITE_TAC [MBOUNDED_UNION]])

  let FUNSPACE_MDIST_LE ← prove
   r"!s m f g:A->B a.
     ~(s = {}) /\
     f IN mspace (funspace s m) /\
     g IN mspace (funspace s m)
     ==> (mdist (funspace s m) (f,g) <= a <=>
          !x. x IN s ==> mdist m (f x, g x) <= a)"
   (INTRO_TAC "! *; ne f g" THEN
    HYP (DESTRUCT_TAC "@b. b" o
      MATCH_MP FUNSPACE_IMP_BOUNDED2 o CONJ_LIST) "f g" [] THEN
    ASM_REWRITE_TAC [FUNSPACE] THEN
    MP_TAC (← ISPECL [← q r"{mdist m (f x:B,g x) | x:A IN s}", ← q r"a:real"]
      REAL_SUP_LE_EQ) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_ELIM_THM]] THEN
    MESON_TAC [])

  return { funspace, FUNSPACE, FUNSPACE_IMP_WELLDEFINED, FUNSPACE_IMP_EXTENSIONAL,
           FUNSPACE_IMP_BOUNDED_IMAGE, FUNSPACE_IMP_BOUNDED, FUNSPACE_IMP_BOUNDED2,
           FUNSPACE_MDIST_LE }

/- ------------------------------------------------------------------------- -/
/- Completeness of the space of bounded functions.  (metric.ml 39940-40066)  -/
/- ------------------------------------------------------------------------- -/

structure FUN2 where
  MCOMPLETE_FUNSPACE : thm
  deriving Inhabited

@[nospecialize]
def setupFUN2 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricLim : MetricLim)
    (BCauchy1 : Cauchy1) (BFUN1 : FUN1) : ExceptT String IO FUN2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, SELECT_ELIM_TAC,
        DESTRUCT_TAC, INTRO_TAC, HYP_TAC, REFUTE_THEN, .. } := D
  let { ETA_AX, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_ELIM_THM, IN_EXTENSIONAL, IN_IMAGE, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_REFL, REAL_LE_SUP, REAL_LE_TRANS, REAL_LTE_TRANS,
        REAL_LT_01, REAL_LT_ADD2, REAL_LT_IMP_LE, REAL_NOT_LE, .. } := D.core3
  let { REAL_SUP_LE, SUBSET, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { CLAIM_TAC, CUT_TAC, LABEL_ABBREV_TAC, .. } := BTactics
  let { MDIST_TRIANGLE, .. } := BMetricSpace
  let { IN_MCBALL, .. } := BMTopology
  let { MBOUNDED, MBOUNDED_EMPTY, mbounded, .. } := BBounded
  let { LIMIT_IN_MSPACE, LIMIT_METRIC_SEQUENTIALLY, .. } := BMetricLim
  let { cauchy_in, mcomplete, .. } := BCauchy1
  let { FUNSPACE, FUNSPACE_IMP_BOUNDED2, .. } := BFUN1
  -- @@SCOPE END

  let MCOMPLETE_FUNSPACE ← prove
   r"!s:A->bool m:B metric. mcomplete m ==> mcomplete (funspace s m)"
   (REWRITE_TAC [mcomplete] THEN INTRO_TAC "!s m; cpl; ![f]; cy" THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
    [POP_ASSUM SUBST_ALL_TAC THEN EXISTS_TAC (← q r"\x:A. ARB:B") THEN
     REMOVE_THEN "cy" MP_TAC THEN
     SIMP_TAC [cauchy_in, LIMIT_METRIC_SEQUENTIALLY, FUNSPACE, NOT_IN_EMPTY,
       IN_ELIM_THM, IN_EXTENSIONAL, IMAGE_CLAUSES, MBOUNDED_EMPTY],
     POP_ASSUM (LABEL_TAC "nempty")] THEN
    LABEL_ABBREV_TAC
      (← q r"g (x:A) = if x IN s
                 then @y. limit (mtopology m) (\n:num. f n x) y sequentially
                 else ARB:B") THEN
    EXISTS_TAC (← q r"g:A->B") THEN USE_THEN "cy" MP_TAC THEN
    HYP REWRITE_TAC "nempty"
      [cauchy_in, FUNSPACE, IN_ELIM_THM, FORALL_AND_THM] THEN
    INTRO_TAC "(fwd fext fbd) cy'" THEN
    ASM_REWRITE_TAC [LIMIT_METRIC_SEQUENTIALLY, FUNSPACE, IN_ELIM_THM] THEN
    CLAIM_TAC "gext" (← q r"g:A->B IN EXTENSIONAL s") THENL
    [REMOVE_THEN "g" (fun th => tactic_of do
       pure (SIMP_TAC [IN_EXTENSIONAL, ← GSYM th])),
     HYP REWRITE_TAC "gext" []] THEN
    CLAIM_TAC "bd2"
       (← q r"!n n'. ?b. !x:A. x IN s ==> mdist m (f (n:num) x:B, f n' x) <= b") THENL
    [REPEAT GEN_TAC THEN MATCH_MP_TAC FUNSPACE_IMP_BOUNDED2 THEN
     ASM_REWRITE_TAC [FUNSPACE, IN_ELIM_THM, ETA_AX],
     ALL_TAC] THEN
    CLAIM_TAC "sup"
      (← q r"!n n':num x0:A. x0 IN s
                       ==> mdist m (f n x0:B,f n' x0) <=
                           sup {mdist m (f n x,f n' x) | x IN s}") THENL
    [INTRO_TAC "!n n' x0; x0" THEN MATCH_MP_TAC REAL_LE_SUP THEN
     REMOVE_THEN "bd2" (DESTRUCT_TAC "@b. b" o SPECL [← q r"n:num", ← q r"n':num"]) THEN
     MAP_EVERY EXISTS_TAC
       [← q r"b:real", ← q r"mdist m (f (n:num) (x0:A):B, f n' x0)"] THEN
     REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [HYP MESON_TAC "x0" [], REWRITE_TAC [REAL_LE_REFL]] THEN
     INTRO_TAC "![d]; @y. y d" THEN REMOVE_THEN "d" SUBST1_TAC THEN
     HYP SIMP_TAC "b y" [],
     ALL_TAC] THEN
    CLAIM_TAC "pcy" (← q r"!x:A. x IN s ==> cauchy_in m (\n. f n x:B)") THENL
    [INTRO_TAC "!x; x" THEN REWRITE_TAC [cauchy_in] THEN
     HYP SIMP_TAC "fwd x" [] THEN INTRO_TAC "!e; e" THEN
     USE_THEN "e" (HYP_TAC "cy': @N.N" o C MATCH_MP) THEN EXISTS_TAC (← q r"N:num") THEN
     REPEAT GEN_TAC THEN DISCH_THEN (HYP_TAC "N" o C MATCH_MP) THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"sup {mdist m (f (n:num) x:B,f n' x) | x:A IN s}") THEN
     HYP REWRITE_TAC "N" [] THEN HYP SIMP_TAC "sup x" [],
     ALL_TAC] THEN
    CLAIM_TAC "glim"
      (← q r"!x:A. x IN s
             ==> limit (mtopology m) (\n. f n x:B) (g x) sequentially") THENL
    [INTRO_TAC "!x; x" THEN
     REMOVE_THEN "g" (fun th => tactic_of do pure (ASM_REWRITE_TAC [← GSYM th])) THEN
     SELECT_ELIM_TAC THEN HYP SIMP_TAC "cpl pcy x" [],
     ALL_TAC] THEN
    CLAIM_TAC "gwd" (← q r"!x:A. x IN s ==> g x:B IN mspace m") THENL
    [INTRO_TAC "!x; x" THEN
     MATCH_MP_TAC (← ISPECL [← q r"sequentially"] LIMIT_IN_MSPACE) THEN
     EXISTS_TAC (← q r"\n:num. f n (x:A):B") THEN HYP SIMP_TAC "glim x" [],
     HYP REWRITE_TAC "gwd" []] THEN
    CLAIM_TAC "unif"
      (← q r"!e. &0 < e ==> ?N:num. !x:A n. x IN s /\ N <= n
                      ==> mdist m (f n x:B, g x) < e") THENL
    [INTRO_TAC "!e; e" THEN REMOVE_THEN "cy'" (MP_TAC o SPEC (← q r"e / &2")) THEN
     HYP REWRITE_TAC "e" [REAL_HALF] THEN INTRO_TAC "@N. N" THEN
     EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!x n; x n" THEN
     USE_THEN "x" (HYP_TAC "glim" o C MATCH_MP) THEN
     HYP_TAC "glim: gx glim" (REWRITE_RULE [LIMIT_METRIC_SEQUENTIALLY]) THEN
     REMOVE_THEN "glim" (MP_TAC o SPEC (← q r"e / &2")) THEN
     HYP REWRITE_TAC "e" [REAL_HALF] THEN
     HYP SIMP_TAC "fwd x" [] THEN INTRO_TAC "@N'. N'" THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"mdist m (f n (x:A):B, f (MAX N N') x) +
        mdist m (f (MAX N N') x, g x)") THEN
     HYP SIMP_TAC "fwd x gwd" [MDIST_TRIANGLE] THEN
     TRANS_TAC REAL_LTE_TRANS (← q r"e / &2 + e / &2") THEN CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LT_ADD2, REWRITE_TAC [REAL_HALF, REAL_LE_REFL]] THEN
     CONJ_TAC THENL [ALL_TAC, REMOVE_THEN "N'" MATCH_MP_TAC THEN ARITH_TAC] THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"sup {mdist m (f n x:B,f (MAX N N') x) | x:A IN s}") THEN
     HYP SIMP_TAC "N n" [← ARITH_RULE (← q r"N <= MAX N N'")] THEN
     HYP SIMP_TAC "sup x" [],
     ALL_TAC] THEN
    CONJ_TAC THENL
    [HYP_TAC "cy': @N. N" (C MATCH_MP REAL_LT_01) THEN
     USE_THEN "fbd" (MP_TAC o REWRITE_RULE [MBOUNDED] o SPEC (← q r"N:num")) THEN
     HYP REWRITE_TAC "nempty" [mbounded, IMAGE_EQ_EMPTY] THEN
     INTRO_TAC "Nwd (@c b. c Nbd)" THEN
     MAP_EVERY EXISTS_TAC [← q r"c:B", ← q r"b + &1"] THEN
     REWRITE_TAC [SUBSET, IN_IMAGE, IN_MCBALL] THEN
     INTRO_TAC "![y]; (@x. y x)" THEN REMOVE_THEN "y" SUBST1_TAC THEN
     HYP SIMP_TAC "x gwd c" [] THEN TRANS_TAC REAL_LE_TRANS
       (← q r"mdist m (c:B, f (N:num) (x:A)) + mdist m (f N x, g x)") THEN
     HYP SIMP_TAC "c fwd gwd x" [MDIST_TRIANGLE] THEN
     MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THENL
     [REMOVE_THEN "Nbd" MATCH_MP_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
      HYP MESON_TAC "x" [],
      REFUTE_THEN (LABEL_TAC "contra" o REWRITE_RULE [REAL_NOT_LE])] THEN
     CLAIM_TAC "@a. a1 a2"
       (← q r"?a. &1 < a /\ a < mdist m (f (N:num) (x:A), g x:B)") THENL
     [EXISTS_TAC (← q r"(&1 + mdist m (f (N:num) (x:A), g x:B)) / &2") THEN
      REMOVE_THEN "contra" MP_TAC THEN REAL_ARITH_TAC,
      USE_THEN "x" (HYP_TAC "glim" o C MATCH_MP)] THEN
     REMOVE_THEN "glim" (MP_TAC o REWRITE_RULE [LIMIT_METRIC_SEQUENTIALLY]) THEN
     HYP SIMP_TAC "gwd x" [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"a - &1")) THEN
     ANTS_TAC THENL [REMOVE_THEN "a1" MP_TAC THEN REAL_ARITH_TAC, ALL_TAC] THEN
     HYP SIMP_TAC "fwd x" [] THEN INTRO_TAC "@N'. N'" THEN
     CUT_TAC (← q r"mdist m (f (N:num) (x:A), g x:B) < a") THENL
     [REMOVE_THEN "a2" MP_TAC THEN REAL_ARITH_TAC, ALL_TAC] THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"mdist m (f N (x:A),f (MAX N N') x:B) + mdist m (f (MAX N N') x,g x)") THEN
     HYP SIMP_TAC "fwd gwd x" [MDIST_TRIANGLE] THEN
     SUBST1_TAC (← REAL_ARITH (← q r"a = &1 + (a - &1)")) THEN
     MATCH_MP_TAC REAL_LT_ADD2 THEN CONJ_TAC THENL
     [ALL_TAC, REMOVE_THEN "N'" MATCH_MP_TAC THEN ARITH_TAC] THEN
     TRANS_TAC REAL_LET_TRANS
       (← q r"sup {mdist m (f N x:B,f (MAX N N') x) | x:A IN s}") THEN
     CONJ_TAC THENL
     [HYP SIMP_TAC "sup x" [], REMOVE_THEN "N" MATCH_MP_TAC THEN ARITH_TAC],
     ALL_TAC] THEN
    INTRO_TAC "!e; e" THEN REMOVE_THEN "unif" (MP_TAC o SPEC (← q r"e / &2")) THEN
    HYP REWRITE_TAC "e" [REAL_HALF] THEN INTRO_TAC "@N. N" THEN
    EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
    TRANS_TAC REAL_LET_TRANS (← q r"e / &2") THEN CONJ_TAC THENL
    [ALL_TAC, REMOVE_THEN "e" MP_TAC THEN REAL_ARITH_TAC] THEN
    MATCH_MP_TAC REAL_SUP_LE THEN REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
    [HYP SET_TAC "nempty" [], HYP MESON_TAC "N n" [REAL_LT_IMP_LE]])

  return { MCOMPLETE_FUNSPACE }

/- ------------------------------------------------------------------------- -/
/- Metric space of continuous bounded functions.  (metric.ml 40068-40221)    -/
/- ------------------------------------------------------------------------- -/

structure CFUN where
  cfunspace : thm
  CFUNSPACE : thm
  CFUNSPACE_SUBSET_FUNSPACE : thm
  MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE : thm
  CFUNSPACE_MDIST_LE : thm
  CFUNSPACE_IMP_BOUNDED2 : thm
  CFUNSPACE_MDIST_LT : thm
  MDIST_CFUNSPACE_LE : thm
  MDIST_CFUNSPACE_IMP_MDIST_LE : thm
  COMPACT_IN_MSPACE_CFUNSPACE : thm
  MCOMPLETE_CFUNSPACE : thm
  deriving Inhabited

@[nospecialize]
def setupCFUN [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BContMap1 : ContMap1) (BCompact3 : Compact3) (BMetricSpace : MetricSpace)
    (BMetricHaus : MetricHaus) (BMetricLim : MetricLim) (BCauchy1 : Cauchy1)
    (BMetricCont : MetricCont) (BFUN1 : FUN1) (BFUN2 : FUN2) : ExceptT String IO CFUN := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, MESON_TAC, REAL_ARITH_TAC, SET_TAC, DESTRUCT_TAC,
        INTRO_TAC, HYP_TAC, .. } := D
  let { EMPTY_GSPEC, EXTENSION, .. } := D.core1
  let { IN_ELIM_THM, LE_REFL, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LET_ADD2, REAL_LET_TRANS, REAL_LE_REFL, REAL_LE_SUP, REAL_LE_TRANS,
        REAL_LTE_ADD2, REAL_LT_IMP_LE, .. } := D.core3
  let { REAL_SUP_LE, SUBSET, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { CLAIM_TAC, CONJ_LIST, .. } := BTactics
  let { OPEN_IN_EMPTY, OPEN_IN_SUBSET, .. } := BTopology
  let { continuous_map, .. } := BContMap1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { IN_MBALL, MDIST_SYM, MDIST_TRIANGLE, SUBMETRIC, .. } := BMetricSpace
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { LIMIT_METRIC_SEQUENTIALLY, .. } := BMetricLim
  let { SEQUENTIALLY_CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, .. } := BCauchy1
  let { CONTINUOUS_MAP_TO_METRIC, .. } := BMetricCont
  let { FUNSPACE, FUNSPACE_IMP_BOUNDED2, FUNSPACE_MDIST_LE, .. } := BFUN1
  let { MCOMPLETE_FUNSPACE, .. } := BFUN2
  -- @@SCOPE END

  let cfunspace ← new_definition
   r"cfunspace top m =
   submetric (funspace (topspace top) m)
     {f:A->B | continuous_map (top,mtopology m) f}"

  let CFUNSPACE ← REWRITE_RULE [← GSYM FORALL_AND_THM] (← prove
   r"(!top m.
      mspace (cfunspace top m) =
      {f:A->B | (!x. x IN topspace top ==> f x IN mspace m) /\
                f IN EXTENSIONAL (topspace top) /\
                mbounded m (IMAGE f (topspace top)) /\
                continuous_map (top,mtopology m) f}) /\
     (!f g:A->B.
        mdist (cfunspace top m) (f,g) =
        if topspace top = {} then &0 else
        sup {mdist m (f x,g x) | x IN topspace top})"
   (REWRITE_TAC [cfunspace, SUBMETRIC, FUNSPACE] THEN SET_TAC []))

  let CFUNSPACE_SUBSET_FUNSPACE ← prove
   r"!top:A topology m:B metric.
     mspace (cfunspace top m) SUBSET mspace (funspace (topspace top) m)"
   (SIMP_TAC [SUBSET, FUNSPACE, CFUNSPACE, IN_ELIM_THM])

  let MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE ← prove
   r"!top m f g:A->B.
     mdist (cfunspace top m) (f,g) = mdist (funspace (topspace top) m) (f,g)"
   (REWRITE_TAC [FUNSPACE, CFUNSPACE])

  let CFUNSPACE_MDIST_LE ← prove
   r"!top m f g:A->B a.
     ~(topspace top = {}) /\
     f IN mspace (cfunspace top m) /\
     g IN mspace (cfunspace top m)
     ==> (mdist (cfunspace top m) (f,g) <= a <=>
          !x. x IN topspace top ==> mdist m (f x, g x) <= a)"
   (INTRO_TAC "! *; ne f g" THEN
    REWRITE_TAC [MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE] THEN
    MATCH_MP_TAC FUNSPACE_MDIST_LE THEN
    ASM_SIMP_TAC [← REWRITE_RULE [SUBSET] CFUNSPACE_SUBSET_FUNSPACE])

  let CFUNSPACE_IMP_BOUNDED2 ← prove
   r"!top m f g:A->B.
     f IN mspace (cfunspace top m) /\ g IN mspace (cfunspace top m)
     ==> (?b. !x. x IN topspace top ==> mdist m (f x,g x) <= b)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FUNSPACE_IMP_BOUNDED2 THEN
    ASM SET_TAC [CFUNSPACE_SUBSET_FUNSPACE])

  let CFUNSPACE_MDIST_LT ← prove
   r"!top m f g:A->B a x.
     compact_in top (topspace top) /\
     f IN mspace (cfunspace top m) /\ g IN mspace (cfunspace top m) /\
     mdist (cfunspace top m) (f, g) < a /\
     x IN topspace top
     ==> mdist m (f x, g x) < a"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace (top:A topology) = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN INTRO_TAC "cpt f g lt x" THEN
    REMOVE_THEN "lt" MP_TAC THEN ASM_REWRITE_TAC [CFUNSPACE] THEN
    INTRO_TAC "lt" THEN
    TRANS_TAC REAL_LET_TRANS
      (← q r"sup {mdist m (f x:B,g x) | x:A IN topspace top}") THEN
    HYP SIMP_TAC "lt" [] THEN MATCH_MP_TAC REAL_LE_SUP THEN
    HYP (DESTRUCT_TAC "@b. b" o
      MATCH_MP CFUNSPACE_IMP_BOUNDED2 o CONJ_LIST) "f g" [] THEN
    MAP_EVERY EXISTS_TAC [← q r"b:real", ← q r"mdist m (f (x:A):B,g x)"] THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN HYP MESON_TAC "x b" [])

  let MDIST_CFUNSPACE_LE ← prove
   r"!top m B f g.
     &0 <= B /\
     (!x:A. x IN topspace top ==> mdist m (f x:B, g x) <= B)
     ==> mdist (cfunspace top m) (f,g) <= B"
   (INTRO_TAC "!top m B f g; Bpos bound" THEN
    REWRITE_TAC [CFUNSPACE] THEN COND_CASES_TAC THEN
    HYP REWRITE_TAC "Bpos" [] THEN MATCH_MP_TAC REAL_SUP_LE THEN
    CONJ_TAC THENL
    [POP_ASSUM MP_TAC THEN SET_TAC [],
     REWRITE_TAC [IN_ELIM_THM] THEN HYP MESON_TAC "bound" []])

  let MDIST_CFUNSPACE_IMP_MDIST_LE ← prove
   r"!top m f g:A->B a x.
     f IN mspace (cfunspace top m) /\
     g IN mspace (cfunspace top m) /\
     mdist (cfunspace top m) (f,g) <= a /\
     x IN topspace top
     ==> mdist m (f x,g x) <= a"
   (MESON_TAC [MEMBER_NOT_EMPTY, CFUNSPACE_MDIST_LE])

  let COMPACT_IN_MSPACE_CFUNSPACE ← prove
   r"!top m.
     compact_in top (topspace top)
     ==> mspace (cfunspace top m) =
          {f | (!x:A. x IN topspace top ==> f x:B IN mspace m) /\
               f IN EXTENSIONAL (topspace top) /\
               continuous_map (top,mtopology m) f}"
   (REWRITE_TAC [CFUNSPACE, EXTENSION, IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN SIMP_TAC [] THEN INTRO_TAC "wd ext cont" THEN
    MATCH_MP_TAC COMPACT_IN_IMP_MBOUNDED THEN
    MATCH_MP_TAC (← ISPEC (← q r"top:A topology") IMAGE_COMPACT_IN) THEN
    ASM_REWRITE_TAC [])

  let MCOMPLETE_CFUNSPACE ← prove
   r"!top:A topology m:B metric. mcomplete m ==> mcomplete (cfunspace top m)"
   (INTRO_TAC "!top m; cpl" THEN REWRITE_TAC [cfunspace] THEN
    MATCH_MP_TAC SEQUENTIALLY_CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN
    ASM_SIMP_TAC [MCOMPLETE_FUNSPACE] THEN
    REWRITE_TAC [IN_ELIM_THM, LIMIT_METRIC_SEQUENTIALLY] THEN
    INTRO_TAC "![f] [g]; fcont g lim" THEN
    ASM_CASES_TAC (← q r"topspace top = {}:A->bool") THENL
    [ASM_REWRITE_TAC [continuous_map, NOT_IN_EMPTY, EMPTY_GSPEC, OPEN_IN_EMPTY],
     POP_ASSUM (LABEL_TAC "nempty")] THEN
    REWRITE_TAC [CONTINUOUS_MAP_TO_METRIC, IN_MBALL] THEN
    INTRO_TAC "!x; x; ![e]; e" THEN CLAIM_TAC "e3pos" (← q r"&0 < e / &3") THENL
    [REMOVE_THEN "e" MP_TAC THEN REAL_ARITH_TAC,
     USE_THEN "e3pos" (HYP_TAC "lim: @N. N" o C MATCH_MP)] THEN
    HYP_TAC "N: f lt" (C MATCH_MP (← SPEC (← q r"N:num") LE_REFL)) THEN
    HYP_TAC "fcont" (REWRITE_RULE [CONTINUOUS_MAP_TO_METRIC]) THEN
    USE_THEN "x" (HYP_TAC "fcont" o C MATCH_MP) THEN
    USE_THEN "e3pos" (HYP_TAC "fcont" o C MATCH_MP) THEN
    HYP_TAC "fcont: @u. u x' inc" (SPEC (← q r"N:num")) THEN
    EXISTS_TAC (← q r"u:A->bool") THEN
    HYP REWRITE_TAC "u x'" [] THEN INTRO_TAC "!y; y'" THEN
    CLAIM_TAC "uinc" (← q r"!x:A. x IN u ==> x IN topspace top") THENL
    [REMOVE_THEN "u" (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [],
     ALL_TAC] THEN
    HYP_TAC "g -> gwd gext gbd" (REWRITE_RULE [FUNSPACE, IN_ELIM_THM]) THEN
    HYP_TAC "f -> fwd fext fbd" (REWRITE_RULE [FUNSPACE, IN_ELIM_THM]) THEN
    CLAIM_TAC "y" (← q r"y:A IN topspace top") THENL
    [HYP SIMP_TAC "uinc y'" [OPEN_IN_SUBSET], HYP SIMP_TAC "gwd x y" []] THEN
    CLAIM_TAC "sup" (← q r"!x0:A. x0 IN topspace top
                            ==> mdist m (f (N:num) x0:B,g x0) <= e / &3") THENL
    [INTRO_TAC "!x0; x0" THEN TRANS_TAC REAL_LE_TRANS
       (← q r"sup {mdist m (f (N:num) x,g x:B) | x:A IN topspace top}") THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC REAL_LE_SUP THEN HYP (DESTRUCT_TAC "@b. b" o
        MATCH_MP FUNSPACE_IMP_BOUNDED2 o CONJ_LIST) "f g" [] THEN
      MAP_EVERY EXISTS_TAC [← q r"b:real", ← q r"mdist m (f (N:num) (x0:A), g x0:B)"] THEN
      REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN
      CONJ_TAC THENL [HYP SET_TAC "x0" [], HYP MESON_TAC "b" []],
      REMOVE_THEN "lt" MP_TAC THEN HYP REWRITE_TAC "nempty" [FUNSPACE] THEN
      MATCH_ACCEPT_TAC REAL_LT_IMP_LE],
     ALL_TAC] THEN
    TRANS_TAC REAL_LET_TRANS
      (← q r"mdist m (g (x:A):B, f (N:num) x) + mdist m (f N x, g y)") THEN
    HYP SIMP_TAC "gwd fwd x y" [MDIST_TRIANGLE] THEN
    SUBST1_TAC (← ARITH_RULE (← q r"e = e / &3 + (e / &3 + e / &3)")) THEN
    MATCH_MP_TAC REAL_LET_ADD2 THEN HYP SIMP_TAC "gwd fwd x sup" [MDIST_SYM] THEN
    TRANS_TAC REAL_LET_TRANS
      (← q r"mdist m (f (N:num) (x:A):B, f N y) + mdist m (f N y, g y)") THEN
    HYP SIMP_TAC "fwd gwd x y" [MDIST_TRIANGLE] THEN
    MATCH_MP_TAC REAL_LTE_ADD2 THEN HYP SIMP_TAC "gwd fwd y sup" [] THEN
    REMOVE_THEN "inc" MP_TAC THEN HYP SIMP_TAC "fwd x y' uinc" [IN_MBALL])

  return { cfunspace, CFUNSPACE, CFUNSPACE_SUBSET_FUNSPACE, MDIST_CFUNSPACE_EQ_MDIST_FUNSPACE,
           CFUNSPACE_MDIST_LE, CFUNSPACE_IMP_BOUNDED2, CFUNSPACE_MDIST_LT, MDIST_CFUNSPACE_LE,
           MDIST_CFUNSPACE_IMP_MDIST_LE, COMPACT_IN_MSPACE_CFUNSPACE, MCOMPLETE_CFUNSPACE }

/- ------------------------------------------------------------------------- -/
/- Existence of completion for any metric space M as a subspace of M->R.     -/
/- (metric.ml 40223-40314)                                                    -/
/- ------------------------------------------------------------------------- -/

structure COMPL where
  METRIC_COMPLETION_EXPLICIT : thm
  METRIC_COMPLETION : thm
  METRIZABLE_SPACE_COMPLETION : thm
  deriving Inhabited

@[nospecialize]
def setupCOMPL [HolBase] (D : MetricDeps) (BClosure : Closure) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricArith : MetricArithB)
    (BMetrizable : Metrizable) (BRealTop2 : RealTop2) (BCauchy1 : Cauchy1)
    (BMCompact3 : MCompact3) (BCMS1 : CMS1) (BCC9 : CC9) (BFUN1 : FUN1) (BFUN2 : FUN2) :
    ExceptT String IO COMPL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, EXTENSIONAL, FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMAGE_CLAUSES, .. } :=
    D.core1
  let { INTER_EMPTY, IN_ELIM_THM, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.core2
  let { REAL_SUB_RZERO, RESTRICTION, SUBSET, SUBSET_INTER, SUP_UNIQUE, .. } := D.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EMPTY, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE,
        CLOSURE_OF_SUBTOPOLOGY, .. } := BClosure
  let { MDIST_REFL, MDIST_SYM, SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, mcball, .. } := BMTopology
  let { mbounded, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { FORALL_METRIZABLE_SPACE, .. } := BMetrizable
  let { REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { CAUCHY_IN_SUBMETRIC, CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, mcomplete, .. } := BCauchy1
  let { MCOMPLETE_REAL_EUCLIDEAN_METRIC, .. } := BMCompact3
  let { EXISTS_COMPLETELY_METRIZABLE_SPACE, .. } := BCMS1
  let { ISOMETRY_IMP_EMBEDDING_MAP, .. } := BCC9
  let { FUNSPACE, .. } := BFUN1
  let { MCOMPLETE_FUNSPACE, .. } := BFUN2
  -- @@SCOPE END

  let METRIC_COMPLETION_EXPLICIT ← prove
   r"!m:A metric. ?s f:A->A->real.
      s SUBSET mspace(funspace (mspace m) real_euclidean_metric) /\
      mcomplete(submetric (funspace (mspace m) real_euclidean_metric) s) /\
      IMAGE f (mspace m) SUBSET s /\
      mtopology(funspace (mspace m) real_euclidean_metric) closure_of
      IMAGE f (mspace m) = s /\
      !x y. x IN mspace m /\ y IN mspace m
            ==> mdist (funspace (mspace m) real_euclidean_metric) (f x,f y) =
                mdist m (x,y)"
   (GEN_TAC THEN
    ABBREV_TAC (← q r"m' = funspace (mspace m:A->bool) real_euclidean_metric") THEN
    ASM_CASES_TAC (← q r"mspace m:A->bool = {}") THENL
     [EXISTS_TAC (← q r"{}:(A->real)->bool") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, IMAGE_CLAUSES, CLOSURE_OF_EMPTY,
                       EMPTY_SUBSET, INTER_EMPTY, mcomplete, CAUCHY_IN_SUBMETRIC],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY])] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
    ABBREV_TAC
      (← q r"f:A->A->real =
       \x. RESTRICTION (mspace m) (\u. mdist m (x,u) - mdist m (a,u))") THEN
    EXISTS_TAC (← q r"mtopology(funspace (mspace m) real_euclidean_metric) closure_of
                IMAGE (f:A->A->real) (mspace m)") THEN
    EXISTS_TAC (← q r"f:A->A->real") THEN
    EXPAND_TAC "m'" THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->A->real) (mspace m) SUBSET mspace m'")
     ASSUME_TAC THENL
     [EXPAND_TAC "m'" THEN REWRITE_TAC [SUBSET, FUNSPACE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM, EXTENSIONAL] THEN
      REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV, mbounded, mcball] THEN
      X_GEN_TAC (← q r"b:A") THEN DISCH_TAC THEN
      EXPAND_TAC "f" THEN SIMP_TAC [RESTRICTION, SUBSET, FORALL_IN_IMAGE] THEN
      MAP_EVERY EXISTS_TAC [← q r"&0:real", ← q r"mdist m (a:A,b)"] THEN
      REWRITE_TAC [IN_ELIM_THM, REAL_SUB_RZERO] THEN
      MAP_EVERY UNDISCH_TAC [← q r"(a:A) IN mspace m", ← q r"(b:A) IN mspace m"] THEN
      CONV_TAC (fun t => METRIC_ARITH t),
      ALL_TAC] THEN
    REWRITE_TAC [SUBMETRIC] THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
      REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE],
      MATCH_MP_TAC CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN EXPAND_TAC "m'" THEN
      MATCH_MP_TAC MCOMPLETE_FUNSPACE THEN
      REWRITE_TAC [MCOMPLETE_REAL_EUCLIDEAN_METRIC],
      MATCH_MP_TAC CLOSURE_OF_SUBSET THEN
      ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY],
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      EXPAND_TAC "m'" THEN REWRITE_TAC [FUNSPACE] THEN
      COND_CASES_TAC THENL [ASM_MESON_TAC [NOT_IN_EMPTY], ALL_TAC] THEN
      MATCH_MP_TAC SUP_UNIQUE THEN SIMP_TAC [FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"b:real") THEN REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN
      EXPAND_TAC "f" THEN REWRITE_TAC [RESTRICTION] THEN EQ_TAC THENL
       [DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"x:A") th))) THEN
        EXPAND_TAC "f" THEN
        ASM_SIMP_TAC [MDIST_REFL, MDIST_SYM] THEN REAL_ARITH_TAC,
        MAP_EVERY UNDISCH_TAC [← q r"(x:A) IN mspace m", ← q r"(y:A) IN mspace m"] THEN
        CONV_TAC (fun t => METRIC_ARITH t)]])

  let METRIC_COMPLETION ← prove
   r"!m:A metric.
        ?m' f:A->A->real.
                mcomplete m' /\
                IMAGE f (mspace m) SUBSET mspace m' /\
                (mtopology m') closure_of (IMAGE f (mspace m)) = mspace m' /\
                !x y. x IN mspace m /\ y IN mspace m
                      ==> mdist m' (f x,f y) = mdist m (x,y)"
   (GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"(?s f. P (submetric (funspace (mspace m) real_euclidean_metric) s) f)
      ==> ?n f. P n f")) THEN
    MP_TAC (← SPEC (← q r"m:A metric") METRIC_COMPLETION_EXPLICIT) THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    REWRITE_TAC [SUBMETRIC, SUBSET_INTER] THEN
    REWRITE_TAC [MTOPOLOGY_SUBMETRIC, CLOSURE_OF_SUBTOPOLOGY] THEN
    SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")] THEN SET_TAC [])

  let METRIZABLE_SPACE_COMPLETION ← prove
   r"!top:A topology.
        metrizable_space top
        ==> ?top' (f:A->A->real).
                completely_metrizable_space top' /\
                embedding_map(top,top') f /\
                top' closure_of (IMAGE f (topspace top)) = topspace top'"
   (REWRITE_TAC [FORALL_METRIZABLE_SPACE, RIGHT_EXISTS_AND_THM] THEN
    X_GEN_TAC (← q r"m:A metric") THEN
    REWRITE_TAC [EXISTS_COMPLETELY_METRIZABLE_SPACE, RIGHT_AND_EXISTS_THM] THEN
    MP_TAC (← ISPEC (← q r"m:A metric") METRIC_COMPLETION) THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    MESON_TAC [ISOMETRY_IMP_EMBEDDING_MAP])

  return { METRIC_COMPLETION_EXPLICIT, METRIC_COMPLETION, METRIZABLE_SPACE_COMPLETION }

/- ------------------------------------------------------------------------- -/
/- The Baire Category Theorem.  (metric.ml 40316-40520)                      -/
/- ------------------------------------------------------------------------- -/

structure BAI1 where
  METRIC_BAIRE_CATEGORY : thm
  METRIC_BAIRE_CATEGORY_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupBAI1 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BClosure : Closure) (BInterior : Interior) (BSequential : Sequential)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetricLim : MetricLim)
    (BCauchy1 : Cauchy1) : ExceptT String IO BAI1 := do
  -- @@SCOPE BEGIN
  let { prove_general_recursive_function_exists, ASM_ARITH_TAC, ASM_MESON_TAC,
        ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC,
        DESTRUCT_TAC, INTRO_TAC, HYP_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { DIFF_EMPTY, DIFF_INTERS, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTERS_0, IN_INTER, IN_INTERS, IN_UNIV, LE_INDUCT, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_INV_POW, REAL_LE_REFL, REAL_LTE_TRANS, REAL_LT_TRANS,
        REAL_MIN_MIN, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, WLOG_LE, o_DEF,
        real_pow, .. } := D.core4
  let { CHOICE_PAIRED_THM, DE_MORGAN_THM, FORALL_AND_THM, LAMBDA_PAIR, PAIR, PAIR_EQ, .. } :=
    D.core5
  let { COUNTABLE_IMAGE, FORALL_COUNTABLE_AS_IMAGE, .. } := D.lib
  let { CLAIM_TAC, CUT_TAC, LABEL_INDUCT_TAC, .. } := BTactics
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBSET, .. } := BTopology
  let { CLOSURE_OF_UNIV, .. } := BClosure
  let { CLOSURE_OF_COMPLEMENT, CLOSURE_OF_INTERIOR_OF, DENSE_INTERSECTS_OPEN,
        INTERIOR_OF_SUBSET_TOPSPACE, .. } := BInterior
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { CENTRE_IN_MBALL_EQ, IN_MBALL, MBALL_EQ_EMPTY, MDIST_SYM, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, MBALL_SUBSET_MCBALL, MCBALL_SUBSET_CONCENTRIC,
        MCBALL_SUBSET_MBALL_CONCENTRIC, OPEN_IN_MBALL, OPEN_IN_MSPACE, OPEN_IN_MTOPOLOGY,
        OPEN_IN_MTOPOLOGY_MCBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { LIMIT_IN_CLOSED_IN, .. } := BMetricLim
  let { cauchy_in, mcomplete, .. } := BCauchy1
  -- @@SCOPE END

  let METRIC_BAIRE_CATEGORY ← prove
   r"!m:A metric g.
     mcomplete m /\
     COUNTABLE g /\
     (!t. t IN g ==> open_in (mtopology m) t /\
                     mtopology m closure_of t = mspace m)
     ==> mtopology m closure_of INTERS g = mspace m"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN INTRO_TAC "!m; m" THEN
    REWRITE_TAC [FORALL_COUNTABLE_AS_IMAGE, NOT_IN_EMPTY, CLOSURE_OF_UNIV,
    INTERS_0, TOPSPACE_MTOPOLOGY, FORALL_IN_IMAGE, IN_UNIV, FORALL_AND_THM] THEN
    INTRO_TAC "![u]; u_open u_dense" THEN
    REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
    REWRITE_TAC [DENSE_INTERSECTS_OPEN] THEN
    INTRO_TAC "![w]; w_open w_ne" THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
    CLAIM_TAC "@x0. x0" (← q r"?x0:A. x0 IN u 0 INTER w") THENL
    [REWRITE_TAC [MEMBER_NOT_EMPTY] THEN
     ASM_MESON_TAC [DENSE_INTERSECTS_OPEN, TOPSPACE_MTOPOLOGY],
     ALL_TAC] THEN
    CLAIM_TAC "@r0. r0pos r0lt1 sub"
      (← q r"?r. &0 < r /\ r < &1 /\ mcball m (x0:A,r) SUBSET u 0 INTER w") THENL
    [SUBGOAL_THEN (← q r"open_in (mtopology m) (u 0 INTER w:A->bool)") MP_TAC THENL
     [HYP SIMP_TAC "u_open w_open" [OPEN_IN_INTER], ALL_TAC] THEN
     REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN INTRO_TAC "u0w hp" THEN
     REMOVE_THEN "hp" (MP_TAC o SPEC (← q r"x0:A")) THEN
     ANTS_TAC THENL [HYP REWRITE_TAC "x0" [], ALL_TAC] THEN
     INTRO_TAC "@r. rpos ball" THEN EXISTS_TAC (← q r"min r (&1) / &2") THEN
     CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
     CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
     TRANS_TAC SUBSET_TRANS (← q r"mball m (x0:A,r)") THEN
     HYP REWRITE_TAC "ball" [] THEN
     MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN
     ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DESTRUCT_TAC "@b. b0 b1" (← prove_general_recursive_function_exists
      (← q r"?b:num->(A#real).
         b 0 = (x0:A,r0) /\
         (!n. b (SUC n) =
              @(x,r). &0 < r /\ r < SND (b n) / &2 /\ x IN mspace m /\
                      mcball m (x,r) SUBSET mball m (b n) INTER u n)")) THEN
    CLAIM_TAC "rmk"
      (← q r"!n. (\ (x:A,r). &0 < r /\ r < SND (b n) / &2 /\ x IN mspace m /\
                     mcball m (x,r) SUBSET mball m (b n) INTER u n)
           (b (SUC n))") THENL
    [LABEL_INDUCT_TAC THENL
     [REMOVE_THEN "b1" (fun b1 => REWRITE_TAC [b1]) THEN
      MATCH_MP_TAC CHOICE_PAIRED_THM THEN
      REMOVE_THEN "b0" (fun b0 => REWRITE_TAC [b0]) THEN
      MAP_EVERY EXISTS_TAC [← q r"x0:A", ← q r"r0 / &4"] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      CONJ_TAC THENL
      [CUT_TAC (← q r"u 0:A->bool SUBSET mspace m") THENL
       [HYP SET_TAC "x0" [],
        HYP SIMP_TAC "u_open" [← GSYM TOPSPACE_MTOPOLOGY, OPEN_IN_SUBSET]],
       ALL_TAC] THEN
      TRANS_TAC SUBSET_TRANS (← q r"mball m (x0:A,r0)") THEN CONJ_TAC THENL
      [MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN ASM_REAL_ARITH_TAC,
       REWRITE_TAC [SUBSET_INTER, SUBSET_REFL] THEN
       TRANS_TAC SUBSET_TRANS (← q r"mcball m (x0:A,r0)") THEN
       REWRITE_TAC [MBALL_SUBSET_MCBALL] THEN HYP SET_TAC "sub" []],
      ALL_TAC] THEN
     USE_THEN "b1" (fun b1 => GEN_REWRITE_TAC RAND_CONV [b1]) THEN
     MATCH_MP_TAC CHOICE_PAIRED_THM THEN REWRITE_TAC [] THEN
     HYP_TAC "ind_n: rpos rlt x subn" (REWRITE_RULE [LAMBDA_PAIR]) THEN
     USE_THEN "u_dense" (MP_TAC o SPEC (← q r"SUC n") o
       REWRITE_RULE [← GSYM TOPSPACE_MTOPOLOGY]) THEN
     REWRITE_TAC [DENSE_INTERSECTS_OPEN] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"mball m (b (SUC n):A#real)")) THEN
     DESTRUCT_TAC "@x1 r1. bsuc" (← MESON [PAIR]
       (← q r"?x1:A r1:real. b (SUC n) = x1,r1")) THEN
     HYP REWRITE_TAC "bsuc" [] THEN
     REMOVE_THEN "bsuc"
      (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN LABEL_TAC "bsuc" th) THEN
