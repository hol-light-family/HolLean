          (!n k. k <= N n
                 ==> h (SUC n) (k * (N(SUC n) DIV N n)) = h n k) /\
          (!k. k <= N 0 ==> (h:num->num->A) 0 k IN C0) /\
          (!n k. k <= N(SUC n)
