        CONJ_TAC THENL [ASM_REWRITE_TAC [REAL_MIN_LE] THEN DISJ2_TAC THEN
          REAL_ARITH_TAC,
         MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"(e / &8 / &4 pow n) / &4") THEN
