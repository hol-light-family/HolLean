        MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"euclideanreal") THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION] THEN
        REWRITE_TAC [← GSYM REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL],
        ALL_TAC] THEN
      EXPAND_TAC "f" THEN REWRITE_TAC [IN_CROSS, IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [RESTRICTION, NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"y:A") THEN
      GEN_REWRITE_TAC RAND_CONV [CONJ_ASSOC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
       r"t = u INTER s i
        ==> i IN k /\ ~(y IN t)
            ==> y IN INTERS {s i | i  IN k} /\ y IN u ==> F"))) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2) THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT2) THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN
      EXPAND_TAC "e" THEN REAL_ARITH_TAC])

  return { GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- More about completely metrizable spaces.  (metric.ml 41672-41795)         -/
/- ------------------------------------------------------------------------- -/

structure CMS2 where
  OPEN_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT : thm
  COMPLETELY_METRIZABLE_SPACE_GDELTA_IN_ALT : thm
  COMPLETELY_METRIZABLE_SPACE_GDELTA_IN : thm
  COMPLETELY_METRIZABLE_SPACE_OPEN_IN : thm
  LOCALLY_COMPACT_IMP_COMPLETELY_METRIZABLE_SPACE : thm
  COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN : thm
  deriving Inhabited

@[nospecialize]
def setupCMS2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding)
    (BHausdorff1 : Hausdorff1) (BDiagonal : Diagonal) (BFsigmaGdelta : FsigmaGdelta)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BMetrizable : Metrizable)
    (BLocCompact1 : LocCompact1) (BLocCompact3 : LocCompact3) (BCMS1 : CMS1) (BPM2 : PM2)
    (BCC9 : CC9) (BLAV2 : LAV2) (BMSPT : MSPT) (BCOMPL : COMPL) (BGDP : GDP) :
    ExceptT String IO CMS2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, FORALL_INTERSECTION_OF, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_GSPEC, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET_ANTISYM_EQ, SUBSET_REFL, .. } := D.core4
  let { COUNTABLE_RESTRICT, .. } := D.lib
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CLOSURE_OF_SUBTOPOLOGY, .. } := BClosure
  let { CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_CLOSEDNESS_EQ, HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_PROD_TOPOLOGY, HOMEOMORPHIC_SPACE_REFL,
        HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT, HOMEOMORPHIC_SPACE_TRANS, .. } := BHomeoSpace
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, .. } := BEmbedding
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { FORALL_IN_CLOSURE_OF_EQ, .. } := BDiagonal
  let { GDELTA_IN_ALT, GDELTA_IN_SUBSET, OPEN_IMP_GDELTA_IN, .. } := BFsigmaGdelta
  let { SUBTOPOLOGY_MSPACE, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { FORALL_METRIZABLE_SPACE, METRIZABLE_IMP_HAUSDORFF_SPACE, .. } := BMetrizable
  let { HOMEOMORPHIC_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF, .. } := BLocCompact3
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
        COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL, COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY,
        HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE, .. } := BCMS1
  let { COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY, .. } := BPM2
  let { ISOMETRY_IMP_EMBEDDING_MAP, .. } := BCC9
  let { LAVRENTIEV_EXTENSION, .. } := BLAV2
  let { COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY, .. } := BMSPT
  let { METRIC_COMPLETION, .. } := BCOMPL
  let { GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT, .. } := BGDP
  -- @@SCOPE END

  let OPEN_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT ← prove
   r"!top (s:A->bool).
        metrizable_space top /\ open_in top s
        ==> ?t. closed_in (prod_topology top euclideanreal) t /\
                subtopology top s homeomorphic_space
                subtopology (prod_topology top euclideanreal) t"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"(\x. s):1->A->bool", ← q r"{one}"]
          GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT) THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"INTERS {s |i| i IN {a}} = s")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A#(1->real)->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"prod_topology (top:A topology) (product_topology {one} (\i. euclideanreal))
      homeomorphic_space prod_topology top euclideanreal")
    MP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_SPACE_PROD_TOPOLOGY THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT, HOMEOMORPHIC_SPACE_REFL],
      REWRITE_TAC [HOMEOMORPHIC_SPACE, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"f:A#(1->real)->A#real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A#(1->real)->A#real) t") THEN CONJ_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_MAP_CLOSEDNESS_EQ], ALL_TAC] THEN
    REWRITE_TAC [← GSYM HOMEOMORPHIC_SPACE] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
        HOMEOMORPHIC_SPACE_TRANS)) THEN
    REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN EXISTS_TAC (← q r"f:A#(1->real)->A#real") THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [])

  let COMPLETELY_METRIZABLE_SPACE_GDELTA_IN_ALT ← prove
   r"!top s:A->bool.
        completely_metrizable_space top /\
        (COUNTABLE INTERSECTION_OF open_in top) s
        ==> completely_metrizable_space (subtopology top s)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_INTERSECTION_OF] THEN
    X_GEN_TAC (← q r"top:A topology") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:(A->bool)->bool") THEN REPEAT DISCH_TAC THEN
    REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"(\x:A->bool. x)",
                      ← q r"u:(A->bool)->bool"]
          GDELTA_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT) THEN
    ASM_SIMP_TAC [COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, IN_GSPEC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A#((A->bool)->real)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o
      MATCH_MP HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE) THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_CLOSED_IN THEN
    ASM_REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL,
                 COMPLETELY_METRIZABLE_SPACE_PRODUCT_TOPOLOGY] THEN
    ASM_SIMP_TAC [COUNTABLE_RESTRICT])

  let COMPLETELY_METRIZABLE_SPACE_GDELTA_IN ← prove
   r"!top s:A->bool.
        completely_metrizable_space top /\ gdelta_in top s
        ==> completely_metrizable_space (subtopology top s)"
   (SIMP_TAC [GDELTA_IN_ALT, COMPLETELY_METRIZABLE_SPACE_GDELTA_IN_ALT])

  let COMPLETELY_METRIZABLE_SPACE_OPEN_IN ← prove
   r"!top s:A->bool.
        completely_metrizable_space top /\ open_in top s
        ==> completely_metrizable_space (subtopology top s)"
   (SIMP_TAC [COMPLETELY_METRIZABLE_SPACE_GDELTA_IN, OPEN_IMP_GDELTA_IN])

  let LOCALLY_COMPACT_IMP_COMPLETELY_METRIZABLE_SPACE ← prove
   r"!top:A topology.
        metrizable_space top /\ locally_compact_space top
        ==> completely_metrizable_space top"
   (REWRITE_TAC [IMP_CONJ, FORALL_METRIZABLE_SPACE] THEN
    X_GEN_TAC (← q r"m:A metric") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"m:A metric") METRIC_COMPLETION) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m':(A->real)metric", ← q r"f:A->A->real"] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"mtopology m homeomorphic_space
      subtopology (mtopology m') (IMAGE (f:A->A->real) (mspace m))")
    ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"m:A metric", ← q r"m':(A->real)metric", ← q r"f:A->A->real"]
          ISOMETRY_IMP_EMBEDDING_MAP) THEN
      ASM_SIMP_TAC [SUBSET_REFL] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE) THEN
      REWRITE_TAC [TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    FIRST_ASSUM (SUBST1_TAC o
      MATCH_MP HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE) THEN
    FIRST_X_ASSUM (MP_TAC o
      MATCH_MP HOMEOMORPHIC_LOCALLY_COMPACT_SPACE) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] (← REWRITE_RULE [CONJ_ASSOC]
          LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF))) THEN
    ASM_REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY, SUBTOPOLOGY_MSPACE] THEN
    ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_TAC THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_OPEN_IN THEN
    ASM_SIMP_TAC [COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY])

  let COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN ← prove
   r"!top s:A->bool.
        metrizable_space top /\ s SUBSET topspace top /\
        completely_metrizable_space (subtopology top s)
        ==> gdelta_in top s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool",
                      ← q r"subtopology top s:A topology", ← q r"\x:A. x"]
          LAVRENTIEV_EXTENSION) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"f:A->A"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s:A->bool = u") (fun th => ASM_REWRITE_TAC [th]) THEN
    ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, GDELTA_IN_SUBSET] THEN
    MATCH_MP_TAC (← SET_RULE (← q
      r"(!x. x IN u ==> f x = x) ==> IMAGE f u SUBSET s ==> u SUBSET s")) THEN
    MP_TAC (← ISPECL
     [← q r"subtopology top u:A topology", ← q r"subtopology top u:A topology",
      ← q r"f:A->A", ← q r"\x:A. x"] FORALL_IN_CLOSURE_OF_EQ) THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY, CONTINUOUS_MAP_ID, ← SET_RULE (← q
     r"s SUBSET u ==> u INTER s = s")] THEN
    ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY,
                  METRIZABLE_IMP_HAUSDORFF_SPACE] THEN
    UNDISCH_TAC
     (← q r"continuous_map (subtopology top u,subtopology top s) (f:A->A)") THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN ASM SET_TAC [])

  return { OPEN_HOMEOMORPHIC_SPACE_CLOSED_IN_PRODUCT, COMPLETELY_METRIZABLE_SPACE_GDELTA_IN_ALT,
           COMPLETELY_METRIZABLE_SPACE_GDELTA_IN, COMPLETELY_METRIZABLE_SPACE_OPEN_IN,
           LOCALLY_COMPACT_IMP_COMPLETELY_METRIZABLE_SPACE,
           COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN }

/- ------------------------------------------------------------------------- -/
/- Locally compact subspaces of metrizable spaces are G-delta; paracompact   -/
/- spaces.  (metric.ml 41796-41932)                                          -/
/- ------------------------------------------------------------------------- -/

structure PARA1 where
  LOCALLY_COMPACT_SPACE_IMP_GDELTA_IN : thm
  COMPLETELY_METRIZABLE_SPACE_EQ_GDELTA_IN : thm
  GDELTA_IN_EQ_COMPLETELY_METRIZABLE_SPACE : thm
  paracompact_space : thm
  COMPACT_IMP_PARACOMPACT_SPACE : thm
  PARACOMPACT_SPACE_CLOSED_SUBSET : thm
  PARACOMPACT_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_PARACOMPACT_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupPARA1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BIterLocal : IterLocal) (BContMap1 : ContMap1) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BCompact1 : Compact1)
    (BFsigmaGdelta : FsigmaGdelta) (BMetrizable : Metrizable) (BCMS1 : CMS1) (BCMS2 : CMS2) :
    ExceptT String IO PARA1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXISTS_IN_INSERT, EXISTS_SUBSET_IMAGE, FINITE_IMAGE,
        FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT,
        FORALL_SUBSET_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTER_SUBSET, INTER_UNIONS, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_REFL, SUBSET_RESTRICT, UNIONS_GSPEC,
        UNIONS_INSERT, .. } := D.core4
  let { CLOSED_IN_SUBSET, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } :=
    BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { FINITE_IMP_LOCALLY_FINITE_IN, LOCALLY_FINITE_IN_REFINEMENT, LOCALLY_FINITE_IN_SUBSET,
        LOCALLY_FINITE_IN_SUBTOPOLOGY, locally_finite_in, .. } := BIterLocal
  let { OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP, retraction_map, retraction_maps, .. } :=
    BRetraction
  let { COMPACT_SPACE, .. } := BCompact1
  let { GDELTA_IN_ALT, .. } := BFsigmaGdelta
  let { METRIZABLE_SPACE_SUBTOPOLOGY, .. } := BMetrizable
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, .. } := BCMS1
  let { COMPLETELY_METRIZABLE_SPACE_GDELTA_IN, COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN,
        LOCALLY_COMPACT_IMP_COMPLETELY_METRIZABLE_SPACE, .. } := BCMS2
  -- @@SCOPE END

  let LOCALLY_COMPACT_SPACE_IMP_GDELTA_IN ← prove
   r"!top s:A->bool.
        metrizable_space top /\
        s SUBSET topspace top /\
        locally_compact_space(subtopology top s)
        ==> gdelta_in top s"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LOCALLY_COMPACT_IMP_COMPLETELY_METRIZABLE_SPACE THEN
    ASM_SIMP_TAC [METRIZABLE_SPACE_SUBTOPOLOGY])

  let COMPLETELY_METRIZABLE_SPACE_EQ_GDELTA_IN ← prove
   r"!top s:A->bool.
        completely_metrizable_space top /\ s SUBSET topspace top
        ==> (completely_metrizable_space (subtopology top s) <=>
             gdelta_in top s)"
   (MESON_TAC [COMPLETELY_METRIZABLE_SPACE_GDELTA_IN,
               COMPLETELY_METRIZABLE_SPACE_IMP_GDELTA_IN,
               COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE])

  let GDELTA_IN_EQ_COMPLETELY_METRIZABLE_SPACE ← prove
   r"!top s:A->bool.
        completely_metrizable_space top
        ==> (gdelta_in top s <=>
             s SUBSET topspace top /\
             completely_metrizable_space (subtopology top s))"
   (MESON_TAC [GDELTA_IN_ALT, COMPLETELY_METRIZABLE_SPACE_EQ_GDELTA_IN])

  -- Paracompact spaces.

  let paracompact_space ← new_definition
   r"paracompact_space (top:A topology) <=>
        !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
            ==> ?V. (!v. v IN V ==> open_in top v) /\
                    UNIONS V = topspace top /\
                    (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                    locally_finite_in top V"

  let COMPACT_IMP_PARACOMPACT_SPACE ← prove
   r"!top:A topology. compact_space top ==> paracompact_space top"
   (GEN_TAC THEN REWRITE_TAC [COMPACT_SPACE, paracompact_space] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"V:(A->bool)->bool") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [FINITE_IMP_LOCALLY_FINITE_IN, SUBSET_REFL] THEN
    ASM_MESON_TAC [SUBSET, OPEN_IN_TOPSPACE])

  let PARACOMPACT_SPACE_CLOSED_SUBSET ← prove
   r"!top s:A->bool.
        paracompact_space top /\ closed_in top s
        ==> paracompact_space(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [paracompact_space] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, CLOSED_IN_SUBSET] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [EXISTS_SUBSET_IMAGE] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
    REWRITE_TAC [← SET_RULE (← q
     r"(s:A->bool) SUBSET {x | P x} <=> !x. x IN s ==> P x")] THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [← SET_RULE (← q
     r"(s:A->bool) INTER t = s <=> s SUBSET t")] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(topspace top DIFF s:A->bool) INSERT U")) THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, EXISTS_IN_INSERT, UNIONS_INSERT] THEN
    ANTS_TAC THENL
    [ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
     RULE_ASSUM_TAC (REWRITE_RULE [OPEN_IN_CLOSED_IN_EQ]) THEN ASM SET_TAC [],
     DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"{v:A->bool | v IN V /\ ~(v SUBSET topspace top DIFF s)}") THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC] THEN REPEAT CONJ_TAC THENL
    [RULE_ASSUM_TAC (REWRITE_RULE [OPEN_IN_CLOSED_IN_EQ]) THEN ASM SET_TAC [],
     ASM SET_TAC [],
     MATCH_MP_TAC LOCALLY_FINITE_IN_SUBTOPOLOGY THEN
     REWRITE_TAC [FORALL_IN_GSPEC, INTER_SUBSET] THEN
     MATCH_MP_TAC LOCALLY_FINITE_IN_REFINEMENT THEN
     REWRITE_TAC [INTER_SUBSET] THEN
     FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
        (← REWRITE_RULE [IMP_CONJ] LOCALLY_FINITE_IN_SUBSET)) THEN
     REWRITE_TAC [SUBSET_RESTRICT]])

  let PARACOMPACT_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ paracompact_space top
        ==> paracompact_space top'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [paracompact_space, locally_finite_in] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [retraction_map]) THEN
    REWRITE_TAC [retraction_maps, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"s:B->A") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"U:(B->bool)->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{{x | x IN topspace top /\ (r:A->B) x IN u} | u IN U}")) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_CONTINUOUS_MAP_PREIMAGE], ALL_TAC] THEN
      REWRITE_TAC [UNIONS_GSPEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC
     (← q r"{{y | y IN topspace top' /\ (s:B->A) y IN v} | v IN V}") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_CONTINUOUS_MAP_PREIMAGE],
      REWRITE_TAC [UNIONS_GSPEC] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      ASM SET_TAC [],
      X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(s:B->A) y")) THEN ANTS_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{y | y IN topspace top' /\ (s:B->A) y IN w}") THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_CONTINUOUS_MAP_PREIMAGE],
        ASM SET_TAC [],
        REWRITE_TAC [← SET_RULE (← q
         r"{y:B | y IN {(f:A->B) x | x IN s} /\ P y} =
          IMAGE f {x | x IN s /\ P(f x)}")] THEN
        MATCH_MP_TAC FINITE_IMAGE THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
        ASM SET_TAC []]])

  let HOMEOMORPHIC_PARACOMPACT_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (paracompact_space top <=> paracompact_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    MESON_TAC [PARACOMPACT_SPACE_RETRACTION_MAP_IMAGE])

  return { LOCALLY_COMPACT_SPACE_IMP_GDELTA_IN, COMPLETELY_METRIZABLE_SPACE_EQ_GDELTA_IN,
           GDELTA_IN_EQ_COMPLETELY_METRIZABLE_SPACE, paracompact_space,
           COMPACT_IMP_PARACOMPACT_SPACE, PARACOMPACT_SPACE_CLOSED_SUBSET,
           PARACOMPACT_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_PARACOMPACT_SPACE }

/- ------------------------------------------------------------------------- -/
/- Paracompact Hausdorff spaces; sigma-locally-finite families.              -/
/- (metric.ml 41934-42070)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PARA2 where
  PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE : thm
  PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE : thm
  sigma_locally_finite_in : thm
  COUNTABLE_IMP_SIGMA_LOCALLY_FINITE_IN : thm
  deriving Inhabited

@[nospecialize]
def setupPARA2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BIterLocal : IterLocal) (BHausdorff1 : Hausdorff1) (BRegular1 : Regular1)
    (BNormal1 : Normal1) (BPARA1 : PARA1) : ExceptT String IO PARA2 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, DISJOINT_SYM, EMPTY_GSPEC, EMPTY_UNIONS, EXISTS_IN_GSPEC, EXTENSION,
        FINITE_EMPTY, FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_INSERT, IMAGE,
        IMAGE_CONST, .. } := D.core1
  let { INTER_UNIONS, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET, UNIONS_1, UNIONS_GSPEC, UNIONS_IMAGE,
        UNIONS_INSERT, UNIONS_SUBSET, UNIV_NOT_EMPTY, UNWIND_THM2, .. } := D.core4
  let { EXISTS_OR_THM, RIGHT_IMP_EXISTS_THM, RIGHT_OR_DISTRIB, SWAP_EXISTS_THM, .. } := D.core5
  let { COUNTABLE_AS_IMAGE, .. } := D.lib
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } :=
    BTopology
  let { CLOSURE_OF_SUBSET, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := BClosure
  let { CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES, LOCALLY_FINITE_IN_SUBSET,
        locally_finite_in, .. } := BIterLocal
  let { hausdorff_space, .. } := BHausdorff1
  let { regular_space, .. } := BRegular1
  let { normal_space, .. } := BNormal1
  let { paracompact_space, .. } := BPARA1
  -- @@SCOPE END

  let (PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE,
       PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE) ← do
    let lemma ← prove
     r"!(top:A topology) (s:A->bool) (t:A->bool).
          paracompact_space top /\
          closed_in top s /\ t SUBSET topspace top /\
          (!x. x IN s
               ==> ?u v. open_in top u /\ open_in top v /\
                         x IN u /\ t SUBSET v /\ DISJOINT u v)
          ==> ?u v. open_in top u /\ open_in top v /\
                    s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
     (REPEAT GEN_TAC THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"uu:A->A->bool", ← q r"vv:A->A->bool"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
      DISCH_THEN (MP_TAC o SPEC
       (← q r"(topspace top DIFF s) INSERT {(uu:A->A->bool) x | x IN s}")) THEN
      ANTS_TAC THENL
       [ASM_SIMP_TAC [FORALL_IN_INSERT, FORALL_IN_GSPEC, UNIONS_INSERT] THEN
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN MATCH_MP_TAC (← SET_RULE (← q
         r"(s:A->bool) SUBSET u /\ u SUBSET t ==> (t DIFF s) UNION u = t")) THEN
        REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [OPEN_IN_SUBSET]],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INSERT]] THEN
      X_GEN_TAC (← q r"w:(A->bool)->bool") THEN
      REWRITE_TAC [RIGHT_OR_DISTRIB, EXISTS_OR_THM, UNWIND_THM2] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN REWRITE_TAC [← SET_RULE (← q
       r"(!x:A. x IN s ==> P x \/ Q x) <=>
        (!x. x IN {y | y IN s /\ ~P y} ==> Q x)")] THEN
      ABBREV_TAC
       (← q r"w' = {t:A->bool | t IN w /\ ~(t SUBSET topspace top DIFF s)}") THEN
      STRIP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"UNIONS w':A->bool",
        ← q r"topspace top DIFF UNIONS {top closure_of t | t IN w'}:A->bool"] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_UNIONS THEN EXPAND_TAC "w'" THEN ASM SET_TAC [],
        MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        MATCH_MP_TAC CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES THEN
        MATCH_MP_TAC LOCALLY_FINITE_IN_SUBSET THEN
        EXISTS_TAC (← q r"w:(A->bool)->bool") THEN ASM SET_TAC [],
        EXPAND_TAC "w'" THEN REWRITE_TAC [UNIONS_GSPEC] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC [← SET_RULE (← q
         r"(t:A->bool) SUBSET s DIFF u <=> t SUBSET s /\ t INTER u = {}")] THEN
        REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS] THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool"))) THEN
        ASM_REWRITE_TAC [] THEN
        REPEAT (ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC]) THEN
        REPEAT DISCH_TAC THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
        ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
         r"(t:A->bool) SUBSET t' ==> t' INTER u = {} ==> t INTER u = {}"))) THEN
        ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY] THEN ASM SET_TAC [],
        MATCH_MP_TAC (← SET_RULE (← q
         r"(s:A->bool) SUBSET t ==> DISJOINT s (u DIFF t)")) THEN
        MATCH_MP_TAC (← SET_RULE (← q
         r"(!(s:A->bool). s IN u ==> s SUBSET f s)
          ==> UNIONS u SUBSET UNIONS {f s | s IN u}")) THEN
        EXPAND_TAC "w'" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET]])
    CONJ_PAIR (← prove
     r"(!top:A topology.
        paracompact_space top /\ hausdorff_space top
        ==> regular_space top) /\
   (!top:A topology.
        paracompact_space top /\ (hausdorff_space top \/ regular_space top)
        ==> normal_space top)"
     (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"top:A topology") THEN
      REWRITE_TAC [← TAUT (← q
       r"(p /\ h ==> r) /\ (p /\ (h \/ r) ==> n) <=>
        p ==> (h ==> r) /\ (r ==> n)")] THEN
      DISCH_TAC THEN
      REWRITE_TAC [hausdorff_space, regular_space, normal_space] THEN
      REWRITE_TAC [← GSYM SING_SUBSET] THEN REPEAT STRIP_TAC THENL
       [ONCE_REWRITE_TAC [← TAUT (← q
         r"p /\ q /\ r /\ s /\ t <=> q /\ p /\ s /\ r /\ t")] THEN
        ONCE_REWRITE_TAC [DISJOINT_SYM] THEN
        GEN_REWRITE_TAC id [SWAP_EXISTS_THM] THEN
        MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL [ASM SET_TAC [], REPEAT STRIP_TAC] THEN
        REWRITE_TAC [← GSYM SING_SUBSET] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
        MATCH_MP_TAC lemma THEN ASM_SIMP_TAC [CLOSED_IN_SUBSET] THEN
        REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM SING_SUBSET] THEN
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
        ASM SET_TAC []]))

  let sigma_locally_finite_in ← new_definition
   r"sigma_locally_finite_in (top:A topology) (U:(A->bool)->bool) <=>
        ?f. (!n:num. locally_finite_in top (f n)) /\
            U = UNIONS {f n | n IN (:num)}"

  -- Helper: Countable collection with elements in topspace is
  -- sigma-locally-finite. Each {u} is l.f., so take f(n) = {V_n}.
  let COUNTABLE_IMP_SIGMA_LOCALLY_FINITE_IN ← prove
   r"!top:A topology U.
        COUNTABLE U /\ (!u. u IN U ==> u SUBSET topspace top)
        ==> sigma_locally_finite_in top U"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [sigma_locally_finite_in] THEN
    ASM_CASES_TAC (← q r"U:(A->bool)->bool = {}") THENL
    [EXISTS_TAC (← q r"(\n:num. {}:(A->bool)->bool)") THEN
     REWRITE_TAC [locally_finite_in, NOT_IN_EMPTY, FINITE_EMPTY] THEN
     REWRITE_TAC [SIMPLE_IMAGE, IMAGE_CONST, UNIV_NOT_EMPTY] THEN
     CONJ_TAC THENL
     [GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
      REWRITE_TAC [OPEN_IN_TOPSPACE, EMPTY_GSPEC, FINITE_EMPTY] THEN
      ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [UNIONS_1]],
     ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"U:(A->bool)->bool") COUNTABLE_AS_IMAGE) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"V:num->A->bool") (ASSUME_TAC o SYM)) THEN
    EXISTS_TAC (← q r"(\n:num. {(V:num->A->bool) n})") THEN CONJ_TAC THENL
    [X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [locally_finite_in, IN_SING] THEN
     CONJ_TAC THENL
     [GEN_TAC THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN MESON_TAC [],
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"topspace top:A->bool") THEN
      REWRITE_TAC [OPEN_IN_TOPSPACE] THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{(V:num->A->bool) n}") THEN
      REWRITE_TAC [FINITE_SING, IN_SING, SUBSET, IN_ELIM_THM] THEN
      GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC []],
     /- Goal: UNIONS (IMAGE (\n. {V n}) (:num)) = IMAGE V (:num) -/
     REWRITE_TAC [SIMPLE_IMAGE] THEN FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
     REWRITE_TAC [UNIONS_IMAGE, EXTENSION, IN_ELIM_THM, IN_SING, IN_UNIV] THEN
     REWRITE_TAC [IMAGE, IN_UNIV, IN_ELIM_THM] THEN SET_TAC []])

  return { PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE,
           sigma_locally_finite_in, COUNTABLE_IMP_SIGMA_LOCALLY_FINITE_IN }

/- ------------------------------------------------------------------------- -/
/- Metric covers have sigma-locally-finite refinements.                      -/
/- (metric.ml 42072-42369)                                                    -/
/- ------------------------------------------------------------------------- -/

structure MCSLF where
  METRIC_COVER_SIGMA_LOCALLY_FINITE : thm
  deriving Inhabited

@[nospecialize]
def setupMCSLF [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetricArith : MetricArithB)
    (BPARA2 : PARA2) : ExceptT String IO MCSLF := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FINITE_EMPTY, FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_ELIM_THM, IN_UNIONS, IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ARCH_INV, REAL_INV_MUL, REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_MUL, REAL_LE_TRANS,
        REAL_LT_ADD2, REAL_LT_IMP_LE, REAL_LT_INV, REAL_LT_MUL, REAL_MUL_LINV, REAL_NOT_LT,
        REAL_OF_NUM_LE, REAL_OF_NUM_LT, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, UNIONS_GSPEC, UNIONS_SUBSET, .. } := D.core4
  let { SKOLEM_THM_GEN, .. } := D.core5
  let { WO, WOSET, .. } := D.lib
  let { OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { IN_MBALL, MBALL_SUBSET_CONCENTRIC, MBALL_SUBSET_MSPACE, MDIST_REFL, MDIST_SYM,
        MDIST_TRIANGLE, .. } := BMetricSpace
  let { OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { sigma_locally_finite_in, .. } := BPARA2
  -- @@SCOPE END

  -- Munkres Lemma 39.2: Metric covers have sigma-locally-finite refinements
  -- Key construction for Stone's theorem using well-ordering
  let METRIC_COVER_SIGMA_LOCALLY_FINITE ← do
    let WELL_ORDER_CHOICE ← prove
     r"!(U:(A->bool)->bool).
      ?first. !x. x IN UNIONS U ==>
        first x IN U /\ x IN first x /\
        !y. y IN UNIONS U
            ==> y IN first x /\ x IN first y ==> first x = first y"
     (GEN_TAC THEN
      MP_TAC (← ISPEC (← q r"U:(A->bool)->bool") WO) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"lt:(A->bool)->(A->bool)->bool")
        (CONJUNCTS_THEN2
           (ASSUME_TAC o GEN_REWRITE_RULE id [WOSET])
           (fun th =>
             RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th]))) THEN
      FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "min")) THEN
      SUBGOAL_THEN
        (← q r"!x:A. x IN UNIONS U ==>
          ?u. u IN U /\ x IN u /\
              !v. v IN U /\ x IN v ==> (lt:(A->bool)->(A->bool)->bool) u v")
        MP_TAC THENL
      [X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_UNIONS] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"u0:A->bool") STRIP_ASSUME_TAC) THEN
       USE_THEN "min" (MP_TAC o SPEC (← q r"{u:A->bool | u IN U /\ x IN u}")) THEN
       ANTS_TAC THENL
       [CONJ_TAC THENL [SET_TAC [], ASM SET_TAC []], SET_TAC []],
       ALL_TAC] THEN REWRITE_TAC [SKOLEM_THM_GEN] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"first:A->(A->bool)") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"first:A->(A->bool)") THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      ASM_MESON_TAC [])
    let METRIC_TRIANGLE_LOWER ← prove
     r"!m:A metric x1 x2 p q.
      x1 IN mspace m /\ x2 IN mspace m /\ p IN mspace m /\ q IN mspace m
      ==> mdist m (x1, x2) - mdist m (p, x1) - mdist m (q, x2)
          <= mdist m (p, q)"
     (CONV_TAC (fun t => METRIC_ARITH t))
    let COVER_SEPARATION ← prove
     r"!m:A metric n (x1:A) (x2:A) (p:A) (q:A) (u1:A->bool).
      x1 IN mspace m /\ x2 IN mspace m /\ p IN mspace m /\ q IN mspace m /\
      mball m (x1, inv(&(n + 1))) SUBSET u1 /\
      ~(x2 IN u1) /\
      mdist m (p, x1) < inv(&3 * &(n + 1)) /\
      mdist m (q, x2) < inv(&3 * &(n + 1))
      ==> inv(&3 * &(n + 1)) <= mdist m (p, q)"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      MATCH_MP_TAC REAL_LE_TRANS THEN
      EXISTS_TAC
        (← q r"mdist m (x1:A, x2) - mdist m (p:A, x1) - mdist m (q:A, x2)") THEN
      CONJ_TAC THENL
      [SUBGOAL_THEN (← q r"inv(&(n + 1)) <= mdist m (x1:A, x2)") MP_TAC THENL
       [REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"~(x2:A IN u1)") THEN REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
        REWRITE_TAC [IN_MBALL] THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
       SUBGOAL_THEN (← q r"inv(&(n + 1)) = &3 * inv(&3 * &(n + 1))") SUBST1_TAC THENL
       [REWRITE_TAC [REAL_INV_MUL] THEN
        SUBGOAL_THEN (← q r"~(&3 = &0)")
          (fun th => SIMP_TAC [th, REAL_MUL_LINV]) THENL
        [REAL_ARITH_TAC, REAL_ARITH_TAC],
        ASM_REAL_ARITH_TAC],
       MATCH_MP_TAC METRIC_TRIANGLE_LOWER THEN ASM_REWRITE_TAC []])
    prove
     r"!m:A metric U.
        (!u. u IN U ==> open_in (mtopology m) u) /\
        UNIONS U = mspace m
        ==> ?V. (!v. v IN V ==> open_in (mtopology m) v) /\
                UNIONS V = mspace m /\
                (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                sigma_locally_finite_in (mtopology m) V"
     (REPEAT STRIP_TAC THEN
      /- Get canonical well-ordered choice function -/
      MP_TAC (← ISPEC (← q r"U:(A->bool)->bool") WELL_ORDER_CHOICE) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"first:A->(A->bool)") (LABEL_TAC "first_prop")) THEN
      /- Define E(n,u) = union of balls of radius 1/(3(n+1)) centered at
         points whose 1/(n+1)-ball fits in u and whose first choice is u -/
      ABBREV_TAC
        (← q r"E = \n (u:A->bool). UNIONS {mball m (x:A, inv(&3 * &(n + 1))) | x |
          x IN mspace m /\ mball m (x, inv(&(n + 1))) SUBSET u /\
          (first:A->(A->bool)) x = u}") THEN
      /- V includes all E(n,u) for n and u IN U -/
      EXISTS_TAC (← q r"{v:A->bool | ?n (u:A->bool). u IN U /\
        v = (E:num->(A->bool)->(A->bool)) n u}") THEN
      /- Helper: first(x) IN U and x IN first(x) -/
      SUBGOAL_THEN (← q r"!x:A. x IN mspace m ==>
        (first:A->(A->bool)) x IN U /\ x IN first x") ASSUME_TAC THENL
      [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
       USE_THEN "first_prop" (MP_TAC o SPEC (← q r"x:A")) THEN
       ANTS_TAC THENL [ASM_MESON_TAC [EXTENSION, IN_UNIONS], SIMP_TAC []],
       ALL_TAC] THEN
      /- Helper: x IN E(n, first(x)) when ball fits -/
      SUBGOAL_THEN
        (← q r"!x:A n. x IN mspace m /\
                 mball m (x, inv(&(n + 1))) SUBSET (first:A->(A->bool)) x
         ==> x IN (E:num->(A->bool)->(A->bool)) n (first x)") ASSUME_TAC THENL
      [REPEAT STRIP_TAC THEN EXPAND_TAC "E" THEN
       REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
       EXISTS_TAC (← q r"mball m (x:A, inv(&3 * &(n + 1)))") THEN
       CONJ_TAC THENL
       [EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [IN_MBALL] THEN ASM_SIMP_TAC [MDIST_REFL] THEN
        MATCH_MP_TAC REAL_LT_INV THEN
        MATCH_MP_TAC REAL_LT_MUL THEN REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC],
       ALL_TAC] THEN
      /- Helper: E(n,u) SUBSET u -/
      SUBGOAL_THEN
        (← q r"!n (u:A->bool). (E:num->(A->bool)->(A->bool)) n u SUBSET u")
        ASSUME_TAC THENL
      [REPEAT GEN_TAC THEN EXPAND_TAC "E" THEN
       REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
       X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
       MATCH_MP_TAC SUBSET_TRANS THEN
       EXISTS_TAC (← q r"mball m (x:A, inv(&(n + 1)))") THEN ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN MATCH_MP_TAC REAL_LE_INV2 THEN
       CONJ_TAC THENL
       [REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC,
        REWRITE_TAC [← REAL_ARITH (← q r"x <= &3 * x <=> &0 <= &2 * x")] THEN
        MATCH_MP_TAC REAL_LE_MUL THEN REWRITE_TAC [REAL_OF_NUM_LE] THEN ARITH_TAC],
       ALL_TAC] THEN
      /- Property 1: open -/
      CONJ_TAC THENL
      [REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
       EXPAND_TAC "E" THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
       REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
       REWRITE_TAC [OPEN_IN_MBALL],
       ALL_TAC] THEN
      /- Property 2: covering -/
      CONJ_TAC THENL
      [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, IN_ELIM_THM] THEN
        REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "E" THEN REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        REPEAT STRIP_TAC THEN REWRITE_TAC [MBALL_SUBSET_MSPACE],
        /- x IN mspace m ==> x IN UNIONS V -/
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        SUBGOAL_THEN (← q r"open_in (mtopology m) ((first:A->(A->bool)) x)") MP_TAC THENL
        [ASM_MESON_TAC [], REWRITE_TAC [OPEN_IN_MTOPOLOGY]] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_SIMP_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPEC (← q r"r:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
          (← q r"mball m (x:A, inv(&(N + 1))) SUBSET (first:A->(A->bool)) x")
          ASSUME_TAC THENL
        [MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"mball m (x:A, r)") THEN
         ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN
         MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"inv(&N)") THEN
         ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN MATCH_MP_TAC REAL_LE_INV2 THEN
         REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_LE] THEN ASM_ARITH_TAC,
         ALL_TAC] THEN
        EXISTS_TAC (← q r"(E:num->(A->bool)->(A->bool)) N ((first:A->(A->bool)) x)") THEN
        CONJ_TAC THENL
        [EXISTS_TAC (← q r"N:num") THEN EXISTS_TAC (← q r"(first:A->(A->bool)) x") THEN
         ASM_SIMP_TAC [],
         ASM_SIMP_TAC []]],
       ALL_TAC] THEN
      /- Property 3: refinement -/
      CONJ_TAC THENL
      [REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
       EXISTS_TAC (← q r"u:A->bool") THEN ASM_MESON_TAC [],
       ALL_TAC] THEN
      /- Property 4: sigma locally finite -/
      REWRITE_TAC [sigma_locally_finite_in, TOPSPACE_MTOPOLOGY] THEN
      EXISTS_TAC (← q r"\n. {(E:num->(A->bool)->(A->bool)) n u | u | u IN U}") THEN
      CONJ_TAC THENL
      [X_GEN_TAC (← q r"n:num") THEN
       REWRITE_TAC [locally_finite_in, TOPSPACE_MTOPOLOGY] THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        ASM_MESON_TAC [SUBSET_TRANS, OPEN_IN_SUBSET, TOPSPACE_MTOPOLOGY],
        ALL_TAC] THEN
       /- For each a in mspace m, B(a, inv(6(n+1))) meets at most one E(n,u) -/
       X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
       EXISTS_TAC (← q r"mball m (a:A, inv(&6 * &(n + 1)))") THEN
       REWRITE_TAC [OPEN_IN_MBALL] THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_MBALL] THEN ASM_SIMP_TAC [MDIST_REFL] THEN
        MATCH_MP_TAC REAL_LT_INV THEN
        MATCH_MP_TAC REAL_LT_MUL THEN REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC,
        ALL_TAC] THEN
       MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"{(E:num->(A->bool)->(A->bool)) n u | u |
         u IN U /\ ~(E n u INTER mball m (a:A, inv(&6 * &(n + 1))) = {})}") THEN
       CONJ_TAC THENL
       [ALL_TAC,
        SET_TAC []] THEN
       ASM_CASES_TAC
         (← q r"{(E:num->(A->bool)->(A->bool)) n u | u |
           u IN U /\ ~(E n u INTER mball m (a:A, inv(&6 * &(n + 1))) = {})} = {}")
       THENL [ASM_REWRITE_TAC [FINITE_EMPTY], ALL_TAC] THEN
       FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
       REWRITE_TAC [IN_ELIM_THM] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"v0:A->bool")
         (X_CHOOSE_THEN (← q r"u0:A->bool") STRIP_ASSUME_TAC)) THEN
       SUBGOAL_THEN
         (← q r"{(E:num->(A->bool)->(A->bool)) n u | u |
           u IN U /\ ~(E n u INTER mball m (a:A, inv(&6 * &(n + 1))) = {})} =
          {E n u0}")
         (fun th => REWRITE_TAC [th, FINITE_SING]) THEN
       MATCH_MP_TAC (← SET_RULE (← q
         r"(a:A) IN s /\ (!y. y IN s ==> y = a) ==> s = {a}")) THEN
       CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"u0:A->bool") THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN
       REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"w:A->bool") THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"u1:A->bool") STRIP_ASSUME_TAC) THEN
       ASM_REWRITE_TAC [] THEN
       ASM_CASES_TAC (← q r"u0:A->bool = u1") THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
       /- Get witnesses: p in E(n,u0) INTER B(a,r6), q in E(n,u1) INTER B(a,r6) -/
       SUBGOAL_THEN
         (← q r"?p:A. p IN (E:num->(A->bool)->(A->bool)) n u0 /\
                p IN mball m (a, inv(&6 * &(n + 1)))")
         STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
       SUBGOAL_THEN
         (← q r"?q:A. q IN (E:num->(A->bool)->(A->bool)) n u1 /\
                q IN mball m (a, inv(&6 * &(n + 1)))")
         STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
       /- Extract x1 from E(n,u0): x1 in T(n,u0) with p near x1 -/
       SUBGOAL_THEN
         (← q r"?x1:A. x1 IN mspace m /\ mball m (x1, inv(&(n + 1))) SUBSET u0 /\
                 (first:A->(A->bool)) x1 = u0 /\
                 p IN mball m (x1, inv(&3 * &(n + 1)))")
         STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"p:A IN (E:num->(A->bool)->(A->bool)) n u0") THEN
        EXPAND_TAC "E" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool")
          (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x1:A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"x1:A") THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
       /- Extract x2 from E(n,u1): x2 in T(n,u1) with q near x2 -/
       SUBGOAL_THEN
         (← q r"?x2:A. x2 IN mspace m /\ mball m (x2, inv(&(n + 1))) SUBSET u1 /\
                 (first:A->(A->bool)) x2 = u1 /\
                 q IN mball m (x2, inv(&3 * &(n + 1)))")
         STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"q:A IN (E:num->(A->bool)->(A->bool)) n u1") THEN
        EXPAND_TAC "E" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool")
          (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x2:A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"x2:A") THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
       /- p, q in mspace m -/
       SUBGOAL_THEN (← q r"p:A IN mspace m /\ q:A IN mspace m") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [IN_MBALL, MBALL_SUBSET_MSPACE, SUBSET], ALL_TAC] THEN
       /- d(p,q) < inv(3(n+1)) via triangle inequality through a -/
       SUBGOAL_THEN (← q r"mdist m (p:A, q) < inv(&3 * &(n + 1))") ASSUME_TAC THENL
       [MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"mdist m (p:A, a) + mdist m (a:A, q)") THEN CONJ_TAC THENL
        [ASM_MESON_TAC [MDIST_TRIANGLE], ALL_TAC] THEN
        SUBGOAL_THEN
          (← q r"inv(&3 * &(n + 1)) = inv(&6 * &(n + 1)) + inv(&6 * &(n + 1))")
          SUBST1_TAC THENL
        [REWRITE_TAC [← REAL_ARITH (← q r"a = b + b <=> a = &2 * b")] THEN
         REWRITE_TAC [← REAL_ARITH (← q r"&6 * x = &2 * &3 * x")] THEN
         REWRITE_TAC [REAL_INV_MUL] THEN
         SUBGOAL_THEN (← q r"~(&2 = &0)") (fun th => SIMP_TAC [th, REAL_MUL_LINV]) THENL
         [REAL_ARITH_TAC, REAL_ARITH_TAC],
         MATCH_MP_TAC REAL_LT_ADD2 THEN CONJ_TAC THENL
         [UNDISCH_TAC (← q r"p:A IN mball m (a:A, inv(&6 * &(n + 1)))") THEN
          REWRITE_TAC [IN_MBALL] THEN MESON_TAC [MDIST_SYM],
          UNDISCH_TAC (← q r"q:A IN mball m (a:A, inv(&6 * &(n + 1)))") THEN
          REWRITE_TAC [IN_MBALL] THEN MESON_TAC []]],
        ALL_TAC] THEN
       /- By WELL_ORDER_CHOICE: ~(x2 IN u0) \/ ~(x1 IN u1) -/
       SUBGOAL_THEN (← q r"~(x2:A IN u0) \/ ~(x1:A IN u1)") MP_TAC THENL
       [USE_THEN "first_prop" (MP_TAC o SPEC (← q r"x1:A")) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [EXTENSION, IN_UNIONS], ALL_TAC] THEN
        DISCH_THEN (MP_TAC o CONJUNCT2 o CONJUNCT2) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x2:A")) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [EXTENSION, IN_UNIONS], ALL_TAC] THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
       /- Extract explicit distance bounds from mball membership -/
       SUBGOAL_THEN (← q r"mdist m (p:A, x1) < inv(&3 * &(n + 1))") ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"p:A IN mball m (x1:A, inv (&3 * &(n + 1)))") THEN
        REWRITE_TAC [IN_MBALL] THEN MESON_TAC [MDIST_SYM], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"mdist m (q:A, x2) < inv(&3 * &(n + 1))") ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"q:A IN mball m (x2:A, inv (&3 * &(n + 1)))") THEN
        REWRITE_TAC [IN_MBALL] THEN MESON_TAC [MDIST_SYM], ALL_TAC] THEN
       /- In either case, COVER_SEPARATION gives contradiction -/
       DISCH_THEN DISJ_CASES_TAC THENL
       [/- Case ~(x2 IN u0): separation via u0 -/
        MP_TAC (← ISPECL [← q r"m:A metric", ← q r"n:num", ← q r"x1:A", ← q r"x2:A",
                          ← q r"p:A", ← q r"q:A", ← q r"u0:A->bool"] COVER_SEPARATION) THEN
        ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
        /- Case ~(x1 IN u1): separation via u1, need MDIST_SYM -/
        MP_TAC (← ISPECL [← q r"m:A metric", ← q r"n:num", ← q r"x2:A", ← q r"x1:A",
                          ← q r"q:A", ← q r"p:A", ← q r"u1:A->bool"] COVER_SEPARATION) THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"mdist m (q:A, p) = mdist m (p, q)")
          (fun th => REWRITE_TAC [th]) THENL
        [MATCH_MP_TAC MDIST_SYM THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        ASM_REAL_ARITH_TAC],
       /- V = UNIONS {f n | n IN (:num)} -/
       POP_ASSUM_LIST (K ALL_TAC) THEN
       REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_UNIV, IN_ELIM_THM] THEN
       MESON_TAC []])

  return { METRIC_COVER_SIGMA_LOCALLY_FINITE }

/- ------------------------------------------------------------------------- -/
/- Michael's Lemma, step (1)=>(2).  (metric.ml 42371-42735)                  -/
/- ------------------------------------------------------------------------- -/

structure SLFC where
  SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING : thm
  deriving Inhabited

@[nospecialize]
def setupSLFC [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BPARA2 : PARA2) : ExceptT String IO SLFC := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FINITE_IMAGE, FINITE_NUMSEG_LE, FINITE_SUBSET, FINITE_UNIONS,
        FORALL_IN_GSPEC, .. } := D.core1
  let { INTERS_GSPEC, INTER_COMM, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS,
        IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_DIFF, SUBSET_REFL, SUBSET_TRANS,
        UNIONS_MONO, UNIONS_SUBSET, num_WOP, .. } := D.core4
  let { NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_INTER, OPEN_IN_INTERS, OPEN_IN_UNIONS, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { sigma_locally_finite_in, .. } := BPARA2
  -- @@SCOPE END

  -- Michael's Lemma - Steps (1)=>(2)=>(3)=>(4) from Munkres Lemma 41.3
  -- Step (1)=>(2): Shrinking sigma-l.f. to l.f. covering
  -- The "shrinking trick": S_n(U) = U - UNION_{i<n} V_i where V_i = UNION B_i
  -- Requires elements of B to be open for the proof to work
  let SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING ← prove
   r"!(top:A topology) B.
        (!b. b IN B ==> open_in top b) /\
        sigma_locally_finite_in top B /\
        UNIONS B = topspace top
        ==> ?C. UNIONS C = UNIONS B /\
                locally_finite_in top C /\
                (!c. c IN C ==> ?b. b IN B /\ c SUBSET b)"
   (/- Shrinking trick: For B = UNIONS {Bn(i) | i in N} where each Bn(i) is l.f.,
       define Cn(i) = {b DIFF UNIONS{Bn(j) | j < i} | b IN Bn(i)}.
       The union C = UNIONS{Cn(i) | i} is locally finite.
       Key insight: for x's minimal level n, the nbhd Nn INTER Vn(n) works,
       where Vn(n) = UNIONS(Bn n). For k > n, sets in Cn(k) exclude Vn(n). -/
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    /- Unfold sigma_locally_finite_in to get Bn -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [sigma_locally_finite_in]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"Bn:num->(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- Define the "earlier unions": Vn n = UNIONS {UNIONS (Bn j) | j < n} -/
    ABBREV_TAC
     (← q r"Vn = \n:num. UNIONS {UNIONS ((Bn:num->(A->bool)->bool) j) | j < n}") THEN
    /- Define shrunk sets: Cn n = {b - Vn n | b IN Bn n} -/
    /- Use two-bar syntax {... | b | ...} to only bind b, not n -/
    ABBREV_TAC
     (← q r"Cn = \n:num. {b DIFF (Vn:num->A->bool) n |
                    b | b IN (Bn:num->(A->bool)->bool) n}") THEN
    /- Define C = {c | ?n. c IN Cn n} - flattened form -/
    EXISTS_TAC (← q r"{c:A->bool | ?n:num. c IN (Cn:num->(A->bool)->bool) n}") THEN
    /- Prove: UNIONS C = UNIONS B, locally_finite_in, refinement -/
    REPEAT CONJ_TAC THENL
    [/- UNIONS C = UNIONS B -/
     REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
     [/- UNIONS C SUBSET UNIONS B: each c IN C is c SUBSET b for some b IN B -/
      REWRITE_TAC [UNIONS_SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") MP_TAC) THEN
      EXPAND_TAC "Cn" THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      /- c SUBSET b SUBSET UNIONS B, where b and n are now free -/
      TRANS_TAC SUBSET_TRANS (← q r"b:A->bool") THEN
      CONJ_TAC THENL
      [ASM_REWRITE_TAC [SUBSET_DIFF],
       /- b SUBSET UNIONS B: b IN Bn n, B = UNIONS {Bn k | k} -/
       REWRITE_TAC [SUBSET, IN_UNIONS] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
       EXISTS_TAC (← q r"b:A->bool") THEN ASM_REWRITE_TAC [] THEN
       UNDISCH_THEN
        (← q r"B = UNIONS {(Bn:num->(A->bool)->bool) n | n IN (:num)}")
        SUBST1_TAC THEN
       REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
       EXISTS_TAC (← q r"(Bn:num->(A->bool)->bool) n") THEN
       ASM_REWRITE_TAC [] THEN
       EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [IN_UNIV]],
      /- UNIONS B SUBSET UNIONS C: use WOP for minimal n -/
      REWRITE_TAC [SUBSET, IN_UNIONS] THEN X_GEN_TAC (← q r"x:A") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b1:A->bool") STRIP_ASSUME_TAC) THEN
      /- First get k such that b1 IN Bn k -/
      SUBGOAL_THEN
       (← q r"?k:num. (b1:A->bool) IN (Bn:num->(A->bool)->bool) k")
       STRIP_ASSUME_TAC THENL
      [UNDISCH_TAC (← q r"(b1:A->bool) IN B") THEN
       ASM_REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
       STRIP_TAC THEN
       /- Now have t = Bn n and b1 IN t -/
       EXISTS_TAC (← q r"n:num") THEN
       FIRST_X_ASSUM SUBST_ALL_TAC THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      /- Now x IN b1, b1 IN Bn k. Use WOP to get minimal n with x IN UNIONS(Bn n) -/
      /- num_WOP gives: (?n. P n) <=> (?n. P n /\ !m. m < n ==> ~P m) -/
      /- We need the forward direction, so use EQ_IMP_RULE -/
      MP_TAC (← EQ_IMP_RULE (← BETA_RULE (← SPEC
       (← q r"\n:num. x:A IN UNIONS ((Bn:num->(A->bool)->bool) n)")
       num_WOP))).1 THEN
      ANTS_TAC THENL
      [EXISTS_TAC (← q r"k:num") THEN REWRITE_TAC [IN_UNIONS] THEN
       EXISTS_TAC (← q r"b1:A->bool") THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n0:num") (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC)) THEN
      REWRITE_TAC [IN_UNIONS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b0:A->bool") STRIP_ASSUME_TAC) THEN
      /- x IN b0, b0 IN Bn n0, and !m. m < n0 ==> x NOT IN UNIONS(Bn m) -/
      REWRITE_TAC [IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"b0 DIFF (Vn:num->A->bool) n0") THEN CONJ_TAC THENL
      [/- b0 DIFF Vn n0 IN C, i.e., ?n. b0 DIFF Vn n0 IN Cn n -/
       EXISTS_TAC (← q r"n0:num") THEN EXPAND_TAC "Cn" THEN REWRITE_TAC [IN_ELIM_THM] THEN
       EXISTS_TAC (← q r"b0:A->bool") THEN ASM_REWRITE_TAC [],
       /- x IN b0 DIFF Vn n0 -/
       REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
       [ASM_REWRITE_TAC [],
        /- x NOT IN Vn n0 -/
        EXPAND_TAC "Vn" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"s:A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"j:num")
         (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
        /- Goal: ~(x IN s) where s = UNIONS(Bn j), and we have j < n0 and
           !m. m < n0 ==> ~(x IN UNIONS(Bn m)).
           Need to show x NOT IN UNIONS(Bn j). -/
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:num")) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [IN_UNIONS]]]],
     /- locally_finite_in: For any x, let n0 be minimal with
        x IN UNIONS(Bn n0). By l.f. of Bn i for i <= n0, get
        neighborhoods N_i intersecting finitely many.
        N = (INTERS{N_i | i <= n0}) INTER UNIONS(Bn n0) works.
        For k > n0, Cn k elements are disjoint from UNIONS(Bn n0).
        For k <= n0, Cn k elements hitting N come from Bn k
        elements hitting N_k. -/
     REWRITE_TAC [locally_finite_in] THEN CONJ_TAC THENL
     [/- !u. u IN C ==> u SUBSET topspace top: each element of
         C is b DIFF Vn n, b IN Bn n, so b SUBSET topspace top
         by l.f. of Bn n, hence b DIFF Vn n SUBSET topspace top. -/
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"u:A->bool") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"(u:A->bool) IN (Cn:num->(A->bool)->bool) n") THEN
      EXPAND_TAC "Cn" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"b:A->bool") THEN REWRITE_TAC [SUBSET_DIFF] THEN
      SUBGOAL_THEN
        (← q r"locally_finite_in top ((Bn:num->(A->bool)->bool) n)")
        MP_TAC THENL
      [ASM_MESON_TAC [], ALL_TAC] THEN REWRITE_TAC [locally_finite_in] THEN
      DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"b:A->bool")) THEN
      ASM_REWRITE_TAC [],
      /- Second conjunct: neighborhood finiteness property -/
      /- For x in topspace, find minimal n0 with
         x IN UNIONS(Bn n0). For k > n0, Cn k elements
         exclude x. For k <= n0, use l.f. of Bn k. -/
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?k:num. x IN UNIONS ((Bn:num->(A->bool)->bool) k)") MP_TAC THENL
      [UNDISCH_TAC (← q r"(x:A) IN topspace top") THEN
       UNDISCH_TAC (← q r"UNIONS B = topspace (top:A topology)") THEN
       UNDISCH_TAC (← q r"B = UNIONS {(Bn:num->(A->bool)->bool) n | n IN (:num)}") THEN
       REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
       MESON_TAC [],
       ALL_TAC] THEN
      /- Step 2: Use WOP to get minimal n0 -/
      GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"n0:num") (CONJUNCTS_THEN2 ASSUME_TAC
        (LABEL_TAC "min"))) THEN
      /- Step 3: For each k <= n0, get neighborhood from locally_finite_in (Bn k) -/
      SUBGOAL_THEN
        (← q r"!k:num. k <= n0
                 ==> ?Nk:A->bool. open_in top Nk /\ x IN Nk /\
                     FINITE {b | b IN (Bn:num->(A->bool)->bool) k /\ ~(Nk INTER b = {})}")
        MP_TAC THENL
      [X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
       SUBGOAL_THEN
        (← q r"locally_finite_in top ((Bn:num->(A->bool)->bool) k)")
        MP_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
       REWRITE_TAC [locally_finite_in] THEN
       DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
       EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN
       ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      /- Step 4: Skolemize to get function Nk: num -> A->bool -/
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"Nk:num->A->bool") THEN DISCH_TAC THEN
      /- Step 5: Vn(n0+1) is open - it's a union of unions of open sets -/
      SUBGOAL_THEN (← q r"open_in top ((Vn:num->A->bool) (n0 + 1))") ASSUME_TAC THENL
      [EXPAND_TAC "Vn" THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
       REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
       MATCH_MP_TAC OPEN_IN_UNIONS THEN
       /- Elements of Bn j are in B, hence open -/
       X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
       /- t IN Bn j => t IN B => open_in top t -/
       FIRST_X_ASSUM (fun th => MATCH_MP_TAC th) THEN
       /- Goal: t IN B. Use the specific equation B = UNIONS {...} -/
       UNDISCH_THEN
        (← q r"B = UNIONS {(Bn:num->(A->bool)->bool) n | n IN (:num)}")
        SUBST1_TAC THEN
       REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
       EXISTS_TAC (← q r"(Bn:num->(A->bool)->bool) j") THEN
       ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"j:num") THEN REWRITE_TAC [],
       ALL_TAC] THEN
      /- Step 6: x IN Vn(n0+1) since x IN UNIONS(Bn n0) and n0 < n0+1 -/
      SUBGOAL_THEN (← q r"(x:A) IN (Vn:num->A->bool) (n0 + 1)") ASSUME_TAC THENL
      [EXPAND_TAC "Vn" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
       EXISTS_TAC (← q r"UNIONS ((Bn:num->(A->bool)->bool) n0)") THEN
       ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"n0:num") THEN ARITH_TAC,
       ALL_TAC] THEN
      /- Step 7: Get b0 from x IN UNIONS(Bn n0), and b0 is open -/
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNIONS]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b0:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"open_in top (b0:A->bool)") ASSUME_TAC THENL
      [/- b0 IN Bn n0, so b0 IN B, hence open_in top b0 -/
       FIRST_X_ASSUM (fun th => MATCH_MP_TAC th) THEN
       UNDISCH_THEN
        (← q r"B = UNIONS {(Bn:num->(A->bool)->bool) n | n IN (:num)}")
        SUBST1_TAC THEN
       REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
       EXISTS_TAC (← q r"(Bn:num->(A->bool)->bool) n0") THEN
       ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"n0:num") THEN REWRITE_TAC [],
       ALL_TAC] THEN
      /- Step 8: Construct N = b0 INTER Vn(n0+1) INTER INTERS{Nk k | k <= n0} -/
      /- First prove FINITE {Nk k | k <= n0} and all elements are open -/
      SUBGOAL_THEN (← q r"FINITE {(Nk:num->A->bool) k | k <= n0}") ASSUME_TAC THENL
      [MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"IMAGE (Nk:num->A->bool) {k | k <= n0}") THEN
       CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN REWRITE_TAC [FINITE_NUMSEG_LE],
        SET_TAC []],
       ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!s. s IN {(Nk:num->A->bool) k | k <= n0} ==> open_in top s")
        ASSUME_TAC THENL
      [REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
       STRIP_TAC THEN ASM_REWRITE_TAC [],
       ALL_TAC] THEN
      /- {Nk k | k <= n0} is nonempty since 0 <= n0 -/
      SUBGOAL_THEN (← q r"~({(Nk:num->A->bool) k | k <= n0} = {})") ASSUME_TAC THENL
      [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
       EXISTS_TAC (← q r"(Nk:num->A->bool) 0") THEN EXISTS_TAC (← q r"0") THEN ARITH_TAC,
       ALL_TAC] THEN
      EXISTS_TAC (← q r"(b0:A->bool) INTER (Vn:num->A->bool) (n0 + 1) INTER
                  INTERS {(Nk:num->A->bool) k | k <= n0}") THEN
      REPEAT CONJ_TAC THENL
      [/- N is open -/
       REPEAT (MATCH_MP_TAC OPEN_IN_INTER THEN CONJ_TAC) THEN
       ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_IN_INTERS THEN
       ASM_REWRITE_TAC [],
       /- x IN N -/
       REWRITE_TAC [IN_INTER, IN_INTERS, FORALL_IN_GSPEC] THEN
       ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
       STRIP_TAC THEN ASM_REWRITE_TAC [],
       /- FINITE {c | c IN C /\ ~(N INTER c = {})} -/
       /- Step 1: Vn is monotonic: m <= n ==> Vn m SUBSET Vn n -/
       SUBGOAL_THEN (← q r"!m n:num. m <= n ==> (Vn:num->A->bool) m SUBSET Vn n")
         ASSUME_TAC THENL
       [REPEAT GEN_TAC THEN DISCH_TAC THEN EXPAND_TAC "Vn" THEN
        MATCH_MP_TAC UNIONS_MONO THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"UNIONS ((Bn:num->(A->bool)->bool) j)") THEN
        CONJ_TAC THENL
        [REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"j:num") THEN
         ASM_ARITH_TAC,
         REWRITE_TAC [SUBSET_REFL]],
        ALL_TAC] THEN
       /- Abbreviate N for clarity - the neighborhood we're working with -/
       ABBREV_TAC (← q r"N = (b0:A->bool) INTER (Vn:num->A->bool) (n0 + 1) INTER
                       INTERS {(Nk:num->A->bool) k | k <= n0}") THEN
       /- Step 2: N SUBSET Vn(n0+1) - from definition of N -/
       SUBGOAL_THEN
       (← q r"(N:A->bool) SUBSET (Vn:num->A->bool) (n0 + 1)") ASSUME_TAC THENL
       [EXPAND_TAC "N" THEN SET_TAC [],
        ALL_TAC] THEN
       /- Step 3: For k > n0, elements of Cn k are disjoint from Vn(n0+1) -/
       SUBGOAL_THEN
         (← q r"!k c:A->bool. n0 < k /\ c IN (Cn:num->(A->bool)->bool) k
                        ==> c INTER (Vn:num->A->bool) (n0 + 1) = {}")
         ASSUME_TAC THENL
       [REPEAT GEN_TAC THEN STRIP_TAC THEN
        /- c IN Cn k means c = b DIFF Vn k for some b -/
        UNDISCH_TAC (← q r"(c:A->bool) IN (Cn:num->(A->bool)->bool) k") THEN
        EXPAND_TAC "Cn" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) THEN
        /- c = b DIFF Vn k, so c INTER Vn k = {} -/
        ASM_REWRITE_TAC [] THEN
        /- b DIFF Vn k is disjoint from Vn(n0+1) because Vn(n0+1) SUBSET Vn k -/
        SUBGOAL_THEN (← q r"(Vn:num->A->bool) (n0 + 1) SUBSET Vn k") MP_TAC THENL
        [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
         SET_TAC []],
        ALL_TAC] THEN
       /- Step 4: Therefore, for k > n0, N INTER c = {} for c IN Cn k -/
       SUBGOAL_THEN
         (← q r"!k c:A->bool. n0 < k /\ c IN (Cn:num->(A->bool)->bool) k
                        ==> (N:A->bool) INTER c = {}")
         ASSUME_TAC THENL
       [REPEAT GEN_TAC THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"k:num", ← q r"c:A->bool"]) THEN
        ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"(N:A->bool) SUBSET (Vn:num->A->bool) (n0 + 1)") THEN
        SET_TAC [],
        ALL_TAC] THEN
       /- For k <= n0, N SUBSET Nk k -/
       SUBGOAL_THEN (← q r"!k:num. k <= n0 ==> (N:A->bool) SUBSET (Nk:num->A->bool) k")
         ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN EXPAND_TAC "N" THEN
        REWRITE_TAC [SUBSET, IN_INTER, INTERS_GSPEC, IN_ELIM_THM] THEN
        ASM_MESON_TAC [],
        ALL_TAC] THEN
       /- Step 5b: For k <= n0, {c IN Cn k | ~(N INTER c = {})} is finite -/
       SUBGOAL_THEN
         (← q r"!k:num. k <= n0 ==>
                  FINITE {c:A->bool | c IN (Cn:num->(A->bool)->bool) k /\
                                      ~((N:A->bool) INTER c = {})}")
         ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
        /- Use finite subset of IMAGE -/
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (\b. b DIFF (Vn:num->A->bool) k)
                          {b:A->bool | b IN (Bn:num->(A->bool)->bool) k /\
                                       ~((Nk:num->A->bool) k INTER b = {})}") THEN
        CONJ_TAC THENL
        [/- The image is finite because the source is finite -/
         MATCH_MP_TAC FINITE_IMAGE THEN ASM_MESON_TAC [],
         /- The subset relation -/
         REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN
         X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
         /- c IN Cn k means c = b DIFF Vn k for some b IN Bn k -/
         UNDISCH_TAC (← q r"(c:A->bool) IN (Cn:num->(A->bool)->bool) k") THEN
         EXPAND_TAC "Cn" THEN REWRITE_TAC [IN_ELIM_THM] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) THEN
         EXISTS_TAC (← q r"b:A->bool") THEN ASM_REWRITE_TAC [] THEN
         /- Nk k INTER b nonempty from N INTER c nonempty -/
         UNDISCH_TAC (← q r"~((N:A->bool) INTER c = {})") THEN
         ASM_REWRITE_TAC [] THEN
         FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num")) THEN ASM_REWRITE_TAC [] THEN
         SET_TAC []],
        ALL_TAC] THEN
       /- Step 5c: Main finiteness argument -/
       MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"UNIONS {{c:A->bool | c IN (Cn:num->(A->bool)->bool) k /\
                           ~((N:A->bool) INTER c = {})} | k <= n0}") THEN
       CONJ_TAC THENL
        [REWRITE_TAC [FINITE_UNIONS] THEN CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_SUBSET THEN
          EXISTS_TAC (← q r"IMAGE (\k. {c:A->bool | c IN (Cn:num->(A->bool)->bool) k /\
                      ~((N:A->bool) INTER c = {})}) {k:num | k <= n0}") THEN
          CONJ_TAC THENL
          [MATCH_MP_TAC FINITE_IMAGE THEN REWRITE_TAC [FINITE_NUMSEG_LE],
           SET_TAC []],
          REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_REWRITE_TAC []],
         REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
         X_GEN_TAC (← q r"c:A->bool") THEN
         DISCH_THEN (CONJUNCTS_THEN2
           (X_CHOOSE_THEN (← q r"m:num") ASSUME_TAC) ASSUME_TAC) THEN
         ASM_CASES_TAC (← q r"n0:num < m") THENL
         [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m:num", ← q r"c:A->bool"]) THEN
          ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
          UNDISCH_TAC (← q r"~((c:A->bool) INTER (N:A->bool) = {})") THEN
          ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [],
          EXISTS_TAC (← q r"{c':A->bool | c' IN (Cn:num->(A->bool)->bool) m /\
                      ~((N:A->bool) INTER c' = {})}") THEN
          CONJ_TAC THENL
          [REWRITE_TAC [IN_ELIM_THM] THEN
           EXISTS_TAC (← q r"m:num") THEN CONJ_TAC THENL
           [ASM_ARITH_TAC, REFL_TAC],
           REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN
           ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC []]]]]],
     /- Refinement: each c in C refines some b in B -/
     REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"c:A->bool") THEN
     EXPAND_TAC "Cn" THEN REWRITE_TAC [] THEN
     REWRITE_TAC [IN_ELIM_THM] THEN
     /- With fixed Cn, we have ?n. ?b. b IN Bn n /\ c = b DIFF Vn n -/
     DISCH_THEN (X_CHOOSE_THEN (← q r"n0:num")
      (X_CHOOSE_THEN (← q r"b0:A->bool") STRIP_ASSUME_TAC)) THEN
     EXISTS_TAC (← q r"b0:A->bool") THEN CONJ_TAC THENL
     [/- b0 IN B: from b0 IN Bn n0 and B = UNIONS {Bn n | n} -/
      UNDISCH_THEN
       (← q r"B = UNIONS {(Bn:num->(A->bool)->bool) n | n IN (:num)}")
       SUBST1_TAC THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"(Bn:num->(A->bool)->bool) n0") THEN
      ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"n0:num") THEN REWRITE_TAC [IN_UNIV],
      /- c SUBSET b0: from c = b0 DIFF Vn n0 -/
      ASM_REWRITE_TAC [SUBSET_DIFF]]])

  return { SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING }

/- ------------------------------------------------------------------------- -/
/- Michael's Lemma, steps (2)=>(3) and helpers.  (metric.ml 42737-42864)     -/
/- ------------------------------------------------------------------------- -/

structure MICH1 where
  REGULAR_CLOSURE_REFINEMENT_COVERS : thm
  LF_COVERING_IMP_LF_CLOSED : thm
  EXPANSION_SET_OPEN : thm
  EXPANSION_SET_CONTAINS : thm
  deriving Inhabited

@[nospecialize]
def setupMICH1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BIterLocal : IterLocal) (BNbhdBase : NbhdBase) (BRegular1 : Regular1) :
    ExceptT String IO MICH1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_UNIONS, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { SUBSET, SUBSET_TRANS, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO, CLOSURE_OF_TOPSPACE, .. } :=
    BClosure
  let { CLOSED_IN_LOCALLY_FINITE_UNIONS, CLOSURE_OF_LOCALLY_FINITE_UNIONS,
        LOCALLY_FINITE_IN_CLOSURES, LOCALLY_FINITE_IN_SUBSET, .. } := BIterLocal
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  -- @@SCOPE END

  -- Helper: In a regular space, open sets with closure in some element
  -- of an open cover form an open cover of the whole space
  let REGULAR_CLOSURE_REFINEMENT_COVERS ← prove
   r"!(top:A topology) U.
        regular_space top /\
        (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
        ==> UNIONS {b | open_in top b /\ ?u. u IN U /\ top closure_of b SUBSET u}
            = topspace top"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
    [STRIP_TAC THEN
     ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET],
     DISCH_TAC THEN
     /- x is in some u IN U since UNIONS U = topspace -/
     FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [IN_UNIONS] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
     /- u is open since u IN U -/
     SUBGOAL_THEN (← q r"open_in top (u:A->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
     /- By regularity, get open v and closed c with x IN v SUBSET c SUBSET u -/
     FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id
       [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
     REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
     DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN
     ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
     MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"c:A->bool"] THEN STRIP_TAC THEN
     /- v is open, x IN v, v SUBSET c SUBSET u, c is closed -/
     EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN
     EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
     /- closure(v) SUBSET c SUBSET u -/
     MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"c:A->bool") THEN
     ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN ASM_REWRITE_TAC []])

  -- Step (2)=>(3): Using regularity to get l.f. closed refinement
  -- Given that every open cover has l.f. refinement, show every open cover
  -- has l.f. CLOSED refinement. The proof defines B = {U open | closure(U)
  -- in some element of A}, applies property (2) to B, then takes closures.
  let LF_COVERING_IMP_LF_CLOSED ← prove
   r"!(top:A topology).
        regular_space top /\
        (!B. (!b. b IN B ==> open_in top b) /\ UNIONS B = topspace top
             ==> ?C. UNIONS C = topspace top /\
                     locally_finite_in top C /\
                     (!c. c IN C ==> ?b. b IN B /\ c SUBSET b))
        ==> !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                ==> ?W. UNIONS W = topspace top /\
                        locally_finite_in top W /\
                        (!w. w IN W ==> closed_in top w) /\
                        (!w. w IN W ==> ?u. u IN U /\ w SUBSET u)"
   (REPEAT STRIP_TAC THEN
    /- Define B = {b open | closure(b) SUBSET some u IN U} -/
    ABBREV_TAC (← q r"B = {b:A->bool | open_in top b /\
                                 ?u. u IN U /\ top closure_of b SUBSET u}") THEN
    /- B covers X by regularity - use the helper lemma -/
    SUBGOAL_THEN (← q r"UNIONS B = topspace (top:A topology)") ASSUME_TAC THENL
    [EXPAND_TAC "B" THEN MATCH_MP_TAC REGULAR_CLOSURE_REFINEMENT_COVERS THEN
     ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    /- B is open -/
    SUBGOAL_THEN (← q r"!b:A->bool. b IN B ==> open_in top b") ASSUME_TAC THENL
    [EXPAND_TAC "B" THEN SIMP_TAC [IN_ELIM_THM], ALL_TAC] THEN
    /- Apply property (2) to B to get l.f. C -/
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B:(A->bool)->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- Take W = {closure(c) | c IN C} -/
    EXISTS_TAC (← q r"{(top:A topology) closure_of c | c IN C}") THEN
    /- The 4 goals: UNIONS W = topspace, locally_finite, closed, refines -/
    REPEAT CONJ_TAC THENL
    [/- Goal 1: UNIONS W = topspace -/
     /- UNIONS{closure(c)} = closure(UNIONS C) = topspace -/
     MP_TAC (← ISPECL [← q r"top:A topology", ← q r"C:(A->bool)->bool"]
                   CLOSURE_OF_LOCALLY_FINITE_UNIONS) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [CLOSURE_OF_TOPSPACE],
     /- Goal 2: locally_finite_in top W -/
     MP_TAC (← ISPECL [← q r"top:A topology", ← q r"C:(A->bool)->bool"]
                   LOCALLY_FINITE_IN_CLOSURES) THEN
     ASM_REWRITE_TAC [],
     /- Goal 3: all elements are closed -/
     REWRITE_TAC [FORALL_IN_GSPEC, CLOSED_IN_CLOSURE_OF],
     /- Goal 4: W refines U - each closure(c) SUBSET some u IN U -/
     REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
     /- c IN C, so c SUBSET some b IN B since C refines B -/
     SUBGOAL_THEN (← q r"?b:A->bool. b IN B /\ c SUBSET b") MP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) THEN
     /- b IN B means closure(b) SUBSET some u IN U (by definition of B) -/
     SUBGOAL_THEN (← q r"?u:A->bool. u IN U /\ (top:A topology) closure_of b SUBSET u")
       MP_TAC THENL
     [UNDISCH_TAC (← q r"b:A->bool IN B") THEN EXPAND_TAC "B" THEN SET_TAC [],
      ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
     /- closure(c) SUBSET closure(b) SUBSET u -/
     MATCH_MP_TAC SUBSET_TRANS THEN
     EXISTS_TAC (← q r"(top:A topology) closure_of b") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC CLOSURE_OF_MONO THEN ASM_REWRITE_TAC []])

  -- Helper: expansion set is open when C is locally finite closed.
  -- E(b) = X - UNIONS{c in C | c INTER b = {}} is open and contains b
  let EXPANSION_SET_OPEN ← prove
   r"!(top:A topology) C b.
        locally_finite_in top C /\
        (!c. c IN C ==> closed_in top c) /\
        b SUBSET topspace top
        ==> open_in top (topspace top DIFF UNIONS {c | c IN C /\ c INTER b = {}})"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
    REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
    MATCH_MP_TAC CLOSED_IN_LOCALLY_FINITE_UNIONS THEN CONJ_TAC THENL
    [ASM SET_TAC [],
     MATCH_MP_TAC LOCALLY_FINITE_IN_SUBSET THEN
     EXISTS_TAC (← q r"C:(A->bool)->bool") THEN ASM SET_TAC []])

  let EXPANSION_SET_CONTAINS ← prove
   r"!(top:A topology) C b.
        UNIONS C = topspace top /\ b SUBSET topspace top
        ==> b SUBSET topspace top DIFF UNIONS {c | c IN C /\ c INTER b = {}}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [SUBSET, IN_DIFF, IN_UNIONS, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN CONJ_TAC THENL
    [ASM SET_TAC [],
     REWRITE_TAC [NOT_EXISTS_THM] THEN X_GEN_TAC (← q r"c:A->bool") THEN
     ASM SET_TAC []])

  return { REGULAR_CLOSURE_REFINEMENT_COVERS, LF_COVERING_IMP_LF_CLOSED, EXPANSION_SET_OPEN,
           EXPANSION_SET_CONTAINS }

/- ------------------------------------------------------------------------- -/
/- Michael's Lemma, step (3)=>(4).  (metric.ml 42866-43105)                  -/
/- ------------------------------------------------------------------------- -/

structure LFO where
  LF_COVERING_IMP_LF_OPEN : thm
  deriving Inhabited

@[nospecialize]
def setupLFO [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BMICH1 : MICH1) : ExceptT String IO LFO := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FINITE_UNIONS, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, MEMBER_NOT_EMPTY, NOT_FORALL_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, UNIONS_GSPEC, .. } := D.core4
  let { SKOLEM_THM_GEN, .. } := D.core5
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { EXPANSION_SET_CONTAINS, EXPANSION_SET_OPEN, .. } := BMICH1
  -- @@SCOPE END

  -- Step (3)=>(4): Expanding l.f. covering to l.f. open refinement
  -- Given that every open cover has l.f. refinement (including closed),
  -- show every open cover has l.f. OPEN refinement. The expansion trick:
  -- use property (3) twice to get closed l.f. covers B and C, then
  -- expand B using C to get open l.f. cover. Following Munkres Lemma 41.3.
  let LF_COVERING_IMP_LF_OPEN ← do
    let EXPANSION_MEETS_IMP_INTERSECTS ← prove
     r"!(X:A->bool) C b c.
          c IN C /\ UNIONS C = X /\
          ~((X DIFF UNIONS {c' | c' IN C /\ c' INTER b = {}}) INTER c = {})
          ==> ~(c INTER b = {})"
     (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_INTER, IN_DIFF, IN_UNIONS,
                   IN_ELIM_THM, NOT_FORALL_THM] THEN
      MESON_TAC [])
    prove
     r"!(top:A topology).
        regular_space top /\
        (!B. (!b. b IN B ==> open_in top b) /\ UNIONS B = topspace top
             ==> ?C. UNIONS C = topspace top /\
                     locally_finite_in top C /\
                     (!c. c IN C ==> closed_in top c) /\
                     (!c. c IN C ==> ?b. b IN B /\ c SUBSET b))
        ==> !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                ==> ?W. UNIONS W = topspace top /\
                        locally_finite_in top W /\
                        (!w. w IN W ==> open_in top w) /\
                        (!w. w IN W ==> ?u. u IN U /\ w SUBSET u)"
     (GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "prop3")) THEN
      REPEAT STRIP_TAC THEN
      USE_THEN "prop3" (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"B:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      /- Skolemize Fb -/
      SUBGOAL_THEN
        (← q r"?Fb:(A->bool)->(A->bool). !b. b IN B ==> Fb b IN U /\ b SUBSET Fb b")
        STRIP_ASSUME_TAC THENL
      [REWRITE_TAC [← GSYM SKOLEM_THM_GEN] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      /- NB = sets meeting finitely many elements of B -/
      ABBREV_TAC (← q r"NB = {N:A->bool | open_in top N /\
                                    FINITE {b | b IN B /\ ~(b INTER N = {})}}") THEN
      /- NB covers topspace -/
      SUBGOAL_THEN (← q r"UNIONS NB = topspace (top:A topology)") ASSUME_TAC THENL
      [EXPAND_TAC "NB" THEN REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
       X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
       [STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
        ASM SET_TAC [],
        DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"V:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"V:A->bool") THEN
        REWRITE_TAC [← GSYM EXTENSION] THEN ASM_REWRITE_TAC []],
       ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!N:A->bool. N IN NB ==> open_in top N") ASSUME_TAC THENL
      [EXPAND_TAC "NB" THEN REWRITE_TAC [IN_ELIM_THM] THEN
       GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ACCEPT_TAC (K ALL_TAC : thm → tactic)),
       ALL_TAC] THEN
      /- Apply prop3 to NB to get l.f. closed refinement C -/
      USE_THEN "prop3" (MP_TAC o SPEC (← q r"NB:(A->bool)->bool")) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      /- Define expansion function Eb -/
      ABBREV_TAC (← q r"Eb = \b:A->bool. topspace top DIFF
                                  UNIONS {c:A->bool | c IN C /\ c INTER b = {}}") THEN
      /- Witness: {Eb b INTER Fb b | b IN B} -/
      EXISTS_TAC
       (← q r"{(Eb:(A->bool)->(A->bool)) b INTER
         (Fb:(A->bool)->(A->bool)) b | b | b IN B}") THEN
      /- Prove the four properties -/
      CONJ_TAC THENL
      [/- UNIONS {Eb b INTER Fb b | b IN B} = topspace top -/
       REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
       X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
       [DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") MP_TAC) THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
        EXPAND_TAC "Eb" THEN ASM SET_TAC [],
        DISCH_TAC THEN
        /- x is in topspace, so in some b in B -/
        SUBGOAL_THEN (← q r"?b:A->bool. b IN B /\ x IN b") STRIP_ASSUME_TAC THENL
        [UNDISCH_TAC (← q r"UNIONS B = topspace (top:A topology)") THEN
         REWRITE_TAC [EXTENSION, IN_UNIONS] THEN ASM_MESON_TAC [],
         ALL_TAC] THEN
        EXISTS_TAC
         (← q r"(Eb:(A->bool)->(A->bool)) b INTER
          (Fb:(A->bool)->(A->bool)) b") THEN CONJ_TAC THENL
        [EXISTS_TAC (← q r"b:A->bool") THEN ASM_REWRITE_TAC [],
         /- x IN Eb b INTER Fb b follows from x IN b and b SUBSET both -/
         REWRITE_TAC [IN_INTER] THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"C:(A->bool)->bool", ← q r"b:A->bool"]
                        EXPANSION_SET_CONTAINS) THEN
          ASM_REWRITE_TAC [] THEN
          ANTS_TAC THENL
          [UNDISCH_TAC (← q r"UNIONS B = topspace (top:A topology)") THEN
           REWRITE_TAC [EXTENSION, SUBSET, IN_UNIONS] THEN ASM_MESON_TAC [],
           /- b SUBSET Eb b, so x IN Eb b from x IN b -/
           EXPAND_TAC "Eb" THEN REWRITE_TAC [SUBSET, IN_DIFF] THEN
           DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
           MESON_TAC []],
          /- x IN Fb b from x IN b and b SUBSET Fb b -/
          ASM_MESON_TAC [SUBSET]]]],
       ALL_TAC] THEN CONJ_TAC THENL
      [/- locally_finite_in top {Eb b INTER Fb b | b IN B} -/
       /- For x, use l.f. of C to get nbhd M meeting finitely
          many c's. If (Eb b INTER Fb b) meets M, then Eb b meets M,
          so b meets some c meeting M. Each c refines some N in NB,
          so {b | b meets c} is finite.
          Hence {Eb b INTER Fb b | ... meets M} is finite. -/
       REWRITE_TAC [locally_finite_in, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
       [/- Each Eb b INTER Fb b SUBSET topspace top -/
        X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
        MATCH_MP_TAC (← SET_RULE (← q r"(s:A->bool) SUBSET t ==> (s INTER u) SUBSET t")) THEN
        EXPAND_TAC "Eb" THEN SET_TAC [],
        ALL_TAC] THEN
       X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
       /- Use local finiteness of C to get neighborhood -/
       /- Use l.f. of C to get neighborhood M -/
       SUBGOAL_THEN (← q r"?M:A->bool. open_in top M /\ x IN M /\
                                 FINITE {c:A->bool | c IN C /\ ~(c INTER M = {})}")
         STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"locally_finite_in top (C:(A->bool)->bool)") THEN
        REWRITE_TAC [locally_finite_in] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
       EXISTS_TAC (← q r"M:A->bool") THEN ASM_REWRITE_TAC [] THEN
       /- Now need: FINITE {Eb b | Eb b meets M} -/
       /- Key: if Eb b meets M, then b meets some c meeting M -/
       /- Abbreviate S = {c in C | c meets M} - finite by assumption -/
       ABBREV_TAC (← q r"S' = {c:A->bool | c IN C /\ ~(c INTER M = {})}") THEN
       /- For each c in S', c SUBSET some N in NB, so {b | b meets c} finite -/
       SUBGOAL_THEN
         (← q r"!c:A->bool. c IN S' ==> FINITE {b:A->bool | b IN B /\ ~(b INTER c = {})}")
         ASSUME_TAC THENL
       [X_GEN_TAC (← q r"c:A->bool") THEN EXPAND_TAC "S'" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        /- c IN C, so c SUBSET some N in NB -/
        SUBGOAL_THEN (← q r"?N:A->bool. N IN NB /\ c SUBSET N") STRIP_ASSUME_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
        /- N IN NB means FINITE {b in B | b meets N} -/
        UNDISCH_TAC (← q r"(N:A->bool) IN NB") THEN EXPAND_TAC "NB" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        /- {b | b meets c} SUBSET {b | b meets N} which is finite -/
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{b:A->bool | b IN B /\ ~(b INTER N = {})}") THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"b':A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"~(b' INTER (c:A->bool) = {})") THEN
        UNDISCH_TAC (← q r"(c:A->bool) SUBSET N") THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, SUBSET, IN_INTER] THEN MESON_TAC [],
        ALL_TAC] THEN
       /- {Eb b INTER Fb b | b IN B /\ ... meets M} is bounded by UNIONS over S' -/
       MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"IMAGE (\b:A->bool. (Eb:(A->bool)->(A->bool)) b INTER
                                      (Fb:(A->bool)->(A->bool)) b)
         (UNIONS {{b:A->bool | b IN B /\ ~(b INTER c = {})} | c IN S'})") THEN
       CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN
        REWRITE_TAC [FINITE_UNIONS] THEN CONJ_TAC THENL
        [REWRITE_TAC [SIMPLE_IMAGE] THEN
         MATCH_MP_TAC FINITE_IMAGE THEN EXPAND_TAC "S'" THEN ASM_REWRITE_TAC [],
         REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_REWRITE_TAC []],
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE, UNIONS_GSPEC] THEN
        X_GEN_TAC (← q r"w:A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
        EXISTS_TAC (← q r"b:A->bool") THEN ASM_REWRITE_TAC [] THEN
        /- Need: exists c in S' with b meets c -/
        /- From: w = Eb b INTER Fb b, and w meets M, derive Eb b meets M -/
        /- Since (Eb b INTER Fb b) SUBSET Eb b, if w meets M then Eb b meets M -/
        SUBGOAL_THEN (← q r"~((Eb:(A->bool)->(A->bool)) b INTER M = {})") MP_TAC THENL
        [/- ~(w INTER M = {}) ==> ~(Eb b INTER M = {}), where w = Eb b INTER Fb b -/
         UNDISCH_TAC (← q r"~((w:A->bool) INTER M = {})") THEN
         ASM_REWRITE_TAC [] THEN
         /- Now goal: ~((Eb b INTER Fb b) INTER M = {}) ==> ~(Eb b INTER M = {}) -/
         REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
         EXISTS_TAC (← q r"z:A") THEN ASM_REWRITE_TAC [],
         ALL_TAC] THEN
        EXPAND_TAC "Eb" THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER,
                     IN_DIFF, IN_UNIONS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
        /- y IN M, y IN topspace top, y NOT IN any c with c INTER b = {} -/
        /- y IN topspace from open_in top M -/
        SUBGOAL_THEN (← q r"(y:A) IN topspace top") ASSUME_TAC THENL
        [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
        /- y IN some c since UNIONS C = topspace top -/
        SUBGOAL_THEN (← q r"?c:A->bool. c IN C /\ y IN c") STRIP_ASSUME_TAC THENL
        [UNDISCH_TAC (← q r"UNIONS C = topspace (top:A topology)") THEN
         REWRITE_TAC [EXTENSION, IN_UNIONS] THEN ASM_MESON_TAC [],
         ALL_TAC] THEN
        /- This c must have c INTER b != {} since y doesn't avoid it -/
        /- First prove c IN S' using SUBGOAL_THEN -/
        SUBGOAL_THEN (← q r"(c:A->bool) IN S'") ASSUME_TAC THENL
        [EXPAND_TAC "S'" THEN REWRITE_TAC [IN_ELIM_THM] THEN
         ASM_REWRITE_TAC [] THEN
         REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
         EXISTS_TAC (← q r"y:A") THEN ASM_REWRITE_TAC [],
         ALL_TAC] THEN
        /- Now prove the existential with c as witness -/
        EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC [] THEN
        /- Prove ~(b INTER c = {}) via SUBGOAL_THEN, then derive existential -/
        SUBGOAL_THEN (← q r"~((c:A->bool) INTER b = {})") MP_TAC THENL
        [MATCH_MP_TAC EXPANSION_MEETS_IMP_INTERSECTS THEN
         EXISTS_TAC (← q r"topspace (top:A topology)") THEN
         EXISTS_TAC (← q r"C:(A->bool)->bool") THEN
         ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
         EXISTS_TAC (← q r"y:A") THEN
         REWRITE_TAC [IN_DIFF, IN_UNIONS, IN_ELIM_THM, IN_INTER] THEN
         ASM_REWRITE_TAC [],
         /- ~(c INTER b = {}) ==> ?x. x IN b /\ x IN c -/
         REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
         MESON_TAC []]],
       ALL_TAC] THEN
      /- Remaining: openness and refinement -/
      CONJ_TAC THENL
      [/- Openness: each Eb b INTER Fb b is open -/
       /- Eb b is open by EXPANSION_SET_OPEN, Fb b is open since Fb b IN U -/
       REWRITE_TAC [FORALL_IN_GSPEC] THEN
       X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
       MATCH_MP_TAC OPEN_IN_INTER THEN CONJ_TAC THENL
       [/- Eb b is open -/
        EXPAND_TAC "Eb" THEN
        MATCH_MP_TAC EXPANSION_SET_OPEN THEN ASM_REWRITE_TAC [] THEN
        /- Need: b SUBSET topspace top -/
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"UNIONS B = topspace (top:A topology)") THEN
        REWRITE_TAC [EXTENSION, IN_UNIONS] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
        REWRITE_TAC [] THEN DISCH_THEN (fun th => tactic_of do
          pure (REWRITE_TAC [← GSYM th])) THEN
        ASM_MESON_TAC [],
        /- Fb b is open since Fb b IN U and all u in U are open -/
        ASM_MESON_TAC []],
       /- Refinement: each Eb b INTER Fb b SUBSET some u in U -/
       REWRITE_TAC [FORALL_IN_GSPEC] THEN
       X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
       /- Witness: Fb b IN U and Eb b INTER Fb b SUBSET Fb b trivially -/
       EXISTS_TAC (← q r"(Fb:(A->bool)->(A->bool)) b") THEN
       CONJ_TAC THENL [ASM_MESON_TAC [], SET_TAC []]])

  return { LF_COVERING_IMP_LF_OPEN }

/- ------------------------------------------------------------------------- -/
/- Michael's lemma; metrizable spaces are paracompact.                       -/
/- (metric.ml 43107-43250)                                                    -/
/- ------------------------------------------------------------------------- -/

structure MICH2 where
  MICHAEL_LEMMA : thm
  METRIZABLE_IMP_PARACOMPACT_SPACE : thm
  PARACOMPACT_SPACE_MTOPOLOGY : thm
  COMPACT_LF_OPEN_NEIGHBORHOOD : thm
  deriving Inhabited

@[nospecialize]
def setupMICH2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BCompact1 : Compact1) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BRegular1 : Regular1) (BPARA1 : PARA1) (BMCSLF : MCSLF) (BSLFC : SLFC)
    (BMICH1 : MICH1) (BLFO : LFO) : ExceptT String IO MICH2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, FINITE_IMAGE, FINITE_SUBSET, FINITE_SUBSET_IMAGE_IMP, FINITE_UNIONS,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_TRANS, SUBSET_UNIONS, UNIONS_IMAGE, .. } :=
    D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_UNIONS, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { compact_in, .. } := BCompact1
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIZABLE_SPACE_MTOPOLOGY, metrizable_space, .. } := BMetrizable
  let { REGULAR_SPACE_MTOPOLOGY, .. } := BRegular1
  let { paracompact_space, .. } := BPARA1
  let { METRIC_COVER_SIGMA_LOCALLY_FINITE, .. } := BMCSLF
  let { SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING, .. } := BSLFC
  let { LF_COVERING_IMP_LF_CLOSED, .. } := BMICH1
  let { LF_COVERING_IMP_LF_OPEN, .. } := BLFO
  -- @@SCOPE END

  -- Michael's lemma: For regular spaces, sigma-locally-finite
  -- implies locally finite
  -- Combines steps (1)=>(2)=>(3)=>(4) - Lemma 41.3 from Munkres
  -- The full proof uses SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING,
  -- LF_COVERING_IMP_LF_CLOSED, and LF_COVERING_IMP_LF_OPEN
  let MICHAEL_LEMMA ← prove
   r"!top:A topology.
        regular_space top
        ==> (!U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                 ==> ?V. (!v. v IN V ==> open_in top v) /\
                         UNIONS V = topspace top /\
                         (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                         sigma_locally_finite_in top V)
            ==> (!U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                     ==> ?V. (!v. v IN V ==> open_in top v) /\
                             UNIONS V = topspace top /\
                             (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                             locally_finite_in top V)"
   (GEN_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    /- Apply LF_COVERING_IMP_LF_OPEN then reorder conjuncts -/
    MP_TAC (← ISPEC (← q r"top:A topology") LF_COVERING_IMP_LF_OPEN) THEN
    ASM_REWRITE_TAC [] THEN
    /- Need: every open cover has LF closed refinement -/
    /- Apply LF_COVERING_IMP_LF_CLOSED -/
    SUBGOAL_THEN
      (← q r"!B:(A->bool)->bool. (!b. b IN B ==> open_in top b) /\ UNIONS B = topspace top
          ==> ?C. UNIONS C = topspace top /\
                  locally_finite_in top C /\
                  (!c. c IN C ==> closed_in top c) /\
                  (!c. c IN C ==> ?b. b IN B /\ c SUBSET b)") ASSUME_TAC THENL
    [MP_TAC (← ISPEC (← q r"top:A topology") LF_COVERING_IMP_LF_CLOSED) THEN
     ASM_REWRITE_TAC [] THEN
     /- Need: every open cover has LF refinement -/
     SUBGOAL_THEN
       (← q r"!B:(A->bool)->bool. (!b. b IN B ==> open_in top b) /\ UNIONS B = topspace top
          ==> ?C. UNIONS C = topspace top /\
                  locally_finite_in top C /\
                  (!c. c IN C ==> ?b. b IN B /\ c SUBSET b)") ASSUME_TAC THENL
     [X_GEN_TAC (← q r"B:(A->bool)->bool") THEN STRIP_TAC THEN
      /- Apply sigma-LF hypothesis to B -/
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"B:(A->bool)->bool")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      /- Apply SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING to V -/
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"V:(A->bool)->bool"]
                    SIGMA_LOCALLY_FINITE_IMP_LOCALLY_FINITE_COVERING) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"C:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"C:(A->bool)->bool") THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN ASM_MESON_TAC [SUBSET_TRANS],
      ASM_REWRITE_TAC []],
     ASM_REWRITE_TAC []] THEN
    /- Now apply to U and reorder -/
    DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"W:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"W:(A->bool)->bool") THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [])

  -- Engelking 5.1.3 / Munkres 41.4 (A.H. Stone):
  -- Every metrizable space is paracompact.
  -- Proof combines METRIC_COVER_SIGMA_LOCALLY_FINITE and MICHAEL_LEMMA
  let METRIZABLE_IMP_PARACOMPACT_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> paracompact_space top"
   (REWRITE_TAC [metrizable_space, LEFT_IMP_EXISTS_THM] THEN
    REPEAT GEN_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN
    /- Now goal is: paracompact_space (mtopology m) -/
    REWRITE_TAC [paracompact_space] THEN
    /- Use MICHAEL_LEMMA: regular + sigma-LF refinements => LF refinements -/
    MP_TAC (← ISPEC (← q r"mtopology (m:A metric)") MICHAEL_LEMMA) THEN
    REWRITE_TAC [REGULAR_SPACE_MTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
    DISCH_THEN MATCH_MP_TAC THEN
    GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"U:(A->bool)->bool"]
     METRIC_COVER_SIGMA_LOCALLY_FINITE) THEN
    ASM_REWRITE_TAC [])

  -- Immediate corollary: every metric space is paracompact
  let PARACOMPACT_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. paracompact_space(mtopology m)"
   (MESON_TAC [METRIZABLE_IMP_PARACOMPACT_SPACE, METRIZABLE_SPACE_MTOPOLOGY])

  -- Helper: compact set in l.f. family has open neighborhood
  -- meeting finitely many. Uses compactness to get finite
  -- subcover by neighborhoods; union of finite sets is finite.
  let COMPACT_LF_OPEN_NEIGHBORHOOD ← prove
   r"!(top:A topology) (K:A->bool) (V:(A->bool)->bool).
        compact_in top K /\ locally_finite_in top V
        ==> ?N. open_in top N /\ K SUBSET N /\
                FINITE {v | v IN V /\ ~(v INTER N = {})}"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM])) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"M:A->A->bool") ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC (← q r"IMAGE (M:A->A->bool) K"))) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC []],
      REWRITE_TAC [UNIONS_IMAGE, SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"a:A") THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC []]],
     ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"T':(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"M:A->A->bool", ← q r"K:A->bool", ← q r"T':(A->bool)->bool"]
      FINITE_SUBSET_IMAGE_IMP) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"F':A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE (M:A->A->bool) F')") THEN
    CONJ_TAC THENL
    [MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
     X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
     ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC []],
     ALL_TAC] THEN CONJ_TAC THENL
    [MATCH_MP_TAC SUBSET_TRANS THEN
     EXISTS_TAC (← q r"UNIONS (T':(A->bool)->bool)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC SUBSET_UNIONS THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"UNIONS (IMAGE (\a:A. {v:A->bool | v IN V /\
      ~(v INTER (M:A->A->bool) a = {})}) F')") THEN
    CONJ_TAC THENL
    [REWRITE_TAC [FINITE_UNIONS, SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], SIMP_TAC []]],
     REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIONS, EXISTS_IN_IMAGE] THEN
     X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
     REWRITE_TAC [IN_INTER, UNIONS_IMAGE, IN_ELIM_THM] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") MP_TAC) THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC)) THEN
     EXISTS_TAC (← q r"a:A") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
     REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
     EXISTS_TAC (← q r"x:A") THEN REWRITE_TAC [IN_INTER] THEN
     ASM_REWRITE_TAC []])

  return { MICHAEL_LEMMA, METRIZABLE_IMP_PARACOMPACT_SPACE, PARACOMPACT_SPACE_MTOPOLOGY,
           COMPACT_LF_OPEN_NEIGHBORHOOD }


/- ------------------------------------------------------------------------- -/
/- Perfect images of paracompact spaces.  (metric.ml 43252-43443)            -/
/- ------------------------------------------------------------------------- -/

structure PPM where
  LF_CLOSED_PERFECT_MAP_IMAGE : thm
  PARACOMPACT_SPACE_PERFECT_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPPM [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1) (BHausdorff1 : Hausdorff1)
    (BProper1 : Proper1) (BPerfect : Perfect) (BPreserve : Preserve) (BNormal1 : Normal1)
    (BNormal3 : Normal3) (BPARA1 : PARA1) (BPARA2 : PARA2) (BMICH1 : MICH1) (BLFO : LFO)
    (BMICH2 : MICH2) : ExceptT String IO PPM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SUBSET, UNIONS_IMAGE, .. } := D.core4
  let { DE_MORGAN_THM, NOT_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } :=
    BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { closed_map, .. } := BOpenClosed1
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { T1_SPACE_PERFECT_MAP_IMAGE, .. } := BPreserve
  let { NORMAL_T1_IMP_REGULAR_SPACE, .. } := BNormal1
  let { NORMAL_SPACE_PERFECT_MAP_IMAGE, .. } := BNormal3
  let { paracompact_space, .. } := BPARA1
  let { PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE, PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } :=
    BPARA2
  let { LF_COVERING_IMP_LF_CLOSED, .. } := BMICH1
  let { LF_COVERING_IMP_LF_OPEN, .. } := BLFO
  let { COMPACT_LF_OPEN_NEIGHBORHOOD, .. } := BMICH2
  -- @@SCOPE END

  -- Helper: LF closed refinement pushed forward by perfect map
  let LF_CLOSED_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B) (W:(A->bool)->bool).
        perfect_map(top,top') f /\
        locally_finite_in top W /\
        (!w. w IN W ==> closed_in top w)
        ==> locally_finite_in top' (IMAGE (IMAGE f) W) /\
            (!v. v IN IMAGE (IMAGE f) W ==> closed_in top' v)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [perfect_map, proper_map] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC)
         ASSUME_TAC)) THEN
    CONJ_TAC THENL
    [/- locally_finite_in top' (IMAGE (IMAGE f) W) -/
     REWRITE_TAC [locally_finite_in] THEN CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"w:A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"w SUBSET topspace (top:A topology)") ASSUME_TAC THENL
      [ASM_MESON_TAC [CLOSED_IN_SUBSET], ASM SET_TAC []],
      ALL_TAC] THEN
     X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN ASM_REWRITE_TAC [] THEN
     DISCH_TAC THEN
     MP_TAC (← ISPECL [← q r"top:A topology",
       ← q r"{x:A | x IN topspace top /\ (f:A->B) x = y}",
       ← q r"W:(A->bool)->bool"] COMPACT_LF_OPEN_NEIGHBORHOOD) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"N:A->bool") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC
       (← q r"topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF N)") THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_map]) THEN
      DISCH_THEN MATCH_MP_TAC THEN MATCH_MP_TAC CLOSED_IN_DIFF THEN
      REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN ASM_SIMP_TAC [],
      ALL_TAC] THEN CONJ_TAC THENL
     [REWRITE_TAC [IN_DIFF, IN_IMAGE, IN_DIFF] THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM, DE_MORGAN_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN ASM SET_TAC [],
      ALL_TAC] THEN
     MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC (← q r"IMAGE (IMAGE (f:A->B))
       {w:A->bool | w IN W /\ ~(w INTER N = {})}") THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
      X_GEN_TAC (← q r"v:B->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2
        (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC)
        ASSUME_TAC) THEN
      FIRST_X_ASSUM (SUBST_ALL_TAC) THEN
      EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"w SUBSET topspace (top:A topology)") ASSUME_TAC THENL
      [ASM_MESON_TAC [CLOSED_IN_SUBSET], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [IN_INTER, IN_DIFF, IN_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:B")
        (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC)
          (CONJUNCTS_THEN2 ASSUME_TAC ASSUME_TAC))) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      EXISTS_TAC (← q r"a:A") THEN REWRITE_TAC [IN_INTER] THEN
      CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (SUBST1_TAC o SYM) THEN
      UNDISCH_TAC
        (← q r"~(?x:A. (z:B) = (f:A->B) x /\
                  x IN topspace top /\ ~(x IN N))") THEN
      REWRITE_TAC [NOT_EXISTS_THM, DE_MORGAN_THM] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"a:A")) THEN
      ASM_REWRITE_TAC [] THEN
      ASM SET_TAC []],
     /- closed_in top' v for v IN IMAGE (IMAGE f) W -/
     REWRITE_TAC [FORALL_IN_IMAGE] THEN
     X_GEN_TAC (← q r"w:A->bool") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_map]) THEN
     DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC []])

  -- Engelking 5.1.33: Perfect image of paracompact Hausdorff is paracompact
  let PARACOMPACT_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        paracompact_space top /\ hausdorff_space top /\
        perfect_map(top,top') f
        ==> paracompact_space top'"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE id [perfect_map]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o
      GEN_REWRITE_RULE id [proper_map]) THEN
    /- Y is regular -/
    SUBGOAL_THEN (← q r"regular_space (top':B topology)") ASSUME_TAC THENL
    [MATCH_MP_TAC NORMAL_T1_IMP_REGULAR_SPACE THEN CONJ_TAC THENL
     [MATCH_MP_TAC NORMAL_SPACE_PERFECT_MAP_IMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"top:A topology", ← q r"f:A->B"] THEN
      ASM_REWRITE_TAC [perfect_map, proper_map] THEN
      MATCH_MP_TAC PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE THEN
      ASM_REWRITE_TAC [],
      MATCH_MP_TAC T1_SPACE_PERFECT_MAP_IMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"top:A topology", ← q r"f:A->B"] THEN
      ASM_REWRITE_TAC [perfect_map, proper_map] THEN
      MATCH_MP_TAC HAUSDORFF_IMP_T1_SPACE THEN ASM_REWRITE_TAC []],
     ALL_TAC] THEN
    /- X is regular -/
    SUBGOAL_THEN (← q r"regular_space (top:A topology)") ASSUME_TAC THENL
    [MATCH_MP_TAC PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE THEN
     ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    /- Use LF_COVERING_IMP_LF_OPEN: need regular + LF closed ref property -/
    REWRITE_TAC [paracompact_space] THEN
    X_GEN_TAC (← q r"U':(B->bool)->bool") THEN STRIP_TAC THEN
    /- Get the LF open refinement from LF_COVERING_IMP_LF_OPEN -/
    MP_TAC (← ISPEC (← q r"top':B topology") LF_COVERING_IMP_LF_OPEN) THEN
    ANTS_TAC THENL
    [ASM_REWRITE_TAC [] THEN
     X_GEN_TAC (← q r"B:(B->bool)->bool") THEN STRIP_TAC THEN
     /- Pull back B to X -/
     SUBGOAL_THEN
       (← q r"(!pb. pb IN IMAGE (\b:B->bool.
          {x:A | x IN topspace top /\ f x IN b}) B ==> open_in top pb) /\
        UNIONS (IMAGE (\b:B->bool.
          {x:A | x IN topspace top /\ f x IN b}) B) = topspace top")
       STRIP_ASSUME_TAC THENL
     [CONJ_TAC THENL
      [REWRITE_TAC [FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
       MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
       EXISTS_TAC (← q r"top':B topology") THEN ASM_SIMP_TAC [],
       REWRITE_TAC [UNIONS_IMAGE, EXTENSION, IN_ELIM_THM] THEN
       X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
       [STRIP_TAC THEN ASM_REWRITE_TAC [],
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(f:A->B) x IN UNIONS B") MP_TAC THENL
        [ASM_MESON_TAC [continuous_map], ALL_TAC] THEN
        REWRITE_TAC [IN_UNIONS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"b:B->bool") THEN ASM_REWRITE_TAC [IN_ELIM_THM]]],
      ALL_TAC] THEN
     /- Get LF closed refinement of pullback on X -/
     MP_TAC (← ISPEC (← q r"top:A topology") LF_COVERING_IMP_LF_CLOSED) THEN
     ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"B':(A->bool)->bool")) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"V:(A->bool)->bool") THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SPEC
       (← q r"IMAGE (\b:B->bool. {x:A | x IN topspace top /\ f x IN b}) B")) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"W:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
     /- Push forward W via f -/
     EXISTS_TAC (← q r"IMAGE (IMAGE (f:A->B)) W") THEN
     /- Use the helper lemma for LF + closed -/
     MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology",
       ← q r"f:A->B", ← q r"W:(A->bool)->bool"] LF_CLOSED_PERFECT_MAP_IMAGE) THEN
     ASM_REWRITE_TAC [perfect_map, proper_map] THEN
     STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     /- UNIONS = topspace top' -/
     CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_IMAGE, EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"y:B") THEN EQ_TAC THENL
      [DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
       SUBGOAL_THEN (← q r"w SUBSET topspace (top:A topology)") MP_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_SUBSET], ASM SET_TAC []],
       DISCH_TAC THEN
       SUBGOAL_THEN (← q r"?x:A. x IN topspace top /\ (f:A->B) x = y")
         STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"?w:A->bool. w IN W /\ x IN w") STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
       EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC []],
      ALL_TAC] THEN
     /- Refinement -/
     REWRITE_TAC [FORALL_IN_IMAGE] THEN
     X_GEN_TAC (← q r"w:A->bool") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:A->bool")) THEN ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"pb:A->bool") STRIP_ASSUME_TAC) THEN
     UNDISCH_TAC
       (← q r"pb IN IMAGE (\b:B->bool.
         {x:A | x IN topspace top /\ (f:A->B) x IN b}) B") THEN
     REWRITE_TAC [IN_IMAGE] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"b:B->bool")
       (CONJUNCTS_THEN2 SUBST_ALL_TAC ASSUME_TAC)) THEN
     EXISTS_TAC (← q r"b:B->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
     ALL_TAC] THEN
    /- Apply the result of LF_COVERING_IMP_LF_OPEN to U' -/
    DISCH_THEN (MP_TAC o SPEC (← q r"U':(B->bool)->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"W':(B->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"W':(B->bool)->bool") THEN ASM_REWRITE_TAC [])

  return { LF_CLOSED_PERFECT_MAP_IMAGE, PARACOMPACT_SPACE_PERFECT_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- F_sigma subspaces of paracompact spaces.  (metric.ml 43445-43671)         -/
/- ------------------------------------------------------------------------- -/

structure FSIG where
  PARACOMPACT_SPACE_FSIGMA_SUBSET : thm
  deriving Inhabited

@[nospecialize]
def setupFSIG [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BIterLocal : IterLocal) (BFsigmaGdelta : FsigmaGdelta) (BRegular1 : Regular1)
    (BPARA1 : PARA1) (BPARA2 : PARA2) (BMICH2 : MICH2) : ExceptT String IO FSIG := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FINITE_SUBSET, .. } := D.core1
  let { IMP_IMP, INTER_SUBSET, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNION,
        IN_UNIONS, IN_UNIV, MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { MONO_IMP, SKOLEM_THM_GEN, .. } := D.core5
  let { OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { LOCALLY_FINITE_IN_SUBTOPOLOGY, locally_finite_in, .. } := BIterLocal
  let { FSIGMA_IN_ASCENDING, FSIGMA_IN_SUBSET, .. } := BFsigmaGdelta
  let { REGULAR_SPACE_SUBTOPOLOGY, .. } := BRegular1
  let { paracompact_space, .. } := BPARA1
  let { PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, sigma_locally_finite_in, .. } := BPARA2
  let { MICHAEL_LEMMA, .. } := BMICH2
  -- @@SCOPE END

  -- Engelking 5.1.28: F_sigma subspace of paracompact
  -- Hausdorff is paracompact
  -- Proof: Via Michael's Lemma. Build sigma-locally-finite open refinement
  -- from ascending closed sets c(n), then Michael's Lemma (needs regularity
  -- from Hausdorff + paracompact) converts to locally-finite.
  let PARACOMPACT_SPACE_FSIGMA_SUBSET ← prove
   r"!top s:A->bool.
        paracompact_space top /\ hausdorff_space top /\ fsigma_in top s
        ==> paracompact_space(subtopology top s)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"regular_space(top:A topology)") ASSUME_TAC THENL
    [ASM_MESON_TAC [PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET topspace top") ASSUME_TAC THENL
    [ASM_MESON_TAC [FSIGMA_IN_SUBSET], ALL_TAC] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP]
      (← REWRITE_RULE [← GSYM paracompact_space]
        (← ISPEC (← q r"subtopology top (s:A->bool)") MICHAEL_LEMMA))) THEN
    CONJ_TAC THENL
    [ASM_MESON_TAC [REGULAR_SPACE_SUBTOPOLOGY], ALL_TAC] THEN
    /- Sigma-locally-finite refinement property for subtopology top s -/
    SUBGOAL_THEN (← q r"topspace(subtopology top s:A topology) = (s:A->bool)")
      (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th]) THEN REWRITE_TAC [th]) THENL
    [ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY,
       ← SET_RULE (← q r"(s:A->bool) SUBSET t ==> t INTER s = s")], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FSIGMA_IN_ASCENDING]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->A->bool") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    /- Lift open-in-subtopology to open-in-top -/
    SUBGOAL_THEN
      (← q r"?g:(A->bool)->(A->bool). !u:A->bool. u IN U
        ==> open_in top (g u) /\ u = g u INTER s")
      STRIP_ASSUME_TAC THENL
    [REWRITE_TAC [← GSYM SKOLEM_THM_GEN] THEN
     X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
     MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN MESON_TAC [],
     ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET UNIONS(IMAGE (g:(A->bool)->(A->bool)) U)")
      ASSUME_TAC THENL
    [REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_IMAGE] THEN
     X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"(x:A) IN UNIONS U") MP_TAC THENL
     [ASM_MESON_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
     ASM_MESON_TAC [IN_INTER],
     ALL_TAC] THEN
    /- For each n, apply paracompactness to augmented cover -/
    SUBGOAL_THEN
      (← q r"!n:num. ?W:(A->bool)->bool.
        (!w. w IN W ==> open_in top w) /\
        UNIONS W = topspace top /\
        (!w. w IN W ==>
          ?v. v IN IMAGE (g:(A->bool)->(A->bool)) U UNION
                {topspace top DIFF (c:num->A->bool) n} /\
              w SUBSET v) /\
        locally_finite_in top W") MP_TAC THENL
    [X_GEN_TAC (← q r"n:num") THEN
     UNDISCH_TAC (← q r"paracompact_space (top:A topology)") THEN
     REWRITE_TAC [paracompact_space] THEN
     DISCH_THEN (MP_TAC o SPEC
       (← q r"IMAGE (g:(A->bool)->(A->bool)) U UNION
        {topspace top DIFF (c:num->A->bool) n}")) THEN
     ANTS_TAC THENL
     [CONJ_TAC THENL
      [REWRITE_TAC [IN_UNION, IN_IMAGE, IN_SING] THEN
       GEN_TAC THEN STRIP_TAC THENL
       [ASM_MESON_TAC [],
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE]],
       MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, IN_UNION, IN_IMAGE, IN_SING] THEN
        GEN_TAC THEN STRIP_TAC THENL
        [ASM_MESON_TAC [OPEN_IN_SUBSET], ASM SET_TAC []],
        REWRITE_TAC [SUBSET, IN_UNIONS, IN_UNION, IN_IMAGE, IN_SING] THEN
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"(x:A) IN s") THENL
        [UNDISCH_TAC
          (← q r"s SUBSET UNIONS(IMAGE (g:(A->bool)->(A->bool)) U)") THEN
         REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_IMAGE] THEN
         DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
         DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
         EXISTS_TAC (← q r"(g:(A->bool)->(A->bool)) u") THEN
         CONJ_TAC THENL
         [DISJ1_TAC THEN EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [],
          ASM_REWRITE_TAC []],
         EXISTS_TAC (← q r"topspace top DIFF (c:num->A->bool) n") THEN
         CONJ_TAC THENL [DISJ2_TAC THEN REFL_TAC, ALL_TAC] THEN
         REWRITE_TAC [IN_DIFF] THEN ASM_REWRITE_TAC [] THEN
         UNDISCH_TAC (← q r"UNIONS {(c:num->A->bool) n | n IN (:num)} = s") THEN
         UNDISCH_TAC (← q r"~((x:A) IN s)") THEN
         REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
         MESON_TAC []]]],
      DISCH_THEN ACCEPT_TAC],
     ALL_TAC] THEN REWRITE_TAC [SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"W:num->(A->bool)->bool")) THEN
    /- Witness: UNIONS of {w INTER s | w IN W(n),
       w NOT SUBSET topspace\c(n)} for all n -/
    EXISTS_TAC
      (← q r"UNIONS {{w INTER (s:A->bool) |w|
               w IN (W:num->(A->bool)->bool) n /\
               ~(w SUBSET topspace top DIFF (c:num->A->bool) n)} |
              n IN (:num)}") THEN
    REPEAT CONJ_TAC THENL
    [/- Open in subtopology -/
     REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
     X_GEN_TAC (← q r"v:A->bool") THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"B:(A->bool)->bool")
       (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC)
         ASSUME_TAC)) THEN
     UNDISCH_TAC (← q r"(v:A->bool) IN B") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
     ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN EXISTS_TAC (← q r"w:A->bool") THEN
     CONJ_TAC THENL [ASM_MESON_TAC [], REFL_TAC],
     /- UNIONS covers s -/
     GEN_REWRITE_TAC id [EXTENSION] THEN
     REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
     X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool")
        (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"B:(A->bool)->bool")
            (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC)
              ASSUME_TAC))
          ASSUME_TAC)) THEN
      UNDISCH_TAC (← q r"(v:A->bool) IN B") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_MESON_TAC [IN_INTER],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?n:num. (x:A) IN c n") STRIP_ASSUME_TAC THENL
      [UNDISCH_TAC (← q r"UNIONS {(c:num->A->bool) n | n IN (:num)} = s") THEN
       REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
       ASM_MESON_TAC [],
       ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
      [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (CONJUNCTS_THEN2 (fun th =>
          ASSUME_TAC th) STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS((W:num->(A->bool)->bool) n)") MP_TAC THENL
      [ASM_MESON_TAC [EXTENSION], REWRITE_TAC [IN_UNIONS]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w INTER (s:A->bool)") THEN CONJ_TAC THENL
      [EXISTS_TAC (← q r"{w' INTER (s:A->bool) |w'|
         w' IN (W:num->(A->bool)->bool) n /\
         ~(w' SUBSET topspace top DIFF (c:num->A->bool) n)}") THEN
       CONJ_TAC THENL
       [EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [],
        REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"w:A->bool") THEN
        ASM SET_TAC []],
       REWRITE_TAC [IN_INTER] THEN ASM_REWRITE_TAC []]],
     /- Refines U -/
     REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
     X_GEN_TAC (← q r"v:A->bool") THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"B:(A->bool)->bool")
       (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC)
         ASSUME_TAC)) THEN
     UNDISCH_TAC (← q r"(v:A->bool) IN B") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
     ASM_REWRITE_TAC [] THEN
     SUBGOAL_THEN
      (← q r"?v':(A->bool). v' IN IMAGE (g:(A->bool)->(A->bool)) U UNION
         {topspace top DIFF (c:num->A->bool) n} /\
         (w:A->bool) SUBSET v'")
      MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"v':A->bool")
       (CONJUNCTS_THEN2
         (fun th => tactic_of do
           pure (MP_TAC (← REWRITE_RULE [IN_UNION, IN_IMAGE, IN_SING] th)))
         ASSUME_TAC)) THEN
     DISCH_THEN (DISJ_CASES_THEN2
       (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
       ASSUME_TAC) THENL
     [EXISTS_TAC (← q r"u:A->bool") THEN CONJ_TAC THENL
      [ASM_REWRITE_TAC [],
       SUBGOAL_THEN (← q r"(u:A->bool) = g u INTER s") SUBST1_TAC THENL
       [ASM_MESON_TAC [], ASM SET_TAC []]],
      ASM_MESON_TAC []],
     /- Sigma-locally-finite -/
     REWRITE_TAC [sigma_locally_finite_in] THEN
     EXISTS_TAC (← q r"\n:num. {w INTER (s:A->bool) |w|
       w IN (W:num->(A->bool)->bool) n /\
       ~(w SUBSET topspace top DIFF (c:num->A->bool) n)}") THEN
     CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      MATCH_MP_TAC LOCALLY_FINITE_IN_SUBTOPOLOGY THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN STRIP_TAC THEN
      CONJ_TAC THENL
      [UNDISCH_TAC
         (← q r"locally_finite_in (top:A topology)
           ((W:num->(A->bool)->bool) n)") THEN
       REWRITE_TAC [locally_finite_in] THEN
       DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
       DISCH_THEN (fun th => CONJ_TAC THENL
        [REWRITE_TAC [IN_ELIM_THM] THEN
         REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
         ASM_MESON_TAC [OPEN_IN_SUBSET, INTER_SUBSET, SUBSET_TRANS],
         MP_TAC th]) THEN
       MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"a:A") THEN
       MATCH_MP_TAC MONO_IMP THEN CONJ_TAC THENL
       [SIMP_TAC [], ALL_TAC] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"N:A->bool") STRIP_ASSUME_TAC) THEN
       EXISTS_TAC (← q r"N:A->bool") THEN ASM_REWRITE_TAC [] THEN
       MATCH_MP_TAC FINITE_SUBSET THEN
       EXISTS_TAC (← q r"{t | t IN {w INTER (s:A->bool) |w|
         w IN (W:num->(A->bool)->bool) n} /\
         ~(t INTER N = {})}") THEN
       CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (\w. w INTER (s:A->bool))
          {w | w IN (W:num->(A->bool)->bool) n /\
            ~(w INTER N = {})}") THEN
        CONJ_TAC THENL
        [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
         REWRITE_TAC [SUBSET, IN_IMAGE, IN_ELIM_THM] THEN
         X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
         EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC [] THEN
         ASM SET_TAC []],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
        CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC []] THEN
        ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC []],
       REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
       ASM_REWRITE_TAC [] THEN ASM SET_TAC []],
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN REFL_TAC]])

  return { PARACOMPACT_SPACE_FSIGMA_SUBSET }

/- ------------------------------------------------------------------------- -/
/- Helpers for the product theorem.  (metric.ml 43673-43817)                 -/
/- ------------------------------------------------------------------------- -/

structure TUBE where
  LOCALLY_FINITE_PRODUCT_TUBES : thm
  COMPACT_TUBE_COVER : thm
  deriving Inhabited

@[nospecialize]
def setupTUBE [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BProd1 : Prod1) (BCompact1 : Compact1) (BCompact4 : Compact4) (BCompact5 : Compact5) :
    ExceptT String IO TUBE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FINITE_UNIONS,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, .. } := D.core2
  let { SUBSET, SUBSET_CROSS, SUBSET_REFL, SUBSET_TRANS, .. } := D.core4
  let { FORALL_PAIR_THM, PAIR, .. } := D.core5
  let { OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { COMPACT_IN_SING, compact_in, compact_space, .. } := BCompact1
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { TUBE_LEMMA_RIGHT, .. } := BCompact5
  -- @@SCOPE END

  -- Helper for product theorem: locally finite in product
  -- {w CROSS topspace INTER u | w IN W, u IN Ux(xw w)} is l.f.
  -- when W is l.f. For (x,y), use Nx CROSS topspace where Nx
  -- meets finitely many W-elements; each contributes finitely
  -- many u's from Ux(xw w).
  let LOCALLY_FINITE_PRODUCT_TUBES ← prove
   r"!(top:A topology) (top':B topology) W U Ux xw.
        locally_finite_in top W /\
        (!w. w IN W ==> FINITE (Ux((xw:(A->bool)->A) w))) /\
        (!w. w IN W ==> Ux(xw w) SUBSET U) /\
        (!u. u IN U ==> open_in (prod_topology top top') u)
        ==> locally_finite_in (prod_topology top top')
              {(w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool) |
               w IN W /\ u IN Ux(xw w)}"
   (/- The proof: for (x,y) in product space, since W is l.f., there exists Nx
       meeting finitely many W-elements. Use Nx CROSS topspace as neighborhood.
       Any intersecting tube must have w meeting Nx; finitely
       many w, each with finite Ux(xw w), so finitely many. -/
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [locally_finite_in, TOPSPACE_PROD_TOPOLOGY, FORALL_PAIR_THM,
                 IN_CROSS] THEN
    CONJ_TAC THENL
    [/- All elements are subsets of the product topspace -/
     REWRITE_TAC [FORALL_IN_GSPEC] THEN
     MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"u:(A#B)->bool"] THEN STRIP_TAC THEN
     /- w SUBSET topspace from l.f., u SUBSET prod_topspace
        from open, so w CROSS topspace INTER u SUBSET prod -/
     RULE_ASSUM_TAC (REWRITE_RULE [locally_finite_in]) THEN
     SUBGOAL_THEN (← q r"(w:A->bool) SUBSET topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
     SUBGOAL_THEN
      (← q r"(u:(A#B)->bool) SUBSET topspace (prod_topology top top')")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
     REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN
     FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY]) THEN
     ASM SET_TAC [],
     ALL_TAC] THEN
    /- For any (x,y), find a neighborhood meeting finitely many tubes -/
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    /- Since W is l.f., get Nx meeting finitely many W-elements -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"Nx:A->bool") STRIP_ASSUME_TAC) THEN
    /- The finite set of W-elements meeting Nx -/
    ABBREV_TAC (← q r"W' = {w:A->bool | w IN W /\ ~(w INTER Nx = {})}") THEN
    /- Use Nx CROSS topspace as our neighborhood -/
    EXISTS_TAC (← q r"(Nx:A->bool) CROSS topspace (top':B topology)") THEN
    REPEAT CONJ_TAC THENL
    [/- Nx CROSS topspace is open -/
     ASM_SIMP_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE],
     /- (x,y) IN Nx CROSS topspace -/
     ASM_REWRITE_TAC [IN_CROSS],
     /- The finite set of tubes meeting Nx CROSS topspace -/
     MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC (← q r"{(w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool) |
                  w IN W' /\ u IN (Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w)}") THEN
     CONJ_TAC THENL
     [/- This is finite: W' is finite, each Ux(xw w) is finite -/
      SUBGOAL_THEN (← q r"{(w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool) |
                     w IN W' /\ u IN (Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w)} =
                    UNIONS (IMAGE (\w. IMAGE (\u. w CROSS topspace top' INTER u)
                                             (Ux((xw:(A->bool)->A) w))) W')")
        SUBST1_TAC THENL
      [REWRITE_TAC [EXTENSION, IN_UNIONS, IN_IMAGE,
                    EXISTS_IN_IMAGE, IN_ELIM_THM] THEN
       SET_TAC [],
       ALL_TAC] THEN
      REWRITE_TAC [FINITE_UNIONS] THEN CONJ_TAC THENL
      [MATCH_MP_TAC FINITE_IMAGE THEN
       EXPAND_TAC "W'" THEN ASM_REWRITE_TAC [],
       REWRITE_TAC [FORALL_IN_IMAGE] THEN GEN_TAC THEN DISCH_TAC THEN
       MATCH_MP_TAC FINITE_IMAGE THEN
       SUBGOAL_THEN (← q r"(x':A->bool) IN W") ASSUME_TAC THENL
       [EXPAND_TAC "W'" THEN ASM SET_TAC [], ALL_TAC] THEN
       FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
      /- Subset: any tube meeting Nx CROSS topspace has w IN W' -/
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:(A#B)->bool"] THEN
      DISCH_THEN (CONJUNCTS_THEN2
        (X_CHOOSE_THEN (← q r"w:A->bool")
          (X_CHOOSE_THEN (← q r"u:(A#B)->bool") STRIP_ASSUME_TAC))
        MP_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_CROSS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"p:A#B") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w:A->bool") THEN EXISTS_TAC (← q r"u:(A#B)->bool") THEN
      ASM_REWRITE_TAC [] THEN EXPAND_TAC "W'" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      EXISTS_TAC (← q r"FST(p:A#B)") THEN
      /- FST p IN w /\ FST p IN Nx follow from:
         p IN w CROSS topspace top' ==> FST p IN w, and
         p IN Nx CROSS topspace top' ==> FST p IN Nx -/
      CONJ_TAC THENL
      [UNDISCH_TAC (← q r"p:(A#B) IN (w:A->bool) CROSS topspace top'") THEN
       GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM PAIR] THEN
       REWRITE_TAC [IN_CROSS] THEN
       DISCH_THEN (fun th => tactic_of do pure (ACCEPT_TAC (← CONJUNCT1 th))),
       UNDISCH_TAC (← q r"p:(A#B) IN (Nx:A->bool) CROSS topspace top'") THEN
       GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [← GSYM PAIR] THEN
       REWRITE_TAC [IN_CROSS] THEN
       DISCH_THEN (fun th => tactic_of do pure (ACCEPT_TAC (← CONJUNCT1 th)))]]])

  -- Helper for product theorem: tube lemma combined with compactness
  -- Uses compactness to extract finite subcover, then applies tube lemma
  let COMPACT_TUBE_COVER ← prove
   r"!(top:A topology) (top':B topology) x U.
        compact_space top' /\
        x IN topspace top /\
        (!u. u IN U ==> open_in (prod_topology top top') u) /\
        {x} CROSS topspace top' SUBSET UNIONS U
        ==> ?v Ux. open_in top v /\ x IN v /\
                   FINITE Ux /\ Ux SUBSET (U:((A#B)->bool)->bool) /\
                   v CROSS topspace top' SUBSET UNIONS Ux"
   (REPEAT STRIP_TAC THEN
    /- Step 1: {x} CROSS topspace top' is compact -/
    SUBGOAL_THEN (← q r"compact_in (prod_topology top top')
                             ({x:A} CROSS topspace (top':B topology))") ASSUME_TAC THENL
    [REWRITE_TAC [COMPACT_IN_CROSS, NOT_INSERT_EMPTY] THEN DISJ2_TAC THEN
     ASM_REWRITE_TAC [COMPACT_IN_SING, ← GSYM compact_space],
     ALL_TAC] THEN
    /- Step 2: By compactness, get finite subcover -/
    FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [compact_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC (← q r"U:((A#B)->bool)->bool"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"Ux:((A#B)->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- Step 3: Apply TUBE_LEMMA_RIGHT to UNIONS Ux -/
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"x:A",
                      ← q r"topspace (top':B topology)", ← q r"UNIONS Ux:(A#B)->bool"]
           TUBE_LEMMA_RIGHT) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
     ASM_REWRITE_TAC [← GSYM compact_space],
     ALL_TAC] THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    /- Step 4: u is the desired tube -/
    EXISTS_TAC (← q r"u:A->bool") THEN EXISTS_TAC (← q r"Ux:((A#B)->bool)->bool") THEN
    ASM_REWRITE_TAC [] THEN
    /- u CROSS topspace top' SUBSET u CROSS v SUBSET UNIONS Ux -/
    TRANS_TAC SUBSET_TRANS (← q r"(u:A->bool) CROSS (v:B->bool)") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET_CROSS, SUBSET_REFL] THEN ASM_REWRITE_TAC [])

  return { LOCALLY_FINITE_PRODUCT_TUBES, COMPACT_TUBE_COVER }

/- ------------------------------------------------------------------------- -/
/- Product of paracompact with compact.  (metric.ml 43818-43974)             -/
/- ------------------------------------------------------------------------- -/

structure PPC where
  PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT : thm
  PARACOMPACT_SPACE_PRODUCT_COMPACT_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupPPC [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BProd1 : Prod1) (BHomeoSpace : HomeoSpace) (BPARA1 : PARA1) (BTUBE : TUBE) :
    ExceptT String IO PPC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_CROSS, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNIONS, .. } := D.core2
  let { SUBSET, SUBSET_TRANS, .. } := D.core4
  let { FORALL_PAIR_THM, SKOLEM_THM_GEN, .. } := D.core5
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP, .. } := BHomeoSpace
  let { HOMEOMORPHIC_PARACOMPACT_SPACE, paracompact_space, .. } := BPARA1
  let { COMPACT_TUBE_COVER, LOCALLY_FINITE_PRODUCT_TUBES, .. } := BTUBE
  -- @@SCOPE END

  -- Engelking 5.1.36: Product of paracompact with compact is paracompact
  -- Proof uses tube lemma: for each x, {x} CROSS Y is compact, so finitely many
  -- elements of the cover suffice, and they extend to a tube Vx CROSS Y.
  -- Apply paracompactness to {Vx}, then use LOCALLY_FINITE_PRODUCT_TUBES.
  let PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT ← prove
   r"!(top:A topology) (top':B topology).
        paracompact_space top /\ compact_space top'
        ==> paracompact_space(prod_topology top top')"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [paracompact_space, TOPSPACE_PROD_TOPOLOGY] THEN
    X_GEN_TAC (← q r"U:((A#B)->bool)->bool") THEN STRIP_TAC THEN
    /- Step 1: For each x, apply COMPACT_TUBE_COVER -/
    /- Get Vx, finite Ux SUBSET U with Vx CROSS top' SUBSET UNIONS Ux -/
    SUBGOAL_THEN
      (← q r"!x:A. x IN topspace top
             ==> ?v (Ux:((A#B)->bool)->bool). open_in top v /\ x IN v /\
                        FINITE Ux /\ Ux SUBSET U /\
                        (v:A->bool) CROSS topspace top' SUBSET UNIONS Ux")
      ASSUME_TAC THENL
    [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     MATCH_MP_TAC COMPACT_TUBE_COVER THEN ASM_REWRITE_TAC [] THEN
     /- {x} CROSS topspace top' SUBSET UNIONS U =
        topspace top CROSS topspace top' -/
     REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS, IN_SING, IN_UNIONS] THEN
     MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN STRIP_TAC THEN
     ASM_REWRITE_TAC [] THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EXTENSION]) THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"(x:A,b:B)")) THEN
     REWRITE_TAC [IN_UNIONS, IN_CROSS] THEN
     ASM_MESON_TAC [],
     ALL_TAC] THEN
    /- Skolemize: choice functions Vx : A -> A->bool, Ux : A -> P(P(A#B)) -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SKOLEM_THM_GEN]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"V:A->(A->bool)") MP_TAC) THEN
    REWRITE_TAC [SKOLEM_THM_GEN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"Ux:A->((A#B)->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- Step 2: {V x | x IN topspace top} is an open cover of topspace top -/
    /- Apply paracompactness of top to get locally finite refinement W -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"{(V:A->(A->bool)) x | x IN topspace top}")) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [], ALL_TAC] THEN
     /- UNIONS covers topspace -/
     REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
     X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
     [STRIP_TAC THEN ASM_MESON_TAC [locally_finite_in, OPEN_IN_SUBSET, SUBSET],
      DISCH_TAC THEN EXISTS_TAC (← q r"(V:A->(A->bool)) x") THEN
      ASM_MESON_TAC []],
     ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"W:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- Step 3: For each w IN W, pick xw IN topspace top such that w SUBSET V(xw) -/
    SUBGOAL_THEN
      (← q r"?xw:(A->bool)->A. !w. w IN W ==> xw w IN topspace top /\ w SUBSET V(xw w)")
      STRIP_ASSUME_TAC THENL
    [REWRITE_TAC [← GSYM SKOLEM_THM_GEN] THEN X_GEN_TAC (← q r"w:A->bool") THEN
     DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:A->bool")) THEN ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_ELIM_THM]) THEN
     STRIP_TAC THEN EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
     ASM_MESON_TAC [SUBSET_TRANS],
     ALL_TAC] THEN
    /- Step 4: Refinement is {w CROSS topspace INTER u} -/
    EXISTS_TAC (← q r"{(w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool) |
                 w IN W /\ u IN (Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w)}") THEN
    REPEAT CONJ_TAC THENL
    [/- Each element is open -/
     REWRITE_TAC [FORALL_IN_GSPEC] THEN
     MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"u:(A#B)->bool"] THEN STRIP_TAC THEN
     MATCH_MP_TAC OPEN_IN_INTER THEN CONJ_TAC THENL
     [ASM_SIMP_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE],
      ASM_MESON_TAC [SUBSET]],
     /- Covers the product space -/
     REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM, FORALL_PAIR_THM, IN_CROSS] THEN
     MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN EQ_TAC THENL
     [/- Forward: (x,y) in some tube => x in topspace, y in topspace' -/
      /- STRIP_ASSUME_TAC already eliminates existentials from s IN {...},
         giving us w, u as free variables with w IN W, u IN Ux(xw w),
         and a biconditional for s -/
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:(A#B)->bool") STRIP_ASSUME_TAC) THEN
      /- Rewrite assumptions to extract membership facts -/
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER, IN_CROSS, FORALL_PAIR_THM]) THEN
      /- y IN topspace top' from (x,y) IN w CROSS topspace top' INTER u
         x IN w and W locally finite => x IN topspace -/
      RULE_ASSUM_TAC (REWRITE_RULE [locally_finite_in]) THEN
      ASM_MESON_TAC [SUBSET],
      STRIP_TAC THEN
      /- (x,y) IN topspace CROSS topspace, so x IN UNIONS W -/
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS W") MP_TAC THENL
      [FIRST_X_ASSUM (fun th => GEN_REWRITE_TAC RAND_CONV [th]) THEN
       ASM_REWRITE_TAC [],
       ALL_TAC] THEN REWRITE_TAC [IN_UNIONS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      /- x IN V(xw w) CROSS topspace, which is SUBSET UNIONS Ux -/
      SUBGOAL_THEN
        (← q r"(x:A,y:B) IN UNIONS ((Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w))")
        MP_TAC THENL
      [/- Use: V(xw w) CROSS topspace top' SUBSET UNIONS(Ux(xw w)) -/
       /- and: x IN w, w SUBSET V(xw w) => x IN V(xw w) -/
       /- and: y IN topspace top' -/
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(xw:(A->bool)->A) w")) THEN
       ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       STRIP_TAC THEN
       FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
       REWRITE_TAC [IN_CROSS] THEN ASM_MESON_TAC [SUBSET],
       ALL_TAC] THEN
      REWRITE_TAC [IN_UNIONS] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(A#B)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool)") THEN
      CONJ_TAC THENL
      [EXISTS_TAC (← q r"w:A->bool") THEN
       EXISTS_TAC (← q r"u:(A#B)->bool") THEN ASM_REWRITE_TAC [],
       REWRITE_TAC [IN_INTER, IN_CROSS] THEN ASM_REWRITE_TAC []]],
     /- Each element is a subset of some u IN U -/
     /- Goal is Skolemized: ?f. !v. v IN {...} ==> f v IN U /\ v SUBSET f v -/
     /- Provide a choice function that extracts the u component -/
     EXISTS_TAC (← q r"\v:(A#B)->bool. @u:(A#B)->bool.
       ?w:A->bool.
         (w IN W /\
          u IN (Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w)) /\
         v = w CROSS topspace top' INTER u") THEN
     REWRITE_TAC [FORALL_IN_GSPEC] THEN
     MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"u:(A#B)->bool"] THEN STRIP_TAC THEN
     REWRITE_TAC [] THEN
     /- Use SELECT_AX: if ?x. P x, then P(@x. P x) -/
     /- First show there exists a witness (namely u) -/
     SUBGOAL_THEN
      (← q r"?u':(A#B)->bool. ?w':A->bool.
        (w' IN W /\
         u' IN (Ux:A->((A#B)->bool)->bool)((xw:(A->bool)->A) w')) /\
        (w:A->bool) CROSS topspace top' INTER (u:(A#B)->bool) =
        w' CROSS topspace top' INTER u'")
      MP_TAC THENL
     [EXISTS_TAC (← q r"u:(A#B)->bool") THEN EXISTS_TAC (← q r"w:A->bool") THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
     DISCH_THEN (MP_TAC o SELECT_RULE) THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"w':A->bool") STRIP_ASSUME_TAC) THEN
     CONJ_TAC THENL [ASM_MESON_TAC [SUBSET], ASM SET_TAC []],
     /- Locally finite - use LOCALLY_FINITE_PRODUCT_TUBES -/
     MATCH_MP_TAC LOCALLY_FINITE_PRODUCT_TUBES THEN
     EXISTS_TAC (← q r"U:((A#B)->bool)->bool") THEN
     ASM_REWRITE_TAC [] THEN
     CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
     ASM_MESON_TAC [SUBSET_TRANS]])

  -- Symmetric version: compact times paracompact is paracompact
  let PARACOMPACT_SPACE_PRODUCT_COMPACT_RIGHT ← prove
   r"!(top:A topology) (top':B topology).
        compact_space top /\ paracompact_space top'
        ==> paracompact_space(prod_topology top top')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology"]
      PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology"]
      HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_PARACOMPACT_SPACE) THEN
    ASM_REWRITE_TAC [])

  return { PARACOMPACT_SPACE_PRODUCT_COMPACT_LEFT, PARACOMPACT_SPACE_PRODUCT_COMPACT_RIGHT }

/- ------------------------------------------------------------------------- -/
/- Shrinking lemmas in paracompact Hausdorff spaces.  (metric.ml 43976-44140) -/
/- ------------------------------------------------------------------------- -/

structure SHR where
  PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT : thm
  PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING : thm
  deriving Inhabited

@[nospecialize]
def setupSHR [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BIterLocal : IterLocal) (BRegular1 : Regular1) (BPARA1 : PARA1) (BPARA2 : PARA2) :
    ExceptT String IO SHR := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } :=
    D.core2
  let { SUBSET, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { SKOLEM_THM_GEN, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO, .. } := BClosure
  let { CLOSURE_OF_LOCALLY_FINITE_UNIONS, locally_finite_in, .. } := BIterLocal
  let { regular_space, .. } := BRegular1
  let { paracompact_space, .. } := BPARA1
  let { PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BPARA2
  -- @@SCOPE END

  -- Helper: In a paracompact Hausdorff space, an open cover has a locally
  -- finite open refinement with closures contained in the original cover
  let PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT ← prove
   r"!top:A topology U.
        paracompact_space top /\ hausdorff_space top /\
        (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
        ==> ?V r. (!v. v IN V ==> open_in top v) /\
                  UNIONS V = topspace top /\
                  locally_finite_in top V /\
                  (!v:A->bool. v IN V
                      ==> (r v) IN U /\ top closure_of v SUBSET (r v))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"regular_space (top:A topology)") ASSUME_TAC THENL
    [MATCH_MP_TAC PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE THEN
     ASM_REWRITE_TAC [], ALL_TAC] THEN
    ABBREV_TAC
     (← q r"C = {w:A->bool | open_in top w /\
            ?u:A->bool. u IN U /\ top closure_of w SUBSET u}") THEN
    SUBGOAL_THEN (← q r"(!w:A->bool. w IN C ==> open_in top w)") ASSUME_TAC THENL
    [EXPAND_TAC "C" THEN SIMP_TAC [IN_ELIM_THM], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"UNIONS C = topspace (top:A topology)") ASSUME_TAC THENL
    [REWRITE_TAC [EXTENSION, IN_UNIONS] THEN X_GEN_TAC (← q r"x:A") THEN
     EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(w:A->bool) SUBSET topspace top") MP_TAC THENL
      [ASM_MESON_TAC [OPEN_IN_SUBSET], ASM SET_TAC []],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS U") MP_TAC THENL
      [ASM_MESON_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"regular_space (top:A topology)") THEN
      REWRITE_TAC [regular_space] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"topspace top DIFF u:A->bool", ← q r"x:A"]) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, IN_DIFF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool")
        (X_CHOOSE_THEN (← q r"w':A->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"w:A->bool") THEN CONJ_TAC THENL
      [EXPAND_TAC "C" THEN REWRITE_TAC [IN_ELIM_THM] THEN
       ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"u:A->bool") THEN
       ASM_REWRITE_TAC [] THEN
       SUBGOAL_THEN (← q r"top closure_of (w:A->bool) SUBSET topspace top DIFF w'")
         MP_TAC THENL
       [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN CONJ_TAC THENL
        [SUBGOAL_THEN (← q r"(w:A->bool) SUBSET topspace top") MP_TAC THENL
         [ASM_MESON_TAC [OPEN_IN_SUBSET], ASM SET_TAC []],
         ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE]],
        ASM SET_TAC []],
       ASM_REWRITE_TAC []]], ALL_TAC] THEN
    /- Use paracompactness on cover C to get locally finite refinement V -/
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"C:(A->bool)->bool")) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"V:(A->bool)->bool") THEN
    /- Build the map r: V -> U via Skolemization -/
    SUBGOAL_THEN
      (← q r"?r:(A->bool)->(A->bool).
         !v. v IN V ==> r v IN U /\ top closure_of v SUBSET r v")
      MP_TAC THENL
    [REWRITE_TAC [← GSYM SKOLEM_THM_GEN] THEN
     X_GEN_TAC (← q r"v:A->bool") THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"?c:A->bool. c IN C /\ (v:A->bool) SUBSET c")
       MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
     SUBGOAL_THEN
       (← q r"?u:A->bool. u IN U /\ top closure_of (c:A->bool) SUBSET u")
       MP_TAC THENL
     [UNDISCH_TAC (← q r"(c:A->bool) IN C") THEN EXPAND_TAC "C" THEN SET_TAC [],
      ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC SUBSET_TRANS THEN
     EXISTS_TAC (← q r"top closure_of (c:A->bool)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC CLOSURE_OF_MONO THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:(A->bool)->(A->bool)") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"r:(A->bool)->(A->bool)") THEN
    ASM_REWRITE_TAC [])

  -- Indexed shrinking lemma: for each u IN U, produce v(u) open
  -- with closure in u, {v(u)} l.f. (by index, not set value)
  let PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING ← prove
   r"!top:A topology U.
        paracompact_space top /\ hausdorff_space top /\
        (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
        ==> ?v. (!u. u IN U ==> open_in top (v u) /\
                                 top closure_of (v u) SUBSET u) /\
                UNIONS (IMAGE v U) = topspace top /\
                (!x. x IN topspace top
                     ==> ?N. open_in top N /\ x IN N /\
                             FINITE {u | u IN U /\ ~(v u INTER N = {})})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"U:(A->bool)->bool"]
      PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"W:(A->bool)->bool")
      (X_CHOOSE_THEN (← q r"r:(A->bool)->(A->bool)") STRIP_ASSUME_TAC)) THEN
    /- Define v(u) = UNIONS {w IN W | r(w) = u} -/
    EXISTS_TAC (← q r"\u:A->bool. UNIONS {w:A->bool | w IN W /\ r w = u}") THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
    [/- v(u) is open and closure_of v(u) SUBSET u -/
     X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_SIMP_TAC [IN_ELIM_THM],
      /- closure_of UNIONS {w | r w = u} SUBSET u -/
      SUBGOAL_THEN
        (← q r"locally_finite_in top
         {w:A->bool | w IN W /\
                      (r:(A->bool)->(A->bool)) w = (u:A->bool)}")
        ASSUME_TAC THENL
      [REWRITE_TAC [locally_finite_in] THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [OPEN_IN_SUBSET],
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"locally_finite_in top (W:(A->bool)->bool)") THEN
        REWRITE_TAC [locally_finite_in] THEN
        DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC : thm → tactic)
          (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:A->bool") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{w:A->bool | w IN W /\ ~(w INTER N = {})}") THEN
        ASM SET_TAC []],
       ASM_SIMP_TAC [CLOSURE_OF_LOCALLY_FINITE_UNIONS] THEN
       REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN ASM SET_TAC []]],
     /- UNIONS IMAGE v U = topspace -/
     REWRITE_TAC [EXTENSION, IN_UNIONS, EXISTS_IN_IMAGE] THEN
     X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool")
        (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(w:A->bool) SUBSET topspace top") MP_TAC THENL
      [ASM_MESON_TAC [OPEN_IN_SUBSET], ASM SET_TAC []],
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS W") MP_TAC THENL
      [ASM_MESON_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(r:(A->bool)->(A->bool)) w") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC []],
     /- Index-level local finiteness -/
     X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     UNDISCH_TAC (← q r"locally_finite_in top (W:(A->bool)->bool)") THEN
     REWRITE_TAC [locally_finite_in] THEN
     DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC : thm → tactic)
       (MP_TAC o SPEC (← q r"x:A"))) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"N:A->bool") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC (← q r"N:A->bool") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC (← q r"IMAGE (r:(A->bool)->(A->bool))
       {w | w IN W /\ ~(w INTER N = {})}") THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS, IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") MP_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2
        (X_CHOOSE_THEN (← q r"w':A->bool") STRIP_ASSUME_TAC)
        ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w':A->bool") THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC []]])

  return { PARACOMPACT_HAUSDORFF_CLOSURE_REFINEMENT, PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING }

/- ------------------------------------------------------------------------- -/
/- Partitions of unity.  (metric.ml 44142-44477)                             -/
/- ------------------------------------------------------------------------- -/

structure POU where
  CONTINUOUS_MAP_SUM_LOCALLY_FINITE : thm
  PARACOMPACT_PARTITION_OF_UNITY : thm
  deriving Inhabited

@[nospecialize]
def setupPOU [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BContMap2 : ContMap2) (BAtPoint : AtPoint) (BLimits1 : Limits1) (BPtCont : PtCont)
    (BRealCont : RealCont) (BUrysohn : Urysohn) (BPARA2 : PARA2) (BSHR : SHR) :
    ExceptT String IO POU := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC, .. } :=
    D
  let { DISJOINT, ETA_AX, EXTENSION, FINITE_SUBSET, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { IMAGE_o, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NEUTRAL_REAL_ADD, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LE_DIV, REAL_LT_IMP_NZ, REAL_MUL_LZERO, REAL_MUL_RINV, REAL_POS, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUM_POS_LE, SUM_POS_LT, SUM_RMUL, SUM_SUPERSET, SUM_SUPPORT, o_DEF,
        real_div, support, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, SKOLEM_THM_GEN, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_INTO_FULLTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } :=
    BContMap2
  let { EVENTUALLY_ATPOINTOF, .. } := BAtPoint
  let { LIMIT_TRANSFORM_EVENTUALLY, .. } := BLimits1
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  let { CONTINUOUS_MAP_REAL_DIV, CONTINUOUS_MAP_SUM, .. } := BRealCont
  let { URYSOHN_LEMMA, .. } := BUrysohn
  let { PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE, .. } := BPARA2
  let { PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING, .. } := BSHR
  -- @@SCOPE END

  -- Continuity of a sum over a locally finite family
  let CONTINUOUS_MAP_SUM_LOCALLY_FINITE ← prove
   r"!top (f:K->A->real) (v:K->A->bool) (U:K->bool).
    (!u. u IN U ==> continuous_map(top,euclideanreal) (f u)) /\
    (!u. u IN U ==> !x. x IN topspace top /\ ~(x IN v u)
         ==> f u x = &0) /\
    (!x:A. x IN topspace top
         ==> ?N. open_in top N /\ x IN N /\
                 FINITE {u:K | u IN U /\ ~(v u INTER N = {})})
    ==> continuous_map(top,euclideanreal) (\x. sum U (\u. f u x))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N0:A->bool") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC
      (← q r"F0:K->bool = {u:K | u IN U /\ ~((v:K->A->bool) u INTER N0 = {})}") THEN
    SUBGOAL_THEN (← q r"F0 SUBSET (U:K->bool)") ASSUME_TAC THENL
    [EXPAND_TAC "F0" THEN SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE (F0:K->bool)") ASSUME_TAC THENL
    [EXPAND_TAC "F0" THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    /- On N0, sum over U equals sum over F0 -/
    SUBGOAL_THEN
      (← q r"!y:A. y IN topspace top /\ y IN N0
             ==> sum (U:K->bool) (\u. (f:K->A->real) u y) =
                 sum F0 (\u. f u y)") ASSUME_TAC THENL
    [X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN
     MATCH_MP_TAC SUM_SUPERSET THEN ASM_REWRITE_TAC [] THEN
     X_GEN_TAC (← q r"u':K") THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
     EXPAND_TAC "F0" THEN REWRITE_TAC [IN_ELIM_THM] THEN
     ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
     SUBGOAL_THEN (← q r"~(y:A IN (v:K->A->bool) u')") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
     BETA_TAC THEN ASM_MESON_TAC [],
     ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"atpointof top (x:A)",
                      ← q r"euclideanreal",
                      ← q r"\y:A. sum (F0:K->bool) (\u. (f:K->A->real) u y)",
                      ← q r"\y:A. sum (U:K->bool) (\u. (f:K->A->real) u y)",
                      ← q r"sum (U:K->bool) (\u. (f:K->A->real) u x)"]
                   LIMIT_TRANSFORM_EVENTUALLY) THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
    [REWRITE_TAC [EVENTUALLY_ATPOINTOF] THEN DISJ2_TAC THEN
     EXISTS_TAC (← q r"N0:A->bool") THEN ASM_REWRITE_TAC [] THEN
     X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A")) THEN
     ANTS_TAC THENL
     [CONJ_TAC THENL
      [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ASM_REWRITE_TAC []],
      DISCH_THEN (ACCEPT_TAC o SYM)],
     SUBGOAL_THEN
       (← q r"sum (U:K->bool) (\u. (f:K->A->real) u x) =
        sum F0 (\u. f u x)") SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
     MP_TAC (← ISPECL [← q r"top:A topology",
                       ← q r"\x:A. \u:K. (f:K->A->real) u x",
                       ← q r"F0:K->bool"] CONTINUOUS_MAP_SUM) THEN
     CONV_TAC (DEPTH_CONV BETA_CONV) THEN
     REWRITE_TAC [ETA_AX] THEN ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
     REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC []])

  -- Engelking 5.1.9: Partition of unity subordinate to locally finite cover
  let PARACOMPACT_PARTITION_OF_UNITY ← prove
   r"!top:A topology U.
        paracompact_space top /\ hausdorff_space top /\
        (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
        ==> ?phi. (!u. u IN U
                       ==> continuous_map(top,euclideanreal) (phi u) /\
                           (!x. x IN topspace top ==> &0 <= phi u x) /\
                           {x | x IN topspace top /\ ~(phi u x = &0)}
                             SUBSET u) /\
                  (!x. x IN topspace top
                       ==> ?N. open_in top N /\ x IN N /\
                               FINITE {u | u IN U /\ ~(N INTER
                                 {y | y IN topspace top /\ ~(phi u y = &0)} = {})}) /\
                  (!x. x IN topspace top ==> sum U (\u. phi u x) = &1)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    /- Step 1: First indexed shrinking -/
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"U:(A->bool)->bool"]
      PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:(A->bool)->(A->bool)") STRIP_ASSUME_TAC) THEN
    /- Step 2: Second indexed shrinking on IMAGE v U -/
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"IMAGE (v:(A->bool)->(A->bool)) U"]
      PARACOMPACT_HAUSDORFF_INDEXED_SHRINKING) THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w0:(A->bool)->(A->bool)") STRIP_ASSUME_TAC) THEN
    /- Step 3: normal_space -/
    SUBGOAL_THEN (← q r"normal_space (top:A topology)") ASSUME_TAC THENL
    [MATCH_MP_TAC PARACOMPACT_HAUSDORFF_IMP_NORMAL_SPACE THEN
     ASM_REWRITE_TAC [], ALL_TAC] THEN
    /- Properties of w0(v(u)): open, closure in v(u) -/
    SUBGOAL_THEN
      (← q r"!u:A->bool. u IN U ==>
         open_in top ((w0:(A->bool)->(A->bool)) ((v:(A->bool)->(A->bool)) u)) /\
         top closure_of (w0 (v u)) SUBSET v u")
      ASSUME_TAC THENL
    [ASM_MESON_TAC [FUN_IN_IMAGE], ALL_TAC] THEN
    /- IMAGE (w0 o v) covers topspace -/
    SUBGOAL_THEN
      (← q r"UNIONS (IMAGE (\u:A->bool.
         (w0:(A->bool)->(A->bool)) ((v:(A->bool)->(A->bool)) u)) U) =
       topspace top")
      ASSUME_TAC THENL
    [SUBGOAL_THEN
       (← q r"IMAGE (\u:A->bool.
          (w0:(A->bool)->(A->bool)) ((v:(A->bool)->(A->bool)) u)) U =
        IMAGE w0 (IMAGE v U)") SUBST1_TAC THENL
     [ONCE_REWRITE_TAC [← GSYM IMAGE_o] THEN REWRITE_TAC [o_DEF],
      ASM_REWRITE_TAC []], ALL_TAC] THEN
    /- Step 4: Urysohn functions for each u -/
    SUBGOAL_THEN
      (← q r"!u:A->bool. u IN U
       ==> ?f:A->real.
             continuous_map
               (top,subtopology euclideanreal (real_interval[&0,&1])) f /\
             (!x. x IN topspace top DIFF (v:(A->bool)->(A->bool)) u
                  ==> f x = &0) /\
             (!x. x IN top closure_of
                         ((w0:(A->bool)->(A->bool)) (v u))
                  ==> f x = &1)")
      MP_TAC THENL
    [X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
     MATCH_MP_TAC URYSOHN_LEMMA THEN ASM_REWRITE_TAC [REAL_POS] THEN
     REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_DIFF THEN
      ASM_SIMP_TAC [CLOSED_IN_TOPSPACE],
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF],
      SUBGOAL_THEN
        (← q r"top closure_of ((w0:(A->bool)->(A->bool))
          ((v:(A->bool)->(A->bool)) u)) SUBSET v u")
        MP_TAC THENL
      [ASM_MESON_TAC [],
       REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY,
                    IN_DIFF, SUBSET] THEN
       MESON_TAC []]], ALL_TAC] THEN
    /- Skolemize -/
    REWRITE_TAC [SKOLEM_THM_GEN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"psi:(A->bool)->A->real") STRIP_ASSUME_TAC) THEN
    /- Step 5: Define phi(u)(x) = psi(u)(x) / sum_U psi -/
    EXISTS_TAC
      (← q r"(\u:A->bool. \x:A.
          if x IN topspace top
          then (psi:(A->bool)->A->real) u x /
               sum U (\u'. psi u' x)
          else &0):(A->bool)->A->real") THEN
    REWRITE_TAC [] THEN
    SUBGOAL_THEN
      (← q r"!u:A->bool. u IN U
       ==> continuous_map(top,euclideanreal) ((psi:(A->bool)->A->real) u)")
      ASSUME_TAC THENL
    [GEN_TAC THEN DISCH_TAC THEN
     MATCH_MP_TAC CONTINUOUS_MAP_INTO_FULLTOPOLOGY THEN
     EXISTS_TAC (← q r"real_interval[&0,&1]") THEN ASM_SIMP_TAC [],
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!u:A->bool. u IN U
       ==> !x:A. x IN topspace top
           ==> &0 <= (psi:(A->bool)->A->real) u x")
      ASSUME_TAC THENL
    [REPEAT STRIP_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool") o
       check (HolCore.Basics.free_in (← q r"real_interval") o concl)) THEN
     ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
     FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o
       GEN_REWRITE_RULE id [CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
     REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
     REAL_ARITH_TAC,
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!u:A->bool. u IN U
       ==> !x:A. x IN topspace top /\ ~(x IN (v:(A->bool)->(A->bool)) u)
           ==> (psi:(A->bool)->A->real) u x = &0")
      ASSUME_TAC THENL
    [REPEAT STRIP_TAC THEN ASM_MESON_TAC [IN_DIFF],
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!x:A. x IN topspace top
       ==> FINITE {u:A->bool | u IN U /\
             ~((psi:(A->bool)->A->real) u x = &0)}")
      ASSUME_TAC THENL
    [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC
       (← q r"{u:A->bool | u IN U /\ x IN (v:(A->bool)->(A->bool)) u}") THEN
     CONJ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"x:A IN (v:(A->bool)->(A->bool)) x'") THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [IN_DIFF]] THEN
     SUBGOAL_THEN
       (← q r"?N0:A->bool. open_in top N0 /\ x IN N0 /\
          FINITE {u:A->bool | u IN U /\
            ~((v:(A->bool)->(A->bool)) u INTER N0 = {})}")
       STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC
       (← q r"{u:A->bool | u IN U /\
         ~((v:(A->bool)->(A->bool)) u INTER N0 = {})}") THEN
     ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
     GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     ASM SET_TAC [],
     ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!x:A. x IN topspace top
       ==> &0 < sum U (\u:A->bool. (psi:(A->bool)->A->real) u x)")
      ASSUME_TAC THENL
    [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
     SUBGOAL_THEN
       (← q r"?u0:A->bool. u0 IN U /\
          x IN (w0:(A->bool)->(A->bool)) ((v:(A->bool)->(A->bool)) u0)")
       STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
        (← q r"x:A IN UNIONS (IMAGE (\u:A->bool.
          (w0:(A->bool)->(A->bool)) ((v:(A->bool)->(A->bool)) u)) U)")
        MP_TAC THENL
      [ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [IN_UNIONS, IN_IMAGE] THEN MESON_TAC [],
      ALL_TAC] THEN
     SUBGOAL_THEN (← q r"(psi:(A->bool)->A->real) u0 x = &1") ASSUME_TAC THENL
     [ASM_MESON_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET, SUBSET],
      ALL_TAC] THEN
     ONCE_REWRITE_TAC [← GSYM SUM_SUPPORT] THEN
     REWRITE_TAC [support, NEUTRAL_REAL_ADD] THEN
     MATCH_MP_TAC SUM_POS_LT THEN
     CONJ_TAC THENL [ASM_SIMP_TAC [], ALL_TAC] THEN
     CONJ_TAC THENL
     [ASM SET_TAC [],
      EXISTS_TAC (← q r"u0:A->bool") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC],
     ALL_TAC] THEN
    /- Step 6: Verify three conditions -/
    REPEAT CONJ_TAC THENL
    [/- Condition 1: continuity, nonnegativity, support -/
     X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
     ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [/- Continuity of phi u -/
      SUBGOAL_THEN
        (← q r"continuous_map(top,euclideanreal)
          (\x:A. (psi:(A->bool)->A->real) u x /
                 sum U (\u':A->bool. psi u' x))")
        ASSUME_TAC THENL
      [MP_TAC (← ISPECL [← q r"top:A topology",
                         ← q r"\x:A. (psi:(A->bool)->A->real) u x",
                         ← q r"\x:A. sum U (\u':A->bool.
                               (psi:(A->bool)->A->real) u' x)"]
         CONTINUOUS_MAP_REAL_DIV) THEN
       CONV_TAC (DEPTH_CONV BETA_CONV) THEN
       ANTS_TAC THENL
       [REWRITE_TAC [ETA_AX] THEN REPEAT CONJ_TAC THENL
        [ASM_SIMP_TAC [],
         MATCH_MP_TAC (← ISPECL [← q r"top:A topology",
                                 ← q r"psi:(A->bool)->A->real",
                                 ← q r"v:(A->bool)->A->bool",
                                 ← q r"U:(A->bool)->bool"]
                      CONTINUOUS_MAP_SUM_LOCALLY_FINITE) THEN
         ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
         X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
         MATCH_MP_TAC REAL_LT_IMP_NZ THEN ASM_SIMP_TAC []],
        DISCH_THEN ACCEPT_TAC],
       ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"euclideanreal",
        ← q r"\x:A. (psi:(A->bool)->A->real) u x /
               sum U (\u':A->bool. psi u' x)",
        ← q r"\x:A. if x:A IN topspace top
               then (psi:(A->bool)->A->real) u x /
                    sum U (\u':A->bool. psi u' x)
               else &0"] CONTINUOUS_MAP_EQ) THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN
      ANTS_TAC THENL
      [CONJ_TAC THENL
       [GEN_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [],
        ASM_REWRITE_TAC []],
       DISCH_THEN ACCEPT_TAC],
      /- Nonnegativity -/
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_DIV THEN
      CONJ_TAC THENL [ASM_SIMP_TAC [],
       MATCH_MP_TAC SUM_POS_LE THEN ASM_SIMP_TAC []],
      /- Support contained in u -/
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_CASES_TAC (← q r"x:A IN (v:(A->bool)->(A->bool)) u") THENL
      [DISCH_TAC THEN ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET, CLOSURE_OF_SUBSET],
       SUBGOAL_THEN (← q r"(psi:(A->bool)->A->real) u x = &0")
         ASSUME_TAC THENL [ASM_MESON_TAC [IN_DIFF], ALL_TAC] THEN
       ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO]]],
     /- Condition 2: local finiteness -/
     GEN_REWRITE_TAC id [← GSYM SKOLEM_THM] THEN X_GEN_TAC (← q r"x:A") THEN
     GEN_REWRITE_TAC id [← GSYM RIGHT_IMP_EXISTS_THM] THEN DISCH_TAC THEN
     SUBGOAL_THEN
       (← q r"?N0:A->bool. open_in top N0 /\ x IN N0 /\
          FINITE {u:A->bool | u IN U /\
            ~((v:(A->bool)->(A->bool)) u INTER N0 = {})}")
       STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
     EXISTS_TAC (← q r"N0:A->bool") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC FINITE_SUBSET THEN
     EXISTS_TAC
       (← q r"{u:A->bool | u IN U /\
         ~((v:(A->bool)->(A->bool)) u INTER N0 = {})}") THEN
     ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
     X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
     REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_ELIM_THM] THEN
     MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:A") THEN
     STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
     ASM_CASES_TAC (← q r"(y:A) IN (v:(A->bool)->(A->bool)) u") THEN
     ASM_REWRITE_TAC [] THEN
     SUBGOAL_THEN (← q r"(psi:(A->bool)->A->real) u (y:A) = &0")
       ASSUME_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o check
       ((fun (p : term) (c : term) => HolCore.Basics.is_neg c && HolCore.Basics.free_in p c)
         (← q r"psi:(A->bool)->A->real") o concl)) THEN
     ASM_REWRITE_TAC [real_div, REAL_MUL_LZERO],
     /- Condition 3: sum = 1 -/
     X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
     REWRITE_TAC [real_div, SUM_RMUL] THEN
     MATCH_MP_TAC REAL_MUL_RINV THEN
     MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x ==> ~(x = &0)")) THEN
     ASM_SIMP_TAC []])

  return { CONTINUOUS_MAP_SUM_LOCALLY_FINITE, PARACOMPACT_PARTITION_OF_UNITY }

/- ------------------------------------------------------------------------- -/
/- Regular Lindelof spaces; perfect preimages.  (metric.ml 44479-44687)      -/
/- ------------------------------------------------------------------------- -/

structure PPRE where
  REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE : thm
  SECOND_COUNTABLE_REGULAR_IMP_PARACOMPACT_SPACE : thm
  PARACOMPACT_SPACE_PERFECT_MAP_PREIMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPPRE [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BContMap1 : ContMap1) (BOpenClosed2 : OpenClosed2) (BCompact1 : Compact1)
    (BProper1 : Proper1) (BPerfect : Perfect) (BLindelof : Lindelof)
    (BCountability : Countability) (BPARA1 : PARA1) (BPARA2 : PARA2) (BMICH2 : MICH2) :
    ExceptT String IO PPRE := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FINITE_IMAGE, FINITE_SUBSET, FINITE_UNIONS, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, UNIONS_SUBSET, .. } :=
    D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { CLOSED_MAP_FIBRE_NEIGHBOURHOOD, .. } := BOpenClosed2
  let { compact_in, .. } := BCompact1
  let { proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { lindelof_space, .. } := BLindelof
  let { SECOND_COUNTABLE_IMP_LINDELOF_SPACE, .. } := BCountability
  let { paracompact_space, .. } := BPARA1
  let { COUNTABLE_IMP_SIGMA_LOCALLY_FINITE_IN, .. } := BPARA2
  let { MICHAEL_LEMMA, .. } := BMICH2
  -- @@SCOPE END

  -- Munkres 41.5: Regular Lindelof space is paracompact
  -- Proof: A countable subcover is sigma-locally-finite; apply Michael's Lemma
  let REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ lindelof_space top
        ==> paracompact_space top"
   (GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [paracompact_space] THEN
    MP_TAC (← ISPEC (← q r"top:A topology") MICHAEL_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [lindelof_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"V:(A->bool)->bool") THEN
    REPEAT CONJ_TAC THENL
    [ASM_MESON_TAC [SUBSET],
     ASM_REWRITE_TAC [],
     ASM_MESON_TAC [SUBSET, SUBSET_REFL],
     MATCH_MP_TAC COUNTABLE_IMP_SIGMA_LOCALLY_FINITE_IN THEN
     ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET]])

  -- Corollary of Munkres 41.5: Second-countable regular space is paracompact
  let SECOND_COUNTABLE_REGULAR_IMP_PARACOMPACT_SPACE ← prove
   r"!top:A topology.
        second_countable top /\ regular_space top
        ==> paracompact_space top"
   (MESON_TAC [REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE,
               SECOND_COUNTABLE_IMP_LINDELOF_SPACE])

  -- Engelking 5.1.35: Perfect preimage of paracompact is paracompact
  let PARACOMPACT_SPACE_PERFECT_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B).
        perfect_map(top,top') f /\ paracompact_space top'
        ==> paracompact_space top"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [perfect_map]) THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [proper_map]) THEN
    REWRITE_TAC [paracompact_space] THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    /- Step 1: For each y in Y, get open V(y) in Y and finite F(y) SUBSET U
       such that f^{-1}(V(y)) SUBSET UNIONS F(y) -/
    SUBGOAL_THEN
      (← q r"!y:B. y IN topspace top'
             ==> ?V F. open_in top' V /\ y IN V /\
                       FINITE F /\ F SUBSET (U:(A->bool)->bool) /\
                       {x:A | x IN topspace top /\ (f:A->B) x IN V}
                       SUBSET UNIONS F")
      MP_TAC THENL
     [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"compact_in top {x:A | x IN topspace top /\ (f:A->B) x = y}")
        ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o
        CONJUNCT2 o GEN_REWRITE_RULE id [compact_in]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"F0:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (MP_TAC o CONJUNCT2 o
        REWRITE_RULE [CLOSED_MAP_FIBRE_NEIGHBOURHOOD]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"UNIONS F0:A->bool", ← q r"y:B"]) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_MESON_TAC [SUBSET],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V0:B->bool") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC [← q r"V0:B->bool", ← q r"F0:(A->bool)->bool"] THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    /- Skolemize to get functions VV and FF -/
    DISCH_THEN (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"VV:B->(B->bool)")
      (X_CHOOSE_THEN (← q r"FF:B->((A->bool)->bool)") (LABEL_TAC "sk"))) THEN
    /- Step 2: Apply paracompactness of top' to {VV y | y in topspace top'} -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
    DISCH_THEN (MP_TAC o
      SPEC (← q r"{(VV:B->(B->bool)) y | y IN topspace top'}")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM_MESON_TAC [],
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
          ASM_MESON_TAC [OPEN_IN_SUBSET],
          REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
          EXISTS_TAC (← q r"(VV:B->(B->bool)) y") THEN ASM_MESON_TAC []]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"W:(B->bool)->bool")
      (CONJUNCTS_THEN2 (LABEL_TAC "Wop")
        (CONJUNCTS_THEN2 (LABEL_TAC "Wcov")
          (CONJUNCTS_THEN2 (LABEL_TAC "Wref")
            (LABEL_TAC "Wlf"))))) THEN
    /- Step 3: Skolemize the refinement map -/
    SUBGOAL_THEN
      (← q r"?yw:(B->bool)->B. !w. w IN W
           ==> (yw w) IN topspace top' /\
               w SUBSET (VV:B->(B->bool)) (yw w)")
      (X_CHOOSE_THEN (← q r"yw:(B->bool)->B") (LABEL_TAC "yw")) THENL
     [REWRITE_TAC [← GSYM SKOLEM_THM] THEN X_GEN_TAC (← q r"w:B->bool") THEN
      USE_THEN "Wref" (MP_TAC o SPEC (← q r"w:B->bool")) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    /- Step 4: Define the final cover -/
    EXISTS_TAC
      (← q r"{u INTER {x:A | x IN topspace top /\ (f:A->B) x IN w} |
        w,u | w IN (W:(B->bool)->bool) /\
              u IN (FF:B->((A->bool)->bool))((yw:(B->bool)->B) w)}") THEN
    REPEAT CONJ_TAC THENL
     [/- Open: each u INTER f^{-1}(w) is open -/
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:B->bool", ← q r"u:A->bool"] THEN STRIP_TAC THEN
      MATCH_MP_TAC OPEN_IN_INTER THEN CONJ_TAC THENL
       [USE_THEN "sk" (MP_TAC o SPEC (← q r"(yw:(B->bool)->B) w")) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        STRIP_TAC THEN ASM_MESON_TAC [SUBSET],
        MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':(B)topology") THEN ASM_MESON_TAC []],
      /- Covers: UNIONS of the cover = topspace top -/
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
        REPEAT STRIP_TAC THEN ASM SET_TAC [],
        REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(f:A->B) x IN topspace top'") ASSUME_TAC THENL
         [ASM_MESON_TAC [continuous_map, SUBSET, IN_IMAGE], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?w:B->bool. w IN W /\ (f:A->B) x IN w")
          (X_CHOOSE_THEN (← q r"w0:B->bool") STRIP_ASSUME_TAC) THENL
         [USE_THEN "Wcov" MP_TAC THEN
          REWRITE_TAC [EXTENSION, IN_UNIONS] THEN ASM_MESON_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(x:A) IN UNIONS ((FF:B->((A->bool)->bool))
          ((yw:(B->bool)->B) w0))") MP_TAC THENL
         [USE_THEN "sk" (MP_TAC o SPEC (← q r"(yw:(B->bool)->B) w0")) THEN
          ANTS_TAC THENL
           [USE_THEN "yw" (MP_TAC o SPEC (← q r"w0:B->bool")) THEN
            ANTS_TAC THENL [ASM_REWRITE_TAC [], MESON_TAC []],
            ALL_TAC] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
          REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [SUBSET],
          ALL_TAC] THEN REWRITE_TAC [IN_UNIONS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u0:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"u0 INTER {x:A | x IN topspace top /\
          (f:A->B) x IN (w0:B->bool)}") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [IN_ELIM_THM] THEN
          MAP_EVERY EXISTS_TAC [← q r"w0:B->bool", ← q r"u0:A->bool"] THEN
          ASM_REWRITE_TAC [],
          REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN ASM_REWRITE_TAC []]],
      /- Refines: each element is subset of some u in U -/
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:B->bool", ← q r"u:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"u:A->bool") THEN CONJ_TAC THENL
       [USE_THEN "sk" (MP_TAC o SPEC (← q r"(yw:(B->bool)->B) w")) THEN
        ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        STRIP_TAC THEN ASM SET_TAC [],
        SET_TAC []],
      /- Locally finite -/
      REWRITE_TAC [locally_finite_in] THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN
        REPEAT STRIP_TAC THEN ASM SET_TAC [],
        ALL_TAC] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(f:A->B) x IN topspace top'") ASSUME_TAC THENL
       [ASM_MESON_TAC [continuous_map, SUBSET, IN_IMAGE], ALL_TAC] THEN
      USE_THEN "Wlf" (MP_TAC o REWRITE_RULE [locally_finite_in]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"(f:A->B) x"))) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:B->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{x:A | x IN topspace top /\ (f:A->B) x IN N}") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':(B)topology") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
        (← q r"UNIONS (IMAGE
          (\w. {u INTER {x:A | x IN topspace top /\ (f:A->B) x IN w} |
                u | u IN (FF:B->((A->bool)->bool))((yw:(B->bool)->B) w)})
          {w:B->bool | w IN W /\ ~(w INTER (N:B->bool) = {})})") THEN
      CONJ_TAC THENL
       [/- FINITE of the UNIONS -/
        REWRITE_TAC [FINITE_UNIONS] THEN CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_IMAGE THEN ASM_REWRITE_TAC [],
          REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"w1:B->bool") THEN STRIP_TAC THEN
          REWRITE_TAC [SIMPLE_IMAGE] THEN
          MATCH_MP_TAC FINITE_IMAGE THEN
          USE_THEN "sk" (MP_TAC o SPEC (← q r"(yw:(B->bool)->B) w1")) THEN
          ANTS_TAC THENL [ASM_MESON_TAC [], SIMP_TAC []]],
        /- SUBSET -/
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIONS, IN_IMAGE] THEN
        X_GEN_TAC (← q r"s:A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"w1:B->bool")
            (X_CHOOSE_THEN (← q r"u1:A->bool") STRIP_ASSUME_TAC))
          ASSUME_TAC) THEN
        EXISTS_TAC
          (← q r"{u INTER {x:A | x IN topspace top /\ (f:A->B) x IN w1} |
            u | u IN (FF:B->((A->bool)->bool))((yw:(B->bool)->B) w1)}") THEN
        CONJ_TAC THENL
         [EXISTS_TAC (← q r"w1:B->bool") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
          FIRST_X_ASSUM (MP_TAC o
            GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
          ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN ASM SET_TAC [],
          REWRITE_TAC [IN_ELIM_THM] THEN
          EXISTS_TAC (← q r"u1:A->bool") THEN ASM_REWRITE_TAC []]]])

  return { REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE,
           SECOND_COUNTABLE_REGULAR_IMP_PARACOMPACT_SPACE,
           PARACOMPACT_SPACE_PERFECT_MAP_PREIMAGE }

/- ------------------------------------------------------------------------- -/
/- More paracompactness results.  (metric.ml 44688-44832)                    -/
/- ------------------------------------------------------------------------- -/

structure PARA3 where
  LOCALLY_FINITE_IN_HOMEOMORPHIC_IMAGE : thm
  PARACOMPACT_SPACE_DISCRETE_TOPOLOGY : thm
  SECOND_COUNTABLE_LOCALLY_COMPACT_HAUSDORFF_IMP_PARACOMPACT : thm
  LINDELOF_HAUSDORFF_REGULAR_EQ_PARACOMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupPARA3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BIterLocal : IterLocal) (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BCountability : Countability)
    (BLocCompact1 : LocCompact1) (BPARA1 : PARA1) (BPARA2 : PARA2) (BPPRE : PPRE) :
    ExceptT String IO PARA3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FINITE_IMAGE, FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, .. } := D.core1
  let { INTER_COMM, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET, UNIONS_SINGS, .. } := D.core4
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { locally_finite_in, .. } := BIterLocal
  let { continuous_map, .. } := BContMap1
  let { open_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_IMP_OPEN_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { SECOND_COUNTABLE_IMP_LINDELOF_SPACE, .. } := BCountability
  let { LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BLocCompact1
  let { paracompact_space, .. } := BPARA1
  let { PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BPARA2
  let { REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE, .. } := BPPRE
  -- @@SCOPE END

  -- Helper: locally finite is preserved under homeomorphism image
  let LOCALLY_FINITE_IN_HOMEOMORPHIC_IMAGE ← prove
   r"!(top:A topology) (top':B topology) f g V.
        homeomorphic_maps(top,top') (f,g) /\ locally_finite_in top V
        ==> locally_finite_in top' (IMAGE (IMAGE f) V)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [locally_finite_in, FORALL_IN_IMAGE] THEN
    /- Extract useful facts from homeomorphic_maps -/
    FIRST_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [homeomorphic_maps]) THEN
    /- f is an open map - using HOMEOMORPHIC_MAPS_MAP directly -/
    SUBGOAL_THEN (← q r"homeomorphic_map(top,top') (f:A->B)") ASSUME_TAC THENL
    [REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN EXISTS_TAC (← q r"g:B->A") THEN
     ASM_REWRITE_TAC [homeomorphic_maps], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"open_map(top,top') (f:A->B)") ASSUME_TAC THENL
    [ASM_MESON_TAC [HOMEOMORPHIC_IMP_OPEN_MAP], ALL_TAC] THEN
    /- Get the locally finite assumptions -/
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
    /- Also extract continuous_map facts -/
    SUBGOAL_THEN
      (← q r"IMAGE (f:A->B) (topspace top) SUBSET topspace top'")
      ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"continuous_map(top,top') (f:A->B)") THEN
     REWRITE_TAC [continuous_map] THEN SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"IMAGE (g:B->A) (topspace top') SUBSET topspace top")
      ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"continuous_map(top',top) (g:B->A)") THEN
     REWRITE_TAC [continuous_map] THEN SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL
    [/- Part 1: Each IMAGE f v SUBSET topspace top' -/
     X_GEN_TAC (← q r"v:A->bool") THEN DISCH_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:A->bool")) THEN ASM_REWRITE_TAC [] THEN
     DISCH_TAC THEN ASM SET_TAC [],
     ALL_TAC] THEN
    /- Part 2: For y, find open nbhd meeting finitely many IMAGE f v -/
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    /- g(y) is in topspace top -/
    SUBGOAL_THEN (← q r"(g:B->A) y IN topspace top") ASSUME_TAC THENL
    [ASM SET_TAC [], ALL_TAC] THEN
    /- Use locally finite at g(y) - be explicit about which assumption -/
    UNDISCH_TAC
     (← q r"!x:A. x IN topspace top
            ==> ?v. open_in top v /\ x IN v /\
                    FINITE {u | u IN V /\ ~(u INTER v = {})}") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(g:B->A) y")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    /- IMAGE f u is open in top' -/
    SUBGOAL_THEN (← q r"open_in top' (IMAGE (f:A->B) u)") ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"open_map(top,top') (f:A->B)") THEN
     REWRITE_TAC [open_map] THEN DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    /- y = f(g(y)) IN IMAGE f u -/
    SUBGOAL_THEN (← q r"(y:B) IN IMAGE (f:A->B) u") ASSUME_TAC THENL
    [REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"(g:B->A) y") THEN
     CONJ_TAC THENL [ASM_MESON_TAC [], ASM_REWRITE_TAC []],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) u") THEN ASM_REWRITE_TAC [] THEN
    /- The key: {w | w IN IMAGE (IMAGE f) V /\ ~(IMAGE f u INTER w = {})}
                SUBSET IMAGE (IMAGE f) {v | v IN V /\ ~(u INTER v = {})} -/
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC
      (← q r"IMAGE (IMAGE (f:A->B))
             {v:A->bool | v IN V /\ ~(u INTER v = {})}") THEN
    /- First prove FINITE using the assumption - need to show sets are equal -/
    SUBGOAL_THEN (← q r"{v:A->bool | v IN V /\ ~(u INTER v = {})} =
                  {u' | u' IN V /\ ~(u' INTER u = {})}") SUBST1_TAC THENL
    [REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN MESON_TAC [INTER_COMM], ALL_TAC] THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_IMAGE] THEN
    X_GEN_TAC (← q r"w:B->bool") THEN STRIP_TAC THEN
    /- Now: w = IMAGE f x, x IN V, ~(w INTER IMAGE f u = {}) -/
    /- Goal: exists y. w = IMAGE f y /\ y IN V /\ ~(y INTER u = {}) -/
    EXISTS_TAC (← q r"x:A->bool") THEN
    CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    /- Need: ~(x INTER u = {}) -/
    /- We have: ~(w INTER IMAGE f u = {}), i.e.,
       ~(IMAGE f x INTER IMAGE f u = {}) -/
    /- Use injectivity: if z IN IMAGE f x INTER IMAGE f u, then z = f a = f b -/
    /- with a IN x, b IN u, and by injectivity a = b, so a IN x INTER u -/
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN_INTER, IN_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:B") (CONJUNCTS_THEN2
      (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC)
      (X_CHOOSE_THEN (← q r"b:A") STRIP_ASSUME_TAC))) THEN
    /- f a = z = f b, and since g(f t) = t on topspace, we get a = b -/
    /- But a IN x and b IN u, so x INTER u != {} -/
    SUBGOAL_THEN (← q r"(a:A) IN topspace top") ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"!u:A->bool. u IN V ==> u SUBSET topspace top") THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"x:A->bool")) THEN ASM_REWRITE_TAC [] THEN
     UNDISCH_TAC (← q r"(a:A) IN x") THEN SET_TAC [],
     ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(b:A) IN topspace top") ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"open_in top (u:A->bool)") THEN
     DISCH_THEN (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
     UNDISCH_TAC (← q r"(b:A) IN u") THEN SET_TAC [],
     ALL_TAC] THEN
    /- Use injectivity: g(f a) = a and g(f b) = b, and f a = f b, so a = b -/
    UNDISCH_TAC (← q r"!x:A. x IN topspace top ==> (g:B->A)((f:A->B) x) = x") THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"a:A") th) THEN MP_TAC (← SPEC (← q r"b:A") th))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN DISCH_TAC THEN
    /- Now we have g(f a) = a and g(f b) = b -/
    /- Also f a = z and f b = z, so f a = f b -/
    /- Therefore g(f a) = g(f b), i.e., a = b -/
    /- Prove a = b using injectivity: g(f a) = a, g(f b) = b, f a = z = f b -/
    /- g(f a) = g(f b) hence a = b, contradicting disjointness -/
    ASM_MESON_TAC [IN_INTER, MEMBER_NOT_EMPTY])

  -- Paracompactness of discrete topology
  let PARACOMPACT_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. paracompact_space(discrete_topology u)"
   (GEN_TAC THEN REWRITE_TAC [paracompact_space, locally_finite_in] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"{{x:A} | x IN u}") THEN
    REWRITE_TAC [UNIONS_SINGS, FORALL_IN_GSPEC, SING_SUBSET] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"{x:A}") THEN
    ASM_REWRITE_TAC [IN_SING, SING_SUBSET, ← SET_RULE (← q
     r"{(y:A->bool) | y IN {(f:A->A->bool) x | P x} /\ Q y} =
      IMAGE f {x:A | P x /\ Q(f x)}")] THEN
    MATCH_MP_TAC FINITE_IMAGE THEN MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"{x:A}") THEN REWRITE_TAC [FINITE_SING] THEN SET_TAC [])

  -- Second countable + locally compact + Hausdorff implies paracompact
  let SECOND_COUNTABLE_LOCALLY_COMPACT_HAUSDORFF_IMP_PARACOMPACT ← prove
   r"!top:A topology.
        second_countable top /\ locally_compact_space top /\
        hausdorff_space top
        ==> paracompact_space top"
   (MESON_TAC [LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE,
               SECOND_COUNTABLE_IMP_LINDELOF_SPACE,
               REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE])

  -- For Lindelof Hausdorff spaces, regular <=> paracompact
  let LINDELOF_HAUSDORFF_REGULAR_EQ_PARACOMPACT ← prove
   r"!top:A topology.
        lindelof_space top /\ hausdorff_space top
        ==> (regular_space top <=> paracompact_space top)"
   (MESON_TAC [REGULAR_LINDELOF_IMP_PARACOMPACT_SPACE,
               PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE])

  return { LOCALLY_FINITE_IN_HOMEOMORPHIC_IMAGE, PARACOMPACT_SPACE_DISCRETE_TOPOLOGY,
           SECOND_COUNTABLE_LOCALLY_COMPACT_HAUSDORFF_IMP_PARACOMPACT,
           LINDELOF_HAUSDORFF_REGULAR_EQ_PARACOMPACT }

/- ------------------------------------------------------------------------- -/
/- Expansion lemma; refinement characterizations.  (metric.ml 44834-45083)   -/
/- ------------------------------------------------------------------------- -/

structure EXPL where
  PARACOMPACT_HAUSDORFF_EXPANSION_LEMMA : thm
  PARACOMPACT_SPACE_EQ_CLOSED_REFINEMENT : thm
  PARACOMPACT_SPACE_EQ_LOCALLY_FINITE_REFINEMENT : thm
  deriving Inhabited

@[nospecialize]
def setupEXPL [HolBase] (D : MetricDeps) (BTopology : Topology) (BIterLocal : IterLocal)
    (BPARA1 : PARA1) (BPARA2 : PARA2) (BMICH1 : MICH1) (BLFO : LFO) :
    ExceptT String IO EXPL := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { FINITE_IMAGE, FINITE_SUBSET, FINITE_UNIONS, FORALL_IN_GSPEC, .. } := D.core1
  let { INTER_COMM, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_UNIONS, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, UNIONS_SUBSET, .. } := D.core4
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { locally_finite_in, .. } := BIterLocal
  let { paracompact_space, .. } := BPARA1
  let { PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BPARA2
  let { EXPANSION_SET_CONTAINS, EXPANSION_SET_OPEN, LF_COVERING_IMP_LF_CLOSED, .. } := BMICH1
  let { LF_COVERING_IMP_LF_OPEN, .. } := BLFO
  -- @@SCOPE END

  -- Munkres Exercise 41.5: Expansion Lemma.
  -- If {B_alpha} is a locally finite family of subsets of a paracompact
  -- Hausdorff space X, there is a locally finite family {U_alpha} of open
  -- sets with B_alpha SUBSET U_alpha for each alpha.
  -- Proof: Build open cover N from LF of B, get LF closed refinement C,
  -- then use expansion E(b) = X \ UNIONS{c IN C | c INTER b = {}}.
  let PARACOMPACT_HAUSDORFF_EXPANSION_LEMMA ← prove
   r"!top (B:(A->bool)->bool).
        paracompact_space top /\ hausdorff_space top /\
        (!b. b IN B ==> b SUBSET topspace top) /\
        locally_finite_in top B
        ==> ?f. (!b. b IN B ==> open_in top (f b)) /\
                (!b. b IN B ==> b SUBSET f b) /\
                locally_finite_in top {f b | b IN B}"
   (REPEAT STRIP_TAC THEN
    /- Paracompact Hausdorff => regular -/
    SUBGOAL_THEN (← q r"regular_space (top:A topology)") ASSUME_TAC THENL
     [ASM_MESON_TAC [PARACOMPACT_HAUSDORFF_IMP_REGULAR_SPACE], ALL_TAC] THEN
    /- Step 1: Build open cover N = {w open | FINITE {b IN B | b meets w}} -/
    ABBREV_TAC
      (← q r"N = {w:A->bool | open_in top w /\
                        FINITE {b:A->bool | b IN B /\ ~(b INTER w = {})}}") THEN
    SUBGOAL_THEN (← q r"(!w:A->bool. w IN N ==> open_in top w)") ASSUME_TAC THENL
     [EXPAND_TAC "N" THEN SIMP_TAC [IN_ELIM_THM], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"UNIONS (N:(A->bool)->bool) = topspace top")
      (LABEL_TAC "Ncov") THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET] THEN ASM_MESON_TAC [OPEN_IN_SUBSET],
        REWRITE_TAC [SUBSET, IN_UNIONS] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"locally_finite_in top (B:(A->bool)->bool)") THEN
        REWRITE_TAC [locally_finite_in] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"w:A->bool") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "N" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    /- Step 2: Get LF closed refinement C of N -/
    SUBGOAL_THEN
      (← q r"?C:(A->bool)->bool.
          UNIONS C = topspace top /\ locally_finite_in top C /\
          (!c. c IN C ==> closed_in top c) /\
          (!c. c IN C ==> ?n. n IN N /\ c SUBSET n)")
      (X_CHOOSE_THEN (← q r"C:(A->bool)->bool")
        (CONJUNCTS_THEN2 (LABEL_TAC "Ccov")
         (CONJUNCTS_THEN2 (LABEL_TAC "Clf")
          (CONJUNCTS_THEN2 (LABEL_TAC "Cclosed") (LABEL_TAC "Cref"))))) THENL
     [MP_TAC (← SPEC (← q r"top:A topology") LF_COVERING_IMP_LF_CLOSED) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"BB:(A->bool)->bool") THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"BB:(A->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        DISCH_THEN (MP_TAC o SPEC (← q r"N:(A->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC []],
      ALL_TAC] THEN
    /- Step 3: Each c IN C meets finitely many elements of B -/
    SUBGOAL_THEN
      (← q r"!c:A->bool. c IN C ==> FINITE {b:A->bool | b IN B /\ ~(b INTER c = {})}")
      (LABEL_TAC "fin") THENL
     [X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"?n:A->bool. n IN N /\ (c:A->bool) SUBSET n")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"{b:A->bool | b IN B /\ ~(b INTER n = {})}") THEN
      CONJ_TAC THENL
       [UNDISCH_TAC (← q r"(n:A->bool) IN N") THEN EXPAND_TAC "N" THEN
        SIMP_TAC [IN_ELIM_THM],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM SET_TAC []],
      ALL_TAC] THEN
    /- Step 4: Expansion E(b) = X \ UNIONS{c IN C | c INTER b = {}} -/
    EXISTS_TAC (← q r"\b:A->bool.
      topspace top DIFF UNIONS {c:A->bool | c IN C /\ c INTER b = {}}") THEN
    BETA_TAC THEN REPEAT CONJ_TAC THENL
     [/- E(b) is open -- use EXPANSION_SET_OPEN -/
      X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"top:A topology") EXPANSION_SET_OPEN) THEN
      ASM_MESON_TAC [],
      /- b SUBSET E(b) -- use EXPANSION_SET_CONTAINS -/
      X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"top:A topology") EXPANSION_SET_CONTAINS) THEN
      ASM_MESON_TAC [],
      /- locally_finite_in top {E(b) | b IN B} -/
      REWRITE_TAC [locally_finite_in] THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
        REWRITE_TAC [SUBSET, IN_DIFF] THEN MESON_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      /- Use LF of C to get W meeting finitely many c's -/
      REMOVE_THEN "Clf" (MP_TAC o REWRITE_RULE [locally_finite_in]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"W:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"W:A->bool") THEN ASM_REWRITE_TAC [] THEN
      ABBREV_TAC (← q r"CW = {c:A->bool | c IN C /\ ~(c INTER W = {})}") THEN
      SUBGOAL_THEN (← q r"FINITE (CW:(A->bool)->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "CW" THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      /- {E(b) | b IN B, E(b) meets W} SUBSET
         IMAGE E (UNIONS {{b | b IN B, b meets c} | c IN CW}) -/
      MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC
        (← q r"IMAGE (\b:A->bool.
           topspace top DIFF UNIONS {c:A->bool | c IN C /\ c INTER b = {}})
           (UNIONS {{b:A->bool | b IN B /\ ~(b INTER c = {})} |
                    c IN CW})") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN
        ASM_SIMP_TAC [FINITE_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE,
                      FORALL_IN_GSPEC] THEN
        X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
        USE_THEN "fin" MATCH_MP_TAC THEN
        UNDISCH_TAC (← q r"(c:A->bool) IN CW") THEN
        EXPAND_TAC "CW" THEN SIMP_TAC [IN_ELIM_THM],
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
        REWRITE_TAC [IN_IMAGE] THEN
        EXISTS_TAC (← q r"b:A->bool") THEN BETA_TAC THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        /- Get y IN t INTER W -/
        SUBGOAL_THEN (← q r"?y:A. y IN t /\ y IN W") STRIP_ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(y:A) IN topspace top") ASSUME_TAC THENL
         [ASM_MESON_TAC [IN_DIFF], ALL_TAC] THEN
        SUBGOAL_THEN
          (← q r"~((y:A) IN UNIONS {c:A->bool | c IN C /\ c INTER b = {}})")
          ASSUME_TAC THENL
         [ASM_MESON_TAC [IN_DIFF], ALL_TAC] THEN
        /- y is in some c0 IN C since C covers -/
        SUBGOAL_THEN (← q r"?c0:A->bool. c0 IN C /\ y IN c0")
          STRIP_ASSUME_TAC THENL
         [UNDISCH_TAC (← q r"(y:A) IN topspace top") THEN
          ASM_REWRITE_TAC [← GSYM IN_UNIONS] THEN
          REWRITE_TAC [IN_UNIONS] THEN MESON_TAC [],
          ALL_TAC] THEN
        /- c0 INTER b != {} -/
        SUBGOAL_THEN (← q r"~(c0 INTER (b:A->bool) = {})") ASSUME_TAC THENL
         [DISCH_TAC THEN
          UNDISCH_TAC
            (← q r"~((y:A) IN UNIONS {c:A->bool | c IN C /\ c INTER b = {}})") THEN
          REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
          EXISTS_TAC (← q r"c0:A->bool") THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        /- c0 IN CW -/
        SUBGOAL_THEN (← q r"(c0:A->bool) IN CW") ASSUME_TAC THENL
         [EXPAND_TAC "CW" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
          ALL_TAC] THEN
        EXISTS_TAC (← q r"{b':A->bool | b' IN B /\ ~(b' INTER c0 = {})}") THEN
        CONJ_TAC THENL
         [EXISTS_TAC (← q r"c0:A->bool") THEN ASM_REWRITE_TAC [],
          REWRITE_TAC [IN_ELIM_THM] THEN
          ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC []]]])

  -- For regular spaces, paracompact iff every open cover has a
  -- locally finite closed refinement.
  let PARACOMPACT_SPACE_EQ_CLOSED_REFINEMENT ← prove
   r"!top:A topology.
        regular_space top
        ==> (paracompact_space top <=>
             !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                 ==> ?V. (!v. v IN V ==> closed_in top v) /\
                         UNIONS V = topspace top /\
                         (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                         locally_finite_in top V)"
   (GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [/- Forward: paracompact ==> LF closed refinement.
        Use LF_COVERING_IMP_LF_CLOSED: the hypothesis "every open cover
        has a LF refinement" follows from paracompactness (which gives
        a LF OPEN refinement, a fortiori a LF refinement). -/
      DISCH_TAC THEN
      MP_TAC (← SPEC (← q r"top:A topology") LF_COVERING_IMP_LF_CLOSED) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"BB:(A->bool)->bool") THEN STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"BB:(A->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
          MP_TAC (← SPEC (← q r"U:(A->bool)->bool") th))) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [],
      /- Backward: LF closed refinement ==> paracompact.
         Use LF_COVERING_IMP_LF_OPEN with our hypothesis providing
         the required "every open cover has LF closed refinement". -/
      DISCH_TAC THEN REWRITE_TAC [paracompact_space] THEN
      MP_TAC (← SPEC (← q r"top:A topology") LF_COVERING_IMP_LF_OPEN) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"BB:(A->bool)->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"BB:(A->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
          MP_TAC (← SPEC (← q r"U:(A->bool)->bool") th))) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC []])

  -- For regular spaces, paracompact iff every open cover has a
  -- locally finite refinement (not necessarily open or closed).
  let PARACOMPACT_SPACE_EQ_LOCALLY_FINITE_REFINEMENT ← prove
   r"!top:A topology.
        regular_space top
        ==> (paracompact_space top <=>
             !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
                 ==> ?V. UNIONS V = topspace top /\
                         (!v. v IN V ==> ?u. u IN U /\ v SUBSET u) /\
                         locally_finite_in top V)"
   (GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [/- Forward: paracompact gives LF open refinement, hence LF refinement -/
      DISCH_THEN (MP_TAC o GEN_REWRITE_RULE id [paracompact_space]) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
          MP_TAC (← SPEC (← q r"U:(A->bool)->bool") th))) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC [],
      /- Backward: LF refinement ==> paracompact.
         Chain: LF_COVERING_IMP_LF_CLOSED gives LF closed refinement,
         then LF_COVERING_IMP_LF_OPEN gives LF open refinement = paracompact. -/
      DISCH_TAC THEN REWRITE_TAC [paracompact_space] THEN
      /- First derive: every open cover has LF closed refinement -/
      SUBGOAL_THEN
        (← q r"!U:(A->bool)->bool.
           (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace (top:A topology)
           ==> ?W. UNIONS W = topspace top /\ locally_finite_in top W /\
                   (!w. w IN W ==> closed_in top w) /\
                   (!w. w IN W ==> ?u. u IN U /\ w SUBSET u)")
        ASSUME_TAC THENL
       [MP_TAC (← SPEC (← q r"top:A topology") LF_COVERING_IMP_LF_CLOSED) THEN
        ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN
          X_GEN_TAC (← q r"BB:(A->bool)->bool") THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"BB:(A->bool)->bool")) THEN
          ASM_REWRITE_TAC [] THEN MESON_TAC [],
          DISCH_THEN (fun th => tactic_of do
            pure (X_GEN_TAC (← q r"UU:(A->bool)->bool") THEN
              STRIP_TAC THEN MP_TAC (← SPEC (← q r"UU:(A->bool)->bool") th))) THEN
          ASM_REWRITE_TAC [] THEN MESON_TAC []],
        ALL_TAC] THEN
      /- Then derive: every open cover has LF open refinement -/
      MP_TAC (← SPEC (← q r"top:A topology") LF_COVERING_IMP_LF_OPEN) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN
        X_GEN_TAC (← q r"BB:(A->bool)->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"BB:(A->bool)->bool")) THEN
        ASM_REWRITE_TAC [] THEN MESON_TAC [],
        ALL_TAC] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
          MP_TAC (← SPEC (← q r"U:(A->bool)->bool") th))) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC []])

  return { PARACOMPACT_HAUSDORFF_EXPANSION_LEMMA, PARACOMPACT_SPACE_EQ_CLOSED_REFINEMENT,
           PARACOMPACT_SPACE_EQ_LOCALLY_FINITE_REFINEMENT }

/- ------------------------------------------------------------------------- -/
/- Basic definition of the small inductive dimension relation ind t <= n.    -/
/- We plan to prove most of the theorems in R^n so this is as good a         -/
/- definition as any other, but the present stuff works in any top space.    -/
/- (metric.ml 45085-45334)                                                   -/
/- ------------------------------------------------------------------------- -/

structure DIM1 where
  DIMENSION_LE_RULES : thm
  DIMENSION_LE_INDUCT : thm
  DIMENSION_LE_CASES : thm
  DIMENSION_LE_NEIGHBOURHOOD_BASE : thm
  DIMENSION_LE_BOUND : thm
  DIMENSION_LE_MONO : thm
  DIMENSION_LE_EQ_EMPTY : thm
  DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN : thm
  DIMENSION_LE_SUBTOPOLOGY : thm
  DIMENSION_LE_SUBTOPOLOGIES : thm
  DIMENSION_LE_EQ_SUBTOPOLOGY : thm
  HOMEOMORPHIC_SPACE_DIMENSION_LE : thm
  DIMENSION_LE_RETRACTION_MAP_IMAGE : thm
  DIMENSION_LE_DISCRETE_TOPOLOGY : thm
  ZERO_DIMENSIONAL_IMP_COMPLETELY_REGULAR_SPACE : thm
  ZERO_DIMENSIONAL_IMP_REGULAR_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupDIM1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BFrontier : Frontier)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BRetractOf : RetractOf)
    (BNbhdBase : NbhdBase) (BRealTop1 : RealTop1) (BCRegular1 : CRegular1)
    (BCRegular2 : CRegular2) :
    ExceptT String IO DIM1 := do
  -- @@SCOPE BEGIN
  let { new_inductive_definition, ASM_INT_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, INT_ARITH,
        INT_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, INT_REDUCE_CONV, parse_as_infix,
        .. } := D
  let { DIFF, EMPTY_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTER, INTER_ASSOC, INTER_COMM, INTER_EMPTY, INT_LE_TRANS, INT_OF_NUM_EXISTS,
        INT_OF_NUM_SUC, IN_DIFF, IN_GSPEC, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, UNWIND_THM2, .. } := D.core4
  let { EQ_IMP, FORALL_UNWIND_THM2, LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM,
        SWAP_EXISTS_THM, .. } := D.core5
  let { ENDS_IN_UNIT_REAL_INTERVAL, .. } := D.misc
  let { OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } :=
    BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_MONO, CLOSURE_OF_SUBTOPOLOGY, .. } := BClosure
  let { DISCRETE_TOPOLOGY_FRONTIER_OF, FRONTIER_OF_CLOSURES, FRONTIER_OF_EQ_EMPTY,
        FRONTIER_OF_SUBSET_SUBTOPOLOGY, FRONTIER_OF_SUBSET_TOPSPACE, .. } := BFrontier
  let { continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { open_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_IMP_OPEN_MAP, HOMEOMORPHIC_MAPS_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAPS_SUBTOPOLOGIES, HOMEOMORPHIC_MAP_FRONTIER_OF,
        HOMEOMORPHIC_MAP_OPENNESS_EQ, .. } := BHomeo2
  let { HOMEOMORPHIC_EMPTY_SPACE, HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { OPEN_NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { completely_regular_space, .. } := BCRegular1
  let { COMPLETELY_REGULAR_IMP_REGULAR_SPACE, .. } := BCRegular2
  -- @@SCOPE END

  parse_as_infix ("dimension_le", (12, "right"))

  let (DIMENSION_LE_RULES, DIMENSION_LE_INDUCT, DIMENSION_LE_CASES) ←
    new_inductive_definition
    r"!top n. -- &1 <= n /\
           (!v a. open_in top v /\ a IN v
                  ==> ?u. a IN u /\ u SUBSET v /\ open_in top u /\
                          subtopology top (top frontier_of u)
                          dimension_le (n - &1))
            ==> (top:A topology) dimension_le (n:int)"

  let DIMENSION_LE_NEIGHBOURHOOD_BASE ← prove
   r"!(top:A topology) n.
        top dimension_le n <=>
        -- &1 <= n /\
        neighbourhood_base_of
         (\u. open_in top u /\
              (subtopology top (top frontier_of u))
              dimension_le (n - &1)) top"
   (REPEAT GEN_TAC THEN SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_CASES] THEN MESON_TAC [])

  let DIMENSION_LE_BOUND ← prove
   r"!top:(A)topology n. top dimension_le n ==> -- &1 <= n"
   (MATCH_MP_TAC DIMENSION_LE_INDUCT THEN SIMP_TAC [])

  let DIMENSION_LE_MONO ← prove
   r"!top:(A)topology m n. top dimension_le m /\ m <= n ==> top dimension_le n"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MATCH_MP_TAC DIMENSION_LE_INDUCT THEN
    MAP_EVERY X_GEN_TAC [← q r"top:(A)topology", ← q r"m:int"] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"n:int") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC id [DIMENSION_LE_CASES] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [INT_LE_TRANS], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"a:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:A->bool", ← q r"a:A"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_INT_ARITH_TAC)

  let DIMENSION_LE_EQ_EMPTY ← prove
   r"!top:(A)topology. top dimension_le (-- &1) <=> topspace top = {}"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [DIMENSION_LE_CASES] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    SUBGOAL_THEN (← q r"!top:A topology. ~(top dimension_le --(&2))")
     (fun th => REWRITE_TAC [th])
    THENL
     [GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP DIMENSION_LE_BOUND) THEN
      INT_ARITH_TAC,
      EQ_TAC THENL
       [DISCH_THEN (MP_TAC o SPEC (← q r"topspace top:A->bool")) THEN
        REWRITE_TAC [OPEN_IN_TOPSPACE] THEN SET_TAC [],
        REPEAT STRIP_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
        ASM SET_TAC []]])

  let DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN ← prove
   r"!top:A topology.
        top dimension_le &0 <=>
        neighbourhood_base_of (\u. closed_in top u /\ open_in top u) top"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_NEIGHBOURHOOD_BASE] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    REWRITE_TAC [DIMENSION_LE_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [FRONTIER_OF_SUBSET_TOPSPACE, ← SET_RULE
     (← q r"s SUBSET u ==> u INTER s = s")] THEN
    MESON_TAC [FRONTIER_OF_EQ_EMPTY, OPEN_IN_SUBSET])

  let DIMENSION_LE_SUBTOPOLOGY ← prove
   r"!top n s:A->bool.
        top dimension_le n ==> (subtopology top s) dimension_le n"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN MATCH_MP_TAC DIMENSION_LE_INDUCT THEN
    MAP_EVERY X_GEN_TAC [← q r"top:A topology", ← q r"n:int"] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"s:A->bool") THEN GEN_REWRITE_TAC id [DIMENSION_LE_CASES] THEN
    ASM_REWRITE_TAC [] THEN MAP_EVERY X_GEN_TAC [← q r"u':A->bool", ← q r"a:A"] THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [OPEN_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:A->bool", ← q r"a:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"s INTER v:A->bool") THEN
    ASM_REWRITE_TAC [IN_INTER] THEN REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN ASM_MESON_TAC [INTER_COMM],
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"subtopology top s frontier_of (s INTER v):A->bool")) THEN
      REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_THM_TAC THEN AP_TERM_TAC THEN
      AP_TERM_TAC THEN MATCH_MP_TAC (← SET_RULE
       (← q r"s SUBSET u /\ s SUBSET t ==> t INTER s = u INTER s")) THEN
      REWRITE_TAC [FRONTIER_OF_SUBSET_SUBTOPOLOGY] THEN
      REWRITE_TAC [FRONTIER_OF_CLOSURES, CLOSURE_OF_SUBTOPOLOGY] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, INTER_ASSOC] THEN
      MATCH_MP_TAC (← SET_RULE
       (← q r"t SUBSET u /\ v SUBSET w
        ==> s INTER t INTER s INTER v SUBSET u INTER w")) THEN
      CONJ_TAC THEN MATCH_MP_TAC CLOSURE_OF_MONO THEN SET_TAC []])

  let DIMENSION_LE_SUBTOPOLOGIES ← prove
   r"!top n s t:A->bool.
        s SUBSET t /\
        subtopology top t dimension_le n
        ==> (subtopology top s) dimension_le n"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o
      ISPEC (← q r"s:A->bool") o MATCH_MP DIMENSION_LE_SUBTOPOLOGY) THEN
    REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")])

  let DIMENSION_LE_EQ_SUBTOPOLOGY ← prove
   r"!top s:A->bool n.
        (subtopology top s) dimension_le n <=>
        -- &1 <= n /\
        !v a. open_in top v /\ a IN v /\ a IN s
              ==> ?u. a IN u /\ u SUBSET v /\ open_in top u /\
                      subtopology top
                       ((subtopology top s frontier_of (s INTER u)))
                      dimension_le (n - &1)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [DIMENSION_LE_CASES] THEN
    REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← MESON [] (← q
     r"(!v a t. (P t /\ Q v t) /\ R a v t ==> S a v t) <=>
      (!t a v. Q v t ==> P t /\ R a v t ==> S a v t)")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2] THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"v:A->bool") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [IN_INTER] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")) THEN
    STRIP_TAC THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT
      (← q r"p /\ q /\ (r /\ s) /\ t <=> s /\ p /\ q /\ r /\ t")] THEN
    ASM_REWRITE_TAC [UNWIND_THM2, IN_INTER] THEN
    EQ_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"u INTER v:A->bool") THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER] THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"u SUBSET v ==> u INTER v = u"),
                  ← SET_RULE (← q r"u INTER s SUBSET v INTER s
                            ==> s INTER u INTER v = s INTER u")] THEN
    POP_ASSUM_LIST (fun ths => (MP_TAC o end_itlist CONJ) ths.reverse) THEN
    ASM_SIMP_TAC [FRONTIER_OF_SUBSET_SUBTOPOLOGY,
                  ← SET_RULE (← q r"v SUBSET u ==> u INTER v = v")] THEN
    STRIP_TAC THEN ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_REWRITE_TAC [])

  let HOMEOMORPHIC_SPACE_DIMENSION_LE ← do
    let lemma ← prove
     r"!n (top:A topology) (top':B topology).
          top homeomorphic_space top' /\ top dimension_le (&n - &1)
          ==> top' dimension_le (&n - &1)"
     (INDUCT_TAC THENL
       [CONV_TAC INT_REDUCE_CONV THEN REWRITE_TAC [DIMENSION_LE_EQ_EMPTY] THEN
        MESON_TAC [HOMEOMORPHIC_EMPTY_SPACE],
        REWRITE_TAC [← GSYM INT_OF_NUM_SUC, ← INT_ARITH (← q r"(x + y) - y:int = x")]] THEN
      MAP_EVERY X_GEN_TAC [← q r"top:A topology", ← q r"top':B topology"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ONCE_REWRITE_TAC [DIMENSION_LE_CASES] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic_space]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"v:B->bool", ← q r"b:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"IMAGE (g:B->A) v", ← q r"(g:B->A) b"]) THEN
      ANTS_TAC THENL
       [ASM_MESON_TAC [HOMEOMORPHIC_MAPS_MAP, HOMEOMORPHIC_IMP_OPEN_MAP,
                       open_map, FUN_IN_IMAGE],
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)] THEN
      EXISTS_TAC (← q r"IMAGE (f:A->B) u") THEN REPEAT CONJ_TAC THENL
       [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
        ASM SET_TAC [],
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
        ASM SET_TAC [],
        ASM_MESON_TAC [HOMEOMORPHIC_MAPS_MAP, HOMEOMORPHIC_MAP_OPENNESS_EQ],
        FIRST_X_ASSUM MATCH_MP_TAC THEN
        EXISTS_TAC (← q r"subtopology top (top frontier_of u:A->bool)") THEN
        ASM_REWRITE_TAC [homeomorphic_space] THEN
        MAP_EVERY EXISTS_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN
        MATCH_MP_TAC HOMEOMORPHIC_MAPS_SUBTOPOLOGIES THEN
        ASM_SIMP_TAC [FRONTIER_OF_SUBSET_TOPSPACE, ← SET_RULE
         (← q r"s SUBSET t ==> t INTER s = s")] THEN
        CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_MAP_FRONTIER_OF THEN
        ASM_MESON_TAC [OPEN_IN_SUBSET, HOMEOMORPHIC_MAPS_MAP]])
    prove
     r"!(top:A topology) (top':B topology) n.
          top homeomorphic_space top'
          ==> (top dimension_le n <=> top' dimension_le n)"
     (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"-- &1:int <= n") THENL
       [ALL_TAC, ASM_MESON_TAC [DIMENSION_LE_BOUND]] THEN
      SUBST1_TAC (← INT_ARITH (← q r"n:int = (n + &1) - &1")) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP
       (← INT_ARITH (← q r"--x:int <= y ==> &0 <= y + x"))) THEN
      REWRITE_TAC [← GSYM INT_OF_NUM_EXISTS, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN SUBST1_TAC THEN
      EQ_TAC THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] lemma) THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SPACE_SYM])

  let DIMENSION_LE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' n (r:A->B).
        retraction_map(top,top') r /\ top dimension_le n
        ==> top' dimension_le n"
   (GEN_REWRITE_TAC id [← MESON [] (← q r"(!x y z. P x y z) <=> (!z x y. P x y z)")] THEN
    GEN_TAC THEN MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [DIMENSION_LE_SUBTOPOLOGY, HOMEOMORPHIC_SPACE_DIMENSION_LE])

  let DIMENSION_LE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. (discrete_topology u) dimension_le &0"
   (GEN_TAC THEN ONCE_REWRITE_TAC [DIMENSION_LE_CASES] THEN
    CONV_TAC INT_REDUCE_CONV THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, DISCRETE_TOPOLOGY_FRONTIER_OF] THEN
    REWRITE_TAC [DIMENSION_LE_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY, INTER_EMPTY] THEN
    SET_TAC [])

  let ZERO_DIMENSIONAL_IMP_COMPLETELY_REGULAR_SPACE ← prove
   r"!top:A topology. top dimension_le &0 ==> completely_regular_space top"
   (GEN_TAC THEN REWRITE_TAC [DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN] THEN
    SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF] THEN DISCH_TAC THEN
    REWRITE_TAC [completely_regular_space, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"a:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"topspace top DIFF c:A->bool", ← q r"a:A"]) THEN
    ASM_SIMP_TAC [IN_DIFF, OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(\x. if x IN u then &0 else &1):A->real") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [ENDS_IN_UNIT_REAL_INTERVAL]] THEN
    REWRITE_TAC [continuous_map, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
    X_GEN_TAC (← q r"r:real->bool") THEN DISCH_TAC THEN REWRITE_TAC [← TAUT (← q
      r"(if p then a else b) IN r <=> p /\ a IN r \/ ~p /\ b IN r")] THEN
    MAP_EVERY ASM_CASES_TAC [← q r"(&0:real) IN r", ← q r"(&1:real) IN r"] THEN
    ASM_REWRITE_TAC [EMPTY_GSPEC, OPEN_IN_EMPTY, OPEN_IN_TOPSPACE,
                     IN_GSPEC, ← TAUT (← q r"p \/ ~p")] THEN
    ASM_REWRITE_TAC [← GSYM DIFF, ← GSYM INTER] THEN
    ASM_SIMP_TAC [OPEN_IN_TOPSPACE, OPEN_IN_INTER, OPEN_IN_DIFF])

  let ZERO_DIMENSIONAL_IMP_REGULAR_SPACE ← prove
   r"!top:A topology. top dimension_le &0 ==> regular_space top"
   (MESON_TAC [COMPLETELY_REGULAR_IMP_REGULAR_SPACE,
               ZERO_DIMENSIONAL_IMP_COMPLETELY_REGULAR_SPACE])
  return { DIMENSION_LE_RULES, DIMENSION_LE_INDUCT, DIMENSION_LE_CASES,
           DIMENSION_LE_NEIGHBOURHOOD_BASE, DIMENSION_LE_BOUND, DIMENSION_LE_MONO,
           DIMENSION_LE_EQ_EMPTY, DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN,
           DIMENSION_LE_SUBTOPOLOGY, DIMENSION_LE_SUBTOPOLOGIES, DIMENSION_LE_EQ_SUBTOPOLOGY,
           HOMEOMORPHIC_SPACE_DIMENSION_LE, DIMENSION_LE_RETRACTION_MAP_IMAGE,
           DIMENSION_LE_DISCRETE_TOPOLOGY, ZERO_DIMENSIONAL_IMP_COMPLETELY_REGULAR_SPACE,
           ZERO_DIMENSIONAL_IMP_REGULAR_SPACE }

/- ------------------------------------------------------------------------- -/
/- The Cantor space {0,1}^N and its embedding in the reals as the Cantor set -/
/- via the ternary Cantor map: a |-> sum_{k=0}^inf 2*a(k) / 3^{k+1}          -/
/- (metric.ml 45335-45510)                                                   -/
/- ------------------------------------------------------------------------- -/

structure CAN1 where
  cantor_space : thm
  cantor_term : thm
  cantor_map : thm
  cantor_set : thm
  TOPSPACE_CANTOR_SPACE : thm
  COMPACT_SPACE_CANTOR_SPACE : thm
  HAUSDORFF_SPACE_CANTOR_SPACE : thm
  METRIZABLE_SPACE_CANTOR_SPACE : thm
  ZERO_DIMENSIONAL_CANTOR_SPACE : thm
  NONEMPTY_TOPSPACE_CANTOR_SPACE : thm
  PERFECT_CANTOR_SPACE : thm
  PERFECT_CANTOR_SPACE_EQ : thm
  CANTOR_TERM_POS : thm
  CANTOR_TERM_BOUND : thm
  CANTOR_PARTIAL_SUM_MONO : thm
  SUM_TWOTHIRDS : thm
  TWOTHIRDS_SUMS : thm
  CANTOR_MAP_SUMMABLE : thm
  CANTOR_MAP_SUMS : thm
  CANTOR_MAP_LE_ONE : thm
  deriving Inhabited

@[nospecialize]
def setupCAN1 [HolBase] (D : MetricDeps) (BDiscrete : Discrete) (BDerived : Derived)
    (BProduct1 : Product1) (BProduct2 : Product2) (BProduct3 : Product3)
    (BCompact2 : Compact2) (BCompact4 : Compact4) (BHausdorff1 : Hausdorff1)
    (BHausdorff2 : Hausdorff2) (BMetrizable : Metrizable) (BNbhdBase : NbhdBase)
    (BRealSeries : RealSeries) (BMSPT : MSPT) (BDIM1 : DIM1) :
    ExceptT String IO CAN1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_ARITH_TAC, INDUCT_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, REAL_FIELD, SET_TAC, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_ASSOC, EXTENSIONAL_UNIV, FINITE_BOOL, FINITE_NUMSEG, FINITE_SUBSET_NUMSEG,
        .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_NUMSEG, IN_UNIV, LE_0, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_POW_DIV,
        REAL_POW_EQ_0, REAL_POW_LE, REAL_POW_LT, REAL_POW_MONO_INV, REAL_POW_ONE, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUM_CLAUSES_NUMSEG, SUM_SING_NUMSEG, SUM_SUBSET_SIMPLE,
        UNIV_NOT_EMPTY, cartesian_product, o_DEF, real_pow, .. } := D.core4
  let { IN_FROM, .. } := D.misc
  let { COUNTABLE_SUBSET_NUM, .. } := D.lib
  let { CLOSED_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { DERIVED_SET_OF_SUBSET_TOPSPACE, IN_DERIVED_SET_OF, .. } := BDerived
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { OPEN_IN_CARTESIAN_PRODUCT_GEN, .. } := BProduct2
  let { CLOSED_IN_CARTESIAN_PRODUCT, .. } := BProduct3
  let { COMPACT_SPACE_DISCRETE_TOPOLOGY, .. } := BCompact2
  let { COMPACT_SPACE_PRODUCT_TOPOLOGY, .. } := BCompact4
  let { HAUSDORFF_SPACE_DISCRETE_TOPOLOGY, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_PRODUCT_TOPOLOGY, .. } := BHausdorff2
  let { METRIZABLE_SPACE_DISCRETE_TOPOLOGY, .. } := BMetrizable
  let { OPEN_NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { REALLIM_SEQUENTIALLY, REAL_SERIES_FROM, REAL_SERIES_LE, REAL_SUMMABLE_COMPARISON,
        REAL_SUMS_INFSUM, REAL_SUMS_SUMMABLE, .. } := BRealSeries
  let { METRIZABLE_SPACE_PRODUCT_TOPOLOGY, .. } := BMSPT
  let { DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN, .. } := BDIM1
  -- @@SCOPE END

  let cantor_space ← new_definition
   r"cantor_space = product_topology (:num) (\n:num. discrete_topology (:bool))"

  let cantor_term ← new_definition
   r"cantor_term (a:num->bool) k = (if a k then &2 else &0) / &3 pow (k + 1)"

  let cantor_map ← new_definition
   r"cantor_map (a:num->bool) = real_infsum (from 0) (cantor_term a)"

  let cantor_set ← new_definition
   r"cantor_set = IMAGE cantor_map (:num->bool)"

  let TOPSPACE_CANTOR_SPACE ← prove
   r"topspace cantor_space = (:num->bool)"
   (REWRITE_TAC [cantor_space, TOPSPACE_PRODUCT_TOPOLOGY,
                 TOPSPACE_DISCRETE_TOPOLOGY, o_DEF] THEN
    REWRITE_TAC [cartesian_product, IN_UNIV, EXTENSIONAL_UNIV] THEN
    SET_TAC [])

  let COMPACT_SPACE_CANTOR_SPACE ← prove
   r"compact_space cantor_space"
   (SIMP_TAC [cantor_space, COMPACT_SPACE_PRODUCT_TOPOLOGY,
              COMPACT_SPACE_DISCRETE_TOPOLOGY, FINITE_BOOL])

  let HAUSDORFF_SPACE_CANTOR_SPACE ← prove
   r"hausdorff_space cantor_space"
   (SIMP_TAC [cantor_space, HAUSDORFF_SPACE_PRODUCT_TOPOLOGY,
              HAUSDORFF_SPACE_DISCRETE_TOPOLOGY])

  let METRIZABLE_SPACE_CANTOR_SPACE ← prove
   r"metrizable_space cantor_space"
   (SIMP_TAC [cantor_space, METRIZABLE_SPACE_PRODUCT_TOPOLOGY,
              COUNTABLE_SUBSET_NUM, METRIZABLE_SPACE_DISCRETE_TOPOLOGY])

  let ZERO_DIMENSIONAL_CANTOR_SPACE ← prove
   r"cantor_space dimension_le &0"
   (REWRITE_TAC [DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN] THEN
    SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF,
      ← MESON [] (← q r"!(top:A topology) (s:A->bool).
        closed_in top s /\ open_in top s ==> open_in top s")] THEN
    REWRITE_TAC [cantor_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:(num->bool)->bool", ← q r"x:num->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:num->(bool->bool)") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"cartesian_product (:num) (u:num->bool->bool)") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [REWRITE_TAC [CLOSED_IN_CARTESIAN_PRODUCT] THEN DISJ2_TAC THEN GEN_TAC THEN
      REWRITE_TAC [IN_UNIV, CLOSED_IN_DISCRETE_TOPOLOGY] THEN SET_TAC [],
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN DISJ2_TAC THEN
      ASM_REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY]])

  let NONEMPTY_TOPSPACE_CANTOR_SPACE ← prove
   r"~(topspace cantor_space = {})"
   (REWRITE_TAC [TOPSPACE_CANTOR_SPACE, UNIV_NOT_EMPTY])

  -- The Cantor space has no isolated points (is "perfect")

  let PERFECT_CANTOR_SPACE ← prove
   r"!x:num->bool. x IN topspace cantor_space
                 ==> x IN cantor_space derived_set_of (topspace cantor_space)"
   (REWRITE_TAC [TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN X_GEN_TAC (← q r"x:num->bool") THEN
    REWRITE_TAC [IN_DERIVED_SET_OF, TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN
    X_GEN_TAC (← q r"t:(num->bool)->bool") THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [cantor_space]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->bool") o
      GEN_REWRITE_RULE id [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:num->(bool->bool)") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"N:num") o
      GEN_REWRITE_RULE id [FINITE_SUBSET_NUMSEG]) THEN
    SUBGOAL_THEN (← q r"(u:num->bool->bool) (SUC N) = (:bool)") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [SUBSET, IN_ELIM_THM, IN_UNIV,
        IN_NUMSEG, TOPSPACE_DISCRETE_TOPOLOGY]) THEN
      MESON_TAC [← ARITH_RULE (← q r"~(SUC N <= N)")], ALL_TAC] THEN
    EXISTS_TAC (← q r"\n:num. if n = SUC N then ~(x n) else (x:num->bool) n") THEN
    CONJ_TAC THENL
     [DISCH_THEN (MP_TAC o (fun (th : thm) =>
        (do AP_THM th (← q r"SUC N") : ExceptT String IO thm))) THEN
      REWRITE_TAC [] THEN MESON_TAC [],
      FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      UNDISCH_TAC (← q r"x IN cartesian_product (:num) (u:num->bool->bool)") THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, IN_UNIV, EXTENSIONAL_UNIV] THEN
      DISCH_TAC THEN GEN_TAC THEN COND_CASES_TAC THEN ASM_SIMP_TAC [IN_UNIV]])

  let PERFECT_CANTOR_SPACE_EQ ← prove
   r"cantor_space derived_set_of (topspace cantor_space) =
   topspace cantor_space"
   (MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE, SUBSET, PERFECT_CANTOR_SPACE])

  -- Each term is non-negative

  let CANTOR_TERM_POS ← prove
   r"!a:num->bool k. &0 <= cantor_term a k"
   (REWRITE_TAC [cantor_term] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC REAL_LE_DIV THEN CONJ_TAC THENL
     [COND_CASES_TAC, MATCH_MP_TAC REAL_POW_LE] THEN REAL_ARITH_TAC)

  -- Each term bounded by corresponding geometric term

  let CANTOR_TERM_BOUND ← prove
   r"!a:num->bool k. cantor_term a k <= &2 / &3 pow (k + 1)"
   (REWRITE_TAC [cantor_term] THEN REPEAT GEN_TAC THEN
    SIMP_TAC [REAL_LE_DIV2_EQ, REAL_POW_LT, ← REAL_ARITH (← q r"&0 < &3")] THEN
    COND_CASES_TAC THEN REAL_ARITH_TAC)

  -- Monotonicity of partial sums: more terms of non-negative series

  let CANTOR_PARTIAL_SUM_MONO ← prove
   r"!a:num->bool m n. m <= n
     ==> sum(0..m) (cantor_term a) <= sum(0..n) (cantor_term a)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_SUBSET_SIMPLE THEN
    REWRITE_TAC [FINITE_NUMSEG, IN_DIFF, CANTOR_TERM_POS,
                 SUBSET, IN_NUMSEG] THEN ASM_ARITH_TAC)

  -- Partial sum formula for the geometric series sum_{k=0}^n 2/3^{k+1}

  let SUM_TWOTHIRDS ← prove
   r"!n. sum(0..n) (\k. &2 / &3 pow (k + 1)) = &1 - (&1 / &3) pow (n + 1)"
   (INDUCT_TAC THENL
     [REWRITE_TAC [SUM_SING_NUMSEG] THEN CONV_TAC NUM_REDUCE_CONV THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      REWRITE_TAC [SUM_CLAUSES_NUMSEG, LE_0] THEN
      ASM_REWRITE_TAC [ADD1, ← GSYM ADD_ASSOC] THEN CONV_TAC NUM_REDUCE_CONV THEN
      REWRITE_TAC [← ARITH_RULE (← q r"n + 2 = SUC(n + 1)"),
                   real_pow, REAL_POW_DIV, REAL_POW_ONE] THEN
      SUBGOAL_THEN (← q r"~(&3 pow (n + 1) = &0)") MP_TAC THENL
       [REWRITE_TAC [REAL_POW_EQ_0] THEN REAL_ARITH_TAC,
        CONV_TAC (fun t => REAL_FIELD t)]])

  -- The geometric dominating series sums to 1

  let TWOTHIRDS_SUMS ← prove
   r"((\k. &2 / &3 pow (k + 1)) real_sums &1) (from 0)"
   (REWRITE_TAC [REAL_SERIES_FROM, SUM_TWOTHIRDS, REALLIM_SEQUENTIALLY] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"&1 / &3", ← q r"e:real"] REAL_ARCH_POW_INV) THEN ANTS_TAC THENL
    [ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N:num") THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < x /\ x < e ==> abs((&1 - x) - &1) < e")) THEN
    CONJ_TAC THENL
    [MATCH_MP_TAC REAL_POW_LT THEN CONV_TAC REAL_RAT_REDUCE_CONV,
     MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"(&1 / &3) pow N") THEN
     ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_POW_MONO_INV THEN
     CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC])

  -- Cantor terms are summable by comparison with the geometric series

  let CANTOR_MAP_SUMMABLE ← prove
   r"!a:num->bool. real_summable (from 0) (cantor_term a)"
   (GEN_TAC THEN MATCH_MP_TAC REAL_SUMMABLE_COMPARISON THEN
    EXISTS_TAC (← q r"\k. &2 / &3 pow (k + 1)") THEN CONJ_TAC THENL
    [MESON_TAC [TWOTHIRDS_SUMS, REAL_SUMS_SUMMABLE],
     EXISTS_TAC (← q r"0") THEN REPEAT STRIP_TAC THEN
     MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= x /\ x <= y ==> abs x <= y")) THEN
     REWRITE_TAC [CANTOR_TERM_POS, CANTOR_TERM_BOUND]])

  -- The series converges to cantor_map

  let CANTOR_MAP_SUMS ← prove
   r"!a:num->bool. (cantor_term a real_sums cantor_map a) (from 0)"
   (GEN_TAC THEN REWRITE_TAC [cantor_map, REAL_SUMS_INFSUM, CANTOR_MAP_SUMMABLE])

  -- Upper bound: each term <= 2/3^{k+1}, and the geometric series sums to 1

  let CANTOR_MAP_LE_ONE ← prove
   r"!a:num->bool. cantor_map a <= &1"
   (GEN_TAC THEN MATCH_MP_TAC REAL_SERIES_LE THEN
    MAP_EVERY EXISTS_TAC
    [← q r"cantor_term (a:num->bool)", ← q r"\k. &2 / &3 pow (k + 1)", ← q r"from 0"] THEN
    REWRITE_TAC [CANTOR_MAP_SUMS, TWOTHIRDS_SUMS, IN_FROM, CANTOR_TERM_BOUND])

  return { cantor_space, cantor_term, cantor_map, cantor_set, TOPSPACE_CANTOR_SPACE,
           COMPACT_SPACE_CANTOR_SPACE, HAUSDORFF_SPACE_CANTOR_SPACE,
           METRIZABLE_SPACE_CANTOR_SPACE, ZERO_DIMENSIONAL_CANTOR_SPACE,
           NONEMPTY_TOPSPACE_CANTOR_SPACE, PERFECT_CANTOR_SPACE, PERFECT_CANTOR_SPACE_EQ,
           CANTOR_TERM_POS, CANTOR_TERM_BOUND, CANTOR_PARTIAL_SUM_MONO, SUM_TWOTHIRDS,
           TWOTHIRDS_SUMS, CANTOR_MAP_SUMMABLE, CANTOR_MAP_SUMS, CANTOR_MAP_LE_ONE }

/- ------------------------------------------------------------------------- -/
/- Cantor map: bounds, continuity, injectivity.  (metric.ml 45511-45699)     -/
/- ------------------------------------------------------------------------- -/

structure CAN2 where
  CANTOR_MAP_GE_PARTIAL_SUM : thm
  CANTOR_MAP_PARTIAL_SUM_BOUND : thm
  CANTOR_MAP_POS : thm
  CANTOR_MAP_RANGE : thm
  CANTOR_TERM_CONTINUOUS : thm
  CANTOR_MAP_CONTINUOUS : thm
  CANTOR_PARTIAL_SUM_DIFF_AT_K : thm
  CANTOR_MAP_STRICT_LT : thm
  CANTOR_MAP_INJECTIVE : thm
  CANTOR_MAP_EMBEDDING : thm
  CANTOR_MAP_CLOSED_IMAGE : thm
  CANTOR_MAP_IMAGE_SUBSET_INTERVAL : thm
  CANTOR_MAP_CLOSED_IN_INTERVAL : thm
  CANTOR_SET_SUBSET_INTERVAL : thm
  CLOSED_IN_CANTOR_SET : thm
  CLOSED_IN_CANTOR_SET_INTERVAL : thm
  CANTOR_SPACE_HOMEOMORPHIC_CANTOR_SET : thm
  deriving Inhabited

@[nospecialize]
def setupCAN2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap2 : ContMap2)
    (BProduct2 : Product2) (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BHausdorff1 : Hausdorff1)
    (BHausdorff2 : Hausdorff2) (BSequential : Sequential) (BRealTop1 : RealTop1)
    (BRealTop2 : RealTop2) (BMetricCont : MetricCont) (BRealCont : RealCont)
    (BRealSeries : RealSeries) (BCAN1 : CAN1) :
    ExceptT String IO CAN2 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { FINITE_NUMSEG, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IN_NUMSEG, IN_UNIV, LE_0, LE_REFL, NOT_FORALL_THM, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_LE_TRANS, REAL_LT_DIV2_EQ, REAL_POW_DIV, REAL_POW_LE,
        REAL_POW_LT, REAL_POW_MONO_INV, REAL_POW_ONE, .. } := D.core3
  let { SUBSET, SUBSET_UNIV, SUM_COMBINE_R, SUM_DELTA, SUM_EQ_NUMSEG, SUM_LE_NUMSEG,
        SUM_SING_NUMSEG, SUM_SUB_NUMSEG, num_WOP, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, NOT_CLAUSES, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CLOSED_IN_SUBSET_TOPSPACE, .. } := BSubtopology
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY, .. } := BContMap2
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE, .. } := BHomeoSpace
  let { embedding_map, .. } := BEmbedding
  let { compact_space, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { CONTINUOUS_IMP_EMBEDDING_MAP, .. } := BHausdorff2
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC,
        .. } := BRealTop2
  let { CONTINUOUS_MAP_UNIFORM_LIMIT_ALT, .. } := BMetricCont
  let { CONTINUOUS_MAP_SUM, .. } := BRealCont
  let { REALLIM_LBOUND, REALLIM_UBOUND, REAL_SERIES_FROM, .. } := BRealSeries
  let { CANTOR_MAP_LE_ONE, CANTOR_MAP_SUMS, CANTOR_PARTIAL_SUM_MONO, CANTOR_TERM_BOUND,
        CANTOR_TERM_POS, COMPACT_SPACE_CANTOR_SPACE, SUM_TWOTHIRDS, TOPSPACE_CANTOR_SPACE,
        cantor_set, cantor_space, cantor_term, .. } := BCAN1
  -- @@SCOPE END

  -- Partial sums bounded by the limit (monotone convergence)

  let CANTOR_MAP_GE_PARTIAL_SUM ← prove
   r"!a:num->bool n. sum(0..n) (cantor_term a) <= cantor_map a"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_LBOUND) THEN
    EXISTS_TAC (← q r"\m. sum(0..m) (cantor_term (a:num->bool))") THEN CONJ_TAC THENL
     [MP_TAC (← SPEC (← q r"a:num->bool") CANTOR_MAP_SUMS) THEN
      REWRITE_TAC [REAL_SERIES_FROM],
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
      EXISTS_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CANTOR_PARTIAL_SUM_MONO THEN
      ASM_REWRITE_TAC []])

  -- Tail bound: cantor_map - partial_sum <= geometric tail

  let CANTOR_MAP_PARTIAL_SUM_BOUND ← prove
   r"!a:num->bool n. cantor_map a - sum(0..n) (cantor_term a) <=
                   (&1 / &3) pow (n + 1)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← REAL_ARITH (← q r"x <= y + z ==> x - y <= z")) THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_UBOUND) THEN
    EXISTS_TAC (← q r"\m. sum(0..m) (cantor_term (a:num->bool))") THEN CONJ_TAC THENL
     [MP_TAC (← SPEC (← q r"a:num->bool") CANTOR_MAP_SUMS) THEN
      REWRITE_TAC [REAL_SERIES_FROM], ALL_TAC] THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY] THEN
    EXISTS_TAC (← q r"n:num") THEN X_GEN_TAC (← q r"m:num") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"cantor_term (a:num->bool)", ← q r"0", ← q r"n:num", ← q r"m:num"]
      SUM_COMBINE_R) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, DISCH_THEN (SUBST1_TAC o SYM)] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"t <= b ==> p + t <= p + b")) THEN
    MATCH_MP_TAC REAL_LE_TRANS THEN
    EXISTS_TAC (← q r"sum(n+1..m) (\k. &2 / &3 pow (k + 1))") THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUM_LE_NUMSEG THEN SIMP_TAC [CANTOR_TERM_BOUND],
      MP_TAC (← ISPECL [← q r"\k. &2 / &3 pow (k + 1)", ← q r"0", ← q r"n:num", ← q r"m:num"]
        SUM_COMBINE_R) THEN
      ANTS_TAC THENL [ASM_ARITH_TAC, REWRITE_TAC [SUM_TWOTHIRDS]] THEN
      MP_TAC (← SPEC (← q r"m + 1") (← MATCH_MP REAL_POW_LE
        (← REAL_ARITH (← q r"&0 <= &1 / &3")))) THEN REAL_ARITH_TAC])

  -- Non-negativity: follows from partial sums being non-negative

  let CANTOR_MAP_POS ← prove
   r"!a:num->bool. &0 <= cantor_map a"
   (GEN_TAC THEN
    MP_TAC (← SPECL [← q r"a:num->bool", ← q r"0"] CANTOR_MAP_GE_PARTIAL_SUM) THEN
    MP_TAC (← SPECL [← q r"a:num->bool", ← q r"0"] CANTOR_TERM_POS) THEN
    REWRITE_TAC [SUM_SING_NUMSEG] THEN REAL_ARITH_TAC)

  let CANTOR_MAP_RANGE ← prove
   r"!a:num->bool. cantor_map a IN real_interval[&0,&1]"
   (REWRITE_TAC [IN_REAL_INTERVAL, CANTOR_MAP_POS, CANTOR_MAP_LE_ONE])

  -- Term continuity: each cantor_term a k is continuous in a

  let CANTOR_TERM_CONTINUOUS ← prove
   r"!k. continuous_map (cantor_space, euclideanreal)
        (\a:num->bool. cantor_term a k)"
   (GEN_TAC THEN REWRITE_TAC [cantor_term] THEN SUBGOAL_THEN
      (← q r"(\a:num->bool. (if a k then &2 else &0) / &3 pow (k + 1)) =
       (\b:bool. (if b then &2 else &0) / &3 pow (k + 1)) o (\a:num->bool. a k)")
      SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_THM], ALL_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"discrete_topology (:bool)") THEN CONJ_TAC THENL
     [REWRITE_TAC [cantor_space] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_PRODUCT_PROJECTION THEN REWRITE_TAC [IN_UNIV],
      REWRITE_TAC [CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY,
                   TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV]])

  -- Cantor map continuity: uniform limit of continuous partial sums
  let CANTOR_MAP_CONTINUOUS ← prove
   r"continuous_map (cantor_space, euclideanreal) cantor_map"
   (MATCH_MP_TAC (← REWRITE_RULE [MTOPOLOGY_REAL_EUCLIDEAN_METRIC]
      (← ISPECL [← q r"sequentially", ← q r"cantor_space", ← q r"real_euclidean_metric",
                 ← q r"\n (a:num->bool). sum(0..n) (cantor_term a)", ← q r"cantor_map"]
        CONTINUOUS_MAP_UNIFORM_LIMIT_ALT)) THEN
    CONV_TAC (DEPTH_CONV BETA_CONV) THEN
    REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, TOPSPACE_CANTOR_SPACE, SUBSET_UNIV,
                 REAL_EUCLIDEAN_METRIC, MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 EVENTUALLY_SEQUENTIALLY, IN_UNIV] THEN
    CONJ_TAC THENL
     [EXISTS_TAC (← q r"0") THEN REPEAT STRIP_TAC THEN REWRITE_TAC [cantor_term] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_SUM THEN
      REWRITE_TAC [FINITE_NUMSEG, IN_NUMSEG] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM cantor_term, CANTOR_TERM_CONTINUOUS],
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← SPECL [← q r"&1 / &3", ← q r"e:real"] REAL_ARCH_POW_INV) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV, ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N:num") THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:num->bool") THEN
      MP_TAC (← SPECL [← q r"x:num->bool", ← q r"n:num"] CANTOR_MAP_GE_PARTIAL_SUM) THEN
      MP_TAC (← SPECL [← q r"x:num->bool", ← q r"n:num"] CANTOR_MAP_PARTIAL_SUM_BOUND) THEN
      SUBGOAL_THEN (← q r"(&1 / &3) pow (n + 1) <= (&1 / &3) pow N") MP_TAC THENL
       [MATCH_MP_TAC REAL_POW_MONO_INV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_ARITH_TAC,
        ASM_REAL_ARITH_TAC]])

  -- At the first disagreement k where a k /\ ~b k, the partial sums differ

  let CANTOR_PARTIAL_SUM_DIFF_AT_K ← prove
   r"!a b:num->bool k.
     (!j. j < k ==> a j = b j) /\ a k /\ ~(b k)
     ==> sum(0..k) (cantor_term a) =
         sum(0..k) (cantor_term b) + &2 / &3 pow (k + 1)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"s - t = d ==> s = t + d")) THEN
    REWRITE_TAC [← GSYM SUM_SUB_NUMSEG] THEN
    SUBGOAL_THEN
      (← q r"sum(0..k) (\j:num. cantor_term (a:num->bool) j - cantor_term b j) =
       sum(0..k) (\j. if j = k then &2 / &3 pow (k + 1) else &0)")
      SUBST1_TAC THENL
    [MATCH_MP_TAC SUM_EQ_NUMSEG THEN X_GEN_TAC (← q r"j:num") THEN
     STRIP_TAC THEN REWRITE_TAC [cantor_term] THEN ASM_CASES_TAC (← q r"j:num = k") THEN
     ASM_REWRITE_TAC [] THENL [REAL_ARITH_TAC, ALL_TAC] THEN
     SUBGOAL_THEN (← q r"(a:num->bool) j = b j")
       (fun th => REWRITE_TAC [th] THEN REAL_ARITH_TAC) THEN
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
     REWRITE_TAC [SUM_DELTA, IN_NUMSEG, LE_0, LE_REFL]])

  -- If a and b first disagree at k with a(k) true, then cantor_map b < cantor_map a

  let CANTOR_MAP_STRICT_LT ← prove
   r"!a b:num->bool k.
     (!j. j < k ==> a j = b j) /\ a k /\ ~(b k)
     ==> cantor_map b < cantor_map a"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MP_TAC (← SPECL
     [← q r"a:num->bool", ← q r"b:num->bool", ← q r"k:num"] CANTOR_PARTIAL_SUM_DIFF_AT_K) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    MP_TAC (← SPECL [← q r"b:num->bool", ← q r"k:num"] CANTOR_MAP_PARTIAL_SUM_BOUND) THEN
    MP_TAC (← SPECL [← q r"a:num->bool", ← q r"k:num"] CANTOR_MAP_GE_PARTIAL_SUM) THEN
    SUBGOAL_THEN (← q r"(&1 / &3) pow (k + 1) < &2 / &3 pow (k + 1)") MP_TAC THENL
     [SIMP_TAC [REAL_POW_DIV, REAL_POW_ONE, REAL_LT_DIV2_EQ, REAL_POW_LT,
                ← REAL_ARITH (← q r"&0 < &3")] THEN REAL_ARITH_TAC,
      ASM_REAL_ARITH_TAC])

  -- Injectivity of cantor_map

  let CANTOR_MAP_INJECTIVE ← prove
   r"!a b:num->bool. cantor_map a = cantor_map b <=> a = b"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
    [ALL_TAC, MESON_TAC []] THEN
    ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [FUN_EQ_THM, NOT_FORALL_THM] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [num_WOP]) THEN
    REWRITE_TAC [NOT_CLAUSES] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"a < b \/ b < a ==> ~(a = b)")) THEN
    ASM_MESON_TAC [CANTOR_MAP_STRICT_LT])

  let CANTOR_MAP_EMBEDDING ← prove
   r"embedding_map (cantor_space,euclideanreal) cantor_map"
   (MATCH_MP_TAC CONTINUOUS_IMP_EMBEDDING_MAP THEN
    REWRITE_TAC [COMPACT_SPACE_CANTOR_SPACE, HAUSDORFF_SPACE_EUCLIDEANREAL,
                 CANTOR_MAP_CONTINUOUS, TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN
    MESON_TAC [CANTOR_MAP_INJECTIVE])

  let CANTOR_MAP_CLOSED_IMAGE ← prove
   r"closed_in euclideanreal (IMAGE cantor_map (:num->bool))"
   (MESON_TAC [COMPACT_IN_IMP_CLOSED_IN, IMAGE_COMPACT_IN,
      HAUSDORFF_SPACE_EUCLIDEANREAL, CANTOR_MAP_CONTINUOUS,
      COMPACT_SPACE_CANTOR_SPACE, compact_space, TOPSPACE_CANTOR_SPACE])

  let CANTOR_MAP_IMAGE_SUBSET_INTERVAL ← prove
   r"IMAGE cantor_map (:num->bool) SUBSET real_interval [&0,&1]"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV, CANTOR_MAP_RANGE])

  let CANTOR_MAP_CLOSED_IN_INTERVAL ← prove
   r"closed_in (subtopology euclideanreal (real_interval [&0,&1]))
             (IMAGE cantor_map (:num->bool))"
   (MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
    REWRITE_TAC [CANTOR_MAP_CLOSED_IMAGE, CANTOR_MAP_IMAGE_SUBSET_INTERVAL])

  let CANTOR_SET_SUBSET_INTERVAL ← prove
   r"cantor_set SUBSET real_interval [&0,&1]"
   (REWRITE_TAC [cantor_set, CANTOR_MAP_IMAGE_SUBSET_INTERVAL])

  let CLOSED_IN_CANTOR_SET ← prove
   r"closed_in euclideanreal cantor_set"
   (REWRITE_TAC [cantor_set, CANTOR_MAP_CLOSED_IMAGE])

  let CLOSED_IN_CANTOR_SET_INTERVAL ← prove
   r"closed_in (subtopology euclideanreal (real_interval [&0,&1])) cantor_set"
   (REWRITE_TAC [cantor_set, CANTOR_MAP_CLOSED_IN_INTERVAL])

  let CANTOR_SPACE_HOMEOMORPHIC_CANTOR_SET ← prove
   r"cantor_space homeomorphic_space
   subtopology euclideanreal cantor_set"
   (MATCH_MP_TAC HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE THEN
    EXISTS_TAC (← q r"cantor_map") THEN MP_TAC CANTOR_MAP_EMBEDDING THEN
    REWRITE_TAC [embedding_map, TOPSPACE_CANTOR_SPACE, cantor_set])

  return { CANTOR_MAP_GE_PARTIAL_SUM, CANTOR_MAP_PARTIAL_SUM_BOUND, CANTOR_MAP_POS,
           CANTOR_MAP_RANGE, CANTOR_TERM_CONTINUOUS, CANTOR_MAP_CONTINUOUS,
           CANTOR_PARTIAL_SUM_DIFF_AT_K, CANTOR_MAP_STRICT_LT, CANTOR_MAP_INJECTIVE,
           CANTOR_MAP_EMBEDDING, CANTOR_MAP_CLOSED_IMAGE, CANTOR_MAP_IMAGE_SUBSET_INTERVAL,
           CANTOR_MAP_CLOSED_IN_INTERVAL, CANTOR_SET_SUBSET_INTERVAL, CLOSED_IN_CANTOR_SET,
           CLOSED_IN_CANTOR_SET_INTERVAL, CANTOR_SPACE_HOMEOMORPHIC_CANTOR_SET }

/- ------------------------------------------------------------------------- -/
/- Alexandroff-Hausdorff Theorem: H-Y Theorem 3-28.                          -/
/- Every nonempty compact metrizable space is a continuous image of          -/
/- the Cantor space.                                                         -/
/- (metric.ml 45701-46297)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LCR where
  LOCALLY_CONSTANT_REFINEMENT : thm
  deriving Inhabited

@[nospecialize]
def setupLCR [HolBase] (D : MetricDeps) (BTopology : Topology) (BDerived : Derived)
    (BCompact1 : Compact1) (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BNbhdBase : NbhdBase)
    (BTotBdd1 : TotBdd1) (BMCompact2 : MCompact2) (BDIAM1 : DIAM1) (BDIM1 : DIM1)
    (BCAN1 : CAN1) :
    ExceptT String IO LCR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON_TAC, SET_TAC, SELECT_CONV, .. } := D
  let { ARITH, CARD_CLAUSES, CARD_EQ_0, CARD_EQ_BIJECTION, DISJOINT, FINITE_DELETE,
        FINITE_EMPTY, FINITE_IMAGE, FINITE_INSERT, FINITE_SUBSET, FORALL_IN_IMAGE, HAS_SIZE,
        IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_INTER, IN_SING, IN_UNIONS,
        IN_UNIV, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, PAIRWISE_INSERT, PAIRWISE_SING, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_TRANS, REAL_LT_DIV, REAL_OF_NUM_LT, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_TRANS, UNIONS_1, UNIONS_IMAGE,
        UNIONS_INSERT, UNIONS_SUBSET, pairwise, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_INTER,
        OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, closed_in, .. } := BTopology
  let { IN_DERIVED_SET_OF, .. } := BDerived
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_SPACE_ALT, .. } := BCompact1
  let { CLOSED_IN_HAUSDORFF_SING, .. } := BHausdorff1
  let { IN_MBALL, MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, MCBALL_SUBSET_MSPACE, TOPSPACE_MTOPOLOGY, .. } :=
    BMTopology
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { OPEN_NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { totally_bounded_in, .. } := BTotBdd1
  let { COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN, .. } := BMCompact2
  let { MDIAMETER_LE, MDIAMETER_SUBSET, .. } := BDIAM1
  let { DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN, .. } := BDIM1
  let { COMPACT_SPACE_CANTOR_SPACE, HAUSDORFF_SPACE_CANTOR_SPACE, PERFECT_CANTOR_SPACE,
        TOPSPACE_CANTOR_SPACE, ZERO_DIMENSIONAL_CANTOR_SPACE, .. } := BCAN1
  -- @@SCOPE END

  -- Key refinement lemma: refine a locally constant assignment
  let LOCALLY_CONSTANT_REFINEMENT ← do
    let COMPACT_SPACE_FINITE_CLOSED_COVER ← prove
     r"!m:A metric e.
         compact_space (mtopology m) /\ ~(mspace m = {}) /\ &0 < e
         ==> ?c. FINITE c /\ ~(c = {}) /\
                 (!s. s IN c ==> closed_in (mtopology m) s) /\
                 (!s. s IN c ==> ~(s = {})) /\
                 (!s. s IN c ==> mdiameter m s < e) /\
                 UNIONS c = mspace m"
     (REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"totally_bounded_in m (mspace m:A->bool)") MP_TAC THENL
       [ASM_MESON_TAC [COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN], ALL_TAC] THEN
      REWRITE_TAC [totally_bounded_in] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
      ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (\x:A. mcball m (x, e / &3)) k") THEN
      CONJ_TAC THENL [ASM_SIMP_TAC [FINITE_IMAGE], ALL_TAC] THEN
      CONJ_TAC THENL [REWRITE_TAC [IMAGE_EQ_EMPTY] THEN
        SUBGOAL_THEN (← q r"~(k:A->bool = {})") (fun th => REWRITE_TAC [th]) THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
        SUBGOAL_THEN (← q r"(a:A) IN UNIONS {mball m (x,e / &3) | x IN k}")
          MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL
       [GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [CLOSED_IN_MCBALL],
        ALL_TAC] THEN
      CONJ_TAC THENL [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"x:A") THEN
          REWRITE_TAC [IN_MCBALL] THEN
        SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
          [ASM SET_TAC [], ALL_TAC] THEN
        ASM_SIMP_TAC [MDIST_REFL] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      CONJ_TAC THENL [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"&2 * e / &3") THEN
        CONJ_TAC THENL [MATCH_MP_TAC MDIAMETER_LE THEN
          CONJ_TAC THENL [REWRITE_TAC [MCBALL_SUBSET_MSPACE], ALL_TAC] THEN
          CONJ_TAC THENL [DISJ2_TAC THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
            REWRITE_TAC [IN_MCBALL] THEN
          MAP_EVERY X_GEN_TAC [← q r"y:A", ← q r"z:A"] THEN STRIP_TAC THEN
            MATCH_MP_TAC REAL_LE_TRANS THEN
          EXISTS_TAC (← q r"mdist m (y:A,x) + mdist m (x,z)") THEN
          CONJ_TAC THENL [ASM_MESON_TAC [MDIST_TRIANGLE], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"mdist m (y:A,x) <= e / &3") ASSUME_TAC THENL
           [ASM_MESON_TAC [MDIST_SYM], ASM_REAL_ARITH_TAC], ASM_REAL_ARITH_TAC],
             ALL_TAC] THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
        GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [MCBALL_SUBSET_MSPACE],
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
        REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
        SUBGOAL_THEN (← q r"(y:A) IN UNIONS {mball m (x,e / &3) | x IN k}") MP_TAC THENL
          [ASM SET_TAC [], ALL_TAC] THEN
        REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool")
          (CONJUNCTS_THEN2
            (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC)
            ASSUME_TAC)) THEN EXISTS_TAC (← q r"z:A") THEN ASM_REWRITE_TAC [] THEN
        UNDISCH_TAC (← q r"(y:A) IN b") THEN ASM_REWRITE_TAC [] THEN
          REWRITE_TAC [IN_MBALL, IN_MCBALL] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC])
    let COMPACT_SUBSET_FINITE_CLOSED_COVER ← prove
     r"!m:A metric s e.
         compact_space (mtopology m) /\ closed_in (mtopology m) s /\
         ~(s = {}) /\ &0 < e
         ==> ?c. FINITE c /\ ~(c = {}) /\
                 (!t. t IN c ==> closed_in (mtopology m) t) /\
                 (!t. t IN c ==> ~(t = {})) /\
                 (!t. t IN c ==> t SUBSET s) /\
                 (!t. t IN c ==> mdiameter m t < e) /\
                 UNIONS c = s"
     (REPEAT STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_SUBSET, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~(mspace m:A->bool = {})") ASSUME_TAC THENL
        [ASM SET_TAC [], ALL_TAC] THEN
      MP_TAC (← SPECL [← q r"m:A metric", ← q r"e:real"] COMPACT_SPACE_FINITE_CLOSED_COVER) THEN
      ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"bigc:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC
        (← q r"IMAGE (\u:A->bool. u INTER s) bigc DELETE ({}:A->bool)") THEN
      CONJ_TAC THENL [ASM_SIMP_TAC [FINITE_DELETE, FINITE_IMAGE], ALL_TAC] THEN
      CONJ_TAC THENL [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        UNDISCH_TAC (← q r"~(s:A->bool = {})") THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"y:A")) THEN
        SUBGOAL_THEN (← q r"(y:A) IN UNIONS bigc") MP_TAC THENL
          [ASM SET_TAC [], ALL_TAC] THEN
          REWRITE_TAC [IN_UNIONS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(u:A->bool) INTER s") THEN REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
        CONJ_TAC THENL
          [EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
          ASM SET_TAC [], ALL_TAC] THEN
      /- closed_in -/
      CONJ_TAC THENL
       [REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
          ASSUME_TAC) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_INTER THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      /- ~(t = {}) -/
      CONJ_TAC THENL [REWRITE_TAC [IN_DELETE] THEN MESON_TAC [], ALL_TAC] THEN
      /- t SUBSET s -/
      CONJ_TAC THENL
       [REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
          ASSUME_TAC) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      /- mdiameter < e -/
      CONJ_TAC THENL
       [REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
          ASSUME_TAC) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"mdiameter m (u:A->bool)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC MDIAMETER_SUBSET THEN CONJ_TAC THENL [SET_TAC [],
            ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE, COMPACT_IN_IMP_MBOUNDED]],
          ASM_MESON_TAC []], ALL_TAC] THEN
      /- UNIONS c = s -/
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET] THEN
        REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
        X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2
          (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
          ASSUME_TAC) THEN
        ASM SET_TAC [],
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
          REWRITE_TAC [IN_UNIONS] THEN
        SUBGOAL_THEN (← q r"(y:A) IN UNIONS bigc") MP_TAC THENL
          [ASM SET_TAC [], ALL_TAC] THEN
          REWRITE_TAC [IN_UNIONS] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(u:A->bool) INTER s") THEN
          CONJ_TAC THENL [REWRITE_TAC [IN_DELETE, IN_IMAGE] THEN
          CONJ_TAC THENL [EXISTS_TAC (← q r"u:A->bool") THEN
            ASM_REWRITE_TAC [], ASM SET_TAC []],
          ASM SET_TAC []]])
    let fiber_openness_tac : tactic :=
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:num->bool")) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(num->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"u:(num->bool)->bool") THEN
      REPLICATE_TAC 2 (CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC]) THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"w:num->bool") THEN DISCH_TAC THEN ASM_MESON_TAC []
    let LOCALLY_CONSTANT_CANTOR_SPACE_FIBER_OPEN ← prove
     r"!h:(num->bool)->(A->bool) s.
        (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
          (!y. y IN u ==> h y = h x))
        ==> open_in cantor_space {x:num->bool | h x = s}"
     (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
        X_GEN_TAC (← q r"z:num->bool") THEN
      REWRITE_TAC [IN_ELIM_THM, TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN
      DISCH_TAC THEN fiber_openness_tac)
    let LOCALLY_CONSTANT_CANTOR_SPACE_FIBER_CLOSED ← prove
     r"!h:(num->bool)->(A->bool) s.
        (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
          (!y. y IN u ==> h y = h x))
        ==> closed_in cantor_space {x:num->bool | h x = s}"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [closed_in, TOPSPACE_CANTOR_SPACE] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(:num->bool) DIFF {x | (h:(num->bool)->(A->bool)) x = s} =
         {x:num->bool | ~(h x = s)}") SUBST1_TAC THENL [SET_TAC [], ALL_TAC] THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"z:num->bool") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN DISCH_TAC THEN fiber_openness_tac)
    let LOCALLY_CONSTANT_CANTOR_SPACE_FINITE_IMAGE ← prove
     r"!h:(num->bool)->(A->bool).
        (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
          (!y. y IN u ==> h y = h x))
        ==> FINITE(IMAGE h (:num->bool))"
     (GEN_TAC THEN DISCH_TAC THEN
      POP_ASSUM (X_CHOOSE_THEN (← q r"uf:(num->bool)->(num->bool)->bool")
        ASSUME_TAC o REWRITE_RULE [SKOLEM_THM]) THEN
      /- Get finite subcover from compactness of cantor_space -/
      SUBGOAL_THEN (← q r"?bigv:((num->bool)->bool)->bool.
          FINITE bigv /\
          bigv SUBSET IMAGE (uf:(num->bool)->(num->bool)->bool) (:num->bool) /\
          (:num->bool) SUBSET UNIONS bigv")
        STRIP_ASSUME_TAC THENL [MP_TAC COMPACT_SPACE_CANTOR_SPACE THEN
        REWRITE_TAC [COMPACT_SPACE_ALT, TOPSPACE_CANTOR_SPACE] THEN
          DISCH_THEN (MP_TAC o SPEC
          (← q r"IMAGE (uf:(num->bool)->(num->bool)->bool) (:num->bool)")) THEN
            ANTS_TAC THENL [CONJ_TAC THENL
           [REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN GEN_TAC THEN
             ASM_MESON_TAC [],
            REWRITE_TAC [SUBSET, IN_UNIV, IN_UNIONS] THEN
              X_GEN_TAC (← q r"z:num->bool") THEN
            EXISTS_TAC (← q r"(uf:(num->bool)->(num->bool)->bool) z") THEN
            CONJ_TAC THENL [REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN
              EXISTS_TAC (← q r"z:num->bool") THEN
                REFL_TAC, ASM_MESON_TAC []]], MESON_TAC []], ALL_TAC] THEN
      /- Pick centers: sel v satisfies uf(sel v) = v for v IN bigv -/
      SUBGOAL_THEN (← q r"?sel:((num->bool)->bool)->(num->bool).
           !v:(num->bool)->bool. v IN bigv
             ==> (uf:(num->bool)->(num->bool)->bool) (sel v) = v")
        STRIP_ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM SKOLEM_THM] THEN UNDISCH_TAC
          (← q r"bigv SUBSET IMAGE
           (uf:(num->bool)->(num->bool)->bool)
           (:num->bool)") THEN
        REWRITE_TAC [SUBSET, IN_IMAGE, IN_UNIV] THEN MESON_TAC [], ALL_TAC] THEN
      /- IMAGE h UNIV SUBSET IMAGE h (IMAGE sel bigv) -/
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
        (← q r"IMAGE (h:(num->bool)->(A->bool))
               (IMAGE (sel:((num->bool)->bool)->(num->bool))
                 bigv)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_IMAGE THEN MATCH_MP_TAC FINITE_IMAGE THEN
         ASM_REWRITE_TAC [], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_UNIV] THEN
        X_GEN_TAC (← q r"y:num->bool") THEN
      /- Find v IN bigv containing y -/
      SUBGOAL_THEN (← q r"?v:(num->bool)->bool. v IN bigv /\ (y:num->bool) IN v")
        STRIP_ASSUME_TAC THENL
         [UNDISCH_TAC (← q r"(:num->bool) SUBSET UNIONS bigv") THEN
        REWRITE_TAC [SUBSET, IN_UNIV, IN_UNIONS] THEN MESON_TAC [], ALL_TAC] THEN
      /- h y = h(sel v) because both are in v = uf(sel v) where h is constant -/
      SUBGOAL_THEN (← q r"(h:(num->bool)->(A->bool)) y =
         h ((sel:((num->bool)->bool)->(num->bool))
           v)") SUBST1_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      /- h(sel v) IN IMAGE h (IMAGE sel bigv) -/
      REWRITE_TAC [IN_IMAGE] THEN
      EXISTS_TAC (← q r"(sel:((num->bool)->bool)->(num->bool)) v") THEN
        CONJ_TAC THENL [REFL_TAC,
        EXISTS_TAC (← q r"v:(num->bool)->bool") THEN ASM_REWRITE_TAC []])
    let CANTOR_SPACE_OPEN_HAS_TWO_POINTS ← prove
     r"!s:(num->bool)->bool.
         open_in cantor_space s /\ ~(s = {})
         ==> ?x y. x IN s /\ y IN s /\ ~(x = y)"
     (REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"x:num->bool")) THEN
      SUBGOAL_THEN (← q r"(x:num->bool) IN topspace cantor_space") ASSUME_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
      MP_TAC (← SPEC (← q r"x:num->bool") PERFECT_CANTOR_SPACE) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IN_DERIVED_SET_OF] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"s:(num->bool)->bool"))) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:num->bool") STRIP_ASSUME_TAC) THEN
      MAP_EVERY EXISTS_TAC [← q r"x:num->bool", ← q r"y:num->bool"] THEN
      ASM_REWRITE_TAC [])
    let CANTOR_SPACE_PROPER_CLOPEN_SUBSET ← prove
     r"!s:(num->bool)->bool.
         open_in cantor_space s /\ closed_in cantor_space s /\ ~(s = {})
         ==> ?t. open_in cantor_space t /\ closed_in cantor_space t /\
                 ~(t = {}) /\ t SUBSET s /\
                   ~(s DIFF t = {})"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← SPEC (← q r"s:(num->bool)->bool") CANTOR_SPACE_OPEN_HAS_TWO_POINTS) THEN
        ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->bool")
        (X_CHOOSE_THEN (← q r"y:num->bool") STRIP_ASSUME_TAC)) THEN
      SUBGOAL_THEN (← q r"open_in cantor_space (s DIFF {y:num->bool})") ASSUME_TAC THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_HAUSDORFF_SING THEN
          REWRITE_TAC [HAUSDORFF_SPACE_CANTOR_SPACE] THEN
        ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(x:num->bool) IN s DIFF {y}") ASSUME_TAC THENL
        [ASM_REWRITE_TAC [IN_DIFF, IN_SING], ALL_TAC] THEN
      MP_TAC ZERO_DIMENSIONAL_CANTOR_SPACE THEN
      REWRITE_TAC [DIMENSION_LE_0_NEIGHBOURHOOD_BASE_OF_CLOPEN] THEN
        SUBGOAL_THEN (← q r"!u:(num->bool)->bool.
           closed_in cantor_space u /\ open_in cantor_space u
           ==> open_in cantor_space u")
        (fun th => SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF, th]) THENL [MESON_TAC [],
          ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPECL
        [← q r"s DIFF {y:num->bool}", ← q r"x:num->bool"]) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:(num->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"t:(num->bool)->bool") THEN
      ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THEN ASM SET_TAC [])
    let CANTOR_SPACE_CLOPEN_PARTITION ← prove
     r"!k s:(num->bool)->bool.
         open_in cantor_space s /\ closed_in cantor_space s /\
         ~(s = {}) /\ 1 <= k
         ==> ?p. p HAS_SIZE k /\
                 (!t. t IN p ==> open_in cantor_space t) /\
                 (!t. t IN p ==> closed_in cantor_space t) /\
                 (!t. t IN p ==> ~(t = {})) /\
                 UNIONS p = s /\ pairwise DISJOINT p"
     (INDUCT_TAC THENL [ARITH_TAC,
        X_GEN_TAC (← q r"s:(num->bool)->bool") THEN STRIP_TAC THEN
          ASM_CASES_TAC (← q r"k = 0") THENL
         [/- SUC 0 = 1: partition is {s} -/
          EXISTS_TAC (← q r"{s:(num->bool)->bool}") THEN
          ASM_REWRITE_TAC [IN_SING, UNIONS_1, PAIRWISE_SING] THEN CONJ_TAC THENL
           [REWRITE_TAC [HAS_SIZE, FINITE_INSERT, FINITE_EMPTY] THEN
            SIMP_TAC [CARD_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY] THEN
              ASM_ARITH_TAC, ASM_MESON_TAC []],
          /- SUC k for k >= 1: split and use IH -/
          MP_TAC (← SPEC (← q r"s:(num->bool)->bool")
            CANTOR_SPACE_PROPER_CLOPEN_SUBSET) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"t:(num->bool)->bool") STRIP_ASSUME_TAC) THEN
            SUBGOAL_THEN
            (← q r"open_in cantor_space (s DIFF t:(num->bool)->bool)")
            ASSUME_TAC THENL [MATCH_MP_TAC OPEN_IN_DIFF THEN
              ASM_REWRITE_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"closed_in cantor_space (s DIFF t:(num->bool)->bool)")
            ASSUME_TAC THENL [MATCH_MP_TAC CLOSED_IN_DIFF THEN
              ASM_REWRITE_TAC [], ALL_TAC] THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s DIFF t:(num->bool)->bool")) THEN
            ASM_REWRITE_TAC [] THEN
          ANTS_TAC THENL [UNDISCH_TAC (← q r"~(k = 0)") THEN ARITH_TAC, ALL_TAC] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"p:((num->bool)->bool)->bool")
            STRIP_ASSUME_TAC) THEN
              SUBGOAL_THEN (← q r"~((t:(num->bool)->bool) IN p)") ASSUME_TAC THENL
           [DISCH_TAC THEN SUBGOAL_THEN (← q r"(t:(num->bool)->bool) SUBSET s DIFF t")
              MP_TAC THENL [ASM SET_TAC [], ASM SET_TAC []], ALL_TAC] THEN
          EXISTS_TAC (← q r"(t:(num->bool)->bool) INSERT p") THEN CONJ_TAC THENL
           [UNDISCH_TAC (← q r"(p:((num->bool)->bool)->bool) HAS_SIZE k") THEN
            REWRITE_TAC [HAS_SIZE, FINITE_INSERT] THEN STRIP_TAC THEN
            UNDISCH_TAC (← q r"~((t:(num->bool)->bool) IN p)") THEN
            ASM_SIMP_TAC [CARD_CLAUSES] THEN ARITH_TAC, ALL_TAC] THEN
              REPLICATE_TAC 3
           (CONJ_TAC THENL [REWRITE_TAC [IN_INSERT] THEN
             ASM_MESON_TAC [], ALL_TAC]) THEN CONJ_TAC THENL
           [REWRITE_TAC [UNIONS_INSERT] THEN
             ASM SET_TAC [], REWRITE_TAC [PAIRWISE_INSERT] THEN
            CONJ_TAC THENL [X_GEN_TAC (← q r"u:(num->bool)->bool") THEN STRIP_TAC THEN
              SUBGOAL_THEN (← q r"(u:(num->bool)->bool) SUBSET s DIFF t")
                ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
              CONJ_TAC THEN REWRITE_TAC [DISJOINT] THEN
                ASM SET_TAC [], ASM_REWRITE_TAC []]]]])
    prove
     r"!m:A metric (h:(num->bool)->(A->bool)) e.
      compact_space (mtopology m) /\
      &0 < e /\
      (!x. closed_in (mtopology m) (h x)) /\
      (!x. ~(h x = {})) /\
      (!x. h x SUBSET mspace m) /\
      (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
        (!y. y IN u ==> h y = h x)) /\
      (!a. a IN mspace m ==> ?x. a IN h x)
      ==> ?h':(num->bool)->(A->bool).
           (!x. closed_in (mtopology m) (h' x)) /\
           (!x. ~(h' x = {})) /\
           (!x. h' x SUBSET mspace m) /\
           (!x. mdiameter m (h' x) < e) /\
           (!x. h' x SUBSET h x) /\
           (!x. ?u. open_in cantor_space u /\ x IN u /\
             (!y. y IN u ==> h' y = h' x)) /\
           (!a. a IN mspace m ==> ?x. a IN h' x)"
     (REPEAT STRIP_TAC THEN
      /- Label key hypotheses for later use -/
      SUBGOAL_THEN (← q r"!x:num->bool. ?u:(num->bool)->bool.
           open_in cantor_space u /\ x IN u /\
           (!y. y IN u ==> (h:(num->bool)->(A->bool)) y = h x)")
        (LABEL_TAC "h_loc") THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"!a:A. a IN mspace m ==> ?x:num->bool. a IN (h:(num->bool)->(A->bool)) x")
        (LABEL_TAC "h_surj") THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      /- A: Basic setup -/
      SUBGOAL_THEN (← q r"~(mspace m:A->bool = {})") ASSUME_TAC THENL
       [ASM_MESON_TAC [MEMBER_NOT_EMPTY, SUBSET, NOT_IN_EMPTY], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"FINITE(IMAGE (h:(num->bool)->(A->bool)) (:num->bool))")
        ASSUME_TAC THENL
       [MATCH_MP_TAC LOCALLY_CONSTANT_CANTOR_SPACE_FINITE_IMAGE THEN
         ASM_MESON_TAC [], ALL_TAC] THEN
      /- B: Covers - Skolemize -/
      SUBGOAL_THEN (← q r"!s:A->bool. s IN IMAGE h (:num->bool)
         ==> ?c. FINITE c /\ ~(c = {}) /\
                 (!t. t IN c ==> closed_in (mtopology m) t) /\
                 (!t. t IN c ==> ~(t = {})) /\
                 (!t. t IN c ==> t SUBSET s) /\
                 (!t. t IN c ==> mdiameter m t < e) /\
                 UNIONS c = s")
        MP_TAC THENL [REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
          X_GEN_TAC (← q r"x:num->bool") THEN
        MATCH_MP_TAC COMPACT_SUBSET_FINITE_CLOSED_COVER THEN
          ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"cov:(A->bool)->((A->bool)->bool)")
        (LABEL_TAC "cov_props") o
        REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
      /- C: Fibers are nonempty clopen -/
      SUBGOAL_THEN (← q r"!s:A->bool. s IN IMAGE h (:num->bool)
         ==> open_in cantor_space {x:num->bool | h x = s} /\
             closed_in cantor_space {x:num->bool | h x = s} /\
             ~({x:num->bool | h x = s} = {})")
        ASSUME_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN X_GEN_TAC (← q r"x:num->bool") THEN
         REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC LOCALLY_CONSTANT_CANTOR_SPACE_FIBER_OPEN THEN
           ASM_MESON_TAC [],
          MATCH_MP_TAC LOCALLY_CONSTANT_CANTOR_SPACE_FIBER_CLOSED THEN
            ASM_MESON_TAC [],
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
          EXISTS_TAC (← q r"x:num->bool") THEN REFL_TAC], ALL_TAC] THEN
      /- D: Partitions - Skolemize -/
      SUBGOAL_THEN (← q r"!s:A->bool. s IN IMAGE h (:num->bool)
         ==> ?p. p HAS_SIZE CARD((cov:(A->bool)->((A->bool)->bool)) s) /\
                 (!t. t IN p ==> open_in cantor_space t) /\
                 (!t. t IN p ==> closed_in cantor_space t) /\
                 (!t. t IN p ==> ~(t = {})) /\
                 UNIONS p = {x:num->bool | h x = s} /\
                 pairwise DISJOINT p")
        MP_TAC THENL [X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
        MATCH_MP_TAC CANTOR_SPACE_CLOPEN_PARTITION THEN ASM_SIMP_TAC [] THEN
        MATCH_MP_TAC (← ARITH_RULE (← q r"~(n = 0) ==> 1 <= n")) THEN
        SUBGOAL_THEN (← q r"FINITE((cov:(A->bool)->((A->bool)->bool)) s)") MP_TAC THENL
          [ASM_MESON_TAC [], ALL_TAC] THEN
        SIMP_TAC [CARD_EQ_0] THEN ASM_MESON_TAC [], ALL_TAC] THEN
          DISCH_THEN (X_CHOOSE_THEN
        (← q r"part:(A->bool)->(((num->bool)->bool)->bool)")
        (LABEL_TAC "part_props") o
        REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
      /- E: Bijections - Skolemize -/
      SUBGOAL_THEN (← q r"!s:A->bool. s IN IMAGE h (:num->bool)
         ==> ?f:((num->bool)->bool)->(A->bool).
               (!t. t IN (part:(A->bool)->(((num->bool)->bool)->bool)) s
                    ==> f t IN (cov:(A->bool)->((A->bool)->bool)) s) /\
               (!u. u IN cov s ==> ?t. t IN part s /\ f t = u) /\
               (!t1 t2. t1 IN part s /\ t2 IN part s /\ f t1 = f t2
                        ==> t1 = t2)")
        MP_TAC THENL [X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
          MATCH_MP_TAC CARD_EQ_BIJECTION THEN
        SUBGOAL_THEN (← q r"(part:(A->bool)->(((num->bool)->bool)->bool)) s
           HAS_SIZE CARD((cov:(A->bool)->((A->bool)->bool)) s)")
          MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        REWRITE_TAC [HAS_SIZE] THEN STRIP_TAC THEN ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"bij:(A->bool)->((num->bool)->bool)->(A->bool)")
        (LABEL_TAC "bij_props") o
        REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
      /- F: Helper - every x IN IMAGE h -/
      SUBGOAL_THEN (← q r"!x:num->bool.
           (h:(num->bool)->(A->bool)) x IN IMAGE h (:num->bool)")
        (LABEL_TAC "h_in_image") THENL [REWRITE_TAC [IN_IMAGE, IN_UNIV] THEN
          MESON_TAC [], ALL_TAC] THEN
      /- G: For any x, @t selects a valid partition piece containing x -/
      SUBGOAL_THEN (← q r"!x:num->bool.
           (@t. t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                     ((h:(num->bool)->(A->bool)) x) /\
                x IN t)
           IN part (h x) /\
           x IN (@t. t IN part (h x) /\ x IN t)")
        (LABEL_TAC "piece_valid") THENL
       [X_GEN_TAC (← q r"x:num->bool") THEN CONV_TAC SELECT_CONV THEN
         SUBGOAL_THEN (← q r"(x:num->bool) IN
           UNIONS((part:(A->bool)->(((num->bool)->bool)->bool))
                  ((h:(num->bool)->(A->bool)) x))")
          MP_TAC THENL [SUBGOAL_THEN
            (← q r"UNIONS((part:(A->bool)->(((num->bool)->bool)->bool))
                   ((h:(num->bool)->(A->bool)) x)) =
             {z:num->bool | h z = h x}")
            SUBST1_TAC THENL [USE_THEN "part_props" (MP_TAC o SPEC
              (← q r"(h:(num->bool)->(A->bool)) x")) THEN
            USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN
              SIMP_TAC [], ALL_TAC] THEN
          REWRITE_TAC [IN_ELIM_THM],
          REWRITE_TAC [IN_UNIONS] THEN MESON_TAC []], ALL_TAC] THEN
      /- H: Uniqueness - if q IN part(h x) and x IN q, then @t = q -/
      SUBGOAL_THEN (← q r"!x:num->bool q:(num->bool)->bool.
           q IN (part:(A->bool)->(((num->bool)->bool)->bool))
                ((h:(num->bool)->(A->bool)) x) /\ x IN q
           ==> (@t. t IN part (h x) /\ x IN t) = q")
        (LABEL_TAC "piece_unique") THENL
       [REPEAT STRIP_TAC THEN
         USE_THEN "piece_valid" (MP_TAC o SPEC (← q r"x:num->bool")) THEN STRIP_TAC THEN
        USE_THEN "part_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x")) THEN
        USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN STRIP_TAC THEN
          UNDISCH_TAC
          (← q r"pairwise DISJOINT
           ((part:(A->bool)->(((num->bool)->bool)->bool))
             ((h:(num->bool)->(A->bool)) x))") THEN
        REWRITE_TAC [pairwise] THEN DISCH_TAC THEN ASM_CASES_TAC
          (← q r"(@t:(num->bool)->bool.
              t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                   ((h:(num->bool)->(A->bool)) x) /\
                     x IN t) = q") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
          [← q r"@t:(num->bool)->bool.
              t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                   ((h:(num->bool)->(A->bool)) x) /\
                     x IN t", ← q r"q:(num->bool)->bool"]) THEN
        ASM_REWRITE_TAC [DISJOINT] THEN ASM SET_TAC [], ALL_TAC] THEN
      /- I: Define h' -/
      EXISTS_TAC
        (← q r"\x:num->bool.
           (bij:(A->bool)->((num->bool)->bool)->(A->bool))
           ((h:(num->bool)->(A->bool)) x)
           (@t:(num->bool)->bool.
              t IN (part:(A->bool)->(((num->bool)->bool)->bool)) (h x) /\
              x IN t)") THEN REWRITE_TAC [] THEN
      /- bij(h x)(@t...) IN cov(h x) for all x -/
      SUBGOAL_THEN (← q r"!x:num->bool.
           (bij:(A->bool)->((num->bool)->bool)->(A->bool))
             ((h:(num->bool)->(A->bool)) x)
             (@t:(num->bool)->bool.
                t IN (part:(A->bool)->(((num->bool)->bool)->bool)) (h x) /\
                x IN t) IN
           (cov:(A->bool)->((A->bool)->bool)) (h x)")
        (LABEL_TAC "val_in_cov") THENL
       [GEN_TAC THEN
         USE_THEN "bij_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x")) THEN
        USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN
        STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        USE_THEN "piece_valid" (MP_TAC o SPEC (← q r"x:num->bool")) THEN
          SIMP_TAC [], ALL_TAC] THEN
      (tactic_of do
       let cov_tac : tactic :=
         USE_THEN "cov_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x")) THEN
         USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN
         STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
         USE_THEN "val_in_cov" (ACCEPT_TAC o SPEC (← q r"x:num->bool"))
       pure (REPEAT CONJ_TAC THENL [GEN_TAC THEN cov_tac, GEN_TAC THEN cov_tac,
        GEN_TAC THEN TRANS_TAC SUBSET_TRANS (← q r"(h:(num->bool)->(A->bool)) x") THEN
        ASM_REWRITE_TAC [] THEN cov_tac, GEN_TAC THEN cov_tac, GEN_TAC THEN cov_tac,
        /- 6: locally constant -/
        X_GEN_TAC (← q r"x:num->bool") THEN
          USE_THEN "h_loc" (MP_TAC o SPEC (← q r"x:num->bool")) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:(num->bool)->bool") STRIP_ASSUME_TAC) THEN
          ABBREV_TAC
          (← q r"px:(num->bool)->bool =
             @t. t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                      ((h:(num->bool)->(A->bool)) x) /\ x IN t") THEN
        EXISTS_TAC (← q r"u INTER (px:(num->bool)->bool)") THEN
          REPEAT CONJ_TAC THENL [/- open -/
          MATCH_MP_TAC OPEN_IN_INTER THEN ASM_REWRITE_TAC [] THEN
          USE_THEN "part_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x")) THEN
          USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN
          STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN EXPAND_TAC "px" THEN
          USE_THEN "piece_valid" (MP_TAC o SPEC (← q r"x:num->bool")) THEN SIMP_TAC [],
          /- x IN u INTER px -/
          REWRITE_TAC [IN_INTER] THEN ASM_REWRITE_TAC [] THEN EXPAND_TAC "px" THEN
          USE_THEN "piece_valid" (MP_TAC o SPEC (← q r"x:num->bool")) THEN SIMP_TAC [],
          /- constancy -/
          X_GEN_TAC (← q r"y:num->bool") THEN REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"(h:(num->bool)->(A->bool)) y = h x")
            ASSUME_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN
              ASM_REWRITE_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"(@t:(num->bool)->bool.
                t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                     ((h:(num->bool)->(A->bool)) y) /\ y IN t) = px")
            (fun th => ASM_REWRITE_TAC [th]) THEN
          USE_THEN "piece_unique" (fun th => MATCH_MP_TAC th) THEN
            ASM_REWRITE_TAC [] THEN
          EXPAND_TAC "px" THEN
            USE_THEN "piece_valid" (MP_TAC o SPEC (← q r"x:num->bool")) THEN SIMP_TAC []],
        /- 7: surjective -/
        X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"?x0:num->bool. a IN (h:(num->bool)->(A->bool)) x0")
          (X_CHOOSE_TAC (← q r"x0:num->bool")) THENL
         [USE_THEN "h_surj" (fun th => MATCH_MP_TAC th) THEN
           ASM_REWRITE_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?c:A->bool. c IN (cov:(A->bool)->((A->bool)->bool))
                             ((h:(num->bool)->(A->bool)) x0) /\ a IN c")
          STRIP_ASSUME_TAC THENL
         [USE_THEN "cov_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x0")) THEN
          USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"(a:A) IN UNIONS((cov:(A->bool)->((A->bool)->bool))
                              ((h:(num->bool)->(A->bool)) x0))")
            MP_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
              REWRITE_TAC [IN_UNIONS] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"c0:A->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"c0:A->bool") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?q:(num->bool)->bool.
             q IN (part:(A->bool)->(((num->bool)->bool)->bool))
                  ((h:(num->bool)->(A->bool)) x0) /\
             (bij:(A->bool)->((num->bool)->bool)->(A->bool)) (h x0) q = c")
          STRIP_ASSUME_TAC THENL [USE_THEN "bij_props" (fun bp =>
            USE_THEN "h_in_image" (fun hi => tactic_of do pure (MESON_TAC [← REWRITE_RULE [hi]
                (← SPEC (← q r"(h:(num->bool)->(A->bool)) x0") bp),
                ← ASSUME (← q r"c:A->bool IN
                  (cov:(A->bool)->((A->bool)->bool)) ((h:(num->bool)->(A->bool))
                    x0)")]))), ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?y:num->bool. y IN (q:(num->bool)->bool)")
          (X_CHOOSE_TAC (← q r"y:num->bool")) THENL [REWRITE_TAC [MEMBER_NOT_EMPTY] THEN
          USE_THEN "part_props" (MP_TAC o SPEC (← q r"(h:(num->bool)->(A->bool)) x0"))
            THEN
          USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN
          STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
            ASM_REWRITE_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(h:(num->bool)->(A->bool)) y = h x0")
          ASSUME_TAC THENL [USE_THEN "part_props" (MP_TAC o SPEC
            (← q r"(h:(num->bool)->(A->bool)) x0")) THEN
          USE_THEN "h_in_image" (fun th => REWRITE_TAC [th]) THEN STRIP_TAC THEN
          SUBGOAL_THEN (← q r"(y:num->bool) IN
             UNIONS((part:(A->bool)->(((num->bool)->bool)->bool))
                    ((h:(num->bool)->(A->bool))
                      x0))") MP_TAC THENL [REWRITE_TAC [IN_UNIONS] THEN
            EXISTS_TAC (← q r"q:(num->bool)->bool") THEN ASM_REWRITE_TAC [],
            ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN_ELIM_THM]], ALL_TAC] THEN
        EXISTS_TAC (← q r"y:num->bool") THEN SUBGOAL_THEN (← q r"(@t:(num->bool)->bool.
              t IN (part:(A->bool)->(((num->bool)->bool)->bool))
                   ((h:(num->bool)->(A->bool)) y) /\ y IN t) = q")
          (fun th => REWRITE_TAC [th]) THENL
         [USE_THEN "piece_unique" (fun th => MATCH_MP_TAC th) THEN
           ASM_REWRITE_TAC [],
          ASM_REWRITE_TAC []]])))

  return { LOCALLY_CONSTANT_REFINEMENT }

/- ------------------------------------------------------------------------- -/
/- Main theorem: Alexandroff-Hausdorff.  (metric.ml 46298-46702)             -/
/- ------------------------------------------------------------------------- -/

structure AH where
  ALEXANDROFF_HAUSDORFF : thm
  deriving Inhabited

@[nospecialize]
def setupAH [HolBase] (D : MetricDeps)
    (prove_recursive_functions_exist : thm → term → ExceptT String IO thm)
    (BTopology : Topology) (BContMap1 : ContMap1) (BCompact1 : Compact1)
    (BCompact2 : Compact2) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BMetricHaus : MetricHaus) (BMetrizable : Metrizable)
    (BCauchy3 : Cauchy3) (BMCompact2 : MCompact2) (BDIAM1 : DIAM1) (BCAN1 : CAN1)
    (BLCR : LCR) :
    ExceptT String IO AH := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_ELIM_THM, IN_IMAGE, IN_INTERS, IN_SING, IN_UNIV, LT_0,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ARCH_INV, REAL_LET_TRANS, REAL_LE_TRANS, REAL_LT_INV_EQ, REAL_LT_TRANS,
        REAL_OF_NUM_LT, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, SUBSET_TRANS,
        TRANSITIVE_STEPWISE_LE, num_CASES, num_RECURSION, .. } := D.core4
  let { CLOSED_IN_TOPSPACE, OPEN_IN_SUBOPEN, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { continuous_map, .. } := BContMap1
  let { CLOSED_IN_COMPACT_SPACE, .. } := BCompact1
  let { COMPACT_SPACE_IMP_NEST, .. } := BCompact2
  let { IN_MBALL, .. } := BMetricSpace
  let { IN_MCBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_SUBSET_MSPACE, .. } := BBounded
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { metrizable_space, .. } := BMetrizable
  let { MCOMPLETE_NEST_SING, .. } := BCauchy3
  let { COMPACT_SPACE_IMP_MCOMPLETE, .. } := BMCompact2
  let { MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  let { COMPACT_SPACE_CANTOR_SPACE, TOPSPACE_CANTOR_SPACE, .. } := BCAN1
  let { LOCALLY_CONSTANT_REFINEMENT, .. } := BLCR
  -- @@SCOPE END

  let ALEXANDROFF_HAUSDORFF ← do
    let TOWER_CONSTRUCTION_BASE ← prove
