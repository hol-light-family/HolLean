        FUN_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_CROSS, IN_DIFF, IN_UNIV, LEFT_IMP_EXISTS_THM, REAL_ABS_INV, .. } := D.core2
  let { REAL_LE_INV2, REAL_MUL_SYM, REAL_NEG_MINUS1, REAL_NOT_LT, .. } := D.core3
  let { REAL_SUB_RZERO, SUBSET, SUBSET_REFL, SUM_CLAUSES, o_DEF, real_div, real_sub, .. } :=
    D.core4
  let { FORALL_PAIR_THM, .. } := D.core5
  let { CLOSURE_OF_INTERIOR_OF, .. } := BInterior
  let { IN_MBALL, .. } := BMetricSpace
  let { IN_INTERIOR_OF_MBALL, .. } := BMTopology
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { MBOUNDED_REAL_EUCLIDEAN_METRIC, real_bounded, .. } := BRealConn1
  let { MBOUNDED_CROSS, .. } := BPM3
  let { LIPSCHITZ_CONTINUOUS_MAP_CONST, .. } := BLIP1
  let { UNIFORMLY_CONTINUOUS_MAP_COMPOSE, UNIFORMLY_CONTINUOUS_MAP_INTO_SUBMETRIC, .. } := BUC1
  let { LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP, .. } := BCC2
  let { UNIFORMLY_CONTINUOUS_MAP_PAIRWISE, .. } := BCC3
