/- ------------------------------------------------------------------------- -/
/- Urysohn's metrization theorem.  (metric.ml 38505-38556)                   -/
/- ------------------------------------------------------------------------- -/

structure URY1 where
  EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE : thm
  SEPARATING_FUNCTIONS_INJECTIVE : thm
  METRIZABLE_PRODUCT_EUCLIDEANREAL_NUM : thm
  deriving Inhabited

@[nospecialize]
def setupURY1 [HolBase] (D : MetricDeps) (BEmbedding : Embedding) (BHausdorff1 : Hausdorff1)
    (BMetrizable : Metrizable) (BRealTop2 : RealTop2) (BMSPT : MSPT) :
    ExceptT String IO URY1 := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, SET_TAC, .. } := D
  let { FUN_EQ_THM, .. } := D.core1
  let { SUBSET_UNIV, .. } := D.core4
  let { COUNTABLE_SUBSET, NUM_COUNTABLE, .. } := D.lib
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, .. } := BEmbedding
  let { hausdorff_space, .. } := BHausdorff1
  let { HOMEOMORPHIC_METRIZABLE_SPACE, METRIZABLE_SPACE_SUBTOPOLOGY, .. } := BMetrizable
  let { METRIZABLE_SPACE_EUCLIDEANREAL, .. } := BRealTop2
  let { METRIZABLE_SPACE_PRODUCT_TOPOLOGY, .. } := BMSPT
  -- @@SCOPE END

  let EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE ← prove
   r"!top top' (f:A->B).
        embedding_map (top,top') f /\ metrizable_space top'
        ==> metrizable_space top"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE) THEN
    DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology",
               ← q r"subtopology (top':B topology) (IMAGE (f:A->B) (topspace top))"]
      HOMEOMORPHIC_METRIZABLE_SPACE) THEN
    ASM_SIMP_TAC [METRIZABLE_SPACE_SUBTOPOLOGY])

  -- Helper lemma: separating functions give injectivity
  let SEPARATING_FUNCTIONS_INJECTIVE ← prove
   r"!top (fs:num->A->real) x y.
     hausdorff_space top /\
     (!x0 u. open_in top u /\ x0 IN u
             ==> (?n. fs n x0 > &0 /\
                      (!x. x IN topspace top /\ ~(x IN u) ==> fs n x = &0))) /\
     x IN topspace top /\ y IN topspace top
     ==> ((\n. fs n x) = (\n. fs n y) <=> x = y)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
    [DISCH_TAC THEN ASM_CASES_TAC (← q r"x:A = y") THENL
      [ASM_REWRITE_TAC [], ALL_TAC] THEN
     FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [hausdorff_space]) THEN
     DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") (X_CHOOSE_THEN (← q r"v:A->bool")
       STRIP_ASSUME_TAC)) THEN
     FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"u:A->bool"]) THEN
     ASM_REWRITE_TAC [] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
     SUBGOAL_THEN (← q r"(fs:num->A->real) n y = &0") ASSUME_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      ALL_TAC] THEN
     UNDISCH_TAC (← q r"(\(n:num). (fs:num->A->real) n x) = (\n. fs n y)") THEN
     REWRITE_TAC [FUN_EQ_THM] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"n:num")) THEN
     ASM_REAL_ARITH_TAC,
     DISCH_THEN SUBST1_TAC THEN REFL_TAC])

  let METRIZABLE_PRODUCT_EUCLIDEANREAL_NUM ← prove
   r"metrizable_space (product_topology (:num) (\n. euclideanreal))"
   (REWRITE_TAC [METRIZABLE_SPACE_PRODUCT_TOPOLOGY] THEN
    DISJ2_TAC THEN CONJ_TAC THENL
    [MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC (← q r"(:num)") THEN
     REWRITE_TAC [NUM_COUNTABLE, SUBSET_UNIV],
     GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [METRIZABLE_SPACE_EUCLIDEANREAL]])

  return { EMBEDDING_INTO_METRIZABLE_IMP_METRIZABLE, SEPARATING_FUNCTIONS_INJECTIVE,
           METRIZABLE_PRODUCT_EUCLIDEANREAL_NUM }

/- ------------------------------------------------------------------------- -/
/- Urysohn metrization.  (metric.ml 38558-38898)                             -/
