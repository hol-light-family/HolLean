        REWRITE_TAC [OPEN_IN_TOPSPACE, TOPSPACE_CANTOR_SPACE, IN_UNIV],
        DISCH_THEN (X_CHOOSE_THEN (← q r"h0:(num->bool)->(A->bool)")
          STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"h0:(num->bool)->(A->bool)") THEN ASM_REWRITE_TAC []])
    let TOWER_CONSTRUCTION_STEP ← prove
