        ASSUME_TAC THENL
         [REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
          EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"{y:A}") THEN
          REWRITE_TAC [CONNECTED_IN_SING, TOPSPACE_MTOPOLOGY,
                       MBOUNDED_INSERT, MBOUNDED_EMPTY, IN_SING] THEN
          SUBGOAL_THEN (← q r"(y:A) IN mspace m") ASSUME_TAC THENL
           [ASM_MESON_TAC [SUBSET, SUBSET_TRANS], ALL_TAC] THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [REWRITE_TAC [SING_SUBSET, IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
            EXISTS_TAC (← q r"(t:num->A->bool) (SUC k)") THEN
            CONJ_TAC THENL [ASM_MESON_TAC [], ASM SET_TAC []], ALL_TAC] THEN
          CONJ_TAC THENL [ASM_SIMP_TAC [MDIAMETER_SING] THEN ASM_REAL_ARITH_TAC,
            ASM SET_TAC []], ALL_TAC] THEN SUBGOAL_THEN
         (← q r"(q:(A->bool)->(A->bool)) w SUBSET
          UNIONS {(t:num->A->bool) k | k IN (:num)}")
        ASSUME_TAC THENL [EXPAND_TAC "q" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"z:A") THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"c0:A->bool") STRIP_ASSUME_TAC) THEN
          ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(q:(A->bool)->(A->bool)) w SUBSET mspace m") ASSUME_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"UNIONS {(t:num->A->bool) k | k IN (:num)}") THEN
          ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
          ASM_MESON_TAC [SUBSET_TRANS], ALL_TAC] THEN
        CONJ_TAC THENL [REWRITE_TAC [CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF] THEN
          ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
          SUBGOAL_THEN (← q r"?b:A. b IN w") STRIP_ASSUME_TAC THENL
           [ASM SET_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC (← MESON [CONNECTED_COMPONENT_OF_SYM,
                                 CONNECTED_COMPONENT_OF_TRANS] (← q
           r"!a0:A. (!x0:A. x0 IN s0 ==> connected_component_of top0 a0 x0)
                ==> (!x0 y0. x0 IN s0 /\ y0 IN s0
                            ==> connected_component_of top0 x0 y0)")) THEN
          EXISTS_TAC (← q r"b:A") THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN SUBGOAL_THEN
           (← q r"?c:A->bool. connected_in (mtopology m) c /\
            c SUBSET UNIONS {(t:num->A->bool) k | k IN (:num)} /\
            mbounded m c /\ mdiameter m c < e / &4 /\
            ~((w:A->bool) INTER c = {}) /\ x:A IN c") STRIP_ASSUME_TAC THENL
           [UNDISCH_TAC (← q r"x:A IN (q:(A->bool)->(A->bool)) w") THEN
            EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
          REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
          EXISTS_TAC (← q r"w UNION c:A->bool") THEN CONJ_TAC THENL [CONJ_TAC THENL
             [MATCH_MP_TAC CONNECTED_IN_UNION THEN ASM_REWRITE_TAC [] THEN
              ASM SET_TAC [], REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
               [ASM_MESON_TAC [],
                REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
                EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM] THEN
                EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC []]],
            ASM_REWRITE_TAC [IN_UNION]], ALL_TAC] THEN
        CONJ_TAC THENL [/- mbounded m (q w) -/
          MATCH_MP_TAC MBOUNDED_SUBSET THEN EXISTS_TAC (← q r"mball m (a:A, &2 * r)") THEN
          REWRITE_TAC [MBOUNDED_MBALL] THEN
          TRANS_TAC SUBSET_TRANS (← q r"UNIONS {(t:num->A->bool) k | k IN (:num)}") THEN
          ASM_REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, IN_UNIV] THEN
          ASM_MESON_TAC [], /- mdiameter m (q w) <= e -/
          MATCH_MP_TAC MDIAMETER_LE THEN ASM_REWRITE_TAC [] THEN
          CONJ_TAC THENL [DISJ2_TAC THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          MAP_EVERY X_GEN_TAC [← q r"p1:A", ← q r"p2:A"] THEN STRIP_TAC THEN SUBGOAL_THEN
           (← q r"?c1:A->bool. connected_in (mtopology m) c1 /\
            c1 SUBSET UNIONS {(t:num->A->bool) k | k IN (:num)} /\
            mbounded m c1 /\ mdiameter m c1 < e / &4 /\
            ~((w:A->bool) INTER c1 = {}) /\ p1:A IN c1") STRIP_ASSUME_TAC THENL
           [UNDISCH_TAC (← q r"p1:A IN (q:(A->bool)->(A->bool)) w") THEN
            EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"?c2:A->bool. connected_in (mtopology m) c2 /\
            c2 SUBSET UNIONS {(t:num->A->bool) k | k IN (:num)} /\
            mbounded m c2 /\ mdiameter m c2 < e / &4 /\
            ~((w:A->bool) INTER c2 = {}) /\ p2:A IN c2") STRIP_ASSUME_TAC THENL
           [UNDISCH_TAC (← q r"p2:A IN (q:(A->bool)->(A->bool)) w") THEN
            EXPAND_TAC "q" THEN REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
          SUBGOAL_THEN
            (← q r"(?z1:A. z1 IN w /\ z1 IN c1) /\ (?z2:A. z2 IN w /\ z2 IN c2)")
            STRIP_ASSUME_TAC THENL [CONJ_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN
           (← q r"p1:A IN mspace m /\ p2 IN mspace m /\ z1 IN mspace m /\ z2 IN mspace m")
          STRIP_ASSUME_TAC THENL
           [ASM_MESON_TAC [SUBSET, SUBSET_TRANS], ALL_TAC] THEN SUBGOAL_THEN
           (← q r"mdist m (p1:A, p2) <= mdist m (p1, z1) + mdist m (z1, p2) /\
            mdist m (z1:A, p2) <= mdist m (z1, z2) + mdist m (z2, p2)")
          STRIP_ASSUME_TAC THENL
           [CONJ_TAC THEN MATCH_MP_TAC MDIST_TRIANGLE THEN ASM_REWRITE_TAC [],
            ALL_TAC] THEN SUBGOAL_THEN (← q r"mdist m (p1:A, z1) <= mdiameter m c1 /\
            mdist m (z1:A, z2) <= mdiameter m w /\
            mdist m (z2:A, p2) <= mdiameter m c2") STRIP_ASSUME_TAC THENL
           [REPEAT CONJ_TAC THEN MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN
            ASM_REWRITE_TAC [], ALL_TAC] THEN
          SUBGOAL_THEN (← q r"mdiameter m (w:A->bool) < e / &4") ASSUME_TAC THENL
           [TRANS_TAC REAL_LET_TRANS (← q r"r / &2 pow (k + 2)") THEN
            ASM_REWRITE_TAC [] THEN TRANS_TAC REAL_LT_TRANS (← q r"r / &2 pow k") THEN
            ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LT_DIV_POW2 THEN
            ASM_REWRITE_TAC [] THEN ARITH_TAC, ALL_TAC] THEN ASM_REAL_ARITH_TAC]])

  return { LOCALLY_FCCOVERABLE_SPACE_CHAIN }

/- ------------------------------------------------------------------------- -/
/- Local fccoverability.  (metric.ml 35384-35555)                            -/
/- ------------------------------------------------------------------------- -/

structure LFC2 where
  FCCOVERABLE_IN_COMPACT_LOCALLY_CONNECTED : thm
  LOCALLY_FCCOVERABLE_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupLFC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricHaus : MetricHaus)
    (BConnected1 : Connected1) (BNbhdBase : NbhdBase) (BLocCompact1 : LocCompact1)
    (BLC1 : LC1) (BDIAM3 : DIAM3) (BULC1 : ULC1) (BULC3 : ULC3) (BFCC2 : FCC2)
    (BLFC1 : LFC1) : ExceptT String IO LFC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } :=
    D
  let { EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { INTER_COMM, INTER_SUBSET, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
    D.core2
  let { REAL_LE_TRANS, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, UNIONS_IMAGE, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_RESTRICT, TOPSPACE_SUBTOPOLOGY,
        .. } := BSubtopology
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, compact_in,
        .. } := BCompact1
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { IN_MBALL, MDIST_REFL, SUBMETRIC, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, MBALL_SUBSET_MCBALL, MCBALL_SUBSET_MBALL_CONCENTRIC,
        MTOPOLOGY_SUBMETRIC, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } :=
    BMTopology
  let { MBOUNDED_MBALL, MBOUNDED_SUBMETRIC, MBOUNDED_SUBSET, .. } := BBounded
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE, .. } := BLocCompact1
  let { LOCALLY_CONNECTED_SPACE_ALT, .. } := BLC1
  let { MDIAMETER_SUBMETRIC, .. } := BDIAM3
  let { fccoverable_in, fccoverable_space, .. } := BULC1
  let { MDIAMETER_SUBSET_MBALL, .. } := BULC3
  let { COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE, .. } := BFCC2
  let { LOCALLY_FCCOVERABLE_SPACE_CHAIN, .. } := BLFC1
  -- @@SCOPE END

  -- Helper: compact + locally connected implies fccoverable_in
  let FCCOVERABLE_IN_COMPACT_LOCALLY_CONNECTED ← prove
   r"!m:A metric K.
        compact_in (mtopology m) K /\
        locally_connected_space (subtopology (mtopology m) K)
        ==> fccoverable_in m K"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(K:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [compact_in, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    ASM_REWRITE_TAC [fccoverable_in] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← ISPEC (← q r"submetric m (K:A->bool)")
      COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE) THEN ANTS_TAC THENL
     [REWRITE_TAC [MTOPOLOGY_SUBMETRIC, SUBMETRIC] THEN ASM_SIMP_TAC [← SET_RULE (← q
        r"(K:A->bool) SUBSET s ==> K INTER s = K")] THEN
      ASM_REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, SUBSET_REFL], ALL_TAC] THEN
    REWRITE_TAC [fccoverable_space, SUBMETRIC, MTOPOLOGY_SUBMETRIC] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"(K:A->bool) SUBSET s ==> K INTER s = K")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:(A->bool)->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(t:A->bool) SUBSET K") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, MBOUNDED_SUBMETRIC] THEN
    ASM_SIMP_TAC [← SET_RULE (← q
      r"(t:A->bool) SUBSET K ==> K INTER t = t")] THEN STRIP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [MDIAMETER_SUBMETRIC]) THEN ASM_REWRITE_TAC [])

  let LOCALLY_FCCOVERABLE_SPACE ← prove
   r"!m:A metric s u a.
     locally_compact_space (subtopology (mtopology m) s) /\
     locally_connected_space (subtopology (mtopology m) s) /\
     open_in (subtopology (mtopology m) s) u /\ a IN u
     ==> ?v. open_in (subtopology (mtopology m) s) v /\
             connected_in (subtopology (mtopology m) s) v /\
             a IN v /\ v SUBSET u /\ fccoverable_in m v"
   (REPEAT GEN_TAC THEN
    /- Reduce to s SUBSET mspace m using SUBTOPOLOGY_RESTRICT -/
    ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
    SUBGOAL_THEN (← q r"mspace m INTER (s:A->bool) SUBSET mspace m")
    MP_TAC THENL [SET_TAC [], ALL_TAC] THEN
    SPEC_TAC (← q r"mspace m INTER (s:A->bool)", ← q r"s:A->bool") THEN
    X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN STRIP_TAC THEN
    /- Step 1: Basic facts -/
    SUBGOAL_THEN (← q r"(a:A) IN s /\ (a:A) IN mspace m") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, TOPSPACE_SUBTOPOLOGY,
        TOPSPACE_MTOPOLOGY, SUBSET, IN_INTER], ALL_TAC] THEN
    /- Step 2: Get r > 0 with s INTER mcball(a,2r) compact and SUBSET u -/
    SUBGOAL_THEN (← q r"?r. &0 < r /\
           compact_in (mtopology m) (s INTER mcball m (a:A, &2 * r)) /\
           s INTER mcball m (a, &2 * r) SUBSET u")
      (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THENL
     [/- Use locally_compact neighbourhood base to get compact K, open V -/
      MP_TAC (← ISPEC (← q r"subtopology (mtopology m) (s:A->bool)")
        LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE) THEN ANTS_TAC THENL
       [DISJ1_TAC THEN MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
        REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY], ALL_TAC] THEN
      ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"a:A"]) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V:A->bool")
        (X_CHOOSE_THEN (← q r"K:A->bool") STRIP_ASSUME_TAC)) THEN
      /- K compact in mtopology, K SUBSET s -/
      SUBGOAL_THEN (← q r"compact_in (mtopology m) (K:A->bool) /\ K SUBSET s")
        STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [COMPACT_IN_SUBTOPOLOGY], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(K:A->bool) SUBSET mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [compact_in, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
      /- V open in subtop s, get W open in mtopology with V = W INTER s -/
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_SUBTOPOLOGY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"W:A->bool") STRIP_ASSUME_TAC) THEN
      /- Get e > 0 with mball(a,e) SUBSET W -/
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"W:A->bool"] OPEN_IN_MTOPOLOGY) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:A"))) THEN
      ANTS_TAC THENL [UNDISCH_TAC (← q r"(a:A) IN V") THEN ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN /- Take r = e/3 -/
      EXISTS_TAC (← q r"e / &3") THEN CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      /- s INTER mcball(a, 2e/3) SUBSET K SUBSET u -/
      SUBGOAL_THEN (← q r"mcball m (a:A, &2 * (e / &3)) SUBSET mball m (a,e)")
      ASSUME_TAC THENL [MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN
        ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"s INTER mcball m (a:A, &2 * (e / &3)) SUBSET K")
      ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [/- compact: closed subset of compact K -/
        SUBGOAL_THEN (← q r"compact_in (subtopology (mtopology m) K)
                       (s INTER mcball m (a:A, &2 * (e / &3)))")
        MP_TAC THENL [MATCH_MP_TAC (← ISPEC (← q r"subtopology (mtopology m) (K:A->bool)")
            CLOSED_IN_COMPACT_SPACE) THEN CONJ_TAC THENL
           [ASM_MESON_TAC [COMPACT_SPACE_SUBTOPOLOGY], ALL_TAC] THEN
          REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN
          EXISTS_TAC (← q r"mcball m (a:A, &2 * (e / &3))") THEN
          REWRITE_TAC [CLOSED_IN_MCBALL] THEN ASM SET_TAC [],
          SIMP_TAC [COMPACT_IN_SUBTOPOLOGY]], /- SUBSET u -/
        ASM SET_TAC []], ALL_TAC] THEN /- Apply LOCALLY_FCCOVERABLE_SPACE_CHAIN -/
    MATCH_MP_TAC LOCALLY_FCCOVERABLE_SPACE_CHAIN THEN
    EXISTS_TAC (← q r"r:real") THEN ASM_REWRITE_TAC [] THEN
    /- Prove cover hypothesis from locally_connected + compactness -/
    X_GEN_TAC (← q r"e0:real") THEN DISCH_TAC THEN
    /- For each x in s, get connected neighborhood of size e0/2 -/ MP_TAC (← ASSUME
      (← q r"locally_connected_space (subtopology (mtopology m) (s:A->bool))")) THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_ALT, NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_TAC THEN SUBGOAL_THEN (← q r"!x:A. x IN s
             ==> ?u' v. open_in (subtopology (mtopology m) s) u' /\
                        connected_in (subtopology (mtopology m) s) v /\
                        x IN u' /\ u' SUBSET v /\
                        v SUBSET s INTER mball m (x, e0 / &2)")
      MP_TAC THENL [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
        [← q r"s INTER mball m (x:A, e0 / &2)", ← q r"x:A"]) THEN ANTS_TAC THENL
       [CONJ_TAC THENL [REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
          EXISTS_TAC (← q r"mball m (x:A, e0 / &2)") THEN
          REWRITE_TAC [OPEN_IN_MBALL, INTER_COMM], ALL_TAC] THEN
        REWRITE_TAC [IN_INTER, IN_MBALL] THEN
        SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        ASM_SIMP_TAC [MDIST_REFL] THEN ASM_REAL_ARITH_TAC,
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SIMP_TAC []],
      ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o REDEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"uf:A->A->bool", ← q r"vf:A->A->bool"] THEN DISCH_TAC THEN
    /- Apply compactness of s INTER mcball(a, 2r) -/ SUBGOAL_THEN
      (← q r"compact_in (subtopology (mtopology m) s) (s INTER mcball m (a:A, &2 * r))")
    MP_TAC THENL [REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
      ASM_REWRITE_TAC [INTER_SUBSET], ALL_TAC] THEN
    GEN_REWRITE_TAC LAND_CONV [compact_in] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
    SUBGOAL_THEN (← q r"mspace m INTER (s:A->bool) = s")
      (fun th => REWRITE_TAC [th]) THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC
        (← q r"IMAGE (uf:A->A->bool) (s INTER mcball m (a:A, &2 * r))"))) THEN
    ANTS_TAC THENL [CONJ_TAC THENL [REWRITE_TAC [FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_INTER] THEN
        STRIP_TAC THEN ASM_MESON_TAC [],
        REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_ELIM_THM, IN_INTER] THEN
        X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [IN_INTER] THEN ASM_MESON_TAC []],
      ALL_TAC] THEN REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"pts:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (vf:A->A->bool) pts") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN CONJ_TAC THENL
     [/- Properties of each piece -/
      REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN s") ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"connected_in (subtopology (mtopology m) s) ((vf:A->A->bool) x) /\
         vf x SUBSET s INTER mball m (x:A, e0 / &2)")
      STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      REPEAT CONJ_TAC THENL [ASM SET_TAC [],
        ASM_MESON_TAC [CONNECTED_IN_SUBTOPOLOGY],
        MATCH_MP_TAC MBOUNDED_SUBSET THEN
        EXISTS_TAC (← q r"mball m (x:A, e0 / &2)") THEN
        REWRITE_TAC [MBOUNDED_MBALL] THEN ASM SET_TAC [],
        TRANS_TAC REAL_LE_TRANS (← q r"&2 * (e0 / &2)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC MDIAMETER_SUBSET_MBALL THEN
          ASM_MESON_TAC [← REAL_ARITH (← q r"&0 < e ==> &0 < e / &2"),
                         SUBSET, INTER_SUBSET, SUBSET_TRANS], REAL_ARITH_TAC]],
      /- Coverage of s INTER mball(a, 2r) -/ X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      /- x IN s INTER mcball(a,2r) since mball SUBSET mcball -/
      SUBGOAL_THEN (← q r"(x:A) IN s INTER mcball m (a:A, &2 * r)") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [IN_INTER] THEN
        ASM_MESON_TAC [MBALL_SUBSET_MCBALL, SUBSET], ALL_TAC] THEN
      /- x is covered by UNIONS(IMAGE uf pts) -/
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS(IMAGE (uf:A->A->bool) pts)") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM]] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(vf:A->A->bool) y") THEN ASM_REWRITE_TAC [FUN_IN_IMAGE] THEN
      SUBGOAL_THEN (← q r"(y:A) IN s") ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(uf:A->A->bool) y SUBSET (vf:A->A->bool) y")
      MP_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN ASM SET_TAC []])

  return { FCCOVERABLE_IN_COMPACT_LOCALLY_CONNECTED, LOCALLY_FCCOVERABLE_SPACE }

/- ------------------------------------------------------------------------- -/
/- Locally connected continua; finitely many components.                     -/
/- (metric.ml 35557-35726)                                                    -/
/- ------------------------------------------------------------------------- -/

structure LCC where
  LOCALLY_CONNECTED_CONTINUUM_SPACE : thm
  COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE_ALT : thm
  FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED : thm
  deriving Inhabited

@[nospecialize]
def setupLCC [HolBase] (D : MetricDeps) (BClosure : Closure) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricHaus : MetricHaus) (BConnected1 : Connected1) (BConnected2 : Connected2)
    (BComponents1 : Components1) (BComponents2 : Components2) (BNbhdBase : NbhdBase)
    (BLocCompact1 : LocCompact1) (BLC1 : LC1) (BULC1 : ULC1) (BULC3 : ULC3) (BFCC2 : FCC2)
    (BLFC2 : LFC2) : ExceptT String IO LCC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, .. } := D
  let { EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_ELIM_THM, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_TRANS, UNIONS_IMAGE,
        UNIONS_SUBSET, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CLOSED_COMPACT_IN, COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_ALT, compact_in, compact_space,
        .. } := BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { CENTRE_IN_MBALL, MBALL_SUBSET_MSPACE, .. } := BMetricSpace
  let { OPEN_IN_MBALL, SUBTOPOLOGY_MSPACE, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_CLOSURE_OF, .. } := BConnected2
  let { CONNECTED_COMPONENTS_OF_SUBSET, NONEMPTY_CONNECTED_COMPONENTS_OF,
        UNIONS_CONNECTED_COMPONENTS_OF, .. } := BComponents1
  let { CONNECTED_COMPONENTS_OF_OVERLAP, .. } := BComponents2
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, .. } := BNbhdBase
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE, .. } :=
    BLocCompact1
  let { OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE, locally_connected_space, .. } :=
    BLC1
  let { fccoverable_in, .. } := BULC1
  let { FCCOVERABLE_IN_IMP_LOCALLY_CONNECTED_SPACE, FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE,
        MDIAMETER_SUBSET_MBALL, .. } := BULC3
  let { COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE, .. } := BFCC2
  let { LOCALLY_FCCOVERABLE_SPACE, .. } := BLFC2
  -- @@SCOPE END

  let LOCALLY_CONNECTED_CONTINUUM_SPACE ← prove
   r"!m:A metric s.
       neighbourhood_base_of
        (\c. compact_in (subtopology (mtopology m) s) c /\
             connected_in (subtopology (mtopology m) s) c /\
             locally_connected_space (subtopology (mtopology m) c))
        (subtopology (mtopology m) s) <=>
     locally_compact_space (subtopology (mtopology m) s) /\
     locally_connected_space (subtopology (mtopology m) s)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [/- => direction: extract locally_compact and locally_connected -/
      STRIP_TAC THEN CONJ_TAC THENL
       [MP_TAC (← ISPEC (← q r"subtopology (mtopology m) (s:A->bool)")
          LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE) THEN
        ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_MTOPOLOGY] THEN
        DISCH_THEN (fun th => REWRITE_TAC [th]),
        REWRITE_TAC [locally_connected_space]] THEN
      FIRST_ASSUM (fun th => tactic_of do pure (MATCH_MP_TAC (← MATCH_MP
        (← REWRITE_RULE [IMP_CONJ_ALT] NEIGHBOURHOOD_BASE_OF_MONO) th))) THEN
      SIMP_TAC [], /- <= direction -/
      STRIP_TAC THEN GEN_REWRITE_TAC id [NEIGHBOURHOOD_BASE_OF] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN SUBGOAL_THEN
        (← q r"?v k:A->bool. open_in (subtopology (mtopology m) s) v /\
                        compact_in (subtopology (mtopology m) s) k /\
                        x IN v /\ v SUBSET k /\ k SUBSET w")
        STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPEC (← q r"subtopology (mtopology m) (s:A->bool)")
          LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE) THEN ANTS_TAC THENL
         [ASM_MESON_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_MTOPOLOGY],
          ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"w:A->bool", ← q r"x:A"]) THEN
          ASM_REWRITE_TAC [] THEN
          REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SIMP_TAC []],
        ALL_TAC] THEN MP_TAC (← ISPECL
       [← q r"m:A metric", ← q r"s:A->bool", ← q r"v:A->bool", ← q r"x:A"]
       LOCALLY_FCCOVERABLE_SPACE) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w':A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w':A->bool") THEN
      EXISTS_TAC (← q r"mtopology m closure_of w':A->bool") THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN
       (← q r"compact_in (mtopology m) (k:A->bool) /\ (k:A->bool) SUBSET s /\
        (w':A->bool) SUBSET mspace m") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [COMPACT_IN_SUBTOPOLOGY, fccoverable_in], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(mtopology m closure_of w':A->bool) SUBSET k")
        ASSUME_TAC THENL [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN CONJ_TAC THENL
         [ASM SET_TAC [], MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN
          ASM_REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY]], ALL_TAC] THEN
      CONJ_TAC THENL [REPEAT CONJ_TAC THENL
         [REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
           [MATCH_MP_TAC CLOSED_COMPACT_IN THEN EXISTS_TAC (← q r"k:A->bool") THEN
            ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF], ASM SET_TAC []],
          REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
           [MATCH_MP_TAC CONNECTED_IN_CLOSURE_OF THEN
            ASM_MESON_TAC [CONNECTED_IN_SUBTOPOLOGY], ASM SET_TAC []],
          MATCH_MP_TAC FCCOVERABLE_IN_IMP_LOCALLY_CONNECTED_SPACE THEN
          MP_TAC (← ISPECL
           [← q r"m:A metric", ← q r"w':A->bool", ← q r"mtopology m closure_of w':A->bool"]
           FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE) THEN
          DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
          MATCH_MP_TAC CLOSURE_OF_SUBSET THEN
          ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY]], CONJ_TAC THENL
         [MATCH_MP_TAC CLOSURE_OF_SUBSET THEN
          ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY], ASM SET_TAC []]]])

  let COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE_ALT ← prove
   r"!m:A metric.
        compact_in (mtopology m) (mspace m) /\
        locally_connected_space (mtopology m) <=>
        (!e. &0 < e
             ==> ?c. FINITE c /\ UNIONS c = mspace m /\
                     !t. t IN c
                         ==> connected_in (mtopology m) t /\
                             compact_in (mtopology m) t /\
                             locally_connected_space
                               (subtopology (mtopology m) t) /\
                             mdiameter m t <= e)"
   (GEN_TAC THEN EQ_TAC THENL
     [/- Forward direction - use LOCALLY_CONNECTED_CONTINUUM_SPACE + compactness -/
      STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      /- Get neighbourhood base from LOCALLY_CONNECTED_CONTINUUM_SPACE -/
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"mspace m:A->bool"]
        LOCALLY_CONNECTED_CONTINUUM_SPACE) THEN REWRITE_TAC [SUBTOPOLOGY_MSPACE] THEN
      DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2)) THEN ANTS_TAC THENL
       [CONJ_TAC THENL [MATCH_MP_TAC COMPACT_IMP_LOCALLY_COMPACT_SPACE THEN
          ASM_REWRITE_TAC [compact_space, TOPSPACE_MTOPOLOGY], ASM_REWRITE_TAC []],
        ALL_TAC] THEN REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN DISCH_TAC THEN
      /- For each x, get P-set in mball(x, e/2) -/
      SUBGOAL_THEN (← q r"!x:A. x IN mspace m ==> ?u v. open_in (mtopology m) u /\
                          compact_in (mtopology m) v /\
                          connected_in (mtopology m) v /\ locally_connected_space
                            (subtopology (mtopology m) v) /\
                          x IN u /\ u SUBSET v /\ v SUBSET mball m (x, e / &2)")
        MP_TAC THENL [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"mball m (x:A, e / &2)", ← q r"x:A"]) THEN
        ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL, REAL_HALF] THEN
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SIMP_TAC [],
        ALL_TAC] THEN
      GEN_REWRITE_TAC (LAND_CONV o REDEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"uf:A->A->bool", ← q r"vf:A->A->bool"] THEN DISCH_TAC THEN
      /- Apply compactness to the open cover {uf(x) | x in mspace m} -/
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
      REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"IMAGE (uf:A->A->bool) (mspace m)"))) THEN ANTS_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE, SUBSET, UNIONS_IMAGE, IN_ELIM_THM] THEN
        ASM_MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"pts:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (vf:A->A->bool) pts") THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      /- Extract useful facts for x in pts -/ SUBGOAL_THEN (← q r"!x:A. x IN pts
               ==> compact_in (mtopology m) ((vf:A->A->bool) x) /\
                   connected_in (mtopology m) (vf x) /\
                   locally_connected_space (subtopology (mtopology m) (vf x)) /\
                   vf x SUBSET mball m (x, e / &2) /\ uf x SUBSET vf x")
        ASSUME_TAC THENL [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
         [ASM SET_TAC [], ASM_MESON_TAC []], ALL_TAC] THEN
      CONJ_TAC THENL [/- UNIONS(IMAGE vf pts) = mspace m -/
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
          ASM_MESON_TAC [SUBSET_TRANS, MBALL_SUBSET_MSPACE],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
            (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
          REWRITE_TAC [UNIONS_IMAGE, SUBSET, IN_ELIM_THM] THEN
          ASM_MESON_TAC [SUBSET]], /- Properties of each piece -/
        REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        REPEAT CONJ_TAC THEN TRY (ASM_MESON_TAC []) THEN
        /- mdiameter m (vf x) <= e -/
        MATCH_MP_TAC (← REAL_ARITH (← q r"x <= &2 * (e / &2) ==> x <= e")) THEN
        MATCH_MP_TAC MDIAMETER_SUBSET_MBALL THEN
        ASM_MESON_TAC [REAL_HALF, SUBSET]],
      /- Backward direction - drop locally_connected_space condition -/
      REWRITE_TAC [COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE] THEN
      MESON_TAC []])

  -- Compact locally connected spaces have finitely many connected components

  let FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED ← prove
   r"!m:A metric.
        compact_in (mtopology m) (mspace m) /\
        locally_connected_space (mtopology m)
        ==> FINITE(connected_components_of(mtopology m))"
   (GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact_space(mtopology m:A topology)") MP_TAC THENL
     [ASM_REWRITE_TAC [compact_space, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    REWRITE_TAC [COMPACT_SPACE_ALT, TOPSPACE_MTOPOLOGY] THEN DISCH_THEN (MP_TAC o
      SPEC (← q r"connected_components_of(mtopology m:A topology)")) THEN ANTS_TAC THENL
     [CONJ_TAC THENL [GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC
          OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE THEN
        ASM_REWRITE_TAC [], REWRITE_TAC [UNIONS_CONNECTED_COMPONENTS_OF,
                     TOPSPACE_MTOPOLOGY, SUBSET_REFL]], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"V:(A->bool)->bool") THEN
    ASM_REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"x:A")) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN UNIONS V") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [IN_UNIONS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"d IN connected_components_of(mtopology m:A topology)")
      ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"c:A->bool = d") (fun th => ASM_REWRITE_TAC [th]) THEN
    MP_TAC (← ISPECL [← q r"mtopology m:A topology", ← q r"c:A->bool", ← q r"d:A->bool"]
      CONNECTED_COMPONENTS_OF_OVERLAP) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN ASM SET_TAC [])

  return { LOCALLY_CONNECTED_CONTINUUM_SPACE,
           COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE_ALT,
           FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Semi-locally connected spaces (finitely many components in complements).  -/
/- Whyburn, Analytic Topology, Ch. I Sec. 13.                               -/
/- (metric.ml 35728-35828)                                                    -/
/- ------------------------------------------------------------------------- -/

structure SLC1 where
  FINITE_CONNECTED_COMPONENTS_CLOPEN_UNION : thm
  deriving Inhabited

@[nospecialize]
def setupSLC1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BConnected1 : Connected1) (BConnected3 : Connected3) (BComponents1 : Components1) :
    ExceptT String IO SLC1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { FINITE_SUBSET, FINITE_UNION, .. } := D.core1
  let { IN, IN_ELIM_THM, IN_UNION, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM, .. } := D.core4
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_SUBTOPOLOGY, connected_in, .. } := BConnected1
  let { CONNECTED_IN_CLOPEN_CASES, .. } := BConnected3
  let { CONNECTED_COMPONENTS_OF_MAXIMAL, CONNECTED_COMPONENTS_OF_SUBSET,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, NONEMPTY_CONNECTED_COMPONENTS_OF,
        connected_component_of, connected_components_of, .. } := BComponents1
  -- @@SCOPE END

  -- Helper lemma for SEMI_LOCALLY_CONNECTED_GEN_SPACE finiteness argument
  let FINITE_CONNECTED_COMPONENTS_CLOPEN_UNION ← prove
   r"!top C s:A->bool.
        locally_connected_space top /\
        open_in top C /\ closed_in top C /\ C SUBSET topspace top /\
        s SUBSET C /\ FINITE(connected_components_of top) /\
        FINITE(connected_components_of (subtopology top (C DIFF s)))
        ==> FINITE(connected_components_of
                    (subtopology top (topspace top DIFF s)))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC (← q r"connected_components_of(subtopology top (C DIFF s)) UNION
                {d:A->bool | d IN connected_components_of top /\
                 DISJOINT d C}") THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [FINITE_UNION] THEN MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"connected_components_of (top:A topology)") THEN
      ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"connected_in (top:A topology) c") ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_CONNECTED_COMPONENTS_OF) THEN
      REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN MESON_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"x:A")) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool", ← q r"C:A->bool"]
      CONNECTED_IN_CLOPEN_CASES) THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
     [/- Case 1: c SUBSET C -/ DISJ1_TAC THEN
      /- c SUBSET C, c SUBSET topspace\s DIFF s => c SUBSET C DIFF s -/
      SUBGOAL_THEN (← q r"(c:A->bool) SUBSET C DIFF s") ASSUME_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [], ALL_TAC] THEN
      /- c is connected in subtopology top (C DIFF s) -/
      SUBGOAL_THEN (← q r"connected_in (subtopology top (C DIFF s)) (c:A->bool)")
        ASSUME_TAC THENL [ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY],
        ALL_TAC] THEN /- c is maximal in subtopology top (C DIFF s) -/
      REWRITE_TAC [connected_components_of, IN_ELIM_THM] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"y:A")) THEN EXISTS_TAC (← q r"y:A") THEN
      SUBGOAL_THEN (← q r"(y:A) IN topspace top") ASSUME_TAC THENL
       [ASM_MESON_TAC [connected_in, SUBSET], ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN, connected_component_of] THEN
        X_GEN_TAC (← q r"z:A") THEN STRIP_TAC THEN
        /- z IN c; need connected_component_of ... y z -/
        /- Use the connected set c containing both y and z -/
        EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        /- connected_component_of (subtopology top (C DIFF s)) y SUBSET c -/
        REWRITE_TAC [SUBSET, IN, connected_component_of] THEN X_GEN_TAC (← q r"z:A") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
        /- Promote connected_in from C DIFF s to topspace top DIFF s -/
        SUBGOAL_THEN (← q r"connected_in (subtopology top (topspace top DIFF s))
                        (t:A->bool)") ASSUME_TAC THENL [FIRST_X_ASSUM (MP_TAC o
            GEN_REWRITE_RULE id [CONNECTED_IN_SUBTOPOLOGY]) THEN
          REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
        /- Now use maximality of connected component c -/
        MP_TAC (← ISPECL [← q r"subtopology top (topspace top DIFF s):A topology",
          ← q r"t:A->bool", ← q r"c:A->bool"]
         CONNECTED_COMPONENTS_OF_MAXIMAL) THEN ASM_REWRITE_TAC [] THEN
        ANTS_TAC THEN REWRITE_TAC [SUBSET, IN] THEN ASM SET_TAC []],
      /- Case 2: DISJOINT c C -/ DISJ2_TAC THEN
      /- Need: c IN connected_components_of top /\ DISJOINT c C -/
      /- We have DISJOINT c C, so just need c IN connected_components_of top -/
      ASM_REWRITE_TAC [] THEN /- Show c = connected_component_of top x -/
      REWRITE_TAC [connected_components_of, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"x:A") THEN /- First show x IN topspace top -/
      SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
       [ASM_MESON_TAC [connected_in, SUBSET], ALL_TAC] THEN ASM_REWRITE_TAC [] THEN
      /- Now show c = connected_component_of top x via SUBSET_ANTISYM -/
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [/- c SUBSET connected_component_of top x -/
        /- c is connected in top and contains x -/
        REWRITE_TAC [SUBSET, IN, connected_component_of] THEN
        X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
        /- connected_component_of top x SUBSET c -/
        /- Key: connected_component_of top x is disjoint -/
        /- from C (since C is clopen) -/
        /- Hence it's in topspace top DIFF s, so SUBSET c by maximality -/
        REWRITE_TAC [SUBSET, IN, connected_component_of] THEN X_GEN_TAC (← q r"z:A") THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
        /- t connected in subtopology top (topspace top DIFF s) via clopen case -/
        SUBGOAL_THEN
          (← q r"connected_in (subtopology top (topspace top DIFF s)) (t:A->bool)")
          ASSUME_TAC THENL [ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
          MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool", ← q r"C:A->bool"]
            CONNECTED_IN_CLOPEN_CASES) THEN ASM_REWRITE_TAC [] THEN
          FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
          ASM SET_TAC [], ALL_TAC] THEN
        /- Use maximality of c: t is connected, contains x IN c, so t SUBSET c -/
        MP_TAC (← ISPECL [← q r"subtopology top (topspace top DIFF s):A topology",
          ← q r"t:A->bool", ← q r"c:A->bool"]
         CONNECTED_COMPONENTS_OF_MAXIMAL) THEN ASM_REWRITE_TAC [] THEN
        ANTS_TAC THEN REWRITE_TAC [SUBSET, IN] THEN ASM SET_TAC []]])

  return { FINITE_CONNECTED_COMPONENTS_CLOPEN_UNION }

/- ------------------------------------------------------------------------- -/
/- Semi-local connectedness for connected spaces.  (metric.ml 35829-36094)  -/
/- ------------------------------------------------------------------------- -/

structure SLC2 where
  SEMI_LOCALLY_CONNECTED_CONNECTED : thm
  deriving Inhabited

@[nospecialize]
def setupSLC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BCompact1 : Compact1) (BMTopology : MTopology)
    (BMetricHaus : MetricHaus) (BConnected1 : Connected1) (BConnected2 : Connected2)
    (BComponents1 : Components1) (BNbhdBase : NbhdBase) (BLocCompact2 : LocCompact2)
    (BLC1 : LC1) : ExceptT String IO SLC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IN, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNION, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, UNIONS_IMAGE, UNIONS_SUBSET,
        UNION_SUBSET, .. } := D.core4
  let { DE_MORGAN_THM, NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_TOPSPACE, CLOSED_IN_UNION, CLOSED_IN_UNIONS,
        OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_TRANS_FULL, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_TOPSPACE, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := BClosure
  let { CLOSED_COMPACT_IN, COMPACT_IN_SUBSET_TOPSPACE, compact_in, .. } := BCompact1
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_TOPSPACE, CONNECTED_SPACE_CLOPEN_IN, .. } :=
    BConnected1
  let { CONNECTED_IN_CLOSURE_OF, CONNECTED_IN_UNION, .. } := BConnected2
  let { CONNECTED_COMPONENT_OF_EQ, CONNECTED_COMPONENT_OF_MAXIMAL, CONNECTED_COMPONENT_OF_REFL,
        CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE, CONNECTED_IN_CONNECTED_COMPONENT_OF,
        connected_components_of, .. } := BComponents1
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN, .. } := BLocCompact2
  let { LOCALLY_CONNECTED_SPACE, LOCALLY_CONNECTED_SPACE_OPEN_SUBSET,
        OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  -- @@SCOPE END

  -- Helper: Semi-local connectedness for connected spaces
  let SEMI_LOCALLY_CONNECTED_CONNECTED ← prove
   r"!m:A metric. connected_in (mtopology m) (mspace m) /\
     locally_compact_space (mtopology m) /\
     locally_connected_space (mtopology m)
     ==> !x v. open_in (mtopology m) v /\ x IN v
               ==> ?u. open_in (mtopology m) u /\ x IN u /\ u SUBSET v /\
                       FINITE(connected_components_of(subtopology (mtopology m)
                                                      (mspace m DIFF u)))"
   (REPEAT STRIP_TAC THEN ABBREV_TAC (← q r"top = mtopology m:A topology") THEN
    ABBREV_TAC (← q r"s = mspace m:A->bool") THEN
    SUBGOAL_THEN (← q r"topspace top = (s:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "top" THEN EXPAND_TAC "s" THEN REWRITE_TAC [TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"hausdorff_space (top:A topology)") ASSUME_TAC THENL
     [EXPAND_TAC "top" THEN REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY], ALL_TAC] THEN
    /- Step 1: Get two nested compact closed neighborhoods of x -/
    MP_TAC (← SPEC (← q r"top:A topology")
      LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN) THEN
    ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"v:A->bool", ← q r"x:A"]) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:A->bool")
      (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← SPEC (← q r"top:A topology")
      LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN) THEN
    ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"d:A->bool", ← q r"x:A"]) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u':A->bool")
      (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC)) THEN
    /- Establish basic subset relations -/
    SUBGOAL_THEN (← q r"c SUBSET (s:A->bool) /\ k SUBSET (s:A->bool)")
      STRIP_ASSUME_TAC THENL
     [CONJ_TAC THEN ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"open_in top (s DIFF k:A->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_MESON_TAC [OPEN_IN_TOPSPACE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c DIFF d:A->bool) SUBSET s DIFF k") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    /- Step 2: For each y in c DIFF d, get open connected -/
    /- neighborhood in s DIFF k -/ SUBGOAL_THEN (← q r"!y:A. y IN c DIFF d
             ==> ?t. open_in top t /\ connected_in top t /\
                     y IN t /\ t SUBSET s DIFF k")
      MP_TAC THENL [X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED_SPACE]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"s DIFF k:A->bool", ← q r"y:A"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"t:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV)
      [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->A->bool") STRIP_ASSUME_TAC) THEN
    /- Step 3: c DIFF d is compact, so finitely many t(y) cover it -/
    SUBGOAL_THEN (← q r"compact_in top (c DIFF d:A->bool)") MP_TAC THENL
     [MATCH_MP_TAC CLOSED_COMPACT_IN THEN EXISTS_TAC (← q r"c:A->bool") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [compact_in]] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC (← q r"IMAGE (t:A->A->bool) (c DIFF d)"))) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [REWRITE_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"q:A->bool") STRIP_ASSUME_TAC) THEN
    /- Step 4: Define r and the final u -/ ABBREV_TAC (← q r"r = (s DIFF d) UNION
           UNIONS(IMAGE (\y. s INTER top closure_of ((t:A->A->bool) y)) q)") THEN
    EXISTS_TAC (← q r"s DIFF r:A->bool") THEN /- Show r SUBSET s -/
    SUBGOAL_THEN (← q r"(r:A->bool) SUBSET s") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN REWRITE_TAC [UNION_SUBSET] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN SET_TAC [], ALL_TAC] THEN
    /- Goal: open_in top (s DIFF r) /\ x IN (s DIFF r) -/
    /- /\ (s DIFF r) SUBSET v /\ FINITE(...) -/
    /- First conjunct: open_in top (s DIFF r) -/
    CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [OPEN_IN_TOPSPACE], ALL_TAC] THEN
      EXPAND_TAC "r" THEN MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"s DIFF d:A->bool = topspace top DIFF d") SUBST1_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      MATCH_MP_TAC CLOSED_IN_INTER THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"(s:A->bool) = topspace top") SUBST1_TAC THENL
         [ASM_MESON_TAC [], REWRITE_TAC [CLOSED_IN_TOPSPACE]],
        REWRITE_TAC [CLOSED_IN_CLOSURE_OF]], ALL_TAC] THEN
    /- Second conjunct: x IN s DIFF r -/
    CONJ_TAC THENL [ASM_REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN EXPAND_TAC "r" THEN
      REWRITE_TAC [IN_UNION, UNIONS_IMAGE, IN_DIFF, IN_ELIM_THM, IN_INTER,
                   DE_MORGAN_THM, NOT_EXISTS_THM] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [DE_MORGAN_THM] THEN
      ASM_CASES_TAC (← q r"(y:A) IN q") THEN ASM_REWRITE_TAC [] THEN
      /- Need: x NOTIN s INTER closure t(y) -/
      /- Use: t(y) SUBSET s DIFF k, and x IN u' SUBSET k -/
      SUBGOAL_THEN (← q r"top closure_of ((t:A->A->bool) y) SUBSET s DIFF u'")
        MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
      SUBGOAL_THEN (← q r"s DIFF u':A->bool = topspace top DIFF u'") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
      SUBGOAL_THEN (← q r"(y:A) IN c DIFF d") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A")) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
    /- Third conjunct: (s DIFF r) SUBSET v -/
    CONJ_TAC THENL [SUBGOAL_THEN (← q r"(s DIFF r:A->bool) SUBSET d") MP_TAC THENL
       [EXPAND_TAC "r" THEN SET_TAC [], ASM SET_TAC []], ALL_TAC] THEN
    /- Fourth conjunct: FINITE(connected_components_of -/
    /- (subtopology top (s DIFF (s DIFF r)))) -/
    /- Note: s DIFF (s DIFF r) = s INTER r = r when r SUBSET s -/
    SUBGOAL_THEN (← q r"s DIFF (s DIFF r):A->bool = r") SUBST1_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    /- Goal: FINITE(connected_components_of(subtopology top r)) -/
    SUBGOAL_THEN (← q r"connected_space (top:A topology)")
      ASSUME_TAC THENL
     [EXPAND_TAC "top" THEN
      ASM_REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE,
                       TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((c:A->bool) = {})") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    /- Pre-prove SUBSET facts while EXPAND_TAC "r" still works correctly -/
    SUBGOAL_THEN (← q r"s DIFF d SUBSET (r:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN SET_TAC [], ALL_TAC] THEN SUBGOAL_THEN
      (← q r"!w:A. w IN q ==> top closure_of ((t:A->A->bool) w) SUBSET r")
      ASSUME_TAC THENL [X_GEN_TAC (← q r"w:A") THEN DISCH_TAC THEN
      EXPAND_TAC "r" THEN REWRITE_TAC [SUBSET, IN_UNION] THEN
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN DISJ2_TAC THEN
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"w:A") THEN ASM_REWRITE_TAC [IN_INTER] THEN
      ASM_MESON_TAC [CLOSURE_OF_SUBSET_TOPSPACE, SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!z:A. z IN q ==> z IN r") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    /- Now bound components by IMAGE of q -/
    MATCH_MP_TAC FINITE_SUBSET THEN
    EXISTS_TAC
      (← q r"IMAGE (\z:A. connected_component_of (subtopology top r) z) q") THEN
    CONJ_TAC THENL [ASM_SIMP_TAC [FINITE_IMAGE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"topspace(subtopology top (r:A->bool)) = r") ASSUME_TAC THENL
     [REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [connected_components_of, SUBSET, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE] THEN
    /- Case: is y in some closure(t w) for w IN q? -/ ASM_CASES_TAC
      (← q r"?w:A. w IN q /\ y IN top closure_of ((t:A->A->bool) w)") THENL
     [/- CASE 1: y IN closure(t w) for some w IN q -/
      FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"w:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"w:A") THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      /- Use closure(t w) as connecting set -/ MP_TAC (← ISPECL
       [← q r"subtopology top (r:A->bool)", ← q r"top closure_of ((t:A->A->bool) w)",
        ← q r"y:A"] CONNECTED_COMPONENT_OF_MAXIMAL) THEN ANTS_TAC THENL
       [CONJ_TAC THENL [REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
           [MATCH_MP_TAC CONNECTED_IN_CLOSURE_OF THEN
            SUBGOAL_THEN (← q r"(w:A) IN c DIFF d") MP_TAC THENL
             [ASM SET_TAC [], ASM_MESON_TAC []],
            /- closure(t w) SUBSET r: use pre-proved fact -/
            ASM_MESON_TAC []], ASM_REWRITE_TAC []], ALL_TAC] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(w:A) IN connected_component_of (subtopology top r) y")
        MP_TAC THENL [FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
        /- Goal: w IN top closure_of t w -/
        SUBGOAL_THEN (← q r"(w:A) IN c DIFF d /\ (t:A->A->bool) w SUBSET topspace top")
         STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET], REWRITE_TAC [IN]], ALL_TAC] THEN
    /- CASE 2: y NOT in any closure(t w) for w IN q -/
    /- y must be in s DIFF d -/
    SUBGOAL_THEN (← q r"(y:A) IN s DIFF d") ASSUME_TAC THENL [SUBGOAL_THEN
        (← q r"(y:A) IN (s DIFF d) UNION
         UNIONS(IMAGE (\y:A. s INTER top closure_of ((t:A->A->bool) y)) q)")
        MP_TAC THENL [ASM_MESON_TAC [SUBSET, IN], ALL_TAC] THEN
      REWRITE_TAC [IN_UNION, UNIONS_IMAGE, IN_ELIM_THM, IN_INTER] THEN
      ASM_MESON_TAC [], ALL_TAC] THEN /- y is not in c -/
    SUBGOAL_THEN (← q r"~((y:A) IN c)") ASSUME_TAC THENL [DISCH_TAC THEN UNDISCH_TAC
        (← q r"~(?w:A. w IN q /\ y IN top closure_of ((t:A->A->bool) w))") THEN
      REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"(y:A) IN UNIONS(IMAGE (t:A->A->bool) q)") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"w:A") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"(w:A) IN c DIFF d") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(t:A->A->bool) w SUBSET topspace top") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET],
      ALL_TAC] THEN /- Define K = connected component of y in s DIFF c -/
    ABBREV_TAC
      (← q r"K = connected_component_of (subtopology top (s DIFF c)) (y:A)") THEN
    SUBGOAL_THEN (← q r"open_in top (s DIFF c:A->bool)") ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"s DIFF c:A->bool = topspace top DIFF c")
        SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [OPEN_IN_TOPSPACE],
      ALL_TAC] THEN SUBGOAL_THEN (← q r"open_in top (K:A->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC OPEN_IN_TRANS_FULL THEN
      EXISTS_TAC (← q r"s DIFF c:A->bool") THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "K" THEN
      MATCH_MP_TAC OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE THEN
      MATCH_MP_TAC LOCALLY_CONNECTED_SPACE_OPEN_SUBSET THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN SUBGOAL_THEN (← q r"(y:A) IN K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN REWRITE_TAC [IN] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN ASM SET_TAC [],
      ALL_TAC] THEN SUBGOAL_THEN (← q r"(K:A->bool) SUBSET s DIFF c") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN
      MP_TAC (← ISPECL [← q r"subtopology top (s DIFF c:A->bool)", ← q r"y:A"]
        CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"connected_in top (K:A->bool)") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"subtopology top (s DIFF c:A->bool)", ← q r"y:A"]
        CONNECTED_IN_CONNECTED_COMPONENT_OF) THEN
      REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN EXPAND_TAC "K" THEN SIMP_TAC [],
      ALL_TAC] THEN /- Key claim: closure(K) meets c -/
    SUBGOAL_THEN (← q r"~(top closure_of (K:A->bool) INTER c = {})")
      ASSUME_TAC THENL [DISCH_TAC THEN
      SUBGOAL_THEN (← q r"top closure_of (K:A->bool) SUBSET s DIFF c")
        ASSUME_TAC THENL [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"K:A->bool"]
          CLOSURE_OF_SUBSET_TOPSPACE) THEN ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"top closure_of (K:A->bool) = K") ASSUME_TAC THENL
       [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL [EXPAND_TAC "K" THEN
          MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN CONJ_TAC THENL
           [ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
            MATCH_MP_TAC CONNECTED_IN_CLOSURE_OF THEN ASM_REWRITE_TAC [],
            SUBGOAL_THEN (← q r"(K:A->bool) SUBSET topspace top") ASSUME_TAC THENL
             [ASM SET_TAC [], ALL_TAC] THEN
            ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET]],
          MATCH_MP_TAC CLOSURE_OF_SUBSET THEN ASM SET_TAC []], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"closed_in top (K:A->bool)") ASSUME_TAC THENL
       [ASM_REWRITE_TAC [← GSYM CLOSURE_OF_EQ], ALL_TAC] THEN
      MP_TAC (← ISPEC (← q r"top:A topology") CONNECTED_SPACE_CLOPEN_IN) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"K:A->bool")) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
    /- Pick z IN closure(K) INTER c -/ FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN REWRITE_TAC [IN_INTER] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~((z:A) IN d)") ASSUME_TAC THENL [DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"d:A->bool", ← q r"K:A->bool"]
        OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(z:A) IN UNIONS(IMAGE (t:A->A->bool) q)") MP_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w':A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"~(K INTER (t:A->A->bool) w' = {})") ASSUME_TAC THENL
     [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"(t:A->A->bool) w'", ← q r"K:A->bool"]
        OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN ANTS_TAC THENL
       [SUBGOAL_THEN (← q r"(w':A) IN c DIFF d") MP_TAC THENL
         [ASM SET_TAC [], ASM_MESON_TAC []], ALL_TAC] THEN
      ASM SET_TAC [], ALL_TAC] THEN /- Conclusion: w' IN q connects y to w' -/
    EXISTS_TAC (← q r"w':A") THEN ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    /- Use K UNION t(w') as connecting set -/ MP_TAC (← ISPECL
     [← q r"subtopology top (r:A->bool)", ← q r"K UNION (t:A->A->bool) w'",
      ← q r"y:A"] CONNECTED_COMPONENT_OF_MAXIMAL) THEN ANTS_TAC THENL
     [CONJ_TAC THENL [REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONNECTED_IN_UNION THEN ASM_REWRITE_TAC [] THEN
          SUBGOAL_THEN (← q r"(w':A) IN c DIFF d") MP_TAC THENL
           [ASM SET_TAC [], ASM_MESON_TAC []], /- K UNION t(w') SUBSET r -/
          REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
           [/- K SUBSET r: K SUBSET s DIFF c SUBSET s DIFF d SUBSET r -/
            ASM SET_TAC [], /- t(w') SUBSET r: use pre-proved closure fact -/
            TRANS_TAC SUBSET_TRANS (← q r"top closure_of ((t:A->A->bool) w')") THEN
            CONJ_TAC THENL [MATCH_MP_TAC CLOSURE_OF_SUBSET THEN ASM SET_TAC [],
              ASM_MESON_TAC []]]], ASM_REWRITE_TAC [IN_UNION]],
      ALL_TAC] THEN DISCH_TAC THEN SUBGOAL_THEN
      (← q r"(w':A) IN connected_component_of (subtopology top r) y")
      MP_TAC THENL [FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [SUBSET]) THEN
      REWRITE_TAC [IN_UNION] THEN DISJ2_TAC THEN
      SUBGOAL_THEN (← q r"(w':A) IN c DIFF d") MP_TAC THENL
       [ASM SET_TAC [], ASM_MESON_TAC []], REWRITE_TAC [IN]])

  return { SEMI_LOCALLY_CONNECTED_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Semi-local connectedness; dyadic rationals.  (metric.ml 36096-36240)      -/
/- ------------------------------------------------------------------------- -/

structure SLC3 where
  SEMI_LOCALLY_CONNECTED_GEN_SPACE : thm
  SEMI_LOCALLY_CONNECTED_COMPACT_SPACE : thm
  CLOSURE_OF_DYADIC_RATIONALS_IN_UNIT_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupSLC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BCompact1 : Compact1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BConnected1 : Connected1)
    (BComponents1 : Components1) (BComponents2 : Components2) (BLocCompact1 : LocCompact1)
    (BLocCompact2 : LocCompact2) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BLC1 : LC1)
    (BLCC : LCC) (BSLC1 : SLC1) (BSLC2 : SLC2) : ExceptT String IO SLC3 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH_TAC,
        REAL_FIELD, SET_TAC, .. } := D
  let { ARITH, EXP_EQ_0, FORALL_IN_GSPEC, .. } := D.core1
  let { IN, IN_ELIM_THM, IN_UNIV, NOT_LT, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_DIV_REFL, REAL_LE_DIV, REAL_LE_LDIV_EQ, REAL_LT_POW2,
        REAL_MUL_LID, REAL_MUL_LZERO, REAL_NOT_LE, REAL_OF_NUM_EQ, REAL_OF_NUM_LE,
        REAL_OF_NUM_POW, REAL_OF_NUM_SUB, REAL_POS, REAL_POW_INV, REAL_POW_LE, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_REFL, num_WOP, real_div, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_MINIMAL, .. } := BClosure
  let { compact_space, .. } := BCompact1
  let { SUBMETRIC, .. } := BMetricSpace
  let { METRIC_CLOSURE_OF, MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_COMPONENT_OF_REFL, CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE,
        CONNECTED_IN_CONNECTED_COMPONENT_OF, .. } := BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENT_OF, .. } := BComponents2
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } := BLocCompact2
  let { REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL, .. } := BRealTop1
  let { MBALL_REAL_INTERVAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } :=
    BRealTop2
  let { LOCALLY_CONNECTED_SPACE_OPEN_SUBSET,
        OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED, .. } := BLCC
  let { FINITE_CONNECTED_COMPONENTS_CLOPEN_UNION, .. } := BSLC1
  let { SEMI_LOCALLY_CONNECTED_CONNECTED, .. } := BSLC2
  -- @@SCOPE END

  -- SEMI_LOCALLY_CONNECTED_GEN_SPACE: Use
  -- SEMI_LOCALLY_CONNECTED_CONNECTED on each component
  let SEMI_LOCALLY_CONNECTED_GEN_SPACE ← prove
   r"!m:A metric. FINITE(connected_components_of(mtopology m)) /\
     locally_compact_space (mtopology m) /\
     locally_connected_space (mtopology m)
     ==> !x v. open_in (mtopology m) v /\ x IN v
               ==> ?u. open_in (mtopology m) u /\ x IN u /\ u SUBSET v /\
                       FINITE(connected_components_of(subtopology (mtopology m)
                                                      (mspace m DIFF u)))"
   (REPEAT STRIP_TAC THEN ABBREV_TAC (← q r"top = mtopology m:A topology") THEN
    ABBREV_TAC (← q r"s = mspace m:A->bool") THEN
    SUBGOAL_THEN (← q r"topspace top = (s:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "top" THEN EXPAND_TAC "s" THEN REWRITE_TAC [TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN ABBREV_TAC (← q r"C = connected_component_of top (x:A)") THEN
    SUBGOAL_THEN (← q r"open_in top (C:A->bool) /\ closed_in top C")
      STRIP_ASSUME_TAC THENL [EXPAND_TAC "C" THEN
      ASM_SIMP_TAC [OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE,
                    CLOSED_IN_CONNECTED_COMPONENT_OF], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(x:A) IN C") ASSUME_TAC THENL
     [EXPAND_TAC "C" THEN ONCE_REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"C SUBSET (s:A->bool)") ASSUME_TAC THENL [EXPAND_TAC "C" THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"x:A"]
        CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE) THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"mtopology (submetric m (C:A->bool)) = subtopology top C")
      (LABEL_TAC "mtop_eq") THENL [EXPAND_TAC "top" THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"C:A->bool"] MTOPOLOGY_SUBMETRIC) THEN
      ASM_REWRITE_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"mspace (submetric m (C:A->bool)) = C") (LABEL_TAC "msp_eq")
      THENL
     [REWRITE_TAC [SUBMETRIC] THEN ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"submetric m (C:A->bool)") SEMI_LOCALLY_CONNECTED_CONNECTED) THEN
    USE_THEN "mtop_eq" SUBST_ALL_TAC THEN USE_THEN "msp_eq" SUBST_ALL_TAC THEN
    ANTS_TAC THENL [REPEAT CONJ_TAC THENL
       [REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
        SUBGOAL_THEN (← q r"C = connected_component_of top (x:A)") SUBST1_TAC THENL
         [ASM_MESON_TAC [], REWRITE_TAC [CONNECTED_IN_CONNECTED_COMPONENT_OF]],
        MATCH_MP_TAC LOCALLY_COMPACT_SPACE_OPEN_SUBSET THEN
        ASM_REWRITE_TAC [] THEN DISJ1_TAC THEN
        ASM_MESON_TAC [HAUSDORFF_SPACE_MTOPOLOGY],
        MATCH_MP_TAC LOCALLY_CONNECTED_SPACE_OPEN_SUBSET THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"v INTER C:A->bool"]) THEN
    ANTS_TAC THENL [CONJ_TAC THENL
       [REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN EXISTS_TAC (← q r"v:A->bool") THEN
        ASM_REWRITE_TAC [] THEN SET_TAC [], ASM SET_TAC []],
      ALL_TAC] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"u':A->bool") MP_TAC) THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN DISCH_THEN (CONJUNCTS_THEN2
      (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC)
      STRIP_ASSUME_TAC) THEN EXISTS_TAC (← q r"u':A->bool") THEN REPEAT CONJ_TAC THENL
     [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_IN_INTER THEN ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC [], ASM SET_TAC [],
      ALL_TAC] THEN SUBGOAL_THEN (← q r"u' SUBSET (C:A->bool)") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"s DIFF u' = topspace top DIFF u':A->bool") SUBST1_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC FINITE_CONNECTED_COMPONENTS_CLOPEN_UNION THEN
    EXISTS_TAC (← q r"C:A->bool") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"subtopology top (C DIFF w INTER C) =
                  subtopology (subtopology top C) (C DIFF u'):A topology")
      SUBST1_TAC THENL
     [REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [], ASM_REWRITE_TAC []])

  let SEMI_LOCALLY_CONNECTED_COMPACT_SPACE ← prove
   r"!m:A metric.
     compact_in (mtopology m) (mspace m) /\
     locally_connected_space (mtopology m)
     ==> !x v. open_in (mtopology m) v /\ x IN v
               ==> ?u. open_in (mtopology m) u /\ x IN u /\ u SUBSET v /\
                       FINITE(connected_components_of(subtopology (mtopology m)
                                                      (mspace m DIFF u)))"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"m:A metric") SEMI_LOCALLY_CONNECTED_GEN_SPACE) THEN ANTS_TAC THENL
     [/- Need: FINITE(connected_components_of(mtopology m)) /\
         locally_compact_space /\ locally_connected_space -/
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_CONNECTED_COMPONENTS_COMPACT_LOCALLY_CONNECTED THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN MP_TAC (← ISPEC (← q r"mtopology m:A topology")
        COMPACT_IMP_LOCALLY_COMPACT_SPACE) THEN
      ASM_REWRITE_TAC [compact_space, TOPSPACE_MTOPOLOGY],
      /- Apply the resulting implication to x and v -/
      DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"v:A->bool"]) THEN ASM_REWRITE_TAC []])

  -- The dyadic rationals in [0,1] are dense in [0,1].

  let CLOSURE_OF_DYADIC_RATIONALS_IN_UNIT_INTERVAL ← do
    let REAL_EXP_DIV_POW2 ← prove
     r"!n. &(2 EXP n) / &2 pow n = &1"
     (GEN_TAC THEN REWRITE_TAC [REAL_OF_NUM_POW] THEN
      MATCH_MP_TAC REAL_DIV_REFL THEN
      REWRITE_TAC [REAL_OF_NUM_EQ, EXP_EQ_0, ARITH])
    prove
     r"euclideanreal closure_of {&k / &2 pow n | k <= 2 EXP n} =
   real_interval[&0,&1]"
     (MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [/- closure_of D SUBSET [0,1]: D SUBSET [0,1] which is closed -/
        MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN CONJ_TAC THENL
         [REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_REAL_INTERVAL] THEN
          REPEAT STRIP_TAC THENL [MATCH_MP_TAC REAL_LE_DIV THEN
            REWRITE_TAC [REAL_POS] THEN MATCH_MP_TAC REAL_POW_LE THEN
            REAL_ARITH_TAC, ASM_SIMP_TAC [REAL_LE_LDIV_EQ, REAL_LT_POW2] THEN
            ASM_REWRITE_TAC [REAL_MUL_LID, REAL_OF_NUM_POW, REAL_OF_NUM_LE]],
          REWRITE_TAC [← GSYM REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL]],
        /- [0,1] SUBSET closure_of D: density argument -/
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:real") THEN
        REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
        REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
        REWRITE_TAC [METRIC_CLOSURE_OF] THEN
        REWRITE_TAC [IN_ELIM_THM, REAL_EUCLIDEAN_METRIC, IN_UNIV,
                     MBALL_REAL_INTERVAL, IN_REAL_INTERVAL] THEN
        X_GEN_TAC (← q r"r:real") THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"inv(&2)", ← q r"r:real"] REAL_ARCH_POW_INV) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [REAL_POW_INV] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"n:num")) THEN
        SUBGOAL_THEN (← q r"?k:num. x <= &k / &2 pow n") MP_TAC THENL
         [EXISTS_TAC (← q r"2 EXP n") THEN ASM_REWRITE_TAC [REAL_EXP_DIV_POW2],
          ALL_TAC] THEN GEN_REWRITE_TAC LAND_CONV [num_WOP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"k <= 2 EXP n") ASSUME_TAC THENL
         [REWRITE_TAC [← GSYM NOT_LT] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"2 EXP n")) THEN
          ASM_REWRITE_TAC [REAL_EXP_DIV_POW2], ALL_TAC] THEN
        EXISTS_TAC (← q r"&k / &2 pow n") THEN CONJ_TAC THENL
         [MAP_EVERY EXISTS_TAC [← q r"k:num", ← q r"n:num"] THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        ASM_CASES_TAC (← q r"k = 0") THENL [FIRST_X_ASSUM SUBST_ALL_TAC THEN
          RULE_ASSUM_TAC (REWRITE_RULE [real_div, REAL_MUL_LZERO]) THEN
          REWRITE_TAC [real_div, REAL_MUL_LZERO] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k - 1")) THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q r"~(k = 0) ==> k - 1 < k")] THEN
        REWRITE_TAC [REAL_NOT_LE] THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"&(k - 1) = &k - &1")
          (fun th => RULE_ASSUM_TAC (REWRITE_RULE [th])) THENL
         [CONV_TAC SYM_CONV THEN MATCH_MP_TAC REAL_OF_NUM_SUB THEN ASM_ARITH_TAC,
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"&k / &2 pow n - (&k - &1) / &2 pow n = inv(&2 pow n)")
          ASSUME_TAC THENL [MATCH_MP_TAC (← REAL_FIELD (← q
            r"&0 < p ==> k / p - (k - &1) / p = inv p")) THEN
          REWRITE_TAC [REAL_LT_POW2], ASM_REAL_ARITH_TAC]])

  return { SEMI_LOCALLY_CONNECTED_GEN_SPACE, SEMI_LOCALLY_CONNECTED_COMPACT_SPACE,
           CLOSURE_OF_DYADIC_RATIONALS_IN_UNIT_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Path-connectivity of complete locally connected metric spaces.            -/
/- Whyburn, Analytic Topology, Theorems (5.1)-(5.4); H-Y Theorem 3-17.       -/
/- (metric.ml 36242-36365)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PC1 where
  CHAIN_FROM_OPEN_COVER : thm
  CONNECTED_IN_CHAIN_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupPC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BConnected1 : Connected1)
    (BConnected2 : Connected2) : ExceptT String IO PC1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, IN_UNIONS, LE, LE_0, LE_REFL, LT,
        LT_SUC_LE, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET, UNIONS_1, .. } := D.core4
  let { OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, closed_in, .. } := BTopology
  let { CONNECTED_SPACE_CLOPEN_IN, .. } := BConnected1
  let { CONNECTED_IN_UNION, .. } := BConnected2
  -- @@SCOPE END

  -- Chain from open cover: in a connected space, any open cover admits a
  -- finite chain between any two points (H-Y Theorem 3-4).
  let CHAIN_FROM_OPEN_COVER ← prove
   r"!top:A topology U a b.
        connected_space top /\
        a IN topspace top /\ b IN topspace top /\
        (!x. x IN topspace top ==> ?u. u IN U /\ x IN u) /\
        (!u. u IN U ==> open_in top u) ==> ?c n. (!i. i <= n ==> c i IN U) /\
                  a IN c 0 /\ b IN c n /\
                  (!i. i < n ==> ~(c i INTER c(SUC i) = {}))"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN SUBGOAL_THEN (← q r"{x:A | x IN topspace top /\
              ?c n. (!i. i <= n ==> c i IN U) /\ a IN c 0 /\ x IN c n /\
                    (!i. i < n ==> ~(c i INTER c(SUC i) = {}))} =
       topspace top") MP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_SPACE_CLOPEN_IN]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{x:A | x IN topspace top /\
                ?c n. (!i. i <= n ==> c i IN U) /\ a IN c 0 /\ x IN c n /\
                      (!i. i < n ==> ~(c i INTER c(SUC i) = {}))}")) THEN
      ANTS_TAC THENL [CONJ_TAC THENL [/- open_in: use OPEN_IN_SUBOPEN -/
          GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
          X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"v:A->bool") THEN
          SUBGOAL_THEN (← q r"open_in top (v:A->bool) /\ v SUBSET topspace top")
            STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [OPEN_IN_SUBSET], ALL_TAC] THEN
          ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
          CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN EXISTS_TAC
            (← q r"\i:num. if i <= n then (c:num->A->bool) i else (v:A->bool)") THEN
          EXISTS_TAC (← q r"SUC n") THEN REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
           [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
            COND_CASES_TAC THEN ASM_MESON_TAC [], ASM_REWRITE_TAC [LE_0],
            ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(SUC n <= n)")],
            X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [LT_SUC_LE] THEN DISCH_TAC THEN
            SUBGOAL_THEN (← q r"j:num <= n") ASSUME_TAC THENL
             [ASM_ARITH_TAC, ASM_REWRITE_TAC []] THEN
            ASM_CASES_TAC (← q r"SUC j <= n") THEN ASM_REWRITE_TAC [] THENL
             [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
              SUBGOAL_THEN (← q r"j:num = n") SUBST_ALL_TAC THENL
               [ASM_ARITH_TAC, ASM SET_TAC []]]],
          /- closed_in: complement is open by chain extension -/
          REWRITE_TAC [closed_in] THEN CONJ_TAC THENL
           [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [], ALL_TAC] THEN
          GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
          X_GEN_TAC (← q r"x':A") THEN REWRITE_TAC [IN_DIFF, IN_ELIM_THM] THEN
          STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x':A")) THEN
          ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"w:A->bool") THEN
          SUBGOAL_THEN (← q r"open_in top (w:A->bool)") ASSUME_TAC THENL
           [ASM_MESON_TAC [], ALL_TAC] THEN
          ASM_REWRITE_TAC [SUBSET, IN_DIFF, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"y':A") THEN DISCH_TAC THEN CONJ_TAC THENL
           [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"c':num->A->bool")
              (X_CHOOSE_THEN (← q r"n':num") STRIP_ASSUME_TAC))) THEN SUBGOAL_THEN
            (← q r"?c'':num->A->bool n'':num.
               (!i. i <= n'' ==> c'' i IN (U:(A->bool)->bool)) /\
               (a:A) IN c'' 0 /\ (x':A) IN c'' n'' /\
               (!i. i < n'' ==> ~(c'' i INTER c''(SUC i) = {}))") MP_TAC THENL
           [EXISTS_TAC
              (← q r"\i:num. if i <= n' then (c':num->A->bool) i else (w:A->bool)") THEN
            EXISTS_TAC (← q r"SUC n'") THEN REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
             [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
              COND_CASES_TAC THEN ASM_MESON_TAC [], ASM_REWRITE_TAC [LE_0],
              ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(SUC n <= n)")],
              X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [LT_SUC_LE] THEN DISCH_TAC THEN
              SUBGOAL_THEN (← q r"j:num <= n'") ASSUME_TAC THENL
               [ASM_ARITH_TAC, ASM_REWRITE_TAC []] THEN
              ASM_CASES_TAC (← q r"SUC j <= n'") THEN ASM_REWRITE_TAC [] THENL
               [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
                SUBGOAL_THEN (← q r"j:num = n'") SUBST_ALL_TAC THENL
                 [ASM_ARITH_TAC, ASM SET_TAC []]]], ASM_MESON_TAC []]],
        /- From X = {} \/ X = topspace, eliminate X = {} -/
        DISCH_THEN (DISJ_CASES_TAC) THENL [SUBGOAL_THEN (← q r"(a:A) IN {}") MP_TAC THENL
           [FIRST_X_ASSUM (fun th => tactic_of do
              pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
            ASM_REWRITE_TAC [IN_ELIM_THM] THEN
            FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN ASM_REWRITE_TAC [] THEN
            DISCH_THEN (X_CHOOSE_THEN (← q r"u0:A->bool") STRIP_ASSUME_TAC) THEN
            EXISTS_TAC (← q r"(\i:num. u0):num->A->bool") THEN
            EXISTS_TAC (← q r"0") THEN ASM_REWRITE_TAC [LE_0, LT],
            REWRITE_TAC [NOT_IN_EMPTY]], ASM_REWRITE_TAC []]],
      /- Extract chain for b from b IN X -/
      DISCH_TAC THEN SUBGOAL_THEN (← q r"(b:A) IN {x | x IN topspace top /\
                       ?c n. (!i. i <= n ==> c i IN U) /\ a IN c 0 /\ x IN c n /\
                             (!i. i < n ==> ~(c i INTER c(SUC i) = {}))}")
        MP_TAC THENL [FIRST_X_ASSUM SUBST1_TAC THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC []]])

  -- CONNECTED_IN_CHAIN_UNIONS: A finite chain of connected sets (consecutive
  -- links overlapping) has connected union.
  let CONNECTED_IN_CHAIN_UNIONS ← prove
   r"!top (c:num->A->bool) n.
        (!i. i <= n ==> connected_in top (c i)) /\
        (!i. i < n ==> ~(c i INTER c(SUC i) = {}))
        ==> connected_in top (UNIONS {c i | i <= n})"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THENL [STRIP_TAC THEN
      SUBGOAL_THEN (← q r"{(c:num->A->bool) i | i <= 0} = {c 0}") SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_SING, LE] THEN MESON_TAC [],
        REWRITE_TAC [UNIONS_1] THEN ASM_MESON_TAC [LE_0]], STRIP_TAC THEN
      SUBGOAL_THEN (← q r"UNIONS {(c:num->A->bool) i | i <= SUC n} =
         UNIONS {c i | i <= n} UNION c(SUC n)") SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_UNIONS, IN_UNION, IN_ELIM_THM, LE] THEN
        MESON_TAC [], MATCH_MP_TAC CONNECTED_IN_UNION THEN REPEAT CONJ_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN
          ASM_MESON_TAC [← ARITH_RULE (← q r"i <= n ==> i <= SUC n"),
                         ← ARITH_RULE (← q r"i < n ==> i < SUC n")],
          ASM_MESON_TAC [LE_REFL],
          SUBGOAL_THEN (← q r"~((c:num->A->bool) n INTER c(SUC n) = {})") MP_TAC THENL
           [ASM_MESON_TAC [← ARITH_RULE (← q r"n < SUC n")], ALL_TAC] THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS,
                       IN_ELIM_THM] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:A") THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
          EXISTS_TAC (← q r"(c:num->A->bool) n") THEN ASM_REWRITE_TAC [] THEN
          EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [LE_REFL]]]])

  return { CHAIN_FROM_OPEN_COVER, CONNECTED_IN_CHAIN_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Nested intersections of closures.  (metric.ml 36367-36546)                -/
/- ------------------------------------------------------------------------- -/

structure CNI where
  COMPACT_NESTED_INTERS : thm
  deriving Inhabited

@[nospecialize]
def setupCNI [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BCompact1 : Compact1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BCauchy1 : Cauchy1) (BTotBdd1 : TotBdd1) (BTotBdd2 : TotBdd2)
    (BMCompact2 : MCompact2) (BDIAM1 : DIAM1) (BDIAM2 : DIAM2) : ExceptT String IO CNI := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FINITE_IMAGE, FINITE_NUMSEG_LE, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_UNIONS, IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ARCH_INV, REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_TRANS, REAL_LT_IMP_LE,
        REAL_LT_INV, REAL_OF_NUM_LE, REAL_OF_NUM_LT, .. } := D.core3
  let { SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, UNIONS_SUBSET, .. } := D.core4
  let { CLOSED_IN_INTERS, CLOSED_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET_TOPSPACE, .. } := BClosure
  let { COMPACT_IN_SUBSPACE, .. } := BCompact1
  let { IN_MBALL, SUBMETRIC, .. } := BMetricSpace
  let { IN_MCBALL, MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_CLOSURE_OF, MBOUNDED_EMPTY, mbounded, .. } := BBounded
  let { CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, .. } := BCauchy1
  let { totally_bounded_in, .. } := BTotBdd1
  let { TOTALLY_BOUNDED_IN_ABSOLUTE, .. } := BTotBdd2
  let { COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN, .. } := BMCompact2
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_LE, .. } := BDIAM1
  let { MDIAMETER_CLOSURE, .. } := BDIAM2
  -- @@SCOPE END

  -- Helper: intersection of nested unions of closures with vanishing
  -- diameter in a complete metric space is compact. Proved for the whole
  -- metric space; localized versions follow by instantiating m to submetric.

  let COMPACT_NESTED_INTERS ← prove
   r"!m:A metric (c:num->num->A->bool) (N:num->num).
        mcomplete m /\
        (!n i. i <= N n ==> c n i SUBSET mspace m) /\
        (!n i. i <= N n ==> !x y. x IN c n i /\ y IN c n i
                         ==> mdist m (x:A,y) < inv(&(n + 1)))
        ==> compact_in (mtopology m)
              (INTERS {UNIONS {mtopology m closure_of c n i | i |
                                i <= N n} | n IN (:num)})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN ABBREV_TAC (← q r"KK = \n:num. UNIONS
        {mtopology m closure_of (c:num->num->A->bool) n i | i | i <= N n}") THEN
    ABBREV_TAC (← q r"K:A->bool = INTERS {(KK:num->A->bool) n | n IN (:num)}") THEN
    /- Step 1: closure SUBSET mspace m -/ SUBGOAL_THEN
      (← q r"!n i. (mtopology m closure_of (c:num->num->A->bool) n i) SUBSET mspace m")
      ASSUME_TAC THENL
     [MESON_TAC [CLOSURE_OF_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    /- Step 2: finiteness of the index sets -/ SUBGOAL_THEN
      (← q r"!n. FINITE {mtopology m closure_of (c:num->num->A->bool) n i | i |
                    i <= N n}")
      ASSUME_TAC THENL [GEN_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      MATCH_MP_TAC FINITE_IMAGE THEN REWRITE_TAC [FINITE_NUMSEG_LE], ALL_TAC] THEN
    /- Step 3: KK n SUBSET mspace m -/
    SUBGOAL_THEN (← q r"!n. (KK:num->A->bool) n SUBSET mspace m") ASSUME_TAC THENL
     [GEN_TAC THEN EXPAND_TAC "KK" THEN
      REWRITE_TAC [UNIONS_SUBSET, IN_ELIM_THM] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
    /- Step 4: K SUBSET mspace m -/
    SUBGOAL_THEN (← q r"(K:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC (← SET_RULE (← q
        r"!t:A->bool. t IN s /\ t SUBSET u ==> INTERS s SUBSET u")) THEN
      EXISTS_TAC (← q r"(KK:num->A->bool) 0") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      CONJ_TAC THENL
       [EXISTS_TAC (← q r"0") THEN REWRITE_TAC [IN_UNIV], ASM_REWRITE_TAC []],
      ALL_TAC] THEN /- Step 5: KK n is closed -/
    SUBGOAL_THEN (← q r"!n. closed_in (mtopology m) ((KK:num->A->bool) n)")
      ASSUME_TAC THENL [GEN_TAC THEN EXPAND_TAC "KK" THEN
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LE,
                    FORALL_IN_IMAGE, CLOSED_IN_CLOSURE_OF], ALL_TAC] THEN
    /- Step 6: K is closed -/
    SUBGOAL_THEN (← q r"closed_in (mtopology m) (K:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN CONJ_TAC THENL
       [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"(KK:num->A->bool) 0") THEN
        EXISTS_TAC (← q r"0") THEN REWRITE_TAC [IN_UNIV],
        REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC []],
      ALL_TAC] THEN /- Step 7: mcomplete(submetric m K) -/
    SUBGOAL_THEN (← q r"mcomplete (submetric m (K:A->bool))") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN /- Step 8: K SUBSET KK n for all n -/
    SUBGOAL_THEN (← q r"!n. (K:A->bool) SUBSET (KK:num->A->bool) n")
      ASSUME_TAC THENL [GEN_TAC THEN EXPAND_TAC "K" THEN MATCH_MP_TAC (← SET_RULE (← q
        r"(t:A->bool) IN s ==> INTERS s SUBSET t")) THEN
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [IN_UNIV],
      ALL_TAC] THEN /- Step 9: c n i is mbounded -/
    SUBGOAL_THEN (← q r"!n i. i <= N n ==> mbounded m ((c:num->num->A->bool) n i)")
      ASSUME_TAC THENL [REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"(c:num->num->A->bool) n i = {}") THENL
       [ASM_REWRITE_TAC [MBOUNDED_EMPTY], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:A")) THEN REWRITE_TAC [mbounded] THEN
      EXISTS_TAC (← q r"z:A") THEN EXISTS_TAC (← q r"inv(&(n + 1))") THEN
      REWRITE_TAC [SUBSET, IN_MCBALL] THEN X_GEN_TAC (← q r"w:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(z:A) IN mspace m /\ (w:A) IN mspace m")
        STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN ASM_MESON_TAC [],
      ALL_TAC] THEN /- Step 10: mdiameter(closure c n i) <= inv(n+1) -/
    SUBGOAL_THEN (← q r"!n i. i <= N n ==> mdiameter m (mtopology m closure_of
                                (c:num->num->A->bool) n i) <= inv(&(n + 1))")
      ASSUME_TAC THENL [REPEAT STRIP_TAC THEN SUBGOAL_THEN
        (← q r"mdiameter m (mtopology m closure_of (c:num->num->A->bool) n i) =
         mdiameter m (c n i)") SUBST1_TAC THENL
       [MATCH_MP_TAC MDIAMETER_CLOSURE THEN ASM_SIMP_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MDIAMETER_LE THEN REPEAT CONJ_TAC THENL [ASM_SIMP_TAC [],
        DISJ2_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN
        MATCH_MP_TAC REAL_LT_INV THEN REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC,
        REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_LT_IMP_LE THEN ASM_MESON_TAC []],
      ALL_TAC] THEN /- Step 11: totally_bounded_in m K -/
    SUBGOAL_THEN (← q r"totally_bounded_in m (K:A->bool)") ASSUME_TAC THENL
     [REWRITE_TAC [totally_bounded_in] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      /- Choose n with inv(n+1) < e -/
      MP_TAC (← SPEC (← q r"e:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"nn:num") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"inv(&((nn:num) + 1)) < e") ASSUME_TAC THENL
       [MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"inv(&nn)") THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_INV2 THEN CONJ_TAC THENL
         [ASM_SIMP_TAC [REAL_OF_NUM_LT, ← ARITH_RULE (← q r"~(nn = 0) ==> 0 < nn")],
          REWRITE_TAC [REAL_OF_NUM_LE] THEN ARITH_TAC], ALL_TAC] THEN
      /- For each closure(c nn i) that intersects K, pick representative -/
      SUBGOAL_THEN (← q r"?rep:num->A. !i. i <= N(nn:num)
                           ==> rep i IN (K:A->bool) INTER (mtopology m closure_of
                                  (c:num->num->A->bool) nn i) \/ K INTER
                               (mtopology m closure_of c nn i) = {}")
        (X_CHOOSE_TAC (← q r"rep:num->A")) THENL
       [REWRITE_TAC [← GSYM SKOLEM_THM] THEN X_GEN_TAC (← q r"i:num") THEN
        ASM_CASES_TAC (← q r"(K:A->bool) INTER (mtopology m closure_of
                         (c:num->num->A->bool) nn i) = {}") THENL
         [EXISTS_TAC (← q r"a:A") THEN ASM_MESON_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        REWRITE_TAC [IN_INTER] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"z:A") THEN DISCH_TAC THEN DISJ1_TAC THEN
        ASM_REWRITE_TAC [IN_INTER], ALL_TAC] THEN
      EXISTS_TAC (← q r"IMAGE (rep:num->A) {i | i <= N(nn:num) /\
                    ~((K:A->bool) INTER (mtopology m closure_of
                        (c:num->num->A->bool) nn i) = {})}") THEN
      REPEAT CONJ_TAC THENL [/- FINITE -/
        MATCH_MP_TAC FINITE_IMAGE THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{i:num | i <= N(nn:num)}") THEN
        REWRITE_TAC [FINITE_NUMSEG_LE] THEN SET_TAC [], /- k SUBSET K -/
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"i:num") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(rep:num->A) i IN (K:A->bool) INTER
                      (mtopology m closure_of (c:num->num->A->bool) nn i)")
          MP_TAC THENL [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
          ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
          REWRITE_TAC [IN_INTER] THEN SIMP_TAC []],
        /- K SUBSET UNIONS{mball(rep i, e) | ...} -/
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        /- x IN K, so x IN KK nn -/
        SUBGOAL_THEN (← q r"(x:A) IN (KK:num->A->bool) nn") MP_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        EXPAND_TAC "KK" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"s':A->bool")
          (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"i:num") STRIP_ASSUME_TAC)
                           ASSUME_TAC)) THEN
        ASM_REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"mball m ((rep:num->A) i, e)") THEN CONJ_TAC THENL
         [EXISTS_TAC (← q r"(rep:num->A) i") THEN CONJ_TAC THENL
           [REWRITE_TAC [IN_IMAGE, IN_ELIM_THM] THEN EXISTS_TAC (← q r"i:num") THEN
            ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
            EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
            UNDISCH_TAC (← q r"(x:A) IN (s':A->bool)") THEN ASM_REWRITE_TAC [],
            REFL_TAC], ALL_TAC] THEN REWRITE_TAC [IN_MBALL] THEN
        /- x IN closure(c nn i) -/
        SUBGOAL_THEN (← q r"(x:A) IN mtopology m closure_of (c:num->num->A->bool) nn i")
          ASSUME_TAC THENL
         [UNDISCH_TAC (← q r"(x:A) IN (s':A->bool)") THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN /- rep i IN closure(c nn i) -/
        SUBGOAL_THEN (← q r"(rep:num->A) i IN
                      mtopology m closure_of (c:num->num->A->bool) nn i")
          ASSUME_TAC THENL [SUBGOAL_THEN (← q r"(rep:num->A) i IN (K:A->bool) INTER
                        (mtopology m closure_of (c:num->num->A->bool) nn i)")
            (fun th => tactic_of do pure (REWRITE_TAC [← REWRITE_RULE [IN_INTER] th])) THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
          ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
          MATCH_MP_TAC (← TAUT (← q r"~b ==> a \/ b ==> a")) THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
          EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        /- membership in mspace m -/
        SUBGOAL_THEN (← q r"(rep:num->A) i IN mspace m /\ (x:A) IN mspace m")
          STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [CLOSURE_OF_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY, SUBSET],
          ALL_TAC] THEN ASM_REWRITE_TAC [] THEN /- mdist m (rep i, x) < e -/
        MATCH_MP_TAC REAL_LET_TRANS THEN
        EXISTS_TAC (← q r"inv(&(nn + 1))") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_LE_TRANS THEN
        EXISTS_TAC (← q r"mdiameter m (mtopology m closure_of
                      (c:num->num->A->bool) nn i)") THEN CONJ_TAC THENL
         [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN CONJ_TAC THENL
           [ASM_SIMP_TAC [MBOUNDED_CLOSURE_OF], ASM_REWRITE_TAC []],
          ASM_SIMP_TAC []]], ALL_TAC] THEN
    /- Conclusion: first substitute K for the INTERS expression -/ SUBGOAL_THEN
      (← q r"INTERS {UNIONS {mtopology m closure_of (c:num->num->A->bool) n i | i |
                        i <= N n} | n IN (:num)} = K") SUBST1_TAC THENL
     [EXPAND_TAC "K" THEN EXPAND_TAC "KK" THEN REWRITE_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [COMPACT_IN_SUBSPACE, TOPSPACE_MTOPOLOGY] THEN SUBGOAL_THEN
      (← q r"subtopology (mtopology m) (K:A->bool) = mtopology(submetric m K)")
      SUBST1_TAC THENL [ASM_SIMP_TAC [MTOPOLOGY_SUBMETRIC,
                    ← SET_RULE (← q r"(K:A->bool) SUBSET t ==> t INTER K = K")],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN] THEN
    SUBGOAL_THEN (← q r"mspace(submetric m (K:A->bool)) = K")
      (fun th => REWRITE_TAC [th]) THENL
     [REWRITE_TAC [SUBMETRIC] THEN ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [TOTALLY_BOUNDED_IN_ABSOLUTE])

  return { COMPACT_NESTED_INTERS }

/- ------------------------------------------------------------------------- -/
/- Fine covers and chains in open connected sets.  (metric.ml 36548-36634)   -/
/- ------------------------------------------------------------------------- -/

structure PC2 where
  OPEN_CONNECTED_FINE_COVER : thm
  CHAIN_IN_OPEN_CONNECTED_SET : thm
  deriving Inhabited

@[nospecialize]
def setupPC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BConnected1 : Connected1) (BLC1 : LC1) (BPC1 : PC1) : ExceptT String IO PC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, SET_TAC, .. } := D
  let { IN_ELIM_THM, IN_INTER, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LT_ADD2, REAL_LT_TRANS, .. } := D.core3
  let { SUBSET, SUBSET_TRANS, .. } := D.core4
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_MINIMAL, .. } := BClosure
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_CONCENTRIC, MBALL_SUBSET_MSPACE, MDIST_SYM,
        MDIST_TRIANGLE, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, MBALL_SUBSET_MCBALL, MCBALL_SUBSET_MBALL_CONCENTRIC, OPEN_IN_MBALL,
        OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_SPACE_SUBTOPOLOGY, .. } := BConnected1
  let { LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { CHAIN_FROM_OPEN_COVER, .. } := BPC1
  -- @@SCOPE END

  -- Helper: in a locally connected metric space, each point in an open set
  -- has a connected open neighbourhood with closure inside the open set and
  -- small diameter.

  let OPEN_CONNECTED_FINE_COVER ← prove
   r"!m:A metric u e.
        locally_connected_space (mtopology m) /\
        open_in (mtopology m) u /\ &0 < e ==> !x. x IN u
        ==> ?v. open_in (mtopology m) v /\ connected_in (mtopology m) v /\
                x IN v /\ v SUBSET u /\
                (mtopology m closure_of v) SUBSET u /\
                !y z. y IN v /\ z IN v ==> mdist m (y:A,z) < e"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_MTOPOLOGY]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
    ABBREV_TAC (← q r"d = min r e / &3") THEN
    SUBGOAL_THEN (← q r"&0 < d /\ d < r /\ &2 * d < e") STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"mball m (x:A,d) SUBSET u") ASSUME_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A,r)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED_SPACE]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"mball m (x:A,d)", ← q r"x:A"]) THEN
    ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [ASM SET_TAC [],
      TRANS_TAC SUBSET_TRANS (← q r"mcball m (x:A,d)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A,d)") THEN
          ASM_REWRITE_TAC [MBALL_SUBSET_MCBALL], REWRITE_TAC [CLOSED_IN_MCBALL]],
        TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A,r)") THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN ASM_REWRITE_TAC []],
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(y:A) IN mball m (x,d) /\ (z:A) IN mball m (x,d)") MP_TAC
      THENL [ASM SET_TAC [], REWRITE_TAC [IN_MBALL]] THEN STRIP_TAC THEN
      TRANS_TAC REAL_LET_TRANS (← q r"mdist m (y:A,x) + mdist m (x,z)") THEN
      CONJ_TAC THENL [MATCH_MP_TAC MDIST_TRIANGLE THEN
        ASM_MESON_TAC [SUBSET, MBALL_SUBSET_MSPACE],
        TRANS_TAC REAL_LT_TRANS (← q r"d + d:real") THEN CONJ_TAC THENL
         [MATCH_MP_TAC REAL_LT_ADD2 THEN CONJ_TAC THENL
           [ASM_MESON_TAC [MDIST_SYM, MBALL_SUBSET_MSPACE, SUBSET],
            ASM_REWRITE_TAC []], ASM_REAL_ARITH_TAC]]])

  -- Helper: chain within a single open connected set, with closures inside

  let CHAIN_IN_OPEN_CONNECTED_SET ← prove
   r"!m:A metric g e a' b'.
    locally_connected_space (mtopology m) /\
    open_in (mtopology m) g /\ connected_in (mtopology m) g /\
    a' IN g /\ b' IN g /\ &0 < e
    ==> ?c' M'. (!i. i <= M' ==> open_in (mtopology m) (c' i) /\
                                  connected_in (mtopology m) (c' i) /\
                                  (mtopology m closure_of c' i) SUBSET g) /\
                a' IN c' 0 /\ b' IN c' M' /\
                (!i. i < M' ==> ~(c' i INTER c'(SUC i) = {})) /\
                (!i. i <= M' ==>
                     !x y. x IN c' i /\ y IN c' i ==> mdist m (x:A,y) < e)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"connected_space (subtopology (mtopology m) (g:A->bool))")
      ASSUME_TAC THENL [ASM_SIMP_TAC [CONNECTED_SPACE_SUBTOPOLOGY], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(g:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"subtopology (mtopology m) (g:A->bool)",
       ← q r"{v:A->bool | open_in (mtopology m) v /\ connected_in (mtopology m) v /\
                     v SUBSET g /\ (mtopology m closure_of v) SUBSET g /\
                     !x y. x IN v /\ y IN v ==> mdist m (x:A,y) < e}",
       ← q r"a':A", ← q r"b':A"] CHAIN_FROM_OPEN_COVER) THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
       [/- Cover property -/
        X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
        STRIP_TAC THEN MP_TAC (← ISPECL [← q r"m:A metric", ← q r"g:A->bool", ← q r"e:real"]
          OPEN_CONNECTED_FINE_COVER) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [], /- Open in subtopology -/
        REWRITE_TAC [IN_ELIM_THM] THEN REPEAT STRIP_TAC THEN
        ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY]], REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c':num->A->bool")
        (X_CHOOSE_THEN (← q r"M':num") STRIP_ASSUME_TAC)) THEN
      MAP_EVERY EXISTS_TAC [← q r"c':num->A->bool", ← q r"M':num"] THEN ASM_MESON_TAC []])

  return { OPEN_CONNECTED_FINE_COVER, CHAIN_IN_OPEN_CONNECTED_SET }

/- ------------------------------------------------------------------------- -/
/- Chain refinement step.  (metric.ml 36636-36789)                           -/
/- ------------------------------------------------------------------------- -/

structure CRS where
  CHAIN_REFINEMENT_STEP : thm
  deriving Inhabited

@[nospecialize]
def setupCRS [HolBase] (D : MetricDeps) (BPC2 : PC2) : ExceptT String IO CRS := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, .. } := D
  let { IN_INTER, LE, LE_0, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { CHAIN_IN_OPEN_CONNECTED_SET, .. } := BPC2
  -- @@SCOPE END

  -- Helper: chain refinement step - refine a coarse chain to a finer one
  let CHAIN_REFINEMENT_STEP ← prove
   r"!m:A metric (g:num->A->bool) M e a b.
    locally_connected_space (mtopology m) /\
    (!i. i <= M ==> open_in (mtopology m) (g i) /\
                     connected_in (mtopology m) (g i)) /\
    a IN g 0 /\ b IN g M /\ (!i. i < M ==> ~(g i INTER g(SUC i) = {})) /\
    &0 < e
    ==> ?g' M'. (!i. i <= M' ==> open_in (mtopology m) (g' i) /\
                            connected_in (mtopology m) (g' i)) /\
          a IN g' 0 /\ b IN g' M' /\
          (!i. i < M' ==> ~(g' i INTER g'(SUC i) = {})) /\ (!i. i <= M' ==>
               !x y. x IN g' i /\ y IN g' i ==> mdist m (x:A,y) < e) /\
          (!j. j <= M' ==> ?i. i <= M /\
                   (mtopology m closure_of g' j) SUBSET g i) /\
          (?ff. (!j. j <= M' ==> ff j <= M /\
                     (mtopology m closure_of g' j) SUBSET g (ff j)) /\
                (!j1 j2. j1 <= j2 /\ j2 <= M' ==> ff j1 <= ff j2) /\
                (!i. i <= M ==> ?j. j <= M' /\ ff j = i)) /\
          (!i. i <= M ==> ?j. j <= M' /\
                   (mtopology m closure_of g' j) SUBSET g i)"
   (GEN_TAC THEN GEN_TAC THEN INDUCT_TAC THENL
     [/- Base case: M = 0, single link -/ REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"(g:num->A->bool) 0", ← q r"e:real",
                        ← q r"a:A", ← q r"b:A"]
        CHAIN_IN_OPEN_CONNECTED_SET) THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [LE_0], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c':num->A->bool")
        (X_CHOOSE_THEN (← q r"M':num") STRIP_ASSUME_TAC)) THEN
      MAP_EVERY EXISTS_TAC [← q r"c':num->A->bool", ← q r"M':num"] THEN
      ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL [ASM_MESON_TAC [],
        X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN ASM_MESON_TAC [],
        EXISTS_TAC (← q r"\j:num. 0") THEN CONV_TAC (DEPTH_CONV BETA_CONV) THEN
        REWRITE_TAC [LE_0] THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        X_GEN_TAC (← q r"i':num") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"0") THEN REWRITE_TAC [LE_0] THEN ASM_ARITH_TAC,
        X_GEN_TAC (← q r"i:num") THEN REWRITE_TAC [LE] THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"0") THEN ASM_REWRITE_TAC [LE_0] THEN ASM_MESON_TAC [LE_0]],
      /- Inductive step: M -> SUC M -/ REPEAT STRIP_TAC THEN
      /- Pick bridge point q in g M INTER g (SUC M) -/
      SUBGOAL_THEN (← q r"~((g:num->A->bool) M INTER g(SUC M) = {})")
        MP_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:A") STRIP_ASSUME_TAC) THEN
      /- Apply IH to chain g 0,...,g M from a to q -/
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"e:real", ← q r"a:A", ← q r"q:A"]) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"i <= M ==> i <= SUC M")],
          X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:num")) THEN
          ASM_SIMP_TAC [← ARITH_RULE (← q r"i < M ==> i < SUC M")]], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c1:num->A->bool")
        (X_CHOOSE_THEN (← q r"M1:num") STRIP_ASSUME_TAC)) THEN
      /- Build chain within g(SUC M) from q to b -/
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"(g:num->A->bool) (SUC M)", ← q r"e:real",
                        ← q r"q:A", ← q r"b:A"]
        CHAIN_IN_OPEN_CONNECTED_SET) THEN ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [LE_REFL], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c2:num->A->bool")
        (X_CHOOSE_THEN (← q r"M2:num") STRIP_ASSUME_TAC)) THEN
      /- Pre-extract c2 closure property for easier use later -/
      SUBGOAL_THEN (← q r"!k:num. k <= M2 ==>
           (mtopology m closure_of (c2:num->A->bool) k) SUBSET
           (g:num->A->bool) (SUC M)") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN SUBGOAL_THEN
          (← q r"open_in (mtopology m) ((c2:num->A->bool) k) /\
           connected_in (mtopology m) ((c2:num->A->bool) k) /\
           (mtopology m closure_of (c2:num->A->bool) k) SUBSET
           (g:num->A->bool) (SUC M)") MP_TAC THENL [ASM_MESON_TAC [],
          DISCH_THEN (fun th => tactic_of do
            pure (ACCEPT_TAC (← CONJUNCT2 (← CONJUNCT2 th))))], ALL_TAC] THEN
      /- Concatenation: combine c1 (a to q) and c2 (q to b) -/
      MAP_EVERY EXISTS_TAC [← q r"\i:num. if i <= M1 then (c1:num->A->bool) i
                 else (c2:num->A->bool) (i - (M1 + 1))", ← q r"M1 + M2 + 1"] THEN
      CONV_TAC (DEPTH_CONV BETA_CONV) THEN /- 1: open_in and connected_in -/
      CONJ_TAC THENL [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"j:num <= M1") THEN ASM_REWRITE_TAC [] THENL
         [ASM_MESON_TAC [], SUBGOAL_THEN (← q r"j - (M1 + 1) <= M2") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ASM_MESON_TAC []]], ALL_TAC] THEN /- 2: a IN g' 0 -/
      CONJ_TAC THENL [ASM_REWRITE_TAC [LE_0], ALL_TAC] THEN /- 3: b IN g' M' -/
      CONJ_TAC THENL [SIMP_TAC [← ARITH_RULE (← q r"~(M1 + M2 + 1 <= M1)"),
                 ← ARITH_RULE (← q r"(M1 + M2 + 1) - (M1 + 1) = M2")] THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN /- 4: consecutive overlap -/
      CONJ_TAC THENL [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"j:num < M1") THENL [SUBGOAL_THEN
            (← q r"j <= M1 /\ SUC j <= M1")
            (fun th => REWRITE_TAC [th]) THENL [ASM_ARITH_TAC,
            REWRITE_TAC [← GSYM IN_INTER, MEMBER_NOT_EMPTY] THEN
            FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC],
          ASM_CASES_TAC (← q r"j:num = M1") THENL [ASM_REWRITE_TAC [LE_REFL] THEN
            SIMP_TAC [← ARITH_RULE (← q r"~(SUC M1 <= M1)"),
                      ← ARITH_RULE (← q r"SUC M1 - (M1 + 1) = 0")] THEN
            REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
            EXISTS_TAC (← q r"q:A") THEN ASM_REWRITE_TAC [],
            SUBGOAL_THEN (← q r"~(j <= M1) /\ ~(SUC j <= M1)")
              (fun th => REWRITE_TAC [th]) THENL [ASM_ARITH_TAC, ALL_TAC] THEN
            SUBGOAL_THEN (← q r"SUC j - (M1 + 1) = SUC(j - (M1 + 1))")
              (fun th => REWRITE_TAC [th]) THENL [ASM_ARITH_TAC, ALL_TAC] THEN
            SUBGOAL_THEN (← q r"j - (M1 + 1) < M2") ASSUME_TAC THENL
             [ASM_ARITH_TAC, ALL_TAC] THEN
            REWRITE_TAC [← GSYM IN_INTER, MEMBER_NOT_EMPTY] THEN
            FIRST_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC]], ALL_TAC] THEN
      /- 5: diameter bound -/
      CONJ_TAC THENL [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"j:num <= M1") THEN ASM_REWRITE_TAC [] THENL
         [ASM_MESON_TAC [], SUBGOAL_THEN (← q r"j - (M1 + 1) <= M2") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ASM_MESON_TAC []]], ALL_TAC] THEN
      /- 6: forward refinement -/
      CONJ_TAC THENL [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"j:num <= M1") THENL [ASM_REWRITE_TAC [] THEN SUBGOAL_THEN
            (← q r"?i. i <= M /\ (mtopology m closure_of (c1:num->A->bool) j) SUBSET
                 (g:num->A->bool) i") MP_TAC THENL [ASM_MESON_TAC [],
            MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"i':num") THEN
            STRIP_TAC THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC],
          ASM_REWRITE_TAC [] THEN
          EXISTS_TAC (← q r"SUC M") THEN REWRITE_TAC [LE_REFL] THEN
          SUBGOAL_THEN (← q r"j - (M1 + 1) <= M2") ASSUME_TAC THENL
           [ASM_ARITH_TAC, ASM_MESON_TAC []]], ALL_TAC] THEN
      /- 6b: monotone surjective forward refinement -/ CONJ_TAC THENL
       [EXISTS_TAC (← q r"\j:num. if j <= M1 then (ff:num->num) j else SUC M") THEN
        CONV_TAC (DEPTH_CONV BETA_CONV) THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
          ASM_CASES_TAC (← q r"j:num <= M1") THEN ASM_REWRITE_TAC [] THENL
           [ASM_MESON_TAC [← ARITH_RULE (← q r"x <= M ==> x <= SUC M")],
            REWRITE_TAC [LE_REFL] THEN
            SUBGOAL_THEN (← q r"j - (M1 + 1) <= M2") ASSUME_TAC THENL
             [ASM_ARITH_TAC, ASM_MESON_TAC []]], ALL_TAC] THEN CONJ_TAC THENL
         [MAP_EVERY X_GEN_TAC [← q r"j1:num", ← q r"j2:num"] THEN STRIP_TAC THEN
          ASM_CASES_TAC (← q r"j2:num <= M1") THENL [SUBGOAL_THEN (← q r"j1:num <= M1")
              (fun th => REWRITE_TAC [th]) THENL [ASM_ARITH_TAC, ALL_TAC] THEN
            ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
            ASM_CASES_TAC (← q r"j1:num <= M1") THENL [ASM_REWRITE_TAC [] THEN
              ASM_MESON_TAC [← ARITH_RULE (← q r"x <= M ==> x <= SUC M")],
              ASM_REWRITE_TAC [LE_REFL]]], ALL_TAC] THEN /- Surjectivity of ff -/
        X_GEN_TAC (← q r"ii':num") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"ii':num <= M") THENL
         [SUBGOAL_THEN (← q r"?j0. j0 <= M1 /\ (ff:num->num) j0 = ii'")
            STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          EXISTS_TAC (← q r"j0:num") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC,
          SUBGOAL_THEN (← q r"ii' = SUC M") SUBST_ALL_TAC THENL
           [ASM_ARITH_TAC, ALL_TAC] THEN EXISTS_TAC (← q r"SUC M1") THEN
          REWRITE_TAC [← ARITH_RULE (← q r"~(SUC n <= n)")] THEN ASM_ARITH_TAC],
        ALL_TAC] THEN /- 7: backward refinement -/
      X_GEN_TAC (← q r"ii:num") THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"ii:num <= M") THENL
       [SUBGOAL_THEN (← q r"?j. j <= M1 /\
               (mtopology m closure_of (c1:num->A->bool) j) SUBSET
               (g:num->A->bool) ii") MP_TAC THENL [ASM_MESON_TAC [],
          DISCH_THEN (X_CHOOSE_THEN (← q r"j0:num") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"j0:num") THEN ASM_REWRITE_TAC [] THEN ASM_ARITH_TAC],
        SUBGOAL_THEN (← q r"ii = SUC M") SUBST_ALL_TAC THENL
         [ASM_ARITH_TAC, ALL_TAC] THEN EXISTS_TAC (← q r"M1 + 1") THEN
        SIMP_TAC [← ARITH_RULE (← q r"~(M1 + 1 <= M1)"),
                  ← ARITH_RULE (← q r"(M1 + 1) - (M1 + 1) = 0")] THEN
        CONJ_TAC THENL [ASM_ARITH_TAC, ASM_MESON_TAC [LE_0]]]])

  return { CHAIN_REFINEMENT_STEP }

/- ------------------------------------------------------------------------- -/
/- Chain hierarchy.  (metric.ml 36791-36869)                                 -/
/- ------------------------------------------------------------------------- -/

structure CHH where
  CHAIN_HIERARCHY : thm
  deriving Inhabited

@[nospecialize]
def setupCHH [HolBase] (D : MetricDeps) (BTopology : Topology) (BMTopology : MTopology)
    (BConnected1 : Connected1) (BPC2 : PC2) (BCRS : CRS) : ExceptT String IO CHH := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_MESON_TAC, MESON_TAC, NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, .. } := D
  let { DEPENDENT_CHOICE, .. } := D.core1
  let { REAL_LT_INV_EQ, REAL_OF_NUM_LT, .. } := D.core3
  let { FORALL_AND_THM, FST, SND, .. } := D.core5
  let { OPEN_IN_TOPSPACE, .. } := BTopology
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_TOPSPACE, .. } := BConnected1
  let { CHAIN_IN_OPEN_CONNECTED_SET, .. } := BPC2
  let { CHAIN_REFINEMENT_STEP, .. } := BCRS
  -- @@SCOPE END

  -- Helper: chain hierarchy construction via DEPENDENT_CHOICE.
  -- Builds a sequence of increasingly fine chains from a to b.

  let CHAIN_HIERARCHY ← prove
   r"!m:A metric a b.
    connected_space (mtopology m) /\
    locally_connected_space (mtopology m) /\ a IN mspace m /\ b IN mspace m
    ==> ?c (N:num->num). (!n i. i <= N n
                 ==> open_in (mtopology m) ((c:num->num->A->bool) n i)) /\
          (!n i. i <= N n ==> connected_in (mtopology m) (c n i)) /\
          (!n. (a:A) IN c n 0) /\ (!n. b IN c n (N n)) /\
          (!n i. i < N n ==> ~(c n i INTER c n (SUC i) = {})) /\
          (!n i. i <= N n ==> !x y. x IN c n i /\ y IN c n i
                           ==> mdist m (x:A,y) < inv(&(n + 1))) /\
          (!n j. j <= N(SUC n) ==> ?i. i <= N n /\
                     (mtopology m closure_of c (SUC n) j) SUBSET c n i) /\
          (!n i. i <= N n ==> ?j. j <= N(SUC n) /\ (mtopology m closure_of
                       (c:num->num->A->bool) (SUC n) j) SUBSET c n i) /\
          (!n. ?ff. (!j. j <= N(SUC n) ==> ff j <= N n /\
                             (mtopology m closure_of
                               (c:num->num->A->bool) (SUC n) j) SUBSET
                             c n (ff j)) /\
                    (!j1 j2. j1 <= j2 /\ j2 <= N(SUC n) ==> ff j1 <= ff j2) /\
                    (!i. i <= N n ==> ?j. j <= N(SUC n) /\ ff j = i))"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
      [← q r"\n (p:num#(num->A->bool)). (!i. i <= FST p
               ==> open_in (mtopology m) (SND p i) /\
                   connected_in (mtopology m) (SND p i)) /\
          (a:A) IN SND p 0 /\ b IN SND p (FST p) /\
          (!i. i < FST p ==> ~(SND p i INTER SND p (SUC i) = {})) /\
          (!i. i <= FST p ==> !x y. x IN SND p i /\ y IN SND p i
                          ==> mdist m (x:A,y) < inv(&(n + 1)))",
       ← q r"\(n:num) (p1:num#(num->A->bool)) (p2:num#(num->A->bool)).
          (?ff. (!j. j <= FST p2 ==> ff j <= FST p1 /\
                      (mtopology m closure_of SND p2 j) SUBSET SND p1 (ff j)) /\
                (!j1 j2. j1 <= j2 /\ j2 <= FST p2 ==> ff j1 <= ff j2) /\
                (!i. i <= FST p1 ==> ?j. j <= FST p2 /\ ff j = i)) /\
          (!j. j <= FST p2 ==> ?i. i <= FST p1 /\
                   (mtopology m closure_of SND p2 j) SUBSET SND p1 i) /\
          (!i. i <= FST p1 ==> ?j. j <= FST p2 /\
                   (mtopology m closure_of SND p2 j) SUBSET SND p1 i)"]
      DEPENDENT_CHOICE) THEN CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    REWRITE_TAC [FST, SND] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [/- Base case: exists initial chain at level 0 -/
        SUBGOAL_THEN (← q r"open_in (mtopology m) (mspace m:A->bool) /\
           connected_in (mtopology m) (mspace m:A->bool)")
          STRIP_ASSUME_TAC THENL [CONJ_TAC THENL
           [MESON_TAC [OPEN_IN_TOPSPACE, TOPSPACE_MTOPOLOGY],
            ASM_MESON_TAC [CONNECTED_IN_TOPSPACE, TOPSPACE_MTOPOLOGY]],
          ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"m:A metric", ← q r"mspace m:A->bool", ← q r"inv(&1)",
                          ← q r"a:A", ← q r"b:A"]
          CHAIN_IN_OPEN_CONNECTED_SET) THEN ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV, ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c0:num->A->bool")
          (X_CHOOSE_THEN (← q r"M0:num") STRIP_ASSUME_TAC)) THEN
        EXISTS_TAC (← q r"(M0:num, c0:num->A->bool)") THEN REWRITE_TAC [FST, SND] THEN
        CONV_TAC NUM_REDUCE_CONV THEN ASM_MESON_TAC [],
        /- Step case: refine existing chain -/
        MAP_EVERY X_GEN_TAC [← q r"nn:num", ← q r"xx:num#(num->A->bool)"] THEN
        STRIP_TAC THEN MP_TAC (← ISPECL [← q r"m:A metric",
           ← q r"SND(xx:num#(num->A->bool))",
           ← q r"FST(xx:num#(num->A->bool))", ← q r"inv(&(SUC nn + 1))", ← q r"a:A",
           ← q r"b:A"]
          CHAIN_REFINEMENT_STEP) THEN ANTS_TAC THENL
         [ASM_REWRITE_TAC [REAL_LT_INV_EQ, REAL_OF_NUM_LT] THEN
          ARITH_TAC, ALL_TAC] THEN DISCH_THEN (X_CHOOSE_THEN (← q r"g':num->A->bool")
          (X_CHOOSE_THEN (← q r"MM:num") STRIP_ASSUME_TAC)) THEN
        EXISTS_TAC (← q r"(MM:num, g':num->A->bool)") THEN
        ASM_REWRITE_TAC [FST, SND] THEN
        REPEAT CONJ_TAC THEN ASM_REWRITE_TAC [] THEN
        TRY (EXISTS_TAC (← q r"ff:num->num") THEN
            REPEAT CONJ_TAC THEN FIRST_ASSUM MATCH_ACCEPT_TAC) THEN
        ASM_MESON_TAC []], ALL_TAC] THEN
    /- Extract c and N from the DEPENDENT_CHOICE result -/
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->num#(num->A->bool)") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\n. SND ((f:num->num#(num->A->bool)) n)") THEN
    EXISTS_TAC (← q r"\n. FST ((f:num->num#(num->A->bool)) n)") THEN
    CONV_TAC (TOP_DEPTH_CONV BETA_CONV) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [FORALL_AND_THM]) THEN
    REPEAT (FIRST_X_ASSUM (CONJUNCTS_THEN ASSUME_TAC)) THEN REPEAT CONJ_TAC THEN
    TRY (FIRST_ASSUM MATCH_ACCEPT_TAC) THEN ASM_MESON_TAC [])

  return { CHAIN_HIERARCHY }

/- ------------------------------------------------------------------------- -/
/- Dyadic approximation.  (metric.ml 36871-37773)                            -/
/- ------------------------------------------------------------------------- -/

structure MDA where
  MCOMPLETE_DYADIC_APPROXIMATION : thm
  deriving Inhabited

@[nospecialize]
def setupMDA [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BConnected1 : Connected1)
    (BPC2 : PC2) : ExceptT String IO MDA := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_TAC, let_CONV,
        NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, SELECT_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, ADD_SUB2, ARITH, ARITH_EQ, DEPENDENT_CHOICE, DIVISION, DIV_ADD_EQ,
        DIV_LT, DIV_MONO, DIV_MULT, EQ_TRANS, EXP, EXP_ADD, EXP_EQ_0, FINITE_IMAGE,
        FINITE_INSERT, FINITE_NUMSEG_LE, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, .. } := D.core1
  let { IN_INTER, LEFT_ADD_DISTRIB, LEFT_IMP_EXISTS_THM, LET_TRANS, LE_0, LE_CASES, LE_EXISTS,
        LE_EXP, LE_LDIV_EQ, LE_MULT_LCANCEL, LE_MULT_RCANCEL, LE_REFL, LE_TRANS, LT_IMP_LE,
        LT_LE, LT_NZ, LT_POW2_REFL, LT_TRANS, MEMBER_NOT_EMPTY, MOD_ADD_EQ, MOD_LT, MOD_MULT,
        MULT_ASSOC, MULT_CLAUSES, MULT_SYM, NOT_LE, NOT_SUC, REAL_ABS_DIV, REAL_ABS_MUL,
        REAL_ABS_NUM, .. } := D.core2
  let { REAL_ABS_POW, REAL_ABS_SUB, REAL_ADD_RDISTRIB, REAL_DIV_LMUL, REAL_DIV_POW2,
        REAL_DIV_REFL, REAL_DIV_RMUL, REAL_INV_MUL, REAL_LE_INV2, REAL_LE_LDIV_EQ,
        REAL_LE_RDIV_EQ, REAL_LTE_TRANS, REAL_LT_01, REAL_LT_IMP_NZ, REAL_LT_INV_EQ,
        REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_LT_POW2, REAL_LT_RDIV_EQ, REAL_LT_RMUL_EQ,
        REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_RID,
        REAL_MUL_RINV, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_OF_NUM_MUL, REAL_OF_NUM_POW, REAL_POS, REAL_POW_ADD, REAL_POW_EQ_0,
        REAL_POW_MONO, REAL_POW_SUB, .. } := D.core3
  let { REAL_SUB_RDISTRIB, SKOLEM_THM, SUBSET, SUBSET_TRANS, SUB_REFL, TRANSITIVE_STEPWISE_LE,
        TRANSITIVE_STEPWISE_LT, real_div, real_pow, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_AND_THM, FORALL_PAIR_THM, RIGHT_IMP_EXISTS_THM, .. } :=
    D.core5
  let { MONOTONE_BIGGER, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { INTEGER_CLOSED, REAL_EQ_INTEGERS_IMP, REAL_LT_INTEGERS, .. } := D.lib
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { CLOSURE_OF_SUBSET, .. } := BClosure
  let { MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { OPEN_IN_MSPACE, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_TOPSPACE, .. } := BConnected1
  let { CHAIN_IN_OPEN_CONNECTED_SET, .. } := BPC2
  -- @@SCOPE END

  -- Helper lemma: construct a uniformly continuous function on dyadic
  -- rationals D = {k/2^n | k <= 2^n} mapping into a complete connected
  -- locally connected metric space. This is the core of the Menger theorem.

  let MCOMPLETE_DYADIC_APPROXIMATION ← do
    let DYADIC_PRECISION_RAISE' ← prove
     r"!k n n'. n <= n' /\ k <= 2 EXP n
              ==> k * 2 EXP (n' - n) <= 2 EXP n' /\
                  &(k * 2 EXP (n' - n)) / &2 pow n' =
                  &k / &2 pow n"
     (REPEAT GEN_TAC THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN STRIP_TAC THEN
      CONJ_TAC THENL
       [TRANS_TAC LE_TRANS (← q r"2 EXP (n' - n) * 2 EXP n") THEN
        ASM_REWRITE_TAC [LE_MULT_LCANCEL, ← GSYM EXP_ADD] THEN
        ASM_SIMP_TAC [← ARITH_RULE (← q
          r"n <= n' ==> (n' - n) + n = n':num"), LE_REFL],
        REWRITE_TAC [← GSYM REAL_OF_NUM_MUL,
                     ← GSYM REAL_OF_NUM_POW] THEN
        ASM_SIMP_TAC [REAL_POW_SUB,
                      REAL_OF_NUM_EQ, ARITH_EQ] THEN
        SIMP_TAC [REAL_LT_POW2, ← REAL_FIELD (← q
         r"&0 < a /\ &0 < b
          ==> (a / b * m) / a = m / b")]])
    let STEP_MONO_IMP_STRICT ← prove
     r"!(f:num->num). (!n. f(n) < f(SUC n))
                    ==> !m n. m < n ==> f(m) < f(n)"
     (GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LT THEN
      ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [LT_TRANS])
    let STEP_MONO_IMP_MONO ← prove
     r"!(f:num->num). (!n. f(n) < f(SUC n))
                    ==> !m n. m <= n ==> f(m) <= f(n)"
     (GEN_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
      ASM_REWRITE_TAC [LE_REFL] THEN
      ASM_MESON_TAC [LE_TRANS, LT_IMP_LE])
    let STEP_MONO_IMP_UNBOUNDED ← prove
     r"!(f:num->num). (!n. f(n) < f(SUC n)) ==> !n. n <= f(n)"
     (GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC MONOTONE_BIGGER THEN
      ASM_MESON_TAC [STEP_MONO_IMP_STRICT])
    let ITERATED_REFINEMENT ← prove
     r"!(f:num->num) (g:num->num->B). (!n k. k <= 2 EXP f(n)
             ==> g(SUC n)(2 EXP (f(SUC n) - f(n)) * k) = g(n) k) /\
      (!j1 j2. j1 <= j2 ==> f(j1) <= f(j2)) ==> !d j k. k <= 2 EXP f(j)
                  ==> g(j + d)(2 EXP (f(j + d) - f(j)) * k) = g(j) k"
     (GEN_TAC THEN GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THENL
       [REWRITE_TAC [ADD_CLAUSES, SUB_REFL, EXP, MULT_CLAUSES], ALL_TAC] THEN
      REPEAT GEN_TAC THEN DISCH_TAC THEN
      REWRITE_TAC [ADD_CLAUSES] THEN SUBGOAL_THEN
       (← q r"f(SUC(j + d)):num - f(j) =
        (f(SUC(j + d)) - f(j + d)) + (f(j + d) - f(j))")
       SUBST1_TAC THENL [MATCH_MP_TAC (← ARITH_RULE (← q
         r"a <= b /\ b <= c ==> c - a:num = (c - b) + (b - a)")) THEN
        CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC, ALL_TAC] THEN
      REWRITE_TAC [EXP_ADD, ← GSYM MULT_ASSOC] THEN SUBGOAL_THEN
       (← q r"(g:num->num->B)(SUC(j + d))
         (2 EXP (f(SUC(j + d)):num - f(j + d)) * (2 EXP (f(j + d) - f(j)) * k)) =
        g(j + d)(2 EXP (f(j + d) - f(j)) * k)")
       SUBST1_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN TRANS_TAC LE_TRANS
         (← q r"2 EXP (f(j + d:num) - f(j)) * 2 EXP f(j)") THEN CONJ_TAC THENL
         [REWRITE_TAC [LE_MULT_LCANCEL] THEN DISJ2_TAC THEN
          FIRST_X_ASSUM ACCEPT_TAC, REWRITE_TAC [← GSYM EXP_ADD] THEN
          SUBGOAL_THEN (← q r"(f:num->num) j <= f(j + d:num)") ASSUME_TAC THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC, ALL_TAC] THEN SUBGOAL_THEN
           (← q r"((f:num->num)(j + d:num) - f(j)) + f(j) = f(j + d)")
           (fun th => REWRITE_TAC [th, LE_REFL]) THEN ASM_ARITH_TAC],
        ALL_TAC] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        FIRST_X_ASSUM ACCEPT_TAC)
    let DYADIC_FRACTION_EQ_IMP ← prove
     r"!m1 m2 p1 p2. p1 <= p2 /\ &m1 / &2 pow p1 = &m2 / &2 pow p2
       ==> m2 = 2 EXP (p2 - p1) * m1"
     (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      SIMP_TAC [← REAL_FIELD (← q r"~(y = &0) /\ ~(y' = &0)
                          ==> (x / y = x' / y' <=> y' / y * x = x')"),
         REAL_POW_EQ_0, REAL_OF_NUM_EQ, ARITH_EQ] THEN
      ASM_SIMP_TAC [REAL_DIV_POW2, REAL_OF_NUM_EQ, ARITH_EQ] THEN
      REWRITE_TAC [REAL_OF_NUM_POW, REAL_OF_NUM_MUL, REAL_OF_NUM_EQ] THEN
      DISCH_THEN (fun th => tactic_of do pure (ACCEPT_TAC (← SYM th))))
    let DIV_NEARBY_BOUND ← prove
     r"!a b K. ~(K = 0) /\ b < a + K ==> b DIV K <= SUC(a DIV K)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [ADD1] THEN ASM_SIMP_TAC [LE_LDIV_EQ] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = n + 2")] THEN
      MATCH_MP_TAC (← ARITH_RULE (← q
       r"b < a + K /\ a < K * (a DIV K + 1) ==> b < K * (a DIV K + 2)")) THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← SPECL [← q r"a:num", ← q r"K:num"] DIVISION) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [LEFT_ADD_DISTRIB, MULT_CLAUSES] THEN
      ONCE_REWRITE_TAC [MULT_SYM] THEN ARITH_TAC)
    let DYADIC_FRACTION_CLOSE_EQ ← prove
     r"!n a b. abs(&a / &2 pow n - &b / &2 pow n) < inv(&2 pow n) ==> a = b"
     (REPEAT GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [← GSYM REAL_OF_NUM_EQ] THEN
      MATCH_MP_TAC REAL_EQ_INTEGERS_IMP THEN REWRITE_TAC [INTEGER_CLOSED] THEN
      POP_ASSUM MP_TAC THEN SIMP_TAC [REAL_LT_POW2, ← REAL_FIELD (← q
       r"&0 < p ==> a / p - b / p = (a - b) / p")] THEN
      REWRITE_TAC [REAL_ABS_DIV, REAL_ABS_POW, REAL_ABS_NUM] THEN
      SIMP_TAC [REAL_LT_LDIV_EQ, REAL_LT_POW2] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"y = &1 ==> x < y ==> x < &1")) THEN
      MATCH_MP_TAC REAL_MUL_LINV THEN
      MP_TAC (← SPEC (← q r"n:num") REAL_LT_POW2) THEN REAL_ARITH_TAC)
    prove
     r"!m:A metric a b.
    mcomplete m /\ connected_space (mtopology m) /\
    locally_connected_space (mtopology m) /\ a IN mspace m /\ b IN mspace m
    ==> ?f:real->A. f(&0) = a /\ f(&1) = b /\
         (!m' n. m' <= 2 EXP n ==> f(&m' / &2 pow n) IN mspace m) /\
         (!j. ?d. &0 < d /\ !n m1 m2. m1 <= 2 EXP n /\ m2 <= 2 EXP n /\
                            abs(&m1 / &2 pow n - &m2 / &2 pow n) < d
                            ==> mdist m (f(&m1 / &2 pow n),
                                         f(&m2 / &2 pow n):A)
                                < inv(&2 pow j))"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      /- Step 1: DEPENDENT_CHOICE for per-level chain sequence -/
      SUBGOAL_THEN (← q r"?t:num->num#(num->A). (!n. SND(t n) 0 = (a:A) /\
             (!i. 2 EXP (FST(t n)) <= i ==> SND(t n) i = (b:A)) /\
