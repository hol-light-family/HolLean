structure KSp4 where
  CLOSED_MAP_INTO_K_SPACE : thm
  OPEN_MAP_INTO_K_SPACE : thm
  QUOTIENT_MAP_INTO_K_SPACE : thm
  QUOTIENT_MAP_INTO_K_SPACE_EQ : thm
  OPEN_MAP_INTO_K_SPACE_EQ : thm
  CLOSED_MAP_INTO_K_SPACE_EQ : thm
  PROPER_MAP_INTO_K_SPACE : thm
  PROPER_MAP_INTO_K_SPACE_EQ : thm
  COMPACT_IMP_PROPER_MAP : thm
  PROPER_EQ_COMPACT_MAP : thm
  COMPACT_IMP_PERFECT_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupKSp4 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient)
    (BCompact1 : Compact1) (BKC1 : KC1) (BProper1 : Proper1) (BProper2 : Proper2)
    (BPerfect : Perfect) (BKSp1 : KSp1) : ExceptT String IO KSp4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { IMP_IMP, INTER_COMM, INTER_SUBSET, IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SUBSET_INTER, .. } := D.core4
  let { CLOSED_IN_SUBSET, OPEN_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } :=
    BContMap1
  let { CLOSED_MAP_IMP_SUBSET_TOPSPACE, CLOSED_MAP_RESTRICTION, OPEN_MAP_IMP_SUBSET_TOPSPACE,
        OPEN_MAP_RESTRICTION, closed_map, open_map, .. } := BOpenClosed1
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_MAP,
        QUOTIENT_MAP_RESTRICTION, .. } := BQuotient
  let { COMPACT_IN_SING, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN_GEN, KC_SPACE_SUBTOPOLOGY, kc_space, .. } := BKC1
  let { PROPER_MAP_ALT, PROPER_MAP_IMP_SUBSET_TOPSPACE, proper_map, .. } := BProper1
  let { COMPACT_IMP_PROPER_MAP_GEN, PROPER_MAP_RESTRICTION, .. } := BProper2
  let { perfect_map, .. } := BPerfect
  let { K_SPACE, K_SPACE_OPEN, .. } := BKSp1
  -- @@SCOPE END

  let CLOSED_MAP_INTO_K_SPACE ← prove
   r"!top top' (f:A->B).
      k_space top' /\
      IMAGE f (topspace top) SUBSET topspace top' /\
      (!k. compact_in top' k
           ==> closed_map(subtopology top {x | x IN topspace top /\ f x IN k},
                          subtopology top' k) f)
      ==> closed_map(top,top') f"
   (REWRITE_TAC [K_SPACE] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [closed_map] THEN X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"k:B->bool") THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"k INTER IMAGE f c =
      IMAGE (f:A->B) ({x | x IN topspace top /\ f x IN k} INTER c)")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:B->bool")) THEN
    ASM_REWRITE_TAC [closed_map] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED])

  let OPEN_MAP_INTO_K_SPACE ← prove
   r"!top top' (f:A->B).
      k_space top' /\
      IMAGE f (topspace top) SUBSET topspace top' /\
      (!k. compact_in top' k
           ==> open_map(subtopology top {x | x IN topspace top /\ f x IN k},
                        subtopology top' k) f)
      ==> open_map(top,top') f"
   (REWRITE_TAC [K_SPACE_OPEN] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [open_map] THEN X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"k:B->bool") THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"k INTER IMAGE f c =
      IMAGE (f:A->B) ({x | x IN topspace top /\ f x IN k} INTER c)")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:B->bool")) THEN
    ASM_REWRITE_TAC [open_map] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN])

  let QUOTIENT_MAP_INTO_K_SPACE ← prove
   r"!top top' (f:A->B).
     k_space top' /\
     continuous_map(top,top') f /\
     IMAGE f (topspace top) = topspace top' /\
     (!k. compact_in top' k
          ==> quotient_map(subtopology top {x | x IN topspace top /\ f x IN k},
                           subtopology top' k) f)
     ==> quotient_map(top,top') f"
   (REWRITE_TAC [K_SPACE] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP] THEN X_GEN_TAC (← q r"c:B->bool") THEN DISCH_TAC THEN
    EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [CLOSED_IN_CONTINUOUS_MAP_PREIMAGE]] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"k:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:B->bool")) THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"k INTER c:B->bool") o CONJUNCT2) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    REWRITE_TAC [← SET_RULE (← q
     r"{x | x IN topspace top INTER {x | x IN topspace top /\ f x IN k} /\
           f x IN k INTER c} =
      {x | x IN topspace top /\ f x IN k} INTER
      {x | x IN topspace top /\ f x IN c}")] THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED])

  let QUOTIENT_MAP_INTO_K_SPACE_EQ ← prove
   r"!top top' (f:A->B).
        k_space top' /\ kc_space top'
        ==> (quotient_map(top,top') f <=>
             continuous_map(top,top') f /\
             IMAGE f (topspace top) = topspace top' /\
             !k. compact_in top' k
                  ==> quotient_map
                       (subtopology top {x | x IN topspace top /\ f x IN k},
                        subtopology top' k) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [ASM_SIMP_TAC [QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_IMP_CONTINUOUS_MAP] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC QUOTIENT_MAP_RESTRICTION THEN
      RULE_ASSUM_TAC (REWRITE_RULE [kc_space]) THEN ASM_SIMP_TAC [],
      MATCH_MP_TAC QUOTIENT_MAP_INTO_K_SPACE THEN ASM_REWRITE_TAC []])

  let OPEN_MAP_INTO_K_SPACE_EQ ← prove
   r"!top top' (f:A->B).
        k_space top'
        ==> (open_map(top,top') f <=>
             IMAGE f (topspace top) SUBSET topspace top' /\
             !k. compact_in top' k
                  ==> open_map
                       (subtopology top {x | x IN topspace top /\ f x IN k},
                        subtopology top' k) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [OPEN_MAP_INTO_K_SPACE] THEN
    ASM_SIMP_TAC [OPEN_MAP_IMP_SUBSET_TOPSPACE] THEN
    ASM_SIMP_TAC [OPEN_MAP_RESTRICTION])

  let CLOSED_MAP_INTO_K_SPACE_EQ ← prove
   r"!top top' (f:A->B).
        k_space top'
        ==> (closed_map(top,top') f <=>
             IMAGE f (topspace top) SUBSET topspace top' /\
             !k. compact_in top' k
                  ==> closed_map
                       (subtopology top {x | x IN topspace top /\ f x IN k},
                        subtopology top' k) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CLOSED_MAP_INTO_K_SPACE] THEN
    ASM_SIMP_TAC [CLOSED_MAP_IMP_SUBSET_TOPSPACE] THEN
    ASM_SIMP_TAC [CLOSED_MAP_RESTRICTION])

  let PROPER_MAP_INTO_K_SPACE ← prove
   r"!top top' (f:A->B).
      k_space top' /\
      IMAGE f (topspace top) SUBSET topspace top' /\
      (!k. compact_in top' k
           ==> proper_map(subtopology top {x | x IN topspace top /\ f x IN k},
                          subtopology top' k) f)
      ==> proper_map(top,top') f"
   (REWRITE_TAC [proper_map] THEN REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC CLOSED_MAP_INTO_K_SPACE THEN ASM_SIMP_TAC [],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y:B}")) THEN
      ASM_REWRITE_TAC [COMPACT_IN_SING] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y:B") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, TOPSPACE_SUBTOPOLOGY, IN_SING] THEN
      REWRITE_TAC [← TAUT (← q r"(p /\ p /\ q) /\ q <=> p /\ q")] THEN
      SIMP_TAC [COMPACT_IN_SUBTOPOLOGY]])

  let PROPER_MAP_INTO_K_SPACE_EQ ← prove
   r"!top top' (f:A->B).
        k_space top'
        ==> (proper_map(top,top') f <=>
             IMAGE f (topspace top) SUBSET topspace top' /\
             !k. compact_in top' k
                  ==> proper_map
                       (subtopology top {x | x IN topspace top /\ f x IN k},
                        subtopology top' k) f)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [PROPER_MAP_INTO_K_SPACE] THEN
    ASM_SIMP_TAC [PROPER_MAP_IMP_SUBSET_TOPSPACE] THEN
    ASM_SIMP_TAC [PROPER_MAP_RESTRICTION])

  let COMPACT_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        k_space top' /\ kc_space top' /\
        IMAGE f (topspace top) SUBSET topspace top' /\
        (continuous_map(top,top') f \/ kc_space top) /\
        (!k. compact_in top' k
             ==> compact_in top {x | x IN topspace top /\ f x IN k})
        ==> proper_map(top,top') f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]
     COMPACT_IMP_PROPER_MAP_GEN) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [K_SPACE]) THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"k:B->bool") THEN
    DISCH_TAC THEN MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN_GEN THEN
    ASM_SIMP_TAC [KC_SPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, INTER_SUBSET] THEN
    ASM_MESON_TAC [INTER_COMM])

  let PROPER_EQ_COMPACT_MAP ← prove
   r"!top top' (f:A->B).
        k_space top' /\ kc_space top' /\
        (continuous_map(top,top') f \/ kc_space top)
        ==> (proper_map(top,top') f <=>
             IMAGE f (topspace top) SUBSET topspace top' /\
             !k. compact_in top' k
                 ==> compact_in top {x | x IN topspace top /\ f x IN k})"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [SIMP_TAC [PROPER_MAP_IMP_SUBSET_TOPSPACE] THEN
      SIMP_TAC [PROPER_MAP_ALT],
      STRIP_TAC THEN MATCH_MP_TAC COMPACT_IMP_PROPER_MAP THEN
      ASM_REWRITE_TAC []])

  let COMPACT_IMP_PERFECT_MAP ← prove
   r"!top top' (f:A->B).
        k_space top' /\ kc_space top' /\
        continuous_map(top,top') f /\ IMAGE f (topspace top) = topspace top' /\
        (!k. compact_in top' k
             ==> compact_in top {x | x IN topspace top /\ f x IN k})
        ==> perfect_map(top,top') f"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [perfect_map] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    MATCH_MP_TAC COMPACT_IMP_PROPER_MAP THEN ASM_REWRITE_TAC [])

  return { CLOSED_MAP_INTO_K_SPACE, OPEN_MAP_INTO_K_SPACE, QUOTIENT_MAP_INTO_K_SPACE,
           QUOTIENT_MAP_INTO_K_SPACE_EQ, OPEN_MAP_INTO_K_SPACE_EQ, CLOSED_MAP_INTO_K_SPACE_EQ,
           PROPER_MAP_INTO_K_SPACE, PROPER_MAP_INTO_K_SPACE_EQ, COMPACT_IMP_PROPER_MAP,
           PROPER_EQ_COMPACT_MAP, COMPACT_IMP_PERFECT_MAP }

/- ------------------------------------------------------------------------- -/
/- More generally, the k-ification functor.  (metric.ml 28518-28625)         -/
/- ------------------------------------------------------------------------- -/

structure KIF1 where
  kification : thm
  OPEN_IN_KIFICATION : thm
  OPEN_IN_KIFICATION_FINER : thm
  TOPSPACE_KIFICATION : thm
  CLOSED_IN_KIFICATION : thm
  CLOSED_IN_KIFICATION_FINER : thm
  KIFICATION_EQ_SELF : thm
  COMPACT_IN_KIFICATION : thm
  COMPACT_SPACE_KIFICATION : thm
  KIFICATION_KIFICATION : thm
  K_SPACE_KIFICATION : thm
  deriving Inhabited

@[nospecialize]
def setupKIF1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BKSp1 : KSp1) : ExceptT String IO KIF1 := do
  -- @@SCOPE BEGIN
  let { define, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } :=
    D.core1
  let { INTER_EMPTY, INTER_UNIONS, IN_ELIM_THM, MONO_EXISTS, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET_DIFF, SUBSET_REFL, SWAP_FORALL_THM,
        UNIONS_SUBSET, .. } := D.core4
  let { RIGHT_AND_FORALL_THM, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_UNIONS,
        TOPOLOGY_EQ, closed_in, istopology, topology_tybij, topspace, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        OPEN_IN_SUBTOPOLOGY_REFL, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } :=
    BSubtopology
  let { COMPACT_IN_CONTRACTIVE, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBSPACE, COMPACT_SPACE,
        compact_in, compact_space, .. } := BCompact1
  let { K_SPACE_ALT, .. } := BKSp1
  -- @@SCOPE END

  let kification ← define
   r"kification (top:A topology) =
        topology {s | s SUBSET topspace top /\
                      !k. compact_in top k
                           ==> open_in (subtopology top k) (k INTER s)}"

  let OPEN_IN_KIFICATION ← prove
   r"!top (u:A->bool).
        open_in (kification top) u <=>
        u SUBSET topspace top /\
        !k. compact_in top k  ==> open_in (subtopology top k) (k INTER u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [kification] THEN
    W (fun g => tactic_of do
      let t ← liftExcept (do let l ← lhand (snd g); rator l)
      let th ← PART_MATCH (lhand o rand) (← CONJUNCT2 topology_tybij) t
      pure (MP_TAC (← EQ_IMP_RULE th).1)) THEN
    ANTS_TAC THENL [ALL_TAC, SIMP_TAC [IN_ELIM_THM]] THEN
    REWRITE_TAC [istopology, IN_ELIM_THM, INTER_EMPTY, EMPTY_SUBSET] THEN
    SIMP_TAC [OPEN_IN_EMPTY, UNIONS_SUBSET, INTER_UNIONS] THEN CONJ_TAC THEN
    (REPEAT STRIP_TAC THENL [ASM SET_TAC [], ALL_TAC]) THENL
     [ONCE_REWRITE_TAC [← SET_RULE (← q
       r"k INTER s INTER t = (k INTER s) INTER (k INTER t)")] THEN
      ASM_SIMP_TAC [OPEN_IN_INTER],
      MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM SET_TAC []])

  let OPEN_IN_KIFICATION_FINER ← prove
   r"!top (s:A->bool).
        open_in top s ==> open_in (kification top) s"
   (SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
              OPEN_IN_KIFICATION, OPEN_IN_SUBSET])

  let TOPSPACE_KIFICATION ← prove
   r"!top:A topology. topspace(kification top) = topspace top"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [topspace] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"s IN u /\ (!t. t IN u ==> t SUBSET s) ==> UNIONS u = s")) THEN
    SIMP_TAC [IN_ELIM_THM, OPEN_IN_KIFICATION, SUBSET_REFL] THEN
    SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, OPEN_IN_SUBTOPOLOGY_REFL,
              ← SET_RULE (← q r"s SUBSET u ==> s INTER u = s")])

  let CLOSED_IN_KIFICATION ← prove
   r"!top (u:A->bool).
        closed_in (kification top) u <=>
        u SUBSET topspace top /\
        !k. compact_in top k  ==> closed_in (subtopology top k) (k INTER u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_in, TOPSPACE_KIFICATION] THEN
    ASM_CASES_TAC (← q r"(u:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [OPEN_IN_KIFICATION, TOPSPACE_SUBTOPOLOGY, SUBSET_DIFF] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"u SUBSET v ==> k INTER u SUBSET v INTER k")] THEN
    REWRITE_TAC [← SET_RULE (← q r"u INTER k DIFF k INTER s = k INTER (u DIFF s)")])

  let CLOSED_IN_KIFICATION_FINER ← prove
   r"!top (s:A->bool).
        closed_in top s ==> closed_in (kification top) s"
   (SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED,
              CLOSED_IN_KIFICATION, CLOSED_IN_SUBSET])

  let KIFICATION_EQ_SELF ← prove
   r"!top:A topology. kification top = top <=> k_space top"
   (REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_KIFICATION, K_SPACE_ALT] THEN
    MESON_TAC [OPEN_IN_SUBSET])

  let COMPACT_IN_KIFICATION ← prove
   r"!top (k:A->bool).
        compact_in (kification top) k <=> compact_in top k"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [COMPACT_IN_CONTRACTIVE, OPEN_IN_KIFICATION_FINER,
                 TOPSPACE_KIFICATION],
      DISCH_TAC THEN REWRITE_TAC [compact_in]] THEN
    ASM_SIMP_TAC [TOPSPACE_KIFICATION, COMPACT_IN_SUBSET_TOPSPACE] THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN REWRITE_TAC [OPEN_IN_KIFICATION] THEN
    REWRITE_TAC [RIGHT_AND_FORALL_THM, RIGHT_IMP_FORALL_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"k:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPACT_IN_SUBSPACE]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [COMPACT_SPACE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (\u:A->bool. k INTER u) U")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"k INTER u = k <=> k SUBSET u")])

  let COMPACT_SPACE_KIFICATION ← prove
   r"!top:A topology. compact_space(kification top) <=> compact_space top"
   (REWRITE_TAC [compact_space, COMPACT_IN_KIFICATION, TOPSPACE_KIFICATION])

  let KIFICATION_KIFICATION ← prove
   r"!top:A topology. kification(kification top) = kification top"
   (REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_KIFICATION, TOPSPACE_KIFICATION,
                 COMPACT_IN_KIFICATION] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [OPEN_IN_KIFICATION_FINER]] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_KIFICATION]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"k:A->bool"))) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let K_SPACE_KIFICATION ← prove
   r"!top:A topology. k_space(kification top)"
   (REWRITE_TAC [← GSYM KIFICATION_EQ_SELF, KIFICATION_KIFICATION])

  return { kification, OPEN_IN_KIFICATION, OPEN_IN_KIFICATION_FINER, TOPSPACE_KIFICATION,
           CLOSED_IN_KIFICATION, CLOSED_IN_KIFICATION_FINER, KIFICATION_EQ_SELF,
           COMPACT_IN_KIFICATION, COMPACT_SPACE_KIFICATION, KIFICATION_KIFICATION,
           K_SPACE_KIFICATION }

/- ------------------------------------------------------------------------- -/
/- k-ification and maps.  (metric.ml 28627-28735)                            -/
/- ------------------------------------------------------------------------- -/

structure KIF2 where
  CONTINUOUS_MAP_INTO_KIFICATION : thm
  CONTINUOUS_MAP_FROM_KIFICATION : thm
  CONTINUOUS_MAP_KIFICATION : thm
  SUBTOPOLOGY_KIFICATION_COMPACT : thm
  SUBTOPOLOGY_KIFICATION_FINER : thm
  PROPER_MAP_FROM_KIFICATION : thm
  PERFECT_MAP_FROM_KIFICATION : thm
  K_SPACE_PERFECT_MAP_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupKIF2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BHomeoSpace : HomeoSpace) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BProper1 : Proper1) (BPerfect : Perfect) (BKSp1 : KSp1)
    (BKSp4 : KSp4) (BKIF1 : KIF1) : ExceptT String IO KIF2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { ETA_AX, FORALL_IN_GSPEC, IMAGE_ID, .. } := D.core1
  let { INTER_COMM, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SUBSET_REFL, SUBSET_RESTRICT, o_DEF, .. } := D.core4
  let { TOPOLOGY_EQ, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_ALT, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_SPACE, .. } := BHomeoSpace
  let { COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { PROPER_MAP_ALT, .. } := BProper1
  let { HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP, PERFECT_IMP_CONTINUOUS_MAP,
        PERFECT_MAP_FROM_COMPOSITION_RIGHT, perfect_map, .. } := BPerfect
  let { HOMEOMORPHIC_K_SPACE, K_SPACE_PERFECT_MAP_IMAGE, .. } := BKSp1
  let { PROPER_MAP_INTO_K_SPACE_EQ, .. } := BKSp4
  let { KIFICATION_EQ_SELF, OPEN_IN_KIFICATION, OPEN_IN_KIFICATION_FINER, TOPSPACE_KIFICATION,
        COMPACT_IN_KIFICATION, K_SPACE_KIFICATION, .. } := BKIF1
  -- @@SCOPE END

  let CONTINUOUS_MAP_INTO_KIFICATION ← prove
   r"!top top' (f:A->B).
        k_space top
        ==> (continuous_map(top,kification top') f <=>
             continuous_map(top,top') f)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_map, TOPSPACE_KIFICATION] THEN
    EQ_TAC THEN SIMP_TAC [OPEN_IN_KIFICATION_FINER] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"v:B->bool") THEN
    REWRITE_TAC [OPEN_IN_KIFICATION] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "*")) THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (GEN_REWRITE_TAC LAND_CONV
      [← GSYM (← REWRITE_RULE [← GSYM KIFICATION_EQ_SELF] th)])) THEN
    REWRITE_TAC [OPEN_IN_KIFICATION, SUBSET_RESTRICT] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"IMAGE (f:A->B) k")) THEN ANTS_TAC THENL
     [MATCH_MP_TAC IMAGE_COMPACT_IN THEN EXISTS_TAC (← q r"top:A topology") THEN
      ASM_REWRITE_TAC [continuous_map],
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"u:B->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"{x | x IN topspace top /\ (f:A->B) x IN u}") THEN
    ASM_SIMP_TAC [] THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_FROM_KIFICATION ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f ==> continuous_map(kification top,top') f"
   (REWRITE_TAC [continuous_map, TOPSPACE_KIFICATION] THEN
    REPEAT STRIP_TAC THEN ASM_SIMP_TAC [OPEN_IN_KIFICATION_FINER])

  let CONTINUOUS_MAP_KIFICATION ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f
        ==> continuous_map(kification top,kification top') f"
   (SIMP_TAC [CONTINUOUS_MAP_INTO_KIFICATION, K_SPACE_KIFICATION] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FROM_KIFICATION])

  let SUBTOPOLOGY_KIFICATION_COMPACT ← prove
   r"!top (k:A->bool).
        compact_in top k
        ==> subtopology (kification top) k = subtopology top k"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_SUBTOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [OPEN_IN_KIFICATION_FINER]] THEN
    REWRITE_TAC [OPEN_IN_KIFICATION] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    MESON_TAC [INTER_COMM])

  let SUBTOPOLOGY_KIFICATION_FINER ← prove
   r"!top (s:A->bool) u.
        open_in (subtopology (kification top) s) u
        ==> open_in (kification (subtopology top s)) u"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    REPEAT GEN_TAC THEN
    REWRITE_TAC [OPEN_IN_KIFICATION, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    SET_TAC [])

  let PROPER_MAP_FROM_KIFICATION ← prove
   r"!top top' (f:A->B).
        k_space top'
        ==> (proper_map(kification top,top') f <=>
             proper_map(top,top') f)"
   (REPEAT STRIP_TAC THEN ASM_SIMP_TAC [PROPER_MAP_INTO_K_SPACE_EQ] THEN
    REWRITE_TAC [TOPSPACE_KIFICATION, PROPER_MAP_ALT] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_KIFICATION,
                 TOPSPACE_SUBTOPOLOGY, IN_ELIM_THM, IN_INTER,
                 TOPSPACE_KIFICATION] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"(P /\ (!k. Q k ==> S k) ==> (!k. Q k ==> (R k <=> R' k)))
      ==> (P /\ (!k. Q k ==> R k /\ S k) <=>
           P /\ (!k. Q k ==> R' k /\ S k))")) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o MATCH_MP (← MESON [] (← q
     r"(!x. P x ==> (!y. P y /\ Q x y ==> R x y))
      ==> (!x. P x /\ Q x x ==> R x x)")))) THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ p /\ q) /\ q <=> p /\ q"), SUBSET_REFL] THEN
    SIMP_TAC [SUBTOPOLOGY_KIFICATION_COMPACT])

  let PERFECT_MAP_FROM_KIFICATION ← prove
   r"!top top' (f:A->B).
        k_space top' /\ perfect_map(top,top') f
        ==> perfect_map(kification top,top') f"
   (SIMP_TAC [perfect_map, PROPER_MAP_FROM_KIFICATION,
              CONTINUOUS_MAP_FROM_KIFICATION, TOPSPACE_KIFICATION])

  let K_SPACE_PERFECT_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
     hausdorff_space top /\ perfect_map(top,top') f
     ==> (k_space top <=> k_space top')"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [K_SPACE_PERFECT_MAP_IMAGE], DISCH_TAC] THEN
    MP_TAC (← ISPECL [← q r"kification top:A topology", ← q r"top:A topology"]
          HOMEOMORPHIC_K_SPACE) THEN
    ASM_REWRITE_TAC [HOMEOMORPHIC_SPACE, K_SPACE_KIFICATION] THEN
    DISCH_THEN MATCH_MP_TAC THEN EXISTS_TAC (← q r"\x:A. x") THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP] THEN
    MP_TAC (← ISPECL
     [← q r"kification top:A topology", ← q r"top:A topology", ← q r"top':B topology",
      ← q r"\x:A. x", ← q r"f:A->B"] PERFECT_MAP_FROM_COMPOSITION_RIGHT) THEN
    DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [o_DEF, ETA_AX, IMAGE_ID, TOPSPACE_KIFICATION] THEN
    ASM_SIMP_TAC [PERFECT_MAP_FROM_KIFICATION] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_KIFICATION, CONTINUOUS_MAP_ID] THEN
    ASM_SIMP_TAC [PERFECT_IMP_CONTINUOUS_MAP])

  return { CONTINUOUS_MAP_INTO_KIFICATION, CONTINUOUS_MAP_FROM_KIFICATION,
           CONTINUOUS_MAP_KIFICATION, SUBTOPOLOGY_KIFICATION_COMPACT,
           SUBTOPOLOGY_KIFICATION_FINER, PROPER_MAP_FROM_KIFICATION,
           PERFECT_MAP_FROM_KIFICATION, K_SPACE_PERFECT_MAP_IMAGE_EQ }


/- ------------------------------------------------------------------------- -/
/- One-point compactifications and the Alexandroff extension construction.   -/
/- (metric.ml 28741-28907)                                                    -/
/- ------------------------------------------------------------------------- -/

structure OPC1 where
  ONE_POINT_COMPACTIFICATION_DENSE : thm
  ONE_POINT_COMPACTIFICATION_INTERIOR : thm
  KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN : thm
  alexandroff_compactification : thm
  OPEN_IN_ALEXANDROFF_COMPACTIFICATION : thm
  deriving Inhabited

@[nospecialize]
def setupOPC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BInterior : Interior) (BCompact1 : Compact1) (BT1a : T1a)
    (BKC1 : KC1) (BKSp1 : KSp1) (BKSp2 : KSp2) : ExceptT String IO OPC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DELETE_SUBSET, DIFF_EQ_EMPTY, EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_UNION, FORALL_SUBSET_IMAGE, FORALL_SUBSET_UNION, IMAGE_CLAUSES, .. } := D.core1
  let { IMAGE_INTER_INJ, IMP_CONJ, IN, INTERS_INSERT, INTER_COMM, IN_DIFF, IN_ELIM_THM,
        IN_IMAGE, IN_INSERT, IN_INTER, IN_INTERS, IN_UNION, IN_UNIONS, IN_UNIV,
        MEMBER_NOT_EMPTY, NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SUBSET, SUBSET_DELETE, SUBSET_INTER,
        SUBSET_REFL, UNIONS_IMAGE, UNION_EMPTY, UNWIND_THM1, UNWIND_THM2, sum_INDUCT, .. } :=
    D.core4
  let { EXISTS_OR_THM, FORALL_AND_THM, LEFT_AND_EXISTS_THM, RIGHT_OR_DISTRIB, SWAP_EXISTS_THM,
        .. } := D.core5
  let { sum_DISTINCT, sum_INJECTIVE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_INTERS, CLOSED_IN_TOPSPACE, CLOSED_IN_UNION,
        OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        OPEN_IN_UNIONS, closed_in, istopology, topology_tybij, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_TRANS_FULL,
        SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_EQ, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE, .. } := BClosure
  let { INTERIOR_OF_CLOSURE_OF, .. } := BInterior
  let { CLOSED_INTER_COMPACT_IN, CLOSED_IN_COMPACT_SPACE, COMPACT_INTER_CLOSED_IN,
        COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_UNION, compact_space,
        .. } := BCompact1
  let { T1_SPACE_OPEN_IN_DELETE_ALT, .. } := BT1a
  let { KC_IMP_T1_SPACE, kc_space, .. } := BKC1
  let { COMPACT_IMP_K_SPACE, K_SPACE, .. } := BKSp1
  let { K_KC_SPACE_SUBTOPOLOGY, .. } := BKSp2
  -- @@SCOPE END

  let ONE_POINT_COMPACTIFICATION_DENSE ← prove
   r"!top a:A.
        compact_space top /\ ~compact_in top (topspace top DELETE a)
        ==> top closure_of (topspace top DELETE a) = topspace top"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top") THENL
     [STRIP_TAC,
      ASM_MESON_TAC [compact_space, ← SET_RULE (← q r"~(a IN s) ==> s DELETE a = s")]] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"u DELETE a SUBSET s /\ s SUBSET u /\ ~(s = u DELETE a) ==> s = u")) THEN
    REWRITE_TAC [CLOSURE_OF_EQ, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, DELETE_SUBSET] THEN
    ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE])

  let ONE_POINT_COMPACTIFICATION_INTERIOR ← prove
   r"!top a:A.
        compact_space top /\ ~compact_in top (topspace top DELETE a)
        ==> top interior_of {a} = {}"
   (REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, ← SET_RULE (← q r"s DIFF {a} = s DELETE a")] THEN
    SIMP_TAC [ONE_POINT_COMPACTIFICATION_DENSE, DIFF_EQ_EMPTY])

  let KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN ← prove
   r"!top a:A.
        compact_space top
        ==> (kc_space top <=>
             open_in top (topspace top DELETE a) /\
             (!k. compact_in top k /\ ~(a IN k) ==> closed_in top k) /\
             k_space (subtopology top (topspace top DELETE a)) /\
             kc_space (subtopology top (topspace top DELETE a)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [ASM_MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, KC_IMP_T1_SPACE,
                       OPEN_IN_TOPSPACE],
        ALL_TAC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [kc_space], ALL_TAC] THEN
      MATCH_MP_TAC K_KC_SPACE_SUBTOPOLOGY THEN
      ASM_SIMP_TAC [COMPACT_IMP_K_SPACE] THEN DISJ1_TAC THEN
      ASM_MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, KC_IMP_T1_SPACE,
                     OPEN_IN_TOPSPACE],
      STRIP_TAC] THEN
    REWRITE_TAC [kc_space] THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(a:A) IN s") THEN ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
    ASM_REWRITE_TAC [closed_in] THEN
    SUBGOAL_THEN
     (← q r"topspace top DIFF s:A->bool =
      (topspace top DELETE a) DIFF (s DELETE a)")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC OPEN_IN_TRANS_FULL THEN
    EXISTS_TAC (← q r"topspace top DELETE (a:A)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, SUBSET_REFL] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [K_SPACE]) THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
                 TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, SUBSET_DELETE] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"~(a IN k) ==> k INTER s DELETE a = k INTER s")] THEN
    FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [IN_INTER] THEN
    MATCH_MP_TAC CLOSED_INTER_COMPACT_IN THEN ASM_SIMP_TAC [])

  let alexandroff_compactification ← new_definition
   r"alexandroff_compactification (top:A topology) =
        topology ({ IMAGE INL u | open_in top u} UNION
                  { INR one INSERT IMAGE INL (topspace top DIFF c) | c |
                    compact_in top c /\ closed_in top c})"

  let OPEN_IN_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!(top:A topology) v.
        open_in(alexandroff_compactification top) v <=>
        (?u. open_in top u /\ v = IMAGE INL u) \/
        (?c. compact_in top c /\ closed_in top c /\
             v = INR one INSERT IMAGE INL (topspace top DIFF c))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [alexandroff_compactification] THEN
    W (fun g => tactic_of do
      let t ← liftExcept (do let l ← lhand (snd g); rator l)
      let th ← PART_MATCH (lhand o rand) (← CONJUNCT2 topology_tybij) t
      pure (MP_TAC (← EQ_IMP_RULE th).1)) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN SUBST1_TAC THEN GEN_REWRITE_TAC LAND_CONV [← GSYM IN] THEN
      REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN MESON_TAC []] THEN
    REWRITE_TAC [istopology] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN DISJ1_TAC THEN
      REWRITE_TAC [← SET_RULE (← q r"P /\ {} = IMAGE f s <=> s = {} /\ P")] THEN
      REWRITE_TAC [UNWIND_THM2, OPEN_IN_EMPTY],
      MATCH_MP_TAC (← SET_RULE (← q
       r"(!x y. R x y ==> R y x) /\
        (!x y. x IN s /\ y IN s ==> R x y) /\
        (!x y. x IN s /\ y IN t ==> R x y) /\
        (!x y. x IN t /\ y IN t ==> R x y)
        ==> !x y. x IN (s UNION t) /\ y IN (s UNION t) ==> R x y")) THEN
      CONJ_TAC THENL [MESON_TAC [INTER_COMM], ALL_TAC] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
      REPEAT CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"v:A->bool") THEN DISCH_TAC THEN
        REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN DISJ1_TAC THEN
        EXISTS_TAC (← q r"u INTER v:A->bool") THEN
        ASM_SIMP_TAC [OPEN_IN_INTER] THEN CONV_TAC SYM_CONV THEN
        MATCH_MP_TAC IMAGE_INTER_INJ THEN REWRITE_TAC [sum_INJECTIVE],
        X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        X_GEN_TAC (← q r"c:A->bool") THEN REPEAT DISCH_TAC THEN
        REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN DISJ1_TAC THEN
        EXISTS_TAC (← q r"u DIFF c:A->bool") THEN ASM_SIMP_TAC [OPEN_IN_DIFF] THEN
        REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INTER, IN_INSERT] THEN
        MATCH_MP_TAC sum_INDUCT THEN
        REWRITE_TAC [IN_DIFF, sum_DISTINCT, sum_INJECTIVE, UNWIND_THM1] THEN
        ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET],
        X_GEN_TAC (← q r"c:A->bool") THEN REPEAT DISCH_TAC THEN
        X_GEN_TAC (← q r"d:A->bool") THEN REPEAT DISCH_TAC THEN
        REWRITE_TAC [IN_UNION, IN_ELIM_THM] THEN DISJ2_TAC THEN
        EXISTS_TAC (← q r"c UNION d:A->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_UNION, COMPACT_IN_UNION] THEN
        REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INTER, IN_INSERT, IN_UNION] THEN
        MATCH_MP_TAC sum_INDUCT THEN
        REWRITE_TAC [IN_DIFF, sum_DISTINCT, sum_INJECTIVE, UNWIND_THM1] THEN
        SET_TAC []],
      REWRITE_TAC [FORALL_SUBSET_UNION] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET {x | P x} <=> !x. x IN s ==> P x")] THEN
      X_GEN_TAC (← q r"uu:(A->bool)->bool") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"cc:(A->bool)->bool") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"cc:(A->bool)->bool = {}") THENL
       [ASM_REWRITE_TAC [IMAGE_CLAUSES, UNION_EMPTY] THEN
        REWRITE_TAC [IN_UNION, IN_IMAGE] THEN DISJ1_TAC THEN
        EXISTS_TAC (← q r"UNIONS uu:A->bool") THEN
        ASM_SIMP_TAC [IN_ELIM_THM, OPEN_IN_UNIONS] THEN
        REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
        REWRITE_TAC [IN_UNION, IN_IMAGE] THEN DISJ2_TAC THEN EXISTS_TAC
         (← q r"INTERS(cc UNION IMAGE (\u. topspace top DIFF u) uu):A->bool") THEN
        CONJ_TAC THENL
         [REWRITE_TAC [EXTENSION] THEN MATCH_MP_TAC sum_INDUCT THEN
          REWRITE_TAC [IN_IMAGE, IN_DIFF, IN_INTERS, IN_INSERT,
                       IN_UNIONS, IN_UNION, IN_UNIV] THEN
          REWRITE_TAC [sum_DISTINCT, sum_INJECTIVE] THEN
          REWRITE_TAC [RIGHT_OR_DISTRIB, EXISTS_OR_THM, UNWIND_THM1] THEN
          REWRITE_TAC [LEFT_AND_EXISTS_THM, ← GSYM CONJ_ASSOC] THEN
          ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN REWRITE_TAC [UNWIND_THM2] THEN
          REWRITE_TAC [IN_IMAGE, IN_UNIV, IN_DIFF, IN_INSERT] THEN
          REWRITE_TAC [sum_DISTINCT, sum_INJECTIVE] THEN
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          REWRITE_TAC [← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)")] THEN
          X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [FORALL_AND_THM, UNWIND_THM1] THEN
          ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN ASM_REWRITE_TAC [] THENL
           [ALL_TAC, ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET]] THEN
          ONCE_REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> ~q \/ ~p")] THEN
          BINOP_TAC THENL [ALL_TAC, MESON_TAC []] THEN
          REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_AND_EXISTS_THM] THEN
          ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
          REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2, IN_DIFF] THEN
          ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET],
          FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"c:A->bool") o
            REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
          SUBGOAL_THEN (← q r"cc = (c:A->bool) INSERT cc") SUBST1_TAC THENL
           [ASM SET_TAC [],
            REWRITE_TAC [INTERS_INSERT, ← SET_RULE (← q
             r"(x INSERT s) UNION t = x INSERT (s UNION t)")]] THEN
          REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC
           (← MESON [CLOSED_IN_INTER, COMPACT_INTER_CLOSED_IN] (← q
             r"closed_in top c /\ compact_in top c /\ closed_in top d
              ==> compact_in top (c INTER d) /\ closed_in top (c INTER d)")) THEN
          ASM_SIMP_TAC [] THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN
          CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [FORALL_IN_UNION]] THEN
          ASM_SIMP_TAC [FORALL_IN_IMAGE, CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE]]]])

  return { ONE_POINT_COMPACTIFICATION_DENSE, ONE_POINT_COMPACTIFICATION_INTERIOR,
           KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN, alexandroff_compactification,
           OPEN_IN_ALEXANDROFF_COMPACTIFICATION }

/- ------------------------------------------------------------------------- -/
/- Basic properties of the Alexandroff compactification.                     -/
/- (metric.ml 28909-29047)                                                    -/
/- ------------------------------------------------------------------------- -/

structure OPC2 where
  TOPSPACE_ALEXANDROFF_COMPACTIFICATION : thm
  CLOSED_IN_ALEXANDROFF_COMPACTIFICATION : thm
  CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL : thm
  OPEN_MAP_INL : thm
  CONTINUOUS_MAP_INL : thm
  EMBEDDING_MAP_INL : thm
  COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE : thm
  ALEXANDROFF_COMPACTIFICATION_DENSE : thm
  deriving Inhabited

@[nospecialize]
def setupOPC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BOPC1 : OPC1) :
    ExceptT String IO OPC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_EMPTY, EXTENSION, FINITE_INSERT, FORALL_IN_GSPEC, FUN_EQ_THM, FUN_IN_IMAGE, .. } :=
    D.core1
  let { INSERT_SUBSET, IN_DIFF, IN_ELIM_THM, IN_GSPEC, IN_IMAGE, IN_INSERT, IN_UNIONS,
        MONO_EXISTS, .. } := D.core2
  let { SUBSET_DIFF, UNWIND_THM1, .. } := D.core4
  let { CONTRAPOS_THM, EQ_IMP, FORALL_ONE_THM, .. } := D.core5
  let { FORALL_SUM_THM, sum_DISTINCT, sum_INJECTIVE, .. } := D.lib
  let { CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        closed_in, topspace, .. } := BTopology
  let { continuous_map, .. } := BContMap1
  let { open_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, INJECTIVE_OPEN_IMP_EMBEDDING_MAP, .. } :=
    BEmbedding
  let { COMPACT_IN_EMPTY, COMPACT_IN_SUBSPACE, COMPACT_SPACE_ALT, compact_in, .. } := BCompact1
  let { HOMEOMORPHIC_COMPACT_SPACE, IMAGE_COMPACT_IN, .. } := BCompact3
  let { ONE_POINT_COMPACTIFICATION_DENSE, OPEN_IN_ALEXANDROFF_COMPACTIFICATION, .. } := BOPC1
  -- @@SCOPE END

  let TOPSPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        topspace(alexandroff_compactification top) =
        INR one INSERT IMAGE INL (topspace top)"
   (GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [topspace] THEN MATCH_MP_TAC (← SET_RULE (← q
     r"u IN s /\ (!c. c IN s ==> c SUBSET u) ==> UNIONS s = u")) THEN
    REWRITE_TAC [FORALL_IN_GSPEC, OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [MESON_TAC [COMPACT_IN_EMPTY, CLOSED_IN_EMPTY, DIFF_EMPTY], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN SET_TAC [])

  let CLOSED_IN_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!(top:A topology) c.
        closed_in (alexandroff_compactification top) c <=>
        (?k. compact_in top k /\ closed_in top k /\ c = IMAGE INL k) \/
        (?u. open_in top u /\
             c = topspace(alexandroff_compactification top) DIFF IMAGE INL u)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [closed_in] THEN
    REWRITE_TAC [OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q' ==> p) /\ (r' ==> p) /\ (p ==> (q <=> q') /\ (r <=> r'))
      ==> (p /\ (q \/ r) <=> r' \/ q')")) THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [REWRITE_TAC [closed_in] THEN SET_TAC [], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
           DISCH_TAC)
    THENL
     [FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET),
      FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET)] THEN
    REWRITE_TAC [EXTENSION, FORALL_SUM_THM, FORALL_ONE_THM] THEN
    REWRITE_TAC [IN_INSERT, IN_DIFF, IN_IMAGE] THEN
    REWRITE_TAC [sum_DISTINCT, sum_INJECTIVE, UNWIND_THM1] THEN
    MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "B")] sum_DISTINCT) THEN
    MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "B")] sum_INJECTIVE) THEN
    ASM SET_TAC [])

  let CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL ← prove
   r"!(top:A topology) k.
        closed_in (alexandroff_compactification top) (IMAGE INL k) <=>
        compact_in top k /\ closed_in top k"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_ALEXANDROFF_COMPACTIFICATION] THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p' <=> p) /\ ~q ==> (p \/ q <=> p')")) THEN
    SIMP_TAC [← MATCH_MP (← SET_RULE (← q
     r"(!x y. f x = f y <=> x = y) ==> (IMAGE f s = IMAGE f t <=> s = t)"))
     (← CONJUNCT1 sum_INJECTIVE)] THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    MP_TAC (← HolLight.INST_TYPE [(← qty "1", ← qty "B")] sum_DISTINCT) THEN SET_TAC [])

  let OPEN_MAP_INL ← prove
   r"!top:A topology. open_map(top,alexandroff_compactification top) INL"
   (REWRITE_TAC [open_map, OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
    MESON_TAC [])

  let CONTINUOUS_MAP_INL ← prove
   r"!top:A topology. continuous_map(top,alexandroff_compactification top) INL"
   (REWRITE_TAC [continuous_map, OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION, IN_INSERT] THEN
    GEN_TAC THEN SIMP_TAC [FUN_IN_IMAGE] THEN X_GEN_TAC (← q r"v:A+1->bool") THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [IN_INSERT, IN_IMAGE] THEN
    REWRITE_TAC [sum_DISTINCT, sum_INJECTIVE, UNWIND_THM1] THEN
    REWRITE_TAC [← SET_RULE (← q r"x IN s /\ x IN s DIFF t <=> x IN s DIFF t")] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> (x IN t /\ x IN s <=> x IN s)"),
                  OPEN_IN_SUBSET, IN_GSPEC, OPEN_IN_DIFF, OPEN_IN_TOPSPACE])

  let EMBEDDING_MAP_INL ← prove
   r"!top:A topology. embedding_map(top,alexandroff_compactification top) INL"
   (GEN_TAC THEN MATCH_MP_TAC INJECTIVE_OPEN_IMP_EMBEDDING_MAP THEN
    REWRITE_TAC [CONTINUOUS_MAP_INL, OPEN_MAP_INL, sum_INJECTIVE])

  let COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology. compact_space(alexandroff_compactification top)"
   (GEN_TAC THEN REWRITE_TAC [COMPACT_SPACE_ALT] THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    X_GEN_TAC (← q r"uu:(A+1->bool)->bool") THEN
    REWRITE_TAC [INSERT_SUBSET] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNIONS]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A+1->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"compact_in (alexandroff_compactification(top:A topology))
                 (topspace(alexandroff_compactification top) DIFF u)")
    MP_TAC THENL
     [SUBGOAL_THEN
       (← q r"?c. compact_in top c /\ closed_in top c /\
            topspace(alexandroff_compactification top) DIFF u =
            IMAGE INL (c:A->bool)")
      STRIP_ASSUME_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [IMAGE_COMPACT_IN, CONTINUOUS_MAP_INL]] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A+1->bool")) THEN
      ASM_REWRITE_TAC [OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL
       [STRIP_TAC THEN UNDISCH_TAC (← q r"INR one IN (u:A+1->bool)") THEN
        ASM_REWRITE_TAC [IN_IMAGE, sum_DISTINCT],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
        MATCH_MP_TAC (← SET_RULE (← q
         r"c SUBSET s /\ (!x. ~(z = f x)) /\ (!x y. f x = f y <=> x = y)
          ==> (z INSERT IMAGE f s) DIFF (z INSERT IMAGE f (s DIFF c)) =
              IMAGE f c")) THEN
        ASM_SIMP_TAC [CLOSED_IN_SUBSET, sum_DISTINCT, sum_INJECTIVE]],
      REWRITE_TAC [compact_in, SUBSET_DIFF] THEN
      ASM_REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"uu:(A+1->bool)->bool")) THEN ANTS_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"vv:(A+1->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(u:A+1->bool) INSERT vv") THEN
      ASM_REWRITE_TAC [FINITE_INSERT] THEN ASM SET_TAC []])

  let TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE ← prove
   r"!top:A topology.
        topspace(alexandroff_compactification top) DELETE (INR one) =
        IMAGE INL (topspace top)"
   (GEN_TAC THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    REWRITE_TAC [← SET_RULE (← q r"(a INSERT s) DELETE a = s <=> ~(a IN s)")] THEN
    REWRITE_TAC [IN_IMAGE, sum_DISTINCT])

  let ALEXANDROFF_COMPACTIFICATION_DENSE ← prove
   r"!top:A topology.
        ~compact_space top
        ==> (alexandroff_compactification top)
            closure_of (IMAGE INL (topspace top)) =
            topspace(alexandroff_compactification top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
    MATCH_MP_TAC ONE_POINT_COMPACTIFICATION_DENSE THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    POP_ASSUM MP_TAC THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
    REWRITE_TAC [CONTRAPOS_THM, COMPACT_IN_SUBSPACE] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN MATCH_MP_TAC EQ_IMP THEN
    MATCH_MP_TAC HOMEOMORPHIC_COMPACT_SPACE THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
    MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
    REWRITE_TAC [EMBEDDING_MAP_INL])

  return { TOPSPACE_ALEXANDROFF_COMPACTIFICATION, CLOSED_IN_ALEXANDROFF_COMPACTIFICATION,
           CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL, OPEN_MAP_INL, CONTINUOUS_MAP_INL,
           EMBEDDING_MAP_INL, COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION,
           TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE, ALEXANDROFF_COMPACTIFICATION_DENSE }

/- ------------------------------------------------------------------------- -/
/- Separation properties of one-point compactifications.                     -/
/- (metric.ml 29049-29176)                                                    -/
/- ------------------------------------------------------------------------- -/

structure OPC3 where
  T0_SPACE_ONE_POINT_COMPACTIFICATION : thm
  T0_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  T1_SPACE_ONE_POINT_COMPACTIFICATION : thm
  T1_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  KC_SPACE_ONE_POINT_COMPACTIFICATION : thm
  KC_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  deriving Inhabited

@[nospecialize]
def setupOPC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BOpenClosed1 : OpenClosed1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace)
    (BEmbedding : Embedding) (BCompact1 : Compact1) (BCompact3 : Compact3) (BT1a : T1a)
    (BT1b : T1b) (BKC1 : KC1) (BT0a : T0a) (BKSp1 : KSp1) (BOPC1 : OPC1) (BOPC2 : OPC2) :
    ExceptT String IO OPC3 := do
  -- @@SCOPE BEGIN
  let { ASM_METIS_TAC, MESON, MESON_TAC, SET_RULE, .. } := D
  let { FORALL_SUBSET_IMAGE, .. } := D.core1
  let { IN_DELETE, IN_INTER, .. } := D.core2
  let { SING_SUBSET, SUBSET_DELETE, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { open_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_MAP_CLOSEDNESS, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, embedding_map, .. } := BEmbedding
  let { COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { HOMEOMORPHIC_MAP_COMPACTNESS, .. } := BCompact3
  let { T1_SPACE_CLOSED_IN_SING, T1_SPACE_SUBTOPOLOGY, .. } := BT1a
  let { HOMEOMORPHIC_T1_SPACE, .. } := BT1b
  let { HOMEOMORPHIC_KC_SPACE, kc_space, .. } := BKC1
  let { HOMEOMORPHIC_T0_SPACE, T0_SPACE_SUBTOPOLOGY, t0_space, .. } := BT0a
  let { HOMEOMORPHIC_K_SPACE, .. } := BKSp1
  let { KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN, .. } := BOPC1
  let { CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL,
        COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION, EMBEDDING_MAP_INL, OPEN_MAP_INL,
        TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE, .. } := BOPC2
  -- @@SCOPE END

  let T0_SPACE_ONE_POINT_COMPACTIFICATION ← prove
   r"!top a:A.
        compact_space top /\
        open_in top (topspace top DELETE a)
        ==> (t0_space top <=>
             t0_space (subtopology top (topspace top DELETE a)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [T0_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [t0_space, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER s DELETE a = s DELETE a")] THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, IN_DELETE, SUBSET_DELETE] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← MESON [] (← q
     r"(!x y. R x y ==> R y x) /\
      (?a. (!x y. (P x /\ ~(x = a)) /\ (P y /\ ~(y = a)) /\ ~(x = y) ==> R x y) /\
           (!x. P x /\ ~(x = a) ==> R a x))
      ==> !x y. P x /\ P y /\ ~(x = y) ==> R x y")) THEN
    CONJ_TAC THENL [MESON_TAC [], EXISTS_TAC (← q r"a:A")] THEN
    CONJ_TAC THENL [ASM_METIS_TAC [], REPEAT STRIP_TAC] THEN
    EXISTS_TAC (← q r"topspace top DELETE (a:A)") THEN
    ASM_REWRITE_TAC [IN_DELETE])

  let T0_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        t0_space(alexandroff_compactification top) <=>
        t0_space top"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     T0_SPACE_ONE_POINT_COMPACTIFICATION) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN ANTS_TAC THENL
     [REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      MESON_TAC [open_map, OPEN_IN_TOPSPACE, OPEN_MAP_INL],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      MATCH_MP_TAC HOMEOMORPHIC_T0_SPACE THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      REWRITE_TAC [EMBEDDING_MAP_INL]])

  let T1_SPACE_ONE_POINT_COMPACTIFICATION ← prove
   r"!top a:A.
        open_in top (topspace top DELETE a) /\
        (!k. compact_in (subtopology top (topspace top DELETE a)) k /\
             closed_in (subtopology top (topspace top DELETE a)) k
             ==> closed_in top k)
        ==> (t1_space top <=>
             t1_space (subtopology top (topspace top DELETE a)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [T1_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"x:A = a") THENL
     [ASM_REWRITE_TAC [closed_in, SING_SUBSET] THEN
      ASM_REWRITE_TAC [← SET_RULE (← q r"s DIFF {a} = s DELETE a")],
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC [COMPACT_IN_SING, TOPSPACE_SUBTOPOLOGY] THEN
      ASM_REWRITE_TAC [IN_INTER, IN_DELETE] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_DELETE]])

  let T1_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        t1_space(alexandroff_compactification top) <=>
        t1_space top"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     T1_SPACE_ONE_POINT_COMPACTIFICATION) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN ANTS_TAC THENL
     [SIMP_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN CONJ_TAC THENL
       [MESON_TAC [open_map, OPEN_IN_TOPSPACE, OPEN_MAP_INL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← MESON [COMPACT_IN_SUBTOPOLOGY] (← q
       r"(compact_in (subtopology top u) k /\ P k ==> Q k) <=>
        (k SUBSET u ==> compact_in (subtopology top u) k /\ P k ==> Q k)")] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC RAND_CONV
       [CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL] THEN
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_MAP_COMPACTNESS,
        MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSEDNESS] THEN
      ASM_REWRITE_TAC [← GSYM embedding_map, EMBEDDING_MAP_INL],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      MATCH_MP_TAC HOMEOMORPHIC_T1_SPACE THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      REWRITE_TAC [EMBEDDING_MAP_INL]])

  let KC_SPACE_ONE_POINT_COMPACTIFICATION ← prove
   r"!top a:A.
        compact_space top /\
        open_in top (topspace top DELETE a) /\
        (!k. compact_in (subtopology top (topspace top DELETE a)) k /\
             closed_in (subtopology top (topspace top DELETE a)) k
             ==> closed_in top k)
        ==> (kc_space top <=>
             k_space (subtopology top (topspace top DELETE a)) /\
             kc_space (subtopology top (topspace top DELETE a)))"
   (SIMP_TAC [KC_SPACE_ONE_POINT_COMPACTIFICATION_GEN] THEN
    REWRITE_TAC [kc_space, COMPACT_IN_SUBTOPOLOGY, SUBSET_DELETE] THEN
    MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE])

  let KC_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        kc_space(alexandroff_compactification top) <=>
        k_space top /\ kc_space top"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     KC_SPACE_ONE_POINT_COMPACTIFICATION) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN ANTS_TAC THENL
     [SIMP_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN CONJ_TAC THENL
       [MESON_TAC [open_map, OPEN_IN_TOPSPACE, OPEN_MAP_INL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← MESON [COMPACT_IN_SUBTOPOLOGY] (← q
       r"(compact_in (subtopology top u) k /\ P k ==> Q k) <=>
        (k SUBSET u ==> compact_in (subtopology top u) k /\ P k ==> Q k)")] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC RAND_CONV
       [CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL] THEN
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_MAP_COMPACTNESS,
        MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSEDNESS] THEN
      ASM_REWRITE_TAC [← GSYM embedding_map, EMBEDDING_MAP_INL],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_K_SPACE,
        MATCH_MP_TAC HOMEOMORPHIC_KC_SPACE] THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      REWRITE_TAC [EMBEDDING_MAP_INL]])

  return { T0_SPACE_ONE_POINT_COMPACTIFICATION, T0_SPACE_ALEXANDROFF_COMPACTIFICATION,
           T1_SPACE_ONE_POINT_COMPACTIFICATION, T1_SPACE_ALEXANDROFF_COMPACTIFICATION,
           KC_SPACE_ONE_POINT_COMPACTIFICATION, KC_SPACE_ALEXANDROFF_COMPACTIFICATION }

/- ------------------------------------------------------------------------- -/
/- Regularity and Hausdorffness of one-point compactifications.              -/
/- (metric.ml 29178-29309)                                                    -/
/- ------------------------------------------------------------------------- -/

structure OPC4 where
  REGULAR_SPACE_ONE_POINT_COMPACTIFICATION : thm
  REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION : thm
  HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  COMPLETELY_REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION : thm
  deriving Inhabited

@[nospecialize]
def setupOPC4 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BOpenClosed1 : OpenClosed1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace)
    (BEmbedding : Embedding) (BCompact1 : Compact1) (BCompact3 : Compact3)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BNbhdBase : NbhdBase)
    (BRegular1 : Regular1) (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2)
    (BCRegular2 : CRegular2) (BOPC2 : OPC2) (BOPC3 : OPC3) : ExceptT String IO OPC4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { FORALL_SUBSET_IMAGE, .. } := D.core1
  let { IN_DELETE, IN_INTER, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { SUBSET_DELETE, SUBSET_DIFF, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_OPEN_SUBTOPOLOGY, .. } := BSubtopology
  let { open_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_MAP_CLOSEDNESS, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, embedding_map, .. } := BEmbedding
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { HOMEOMORPHIC_MAP_COMPACTNESS, .. } := BCompact3
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { HOMEOMORPHIC_HAUSDORFF_SPACE, .. } := BHausdorff2
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, HOMEOMORPHIC_REGULAR_SPACE,
        NEIGHBOURHOOD_BASE_OF_CLOSED_IN, REGULAR_SPACE_SUBTOPOLOGY,
        REGULAR_T1_IMP_HAUSDORFF_SPACE, .. } := BRegular1
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, HOMEOMORPHIC_LOCALLY_COMPACT_SPACE,
        LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_REGULAR_SPACE_NEIGHBOURHOOD_BASE,
        LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT, LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } :=
    BLocCompact2
  let { COMPLETELY_REGULAR_EQ_REGULAR_SPACE, .. } := BCRegular2
  let { CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL,
        COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION, EMBEDDING_MAP_INL, OPEN_MAP_INL,
        TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE, .. } := BOPC2
  let { T1_SPACE_ONE_POINT_COMPACTIFICATION, .. } := BOPC3
  -- @@SCOPE END

  let REGULAR_SPACE_ONE_POINT_COMPACTIFICATION ← prove
   r"!top a:A.
        compact_space top /\
        open_in top (topspace top DELETE a) /\
        (!k. compact_in (subtopology top (topspace top DELETE a)) k /\
             closed_in (subtopology top (topspace top DELETE a)) k
             ==> closed_in top k)
        ==> (regular_space top <=>
             regular_space (subtopology top (topspace top DELETE a)) /\
             locally_compact_space (subtopology top (topspace top DELETE a)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [SIMP_TAC [REGULAR_SPACE_SUBTOPOLOGY] THEN
      ASM_MESON_TAC [LOCALLY_COMPACT_SPACE_OPEN_SUBSET,
                     COMPACT_IMP_LOCALLY_COMPACT_SPACE],
      STRIP_TAC] THEN
    REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"x:A"] THEN
    ASM_CASES_TAC (← q r"x:A = a") THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
     [MP_TAC (← ISPEC (← q r"subtopology top (topspace top DELETE (a:A))")
          LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"topspace top DIFF u:A->bool")) THEN ANTS_TAC THENL
       [REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE],
        ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, SUBSET_DIFF, SUBSET_DELETE,
                      COMPACT_IN_SUBTOPOLOGY, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, SUBSET_DELETE] THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"topspace top DIFF k:A->bool", ← q r"topspace top DIFF v:A->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_TOPSPACE,
                    CLOSED_IN_TOPSPACE] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN ASM SET_TAC [],
      MP_TAC (← ISPEC (← q r"subtopology top (topspace top DELETE (a:A))")
          LOCALLY_COMPACT_REGULAR_SPACE_NEIGHBOURHOOD_BASE) THEN
      ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN DISCH_THEN (MP_TAC o SPECL
       [← q r"(topspace top DELETE (a:A)) INTER u", ← q r"x:A"]) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, SUBSET_DELETE,
                    OPEN_IN_INTER, IN_INTER, IN_DELETE] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        regular_space(alexandroff_compactification top) <=>
        regular_space top /\ locally_compact_space top"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     REGULAR_SPACE_ONE_POINT_COMPACTIFICATION) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN ANTS_TAC THENL
     [SIMP_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN CONJ_TAC THENL
       [MESON_TAC [open_map, OPEN_IN_TOPSPACE, OPEN_MAP_INL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← MESON [COMPACT_IN_SUBTOPOLOGY] (← q
       r"(compact_in (subtopology top u) k /\ P k ==> Q k) <=>
        (k SUBSET u ==> compact_in (subtopology top u) k /\ P k ==> Q k)")] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC RAND_CONV
       [CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL] THEN
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_MAP_COMPACTNESS,
        MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSEDNESS] THEN
      ASM_REWRITE_TAC [← GSYM embedding_map, EMBEDDING_MAP_INL],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_REGULAR_SPACE,
        MATCH_MP_TAC HOMEOMORPHIC_LOCALLY_COMPACT_SPACE] THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      REWRITE_TAC [EMBEDDING_MAP_INL]])

  let HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION ← prove
   r"!top a:A.
        compact_space top /\
        open_in top (topspace top DELETE a) /\
        (!k. compact_in (subtopology top (topspace top DELETE a)) k /\
             closed_in (subtopology top (topspace top DELETE a)) k
             ==> closed_in top k)
        ==> (hausdorff_space top <=>
             hausdorff_space (subtopology top (topspace top DELETE a)) /\
             locally_compact_space (subtopology top (topspace top DELETE a)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
      ASM_MESON_TAC [COMPACT_HAUSDORFF_IMP_REGULAR_SPACE,
                     REGULAR_SPACE_ONE_POINT_COMPACTIFICATION],
      ASM_METIS_TAC [REGULAR_SPACE_ONE_POINT_COMPACTIFICATION,
                     LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE,
                     REGULAR_T1_IMP_HAUSDORFF_SPACE, HAUSDORFF_IMP_T1_SPACE,
                     T1_SPACE_ONE_POINT_COMPACTIFICATION]])

  let HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        hausdorff_space(alexandroff_compactification top) <=>
        hausdorff_space top /\ locally_compact_space top"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN ANTS_TAC THENL
     [SIMP_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN CONJ_TAC THENL
       [MESON_TAC [open_map, OPEN_IN_TOPSPACE, OPEN_MAP_INL], ALL_TAC] THEN
      ONCE_REWRITE_TAC [← MESON [COMPACT_IN_SUBTOPOLOGY] (← q
       r"(compact_in (subtopology top u) k /\ P k ==> Q k) <=>
        (k SUBSET u ==> compact_in (subtopology top u) k /\ P k ==> Q k)")] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      GEN_REWRITE_TAC RAND_CONV
       [CLOSED_IN_ALEXANDROFF_COMPACTIFICATION_IMAGE_INL] THEN
      MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_MAP_COMPACTNESS,
        MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSEDNESS] THEN
      ASM_REWRITE_TAC [← GSYM embedding_map, EMBEDDING_MAP_INL],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
      BINOP_TAC THENL
       [MATCH_MP_TAC HOMEOMORPHIC_HAUSDORFF_SPACE,
        MATCH_MP_TAC HOMEOMORPHIC_LOCALLY_COMPACT_SPACE] THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      REWRITE_TAC [EMBEDDING_MAP_INL]])

  let COMPLETELY_REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION ← prove
   r"!top:A topology.
        completely_regular_space(alexandroff_compactification top) <=>
        completely_regular_space top /\ locally_compact_space top"
   (MESON_TAC [REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION,
               COMPLETELY_REGULAR_EQ_REGULAR_SPACE,
               COMPACT_IMP_LOCALLY_COMPACT_SPACE,
               COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION])

  return { REGULAR_SPACE_ONE_POINT_COMPACTIFICATION, REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION,
           HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION,
           HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION,
           COMPLETELY_REGULAR_SPACE_ALEXANDROFF_COMPACTIFICATION }

/- ------------------------------------------------------------------------- -/
/- Hausdorffness via an asymmetric product.  (metric.ml 29311-29478)         -/
/- ------------------------------------------------------------------------- -/

structure OPC5 where
  HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION_ASYMMETRIC_PROD : thm
  HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION_ASYMMETRIC_PROD : thm
  deriving Inhabited

@[nospecialize]
def setupOPC5 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BProd1 : Prod1)
    (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding) (BRetraction : Retraction)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BCompact4 : Compact4) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BDiagonal : Diagonal) (BKC1 : KC1)
    (BKSp1 : KSp1) (BKSp2 : KSp2) (BOPC2 : OPC2) : ExceptT String IO OPC5 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ_ALT, INTER_SUBSET, IN_CROSS, IN_DELETE, IN_ELIM_THM, IN_IMAGE, IN_INTER, .. } :=
    D.core2
  let { SUBSET, UNWIND_THM1, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_PAIR_THM, PAIR_EQ, .. } := D.core5
  let { OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, OPEN_IN_SUBTOPOLOGY_ALT,
        SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_SUBSET_EQ, closure_of, .. } := BClosure
  let { CONTINUOUS_MAP_ID, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, .. } := BContMap2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND, OPEN_IN_CROSS,
        PROD_TOPOLOGY_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { HOMEOMORPHIC_SPACE_PROD_TOPOLOGY, HOMEOMORPHIC_SPACE_REFL, HOMEOMORPHIC_SPACE_SYM, .. } :=
    BHomeoSpace
  let { EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE, .. } := BEmbedding
  let { RETRACTION_MAP_FST, .. } := BRetraction
  let { COMPACT_INTER_CLOSED_IN, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, .. } :=
    BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_SPACE_PROD_TOPOLOGY, .. } := BCompact4
  let { T1_SPACE_OPEN_IN_DELETE_ALT, .. } := BT1a
  let { CLOSED_IN_HAUSDORFF_SING, HAUSDORFF_SPACE_SUBTOPOLOGY, hausdorff_space, .. } :=
    BHausdorff1
  let { HAUSDORFF_SPACE_PROD_TOPOLOGY, .. } := BHausdorff2
  let { HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL, .. } := BDiagonal
  let { COMPACT_IN_IMP_CLOSED_IN_GEN, HAUSDORFF_IMP_KC_SPACE, HOMEOMORPHIC_KC_SPACE,
        KC_IMP_T1_SPACE, KC_SPACE_COMPACT_PROD_TOPOLOGY, KC_SPACE_RETRACTION_MAP_IMAGE,
        kc_space, .. } := BKC1
  let { COMPACT_IMP_K_SPACE, HOMEOMORPHIC_K_SPACE, K_SPACE, .. } := BKSp1
  let { K_SPACE_OPEN_SUBTOPOLOGY, .. } := BKSp2
  let { COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION, EMBEDDING_MAP_INL,
        TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE, .. } := BOPC2
  -- @@SCOPE END

  let HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION_ASYMMETRIC_PROD ← prove
   r"!top a:A.
        compact_space top
        ==> (hausdorff_space top <=>
             kc_space
              (prod_topology top (subtopology top (topspace top DELETE a))) /\
             k_space
              (prod_topology top (subtopology top (topspace top DELETE a))))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top") THENL
     [ALL_TAC,
      ASM_SIMP_TAC [SUBTOPOLOGY_TOPSPACE, KC_SPACE_COMPACT_PROD_TOPOLOGY, ← SET_RULE (← q
         r"~(a IN s) ==> s DELETE a = s")] THEN
      SIMP_TAC [COMPACT_IMP_K_SPACE, COMPACT_SPACE_PROD_TOPOLOGY]] THEN
    STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [REWRITE_TAC [PROD_TOPOLOGY_SUBTOPOLOGY] THEN CONJ_TAC THENL
       [MATCH_MP_TAC HAUSDORFF_IMP_KC_SPACE THEN
        MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
        ASM_REWRITE_TAC [HAUSDORFF_SPACE_PROD_TOPOLOGY],

        MATCH_MP_TAC K_SPACE_OPEN_SUBTOPOLOGY THEN
        ASM_REWRITE_TAC [HAUSDORFF_SPACE_PROD_TOPOLOGY] THEN
        ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
        ASM_SIMP_TAC [COMPACT_IMP_K_SPACE, COMPACT_SPACE_PROD_TOPOLOGY] THEN
        REPEAT DISJ2_TAC THEN
        ONCE_REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN
        ASM_SIMP_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_HAUSDORFF_SING]],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"topspace top = {a:A}") THENL
     [ASM_REWRITE_TAC [hausdorff_space] THEN SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"prod_topology top (subtopology top (topspace top DELETE (a:A)))",
      ← q r"top:A topology", ← q r"FST:A#A->A"] KC_SPACE_RETRACTION_MAP_IMAGE) THEN
    ASM_REWRITE_TAC [RETRACTION_MAP_FST, TOPSPACE_SUBTOPOLOGY] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC] THEN
    REWRITE_TAC [HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL] THEN
    SUBGOAL_THEN
     (← q r"closed_in (prod_topology top (subtopology top (topspace top DELETE a)))
                {x:A,x | x IN topspace top DELETE a}")
    MP_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [K_SPACE]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, TOPSPACE_PROD_TOPOLOGY] THEN
      SIMP_TAC [IN_DELETE, IN_CROSS, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
      X_GEN_TAC (← q r"k:A#A->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET THEN
      EXISTS_TAC (← q r"(IMAGE FST (k:A#A->bool)) CROSS (IMAGE SND k)") THEN
      CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS, IN_IMAGE,
                     EXISTS_PAIR_THM, PAIR_EQ] THEN
        SET_TAC []] THEN
      MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
      REWRITE_TAC [INTER_SUBSET] THEN
      FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [kc_space]) THEN
      SUBGOAL_THEN
       (← q r"(IMAGE FST k CROSS IMAGE SND k) INTER
         {x,x | x IN topspace top /\ ~(x:A = a)} =
        IMAGE (\x:A. x,x) (IMAGE FST k INTER IMAGE SND k)")
      SUBST1_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
        REWRITE_TAC [SUBSET, EXTENSION, FORALL_PAIR_THM] THEN
        REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IN_INTER, IN_IMAGE, IN_DELETE,
                     EXISTS_PAIR_THM, PAIR_EQ, IN_ELIM_THM, IN_CROSS,
                     TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
        MESON_TAC [],
        ALL_TAC] THEN
      MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"subtopology top (topspace top DELETE (a:A))") THEN
      REWRITE_TAC [CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID] THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
      REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
       [ALL_TAC,
        FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
        REWRITE_TAC [SUBSET, EXTENSION, FORALL_PAIR_THM] THEN
        REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IN_INTER, IN_IMAGE, IN_DELETE,
                     EXISTS_PAIR_THM, PAIR_EQ, IN_ELIM_THM, IN_CROSS,
                     TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
        MESON_TAC []] THEN
      MATCH_MP_TAC COMPACT_INTER_CLOSED_IN THEN CONJ_TAC THENL
       [MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC
         (← q r"prod_topology top (subtopology top (topspace top DELETE (a:A)))") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_FST],
        ALL_TAC] THEN
      MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN_GEN THEN
      ASM_REWRITE_TAC [] THEN  MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC
       (← q r"prod_topology top (subtopology top (topspace top DELETE (a:A)))") THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [PROD_TOPOLOGY_SUBTOPOLOGY] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      REWRITE_TAC [CONTINUOUS_MAP_SND],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    DISCH_THEN (ASSUME_TAC o CONJUNCT2) THEN
    REWRITE_TAC [FORALL_PAIR_THM, closure_of, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [EXISTS_PAIR_THM, PAIR_EQ, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ a = x /\ b = x) <=> a = b /\ P b")] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM1, IN_CROSS] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"~(x:A = a) \/ ~(y = a)") THENL
     [ALL_TAC, ASM_MESON_TAC []] THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(y,x):A#A")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(x,y):A#A"))] THEN
    ASM_REWRITE_TAC [closure_of, IN_ELIM_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS,
                     IN_DELETE, PAIR_EQ, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    (ANTS_TAC THENL [ALL_TAC, MESON_TAC []]) THEN
    REWRITE_TAC [IMP_CONJ_ALT, PROD_TOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    ASM_REWRITE_TAC [IN_INTER, IN_CROSS, IN_DELETE, EXISTS_PAIR_THM] THEN
    REWRITE_TAC [PAIR_EQ] THEN
    REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ a = x /\ b = x) <=> a = b /\ P b")] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM1] THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"t:A#A->bool") THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"t INTER (topspace top CROSS (topspace top DELETE (a:A)))")) THEN
      ASM_SIMP_TAC [IN_INTER, IN_CROSS, IN_DELETE] THEN
      ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_INTER THEN
      ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
      ASM_MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, OPEN_IN_TOPSPACE,
                     KC_IMP_T1_SPACE]] THEN
    X_GEN_TAC (← q r"t:A#A->bool") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"{z | z IN topspace(prod_topology top top) /\
           (SND z:A,FST z) IN
           (t INTER (topspace top CROSS (topspace top DELETE (a:A))))}")) THEN
    ANTS_TAC THENL
     [ALL_TAC,
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, IN_CROSS, TOPSPACE_PROD_TOPOLOGY,
                       IN_DELETE] THEN
      MESON_TAC []] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [IN_ELIM_THM, IN_INTER, IN_CROSS, TOPSPACE_PROD_TOPOLOGY,
                       IN_DELETE],
      MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"prod_topology (top:A topology) top") THEN
      REWRITE_TAC [CONTINUOUS_MAP_PAIRED] THEN
      REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND] THEN
       MATCH_MP_TAC OPEN_IN_INTER THEN
      ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
      ASM_MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, OPEN_IN_TOPSPACE,
                     KC_IMP_T1_SPACE]])

  let HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION_ASYMMETRIC_PROD ← prove
   r"!top:A topology.
        hausdorff_space(alexandroff_compactification top) <=>
        kc_space(prod_topology (alexandroff_compactification top) top) /\
        k_space(prod_topology (alexandroff_compactification top) top)"
   (GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"alexandroff_compactification(top:A topology)", ← q r"INR one:A+1"]
     HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION_ASYMMETRIC_PROD) THEN
    REWRITE_TAC [COMPACT_SPACE_ALEXANDROFF_COMPACTIFICATION] THEN
    DISCH_THEN SUBST1_TAC THEN MATCH_MP_TAC
     (← MESON [HOMEOMORPHIC_K_SPACE, HOMEOMORPHIC_KC_SPACE] (← q
      r"top homeomorphic_space top'
       ==> (kc_space top /\ k_space top <=> kc_space top' /\ k_space top')")) THEN
    MATCH_MP_TAC HOMEOMORPHIC_SPACE_PROD_TOPOLOGY THEN
    REWRITE_TAC [HOMEOMORPHIC_SPACE_REFL] THEN
    REWRITE_TAC [TOPSPACE_ALEXANDROFF_COMPACTIFICATION_DELETE] THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
    MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
    REWRITE_TAC [EMBEDDING_MAP_INL])

  return { HAUSDORFF_SPACE_ONE_POINT_COMPACTIFICATION_ASYMMETRIC_PROD,
           HAUSDORFF_SPACE_ALEXANDROFF_COMPACTIFICATION_ASYMMETRIC_PROD }

/- ------------------------------------------------------------------------- -/
/- Uniqueness of one-point compactifications.  (metric.ml 29480-29558)       -/
/- ------------------------------------------------------------------------- -/

structure OPC6 where
  KC_SPACE_AS_COMPACTIFICATION_UNIQUE : thm
  KC_SPACE_AS_COMPACTIFICATION_UNIQUE_EXPLICIT : thm
  ALEXANDROFF_COMPACTIFICATION_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupOPC6 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BQuotient : Quotient) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace) (BCompact1 : Compact1)
    (BT1a : T1a) (BKC1 : KC1) (BOPC1 : OPC1) (BOPC2 : OPC2) : ExceptT String IO OPC6 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, DELETE_SUBSET, EXTENSION, FORALL_SUBSET_IMAGE,
        FORALL_SUBSET_INSERT, .. } := D.core1
  let { IN_ELIM_THM, IN_IMAGE, IN_INSERT, NOT_IMP, .. } := D.core2
  let { SUBSET_DELETE, SUBSET_RESTRICT, UNWIND_THM1, .. } := D.core4
  let { sum_DISTINCT, sum_INJECTIVE, .. } := D.lib
  let { CLOSED_IN_SUBSET, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } :=
    BTopology
  let { OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { quotient_map, .. } := BQuotient
  let { homeomorphic_map, .. } := BHomeo1
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { T1_SPACE_OPEN_IN_DELETE_ALT, .. } := BT1a
  let { KC_IMP_T1_SPACE, KC_SPACE_SUBTOPOLOGY, kc_space, .. } := BKC1
  let { OPEN_IN_ALEXANDROFF_COMPACTIFICATION, .. } := BOPC1
  let { TOPSPACE_ALEXANDROFF_COMPACTIFICATION, .. } := BOPC2
  -- @@SCOPE END

  let KC_SPACE_AS_COMPACTIFICATION_UNIQUE ← prove
   r"!top a:A.
        kc_space top /\ compact_space top
        ==> !u. open_in top u <=>
                if a IN u
                then u SUBSET topspace top /\
                     compact_in top (topspace top DIFF u)
                else open_in (subtopology top (topspace top DELETE a)) u"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"u:A->bool") THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [OPEN_IN_CLOSED_IN_EQ, CLOSED_IN_COMPACT_SPACE, kc_space],
      FIRST_ASSUM (MP_TAC o MATCH_MP KC_IMP_T1_SPACE) THEN
      ASM_SIMP_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, OPEN_IN_TOPSPACE,
                    OPEN_IN_OPEN_SUBTOPOLOGY, SUBSET_DELETE] THEN
      MESON_TAC [OPEN_IN_SUBSET]])

  let KC_SPACE_AS_COMPACTIFICATION_UNIQUE_EXPLICIT ← prove
   r"!top a:A.
        kc_space top /\ compact_space top
        ==> !u. open_in top u <=>
                if a IN u
                then u SUBSET topspace top /\
                     compact_in (subtopology top (topspace top DELETE a))
                                (topspace top DIFF u) /\
                     closed_in (subtopology top (topspace top DELETE a))
                                (topspace top DIFF u)
                else open_in (subtopology top (topspace top DELETE a)) u"
   (SIMP_TAC [KC_SPACE_SUBTOPOLOGY, ← MESON [kc_space] (← q
     r"kc_space top
      ==> (compact_in top s /\ closed_in top s <=> compact_in top s)")] THEN
    SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, ← SET_RULE (← q
     r"a IN u ==> s DIFF u SUBSET s DELETE a")] THEN
    REWRITE_TAC [KC_SPACE_AS_COMPACTIFICATION_UNIQUE])

  let ALEXANDROFF_COMPACTIFICATION_UNIQUE ← do
    let lemma ← prove
     r"(IMAGE INL s = IMAGE INL t <=> s = t) /\
       (INR x INSERT IMAGE INL s = INR x INSERT IMAGE INL t <=> s = t) /\
       ~(INR x INSERT IMAGE INL s = IMAGE INL t)"
     (REWRITE_TAC [EXTENSION, IN_IMAGE, IN_INSERT,
                   sum_DISTINCT, sum_INJECTIVE] THEN
      MESON_TAC [sum_DISTINCT, sum_INJECTIVE])
    prove
     r"!top a:A.
        kc_space top /\ compact_space top /\ a IN topspace top
        ==> alexandroff_compactification
             (subtopology top (topspace top DELETE a))
            homeomorphic_space top"
     (REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE, homeomorphic_map] THEN
      EXISTS_TAC (← q r"\x:A. if x = a then INR one else INL x") THEN
      CONJ_TAC THENL [ALL_TAC, MESON_TAC [sum_INJECTIVE, sum_DISTINCT]] THEN
      REWRITE_TAC [quotient_map, TOPSPACE_ALEXANDROFF_COMPACTIFICATION] THEN
      SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, DELETE_SUBSET] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [FORALL_SUBSET_INSERT, FORALL_SUBSET_IMAGE] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [SUBSET_DELETE] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [IN_INSERT, IN_IMAGE, sum_DISTINCT, sum_INJECTIVE] THEN
      REWRITE_TAC [UNWIND_THM1] THEN MP_TAC (← ISPECL [← q r"top:A topology", ← q r"a:A"]
            KC_SPACE_AS_COMPACTIFICATION_UNIQUE_EXPLICIT) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, SUBSET_RESTRICT] THEN
      REWRITE_TAC [OPEN_IN_ALEXANDROFF_COMPACTIFICATION] THEN
      REWRITE_TAC [lemma] THEN
      SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top /\ (if x = a then F else x IN u)} = u")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      REWRITE_TAC [← TAUT (← q r"(if p then T else q) <=> p \/ q")] THEN
      REWRITE_TAC [← SET_RULE (← q
       r"u DIFF {x | x IN u /\ (x = a \/ x IN s)} = u DELETE a DIFF s")] THEN
      ONCE_REWRITE_TAC [← MESON [CLOSED_IN_SUBSET] (← q
       r"closed_in top s /\ P s <=>
        ~(s SUBSET topspace top ==> closed_in top s ==> ~P s)")] THEN
      SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, DELETE_SUBSET] THEN
      ASM_SIMP_TAC [← SET_RULE (← q
       r"a IN t /\ ~(a IN u) /\ u SUBSET t /\ s SUBSET t DELETE a
        ==> (u = t DELETE a DIFF s <=> t DELETE a DIFF u = s)")] THEN
      REWRITE_TAC [NOT_IMP, ← GSYM CONJ_ASSOC] THEN ONCE_REWRITE_TAC [← TAUT (← q
       r"p /\ q /\ r /\ s <=> s /\ p /\ q /\ r")] THEN
      REWRITE_TAC [UNWIND_THM1] THEN ASM SET_TAC [])

  return { KC_SPACE_AS_COMPACTIFICATION_UNIQUE, KC_SPACE_AS_COMPACTIFICATION_UNIQUE_EXPLICIT,
           ALEXANDROFF_COMPACTIFICATION_UNIQUE }

/- ------------------------------------------------------------------------- -/
/- Homotopy of maps p,q : X->Y with property P of all intermediate maps.     -/
/- We often just want to require that it fixes some subset, but to take in   -/
/- the case of loop homotopy it's convenient to have a general property P.   -/
/- (metric.ml 29565-29684)                                                    -/
/- ------------------------------------------------------------------------- -/

structure HOM1 where
  homotopic_with : thm
  HOMOTOPIC_WITH : thm
  HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS : thm
  HOMOTOPIC_WITH_IMP_PROPERTY : thm
  HOMOTOPIC_WITH_EQUAL : thm
  HOMOTOPIC_WITH_REFL : thm
  HOMOTOPIC_WITH_SYM : thm
  deriving Inhabited

@[nospecialize]
def setupHOM1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BProd2 : Prod2) (BRealTop1 : RealTop1)
    (BRealCont : RealCont) : ExceptT String IO HOM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { COND_ID, ETA_AX, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ_ALT, INTER_UNIV, IN_CROSS, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
    D.core2
  let { REAL_SUB_REFL, REAL_SUB_RZERO, SUBSET, o_DEF, o_THM, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, LAMBDA_PAIR, .. } := D.core5
  let { ENDS_IN_UNIT_REAL_INTERVAL, IN_REAL_INTERVAL, .. } := D.misc
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND,
        PROD_TOPOLOGY_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_FST, .. } := BProd2
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONTINUOUS_MAP_REAL_SUB, .. } := BRealCont
  -- @@SCOPE END

  let homotopic_with ← new_definition
   r"homotopic_with P (X,Y) p q <=>
   ?h. continuous_map
       (prod_topology (subtopology euclideanreal (real_interval[&0,&1])) X,
        Y) h /\
       (!x. h(&0,x) = p x) /\ (!x. h(&1,x) = q x) /\
       (!t. t IN real_interval[&0,&1] ==> P(\x. h(t,x)))"

  let HOMOTOPIC_WITH ← prove
   r"!P X Y p q:A->B.
        (!h k. (!x. x IN topspace X ==> h x = k x) ==> (P h <=> P k))
        ==> (homotopic_with P (X,Y) p q <=>
             ?h. continuous_map
                  (prod_topology
                   (subtopology euclideanreal (real_interval [&0,&1])) X,
                   Y) h /\
                (!x. x IN topspace X ==> h (&0,x) = p x) /\
                (!x. x IN topspace X ==> h (&1,x) = q x) /\
                (!t. t IN real_interval[&0,&1] ==> P (\x. h (t,x))))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homotopic_with] THEN EQ_TAC THENL
     [MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real#A->B") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\(t,x). if x IN topspace X then (h:real#A->B)(t,x)
                        else if t = &0 then p x else q x") THEN
    ASM_SIMP_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    REWRITE_TAC [COND_ID] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONTINUOUS_MAP_EQ)) THEN
      SIMP_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS],
      X_GEN_TAC (← q r"t:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:real")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN SIMP_TAC []])

  let HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS ← prove
   r"!P X Y p q:A->B.
        homotopic_with P (X,Y) p q
        ==> continuous_map (X,Y) p /\ continuous_map (X,Y) q"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homotopic_with, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real#A->B") THEN REPEAT STRIP_TAC THENL
     [SUBGOAL_THEN (← q r"p = (h:real#A->B) o (\x. (&0,x))") SUBST1_TAC THENL
       [ASM_REWRITE_TAC [FUN_EQ_THM, o_THM], ALL_TAC],
      SUBGOAL_THEN (← q r"q = (h:real#A->B) o (\x. (&1,x))") SUBST1_TAC THENL
       [ASM_REWRITE_TAC [FUN_EQ_THM, o_THM], ALL_TAC]] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONTINUOUS_MAP_COMPOSE)) THEN
    REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX] THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST] THEN DISJ2_TAC THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let HOMOTOPIC_WITH_IMP_PROPERTY ← prove
   r"!P X Y f g:A->B. homotopic_with P (X,Y) f g ==> P f /\ P g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_with] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real#A->B") MP_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN DISCH_THEN
     (fun th => tactic_of do
       pure (MP_TAC (← SPEC (← q r"&0:real") th) THEN
             MP_TAC (← SPEC (← q r"&1:real") th))) THEN
    ASM_SIMP_TAC [ENDS_IN_UNIT_REAL_INTERVAL, ETA_AX])

  let HOMOTOPIC_WITH_EQUAL ← prove
   r"!P top top' (f:A->B) g.
        P f /\ P g /\
        continuous_map(top,top') f /\
        (!x. x IN topspace top ==> f x = g x)
        ==> homotopic_with P (top,top') f g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homotopic_with] THEN
    EXISTS_TAC (← q r"(\(t,x). if t = &1 then g x else f x):real#A->B") THEN
    ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_EQ THEN EXISTS_TAC (← q r"(f o SND):real#A->B") THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, FORALL_PAIR_THM] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, o_THM, IN_CROSS] THEN
      ASM_SIMP_TAC [COND_ID] THEN MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC [PROD_TOPOLOGY_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_SND],
      X_GEN_TAC (← q r"t:real") THEN ASM_CASES_TAC (← q r"t:real = &1") THEN
      ASM_REWRITE_TAC [ETA_AX]])

  let HOMOTOPIC_WITH_REFL ← prove
   r"!P top top' f:A->B.
        homotopic_with P (top,top') f f <=>
        continuous_map (top,top') f /\ P f"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, HOMOTOPIC_WITH_IMP_PROPERTY],
      DISCH_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
      ASM_REWRITE_TAC []])

  let HOMOTOPIC_WITH_SYM ← prove
   r"!P X Y f g:A->B.
     homotopic_with P (X,Y) f g <=> homotopic_with P (X,Y) g f"
   (REPLICATE_TAC 3 GEN_TAC THEN MATCH_MP_TAC (← MESON [] (← q
     r"(!x y. P x y ==> P y x) ==> (!x y. P x y <=> P y x)")) THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_with] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real#A->B") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\(t,x). (h:real#A->B) (&1 - t,x)") THEN
    ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_SUB_RZERO] THEN CONJ_TAC THENL
     [REWRITE_TAC [LAMBDA_PAIR] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
        (← q r"prod_topology (subtopology euclideanreal (real_interval [&0,&1]))
                       (X:A topology)") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND] THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
                   FORALL_PAIR_THM, IN_CROSS, IN_REAL_INTERVAL] THEN
      CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
      REWRITE_TAC [CONTINUOUS_MAP_OF_FST] THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID],
      REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
      ASM_REAL_ARITH_TAC])

  return { homotopic_with, HOMOTOPIC_WITH, HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS,
           HOMOTOPIC_WITH_IMP_PROPERTY, HOMOTOPIC_WITH_EQUAL, HOMOTOPIC_WITH_REFL,
           HOMOTOPIC_WITH_SYM }

/- ------------------------------------------------------------------------- -/
/- Transitivity and composition of homotopies.  (metric.ml 29686-29783)      -/
/- ------------------------------------------------------------------------- -/

structure HOM2 where
  HOMOTOPIC_WITH_TRANS : thm
  HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT : thm
  HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT : thm
  HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT : thm
  HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT : thm
  deriving Inhabited

@[nospecialize]
def setupHOM2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BProd2 : Prod2) (BRealTop1 : RealTop1)
    (BRealCont : RealCont) (BHOM1 : HOM1) : ExceptT String IO HOM2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ_ALT, IN_CROSS, IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, .. } :=
    D.core2
  let { SUBSET, o_DEF, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, LAMBDA_PAIR, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND,
        PROD_TOPOLOGY_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { CONTINUOUS_MAP_CASES_LE, CONTINUOUS_MAP_REAL_LMUL, CONTINUOUS_MAP_REAL_SUB, .. } :=
    BRealCont
  let { homotopic_with, .. } := BHOM1
  -- @@SCOPE END

  let HOMOTOPIC_WITH_TRANS ← prove
   r"!P top top' (f:A->B) g h.
        homotopic_with P (top,top') f g /\
        homotopic_with P (top,top') g h
        ==> homotopic_with P (top,top') f h"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_with, IN_REAL_INTERVAL] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"h:real#A->B") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"k:real#A->B") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"\z. if FST z <= &1 / &2
                    then (h:real#A->B)(&2 * FST z,SND z)
                    else (k:real#A->B)(&2 * FST z - &1,SND z)") THEN
    REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_CASES_LE THEN
      SIMP_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [PROD_TOPOLOGY_SUBTOPOLOGY] THEN
        SIMP_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_FROM_SUBTOPOLOGY],
        CONJ_TAC THEN
        GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
         (← q r"prod_topology (subtopology euclideanreal (real_interval [&0,&1]))
                        (top:A topology)") THEN
        ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX] THEN
        SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_SND] THEN
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
        REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_SUBTOPOLOGY,
                     FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_INTER,
                     IN_ELIM_THM, IN_CROSS, IN_REAL_INTERVAL] THEN
        (CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC]) THEN
        TRY (MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB) THEN
        REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_REAL_LMUL THEN
        MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
        REWRITE_TAC [PROD_TOPOLOGY_SUBTOPOLOGY] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
        REWRITE_TAC [CONTINUOUS_MAP_FST, ETA_AX]],
      X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"t <= &1 / &2") THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REAL_ARITH_TAC])

  let HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT ← prove
   r"!p q (f:A->B) g (h:B->C) top1 top2 top3.
        homotopic_with p (top1,top2) f g /\
        continuous_map (top2,top3) h /\
        (!j. p j ==> q(h o j))
        ==> homotopic_with q (top1,top3) (h o f) (h o g)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    REWRITE_TAC [homotopic_with, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real#A->B") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(h:B->C) o (k:real#A->B)") THEN
    ASM_REWRITE_TAC [o_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    ASM_SIMP_TAC [])

  let HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT ← prove
   r"!(f:A->B) g (h:B->C) top1 top2 top3.
        homotopic_with (\k. T) (top1,top2) f g /\
        continuous_map (top2,top3) h
        ==> homotopic_with (\k. T) (top1,top3) (h o f) (h o g)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT) THEN
    ASM_REWRITE_TAC [])

  let HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT ← prove
   r"!p q (f:B->C) g (h:A->B) top1 top2 top3.
        homotopic_with p (top2,top3) f g /\
        continuous_map (top1,top2) h /\
        (!j. p j ==> q(j o h))
        ==> homotopic_with q (top1,top3) (f o h) (g o h)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    REWRITE_TAC [homotopic_with, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:real#B->C") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\(t,x). (k:real#B->C)(t,(h:A->B) x)") THEN
    ASM_REWRITE_TAC [o_THM] THEN CONJ_TAC THENL
     [REWRITE_TAC [LAMBDA_PAIR] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
         CONTINUOUS_MAP_COMPOSE)) THEN
      REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_OF_SND],
      GEN_TAC THEN REPLICATE_TAC 2 (DISCH_THEN (ANTE_RES_THEN MP_TAC)) THEN
      REWRITE_TAC [o_DEF]])

  let HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT ← prove
   r"!(f:B->C) g (h:A->B) top1 top2 top3.
        homotopic_with (\k. T) (top2,top3) f g /\
        continuous_map (top1,top2) h
        ==> homotopic_with (\k. T) (top1,top3) (f o h) (g o h)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
     HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT) THEN
    ASM_REWRITE_TAC [])

  return { HOMOTOPIC_WITH_TRANS, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_LEFT,
           HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT, HOMOTOPIC_WITH_COMPOSE_CONTINUOUS_MAP_RIGHT,
           HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT }

/- ------------------------------------------------------------------------- -/
/- More basic homotopy properties.  (metric.ml 29785-29883)                  -/
/- ------------------------------------------------------------------------- -/

structure HOM3 where
  HOMOTOPIC_FROM_SUBTOPOLOGY : thm
  HOMOTOPIC_ON_EMPTY : thm
  HOMOTOPIC_CONSTANT_MAPS : thm
  HOMOTOPIC_WITH_EQ : thm
  HOMOTOPIC_WITH_PROD_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupHOM3 [HolBase] (D : MetricDeps) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BProd1 : Prod1) (BProd2 : Prod2) (BPaths1 : Paths1) (BPathComp1 : PathComp1)
    (BHOM1 : HOM1) : ExceptT String IO HOM3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { ARITH_EQ, CROSS_EMPTY, ETA_AX, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_CROSS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        MONO_FORALL, .. } := D.core2
  let { REAL_OF_NUM_EQ, .. } := D.core3
  let { o_DEF, o_THM, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, LAMBDA_PAIR_THM, LAMBDA_TRIPLE, LAMBDA_TRIPLE_THM, MONO_AND,
        MONO_IMP, .. } := D.core5
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_ON_EMPTY, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, .. } :=
    BContMap2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND,
        PROD_TOPOLOGY_SUBTOPOLOGY, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { path_in, .. } := BPaths1
  let { path_component_of, .. } := BPathComp1
  let { HOMOTOPIC_WITH_IMP_PROPERTY, homotopic_with, .. } := BHOM1
  -- @@SCOPE END

  let HOMOTOPIC_FROM_SUBTOPOLOGY ← prove
   r"!P top top' s f (g:A->B).
        homotopic_with P (top,top') f g
        ==> homotopic_with P (subtopology top s,top') f g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopic_with] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← CONJUNCT2 PROD_TOPOLOGY_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY])

  let HOMOTOPIC_ON_EMPTY ← prove
   r"!top top' (f:A->B) g.
        topspace top = {}
        ==> (homotopic_with P (top,top') f g <=> P f /\ P g)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [HOMOTOPIC_WITH_IMP_PROPERTY] THEN STRIP_TAC THEN
    REWRITE_TAC [homotopic_with] THEN
    EXISTS_TAC (← q r"(\(t,x). if t = &0 then f x else g x):real#A->B") THEN
    ASM_SIMP_TAC [REAL_OF_NUM_EQ, ARITH_EQ, CROSS_EMPTY,
                  CONTINUOUS_MAP_ON_EMPTY, TOPSPACE_PROD_TOPOLOGY] THEN
    X_GEN_TAC (← q r"t:real") THEN ASM_CASES_TAC (← q r"t:real = &0") THEN
    ASM_REWRITE_TAC [ETA_AX])

  let HOMOTOPIC_CONSTANT_MAPS ← prove
   r"!(top:A topology) (top':B topology) a b.
        homotopic_with (\x. T) (top,top') (\x. a) (\x. b) <=>
        topspace top = {} \/ path_component_of top' a b"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [HOMOTOPIC_ON_EMPTY] THEN
    REWRITE_TAC [path_component_of, path_in, homotopic_with] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"h:real#A->B") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:A") o
        GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      EXISTS_TAC (← q r"(h:real#A->B) o (\t. t,a)") THEN
      ASM_REWRITE_TAC [o_THM] THEN MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC
       (← q r"prod_topology (subtopology euclideanreal (real_interval[&0,&1]))
                      (top:A topology)") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_CONST],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->B") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(g:real->B) o (FST:real#A->real)") THEN
      ASM_REWRITE_TAC [o_DEF, CONTINUOUS_MAP_OF_FST]])

  let HOMOTOPIC_WITH_EQ ← prove
   r"!P top top' f g f' g':A->B.
        homotopic_with P (top,top') f g /\
        (!x. x IN topspace top ==> f' x = f x /\ g' x = g x) /\
        (!h k. (!x. x IN topspace top ==> h x = k x) ==> (P h <=> P k))
        ==>  homotopic_with P (top,top') f' g'"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [homotopic_with] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"h:real#A->B")
     (fun th => tactic_of do pure (EXISTS_TAC
       (← q r"\y. if SND y IN topspace top then (h:real#A->B) y
            else if FST y = &0 then f'(SND y)
            else g'(SND y)") THEN
     MP_TAC th))) THEN
    REWRITE_TAC [REAL_OF_NUM_EQ, ARITH_EQ] THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THENL
     [MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_MAP_EQ) THEN
      SIMP_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS],
      ASM_MESON_TAC [],
      ASM_MESON_TAC [],
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"t:real") THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC EQ_IMP THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      SIMP_TAC []])

  let HOMOTOPIC_WITH_PROD_TOPOLOGY ← prove
   r"!p q r top1 top1' top2 top2' (f:A->B) (g:C->D) f' g'.
      homotopic_with p (top1,top1') f f' /\
      homotopic_with q (top2,top2') g g' /\
      (!i j. p i /\ q j ==> r(\(x,y). i x,j y))
      ==> homotopic_with r (prod_topology top1 top2,prod_topology top1' top2')
                           (\z. f(FST z),g(SND z)) (\z. f'(FST z),g'(SND z))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [homotopic_with, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:real#A->B") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"k:real#C->D") THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\(t,x,y). (h:real#A->B) (t,x),(k:real#C->D) (t,y)") THEN
    ASM_REWRITE_TAC [FORALL_PAIR_THM] THEN ASM_SIMP_TAC [LAMBDA_PAIR_THM] THEN
    REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF] THEN
    REWRITE_TAC [LAMBDA_TRIPLE_THM] THEN REWRITE_TAC [LAMBDA_TRIPLE] THEN
    CONJ_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THENL
     [EXISTS_TAC
       (← q r"prod_topology (subtopology euclideanreal (real_interval [&0,&1]))
                      (top1:A topology)"),
      EXISTS_TAC
       (← q r"prod_topology (subtopology euclideanreal (real_interval [&0,&1]))
                      (top2:C topology)")] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONTINUOUS_MAP_PAIRED] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND] THEN
    REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND])

  return { HOMOTOPIC_FROM_SUBTOPOLOGY, HOMOTOPIC_ON_EMPTY, HOMOTOPIC_CONSTANT_MAPS,
           HOMOTOPIC_WITH_EQ, HOMOTOPIC_WITH_PROD_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Homotopies in product topologies, and homotopy equivalence of spaces.     -/
/- (metric.ml 29885-30030)                                                    -/
/- ------------------------------------------------------------------------- -/

structure HOM4 where
  HOMOTOPIC_WITH_PRODUCT_TOPOLOGY : thm
  homotopy_equivalent_space : thm
  HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE : thm
  HOMOTOPY_EQUIVALENT_SPACE_REFL : thm
  HOMOTOPY_EQUIVALENT_SPACE_SYM : thm
  HOMOTOPY_EQUIVALENT_SPACE_TRANS : thm
  DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE : thm
  DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE : thm
  DEFORMATION_RETRACT_OF_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupHOM4 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BProd2 : Prod2) (BProduct2 : Product2)
    (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace) (BRetraction : Retraction)
    (BRetractOf : RetractOf) (BHOM1 : HOM1) (BHOM2 : HOM2) (BHOM3 : HOM3) :
    ExceptT String IO HOM4 := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ASM_MESON_TAC, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_o, IMP_CONJ_ALT, I_DEF, LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        .. } := D.core2
  let { RESTRICTION, RESTRICTION_EXTENSION, RESTRICTION_IN_EXTENSIONAL, SKOLEM_THM, SUBSET,
        o_DEF, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, I_O_ID, I_THM, LAMBDA_PAIR, LAMBDA_PAIR_THM, LEFT_AND_EXISTS_THM,
        RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SWAP_EXISTS_THM, o_ASSOC, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, .. } := BProd1
  let { CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_SPACE_REFL, homeomorphic_space, .. } := BHomeoSpace
  let { retraction_maps, .. } := BRetraction
  let { retract_of_space, .. } := BRetractOf
  let { HOMOTOPIC_WITH_EQUAL, HOMOTOPIC_WITH_SYM, homotopic_with, .. } := BHOM1
  let { HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT,
        HOMOTOPIC_WITH_TRANS, .. } := BHOM2
  let { HOMOTOPIC_WITH_EQ, .. } := BHOM3
  -- @@SCOPE END

  let HOMOTOPIC_WITH_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology) (tops':K->B topology) p q f g.
     (!i. i IN k
          ==> homotopic_with (p i) (tops i,tops' i) (f i) (g i)) /\
     (!h. (!i. i IN k ==> p i (h i)) ==> q(\x. RESTRICTION k (\i. h i (x i))))
     ==> homotopic_with q (product_topology k tops,product_topology k tops')
                          (\z. RESTRICTION k (\i. (f i) (z i)))
                          (\z. RESTRICTION k (\i. (g i) (z i)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ_ALT] THEN DISCH_TAC THEN
    REWRITE_TAC [homotopic_with] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"h:K->real#A->B") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"\(t,z). RESTRICTION k (\i. (h:K->real#A->B) i (t,z i))") THEN
    ASM_SIMP_TAC [RESTRICTION_EXTENSION] THEN
    ONCE_REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
    REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN
    X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [LAMBDA_PAIR_THM] THEN
    ASM_REWRITE_TAC [RESTRICTION] THEN REWRITE_TAC [LAMBDA_PAIR] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
     (← q r"prod_topology
       (subtopology euclideanreal (real_interval [&0,&1]))
       ((tops:K->A topology) i)") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_PAIRED] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_OF_SND] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION])

  -- Homotopy equivalence of topological spaces.

  parse_as_infix ("homotopy_equivalent_space", (12, "right"))

  let homotopy_equivalent_space ← new_definition
   r"(top:A topology) homotopy_equivalent_space (top':B topology) <=>
        ?f g. continuous_map (top,top') f /\
              continuous_map (top',top) g /\
              homotopic_with (\x. T) (top,top) (g o f) I /\
              homotopic_with (\x. T) (top',top') (f o g) I"

  let HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> top homotopy_equivalent_space top'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_space, homotopy_equivalent_space] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    REWRITE_TAC [homeomorphic_maps] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM, I_THM] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let HOMOTOPY_EQUIVALENT_SPACE_REFL ← prove
   r"!top:A topology. top homotopy_equivalent_space top"
   (SIMP_TAC [HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE,
              HOMEOMORPHIC_SPACE_REFL])

  let HOMOTOPY_EQUIVALENT_SPACE_SYM ← prove
   r"!(top:A topology) (top':B topology).
        top homotopy_equivalent_space top' <=>
        top' homotopy_equivalent_space top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopy_equivalent_space] THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN CONV_TAC (fun t => TAUT t))

  let HOMOTOPY_EQUIVALENT_SPACE_TRANS ← prove
   r"!top1:A topology top2:B topology top3:C topology.
        top1 homotopy_equivalent_space top2 /\
        top2 homotopy_equivalent_space top3
        ==> top1 homotopy_equivalent_space top3"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homotopy_equivalent_space] THEN
    SIMP_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    SIMP_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC
     [← q r"f1:A->B", ← q r"g1:B->A",
      ← q r"f2:B->C", ← q r"g2:C->B"] THEN
    STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"(f2:B->C) o (f1:A->B)",
      ← q r"(g1:B->A) o (g2:C->B)"] THEN
    REWRITE_TAC [IMAGE_o] THEN REPLICATE_TAC 2
     (CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ALL_TAC]) THEN
    CONJ_TAC THEN MATCH_MP_TAC HOMOTOPIC_WITH_TRANS THENL
     [EXISTS_TAC (← q r"(g1:B->A) o I o (f1:A->B)"),
      EXISTS_TAC (← q r"(f2:B->C) o I o (g2:C->B)")] THEN
    (CONJ_TAC THENL [ALL_TAC, ASM_REWRITE_TAC [I_O_ID]]) THEN
    REWRITE_TAC [← GSYM o_ASSOC] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT THEN
    EXISTS_TAC (← q r"top2:B topology") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [o_ASSOC] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT THEN
    EXISTS_TAC (← q r"top2:B topology") THEN ASM_REWRITE_TAC [])

  let DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE ← prove
   r"!top top' (r:A->B) s.
        homotopic_with (\x. T) (top,top) (s o r) I /\
        retraction_maps(top,top') (r,s)
        ==> top homotopy_equivalent_space top'"
   (REWRITE_TAC [LEFT_FORALL_IMP_THM, I_DEF] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homotopy_equivalent_space] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:A->B") THEN
    REWRITE_TAC [retraction_maps] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"s:B->A") THEN ASM_REWRITE_TAC [I_DEF] THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
    ASM_REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE ← prove
   r"!top top' (r:A->A).
        homotopic_with (\x. T) (top,top) r I /\
        retraction_maps(top,top') (r,I)
        ==> top homotopy_equivalent_space top'"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE THEN
    MAP_EVERY EXISTS_TAC [← q r"r:A->A", ← q r"I:A->A"] THEN
    ASM_REWRITE_TAC [I_O_ID])

  let DEFORMATION_RETRACT_OF_SPACE ← prove
   r"!top s:A->bool.
        s SUBSET topspace top /\
        (?r. homotopic_with (\x. T) (top,top) I r /\
             retraction_maps(top,subtopology top s) (r,I)) <=>
        s retract_of_space top /\
        (?f. homotopic_with (\x. T) (top,top) I f /\
             IMAGE f (topspace top) SUBSET s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [retract_of_space, retraction_maps, I_DEF] THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"r:A->A") THEN
      REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"r:A->A") THEN ASM_REWRITE_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"r:A->A") STRIP_ASSUME_TAC) MP_TAC) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"f:A->A") THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"r:A->A") THEN ASM_REWRITE_TAC [] THEN
      TRANS_TAC HOMOTOPIC_WITH_TRANS (← q r"f:A->A") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
      MAP_EVERY EXISTS_TAC [← q r"(r:A->A) o (f:A->A)", ← q r"(r:A->A) o (\x. x)"] THEN
      ASM_SIMP_TAC [o_THM] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT THEN
      EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [] THEN
      ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN ASM_REWRITE_TAC []])

  return { HOMOTOPIC_WITH_PRODUCT_TOPOLOGY, homotopy_equivalent_space,
           HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE, HOMOTOPY_EQUIVALENT_SPACE_REFL,
           HOMOTOPY_EQUIVALENT_SPACE_SYM, HOMOTOPY_EQUIVALENT_SPACE_TRANS,
           DEFORMATION_RETRACTION_IMP_HOMOTOPY_EQUIVALENT_SPACE,
           DEFORMATION_RETRACT_IMP_HOMOTOPY_EQUIVALENT_SPACE, DEFORMATION_RETRACT_OF_SPACE }

/- ------------------------------------------------------------------------- -/
/- Contractible spaces. The definition (which agrees with "contractible" on  -/
/- subsets of Euclidean space) is a little cryptic because we don't in fact  -/
/- assume that the constant "a" is in the space. This forces the convention  -/
/- that the empty space / set is contractible, avoiding some special cases.  -/
/- (metric.ml 30039-30128)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CON1 where
  contractible_space : thm
  CONTRACTIBLE_SPACE_EMPTY : thm
  CONTRACTIBLE_SPACE_SING : thm
  CONTRACTIBLE_SPACE_SUBSET_SING : thm
  CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING : thm
  CONTRACTIBLE_SPACE : thm
  CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE : thm
  CONTRACTIBLE_IMP_CONNECTED_SPACE : thm
  CONTRACTIBLE_SPACE_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupCON1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BPaths1 : Paths1) (BPathComp1 : PathComp1)
    (BHOM1 : HOM1) (BHOM2 : HOM2) (BHOM3 : HOM3) : ExceptT String IO CON1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EMPTY, .. } := D.core1
  let { IMP_CONJ_ALT, INTER_SUBSET, IN_CROSS, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
    D.core2
  let { o_DEF, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_ON_EMPTY, continuous_map, .. } :=
    BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, .. } := BContMap2
  let { CONTINUOUS_MAP_PAIRWISE, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { PATH_CONNECTED_IMP_CONNECTED_SPACE, PATH_CONNECTED_SPACE_TOPSPACE_EMPTY, path_in, .. } :=
    BPaths1
  let { PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS, PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT,
        PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF, path_component_of, .. } := BPathComp1
  let { HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, homotopic_with, .. } := BHOM1
  let { HOMOTOPIC_WITH_TRANS, .. } := BHOM2
  let { HOMOTOPIC_CONSTANT_MAPS, .. } := BHOM3
  -- @@SCOPE END

  let contractible_space ← new_definition
   r"contractible_space (top:A topology) <=>
        ?a. homotopic_with (\x. T) (top,top) (\x. x) (\x. a)"

  let CONTRACTIBLE_SPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> contractible_space top"
   (REWRITE_TAC [contractible_space, homotopic_with] THEN
    SIMP_TAC [CONTINUOUS_MAP_ON_EMPTY, TOPSPACE_PROD_TOPOLOGY, CROSS_EMPTY] THEN
    REPEAT STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"ARB:A", ← q r"\(t,x):real#A. if t = &0 then x else ARB"] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"~(&1 = &0)")])

  let CONTRACTIBLE_SPACE_SING ← prove
   r"!top a:A. topspace top = {a} ==> contractible_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [contractible_space] THEN
    EXISTS_TAC (← q r"a:A") THEN REWRITE_TAC [homotopic_with] THEN
    EXISTS_TAC (← q r"(\(t,x). if t = &0 then x else a):real#A->A") THEN
    REWRITE_TAC [← REAL_ARITH (← q r"~(&1 = &0)")] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_EQ THEN EXISTS_TAC (← q r"(\z. a):real#A->A") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_CONST, IN_SING] THEN
    ASM_REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    SET_TAC [])

  let CONTRACTIBLE_SPACE_SUBSET_SING ← prove
   r"!top a:A. topspace top SUBSET {a} ==> contractible_space top"
   (REWRITE_TAC [← SET_RULE (← q r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    MESON_TAC [CONTRACTIBLE_SPACE_EMPTY, CONTRACTIBLE_SPACE_SING])

  let CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING ← prove
   r"!top a:A. contractible_space(subtopology top {a})"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CONTRACTIBLE_SPACE_SUBSET_SING THEN
    EXISTS_TAC (← q r"a:A") THEN REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, INTER_SUBSET])

  let CONTRACTIBLE_SPACE ← prove
   r"!top:A topology.
        contractible_space top <=>
        topspace top = {} \/
        ?a. a IN topspace top /\
            homotopic_with (\x. T) (top,top) (\x. x) (\x. a)"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY] THEN
    REWRITE_TAC [contractible_space] THEN EQ_TAC THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    REWRITE_TAC [continuous_map] THEN ASM SET_TAC [])

  let CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE ← prove
   r"!top:A topology.
        contractible_space top ==> path_connected_space top"
   (GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [PATH_CONNECTED_SPACE_TOPSPACE_EMPTY, CONTRACTIBLE_SPACE] THEN
    REWRITE_TAC [homotopic_with, LEFT_IMP_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"h:real#A->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    SUBGOAL_THEN
     (← q r"!x:A. x IN topspace top ==> path_component_of top x a")
    MP_TAC THENL
     [ALL_TAC,
      ASM_MESON_TAC [PATH_COMPONENT_OF_TRANS, PATH_COMPONENT_OF_SYM]] THEN
    X_GEN_TAC (← q r"b:A") THEN DISCH_TAC THEN REWRITE_TAC [path_component_of] THEN
    EXISTS_TAC (← q r"(h:real#A->A) o (\x. x,b)") THEN
    ASM_REWRITE_TAC [o_THM] THEN REWRITE_TAC [path_in] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
     (← q r"prod_topology (subtopology euclideanreal (real_interval[&0,&1]))
                    (top:A topology)") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST])

  let CONTRACTIBLE_IMP_CONNECTED_SPACE ← prove
   r"!top:A topology. contractible_space top ==> connected_space top"
   (MESON_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE,
               PATH_CONNECTED_IMP_CONNECTED_SPACE])

  let CONTRACTIBLE_SPACE_ALT ← prove
   r"!top:A topology.
        contractible_space top <=>
        !a. a IN topspace top
            ==> homotopic_with (\x. T) (top,top) (\x. x) (\x. a)"
   (GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONTRACTIBLE_SPACE]) THEN
      DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"b:A") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_TRANS) THEN
      REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS] THEN DISJ2_TAC THEN
      MATCH_MP_TAC PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF THEN
      ASM_SIMP_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE],
      DISCH_TAC THEN REWRITE_TAC [CONTRACTIBLE_SPACE] THEN ASM SET_TAC []])

  return { contractible_space, CONTRACTIBLE_SPACE_EMPTY, CONTRACTIBLE_SPACE_SING,
           CONTRACTIBLE_SPACE_SUBSET_SING, CONTRACTIBLE_SPACE_SUBTOPOLOGY_SING,
           CONTRACTIBLE_SPACE, CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE,
           CONTRACTIBLE_IMP_CONNECTED_SPACE, CONTRACTIBLE_SPACE_ALT }

/- ------------------------------------------------------------------------- -/
/- Nullhomotopy and contractibility.  (metric.ml 30130-30252)                -/
/- ------------------------------------------------------------------------- -/

structure CON2 where
  NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : thm
  NULLHOMOTOPIC_INTO_CONTRACTIBLE_SPACE : thm
  NULLHOMOTOPIC_FROM_CONTRACTIBLE_SPACE : thm
  HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE : thm
  HOMOTOPIC_FROM_CONTRACTIBLE_SPACE : thm
  HOMOTOPIC_INTO_CONTRACTIBLE_SPACE : thm
  HOMOTOPY_DOMINATED_CONTRACTIBILITY : thm
  HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY : thm
  deriving Inhabited

@[nospecialize]
def setupCON2 [HolBase] (D : MetricDeps) (BContMap1 : ContMap1) (BPathComp1 : PathComp1)
    (BHOM1 : HOM1) (BHOM2 : HOM2) (BHOM3 : HOM3) (BHOM4 : HOM4) (BCON1 : CON1) :
    ExceptT String IO CON2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { CONJ_ASSOC, ETA_AX, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, I_DEF, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { o_DEF, o_THM, .. } := D.core4
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, .. } := BContMap1
  let { PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT, .. } := BPathComp1
  let { HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS, HOMOTOPIC_WITH_SYM, .. } := BHOM1
  let { HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT,
        HOMOTOPIC_WITH_TRANS, .. } := BHOM2
  let { HOMOTOPIC_CONSTANT_MAPS, .. } := BHOM3
  let { homotopy_equivalent_space, .. } := BHOM4
  let { contractible_space, CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE, .. } := BCON1
  -- @@SCOPE END

  let NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) (g:B->C) top1 top2 top3.
        continuous_map (top1,top2) f /\
        continuous_map (top2,top3) g /\
        contractible_space top2
        ==> ?c. homotopic_with (\h. T) (top1,top3) (g o f) (\x. c)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [contractible_space]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:B") MP_TAC) THEN
    DISCH_THEN (MP_TAC o ISPECL [← q r"g:B->C", ← q r"top3:C topology"] o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT)) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o ISPECL [← q r"f:A->B", ← q r"top1:A topology"] o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT)) THEN
    ASM_REWRITE_TAC [o_DEF] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(g:B->C) b") THEN ASM_REWRITE_TAC [])

  let NULLHOMOTOPIC_INTO_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) top1 top2.
        continuous_map (top1,top2) f /\ contractible_space top2
        ==> ?c. homotopic_with (\h. T) (top1,top2) f (\x. c)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:A->B) = (\x. x) o f") SUBST1_TAC THENL
     [REWRITE_TAC [o_THM, FUN_EQ_THM],
      MATCH_MP_TAC NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE THEN
      EXISTS_TAC (← q r"top2:B topology") THEN ASM_REWRITE_TAC [CONTINUOUS_MAP_ID]])

  let NULLHOMOTOPIC_FROM_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) top1 top2.
        continuous_map (top1,top2) f /\ contractible_space top1
        ==> ?c. homotopic_with (\h. T) (top1,top2) f (\x. c)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(f:A->B) = f o (\x. x)") SUBST1_TAC THENL
     [REWRITE_TAC [o_THM, FUN_EQ_THM],
      MATCH_MP_TAC NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE THEN
      EXISTS_TAC (← q r"top1:A topology") THEN ASM_REWRITE_TAC [CONTINUOUS_MAP_ID]])

  let HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) (g:B->C) f' g' top1 top2 top3.
        continuous_map (top1,top2) f /\
        continuous_map (top1,top2) f' /\
        continuous_map (top2,top3) g /\
        continuous_map (top2,top3) g' /\
        contractible_space top2 /\ path_connected_space top3
        ==> homotopic_with (\h. T) (top1,top3) (g o f) (g' o f')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:A->B", ← q r"g:B->C",
      ← q r"top1:A topology", ← q r"top2:B topology", ← q r"top3:C topology"]
     NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE) THEN
    MP_TAC (← ISPECL
     [← q r"f':A->B", ← q r"g':B->C",
      ← q r"top1:A topology", ← q r"top2:B topology", ← q r"top3:C topology"]
     NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"c:C") THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS) THEN
    REWRITE_TAC [CONTINUOUS_MAP_CONST] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"d:C") THEN DISCH_THEN (fun th => tactic_of do pure (MP_TAC th THEN
       MP_TAC (← MATCH_MP HOMOTOPIC_WITH_IMP_CONTINUOUS_MAPS th))) THEN
    REWRITE_TAC [CONTINUOUS_MAP_CONST] THEN DISCH_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] HOMOTOPIC_WITH_TRANS) THEN
    ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_TRANS)) THEN
    REWRITE_TAC [HOMOTOPIC_CONSTANT_MAPS] THEN
    ASM_MESON_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT])

  let HOMOTOPIC_FROM_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) g top top'.
        continuous_map (top,top') f /\ continuous_map (top,top') g /\
        contractible_space top /\ path_connected_space top'
        ==> homotopic_with (\x. T) (top,top') f g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"\x:A. x", ← q r"f:A->B", ← q r"\x:A. x",
      ← q r"g:A->B", ← q r"top:A topology", ← q r"top:A topology",
      ← q r"top':B topology"] HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, o_DEF, ETA_AX])

  let HOMOTOPIC_INTO_CONTRACTIBLE_SPACE ← prove
   r"!(f:A->B) g top top'.
        continuous_map (top,top') f /\ continuous_map (top,top') g /\
        contractible_space top'
        ==> homotopic_with (\x. T) (top,top') f g"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"f:A->B", ← q r"\x:B. x",
      ← q r"g:A->B", ← q r"\x:B. x", ← q r"top:A topology", ← q r"top':B topology",
      ← q r"top':B topology"] HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, o_DEF, ETA_AX] THEN
    ASM_SIMP_TAC [CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE])

  let HOMOTOPY_DOMINATED_CONTRACTIBILITY ← prove
   r"!(f:A->B) g top top'.
        continuous_map (top,top') f /\
        continuous_map (top',top) g /\
        homotopic_with (\x. T) (top',top') (f o g) I /\
        contractible_space top
        ==> contractible_space top'"
   (REPEAT GEN_TAC THEN SIMP_TAC [contractible_space, I_DEF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"f:A->B", ← q r"top:A topology", ← q r"top':B topology"]
          NULLHOMOTOPIC_FROM_CONTRACTIBLE_SPACE) THEN
    ASM_REWRITE_TAC [contractible_space, I_DEF] THEN
    ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:B") THEN
    ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN DISCH_TAC THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_TRANS THEN
    EXISTS_TAC (← q r"(f:A->B) o (g:B->A)") THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(\x. (b:B)) = (\x. b) o (g:B->A)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT THEN
    EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [])

  let HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY ← prove
   r"!(top:A topology) (top':B topology).
        top homotopy_equivalent_space top'
        ==> (contractible_space top <=> contractible_space top')"
   (REWRITE_TAC [homotopy_equivalent_space] THEN REPEAT STRIP_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] HOMOTOPY_DOMINATED_CONTRACTIBILITY)) THEN
    ASM_MESON_TAC [])

  return { NULLHOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE, NULLHOMOTOPIC_INTO_CONTRACTIBLE_SPACE,
           NULLHOMOTOPIC_FROM_CONTRACTIBLE_SPACE, HOMOTOPIC_THROUGH_CONTRACTIBLE_SPACE,
           HOMOTOPIC_FROM_CONTRACTIBLE_SPACE, HOMOTOPIC_INTO_CONTRACTIBLE_SPACE,
           HOMOTOPY_DOMINATED_CONTRACTIBILITY, HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY }

/- ------------------------------------------------------------------------- -/
/- More on contractible spaces.  (metric.ml 30254-30399)                     -/
/- ------------------------------------------------------------------------- -/

structure CON3 where
  HOMEOMORPHIC_SPACE_CONTRACTIBILITY : thm
  CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY : thm
  CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE : thm
  CONTRACTIBLE_SPACE_PROD_TOPOLOGY : thm
  CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY : thm
  CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL : thm
  CONTRACTIBLE_SPACE_EUCLIDEANREAL : thm
  deriving Inhabited

@[nospecialize]
def setupCON3 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BProduct1 : Product1) (BRetraction : Retraction)
    (BRealTop1 : RealTop1) (BRealCont : RealCont) (BPaths1 : Paths1) (BPaths2 : Paths2)
    (BHOM1 : HOM1) (BHOM2 : HOM2) (BHOM3 : HOM3) (BHOM4 : HOM4) (BCON1 : CON1)
    (BCON2 : CON2) : ExceptT String IO CON3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D
  let { CONJ_ASSOC, CROSS_EQ_EMPTY, ETA_AX, EXTENSIONAL, FORALL_IN_IMAGE, FUN_EQ_THM, .. } :=
    D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_CROSS, IN_ELIM_THM, IN_INTER, IN_SING, I_DEF,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { REAL_CONVEX_BOUNDS_LE, .. } := D.core3
  let { RESTRICTION, SKOLEM_THM, SUBSET, SUBSET_REFL, cartesian_product, o_DEF, o_THM,
        real_max, real_min, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_PAIR_THM, LAMBDA_PAIR, LEFT_AND_EXISTS_THM,
        RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_UNIV, is_realinterval, .. } := D.misc
  let { SUBTOPOLOGY_UNIV, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } :=
    BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { RETRACTION_MAP_FST, RETRACTION_MAP_PRODUCT_PROJECTION, RETRACTION_MAP_SND,
        retraction_map, retraction_maps, .. } := BRetraction
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_MUL,
        CONTINUOUS_MAP_REAL_SUB, .. } := BRealCont
  let { PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_TOPSPACE, .. } := BPaths1
  let { PATH_CONNECTED_IN_EUCLIDEANREAL, .. } := BPaths2
  let { HOMOTOPIC_WITH_EQUAL, HOMOTOPIC_WITH_SYM, homotopic_with, .. } := BHOM1
  let { HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT, HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT, .. } :=
    BHOM2
  let { HOMOTOPIC_WITH_EQ, HOMOTOPIC_WITH_PROD_TOPOLOGY, .. } := BHOM3
  let { HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE, HOMOTOPIC_WITH_PRODUCT_TOPOLOGY,
        homotopy_equivalent_space, .. } := BHOM4
  let { CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE, CONTRACTIBLE_SPACE, CONTRACTIBLE_SPACE_EMPTY,
        CONTRACTIBLE_SPACE_SING, contractible_space, .. } := BCON1
  let { HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY, .. } := BCON2
  -- @@SCOPE END

  let HOMEOMORPHIC_SPACE_CONTRACTIBILITY ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (contractible_space top <=> contractible_space top')"
   (MESON_TAC [HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY,
               HOMEOMORPHIC_IMP_HOMOTOPY_EQUIVALENT_SPACE])

  let CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY ← prove
   r"!top:A topology.
        contractible_space top <=>
        topspace top = {} \/
        ?a. a IN topspace top /\
            top homotopy_equivalent_space (subtopology top {a})"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY] THEN EQ_TAC THENL
     [ASM_REWRITE_TAC [CONTRACTIBLE_SPACE] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [homotopy_equivalent_space] THEN
      MAP_EVERY EXISTS_TAC [← q r"(\x. a):A->A", ← q r"(\x. x):A->A"] THEN
      ASM_SIMP_TAC [o_DEF, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID,
        IN_INTER, CONTINUOUS_MAP_CONST, TOPSPACE_SUBTOPOLOGY, IN_SING] THEN
      ONCE_REWRITE_TAC [HOMOTOPIC_WITH_SYM] THEN
      ASM_REWRITE_TAC [I_DEF] THEN MATCH_MP_TAC HOMOTOPIC_WITH_EQUAL THEN
      REWRITE_TAC [CONTINUOUS_MAP_ID, TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
      FIRST_ASSUM (SUBST1_TAC o
        MATCH_MP HOMOTOPY_EQUIVALENT_SPACE_CONTRACTIBILITY) THEN
      MATCH_MP_TAC CONTRACTIBLE_SPACE_SING THEN
      EXISTS_TAC (← q r"a:A") THEN ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      ASM SET_TAC []])

  let CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        retraction_map(top,top') f /\ contractible_space top
        ==> contractible_space top'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, retraction_map, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN REWRITE_TAC [retraction_maps] THEN STRIP_TAC THEN
    REWRITE_TAC [contractible_space, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN EXISTS_TAC (← q r"(f:A->B) a") THEN
    MATCH_MP_TAC HOMOTOPIC_WITH_EQ THEN
    EXISTS_TAC (← q r"(f:A->B) o (\x. x) o (g:B->A)") THEN
    EXISTS_TAC (← q r"(f:A->B) o (\x. a) o (g:B->A)") THEN
    ASM_SIMP_TAC [o_THM] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_LEFT THEN
    EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC HOMOTOPIC_COMPOSE_CONTINUOUS_MAP_RIGHT THEN
    EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [])

  let CONTRACTIBLE_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        contractible_space(prod_topology top1 top2) <=>
        topspace top1 = {} \/ topspace top2 = {} \/
        contractible_space top1 /\ contractible_space top2"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top1:A->bool = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY, TOPSPACE_PROD_TOPOLOGY,
                  CROSS_EQ_EMPTY] THEN
    ASM_CASES_TAC (← q r"topspace top2:B->bool = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY, TOPSPACE_PROD_TOPOLOGY,
                  CROSS_EQ_EMPTY] THEN
    EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ]
       CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE)
      THENL [EXISTS_TAC (← q r"FST:A#B->A"), EXISTS_TAC (← q r"SND:A#B->B")] THEN
      ASM_REWRITE_TAC [RETRACTION_MAP_FST, RETRACTION_MAP_SND],
      ASM_REWRITE_TAC [CONTRACTIBLE_SPACE, TOPSPACE_PROD_TOPOLOGY,
                       CROSS_EQ_EMPTY, EXISTS_PAIR_THM] THEN
      REWRITE_TAC [IN_CROSS, LEFT_AND_EXISTS_THM] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM, ← GSYM CONJ_ASSOC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"b:B") THEN
      ASM_CASES_TAC (← q r"(a:A) IN topspace top1") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"(b:B) IN topspace top2") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [← TAUT (← q
       r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")]
      HOMOTOPIC_WITH_PROD_TOPOLOGY)) THEN SIMP_TAC []])

  let CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology).
        contractible_space(product_topology k tops) <=>
        topspace (product_topology k tops) = {} \/
        !i. i IN k ==> contractible_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
       CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE)) THEN
      EXISTS_TAC (← q r"\x:K->A. x i") THEN
      ASM_SIMP_TAC [RETRACTION_MAP_PRODUCT_PROJECTION],
      REWRITE_TAC [contractible_space] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"a:K->A") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"RESTRICTION k (a:K->A)") THEN FIRST_X_ASSUM
       (MP_TAC o ISPEC (← q r"\z:(K->A)->(K->A). T") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          HOMOTOPIC_WITH_PRODUCT_TOPOLOGY)) THEN
      REWRITE_TAC [] THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          HOMOTOPIC_WITH_EQ) THEN
      REWRITE_TAC [ETA_AX] THEN REWRITE_TAC [FUN_EQ_THM] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM, RESTRICTION] THEN MESON_TAC []])

  let CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL ← prove
   r"!s. contractible_space(subtopology euclideanreal s) <=> is_realinterval s"
   (GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP CONTRACTIBLE_IMP_PATH_CONNECTED_SPACE) THEN
      REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
      REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEANREAL],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s:real->bool = {}") THEN
    ASM_SIMP_TAC [CONTRACTIBLE_SPACE_EMPTY,
                  TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:real")) THEN REWRITE_TAC [is_realinterval] THEN
    STRIP_TAC THEN REWRITE_TAC [contractible_space, homotopic_with] THEN
    EXISTS_TAC (← q r"z:real") THEN
    EXISTS_TAC (← q r"\(t:real,x). (&1 - t) * x + t * z") THEN REWRITE_TAC [] THEN
    CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
     [REWRITE_TAC [LAMBDA_PAIR, ← GSYM SUBTOPOLOGY_CROSS] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_ADD THEN
      CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_REAL_MUL THEN
      SIMP_TAC [CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND,
                CONTINUOUS_MAP_REAL_SUB],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real", ← q r"x:real"] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_REAL_INTERVAL] THEN
      STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"min x z:real", ← q r"max z x:real"] THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
       [REWRITE_TAC [real_max, real_min] THEN ASM_MESON_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC REAL_CONVEX_BOUNDS_LE THEN ASM_REAL_ARITH_TAC])

  let CONTRACTIBLE_SPACE_EUCLIDEANREAL ← prove
   r"contractible_space euclideanreal"
   (ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_UNIV] THEN
    REWRITE_TAC [CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL] THEN
    REWRITE_TAC [IS_REALINTERVAL_UNIV])

  return { HOMEOMORPHIC_SPACE_CONTRACTIBILITY,
           CONTRACTIBLE_EQ_HOMOTOPY_EQUIVALENT_SINGLETON_SUBTOPOLOGY,
           CONTRACTIBLE_SPACE_RETRACTION_MAP_IMAGE, CONTRACTIBLE_SPACE_PROD_TOPOLOGY,
           CONTRACTIBLE_SPACE_PRODUCT_TOPOLOGY, CONTRACTIBLE_SPACE_SUBTOPOLOGY_EUCLIDEANREAL,
           CONTRACTIBLE_SPACE_EUCLIDEANREAL }

/- ------------------------------------------------------------------------- -/
/- Completely metrizable (a.k.a. "topologically complete") spaces.           -/
/- (metric.ml 30404-30533)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CMS1 where
  completely_metrizable_space : thm
  COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE : thm
  FORALL_MCOMPLETE_TOPOLOGY : thm
  FORALL_COMPLETELY_METRIZABLE_SPACE : thm
  EXISTS_COMPLETELY_METRIZABLE_SPACE : thm
  COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY : thm
  COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY : thm
  COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL : thm
  COMPLETELY_METRIZABLE_SPACE_CLOSED_IN : thm
  HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE : thm
  COMPLETELY_METRIZABLE_SPACE_RETRACTION_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupCMS1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BDiagonal : Diagonal)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BRealTop2 : RealTop2) (BLimits1 : Limits1) (BCauchy1 : Cauchy1) (BMCompact2 : MCompact2)
    (BMCompact3 : MCompact3) : ExceptT String IO CMS1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, o_THM, .. } := D.core4
  let { TOPOLOGY_EQ, .. } := BTopology
  let { continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_MAPS_IMP_MAP, HOMEOMORPHIC_MAPS_SYM, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_OPENNESS_EQ, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BDiagonal
  let { IN_MBALL, .. } := BMetricSpace
  let { METRIC_INJECTIVE_IMAGE, MTOPOLOGY_SUBMETRIC, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } :=
    BMTopology
  let { METRIZABLE_IMP_HAUSDORFF_SPACE, MTOPOLOGY_DISCRETE_METRIC, metrizable_space, .. } :=
    BMetrizable
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { CONTINUOUS_MAP_LIMIT, .. } := BLimits1
  let { CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, cauchy_in, mcomplete, .. } := BCauchy1
  let { MCOMPLETE_DISCRETE_METRIC, .. } := BMCompact2
  let { MCOMPLETE_REAL_EUCLIDEAN_METRIC, .. } := BMCompact3
  -- @@SCOPE END

  let completely_metrizable_space ← new_definition
   r"completely_metrizable_space top <=>
  ?m. mcomplete m /\ top = mtopology m"

  let COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE ← prove
   r"!top:A topology. completely_metrizable_space top ==> metrizable_space top"
   (REWRITE_TAC [completely_metrizable_space, metrizable_space] THEN
    MESON_TAC [])

  let FORALL_MCOMPLETE_TOPOLOGY ← prove
   r"!P. (!m:A metric. mcomplete m ==> P (mtopology m) (mspace m)) <=>
       !top. completely_metrizable_space top ==> P top (topspace top)"
   (SIMP_TAC [completely_metrizable_space, LEFT_IMP_EXISTS_THM,
              TOPSPACE_MTOPOLOGY] THEN
    MESON_TAC [])

  let FORALL_COMPLETELY_METRIZABLE_SPACE ← prove
   r"(!top. completely_metrizable_space top ==> P top (topspace top)) <=>
   (!m:A metric. mcomplete m ==> P (mtopology m) (mspace m))"
   (SIMP_TAC [completely_metrizable_space, LEFT_IMP_EXISTS_THM,
              TOPSPACE_MTOPOLOGY] THEN
    MESON_TAC [])

  let EXISTS_COMPLETELY_METRIZABLE_SPACE ← prove
   r"!P. (?top. completely_metrizable_space top /\ P top (topspace top)) <=>
       (?m:A metric.mcomplete m /\  P (mtopology m) (mspace m))"
   (REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    REWRITE_TAC [FORALL_MCOMPLETE_TOPOLOGY] THEN MESON_TAC [])

  let COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. mcomplete m ==> completely_metrizable_space(mtopology m)"
   (REWRITE_TAC [FORALL_MCOMPLETE_TOPOLOGY])

  let COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. completely_metrizable_space(discrete_topology u)"
   (REWRITE_TAC [completely_metrizable_space] THEN
    MESON_TAC [MTOPOLOGY_DISCRETE_METRIC, MCOMPLETE_DISCRETE_METRIC])

  let COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL ← prove
   r"completely_metrizable_space euclideanreal"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY THEN
    REWRITE_TAC [MCOMPLETE_REAL_EUCLIDEAN_METRIC])

  let COMPLETELY_METRIZABLE_SPACE_CLOSED_IN ← prove
   r"!top s:A->bool.
        completely_metrizable_space top /\ closed_in top s
        ==> completely_metrizable_space(subtopology top s)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM FORALL_MCOMPLETE_TOPOLOGY] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_SUBMETRIC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY THEN
    MATCH_MP_TAC CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN ASM_REWRITE_TAC [])

  let HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE ← do
    let lemma ← prove
     r"!(top:A topology) (top':B topology).
            top homeomorphic_space top'
            ==> completely_metrizable_space top
                ==> completely_metrizable_space top'"
     (REPEAT GEN_TAC THEN REWRITE_TAC [completely_metrizable_space] THEN
      REWRITE_TAC [homeomorphic_space, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"m:A metric") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ABBREV_TAC
       (← q r"m' = metric(topspace top',\(x,y). mdist m ((g:B->A) x,g y))") THEN
      MP_TAC (← ISPECL [← q r"g:B->A", ← q r"m:A metric", ← q r"topspace top':B->bool"]
            METRIC_INJECTIVE_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic_maps]) THEN
        EXPAND_TAC "top" THEN
        REWRITE_TAC [continuous_map, TOPSPACE_MTOPOLOGY] THEN SET_TAC [],
        STRIP_TAC THEN EXISTS_TAC (← q r"m':B metric")] THEN
      MATCH_MP_TAC (← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")) THEN CONJ_TAC THENL
       [DISCH_THEN (ASSUME_TAC o SYM) THEN
        UNDISCH_TAC (← q r"mcomplete(m:A metric)") THEN
        ASM_REWRITE_TAC [mcomplete, cauchy_in, ← GSYM TOPSPACE_MTOPOLOGY] THEN
        DISCH_TAC THEN X_GEN_TAC (← q r"x:num->B") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:B->A) o (x:num->B)")) THEN
        ASM_REWRITE_TAC [o_THM] THEN
        FIRST_X_ASSUM (STRIP_ASSUME_TAC o
          GEN_REWRITE_RULE id [homeomorphic_maps]) THEN
        ANTS_TAC THENL
         [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
          DISCH_THEN (X_CHOOSE_TAC (← q r"y:A"))] THEN
        EXISTS_TAC (← q r"(f:A->B) y") THEN
        SUBGOAL_THEN (← q r"x = f o (g:B->A) o (x:num->B)") SUBST1_TAC THENL
         [REWRITE_TAC [FUN_EQ_THM, o_THM] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
          MATCH_MP_TAC CONTINUOUS_MAP_LIMIT THEN ASM_MESON_TAC []],
        ALL_TAC] THEN
      REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_MTOPOLOGY] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAPS_SYM]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_MAPS_IMP_MAP) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP HOMEOMORPHIC_MAP_OPENNESS_EQ th])) THEN
      X_GEN_TAC (← q r"v:B->bool") THEN
      ASM_CASES_TAC (← q r"(v:B->bool) SUBSET topspace top'") THEN
      ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "top" THEN REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_REWRITE_TAC [IN_MBALL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (q <=> r) ==> (p /\ q <=> r)")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], EQ_TAC] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"b:B") THEN
      ASM_CASES_TAC (← q r"(b:B) IN v") THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THENL
       [X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:B->A) y")) THEN ASM SET_TAC [],
        ASM SET_TAC []])
    prove
     r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (completely_metrizable_space top <=>
             completely_metrizable_space top')"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SPACE_SYM])

  let COMPLETELY_METRIZABLE_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ completely_metrizable_space top
        ==> completely_metrizable_space top'"
   (MATCH_MP_TAC WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE] THEN
    REWRITE_TAC [COMPLETELY_METRIZABLE_SPACE_CLOSED_IN] THEN
    MESON_TAC [COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE,
               METRIZABLE_IMP_HAUSDORFF_SPACE])

  return { completely_metrizable_space, COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE,
           FORALL_MCOMPLETE_TOPOLOGY, FORALL_COMPLETELY_METRIZABLE_SPACE,
           EXISTS_COMPLETELY_METRIZABLE_SPACE, COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY,
           COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY,
           COMPLETELY_METRIZABLE_SPACE_EUCLIDEANREAL, COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
           HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE,
           COMPLETELY_METRIZABLE_SPACE_RETRACTION_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Product metric. For the nicest fit with the main Euclidean theories, we   -/
/- make this the Euclidean product, though others would work topologically.  -/
/- (metric.ml 30539-30676)                                                    -/
/- ------------------------------------------------------------------------- -/

structure PM1 where
  prod_metric : thm
  PROD_METRIC : thm
  COMPONENT_LE_PROD_METRIC : thm
  PROD_METRIC_LE_COMPONENTS : thm
  MBALL_PROD_METRIC_SUBSET : thm
  MCBALL_PROD_METRIC_SUBSET : thm
  MBALL_SUBSET_PROD_METRIC : thm
  MCBALL_SUBSET_PROD_METRIC : thm
  MTOPOLOGY_PROD_METRIC : thm
  deriving Inhabited

@[nospecialize]
def setupPM1 [HolBase] (D : MetricDeps) (BBases : Bases) (BProd1 : Prod1)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) : ExceptT String IO PM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        NUM_REDUCE_CONV, .. } := D
  let { AND_FORALL_THM, EXISTS_IN_GSPEC, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ_ALT, IN_CROSS, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_ADD, REAL_LE_ADD2, REAL_LE_ADDL, REAL_LE_ADDR, REAL_LE_LSQRT,
        REAL_LE_MUL, REAL_LE_POW_2, REAL_LE_RSQRT, REAL_LE_TRANS, REAL_LT_MIN, REAL_POW_EQ_0,
        REAL_POW_LE2, .. } := D.core3
  let { SQRT_EQ_0, SQRT_MUL, SQRT_POS_LE, SQRT_POW_2, SUBSET, SUBSET_CROSS, SUBSET_TRANS, .. } :=
    D.core4
  let { FORALL_PAIR_THM, PAIR, PAIR_EQ, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { TOPOLOGY_BASE_UNIQUE, .. } := BBases
  let { prod_topology, .. } := BProd1
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_CONCENTRIC, MDIST_0, MDIST_POS_LE, MDIST_SYM,
        MDIST_TRIANGLE, is_metric_space, mdist, metric_tybij, mspace, .. } := BMetricSpace
  let { IN_MCBALL, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, .. } := BMTopology
  -- @@SCOPE END

  let prod_metric ← new_definition
   r"prod_metric m1 m2 =
  metric((mspace m1 CROSS mspace m2):A#B->bool,
         \((x,y),(x',y')).
            sqrt(mdist m1 (x,x') pow 2 + mdist m2 (y,y') pow 2))"

  let PROD_METRIC ← prove
   r"(!(m1:A metric) (m2:B metric).
      mspace(prod_metric m1 m2) = mspace m1 CROSS mspace m2) /\
   (!(m1:A metric) (m2:B metric).
        mdist(prod_metric m1 m2) =
        \((x,y),(x',y')).
            sqrt(mdist m1 (x,x') pow 2 + mdist m2 (y,y') pow 2))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [mspace] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [mdist] THEN
    REWRITE_TAC [PAIR, ← GSYM PAIR_EQ] THEN REWRITE_TAC [prod_metric] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 metric_tybij)] THEN
    REWRITE_TAC [is_metric_space, FORALL_PAIR_THM, IN_CROSS] THEN
    REPEAT CONJ_TAC THENL
     [SIMP_TAC [SQRT_POS_LE, REAL_LE_ADD, REAL_LE_POW_2],
      REWRITE_TAC [PAIR_EQ, SQRT_EQ_0] THEN SIMP_TAC [REAL_LE_POW_2, ← REAL_ARITH (← q
       r"&0 <= x /\ &0 <= y ==> (x + y = &0 <=> x = &0 /\ y = &0)")] THEN
      SIMP_TAC [REAL_POW_EQ_0, MDIST_0] THEN CONV_TAC NUM_REDUCE_CONV,
      SIMP_TAC [MDIST_SYM],
      MAP_EVERY X_GEN_TAC [← q r"x1:A", ← q r"y1:B", ← q r"x2:A", ← q r"y2:B",
                           ← q r"x3:A", ← q r"y3:B"] THEN
      STRIP_TAC THEN MATCH_MP_TAC REAL_LE_LSQRT THEN
      ASM_SIMP_TAC [REAL_LE_ADD, SQRT_POS_LE, REAL_LE_POW_2] THEN
      REWRITE_TAC [← REAL_ARITH (← q
       r"(a + b:real) pow 2 = (a pow 2 + b pow 2) + &2 * a * b")] THEN
      SIMP_TAC [SQRT_POW_2, REAL_LE_ADD, REAL_LE_POW_2] THEN
      TRANS_TAC REAL_LE_TRANS
       (← q r"(mdist m1 (x1:A,x2) + mdist m1 (x2,x3)) pow 2 +
        (mdist m2 (y1:B,y2) + mdist m2 (y2,y3)) pow 2") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_ADD2 THEN CONJ_TAC THEN
        MATCH_MP_TAC REAL_POW_LE2 THEN
        ASM_MESON_TAC [MDIST_POS_LE, MDIST_TRIANGLE],
        REWRITE_TAC [← REAL_ARITH (← q
         r"(x1 + x2) pow 2 + (y1 + y2) pow 2 <=
          ((x1 pow 2 + y1 pow 2) + (x2 pow 2 + y2 pow 2)) + &2 * b <=>
          x1 * x2 + y1 * y2 <= b")] THEN
        REWRITE_TAC [← GSYM SQRT_MUL] THEN MATCH_MP_TAC REAL_LE_RSQRT THEN
        REWRITE_TAC [REAL_LE_POW_2, ← REAL_ARITH (← q
          r"(x1 * x2 + y1 * y2) pow 2 <=
           (x1 pow 2 + y1 pow 2) * (x2 pow 2 + y2 pow 2) <=>
           &0 <= (x1 * y2 - x2 * y1) pow 2")]]])

  let COMPONENT_LE_PROD_METRIC ← prove
   r"!m1 m2 x1 y1 x2:A y2:B.
        mdist m1 (x1,x2) <= mdist (prod_metric m1 m2) ((x1,y1),(x2,y2)) /\
        mdist m2 (y1,y2) <= mdist (prod_metric m1 m2) ((x1,y1),(x2,y2))"
   (REPEAT GEN_TAC THEN CONJ_TAC THEN REWRITE_TAC [PROD_METRIC] THEN
    MATCH_MP_TAC REAL_LE_RSQRT THEN REWRITE_TAC [REAL_LE_ADDR, REAL_LE_ADDL] THEN
    REWRITE_TAC [REAL_LE_POW_2])

  let PROD_METRIC_LE_COMPONENTS ← prove
   r"!m1 m2 x1 y1 x2:A y2:B.
        x1 IN mspace m1 /\ x2 IN mspace m1 /\
        y1 IN mspace m2 /\ y2 IN mspace m2
        ==> mdist (prod_metric m1 m2) ((x1,y1),(x2,y2))
            <= mdist m1 (x1,x2) + mdist m2 (y1,y2)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [PROD_METRIC] THEN
    MATCH_MP_TAC REAL_LE_LSQRT THEN ASM_SIMP_TAC [REAL_LE_ADD, MDIST_POS_LE,
     ← REAL_ARITH (← q r"x pow 2 + y pow 2 <= (x + y) pow 2 <=> &0 <= x * y")] THEN
    ASM_SIMP_TAC [REAL_LE_MUL, MDIST_POS_LE])

  let MBALL_PROD_METRIC_SUBSET ← prove
   r"!m1 m2 x:A y:B r.
        mball (prod_metric m1 m2) ((x,y),r) SUBSET
        mball m1 (x,r) CROSS mball m2 (y,r)"
   (REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_MBALL, IN_CROSS,
                 ← CONJUNCT1 PROD_METRIC] THEN
    MESON_TAC [COMPONENT_LE_PROD_METRIC, REAL_LET_TRANS])

  let MCBALL_PROD_METRIC_SUBSET ← prove
   r"!m1 m2 x:A y:B r.
        mcball (prod_metric m1 m2) ((x,y),r) SUBSET
        mcball m1 (x,r) CROSS mcball m2 (y,r)"
   (REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_MCBALL, IN_CROSS,
                 ← CONJUNCT1 PROD_METRIC] THEN
    MESON_TAC [COMPONENT_LE_PROD_METRIC, REAL_LE_TRANS])

  let MBALL_SUBSET_PROD_METRIC ← prove
   r"!m1 m2 x:A y:B r r'.
        mball m1 (x,r) CROSS mball m2 (y,r')
        SUBSET mball (prod_metric m1 m2) ((x,y),r + r')"
   (REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_MBALL, IN_CROSS,
                 ← CONJUNCT1 PROD_METRIC] THEN
    MESON_TAC [← REAL_ARITH (← q r"x <= y + z /\ y < a /\ z < b ==> x < a + b"),
               PROD_METRIC_LE_COMPONENTS])

  let MCBALL_SUBSET_PROD_METRIC ← prove
   r"!m1 m2 x:A y:B r r'.
        mcball m1 (x,r) CROSS mcball m2 (y,r')
        SUBSET mcball (prod_metric m1 m2) ((x,y),r + r')"
   (REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_MCBALL, IN_CROSS,
                 ← CONJUNCT1 PROD_METRIC] THEN
    MESON_TAC [← REAL_ARITH (← q r"x <= y + z /\ y <= a /\ z <= b ==> x <= a + b"),
               PROD_METRIC_LE_COMPONENTS])

  let MTOPOLOGY_PROD_METRIC ← prove
   r"!(m1:A metric) (m2:B metric).
        mtopology(prod_metric m1 m2) =
        prod_topology (mtopology m1) (mtopology m2)"
   (REPEAT GEN_TAC THEN CONV_TAC SYM_CONV THEN REWRITE_TAC [prod_topology] THEN
    MATCH_MP_TAC TOPOLOGY_BASE_UNIQUE THEN
    REWRITE_TAC [← SET_RULE (← q r"GSPEC a x <=> x IN GSPEC a")] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [FORALL_IN_GSPEC, OPEN_IN_MTOPOLOGY, PROD_METRIC] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [SUBSET_CROSS, FORALL_PAIR_THM, IN_CROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"r1:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"r2:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"min r1 r2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      W (MP_TAC o PART_MATCH lhand MBALL_PROD_METRIC_SUBSET o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      REWRITE_TAC [SUBSET_CROSS] THEN REPEAT DISJ2_TAC THEN CONJ_TAC,
      REWRITE_TAC [FORALL_PAIR_THM, EXISTS_IN_GSPEC] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A#B->bool", ← q r"x:A", ← q r"y:B"] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [OPEN_IN_MTOPOLOGY] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"(x,y):A#B"))) ASSUME_TAC) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"mball m1 (x:A,r / &2)", ← q r"mball m2 (y:B,r / &2)"] THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"(x,y):A#B") o REWRITE_RULE [SUBSET] o
       GEN_REWRITE_RULE RAND_CONV [← CONJUNCT1 PROD_METRIC]) THEN
      ASM_REWRITE_TAC [IN_CROSS] THEN STRIP_TAC THEN
      ASM_SIMP_TAC [OPEN_IN_MBALL, IN_CROSS, CENTRE_IN_MBALL, REAL_HALF] THEN
      W (MP_TAC o PART_MATCH lhand MBALL_SUBSET_PROD_METRIC o lhand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
    MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN REAL_ARITH_TAC)

  return { prod_metric, PROD_METRIC, COMPONENT_LE_PROD_METRIC, PROD_METRIC_LE_COMPONENTS,
           MBALL_PROD_METRIC_SUBSET, MCBALL_PROD_METRIC_SUBSET, MBALL_SUBSET_PROD_METRIC,
           MCBALL_SUBSET_PROD_METRIC, MTOPOLOGY_PROD_METRIC }

/- ------------------------------------------------------------------------- -/
/- Product metrics: metrizability and completeness.  (metric.ml 30678-30792) -/
/- ------------------------------------------------------------------------- -/

structure PM2 where
  SUBMETRIC_PROD_METRIC : thm
  METRIZABLE_SPACE_PROD_TOPOLOGY : thm
  CAUCHY_IN_PROD_METRIC : thm
  MCOMPLETE_PROD_METRIC : thm
  COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupPM2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BProd1 : Prod1) (BHomeoSpace : HomeoSpace)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BMetricSpace : MetricSpace)
    (BMetrizable : Metrizable) (BLimits2 : Limits2) (BCauchy1 : Cauchy1) (BCMS1 : CMS1)
    (BPM1 : PM1) : ExceptT String IO PM2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, METIS_TAC, REAL_ARITH, SET_TAC, .. } := D
  let { CROSS_EMPTY, ETA_AX, EXTENSION, .. } := D.core1
  let { IMP_CONJ, INTER_CROSS, IN_CROSS, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        .. } := D.core2
  let { REAL_ADD_SYM, REAL_LET_TRANS, .. } := D.core3
  let { o_DEF, .. } := D.core4
  let { EQ_IMP, EXISTS_PAIR_THM, FORALL_AND_THM, FORALL_PAIR_FUN_THM, FORALL_PAIR_THM, .. } :=
    D.core5
  let { REAL_HALF, .. } := D.misc
  let { CLOSED_IN_TOPSPACE, .. } := BTopology
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, .. } := BDiscrete
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CROSS, SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT, PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT, .. } :=
    BHomeoSpace
  let { CLOSED_IN_HAUSDORFF_SING, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_PROD_TOPOLOGY, .. } := BHausdorff2
  let { SUBMETRIC, submetric, .. } := BMetricSpace
  let { HOMEOMORPHIC_METRIZABLE_SPACE, METRIZABLE_IMP_HAUSDORFF_SPACE,
        METRIZABLE_SPACE_DISCRETE_TOPOLOGY, METRIZABLE_SPACE_SUBTOPOLOGY, metrizable_space, .. } :=
    BMetrizable
  let { LIMIT_PAIRWISE, .. } := BLimits2
  let { CAUCHY_IN_CONST, MCOMPLETE_EMPTY_MSPACE, cauchy_in, mcomplete, .. } := BCauchy1
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, COMPLETELY_METRIZABLE_SPACE_CLOSED_IN,
        COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY, HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE,
        completely_metrizable_space, .. } := BCMS1
  let { COMPONENT_LE_PROD_METRIC, MTOPOLOGY_PROD_METRIC, PROD_METRIC, PROD_METRIC_LE_COMPONENTS,
        prod_metric, .. } := BPM1
  -- @@SCOPE END

  let SUBMETRIC_PROD_METRIC ← prove
   r"!m1 m2 s:A->bool t:B->bool.
        submetric (prod_metric m1 m2) (s CROSS t) =
        prod_metric (submetric m1 s) (submetric m2 t)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [prod_metric] THEN
    GEN_REWRITE_TAC LAND_CONV [submetric] THEN
    REWRITE_TAC [SUBMETRIC, PROD_METRIC, INTER_CROSS])

  let METRIZABLE_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        metrizable_space (prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        metrizable_space top1 /\ metrizable_space top2"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_MESON_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY,
                     METRIZABLE_SPACE_DISCRETE_TOPOLOGY],
      ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL
     [ALL_TAC, MESON_TAC [MTOPOLOGY_PROD_METRIC, metrizable_space]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP METRIZABLE_SPACE_SUBTOPOLOGY) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"(topspace top1 CROSS {b}):A#B->bool")),
      DISCH_THEN (MP_TAC o SPEC (← q r"({a} CROSS topspace top2):A#B->bool"))] THEN
    MATCH_MP_TAC EQ_IMP THEN MATCH_MP_TAC HOMEOMORPHIC_METRIZABLE_SPACE THEN
    REWRITE_TAC [SUBTOPOLOGY_CROSS, SUBTOPOLOGY_TOPSPACE] THENL
     [MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT,
      MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [])

  let CAUCHY_IN_PROD_METRIC ← prove
   r"!m1 m2 x:num->A#B.
        cauchy_in (prod_metric m1 m2) x <=>
        cauchy_in m1 (FST o x) /\ cauchy_in m2 (SND o x)"
   (REWRITE_TAC [FORALL_PAIR_FUN_THM] THEN MAP_EVERY X_GEN_TAC
     [← q r"m1:A metric", ← q r"m2:B metric", ← q r"a:num->A", ← q r"b:num->B"] THEN
    REWRITE_TAC [cauchy_in, ← CONJUNCT1 PROD_METRIC, IN_CROSS, o_DEF] THEN
    ASM_CASES_TAC (← q r"!n. (a:num->A) n IN mspace m1") THEN
    ASM_REWRITE_TAC [FORALL_AND_THM] THEN
    ASM_CASES_TAC (← q r"!n. (b:num->B) n IN mspace m2") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL
     [ASM_MESON_TAC [COMPONENT_LE_PROD_METRIC, REAL_LET_TRANS],
      DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC] THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"M:num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"N:num") THEN
    DISCH_TAC THEN
    EXISTS_TAC (← q r"MAX M N") THEN
    REWRITE_TAC [← ARITH_RULE (← q r"MAX M N <= n <=> M <= n /\ N <= n")] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m:num", ← q r"n:num"])) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH (← q
     r"z <= x + y ==> x < e / &2 ==> y < e / &2 ==> z < e")) THEN
    ASM_MESON_TAC [PROD_METRIC_LE_COMPONENTS, REAL_ADD_SYM])

  let MCOMPLETE_PROD_METRIC ← prove
   r"!(m1:A metric) (m2:B metric).
        mcomplete (prod_metric m1 m2) <=>
        mspace m1 = {} \/ mspace m2 = {} \/ mcomplete m1 /\ mcomplete m2"
   (REPEAT STRIP_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"mspace m1:A->bool = {}", ← q r"mspace m2:B->bool = {}"] THEN
    ASM_SIMP_TAC [MCOMPLETE_EMPTY_MSPACE, ← CONJUNCT1 PROD_METRIC, CROSS_EMPTY] THEN
    REWRITE_TAC [mcomplete, CAUCHY_IN_PROD_METRIC] THEN
    REWRITE_TAC [MTOPOLOGY_PROD_METRIC, LIMIT_PAIRWISE, EXISTS_PAIR_THM] THEN
    EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN DISCH_TAC THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(mspace m2:B->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\n. (x n,y)):num->A#B")),
      X_GEN_TAC (← q r"y:num->B") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(mspace m1:A->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\n. (x,y n)):num->A#B"))] THEN
    ASM_REWRITE_TAC [o_DEF, ETA_AX, CAUCHY_IN_CONST] THEN MESON_TAC [])

  let COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        completely_metrizable_space (prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        completely_metrizable_space top1 /\ completely_metrizable_space top2"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_MESON_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY,
                     COMPLETELY_METRIZABLE_SPACE_DISCRETE_TOPOLOGY],
      ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [completely_metrizable_space] THEN
      METIS_TAC [MCOMPLETE_PROD_METRIC, MTOPOLOGY_PROD_METRIC]] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP METRIZABLE_IMP_HAUSDORFF_SPACE o
       MATCH_MP COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE) THEN
    REWRITE_TAC [HAUSDORFF_SPACE_PROD_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, IN_CROSS, FORALL_PAIR_THM] THEN
    (STRIP_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] COMPLETELY_METRIZABLE_SPACE_CLOSED_IN))
    THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"(topspace top1 CROSS {b}):A#B->bool")),
      DISCH_THEN (MP_TAC o SPEC (← q r"({a} CROSS topspace top2):A#B->bool"))] THEN
    REWRITE_TAC [CLOSED_IN_CROSS, CLOSED_IN_TOPSPACE] THEN
    ASM_SIMP_TAC [CLOSED_IN_HAUSDORFF_SING] THEN MATCH_MP_TAC EQ_IMP THEN
    MATCH_MP_TAC HOMEOMORPHIC_COMPLETELY_METRIZABLE_SPACE THEN
    REWRITE_TAC [SUBTOPOLOGY_CROSS, SUBTOPOLOGY_TOPSPACE] THENL
     [MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT,
      MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [])

  return { SUBMETRIC_PROD_METRIC, METRIZABLE_SPACE_PROD_TOPOLOGY, CAUCHY_IN_PROD_METRIC,
           MCOMPLETE_PROD_METRIC, COMPLETELY_METRIZABLE_SPACE_PROD_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Boundedness in product metrics.  (metric.ml 30794-30897)                  -/
/- ------------------------------------------------------------------------- -/

structure PM3 where
  MBOUNDED_CROSS : thm
  MBOUNDED_PROD_METRIC : thm
  TOTALLY_BOUNDED_IN_CROSS : thm
  TOTALLY_BOUNDED_IN_PROD_METRIC : thm
  deriving Inhabited

@[nospecialize]
def setupPM3 [HolBase] (D : MetricDeps) (BBounded : Bounded) (BCauchy1 : Cauchy1)
    (BTotBdd1 : TotBdd1) (BPM1 : PM1) (BPM2 : PM2) : ExceptT String IO PM3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, .. } := D
  let { CROSS_EMPTY, ETA_AX, FORALL_IN_IMAGE, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, IN_CROSS, IN_IMAGE, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } :=
    D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_CROSS, SUBSET_TRANS, o_DEF, o_THM, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_AND_THM, FORALL_PAIR_FUN_THM, FORALL_PAIR_THM,
        LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, o_ASSOC, .. } := D.core5
  let { MBOUNDED_EMPTY, MBOUNDED_SUBSET, mbounded, .. } := BBounded
  let { CAUCHY_IN_SUBSEQUENCE, .. } := BCauchy1
  let { TOTALLY_BOUNDED_IN_EMPTY, TOTALLY_BOUNDED_IN_SEQUENTIALLY, TOTALLY_BOUNDED_IN_SUBSET,
        .. } := BTotBdd1
  let { MCBALL_PROD_METRIC_SUBSET, MCBALL_SUBSET_PROD_METRIC, PROD_METRIC, .. } := BPM1
  let { CAUCHY_IN_PROD_METRIC, .. } := BPM2
  -- @@SCOPE END

  let MBOUNDED_CROSS ← prove
   r"!(m1:A metric) (m2:B metric) s t.
        mbounded (prod_metric m1 m2) (s CROSS t) <=>
        s = {} \/ t = {} \/ mbounded m1 s /\ mbounded m2 t"
   (REPEAT GEN_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:A->bool = {}", ← q r"t:B->bool = {}"] THEN
    ASM_REWRITE_TAC [MBOUNDED_EMPTY, CROSS_EMPTY] THEN
    REWRITE_TAC [mbounded, EXISTS_PAIR_THM] THEN MATCH_MP_TAC (← MESON [] (← q
     r"(!x y. P x y <=> Q x /\ R y)
      ==> ((?x y. P x y) <=> (?x. Q x) /\ (?y. R y))")) THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_TAC (← q r"r:real")) THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
      REPEAT (EXISTS_TAC (← q r"r:real")) THEN
      MATCH_MP_TAC (← MESON [SUBSET_CROSS] (← q
       r"s CROSS t SUBSET u CROSS v /\ ~(s = {}) /\ ~(t = {})
        ==> s SUBSET u /\ t SUBSET v")) THEN
      ASM_MESON_TAC [SUBSET_TRANS, MCBALL_PROD_METRIC_SUBSET],
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_TAC (← q r"r1:real")) (X_CHOOSE_TAC (← q r"r2:real"))) THEN
      EXISTS_TAC (← q r"r1 + r2:real") THEN
      W (MP_TAC o PART_MATCH rand MCBALL_SUBSET_PROD_METRIC o rand o snd) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      ASM_REWRITE_TAC [SUBSET_CROSS]])

  let MBOUNDED_PROD_METRIC ← prove
   r"!(m1:A metric) (m2:B metric) u.
        mbounded (prod_metric m1 m2) u <=>
        mbounded m1 (IMAGE FST u) /\ mbounded m2 (IMAGE SND u)"
   (REPEAT GEN_TAC THEN  EQ_TAC THENL
     [REWRITE_TAC [mbounded, SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      REWRITE_TAC [EXISTS_PAIR_THM] THEN MATCH_MP_TAC (← MESON [] (← q
       r"(!r x y. R x y r ==> P x r /\ Q y r)
        ==> (?x y r. R x y r) ==> (?x r. P x r) /\ (?y r. Q y r)")) THEN
      MAP_EVERY X_GEN_TAC [← q r"r:real", ← q r"x:A", ← q r"y:B"] THEN
      MP_TAC (← ISPECL [← q r"m1:A metric", ← q r"m2:B metric", ← q r"x:A", ← q r"y:B",
                        ← q r"r:real"]
          MCBALL_PROD_METRIC_SUBSET) THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN MESON_TAC [],
      STRIP_TAC THEN MATCH_MP_TAC MBOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"((IMAGE FST u) CROSS (IMAGE SND u)):A#B->bool") THEN
      ASM_REWRITE_TAC [MBOUNDED_CROSS, IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC []])

  let TOTALLY_BOUNDED_IN_CROSS ← prove
   r"!(m1:A metric) (m2:B metric) s t.
       totally_bounded_in (prod_metric m1 m2) (s CROSS t) <=>
       s = {} \/ t = {} \/ totally_bounded_in m1 s /\ totally_bounded_in m2 t"
   (REPEAT GEN_TAC THEN MAP_EVERY ASM_CASES_TAC
     [← q r"s:A->bool = {}", ← q r"t:B->bool = {}"] THEN
    ASM_REWRITE_TAC [CROSS_EMPTY, TOTALLY_BOUNDED_IN_EMPTY] THEN
    REWRITE_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY] THEN
    ASM_REWRITE_TAC [← CONJUNCT1 PROD_METRIC, SUBSET_CROSS] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET mspace m1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:B->bool) SUBSET mspace m2") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN STRIP_TAC THEN TRY CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(t:B->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\n. (x n,y)):num->A#B")) THEN
      ASM_REWRITE_TAC [IN_CROSS, CAUCHY_IN_PROD_METRIC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [o_DEF],
      X_GEN_TAC (← q r"y:num->B") THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"~(s:A->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(\n. (x,y n)):num->A#B")) THEN
      ASM_REWRITE_TAC [IN_CROSS, CAUCHY_IN_PROD_METRIC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [o_DEF],
      REWRITE_TAC [FORALL_PAIR_FUN_THM, IN_CROSS, FORALL_AND_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:num->A", ← q r"y:num->B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r1:num->num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(y:num->B) o (r1:num->num)")) THEN
      ASM_REWRITE_TAC [o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r2:num->num") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(r1:num->num) o (r2:num->num)") THEN
      ASM_SIMP_TAC [o_THM, CAUCHY_IN_PROD_METRIC, o_ASSOC] THEN
      ONCE_REWRITE_TAC [o_ASSOC] THEN GEN_REWRITE_TAC
       (BINOP_CONV o RAND_CONV o LAND_CONV o LAND_CONV) [o_DEF] THEN
      ASM_REWRITE_TAC [ETA_AX] THEN ASM_SIMP_TAC [CAUCHY_IN_SUBSEQUENCE]])

  let TOTALLY_BOUNDED_IN_PROD_METRIC ← prove
   r"!(m1:A metric) (m2:B metric) u.
        totally_bounded_in (prod_metric m1 m2) u <=>
        totally_bounded_in m1 (IMAGE FST u) /\
        totally_bounded_in m2 (IMAGE SND u)"
   (REPEAT GEN_TAC THEN  EQ_TAC THENL
     [REWRITE_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      REWRITE_TAC [← CONJUNCT1 PROD_METRIC, IN_CROSS] THEN STRIP_TAC THEN
      CONJ_TAC THEN (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      SIMP_TAC [IN_IMAGE, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      GEN_TAC THEN X_GEN_TAC (← q r"z:num->A#B") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:num->A#B")) THEN
      ASM_REWRITE_TAC [CAUCHY_IN_PROD_METRIC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM_SIMP_TAC [o_DEF],
      STRIP_TAC THEN MATCH_MP_TAC TOTALLY_BOUNDED_IN_SUBSET THEN
      EXISTS_TAC (← q r"((IMAGE FST u) CROSS (IMAGE SND u)):A#B->bool") THEN
      ASM_REWRITE_TAC [TOTALLY_BOUNDED_IN_CROSS, IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC []])

  return { MBOUNDED_CROSS, MBOUNDED_PROD_METRIC, TOTALLY_BOUNDED_IN_CROSS,
           TOTALLY_BOUNDED_IN_PROD_METRIC }

/- ------------------------------------------------------------------------- -/
/- Three more restrictive notions of continuity for metric spaces.           -/
/- (metric.ml 30902-30978)                                                    -/
/- ------------------------------------------------------------------------- -/

structure LIP1 where
  lipschitz_continuous_map : thm
  LIPSCHITZ_CONTINUOUS_MAP_POS : thm
  LIPSCHITZ_CONTINUOUS_MAP_EQ : thm
  LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC : thm
  LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO : thm
  LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC : thm
  LIPSCHITZ_CONTINUOUS_MAP_CONST : thm
  LIPSCHITZ_CONTINUOUS_MAP_ID : thm
  LIPSCHITZ_CONTINUOUS_MAP_COMPOSE : thm
  deriving Inhabited

@[nospecialize]
def setupLIP1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) :
    ExceptT String IO LIP1 := do
  -- @@SCOPE BEGIN
  let { new_definition, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_ID, .. } := D.core1
  let { IMP_CONJ, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS, REAL_LT_MUL,
        REAL_MUL_ASSOC, REAL_MUL_LID, .. } := D.core3
  let { SUBSET, SUBSET_REFL, o_THM, .. } := D.core4
  let { MDIST_POS_LE, MDIST_REFL, SUBMETRIC, SUBMETRIC_SUBMETRIC, .. } := BMetricSpace
  -- @@SCOPE END

  let lipschitz_continuous_map ← new_definition
   r"lipschitz_continuous_map (m1,m2) f <=>
        IMAGE f (mspace m1) SUBSET mspace m2 /\
        ?B. !x y. x IN mspace m1 /\ y IN mspace m1
                  ==> mdist m2 (f x,f y) <= B * mdist m1 (x,y)"

  let LIPSCHITZ_CONTINUOUS_MAP_POS ← prove
   r"!m1 m2 f:A->B.
        lipschitz_continuous_map (m1,m2) f <=>
        IMAGE f (mspace m1) SUBSET mspace m2 /\
        ?B. &0 < B /\
            !x y. x IN mspace m1 /\ y IN mspace m1
                  ==> mdist m2 (f x,f y) <= B * mdist m1 (x,y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [lipschitz_continuous_map] THEN
    AP_TERM_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"abs B + &1") THEN CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"B * mdist m1 (x:A,y)") THEN
    ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_LE_RMUL THEN
    ASM_SIMP_TAC [MDIST_POS_LE] THEN REAL_ARITH_TAC)

  let LIPSCHITZ_CONTINUOUS_MAP_EQ ← prove
   r"!m1 m2 f g.
      (!x. x IN mspace m1 ==> f x = g x) /\ lipschitz_continuous_map (m1,m2) f
      ==> lipschitz_continuous_map (m1,m2) g"
   (REWRITE_TAC [lipschitz_continuous_map] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IMP_CONJ] THEN SIMP_TAC [])

  let LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        lipschitz_continuous_map (m1,m2) f
        ==> lipschitz_continuous_map (submetric m1 s,m2) f"
   (REWRITE_TAC [lipschitz_continuous_map, SUBMETRIC] THEN SET_TAC [])

  let LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO ← prove
   r"!m1 m2 f s t.
           lipschitz_continuous_map (submetric m1 t,m2) f /\ s SUBSET t
           ==> lipschitz_continuous_map (submetric m1 s,m2) f"
   (MESON_TAC [LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC, SUBMETRIC_SUBMETRIC,
               ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")])

  let LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        lipschitz_continuous_map (m1,submetric m2 s) f <=>
        IMAGE f (mspace m1) SUBSET s /\
        lipschitz_continuous_map (m1,m2) f"
   (REWRITE_TAC [lipschitz_continuous_map, SUBMETRIC] THEN SET_TAC [])

  let LIPSCHITZ_CONTINUOUS_MAP_CONST ← prove
   r"!m1:A metric m2:B metric c.
        lipschitz_continuous_map (m1,m2) (\x. c) <=>
        mspace m1 = {} \/ c IN mspace m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [lipschitz_continuous_map] THEN
    ASM_CASES_TAC (← q r"mspace m1:A->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, NOT_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"(c:B) IN mspace m2") THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"&1") THEN ASM_SIMP_TAC [MDIST_REFL, MDIST_POS_LE, REAL_MUL_LID])

  let LIPSCHITZ_CONTINUOUS_MAP_ID ← prove
   r"!m1:A metric. lipschitz_continuous_map (m1,m1) (\x. x)"
   (REWRITE_TAC [lipschitz_continuous_map, IMAGE_ID, SUBSET_REFL] THEN
    GEN_TAC THEN EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LE_REFL, REAL_MUL_LID])

  let LIPSCHITZ_CONTINUOUS_MAP_COMPOSE ← prove
   r"!m1 m2 m3 f:A->B g:B->C.
      lipschitz_continuous_map (m1,m2) f /\ lipschitz_continuous_map (m2,m3) g
      ==> lipschitz_continuous_map (m1,m3) (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_POS] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"B:real") THEN REPEAT DISCH_TAC THEN
    X_GEN_TAC (← q r"C:real") THEN REPEAT DISCH_TAC THEN ASM_SIMP_TAC [o_THM] THEN
    EXISTS_TAC (← q r"C * B:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN REPEAT DISCH_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"C * mdist m2 ((f:A->B) x,f y)") THEN
    ASM_SIMP_TAC [← GSYM REAL_MUL_ASSOC, REAL_LE_LMUL_EQ])

  return { lipschitz_continuous_map, LIPSCHITZ_CONTINUOUS_MAP_POS, LIPSCHITZ_CONTINUOUS_MAP_EQ,
           LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC, LIPSCHITZ_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO,
           LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC, LIPSCHITZ_CONTINUOUS_MAP_CONST,
           LIPSCHITZ_CONTINUOUS_MAP_ID, LIPSCHITZ_CONTINUOUS_MAP_COMPOSE }

/- ------------------------------------------------------------------------- -/
/- Uniformly continuous maps.  (metric.ml 30980-31105)                       -/
