      ASM_SIMP_TAC [SUBSET_INTER, CLOSURE_OF_SUBSET]])

  let LAVRENTIEV_EXTENSION ← prove
   r"!top s top' (f:A->B).
        s SUBSET topspace top /\
        (metrizable_space top \/ topspace top SUBSET top closure_of s) /\
        completely_metrizable_space top' /\
        continuous_map(subtopology top s,top') f
        ==> ?u g. gdelta_in top u /\
                  s SUBSET u /\
                  u SUBSET top closure_of s /\
                  continuous_map(subtopology top u,top') g /\
                  !x. x IN s ==> g x = f x"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool", ← q r"top':B topology",
                      ← q r"f:A->B"]
      LAVRENTIEV_EXTENSION_GEN) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:A->B") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"top closure_of s INTER u:A->bool") THEN
    ASM_SIMP_TAC [INTER_SUBSET, SUBSET_INTER, CLOSURE_OF_SUBSET] THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [MATCH_MP_TAC GDELTA_IN_INTER THEN
      ASM_SIMP_TAC [CLOSED_IMP_GDELTA_IN, CLOSED_IN_CLOSURE_OF],
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [] (← q
       r"gdelta_in top s ==> t = s ==> gdelta_in top t"))) THEN
      REWRITE_TAC [← SET_RULE (← q r"c INTER u = u <=> u SUBSET c")] THEN
      ASM_MESON_TAC [SUBSET_TRANS, GDELTA_IN_SUBSET]])

  return { GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN, LAVRENTIEV_EXTENSION_GEN,
           LAVRENTIEV_EXTENSION }

/- ------------------------------------------------------------------------- -/
/- Diameter of a set in a metric space.  (metric.ml 33131-33242)            -/
/- ------------------------------------------------------------------------- -/

structure DIAM1 where
  mdiameter : thm
  MDIAMETER_EMPTY : thm
  MDIAMETER_SING : thm
  MDIAMETER_POS_LE : thm
  MDIAMETER_BOUNDED : thm
  MDIAMETER_BOUNDED_BOUND : thm
  MDIAMETER_LE : thm
  MBOUNDED_AND_MDIAMETER_LE : thm
  MDIAMETER_SUBSET : thm
  MBOUNDED_IMP_IN_MSPACE : thm
  deriving Inhabited

@[nospecialize]
def setupDIAM1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricArith : MetricArithB) :
    ExceptT String IO DIAM1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_ELIM_THM, IN_SING, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LET_ANTISYM, REAL_LE_REFL, REAL_LE_TRANS, REAL_NOT_LE, .. } := D.core3
  let { REAL_SUP_LE, REAL_SUP_LE_SUBSET, SUBSET, SUP, SUP_SING, real_gt, .. } := D.core4
  let { MDIST_REFL, .. } := BMetricSpace
  let { IN_MCBALL, MCBALL_SUBSET_MSPACE, .. } := BMTopology
  let { MBOUNDED_EMPTY, MBOUNDED_MCBALL, MBOUNDED_POS, MBOUNDED_SUBSET, mbounded, .. } :=
    BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  -- @@SCOPE END

  let mdiameter ← new_definition
   r"mdiameter (m:A metric) (s:A->bool) =
   if s = {} then &0
   else sup {mdist m (x,y) | x IN s /\ y IN s}"

  let MDIAMETER_EMPTY ← prove
   r"!m:A metric. mdiameter m {} = &0"
   (REWRITE_TAC [mdiameter])

  let MDIAMETER_SING ← prove
   r"!m:A metric. !x. x IN mspace m ==> mdiameter m {x} = &0"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [mdiameter, NOT_INSERT_EMPTY, IN_SING] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f x y | x = a /\ y = a} = {f a a}")] THEN
    ASM_SIMP_TAC [SUP_SING, MDIST_REFL])

  let MDIAMETER_POS_LE ← prove
   r"!m s:A->bool. mbounded m s ==> &0 <= mdiameter m s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MBOUNDED_POS, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A", ← q r"B:real"] THEN
    REWRITE_TAC [SUBSET, IN_MCBALL] THEN STRIP_TAC THEN
    REWRITE_TAC [mdiameter] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [REAL_LE_REFL] THEN
    MP_TAC (← SPEC (← q r"{mdist m (x:A,y) | x IN s /\ y IN s}") SUP) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      EXISTS_TAC (← q r"&2 * B") THEN
      ASM_MESON_TAC [← METRIC_ARITH (← q
       r"c IN mspace m /\ x IN mspace m /\ y IN mspace m /\
        mdist m (c:A,x) <= B /\ mdist m (c,y) <= B
        ==> mdist m (x,y) <= &2 * B")],
      ASM_MESON_TAC [MEMBER_NOT_EMPTY, MDIST_REFL]])

  let MDIAMETER_BOUNDED ← prove
   r"!m s:A->bool.
     mbounded m s
     ==> (!x y. x IN s /\ y IN s ==> mdist m (x,y) <= mdiameter m s) /\
         (!d. &0 <= d /\ d < mdiameter m s
              ==> ?x y. x IN s /\ y IN s /\ mdist m (x,y) > d)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MBOUNDED_POS, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A", ← q r"B:real"] THEN
    REWRITE_TAC [SUBSET, IN_MCBALL] THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_REWRITE_TAC [mdiameter, NOT_IN_EMPTY, REAL_LET_ANTISYM] THEN
    MP_TAC (← SPEC (← q r"{mdist m (x:A,y) | x IN s /\ y IN s}") SUP) THEN
    ABBREV_TAC (← q r"b = sup {mdist m (x:A,y) | x IN s /\ y IN s}") THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [NOT_IN_EMPTY, real_gt] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [MEMBER_NOT_EMPTY], ALL_TAC] THEN
      EXISTS_TAC (← q r"&2 * B") THEN
      ASM_MESON_TAC [← METRIC_ARITH (← q
       r"c IN mspace m /\ x IN mspace m /\ y IN mspace m /\
        mdist m (c:A,x) <= B /\ mdist m (c,y) <= B
        ==> mdist m (x,y) <= &2 * B")],
      MESON_TAC [REAL_NOT_LE]])

  let MDIAMETER_BOUNDED_BOUND ← prove
   r"!m s:A->bool x y.
     mbounded m s /\ x IN s /\ y IN s
     ==> mdist m (x,y) <= mdiameter m s"
   (MESON_TAC [MDIAMETER_BOUNDED])

  let MDIAMETER_LE ← prove
   r"!m s:A->bool d.
     s SUBSET mspace m /\
     (~(s = {}) \/ &0 <= d) /\
     (!x y. x IN s /\ y IN s ==> mdist m (x,y) <= d)
     ==> mdiameter m s <= d"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mdiameter] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [] THEN
    STRIP_TAC THEN MATCH_MP_TAC REAL_SUP_LE THEN
    CONJ_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [FORALL_IN_GSPEC]])

  let MBOUNDED_AND_MDIAMETER_LE ← prove
   r"!m (s:A->bool) r.
        s SUBSET mspace m
        ==> (mbounded m s /\ mdiameter m s <= r <=>
             &0 <= r /\ !x y. x IN s /\ y IN s ==> mdist m(x,y) <= r)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"&0 <= r") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [MDIAMETER_POS_LE, REAL_LE_TRANS]] THEN
    EQ_TAC THENL
     [MESON_TAC [MDIAMETER_BOUNDED_BOUND, REAL_LE_TRANS], ALL_TAC] THEN
    REPEAT STRIP_TAC THENL
     [ALL_TAC, MATCH_MP_TAC MDIAMETER_LE THEN ASM_REWRITE_TAC []] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [MBOUNDED_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
    MATCH_MP_TAC MBOUNDED_SUBSET THEN EXISTS_TAC (← q r"mcball m (a:A,r)") THEN
    ASM_SIMP_TAC [MBOUNDED_MCBALL, SUBSET, IN_MCBALL] THEN ASM SET_TAC [])

  let MDIAMETER_SUBSET ← prove
   r"!m s t:A->bool.
     s SUBSET t /\ mbounded m t ==> mdiameter m s <= mdiameter m t"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_SIMP_TAC [MDIAMETER_EMPTY, MDIAMETER_POS_LE] THEN
    ASM_REWRITE_TAC [mdiameter] THEN
    COND_CASES_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC REAL_SUP_LE_SUBSET THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [MBOUNDED_POS]) THEN
    REWRITE_TAC [SUBSET, IN_MCBALL] THEN
    MESON_TAC [← METRIC_ARITH (← q
      r"c IN mspace m /\ x IN mspace m /\ y IN mspace m /\
       mdist m (c:A,x) <= B /\ mdist m (c,y) <= B
       ==> mdist m (x,y) <= &2 * B")])

  let MBOUNDED_IMP_IN_MSPACE ← prove
   r"!m:A metric s x. mbounded m s /\ x IN s ==> x IN mspace m"
   (REWRITE_TAC [mbounded, LEFT_IMP_EXISTS_THM, SUBSET] THEN
    MESON_TAC [MCBALL_SUBSET_MSPACE, SUBSET])

  return { mdiameter, MDIAMETER_EMPTY, MDIAMETER_SING, MDIAMETER_POS_LE, MDIAMETER_BOUNDED,
           MDIAMETER_BOUNDED_BOUND, MDIAMETER_LE, MBOUNDED_AND_MDIAMETER_LE, MDIAMETER_SUBSET,
           MBOUNDED_IMP_IN_MSPACE }

/- ------------------------------------------------------------------------- -/
/- Diameter of a closure.  (metric.ml 33244-33311)                           -/
/- ------------------------------------------------------------------------- -/

structure DIAM2 where
  MDIAMETER_CLOSURE : thm
  deriving Inhabited

@[nospecialize]
def setupDIAM2 [HolBase] (D : MetricDeps) (BClosure : Closure) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricArith : MetricArithB)
    (BDIAM1 : DIAM1) : ExceptT String IO DIAM2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, SET_TAC, .. } := D
  let { IN_ELIM_THM, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_LE_ANTISYM, REAL_LE_REFL, REAL_NOT_LT, .. } := D.core3
  let { CLOSURE_OF_EMPTY, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE, .. } := BClosure
  let { IN_MBALL, MDIST_SYM, .. } := BMetricSpace
  let { METRIC_CLOSURE_OF, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_CLOSURE_OF, MBOUNDED_SUBSET_MSPACE, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_EMPTY, MDIAMETER_LE, MDIAMETER_SUBSET, .. } := BDIAM1
  -- @@SCOPE END

  let MDIAMETER_CLOSURE ← prove
   r"!m s:A->bool.
     mbounded m s
     ==> mdiameter m (mtopology m closure_of s) = mdiameter m s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
     [/- Direction: diam(closure s) <= diam(s) -/
      ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
       [ASM_SIMP_TAC [CLOSURE_OF_EMPTY, MDIAMETER_EMPTY, REAL_LE_REFL],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"s SUBSET mspace (m:A metric)") ASSUME_TAC THENL
       [ASM_MESON_TAC [MBOUNDED_SUBSET_MSPACE], ALL_TAC] THEN
      MATCH_MP_TAC MDIAMETER_LE THEN REPEAT CONJ_TAC THENL
       [/- First conjunct: closure SUBSET mspace -/
        REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, CLOSURE_OF_SUBSET_TOPSPACE],
        /- Second conjunct: closure nonempty or 0 <= diam s -/
        DISJ1_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"a:A") THEN
        MP_TAC (← ISPECL [← q r"mtopology (m:A metric)", ← q r"s:A->bool"]
          CLOSURE_OF_SUBSET) THEN
        ASM_SIMP_TAC [TOPSPACE_MTOPOLOGY] THEN ASM SET_TAC [],
        /- Third conjunct: distances in closure bounded by diam s -/
        MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
        REWRITE_TAC [METRIC_CLOSURE_OF, IN_ELIM_THM] THEN
        DISCH_THEN (CONJUNCTS_THEN2
          (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "Hx"))
          (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "Hy"))) THEN
        /- Proof by contradiction: assume mdist(x,y) > diam(s) -/
        REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
        ABBREV_TAC (← q r"e = mdist m (x:A,y) - mdiameter m s") THEN
        SUBGOAL_THEN (← q r"&0 < e") ASSUME_TAC THENL
         [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        /- Find x' in s close to x -/
        REMOVE_THEN "Hx" (MP_TAC o SPEC (← q r"e / &4")) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [IN_MBALL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x':A") STRIP_ASSUME_TAC) THEN
        /- Find y' in s close to y -/
        REMOVE_THEN "Hy" (MP_TAC o SPEC (← q r"e / &4")) THEN
        ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [IN_MBALL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"y':A") STRIP_ASSUME_TAC) THEN
        /- Get membership facts -/
        SUBGOAL_THEN (← q r"(x':A) IN mspace m /\ (y':A) IN mspace m")
          STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        /- Get the key bounds -/
        SUBGOAL_THEN (← q r"mdist m (x':A,y') <= mdiameter m s") ASSUME_TAC THENL
         [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        /- Triangle inequality -/
        SUBGOAL_THEN
          (← q r"mdist m (x:A,y) <= mdist m (x,x') + mdist m (x',y') + mdist m (y',y)")
          ASSUME_TAC THENL
         [ASM_MESON_TAC [← METRIC_ARITH (← q
           r"x IN mspace m /\ x' IN mspace m /\ y' IN mspace m /\ y IN mspace m
            ==> mdist m (x:A,y) <=
                mdist m (x,x') + mdist m (x',y') + mdist m (y',y)")],
          ALL_TAC] THEN
        /- Symmetry -/
        SUBGOAL_THEN (← q r"mdist m (y':A,y) = mdist m (y,y')") ASSUME_TAC THENL
         [ASM_MESON_TAC [MDIST_SYM], ALL_TAC] THEN
        /- Derive contradiction -/
        ASM_REAL_ARITH_TAC],
      /- Direction: diam(s) <= diam(closure s) -/
      MATCH_MP_TAC MDIAMETER_SUBSET THEN
      ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY,
                    MBOUNDED_CLOSURE_OF, MBOUNDED_SUBSET_MSPACE]])

  return { MDIAMETER_CLOSURE }

/- ------------------------------------------------------------------------- -/
/- More on diameters.  (metric.ml 33313-33428)                               -/
/- ------------------------------------------------------------------------- -/

structure DIAM3 where
  MDIAMETER_COMPACT_ATTAINED : thm
  MDIAMETER_SUBSET_MCBALL_NONEMPTY : thm
  MDIAMETER_SUBSET_MCBALL : thm
  MDIAMETER_EQ_0 : thm
  MDIAMETER_UNION_LE : thm
  MDIAMETER_SUBMETRIC : thm
  deriving Inhabited

@[nospecialize]
def setupDIAM3 [HolBase] (D : MetricDeps) (BCompact1 : Compact1) (BCompact3 : Compact3)
    (BCompact4 : Compact4) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BRealConn2 : RealConn2) (BCC4 : CC4) (BDIAM1 : DIAM1) :
    ExceptT String IO DIAM3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EQ_EMPTY, EMPTY_SUBSET, EXTENSION, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING, IN_UNION, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { REAL_LE_ANTISYM, .. } := D.core3
  let { SUBSET, .. } := D.core4
  let { EXISTS_PAIR_THM, .. } := D.core5
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { MDIST_0, MDIST_POS_LE, MDIST_TRIANGLE, SUBMETRIC, .. } := BMetricSpace
  let { IN_MCBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_SUBSET_MSPACE, MBOUNDED_UNION, .. } := BBounded
  let { REAL_COMPACT_CONTAINS_SUP, real_compact_def, .. } := BRealConn2
  let { CONTINUOUS_MAP_METRIC, .. } := BCC4
  let { MBOUNDED_IMP_IN_MSPACE, MDIAMETER_BOUNDED_BOUND, MDIAMETER_EMPTY, MDIAMETER_LE,
        MDIAMETER_POS_LE, MDIAMETER_SING, mdiameter, .. } := BDIAM1
  -- @@SCOPE END

  let MDIAMETER_COMPACT_ATTAINED ← prove
   r"!m:A metric s.
     compact_in (mtopology m) s /\ ~(s = {})
     ==> ?x y. x IN s /\ y IN s /\ mdist m (x,y) = mdiameter m s"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s SUBSET mspace (m:A metric)") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"compact_in euclideanreal (IMAGE (mdist (m:A metric)) (s CROSS s))")
      ASSUME_TAC THENL
     [MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"prod_topology (mtopology m) (mtopology (m:A metric))") THEN
      ASM_REWRITE_TAC [COMPACT_IN_CROSS, CONTINUOUS_MAP_METRIC],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"real_compact (IMAGE (mdist (m:A metric)) (s CROSS s))")
      ASSUME_TAC THENL [ASM_REWRITE_TAC [real_compact_def], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(IMAGE (mdist (m:A metric)) (s CROSS s) = {})") ASSUME_TAC THENL
     [ASM_SIMP_TAC [IMAGE_EQ_EMPTY, CROSS_EQ_EMPTY], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"sup (IMAGE (mdist (m:A metric)) (s CROSS s))
                  IN IMAGE (mdist m) (s CROSS s)") ASSUME_TAC THENL
     [ASM_MESON_TAC [REAL_COMPACT_CONTAINS_SUP], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"mdiameter m (s:A->bool) =
                  sup (IMAGE (mdist m) (s CROSS s))") ASSUME_TAC THENL
     [ASM_REWRITE_TAC [mdiameter] THEN AP_TERM_TAC THEN
      REWRITE_TAC [EXTENSION, IN_IMAGE, IN_ELIM_THM, IN_CROSS,
                   EXISTS_PAIR_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_IMAGE]) THEN
    REWRITE_TAC [IN_CROSS, EXISTS_PAIR_THM] THEN ASM_MESON_TAC [])

  let MDIAMETER_SUBSET_MCBALL_NONEMPTY ← prove
   r"!m:A metric s.
     mbounded m s /\ ~(s = {})
     ==> ?z. z IN s /\ s SUBSET mcball m (z,mdiameter m s)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [SUBSET, IN_MCBALL] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    ASM_MESON_TAC [MDIAMETER_BOUNDED_BOUND, MBOUNDED_IMP_IN_MSPACE])

  let MDIAMETER_SUBSET_MCBALL ← prove
   r"!m:A metric s.
     mbounded m s ==> ?z. s SUBSET mcball m (z,mdiameter m s)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [ASM_REWRITE_TAC [EMPTY_SUBSET],
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool"]
        MDIAMETER_SUBSET_MCBALL_NONEMPTY) THEN
      ASM_REWRITE_TAC [] THEN MESON_TAC []])

  let MDIAMETER_EQ_0 ← prove
   r"!m:A metric s.
     mbounded m s
     ==> (mdiameter m s = &0 <=> s = {} \/ ?a. s = {a})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN REWRITE_TAC [← SET_RULE (← q
       r"s = {} \/ (?a. s = {a}) <=> !a b. a IN s /\ b IN s ==> a = b")] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mdist m (a:A,b) <= &0") MP_TAC THENL
       [ASM_MESON_TAC [MDIAMETER_BOUNDED_BOUND], ALL_TAC] THEN
      ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE, MDIST_0, MDIST_POS_LE,
                     REAL_LE_ANTISYM],
      STRIP_TAC THEN ASM_REWRITE_TAC [MDIAMETER_EMPTY] THEN
      ASM_MESON_TAC [MDIAMETER_SING, MBOUNDED_IMP_IN_MSPACE, IN_SING]])

  let MDIAMETER_UNION_LE ← prove
   r"!m:A metric s t.
     mbounded m s /\ mbounded m t /\ ~(s INTER t = {})
     ==> mdiameter m (s UNION t) <= mdiameter m s + mdiameter m t"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"z:A") o REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER]) THEN
    SUBGOAL_THEN (← q r"mbounded m (s UNION t:A->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_UNION], ALL_TAC] THEN
    MATCH_MP_TAC MDIAMETER_LE THEN
    ASM_SIMP_TAC [MBOUNDED_SUBSET_MSPACE] THEN
    CONJ_TAC THENL [DISJ1_TAC THEN ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(z:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [IN_UNION] THEN STRIP_TAC THENL
     [MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"x:A", ← q r"y:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"t:A->bool"] MDIAMETER_POS_LE) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      /- Mixed cases: use triangle inequality via z -/
      SUBGOAL_THEN (← q r"x IN mspace m /\ y IN mspace (m:A metric)")
        STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"x:A", ← q r"z:A", ← q r"y:A"]
            MDIST_TRIANGLE) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"x:A", ← q r"z:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"t:A->bool", ← q r"z:A", ← q r"y:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      SUBGOAL_THEN (← q r"x IN mspace m /\ y IN mspace (m:A metric)")
        STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"x:A", ← q r"z:A", ← q r"y:A"]
            MDIST_TRIANGLE) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"t:A->bool", ← q r"x:A", ← q r"z:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"z:A", ← q r"y:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC,
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"t:A->bool", ← q r"x:A", ← q r"y:A"]
            MDIAMETER_BOUNDED_BOUND) THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool"] MDIAMETER_POS_LE) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC])

  -- Submetric preserves mdiameter (mdist is the same).

  let MDIAMETER_SUBMETRIC ← prove
   r"!m:A metric s t. mdiameter (submetric m s) t = mdiameter m t"
   (REWRITE_TAC [mdiameter, SUBMETRIC])

  return { MDIAMETER_COMPACT_ATTAINED, MDIAMETER_SUBSET_MCBALL_NONEMPTY,
           MDIAMETER_SUBSET_MCBALL, MDIAMETER_EQ_0, MDIAMETER_UNION_LE, MDIAMETER_SUBMETRIC }

/- ------------------------------------------------------------------------- -/
/- Lebesgue covering lemma.  (metric.ml 33430-33525)                         -/
/- ------------------------------------------------------------------------- -/

structure LEB where
  LEBESGUE_COVERING_LEMMA : thm
  LEBESGUE_COVERING_LEMMA_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupLEB [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BMetricSpace : MetricSpace) (BBounded : Bounded) (BMetricHaus : MetricHaus)
    (BMCompact1 : MCompact1) (BDIAM1 : DIAM1) : ExceptT String IO LEB := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, .. } := D.core1
  let { IN_ELIM_THM, IN_UNIONS, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { SUBSET, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { OPEN_IN_SUBTOPOLOGY, .. } := BSubtopology
  let { IN_MBALL, .. } := BMetricSpace
  let { MBOUNDED_SUBSET, .. } := BBounded
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { LEBESGUE_NUMBER, .. } := BMCompact1
  let { MBOUNDED_IMP_IN_MSPACE, MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  -- @@SCOPE END

  let LEBESGUE_COVERING_LEMMA ← prove
   r"!m:A metric s c.
     compact_in (mtopology m) s /\ ~(c = {}) /\
     s SUBSET UNIONS c /\ (!b. b IN c ==> open_in (mtopology m) b)
     ==> ?d. &0 < d /\
             !t. t SUBSET s /\ mdiameter m t <= d
                 ==> ?b. b IN c /\ t SUBSET b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"c:(A->bool)->bool"]
      LEBESGUE_NUMBER) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"e / &2") THEN CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"t:A->bool = {}") THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY, EMPTY_SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"x0:A")) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x0:A")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"mball m (x0:A,e)") THEN ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"mbounded m (t:A->bool)") ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_SUBSET, COMPACT_IN_IMP_MBOUNDED], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(y:A) IN mspace m /\ x0 IN mspace m") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"mdist m (x0:A,y) <= mdiameter m t") MP_TAC THENL
     [ASM_MESON_TAC [MDIAMETER_BOUNDED_BOUND], ASM_REAL_ARITH_TAC])

  let LEBESGUE_COVERING_LEMMA_GEN ← prove
   r"!m:A metric u s c.
     compact_in (mtopology m) s /\ ~(c = {}) /\
     s SUBSET UNIONS c /\
     (!b. b IN c ==> open_in (subtopology (mtopology m) u) b)
     ==> ?d. &0 < d /\
             !t. t SUBSET s /\ mdiameter m t <= d
                 ==> ?b. b IN c /\ t SUBSET b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    /- Form lifted cover c' from subtopology opens to full opens -/
    ABBREV_TAC
      (← q r"c' = {v:A->bool | ?b. b IN c /\ open_in (mtopology m) v /\ b = v INTER u}")
      THEN
    /- s SUBSET UNIONS c' because each b in c lifts to some v in c' -/
    SUBGOAL_THEN (← q r"s SUBSET UNIONS (c':(A->bool)->bool)") ASSUME_TAC THENL
     [REWRITE_TAC [SUBSET, IN_UNIONS] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN UNIONS c") MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [IN_UNIONS] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"b:A->bool")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:A->bool")) THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"v:A->bool") THEN CONJ_TAC THENL
       [EXPAND_TAC "c'" THEN REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
        ASM SET_TAC []],
      ALL_TAC] THEN
    /- c' is nonempty since c is nonempty -/
    SUBGOAL_THEN (← q r"~(c':(A->bool)->bool = {})") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"b0:A->bool")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b0:A->bool")) THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, ← GSYM MEMBER_NOT_EMPTY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v0:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"v0:A->bool") THEN EXPAND_TAC "c'" THEN
      REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
      ALL_TAC] THEN
    /- Elements of c' are open in mtopology -/
    SUBGOAL_THEN (← q r"!v:A->bool. v IN c' ==> open_in (mtopology m) v")
      ASSUME_TAC THENL
     [EXPAND_TAC "c'" THEN REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    /- Apply LEBESGUE_COVERING_LEMMA to c' -/
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"c':(A->bool)->bool"]
          LEBESGUE_COVERING_LEMMA) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
    /- Extract b from c such that v witnesses b = v INTER u -/
    UNDISCH_TAC (← q r"(v:A->bool) IN c'") THEN EXPAND_TAC "c'" THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"b:A->bool") THEN ASM_REWRITE_TAC [] THEN
    /- t SUBSET b = v INTER u: need t SUBSET v and t SUBSET u -/
    MATCH_MP_TAC (← SET_RULE (← q
      r"t SUBSET v /\ t SUBSET u /\ b = v INTER u ==> t SUBSET b")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC SUBSET_TRANS THEN
    EXISTS_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"UNIONS c:A->bool") THEN
    ASM_REWRITE_TAC [UNIONS_SUBSET] THEN X_GEN_TAC (← q r"b':A->bool") THEN
    DISCH_TAC THEN
    UNDISCH_TAC (← q r"!b:A->bool. b IN c ==> open_in (subtopology (mtopology m) u) b")
    THEN DISCH_THEN (MP_TAC o SPEC (← q r"b':A->bool")) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN SET_TAC [])

  return { LEBESGUE_COVERING_LEMMA, LEBESGUE_COVERING_LEMMA_GEN }


/- ------------------------------------------------------------------------- -/
/- Well-chained sets in metric spaces (epsilon-chains).                      -/
/- Generalizes the Euclidean well-chained theory from paths.ml.              -/
/- (metric.ml 33532-33594)                                                    -/
/- ------------------------------------------------------------------------- -/

structure WC1 where
  WELLCHAINED_ELEMENTS : thm
  WELLCHAINED_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupWC1 [HolBase] (D : MetricDeps) : ExceptT String IO WC1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, INDUCT_TAC, MESON, MESON_TAC, .. } := D
  let { IMP_CONJ, IN_ELIM_THM, LE, LEFT_IMP_EXISTS_THM, LE_0, LE_REFL, LE_SUC_LT, LT,
        LT_IMP_LE, LT_REFL, MEMBER_NOT_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ, .. } := D.core4
  let { FORALL_AND_THM, FORALL_UNWIND_THM2, .. } := D.core5
  -- @@SCOPE END

  let WELLCHAINED_ELEMENTS ← prove
   r"!m:A metric s a (b:A) e.
        (?p n. p 0 = a /\ p n = b /\
               (!i. i <= n ==> p i IN s) /\
               (!i. i < n ==> mdist m (p i,p(SUC i)) < e)) <=>
        a IN s /\ b IN s /\
        (!c. c SUBSET s /\ a IN c /\
             (!x y. x IN c /\ y IN s /\ mdist m (x,y) < e ==> y IN c)
             ==> b IN c)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(a:A) IN s") THENL
     [ALL_TAC, ASM_MESON_TAC [LE_0]] THEN
    ASM_CASES_TAC (← q r"(b:A) IN s") THENL
     [ALL_TAC, ASM_MESON_TAC [LE_REFL]] THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"p:num->A", ← q r"n:num"] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!k. k <= n ==> (p:num->A) k IN c")
       (fun th => ASM_MESON_TAC [th, LE_REFL]) THEN
      INDUCT_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"(p:num->A) k") THEN
      REPEAT CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
      DISCH_THEN (MP_TAC o SPEC
       (← q r"{x:A | ?p n. p 0 = a /\ p n = x /\
                      (!i. i <= n ==> p i IN s) /\
                      (!i. i < n ==> mdist m (p i,p(SUC i)) < e)}")) THEN
      ANTS_TAC THENL [ALL_TAC, REWRITE_TAC [IN_ELIM_THM]] THEN
      REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [LE_REFL],
        REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY EXISTS_TAC [← q r"(\n. a):num->A", ← q r"0"] THEN
        ASM_REWRITE_TAC [LT],
        MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
        DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
        REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"p:num->A", ← q r"n:num"] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"\i. if i <= n then (p:num->A) i else y") THEN
        EXISTS_TAC (← q r"SUC n") THEN
        ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC n <= n)")] THEN
        REWRITE_TAC [LE, LT, ← TAUT (← q r"p \/ q ==> r <=> (p ==> r) /\ (q ==> r)"),
                     FORALL_AND_THM, FORALL_UNWIND_THM2] THEN
        REWRITE_TAC [LE_REFL, LE_SUC_LT, LT_REFL] THEN
        ASM_SIMP_TAC [LT_IMP_LE]]])

  let WELLCHAINED_SETS ← prove
   r"!m:A metric s e.
     (!a b. a IN s /\ b IN s
            ==> ?p n. p 0 = a /\ p n = b /\
                      (!i. i <= n ==> p i IN s) /\
                      (!i. i < n ==> mdist m (p i,p(SUC i)) < e)) <=>
     (!c. c SUBSET s /\ ~(c = {}) /\
          (!x y. x IN c /\ y IN s /\ mdist m (x,y) < e ==> y IN c)
          ==> c = s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [WELLCHAINED_ELEMENTS] THEN SIMP_TAC [] THEN
    REWRITE_TAC [← MESON [] (← q
     r"(!(a:A) b. P a /\ P b ==> !(c:A->bool). Q a b c ==> R a b c) <=>
      (!c a b. Q a b c /\ P a /\ P b ==> R a b c)")] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    SIMP_TAC [← GSYM MEMBER_NOT_EMPTY, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET] THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    MESON_TAC [])

  return { WELLCHAINED_ELEMENTS, WELLCHAINED_SETS }

/- ------------------------------------------------------------------------- -/
/- Well-chained sets and connectedness.  (metric.ml 33596-33756)            -/
/- ------------------------------------------------------------------------- -/

structure WC2 where
  EPSILON_ABSORBING_IMP_CLOPEN : thm
  CONNECTED_IN_IMP_WELLCHAINED : thm
  CONNECTED_COMPONENT_OF_IMP_WELLCHAINED : thm
  CONNECTED_EQ_WELLCHAINED_IN : thm
  deriving Inhabited

@[nospecialize]
def setupWC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BConnected1 : Connected1) (BComponents1 : Components1) (BMCompact1 : MCompact1)
    (BWC1 : WC1) : ExceptT String IO WC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, IN_UNIONS, MONO_EXISTS, NOT_IN_EMPTY, .. } :=
    D.core2
  let { SUBSET, UNIONS_0, UNIONS_INSERT, UNION_EMPTY, .. } := D.core4
  let { OPEN_IN_UNIONS, closed_in, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_OPEN, TOPSPACE_SUBTOPOLOGY, .. } :=
    BSubtopology
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_SYM, .. } := BMetricSpace
  let { OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_CLOPEN_IN, connected_in, .. } := BConnected1
  let { connected_component_of, .. } := BComponents1
  let { LEBESGUE_NUMBER, .. } := BMCompact1
  let { WELLCHAINED_ELEMENTS, WELLCHAINED_SETS, .. } := BWC1
  -- @@SCOPE END

  -- Helper: epsilon-absorbing subsets are clopen in subtopology
  let EPSILON_ABSORBING_IMP_CLOPEN ← prove
   r"!m:A metric s c e.
     s SUBSET mspace m /\ c SUBSET s /\ &0 < e /\
     (!x y. x IN c /\ y IN s /\ mdist m (x,y) < e ==> y IN c)
     ==> open_in (subtopology (mtopology m) s) c /\
         closed_in (subtopology (mtopology m) s) c"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"!d:A->bool. d SUBSET s /\
       (!x y. x IN d /\ y IN s /\ mdist m (x,y) < e ==> y IN d)
       ==> open_in (subtopology (mtopology m) (s:A->bool)) d")
      ASSUME_TAC THENL
     [X_GEN_TAC (← q r"d:A->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"d:A->bool = s INTER UNIONS {mball m (z:A,e) | z IN d}")
        SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_INTER, IN_UNIONS, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"w:A") THEN EQ_TAC THENL
         [DISCH_TAC THEN
          SUBGOAL_THEN (← q r"(w:A) IN mspace m") ASSUME_TAC THENL
           [ASM SET_TAC [], ALL_TAC] THEN
          CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
          EXISTS_TAC (← q r"mball m (w:A,e)") THEN CONJ_TAC THENL
           [EXISTS_TAC (← q r"w:A") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
          ASM_SIMP_TAC [CENTRE_IN_MBALL],
          REWRITE_TAC [IN_MBALL] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
            (X_CHOOSE_THEN (← q r"t:A->bool")
              (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC)
                ASSUME_TAC))) THEN
          FIRST_X_ASSUM (MP_TAC o SPECL [← q r"z:A", ← q r"w:A"]) THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
          ASM SET_TAC []],
        MATCH_MP_TAC OPEN_IN_SUBTOPOLOGY_INTER_OPEN THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN
        REWRITE_TAC [FORALL_IN_GSPEC, OPEN_IN_MBALL]],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [FIRST_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [closed_in, TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
      SUBGOAL_THEN (← q r"mspace m INTER s = s:A->bool") SUBST1_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A", ← q r"v:A"] THEN
      REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM_MESON_TAC [MDIST_SYM, SUBSET]])

  let CONNECTED_IN_IMP_WELLCHAINED ← prove
   r"!m:A metric s e a b.
        connected_in (mtopology m) s /\ &0 < e /\ a IN s /\ b IN s
        ==> ?p n. p 0 = a /\ p n = b /\
                  (!i. i <= n ==> p i IN s) /\
                  (!i. i < n ==> mdist m (p i,p(SUC i)) < e)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [connected_in, TOPSPACE_MTOPOLOGY] THEN
    STRIP_TAC THEN
    REWRITE_TAC [WELLCHAINED_ELEMENTS] THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"c:A->bool", ← q r"e:real"]
      EPSILON_ABSORBING_IMP_CLOPEN) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"subtopology (mtopology (m:A metric)) (s:A->bool)")
       CONNECTED_SPACE_CLOPEN_IN) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_OF_IMP_WELLCHAINED ← prove
   r"!m:A metric s a (b:A) e.
        &0 < e /\ connected_component_of (subtopology (mtopology m) s) a b
        ==> ?p n. p 0 = a /\ p n = b /\
                  (!i. i <= n ==> p i IN s) /\
                  (!i. i < n ==> mdist m (p i,p (SUC i)) < e)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC)) THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"t:A->bool", ← q r"e:real",
                      ← q r"a:A", ← q r"b:A"] CONNECTED_IN_IMP_WELLCHAINED) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"p:num->A") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN
    ASM SET_TAC [])

  let CONNECTED_EQ_WELLCHAINED_IN ← prove
   r"!m:A metric s.
    compact_in (mtopology m) s
    ==> (connected_in (mtopology m) s <=>
         !e. &0 < e
             ==> !a b. a IN s /\ b IN s
                       ==> ?p n. p 0 = a /\ p n = b /\
                                 (!i. i <= n ==> p i IN s) /\
                                 (!i. i < n ==> mdist m (p i,p(SUC i)) < e))"
   (GEN_TAC THEN GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
     [/- Forward: connected ==> wellchained -/
      DISCH_TAC THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC CONNECTED_IN_IMP_WELLCHAINED THEN ASM_REWRITE_TAC [],
      /- Backward: wellchained for all eps ==> connected -/
      DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
        ALL_TAC] THEN
      REWRITE_TAC [connected_in, TOPSPACE_MTOPOLOGY] THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [CONNECTED_SPACE_CLOPEN_IN] THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY,
                    ← SET_RULE (← q r"(s:A->bool) SUBSET u ==> u INTER s = s")] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"c:A->bool = {}") THEN ASM_REWRITE_TAC [] THEN
      /- Get open set u with c = s INTER u -/
      UNDISCH_TAC
        (← q r"open_in (subtopology (mtopology (m:A metric)) s) (c:A->bool)") THEN
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      /- Get open set v with s DIFF c = s INTER v -/
      SUBGOAL_THEN
        (← q r"open_in (subtopology (mtopology (m:A metric)) s) (s DIFF c :A->bool)")
        MP_TAC THENL
       [UNDISCH_TAC
          (← q r"closed_in (subtopology (mtopology (m:A metric)) s) (c:A->bool)") THEN
        ASM_SIMP_TAC [closed_in, TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY,
                      ← SET_RULE (← q r"(s:A->bool) SUBSET u ==> u INTER s = s")] THEN
        MESON_TAC [],
        REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC)] THEN
      /- Apply Lebesgue number lemma -/
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"{u:A->bool, v}"]
        LEBESGUE_NUMBER) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
         [REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN ASM_MESON_TAC [],
          REWRITE_TAC [UNIONS_INSERT, UNIONS_0, UNION_EMPTY] THEN
          ASM SET_TAC []],
        ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"eps:real") STRIP_ASSUME_TAC) THEN
      /- Use wellchainedness for eps, rewrite via WELLCHAINED_SETS -/
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"eps:real")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [WELLCHAINED_SETS] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o SPEC (← q r"c:A->bool")) THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      /- c is eps-closed in s -/
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN s") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      UNDISCH_TAC (← q r"(w:A->bool) IN {u:A->bool, v}") THEN
      REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
      DISCH_THEN (DISJ_CASES_THEN SUBST_ALL_TAC) THENL
       [/- w = u: y IN mball(x,eps) SUBSET u, so y IN s INTER u = c -/
        SUBGOAL_THEN (← q r"(y:A) IN mball m (x:A,eps)") MP_TAC THENL
         [REWRITE_TAC [IN_MBALL] THEN ASM_MESON_TAC [SUBSET],
          ASM SET_TAC []],
        /- w = v: x IN mball(x,eps) SUBSET v, contradiction with x IN c -/
        SUBGOAL_THEN (← q r"(x:A) IN mball m (x:A,eps)") MP_TAC THENL
         [MATCH_MP_TAC CENTRE_IN_MBALL THEN ASM SET_TAC [],
          ASM SET_TAC []]]])

  return { EPSILON_ABSORBING_IMP_CLOPEN, CONNECTED_IN_IMP_WELLCHAINED,
           CONNECTED_COMPONENT_OF_IMP_WELLCHAINED, CONNECTED_EQ_WELLCHAINED_IN }

/- ------------------------------------------------------------------------- -/
/- In a compact metric space, connected components = well-chained components.
   Points a and b are in the same connected component of K iff they can be
   epsilon-chained in K for every epsilon > 0. Uses the fact that in compact
   Hausdorff spaces, quasi-components = connected components.
   (metric.ml 33758-33896)                                                    -/
/- ------------------------------------------------------------------------- -/

structure WC3 where
  CONNECTED_COMPONENT_OF_EQ_WELLCHAINED : thm
  deriving Inhabited

@[nospecialize]
def setupWC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BComponents1 : Components1)
    (BMCompact1 : MCompact1) (BQC1 : QC1) (BQC5 : QC5) (BWC1 : WC1) (BWC2 : WC2) :
    ExceptT String IO WC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { IN_INSERT, NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET, UNIONS_0, UNIONS_INSERT, UNION_EMPTY, .. } := D.core4
  let { CLOSED_IN_SUBSET, OPEN_IN_CLOSED_IN, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY,
        COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { HAUSDORFF_SPACE_COMPACT_SEPARATION, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { CENTRE_IN_MBALL, IN_MBALL, .. } := BMetricSpace
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_COMPONENT_IN_TOPSPACE, .. } := BComponents1
  let { LEBESGUE_NUMBER, .. } := BMCompact1
  let { quasi_component_of, .. } := BQC1
  let { QUASI_EQ_CONNECTED_COMPONENT_OF, .. } := BQC5
  let { WELLCHAINED_ELEMENTS, .. } := BWC1
  let { CONNECTED_COMPONENT_OF_IMP_WELLCHAINED, .. } := BWC2
  -- @@SCOPE END

  let CONNECTED_COMPONENT_OF_EQ_WELLCHAINED ← do
    -- t and K DIFF t are both delta-absorbing in K
    let delta_absorbing_tac :=
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN K") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      USE_THEN "lebesgue" (fun th => tactic_of do
        pure (MP_TAC (← MP (← SPEC (← q r"x:A") th) (← ASSUME (← q r"(x:A) IN K"))))) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(x:A) IN mball m (x:A,delta)") ASSUME_TAC THENL
       [MATCH_MP_TAC CENTRE_IN_MBALL THEN ASM_MESON_TAC [SUBSET],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(y:A) IN mball m (x:A,delta)") ASSUME_TAC THENL
       [REWRITE_TAC [IN_MBALL] THEN ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
      UNDISCH_TAC (← q r"(w:A->bool) IN {u:A->bool, v}") THEN
      REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN
      DISCH_THEN (DISJ_CASES_THEN SUBST_ALL_TAC) THEN ASM SET_TAC []
    prove
     r"!m:A metric K a b.
     compact_in (mtopology m) K
     ==> (connected_component_of (subtopology (mtopology m) K) a b <=>
          a IN K /\ b IN K /\
          !e. &0 < e
              ==> ?p n. p 0 = a /\ p n = b /\
                        (!i. i <= n ==> p i IN K) /\
                        (!i. i < n ==> mdist m (p i,p (SUC i)) < e))"
     (REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"top = subtopology (mtopology (m:A metric)) K") THEN
      SUBGOAL_THEN (← q r"(K:A->bool) SUBSET mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"topspace top = (K:A->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "top" THEN
        ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY,
                      ← SET_RULE (← q r"(s:A->bool) SUBSET u ==> u INTER s = s")],
        ALL_TAC] THEN
      EQ_TAC THENL
       [/- Forward: connected_component_of ==> membership + wellchaining -/
        DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(a:A) IN K /\ (b:A) IN K") STRIP_ASSUME_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENT_IN_TOPSPACE) THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
        EXPAND_TAC "top" THEN
        MATCH_MP_TAC CONNECTED_COMPONENT_OF_IMP_WELLCHAINED THEN
        ASM_REWRITE_TAC [],
        /- Backward: membership + wellchaining ==> connected_component_of -/
        STRIP_TAC THEN
        /- Use quasi = connected in compact Hausdorff -/
        SUBGOAL_THEN (← q r"compact_space (top:A topology)") ASSUME_TAC THENL
         [EXPAND_TAC "top" THEN
          MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        SUBGOAL_THEN (← q r"hausdorff_space (top:A topology)") ASSUME_TAC THENL
         [EXPAND_TAC "top" THEN
          MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
          REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY],
          ALL_TAC] THEN
        SUBGOAL_THEN
          (← q r"quasi_component_of top (a:A) = connected_component_of top a")
          (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THENL
         [MATCH_MP_TAC QUASI_EQ_CONNECTED_COMPONENT_OF THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        /- Now show quasi_component_of top a b -/
        REWRITE_TAC [quasi_component_of] THEN ASM_REWRITE_TAC [] THEN
        /- For every clopen t with a IN t, show b IN t -/
        X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(t:A->bool) SUBSET K") ASSUME_TAC THENL
         [ASM_MESON_TAC [CLOSED_IN_SUBSET], ALL_TAC] THEN
        /- t is compact via closed in compact subtopology -/
        SUBGOAL_THEN (← q r"compact_in (mtopology m) (t:A->bool)") ASSUME_TAC THENL
         [SUBGOAL_THEN (← q r"compact_in top (t:A->bool)") MP_TAC THENL
           [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [],
            EXPAND_TAC "top" THEN
            REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN MESON_TAC []],
          ALL_TAC] THEN
        /- K DIFF t is compact via open_in ==> complement closed ==> compact -/
        SUBGOAL_THEN
          (← q r"compact_in (mtopology m) (K DIFF t:A->bool)") ASSUME_TAC THENL
         [SUBGOAL_THEN (← q r"compact_in top (K DIFF t:A->bool)") MP_TAC THENL
           [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [] THEN
            SUBGOAL_THEN (← q r"K DIFF t = topspace top DIFF t:A->bool")
              SUBST1_TAC THENL
             [ASM_REWRITE_TAC [], ALL_TAC] THEN
            ASM_MESON_TAC [OPEN_IN_CLOSED_IN],
            EXPAND_TAC "top" THEN
            REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
            SIMP_TAC [] THEN SET_TAC []],
          ALL_TAC] THEN
        /- Get disjoint open sets separating t and K DIFF t -/
        MP_TAC (← ISPECL [← q r"mtopology (m:A metric)", ← q r"t:A->bool",
                          ← q r"K DIFF t:A->bool"]
          HAUSDORFF_SPACE_COMPACT_SEPARATION) THEN
        ASM_REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY] THEN
        ANTS_TAC THENL [SET_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool")
          (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC)) THEN
        /- Apply Lebesgue number to K with cover {u, v} -/
        MP_TAC (← ISPECL [← q r"m:A metric", ← q r"K:A->bool", ← q r"{u:A->bool, v}"]
          LEBESGUE_NUMBER) THEN
        ANTS_TAC THENL
         [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
           [REWRITE_TAC [IN_INSERT, NOT_IN_EMPTY] THEN ASM_MESON_TAC [],
            REWRITE_TAC [UNIONS_INSERT, UNIONS_0, UNION_EMPTY] THEN
            ASM SET_TAC []],
          ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"delta:real") STRIP_ASSUME_TAC) THEN
        POP_ASSUM (LABEL_TAC "lebesgue") THEN
        /- Use wellchaining for delta -/
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"delta:real")) THEN ASM_REWRITE_TAC [] THEN
        /- Convert chain via WELLCHAINED_ELEMENTS to closure form -/
        DISCH_THEN (MP_TAC o GEN_REWRITE_RULE id [WELLCHAINED_ELEMENTS]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
          (CONJUNCTS_THEN2 ASSUME_TAC (LABEL_TAC "chain_closure"))) THEN
        SUBGOAL_THEN
          (← q r"(!x y:A. x IN t /\ y IN K /\ mdist m (x,y) < delta ==> y IN t) /\
           (!x y:A. x IN K DIFF t /\ y IN K /\ mdist m (x,y) < delta
                    ==> y IN K DIFF t)")
          STRIP_ASSUME_TAC THENL
         [CONJ_TAC THENL [delta_absorbing_tac, delta_absorbing_tac],
          ALL_TAC] THEN
        /- Now prove the biconditional a IN t <=> b IN t -/
        EQ_TAC THENL
         [/- a IN t ==> b IN t: use chain closure with c = t -/
          DISCH_TAC THEN
          USE_THEN "chain_closure" (MP_TAC o SPEC (← q r"t:A->bool")) THEN
          ANTS_TAC THENL [ASM_REWRITE_TAC [], SIMP_TAC []],
          /- b IN t ==> a IN t: by contradiction, if ~(a IN t), K DIFF t
             is delta-closed and contains a, so b IN K DIFF t, contradiction -/
          DISCH_TAC THEN
          ASM_CASES_TAC (← q r"(a:A) IN t") THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
          USE_THEN "chain_closure" (MP_TAC o SPEC (← q r"K DIFF t:A->bool")) THEN
          ASM SET_TAC []]])

  return { CONNECTED_COMPONENT_OF_EQ_WELLCHAINED }

/- ------------------------------------------------------------------------- -/
/- Nested compact sets, strict triangle inequality.  (metric.ml 33898-34006) -/
/- ------------------------------------------------------------------------- -/

structure NCA where
  NESTED_COMPACT_APPROX : thm
  MDIST_TRIANGLE_LT : thm
  deriving Inhabited

@[nospecialize]
def setupNCA [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BCompact2 : Compact2) (BHausdorff1 : Hausdorff1)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetricHaus : MetricHaus) :
    ExceptT String IO NCA := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_GSPEC, .. } := D.core1
  let { INTERS_GSPEC, IN_ELIM_THM, IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_LET_TRANS, .. } := D.core3
  let { SUBSET, SUBSET_REFL, TRANSITIVE_STEPWISE_LE, UNIONS_GSPEC, .. } := D.core4
  let { CLOSED_IN_DIFF, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, .. } := BSubtopology
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { COMPACT_SPACE_IMP_NEST, .. } := BCompact2
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  -- @@SCOPE END

  -- Helper: for nested compact sets, every point of s(N) is close to k
  let NESTED_COMPACT_APPROX ← prove
   r"!m:A metric s.
     (!n. compact_in (mtopology m) (s n)) /\
     (!n. s(SUC n) SUBSET s n)
     ==> !e. &0 < e
             ==> ?N. !x. x IN s N
                      ==> ?y. y IN INTERS {s n | n IN (:num)} /\
                               mdist m (x,y) < e"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"k:A->bool = INTERS {s n | n IN (:num)}") THEN
    ABBREV_TAC
      (← q r"w:A->bool = UNIONS {mball m (y:A,e) | y IN k}") THEN
    SUBGOAL_THEN (← q r"open_in (mtopology m) (w:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "w" THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_GSPEC, OPEN_IN_MBALL],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (s:num->A->bool) n SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(k:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [EXPAND_TAC "k" THEN REWRITE_TAC [INTERS_GSPEC, SUBSET, IN_ELIM_THM] THEN
      ASM_MESON_TAC [IN_UNIV, SUBSET],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"d = \n:num. (s:num->A->bool) n DIFF (w:A->bool)") THEN
    SUBGOAL_THEN
      (← q r"!n. closed_in (subtopology (mtopology m) (s 0:A->bool)) ((d:num->A->bool) n)")
      ASSUME_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN EXPAND_TAC "d" THEN
      SUBGOAL_THEN (← q r"(s:num->A->bool) n DIFF w = s 0 INTER (s n DIFF w:A->bool)")
        SUBST1_TAC THENL
       [SUBGOAL_THEN (← q r"(s:num->A->bool) n SUBSET s 0") MP_TAC THENL
         [SPEC_TAC (← q r"n:num", ← q r"n:num") THEN INDUCT_TAC THEN
          ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM SET_TAC [],
          SET_TAC []],
        MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED THEN
        MATCH_MP_TAC CLOSED_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN
        ASM_REWRITE_TAC [HAUSDORFF_SPACE_MTOPOLOGY]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!n. (d:num->A->bool) (SUC n) SUBSET d n") ASSUME_TAC THENL
     [EXPAND_TAC "d" THEN ASM SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"?N. (d:num->A->bool) N = {}") THENL
     [FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"N:num")) THEN EXISTS_TAC (← q r"N:num") THEN
      /- First prove s(N) SUBSET w -/
      SUBGOAL_THEN (← q r"(s:num->A->bool) N SUBSET w") ASSUME_TAC THENL
       [MATCH_MP_TAC (← SET_RULE (← q r"(s:A->bool) DIFF t = {} ==> s SUBSET t")) THEN
        SUBGOAL_THEN (← q r"(d:num->A->bool) N = (s:num->A->bool) N DIFF w")
          (fun th => tactic_of do pure (ASM_REWRITE_TAC [← SYM th])) THEN
        EXPAND_TAC "d" THEN REWRITE_TAC [],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      /- x IN s N and s N SUBSET w, so x IN w -/
      SUBGOAL_THEN (← q r"(x:A) IN w") MP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      /- Unfold w to get y IN k with x IN mball(y,e) -/
      EXPAND_TAC "w" THEN REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_MBALL] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"y:A") THEN CONJ_TAC THENL
       [EXPAND_TAC "k" THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      ASM_MESON_TAC [MDIST_SYM],
      /- Second branch: all d(n) nonempty -> contradiction -/
      /- INTERS {d n} is nonempty by nested intersection -/
      SUBGOAL_THEN (← q r"!m' n. m' <= n ==> (d:num->A->bool) n SUBSET d m'")
        ASSUME_TAC THENL
       [MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
        ASM_REWRITE_TAC [SUBSET_REFL] THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"compact_space (subtopology (mtopology m) ((s:num->A->bool) 0))")
        ASSUME_TAC THENL
       [MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~(INTERS {(d:num->A->bool) n | n IN (:num)} = {})")
        MP_TAC THENL
       [MATCH_MP_TAC COMPACT_SPACE_IMP_NEST THEN
        ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") (LABEL_TAC "zd")) THEN
      /- z is in all d(n) = s(n) DIFF w, so z IN k and z NOT IN w -/
      SUBGOAL_THEN (← q r"(z:A) IN k") ASSUME_TAC THENL
       [EXPAND_TAC "k" THEN REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
        X_GEN_TAC (← q r"nn:num") THEN
        REMOVE_THEN "zd" (MP_TAC o SPEC (← q r"nn:num")) THEN
        EXPAND_TAC "d" THEN SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"~((z:A) IN w)") ASSUME_TAC THENL
       [REMOVE_THEN "zd" (MP_TAC o SPEC (← q r"0")) THEN EXPAND_TAC "d" THEN
        SET_TAC [],
        ALL_TAC] THEN
      /- But z IN k implies z IN w, contradicting ~(z IN w) -/
      SUBGOAL_THEN (← q r"(z:A) IN w") MP_TAC THENL
       [EXPAND_TAC "w" THEN REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"z:A") THEN CONJ_TAC THENL
         [ASM_REWRITE_TAC [],
          MATCH_MP_TAC CENTRE_IN_MBALL THEN ASM_MESON_TAC [SUBSET]],
        ASM_MESON_TAC []]])

  -- Triangle inequality with strict bounds on both legs
  let MDIST_TRIANGLE_LT ← prove
   r"!m x y z:A a b.
     x IN mspace m /\ y IN mspace m /\ z IN mspace m /\
     mdist m (x,y) < a /\ mdist m (y,z) < b
     ==> mdist m (x,z) < a + b"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"mdist (m:A metric) (x:A,y) + mdist m (y:A,z:A)") THEN
    ASM_SIMP_TAC [MDIST_TRIANGLE] THEN ASM_REAL_ARITH_TAC)

  return { NESTED_COMPACT_APPROX, MDIST_TRIANGLE_LT }

/- ------------------------------------------------------------------------- -/
/- Well-chained inters for nested compact sets.  (metric.ml 34008-34134)     -/
/- ------------------------------------------------------------------------- -/

structure WC4 where
  WELLCHAINED_INTERS : thm
  deriving Inhabited

@[nospecialize]
def setupWC4 [HolBase] (D : MetricDeps) (BCompact1 : Compact1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BNCA : NCA) : ExceptT String IO WC4 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        .. } := D
  let { EXTENSION, .. } := D.core1
  let { INTERS_GSPEC, IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, LT_IMP_LE, LT_REFL,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LTE_TRANS, REAL_LT_TRANS, .. } := D.core3
  let { REAL_SUB_LT, SKOLEM_THM, SUBSET, .. } := D.core4
  let { RIGHT_EXISTS_IMP_THM, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { MDIST_SYM, .. } := BMetricSpace
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MDIST_TRIANGLE_LT, NESTED_COMPACT_APPROX, .. } := BNCA
  -- @@SCOPE END

  let WELLCHAINED_INTERS ← prove
   r"!m:A metric (s:num->A->bool) d e.
      d < e /\
      (!n. compact_in (mtopology m) (s n)) /\
      (!n. s(SUC n) SUBSET s n) /\
      (!n a b.
           a IN s n /\ b IN s n
           ==> ?p k. p 0 = a /\ p k = b /\
                      (!i. i <= k ==> p i IN s n) /\
                      (!i. i < k ==> mdist m (p i,p (SUC i)) < d))
      ==> !a b. a IN INTERS {s n | n IN (:num)} /\
                b IN INTERS {s n | n IN (:num)}
                ==> ?p k. p 0 = a /\ p k = b /\
                          (!i. i <= k ==> p i IN INTERS {s n | n IN (:num)}) /\
                          (!i. i < k ==> mdist m (p i,p (SUC i)) < e)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"t:A->bool = INTERS {s n | n IN (:num)}") THEN
    /- Handle empty intersection -/
    ASM_CASES_TAC (← q r"t:A->bool = {}") THENL
     [UNDISCH_TAC (← q r"t:A->bool = {}") THEN EXPAND_TAC "t" THEN
      REWRITE_TAC [INTERS_GSPEC, EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY, IN_UNIV] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
    /- Get N from NESTED_COMPACT_APPROX -/
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:num->A->bool"] NESTED_COMPACT_APPROX) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(e - d) / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N:num")) THEN
    /- a and b are in s N -/
    SUBGOAL_THEN (← q r"(a:A) IN (s:num->A->bool) N /\ b IN s N") STRIP_ASSUME_TAC THENL
     [UNDISCH_TAC (← q r"(a:A) IN t") THEN UNDISCH_TAC (← q r"(b:A) IN t") THEN
      EXPAND_TAC "t" THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN MESON_TAC [],
      ALL_TAC] THEN
    /- Get d-chain from a to b in s(N) -/
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"N:num", ← q r"a:A", ← q r"b:A"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"p:num->A")
      (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC)) THEN
    /- For each chain point, find a nearby point in t -/
    SUBGOAL_THEN
      (← q r"!i. ?y. i <= n
               ==> y IN t /\ mdist m ((p:num->A) i,y:A) < (e - d) / &2")
      MP_TAC THENL
     [X_GEN_TAC (← q r"j:num") THEN REWRITE_TAC [RIGHT_EXISTS_IMP_THM] THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(p:num->A) j")) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:A") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"q:num->A") THEN DISCH_TAC THEN
    /- Chain points and nearby points are in mspace -/
    SUBGOAL_THEN (← q r"(t:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [EXPAND_TAC "t" THEN REWRITE_TAC [INTERS_GSPEC, SUBSET, IN_ELIM_THM, IN_UNIV] THEN
      ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY, SUBSET],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"!i:num. i <= n ==> (p:num->A) i IN mspace m /\ (q:num->A) i IN mspace m")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY, SUBSET],
      ALL_TAC] THEN
    /- Construct chain: keep endpoints (p), replace interior with nearby t-points (q) -/
    EXISTS_TAC (← q r"\i. if 0 < i /\ i < n then (q:num->A) i else p i") THEN
    EXISTS_TAC (← q r"n:num") THEN
    REWRITE_TAC [LT_REFL] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [/- All chain points in t -/
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"i = 0") THENL
       [ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(0 < 0)")], ALL_TAC] THEN
      ASM_CASES_TAC (← q r"i:num = n") THENL
       [ASM_REWRITE_TAC [LT_REFL], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"0 < i /\ i < n") (fun th => REWRITE_TAC [th]) THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      ASM_MESON_TAC [],
      /- Pre-establish symmetric distance bound q->p -/
      SUBGOAL_THEN
        (← q r"!j:num. j <= n
                 ==> mdist m ((q:num->A) j,(p:num->A) j) < (e - d) / &2")
        ASSUME_TAC THENL
       [ASM_MESON_TAC [MDIST_SYM], ALL_TAC] THEN
      /- Distance bounds for consecutive chain elements -/
      X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"0 < SUC i") (fun th => REWRITE_TAC [th]) THENL
       [ARITH_TAC, ALL_TAC] THEN
      ASM_CASES_TAC (← q r"i = 0") THENL
       [ASM_REWRITE_TAC [← ARITH_RULE (← q r"~(0 < 0)")] THEN COND_CASES_TAC THENL
         [/- SUC 0 < n: p 0 -> q(SUC 0), use MDIST_TRIANGLE_LT -/
          MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"d + (e - d) / &2") THEN
          CONJ_TAC THENL
           [MATCH_MP_TAC (← ISPEC (← q r"m:A metric") MDIST_TRIANGLE_LT) THEN
            EXISTS_TAC (← q r"(p:num->A)(SUC 0)") THEN
            ASM_MESON_TAC [LE_0, ← ARITH_RULE (← q r"SUC 0 < n ==> SUC 0 <= n")],
            ASM_REAL_ARITH_TAC],
          /- ~(SUC 0 < n): mdist(p 0, p(SUC 0)) < d < e -/
          ASM_MESON_TAC [REAL_LT_TRANS]],
        ALL_TAC] THEN
      /- 0 < i: first point is q i -/
      SUBGOAL_THEN (← q r"0 < i /\ i < n") (fun th => REWRITE_TAC [th]) THENL
       [ASM_ARITH_TAC, ALL_TAC] THEN
      COND_CASES_TAC THENL
       [/- SUC i < n: q i -> q(SUC i), use two MDIST_TRIANGLE_LT steps -/
        MATCH_MP_TAC REAL_LTE_TRANS THEN
        EXISTS_TAC (← q r"(e - d) / &2 + (d + (e - d) / &2)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← ISPEC (← q r"m:A metric") MDIST_TRIANGLE_LT) THEN
          EXISTS_TAC (← q r"(p:num->A) i") THEN REPEAT CONJ_TAC THENL
           [ASM_MESON_TAC [LT_IMP_LE],
            ASM_MESON_TAC [LT_IMP_LE],
            ASM_MESON_TAC [LT_IMP_LE, ← ARITH_RULE (← q r"SUC i < n ==> SUC i <= n")],
            ASM_MESON_TAC [LT_IMP_LE],
            MATCH_MP_TAC (← ISPEC (← q r"m:A metric") MDIST_TRIANGLE_LT) THEN
            EXISTS_TAC (← q r"(p:num->A)(SUC i)") THEN
            ASM_MESON_TAC [LT_IMP_LE,
                           ← ARITH_RULE (← q r"SUC i < n ==> SUC i <= n")]],
          ASM_REAL_ARITH_TAC],
        /- ~(SUC i < n): q i -> p(SUC i), use MDIST_TRIANGLE_LT -/
        MATCH_MP_TAC REAL_LT_TRANS THEN EXISTS_TAC (← q r"(e - d) / &2 + d") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC (← ISPEC (← q r"m:A metric") MDIST_TRIANGLE_LT) THEN
          EXISTS_TAC (← q r"(p:num->A) i") THEN
          ASM_MESON_TAC [LT_IMP_LE, ← ARITH_RULE (← q r"i < n ==> SUC i <= n")],
          ASM_REAL_ARITH_TAC]]])

  return { WELLCHAINED_INTERS }

/- ------------------------------------------------------------------------- -/
/- Uniformly locally connected and Property S for metric spaces              -/
/- (metric.ml 34137-34211)                                                    -/
/- ------------------------------------------------------------------------- -/

structure ULC1 where
  fccoverable_space : thm
  ulc_space : thm
  fccoverable_in : thm
  IN_CLOSURE_OF_IMP_SUBSET_MCBALL : thm
  deriving Inhabited

@[nospecialize]
def setupULC1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BDIAM1 : DIAM1) : ExceptT String IO ULC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D
  let { IN_ELIM_THM, .. } := D.core2
  let { REAL_NOT_LT, .. } := D.core3
  let { SUBSET, .. } := D.core4
  let { IN_MBALL, MDIST_TRIANGLE, .. } := BMetricSpace
  let { IN_MCBALL, METRIC_CLOSURE_OF, .. } := BMTopology
  let { MBOUNDED_IMP_IN_MSPACE, MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  -- @@SCOPE END

  -- Property S (Fine Connected Coverable): For every e > 0, there exists
  -- a finite cover of the space by connected sets of diameter <= e
  let fccoverable_space ← new_definition
   r"fccoverable_space (m:A metric) <=>
   !e. &0 < e
       ==> ?c. FINITE c /\
               UNIONS c = mspace m /\
               (!t. t IN c
                    ==> connected_in (mtopology m) t /\
                        mbounded m t /\
                        mdiameter m t <= e)"

  -- Uniformly Locally Connected: For every e > 0, there exists d > 0 such that
  -- any two points at distance < d can be connected within the space by a
  -- connected set of diameter <= e
  let ulc_space ← new_definition
   r"ulc_space (m:A metric) <=>
   !e. &0 < e
       ==> ?d. &0 < d /\
               !x y. x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < d
                     ==> ?c. x IN c /\ y IN c /\
                             c SUBSET mspace m /\
                             connected_in (mtopology m) c /\
                             mbounded m c /\
                             mdiameter m c <= e"

  -- Property S for a subset s of the metric space
  let fccoverable_in ← new_definition
   r"fccoverable_in (m:A metric) s <=>
   s SUBSET mspace m /\
   !e. &0 < e
       ==> ?c. FINITE c /\
               UNIONS c = s /\
               (!t. t IN c
                    ==> connected_in (mtopology m) t /\
                        mbounded m t /\
                        mdiameter m t <= e)"

  -- Main theorems

  -- Helper: if x is in closure of t, then t is contained in a ball around x
  let IN_CLOSURE_OF_IMP_SUBSET_MCBALL ← prove
   r"!m:A metric x t.
     x IN mspace m /\ mbounded m t /\ x IN mtopology m closure_of t
     ==> t SUBSET mcball m (x, mdiameter m t)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [SUBSET, IN_MCBALL] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(y:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"t:A->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    /- Proof by contradiction: if d(x,y) > diameter(t), derive contradiction -/
    REWRITE_TAC [← GSYM REAL_NOT_LT] THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"eps = (mdist m (x:A,y) - mdiameter m t) / &2") THEN
    SUBGOAL_THEN (← q r"&0 < eps") ASSUME_TAC THENL
     [EXPAND_TAC "eps" THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    UNDISCH_TAC (← q r"x IN mtopology m closure_of (t:A->bool)") THEN
    REWRITE_TAC [METRIC_CLOSURE_OF, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"eps:real"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"z:A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(z:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE], ALL_TAC] THEN
    /- d(x,y) <= d(x,z) + d(z,y) < eps + diameter(t) -/
    SUBGOAL_THEN (← q r"mdist m (x:A,y) <= mdist m (x,z) + mdist m (z,y) /\
                  mdist m (z:A,y) <= mdiameter m t") MP_TAC THENL
     [ASM_MESON_TAC [MDIST_TRIANGLE, MDIAMETER_BOUNDED_BOUND], ALL_TAC] THEN
    UNDISCH_TAC (← q r"z IN mball m (x:A,eps)") THEN REWRITE_TAC [IN_MBALL] THEN
    UNDISCH_TAC (← q r"mdiameter m (t:A->bool) < mdist m (x,y)") THEN
    EXPAND_TAC "eps" THEN REAL_ARITH_TAC)

  return { fccoverable_space, ulc_space, fccoverable_in, IN_CLOSURE_OF_IMP_SUBSET_MCBALL }

/- ------------------------------------------------------------------------- -/
/- Property S and ULC imply local connectedness.  (metric.ml 34213-34348)   -/
/- ------------------------------------------------------------------------- -/

structure ULC2 where
  FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE : thm
  ULC_SPACE_IMP_LOCALLY_CONNECTED_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupULC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BConnected1 : Connected1)
    (BConnected2 : Connected2) (BLC1 : LC1) (BDIAM1 : DIAM1) (BULC1 : ULC1) :
    ExceptT String IO ULC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_TAC, .. } := D
  let { ARITH, FINITE_IMAGE, FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNIONS, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { REAL_LT_DIV, REAL_LT_MIN, REAL_OF_NUM_LT, .. } := D.core3
  let { SUBSET, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { CLOSED_IN_UNIONS, OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_CONCENTRIC, .. } := BMetricSpace
  let { MCBALL_SUBSET_MBALL_CONCENTRIC, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY,
        .. } := BMTopology
  let { CONNECTED_IN_SUBSET_TOPSPACE, .. } := BConnected1
  let { CONNECTED_IN_UNIONS_STRONG, .. } := BConnected2
  let { LOCALLY_CONNECTED_SPACE_IM_KLEINEN, .. } := BLC1
  let { MBOUNDED_IMP_IN_MSPACE, MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  let { IN_CLOSURE_OF_IMP_SUBSET_MCBALL, fccoverable_space, ulc_space, .. } := BULC1
  -- @@SCOPE END

  let FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE ← prove
   r"!m:A metric.
     fccoverable_space m ==> locally_connected_space (mtopology m)"
   (GEN_TAC THEN REWRITE_TAC [fccoverable_space, LOCALLY_CONNECTED_SPACE_IM_KLEINEN] THEN
    DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN mspace m /\ ?e. &0 < e /\ mball m (x:A,e) SUBSET v")
      STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_MTOPOLOGY, SUBSET], ALL_TAC] THEN
    /- Cover mspace with connected bounded sets of diameter <= e/3 -/
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    /- K = union of pieces whose closure contains x (Whyburn's construction) -/
    ABBREV_TAC
      (← q r"K = UNIONS {t:A->bool | t IN c /\ x IN mtopology m closure_of t}") THEN
    /- x IN K -/
    SUBGOAL_THEN (← q r"(x:A) IN K") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      SUBGOAL_THEN (← q r"?t0:A->bool. t0 IN c /\ x IN t0") MP_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ASM_MESON_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY, SUBSET,
                     CONNECTED_IN_SUBSET_TOPSPACE],
      ALL_TAC] THEN
    /- K is connected via CONNECTED_IN_UNIONS_STRONG -/
    SUBGOAL_THEN (← q r"connected_in (mtopology m) (K:A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN MATCH_MP_TAC CONNECTED_IN_UNIONS_STRONG THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS,
                     INTERS_GSPEC, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"x:A") THEN CONJ_TAC THENL
         [UNDISCH_TAC (← q r"(x:A) IN K") THEN EXPAND_TAC "K" THEN
          REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN MESON_TAC [],
          X_GEN_TAC (← q r"y:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC []]],
      ALL_TAC] THEN
    /- K SUBSET v via mcball chain -/
    SUBGOAL_THEN (← q r"(K:A->bool) SUBSET v") ASSUME_TAC THENL
     [EXPAND_TAC "K" THEN REWRITE_TAC [UNIONS_SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mdiameter m (t:A->bool) <= e / &3") ASSUME_TAC THENL
       [ASM_MESON_TAC [], ALL_TAC] THEN
      TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A, e)") THEN ASM_REWRITE_TAC [] THEN
      TRANS_TAC SUBSET_TRANS (← q r"mcball m (x:A, mdiameter m t)") THEN CONJ_TAC THENL
       [MATCH_MP_TAC IN_CLOSURE_OF_IMP_SUBSET_MCBALL THEN ASM_MESON_TAC [],
        MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN ASM_REAL_ARITH_TAC],
      ALL_TAC] THEN
    /- x is in the interior of K: the "bad" closures form a closed set missing x -/
    ABBREV_TAC
      (← q r"F' = UNIONS {(mtopology m:(A)topology) closure_of t | t |
                    t IN c /\ ~(x IN mtopology m closure_of t)}") THEN
    SUBGOAL_THEN (← q r"closed_in (mtopology m) (F':A->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "F'" THEN MATCH_MP_TAC CLOSED_IN_UNIONS THEN CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"IMAGE (\t. (mtopology m:(A)topology) closure_of t) c") THEN
        ASM_SIMP_TAC [FINITE_IMAGE] THEN SET_TAC [],
        REWRITE_TAC [FORALL_IN_GSPEC, CLOSED_IN_CLOSURE_OF]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((x:A) IN F')") ASSUME_TAC THENL
     [EXPAND_TAC "F'" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    /- Get ball around x in complement of F' -/
    SUBGOAL_THEN
      (← q r"?d. &0 < d /\ mball m (x:A, d) SUBSET mspace m DIFF F'")
      STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"open_in (mtopology m) (mspace m DIFF F':A->bool)") MP_TAC THENL
       [REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE],
        ASM_MESON_TAC [OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, IN_DIFF]],
      ALL_TAC] THEN
    /- Witness: u = mball(x, min(d, e/3)), connecting set = K for all y -/
    EXISTS_TAC (← q r"mball m (x:A, min d (e / &3))") THEN
    ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL, REAL_LT_MIN,
                  REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A, e)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"K:A->bool") THEN ASM_REWRITE_TAC [] THEN
    /- y IN K: y is in some t IN c; t is not bad since y is close to x -/
    EXPAND_TAC "K" THEN REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
    SUBGOAL_THEN (← q r"(y:A) IN mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_MBALL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"?ty:A->bool. ty IN c /\ y IN ty") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    EXISTS_TAC (← q r"ty:A->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"x IN mtopology m closure_of (ty:A->bool)") THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(ty:A->bool) SUBSET F'") MP_TAC THENL
     [EXPAND_TAC "F'" THEN
      MP_TAC (← ISPECL [← q r"mtopology m:(A)topology", ← q r"ty:A->bool"]
                     CLOSURE_OF_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN ASM SET_TAC [],
      SUBGOAL_THEN (← q r"mball m (x:A, min d (e / &3)) SUBSET mball m (x, d)")
        MP_TAC THENL
       [MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN REAL_ARITH_TAC,
        ASM SET_TAC []]])

  let ULC_SPACE_IMP_LOCALLY_CONNECTED_SPACE ← prove
   r"!m:A metric.
     ulc_space m ==> locally_connected_space (mtopology m)"
   (GEN_TAC THEN REWRITE_TAC [ulc_space] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_IM_KLEINEN] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"x:A"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [OPEN_IN_MTOPOLOGY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_SIMP_TAC [REAL_LT_DIV, REAL_OF_NUM_LT, ARITH] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"mball m (x:A, min d e)") THEN
    SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL, REAL_LT_MIN] THEN CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A, e)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN_MBALL] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A, e)") THEN
    ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [MBOUNDED_IMP_IN_MSPACE],
      SUBGOAL_THEN (← q r"mdist m (x:A, z) <= mdiameter m c") MP_TAC THENL
       [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN ASM_REWRITE_TAC [],
        ASM_REAL_ARITH_TAC]])

  return { FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE,
           ULC_SPACE_IMP_LOCALLY_CONNECTED_SPACE }

/- ------------------------------------------------------------------------- -/
/- Property S for intermediate sets between s and closure s                  -/
/- (metric.ml 34350-34447)                                                    -/
/- ------------------------------------------------------------------------- -/

structure ULC3 where
  FCCOVERABLE_SPACE_EQ_FCCOVERABLE_IN_MSPACE : thm
  FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE : thm
  FCCOVERABLE_IN_IMP_FCCOVERABLE_SPACE_SUBMETRIC : thm
  FCCOVERABLE_IN_IMP_LOCALLY_CONNECTED_SPACE : thm
  MDIAMETER_SUBSET_MBALL : thm
  deriving Inhabited

@[nospecialize]
def setupULC3 [HolBase] (D : MetricDeps) (BClosure : Closure) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BConnected1 : Connected1)
    (BConnected2 : Connected2) (BDIAM1 : DIAM1) (BDIAM2 : DIAM2) (BDIAM3 : DIAM3)
    (BULC1 : ULC1) (BULC2 : ULC2) : ExceptT String IO ULC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { FINITE_IMAGE, FORALL_IN_IMAGE, .. } := D.core1
  let { INTER_SUBSET, IN_ELIM_THM, .. } := D.core2
  let { REAL_LE_TRANS, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS,
        UNIONS_IMAGE, .. } := D.core4
  let { CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_UNIONS, .. } := BClosure
  let { IN_MBALL, MBALL_SUBSET_MSPACE, MDIST_SYM, MDIST_TRIANGLE, SUBMETRIC, .. } :=
    BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_CLOSURE_OF, MBOUNDED_SUBMETRIC, MBOUNDED_SUBSET, .. } := BBounded
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_INTERMEDIATE_CLOSURE_OF, .. } := BConnected2
  let { MDIAMETER_LE, MDIAMETER_SUBSET, .. } := BDIAM1
  let { MDIAMETER_CLOSURE, .. } := BDIAM2
  let { MDIAMETER_SUBMETRIC, .. } := BDIAM3
  let { fccoverable_in, fccoverable_space, .. } := BULC1
  let { FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE, .. } := BULC2
  -- @@SCOPE END

  let FCCOVERABLE_SPACE_EQ_FCCOVERABLE_IN_MSPACE ← prove
   r"!m:A metric. fccoverable_space m <=> fccoverable_in m (mspace m)"
   (REWRITE_TAC [fccoverable_space, fccoverable_in, SUBSET_REFL])

  let FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE ← prove
   r"!m:A metric s t.
     s SUBSET t /\ t SUBSET (mtopology m closure_of s) /\ fccoverable_in m s
     ==> fccoverable_in m t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [fccoverable_in] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_OF_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"{t INTER (mtopology m closure_of k):A->bool | k IN c}") THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, UNIONS_IMAGE, FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_IMAGE, SUBSET, IN_ELIM_THM] THEN SET_TAC [],
        SUBGOAL_THEN
          (← q r"mtopology m closure_of s:A->bool =
           UNIONS {mtopology m closure_of k | k IN c}")
          MP_TAC THENL
         [FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
          ASM_SIMP_TAC [CLOSURE_OF_UNIONS, SIMPLE_IMAGE],
          REWRITE_TAC [SIMPLE_IMAGE, UNIONS_IMAGE] THEN ASM SET_TAC []]],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(k:A->bool) SUBSET s /\ k SUBSET mspace m")
      STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_IN_INTERMEDIATE_CLOSURE_OF THEN
      EXISTS_TAC (← q r"k:A->bool") THEN ASM_REWRITE_TAC [INTER_SUBSET] THEN
      ASM_SIMP_TAC [SUBSET_INTER, CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY] THEN
      ASM SET_TAC [],
      ASM_MESON_TAC [MBOUNDED_SUBSET, INTER_SUBSET, MBOUNDED_CLOSURE_OF],
      TRANS_TAC REAL_LE_TRANS (← q r"mdiameter m (mtopology m closure_of k:A->bool)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MDIAMETER_SUBSET THEN
        ASM_SIMP_TAC [INTER_SUBSET, MBOUNDED_CLOSURE_OF],
        ASM_SIMP_TAC [MDIAMETER_CLOSURE]]])

  -- fccoverable_in is equivalent to fccoverable_space on the submetric.

  let FCCOVERABLE_IN_IMP_FCCOVERABLE_SPACE_SUBMETRIC ← prove
   r"!m:A metric s. fccoverable_in m s ==> fccoverable_space (submetric m s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [fccoverable_in, fccoverable_space] THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [SUBMETRIC,
      ← SET_RULE (← q r"(s:A->bool) SUBSET t ==> s INTER t = s")] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"c:(A->bool)->bool") THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(t:A->bool) SUBSET s") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [MTOPOLOGY_SUBMETRIC, CONNECTED_IN_SUBTOPOLOGY,
                     MBOUNDED_SUBMETRIC, MDIAMETER_SUBMETRIC] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"(t:A->bool) SUBSET s ==> s INTER t = t")])

  -- fccoverable_in implies locally_connected_space on subtopology

  let FCCOVERABLE_IN_IMP_LOCALLY_CONNECTED_SPACE ← prove
   r"!m:A metric (s:A->bool).
     fccoverable_in m s
     ==> locally_connected_space (subtopology (mtopology m) s)"
   (SIMP_TAC [FCCOVERABLE_IN_IMP_FCCOVERABLE_SPACE_SUBMETRIC, ← GSYM MTOPOLOGY_SUBMETRIC,
              FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE])

  let MDIAMETER_SUBSET_MBALL ← prove
   r"!m:A metric x r t.
     x IN mspace m /\ &0 < r /\ t SUBSET mball m (x,r)
     ==> mdiameter m t <= &2 * r"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC MDIAMETER_LE THEN REPEAT CONJ_TAC THENL
     [TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A, r)") THEN
      ASM_REWRITE_TAC [MBALL_SUBSET_MSPACE],
      DISJ2_TAC THEN ASM_REAL_ARITH_TAC,
      MAP_EVERY X_GEN_TAC [← q r"p:A", ← q r"q:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(p:A) IN mball m (x,r) /\ q IN mball m (x,r)") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [IN_MBALL]] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mdist m (p:A,q) <= mdist m (x,p) + mdist m (x,q)")
        MP_TAC THENL
       [ASM_MESON_TAC [MDIST_TRIANGLE, MDIST_SYM], ASM_REAL_ARITH_TAC]])

  return { FCCOVERABLE_SPACE_EQ_FCCOVERABLE_IN_MSPACE, FCCOVERABLE_SPACE_INTERMEDIATE_CLOSURE,
           FCCOVERABLE_IN_IMP_FCCOVERABLE_SPACE_SUBMETRIC,
           FCCOVERABLE_IN_IMP_LOCALLY_CONNECTED_SPACE, MDIAMETER_SUBSET_MBALL }

/- ------------------------------------------------------------------------- -/
/- Compact + locally connected implies ULC  (metric.ml 34449-34555)          -/
/- ------------------------------------------------------------------------- -/

structure ULC4 where
  COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE : thm
  COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupULC4 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BConnected1 : Connected1) (BMCompact1 : MCompact1) (BLC1 : LC1)
    (BDIAM1 : DIAM1) (BULC1 : ULC1) (BULC3 : ULC3) : ExceptT String IO ULC4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, .. } := D
  let { IN_ELIM_THM, IN_INTER, IN_UNIONS, .. } := D.core2
  let { REAL_LT_MIN, REAL_MIN_LT, .. } := D.core3
  let { SUBSET, .. } := D.core4
  let { REAL_HALF, .. } := D.misc
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_SYM, .. } := BMetricSpace
  let { OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_MBALL, MBOUNDED_SUBSET, .. } := BBounded
  let { CONNECTED_IN_SUBSET_TOPSPACE, .. } := BConnected1
  let { LEBESGUE_NUMBER, .. } := BMCompact1
  let { LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  let { ulc_space, .. } := BULC1
  let { MDIAMETER_SUBSET_MBALL, .. } := BULC3
  -- @@SCOPE END

  let COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE ← prove
   r"!m:A metric.
     compact_in (mtopology m) (mspace m) /\
     locally_connected_space (mtopology m)
     ==> ulc_space m"
   (GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [ulc_space] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    /- Build the open cover: for each x, use locally connected to get u(x) -/
    SUBGOAL_THEN
      (← q r"?U:(A->bool)->bool.
         (!u. u IN U ==> open_in (mtopology m) u) /\
         (!u. u IN U ==> connected_in (mtopology m) u) /\
         (!u. u IN U ==> mbounded m u /\ mdiameter m u <= e) /\
         mspace m SUBSET UNIONS U")
    (X_CHOOSE_THEN (← q r"U:(A->bool)->bool") STRIP_ASSUME_TAC) THENL
     [/- Witness: all connected open sets contained in some mball(x, e/2) -/
      EXISTS_TAC
        (← q r"{u:A->bool | open_in (mtopology m) u /\ connected_in (mtopology m) u /\
                      ?x. x IN mspace m /\ x IN u /\
                          u SUBSET mball m (x, e / &2)}") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
       [/- Each u is open - immediate from definition -/
        MESON_TAC [],
        /- Each u is connected - immediate from definition -/
        MESON_TAC [],
        /- Each u is bounded with diameter <= e -/
        X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN CONJ_TAC THENL
         [ASM_MESON_TAC [MBOUNDED_SUBSET, MBOUNDED_MBALL],
          MATCH_MP_TAC (← REAL_ARITH (← q r"x <= &2 * (e / &2) ==> x <= e")) THEN
          MATCH_MP_TAC MDIAMETER_SUBSET_MBALL THEN
          ASM_MESON_TAC [REAL_HALF]],
        /- mspace m covered by UNIONS U - use locally_connected_space -/
        REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LOCALLY_CONNECTED_SPACE]) THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"mball m (y:A, e / &2)", ← q r"y:A"]) THEN
        ANTS_TAC THENL
         [ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL, REAL_HALF], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
        EXISTS_TAC (← q r"y:A") THEN ASM_REWRITE_TAC [← GSYM SUBSET]],
      ALL_TAC] THEN
    /- Apply Lebesgue number lemma to get d > 0 -/
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"mspace m:A->bool", ← q r"U:(A->bool)->bool"]
                  LEBESGUE_NUMBER) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    /- x has an enclosing u IN U -/
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"v:A->bool") THEN
    SUBGOAL_THEN (← q r"(x:A) IN v /\ y IN v") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, CENTRE_IN_MBALL, IN_MBALL], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"(v:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [CONNECTED_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:A->bool")) THEN ASM_REWRITE_TAC [] THEN
      SIMP_TAC []])

  -- Alternative: connecting sets lie in balls around both endpoints
  let COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE_ALT ← prove
   r"!m:A metric.
     compact_in (mtopology m) (mspace m) /\
     locally_connected_space (mtopology m)
     ==> !e. &0 < e
             ==> ?d. &0 < d /\ d < e /\
                     !x y. x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < d
                           ==> ?c. connected_in (mtopology m) c /\
                                   x IN c /\ y IN c /\
                                   c SUBSET mspace m INTER mball m (x,e) INTER
                                           mball m (y,e)"
   (GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    /- Use COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE with e/2 -/
    MP_TAC (← ISPEC (← q r"m:A metric") COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [ulc_space] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_SIMP_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d':real") STRIP_ASSUME_TAC) THEN
    /- Take d = min(d', e/2) -/
    EXISTS_TAC (← q r"min d' (e / &2)") THEN
    ASM_REWRITE_TAC [REAL_LT_MIN, REAL_MIN_LT] THEN
    REPEAT (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [REAL_LT_MIN] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC [] THEN
    /- Show c SUBSET mspace m INTER mball m (x,e) INTER mball m (y,e) -/
    REWRITE_TAC [SUBSET, IN_INTER, IN_MBALL] THEN
    X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(z:A) IN mspace m /\
      mdist m (x:A,z) <= mdiameter m c /\ mdist m (y,z) <= mdiameter m c")
      STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [MDIAMETER_BOUNDED_BOUND, MDIST_SYM, SUBSET],
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC])

  return { COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE,
           COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE_ALT }

/- ------------------------------------------------------------------------- -/
/- Totally bounded + ULC implies Property S  (metric.ml 34557-34675)         -/
/- ------------------------------------------------------------------------- -/

-- Note: For general metric spaces, we need totally_bounded_in rather than
-- just mbounded, since bounded + discrete doesn't imply finite in general.

structure FCC1 where
  TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupFCC1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BConnected1 : Connected1) (BTotBdd1 : TotBdd1) (BDIAM1 : DIAM1)
    (BULC1 : ULC1) : ExceptT String IO FCC1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } :=
    D.core1
  let { INTERS_GSPEC, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNIONS, MEMBER_NOT_EMPTY,
        MONO_EXISTS, .. } := D.core2
  let { REAL_LE_TRANS, .. } := D.core3
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, UNIONS_SUBSET, .. } := D.core4
  let { REAL_HALF, .. } := D.misc
  let { IN_MBALL, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { IN_MCBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_EMPTY, MBOUNDED_INSERT, MBOUNDED_MCBALL, MBOUNDED_SUBSET, .. } := BBounded
  let { CONNECTED_IN_SING, CONNECTED_IN_UNIONS, .. } := BConnected1
  let { totally_bounded_in, .. } := BTotBdd1
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_LE, MDIAMETER_SING, .. } := BDIAM1
  let { fccoverable_space, ulc_space, .. } := BULC1
  -- @@SCOPE END

  let TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE ← prove
   r"!m:A metric.
     totally_bounded_in m (mspace m) /\ ulc_space m
     ==> fccoverable_space m"
   (GEN_TAC THEN
    REWRITE_TAC [ulc_space, fccoverable_space] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    /- Use ULC with e/2 to get d -/
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_SIMP_TAC [REAL_HALF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    /- Define M(p) = points reachable from p by connected sets of diam <= e/2 -/
    ABBREV_TAC
     (← q r"M = \p:A. {x | x IN mspace m /\
                     ?c. p IN c /\ x IN c /\ c SUBSET mspace m /\
                         connected_in (mtopology m) c /\ mbounded m c /\
                         mdiameter m c <= e / &2}") THEN
    /- Key subgoal 1: mball(p,d) INTER mspace m SUBSET M(p) -/
    SUBGOAL_THEN (← q r"!p:A. p IN mspace m ==> mball m (p,d) INTER mspace m SUBSET M p")
      ASSUME_TAC THENL
     [X_GEN_TAC (← q r"p:A") THEN DISCH_TAC THEN EXPAND_TAC "M" THEN
      REWRITE_TAC [SUBSET, IN_INTER, IN_MBALL, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"p:A", ← q r"x:A"]) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    /- Get finite k from totally_bounded_in with d-balls -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [totally_bounded_in]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
    /- Witness: IMAGE M k -/
    EXISTS_TAC (← q r"IMAGE (M:A->A->bool) k") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN
    CONJ_TAC THENL
     [/- UNIONS (IMAGE M k) = mspace m -/
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_IMAGE] THEN
        GEN_TAC THEN DISCH_TAC THEN
        EXPAND_TAC "M" THEN SIMP_TAC [SUBSET, IN_ELIM_THM],
        REWRITE_TAC [SUBSET, IN_UNIONS, EXISTS_IN_IMAGE] THEN
        X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o SPEC (← q r"y:A") o GEN_REWRITE_RULE id [SUBSET]) THEN
        ASM_REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A->bool")
          (CONJUNCTS_THEN2 (X_CHOOSE_THEN (← q r"p:A") STRIP_ASSUME_TAC)
            ASSUME_TAC)) THEN
        EXISTS_TAC (← q r"p:A") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"p:A")) THEN ASM SET_TAC []],
      ALL_TAC] THEN
    /- Now prove each M(p) is connected, bounded, and has diameter <= e -/
    REWRITE_TAC [FORALL_IN_IMAGE] THEN X_GEN_TAC (← q r"p:A") THEN DISCH_TAC THEN
    /- First establish p IN mspace m from p IN k and k SUBSET mspace m -/
    SUBGOAL_THEN (← q r"(p:A) IN mspace m") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    /- M(p) SUBSET mspace m (easy from definition) -/
    SUBGOAL_THEN (← q r"(M:A->A->bool) p SUBSET mspace m") ASSUME_TAC THENL
     [EXPAND_TAC "M" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN SIMP_TAC [],
      ALL_TAC] THEN
    /- p IN M(p) using {p} as witness -/
    SUBGOAL_THEN (← q r"(p:A) IN M p") ASSUME_TAC THENL
     [EXPAND_TAC "M" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"{p:A}") THEN
      ASM_SIMP_TAC [IN_SING, SING_SUBSET, CONNECTED_IN_SING,
                    TOPSPACE_MTOPOLOGY, MBOUNDED_INSERT,
                    MBOUNDED_EMPTY, MDIAMETER_SING] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    /- Key: M(p) SUBSET mcball m (p, e/2) -/
    SUBGOAL_THEN (← q r"(M:A->A->bool) p SUBSET mcball m (p, e / &2)") ASSUME_TAC THENL
     [EXPAND_TAC "M" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_MCBALL] THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      /- Need: mdist m (p,x) <= e/2. Have: p IN c, x IN c, mbounded m c,
         mdiameter m c <= e/2 -/
      MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"mdiameter m (c:A->bool)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN ASM_REWRITE_TAC [],
        ASM_REWRITE_TAC []],
      ALL_TAC] THEN
    /- Now prove the three properties -/
    REPEAT CONJ_TAC THENL
     [/- M(p) is connected -/
      /- M(p) = UNIONS of connected sets containing p -/
      SUBGOAL_THEN
        (← q r"(M:A->A->bool) p =
         UNIONS {c | c SUBSET mspace m /\ connected_in (mtopology m) c /\
                     mbounded m c /\ mdiameter m c <= e / &2 /\ p IN c}")
        SUBST1_TAC THENL
       [EXPAND_TAC "M" THEN
        REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN
        MESON_TAC [SUBSET],
        ALL_TAC] THEN
      MATCH_MP_TAC CONNECTED_IN_UNIONS THEN CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN SIMP_TAC [],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"p:A") THEN X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
        ASM_REWRITE_TAC []],
      /- M(p) is bounded -/
      MATCH_MP_TAC MBOUNDED_SUBSET THEN
      EXISTS_TAC (← q r"mcball m (p:A, e / &2)") THEN
      ASM_REWRITE_TAC [MBOUNDED_MCBALL],
      /- mdiameter M(p) <= e -/
      /- For any x, y in M(p): d(p,x) <= e/2 and d(p,y) <= e/2, so d(x,y) <= e -/
      MATCH_MP_TAC MDIAMETER_LE THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [DISJ2_TAC THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"(x:A) IN mcball m (p,e / &2) /\ y IN mcball m (p,e / &2)") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [IN_MCBALL]] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mdist m (x:A,y) <= mdist m (p,x) + mdist m (p,y)") MP_TAC THENL
       [ASM_MESON_TAC [MDIST_TRIANGLE, MDIST_SYM], ASM_REAL_ARITH_TAC]])

  return { TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE }

/- ------------------------------------------------------------------------- -/
/- Compact locally connected spaces and Property S.  (metric.ml 34677-34737) -/
/- ------------------------------------------------------------------------- -/

-- Note: For general metric spaces, mbounded does NOT imply totally bounded.
-- The Euclidean version BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE relies on
-- DISCRETE_BOUNDED_IMP_FINITE which is specific to R^n.
-- The correct general statement is TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE above.

structure FCC2 where
  COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE : thm
  COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupFCC2 [HolBase] (D : MetricDeps) (BClosure : Closure) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BMTopology : MTopology) (BMetricHaus : MetricHaus)
    (BConnected2 : Connected2) (BMCompact2 : MCompact2) (BDIAM2 : DIAM2) (BULC1 : ULC1)
    (BULC2 : ULC2) (BULC4 : ULC4) (BFCC1 : FCC1) : ExceptT String IO FCC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, .. } := D
  let { FINITE_IMAGE, FORALL_IN_IMAGE, .. } := D.core1
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { REAL_LT_01, .. } := D.core3
  let { SIMPLE_IMAGE, .. } := D.core4
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ, CLOSURE_OF_UNIONS, .. } := BClosure
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_UNIONS, compact_space, .. } := BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { COMPACT_IN_IMP_MBOUNDED, HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { CONNECTED_IN_CLOSURE_OF, .. } := BConnected2
  let { COMPACT_IN_IMP_TOTALLY_BOUNDED_IN, .. } := BMCompact2
  let { MDIAMETER_CLOSURE, .. } := BDIAM2
  let { fccoverable_space, .. } := BULC1
  let { FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE, .. } := BULC2
  let { COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE, .. } := BULC4
  let { TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE, .. } := BFCC1
  -- @@SCOPE END

  let COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE ← prove
   r"!m:A metric.
     compact_in (mtopology m) (mspace m) /\
     locally_connected_space (mtopology m)
     ==> fccoverable_space m"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC TOTALLY_BOUNDED_ULC_SPACE_IMP_FCCOVERABLE_SPACE THEN CONJ_TAC THENL
     [MATCH_MP_TAC COMPACT_IN_IMP_TOTALLY_BOUNDED_IN THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE THEN ASM_REWRITE_TAC []])

  let COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE ← prove
   r"!m:A metric.
     compact_in (mtopology m) (mspace m) /\
     locally_connected_space (mtopology m) <=>
     (!e. &0 < e
          ==> ?c. FINITE c /\ UNIONS c = mspace m /\
                  !t. t IN c
                      ==> connected_in (mtopology m) t /\
                          compact_in (mtopology m) t /\
                          mdiameter m t <= e)"
   (GEN_TAC THEN EQ_TAC THENL
     [/- Forward: compact + locally connected => covering -/
      DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP
        COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE) THEN
      REWRITE_TAC [fccoverable_space] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:(A->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (\s. mtopology m closure_of s) (c:(A->bool)->bool)") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [← GSYM SIMPLE_IMAGE, ← GSYM CLOSURE_OF_UNIONS,
                      CLOSURE_OF_EQ, HAUSDORFF_SPACE_MTOPOLOGY,
                      COMPACT_IN_IMP_CLOSED_IN, TOPSPACE_MTOPOLOGY],
        X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN ASM_REWRITE_TAC [] THEN
        STRIP_TAC THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CONNECTED_IN_CLOSURE_OF THEN ASM_REWRITE_TAC [],
          MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
          ASM_REWRITE_TAC [compact_space, TOPSPACE_MTOPOLOGY,
                           CLOSED_IN_CLOSURE_OF],
          ASM_SIMP_TAC [MDIAMETER_CLOSURE]]],
      /- Backward: covering => compact + locally connected -/
      DISCH_TAC THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"&1")) THEN REWRITE_TAC [REAL_LT_01] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"c:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"mspace m:A->bool = UNIONS c") SUBST1_TAC THENL
         [ASM_REWRITE_TAC [],
          MATCH_MP_TAC COMPACT_IN_UNIONS THEN ASM_MESON_TAC []],
        MATCH_MP_TAC FCCOVERABLE_SPACE_IMP_LOCALLY_CONNECTED_SPACE THEN
        REWRITE_TAC [fccoverable_space] THEN X_GEN_TAC (← q r"e:real") THEN
        DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_MESON_TAC [COMPACT_IN_IMP_MBOUNDED]]])

  return { COMPACT_IN_LOCALLY_CONNECTED_IMP_FCCOVERABLE_SPACE,
           COMPACT_IN_LOCALLY_CONNECTED_EQ_FCCOVERABLE_SPACE }

/- ------------------------------------------------------------------------- -/
/- Localization of Property S (fccoverability).                              -/
/- Whyburn, Analytic Topology, Ch. I Sec. 15; H-Y exercises 3-6 to 3-9.    -/
/- (metric.ml 34739-35382)                                                    -/
/- ------------------------------------------------------------------------- -/

structure LFC1 where
  LOCALLY_FCCOVERABLE_SPACE_CHAIN : thm
  deriving Inhabited

@[nospecialize]
def setupLFC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BBounded : Bounded)
    (BConnected1 : Connected1) (BConnected2 : Connected2) (BComponents1 : Components1)
    (BComponents2 : Components2) (BNbhdBase : NbhdBase) (BLC1 : LC1) (BDIAM1 : DIAM1)
    (BDIAM3 : DIAM3) (BULC1 : ULC1) (BULC3 : ULC3) : ExceptT String IO LFC1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, ADD_CLAUSES, EMPTY_UNIONS, FINITE_IMAGE, FINITE_NUMSEG, FINITE_RESTRICT,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMAGE_CLAUSES, IMAGE_ID, .. } :=
    D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INTERS_GSPEC, INTER_COMM, INTER_IDEMPOT, INTER_UNIONS,
        IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_SING, IN_UNION, IN_UNIONS, IN_UNIV, LE, LE_0,
        LE_REFL, LE_TRANS, LT, LT_IMP_LE, LT_SUC_LE, LT_TRANS, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IMP, NUMSEG_CLAUSES, NUMSEG_EMPTY, NUMSEG_LREC, NUMSEG_SING, .. } := D.core2
  let { REAL_ARCH_POW_INV, REAL_DIV_1, REAL_INV_POW, REAL_LET_TRANS, REAL_LE_INV_EQ,
        REAL_LE_RMUL, REAL_LTE_TRANS, REAL_LT_ADD2, REAL_LT_DIV, REAL_LT_IMP_LE, REAL_LT_INV2,
        REAL_LT_LMUL_EQ, REAL_LT_POW2, REAL_LT_RDIV_EQ, REAL_LT_TRANS, REAL_MUL_LID,
        REAL_MUL_SYM, REAL_POS, REAL_POW_EQ_0, REAL_POW_LE, REAL_POW_MONO_LT, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER,
        SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIV, TRANSITIVE_STEPWISE_LE, UNIONS_0, UNIONS_1,
        UNIONS_IMAGE, UNIONS_INSERT, UNIONS_MONO_IMAGE, UNIONS_SUBSET, UNION_SUBSET,
        num_INDUCTION, real_div, real_pow, .. } := D.core4
  let { FORALL_UNWIND_THM2, .. } := D.core5
  let { OPEN_IN_SUBOPEN, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, .. } := BSubtopology
  let { IN_MBALL, MDIST_REFL, MDIST_TRIANGLE, .. } := BMetricSpace
  let { MBALL_SUBSET_MCBALL, OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_EMPTY, MBOUNDED_INSERT, MBOUNDED_MBALL, MBOUNDED_SUBSET, MBOUNDED_UNIONS, .. } :=
    BBounded
  let { CONNECTED_IN_EMPTY, CONNECTED_IN_SING, CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_UNIONS,
        .. } := BConnected1
  let { CONNECTED_IN_UNION, .. } := BConnected2
  let { CONNECTED_COMPONENT_OF_MONO, CONNECTED_COMPONENT_OF_SYM, CONNECTED_COMPONENT_OF_TRANS,
        connected_component_of, .. } := BComponents1
  let { CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF, .. } := BComponents2
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { LOCALLY_CONNECTED_SPACE_ALT, .. } := BLC1
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_LE, MDIAMETER_POS_LE, MDIAMETER_SING, .. } := BDIAM1
  let { MDIAMETER_UNION_LE, .. } := BDIAM3
  let { fccoverable_in, .. } := BULC1
  let { MDIAMETER_SUBSET_MBALL, .. } := BULC3
  -- @@SCOPE END

  -- Common chain construction for LOCALLY_FCCOVERABLE_SPACE
  let LOCALLY_FCCOVERABLE_SPACE_CHAIN ← do
    let CHAIN_DISTANCE_BOUND ← prove
     r"!m:A metric s (a:A) r. a IN mspace m /\ s SUBSET mspace m /\ &0 < r
         ==> !k x (f:num->A->bool). x IN mspace m /\
               (!i. i <= k ==>
                    connected_in (mtopology m) (f i) /\
                    f i SUBSET s /\
                    mbounded m (f i) /\
                    mdiameter m (f i) < r / &2 pow i) /\
               a IN f 0 /\ x IN f k /\
               (!i. i < k ==> ~(f i INTER f(SUC i) = {}))
               ==> mdist m (a,x) < (&2 - inv(&2 pow k)) * r"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN INDUCT_TAC THENL
       [REWRITE_TAC [LE, LT, FORALL_UNWIND_THM2] THEN
        REPEAT STRIP_TAC THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [REAL_MUL_LID] THEN
        TRANS_TAC REAL_LET_TRANS
          (← q r"mdiameter m ((f:num->A->bool) 0)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN
          ASM_REWRITE_TAC [],
          UNDISCH_TAC
           (← q r"mdiameter m ((f:num->A->bool) 0) < r / &2 pow 0") THEN
          REWRITE_TAC [real_pow, REAL_DIV_1]],
        X_GEN_TAC (← q r"c:A") THEN X_GEN_TAC (← q r"g:num->A->bool") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
         (CONJUNCTS_THEN2 (LABEL_TAC "gchain")
          (CONJUNCTS_THEN2 ASSUME_TAC
           (CONJUNCTS_THEN2 ASSUME_TAC
            (LABEL_TAC "goverlap"))))) THEN
        SUBGOAL_THEN
          (← q r"~((g:num->A->bool) k INTER g(SUC k) = {})") MP_TAC THENL
         [USE_THEN "goverlap" (MP_TAC o SPEC (← q r"k:num")) THEN
          ANTS_TAC THENL [ARITH_TAC, SIMP_TAC []],
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN (← q r"(b:A) IN mspace m") ASSUME_TAC THENL
         [USE_THEN "gchain" (MP_TAC o SPEC (← q r"k:num")) THEN
          REWRITE_TAC [← ARITH_RULE (← q r"k <= SUC k")] THEN
          ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
        SUBGOAL_THEN
          (← q r"mdist m (a:A,b) < (&2 - inv (&2 pow k)) * r")
          ASSUME_TAC THENL
         [FIRST_X_ASSUM
           (MP_TAC o SPECL [← q r"b:A", ← q r"g:num->A->bool"]) THEN
          ANTS_TAC THENL
           [ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
             [X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
              USE_THEN "gchain" (MP_TAC o SPEC (← q r"j:num")) THEN
              ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []],
              X_GEN_TAC (← q r"j:num") THEN DISCH_TAC THEN
              USE_THEN "goverlap" (MP_TAC o SPEC (← q r"j:num")) THEN
              ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]],
            SIMP_TAC []], ALL_TAC] THEN
        SUBGOAL_THEN
          (← q r"mdist m (b:A,c) < r / &2 pow (SUC k)") ASSUME_TAC THENL
         [TRANS_TAC REAL_LET_TRANS
            (← q r"mdiameter m ((g:num->A->bool) (SUC k))") THEN
          USE_THEN "gchain" (MP_TAC o SPEC (← q r"SUC k")) THEN
          REWRITE_TAC [LE_REFL] THEN STRIP_TAC THEN CONJ_TAC THENL
           [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN
            ASM_REWRITE_TAC [],
            ASM_REWRITE_TAC []], ALL_TAC] THEN
        TRANS_TAC REAL_LET_TRANS
          (← q r"mdist m (a:A,b) + mdist m (b,c)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC MDIST_TRIANGLE THEN ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        TRANS_TAC REAL_LTE_TRANS
          (← q r"(&2 - inv(&2 pow k)) * r + r / &2 pow (SUC k)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC REAL_LT_ADD2 THEN ASM_REWRITE_TAC [],
          REWRITE_TAC [real_pow] THEN
          MP_TAC (← SPEC (← q r"k:num") REAL_LT_POW2) THEN
          CONV_TAC (fun t => REAL_FIELD t)]])
    let REAL_LT_DIV_POW2 ← prove
     r"!r a b. &0 < r /\ b < a
               ==> r / &2 pow a < r / &2 pow b"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [real_div] THEN
      ASM_SIMP_TAC [REAL_LT_LMUL_EQ] THEN
      MATCH_MP_TAC REAL_LT_INV2 THEN
      REWRITE_TAC [REAL_LT_POW2] THEN
      MATCH_MP_TAC REAL_POW_MONO_LT THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_ARITH_TAC)
    let REAL_DOUBLE_DIV_POW2 ← prove
     r"!r k. r / &2 pow (k + 3) + r / &2 pow (k + 3) =
             r / &2 pow (k + 2)"
     (REPEAT GEN_TAC THEN
      REWRITE_TAC [← ARITH_RULE (← q r"k + 3 = SUC(k + 2)"), real_pow] THEN
      MATCH_MP_TAC (← REAL_FIELD (← q
        r"~(y = &0)
         ==> x / (&2 * y) + x / (&2 * y) = x / y")) THEN
      MP_TAC (← SPEC (← q r"k + 2") REAL_LT_POW2) THEN REAL_ARITH_TAC)
    prove
     r"!m:A metric s u a r.
     s SUBSET mspace m /\ a IN s /\ a IN mspace m /\ &0 < r /\
     s INTER mcball m (a, &2 * r) SUBSET u /\
     locally_connected_space (subtopology (mtopology m) s) /\
     (!e. &0 < e ==> ?c. FINITE c /\
                  (!w. w IN c ==> w SUBSET s /\
                           connected_in (mtopology m) w /\
                           mbounded m w /\ mdiameter m w <= e) /\
                  (!x. x IN s /\ x IN mball m (a, &2 * r)
                       ==> ?w. w IN c /\ x IN w))
     ==> ?v. open_in (subtopology (mtopology m) s) v /\
             connected_in (subtopology (mtopology m) s) v /\
             a IN v /\ v SUBSET u /\ fccoverable_in m v"
     (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
      DISCH_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
      DISCH_TAC THEN DISCH_TAC THEN DISCH_TAC THEN
      DISCH_THEN (LABEL_TAC "cover") THEN /- Define chain-reachable sets t(k) -/
      ABBREV_TAC (← q r"t = \k. {x:A | x IN mspace m /\
         (?f. (!i. i <= k ==> connected_in (mtopology m) (f i) /\ (f i) SUBSET s /\
                      mbounded m (f i) /\ mdiameter m (f i) < r / &2 pow i) /\
              a IN f 0 /\ x IN f k /\
              (!i. i < k ==> ~(f i INTER f(SUC i) = {})))}") THEN
      EXISTS_TAC (← q r"UNIONS {(t:num->A->bool) k | k IN (:num)}") THEN
      /- Key property: a IN t(k) for all k -/
      SUBGOAL_THEN (← q r"!k. (a:A) IN (t:num->A->bool) k") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN EXPAND_TAC "t" THEN
         ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        EXISTS_TAC (← q r"\i:num. {a:A}") THEN
        ASM_REWRITE_TAC [IN_SING, CONNECTED_IN_SING, TOPSPACE_MTOPOLOGY] THEN
        CONJ_TAC THENL
         [X_GEN_TAC (← q r"i:num") THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
          REPEAT CONJ_TAC THENL [UNDISCH_TAC (← q r"(a:A) IN s") THEN SET_TAC [],
            ASM_REWRITE_TAC [MBOUNDED_INSERT, MBOUNDED_EMPTY],
            ASM_SIMP_TAC [MDIAMETER_SING, REAL_LT_DIV, REAL_LT_POW2]],
          REWRITE_TAC [INTER_IDEMPOT] THEN GEN_TAC THEN DISCH_TAC THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"a:A") THEN
          REWRITE_TAC [IN_SING]], ALL_TAC] THEN /- Key property: t(k) SUBSET s -/
      SUBGOAL_THEN (← q r"!k. (t:num->A->bool) k SUBSET s") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k:num") THEN EXPAND_TAC "t" THEN
        REWRITE_TAC [IN_ELIM_THM, SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"f:num->A->bool")
          (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"k:num")) STRIP_ASSUME_TAC)) THEN
        REWRITE_TAC [LE_REFL] THEN
        UNDISCH_TAC (← q r"(x:A) IN (f:num->A->bool) k") THEN SET_TAC [], ALL_TAC] THEN
      /- Key property: t(k) SUBSET mball(a, 2r) -/
      SUBGOAL_THEN (← q r"!k. (t:num->A->bool) k SUBSET mball m (a:A, &2 * r)")
      ASSUME_TAC THENL [X_GEN_TAC (← q r"k:num") THEN REWRITE_TAC [SUBSET, IN_MBALL] THEN
        X_GEN_TAC (← q r"x':A") THEN EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
          (X_CHOOSE_THEN (← q r"f':num->A->bool") STRIP_ASSUME_TAC)) THEN
        ASM_REWRITE_TAC [] THEN
        TRANS_TAC REAL_LTE_TRANS (← q r"(&2 - inv(&2 pow k)) * r") THEN CONJ_TAC THENL
         [MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"a:A", ← q r"r:real"]
            CHAIN_DISTANCE_BOUND) THEN ASM_REWRITE_TAC [] THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"k:num", ← q r"x':A", ← q r"f':num->A->bool"]) THEN
          ASM_REWRITE_TAC [], MATCH_MP_TAC REAL_LE_RMUL THEN
          CONJ_TAC THENL [REWRITE_TAC [← REAL_ARITH (← q r"x - y <= x <=> &0 <= y")] THEN
            SIMP_TAC [REAL_LE_INV_EQ, REAL_POW_LE, REAL_POS],
            MATCH_MP_TAC REAL_LT_IMP_LE THEN ASM_REWRITE_TAC []]], ALL_TAC] THEN
      /- Chain extension lemma -/
      SUBGOAL_THEN (← q r"!k z c. (z:A) IN (t:num->A->bool) k /\ z IN c /\
                 c SUBSET s /\ connected_in (mtopology m) c /\
                 mbounded m c /\ mdiameter m c < r / &2 pow (SUC k)
                 ==> c SUBSET t(SUC k)")
        (LABEL_TAC "extend") THENL [REPEAT GEN_TAC THEN STRIP_TAC THEN
        REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x':A") THEN DISCH_TAC THEN
        UNDISCH_TAC (← q r"(z:A) IN (t:num->A->bool) k") THEN
        EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_THEN (← q r"f':num->A->bool")
            (CONJUNCTS_THEN2 (LABEL_TAC "fc") STRIP_ASSUME_TAC))) THEN
        EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
        EXISTS_TAC (← q r"\i:num. if i <= k then (f':num->A->bool) i else c") THEN
        ASM_REWRITE_TAC [LE_0, ← ARITH_RULE (← q r"~(SUC k <= k)")] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"i':num") THEN
          ASM_CASES_TAC (← q r"i':num <= k") THEN ASM_REWRITE_TAC [] THENL
           [DISCH_TAC THEN USE_THEN "fc" (MP_TAC o SPEC (← q r"i':num")) THEN
            ASM_SIMP_TAC [], DISCH_TAC THEN
            SUBGOAL_THEN (← q r"i' = SUC k") SUBST_ALL_TAC THENL
             [ASM_ARITH_TAC, ASM_REWRITE_TAC []]],
          X_GEN_TAC (← q r"i':num") THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"i':num <= k") (fun th => REWRITE_TAC [th]) THENL
           [ASM_ARITH_TAC, ALL_TAC] THEN
          ASM_CASES_TAC (← q r"SUC i' <= k") THEN ASM_REWRITE_TAC [] THENL
           [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
            SUBGOAL_THEN (← q r"i' = k:num") SUBST_ALL_TAC THENL
             [ASM_ARITH_TAC, ALL_TAC] THEN
            REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
            EXISTS_TAC (← q r"z:A") THEN ASM_REWRITE_TAC []]], ALL_TAC] THEN
      /- Key property: t(k) SUBSET t(SUC k) -/
      SUBGOAL_THEN (← q r"!k. (t:num->A->bool) k SUBSET t(SUC k)") ASSUME_TAC THENL
       [X_GEN_TAC (← q r"k':num") THEN REWRITE_TAC [SUBSET] THEN
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(x:A) IN mspace m /\ x IN s") STRIP_ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN REWRITE_TAC [← GSYM SING_SUBSET] THEN
        USE_THEN "extend"
          (MP_TAC o SPECL [← q r"k':num", ← q r"x:A", ← q r"{x:A}"]) THEN ANTS_TAC THENL
         [ASM_REWRITE_TAC [IN_SING, SING_SUBSET] THEN
          ASM_SIMP_TAC [CONNECTED_IN_SING, TOPSPACE_MTOPOLOGY,
                        MBOUNDED_INSERT, MBOUNDED_EMPTY,
                        MDIAMETER_SING, REAL_LT_DIV, REAL_LT_POW2], SIMP_TAC []],
        ALL_TAC] THEN /- Key property: t(k) is connected -/
      SUBGOAL_THEN (← q r"!k. connected_in (mtopology m) ((t:num->A->bool) k)")
      ASSUME_TAC THENL [X_GEN_TAC (← q r"k:num") THEN
        REWRITE_TAC [CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [SUBSET_TRANS, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
        MATCH_MP_TAC (← MESON [CONNECTED_COMPONENT_OF_SYM,
          CONNECTED_COMPONENT_OF_TRANS] (← q
         r"!(a:A). (!x. x IN s ==> connected_component_of (subtopology top s) a x)
              ==> (!x y. x IN s /\ y IN s
                   ==> connected_component_of (subtopology top s) x y)")) THEN
        EXISTS_TAC (← q r"a:A") THEN SPEC_TAC (← q r"k:num", ← q r"k:num") THEN
        MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC THENL [/- Base case: k = 0 -/
          X_GEN_TAC (← q r"x:A") THEN EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
            (X_CHOOSE_THEN (← q r"f:num->A->bool") STRIP_ASSUME_TAC)) THEN SUBGOAL_THEN
            (← q r"connected_component_of
              (subtopology (mtopology m) ((f:num->A->bool) 0)) (a:A) x")
          MP_TAC THENL
           [REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
            EXISTS_TAC (← q r"(f:num->A->bool) 0") THEN
            ASM_SIMP_TAC [LE_REFL, SUBSET_REFL], ALL_TAC] THEN
          MATCH_MP_TAC (← MESON [CONNECTED_COMPONENT_OF_MONO] (← q r"(s:A->bool) SUBSET t
             ==> connected_component_of (subtopology top s) a x
                 ==> connected_component_of (subtopology top t) a x")) THEN
          EXPAND_TAC "t" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"c:A") THEN DISCH_TAC THEN
          SUBGOAL_THEN (← q r"(c:A) IN mspace m") ASSUME_TAC THENL
           [ASM_MESON_TAC [SUBSET, LE_REFL], ALL_TAC] THEN ASM_REWRITE_TAC [] THEN
          EXISTS_TAC (← q r"f:num->A->bool") THEN ASM_REWRITE_TAC [← GSYM SUBSET] THEN
          CONJ_TAC THENL [ASM_MESON_TAC [LE_REFL], ALL_TAC] THEN
          REWRITE_TAC [LT] THEN MESON_TAC [], ALL_TAC] THEN /- Inductive case -/
        X_GEN_TAC (← q r"k':num") THEN DISCH_TAC THEN X_GEN_TAC (← q r"c:A") THEN
        DISCH_TAC THEN
        /- Extract chain info from c IN t(SUC k') -/
        SUBGOAL_THEN (← q r"(c:A) IN mspace m") ASSUME_TAC THENL
         [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN SUBGOAL_THEN (← q r"?f:num->A->bool.
            (!i. i <= SUC k'
                 ==> connected_in (mtopology m) (f i) /\ (f i) SUBSET s /\
                     mbounded m (f i) /\ mdiameter m (f i) < r / &2 pow i) /\
            (a:A) IN f 0 /\ c IN f (SUC k') /\
            (!i. i < SUC k' ==> ~(f i INTER f (SUC i) = {}))")
          (X_CHOOSE_THEN (← q r"f:num->A->bool") STRIP_ASSUME_TAC) THENL
         [UNDISCH_TAC (← q r"(c:A) IN (t:num->A->bool) (SUC k')") THEN
          EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN
          DISCH_THEN (fun th => tactic_of do pure (ACCEPT_TAC (← CONJUNCT2 th))),
          ALL_TAC] THEN /- Get bridge point -/
        SUBGOAL_THEN (← q r"~((f:num->A->bool) k' INTER f(SUC k') = {})") MP_TAC THENL
         [FIRST_X_ASSUM MATCH_MP_TAC THEN ARITH_TAC,
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER]] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"b:A") STRIP_ASSUME_TAC) THEN
        /- Show b IN t(k') to use IH -/
        SUBGOAL_THEN (← q r"(b:A) IN (t:num->A->bool) k'") ASSUME_TAC THENL
         [EXPAND_TAC "t" THEN REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
           [ASM_MESON_TAC [SUBSET, LE_REFL,
              ← ARITH_RULE (← q r"k' <= SUC k'")], ALL_TAC] THEN
          EXISTS_TAC (← q r"f:num->A->bool") THEN
          ASM_REWRITE_TAC [] THEN CONJ_TAC THEN GEN_TAC THEN DISCH_TAC THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC, ALL_TAC] THEN
        /- Apply IH to get connected_component_of ... a b -/
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:A")) THEN ASM_REWRITE_TAC [] THEN
        /- Lift from t(k') to t(SUC k') and bridge via f(SUC k') -/
        MATCH_MP_TAC (← MESON
         [CONNECTED_COMPONENT_OF_MONO, CONNECTED_COMPONENT_OF_TRANS] (← q
          r"(s:A->bool) SUBSET t' /\ connected_component_of (subtopology top t') b c
           ==> connected_component_of (subtopology top s) a b
               ==> connected_component_of (subtopology top t') a c")) THEN
        ASM_REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
        EXISTS_TAC (← q r"(f:num->A->bool) (SUC k')") THEN ASM_SIMP_TAC [LE_REFL] THEN
        USE_THEN "extend"
          (MP_TAC o SPECL [← q r"k':num", ← q r"b:A", ← q r"(f:num->A->bool) (SUC k')"]) THEN
        ANTS_TAC THENL [ASM_SIMP_TAC [LE_REFL], SIMP_TAC []], ALL_TAC] THEN
      /- Now prove the 5 conjuncts -/ REPEAT CONJ_TAC THENL
       [/- open_in (subtopology top s) (UNIONS {t k | k IN UNIV}) -/
        ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
