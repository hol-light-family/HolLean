                      ← q r"s:A->bool"] BOLZANO_WEIERSTRASS_PROPERTY) THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [CLOSURE_OF, IN_INTER, IN_UNION] THEN
      ASM_MESON_TAC [SUBSET, DERIVED_SET_OF_MONO, DERIVED_SET_OF_SUBSET_TOPSPACE],
      ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"!n. ?y. y IN s /\ mdist m ((x:num->A) n,y) < inv(&n + &1)")
    MP_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN FIRST_ASSUM (MP_TAC o
          GEN_REWRITE_RULE RAND_CONV [METRIC_CLOSURE_OF] o SPEC (← q r"n:num")) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, IN_MBALL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inv(&n + &1)") o CONJUNCT2) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN MESON_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"y:num->A") THEN REWRITE_TAC [FORALL_AND_THM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:num->A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [LIMIT_METRIC] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    MP_TAC (← SPEC (← q r"e / &2") ARCH_EVENTUALLY_INV1) THEN
    ASM_REWRITE_TAC [REAL_HALF, IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [o_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    SUBGOAL_THEN (← q r"mdist m ((x:num->A)(r(n:num)),y(r n)) < e / &2") MP_TAC THENL
     [TRANS_TAC REAL_LT_TRANS (← q r"inv(&(r(n:num)) + &1)") THEN
      ASM_REWRITE_TAC [] THEN
      TRANS_TAC REAL_LET_TRANS (← q r"inv(&n + &1)") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      CONJ_TAC THENL [REAL_ARITH_TAC, REWRITE_TAC [REAL_LE_RADD]] THEN
      ASM_MESON_TAC [REAL_OF_NUM_LE, MONOTONE_BIGGER],
      UNDISCH_TAC (← q r"(l:A) IN mspace m")] THEN
    SUBGOAL_THEN (← q r"(x:num->A)(r(n:num)) IN mspace m") MP_TAC THENL
     [ASM_MESON_TAC [SUBSET, CLOSURE_OF_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      SIMP_TAC [] THEN CONV_TAC (fun t => METRIC_ARITH t)])

  let MCOMPLETE_REAL_EUCLIDEAN_METRIC ← prove
   r"mcomplete real_euclidean_metric"
   (REWRITE_TAC [mcomplete] THEN X_GEN_TAC (← q r"x:num->real") THEN
    DISCH_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_IN_IMP_MBOUNDED) THEN
    SIMP_TAC [mbounded, mcball, SUBSET, LEFT_IMP_EXISTS_THM, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_UNIV, IN_ELIM_THM, REAL_EUCLIDEAN_METRIC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"a - b:real", ← q r"a + b:real"]
      COMPACT_IN_EUCLIDEANREAL_INTERVAL) THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP COMPACT_IN_IMP_MCOMPLETE) THEN
    ASM_REWRITE_TAC [mcomplete, CAUCHY_IN_SUBMETRIC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->real")) THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL, ← REAL_ARITH (← q
     r"a - b <= x /\ x <= a + b <=> abs(x - a) <= b")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    SIMP_TAC [LIMIT_SUBTOPOLOGY, MTOPOLOGY_SUBMETRIC])

  let MCOMPLETE_SUBMETRIC_REAL_EUCLIDEAN_METRIC ← prove
   r"!s. mcomplete(submetric real_euclidean_metric s) <=>
       closed_in euclideanreal s"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    SIMP_TAC [CLOSED_IN_EQ_MCOMPLETE, MCOMPLETE_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, SUBSET_UNIV])

  let TOTALLY_BOUNDED_IN_DISCRETE_METRIC ← prove
   r"!u s:A->bool. totally_bounded_in (discrete_metric u) s <=>
                 FINITE s /\ s SUBSET u"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [FINITE_IMP_TOTALLY_BOUNDED_IN, DISCRETE_METRIC]] THEN
    SIMP_TAC [TOTALLY_BOUNDED_IN_EQ_COMPACT_CLOSURE_OF,
              MCOMPLETE_DISCRETE_METRIC] THEN
    REWRITE_TAC [MTOPOLOGY_DISCRETE_METRIC, DISCRETE_METRIC] THEN
    SIMP_TAC [DISCRETE_TOPOLOGY_CLOSURE_OF, COMPACT_IN_DISCRETE_TOPOLOGY,
              IMP_CONJ, ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")])

  let DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC ← prove
   r"!m s:A->bool.
        mtopology m derived_set_of s =
        {x | x IN mspace m /\
             !u. x IN u /\ open_in (mtopology m) u ==> INFINITE(s INTER u)}"
   (SIMP_TAC [DERIVED_SET_OF_INFINITE_OPEN_IN, HAUSDORFF_SPACE_MTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY])

  let (DERIVED_SET_OF_INFINITE_MBALL, DERIVED_SET_OF_INFINITE_MCBALL) ←
   CONJ_PAIR (← prove
   r"(!m s:A->bool.
        mtopology m derived_set_of s =
        {x | x IN mspace m /\
             !e. &0 < e ==> INFINITE(s INTER mball m (x,e))}) /\
   (!m s:A->bool.
        mtopology m derived_set_of s =
        {x | x IN mspace m /\
             !e. &0 < e ==> INFINITE(s INTER mcball m (x,e))})"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [EXTENSION, DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC] THEN
    REWRITE_TAC [IN_ELIM_THM, AND_FORALL_THM] THEN X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(x:A) IN mspace m") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q ==> r) /\ (r ==> p) /\ (p ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL] THEN CONJ_TAC THENL
     [MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [],
      REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_MTOPOLOGY_MCBALL]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"e:real") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real"))] THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] INFINITE_SUPERSET) THEN
    MATCH_MP_TAC (← SET_RULE (← q r"t SUBSET u ==> s INTER t SUBSET s INTER u")) THEN
    ASM_REWRITE_TAC [MBALL_SUBSET_MCBALL]))

  return { TOTALLY_BOUNDED_IN_EQ_COMPACT_CLOSURE_OF, COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS,
           MCOMPLETE_REAL_EUCLIDEAN_METRIC, MCOMPLETE_SUBMETRIC_REAL_EUCLIDEAN_METRIC,
           TOTALLY_BOUNDED_IN_DISCRETE_METRIC, DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC,
           DERIVED_SET_OF_INFINITE_MBALL, DERIVED_SET_OF_INFINITE_MCBALL }

/- ------------------------------------------------------------------------- -/
/- Pointwise continuity in topological spaces; continuity via bases and      -/
/- subbases, hence upper and lower semicontinuity.  (metric.ml 21764-21984)  -/
/- ------------------------------------------------------------------------- -/

structure PtCont where
  topcontinuous_at : thm
  TOPCONTINUOUS_AT_ATPOINTOF : thm
  CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT : thm
  CONTINUOUS_MAP_ATPOINTOF : thm
  LIMIT_CONTINUOUS_MAP : thm
  LIMIT_CONTINUOUS_MAP_WITHIN : thm
  CONTINUOUS_MAP_INTO_TOPOLOGY_BASE : thm
  CONTINUOUS_MAP_INTO_TOPOLOGY_BASE_EQ : thm
  CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE : thm
  CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE_EQ : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE_GEN : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE_GEN : thm
  CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE : thm
  deriving Inhabited

@[nospecialize]
def setupPtCont [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BBases : Bases) (BContMap1 : ContMap1) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2)
    (BAtPoint : AtPoint) (BLimits1 : Limits1) : ExceptT String IO PtCont := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, INTRO_TAC,
        .. } := D
  let { ARBITRARY, ARBITRARY_UNION_OF_INC, CONJ_ACI, FINITE_IMAGE, FINITE_INSERT,
        FINITE_INTERSECTION_OF_INC, FORALL_INTERSECTION_OF, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, FORALL_IN_UNION, FORALL_UNION_OF, FUN_EQ_THM, IMAGE_EQ_EMPTY,
        .. } := D.core1
  let { IMP_CONJ, IN, INTERS_GSPEC, INTERS_INSERT, IN_ELIM_THM, IN_INTER, IN_UNIV,
        NOT_INSERT_EMPTY, .. } := D.core2
  let { REAL_NOT_LT, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET, SUBSET_RESTRICT, UNIONS_GSPEC, real_gt, .. } := D.core4
  let { FORALL_RELATIVE_TO, RELATIVE_TO_INC, .. } := D.misc
  let { OPEN_IN_INTERS, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS,
        closed_in, .. } := BTopology
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { OPEN_IN_SUBBASE, TOPSPACE_SUBBASE, .. } := BBases
  let { continuous_map, .. } := BContMap1
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL, .. } := BRealTop2
  let { ATPOINTOF_SUBTOPOLOGY, .. } := BAtPoint
  let { LIMIT_ATPOINTOF, limit, .. } := BLimits1
  -- @@SCOPE END

  let topcontinuous_at ← new_definition
    r"!top top' f:A->B x.
     topcontinuous_at top top' f x <=>
     x IN topspace top /\
     (!x. x IN topspace top ==> f x IN topspace top') /\
     (!v. open_in top' v /\ f x IN v
          ==> (?u. open_in top u /\ x IN u /\ (!y. y IN u ==> f y IN v)))"

  let TOPCONTINUOUS_AT_ATPOINTOF ← prove
   r"!top top' f:A->B x.
        topcontinuous_at top top' f x <=>
        x IN topspace top /\
        (!x. x IN topspace top ==> f x IN topspace top') /\
        limit top' f (f x) (atpointof top x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [topcontinuous_at] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(p /\ q ==> (r <=> s)) ==> (p /\ q /\ r <=> p /\ q /\ s)")) THEN
    STRIP_TAC THEN ASM_SIMP_TAC [LIMIT_ATPOINTOF] THEN
    AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT ← prove
   r"!top top' f:A->B.
     continuous_map (top,top')  f <=>
     (!x. x IN topspace top ==> topcontinuous_at top top' f x)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
    [SIMP_TAC [continuous_map, topcontinuous_at] THEN
     INTRO_TAC "f v; !x; x; !v; v1 v2" THEN
     REMOVE_THEN "v" (MP_TAC o C MATCH_MP
       (← ASSUME (← q r"open_in top' (v:B->bool)"))) THEN
     INTRO_TAC "pre" THEN
     EXISTS_TAC (← q r"{x:A | x IN topspace top /\ f x:B IN v}") THEN
     ASM_SIMP_TAC [IN_ELIM_THM],
     ALL_TAC] THEN
    SIMP_TAC [continuous_map, topcontinuous_at, SUBSET] THEN
    INTRO_TAC "hp1" THEN CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    INTRO_TAC "![v]; v" THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN INTRO_TAC "!x; x1 x2" THEN
    REMOVE_THEN "hp1" (MP_TAC o SPEC (← q r"x:A")) THEN ASM_SIMP_TAC [] THEN
    INTRO_TAC "x3 v1" THEN REMOVE_THEN "v1" (MP_TAC o SPEC (← q r"v:B->bool")) THEN
    USE_THEN "x1" (LABEL_TAC "x4" o REWRITE_RULE [IN_ELIM_THM]) THEN
    ASM_SIMP_TAC [] THEN INTRO_TAC "@u. u1 u2 u3" THEN
    EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [SUBSET, IN_ELIM_THM] THEN
    ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET])

  let CONTINUOUS_MAP_ATPOINTOF ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f <=>
        !x. x IN topspace top ==> limit top' f (f x) (atpointof top x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT] THEN
    ASM_SIMP_TAC [TOPCONTINUOUS_AT_ATPOINTOF] THEN
    REWRITE_TAC [limit] THEN SET_TAC [])

  let LIMIT_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B) a b.
        continuous_map(top,top') f /\ a IN topspace top /\ f a = b
        ==> limit top' f b (atpointof top a)"
   (REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN MESON_TAC [])

  let LIMIT_CONTINUOUS_MAP_WITHIN ← prove
   r"!top top' (f:A->B) a b.
        continuous_map(subtopology top s,top') f /\
        a IN s /\ a IN topspace top /\ f a = b
        ==> limit top' f b (atpointof top a within s)"
   (SIMP_TAC [← GSYM ATPOINTOF_SUBTOPOLOGY] THEN
    SIMP_TAC [LIMIT_CONTINUOUS_MAP, TOPSPACE_SUBTOPOLOGY, IN_INTER])

  /- Continuity via bases/subbases, hence upper and lower semicontinuity. -/

  let CONTINUOUS_MAP_INTO_TOPOLOGY_BASE ← do
    let lemma ← prove
     r"{x | P x /\ f x IN UNIONS u} =
       UNIONS {{x | P x /\ f x IN b} | b IN u}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    prove
     r"!top top' b f:A->B.
        open_in top' = ARBITRARY UNION_OF b /\
        (!x. x IN topspace top ==> f x IN topspace top') /\
        (!u. u IN b ==> open_in top {x | x IN topspace top /\ f x IN u})
        ==> continuous_map(top,top') f"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [continuous_map] THEN
      ASM_REWRITE_TAC [FORALL_UNION_OF, ARBITRARY] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [lemma] THEN
      MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_INTO_TOPOLOGY_BASE_EQ ← prove
   r"!top top' b f:A->B.
      open_in top' = ARBITRARY UNION_OF b
      ==> (continuous_map(top,top') f <=>
           (!x. x IN topspace top ==> f x IN topspace top') /\
           (!u. u IN b ==> open_in top {x | x IN topspace top /\ f x IN u}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [continuous_map] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN ASM SET_TAC [],
      POP_ASSUM MP_TAC THEN REWRITE_TAC [← GSYM IMP_CONJ] THEN
      REWRITE_TAC [CONTINUOUS_MAP_INTO_TOPOLOGY_BASE]])

  let CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE ← do
    let lemma ← prove
     r"{x | P x /\ f x IN INTERS(a INSERT u)} =
       INTERS {{x | P x /\ f x IN b} | b IN (a INSERT u)}"
     (REWRITE_TAC [INTERS_GSPEC, INTERS_INSERT] THEN SET_TAC [])
    prove
     r"!top top' b u f:A->B.
        topology(ARBITRARY UNION_OF (FINITE INTERSECTION_OF b relative_to u)) =
        top' /\
        (!x. x IN topspace top ==> f x IN topspace top') /\
        (!u. u IN b ==> open_in top {x | x IN topspace top /\ f x IN u})
        ==> continuous_map(top,top') f"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_INTO_TOPOLOGY_BASE THEN
      EXISTS_TAC (← q r"(FINITE INTERSECTION_OF b relative_to u):(B->bool)->bool") THEN
      EXPAND_TAC "top'" THEN REWRITE_TAC [OPEN_IN_SUBBASE, FUN_EQ_THM] THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV o ONCE_DEPTH_CONV) [IN] THEN
      REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
      REWRITE_TAC [← GSYM INTERS_INSERT, lemma] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_INTERS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FINITE_INSERT] THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY, NOT_INSERT_EMPTY, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [FORALL_IN_INSERT] THEN
      FIRST_ASSUM (MP_TAC o AP_TERM (← q r"topspace:(B)topology->B->bool")) THEN
      REWRITE_TAC [TOPSPACE_SUBBASE] THEN DISCH_THEN SUBST1_TAC THEN
      ASM_SIMP_TAC [OPEN_IN_TOPSPACE, ← SET_RULE (← q
        r"(!x. x IN s ==> Q x) ==> {x | x IN s /\ Q x} = s")] THEN
      ASM SET_TAC [])

  let CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE_EQ ← prove
   r"!top top' b u f:A->B.
      topology(ARBITRARY UNION_OF
                (FINITE INTERSECTION_OF b relative_to u)) = top'
      ==> (continuous_map(top,top') f <=>
           (!x. x IN topspace top ==> f x IN topspace top') /\
           (!u. u IN b ==> open_in top {x | x IN topspace top /\ f x IN u}))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [continuous_map] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN v} =
        {x | x IN topspace top /\ f x IN (u INTER v)}")
      SUBST1_TAC THENL
       [FIRST_ASSUM (MP_TAC o AP_TERM (← q r"topspace:(B)topology->B->bool")) THEN
        REWRITE_TAC [TOPSPACE_SUBBASE] THEN ASM SET_TAC [],
        FIRST_X_ASSUM MATCH_MP_TAC THEN EXPAND_TAC "top'" THEN
        REWRITE_TAC [OPEN_IN_SUBBASE] THEN
        MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
        MATCH_MP_TAC RELATIVE_TO_INC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN ASM SET_TAC []],
      POP_ASSUM MP_TAC THEN REWRITE_TAC [← GSYM IMP_CONJ] THEN
      REWRITE_TAC [CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE]])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN ← prove
   r"!top u f:A->real.
         continuous_map (top,subtopology euclideanreal u) f <=>
         (!x. x IN topspace top ==> f x IN u) /\
         (!a. open_in top {x | x IN topspace top /\ f x > a}) /\
         (!a. open_in top {x | x IN topspace top /\ f x < a})"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← MATCH_MP CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE_EQ
     (← SPEC (← q r"u:real->bool") SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL)] THEN
    REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC, IN_UNIV] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_ELIM_THM])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT ← prove
   r"!top f:A->real.
         continuous_map (top,euclideanreal) f <=>
         (!a. open_in top {x | x IN topspace top /\ f x > a}) /\
         (!a. open_in top {x | x IN topspace top /\ f x < a})"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC
     (LAND_CONV o LAND_CONV o RAND_CONV) [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE_GEN ← prove
   r"!top u f:A->real.
         continuous_map (top,subtopology euclideanreal u) f <=>
         (!x. x IN topspace top ==> f x IN u) /\
         (!a. closed_in top {x | x IN topspace top /\ f x >= a}) /\
         (!a. closed_in top {x | x IN topspace top /\ f x <= a})"
   (REWRITE_TAC [← REAL_ARITH (← q r"a >= b <=> ~(b > a)"), ← GSYM REAL_NOT_LT] THEN
    REWRITE_TAC [closed_in, SUBSET_RESTRICT] THEN
    REWRITE_TAC [← SET_RULE (← q r"u DIFF {x | x IN u /\ ~P x} = {x | x IN u /\ P x}"),
                 CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN] THEN
    REWRITE_TAC [real_gt, CONJ_ACI])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE ← prove
   r"!top f:A->real.
         continuous_map (top,euclideanreal) f <=>
         (!a. closed_in top {x | x IN topspace top /\ f x >= a}) /\
         (!a. closed_in top {x | x IN topspace top /\ f x <= a})"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC
     (LAND_CONV o LAND_CONV o RAND_CONV) [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE_GEN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE_GEN ← prove
   r"!top u f:A->real.
         continuous_map (top,subtopology euclideanreal u) f <=>
         (!x. x IN topspace top ==> f x IN u) /\
         (!a. open_in top {x | x IN topspace top /\ f x < a}) /\
         (!a. closed_in top {x | x IN topspace top /\ f x <= a})"
   (REWRITE_TAC [← GSYM REAL_NOT_LT] THEN
    REWRITE_TAC [closed_in, SUBSET_RESTRICT] THEN
    REWRITE_TAC [← SET_RULE (← q r"u DIFF {x | x IN u /\ ~P x} = {x | x IN u /\ P x}"),
                 CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN] THEN
    REWRITE_TAC [real_gt, CONJ_ACI])

  let CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE ← prove
   r"!top f:A->real.
         continuous_map (top,euclideanreal) f <=>
         (!a. open_in top {x | x IN topspace top /\ f x < a}) /\
         (!a. closed_in top {x | x IN topspace top /\ f x <= a})"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC
     (LAND_CONV o LAND_CONV o RAND_CONV) [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE_GEN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  return { topcontinuous_at, TOPCONTINUOUS_AT_ATPOINTOF, CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT,
           CONTINUOUS_MAP_ATPOINTOF, LIMIT_CONTINUOUS_MAP, LIMIT_CONTINUOUS_MAP_WITHIN,
           CONTINUOUS_MAP_INTO_TOPOLOGY_BASE, CONTINUOUS_MAP_INTO_TOPOLOGY_BASE_EQ,
           CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE, CONTINUOUS_MAP_INTO_TOPOLOGY_SUBBASE_EQ,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT_GEN,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LT,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE_GEN,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LE,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE_GEN,
           CONTINUOUS_MAP_UPPER_LOWER_SEMICONTINUOUS_LTE }

/- ------------------------------------------------------------------------- -/
/- Continuous functions on metric spaces.  (metric.ml 21986-22146)           -/
/- ------------------------------------------------------------------------- -/

structure MetricCont where
  METRIC_CONTINUOUS_MAP : thm
  CONTINUOUS_MAP_TO_METRIC : thm
  CONTINUOUS_MAP_FROM_METRIC : thm
  CONTINUOUS_MAP_UNIFORM_LIMIT : thm
  CONTINUOUS_MAP_UNIFORM_LIMIT_ALT : thm
  CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupMetricCont [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BNets : Nets) (BSequential : Sequential) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BLimits1 : Limits1)
    (BMetricLim : MetricLim) (BCauchy1 : Cauchy1) (BPtCont : PtCont) :
    ExceptT String IO MetricCont := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, INTRO_TAC, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ_ALT, IMP_IMP, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, LE_REFL, MONO_EXISTS,
        MONO_FORALL, .. } := D.core2
  let { REAL_LT_01, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_RESTRICT, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { CONTINUOUS_MAP, continuous_map, .. } := BContMap1
  let { EVENTUALLY_AND, EVENTUALLY_HAPPENS, EVENTUALLY_MONO, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, .. } := BSequential
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_REFL, .. } := BMetricSpace
  let { OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { limit, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  let { MCOMPLETE, cauchy_in, .. } := BCauchy1
  let { CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT, topcontinuous_at, .. } := BPtCont
  -- @@SCOPE END

  let METRIC_CONTINUOUS_MAP ← prove
   r"!m m' f:A->B.
     continuous_map (mtopology m,mtopology m') f <=>
     (!x. x IN mspace m ==> f x IN mspace m') /\
     (!a e. &0 < e /\ a IN mspace m
            ==> (?d. &0 < d /\
                     (!x. x IN mspace m /\ mdist m (a,x) < d
                          ==> mdist m' (f a, f x) < e)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map, TOPSPACE_MTOPOLOGY] THEN
    EQ_TAC THEN SIMP_TAC [] THENL
    [INTRO_TAC "f cont; !a e; e a" THEN
     REMOVE_THEN "cont" (MP_TAC o SPEC (← q r"mball m' (f (a:A):B,e)")) THEN
     REWRITE_TAC [OPEN_IN_MBALL] THEN
     ASM_SIMP_TAC [OPEN_IN_MTOPOLOGY, SUBSET, IN_MBALL, IN_ELIM_THM] THEN
     DISCH_THEN (MP_TAC o SPEC (← q r"a:A")) THEN ASM_SIMP_TAC [MDIST_REFL],
     SIMP_TAC [OPEN_IN_MTOPOLOGY, SUBSET, IN_MBALL, IN_ELIM_THM] THEN
     ASM_MESON_TAC []])

  let CONTINUOUS_MAP_TO_METRIC ← prove
   r"!t m f:A->B.
     continuous_map (t,mtopology m) f <=>
     (!x. x IN topspace t
          ==> (!r. &0 < r
                   ==> (?u. open_in t u /\
                            x IN u /\
                            (!y. y IN u ==> f y IN mball m (f x,r)))))"
   (INTRO_TAC "!t m f" THEN
    REWRITE_TAC [CONTINUOUS_MAP_EQ_TOPCONTINUOUS_AT, topcontinuous_at,
                 TOPSPACE_MTOPOLOGY] THEN
    EQ_TAC THENL
    [INTRO_TAC "A; !x; x" THEN REMOVE_THEN "A" (MP_TAC o SPEC (← q r"x:A")) THEN
     ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL],
     INTRO_TAC "A; !x; x" THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_LT_01, IN_MBALL],
      ASM_MESON_TAC [OPEN_IN_MTOPOLOGY, SUBSET]]])

  let CONTINUOUS_MAP_FROM_METRIC ← prove
   r"!m top f:A->B.
        continuous_map (mtopology m,top) f <=>
        IMAGE f (mspace m) SUBSET topspace top /\
        !a. a IN mspace m
            ==> !u. open_in top u /\ f(a) IN u
                    ==> ?d. &0 < d /\
                            !x. x IN mspace m /\ mdist m (a,x) < d
                                ==> f x IN u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP, TOPSPACE_MTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"IMAGE (f:A->B) (mspace m) SUBSET topspace top") THEN
    ASM_REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"u:B->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:B->bool")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"a:A") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [IN_ELIM_THM, SUBSET, IN_MBALL] THEN MESON_TAC [],
      X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [SUBSET_RESTRICT, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:B->bool")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_MBALL, IN_ELIM_THM] THEN MESON_TAC []])

  let CONTINUOUS_MAP_UNIFORM_LIMIT ← prove
   r"!net top m f:K->A->B g.
        ~trivial_limit net /\
        eventually (\n. continuous_map (top,mtopology m) (f n)) net /\
        (!e. &0 < e
             ==> eventually
                   (\n. !x. x IN topspace top
                            ==> g x IN mspace m /\ mdist m (f n x,g x) < e)
                 net)
        ==> continuous_map (top,mtopology m) g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_TO_METRIC] THEN
    DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 MP_TAC (MP_TAC o SPEC (← q r"e / &3"))) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e"), IMP_IMP] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"k:K") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &3")) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:A") THEN
    DISCH_THEN (fun th => DISCH_TAC THEN MP_TAC th) THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (
      MP_TAC (← SPEC (← q r"y:A") th) THEN MP_TAC (← SPEC (← q r"x:A") th))) THEN
    SUBGOAL_THEN (← q r"(y:A) IN topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET], ASM_REWRITE_TAC []] THEN
    ASM_SIMP_TAC [IN_MBALL] THEN CONV_TAC (fun t => METRIC_ARITH t))

  let CONTINUOUS_MAP_UNIFORM_LIMIT_ALT ← prove
   r"!net top m f:K->A->B g.
        ~trivial_limit net /\
        IMAGE g (topspace top) SUBSET mspace m /\
        eventually (\n. continuous_map (top,mtopology m) (f n)) net /\
        (!e. &0 < e
             ==> eventually
                   (\n. !x. x IN topspace top ==> mdist m (f n x,g x) < e)
                 net)
        ==> continuous_map (top,mtopology m) g"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"net:K net") CONTINUOUS_MAP_UNIFORM_LIMIT) THEN
    EXISTS_TAC (← q r"f:K->A->B") THEN ASM_SIMP_TAC [])

  let CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT ← prove
   r"!top ms f:num->A->B.
      ~trivial_limit sequentially /\ mcomplete ms /\
      eventually (\n. continuous_map (top,mtopology ms) (f n)) sequentially /\
      (!e. &0 < e
           ==> ?N. !m n x. N <= m /\ N <= n /\ x IN topspace top
                           ==> mdist ms (f m x,f n x) < e)
      ==> ?g. continuous_map (top,mtopology ms) g /\
              !e. &0 < e
                  ==> eventually
                       (\n. !x. x IN topspace top
                                ==> mdist ms (f n x,g x) < e)
                       sequentially"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x. x IN topspace top
          ==> ?l. limit (mtopology ms) (\n. (f:num->A->B) n x) l sequentially")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [MCOMPLETE]) THEN
      REWRITE_TAC [cauchy_in] THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          EVENTUALLY_MONO)) THEN
        ASM_SIMP_TAC [continuous_map, TOPSPACE_MTOPOLOGY],
        ASM_MESON_TAC []],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:A->B") THEN DISCH_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (q ==> p) ==> p /\ q")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVENTUALLY_SEQUENTIALLY]) THEN
      REWRITE_TAC [continuous_map, LEFT_IMP_EXISTS_THM, TOPSPACE_MTOPOLOGY] THEN
      X_GEN_TAC (← q r"P:num") THEN DISCH_TAC THEN EXISTS_TAC (← q r"MAX N P") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"MAX N P <= n <=> N <= n /\ P <= n")] THEN
      X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN X_GEN_TAC (← q r"x:A") THEN
      DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [LIMIT_METRIC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &2"))) THEN
      ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"M:num") (MP_TAC o SPEC (← q r"MAX M (MAX N P)"))) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"MAX M (MAX N P)", ← q r"x:A"]) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
      ASM_SIMP_TAC [← ARITH_RULE (← q r"n <= MAX M N <=> n <= M \/ n <= N"), LE_REFL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o CONJUNCT1) THEN
      UNDISCH_TAC (← q r"(g:A->B) x IN mspace ms") THEN ASM_REWRITE_TAC [] THEN
      CONV_TAC (fun t => METRIC_ARITH t),
      DISCH_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") CONTINUOUS_MAP_UNIFORM_LIMIT_ALT) THEN
      EXISTS_TAC (← q r"f:num->A->B") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [limit, TOPSPACE_MTOPOLOGY]) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE]])

  return { METRIC_CONTINUOUS_MAP, CONTINUOUS_MAP_TO_METRIC, CONTINUOUS_MAP_FROM_METRIC,
           CONTINUOUS_MAP_UNIFORM_LIMIT, CONTINUOUS_MAP_UNIFORM_LIMIT_ALT,
           CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Combining theorems for continuous functions into the reals.              -/
/- (metric.ml 22148-22375)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealCont where
  CONTINUOUS_MAP_REAL_CONST : thm
  CONTINUOUS_MAP_REAL_MUL : thm
  CONTINUOUS_MAP_REAL_POW : thm
  CONTINUOUS_MAP_REAL_LMUL : thm
  CONTINUOUS_MAP_REAL_LMUL_EQ : thm
  CONTINUOUS_MAP_REAL_RMUL : thm
  CONTINUOUS_MAP_REAL_RMUL_EQ : thm
  CONTINUOUS_MAP_REAL_NEG : thm
  CONTINUOUS_MAP_REAL_NEG_EQ : thm
  CONTINUOUS_MAP_REAL_ADD : thm
  CONTINUOUS_MAP_REAL_SUB : thm
  CONTINUOUS_MAP_REAL_ABS : thm
  CONTINUOUS_MAP_REAL_MAX : thm
  CONTINUOUS_MAP_REAL_MIN : thm
  CONTINUOUS_MAP_SUM : thm
  CONTINUOUS_MAP_REAL_PRODUCT : thm
  CONTINUOUS_MAP_REAL_INV : thm
  CONTINUOUS_MAP_REAL_DIV : thm
  CONTINUOUS_MAP_INF : thm
  CONTINUOUS_MAP_SUP : thm
  CONTINUOUS_MAP_REAL_SHRINK : thm
  CONTINUOUS_MAP_REAL_GROW : thm
  HOMEOMORPHIC_MAPS_REAL_SHRINK : thm
  CONTINUOUS_MAP_CASES_LE : thm
  CONTINUOUS_MAP_CASES_LT : thm
  deriving Inhabited

@[nospecialize]
def setupRealCont [HolBase] (D : MetricDeps) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BHomeo1 : Homeo1) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BRealLim : RealLim)
    (BPtCont : PtCont) : ExceptT String IO RealCont := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, INDUCT_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, IN_UNIV, .. } := D.core2
  let { REAL_BOUNDS_LT, REAL_GROW_SHRINK, REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV,
        REAL_MUL_LZERO, REAL_MUL_SYM, REAL_NEG_MINUS1, .. } := D.core3
  let { REAL_SHRINK_GROW_EQ, REAL_SHRINK_RANGE, REAL_SUB_0, REAL_SUB_LE, RIGHT_FORALL_IMP_THM,
        SUBSET, real_ge, real_pow, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_CASES_FUNCTION, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { homeomorphic_maps, .. } := BHomeo1
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE, EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT,
        EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE, EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT,
        EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GE, EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GT,
        .. } := BRealTop2
  let { LIMIT_INF, LIMIT_PRODUCT, LIMIT_REAL_ABS, LIMIT_REAL_ADD, LIMIT_REAL_DIV,
        LIMIT_REAL_INV, LIMIT_REAL_LMUL, LIMIT_REAL_MAX, LIMIT_REAL_MIN, LIMIT_REAL_MUL,
        LIMIT_REAL_NEG, LIMIT_REAL_RMUL, LIMIT_REAL_SUB, LIMIT_SUM, LIMIT_SUP, .. } := BRealLim
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  -- @@SCOPE END

  let CONTINUOUS_MAP_REAL_CONST ← prove
   r"!top. continuous_map (top,euclideanreal) (\x:A. c)"
   (REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  let CONTINUOUS_MAP_REAL_MUL ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g
        ==> continuous_map (top,euclideanreal) (\x. f x * g x)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_MUL])

  let CONTINUOUS_MAP_REAL_POW ← prove
   r"!top (f:A->real) n.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. f x pow n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [real_pow, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_MUL])

  let CONTINUOUS_MAP_REAL_LMUL ← prove
   r"!top c f:A->real.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. c * f x)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_LMUL])

  let CONTINUOUS_MAP_REAL_LMUL_EQ ← prove
   r"!top c f:A->real.
        continuous_map (top,euclideanreal) (\x. c * f x) <=>
        c = &0 \/ continuous_map (top,euclideanreal) f"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [REAL_MUL_LZERO, CONTINUOUS_MAP_REAL_CONST] THEN
    EQ_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_REAL_LMUL] THEN DISCH_THEN (MP_TAC o
     SPEC (← q r"inv(c):real") o MATCH_MP CONTINUOUS_MAP_REAL_LMUL) THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LID, ETA_AX])

  let CONTINUOUS_MAP_REAL_RMUL ← prove
   r"!top c f:A->real.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. f x * c)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_RMUL])

  let CONTINUOUS_MAP_REAL_RMUL_EQ ← prove
   r"!top c f:A->real.
        continuous_map (top,euclideanreal) (\x. f x * c) <=>
        c = &0 \/ continuous_map (top,euclideanreal) f"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_LMUL_EQ])

  let CONTINUOUS_MAP_REAL_NEG ← prove
   r"!top f:A->real.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. --(f x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_NEG])

  let CONTINUOUS_MAP_REAL_NEG_EQ ← prove
   r"!top f:A->real.
        continuous_map (top,euclideanreal) (\x. --(f x)) <=>
        continuous_map (top,euclideanreal) f"
   (ONCE_REWRITE_TAC [REAL_NEG_MINUS1] THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_LMUL_EQ] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let CONTINUOUS_MAP_REAL_ADD ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g
        ==> continuous_map (top,euclideanreal) (\x. f x + g x)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_ADD])

  let CONTINUOUS_MAP_REAL_SUB ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g
        ==> continuous_map (top,euclideanreal) (\x. f x - g x)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_SUB])

  let CONTINUOUS_MAP_REAL_ABS ← prove
   r"!top f:A->real.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. abs(f x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_ABS])

  let CONTINUOUS_MAP_REAL_MAX ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g
        ==> continuous_map (top,euclideanreal) (\x. max (f x) (g x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_MAX])

  let CONTINUOUS_MAP_REAL_MIN ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g
        ==> continuous_map (top,euclideanreal) (\x. min (f x) (g x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_MIN])

  let CONTINUOUS_MAP_SUM ← prove
   r"!top f:A->K->real k.
        FINITE k /\
        (!i. i IN k ==> continuous_map (top,euclideanreal) (\x. f x i))
        ==> continuous_map (top,euclideanreal) (\x. sum k (f x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_SUM])

  let CONTINUOUS_MAP_REAL_PRODUCT ← prove
   r"!top f:A->K->real k.
        FINITE k /\
        (!i. i IN k ==> continuous_map (top,euclideanreal) (\x. f x i))
        ==> continuous_map (top,euclideanreal) (\x. product k (f x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_PRODUCT])

  let CONTINUOUS_MAP_REAL_INV ← prove
   r"!top f:A->real.
        continuous_map (top,euclideanreal) f /\
        (!x. x IN topspace top ==> ~(f x = &0))
        ==> continuous_map (top,euclideanreal) (\x. inv(f x))"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_INV])

  let CONTINUOUS_MAP_REAL_DIV ← prove
   r"!top f g:A->real.
        continuous_map (top,euclideanreal) f /\
        continuous_map (top,euclideanreal) g /\
        (!x. x IN topspace top ==> ~(g x = &0))
        ==> continuous_map (top,euclideanreal) (\x. f x / g x)"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_REAL_DIV])

  let CONTINUOUS_MAP_INF ← prove
   r"!top f:A->K->real k.
        FINITE k /\
        (!i. i IN k ==> continuous_map (top,euclideanreal) (\x. f x i))
        ==> continuous_map (top,euclideanreal) (\x. inf {f x i | i IN k})"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_INF])

  let CONTINUOUS_MAP_SUP ← prove
   r"!top f:A->K->real k.
        FINITE k /\
        (!i. i IN k ==> continuous_map (top,euclideanreal) (\x. f x i))
        ==> continuous_map (top,euclideanreal) (\x. sup {f x i | i IN k})"
   (SIMP_TAC [CONTINUOUS_MAP_ATPOINTOF, LIMIT_SUP])

  let CONTINUOUS_MAP_REAL_SHRINK ← prove
   r"continuous_map (euclideanreal,
                   subtopology euclideanreal (real_interval(--(&1),&1)))
                  (\x. x / (&1 + abs x))"
   (REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_REAL_INTERVAL, REAL_BOUNDS_LT, REAL_SHRINK_RANGE] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_DIV THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID, ← REAL_ARITH (← q r"~(&1 + abs x = &0)")] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_ADD THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_ABS THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID])

  let CONTINUOUS_MAP_REAL_GROW ← prove
   r"continuous_map (subtopology euclideanreal (real_interval(--(&1),&1)),
                   euclideanreal)
                  (\x. x / (&1 - abs x))"
   (MATCH_MP_TAC CONTINUOUS_MAP_REAL_DIV THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
    SIMP_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_REAL_INTERVAL] THEN
    CONJ_TAC THENL [MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB, REAL_ARITH_TAC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_ABS THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID])

  let HOMEOMORPHIC_MAPS_REAL_SHRINK ← prove
   r"homeomorphic_maps
     (euclideanreal,subtopology euclideanreal (real_interval(--(&1),&1)))
     ((\x. x / (&1 + abs x)),(\y. y / (&1 - abs y)))"
   (REWRITE_TAC [homeomorphic_maps] THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_SHRINK, CONTINUOUS_MAP_REAL_GROW] THEN
    REWRITE_TAC [REAL_GROW_SHRINK, REAL_SHRINK_GROW_EQ] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_REAL_INTERVAL] THEN
    REAL_ARITH_TAC)

  let CONTINUOUS_MAP_CASES_LE ← prove
   r"!top top' p q f (g:A->B).
        continuous_map (top,euclideanreal) p /\
        continuous_map (top,euclideanreal) q /\
        continuous_map
         (subtopology top {x | x IN topspace top /\ p x <= q x},top') f /\
        continuous_map
         (subtopology top {x | x IN topspace top /\ q x <= p x},top') g /\
        (!x. x IN topspace top /\ p x = q x ==> f x = g x)
        ==> continuous_map (top,top') (\x. if p x <= q x then f x else g x)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x <= y <=> y - x >= &0")] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"x >= &0 <=> x IN {t | t >= &0}")] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_CASES_FUNCTION THEN
    EXISTS_TAC (← q r"euclideanreal") THEN ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_SUB] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, ← REAL_ARITH (← q r"~(x >= y) <=> x:real < y"),
      ← SET_RULE (← q r"UNIV DIFF {x | P x} = {x | ~P x}")] THEN
    REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT,
                 EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GE] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, REAL_SUB_0, real_ge, REAL_SUB_LE] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"p - q <= &0 <=> p <= q")] THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_MAP_CASES_LT ← prove
   r"!top top' p q f (g:A->B).
        continuous_map (top,euclideanreal) p /\
        continuous_map (top,euclideanreal) q /\
        continuous_map
         (subtopology top {x | x IN topspace top /\ p x <= q x},top') f /\
        continuous_map
         (subtopology top {x | x IN topspace top /\ q x <= p x},top') g /\
        (!x. x IN topspace top /\ p x = q x ==> f x = g x)
        ==> continuous_map (top,top') (\x. if p x < q x then f x else g x)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q r"x < y <=> y - x > &0")] THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"x > &0 <=> x IN {t | t > &0}")] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_CASES_FUNCTION THEN
    EXISTS_TAC (← q r"euclideanreal") THEN ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_SUB] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, ← REAL_ARITH (← q r"~(x > y) <=> x:real <= y"),
      ← SET_RULE (← q r"UNIV DIFF {x | P x} = {x | ~P x}")] THEN
    REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE,
                 EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GT] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, REAL_SUB_0, real_ge, REAL_SUB_LE] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"p - q <= &0 <=> p <= q")] THEN
    ASM_MESON_TAC [])

  return { CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_POW,
           CONTINUOUS_MAP_REAL_LMUL, CONTINUOUS_MAP_REAL_LMUL_EQ, CONTINUOUS_MAP_REAL_RMUL,
           CONTINUOUS_MAP_REAL_RMUL_EQ, CONTINUOUS_MAP_REAL_NEG, CONTINUOUS_MAP_REAL_NEG_EQ,
           CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_SUB, CONTINUOUS_MAP_REAL_ABS,
           CONTINUOUS_MAP_REAL_MAX, CONTINUOUS_MAP_REAL_MIN, CONTINUOUS_MAP_SUM,
           CONTINUOUS_MAP_REAL_PRODUCT, CONTINUOUS_MAP_REAL_INV, CONTINUOUS_MAP_REAL_DIV,
           CONTINUOUS_MAP_INF, CONTINUOUS_MAP_SUP, CONTINUOUS_MAP_REAL_SHRINK,
           CONTINUOUS_MAP_REAL_GROW, HOMEOMORPHIC_MAPS_REAL_SHRINK, CONTINUOUS_MAP_CASES_LE,
           CONTINUOUS_MAP_CASES_LT }

/- ------------------------------------------------------------------------- -/
/- Some elementary results on real limits, proved here for convenience, and  -/
/- similar elementary results for infinite series of reals.                  -/
/- (metric.ml 22377-22549)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealSeries where
  tendsto_real_def : thm
  reallim : thm
  TENDSTO_REAL_EPS_DELTA : thm
  REALLIM_CONST : thm
  REALLIM_SUB : thm
  REALLIM_UBOUND : thm
  REALLIM_LBOUND : thm
  REALLIM_LE : thm
  REALLIM_SEQUENTIALLY : thm
  real_sums : thm
  real_infsum : thm
  real_summable : thm
  REAL_SUMS_SUMMABLE : thm
  REAL_SUMS_INFSUM : thm
  REAL_SERIES_FROM : thm
  REAL_SUMMABLE_CAUCHY : thm
  REAL_SUMMABLE_COMPARISON : thm
  REAL_SERIES_LE : thm
  deriving Inhabited

@[nospecialize]
def setupRealSeries [HolBase] (D : MetricDeps) (BNets : Nets) (BSequential : Sequential)
    (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BLimits1 : Limits1)
    (BMetricLim : MetricLim) (BRealLim : RealLim) (BCauchy1 : Cauchy1)
    (BMCompact3 : MCompact3) : ExceptT String IO RealSeries := do
  -- @@SCOPE BEGIN
  let { new_definition, parse_as_infix, ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON,
        MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, .. } := D
  let { DISJOINT_NUMSEG, FINITE_INTER, FINITE_NUMSEG, GE, .. } := D.core1
  let { IMP_CONJ_ALT, IMP_IMP, INTER_EMPTY, IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_0, LE_CASES, LE_EXISTS, NOT_LT, NUMSEG_ADD_SPLIT,
        NUMSEG_EMPTY, REAL_ABS_0, .. } := D.core2
  let { REAL_ABS_SUB, REAL_LET_TRANS, .. } := D.core3
  let { SUM_ABS_LE, SUM_CLAUSES, SUM_LE, SUM_UNION, UNION_OVER_INTER, real_ge, .. } := D.core4
  let { FINITE_INTER_NUMSEG, FROM_INTER_NUMSEG, .. } := D.misc
  let { EVENTUALLY_MONO, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_REAL_CONST, .. } := BLimits1
  let { LIMIT_IN_CLOSED_IN, LIMIT_METRIC, .. } := BMetricLim
  let { LIMIT_REAL_SUB, .. } := BRealLim
  let { MCOMPLETE_ALT, cauchy_in, .. } := BCauchy1
  let { MCOMPLETE_REAL_EUCLIDEAN_METRIC, .. } := BMCompact3
  -- @@SCOPE END

  parse_as_infix ("--->", (12, "right"))

  let tendsto_real_def ← new_definition
    r"(f ---> l) (net:A net) <=> limit euclideanreal f l net"

  let reallim ← new_definition
   r"reallim net (f:A->real) = @l. (f ---> l) net"

  /- Epsilon-delta characterization (named to avoid clash with TENDSTO_REAL
     in realanalysis.ml, which is the lift/drop bridge theorem) -/
  let TENDSTO_REAL_EPS_DELTA ← prove
   r"!(f:A->real) l net.
     (f ---> l) net <=>
     !e. &0 < e ==> eventually (\x. abs(f x - l) < e) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [tendsto_real_def, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(y - x) = abs(x - y)")])

  let REALLIM_CONST ← prove
   r"!net:A net a. ((\x. a) ---> a) net"
   (REWRITE_TAC [tendsto_real_def, LIMIT_REAL_CONST])

  let REALLIM_SUB ← prove
   r"!net (f:A->real) g l m.
     (f ---> l) net /\ (g ---> m) net
     ==> ((\x. f x - g x) ---> l - m) net"
   (REWRITE_TAC [tendsto_real_def, LIMIT_REAL_SUB])

  let REALLIM_UBOUND ← prove
   r"!net (f:A->real) l b.
     (f ---> l) net /\ ~trivial_limit net /\
     eventually (\x. f x <= b) net
     ==> l <= b"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real_def] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"net:A net", ← q r"euclideanreal", ← q r"{x:real | x <= b}", ← q r"f:A->real",
      ← q r"l:real"]
     LIMIT_IN_CLOSED_IN) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, ← GSYM REAL_CLOSED_IN, REAL_CLOSED_HALFSPACE_LE])

  let REALLIM_LBOUND ← prove
   r"!net (f:A->real) l b.
     (f ---> l) net /\ ~trivial_limit net /\
     eventually (\x. b <= f x) net
     ==> b <= l"
   (REPEAT GEN_TAC THEN REWRITE_TAC [tendsto_real_def] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"net:A net", ← q r"euclideanreal", ← q r"{x:real | x >= b}", ← q r"f:A->real",
      ← q r"l:real"]
     LIMIT_IN_CLOSED_IN) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, ← GSYM REAL_CLOSED_IN,
                     REAL_CLOSED_HALFSPACE_GE, real_ge])

  let REALLIM_LE ← prove
   r"!net (f:A->real) g l m.
     (f ---> l) net /\ (g ---> m) net /\ ~trivial_limit net /\
     eventually (\x. f x <= g x) net
     ==> l <= m"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC (← REAL_ARITH (← q r"&0 <= m - l ==> l <= m")) THEN
    MATCH_MP_TAC (← ISPEC (← q r"net:A net") REALLIM_LBOUND) THEN
    EXISTS_TAC (← q r"\x:A. (g:A->real) x - f x") THEN
    ASM_SIMP_TAC [REALLIM_SUB] THEN FIRST_X_ASSUM
      (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] EVENTUALLY_MONO)) THEN
    DISCH_THEN MATCH_MP_TAC THEN REAL_ARITH_TAC)

  let REALLIM_SEQUENTIALLY ← prove
   r"!(f:num->real) l.
     (f ---> l) sequentially <=>
     !e. &0 < e ==> ?N. !n. N <= n ==> abs(f n - l) < e"
   (REWRITE_TAC [TENDSTO_REAL_EPS_DELTA, EVENTUALLY_SEQUENTIALLY])

  /- Similar elementary results for infinite series of reals. -/

  parse_as_infix ("real_sums", (12, "right"))

  let real_sums ← new_definition
   r"(f real_sums l) s <=>
    ((\n. sum (s INTER (0..n)) f) ---> l) sequentially"

  let real_infsum ← new_definition
   r"real_infsum s f = @l. (f real_sums l) s"

  let real_summable ← new_definition
   r"real_summable s f <=> ?l. (f real_sums l) s"

  let REAL_SUMS_SUMMABLE ← prove
   r"!f l s. (f real_sums l) s ==> real_summable s f"
   (REWRITE_TAC [real_summable] THEN MESON_TAC [])

  let REAL_SUMS_INFSUM ← prove
   r"!f s. (f real_sums (real_infsum s f)) s <=> real_summable s f"
   (REWRITE_TAC [real_infsum, real_summable] THEN MESON_TAC [])

  let REAL_SERIES_FROM ← prove
   r"!f l k. (f real_sums l) (from k) <=>
           ((\n. sum(k..n) f) ---> l) sequentially"
   (REWRITE_TAC [real_sums, FROM_INTER_NUMSEG])

  /- Cauchy criterion for real summation -/
  let REAL_SUMMABLE_CAUCHY ← do
    let lemma ← prove
     r"!f k m n.
          m <= n
          ==> sum(k INTER (0..n)) f - sum(k INTER (0..m)) f =
              sum(k INTER (m+1..n)) f"
     (SIMP_TAC [LE_EXISTS, LEFT_IMP_EXISTS_THM, NUMSEG_ADD_SPLIT, LE_0] THEN
      SIMP_TAC [SUM_UNION, FINITE_INTER, FINITE_NUMSEG, DISJOINT_NUMSEG,
                UNION_OVER_INTER, ← ARITH_RULE (← q r"n < n + 1"), ← SET_RULE (← q
       r"DISJOINT (u:num->bool) v ==> DISJOINT (s INTER u) (s INTER v)")] THEN
      REAL_ARITH_TAC)
    prove
     r"!f s.
        real_summable s f <=>
        !e. &0 < e
            ==> ?N. !m n. m >= N ==> abs(sum(s INTER (m..n)) f) < e"
     (REWRITE_TAC [GE] THEN REPEAT STRIP_TAC THEN
      ONCE_REWRITE_TAC [← MESON [← ARITH_RULE (← q r"N:num <= m ==> N <= m + 1"),
                  ← ARITH_RULE (← q r"N + 1 <= m ==> N <= m - 1 /\ (m - 1) + 1 = m")]
       (← q r"(?N. !m n:num. N <= m ==> P m n) <=> ?N. !m n. N <= m ==> P(m + 1) n")] THEN
      MP_TAC (← REWRITE_RULE [MCOMPLETE_ALT] MCOMPLETE_REAL_EUCLIDEAN_METRIC) THEN
      REWRITE_TAC [real_summable, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, real_sums] THEN
      REWRITE_TAC [tendsto_real_def, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
      REWRITE_TAC [cauchy_in, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      ONCE_REWRITE_TAC [← MESON [LE_CASES, REAL_ABS_SUB] (← q
       r"(!x y:num. P x /\ P y ==> abs(f y - f x):real < e) <=>
        (!x y. x <= y ==> P x /\ P y ==> abs(f y - f x) < e)")] THEN
      SIMP_TAC [lemma, ← MESON [NUMSEG_EMPTY, INTER_EMPTY, SUM_CLAUSES, REAL_ABS_0] (← q
       r"!e. &0 < e ==> (P ==> abs(sum (s INTER (m..n)) f) < e <=>
                        P ==> n < m \/ abs(sum (s INTER (m..n)) f) < e)")] THEN
      REWRITE_TAC [GE, NOT_LT, IMP_IMP, ← TAUT (← q r"a ==> b \/ c <=> a /\ ~b ==> c")] THEN
      REWRITE_TAC [← ARITH_RULE (← q
       r"(n <= m /\ N <= n /\ N <= m) /\ n + 1 <= m <=> N <= n /\ n + 1 <= m")])

  /- Comparison test -/
  let REAL_SUMMABLE_COMPARISON ← prove
   r"!f g s. real_summable s g /\
           (?N. !n. n >= N /\ n IN s ==> abs(f n) <= g n)
           ==> real_summable s f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [REAL_SUMMABLE_CAUCHY] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"N1:num"))) THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"N2:num")) THEN EXISTS_TAC (← q r"N1 + N2:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LET_TRANS THEN
    EXISTS_TAC (← q r"abs(sum(s INTER (m..n)) g)") THEN CONJ_TAC THENL
    [MATCH_MP_TAC (← REAL_ARITH (← q r"abs x <= a ==> abs x <= abs a")) THEN
     MATCH_MP_TAC SUM_ABS_LE THEN
     REWRITE_TAC [FINITE_INTER_NUMSEG, IN_INTER, IN_NUMSEG] THEN
     X_GEN_TAC (← q r"k:num") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
     ASM_REWRITE_TAC [GE] THEN ASM_ARITH_TAC,
     FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC])

  let REAL_SERIES_LE ← prove
   r"!f g s y z.
     (f real_sums y) s /\ (g real_sums z) s /\
     (!i. i IN s ==> f i <= g i)
     ==> y <= z"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") REALLIM_LE) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"\n. sum(s INTER (0..n)) (f:num->real)",
      ← q r"\n. sum(s INTER (0..n)) (g:num->real)"] THEN
    ASM_REWRITE_TAC [← GSYM real_sums, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"0") THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC SUM_LE THEN
    REWRITE_TAC [FINITE_INTER_NUMSEG, IN_INTER] THEN ASM_MESON_TAC [])

  return { tendsto_real_def, reallim, TENDSTO_REAL_EPS_DELTA, REALLIM_CONST, REALLIM_SUB,
           REALLIM_UBOUND, REALLIM_LBOUND, REALLIM_LE, REALLIM_SEQUENTIALLY, real_sums,
           real_infsum, real_summable, REAL_SUMS_SUMMABLE, REAL_SUMS_INFSUM, REAL_SERIES_FROM,
           REAL_SUMMABLE_CAUCHY, REAL_SUMMABLE_COMPARISON, REAL_SERIES_LE }

/- ------------------------------------------------------------------------- -/
/- Paths and path-connectedness.  (metric.ml 22551-22766)                    -/
/- ------------------------------------------------------------------------- -/

structure Paths1 where
  path_in : thm
  PATH_IN_COMPOSE : thm
  PATH_IN_SUBTOPOLOGY : thm
  PATH_IN_CONST : thm
  path_connected_space : thm
  path_connected_in : thm
  PATH_CONNECTED_IN_ABSOLUTE : thm
  PATH_CONNECTED_IN_SUBSET_TOPSPACE : thm
  PATH_CONNECTED_IN_SUBTOPOLOGY : thm
  PATH_CONNECTED_IN : thm
  PATH_CONNECTED_IN_TOPSPACE : thm
  PATH_CONNECTED_IMP_CONNECTED_SPACE : thm
  PATH_CONNECTED_IN_IMP_CONNECTED_IN : thm
  PATH_CONNECTED_SPACE_TOPSPACE_EMPTY : thm
  PATH_CONNECTED_IN_EMPTY : thm
  PATH_CONNECTED_IN_SING : thm
  PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE : thm
  HOMEOMORPHIC_PATH_CONNECTED_SPACE : thm
  HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS : thm
  HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS_EQ : thm
  PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : thm
  PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : thm
  PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupPaths1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BRetraction : Retraction)
    (BConnected1 : Connected1) (BConnected2 : Connected2) (BConnected3 : Connected3)
    (BRealTop1 : RealTop1) (BRealConn1 : RealConn1) (BRealCont : RealCont) :
    ExceptT String IO Paths1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, GEN_SIMPLIFY_CONV, TOP_DEPTH_SQCONV, basic_ss,
        .. } := D
  let { CONJ_ASSOC, EMPTY_SUBSET, FORALL_IN_IMAGE, FORALL_IN_IMAGE_2, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_o, IMP_CONJ, INTER_ACI, INTER_EMPTY, INTER_UNIV, IN_IMAGE,
        IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_ADD_LID, REAL_ADD_RID, REAL_LE_MUL, REAL_LE_REFL, REAL_MUL_LID, REAL_MUL_LZERO,
        REAL_POS, .. } := D.core3
  let { REAL_SUB_LE, REAL_SUB_REFL, REAL_SUB_RZERO, SING_SUBSET, SUBSET, SUBSET_INTER,
        SUBSET_REFL, SUBSET_UNIV, o_THM, .. } := D.core4
  let { IN_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY, .. } := D.misc
  let { SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } :=
    BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
        continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, .. } := BQuotient
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { CONNECTED_IN_ABSOLUTE, connected_in, .. } := BConnected1
  let { CONNECTED_SPACE_SUBCONNECTED, .. } := BConnected2
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONNECTED_IN_EUCLIDEANREAL_INTERVAL, .. } := BRealConn1
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_RMUL,
        CONTINUOUS_MAP_REAL_SUB, .. } := BRealCont
  -- @@SCOPE END

  let path_in ← new_definition
   r"path_in top (g:real->A) <=>
  continuous_map (subtopology euclideanreal (real_interval[&0,&1]),top) g"

  let PATH_IN_COMPOSE ← prove
   r"!top top' f:A->B g:real->A.
        path_in top g /\ continuous_map(top,top') f ==> path_in top' (f o g)"
   (REWRITE_TAC [path_in, CONTINUOUS_MAP_COMPOSE])

  let PATH_IN_SUBTOPOLOGY ← prove
   r"!top s g:real->A.
        path_in (subtopology top s) g <=>
        path_in top g /\ (!x. x IN real_interval[&0,&1] ==> g x IN s)"
   (REWRITE_TAC [path_in, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [continuous_map, TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL] THEN
    SET_TAC [])

  let PATH_IN_CONST ← prove
   r"!top a:A. path_in top (\x. a) <=> a IN topspace top"
   (REWRITE_TAC [path_in, CONTINUOUS_MAP_CONST] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, REAL_INTERVAL_EQ_EMPTY] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let path_connected_space ← new_definition
   r"path_connected_space top <=>
        !x y:A. x IN topspace top /\ y IN topspace top
                ==> ?g. path_in top g /\ g(&0) = x /\ g(&1) = y"

  let path_connected_in ← new_definition
   r"path_connected_in top (s:A->bool) <=>
  s SUBSET topspace top /\ path_connected_space(subtopology top s)"

  let PATH_CONNECTED_IN_ABSOLUTE ← prove
   r"!top s:A->bool.
        path_connected_in (subtopology top s) s <=> path_connected_in top s"
   (REWRITE_TAC [path_connected_in, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, SUBSET_REFL] THEN
    REWRITE_TAC [INTER_ACI])

  let PATH_CONNECTED_IN_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. path_connected_in top s ==> s SUBSET topspace top"
   (SIMP_TAC [path_connected_in])

  let PATH_CONNECTED_IN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
      path_connected_in (subtopology top s) t <=>
      path_connected_in top t /\ t SUBSET s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_connected_in, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    ASM_CASES_TAC (← q r"(t:A->bool) SUBSET s") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"t SUBSET s ==> s INTER t = t")])

  let PATH_CONNECTED_IN ← prove
   r"!top s:A->bool.
        path_connected_in top s <=>
        s SUBSET topspace top /\
        !x y. x IN s /\ y IN s
              ==> ?g. path_in top g /\
                      IMAGE g (real_interval[&0,&1]) SUBSET s /\
                      g(&0) = x /\ g(&1) = y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_connected_in, path_connected_space] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, path_in, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
                  ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, INTER_UNIV, ← GSYM CONJ_ASSOC])

  let PATH_CONNECTED_IN_TOPSPACE ← prove
   r"!top:A topology. path_connected_in top (topspace top) <=>
                    path_connected_space top"
   (REWRITE_TAC [path_connected_in, SUBSET_REFL, SUBTOPOLOGY_TOPSPACE])

  let PATH_CONNECTED_IMP_CONNECTED_SPACE ← prove
   r"!top:A topology. path_connected_space top ==> connected_space top"
   (REWRITE_TAC [path_connected_space, CONNECTED_SPACE_SUBCONNECTED] THEN
    GEN_TAC THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [path_in, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (g:real->A) (real_interval [&0,&1])") THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
        CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
      REWRITE_TAC [CONNECTED_IN_ABSOLUTE] THEN
      REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL_INTERVAL],
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&0") THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL, REAL_POS],
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&1") THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL, REAL_POS, REAL_LE_REFL]])

  let PATH_CONNECTED_IN_IMP_CONNECTED_IN ← prove
   r"!top s:A->bool. path_connected_in top s ==> connected_in top s"
   (SIMP_TAC [path_connected_in, connected_in] THEN
    SIMP_TAC [PATH_CONNECTED_IMP_CONNECTED_SPACE])

  let PATH_CONNECTED_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> path_connected_space top"
   (SIMP_TAC [path_connected_space, NOT_IN_EMPTY])

  let PATH_CONNECTED_IN_EMPTY ← prove
   r"!top:A topology. path_connected_in top {}"
   (SIMP_TAC [path_connected_in, PATH_CONNECTED_SPACE_TOPSPACE_EMPTY,
              EMPTY_SUBSET, TOPSPACE_SUBTOPOLOGY, INTER_EMPTY])

  let PATH_CONNECTED_IN_SING ← prove
   r"!top a:A. path_connected_in top {a} <=> a IN topspace top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PATH_CONNECTED_IN, SING_SUBSET] THEN
    ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN ASM_REWRITE_TAC [IN_SING] THEN
    REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"(\x. a):real->A") THEN
    ASM_REWRITE_TAC [path_in, CONTINUOUS_MAP_CONST] THEN SET_TAC [])

  let PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE ← prove
   r"!f:A->B top top' s.
        continuous_map (top,top') f /\ path_connected_in top s
        ==> path_connected_in top' (IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PATH_CONNECTED_IN] THEN
    STRIP_TAC THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP
     CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [FORALL_IN_IMAGE_2]] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(f:A->B) o (g:real->A)") THEN
    ASM_SIMP_TAC [o_THM, IMAGE_o, IMAGE_SUBSET] THEN
    ASM_MESON_TAC [PATH_IN_COMPOSE])

  let HOMEOMORPHIC_PATH_CONNECTED_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (path_connected_space top <=> path_connected_space top')"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_space, homeomorphic_maps, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)") SUBST1_TAC
      THENL [ALL_TAC, ASM_MESON_TAC [PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE]],
      SUBGOAL_THEN (← q r"topspace top = IMAGE (g:B->A) (topspace top')") SUBST1_TAC
      THENL [ALL_TAC, ASM_MESON_TAC [PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE]]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (path_connected_in top' (IMAGE f u) <=> path_connected_in top u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [path_connected_in] THEN
    BINOP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC HOMEOMORPHIC_PATH_CONNECTED_SPACE THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN EXISTS_TAC (← q r"f:A->B") THEN
      MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
      ASM_REWRITE_TAC []] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (path_connected_in top u <=>
             u SUBSET topspace top /\ path_connected_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS,
               PATH_CONNECTED_IN_SUBSET_TOPSPACE])

  let PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ path_connected_space top
        ==> path_connected_space top'"
   (REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP QUOTIENT_IMP_SURJECTIVE_MAP) THEN
    MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
    ASM_MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP])

  let PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ path_connected_space top
        ==> path_connected_space top'"
   (MESON_TAC [PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL ← prove
   r"(!a b. path_connected_in euclideanreal (real_interval[a,b])) /\
   (!a b. path_connected_in euclideanreal (real_interval(a,b)))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_IN, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\u. (&1 - u) * x + u * y") THEN
    REWRITE_TAC [REAL_SUB_REFL, REAL_SUB_RZERO, REAL_MUL_LZERO] THEN
    REWRITE_TAC [REAL_MUL_LID, REAL_ADD_LID, REAL_ADD_RID] THEN
    CONV_TAC (← ExceptT.mk (GEN_SIMPLIFY_CONV TOP_DEPTH_SQCONV (← ExceptT.mk (basic_ss [])) 4
     [path_in, CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_RMUL,
      CONTINUOUS_MAP_ID, CONTINUOUS_MAP_REAL_SUB, CONTINUOUS_MAP_REAL_CONST,
      CONTINUOUS_MAP_FROM_SUBTOPOLOGY])) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
    X_GEN_TAC (← q r"t:real") THEN STRIP_TAC THENL
     [MATCH_MP_TAC (← REAL_ARITH (← q
       r"!x y:real.
         (a <= x /\ y <= b) /\ (x <= r /\ r <= y) ==> a <= r /\ r <= b")),
      MATCH_MP_TAC (← REAL_ARITH (← q
       r"!x y:real.
         (a < x /\ y < b) /\ (x <= r /\ r <= y) ==> a < r /\ r < b"))] THEN
    MAP_EVERY EXISTS_TAC [← q r"min x y:real", ← q r"max x y:real"] THEN
    (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH (← q
        r"(&0 <= t * (y - x) \/ &0 <= (&1 - t) * (x - y)) /\
         (&0 <= t * (x - y) \/ &0 <= (&1 - t) * (y - x))
         ==> min x y <= (&1 - t) * x + t * y /\
             (&1 - t) * x + t * y <= max x y")) THEN
    ASM_MESON_TAC [REAL_SUB_LE, REAL_LE_MUL,
                   ← REAL_ARITH (← q r"&0 <= x - y \/ &0 <= y - x")])

  return { path_in, PATH_IN_COMPOSE, PATH_IN_SUBTOPOLOGY, PATH_IN_CONST, path_connected_space,
           path_connected_in, PATH_CONNECTED_IN_ABSOLUTE, PATH_CONNECTED_IN_SUBSET_TOPSPACE,
           PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN, PATH_CONNECTED_IN_TOPSPACE,
           PATH_CONNECTED_IMP_CONNECTED_SPACE, PATH_CONNECTED_IN_IMP_CONNECTED_IN,
           PATH_CONNECTED_SPACE_TOPSPACE_EMPTY, PATH_CONNECTED_IN_EMPTY,
           PATH_CONNECTED_IN_SING, PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE,
           HOMEOMORPHIC_PATH_CONNECTED_SPACE, HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS,
           HOMEOMORPHIC_MAP_PATH_CONNECTEDNESS_EQ, PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
           PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE,
           PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- Paths and path-connectedness, continued.  (metric.ml 22768-22973)         -/
/- ------------------------------------------------------------------------- -/

structure Paths2 where
  PATH_CONNECTED_IN_PATH_IMAGE : thm
  CONNECTED_IN_PATH_IMAGE : thm
  COMPACT_IN_PATH_IMAGE : thm
  PATH_START_IN_TOPSPACE : thm
  PATH_FINISH_IN_TOPSPACE : thm
  PATH_IMAGE_SUBSET_TOPSPACE : thm
  PATH_CONNECTED_SPACE_SUBCONNECTED : thm
  PATH_CONNECTED_IN_EUCLIDEANREAL : thm
  PATH_CONNECTED_IN_DISCRETE_TOPOLOGY : thm
  PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY : thm
  PATH_CONNECTED_SPACE_PROD_TOPOLOGY : thm
  PATH_CONNECTED_IN_CROSS : thm
  PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY : thm
  PATH_CONNECTED_IN_CARTESIAN_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupPaths2 [HolBase] (D : MetricDeps) (BDiscrete : Discrete) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BProd1 : Prod1) (BProduct1 : Product1) (BProduct2 : Product2)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BConnected3 : Connected3)
    (BRealTop1 : RealTop1) (BRealConn1 : RealConn1) (BPaths1 : Paths1) :
    ExceptT String IO Paths2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV,
        .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, CROSS_EQ_EMPTY, ETA_AX, EXTENSIONAL, FORALL_IN_IMAGE,
        FUN_EQ_THM, IMAGE_FST_CROSS, .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SND_CROSS, IMP_CONJ, IMP_CONJ_ALT,
        INTER_EMPTY, INTER_UNIV, IN_CROSS, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM,
        MONO_FORALL, .. } := D.core2
  let { REAL_LE_MAX, REAL_LE_REFL, REAL_MIN_LE, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_REFL, SUBSET_UNIV,
        cartesian_product, o_DEF, o_THM, real_max, real_min, .. } := D.core4
  let { DE_MORGAN_THM, FORALL_PAIR_THM, NOT_EXISTS_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, is_realinterval, .. } := D.misc
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS,
        TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { SUBTOPOLOGY_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { CONNECTED_IN_DISCRETE_TOPOLOGY, .. } := BConnected3
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_EUCLIDEANREAL, .. } := BRealConn1
  let { PATH_CONNECTED_IN, PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_EMPTY,
        PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL, PATH_CONNECTED_IN_IMP_CONNECTED_IN,
        PATH_CONNECTED_IN_SING, PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_CONNECTED_IN_TOPSPACE,
        PATH_CONNECTED_SPACE_TOPSPACE_EMPTY, path_connected_in, path_connected_space, path_in,
        .. } := BPaths1
  -- @@SCOPE END

  let PATH_CONNECTED_IN_PATH_IMAGE ← prove
   r"!top g:real->A.
     path_in top g ==> path_connected_in top (IMAGE g (real_interval[&0,&1]))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_in] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
    EXISTS_TAC (← q r"subtopology euclideanreal (real_interval [&0,&1])") THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL])

  let CONNECTED_IN_PATH_IMAGE ← prove
   r"!top g:real->A.
     path_in top g ==> connected_in top (IMAGE g (real_interval[&0,&1]))"
   (SIMP_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN, PATH_CONNECTED_IN_PATH_IMAGE])

  let COMPACT_IN_PATH_IMAGE ← prove
   r"!top g:real->A.
     path_in top g ==> compact_in top (IMAGE g (real_interval[&0,&1]))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_in] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] IMAGE_COMPACT_IN) THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    REWRITE_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL])

  let PATH_START_IN_TOPSPACE ← prove
   r"!top g:real->A. path_in top g ==> g(&0) IN topspace top"
   (REWRITE_TAC [path_in, continuous_map] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [INTER_UNIV, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let PATH_FINISH_IN_TOPSPACE ← prove
   r"!top g:real->A. path_in top g ==> g(&1) IN topspace top"
   (REWRITE_TAC [path_in, continuous_map] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [INTER_UNIV, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let PATH_IMAGE_SUBSET_TOPSPACE ← prove
   r"!top g:real->A.
    path_in top g ==> IMAGE g (real_interval[&0,&1]) SUBSET topspace top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_in] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, INTER_UNIV, TOPSPACE_EUCLIDEANREAL])

  let PATH_CONNECTED_SPACE_SUBCONNECTED ← prove
   r"!top. path_connected_space top <=>
         !x y:A. x IN topspace top /\ y IN topspace top
                 ==> ?s. path_connected_in top s /\
                         x IN s /\
                         y IN s"
   (GEN_TAC THEN REWRITE_TAC [path_connected_space] THEN EQ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"y:A") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (g:real->A) (real_interval[&0,&1])") THEN
      ASM_SIMP_TAC [PATH_CONNECTED_IN_PATH_IMAGE, PATH_IMAGE_SUBSET_TOPSPACE] THEN
      REWRITE_TAC [IN_IMAGE, IN_REAL_INTERVAL] THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"&0"), EXISTS_TAC (← q r"&1")] THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [PATH_CONNECTED_IN]) THEN
      ASM_MESON_TAC []])

  let PATH_CONNECTED_IN_EUCLIDEANREAL ← prove
   r"!s. path_connected_in euclideanreal s <=> is_realinterval s"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONNECTED_IN_EUCLIDEANREAL, PATH_CONNECTED_IN_IMP_CONNECTED_IN],
      REWRITE_TAC [is_realinterval] THEN DISCH_TAC] THEN
    REWRITE_TAC [path_connected_in, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_SUBCONNECTED] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"real_interval[min x y,max x y]") THEN
    REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL, IN_REAL_INTERVAL,
                 PATH_CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [REAL_LE_MAX, REAL_MIN_LE, REAL_LE_REFL] THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    X_GEN_TAC (← q r"z:real") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"min x y:real", ← q r"max x y:real"] THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [real_min, real_max] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [])

  let PATH_CONNECTED_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool.
       path_connected_in (discrete_topology u) s <=>
       s SUBSET u /\ ?a. s SUBSET {a}"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN,
                 CONNECTED_IN_DISCRETE_TOPOLOGY],
      REWRITE_TAC [← SET_RULE (← q r"s SUBSET u /\ (?a. s SUBSET {a}) <=>
                            s = {} \/ ?a. a IN u /\ s = {a}")] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [PATH_CONNECTED_IN_EMPTY] THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_IN_SING, TOPSPACE_DISCRETE_TOPOLOGY]])

  let PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool.
        path_connected_space (discrete_topology u) <=>
        ?a. u SUBSET {a}"
   (REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE,
                 PATH_CONNECTED_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN SET_TAC [])

  let PATH_CONNECTED_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        path_connected_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        path_connected_space top1 /\ path_connected_space top2"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THEN
    ASM_SIMP_TAC [PATH_CONNECTED_SPACE_TOPSPACE_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY,
          CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    EQ_TAC THENL
     [REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN REPEAT STRIP_TAC THENL
       [MP_TAC (← ISPECL [← q r"FST:A#B->A", ← q r"prod_topology top1 top2:(A#B)topology",
                          ← q r"top1:A topology",
                          ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE),
        MP_TAC (← ISPECL [← q r"SND:A#B->B", ← q r"prod_topology top1 top2:(A#B)topology",
                          ← q r"top2:B topology",
                          ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE)] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN
      ASM_REWRITE_TAC [IMAGE_FST_CROSS, IMAGE_SND_CROSS],
      REWRITE_TAC [path_connected_space, NOT_EXISTS_THM] THEN STRIP_TAC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x1:A", ← q r"x2:B", ← q r"y1:A", ← q r"y2:B"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x2:B", ← q r"y2:B"]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x1:A", ← q r"y1:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g1:real->A") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"g2:real->B") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(\t. g1 t,g2 t):real->A#B") THEN
    ASM_REWRITE_TAC [path_in, CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX] THEN
    ASM_REWRITE_TAC [← GSYM path_in])

  let PATH_CONNECTED_IN_CROSS ← prove
   r"!top1 top2 s:A->bool t:B->bool.
        path_connected_in (prod_topology top1 top2) (s CROSS t) <=>
        s = {} \/ t = {} \/
        path_connected_in top1 s /\ path_connected_in top2 t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_connected_in, SUBTOPOLOGY_CROSS] THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_PROD_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CROSS, CROSS_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:B->bool) SUBSET topspace top2") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")])

  let PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!tops:K->A topology k.
        path_connected_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        !i. i IN k ==> path_connected_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [PATH_CONNECTED_SPACE_TOPSPACE_EMPTY] THEN EQ_TAC THENL
     [REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
        ISPECL [← q r"\(f:K->A). f i", ← q r"(tops:K->A topology) i"] o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
      REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM],
      DISCH_TAC] THEN
    REWRITE_TAC [path_connected_space, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:K->A", ← q r"y:K->A"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!i. ?g. i IN k
              ==> path_in ((tops:K->A topology) i) g /\
                  g(&0) = x i /\ g(&1) = y i")
    MP_TAC THENL
     [X_GEN_TAC (← q r"i:K") THEN ASM_CASES_TAC (← q r"(i:K) IN k") THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [path_connected_space] THEN DISCH_THEN MATCH_MP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, o_DEF, IN_ELIM_THM]) THEN
      ASM_SIMP_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"g:K->real->A") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\a i. if i IN k then (g:K->real->A) i a else ARB") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL
     [SIMP_TAC [path_in, CONTINUOUS_MAP_COMPONENTWISE] THEN
      SIMP_TAC [SUBSET, FORALL_IN_IMAGE, EXTENSIONAL, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [← GSYM path_in, ETA_AX],
      CONJ_TAC THENL
       [UNDISCH_TAC (← q r"(x:K->A) IN cartesian_product k (topspace o tops)"),
        UNDISCH_TAC (← q r"(y:K->A) IN cartesian_product k (topspace o tops)")] THEN
      SIMP_TAC [cartesian_product, EXTENSIONAL, IN_ELIM_THM] THEN
      REWRITE_TAC [FUN_EQ_THM, o_THM] THEN ASM_MESON_TAC []])

  let PATH_CONNECTED_IN_CARTESIAN_PRODUCT ← prove
   r"!tops:K->A topology s k.
        path_connected_in (product_topology k tops) (cartesian_product k s) <=>
        cartesian_product k s = {} \/
        !i. i IN k ==> path_connected_in (tops i) (s i)"
   (REWRITE_TAC [path_connected_in, SUBTOPOLOGY_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, o_DEF, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  return { PATH_CONNECTED_IN_PATH_IMAGE, CONNECTED_IN_PATH_IMAGE, COMPACT_IN_PATH_IMAGE,
           PATH_START_IN_TOPSPACE, PATH_FINISH_IN_TOPSPACE, PATH_IMAGE_SUBSET_TOPSPACE,
           PATH_CONNECTED_SPACE_SUBCONNECTED, PATH_CONNECTED_IN_EUCLIDEANREAL,
           PATH_CONNECTED_IN_DISCRETE_TOPOLOGY, PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY,
           PATH_CONNECTED_SPACE_PROD_TOPOLOGY, PATH_CONNECTED_IN_CROSS,
           PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY, PATH_CONNECTED_IN_CARTESIAN_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- Path components.  (metric.ml 22975-23192)                                 -/
/- ------------------------------------------------------------------------- -/

structure PathComp1 where
  path_component_of : thm
  path_components_of : thm
  PATH_COMPONENT_IN_TOPSPACE : thm
  PATH_COMPONENT_OF_REFL : thm
  PATH_COMPONENT_OF_SYM : thm
  PATH_COMPONENT_OF_TRANS : thm
  PATH_COMPONENT_OF_SUBTOPOLOGY : thm
  PATH_COMPONENT_OF_MONO : thm
  PATH_COMPONENT_OF : thm
  PATH_COMPONENT_OF_SET : thm
  PATH_COMPONENT_OF_SET_ALT : thm
  PATH_COMPONENT_OF_SUBTOPOLOGY_EQ : thm
  PATH_COMPONENTS_OF_SUBTOPOLOGY : thm
  PATH_COMPONENT_OF_SUBSET_TOPSPACE : thm
  PATH_COMPONENT_OF_EQ_EMPTY : thm
  PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT : thm
  PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF : thm
  PATH_CONNECTED_SPACE_PATH_COMPONENT_SET : thm
  PATH_COMPONENT_OF_MAXIMAL : thm
  PATH_COMPONENT_OF_EQUIV : thm
  PATH_COMPONENT_OF_DISJOINT : thm
  PATH_COMPONENT_OF_EQ : thm
  PATH_CONNECTED_IN_PATH_COMPONENT_OF : thm
  deriving Inhabited

@[nospecialize]
def setupPathComp1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BRealTop1 : RealTop1)
    (BRealCont : RealCont) (BPaths1 : Paths1) (BPaths2 : Paths2) :
    ExceptT String IO PathComp1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { DISJOINT, EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, IN, IN_ELIM_THM, IN_IMAGE, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM_EQ, o_DEF, o_THM, .. } := D.core4
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } :=
    BSubtopology
  let { CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONTINUOUS_MAP_CASES_LE, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_MUL,
        CONTINUOUS_MAP_REAL_SUB, .. } := BRealCont
  let { PATH_CONNECTED_IN, PATH_CONNECTED_IN_SUBTOPOLOGY, PATH_IN_CONST, PATH_IN_SUBTOPOLOGY,
        path_connected_in, path_connected_space, path_in, .. } := BPaths1
  let { PATH_CONNECTED_IN_PATH_IMAGE, .. } := BPaths2
  -- @@SCOPE END

  let path_component_of ← new_definition
   r"path_component_of top x y <=>
        ?g. path_in top g /\ g(&0) = x /\ g(&1) = y"

  let path_components_of ← new_definition
   r"path_components_of top = {path_component_of top x |x| x IN topspace top}"

  let PATH_COMPONENT_IN_TOPSPACE ← prove
   r"!top x y:A.
        path_component_of top x y ==> x IN topspace top /\ y IN topspace top"
   (REWRITE_TAC [path_component_of, path_in, continuous_map] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM)) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
    REAL_ARITH_TAC)

  let PATH_COMPONENT_OF_REFL ← prove
   r"!top x:A. path_component_of top x x <=> x IN topspace top"
   (REPEAT GEN_TAC THEN
    EQ_TAC THENL [MESON_TAC [PATH_COMPONENT_IN_TOPSPACE], DISCH_TAC] THEN
    REWRITE_TAC [path_component_of] THEN
    EXISTS_TAC (← q r"(\t. x):real->A") THEN ASM_REWRITE_TAC [PATH_IN_CONST])

  let PATH_COMPONENT_OF_SYM ← prove
   r"!top x y:A. path_component_of top x y <=> path_component_of top y x"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [path_component_of, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:real->A") THEN REWRITE_TAC [path_in] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(g:real->A) o (\t. &1 - t)") THEN
    REWRITE_TAC [o_THM] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"subtopology euclideanreal (real_interval [&0,&1])") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN
    (CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC]) THEN
    MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_ID])

  let PATH_COMPONENT_OF_TRANS ← prove
   r"!top x y z:A.
        path_component_of top x y /\ path_component_of top y z
        ==> path_component_of top x z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_component_of, path_in] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g1:real->A") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"g2:real->A") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC
     (← q r"\x. if x <= &1 / &2 then ((g1:real->A) o (\t. &2 * t)) x
          else (g2 o (\t. &2 * t - &1)) x") THEN
    REWRITE_TAC [o_THM] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONTINUOUS_MAP_CASES_LE THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"subtopology euclideanreal (real_interval [&0,&1])") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
          TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE, IN_INTER,
          IN_REAL_INTERVAL, IN_ELIM_THM] THEN
    (CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC]) THEN
    MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB) THEN REPEAT CONJ_TAC THEN
    REPEAT (MATCH_MP_TAC CONTINUOUS_MAP_REAL_MUL) THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_ID])

  let PATH_COMPONENT_OF_SUBTOPOLOGY ← prove
   r"!top s x y:A.
        path_component_of (subtopology top s) x y
        ==> path_component_of top x y"
   (REWRITE_TAC [path_component_of, PATH_IN_SUBTOPOLOGY] THEN
    MESON_TAC [])

  let PATH_COMPONENT_OF_MONO ← prove
   r"!top s t x y:A.
        path_component_of (subtopology top s) x y /\ s SUBSET t
        ==> path_component_of (subtopology top t) x y"
   (REWRITE_TAC [path_component_of, PATH_IN_SUBTOPOLOGY] THEN
    MESON_TAC [SUBSET])

  let PATH_COMPONENT_OF ← prove
   r"!top x y:A.
        path_component_of top x y <=>
        ?t. path_connected_in top t /\ x IN t /\ y IN t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [path_component_of] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [PATH_CONNECTED_IN]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (g:real->A) (real_interval[&0,&1])") THEN
    ASM_SIMP_TAC [PATH_CONNECTED_IN_PATH_IMAGE] THEN
    REPEAT (FIRST_X_ASSUM (SUBST1_TAC o SYM)) THEN CONJ_TAC THEN
    MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let PATH_COMPONENT_OF_SET ← prove
   r"!top x:A.
        path_component_of top x =
        {y | ?g. path_in top g /\ g(&0) = x /\ g(&1) = y}"
   (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [IN, path_component_of])

  let PATH_COMPONENT_OF_SET_ALT ← prove
   r"!top x:A.
         path_component_of top x =
         {y | ?t. path_connected_in top t /\ x IN t /\ y IN t}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    REWRITE_TAC [PATH_COMPONENT_OF, IN_ELIM_THM])

  let PATH_COMPONENT_OF_SUBTOPOLOGY_EQ ← prove
   r"!top u x:A.
      path_component_of (subtopology top u) x =
      path_component_of top x <=>
      path_component_of top x SUBSET u"
   (REWRITE_TAC [PATH_COMPONENT_OF_SET_ALT, PATH_CONNECTED_IN_SUBTOPOLOGY] THEN
    SET_TAC [])

  let PATH_COMPONENTS_OF_SUBTOPOLOGY ← prove
   r"!top u c:A->bool.
        c IN path_components_of top /\ c SUBSET u
        ==> c IN path_components_of (subtopology top u)"
   (GEN_TAC THEN GEN_TAC THEN
    SIMP_TAC [path_components_of, IMP_CONJ, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"x:A") THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:A") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [PATH_COMPONENT_OF_REFL, IN], DISCH_TAC] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"x:A") THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    ASM_MESON_TAC [PATH_COMPONENT_OF_SUBTOPOLOGY_EQ])

  let PATH_COMPONENT_OF_SUBSET_TOPSPACE ← prove
   r"!top x. (path_component_of top x) SUBSET topspace top"
   (REWRITE_TAC [SUBSET, IN] THEN MESON_TAC [PATH_COMPONENT_IN_TOPSPACE, IN])

  let PATH_COMPONENT_OF_EQ_EMPTY ← prove
   r"!top x. path_component_of top x = {} <=> ~(x IN topspace top)"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [IN, PATH_COMPONENT_OF_REFL, PATH_COMPONENT_IN_TOPSPACE])

  let PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT ← prove
   r"!top:A topology.
        path_connected_space top <=>
        !x y. x IN topspace top /\ y IN topspace top
              ==> path_component_of top x y"
   (REWRITE_TAC [path_connected_space, path_component_of])

  let PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF ← prove
   r"!top a b:A.
        path_connected_space top /\ a IN topspace top /\ b IN topspace top
        ==> path_component_of top a b"
   (MESON_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT])

  let PATH_CONNECTED_SPACE_PATH_COMPONENT_SET ← prove
   r"!top. path_connected_space top <=>
         !x:A. x IN topspace top ==> path_component_of top x = topspace top"
   (REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT,
                 ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_SUBSET_TOPSPACE] THEN SET_TAC [])

  let PATH_COMPONENT_OF_MAXIMAL ← prove
   r"!top s x:A.
     path_connected_in top s /\ x IN s ==> s SUBSET (path_component_of top x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PATH_CONNECTED_IN] THEN STRIP_TAC THEN
    REWRITE_TAC [SUBSET, PATH_COMPONENT_OF_SET, IN_ELIM_THM] THEN
    ASM_MESON_TAC [])

  let PATH_COMPONENT_OF_EQUIV ← prove
   r"!top x y:A.
        path_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        path_component_of top x = path_component_of top y"
   (REWRITE_TAC [FUN_EQ_THM] THEN
    MESON_TAC [PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_TRANS,
               PATH_COMPONENT_OF_SYM])

  let PATH_COMPONENT_OF_DISJOINT ← prove
   r"!top x y:A.
        DISJOINT (path_component_of top x) (path_component_of top y) <=>
        ~(path_component_of top x y)"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    REWRITE_TAC [IN] THEN
    MESON_TAC [PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS])

  let PATH_COMPONENT_OF_EQ ← prove
   r"!top x y:A.
        path_component_of top x = path_component_of top y <=>
        ~(x IN topspace top) /\ ~(y IN topspace top) \/
        x IN topspace top /\ y IN topspace top /\ path_component_of top x y"
   (MESON_TAC [PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_EQUIV,
               PATH_COMPONENT_OF_EQ_EMPTY])

  let PATH_CONNECTED_IN_PATH_COMPONENT_OF ← prove
   r"!top x:A. path_connected_in top (path_component_of top x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_connected_in, PATH_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, PATH_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN path_component_of top (x:A)
          ==> path_component_of (subtopology top (path_component_of top x)) x y")
    MP_TAC THENL
     [X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN],
      MESON_TAC [PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS]] THEN
    REWRITE_TAC [path_component_of] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"g:real->A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [PATH_IN_SUBTOPOLOGY, ← SET_RULE (← q
     r"(!x. x IN s ==> f x IN t) <=> IMAGE f s SUBSET t")] THEN
    MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
    ASM_SIMP_TAC [PATH_CONNECTED_IN_PATH_IMAGE, IN_IMAGE] THEN
    EXISTS_TAC (← q r"&0:real") THEN ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  return { path_component_of, path_components_of, PATH_COMPONENT_IN_TOPSPACE,
           PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS,
           PATH_COMPONENT_OF_SUBTOPOLOGY, PATH_COMPONENT_OF_MONO, PATH_COMPONENT_OF,
           PATH_COMPONENT_OF_SET, PATH_COMPONENT_OF_SET_ALT, PATH_COMPONENT_OF_SUBTOPOLOGY_EQ,
           PATH_COMPONENTS_OF_SUBTOPOLOGY, PATH_COMPONENT_OF_SUBSET_TOPSPACE,
           PATH_COMPONENT_OF_EQ_EMPTY, PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT,
           PATH_CONNECTED_SPACE_IMP_PATH_COMPONENT_OF, PATH_CONNECTED_SPACE_PATH_COMPONENT_SET,
           PATH_COMPONENT_OF_MAXIMAL, PATH_COMPONENT_OF_EQUIV, PATH_COMPONENT_OF_DISJOINT,
           PATH_COMPONENT_OF_EQ, PATH_CONNECTED_IN_PATH_COMPONENT_OF }

/- ------------------------------------------------------------------------- -/
/- Path components, continued.  (metric.ml 23194-23400)                      -/
/- ------------------------------------------------------------------------- -/

structure PathComp2 where
  UNIONS_PATH_COMPONENTS_OF : thm
  PATH_COMPONENTS_OF_MAXIMAL : thm
  PAIRWISE_DISJOINT_PATH_COMPONENTS_OF : thm
  COMPLEMENT_PATH_COMPONENTS_OF_UNIONS : thm
  NONEMPTY_PATH_COMPONENTS_OF : thm
  PATH_COMPONENTS_OF_SUBSET : thm
  PATH_CONNECTED_IN_PATH_COMPONENTS_OF : thm
  PATH_COMPONENT_IN_PATH_COMPONENTS_OF : thm
  PATH_CONNECTED_IN_UNIONS : thm
  PATH_CONNECTED_IN_UNION : thm
  PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ : thm
  PATH_COMPONENTS_OF_EQ_EMPTY : thm
  PATH_COMPONENTS_OF_EMPTY_SPACE : thm
  PATH_COMPONENTS_OF_SUBSET_SING : thm
  PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING : thm
  PATH_COMPONENTS_OF_EQ_SING : thm
  PATH_COMPONENTS_OF_PATH_CONNECTED_SPACE : thm
  PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF : thm
  PATH_IMP_CONNECTED_COMPONENT_OF : thm
  EXISTS_PATH_COMPONENT_OF_SUPERSET : thm
  PATH_COMPONENT_OF_EQ_OVERLAP : thm
  PATH_COMPONENT_OF_NONOVERLAP : thm
  PATH_COMPONENT_OF_OVERLAP : thm
  PATH_COMPONENTS_OF_DISJOINT : thm
  deriving Inhabited

@[nospecialize]
def setupPathComp2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BComponents1 : Components1) (BPaths1 : Paths1) (BPathComp1 : PathComp1) :
    ExceptT String IO PathComp2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_UNIONS_PAIRWISE_DISJOINT, DISJOINT, EMPTY_SUBSET, ETA_AX, FORALL_IN_GSPEC,
        FORALL_IN_UNIONS, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, INTERS_2, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM,
        UNIONS_1, UNIONS_2, UNIONS_GSPEC, UNIONS_SUBSET, pairwise, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONNECTED_COMPONENT_OF_MAXIMAL, .. } := BComponents1
  let { PATH_CONNECTED_IN_IMP_CONNECTED_IN, PATH_IN_SUBTOPOLOGY, path_connected_in,
        .. } := BPaths1
  let { PATH_COMPONENT_IN_TOPSPACE, PATH_COMPONENT_OF_DISJOINT, PATH_COMPONENT_OF_EQ,
        PATH_COMPONENT_OF_EQUIV, PATH_COMPONENT_OF_EQ_EMPTY, PATH_COMPONENT_OF_MAXIMAL,
        PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_SUBSET_TOPSPACE, PATH_COMPONENT_OF_SYM,
        PATH_COMPONENT_OF_TRANS, PATH_CONNECTED_IN_PATH_COMPONENT_OF,
        PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT, path_component_of, path_components_of,
        .. } := BPathComp1
  -- @@SCOPE END

  let UNIONS_PATH_COMPONENTS_OF ← prove
   r"!top:A topology. UNIONS (path_components_of top) = topspace top"
   (GEN_TAC THEN REWRITE_TAC [path_components_of] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC,
                 PATH_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:A") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [PATH_COMPONENT_OF_REFL])

  let PATH_COMPONENTS_OF_MAXIMAL ← prove
   r"!top s c:A->bool.
        c IN path_components_of top /\ path_connected_in top s /\ ~DISJOINT c s
        ==> s SUBSET c"
   (REWRITE_TAC [path_components_of, IMP_CONJ, FORALL_IN_GSPEC,
      LEFT_IMP_EXISTS_THM, ← SET_RULE (← q r"~DISJOINT P t <=> ?x. P x /\ x IN t")] THEN
    SIMP_TAC [PATH_COMPONENT_OF_EQUIV] THEN
    MESON_TAC [PATH_COMPONENT_OF_MAXIMAL])

  let PAIRWISE_DISJOINT_PATH_COMPONENTS_OF ← prove
   r"!top:A topology. pairwise DISJOINT (path_components_of top)"
   (SIMP_TAC [pairwise, IMP_CONJ, path_components_of, RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [PATH_COMPONENT_OF_EQ, PATH_COMPONENT_OF_DISJOINT])

  let COMPLEMENT_PATH_COMPONENTS_OF_UNIONS ← prove
   r"!top c:A->bool.
        c IN path_components_of top
        ==> topspace top DIFF c = UNIONS (path_components_of top DELETE c)"
   (REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
    ASM_SIMP_TAC [← GSYM DIFF_UNIONS_PAIRWISE_DISJOINT,
                  PAIRWISE_DISJOINT_PATH_COMPONENTS_OF, SING_SUBSET] THEN
    REWRITE_TAC [UNIONS_PATH_COMPONENTS_OF, UNIONS_1])

  let NONEMPTY_PATH_COMPONENTS_OF ← prove
   r"!top c:A->bool. c IN path_components_of top ==> ~(c = {})"
   (SIMP_TAC [path_components_of, FORALL_IN_GSPEC, PATH_COMPONENT_OF_EQ_EMPTY])

  let PATH_COMPONENTS_OF_SUBSET ← prove
   r"!top c:A->bool. c IN path_components_of top ==> c SUBSET topspace top"
   (SIMP_TAC [path_components_of, FORALL_IN_GSPEC,
              PATH_COMPONENT_OF_SUBSET_TOPSPACE])

  let PATH_CONNECTED_IN_PATH_COMPONENTS_OF ← prove
   r"!top c:A->bool. c IN path_components_of top ==> path_connected_in top c"
   (REWRITE_TAC [path_components_of, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_PATH_COMPONENT_OF])

  let PATH_COMPONENT_IN_PATH_COMPONENTS_OF ← prove
   r"!top a:A.
        path_component_of top a IN path_components_of top <=>
        a IN topspace top"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [← GSYM PATH_COMPONENT_OF_EQ_EMPTY] THEN
      MESON_TAC [NONEMPTY_PATH_COMPONENTS_OF],
      REWRITE_TAC [path_components_of] THEN SET_TAC []])

  let PATH_CONNECTED_IN_UNIONS ← prove
   r"!top u:(A->bool)->bool.
        (!s. s IN u ==> path_connected_in top s) /\ ~(INTERS u = {})
        ==> path_connected_in top (UNIONS u)"
   (REWRITE_TAC [path_connected_in] THEN SIMP_TAC [UNIONS_SUBSET] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN topspace (subtopology top (UNIONS u))
          ==> path_component_of (subtopology top (UNIONS u)) (a:A) x")
    MP_TAC THENL
     [REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IMP_CONJ_ALT, IN_INTER],
      ASM_MESON_TAC [PATH_COMPONENT_OF_SYM, PATH_COMPONENT_OF_TRANS]] THEN
    REWRITE_TAC [FORALL_IN_UNIONS] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"b:A"] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPECL [← q r"a:A", ← q r"b:A"])) THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, path_component_of, PATH_IN_SUBTOPOLOGY] THEN
    ASM SET_TAC [])

  let PATH_CONNECTED_IN_UNION ← prove
   r"!top s t:A->bool.
        path_connected_in top s /\ path_connected_in top t /\ ~(s INTER t = {})
        ==> path_connected_in top (s UNION t)"
   (REWRITE_TAC [← GSYM UNIONS_2, ← GSYM INTERS_2] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC PATH_CONNECTED_IN_UNIONS THEN
    ASM SET_TAC [])

  let PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ ← prove
   r"!top:A topology.
        path_connected_space top <=>
        !c c'. c IN path_components_of top /\
               c' IN path_components_of top
               ==> c = c'"
   (REWRITE_TAC [path_components_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT] THEN
    SIMP_TAC [PATH_COMPONENT_OF_EQ] THEN MESON_TAC [])

  let PATH_COMPONENTS_OF_EQ_EMPTY ← prove
   r"!top:A topology. path_components_of top = {} <=> topspace top = {}"
   (REWRITE_TAC [path_components_of] THEN SET_TAC [])

  let PATH_COMPONENTS_OF_EMPTY_SPACE ← prove
   r"!top:A topology. topspace top = {} ==> path_components_of top = {}"
   (REWRITE_TAC [PATH_COMPONENTS_OF_EQ_EMPTY])

  let PATH_COMPONENTS_OF_SUBSET_SING ← prove
   r"!top s:A->bool.
        path_components_of top SUBSET {s} <=>
        path_connected_space top /\ (topspace top = {} \/ topspace top = s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ, ← SET_RULE (← q
     r"(!x y. x IN s /\ y IN s ==> x = y) <=> s = {} \/ ?a. s = {a}")] THEN
    ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [PATH_COMPONENTS_OF_EMPTY_SPACE, EMPTY_SUBSET] THEN
    ASM_REWRITE_TAC [PATH_COMPONENTS_OF_EQ_EMPTY, ← SET_RULE (← q
     r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    MESON_TAC [UNIONS_PATH_COMPONENTS_OF, UNIONS_1])

  let PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING ← prove
   r"!top:A topology.
        path_connected_space top <=> ?a. path_components_of top SUBSET {a}"
   (MESON_TAC [PATH_COMPONENTS_OF_SUBSET_SING])

  let PATH_COMPONENTS_OF_EQ_SING ← prove
   r"!top s:A->bool.
        path_components_of top = {s} <=>
        path_connected_space top /\ ~(topspace top = {}) /\ s = topspace top"
   (REWRITE_TAC [PATH_COMPONENTS_OF_SUBSET_SING,
                 PATH_COMPONENTS_OF_EQ_EMPTY,
                 ← SET_RULE (← q r"s = {a} <=> s SUBSET {a} /\ ~(s = {})")] THEN
    MESON_TAC [])

  let PATH_COMPONENTS_OF_PATH_CONNECTED_SPACE ← prove
   r"!top:A topology.
        path_connected_space top
        ==> path_components_of top =
            if topspace top = {} then {} else {topspace top}"
   (ASM_MESON_TAC [PATH_COMPONENTS_OF_EMPTY_SPACE,
                   PATH_COMPONENTS_OF_EQ_SING])

  let PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF ← prove
   r"!top x:A. path_component_of top x SUBSET connected_component_of top x"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      SIMP_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN,
                PATH_CONNECTED_IN_PATH_COMPONENT_OF] THEN
      REWRITE_TAC [IN] THEN ASM_REWRITE_TAC [PATH_COMPONENT_OF_REFL],
      ASM_MESON_TAC [PATH_COMPONENT_OF_EQ_EMPTY, EMPTY_SUBSET]])

  let PATH_IMP_CONNECTED_COMPONENT_OF ← prove
   r"!top x y:A. path_component_of top x y ==> connected_component_of top x y"
   (GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [← SET_RULE (← q r"(!y. P y ==> Q y) <=> P SUBSET Q")] THEN
    REWRITE_TAC [ETA_AX, PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF])

  let EXISTS_PATH_COMPONENT_OF_SUPERSET ← prove
   r"!top s:A->bool.
        path_connected_in top s /\ ~(topspace top = {})
        ==> ?c. c IN path_components_of top /\ s SUBSET c"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [ASM_REWRITE_TAC [EMPTY_SUBSET, MEMBER_NOT_EMPTY] THEN
      ASM_REWRITE_TAC [PATH_COMPONENTS_OF_EQ_EMPTY],
      UNDISCH_TAC (← q r"~(s:A->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"path_component_of top (a:A)") THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [path_connected_in]) THEN
      REWRITE_TAC [PATH_COMPONENT_IN_PATH_COMPONENTS_OF] THEN ASM SET_TAC [],
      MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC []])

  let PATH_COMPONENT_OF_EQ_OVERLAP ← prove
   r"!top x y:A.
      path_component_of top x = path_component_of top y <=>
      ~(x IN topspace top) /\ ~(y IN topspace top) \/
      ~(path_component_of top x INTER path_component_of top y = {})"
   (REWRITE_TAC [← GSYM DISJOINT, PATH_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EQ] THEN
    MESON_TAC [PATH_COMPONENT_IN_TOPSPACE])

  let PATH_COMPONENT_OF_NONOVERLAP ← prove
   r"!top x y:A.
     path_component_of top x INTER path_component_of top y = {} <=>
     ~(x IN topspace top) \/ ~(y IN topspace top) \/
     ~(path_component_of top x = path_component_of top y)"
   (REWRITE_TAC [← GSYM DISJOINT, PATH_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EQ] THEN
    MESON_TAC [PATH_COMPONENT_IN_TOPSPACE])

  let PATH_COMPONENT_OF_OVERLAP ← prove
   r"!top x y:A.
    ~(path_component_of top x INTER path_component_of top y = {}) <=>
    x IN topspace top /\ y IN topspace top /\
    path_component_of top x = path_component_of top y"
   (REWRITE_TAC [← GSYM DISJOINT, PATH_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EQ] THEN
    MESON_TAC [PATH_COMPONENT_IN_TOPSPACE])

  let PATH_COMPONENTS_OF_DISJOINT ← prove
   r"!top c c'.
        c IN path_components_of top /\ c' IN path_components_of top
        ==> (DISJOINT c c' <=> ~(c = c'))"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, path_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, PATH_COMPONENT_OF_NONOVERLAP])

  return { UNIONS_PATH_COMPONENTS_OF, PATH_COMPONENTS_OF_MAXIMAL,
           PAIRWISE_DISJOINT_PATH_COMPONENTS_OF, COMPLEMENT_PATH_COMPONENTS_OF_UNIONS,
           NONEMPTY_PATH_COMPONENTS_OF, PATH_COMPONENTS_OF_SUBSET,
           PATH_CONNECTED_IN_PATH_COMPONENTS_OF, PATH_COMPONENT_IN_PATH_COMPONENTS_OF,
           PATH_CONNECTED_IN_UNIONS, PATH_CONNECTED_IN_UNION,
           PATH_CONNECTED_SPACE_IFF_COMPONENTS_EQ, PATH_COMPONENTS_OF_EQ_EMPTY,
           PATH_COMPONENTS_OF_EMPTY_SPACE, PATH_COMPONENTS_OF_SUBSET_SING,
           PATH_CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING, PATH_COMPONENTS_OF_EQ_SING,
           PATH_COMPONENTS_OF_PATH_CONNECTED_SPACE,
           PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF, PATH_IMP_CONNECTED_COMPONENT_OF,
           EXISTS_PATH_COMPONENT_OF_SUPERSET, PATH_COMPONENT_OF_EQ_OVERLAP,
           PATH_COMPONENT_OF_NONOVERLAP, PATH_COMPONENT_OF_OVERLAP,
           PATH_COMPONENTS_OF_DISJOINT }

/- ------------------------------------------------------------------------- -/
/- Path components, continued.  (metric.ml 23402-23593)                      -/
/- ------------------------------------------------------------------------- -/

structure PathComp3 where
  PATH_COMPONENTS_OF_OVERLAP : thm
  CARD_LE_PATH_COMPONENTS_OF_TOPSPACE : thm
  FINITE_PATH_COMPONENTS_OF_FINITE : thm
  PATH_COMPONENT_OF_UNIQUE : thm
  PATH_COMPONENT_OF_DISCRETE_TOPOLOGY : thm
  PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY : thm
  PATH_COMPONENT_OF_CONTINUOUS_IMAGE : thm
  HOMEOMORPHIC_MAP_PATH_COMPONENT_OF : thm
  HOMEOMORPHIC_MAP_PATH_COMPONENTS_OF : thm
  PATH_COMPONENT_OF_PAIR : thm
  PATH_COMPONENTS_OF_PROD_TOPOLOGY : thm
  PATH_COMPONENT_OF_PRODUCT_TOPOLOGY : thm
  PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupPathComp3 [HolBase] (D : MetricDeps) (BDiscrete : Discrete) (BContMap1 : ContMap1)
    (BProd1 : Prod1) (BProduct1 : Product1) (BProduct2 : Product2) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BPaths1 : Paths1) (BPaths2 : Paths2) (BPathComp1 : PathComp1)
    (BPathComp2 : PathComp2) : ExceptT String IO PathComp3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY, CONJ_ASSOC, CROSS, CROSS_EQ_EMPTY,
        DISJOINT, EXTENSION, EXTENSIONAL, FORALL_IN_GSPEC, IMAGE_EQ, .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IN, IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER,
        IN_SING, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { RESTRICTION, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM, SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_TRANS, UNWIND_THM2,
        cartesian_product, o_DEF, o_THM, .. } := D.core4
  let { DE_MORGAN_THM, EXISTS_PAIR_THM, FORALL_PAIR_THM, LEFT_AND_EXISTS_THM,
        RIGHT_IMP_EXISTS_THM, SWAP_EXISTS_THM, .. } := D.core5
  let { CARD_LE_FINITE, CARD_LE_RELATIONAL_FULL, .. } := D.lib
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { HOMEOMORPHIC_IMP_SURJECTIVE_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_SUBSET_TOPSPACE,
        PATH_IN_COMPOSE, .. } := BPaths1
  let { PATH_CONNECTED_IN_CARTESIAN_PRODUCT, PATH_CONNECTED_IN_CROSS,
        PATH_CONNECTED_IN_DISCRETE_TOPOLOGY, .. } := BPaths2
  let { PATH_COMPONENT_IN_TOPSPACE, PATH_COMPONENT_OF, PATH_COMPONENT_OF_EQ_EMPTY,
        PATH_COMPONENT_OF_MAXIMAL, PATH_COMPONENT_OF_REFL, PATH_CONNECTED_IN_PATH_COMPONENT_OF,
        path_component_of, path_components_of, .. } := BPathComp1
  let { NONEMPTY_PATH_COMPONENTS_OF, PATH_COMPONENTS_OF_SUBSET, PATH_COMPONENT_OF_NONOVERLAP,
        .. } := BPathComp2
  -- @@SCOPE END

  let PATH_COMPONENTS_OF_OVERLAP ← prove
   r"!top c c'.
        c IN path_components_of top /\ c' IN path_components_of top
        ==> (~(c INTER c' = {}) <=> c = c')"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, path_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, PATH_COMPONENT_OF_NONOVERLAP])

  let CARD_LE_PATH_COMPONENTS_OF_TOPSPACE ← prove
   r"!top:A topology. path_components_of top <=_c topspace top"
   (GEN_TAC THEN MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"(IN):A->(A->bool)->bool") THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENTS_OF_SUBSET) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_PATH_COMPONENTS_OF) THEN
      SET_TAC [],
      MESON_TAC [← REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY, IN_INTER]
                  PATH_COMPONENTS_OF_OVERLAP]])

  let FINITE_PATH_COMPONENTS_OF_FINITE ← prove
   r"!top:A topology.
        FINITE(topspace top) ==> FINITE(path_components_of top)"
   (GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_FINITE) THEN
    REWRITE_TAC [CARD_LE_PATH_COMPONENTS_OF_TOPSPACE])

  let PATH_COMPONENT_OF_UNIQUE ← prove
   r"!top c x:A.
        x IN c /\ path_connected_in top c /\
        (!c'. x IN c' /\ path_connected_in top c' ==> c' SUBSET c)
        ==> path_component_of top x = c"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← SET_RULE (← q r"R = s <=> !x. R x <=> x IN s")] THEN
    REWRITE_TAC [PATH_COMPONENT_OF] THEN ASM SET_TAC [])

  let PATH_COMPONENT_OF_DISCRETE_TOPOLOGY ← prove
   r"!u x:A. path_component_of (discrete_topology u) x =
           if x IN u then {x} else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [PATH_COMPONENT_OF_EQ_EMPTY,
                     TOPSPACE_DISCRETE_TOPOLOGY] THEN
    MATCH_MP_TAC PATH_COMPONENT_OF_UNIQUE THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_IN_DISCRETE_TOPOLOGY,
                     IN_SING, SING_SUBSET] THEN
    SET_TAC [])

  let PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool.
        path_components_of (discrete_topology u) = {{x} | x IN u}"
   (GEN_TAC THEN REWRITE_TAC [path_components_of] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY,
                 PATH_COMPONENT_OF_DISCRETE_TOPOLOGY] THEN
    SET_TAC [])

  let PATH_COMPONENT_OF_CONTINUOUS_IMAGE ← prove
   r"!top top' (f:A->B) x y.
        continuous_map(top,top') f /\
        path_component_of top x y
        ==> path_component_of top' (f x) (f y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [path_component_of] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"(f:A->B) o (g:real->A)") THEN ASM_REWRITE_TAC [o_THM] THEN
    ASM_MESON_TAC [PATH_IN_COMPOSE])

  let HOMEOMORPHIC_MAP_PATH_COMPONENT_OF ← prove
   r"!(f:A->B) top top' x.
        homeomorphic_map(top,top') f /\ x IN topspace top
        ==> path_component_of top' (f x) =
            IMAGE f (path_component_of top x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g:B->A") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE] THEN REWRITE_TAC [IN] THEN
    MP_TAC (← ISPEC (← q r"top':B topology") PATH_COMPONENT_IN_TOPSPACE) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B"]
          PATH_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology", ← q r"g:B->A"]
          PATH_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT
     (FIRST_X_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_PATH_COMPONENTS_OF ← prove
   r"!(f:A->B) top top'.
      homeomorphic_map(top,top') f
      ==> path_components_of top' = IMAGE (IMAGE f) (path_components_of top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [path_components_of, SIMPLE_IMAGE] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN MATCH_MP_TAC IMAGE_EQ THEN
    REWRITE_TAC [] THEN ASM_MESON_TAC [HOMEOMORPHIC_MAP_PATH_COMPONENT_OF])

  let PATH_COMPONENT_OF_PAIR ← prove
   r"!top1 top2 (x:A) (y:B).
        path_component_of (prod_topology top1 top2) (x,y) =
        path_component_of top1 x CROSS path_component_of top2 y"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
     r"(s = {} <=> t = {}) /\ (~(s = {}) ==> (s = t)) ==> s = t")) THEN
    REWRITE_TAC [CROSS_EQ_EMPTY, PATH_COMPONENT_OF_EQ_EMPTY,
                 TOPSPACE_PROD_TOPOLOGY, IN_CROSS, DE_MORGAN_THM] THEN
    STRIP_TAC THEN MATCH_MP_TAC PATH_COMPONENT_OF_UNIQUE THEN
    SIMP_TAC [PATH_CONNECTED_IN_CROSS, PATH_CONNECTED_IN_PATH_COMPONENT_OF] THEN
    REWRITE_TAC [IN_CROSS] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_REFL] THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"c:A#B->bool") THEN STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS (← q r"(IMAGE FST c CROSS IMAGE SND c):A#B->bool") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC [],
      REWRITE_TAC [SUBSET_CROSS] THEN REPEAT DISJ2_TAC THEN
      CONJ_TAC THEN MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []]) THEN
      MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND]])

  let PATH_COMPONENTS_OF_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        path_components_of (prod_topology top1 top2) =
        {c1 CROSS c2 | c1 IN path_components_of top1 /\
                       c2 IN path_components_of top2}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_components_of, TOPSPACE_PROD_TOPOLOGY, CROSS] THEN
    REWRITE_TAC [← SET_RULE (← q r"{f z | z IN {x,y | P x y}} = {f(x,y) | P x y}")] THEN
    REWRITE_TAC [← GSYM CROSS, PATH_COMPONENT_OF_PAIR] THEN SET_TAC [])

  let PATH_COMPONENT_OF_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology) x.
        path_component_of (product_topology k tops) x =
        if EXTENSIONAL k x
        then cartesian_product k (\i. path_component_of (tops i) (x i))
        else {}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
     r"(s = {} <=> t = {}) /\ (~(s = {}) ==> (s = t)) ==> s = t")) THEN
    REWRITE_TAC [← MESON [] (← q r"(if p then x else y) = y <=> p ==> x = y")] THEN
    REWRITE_TAC [PATH_COMPONENT_OF_EQ_EMPTY, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM] THEN
    REWRITE_TAC [o_THM, ← GSYM cartesian_product] THEN
    CONJ_TAC THENL [MESON_TAC [], STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC PATH_COMPONENT_OF_UNIQUE THEN
    SIMP_TAC [PATH_CONNECTED_IN_CARTESIAN_PRODUCT,
              PATH_CONNECTED_IN_PATH_COMPONENT_OF] THEN
    ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [PATH_COMPONENT_OF_REFL, IN], ALL_TAC] THEN
    X_GEN_TAC (← q r"c:(K->A)->bool") THEN STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"cartesian_product k (\i. IMAGE (\x. x i) c):(K->A)->bool") THEN
    REWRITE_TAC [← GSYM cartesian_product, SUBSET_CARTESIAN_PRODUCT] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP PATH_CONNECTED_IN_SUBSET_TOPSPACE) THEN
      REWRITE_TAC [SUBSET, cartesian_product, IN_ELIM_THM,
                   TOPSPACE_PRODUCT_TOPOLOGY, o_THM, IN_IMAGE] THEN
      ASM_MESON_TAC [],
      DISJ2_TAC THEN X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
      MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
      REWRITE_TAC [IN_IMAGE] THEN CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION]])

  let PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology).
        path_components_of (product_topology k tops) =
        { cartesian_product k c |c|
          !i. i IN k ==> c i IN path_components_of(tops i)}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [path_components_of, PATH_COMPONENT_OF_PRODUCT_TOPOLOGY] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. x IN s ==> p x) /\ {cartesian_product k y | y IN IMAGE f s} = t
      ==> {if p x then cartesian_product k (f x) else z | x IN s} = t")) THEN
    CONJ_TAC THENL
     [SIMP_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM],
      ALL_TAC] THEN
    REWRITE_TAC [IN_ELIM_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    REWRITE_TAC [IN_IMAGE, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM cartesian_product, o_THM] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← SET_RULE (← q
       r"(!x. P x ==> Q x) ==> {f x | P x} SUBSET {f x | Q x}")) THEN
      GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"c:K->A->bool") THEN DISCH_THEN (X_CHOOSE_TAC (← q r"x:K->A")) THEN
      REWRITE_TAC [IN_ELIM_THM, CARTESIAN_PRODUCT_EQ] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2] THEN
      EXISTS_TAC (← q r"RESTRICTION k (x:K->A)") THEN
      SIMP_TAC [RESTRICTION, EXTENSIONAL, IN_ELIM_THM] THEN
      ASM_MESON_TAC []])

  return { PATH_COMPONENTS_OF_OVERLAP, CARD_LE_PATH_COMPONENTS_OF_TOPSPACE,
           FINITE_PATH_COMPONENTS_OF_FINITE, PATH_COMPONENT_OF_UNIQUE,
           PATH_COMPONENT_OF_DISCRETE_TOPOLOGY, PATH_COMPONENTS_OF_DISCRETE_TOPOLOGY,
           PATH_COMPONENT_OF_CONTINUOUS_IMAGE, HOMEOMORPHIC_MAP_PATH_COMPONENT_OF,
           HOMEOMORPHIC_MAP_PATH_COMPONENTS_OF, PATH_COMPONENT_OF_PAIR,
           PATH_COMPONENTS_OF_PROD_TOPOLOGY, PATH_COMPONENT_OF_PRODUCT_TOPOLOGY,
           PATH_COMPONENTS_OF_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Special characterizations of classes of functions into and out of R.     -/
/- (metric.ml 23595-23811)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealFns1 where
  EMBEDDING_MAP_INTO_EUCLIDEANREAL : thm
  MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupRealFns1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BEmbedding : Embedding) (BCompact1 : Compact1)
    (BHausdorff2 : Hausdorff2) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BConnected1 : Connected1) (BConnected3 : Connected3) (BMonotone : Monotone)
    (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BRealConn1 : RealConn1)
    (BMetricCont : MetricCont) (BPaths1 : Paths1) (BPaths2 : Paths2) :
    ExceptT String IO RealFns1 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { CONJ_ASSOC, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INJECTIVE_ON_LEFT_INVERSE, INTER_ACI, INTER_UNIV, IN_ELIM_THM,
        IN_GSPEC, IN_INTER, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { REAL_LE_LT, REAL_LT_MIN, .. } := D.core3
  let { REAL_WLOG_LE, SUBSET, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS, SUBSET_UNIV,
        UNION_COMM, real_ge, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_CONTAINS_INTERVAL, IS_REALINTERVAL_SING,
        IS_REALINTERVAL_UNIV, is_realinterval, .. } := D.misc
  let { CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_UNION, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { embedding_map, .. } := BEmbedding
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { CONTINUOUS_INVERSE_MAP, .. } := BHausdorff2
  let { SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, .. } := BMTopology
  let { CONNECTED_IN_CLOSED_IN, CONNECTED_IN_TOPSPACE, CONNECTED_SPACE_CLOSED_IN, .. } :=
    BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { MONOTONE_MAP, .. } := BMonotone
  let { REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN,
        REAL_CLOSED_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
        .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC,
        .. } := BRealTop2
  let { CONNECTED_IN_EUCLIDEANREAL, .. } := BRealConn1
  let { CONTINUOUS_MAP_FROM_METRIC, .. } := BMetricCont
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_TOPSPACE,
        path_connected_space, .. } := BPaths1
  let { COMPACT_IN_PATH_IMAGE, CONNECTED_IN_PATH_IMAGE, PATH_CONNECTED_IN_EUCLIDEANREAL,
        .. } := BPaths2
  -- @@SCOPE END

  let EMBEDDING_MAP_INTO_EUCLIDEANREAL ← prove
   r"!top f:A->real.
        path_connected_space top
        ==> (embedding_map(top,euclideanreal) f <=>
             continuous_map(top,euclideanreal) f /\
             !x y. x IN topspace top /\ y IN topspace top /\ f x = f y
                   ==> x = y)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [embedding_map, HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN MESON_TAC [],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, embedding_map] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:real->A") THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET_REFL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_SUBMETRIC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FROM_METRIC] THEN
    REWRITE_TAC [SUBMETRIC, REAL_EUCLIDEAN_METRIC, INTER_UNIV] THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IMP_CONJ] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:A->bool") THEN REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"s = IMAGE (f:A->real) (topspace top)") THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"topspace top:A->bool") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
    ASM_REWRITE_TAC [PATH_CONNECTED_IN_TOPSPACE,
                     PATH_CONNECTED_IN_EUCLIDEANREAL] THEN
    DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"?u v d. &0 < d /\ u IN topspace top /\ v IN topspace top /\
              s INTER real_interval[f x - d,f x + d]
              SUBSET real_interval[(f:A->real) u,f v]")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"?u. u IN topspace top /\ (f:A->real) u < f x") THENL
       [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"u:A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"u:A"),
        EXISTS_TAC (← q r"x:A")] THEN
      (ASM_CASES_TAC (← q r"?v. v IN topspace top /\ (f:A->real) x < f v") THENL
       [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"v:A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"v:A"),
        EXISTS_TAC (← q r"x:A")])
      THENL
       [EXISTS_TAC (← q r"min ((f:A->real) x - f u) (f v - f x)"),
        EXISTS_TAC (← q r"(f:A->real) x - f u"),
        EXISTS_TAC (← q r"(f:A->real) v - f x"),
        EXISTS_TAC (← q r"&1")] THEN
      (ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC]) THEN
      EXPAND_TAC "s" THEN REWRITE_TAC [SUBSET, IN_INTER, IMP_CONJ] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
      X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A") o
       GEN_REWRITE_RULE id [NOT_EXISTS_THM])) THEN
      ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"?c:A->bool. compact_in top c /\ connected_in top c /\
                   u IN c /\ v IN c")
    STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected_space]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:A", ← q r"v:A"]) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:real->A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (h:real->A) (real_interval[&0,&1])") THEN
      ASM_SIMP_TAC [COMPACT_IN_PATH_IMAGE, CONNECTED_IN_PATH_IMAGE] THEN
      MAP_EVERY EXPAND_TAC ["u", "v"] THEN CONJ_TAC THEN
      MATCH_MP_TAC FUN_IN_IMAGE THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"continuous_map(subtopology euclideanreal
                      (s INTER real_interval [f(x:A) - d,f x + d]),
                     subtopology top c)
                    (g:real->A)")
    MP_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_INVERSE_MAP THEN EXISTS_TAC (← q r"f:A->real") THEN
      REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEANREAL] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY,
                    TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
      TRANS_TAC SUBSET_TRANS (← q r"real_interval[f(u:A),f v]") THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, ← SET_RULE (← q
        r"c SUBSET u ==> u INTER c = c")] THEN
      MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN
      ASM_SIMP_TAC [FUN_IN_IMAGE, ← GSYM CONNECTED_IN_EUCLIDEANREAL] THEN
      ASM_MESON_TAC [CONNECTED_IN_CONTINUOUS_MAP_IMAGE],
      ALL_TAC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    DISCH_THEN (MP_TAC o CONJUNCT1) THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_SUBMETRIC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FROM_METRIC] THEN
    DISCH_THEN (MP_TAC o CONJUNCT2) THEN
    REWRITE_TAC [SUBMETRIC, REAL_EUCLIDEAN_METRIC, INTER_UNIV] THEN
    EXPAND_TAC "s" THEN REWRITE_TAC [IN_INTER, IMP_CONJ] THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"t:A->bool")) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM, IMP_IMP, ← GSYM CONJ_ASSOC] THEN
    X_GEN_TAC (← q r"e:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min (d:real) e") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
    X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT ← prove
   r"!top (f:A->real).
        continuous_map(top,euclideanreal) f
        ==> ((!k. is_realinterval k
                  ==> connected_in top {x | x IN topspace top /\ f x IN k}) <=>
             connected_space top /\ monotone_map(top,euclideanreal) f)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [MONOTONE_MAP, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
    EQ_TAC THEN STRIP_TAC THENL
     [CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(:real)")) THEN
        REWRITE_TAC [IS_REALINTERVAL_UNIV, IN_UNIV, IN_GSPEC] THEN
        REWRITE_TAC [CONNECTED_IN_TOPSPACE],
        X_GEN_TAC (← q r"y:real") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y:real}")) THEN
        REWRITE_TAC [IS_REALINTERVAL_SING, IN_SING]],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a b u v. a < b /\
                closed_in top u /\ closed_in top v /\
                ~(u = {}) /\ ~(v = {}) /\ DISJOINT u v /\
                {x:A | x IN topspace top /\ f x IN real_interval[a,b]} =
                u UNION v /\
                DISJOINT u {x | x IN topspace top /\ f x = b} /\
                DISJOINT v {x | x IN topspace top /\ f x = a}
                ==> F")
    ASSUME_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_SPACE_CLOSED_IN]) THEN
      REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
       [← q r"u UNION {x | x IN topspace top /\ (f:A->real) x IN {c | c <= a}}",
        ← q r"v UNION {x | x IN topspace top /\ (f:A->real) x IN {c | b <= c}}"] THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_UNION THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [← GSYM REAL_CLOSED_IN] THEN
        REWRITE_TAC [REAL_CLOSED_HALFSPACE_LE] THEN
        REWRITE_TAC [← REWRITE_RULE [real_ge] REAL_CLOSED_HALFSPACE_GE],
        ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
         r"{x | x IN t /\ R x}  = u UNION v
          ==> (!x. P x \/ Q x \/ R x)
              ==> t SUBSET (u UNION {x | x IN t /\ P x}) UNION
                           (v UNION {x | x IN t /\ Q x})"))) THEN
        REWRITE_TAC [IN_REAL_INTERVAL, IN_ELIM_THM] THEN REAL_ARITH_TAC,
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
         r"{x | x IN t /\ R x}  = u UNION v
          ==> DISJOINT u v /\ (!x. ~(P x /\ Q x)) /\
              DISJOINT u {x | x IN t /\ Q x /\ R x} /\
              DISJOINT v {x | x IN t /\ P x /\ R x}
              ==> (u UNION {x | x IN t /\ P x}) INTER
                  (v UNION {x | x IN t /\ Q x}) = {}"))) THEN
        ASM_SIMP_TAC [IN_ELIM_THM, IN_REAL_INTERVAL, ← REAL_ARITH (← q
         r"a < b ==> (b <= x /\ a <= x /\ x <= b <=> x = b) /\
                    (x <= a /\ a <= x /\ x <= b <=> x = a)")] THEN
        ASM_REAL_ARITH_TAC,
        ASM SET_TAC [],
        ASM SET_TAC []],
      X_GEN_TAC (← q r"k:real->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [CONNECTED_IN_CLOSED_IN, SUBSET_RESTRICT, ← SET_RULE (← q
       r"P /\ Q /\ R /\ S /\
        ~(u INTER {x | x IN t /\ f x IN k} = {}) /\
        ~(v INTER {x | x IN t /\ f x IN k} = {}) <=>
        ?a b. a IN k /\ b IN k /\ P /\ Q /\ R /\ S /\
              ~DISJOINT u {x | x IN t /\ f x = a} /\
              ~DISJOINT v {x | x IN t /\ f x = b}")] THEN
      ONCE_REWRITE_TAC [← MESON [] (← q
       r"~(?a b c d. P a b c d) <=> !c d a b. ~P a b c d")] THEN
      MATCH_MP_TAC REAL_WLOG_LE THEN CONJ_TAC THENL
       [MESON_TAC [INTER_ACI, UNION_COMM], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"IMAGE (f:A->real) u INTER IMAGE f v INTER k = {}")
      ASSUME_TAC THENL
       [REWRITE_TAC [← SET_RULE (← q
         r"(IMAGE f u) INTER IMAGE f v INTER k = {} <=>
          !a b. a IN u /\ b IN v /\ f a = f b /\ f b IN k ==> F")] THEN
        MAP_EVERY X_GEN_TAC [← q r"p:A", ← q r"q:A"] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_IN_CLOSED_IN] o
         SPEC (← q r"(f:A->real) q")) THEN
        REWRITE_TAC [SUBSET_RESTRICT] THEN
        MAP_EVERY EXISTS_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
        ASM_REWRITE_TAC [] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (DISJ_CASES_TAC o GEN_REWRITE_RULE id [REAL_LE_LT])
      THENL [ALL_TAC, ASM SET_TAC []] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"a:real", ← q r"b:real",
        ← q r"u INTER {x:A | x IN topspace top /\ f x IN real_interval[a,b]}",
        ← q r"v INTER {x:A | x IN topspace top /\ f x IN real_interval[a,b]}"]) THEN
      ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_INTER THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [← GSYM REAL_CLOSED_IN] THEN
        REWRITE_TAC [REAL_CLOSED_REAL_INTERVAL],
        ALL_TAC] THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
       [CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
         r"~DISJOINT u {x | x IN t /\ f x = a}
          ==> a IN s
              ==> ~(u INTER {x | x IN t /\ f x IN s} = {})"))) THEN
        REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC,
        SUBGOAL_THEN (← q r"real_interval[a,b] SUBSET k") ASSUME_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [is_realinterval]) THEN
          REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
          ASM_MESON_TAC [],
          ASM SET_TAC []]]])

  return { EMBEDDING_MAP_INTO_EUCLIDEANREAL, MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT }

