  let { ATPOINTOF_SUBTOPOLOGY, .. } := BAtPoint
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  let { CONTINUOUS_MAP_TO_METRIC, .. } := BMetricCont
  let { COMPLETELY_METRIZABLE_IMP_METRIZABLE_SPACE, FORALL_COMPLETELY_METRIZABLE_SPACE, .. } :=
    BCMS1
  let { CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT, .. } := BEXT1
  let { CONVERGENT_EQ_ZERO_OSCILLATION_GEN, .. } := BLAV1
  -- @@SCOPE END

  let GDELTA_IN_POINTS_OF_CONVERGENCE_WITHIN ← prove
   r"!top top' (f:A->B) s.
        completely_metrizable_space top' /\
        (continuous_map (subtopology top s,top') f \/
         t1_space top /\ IMAGE f s SUBSET topspace top')
        ==> gdelta_in top
             {x | x IN topspace top /\
                  ?l. limit top' f l (atpointof top x within s)}"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_COMPLETELY_METRIZABLE_SPACE] THEN
    REPEAT GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) (topspace top INTER s) SUBSET mspace m")
    ASSUME_TAC THENL
     [FIRST_X_ASSUM DISJ_CASES_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY,
                     TOPSPACE_MTOPOLOGY],
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
      ASM_SIMP_TAC [CONVERGENT_EQ_ZERO_OSCILLATION_GEN] THEN
      REWRITE_TAC [NOT_IMP]] THEN
    ASM_CASES_TAC (← q r"mspace m:B->bool = {}") THEN
    ASM_REWRITE_TAC [EMPTY_GSPEC, GDELTA_IN_EMPTY] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"!s. gdelta_in top s /\ t = s ==> gdelta_in top t")) THEN
    FIRST_X_ASSUM (DISJ_CASES_THEN STRIP_ASSUME_TAC) THENL
     [EXISTS_TAC
       (← q r"topspace top INTER
        INTERS {UNIONS {u | open_in top u /\
                            !x y. x IN (s INTER u) /\
