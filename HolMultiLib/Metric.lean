    (BSeparated : Separated) (BConnected1 : Connected1) (BConnected2 : Connected2)
    (BConnected3 : Connected3) (BConnected4 : Connected4) (BComponents1 : Components1)
    (BComponents2 : Components2) : ExceptT String IO Components3 := do
  -- @@SCOPE BEGIN
  let { ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        NUMSEG_CONV, .. } := D
  let { CARD_CLAUSES, CARD_DELETE, CARD_NUMSEG_1, CARD_SING, CARTESIAN_PRODUCT_EQ,
        CARTESIAN_PRODUCT_EQ_EMPTY, CONJ_ASSOC, CROSS, CROSS_EQ_EMPTY, EXTENSION, EXTENSIONAL,
        FINITE_DELETE, FINITE_INSERT, FINITE_NUMSEG, FINITE_SING, FORALL_IN_GSPEC,
        FORALL_IN_INSERT, FUN_IN_IMAGE, HAS_SIZE, IMAGE_EQ, .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_IMP, IN, IN_CROSS, IN_DELETE, IN_ELIM_THM, IN_IMAGE, IN_INSERT,
        IN_UNIONS, LEFT_IMP_EXISTS_THM, LT_REFL, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, NUMSEG_EMPTY, PAIRWISE_INSERT_SYMMETRIC, PAIRWISE_MONO, PAIRWISE_SING,
        .. } := D.core2
  let { RESTRICTION, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_TRANS, UNIONS_1, UNWIND_THM2,
        cartesian_product, num_WF, o_DEF, o_THM, pairwise, .. } := D.core4
  let { DE_MORGAN_THM, EXISTS_PAIR_THM, FORALL_PAIR_THM, LEFT_AND_EXISTS_THM,
        RIGHT_AND_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SWAP_EXISTS_THM, .. } := D.core5
  let { CARD_EMPTY_LE, CARD_LE_CARD, CARD_LE_EMPTY, CARD_LE_RELATIONAL_FULL, CARD_LE_SUBSET,
        CARD_LE_TRANS, CARD_LTE_TRANS, CARD_LT_CARD, CARD_NOT_LE, NUMSEG_CARD_LE,
        .. } := D.lib
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { HOMEOMORPHIC_IMP_SURJECTIVE_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { SEPARATED_IN_IMP_DISJOINT, SEPARATED_IN_MONO, SEPARATED_IN_REFL, SEPARATED_IN_SYM,
        SEPARATED_IN_UNIONS, separated_in, .. } := BSeparated
  let { CONNECTED_IN_SUBSET_TOPSPACE, .. } := BConnected1
  let { CONNECTED_IN_EQ_NOT_SEPARATED, CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, .. } := BConnected2
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { CONNECTED_IN_CARTESIAN_PRODUCT, CONNECTED_IN_CROSS, .. } := BConnected4
  let { CONNECTED_COMPONENT_IN_TOPSPACE, CONNECTED_COMPONENT_OF_EQ_EMPTY,
        CONNECTED_COMPONENT_OF_MAXIMAL, CONNECTED_COMPONENT_OF_REFL,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, CONNECTED_IN_CONNECTED_COMPONENT_OF,
        UNIONS_CONNECTED_COMPONENTS_OF, connected_component_of, connected_components_of,
        .. } := BComponents1
  let { CONNECTED_COMPONENTS_OF_EMPTY_SPACE, CONNECTED_COMPONENT_OF_EQ_OVERLAP,
        CONNECTED_COMPONENT_OF_UNIQUE, .. } := BComponents2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN ← prove
   r"!(top:A topology) u.
        (!c. c IN u ==> connected_in top c) /\
        UNIONS u = topspace top
        ==> connected_components_of top <=_c u"
   (REPEAT STRIP_TAC THEN TRANS_TAC CARD_LE_TRANS (← q r"u DELETE ({}:A->bool)") THEN
    CONJ_TAC THENL
     [ALL_TAC, MATCH_MP_TAC CARD_LE_SUBSET THEN SET_TAC []] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\(s:A->bool) t. s SUBSET t") THEN REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [connected_components_of, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(a:A) IN UNIONS u") MP_TAC THENL
       [ASM_REWRITE_TAC [], REWRITE_TAC [IN_UNIONS]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [IN_DELETE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      ASM_SIMP_TAC [],
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, IN_DELETE] THEN
      REWRITE_TAC [connected_components_of, FORALL_IN_GSPEC] THEN
      SIMP_TAC [CONNECTED_COMPONENT_OF_EQ_OVERLAP] THEN ASM SET_TAC []])

  let CARD_LE_CONNECTED_COMPONENTS_ALT ← prove
   r"!(top:A topology) n.
       ((1..n) <=_c connected_components_of top <=>
       n = 0 \/
       ?u. u HAS_SIZE n /\
           pairwise (separated_in top) u /\
           (!t. t IN u ==> ~(t = {})) /\
           UNIONS u = topspace top)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [] THENL
     [CONV_TAC (ONCE_DEPTH_CONV NUMSEG_CONV) THEN
      REWRITE_TAC [CARD_EMPTY_LE],
      ALL_TAC] THEN
    EQ_TAC THENL
     [POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP],
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [NUMSEG_CARD_LE] THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"n = CARD(u:(A->bool)->bool)") SUBST1_TAC THENL
       [ASM_MESON_TAC [HAS_SIZE], ALL_TAC] THEN
      W (MP_TAC o PART_MATCH (rand o rand) CARD_LE_CARD o snd) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [HAS_SIZE], DISCH_THEN (SUBST1_TAC o SYM)] THEN
      MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
      EXISTS_TAC (← q r"\(u:A->bool) v. ~DISJOINT u v") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [MP_TAC (← ISPEC (← q r"top:A topology") UNIONS_CONNECTED_COMPONENTS_OF) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"t:A->bool", ← q r"c1:A->bool", ← q r"c2:A->bool"] THEN
      STRIP_TAC THEN ASM_CASES_TAC (← q r"c1:A->bool = c2") THEN ASM_REWRITE_TAC [] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_CONNECTED_COMPONENTS_OF) THEN
      REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN REWRITE_TAC [] THEN
      MAP_EVERY EXISTS_TAC [← q r"c1:A->bool", ← q r"UNIONS(u DELETE (c1:A->bool))"] THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [SEPARATED_IN_UNIONS, FINITE_DELETE] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
      REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC [separated_in]] THEN
    SPEC_TAC (← q r"n:num", ← q r"n:num") THEN
    MATCH_MP_TAC num_WF THEN X_GEN_TAC (← q r"n:num") THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"n = 1") THENL
     [EXISTS_TAC (← q r"{topspace top:A->bool}") THEN
      ASM_REWRITE_TAC [PAIRWISE_SING, UNIONS_1, FORALL_IN_INSERT] THEN
      REWRITE_TAC [HAS_SIZE, CARD_SING, FINITE_SING, NOT_IN_EMPTY] THEN
      DISCH_TAC THEN UNDISCH_TAC
       (← q r"1..n <=_c connected_components_of(top:A topology)") THEN
      ASM_SIMP_TAC [CONNECTED_COMPONENTS_OF_EMPTY_SPACE] THEN
      REWRITE_TAC [CARD_LE_EMPTY, NUMSEG_EMPTY, LT_REFL],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n - 1")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
      TRANS_TAC CARD_LE_TRANS (← q r"1..n") THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [FINITE_NUMSEG, CARD_LE_CARD, CARD_NUMSEG_1] THEN
      ARITH_TAC,
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"!c:A->bool. c IN u ==> connected_in top c") THENL
     [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:(A->bool)->bool"]
          CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN) THEN
      MATCH_MP_TAC (← TAUT (← q r"~p ==> p ==> q")) THEN ASM_REWRITE_TAC [CARD_NOT_LE] THEN
      TRANS_TAC CARD_LTE_TRANS (← q r"1..n") THEN ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [CARD_LT_CARD, FINITE_NUMSEG, CARD_NUMSEG_1] THEN
      ASM_ARITH_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_FORALL_THM])] THEN
    REWRITE_TAC [NOT_IMP, CONNECTED_IN_EQ_NOT_SEPARATED] THEN
    ASM_SIMP_TAC [← sr
     r"UNIONS u = t ==> (c IN u /\ ~(c SUBSET t /\ ~P) <=> c IN u /\ P)"] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"a:A->bool", ← q r"b:A->bool"] THEN
    STRIP_TAC THEN
    EXISTS_TAC (← q r"(a:A->bool) INSERT b INSERT (u DELETE c)") THEN
    SUBGOAL_THEN (← q r"~(a:A->bool = b)") ASSUME_TAC THENL
     [ASM_MESON_TAC [SEPARATED_IN_REFL], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(a:A->bool = c) /\ ~(b = c)") STRIP_ASSUME_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP SEPARATED_IN_IMP_DISJOINT) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT] THEN
    ASM_SIMP_TAC [CARD_CLAUSES, HAS_SIZE, FINITE_INSERT, FINITE_DELETE,
                  IN_INSERT, IN_DELETE, CARD_DELETE] THEN
    SUBGOAL_THEN
     (← q r"!d:A->bool. d IN u DELETE c
                  ==> separated_in top a d /\ separated_in top b d")
    ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN REWRITE_TAC [IN_DELETE] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC SEPARATED_IN_MONO THEN
      MAP_EVERY EXISTS_TAC [← q r"c:A->bool", ← q r"d:A->bool"] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((a:A->bool) IN u) /\ ~(b IN u)") STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [IN_DELETE, SEPARATED_IN_REFL],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    SIMP_TAC [PAIRWISE_INSERT_SYMMETRIC, SEPARATED_IN_SYM] THEN
    ASM_SIMP_TAC [IMP_CONJ, FORALL_IN_INSERT] THEN
    MATCH_MP_TAC PAIRWISE_MONO THEN EXISTS_TAC (← q r"u:(A->bool)->bool") THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE ← prove
   r"!top top' (f:A->B) x y.
        continuous_map(top,top') f /\
        connected_component_of top x y
        ==> connected_component_of top' (f x) (f y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [connected_component_of] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) c") THEN ASM_SIMP_TAC [FUN_IN_IMAGE] THEN
    ASM_MESON_TAC [CONNECTED_IN_CONTINUOUS_MAP_IMAGE])

  let HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF ← prove
   r"!(f:A->B) top top' x.
        homeomorphic_map(top,top') f /\ x IN topspace top
        ==> connected_component_of top' (f x) =
            IMAGE f (connected_component_of top x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g:B->A") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE] THEN REWRITE_TAC [IN] THEN
    MP_TAC (← ISPEC (← q r"top':B topology") CONNECTED_COMPONENT_IN_TOPSPACE) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B"]
          CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology", ← q r"g:B->A"]
          CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT
     (FIRST_X_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF ← prove
   r"!(f:A->B) top top'.
      homeomorphic_map(top,top') f
      ==> connected_components_of top' =
          IMAGE (IMAGE f) (connected_components_of top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [connected_components_of, SIMPLE_IMAGE] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN MATCH_MP_TAC IMAGE_EQ THEN
    REWRITE_TAC [] THEN ASM_MESON_TAC [HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF])

  let CONNECTED_COMPONENT_OF_PAIR ← prove
   r"!top1 top2 (x:A) (y:B).
        connected_component_of (prod_topology top1 top2) (x,y) =
        connected_component_of top1 x CROSS connected_component_of top2 y"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← sr
     r"(s = {} <=> t = {}) /\ (~(s = {}) ==> (s = t)) ==> s = t") THEN
    REWRITE_TAC [CROSS_EQ_EMPTY, CONNECTED_COMPONENT_OF_EQ_EMPTY,
                 TOPSPACE_PROD_TOPOLOGY, IN_CROSS, DE_MORGAN_THM] THEN
    STRIP_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_OF_UNIQUE THEN
    SIMP_TAC [CONNECTED_IN_CROSS, CONNECTED_IN_CONNECTED_COMPONENT_OF] THEN
    REWRITE_TAC [IN_CROSS] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [IN] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL] THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"c:A#B->bool") THEN STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS (← q r"(IMAGE FST c CROSS IMAGE SND c):A#B->bool") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN MESON_TAC [],
      REWRITE_TAC [SUBSET_CROSS] THEN REPEAT DISJ2_TAC THEN
      CONJ_TAC THEN MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM] THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []]) THEN
      MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND]])

  let CONNECTED_COMPONENTS_OF_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        connected_components_of (prod_topology top1 top2) =
        {c1 CROSS c2 | c1 IN connected_components_of top1 /\
                       c2 IN connected_components_of top2}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [connected_components_of, TOPSPACE_PROD_TOPOLOGY, CROSS] THEN
    REWRITE_TAC [← sr r"{f z | z IN {x,y | P x y}} = {f(x,y) | P x y}"] THEN
    REWRITE_TAC [← GSYM CROSS, CONNECTED_COMPONENT_OF_PAIR] THEN SET_TAC [])

  let CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology) x.
        connected_component_of (product_topology k tops) x =
        if EXTENSIONAL k x
        then cartesian_product k (\i. connected_component_of (tops i) (x i))
        else {}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← sr
     r"(s = {} <=> t = {}) /\ (~(s = {}) ==> (s = t)) ==> s = t") THEN
    REWRITE_TAC [← MESON [] (← q r"(if p then x else y) = y <=> p ==> x = y")] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ_EMPTY, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM] THEN
    REWRITE_TAC [o_THM, ← GSYM cartesian_product] THEN
    CONJ_TAC THENL [MESON_TAC [], STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_OF_UNIQUE THEN
    SIMP_TAC [CONNECTED_IN_CARTESIAN_PRODUCT,
              CONNECTED_IN_CONNECTED_COMPONENT_OF] THEN
    ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONNECTED_COMPONENT_OF_REFL, IN], ALL_TAC] THEN
    X_GEN_TAC (← q r"c:(K->A)->bool") THEN STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"cartesian_product k (\i. IMAGE (\x. x i) c):(K->A)->bool") THEN
    REWRITE_TAC [← GSYM cartesian_product, SUBSET_CARTESIAN_PRODUCT] THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
      REWRITE_TAC [SUBSET, cartesian_product, IN_ELIM_THM,
                   TOPSPACE_PRODUCT_TOPOLOGY, o_THM, IN_IMAGE] THEN
      ASM_MESON_TAC [],
      DISJ2_TAC THEN X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      REWRITE_TAC [IN_IMAGE] THEN CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION]])

  let CONNECTED_COMPONENTS_OF_PRODUCT_TOPOLOGY ← prove
   r"!k (tops:K->A topology).
        connected_components_of (product_topology k tops) =
        { cartesian_product k c |c|
          !i. i IN k ==> c i IN connected_components_of(tops i)}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [connected_components_of,
                 CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY] THEN
    MATCH_MP_TAC (← sr
     r"(!x. x IN s ==> p x) /\ {cartesian_product k y | y IN IMAGE f s} = t
      ==> {if p x then cartesian_product k (f x) else z | x IN s} = t") THEN
    CONJ_TAC THENL
     [SIMP_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM],
      ALL_TAC] THEN
    REWRITE_TAC [IN_ELIM_THM, RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    REWRITE_TAC [IN_IMAGE, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM cartesian_product, o_THM] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← sr
       r"(!x. P x ==> Q x) ==> {f x | P x} SUBSET {f x | Q x}") THEN
      GEN_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"c:K->A->bool") THEN DISCH_THEN (X_CHOOSE_TAC (← q r"x:K->A")) THEN
      REWRITE_TAC [IN_ELIM_THM, CARTESIAN_PRODUCT_EQ] THEN
      REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
      ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
      REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2] THEN
      EXISTS_TAC (← q r"RESTRICTION k (x:K->A)") THEN
      SIMP_TAC [RESTRICTION, EXTENSIONAL, IN_ELIM_THM] THEN
      ASM_MESON_TAC []])

  return { CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN, CARD_LE_CONNECTED_COMPONENTS_ALT,
           CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE, HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF,
           HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENT_OF_PAIR,
           CONNECTED_COMPONENTS_OF_PROD_TOPOLOGY, CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY,
           CONNECTED_COMPONENTS_OF_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Monotone (in the general topological sense) maps.  (metric.ml 15668-15849) -/
/- ------------------------------------------------------------------------- -/

structure Monotone where
  monotone_map : thm
  MONOTONE_MAP : thm
  MONOTONE_MAP_IN_SUBTOPOLOGY : thm
  MONOTONE_MAP_FROM_SUBTOPOLOGY : thm
  MONOTONE_MAP_RESTRICTION : thm
  INJECTIVE_IMP_MONOTONE_MAP : thm
  EMBEDDING_IMP_MONOTONE_MAP : thm
  SECTION_IMP_MONOTONE_MAP : thm
  HOMEOMORPHIC_IMP_MONOTONE_MAP : thm
  CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE : thm
  CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE : thm
  MONOTONE_OPEN_MAP : thm
  MONOTONE_CLOSED_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupMonotone [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BEmbedding : Embedding) (BRetraction : Retraction) (BConnected1 : Connected1) :
    ExceptT String IO Monotone := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, EXTENSION, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_ELIM_THM, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET_REFL, SUBSET_RESTRICT, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_MAP_RESTRICTION, OPEN_MAP_RESTRICTION, .. } := BOpenClosed1
  let { CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, CONTINUOUS_OPEN_IMP_QUOTIENT_MAP,
        QUOTIENT_MAP_RESTRICTION, QUOTIENT_MAP_SATURATED_OPEN, quotient_map, .. } := BQuotient
  let { homeomorphic_map, .. } := BHomeo1
  let { embedding_map, .. } := BEmbedding
  let { SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP, SECTION_IMP_EMBEDDING_MAP,
        .. } := BRetraction
  let { CONNECTED_IN, CONNECTED_IN_EMPTY, CONNECTED_IN_SING, CONNECTED_IN_SUBSET_TOPSPACE,
        CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_SUBTOPOLOGY, connected_in, connected_space,
        .. } := BConnected1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let monotone_map ← new_definition
   r"monotone_map(top,top') (f:A->B) <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !y. y IN topspace top'
            ==> connected_in top {x | x IN topspace top /\ f x = y}"

  let MONOTONE_MAP ← prove
   r"!top top' f:A->B.
        monotone_map(top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !y. connected_in top {x | x IN topspace top /\ f x = y}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monotone_map] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"y:B") THEN ASM_CASES_TAC (← q r"(y:B) IN topspace top'") THEN
    ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC (← MESON [CONNECTED_IN_EMPTY] (← q r"s = {} ==> connected_in top s")) THEN
    ASM SET_TAC [])

  let MONOTONE_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s f:A->B.
        monotone_map(top,subtopology top' s) f <=>
        monotone_map(top,top') f /\ IMAGE f (topspace top) SUBSET s"
   (REWRITE_TAC [MONOTONE_MAP, TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [])

  let MONOTONE_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' s f:A->B.
        monotone_map(top,top') f /\
        (!x y. x IN topspace top /\ y IN topspace top /\ x IN s /\ f x = f y
               ==> y IN s)
        ==> monotone_map(subtopology top s,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monotone_map, CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_ELIM_THM, IN_INTER]] THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    SUBGOAL_THEN
     (← q r"{x | (x IN topspace top /\ x IN s) /\ (f:A->B) x = y} =
      {x | x IN topspace top /\ f x = y} \/
      {x | (x IN topspace top /\ x IN s) /\ (f:A->B) x = y} = {}")
    DISJ_CASES_TAC THENL
     [ASM SET_TAC [], ASM_SIMP_TAC [], ASM_REWRITE_TAC [CONNECTED_IN_EMPTY]])

  let MONOTONE_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        monotone_map(top,top') f /\ {x | x IN topspace top /\ f x IN v} = u
        ==> monotone_map (subtopology top u,subtopology top' v) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [MONOTONE_MAP_IN_SUBTOPOLOGY] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC MONOTONE_MAP_FROM_SUBTOPOLOGY THEN ASM SET_TAC [],
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC []])

  let INJECTIVE_IMP_MONOTONE_MAP ← prove
   r"!top top' f:A->B.
        IMAGE f (topspace top) SUBSET topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y)
        ==> monotone_map (top,top') f"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [monotone_map] THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (f:A->B) x = y} = {} \/
      ?a. a IN topspace top /\
          {x | x IN topspace top /\ (f:A->B) x = y} = {a}")
    STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [],
      ASM_REWRITE_TAC [CONNECTED_IN_EMPTY],
      ASM_REWRITE_TAC [CONNECTED_IN_SING]])

  let EMBEDDING_IMP_MONOTONE_MAP ← prove
   r"!top top' f:A->B.
        embedding_map (top,top') f ==> monotone_map (top,top') f"
   (REWRITE_TAC [embedding_map, homeomorphic_map, quotient_map] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC INJECTIVE_IMP_MONOTONE_MAP THEN ASM SET_TAC [])

  let SECTION_IMP_MONOTONE_MAP ← prove
   r"!top top' f:A->B.
        section_map (top,top') f ==> monotone_map (top,top') f"
   (MESON_TAC [EMBEDDING_IMP_MONOTONE_MAP, SECTION_IMP_EMBEDDING_MAP])

  let HOMEOMORPHIC_IMP_MONOTONE_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f ==> monotone_map (top,top') f"
   (REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    SIMP_TAC [SECTION_IMP_MONOTONE_MAP])

  let CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE ← prove
   r"!top top' f:A->B.
        monotone_map(top,top') f /\ quotient_map (top,top') f /\
        connected_space top'
        ==> connected_space top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [monotone_map] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [connected_space, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"IMAGE (f:A->B) u", ← q r"IMAGE (f:A->B) v"] THEN
    ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id
     [QUOTIENT_MAP_SATURATED_OPEN]) THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")) THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN X_GEN_TAC (← q r"y:B") THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN ANTS_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [CONNECTED_IN, SUBSET_RESTRICT] THEN
        MAP_EVERY EXISTS_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
        ASM_REWRITE_TAC []] THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      ASM SET_TAC []])

  let CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B) c.
        monotone_map(top,top') f /\ quotient_map (top,top') f /\
        connected_in top' c /\ (open_in top' c \/ closed_in top' c)
        ==> connected_in top {x | x IN topspace top /\ f x IN c}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_in, SUBSET_RESTRICT] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE THEN
    MAP_EVERY EXISTS_TAC [← q r"subtopology top' (c:B->bool)", ← q r"f:A->B"] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC MONOTONE_MAP_RESTRICTION THEN ASM_REWRITE_TAC [],
      MATCH_MP_TAC QUOTIENT_MAP_RESTRICTION THEN ASM_REWRITE_TAC [],
      ASM_REWRITE_TAC []])

  let MONOTONE_OPEN_MAP ← prove
   r"!top top' f:A->B.
        continuous_map(top,top') f /\
        open_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> (monotone_map(top,top') f <=>
             !c. connected_in top' c
                 ==> connected_in top {x | x IN topspace top /\ f x IN c})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      REWRITE_TAC [connected_in, SUBSET_RESTRICT] THEN
      MATCH_MP_TAC CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"subtopology top' (c:B->bool)", ← q r"f:A->B"] THEN
      ASM_SIMP_TAC [CONNECTED_SPACE_SUBTOPOLOGY] THEN CONJ_TAC THENL
       [MATCH_MP_TAC MONOTONE_MAP_RESTRICTION THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC CONTINUOUS_OPEN_IMP_QUOTIENT_MAP THEN
        ASM_SIMP_TAC [OPEN_MAP_RESTRICTION] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                      CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []],
      DISCH_THEN (MP_TAC o GEN (← q r"y:B") o SPEC (← q r"{y:B}")) THEN
      ASM_REWRITE_TAC [CONNECTED_IN_SING, IN_SING, SUBSET_REFL, monotone_map]])

  let MONOTONE_CLOSED_MAP ← prove
   r"!top top' f:A->B.
        continuous_map(top,top') f /\
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> (monotone_map(top,top') f <=>
             !c. connected_in top' c
                 ==> connected_in top {x | x IN topspace top /\ f x IN c})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      REWRITE_TAC [connected_in, SUBSET_RESTRICT] THEN
      MATCH_MP_TAC CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE THEN
      MAP_EVERY EXISTS_TAC [← q r"subtopology top' (c:B->bool)", ← q r"f:A->B"] THEN
      ASM_SIMP_TAC [CONNECTED_SPACE_SUBTOPOLOGY] THEN CONJ_TAC THENL
       [REWRITE_TAC [monotone_map, CONNECTED_IN_SUBTOPOLOGY] THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [MONOTONE_MAP, continuous_map]) THEN
        ASM_SIMP_TAC [← sr
           r"y IN c
            ==> ((x IN s /\ x IN s /\ f x IN c) /\ f x = y <=>
                 x IN s /\ f x = y)"] THEN
        ASM SET_TAC [],
        MATCH_MP_TAC CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP THEN
        ASM_SIMP_TAC [CLOSED_MAP_RESTRICTION] THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                      CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []],
      DISCH_THEN (MP_TAC o GEN (← q r"y:B") o SPEC (← q r"{y:B}")) THEN
      ASM_REWRITE_TAC [CONNECTED_IN_SING, IN_SING, SUBSET_REFL, monotone_map]])

  return { monotone_map, MONOTONE_MAP, MONOTONE_MAP_IN_SUBTOPOLOGY,
           MONOTONE_MAP_FROM_SUBTOPOLOGY, MONOTONE_MAP_RESTRICTION, INJECTIVE_IMP_MONOTONE_MAP,
           EMBEDDING_IMP_MONOTONE_MAP, SECTION_IMP_MONOTONE_MAP, HOMEOMORPHIC_IMP_MONOTONE_MAP,
           CONNECTED_SPACE_MONOTONE_QUOTIENT_MAP_PREIMAGE,
           CONNECTED_IN_MONOTONE_QUOTIENT_MAP_PREIMAGE, MONOTONE_OPEN_MAP, MONOTONE_CLOSED_MAP }

/- ------------------------------------------------------------------------- -/
/- Neigbourhood bases (useful for "local" properties of various kind).       -/
/- (metric.ml 15851-16108)                                                    -/
/- ------------------------------------------------------------------------- -/

structure NbhdBase where
  neighbourhood_base_at : thm
  neighbourhood_base_of : thm
  NEIGHBOURHOOD_BASE_OF : thm
  NEIGHBOURHOOD_BASE_AT_MONO : thm
  NEIGHBOURHOOD_BASE_OF_MONO : thm
  OPEN_NEIGHBOURHOOD_BASE_AT : thm
  OPEN_NEIGHBOURHOOD_BASE_OF : thm
  OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE : thm
  NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET : thm
  NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE : thm
  NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE : thm
  NEIGHBOURHOOD_BASE_AT_UNLOCALIZED : thm
  NEIGHBOURHOOD_BASE_OF_UNLOCALIZED : thm
  NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY : thm
  NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY : thm
  NEIGHBOURHOOD_BASE_AT_WITH_SUBSET : thm
  NEIGHBOURHOOD_BASE_OF_WITH_SUBSET : thm
  SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : thm
  FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT : thm
  SECOND_COUNTABLE_NEIGHBOURHOOD_BASE : thm
  FIRST_COUNTABLE_NEIGHBOURHOOD_BASE : thm
  deriving Inhabited

@[nospecialize]
def setupNbhdBase [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BBases : Bases) (BInterior : Interior)
    (BCountability : Countability) : ExceptT String IO NbhdBase := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM,
        .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, INTER_SUBSET, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS,
        SWAP_FORALL_THM, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { COUNTABLE_IMAGE, .. } := D.lib
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY_ALT, .. } := BSubtopology
  let { OPEN_IN_TOPOLOGY_BASE_UNIQUE, .. } := BBases
  let { INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { SECOND_COUNTABLE, first_countable, .. } := BCountability
  -- @@SCOPE END

  let neighbourhood_base_at ← new_definition
   r"neighbourhood_base_at (x:A) P top <=>
        !w. open_in top w /\ x IN w
            ==>  ?u v. open_in top u /\ P v /\
                     x IN u /\ u SUBSET v /\ v SUBSET w"

  let neighbourhood_base_of ← new_definition
   r"neighbourhood_base_of P top <=>
        !x. x IN topspace top ==> neighbourhood_base_at x P top"

  let NEIGHBOURHOOD_BASE_OF ← prove
   r"!(top:A topology) P.
        neighbourhood_base_of P top <=>
        !w x. open_in top w /\ x IN w
              ==> ?u v. open_in top u /\ P v /\
                        x IN u /\ u SUBSET v /\ v SUBSET w"
   (REWRITE_TAC [neighbourhood_base_at, neighbourhood_base_of] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let NEIGHBOURHOOD_BASE_AT_MONO ← prove
   r"!top P Q x:A.
        (!s. P s /\ x IN s ==> Q s) /\ neighbourhood_base_at x P top
        ==> neighbourhood_base_at x Q top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [neighbourhood_base_at] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN ASM SET_TAC [])

  let NEIGHBOURHOOD_BASE_OF_MONO ← prove
   r"!top P Q:(A->bool)->bool.
        (!s. P s ==> Q s) /\ neighbourhood_base_of P top
        ==> neighbourhood_base_of Q top"
   (REWRITE_TAC [neighbourhood_base_of] THEN
    MESON_TAC [NEIGHBOURHOOD_BASE_AT_MONO])

  let OPEN_NEIGHBOURHOOD_BASE_AT ← prove
   r"!top P x:A.
        (!s. P s /\ x IN s ==> open_in top s)
        ==> (neighbourhood_base_at x P top <=>
             !w. open_in top w /\ x IN w ==> ?u. P u /\ x IN u /\ u SUBSET w)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [neighbourhood_base_at] THEN
    ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let OPEN_NEIGHBOURHOOD_BASE_OF ← prove
   r"!top P:(A->bool)->bool.
      (!s. P s ==> open_in top s)
      ==> (neighbourhood_base_of P top <=>
           !w x. open_in top w /\ x IN w ==> ?u. P u /\ x IN u /\ u SUBSET w)"
   (REWRITE_TAC [neighbourhood_base_of] THEN
    SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_AT] THEN
    MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE ← prove
   r"!top b:(A->bool)->bool.
        open_in top = ARBITRARY UNION_OF b <=>
        (!u. u IN b ==> open_in top u) /\ neighbourhood_base_of b top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    REWRITE_TAC [IN] THEN SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [IN])

  let NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET ← prove
   r"!top P s:A->bool.
        neighbourhood_base_of P top /\ open_in top s
        ==> neighbourhood_base_of P (subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, FORALL_IN_GSPEC, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"v:A->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s INTER v:A->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [SUBSET_INTER] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE ← prove
   r"!P top b x:A.
        open_in top = ARBITRARY UNION_OF b
        ==> (neighbourhood_base_at x P top <=>
             !w. w IN b /\ x IN w
                 ==> ?u v. open_in top u /\
                           P v /\
                           x IN u /\
                           u SUBSET v /\
                           v SUBSET w)"
   (REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE, neighbourhood_base_at] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:A->bool", ← q r"x:A"]) THEN
    ASM_MESON_TAC [SUBSET_TRANS])

  let NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE ← prove
   r"!P top b:(A->bool)->bool.
        open_in top = ARBITRARY UNION_OF b
        ==> (neighbourhood_base_of P top <=>
             !w x. w IN b /\ x IN w
                   ==> ?u v. open_in top u /\
                             P v /\
                             x IN u /\
                             u SUBSET v /\
                             v SUBSET w)"
   (REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE, NEIGHBOURHOOD_BASE_OF] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:A->bool", ← q r"x:A"]) THEN
    ASM_MESON_TAC [SUBSET_TRANS])

  let NEIGHBOURHOOD_BASE_AT_UNLOCALIZED ← prove
   r"!top P x:A.
       (!s t. P s /\ open_in top t /\ x IN t /\ t SUBSET s ==> P t)
       ==> (neighbourhood_base_at x P top <=>
            x IN topspace top
            ==> ?u v. open_in top u /\ P v /\ x IN u /\
                      u SUBSET v /\ v SUBSET topspace top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [neighbourhood_base_at] THEN
    EQ_TAC THENL [MESON_TAC [OPEN_IN_TOPSPACE, SUBSET], DISCH_TAC] THEN
    X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN topspace top") (ANTE_RES_THEN MP_TAC) THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    REPEAT (EXISTS_TAC (← q r"u INTER w:A->bool")) THEN
    ASM_SIMP_TAC [IN_INTER, SUBSET_REFL, OPEN_IN_INTER, INTER_SUBSET] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN EXISTS_TAC (← q r"v:A->bool") THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER] THEN ASM SET_TAC [])

  let NEIGHBOURHOOD_BASE_OF_UNLOCALIZED ← prove
   r"!top P:(A->bool)->bool.
       (!s t. P s /\ open_in top t /\ ~(t = {}) /\ t SUBSET s ==> P t)
       ==> (neighbourhood_base_of P top <=>
            !x. x IN topspace top
                ==> ?u v. open_in top u /\ P v /\ x IN u /\
                          u SUBSET v /\ v SUBSET topspace top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [neighbourhood_base_of] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    W (MP_TAC o PART_MATCH (lhand o rand)
      NEIGHBOURHOOD_BASE_AT_UNLOCALIZED o lhand o snd) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [MEMBER_NOT_EMPTY], DISCH_THEN SUBST1_TAC] THEN
    ASM_REWRITE_TAC [])

  let NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY ← prove
   r"!P u x:A.
        neighbourhood_base_at x P (discrete_topology u) <=>
        x IN u ==> P {x}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [neighbourhood_base_at] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY] THEN
    ASM_CASES_TAC (← q r"(x:A) IN u") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    EQ_TAC THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"{x:A}")) THEN
      ASM_REWRITE_TAC [IN_SING, SING_SUBSET, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
      ASM_CASES_TAC (← q r"t:A->bool = {x}") THEN ASM_SIMP_TAC [] THEN ASM SET_TAC [],
      DISCH_TAC THEN X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
      REPEAT (EXISTS_TAC (← q r"{x:A}")) THEN ASM SET_TAC []])

  let NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY ← prove
   r"!P u:A->bool.
        neighbourhood_base_of P (discrete_topology u) <=>
        !x. x IN u ==> P {x}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [neighbourhood_base_of] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY] THEN
    SIMP_TAC [TOPSPACE_DISCRETE_TOPOLOGY])

  let NEIGHBOURHOOD_BASE_AT_WITH_SUBSET ← prove
   r"!P top u x:A.
        open_in top u /\ x IN u
        ==> (neighbourhood_base_at x P top <=>
             neighbourhood_base_at x (\t. t SUBSET u /\ P t) top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [neighbourhood_base_at] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u INTER w:A->bool")) THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    SIMP_TAC [SUBSET_INTER])

  let NEIGHBOURHOOD_BASE_OF_WITH_SUBSET ← prove
   r"!P top:A topology.
        neighbourhood_base_of P top <=>
        neighbourhood_base_of (\t. t SUBSET topspace top /\ P t) top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [neighbourhood_base_of] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"(!x. P x ==> (Q x <=> R x))
      ==> ((!x. P x ==> Q x) <=> (!x. P x ==> R x))")) THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    MATCH_MP_TAC NEIGHBOURHOOD_BASE_AT_WITH_SUBSET THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE])

  let SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT ← prove
   r"!top:A topology.
        second_countable top <=>
        ?b. COUNTABLE b /\
            (!v. v IN b ==> open_in top v) /\
            neighbourhood_base_of b top"
   (REWRITE_TAC [SECOND_COUNTABLE, OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE])

  let FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT ← prove
   r"!top:A topology.
        first_countable top <=>
        !x. x IN topspace top
            ==> ?b. COUNTABLE b /\
                    (!v. v IN b ==> open_in top v) /\
                    neighbourhood_base_at x b top"
   (GEN_TAC THEN REWRITE_TAC [first_countable] THEN
    AP_TERM_TAC THEN ABS_TAC THEN AP_TERM_TAC THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) OPEN_NEIGHBOURHOOD_BASE_AT o
      rand o rand o rand o snd) THEN
    REWRITE_TAC [IN] THEN MESON_TAC [])

  let SECOND_COUNTABLE_NEIGHBOURHOOD_BASE ← prove
   r"!top:A topology.
        second_countable top <=>
        ?b. COUNTABLE b /\ neighbourhood_base_of b top"
   (GEN_TAC THEN REWRITE_TAC [SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:(A->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (\u:A->bool. top interior_of u) b") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, OPEN_IN_INTERIOR_OF] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r" x:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:A->bool", ← q r" x:A"]) THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ] THEN
    ASM_MESON_TAC [INTERIOR_OF_SUBSET, SUBSET, IN])

  let FIRST_COUNTABLE_NEIGHBOURHOOD_BASE ← prove
   r"!top:A topology.
        first_countable top <=>
        !x. x IN topspace top
            ==> ?b. COUNTABLE b /\ neighbourhood_base_at x b top"
   (GEN_TAC THEN REWRITE_TAC [FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT] THEN
    EQ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [neighbourhood_base_at, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:(A->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (\u:A->bool. top interior_of u) b") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, OPEN_IN_INTERIOR_OF] THEN
    X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:A->bool")) THEN
    ASM_REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ] THEN
    ASM_MESON_TAC [INTERIOR_OF_SUBSET, SUBSET, IN])

  return { neighbourhood_base_at, neighbourhood_base_of, NEIGHBOURHOOD_BASE_OF,
           NEIGHBOURHOOD_BASE_AT_MONO, NEIGHBOURHOOD_BASE_OF_MONO, OPEN_NEIGHBOURHOOD_BASE_AT,
           OPEN_NEIGHBOURHOOD_BASE_OF, OPEN_IN_TOPOLOGY_NEIGHBOURHOOD_BASE_UNIQUE,
           NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET, NEIGHBOURHOOD_BASE_AT_TOPOLOGY_BASE,
           NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE, NEIGHBOURHOOD_BASE_AT_UNLOCALIZED,
           NEIGHBOURHOOD_BASE_OF_UNLOCALIZED, NEIGHBOURHOOD_BASE_AT_DISCRETE_TOPOLOGY,
           NEIGHBOURHOOD_BASE_OF_DISCRETE_TOPOLOGY, NEIGHBOURHOOD_BASE_AT_WITH_SUBSET,
           NEIGHBOURHOOD_BASE_OF_WITH_SUBSET, SECOND_COUNTABLE_NEIGHBOURHOOD_BASE_ALT,
           FIRST_COUNTABLE_NEIGHBOURHOOD_BASE_ALT, SECOND_COUNTABLE_NEIGHBOURHOOD_BASE,
           FIRST_COUNTABLE_NEIGHBOURHOOD_BASE }

/- ------------------------------------------------------------------------- -/
/- T_0 spaces and the Kolmogorov quotient.  (metric.ml 16110-16270)          -/
/- ------------------------------------------------------------------------- -/

structure T0a where
  t0_space : thm
  T0_SPACE_EXPANSIVE : thm
  T1_IMP_T0_SPACE : thm
  T1_EQ_SYMMETRIC_T0_SPACE_ALT : thm
  T1_EQ_SYMMETRIC_T0_SPACE : thm
  HAUSDORFF_IMP_T0_SPACE : thm
  T0_SPACE : thm
  HOMEOMORPHIC_T0_SPACE : thm
  T0_SPACE_CLOSURE_OF_SING : thm
  T0_SPACE_DISCRETE_TOPOLOGY : thm
  T0_SPACE_SUBTOPOLOGY : thm
  T0_SPACE_RETRACTION_MAP_IMAGE : thm
  T0_SPACE_PROD_TOPOLOGY : thm
  T0_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupT0a [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BProd1 : Prod1) (BProduct1 : Product1)
    (BProduct3 : Product3) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace)
    (BRetractOf : RetractOf) (BT1a : T1a) (BHausdorff1 : Hausdorff1) :
    ExceptT String IO T0a := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, new_definition,
        .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, CROSS_EQ, CROSS_SING, EXISTS_IN_GSPEC, EXTENSION,
        EXTENSIONAL, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING,
        LEFT_IMP_EXISTS_THM, MONO_FORALL, NOT_FORALL_THM, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ,
        UNWIND_THM2, cartesian_product, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, PAIR_EQ, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_TOPSPACE, EXISTS_CLOSED_IN, OPEN_IN_CLOSED_IN_EQ, .. } := BTopology
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EMPTY, CLOSURE_OF_EQ_EMPTY, CLOSURE_OF_MINIMAL_EQ,
        CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET_TOPSPACE, DISCRETE_TOPOLOGY_CLOSURE_OF,
        closure_of, .. } := BClosure
  let { CLOSURE_OF_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CLOSED_IN_CARTESIAN_PRODUCT, .. } := BProduct3
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE, .. } := BHomeo2
  let { TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT, homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { t1_space, .. } := BT1a
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let t0_space ← new_definition
   r"t0_space (top:A topology) <=>
        !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
              ==> ?u. open_in top u /\ ~(x IN u <=> y IN u)"

  let T0_SPACE_EXPANSIVE ← prove
   r"!top top':A topology.
         topspace top' = topspace top /\ (!u. open_in top u ==> open_in top' u)
         ==> t0_space top ==> t0_space top'"
   (REWRITE_TAC [t0_space] THEN METIS_TAC [])

  let T1_IMP_T0_SPACE ← prove
   r"!top:A topology. t1_space top ==> t0_space top"
   (REWRITE_TAC [t1_space, t0_space] THEN MESON_TAC [])

  let T1_EQ_SYMMETRIC_T0_SPACE_ALT ← prove
   r"!top:A topology.
        t1_space top <=>
        t0_space top /\
        !x y. x IN topspace top /\ y IN topspace top
              ==> (x IN top closure_of {y} <=> y IN top closure_of {x})"
   (REWRITE_TAC [t0_space, t1_space, closure_of, IN_ELIM_THM] THEN
    GEN_TAC THEN SIMP_TAC [IN_SING, UNWIND_THM2, AND_FORALL_THM] THEN
    EQ_TAC THEN DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(y:A) IN topspace top") THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC [])

  let T1_EQ_SYMMETRIC_T0_SPACE ← prove
   r"!top:A topology.
        t1_space top <=>
        t0_space top /\
        !x y. x IN top closure_of {y} <=> y IN top closure_of {x}"
   (GEN_TAC THEN REWRITE_TAC [T1_EQ_SYMMETRIC_T0_SPACE_ALT] THEN
    EQ_TAC THEN SIMP_TAC [] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    MAP_EVERY ASM_CASES_TAC
     [← q r"(x:A) IN topspace top", ← q r"(y:A) IN topspace top"] THEN
    ASM_SIMP_TAC [] THEN
    ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    ASM_SIMP_TAC [← sr r"~(x IN s) ==> s INTER {x} = {}"] THEN
    REWRITE_TAC [CLOSURE_OF_EMPTY, NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [SUBSET, CLOSURE_OF_SUBSET_TOPSPACE])

  let HAUSDORFF_IMP_T0_SPACE ← prove
   r"!top:A topology. hausdorff_space top ==> t0_space top"
   (SIMP_TAC [HAUSDORFF_IMP_T1_SPACE, T1_IMP_T0_SPACE])

  let T0_SPACE ← prove
   r"!top:A topology.
        t0_space top <=>
        !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
              ==> ?c. closed_in top c /\ ~(x IN c <=> y IN c)"
   (SIMP_TAC [EXISTS_CLOSED_IN, IN_DIFF, t0_space] THEN MESON_TAC [])

  let HOMEOMORPHIC_T0_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (t0_space top <=> t0_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN DISCH_TAC THEN
    REWRITE_TAC [t0_space, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)") SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
      ASM SET_TAC [],
      REWRITE_TAC [FORALL_IN_IMAGE]] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN REWRITE_TAC [← MESON [] (← q
     r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1) THEN DISCH_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE th])) THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM] THEN ONCE_REWRITE_TAC [IMP_IMP] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")) THEN
    STRIP_TAC THEN BINOP_TAC THENL
     [ALL_TAC, AP_TERM_TAC THEN AP_TERM_TAC THEN ABS_TAC] THEN
    REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let T0_SPACE_CLOSURE_OF_SING ← prove
   r"!top:A topology.
        t0_space top <=>
        !x y. x IN topspace top /\ y IN topspace top /\
              top closure_of {x} = top closure_of {y}
              ==> x = y"
   (SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, CLOSURE_OF_MINIMAL_EQ, CLOSED_IN_CLOSURE_OF,
              SING_SUBSET, IMP_CONJ] THEN
    SIMP_TAC [t0_space, IN_ELIM_THM, closure_of, IN_SING, UNWIND_THM2] THEN
    MESON_TAC [])

  let T0_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!s:A->bool. t0_space(discrete_topology s)"
   (REWRITE_TAC [T0_SPACE_CLOSURE_OF_SING] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, DISCRETE_TOPOLOGY_CLOSURE_OF] THEN
    SET_TAC [])

  let T0_SPACE_SUBTOPOLOGY ← prove
   r"!top u:A->bool.
        t0_space top ==> t0_space(subtopology top u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [t0_space, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC, IN_INTER] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN MESON_TAC [])

  let T0_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ t0_space top ==> t0_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [T0_SPACE_SUBTOPOLOGY, HOMEOMORPHIC_T0_SPACE])

  let T0_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        t0_space(prod_topology top1 top2) <=>
        topspace (prod_topology top1 top2) = {} \/
        t0_space top1 /\ t0_space top2"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [EXTENSION] THEN
    REWRITE_TAC [T0_SPACE_CLOSURE_OF_SING] THEN
    REWRITE_TAC [FORALL_PAIR_THM, ← GSYM CROSS_SING] THEN
    REWRITE_TAC [CLOSURE_OF_CROSS, CROSS_EQ, PAIR_EQ] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IN_CROSS, NOT_IN_EMPTY] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    SIMP_TAC [CLOSURE_OF_EQ_EMPTY, SING_SUBSET, NOT_INSERT_EMPTY] THEN
    MESON_TAC [])

  let T0_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!tops:K->A topology k.
        t0_space (product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        !i. i IN k ==> t0_space (tops i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_T0_SPACE] THEN
      SIMP_TAC [T0_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THENL
     [ASM_REWRITE_TAC [t0_space, NOT_IN_EMPTY], ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [T0_SPACE] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"x:K->A", ← q r"y:K->A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [FUN_EQ_THM]) THEN
    REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE
       [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM,
        EXTENSIONAL, o_THM]) THEN
    SUBGOAL_THEN (← q r"(i:K) IN k") ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"(x:K->A) i", ← q r"(y:K->A) i"]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"c:A->bool") THEN
    STRIP_TAC THEN EXISTS_TAC
     (← q r"cartesian_product k
        (\j. if j = i then c else topspace((tops:K->A topology) j))") THEN
    REWRITE_TAC [CLOSED_IN_CARTESIAN_PRODUCT] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CLOSED_IN_TOPSPACE], ALL_TAC] THEN
    ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
    ASM_MESON_TAC [])

  return { t0_space, T0_SPACE_EXPANSIVE, T1_IMP_T0_SPACE, T1_EQ_SYMMETRIC_T0_SPACE_ALT,
           T1_EQ_SYMMETRIC_T0_SPACE, HAUSDORFF_IMP_T0_SPACE, T0_SPACE, HOMEOMORPHIC_T0_SPACE,
           T0_SPACE_CLOSURE_OF_SING, T0_SPACE_DISCRETE_TOPOLOGY, T0_SPACE_SUBTOPOLOGY,
           T0_SPACE_RETRACTION_MAP_IMAGE, T0_SPACE_PROD_TOPOLOGY, T0_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- The Kolmogorov quotient.  (metric.ml 16272-16514)                         -/
/- ------------------------------------------------------------------------- -/

structure T0b where
  kolmogorov_quotient : thm
  KOLMOGOROV_QUOTIENT_IN_OPEN : thm
  KOLMOGOROV_QUOTIENT_IN_TOPSPACE : thm
  KOLMOGOROV_QUOTIENT_IN_CLOSED : thm
  CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT : thm
  OPEN_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT : thm
  OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN : thm
  OPEN_MAP_KOLMOGOROV_QUOTIENT : thm
  CLOSED_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT : thm
  CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN : thm
  CLOSED_MAP_KOLMOGOROV_QUOTIENT : thm
  QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN : thm
  QUOTIENT_MAP_KOLMOGOROV_QUOTIENT : thm
  KOLMOGOROV_QUOTIENT_EQ : thm
  KOLMOGOROV_QUOTIENT_EQ_ALT : thm
  KOLMOGOROV_QUOTIENT_CONTINUOUS_MAP : thm
  T0_SPACE_KOLMOGOROV_QUOTIENT : thm
  KOLMOGOROV_QUOTIENT_ID : thm
  KOLMOGOROV_QUOTIENT_IDEMP : thm
  RETRACTION_MAPS_KOLMOGOROV_QUOTIENT : thm
  RETRACTION_MAP_KOLMOGOROV_QUOTIENT : thm
  RETRACT_OF_SPACE_KOLMOGOROV_QUOTIENT_IMAGE : thm
  KOLMOGOROV_QUOTIENT_LIFT_EXISTS : thm
  deriving Inhabited

@[nospecialize]
def setupT0b [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1)
    (BQuotient : Quotient) (BRetraction : Retraction) (BRetractOf : RetractOf) (BT0a : T0a) :
    ExceptT String IO T0b := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EXISTS_IN_GSPEC, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, IN_ELIM_THM, IN_INTER, I_DEF, MONO_EXISTS,
        NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SWAP_FORALL_THM, .. } := D.core4
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, FORALL_CLOSED_IN, OPEN_IN_DIFF,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_ALT,
        SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { closed_map, open_map, .. } := BOpenClosed1
  let { CONTINUOUS_OPEN_IMP_QUOTIENT_MAP, QUOTIENT_MAP_LIFT_EXISTS, .. } := BQuotient
  let { retraction_map, retraction_maps, .. } := BRetraction
  let { RETRACT_OF_SPACE_RETRACTION_MAPS, .. } := BRetractOf
  let { t0_space, .. } := BT0a
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let kolmogorov_quotient ← new_definition
   r"kolmogorov_quotient top =
     \x:A. @y. !u. open_in top u ==> (y IN u <=> x IN u)"

  let KOLMOGOROV_QUOTIENT_IN_OPEN ← prove
   r"!top u x:A. open_in top u ==> (kolmogorov_quotient top x IN u <=> x IN u)"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN GEN_TAC THEN
    REWRITE_TAC [kolmogorov_quotient] THEN ASM_MESON_TAC [])

  let KOLMOGOROV_QUOTIENT_IN_TOPSPACE ← prove
   r"!top x:A. kolmogorov_quotient top x IN topspace top <=> x IN topspace top"
   (MESON_TAC [KOLMOGOROV_QUOTIENT_IN_OPEN, OPEN_IN_TOPSPACE])

  let KOLMOGOROV_QUOTIENT_IN_CLOSED ← prove
   r"!top c x:A.
      closed_in top c ==> (kolmogorov_quotient top x IN c <=> x IN c)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_CLOSED_IN, IN_DIFF] THEN
    SIMP_TAC [KOLMOGOROV_QUOTIENT_IN_OPEN, KOLMOGOROV_QUOTIENT_IN_TOPSPACE])

  let CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        continuous_map (top,top) (kolmogorov_quotient top)"
   (GEN_TAC THEN SIMP_TAC [continuous_map, KOLMOGOROV_QUOTIENT_IN_TOPSPACE] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN MATCH_MP_TAC (← MESON [] (← q
     r"(open_in top u ==> u' = u) ==> (open_in top u ==> open_in top u')")) THEN
    DISCH_TAC THEN ASM_SIMP_TAC [KOLMOGOROV_QUOTIENT_IN_OPEN] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [])

  let OPEN_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT ← prove
   r"!top u:A->bool.
        open_in top u
        ==> IMAGE (kolmogorov_quotient top) u =
            IMAGE (kolmogorov_quotient top) (topspace top) INTER u"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP KOLMOGOROV_QUOTIENT_IN_OPEN) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [])

  let OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN ← prove
   r"!top s:A->bool.
        open_map (subtopology top s,
                  subtopology top (IMAGE (kolmogorov_quotient top) s))
                 (kolmogorov_quotient top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [open_map, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"u:A->bool") THEN
    MP_TAC (← GEN (← q r"x:A") (← ISPECL [← q r"top:A topology", ← q r"u:A->bool",
      ← q r"x:A"] KOLMOGOROV_QUOTIENT_IN_OPEN)) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let OPEN_MAP_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        open_map (top,subtopology top
                        (IMAGE (kolmogorov_quotient top) (topspace top)))
                 (kolmogorov_quotient top)"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top:A->bool"]
          OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN) THEN
    REWRITE_TAC [SUBTOPOLOGY_TOPSPACE])

  let CLOSED_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT ← prove
   r"!top u:A->bool.
        closed_in top u
        ==> IMAGE (kolmogorov_quotient top) u =
            IMAGE (kolmogorov_quotient top) (topspace top) INTER u"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP KOLMOGOROV_QUOTIENT_IN_CLOSED) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN SET_TAC [])

  let CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN ← prove
   r"!top s:A->bool.
        closed_map (subtopology top s,
                  subtopology top (IMAGE (kolmogorov_quotient top) s))
                 (kolmogorov_quotient top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closed_map, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"u:A->bool") THEN
    MP_TAC (← GEN (← q r"x:A") (← ISPECL [← q r"top:A topology", ← q r"u:A->bool",
      ← q r"x:A"] KOLMOGOROV_QUOTIENT_IN_CLOSED)) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let CLOSED_MAP_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        closed_map (top,subtopology top
                        (IMAGE (kolmogorov_quotient top) (topspace top)))
                   (kolmogorov_quotient top)"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top:A->bool"]
          CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN) THEN
    REWRITE_TAC [SUBTOPOLOGY_TOPSPACE])

  let QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN ← prove
   r"!top s:A->bool.
        quotient_map (subtopology top s,
                      subtopology top (IMAGE (kolmogorov_quotient top) s))
                     (kolmogorov_quotient top)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC CONTINUOUS_OPEN_IMP_QUOTIENT_MAP THEN
    REWRITE_TAC [OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN] THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
              CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    MP_TAC (← ISPECL [← q r"top:A topology"] KOLMOGOROV_QUOTIENT_IN_TOPSPACE) THEN
    SET_TAC [])

  let QUOTIENT_MAP_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        quotient_map (top,subtopology top
                         (IMAGE (kolmogorov_quotient top) (topspace top)))
                     (kolmogorov_quotient top)"
   (GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top:A->bool"]
          QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN) THEN
    REWRITE_TAC [SUBTOPOLOGY_TOPSPACE])

  let KOLMOGOROV_QUOTIENT_EQ ← prove
   r"!top x y:A.
        kolmogorov_quotient top x = kolmogorov_quotient top y <=>
        !u. open_in top u ==> (x IN u <=> y IN u)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [KOLMOGOROV_QUOTIENT_IN_OPEN], SIMP_TAC [kolmogorov_quotient]])

  let KOLMOGOROV_QUOTIENT_EQ_ALT ← prove
   r"!top x y:A.
        kolmogorov_quotient top x = kolmogorov_quotient top y <=>
        !u. closed_in top u ==> (x IN u <=> y IN u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [KOLMOGOROV_QUOTIENT_EQ] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do
     pure (MP_TAC (← SPEC (← q r"topspace top:A->bool") th) THEN
           MP_TAC (← SPEC (← q r"(topspace top DIFF u):A->bool") th))) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_TOPSPACE,
                  CLOSED_IN_TOPSPACE]
    THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET),
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)] THEN
    SET_TAC [])

  let KOLMOGOROV_QUOTIENT_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B) x.
        continuous_map (top,top') f /\ t0_space top' /\ x IN topspace top
        ==> f (kolmogorov_quotient top x) = f x"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~p ==> F")] THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o CONJUNCT1 o REWRITE_RULE [continuous_map]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [t0_space]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"(f:A->B) (kolmogorov_quotient top x)", ← q r"(f:A->B) x"]) THEN
    ASM_SIMP_TAC [KOLMOGOROV_QUOTIENT_IN_TOPSPACE] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:B->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology",
      ← q r"{y | y IN topspace top /\ (f:A->B) y IN v}",
      ← q r"x:A"] KOLMOGOROV_QUOTIENT_IN_OPEN) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, KOLMOGOROV_QUOTIENT_IN_TOPSPACE] THEN
    ASM_MESON_TAC [OPEN_IN_CONTINUOUS_MAP_PREIMAGE])

  let T0_SPACE_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        t0_space (subtopology top
                   (IMAGE (kolmogorov_quotient top) (topspace top)))"
   (REWRITE_TAC [t0_space, TOPSPACE_SUBTOPOLOGY, IMP_CONJ] THEN
    REWRITE_TAC [IN_INTER, IMP_CONJ_ALT, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:A") THEN SIMP_TAC [KOLMOGOROV_QUOTIENT_IN_TOPSPACE] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    REWRITE_TAC [KOLMOGOROV_QUOTIENT_EQ, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, NOT_FORALL_THM, NOT_IMP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    STRIP_TAC THEN ASM_SIMP_TAC [IN_INTER, FUN_IN_IMAGE] THEN
    ASM_SIMP_TAC [KOLMOGOROV_QUOTIENT_IN_OPEN])

  let KOLMOGOROV_QUOTIENT_ID ← prove
   r"!top x:A. t0_space top /\ x IN topspace top
             ==> kolmogorov_quotient top x = x"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"\x:A. x") o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ_ALT] KOLMOGOROV_QUOTIENT_CONTINUOUS_MAP)) THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID])

  let KOLMOGOROV_QUOTIENT_IDEMP ← prove
   r"!top x:A.
    kolmogorov_quotient top (kolmogorov_quotient top x) =
    kolmogorov_quotient top x"
   (REWRITE_TAC [KOLMOGOROV_QUOTIENT_EQ, KOLMOGOROV_QUOTIENT_IN_OPEN])

  let RETRACTION_MAPS_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        retraction_maps
         (top,
          subtopology top (IMAGE (kolmogorov_quotient top) (topspace top)))
         (kolmogorov_quotient top,I)"
   (GEN_TAC THEN
    REWRITE_TAC [retraction_maps, CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT,
                 CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, I_DEF] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IMP_CONJ_ALT] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, KOLMOGOROV_QUOTIENT_IDEMP])

  let RETRACTION_MAP_KOLMOGOROV_QUOTIENT ← prove
   r"!top:A topology.
        retraction_map
         (top,
          subtopology top (IMAGE (kolmogorov_quotient top) (topspace top)))
         (kolmogorov_quotient top)"
   (REWRITE_TAC [retraction_map] THEN
    MESON_TAC [RETRACTION_MAPS_KOLMOGOROV_QUOTIENT])

  let RETRACT_OF_SPACE_KOLMOGOROV_QUOTIENT_IMAGE ← prove
   r"!top:A topology.
        IMAGE (kolmogorov_quotient top) (topspace top)
        retract_of_space top"
   (GEN_TAC THEN REWRITE_TAC [RETRACT_OF_SPACE_RETRACTION_MAPS] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, KOLMOGOROV_QUOTIENT_IN_TOPSPACE] THEN
    MESON_TAC [RETRACTION_MAPS_KOLMOGOROV_QUOTIENT])

  let KOLMOGOROV_QUOTIENT_LIFT_EXISTS ← prove
   r"!top top' (f:A->B) s.
      s SUBSET topspace top /\ t0_space top' /\
      continuous_map (subtopology top s,top') f
      ==> ?g. continuous_map
               (subtopology top (IMAGE (kolmogorov_quotient top) s), top') g /\
              !x. x IN s ==> g(kolmogorov_quotient top x) = f x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
     QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN) THEN
    DISCH_THEN (MP_TAC o ISPECL [← q r"top':B topology", ← q r"f:A->B"] o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] QUOTIENT_MAP_LIFT_EXISTS)) THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, ← sr
     r"s SUBSET u ==> u INTER s = s"] THEN
    ANTS_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [KOLMOGOROV_QUOTIENT_EQ] THEN STRIP_TAC THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [t0_space]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"(f:A->B) x", ← q r"(f:A->B) y"]) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_map]) THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, ← sr
     r"s SUBSET u ==> u INTER s = s"] THEN
    STRIP_TAC THEN DISCH_THEN (X_CHOOSE_THEN (← q r"v:B->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:B->bool")) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    ASM SET_TAC [])

  return { kolmogorov_quotient, KOLMOGOROV_QUOTIENT_IN_OPEN, KOLMOGOROV_QUOTIENT_IN_TOPSPACE,
           KOLMOGOROV_QUOTIENT_IN_CLOSED, CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT,
           OPEN_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT, OPEN_MAP_KOLMOGOROV_QUOTIENT_GEN,
           OPEN_MAP_KOLMOGOROV_QUOTIENT, CLOSED_MAP_KOLMOGOROV_QUOTIENT_EXPLICIT,
           CLOSED_MAP_KOLMOGOROV_QUOTIENT_GEN, CLOSED_MAP_KOLMOGOROV_QUOTIENT,
           QUOTIENT_MAP_KOLMOGOROV_QUOTIENT_GEN, QUOTIENT_MAP_KOLMOGOROV_QUOTIENT,
           KOLMOGOROV_QUOTIENT_EQ, KOLMOGOROV_QUOTIENT_EQ_ALT,
           KOLMOGOROV_QUOTIENT_CONTINUOUS_MAP, T0_SPACE_KOLMOGOROV_QUOTIENT,
           KOLMOGOROV_QUOTIENT_ID, KOLMOGOROV_QUOTIENT_IDEMP,
           RETRACTION_MAPS_KOLMOGOROV_QUOTIENT, RETRACTION_MAP_KOLMOGOROV_QUOTIENT,
           RETRACT_OF_SPACE_KOLMOGOROV_QUOTIENT_IMAGE, KOLMOGOROV_QUOTIENT_LIFT_EXISTS }

/- ------------------------------------------------------------------------- -/
/- Regular spaces. These are *not* a priori assumed to be Hausdorff/T_1.     -/
/- (metric.ml 16516-16714)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Regular1 where
  regular_space : thm
  HOMEOMORPHIC_REGULAR_SPACE : thm
  REGULAR_SPACE : thm
  NEIGHBOURHOOD_BASE_OF_CLOSED_IN : thm
  REGULAR_SPACE_DISCRETE_TOPOLOGY : thm
  REGULAR_SPACE_SUBTOPOLOGY : thm
  REGULAR_SPACE_RETRACTION_MAP_IMAGE : thm
  REGULAR_T0_IMP_HAUSDORFF_SPACE : thm
  REGULAR_T0_EQ_HAUSDORFF_SPACE : thm
  REGULAR_T1_IMP_HAUSDORFF_SPACE : thm
  REGULAR_T1_EQ_HAUSDORFF_SPACE : thm
  COMPACT_HAUSDORFF_IMP_REGULAR_SPACE : thm
  NEIGHBOURHOOD_BASE_OF_CLOSED_HAUSDORFF_SPACE : thm
  LOCALLY_COMPACT_IMP_KC_EQ_HAUSDORFF_SPACE : thm
  REGULAR_SPACE_MTOPOLOGY : thm
  METRIZABLE_IMP_REGULAR_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupRegular1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BHomeoSpace : HomeoSpace) (BRetractOf : RetractOf) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BKC1 : KC1)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BNbhdBase : NbhdBase) (BT0a : T0a) : ExceptT String IO Regular1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC,
        new_definition, .. } := D
  let { CONJ_ASSOC, ETA_AX, EXISTS_IN_GSPEC, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM,
        .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_DIFF, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SWAP_FORALL_THM, .. } := D.core4
  let { RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { CLOSED_IN_SUBSET, EXISTS_CLOSED_IN, FORALL_OPEN_IN, OPEN_IN_DIFF, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_DISCRETE_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY,
        .. } := BDiscrete
  let { CLOSED_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY,
        .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY,
        .. } := BClosure
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { FORALL_CLOSED_IN_HOMEOMORPHIC_IMAGE, FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE,
        .. } := BHomeo2
  let { homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SING, .. } := BCompact1
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_COMPACT_SETS, HAUSDORFF_SPACE_SUBTOPOLOGY,
        hausdorff_space, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD, .. } := BHausdorff2
  let { HAUSDORFF_IMP_KC_SPACE, KC_IMP_T1_SPACE, kc_space, .. } := BKC1
  let { CENTRE_IN_MBALL, IN_MBALL, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY,
        .. } := BMTopology
  let { metrizable_space, .. } := BMetrizable
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, .. } := BNbhdBase
  let { HAUSDORFF_IMP_T0_SPACE, T0_SPACE, T1_IMP_T0_SPACE, .. } := BT0a
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let regular_space ← new_definition
   r"regular_space top <=>
        !c a:A. closed_in top c /\ a IN topspace top DIFF c
                ==> ?u v. open_in top u /\ open_in top v /\
                          a IN u /\ c SUBSET v /\ DISJOINT u v"

  let HOMEOMORPHIC_REGULAR_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (regular_space top <=> regular_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN DISCH_TAC THEN
    REWRITE_TAC [regular_space, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN REWRITE_TAC [← MESON [] (← q
     r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1) THEN DISCH_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE th] THEN
            REWRITE_TAC [← MATCH_MP FORALL_CLOSED_IN_HOMEOMORPHIC_IMAGE th])) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN ASM_CASES_TAC (← q r"closed_in top (c:A->bool)") THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    SUBGOAL_THEN
     (← q r"topspace top' DIFF IMAGE (f:A->B) c = IMAGE f (topspace top DIFF c)")
    SUBST1_TAC THENL [ASM SET_TAC [], REWRITE_TAC [FORALL_IN_IMAGE]] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top DIFF c") THEN
    ASM_REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, RIGHT_AND_EXISTS_THM] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN ONCE_REWRITE_TAC [CONJ_ASSOC] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let REGULAR_SPACE ← prove
   r"!top:A topology.
        regular_space top <=>
        !c a. closed_in top c /\ a IN topspace top DIFF c
              ==> ?u. open_in top u /\ a IN u /\
                      DISJOINT c (top closure_of u)"
   (GEN_TAC THEN REWRITE_TAC [regular_space] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN REWRITE_TAC [] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"a:A") THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")) THEN STRIP_TAC THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
       r"t SUBSET v ==> v INTER c = {} ==> DISJOINT t c")) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY] THEN ASM SET_TAC [],
      STRIP_TAC THEN EXISTS_TAC (← q r"topspace top DIFF top closure_of u:A->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, CLOSED_IN_CLOSURE_OF] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool"] CLOSURE_OF_SUBSET) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let NEIGHBOURHOOD_BASE_OF_CLOSED_IN ← prove
   r"!top:A topology.
      neighbourhood_base_of (closed_in top) top <=> regular_space top"
   (GEN_TAC THEN REWRITE_TAC [NEIGHBOURHOOD_BASE_OF, regular_space] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_OPEN_IN] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN REPEAT
     (MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> ((p ==> q) <=> (p ==> r))")) THEN
      DISCH_TAC) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN REWRITE_TAC [EXISTS_CLOSED_IN] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC THEN
     MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
     DISCH_THEN (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let REGULAR_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!s:A->bool. regular_space(discrete_topology s)"
   (GEN_TAC THEN
    REWRITE_TAC [regular_space, CLOSED_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"a:A"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"{a:A}", ← q r"c:A->bool"] THEN ASM SET_TAC [])

  let REGULAR_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        regular_space top ==> regular_space(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [regular_space] THEN DISCH_TAC THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, IMP_CONJ, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, TOPSPACE_SUBTOPOLOGY] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN REWRITE_TAC [IN_DIFF, IN_INTER] THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:A->bool", ← q r"a:A"]) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC [])

  let REGULAR_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ regular_space top
        ==> regular_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [REGULAR_SPACE_SUBTOPOLOGY, HOMEOMORPHIC_REGULAR_SPACE])

  let REGULAR_T0_IMP_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ t0_space top ==> hausdorff_space top"
   (REWRITE_TAC [regular_space, T0_SPACE, hausdorff_space, IN_DIFF] THEN
    GEN_TAC THEN STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"c:A->bool") THEN
    REWRITE_TAC [← TAUT (← q r"~(p <=> q) <=> p /\ ~q \/ q /\ ~p")] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:A->bool")) THENL
     [DISCH_THEN (MP_TAC o SPEC (← q r"y:A")), DISCH_THEN (MP_TAC o SPEC (← q r"x:A"))] THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let REGULAR_T0_EQ_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        regular_space top ==> (t0_space top <=> hausdorff_space top)"
   (MESON_TAC [REGULAR_T0_IMP_HAUSDORFF_SPACE, HAUSDORFF_IMP_T0_SPACE])

  let REGULAR_T1_IMP_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ t1_space top ==> hausdorff_space top"
   (MESON_TAC [REGULAR_T0_IMP_HAUSDORFF_SPACE, T1_IMP_T0_SPACE])

  let REGULAR_T1_EQ_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        regular_space top ==> (t1_space top <=> hausdorff_space top)"
   (MESON_TAC [REGULAR_T1_IMP_HAUSDORFF_SPACE, HAUSDORFF_IMP_T1_SPACE])

  let COMPACT_HAUSDORFF_IMP_REGULAR_SPACE ← prove
   r"!top:A topology.
        compact_space top /\ hausdorff_space top ==> regular_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [regular_space, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"a:A"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HAUSDORFF_SPACE_COMPACT_SETS]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"{a:A}", ← q r"s:A->bool"]) THEN
    ASM_SIMP_TAC [CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC [])

  let NEIGHBOURHOOD_BASE_OF_CLOSED_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ hausdorff_space top <=>
        neighbourhood_base_of
         (\c. closed_in top c /\ hausdorff_space(subtopology top c)) top"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON [] (← q
     r"(h ==> (n <=> r)) /\ (n ==> h) ==> (r /\ h <=> n)")) THEN
    SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [ETA_AX, NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
    GEN_REWRITE_TAC RAND_CONV [HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"topspace top:A->bool")) THEN
    REWRITE_TAC [OPEN_IN_TOPSPACE] THEN MESON_TAC [])

  let LOCALLY_COMPACT_IMP_KC_EQ_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        neighbourhood_base_of (compact_in top) top
        ==> (kc_space top <=> hausdorff_space top)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [HAUSDORFF_IMP_KC_SPACE] THEN
    DISCH_TAC THEN MATCH_MP_TAC REGULAR_T1_IMP_HAUSDORFF_SPACE THEN
    ASM_SIMP_TAC [KC_IMP_T1_SPACE, ← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          NEIGHBOURHOOD_BASE_OF_MONO)) THEN
    ASM_REWRITE_TAC [← GSYM kc_space])

  let REGULAR_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. regular_space(mtopology m)"
   (GEN_TAC THEN REWRITE_TAC [regular_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"a:A"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"open_in (mtopology m) (topspace(mtopology m) DIFF c:A->bool)")
    MP_TAC THENL [ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE], ALL_TAC] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [OPEN_IN_MTOPOLOGY] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:A") o CONJUNCT2) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, TOPSPACE_MTOPOLOGY] THEN
    X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"mball m (a:A,r / &2)") THEN
    EXISTS_TAC (← q r"topspace(mtopology m) DIFF mcball m (a:A,r / &2)") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IN_DIFF, TOPSPACE_MTOPOLOGY]) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_MCBALL, OPEN_IN_MBALL, OPEN_IN_TOPSPACE,
                  CENTRE_IN_MBALL, REAL_HALF] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
       r"b SUBSET m DIFF c
        ==> c SUBSET m /\ b' SUBSET b  ==> c SUBSET m DIFF b'")) THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_SUBSET, TOPSPACE_MTOPOLOGY],
        ASM_SIMP_TAC [SUBSET, IN_MBALL, IN_MCBALL] THEN ASM_REAL_ARITH_TAC],
      MATCH_MP_TAC (← sr
       r"(!x. x IN s ==> x IN t) ==> DISJOINT s (u DIFF t)") THEN
      ASM_SIMP_TAC [SUBSET, IN_MBALL, IN_MCBALL] THEN ASM_REAL_ARITH_TAC])

  let METRIZABLE_IMP_REGULAR_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> regular_space top"
   (MESON_TAC [metrizable_space, REGULAR_SPACE_MTOPOLOGY])

  return { regular_space, HOMEOMORPHIC_REGULAR_SPACE, REGULAR_SPACE,
           NEIGHBOURHOOD_BASE_OF_CLOSED_IN, REGULAR_SPACE_DISCRETE_TOPOLOGY,
           REGULAR_SPACE_SUBTOPOLOGY, REGULAR_SPACE_RETRACTION_MAP_IMAGE,
           REGULAR_T0_IMP_HAUSDORFF_SPACE, REGULAR_T0_EQ_HAUSDORFF_SPACE,
           REGULAR_T1_IMP_HAUSDORFF_SPACE, REGULAR_T1_EQ_HAUSDORFF_SPACE,
           COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, NEIGHBOURHOOD_BASE_OF_CLOSED_HAUSDORFF_SPACE,
           LOCALLY_COMPACT_IMP_KC_EQ_HAUSDORFF_SPACE, REGULAR_SPACE_MTOPOLOGY,
           METRIZABLE_IMP_REGULAR_SPACE }

/- ------------------------------------------------------------------------- -/
/- Regular spaces: compact/closed separation, products.                      -/
/- (metric.ml 16716-16855)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Regular2 where
  REGULAR_SPACE_COMPACT_CLOSED_SEPARATION : thm
  REGULAR_SPACE_COMPACT_CLOSED_SETS : thm
  REGULAR_SPACE_PROD_TOPOLOGY : thm
  REGULAR_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupRegular2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BProd1 : Prod1)
    (BProduct1 : Product1) (BProduct2 : Product2) (BProduct3 : Product3)
    (BHomeoSpace : HomeoSpace) (BCompact1 : Compact1) (BNbhdBase : NbhdBase)
    (BRegular1 : Regular1) : ExceptT String IO Regular2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { CROSS_EQ_EMPTY, EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FINITE_SUBSET,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_CROSS, IN_DIFF, IN_ELIM_THM, LEFT_IMP_EXISTS_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SKOLEM_THM, SUBSET,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_TRANS, UNIONS_IMAGE, cartesian_product,
        .. } := D.core4
  let { DE_MORGAN_THM, FORALL_PAIR_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_EMPTY, OPEN_IN_INTERS, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_CROSS, OPEN_IN_CROSS, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { OPEN_IN_PRODUCT_TOPOLOGY, PRODUCT_TOPOLOGY_BASE_ALT, TOPSPACE_PRODUCT_TOPOLOGY,
        .. } := BProduct1
  let { OPEN_IN_CARTESIAN_PRODUCT_GEN, .. } := BProduct2
  let { CLOSED_IN_CARTESIAN_PRODUCT, .. } := BProduct3
  let { TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT, TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT,
        .. } := BHomeoSpace
  let { COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE, compact_in, .. } := BCompact1
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE, .. } := BNbhdBase
  let { HOMEOMORPHIC_REGULAR_SPACE, NEIGHBOURHOOD_BASE_OF_CLOSED_IN, REGULAR_SPACE_SUBTOPOLOGY,
        regular_space, .. } := BRegular1
  -- @@SCOPE END

  let REGULAR_SPACE_COMPACT_CLOSED_SEPARATION ← prove
   r"!top s t:A->bool.
        regular_space top /\
        compact_in top s /\ closed_in top t /\ DISJOINT s t
        ==> ?u v. open_in top u /\ open_in top v /\
                  s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"{}:A->bool", ← q r"topspace top:A->bool"] THEN
      ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY] THEN
      ASM_SIMP_TAC [CLOSED_IN_SUBSET] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x:A. ?u v.
          x IN s ==> open_in top u /\ open_in top v /\
                     x IN u /\ t SUBSET v /\ DISJOINT u v")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN ASM_CASES_TAC (← q r"(x:A) IN s") THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t:A->bool", ← q r"x:A"] o
          REWRITE_RULE [regular_space]) THEN
      ASM_REWRITE_TAC [IN_DIFF] THEN DISCH_THEN MATCH_MP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->A->bool", ← q r"v:A->A->bool"] THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"compact_in top (s:A->bool)") THEN REWRITE_TAC [compact_in] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (MP_TAC o SPEC (← q r"IMAGE (u:A->A->bool) s"))) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
    ANTS_TAC THENL [SIMP_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS(IMAGE (u:A->A->bool) k)") THEN
    EXISTS_TAC (← q r"INTERS(IMAGE (v:A->A->bool) k)") THEN
    CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC OPEN_IN_INTERS THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
    ASM SET_TAC [])

  let REGULAR_SPACE_COMPACT_CLOSED_SETS ← prove
   r"!top:A topology.
        regular_space top <=>
        !s t. compact_in top s /\ closed_in top t /\ DISJOINT s t
              ==> ?u v. open_in top u /\ open_in top v /\
                        s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [REGULAR_SPACE_COMPACT_CLOSED_SEPARATION] THEN
    DISCH_TAC THEN REWRITE_TAC [regular_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r" x:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"s:A->bool"]) THEN
    ASM_REWRITE_TAC [SING_SUBSET, COMPACT_IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MESON_TAC []])

  let REGULAR_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        regular_space (prod_topology top1 top2) <=>
        topspace (prod_topology top1 top2) = {} \/
        regular_space top1 /\ regular_space top2"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_REGULAR_SPACE] THEN
      SIMP_TAC [REGULAR_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(topspace top1 CROSS topspace top2):A#B->bool = {}") THEN
    ASM_REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THENL
     [ASM_REWRITE_TAC [regular_space, TOPSPACE_PROD_TOPOLOGY, IN_DIFF,
                       NOT_IN_EMPTY],
      FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [CROSS_EQ_EMPTY]) THEN
      REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC] THEN
    REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF, FORALL_PAIR_THM] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"w:A#B->bool", ← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:B->bool", ← q r"y:B"]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"d1:A->bool", ← q r"c1:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"d2:B->bool", ← q r"c2:B->bool"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"(d1:A->bool) CROSS (d2:B->bool)") THEN
    EXISTS_TAC (← q r"(c1:A->bool) CROSS (c2:B->bool)") THEN
    ASM_SIMP_TAC [SUBSET_CROSS, OPEN_IN_CROSS, CLOSED_IN_CROSS, IN_CROSS] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        SUBSET_TRANS)) THEN
    ASM_REWRITE_TAC [SUBSET_CROSS])

  let REGULAR_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        regular_space (product_topology k tops) <=>
        topspace (product_topology k tops) = {} \/
        !i. i IN k ==> regular_space (tops i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_REGULAR_SPACE] THEN
      SIMP_TAC [REGULAR_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC
     (← q r"cartesian_product k (topspace o (tops:K->A topology)) = {}") THEN
    ASM_REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THENL
     [ASM_REWRITE_TAC [regular_space, TOPSPACE_PRODUCT_TOPOLOGY,
                       IN_DIFF, NOT_IN_EMPTY],
      ALL_TAC] THEN
    REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN DISCH_TAC THEN
    REWRITE_TAC [← MATCH_MP NEIGHBOURHOOD_BASE_OF_TOPOLOGY_BASE
     (← SPEC_ALL OPEN_IN_PRODUCT_TOPOLOGY)] THEN
    REWRITE_TAC [PRODUCT_TOPOLOGY_BASE_ALT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"w:K->A->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:K->A") THEN DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [NEIGHBOURHOOD_BASE_OF, RIGHT_IMP_FORALL_THM, IMP_IMP]) THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"i:K") o SPECL
     [← q r"i:K", ← q r"(w:K->A->bool) i", ← q r"(x:K->A) i"]) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [cartesian_product]) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, IMP_CONJ] THEN DISCH_TAC THEN DISCH_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:K->A->bool", ← q r"c:K->A->bool"] THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"cartesian_product k
        (\i. if w i = topspace(tops i) then topspace(tops i)
             else (u:K->A->bool) i)",
      ← q r"cartesian_product k
        (\i. if w i = topspace(tops i) then topspace(tops i)
             else (c:K->A->bool) i)"] THEN
    REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN DISJ2_TAC THEN
      CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [OPEN_IN_TOPSPACE]] THEN
      FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
      SET_TAC [],
      REWRITE_TAC [CLOSED_IN_CARTESIAN_PRODUCT] THEN DISJ2_TAC THEN
      ASM_MESON_TAC [CLOSED_IN_TOPSPACE],
      ASM_REWRITE_TAC [IN_ELIM_THM, cartesian_product] THEN
      ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET],
      REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN ASM SET_TAC [],
      REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN ASM SET_TAC []])

  return { REGULAR_SPACE_COMPACT_CLOSED_SEPARATION, REGULAR_SPACE_COMPACT_CLOSED_SETS,
           REGULAR_SPACE_PROD_TOPOLOGY, REGULAR_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Regular spaces: paired closed maps, images.  (metric.ml 16857-17107)      -/
/- ------------------------------------------------------------------------- -/

structure Regular3 where
  CLOSED_MAP_PAIRED_GEN : thm
  CLOSED_MAP_PAIRED : thm
  CLOSED_MAP_PAIRWISE : thm
  CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT : thm
  CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT : thm
  CLOSED_MAP_IMP_CLOSED_GRAPH : thm
  PROPER_MAP_PAIRED_CLOSED_MAP_RIGHT : thm
  PROPER_MAP_PAIRED_CLOSED_MAP_LEFT : thm
  REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE : thm
  REGULAR_SPACE_PERFECT_MAP_IMAGE : thm
  REGULAR_SPACE_PERFECT_MAP_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupRegular3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2) (BProd1 : Prod1)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BCompact1 : Compact1) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BProper1 : Proper1) (BPerfect : Perfect) (BNbhdBase : NbhdBase)
    (BRegular1 : Regular1) (BRegular2 : Regular2) : ExceptT String IO Regular3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_IMP, IN_CROSS, IN_DIFF, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_CROSS, o_DEF, .. } := D.core4
  let { FORALL_PAIR_FUN_THM, FORALL_PAIR_THM, LEFT_AND_EXISTS_THM, PAIR_EQ,
        RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF,
        OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNION,
        closed_in, .. } := BTopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_ID, OPEN_IN_CONTINUOUS_MAP_PREIMAGE,
        .. } := BContMap1
  let { CLOSED_MAP_COMPOSE, CLOSED_MAP_ID, CLOSED_MAP_IMP_SUBSET_TOPSPACE, closed_map,
        .. } := BOpenClosed1
  let { CLOSED_MAP_FIBRE_NEIGHBOURHOOD, CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD, .. } := BOpenClosed2
  let { OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { HOMEOMORPHIC_IMP_CLOSED_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_SWAP, .. } := BHomeo2
  let { CLOSED_INTER_COMPACT_IN, COMPACT_IN_SING, .. } := BCompact1
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { HAUSDORFF_SPACE_COMPACT_SEPARATION, .. } := BHausdorff1
  let { CLOSED_INJECTIVE_IMP_PROPER_MAP, proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, regular_space, .. } := BRegular1
  let { REGULAR_SPACE_COMPACT_CLOSED_SETS, .. } := BRegular2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CLOSED_MAP_PAIRED_GEN ← do
    let lemma ← prove
     r"!top top1 top2 (f:A->B) (g:A->C).
          regular_space top2 /\
          closed_map(top,top1) f /\
          closed_map(top,top2) g /\
          (!y. y IN topspace top1
               ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
          continuous_map(top,top2) g
          ==> closed_map (top,prod_topology top1 top2) (\x. f x,g x)"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE (f:A->B) (topspace top) SUBSET topspace top1 /\
        IMAGE (g:A->C) (topspace top) SUBSET topspace top2")
      STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_MAP_IMP_SUBSET_TOPSPACE], ALL_TAC] THEN
      REWRITE_TAC [closed_map] THEN X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      REWRITE_TAC [closed_in] THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE,
                     TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
        ASM SET_TAC [],
        GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN]] THEN
      REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY,
                   IN_DIFF, IN_CROSS] THEN
      MAP_EVERY X_GEN_TAC [← q r"y1:B", ← q r"y2:C"] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?v v'. open_in top2 v /\ closed_in top2 v' /\ v SUBSET v' /\
               y2 IN v /\
               {x | x IN topspace top /\ (g:A->C) x IN v'} SUBSET
               topspace top DIFF
               c INTER {x | x IN topspace top /\ (f:A->B) x = y1}")
      STRIP_ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"closed_map (top,top2) (g:A->C)") THEN
        ASM_REWRITE_TAC [CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN
        DISCH_THEN (MP_TAC o SPECL
         [← q r"topspace top DIFF
           (c INTER {x | x IN topspace top /\ (f:A->B) x = y1})",
          ← q r"y2:C"]) THEN
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, CLOSED_IN_INTER] THEN
        ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"v:C->bool") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
         [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
        REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"v:C->bool", ← q r"y2:C"]) THEN
        ASM_REWRITE_TAC [] THEN
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC [],
        ALL_TAC] THEN
      UNDISCH_TAC (← q r"closed_map (top,top1) (f:A->B)") THEN
      ASM_REWRITE_TAC [CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN
      DISCH_THEN (MP_TAC o SPECL
       [← q r"topspace top DIFF c INTER {x | x IN topspace top /\ (g:A->C) x IN v'}",
        ← q r"y1:B"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        MATCH_MP_TAC CLOSED_IN_INTER THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        ASM_MESON_TAC [],
        DISCH_THEN (X_CHOOSE_THEN (← q r"u:B->bool") STRIP_ASSUME_TAC)] THEN
      EXISTS_TAC (← q r"(u:B->bool) CROSS (v:C->bool)") THEN
      ASM_REWRITE_TAC [IN_CROSS, OPEN_IN_CROSS, ← sr
       r"s SUBSET t DIFF IMAGE f u <=>
        s SUBSET t /\ (!x. x IN u ==> ~(f x IN s))"] THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET, SUBSET_CROSS] THEN ASM SET_TAC [])
    prove
     r"!top top1 top2 (f:A->B) (g:A->C).
        closed_map(top,top1) f /\
        closed_map(top,top2) g /\
        (regular_space top1 /\ continuous_map(top,top1) f /\
         (!z. z IN topspace top2
              ==> closed_in top {x | x IN topspace top /\ g x = z}) \/
         regular_space top2 /\ continuous_map(top,top2) g /\
         (!y. y IN topspace top1
              ==> closed_in top {x | x IN topspace top /\ f x = y}))
        ==> closed_map (top,prod_topology top1 top2) (\x. f x,g x)"
     (REPEAT STRIP_TAC THENL
       [ALL_TAC, MATCH_MP_TAC lemma THEN ASM SET_TAC []] THEN
      SUBGOAL_THEN
       (← q r"(\x. (f:A->B) x,(g:A->C) x) = (\(x,y). y,x) o (\x. g x,f x)")
      SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology top2 top1:(C#B)topology") THEN
      SIMP_TAC [HOMEOMORPHIC_IMP_CLOSED_MAP, HOMEOMORPHIC_MAP_SWAP] THEN
      MATCH_MP_TAC lemma THEN ASM_REWRITE_TAC [])

  let CLOSED_MAP_PAIRED ← prove
   r"!top top1 top2 (f:A->B) (g:A->C).
        closed_map(top,top1) f /\ continuous_map(top,top1) f /\
        closed_map(top,top2) g /\ continuous_map(top,top2) g /\
        (t1_space top1 /\ regular_space top2 \/
         regular_space top1 /\ t1_space top2)
        ==> closed_map (top,prod_topology top1 top2) (\x. f x,g x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_MAP_PAIRED_GEN THEN
    ASM_REWRITE_TAC [] THENL [DISJ2_TAC, DISJ1_TAC] THEN
    REPEAT STRIP_TAC THEN
    REWRITE_TAC [← GSYM IN_SING] THEN
    MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
    ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING])

  let CLOSED_MAP_PAIRWISE ← prove
   r"!top top1 top2 f:A->B#C.
        closed_map(top,top1) (FST o f) /\ continuous_map(top,top1) (FST o f) /\
        closed_map(top,top2) (SND o f) /\ continuous_map(top,top2) (SND o f) /\
        (t1_space top1 /\ regular_space top2 \/
         regular_space top1 /\ t1_space top2)
        ==> closed_map (top,prod_topology top1 top2) f"
   (REWRITE_TAC [FORALL_PAIR_FUN_THM, o_DEF, ETA_AX] THEN
    REWRITE_TAC [CLOSED_MAP_PAIRED])

  let CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!y. y IN topspace top'
              ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
        regular_space top
        ==> closed_map(top,prod_topology top top') (\x. x,f x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_MAP_PAIRED_GEN THEN
    ASM_REWRITE_TAC [CLOSED_MAP_ID, CONTINUOUS_MAP_ID])

  let CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!y. y IN topspace top'
              ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
        regular_space top
        ==> closed_map(top,prod_topology top' top) (\x. f x,x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. (f:A->B) x,x) = (\(a,b). b,a) o (\x. x,f x)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_topology top top':(A#B)topology") THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT] THEN
    MATCH_MP_TAC HOMEOMORPHIC_IMP_CLOSED_MAP THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_SWAP])

  let CLOSED_MAP_IMP_CLOSED_GRAPH ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!y. y IN topspace top'
              ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
        regular_space top
        ==> closed_in (prod_topology top top') {x,f x | x IN topspace top}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"closed_map(top,prod_topology top top') (\x. x,(f:A->B) x)")
    MP_TAC THENL
     [MATCH_MP_TAC CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [closed_map, SIMPLE_IMAGE] THEN DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [CLOSED_IN_TOPSPACE]])

  let PROPER_MAP_PAIRED_CLOSED_MAP_RIGHT ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!y. y IN topspace top'
              ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
        regular_space top
        ==> proper_map(top,prod_topology top top') (\x. x,f x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_INJECTIVE_IMP_PROPER_MAP THEN
    SIMP_TAC [PAIR_EQ] THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT])

  let PROPER_MAP_PAIRED_CLOSED_MAP_LEFT ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!y. y IN topspace top'
              ==> closed_in top {x | x IN topspace top /\ f x = y}) /\
        regular_space top
        ==> proper_map(top,prod_topology top' top) (\x. f x,x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_INJECTIVE_IMP_PROPER_MAP THEN
    SIMP_TAC [PAIR_EQ] THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT])

  let REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        regular_space top /\
        continuous_map(top,top') f /\
        proper_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> regular_space top'"
   (REWRITE_TAC [proper_map] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [regular_space, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:B->bool", ← q r"x:B"] THEN STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE id [REGULAR_SPACE_COMPACT_CLOSED_SETS]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"{z | z IN topspace top /\ (f:A->B) z = x}",
      ← q r"{z | z IN topspace top /\ (f:A->B) z IN c}"]) THEN
    ASM_SIMP_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o GEN_REWRITE_RULE id
     [CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD]) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"u:A->bool", ← q r"{x:B}"] th) THEN
            MP_TAC (← SPECL [← q r"v:A->bool", ← q r"c:B->bool"] th))) THEN
    ASM_REWRITE_TAC [SING_SUBSET, IN_SING, IMP_IMP, RIGHT_AND_EXISTS_THM] THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBSET, LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let REGULAR_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    regular_space top /\ perfect_map(top,top') f ==> regular_space top'"
   (REWRITE_TAC [perfect_map] THEN
    MESON_TAC [REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE])

  let REGULAR_SPACE_PERFECT_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
        hausdorff_space top /\ perfect_map(top,top') f
        ==> (regular_space top <=> regular_space top')"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [REGULAR_SPACE_PERFECT_MAP_IMAGE],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [perfect_map]) THEN
      REWRITE_TAC [proper_map, closed_map] THEN REPEAT STRIP_TAC] THEN
    REWRITE_TAC [regular_space, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
      [← q r"top:A topology", ← q r"{x:A}",
       ← q r"c INTER {z | z IN topspace top /\ (f:A->B) z = f x}"]
      HAUSDORFF_SPACE_COMPACT_SEPARATION) THEN
    ASM_REWRITE_TAC [COMPACT_IN_SING] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CLOSED_INTER_COMPACT_IN THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC [],
      REWRITE_TAC [SING_SUBSET, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
      [← q r"IMAGE (f:A->B) (c DIFF v)", ← q r"(f:A->B) x"] o
      GEN_REWRITE_RULE id [regular_space]) THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF] THEN ANTS_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC [],
      REWRITE_TAC [SING_SUBSET, LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u':B->bool", ← q r"v':B->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"u INTER {x | x IN topspace top /\ (f:A->B) x IN u'}",
      ← q r"v UNION {x | x IN topspace top /\ (f:A->B) x IN v'}"] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_INTER, MATCH_MP_TAC OPEN_IN_UNION] THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC []])

  return { CLOSED_MAP_PAIRED_GEN, CLOSED_MAP_PAIRED, CLOSED_MAP_PAIRWISE,
           CLOSED_MAP_PAIRED_CLOSED_MAP_RIGHT, CLOSED_MAP_PAIRED_CLOSED_MAP_LEFT,
           CLOSED_MAP_IMP_CLOSED_GRAPH, PROPER_MAP_PAIRED_CLOSED_MAP_RIGHT,
           PROPER_MAP_PAIRED_CLOSED_MAP_LEFT, REGULAR_SPACE_CONTINUOUS_PROPER_MAP_IMAGE,
           REGULAR_SPACE_PERFECT_MAP_IMAGE, REGULAR_SPACE_PERFECT_MAP_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- Locally compact spaces.  (metric.ml 17109-17315)                          -/
/- ------------------------------------------------------------------------- -/

structure LocCompact1 where
  locally_compact_space : thm
  HOMEOMORPHIC_LOCALLY_COMPACT_SPACE : thm
  LOCALLY_COMPACT_SPACE_RETRACTION_MAP_IMAGE : thm
  COMPACT_IMP_LOCALLY_COMPACT_SPACE : thm
  NEIGHBOURHOOD_BASE_IMP_LOCALLY_COMPACT_SPACE : thm
  LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE : thm
  LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE : thm
  LOCALLY_COMPACT_HAUSDORFF_OR_REGULAR : thm
  LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_IN : thm
  LOCALLY_COMPACT_SPACE_COMPACT_CLOSURE_OF : thm
  deriving Inhabited

@[nospecialize]
def setupLocCompact1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BRetractOf : RetractOf)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BHausdorff1 : Hausdorff1)
    (BNbhdBase : NbhdBase) (BRegular1 : Regular1) : ExceptT String IO LocCompact1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, EXISTS_IN_GSPEC, EXISTS_SUBSET_IMAGE, FORALL_IN_IMAGE,
        FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SUBSET, SUBSET_INTER, SUBSET_REFL, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_INTER, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, CLOSED_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY_ALT,
        OPEN_IN_SUBTOPOLOGY_INTER_OPEN, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET, .. } := BClosure
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE, HOMEOMORPHIC_MAP_MAPS,
        HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { homeomorphic_space, .. } := BHomeoSpace
  let { retraction_map, retraction_maps, .. } := BRetraction
  let { RETRACTION_MAPS_SECTION_IMAGE, retract_of_space, .. } := BRetractOf
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBSPACE, COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT,
        COMPACT_SPACE_SUBTOPOLOGY, compact_space, .. } := BCompact1
  let { HOMEOMORPHIC_COMPACT_SPACE, IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, .. } := BNbhdBase
  let { COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  -- @@SCOPE END

  let locally_compact_space ← new_definition
   r"locally_compact_space top <=>
    !x. x IN topspace top
        ==> ?u k. open_in top u /\ compact_in top k /\ x IN u /\ u SUBSET k"

  let HOMEOMORPHIC_LOCALLY_COMPACT_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (locally_compact_space top <=> locally_compact_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN DISCH_TAC THEN
    REWRITE_TAC [locally_compact_space] THEN
    SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)") SUBST1_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP],
      REWRITE_TAC [FORALL_IN_IMAGE, RIGHT_EXISTS_AND_THM]] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← MESON [] (← q
     r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1) THEN DISCH_THEN (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE th])) THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN REWRITE_TAC [COMPACT_IN_SUBSPACE] THEN
    SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)") SUBST1_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP],
      REWRITE_TAC [← GSYM CONJ_ASSOC, EXISTS_SUBSET_IMAGE]] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN
    ASM_CASES_TAC (← q r"(k:A->bool) SUBSET topspace top") THEN
    ASM_REWRITE_TAC [] THEN BINOP_TAC THENL
     [MATCH_MP_TAC HOMEOMORPHIC_COMPACT_SPACE THEN
      REWRITE_TAC [homeomorphic_space, ← GSYM HOMEOMORPHIC_MAP_MAPS] THEN
      EXISTS_TAC (← q r"f:A->B") THEN MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
      ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
      ASM SET_TAC [],
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      ASM SET_TAC []])

  let LOCALLY_COMPACT_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map (top,top') r /\ locally_compact_space top
        ==> locally_compact_space top'"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [retraction_map, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"s:B->A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP RETRACTION_MAPS_SECTION_IMAGE) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (SUBST1_TAC o SYM o
      MATCH_MP HOMEOMORPHIC_LOCALLY_COMPACT_SPACE) THEN
    UNDISCH_TAC (← q r"IMAGE (s:B->A) (topspace top') retract_of_space top") THEN
    FIRST_X_ASSUM ((K ALL_TAC : thm → tactic) o GEN_REWRITE_RULE id [retraction_maps]) THEN
    SPEC_TAC (← q r"IMAGE (s:B->A) (topspace top')", ← q r"t:A->bool") THEN
    X_GEN_TAC (← q r"t:A->bool") THEN
    REWRITE_TAC [retract_of_space, IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"r:A->A") THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [locally_compact_space, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_GSPEC] THEN
    X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_compact_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"IMAGE (r:A->A) k") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [IMAGE_COMPACT_IN], ASM SET_TAC []])

  let COMPACT_IMP_LOCALLY_COMPACT_SPACE ← prove
   r"!top:A topology. compact_space top ==> locally_compact_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally_compact_space] THEN
    REPEAT STRIP_TAC THEN REPEAT (EXISTS_TAC (← q r"topspace top:A->bool")) THEN
    ASM_REWRITE_TAC [← GSYM compact_space, OPEN_IN_TOPSPACE, SUBSET_REFL])

  let NEIGHBOURHOOD_BASE_IMP_LOCALLY_COMPACT_SPACE ← prove
   r"!top:A topology.
         neighbourhood_base_of (compact_in top) top
         ==> locally_compact_space top"
   (REWRITE_TAC [locally_compact_space, NEIGHBOURHOOD_BASE_OF] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let (LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE,
       LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE) ← CONJ_PAIR (← prove
   r"(!top:A topology.
        hausdorff_space top \/ regular_space top
        ==> (locally_compact_space top <=>
             neighbourhood_base_of (compact_in top) top)) /\
   (!top:A topology.
        locally_compact_space top /\ hausdorff_space top
        ==> regular_space top)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(n ==> l) /\ (h /\ n ==> r) /\ (l /\ r ==> n) /\ (h /\ l ==> r)
      ==> (h \/ r ==> (l <=> n)) /\ (l /\ h ==> r)")) THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_IMP_LOCALLY_COMPACT_SPACE] THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [IMP_CONJ, ← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
      DISCH_TAC THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_OF_MONO) THEN
      ASM_SIMP_TAC [COMPACT_IN_IMP_CLOSED_IN],
      REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
      REWRITE_TAC [locally_compact_space, NEIGHBOURHOOD_BASE_OF] THEN
      STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN
      STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u INTER w:A->bool", ← q r"x:A"]) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER, SUBSET_INTER] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:A->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT THEN
      EXISTS_TAC (← q r"k:A->bool") THEN
      MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
      ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN ASM SET_TAC [],
      REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
      REWRITE_TAC [locally_compact_space, NEIGHBOURHOOD_BASE_OF] THEN
      STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, OPEN_IN_SUBSET], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"regular_space(subtopology top (k:A->bool))") MP_TAC THENL
       [MATCH_MP_TAC COMPACT_HAUSDORFF_IMP_REGULAR_SPACE THEN
        ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_SUBTOPOLOGY],
        REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN
        REWRITE_TAC [NEIGHBOURHOOD_BASE_OF]] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"k INTER w:A->bool", ← q r"x:A"]) THEN
      ASM_SIMP_TAC [IN_INTER, OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_IN_GSPEC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [SUBSET_INTER, IN_INTER, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"u INTER v:A->bool") THEN ASM_SIMP_TAC [OPEN_IN_INTER] THEN
      EXISTS_TAC (← q r"k INTER c:A->bool") THEN
      ASM_SIMP_TAC [CLOSED_IN_INTER, COMPACT_IN_IMP_CLOSED_IN] THEN
      ASM SET_TAC []]))

  let LOCALLY_COMPACT_HAUSDORFF_OR_REGULAR ← prove
   r"!top:A topology.
        locally_compact_space top /\
        (hausdorff_space top \/ regular_space top) <=>
        locally_compact_space top /\ regular_space top"
   (MESON_TAC [LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE])

  let LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_IN ← prove
   r"!top:A topology.
        hausdorff_space top \/ regular_space top
        ==> (locally_compact_space top <=>
             !x. x IN topspace top
                 ==> ?u k. open_in top u /\
                           compact_in top k /\ closed_in top k /\
                           x IN u /\ u SUBSET k)"
   (GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> l) /\ (l /\ h ==> r) /\ (l /\ r ==> p)
      ==> h \/ r ==> (l <=> p)")) THEN
    REWRITE_TAC [LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE] THEN
    REWRITE_TAC [locally_compact_space] THEN
    CONJ_TAC THENL [MESON_TAC [], STRIP_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:A->bool") THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c:A->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT THEN
    EXISTS_TAC (← q r"k:A->bool") THEN
    MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
    ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
    MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN ASM SET_TAC [])

  let LOCALLY_COMPACT_SPACE_COMPACT_CLOSURE_OF ← prove
   r"!top:A topology.
        hausdorff_space top \/ regular_space top
        ==> (locally_compact_space top <=>
             !x. x IN topspace top
                 ==> ?u. open_in top u /\ compact_in top (top closure_of u) /\
                         x IN u)"
   (GEN_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_IN] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT THEN
      EXISTS_TAC (← q r"k:A->bool") THEN MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
      ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
      ASM_SIMP_TAC [CLOSURE_OF_MINIMAL, CLOSED_IN_CLOSURE_OF],
      STRIP_TAC THEN EXISTS_TAC (← q r"top closure_of u:A->bool") THEN
      ASM_SIMP_TAC [CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, OPEN_IN_SUBSET]])

  return { locally_compact_space, HOMEOMORPHIC_LOCALLY_COMPACT_SPACE,
           LOCALLY_COMPACT_SPACE_RETRACTION_MAP_IMAGE, COMPACT_IMP_LOCALLY_COMPACT_SPACE,
           NEIGHBOURHOOD_BASE_IMP_LOCALLY_COMPACT_SPACE, LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE,
           LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, LOCALLY_COMPACT_HAUSDORFF_OR_REGULAR,
           LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_IN, LOCALLY_COMPACT_SPACE_COMPACT_CLOSURE_OF }

