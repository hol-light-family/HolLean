         [REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
          MATCH_MP_TAC CONNECTED_IN_SUBSET_TOPSPACE THEN
            ASM_REWRITE_TAC [], ALL_TAC] THEN
         /- Get chain in c via CONNECTED_IN_IMP_WELLCHAINED -/
