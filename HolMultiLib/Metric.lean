structure BAI2 where
  BAIRE_CATEGORY_ALT : thm
  BAIRE_CATEGORY : thm
  deriving Inhabited

@[nospecialize]
def setupBAI2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BInterior : Interior) (BCompact1 : Compact1) (BCompact2 : Compact2)
    (BNbhdBase : NbhdBase) (BRegular1 : Regular1) (BLocCompact1 : LocCompact1)
    (BLocCompact2 : LocCompact2) (BCMS1 : CMS1) (BBAI1 : BAI1) : ExceptT String IO BAI2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DEPENDENT_CHOICE, DIFF_EQ_EMPTY, DIFF_UNIONS, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTERS_0, INTERS_GSPEC, INTERS_SUBSET, INTER_UNIV, IN_ELIM_THM, IN_UNIV,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, .. } :=
    D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, TRANSITIVE_STEPWISE_LE, UNIONS_0, UNIONS_IMAGE, .. } :=
    D.core4
  let { FORALL_AND_THM, NOT_EXISTS_THM, .. } := D.core5
  let { COUNTABLE_AS_IMAGE, COUNTABLE_IMAGE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_SUBSET, .. } :=
    BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, .. } := BSubtopology
  let { CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_TOPSPACE, .. } := BClosure
  let { INTERIOR_OF_CLOSURE_OF, INTERIOR_OF_COMPLEMENT, INTERIOR_OF_EMPTY, INTERIOR_OF_SUBSET,
        OPEN_IN_INTERIOR_OF, interior_of, .. } := BInterior
  let { COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { COMPACT_SPACE_IMP_NEST, .. } := BCompact2
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  let { LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN, .. } := BLocCompact2
  let { FORALL_MCOMPLETE_TOPOLOGY, .. } := BCMS1
  let { METRIC_BAIRE_CATEGORY_ALT, .. } := BBAI1
  -- @@SCOPE END

  let BAIRE_CATEGORY_ALT ← prove
   r"!top g:(A->bool)->bool.
        (completely_metrizable_space top \/
         locally_compact_space top /\
         (hausdorff_space top \/ regular_space top)) /\
        COUNTABLE g /\
        (!t. t IN g ==> closed_in top t /\ top interior_of t = {})
        ==> top interior_of (UNIONS g) = {}"
   (REWRITE_TAC [← TAUT (← q r"(p \/ q) /\ r ==> s <=>
                      (p ==> r ==> s) /\ (q /\ r ==> s)")] THEN
    REWRITE_TAC [FORALL_AND_THM, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM FORALL_MCOMPLETE_TOPOLOGY] THEN
    SIMP_TAC [METRIC_BAIRE_CATEGORY_ALT] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← TAUT (← q r"(p \/ q) ==> (p ==> q) ==> q"))) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [LOCALLY_COMPACT_HAUSDORFF_IMP_REGULAR_SPACE], DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"g:(A->bool)->bool = {}") THEN
    ASM_REWRITE_TAC [UNIONS_0, INTERIOR_OF_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          COUNTABLE_AS_IMAGE)) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:num->A->bool") THEN DISCH_THEN SUBST_ALL_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FORALL_IN_IMAGE]) THEN
    REWRITE_TAC [IN_UNIV, FORALL_AND_THM] THEN STRIP_TAC THEN
    REWRITE_TAC [interior_of, EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    X_GEN_TAC (← q r"z:A") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPEC (← q r"top:A topology")
          LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN) THEN
    ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"z:A") o REWRITE_RULE [SUBSET] o MATCH_MP
      OPEN_IN_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"z:A"]) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?c:num->A->bool.
          (!n. c n SUBSET k /\ closed_in top (c n) /\
               ~(top interior_of c n = {}) /\ DISJOINT (c n) (t n)) /\
          (!n. c (SUC n) SUBSET c n)")
    MP_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
         [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
        REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"v DIFF (t:num->A->bool) 0")) THEN
        ASM_SIMP_TAC [OPEN_IN_DIFF] THEN
        DISCH_THEN (MP_TAC o MATCH_MP MONO_EXISTS) THEN ANTS_TAC THENL
         [REWRITE_TAC [← SET_RULE (← q r"(?x. x IN s DIFF t) <=> ~(s SUBSET t)")] THEN
          DISCH_TAC THEN
          SUBGOAL_THEN (← q r"top interior_of (t:num->A->bool) 0 = {}") MP_TAC THENL
           [ASM_REWRITE_TAC [], REWRITE_TAC [interior_of]] THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN ASM_MESON_TAC [],
          REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"n:A->bool", ← q r"c:A->bool"] THEN
          STRIP_TAC THEN EXISTS_TAC (← q r"c:A->bool") THEN
          ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
          REPEAT CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC, ASM SET_TAC []] THEN
          EXISTS_TAC (← q r"x:A") THEN REWRITE_TAC [interior_of, IN_ELIM_THM] THEN
          ASM_MESON_TAC []],
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"c:A->bool"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
         [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
        REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
        DISCH_THEN (MP_TAC o SPEC
          (← q r"top interior_of c DIFF (t:num->A->bool) (SUC n)")) THEN
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_INTERIOR_OF] THEN
        DISCH_THEN (MP_TAC o MATCH_MP MONO_EXISTS) THEN ANTS_TAC THENL
         [REWRITE_TAC [← SET_RULE (← q r"(?x. x IN s DIFF t) <=> ~(s SUBSET t)")] THEN
          DISCH_TAC THEN
          SUBGOAL_THEN (← q r"top interior_of t(SUC n):A->bool = {}") MP_TAC THENL
           [ASM_REWRITE_TAC [], REWRITE_TAC [interior_of]] THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
          ASM_MESON_TAC [OPEN_IN_INTERIOR_OF, MEMBER_NOT_EMPTY],
          REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"n:A->bool", ← q r"d:A->bool"] THEN
          STRIP_TAC THEN EXISTS_TAC (← q r"d:A->bool") THEN
          ASM_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN REPEAT CONJ_TAC THENL
           [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool"] INTERIOR_OF_SUBSET) THEN
            ASM SET_TAC [],
            EXISTS_TAC (← q r"x:A") THEN REWRITE_TAC [interior_of, IN_ELIM_THM] THEN
            ASM_MESON_TAC [],
            ASM SET_TAC [],
            MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool"] INTERIOR_OF_SUBSET) THEN
            ASM SET_TAC []]]],
      REWRITE_TAC [NOT_EXISTS_THM, FORALL_AND_THM]] THEN
    X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology top (k:A->bool)", ← q r"c:num->A->bool"]
          COMPACT_SPACE_IMP_NEST) THEN
    ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY, CLOSED_IN_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [INTERIOR_OF_SUBSET, CLOSED_IN_SUBSET, MEMBER_NOT_EMPTY,
                     SUBSET],
      MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [UNIONS_IMAGE, IN_UNIV]) THEN
      REWRITE_TAC [INTERS_GSPEC] THEN ASM SET_TAC []])

  let BAIRE_CATEGORY ← prove
   r"!top g:(A->bool)->bool.
        (completely_metrizable_space top \/
         locally_compact_space top /\
         (hausdorff_space top \/ regular_space top)) /\
        COUNTABLE g /\
        (!t. t IN g ==> open_in top t /\ top closure_of t = topspace top)
        ==> top closure_of INTERS g = topspace top"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_CASES_TAC (← q r"g:(A->bool)->bool = {}") THENL
     [ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
      ASM_SIMP_TAC [INTERS_0, INTER_UNIV, CLOSURE_OF_TOPSPACE],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"top:A topology",
                      ← q r"IMAGE (\u:A->bool. topspace top DIFF u) g"]
          BAIRE_CATEGORY_ALT) THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
    ASM_SIMP_TAC [INTERIOR_OF_COMPLEMENT, DIFF_EQ_EMPTY] THEN
    REWRITE_TAC [INTERIOR_OF_CLOSURE_OF] THEN
    MATCH_MP_TAC (← SET_RULE (← q
      r"s SUBSET u /\ s' = s ==> u DIFF s' = {} ==> s = u")) THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE] THEN AP_TERM_TAC THEN
    REWRITE_TAC [DIFF_UNIONS, ← SET_RULE (← q
     r"{f y | y IN IMAGE g s} = {f(g x) | x IN s}")] THEN
