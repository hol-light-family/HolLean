      cauchy_continuous_map (m,real_euclidean_metric) f
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. c * f x)"
   (SIMP_TAC [CAUCHY_CONTINUOUS_MAP_REAL_MUL, CAUCHY_CONTINUOUS_MAP_REAL_CONST])

  let CAUCHY_CONTINUOUS_MAP_REAL_RMUL ← prove
   r"!m c f:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. f x * c)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_REAL_LMUL])

  let CAUCHY_CONTINUOUS_MAP_REAL_POW ← prove
   r"!m (f:A->real) n.
        cauchy_continuous_map (m,real_euclidean_metric) f
        ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. f x pow n)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN REPEAT GEN_TAC THEN DISCH_TAC THEN
    INDUCT_TAC THEN
    ASM_SIMP_TAC [real_pow, CAUCHY_CONTINUOUS_MAP_REAL_CONST,
                  CAUCHY_CONTINUOUS_MAP_REAL_MUL])

  let CAUCHY_CONTINUOUS_MAP_REAL_NEG ← prove
   r"!m f:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. --(f x))"
   (ONCE_REWRITE_TAC [REAL_NEG_MINUS1] THEN
    REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_REAL_LMUL])

  let CAUCHY_CONTINUOUS_MAP_REAL_ABS ← prove
   r"!m f:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. abs(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"real_euclidean_metric") THEN
    ASM_SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE,
                  LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP])

  let CAUCHY_CONTINUOUS_MAP_REAL_SUB ← prove
   r"!m f g:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f /\
      cauchy_continuous_map (m,real_euclidean_metric) g
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. f x - g x)"
   (REWRITE_TAC [real_sub] THEN
    SIMP_TAC [CAUCHY_CONTINUOUS_MAP_REAL_ADD,
              CAUCHY_CONTINUOUS_MAP_REAL_NEG])

  let CAUCHY_CONTINUOUS_MAP_REAL_MAX ← prove
   r"!m f g:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f /\
      cauchy_continuous_map (m,real_euclidean_metric) g
    ==> cauchy_continuous_map (m,real_euclidean_metric)
            (\x. max (f x) (g x))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. max (f x) (g x)) = (\(x,y). max x y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric real_euclidean_metric real_euclidean_metric") THEN
    SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM,
              LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP] THEN
    ASM_REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let CAUCHY_CONTINUOUS_MAP_REAL_MIN ← prove
   r"!m f g:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f /\
      cauchy_continuous_map (m,real_euclidean_metric) g
    ==> cauchy_continuous_map (m,real_euclidean_metric)
            (\x. min (f x) (g x))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. min (f x) (g x)) = (\(x,y). min x y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric real_euclidean_metric real_euclidean_metric") THEN
    SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM,
              LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP] THEN
    ASM_REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let CAUCHY_CONTINUOUS_MAP_REAL_DIV ← prove
   r"!m f g:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f /\
      cauchy_continuous_map (m,real_euclidean_metric) g /\
      ~(&0 IN euclideanreal closure_of (IMAGE g (mspace m)))
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. f x / g x)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_div] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_REAL_MUL THEN
    ASM_SIMP_TAC [CAUCHY_CONTINUOUS_MAP_REAL_INV] THEN
    FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
    REWRITE_TAC [CLOSURE_OF_INTERIOR_OF, IN_DIFF, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [IN_UNIV, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_INTERIOR_OF_MBALL] THEN
    REWRITE_TAC [SUBSET, IN_MBALL, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [REAL_SUB_RZERO, REAL_NOT_LT, ← SET_RULE (← q
     r"(!x. P x ==> x IN UNIV DIFF s) <=> (!x. x IN s ==> ~P x)")] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"b:real") THEN STRIP_TAC THEN
    REWRITE_TAC [real_bounded, FORALL_IN_IMAGE, REAL_ABS_INV] THEN
    EXISTS_TAC (← q r"inv b:real") THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN ASM_SIMP_TAC [])

  let CAUCHY_CONTINUOUS_MAP_SUM ← prove
   r"!m f:K->A->real k.
      FINITE k /\
      (!i. i IN k
          ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. f x i))
      ==> cauchy_continuous_map (m,real_euclidean_metric)
                (\x. sum k (f x))"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, CAUCHY_CONTINUOUS_MAP_REAL_CONST,
      FORALL_IN_INSERT, CAUCHY_CONTINUOUS_MAP_REAL_ADD, ETA_AX])

  return { UNIFORMLY_CONTINUOUS_MAP_REAL_DIV, UNIFORMLY_CONTINUOUS_MAP_SUM,
           CAUCHY_CONTINUOUS_MAP_FST, CAUCHY_CONTINUOUS_MAP_SND, CAUCHY_CONTINUOUS_MAP_REAL_INV,
           CAUCHY_CONTINUOUS_MAP_REAL_ADD, CAUCHY_CONTINUOUS_MAP_REAL_MUL,
           CAUCHY_CONTINUOUS_MAP_REAL_LMUL, CAUCHY_CONTINUOUS_MAP_REAL_RMUL,
           CAUCHY_CONTINUOUS_MAP_REAL_POW, CAUCHY_CONTINUOUS_MAP_REAL_NEG,
           CAUCHY_CONTINUOUS_MAP_REAL_ABS, CAUCHY_CONTINUOUS_MAP_REAL_SUB,
           CAUCHY_CONTINUOUS_MAP_REAL_MAX, CAUCHY_CONTINUOUS_MAP_REAL_MIN,
           CAUCHY_CONTINUOUS_MAP_REAL_DIV, CAUCHY_CONTINUOUS_MAP_SUM }

/- ------------------------------------------------------------------------- -/
/- Square roots, and isometries.  (metric.ml 32262-32345)                    -/
/- ------------------------------------------------------------------------- -/

structure CC9 where
  UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT : thm
  CONTINUOUS_MAP_SQUARE_ROOT : thm
  UNIFORMLY_CONTINUOUS_MAP_SQRT : thm
  CAUCHY_CONTINUOUS_MAP_SQRT : thm
  CONTINUOUS_MAP_SQRT : thm
  ISOMETRY_IMP_EMBEDDING_MAP : thm
  ISOMETRY_IMP_HOMEOMORPHIC_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupCC9 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap2 : ContMap2)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BEmbedding : Embedding)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BRealTop2 : RealTop2)
    (BLIP1 : LIP1) (BUC1 : UC1) (BCC1 : CC1) (BCC2 : CC2) : ExceptT String IO CC9 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, .. } := D
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INJECTIVE_ON_LEFT_INVERSE, IN_INTER, IN_UNIV,
        LEFT_IMP_EXISTS_THM, REAL_ABS_LE_SQRT, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_REFL, REAL_LT_LSQRT, REAL_MUL_LID, REAL_POW_LT, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SUBSET_UNIV, o_DEF, .. } := D.core4
  let { REAL_HALF, .. } := D.misc
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { embedding_map, .. } := BEmbedding
  let { MDIST_0, SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { lipschitz_continuous_map, .. } := BLIP1
  let { UNIFORMLY_CONTINUOUS_MAP_COMPOSE, uniformly_continuous_map, .. } := BUC1
  let { CAUCHY_CONTINUOUS_MAP_COMPOSE, .. } := BCC1
  let { LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP,
        UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP, .. } := BCC2
  -- @@SCOPE END

  let UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT ← prove
   r"uniformly_continuous_map(real_euclidean_metric,real_euclidean_metric) sqrt"
   (REWRITE_TAC [uniformly_continuous_map, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e pow 2 / &2") THEN ASM_SIMP_TAC [REAL_HALF, REAL_POW_LT] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN DISCH_TAC THEN
    TRANS_TAC REAL_LET_TRANS (← q r"sqrt(&2 * abs(x - y))") THEN
    REWRITE_TAC [REAL_ABS_LE_SQRT] THEN MATCH_MP_TAC REAL_LT_LSQRT THEN
    ASM_REAL_ARITH_TAC)

  let CONTINUOUS_MAP_SQUARE_ROOT ← prove
   r"continuous_map(euclideanreal,euclideanreal) sqrt"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT])

  let UNIFORMLY_CONTINUOUS_MAP_SQRT ← prove
   r"!m f:A->real.
      uniformly_continuous_map (m,real_euclidean_metric) f
      ==> uniformly_continuous_map (m,real_euclidean_metric) (\x. sqrt(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"real_euclidean_metric") THEN
    ASM_REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT])

  let CAUCHY_CONTINUOUS_MAP_SQRT ← prove
   r"!m f:A->real.
      cauchy_continuous_map (m,real_euclidean_metric) f
      ==> cauchy_continuous_map (m,real_euclidean_metric) (\x. sqrt(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"real_euclidean_metric") THEN
    ASM_SIMP_TAC [UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT,
                  UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP])

  let CONTINUOUS_MAP_SQRT ← prove
   r"!top f:A->real.
        continuous_map (top,euclideanreal) f
        ==> continuous_map (top,euclideanreal) (\x. sqrt(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [] THEN
    SIMP_TAC [UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT, ← GSYM
              MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
              UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP])

  let ISOMETRY_IMP_EMBEDDING_MAP ← prove
   r"!m m' (f:A->B).
        IMAGE f (mspace m) SUBSET mspace m' /\
        (!x y. x IN mspace m /\ y IN mspace m
               ==> mdist m' (f x,f y) = mdist m (x,y))
        ==> embedding_map(mtopology m,mtopology m') f"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN mspace m /\ y IN mspace m /\ (f:A->B) x = f y ==> x = y")
    MP_TAC THENL [ASM_MESON_TAC [MDIST_0], ALL_TAC] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN DISCH_TAC THEN
    REWRITE_TAC [embedding_map, HOMEOMORPHIC_MAP_MAPS] THEN
    EXISTS_TAC (← q r"g:B->A") THEN
    ASM_REWRITE_TAC [homeomorphic_maps, TOPSPACE_MTOPOLOGY,
                     TOPSPACE_SUBTOPOLOGY, IN_INTER, IMP_CONJ_ALT] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_MTOPOLOGY] THEN
    SIMP_TAC [FUN_IN_IMAGE, ← GSYM MTOPOLOGY_SUBMETRIC] THEN
    CONJ_TAC THEN MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
    ASM_SIMP_TAC [lipschitz_continuous_map, SUBSET, FORALL_IN_IMAGE,
                  SUBMETRIC, IMP_CONJ, IN_INTER] THEN
    EXISTS_TAC (← q r"&1") THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE, REAL_MUL_LID] THEN
    ASM_SIMP_TAC [REAL_LE_REFL])

  let ISOMETRY_IMP_HOMEOMORPHIC_MAP ← prove
   r"!m m' (f:A->B).
        IMAGE f (mspace m) = mspace m' /\
        (!x y. x IN mspace m /\ y IN mspace m
               ==> mdist m' (f x,f y) = mdist m (x,y))
        ==> homeomorphic_map(mtopology m,mtopology m') f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"m':B metric", ← q r"f:A->B"]
          ISOMETRY_IMP_EMBEDDING_MAP) THEN
    ASM_REWRITE_TAC [SUBSET_REFL, embedding_map, TOPSPACE_MTOPOLOGY] THEN
    REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, SUBTOPOLOGY_TOPSPACE])

  return { UNIFORMLY_CONTINUOUS_MAP_SQUARE_ROOT, CONTINUOUS_MAP_SQUARE_ROOT,
           UNIFORMLY_CONTINUOUS_MAP_SQRT, CAUCHY_CONTINUOUS_MAP_SQRT, CONTINUOUS_MAP_SQRT,
           ISOMETRY_IMP_EMBEDDING_MAP, ISOMETRY_IMP_HOMEOMORPHIC_MAP }

/- ------------------------------------------------------------------------- -/
/- Extending continuous maps "pointwise" in a regular space.                 -/
/- (metric.ml 32351-32458)                                                    -/
/- ------------------------------------------------------------------------- -/

structure EXT1 where
  CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF : thm
  CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ : thm
  CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT : thm
  CONTINUOUS_MAP_EXTENSION_POINTWISE : thm
  deriving Inhabited

@[nospecialize]
def setupEXT1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BNets : Nets) (BNbhdBase : NbhdBase) (BRegular1 : Regular1)
    (BAtPoint : AtPoint) (BLimits1 : Limits1) (BPtCont : PtCont) : ExceptT String IO EXT1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, SIMP_RULE, .. } := D
  let { IMP_IMP, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { SKOLEM_THM, SUBSET, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_SUBSET_TOPSPACE, closure_of, .. } := BClosure
  let { ALWAYS_WITHIN_EVENTUALLY, EVENTUALLY_WITHIN_IMP, .. } := BNets
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  let { ATPOINTOF_SUBTOPOLOGY, EVENTUALLY_ATPOINTOF, .. } := BAtPoint
  let { LIMIT_TRANSFORM_EVENTUALLY, LIMIT_WITHIN_SUBSET, limit, .. } := BLimits1
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  -- @@SCOPE END

  let CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF ← prove
   r"!top top' f:A->B s t.
       regular_space top' /\
       t SUBSET top closure_of s /\
       (!x. x IN t ==> limit top' f (f x) (atpointof top x within s))
       ==> continuous_map (subtopology top t,top') f"
   (REWRITE_TAC [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) t SUBSET topspace top'") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [limit]) THEN ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN ASM_SIMP_TAC [ATPOINTOF_SUBTOPOLOGY] THEN
    REWRITE_TAC [limit] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"w:B->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NEIGHBOURHOOD_BASE_OF]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"w:B->bool", ← q r"(f:A->B) a"]) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_TOPSPACE, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:B->bool", ← q r"c:B->bool"] THEN STRIP_TAC THEN
    REWRITE_TAC [EVENTUALLY_ATPOINTOF, EVENTUALLY_WITHIN_IMP] THEN DISJ2_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"a:A")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], REWRITE_TAC [limit]] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"v:B->bool"))) THEN
    ASM_REWRITE_TAC [EVENTUALLY_ATPOINTOF, EVENTUALLY_WITHIN_IMP] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    REWRITE_TAC [IMP_IMP] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"z:A") THEN REWRITE_TAC [IN_DELETE] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"z IN topspace top /\ (f:A->B) z IN topspace top'")
    STRIP_ASSUME_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~((f:A->B) z IN topspace top' DIFF c)") MP_TAC THENL
     [REWRITE_TAC [IN_DIFF] THEN STRIP_TAC, ASM SET_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [limit] o SPEC (← q r"z:A")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"topspace top' DIFF c:B->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, IN_DIFF] THEN
    ASM_REWRITE_TAC [EVENTUALLY_ATPOINTOF, EVENTUALLY_WITHIN_IMP] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u':A->bool") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"(t:A->bool) SUBSET top closure_of s") THEN
    REWRITE_TAC [closure_of, IN_ELIM_THM, SUBSET] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"u INTER u':A->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_INTER] THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ ← prove
   r"!top top' f:A->B s t.
        regular_space top' /\ s SUBSET t /\ t SUBSET top closure_of s
        ==> (continuous_map (subtopology top t,top') f <=>
             !x. x IN t ==> limit top' f (f x) (atpointof top x within s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF, TOPSPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
      ASM_CASES_TAC (← q r"(x:A) IN t") THEN ASM_SIMP_TAC [ATPOINTOF_SUBTOPOLOGY] THEN
      ASSUME_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
        CLOSURE_OF_SUBSET_TOPSPACE) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [LIMIT_WITHIN_SUBSET]],
      ASM_MESON_TAC [CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF]])

  let CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT ← prove
   r"!top1 top2 f:A->B s t.
        regular_space top2 /\ s SUBSET t /\ t SUBSET top1 closure_of s /\
        continuous_map (subtopology top1 s,top2) f /\
        (!x. x IN t DIFF s ==> ?l. limit top2 f l (atpointof top1 x within s))
        ==> ?g. continuous_map (subtopology top1 t,top2) g /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_EXISTS_THM]) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, IN_DIFF] THEN
    X_GEN_TAC (← q r"g:A->B") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"\x. if x IN s then (f:A->B) x else g x") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    MATCH_MP_TAC LIMIT_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"f:A->B") THEN SIMP_TAC [ALWAYS_WITHIN_EVENTUALLY] THEN
    COND_CASES_TAC THEN
    ASM_SIMP_TAC [← GSYM ATPOINTOF_SUBTOPOLOGY] THEN
    FIRST_ASSUM (MATCH_MP_TAC o
     GEN_REWRITE_RULE id [CONTINUOUS_MAP_ATPOINTOF]) THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [closure_of]) THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_EXTENSION_POINTWISE ← prove
   r"!top1 top2 f:A->B s t.
        regular_space top2 /\ s SUBSET t /\ t SUBSET top1 closure_of s /\
        (!x. x IN t
             ==> ?g. continuous_map (subtopology top1 (x INSERT s),top2) g /\
                     !x. x IN s ==> g x = f x)
        ==> ?g. continuous_map (subtopology top1 t,top2) g /\
                (!x. x IN s ==> g x = f x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_DIFF, IN_INTER] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    (SUBGOAL_THEN (← q r"(x:A) IN topspace top1") ASSUME_TAC THENL
      [RULE_ASSUM_TAC (SIMP_RULE [closure_of]) THEN ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    (ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]]) THEN
    X_GEN_TAC (← q r"g:A->B") THEN REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"x:A")) ASSUME_TAC) THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_INSERT] THEN
    ASM_SIMP_TAC [ATPOINTOF_SUBTOPOLOGY, IN_INSERT] THEN
    STRIP_TAC THENL [ALL_TAC, EXISTS_TAC (← q r"(g:A->B) x")] THEN
    MATCH_MP_TAC LIMIT_TRANSFORM_EVENTUALLY THEN
    EXISTS_TAC (← q r"(g:A->B)") THEN ASM_SIMP_TAC [ALWAYS_WITHIN_EVENTUALLY] THEN
    MATCH_MP_TAC LIMIT_WITHIN_SUBSET THEN
    EXISTS_TAC (← q r"(x:A) INSERT s") THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"s SUBSET x INSERT s")])

  return { CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF,
           CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE_OF_EQ, CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT,
           CONTINUOUS_MAP_EXTENSION_POINTWISE }

