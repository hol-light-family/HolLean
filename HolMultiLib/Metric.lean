      ASM_SIMP_TAC [LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE] THEN
      REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w:A->bool", ← q r"x:A"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [← GSYM NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
      REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN ASM_REWRITE_TAC [] THEN
