                (!x. h0 x SUBSET mspace m) /\
                (!x. mdiameter m (h0 x) < inv(&1)) /\
                (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
                  (!y. y IN u ==> h0 y = h0 x)) /\
                (!a. a IN mspace m ==> ?x. a IN h0 x)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"(\x:num->bool. mspace(m:A metric))",
