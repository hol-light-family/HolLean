structure LocCompact4 where
  LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY : thm
  QUOTIENT_MAP_PROD_RIGHT : thm
  QUOTIENT_MAP_PROD_LEFT : thm
  QUOTIENT_MAP_PROD : thm
  LOCALLY_COMPACT_SPACE_PERFECT_MAP_PREIMAGE : thm
  LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE : thm
  LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupLocCompact4 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2) (BQuotient : Quotient)
    (BProd1 : Prod1) (BProd2 : Prod2) (BSumTop : SumTop) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BEmbedding : Embedding) (BCompact1 : Compact1) (BCompact3 : Compact3)
    (BCompact5 : Compact5) (BProper1 : Proper1) (BPerfect : Perfect) (BNbhdBase : NbhdBase)
    (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2) :
    ExceptT String IO LocCompact4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { EXTENSION, FUN_EQ_THM, IMAGE_ID, .. } := D.core1
  let { IMAGE_PAIRED_CROSS, IMAGE_SUBSET, IMP_CONJ, IMP_IMP, IN_CROSS, IN_DIFF,
        IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SUBSET, SUBSET_CROSS, SUBSET_REFL, SUBSET_RESTRICT,
        SUBSET_TRANS, disjoint_union, o_THM, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_PAIR_THM, LAMBDA_PAIR, PAIR_EQ, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, OPEN_IN_CONTINUOUS_MAP_PREIMAGE,
        .. } := BContMap1
  let { CLOSED_MAP_CLOSURE_OF_IMAGE, closed_map, open_map, .. } := BOpenClosed1
  let { CLOSED_MAP_FIBRE_NEIGHBOURHOOD, .. } := BOpenClosed2
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_MAP_COMPOSE,
        quotient_map, .. } := BQuotient
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, OPEN_IN_CROSS, PROD_TOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { CONTINUOUS_MAP_COMPONENT_INJECTION, OPEN_MAP_COMPONENT_INJECTION,
        TOPSPACE_SUM_TOPOLOGY, .. } := BSumTop
  let { HOMEOMORPHIC_IMP_QUOTIENT_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_SWAP, .. } := BHomeo2
  let { TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT, .. } := BEmbedding
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT, COMPACT_SPACE_SUBTOPOLOGY,
        .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { CLOSED_MAP_SND, .. } := BCompact5
  let { COMPACT_IN_PROPER_MAP_PREIMAGE, proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { HOMEOMORPHIC_LOCALLY_COMPACT_SPACE, locally_compact_space, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT,
        LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN, .. } := BLocCompact2
  -- @@SCOPE END

  let LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        locally_compact_space(sum_topology k top) <=>
        !i. i IN k ==> locally_compact_space(top i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_LOCALLY_COMPACT_SPACE] THEN
      SIMP_TAC [LOCALLY_COMPACT_SPACE_CLOSED_SUBSET],
      REWRITE_TAC [locally_compact_space, FORALL_PAIR_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"i:K") THEN
      REWRITE_TAC [TOPSPACE_SUM_TOPOLOGY, disjoint_union, IN_ELIM_PAIR_THM] THEN
      ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [o_THM] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
      ASM_CASES_TAC (← q r"(x:A) IN topspace(top(i:K))") THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"l:A->bool"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"IMAGE (\x:A. (i:K),x) u", ← q r"IMAGE (\x:A. (i:K),x) l"] THEN
      ASM_SIMP_TAC [IMAGE_SUBSET] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [open_map, RIGHT_IMP_FORALL_THM, IMP_IMP]
          OPEN_MAP_COMPONENT_INJECTION) THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC (← q r"(top:K->A topology) i") THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_COMPONENT_INJECTION],
        ASM SET_TAC []]])

  let QUOTIENT_MAP_PROD_RIGHT ← prove
   r"!(top:A topology) top1 top2 (f:B->C).
     locally_compact_space top /\ (hausdorff_space top \/ regular_space top) /\
     quotient_map(top1,top2) f
     ==> quotient_map (prod_topology top top1,prod_topology top top2)
                      (\(x,y). x,f y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP QUOTIENT_IMP_SURJECTIVE_MAP) THEN
    REWRITE_TAC [quotient_map, TOPSPACE_PROD_TOPOLOGY] THEN
    ASM_REWRITE_TAC [IMAGE_PAIRED_CROSS, IMAGE_ID] THEN
    X_GEN_TAC (← q r"w:A#C->bool") THEN DISCH_TAC THEN EQ_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [← GSYM TOPSPACE_PROD_TOPOLOGY] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] OPEN_IN_CONTINUOUS_MAP_PREIMAGE) THEN
      REWRITE_TAC [LAMBDA_PAIR, CONTINUOUS_MAP_PAIRED] THEN
      REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_OF_SND] THEN
      ASM_SIMP_TAC [QUOTIENT_IMP_CONTINUOUS_MAP]] THEN
    DISCH_TAC THEN GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [FORALL_PAIR_THM] THEN MAP_EVERY X_GEN_TAC [← q r"x0:A", ← q r"z0:C"] THEN
    DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(x0:A),(z0:C)") o REWRITE_RULE [SUBSET]) THEN
    ASM_REWRITE_TAC [IN_CROSS] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?y0. y0 IN topspace top1 /\ (f:B->C) y0 = z0")
    STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"top:A topology")
      LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN) THEN
    ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL
      [← q r"{x | x IN topspace top /\
             (x,y0) IN {x | x IN topspace top CROSS topspace top1 /\
                           (\(x:A,y). x,(f:B->C) y) x IN w}}",
       ← q r"x0:A"]) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"prod_topology top top1:(A#B)topology") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID] THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_CONST],
        ASM_REWRITE_TAC [IN_ELIM_THM, IN_CROSS]],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"u':A->bool"] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"y0:B") o MATCH_MP (← MESON [SUBSET_CROSS, SUBSET_REFL]
     (← q r"s SUBSET t ==> !a:B. s CROSS {a} SUBSET t CROSS {a}"))) THEN
    DISCH_THEN (MP_TAC o
     SPEC (← q r"{x | x IN topspace top CROSS topspace top1 /\
                (\(x:A,y). x,(f:B->C) y) x IN w}") o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS] THEN SET_TAC [],
      DISCH_TAC] THEN
    ABBREV_TAC
     (← q r"v = {z | z IN topspace top2 /\
               u' CROSS {y | y IN topspace top1 /\ (f:B->C) y = z} SUBSET
               {x | x IN topspace top CROSS topspace top1 /\
                    (\(x:A,y). x,f y) x IN w}}") THEN
    EXISTS_TAC (← q r"(u CROSS v):A#C->bool") THEN CONJ_TAC THENL
     [ASM_REWRITE_TAC [OPEN_IN_CROSS] THEN REPEAT DISJ2_TAC,
      EXPAND_TAC "v" THEN REWRITE_TAC [SUBSET] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM] THEN
      REWRITE_TAC [IN_CROSS, IN_ELIM_THM] THEN ASM SET_TAC []] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"v:C->bool") o CONJUNCT2 o
      GEN_REWRITE_RULE id [quotient_map]) THEN
    ANTS_TAC THENL
     [EXPAND_TAC "v" THEN REWRITE_TAC [SUBSET_RESTRICT],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top1 /\ (f:B->C) x IN v} =
      topspace top1 DIFF
      (IMAGE SND ((u' CROSS topspace top1) DIFF
                  {x | x IN topspace top CROSS topspace top1 /\
                       (\(x:A,y). x,f y) x IN w}))")
    SUBST1_TAC THENL
     [EXPAND_TAC "v" THEN
      GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:B") THEN
      REWRITE_TAC [IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_THM, IN_CROSS, IN_DIFF,
                   SUBSET, FORALL_PAIR_THM, PAIR_EQ] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
      MATCH_MP_TAC (← REWRITE_RULE [closed_map, IMP_IMP, RIGHT_IMP_FORALL_THM]
          CLOSED_MAP_SND) THEN
      EXISTS_TAC (← q r"subtopology top (u':A->bool)") THEN
      ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
      REWRITE_TAC [PROD_TOPOLOGY_SUBTOPOLOGY] THEN
      MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN THEN
      ASM_REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, SUBSET_CROSS, SUBSET_REFL] THEN
      ASM_SIMP_TAC [CLOSED_IN_SUBSET]])

  let QUOTIENT_MAP_PROD_LEFT ← prove
   r"!top1 top2 (top:C topology) (f:A->B).
     locally_compact_space top /\ (hausdorff_space top \/ regular_space top) /\
     quotient_map(top1,top2) f
     ==> quotient_map (prod_topology top1 top,prod_topology top2 top)
                      (\(x,y). f x,y)"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"(\(x,y). (f:A->B) x,(y:C)) =
      (\(x,y). (y,x)) o (\(x,y). x,f y) o (\(x,y). (y,x))")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM, o_THM], ALL_TAC] THEN
    MATCH_MP_TAC QUOTIENT_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"(prod_topology top top2):(C#B)topology") THEN
    SIMP_TAC [HOMEOMORPHIC_MAP_SWAP, HOMEOMORPHIC_IMP_QUOTIENT_MAP] THEN
    MATCH_MP_TAC QUOTIENT_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"(prod_topology top top1):(C#A)topology") THEN
    SIMP_TAC [HOMEOMORPHIC_MAP_SWAP, HOMEOMORPHIC_IMP_QUOTIENT_MAP] THEN
    ASM_SIMP_TAC [QUOTIENT_MAP_PROD_RIGHT])

  let QUOTIENT_MAP_PROD ← prove
   r"!top1 top2 top1' top2' (f:A->B) (g:C->D).
        (locally_compact_space top1 /\
         (hausdorff_space top1 \/ regular_space top1) /\
         locally_compact_space top2' /\
         (hausdorff_space top2' \/ regular_space top2') \/
         locally_compact_space top1' /\
         (hausdorff_space top1' \/ regular_space top1') /\
         locally_compact_space top2 /\
         (hausdorff_space top2 \/ regular_space top2)) /\
        quotient_map(top1,top1') f /\ quotient_map(top2,top2') g
        ==> quotient_map (prod_topology top1 top2,prod_topology top1' top2')
                         (\(x,y). f x,g y)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 DISJ_CASES_TAC STRIP_ASSUME_TAC) THENL
     [SUBGOAL_THEN
       (← q r"(\(x,y). (f:A->B) x,(g:C->D) y) =
        (\(x,y). f x,y) o (\(x,y). x,g y)")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM, o_THM],
        MATCH_MP_TAC QUOTIENT_MAP_COMPOSE THEN
        EXISTS_TAC (← q r"prod_topology top1 top2':(A#D)topology") THEN
        ASM_SIMP_TAC [QUOTIENT_MAP_PROD_RIGHT, QUOTIENT_MAP_PROD_LEFT]],
      SUBGOAL_THEN
       (← q r"(\(x,y). (f:A->B) x,(g:C->D) y) =
        (\(x,y). x,g y) o (\(x,y). f x,y)")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM, o_THM],
        MATCH_MP_TAC QUOTIENT_MAP_COMPOSE THEN
        EXISTS_TAC (← q r"prod_topology top1' top2:(B#C)topology") THEN
        ASM_SIMP_TAC [QUOTIENT_MAP_PROD_RIGHT, QUOTIENT_MAP_PROD_LEFT]]])

  let LOCALLY_COMPACT_SPACE_PERFECT_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B).
        locally_compact_space top' /\
        perfect_map(top,top') f
        ==> locally_compact_space top"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [locally_compact_space, perfect_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(f:A->B) x")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"k:B->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN topspace top /\ (f:A->B) x IN u}",
      ← q r"{x | x IN topspace top /\ (f:A->B) x IN k}"] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      MATCH_MP_TAC COMPACT_IN_PROPER_MAP_PREIMAGE THEN ASM SET_TAC [],
      ASM SET_TAC []])

  let LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
     (hausdorff_space top \/ regular_space top) /\
     locally_compact_space top /\
     perfect_map(top,top') f
     ==> locally_compact_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [perfect_map] THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    REWRITE_TAC [locally_compact_space] THEN X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      MATCH_MP LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"{x | x IN topspace top /\ (f:A->B) x = y}")) THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [proper_map]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
      SPECL [← q r"u:A->bool", ← q r"y:B"] o
      CONJUNCT2 o GEN_REWRITE_RULE id [CLOSED_MAP_FIBRE_NEIGHBOURHOOD]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"v:B->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) (top closure_of u)") THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT THEN
      EXISTS_TAC (← q r"k:A->bool") THEN MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
      ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY, CLOSED_IN_CLOSURE_OF,
                    CLOSURE_OF_MINIMAL, COMPACT_SPACE_SUBTOPOLOGY],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool") o CONJUNCT2 o
          GEN_REWRITE_RULE id [CLOSED_MAP_CLOSURE_OF_IMAGE]) THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      TRANS_TAC SUBSET_TRANS (← q r"IMAGE (f:A->B) u") THEN CONJ_TAC THENL
        [ALL_TAC, MATCH_MP_TAC CLOSURE_OF_SUBSET] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC []])

  let LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
     (hausdorff_space top \/ regular_space top) /\
     perfect_map(top,top') f
     ==> (locally_compact_space top <=>
          locally_compact_space top')"
   (MESON_TAC [LOCALLY_COMPACT_SPACE_PERFECT_MAP_PREIMAGE,
               LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE])

  return { LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY, QUOTIENT_MAP_PROD_RIGHT, QUOTIENT_MAP_PROD_LEFT,
           QUOTIENT_MAP_PROD, LOCALLY_COMPACT_SPACE_PERFECT_MAP_PREIMAGE,
           LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE, LOCALLY_COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- The most basic facts about usual topology and metric on R.                -/
/- (metric.ml 18030-18186)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealTop1 where
  real_open : thm
  real_closed : thm
  euclideanreal : thm
  REAL_OPEN_EMPTY : thm
  REAL_OPEN_UNIV : thm
  REAL_OPEN_INTER : thm
  REAL_OPEN_UNIONS : thm
  REAL_OPEN_IN : thm
  TOPSPACE_EUCLIDEANREAL : thm
  TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY : thm
  REAL_CLOSED_IN : thm
  REAL_OPEN_UNION : thm
  REAL_OPEN_SUBREAL_OPEN : thm
  REAL_CLOSED_EMPTY : thm
  REAL_CLOSED_UNIV : thm
  REAL_CLOSED_UNION : thm
  REAL_CLOSED_INTER : thm
  REAL_CLOSED_INTERS : thm
  REAL_OPEN_REAL_CLOSED : thm
  REAL_OPEN_DIFF : thm
  REAL_CLOSED_DIFF : thm
  REAL_OPEN_INTERS : thm
  REAL_CLOSED_UNIONS : thm
  REAL_OPEN_HALFSPACE_GT : thm
  REAL_OPEN_HALFSPACE_LT : thm
  REAL_OPEN_REAL_INTERVAL : thm
  REAL_CLOSED_HALFSPACE_LE : thm
  REAL_CLOSED_HALFSPACE_GE : thm
  REAL_CLOSED_REAL_INTERVAL : thm
  REAL_CLOSED_SING : thm
  deriving Inhabited

@[nospecialize]
def setupRealTop1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) : ExceptT String IO RealTop1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_RULE, new_definition, .. } := D
  let { AND_FORALL_THM, EXTENSION, FINITE_INDUCT_STRONG, .. } := D.core1
  let { IMP_CONJ, IN, INTERS_0, INTERS_INSERT, INTER_UNIV, IN_DIFF, IN_ELIM_THM, IN_INSERT,
        IN_INTER, IN_UNIONS, IN_UNIV, MONO_FORALL, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_DOWN2, REAL_LT_01, REAL_LT_TRANS, .. } := D.core3
  let { SUBSET, SUBSET_UNIV, UNIONS_0, UNIONS_INSERT, real_ge, real_gt, .. } := D.core4
  let { REAL_INTERVAL_SING, real_interval, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_INTERS, CLOSED_IN_TOPSPACE,
        CLOSED_IN_UNION, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_SUBOPEN, OPEN_IN_UNION,
        closed_in, istopology, topology_tybij, topspace, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let real_open ← new_definition
    r"real_open s <=>
      !x. x IN s ==> ?e. &0 < e /\ !x'. abs(x' - x) < e ==> x' IN s"

  let real_closed ← new_definition
   r"real_closed s <=> real_open((:real) DIFF s)"

  let euclideanreal ← new_definition
   r"euclideanreal = topology real_open"

  let REAL_OPEN_EMPTY ← prove
   r"real_open {}"
   (REWRITE_TAC [real_open, NOT_IN_EMPTY])

  let REAL_OPEN_UNIV ← prove
   r"real_open(:real)"
   (REWRITE_TAC [real_open, IN_UNIV] THEN MESON_TAC [REAL_LT_01])

  let REAL_OPEN_INTER ← prove
   r"!s t. real_open s /\ real_open t ==> real_open (s INTER t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [real_open, AND_FORALL_THM, IN_INTER] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"d1:real")) (X_CHOOSE_TAC (← q r"d2:real"))) THEN
    MP_TAC (← SPECL [← q r"d1:real", ← q r"d2:real"] REAL_DOWN2) THEN
    ASM_MESON_TAC [REAL_LT_TRANS])

  let REAL_OPEN_UNIONS ← prove
   r"(!s. s IN f ==> real_open s) ==> real_open(UNIONS f)"
   (REWRITE_TAC [real_open, IN_UNIONS] THEN MESON_TAC [])

  let REAL_OPEN_IN ← prove
   r"!s. real_open s <=> open_in euclideanreal s"
   (GEN_TAC THEN REWRITE_TAC [euclideanreal] THEN CONV_TAC SYM_CONV THEN
    AP_THM_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT2 topology_tybij)] THEN
    REWRITE_TAC [← REWRITE_RULE [IN] istopology] THEN
    REWRITE_TAC [REAL_OPEN_EMPTY, REAL_OPEN_INTER, SUBSET] THEN
    MESON_TAC [IN, REAL_OPEN_UNIONS])

  let TOPSPACE_EUCLIDEANREAL ← prove
   r"topspace euclideanreal = (:real)"
   (REWRITE_TAC [topspace, EXTENSION, IN_UNIV, IN_UNIONS, IN_ELIM_THM] THEN
    MESON_TAC [REAL_OPEN_UNIV, IN_UNIV, REAL_OPEN_IN])

  let TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY ← prove
   r"!s. topspace (subtopology euclideanreal s) = s"
   (REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, TOPSPACE_SUBTOPOLOGY, INTER_UNIV])

  let REAL_CLOSED_IN ← prove
   r"!s. real_closed s <=> closed_in euclideanreal s"
   (REWRITE_TAC [real_closed, closed_in, TOPSPACE_EUCLIDEANREAL,
                 REAL_OPEN_IN, SUBSET_UNIV])

  let REAL_OPEN_UNION ← prove
   r"!s t. real_open s /\ real_open t ==> real_open(s UNION t)"
   (REWRITE_TAC [REAL_OPEN_IN, OPEN_IN_UNION])

  let REAL_OPEN_SUBREAL_OPEN ← prove
   r"!s. real_open s <=> !x. x IN s ==> ?t. real_open t /\ x IN t /\ t SUBSET s"
   (REWRITE_TAC [REAL_OPEN_IN, ← GSYM OPEN_IN_SUBOPEN])

  let REAL_CLOSED_EMPTY ← prove
   r"real_closed {}"
   (REWRITE_TAC [REAL_CLOSED_IN, CLOSED_IN_EMPTY])

  let REAL_CLOSED_UNIV ← prove
   r"real_closed(:real)"
   (REWRITE_TAC [REAL_CLOSED_IN, ← GSYM TOPSPACE_EUCLIDEANREAL,
                 CLOSED_IN_TOPSPACE])

  let REAL_CLOSED_UNION ← prove
   r"!s t. real_closed s /\ real_closed t ==> real_closed(s UNION t)"
   (REWRITE_TAC [REAL_CLOSED_IN, CLOSED_IN_UNION])

  let REAL_CLOSED_INTER ← prove
   r"!s t. real_closed s /\ real_closed t ==> real_closed(s INTER t)"
   (REWRITE_TAC [REAL_CLOSED_IN, CLOSED_IN_INTER])

  let REAL_CLOSED_INTERS ← prove
   r"!f. (!s. s IN f ==> real_closed s) ==> real_closed(INTERS f)"
   (REWRITE_TAC [REAL_CLOSED_IN] THEN REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"f:(real->bool)->bool = {}") THEN
    ASM_SIMP_TAC [CLOSED_IN_INTERS, INTERS_0] THEN
    REWRITE_TAC [← GSYM TOPSPACE_EUCLIDEANREAL, CLOSED_IN_TOPSPACE])

  let REAL_OPEN_REAL_CLOSED ← prove
   r"!s. real_open s <=> real_closed(UNIV DIFF s)"
   (SIMP_TAC [REAL_OPEN_IN, REAL_CLOSED_IN, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV,
              OPEN_IN_CLOSED_IN_EQ])

  let REAL_OPEN_DIFF ← prove
   r"!s t. real_open s /\ real_closed t ==> real_open(s DIFF t)"
   (REWRITE_TAC [REAL_OPEN_IN, REAL_CLOSED_IN, OPEN_IN_DIFF])

  let REAL_CLOSED_DIFF ← prove
   r"!s t. real_closed s /\ real_open t ==> real_closed(s DIFF t)"
   (REWRITE_TAC [REAL_OPEN_IN, REAL_CLOSED_IN, CLOSED_IN_DIFF])

  let REAL_OPEN_INTERS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> real_open t) ==> real_open(INTERS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_INSERT, INTERS_0, REAL_OPEN_UNIV, IN_INSERT] THEN
    MESON_TAC [REAL_OPEN_INTER])

  let REAL_CLOSED_UNIONS ← prove
   r"!s. FINITE s /\ (!t. t IN s ==> real_closed t) ==> real_closed(UNIONS s)"
   (REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_INSERT, UNIONS_0, REAL_CLOSED_EMPTY, IN_INSERT] THEN
    MESON_TAC [REAL_CLOSED_UNION])

  let REAL_OPEN_HALFSPACE_GT ← prove
   r"!a. real_open {x | x > a}"
   (GEN_TAC THEN REWRITE_TAC [real_open, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"abs(a - b):real") THEN ASM_REAL_ARITH_TAC)

  let REAL_OPEN_HALFSPACE_LT ← prove
   r"!a. real_open {x | x < a}"
   (GEN_TAC THEN REWRITE_TAC [real_open, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"abs(a - b):real") THEN ASM_REAL_ARITH_TAC)

  let REAL_OPEN_REAL_INTERVAL ← prove
   r"!a b. real_open(real_interval(a,b))"
   (REWRITE_TAC [real_interval, ← sr
     r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}"] THEN
    SIMP_TAC [REAL_OPEN_INTER, REAL_OPEN_HALFSPACE_LT,
              ← REWRITE_RULE [real_gt] REAL_OPEN_HALFSPACE_GT])

  let REAL_CLOSED_HALFSPACE_LE ← prove
   r"!a. real_closed {x | x <= a}"
   (GEN_TAC THEN
    REWRITE_TAC [real_closed, real_open, IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"abs(a - b):real") THEN ASM_REAL_ARITH_TAC)

  let REAL_CLOSED_HALFSPACE_GE ← prove
   r"!a. real_closed {x | x >= a}"
   (GEN_TAC THEN
    REWRITE_TAC [real_closed, real_open, IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"abs(a - b):real") THEN ASM_REAL_ARITH_TAC)

  let REAL_CLOSED_REAL_INTERVAL ← prove
   r"!a b. real_closed(real_interval[a,b])"
   (REWRITE_TAC [real_interval, ← sr
     r"{x | P x /\ Q x} = {x | P x} INTER {x | Q x}"] THEN
    SIMP_TAC [REAL_CLOSED_INTER, REAL_CLOSED_HALFSPACE_LE,
              ← REWRITE_RULE [real_ge] REAL_CLOSED_HALFSPACE_GE])

  let REAL_CLOSED_SING ← prove
   r"!a. real_closed {a}"
   (MESON_TAC [REAL_INTERVAL_SING, REAL_CLOSED_REAL_INTERVAL])

  return { real_open, real_closed, euclideanreal, REAL_OPEN_EMPTY, REAL_OPEN_UNIV,
           REAL_OPEN_INTER, REAL_OPEN_UNIONS, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL,
           TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, REAL_CLOSED_IN, REAL_OPEN_UNION,
           REAL_OPEN_SUBREAL_OPEN, REAL_CLOSED_EMPTY, REAL_CLOSED_UNIV, REAL_CLOSED_UNION,
           REAL_CLOSED_INTER, REAL_CLOSED_INTERS, REAL_OPEN_REAL_CLOSED, REAL_OPEN_DIFF,
           REAL_CLOSED_DIFF, REAL_OPEN_INTERS, REAL_CLOSED_UNIONS, REAL_OPEN_HALFSPACE_GT,
           REAL_OPEN_HALFSPACE_LT, REAL_OPEN_REAL_INTERVAL, REAL_CLOSED_HALFSPACE_LE,
           REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_REAL_INTERVAL, REAL_CLOSED_SING }

/- ------------------------------------------------------------------------- -/
/- The usual metric on R; closures, interiors and frontiers of half-spaces.  -/
/- (metric.ml 18188-18484)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealTop2 where
  real_euclidean_metric : thm
  REAL_EUCLIDEAN_METRIC : thm
  MTOPOLOGY_REAL_EUCLIDEAN_METRIC : thm
  MBALL_REAL_INTERVAL : thm
  MCBALL_REAL_INTERVAL : thm
  METRIZABLE_SPACE_EUCLIDEANREAL : thm
  HAUSDORFF_SPACE_EUCLIDEANREAL : thm
  KC_SPACE_EUCLIDEANREAL : thm
  T1_SPACE_EUCLIDEANREAL : thm
  REGULAR_SPACE_EUCLIDEANREAL : thm
  SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL : thm
  EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE : thm
  EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE : thm
  EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT : thm
  EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT : thm
  EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GE : thm
  EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LE : thm
  EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GT : thm
  EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LT : thm
  EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GE : thm
  EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LE : thm
  EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GT : thm
  EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LT : thm
  EUCLIDEANREAL_CLOSURE_OF_RATIONAL : thm
  EUCLIDEANREAL_CLOSURE_OF_IRRATIONAL : thm
  NOT_LOCALLY_COMPACT_SPACE_RATIONAL_GEN : thm
  NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL_GEN : thm
  NOT_LOCALLY_COMPACT_SPACE_RATIONAL : thm
  NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL : thm
  deriving Inhabited

@[nospecialize]
def setupRealTop2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BBases : Bases) (BClosure : Closure) (BInterior : Interior)
    (BFrontier : Frontier) (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BMetrizable : Metrizable)
    (BRegular1 : Regular1) (BLocCompact2 : LocCompact2) (BLocCompact3 : LocCompact3)
    (BRealTop1 : RealTop1) : ExceptT String IO RealTop2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, new_definition, .. } := D
  let { EXTENSION, FINITE_INTERSECTION_OF_INC, FINITE_INTERSECTION_OF_INTER,
        FORALL_INTERSECTION_OF, FORALL_IN_GSPEC, FORALL_IN_UNION, .. } := D.core1
  let { IN, INTERS_0, INTER_COMM, INTER_UNIV, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNION,
        IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IMP, .. } := D.core2
  let { SIMPLE_IMAGE_GEN, SUBSET, SUBSET_ANTISYM, SUBSET_RESTRICT, UNIV_NOT_EMPTY, real_ge,
        real_gt, .. } := D.core4
  let { EQ_IMP, MONO_IMP, .. } := D.core5
  let { ARBITRARY_UNION_OF_RELATIVE_TO, IN_REAL_INTERVAL, IRRATIONAL_APPROXIMATION,
        RELATIVE_TO, .. } := D.misc
  let { RATIONAL_APPROXIMATION, .. } := D.lib
  let { OPEN_IN_INTERS, OPEN_IN_TOPSPACE, TOPOLOGY_EQ, .. } := BTopology
  let { OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_OPEN, SUBTOPOLOGY_SUBTOPOLOGY,
        subtopology, .. } := BSubtopology
  let { OPEN_IN_TOPOLOGY_BASE_UNIQUE, .. } := BBases
  let { CLOSURE_OF_EQ, CLOSURE_OF_MONO, CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBTOPOLOGY_OPEN,
        .. } := BClosure
  let { INTERIOR_OF_CLOSURE_OF, INTERIOR_OF_EQ, INTERIOR_OF_SUBSET, INTERIOR_OF_TOPSPACE,
        OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { frontier_of, .. } := BFrontier
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { IN_MBALL, is_metric_space, mball, mdist, metric_tybij, mspace, .. } := BMetricSpace
  let { IN_MCBALL, METRIC_CLOSURE_OF, OPEN_IN_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { KC_SPACE_MTOPOLOGY, METRIZABLE_SPACE_MTOPOLOGY, .. } := BMetrizable
  let { METRIZABLE_IMP_REGULAR_SPACE, .. } := BRegular1
  let { LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } := BLocCompact2
  let { DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE, .. } := BLocCompact3
  let { REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN,
        REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, real_open, .. } := BRealTop1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let real_euclidean_metric ← new_definition
    r"real_euclidean_metric = metric ((:real),\(x,y). abs(y-x))"

  let REAL_EUCLIDEAN_METRIC ← prove
   r"mspace real_euclidean_metric = (:real) /\
   (!x y. mdist real_euclidean_metric (x,y) = abs(y-x))"
   (SUBGOAL_THEN (← q r"is_metric_space((:real),\ (x,y). abs(y-x))") MP_TAC THENL
    [REWRITE_TAC [is_metric_space, IN_UNIV] THEN REAL_ARITH_TAC,
     SIMP_TAC [real_euclidean_metric, metric_tybij, mspace, mdist]])

  let MTOPOLOGY_REAL_EUCLIDEAN_METRIC ← prove
   r"mtopology real_euclidean_metric = euclideanreal"
   (REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_MTOPOLOGY, REAL_EUCLIDEAN_METRIC,
      ← GSYM REAL_OPEN_IN, real_open, IN_MBALL, REAL_EUCLIDEAN_METRIC,
      SUBSET, IN_UNIV])

  let MBALL_REAL_INTERVAL ← prove
   r"!x r. mball real_euclidean_metric (x,r) = real_interval(x - r,x + r)"
   (REWRITE_TAC [EXTENSION, IN_MBALL, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let MCBALL_REAL_INTERVAL ← prove
   r"!x r. mcball real_euclidean_metric (x,r) = real_interval[x - r,x + r]"
   (REWRITE_TAC [EXTENSION, IN_MCBALL, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let METRIZABLE_SPACE_EUCLIDEANREAL ← prove
   r"metrizable_space euclideanreal"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 METRIZABLE_SPACE_MTOPOLOGY])

  let HAUSDORFF_SPACE_EUCLIDEANREAL ← prove
   r"hausdorff_space euclideanreal"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 HAUSDORFF_SPACE_MTOPOLOGY])

  let KC_SPACE_EUCLIDEANREAL ← prove
   r"kc_space euclideanreal"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, KC_SPACE_MTOPOLOGY])

  let T1_SPACE_EUCLIDEANREAL ← prove
   r"t1_space euclideanreal"
   (SIMP_TAC [HAUSDORFF_SPACE_EUCLIDEANREAL, HAUSDORFF_IMP_T1_SPACE])

  let REGULAR_SPACE_EUCLIDEANREAL ← prove
   r"regular_space euclideanreal"
   (MESON_TAC [METRIZABLE_IMP_REGULAR_SPACE, METRIZABLE_SPACE_EUCLIDEANREAL])

  let SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL ← prove
   r"!u. topology
        (ARBITRARY UNION_OF
          (FINITE INTERSECTION_OF
            ({{x | x > a} | a IN (:real)} UNION {{x | x < a} | a IN (:real)})
           relative_to u)) =
       subtopology euclideanreal u"
   (GEN_TAC THEN
    REWRITE_TAC [subtopology, ← GSYM ARBITRARY_UNION_OF_RELATIVE_TO] THEN
    AP_TERM_TAC THEN REWRITE_TAC [RELATIVE_TO] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [INTER_COMM] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"s:real->bool") THEN AP_THM_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC ONCE_DEPTH_CONV [IN] THEN
      REWRITE_TAC [FORALL_INTERSECTION_OF] THEN
      X_GEN_TAC (← q r"t:(real->bool)->bool") THEN
      ASM_CASES_TAC (← q r"t:(real->bool)->bool = {}") THENL
       [ASM_MESON_TAC [TOPSPACE_EUCLIDEANREAL, INTERS_0, OPEN_IN_TOPSPACE],
        ALL_TAC] THEN
      DISCH_THEN (fun th => MATCH_MP_TAC OPEN_IN_INTERS THEN
        CONJUNCTS_THEN2 ASSUME_TAC MP_TAC th) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"d:real->bool") THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      SPEC_TAC (← q r"d:real->bool", ← q r"d:real->bool") THEN
      GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
      REWRITE_TAC [FORALL_IN_UNION, FORALL_IN_GSPEC, IN_UNIV] THEN
      REWRITE_TAC [← GSYM REAL_OPEN_IN, REAL_OPEN_HALFSPACE_LT] THEN
      REWRITE_TAC [REAL_OPEN_HALFSPACE_GT],
      MAP_EVERY X_GEN_TAC [← q r"u:real->bool", ← q r"x:real"] THEN
      REWRITE_TAC [real_open, ← GSYM REAL_OPEN_IN] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (MP_TAC o SPEC (← q r"x:real")) ASSUME_TAC) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"{y:real | y > x - d} INTER {y | y < x + d}") THEN
      CONJ_TAC THENL
       [GEN_REWRITE_TAC id [IN] THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INTER THEN CONJ_TAC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        GEN_REWRITE_TAC id [← GSYM IN] THEN
        REWRITE_TAC [IN_UNION, IN_ELIM_THM] THENL
         [DISJ1_TAC THEN EXISTS_TAC (← q r"x - d:real"),
          DISJ2_TAC THEN EXISTS_TAC (← q r"x + d:real")] THEN
        REWRITE_TAC [IN_UNIV],
        REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REAL_ARITH_TAC]])

  let EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE ← prove
   r"!a. euclideanreal closure_of {x | x >= a} = {x | x >= a}"
   (SIMP_TAC [CLOSURE_OF_EQ, ← GSYM REAL_CLOSED_IN, REAL_CLOSED_HALFSPACE_GE])

  let EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE ← prove
   r"!a. euclideanreal closure_of {x | x <= a} = {x | x <= a}"
   (SIMP_TAC [CLOSURE_OF_EQ, ← GSYM REAL_CLOSED_IN, REAL_CLOSED_HALFSPACE_LE])

  let EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT ← prove
   r"!a. euclideanreal closure_of {x | x > a} = {x | x >= a}"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE] THEN
      MATCH_MP_TAC CLOSURE_OF_MONO THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM, real_gt, real_ge] THEN
      REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_CLOSURE_OF] THEN
      X_GEN_TAC (← q r"b:real") THEN REWRITE_TAC [REAL_EUCLIDEAN_METRIC, mball] THEN
      DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"b + e / &2") THEN ASM_REAL_ARITH_TAC])

  let EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT ← prove
   r"!a. euclideanreal closure_of {x | x < a} = {x | x <= a}"
   (GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC RAND_CONV [← GSYM EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE] THEN
      MATCH_MP_TAC CLOSURE_OF_MONO THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN REAL_ARITH_TAC,
      REWRITE_TAC [SUBSET, IN_ELIM_THM, real_gt, real_ge] THEN
      REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_CLOSURE_OF] THEN
      X_GEN_TAC (← q r"b:real") THEN REWRITE_TAC [REAL_EUCLIDEAN_METRIC, mball] THEN
      DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"b - e / &2") THEN ASM_REAL_ARITH_TAC])

  let EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GE ← prove
   r"!a. euclideanreal interior_of {x | x >= a} = {x | x > a}"
   (GEN_TAC THEN REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [← sr r"UNIV DIFF {x | P x} = {x | ~P x}"] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"~(x >= a) <=> x < a")] THEN
    REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT, EXTENSION] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LE ← prove
   r"!a. euclideanreal interior_of {x | x <= a} = {x | x < a}"
   (GEN_TAC THEN REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [← sr r"UNIV DIFF {x | P x} = {x | ~P x}"] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"~(x <= a) <=> x > a")] THEN
    REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT, EXTENSION] THEN
    REWRITE_TAC [IN_DIFF, IN_UNIV, IN_ELIM_THM] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GT ← prove
   r"!a. euclideanreal interior_of {x | x > a} = {x | x > a}"
   (SIMP_TAC [INTERIOR_OF_EQ, ← GSYM REAL_OPEN_IN, REAL_OPEN_HALFSPACE_GT])

  let EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LT ← prove
   r"!a. euclideanreal interior_of {x | x < a} = {x | x < a}"
   (SIMP_TAC [INTERIOR_OF_EQ, ← GSYM REAL_OPEN_IN, REAL_OPEN_HALFSPACE_LT])

  let EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GE ← prove
   r"!a. euclideanreal frontier_of {x | x >= a} = {x | x = a}"
   (GEN_TAC THEN REWRITE_TAC [frontier_of] THEN
    REWRITE_TAC [EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GE,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_DIFF, EXTENSION] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LE ← prove
   r"!a. euclideanreal frontier_of {x | x <= a} = {x | x = a}"
   (GEN_TAC THEN REWRITE_TAC [frontier_of] THEN
    REWRITE_TAC [EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LE,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_DIFF, EXTENSION] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GT ← prove
   r"!a. euclideanreal frontier_of {x | x > a} = {x | x = a}"
   (GEN_TAC THEN REWRITE_TAC [frontier_of] THEN
    REWRITE_TAC [EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GT,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_DIFF, EXTENSION] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LT ← prove
   r"!a. euclideanreal frontier_of {x | x < a} = {x | x = a}"
   (GEN_TAC THEN REWRITE_TAC [frontier_of] THEN
    REWRITE_TAC [EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LT,
                 EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_DIFF, EXTENSION] THEN REAL_ARITH_TAC)

  let EUCLIDEANREAL_CLOSURE_OF_RATIONAL ← prove
   r"euclideanreal closure_of rational = (:real)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [METRIC_CLOSURE_OF, IN_MBALL, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, EXTENSION] THEN
    REWRITE_TAC [IN, RATIONAL_APPROXIMATION])

  let EUCLIDEANREAL_CLOSURE_OF_IRRATIONAL ← prove
   r"euclideanreal closure_of {z | ~rational z} = (:real)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [METRIC_CLOSURE_OF, IN_MBALL, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, EXTENSION] THEN
    REWRITE_TAC [IN, IRRATIONAL_APPROXIMATION])

  let NOT_LOCALLY_COMPACT_SPACE_RATIONAL_GEN ← prove
   r"!s. ~(euclideanreal interior_of s = {})
       ==> ~locally_compact_space
              (subtopology euclideanreal {q | q IN s /\ rational q})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclideanreal (euclideanreal interior_of s)",
                     ← q r"{q | q IN euclideanreal interior_of s /\ rational q}"]
          DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_EUCLIDEANREAL],
      ONCE_REWRITE_TAC [← sr r"{x | x IN s /\ P x} = s INTER {x | P x}"] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV)
       [← GSYM TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT] THEN
      SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY_OPEN, OPEN_IN_INTERIOR_OF] THEN
      REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_RATIONAL, INTER_UNIV,
                   ← sr r"{x | P x} = P"],
      MP_TAC (← ISPECL
       [← q r"subtopology euclideanreal {q | q IN s /\ rational q}",
        ← q r"{q | q IN s /\ rational q} INTER euclideanreal interior_of s"]
       LOCALLY_COMPACT_SPACE_OPEN_SUBSET) THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_EUCLIDEANREAL,
                    OPEN_IN_SUBTOPOLOGY_INTER_OPEN, OPEN_IN_INTERIOR_OF] THEN
      MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"s:real->bool"] INTERIOR_OF_SUBSET) THEN
      SET_TAC [],
      SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_INTERIOR_OF] THEN
      DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      SUBGOAL_THEN
       (← q r"?q. q IN euclideanreal interior_of s /\ rational q")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"a:real")) THEN
        MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"s:real->bool"] OPEN_IN_INTERIOR_OF) THEN
        REWRITE_TAC [← GSYM REAL_OPEN_IN, real_open, IN_ELIM_THM] THEN
        ASM_MESON_TAC [RATIONAL_APPROXIMATION],
        REWRITE_TAC [← GSYM REAL_OPEN_IN, real_open, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"q:real")) THEN ASM_REWRITE_TAC [] THEN
        MESON_TAC [IRRATIONAL_APPROXIMATION]]])

  let NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL_GEN ← prove
   r"!s. ~(euclideanreal interior_of s = {})
       ==> ~locally_compact_space
              (subtopology euclideanreal {q | q IN s /\ ~rational q})"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology euclideanreal (euclideanreal interior_of s)",
                     ← q r"{q | q IN euclideanreal interior_of s /\ ~rational q}"]
          DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE) THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_EUCLIDEANREAL],
      ONCE_REWRITE_TAC [← sr r"{x | x IN s /\ P x} = s INTER {x | P x}"] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV o LAND_CONV)
       [← GSYM TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT] THEN
      SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY_OPEN, OPEN_IN_INTERIOR_OF] THEN
      REWRITE_TAC [EUCLIDEANREAL_CLOSURE_OF_IRRATIONAL, INTER_UNIV],
      MP_TAC (← ISPECL
       [← q r"subtopology euclideanreal {q | q IN s /\ ~rational q}",
        ← q r"{q | q IN s /\ ~rational q} INTER euclideanreal interior_of s"]
       LOCALLY_COMPACT_SPACE_OPEN_SUBSET) THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_EUCLIDEANREAL,
                    OPEN_IN_SUBTOPOLOGY_INTER_OPEN, OPEN_IN_INTERIOR_OF] THEN
      MATCH_MP_TAC EQ_IMP THEN REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"s:real->bool"] INTERIOR_OF_SUBSET) THEN
      SET_TAC [],
      SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_INTERIOR_OF] THEN
      DISCH_THEN (MP_TAC o CONJUNCT1) THEN
      SUBGOAL_THEN
       (← q r"?q. q IN euclideanreal interior_of s /\ ~rational q")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"a:real")) THEN
        MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"s:real->bool"] OPEN_IN_INTERIOR_OF) THEN
        REWRITE_TAC [← GSYM REAL_OPEN_IN, real_open, IN_ELIM_THM] THEN
        ASM_MESON_TAC [IRRATIONAL_APPROXIMATION],
        REWRITE_TAC [← GSYM REAL_OPEN_IN, real_open, IN_ELIM_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"q:real")) THEN ASM_REWRITE_TAC [] THEN
        MESON_TAC [RATIONAL_APPROXIMATION]]])

  let NOT_LOCALLY_COMPACT_SPACE_RATIONAL ← prove
   r"~locally_compact_space (subtopology euclideanreal rational)"
   (MP_TAC (← SPEC (← q r"topspace euclideanreal")
      NOT_LOCALLY_COMPACT_SPACE_RATIONAL_GEN) THEN
    REWRITE_TAC [INTERIOR_OF_TOPSPACE] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV, UNIV_NOT_EMPTY] THEN
    REWRITE_TAC [← sr r"{x | P x} = P"])

  let NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL ← prove
   r"~locally_compact_space (subtopology euclideanreal {z | ~rational z})"
   (MP_TAC (← SPEC (← q r"topspace euclideanreal")
      NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL_GEN) THEN
    REWRITE_TAC [INTERIOR_OF_TOPSPACE] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, IN_UNIV, UNIV_NOT_EMPTY])

  return { real_euclidean_metric, REAL_EUCLIDEAN_METRIC, MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
           MBALL_REAL_INTERVAL, MCBALL_REAL_INTERVAL, METRIZABLE_SPACE_EUCLIDEANREAL,
           HAUSDORFF_SPACE_EUCLIDEANREAL, KC_SPACE_EUCLIDEANREAL, T1_SPACE_EUCLIDEANREAL,
           REGULAR_SPACE_EUCLIDEANREAL, SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL,
           EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GE, EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LE,
           EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_GT, EUCLIDEANREAL_CLOSURE_OF_HALFSPACE_LT,
           EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GE, EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LE,
           EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_GT, EUCLIDEANREAL_INTERIOR_OF_HALFSPACE_LT,
           EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GE, EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LE,
           EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_GT, EUCLIDEANREAL_FRONTIER_OF_HALFSPACE_LT,
           EUCLIDEANREAL_CLOSURE_OF_RATIONAL, EUCLIDEANREAL_CLOSURE_OF_IRRATIONAL,
           NOT_LOCALLY_COMPACT_SPACE_RATIONAL_GEN, NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL_GEN,
           NOT_LOCALLY_COMPACT_SPACE_RATIONAL, NOT_LOCALLY_COMPACT_SPACE_IRRATIONAL }

/- ------------------------------------------------------------------------- -/
/- Boundedness in R; connectedness and compactness characterizations for R.  -/
/- (metric.ml 18486-18682)                                                    -/
/- ------------------------------------------------------------------------- -/

structure RealConn1 where
  real_bounded : thm
  REAL_BOUNDED_POS : thm
  MBOUNDED_REAL_EUCLIDEAN_METRIC : thm
  REAL_BOUNDED_REAL_INTERVAL : thm
  REAL_BOUNDED_SHRINK : thm
  NOT_REAL_BOUNDED_UNIV : thm
  CONNECTED_IN_EUCLIDEANREAL : thm
  CONNECTED_IN_EUCLIDEANREAL_INTERVAL : thm
  COMPACT_IN_EUCLIDEANREAL_INTERVAL : thm
  COMPACT_IN_EUCLIDEANREAL : thm
  deriving Inhabited

@[nospecialize]
def setupRealConn1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BHausdorff1 : Hausdorff1) (BMTopology : MTopology)
    (BBounded : Bounded) (BMetricHaus : MetricHaus) (BConnected1 : Connected1)
    (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) : ExceptT String IO RealConn1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, EXTENSION, FINITE_EMPTY, FINITE_INSERT, FINITE_SING, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, FORALL_SUBSET_IMAGE, FORALL_SUBSET_UNION, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, INTER_ASSOC, INTER_COMM, INTER_UNIV, IN_ELIM_THM, IN_IMAGE, IN_INTER,
        IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { REAL_COMPLETE, REAL_DOWN, REAL_DOWN2, REAL_LE_ANTISYM, REAL_LE_REFL, REAL_LE_TOTAL,
        REAL_LT_IMP_LE, REAL_LT_LE, REAL_NOT_LT, .. } := D.core3
  let { REAL_SHRINK_RANGE, REAL_SUB_LT, REAL_WLOG_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE,
        SING_SUBSET, SUBSET, SUBSET_UNIV, UNIONS_1, UNIONS_2, UNIONS_GSPEC, UNIONS_IMAGE,
        UNIONS_UNION, UNION_COMM, real_gt, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, NOT_EXISTS_THM, OR_EXISTS_THM, RIGHT_AND_EXISTS_THM,
        .. } := D.core5
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_INTERVAL, REAL_INTERVAL_NE_EMPTY, is_realinterval,
        .. } := D.misc
  let { OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_COMPACT_IN, COMPACT_IN_EMPTY, COMPACT_IN_SUBSPACE, .. } := BCompact1
  let { ALEXANDER_SUBBASE_THEOREM_ALT, .. } := BCompact3
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { IN_MCBALL, mcball, .. } := BMTopology
  let { mbounded, .. } := BBounded
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { CONNECTED_IN, .. } := BConnected1
  let { REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL,
        real_open, .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC,
        SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL, .. } := BRealTop2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let real_bounded ← new_definition
   r"real_bounded s <=> ?B. !x. x IN s ==> abs(x) <= B"

  let REAL_BOUNDED_POS ← prove
   r"!s. real_bounded s <=> ?B. &0 < B /\ !x. x IN s ==> abs(x) <= B"
   (REWRITE_TAC [real_bounded] THEN
    MESON_TAC [← REAL_ARITH (← q r"&0 < &1 + abs B /\ (x <= B ==> x <= &1 + abs B)")])

  let MBOUNDED_REAL_EUCLIDEAN_METRIC ← prove
   r"mbounded real_euclidean_metric = real_bounded"
   (REWRITE_TAC [FUN_EQ_THM] THEN X_GEN_TAC (← q r"s:real->bool") THEN
    REWRITE_TAC [mbounded, real_bounded] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, SUBSET, IN_MCBALL, IN_UNIV] THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
     [MAP_EVERY X_GEN_TAC [← q r"c:real", ← q r"b:real"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"abs c + b"),
      X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"&0", ← q r"b:real"]] THEN
    X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let REAL_BOUNDED_REAL_INTERVAL ← prove
   r"(!a b. real_bounded(real_interval[a,b])) /\
   (!a b. real_bounded(real_interval(a,b)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [real_bounded, IN_REAL_INTERVAL] THEN
    EXISTS_TAC (← q r"max (abs a) (abs b)") THEN REAL_ARITH_TAC)

  let REAL_BOUNDED_SHRINK ← prove
   r"!s. real_bounded (IMAGE (\x. x / (&1 + abs x)) s)"
   (GEN_TAC THEN REWRITE_TAC [real_bounded, FORALL_IN_IMAGE] THEN
    MESON_TAC [REAL_SHRINK_RANGE, REAL_LT_IMP_LE])

  let NOT_REAL_BOUNDED_UNIV ← prove
   r"~real_bounded (:real)"
   (REWRITE_TAC [real_bounded, NOT_EXISTS_THM, IN_UNIV] THEN
    X_GEN_TAC (← q r"B:real") THEN DISCH_THEN (MP_TAC o SPEC (← q r"abs B + &1")) THEN
    REAL_ARITH_TAC)

  let CONNECTED_IN_EUCLIDEANREAL ← do
    let tac := ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_TOTAL, REAL_LE_ANTISYM]
    prove
     r"!s. connected_in euclideanreal s <=> is_realinterval s"
     (GEN_TAC THEN
      REWRITE_TAC [CONNECTED_IN, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
      REWRITE_TAC [← GSYM REAL_OPEN_IN, is_realinterval, NOT_EXISTS_THM] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
      EQ_TAC THEN DISCH_TAC THENL
       [MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN STRIP_TAC THEN
        ASM_CASES_TAC (← q r"(c:real) IN s") THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:real | x < c}", ← q r"{x:real | x > c}"]) THEN
        REWRITE_TAC [REAL_OPEN_HALFSPACE_LT, REAL_OPEN_HALFSPACE_GT] THEN
        REWRITE_TAC [SUBSET, EXTENSION, IN_INTER, IN_UNION, IN_ELIM_THM] THEN
        REWRITE_TAC [NOT_IN_EMPTY, ← REAL_ARITH (← q r"x < a \/ x > a <=> ~(x = a)")] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
        CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN CONJ_TAC THENL
         [DISCH_THEN (MP_TAC o SPEC (← q r"a:real")),
          DISCH_THEN (MP_TAC o SPEC (← q r"b:real"))] THEN
        ASM_REWRITE_TAC [REAL_LT_LE, real_gt] THEN ASM SET_TAC [],
        REWRITE_TAC [← TAUT (← q r"~(p /\ q /\ r /\ s /\ t /\ u) <=>
                          t /\ u ==> ~(p /\ q /\ r /\ s)")] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_AND_EXISTS_THM] THEN
        REWRITE_TAC [IN_INTER, RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
        ONCE_REWRITE_TAC [← MESON [] (← q
         r"(!s t x y. P x y s t) <=> (!x y s t. P x y s t)")] THEN
        MATCH_MP_TAC REAL_WLOG_LT THEN
        CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [← GSYM INTER_ASSOC]] THEN
        CONJ_TAC THENL [MESON_TAC [INTER_COMM, UNION_COMM], ALL_TAC] THEN
        MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN DISCH_TAC THEN
        MAP_EVERY X_GEN_TAC [← q r"e1:real->bool", ← q r"e2:real->bool"] THEN STRIP_TAC THEN
        REWRITE_TAC [real_open] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"~(?x:real. a <= x /\ x <= b /\ x IN e1 /\ x IN e2)")
        ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
        SUBGOAL_THEN (← q r"?x:real. a <= x /\ x <= b /\ ~(x IN e1) /\ ~(x IN e2)")
        MP_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        MP_TAC (← SPEC (← q r"\c:real. !x. a <= x /\ x <= c ==> x IN e1") REAL_COMPLETE) THEN
        REWRITE_TAC [] THEN ANTS_TAC THENL [tac, ALL_TAC] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:real") THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"a <= x /\ x <= b") STRIP_ASSUME_TAC THENL [tac, ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN
        SUBGOAL_THEN (← q r"!z. a <= z /\ z < x ==> (z:real) IN e1") ASSUME_TAC THENL
         [ASM_MESON_TAC [REAL_NOT_LT, REAL_LT_IMP_LE], ALL_TAC] THEN
        REPEAT STRIP_TAC THENL
         [SUBGOAL_THEN
           (← q r"?d. &0 < d /\ !y. abs(y - x) < d ==> (y:real) IN e1")
          STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          ASM_MESON_TAC [REAL_DOWN, ← REAL_ARITH (← q r"&0 < e ==> ~(x + e <= x)"),
           ← REAL_ARITH (← q r"z <= x + e /\ e < d ==> z < x \/ abs(z - x) < d")],
          SUBGOAL_THEN (← q r"?d. &0 < d /\ !y:real. abs(y - x) < d ==> y IN e2")
          STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
          MP_TAC (← SPECL [← q r"x - a:real", ← q r"d:real"] REAL_DOWN2) THEN ANTS_TAC THENL
           [ASM_MESON_TAC [REAL_LT_LE, REAL_SUB_LT], ALL_TAC] THEN
          ASM_MESON_TAC [← REAL_ARITH (← q r"e < x - a ==> a <= x - e"),
            ← REAL_ARITH (← q r"&0 < e /\ e < d ==> x - e < x /\ abs((x - e) - x) < d"),
            ← REAL_ARITH (← q r"&0 < e /\ x <= b ==> x - e <= b")]]])

  let CONNECTED_IN_EUCLIDEANREAL_INTERVAL ← prove
   r"(!a b. connected_in euclideanreal (real_interval[a,b])) /\
   (!a b. connected_in euclideanreal (real_interval(a,b)))"
   (REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL, IS_REALINTERVAL_INTERVAL])

  let COMPACT_IN_EUCLIDEANREAL_INTERVAL ← prove
   r"!a b. compact_in euclideanreal (real_interval[a,b])"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"real_interval[a,b] = {}") THEN
    ASM_REWRITE_TAC [COMPACT_IN_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_INTERVAL_NE_EMPTY]) THEN
    REWRITE_TAC [COMPACT_IN_SUBSPACE, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
    MATCH_MP_TAC ALEXANDER_SUBBASE_THEOREM_ALT THEN
    EXISTS_TAC
     (← q r"{{x | x > a} | a IN (:real)} UNION {{x | x < a} | a IN (:real)}") THEN
    EXISTS_TAC (← q r"real_interval[a,b]") THEN
    REWRITE_TAC [SUBBASE_SUBTOPOLOGY_EUCLIDEANREAL] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_UNION] THEN
      MATCH_MP_TAC (← sr r"(!x. x IN s) ==> t SUBSET s UNION v") THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      MESON_TAC [← REAL_ARITH (← q r"a > a - &1:real")],
      ALL_TAC] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_UNION, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [SIMPLE_IMAGE, FORALL_SUBSET_IMAGE, SUBSET_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"l:real->bool", ← q r"r:real->bool"] THEN
    REWRITE_TAC [UNIONS_UNION] THEN DISCH_TAC THEN MP_TAC
     (← CONJUNCT2 (← ISPECL [← q r"a:real", ← q r"b:real"] IS_REALINTERVAL_INTERVAL)) THEN
    REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEANREAL] THEN
    REWRITE_TAC [CONNECTED_IN, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV,
                 NOT_EXISTS_THM] THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"UNIONS (IMAGE (\a:real. {x | x > a}) l)",
      ← q r"UNIONS (IMAGE (\a:real. {x | x < a}) r)"]) THEN
    ASM_REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(p /\ q) /\ ((s ==> u) /\ (t ==> u)) /\ (~r ==> u)
      ==> ~(p /\ q /\ r /\ ~s /\ ~t) ==> u")) THEN
    CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM REAL_OPEN_IN] THEN
      REWRITE_TAC [REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [CONJ_TAC THENL
       [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
         r"s SUBSET u UNION v
          ==> ((!x. x IN s ==> x IN v) ==> P) ==> u INTER s = {} ==> P")) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"b:real")),
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
         r"s SUBSET u UNION v
          ==> ((!x. x IN s ==> x IN u) ==> P) ==> v INTER s = {} ==> P")) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"a:real"))] THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL, REAL_LE_REFL] THEN
      REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:real") THEN STRIP_TAC THENL
       [EXISTS_TAC (← q r"{{x:real | x < c}}"), EXISTS_TAC (← q r"{{x:real | x > c}}")] THEN
      REWRITE_TAC [FINITE_SING, SING_SUBSET, UNIONS_1] THEN
      REWRITE_TAC [IN_UNION, IN_IMAGE, OR_EXISTS_THM, LEFT_AND_EXISTS_THM] THEN
      EXISTS_TAC (← q r"c:real") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_REAL_INTERVAL, IN_ELIM_THM] THEN
      ASM_REAL_ARITH_TAC,
      REWRITE_TAC [EXTENSION, UNIONS_IMAGE, NOT_IN_EMPTY, IN_INTER] THEN
      REWRITE_TAC [IN_ELIM_THM, NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"c:real") THEN REWRITE_TAC [CONJ_ASSOC] THEN
      REWRITE_TAC [IN_REAL_INTERVAL] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"u:real") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"v:real") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"{{x:real | x > u},{x | x < v}}") THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, UNIONS_2] THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM, IN_REAL_INTERVAL] THEN
      CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, IN_IMAGE] THEN CONJ_TAC THENL
       [DISJ1_TAC THEN EXISTS_TAC (← q r"u:real") THEN ASM_REWRITE_TAC [],
        DISJ2_TAC THEN EXISTS_TAC (← q r"v:real") THEN ASM_REWRITE_TAC []]])

  let COMPACT_IN_EUCLIDEANREAL ← prove
   r"!s. compact_in euclideanreal s <=>
       mbounded real_euclidean_metric s /\ closed_in euclideanreal s"
   (GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_EUCLIDEANREAL,
                 COMPACT_IN_IMP_MBOUNDED, MTOPOLOGY_REAL_EUCLIDEAN_METRIC],
      STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [mbounded]) THEN
      REWRITE_TAC [mcball, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      REWRITE_TAC [SUBSET, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"d:real"] THEN STRIP_TAC THEN
      MATCH_MP_TAC CLOSED_COMPACT_IN THEN
      EXISTS_TAC (← q r"real_interval[a - d,a + d]") THEN
      ASM_REWRITE_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL] THEN
      REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN X_GEN_TAC (← q r"x:real") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN
      ASM_REWRITE_TAC [] THEN REAL_ARITH_TAC])

  return { real_bounded, REAL_BOUNDED_POS, MBOUNDED_REAL_EUCLIDEAN_METRIC,
           REAL_BOUNDED_REAL_INTERVAL, REAL_BOUNDED_SHRINK, NOT_REAL_BOUNDED_UNIV,
           CONNECTED_IN_EUCLIDEANREAL, CONNECTED_IN_EUCLIDEANREAL_INTERVAL,
           COMPACT_IN_EUCLIDEANREAL_INTERVAL, COMPACT_IN_EUCLIDEANREAL }


/- ------------------------------------------------------------------------- -/
/- Compactness in R; real intervals.  (metric.ml 18684-18979)                -/
/- ------------------------------------------------------------------------- -/

structure RealConn2 where
  real_compact_def : thm
  REAL_COMPACT_EQ_BOUNDED_CLOSED : thm
  REAL_COMPACT_IMP_BOUNDED : thm
  REAL_COMPACT_IMP_CLOSED : thm
  NOT_REAL_COMPACT_UNIV : thm
  NOT_COMPACT_SPACE_EUCLIDEANREAL : thm
  REAL_COMPACT_INTERVAL : thm
  REAL_COMPACT_UNION : thm
  REAL_CLOSED_CONTAINS_SUP : thm
  REAL_COMPACT_CONTAINS_SUP : thm
  REAL_COMPACT_ATTAINS_SUP : thm
  REAL_CLOSED_CONTAINS_INF : thm
  REAL_COMPACT_CONTAINS_INF : thm
  REAL_COMPACT_ATTAINS_INF : thm
  REAL_COMPACT_IS_REALINTERVAL : thm
  IS_REALINTERVAL_CLOSURE_OF : thm
  IS_REALINTERVAL_INTERIOR_OF : thm
  IS_REALINTERVAL_INTERIOR_SEGMENT : thm
  REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL : thm
  REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT : thm
  INTERIOR_OF_CLOSURE_OF_REALINTERVAL : thm
  CLOSURE_OF_REAL_INTERVAL : thm
  INTERIOR_OF_REAL_INTERVAL : thm
  CLOSURE_OF_INTERIOR_OF_REALINTERVAL : thm
  CARD_FRONTIER_OF_REALINTERVAL : thm
  LOCALLY_COMPACT_SPACE_EUCLIDEANREAL : thm
  deriving Inhabited

@[nospecialize]
def setupRealConn2 [HolBase] (D : MetricDeps) (BClosure : Closure) (BInterior : Interior)
    (BFrontier : Frontier) (BCompact1 : Compact1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BConnected2 : Connected2) (BLocCompact1 : LocCompact1)
    (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BRealConn1 : RealConn1) :
    ExceptT String IO RealConn2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC,
        SET_RULE, SET_TAC, HAS_SIZE_CONV, new_definition, .. } := D
  let { CHOOSE_SUBSET_STRONG, EMPTY_SUBSET, EXTENSION, .. } := D.core1
  let { INF, INSERT_AC, INSERT_SUBSET, IN_DIFF, IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_BOUNDS_LE, REAL_LT_IMP_LE, REAL_NOT_LT, .. } := D.core3
  let { REAL_SUB_LT, REAL_WLOG_LE_3, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, SUBSET_UNIV, SUP,
        UNION_SUBSET, .. } := D.core4
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_INTERVAL, REAL_CLOSED_OPEN_INTERVAL, REAL_HALF,
        REAL_INTERVAL_EQ_EMPTY, REAL_INTERVAL_NE_EMPTY, REAL_INTERVAL_OPEN_SUBSET_CLOSED,
        SUBSET_REAL_INTERVAL, is_realinterval, .. } := D.misc
  let { CLOSURE_OF_EMPTY, CLOSURE_OF_MINIMAL_EQ, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_EQ, .. } := BClosure
  let { INTERIOR_OF_MAXIMAL, INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_SUBSET,
        INTERIOR_OF_SUBSET_CLOSURE_OF, interior_of, .. } := BInterior
  let { frontier_of, .. } := BFrontier
  let { COMPACT_IN_UNION, compact_space, .. } := BCompact1
  let { mball, .. } := BMetricSpace
  let { METRIC_CLOSURE_OF, METRIC_INTERIOR_OF, OPEN_IN_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_CLOSURE_OF, .. } := BConnected2
  let { locally_compact_space, .. } := BLocCompact1
  let { REAL_CLOSED_IN, REAL_CLOSED_REAL_INTERVAL, REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL,
        TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { MBALL_REAL_INTERVAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC,
        .. } := BRealTop2
  let { COMPACT_IN_EUCLIDEANREAL, COMPACT_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_EUCLIDEANREAL,
        MBOUNDED_REAL_EUCLIDEAN_METRIC, NOT_REAL_BOUNDED_UNIV, real_bounded, .. } := BRealConn1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let real_compact_def ← new_definition
   r"real_compact s <=> compact_in euclideanreal s"

  let REAL_COMPACT_EQ_BOUNDED_CLOSED ← prove
   r"!s. real_compact s <=> real_bounded s /\ real_closed s"
   (REWRITE_TAC [real_compact_def, ← GSYM MBOUNDED_REAL_EUCLIDEAN_METRIC,
                 REAL_CLOSED_IN, COMPACT_IN_EUCLIDEANREAL])

  let REAL_COMPACT_IMP_BOUNDED ← prove
   r"!s. real_compact s ==> real_bounded s"
   (SIMP_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED])

  let REAL_COMPACT_IMP_CLOSED ← prove
   r"!s. real_compact s ==> real_closed s"
   (SIMP_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED])

  let NOT_REAL_COMPACT_UNIV ← prove
   r"~real_compact (:real)"
   (REWRITE_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED, NOT_REAL_BOUNDED_UNIV])

  let NOT_COMPACT_SPACE_EUCLIDEANREAL ← prove
   r"~compact_space euclideanreal"
   (REWRITE_TAC [compact_space, ← GSYM real_compact_def] THEN
    REWRITE_TAC [NOT_REAL_COMPACT_UNIV, TOPSPACE_EUCLIDEANREAL])

  let REAL_COMPACT_INTERVAL ← prove
   r"!a b. real_compact(real_interval[a,b])"
   (REWRITE_TAC [real_compact_def, COMPACT_IN_EUCLIDEANREAL_INTERVAL])

  let REAL_COMPACT_UNION ← prove
   r"!s t. real_compact s /\ real_compact t ==> real_compact(s UNION t)"
   (REWRITE_TAC [real_compact_def, COMPACT_IN_UNION])

  let REAL_CLOSED_CONTAINS_SUP ← prove
   r"!s b. real_closed s /\ ~(s = {}) /\ (!x. x IN s ==> x <= b)
         ==> sup s IN s"
   (REWRITE_TAC [REAL_CLOSED_IN, ← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_CLOSURE_OF] THEN
    REWRITE_TAC [mball, REAL_EUCLIDEAN_METRIC, IN_UNIV, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"s:real->bool") SUP) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC (← q r"sup s - e"))) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"s <= s - e <=> ~(&0 < e)"), NOT_FORALL_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real") THEN
    REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real"))) THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let REAL_COMPACT_CONTAINS_SUP ← prove
   r"!s. real_compact s /\ ~(s = {}) ==> sup s IN s"
   (REWRITE_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED, real_bounded] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CLOSED_CONTAINS_SUP THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs x <= b ==> x <= b")])

  let REAL_COMPACT_ATTAINS_SUP ← prove
   r"!s. real_compact s /\ ~(s = {}) ==> ?x. x IN s /\ !y. y IN s ==> y <= x"
   (REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"sup s") THEN
    ASM_SIMP_TAC [REAL_COMPACT_CONTAINS_SUP] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) SUP o snd) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], SIMP_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP REAL_COMPACT_IMP_BOUNDED) THEN
    REWRITE_TAC [real_bounded] THEN
    MESON_TAC [← REAL_ARITH (← q r"abs x <= b ==> x <= b")])

  let REAL_CLOSED_CONTAINS_INF ← prove
   r"!s b. real_closed s /\ ~(s = {}) /\ (!x. x IN s ==> b <= x)
         ==> inf s IN s"
   (REWRITE_TAC [REAL_CLOSED_IN, ← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [SUBSET, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_CLOSURE_OF] THEN
    REWRITE_TAC [mball, REAL_EUCLIDEAN_METRIC, IN_UNIV, IN_ELIM_THM] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    MP_TAC (← SPEC (← q r"s:real->bool") INF) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC (← q r"inf s + e"))) THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"s + e <= s <=> ~(&0 < e)"), NOT_FORALL_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:real") THEN
    REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real"))) THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let REAL_COMPACT_CONTAINS_INF ← prove
   r"!s. real_compact s /\ ~(s = {}) ==> inf s IN s"
   (REWRITE_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED, real_bounded] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC REAL_CLOSED_CONTAINS_INF THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [← REAL_ARITH (← q r"abs x <= b ==> --b <= x")])

  let REAL_COMPACT_ATTAINS_INF ← prove
   r"!s. real_compact s /\ ~(s = {}) ==> ?x. x IN s /\ !y. y IN s ==> x <= y"
   (REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"inf s") THEN
    ASM_SIMP_TAC [REAL_COMPACT_CONTAINS_INF] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) INF o snd) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], SIMP_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP REAL_COMPACT_IMP_BOUNDED) THEN
    REWRITE_TAC [real_bounded] THEN
    MESON_TAC [← REAL_ARITH (← q r"abs x <= b ==> --b <= x")])

  let REAL_COMPACT_IS_REALINTERVAL ← prove
   r"!s. real_compact s /\ is_realinterval s <=> ?a b. s = real_interval[a,b]"
   (GEN_TAC THEN EQ_TAC THENL
     [ASM_CASES_TAC (← q r"s:real->bool = {}") THENL
       [STRIP_TAC THEN MAP_EVERY EXISTS_TAC [← q r"&1", ← q r"&0"] THEN
        ASM_REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_REAL_INTERVAL] THEN
        REAL_ARITH_TAC,
        STRIP_TAC THEN MAP_EVERY EXISTS_TAC [← q r"inf s", ← q r"sup s"] THEN
        REWRITE_TAC [EXTENSION, IN_REAL_INTERVAL] THEN X_GEN_TAC (← q r"x:real") THEN
        EQ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
           [REAL_COMPACT_EQ_BOUNDED_CLOSED]) THEN
          REWRITE_TAC [real_bounded, ← GSYM REAL_BOUNDS_LE] THEN
          ASM_MESON_TAC [SUP, INF],
          STRIP_TAC THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [is_realinterval]) THEN
          ASM_MESON_TAC [REAL_COMPACT_CONTAINS_SUP, REAL_COMPACT_CONTAINS_INF]]],
      STRIP_TAC THEN
      ASM_REWRITE_TAC [REAL_COMPACT_INTERVAL, IS_REALINTERVAL_INTERVAL]])

  let IS_REALINTERVAL_CLOSURE_OF ← prove
   r"!s. is_realinterval s ==> is_realinterval(euclideanreal closure_of s)"
   (REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEANREAL, CONNECTED_IN_CLOSURE_OF])

  let IS_REALINTERVAL_INTERIOR_OF ← prove
   r"!s. is_realinterval s ==> is_realinterval(euclideanreal interior_of s)"
   (GEN_TAC THEN REWRITE_TAC [is_realinterval] THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"x:real"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x:real = a") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"x:real = b") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"x IN real_interval(a,b)") MP_TAC THENL
     [REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    MATCH_MP_TAC (← sr r"s SUBSET t ==> x IN s ==> x IN t") THEN
    MATCH_MP_TAC INTERIOR_OF_MAXIMAL THEN
    REWRITE_TAC [← GSYM REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL] THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    X_GEN_TAC (← q r"y:real") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE] THEN
    MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"s:real->bool"] INTERIOR_OF_SUBSET) THEN
    ASM SET_TAC [])

  let IS_REALINTERVAL_INTERIOR_SEGMENT ← prove
   r"!s a b.
        is_realinterval s /\
        a IN euclideanreal closure_of s /\ b IN euclideanreal closure_of s
        ==> real_interval(a,b) SUBSET euclideanreal interior_of s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"real_interval(a,b) = {}") THEN
    ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_INTERVAL_NE_EMPTY]) THEN
    DISCH_TAC THEN DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN X_GEN_TAC (← q r"x:real") THEN
    STRIP_TAC THEN FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_CLOSURE_OF] THEN
    REWRITE_TAC [METRIC_INTERIOR_OF, mball, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(b - x) / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b':real") THEN STRIP_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(x - a) / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, REAL_SUB_LT, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a':real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"min (x - a') (b' - x)") THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, REWRITE_TAC [SUBSET, IN_ELIM_THM]] THEN
    X_GEN_TAC (← q r"y:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [is_realinterval]) THEN
    MAP_EVERY EXISTS_TAC [← q r"a':real", ← q r"b':real"] THEN
    ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)

  let REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL ← prove
   r"!u s. real_open u /\ is_realinterval s
         ==> (u SUBSET euclideanreal closure_of s <=>
              u SUBSET euclideanreal interior_of s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [SUBSET_TRANS, INTERIOR_OF_SUBSET_CLOSURE_OF]] THEN
    REWRITE_TAC [SUBSET] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:real") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [REAL_OPEN_IN]) THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, OPEN_IN_MTOPOLOGY] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [MBALL_REAL_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"e:real") THEN REWRITE_TAC [SUBSET] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real->bool", ← q r"x - e / &2", ← q r"x + e / &2"]
        IS_REALINTERVAL_INTERIOR_SEGMENT) THEN
    ASM_REWRITE_TAC [SUBSET] THEN ANTS_TAC THENL
     [CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC,
      REWRITE_TAC [MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
      DISCH_THEN MATCH_MP_TAC] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC)

  let REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT ← prove
   r"!u s. real_open u /\ is_realinterval s
         ==> (u SUBSET euclideanreal closure_of s <=> u SUBSET s)"
   (SIMP_TAC [REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL, REAL_OPEN_IN,
              INTERIOR_OF_MAXIMAL_EQ])

  let INTERIOR_OF_CLOSURE_OF_REALINTERVAL ← prove
   r"!s. is_realinterval s
       ==> euclideanreal interior_of (euclideanreal closure_of s) =
           euclideanreal interior_of s"
   (GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [interior_of] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, ← GSYM REAL_OPEN_IN] THEN
    ASM_MESON_TAC [REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT])

  let CLOSURE_OF_REAL_INTERVAL ← prove
   r"!a b. euclideanreal closure_of real_interval(a,b) =
         if real_interval(a,b) = {} then {} else real_interval[a,b]"
   (REPEAT GEN_TAC THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSURE_OF_EMPTY] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [CLOSURE_OF_MINIMAL_EQ, ← GSYM REAL_CLOSED_IN, TOPSPACE_EUCLIDEANREAL,
              REAL_INTERVAL_OPEN_SUBSET_CLOSED, REAL_CLOSED_REAL_INTERVAL,
              SUBSET_UNIV] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_INTERVAL_NE_EMPTY]) THEN
    ASM_SIMP_TAC [REAL_CLOSED_OPEN_INTERVAL, REAL_LT_IMP_LE] THEN
    SIMP_TAC [UNION_SUBSET, CLOSURE_OF_SUBSET, TOPSPACE_EUCLIDEANREAL,
              SUBSET_UNIV, INSERT_SUBSET, EMPTY_SUBSET] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [METRIC_CLOSURE_OF, mball, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_UNIV, MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"r:real") THEN DISCH_TAC THENL
     [EXISTS_TAC (← q r"min ((a + b) / &2) (a + r / &2)"),
      EXISTS_TAC (← q r"max ((a + b) / &2) (b - r / &2)")] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC)

  let INTERIOR_OF_REAL_INTERVAL ← prove
   r"!a b. euclideanreal interior_of real_interval[a,b] = real_interval(a,b)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ, ← GSYM REAL_OPEN_IN,
              REAL_OPEN_REAL_INTERVAL, REAL_INTERVAL_OPEN_SUBSET_CLOSED] THEN
    REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, METRIC_INTERIOR_OF,
      MBALL_REAL_INTERVAL, REAL_EUCLIDEAN_METRIC, IN_UNIV, IN_ELIM_THM] THEN
    REWRITE_TAC [SUBSET_REAL_INTERVAL] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  let CLOSURE_OF_INTERIOR_OF_REALINTERVAL ← prove
   r"!s. is_realinterval s /\ ~(euclideanreal interior_of s = {})
       ==> euclideanreal closure_of (euclideanreal interior_of s) =
           euclideanreal closure_of s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:real")) THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [CLOSURE_OF_MONO, INTERIOR_OF_SUBSET] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
    REPEAT_TCL DISJ_CASES_THEN
    ASSUME_TAC (← REAL_ARITH (← q r"b = a \/ a:real < b \/ b < a")) THENL
     [MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"euclideanreal interior_of s"]
          CLOSURE_OF_SUBSET) THEN
      ASM_REWRITE_TAC [TOPSPACE_EUCLIDEANREAL] THEN ASM SET_TAC [],
      MP_TAC (← ISPECL [← q r"s:real->bool", ← q r"a:real", ← q r"b:real"]
          IS_REALINTERVAL_INTERIOR_SEGMENT),
      MP_TAC (← ISPECL [← q r"s:real->bool", ← q r"b:real", ← q r"a:real"]
          IS_REALINTERVAL_INTERIOR_SEGMENT)] THEN
    (ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
      [ASM_MESON_TAC [INTERIOR_OF_SUBSET_CLOSURE_OF, SUBSET],
       DISCH_THEN (MP_TAC o MATCH_MP CLOSURE_OF_MONO) THEN
       REWRITE_TAC [SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN
       ASM_SIMP_TAC [CLOSURE_OF_REAL_INTERVAL, REAL_INTERVAL_EQ_EMPTY] THEN
       ASM_REWRITE_TAC [← GSYM REAL_NOT_LT, IN_REAL_INTERVAL] THEN
       ASM_REAL_ARITH_TAC]))

  let CARD_FRONTIER_OF_REALINTERVAL ← prove
   r"!s. is_realinterval s
       ==> FINITE(euclideanreal frontier_of s) /\
           CARD(euclideanreal frontier_of s) <= 2"
   (GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
    REWRITE_TAC [← ARITH_RULE (← q r"~(n <= 2) <=> 3 <= n")] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CHOOSE_SUBSET_STRONG) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:real->bool") (CONJUNCTS_THEN MP_TAC)) THEN
    CONV_TAC (LAND_CONV HAS_SIZE_CONV) THEN
    SIMP_TAC [LEFT_IMP_EXISTS_THM, INSERT_SUBSET, EMPTY_SUBSET] THEN
    MATCH_MP_TAC REAL_WLOG_LE_3 THEN CONJ_TAC THENL
    [MESON_TAC [INSERT_AC], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN
    REWRITE_TAC [frontier_of, IN_DIFF] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"s:real->bool", ← q r"a:real", ← q r"c:real"]
      IS_REALINTERVAL_INTERIOR_SEGMENT) THEN
    ASM_REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"b:real")) THEN ASM_REWRITE_TAC [] THEN
    ASM_REAL_ARITH_TAC)

  let LOCALLY_COMPACT_SPACE_EUCLIDEANREAL ← prove
   r"locally_compact_space euclideanreal"
   (REWRITE_TAC [locally_compact_space, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
    X_GEN_TAC (← q r"x:real") THEN MAP_EVERY EXISTS_TAC
     [← q r"real_interval(x - &1,x + &1)", ← q r"real_interval[x - &1,x + &1]"] THEN
    REWRITE_TAC [REAL_INTERVAL_OPEN_SUBSET_CLOSED] THEN
    REWRITE_TAC [← GSYM real_compact_def, ← GSYM REAL_OPEN_IN] THEN
    REWRITE_TAC [REAL_COMPACT_INTERVAL, REAL_OPEN_REAL_INTERVAL] THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC)

  return { real_compact_def, REAL_COMPACT_EQ_BOUNDED_CLOSED, REAL_COMPACT_IMP_BOUNDED,
           REAL_COMPACT_IMP_CLOSED, NOT_REAL_COMPACT_UNIV, NOT_COMPACT_SPACE_EUCLIDEANREAL,
           REAL_COMPACT_INTERVAL, REAL_COMPACT_UNION, REAL_CLOSED_CONTAINS_SUP,
           REAL_COMPACT_CONTAINS_SUP, REAL_COMPACT_ATTAINS_SUP, REAL_CLOSED_CONTAINS_INF,
           REAL_COMPACT_CONTAINS_INF, REAL_COMPACT_ATTAINS_INF, REAL_COMPACT_IS_REALINTERVAL,
           IS_REALINTERVAL_CLOSURE_OF, IS_REALINTERVAL_INTERIOR_OF,
           IS_REALINTERVAL_INTERIOR_SEGMENT, REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL,
           REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT, INTERIOR_OF_CLOSURE_OF_REALINTERVAL,
           CLOSURE_OF_REAL_INTERVAL, INTERIOR_OF_REAL_INTERVAL,
           CLOSURE_OF_INTERIOR_OF_REALINTERVAL, CARD_FRONTIER_OF_REALINTERVAL,
           LOCALLY_COMPACT_SPACE_EUCLIDEANREAL }

/- ------------------------------------------------------------------------- -/
/- Limits at a point in a topological space.  (metric.ml 18981-19090)        -/
/- ------------------------------------------------------------------------- -/

structure AtPoint where
  atpointof : thm
  ATPOINTOF : thm
  NETLIMITS_ATPOINTOF : thm
  NETLIMIT_ATPOINTOF : thm
  EVENTUALLY_ATPOINTOF : thm
  ATPOINTOF_WITHIN_TRIVIAL : thm
  ATPOINTOF_WITHIN_TOPSPACE : thm
  TRIVIAL_LIMIT_ATPOINTOF_WITHIN : thm
  DERIVED_SET_OF_TRIVIAL_LIMIT : thm
  TRIVIAL_LIMIT_ATPOINTOF : thm
  ATPOINTOF_SUBTOPOLOGY : thm
  EVENTUALLY_ATPOINTOF_METRIC : thm
  deriving Inhabited

@[nospecialize]
def setupAtPoint [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BDerived : Derived) (BNets : Nets)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) : ExceptT String IO AtPoint := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, .. } := D.core4
  let { PAIR, PAIR_EQ, SELECT_REFL, .. } := D.core5
  let { RELATIVE_TO, .. } := D.misc
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, .. } := BSubtopology
  let { derived_set_of, .. } := BDerived
  let { EVENTUALLY_WITHIN_IMP, NETLIMITS_WITHIN, WITHIN, eventually, net_tybij, netfilter,
        netlimit, netlimits, trivial_limit, .. } := BNets
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_POS_EQ, MDIST_SYM, .. } := BMetricSpace
  let { OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let atpointof ← new_definition
   r"atpointof top a = mk_net({u | open_in top u /\ a IN u},{a})"

  let (ATPOINTOF, NETLIMITS_ATPOINTOF) ← CONJ_PAIR (← prove
   r"(!top a:A.
        netfilter(atpointof top a) = {u | open_in top u /\ a IN u}) /\
   (!top a:A. netlimits(atpointof top a) = {a})"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [netfilter, netlimits, atpointof, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 net_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REPEAT DISCH_TAC THEN
    X_GEN_TAC (← q r"v:A->bool") THEN REPEAT DISCH_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER]))

  let NETLIMIT_ATPOINTOF ← prove
   r"!top a:A. netlimit(atpointof top a) = a"
   (REWRITE_TAC [netlimit, NETLIMITS_ATPOINTOF, IN_SING, SELECT_REFL])

  let EVENTUALLY_ATPOINTOF ← prove
   r"!P top a:A.
        eventually P (atpointof top a) <=>
        ~(a IN topspace top) \/
        ?u. open_in top u /\ a IN u /\ !x. x IN u DELETE a ==> P x"
   (REWRITE_TAC [eventually, ATPOINTOF, NETLIMITS_ATPOINTOF, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [← sr r"{f x | P x} = {} <=> ~(?x. P x)"] THEN
    REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top") THENL
     [ALL_TAC, ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET]] THEN
    ASM_SIMP_TAC [IN_DELETE, IN_DIFF, IN_SING] THEN
    ASM_MESON_TAC [OPEN_IN_TOPSPACE])

  let ATPOINTOF_WITHIN_TRIVIAL ← prove
   r"!top u a:A.
     topspace top SUBSET u ==> (atpointof top a) within u = atpointof top a"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [net_tybij] (← q
     r"dest_net x = dest_net y ==> x = y")) THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM PAIR] THEN
    PURE_REWRITE_TAC [← GSYM netfilter, ← GSYM netlimits] THEN
    REWRITE_TAC [ATPOINTOF, WITHIN, NETLIMITS_ATPOINTOF, NETLIMITS_WITHIN] THEN
    REWRITE_TAC [PAIR_EQ, RELATIVE_TO] THEN
    REWRITE_TAC [← sr r"{f x | {g y | P y} x} = {f(g y) | P y}"] THEN
    MATCH_MP_TAC (← sr
     r"(!x. P x ==> f x = g x) ==> {f x | P x} = {g x | P x}") THEN
    REPEAT STRIP_TAC THEN FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    ASM SET_TAC [])

  let ATPOINTOF_WITHIN_TOPSPACE ← prove
   r"!top a:A. (atpointof top a) within (topspace top) = atpointof top a"
   (SIMP_TAC [ATPOINTOF_WITHIN_TRIVIAL, SUBSET_REFL])

  let TRIVIAL_LIMIT_ATPOINTOF_WITHIN ← prove
   r"!top s a:A.
        trivial_limit(atpointof top a within s) <=>
        ~(a IN top derived_set_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [trivial_limit, EVENTUALLY_WITHIN_IMP] THEN
    ASM_SIMP_TAC [EVENTUALLY_ATPOINTOF] THEN
    REWRITE_TAC [derived_set_of, IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    SET_TAC [])

  let DERIVED_SET_OF_TRIVIAL_LIMIT ← prove
   r"!top s a:A.
      a IN top derived_set_of s <=> ~trivial_limit(atpointof top a within s)"
   (REWRITE_TAC [TRIVIAL_LIMIT_ATPOINTOF_WITHIN])

  let TRIVIAL_LIMIT_ATPOINTOF ← prove
   r"!top a:A.
        trivial_limit(atpointof top a) <=>
        ~(a IN top derived_set_of topspace top)"
   (ONCE_REWRITE_TAC [← GSYM ATPOINTOF_WITHIN_TOPSPACE] THEN
    REWRITE_TAC [TRIVIAL_LIMIT_ATPOINTOF_WITHIN])

  let ATPOINTOF_SUBTOPOLOGY ← prove
   r"!top s a:A.
        a IN s
        ==> (atpointof (subtopology top s) a =
             atpointof top a within s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [net_tybij] (← q
     r"dest_net x = dest_net y ==> x = y")) THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM PAIR] THEN
    PURE_REWRITE_TAC [← GSYM netfilter, ← GSYM netlimits] THEN
    REWRITE_TAC [WITHIN, NETLIMITS_WITHIN] THEN
    REWRITE_TAC [ATPOINTOF, NETLIMITS_ATPOINTOF] THEN
    REWRITE_TAC [PAIR_EQ, RELATIVE_TO, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN ASM SET_TAC [])

  let EVENTUALLY_ATPOINTOF_METRIC ← prove
   r"!P m a:A.
        eventually P (atpointof (mtopology m) a) <=>
        a IN mspace m
        ==> ?d. &0 < d /\
                !x. x IN mspace m /\ &0 < mdist m (x,a) /\ mdist m (x,a) < d
                    ==> P x"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [EVENTUALLY_ATPOINTOF, TOPSPACE_MTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"(a:A) IN mspace m") THEN ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_MTOPOLOGY]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"a:A"))) THEN
      ASM_SIMP_TAC [IMP_CONJ, MDIST_POS_EQ, IN_MBALL, SUBSET, MDIST_SYM] THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [IMP_CONJ, MDIST_POS_EQ] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"mball m (a:A,d)") THEN
      ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL, IN_DELETE] THEN
      REWRITE_TAC [IN_MBALL] THEN ASM_MESON_TAC [MDIST_SYM]])

  return { atpointof, ATPOINTOF, NETLIMITS_ATPOINTOF, NETLIMIT_ATPOINTOF, EVENTUALLY_ATPOINTOF,
           ATPOINTOF_WITHIN_TRIVIAL, ATPOINTOF_WITHIN_TOPSPACE, TRIVIAL_LIMIT_ATPOINTOF_WITHIN,
           DERIVED_SET_OF_TRIVIAL_LIMIT, TRIVIAL_LIMIT_ATPOINTOF, ATPOINTOF_SUBTOPOLOGY,
           EVENTUALLY_ATPOINTOF_METRIC }

/- ------------------------------------------------------------------------- -/
/- Limits in a topological space.  (metric.ml 19092-19256)                   -/
/- ------------------------------------------------------------------------- -/

structure Limits1 where
  limit : thm
  LIMIT_IMP_WITHIN : thm
  LIMIT_IN_TOPSPACE : thm
  LIMIT_CONST : thm
  LIMIT_REAL_CONST : thm
  LIMIT_CONST_EQ : thm
  LIMIT_EVENTUALLY : thm
  LIMIT_WITHIN_SUBSET : thm
  LIMIT_SUBSEQUENCE : thm
  LIMIT_SUBTOPOLOGY : thm
  LIMIT_SEQUENTIALLY : thm
  LIMIT_SEQUENTIALLY_OFFSET : thm
  LIMIT_SEQUENTIALLY_OFFSET_REV : thm
  LIMIT_ATPOINTOF : thm
  LIMIT_ATPOINTOF_SELF : thm
  LIMIT_TRIVIAL : thm
  LIMIT_TRANSFORM_EVENTUALLY : thm
  CONTINUOUS_MAP_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupLimits1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BT1a : T1a) (BNets : Nets)
    (BSequential : Sequential) (BRealTop1 : RealTop1) (BAtPoint : AtPoint) :
    ExceptT String IO Limits1 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, INTRO_TAC, HYP_TAC,
        new_definition, .. } := D
  let { FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_ELIM_THM, IN_INTER, IN_UNIV, MONO_FORALL,
        .. } := D.core2
  let { o_DEF, o_THM, .. } := D.core4
  let { MONO_IMP, .. } := D.core5
  let { OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { continuous_map, .. } := BContMap1
  let { t1_space, .. } := BT1a
  let { EVENTUALLY_AND, EVENTUALLY_FALSE, EVENTUALLY_HAPPENS, EVENTUALLY_IMP_WITHIN,
        EVENTUALLY_MONO, EVENTUALLY_TRIVIAL, EVENTUALLY_TRUE, EVENTUALLY_WITHIN_SUBSET,
        eventually, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, EVENTUALLY_SUBSEQUENCE, .. } := BSequential
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { EVENTUALLY_ATPOINTOF, .. } := BAtPoint
  -- @@SCOPE END

  let limit ← new_definition
    r"limit top (f:A->B) l net <=>
   l IN topspace top /\
   (!u. open_in top u /\ l IN u ==> eventually (\x. f x IN u) net)"

  let LIMIT_IMP_WITHIN ← prove
   r"!net top (f:A->B) l s.
        limit top f l net ==> limit top f l (net within s)"
   (REWRITE_TAC [limit] THEN MESON_TAC [EVENTUALLY_IMP_WITHIN])

  let LIMIT_IN_TOPSPACE ← prove
   r"!net top f:A->B l. limit top f l net ==> l IN topspace top"
   (SIMP_TAC [limit])

  let LIMIT_CONST ← prove
   r"!net:A net l:B. limit top (\a. l) l net <=> l IN topspace top"
   (SIMP_TAC [limit, EVENTUALLY_TRUE])

  let LIMIT_REAL_CONST ← prove
   r"!net:A net l. limit euclideanreal (\a. l) l net"
   (REWRITE_TAC [LIMIT_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV])

  let LIMIT_CONST_EQ ← prove
   r"!(net:K net) top (a:A) l.
        t1_space top /\ ~trivial_limit net
        ==> (limit top (\k. a) l net <=> l IN topspace top /\ a = l)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [LIMIT_CONST] THEN
    REWRITE_TAC [limit] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"topspace top:A->bool")) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [OPEN_IN_TOPSPACE], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~p ==> F")] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"l:A", ← q r"a:A"] o
      GEN_REWRITE_RULE id [t1_space]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [EVENTUALLY_FALSE])

  let LIMIT_EVENTUALLY ← prove
   r"!top net f:K->A l.
        l IN topspace top /\ eventually (\x. f x = l) net
        ==> limit top f l net"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [limit] THEN
    GEN_TAC THEN STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] EVENTUALLY_MONO)) THEN
    ASM_SIMP_TAC [])

  let LIMIT_WITHIN_SUBSET ← prove
   r"!net top f:A->B l s t.
        limit top f l (net within s) /\ t SUBSET s
        ==> limit top f l (net within t)"
   (REWRITE_TAC [limit] THEN ASM_MESON_TAC [EVENTUALLY_WITHIN_SUBSET])

  let LIMIT_SUBSEQUENCE ← prove
   r"!top f:num->A l r.
        (!m n. m < n ==> r m < r n) /\ limit top f l sequentially
        ==> limit top (f o r) l sequentially"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [limit] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"!m n. m < n ==> (r:num->num) m < r n") THEN
    REWRITE_TAC [IMP_IMP] THEN
    DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_SUBSEQUENCE) THEN
    REWRITE_TAC [o_DEF])

  let LIMIT_SUBTOPOLOGY ← prove
   r"!net top s l f:A->B.
        limit (subtopology top s) f l net <=>
        l IN s /\ eventually (\a. f a IN s) net /\ limit top f l net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [limit, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, IMP_CONJ, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IN_INTER, IMP_IMP] THEN
    ASM_CASES_TAC (← q r"(l:B) IN s") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(l:B) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"(?x. P x) /\ (!x. P x ==> (Q x <=> A /\ R x))
      ==> ((!x. P x ==> Q x) <=> A /\ (!x. P x ==> R x))")) THEN
    REWRITE_TAC [EVENTUALLY_AND] THEN ASM_MESON_TAC [OPEN_IN_TOPSPACE])

  let LIMIT_SEQUENTIALLY ← prove
   r"!top s l:A.
     limit top s l sequentially <=>
     l IN topspace top /\
     (!u. open_in top u /\ l IN u ==> (?N. !n. N <= n ==> s n IN u))"
   (REWRITE_TAC [limit, EVENTUALLY_SEQUENTIALLY])

  let LIMIT_SEQUENTIALLY_OFFSET ← prove
   r"!top f l:A k. limit top f l sequentially
                 ==> limit top (\i. f (i + k)) l sequentially"
   (SIMP_TAC [LIMIT_SEQUENTIALLY] THEN INTRO_TAC "! *; l lim; !u; hp" THEN
    USE_THEN "hp" (HYP_TAC "lim: @N. N" o C MATCH_MP) THEN
    EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
    USE_THEN "N" MATCH_MP_TAC THEN ASM_ARITH_TAC)

  let LIMIT_SEQUENTIALLY_OFFSET_REV ← prove
   r"!top f l:A k. limit top (\i. f (i + k)) l sequentially
                 ==> limit top f l sequentially"
   (SIMP_TAC [LIMIT_SEQUENTIALLY] THEN INTRO_TAC "! *; l lim; !u; hp" THEN
    USE_THEN "hp" (HYP_TAC "lim: @N. N" o C MATCH_MP) THEN
    EXISTS_TAC (← q r"N+k:num") THEN INTRO_TAC "!n; n" THEN
    REMOVE_THEN "N" (MP_TAC o SPEC (← q r"n-k:num")) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
    SUBGOAL_THEN (← q r"n - k + k = n:num") (fun th => REWRITE_TAC [th]) THEN
    ASM_ARITH_TAC)

  let LIMIT_ATPOINTOF ← prove
   r"!top top' f:A->B x y.
        limit top' f y (atpointof top x) <=>
        y IN topspace top' /\
        (x IN topspace top
         ==> !v. open_in top' v /\ y IN v
                 ==> ?u. open_in top u /\ x IN u /\
                         IMAGE f (u DELETE x) SUBSET v)"
   (REPEAT GEN_TAC THEN ASM_SIMP_TAC [limit, EVENTUALLY_ATPOINTOF] THEN
    ASM_CASES_TAC (← q r"(y:B) IN topspace top'") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let LIMIT_ATPOINTOF_SELF ← prove
   r"!top1 top2 f:A->B a.
        limit top2 f (f a) (atpointof top1 a) <=>
        f a IN topspace top2 /\
        (a IN topspace top1
         ==> (!v. open_in top2 v /\ f a IN v
                  ==> (?u. open_in top1 u /\ a IN u /\ IMAGE f u SUBSET v)))"
   (REWRITE_TAC [LIMIT_ATPOINTOF] THEN SET_TAC [])

  let LIMIT_TRIVIAL ← prove
   r"!net f:A->B top y.
        trivial_limit net /\ y IN topspace top ==> limit top f y net"
   (SIMP_TAC [limit, EVENTUALLY_TRIVIAL])

  let LIMIT_TRANSFORM_EVENTUALLY ← prove
   r"!net top f:A->B g l.
        eventually (\x. f x = g x) net /\ limit top f l net
        ==> limit top g l net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [limit] THEN
    ASM_CASES_TAC (← q r"(l:B) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"(?x. Q x) /\ (!x. P /\ R x ==> R' x)
      ==> P /\ (!x. Q x ==> R x) ==> (!x. Q x ==> R' x)")) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [OPEN_IN_TOPSPACE], ALL_TAC] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    MESON_TAC [])

  let CONTINUOUS_MAP_LIMIT ← prove
   r"!net top top' f:A->B g:B->C l.
     continuous_map (top,top')  g /\ limit top f l net
     ==> limit top' (g o f) (g l) net"
   (REWRITE_TAC [limit, o_THM] THEN INTRO_TAC "! *; cont l lim" THEN
    USE_THEN "cont" MP_TAC THEN REWRITE_TAC [continuous_map] THEN
    INTRO_TAC "g cont" THEN ASM_SIMP_TAC [] THEN INTRO_TAC "!u; u gl" THEN
    ASM_CASES_TAC (← q r"trivial_limit (net:A net)") THENL
    [ASM_REWRITE_TAC [eventually], POP_ASSUM (LABEL_TAC "nontriv")] THEN
    REMOVE_THEN "lim"
      (MP_TAC o SPEC (← q r"{x:B | x IN topspace top /\ g x:C IN u}")) THEN
    ASM_SIMP_TAC [IN_ELIM_THM, eventually] THEN MESON_TAC [])

  return { limit, LIMIT_IMP_WITHIN, LIMIT_IN_TOPSPACE, LIMIT_CONST, LIMIT_REAL_CONST,
           LIMIT_CONST_EQ, LIMIT_EVENTUALLY, LIMIT_WITHIN_SUBSET, LIMIT_SUBSEQUENCE,
           LIMIT_SUBTOPOLOGY, LIMIT_SEQUENTIALLY, LIMIT_SEQUENTIALLY_OFFSET,
           LIMIT_SEQUENTIALLY_OFFSET_REV, LIMIT_ATPOINTOF, LIMIT_ATPOINTOF_SELF, LIMIT_TRIVIAL,
           LIMIT_TRANSFORM_EVENTUALLY, CONTINUOUS_MAP_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Limits: products, uniqueness.  (metric.ml 19258-19446)                    -/
/- ------------------------------------------------------------------------- -/

structure Limits2 where
  LIMIT_PAIRWISE : thm
  LIMIT_COMPONENTWISE : thm
  COMPACT_IN_SEQUENCE_WITH_LIMIT : thm
  LIMIT_HAUSDORFF_UNIQUE : thm
  LIMIT_KC_UNIQUE : thm
  deriving Inhabited

@[nospecialize]
def setupLimits2 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BProd1 : Prod1) (BProduct1 : Product1) (BCompact1 : Compact1) (BHausdorff1 : Hausdorff1)
    (BKC1 : KC1) (BNets : Nets) (BSequential : Sequential) (BLimits1 : Limits1) :
    ExceptT String IO Limits2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, INTRO_TAC, HYP_TAC, REFUTE_THEN,
        .. } := D
  let { ARBITRARY, ARBITRARY_UNION_OF_INC, ETA_AX, EXISTS_IN_INSERT, FINITE_IMAGE,
        FINITE_INSERT, FINITE_INTER, FINITE_INTERSECTION_OF_INC, FINITE_NUMSEG,
        FORALL_INTERSECTION_OF, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_UNION_OF,
        .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INSERT_SUBSET, IN_CROSS, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_IMAGE,
        IN_INSERT, IN_INTER, IN_INTERS, IN_NUMSEG, IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM,
        LE_0, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_TRANS, UNIONS_IMAGE, UNIONS_INSERT,
        o_THM, .. } := D.core4
  let { FORALL_AND_THM, FORALL_PAIR_THM, NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { ARBITRARY_UNION_OF_RELATIVE_TO, FORALL_RELATIVE_TO, relative_to, .. } := D.misc
  let { CLAIM_TAC, CUT_TAC, .. } := BTactics
  let { OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_CROSS, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { OPEN_IN_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY_ALT, .. } := BProduct1
  let { compact_in, .. } := BCompact1
  let { hausdorff_space, .. } := BHausdorff1
  let { KC_IMP_T1_SPACE, kc_space, .. } := BKC1
  let { EVENTUALLY_AND, EVENTUALLY_FORALL, EVENTUALLY_HAPPENS, EVENTUALLY_MONO,
        EVENTUALLY_TRUE, .. } := BNets
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { LIMIT_CONST_EQ, LIMIT_SEQUENTIALLY, LIMIT_TRANSFORM_EVENTUALLY, limit, .. } := BLimits1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let LIMIT_PAIRWISE ← prove
   r"!(net:C net) top1:A topology top2:B topology f l.
        limit (prod_topology top1 top2) f l net <=>
        limit top1 (FST o f) (FST l) net /\
        limit top2 (SND o f) (SND l) net"
   (REPLICATE_TAC 4 GEN_TAC THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"l1:A", ← q r"l2:B"] THEN
    REWRITE_TAC [limit, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    ASM_CASES_TAC (← q r"(l1:A) IN topspace top1") THEN
    ASM_CASES_TAC (← q r"(l2:B) IN topspace top2") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"(u:A->bool) CROSS (topspace top2:B->bool)")),
        X_GEN_TAC (← q r"v:B->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"(topspace top1:A->bool) CROSS (v:B->bool)"))] THEN
      ASM_REWRITE_TAC [IN_CROSS, OPEN_IN_CROSS, OPEN_IN_TOPSPACE],
      X_GEN_TAC (← q r"w:A#B->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"l1:A", ← q r"l2:B"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"u:A->bool")) (MP_TAC o SPEC (← q r"v:B->bool"))) THEN
      ASM_REWRITE_TAC [← GSYM EVENTUALLY_AND, IMP_IMP]] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    X_GEN_TAC (← q r"a:C") THEN REWRITE_TAC [o_THM] THEN
    SPEC_TAC (← q r"(f:C->A#B) a", ← q r"y:A#B") THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
    ASM_SIMP_TAC [FORALL_PAIR_THM, IN_CROSS])

  let LIMIT_COMPONENTWISE ← prove
   r"!(net:C net) (tops:K->A topology) t f l.
        limit (product_topology t tops) f l net <=>
        EXTENSIONAL t l /\
        eventually (\a. f a IN topspace(product_topology t tops)) net /\
        !k. k IN t ==> limit (tops k) (\c. f c k) (l k) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [limit, TOPSPACE_PRODUCT_TOPOLOGY_ALT, IN_ELIM_THM] THEN
    ASM_CASES_TAC (← q r"EXTENSIONAL t (l:K->A)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, FORALL_AND_THM] THEN
    ASM_CASES_TAC (← q r"!k. k IN t ==> (l:K->A) k IN topspace (tops k)") THEN
    ASM_REWRITE_TAC [IMP_IMP] THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"topspace(product_topology t tops):(K->A)->bool")) THEN
        REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        ASM_REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, IN_ELIM_THM],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:K", ← q r"u:A->bool"] THEN
      REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{y:K->A | y k IN u} INTER topspace(product_topology t tops)")) THEN
      ANTS_TAC THENL
       [ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM, TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
        REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN
        REWRITE_TAC [← GSYM ARBITRARY_UNION_OF_RELATIVE_TO] THEN
        REWRITE_TAC [relative_to, TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
        EXISTS_TAC (← q r"{y:K->A | y k IN u}") THEN
        CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
        MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY EXISTS_TAC [← q r"k:K", ← q r"u:A->bool"] THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        SIMP_TAC [IN_INTER, IN_ELIM_THM]],
      STRIP_TAC THEN
      REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, FORALL_UNION_OF,
                   ARBITRARY, IMP_CONJ] THEN
      X_GEN_TAC (← q r"v:((K->A)->bool)->bool") THEN REWRITE_TAC [IN_UNIONS] THEN
      MATCH_MP_TAC (← MESON [] (← q
       r"(!x. P x ==> x IN v /\ Q x ==> R)
        ==> (!x. x IN v ==> P x) ==> (?x. x IN v /\ Q x) ==> R")) THEN
      REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
      X_GEN_TAC (← q r"w:((K->A)->bool)->bool") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
      MATCH_MP_TAC EVENTUALLY_MONO THEN EXISTS_TAC
       (← q r"\x. (f:C->K->A) x IN
            topspace(product_topology t tops) INTER INTERS w") THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL
       [REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [] (← q
         r"a IN v ==> P a ==> ?x. x IN v /\ P x"))) THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC [EVENTUALLY_AND, IN_INTER]] THEN
      ASM_REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_INTERS] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) EVENTUALLY_FORALL o snd) THEN
      ASM_CASES_TAC (← q r"w:((K->A)->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [NOT_IN_EMPTY, EVENTUALLY_TRUE] THEN
      DISCH_THEN SUBST1_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← sr r"(!x. P x ==> Q x)
                  ==> (!x. x IN Q ==> P x ==> R x) ==> (!x. P x ==> R x)")) THEN
      REWRITE_TAC [FORALL_IN_GSPEC, ETA_AX] THEN REPEAT STRIP_TAC THEN
      REWRITE_TAC [IN_ELIM_THM] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o CONJUNCT2 o REWRITE_RULE [IN_INTER]) THEN
      DISCH_THEN (MP_TAC o GEN_REWRITE_RULE id [IN_INTERS]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
       r"a IN s ==> (P a ==> Q) ==> (!x. x IN s ==> P x) ==> Q")) THEN
      REWRITE_TAC [IN_ELIM_THM]])

  let COMPACT_IN_SEQUENCE_WITH_LIMIT ← prove
   r"!top s a l:A.
        limit top a l sequentially /\
        s SUBSET IMAGE a (:num) /\ s SUBSET topspace top
        ==> compact_in top (l INSERT s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIMIT_SEQUENTIALLY] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [compact_in, INSERT_SUBSET] THEN
    X_GEN_TAC (← q r"u:(A->bool)->bool") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN REWRITE_TAC [IN_UNIONS] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_UNIONS]) THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"v:A->A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:A->bool") o
      GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_EXISTS_THM]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN EXISTS_TAC
     (← q r"(t:A->bool) INSERT IMAGE v (s INTER IMAGE (a:num->A) (0..N))") THEN
    ASM_REWRITE_TAC [INSERT_SUBSET, EXISTS_IN_INSERT, UNIONS_INSERT] THEN
    SIMP_TAC [FINITE_IMAGE, FINITE_INTER, FINITE_INSERT, FINITE_NUMSEG] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"IMAGE a (:num) INTER (s:A->bool)") THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [SUBSET]] THEN
    REWRITE_TAC [IN_INTER, FORALL_IN_IMAGE, IMP_CONJ, IN_UNIV] THEN
    X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"N:num <= n") THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE (← q r"~(N <= n) ==> n:num <= N"))) THEN
    REWRITE_TAC [UNIONS_IMAGE, IN_INTER, IN_IMAGE, IN_NUMSEG, LE_0] THEN
    ASM SET_TAC [])

  let LIMIT_HAUSDORFF_UNIQUE ← prove
   r"!net top f:A->B l1 l2.
     ~trivial_limit net /\
     hausdorff_space top /\
     limit top f l1 net /\
     limit top f l2 net
     ==> l1 = l2"
   (REWRITE_TAC [limit, hausdorff_space] THEN
    INTRO_TAC "! *; nontriv hp (l1 hp1) (l2 hp2)" THEN
    REFUTE_THEN (LABEL_TAC "contra") THEN
    REMOVE_THEN "hp" (MP_TAC o SPECL [← q r"l1:B", ← q r"l2:B"]) THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN REPEAT GEN_TAC THEN
    CUT_TAC (← q r"open_in top u /\ open_in top v /\ l1:B IN u /\ l2:B IN v
             ==> ?x:A. f x IN u /\ f x IN v") THENL
    [SET_TAC [], STRIP_TAC] THEN
    CLAIM_TAC "rmk" (← q r"eventually (\x:A. f x:B IN u /\ f x IN v) net") THENL
    [ASM_SIMP_TAC [EVENTUALLY_AND],
     HYP_TAC "rmk" (MATCH_MP EVENTUALLY_HAPPENS) THEN ASM_MESON_TAC []])

  let LIMIT_KC_UNIQUE ← prove
   r"!top (f:num->A) l1 l2.
      kc_space top /\
      limit top f l1 sequentially /\
      limit top f l2 sequentially
      ==> l1 = l2"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~p ==> F")] THEN DISCH_TAC THEN
    UNDISCH_TAC (← q r"limit top f (l2:A) sequentially") THEN
    REWRITE_TAC [limit] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"topspace top DIFF (l1 INSERT (IMAGE f (:num) DELETE (l2:A)))")) THEN
    ASM_REWRITE_TAC [NOT_IMP, IN_DELETE, IN_DIFF, IN_INSERT] THEN CONJ_TAC THENL
     [ONCE_REWRITE_TAC [← sr
       r"u DIFF (a INSERT s) = u DIFF (a INSERT (u INTER s))"] THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [kc_space]) THEN
      MATCH_MP_TAC COMPACT_IN_SEQUENCE_WITH_LIMIT THEN
      EXISTS_TAC (← q r"f:num->A") THEN ASM_REWRITE_TAC [] THEN SET_TAC [],
      FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"topspace top:A->bool")) o
        GEN_REWRITE_RULE id [limit]) THEN
      ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, ← TAUT (← q r"p ==> ~q <=> ~(p /\ q)")] THEN
      REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN REWRITE_TAC [← sr
       r"f x IN u /\ f x IN u /\
        ~(f x = l1 \/ f x IN IMAGE f UNIV /\ ~(f x = l2)) <=>
        f x IN u /\ ~(f x = l1) /\ f x = l2"] THEN
      REWRITE_TAC [EVENTUALLY_AND] THEN
      DISCH_THEN (fun th => tactic_of do
        let c ← liftExcept (last (CONJUNCTS th))
        let r ← MATCH_MP (← REWRITE_RULE [IMP_CONJ] LIMIT_TRANSFORM_EVENTUALLY) c
        pure (MP_TAC (← ISPECL [← q r"top:A topology", ← q r"l1:A"] r))) THEN
      ASM_SIMP_TAC [LIMIT_CONST_EQ, TRIVIAL_LIMIT_SEQUENTIALLY,
                    KC_IMP_T1_SPACE]])

  return { LIMIT_PAIRWISE, LIMIT_COMPONENTWISE, COMPACT_IN_SEQUENCE_WITH_LIMIT,
           LIMIT_HAUSDORFF_UNIQUE, LIMIT_KC_UNIQUE }

/- ------------------------------------------------------------------------- -/
/- Topological limit in metric spaces.  (metric.ml 19448-19623)              -/
/- ------------------------------------------------------------------------- -/

structure MetricLim where
  LIMIT_IN_MSPACE : thm
  LIMIT_METRIC_UNIQUE : thm
  LIMIT_METRIC : thm
  LIMIT_METRIC_SEQUENTIALLY : thm
  LIMIT_IN_CLOSED_IN : thm
  LIMIT_SUBMETRIC_IFF : thm
  METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED : thm
  LIMIT_ATPOINTOF_METRIC : thm
  LIMIT_METRIC_DIST_NULL : thm
  LIMIT_NULL_REAL : thm
  LIMIT_NULL_REAL_ABS : thm
  LIMIT_NULL_REAL_COMPARISON : thm
  LIMIT_NULL_REAL_HARMONIC_OFFSET : thm
  deriving Inhabited

@[nospecialize]
def setupMetricLim [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BNets : Nets) (BSequential : Sequential) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricHaus : MetricHaus) (BRealTop2 : RealTop2)
    (BAtPoint : AtPoint) (BLimits1 : Limits1) (BLimits2 : Limits2) :
    ExceptT String IO MetricLim := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, REAL_ARITH,
        REAL_ARITH_TAC, SET_RULE, SET_TAC, DESTRUCT_TAC, INTRO_TAC, HYP_TAC, REFUTE_THEN,
        .. } := D
  let { IMP_CONJ, IMP_IMP, IN_DIFF, IN_INTER, IN_UNIV, REAL_ABS_ABS, .. } := D.core2
  let { REAL_ARCH_INV, REAL_LET_TRANS, REAL_LE_INV2, REAL_LT_01, REAL_LT_INV, REAL_LT_TRANS,
        REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, .. } := D.core3
  let { SKOLEM_THM, SUBSET, real_abs, .. } := D.core4
  let { DE_MORGAN_THM, FORALL_AND_THM, NOT_EXISTS_THM, .. } := D.core5
  let { CLAIM_TAC, CONJ_LIST, .. } := BTactics
  let { OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := BTopology
  let { EVENTUALLY_AND, EVENTUALLY_MONO, EVENTUALLY_TRUE, NOT_EVENTUALLY, .. } := BNets
  let { ARCH_EVENTUALLY_ABS_INV_OFFSET, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := BSequential
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_MSPACE, MDIST_POS_LE, MDIST_SYM,
        MDIST_TRIANGLE, SUBMETRIC, .. } := BMetricSpace
  let { CLOSED_IN_METRIC, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { EVENTUALLY_ATPOINTOF_METRIC, .. } := BAtPoint
  let { LIMIT_IN_TOPSPACE, limit, .. } := BLimits1
  let { LIMIT_HAUSDORFF_UNIQUE, .. } := BLimits2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let LIMIT_IN_MSPACE ← prove
   r"!net m f:A->B l. limit (mtopology m) f l net ==> l IN mspace m"
   (MESON_TAC [LIMIT_IN_TOPSPACE, TOPSPACE_MTOPOLOGY])

  let LIMIT_METRIC_UNIQUE ← prove
   r"!net m f:A->B l1 l2.
     ~trivial_limit net /\
     limit (mtopology m) f l1 net /\
     limit (mtopology m) f l2 net
     ==> l1 = l2"
   (MESON_TAC [LIMIT_HAUSDORFF_UNIQUE, HAUSDORFF_SPACE_MTOPOLOGY])

  let LIMIT_METRIC ← prove
   r"!m f:A->B l net.
     limit (mtopology m) f l net <=>
     l IN mspace m /\
     (!e. &0 < e
          ==> eventually (\x. f x IN mspace m /\ mdist m (f x, l) < e) net)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [limit, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN EQ_TAC THENL
    [INTRO_TAC "l hp" THEN ASM_REWRITE_TAC [] THEN INTRO_TAC "!e; e" THEN
     REMOVE_THEN "hp" (MP_TAC o SPEC (← q r"mball m (l:B,e)")) THEN
     ASM_REWRITE_TAC [MBALL_SUBSET_MSPACE] THEN ASM_SIMP_TAC [CENTRE_IN_MBALL] THEN
     REWRITE_TAC [IN_MBALL] THEN ANTS_TAC THENL
     [INTRO_TAC "!x; x lt" THEN
      EXISTS_TAC (← q r"e - mdist m (l:B,x)") THEN
      CONJ_TAC THENL
      [ASM_REAL_ARITH_TAC,
       ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN INTRO_TAC "![y]; y lt'" THEN
       ASM_REWRITE_TAC [] THEN
       TRANS_TAC REAL_LET_TRANS (← q r"mdist m (l:B,x) + mdist m (x,y)") THEN
       ASM_SIMP_TAC [MDIST_TRIANGLE] THEN ASM_REAL_ARITH_TAC],
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      GEN_TAC THEN REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"f (x:A):B IN mspace m") THEN
      ASM_SIMP_TAC [MDIST_SYM]],
     INTRO_TAC "l hp" THEN ASM_REWRITE_TAC [] THEN INTRO_TAC "!u; (u hp) l" THEN
     REMOVE_THEN "hp"
       (DESTRUCT_TAC "@r. r sub" o C MATCH_MP (← ASSUME (← q r"l:B IN u"))) THEN
     REMOVE_THEN "hp" (MP_TAC o C MATCH_MP (← ASSUME (← q r"&0 < r"))) THEN
     MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
     GEN_TAC THEN REWRITE_TAC [] THEN INTRO_TAC "f lt" THEN
     CLAIM_TAC "rmk" (← q r"f (x:A):B IN mball m (l,r)") THENL
     [ASM_SIMP_TAC [IN_MBALL, MDIST_SYM], HYP SET_TAC "rmk sub" []]])

  let LIMIT_METRIC_SEQUENTIALLY ← prove
   r"!m f:num->A l.
     limit (mtopology m) f l sequentially <=>
     l IN mspace m /\
     (!e. &0 < e ==> (?N. !n. N <= n
                              ==> f n IN mspace m /\ mdist m (f n,l) < e))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIMIT_METRIC, EVENTUALLY_SEQUENTIALLY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [])

  let LIMIT_IN_CLOSED_IN ← prove
   r"!net top s f:A->B l.
      ~trivial_limit net /\ limit top f l net /\
      closed_in top s /\ eventually (\x. f x IN s) net
      ==> l IN s"
   (INTRO_TAC "! *; ntriv lim cl ev" THEN REFUTE_THEN (LABEL_TAC "contra") THEN
    HYP_TAC "lim: l lim" (REWRITE_RULE [limit]) THEN
    REMOVE_THEN "lim" (MP_TAC o SPEC (← q r"topspace top DIFF s:B->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, IN_DIFF, EVENTUALLY_AND] THEN
    REWRITE_TAC [DE_MORGAN_THM] THEN DISJ2_TAC THEN INTRO_TAC "nev" THEN
    HYP (MP_TAC o CONJ_LIST) "ev nev" [] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN MATCH_MP_TAC NOT_EVENTUALLY THEN
    ASM_REWRITE_TAC [] THEN MESON_TAC [])

  let LIMIT_SUBMETRIC_IFF ← prove
   r"!net m s f:A->B l.
     limit (mtopology (submetric m s)) f l net <=>
     l IN s /\ eventually (\x. f x IN s) net /\ limit (mtopology m) f l net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LIMIT_METRIC, SUBMETRIC, IN_INTER, EVENTUALLY_AND] THEN
    EQ_TAC THEN SIMP_TAC [] THENL [INTRO_TAC "l hp", MESON_TAC []] THEN
    HYP_TAC "hp" (C MATCH_MP REAL_LT_01) THEN ASM_REWRITE_TAC [])

  let METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED ← prove
   r"!m s:A->bool.
     closed_in (mtopology m) s <=>
     s SUBSET mspace m /\
     (!a l. (!n. a n IN s) /\ limit (mtopology m) a l sequentially
            ==> l IN s)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
    [INTRO_TAC "cl" THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CLOSED_IN_METRIC], INTRO_TAC "!a l; a lim"] THEN
     MATCH_MP_TAC
       (← ISPECL [← q r"sequentially", ← q r"mtopology (m:A metric)"] LIMIT_IN_CLOSED_IN) THEN
     EXISTS_TAC (← q r"a:num->A") THEN
     ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_TRUE],
     ALL_TAC] THEN
    SIMP_TAC [CLOSED_IN_METRIC, IN_DIFF] THEN
    INTRO_TAC "sub seq; !x; x diff" THEN
    REFUTE_THEN (LABEL_TAC "contra" o
      REWRITE_RULE [NOT_EXISTS_THM, ← MESON [] (← q r"~(a /\ b) <=> a ==> ~b")]) THEN
    CLAIM_TAC "@a. a lt"
      (← q r"?a. (!n. a n:A IN s) /\ (!n. mdist m (x, a n) < inv(&n + &1))") THENL
    [REWRITE_TAC [← GSYM FORALL_AND_THM, ← GSYM SKOLEM_THM] THEN GEN_TAC THEN
     REMOVE_THEN "contra" (MP_TAC o SPEC (← q r"inv (&n + &1)")) THEN
     ANTS_TAC THENL [MATCH_MP_TAC REAL_LT_INV THEN REAL_ARITH_TAC, ALL_TAC] THEN
     REWRITE_TAC [← sr r"~DISJOINT s t <=> ?x:A. x IN s /\ x IN t"] THEN
     ASM_REWRITE_TAC [IN_MBALL] THEN MESON_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "a'" (← q r"!n:num. a n:A IN mspace m") THENL
    [HYP SET_TAC "sub a" [], ALL_TAC] THEN
    REMOVE_THEN "seq" (MP_TAC o SPECL [← q r"a:num->A", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [LIMIT_METRIC_SEQUENTIALLY] THEN INTRO_TAC "!e; e" THEN
    HYP_TAC "e -> @N. NZ Ngt Nlt" (ONCE_REWRITE_RULE [REAL_ARCH_INV]) THEN
    EXISTS_TAC (← q r"N:num") THEN INTRO_TAC "!n; n" THEN
    TRANS_TAC REAL_LT_TRANS (← q r"inv (&n + &1)") THEN CONJ_TAC THENL
    [HYP MESON_TAC "lt a' x" [MDIST_SYM], ALL_TAC] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"inv (&N)") THEN HYP REWRITE_TAC "Nlt" [] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN
    REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN
    ASM_ARITH_TAC)

  let LIMIT_ATPOINTOF_METRIC ← prove
   r"!m top f:A->B x y.
        limit top f y (atpointof (mtopology m) x) <=>
        y IN topspace top /\
        (x IN mspace m
         ==> !v. open_in top v /\ y IN v
                 ==> ?d. &0 < d /\
                         !x'. x' IN mspace m /\
                              &0 < mdist m (x',x) /\ mdist m (x',x) < d
                              ==> f x' IN v)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [limit, EVENTUALLY_ATPOINTOF_METRIC] THEN
    MESON_TAC [])

  let LIMIT_METRIC_DIST_NULL ← prove
   r"!net m (f:K->A) l.
        limit (mtopology m) f l net <=>
        l IN mspace m /\ eventually (\x. f x IN mspace m) net /\
        limit euclideanreal (\x. mdist m (f x,l)) (&0) net"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LIMIT_METRIC, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV, EVENTUALLY_AND] THEN
    ASM_CASES_TAC (← q r"(l:A) IN mspace m") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM EVENTUALLY_AND, ← MESON [REAL_LT_01] (← q
     r"P /\ (!e. &0 < e ==> Q e) <=> (!e. &0 < e ==> P /\ Q e)")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(&0 - x) = abs x")] THEN
    ASM_SIMP_TAC [← TAUT (← q r"(p /\ q) <=> ~(p ==> ~q)"), MDIST_POS_LE, real_abs])

  let LIMIT_NULL_REAL ← prove
   r"!net f:A->real.
        limit euclideanreal f (&0) net <=>
        !e. &0 < e ==> eventually (\a. abs(f a) < e) net"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, LIMIT_METRIC] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"abs(&0 - x) = abs x")])

  let LIMIT_NULL_REAL_ABS ← prove
   r"!net (f:A->real).
        limit euclideanreal (\a. abs(f a)) (&0) net <=>
        limit euclideanreal f (&0) net"
   (REWRITE_TAC [LIMIT_NULL_REAL, REAL_ABS_ABS])

  let LIMIT_NULL_REAL_COMPARISON ← prove
   r"!net f g:A->real.
        limit euclideanreal f (&0) net /\
        eventually (\a. abs(g a) <= abs(f a)) net
        ==> limit euclideanreal g (&0) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [LIMIT_NULL_REAL] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
    UNDISCH_TAC (← q r"&0 < e") THEN SIMP_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let LIMIT_NULL_REAL_HARMONIC_OFFSET ← prove
   r"!a. limit euclideanreal (\n. inv(&n + a)) (&0) sequentially"
   (REWRITE_TAC [LIMIT_NULL_REAL, ARCH_EVENTUALLY_ABS_INV_OFFSET])

  return { LIMIT_IN_MSPACE, LIMIT_METRIC_UNIQUE, LIMIT_METRIC, LIMIT_METRIC_SEQUENTIALLY,
           LIMIT_IN_CLOSED_IN, LIMIT_SUBMETRIC_IFF, METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED,
           LIMIT_ATPOINTOF_METRIC, LIMIT_METRIC_DIST_NULL, LIMIT_NULL_REAL,
           LIMIT_NULL_REAL_ABS, LIMIT_NULL_REAL_COMPARISON, LIMIT_NULL_REAL_HARMONIC_OFFSET }

/- ------------------------------------------------------------------------- -/
/- More sequential characterizations in a metric space.                      -/
/- (metric.ml 19625-19793)                                                    -/
/- ------------------------------------------------------------------------- -/

structure SeqChar1 where
  EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY : thm
  EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY_INJ : thm
  EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY_DECREASING : thm
  EVENTUALLY_ATPOINTOF_SEQUENTIALLY : thm
  EVENTUALLY_ATPOINTOF_SEQUENTIALLY_INJ : thm
  EVENTUALLY_ATPOINTOF_SEQUENTIALLY_DECREASING : thm
  LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN : thm
  LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_INJ : thm
  LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN_DECREASING : thm
  deriving Inhabited

@[nospecialize]
def setupSeqChar1 [HolBase] (D : MetricDeps) (BNets : Nets) (BSequential : Sequential)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BAtPoint : AtPoint)
    (BLimits1 : Limits1) (BMetricLim : MetricLim) : ExceptT String IO SeqChar1 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { AND_FORALL_THM, CONJ_ACI, CONJ_ASSOC, DEPENDENT_CHOICE, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INTER_UNIV, IN_DELETE, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_FORALL,
        NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { REAL_LE_INV2, REAL_LTE_TRANS, REAL_LT_01, REAL_LT_INV_EQ, REAL_LT_MIN, REAL_LT_REFL,
        REAL_LT_TRANS, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, REAL_OF_NUM_LT, .. } := D.core3
  let { RIGHT_IMP_FORALL_THM, SWAP_FORALL_THM, TRANSITIVE_STEPWISE_LT, WLOG_LT, o_DEF,
        .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { FORALL_POS_MONO_1, .. } := D.misc
  let { EVENTUALLY_FALSE, EVENTUALLY_MONO, EVENTUALLY_WITHIN_IMP, NET_WITHIN_UNIV,
        .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { MDIST_POS_EQ, .. } := BMetricSpace
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { EVENTUALLY_ATPOINTOF, EVENTUALLY_ATPOINTOF_METRIC, .. } := BAtPoint
  let { limit, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  -- @@SCOPE END

  let [EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY,
       EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY_INJ,
       EVENTUALLY_ATPOINTOF_WITHIN_SEQUENTIALLY_DECREASING] := CONJUNCTS (← prove
   r"(!met P s a:A.
        eventually P (atpointof (mtopology met) a within s) <=>
        !x. (!n. x(n) IN (s INTER mspace met) DELETE a) /\
            limit (mtopology met) x a sequentially
            ==> eventually (\n. P(x n)) sequentially) /\
   (!met P s a:A.
        eventually P (atpointof (mtopology met) a within s) <=>
        !x. (!n. x(n) IN (s INTER mspace met) DELETE a) /\
            (!m n. x m = x n <=> m = n) /\
            limit (mtopology met) x a sequentially
            ==> eventually (\n. P(x n)) sequentially) /\
   (!met P s a:A.
        eventually P (atpointof (mtopology met) a within s) <=>
        !x. (!n. x(n) IN (s INTER mspace met) DELETE a) /\
            (!m n. m < n ==> mdist met (x n,a) < mdist met (x m,a)) /\
            (!m n. x m = x n <=> m = n) /\
            limit (mtopology met) x a sequentially
            ==> eventually (\n. P(x n)) sequentially)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(r ==> s) /\ (q ==> r) /\ (p ==> q) /\ (s ==> p)
