  deriving Inhabited

@[nospecialize]
def setupHM [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap2 : ContMap2)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BEmbedding : Embedding) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BHausdorff2 : Hausdorff2) (BCountability : Countability)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BSepMetrizable : SepMetrizable) (BConnected1 : Connected1) (BConnected3 : Connected3)
    (BRegular1 : Regular1) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2)
    (BRealConn1 : RealConn1) (BPaths1 : Paths1) (BLC1 : LC1) (BLC2 : LC2) (BIMB : IMB)
    (BURY2 : URY2) (BCAN1 : CAN1) (BCAN2 : CAN2) (BAH : AH) (BPGF : PGF) :
    ExceptT String IO HM := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, .. } := D.core1
  let { IMAGE_o, INTER_IDEMPOT, IN_IMAGE, IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SUBSET_REFL, SUBSET_UNIV, .. } := D.core4
  let { COUNTABLE_RATIONAL, IN_REAL_INTERVAL, .. } := D.misc
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { embedding_map, .. } := BEmbedding
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { COMPACT_SPACE_QUOTIENT_MAP_IMAGE, .. } := BCompact3
  let { CONTINUOUS_IMP_CLOSED_MAP, CONTINUOUS_IMP_QUOTIENT_MAP, .. } := BHausdorff2
  let { SECOND_COUNTABLE_SUBTOPOLOGY, separable_space, .. } := BCountability
  let { SUBMETRIC_MSPACE, .. } := BMetricSpace
  let { SUBTOPOLOGY_MSPACE, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIZABLE_SPACE_MTOPOLOGY, METRIZABLE_SPACE_SUBTOPOLOGY, .. } := BMetrizable
  let { SECOND_COUNTABLE_CLOSED_MAP_IMAGE, SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE, .. } :=
    BSepMetrizable
  let { CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_SPACE_SUBTOPOLOGY, connected_in, .. } :=
    BConnected1
  let { CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, .. } := BConnected3
  let { COMPACT_HAUSDORFF_IMP_REGULAR_SPACE, .. } := BRegular1
  let { TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { EUCLIDEANREAL_CLOSURE_OF_RATIONAL, METRIZABLE_SPACE_EUCLIDEANREAL, .. } := BRealTop2
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_EUCLIDEANREAL_INTERVAL, .. } :=
    BRealConn1
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL,
        PATH_CONNECTED_IN_TOPSPACE, PATH_CONNECTED_SPACE_TOPSPACE_EMPTY, path_connected_in,
        path_connected_space, path_in, .. } := BPaths1
  let { LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, .. } := BLC1
  let { LOCALLY_CONNECTED_REAL_INTERVAL, .. } := BLC2
  let { MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM_IN, .. } := BIMB
  let { URYSOHN_METRIZATION, .. } := BURY2
  let { TOPSPACE_CANTOR_SPACE, .. } := BCAN1
  let { CANTOR_MAP_CLOSED_IN_INTERVAL, CANTOR_MAP_EMBEDDING, CANTOR_MAP_IMAGE_SUBSET_INTERVAL,
        .. } := BCAN2
  let { ALEXANDROFF_HAUSDORFF, .. } := BAH
  let { PEANO_GAP_FILLING_EXTENSION, .. } := BPGF
  -- @@SCOPE END

  -- Backward direction: Peano space is continuous image of [0,1]
  -- Proof: compose Alexandroff-Hausdorff surjection with inverse of Cantor
  -- embedding, then extend via gap-filling
  let HAHN_MAZURKIEWICZ_IMP ← prove
   r"!top:A topology.
        compact_space top /\
        connected_space top /\
        locally_connected_space top /\
        metrizable_space top /\
        ~(topspace top = {})
        ==> ?f. continuous_map
                  (subtopology euclideanreal (real_interval[&0,&1]),top) f /\
                IMAGE f (real_interval[&0,&1]) = topspace top"
   (GEN_TAC THEN STRIP_TAC THEN
    /- Get surjection g: cantor_space -> top from Alexandroff-Hausdorff -/
    MP_TAC (← ISPEC (← q r"top:A topology") ALEXANDROFF_HAUSDORFF) THEN
      ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(num->bool)->A") STRIP_ASSUME_TAC) THEN
    /- Get inverse cinv of cantor_map from the embedding -/
    MP_TAC CANTOR_MAP_EMBEDDING THEN
      REWRITE_TAC [embedding_map, TOPSPACE_CANTOR_SPACE] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [HOMEOMORPHIC_MAP_MAPS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"cinv:real->num->bool") MP_TAC) THEN
    REWRITE_TAC [homeomorphic_maps, TOPSPACE_CANTOR_SPACE,
                 TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_UNIV] THEN STRIP_TAC THEN
    /- Apply gap-filling: g o cinv is continuous surjection from
       IMAGE cantor_map UNIV (closed in [0,1]) to top -/ MP_TAC (← ISPECL
         [← q r"top:A topology",
                    ← q r"(g:(num->bool)->A) o (cinv:real->num->bool)",
                      ← q r"IMAGE cantor_map (:num->bool)"]
                   PEANO_GAP_FILLING_EXTENSION) THEN ANTS_TAC THENL
    [ASM_REWRITE_TAC [CANTOR_MAP_IMAGE_SUBSET_INTERVAL,
      CANTOR_MAP_CLOSED_IN_INTERVAL] THEN
     CONJ_TAC THENL [/- continuous_map (subtopology euclideanreal C,
       top) (g o cinv) -/
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC (← q r"cantor_space") THEN
        ASM_REWRITE_TAC [],
      /- IMAGE (g o cinv) C = topspace top -/
      REWRITE_TAC [IMAGE_o] THEN SUBGOAL_THEN
        (← q r"IMAGE (cinv:real->num->bool) (IMAGE cantor_map (:num->bool)) =
         topspace cantor_space") (fun th => ASM_REWRITE_TAC [th]) THEN
      REWRITE_TAC [TOPSPACE_CANTOR_SPACE, EXTENSION, IN_IMAGE, IN_UNIV] THEN
        ASM_MESON_TAC []],
     MESON_TAC []])

  -- The full Hahn-Mazurkiewicz theorem: Whyburn (4.1); H-Y 3-30; Willard 31.5
  let HAHN_MAZURKIEWICZ ← do
    let HAHN_MAZURKIEWICZ_FORWARD ← prove
     r"!top:A topology f.
          hausdorff_space top /\
          continuous_map
            (subtopology euclideanreal (real_interval[&0,&1]),top) f /\
          IMAGE f (real_interval[&0,&1]) = topspace top
          ==> compact_space top /\ connected_space top /\
              locally_connected_space top /\ metrizable_space top"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      ABBREV_TAC
        (← q r"sub = subtopology euclideanreal (real_interval[&0:real,&1])") THEN
      SUBGOAL_THEN (← q r"compact_space (sub:real topology)") ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN
        REWRITE_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"topspace (sub:real topology) = real_interval[&0:real,&1]")
        ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN
        REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"quotient_map(sub:real topology,top:A topology) f")
        ASSUME_TAC THENL
       [MATCH_MP_TAC CONTINUOUS_IMP_QUOTIENT_MAP THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"connected_space (sub:real topology)") ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN MATCH_MP_TAC CONNECTED_SPACE_SUBTOPOLOGY THEN
        REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL_INTERVAL], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"locally_connected_space (sub:real topology)")
        ASSUME_TAC THENL
       [EXPAND_TAC "sub" THEN
        REWRITE_TAC [LOCALLY_CONNECTED_REAL_INTERVAL], ALL_TAC] THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [COMPACT_SPACE_QUOTIENT_MAP_IMAGE],
        ASM_MESON_TAC [CONNECTED_SPACE_QUOTIENT_MAP_IMAGE],
        ASM_MESON_TAC [LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE],
        MATCH_MP_TAC URYSOHN_METRIZATION THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [COMPACT_HAUSDORFF_IMP_REGULAR_SPACE,
                         COMPACT_SPACE_QUOTIENT_MAP_IMAGE], ALL_TAC] THEN
        MP_TAC (← ISPECL [← q r"f:real->A", ← q r"sub:real topology", ← q r"top:A topology"]
                       SECOND_COUNTABLE_CLOSED_MAP_IMAGE) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
        REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_IMP_CLOSED_MAP THEN ASM_REWRITE_TAC [],
          EXPAND_TAC "sub" THEN
          MATCH_MP_TAC SECOND_COUNTABLE_SUBTOPOLOGY THEN
          MATCH_MP_TAC SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE THEN
          REWRITE_TAC [METRIZABLE_SPACE_EUCLIDEANREAL, separable_space,
                       TOPSPACE_EUCLIDEANREAL] THEN
          EXISTS_TAC (← q r"rational") THEN
          REWRITE_TAC [COUNTABLE_RATIONAL, SUBSET_UNIV,
                       EUCLIDEANREAL_CLOSURE_OF_RATIONAL]]])
    prove
     r"!top:A topology.
          hausdorff_space top
          ==> ((?f. continuous_map
                     (subtopology euclideanreal (real_interval[&0,&1]),top)
                     f /\
                    IMAGE f (real_interval[&0,&1]) = topspace top) <=>
               compact_space top /\
               connected_space top /\
               locally_connected_space top /\
               metrizable_space top /\
               ~(topspace top = {}))"
     (GEN_TAC THEN DISCH_TAC THEN EQ_TAC THENL
       [DISCH_THEN (X_CHOOSE_THEN (← q r"f:real->A") STRIP_ASSUME_TAC) THEN
        SUBGOAL_THEN
          (← q r"compact_space top /\ connected_space top /\
           locally_connected_space top /\
           metrizable_space (top:A topology)") STRIP_ASSUME_TAC THENL
         [MATCH_MP_TAC HAHN_MAZURKIEWICZ_FORWARD THEN
          EXISTS_TAC (← q r"f:real->A") THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        EXISTS_TAC (← q r"(f:real->A) (&0)") THEN
        FIRST_X_ASSUM (fun th => tactic_of do
          pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
        REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&0") THEN
        REWRITE_TAC [IN_REAL_INTERVAL] THEN REAL_ARITH_TAC,
        STRIP_TAC THEN MATCH_MP_TAC HAHN_MAZURKIEWICZ_IMP THEN
        ASM_REWRITE_TAC []])

  -- Compact case: H-Y Theorem 3-15; Whyburn (5.1). Compact + connected +
  -- locally connected ==> path connected, via H-M backward (the space is
  -- a continuous image of [0,1], which is path connected).

  let COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED ← prove
   r"!m:A metric s.
        compact_in (mtopology m) s /\
        connected_in (mtopology m) s /\
        locally_connected_space (subtopology (mtopology m) s)
        ==> path_connected_space (subtopology (mtopology m) s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [MATCH_MP_TAC PATH_CONNECTED_SPACE_TOPSPACE_EMPTY THEN
      ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"top = subtopology (mtopology m) (s:A->bool)") THEN
    MP_TAC (← ISPEC (← q r"top:A topology") HAHN_MAZURKIEWICZ_IMP) THEN
    ANTS_TAC THENL
     [EXPAND_TAC "top" THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN ASM_REWRITE_TAC [],
        ASM_MESON_TAC [CONNECTED_SPACE_SUBTOPOLOGY, connected_in],
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC METRIZABLE_SPACE_SUBTOPOLOGY THEN
        REWRITE_TAC [METRIZABLE_SPACE_MTOPOLOGY],
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
        ASM SET_TAC []],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:real->A") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
    EXISTS_TAC
      (← q r"subtopology euclideanreal (real_interval[&0,&1])") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [path_connected_in, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
                 SUBSET_REFL, SUBTOPOLOGY_SUBTOPOLOGY, INTER_IDEMPOT] THEN
    MP_TAC (← CONJUNCT1 PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL) THEN
    SIMP_TAC [path_connected_in, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV])

  -- Mcomplete case: Whyburn, Analytic Topology, Theorem (5.4); H-Y 3-17.
  -- Any two points sit inside an LC continuum (by the Imbedding Theorem),
  -- and the compact case gives path-connectedness of that continuum.

  let MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_IN ←
    prove
   r"!m:A metric s.
        mcomplete(submetric m s) /\
        connected_in (mtopology m) s /\
        locally_connected_space (subtopology (mtopology m) s)
        ==> path_connected_space (subtopology (mtopology m) s)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [CONNECTED_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    REWRITE_TAC [path_connected_space, TOPSPACE_SUBTOPOLOGY,
                 TOPSPACE_MTOPOLOGY] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> t INTER s = (s:A->bool)")] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:A"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool", ← q r"a:A", ← q r"b:A"]
      MCOMPLETE_IMBEDDING_IN_LC_CONTINUUM_IN) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"K:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(K:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"path_connected_space (subtopology (mtopology m) (K:A->bool))")
      MP_TAC THENL
     [MATCH_MP_TAC
        COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [path_connected_space, TOPSPACE_SUBTOPOLOGY,
                 TOPSPACE_MTOPOLOGY] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"K SUBSET t ==> t INTER K = (K:A->bool)")] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"a:A", ← q r"b:A"]) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"g:real->A") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_in]) THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, path_in] THEN
    STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED ← prove
   r"!m:A metric.
        mcomplete m /\
        connected_space (mtopology m) /\
        locally_connected_space (mtopology m)
        ==> path_connected_space (mtopology m)"
   (GEN_TAC THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"mspace m:A->bool"]
      MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_IN) THEN
    ASM_SIMP_TAC [SUBMETRIC_MSPACE, SUBTOPOLOGY_MSPACE, connected_in,
                  TOPSPACE_MTOPOLOGY, SUBSET_REFL])

  return { HAHN_MAZURKIEWICZ_IMP, HAHN_MAZURKIEWICZ,
           COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED,
           MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED_IN,
           MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Locally path connected spaces from local connectedness.                   -/
/- (metric.ml 50111-50264)                                                   -/
/- ------------------------------------------------------------------------- -/

structure LPCC where
  LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE : thm
  LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE : thm
  LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_SPACE : thm
  MCOMPLETE_IN_LOCALLY_COMPACT_IMP_LOCALLY_COMPACT : thm
  MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED : thm
  MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED : thm
  COMPLETELY_METRIZABLE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED : thm
  COMPLETELY_METRIZABLE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED : thm
  deriving Inhabited

@[nospecialize]
def setupLPCC [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BCompact1 : Compact1)
    (BMTopology : MTopology) (BConnected1 : Connected1) (BNbhdBase : NbhdBase)
    (BLocCompact2 : LocCompact2) (BMCompact2 : MCompact2) (BPaths1 : Paths1) (BLPC1 : LPC1)
    (BLPC2 : LPC2) (BLC1 : LC1) (BCMS1 : CMS1) (BLCC : LCC) (BCMS2 : CMS2) (BHM : HM) :
    ExceptT String IO LPCC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_SUBTOPOLOGY, connected_in, .. } :=
    BConnected1
  let { NEIGHBOURHOOD_BASE_OF_MONO, .. } := BNbhdBase
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, .. } := BLocCompact2
  let { MCOMPLETE_IMP_CLOSED_IN, .. } := BMCompact2
  let { path_connected_in, .. } := BPaths1
  let { LOCALLY_PATH_CONNECTED_SPACE, locally_path_connected_space, .. } := BLPC1
  let { PATH_CONNECTED_EQ_CONNECTED_SPACE, .. } := BLPC2
  let { LOCALLY_CONNECTED_SPACE, LOCALLY_CONNECTED_SPACE_OPEN_SUBSET,
        LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY, completely_metrizable_space, .. } := BCMS1
  let { LOCALLY_CONNECTED_CONTINUUM_SPACE, .. } := BLCC
  let { COMPLETELY_METRIZABLE_SPACE_OPEN_IN, .. } := BCMS2
  let { COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED,
        MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED, .. } := BHM
  -- @@SCOPE END

  -- Whyburn, Analytic Topology, Corollaries (5.2)-(5.3).
  let LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE ← prove
   r"!m:A metric s.
        locally_compact_space (subtopology (mtopology m) s) /\
        connected_in (mtopology m) s /\
        locally_connected_space (subtopology (mtopology m) s)
        ==> path_connected_space (subtopology (mtopology m) s)"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
      (← q r"locally_path_connected_space (subtopology (mtopology m) (s:A->bool))")
      ASSUME_TAC THENL [REWRITE_TAC [locally_path_connected_space] THEN
      MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool"]
        LOCALLY_CONNECTED_CONTINUUM_SPACE) THEN
      DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2)) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN MP_TAC (← ISPECL
       [← q r"subtopology (mtopology m) (s:A->bool)",
        ← q r"\c:A->bool. compact_in (subtopology (mtopology m) s) c /\
                     connected_in (subtopology (mtopology m) s) c /\
                     locally_connected_space
                       (subtopology (mtopology m) c)", ← q r"path_connected_in
          (subtopology (mtopology m) s):(A->bool)->bool"]
        NEIGHBOURHOOD_BASE_OF_MONO) THEN ANTS_TAC THENL
       [CONJ_TAC THENL [X_GEN_TAC (← q r"c:A->bool") THEN
          REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, CONNECTED_IN_SUBTOPOLOGY] THEN
          STRIP_TAC THEN
          SUBGOAL_THEN (← q r"(c:A->bool) SUBSET topspace(mtopology m)")
            ASSUME_TAC THENL
           [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
          REWRITE_TAC [path_connected_in, TOPSPACE_SUBTOPOLOGY,
                       SUBTOPOLOGY_SUBTOPOLOGY] THEN ASM_SIMP_TAC [← SET_RULE
            (← q r"(c:A->bool) SUBSET s ==> s INTER c = c")] THEN CONJ_TAC THENL
           [ASM SET_TAC [], MATCH_MP_TAC
              COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED THEN
            ASM_REWRITE_TAC []], ASM_REWRITE_TAC []],
        DISCH_THEN ACCEPT_TAC], ASM_MESON_TAC [PATH_CONNECTED_EQ_CONNECTED_SPACE,
                    CONNECTED_SPACE_SUBTOPOLOGY]])

  -- The locally-path-connected part extracted as a standalone theorem:
  -- locally compact + locally connected ==> locally path connected.

  let LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!m:A metric s.
        locally_compact_space(subtopology (mtopology m) s) /\
        locally_connected_space(subtopology (mtopology m) s)
        ==> locally_path_connected_space(subtopology (mtopology m) s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally_path_connected_space] THEN
    MP_TAC (← ISPECL [← q r"m:A metric", ← q r"s:A->bool"]
      LOCALLY_CONNECTED_CONTINUUM_SPACE) THEN
    DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← EQ_IMP_RULE th).2)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN MP_TAC (← ISPECL
     [← q r"subtopology (mtopology m) (s:A->bool)",
      ← q r"\c:A->bool. compact_in (subtopology (mtopology m) s) c /\
                   connected_in (subtopology (mtopology m) s) c /\
                   locally_connected_space (subtopology (mtopology m) c)",
      ← q r"path_connected_in (subtopology (mtopology m) s):(A->bool)->bool"]
      NEIGHBOURHOOD_BASE_OF_MONO) THEN ANTS_TAC THENL
     [CONJ_TAC THENL [X_GEN_TAC (← q r"c:A->bool") THEN
        REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, CONNECTED_IN_SUBTOPOLOGY] THEN
        STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(c:A->bool) SUBSET topspace(mtopology m)") ASSUME_TAC THENL
         [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
        REWRITE_TAC [path_connected_in, TOPSPACE_SUBTOPOLOGY,
                     SUBTOPOLOGY_SUBTOPOLOGY] THEN
        ASM_SIMP_TAC [← SET_RULE (← q r"(c:A->bool) SUBSET s ==> s INTER c = c")] THEN
        CONJ_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC
            COMPACT_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED THEN
          ASM_REWRITE_TAC []], ASM_REWRITE_TAC []], DISCH_THEN ACCEPT_TAC])

  let LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_SPACE ← prove
   r"!m:A metric s.
        locally_compact_space(subtopology (mtopology m) s)
        ==> (locally_path_connected_space(subtopology (mtopology m) s) <=>
             locally_connected_space(subtopology (mtopology m) s))"
   (MESON_TAC [LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE,
               LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE])

  let MCOMPLETE_IN_LOCALLY_COMPACT_IMP_LOCALLY_COMPACT ← prove
   r"!m:A metric s.
        locally_compact_space(mtopology m) /\
        mcomplete(submetric m s) /\
        s SUBSET mspace m
        ==> locally_compact_space(subtopology (mtopology m) s)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_COMPACT_SPACE_CLOSED_SUBSET THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MCOMPLETE_IMP_CLOSED_IN THEN
    ASM_REWRITE_TAC [])

  -- mcomplete + locally connected ==> locally path connected.
  -- Uses Alexandrov's theorem (open subsets of completely metrizable
  -- spaces are completely metrizable) combined with the Menger theorem.

  let MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!m:A metric.
        mcomplete m /\ locally_connected_space (mtopology m)
        ==> locally_path_connected_space (mtopology m)"
   (GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"?u:A->bool. open_in (mtopology m) u /\
                   connected_in (mtopology m) u /\ x IN u /\ u SUBSET w")
      (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THENL
     [ASM_MESON_TAC [LOCALLY_CONNECTED_SPACE], ALL_TAC] THEN
    EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [path_connected_in, TOPSPACE_MTOPOLOGY] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [connected_in, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"mtopology(m:A metric)", ← q r"u:A->bool"]
      COMPLETELY_METRIZABLE_SPACE_OPEN_IN) THEN
    ASM_SIMP_TAC [COMPLETELY_METRIZABLE_SPACE_MTOPOLOGY] THEN
    REWRITE_TAC [completely_metrizable_space] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m':A metric") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC
      MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [connected_in],
      ASM_MESON_TAC [LOCALLY_CONNECTED_SPACE_OPEN_SUBSET]])

  let MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED ← prove
   r"!m:A metric.
        mcomplete m
        ==> (locally_path_connected_space(mtopology m) <=>
             locally_connected_space(mtopology m))"
   (MESON_TAC [LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE,
               MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED])

  let COMPLETELY_METRIZABLE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED ←
    prove
   r"!top:A topology.
        completely_metrizable_space top
        ==> (locally_path_connected_space top <=>
             locally_connected_space top)"
   (GEN_TAC THEN REWRITE_TAC [completely_metrizable_space] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:A metric")
      (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    MATCH_MP_TAC
      MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED THEN
    ASM_REWRITE_TAC [])

  -- completely_metrizable_space + connected + locally connected
  -- ==> path connected. (Menger via completely_metrizable_space)

  let COMPLETELY_METRIZABLE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED ←
    prove
   r"!top:A topology.
        completely_metrizable_space top /\
        connected_space top /\
        locally_connected_space top
        ==> path_connected_space top"
   (GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [completely_metrizable_space]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:A metric")
      (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC)) THEN
    MATCH_MP_TAC
      MCOMPLETE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED THEN
    ASM_REWRITE_TAC [])

  return { LOCALLY_COMPACT_CONNECTED_IMP_PATH_CONNECTED_SPACE,
           LOCALLY_COMPACT_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED_SPACE,
           LOCALLY_COMPACT_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED_SPACE,
           MCOMPLETE_IN_LOCALLY_COMPACT_IMP_LOCALLY_COMPACT,
           MCOMPLETE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED,
           MCOMPLETE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED,
           COMPLETELY_METRIZABLE_LOCALLY_PATH_CONNECTED_EQ_LOCALLY_CONNECTED,
           COMPLETELY_METRIZABLE_CONNECTED_LOCALLY_CONNECTED_IMP_PATH_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Theorems from Kuratowski's "Remark on an Invariance Theorem", Fundamenta  -/
/- Mathematicae vol 37 (1950), pp. 251-252. The idea is that in suitable     -/
/- spaces, to show "number of components of the complement" (without         -/
/- distinguishing orders of infinity) is a homeomorphic invariant, it        -/
/- suffices to show it for closed subsets. Kuratowski states the main result -/
/- for a "locally connected continuum", and seems clearly to be implicitly   -/
/- assuming that means metrizable. We call out the general topological       -/
/- hypotheses more explicitly, which do not however include connectedness.   -/
/- (metric.ml 50265-50662)                                                   -/
/- ------------------------------------------------------------------------- -/

structure KUR where
  SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT : thm
  SEPARATION_BY_CLOSED_INTERMEDIATES_GEN : thm
  SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT : thm
  SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_GEN : thm
  KURATOWSKI_COMPONENT_NUMBER_INVARIANCE : thm
  deriving Inhabited

@[nospecialize]
def setupKUR [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap2 : ContMap2) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BSeparated : Separated)
    (BHausdorff1 : Hausdorff1) (BConnected1 : Connected1) (BConnected2 : Connected2)
    (BComponents1 : Components1) (BComponents2 : Components2) (BComponents3 : Components3)
    (BHerNormal : HerNormal) (BLC1 : LC1) :
    ExceptT String IO KUR := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, HAS_SIZE_CONV, .. } := D
  let { CARD_DELETE, CHOOSE_SUBSET_STRONG, DIFF_UNIONS_PAIRWISE_DISJOINT, EMPTY_UNIONS,
        EQ_TRANS, FINITE_DELETE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, HAS_SIZE,
        HAS_SIZE_0, HAS_SIZE_CLAUSES, HAS_SIZE_IMAGE_INJ, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INTER_UNIONS, IN_DELETE, IN_DIFF, IN_ELIM_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_IMP, NOT_IN_EMPTY,
        NOT_LE, NOT_LT, PAIRWISE_EMPTY, PAIRWISE_IMAGE, PAIRWISE_IMP, PAIRWISE_INSERT,
        PAIRWISE_MONO, .. } := D.core2
  let { SING_SUBSET, SUBSET_DIFF, SUBSET_RESTRICT, UNIONS_0, UNIONS_2, UNIONS_GSPEC,
        UNIONS_IMAGE, UNIONS_INSERT, UNIONS_SUBSET, UNWIND_THM2, pairwise, .. } := D.core4
  let { CONTRAPOS_THM, NOT_EXISTS_THM, .. } := D.core5
  let { CARD_LE_CARD, CARD_LE_RELATIONAL_FULL, NUMSEG_CARD_LE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, CLOSED_IN_UNIONS,
        OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS,
        .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY,
        SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAPS_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { SEPARATED_IN_IMP_DISJOINT, SEPARATED_IN_OPEN_SETS, SEPARATED_IN_REFL,
        SEPARATED_IN_SUBTOPOLOGY, SEPARATED_IN_SYM, SEPARATED_IN_UNIONS, separated_in, .. } :=
    BSeparated
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_EQ_NOT_SEPARATED, CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, .. } := BConnected2
  let { CONNECTED_COMPONENTS_OF_SUBSET, CONNECTED_IN_CONNECTED_COMPONENTS_OF,
        PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF, UNIONS_CONNECTED_COMPONENTS_OF, .. } :=
    BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENTS_OF, .. } := BComponents2
  let { CARD_LE_CONNECTED_COMPONENTS_ALT, .. } := BComponents3
  let { HEREDITARILY_NORMAL_SEPARATION_PAIRWISE, .. } := BHerNormal
  let { LOCALLY_CONNECTED_SPACE_OPEN_SUBSET,
        OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  -- @@SCOPE END

  let SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT ← prove
   r"!(top:A topology) s n.
        hereditarily normal_space top /\
        (?u. u HAS_SIZE n /\
             pairwise (separated_in top) u /\
             (!t. t IN u ==> ~(t = {})) /\
             UNIONS u = topspace top DIFF s)
        ==>  ?c. closed_in top c /\ c SUBSET s /\
                 !d. closed_in top d /\ c SUBSET d /\ d SUBSET s
                     ==> ?u. u HAS_SIZE n /\
                             pairwise (separated_in top) u /\
                             (!t. t IN u ==> ~(t = {})) /\
                             UNIONS u = topspace top DIFF d"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"u:(A->bool)->bool") STRIP_ASSUME_TAC)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:(A->bool)->bool") o
      GEN_REWRITE_RULE id [HEREDITARILY_NORMAL_SEPARATION_PAIRWISE]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [HAS_SIZE], ASM SET_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:(A->bool)->(A->bool)") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC
     (← q r"topspace top DIFF UNIONS (IMAGE (f:(A->bool)->(A->bool)) u)") THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_UNIONS,
                  FORALL_IN_IMAGE] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (\s. (f:(A->bool)->(A->bool)) s DIFF c) u") THEN
    REWRITE_TAC [PAIRWISE_IMAGE, FORALL_IN_IMAGE] THEN
    ASM_SIMP_TAC [pairwise, SEPARATED_IN_OPEN_SETS, OPEN_IN_DIFF] THEN
    MATCH_MP_TAC (← TAUT (← q r"d /\ c /\ b /\ (c ==> a) ==> a /\ b /\ c /\ d")) THEN
    REPEAT CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [UNIONS_IMAGE, OPEN_IN_CLOSED_IN_EQ]) THEN
      REWRITE_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [],
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
      REWRITE_TAC [] THEN ASM SET_TAC [],
      STRIP_TAC THEN MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN
      ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
      ASM SET_TAC []])

  let SEPARATION_BY_CLOSED_INTERMEDIATES_GEN ← prove
   r"!(top:A topology) s.
        hereditarily normal_space top /\
        ~connected_in top (topspace top DIFF s)
        ==>  ?c. closed_in top c /\ c SUBSET s /\
                 !d. closed_in top d /\ c SUBSET d /\ d SUBSET s
                     ==> ~connected_in top (topspace top DIFF d)"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool", ← q r"2"]
      SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT) THEN
    REWRITE_TAC [← MESON [← HAS_SIZE_CONV (← q r"s HAS_SIZE 2")] (← q
     r"(?s. s HAS_SIZE 2 /\ P s) <=> (?a b. ~(a = b) /\ P{a,b})")] THEN
    REWRITE_TAC [PAIRWISE_INSERT, UNIONS_2, FORALL_IN_INSERT, NOT_IN_EMPTY,
                 IMP_CONJ, NOT_IN_EMPTY, PAIRWISE_EMPTY] THEN
    REWRITE_TAC [← MESON [SEPARATED_IN_SYM] (← q
     r"~(a = b) /\
      (~(b = a) ==> separated_in top a b /\ separated_in top b a) /\ Q <=>
      ~(a = b) /\ separated_in top a b /\ Q")] THEN
    REWRITE_TAC [← MESON [SEPARATED_IN_REFL] (← q
     r"~(a = b) /\ separated_in top a b /\
      (~(a = {}) /\ ~(b = {})) /\ a UNION b = s <=>
      a UNION b = s /\ ~(a = {}) /\ ~(b = {}) /\ separated_in top a b")] THEN
    REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED, IMP_IMP, SUBSET_DIFF] THEN
    SIMP_TAC [])

  let SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT ← prove
   r"!(top:A topology) s n.
        locally_connected_space top /\ hereditarily normal_space top
        ==> ((?u. u HAS_SIZE n /\
                  pairwise (separated_in top) u /\
                  (!t. t IN u ==> ~(t = {})) /\
                  UNIONS u = topspace top DIFF s) <=>
             (?c. closed_in top c /\ c SUBSET s /\
                  !d. closed_in top d /\ c SUBSET d /\ d SUBSET s
                      ==> ?u. u HAS_SIZE n /\
                              pairwise (separated_in top) u /\
                              (!t. t IN u ==> ~(t = {})) /\
                              UNIONS u = topspace top DIFF d))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
          SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT) THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"n = 0") THENL
     [ASM_REWRITE_TAC [HAS_SIZE_0, UNWIND_THM2, NOT_IN_EMPTY, UNIONS_0] THEN
      REWRITE_TAC [PAIRWISE_EMPTY] THEN SET_TAC [],
      ALL_TAC] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"c:A->bool") THEN
    REPLICATE_TAC 2 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (LABEL_TAC "*") THEN
    ABBREV_TAC
     (← q r"u = {d:A->bool | d IN connected_components_of
                             (subtopology top (topspace top DIFF c)) /\
                       ~(d DIFF s = {})}") THEN
    SUBGOAL_THEN (← q r"!t:A->bool. t IN u ==> open_in top t") ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      X_GEN_TAC (← q r"d:A->bool") THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE) o
       CONJUNCT1) THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_DIFF,
                    OPEN_IN_TOPSPACE] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      MATCH_MP_TAC LOCALLY_CONNECTED_SPACE_OPEN_SUBSET THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!t:A->bool. t IN u ==> ~(t = {})") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"pairwise DISJOINT (u:(A->bool)->bool)") ASSUME_TAC THENL
     [EXPAND_TAC "u" THEN MP_TAC (← ISPEC
       (← q r"subtopology top (topspace top DIFF c):A topology")
          PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] PAIRWISE_MONO) THEN
      REWRITE_TAC [SUBSET_RESTRICT],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"FINITE(u:(A->bool)->bool) /\ CARD u < n")
    STRIP_ASSUME_TAC THENL
     [ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
      REWRITE_TAC [NOT_LT] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CHOOSE_SUBSET_STRONG) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"?t:A->bool. t IN v") STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [MEMBER_NOT_EMPTY] THEN ASM_MESON_TAC [HAS_SIZE_0, HAS_SIZE],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"(topspace top DIFF s DIFF UNIONS (v DELETE t)) INSERT
        IMAGE (\d:A->bool. d DIFF s) (v DELETE t)")) THEN
      REWRITE_TAC [] THEN
      MATCH_MP_TAC (← TAUT
       (← q r"d /\ c /\ b /\ (b /\ c ==> a) ==> a /\ b /\ c /\ d")) THEN
      REPEAT CONJ_TAC THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [UNIONS_IMAGE, OPEN_IN_CLOSED_IN_EQ]) THEN
        REWRITE_TAC [UNIONS_IMAGE, UNIONS_INSERT] THEN ASM SET_TAC [],
        REWRITE_TAC [FORALL_IN_INSERT, FORALL_IN_IMAGE] THEN
        CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
        SUBGOAL_THEN (← q r"?a:A. a IN t /\ ~(a IN s)") STRIP_ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"a:A") THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
         [MP_TAC (← ISPEC (← q r"subtopology top (topspace top DIFF c:A->bool)")
           CONNECTED_COMPONENTS_OF_SUBSET) THEN
          REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
          ALL_TAC] THEN
        MP_TAC (← SPECL [← q r"v:(A->bool)->bool", ← q r"{t:A->bool}"]
          DIFF_UNIONS_PAIRWISE_DISJOINT) THEN
        ASM_REWRITE_TAC [SING_SUBSET, ← SET_RULE (← q r"s DIFF {a} = s DELETE a")] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
        REWRITE_TAC [pairwise] THEN ASM SET_TAC [],
        MATCH_MP_TAC PAIRWISE_IMP THEN EXISTS_TAC
         (← q r"separated_in (subtopology top (topspace top DIFF s):A topology)") THEN
        CONJ_TAC THENL [ALL_TAC, SIMP_TAC [SEPARATED_IN_SUBTOPOLOGY]] THEN
        MATCH_MP_TAC PAIRWISE_IMP THEN
        EXISTS_TAC (← q r"DISJOINT:(A->bool)->(A->bool)->bool") THEN CONJ_TAC THENL
         [REWRITE_TAC [PAIRWISE_INSERT, PAIRWISE_IMAGE] THEN
          REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, pairwise] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
          MATCH_MP_TAC (← MESON [] (← q
           r"!P. (!x y. P x /\ P y ==> (R x y <=> Q x y)) /\ (!x. x IN s ==> P x)
            ==> !x y. x IN s /\ y IN s /\ Q x y /\ ~(x = y) ==> R x y")) THEN
          EXISTS_TAC
           (← q r"open_in (subtopology top (topspace top DIFF s):A topology)") THEN
          REWRITE_TAC [SEPARATED_IN_OPEN_SETS, FORALL_IN_INSERT] THEN
          REWRITE_TAC [FORALL_IN_IMAGE] THEN CONJ_TAC THENL
           [REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, TOPSPACE_SUBTOPOLOGY] THEN
            SIMP_TAC [← SET_RULE (← q r"s INTER (s DIFF t) = s DIFF t"), SUBSET_DIFF] THEN
            REWRITE_TAC [← SET_RULE (← q r"s DIFF (s DIFF t) = s INTER t")] THEN
            SUBGOAL_THEN
             (← q r"closed_in (subtopology top (topspace top DIFF c))
                        (UNIONS(v DELETE (t:A->bool)))")
            MP_TAC THENL
             [MATCH_MP_TAC CLOSED_IN_UNIONS THEN CONJ_TAC THENL
               [ASM_MESON_TAC [FINITE_DELETE, HAS_SIZE], ALL_TAC] THEN
              X_GEN_TAC (← q r"t':A->bool") THEN STRIP_TAC THEN
              MATCH_MP_TAC CLOSED_IN_CONNECTED_COMPONENTS_OF THEN
              ASM SET_TAC [],
              REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN
              MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []],
            X_GEN_TAC (← q r"t':A->bool") THEN DISCH_TAC THEN
            REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN EXISTS_TAC (← q r"t':A->bool") THEN
            MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
            CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
            DISCH_THEN (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC []]],
        STRIP_TAC THEN
        FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← ARITH_RULE
         (← q r"~(n = 0) ==> n = SUC(n - 1)"))) THEN
        REWRITE_TAC [HAS_SIZE_CLAUSES] THEN MATCH_MP_TAC (← MESON [] (← q
         r"P s /\ Q a s ==> (?b t. P t /\ Q b t /\ a INSERT s = b INSERT t)")) THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC HAS_SIZE_IMAGE_INJ THEN CONJ_TAC THENL
           [RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN ASM SET_TAC [],
            RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
            ASM_SIMP_TAC [CARD_DELETE, HAS_SIZE, FINITE_DELETE]],
          REWRITE_TAC [← SET_RULE
           (← q r"~(y IN IMAGE f s) <=> !x. x IN s ==> ~(f x = y)")] THEN
          GEN_TAC THEN DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE
           (← q r"DISJOINT s t /\ ~(s = {}) ==> ~(s = t)")) THEN
          CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
          MATCH_MP_TAC SEPARATED_IN_IMP_DISJOINT THEN
          EXISTS_TAC (← q r"top:A topology") THEN
          RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
          FIRST_X_ASSUM MATCH_MP_TAC THEN ASM SET_TAC []]],
      ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"topspace top DIFF UNIONS u:A->bool")) THEN
    REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_DIFF THEN
      ASM_SIMP_TAC [OPEN_IN_UNIONS, CLOSED_IN_TOPSPACE],
      ASM_SIMP_TAC [CLOSED_IN_SUBSET, ← SET_RULE
       (← q r"c SUBSET u DIFF s <=> c SUBSET u /\ s INTER c = {}")] THEN
      REWRITE_TAC [INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
      EXPAND_TAC "u" THEN REWRITE_TAC [IN_ELIM_THM, IMP_CONJ] THEN GEN_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [],
      EXPAND_TAC "u" THEN REWRITE_TAC [UNIONS_GSPEC] THEN
      MP_TAC (← ISPEC (← q r"subtopology top (topspace top DIFF c):A topology")
          UNIONS_CONNECTED_COMPONENTS_OF) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
      ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET u ==> u DIFF (u DIFF s) = s"),
                    UNIONS_SUBSET, OPEN_IN_SUBSET] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:(A->bool)->bool") STRIP_ASSUME_TAC)] THEN
    SUBGOAL_THEN (← q r"(v:(A->bool)->bool) <=_c (u:(A->bool)->bool)") MP_TAC THENL
     [ALL_TAC,
      RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
      ASM_SIMP_TAC [CARD_LE_CARD, NOT_LE]] THEN
    MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\(u:A->bool) v. ~DISJOINT u v") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:A->bool", ← q r"c1:A->bool", ← q r"c2:A->bool"] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"c1:A->bool = c2") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"connected_in top (t:A->bool)") MP_TAC THENL
     [UNDISCH_TAC (← q r"(t:A->bool) IN u") THEN EXPAND_TAC "u" THEN
      REWRITE_TAC [IN_ELIM_THM, IMP_CONJ_ALT] THEN
      DISCH_THEN (K ALL_TAC : thm → tactic) THEN
      DISCH_THEN (MP_TAC o MATCH_MP CONNECTED_IN_CONNECTED_COMPONENTS_OF) THEN
      SIMP_TAC [CONNECTED_IN_SUBTOPOLOGY],
      REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET]] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"c1:A->bool", ← q r"UNIONS(v DELETE (c1:A->bool))"] THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_SIMP_TAC [SEPARATED_IN_UNIONS, FINITE_DELETE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
    REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC [separated_in])

  let SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_GEN ← prove
   r"!(top:A topology) s.
        locally_connected_space top /\ hereditarily normal_space top
        ==> (~connected_in top (topspace top DIFF s) <=>
             ?c. closed_in top c /\ c SUBSET s /\
                 !d. closed_in top d /\ c SUBSET d /\ d SUBSET s
                     ==> ~connected_in top (topspace top DIFF d))"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool", ← q r"2"]
      SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT) THEN
    REWRITE_TAC [← MESON [← HAS_SIZE_CONV (← q r"s HAS_SIZE 2")] (← q
     r"(?s. s HAS_SIZE 2 /\ P s) <=> (?a b. ~(a = b) /\ P{a,b})")] THEN
    REWRITE_TAC [PAIRWISE_INSERT, UNIONS_2, FORALL_IN_INSERT, NOT_IN_EMPTY,
                 IMP_CONJ, NOT_IN_EMPTY, PAIRWISE_EMPTY] THEN
    REWRITE_TAC [← MESON [SEPARATED_IN_SYM] (← q
     r"~(a = b) /\
      (~(b = a) ==> separated_in top a b /\ separated_in top b a) /\ Q <=>
      ~(a = b) /\ separated_in top a b /\ Q")] THEN
    REWRITE_TAC [← MESON [SEPARATED_IN_REFL] (← q
     r"~(a = b) /\ separated_in top a b /\
      (~(a = {}) /\ ~(b = {})) /\ a UNION b = s <=>
      a UNION b = s /\ ~(a = {}) /\ ~(b = {}) /\ separated_in top a b")] THEN
    REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED, IMP_IMP, SUBSET_DIFF] THEN
    SIMP_TAC [])

  let KURATOWSKI_COMPONENT_NUMBER_INVARIANCE ← do
    let lemma ← prove
     r"!(R:A->A->bool) (f:A->B->bool).
            (!s t. R s t ==> R t s)
            ==> ((!s t n. R s t ==> (f s HAS_SIZE n <=> f t HAS_SIZE n)) <=>
                 (!n s t. R s t ==> 1..n <=_c f s ==> 1..n <=_c f t))"
     (REPEAT STRIP_TAC THEN TRANS_TAC EQ_TRANS
       (← q r"!s t n. R s t ==> (1..n <=_c (f:A->B->bool) s <=> 1..n <=_c f t)") THEN
      CONJ_TAC THENL [POP_ASSUM (K ALL_TAC : thm → tactic), ASM_MESON_TAC []] THEN
      REWRITE_TAC [HAS_SIZE, NUMSEG_CARD_LE] THEN EQ_TAC THENL
       [MESON_TAC [],
        REWRITE_TAC [← ARITH_RULE (← q r"a = n <=> n <= a /\ ~(n + 1 <= a)")] THEN
        MESON_TAC []])
    let lemur ← prove
     r"pairwise (separated_in (subtopology top (topspace top DIFF s))) u /\
       (!t. t IN u ==> ~(t = {})) /\
       UNIONS u = topspace(subtopology top (topspace top DIFF s)) <=>
       pairwise (separated_in top) u /\
       (!t. t IN u ==> ~(t = {})) /\
       UNIONS u = topspace top DIFF s"
     (REWRITE_TAC [pairwise, SEPARATED_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
      SET_TAC [])
    prove
     r"!top:A topology.
        compact_space top /\
        hausdorff_space top /\
        locally_connected_space top /\
        hereditarily normal_space top
        ==> ((!s t n.
                closed_in top s /\ closed_in top t /\
                (subtopology top s) homeomorphic_space (subtopology top t)
                ==> (connected_components_of
                      (subtopology top (topspace top DIFF s)) HAS_SIZE n <=>
                     connected_components_of
                      (subtopology top (topspace top DIFF t)) HAS_SIZE n)) <=>
             (!s t n.
                (subtopology top s) homeomorphic_space (subtopology top t)
                ==> (connected_components_of
                      (subtopology top (topspace top DIFF s)) HAS_SIZE n <=>
                     connected_components_of
                      (subtopology top (topspace top DIFF t)) HAS_SIZE n)))"
     (REPEAT STRIP_TAC THEN EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma o lhand o snd) THEN ANTS_TAC THENL
       [MESON_TAC [HOMEOMORPHIC_SPACE_SYM], DISCH_THEN SUBST1_TAC] THEN
      W (MP_TAC o PART_MATCH (lhand o rand) lemma o rand o snd) THEN ANTS_TAC THENL
       [MESON_TAC [HOMEOMORPHIC_SPACE_SYM], DISCH_THEN SUBST1_TAC] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [CARD_LE_CONNECTED_COMPONENTS_ALT] THEN
      ASM_CASES_TAC (← q r"n = 0") THEN ASM_REWRITE_TAC [lemur] THEN DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
      ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN
      ONCE_REWRITE_TAC [← SET_RULE (← q r"s DIFF t = s DIFF s INTER t")] THEN
      MP_TAC (← SET_RULE
       (← q r"topspace top INTER (s:A->bool) SUBSET topspace top /\
        topspace top INTER (t:A->bool) SUBSET topspace top")) THEN
      SPEC_TAC (← q r"topspace top INTER (t:A->bool)", ← q r"t:A->bool") THEN
      SPEC_TAC (← q r"topspace top INTER (s:A->bool)", ← q r"s:A->bool") THEN
      REPEAT GEN_TAC THEN STRIP_TAC THEN DISCH_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT o lhand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand)
        SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT o rand o snd) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic_space]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHIC_MAPS_MAP] THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:A->A", ← q r"g:A->A"] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"c:A->bool") THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      DISCH_THEN (LABEL_TAC "*") THEN EXISTS_TAC (← q r"IMAGE (f:A->A) c") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC (← q r"subtopology top (s:A->bool)") THEN
        ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, CLOSED_IN_COMPACT_SPACE] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP,
                                      CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
        ASM_REWRITE_TAC [],
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP,
                                      CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_SUBTOPOLOGY]) THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"d':A->bool") THEN STRIP_TAC] THEN
      ABBREV_TAC (← q r"d = IMAGE (g:A->A) d'") THEN
      SUBGOAL_THEN (← q r"closed_in top (d:A->bool)") ASSUME_TAC THENL
       [MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "d" THEN MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC (← q r"subtopology top (t:A->bool)") THEN
        ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, CLOSED_IN_COMPACT_SPACE] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP,
                                      CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
        ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(c:A->bool) SUBSET d /\ d SUBSET s") STRIP_ASSUME_TAC THENL
       [EXPAND_TAC "d" THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP,
                                      CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_SUBTOPOLOGY]) THEN
        ASM SET_TAC [],
        ALL_TAC] THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"d:A->bool")) THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [homeomorphic_space] THEN
      MAP_EVERY EXISTS_TAC [← q r"f:A->A", ← q r"g:A->A"] THEN
      SUBGOAL_THEN
       (← q r"subtopology top d:A topology = subtopology (subtopology top s) d /\
        subtopology top d':A topology = subtopology (subtopology top t) d'")
      (CONJUNCTS_THEN SUBST1_TAC) THENL
       [REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
        CONJ_TAC THEN AP_TERM_TAC THEN ASM SET_TAC [],
        MATCH_MP_TAC HOMEOMORPHIC_MAPS_SUBTOPOLOGIES] THEN
      ASM_REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP] THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP,
                                    CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_SUBTOPOLOGY]) THEN
      ASM SET_TAC [])

  return { SEPARATION_BY_CLOSED_INTERMEDIATES_COUNT, SEPARATION_BY_CLOSED_INTERMEDIATES_GEN,
           SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_COUNT,
           SEPARATION_BY_CLOSED_INTERMEDIATES_EQ_GEN,
           KURATOWSKI_COMPONENT_NUMBER_INVARIANCE }

end HolMultiLib.Metric
