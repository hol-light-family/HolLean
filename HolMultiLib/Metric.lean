structure Urysohn2 where
  URYSOHN_LEMMA_ALT : thm
  NORMAL_SPACE_EQ_URYSOHN_GEN_ALT : thm
  NORMAL_SPACE_EQ_URYSOHN_GEN : thm
  NORMAL_SPACE_EQ_URYSOHN_ALT : thm
  NORMAL_SPACE_EQ_URYSOHN : thm
  TIETZE_EXTENSION_CLOSED_REAL_INTERVAL : thm
  deriving Inhabited

@[nospecialize]
def setupUrysohn2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BNets : Nets)
    (BSequential : Sequential) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BMetricLim : MetricLim)
    (BMCompact3 : MCompact3) (BMetricCont : MetricCont) (BRealCont : RealCont)
    (BNormal1 : Normal1) (BUrysohn : Urysohn) : ExceptT String IO Urysohn2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC,
        REAL_ARITH, REAL_ARITH_TAC, SET_RULE, REAL_RAT_REDUCE_CONV, .. } := D
  let { ADD1, CONJ_ASSOC, DEPENDENT_CHOICE, DISJOINT, DISJOINT_SYM, EXTENSION, FINITE_NUMSEG,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_ELIM_THM, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        MONO_FORALL, NOT_IN_EMPTY, REAL_ABS_BOUNDS, REAL_ABS_NUM, .. } := D.core2
  let { REAL_ABS_SUB, REAL_ADD_SUB, REAL_LET_TRANS, REAL_LE_REFL, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_IMP_LE, REAL_LT_IMP_NE, REAL_LT_MUL, REAL_LT_RDIV_EQ, REAL_MUL_RID,
        REAL_POW_LE, REAL_POW_LT, .. } := D.core3
  let { REAL_SUB_REFL, REAL_SUB_RZERO, REAL_WLOG_LE, RIGHT_IMP_FORALL_THM, SUBSET, SUM_ABS_LE,
        SUM_DIFFS_ALT, SUM_LMUL, SUM_RMUL, SWAP_FORALL_THM, WLOG_LT, real_div, real_pow,
        .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, SUM_GP, .. } := D.misc
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_TRANS_FULL, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { EVENTUALLY_MONO, EVENTUALLY_TRUE, .. } := BNets
  let { ARCH_EVENTUALLY_POW_INV, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } :=
    BSequential
  let { CENTRE_IN_MBALL_EQ, mball, .. } := BMetricSpace
  let { OPEN_IN_MBALL, .. } := BMTopology
  let { REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_METRIC, LIMIT_METRIC_UNIQUE, .. } := BMetricLim
  let { MCOMPLETE_REAL_EUCLIDEAN_METRIC, .. } := BMCompact3
  let { CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT, .. } := BMetricCont
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_MAX,
        CONTINUOUS_MAP_REAL_MIN, CONTINUOUS_MAP_REAL_SUB, .. } := BRealCont
  let { normal_space, .. } := BNormal1
  let { URYSOHN_LEMMA, .. } := BUrysohn
  -- @@SCOPE END

  let URYSOHN_LEMMA_ALT ← prove
   r"!(top:A topology) s t a b.
        normal_space top /\ closed_in top s /\ closed_in top t /\ DISJOINT s t
        ==> ?f. continuous_map(top,euclideanreal) f /\
                (!x. x IN s ==> f x = a) /\
                (!x. x IN t ==> f x = b)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [← MESON [] (← q
     r"(!s t a b. P s t a b) <=> (!a b s t. P s t a b)")] THEN
    MATCH_MP_TAC REAL_WLOG_LE THEN CONJ_TAC THENL
     [REPEAT GEN_TAC THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
      REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN MESON_TAC [DISJOINT_SYM],
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN REPEAT GEN_TAC THEN
      DISCH_THEN (MP_TAC o MATCH_MP URYSOHN_LEMMA) THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN MESON_TAC []])

  let NORMAL_SPACE_EQ_URYSOHN_GEN_ALT ← prove
   r"!top:A topology a b.
     ~(a = b)
     ==> (normal_space top <=>
          !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
                ==> ?f. continuous_map (top,euclideanreal) f /\
                        (!x. x IN s ==> f x = a) /\
                        (!x. x IN t ==> f x = b))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [URYSOHN_LEMMA_ALT] THEN
    REWRITE_TAC [normal_space] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:A->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"t:A->bool") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x:A | x IN topspace top /\
              f x IN mball real_euclidean_metric (a,abs(a - b) / &2)}",
      ← q r"{x:A | x IN topspace top /\
              f x IN mball real_euclidean_metric (b,abs(a - b) / &2)}"] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [OPEN_IN_MBALL, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC],
      ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [SUBSET, IN_ELIM_THM, CENTRE_IN_MBALL_EQ] THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < abs(a - b) / &2 <=> ~(a = b)")] THEN
        REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
        ASM_SIMP_TAC [← GSYM SUBSET, CLOSED_IN_SUBSET],
        SIMP_TAC [EXTENSION, DISJOINT, IN_INTER, NOT_IN_EMPTY, IN_ELIM_THM,
                  mball, REAL_EUCLIDEAN_METRIC] THEN
        REAL_ARITH_TAC]])

  let NORMAL_SPACE_EQ_URYSOHN_GEN ← prove
   r"!top:A topology a b.
     a < b
     ==> (normal_space top <=>
          !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
                ==> ?f. continuous_map
                         (top,
                          subtopology euclideanreal (real_interval[a,b])) f /\
                        (!x. x IN s ==> f x = a) /\
                        (!x. x IN t ==> f x = b))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [URYSOHN_LEMMA, REAL_LT_IMP_LE] THEN
    ASM_SIMP_TAC [NORMAL_SPACE_EQ_URYSOHN_GEN_ALT, REAL_LT_IMP_NE] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN MESON_TAC [])

  let NORMAL_SPACE_EQ_URYSOHN_ALT ← prove
   r"!top:A topology.
     normal_space top <=>
     !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
           ==> ?f. continuous_map (top,euclideanreal) f /\
                   (!x. x IN s ==> f x = &0) /\
                   (!x. x IN t ==> f x = &1)"
   (GEN_TAC THEN MATCH_MP_TAC NORMAL_SPACE_EQ_URYSOHN_GEN_ALT THEN
    CONV_TAC REAL_RAT_REDUCE_CONV)

  let NORMAL_SPACE_EQ_URYSOHN ← prove
   r"!top:A topology.
     normal_space top <=>
     !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
           ==> ?f. continuous_map
                    (top,subtopology euclideanreal (real_interval[&0,&1])) f /\
                   (!x. x IN s ==> f x = &0) /\
                   (!x. x IN t ==> f x = &1)"
   (GEN_TAC THEN MATCH_MP_TAC NORMAL_SPACE_EQ_URYSOHN_GEN THEN
    REWRITE_TAC [REAL_LT_01])

  let TIETZE_EXTENSION_CLOSED_REAL_INTERVAL ← prove
   r"!top f:A->real s a b.
        normal_space top /\ closed_in top s /\ a <= b /\
        continuous_map (subtopology top s,euclideanreal) f /\
        (!x. x IN s ==> f x IN real_interval[a,b])
        ==> ?g. continuous_map(top,euclideanreal) g /\
                (!x. x IN topspace top ==> g x IN real_interval[a,b]) /\
                (!x. x IN s ==> g x = f x)"
   (REWRITE_TAC [IN_REAL_INTERVAL] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?c. &0 < c /\ !x. x IN s ==> abs((f:A->real) x) <= c")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC (← q r"max (abs a) (abs b) + &1") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q
       r"a <= x /\ x <= b ==> abs x <= max (abs a) (abs b) + &1")] THEN
      REAL_ARITH_TAC,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?g:num->A->real.
          (!n. continuous_map(top,euclideanreal) (g n) /\
               !x. x IN s ==> abs(f x - g n x) <= c * (&2 / &3) pow n) /\
          (!n x. x IN topspace top
                 ==> abs(g(SUC n) x - g n x) <= c * (&2 / &3) pow n / &3)")
    MP_TAC THENL
     [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
       [EXISTS_TAC (← q r"(\x. &0):A->real") THEN
        REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
        ASM_REWRITE_TAC [real_pow, REAL_MUL_RID, REAL_SUB_RZERO],
        MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"h:A->real"] THEN STRIP_TAC] THEN
      MP_TAC (← ISPECL
       [← q r"top:A topology",
        ← q r"{x | x IN s /\ ((f:A->real) x - h x) IN
                        {y | y <= --(c / &3 * (&2 / &3) pow n)}}",
        ← q r"{x | x IN s /\ ((f:A->real) x - h x) IN
                        {y | y >= c / &3 * (&2 / &3) pow n}}",
        ← q r"--(c / &3 * (&2 / &3) pow n)", ← q r"c / &3 * (&2 / &3) pow n"]
       URYSOHN_LEMMA) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"--(c / &3 * x) <= c / &3 * x <=> &0 <= c * x")] THEN
      SUBGOAL_THEN (← q r"&0 < c * (&2 / &3) pow n") ASSUME_TAC THENL
       [MATCH_MP_TAC REAL_LT_MUL THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC REAL_POW_LT THEN CONV_TAC REAL_RAT_REDUCE_CONV,
        ASM_SIMP_TAC [REAL_LT_IMP_LE]] THEN
      ANTS_TAC THENL
       [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
         [SUBGOAL_THEN (← q r"s:A->bool = topspace(subtopology top s)") SUBST1_TAC THENL
           [ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, CLOSED_IN_SUBSET,
                          ← SET_RULE (← q r"s = u INTER s <=> s SUBSET u")],
            CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_TRANS_FULL THEN
            EXISTS_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [] THEN
            MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
            EXISTS_TAC (← q r"euclideanreal") THEN
            ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_SUB, ← GSYM REAL_CLOSED_IN,
                          CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
            REWRITE_TAC [REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_HALFSPACE_GE]],
          SIMP_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY, IN_ELIM_THM] THEN
          ASM_REAL_ARITH_TAC],
        REWRITE_TAC [IN_ELIM_THM, LEFT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
        REWRITE_TAC [IN_REAL_INTERVAL, ← GSYM REAL_ABS_BOUNDS, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"g:A->real") THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"\x. h x + (g:A->real) x") THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, REAL_ADD_SUB] THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"x * y / &3 = x / &3 * y")] THEN
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN REWRITE_TAC [real_pow] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A"))) THEN
        FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
        ASM_SIMP_TAC [SUBSET] THEN ASM_REAL_ARITH_TAC],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, FORALL_AND_THM]] THEN
    X_GEN_TAC (← q r"g:num->A->real") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"real_euclidean_metric", ← q r"g:num->A->real"]
     CONTINUOUS_MAP_UNIFORMLY_CAUCHY_LIMIT) THEN
    ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                     EVENTUALLY_TRUE, MCOMPLETE_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN ANTS_TAC THENL
     [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"&2 / &3", ← q r"e / c:real"] ARCH_EVENTUALLY_POW_INV) THEN
      CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN MATCH_MP_TAC WLOG_LT THEN
      ASM_REWRITE_TAC [REAL_SUB_REFL, REAL_ABS_NUM] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [REAL_ABS_SUB], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      TRANS_TAC REAL_LET_TRANS
       (← q r"abs(sum(m..n - 1) (\n. g (SUC n) (x:A) - g n x))") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [SUM_DIFFS_ALT, ADD1] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP (← ARITH_RULE (← q
         r"m < n ==> m <= n - 1 /\ n - 1 + 1 = n"))) THEN
        SIMP_TAC [REAL_LE_REFL],
        TRANS_TAC REAL_LET_TRANS
         (← q r"sum (m..n-1) (\j. c * (&2 / &3) pow j / &3)") THEN
        ASM_SIMP_TAC [SUM_ABS_LE, FINITE_NUMSEG] THEN
        REWRITE_TAC [real_div, SUM_LMUL, SUM_RMUL, SUM_GP] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        COND_CASES_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        REWRITE_TAC [← REAL_ARITH (← q r"c * (x * &3) * &1 / &3 = x * c")] THEN
        ASM_SIMP_TAC [← GSYM REAL_LT_RDIV_EQ] THEN
        MATCH_MP_TAC (← REAL_ARITH (← q r"abs x < y /\ &0 <= z ==> x - z < y")) THEN
        ASM_SIMP_TAC [] THEN MATCH_MP_TAC REAL_POW_LE THEN
        CONV_TAC REAL_RAT_REDUCE_CONV],
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:A->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"\x. max a (min ((h:A->real) x) b)") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_MAX, CONTINUOUS_MAP_REAL_MIN,
                    CONTINUOUS_MAP_REAL_CONST] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q
       r"a <= x /\ x <= b /\ y = x ==> max a (min y b) = x")) THEN
      ASM_SIMP_TAC [] THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIMIT_METRIC_UNIQUE) THEN
      MAP_EVERY EXISTS_TAC
       [← q r"real_euclidean_metric", ← q r"\n. (g:num->A->real) n x"] THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, LIMIT_METRIC] THEN
      REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      REWRITE_TAC [SUBSET] THEN DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN CONJ_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        ASM_SIMP_TAC [],
        MP_TAC (← ISPECL [← q r"&2 / &3", ← q r"e / c:real"] ARCH_EVENTUALLY_POW_INV) THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_SIMP_TAC [REAL_LT_DIV] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        ASM_SIMP_TAC [REAL_LT_RDIV_EQ] THEN X_GEN_TAC (← q r"n:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
        REWRITE_TAC [← REAL_ARITH (← q
         r"abs x * c = c * (if &0 <= x then x else --x)")] THEN
        ASM_SIMP_TAC [REAL_POW_LE, ← REAL_ARITH (← q r"&0 <= &2 / &3")]]])

  return { URYSOHN_LEMMA_ALT, NORMAL_SPACE_EQ_URYSOHN_GEN_ALT, NORMAL_SPACE_EQ_URYSOHN_GEN,
           NORMAL_SPACE_EQ_URYSOHN_ALT, NORMAL_SPACE_EQ_URYSOHN,
           TIETZE_EXTENSION_CLOSED_REAL_INTERVAL }

/- ------------------------------------------------------------------------- -/
/- The Tietze extension theorem.  (metric.ml 24870-25015)                    -/
/- ------------------------------------------------------------------------- -/

structure Tietze where
  TIETZE_EXTENSION_REALINTERVAL : thm
  NORMAL_SPACE_EQ_TIETZE : thm
  deriving Inhabited

@[nospecialize]
def setupTietze [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BBounded : Bounded) (BRealTop1 : RealTop1)
    (BRealTop2 : RealTop2) (BRealConn1 : RealConn1) (BRealConn2 : RealConn2)
    (BRealCont : RealCont) (BUrysohn : Urysohn) (BUrysohn2 : Urysohn2) :
    ExceptT String IO Tietze := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { COND_RAND, COND_RATOR, CONJ_ASSOC, EMPTY_GSPEC, ETA_AX, FINITE_EMPTY, FINITE_INSERT,
        FINITE_SUBSET, FORALL_IN_IMAGE, FORALL_IN_UNION, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, IN_DIFF, IN_ELIM_THM, IN_GSPEC, IN_INTER, IN_UNION, IN_UNIV,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, REAL_ABS_MUL, REAL_ABS_NEG, .. } := D.core2
  let { REAL_ABS_POS, REAL_ADD_RID, REAL_ADD_SUB, REAL_BOUNDS_LT, REAL_GROW_SHRINK,
        REAL_LE_RMUL, REAL_MUL_LID, REAL_MUL_LZERO, REAL_POS, .. } := D.core3
  let { REAL_SHRINK_RANGE, SUBSET, SUBSET_UNIV, SWAP_FORALL_THM, UNION_EMPTY, UNIV_NOT_EMPTY,
        o_DEF, o_THM, .. } := D.core4
  let { COND_EXPAND, .. } := D.core5
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_SHRINK, IS_REALINTERVAL_UNIV,
        REAL_INTERVAL_NE_EMPTY, REAL_INTERVAL_OPEN_SUBSET_CLOSED, REAL_OPEN_CLOSED_INTERVAL,
        is_realinterval, .. } := D.misc
  let { CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, CLOSED_IN_UNION, .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ_EMPTY, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_CLOSED_IN, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { FINITE_IMP_COMPACT_IN, .. } := BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN, .. } := BHausdorff1
  let { MBOUNDED_CLOSURE_OF, .. } := BBounded
  let { REAL_CLOSED_IN, REAL_OPEN_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { MBOUNDED_REAL_EUCLIDEAN_METRIC, REAL_BOUNDED_SHRINK, .. } := BRealConn1
  let { IS_REALINTERVAL_CLOSURE_OF, REAL_COMPACT_EQ_BOUNDED_CLOSED,
        REAL_COMPACT_IS_REALINTERVAL, REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT, .. } :=
    BRealConn2
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_GROW,
        CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_SHRINK, CONTINUOUS_MAP_REAL_SUB,
        .. } := BRealCont
  let { URYSOHN_LEMMA, .. } := BUrysohn
  let { NORMAL_SPACE_EQ_URYSOHN_ALT, TIETZE_EXTENSION_CLOSED_REAL_INTERVAL, .. } := BUrysohn2
  -- @@SCOPE END

  let TIETZE_EXTENSION_REALINTERVAL ← prove
   r"!top f:A->real s t.
        normal_space top /\ closed_in top s /\
        is_realinterval t /\ ~(t = {}) /\
        continuous_map (subtopology top s,euclideanreal) f /\
        (!x. x IN s ==> f x IN t)
        ==> ?g. continuous_map(top,euclideanreal) g /\
                (!x. x IN topspace top ==> g x IN t) /\
                (!x. x IN s ==> g x = f x)"
   (GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN
    GEN_TAC THEN GEN_REWRITE_TAC id [SWAP_FORALL_THM] THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"((!t. real_bounded t ==> P t) ==> (!t. P t)) /\
      (!t. real_bounded t ==> P t)
      ==> !t. P t")) THEN
    CONJ_TAC THENL
     [DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"t:real->bool", ← q r"f:A->real"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (\x. x / (&1 + abs x)) t")) THEN
      ASM_REWRITE_TAC [IS_REALINTERVAL_SHRINK, REAL_BOUNDED_SHRINK] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"(\x. x / (&1 + abs x)) o (f:A->real)")) THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN ANTS_TAC THENL
       [CONJ_TAC THENL [ALL_TAC, REWRITE_TAC [o_DEF] THEN ASM SET_TAC []] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CONTINUOUS_MAP_COMPOSE)) THEN
        REWRITE_TAC [← REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY]
          CONTINUOUS_MAP_REAL_SHRINK],

        DISCH_THEN (X_CHOOSE_THEN (← q r"g:A->real") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(\x. x / (&1 - abs x)) o (g:A->real)") THEN
        ASM_SIMP_TAC [o_THM, REAL_GROW_SHRINK] THEN CONJ_TAC THENL
         [MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
          EXISTS_TAC (← q r"subtopology euclideanreal (real_interval(-- &1,&1))") THEN
          REWRITE_TAC [CONTINUOUS_MAP_REAL_GROW] THEN
          ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
           r"(!x. x IN t ==> g x IN IMAGE h u) ==> (!x. x IN u ==> h x IN v)
            ==> IMAGE g t SUBSET v"))) THEN
          REWRITE_TAC [IN_REAL_INTERVAL, REAL_BOUNDS_LT, REAL_SHRINK_RANGE],
          FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
           r"(!x. x IN u ==> g x IN IMAGE h t)
            ==> (!x. x IN t ==> f(h x) = x)
                ==> (!x. x IN u ==> f(g x) IN t)"))) THEN
          REWRITE_TAC [REAL_GROW_SHRINK]]],
      X_GEN_TAC (← q r"t:real->bool") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC] THEN
    MP_TAC (← SPEC (← q r"euclideanreal closure_of t") REAL_COMPACT_IS_REALINTERVAL) THEN
    ASM_SIMP_TAC [IS_REALINTERVAL_CLOSURE_OF] THEN
    REWRITE_TAC [REAL_COMPACT_EQ_BOUNDED_CLOSED, REAL_CLOSED_IN] THEN
    REWRITE_TAC [CLOSED_IN_CLOSURE_OF, ← GSYM MBOUNDED_REAL_EUCLIDEAN_METRIC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← SYM MBOUNDED_REAL_EUCLIDEAN_METRIC]) THEN
    ASM_SIMP_TAC [MBOUNDED_CLOSURE_OF, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN
    ASM_CASES_TAC (← q r"real_interval[a,b] = {}") THEN
    ASM_SIMP_TAC [CLOSURE_OF_EQ_EMPTY, TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [REAL_INTERVAL_NE_EMPTY]) THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"f:A->real", ← q r"s:A->bool",
                      ← q r"a:real", ← q r"b:real"]
          TIETZE_EXTENSION_CLOSED_REAL_INTERVAL) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET, IN_UNIV, TOPSPACE_EUCLIDEANREAL],
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:A->real") STRIP_ASSUME_TAC)] THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology",
      ← q r"{x | x IN topspace top /\
            (g:A->real) x IN euclideanreal closure_of t DIFF t}",
      ← q r"s:A->bool", ← q r"&0", ← q r"&1"] URYSOHN_LEMMA) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, REAL_POS] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN
      REWRITE_TAC [HAUSDORFF_SPACE_EUCLIDEANREAL] THEN
      MATCH_MP_TAC FINITE_IMP_COMPACT_IN THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL, SUBSET_UNIV] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{a:real,b}") THEN
      REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY] THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s DIFF u SUBSET t ==> s DIFF t SUBSET u")) THEN
      REWRITE_TAC [← GSYM REAL_OPEN_CLOSED_INTERVAL] THEN
      ASM_SIMP_TAC [← GSYM REAL_OPEN_SUBSET_CLOSURE_OF_REALINTERVAL_ALT,
                    REAL_OPEN_REAL_INTERVAL, REAL_INTERVAL_OPEN_SUBSET_CLOSED],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"h:A->real") THEN
      REWRITE_TAC [IN_REAL_INTERVAL, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:real")) THEN
      EXISTS_TAC (← q r"\x. z + (h:A->real) x * (g x - z)") THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"z + &1 * (x - z) = x")] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_SUB,
        CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_CONST, ETA_AX] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"(g:A->real) x IN t") THEN
      ASM_SIMP_TAC [REAL_MUL_LZERO, REAL_ADD_RID] THEN
      SUBGOAL_THEN
       (← q r"z <= z + h x * (g x - z) /\ z + h x * ((g:A->real) x - z) <= g x \/
        g x <= z + h x * (g x - z) /\ z + h x * (g x - z) <= z")
      MP_TAC THENL [ALL_TAC, ASM_MESON_TAC [is_realinterval]] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q
       r"abs(x - a) <= abs(b - a) /\ abs(x - b) <= abs(b - a)
        ==> a <= x /\ x <= b \/ b <= x /\ x <= a")) THEN
      REWRITE_TAC [← REAL_ARITH (← q r"(z + h * (g - z)) - g = --(&1 - h) * (g - z)")] THEN
      REWRITE_TAC [REAL_ADD_SUB, REAL_ABS_MUL, REAL_ABS_NEG] THEN
      CONJ_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
      MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q
       r"&0 <= x /\ x <= &1 ==> abs x <= &1 /\ abs(&1 - x) <= &1")]])

  let NORMAL_SPACE_EQ_TIETZE ← prove
   r"!top:A topology.
        normal_space top <=>
        !f s. closed_in top s /\
              continuous_map (subtopology top s,euclideanreal) f
              ==> ?g. continuous_map(top,euclideanreal) g /\
                      !x. x IN s ==> g x = f x"
   (GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"f:A->real", ← q r"s:A->bool",
                        ← q r"(:real)"]
          TIETZE_EXTENSION_REALINTERVAL) THEN
      ASM_REWRITE_TAC [IS_REALINTERVAL_UNIV, IN_UNIV, UNIV_NOT_EMPTY],
      DISCH_TAC THEN REWRITE_TAC [NORMAL_SPACE_EQ_URYSOHN_ALT] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"(\x. if x IN s then &0 else &1):A->real", ← q r"s UNION t:A->bool"]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [← SET_RULE (← q
       r"DISJOINT s t <=> !x. x IN t ==> ~(x IN s)")]) THEN
      ASM_SIMP_TAC [CLOSED_IN_UNION, FORALL_IN_UNION] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      X_GEN_TAC (← q r"c:real->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
      REWRITE_TAC [IN_INTER, ← GSYM CONJ_ASSOC] THEN
      ONCE_REWRITE_TAC [COND_RAND] THEN SIMP_TAC [IN_UNION] THEN
      ASM_SIMP_TAC [COND_EXPAND, ← TAUT (← q
       r"(q ==> ~p) ==> ((~p \/ z) /\ (p \/ q /\ w) <=> p /\ z \/ q /\ w)")] THEN
      ASM_SIMP_TAC [CLOSED_IN_SUBSET, ← SET_RULE (← q
       r"s SUBSET u /\ t SUBSET u
        ==> {x | x IN u /\ (x IN s /\ P \/ x IN t /\ Q)} =
            {x | x IN s /\ P} UNION {x | x IN t /\ Q}")] THEN
      MAP_EVERY ASM_CASES_TAC [← q r"(&0:real) IN c", ← q r"(&1:real) IN c"] THEN
      ASM_REWRITE_TAC [EMPTY_GSPEC, CLOSED_IN_EMPTY, UNION_EMPTY, IN_GSPEC] THEN
      ASM_SIMP_TAC [CLOSED_IN_UNION]])

  return { TIETZE_EXTENSION_REALINTERVAL, NORMAL_SPACE_EQ_TIETZE }

/- ------------------------------------------------------------------------- -/
/- Normal spaces, continued.  (metric.ml 25017-25154)                        -/
/- ------------------------------------------------------------------------- -/

structure Normal3 where
  NORMAL_SPACE_PERFECT_MAP_IMAGE : thm
  HAUSDORFF_NORMAL_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : thm
  NORMAL_HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : thm
  REGULAR_LINDELOF_IMP_NORMAL_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupNormal3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BT1b : T1b) (BHausdorff1 : Hausdorff1) (BProper1 : Proper1) (BPerfect : Perfect)
    (BLindelof : Lindelof) (BRegular1 : Regular1) (BNormal1 : Normal1) (BNormal2 : Normal2) :
    ExceptT String IO Normal3 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DISJOINT_SYM, EXISTS_IN_GSPEC, FINITE_IMAGE, FINITE_NUMSEG_LE,
        FINITE_NUMSEG_LT, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_DIFF, IN_UNIV, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_EMPTY, UNIONS_0, UNIONS_GSPEC,
        UNIONS_IMAGE, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { COUNTABLE_AS_IMAGE, .. } := D.lib
  let { CLOSED_IN_SUBSET, CLOSED_IN_UNIONS, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, .. } := BClosure
  let { T1_SPACE_CLOSED_MAP_IMAGE, .. } := BT1b
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY, LINDELOF_SPACE_SUBTOPOLOGY_SUBSET, .. } :=
    BLindelof
  let { REGULAR_SPACE, .. } := BRegular1
  let { NORMAL_T1_IMP_HAUSDORFF_SPACE, normal_space, .. } := BNormal1
  let { NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE, .. } := BNormal2
  -- @@SCOPE END

  let NORMAL_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    normal_space top /\ perfect_map(top,top') f ==> normal_space top'"
   (REWRITE_TAC [perfect_map, proper_map] THEN
    MESON_TAC [NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE])

  let HAUSDORFF_NORMAL_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        normal_space top /\
        closed_map (top,top') f /\
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        t1_space top'
        ==> hausdorff_space top'"
   (MESON_TAC [NORMAL_T1_IMP_HAUSDORFF_SPACE,
               NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE])

  let NORMAL_HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        normal_space top /\
        hausdorff_space top /\
        closed_map (top,top') f /\
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> normal_space top' /\ hausdorff_space top'"
   (MESON_TAC [NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE,
               NORMAL_T1_IMP_HAUSDORFF_SPACE,
               T1_SPACE_CLOSED_MAP_IMAGE, HAUSDORFF_IMP_T1_SPACE])

  let REGULAR_LINDELOF_IMP_NORMAL_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ lindelof_space top ==> normal_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [normal_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"{}:A->bool", ← q r"topspace top:A->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY, CLOSED_IN_SUBSET] THEN
      SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"t:A->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"topspace top:A->bool", ← q r"{}:A->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY, CLOSED_IN_SUBSET] THEN
      SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?h:num->A->bool.
          (!n. open_in top (h n)) /\
          (!n. DISJOINT t (top closure_of (h n))) /\
          s SUBSET UNIONS (IMAGE h (:num))")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!x. x IN s
            ==> ?u. open_in top u /\ (x:A) IN u /\
                    DISJOINT t (top closure_of u)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [REGULAR_SPACE]) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET], ASM SET_TAC []],
        GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"h:A->A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"lindelof_space(subtopology top (s:A->bool))") MP_TAC THENL
       [ASM_SIMP_TAC [LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY],
        ASM_SIMP_TAC [LINDELOF_SPACE_SUBTOPOLOGY_SUBSET, CLOSED_IN_SUBSET]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (h:A->A->bool) s")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"U:(A->bool)->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q r"U:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [UNIONS_0, SUBSET_EMPTY] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"U:(A->bool)->bool") COUNTABLE_AS_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      GEN_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?k:num->A->bool.
          (!n. open_in top (k n)) /\
          (!n. DISJOINT s (top closure_of (k n))) /\
          t SUBSET UNIONS (IMAGE k (:num))")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN
       (← q r"!x. x IN t
            ==> ?u. open_in top u /\ (x:A) IN u /\
                    DISJOINT s (top closure_of u)")
      MP_TAC THENL
       [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [REGULAR_SPACE]) THEN
        ASM_REWRITE_TAC [IN_DIFF] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET], ASM SET_TAC []],
        GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:A->A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"lindelof_space(subtopology top (t:A->bool))") MP_TAC THENL
       [ASM_SIMP_TAC [LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY],
        ASM_SIMP_TAC [LINDELOF_SPACE_SUBTOPOLOGY_SUBSET, CLOSED_IN_SUBSET]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (k:A->A->bool) t")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"U:(A->bool)->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q r"U:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [UNIONS_0, SUBSET_EMPTY] THEN STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"U:(A->bool)->bool") COUNTABLE_AS_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
      GEN_TAC THEN DISCH_THEN SUBST_ALL_TAC THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC
     [← q r"UNIONS (IMAGE (\i. h i DIFF UNIONS {top closure_of (k j) | j < i})
                     (:num)):A->bool",
      ← q r"UNIONS (IMAGE (\i. k i DIFF UNIONS {top closure_of (h j) | j <= i})
                     (:num)):A->bool"] THEN
    REWRITE_TAC [] THEN GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
      X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSED_IN_UNIONS THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
      SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT, FINITE_NUMSEG_LE] THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, CLOSED_IN_CLOSURE_OF],
      ALL_TAC] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_IMAGE, UNIONS_GSPEC] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q
     r"DISJOINT (UNIONS u) (UNIONS v) <=>
      !s. s IN u ==> !t. t IN v ==> DISJOINT s t")] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
    DISJ_CASES_TAC (← ARITH_RULE (← q r"n:num < m \/ m <= n")) THENL
     [ALL_TAC, ONCE_REWRITE_TAC [DISJOINT_SYM]] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"(?i. i IN f /\ k SUBSET i)
      ==> DISJOINT (h DIFF UNIONS f) (k DIFF u)")) THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THENL
     [EXISTS_TAC (← q r"n:num"), EXISTS_TAC (← q r"m:num")] THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSURE_OF_SUBSET THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET])

  return { NORMAL_SPACE_PERFECT_MAP_IMAGE, HAUSDORFF_NORMAL_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE,
           NORMAL_HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE,
           REGULAR_LINDELOF_IMP_NORMAL_SPACE }

/- ------------------------------------------------------------------------- -/
/- Hereditarily normal spaces.  (metric.ml 25156-25296)                      -/
/- ------------------------------------------------------------------------- -/

structure HerNormal where
  HEREDITARILY_NORMAL_SPACE : thm
  HEREDITARILY_NORMAL_SEPARATION : thm
  METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE : thm
  METRIZABLE_SPACE_SEPARATION : thm
  HEREDITARILY_NORMAL_SEPARATION_PAIRWISE : thm
  HEREDITARILY_NORMAL_SPACE_PERFECT_MAP_IMAGE : thm
  REGULAR_SECOND_COUNTABLE_IMP_HEREDITARILY_NORMAL_SPACE : thm
  REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupHerNormal [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BBases : Bases) (BClosure : Closure)
    (BSeparated : Separated) (BProper1 : Proper1) (BPerfect : Perfect)
    (BCountability : Countability) (BMetrizable : Metrizable) (BRegular1 : Regular1)
    (BNormal1 : Normal1) (BNormal2 : Normal2) (BNormal3 : Normal3) :
    ExceptT String IO HerNormal := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, EXISTS_IN_GSPEC, FINITE_DELETE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_INSERT, FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INTERS_IMAGE, INTERS_INSERT, INTER_SUBSET, IN_DELETE, IN_SING,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY, PAIRWISE_EMPTY,
        PAIRWISE_INSERT, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SKOLEM_THM, SUBSET_INTERS, UNIONS_SUBSET, pairwise,
        .. } := D.core4
  let { FORALL_UNWIND_THM2, MONO_AND, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM,
        RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_INTER, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTERS, OPEN_IN_TOPSPACE, .. } :=
    BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, OPEN_IN_TRANS_FULL, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { HEREDITARILY, hereditarily, .. } := BBases
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MONO, CLOSURE_OF_SUBTOPOLOGY, .. } := BClosure
  let { SEPARATED_IN_CLOSED_SETS, SEPARATED_IN_REFL, SEPARATED_IN_SUBTOPOLOGY,
        SEPARATED_IN_UNIONS, separated_in, .. } := BSeparated
  let { proper_map, .. } := BProper1
  let { perfect_map, .. } := BPerfect
  let { SECOND_COUNTABLE_IMP_LINDELOF_SPACE, SECOND_COUNTABLE_SUBTOPOLOGY, .. } :=
    BCountability
  let { METRIZABLE_SPACE_SUBTOPOLOGY, .. } := BMetrizable
  let { REGULAR_SPACE_SUBTOPOLOGY, .. } := BRegular1
  let { NORMAL_SPACE_CLOSURES, normal_space, .. } := BNormal1
  let { HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE, METRIZABLE_IMP_NORMAL_SPACE,
        .. } := BNormal2
  let { REGULAR_LINDELOF_IMP_NORMAL_SPACE, .. } := BNormal3
  -- @@SCOPE END

  let (HEREDITARILY_NORMAL_SPACE, HEREDITARILY_NORMAL_SEPARATION) ← CONJ_PAIR (← prove
   r"(!top:A topology.
        hereditarily normal_space top <=>
        !u. open_in top u ==> normal_space(subtopology top u)) /\
   (!top:A topology.
        hereditarily normal_space top <=>
        !s t. separated_in top s t
              ==> ?u v. open_in top u /\ open_in top v /\
                        s SUBSET u /\ t SUBSET v /\ DISJOINT u v)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> q) /\ (r ==> p) /\ (q ==> r) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [SIMP_TAC [HEREDITARILY],
      DISCH_TAC THEN REWRITE_TAC [hereditarily] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [normal_space] THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"separated_in (subtopology top u) (s:A->bool) t")
      MP_TAC THENL
       [ASM_SIMP_TAC [SEPARATED_IN_CLOSED_SETS],
        REWRITE_TAC [SEPARATED_IN_SUBTOPOLOGY]] THEN
      STRIP_TAC THEN REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC] THEN
      REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC [],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"topspace top DIFF
        (top closure_of s) INTER (top closure_of t):A->bool")) THEN
      SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_INTER, OPEN_IN_TOPSPACE,
                CLOSED_IN_CLOSURE_OF, NORMAL_SPACE_CLOSURES] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN ANTS_TAC THENL
       [REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [separated_in]) THEN
        REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
        MATCH_MP_TAC (← SET_RULE (← q
         r"top closure_of (u INTER s') SUBSET top closure_of s' /\
          top closure_of (v INTER t') SUBSET top closure_of t' /\
          s INTER t INTER top closure_of s' INTER top closure_of t' = {}
          ==>
          DISJOINT (s INTER top closure_of (u INTER s'))
                   (t INTER top closure_of (v INTER t'))")) THEN
        SIMP_TAC [CLOSURE_OF_MONO, INTER_SUBSET] THEN ASM SET_TAC [],
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
        REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS_FULL) THEN
       SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_INTER, OPEN_IN_TOPSPACE,
               CLOSED_IN_CLOSURE_OF]]]))

  let METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> hereditarily normal_space top"
   (SIMP_TAC [hereditarily, METRIZABLE_IMP_NORMAL_SPACE,
              METRIZABLE_SPACE_SUBTOPOLOGY])

  let METRIZABLE_SPACE_SEPARATION ← prove
   r"!top s t:A->bool.
        metrizable_space top /\ separated_in top s t
        ==> ?u v. open_in top u /\ open_in top v /\
                  s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM HEREDITARILY_NORMAL_SEPARATION] THEN
    REWRITE_TAC [METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE])

  let HEREDITARILY_NORMAL_SEPARATION_PAIRWISE ← prove
   r"!top:A topology.
        hereditarily normal_space top <=>
        !u. FINITE u /\ (!s. s IN u ==> s SUBSET topspace top) /\
            pairwise (separated_in top) u
            ==> ?f. (!s. s IN u ==> open_in top (f s) /\ s SUBSET f s) /\
                    pairwise (\s t. DISJOINT (f s) (f t)) u"
   (GEN_TAC THEN REWRITE_TAC [HEREDITARILY_NORMAL_SEPARATION] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"u:(A->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"!s. s IN u
            ==> ?v w. open_in top v /\ open_in top w /\ s SUBSET v /\
                      (!t:A->bool. t IN u /\ ~(t = s) ==> t SUBSET w) /\
                      DISJOINT v w")
      MP_TAC THENL
       [X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"s:A->bool", ← q r"UNIONS(u DELETE (s:A->bool))"]) THEN
        ASM_SIMP_TAC [SEPARATED_IN_UNIONS, FINITE_DELETE] THEN
        REWRITE_TAC [UNIONS_SUBSET, IN_DELETE] THEN
        DISCH_THEN MATCH_MP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [pairwise]) THEN
        ASM_MESON_TAC [],
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC
       [← q r"f:(A->bool)->(A->bool)", ← q r"g:(A->bool)->(A->bool)"] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"\s. (f:(A->bool)->(A->bool)) s INTER
                      INTERS {g t | t IN u DELETE s}") THEN
      REWRITE_TAC [← GSYM INTERS_INSERT, SUBSET_INTERS] THEN
      REWRITE_TAC [SIMPLE_IMAGE, pairwise] THEN
      ASM_SIMP_TAC [OPEN_IN_INTERS, NOT_INSERT_EMPTY, FINITE_INSERT, FINITE_IMAGE,
                    IN_DELETE, FORALL_IN_INSERT, FORALL_IN_IMAGE, IN_DELETE,
                    FINITE_DELETE] THEN
      REWRITE_TAC [INTERS_INSERT, INTERS_IMAGE] THEN ASM SET_TAC [],
      DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
      DISCH_TAC THEN ASM_CASES_TAC (← q r"t:A->bool = s") THENL
       [FIRST_X_ASSUM SUBST_ALL_TAC THEN
        FIRST_X_ASSUM (SUBST1_TAC o GEN_REWRITE_RULE id [SEPARATED_IN_REFL]) THEN
        REPEAT (EXISTS_TAC (← q r"{}:A->bool")) THEN
        ASM_REWRITE_TAC [OPEN_IN_EMPTY] THEN SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{(s:A->bool),t}")) THEN
        REWRITE_TAC [PAIRWISE_INSERT, FINITE_INSERT, FORALL_IN_INSERT] THEN
        REWRITE_TAC [FINITE_EMPTY, NOT_IN_EMPTY, PAIRWISE_EMPTY, IN_SING] THEN
        ANTS_TAC THENL [ASM_MESON_TAC [separated_in], ALL_TAC] THEN
        REWRITE_TAC [IMP_CONJ, FORALL_UNWIND_THM2] THEN ASM_MESON_TAC []]])

  let HEREDITARILY_NORMAL_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    hereditarily normal_space top /\ perfect_map(top,top') f
    ==> hereditarily normal_space top'"
   (REWRITE_TAC [perfect_map, proper_map] THEN
    MESON_TAC [HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE])

  let REGULAR_SECOND_COUNTABLE_IMP_HEREDITARILY_NORMAL_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ second_countable top
        ==> hereditarily normal_space top"
   (REWRITE_TAC [hereditarily] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC REGULAR_LINDELOF_IMP_NORMAL_SPACE THEN
    ASM_SIMP_TAC [REGULAR_SPACE_SUBTOPOLOGY] THEN
    MATCH_MP_TAC SECOND_COUNTABLE_IMP_LINDELOF_SPACE THEN
    ASM_SIMP_TAC [SECOND_COUNTABLE_SUBTOPOLOGY])

  let REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE ← prove
   r"!top:A topology.
        regular_space top /\ second_countable top /\ hausdorff_space top
        ==> normal_space top"
   (MESON_TAC [REGULAR_LINDELOF_IMP_NORMAL_SPACE,
               SECOND_COUNTABLE_IMP_LINDELOF_SPACE])

  return { HEREDITARILY_NORMAL_SPACE, HEREDITARILY_NORMAL_SEPARATION,
           METRIZABLE_IMP_HEREDITARILY_NORMAL_SPACE, METRIZABLE_SPACE_SEPARATION,
           HEREDITARILY_NORMAL_SEPARATION_PAIRWISE, HEREDITARILY_NORMAL_SPACE_PERFECT_MAP_IMAGE,
           REGULAR_SECOND_COUNTABLE_IMP_HEREDITARILY_NORMAL_SPACE,
           REGULAR_SECOND_COUNTABLE_HAUSDORFF_IMP_NORMAL_SPACE }

/- ------------------------------------------------------------------------- -/
/- Completely regular spaces.  (metric.ml 25298-25473)                       -/
/- ------------------------------------------------------------------------- -/

structure CRegular1 where
  completely_regular_space : thm
  HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE : thm
  COMPLETELY_REGULAR_SPACE_ALT : thm
  COMPLETELY_REGULAR_SPACE_GEN_ALT : thm
  COMPLETELY_REGULAR_SPACE_GEN : thm
  NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN : thm
  NORMAL_IMP_COMPLETELY_REGULAR_SPACE : thm
  COMPLETELY_REGULAR_SPACE_MTOPOLOGY : thm
  METRIZABLE_IMP_COMPLETELY_REGULAR_SPACE : thm
  COMPLETELY_REGULAR_SPACE_DISCRETE_TOPOLOGY : thm
  COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY : thm
  COMPLETELY_REGULAR_SPACE_RETRACTION_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupCRegular1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap2 : ContMap2) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BHomeoSpace : HomeoSpace) (BRetractOf : RetractOf) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BMetricHaus : MetricHaus) (BMetrizable : Metrizable)
    (BNbhdBase : NbhdBase) (BRegular1 : Regular1) (BRealCont : RealCont)
    (BNormal2 : Normal2) (BUrysohn2 : Urysohn2) : ExceptT String IO CRegular1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC,
        REAL_FIELD, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, ETA_AX, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_DIFF, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL,
        .. } := D.core2
  let { REAL_LT_IMP_NE, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SUBSET, o_THM, .. } := D.core4
  let { FORALL_UNWIND_THM2, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_CLOSEDNESS_EQ, .. } := BHomeo2
  let { homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { FORALL_METRIZABLE_SPACE, METRIZABLE_SPACE_DISCRETE_TOPOLOGY, .. } := BMetrizable
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, .. } := BRegular1
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_LMUL,
        CONTINUOUS_MAP_REAL_MAX, CONTINUOUS_MAP_REAL_MIN, CONTINUOUS_MAP_REAL_SUB, .. } :=
    BRealCont
  let { NORMAL_SPACE_MTOPOLOGY, .. } := BNormal2
  let { NORMAL_SPACE_EQ_URYSOHN_ALT, .. } := BUrysohn2
  -- @@SCOPE END

  let completely_regular_space ← new_definition
   r"completely_regular_space (top:A topology) <=>
    !s x. closed_in top s /\ x IN topspace top DIFF s
          ==> ?f. continuous_map
                   (top,subtopology euclideanreal (real_interval[&0,&1])) f /\
                  f(x) = &0 /\ !x. x IN s ==> f x = &1"

  let HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (completely_regular_space top <=> completely_regular_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [completely_regular_space, IN_DIFF] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"d:B->bool", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"IMAGE (g:B->A) d", ← q r"(g:B->A) y"]),
      MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"IMAGE (f:A->B) c", ← q r"(f:A->B) x"])] THEN
    (ANTS_TAC THENL
     [CONJ_TAC THENL
       [ASM_MESON_TAC [HOMEOMORPHIC_MAP_CLOSEDNESS_EQ],
        FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
        RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
        ASM SET_TAC []],
      ALL_TAC])
    THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"h:A->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(h:A->real) o (g:B->A)"),
      DISCH_THEN (X_CHOOSE_THEN (← q r"h:B->real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"(h:B->real) o (f:A->B)")] THEN
    ASM_REWRITE_TAC [o_THM] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    (CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ASM SET_TAC []]))

  let COMPLETELY_REGULAR_SPACE_ALT ← prove
   r"!top:A topology.
        completely_regular_space top <=>
        !s x. closed_in top s /\ x IN topspace top DIFF s
              ==> ?f. continuous_map (top,euclideanreal) f /\
                      f(x) = &0 /\ (!x. x IN s ==> f x = &1)"
   (GEN_TAC THEN REWRITE_TAC [completely_regular_space] THEN EQ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:A->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THENL
     [MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:A->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. max (&0) (min ((f:A->real) x) (&1))") THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_MAX THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_MIN THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST])

  let COMPLETELY_REGULAR_SPACE_GEN_ALT ← prove
   r"!(top:A topology) a b.
        ~(a = b)
        ==> (completely_regular_space top <=>
             !s x. closed_in top s /\ x IN topspace top DIFF s
                   ==> ?f. continuous_map (top,euclideanreal) f /\
                           f(x) = a /\ !x. x IN s ==> f x = b)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [COMPLETELY_REGULAR_SPACE_ALT] THEN
    EQ_TAC THEN  MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:A->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"\x. a + (b - a) * (f:A->real) x"),
      EXISTS_TAC (← q r"\x. inv(b - a) * ((f:A->real) x - a)")] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_LMUL, ETA_AX,
                  CONTINUOUS_MAP_REAL_SUB,
                  CONTINUOUS_MAP_REAL_CONST] THEN
    REPEAT STRIP_TAC THEN UNDISCH_TAC (← q r"~(a:real = b)") THEN
    CONV_TAC (fun t => REAL_FIELD t))

  let COMPLETELY_REGULAR_SPACE_GEN ← prove
   r"!(top:A topology) a b.
        a < b
        ==> (completely_regular_space top <=>
             !s x. closed_in top s /\ x IN topspace top DIFF s
                   ==> ?f. continuous_map
                              (top,subtopology euclideanreal
                                     (real_interval[a,b])) f /\
                           f(x) = a /\ !x. x IN s ==> f x = b)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [COMPLETELY_REGULAR_SPACE_GEN_ALT, REAL_LT_IMP_NE] THEN
    EQ_TAC THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"s:A->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THENL
     [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:A->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. max a (min ((f:A->real) x) b)") THEN
    ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL, ← GSYM CONJ_ASSOC] THEN
    CONJ_TAC THENL [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_MAX THEN
    REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_REAL_MIN THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_CONST])

  let NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN ← prove
   r"!top:A topology.
        normal_space top /\
        (t1_space top \/ hausdorff_space top \/ regular_space top)
        ==> completely_regular_space top"
   (GEN_TAC THEN REWRITE_TAC [NORMAL_SPACE_EQ_URYSOHN_ALT] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [COMPLETELY_REGULAR_SPACE_ALT, IN_DIFF] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q ==> p) /\ (p ==> s) /\ (r ==> s) ==> (p \/ q \/ r ==> s)")) THEN
    REWRITE_TAC [HAUSDORFF_IMP_T1_SPACE] THEN CONJ_TAC THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"x:A"] THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"s:A->bool"]) THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"DISJOINT {x} s <=> ~(x IN s)")] THEN
      REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM
        NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
      REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"topspace top DIFF s:A->bool", ← q r"x:A"]) THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, IN_DIFF,
                    LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"c:A->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:A->bool", ← q r"s:A->bool"]) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  let NORMAL_IMP_COMPLETELY_REGULAR_SPACE ← prove
   r"!top:A topology.
        normal_space top /\ (hausdorff_space top \/ regular_space top)
        ==> completely_regular_space top"
   (MESON_TAC [NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN])

  let COMPLETELY_REGULAR_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. completely_regular_space (mtopology m)"
   (SIMP_TAC [NORMAL_IMP_COMPLETELY_REGULAR_SPACE, NORMAL_SPACE_MTOPOLOGY,
              HAUSDORFF_SPACE_MTOPOLOGY])

  let METRIZABLE_IMP_COMPLETELY_REGULAR_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> completely_regular_space top"
   (REWRITE_TAC [FORALL_METRIZABLE_SPACE, COMPLETELY_REGULAR_SPACE_MTOPOLOGY])

  let COMPLETELY_REGULAR_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. completely_regular_space(discrete_topology u)"
   (SIMP_TAC [METRIZABLE_SPACE_DISCRETE_TOPOLOGY,
              METRIZABLE_IMP_COMPLETELY_REGULAR_SPACE])

  let COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        completely_regular_space top
        ==> completely_regular_space (subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [completely_regular_space, IN_DIFF] THEN
    STRIP_TAC THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t:A->bool", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY])

  let COMPLETELY_REGULAR_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ completely_regular_space top
        ==> completely_regular_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY,
                 HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE])

  return { completely_regular_space, HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE,
           COMPLETELY_REGULAR_SPACE_ALT, COMPLETELY_REGULAR_SPACE_GEN_ALT,
           COMPLETELY_REGULAR_SPACE_GEN, NORMAL_IMP_COMPLETELY_REGULAR_SPACE_GEN,
           NORMAL_IMP_COMPLETELY_REGULAR_SPACE, COMPLETELY_REGULAR_SPACE_MTOPOLOGY,
           METRIZABLE_IMP_COMPLETELY_REGULAR_SPACE, COMPLETELY_REGULAR_SPACE_DISCRETE_TOPOLOGY,
           COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY, COMPLETELY_REGULAR_SPACE_RETRACTION_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Completely regular spaces, continued.  (metric.ml 25475-25672)            -/
/- ------------------------------------------------------------------------- -/

structure CRegular2 where
  COMPLETELY_REGULAR_IMP_REGULAR_SPACE : thm
  LOCALLY_COMPACT_REGULAR_IMP_COMPLETELY_REGULAR_SPACE : thm
  COMPLETELY_REGULAR_EQ_REGULAR_SPACE : thm
  COMPLETELY_REGULAR_SPACE_PROD_TOPOLOGY : thm
  COMPLETELY_REGULAR_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupCRegular2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BProd1 : Prod1) (BProd2 : Prod2) (BProduct1 : Product1) (BProduct2 : Product2)
    (BHomeoSpace : HomeoSpace) (BCompact1 : Compact1) (BNbhdBase : NbhdBase)
    (BRegular1 : Regular1) (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2)
    (BRealTop1 : RealTop1) (BRealCont : RealCont) (BNormal1 : Normal1) (BUrysohn : Urysohn)
    (BCRegular1 : CRegular1) : ExceptT String IO CRegular2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_RING, SET_RULE,
        SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { CONJ_ASSOC, DISJOINT, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV,
        LEFT_IMP_EXISTS_THM, MONO_FORALL, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_POS, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET, SUBSET_REFL,
        cartesian_product, o_DEF, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, LAMBDA_PAIR, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { ENDS_IN_UNIT_REAL_INTERVAL, IN_REAL_INTERVAL, .. } := D.misc
  let { PRODUCT_EQ_0, PRODUCT_EQ_1, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE,
        CLOSED_IN_UNION, FORALL_CLOSED_IN, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, CLOSED_IN_SUBTOPOLOGY, CLOSED_IN_TRANS_FULL,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN, CONTINUOUS_MAP_CLOSED_IN, CONTINUOUS_MAP_CONST,
        OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND, .. } := BProd2
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT, TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT,
        .. } := BHomeoSpace
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { NEIGHBOURHOOD_BASE_OF_CLOSED_IN, REGULAR_SPACE_SUBTOPOLOGY, regular_space, .. } :=
    BRegular1
  let { LOCALLY_COMPACT_HAUSDORFF_OR_REGULAR, .. } := BLocCompact1
  let { LOCALLY_COMPACT_REGULAR_SPACE_NEIGHBOURHOOD_BASE, .. } := BLocCompact2
  let { REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL,
        .. } := BRealTop1
  let { CONTINUOUS_MAP_REAL_MUL, CONTINUOUS_MAP_REAL_PRODUCT, CONTINUOUS_MAP_REAL_SUB, .. } :=
    BRealCont
  let { COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE, .. } := BNormal1
  let { URYSOHN_LEMMA, .. } := BUrysohn
  let { COMPLETELY_REGULAR_SPACE_ALT, COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY,
        HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE, completely_regular_space, .. } := BCRegular1
  -- @@SCOPE END

  let COMPLETELY_REGULAR_IMP_REGULAR_SPACE ← prove
   r"!top:A topology. completely_regular_space top ==> regular_space top"
   (GEN_TAC THEN REWRITE_TAC [completely_regular_space, regular_space] THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"c:A->bool") THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_DIFF] THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x:A | x IN topspace top /\ f x IN {x | x < &1 / &2}}",
      ← q r"{x:A | x IN topspace top /\ f x IN {x | x > &1 / &2}}"] THEN
    ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"euclideanreal") THEN ASM_REWRITE_TAC [← GSYM REAL_OPEN_IN] THEN
      REWRITE_TAC [REAL_OPEN_HALFSPACE_LT, REAL_OPEN_HALFSPACE_GT],
      ONCE_REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [SUBSET, IN_ELIM_THM] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET],
        SIMP_TAC [EXTENSION, DISJOINT, IN_INTER, NOT_IN_EMPTY, IN_ELIM_THM] THEN
        REAL_ARITH_TAC]])

  let LOCALLY_COMPACT_REGULAR_IMP_COMPLETELY_REGULAR_SPACE ← prove
   r"!top:A topology.
        locally_compact_space top /\ (hausdorff_space top \/ regular_space top)
        ==> completely_regular_space top"
   (REWRITE_TAC [LOCALLY_COMPACT_HAUSDORFF_OR_REGULAR] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [completely_regular_space, IN_DIFF] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"top:A topology")
     LOCALLY_COMPACT_REGULAR_SPACE_NEIGHBOURHOOD_BASE) THEN
    ASM_REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"topspace top DIFF s:A->bool", ← q r"x:A"]) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, IN_DIFF,
                  LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"m:A->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM
     NEIGHBOURHOOD_BASE_OF_CLOSED_IN]) THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology top (m:A->bool)",
                      ← q r"k:A->bool", ← q r"m DIFF u:A->bool", ← q r"&0:real",
                      ← q r"&1:real"]
          URYSOHN_LEMMA) THEN
    REWRITE_TAC [REAL_POS, IN_DIFF] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE THEN
        ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY, REGULAR_SPACE_SUBTOPOLOGY],
        MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN ASM SET_TAC [],
        REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN
        EXISTS_TAC (← q r"topspace top DIFF u:A->bool") THEN
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
        ASM SET_TAC [],
        ASM SET_TAC []],
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY,
                    ← SET_RULE (← q r"s SUBSET u ==> u INTER s = s")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:A->real") STRIP_ASSUME_TAC)] THEN
    EXISTS_TAC (← q r"\x. if x IN m then (g:A->real) x else &1") THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [ALL_TAC, REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM SET_TAC []] THEN
    CONJ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [ENDS_IN_UNIT_REAL_INTERVAL]] THEN
    REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
    X_GEN_TAC (← q r"c:real->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (if x IN m then g x else &1) IN c} =
      {x | x IN m /\ (g:A->real) x IN c} UNION
      (if &1 IN c then topspace top DIFF u else {})")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_UNION, IN_ELIM_THM, IN_DIFF] THEN
      X_GEN_TAC (← q r"y:A") THEN ASM_CASES_TAC (← q r"(y:A) IN m") THEN
      ASM_REWRITE_TAC [] THENL [ALL_TAC, ASM SET_TAC []] THEN
      COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_DIFF, NOT_IN_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_UNION THEN CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_TRANS_FULL THEN EXISTS_TAC (← q r"m:A->bool") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN THEN
        EXISTS_TAC (← q r"euclideanreal") THEN
        ASM_SIMP_TAC [CLOSED_IN_SUBSET_TOPSPACE, SUBSET_REFL],
        COND_CASES_TAC THEN REWRITE_TAC [CLOSED_IN_EMPTY] THEN
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE]]])

  let COMPLETELY_REGULAR_EQ_REGULAR_SPACE ← prove
   r"!top:A topology.
        locally_compact_space top
        ==> (completely_regular_space top <=> regular_space top)"
   (MESON_TAC [COMPLETELY_REGULAR_IMP_REGULAR_SPACE,
               LOCALLY_COMPACT_REGULAR_IMP_COMPLETELY_REGULAR_SPACE])

  let COMPLETELY_REGULAR_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        completely_regular_space (prod_topology top1 top2) <=>
        topspace (prod_topology top1 top2) = {} \/
        completely_regular_space top1 /\ completely_regular_space top2"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE] THEN
      SIMP_TAC [COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_REWRITE_TAC [completely_regular_space, IN_DIFF, NOT_IN_EMPTY],
      ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [COMPLETELY_REGULAR_SPACE_ALT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_CLOSED_IN] THEN SIMP_TAC [IN_DIFF, IMP_CONJ] THEN
    GEN_REWRITE_TAC (BINOP_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN STRIP_TAC THEN
    REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:A#B->bool", ← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"v:B->bool", ← q r"y:B"]) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_REAL_INTERVAL] THEN
    X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"g:B->real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"\(x,y). &1 - (&1 - (f:A->real) x) * (&1 - (g:B->real) y)") THEN
    ASM_REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN CONJ_TAC THENL
     [REWRITE_TAC [LAMBDA_PAIR] THEN
      REPEAT ((MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB ORELSE
              MATCH_MP_TAC CONTINUOUS_MAP_REAL_MUL) THEN CONJ_TAC) THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND],
      REWRITE_TAC [← REAL_RING (← q
       r"&1 - (&1 - x) * (&1 - y) = &1 <=> x = &1 \/ y = &1")] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
      ASM SET_TAC []])

  let COMPLETELY_REGULAR_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        completely_regular_space (product_topology k tops) <=>
        topspace (product_topology k tops) = {} \/
        !i. i IN k ==> completely_regular_space (tops i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_COMPLETELY_REGULAR_SPACE] THEN
      SIMP_TAC [COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"topspace (product_topology k (tops:K->A topology)) = {}") THENL
     [ASM_REWRITE_TAC [completely_regular_space, NOT_IN_EMPTY, IN_DIFF],
      ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [COMPLETELY_REGULAR_SPACE_ALT] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_CLOSED_IN] THEN SIMP_TAC [IN_DIFF, IMP_CONJ] THEN
    GEN_REWRITE_TAC (BINOP_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN STRIP_TAC THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:(K->A)->bool", ← q r"x:K->A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id
     [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:K->A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"u:K->A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN (← q r"i:K") o SPECL
     [← q r"i:K", ← q r"(u:K->A->bool) i", ← q r"(x:K->A) i"]) THEN
    REWRITE_TAC [← MESON [SUBSET, OPEN_IN_SUBSET] (← q
     r"(P /\ open_in top u /\ x IN topspace top /\ x IN u ==> Q) <=>
      P ==> open_in top u /\ x IN u ==> Q")] THEN
    MP_TAC (← ASSUME (← q r"(x:K->A) IN cartesian_product k u")) THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
    X_GEN_TAC (← q r"f:K->A->real") THEN DISCH_TAC THEN
    EXISTS_TAC
     (← q r"\z. &1 - product {i | i IN k /\ ~(u i :A->bool = topspace(tops i))}
                       (\i. &1 - (f:K->A->real) i (z i))") THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product, IN_ELIM_THM] THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_PRODUCT THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN STRIP_TAC THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"(tops:K->A topology) i") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION],
      REWRITE_TAC [← REAL_ARITH (← q r"&1 - x = &0 <=> x = &1")] THEN
      MATCH_MP_TAC PRODUCT_EQ_1 THEN
      ASM_SIMP_TAC [IN_ELIM_THM, ← REAL_ARITH (← q r"&1 - x = &1 <=> x = &0")],
      X_GEN_TAC (← q r"y:K->A") THEN REWRITE_TAC [o_THM] THEN STRIP_TAC THEN
      REWRITE_TAC [← REAL_ARITH (← q r"&1 - x = &1 <=> x = &0")] THEN
      ASM_SIMP_TAC [PRODUCT_EQ_0, ← REAL_ARITH (← q r"&1 - x = &0 <=> x = &1")] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:K->A") o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN ASM_MESON_TAC []])

  return { COMPLETELY_REGULAR_IMP_REGULAR_SPACE,
           LOCALLY_COMPACT_REGULAR_IMP_COMPLETELY_REGULAR_SPACE,
           COMPLETELY_REGULAR_EQ_REGULAR_SPACE, COMPLETELY_REGULAR_SPACE_PROD_TOPOLOGY,
           COMPLETELY_REGULAR_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Locally path-connected spaces.  (metric.ml 25674-25913)                   -/
/- ------------------------------------------------------------------------- -/

structure LPC1 where
  weakly_locally_path_connected_at : thm
  locally_path_connected_at : thm
  locally_path_connected_space : thm
  LOCALLY_PATH_CONNECTED_SPACE_ALT : thm
  LOCALLY_PATH_CONNECTED_SPACE_EQ_OPEN_PATH_COMPONENT_OF : thm
  LOCALLY_PATH_CONNECTED_SPACE : thm
  LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS : thm
  OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE : thm
  OPEN_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE : thm
  CLOSED_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE : thm
  CLOSED_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE : thm
  WEAKLY_LOCALLY_PATH_CONNECTED_AT : thm
  LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN : thm
  LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET : thm
  LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : thm
  HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE : thm
  LOCALLY_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupLPC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap2 : ContMap2) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BNbhdBase : NbhdBase)
    (BPaths1 : Paths1) (BPathComp1 : PathComp1) (BPathComp2 : PathComp2) :
    ExceptT String IO LPC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, ETA_AX, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_IN_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, IN_DELETE, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET, SUBSET_INTER,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.core4
  let { CLOSED_IN_EMPTY, OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        OPEN_IN_UNIONS, closed_in, .. } := BTopology
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { QUOTIENT_IMP_CONTINUOUS_MAP, quotient_map, .. } := BQuotient
  let { HOMEOMORPHIC_MAPS_MAP, homeomorphic_map, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET,
        NEIGHBOURHOOD_BASE_OF_WITH_SUBSET, OPEN_NEIGHBOURHOOD_BASE_OF, neighbourhood_base_at,
        neighbourhood_base_of, .. } := BNbhdBase
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_SUBTOPOLOGY, .. } := BPaths1
  let { PATH_COMPONENT_OF_EQUIV, PATH_COMPONENT_OF_EQ_EMPTY, PATH_COMPONENT_OF_MAXIMAL,
        PATH_COMPONENT_OF_REFL, PATH_COMPONENT_OF_SUBSET_TOPSPACE,
        PATH_CONNECTED_IN_PATH_COMPONENT_OF, path_components_of, .. } := BPathComp1
  let { COMPLEMENT_PATH_COMPONENTS_OF_UNIONS, PATH_COMPONENTS_OF_MAXIMAL,
        PATH_COMPONENTS_OF_SUBSET, PATH_COMPONENT_IN_PATH_COMPONENTS_OF, .. } := BPathComp2
  -- @@SCOPE END

  let weakly_locally_path_connected_at ← new_definition
   r"weakly_locally_path_connected_at x top <=>
    neighbourhood_base_at x (path_connected_in top) top"

  let locally_path_connected_at ← new_definition
   r"locally_path_connected_at x top <=>
    neighbourhood_base_at x
      (\u. open_in top u /\ path_connected_in top u ) top"

  let locally_path_connected_space ← new_definition
   r"locally_path_connected_space top <=>
        neighbourhood_base_of (path_connected_in top) top"

  let (LOCALLY_PATH_CONNECTED_SPACE_ALT,
       LOCALLY_PATH_CONNECTED_SPACE_EQ_OPEN_PATH_COMPONENT_OF) ← CONJ_PAIR (← prove
   r"(!top:A topology.
        locally_path_connected_space top <=>
        neighbourhood_base_of
          (\u. open_in top u /\ path_connected_in top u) top) /\
   (!top:A topology.
        locally_path_connected_space top <=>
        !u x. open_in top u /\ x IN u
              ==> open_in top (path_component_of (subtopology top u) x))"
   (SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [AND_FORALL_THM, locally_path_connected_space] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    X_GEN_TAC (← q r"top:A topology") THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q ==> p) /\ (p ==> r) /\ (r ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET_REFL],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"y:A"] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← liftExcept (last (CONJUNCTS
          (← GEN_REWRITE_RULE id [PATH_COMPONENT_OF_EQUIV]
             (← GEN_REWRITE_RULE id [IN] th))))
        pure (SUBST1_TAC c)) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          PATH_COMPONENT_OF_SUBSET_TOPSPACE)) THEN
        ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"w:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"w:A->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY] THEN ASM SET_TAC [],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"path_component_of (subtopology top u) (x:A)") THEN
      ASM_SIMP_TAC [] THEN REPEAT CONJ_TAC THENL
       [W (MP_TAC o PART_MATCH rand PATH_CONNECTED_IN_PATH_COMPONENT_OF o
          rand o snd) THEN
        SIMP_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY],
        REWRITE_TAC [IN] THEN REWRITE_TAC [PATH_COMPONENT_OF_REFL] THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
        ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET],
        W (MP_TAC o PART_MATCH lhand PATH_COMPONENT_OF_SUBSET_TOPSPACE o
          lhand o snd) THEN
        SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER]]]))

  let LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!top:A topology.
        locally_path_connected_space top <=>
        !v x. open_in top v /\ x IN v
              ==> ?u. open_in top u /\
                      path_connected_in top u /\
                      x IN u /\ u SUBSET v"
   (SIMP_TAC [LOCALLY_PATH_CONNECTED_SPACE_ALT, OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC])

  let LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS ← prove
   r"!top:A topology.
        locally_path_connected_space top <=>
        !u c. open_in top u /\ c IN path_components_of(subtopology top u)
              ==> open_in top c"
   (REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_EQ_OPEN_PATH_COMPONENT_OF] THEN
    REWRITE_TAC [path_components_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!top x:A. locally_path_connected_space top
             ==> open_in top (path_component_of top x)"
   (METIS_TAC [LOCALLY_PATH_CONNECTED_SPACE_EQ_OPEN_PATH_COMPONENT_OF,
               SUBTOPOLOGY_TOPSPACE, OPEN_IN_TOPSPACE,
               OPEN_IN_EMPTY, PATH_COMPONENT_OF_EQ_EMPTY])

  let OPEN_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!top c:A->bool.
        locally_path_connected_space top /\ c IN path_components_of top
        ==> open_in top c"
   (REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, SUBTOPOLOGY_TOPSPACE])

  let CLOSED_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!top c:A->bool.
        locally_path_connected_space top /\ c IN path_components_of top
        ==> closed_in top c"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [closed_in, PATH_COMPONENTS_OF_SUBSET] THEN
    ASM_SIMP_TAC [COMPLEMENT_PATH_COMPONENTS_OF_UNIONS] THEN
    MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [IN_DELETE] THEN
    ASM_SIMP_TAC [OPEN_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE])

  let CLOSED_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!top x:A. locally_path_connected_space top
             ==> closed_in top (path_component_of top x)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN
    ASM_SIMP_TAC [PATH_COMPONENT_IN_PATH_COMPONENTS_OF,
                  CLOSED_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE] THEN
    ASM_MESON_TAC [CLOSED_IN_EMPTY, PATH_COMPONENT_OF_EQ_EMPTY])

  let WEAKLY_LOCALLY_PATH_CONNECTED_AT ← prove
   r"!top x:A.
        weakly_locally_path_connected_at x top <=>
        !v. open_in top v /\ x IN v
            ==> ?u. open_in top u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?c. path_connected_in top c /\
                                c SUBSET v /\ x IN c /\ y IN c"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [neighbourhood_base_at, weakly_locally_path_connected_at] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"u:A->bool") THENL [ASM_MESON_TAC [SUBSET], STRIP_TAC] THEN
    EXISTS_TAC (← q r"path_component_of (subtopology top v) (x:A)") THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MESON_TAC [PATH_CONNECTED_IN_PATH_COMPONENT_OF,
                 PATH_CONNECTED_IN_SUBTOPOLOGY],
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
      MATCH_MP_TAC PATH_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC [PATH_CONNECTED_IN_SUBTOPOLOGY],
      MESON_TAC [PATH_COMPONENT_OF_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY,
                 SUBSET_INTER]])

  let LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN ← prove
   r"!top:A topology.
        locally_path_connected_space top <=>
        !v x. open_in top v /\ x IN v
            ==> ?u. open_in top u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?c. path_connected_in top c /\
                                c SUBSET v /\ x IN c /\ y IN c"
   (REWRITE_TAC [locally_path_connected_space, neighbourhood_base_of] THEN
    GEN_TAC THEN REWRITE_TAC [← GSYM weakly_locally_path_connected_at] THEN
    REWRITE_TAC [WEAKLY_LOCALLY_PATH_CONNECTED_AT] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    EQ_TAC THEN REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET ← prove
   r"!top s:A->bool.
        locally_path_connected_space top /\ open_in top s
        ==> locally_path_connected_space (subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_path_connected_space] THEN
    DISCH_THEN (MP_TAC o MATCH_MP NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET) THEN
    GEN_REWRITE_TAC LAND_CONV [NEIGHBOURHOOD_BASE_OF_WITH_SUBSET] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_OF_MONO) THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, PATH_CONNECTED_IN_SUBTOPOLOGY,
              SUBSET_INTER])

  let LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        quotient_map(top,top') f /\ locally_path_connected_space top
        ==> locally_path_connected_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map] THEN
    REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS] THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"v:B->bool", ← q r"c:B->bool"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (fun th => W (MP_TAC o PART_MATCH (rand o rand) th o snd)) THEN
    ANTS_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENTS_OF_SUBSET) THEN
      ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN ASM SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"x:A") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"path_component_of
        (subtopology top {z | z IN topspace top /\ (f:A->B) z IN v}) x") THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"{z | z IN topspace top /\ (f:A->B) z IN v}") THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET, path_components_of] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ETA_AX] THEN MATCH_MP_TAC FUN_IN_IMAGE,
      GEN_REWRITE_TAC id [IN] THEN REWRITE_TAC [PATH_COMPONENT_OF_REFL],
      MATCH_MP_TAC (← SET_RULE (← q
       r"!v. s SUBSET u INTER {x | x IN u /\ f x IN v} /\ IMAGE f s SUBSET c
            ==> s SUBSET {x | x IN u /\ f x IN c}")) THEN
      EXISTS_TAC (← q r"v:B->bool") THEN
      REWRITE_TAC [PATH_COMPONENT_OF_SUBSET_TOPSPACE,
                   ← GSYM TOPSPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC PATH_COMPONENTS_OF_MAXIMAL THEN
      EXISTS_TAC (← q r"subtopology top' (v:B->bool)") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN EXISTS_TAC
         (← q r"subtopology top {z | z IN topspace top /\ (f:A->B) z IN v}") THEN
        REWRITE_TAC [PATH_CONNECTED_IN_PATH_COMPONENT_OF] THEN
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
        SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
        MATCH_MP_TAC QUOTIENT_IMP_CONTINUOUS_MAP THEN
        ASM_REWRITE_TAC [quotient_map],
        REWRITE_TAC [← SET_RULE (← q
         r"~DISJOINT t (IMAGE f s) <=> ?x. x IN s /\ f x IN t")] THEN
        EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
        GEN_REWRITE_TAC id [IN] THEN REWRITE_TAC [PATH_COMPONENT_OF_REFL]]] THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP PATH_COMPONENTS_OF_SUBSET) THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (locally_path_connected_space top <=>
             locally_path_connected_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, homeomorphic_map] THEN
    MESON_TAC [LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE])

  let LOCALLY_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map (top,top') r /\ locally_path_connected_space top
        ==> locally_path_connected_space top'"
   (MESON_TAC [LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  return { weakly_locally_path_connected_at, locally_path_connected_at,
           locally_path_connected_space, LOCALLY_PATH_CONNECTED_SPACE_ALT,
           LOCALLY_PATH_CONNECTED_SPACE_EQ_OPEN_PATH_COMPONENT_OF, LOCALLY_PATH_CONNECTED_SPACE,
           LOCALLY_PATH_CONNECTED_SPACE_OPEN_PATH_COMPONENTS,
           OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE,
           OPEN_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE,
           CLOSED_IN_PATH_COMPONENTS_OF_LOCALLY_PATH_CONNECTED_SPACE,
           CLOSED_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE,
           WEAKLY_LOCALLY_PATH_CONNECTED_AT, LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN,
           LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET,
           LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
           HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE,
           LOCALLY_PATH_CONNECTED_SPACE_RETRACTION_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Locally path-connected spaces, continued.  (metric.ml 25915-26013)        -/
/- ------------------------------------------------------------------------- -/

structure LPC2 where
  LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL : thm
  LOCALLY_PATH_CONNECTED_IS_REALINTERVAL : thm
  LOCALLY_PATH_CONNECTED_REAL_INTERVAL : thm
  LOCALLY_PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY : thm
  PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF : thm
  PATH_COMPONENTS_EQ_CONNECTED_COMPONENTS_OF : thm
  PATH_CONNECTED_EQ_CONNECTED_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupLPC2 [HolBase] (D : MetricDeps) (BDiscrete : Discrete) (BSubtopology : Subtopology)
    (BMTopology : MTopology) (BConnected1 : Connected1) (BComponents1 : Components1)
    (BNbhdBase : NbhdBase) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2) (BPaths1 : Paths1)
    (BPaths2 : Paths2) (BPathComp1 : PathComp1) (BPathComp2 : PathComp2) (BLPC1 : LPC1) :
    ExceptT String IO LPC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { EXISTS_IN_GSPEC, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, INTER_SUBSET, IN_INTER, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, IS_REALINTERVAL_INTER, IS_REALINTERVAL_INTERVAL, .. } := D.misc
  let { OPEN_IN_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_SUBSET_TOPSPACE, OPEN_IN_SUBSET_TOPSPACE, OPEN_IN_SUBTOPOLOGY_ALT,
        TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { OPEN_IN_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_SPACE_CLOPEN_IN, connected_in, .. } := BConnected1
  let { CONNECTED_COMPONENT_OF_EQ_EMPTY, CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE,
        CONNECTED_IN_CONNECTED_COMPONENT_OF, CONNECTED_SPACE_IFF_CONNECTED_COMPONENT,
        connected_components_of, .. } := BComponents1
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, real_open,
        .. } := BRealTop1
  let { MBALL_REAL_INTERVAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL, PATH_CONNECTED_IN_SUBTOPOLOGY, .. } :=
    BPaths1
  let { PATH_CONNECTED_IN_DISCRETE_TOPOLOGY, PATH_CONNECTED_IN_EUCLIDEANREAL, .. } := BPaths2
  let { PATH_COMPONENT_OF_EQ_EMPTY, PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT,
        path_components_of, .. } := BPathComp1
  let { PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF, .. } := BPathComp2
  let { CLOSED_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE, LOCALLY_PATH_CONNECTED_SPACE,
        OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE, locally_path_connected_space,
        .. } := BLPC1
  -- @@SCOPE END

  let LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL ← prove
   r"locally_path_connected_space euclideanreal"
   (REWRITE_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
    MAP_EVERY X_GEN_TAC [← q r"w:real->bool", ← q r"x:real"] THEN
    REWRITE_TAC [← GSYM REAL_OPEN_IN] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    GEN_REWRITE_TAC LAND_CONV [real_open] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:real")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
    REPEAT (EXISTS_TAC (← q r"real_interval(x - e,x + e)")) THEN
    REWRITE_TAC [SUBSET_REFL, REAL_OPEN_REAL_INTERVAL,
                 PATH_CONNECTED_IN_EUCLIDEANREAL_INTERVAL] THEN
    REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN CONJ_TAC THENL
     [ALL_TAC, REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC] THEN
    ASM_REAL_ARITH_TAC)

  let LOCALLY_PATH_CONNECTED_IS_REALINTERVAL ← prove
   r"!s. is_realinterval s
       ==> locally_path_connected_space(subtopology euclideanreal s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally_path_connected_space] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, IMP_CONJ] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, IN_INTER, INTER_SUBSET] THEN
    X_GEN_TAC (← q r"u:real->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"a:real") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE LAND_CONV
     [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC]) THEN
    REWRITE_TAC [OPEN_IN_MTOPOLOGY, MBALL_REAL_INTERVAL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:real") o CONJUNCT2) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"real_interval(a - r,a + r)") THEN
    REWRITE_TAC [← GSYM REAL_OPEN_IN, REAL_OPEN_REAL_INTERVAL] THEN
    EXISTS_TAC (← q r"s INTER real_interval(a - r,a + r)") THEN
    ASM_REWRITE_TAC [IN_REAL_INTERVAL, PATH_CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [INTER_SUBSET, SUBSET_INTER] THEN
    ASM_REWRITE_TAC [← REAL_ARITH (← q r"a - r:real < a /\ a < a + r <=> &0 < r")] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [PATH_CONNECTED_IN_EUCLIDEANREAL] THEN
    MATCH_MP_TAC IS_REALINTERVAL_INTER THEN
    ASM_REWRITE_TAC [IS_REALINTERVAL_INTERVAL])

  let LOCALLY_PATH_CONNECTED_REAL_INTERVAL ← prove
   r"(!a b. locally_path_connected_space
           (subtopology euclideanreal(real_interval[a,b]))) /\
   (!a b. locally_path_connected_space
           (subtopology euclideanreal(real_interval(a,b))))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_PATH_CONNECTED_IS_REALINTERVAL THEN
    REWRITE_TAC [IS_REALINTERVAL_INTERVAL])

  let LOCALLY_PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. locally_path_connected_space (discrete_topology u)"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE] THEN
    SIMP_TAC [OPEN_IN_DISCRETE_TOPOLOGY, PATH_CONNECTED_IN_DISCRETE_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"{x:A}") THEN ASM SET_TAC [])

  let PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF ← prove
   r"!top x:A. locally_path_connected_space top
             ==> (path_component_of top x = connected_component_of top x)"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [ALL_TAC,
      ASM_MESON_TAC [PATH_COMPONENT_OF_EQ_EMPTY,
                     CONNECTED_COMPONENT_OF_EQ_EMPTY]] THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"x:A"] CONNECTED_IN_CONNECTED_COMPONENT_OF) THEN
    REWRITE_TAC [connected_in, CONNECTED_SPACE_CLOPEN_IN] THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q \/ r <=> p /\ ~q ==> r")] THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET,
              CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    DISCH_THEN MATCH_MP_TAC THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_SUBSET_TOPSPACE,
      MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE,
      ASM_REWRITE_TAC [PATH_COMPONENT_OF_EQ_EMPTY]] THEN
    REWRITE_TAC [PATH_COMPONENT_SUBSET_CONNECTED_COMPONENT_OF] THEN
    ASM_SIMP_TAC [OPEN_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE,
                  CLOSED_IN_PATH_COMPONENT_OF_LOCALLY_PATH_CONNECTED_SPACE])

  let PATH_COMPONENTS_EQ_CONNECTED_COMPONENTS_OF ← prove
   r"!top:A topology.
        locally_path_connected_space top
        ==> (path_components_of top = connected_components_of top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [path_components_of, connected_components_of] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. x IN s ==> f x = g x) ==> {f x | x IN s} = {g x | x IN s}")) THEN
    ASM_SIMP_TAC [PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF])

  let PATH_CONNECTED_EQ_CONNECTED_SPACE ← prove
   r"!top. locally_path_connected_space top
         ==> (path_connected_space top <=> connected_space top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT,
                 CONNECTED_SPACE_IFF_CONNECTED_COMPONENT] THEN
    ASM_SIMP_TAC [PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF])

  return { LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL, LOCALLY_PATH_CONNECTED_IS_REALINTERVAL,
           LOCALLY_PATH_CONNECTED_REAL_INTERVAL, LOCALLY_PATH_CONNECTED_SPACE_DISCRETE_TOPOLOGY,
           PATH_COMPONENT_EQ_CONNECTED_COMPONENT_OF, PATH_COMPONENTS_EQ_CONNECTED_COMPONENTS_OF,
           PATH_CONNECTED_EQ_CONNECTED_SPACE }

/- ------------------------------------------------------------------------- -/
/- Locally path-connected spaces: products and sums.  (metric.ml 26015-26204) -/
/- ------------------------------------------------------------------------- -/

structure LPC3 where
  LOCALLY_PATH_CONNECTED_SPACE_PROD_TOPOLOGY : thm
  LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY : thm
  LOCALLY_PATH_CONNECTED_SPACE_SUM_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupLPC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BOpenClosed1 : OpenClosed1)
    (BProd1 : Prod1) (BProd2 : Prod2) (BProduct1 : Product1) (BProduct2 : Product2)
    (BProduct3 : Product3) (BSumTop : SumTop) (BEmbedding : Embedding) (BNbhdBase : NbhdBase)
    (BPaths1 : Paths1) (BPaths2 : Paths2) (BLPC1 : LPC1) : ExceptT String IO LPC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, CROSS_EQ_EMPTY, ETA_AX, FINITE_SUBSET, FINITE_UNION, FORALL_IN_IMAGE,
        .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_CROSS, IN_ELIM_PAIR_THM, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_REFL, SUBSET_TRANS, cartesian_product,
        disjoint_union, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP, FORALL_PAIR_THM, RIGHT_IMP_EXISTS_THM, .. } :=
    D.core5
  let { OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { open_map, .. } := BOpenClosed1
  let { OPEN_IN_CROSS, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { QUOTIENT_MAP_FST, QUOTIENT_MAP_SND, .. } := BProd2
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, OPEN_IN_CARTESIAN_PRODUCT_GEN,
        OPEN_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { QUOTIENT_MAP_PRODUCT_PROJECTION, .. } := BProduct3
  let { CONTINUOUS_MAP_COMPONENT_INJECTION, FORALL_OPEN_IN_SUM_TOPOLOGY,
        OPEN_MAP_COMPONENT_INJECTION, .. } := BSumTop
  let { TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT, .. } := BEmbedding
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE, PATH_CONNECTED_IN_SUBSET_TOPSPACE,
        PATH_CONNECTED_IN_TOPSPACE, .. } := BPaths1
  let { PATH_CONNECTED_IN_CARTESIAN_PRODUCT, PATH_CONNECTED_IN_CROSS, .. } := BPaths2
  let { HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE, LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET,
        LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, locally_path_connected_space, .. } :=
    BLPC1
  -- @@SCOPE END

  let LOCALLY_PATH_CONNECTED_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
      locally_path_connected_space (prod_topology top1 top2) <=>
      topspace (prod_topology top1 top2) = {} \/
      locally_path_connected_space top1 /\ locally_path_connected_space top2"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_REWRITE_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE
     [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
        LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE))
      THENL [EXISTS_TAC (← q r"FST:A#B->A"), EXISTS_TAC (← q r"SND:A#B->B")] THEN
      ASM_REWRITE_TAC [QUOTIENT_MAP_FST, QUOTIENT_MAP_SND],
      FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:B") THEN DISCH_TAC THEN X_GEN_TAC (← q r"w:A") THEN DISCH_TAC THEN
      REWRITE_TAC [locally_path_connected_space, FORALL_PAIR_THM, IN_CROSS,
        NEIGHBOURHOOD_BASE_OF, TOPSPACE_PROD_TOPOLOGY] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"uv:A#B->bool", ← q r"x:A", ← q r"y:B"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [OPEN_IN_PROD_TOPOLOGY_ALT] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"w1:A->bool", ← q r"w2:B->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w2:B->bool", ← q r"y:B"]) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w1:A->bool", ← q r"x:A"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u1:A->bool", ← q r"k1:A->bool"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u2:B->bool", ← q r"k2:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(u1:A->bool) CROSS (u2:B->bool)") THEN
      EXISTS_TAC (← q r"(k1:A->bool) CROSS (k2:B->bool)") THEN
      ASM_SIMP_TAC [OPEN_IN_CROSS, PATH_CONNECTED_IN_CROSS,
                    IN_CROSS, SUBSET_CROSS] THEN
      TRANS_TAC SUBSET_TRANS (← q r"(w1 CROSS w2):A#B->bool") THEN
      ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [SUBSET_CROSS]])

  let LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        locally_path_connected_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        FINITE {i | i IN k /\ ~path_connected_space(tops i)} /\
        !i. i IN k ==> locally_path_connected_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THENL
     [ASM_REWRITE_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A")) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"topspace(product_topology k (tops:K->A topology))", ← q r"z:K->A"]) THEN
        ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:(K->A)->bool", ← q r"c:(K->A)->bool"] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:K->A") o
          REWRITE_RULE [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"v:K->A->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN
        ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
        DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o ISPECL [← q r"\x:K->A. x i", ← q r"(tops:K->A topology) i"] o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
              PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION,
                      ← GSYM PATH_CONNECTED_IN_TOPSPACE] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← SET_RULE (← q r"v = u ==> v SUBSET s /\ s SUBSET u ==> s = u"))) THEN
        CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"IMAGE (\x:K->A. x i) u") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN TRANS_TAC SUBSET_TRANS
           (← q r"IMAGE (\x:K->A. x i) (cartesian_product k v)") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN
          REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
          ASM SET_TAC [],
          TRANS_TAC SUBSET_TRANS
            (← q r"IMAGE (\x:K->A. x i) (topspace(product_topology k tops))") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET, PATH_CONNECTED_IN_SUBSET_TOPSPACE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
          ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                           TOPSPACE_PRODUCT_TOPOLOGY] THEN
          REWRITE_TAC [o_THM, SUBSET_REFL]],
        X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM locally_path_connected_space, ETA_AX,
                     ← GSYM NEIGHBOURHOOD_BASE_OF] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM locally_path_connected_space, ETA_AX,
                                      ← GSYM NEIGHBOURHOOD_BASE_OF]) THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          (← REWRITE_RULE [CONJ_ASSOC]
                  LOCALLY_PATH_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE)))  THEN
        EXISTS_TAC (← q r"\x:K->A. x i") THEN
        ASM_SIMP_TAC [OPEN_MAP_PRODUCT_PROJECTION, TOPSPACE_PRODUCT_TOPOLOGY,
                      QUOTIENT_MAP_PRODUCT_PROJECTION,
                      IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
        ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM]],
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"ww:(K->A)->bool", ← q r"z:K->A"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:K->A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:K->A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!i. i IN k
            ==> ?u c. open_in (tops i) u /\
                      path_connected_in (tops i) c /\
                      ((z:K->A) i) IN u /\
                      u SUBSET c /\
                      c SUBSET w i /\
                      (w i = topspace(tops i) /\ path_connected_space(tops i)
                       ==> u = topspace(tops i) /\ c = topspace(tops i))")
      MP_TAC THENL
       [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"i:K", ← q r"(w:K->A->bool) i"] o
          GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_FORALL_THM]) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"(z:K->A) i")) THEN
        ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o
           GEN_REWRITE_RULE RAND_CONV [cartesian_product]) THEN
          ASM_SIMP_TAC [IN_ELIM_THM],
          ASM_CASES_TAC (← q r"path_connected_space((tops:K->A topology) i)") THEN
          ASM_REWRITE_TAC [] THEN
          ASM_CASES_TAC (← q r"(w:K->A->bool) i = topspace(tops i)") THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
          REPEAT (EXISTS_TAC (← q r"topspace((tops:K->A topology) i)")) THEN
          ASM_REWRITE_TAC [PATH_CONNECTED_IN_TOPSPACE, SUBSET_REFL] THEN
          REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM]) THEN
          ASM SET_TAC []],
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:K->A->bool", ← q r"c:K->A->bool"] THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"cartesian_product k (u:K->A->bool)",
        ← q r"cartesian_product k (c:K->A->bool)"] THEN
      ASM_SIMP_TAC [PATH_CONNECTED_IN_CARTESIAN_PRODUCT] THEN
      ASM_SIMP_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN REPEAT CONJ_TAC THENL
       [DISJ2_TAC THEN ASM_SIMP_TAC [] THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{i | i IN k /\ ~path_connected_space (tops i)} UNION
                    {i | i IN k /\ ~((w:K->A->bool) i = topspace (tops i))}") THEN
        ASM_REWRITE_TAC [FINITE_UNION] THEN ASM SET_TAC [],
        UNDISCH_TAC (← q r"(z:K->A) IN cartesian_product k w") THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN ASM SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"cartesian_product k (w:K->A->bool)") THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
        ASM SET_TAC []]])

  let LOCALLY_PATH_CONNECTED_SPACE_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        locally_path_connected_space(sum_topology k top) <=>
        !i. i IN k ==> locally_path_connected_space(top i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_LOCALLY_PATH_CONNECTED_SPACE] THEN
      SIMP_TAC [LOCALLY_PATH_CONNECTED_SPACE_OPEN_SUBSET],
      REWRITE_TAC [locally_path_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_OPEN_IN_SUM_TOPOLOGY] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"w:K->A->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [FORALL_PAIR_THM, disjoint_union, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"i:K", ← q r"x:A"] THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K"))) THEN
      ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(w:K->A->bool) i")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (\x. (i:K),(x:A)) u") THEN
      EXISTS_TAC (← q r"IMAGE (\x. (i:K),(x:A)) v") THEN
      ASM_SIMP_TAC [IMAGE_SUBSET] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PAIR_THM] THEN
      ASM_REWRITE_TAC [← GSYM SUBSET] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [open_map, RIGHT_IMP_FORALL_THM, IMP_IMP]
          OPEN_MAP_COMPONENT_INJECTION) THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC PATH_CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
        EXISTS_TAC (← q r"(top:K->A topology) i") THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_COMPONENT_INJECTION],
        ASM SET_TAC []]])

  return { LOCALLY_PATH_CONNECTED_SPACE_PROD_TOPOLOGY,
           LOCALLY_PATH_CONNECTED_SPACE_PRODUCT_TOPOLOGY,
           LOCALLY_PATH_CONNECTED_SPACE_SUM_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Locally connected spaces.  (metric.ml 26206-26436)                        -/
/- ------------------------------------------------------------------------- -/

structure LC1 where
  weakly_locally_connected_at : thm
  locally_connected_at : thm
  locally_connected_space : thm
  LOCALLY_CONNECTED_SPACE_ALT : thm
  LOCALLY_CONNECTED_SPACE_EQ_OPEN_CONNECTED_COMPONENT_OF : thm
  LOCALLY_CONNECTED_SPACE : thm
  LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE : thm
  LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS : thm
  OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE : thm
  OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE : thm
  WEAKLY_LOCALLY_CONNECTED_AT : thm
  LOCALLY_CONNECTED_SPACE_IM_KLEINEN : thm
  LOCALLY_CONNECTED_SPACE_OPEN_SUBSET : thm
  LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : thm
  LOCALLY_CONNECTED_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_LOCALLY_CONNECTED_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupLC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap2 : ContMap2) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BConnected1 : Connected1)
    (BConnected3 : Connected3) (BComponents1 : Components1) (BNbhdBase : NbhdBase)
    (BPaths1 : Paths1) (BLPC1 : LPC1) : ExceptT String IO LC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, ETA_AX, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_IN_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } :=
    D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET, SUBSET_INTER,
        SUBSET_REFL, SUBSET_TRANS, .. } := D.core4
  let { OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { QUOTIENT_IMP_CONTINUOUS_MAP, quotient_map, .. } := BQuotient
  let { HOMEOMORPHIC_MAPS_MAP, homeomorphic_map, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { CONNECTED_COMPONENTS_OF_MAXIMAL, CONNECTED_COMPONENTS_OF_SUBSET,
        CONNECTED_COMPONENT_OF_EQUIV, CONNECTED_COMPONENT_OF_EQ_EMPTY,
        CONNECTED_COMPONENT_OF_MAXIMAL, CONNECTED_COMPONENT_OF_REFL,
        CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE, CONNECTED_IN_CONNECTED_COMPONENT_OF,
        connected_components_of, .. } := BComponents1
  let { NEIGHBOURHOOD_BASE_OF, NEIGHBOURHOOD_BASE_OF_MONO, NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET,
        NEIGHBOURHOOD_BASE_OF_WITH_SUBSET, OPEN_NEIGHBOURHOOD_BASE_OF, neighbourhood_base_at,
        neighbourhood_base_of, .. } := BNbhdBase
  let { PATH_CONNECTED_IN_IMP_CONNECTED_IN, .. } := BPaths1
  let { locally_path_connected_space, .. } := BLPC1
  -- @@SCOPE END

  let weakly_locally_connected_at ← new_definition
   r"weakly_locally_connected_at x top <=>
    neighbourhood_base_at x (connected_in top) top"

  let locally_connected_at ← new_definition
   r"locally_connected_at x top <=>
    neighbourhood_base_at x
      (\u. open_in top u /\ connected_in top u ) top"

  let locally_connected_space ← new_definition
   r"locally_connected_space top <=>
        neighbourhood_base_of (connected_in top) top"

  let (LOCALLY_CONNECTED_SPACE_ALT,
       LOCALLY_CONNECTED_SPACE_EQ_OPEN_CONNECTED_COMPONENT_OF) ← CONJ_PAIR (← prove
   r"(!top:A topology.
        locally_connected_space top <=>
        neighbourhood_base_of
          (\u. open_in top u /\ connected_in top u) top) /\
   (!top:A topology.
        locally_connected_space top <=>
        !u x. open_in top u /\ x IN u
              ==> open_in top (connected_component_of (subtopology top u) x))"
   (SIMP_TAC [OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [AND_FORALL_THM, locally_connected_space] THEN
    REWRITE_TAC [NEIGHBOURHOOD_BASE_OF] THEN
    X_GEN_TAC (← q r"top:A topology") THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q ==> p) /\ (p ==> r) /\ (r ==> q) ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [SUBSET_REFL],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"y:A"] THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (fun th => tactic_of do
        let c ← liftExcept (last (CONJUNCTS
          (← GEN_REWRITE_RULE id [CONNECTED_COMPONENT_OF_EQUIV]
             (← GEN_REWRITE_RULE id [IN] th))))
        pure (SUBST1_TAC c)) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u:A->bool", ← q r"x:A"]) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [SUBSET]
          CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE)) THEN
        ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER],
        REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"w:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"w:A->bool") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN ASM SET_TAC [],
      DISCH_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"connected_component_of (subtopology top u) (x:A)") THEN
      ASM_SIMP_TAC [] THEN REPEAT CONJ_TAC THENL
       [W (MP_TAC o PART_MATCH rand CONNECTED_IN_CONNECTED_COMPONENT_OF o
          rand o snd) THEN
        SIMP_TAC [CONNECTED_IN_SUBTOPOLOGY],
        REWRITE_TAC [IN] THEN REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL] THEN
        REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
        ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET],
        W (MP_TAC o PART_MATCH lhand CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE o
          lhand o snd) THEN
        SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER]]]))

  let LOCALLY_CONNECTED_SPACE ← prove
   r"!top:A topology.
        locally_connected_space top <=>
        !v x. open_in top v /\ x IN v
              ==> ?u. open_in top u /\
                      connected_in top u /\
                      x IN u /\ u SUBSET v"
   (SIMP_TAC [LOCALLY_CONNECTED_SPACE_ALT, OPEN_NEIGHBOURHOOD_BASE_OF] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC])

  let LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE ← prove
   r"!top: A topology.
        locally_path_connected_space top ==> locally_connected_space top"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [locally_path_connected_space, locally_connected_space] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_OF_MONO) THEN
    SIMP_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN])

  let LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS ← prove
   r"!top:A topology.
        locally_connected_space top <=>
        !u c. open_in top u /\ c IN connected_components_of(subtopology top u)
              ==> open_in top c"
   (REWRITE_TAC [LOCALLY_CONNECTED_SPACE_EQ_OPEN_CONNECTED_COMPONENT_OF] THEN
    REWRITE_TAC [connected_components_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE ← prove
   r"!top x:A. locally_connected_space top
             ==> open_in top (connected_component_of top x)"
   (METIS_TAC [LOCALLY_CONNECTED_SPACE_EQ_OPEN_CONNECTED_COMPONENT_OF,
               SUBTOPOLOGY_TOPSPACE, OPEN_IN_TOPSPACE,
               OPEN_IN_EMPTY, CONNECTED_COMPONENT_OF_EQ_EMPTY])

  let OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE ← prove
   r"!top c:A->bool.
        locally_connected_space top /\ c IN connected_components_of top
        ==> open_in top c"
   (REWRITE_TAC [LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, SUBTOPOLOGY_TOPSPACE])

  let WEAKLY_LOCALLY_CONNECTED_AT ← prove
   r"!top x:A.
        weakly_locally_connected_at x top <=>
        !v. open_in top v /\ x IN v
            ==> ?u. open_in top u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?c. connected_in top c /\
                                c SUBSET v /\ x IN c /\ y IN c"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [neighbourhood_base_at, weakly_locally_connected_at] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"u:A->bool") THENL [ASM_MESON_TAC [SUBSET], STRIP_TAC] THEN
    EXISTS_TAC (← q r"connected_component_of (subtopology top v) (x:A)") THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MESON_TAC [CONNECTED_IN_CONNECTED_COMPONENT_OF,
                 CONNECTED_IN_SUBTOPOLOGY],
      REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x IN s ==> x IN t")) THEN
      MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY],
      MESON_TAC [CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE, TOPSPACE_SUBTOPOLOGY,
                 SUBSET_INTER]])

  let LOCALLY_CONNECTED_SPACE_IM_KLEINEN ← prove
   r"!top:A topology.
        locally_connected_space top <=>
        !v x. open_in top v /\ x IN v
            ==> ?u. open_in top u /\
                    x IN u /\ u SUBSET v /\
                    !y. y IN u
                        ==> ?c. connected_in top c /\
                                c SUBSET v /\ x IN c /\ y IN c"
   (REWRITE_TAC [locally_connected_space, neighbourhood_base_of] THEN
    GEN_TAC THEN REWRITE_TAC [← GSYM weakly_locally_connected_at] THEN
    REWRITE_TAC [WEAKLY_LOCALLY_CONNECTED_AT] THEN
    REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN
    EQ_TAC THEN REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let LOCALLY_CONNECTED_SPACE_OPEN_SUBSET ← prove
   r"!top s:A->bool.
        locally_connected_space top /\ open_in top s
        ==> locally_connected_space (subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_connected_space] THEN
    DISCH_THEN (MP_TAC o MATCH_MP NEIGHBOURHOOD_BASE_OF_OPEN_SUBSET) THEN
    GEN_REWRITE_TAC LAND_CONV [NEIGHBOURHOOD_BASE_OF_WITH_SUBSET] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_OF_MONO) THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, CONNECTED_IN_SUBTOPOLOGY,
              SUBSET_INTER])

  let LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        quotient_map(top,top') f /\ locally_connected_space top
        ==> locally_connected_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map] THEN
    REWRITE_TAC [LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS] THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"v:B->bool", ← q r"c:B->bool"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (fun th => W (MP_TAC o PART_MATCH (rand o rand) th o snd)) THEN
    ANTS_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
      ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN ASM SET_TAC [],
      DISCH_THEN (SUBST1_TAC o SYM)] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"x:A") THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"connected_component_of
        (subtopology top {z | z IN topspace top /\ (f:A->B) z IN v}) x") THEN
    REPEAT CONJ_TAC THENL
     [FIRST_X_ASSUM MATCH_MP_TAC THEN
      EXISTS_TAC (← q r"{z | z IN topspace top /\ (f:A->B) z IN v}") THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET, connected_components_of] THEN
      REWRITE_TAC [SIMPLE_IMAGE, ETA_AX] THEN MATCH_MP_TAC FUN_IN_IMAGE,
      GEN_REWRITE_TAC id [IN] THEN REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL],
      MATCH_MP_TAC (← SET_RULE (← q
       r"!v. s SUBSET u INTER {x | x IN u /\ f x IN v} /\ IMAGE f s SUBSET c
            ==> s SUBSET {x | x IN u /\ f x IN c}")) THEN
      EXISTS_TAC (← q r"v:B->bool") THEN
      REWRITE_TAC [CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE,
                   ← GSYM TOPSPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC CONNECTED_COMPONENTS_OF_MAXIMAL THEN
      EXISTS_TAC (← q r"subtopology top' (v:B->bool)") THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN EXISTS_TAC
         (← q r"subtopology top {z | z IN topspace top /\ (f:A->B) z IN v}") THEN
        REWRITE_TAC [CONNECTED_IN_CONNECTED_COMPONENT_OF] THEN
        REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
        SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
        MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
        MATCH_MP_TAC QUOTIENT_IMP_CONTINUOUS_MAP THEN
        ASM_REWRITE_TAC [quotient_map],
        REWRITE_TAC [← SET_RULE (← q
         r"~DISJOINT t (IMAGE f s) <=> ?x. x IN s /\ f x IN t")] THEN
        EXISTS_TAC (← q r"x:A") THEN ASM_REWRITE_TAC [] THEN
        GEN_REWRITE_TAC id [IN] THEN
        REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL]]] THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN ASM SET_TAC [])

  let LOCALLY_CONNECTED_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map (top,top') r /\ locally_connected_space top
        ==> locally_connected_space top'"
   (MESON_TAC [LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let HOMEOMORPHIC_LOCALLY_CONNECTED_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (locally_connected_space top <=>
             locally_connected_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, homeomorphic_map] THEN
    MESON_TAC [LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE])

  return { weakly_locally_connected_at, locally_connected_at, locally_connected_space,
           LOCALLY_CONNECTED_SPACE_ALT, LOCALLY_CONNECTED_SPACE_EQ_OPEN_CONNECTED_COMPONENT_OF,
           LOCALLY_CONNECTED_SPACE, LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE,
           LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS,
           OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE,
           OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE,
           WEAKLY_LOCALLY_CONNECTED_AT, LOCALLY_CONNECTED_SPACE_IM_KLEINEN,
           LOCALLY_CONNECTED_SPACE_OPEN_SUBSET, LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
           LOCALLY_CONNECTED_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_LOCALLY_CONNECTED_SPACE }

/- ------------------------------------------------------------------------- -/
/- Locally connected spaces, continued.  (metric.ml 26438-26525)             -/
/- ------------------------------------------------------------------------- -/

structure LC2 where
  LOCALLY_CONNECTED_SPACE_EUCLIDEANREAL : thm
  LOCALLY_CONNECTED_IS_REALINTERVAL : thm
  LOCALLY_CONNECTED_REAL_INTERVAL : thm
  LOCALLY_CONNECTED_SPACE_DISCRETE_TOPOLOGY : thm
  LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_AT : thm
  WEAKLY_LOCALLY_PATH_CONNECTED_IMP_WEAKLY_LOCALLY_CONNECTED_AT : thm
  INTERIOR_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT : thm
  FRONTIER_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT : thm
  deriving Inhabited

@[nospecialize]
def setupLC2 [HolBase] (D : MetricDeps) (BDiscrete : Discrete) (BSubtopology : Subtopology)
    (BClosure : Closure) (BInterior : Interior) (BFrontier : Frontier)
    (BConnected1 : Connected1) (BConnected3 : Connected3) (BComponents1 : Components1)
    (BComponents2 : Components2) (BNbhdBase : NbhdBase) (BPaths1 : Paths1) (BLPC1 : LPC1)
    (BLPC2 : LPC2) (BLC1 : LC1) : ExceptT String IO LC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, INTER_UNIONS, .. } := D.core2
  let { SUBSET_ANTISYM, SUBSET_INTER, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { IS_REALINTERVAL_INTERVAL, .. } := D.misc
  let { OPEN_IN_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } :=
    BSubtopology
  let { CLOSURE_OF_CLOSED_IN, .. } := BClosure
  let { INTERIOR_OF_MAXIMAL, INTERIOR_OF_MONO, INTERIOR_OF_SUBSET, INTERIOR_OF_SUBSET_TOPSPACE,
        OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { frontier_of, .. } := BFrontier
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_DISCRETE_TOPOLOGY, .. } := BConnected3
  let { CONNECTED_COMPONENTS_OF_MAXIMAL, CONNECTED_COMPONENTS_OF_SUBSET,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, UNIONS_CONNECTED_COMPONENTS_OF, .. } :=
    BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENTS_OF, .. } := BComponents2
  let { NEIGHBOURHOOD_BASE_AT_MONO, .. } := BNbhdBase
  let { PATH_CONNECTED_IN_IMP_CONNECTED_IN, .. } := BPaths1
  let { locally_path_connected_at, weakly_locally_path_connected_at, .. } := BLPC1
  let { LOCALLY_PATH_CONNECTED_IS_REALINTERVAL, LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL,
        .. } := BLPC2
  let { LOCALLY_CONNECTED_SPACE, LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS,
        LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE, locally_connected_at,
        weakly_locally_connected_at, .. } := BLC1
  -- @@SCOPE END

  let LOCALLY_CONNECTED_SPACE_EUCLIDEANREAL ← prove
   r"locally_connected_space euclideanreal"
   (SIMP_TAC [LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE,
              LOCALLY_PATH_CONNECTED_SPACE_EUCLIDEANREAL])

  let LOCALLY_CONNECTED_IS_REALINTERVAL ← prove
   r"!s. is_realinterval s
       ==> locally_connected_space(subtopology euclideanreal s)"
   (MESON_TAC [LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_SPACE,
               LOCALLY_PATH_CONNECTED_IS_REALINTERVAL])

  let LOCALLY_CONNECTED_REAL_INTERVAL ← prove
   r"(!a b. locally_connected_space
           (subtopology euclideanreal(real_interval[a,b]))) /\
   (!a b. locally_connected_space
           (subtopology euclideanreal(real_interval(a,b))))"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC LOCALLY_CONNECTED_IS_REALINTERVAL THEN
    REWRITE_TAC [IS_REALINTERVAL_INTERVAL])

  let LOCALLY_CONNECTED_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. locally_connected_space (discrete_topology u)"
   (GEN_TAC THEN REWRITE_TAC [LOCALLY_CONNECTED_SPACE] THEN
    SIMP_TAC [OPEN_IN_DISCRETE_TOPOLOGY, CONNECTED_IN_DISCRETE_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"{x:A}") THEN ASM SET_TAC [])

  let LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_AT ← prove
   r"!top x:a. locally_path_connected_at x top ==> locally_connected_at x top"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [locally_path_connected_at, locally_connected_at] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_AT_MONO) THEN
    SIMP_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN])

  let WEAKLY_LOCALLY_PATH_CONNECTED_IMP_WEAKLY_LOCALLY_CONNECTED_AT ← prove
   r"!top x:a. weakly_locally_path_connected_at x top
             ==> weakly_locally_connected_at x top"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [weakly_locally_path_connected_at,
                 weakly_locally_connected_at] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] NEIGHBOURHOOD_BASE_AT_MONO) THEN
    SIMP_TAC [PATH_CONNECTED_IN_IMP_CONNECTED_IN])

  let INTERIOR_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT ← prove
   r"!top s c:A->bool.
        locally_connected_space top /\
        c IN connected_components_of (subtopology top s)
        ==> top interior_of c = c INTER top interior_of s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    ASM_SIMP_TAC [SUBSET_INTER, INTERIOR_OF_MONO, INTERIOR_OF_SUBSET] THEN
    MP_TAC (← ISPEC (← q r"subtopology top (top interior_of s:A->bool)")
          UNIONS_CONNECTED_COMPONENTS_OF) THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, INTERIOR_OF_SUBSET_TOPSPACE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [UNIONS_SUBSET, INTER_UNIONS, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"d:A->bool") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"c INTER d:A->bool = {}") THEN
    ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"d SUBSET e ==> c INTER d SUBSET e")) THEN
    MATCH_MP_TAC INTERIOR_OF_MAXIMAL THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONNECTED_COMPONENTS_OF_MAXIMAL THEN
      EXISTS_TAC (← q r"subtopology top (s:A->bool)") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP
        CONNECTED_IN_CONNECTED_COMPONENTS_OF)) THEN
      ASM_SIMP_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
      ASM_MESON_TAC [SUBSET_TRANS, INTERIOR_OF_SUBSET],
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id
       [LOCALLY_CONNECTED_SPACE_OPEN_CONNECTED_COMPONENTS]) THEN
      EXISTS_TAC (← q r"top interior_of (s:A->bool)") THEN
      ASM_REWRITE_TAC [OPEN_IN_INTERIOR_OF]])

  let FRONTIER_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT ← prove
   r"!top s c:A->bool.
        locally_connected_space top /\
        closed_in top s /\
        c IN connected_components_of (subtopology top s)
        ==> top frontier_of c = c INTER top frontier_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier_of] THEN
    REWRITE_TAC [← SET_RULE (← q r"s INTER (t DIFF u) = s INTER t DIFF s INTER u")] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_CONNECTED_COMPONENTS_OF) THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CLOSURE_OF_CLOSED_IN] THEN
    ASM_SIMP_TAC [← GSYM INTERIOR_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT] THEN
    ASM SET_TAC [])

  return { LOCALLY_CONNECTED_SPACE_EUCLIDEANREAL, LOCALLY_CONNECTED_IS_REALINTERVAL,
           LOCALLY_CONNECTED_REAL_INTERVAL, LOCALLY_CONNECTED_SPACE_DISCRETE_TOPOLOGY,
           LOCALLY_PATH_CONNECTED_IMP_LOCALLY_CONNECTED_AT,
           WEAKLY_LOCALLY_PATH_CONNECTED_IMP_WEAKLY_LOCALLY_CONNECTED_AT,
           INTERIOR_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT,
           FRONTIER_OF_LOCALLY_CONNECTED_SUBSPACE_COMPONENT }

/- ------------------------------------------------------------------------- -/
/- Locally connected spaces: products and sums.  (metric.ml 26527-26716)     -/
/- ------------------------------------------------------------------------- -/

structure LC3 where
  LOCALLY_CONNECTED_SPACE_PROD_TOPOLOGY : thm
  LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY : thm
  LOCALLY_CONNECTED_SPACE_SUM_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupLC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BOpenClosed1 : OpenClosed1)
    (BProd1 : Prod1) (BProd2 : Prod2) (BProduct1 : Product1) (BProduct2 : Product2)
    (BProduct3 : Product3) (BSumTop : SumTop) (BEmbedding : Embedding)
    (BConnected1 : Connected1) (BConnected3 : Connected3) (BConnected4 : Connected4)
    (BNbhdBase : NbhdBase) (BLC1 : LC1) : ExceptT String IO LC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, CROSS_EQ_EMPTY, ETA_AX, FINITE_SUBSET, FINITE_UNION, FORALL_IN_IMAGE,
        .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP,
        IN_CROSS, IN_ELIM_PAIR_THM, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_REFL, SUBSET_TRANS, cartesian_product,
        disjoint_union, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP, FORALL_PAIR_THM, RIGHT_IMP_EXISTS_THM, .. } :=
    D.core5
  let { OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { open_map, .. } := BOpenClosed1
  let { OPEN_IN_CROSS, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { QUOTIENT_MAP_FST, QUOTIENT_MAP_SND, .. } := BProd2
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, OPEN_IN_CARTESIAN_PRODUCT_GEN,
        OPEN_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { QUOTIENT_MAP_PRODUCT_PROJECTION, .. } := BProduct3
  let { CONTINUOUS_MAP_COMPONENT_INJECTION, FORALL_OPEN_IN_SUM_TOPOLOGY,
        OPEN_MAP_COMPONENT_INJECTION, .. } := BSumTop
  let { TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT, .. } := BEmbedding
  let { CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_TOPSPACE, .. } := BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { CONNECTED_IN_CARTESIAN_PRODUCT, CONNECTED_IN_CROSS, .. } := BConnected4
  let { NEIGHBOURHOOD_BASE_OF, .. } := BNbhdBase
  let { HOMEOMORPHIC_LOCALLY_CONNECTED_SPACE, LOCALLY_CONNECTED_SPACE_OPEN_SUBSET,
        LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, locally_connected_space, .. } := BLC1
  -- @@SCOPE END

  let LOCALLY_CONNECTED_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
      locally_connected_space (prod_topology top1 top2) <=>
      topspace (prod_topology top1 top2) = {} \/
      locally_connected_space top1 /\ locally_connected_space top2"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_REWRITE_TAC [locally_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE
     [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
        LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE))
      THENL [EXISTS_TAC (← q r"FST:A#B->A"), EXISTS_TAC (← q r"SND:A#B->B")] THEN
      ASM_REWRITE_TAC [QUOTIENT_MAP_FST, QUOTIENT_MAP_SND],
      FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:B") THEN DISCH_TAC THEN X_GEN_TAC (← q r"w:A") THEN DISCH_TAC THEN
      REWRITE_TAC [locally_connected_space, FORALL_PAIR_THM, IN_CROSS,
        NEIGHBOURHOOD_BASE_OF, TOPSPACE_PROD_TOPOLOGY] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"uv:A#B->bool", ← q r"x:A", ← q r"y:B"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [OPEN_IN_PROD_TOPOLOGY_ALT] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"w1:A->bool", ← q r"w2:B->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w2:B->bool", ← q r"y:B"]) THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"w1:A->bool", ← q r"x:A"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u1:A->bool", ← q r"k1:A->bool"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u2:B->bool", ← q r"k2:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(u1:A->bool) CROSS (u2:B->bool)") THEN
      EXISTS_TAC (← q r"(k1:A->bool) CROSS (k2:B->bool)") THEN
      ASM_SIMP_TAC [OPEN_IN_CROSS, CONNECTED_IN_CROSS,
                    IN_CROSS, SUBSET_CROSS] THEN
      TRANS_TAC SUBSET_TRANS (← q r"(w1 CROSS w2):A#B->bool") THEN
      ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [SUBSET_CROSS]])

  let LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        locally_connected_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        FINITE {i | i IN k /\ ~connected_space(tops i)} /\
        !i. i IN k ==> locally_connected_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THENL
     [ASM_REWRITE_TAC [locally_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET, NOT_IN_EMPTY],
      ALL_TAC] THEN
    ASM_REWRITE_TAC [locally_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A")) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPECL
         [← q r"topspace(product_topology k (tops:K->A topology))", ← q r"z:K->A"]) THEN
        ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:(K->A)->bool", ← q r"c:(K->A)->bool"] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:K->A") o
          REWRITE_RULE [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"v:K->A->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN
        ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
        DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o ISPECL [← q r"\x:K->A. x i", ← q r"(tops:K->A topology) i"] o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
              CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION,
                      ← GSYM CONNECTED_IN_TOPSPACE] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← SET_RULE (← q r"v = u ==> v SUBSET s /\ s SUBSET u ==> s = u"))) THEN
        CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"IMAGE (\x:K->A. x i) u") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN TRANS_TAC SUBSET_TRANS
           (← q r"IMAGE (\x:K->A. x i) (cartesian_product k v)") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN
          REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
          ASM SET_TAC [],
          TRANS_TAC SUBSET_TRANS
            (← q r"IMAGE (\x:K->A. x i) (topspace(product_topology k tops))") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET, CONNECTED_IN_SUBSET_TOPSPACE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
          ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                           TOPSPACE_PRODUCT_TOPOLOGY] THEN
          REWRITE_TAC [o_THM, SUBSET_REFL]],
        X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM locally_connected_space, ETA_AX,
                     ← GSYM NEIGHBOURHOOD_BASE_OF] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM locally_connected_space, ETA_AX,
                                      ← GSYM NEIGHBOURHOOD_BASE_OF]) THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          (← REWRITE_RULE [CONJ_ASSOC]
                  LOCALLY_CONNECTED_SPACE_QUOTIENT_MAP_IMAGE)))  THEN
        EXISTS_TAC (← q r"\x:K->A. x i") THEN
        ASM_SIMP_TAC [OPEN_MAP_PRODUCT_PROJECTION, TOPSPACE_PRODUCT_TOPOLOGY,
                      QUOTIENT_MAP_PRODUCT_PROJECTION,
                      IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
        ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM]],
      STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"ww:(K->A)->bool", ← q r"z:K->A"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      GEN_REWRITE_TAC LAND_CONV [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"z:K->A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:K->A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN
       (← q r"!i. i IN k
            ==> ?u c. open_in (tops i) u /\
                      connected_in (tops i) c /\
                      ((z:K->A) i) IN u /\
                      u SUBSET c /\
                      c SUBSET w i /\
                      (w i = topspace(tops i) /\ connected_space(tops i)
                       ==> u = topspace(tops i) /\ c = topspace(tops i))")
      MP_TAC THENL
       [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"i:K", ← q r"(w:K->A->bool) i"] o
          GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_FORALL_THM]) THEN
        ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"(z:K->A) i")) THEN
        ANTS_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o
           GEN_REWRITE_RULE RAND_CONV [cartesian_product]) THEN
          ASM_SIMP_TAC [IN_ELIM_THM],
          ASM_CASES_TAC (← q r"connected_space((tops:K->A topology) i)") THEN
          ASM_REWRITE_TAC [] THEN
          ASM_CASES_TAC (← q r"(w:K->A->bool) i = topspace(tops i)") THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
          REPEAT (EXISTS_TAC (← q r"topspace((tops:K->A topology) i)")) THEN
          ASM_REWRITE_TAC [CONNECTED_IN_TOPSPACE, SUBSET_REFL] THEN
          REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM]) THEN
          ASM SET_TAC []],
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:K->A->bool", ← q r"c:K->A->bool"] THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"cartesian_product k (u:K->A->bool)",
        ← q r"cartesian_product k (c:K->A->bool)"] THEN
      ASM_SIMP_TAC [CONNECTED_IN_CARTESIAN_PRODUCT] THEN
      ASM_SIMP_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN REPEAT CONJ_TAC THENL
       [DISJ2_TAC THEN ASM_SIMP_TAC [] THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{i | i IN k /\ ~connected_space (tops i)} UNION
                    {i | i IN k /\ ~((w:K->A->bool) i = topspace (tops i))}") THEN
        ASM_REWRITE_TAC [FINITE_UNION] THEN ASM SET_TAC [],
        UNDISCH_TAC (← q r"(z:K->A) IN cartesian_product k w") THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN ASM SET_TAC [],
        TRANS_TAC SUBSET_TRANS (← q r"cartesian_product k (w:K->A->bool)") THEN
        ASM_REWRITE_TAC [] THEN REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
        ASM SET_TAC []]])

  let LOCALLY_CONNECTED_SPACE_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        locally_connected_space(sum_topology k top) <=>
        !i. i IN k ==> locally_connected_space(top i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_LOCALLY_CONNECTED_SPACE] THEN
      SIMP_TAC [LOCALLY_CONNECTED_SPACE_OPEN_SUBSET],
      REWRITE_TAC [locally_connected_space, NEIGHBOURHOOD_BASE_OF] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_OPEN_IN_SUM_TOPOLOGY] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"w:K->A->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [FORALL_PAIR_THM, disjoint_union, IN_ELIM_PAIR_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"i:K", ← q r"x:A"] THEN STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K"))) THEN
      ASM_REWRITE_TAC [] THEN REPEAT DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(w:K->A->bool) i")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (\x. (i:K),(x:A)) u") THEN
      EXISTS_TAC (← q r"IMAGE (\x. (i:K),(x:A)) v") THEN
      ASM_SIMP_TAC [IMAGE_SUBSET] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_ELIM_PAIR_THM] THEN
      ASM_REWRITE_TAC [← GSYM SUBSET] THEN REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [open_map, RIGHT_IMP_FORALL_THM, IMP_IMP]
          OPEN_MAP_COMPONENT_INJECTION) THEN
        ASM_REWRITE_TAC [],
        MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
        EXISTS_TAC (← q r"(top:K->A topology) i") THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_COMPONENT_INJECTION],
        ASM SET_TAC []]])

  return { LOCALLY_CONNECTED_SPACE_PROD_TOPOLOGY, LOCALLY_CONNECTED_SPACE_PRODUCT_TOPOLOGY,
           LOCALLY_CONNECTED_SPACE_SUM_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Quasi-components.  (metric.ml 26718-26912)                                -/
/- ------------------------------------------------------------------------- -/

structure QC1 where
  quasi_component_of : thm
  quasi_components_of : thm
  QUASI_COMPONENT_IN_TOPSPACE : thm
  QUASI_COMPONENT_OF_REFL : thm
  QUASI_COMPONENT_OF_SYM : thm
  QUASI_COMPONENT_OF_TRANS : thm
  QUASI_COMPONENT_OF_SUBSET_TOPSPACE : thm
  QUASI_COMPONENT_OF_EQ_EMPTY : thm
  QUASI_COMPONENT_OF : thm
  QUASI_COMPONENT_OF_ALT : thm
  QUASI_COMPONENT_OF_SET : thm
  QUASI_COMPONENT_OF_SEPARATED : thm
  QUASI_COMPONENT_OF_SUBTOPOLOGY : thm
  QUASI_COMPONENT_OF_MONO : thm
  QUASI_COMPONENT_OF_EQUIV : thm
  QUASI_COMPONENT_OF_DISJOINT : thm
  QUASI_COMPONENT_OF_EQ : thm
  UNIONS_QUASI_COMPONENTS_OF : thm
  PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF : thm
  COMPLEMENT_QUASI_COMPONENTS_OF_UNIONS : thm
  NONEMPTY_QUASI_COMPONENTS_OF : thm
  QUASI_COMPONENTS_OF_SUBSET : thm
  QUASI_COMPONENT_IN_QUASI_COMPONENTS_OF : thm
  QUASI_COMPONENTS_OF_EQ_EMPTY : thm
  QUASI_COMPONENTS_OF_EMPTY_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupQC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BSeparated : Separated) : ExceptT String IO QC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DIFF_UNIONS_PAIRWISE_DISJOINT, DISJOINT, EXTENSION, FORALL_IN_GSPEC, FUN_EQ_THM, .. } :=
    D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_INTERS, NOT_IN_EMPTY,
        .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM,
        UNIONS_1, UNIONS_GSPEC, UNIONS_SUBSET, UNWIND_THM2, pairwise, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_TOPSPACE, closed_in, .. } :=
    BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { SEPARATED_IN_FULL, SEPARATED_IN_OPEN_SETS, .. } := BSeparated
  -- @@SCOPE END

  let quasi_component_of ← new_definition
   r"quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        !t. closed_in top t /\ open_in top t ==> (x IN t <=> y IN t)"

  let quasi_components_of ← new_definition
   r"quasi_components_of top =
    {quasi_component_of top x |x| x IN topspace top}"

  let QUASI_COMPONENT_IN_TOPSPACE ← prove
   r"!top x y:A.
        quasi_component_of top x y
        ==> x IN topspace top /\ y IN topspace top"
   (REWRITE_TAC [quasi_component_of] THEN MESON_TAC [])

  let QUASI_COMPONENT_OF_REFL ← prove
   r"!top x:A. quasi_component_of top x x <=> x IN topspace top"
   (REWRITE_TAC [quasi_component_of] THEN MESON_TAC [])

  let QUASI_COMPONENT_OF_SYM ← prove
   r"!top x y:A.
    quasi_component_of top x y <=> quasi_component_of top y x"
   (REWRITE_TAC [quasi_component_of] THEN MESON_TAC [])

  let QUASI_COMPONENT_OF_TRANS ← prove
   r"!top x y z:A.
        quasi_component_of top x y /\ quasi_component_of top y z
        ==> quasi_component_of top x z"
   (REWRITE_TAC [quasi_component_of] THEN MESON_TAC [])

  let QUASI_COMPONENT_OF_SUBSET_TOPSPACE ← prove
   r"!top x. (quasi_component_of top x) SUBSET topspace top"
   (REWRITE_TAC [SUBSET, IN] THEN MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE, IN])

  let QUASI_COMPONENT_OF_EQ_EMPTY ← prove
   r"!top x. quasi_component_of top x = {} <=> ~(x IN topspace top)"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [IN, QUASI_COMPONENT_OF_REFL, QUASI_COMPONENT_IN_TOPSPACE])

  let QUASI_COMPONENT_OF ← prove
   r"!top x y:A.
        quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        !t. x IN t /\ closed_in top t /\ open_in top t ==> y IN t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quasi_component_of] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"topspace top DIFF s:A->bool")) THEN
    ASM_REWRITE_TAC [IN_DIFF] THEN
    ASM_MESON_TAC [OPEN_IN_CLOSED_IN_EQ, closed_in])

  let QUASI_COMPONENT_OF_ALT ← prove
   r"!top x y:A.
        quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        ~(?u v. open_in top u /\ open_in top v /\
                u UNION v = topspace top /\
                DISJOINT u v /\ x IN u /\ y IN v)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [QUASI_COMPONENT_OF] THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(y:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q
     r"u UNION v = s /\ DISJOINT u v /\ x IN u /\ y IN v <=>
      u SUBSET s /\ v = s DIFF u /\ x IN u /\ y IN s /\ ~(y IN u)")] THEN
    ONCE_REWRITE_TAC [← TAUT (← q
     r"p /\ q /\ r /\ s /\ t <=> s /\ p /\ q /\ r /\ t")] THEN
    REWRITE_TAC [UNWIND_THM2, closed_in] THEN SET_TAC [])

  let QUASI_COMPONENT_OF_SET ← prove
   r"!top x:A.
        quasi_component_of top x =
        if x IN topspace top
        then INTERS {t | closed_in top t /\ open_in top t /\ x IN t}
        else {}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"y:A") THEN
    GEN_REWRITE_TAC LAND_CONV [IN] THEN REWRITE_TAC [QUASI_COMPONENT_OF] THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN
    ASM_REWRITE_TAC [IN_INTERS, NOT_IN_EMPTY, IN_ELIM_THM] THEN
    ASM_MESON_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE])

  let QUASI_COMPONENT_OF_SEPARATED ← prove
   r"!top x y:A.
        quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        ~(?u v. separated_in top u v /\ u UNION v = topspace top /\
                x IN u /\ y IN v)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [QUASI_COMPONENT_OF_ALT] THEN
    MESON_TAC [SEPARATED_IN_OPEN_SETS, SEPARATED_IN_FULL])

  let QUASI_COMPONENT_OF_SUBTOPOLOGY ← prove
   r"!top s x y:A.
        quasi_component_of (subtopology top s) x y
        ==> quasi_component_of top x y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quasi_component_of] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s INTER t:A->bool")) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED])

  let QUASI_COMPONENT_OF_MONO ← prove
   r"!top s t x y:A.
        quasi_component_of (subtopology top s) x y /\ s SUBSET t
        ==> quasi_component_of (subtopology top t) x y"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ_ALT] THEN DISCH_THEN (SUBST1_TAC o
     MATCH_MP (← SET_RULE (← q r"s SUBSET t ==> s = t INTER s"))) THEN
    REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF_SUBTOPOLOGY])

  let QUASI_COMPONENT_OF_EQUIV ← prove
   r"!top x y:A.
        quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        quasi_component_of top x = quasi_component_of top y"
   (REWRITE_TAC [FUN_EQ_THM] THEN
    MESON_TAC [QUASI_COMPONENT_OF_REFL, QUASI_COMPONENT_OF_TRANS,
               QUASI_COMPONENT_OF_SYM])

  let QUASI_COMPONENT_OF_DISJOINT ← prove
   r"!top x y:A.
        DISJOINT (quasi_component_of top x)
                 (quasi_component_of top y) <=>
        ~(quasi_component_of top x y)"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    REWRITE_TAC [IN] THEN
    MESON_TAC [QUASI_COMPONENT_OF_SYM, QUASI_COMPONENT_OF_TRANS])

  let QUASI_COMPONENT_OF_EQ ← prove
   r"!top x y:A.
        quasi_component_of top x = quasi_component_of top y <=>
        ~(x IN topspace top) /\ ~(y IN topspace top) \/
        x IN topspace top /\ y IN topspace top /\
        quasi_component_of top x y"
   (MESON_TAC [QUASI_COMPONENT_OF_REFL, QUASI_COMPONENT_OF_EQUIV,
               QUASI_COMPONENT_OF_EQ_EMPTY])

  let UNIONS_QUASI_COMPONENTS_OF ← prove
   r"!top:A topology. UNIONS (quasi_components_of top) = topspace top"
   (GEN_TAC THEN REWRITE_TAC [quasi_components_of] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC,
                 QUASI_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:A") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [QUASI_COMPONENT_OF_REFL])

  let PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF ← prove
   r"!top:A topology. pairwise DISJOINT (quasi_components_of top)"
   (SIMP_TAC [pairwise, IMP_CONJ, quasi_components_of,
              RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [QUASI_COMPONENT_OF_EQ, QUASI_COMPONENT_OF_DISJOINT])

  let COMPLEMENT_QUASI_COMPONENTS_OF_UNIONS ← prove
   r"!top c:A->bool.
      c IN quasi_components_of top
      ==> topspace top DIFF c = UNIONS (quasi_components_of top DELETE c)"
   (REWRITE_TAC [← SET_RULE (← q r"s DELETE a = s DIFF {a}")] THEN
    ASM_SIMP_TAC [← GSYM DIFF_UNIONS_PAIRWISE_DISJOINT,
                  PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF, SING_SUBSET] THEN
    REWRITE_TAC [UNIONS_QUASI_COMPONENTS_OF, UNIONS_1])

  let NONEMPTY_QUASI_COMPONENTS_OF ← prove
   r"!top c:A->bool. c IN quasi_components_of top ==> ~(c = {})"
   (SIMP_TAC [quasi_components_of, FORALL_IN_GSPEC,
              QUASI_COMPONENT_OF_EQ_EMPTY])

  let QUASI_COMPONENTS_OF_SUBSET ← prove
   r"!top c:A->bool. c IN quasi_components_of top ==> c SUBSET topspace top"
   (SIMP_TAC [quasi_components_of, FORALL_IN_GSPEC,
              QUASI_COMPONENT_OF_SUBSET_TOPSPACE])

  let QUASI_COMPONENT_IN_QUASI_COMPONENTS_OF ← prove
   r"!top a:A.
        quasi_component_of top a IN quasi_components_of top <=>
        a IN topspace top"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [← GSYM QUASI_COMPONENT_OF_EQ_EMPTY] THEN
      MESON_TAC [NONEMPTY_QUASI_COMPONENTS_OF],
      REWRITE_TAC [quasi_components_of] THEN SET_TAC []])

  let QUASI_COMPONENTS_OF_EQ_EMPTY ← prove
   r"!top:A topology. quasi_components_of top = {} <=> topspace top = {}"
   (REWRITE_TAC [quasi_components_of] THEN SET_TAC [])

  let QUASI_COMPONENTS_OF_EMPTY_SPACE ← prove
   r"!top:A topology. topspace top = {} ==> quasi_components_of top = {}"
   (REWRITE_TAC [QUASI_COMPONENTS_OF_EQ_EMPTY])

  return { quasi_component_of, quasi_components_of, QUASI_COMPONENT_IN_TOPSPACE,
           QUASI_COMPONENT_OF_REFL, QUASI_COMPONENT_OF_SYM, QUASI_COMPONENT_OF_TRANS,
           QUASI_COMPONENT_OF_SUBSET_TOPSPACE, QUASI_COMPONENT_OF_EQ_EMPTY, QUASI_COMPONENT_OF,
           QUASI_COMPONENT_OF_ALT, QUASI_COMPONENT_OF_SET, QUASI_COMPONENT_OF_SEPARATED,
           QUASI_COMPONENT_OF_SUBTOPOLOGY, QUASI_COMPONENT_OF_MONO, QUASI_COMPONENT_OF_EQUIV,
           QUASI_COMPONENT_OF_DISJOINT, QUASI_COMPONENT_OF_EQ, UNIONS_QUASI_COMPONENTS_OF,
           PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF, COMPLEMENT_QUASI_COMPONENTS_OF_UNIONS,
           NONEMPTY_QUASI_COMPONENTS_OF, QUASI_COMPONENTS_OF_SUBSET,
           QUASI_COMPONENT_IN_QUASI_COMPONENTS_OF, QUASI_COMPONENTS_OF_EQ_EMPTY,
           QUASI_COMPONENTS_OF_EMPTY_SPACE }

/- ------------------------------------------------------------------------- -/
/- Quasi-components, continued.  (metric.ml 26914-27116)                     -/
/- ------------------------------------------------------------------------- -/

structure QC2 where
  CLOSED_IN_QUASI_COMPONENT_OF : thm
  CLOSED_IN_QUASI_COMPONENTS_OF : thm
  OPEN_IN_FINITE_QUASI_COMPONENTS : thm
  QUASI_COMPONENT_OF_EQ_OVERLAP : thm
  QUASI_COMPONENT_OF_NONOVERLAP : thm
  QUASI_COMPONENT_OF_OVERLAP : thm
  QUASI_COMPONENTS_OF_DISJOINT : thm
  QUASI_COMPONENTS_OF_OVERLAP : thm
  PAIRWISE_SEPARATED_QUASI_COMPONENTS_OF : thm
  CARD_LE_QUASI_COMPONENTS_OF_TOPSPACE : thm
  FINITE_QUASI_COMPONENTS_OF_FINITE : thm
  CONNECTED_IMP_QUASI_COMPONENT_OF : thm
  CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF : thm
  QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS : thm
  QUASI_COMPONENTS_AS_CONNECTED_COMPONENTS_UNIONS : thm
  PATH_IMP_QUASI_COMPONENT_OF : thm
  PATH_COMPONENT_SUBSET_QUASI_COMPONENT_OF : thm
  CONNECTED_SPACE_IFF_QUASI_COMPONENT : thm
  CONNECTED_SPACE_IMP_QUASI_COMPONENT_OF : thm
  CONNECTED_SPACE_QUASI_COMPONENT_SET : thm
  CONNECTED_SPACE_IFF_QUASI_COMPONENTS_EQ : thm
  QUASI_COMPONENTS_OF_SUBSET_SING : thm
  CONNECTED_SPACE_IFF_QUASI_COMPONENTS_SUBSET_SING : thm
  QUASI_COMPONENTS_OF_EQ_SING : thm
  deriving Inhabited

@[nospecialize]
def setupQC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSeparated : Separated)
    (BConnected1 : Connected1) (BConnected3 : Connected3) (BComponents1 : Components1)
    (BPathComp2 : PathComp2) (BQC1 : QC1) : ExceptT String IO QC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT, EMPTY_SUBSET, FINITE_DELETE, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, IN_DELETE, IN_ELIM_THM, IN_INTER, MEMBER_NOT_EMPTY, .. } :=
    D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, UNIONS_1, UNIONS_GSPEC,
        UNIONS_SUBSET, pairwise, .. } := D.core4
  let { CARD_LE_FINITE, CARD_LE_RELATIONAL_FULL, .. } := D.lib
  let { CLOSED_IN_EMPTY, CLOSED_IN_INTERS, CLOSED_IN_TOPSPACE, CLOSED_IN_UNIONS,
        OPEN_IN_CLOSED_IN_EQ, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { SEPARATED_IN_CLOSED_SETS, .. } := BSeparated
  let { CONNECTED_SPACE_CLOPEN_IN, .. } := BConnected1
  let { CONNECTED_IN_CLOPEN_CASES, .. } := BConnected3
  let { CONNECTED_COMPONENT_IN_TOPSPACE, CONNECTED_COMPONENT_OF_REFL, connected_component_of,
        connected_components_of, .. } := BComponents1
  let { PATH_IMP_CONNECTED_COMPONENT_OF, .. } := BPathComp2
  let { COMPLEMENT_QUASI_COMPONENTS_OF_UNIONS, NONEMPTY_QUASI_COMPONENTS_OF,
        PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF, QUASI_COMPONENTS_OF_EMPTY_SPACE,
        QUASI_COMPONENTS_OF_EQ_EMPTY, QUASI_COMPONENTS_OF_SUBSET, QUASI_COMPONENT_IN_TOPSPACE,
        QUASI_COMPONENT_OF, QUASI_COMPONENT_OF_DISJOINT, QUASI_COMPONENT_OF_EQ,
        QUASI_COMPONENT_OF_EQUIV, QUASI_COMPONENT_OF_SET, QUASI_COMPONENT_OF_SUBSET_TOPSPACE,
        UNIONS_QUASI_COMPONENTS_OF, quasi_components_of, .. } := BQC1
  -- @@SCOPE END

  let CLOSED_IN_QUASI_COMPONENT_OF ← prove
   r"!top x:A. closed_in top (quasi_component_of top x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [QUASI_COMPONENT_OF_SET] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [CLOSED_IN_EMPTY] THEN
    MATCH_MP_TAC CLOSED_IN_INTERS THEN
    SIMP_TAC [IN_ELIM_THM, ← GSYM MEMBER_NOT_EMPTY] THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE])

  let CLOSED_IN_QUASI_COMPONENTS_OF ← prove
   r"!top c:A->bool.
        c IN quasi_components_of top ==> closed_in top c"
   (REWRITE_TAC [quasi_components_of, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [CLOSED_IN_QUASI_COMPONENT_OF])

  let OPEN_IN_FINITE_QUASI_COMPONENTS ← prove
   r"!top c:A->bool.
        FINITE(quasi_components_of top) /\
        c IN quasi_components_of top
        ==> open_in top c"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_CLOSED_IN_EQ, QUASI_COMPONENTS_OF_SUBSET] THEN
    ASM_SIMP_TAC [COMPLEMENT_QUASI_COMPONENTS_OF_UNIONS] THEN
    MATCH_MP_TAC CLOSED_IN_UNIONS THEN
    ASM_SIMP_TAC [FINITE_DELETE, IN_DELETE, CLOSED_IN_QUASI_COMPONENTS_OF])

  let QUASI_COMPONENT_OF_EQ_OVERLAP ← prove
   r"!top x y:A.
      quasi_component_of top x = quasi_component_of top y <=>
      ~(x IN topspace top) /\ ~(y IN topspace top) \/
      ~(quasi_component_of top x INTER quasi_component_of top y = {})"
   (REWRITE_TAC [← GSYM DISJOINT, QUASI_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF_EQ] THEN
    MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE])

  let QUASI_COMPONENT_OF_NONOVERLAP ← prove
   r"!top x y:A.
     quasi_component_of top x INTER quasi_component_of top y = {} <=>
     ~(x IN topspace top) \/ ~(y IN topspace top) \/
     ~(quasi_component_of top x = quasi_component_of top y)"
   (REWRITE_TAC [← GSYM DISJOINT, QUASI_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF_EQ] THEN
    MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE])

  let QUASI_COMPONENT_OF_OVERLAP ← prove
   r"!top x y:A.
    ~(quasi_component_of top x INTER quasi_component_of top y = {}) <=>
    x IN topspace top /\ y IN topspace top /\
    quasi_component_of top x = quasi_component_of top y"
   (REWRITE_TAC [← GSYM DISJOINT, QUASI_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF_EQ] THEN
    MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE])

  let QUASI_COMPONENTS_OF_DISJOINT ← prove
   r"!top c c'.
        c IN quasi_components_of top /\ c' IN quasi_components_of top
        ==> (DISJOINT c c' <=> ~(c = c'))"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, quasi_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, QUASI_COMPONENT_OF_NONOVERLAP])

  let QUASI_COMPONENTS_OF_OVERLAP ← prove
   r"!top c c'.
        c IN quasi_components_of top /\ c' IN quasi_components_of top
        ==> (~(c INTER c' = {}) <=> c = c')"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, quasi_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, QUASI_COMPONENT_OF_NONOVERLAP])

  let PAIRWISE_SEPARATED_QUASI_COMPONENTS_OF ← prove
   r"!top:A topology.
        pairwise (separated_in top) (quasi_components_of top)"
   (REWRITE_TAC [pairwise] THEN
    SIMP_TAC [CLOSED_IN_QUASI_COMPONENTS_OF, SEPARATED_IN_CLOSED_SETS] THEN
    REWRITE_TAC [← GSYM pairwise, PAIRWISE_DISJOINT_QUASI_COMPONENTS_OF])

  let CARD_LE_QUASI_COMPONENTS_OF_TOPSPACE ← prove
   r"!top:A topology. quasi_components_of top <=_c topspace top"
   (GEN_TAC THEN MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"(IN):A->(A->bool)->bool") THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP QUASI_COMPONENTS_OF_SUBSET) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_QUASI_COMPONENTS_OF) THEN
      SET_TAC [],
      MESON_TAC [← REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY, IN_INTER]
                  QUASI_COMPONENTS_OF_OVERLAP]])

  let FINITE_QUASI_COMPONENTS_OF_FINITE ← prove
   r"!top:A topology.
        FINITE(topspace top) ==> FINITE(quasi_components_of top)"
   (GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_FINITE) THEN
    REWRITE_TAC [CARD_LE_QUASI_COMPONENTS_OF_TOPSPACE])

  let CONNECTED_IMP_QUASI_COMPONENT_OF ← prove
   r"!top x y:A. connected_component_of top x y ==> quasi_component_of top x y"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (STRIP_ASSUME_TAC o MATCH_MP CONNECTED_COMPONENT_IN_TOPSPACE) THEN
    ASM_REWRITE_TAC [QUASI_COMPONENT_OF] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [connected_component_of]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool", ← q r"t:A->bool"]
          CONNECTED_IN_CLOPEN_CASES) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF ← prove
   r"!top x:A. connected_component_of top x SUBSET quasi_component_of top x"
   (REWRITE_TAC [SUBSET, IN, CONNECTED_IMP_QUASI_COMPONENT_OF])

  let QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS ← prove
   r"!top x:A.
        quasi_component_of top x =
        UNIONS {connected_component_of top y |y| quasi_component_of top x y}"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC id [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN
      REWRITE_TAC [IN] THEN DISCH_TAC THEN EXISTS_TAC (← q r"y:A") THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_OF_REFL, QUASI_COMPONENT_IN_TOPSPACE],
      X_GEN_TAC (← q r"y:A") THEN SIMP_TAC [QUASI_COMPONENT_OF_EQUIV] THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF]])

  let QUASI_COMPONENTS_AS_CONNECTED_COMPONENTS_UNIONS ← prove
   r"!top c:A->bool.
        c IN quasi_components_of top
        ==> ?t. t SUBSET connected_components_of top /\ UNIONS t = c"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quasi_components_of, IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
    EXISTS_TAC
     (← q r"{connected_component_of top (y:A) |y| quasi_component_of top x y}") THEN
    REWRITE_TAC [← GSYM QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS] THEN
    REWRITE_TAC [SUBSET, connected_components_of, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    ASM_MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE])

  let PATH_IMP_QUASI_COMPONENT_OF ← prove
   r"!top x y:A. path_component_of top x y ==> quasi_component_of top x y"
   (MESON_TAC [CONNECTED_IMP_QUASI_COMPONENT_OF,
               PATH_IMP_CONNECTED_COMPONENT_OF])

  let PATH_COMPONENT_SUBSET_QUASI_COMPONENT_OF ← prove
   r"!top x:A. path_component_of top x SUBSET quasi_component_of top x"
   (REWRITE_TAC [SUBSET, IN, PATH_IMP_QUASI_COMPONENT_OF])

  let CONNECTED_SPACE_IFF_QUASI_COMPONENT ← prove
   r"!top:A topology.
        connected_space top <=>
        !x y. x IN topspace top /\ y IN topspace top
              ==> quasi_component_of top x y"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_SPACE_CLOPEN_IN] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF] THEN
    REWRITE_TAC [closed_in] THEN SET_TAC [])

  let CONNECTED_SPACE_IMP_QUASI_COMPONENT_OF ← prove
   r"!top a b:A.
        connected_space top /\ a IN topspace top /\ b IN topspace top
        ==> quasi_component_of top a b"
   (MESON_TAC [CONNECTED_SPACE_IFF_QUASI_COMPONENT])

  let CONNECTED_SPACE_QUASI_COMPONENT_SET ← prove
   r"!top. connected_space top <=>
         !x:A. x IN topspace top
               ==> quasi_component_of top x = topspace top"
   (REWRITE_TAC [CONNECTED_SPACE_IFF_QUASI_COMPONENT,
                 ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [QUASI_COMPONENT_OF_SUBSET_TOPSPACE] THEN SET_TAC [])

  let CONNECTED_SPACE_IFF_QUASI_COMPONENTS_EQ ← prove
   r"!top:A topology.
        connected_space top <=>
        !c c'. c IN quasi_components_of top /\
               c' IN quasi_components_of top
               ==> c = c'"
   (REWRITE_TAC [quasi_components_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, CONNECTED_SPACE_IFF_QUASI_COMPONENT] THEN
    SIMP_TAC [QUASI_COMPONENT_OF_EQ] THEN MESON_TAC [])

  let QUASI_COMPONENTS_OF_SUBSET_SING ← prove
   r"!top s:A->bool.
        quasi_components_of top SUBSET {s} <=>
        connected_space top /\ (topspace top = {} \/ topspace top = s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONNECTED_SPACE_IFF_QUASI_COMPONENTS_EQ, ← SET_RULE (← q
     r"(!x y. x IN s /\ y IN s ==> x = y) <=> s = {} \/ ?a. s = {a}")] THEN
    ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [QUASI_COMPONENTS_OF_EMPTY_SPACE, EMPTY_SUBSET] THEN
    ASM_REWRITE_TAC [QUASI_COMPONENTS_OF_EQ_EMPTY, ← SET_RULE (← q
     r"s SUBSET {a} <=> s = {} \/ s = {a}")] THEN
    MESON_TAC [UNIONS_QUASI_COMPONENTS_OF, UNIONS_1])

  let CONNECTED_SPACE_IFF_QUASI_COMPONENTS_SUBSET_SING ← prove
   r"!top:A topology.
        connected_space top <=> ?a. quasi_components_of top SUBSET {a}"
   (MESON_TAC [QUASI_COMPONENTS_OF_SUBSET_SING])

  let QUASI_COMPONENTS_OF_EQ_SING ← prove
   r"!top s:A->bool.
        quasi_components_of top = {s} <=>
        connected_space top /\ ~(topspace top = {}) /\ s = topspace top"
   (REWRITE_TAC [QUASI_COMPONENTS_OF_SUBSET_SING,
                 QUASI_COMPONENTS_OF_EQ_EMPTY,
                 ← SET_RULE (← q r"s = {a} <=> s SUBSET {a} /\ ~(s = {})")] THEN
    MESON_TAC [])

  return { CLOSED_IN_QUASI_COMPONENT_OF, CLOSED_IN_QUASI_COMPONENTS_OF,
           OPEN_IN_FINITE_QUASI_COMPONENTS, QUASI_COMPONENT_OF_EQ_OVERLAP,
           QUASI_COMPONENT_OF_NONOVERLAP, QUASI_COMPONENT_OF_OVERLAP,
           QUASI_COMPONENTS_OF_DISJOINT, QUASI_COMPONENTS_OF_OVERLAP,
           PAIRWISE_SEPARATED_QUASI_COMPONENTS_OF, CARD_LE_QUASI_COMPONENTS_OF_TOPSPACE,
           FINITE_QUASI_COMPONENTS_OF_FINITE, CONNECTED_IMP_QUASI_COMPONENT_OF,
           CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF,
           QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS,
           QUASI_COMPONENTS_AS_CONNECTED_COMPONENTS_UNIONS, PATH_IMP_QUASI_COMPONENT_OF,
           PATH_COMPONENT_SUBSET_QUASI_COMPONENT_OF, CONNECTED_SPACE_IFF_QUASI_COMPONENT,
           CONNECTED_SPACE_IMP_QUASI_COMPONENT_OF, CONNECTED_SPACE_QUASI_COMPONENT_SET,
           CONNECTED_SPACE_IFF_QUASI_COMPONENTS_EQ, QUASI_COMPONENTS_OF_SUBSET_SING,
           CONNECTED_SPACE_IFF_QUASI_COMPONENTS_SUBSET_SING, QUASI_COMPONENTS_OF_EQ_SING }

/- ------------------------------------------------------------------------- -/
/- Quasi-components and separation.  (metric.ml 27117-27291)                 -/
/- ------------------------------------------------------------------------- -/

structure QC3 where
  QUASI_COMPONENTS_OF_CONNECTED_SPACE : thm
  SEPARATED_BETWEEN_SINGS : thm
  QUASI_COMPONENT_NONSEPARATED : thm
  SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT : thm
  SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_RIGHT : thm
  SEPARATED_BETWEEN_QUASI_COMPONENT_POINT : thm
  SEPARATED_BETWEEN_POINT_QUASI_COMPONENT : thm
  SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT : thm
  SEPARATED_BETWEEN_COMPACT_QUASI_COMPONENT : thm
  SEPARATED_BETWEEN_QUASI_COMPONENTS : thm
  QUASI_EQ_CONNECTED_COMPONENT_OF_EQ : thm
  CONNECTED_QUASI_COMPONENT_OF : thm
  QUASI_COMPONENT_OF_CLOPEN_CASES : thm
  QUASI_COMPONENTS_OF_SET : thm
  deriving Inhabited

@[nospecialize]
def setupQC3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BCompact1 : Compact1)
    (BConnected1 : Connected1) (BSepBetween : SepBetween) (BComponents1 : Components1)
    (BQC1 : QC1) (BQC2 : QC2) : ExceptT String IO QC3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT_SING, DISJOINT_SYM, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_INTERS, SUBSET_REFL, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_TOPSPACE, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { CONNECTED_IN_EMPTY, .. } := BConnected1
  let { SEPARATED_BETWEEN, SEPARATED_BETWEEN_IMP_DISJOINT, SEPARATED_BETWEEN_IMP_SUBSET,
        SEPARATED_BETWEEN_MONO, SEPARATED_BETWEEN_POINTWISE_RIGHT, SEPARATED_BETWEEN_SYM,
        separated_between, .. } := BSepBetween
  let { CONNECTED_COMPONENT_OF_EQ_EMPTY, CONNECTED_COMPONENT_OF_MAXIMAL,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, CONNECTED_IN_CONNECTED_COMPONENT_OF,
        connected_components_of, .. } := BComponents1
  let { NONEMPTY_QUASI_COMPONENTS_OF, QUASI_COMPONENTS_OF_EMPTY_SPACE,
        QUASI_COMPONENTS_OF_SUBSET, QUASI_COMPONENT_IN_TOPSPACE, QUASI_COMPONENT_OF_ALT,
        QUASI_COMPONENT_OF_DISJOINT, QUASI_COMPONENT_OF_EQ_EMPTY, QUASI_COMPONENT_OF_REFL,
        quasi_component_of, quasi_components_of, .. } := BQC1
  let { CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF, QUASI_COMPONENTS_OF_EQ_SING, .. } := BQC2
  -- @@SCOPE END

  let QUASI_COMPONENTS_OF_CONNECTED_SPACE ← prove
   r"!top:A topology.
        connected_space top
        ==> quasi_components_of top =
            if topspace top = {} then {} else {topspace top}"
   (ASM_MESON_TAC [QUASI_COMPONENTS_OF_EMPTY_SPACE,
                   QUASI_COMPONENTS_OF_EQ_SING])

  let SEPARATED_BETWEEN_SINGS ← prove
   r"!top x y:A.
        separated_between top {x} {y} <=>
        x IN topspace top /\ y IN topspace top /\
        ~(quasi_component_of top x y)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [ALL_TAC, ASM_MESON_TAC [SEPARATED_BETWEEN_IMP_SUBSET, SING_SUBSET]] THEN
    ASM_CASES_TAC (← q r"(y:A) IN topspace top") THENL
     [ALL_TAC, ASM_MESON_TAC [SEPARATED_BETWEEN_IMP_SUBSET, SING_SUBSET]] THEN
    ASM_REWRITE_TAC [separated_between, QUASI_COMPONENT_OF_ALT, SING_SUBSET])

  let QUASI_COMPONENT_NONSEPARATED ← prove
   r"!top x y:A.
        quasi_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        ~(separated_between top {x} {y})"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [SEPARATED_BETWEEN_SINGS] THEN
    MESON_TAC [QUASI_COMPONENT_IN_TOPSPACE])

  let SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT ← prove
   r"!top c s:A->bool.
        c IN quasi_components_of top
        ==> (separated_between top c s <=>
             ?x. x IN c /\ separated_between top {x} s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [NONEMPTY_QUASI_COMPONENTS_OF, SING_SUBSET, MEMBER_NOT_EMPTY,
                     SEPARATED_BETWEEN_MONO, SUBSET_REFL],
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC))] THEN
    REWRITE_TAC [SEPARATED_BETWEEN, SING_SUBSET] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [quasi_components_of]) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:A") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"(y:A) IN c") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC LAND_CONV [IN] THEN REWRITE_TAC [quasi_component_of] THEN
    DISCH_TAC THEN REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"z:A") THEN
    GEN_REWRITE_TAC LAND_CONV [IN] THEN REWRITE_TAC [quasi_component_of] THEN
    ASM_MESON_TAC [])

  let SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_RIGHT ← prove
   r"!top s c:A->bool.
        c IN quasi_components_of top
        ==> (separated_between top s c <=>
             ?x. x IN c /\ separated_between top s {x})"
   (ONCE_REWRITE_TAC [SEPARATED_BETWEEN_SYM] THEN
    REWRITE_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT])

  let SEPARATED_BETWEEN_QUASI_COMPONENT_POINT ← prove
   r"!top c x:A.
        c IN quasi_components_of top
        ==> (separated_between top c {x} <=> x IN topspace top DIFF c)"
   (REWRITE_TAC [IN_DIFF] THEN REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [SEPARATED_BETWEEN_IMP_DISJOINT, DISJOINT_SING,
                     SEPARATED_BETWEEN_IMP_SUBSET, SING_SUBSET],
      ASM_SIMP_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT]] THEN
    REWRITE_TAC [SEPARATED_BETWEEN_SINGS, RIGHT_IMP_EXISTS_THM] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [quasi_components_of]) THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"y:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [IN] THEN ASM_REWRITE_TAC [quasi_component_of])

  let SEPARATED_BETWEEN_POINT_QUASI_COMPONENT ← prove
   r"!top (x:A) c.
        c IN quasi_components_of top
        ==> (separated_between top {x} c <=> x IN topspace top DIFF c)"
   (ONCE_REWRITE_TAC [SEPARATED_BETWEEN_SYM] THEN
    REWRITE_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_POINT])

  let SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT ← prove
   r"!top c k:A->bool.
        c IN quasi_components_of top /\ compact_in top k
        ==> (separated_between top c k <=> DISJOINT c k)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [SEPARATED_BETWEEN_IMP_DISJOINT] THEN
    DISCH_TAC THEN ASM_SIMP_TAC [SEPARATED_BETWEEN_POINTWISE_RIGHT] THEN
    ASM_SIMP_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_POINT] THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP QUASI_COMPONENTS_OF_SUBSET) THEN
    ASM SET_TAC [])

  let SEPARATED_BETWEEN_COMPACT_QUASI_COMPONENT ← prove
   r"!top k c:A->bool.
        compact_in top k /\ c IN quasi_components_of top
        ==> (separated_between top k c <=> DISJOINT k c)"
   (ONCE_REWRITE_TAC [SEPARATED_BETWEEN_SYM, DISJOINT_SYM] THEN
    SIMP_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT])

  let SEPARATED_BETWEEN_QUASI_COMPONENTS ← prove
   r"!top c c':A->bool.
        c IN quasi_components_of top /\ c' IN quasi_components_of top
        ==> (separated_between top c c' <=> DISJOINT c c')"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [SEPARATED_BETWEEN_IMP_DISJOINT] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_RIGHT,
                  SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT] THEN
    UNDISCH_TAC (← q r"(c:A->bool) IN quasi_components_of top") THEN
    REWRITE_TAC [quasi_components_of, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [QUASI_COMPONENT_OF_REFL, IN], ALL_TAC] THEN
    UNDISCH_TAC (← q r"(c':A->bool) IN quasi_components_of top") THEN
    REWRITE_TAC [quasi_components_of, IN_ELIM_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC SUBST_ALL_TAC) THEN
    CONJ_TAC THENL [ASM_MESON_TAC [QUASI_COMPONENT_OF_REFL, IN], ALL_TAC] THEN
    ASM_REWRITE_TAC [SEPARATED_BETWEEN_SINGS] THEN
    ASM_REWRITE_TAC [← GSYM QUASI_COMPONENT_OF_DISJOINT])

  let QUASI_EQ_CONNECTED_COMPONENT_OF_EQ ← prove
   r"!top x:A. quasi_component_of top x = connected_component_of top x <=>
             connected_in top (quasi_component_of top x)"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [ALL_TAC,
      ASM_MESON_TAC [QUASI_COMPONENT_OF_EQ_EMPTY, CONNECTED_COMPONENT_OF_EQ_EMPTY,
                     CONNECTED_IN_EMPTY]] THEN
    REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONNECTED_IN_CONNECTED_COMPONENT_OF],
      DISCH_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
    ASM_REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [QUASI_COMPONENT_OF_REFL])

  let CONNECTED_QUASI_COMPONENT_OF ← prove
   r"!top c:A->bool.
        c IN quasi_components_of top
        ==> (c IN connected_components_of top <=> connected_in top c)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [CONNECTED_IN_CONNECTED_COMPONENTS_OF] THEN
    DISCH_TAC THEN
    UNDISCH_TAC (← q r"(c:A->bool) IN quasi_components_of top") THEN
    REWRITE_TAC [quasi_components_of, connected_components_of] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [QUASI_EQ_CONNECTED_COMPONENT_OF_EQ])

  let QUASI_COMPONENT_OF_CLOPEN_CASES ← prove
   r"!top c t:A->bool.
        c IN quasi_components_of top /\ closed_in top t /\ open_in top t
        ==> c SUBSET t \/ DISJOINT c t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, quasi_components_of, IN_ELIM_THM, LEFT_IMP_EXISTS_THM,
                 ← SET_RULE (← q r"c = s <=> !x. x IN c <=> s x")] THEN
    REWRITE_TAC [quasi_component_of] THEN
    REWRITE_TAC [closed_in] THEN SET_TAC [])

  let QUASI_COMPONENTS_OF_SET ← prove
   r"!top c:A->bool.
        c IN quasi_components_of top
        ==> INTERS {t | closed_in top t /\ open_in top t /\ c SUBSET t} = c"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    SIMP_TAC [SUBSET_INTERS, FORALL_IN_GSPEC] THEN
    GEN_REWRITE_TAC id [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN
    REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q <=> p ==> ~q ==> ~p")] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"topspace top:A->bool")) THEN
    ASM_SIMP_TAC [QUASI_COMPONENTS_OF_SUBSET] THEN
    REWRITE_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE] THEN
    REWRITE_TAC [← GSYM IN_DIFF, IMP_IMP] THEN
    ASM_SIMP_TAC [← GSYM SEPARATED_BETWEEN_QUASI_COMPONENT_POINT] THEN
    REWRITE_TAC [SEPARATED_BETWEEN] THEN SET_TAC [])

  return { QUASI_COMPONENTS_OF_CONNECTED_SPACE, SEPARATED_BETWEEN_SINGS,
           QUASI_COMPONENT_NONSEPARATED, SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_LEFT,
           SEPARATED_BETWEEN_QUASI_COMPONENT_POINTWISE_RIGHT,
           SEPARATED_BETWEEN_QUASI_COMPONENT_POINT, SEPARATED_BETWEEN_POINT_QUASI_COMPONENT,
           SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT,
           SEPARATED_BETWEEN_COMPACT_QUASI_COMPONENT, SEPARATED_BETWEEN_QUASI_COMPONENTS,
           QUASI_EQ_CONNECTED_COMPONENT_OF_EQ, CONNECTED_QUASI_COMPONENT_OF,
           QUASI_COMPONENT_OF_CLOPEN_CASES, QUASI_COMPONENTS_OF_SET }

/- ------------------------------------------------------------------------- -/
/- Quasi-components versus connected components.  (metric.ml 27293-27470)   -/
/- ------------------------------------------------------------------------- -/

structure QC4 where
  OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF : thm
  QUASI_COMPONENT_OF_CONTINUOUS_IMAGE : thm
  QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY : thm
  QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY : thm
  HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF : thm
  HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF : thm
  OPEN_IN_QUASI_COMPONENT_OF_LOCALLY_CONNECTED_SPACE : thm
  OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE : thm
  QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT : thm
  CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE : thm
  QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE : thm
  QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE : thm
  QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupQC4 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BConnected1 : Connected1) (BComponents1 : Components1) (BComponents2 : Components2)
    (BLC1 : LC1) (BQC1 : QC1) (BQC2 : QC2) (BQC3 : QC3) : ExceptT String IO QC4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, FUN_EQ_THM, IMAGE_EQ, .. } := D.core1
  let { IMAGE_o, IN, INTERS_SUBSET_STRONG, IN_ELIM_THM, IN_IMAGE, IN_SING, MONO_EXISTS,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_REFL, o_DEF,
        .. } := D.core4
  let { EQ_SYM_EQ, EXCLUDED_MIDDLE, .. } := D.core5
  let { OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_DISCRETE_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY,
        .. } := BDiscrete
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET,
        .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
        OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_IMP_SURJECTIVE_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { CONNECTED_SPACE_CLOPEN_IN, connected_in, .. } := BConnected1
  let { CONNECTED_COMPONENT_OF_DISJOINT, CONNECTED_COMPONENT_OF_EQ,
        CONNECTED_COMPONENT_OF_EQ_EMPTY, CONNECTED_COMPONENT_OF_REFL,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, connected_components_of, .. } := BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENTS_OF, .. } := BComponents2
  let { OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { QUASI_COMPONENTS_OF_SUBSET, QUASI_COMPONENT_IN_QUASI_COMPONENTS_OF,
        QUASI_COMPONENT_IN_TOPSPACE, QUASI_COMPONENT_OF_DISJOINT, QUASI_COMPONENT_OF_EQ,
        QUASI_COMPONENT_OF_EQ_EMPTY, QUASI_COMPONENT_OF_SET, quasi_component_of,
        quasi_components_of, .. } := BQC1
  let { CLOSED_IN_QUASI_COMPONENTS_OF, CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF,
        QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS, .. } := BQC2
  let { CONNECTED_QUASI_COMPONENT_OF, QUASI_COMPONENT_OF_CLOPEN_CASES,
        QUASI_EQ_CONNECTED_COMPONENT_OF_EQ, .. } := BQC3
  -- @@SCOPE END

  let OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF ← prove
   r"!top c:A->bool.
        open_in top c
        ==> (c IN quasi_components_of top <=>
             c IN connected_components_of top)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"closed_in top (c:A->bool)") THENL
     [STRIP_TAC,
      ASM_MESON_TAC [CLOSED_IN_CONNECTED_COMPONENTS_OF,
                     CLOSED_IN_QUASI_COMPONENTS_OF]] THEN
    EQ_TAC THENL
     [SIMP_TAC [CONNECTED_QUASI_COMPONENT_OF] THEN
      SIMP_TAC [connected_in, QUASI_COMPONENTS_OF_SUBSET] THEN DISCH_TAC THEN
      REWRITE_TAC [CONNECTED_SPACE_CLOPEN_IN] THEN
      ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, CLOSED_IN_CLOSED_SUBTOPOLOGY] THEN
      X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
       r"(!x. x IN s ==> P) ==> s = {} \/ P")) THEN
      X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, QUASI_COMPONENTS_OF_SUBSET] THEN
      ASM_REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool", ← q r"t:A->bool"]
          QUASI_COMPONENT_OF_CLOPEN_CASES) THEN
      ASM SET_TAC [],
      REWRITE_TAC [connected_components_of, quasi_components_of] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_ANTISYM THEN
      REWRITE_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF] THEN
      ASM_SIMP_TAC [QUASI_COMPONENT_OF_SET] THEN
      MATCH_MP_TAC INTERS_SUBSET_STRONG THEN
      EXISTS_TAC (← q r"c:A->bool") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN REWRITE_TAC [IN] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL]])

  let QUASI_COMPONENT_OF_CONTINUOUS_IMAGE ← prove
   r"!top top' (f:A->B) x y.
        continuous_map(top,top') f /\
        quasi_component_of top x y
        ==> quasi_component_of top' (f x) (f y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quasi_component_of] THEN
    STRIP_TAC THEN
    REPEAT (CONJ_TAC THENL [ASM_MESON_TAC [continuous_map], ALL_TAC]) THEN
    X_GEN_TAC (← q r"t:B->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPEC (← q r"{x | x IN topspace top /\ (f:A->B) x IN t}")) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE,
      MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE] THEN
    ASM_MESON_TAC [])

  let QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY ← prove
   r"!u x:A. quasi_component_of (discrete_topology u) x =
           if x IN u then {x} else {}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    X_GEN_TAC (← q r"y:A") THEN GEN_REWRITE_TAC LAND_CONV [IN] THEN
    REWRITE_TAC [quasi_component_of, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, CLOSED_IN_DISCRETE_TOPOLOGY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_SING, NOT_IN_EMPTY] THEN
    EQ_TAC THEN ASM_SIMP_TAC [] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:A}")) THEN
    ASM_REWRITE_TAC [IN_SING, SING_SUBSET])

  let QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool.
        quasi_components_of (discrete_topology u) = {{x} | x IN u}"
   (GEN_TAC THEN REWRITE_TAC [quasi_components_of] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY,
                 QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY] THEN
    SET_TAC [])

  let HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF ← prove
   r"!(f:A->B) top top' x.
        homeomorphic_map(top,top') f /\ x IN topspace top
        ==> quasi_component_of top' (f x) =
            IMAGE f (quasi_component_of top x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g:B->A") STRIP_ASSUME_TAC) ASSUME_TAC) THEN
    REWRITE_TAC [EXTENSION, IN_IMAGE] THEN REWRITE_TAC [IN] THEN
    MP_TAC (← ISPEC (← q r"top':B topology") QUASI_COMPONENT_IN_TOPSPACE) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B"]
          QUASI_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology", ← q r"g:B->A"]
          QUASI_COMPONENT_OF_CONTINUOUS_IMAGE) THEN
    ASM_REWRITE_TAC [] THEN REPEAT
     (FIRST_X_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF ← prove
   r"!(f:A->B) top top'.
      homeomorphic_map(top,top') f
      ==> quasi_components_of top' =
          IMAGE (IMAGE f) (quasi_components_of top)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [quasi_components_of, SIMPLE_IMAGE] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP) THEN
    REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN MATCH_MP_TAC IMAGE_EQ THEN
    REWRITE_TAC [] THEN ASM_MESON_TAC [HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF])

  let OPEN_IN_QUASI_COMPONENT_OF_LOCALLY_CONNECTED_SPACE ← prove
   r"!top x:A.
        locally_connected_space top
        ==> open_in top (quasi_component_of top x)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [QUASI_COMPONENT_AS_CONNECTED_COMPONENT_UNIONS] THEN
    MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ASM_SIMP_TAC [OPEN_IN_CONNECTED_COMPONENT_OF_LOCALLY_CONNECTED_SPACE])

  let OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE ← prove
   r"!top c:A->bool.
        locally_connected_space top /\ c IN quasi_components_of top
        ==> open_in top c"
   (REWRITE_TAC [quasi_components_of, IN_ELIM_THM] THEN
    MESON_TAC [OPEN_IN_QUASI_COMPONENT_OF_LOCALLY_CONNECTED_SPACE])

  let QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT ← prove
   r"!top:A topology.
        quasi_components_of top = connected_components_of top <=>
        !c. c IN quasi_components_of top ==> connected_in top c"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [CONNECTED_IN_CONNECTED_COMPONENTS_OF] THEN
    DISCH_TAC THEN REWRITE_TAC [EXTENSION] THEN X_GEN_TAC (← q r"c:A->bool") THEN
    REWRITE_TAC [quasi_components_of, connected_components_of] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN REWRITE_TAC [QUASI_EQ_CONNECTED_COMPONENT_OF_EQ] THEN
    ASM_SIMP_TAC [QUASI_COMPONENT_IN_QUASI_COMPONENTS_OF])

  let CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE ← prove
   r"!top:A topology.
        connected_components_of top SUBSET quasi_components_of top <=>
        !x. x IN topspace top
            ==> quasi_component_of top x = connected_component_of top x"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [quasi_components_of, connected_components_of] THEN EQ_TAC THENL
     [ALL_TAC, REWRITE_TAC [EXTENSION, SUBSET, IN_ELIM_THM] THEN MESON_TAC []] THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. x IN s ==> x IN f x /\ f x SUBSET g x) /\
      (!x y. x IN s /\ y IN s ==> g x = g y \/ DISJOINT (g x) (g y))
      ==> {f x | x IN s} SUBSET {g x | x IN s} ==> !x. x IN s ==> f x = g x")) THEN
    SIMP_TAC [QUASI_COMPONENT_OF_DISJOINT, QUASI_COMPONENT_OF_EQ] THEN
    SIMP_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF, EXCLUDED_MIDDLE] THEN
    REWRITE_TAC [IN, CONNECTED_COMPONENT_OF_REFL])

  let QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE ← prove
   r"!top:A topology.
        quasi_components_of top SUBSET connected_components_of top <=>
        !x. x IN topspace top
            ==> quasi_component_of top x = connected_component_of top x"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [quasi_components_of, connected_components_of] THEN EQ_TAC THENL
     [ALL_TAC, REWRITE_TAC [EXTENSION, SUBSET, IN_ELIM_THM] THEN MESON_TAC []] THEN
    ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. x IN s ==> x IN f x /\ f x SUBSET g x) /\
      (!x y. x IN s /\ y IN s ==> f x = f y \/ DISJOINT (f x) (f y))
      ==> {g x | x IN s} SUBSET {f x | x IN s} ==> !x. x IN s ==> f x = g x")) THEN
    SIMP_TAC [CONNECTED_COMPONENT_OF_DISJOINT, CONNECTED_COMPONENT_OF_EQ] THEN
    SIMP_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF, EXCLUDED_MIDDLE] THEN
    REWRITE_TAC [IN, CONNECTED_COMPONENT_OF_REFL])

  let QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE ← prove
   r"!top:A topology.
        quasi_components_of top = connected_components_of top <=>
        !x. x IN topspace top
            ==> quasi_component_of top x = connected_component_of top x"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [← GSYM CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE, SUBSET_REFL],
      REWRITE_TAC [quasi_components_of, connected_components_of] THEN
      REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN MESON_TAC []])

  let QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT ← prove
   r"!top:A topology.
        quasi_components_of top = connected_components_of top <=>
        !x. quasi_component_of top x = connected_component_of top x"
   (GEN_TAC THEN REWRITE_TAC [QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THEN ASM_SIMP_TAC [] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_OF_EQ_EMPTY,
                   QUASI_COMPONENT_OF_EQ_EMPTY])

  return { OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF, QUASI_COMPONENT_OF_CONTINUOUS_IMAGE,
           QUASI_COMPONENT_OF_DISCRETE_TOPOLOGY, QUASI_COMPONENTS_OF_DISCRETE_TOPOLOGY,
           HOMEOMORPHIC_MAP_QUASI_COMPONENT_OF, HOMEOMORPHIC_MAP_QUASI_COMPONENTS_OF,
           OPEN_IN_QUASI_COMPONENT_OF_LOCALLY_CONNECTED_SPACE,
           OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE,
           QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT, CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE,
           QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE,
           QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE,
           QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT }

/- ------------------------------------------------------------------------- -/
/- When quasi-components equal components.  (metric.ml 27472-27553)          -/
/- ------------------------------------------------------------------------- -/

structure QC5 where
  QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION : thm
  QUASI_EQ_CONNECTED_COMPONENTS_OF : thm
  QUASI_EQ_CONNECTED_COMPONENT_OF : thm
  deriving Inhabited

@[nospecialize]
def setupQC5 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BConnected1 : Connected1) (BSepBetween : SepBetween)
    (BComponents2 : Components2) (BNormal1 : Normal1) (BLC1 : LC1) (BQC1 : QC1) (BQC2 : QC2)
    (BQC3 : QC3) (BQC4 : QC4) : ExceptT String IO QC5 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { DISJOINT, EXTENSION, .. } := D.core1
  let { IMP_CONJ, NOT_IMP, .. } := D.core2
  let { SUBSET, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_INTER, OPEN_IN_SUBSET,
        OPEN_IN_UNION, .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CLOSED_IN_COMPACT_SPACE, .. } := BCompact1
  let { CONNECTED_SPACE_CLOSED_IN_EQ, connected_in, .. } := BConnected1
  let { separated_between, .. } := BSepBetween
  let { OPEN_IN_FINITE_CONNECTED_COMPONENTS, .. } := BComponents2
  let { COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE, normal_space, .. } := BNormal1
  let { OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE, .. } := BLC1
  let { QUASI_COMPONENTS_OF_SUBSET, .. } := BQC1
  let { CLOSED_IN_QUASI_COMPONENTS_OF, OPEN_IN_FINITE_QUASI_COMPONENTS, .. } := BQC2
  let { QUASI_COMPONENT_OF_CLOPEN_CASES, SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT, .. } := BQC3
  let { CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE,
        OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE,
        OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF, QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT,
        QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE,
        QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT,
        QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE, .. } := BQC4
  -- @@SCOPE END

  let QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION ← prove
   r"!top:A topology.
        quasi_components_of top = connected_components_of top <=>
        connected_components_of top SUBSET quasi_components_of top \/
        quasi_components_of top SUBSET connected_components_of top"
   (REWRITE_TAC [CONNECTED_SUBSET_QUASI_COMPONENTS_OF_POINTWISE,
                 QUASI_SUBSET_CONNECTED_COMPONENTS_OF_POINTWISE,
                 QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE])

  let QUASI_EQ_CONNECTED_COMPONENTS_OF ← prove
   r"!top:A topology.
      FINITE(connected_components_of top) \/
      FINITE(quasi_components_of top) \/
      locally_connected_space top \/
      compact_space top /\
      (hausdorff_space top \/ regular_space top \/ normal_space top)
      ==> quasi_components_of top = connected_components_of top"
   (REPEAT GEN_TAC THEN DISCH_THEN
     (REPEAT_TCL DISJ_CASES_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC))
    THENL
     [REWRITE_TAC [QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION] THEN
      DISJ1_TAC THEN REWRITE_TAC [SUBSET] THEN
      ASM_MESON_TAC [OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF,
                     OPEN_IN_FINITE_CONNECTED_COMPONENTS],
      REWRITE_TAC [QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION] THEN
      DISJ2_TAC THEN REWRITE_TAC [SUBSET] THEN
      ASM_MESON_TAC [OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF,
                     OPEN_IN_FINITE_QUASI_COMPONENTS],
      REWRITE_TAC [EXTENSION] THEN
      ASM_MESON_TAC [OPEN_QUASI_EQ_CONNECTED_COMPONENTS_OF,
                     OPEN_IN_CONNECTED_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE,
                     OPEN_IN_QUASI_COMPONENTS_OF_LOCALLY_CONNECTED_SPACE],
      REWRITE_TAC [QUASI_EQ_CONNECTED_COMPONENTS_OF_ALT]] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP QUASI_COMPONENTS_OF_SUBSET) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_QUASI_COMPONENTS_OF) THEN
    ASM_REWRITE_TAC [connected_in, CONNECTED_SPACE_CLOSED_IN_EQ] THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, ← GSYM DISJOINT] THEN STRIP_TAC THEN
    MP_TAC (← EQ_IMP_RULE (← ISPEC (← q r"top:A topology") normal_space)).1 THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE],
      DISCH_THEN (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"])] THEN
    ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"c:A->bool",
      ← q r"topspace top DIFF (u UNION v):A->bool"]
     SEPARATED_BETWEEN_QUASI_COMPONENT_COMPACT) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN
      ASM_SIMP_TAC [OPEN_IN_UNION, CLOSED_IN_TOPSPACE],
      DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).2))] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [separated_between]] THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"e:A->bool", ← q r"g:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
     SPEC (← q r"g UNION u:A->bool") o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] QUASI_COMPONENT_OF_CLOPEN_CASES)) THEN
    ASM_SIMP_TAC [OPEN_IN_UNION, NOT_IMP] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    SUBGOAL_THEN (← q r"g UNION u:A->bool = topspace top DIFF (e INTER v)")
    SUBST1_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_DIFF THEN
      ASM_SIMP_TAC [CLOSED_IN_TOPSPACE, OPEN_IN_INTER]])

  let QUASI_EQ_CONNECTED_COMPONENT_OF ← prove
   r"!top (x:A).
      FINITE(connected_components_of top) \/
      FINITE(quasi_components_of top) \/
      locally_connected_space top \/
      compact_space top /\
      (hausdorff_space top \/ regular_space top \/ normal_space top)
      ==> quasi_component_of top x = connected_component_of top x"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP QUASI_EQ_CONNECTED_COMPONENTS_OF) THEN
    SIMP_TAC [QUASI_EQ_CONNECTED_COMPONENTS_OF_POINTWISE_ALT])

  return { QUASI_EQ_CONNECTED_COMPONENTS_OF_INCLUSION, QUASI_EQ_CONNECTED_COMPONENTS_OF,
           QUASI_EQ_CONNECTED_COMPONENT_OF }

/- ------------------------------------------------------------------------- -/
/- Additional quasicomponent and continuum properties like Boundary Bumping. -/
/- (metric.ml 27555-27737)                                                    -/
/- ------------------------------------------------------------------------- -/

structure BB1 where
  CUT_WIRE_FENCE_THEOREM_GEN : thm
  CUT_WIRE_FENCE_THEOREM : thm
  SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY : thm
  SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER : thm
  SEPARATED_BETWEEN_FROM_FRONTIER_OF_CLOSED_SUBTOPOLOGY : thm
  SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT : thm
  WILDER_LOCALLY_COMPACT_COMPONENT_THM : thm
  COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF : thm
  deriving Inhabited

@[nospecialize]
def setupBB1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BInterior : Interior) (BFrontier : Frontier) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BConnected1 : Connected1) (BSepBetween : SepBetween)
    (BComponents1 : Components1) (BComponents2 : Components2) (BLocCompact2 : LocCompact2)
    (BQC1 : QC1) (BQC2 : QC2) (BQC3 : QC3) (BQC5 : QC5) : ExceptT String IO BB1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT_SING, .. } := D.core1
  let { IMP_CONJ, IN, INTER_SUBSET, IN_SING, MONO_EXISTS, NOT_IMP, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_REFL, SUBSET_TRANS,
        .. } := D.core4
  let { MONO_IMP, NOT_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_TOPSPACE,
        .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, SUBTOPOLOGY_RESTRICT,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { INTERIOR_OF_MAXIMAL, .. } := BInterior
  let { CLOSED_IN_FRONTIER_OF, FRONTIER_OF_COMPLEMENT, FRONTIER_OF_RESTRICT,
        FRONTIER_OF_SUBSET_CLOSED_IN, FRONTIER_OF_SUBSET_EQ, OPEN_IN_SUBSET_TOPSPACE_EQ,
        frontier_of, .. } := BFrontier
  let { CLOSED_COMPACT_IN, CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBSET_TOPSPACE,
        COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { CLOSED_IN_HAUSDORFF_SING, COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } :=
    BHausdorff1
  let { CONNECTED_IN_SUBTOPOLOGY, .. } := BConnected1
  let { SEPARATED_BETWEEN, SEPARATED_BETWEEN_FRONTIER_OF, SEPARATED_BETWEEN_FRONTIER_OF_EQ,
        SEPARATED_BETWEEN_IMP_SUBSET, SEPARATED_BETWEEN_MONO, SEPARATED_BETWEEN_POINTWISE_LEFT,
        SEPARATED_BETWEEN_POINTWISE_RIGHT, SEPARATED_BETWEEN_UNION, separated_between, .. } :=
    BSepBetween
  let { CONNECTED_COMPONENTS_OF_MAXIMAL, CONNECTED_COMPONENTS_OF_SUBSET,
        CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENT_OF_REFL,
        connected_component_of, connected_components_of, .. } := BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENT_OF, .. } := BComponents2
  let { LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT, LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } :=
    BLocCompact2
  let { QUASI_COMPONENT_OF_SUBSET_TOPSPACE, quasi_components_of, .. } := BQC1
  let { CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF, .. } := BQC2
  let { SEPARATED_BETWEEN_SINGS, .. } := BQC3
  let { QUASI_EQ_CONNECTED_COMPONENT_OF, .. } := BQC5
  -- @@SCOPE END

  let CUT_WIRE_FENCE_THEOREM_GEN ← prove
   r"!top s t:A->bool.
        compact_space top /\
        (hausdorff_space top \/ regular_space top \/ normal_space top) /\
        compact_in top s /\ closed_in top t /\
        (!c. connected_in top c ==> DISJOINT c s \/ DISJOINT c t)
        ==> separated_between top s t"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_SIMP_TAC [SEPARATED_BETWEEN_POINTWISE_LEFT, CLOSED_IN_COMPACT_SPACE] THEN
    ASM_SIMP_TAC [SEPARATED_BETWEEN_POINTWISE_RIGHT, CLOSED_IN_COMPACT_SPACE] THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBSET, SING_SUBSET] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, SUBSET]] THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(y:A) IN topspace top") THENL
     [ASM_REWRITE_TAC [SEPARATED_BETWEEN_SINGS],
      ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET]] THEN
    ASM_SIMP_TAC [QUASI_EQ_CONNECTED_COMPONENT_OF] THEN
    REWRITE_TAC [connected_component_of, NOT_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let CUT_WIRE_FENCE_THEOREM ← prove
   r"!top s t:A->bool.
        compact_space top /\ hausdorff_space top /\
        closed_in top s /\ closed_in top t /\
        (!c. connected_in top c ==> DISJOINT c s \/ DISJOINT c t)
        ==> separated_between top s t"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CUT_WIRE_FENCE_THEOREM_GEN THEN
    ASM_SIMP_TAC [CLOSED_IN_COMPACT_SPACE])

  let SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY ← prove
   r"!top s t c:A->bool.
        separated_between (subtopology top c) s (top frontier_of c) /\
        separated_between (subtopology top c) s t
        ==> separated_between top s t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM SEPARATED_BETWEEN_UNION] THEN
    REWRITE_TAC [SEPARATED_BETWEEN] THEN MATCH_MP_TAC MONO_EXISTS THEN
    GEN_TAC THEN REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
     [MP_TAC (← ISPECL
        [← q r"top:A topology", ← q r"topspace top INTER c:A->bool", ← q r"u:A->bool"]
        CLOSED_IN_CLOSED_SUBTOPOLOGY) THEN
      ASM_REWRITE_TAC [← GSYM SUBTOPOLOGY_RESTRICT] THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC []] THEN
      SIMP_TAC [← GSYM FRONTIER_OF_SUBSET_EQ, INTER_SUBSET] THEN
      REWRITE_TAC [← GSYM FRONTIER_OF_RESTRICT] THEN ASM SET_TAC [],
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool", ← q r"u:A->bool"]
        OPEN_IN_SUBSET_TOPSPACE_EQ) THEN
      ASM SET_TAC [],
      ASM SET_TAC []])

  let SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER ← prove
   r"!top s t:A->bool.
        separated_between (subtopology top t) s (top frontier_of t)
        ==> separated_between top s (top frontier_of t)"
   (ASM_MESON_TAC [SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY])

  let SEPARATED_BETWEEN_FROM_FRONTIER_OF_CLOSED_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        separated_between (subtopology top t) s (top frontier_of t)
        ==> separated_between top s (topspace top DIFF t)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC id [← CONJUNCT2 SEPARATED_BETWEEN_FRONTIER_OF_EQ] THEN
    REPEAT CONJ_TAC THENL
     [SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP SEPARATED_BETWEEN_IMP_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
      REWRITE_TAC [FRONTIER_OF_COMPLEMENT]] THEN
    MATCH_MP_TAC SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER THEN
    ASM_REWRITE_TAC [])

  let SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT ← prove
   r"!top c t:A->bool.
        locally_compact_space top /\ hausdorff_space top /\
        c IN connected_components_of top /\ compact_in top c /\
        closed_in top t /\ DISJOINT c t
        ==> separated_between top c t"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?n l:A->bool.
          open_in top n /\
          compact_in top l /\
          closed_in top l /\
          c SUBSET n /\ n SUBSET l /\ l SUBSET topspace top DIFF t")
    STRIP_ASSUME_TAC THENL
     [MP_TAC (← ISPEC (← q r"subtopology top (topspace top DIFF t:A->bool)")
          LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT) THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [LOCALLY_COMPACT_SPACE_OPEN_SUBSET, OPEN_IN_OPEN_SUBTOPOLOGY,
                    OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"c:A->bool")) THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
        ASM SET_TAC [],
        REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
        STRIP_TAC THEN ASM_SIMP_TAC [COMPACT_IN_IMP_CLOSED_IN]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool",
                      ← q r"topspace top DIFF l:A->bool"]
             (← CONJUNCT2 SEPARATED_BETWEEN_FRONTIER_OF)) THEN
    ANTS_TAC THENL
     [ASM SET_TAC [], DISCH_THEN (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1))] THEN
    ANTS_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [separated_between] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC []] THEN
    MATCH_MP_TAC SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY THEN
    EXISTS_TAC (← q r"l:A->bool") THEN
    ASM_REWRITE_TAC [FRONTIER_OF_COMPLEMENT] THEN
    MATCH_MP_TAC CUT_WIRE_FENCE_THEOREM THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [FRONTIER_OF_SUBSET_CLOSED_IN, COMPACT_IN_IMP_CLOSED_IN] THEN
    REWRITE_TAC [CLOSED_IN_FRONTIER_OF, CONNECTED_IN_SUBTOPOLOGY] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"d:A->bool") THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"d:A->bool", ← q r"c:A->bool"]
          CONNECTED_COMPONENTS_OF_MAXIMAL) THEN
    ASM_REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN
    MATCH_MP_TAC MONO_IMP THEN CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [frontier_of] THEN MATCH_MP_TAC (← SET_RULE (← q
     r"c SUBSET v ==> d SUBSET c ==> DISJOINT d (u DIFF v)")) THEN
    TRANS_TAC SUBSET_TRANS (← q r"n:A->bool") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [INTERIOR_OF_MAXIMAL])

  let WILDER_LOCALLY_COMPACT_COMPONENT_THM ← prove
   r"!top c w:A->bool.
        locally_compact_space top /\ hausdorff_space top /\
        c IN connected_components_of top /\ compact_in top c /\
        open_in top w /\ c SUBSET w
        ==> ?u v. open_in top u /\ open_in top v /\
                  DISJOINT u v /\ u UNION v = topspace top /\
                  c SUBSET u /\ u SUBSET w"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"c:A->bool",
                      ← q r"topspace top DIFF w:A->bool"]
          SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT) THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [separated_between]] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN ASM SET_TAC [])

  let COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF ← prove
   r"!top c:A->bool.
        locally_compact_space top /\ hausdorff_space top /\
        compact_in top c
        ==> (c IN quasi_components_of top <=>
             c IN connected_components_of top)"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    GEN_TAC THEN REPEAT DISCH_TAC THEN
    REWRITE_TAC [quasi_components_of, connected_components_of] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. P x /\ Q(g x) ==> Q(f x)) /\
      (!x. P x /\ Q(f x) ==> f x = g x)
      ==> !c. Q c ==> (c IN {g x | P x} <=> c IN {f x | P x})")) THEN
    REWRITE_TAC [] THEN CONJ_TAC THEN X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THENL
     [MATCH_MP_TAC CLOSED_COMPACT_IN THEN
      EXISTS_TAC (← q r"quasi_component_of top (x:A)") THEN
      ASM_REWRITE_TAC [CLOSED_IN_CONNECTED_COMPONENT_OF,
                       CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF],
      ALL_TAC] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [CONNECTED_COMPONENT_SUBSET_QUASI_COMPONENT_OF] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"y:A") THEN
    REWRITE_TAC [← TAUT (← q r"p ==> q <=> ~(p /\ ~q)")] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"connected_component_of top (x:A)", ← q r"{y:A}"]
          SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT) THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF] THEN
    ASM_REWRITE_TAC [NOT_IMP, DISJOINT_SING] THEN
    SUBGOAL_THEN (← q r"(y:A) IN topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [SUBSET, QUASI_COMPONENT_OF_SUBSET_TOPSPACE],
      ASM_SIMP_TAC [CLOSED_IN_HAUSDORFF_SING]] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"{x:A}", ← q r"{y:A}"] o MATCH_MP
     (← ONCE_REWRITE_RULE [IMP_CONJ] SEPARATED_BETWEEN_MONO)) THEN
    ASM_REWRITE_TAC [SUBSET_REFL, SEPARATED_BETWEEN_SINGS, SING_SUBSET] THEN
    REWRITE_TAC [IN_SING] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL] THEN ASM_MESON_TAC [IN])

  return { CUT_WIRE_FENCE_THEOREM_GEN, CUT_WIRE_FENCE_THEOREM,
           SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY,
           SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER,
           SEPARATED_BETWEEN_FROM_FRONTIER_OF_CLOSED_SUBTOPOLOGY,
           SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT, WILDER_LOCALLY_COMPACT_COMPONENT_THM,
           COMPACT_QUASI_EQ_CONNECTED_COMPONENTS_OF }

/- ------------------------------------------------------------------------- -/
/- Boundary bumping.  (metric.ml 27739-27896)                                -/
/- ------------------------------------------------------------------------- -/

structure BB2 where
  BOUNDARY_BUMPING_THEOREM_CLOSED_GEN : thm
  BOUNDARY_BUMPING_THEOREM_CLOSED : thm
  INTERMEDIATE_CONTINUUM_EXISTS : thm
  BOUNDARY_BUMPING_THEOREM_GEN : thm
  BOUNDARY_BUMPING_THEOREM : thm
  deriving Inhabited

@[nospecialize]
def setupBB2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BInterior : Interior) (BFrontier : Frontier) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BConnected1 : Connected1) (BConnected2 : Connected2)
    (BSepBetween : SepBetween) (BComponents1 : Components1) (BComponents2 : Components2)
    (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2) (BBB1 : BB1) :
    ExceptT String IO BB2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { IMP_CONJ_ALT, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IMP, PSUBSET, .. } := D.core2
  let { SUBSET_ANTISYM, SUBSET_DELETE, SUBSET_INTER, SUBSET_TRANS, .. } := D.core4
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } :=
    BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET, .. } := BClosure
  let { INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_MONO, INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF,
        .. } := BInterior
  let { CLOSED_IN_FRONTIER_OF, FRONTIER_OF_SUBSET_CLOSED_IN, frontier_of, .. } := BFrontier
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, .. } :=
    BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, OPEN_IN_HAUSDORFF_DELETE, .. } :=
    BHausdorff1
  let { CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_CLOPEN_IN,
        CONNECTED_SPACE_FRONTIER_EQ_EMPTY, .. } := BConnected1
  let { CONNECTED_IN_CLOSURE_OF, .. } := BConnected2
  let { CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL, .. } := BSepBetween
  let { CONNECTED_COMPONENTS_OF_MAXIMAL, CONNECTED_COMPONENTS_OF_SUBSET,
        CONNECTED_IN_CONNECTED_COMPONENTS_OF, NONEMPTY_CONNECTED_COMPONENTS_OF, .. } :=
    BComponents1
  let { CLOSED_IN_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENTS_OF_EQ_EMPTY,
        EXISTS_CONNECTED_COMPONENT_OF_SUPERSET, .. } := BComponents2
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT,
        LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } := BLocCompact2
  let { SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT,
        SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER, .. } := BBB1
  -- @@SCOPE END

  let BOUNDARY_BUMPING_THEOREM_CLOSED_GEN ← prove
   r"!top s c:A->bool.
        connected_space top /\
        locally_compact_space top /\
        hausdorff_space top /\
        closed_in top s /\
        ~(s = topspace top) /\
        compact_in top c /\
        c IN connected_components_of(subtopology top s)
        ==> ~(c INTER top frontier_of s = {})"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"subtopology top (s:A->bool)", ← q r"c:A->bool", ← q r"top frontier_of s:A->bool"]
         SEPARATED_BETWEEN_COMPACT_CONNECTED_COMPONENT) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC LOCALLY_COMPACT_SPACE_CLOSED_SUBSET THEN ASM_REWRITE_TAC [],
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY],
      ASM_REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
      SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER],
      ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY, CLOSED_IN_FRONTIER_OF] THEN
      ASM_SIMP_TAC [FRONTIER_OF_SUBSET_CLOSED_IN],
      ASM SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP
       SEPARATED_BETWEEN_FROM_CLOSED_SUBTOPOLOGY_FRONTIER)] THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL] THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_FRONTIER_EQ_EMPTY, CLOSED_IN_SUBSET] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q r"c IN s ==> ~(s = {})"))) THEN
    REWRITE_TAC [CONNECTED_COMPONENTS_OF_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  let BOUNDARY_BUMPING_THEOREM_CLOSED ← prove
   r"!top s c:A->bool.
        connected_space top /\ compact_space top /\ hausdorff_space top /\
        closed_in top s /\ ~(s = topspace top) /\
        c IN connected_components_of(subtopology top s)
        ==> ~(c INTER top frontier_of s = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC BOUNDARY_BUMPING_THEOREM_CLOSED_GEN THEN
    ASM_SIMP_TAC [COMPACT_IMP_LOCALLY_COMPACT_SPACE] THEN
    MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_CONNECTED_COMPONENTS_OF) THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY])

  let INTERMEDIATE_CONTINUUM_EXISTS ← prove
   r"!top c u:A->bool.
        connected_space top /\
        locally_compact_space top /\
        hausdorff_space top /\
        compact_in top c /\ connected_in top c /\
        ~(c = {}) /\ ~(c = topspace top) /\
        open_in top u /\ c SUBSET u
        ==> ?d. compact_in top d /\ connected_in top d /\
                c PSUBSET d /\ d PSUBSET u"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
    SUBGOAL_THEN (← q r"?a:A. a IN topspace top /\ ~(a IN c)") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ISPEC (← q r"subtopology top (u DELETE (a:A))")
          LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT) THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_SPACE_OPEN_SUBSET, OPEN_IN_OPEN_SUBTOPOLOGY,
                  OPEN_IN_HAUSDORFF_DELETE, SUBSET_DELETE] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    MP_TAC (← SPECL [← q r"subtopology top (k:A->bool)", ← q r"c:A->bool"]
          EXISTS_CONNECTED_COMPONENT_OF_SUPERSET) THEN
    ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"d:A->bool") THEN
    STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_CONNECTED_COMPONENTS_OF) THEN
    DISCH_THEN (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] CLOSED_IN_COMPACT_SPACE)) THEN
    ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_CONNECTED_COMPONENTS_OF) THEN
    ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [PSUBSET] THEN REPEAT CONJ_TAC THENL
     [ALL_TAC,
      ASM SET_TAC [],
      DISCH_THEN SUBST_ALL_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool") o
          GEN_REWRITE_RULE id [CONNECTED_SPACE_CLOPEN_IN]) THEN
      ASM_SIMP_TAC [COMPACT_IN_IMP_CLOSED_IN] THEN ASM SET_TAC []] THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"k:A->bool", ← q r"c:A->bool"]
          BOUNDARY_BUMPING_THEOREM_CLOSED_GEN) THEN
    ASM_SIMP_TAC [COMPACT_IN_IMP_CLOSED_IN, NOT_IMP] THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [frontier_of]] THEN
    MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET u ==> s INTER (t DIFF u) = {}")) THEN
    TRANS_TAC SUBSET_TRANS (← q r"v:A->bool") THEN
    ASM_SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ])

  let BOUNDARY_BUMPING_THEOREM_GEN ← prove
   r"!top s c:A->bool.
        connected_space top /\
        locally_compact_space top /\
        hausdorff_space top /\
        s PSUBSET topspace top /\
        c IN connected_components_of(subtopology top s) /\
        compact_in top (top closure_of c)
        ==> ~(top frontier_of c INTER top frontier_of s = {})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PSUBSET] THEN STRIP_TAC THEN
    REWRITE_TAC [frontier_of] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    REWRITE_TAC [SUBSET_INTER, TOPSPACE_SUBTOPOLOGY] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_IN_CONNECTED_COMPONENTS_OF) THEN
    REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"i SUBSET i' /\ c SUBSET c' /\ ~(c SUBSET i')
      ==> ~((c DIFF i) INTER (c' DIFF i') = {})")) THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [INTERIOR_OF_MONO],
      ASM_MESON_TAC [CLOSURE_OF_MONO],
      DISCH_TAC] THEN
    SUBGOAL_THEN (← q r"top closure_of c:A->bool = c") SUBST_ALL_TAC THENL
     [MATCH_MP_TAC SUBSET_ANTISYM THEN ASM_SIMP_TAC [CLOSURE_OF_SUBSET] THEN
      MATCH_MP_TAC CONNECTED_COMPONENTS_OF_MAXIMAL THEN
      EXISTS_TAC (← q r"subtopology top (s:A->bool)") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [ASM_SIMP_TAC [CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_CLOSURE_OF] THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] INTERIOR_OF_SUBSET) THEN
        ASM SET_TAC [],
        MATCH_MP_TAC (← SET_RULE (← q r"c SUBSET d /\ ~(c = {}) ==> ~DISJOINT c d")) THEN
        ASM_SIMP_TAC [CLOSURE_OF_SUBSET]],
      ALL_TAC] THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"c:A->bool", ← q r"top interior_of s:A->bool"]
          INTERMEDIATE_CONTINUUM_EXISTS) THEN
    ASM_REWRITE_TAC [OPEN_IN_INTERIOR_OF, NOT_IMP] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:A->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← SET_RULE (← q r"(c:A->bool) PSUBSET d ==> ~(d SUBSET c)")) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONNECTED_COMPONENTS_OF_MAXIMAL THEN
    EXISTS_TAC (← q r"subtopology top (s:A->bool)") THEN
    ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] INTERIOR_OF_SUBSET) THEN
    ASM SET_TAC [])

  let BOUNDARY_BUMPING_THEOREM ← prove
   r"!top s c:A->bool.
        connected_space top /\
        compact_space top /\
        hausdorff_space top /\
        s PSUBSET topspace top /\
        c IN connected_components_of(subtopology top s)
        ==> ~(top frontier_of c INTER top frontier_of s = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC BOUNDARY_BUMPING_THEOREM_GEN THEN
    ASM_SIMP_TAC [COMPACT_IMP_LOCALLY_COMPACT_SPACE] THEN
    ASM_SIMP_TAC [CLOSED_IN_COMPACT_SPACE, CLOSED_IN_CLOSURE_OF])

  return { BOUNDARY_BUMPING_THEOREM_CLOSED_GEN, BOUNDARY_BUMPING_THEOREM_CLOSED,
           INTERMEDIATE_CONTINUUM_EXISTS, BOUNDARY_BUMPING_THEOREM_GEN,
           BOUNDARY_BUMPING_THEOREM }

/- ------------------------------------------------------------------------- -/
/- k-spaces (with no Hausdorff-ness assumptions built in).                   -/
/- (metric.ml 27898-28065)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KSp1 where
  k_space : thm
  K_SPACE : thm
  K_SPACE_OPEN : thm
  K_SPACE_ALT : thm
  K_SPACE_QUOTIENT_MAP_IMAGE : thm
  K_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_K_SPACE : thm
  K_SPACE_PERFECT_MAP_IMAGE : thm
  LOCALLY_COMPACT_IMP_K_SPACE : thm
  COMPACT_IMP_K_SPACE : thm
  K_SPACE_DISCRETE_TOPOLOGY : thm
  METRIZABLE_IMP_K_SPACE : thm
  K_SPACE_MTOPOLOGY : thm
  K_SPACE_EUCLIDEANREAL : thm
  deriving Inhabited

@[nospecialize]
def setupKSp1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BPerfect : Perfect) (BNets : Nets) (BMTopology : MTopology)
    (BMetrizable : Metrizable) (BLocCompact1 : LocCompact1) (BRealTop2 : RealTop2)
    (BLimits1 : Limits1) (BLimits2 : Limits2) (BMetricLim : MetricLim) :
    ExceptT String IO KSp1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { IN_INSERT, IN_INTER, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP, .. } :=
    D.core2
  let { SUBSET, SUBSET_DIFF, SUBSET_RESTRICT, .. } := D.core4
  let { CONTRAPOS_THM, EQ_IMP, .. } := D.core5
  let { OPEN_IN_CLOSED_IN_EQ, OPEN_IN_INTER, closed_in, .. } := BTopology
  let { CLOSED_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_SUBTOPOLOGY,
        IN_CLOSURE_OF, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_MAP, .. } := BQuotient
  let { HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP, .. } :=
    BRetraction
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { PERFECT_IMP_QUOTIENT_MAP, .. } := BPerfect
  let { ALWAYS_EVENTUALLY, .. } := BNets
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { FORALL_METRIZABLE_SPACE, .. } := BMetrizable
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, locally_compact_space, .. } := BLocCompact1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_SUBTOPOLOGY, .. } := BLimits1
  let { COMPACT_IN_SEQUENCE_WITH_LIMIT, .. } := BLimits2
  let { METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED, .. } := BMetricLim
  -- @@SCOPE END

  let k_space ← new_definition
   r"k_space (top:A topology) <=>
        !s. s SUBSET topspace top
            ==> (closed_in top s <=>
                 !k. compact_in top k
                     ==> closed_in (subtopology top k) (k INTER s))"

  let K_SPACE ← prove
   r"!top:A topology.
        k_space top <=>
        !s. s SUBSET topspace top /\
            (!k. compact_in top k
                 ==> closed_in (subtopology top k) (k INTER s))
            ==> closed_in top s"
   (GEN_TAC THEN REWRITE_TAC [k_space] THEN
    MESON_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED])

  let K_SPACE_OPEN ← prove
   r"!top:A topology.
        k_space top <=>
        !s. s SUBSET topspace top /\
            (!k. compact_in top k
                 ==> open_in (subtopology top k) (k INTER s))
            ==> open_in top s"
   (GEN_TAC THEN REWRITE_TAC [K_SPACE] THEN
    EQ_TAC THEN DISCH_TAC THEN X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [OPEN_IN_CLOSED_IN_EQ, closed_in] THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [SUBSET_DIFF] THEN X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC id [OPEN_IN_CLOSED_IN_EQ, closed_in] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    (CONJ_TAC THENL [SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let K_SPACE_ALT ← prove
   r"!top:A topology.
        k_space top <=>
        !s. s SUBSET topspace top
            ==> (open_in top s <=>
                 !k. compact_in top k
                     ==> open_in (subtopology top k) (k INTER s))"
   (GEN_TAC THEN REWRITE_TAC [K_SPACE_OPEN] THEN
    MESON_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN])

  let K_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ k_space top ==> k_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [K_SPACE] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"s:B->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT2 o GEN_REWRITE_RULE id [QUOTIENT_MAP]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:B->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [SUBSET_RESTRICT] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"subtopology top k =
      subtopology
       (subtopology top {x | x IN topspace top /\ (q:A->B) x IN IMAGE q k}) k")
    SUBST1_TAC THENL
     [REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"k INTER {x | x IN topspace top /\ q x IN s} =
      k INTER {x | x IN topspace(subtopology top
                    {x | x IN topspace top /\ (q:A->B) x IN IMAGE q k}) /\
                   q x IN (IMAGE (q:A->B) k INTER s)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED THEN
    MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
    EXISTS_TAC (← q r"subtopology top' (IMAGE (q:A->B) k)") THEN CONJ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY THEN
      ASM_MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP],
      FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      ASM_MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP]])

  let K_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map (top,top') r /\ k_space top ==> k_space top'"
   (MESON_TAC [K_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let HOMEOMORPHIC_K_SPACE ← prove
   r"!(top:A topology) (top':B topology).
      top homeomorphic_space top'
      ==> (k_space top <=> k_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    MESON_TAC [K_SPACE_RETRACTION_MAP_IMAGE])

  let K_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        k_space top /\ perfect_map(top,top') f
        ==> k_space top'"
   (MESON_TAC [PERFECT_IMP_QUOTIENT_MAP, K_SPACE_QUOTIENT_MAP_IMAGE])

  let LOCALLY_COMPACT_IMP_K_SPACE ← prove
   r"!top:A topology. locally_compact_space top ==> k_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [K_SPACE] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [SUBSET, NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [CLOSURE_OF_SUBSET_TOPSPACE, SUBSET], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_compact_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") MP_TAC) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:A->bool") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o REWRITE_RULE [SUBSET] o CONJUNCT2) THEN
    ASM_REWRITE_TAC [IN_INTER, CLOSURE_OF_SUBTOPOLOGY] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [← SET_RULE (← q r"k INTER k INTER s = s INTER k"), IN_CLOSURE_OF] THEN
    X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_CLOSURE_OF]) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"u INTER v:A->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_INTER] THEN ASM SET_TAC [])

  let COMPACT_IMP_K_SPACE ← prove
   r"!top:A topology. compact_space top ==> k_space top"
   (MESON_TAC [LOCALLY_COMPACT_IMP_K_SPACE,
               COMPACT_IMP_LOCALLY_COMPACT_SPACE])

  let K_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. k_space(discrete_topology u)"
   (SIMP_TAC [K_SPACE, CLOSED_IN_DISCRETE_TOPOLOGY,
              TOPSPACE_DISCRETE_TOPOLOGY])

  let METRIZABLE_IMP_K_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> k_space top"
   (REWRITE_TAC [FORALL_METRIZABLE_SPACE] THEN X_GEN_TAC (← q r"m:A metric") THEN
    REWRITE_TAC [K_SPACE] THEN X_GEN_TAC (← q r"s:A->bool") THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:num->A", ← q r"l:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(l:A) INSERT IMAGE a (:num)")) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC COMPACT_IN_SEQUENCE_WITH_LIMIT THEN
      EXISTS_TAC (← q r"a:num->A") THEN REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
      ASM SET_TAC [],
      REWRITE_TAC [← GSYM MTOPOLOGY_SUBMETRIC] THEN
      REWRITE_TAC [METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED] THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:num->A", ← q r"l:A"] o CONJUNCT2) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC [IN_INTER]] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [LIMIT_SUBTOPOLOGY, MTOPOLOGY_SUBMETRIC] THEN
      REWRITE_TAC [IN_INSERT] THEN MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
      REWRITE_TAC [] THEN SET_TAC []])

  let K_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. k_space(mtopology m)"
   (REWRITE_TAC [← GSYM FORALL_METRIZABLE_SPACE, METRIZABLE_IMP_K_SPACE])

  let K_SPACE_EUCLIDEANREAL ← prove
   r"k_space euclideanreal"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC, K_SPACE_MTOPOLOGY])

  return { k_space, K_SPACE, K_SPACE_OPEN, K_SPACE_ALT, K_SPACE_QUOTIENT_MAP_IMAGE,
           K_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_K_SPACE, K_SPACE_PERFECT_MAP_IMAGE,
           LOCALLY_COMPACT_IMP_K_SPACE, COMPACT_IMP_K_SPACE, K_SPACE_DISCRETE_TOPOLOGY,
           METRIZABLE_IMP_K_SPACE, K_SPACE_MTOPOLOGY, K_SPACE_EUCLIDEANREAL }

/- ------------------------------------------------------------------------- -/
/- k-spaces and subtopologies.  (metric.ml 28067-28216)                      -/
/- ------------------------------------------------------------------------- -/

structure KSp2 where
  K_SPACE_CLOSED_SUBTOPOLOGY : thm
  K_SPACE_SUBTOPOLOGY : thm
  K_SPACE_SUBTOPOLOGY_OPEN : thm
  K_SPACE_OPEN_SUBTOPOLOGY : thm
  K_KC_SPACE_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupKSp2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BHausdorff1 : Hausdorff1) (BKC1 : KC1) (BRegular1 : Regular1)
    (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2) (BKSp1 : KSp1) :
    ExceptT String IO KSp2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FINITE_UNION, .. } := D.core1
  let { IMP_CONJ_ALT, INTER_ACI, INTER_SUBSET, .. } := D.core2
  let { SUBSET, SUBSET_DIFF, SUBSET_INTER, UNION_SUBSET, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, OPEN_IN_UNIONS, .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, CLOSED_IN_SUBSET_TOPSPACE,
        CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, CLOSED_IN_TRANS, OPEN_IN_SUBSET_TOPSPACE,
        OPEN_IN_SUBTOPOLOGY_INTER_OPEN, OPEN_IN_TRANS, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, compact_in,
        .. } := BCompact1
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { COMPACT_IN_IMP_CLOSED_IN_GEN, KC_SPACE_SUBTOPOLOGY, .. } := BKC1
  let { REGULAR_SPACE_SUBTOPOLOGY, .. } := BRegular1
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } := BLocCompact2
  let { K_SPACE, K_SPACE_OPEN, LOCALLY_COMPACT_IMP_K_SPACE, .. } := BKSp1
  -- @@SCOPE END

  let K_SPACE_CLOSED_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        k_space top /\ closed_in top s ==> k_space(subtopology top s)"
   (MAP_EVERY X_GEN_TAC [← q r"top:A topology", ← q r"c:A->bool"] THEN
    REWRITE_TAC [K_SPACE] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"s:A->bool") THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, COMPACT_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_IN_SUBSET_TOPSPACE THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
