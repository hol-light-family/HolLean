             (!x. g n x SUBSET mspace m) /\
             (!x. mdiameter m (g n x) < inv(&(SUC n))) /\
             (!x:num->bool. ?u. open_in cantor_space u /\ x IN u /\
               (!y. y IN u ==> g n y = g n x)) /\
             (!a. a IN mspace m ==> ?x. a IN g n x)")
