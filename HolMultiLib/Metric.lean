      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_ATPOINTOF] THEN
      EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [IN_DELETE] THEN
      X_GEN_TAC (← q r"y:A") THEN STRIP_TAC THEN DISCH_TAC THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
