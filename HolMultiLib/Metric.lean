structure CE2 where
  LIPSCHITZ_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE : thm
  LIPSCHITZ_CONTINUOUS_MAP_EXTENDS_TO_CLOSURE_OF : thm
  LIPSCHITZ_CONTINUOUS_MAP_EXTENDS_TO_INTERMEDIATE_CLOSURE_OF : thm
  deriving Inhabited

@[nospecialize]
def setupCE2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BClosure : Closure)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BProd1 : Prod1)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BRealTop1 : RealTop1)
    (BRealCont : RealCont) (BLIP1 : LIP1) (BCC2 : CC2) (BCC4 : CC4) (BCE1 : CE1) :
    ExceptT String IO CE2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { IMAGE_FST_CROSS, .. } := D.core1
  let { IMAGE_SND_CROSS, INTER_CROSS, IN_CROSS, IN_INTER, MONO_EXISTS, .. } := D.core2
  let { REAL_SUB_LE, SUBSET_REFL, o_DEF, real_ge, .. } := D.core4
  let { FORALL_PAIR_THM, PAIR, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET_INTER, CLOSURE_OF_SUBTOPOLOGY,
        FORALL_IN_CLOSURE_OF, closure_of, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
        CONTINUOUS_MAP_INTO_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSURE_OF_CROSS, CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS,
