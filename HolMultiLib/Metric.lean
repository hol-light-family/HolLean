          ASSUME_TAC THENL [GEN_TAC THEN
            REWRITE_TAC [closed_in, TOPSPACE_CANTOR_SPACE] THEN
          CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN SUBGOAL_THEN (← q r"(:num->bool) DIFF
             {x | (a:A) IN (g:num->(num->bool)->(A->bool)) n x} =
             {x:num->bool | ~(a IN g n
               x)}") SUBST1_TAC THENL [SET_TAC [], ALL_TAC] THEN
          ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"z:num->bool") THEN
          REWRITE_TAC [IN_ELIM_THM, TOPSPACE_CANTOR_SPACE, IN_UNIV] THEN
            DISCH_TAC THEN
          UNDISCH_TAC (← q r"!n:num. !x:num->bool.
            ?u:(num->bool)->bool. open_in cantor_space u /\ x IN u /\
              (!y. y IN u ==> (g:num->(num->bool)->(A->bool)) n y = g n x)") THEN
          DISCH_THEN (MP_TAC o SPECL [← q r"n:num", ← q r"z:num->bool"]) THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"w:(num->bool)->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"w:(num->bool)->bool") THEN
          REPLICATE_TAC 2 (CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC, ALL_TAC]) THEN
          REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"z':num->bool") THEN
            DISCH_TAC THEN
            SUBGOAL_THEN (← q r"(g:num->(num->bool)->(A->bool)) n z' = g n z")
              SUBST1_TAC THENL [FIRST_X_ASSUM MATCH_MP_TAC THEN
                FIRST_ASSUM ACCEPT_TAC,
              FIRST_ASSUM ACCEPT_TAC], ALL_TAC] THEN
        /- Find z in INTERS of all these sets -/
        SUBGOAL_THEN (← q r"?z:num->bool. !n:num.
            (a:A) IN (g:num->(num->bool)->(A->bool)) n z")
          STRIP_ASSUME_TAC THENL [MP_TAC (← ISPECL [← q r"cantor_space",
            ← q r"\n:num. {x:num->bool |
              (a:A) IN (g:num->(num->bool)->(A->bool)) n
                x}"] COMPACT_SPACE_IMP_NEST) THEN
          REWRITE_TAC [COMPACT_SPACE_CANTOR_SPACE] THEN
            ANTS_TAC THENL [REPEAT CONJ_TAC THENL
             [/- closedness -/ FIRST_ASSUM MATCH_ACCEPT_TAC,
              /- nonemptiness -/
              GEN_TAC THEN REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN
              UNDISCH_TAC
                (← q r"!n:num. !a:A. a IN mspace m ==> ?x:num->bool. a IN g n x") THEN
              DISCH_THEN (MP_TAC o SPECL [← q r"n:num", ← q r"a:A"]) THEN
                UNDISCH_TAC (← q r"(a:A) IN mspace m") THEN
              REWRITE_TAC [] THEN MESON_TAC [],
              /- monotonicity -/
              MATCH_MP_TAC TRANSITIVE_STEPWISE_LE THEN
                REPEAT CONJ_TAC THENL [SET_TAC [], SET_TAC [],
                GEN_TAC THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
                X_GEN_TAC (← q r"z:num->bool") THEN DISCH_TAC THEN
                  UNDISCH_TAC (← q r"!n:num. !x:num->bool.
                  (g:num->(num->bool)->(A->bool)) (SUC n) x SUBSET g n x") THEN
                DISCH_THEN (MP_TAC o SPECL [← q r"n:num", ← q r"z:num->bool"]) THEN
                  UNDISCH_TAC
                  (← q r"(a:A) IN (g:num->(num->bool)->(A->bool)) (SUC n) z") THEN
                REWRITE_TAC [SUBSET] THEN MESON_TAC []]], ALL_TAC] THEN
          REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
            DISCH_THEN (X_CHOOSE_TAC (← q r"z:num->bool")) THEN
          EXISTS_TAC (← q r"z:num->bool") THEN GEN_TAC THEN
          /- z IN INTERS {c n | n}, extract z IN c n -/
          FIRST_X_ASSUM MP_TAC THEN
            REWRITE_TAC [IN_INTERS, IN_ELIM_THM, IN_UNIV] THEN
          DISCH_THEN (MP_TAC o SPEC
            (← q r"{x:num->bool |
              (a:A) IN (g:num->(num->bool)->(A->bool)) n x}")) THEN
          ANTS_TAC THENL [EXISTS_TAC (← q r"n:num") THEN REWRITE_TAC [],
            REWRITE_TAC [IN_ELIM_THM]], ALL_TAC] THEN
        /- a IN g n z for all n, and INTERS {g n z | n} = {f z} -/
        EXISTS_TAC (← q r"z:num->bool") THEN
        /- Get INTERS {g n z | n} = {f z} from SKOLEM assumption -/
        SUBGOAL_THEN
          (← q r"INTERS {(g:num->(num->bool)->(A->bool)) n z | n | n IN (:num)} =
           {(f:(num->bool)->A) z}")
          ASSUME_TAC THENL [FIRST_ASSUM (fun th => tactic_of do
            pure (ACCEPT_TAC (← CONJUNCT2 (← SPEC (← q r"z:num->bool") th)))), ALL_TAC] THEN
        SUBGOAL_THEN (← q r"(a:A) IN {(f:(num->bool)->A) z}") MP_TAC THENL
         [FIRST_ASSUM (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
          REWRITE_TAC [IN_INTERS, IN_ELIM_THM, IN_UNIV] THEN
            X_GEN_TAC (← q r"s:A->bool") THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"k:num") SUBST1_TAC) THEN UNDISCH_TAC (← q r"!n:num.
            (a:A) IN (g:num->(num->bool)->(A->bool)) n z") THEN
          DISCH_THEN (ACCEPT_TAC o SPEC (← q r"k:num")), REWRITE_TAC [IN_SING]]])

  return { ALEXANDROFF_HAUSDORFF }

/- ------------------------------------------------------------------ -/
/- Peano space properties: ULC and path-connectedness.                -/
/- ULC: Whyburn, Analytic Topology, Ch. I Sec. 15 (15.5);             -/
/- H-Y Theorem 3-13; Willard, General Topology, 31.4.                 -/
/- (metric.ml 46704-48213)                                            -/
/- ------------------------------------------------------------------ -/

structure DFD where
  DENSE_FUNCTION_ON_DYADIC : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupDFD [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BConnected1 : Connected1) (BRealTop2 : RealTop2) (BUC1 : UC1) (BDIAM1 : DIAM1)
    (BWC2 : WC2) :
    ExceptT String IO DFD := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, INDUCT_TAC,
        MESON_TAC, NUMBER_RULE, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD, REAL_RAT_REDUCE_CONV,
        .. } := D
  let { ADD_CLAUSES, ADD_SYM, DIVIDES_DIV_MULT, DIVISION, DIVISION_SIMP, DIVMOD_UNIQ, DIV_0,
        DIV_1, DIV_DIV, DIV_MULT, DIV_REFL, DIV_UNIQ, EXP, FORALL_IN_IMAGE, .. } := D.core1
  let { INT_OF_NUM_MUL, IN_ELIM_THM, IN_INTER, IN_UNIV, LE, LE_0, LE_CASES, LE_LDIV,
        LE_LDIV_EQ, LE_MULT2, LE_MULT_LCANCEL, LE_MULT_RCANCEL, LE_RDIV_EQ, LE_REFL, LE_TRANS,
        LT_ADD_RCANCEL, LT_NZ, LT_REFL, LT_TRANS, MOD_0, MOD_MULT, MULT_ASSOC, MULT_CLAUSES,
        MULT_SYM, NOT_LT, RDIV_LT_EQ, REAL_ABS_DIV, REAL_ABS_NUM, .. } := D.core2
  let { REAL_ABS_SUB, REAL_ADD_LDISTRIB, REAL_ADD_RDISTRIB, REAL_ARCH_POW2, REAL_ARCH_POW_INV,
        REAL_DIV_1, REAL_DIV_EQ_0, REAL_DIV_REFL, REAL_INV_1, REAL_INV_MUL, REAL_INV_POW,
        REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_DIV, REAL_LE_DIV2_EQ, REAL_LE_INV, REAL_LE_INV2,
        REAL_LE_LADD_IMP, REAL_LE_LDIV_EQ, REAL_LE_LMUL, REAL_LE_MUL, REAL_LE_REFL,
        REAL_LE_RMUL, REAL_LE_TRANS, REAL_LTE_ADD2, REAL_LT_DIV, REAL_LT_DIV2_EQ,
        REAL_LT_IMP_LE, REAL_LT_INV, REAL_LT_LINV, REAL_LT_LMUL_EQ, REAL_LT_MIN, REAL_LT_MUL,
        REAL_LT_RDIV_EQ, REAL_LT_TRANS, REAL_MIN_LE, REAL_MUL_AC, REAL_MUL_LID, REAL_MUL_LZERO,
        REAL_MUL_RID, REAL_MUL_SYM, REAL_NOT_LT, REAL_OF_NUM_ADD, REAL_OF_NUM_EQ,
        REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_MUL, REAL_OF_NUM_POW, REAL_OF_NUM_SUC,
        REAL_POS, REAL_POW_INV, REAL_POW_LE, REAL_POW_LT, .. } := D.core3
  let { REAL_SUB_REFL, SELECT_UNIQUE, SKOLEM_THM, SUBSET, SUM_CLAUSES_NUMSEG, SUM_SING_NUMSEG,
        int_divides, num_RECURSION, num_WOP, num_divides, real_div, real_pow, .. } := D.core4
  let { EQ_SYM_EQ, FORALL_AND_THM, FST, RIGHT_IMP_EXISTS_THM, SND, .. } := D.core5
  let { IN_REAL_INTERVAL, SUM_GP, .. } := D.misc
  let { IN_MBALL, MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE, SUBMETRIC, .. } := BMetricSpace
  let { METRIC_CLOSURE_OF, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONNECTED_IN_SUBSET_TOPSPACE, .. } := BConnected1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { uniformly_continuous_map, .. } := BUC1
  let { MDIAMETER_BOUNDED_BOUND, .. } := BDIAM1
  let { CONNECTED_IN_IMP_WELLCHAINED, .. } := BWC2
  -- @@SCOPE END

  -- Uniform local connectedness for compact metrizable locally connected spaces:
  -- For every e > 0, there exists d > 0 such that any two points within d
  -- lie in a connected set of diameter < e.
  let DENSE_FUNCTION_ON_DYADIC ← do
    let FINITE_BOUND_NUM ← prove
     r"!f:num->num n. ?M. !k. k < n ==> f k <= M"
     (GEN_TAC THEN INDUCT_TAC THENL [EXISTS_TAC (← q r"0") THEN ARITH_TAC,
       FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"M0:num")) THEN
       EXISTS_TAC (← q r"M0 + (f:num->num) n") THEN GEN_TAC THEN DISCH_TAC THEN
       ASM_CASES_TAC (← q r"k:num = n") THENL [ASM_REWRITE_TAC [] THEN ARITH_TAC,
        SUBGOAL_THEN (← q r"k < n:num") (fun th =>
          FIRST_X_ASSUM (MP_TAC o C MATCH_MP th)) THENL [ASM_ARITH_TAC,
            ARITH_TAC]]])
    let UNIT_INTERVAL_APPROX ← prove
     r"!M:num t:real.
         1 <= M /\ &0 <= t /\ t <= &1
         ==> ?k. k <= M /\ abs(t - &k / &M) <= inv(&M)"
     (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"&0 < &M") ASSUME_TAC THENL
      [REWRITE_TAC [REAL_OF_NUM_LT] THEN ASM_ARITH_TAC, ALL_TAC] THEN
      /- Find minimal k with t * &M < &(SUC k) using num_WOP -/
      SUBGOAL_THEN (← q r"?k:num. t * &M < &(SUC k) /\
                 !j:num. j < k ==> ~(t * &M < &(SUC j))")
        STRIP_ASSUME_TAC THENL
      [MP_TAC (← ISPEC (← q r"\j:num. t * &M < &(SUC j)") num_WOP) THEN REWRITE_TAC [] THEN
       DISCH_THEN (fun th => tactic_of do pure (REWRITE_TAC [← GSYM th])) THEN
       EXISTS_TAC (← q r"M:num") THEN
       MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"&M:real") THEN CONJ_TAC THENL
       [GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
         MATCH_MP_TAC REAL_LE_RMUL THEN
        ASM_REWRITE_TAC [REAL_POS],
        REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC], ALL_TAC] THEN
          EXISTS_TAC (← q r"k:num") THEN
      /- Prove k <= M -/
      SUBGOAL_THEN (← q r"k:num <= M") ASSUME_TAC THENL
      [REWRITE_TAC [← GSYM NOT_LT] THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"t * &M < &(SUC M)") ASSUME_TAC THENL
       [MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"&M:real") THEN CONJ_TAC THENL
        [GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_MUL_LID] THEN
         MATCH_MP_TAC REAL_LE_RMUL THEN ASM_REWRITE_TAC [REAL_POS],
         REWRITE_TAC [REAL_OF_NUM_LT] THEN ARITH_TAC], ALL_TAC] THEN
       UNDISCH_TAC (← q r"!j:num. j < k ==> ~(t * &M < &(SUC j))") THEN
         DISCH_THEN (MP_TAC o SPEC (← q r"M:num")) THEN
       ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
       ASM_MESON_TAC [], ALL_TAC] THEN ASM_REWRITE_TAC [] THEN
      /- Prove &k <= t * &M -/
      SUBGOAL_THEN (← q r"&k <= t * &M") ASSUME_TAC THENL [ASM_CASES_TAC (← q r"k = 0") THENL
       [ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_LE_MUL THEN
         ASM_REWRITE_TAC [REAL_POS],
        UNDISCH_TAC (← q r"!j:num. j < k ==> ~(t * &M < &(SUC j))") THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"k - 1")) THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN
        SUBGOAL_THEN (← q r"SUC(k - 1) = k") (fun th => REWRITE_TAC [th]) THENL
          [ASM_ARITH_TAC,
         REWRITE_TAC [REAL_NOT_LT]]], ALL_TAC] THEN
      /- Prove abs(t - &k / &M) <= inv(&M) -/
      MATCH_MP_TAC (← REAL_ARITH
        (← q r"a <= t /\ t - a < e ==> abs(t - a) <= e")) THEN CONJ_TAC THENL
      [/- &k / &M <= t -/ ASM_SIMP_TAC [REAL_LE_LDIV_EQ] THEN
       ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"&(SUC k) / &M = &k / &M + inv(&M)")
        ASSUME_TAC THENL
      [REWRITE_TAC [real_div, ← GSYM REAL_OF_NUM_SUC, REAL_ADD_RDISTRIB,
        REAL_MUL_LID], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"t < &(SUC k) / &M") ASSUME_TAC THENL
        [ASM_SIMP_TAC [REAL_LT_RDIV_EQ] THEN
       ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
         ASM_REAL_ARITH_TAC)
    let resolve_select_tac (cont_tac : tactic) : tactic := tactic_of do pure (
      DISCH_THEN (X_CHOOSE_THEN (← q r"nn:num")
        (X_CHOOSE_THEN (← q r"kk:num")
          STRIP_ASSUME_TAC)) THEN ASM_REWRITE_TAC [] THEN REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"(@z:A. ?n k:num.
           k <= (N:num->num) n /\
           &kk / &(N nn) = &k / &(N n) /\
           z = (h:num->num->A) n k) = h nn kk")
        SUBST1_TAC THENL [MATCH_MP_TAC SELECT_UNIQUE THEN X_GEN_TAC (← q r"z:A") THEN
          EQ_TAC THENL
       [DISCH_THEN (fun th => tactic_of do pure (
          X_CHOOSE_THEN (← q r"n1:num")
            (X_CHOOSE_THEN (← q r"k1:num")
              STRIP_ASSUME_TAC) (← REWRITE_RULE [] th))) THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n1:num", ← q r"nn:num",
           ← q r"k1:num", ← q r"kk:num"]) THEN ASM_REWRITE_TAC [] THEN MESON_TAC [],
        DISCH_TAC THEN ASM_REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
          [← q r"nn:num", ← q r"kk:num"] THEN ASM_REWRITE_TAC []], cont_tac])
    let resolve_select_B_tac (eq_tm n_tm k_tm : term) : tactic := tactic_of do pure (
      MATCH_MP_TAC SELECT_UNIQUE THEN X_GEN_TAC (← q r"z:A") THEN
        EQ_TAC THENL [DISCH_THEN (fun th => tactic_of do pure (
         X_CHOOSE_THEN (← q r"n1:num")
           (X_CHOOSE_THEN (← q r"k1:num") STRIP_ASSUME_TAC) (← REWRITE_RULE [] th))) THEN
             ASM_REWRITE_TAC [] THEN
       SUBGOAL_THEN eq_tm ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
       FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n1:num", n_tm, ← q r"k1:num", k_tm]) THEN
       ASM_REWRITE_TAC [] THEN SIMP_TAC [], DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
       MAP_EVERY EXISTS_TAC [n_tm, k_tm] THEN ASM_REWRITE_TAC []])
    let le_ldiv_Nn_tac : tactic :=
      MATCH_MP_TAC LE_LDIV THEN CONJ_TAC THENL
      [REWRITE_TAC [← GSYM LT_NZ, ← ARITH_RULE (← q r"0 < n <=> 1 <= n")] THEN
       SUBGOAL_THEN (← q r"~((N:num->num) n = 0)") ASSUME_TAC THENL
       [MATCH_MP_TAC (← ARITH_RULE (← q r"1 <= n ==> ~(n = 0)")) THEN
         ASM_REWRITE_TAC [], ALL_TAC] THEN
       ASM_SIMP_TAC [LE_RDIV_EQ] THEN REWRITE_TAC [MULT_CLAUSES] THEN
       MATCH_MP_TAC LE_TRANS THEN EXISTS_TAC (← q r"2 * (N:num->num) n") THEN
       ASM_REWRITE_TAC [] THEN ARITH_TAC,
       SUBGOAL_THEN (← q r"N(SUC n) DIV (N:num->num) n * N n = N(SUC n)")
         SUBST1_TAC THENL
          [ASM_MESON_TAC [DIVIDES_DIV_MULT],
           ASM_REWRITE_TAC []]]
    let divides_N_tac : tactic :=
      REWRITE_TAC [← GSYM DIVIDES_DIV_MULT] THEN USE_THEN "6d" MATCH_MP_TAC
    let num_field_tac : tactic :=
      REWRITE_TAC [← GSYM REAL_OF_NUM_EQ, ← GSYM REAL_OF_NUM_MUL] THEN
        CONV_TAC (fun t => REAL_FIELD t)
    let mdist_fk_self_zero_tac : tactic :=
      SUBGOAL_THEN (← q r"mdist m ((fk:num->num->A)(kk DIV M)((Mk:num->num)(kk DIV M)),
                  fk(kk DIV M)(Mk(kk DIV M))) = &0")
        (fun th => REWRITE_TAC [th]) THENL [MATCH_MP_TAC MDIST_REFL THEN
       SUBGOAL_THEN (← q r"(Mk:num->num)(kk DIV M) <= Mk(kk DIV M)") MP_TAC THENL
         [ARITH_TAC, ALL_TAC] THEN
       ASM_MESON_TAC [],
       UNDISCH_TAC (← q r"!n. &0 < (dl:num->real) n") THEN
         DISCH_THEN (ACCEPT_TAC o SPEC (← q r"SUC(SUC n)"))]
    prove
     r"!m:A metric e.
       mcomplete m /\ &0 < e /\
       (!eps. &0 < eps
              ==> ?del. &0 < del /\
                        !x y:A. x IN mspace m /\ y IN mspace m /\
                                mdist m (x,y) < del
                                ==> ?c. connected_in(mtopology m) c /\
                                        x IN c /\ y IN c /\
                                        mbounded m c /\
                                        mdiameter m c < eps)
       ==> ?d. &0 < d /\
               !x y:A. x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < d
                       ==> ?f s. s SUBSET real_interval[&0,&1] /\
                                 real_interval[&0,&1] SUBSET
                                   euclideanreal closure_of s /\
                                 &0 IN s /\ &1 IN s /\
                                 (f:real->A)(&0) = x /\ f(&1) = y /\
                                 IMAGE f s SUBSET mspace m /\
                                 (!a. a IN s ==> mdist m (x,f a) <= e / &4) /\
                                 uniformly_continuous_map
                                   (submetric real_euclidean_metric s, m) f"
     (REPEAT GEN_TAC THEN STRIP_TAC THEN
      /- Step 1: Skolemize ULC to get delta function -/
      SUBGOAL_THEN (← q r"?del. !eps. &0 < eps
                     ==> &0 < (del:real->real) eps /\
                         !x y:A. x IN mspace m /\ y IN mspace m /\
                                 mdist m (x,y) < del eps
                                 ==> ?c. connected_in(mtopology m) c /\
                                         x IN c /\ y IN c /\
                                         mbounded m c /\
                                         mdiameter m c < eps")
        STRIP_ASSUME_TAC THENL [REWRITE_TAC [← GSYM SKOLEM_THM] THEN
          X_GEN_TAC (← q r"eps:real") THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"eps:real")) THEN
       ASM_CASES_TAC (← q r"&0 < eps") THENL
       [ASM_REWRITE_TAC [] THEN
         DISCH_THEN ACCEPT_TAC, ASM_REWRITE_TAC []], ALL_TAC] THEN
      /- Step 2: Build eps/delta sequence with all needed properties -/
      SUBGOAL_THEN (← q r"?ep dl. (ep:num->real) 0 = e / &8 /\
                 (dl:num->real) 0 = (del:real->real)(e / &8) /\
                 (!n. ep(SUC n) = min (dl n) (ep n / &4)) /\
                 (!n. dl n = del(ep n)) /\
                 (!n. &0 < ep n) /\
                 (!n. &0 < dl n) /\
                 (!n. ep(SUC n) <= dl n) /\
                 (!n. ep(SUC n) <= ep n / &4) /\
                 (!n. ep n <= e / &8 / &4 pow n)")
        STRIP_ASSUME_TAC THENL [/- Construct ep via num_RECURSION -/ MP_TAC (← ISPECL
          [← q r"e / &8",
         ← q r"\(v:real) (n:num). min ((del:real->real) v) (v / &4)"] num_RECURSION)
           THEN REWRITE_TAC [] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"ep:num->real") STRIP_ASSUME_TAC) THEN
       /- Provide witnesses -/
       EXISTS_TAC (← q r"ep:num->real") THEN
       EXISTS_TAC (← q r"\n:num. (del:real->real)((ep:num->real) n)") THEN
         REWRITE_TAC [] THEN REPLICATE_TAC 3
        (CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC]) THEN
       /- &0 < ep n -/
       SUBGOAL_THEN (← q r"!n. &0 < (ep:num->real) n") ASSUME_TAC THENL [INDUCT_TAC THENL
        [ASM_REWRITE_TAC [] THEN
          ASM_REAL_ARITH_TAC, ASM_REWRITE_TAC [REAL_LT_MIN] THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(ep:num->real) n") o
            check (HolCore.Basics.is_forall o concl) o
            check (HolCore.Basics.free_in (← q r"del:real->real") o concl)) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (ACCEPT_TAC o CONJUNCT1),
          ASM_REAL_ARITH_TAC]], ALL_TAC] THEN ASM_REWRITE_TAC [] THEN
       /- &0 < dl n = &0 < del(ep n) -/
       CONJ_TAC THENL [GEN_TAC THEN
         FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(ep:num->real) n") o
          check (HolCore.Basics.is_forall o concl) o
          check (HolCore.Basics.free_in (← q r"del:real->real") o concl)) THEN
        ASM_REWRITE_TAC [] THEN
        DISCH_THEN (ACCEPT_TAC o CONJUNCT1), ALL_TAC] THEN
       /- ep(SUC n) <= dl n and ep(SUC n) <= ep n / 4 -/
