       DISCH_THEN (X_CHOOSE_THEN (← q r"t:real") STRIP_ASSUME_TAC) THEN ASM_MESON_TAC [],
       DISCH_TAC THEN SUBGOAL_THEN (← q r"(y:A) IN IMAGE (f:real->A) C") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [IN_IMAGE]] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"c:real") STRIP_ASSUME_TAC) THEN
         EXISTS_TAC (← q r"c:real") THEN
       CONJ_TAC THENL [ASM_MESON_TAC [], ASM SET_TAC []]])

  return { PEANO_GAP_FILLING_EXTENSION }

