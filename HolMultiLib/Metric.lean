  let { LIMIT_METRIC, .. } := BMetricLim
  let { MCOMPLETE_FIP_SING, .. } := BCauchy3
  -- @@SCOPE END

  let CONVERGENT_EQ_ZERO_OSCILLATION_GEN ← prove
   r"!top m (f:A->B) s a.
