    ASSUME_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:A") o REWRITE_RULE [locally_compact_space]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"c:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"s INTER c:A->bool") THEN
      ASM_SIMP_TAC [] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL
     [ASM_REWRITE_TAC [closed_in] THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"u DIFF (s INTER u):A->bool") THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_HAUSDORFF_FINITE THEN ASM_REWRITE_TAC [] THEN
        ASM SET_TAC [],
        ASM SET_TAC [],
        ASM SET_TAC []],
      CONV_TAC SYM_CONV THEN
      REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE, TOPSPACE_SUBTOPOLOGY] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
      REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
      EXISTS_TAC (← q r"u DIFF ((s INTER u) DELETE (x:A))") THEN CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_HAUSDORFF_FINITE THEN
        ASM_REWRITE_TAC [FINITE_DELETE] THEN ASM SET_TAC [],
        ASM SET_TAC []]])

  let LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\ open_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        locally_compact_space top
        ==> locally_compact_space top'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [locally_compact_space] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A") o
      GEN_REWRITE_RULE id [locally_compact_space]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"k:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"IMAGE (f:A->B) u", ← q r"IMAGE (f:A->B) k"] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [open_map]) THEN
    ASM_SIMP_TAC [FUN_IN_IMAGE, IMAGE_SUBSET] THEN
    ASM_MESON_TAC [IMAGE_COMPACT_IN])

  return { LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSED_IN,
           LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_CLOSURE_OF,
           LOCALLY_COMPACT_SPACE_NEIGHBOURHOOD_BASE_OPEN_CLOSURE_OF,
           LOCALLY_COMPACT_SPACE_COMPACT_CLOSED_COMPACT,
           LOCALLY_COMPACT_REGULAR_SPACE_NEIGHBOURHOOD_BASE, LOCALLY_COMPACT_KC_SPACE,
           LOCALLY_COMPACT_KC_SPACE_ALT, LOCALLY_COMPACT_KC_IMP_REGULAR_SPACE,
           KC_LOCALLY_COMPACT_SPACE, LOCALLY_COMPACT_SPACE_CLOSED_SUBSET,
           LOCALLY_COMPACT_SPACE_OPEN_SUBSET, LOCALLY_COMPACT_SPACE_DISCRETE_TOPOLOGY, FINITE_IN_COMPACT_IMP_CLOSED_DISCRETE,
           LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Locally compact subspaces and products.  (metric.ml 17582-17792)          -/
/- ------------------------------------------------------------------------- -/

structure LocCompact3 where
  LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF : thm
  LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN : thm
  LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF_EQ : thm
  LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN_EQ : thm
  DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE : thm
  LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY : thm
  LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupLocCompact3 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BProd1 : Prod1) (BProd2 : Prod2)
    (BProduct1 : Product1) (BProduct2 : Product2) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BCompact4 : Compact4) (BCompact5 : Compact5)
    (BHausdorff1 : Hausdorff1) (BLocCompact1 : LocCompact1) (BLocCompact2 : LocCompact2) :
    ExceptT String IO LocCompact3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, CROSS_EQ_EMPTY, EXISTS_IN_GSPEC, FINITE_SUBSET, IMAGE_FST_CROSS,
        .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SND_CROSS, IMAGE_SUBSET, IMP_CONJ,
        IMP_CONJ_ALT, INTER_COMM, IN_CROSS, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, SUBSET_INTER, SUBSET_REFL,
        SUBSET_TRANS, cartesian_product, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, DE_MORGAN_THM, EQ_IMP, FORALL_PAIR_THM, RIGHT_EXISTS_AND_THM,
        RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE,
        TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET,
        OPEN_IN_INTER_CLOSURE_OF_EQ, .. } := BClosure
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { OPEN_MAP_FST, OPEN_MAP_SND, .. } := BProd2
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, OPEN_IN_CARTESIAN_PRODUCT_GEN,
        OPEN_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, compact_space, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { COMPACT_IN_CARTESIAN_PRODUCT, .. } := BCompact5
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { locally_compact_space, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_CLOSED_SUBSET, LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE,
        LOCALLY_COMPACT_SPACE_OPEN_SUBSET, .. } := BLocCompact2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF ← prove
   r"!top s:A->bool.
        hausdorff_space top /\
        s SUBSET topspace top /\ locally_compact_space(subtopology top s)
        ==> open_in (subtopology top (top closure_of s)) s"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(a:A) IN topspace top") ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_compact_space]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"a:A")) THEN
    ASM_REWRITE_TAC [IN_INTER, TOPSPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, IN_INTER] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC)) THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET], ALL_TAC] THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN
    W (MP_TAC o PART_MATCH (lhand o rand) OPEN_IN_INTER_CLOSURE_OF_EQ o
      lhand o snd) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    MATCH_MP_TAC (← sr r"t SUBSET u ==> s INTER t SUBSET u") THEN
    TRANS_TAC SUBSET_TRANS (← q r"k:A->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
    ONCE_REWRITE_TAC [INTER_COMM] THEN ASM_SIMP_TAC [COMPACT_IN_IMP_CLOSED_IN])

  let LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN ← prove
   r"!top s:A->bool.
        hausdorff_space top /\
        s SUBSET topspace top /\ locally_compact_space(subtopology top s)
        ==> ?c u. closed_in top c /\ open_in top u /\ c INTER u = s"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EXISTS_TAC (← q r"top closure_of s:A->bool") THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP
     LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF) THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, CLOSED_IN_CLOSURE_OF] THEN
    MESON_TAC [INTER_COMM])

  let LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF_EQ ← prove
   r"!top s:A->bool.
      hausdorff_space top /\ locally_compact_space top
      ==> (open_in (subtopology top (top closure_of s)) s <=>
           s SUBSET topspace top /\ locally_compact_space(subtopology top s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF]] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"subtopology top (s:A->bool) =
      subtopology (subtopology top (top closure_of s)) s")
    SUBST1_TAC THENL
     [REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN AP_TERM_TAC THEN ASM SET_TAC [],
      MATCH_MP_TAC LOCALLY_COMPACT_SPACE_OPEN_SUBSET THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
      MATCH_MP_TAC LOCALLY_COMPACT_SPACE_CLOSED_SUBSET THEN
      ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF]])

  let LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN_EQ ← prove
   r"!top s:A->bool.
      hausdorff_space top /\ locally_compact_space top
      ==> ((?c u. closed_in top c /\ open_in top u /\ c INTER u = s) <=>
           s SUBSET topspace top /\ locally_compact_space(subtopology top s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM],
      ASM_MESON_TAC [LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN]] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"u:A->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    EXPAND_TAC "s" THEN REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN
    MATCH_MP_TAC LOCALLY_COMPACT_SPACE_OPEN_SUBSET THEN
    ASM_SIMP_TAC [LOCALLY_COMPACT_SPACE_CLOSED_SUBSET,
                  HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
    EXPAND_TAC "s" THEN ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN])

  let DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE ← prove
   r"!top s:A->bool.
        hausdorff_space top /\
        s SUBSET topspace top /\
        top closure_of s = topspace top /\
        locally_compact_space(subtopology top s)
        ==> open_in top s"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
          LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_TOPSPACE])

  let LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        locally_compact_space (prod_topology top1 top2) <=>
        topspace (prod_topology top1 top2) = {} \/
        locally_compact_space top1 /\ locally_compact_space top2"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THENL
     [ASM_REWRITE_TAC [NOT_IN_EMPTY, locally_compact_space], ALL_TAC] THEN
    ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE
     [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ] (← REWRITE_RULE [CONJ_ASSOC]
        LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE))
      THENL [EXISTS_TAC (← q r"FST:A#B->A"), EXISTS_TAC (← q r"SND:A#B->B")] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, OPEN_MAP_FST, TOPSPACE_PROD_TOPOLOGY,
        CONTINUOUS_MAP_SND, OPEN_MAP_SND, IMAGE_FST_CROSS, IMAGE_SND_CROSS],
      FIRST_X_ASSUM (CONJUNCTS_THEN MP_TAC) THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:B") THEN DISCH_TAC THEN X_GEN_TAC (← q r"w:A") THEN DISCH_TAC THEN
      REWRITE_TAC [locally_compact_space, FORALL_PAIR_THM, IN_CROSS,
                   TOPSPACE_PROD_TOPOLOGY] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u1:A->bool", ← q r"k1:A->bool"] THEN STRIP_TAC THEN
      MAP_EVERY X_GEN_TAC [← q r"u2:B->bool", ← q r"k2:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(u1:A->bool) CROSS (u2:B->bool)") THEN
      EXISTS_TAC (← q r"(k1:A->bool) CROSS (k2:B->bool)") THEN
      ASM_SIMP_TAC [OPEN_IN_CROSS, COMPACT_IN_CROSS, IN_CROSS, SUBSET_CROSS]])

  let LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        locally_compact_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        FINITE {i | i IN k /\ ~compact_space(tops i)} /\
        !i. i IN k ==> locally_compact_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THEN
    ASM_REWRITE_TAC [locally_compact_space, NOT_IN_EMPTY] THEN EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A")) THEN CONJ_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:K->A")) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"u:(K->A)->bool", ← q r"c:(K->A)->bool"] THEN
        STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"z:K->A") o
          REWRITE_RULE [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"v:K->A->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN
        ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [CONTRAPOS_THM] THEN
        DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o ISPECL [← q r"(tops:K->A topology) i", ← q r"\x:K->A. x i"] o
          MATCH_MP (← REWRITE_RULE [IMP_CONJ] IMAGE_COMPACT_IN)) THEN
        ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, compact_space] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← sr r"v = u ==> v SUBSET s /\ s SUBSET u ==> s = u")) THEN
        CONJ_TAC THENL
         [TRANS_TAC SUBSET_TRANS (← q r"IMAGE (\x:K->A. x i) u") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN TRANS_TAC SUBSET_TRANS
           (← q r"IMAGE (\x:K->A. x i) (cartesian_product k v)") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET] THEN
          REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
          COND_CASES_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN
          ASM SET_TAC [],
          TRANS_TAC SUBSET_TRANS
            (← q r"IMAGE (\x:K->A. x i) (topspace(product_topology k tops))") THEN
          ASM_SIMP_TAC [IMAGE_SUBSET, COMPACT_IN_SUBSET_TOPSPACE] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
          ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                           TOPSPACE_PRODUCT_TOPOLOGY] THEN
          REWRITE_TAC [o_THM, SUBSET_REFL]],
        X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        REWRITE_TAC [← GSYM locally_compact_space] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [← GSYM locally_compact_space]) THEN
        FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
          (← REWRITE_RULE [CONJ_ASSOC]
                  LOCALLY_COMPACT_SPACE_CONTINUOUS_OPEN_MAP_IMAGE))) THEN
        EXISTS_TAC (← q r"\x:K->A. x i") THEN
        ASM_SIMP_TAC [OPEN_MAP_PRODUCT_PROJECTION, TOPSPACE_PRODUCT_TOPOLOGY,
                      CONTINUOUS_MAP_PRODUCT_PROJECTION,
                      IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
        ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM]],
      STRIP_TAC THEN X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"!i. i IN k
            ==> ?u c. open_in (tops i) u /\
                      compact_in (tops i) c /\
                      ((z:K->A) i) IN u /\
                       u SUBSET c /\
                      (compact_space(tops i)
                       ==> u = topspace(tops i) /\ c = topspace(tops i))")
      MP_TAC THENL
       [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"(z:K->A) i")) THEN ANTS_TAC THENL
         [ALL_TAC,
          ASM_CASES_TAC (← q r"compact_space((tops:K->A topology) i)") THEN
          ASM_REWRITE_TAC [] THEN DISCH_THEN (K ALL_TAC) THEN
          REPEAT (EXISTS_TAC (← q r"topspace((tops:K->A topology) i)")) THEN
          ASM_SIMP_TAC [OPEN_IN_TOPSPACE, ← GSYM compact_space, SUBSET_REFL]] THEN
        UNDISCH_TAC (← q r"(z:K->A) IN topspace (product_topology k tops)") THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product] THEN
        ASM_SIMP_TAC [IN_ELIM_THM, o_THM],
        GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:K->A->bool", ← q r"c:K->A->bool"] THEN DISCH_TAC THEN
      MAP_EVERY EXISTS_TAC
       [← q r"cartesian_product k (u:K->A->bool)",
        ← q r"cartesian_product k (c:K->A->bool)"] THEN
      ASM_SIMP_TAC [COMPACT_IN_CARTESIAN_PRODUCT] THEN
      ASM_SIMP_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN CONJ_TAC THENL
       [DISJ2_TAC THEN ASM_SIMP_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
          (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_MESON_TAC [],
        UNDISCH_TAC (← q r"(z:K->A) IN topspace (product_topology k tops)") THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product] THEN
        ASM_SIMP_TAC [IN_ELIM_THM, o_THM]]])

  return { LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF,
           LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN,
           LOCALLY_COMPACT_SUBSPACE_OPEN_IN_CLOSURE_OF_EQ,
           LOCALLY_COMPACT_SUBSPACE_CLOSED_INTER_OPEN_IN_EQ,
           DENSE_LOCALLY_COMPACT_OPEN_IN_HAUSDORFF_SPACE, LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY,
           LOCALLY_COMPACT_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Locally compact spaces: sums, quotient products, perfect maps.            -/
