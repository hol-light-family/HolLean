@[nospecialize]
def setupMCompact3 [HolBase] (D : MetricDeps) (BDerived : Derived) (BClosure : Closure)
    (BCompact1 : Compact1) (BCompact2 : Compact2) (BHausdorff1 : Hausdorff1) (BNets : Nets)
