structure TYCH where
  COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING_EXPLICIT : thm
  COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING : thm
  deriving Inhabited

@[nospecialize]
def setupTYCH [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap2 : ContMap2) (BProduct1 : Product1) (BProduct2 : Product2) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BEmbedding : Embedding) (BHausdorff1 : Hausdorff1)
    (BMetricSpace : MetricSpace) (BBounded : Bounded) (BRealTop1 : RealTop1)
    (BRealTop2 : RealTop2) (BRealConn1 : RealConn1) (BLimits1 : Limits1) (BPtCont : PtCont)
    (BCRegular1 : CRegular1) (BCFUN : CFUN) : ExceptT String IO TYCH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_RAT_REDUCE_CONV, .. } := D
  let { ETA_AX, EXISTS_IN_GSPEC, FINITE_SING, FINITE_SUBSET, FORALL_IN_IMAGE, FUN_IN_IMAGE, .. } :=
    D.core1
  let { IMAGE_RESTRICTION, IMP_CONJ, IMP_CONJ_ALT, INJECTIVE_ON_ALT, INJECTIVE_ON_LEFT_INVERSE,
        IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM, .. } :=
    D.core2
  let { RESTRICTION, RESTRICTION_IN_EXTENSIONAL, SUBSET, SUBSET_REFL, cartesian_product, o_THM,
        real_abs, .. } := D.core4
  let { CONTRAPOS_THM, FORALL_UNWIND_THM2, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, RESTRICTION_CONTINUOUS_MAP, .. } := BContMap2
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, OPEN_IN_CARTESIAN_PRODUCT_GEN, .. } := BProduct2
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { embedding_map, .. } := BEmbedding
  let { CLOSED_IN_HAUSDORFF_SING, HAUSDORFF_SPACE_SUBTOPOLOGY, OPEN_IN_HAUSDORFF_DELETE, .. } :=
    BHausdorff1
  let { SUBMETRIC, .. } := BMetricSpace
  let { MBOUNDED_SUBSET, .. } := BBounded
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC,
        .. } := BRealTop2
  let { MBOUNDED_REAL_EUCLIDEAN_METRIC, REAL_BOUNDED_REAL_INTERVAL, real_bounded, .. } :=
    BRealConn1
  let { LIMIT_ATPOINTOF, .. } := BLimits1
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  let { completely_regular_space, .. } := BCRegular1
  let { CFUNSPACE, .. } := BCFUN
  -- @@SCOPE END

  let COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING_EXPLICIT ← prove
   r"!top:A topology.
        completely_regular_space top /\ hausdorff_space top
        ==> embedding_map
             (top,
              product_topology
                (mspace (submetric (cfunspace top real_euclidean_metric)
                  {f | IMAGE f (topspace top) SUBSET real_interval [&0,&1]}))
                (\f. subtopology euclideanreal (real_interval [&0,&1])))
             (\x. RESTRICTION
                  (mspace (submetric (cfunspace top real_euclidean_metric)
                    {f | IMAGE f (topspace top) SUBSET real_interval [&0,&1]}))
                  (\f. f x))"
   (REPEAT STRIP_TAC THEN
    MAP_EVERY ABBREV_TAC
     [← q r"k = mspace(submetric (cfunspace top real_euclidean_metric)
                            {f | IMAGE f (topspace top:A->bool) SUBSET
                                 real_interval[&0,&1]})",
      ← q r"e = \x. RESTRICTION k (\f:A->real. f x)"] THEN
    SUBGOAL_THEN
     (← q r"!x y. x IN topspace top /\ y IN topspace top
            ==> ((e:A->(A->real)->real) x = e y <=> x = y)")
    ASSUME_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      EQ_TAC THEN SIMP_TAC [] THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      DISCH_TAC THEN EXPAND_TAC "e" THEN REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [completely_regular_space]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"{x:A}", ← q r"y:A"]) THEN
      ASM_SIMP_TAC [IN_DIFF, IN_SING, CLOSED_IN_HAUSDORFF_SING] THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, FORALL_UNWIND_THM2] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:A->real") THEN REWRITE_TAC [IN_REAL_INTERVAL] THEN STRIP_TAC THEN
      DISCH_THEN (MP_TAC o C AP_THM (← q r"RESTRICTION(topspace top) (f:A->real)")) THEN
      ASM_REWRITE_TAC [RESTRICTION] THEN COND_CASES_TAC THEN
      ASM_REWRITE_TAC [] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
      FIRST_X_ASSUM (MP_TAC o check (HolCore.Basics.is_neg o concl)) THEN
      EXPAND_TAC "k" THEN REWRITE_TAC [SUBMETRIC] THEN
      SIMP_TAC [CFUNSPACE, IN_ELIM_THM, IN_INTER, RESTRICTION_IN_EXTENSIONAL] THEN
      REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      SIMP_TAC [IMAGE_RESTRICTION, RESTRICTION_CONTINUOUS_MAP, SUBSET_REFL] THEN
      ASM_REWRITE_TAC [MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
      REWRITE_TAC [MBOUNDED_REAL_EUCLIDEAN_METRIC, real_bounded] THEN
      EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [real_abs],
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM INJECTIVE_ON_ALT])] THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"e':((A->real)->real)->A")) THEN
    REWRITE_TAC [embedding_map, HOMEOMORPHIC_MAP_MAPS] THEN
    EXISTS_TAC (← q r"e':((A->real)->real)->A") THEN
    ASM_REWRITE_TAC [homeomorphic_maps, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [IN_INTER, IMP_CONJ_ALT, FORALL_IN_IMAGE] THEN CONJ_TAC THENL
     [REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
      REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE, SUBSET, FORALL_IN_IMAGE] THEN
      EXPAND_TAC "e" THEN REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN
      X_GEN_TAC (← q r"f:A->real") THEN SIMP_TAC [RESTRICTION] THEN EXPAND_TAC "k" THEN
      REWRITE_TAC [SUBMETRIC, CFUNSPACE, IN_ELIM_THM] THEN
      SIMP_TAC [IN_ELIM_THM, CONTINUOUS_MAP_IN_SUBTOPOLOGY, ETA_AX, IN_INTER,
                MTOPOLOGY_REAL_EUCLIDEAN_METRIC],
      ALL_TAC] THEN
    REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [IN_INTER, IMP_CONJ_ALT, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:A") THEN ASM_SIMP_TAC [] THEN REPEAT DISCH_TAC THEN
    ASM_REWRITE_TAC [LIMIT_ATPOINTOF] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"topspace top DIFF u:A->bool", ← q r"x:A"] o
          GEN_REWRITE_RULE id [completely_regular_space]) THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, IN_DIFF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:A->real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC] THEN
    EXISTS_TAC
     (← q r"cartesian_product (k:(A->real)->bool)
        (\f. if f = RESTRICTION (topspace top) g
             then real_interval[&0,&1] DELETE &1
             else real_interval[&0,&1])") THEN
    REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
    REPEAT (CONJ_TAC ORELSE DISJ2_TAC) THENL
     [MATCH_MP_TAC FINITE_SUBSET THEN
      EXISTS_TAC (← q r"{RESTRICTION (topspace top) (g:A->real)}") THEN
      REWRITE_TAC [FINITE_SING, SUBSET, IN_ELIM_THM, IN_SING] THEN MESON_TAC [],
      REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
      TRY (MATCH_MP_TAC OPEN_IN_HAUSDORFF_DELETE) THEN
      ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY,
                    HAUSDORFF_SPACE_EUCLIDEANREAL] THEN
      MESON_TAC [OPEN_IN_TOPSPACE, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY],
      ASM_SIMP_TAC [IN_INTER, FUN_IN_IMAGE] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV
       [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_THM,
                   TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY] THEN
      REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN COND_CASES_TAC THEN
      ASM_SIMP_TAC [IN_DELETE] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REAL_ARITH (← q r"y = &0 ==> x = y ==> ~(x = &1)"))) THEN
      FIRST_X_ASSUM SUBST_ALL_TAC THEN EXPAND_TAC "e" THEN
      REWRITE_TAC [RESTRICTION] THEN ASM_REWRITE_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_DELETE, IN_INTER, IMP_CONJ] THEN
      X_GEN_TAC (← q r"y:A") THEN ASM_SIMP_TAC [] THEN DISCH_TAC THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"RESTRICTION (topspace top) (g:A->real)"))) THEN
      REWRITE_TAC [] THEN EXPAND_TAC "e" THEN REWRITE_TAC [] THEN
      SIMP_TAC [RESTRICTION] THEN ASM_REWRITE_TAC [IN_DELETE] THEN
      ANTS_TAC THENL [EXPAND_TAC "k", ASM_MESON_TAC []] THEN
      REWRITE_TAC [SUBMETRIC, CFUNSPACE, IN_ELIM_THM, IN_INTER] THEN
      REWRITE_TAC [RESTRICTION_IN_EXTENSIONAL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
      SIMP_TAC [RESTRICTION_CONTINUOUS_MAP, SUBSET_REFL] THEN
      ASM_SIMP_TAC [IMAGE_RESTRICTION, SUBSET_REFL] THEN
      ASM_REWRITE_TAC [REAL_EUCLIDEAN_METRIC, MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                       IN_UNIV] THEN
      MATCH_MP_TAC MBOUNDED_SUBSET THEN EXISTS_TAC (← q r"real_interval[&0,&1]") THEN
      ASM_REWRITE_TAC [MBOUNDED_REAL_EUCLIDEAN_METRIC,
                       REAL_BOUNDED_REAL_INTERVAL]])

  let COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING ← prove
   r"!top:A topology.
        completely_regular_space top /\ hausdorff_space top
        ==> ?k:((A->real)->bool) e.
               embedding_map
                (top,
                 product_topology k
                  (\f. subtopology euclideanreal (real_interval[&0,&1])))
                e"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP
      COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING_EXPLICIT) THEN
    MESON_TAC [])

  return { COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING_EXPLICIT,
           COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING }

/- ------------------------------------------------------------------------- -/
/- Urysohn and Tietze analogs for completely regular spaces if (one) set is  -/
/- assumed compact instead of closed. Note that Hausdorffness is *not*       -/
/- required: inside one proof we factor through the Kolmogorov quotient.     -/
/- (metric.ml 41181-41327)                                                    -/
/- ------------------------------------------------------------------------- -/

structure URYC where
  URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT : thm
  URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED : thm
  URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupURYC [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BCompact1 : Compact1) (BRealTop1 : RealTop1)
    (BRealCont : RealCont) (BCRegular1 : CRegular1) : ExceptT String IO URYC := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { CONJ_ASSOC, DISJOINT_SYM, ETA_AX, EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_GSPEC,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_ELIM_THM, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_IN_EMPTY, .. } := D.core2
  let { REAL_INF_LE, REAL_LE_ADDR, REAL_LE_ANTISYM, REAL_LE_INF, REAL_LE_MUL, REAL_LE_NEG2,
        REAL_LE_REFL, REAL_LT_IMP_LE, .. } := D.core3
  let { REAL_SUB_LE, SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_EMPTY, UNIONS_0, UNIONS_IMAGE, .. } :=
    D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, .. } := D.misc
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { CONTINUOUS_MAP_CONST, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { COMPACT_IN_SUBSET_TOPSPACE, compact_in, .. } := BCompact1
  let { REAL_OPEN_HALFSPACE_LT, REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL,
        TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { CONTINUOUS_MAP_INF, CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_LMUL,
        CONTINUOUS_MAP_REAL_MAX, CONTINUOUS_MAP_REAL_NEG_EQ, CONTINUOUS_MAP_REAL_SUB, .. } :=
    BRealCont
  let { completely_regular_space, .. } := BCRegular1
  -- @@SCOPE END

  let URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT ← prove
   r"!top s (t:A->bool) a b.
        a <= b /\ completely_regular_space top /\
        closed_in top s /\ compact_in top t /\ DISJOINT s t
        ==> ?f. continuous_map
                  (top,subtopology euclideanreal (real_interval[a,b])) f /\
                (!x. x IN t ==> f x = a) /\
                (!x. x IN s ==> f x = b)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?f. continuous_map
            (top,subtopology euclideanreal (real_interval[&0,&1])) f /\
          (!x. x IN t ==> f x = &0) /\
          (!x:A. x IN s ==> f x = &1)")
    MP_TAC THENL
     [ALL_TAC,
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET] THEN
      REWRITE_TAC [FORALL_IN_IMAGE, IN_REAL_INTERVAL, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"\x. a + (b - a) * (f:A->real) x") THEN
      ASM_SIMP_TAC [] THEN CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_LMUL,
                    CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      REWRITE_TAC [IN_REAL_INTERVAL, REAL_LE_ADDR] THEN
      REWRITE_TAC [← REAL_ARITH (← q
        r"a + (b - a) * y <= b <=> &0 <= (b - a) * (&1 - y)")] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE]] THEN
    ASM_CASES_TAC (← q r"t:A->bool = {}") THENL
     [EXISTS_TAC (← q r"(\x. &1):A->real") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_CONST, NOT_IN_EMPTY] THEN
      REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, IN_REAL_INTERVAL] THEN
      CONV_TAC REAL_RAT_REDUCE_CONV,
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!a. a IN t
          ==> ?f. continuous_map
                    (top,subtopology euclideanreal (real_interval[&0,&1])) f /\
                  f a = &0 /\ !x. x IN s ==> (f:A->real) x = &1")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [completely_regular_space]) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:A->A->real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC
      (← q r"{{x | x IN topspace top /\ (g:A->A->real) a x IN {t | t < &1 / &2}} |
        a IN t}"))) THEN
    REWRITE_TAC [SIMPLE_IMAGE, EXISTS_FINITE_SUBSET_IMAGE, FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
        MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"euclideanreal") THEN REWRITE_TAC [← GSYM REAL_OPEN_IN] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
        ASM_SIMP_TAC [REAL_OPEN_HALFSPACE_LT, ETA_AX],
        MATCH_MP_TAC (← SET_RULE (← q
         r"(!a. a IN s ==> a IN f a) ==> s SUBSET UNIONS(IMAGE f s)")) THEN
        ASM_SIMP_TAC [IN_ELIM_THM] THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
        ASM SET_TAC []],
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") MP_TAC)] THEN
    ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, SUBSET_EMPTY] THEN STRIP_TAC THEN
    EXISTS_TAC
     (← q r"\x. &2 * max (&0) (inf {(g:A->A->real) a x | a IN k} - &1 / &2)") THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&2 * max (&0) (x - &1 / &2) = &0 <=> x <= &1 / &2"),
                 ← REAL_ARITH (← q r"&2 * max (&0) (x - &1 / &2) = &1 <=> x = &1")] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY]) THEN
    REWRITE_TAC [IN_REAL_INTERVAL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 <= &2 * max (&0) a"),
                 ← REAL_ARITH (← q r"&2 * max (&0) (x - &1 / &2) <= &1 <=> x <= &1")] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_REAL_LMUL THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_MAX THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_REAL_SUB THEN
      REWRITE_TAC [CONTINUOUS_MAP_CONST, TOPSPACE_EUCLIDEANREAL, IN_UNIV] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_INF THEN REWRITE_TAC [ETA_AX] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      MATCH_MP_TAC REAL_INF_LE THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      EXISTS_TAC (← q r"&0") THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY,
       SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL]) THEN
      ASM SET_TAC [],
      DISCH_TAC] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THENL
     [MATCH_MP_TAC REAL_INF_LE THEN REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      EXISTS_TAC (← q r"&0"),
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN CONJ_TAC THENL
       [ASM_MESON_TAC [SUBSET, CLOSED_IN_SUBSET], ALL_TAC] THEN
      MATCH_MP_TAC REAL_LE_INF THEN
      ASM_REWRITE_TAC [SIMPLE_IMAGE, IMAGE_EQ_EMPTY, FORALL_IN_IMAGE]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET,
     FORALL_IN_IMAGE, IN_REAL_INTERVAL, UNIONS_IMAGE, IN_ELIM_THM]) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    ASM_MESON_TAC [REAL_LT_IMP_LE, REAL_LE_REFL])

  let URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED ← prove
   r"!top s (t:A->bool) a b.
        a <= b /\ completely_regular_space top /\
        compact_in top s /\ closed_in top t /\ DISJOINT s t
        ==> ?f. continuous_map
                  (top,subtopology euclideanreal (real_interval[a,b])) f /\
                (!x. x IN t ==> f x = a) /\
                (!x. x IN s ==> f x = b)"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
       [← q r"top:A topology", ← q r"t:A->bool", ← q r"s:A->bool", ← q r"--b:real",
        ← q r"--a:real"]
      URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT) THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET, REAL_LE_NEG2] THEN
    ONCE_REWRITE_TAC [DISJOINT_SYM] THEN
    ASM_REWRITE_TAC [FORALL_IN_IMAGE, IN_REAL_INTERVAL] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"--b <= x /\ x <= --a <=> a <= --x /\ --x <= b")] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x:real = --a <=> --x = a")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"f:A->real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"\x. --((f:A->real) x)") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_REAL_NEG_EQ])

  let URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED_ALT ← prove
   r"!top s (t:A->bool) a b.
        completely_regular_space top /\
        compact_in top s /\ closed_in top t /\ DISJOINT s t
        ==> ?f. continuous_map (top,euclideanreal) f /\
                (!x. x IN t ==> f x = a) /\
                (!x. x IN s ==> f x = b)"
   (REPEAT STRIP_TAC THEN DISJ_CASES_TAC (← REAL_ARITH (← q r"a <= b \/ b <= a")) THENL
     [MP_TAC (← ISPECL
       [← q r"top:A topology", ← q r"s:A->bool", ← q r"t:A->bool", ← q r"a:real",
        ← q r"b:real"]
       URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED),
      MP_TAC (← ISPECL
       [← q r"top:A topology", ← q r"t:A->bool", ← q r"s:A->bool", ← q r"b:real",
        ← q r"a:real"]
       URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT)] THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [DISJOINT_SYM] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN MESON_TAC [])

  return { URYSOHN_COMPLETELY_REGULAR_CLOSED_COMPACT, URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED,
           URYSOHN_COMPLETELY_REGULAR_COMPACT_CLOSED_ALT }

/- ------------------------------------------------------------------------- -/
/- Tietze extension for completely regular spaces.  (metric.ml 41329-41436)  -/
/- ------------------------------------------------------------------------- -/

structure TIET where
  TIETZE_EXTENSION_COMPLETELY_REGULAR : thm
  deriving Inhabited

@[nospecialize]
def setupTIET [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BEmbedding : Embedding)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BCompact4 : Compact4)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BT0a : T0a) (BT0b : T0b)
    (BRegular1 : Regular1) (BRealTop2 : RealTop2) (BRealConn1 : RealConn1)
    (BNormal1 : Normal1) (BTietze : Tietze) (BCRegular1 : CRegular1) (BCRegular2 : CRegular2)
    (BTYCH : TYCH) : ExceptT String IO TIET := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, IN_INTER, LEFT_IMP_EXISTS_THM, .. } :=
    D.core2
  let { SUBSET_REFL, o_THM, .. } := D.core4
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO,
        CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { embedding_map, .. } := BEmbedding
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_SPACE_PRODUCT_TOPOLOGY, .. } := BCompact4
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_SUBTOPOLOGY, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_PRODUCT_TOPOLOGY, .. } := BHausdorff2
  let { HAUSDORFF_IMP_T0_SPACE, .. } := BT0a
  let { CONTINUOUS_MAP_KOLMOGOROV_QUOTIENT, KOLMOGOROV_QUOTIENT_IN_TOPSPACE,
        KOLMOGOROV_QUOTIENT_LIFT_EXISTS, T0_SPACE_KOLMOGOROV_QUOTIENT, .. } := BT0b
  let { REGULAR_SPACE_SUBTOPOLOGY, REGULAR_T0_IMP_HAUSDORFF_SPACE, .. } := BRegular1
  let { HAUSDORFF_SPACE_EUCLIDEANREAL, .. } := BRealTop2
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, .. } := BRealConn1
  let { COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE, .. } := BNormal1
  let { TIETZE_EXTENSION_REALINTERVAL, .. } := BTietze
  let { COMPLETELY_REGULAR_SPACE_SUBTOPOLOGY, .. } := BCRegular1
  let { COMPLETELY_REGULAR_IMP_REGULAR_SPACE, .. } := BCRegular2
  let { COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING, .. } := BTYCH
  -- @@SCOPE END

  let TIETZE_EXTENSION_COMPLETELY_REGULAR ← do
    let lemma ← prove
     r"!top (f:A->real) s t.
           completely_regular_space top /\ hausdorff_space top /\
           compact_in top s /\ is_realinterval t /\ ~(t = {}) /\
           continuous_map (subtopology top s,euclideanreal) f /\
           (!x. x IN s ==> f x IN t)
           ==> ?g. continuous_map (top,euclideanreal) g /\
                   (!x. x IN topspace top ==> g x IN t) /\
                   (!x. x IN s ==> g x = f x)"
     (REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"top:A topology") COMPLETELY_REGULAR_SPACE_CUBE_EMBEDDING) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"k:((A->real)->bool)", ← q r"e:A->(A->real)->real"] THEN
      REWRITE_TAC [embedding_map, HOMEOMORPHIC_MAP_MAPS, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"e':((A->real)->real)->A") THEN ABBREV_TAC
       (← q r"c:((A->real)->real)topology =
        product_topology k
         (\f. subtopology euclideanreal (real_interval [&0,&1]))") THEN
      REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
       [← q r"c:((A->real)->real)topology",
        ← q r"(f:A->real) o (e':((A->real)->real)->A)",
        ← q r"IMAGE (e:A->(A->real)->real) s",
        ← q r"t:real->bool"] TIETZE_EXTENSION_REALINTERVAL) THEN
      ASM_SIMP_TAC [FORALL_IN_IMAGE, o_THM] THEN ANTS_TAC THENL
       [REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE THEN
          EXPAND_TAC "c" THEN
          REWRITE_TAC [COMPACT_SPACE_PRODUCT_TOPOLOGY,
                       HAUSDORFF_SPACE_PRODUCT_TOPOLOGY] THEN
          SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY,
                    HAUSDORFF_SPACE_EUCLIDEANREAL] THEN
          SIMP_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL, COMPACT_SPACE_SUBTOPOLOGY],
          MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN CONJ_TAC THENL
           [EXPAND_TAC "c" THEN
            SIMP_TAC [HAUSDORFF_SPACE_PRODUCT_TOPOLOGY,
                      HAUSDORFF_SPACE_SUBTOPOLOGY,
                      HAUSDORFF_SPACE_EUCLIDEANREAL],
            MATCH_MP_TAC IMAGE_COMPACT_IN THEN EXISTS_TAC (← q r"top:A topology") THEN
            ASM_MESON_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY]],
          MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
          EXISTS_TAC (← q r"subtopology top (s:A->bool)") THEN
          ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN CONJ_TAC THENL
           [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
              CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO)) THEN
            ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, IMAGE_SUBSET],
            REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
            MATCH_MP_TAC (← SET_RULE (← q
             r"(!x. x IN s ==> f(g x) = x)
              ==> IMAGE f (u INTER IMAGE g s) SUBSET s")) THEN
            FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
            ASM SET_TAC []],
          FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
          ASM SET_TAC []],
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:((A->real)->real)->real")
          STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"(g:((A->real)->real)->real) o (e:A->(A->real)->real)") THEN
        CONJ_TAC THENL
         [ASM_MESON_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_COMPOSE],
          REWRITE_TAC [o_THM] THEN
          FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
          REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP
            CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
          REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC []]])
    prove
     r"!top (f:A->real) s t.
         completely_regular_space top /\
         compact_in top s /\ is_realinterval t /\ ~(t = {}) /\
         continuous_map (subtopology top s,euclideanreal) f /\
         (!x. x IN s ==> f x IN t)
         ==> ?g. continuous_map (top,euclideanreal) g /\
                 (!x. x IN topspace top ==> g x IN t) /\
                 (!x. x IN s ==> g x = f x)"
     (REPEAT STRIP_TAC THEN
      ABBREV_TAC (← q r"q:A->bool = IMAGE (kolmogorov_quotient top) (topspace top)") THEN
      MP_TAC (← ISPECL
       [← q r"top:A topology", ← q r"euclideanreal", ← q r"f:A->real", ← q r"s:A->bool"]
       KOLMOGOROV_QUOTIENT_LIFT_EXISTS) THEN
      SIMP_TAC [HAUSDORFF_IMP_T0_SPACE, HAUSDORFF_SPACE_EUCLIDEANREAL] THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"g:A->real") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL
