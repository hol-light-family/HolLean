  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, EMPTY_SUBSET, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_ID,
        .. } := D.core1
  let { IMP_CONJ, IN_UNIV, MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY,
        REAL_ABS_INV, .. } := D.core2
  let { REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_NOT_LT, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_REFL, o_DEF, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { EVENTUALLY_HAPPENS, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { MDIST_POS_LE, MDIST_REFL, MDIST_SYM, SUBMETRIC, SUBMETRIC_SUBMETRIC, .. } :=
    BMetricSpace
  let { METRIC_ARITH, .. } := BMetricArith
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_METRIC, LIMIT_NULL_REAL_COMPARISON, LIMIT_NULL_REAL_HARMONIC_OFFSET, .. } :=
    BMetricLim
  -- @@SCOPE END

  let uniformly_continuous_map ← new_definition
   r"uniformly_continuous_map (m1,m2) f <=>
        IMAGE f (mspace m1) SUBSET mspace m2 /\
        !e. &0 < e
            ==> ?d. &0 < d /\
                    !x x'. x IN mspace m1 /\ x' IN mspace m1 /\
                           mdist m1 (x',x) < d
                           ==> mdist m2 (f x',f x) < e"

  let (UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY, UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY_ALT) ←
    CONJ_PAIR (← prove
   r"(!m1 m2 f:A->B.
        uniformly_continuous_map (m1,m2) f <=>
        IMAGE f (mspace m1) SUBSET mspace m2 /\
        !x y. (!n. x n IN mspace m1) /\ (!n. y n IN mspace m1) /\
              limit euclideanreal (\n. mdist m1 (x n,y n)) (&0) sequentially
              ==> limit euclideanreal
                    (\n. mdist m2 (f(x n),f(y n))) (&0) sequentially) /\
   (!m1 m2 f:A->B.
        uniformly_continuous_map (m1,m2) f <=>
        IMAGE f (mspace m1) SUBSET mspace m2 /\
        !e x y. &0 < e /\ (!n. x n IN mspace m1) /\ (!n. y n IN mspace m1) /\
                limit euclideanreal (\n. mdist m1 (x n,y n)) (&0) sequentially
                ==> ?n. mdist m2 (f(x n),f(y n)) < e)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(p ==> q) /\ (q ==> r) /\ (r ==> p)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [REWRITE_TAC [uniformly_continuous_map, SUBSET, FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
      REWRITE_TAC [LIMIT_METRIC, EVENTUALLY_SEQUENTIALLY] THEN
      REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV, IMP_CONJ] THEN
      ASM_SIMP_TAC [MDIST_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> abs(&0 - x) = x")] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"x:num->A", ← q r"y:num->A"] THEN
      STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:num->A", ← q r"y:num->A"]) THEN
      ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
      REWRITE_TAC [LIMIT_METRIC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      ASM_SIMP_TAC [MDIST_POS_LE, ← REAL_ARITH (← q r"&0 <= x ==> abs(&0 - x) = x")],
      REWRITE_TAC [uniformly_continuous_map, SUBSET, FORALL_IN_IMAGE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> ~r ==> ~p")] THEN
      DISCH_TAC THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, SKOLEM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"x:num->A") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"y:num->A") THEN
      REWRITE_TAC [AND_FORALL_THM, REAL_NOT_LT] THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN CONJ_TAC THENL
       [ALL_TAC, ASM_MESON_TAC [MDIST_SYM, REAL_NOT_LT]] THEN
      MATCH_MP_TAC LIMIT_NULL_REAL_COMPARISON THEN
      EXISTS_TAC (← q r"\n. inv(&n + &1)") THEN
      REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, LIMIT_NULL_REAL_HARMONIC_OFFSET] THEN
      EXISTS_TAC (← q r"0") THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      ASM_SIMP_TAC [REAL_ABS_INV, ← REAL_ARITH (← q r"abs(&n + &1) = &n + &1"),
        ← METRIC_ARITH (← q r"x IN mspace m /\ y IN mspace m
                      ==> abs(mdist m (x,y)) = mdist m (y,x)")] THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE]]))

  let UNIFORMLY_CONTINUOUS_MAP_EQ ← prove
   r"!m1 m2 f g.
      (!x. x IN mspace m1 ==> f x = g x) /\ uniformly_continuous_map (m1,m2) f
      ==> uniformly_continuous_map (m1,m2) g"
   (REWRITE_TAC [uniformly_continuous_map] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IMP_CONJ] THEN SIMP_TAC [])

  let UNIFORMLY_CONTINUOUS_MAP_FROM_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        uniformly_continuous_map (m1,m2) f
        ==> uniformly_continuous_map (submetric m1 s,m2) f"
   (REWRITE_TAC [uniformly_continuous_map, SUBMETRIC] THEN SET_TAC [])

  let UNIFORMLY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO ← prove
   r"!m1 m2 f s t.
           uniformly_continuous_map (submetric m1 t,m2) f /\ s SUBSET t
           ==> uniformly_continuous_map (submetric m1 s,m2) f"
   (MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_FROM_SUBMETRIC, SUBMETRIC_SUBMETRIC,
               ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")])

  let UNIFORMLY_CONTINUOUS_MAP_INTO_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        uniformly_continuous_map (m1,submetric m2 s) f <=>
        IMAGE f (mspace m1) SUBSET s /\
        uniformly_continuous_map (m1,m2) f"
   (REWRITE_TAC [uniformly_continuous_map, SUBMETRIC] THEN SET_TAC [])

  let UNIFORMLY_CONTINUOUS_MAP_CONST ← prove
   r"!m1:A metric m2:B metric c.
        uniformly_continuous_map (m1,m2) (\x. c) <=>
        mspace m1 = {} \/ c IN mspace m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [uniformly_continuous_map] THEN
    ASM_CASES_TAC (← q r"mspace m1:A->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, EMPTY_SUBSET, NOT_IN_EMPTY] THENL
     [MESON_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(c:B) IN mspace m2") THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_SIMP_TAC [MDIST_REFL] THEN MESON_TAC [])

  let UNIFORMLY_CONTINUOUS_MAP_REAL_CONST ← prove
   r"!m. uniformly_continuous_map (m,real_euclidean_metric) (\x:A. c)"
   (REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_CONST, REAL_EUCLIDEAN_METRIC, IN_UNIV])

  let UNIFORMLY_CONTINUOUS_MAP_ID ← prove
   r"!m1:A metric. uniformly_continuous_map (m1,m1) (\x. x)"
   (REWRITE_TAC [uniformly_continuous_map, IMAGE_ID, SUBSET_REFL] THEN
    MESON_TAC [])

  let UNIFORMLY_CONTINUOUS_MAP_COMPOSE ← prove
   r"!m1 m2 f:A->B g:B->C.
    uniformly_continuous_map (m1,m2) f /\ uniformly_continuous_map (m2,m3) g
    ==> uniformly_continuous_map (m1,m3) (g o f)"
   (REWRITE_TAC [uniformly_continuous_map, o_DEF, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN SIMP_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN ASM_MESON_TAC [])

  return { uniformly_continuous_map, UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY,
           UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY_ALT, UNIFORMLY_CONTINUOUS_MAP_EQ,
           UNIFORMLY_CONTINUOUS_MAP_FROM_SUBMETRIC, UNIFORMLY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO,
           UNIFORMLY_CONTINUOUS_MAP_INTO_SUBMETRIC, UNIFORMLY_CONTINUOUS_MAP_CONST,
           UNIFORMLY_CONTINUOUS_MAP_REAL_CONST, UNIFORMLY_CONTINUOUS_MAP_ID,
           UNIFORMLY_CONTINUOUS_MAP_COMPOSE }

/- ------------------------------------------------------------------------- -/
/- Cauchy continuous maps.  (metric.ml 31107-31185)                          -/
/- ------------------------------------------------------------------------- -/

structure CC1 where
  cauchy_continuous_map : thm
  CAUCHY_CONTINUOUS_MAP_IMAGE : thm
  CAUCHY_CONTINUOUS_MAP_EQ : thm
  CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC : thm
  CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO : thm
  CAUCHY_CONTINUOUS_MAP_INTO_SUBMETRIC : thm
  CAUCHY_CONTINUOUS_MAP_CONST : thm
  CAUCHY_CONTINUOUS_MAP_REAL_CONST : thm
  CAUCHY_CONTINUOUS_MAP_ID : thm
  CAUCHY_CONTINUOUS_MAP_COMPOSE : thm
  deriving Inhabited

@[nospecialize]
def setupCC1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BRealTop2 : RealTop2)
    (BCauchy1 : Cauchy1) : ExceptT String IO CC1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_FORALL, NOT_IN_EMPTY,
        .. } := D.core2
  let { SUBSET, o_DEF, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { SUBMETRIC, SUBMETRIC_SUBMETRIC, .. } := BMetricSpace
  let { REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { CAUCHY_IN_CONST, CAUCHY_IN_SUBMETRIC, cauchy_in, .. } := BCauchy1
  -- @@SCOPE END

  let cauchy_continuous_map ← new_definition
   r"cauchy_continuous_map (m1,m2) f <=>
        !x. cauchy_in m1 x ==> cauchy_in m2 (f o x)"

  let CAUCHY_CONTINUOUS_MAP_IMAGE ← prove
   r"!m1 m2 f:A->B.
        cauchy_continuous_map (m1,m2) f
        ==> IMAGE f (mspace m1) SUBSET mspace m2"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(\n. a):num->A") o
      REWRITE_RULE [cauchy_continuous_map]) THEN
    ASM_REWRITE_TAC [o_DEF, CAUCHY_IN_CONST])

  let CAUCHY_CONTINUOUS_MAP_EQ ← prove
   r"!m1 m2 f g.
      (!x. x IN mspace m1 ==> f x = g x) /\ cauchy_continuous_map (m1,m2) f
      ==> cauchy_continuous_map (m1,m2) g"
   (REWRITE_TAC [cauchy_continuous_map, cauchy_in, o_DEF, IMP_CONJ] THEN
    SIMP_TAC [])

  let CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        cauchy_continuous_map (m1,m2) f
        ==> cauchy_continuous_map (submetric m1 s,m2) f"
   (SIMP_TAC [cauchy_continuous_map, CAUCHY_IN_SUBMETRIC])

  let CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO ← prove
   r"!m1 m2 f s t.
           cauchy_continuous_map (submetric m1 t,m2) f /\ s SUBSET t
           ==> cauchy_continuous_map (submetric m1 s,m2) f"
   (MESON_TAC [CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC, SUBMETRIC_SUBMETRIC,
               ← SET_RULE (← q r"s SUBSET t ==> t INTER s = s")])

  let CAUCHY_CONTINUOUS_MAP_INTO_SUBMETRIC ← prove
   r"!m1 m2 s f:A->B.
        cauchy_continuous_map (m1,submetric m2 s) f <=>
        IMAGE f (mspace m1) SUBSET s /\
        cauchy_continuous_map (m1,m2) f"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
        REWRITE_TAC [SUBMETRIC] THEN SET_TAC [],
        POP_ASSUM MP_TAC THEN
        SIMP_TAC [cauchy_continuous_map, CAUCHY_IN_SUBMETRIC, o_THM]],
      REPEAT (POP_ASSUM MP_TAC) THEN
      SIMP_TAC [cauchy_continuous_map, CAUCHY_IN_SUBMETRIC, o_THM] THEN
      REWRITE_TAC [cauchy_in] THEN SET_TAC []])

  let CAUCHY_CONTINUOUS_MAP_CONST ← prove
   r"!m1:A metric m2:B metric c.
        cauchy_continuous_map (m1,m2) (\x. c) <=>
        mspace m1 = {} \/ c IN mspace m2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy_continuous_map] THEN
    REWRITE_TAC [o_DEF, CAUCHY_IN_CONST] THEN
    ASM_CASES_TAC (← q r"(c:B) IN mspace m2") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL [ALL_TAC, SIMP_TAC [cauchy_in, NOT_IN_EMPTY]] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(\n. a):num->A")) THEN
    ASM_REWRITE_TAC [CAUCHY_IN_CONST])

  let CAUCHY_CONTINUOUS_MAP_REAL_CONST ← prove
   r"!m. cauchy_continuous_map (m,real_euclidean_metric) (\x:A. c)"
   (REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_CONST, REAL_EUCLIDEAN_METRIC, IN_UNIV])

  let CAUCHY_CONTINUOUS_MAP_ID ← prove
   r"!m1:A metric. cauchy_continuous_map (m1,m1) (\x. x)"
   (REWRITE_TAC [cauchy_continuous_map, o_DEF, ETA_AX])

  let CAUCHY_CONTINUOUS_MAP_COMPOSE ← prove
   r"!m1 m2 f:A->B g:B->C.
    cauchy_continuous_map (m1,m2) f /\ cauchy_continuous_map (m2,m3) g
    ==> cauchy_continuous_map (m1,m3) (g o f)"
   (REWRITE_TAC [cauchy_continuous_map, o_DEF, SUBSET, FORALL_IN_IMAGE] THEN
    REPEAT GEN_TAC THEN SIMP_TAC [CONJ_ASSOC] THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"e:real") THEN ASM_MESON_TAC [])

  return { cauchy_continuous_map, CAUCHY_CONTINUOUS_MAP_IMAGE, CAUCHY_CONTINUOUS_MAP_EQ,
           CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC, CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO,
           CAUCHY_CONTINUOUS_MAP_INTO_SUBMETRIC, CAUCHY_CONTINUOUS_MAP_CONST,
           CAUCHY_CONTINUOUS_MAP_REAL_CONST, CAUCHY_CONTINUOUS_MAP_ID,
           CAUCHY_CONTINUOUS_MAP_COMPOSE }

/- ------------------------------------------------------------------------- -/
/- Relations between the notions of continuity.  (metric.ml 31187-31342)     -/
/- ------------------------------------------------------------------------- -/

structure CC2 where
  LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP : thm
  UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP : thm
  LOCALLY_CAUCHY_CONTINUOUS_MAP : thm
  CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP : thm
  UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP : thm
  LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP : thm
  LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP : thm
  CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP : thm
  CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP : thm
  CONTINUOUS_IMP_UNIFORMLY_CONTINUOUS_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupCC2 [HolBase] (D : MetricDeps) (BContMap1 : ContMap1) (BNets : Nets)
    (BSequential : Sequential) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BLimits1 : Limits1) (BMetricLim : MetricLim) (BSeqChar2 : SeqChar2) (BCauchy1 : Cauchy1)
    (BCauchy2 : Cauchy2) (BTotBdd1 : TotBdd1) (BMCompact2 : MCompact2) (BPtCont : PtCont)
    (BLIP1 : LIP1) (BUC1 : UC1) (BCC1 : CC1) : ExceptT String IO CC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { COND_RAND, ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_DELETE, IN_INTER, LEFT_IMP_EXISTS_THM, LE_ADD, LE_REFL,
        LT_ADD_LCANCEL, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LT_RDIV_EQ, REAL_MUL_LZERO, REAL_MUL_SYM, .. } := D.core3
  let { SUBSET, o_DEF, o_THM, real_abs, .. } := D.core4
  let { FORALL_AND_THM, o_ASSOC, .. } := D.core5
  let { continuous_map, .. } := BContMap1
  let { EVENTUALLY_HAPPENS, .. } := BNets
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_POS_LE, SUBMETRIC, .. } := BMetricSpace
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { CONTINUOUS_MAP_LIMIT, LIMIT_SUBSEQUENCE, .. } := BLimits1
  let { LIMIT_NULL_REAL, .. } := BMetricLim
  let { LIMIT_ATPOINTOF_SEQUENTIALLY, .. } := BSeqChar2
  let { CAUCHY_IN_OFFSET, CAUCHY_IN_SUBMETRIC, CAUCHY_IN_SUBSEQUENCE, CONVERGENT_IMP_CAUCHY_IN,
        cauchy_in, mcomplete, .. } := BCauchy1
  let { CAUCHY_IN_INTERLEAVING, CAUCHY_IN_INTERLEAVING_GEN, .. } := BCauchy2
  let { TOTALLY_BOUNDED_IN_SEQUENTIALLY, .. } := BTotBdd1
  let { COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN, .. } := BMCompact2
  let { CONTINUOUS_MAP_ATPOINTOF, .. } := BPtCont
  let { LIPSCHITZ_CONTINUOUS_MAP_POS, .. } := BLIP1
  let { UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY_ALT, uniformly_continuous_map, .. } := BUC1
  let { CAUCHY_CONTINUOUS_MAP_IMAGE, cauchy_continuous_map, .. } := BCC1
  -- @@SCOPE END

  let LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        lipschitz_continuous_map (m1,m2) f
        ==> uniformly_continuous_map (m1,m2) f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_POS, uniformly_continuous_map] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC)) THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"e / B:real") THEN
    ASM_SIMP_TAC [REAL_LT_RDIV_EQ, REAL_MUL_LZERO] THEN
    ASM_MESON_TAC [REAL_LET_TRANS, REAL_MUL_SYM])

  let UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        uniformly_continuous_map (m1,m2) f
        ==> cauchy_continuous_map (m1,m2) f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [uniformly_continuous_map, cauchy_continuous_map] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:num->A") THEN REWRITE_TAC [cauchy_in] THEN
    STRIP_TAC THEN REWRITE_TAC [o_THM] THEN ASM SET_TAC [])

  let LOCALLY_CAUCHY_CONTINUOUS_MAP ← prove
   r"!m1 m2 e f:A->B.
        &0 < e /\
        (!x. x IN mspace m1
             ==> cauchy_continuous_map (submetric m1 (mball m1 (x,e)),m2) f)
        ==> cauchy_continuous_map (m1,m2) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [cauchy_continuous_map] THEN
    X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [cauchy_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e:real"))) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"M:num") THEN STRIP_TAC THEN
    MATCH_MP_TAC CAUCHY_IN_OFFSET THEN EXISTS_TAC (← q r"M:num") THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(x:num->A) n")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
      ASM_SIMP_TAC [SUBSET, FORALL_IN_IMAGE, SUBMETRIC, SUBMETRIC, o_THM,
                    IN_INTER, CENTRE_IN_MBALL],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(x:num->A) M")) THEN
      ASM_REWRITE_TAC [cauchy_continuous_map, o_DEF] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      ASM_REWRITE_TAC [CAUCHY_IN_SUBMETRIC, IN_MBALL] THEN
      ASM_SIMP_TAC [LE_ADD, LE_REFL] THEN
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CAUCHY_IN_SUBSEQUENCE THEN
      ASM_REWRITE_TAC [LT_ADD_LCANCEL]])

  let CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        cauchy_continuous_map (m1,m2) f
        ==> continuous_map (mtopology m1,mtopology m2) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_ATPOINTOF] THEN
    X_GEN_TAC (← q r"a:A") THEN REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_TAC THEN
    REWRITE_TAC [LIMIT_ATPOINTOF_SEQUENTIALLY] THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:num->A") THEN REWRITE_TAC [IN_DELETE, FORALL_AND_THM] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"\n. if EVEN n then x(n DIV 2) else a:A") o
     REWRITE_RULE [cauchy_continuous_map]) THEN
    ASM_SIMP_TAC [o_DEF, COND_RAND, CAUCHY_IN_INTERLEAVING])

  let UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        uniformly_continuous_map (m1,m2) f
        ==> continuous_map (mtopology m1,mtopology m2) f"
   (MESON_TAC [UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP,
               CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP])

  let LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        lipschitz_continuous_map(m1,m2) f
        ==> continuous_map (mtopology m1,mtopology m2) f"
   (SIMP_TAC [UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP,
              LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP])

  let LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        lipschitz_continuous_map(m1,m2) f
        ==> cauchy_continuous_map(m1,m2) f"
   (SIMP_TAC [LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP,
              UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP])

  let CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        mcomplete m1 /\
        continuous_map (mtopology m1,mtopology m2) f
        ==> cauchy_continuous_map (m1,m2) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [cauchy_continuous_map] THEN
    X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:num->A") o REWRITE_RULE [mcomplete]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] (← ISPEC (← q r"sequentially") CONTINUOUS_MAP_LIMIT))) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:num->A", ← q r"y:A"]) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONVERGENT_IMP_CAUCHY_IN)) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [continuous_map, TOPSPACE_MTOPOLOGY, cauchy_in]) THEN
    REWRITE_TAC [o_DEF] THEN ASM SET_TAC [])

  let CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        totally_bounded_in m1 (mspace m1) /\
        cauchy_continuous_map (m1,m2) f
        ==> uniformly_continuous_map (m1,m2) f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_SEQUENTIALLY_ALT] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"e:real", ← q r"x:num->A", ← q r"y:num->A"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:num->A") o CONJUNCT2 o
     REWRITE_RULE [TOTALLY_BOUNDED_IN_SEQUENTIALLY]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r1:num->num") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(y:num->A) o (r1:num->num)") o CONJUNCT2 o
     REWRITE_RULE [TOTALLY_BOUNDED_IN_SEQUENTIALLY]) THEN
    ASM_REWRITE_TAC [o_THM, ← GSYM o_ASSOC, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r2:num->num") THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"r = (r1:num->num) o (r2:num->num)") THEN
    SUBGOAL_THEN (← q r"!m n. m < n ==> (r:num->num) m < r n") ASSUME_TAC THENL
     [EXPAND_TAC "r" THEN REWRITE_TAC [o_DEF] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o
     SPEC (← q r"\n. if EVEN n then (x o r) (n DIV 2):A
               else (y o (r:num->num)) (n DIV 2)") o
     REWRITE_RULE [cauchy_continuous_map]) THEN
    ASM_REWRITE_TAC [CAUCHY_IN_INTERLEAVING_GEN, ETA_AX] THEN ANTS_TAC THENL
     [EXPAND_TAC "r" THEN REWRITE_TAC [o_ASSOC] THEN
      ASM_SIMP_TAC [CAUCHY_IN_SUBSEQUENCE] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:num->num") o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] LIMIT_SUBSEQUENCE)) THEN
      ASM_REWRITE_TAC [← GSYM o_ASSOC] THEN REWRITE_TAC [o_DEF],
      ONCE_REWRITE_TAC [o_DEF] THEN
      REWRITE_TAC [COND_RAND, CAUCHY_IN_INTERLEAVING_GEN] THEN
      DISCH_THEN (MP_TAC o CONJUNCT2 o CONJUNCT2) THEN
      REWRITE_TAC [LIMIT_NULL_REAL] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      REWRITE_TAC [o_DEF, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      ASM_SIMP_TAC [real_abs, MDIST_POS_LE] THEN MESON_TAC []])

  let CONTINUOUS_IMP_UNIFORMLY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        compact_space (mtopology m1) /\
        continuous_map (mtopology m1,mtopology m2) f
        ==> uniformly_continuous_map (m1,m2) f"
   (REWRITE_TAC [COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP THEN
    ASM_REWRITE_TAC [])

  return { LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP, UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP,
           LOCALLY_CAUCHY_CONTINUOUS_MAP, CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP,
           UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP, LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP,
           LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP, CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP,
           CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP, CONTINUOUS_IMP_UNIFORMLY_CONTINUOUS_MAP }

/- ------------------------------------------------------------------------- -/
/- Equivalences, and continuity notions for pairs.  (metric.ml 31344-31457)  -/
/- ------------------------------------------------------------------------- -/

structure CC3 where
  CONTINUOUS_EQ_CAUCHY_CONTINUOUS_MAP : thm
  CONTINUOUS_EQ_UNIFORMLY_CONTINUOUS_MAP : thm
  CAUCHY_EQ_UNIFORMLY_CONTINUOUS_MAP : thm
  LIPSCHITZ_CONTINUOUS_MAP_PROJECTIONS : thm
  LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE : thm
  UNIFORMLY_CONTINUOUS_MAP_PAIRWISE : thm
  CAUCHY_CONTINUOUS_MAP_PAIRWISE : thm
  LIPSCHITZ_CONTINUOUS_MAP_PAIRED : thm
  UNIFORMLY_CONTINUOUS_MAP_PAIRED : thm
  CAUCHY_CONTINUOUS_MAP_PAIRED : thm
  deriving Inhabited

@[nospecialize]
def setupCC3 [HolBase] (D : MetricDeps) (BPM1 : PM1) (BPM2 : PM2) (BLIP1 : LIP1) (BUC1 : UC1)
    (BCC1 : CC1) (BCC2 : CC2) : ExceptT String IO CC3 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_IMP, IN_CROSS, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { REAL_LT_ADD, REAL_LT_MIN, REAL_MUL_LID, .. } := D.core3
  let { SUBSET, o_DEF, .. } := D.core4
  let { FORALL_AND_THM, FORALL_PAIR_FUN_THM, FORALL_PAIR_THM, o_ASSOC, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { COMPONENT_LE_PROD_METRIC, PROD_METRIC, PROD_METRIC_LE_COMPONENTS, .. } := BPM1
  let { CAUCHY_IN_PROD_METRIC, .. } := BPM2
  let { LIPSCHITZ_CONTINUOUS_MAP_COMPOSE, LIPSCHITZ_CONTINUOUS_MAP_POS, lipschitz_continuous_map,
        .. } := BLIP1
  let { UNIFORMLY_CONTINUOUS_MAP_COMPOSE, uniformly_continuous_map, .. } := BUC1
  let { cauchy_continuous_map, .. } := BCC1
  let { CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP, CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP,
        CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP, CONTINUOUS_IMP_UNIFORMLY_CONTINUOUS_MAP,
        LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP, UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP,
        UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP, .. } := BCC2
  -- @@SCOPE END

  let CONTINUOUS_EQ_CAUCHY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        mcomplete m1
        ==> (continuous_map (mtopology m1,mtopology m2) f <=>
             cauchy_continuous_map (m1,m2) f)"
   (MESON_TAC [CONTINUOUS_IMP_CAUCHY_CONTINUOUS_MAP,
               CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP])

  let CONTINUOUS_EQ_UNIFORMLY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        compact_space (mtopology m1)
        ==> (continuous_map (mtopology m1,mtopology m2) f <=>
             uniformly_continuous_map (m1,m2) f)"
   (MESON_TAC [CONTINUOUS_IMP_UNIFORMLY_CONTINUOUS_MAP,
               UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP])

  let CAUCHY_EQ_UNIFORMLY_CONTINUOUS_MAP ← prove
   r"!m1 m2 f:A->B.
        totally_bounded_in m1 (mspace m1)
        ==> (cauchy_continuous_map (m1,m2) f <=>
             uniformly_continuous_map (m1,m2) f)"
   (MESON_TAC [CAUCHY_IMP_UNIFORMLY_CONTINUOUS_MAP,
               UNIFORMLY_IMP_CAUCHY_CONTINUOUS_MAP])

  let LIPSCHITZ_CONTINUOUS_MAP_PROJECTIONS ← prove
   r"(!m1:A metric m2:B metric.
        lipschitz_continuous_map (prod_metric m1 m2,m1) FST) /\
   (!m1:A metric m2:B metric.
        lipschitz_continuous_map (prod_metric m1 m2,m2) SND)"
   (CONJ_TAC THEN REPEAT GEN_TAC THEN REWRITE_TAC [lipschitz_continuous_map] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← CONJUNCT1 PROD_METRIC] THEN
    SIMP_TAC [FORALL_PAIR_THM, IN_CROSS] THEN EXISTS_TAC (← q r"&1") THEN
    REWRITE_TAC [REAL_MUL_LID, COMPONENT_LE_PROD_METRIC])

  let LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE ← prove
   r"!m m1 m2 (f:A->B#C).
        lipschitz_continuous_map(m,prod_metric m1 m2) f <=>
        lipschitz_continuous_map(m,m1) (FST o f) /\
        lipschitz_continuous_map(m,m2) (SND o f)"
   (REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    CONJ_TAC THENL
     [MESON_TAC [LIPSCHITZ_CONTINUOUS_MAP_COMPOSE,
                 LIPSCHITZ_CONTINUOUS_MAP_PROJECTIONS],
      REPLICATE_TAC 3 GEN_TAC THEN
      REWRITE_TAC [FORALL_PAIR_FUN_THM, o_DEF, ETA_AX] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A->B", ← q r"y:A->C"] THEN
      REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_POS] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← CONJUNCT1 PROD_METRIC] THEN
      DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [IN_CROSS, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"B:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"C:real") THEN STRIP_TAC THEN EXISTS_TAC (← q r"B + C:real") THEN
      ASM_SIMP_TAC [REAL_LT_ADD] THEN REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) PROD_METRIC_LE_COMPONENTS o
        lhand o snd) THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH (← q
       r"y <= c * m /\ z <= b * m ==> x <= y + z ==> x <= (b + c) * m")) THEN
      ASM_SIMP_TAC []])

  let UNIFORMLY_CONTINUOUS_MAP_PAIRWISE ← prove
   r"!m m1 m2 (f:A->B#C).
        uniformly_continuous_map(m,prod_metric m1 m2) f <=>
        uniformly_continuous_map(m,m1) (FST o f) /\
        uniformly_continuous_map(m,m2) (SND o f)"
   (REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    CONJ_TAC THENL
     [MESON_TAC [UNIFORMLY_CONTINUOUS_MAP_COMPOSE,
                 LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP,
                 LIPSCHITZ_CONTINUOUS_MAP_PROJECTIONS],
      REPLICATE_TAC 3 GEN_TAC THEN
      REWRITE_TAC [FORALL_PAIR_FUN_THM, o_DEF, ETA_AX] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A->B", ← q r"y:A->C"] THEN
      REWRITE_TAC [uniformly_continuous_map] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, ← CONJUNCT1 PROD_METRIC] THEN
      DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_SIMP_TAC [IN_CROSS, IMP_IMP] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
      ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"d1:real") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"d2:real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"min d1 d2:real") THEN ASM_REWRITE_TAC [REAL_LT_MIN] THEN
      REPEAT STRIP_TAC THEN
      W (MP_TAC o PART_MATCH (lhand o rand) PROD_METRIC_LE_COMPONENTS o
        lhand o snd) THEN
      ASM_SIMP_TAC [] THEN MATCH_MP_TAC (← REAL_ARITH (← q
       r"x < e / &2 /\ y < e / &2 ==> z <= x + y ==> z < e")) THEN
      ASM_SIMP_TAC []])

  let CAUCHY_CONTINUOUS_MAP_PAIRWISE ← prove
   r"!m m1 m2 (f:A->B#C).
        cauchy_continuous_map(m,prod_metric m1 m2) f <=>
        cauchy_continuous_map(m,m1) (FST o f) /\
        cauchy_continuous_map(m,m2) (SND o f)"
   (REWRITE_TAC [cauchy_continuous_map, CAUCHY_IN_PROD_METRIC, o_ASSOC] THEN
    MESON_TAC [])

  let LIPSCHITZ_CONTINUOUS_MAP_PAIRED ← prove
   r"!m m1 m2 (f:A->B) (g:A->C).
        lipschitz_continuous_map (m,prod_metric m1 m2) (\x. f x,g x) <=>
        lipschitz_continuous_map(m,m1) f /\ lipschitz_continuous_map(m,m2) g"
   (REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let UNIFORMLY_CONTINUOUS_MAP_PAIRED ← prove
   r"!m m1 m2 (f:A->B) (g:A->C).
        uniformly_continuous_map (m,prod_metric m1 m2) (\x. f x,g x) <=>
        uniformly_continuous_map(m,m1) f /\ uniformly_continuous_map(m,m2) g"
   (REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let CAUCHY_CONTINUOUS_MAP_PAIRED ← prove
   r"!m m1 m2 (f:A->B) (g:A->C).
        cauchy_continuous_map (m,prod_metric m1 m2) (\x. f x,g x) <=>
        cauchy_continuous_map(m,m1) f /\ cauchy_continuous_map(m,m2) g"
   (REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  return { CONTINUOUS_EQ_CAUCHY_CONTINUOUS_MAP, CONTINUOUS_EQ_UNIFORMLY_CONTINUOUS_MAP,
           CAUCHY_EQ_UNIFORMLY_CONTINUOUS_MAP, LIPSCHITZ_CONTINUOUS_MAP_PROJECTIONS,
           LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, UNIFORMLY_CONTINUOUS_MAP_PAIRWISE,
           CAUCHY_CONTINUOUS_MAP_PAIRWISE, LIPSCHITZ_CONTINUOUS_MAP_PAIRED,
           UNIFORMLY_CONTINUOUS_MAP_PAIRED, CAUCHY_CONTINUOUS_MAP_PAIRED }

/- ------------------------------------------------------------------------- -/
/- Images under these maps, and continuity of the metric.                    -/
/- (metric.ml 31459-31591)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CC4 where
  MBOUNDED_LIPSCHITZ_CONTINUOUS_IMAGE : thm
  TOTALLY_BOUNDED_IN_CAUCHY_CONTINUOUS_IMAGE : thm
  LIPSCHITZ_COEFFICIENT_POS : thm
  LIPSCHITZ_CONTINUOUS_MAP_METRIC : thm
  LIPSCHITZ_CONTINUOUS_MAP_MDIST : thm
  UNIFORMLY_CONTINUOUS_MAP_MDIST : thm
  CAUCHY_CONTINUOUS_MAP_MDIST : thm
  CONTINUOUS_MAP_METRIC : thm
  CONTINUOUS_MAP_MDIST_ALT : thm
  CONTINUOUS_MAP_MDIST : thm
  CONTINUOUS_ON_MDIST : thm
  deriving Inhabited

@[nospecialize]
def setupCC4 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BProd1 : Prod1) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BMetricArith : MetricArithB)
    (BRealTop2 : RealTop2) (BTotBdd1 : TotBdd1) (BPM1 : PM1) (BLIP1 : LIP1) (BUC1 : UC1)
    (BCC1 : CC1) (BCC2 : CC2) (BCC3 : CC3) : ExceptT String IO CC4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_TAC, INTRO_TAC, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE_2, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_CROSS, IN_IMAGE, LEFT_IMP_EXISTS_THM, MONO_EXISTS,
        REAL_ABS_BOUNDS, .. } := D.core2
  let { REAL_LE_LDIV_EQ, REAL_LE_LMUL_EQ, REAL_LE_TRANS, REAL_LTE_TRANS, REAL_LT_DIV,
        REAL_LT_MUL, .. } := D.core3
  let { SKOLEM_THM, SUBSET_UNIV, o_DEF, .. } := D.core4
  let { FORALL_AND_THM, FORALL_PAIR_THM, .. } := D.core5
  let { CLAIM_TAC, .. } := BTactics
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, .. } := BContMap2
  let { CONTINUOUS_MAP_PAIRWISE, .. } := BProd1
  let { MDIST_POS_LT, .. } := BMetricSpace
  let { TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { MBOUNDED_ALT_POS, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { TOTALLY_BOUNDED_IN_SEQUENTIALLY, .. } := BTotBdd1
  let { COMPONENT_LE_PROD_METRIC, MTOPOLOGY_PROD_METRIC, PROD_METRIC, .. } := BPM1
  let { LIPSCHITZ_CONTINUOUS_MAP_COMPOSE, LIPSCHITZ_CONTINUOUS_MAP_POS, lipschitz_continuous_map,
        .. } := BLIP1
  let { UNIFORMLY_CONTINUOUS_MAP_COMPOSE, .. } := BUC1
  let { CAUCHY_CONTINUOUS_MAP_COMPOSE, CAUCHY_CONTINUOUS_MAP_IMAGE, cauchy_continuous_map, .. } :=
    BCC1
  let { LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP, LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP,
        LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP, .. } := BCC2
  let { CAUCHY_CONTINUOUS_MAP_PAIRED, LIPSCHITZ_CONTINUOUS_MAP_PAIRED,
        UNIFORMLY_CONTINUOUS_MAP_PAIRED, .. } := BCC3
  -- @@SCOPE END

  let MBOUNDED_LIPSCHITZ_CONTINUOUS_IMAGE ← prove
   r"!m1 m2 (f:A->B) s.
        lipschitz_continuous_map (m1,m2) f /\ mbounded m1 s
        ==> mbounded m2 (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [MBOUNDED_ALT_POS, LIPSCHITZ_CONTINUOUS_MAP_POS] THEN
    REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"B:real") THEN DISCH_TAC THEN REWRITE_TAC [IMP_IMP] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"C:real") THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [FORALL_IN_IMAGE_2]] THEN
    EXISTS_TAC (← q r"B * C:real") THEN ASM_SIMP_TAC [REAL_LT_MUL] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS (← q r"B * mdist m1 (x:A,y)") THEN
    ASM_SIMP_TAC [REAL_LE_LMUL_EQ] THEN ASM SET_TAC [])

  let TOTALLY_BOUNDED_IN_CAUCHY_CONTINUOUS_IMAGE ← prove
   r"!m1 m2 (f:A->B) s.
        cauchy_continuous_map (m1,m2) f /\ totally_bounded_in m1 s
        ==> totally_bounded_in m2 (IMAGE f s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
    CONJ_TAC THENL [ASM SET_TAC [], REWRITE_TAC [IN_IMAGE]] THEN
    X_GEN_TAC (← q r"y:num->B") THEN REWRITE_TAC [SKOLEM_THM, FORALL_AND_THM] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x:num->A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"r:num->num") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [cauchy_continuous_map]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(x:num->A) o (r:num->num)")) THEN
    ASM_REWRITE_TAC [] THEN ASM_REWRITE_TAC [o_DEF])

  let LIPSCHITZ_COEFFICIENT_POS ← prove
   r"!m m' f:A->B k.
     (!x. x IN mspace m ==> f x IN mspace m') /\
     (!x y. x IN mspace m /\ y IN mspace m
            ==> mdist m' (f x,f y) <= k * mdist m (x,y)) /\
     (?x y. x IN mspace m /\ y IN mspace m /\ ~(f x = f y))
     ==> &0 < k"
   (REPEAT GEN_TAC THEN INTRO_TAC "f k (@x y. x y fneq)" THEN
    CLAIM_TAC "neq" (← q r"~(x:A = y)") THENL [HYP MESON_TAC "fneq" [], ALL_TAC] THEN
    TRANS_TAC REAL_LTE_TRANS (← q r"mdist m' (f x:B,f y) / mdist m (x:A,y)") THEN
    ASM_SIMP_TAC [REAL_LT_DIV, MDIST_POS_LT, REAL_LE_LDIV_EQ])

  let LIPSCHITZ_CONTINUOUS_MAP_METRIC ← prove
   r"!m:A metric.
        lipschitz_continuous_map
          (prod_metric m m,real_euclidean_metric)
          (mdist m)"
   (SIMP_TAC [lipschitz_continuous_map, ← CONJUNCT1 PROD_METRIC,
              REAL_EUCLIDEAN_METRIC] THEN
    GEN_TAC THEN REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, SUBSET_UNIV] THEN
    EXISTS_TAC (← q r"&2") THEN
    MAP_EVERY X_GEN_TAC [← q r"x1:A", ← q r"y1:A", ← q r"x2:A", ← q r"y2:A"] THEN
    STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) COMPONENT_LE_PROD_METRIC o
      rand o rand o snd) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q
     r"x <= y + z ==> y <= p /\ z <= p ==> x <= &2 * p")) THEN
    REWRITE_TAC [REAL_ABS_BOUNDS] THEN CONJ_TAC THEN
    REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => METRIC_ARITH t))

  let LIPSCHITZ_CONTINUOUS_MAP_MDIST ← prove
   r"!m m' (f:A->B) g.
      lipschitz_continuous_map (m,m') f /\
      lipschitz_continuous_map (m,m') g
      ==> lipschitz_continuous_map (m,real_euclidean_metric)
             (\x. mdist m' (f x,g x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric (m':B metric) m'") THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_METRIC] THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRED])

  let UNIFORMLY_CONTINUOUS_MAP_MDIST ← prove
   r"!m m' (f:A->B) g.
      uniformly_continuous_map (m,m') f /\
      uniformly_continuous_map (m,m') g
      ==> uniformly_continuous_map (m,real_euclidean_metric)
             (\x. mdist m' (f x,g x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC UNIFORMLY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric (m':B metric) m'") THEN
    SIMP_TAC [LIPSCHITZ_IMP_UNIFORMLY_CONTINUOUS_MAP,
              LIPSCHITZ_CONTINUOUS_MAP_METRIC] THEN
    ASM_REWRITE_TAC [UNIFORMLY_CONTINUOUS_MAP_PAIRED])

  let CAUCHY_CONTINUOUS_MAP_MDIST ← prove
   r"!m m' (f:A->B) g.
      cauchy_continuous_map (m,m') f /\
      cauchy_continuous_map (m,m') g
      ==> cauchy_continuous_map (m,real_euclidean_metric)
             (\x. mdist m' (f x,g x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CAUCHY_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric (m':B metric) m'") THEN
    SIMP_TAC [LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP,
              LIPSCHITZ_CONTINUOUS_MAP_METRIC] THEN
    ASM_REWRITE_TAC [CAUCHY_CONTINUOUS_MAP_PAIRED])

  let CONTINUOUS_MAP_METRIC ← prove
   r"!m:A metric.
        continuous_map (prod_topology (mtopology m) (mtopology m),
                        euclideanreal)
                       (mdist m)"
   (REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
                 ← GSYM MTOPOLOGY_PROD_METRIC] THEN
    GEN_TAC THEN MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_METRIC])

  let CONTINUOUS_MAP_MDIST_ALT ← prove
   r"!m f:A->B#B.
        continuous_map (top,prod_topology (mtopology m) (mtopology m)) f
        ==> continuous_map (top,euclideanreal) (\x. mdist m (f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_METRIC, CONTINUOUS_MAP_COMPOSE])

  let CONTINUOUS_MAP_MDIST ← prove
   r"!top m f g:A->B.
        continuous_map (top,mtopology m) f /\
        continuous_map (top,mtopology m) g
        ==> continuous_map (top,euclideanreal) (\x. mdist m (f x,g x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_topology (mtopology m:B topology) (mtopology m)") THEN
    REWRITE_TAC [CONTINUOUS_MAP_METRIC, CONTINUOUS_MAP_PAIRWISE] THEN
    ASM_REWRITE_TAC [o_DEF, ETA_AX])

  let CONTINUOUS_ON_MDIST ← prove
   r"!m a. a:A IN mspace m
         ==> continuous_map (mtopology m,euclideanreal) (\x. mdist m (a,x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_MDIST THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST] THEN
    ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY])

  return { MBOUNDED_LIPSCHITZ_CONTINUOUS_IMAGE, TOTALLY_BOUNDED_IN_CAUCHY_CONTINUOUS_IMAGE,
           LIPSCHITZ_COEFFICIENT_POS, LIPSCHITZ_CONTINUOUS_MAP_METRIC,
           LIPSCHITZ_CONTINUOUS_MAP_MDIST, UNIFORMLY_CONTINUOUS_MAP_MDIST,
           CAUCHY_CONTINUOUS_MAP_MDIST, CONTINUOUS_MAP_METRIC, CONTINUOUS_MAP_MDIST_ALT,
           CONTINUOUS_MAP_MDIST, CONTINUOUS_ON_MDIST }

/- ------------------------------------------------------------------------- -/
/- Lipschitz continuity of real arithmetic operations.                       -/
/- (metric.ml 31593-31703)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CC5 where
  LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_RIGHT_MULTIPLICATION : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_NEGATION : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_SUBTRACTION : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM : thm
  LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION : thm
  deriving Inhabited

@[nospecialize]
def setupCC5 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BRealTop2 : RealTop2)
    (BRealConn1 : RealConn1) (BPM1 : PM1) (BPM3 : PM3) (BLIP1 : LIP1) :
    ExceptT String IO CC5 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_CROSS, IN_INTER, IN_UNIV, LEFT_IMP_EXISTS_THM, REAL_ABS_MUL, .. } := D.core2
  let { REAL_ABS_POS, REAL_LE_LMUL_EQ, REAL_LE_REFL, REAL_LE_RMUL, REAL_LE_TRANS,
        REAL_MUL_LID, REAL_MUL_SYM, REAL_NEG_MINUS1, .. } := D.core3
  let { REAL_SUB_LDISTRIB, SUBSET_UNIV, .. } := D.core4
  let { FORALL_PAIR_THM, .. } := D.core5
  let { SUBMETRIC, .. } := BMetricSpace
  let { REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { MBOUNDED_REAL_EUCLIDEAN_METRIC, REAL_BOUNDED_POS, .. } := BRealConn1
  let { COMPONENT_LE_PROD_METRIC, PROD_METRIC, .. } := BPM1
  let { MBOUNDED_PROD_METRIC, .. } := BPM3
  let { lipschitz_continuous_map, .. } := BLIP1
  -- @@SCOPE END

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION ← prove
   r"!c. lipschitz_continuous_map(real_euclidean_metric,real_euclidean_metric)
         (\x. c * x)"
   (GEN_TAC THEN REWRITE_TAC [lipschitz_continuous_map] THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC, IN_UNIV, SUBSET_UNIV] THEN
    REWRITE_TAC [← GSYM REAL_SUB_LDISTRIB, REAL_ABS_MUL] THEN
    MESON_TAC [REAL_LE_REFL])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_RIGHT_MULTIPLICATION ← prove
   r"!c. lipschitz_continuous_map(real_euclidean_metric,real_euclidean_metric)
         (\x. x * c)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_NEGATION ← prove
   r"lipschitz_continuous_map(real_euclidean_metric,real_euclidean_metric) (--)"
   (GEN_REWRITE_TAC RAND_CONV [← GSYM ETA_AX] THEN
    ONCE_REWRITE_TAC [REAL_NEG_MINUS1] THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE ← prove
   r"lipschitz_continuous_map(real_euclidean_metric,real_euclidean_metric) abs"
   (SIMP_TAC [lipschitz_continuous_map, REAL_EUCLIDEAN_METRIC, SUBSET_UNIV] THEN
    EXISTS_TAC (← q r"&1") THEN REAL_ARITH_TAC)

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION ← prove
   r"lipschitz_continuous_map
    (prod_metric real_euclidean_metric real_euclidean_metric,
     real_euclidean_metric)
    (\(x,y). x + y)"
   (REWRITE_TAC [lipschitz_continuous_map, ← CONJUNCT1 PROD_METRIC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, IN_CROSS] THEN
    EXISTS_TAC (← q r"&2") THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x <= &2 * y <=> x / &2 <= y")] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
          COMPONENT_LE_PROD_METRIC o rand o snd) THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN REAL_ARITH_TAC)

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_SUBTRACTION ← prove
   r"lipschitz_continuous_map
    (prod_metric real_euclidean_metric real_euclidean_metric,
     real_euclidean_metric)
    (\(x,y). x - y)"
   (REWRITE_TAC [lipschitz_continuous_map, ← CONJUNCT1 PROD_METRIC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, IN_CROSS] THEN
    EXISTS_TAC (← q r"&2") THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [← REAL_ARITH (← q r"x <= &2 * y <=> x / &2 <= y")] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
          COMPONENT_LE_PROD_METRIC o rand o snd) THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN REAL_ARITH_TAC)

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM ← prove
   r"lipschitz_continuous_map
    (prod_metric real_euclidean_metric real_euclidean_metric,
     real_euclidean_metric)
    (\(x,y). max x y)"
   (REWRITE_TAC [lipschitz_continuous_map, ← CONJUNCT1 PROD_METRIC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, IN_CROSS] THEN
    EXISTS_TAC (← q r"&1") THEN REPEAT GEN_TAC THEN REWRITE_TAC [REAL_MUL_LID] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
          COMPONENT_LE_PROD_METRIC o rand o snd) THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN REAL_ARITH_TAC)

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM ← prove
   r"lipschitz_continuous_map
    (prod_metric real_euclidean_metric real_euclidean_metric,
     real_euclidean_metric)
    (\(x,y). min x y)"
   (REWRITE_TAC [lipschitz_continuous_map, ← CONJUNCT1 PROD_METRIC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_UNIV, SUBSET_UNIV, IN_CROSS] THEN
    EXISTS_TAC (← q r"&1") THEN REPEAT GEN_TAC THEN REWRITE_TAC [REAL_MUL_LID] THEN
    W (MP_TAC o PART_MATCH (rand o rand)
          COMPONENT_LE_PROD_METRIC o rand o snd) THEN
    REWRITE_TAC [REAL_EUCLIDEAN_METRIC] THEN REAL_ARITH_TAC)

  let LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION ← prove
   r"!s. mbounded (prod_metric real_euclidean_metric real_euclidean_metric) s
       ==> lipschitz_continuous_map
            (submetric
              (prod_metric real_euclidean_metric real_euclidean_metric) s,
             real_euclidean_metric)
            (\(x,y). x * y)"
   (GEN_TAC THEN REWRITE_TAC [MBOUNDED_PROD_METRIC] THEN
    REWRITE_TAC [MBOUNDED_REAL_EUCLIDEAN_METRIC, REAL_BOUNDED_POS] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:real") THEN REWRITE_TAC [FORALL_PAIR_THM] THEN
    REPEAT DISCH_TAC THEN X_GEN_TAC (← q r"C:real") THEN REPEAT DISCH_TAC THEN
    SIMP_TAC [lipschitz_continuous_map, REAL_EUCLIDEAN_METRIC, SUBSET_UNIV] THEN
    EXISTS_TAC (← q r"B + C:real") THEN
    REWRITE_TAC [FORALL_PAIR_THM, SUBMETRIC, IN_INTER, ← CONJUNCT1 PROD_METRIC] THEN
    MAP_EVERY X_GEN_TAC [← q r"x1:real", ← q r"y1:real", ← q r"x2:real",
                         ← q r"y2:real"] THEN
    REWRITE_TAC [IN_CROSS, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN STRIP_TAC THEN
    TRANS_TAC REAL_LE_TRANS
     (← q r"B * mdist real_euclidean_metric (y1,y2) +
      C * mdist real_euclidean_metric (x1,x2)") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [REAL_EUCLIDEAN_METRIC],
      MATCH_MP_TAC (← REAL_ARITH (← q
       r"x <= b * d /\ y <= c * d ==> x + y <= (b + c) * d")) THEN
      ASM_SIMP_TAC [REAL_LE_LMUL_EQ, COMPONENT_LE_PROD_METRIC]] THEN
    ONCE_REWRITE_TAC [← REAL_ARITH (← q
     r"x2 * y2 - x1 * y1:real = x2 * (y2 - y1) + y1 * (x2 - x1)")] THEN
    MATCH_MP_TAC (← REAL_ARITH (← q
     r"abs x <= a /\ abs y <= b ==> abs(x + y) <= a + b")) THEN
    REWRITE_TAC [REAL_ABS_MUL] THEN CONJ_TAC THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
    ASM_MESON_TAC [])

  return { LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_RIGHT_MULTIPLICATION,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_NEGATION, LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION, LIPSCHITZ_CONTINUOUS_MAP_REAL_SUBTRACTION,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM, LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM,
           LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION }

/- ------------------------------------------------------------------------- -/
/- Lipschitz continuity of real-valued combinations.  (metric.ml 31705-31880) -/
/- ------------------------------------------------------------------------- -/

structure CC6 where
  CAUCHY_CONTINUOUS_MAP_REAL_MULTIPLICATION : thm
  LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_INVERSION : thm
  LIPSCHITZ_CONTINUOUS_MAP_FST : thm
  LIPSCHITZ_CONTINUOUS_MAP_SND : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_LMUL : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_RMUL : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_NEG : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_ABS : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_INV : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_ADD : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_SUB : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_MAX : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_MIN : thm
  LIPSCHITZ_CONTINUOUS_MAP_REAL_MUL : thm
  deriving Inhabited

@[nospecialize]
def setupCC6 [HolBase] (D : MetricDeps) (BInterior : Interior) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BBounded : Bounded) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2)
    (BRealConn1 : RealConn1) (BPM3 : PM3) (BLIP1 : LIP1) (BCC2 : CC2) (BCC3 : CC3)
    (BCC5 : CC5) : ExceptT String IO CC6 := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, REAL_FIELD, SET_RULE, .. } := D
  let { ETA_AX, FORALL_IN_IMAGE, FUN_EQ_THM, FUN_IN_IMAGE, .. } := D.core1
  let { INTER_UNIV, IN_CROSS, IN_DIFF, IN_UNIV, REAL_ABS_INV, REAL_ABS_MUL, REAL_ABS_NEG, .. } :=
    D.core2
  let { REAL_ABS_POS, REAL_LE_INV2, REAL_LE_MUL2, REAL_LE_RMUL, REAL_LT_01, REAL_LT_IMP_LE,
        REAL_MUL_SYM, REAL_NEG_MINUS1, REAL_NOT_LT, REAL_POW_2, REAL_POW_LT, .. } := D.core3
  let { REAL_SUB_RZERO, SUBSET, SUBSET_REFL, SUBSET_UNIV, o_DEF, real_sub, .. } := D.core4
  let { FORALL_PAIR_THM, .. } := D.core5
  let { CLOSURE_OF_INTERIOR_OF, .. } := BInterior
  let { IN_MBALL, SUBMETRIC, .. } := BMetricSpace
  let { IN_INTERIOR_OF_MBALL, .. } := BMTopology
  let { MBOUNDED_MBALL, .. } := BBounded
  let { TOPSPACE_EUCLIDEANREAL, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { MBOUNDED_REAL_EUCLIDEAN_METRIC, .. } := BRealConn1
  let { MBOUNDED_CROSS, .. } := BPM3
  let { LIPSCHITZ_CONTINUOUS_MAP_COMPOSE, LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC,
        lipschitz_continuous_map, .. } := BLIP1
  let { LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP, LOCALLY_CAUCHY_CONTINUOUS_MAP, .. } := BCC2
  let { LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, .. } := BCC3
  let { LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE, LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION,
        LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION, LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM,
        LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM,
        LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION, .. } := BCC5
  -- @@SCOPE END

  let CAUCHY_CONTINUOUS_MAP_REAL_MULTIPLICATION ← prove
   r"cauchy_continuous_map
    (prod_metric real_euclidean_metric real_euclidean_metric,
     real_euclidean_metric)
    (\(x,y). x * y)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC LOCALLY_CAUCHY_CONTINUOUS_MAP THEN
    EXISTS_TAC (← q r"&1") THEN REWRITE_TAC [REAL_LT_01] THEN
    GEN_TAC THEN DISCH_TAC THEN
    MATCH_MP_TAC LIPSCHITZ_IMP_CAUCHY_CONTINUOUS_MAP THEN
    MATCH_MP_TAC LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION THEN
    REWRITE_TAC [MBOUNDED_MBALL])

  let LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_INVERSION ← prove
   r"!s. ~(&0 IN euclideanreal closure_of s)
       ==> lipschitz_continuous_map
             (submetric real_euclidean_metric s,real_euclidean_metric)
             inv"
   (X_GEN_TAC (← q r"s:real->bool") THEN
    REWRITE_TAC [CLOSURE_OF_INTERIOR_OF, IN_DIFF, TOPSPACE_EUCLIDEANREAL] THEN
    REWRITE_TAC [IN_UNIV, ← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [IN_INTERIOR_OF_MBALL] THEN
    REWRITE_TAC [SUBSET, IN_MBALL, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    REWRITE_TAC [REAL_SUB_RZERO, REAL_NOT_LT, ← SET_RULE (← q
     r"(!x. P x ==> x IN UNIV DIFF s) <=> (!x. x IN s ==> ~P x)")] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:real") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [lipschitz_continuous_map, REAL_EUCLIDEAN_METRIC, SUBSET_UNIV,
                 SUBMETRIC, INTER_UNIV] THEN
    EXISTS_TAC (← q r"inv(b pow 2):real") THEN
    MAP_EVERY X_GEN_TAC [← q r"x:real", ← q r"y:real"] THEN
    STRIP_TAC THEN
    ASM_CASES_TAC (← q r"x = &0") THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:real")) THEN ASM_REWRITE_TAC [] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"y = &0") THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:real")) THEN ASM_REWRITE_TAC [] THEN
      ASM_REAL_ARITH_TAC,
      ALL_TAC] THEN
    ASM_SIMP_TAC [← REAL_FIELD (← q
     r"~(x = &0) /\ ~(y = &0) ==> inv y - inv x = --inv(x * y) * (y - x)")] THEN
    REWRITE_TAC [REAL_ABS_MUL, REAL_ABS_NEG, REAL_ABS_INV] THEN
    MATCH_MP_TAC REAL_LE_RMUL THEN REWRITE_TAC [REAL_ABS_POS] THEN
    MATCH_MP_TAC REAL_LE_INV2 THEN ASM_SIMP_TAC [REAL_POW_LT] THEN
    REWRITE_TAC [REAL_POW_2] THEN MATCH_MP_TAC REAL_LE_MUL2 THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE])

  let LIPSCHITZ_CONTINUOUS_MAP_FST ← prove
   r"!m m1 m2 f:A->B#C.
        lipschitz_continuous_map(m,prod_metric m1 m2) f
        ==> lipschitz_continuous_map(m,m1) (\x. FST(f x))"
   (SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF])

  let LIPSCHITZ_CONTINUOUS_MAP_SND ← prove
   r"!m m1 m2 f:A->B#C.
        lipschitz_continuous_map(m,prod_metric m1 m2) f
        ==> lipschitz_continuous_map(m,m2) (\x. SND(f x))"
   (SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_LMUL ← prove
   r"!m c f:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. c * f x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. c * f x) = (\y. c * y) o (f:A->real)")
    SUBST1_TAC THENL [REWRITE_TAC [FUN_EQ_THM, o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"real_euclidean_metric") THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_LEFT_MULTIPLICATION])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_RMUL ← prove
   r"!m c f:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. f x * c)"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_LMUL])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_NEG ← prove
   r"!m f:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. --(f x))"
   (ONCE_REWRITE_TAC [REAL_NEG_MINUS1] THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_LMUL])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_ABS ← prove
   r"!m f:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. abs(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"real_euclidean_metric") THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_ABSOLUTE_VALUE])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_INV ← prove
   r"!m f:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      ~(&0 IN euclideanreal closure_of (IMAGE f (mspace m)))
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. inv(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN EXISTS_TAC
     (← q r"submetric real_euclidean_metric (IMAGE f (mspace m:A->bool))") THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC, SUBSET_REFL] THEN
    MATCH_MP_TAC LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_INVERSION THEN
    ASM_REWRITE_TAC [])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_ADD ← prove
   r"!m f g:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      lipschitz_continuous_map (m,real_euclidean_metric) g
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. f x + g x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. f x + g x) = (\(x,y). x + y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric real_euclidean_metric real_euclidean_metric") THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_ADDITION] THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_SUB ← prove
   r"!m f g:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      lipschitz_continuous_map (m,real_euclidean_metric) g
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. f x - g x)"
   (REWRITE_TAC [real_sub] THEN
    SIMP_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_ADD,
              LIPSCHITZ_CONTINUOUS_MAP_REAL_NEG])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_MAX ← prove
   r"!m f g:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      lipschitz_continuous_map (m,real_euclidean_metric) g
      ==> lipschitz_continuous_map (m,real_euclidean_metric)
            (\x. max (f x) (g x))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. max (f x) (g x)) = (\(x,y). max x y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric real_euclidean_metric real_euclidean_metric") THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_MAXIMUM] THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_MIN ← prove
   r"!m f g:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      lipschitz_continuous_map (m,real_euclidean_metric) g
      ==> lipschitz_continuous_map (m,real_euclidean_metric)
            (\x. min (f x) (g x))"
   (REPEAT STRIP_TAC THEN SUBGOAL_THEN
     (← q r"(\x. min (f x) (g x)) = (\(x,y). min x y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_metric real_euclidean_metric real_euclidean_metric") THEN
    REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_REAL_MINIMUM] THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let LIPSCHITZ_CONTINUOUS_MAP_REAL_MUL ← prove
   r"!m f g:A->real.
      lipschitz_continuous_map (m,real_euclidean_metric) f /\
      lipschitz_continuous_map (m,real_euclidean_metric) g /\
      real_bounded (IMAGE f (mspace m)) /\ real_bounded (IMAGE g (mspace m))
      ==> lipschitz_continuous_map (m,real_euclidean_metric) (\x. f x * g x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. f x * g x) = (\(x,y). x * y) o (\z. (f:A->real) z,g z)")
    SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_DEF, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC LIPSCHITZ_CONTINUOUS_MAP_COMPOSE THEN
    EXISTS_TAC
     (← q r"submetric (prod_metric real_euclidean_metric real_euclidean_metric)
                (IMAGE (f:A->real) (mspace m) CROSS IMAGE g (mspace m))") THEN
    ASM_REWRITE_TAC [LIPSCHITZ_CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX,
                     LIPSCHITZ_CONTINUOUS_MAP_INTO_SUBMETRIC] THEN
    SIMP_TAC [SUBSET, FORALL_IN_IMAGE, IN_CROSS, FUN_IN_IMAGE] THEN
    MATCH_MP_TAC LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_MULTIPLICATION THEN
    ASM_REWRITE_TAC [MBOUNDED_CROSS, MBOUNDED_REAL_EUCLIDEAN_METRIC])

  return { CAUCHY_CONTINUOUS_MAP_REAL_MULTIPLICATION,
           LOCALLY_LIPSCHITZ_CONTINUOUS_MAP_REAL_INVERSION, LIPSCHITZ_CONTINUOUS_MAP_FST,
           LIPSCHITZ_CONTINUOUS_MAP_SND, LIPSCHITZ_CONTINUOUS_MAP_REAL_LMUL,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_RMUL, LIPSCHITZ_CONTINUOUS_MAP_REAL_NEG,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_ABS, LIPSCHITZ_CONTINUOUS_MAP_REAL_INV,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_ADD, LIPSCHITZ_CONTINUOUS_MAP_REAL_SUB,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_MAX, LIPSCHITZ_CONTINUOUS_MAP_REAL_MIN,
           LIPSCHITZ_CONTINUOUS_MAP_REAL_MUL }

