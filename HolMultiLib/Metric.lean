@[nospecialize]
def setupLAV2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BClosure : Closure) (BContMap1 : ContMap1) (BT1a : T1a) (BFsigmaGdelta : FsigmaGdelta)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetrizable : Metrizable)
    (BRegular1 : Regular1) (BAtPoint : AtPoint) (BPtCont : PtCont) (BMetricCont : MetricCont)
    (BCMS1 : CMS1) (BEXT1 : EXT1) (BLAV1 : LAV1) : ExceptT String IO LAV2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_GSPEC, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTERS_GSPEC, INTER_SUBSET, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER,
