structure MCompact3 where
  TOTALLY_BOUNDED_IN_EQ_COMPACT_CLOSURE_OF : thm
  COMPACT_CLOSURE_OF_EQ_BOLZANO_WEIERSTRASS : thm
  MCOMPLETE_REAL_EUCLIDEAN_METRIC : thm
  MCOMPLETE_SUBMETRIC_REAL_EUCLIDEAN_METRIC : thm
  TOTALLY_BOUNDED_IN_DISCRETE_METRIC : thm
  DERIVED_SET_OF_INFINITE_OPEN_IN_METRIC : thm
