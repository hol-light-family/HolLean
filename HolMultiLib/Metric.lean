  let { CENTRE_IN_MBALL, IN_MBALL, SUBMETRIC, .. } := BMetricSpace
  let { MBALL_SUBSET_MCBALL, METRIC_CLOSURE_OF, MTOPOLOGY_SUBMETRIC, OPEN_IN_MBALL,
