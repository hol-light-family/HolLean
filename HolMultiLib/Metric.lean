         check (HolCore.Basics.is_forall o concl) o
         check (HolCore.Basics.free_in (← q r"del:real->real") o concl)) THEN
       ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"])) THEN
