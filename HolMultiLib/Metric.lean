   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m1:A metric", ← q r"m2:B metric", ← q r"f:A->B",
                      ← q r"s:A->bool"]
          CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CLOSURE_OF) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CAUCHY_CONTINUOUS_MAP_FROM_SUBMETRIC_MONO])

  return { CAUCHY_CONTINUOUS_MAP_ON_INTERMEDIATE_CLOSURE,
           CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CLOSURE_OF,
           CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_INTERMEDIATE_CLOSURE_OF }

