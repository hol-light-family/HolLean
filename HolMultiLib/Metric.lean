  let { mbounded, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  let { DISCRETE_METRIC, MTOPOLOGY_DISCRETE_METRIC, .. } := BMetrizable
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, .. } := BRealConn1
  let { LIMIT_SUBTOPOLOGY, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  let { CAUCHY_IN_SUBMETRIC, CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, mcomplete, .. } := BCauchy1
  let { FINITE_IMP_TOTALLY_BOUNDED_IN, TOTALLY_BOUNDED_IN_IMP_SUBSET,
        TOTALLY_BOUNDED_IN_SUBMETRIC, .. } := BTotBdd1
  let { CAUCHY_IN_IMP_MBOUNDED, TOTALLY_BOUNDED_IN_CLOSURE_OF, .. } := BTotBdd2
  let { BOLZANO_WEIERSTRASS_PROPERTY, COMPACT_IN_SEQUENTIALLY, .. } := BMCompact1
  let { CLOSED_IN_EQ_MCOMPLETE, COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN,
        COMPACT_IN_IMP_MCOMPLETE, COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN,
        MCOMPLETE_DISCRETE_METRIC, .. } := BMCompact2
  -- @@SCOPE END

  let TOTALLY_BOUNDED_IN_EQ_COMPACT_CLOSURE_OF ← prove
   r"!m s:A->bool.
        mcomplete m
        ==> (totally_bounded_in m s <=>
             s SUBSET mspace m /\
             compact_in (mtopology m) (mtopology m closure_of s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN] THEN
    SIMP_TAC [TOTALLY_BOUNDED_IN_IMP_SUBSET] THEN DISCH_TAC THEN
