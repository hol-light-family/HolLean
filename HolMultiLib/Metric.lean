structure RealFns2 where
  MONOTONE_MAP_INTO_EUCLIDEANREAL : thm
  MONOTONE_MAP_EUCLIDEANREAL_ALT : thm
  MONOTONE_MAP_EUCLIDEANREAL : thm
  INJECTIVE_EQ_MONOTONE_MAP : thm
  INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL : thm
  deriving Inhabited

@[nospecialize]
def setupRealFns2 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BConnected1 : Connected1)
    (BConnected3 : Connected3) (BMonotone : Monotone) (BRealTop1 : RealTop1)
    (BRealConn1 : RealConn1) (BRealConn2 : RealConn2) (BRealFns1 : RealFns1) :
    ExceptT String IO RealFns2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_IMAGE, FUN_IN_IMAGE, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMAGE_SUBSET, INJECTIVE_ON_ALT, INTER_UNIV, IN_ELIM_THM, IN_GSPEC, IN_IMAGE, IN_UNIV,
        MONO_FORALL, NOT_IMP, .. } := D.core2
  let { REAL_LT_IMP_LE, REAL_LT_LE, REAL_LT_MIN, REAL_LT_REFL, .. } := D.core3
  let { REAL_SUB_LT, REAL_WLOG_LT, SUBSET, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { ENDS_IN_REAL_INTERVAL, IN_REAL_INTERVAL, IS_REALINTERVAL_CONTAINS_INTERVAL,
        IS_REALINTERVAL_INTERVAL, IS_REALINTERVAL_UNIV, REAL_INTERVAL_NE_EMPTY,
        REAL_INTERVAL_SING, REAL_NON_MONOTONE, REAL_OPEN_CLOSED_INTERVAL,
        STRICTLY_DECREASING_ALT, STRICTLY_INCREASING_ALT, SUBSET_REAL_INTERVAL,
        is_realinterval, .. } := D.misc
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { COMPACT_IN_SUBTOPOLOGY, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_SUBTOPOLOGY, .. } := BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  let { INJECTIVE_IMP_MONOTONE_MAP, .. } := BMonotone
  let { REAL_OPEN_REAL_INTERVAL, TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
        real_open, .. } := BRealTop1
  let { COMPACT_IN_EUCLIDEANREAL_INTERVAL, CONNECTED_IN_EUCLIDEANREAL,
        CONNECTED_IN_EUCLIDEANREAL_INTERVAL, .. } := BRealConn1
  let { REAL_COMPACT_IS_REALINTERVAL, real_compact_def, .. } := BRealConn2
  let { MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT, .. } := BRealFns1
  -- @@SCOPE END

  let MONOTONE_MAP_INTO_EUCLIDEANREAL ← prove
   r"!top (f:A->real).
        connected_space top /\ continuous_map(top,euclideanreal) f
        ==> (monotone_map(top,euclideanreal) f <=>
             !k. is_realinterval k
                  ==> connected_in top {x | x IN topspace top /\ f x IN k})"
   (SIMP_TAC [MONOTONE_MAP_INTO_EUCLIDEANREAL_ALT])

  let MONOTONE_MAP_EUCLIDEANREAL_ALT ← prove
   r"!f s.
      (!c. is_realinterval c ==> is_realinterval {x | x IN s /\ f x IN c}) <=>
      is_realinterval s /\
      ((!x y. x IN s /\ y IN s /\ x <= y ==> f x <= f y) \/
       (!x y. x IN s /\ y IN s /\ x <= y ==> f y <= f x))"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, REWRITE_TAC [is_realinterval, IN_ELIM_THM] THEN SET_TAC []] THEN
    DISCH_TAC THEN MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
    CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(:real)")) THEN
      REWRITE_TAC [IS_REALINTERVAL_UNIV, IN_UNIV, IN_GSPEC],
      REWRITE_TAC [is_realinterval] THEN DISCH_TAC THEN
      REWRITE_TAC [REAL_NON_MONOTONE, NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real", ← q r"c:real"] THEN
      STRIP_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y |  y < (f:real->real) b}")),
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y | (f:real->real) b < y}"))] THEN
      REWRITE_TAC [is_realinterval, IN_ELIM_THM, NOT_IMP] THEN
      (CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"a:real", ← q r"c:real", ← q r"b:real"]) THEN
      ASM_SIMP_TAC [REAL_LT_IMP_LE, REAL_LT_REFL]])

  let MONOTONE_MAP_EUCLIDEANREAL ← prove
   r"!f s. is_realinterval s /\
         continuous_map(subtopology euclideanreal s,euclideanreal) f
         ==> (monotone_map(subtopology euclideanreal s,euclideanreal) f <=>
              (!x y. x IN s /\ y IN s /\ x <= y ==> f x <= f y) \/
              (!x y. x IN s /\ y IN s /\ x <= y ==> f y <= f x))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [MONOTONE_MAP_INTO_EUCLIDEANREAL, CONNECTED_SPACE_SUBTOPOLOGY,
                  CONNECTED_IN_EUCLIDEANREAL, CONNECTED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    ASM_REWRITE_TAC [MONOTONE_MAP_EUCLIDEANREAL_ALT])

  let INJECTIVE_EQ_MONOTONE_MAP ← prove
   r"!f s. is_realinterval s /\
         continuous_map(subtopology euclideanreal s,euclideanreal) f
         ==> ((!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) <=>
              (!x y. x IN s /\ y IN s /\ x < y ==> f x < f y) \/
              (!x y. x IN s /\ y IN s /\ x < y ==> f y < f x))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [STRICTLY_INCREASING_ALT, STRICTLY_DECREASING_ALT] THEN
    REWRITE_TAC [← TAUT (← q r"(p <=> q /\ p \/ r /\ p) <=> (p ==> q \/ r)")] THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN DISCH_TAC THEN
    ASM_SIMP_TAC [← GSYM MONOTONE_MAP_EUCLIDEANREAL] THEN
    MATCH_MP_TAC INJECTIVE_IMP_MONOTONE_MAP THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, TOPSPACE_EUCLIDEANREAL, INTER_UNIV] THEN
    ASM SET_TAC [])

  let INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL ← prove
   r"!f s. is_realinterval s /\
         continuous_map(subtopology euclideanreal s,euclideanreal) f
         ==> ((!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) <=>
              !u. real_open u /\ u SUBSET s ==> real_open(IMAGE f u))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_SIMP_TAC [INJECTIVE_EQ_MONOTONE_MAP] THEN REWRITE_TAC [real_open] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"u:real->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN MATCH_MP_TAC MONO_FORALL THEN
      X_GEN_TAC (← q r"x:real") THEN
      ASM_CASES_TAC (← q r"(x:real) IN u") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [← REAL_ARITH (← q
       r"abs(y - x) < e <=> x - e < y /\ y < x + e")] THEN
      REWRITE_TAC [← GSYM IN_REAL_INTERVAL, ← GSYM SUBSET] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THENL
       [EXISTS_TAC
         (← q r"min ((f:real->real)(x + r / &2) - f x) (f x - f(x - r / &2))") THEN
        CONJ_TAC THENL
         [ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT] THEN
          CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REPEAT CONJ_TAC THEN
          REPEAT (FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
          REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS (← q r"real_interval[f(x - r / &2),f(x + r / &2)]") THEN
        CONJ_TAC THENL
         [SIMP_TAC [SUBSET_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS
          (← q r"IMAGE (f:real->real) (real_interval(x - r,x + r))") THEN
        ASM_SIMP_TAC [IMAGE_SUBSET] THEN
        MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN CONJ_TAC THENL
         [REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEANREAL] THEN
          MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
          EXISTS_TAC (← q r"subtopology euclideanreal s") THEN
          ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, IS_REALINTERVAL_INTERVAL,
                           CONNECTED_IN_EUCLIDEANREAL] THEN
          ASM SET_TAC [],
          CONJ_TAC THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
          REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC],
        EXISTS_TAC
         (← q r"min ((f:real->real)(x - r / &2) - f x) (f x - f(x + r / &2))") THEN
        CONJ_TAC THENL
         [ASM_REWRITE_TAC [REAL_LT_MIN, REAL_SUB_LT] THEN
          CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN REPEAT CONJ_TAC THEN
          REPEAT (FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
          REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC,
          ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS (← q r"real_interval[f(x + r / &2),f(x - r / &2)]") THEN
        CONJ_TAC THENL
         [SIMP_TAC [SUBSET_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
        TRANS_TAC SUBSET_TRANS
          (← q r"IMAGE (f:real->real) (real_interval(x - r,x + r))") THEN
        ASM_SIMP_TAC [IMAGE_SUBSET] THEN
        MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN CONJ_TAC THENL
         [REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEANREAL] THEN
          MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
          EXISTS_TAC (← q r"subtopology euclideanreal s") THEN
          ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY, IS_REALINTERVAL_INTERVAL,
                           CONNECTED_IN_EUCLIDEANREAL] THEN
          ASM SET_TAC [],
          CONJ_TAC THEN MATCH_MP_TAC FUN_IN_IMAGE THEN
          REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC]],
      DISCH_TAC THEN MATCH_MP_TAC REAL_WLOG_LT THEN
      REWRITE_TAC [] THEN CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:real", ← q r"b:real"] THEN REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?u v. IMAGE (f:real->real) (real_interval[a,b]) = real_interval[u,v]")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [← GSYM REAL_COMPACT_IS_REALINTERVAL] THEN CONJ_TAC THENL
         [REWRITE_TAC [real_compact_def] THEN
          MATCH_MP_TAC IMAGE_COMPACT_IN THEN
          EXISTS_TAC (← q r"subtopology euclideanreal s") THEN
          ASM_REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY] THEN
          REWRITE_TAC [COMPACT_IN_EUCLIDEANREAL_INTERVAL] THEN
          MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN
          ASM_REWRITE_TAC [],
          REWRITE_TAC [← GSYM CONNECTED_IN_EUCLIDEANREAL] THEN
          MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
          EXISTS_TAC (← q r"subtopology euclideanreal s") THEN
          ASM_REWRITE_TAC [CONNECTED_IN_SUBTOPOLOGY] THEN
          REWRITE_TAC [CONNECTED_IN_EUCLIDEANREAL_INTERVAL] THEN
          MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN
          ASM_REWRITE_TAC []],
        SUBGOAL_THEN
         (← q r"?x. x IN real_interval(a,b) /\
              (f:real->real) x IN {u,v}")
        STRIP_ASSUME_TAC THENL
         [REWRITE_TAC [REAL_OPEN_CLOSED_INTERVAL] THEN
          ASM_CASES_TAC (← q r"v:real = u") THENL
           [MATCH_MP_TAC (← SET_RULE (← q
             r"IMAGE f s = {u} /\ ~(s DIFF {a,b} = {})
              ==> ?x. x IN s DIFF {a,b} /\ f x IN {u,v}")) THEN
            ASM_REWRITE_TAC [← GSYM REAL_OPEN_CLOSED_INTERVAL] THEN
            ASM_REWRITE_TAC [REAL_INTERVAL_SING, REAL_INTERVAL_NE_EMPTY],
            SUBGOAL_THEN
             (← q r"u IN IMAGE (f:real->real) (real_interval [a,b]) /\
              v IN IMAGE (f:real->real) (real_interval [a,b])")
            MP_TAC THENL
             [ASM_REWRITE_TAC [ENDS_IN_REAL_INTERVAL] THEN
              ASM_MESON_TAC [IMAGE_EQ_EMPTY, REAL_INTERVAL_NE_EMPTY,
                             REAL_LT_LE],
              REWRITE_TAC [IN_IMAGE] THEN MATCH_MP_TAC (← SET_RULE (← q
               r"f a = f b /\ ~(u = v) ==>
                (?x. u = f x /\ x IN s) /\ (?x. v = f x /\ x IN s)
                ==> ?x. x IN s DIFF {a,b} /\ f x IN {u,v}")) THEN
              ASM_REWRITE_TAC []]],
          ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"real_interval(a,b)")) THEN
        REWRITE_TAC [REAL_OPEN_REAL_INTERVAL] THEN
        MATCH_MP_TAC (← TAUT (← q r"p /\ ~q ==> (p ==> q) ==> r")) THEN
        REWRITE_TAC [REAL_OPEN_CLOSED_INTERVAL] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET u ==> s DIFF t SUBSET u")) THEN
          MATCH_MP_TAC IS_REALINTERVAL_CONTAINS_INTERVAL THEN
          ASM_REWRITE_TAC [],
          ALL_TAC] THEN
        REWRITE_TAC [real_open, FORALL_IN_IMAGE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:real")) THEN
        ASM_REWRITE_TAC [← GSYM REAL_OPEN_CLOSED_INTERVAL] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"d:real")
         (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
        REWRITE_TAC [REAL_OPEN_CLOSED_INTERVAL] THEN MATCH_MP_TAC (← SET_RULE (← q
          r"(?x. P x /\ ~(x IN IMAGE f s))
           ==> ~(!x. P x ==> x IN IMAGE f (s DIFF t))")) THEN
        ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (DISJ_CASES_THEN SUBST1_TAC o MATCH_MP (← SET_RULE (← q
         r"x IN {a,b} ==> x = a \/ x = b")))
        THENL [EXISTS_TAC (← q r"u - d / &2"), EXISTS_TAC (← q r"v + d / &2")] THEN
        REWRITE_TAC [IN_REAL_INTERVAL] THEN ASM_REAL_ARITH_TAC]])

  return { MONOTONE_MAP_INTO_EUCLIDEANREAL, MONOTONE_MAP_EUCLIDEANREAL_ALT,
           MONOTONE_MAP_EUCLIDEANREAL, INJECTIVE_EQ_MONOTONE_MAP,
           INJECTIVE_EQ_REAL_OPEN_MAP_EUCLIDEANREAL }


/- ------------------------------------------------------------------------- -/
/- Normal spaces including Urysohn's lemma and the Tietze extension theorem. -/
/- (metric.ml 24001-24185)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Normal1 where
  normal_space : thm
  NORMAL_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_NORMAL_SPACE : thm
  NORMAL_SPACE : thm
  NORMAL_SPACE_ALT : thm
  NORMAL_SPACE_CLOSURES : thm
  NORMAL_SPACE_DISJOINT_CLOSURES : thm
  NORMAL_SPACE_DUAL : thm
  NORMAL_T1_IMP_HAUSDORFF_SPACE : thm
  NORMAL_T1_EQ_HAUSDORFF_SPACE : thm
  NORMAL_T1_IMP_REGULAR_SPACE : thm
  COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupNormal1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BContMap1 : ContMap1) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace)
    (BRetraction : Retraction) (BCompact1 : Compact1) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BRegular1 : Regular1) (BRegular2 : Regular2) :
    ExceptT String IO Normal1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ASM_MESON_TAC, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DISJOINT_SYM, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET_TRANS, .. } := D.core4
  let { MONO_IMP, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, EXISTS_CLOSED_IN,
        FORALL_OPEN_IN, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_TOPSPACE, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map,
        .. } := BContMap1
  let { HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { HOMEOMORPHIC_IMP_RETRACTION_MAP, retraction_map, retraction_maps, .. } := BRetraction
  let { CLOSED_IN_COMPACT_SPACE, .. } := BCompact1
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_COMPACT_SETS, hausdorff_space, .. } :=
    BHausdorff1
  let { regular_space, .. } := BRegular1
  let { REGULAR_SPACE_COMPACT_CLOSED_SETS, .. } := BRegular2
  -- @@SCOPE END

  let normal_space ← new_definition
   r"normal_space (top:A topology) <=>
        !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
              ==> ?u v. open_in top u /\ open_in top v /\
                        s SUBSET u /\ t SUBSET v /\
                        DISJOINT u v"

  let NORMAL_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ normal_space top ==> normal_space top'"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [IMP_CONJ] THEN
    REWRITE_TAC [normal_space, retraction_map, retraction_maps,
                 LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r':B->A") THEN REPEAT DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"s:B->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{x | x IN topspace top /\ (r:A->B) x IN s}",
      ← q r"{x | x IN topspace top /\ (r:A->B) x IN t}"]) THEN
    ANTS_TAC THENL
     [REWRITE_TAC [CONJ_ASSOC] THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      CONJ_TAC THEN MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_ELIM_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN topspace top' /\ (r':B->A) x IN u}",
      ← q r"{x | x IN topspace top' /\ (r':B->A) x IN v}"] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      ASM_MESON_TAC [],
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []])

  let HOMEOMORPHIC_NORMAL_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (normal_space top <=> normal_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    ASM_MESON_TAC [NORMAL_SPACE_RETRACTION_MAP_IMAGE,
                   HOMEOMORPHIC_IMP_RETRACTION_MAP])

  let NORMAL_SPACE ← prove
   r"!top:A topology.
      normal_space (top:A topology) <=>
      !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
            ==> ?u. open_in top u /\
                    s SUBSET u /\ DISJOINT t (top closure_of u)"
   (GEN_TAC THEN REWRITE_TAC [normal_space] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN REWRITE_TAC [] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"t:A->bool") THEN
    REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")) THEN STRIP_TAC THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [] THEN FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← SET_RULE (← q
       r"t SUBSET v ==> v INTER c = {} ==> DISJOINT t c"))) THEN
      ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY] THEN ASM SET_TAC [],
      STRIP_TAC THEN EXISTS_TAC (← q r"topspace top DIFF top closure_of u:A->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, CLOSED_IN_CLOSURE_OF] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool"] CLOSURE_OF_SUBSET) THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let NORMAL_SPACE_ALT ← prove
   r"!top:A topology.
      normal_space (top:A topology) <=>
      !s u. closed_in top s /\ open_in top u /\ s SUBSET u
            ==> ?v. open_in top v /\ s SUBSET v /\ top closure_of v SUBSET u"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_OPEN_IN] THEN
    REWRITE_TAC [← SET_RULE (← q
     r"s SUBSET t DIFF u <=> s SUBSET t /\ DISJOINT u s")] THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE, NORMAL_SPACE] THEN
    MESON_TAC [CLOSED_IN_SUBSET, DISJOINT_SYM])

  let NORMAL_SPACE_CLOSURES ← prove
   r"!top:A topology.
        normal_space top <=>
        !s t. s SUBSET topspace top /\ t SUBSET topspace top /\
              DISJOINT (top closure_of s) (top closure_of t)
              ==> ?u v. open_in top u /\
                        open_in top v /\
                        s SUBSET u /\
                        t SUBSET v /\
                        DISJOINT u v"
   (GEN_TAC THEN REWRITE_TAC [normal_space] THEN EQ_TAC THENL
     [DISCH_TAC, METIS_TAC [CLOSURE_OF_CLOSED_IN, CLOSED_IN_SUBSET]] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"top closure_of s:A->bool", ← q r"top closure_of t:A->bool"]) THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSURE_OF] THEN
    ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET_TRANS])

  let NORMAL_SPACE_DISJOINT_CLOSURES ← prove
   r"!top:A topology.
        normal_space top <=>
        !s t. closed_in top s /\ closed_in top t /\ DISJOINT s t
              ==> ?u v. open_in top u /\ open_in top v /\
                        s SUBSET u /\ t SUBSET v /\
                        DISJOINT (top closure_of u) (top closure_of v)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [normal_space] THEN EQ_TAC THENL
     [DISCH_TAC,
      REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
      MATCH_MP_TAC MONO_IMP THEN REWRITE_TAC [] THEN
      REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← SET_RULE (← q
       r"s SUBSET s' /\ t SUBSET t' ==> DISJOINT s' t' ==> DISJOINT s t")) THEN
      ASM_SIMP_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET]] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"s:A->bool", ← q r"topspace top DIFF u:A->bool"]) THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u':A->bool") THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v':A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"!t'. t' INTER s = {} /\ t SUBSET t' ==> DISJOINT s t")) THEN
    EXISTS_TAC (← q r"v':A->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"topspace top DIFF u:A->bool") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let NORMAL_SPACE_DUAL ← prove
   r"!top:A topology.
        normal_space top <=>
        !u v. open_in top u /\ open_in top v /\ u UNION v = topspace top
              ==> ?s t. closed_in top s /\ closed_in top t /\
                        s SUBSET u /\ t SUBSET v /\ s UNION t = topspace top"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [FORALL_OPEN_IN, EXISTS_CLOSED_IN] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, ← GSYM CONJ_ASSOC] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> ~(p /\ q ==> ~r)")] THEN
    SIMP_TAC [OPEN_IN_SUBSET, CLOSED_IN_SUBSET, ← SET_RULE (← q
     r"u SUBSET t /\ v SUBSET t
      ==> (t DIFF u SUBSET t DIFF v <=> v SUBSET u) /\
          (t DIFF u UNION t DIFF v = t <=> DISJOINT u v)")] THEN
    REWRITE_TAC [normal_space] THEN MESON_TAC [])

  let NORMAL_T1_IMP_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        normal_space top /\ t1_space top ==> hausdorff_space top"
   (REWRITE_TAC [T1_SPACE_CLOSED_IN_SING, normal_space, hausdorff_space] THEN
    GEN_TAC THEN STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"{y:A}"]) THEN
    ASM_SIMP_TAC [SING_SUBSET, ← SET_RULE (← q r"DISJOINT {x} {y} <=> ~(x = y)")])

  let NORMAL_T1_EQ_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        normal_space top ==> (t1_space top <=> hausdorff_space top)"
   (MESON_TAC [NORMAL_T1_IMP_HAUSDORFF_SPACE, HAUSDORFF_IMP_T1_SPACE])

  let NORMAL_T1_IMP_REGULAR_SPACE ← prove
   r"!top:A topology.
        normal_space top /\ t1_space top ==> regular_space top"
   (REWRITE_TAC [T1_SPACE_CLOSED_IN_SING, normal_space, regular_space] THEN
    GEN_TAC THEN STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"x:A"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"s:A->bool"]) THEN
    ASM_SIMP_TAC [SING_SUBSET] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM SET_TAC [])

  let COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE ← prove
   r"!top:A topology.
        compact_space top /\ (hausdorff_space top \/ regular_space top)
        ==> normal_space top"
   (REWRITE_TAC [HAUSDORFF_SPACE_COMPACT_SETS,
                 REGULAR_SPACE_COMPACT_CLOSED_SETS] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [normal_space] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE])

  return { normal_space, NORMAL_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_NORMAL_SPACE,
           NORMAL_SPACE, NORMAL_SPACE_ALT, NORMAL_SPACE_CLOSURES, NORMAL_SPACE_DISJOINT_CLOSURES,
           NORMAL_SPACE_DUAL, NORMAL_T1_IMP_HAUSDORFF_SPACE, NORMAL_T1_EQ_HAUSDORFF_SPACE,
           NORMAL_T1_IMP_REGULAR_SPACE, COMPACT_HAUSDORFF_OR_REGULAR_IMP_NORMAL_SPACE }

/- ------------------------------------------------------------------------- -/
/- Normal spaces, continued.  (metric.ml 24187-24394)                        -/
/- ------------------------------------------------------------------------- -/

structure Normal2 where
  NORMAL_SPACE_MTOPOLOGY : thm
  METRIZABLE_IMP_NORMAL_SPACE : thm
  NORMAL_SPACE_DISCRETE_TOPOLOGY : thm
  NORMAL_SPACE_FSIGMAS : thm
  NORMAL_SPACE_FSIGMA_SUBTOPOLOGY : thm
  NORMAL_SPACE_CLOSED_SUBTOPOLOGY : thm
  NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE : thm
  HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE : thm
  HOMEOMORPHIC_HEREDITARILY_NORMAL_SPACE : thm
  HEREDITARILY_NORMAL_SPACE_RETRACTION_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupNormal2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BBases : Bases) (BClosure : Closure) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetractOf : RetractOf) (BSeparated : Separated)
    (BFsigmaGdelta : FsigmaGdelta) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricArith : MetricArithB) (BMetrizable : Metrizable) (BNormal1 : Normal1) :
    ExceptT String IO Normal2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, DISJOINT, EMPTY_UNIONS, EXISTS_IN_GSPEC, EXTENSION, FINITE_IMAGE,
        FINITE_NUMSEG_LE, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INTER_COMM, INTER_UNIONS, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNIONS,
        IN_UNIV, LEFT_IMP_EXISTS_THM, LE_CASES, MONO_EXISTS, MONO_FORALL, NOT_IN_EMPTY,
        .. } := D.core2
  let { REAL_NOT_LT, .. } := D.core3
  let { SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_DIFF, SUBSET_INTER, SUBSET_RESTRICT,
        UNIONS_GSPEC, .. } := D.core4
  let { FORALL_AND_THM, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_IMP_EXISTS_THM,
        .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, CLOSED_IN_UNIONS,
        EXISTS_OPEN_IN, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS,
        .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { HEREDITARILY_SUBTOPOLOGY, hereditarily, .. } := BBases
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } :=
    BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_MAP_IMP_SUBSET_TOPSPACE, CLOSED_MAP_RESTRICTION, closed_map, .. } :=
    BOpenClosed1
  let { HOMEOMORPHIC_IMP_CLOSED_MAP, HOMEOMORPHIC_IMP_CONTINUOUS_MAP,
        HOMEOMORPHIC_IMP_SURJECTIVE_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { SEPARATED_IN_CLOSED_SETS, SEPARATED_IN_SUBTOPOLOGY, separated_in, .. } := BSeparated
  let { CLOSED_IMP_FSIGMA_IN, FSIGMA_IN_ASCENDING, FSIGMA_IN_FSIGMA_SUBTOPOLOGY,
        FSIGMA_IN_SUBSET, .. } := BFsigmaGdelta
  let { CENTRE_IN_MBALL, mball, .. } := BMetricSpace
  let { OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { FORALL_METRIZABLE_SPACE, METRIZABLE_SPACE_DISCRETE_TOPOLOGY, .. } := BMetrizable
  let { normal_space, .. } := BNormal1
  -- @@SCOPE END

  let NORMAL_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. normal_space(mtopology m)"
   (GEN_TAC THEN REWRITE_TAC [normal_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN STRIP_TAC THEN
    MP_TAC (← ISPEC (← q r"m:A metric") OPEN_IN_MTOPOLOGY) THEN
    DISCH_THEN (fun th => tactic_of do pure (
     MP_TAC (← SPEC (← q r"topspace(mtopology m) DIFF t:A->bool") th) THEN
     MP_TAC (← SPEC (← q r"topspace(mtopology m) DIFF s:A->bool") th))) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_TOPSPACE,
                  CLOSED_IN_TOPSPACE, IMP_IMP] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [IMP_IMP, SKOLEM_THM] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY, SUBSET_DIFF] THEN
    SIMP_TAC [SUBSET, mball, IN_DIFF, IN_ELIM_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"d:A->real") (LABEL_TAC "d"))
     (X_CHOOSE_THEN (← q r"e:A->real") (LABEL_TAC "e"))) THEN
    MAP_EVERY EXISTS_TAC
     [← q r"UNIONS {mball m (x:A,e x / &2) | x IN s}",
      ← q r"UNIONS {mball m (x:A,d x / &2) | x IN t}"] THEN
    REWRITE_TAC [← SET_RULE (← q
     r"DISJOINT (UNIONS s) (UNIONS t) <=>
      !u. u IN s ==> !v. v IN t ==> DISJOINT u v")] THEN
    SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_GSPEC, OPEN_IN_MBALL] THEN
    REWRITE_TAC [IN_UNIONS, EXISTS_IN_GSPEC] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN REPEAT DISCH_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [← SET_RULE (← q
     r"DISJOINT s t <=> !x. ~(x IN s /\ x IN t)")]) THEN
    REPEAT (CONJ_TAC THENL
     [ASM_MESON_TAC [REAL_HALF, CENTRE_IN_MBALL, SUBSET], ALL_TAC]) THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(x:A) IN mspace m /\ (y:A) IN mspace m") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    REMOVE_THEN "e" (MP_TAC o SPEC (← q r"x:A")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
    REMOVE_THEN "d" (MP_TAC o SPEC (← q r"y:A")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (MP_TAC o CONJUNCT2)] THEN
    REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"x:A")) (MP_TAC o SPEC (← q r"y:A"))) THEN
    ASM_SIMP_TAC [REAL_NOT_LT, DISJOINT, EXTENSION, NOT_IN_EMPTY, IN_INTER] THEN
    MAP_EVERY UNDISCH_TAC [← q r"(x:A) IN mspace m", ← q r"(y:A) IN mspace m"] THEN
    REWRITE_TAC [mball, IN_ELIM_THM] THEN CONV_TAC (fun t => METRIC_ARITH t))

  let METRIZABLE_IMP_NORMAL_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> normal_space top"
   (REWRITE_TAC [FORALL_METRIZABLE_SPACE, NORMAL_SPACE_MTOPOLOGY])

  let NORMAL_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. normal_space(discrete_topology u)"
   (SIMP_TAC [METRIZABLE_SPACE_DISCRETE_TOPOLOGY,
              METRIZABLE_IMP_NORMAL_SPACE])

  let NORMAL_SPACE_FSIGMAS ← prove
   r"!top:A topology.
        normal_space top <=>
        !s t. fsigma_in top s /\ fsigma_in top t /\ separated_in top s t
              ==> ?u v. open_in top u /\
                        open_in top v /\
                        s SUBSET u /\
                        t SUBSET v /\
                        DISJOINT u v"
   (GEN_TAC THEN REWRITE_TAC [normal_space] THEN EQ_TAC THENL
     [ALL_TAC, METIS_TAC [CLOSED_IMP_FSIGMA_IN, SEPARATED_IN_CLOSED_SETS]] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
    REWRITE_TAC [separated_in] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] FSIGMA_IN_ASCENDING) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] FSIGMA_IN_ASCENDING) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"d:num->A->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP MONO_FORALL o GEN (← q r"n:num") o SPECL
     [← q r"(d:num->A->bool) n", ← q r"top closure_of s:A->bool"]) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP MONO_FORALL o GEN (← q r"n:num") o SPECL
     [← q r"(c:num->A->bool) n", ← q r"top closure_of t:A->bool"]) THEN
    ANTS_TAC THENL
     [ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:num->A->bool", ← q r"u':num->A->bool"] THEN
    STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"v:num->A->bool", ← q r"v':num->A->bool"] THEN
    STRIP_TAC THEN MAP_EVERY EXISTS_TAC
     [← q r"UNIONS {(u:num->A->bool) n DIFF UNIONS {top closure_of (v m) | m <= n} |
               n IN (:num)}",
      ← q r"UNIONS {(v:num->A->bool) n DIFF UNIONS {top closure_of (u m) | m <= n} |
               n IN (:num)}"] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN REPEAT STRIP_TAC THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN
      ASM_REWRITE_TAC [FORALL_IN_GSPEC, CLOSED_IN_CLOSURE_OF] THEN
      ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC FINITE_IMAGE THEN
      REWRITE_TAC [FINITE_NUMSEG_LE],
      ALL_TAC] THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      CONJ_TAC THEN X_GEN_TAC (← q r"x:A") THEN
      DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN FIRST_X_ASSUM
       (fun th => tactic_of do pure (GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← SYM th])) THEN
      REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM, IN_DIFF, IN_UNIV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
      (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:num") (MP_TAC o CONJUNCT2)) THENL
       [MP_TAC (← ISPECL
         [← q r"top:A topology", ← q r"(v':num->A->bool) m", ← q r"(v:num->A->bool) m"]
         OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET),
        MP_TAC (← ISPECL
         [← q r"top:A topology", ← q r"(u':num->A->bool) m", ← q r"(u:num->A->bool) m"]
         OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] CLOSURE_OF_SUBSET)] THEN
      ASM_SIMP_TAC [FSIGMA_IN_SUBSET] THEN ASM SET_TAC [],
      REWRITE_TAC [DISJOINT, INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC] THEN
      REWRITE_TAC [IN_UNIV] THEN MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
      DISJ_CASES_TAC (← SPECL [← q r"m:num", ← q r"n:num"] LE_CASES) THENL
       [ALL_TAC, ONCE_REWRITE_TAC [INTER_COMM]] THEN
      MATCH_MP_TAC (← SET_RULE (← q
         r"u SUBSET u' ==> (u DIFF v') INTER (v DIFF u') = {}")) THEN
      MATCH_MP_TAC (← SET_RULE (← q
       r"(?n. P n /\ s SUBSET t n) ==> s SUBSET UNIONS {t n | P n}"))
      THENL [EXISTS_TAC (← q r"m:num"), EXISTS_TAC (← q r"n:num")] THEN
      ASM_SIMP_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET]])

  let NORMAL_SPACE_FSIGMA_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        normal_space top /\ fsigma_in top s
        ==> normal_space(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [NORMAL_SPACE_FSIGMAS] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [FSIGMA_IN_FSIGMA_SUBTOPOLOGY, SEPARATED_IN_SUBTOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:A->bool", ← q r"u:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"t:A->bool", ← q r"u:A->bool"]) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [SUBSET_INTER] THEN ASM SET_TAC [])

  let NORMAL_SPACE_CLOSED_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        normal_space top /\ closed_in top s
        ==> normal_space (subtopology top s)"
   (MESON_TAC [NORMAL_SPACE_FSIGMA_SUBTOPOLOGY, CLOSED_IMP_FSIGMA_IN])

  let NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\ closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        normal_space top
        ==> normal_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [normal_space, closed_map] THEN STRIP_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"s:B->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{x | x IN topspace top /\ (f:A->B) x IN s}",
      ← q r"{x | x IN topspace top /\ (f:A->B) x IN t}"]) THEN
    ASM_REWRITE_TAC [CONJ_ASSOC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      REWRITE_TAC [← GSYM CONJ_ASSOC, RIGHT_EXISTS_AND_THM] THEN
      REWRITE_TAC [EXISTS_OPEN_IN] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      MAP_EVERY EXISTS_TAC [← q r"IMAGE (f:A->B) u", ← q r"IMAGE (f:A->B) v"] THEN
      ASM_SIMP_TAC [] THEN REPEAT STRIP_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC []])

  let HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        hereditarily normal_space top
        ==> hereditarily normal_space top'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [hereditarily] THEN
    X_GEN_TAC (← q r"t:B->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
     SPEC (← q r"{x | x IN topspace top /\ (f:A->B) x IN t}") o
     GEN_REWRITE_RULE id [hereditarily]) THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE)) THEN
    EXISTS_TAC (← q r"f:A->B") THEN
    ASM_SIMP_TAC [CLOSED_MAP_RESTRICTION] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                  ← GSYM CONJ_ASSOC, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_HEREDITARILY_NORMAL_SPACE ← prove
   r"!(top:A topology) (top':B topology).
      top homeomorphic_space top'
      ==> (hereditarily normal_space top <=> hereditarily normal_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    MESON_TAC [HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE,
               HOMEOMORPHIC_IMP_SURJECTIVE_MAP,
               HOMEOMORPHIC_IMP_CONTINUOUS_MAP,
               HOMEOMORPHIC_IMP_CLOSED_MAP])

  let HEREDITARILY_NORMAL_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ hereditarily normal_space top
        ==> hereditarily normal_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [HEREDITARILY_SUBTOPOLOGY,
                 HOMEOMORPHIC_HEREDITARILY_NORMAL_SPACE])

  return { NORMAL_SPACE_MTOPOLOGY, METRIZABLE_IMP_NORMAL_SPACE, NORMAL_SPACE_DISCRETE_TOPOLOGY,
           NORMAL_SPACE_FSIGMAS, NORMAL_SPACE_FSIGMA_SUBTOPOLOGY,
           NORMAL_SPACE_CLOSED_SUBTOPOLOGY, NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE,
           HEREDITARILY_NORMAL_SPACE_CONTINUOUS_CLOSED_MAP_IMAGE,
           HOMEOMORPHIC_HEREDITARILY_NORMAL_SPACE,
           HEREDITARILY_NORMAL_SPACE_RETRACTION_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Urysohn's lemma.  (metric.ml 24396-24650)                                 -/
/- ------------------------------------------------------------------------- -/

structure Urysohn where
  URYSOHN_LEMMA : thm
  deriving Inhabited

@[nospecialize]
def setupUrysohn [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BContMap2 : ContMap2) (BMetricSpace : MetricSpace) (BRealTop2 : RealTop2)
    (BMetricCont : MetricCont) (BRealCont : RealCont) (BNormal1 : Normal1) :
    ExceptT String IO Urysohn := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        NUM_REDUCE_CONV, REAL_RAT_REDUCE_CONV, .. } := D
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core1
  let { INF, INF_LE_ELEMENT, IN_DIFF, IN_ELIM_THM, IN_INSERT, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MONO_FORALL, NOT_INSERT_EMPTY, .. } := D.core2
  let { REAL_INF_BOUNDS, REAL_LE_ADDR, REAL_LE_ANTISYM, REAL_LE_INF, REAL_LE_LDIV_EQ,
        REAL_LE_MUL, REAL_LE_RDIV_EQ, REAL_LE_REFL, REAL_LT_01, REAL_LT_POW2, REAL_MUL_LID,
        REAL_MUL_LZERO, REAL_NOT_LE, REAL_NOT_LT, REAL_OF_NUM_LE, REAL_OF_NUM_POW, REAL_POS,
        .. } := D.core3
  let { REAL_SUB_LE, REAL_SUB_LT, SUBSET, SUBSET_TRANS, real_min, .. } := D.core4
  let { CONTRAPOS_THM, FORALL_AND_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, REAL_HALF, RECURSION_ON_DYADIC_FRACTIONS, .. } := D.misc
  let { PADIC_RATIONAL_APPROXIMATION_STRADDLE_POS,
        PADIC_RATIONAL_APPROXIMATION_STRADDLE_POS_LE, .. } := D.lib
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { IN_MBALL, .. } := BMetricSpace
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { CONTINUOUS_MAP_TO_METRIC, .. } := BMetricCont
  let { CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_CONST, CONTINUOUS_MAP_REAL_LMUL, .. } :=
    BRealCont
  let { NORMAL_SPACE_ALT, .. } := BNormal1
  -- @@SCOPE END

  let URYSOHN_LEMMA ← prove
   r"!(top:A topology) s t a b.
        a <= b /\ normal_space top /\
        closed_in top s /\ closed_in top t /\ DISJOINT s t
        ==> ?f. continuous_map
                    (top,subtopology euclideanreal (real_interval[a,b])) f /\
                (!x. x IN s ==> f x = a) /\
                (!x. x IN t ==> f x = b)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?f. continuous_map
           (top,subtopology euclideanreal (real_interval[&0,&1])) (f:A->real) /\
           (!x. x IN s ==> f x = &0) /\
           (!x. x IN t ==> f x = &1)")
    MP_TAC THENL
     [UNDISCH_THEN (← q r"a:real <= b") (K ALL_TAC : thm → tactic),
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:A->real") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"\x. a + (b - a) * (f:A->real) x") THEN
      ASM_SIMP_TAC [] THEN CONJ_TAC THENL [ALL_TAC, REAL_ARITH_TAC] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_REAL_ADD, CONTINUOUS_MAP_REAL_LMUL,
                    CONTINUOUS_MAP_REAL_CONST] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_REAL_INTERVAL, REAL_LE_ADDR] THEN
      REWRITE_TAC [← REAL_ARITH (← q
        r"a + (b - a) * y <= b <=> &0 <= (b - a) * (&1 - y)")] THEN
      ASM_SIMP_TAC [REAL_LE_MUL, REAL_SUB_LE]] THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"s:A->bool", ← q r"topspace top DIFF t:A->bool"] o
      REWRITE_RULE [NORMAL_SPACE_ALT]) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
    ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET u DIFF t <=> s SUBSET u /\ DISJOINT s t"),
                  CLOSED_IN_SUBSET] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?g:real->A->bool.
          g(&0) = u /\ g(&1) = topspace top DIFF t /\
          !x y. x IN {&k / &2 pow n | k <= 2 EXP n} /\
                y IN {&k / &2 pow n | k <= 2 EXP n} /\
                x < y
                ==> open_in top (g x) /\ open_in top (g y) /\
                    top closure_of (g x) SUBSET (g y)")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC RECURSION_ON_DYADIC_FRACTIONS THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET u DIFF t <=> s SUBSET u /\ DISJOINT s t"),
                    CLOSED_IN_SUBSET] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [CLOSURE_OF_SUBSET, OPEN_IN_SUBSET, SUBSET_TRANS],
        ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:A->bool", ← q r"z:A->bool"] THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o SPECL [← q r"top closure_of w:A->bool", ← q r"z:A->bool"] o
        REWRITE_RULE [NORMAL_SPACE_ALT]) THEN
      ASM_SIMP_TAC [CLOSED_IN_CLOSURE_OF] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    ABBREV_TAC (← q r"dint = {&k / &2 pow n | k <= 2 EXP n}") THEN
