  let { CLOSED_IN_MCBALL, IN_MCBALL, OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { EVENTUALLY_ATPOINTOF, TRIVIAL_LIMIT_ATPOINTOF_WITHIN, .. } := BAtPoint
