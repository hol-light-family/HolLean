      REWRITE_TAC [IN_INTER, IN_DELETE] THEN
      STRIP_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
      EXISTS_TAC (← q r"(\n. x):num->A") THEN
      ASM_REWRITE_TAC [LIMIT_CONST, TOPSPACE_MTOPOLOGY],
      REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIMIT_IN_CLOSED_IN) THEN
      MAP_EVERY EXISTS_TAC [← q r"mtopology met:A topology", ← q r"f:num->A"] THEN
      ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF, TRIVIAL_LIMIT_SEQUENTIALLY] THEN
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN GEN_TAC THEN REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_OF_SUBSET_INTER) THEN
      REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN ASM SET_TAC []])

  return { LIMIT_ATPOINTOF_SEQUENTIALLY, LIMIT_ATPOINTOF_SEQUENTIALLY_INJ,
           LIMIT_ATPOINTOF_SEQUENTIALLY_DECREASING, DERIVED_SET_OF_SEQUENTIALLY,
           DERIVED_SET_OF_SEQUENTIALLY_ALT, DERIVED_SET_OF_SEQUENTIALLY_INJ,
           DERIVED_SET_OF_SEQUENTIALLY_INJ_ALT, DERIVED_SET_OF_SEQUENTIALLY_DECREASING,
           DERIVED_SET_OF_SEQUENTIALLY_DECREASING_ALT, CLOSURE_OF_SEQUENTIALLY }

/- ------------------------------------------------------------------------- -/
/- Combining theorems for real limits.  (metric.ml 19968-20164)              -/
/- ------------------------------------------------------------------------- -/

structure RealLim where
  LIMIT_REAL_MUL : thm
  LIMIT_REAL_LMUL : thm
  LIMIT_REAL_LMUL_EQ : thm
  LIMIT_REAL_RMUL : thm
  LIMIT_REAL_RMUL_EQ : thm
  LIMIT_REAL_NEG : thm
  LIMIT_REAL_NEG_EQ : thm
  LIMIT_REAL_ADD : thm
  LIMIT_REAL_SUB : thm
  LIMIT_REAL_ABS : thm
  LIMIT_REAL_MAX : thm
  LIMIT_REAL_MIN : thm
  LIMIT_SUM : thm
  LIMIT_PRODUCT : thm
  LIMIT_REAL_INV : thm
  LIMIT_REAL_DIV : thm
  LIMIT_INF : thm
  LIMIT_SUP : thm
  deriving Inhabited

@[nospecialize]
def setupRealLim [HolBase] (D : MetricDeps) (BNets : Nets) (BRealTop2 : RealTop2)
    (BLimits1 : Limits1) (BMetricLim : MetricLim) : ExceptT String IO RealLim := do
  -- @@SCOPE BEGIN
  let { ASM_REAL_ARITH_TAC, REAL_ARITH, REAL_ARITH_TAC, .. } := D
  let { ARITH, ETA_AX, FINITE_IMAGE, FINITE_INDUCT_STRONG, FORALL_IN_INSERT, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INF_INSERT_FINITE, IN_UNIV, MONO_FORALL, PRODUCT_CLAUSES,
        REAL_ABS_DIV, REAL_ABS_MUL, .. } := D.core2
  let { REAL_ABS_NZ, REAL_ENTIRE, REAL_LE_LMUL, REAL_LE_LMUL_EQ, REAL_LT_01, REAL_LT_DIV,
        REAL_LT_LDIV_EQ, REAL_LT_MIN, REAL_LT_MUL, REAL_LT_POW_2, REAL_LT_RDIV_EQ,
        REAL_MUL_ASSOC, REAL_MUL_LID, REAL_MUL_LINV, REAL_MUL_LZERO, REAL_MUL_SYM,
        REAL_NEG_NEG, REAL_OF_NUM_LT, REAL_POW2_ABS, REAL_POW_2, .. } := D.core3
  let { REAL_SUB_INV, SIMPLE_IMAGE, SUM_CLAUSES, SUP_INSERT_FINITE, real_div, real_sub,
        .. } := D.core4
  let { MONO_IMP, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { EVENTUALLY_AND, EVENTUALLY_MONO, .. } := BNets
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_REAL_CONST, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  -- @@SCOPE END

  let LIMIT_REAL_MUL ← prove
   r"!(net:A net) f g l m.
        limit euclideanreal f l net /\ limit euclideanreal g m net
        ==> limit euclideanreal (\x. f x * g x) (l * m) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC
      (← q r"min (&1) (e / &2 / (abs l + abs m + &1))"))) THEN
    ASM_SIMP_TAC [REAL_HALF, REAL_LT_DIV, REAL_LT_MIN, REAL_LT_01, IMP_IMP,
      ← GSYM EVENTUALLY_AND, ← REAL_ARITH (← q r"&0 < abs x + abs y + &1")] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    SIMP_TAC [REAL_LT_RDIV_EQ, ← REAL_ARITH (← q r"&0 < abs x + abs y + &1")] THEN
    X_GEN_TAC (← q r"y:A") THEN
    SIMP_TAC [REAL_LT_RDIV_EQ, ← REAL_ARITH (← q r"&0 < abs x + abs y + &1")] THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REAL_ARITH (← q
     r"abs((f' - f) * g') <= x /\ abs((g' - g) * f) <= y
      ==> x < e / &2 ==> y < e / &2
          ==> abs(f' * g' - f * g) < e")) THEN
    REWRITE_TAC [REAL_ABS_MUL] THEN CONJ_TAC THEN MATCH_MP_TAC REAL_LE_LMUL THEN
    ASM_REAL_ARITH_TAC)

  let LIMIT_REAL_LMUL ← prove
   r"!(net:A net) c f l.
        limit euclideanreal f l net
        ==> limit euclideanreal (\x. c * f x) (c * l) net"
   (SIMP_TAC [LIMIT_REAL_MUL, LIMIT_REAL_CONST])

  let LIMIT_REAL_LMUL_EQ ← prove
   r"!(net:A net) c f l.
        limit euclideanreal (\x. c * f x) (c * l) net <=>
        c = &0 \/ limit euclideanreal f l net"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"c = &0") THEN
    ASM_REWRITE_TAC [REAL_MUL_LZERO, LIMIT_REAL_CONST] THEN
    EQ_TAC THEN REWRITE_TAC [LIMIT_REAL_LMUL] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"inv(c):real") o MATCH_MP LIMIT_REAL_LMUL) THEN
    ASM_SIMP_TAC [REAL_MUL_ASSOC, REAL_MUL_LINV, REAL_MUL_LID, ETA_AX])

  let LIMIT_REAL_RMUL ← prove
   r"!(net:A net) f c l.
        limit euclideanreal f l net
        ==> limit euclideanreal (\x. f x * c) (l * c) net"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIMIT_REAL_LMUL])

  let LIMIT_REAL_RMUL_EQ ← prove
   r"!(net:A net) f c l.
        limit euclideanreal (\x. f x * c) (l * c) net <=>
        c = &0 \/ limit euclideanreal f l net"
   (ONCE_REWRITE_TAC [REAL_MUL_SYM] THEN REWRITE_TAC [LIMIT_REAL_LMUL_EQ])

  let LIMIT_REAL_NEG ← prove
   r"!(net:A net) f l.
        limit euclideanreal f l net
        ==> limit euclideanreal (\x. --(f x)) (--l) net"
   (ONCE_REWRITE_TAC [← REAL_ARITH (← q r"--x:real = --(&1) * x")] THEN
    REWRITE_TAC [LIMIT_REAL_LMUL])

  let LIMIT_REAL_NEG_EQ ← prove
   r"!(net:A net) f l.
        limit euclideanreal (\x. --(f x)) l net <=>
        limit euclideanreal f (--l) net"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP LIMIT_REAL_NEG) THEN
    REWRITE_TAC [REAL_NEG_NEG, ETA_AX])

  let LIMIT_REAL_ADD ← prove
   r"!(net:A net) f g l m.
        limit euclideanreal f l net /\ limit euclideanreal g m net
        ==> limit euclideanreal (\x. f x + g x) (l + m) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"e / &2"))) THEN
    ASM_REWRITE_TAC [REAL_HALF, IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let LIMIT_REAL_SUB ← prove
   r"!(net:A net) f g l m.
        limit euclideanreal f l net /\ limit euclideanreal g m net
        ==> limit euclideanreal (\x. f x - g x) (l - m) net"
   (SIMP_TAC [real_sub, LIMIT_REAL_ADD, LIMIT_REAL_NEG])

  let LIMIT_REAL_ABS ← prove
   r"!(net:A net) f l.
        limit euclideanreal f l net
        ==> limit euclideanreal (\x. abs(f x)) (abs l) net"
   (REPEAT  GEN_TAC THEN REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN MATCH_MP_TAC MONO_IMP THEN
    REWRITE_TAC [] THEN  MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [] THEN REAL_ARITH_TAC)

  let LIMIT_REAL_MAX ← prove
   r"!(net:A net) f g l m.
        limit euclideanreal f l net /\ limit euclideanreal g m net
        ==> limit euclideanreal (\x. max (f x) (g x)) (max l m) net"
   (REWRITE_TAC [← REAL_ARITH (← q r"max a b = inv(&2) * (abs(a - b) + a + b)")] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIMIT_REAL_LMUL THEN
    REPEAT (MATCH_MP_TAC LIMIT_REAL_ADD THEN CONJ_TAC) THEN
    ASM_SIMP_TAC [LIMIT_REAL_SUB, LIMIT_REAL_ABS])

  let LIMIT_REAL_MIN ← prove
   r"!(net:A net) f g l m.
        limit euclideanreal f l net /\ limit euclideanreal g m net
        ==> limit euclideanreal (\x. min (f x) (g x)) (min l m) net"
   (REWRITE_TAC [← REAL_ARITH (← q r"min a b = inv(&2) * ((a + b) - abs(a - b))")] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIMIT_REAL_LMUL THEN
    ASM_SIMP_TAC [LIMIT_REAL_ADD, LIMIT_REAL_SUB, LIMIT_REAL_ABS])

  let LIMIT_SUM ← prove
   r"!net f:A->K->real l k.
        FINITE k /\
        (!i. i IN k ==> limit euclideanreal (\x. f x i) (l i) net)
        ==> limit euclideanreal (\x. sum k (f x)) (sum k l) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SUM_CLAUSES, LIMIT_REAL_CONST, FORALL_IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIMIT_REAL_ADD THEN
    ASM_SIMP_TAC [ETA_AX])

  let LIMIT_PRODUCT ← prove
   r"!net f:A->K->real l k.
        FINITE k /\
        (!i. i IN k ==> limit euclideanreal (\x. f x i) (l i) net)
        ==> limit euclideanreal (\x. product k (f x)) (product k l) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [PRODUCT_CLAUSES, LIMIT_REAL_CONST, FORALL_IN_INSERT] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC LIMIT_REAL_MUL THEN
    ASM_SIMP_TAC [ETA_AX])

  let LIMIT_REAL_INV ← prove
   r"!(net:A net) f l.
        limit euclideanreal f l net /\ ~(l = &0)
        ==> limit euclideanreal (\x. inv(f x)) (inv l) net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
    REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"min (abs l / &2) ((l pow 2 * e) / &2)")) THEN
    ASM_SIMP_TAC [REAL_LT_MIN, REAL_HALF, ← GSYM REAL_ABS_NZ, REAL_LT_MUL,
                  REAL_LT_POW_2] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN GEN_TAC THEN
    SIMP_TAC [REAL_LT_RDIV_EQ, REAL_OF_NUM_LT, ARITH] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← REAL_ARITH (← q
     r"abs(l - x) * &2 < abs l ==> ~(x = &0)"))) THEN
    ASM_SIMP_TAC [REAL_SUB_INV, REAL_ABS_DIV, REAL_LT_LDIV_EQ,
                  ← GSYM REAL_ABS_NZ, REAL_ENTIRE] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP (← REAL_ARITH (← q
     r"abs(x - y) * &2 < b * c ==> c * b <= d * &2 ==> abs(y - x) < d"))) THEN
    ASM_SIMP_TAC [← GSYM REAL_MUL_ASSOC, REAL_LE_LMUL_EQ] THEN
    ONCE_REWRITE_TAC [← GSYM REAL_POW2_ABS] THEN
    REWRITE_TAC [← GSYM REAL_MUL_ASSOC, REAL_POW_2, REAL_ABS_MUL] THEN
    MATCH_MP_TAC REAL_LE_LMUL THEN ASM_REAL_ARITH_TAC)

  let LIMIT_REAL_DIV ← prove
   r"!(net:A net) f g l m.
      limit euclideanreal f l net /\ limit euclideanreal g m net /\ ~(m = &0)
      ==> limit euclideanreal (\x. f x / g x) (l / m) net"
   (SIMP_TAC [real_div, LIMIT_REAL_INV, LIMIT_REAL_MUL])

  let LIMIT_INF ← prove
   r"!net f:A->K->real l k.
        FINITE k /\
        (!i. i IN k ==> limit euclideanreal (\x. f x i) (l i) net)
        ==> limit euclideanreal
              (\x. inf {f x i | i IN k}) (inf {l i | i IN k}) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [SIMPLE_IMAGE, IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [IMAGE_CLAUSES, LIMIT_REAL_CONST] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [FORALL_IN_INSERT] THEN
    DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [INF_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LIMIT_REAL_MIN THEN ASM_REWRITE_TAC [])

  let LIMIT_SUP ← prove
   r"!net f:A->K->real l k.
        FINITE k /\
        (!i. i IN k ==> limit euclideanreal (\x. f x i) (l i) net)
        ==> limit euclideanreal
              (\x. sup {f x i | i IN k}) (sup {l i | i IN k}) net"
   (REPLICATE_TAC 3 GEN_TAC THEN REWRITE_TAC [SIMPLE_IMAGE, IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [IMAGE_CLAUSES, LIMIT_REAL_CONST] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [FORALL_IN_INSERT] THEN
    DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [SUP_INSERT_FINITE, FINITE_IMAGE, IMAGE_EQ_EMPTY] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC LIMIT_REAL_MAX THEN ASM_REWRITE_TAC [])

  return { LIMIT_REAL_MUL, LIMIT_REAL_LMUL, LIMIT_REAL_LMUL_EQ, LIMIT_REAL_RMUL,
           LIMIT_REAL_RMUL_EQ, LIMIT_REAL_NEG, LIMIT_REAL_NEG_EQ, LIMIT_REAL_ADD,
           LIMIT_REAL_SUB, LIMIT_REAL_ABS, LIMIT_REAL_MAX, LIMIT_REAL_MIN, LIMIT_SUM,
           LIMIT_PRODUCT, LIMIT_REAL_INV, LIMIT_REAL_DIV, LIMIT_INF, LIMIT_SUP }

/- ------------------------------------------------------------------------- -/
/- Closure of Borel measurable functions under pointwise limits.             -/
/- (metric.ml 20166-20388)                                                    -/
/- ------------------------------------------------------------------------- -/

structure BorelLim where
  BOREL_MEASURABLE_MAP_LIMIT : thm
  deriving Inhabited

@[nospecialize]
def setupBorelLim [HolBase] (D : MetricDeps) (BTopology : Topology) (BSequential : Sequential)
    (BBorel : Borel) (BBorelMap : BorelMap) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BMetrizable : Metrizable)
    (BLimits1 : Limits1) (BMetricLim : MetricLim) : ExceptT String IO BorelLim := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, REAL_ARITH_TAC, REAL_FIELD,
        .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_UNIV, LE_ADD, LE_ADDR, LE_REFL,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ARCH_INV, REAL_LE_INV2, REAL_LT_INV_EQ, REAL_OF_NUM_ADD, REAL_OF_NUM_LE,
        REAL_OF_NUM_LT, REAL_OF_NUM_MUL, .. } := D.core3
  let { REAL_SUB_LT, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM,
        SUBSET_RESTRICT, SUBSET_UNIV, UNIONS_GSPEC, .. } := D.core4
  let { IN_FROM, .. } := D.misc
  let { COUNTABLE_IMAGE, COUNTABLE_SUBSET, NUM_COUNTABLE, .. } := D.lib
  let { CLOSED_IN_SUBSET, closed_in, .. } := BTopology
  let { EVENTUALLY_SEQUENTIALLY, .. } := BSequential
  let { BOREL_IN_INTERS, BOREL_IN_UNIONS, OPEN_IMP_BOREL_IN, .. } := BBorel
  let { BOREL_MEASURABLE_MAP_CLOSED_IN, borel_measurable_map, .. } := BBorelMap
  let { IN_MBALL, MDIST_REFL, MDIST_SYM, .. } := BMetricSpace
  let { OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { FORALL_METRIZABLE_SPACE, .. } := BMetrizable
  let { LIMIT_SEQUENTIALLY, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  -- @@SCOPE END

  let BOREL_MEASURABLE_MAP_LIMIT ← do
    let mbuf_open_in ← prove
     r"!m (s:A->bool) n.
         closed_in (mtopology m) s
         ==> open_in (mtopology m)
               {z | z IN mspace m /\ ?y. y IN s /\ mdist m (z,y) < inv(&n + &1)}"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN_MTOPOLOGY, SUBSET_RESTRICT] THEN
      REWRITE_TAC [IN_ELIM_THM] THEN X_GEN_TAC (← q r"z:A") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"inv(&n + &1) - mdist m (z:A,y)") THEN
      ASM_REWRITE_TAC [REAL_SUB_LT, SUBSET, IN_MBALL, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"w:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"y:A") THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"(y:A) IN mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
        REPEAT (POP_ASSUM MP_TAC) THEN CONV_TAC (fun t => METRIC_ARITH t)])
    let mbuf_superset ← prove
     r"!m (s:A->bool) n.
         closed_in (mtopology m) s
         ==> s SUBSET
               {z | z IN mspace m /\ ?y. y IN s /\ mdist m (z,y) < inv(&n + &1)}"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
        ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"x:A") THEN
      ASM_SIMP_TAC [MDIST_REFL, REAL_LT_INV_EQ] THEN REAL_ARITH_TAC)
    let mbuf_inters ← prove
     r"!m (s:A->bool).
         closed_in (mtopology m) s
         ==> INTERS {{z | z IN mspace m /\
                          ?y. y IN s /\ mdist m (z,y) < inv(&n + &1)}
                     | n IN (:num)} = s"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
      [REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
       X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
       SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"0")) THEN SIMP_TAC [], ALL_TAC] THEN
       GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~ ~p")] THEN DISCH_TAC THEN
       FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_in]) THEN
       REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
       DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o CONJUNCT2 o CONJUNCT2) THEN
       ASM_REWRITE_TAC [IN_DIFF, TOPSPACE_MTOPOLOGY, SUBSET, IN_MBALL] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
       MP_TAC (← ISPEC (← q r"r:real") REAL_ARCH_INV) THEN ASM_REWRITE_TAC [] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"n:num") STRIP_ASSUME_TAC) THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"n:num")) THEN
       DISCH_THEN (MP_TAC o CONJUNCT2) THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A")) THEN
       SUBGOAL_THEN (← q r"(y:A) IN mspace m") ASSUME_TAC THENL
        [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
         ALL_TAC] THEN
       ASM_REWRITE_TAC [] THEN
       SUBGOAL_THEN (← q r"mdist m (x:A,y) < r") ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"inv(&n + &1) <= inv(&n)") MP_TAC THENL
         [ALL_TAC, ASM_REAL_ARITH_TAC] THEN
        MATCH_MP_TAC REAL_LE_INV2 THEN
        REWRITE_TAC [REAL_OF_NUM_LT, REAL_OF_NUM_LE, REAL_OF_NUM_ADD] THEN
        ASM_ARITH_TAC,
        ASM_REWRITE_TAC []],
       REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
       X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN
       SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
        [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
         ALL_TAC] THEN
       ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"x:A") THEN
       ASM_SIMP_TAC [MDIST_REFL, REAL_LT_INV_EQ] THEN REAL_ARITH_TAC])
    let mlimit_preimage_closed_eq ← prove
     r"!(m:B metric) (f:num->A->B) g (C:B->bool) dom.
         closed_in (mtopology m) C /\
         (!x. x IN dom ==> limit (mtopology m) (\k. f k x) (g x) sequentially)
         ==> {x | x IN dom /\ g x IN C} =
             INTERS {{x | x IN dom /\
                          ?N. !k. N <= k ==>
                                  f k x IN {z | z IN mspace m /\
                                  ?y. y IN C /\ mdist m (z,y) < inv(&n + &1)}}
                     | n IN (:num)}"
     (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
      [REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
       X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN
       ASM_REWRITE_TAC [] THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
       REWRITE_TAC [LIMIT_SEQUENTIALLY] THEN
       DISCH_THEN (MP_TAC o SPEC
         (← q r"{z:B | z IN mspace(m:B metric) /\
                 ?y. y IN C /\ mdist m (z,y) < inv(&n + &1)}") o
         CONJUNCT2) THEN
       ANTS_TAC THENL
       [CONJ_TAC THENL
        [MATCH_MP_TAC mbuf_open_in THEN ASM_REWRITE_TAC [],
         MP_TAC (← ISPECL [← q r"m:B metric", ← q r"C:B->bool", ← q r"n:num"]
           mbuf_superset) THEN
         ASM_REWRITE_TAC [SUBSET] THEN
         DISCH_THEN (MP_TAC o SPEC (← q r"(g:A->B) x")) THEN
         ASM_REWRITE_TAC [IN_ELIM_THM]],
        REWRITE_TAC [IN_ELIM_THM]],
       REWRITE_TAC [SUBSET, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
       X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
       SUBGOAL_THEN (← q r"x:A IN dom") ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"0")) THEN SIMP_TAC [], ALL_TAC] THEN
       ASM_REWRITE_TAC [] THEN
       MP_TAC (← ISPECL [← q r"m:B metric", ← q r"C:B->bool"] mbuf_inters) THEN
       ASM_REWRITE_TAC [] THEN
       DISCH_THEN (fun th => tactic_of do pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
       REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
       X_GEN_TAC (← q r"n:num") THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"2 * n + 1")) THEN
       DISCH_THEN (MP_TAC o CONJUNCT2) THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"N1:num") (LABEL_TAC "buf")) THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
       REWRITE_TAC [LIMIT_METRIC] THEN STRIP_TAC THEN
       FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&(2 * n + 1) + &1)")) THEN ANTS_TAC THENL
        [REWRITE_TAC [REAL_LT_INV_EQ] THEN REAL_ARITH_TAC, ALL_TAC] THEN
       REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"N2:num") (LABEL_TAC "lim")) THEN
       CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
       REMOVE_THEN "buf" (MP_TAC o SPEC (← q r"N1 + N2:num")) THEN
       REWRITE_TAC [LE_ADD] THEN DISCH_THEN (MP_TAC o CONJUNCT2) THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"y:B") STRIP_ASSUME_TAC) THEN
       REMOVE_THEN "lim" (MP_TAC o SPEC (← q r"N1 + N2:num")) THEN
       REWRITE_TAC [LE_ADDR] THEN STRIP_TAC THEN
       EXISTS_TAC (← q r"y:B") THEN ASM_REWRITE_TAC [] THEN
       SUBGOAL_THEN (← q r"(y:B) IN mspace m") ASSUME_TAC THENL
        [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
         ALL_TAC] THEN
       SUBGOAL_THEN
         (← q r"mdist m ((g:A->B) x, y:B) <=
          mdist m (g x, (f:num->A->B) (N1 + N2) x) + mdist m (f (N1 + N2) x, y)")
         ASSUME_TAC THENL
       [MAP_EVERY UNDISCH_TAC
         [← q r"(g:A->B) x IN mspace m", ← q r"(f:num->A->B) (N1 + N2) x IN mspace m",
          ← q r"(y:B) IN mspace m"] THEN
        CONV_TAC (fun t => METRIC_ARITH t),
        ALL_TAC] THEN
       MP_TAC (← ISPECL [← q r"m:B metric", ← q r"(g:A->B) x",
                         ← q r"(f:num->A->B) (N1 + N2) x"]
         MDIST_SYM) THEN
       ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
       SUBGOAL_THEN
         (← q r"inv(&(2 * n + 1) + &1) + inv(&(2 * n + 1) + &1) = inv(&n + &1)")
         ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"&(2 * n + 1) + &1 = &2 * (&n + &1)") SUBST1_TAC THENL
        [REWRITE_TAC [← GSYM REAL_OF_NUM_ADD, ← GSYM REAL_OF_NUM_MUL] THEN
         REAL_ARITH_TAC,
         MATCH_MP_TAC (← REAL_FIELD (← q
           r"&0 < &n + &1
            ==> inv(&2 * (&n + &1)) + inv(&2 * (&n + &1)) = inv(&n + &1)")) THEN
         REAL_ARITH_TAC],
        ASM_REAL_ARITH_TAC]])
    let bmm_eventually_preimage_open ← prove
     r"!top1 m (f:num->A->B) (u:B->bool).
         (!n. borel_measurable_map (top1,mtopology m) (f n)) /\
         open_in (mtopology m) u
         ==> borel_in top1
               {x | x IN topspace top1 /\ ?N. !k. N <= k ==> f k x IN u}"
     (REPEAT STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"{x | x IN topspace top1 /\ ?N. !k. N <= k ==> (f:num->A->B) k x IN u} =
         UNIONS {INTERS {{x | x IN topspace top1 /\ f k x IN u} | k IN from N}
                 | N IN (:num)}")
        SUBST1_TAC THENL
      [REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC, IN_FROM, EXTENSION] THEN
       X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
       EQ_TAC THEN STRIP_TAC THENL
       [EXISTS_TAC (← q r"N:num") THEN ASM_SIMP_TAC [],
        FIRST_ASSUM (MP_TAC o SPEC (← q r"N:num")) THEN REWRITE_TAC [LE_REFL] THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"N:num") THEN
        X_GEN_TAC (← q r"k:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num")) THEN ASM_SIMP_TAC []],
       ALL_TAC] THEN
      MATCH_MP_TAC BOREL_IN_UNIONS THEN CONJ_TAC THENL
      [SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE],
       REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN X_GEN_TAC (← q r"N:num") THEN
       MATCH_MP_TAC BOREL_IN_INTERS THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC COUNTABLE_IMAGE THEN
        MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC (← q r"(:num)") THEN
        REWRITE_TAC [NUM_COUNTABLE, SUBSET_UNIV],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM, IN_FROM] THEN
        MAP_EVERY EXISTS_TAC
         [← q r"{x:A | x IN topspace top1 /\ (f:num->A->B) N x IN u}", ← q r"N:num"] THEN
        REWRITE_TAC [LE_REFL],
        REWRITE_TAC [FORALL_IN_GSPEC, IN_FROM] THEN REPEAT STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:num") o
          REWRITE_RULE [borel_measurable_map]) THEN
        DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN
        MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN ASM_REWRITE_TAC []]])
    prove
     r"!top1 top2 (f:num->A->B) g.
        metrizable_space top2 /\
        (!n. borel_measurable_map (top1,top2) (f n)) /\
        (!x. x IN topspace top1 ==> limit top2 (\k. f k x) (g x) sequentially)
        ==> borel_measurable_map (top1,top2) g"
     (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_METRIZABLE_SPACE] THEN
      MAP_EVERY X_GEN_TAC [← q r"top1:A topology", ← q r"m:B metric", ← q r"f:num->A->B"] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"g:A->B") THEN DISCH_TAC THEN
      REWRITE_TAC [BOREL_MEASURABLE_MAP_CLOSED_IN] THEN CONJ_TAC THENL
       [REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN ASM_MESON_TAC [LIMIT_METRIC],
        ALL_TAC] THEN
      X_GEN_TAC (← q r"C:B->bool") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"m:B metric", ← q r"f:num->A->B", ← q r"g:A->B",
                        ← q r"C:B->bool", ← q r"topspace top1:A->bool"]
        mlimit_preimage_closed_eq) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      MATCH_MP_TAC BOREL_IN_INTERS THEN REPEAT CONJ_TAC THENL
      [SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE],
       REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
       REWRITE_TAC [IN_ELIM_THM, IN_UNIV] THEN
       EXISTS_TAC (← q r"{x:A | x IN topspace top1 /\
                 ?N. !k. N <= k ==>
                         (f:num->A->B) k x IN
                         {z | z IN mspace m /\
                              ?y. y IN C /\ mdist m (z,y) < inv(&0 + &1)}}") THEN
       EXISTS_TAC (← q r"0") THEN REWRITE_TAC [IN_ELIM_THM],
       REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV] THEN X_GEN_TAC (← q r"n:num") THEN
       MP_TAC (← ISPECL
        [← q r"top1:A topology", ← q r"m:B metric", ← q r"f:num->A->B",
         ← q r"{z:B | z IN mspace m /\ ?y. y IN C /\ mdist m (z,y) < inv(&n + &1)}"]
        bmm_eventually_preimage_open) THEN
       ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
       MATCH_MP_TAC mbuf_open_in THEN ASM_REWRITE_TAC []])

  return { BOREL_MEASURABLE_MAP_LIMIT }

/- ------------------------------------------------------------------------- -/
/- Cauchy sequences and complete metric spaces.  (metric.ml 20390-20547)     -/
/- ------------------------------------------------------------------------- -/

structure Cauchy1 where
  cauchy_in : thm
  mcomplete : thm
  MCOMPLETE : thm
  MCOMPLETE_EMPTY_MSPACE : thm
  MCOMPLETE_SUBMETRIC_EMPTY : thm
  CAUCHY_IN_SUBMETRIC : thm
  CAUCHY_IN_CONST : thm
  CONVERGENT_IMP_CAUCHY_IN : thm
  MCOMPLETE_ALT : thm
  CAUCHY_IN_SUBSEQUENCE : thm
  CAUCHY_IN_OFFSET : thm
  CAUCHY_IN_CONVERGENT_SUBSEQUENCE : thm
  CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE : thm
  SEQUENTIALLY_CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE : thm
  deriving Inhabited

@[nospecialize]
def setupCauchy1 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BNets : Nets)
    (BSequential : Sequential) (BMetricSpace : MetricSpace) (BMetricArith : MetricArithB)
    (BLimits1 : Limits1) (BMetricLim : MetricLim) : ExceptT String IO Cauchy1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_ARITH_TAC, ASM_MESON_TAC, MESON_TAC, SET_TAC,
        INTRO_TAC, HYP_TAC, .. } := D
  let { ADD_SYM, .. } := D.core1
  let { INTER_ACI, INTER_EMPTY, INTER_SUBSET, IN_INTER, LEFT_IMP_EXISTS_THM, LE_ADD, LE_REFL,
        LE_TRANS, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { o_DEF, o_THM, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { CLAIM_TAC, .. } := BTactics
  let { EVENTUALLY_TRUE, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { MDIST_REFL, SUBMETRIC, submetric, .. } := BMetricSpace
  let { METRIC_ARITH, .. } := BMetricArith
  let { LIMIT_SEQUENTIALLY_OFFSET_REV, .. } := BLimits1
  let { LIMIT_IN_CLOSED_IN, LIMIT_IN_MSPACE, LIMIT_METRIC, LIMIT_SUBMETRIC_IFF,
        METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED, .. } := BMetricLim
  -- @@SCOPE END

  let cauchy_in ← new_definition
    r"!m:A metric s:num->A.
     cauchy_in m s <=>
     (!n. s n IN mspace m) /\
     (!e. &0 < e
          ==> (?N. !n n'. N <= n /\ N <= n'
                          ==> mdist m (s n,s n') < e))"

  let mcomplete ← new_definition
    r"!m:A metric.
     mcomplete m <=>
     (!s. cauchy_in m s ==> ?x. limit (mtopology m) s x sequentially)"

  let MCOMPLETE ← prove
   r"!m:A metric.
        mcomplete m <=>
        !s. eventually (\n. s n IN mspace m) sequentially /\
            (!e. &0 < e
                 ==> ?N. !n n'. N <= n /\ N <= n' ==> mdist m (s n,s n') < e)
            ==> ?x. limit (mtopology m) s x sequentially"
   (GEN_TAC THEN REWRITE_TAC [mcomplete, cauchy_in] THEN EQ_TAC THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"s:num->A") THEN STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [EVENTUALLY_SEQUENTIALLY]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(s:num->A) o (\n. N + n)")) THEN
      ASM_SIMP_TAC [o_DEF, LE_ADD] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [← ARITH_RULE (← q r"M:num <= n ==> M <= N + n")],
        MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
        REWRITE_TAC [LIMIT_SEQUENTIALLY_OFFSET_REV]],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [EVENTUALLY_TRUE]])

  let MCOMPLETE_EMPTY_MSPACE ← prove
   r"!m:A metric. mspace m = {} ==> mcomplete m"
   (SIMP_TAC [mcomplete, cauchy_in, NOT_IN_EMPTY])

  let MCOMPLETE_SUBMETRIC_EMPTY ← prove
   r"!m:A metric. mcomplete(submetric m {})"
   (SIMP_TAC [MCOMPLETE_EMPTY_MSPACE, SUBMETRIC, INTER_EMPTY])

  let CAUCHY_IN_SUBMETRIC ← prove
   r"!m s x:num->A.
    cauchy_in (submetric m s) x <=> (!n. x n IN s) /\ cauchy_in m x"
   (REWRITE_TAC [cauchy_in, SUBMETRIC, IN_INTER] THEN MESON_TAC [])

  let CAUCHY_IN_CONST ← prove
   r"!m a:A. cauchy_in m (\n. a) <=> a IN mspace m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy_in] THEN
    ASM_CASES_TAC (← q r"(a:A) IN mspace m") THEN ASM_SIMP_TAC [MDIST_REFL])

  let CONVERGENT_IMP_CAUCHY_IN ← prove
   r"!m x l:A. (!n. x n IN mspace m) /\ limit (mtopology m) x l sequentially
             ==> cauchy_in m x"
   (REPEAT GEN_TAC THEN SIMP_TAC [LIMIT_METRIC, cauchy_in] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"p:num"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (fun th => tactic_of do pure (
      MP_TAC (← SPEC (← q r"n:num") th) THEN MP_TAC (← SPEC (← q r"p:num") th))) THEN
    ASM_REWRITE_TAC [] THEN UNDISCH_TAC (← q r"(l:A) IN mspace m") THEN
    SUBGOAL_THEN (← q r"(x:num->A) n IN mspace m /\ x p IN mspace m") MP_TAC THENL
     [ASM_REWRITE_TAC [], CONV_TAC (fun t => METRIC_ARITH t)])

  let MCOMPLETE_ALT ← prove
   r"!m:A metric.
        mcomplete m <=>
        !s. cauchy_in m s <=>
            (!n. s n IN mspace m) /\
            ?x. limit (mtopology m) s x sequentially"
   (MESON_TAC [CONVERGENT_IMP_CAUCHY_IN, mcomplete, cauchy_in])

  let CAUCHY_IN_SUBSEQUENCE ← prove
   r"!m (x:num->A) r.
        (!m n. m < n ==> r m < r n) /\ cauchy_in m x
        ==> cauchy_in m (x o r)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy_in, o_DEF] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [MONOTONE_BIGGER, LE_TRANS])

  let CAUCHY_IN_OFFSET ← prove
   r"!m a x:num->A.
        (!n. n < a ==> x n IN mspace m) /\ cauchy_in m (\n. x(a + n))
        ==> cauchy_in m x"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy_in] THEN STRIP_TAC THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [← ARITH_RULE (← q r"n:num < a \/ n = a + (n - a)")], ALL_TAC] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"a + N:num") THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m - a:num", ← q r"n - a:num"]) THEN
    ANTS_TAC THENL [ASM_ARITH_TAC, MATCH_MP_TAC EQ_IMP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    BINOP_TAC THEN AP_TERM_TAC THEN ASM_ARITH_TAC)

  let CAUCHY_IN_CONVERGENT_SUBSEQUENCE ← prove
   r"!m r a x:num->A.
        cauchy_in m x /\
        (!m n. m < n ==> r m < r n) /\
        limit (mtopology m) (x o r) a sequentially
        ==> limit (mtopology m) x a sequentially"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [LIMIT_METRIC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMIT_METRIC]) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"e:real") THEN
    DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [cauchy_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &2"))) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF, LEFT_IMP_EXISTS_THM, EVENTUALLY_SEQUENTIALLY] THEN
    X_GEN_TAC (← q r"M:num") THEN ASM_REWRITE_TAC [o_THM] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"MAX ((r:num->num) M) N") THEN X_GEN_TAC (← q r"n:num") THEN
    REWRITE_TAC [← ARITH_RULE (← q r"MAX M N <= n <=> M <= n /\ N <= n")] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"(r:num->num) n"]) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [LE_TRANS, MONOTONE_BIGGER, LE_REFL], ALL_TAC] THEN
    MATCH_MP_TAC (← METRIC_ARITH (← q
     r"x IN mspace m /\ y IN mspace m /\ z IN mspace m /\
      mdist m (y:A,z) < e / &2
      ==> mdist m (x,y) < e / &2 ==> mdist m (x,z) < e")) THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [LE_TRANS, MONOTONE_BIGGER])

  let CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE ← prove
   r"!m s:A->bool. closed_in (mtopology m) s /\ mcomplete m
                 ==> mcomplete (submetric m s)"
   (INTRO_TAC "!m s; cl cp" THEN REWRITE_TAC [mcomplete] THEN
    INTRO_TAC "![a]; a" THEN CLAIM_TAC "cy'" (← q r"cauchy_in m (a:num->A)") THENL
    [REMOVE_THEN "a" MP_TAC THEN SIMP_TAC [cauchy_in, SUBMETRIC, IN_INTER],
     HYP_TAC "cp" (fun th => do pure (← GSYM (← REWRITE_RULE [mcomplete] th))) THEN
     HYP REWRITE_TAC "cp" [LIMIT_SUBMETRIC_IFF] THEN
     REMOVE_THEN "cp" (HYP_TAC "cy': @l.l" o MATCH_MP) THEN EXISTS_TAC (← q r"l:A") THEN
     HYP_TAC "a: A cy" (REWRITE_RULE [cauchy_in, SUBMETRIC, IN_INTER]) THEN
     ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN MATCH_MP_TAC
       (← ISPECL [← q r"sequentially", ← q r"mtopology(m:A metric)"] LIMIT_IN_CLOSED_IN) THEN
     EXISTS_TAC (← q r"a:num->A") THEN
     ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_TRUE]])

  let SEQUENTIALLY_CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE ← prove
   r"!m s:A->bool.
     mcomplete m /\
     (!x l. (!n. x n IN s) /\ limit (mtopology m) x l sequentially ==> l IN s)
            ==> mcomplete (submetric m s)"
   (INTRO_TAC "!m s; cpl seq" THEN SUBGOAL_THEN
      (← q r"submetric m (s:A->bool) = submetric m (mspace m INTER s)") SUBST1_TAC THENL
    [REWRITE_TAC [submetric, INTER_ACI], ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE THEN
    ASM_REWRITE_TAC [METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED, INTER_SUBSET] THEN
    INTRO_TAC "!a l; a lim" THEN REWRITE_TAC [IN_INTER] THEN CONJ_TAC THENL
    [MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIMIT_IN_MSPACE) THEN
     HYP MESON_TAC "lim" [],
     REMOVE_THEN "seq" MATCH_MP_TAC THEN HYP SET_TAC "a lim" []])

  return { cauchy_in, mcomplete, MCOMPLETE, MCOMPLETE_EMPTY_MSPACE, MCOMPLETE_SUBMETRIC_EMPTY,
           CAUCHY_IN_SUBMETRIC, CAUCHY_IN_CONST, CONVERGENT_IMP_CAUCHY_IN, MCOMPLETE_ALT,
           CAUCHY_IN_SUBSEQUENCE, CAUCHY_IN_OFFSET, CAUCHY_IN_CONVERGENT_SUBSEQUENCE,
           CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, SEQUENTIALLY_CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE }

/- ------------------------------------------------------------------------- -/
/- Interleaving and nested characterizations of completeness.               -/
/- (metric.ml 20549-20707)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Cauchy2 where
  CAUCHY_IN_INTERLEAVING_GEN : thm
  CAUCHY_IN_INTERLEAVING : thm
  MCOMPLETE_NEST : thm
  deriving Inhabited

@[nospecialize]
def setupCauchy2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BNets : Nets) (BSequential : Sequential) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BRealTop2 : RealTop2)
    (BMetricLim : MetricLim) (BCauchy1 : Cauchy1) : ExceptT String IO Cauchy2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, MESON, REAL_ARITH, SET_RULE,
        SET_TAC, .. } := D
  let { ADD1, AND_FORALL_THM, ARITH, ETA_AX, EVEN_ADD, EVEN_EXISTS, EVEN_MULT, EVEN_OR_ODD,
        EXISTS_IN_IMAGE, FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, ODD_EXISTS,
        .. } := D.core2
  let { REAL_LT_IMP_LE, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, o_DEF, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { FROM_MONO, FROM_NONEMPTY, IN_FROM, REAL_HALF, .. } := D.misc
  let { closed_in, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ_EMPTY_GEN, CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO,
        .. } := BClosure
  let { EVENTUALLY_TRUE, .. } := BNets
  let { EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { IN_MBALL, MDIST_POS_LE, MDIST_SYM, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, METRIC_CLOSURE_OF, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { LIMIT_IN_CLOSED_IN, LIMIT_METRIC, LIMIT_METRIC_DIST_NULL, .. } := BMetricLim
  let { CAUCHY_IN_CONST, CAUCHY_IN_SUBSEQUENCE, CONVERGENT_IMP_CAUCHY_IN, cauchy_in,
        mcomplete, .. } := BCauchy1
  -- @@SCOPE END

  let CAUCHY_IN_INTERLEAVING_GEN ← prove
   r"!m x y:num->A.
        cauchy_in m (\n. if EVEN n then x(n DIV 2) else y(n DIV 2)) <=>
        cauchy_in m x /\ cauchy_in m y /\
        limit euclideanreal (\n. mdist m (x n,y n)) (&0) sequentially"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN REPEAT CONJ_TAC THENL
       [FIRST_ASSUM (MP_TAC o SPEC (← q r"\n. 2 * n") o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ_ALT] CAUCHY_IN_SUBSEQUENCE)) THEN
        REWRITE_TAC [o_DEF, ← ARITH_RULE (← q r"(2 * m) DIV 2 = m")] THEN
        REWRITE_TAC [EVEN_MULT, ARITH, ETA_AX] THEN
        DISCH_THEN MATCH_MP_TAC THEN ARITH_TAC,
        FIRST_ASSUM (MP_TAC o SPEC (← q r"\n. 2 * n + 1") o MATCH_MP
         (← REWRITE_RULE [IMP_CONJ_ALT] CAUCHY_IN_SUBSEQUENCE)) THEN
        REWRITE_TAC [o_DEF, ← ARITH_RULE (← q r"(2 * m + 1) DIV 2 = m")] THEN
        REWRITE_TAC [EVEN_MULT, EVEN_ADD, ARITH, ETA_AX] THEN
        DISCH_THEN MATCH_MP_TAC THEN ARITH_TAC,
        REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
        REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [cauchy_in]) THEN
        DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e:real"))) THEN
        ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        STRIP_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"2 * n", ← q r"2 * n + 1"]) THEN
        ANTS_TAC THENL [ASM_ARITH_TAC, ALL_TAC] THEN FIRST_X_ASSUM (MP_TAC o
         MATCH_MP (← MESON [] (← q
           r"(!n. P n) ==> (!n. P(2 * n)) /\ (!n. P(2 * n + 1))"))) THEN
        REWRITE_TAC [EVEN_ADD, EVEN_MULT, ARITH] THEN
        REWRITE_TAC [← ARITH_RULE (← q r"(2 * m) DIV 2 = m /\ (2 * m + 1) DIV 2 = m")] THEN
        SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> abs(&0 - x) = x"), MDIST_POS_LE]],
      REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC] THEN
      REWRITE_TAC [LIMIT_METRIC, REAL_EUCLIDEAN_METRIC, IN_UNIV] THEN
      REWRITE_TAC [cauchy_in] THEN
      ASM_CASES_TAC (← q r"!n. (x:num->A) n IN mspace m") THEN ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"!n. (y:num->A) n IN mspace m") THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [AND_FORALL_THM] THEN DISCH_TAC THEN
      CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
      ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
      ASM_SIMP_TAC [← REAL_ARITH (← q r"&0 <= x ==> abs(&0 - x) = x"), MDIST_POS_LE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"N1:num"))
       (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"N2:num")) (X_CHOOSE_TAC (← q r"N3:num")))) THEN
      EXISTS_TAC (← q r"2 * MAX N1 (MAX N2 N3)") THEN REWRITE_TAC [← ARITH_RULE (← q
       r"2 * MAX M N <= n <=> 2 * M <= n /\ 2 * N <= n")] THEN
      MATCH_MP_TAC (← MESON [EVEN_OR_ODD] (← q
       r"(!m n. P m n ==> P n m) /\
        (!m n. EVEN m /\ EVEN n ==> P m n) /\
        (!m n. ODD m /\ ODD n ==> P m n) /\
        (!m n. EVEN m /\ ODD n ==> P m n)
        ==> (!m n. P m n)")) THEN
      CONJ_TAC THENL [ASM_MESON_TAC [MDIST_SYM], ALL_TAC] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [← MESON [EVEN_EXISTS, ODD_EXISTS, ADD1] (← q
       r"((!n. EVEN n ==> P n) <=> (!n. P(2 * n))) /\
        ((!n. ODD n ==> P n) <=> (!n. P(2 * n + 1)))")] THEN
      REWRITE_TAC [EVEN_MULT, EVEN_ADD, ARITH] THEN
      REWRITE_TAC [← ARITH_RULE (← q r"(2 * m) DIV 2 = m /\ (2 * m + 1) DIV 2 = m")] THEN
      REPEAT CONJ_TAC THEN MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
      REPEAT DISCH_TAC THENL
       [MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x < e / &2 ==> x < e")) THEN
        ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        MATCH_MP_TAC (← REAL_ARITH (← q r"&0 < e /\ x < e / &2 ==> x < e")) THEN
        ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC,
        MATCH_MP_TAC (← METRIC_ARITH (← q
         r"!b. a IN mspace m /\ b IN mspace m /\ c IN mspace m /\
              mdist m (a,b) < e / &2 /\ mdist m (b,c) < e / &2
              ==> mdist m (a:A,c) < e")) THEN
        EXISTS_TAC (← q r"(x:num->A) n") THEN
        ASM_REWRITE_TAC [] THEN CONJ_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_ARITH_TAC]])

  let CAUCHY_IN_INTERLEAVING ← prove
   r"!m x a:A.
         cauchy_in m (\n. if EVEN n then x(n DIV 2) else a) <=>
         (!n. x n IN mspace m) /\ limit (mtopology m) x a sequentially"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CAUCHY_IN_INTERLEAVING_GEN] THEN
    REWRITE_TAC [CAUCHY_IN_CONST] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [LIMIT_METRIC_DIST_NULL] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [cauchy_in]) THEN
      ASM_REWRITE_TAC [EVENTUALLY_TRUE],
      MATCH_MP_TAC CONVERGENT_IMP_CAUCHY_IN THEN
      ONCE_REWRITE_TAC [LIMIT_METRIC_DIST_NULL] THEN
      EXISTS_TAC (← q r"a:A") THEN ASM_REWRITE_TAC []])

  let MCOMPLETE_NEST ← prove
   r"!m:A metric.
      mcomplete m <=>
      !c. (!n. closed_in (mtopology m) (c n)) /\
          (!n. ~(c n = {})) /\
          (!m n. m <= n ==> c n SUBSET c m) /\
          (!e. &0 < e ==> ?n a. c n SUBSET mcball m (a,e))
          ==> ~(INTERS {c n | n IN (:num)} = {})"
   (GEN_TAC THEN REWRITE_TAC [mcomplete] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"!n. ?x. x IN (c:num->A->bool) n") MP_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN ANTS_TAC THENL
       [REWRITE_TAC [cauchy_in] THEN CONJ_TAC THENL
         [ASM_MESON_TAC [closed_in, SUBSET, TOPSPACE_MTOPOLOGY], ALL_TAC] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &3")) THEN
        ASM_REWRITE_TAC [← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
        REWRITE_TAC [SUBSET, IN_MCBALL] THEN DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN
        MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (fun th => tactic_of do pure (
         MP_TAC (← SPEC (← q r"(x:num->A) m") th) THEN
         MP_TAC (← SPEC (← q r"(x:num->A) n") th))) THEN
        REPEAT (ANTS_TAC THENL [ASM SET_TAC [], DISCH_TAC]) THEN
        MATCH_MP_TAC (← METRIC_ARITH (← q
         r"!a x y:A. a IN mspace m /\ x IN mspace m /\ y IN mspace m /\ &0 < e /\
                    mdist m (a,x) <= e / &3 /\ mdist m (a,y) <= e / &3
                    ==> mdist m (x,y) < e")) THEN
        EXISTS_TAC (← q r"a:A") THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN REPEAT STRIP_TAC THEN
        MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIMIT_IN_CLOSED_IN) THEN
        MAP_EVERY EXISTS_TAC [← q r"mtopology m:A topology", ← q r"x:num->A"] THEN
        ASM_REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN
        REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"n:num") THEN
        ASM SET_TAC []],
      X_GEN_TAC (← q r"x:num->A") THEN REWRITE_TAC [cauchy_in] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"\n. mtopology m closure_of (IMAGE (x:num->A) (from n))")) THEN
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN
      SIMP_TAC [CLOSURE_OF_MONO, FROM_MONO, IMAGE_SUBSET] THEN
      REWRITE_TAC [CLOSURE_OF_EQ_EMPTY_GEN, TOPSPACE_MTOPOLOGY] THEN
      ASM_SIMP_TAC [FROM_NONEMPTY, ← SET_RULE (← q
       r"(!n. x n IN s) /\ ~(k = {}) ==> ~DISJOINT s (IMAGE x k)")] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
      ANTS_TAC THENL
       [X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN DISCH_TAC THEN
        EXISTS_TAC (← q r"(x:num->A) N") THEN MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
        REWRITE_TAC [CLOSED_IN_MCBALL, SUBSET, FORALL_IN_IMAGE] THEN
        ASM_SIMP_TAC [IN_FROM, LE_REFL, IN_MCBALL, REAL_LT_IMP_LE],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
        REWRITE_TAC [IN_UNIV, METRIC_CLOSURE_OF, IN_ELIM_THM, FORALL_AND_THM] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_FROM, IN_MBALL] THEN STRIP_TAC THEN
        ASM_REWRITE_TAC [LIMIT_METRIC] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN
        ASM_REWRITE_TAC [REAL_HALF, EVENTUALLY_SEQUENTIALLY] THEN
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN STRIP_TAC THEN
        X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"N:num", ← q r"e / &2"]) THEN
        ASM_REWRITE_TAC [REAL_HALF] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"p:num") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"n:num", ← q r"p:num"]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← METRIC_ARITH (← q
         r"x IN mspace m /\ y IN mspace m /\ l IN mspace m /\
          mdist m(l,y) < e / &2
          ==> mdist m (x,y) < e / &2 ==> mdist m (x,l) < e")) THEN
        ASM_REWRITE_TAC []]])

  return { CAUCHY_IN_INTERLEAVING_GEN, CAUCHY_IN_INTERLEAVING, MCOMPLETE_NEST }

/- ------------------------------------------------------------------------- -/
/- Completeness: singleton nests, FIP, unions and intersections.            -/
/- (metric.ml 20709-20933)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Cauchy3 where
  MCOMPLETE_NEST_SING : thm
  MCOMPLETE_FIP : thm
  MCOMPLETE_FIP_SING : thm
  MCOMPLETE_UNION : thm
  MCOMPLETE_UNIONS : thm
  MCOMPLETE_INTERS : thm
  MCOMPLETE_INTER : thm
  deriving Inhabited

@[nospecialize]
def setupCauchy3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BNets : Nets)
    (BSequential : Sequential) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricArith : MetricArithB) (BLimits1 : Limits1) (BMetricLim : MetricLim)
    (BCauchy1 : Cauchy1) (BCauchy2 : Cauchy2) : ExceptT String IO Cauchy3 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        .. } := D
  let { EXISTS_IN_IMAGE, FINITE_EMPTY, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_INSERT,
        FINITE_NUMSEG_LE, FINITE_UNION, FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INFINITE, INFINITE_ENUMERATE, INSERT_SUBSET,
        INTERS_2, INTERS_ANTIMONO, INTERS_GSPEC, INTERS_INSERT, IN_ELIM_THM, IN_INSERT,
        IN_INTER, IN_INTERS, IN_SING, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, LE_REFL,
        MEMBER_NOT_EMPTY, MONO_EXISTS, MONO_FORALL, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        .. } := D.core2
  let { REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_INV_EQ, .. } := D.core3
  let { SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_INTERS, SUBSET_TRANS,
        SUBSET_UNIV, UNIONS_0, UNIONS_INSERT, num_INFINITE, o_THM, .. } := D.core4
  let { DE_MORGAN_THM, FORALL_AND_THM, NOT_EXISTS_THM, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { FORALL_POS_MONO_1, UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { CLOSED_IN_INTERS, closed_in, .. } := BTopology
  let { EVENTUALLY_TRUE, .. } := BNets
  let { TRIVIAL_LIMIT_SEQUENTIALLY, .. } := BSequential
  let { MDIST_POS_EQ, .. } := BMetricSpace
  let { IN_MCBALL, MCBALL_SUBSET_CONCENTRIC, MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY,
        .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { LIMIT_SUBTOPOLOGY, .. } := BLimits1
  let { LIMIT_METRIC_UNIQUE, .. } := BMetricLim
  let { CAUCHY_IN_CONVERGENT_SUBSEQUENCE, CAUCHY_IN_SUBMETRIC, CAUCHY_IN_SUBSEQUENCE,
        MCOMPLETE_SUBMETRIC_EMPTY, mcomplete, .. } := BCauchy1
  let { MCOMPLETE_NEST, .. } := BCauchy2
  -- @@SCOPE END

  let MCOMPLETE_NEST_SING ← prove
   r"!m:A metric.
      mcomplete m <=>
      !c. (!n. closed_in (mtopology m) (c n)) /\
          (!n. ~(c n = {})) /\
          (!m n. m <= n ==> c n SUBSET c m) /\
          (!e. &0 < e ==> ?n a. c n SUBSET mcball m (a,e))
          ==> ?l. l IN mspace m /\ INTERS {c n | n IN (:num)} = {l}"
   (GEN_TAC THEN REWRITE_TAC [MCOMPLETE_NEST] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"c:num->A->bool") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"l:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [IN_SING] THEN
    SUBGOAL_THEN (← q r"!a:A. a IN INTERS {c n | n IN (:num)} ==> a IN mspace m")
    ASSUME_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [closed_in, TOPSPACE_MTOPOLOGY]) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"l IN s /\ (!l'. ~(l' = l) ==> ~(l' IN s)) ==> s = {l}")) THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"l':A") THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"mdist m (l:A,l') / &3")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MDIST_POS_EQ, ← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")],
      REWRITE_TAC [NOT_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"a:A"] THEN REWRITE_TAC [SUBSET, IN_MCBALL] THEN
    DISCH_THEN (fun th => tactic_of do pure (
      MP_TAC (← SPEC (← q r"l':A") th) THEN MP_TAC (← SPEC (← q r"l:A") th))) THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(p /\ p') /\ ~(q /\ q') ==> (p ==> q) ==> (p' ==> q') ==> F")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~(l':A = l)") THEN CONV_TAC (fun t => METRIC_ARITH t))

  let MCOMPLETE_FIP ← prove
   r"!m:A metric.
        mcomplete m <=>
        !f. (!c. c IN f ==> closed_in (mtopology m) c) /\
            (!e. &0 < e ==> ?c a. c IN f /\ c SUBSET mcball m (a,e)) /\
            (!f'. FINITE f' /\ f' SUBSET f ==> ~(INTERS f' = {}))
            ==> ~(INTERS f = {})"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [MCOMPLETE_NEST_SING],
      REWRITE_TAC [MCOMPLETE_NEST] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (c:num->A->bool) (:num)")) THEN
      ASM_REWRITE_TAC [FORALL_IN_IMAGE, RIGHT_EXISTS_AND_THM] THEN
      ASM_REWRITE_TAC [EXISTS_IN_IMAGE, FORALL_FINITE_SUBSET_IMAGE, IN_UNIV] THEN
      REWRITE_TAC [← GSYM SIMPLE_IMAGE, IN_UNIV, SUBSET_UNIV] THEN
      DISCH_THEN MATCH_MP_TAC THEN X_GEN_TAC (← q r"k:num->bool") THEN
      DISCH_THEN (MP_TAC o ISPEC (← q r"\n:num. n") o
        MATCH_MP UPPER_BOUND_FINITE_SET) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
       r"!t. ~(t = {}) /\ t SUBSET s ==> ~(s = {})")) THEN
      EXISTS_TAC (← q r"(c:num->A->bool) n") THEN
      ASM_SIMP_TAC [SUBSET_INTERS, FORALL_IN_GSPEC]] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"f:(A->bool)->bool") THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
    REWRITE_TAC [REAL_LT_INV_EQ, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [← REAL_ARITH (← q r"&0 < &n + &1"), SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:num->A->bool") THEN REWRITE_TAC [FORALL_AND_THM] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"\n. INTERS {(c:num->A->bool) m | m <= n}")) THEN
    REWRITE_TAC [] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, ← GSYM MEMBER_NOT_EMPTY] THEN
        EXISTS_TAC (← q r"(c:num->A->bool) n") THEN
        MATCH_MP_TAC (← SET_RULE (← q r"P n n ==> c n IN {c m | P m n}")) THEN
        REWRITE_TAC [LE_REFL],
        GEN_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LE, SUBSET] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERS_ANTIMONO THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_ARITH_TAC,
        MATCH_MP_TAC FORALL_POS_MONO_1 THEN CONJ_TAC THENL
         [MESON_TAC [MCBALL_SUBSET_CONCENTRIC, SUBSET_TRANS, REAL_LT_IMP_LE],
          X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN
          FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:A") o SPEC (← q r"n:num")) THEN
          EXISTS_TAC (← q r"a:A") THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
          MATCH_MP_TAC (← SET_RULE (← q
           r"P n n ==> INTERS {c m | P m n} SUBSET c n")) THEN
          REWRITE_TAC [LE_REFL]]],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [← MESON [LE_REFL] (← q
       r"(!n m:num. m <= n ==> P m) <=> (!n. P n)")] THEN
      REWRITE_TAC [← SET_RULE (← q r"{x | P x} = {a} <=> P a /\ (!b. P b ==> a = b)")] THEN
      STRIP_TAC THEN REWRITE_TAC [IN_INTERS] THEN
      X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
     (← q r"\n. t INTER INTERS {(c:num->A->bool) m | m <= n}")) THEN
    REWRITE_TAC [← GSYM INTERS_INSERT] THEN ANTS_TAC THENL
     [REPEAT CONJ_TAC THENL
       [GEN_TAC THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN
        REWRITE_TAC [FORALL_IN_INSERT, NOT_INSERT_EMPTY] THEN
        ASM_SIMP_TAC [FORALL_IN_GSPEC, ← GSYM MEMBER_NOT_EMPTY],
        GEN_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC [FINITE_INSERT, INSERT_SUBSET] THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LE, SUBSET] THEN
        ASM_REWRITE_TAC [FORALL_IN_IMAGE],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERS_ANTIMONO THEN
        MATCH_MP_TAC (← SET_RULE (← q r"s SUBSET t ==> x INSERT s SUBSET x INSERT t")) THEN
        ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN ASM_ARITH_TAC,
        MATCH_MP_TAC FORALL_POS_MONO_1 THEN CONJ_TAC THENL
         [MESON_TAC [MCBALL_SUBSET_CONCENTRIC, SUBSET_TRANS, REAL_LT_IMP_LE],
          X_GEN_TAC (← q r"n:num") THEN EXISTS_TAC (← q r"n:num") THEN
          FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"x:A") o SPEC (← q r"n:num")) THEN
          EXISTS_TAC (← q r"x:A") THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
           (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS)) THEN
          MATCH_MP_TAC (← SET_RULE (← q
           r"P n n ==> INTERS(t INSERT {c m | P m n}) SUBSET c n")) THEN
          REWRITE_TAC [LE_REFL]]],
      REWRITE_TAC [INTERS_INSERT] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
      REWRITE_TAC [IN_UNIV, IN_INTER, FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"b:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      REWRITE_TAC [← MESON [LE_REFL] (← q
       r"(!n m:num. m <= n ==> P m) <=> (!n. P n)")] THEN
      ASM SET_TAC []])

  let MCOMPLETE_FIP_SING ← prove
   r"!m:A metric.
        mcomplete m <=>
        !f. (!c. c IN f ==> closed_in (mtopology m) c) /\
            (!e. &0 < e ==> ?c a. c IN f /\ c SUBSET mcball m (a,e)) /\
            (!f'. FINITE f' /\ f' SUBSET f ==> ~(INTERS f' = {}))
            ==> ?l. l IN mspace m /\ INTERS f = {l}"
   (GEN_TAC THEN REWRITE_TAC [MCOMPLETE_FIP] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"f:(A->bool)->bool") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"l:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [IN_SING] THEN
    ASM_CASES_TAC (← q r"f:(A->bool)->bool = {}") THENL
     [ASM_MESON_TAC [MEMBER_NOT_EMPTY, REAL_LT_01], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!a:A. a IN INTERS f ==> a IN mspace m")
    ASSUME_TAC THENL
     [REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [closed_in, TOPSPACE_MTOPOLOGY]) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC []] THEN
    MATCH_MP_TAC (← SET_RULE (← q
     r"l IN s /\ (!l'. ~(l' = l) ==> ~(l' IN s)) ==> s = {l}")) THEN
    ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"l':A") THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"mdist m (l:A,l') / &3")) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [MDIST_POS_EQ, ← REAL_ARITH (← q r"&0 < e / &3 <=> &0 < e")],
      REWRITE_TAC [NOT_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"a:A"] THEN
    REWRITE_TAC [SUBSET, IN_MCBALL] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => tactic_of do pure (
      MP_TAC (← SPEC (← q r"l':A") th) THEN MP_TAC (← SPEC (← q r"l:A") th))) THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(p /\ p') /\ ~(q /\ q') ==> (p ==> q) ==> (p' ==> q') ==> F")) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~(l':A = l)") THEN CONV_TAC (fun t => METRIC_ARITH t))

  let MCOMPLETE_UNION ← prove
   r"!m s t:A->bool.
        mcomplete(submetric m s) /\ mcomplete(submetric m t)
        ==> mcomplete(submetric m (s UNION t))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mcomplete, CAUCHY_IN_SUBMETRIC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:num->A") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(:num) = {n | (x:num->A) n IN s} UNION {n | (x:num->A) n IN t}")
     (MP_TAC o AP_TERM (← q r"FINITE:(num->bool)->bool"))
    THENL [ASM SET_TAC [], REWRITE_TAC [FINITE_UNION]] THEN
    REWRITE_TAC [← REWRITE_RULE [INFINITE] num_INFINITE] THEN
    REWRITE_TAC [DE_MORGAN_THM, ← GSYM INFINITE] THEN
    DISCH_THEN (DISJ_CASES_THEN (MP_TAC o MATCH_MP INFINITE_ENUMERATE)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THENL
     [FIRST_X_ASSUM (MP_TAC o CONJUNCT1), FIRST_X_ASSUM (MP_TAC o CONJUNCT2)] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"(x:num->A) o (r:num->num)")) THEN
    ASM_SIMP_TAC [CAUCHY_IN_SUBSEQUENCE, o_THM] THEN
    (ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS]) THEN
    X_GEN_TAC (← q r"l:A") THEN
    ASM_REWRITE_TAC [MTOPOLOGY_SUBMETRIC, LIMIT_SUBTOPOLOGY] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [IN_UNION, EVENTUALLY_TRUE] THEN
    MATCH_MP_TAC CAUCHY_IN_CONVERGENT_SUBSEQUENCE THEN ASM_MESON_TAC [])

  let MCOMPLETE_UNIONS ← prove
   r"!m s. FINITE s /\ (!t. t IN s ==> mcomplete(submetric m t))
         ==> mcomplete(submetric m (UNIONS s))"
   (GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_INSERT, UNIONS_0, MCOMPLETE_SUBMETRIC_EMPTY,
                 IN_INSERT] THEN
    MESON_TAC [MCOMPLETE_UNION])

  let MCOMPLETE_INTERS ← prove
   r"!m s:(A->bool)->bool.
        FINITE s /\ ~(s = {}) /\ (!t. t IN s ==> mcomplete(submetric m t))
        ==> mcomplete(submetric m (INTERS s))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [mcomplete, CAUCHY_IN_SUBMETRIC, IN_INTERS] THEN
    REWRITE_TAC [MTOPOLOGY_SUBMETRIC, LIMIT_SUBTOPOLOGY, IN_INTERS] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:num->A") THEN STRIP_TAC THEN
    ASM_SIMP_TAC [EVENTUALLY_TRUE] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"t:A->bool")) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"t:A->bool")) THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (MP_TAC o SPEC (← q r"x:num->A"))] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
    X_GEN_TAC (← q r"l:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"x:num->A")) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"l':A") THEN
    ASM_MESON_TAC [LIMIT_METRIC_UNIQUE, TRIVIAL_LIMIT_SEQUENTIALLY])

  let MCOMPLETE_INTER ← prove
   r"!m s t:A->bool.
        mcomplete(submetric m s) /\ mcomplete(submetric m t)
        ==> mcomplete(submetric m (s INTER t))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_2] THEN
    MATCH_MP_TAC MCOMPLETE_INTERS THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, FINITE_INSERT, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [FINITE_EMPTY, NOT_IN_EMPTY])

  return { MCOMPLETE_NEST_SING, MCOMPLETE_FIP, MCOMPLETE_FIP_SING, MCOMPLETE_UNION,
           MCOMPLETE_UNIONS, MCOMPLETE_INTERS, MCOMPLETE_INTER }

/- ------------------------------------------------------------------------- -/
/- Totally bounded subsets of metric spaces.  (metric.ml 20935-21112)        -/
/- ------------------------------------------------------------------------- -/

structure TotBdd1 where
  totally_bounded_in : thm
  TOTALLY_BOUNDED_IN_EMPTY : thm
  FINITE_IMP_TOTALLY_BOUNDED_IN : thm
  TOTALLY_BOUNDED_IN_IMP_SUBSET : thm
  TOTALLY_BOUNDED_IN_SING : thm
  TOTALLY_BOUNDED_IN_SEQUENTIALLY : thm
  TOTALLY_BOUNDED_IN_SUBSET : thm
  TOTALLY_BOUNDED_IN_UNION : thm
  TOTALLY_BOUNDED_IN_UNIONS : thm
  TOTALLY_BOUNDED_IN_IMP_MBOUNDED : thm
  TOTALLY_BOUNDED_IN_SUBMETRIC : thm
  deriving Inhabited

@[nospecialize]
def setupTotBdd1 [HolBase] (D : MetricDeps) (BMetricSpace : MetricSpace) (BBounded : Bounded)
    (BMetricArith : MetricArithB) (BCauchy1 : Cauchy1) : ExceptT String IO TotBdd1 := do
  -- @@SCOPE BEGIN
  let { new_definition, ARITH_RULE, ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC,
        REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, EMPTY_SUBSET, EXISTS_IN_IMAGE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_NUMSEG_LT, FINITE_SING, FINITE_SUBSET, FINITE_UNION,
        FINITE_UNIONS, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INFINITE, INFINITE_ENUMERATE, IN_ELIM_THM, IN_INSERT,
        LEFT_IMP_EXISTS_THM, LE_REFL, LE_TRANS, MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM,
        NOT_IMP, .. } := D.core2
  let { REAL_LT_01, REAL_LT_INV_EQ, REAL_LT_TRANS, REAL_NOT_LT, .. } := D.core3
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, UNIONS_0,
        UNIONS_GSPEC, UNIONS_INSERT, UNIONS_SUBSET, WF_REC_EXISTS, WF_num, num_INFINITE,
        o_DEF, o_THM, .. } := D.core4
  let { FORALL_POS_MONO_1, MONOTONE_BIGGER, REAL_HALF, SUBSEQUENCE_DIAGONALIZATION_LEMMA,
        .. } := D.misc
  let { CENTRE_IN_MBALL_EQ, IN_MBALL, MBALL_SUBMETRIC, MBALL_SUBSET_MSPACE, .. } :=
    BMetricSpace
  let { MBOUNDED_MBALL, MBOUNDED_SUBSET, MBOUNDED_UNIONS, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { cauchy_in, .. } := BCauchy1
  -- @@SCOPE END

  let totally_bounded_in ← new_definition
   r"totally_bounded_in m (s:A->bool) <=>
        !e. &0 < e
            ==> ?k. FINITE k /\ k SUBSET s /\
                    s SUBSET UNIONS { mball m (x,e) | x IN k}"

  let TOTALLY_BOUNDED_IN_EMPTY ← prove
   r"!m:A metric. totally_bounded_in m {}"
   (REWRITE_TAC [totally_bounded_in, EMPTY_SUBSET, SUBSET_EMPTY] THEN
    MESON_TAC [FINITE_EMPTY])

  let FINITE_IMP_TOTALLY_BOUNDED_IN ← prove
   r"!m s:A->bool. FINITE s /\ s SUBSET mspace m ==> totally_bounded_in m s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN EXISTS_TAC (← q r"s:A->bool") THEN
    ASM_REWRITE_TAC [SUBSET_REFL] THEN MATCH_MP_TAC (← SET_RULE (← q
     r"(!x. x IN s ==> x IN f x) ==> s SUBSET UNIONS {f x | x IN s}")) THEN
    ASM_REWRITE_TAC [CENTRE_IN_MBALL_EQ, ← GSYM SUBSET])

  let TOTALLY_BOUNDED_IN_IMP_SUBSET ← prove
   r"!m s:A->bool. totally_bounded_in m s ==> s SUBSET mspace m"
   (REPEAT GEN_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN REWRITE_TAC [REAL_LT_01] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS)) THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, MBALL_SUBSET_MSPACE])

  let TOTALLY_BOUNDED_IN_SING ← prove
   r"!m x:A. totally_bounded_in m {x} <=> x IN mspace m"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [FINITE_IMP_TOTALLY_BOUNDED_IN, FINITE_SING, SING_SUBSET] THEN
    REWRITE_TAC [← GSYM SING_SUBSET, TOTALLY_BOUNDED_IN_IMP_SUBSET])

  let TOTALLY_BOUNDED_IN_SEQUENTIALLY ← prove
   r"!m s:A->bool.
        totally_bounded_in m s <=>
        s SUBSET mspace m /\
        !x:num->A. (!n. x n IN s)
                   ==> ?r. (!m n. m < n ==> r m < r n) /\
                           cauchy_in m (x o r)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET mspace m") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [TOTALLY_BOUNDED_IN_IMP_SUBSET]] THEN
    REWRITE_TAC [totally_bounded_in] THEN
    REPEAT (STRIP_TAC ORELSE EQ_TAC) THENL
     [ALL_TAC,
      ONCE_REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ Q x /\ R x) <=>
        ~(!x. P x /\ Q x ==> ~R x)")] THEN
      DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"?x. (!n. (x:num->A) n IN s) /\ (!n p. p < n ==> e <= mdist m (x p,x n))")
      STRIP_ASSUME_TAC THENL
       [REWRITE_TAC [AND_FORALL_THM] THEN
        MATCH_MP_TAC (← MATCH_MP WF_REC_EXISTS WF_num) THEN SIMP_TAC [] THEN
        MAP_EVERY X_GEN_TAC [← q r"x:num->A", ← q r"n:num"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (x:num->A) {i | i < n}")) THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG_LT] THEN
        ASM_SIMP_TAC [UNIONS_GSPEC, SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM] THEN
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, EXISTS_IN_IMAGE] THEN
        REWRITE_TAC [IN_ELIM_THM, IN_MBALL, ← GSYM REAL_NOT_LT] THEN ASM SET_TAC [],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real") o CONJUNCT2 o
          GEN_REWRITE_RULE id [cauchy_in]) THEN
        ASM_REWRITE_TAC [o_DEF] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"N:num")
            (MP_TAC o SPECL [← q r"N:num", ← q r"(r:num->num) N + 1"])) THEN
        REWRITE_TAC [LE_REFL, NOT_IMP, REAL_NOT_LT] THEN CONJ_TAC THENL
         [MATCH_MP_TAC (← ARITH_RULE (← q r"n <= m ==> n <= m + 1")) THEN
          ASM_MESON_TAC [MONOTONE_BIGGER],
          FIRST_X_ASSUM MATCH_MP_TAC THEN
          MATCH_MP_TAC (← ARITH_RULE (← q r"n + 1 <= m ==> n < m")) THEN
          ASM_MESON_TAC [MONOTONE_BIGGER]]]] THEN
    MP_TAC (← ISPEC
     (← q r"\(i:num) (r:num->num).
        ?N. !n n'. N <= n /\ N <= n'
                   ==> mdist m (x(r n):A,x(r n')) < inv(&i + &1)")
     SUBSEQUENCE_DIAGONALIZATION_LEMMA) THEN
    REWRITE_TAC [o_DEF] THEN ANTS_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"\n:num. n")) THEN
      ASM_REWRITE_TAC [cauchy_in] THEN MATCH_MP_TAC MONO_EXISTS THEN
      X_GEN_TAC (← q r"r:num->num") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC FORALL_POS_MONO_1 THEN ASM_REWRITE_TAC [] THEN
      MESON_TAC [REAL_LT_TRANS]] THEN
    CONJ_TAC THENL
     [ALL_TAC,
      MAP_EVERY X_GEN_TAC
       [← q r"i:num", ← q r"r:num->num", ← q r"k1:num->num", ← q r"k2:num->num",
        ← q r"M:num"] THEN
      DISCH_THEN (CONJUNCTS_THEN2 (X_CHOOSE_TAC (← q r"N:num")) ASSUME_TAC) THEN
      EXISTS_TAC (← q r"MAX M N") THEN
      ASM_REWRITE_TAC [← ARITH_RULE (← q r"MAX M N <= n <=> M <= n /\ N <= n")] THEN
      ASM_METIS_TAC [LE_TRANS]] THEN
    MAP_EVERY X_GEN_TAC [← q r"d:num", ← q r"r:num->num"] THEN
    ABBREV_TAC (← q r"y:num->A = (x:num->A) o (r:num->num)") THEN
    FIRST_X_ASSUM (MP_TAC o ISPEC (← q r"r:num->num") o MATCH_MP (← MESON [] (← q
     r"(!n. x n IN s) ==> !r. (!n. x(r n) IN s)"))) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUN_EQ_THM]) THEN
    SIMP_TAC [o_THM] THEN DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    SPEC_TAC (← q r"y:num->A", ← q r"x:num->A") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"inv(&d + &1) / &2")) THEN
    REWRITE_TAC [REAL_HALF, REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
    REWRITE_TAC [UNIONS_GSPEC, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"(:num) SUBSET UNIONS {{i | x i IN mball m (z,inv(&d + &1) / &2)} |
                             (z:A) IN k}")
    MP_TAC THENL [REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET)) THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_UNIONS, FINITE_IMAGE] THEN
    REWRITE_TAC [← REWRITE_RULE [INFINITE] num_INFINITE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:A") THEN REWRITE_TAC [← GSYM INFINITE] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"0") THEN
    MAP_EVERY X_GEN_TAC [← q r"p:num", ← q r"q:num"] THEN
    DISCH_THEN (K ALL_TAC : thm → tactic) THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP (← SET_RULE (← q
      r"IMAGE f UNIV = {x | P x} ==> !a. P(f a)"))) THEN
    DISCH_THEN (fun t => tactic_of do pure (
      MP_TAC (← SPEC (← q r"q:num") t) THEN MP_TAC (← SPEC (← q r"p:num") t))) THEN
    REWRITE_TAC [IN_MBALL] THEN
    SUBGOAL_THEN
     (← q r"(z:A) IN mspace m /\ x((r:num->num) p) IN mspace m /\ x(r q) IN mspace m")
    MP_TAC THENL [ASM SET_TAC [], CONV_TAC (fun t => METRIC_ARITH t)])

  let TOTALLY_BOUNDED_IN_SUBSET ← prove
   r"!m s t:A->bool.
     totally_bounded_in m s /\ t SUBSET s ==> totally_bounded_in m t"
   (REWRITE_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY] THEN SET_TAC [])

  let TOTALLY_BOUNDED_IN_UNION ← prove
   r"!m s t:A->bool.
        totally_bounded_in m s /\ totally_bounded_in m t
        ==> totally_bounded_in m (s UNION t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"e:real") THEN ASM_CASES_TAC (← q r"&0 < e") THEN
    ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [UNIONS_GSPEC] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"u UNION v:A->bool") THEN
    ASM_REWRITE_TAC [FINITE_UNION] THEN ASM SET_TAC [])

  let TOTALLY_BOUNDED_IN_UNIONS ← prove
   r"!m f:(A->bool)->bool.
        FINITE f /\ (!s. s IN f ==> totally_bounded_in m s)
        ==> totally_bounded_in m (UNIONS f)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, TOTALLY_BOUNDED_IN_EMPTY, IN_INSERT, UNIONS_INSERT] THEN
    MESON_TAC [TOTALLY_BOUNDED_IN_UNION])

  let TOTALLY_BOUNDED_IN_IMP_MBOUNDED ← prove
   r"!m s:A->bool. totally_bounded_in m s ==> mbounded m s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"&1")) THEN
    REWRITE_TAC [REAL_LT_01, LEFT_IMP_EXISTS_THM] THEN GEN_TAC THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] MBOUNDED_SUBSET) THEN
    MATCH_MP_TAC MBOUNDED_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [MBOUNDED_MBALL])

  let TOTALLY_BOUNDED_IN_SUBMETRIC ← prove
   r"!m s t:A->bool.
        totally_bounded_in m s /\ s SUBSET t
        ==> totally_bounded_in (submetric m t) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    SIMP_TAC [UNIONS_GSPEC, SUBSET, IN_ELIM_THM] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:A->bool") THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    ASM_SIMP_TAC [MBALL_SUBMETRIC] THEN ASM SET_TAC [])

  return { totally_bounded_in, TOTALLY_BOUNDED_IN_EMPTY, FINITE_IMP_TOTALLY_BOUNDED_IN,
           TOTALLY_BOUNDED_IN_IMP_SUBSET, TOTALLY_BOUNDED_IN_SING,
           TOTALLY_BOUNDED_IN_SEQUENTIALLY, TOTALLY_BOUNDED_IN_SUBSET,
           TOTALLY_BOUNDED_IN_UNION, TOTALLY_BOUNDED_IN_UNIONS,
           TOTALLY_BOUNDED_IN_IMP_MBOUNDED, TOTALLY_BOUNDED_IN_SUBMETRIC }

/- ------------------------------------------------------------------------- -/
/- Totally bounded subsets, continued.  (metric.ml 21114-21254)              -/
/- ------------------------------------------------------------------------- -/

structure TotBdd2 where
  TOTALLY_BOUNDED_IN_ABSOLUTE : thm
  TOTALLY_BOUNDED_IN_CLOSURE_OF : thm
  TOTALLY_BOUNDED_IN_CLOSURE_OF_EQ : thm
  MBALL_INTER_DSEPARATED_SINGLETON : thm
  TOTALLY_BOUNDED_IMP_DISCRETE_FINITE : thm
  TOTALLY_BOUNDED_IN_CAUCHY_SEQUENCE : thm
  CAUCHY_IN_IMP_MBOUNDED : thm
  deriving Inhabited

@[nospecialize]
def setupTotBdd2 [HolBase] (D : MetricDeps) (BClosure : Closure) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BCauchy1 : Cauchy1)
    (BTotBdd1 : TotBdd1) : ExceptT String IO TotBdd2 := do
  -- @@SCOPE BEGIN
  let { ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON, MESON_TAC, SET_RULE,
        SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, EXTENSION, FINITE_EMPTY, FINITE_FINITE_UNIONS, FINITE_IMAGE,
        FINITE_NUMSEG, FINITE_SING, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INTER_SUBSET, IN_ELIM_THM, IN_INTER, IN_NUMSEG,
        IN_SING, IN_UNIV, LE_0, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_TRANS, SUBSET_UNIV,
        UNIONS_GSPEC, .. } := D.core4
  let { REAL_HALF, .. } := D.misc
  let { CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBMETRIC, MDIST_SYM, MDIST_TRIANGLE, .. } :=
    BMetricSpace
  let { METRIC_CLOSURE_OF, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { cauchy_in, .. } := BCauchy1
  let { TOTALLY_BOUNDED_IN_IMP_MBOUNDED, TOTALLY_BOUNDED_IN_IMP_SUBSET,
        TOTALLY_BOUNDED_IN_SUBSET, totally_bounded_in, .. } := BTotBdd1
  -- @@SCOPE END

  let TOTALLY_BOUNDED_IN_ABSOLUTE ← prove
   r"!m s:A->bool.
        totally_bounded_in (submetric m s) s <=> totally_bounded_in m s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    SIMP_TAC [UNIONS_GSPEC, SUBSET, IN_ELIM_THM] THEN EQ_TAC THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:A->bool") THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [] THEN
    ONCE_REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
    ASM_SIMP_TAC [MBALL_SUBMETRIC] THEN ASM SET_TAC [])

  let TOTALLY_BOUNDED_IN_CLOSURE_OF ← prove
   r"!m s:A->bool.
        totally_bounded_in m s
        ==> totally_bounded_in m (mtopology m closure_of s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"mspace m INTER s:A->bool") o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] TOTALLY_BOUNDED_IN_SUBSET)) THEN
    REWRITE_TAC [INTER_SUBSET, TOPSPACE_MTOPOLOGY] THEN
    MP_TAC (← SET_RULE (← q r"mspace m INTER (s:A->bool) SUBSET mspace m")) THEN
    SPEC_TAC (← q r"mspace m INTER (s:A->bool)", ← q r"s:A->bool") THEN
    GEN_TAC THEN DISCH_TAC THEN REWRITE_TAC [totally_bounded_in] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:A->bool") THEN
    REWRITE_TAC [UNIONS_GSPEC] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [SUBSET_TRANS, CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET, METRIC_CLOSURE_OF, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e / &2")) THEN ASM_REWRITE_TAC [REAL_HALF] THEN
    REWRITE_TAC [IN_MBALL] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"y:A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:A") o MATCH_MP (← SET_RULE (← q
     r"s SUBSET {x | P x} ==> !a. a IN s ==> P a"))) THEN
    ASM_REWRITE_TAC [IN_MBALL] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"z:A") THEN ASM_CASES_TAC (← q r"(z:A) IN k") THEN ASM_SIMP_TAC [] THEN
    MAP_EVERY UNDISCH_TAC
     [← q r"(x:A) IN mspace m", ← q r"(y:A) IN mspace m",
      ← q r"mdist m (x:A,y) < e / &2"] THEN
    CONV_TAC (fun t => METRIC_ARITH t))

  let TOTALLY_BOUNDED_IN_CLOSURE_OF_EQ ← prove
   r"!m s:A->bool.
        s SUBSET mspace m
        ==> (totally_bounded_in m (mtopology m closure_of s) <=>
             totally_bounded_in m s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [TOTALLY_BOUNDED_IN_CLOSURE_OF] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] TOTALLY_BOUNDED_IN_SUBSET) THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY])

  let MBALL_INTER_DSEPARATED_SINGLETON ← prove
   r"!m:A metric s t d x y.
     t SUBSET s /\ s SUBSET mspace m /\ &0 < d /\
     (!a b. a IN t /\ b IN t /\ ~(a = b) ==> mdist m (a,b) >= d) /\
     x IN mspace m /\ y IN mball m (x, d / &2) INTER t
     ==> mball m (x, d / &2) INTER t = {y}"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [/- mball INTER t SUBSET {y} -/
      REWRITE_TAC [SUBSET, IN_SING] THEN X_GEN_TAC (← q r"z:A") THEN
      REWRITE_TAC [IN_INTER, IN_MBALL] THEN STRIP_TAC THEN
      /- Prove z = y by contradiction: triangle gives mdist(y,z) < d,
         but y,z IN t and y =/= z gives mdist(y,z) >= d -/
      MATCH_MP_TAC (← TAUT (← q r"(~p ==> F) ==> p")) THEN DISCH_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [IN_INTER, IN_MBALL]) THEN
      SUBGOAL_THEN (← q r"mdist m (y:A, z) >= d") MP_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"mdist m (y:A, z) <= mdist m (x,y) + mdist m (x,z)")
        MP_TAC THENL
       [ASM_MESON_TAC [MDIST_TRIANGLE, MDIST_SYM], ASM_REAL_ARITH_TAC],
      /- {y} SUBSET mball INTER t -/
      REWRITE_TAC [SING_SUBSET] THEN ASM_REWRITE_TAC []])

  let TOTALLY_BOUNDED_IMP_DISCRETE_FINITE ← prove
   r"!m:A metric s t d.
     totally_bounded_in m s /\ t SUBSET s /\ &0 < d /\
     (!x y. x IN t /\ y IN t /\ ~(x = y) ==> mdist m (x,y) >= d)
     ==> FINITE t"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    /- Get s SUBSET mspace m from totally_bounded_in -/
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET mspace m") ASSUME_TAC THENL
     [MATCH_MP_TAC TOTALLY_BOUNDED_IN_IMP_SUBSET THEN ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    /- Use totally_bounded_in with e = d/2 to get finite cover -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [totally_bounded_in]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"d / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
    /- t = UNIONS {mball m (x, d/2) INTER t | x IN k} -/
    SUBGOAL_THEN (← q r"t = UNIONS {mball m (x:A, d / &2) INTER t | x IN k}")
      SUBST1_TAC THENL
     [SUBGOAL_THEN (← q r"(t:A->bool) SUBSET UNIONS {mball m (x, d / &2) | x IN k}")
        MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXTENSION, UNIONS_GSPEC, IN_ELIM_THM, IN_INTER, SUBSET] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    /- Apply FINITE_FINITE_UNIONS -/
    SUBGOAL_THEN (← q r"FINITE {mball m (x:A, d / &2) INTER t | x IN k}")
      ASSUME_TAC THENL
     [REWRITE_TAC [SIMPLE_IMAGE] THEN MATCH_MP_TAC FINITE_IMAGE THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FINITE_FINITE_UNIONS th])) THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    /- Each mball(x, d/2) INTER t is empty or singleton, hence finite -/
    ASM_CASES_TAC (← q r"mball m (x:A, d / &2) INTER t = {}") THENL
     [ASM_REWRITE_TAC [FINITE_EMPTY], ALL_TAC] THEN
    /- Non-empty case: use MBALL_INTER_DSEPARATED_SINGLETON -/
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"y:A")) THEN
    SUBGOAL_THEN (← q r"mball m (x:A, d / &2) INTER t = {y}") SUBST1_TAC THENL
     [MATCH_MP_TAC MBALL_INTER_DSEPARATED_SINGLETON THEN
      EXISTS_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      REWRITE_TAC [FINITE_SING]])

  let TOTALLY_BOUNDED_IN_CAUCHY_SEQUENCE ← prove
   r"!m x:num->A.
        cauchy_in m x ==> totally_bounded_in m (IMAGE x (:num))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [cauchy_in, totally_bounded_in] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N:num"))) THEN
    REWRITE_TAC [LE_REFL] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (x:num->A) (0..N)") THEN
    SIMP_TAC [FINITE_IMAGE, FINITE_NUMSEG, IMAGE_SUBSET, SUBSET_UNIV] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_UNIV, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [EXISTS_IN_IMAGE, IN_ELIM_THM, IN_NUMSEG, LE_0] THEN
    X_GEN_TAC (← q r"n:num") THEN ASM_CASES_TAC (← q r"n:num <= N") THENL
     [EXISTS_TAC (← q r"n:num") THEN ASM_SIMP_TAC [CENTRE_IN_MBALL],
      EXISTS_TAC (← q r"N:num") THEN ASM_REWRITE_TAC [IN_MBALL, LE_REFL] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC])

  let CAUCHY_IN_IMP_MBOUNDED ← prove
   r"!m:A metric x. cauchy_in m x ==> mbounded m {x i | i IN (:num)}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SIMPLE_IMAGE] THEN
    ASM_SIMP_TAC [TOTALLY_BOUNDED_IN_IMP_MBOUNDED,
                  TOTALLY_BOUNDED_IN_CAUCHY_SEQUENCE])

  return { TOTALLY_BOUNDED_IN_ABSOLUTE, TOTALLY_BOUNDED_IN_CLOSURE_OF,
           TOTALLY_BOUNDED_IN_CLOSURE_OF_EQ, MBALL_INTER_DSEPARATED_SINGLETON,
           TOTALLY_BOUNDED_IMP_DISCRETE_FINITE, TOTALLY_BOUNDED_IN_CAUCHY_SEQUENCE,
           CAUCHY_IN_IMP_MBOUNDED }

/- ------------------------------------------------------------------------- -/
/- Compactness in metric spaces.  (metric.ml 21256-21451)                    -/
/- ------------------------------------------------------------------------- -/

structure MCompact1 where
  BOLZANO_WEIERSTRASS_PROPERTY : thm
  COMPACT_IN_EQ_BOLZANO_WEIERSTRASS : thm
  COMPACT_IN_SEQUENTIALLY : thm
  COMPACT_IN_IMP_TOTALLY_BOUNDED_IN_EXPLICIT : thm
  LEBESGUE_NUMBER : thm
  deriving Inhabited

@[nospecialize]
def setupMCompact1 [HolBase] (D : MetricDeps) (BCompact1 : Compact1) (BCompact2 : Compact2)
    (BNets : Nets) (BSequential : Sequential) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetricArith : MetricArithB) (BLimits1 : Limits1)
    (BMetricLim : MetricLim) (BCauchy1 : Cauchy1) (BTotBdd1 : TotBdd1) :
    ExceptT String IO MCompact1 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, .. } := D
  let { AND_FORALL_THM, CONJ_ASSOC, EXISTS_IN_IMAGE, FINITE_DELETE, FINITE_IMAGE,
        FINITE_IMAGE_INFINITE, FINITE_INSERT, FINITE_NUMSEG, FINITE_NUMSEG_LT, FINITE_UNIONS,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_IN_UNIONS, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE, INFINITE_ENUMERATE, INJECTIVE_ON_ALT,
        IN_DELETE, IN_ELIM_THM, IN_INTER, IN_NUMSEG, IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM,
        LE_REFL, LT, LT_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP,
        NOT_INSERT_EMPTY, NOT_LT, .. } := D.core2
  let { REAL_LE_INV2, REAL_LE_RADD, REAL_LTE_TRANS, REAL_LT_INF_FINITE, REAL_LT_INV_EQ,
        REAL_LT_REFL, REAL_LT_TRANS, REAL_OF_NUM_LE, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SKOLEM_THM, SUBSET, SUBSET_REFL, UNIONS_GSPEC, UNIONS_IMAGE,
        WF_REC_EXISTS, WF_num, le_c, num_INFINITE, o_DEF, o_THM, .. } := D.core4
  let { EQ_IMP, FORALL_AND_THM, NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, SWAP_EXISTS_THM,
        .. } := D.core5
  let { MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { INFINITE_CARD_LE, .. } := D.lib
  let { COMPACT_IN_SUBSET_TOPSPACE, compact_in, .. } := BCompact1
  let { COMPACT_IN_IMP_BOLZANO_WEIERSTRASS, .. } := BCompact2
  let { EVENTUALLY_AND, EVENTUALLY_HAPPENS, EVENTUALLY_MONO, .. } := BNets
  let { ARCH_EVENTUALLY_INV1, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := BSequential
  let { IN_MBALL, MDIST_0, MDIST_POS_LT, MDIST_SYM, .. } := BMetricSpace
  let { METRIC_DERIVED_SET_OF, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { LIMIT_CONST, .. } := BLimits1
  let { LIMIT_METRIC, .. } := BMetricLim
  let { CONVERGENT_IMP_CAUCHY_IN, .. } := BCauchy1
  let { TOTALLY_BOUNDED_IN_SEQUENTIALLY, totally_bounded_in, .. } := BTotBdd1
  -- @@SCOPE END

  let BOLZANO_WEIERSTRASS_PROPERTY ← prove
   r"!m u s:A->bool.
      s SUBSET u /\ s SUBSET mspace m
      ==> ((!x. (!n:num. x n IN s)
                ==> ?l r. l IN u /\ (!m n. m < n ==> r m < r n) /\
                          limit (mtopology m) (x o r) l sequentially) <=>
           (!t. t SUBSET s /\ INFINITE t
                ==> ~(u INTER (mtopology m) derived_set_of t = {})))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [INFINITE_CARD_LE]) THEN
      REWRITE_TAC [le_c, INJECTIVE_ON_ALT, LEFT_IMP_EXISTS_THM, IN_UNIV] THEN
      X_GEN_TAC (← q r"f:num->A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:num->A")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:num->num") STRIP_ASSUME_TAC) THEN
      ASM_REWRITE_TAC [IN_INTER] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMIT_METRIC]) THEN
      REWRITE_TAC [METRIC_DERIVED_SET_OF, IN_ELIM_THM] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN  X_GEN_TAC (← q r"r:real") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:real")) THEN
      ASM_REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, o_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (fun th => tactic_of do pure (
        MP_TAC (← SPEC (← q r"N + 1") th) THEN MP_TAC (← SPEC (← q r"N:num") th)))) THEN
      REWRITE_TAC [← ARITH_RULE (← q r"N <= N + 1"), LE_REFL] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [] (← q
       r"(?x y. P x /\ P y /\ ~(x = y)) ==> (?z. ~(z = l) /\ P z)")) THEN
      MAP_EVERY EXISTS_TAC [← q r"(f:num->A)(r(N + 1))", ← q r"(f:num->A)(r(N:num))"] THEN
      ASM_SIMP_TAC [IN_MBALL, ← ARITH_RULE (← q r"N < N + 1"),
         ← MESON [LT_REFL] (← q r"x:num < y ==> ~(y = x)")] THEN
      ASM_MESON_TAC [MDIST_SYM, SUBSET],
      ALL_TAC] THEN
    REWRITE_TAC [METRIC_DERIVED_SET_OF, ← GSYM MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"FINITE(IMAGE (x:num->A) (:num))") THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        FINITE_IMAGE_INFINITE)) THEN
      REWRITE_TAC [num_INFINITE, IN_UNIV, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"m:num") THEN
      DISCH_THEN (MP_TAC o MATCH_MP INFINITE_ENUMERATE) THEN
      GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"(x:num->A) m") THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← SET_RULE (← q
       r"IMAGE f UNIV = {x | P x} ==> !n. P(f n)"))) THEN
      ASM_REWRITE_TAC [o_DEF, LIMIT_CONST, TOPSPACE_MTOPOLOGY] THEN
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (x:num->A) (:num)")) THEN
      ASM_REWRITE_TAC [INFINITE, SUBSET, FORALL_IN_IMAGE] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      SUBGOAL_THEN (← q r"!n. (x:num->A) n IN mspace m") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?r:num->num.
                (!n. (!p. p < n ==> r p < r n) /\
                     ~(x(r n) = l) /\ mdist m (x(r n):A,l) < inv(&n + &1))")
      MP_TAC THENL
       [MATCH_MP_TAC (← MATCH_MP WF_REC_EXISTS WF_num) THEN SIMP_TAC [] THEN
        X_GEN_TAC (← q r"r:num->num") THEN
        X_GEN_TAC (← q r"n:num")  THEN  DISCH_THEN (K ALL_TAC : thm → tactic) THEN
        FIRST_ASSUM (MP_TAC o SPEC
         (← q r"inf((inv(&n + &1)) INSERT
          (IMAGE (\k. mdist m (l,(x:num->A) k))
                 (UNIONS (IMAGE (\p. 0..r p) {p | p < n})) DELETE (&0)))")) THEN
        SIMP_TAC [REAL_LT_INF_FINITE, FINITE_INSERT, NOT_INSERT_EMPTY, IN_MBALL,
                  FINITE_DELETE, FINITE_IMAGE, FINITE_UNIONS,
                  FORALL_IN_IMAGE, FINITE_NUMSEG, FINITE_NUMSEG_LT] THEN
        REWRITE_TAC [FORALL_IN_INSERT, REAL_LT_INV_EQ, IN_DELETE, IMP_CONJ] THEN
        REWRITE_TAC [FORALL_IN_IMAGE, FORALL_IN_UNIONS, IMP_CONJ,
                     RIGHT_FORALL_IMP_THM, IN_NUMSEG, IN_ELIM_THM] THEN
        ASM_SIMP_TAC [MDIST_POS_LT, MDIST_0, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> q /\ p /\ r")] THEN
        REWRITE_TAC [EXISTS_IN_IMAGE, IN_UNIV, FORALL_AND_THM] THEN
        MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [← GSYM NOT_LT, ← CONJUNCT1 LT] THEN
        ASM_MESON_TAC [MDIST_SYM, REAL_LT_REFL],
        MATCH_MP_TAC MONO_EXISTS THEN REWRITE_TAC [FORALL_AND_THM] THEN
        X_GEN_TAC (← q r"r:num->num") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [LIMIT_METRIC, o_DEF] THEN
        X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        MATCH_MP_TAC EVENTUALLY_MONO THEN
        EXISTS_TAC (← q r"\n. inv(&n + &1) < e") THEN
        ASM_REWRITE_TAC [ARCH_EVENTUALLY_INV1] THEN X_GEN_TAC (← q r"k:num") THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LT_TRANS) THEN
        ASM_REWRITE_TAC []]])

  let [COMPACT_IN_EQ_BOLZANO_WEIERSTRASS,
       COMPACT_IN_SEQUENTIALLY,
       COMPACT_IN_IMP_TOTALLY_BOUNDED_IN_EXPLICIT,
       LEBESGUE_NUMBER] := CONJUNCTS (← prove
   r"(!m s:A->bool.
        compact_in (mtopology m) s <=>
        s SUBSET mspace m /\
        !t. t SUBSET s /\ INFINITE t
            ==> ~(s INTER (mtopology m) derived_set_of t = {})) /\
   (!m s:A->bool.
        compact_in (mtopology m) s <=>
        s SUBSET mspace m /\
        !x. (!n:num. x n IN s)
            ==> ?l r. l IN s /\ (!m n. m < n ==> r m < r n) /\
                      limit (mtopology m) (x o r) l sequentially) /\
   (!m (s:A->bool) e.
        compact_in (mtopology m) s /\ &0 < e
        ==> ?k. FINITE k /\ k SUBSET s /\
                s SUBSET UNIONS { mball m (x,e) | x IN k}) /\
   (!m (s:A->bool) U.
        compact_in (mtopology m) s /\
        (!u. u IN U ==> open_in (mtopology m) u) /\ s SUBSET UNIONS U
        ==> ?e. &0 < e /\
                !x. x IN s ==> ?u. u IN U /\ mball m (x,e) SUBSET u)"
   (REWRITE_TAC [AND_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:A metric", ← q r"s:A->bool"] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET mspace m") THENL
     [ASM_REWRITE_TAC [],
      ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, TOPSPACE_MTOPOLOGY]] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [IMP_IMP, ← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> q) /\ (q ==> r) /\ (r ==> s) /\ (r ==> t) /\ (s /\ t ==> p)
      ==> (p <=> q) /\ (p <=> r) /\ (p ==> s) /\ (p ==> t)")) THEN
    REPEAT CONJ_TAC THENL
     [MESON_TAC [COMPACT_IN_IMP_BOLZANO_WEIERSTRASS],
      MATCH_MP_TAC EQ_IMP THEN CONV_TAC SYM_CONV THEN
      MATCH_MP_TAC BOLZANO_WEIERSTRASS_PROPERTY THEN
      ASM_REWRITE_TAC [SUBSET_REFL],
      DISCH_TAC THEN ASM_REWRITE_TAC [← GSYM totally_bounded_in] THEN
      ASM_SIMP_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY] THEN
      X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CONVERGENT_IMP_CAUCHY_IN THEN
      REWRITE_TAC [o_THM] THEN ASM SET_TAC [],
      DISCH_TAC THEN X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [← MESON [] (← q r"(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)")] THEN
      GEN_REWRITE_TAC (RAND_CONV o TOP_DEPTH_CONV)
        [NOT_FORALL_THM, RIGHT_IMP_EXISTS_THM, NOT_IMP] THEN
      DISCH_THEN (MP_TAC o GEN (← q r"n:num") o SPEC (← q r"inv(&n + &1)")) THEN
      REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      REWRITE_TAC [SKOLEM_THM, NOT_EXISTS_THM, FORALL_AND_THM] THEN
      X_GEN_TAC (← q r"x:num->A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN
      ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"l:A", ← q r"r:num->num"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?b:A->bool. l IN b /\ b IN U") STRIP_ASSUME_TAC THENL
       [ASM_MESON_TAC [SUBSET, IN_UNIONS], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?e. &0 < e /\ !z:A. z IN mspace m /\ mdist m (z,l) < e ==> z IN b")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:A->bool")) THEN
        ASM_REWRITE_TAC [OPEN_IN_MTOPOLOGY, SUBSET, IN_MBALL] THEN
        DISCH_THEN (CONJUNCTS_THEN (MP_TAC o SPEC (← q r"l:A"))) THEN
        ASM_MESON_TAC [MDIST_SYM],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LIMIT_METRIC]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"e / &2"))) THEN
      MP_TAC (← ISPEC (← q r"e / &2") ARCH_EVENTUALLY_INV1) THEN
      ASM_REWRITE_TAC [REAL_HALF, ← TAUT (← q r"p ==> ~q <=> ~(p /\ q)")] THEN
      REWRITE_TAC [← GSYM EVENTUALLY_AND, o_THM] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, NOT_EXISTS_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(r:num->num) n", ← q r"b:A->bool"]) THEN
      ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN X_GEN_TAC (← q r"z:A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← METRIC_ARITH (← q
        r"mdist m (x,l) < e / &2
         ==> x IN mspace m /\ z IN mspace m /\ l IN mspace m /\
             mdist m (x,z) < e / &2
             ==> mdist m (z,l) < e"))) THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ_ALT] REAL_LT_TRANS)) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← REWRITE_RULE [IMP_CONJ] REAL_LTE_TRANS)) THEN
      MATCH_MP_TAC REAL_LE_INV2 THEN
      REWRITE_TAC [REAL_OF_NUM_LE, REAL_LE_RADD, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
      ASM_MESON_TAC [MONOTONE_BIGGER],
      DISCH_TAC THEN ASM_REWRITE_TAC [compact_in, TOPSPACE_MTOPOLOGY] THEN
      X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM
       (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"U:(A->bool)->bool"))) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"r:real") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM])) THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"f:A->A->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r:real")) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM, UNIONS_GSPEC] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (f:A->A->bool) k") THEN
      ASM_SIMP_TAC [FINITE_IMAGE, SUBSET, UNIONS_IMAGE, FORALL_IN_IMAGE] THEN
      ASM SET_TAC []]))
    | throw "COMPACT_IN_EQ_BOLZANO_WEIERSTRASS: CONJUNCTS"

  return { BOLZANO_WEIERSTRASS_PROPERTY, COMPACT_IN_EQ_BOLZANO_WEIERSTRASS,
           COMPACT_IN_SEQUENTIALLY, COMPACT_IN_IMP_TOTALLY_BOUNDED_IN_EXPLICIT,
           LEBESGUE_NUMBER }

/- ------------------------------------------------------------------------- -/
/- Compactness in metric spaces, continued.  (metric.ml 21453-21607)         -/
/- ------------------------------------------------------------------------- -/

structure MCompact2 where
  COMPACT_SPACE_SEQUENTIALLY : thm
  COMPACT_SPACE_EQ_BOLZANO_WEIERSTRASS : thm
  COMPACT_SPACE_NEST : thm
  COMPACT_IN_IMP_TOTALLY_BOUNDED_IN : thm
  MCOMPLETE_DISCRETE_METRIC : thm
  COMPACT_SPACE_IMP_MCOMPLETE : thm
  COMPACT_IN_IMP_MCOMPLETE : thm
  MCOMPLETE_IMP_CLOSED_IN : thm
  CLOSED_IN_EQ_MCOMPLETE : thm
  COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN : thm
  COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN : thm
  deriving Inhabited

@[nospecialize]
def setupMCompact2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDerived : Derived)
    (BClosure : Closure) (BCompact1 : Compact1) (BCompact2 : Compact2) (BNets : Nets)
    (BSequential : Sequential) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetrizable : Metrizable) (BLimits1 : Limits1) (BMetricLim : MetricLim)
    (BCauchy1 : Cauchy1) (BCauchy2 : Cauchy2) (BTotBdd1 : TotBdd1) (BMCompact1 : MCompact1) :
    ExceptT String IO MCompact2 := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ASM_MESON_TAC, MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, .. } := D
  let { COND_RAND, COND_RATOR, DEPENDENT_CHOICE, EXISTS_IN_IMAGE, FORALL_FINITE_SUBSET_IMAGE,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INTERS_GSPEC, IN_ELIM_THM, IN_INTER, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { REAL_LT_INV_EQ, REAL_LT_TRANS, .. } := D.core3
  let { SIMPLE_IMAGE, SUBSET_INTERS, SUBSET_REFL, SUBSET_UNIV, o_THM, .. } := D.core4
  let { FORALL_AND_THM, SWAP_EXISTS_THM, .. } := D.core5
  let { FROM_MONO, FROM_NONEMPTY, IN_FROM, SUBSEQUENCE_STEPWISE, UPPER_BOUND_FINITE_SET,
        .. } := D.misc
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { derived_set_of, .. } := BDerived
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ_EMPTY_GEN, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET,
        .. } := BClosure
  let { COMPACT_IN_SUBSPACE, compact_space, .. } := BCompact1
  let { COMPACT_SPACE_FIP, .. } := BCompact2
  let { EVENTUALLY_MONO, .. } := BNets
  let { ARCH_EVENTUALLY_INV1, EVENTUALLY_SEQUENTIALLY, TRIVIAL_LIMIT_SEQUENTIALLY,
        .. } := BSequential
  let { IN_MBALL, MDIST_SYM, .. } := BMetricSpace
  let { METRIC_CLOSURE_OF, MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { DISCRETE_METRIC, .. } := BMetrizable
  let { LIMIT_EVENTUALLY, LIMIT_SUBTOPOLOGY, limit, .. } := BLimits1
  let { LIMIT_METRIC, LIMIT_METRIC_UNIQUE, METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED,
        .. } := BMetricLim
  let { CAUCHY_IN_SUBMETRIC, CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE, CONVERGENT_IMP_CAUCHY_IN,
        cauchy_in, mcomplete, .. } := BCauchy1
  let { MCOMPLETE_NEST, .. } := BCauchy2
  let { TOTALLY_BOUNDED_IN_SEQUENTIALLY, TOTALLY_BOUNDED_IN_SUBSET, totally_bounded_in,
        .. } := BTotBdd1
  let { COMPACT_IN_EQ_BOLZANO_WEIERSTRASS, COMPACT_IN_IMP_TOTALLY_BOUNDED_IN_EXPLICIT,
        COMPACT_IN_SEQUENTIALLY, .. } := BMCompact1
  -- @@SCOPE END

  let COMPACT_SPACE_SEQUENTIALLY ← prove
   r"!m:A metric.
        compact_space(mtopology m) <=>
        !x. (!n:num. x n IN mspace m)
            ==> ?l r. l IN mspace m /\
                      (!m n. m < n ==> r m < r n) /\
                      limit (mtopology m) (x o r) l sequentially"
   (REWRITE_TAC [compact_space, COMPACT_IN_SEQUENTIALLY, SUBSET_REFL,
                 TOPSPACE_MTOPOLOGY])

  let COMPACT_SPACE_EQ_BOLZANO_WEIERSTRASS ← prove
   r"!m:A metric.
        compact_space(mtopology m) <=>
        !s. s SUBSET mspace m /\ INFINITE s
            ==> ~(mtopology m derived_set_of s = {})"
   (REWRITE_TAC [compact_space, COMPACT_IN_EQ_BOLZANO_WEIERSTRASS] THEN
    GEN_TAC THEN REWRITE_TAC [TOPSPACE_MTOPOLOGY, SUBSET_REFL] THEN
    REWRITE_TAC [derived_set_of, TOPSPACE_MTOPOLOGY] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_ELIM_THM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let COMPACT_SPACE_NEST ← prove
   r"!m:A metric.
        compact_space(mtopology m) <=>
        !c. (!n. closed_in (mtopology m) (c n)) /\
            (!n. ~(c n = {})) /\
            (!m n. m <= n ==> c n SUBSET c m)
            ==> ~(INTERS {c n | n IN (:num)} = {})"
   (GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [COMPACT_SPACE_FIP] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"c:num->A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (c:num->A->bool) (:num)")) THEN
      ASM_REWRITE_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE] THEN
      DISCH_THEN MATCH_MP_TAC THEN
      REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE, SUBSET_UNIV] THEN
      X_GEN_TAC (← q r"k:num->bool") THEN DISCH_THEN (MP_TAC o ISPEC (← q r"\n:num. n") o
        MATCH_MP UPPER_BOUND_FINITE_SET) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"n:num") THEN
      DISCH_TAC THEN MATCH_MP_TAC (← SET_RULE (← q
       r"!t. ~(t = {}) /\ t SUBSET s ==> ~(s = {})")) THEN
      EXISTS_TAC (← q r"(c:num->A->bool) n") THEN
      ASM_SIMP_TAC [SUBSET_INTERS, FORALL_IN_IMAGE],
      DISCH_TAC THEN REWRITE_TAC [COMPACT_SPACE_SEQUENTIALLY] THEN
      X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"\n. mtopology m closure_of (IMAGE (x:num->A) (from n))")) THEN
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN
      SIMP_TAC [CLOSURE_OF_MONO, FROM_MONO, IMAGE_SUBSET] THEN
      REWRITE_TAC [CLOSURE_OF_EQ_EMPTY_GEN, TOPSPACE_MTOPOLOGY] THEN
      ASM_SIMP_TAC [FROM_NONEMPTY, ← SET_RULE (← q
       r"(!n. x n IN s) /\ ~(k = {}) ==> ~DISJOINT s (IMAGE x k)")] THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"l:A") THEN
      REWRITE_TAC [IN_UNIV, METRIC_CLOSURE_OF, IN_ELIM_THM, FORALL_AND_THM] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, IN_FROM, IN_MBALL] THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"?r. (!n. mdist m (l:A,x(r n)) < inv(&n + &1)) /\
            (!n. (r:num->num) n < r(SUC n))")
      MP_TAC THENL
       [MATCH_MP_TAC DEPENDENT_CHOICE THEN CONJ_TAC THENL
         [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"0", ← q r"&1"]),
          MAP_EVERY X_GEN_TAC [← q r"n:num", ← q r"m:num"] THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o SPECL [← q r"m + 1", ← q r"inv(&(SUC n) + &1)"])] THEN
        REWRITE_TAC [REAL_LT_INV_EQ, ← REAL_ARITH (← q r"&0 < &n + &1")] THEN
        CONV_TAC REAL_RAT_REDUCE_CONV THEN
        REWRITE_TAC [← ARITH_RULE (← q r"m + 1 <= n <=> m < n")] THEN MESON_TAC [],
        MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
        STRIP_TAC THEN ASM_REWRITE_TAC [SUBSEQUENCE_STEPWISE] THEN
        ASM_REWRITE_TAC [LIMIT_METRIC, o_THM] THEN X_GEN_TAC (← q r"e:real") THEN
        GEN_REWRITE_TAC LAND_CONV [← GSYM ARCH_EVENTUALLY_INV1] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
        ASM_MESON_TAC [REAL_LT_TRANS, MDIST_SYM]]])

  let COMPACT_IN_IMP_TOTALLY_BOUNDED_IN ← prove
   r"!m (s:A->bool). compact_in (mtopology m) s ==> totally_bounded_in m s"
   (REWRITE_TAC [totally_bounded_in] THEN
    MESON_TAC [COMPACT_IN_IMP_TOTALLY_BOUNDED_IN_EXPLICIT])

  let MCOMPLETE_DISCRETE_METRIC ← prove
   r"!s:A->bool. mcomplete (discrete_metric s)"
   (GEN_TAC THEN REWRITE_TAC [mcomplete, DISCRETE_METRIC, cauchy_in] THEN
    X_GEN_TAC (← q r"x:num->A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"&1"))) THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN ONCE_REWRITE_TAC [COND_RATOR] THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"N:num") (MP_TAC o SPEC (← q r"N:num"))) THEN
    REWRITE_TAC [LE_REFL, ← TAUT (← q r"(if p then T else F) = p")] THEN
    DISCH_TAC THEN EXISTS_TAC (← q r"(x:num->A) N") THEN
    MATCH_MP_TAC LIMIT_EVENTUALLY THEN
    ASM_REWRITE_TAC [DISCRETE_METRIC, TOPSPACE_MTOPOLOGY] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN ASM_MESON_TAC [])

  let COMPACT_SPACE_IMP_MCOMPLETE ← prove
   r"!m:A metric. compact_space(mtopology m) ==> mcomplete m"
   (SIMP_TAC [COMPACT_SPACE_NEST, MCOMPLETE_NEST])

  let COMPACT_IN_IMP_MCOMPLETE ← prove
   r"!m s:A->bool. compact_in (mtopology m) s ==> mcomplete (submetric m s)"
   (REWRITE_TAC [COMPACT_IN_SUBSPACE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COMPACT_SPACE_IMP_MCOMPLETE THEN
    ASM_REWRITE_TAC [MTOPOLOGY_SUBMETRIC])

  let MCOMPLETE_IMP_CLOSED_IN ← prove
   r"!m s:A->bool.
       mcomplete(submetric m s) /\ s SUBSET mspace m
       ==> closed_in (mtopology m) s"
   (REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [METRIC_CLOSED_IN_IFF_SEQUENTIALLY_CLOSED] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:num->A", ← q r"l:A"] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONVERGENT_IMP_CAUCHY_IN)) THEN
    ANTS_TAC THENL [ASM SET_TAC [], STRIP_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A") o REWRITE_RULE [mcomplete]) THEN
    ASM_REWRITE_TAC [CAUCHY_IN_SUBMETRIC, LIMIT_SUBTOPOLOGY,
                     MTOPOLOGY_SUBMETRIC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"l':A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"l:A = l'") (fun th => ASM_REWRITE_TAC [th]) THEN
    MATCH_MP_TAC (← ISPEC (← q r"sequentially") LIMIT_METRIC_UNIQUE) THEN
    ASM_MESON_TAC [TRIVIAL_LIMIT_SEQUENTIALLY])

  let CLOSED_IN_EQ_MCOMPLETE ← prove
   r"!m s:A->bool.
        mcomplete m
        ==> (closed_in (mtopology m) s <=>
             s SUBSET mspace m /\ mcomplete(submetric m s))"
   (MESON_TAC [MCOMPLETE_IMP_CLOSED_IN, CLOSED_IN_MCOMPLETE_IMP_MCOMPLETE,
               CLOSED_IN_SUBSET, TOPSPACE_MTOPOLOGY])

  let COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN ← prove
   r"!m:A metric.
        compact_space(mtopology m) <=>
        mcomplete m /\ totally_bounded_in m (mspace m)"
   (GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [COMPACT_SPACE_IMP_MCOMPLETE, COMPACT_IN_IMP_TOTALLY_BOUNDED_IN,
              ← GSYM compact_space, ← GSYM TOPSPACE_MTOPOLOGY] THEN
    SIMP_TAC [TOTALLY_BOUNDED_IN_SEQUENTIALLY, SUBSET_REFL] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN STRIP_TAC THEN
    REWRITE_TAC [compact_space, COMPACT_IN_SEQUENTIALLY] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY, SUBSET_REFL] THEN
    X_GEN_TAC (← q r"x:num->A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:num->A")) THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:num->num") THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(x:num->A) o (r:num->num)") o
        REWRITE_RULE [mcomplete]) THEN
    ASM_REWRITE_TAC [limit, TOPSPACE_MTOPOLOGY] THEN MESON_TAC [])

  let COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN ← prove
   r"!m s:A->bool.
      s SUBSET mspace m /\ compact_in (mtopology m) (mtopology m closure_of s)
      ==> totally_bounded_in m s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC TOTALLY_BOUNDED_IN_SUBSET THEN
    EXISTS_TAC (← q r"mtopology m closure_of s:A->bool") THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY] THEN
    MATCH_MP_TAC COMPACT_IN_IMP_TOTALLY_BOUNDED_IN THEN ASM_REWRITE_TAC [])

  return { COMPACT_SPACE_SEQUENTIALLY, COMPACT_SPACE_EQ_BOLZANO_WEIERSTRASS,
           COMPACT_SPACE_NEST, COMPACT_IN_IMP_TOTALLY_BOUNDED_IN, MCOMPLETE_DISCRETE_METRIC,
           COMPACT_SPACE_IMP_MCOMPLETE, COMPACT_IN_IMP_MCOMPLETE, MCOMPLETE_IMP_CLOSED_IN,
           CLOSED_IN_EQ_MCOMPLETE, COMPACT_SPACE_EQ_MCOMPLETE_TOTALLY_BOUNDED_IN,
           COMPACT_CLOSURE_OF_IMP_TOTALLY_BOUNDED_IN }

