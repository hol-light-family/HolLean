    (BTotBdd2 : TotBdd2) (BMCompact1 : MCompact1) (BMCompact2 : MCompact2) :
    ExceptT String IO MCompact3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE, .. } := D
  let { AND_FORALL_THM, EXTENSION, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE_SUPERSET, INTER_COMM, INTER_SUBSET,
        IN_ELIM_THM, IN_INTER, IN_UNION, IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        MONO_EXISTS, MONO_FORALL, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_RADD, REAL_LT_INV_EQ, REAL_LT_TRANS,
        REAL_OF_NUM_LE, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_UNIV, o_THM, .. } := D.core4
  let { FORALL_AND_THM, MONO_IMP, .. } := D.core5
  let { IN_REAL_INTERVAL, MONOTONE_BIGGER, REAL_HALF, .. } := D.misc
  let { DERIVED_SET_OF_MONO, DERIVED_SET_OF_SUBSET_TOPSPACE, .. } := BDerived
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF, CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET,
