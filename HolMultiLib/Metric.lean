  let K_SPACE_SUBTOPOLOGY_OPEN ← prove
   r"!top s:A->bool.
        (!t. t SUBSET topspace top /\ t SUBSET s /\
             (!k. compact_in top k
                  ==> open_in (subtopology top (k INTER s)) (k INTER t))
             ==> open_in (subtopology top s) t) /\
        (!k. compact_in top k
             ==> k_space(subtopology top (k INTER s)))
        ==> k_space(subtopology top s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [K_SPACE_OPEN] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, COMPACT_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE RAND_CONV [K_SPACE_OPEN] o
      SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"c:A->bool")] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY] THEN
    MATCH_MP_TAC EQ_IMP THEN BINOP_TAC THENL [AP_TERM_TAC, ALL_TAC] THEN
    ASM SET_TAC [])

  let K_SPACE_OPEN_SUBTOPOLOGY ← do
    let lemma ← prove
     r"!top (v:A->bool).
            kc_space top /\ compact_space top /\ open_in top v
            ==> k_space(subtopology top v)"
     (REPEAT STRIP_TAC THEN
      REWRITE_TAC [K_SPACE, TOPSPACE_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
                   COMPACT_IN_SUBTOPOLOGY, SUBSET_INTER] THEN
      X_GEN_TAC (← q r"s:A->bool") THEN
      SIMP_TAC [← SET_RULE (← q r"k SUBSET v ==> v INTER k = k")] THEN
      DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (LABEL_TAC "*")) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      SUBGOAL_THEN
       (← q r"s:A->bool = v INTER ((topspace top DIFF v) UNION s)") SUBST1_TAC
      THENL [ASM SET_TAC [], MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED] THEN
      MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN_GEN THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [compact_in, UNION_SUBSET, SUBSET_DIFF] THEN
      X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"compact_in top (topspace top DIFF v:A->bool)") MP_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE],
        REWRITE_TAC [compact_in, SUBSET_DIFF]] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool")) THEN
      ASM_SIMP_TAC [← SET_RULE (← q r"s SUBSET t ==> (t DIFF u) INTER s = s DIFF u")] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V1:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"topspace top DIFF UNIONS V1:A->bool")) THEN
      SUBGOAL_THEN (← q r"open_in top (UNIONS V1:A->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_UNIONS, SUBSET], ALL_TAC] THEN
      ASM_SIMP_TAC [CLOSED_IN_COMPACT_SPACE, CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE,
                    CLOSED_IN_CLOSED_SUBTOPOLOGY] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        CLOSED_IN_COMPACT_SPACE) o CONJUNCT1) THEN
      ASM_REWRITE_TAC [compact_in] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool") o CONJUNCT2) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V2:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"V1 UNION V2:(A->bool)->bool") THEN
      ASM_REWRITE_TAC [FINITE_UNION] THEN ASM SET_TAC [])
    prove
     r"!top s:A->bool.
        (kc_space top \/ hausdorff_space top \/ regular_space top) /\
        k_space top /\ open_in top s
        ==> k_space(subtopology top s)"
     (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
      MATCH_MP_TAC K_SPACE_SUBTOPOLOGY_OPEN THEN CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:A->bool") THEN STRIP_TAC THEN
        MATCH_MP_TAC OPEN_IN_SUBSET_TOPSPACE THEN ASM_REWRITE_TAC [] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id
         [K_SPACE_OPEN]) THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] OPEN_IN_TRANS) THEN
        ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN],
        X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM DISJ_CASES_TAC THENL
         [MP_TAC (← ISPECL [← q r"subtopology top (k:A->bool)", ← q r"k INTER s:A->bool"]
            lemma) THEN
          ASM_SIMP_TAC [KC_SPACE_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
          ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY] THEN
          REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, INTER_ACI],
          MATCH_MP_TAC LOCALLY_COMPACT_IMP_K_SPACE THEN
          ONCE_REWRITE_TAC [← SET_RULE (← q r"k INTER s = k INTER (k INTER s)")] THEN
          ONCE_REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
          MATCH_MP_TAC LOCALLY_COMPACT_SPACE_OPEN_SUBSET THEN
          ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
          ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY,
                        COMPACT_IMP_LOCALLY_COMPACT_SPACE] THEN
          ASM_MESON_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY,
                         REGULAR_SPACE_SUBTOPOLOGY]]])

  let K_KC_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        k_space top /\ kc_space top /\
        (open_in top s \/ closed_in top s)
        ==> k_space(subtopology top s) /\ kc_space(subtopology top s)"
   (MESON_TAC [K_SPACE_OPEN_SUBTOPOLOGY, K_SPACE_CLOSED_SUBTOPOLOGY,
               KC_SPACE_SUBTOPOLOGY])

  return { K_SPACE_CLOSED_SUBTOPOLOGY, K_SPACE_SUBTOPOLOGY, K_SPACE_SUBTOPOLOGY_OPEN,
           K_SPACE_OPEN_SUBTOPOLOGY, K_KC_SPACE_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- k-spaces as quotients, products, maps from k-spaces.                      -/
/- (metric.ml 28218-28319)                                                    -/
/- ------------------------------------------------------------------------- -/

structure KSp3 where
  K_SPACE_AS_QUOTIENT_EXPLICIT : thm
  K_SPACE_AS_QUOTIENT : thm
  K_SPACE_PROD_TOPOLOGY_LEFT : thm
  K_SPACE_PROD_TOPOLOGY_RIGHT : thm
  CONTINUOUS_MAP_FROM_K_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupKSp3 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BQuotient : Quotient) (BSumTop : SumTop) (BCompact1 : Compact1)
    (BLocCompact1 : LocCompact1) (BLocCompact3 : LocCompact3) (BLocCompact4 : LocCompact4)
    (BKSp1 : KSp1) : ExceptT String IO KSp3 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ_ALT, INTER, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_INTER, IN_SING,
        LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_RESTRICT, disjoint_union, o_THM, .. } :=
    D.core4
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET,
        .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_CLOSED_IN, continuous_map, .. } :=
    BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { quotient_map, .. } := BQuotient
  let { OPEN_IN_SUM_TOPOLOGY, TOPSPACE_SUM_TOPOLOGY, .. } := BSumTop
  let { COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_SPACE_SUBTOPOLOGY, .. } :=
    BCompact1
  let { COMPACT_IMP_LOCALLY_COMPACT_SPACE, .. } := BLocCompact1
  let { LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY, .. } := BLocCompact3
  let { LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY, QUOTIENT_MAP_PROD_LEFT, QUOTIENT_MAP_PROD_RIGHT,
        .. } := BLocCompact4
  let { K_SPACE, K_SPACE_ALT, K_SPACE_QUOTIENT_MAP_IMAGE, LOCALLY_COMPACT_IMP_K_SPACE, .. } :=
    BKSp1
  -- @@SCOPE END

  let K_SPACE_AS_QUOTIENT_EXPLICIT ← prove
   r"!top:A topology.
        k_space top <=>
        quotient_map (sum_topology {k | compact_in top k} (subtopology top),
                      top)
                     SND"
   (REWRITE_TAC [quotient_map, OPEN_IN_SUM_TOPOLOGY] THEN
    REWRITE_TAC [IN_ELIM_THM, TOPSPACE_SUM_TOPOLOGY, SUBSET_RESTRICT] THEN
    REWRITE_TAC [disjoint_union, IN_ELIM_PAIR_THM] THEN
    GEN_TAC THEN SIMP_TAC [K_SPACE_ALT, IN_ELIM_THM] THEN
    SIMP_TAC [o_THM, TOPSPACE_SUBTOPOLOGY_SUBSET, COMPACT_IN_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [← GSYM INTER] THEN MATCH_MP_TAC (← TAUT (← q
     r"(p <=> p') /\ q ==> (p <=> q /\ p')")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← SET_RULE (← q r"IMAGE f {x,y | P x y} = {f(x,y) | P x y}")] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN REWRITE_TAC [SUBSET, FORALL_IN_GSPEC] THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"{x:A}", ← q r"x:A"] THEN
    ASM_REWRITE_TAC [COMPACT_IN_SING, IN_SING])

  let K_SPACE_AS_QUOTIENT ← prove
   r"!top:A topology.
        k_space top <=>
        ?q (top':((A->bool)#A)topology).
                locally_compact_space top' /\ quotient_map(top',top) q"
   (GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN MAP_EVERY EXISTS_TAC
       [← q r"SND:(A->bool)#A->A",
        ← q r"sum_topology {k:A->bool | compact_in top k} (subtopology top)"] THEN
      ASM_REWRITE_TAC [← GSYM K_SPACE_AS_QUOTIENT_EXPLICIT] THEN
      REWRITE_TAC [LOCALLY_COMPACT_SPACE_SUM_TOPOLOGY, IN_ELIM_THM] THEN
      SIMP_TAC [COMPACT_IMP_LOCALLY_COMPACT_SPACE, COMPACT_SPACE_SUBTOPOLOGY],
      MESON_TAC [LOCALLY_COMPACT_IMP_K_SPACE, K_SPACE_QUOTIENT_MAP_IMAGE]])

  let K_SPACE_PROD_TOPOLOGY_LEFT ← prove
   r"!(top:A topology) (top':B topology).
        locally_compact_space top /\
        (hausdorff_space top \/ regular_space top) /\
        k_space top'
        ==> k_space(prod_topology top top')"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [K_SPACE_AS_QUOTIENT]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"q:(B->bool)#B->B", ← q r"top'':((B->bool)#B)topology"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"top'':((B->bool)#B)topology", ← q r"top':B topology",
      ← q r"q:(B->bool)#B->B"] QUOTIENT_MAP_PROD_RIGHT) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] K_SPACE_QUOTIENT_MAP_IMAGE) THEN
    MATCH_MP_TAC LOCALLY_COMPACT_IMP_K_SPACE THEN
    ASM_REWRITE_TAC [LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY])

  let K_SPACE_PROD_TOPOLOGY_RIGHT ← prove
   r"!(top:A topology) (top':B topology).
        k_space top /\
        locally_compact_space top' /\
        (hausdorff_space top' \/ regular_space top')
        ==> k_space(prod_topology top top')"
   (REPEAT GEN_TAC THEN DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [K_SPACE_AS_QUOTIENT]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"q:(A->bool)#A->A", ← q r"top'':((A->bool)#A)topology"] THEN
    STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top'':((A->bool)#A)topology", ← q r"top:A topology", ← q r"top':B topology",
      ← q r"q:(A->bool)#A->A"] QUOTIENT_MAP_PROD_LEFT) THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] K_SPACE_QUOTIENT_MAP_IMAGE) THEN
    MATCH_MP_TAC LOCALLY_COMPACT_IMP_K_SPACE THEN
    ASM_REWRITE_TAC [LOCALLY_COMPACT_SPACE_PROD_TOPOLOGY])

  let CONTINUOUS_MAP_FROM_K_SPACE ← prove
   r"!top top' (f:A->B).
        k_space top /\
        (!k. compact_in top k ==> continuous_map(subtopology top k,top') f)
        ==> continuous_map(top,top') f"
   (REWRITE_TAC [K_SPACE] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN
    MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN
    CONJ_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:A}"))) THEN
      ASM_REWRITE_TAC [SING_SUBSET, COMPACT_IN_SING] THEN
      REWRITE_TAC [continuous_map, TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
      DISCH_TAC] THEN
    X_GEN_TAC (← q r"c:B->bool") THEN DISCH_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"k INTER {x | x IN topspace top /\ (f:A->B) x IN c} =
      {x | x IN topspace(subtopology top k) /\ f x IN (IMAGE f k INTER c)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
    EXISTS_TAC (← q r"subtopology top' (IMAGE (f:A->B) k)") THEN
    ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED] THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  return { K_SPACE_AS_QUOTIENT_EXPLICIT, K_SPACE_AS_QUOTIENT, K_SPACE_PROD_TOPOLOGY_LEFT,
           K_SPACE_PROD_TOPOLOGY_RIGHT, CONTINUOUS_MAP_FROM_K_SPACE }

