  let { REAL_LT_TRANS, .. } := D.core3
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SUBSET, SUBSET_INTER, SUBSET_TRANS, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, SWAP_EXISTS_THM, .. } :=
