/- Extending Cauchy continuous functions to the closure.                     -/
/- (metric.ml 32464-32564)                                                    -/
/- ------------------------------------------------------------------------- -/

structure CE1 where
  CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF : thm
  CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_INTERMEDIATE_CLOSURE_OF : thm
  deriving Inhabited

@[nospecialize]
def setupCE1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BClosure : Closure)
    (BContMap2 : ContMap2) (BNets : Nets) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricArith : MetricArithB) (BRegular1 : Regular1) (BLimits1 : Limits1)
    (BMetricLim : MetricLim) (BSeqChar1 : SeqChar1) (BSeqChar2 : SeqChar2)
    (BRealLim : RealLim) (BCauchy1 : Cauchy1) (BCauchy2 : Cauchy2) (BCC1 : CC1) (BCC2 : CC2)
    (BEXT1 : EXT1) : ExceptT String IO CE1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_TAC, .. } := D
  let { COND_ID, COND_RAND, .. } := D.core1
  let { IMP_CONJ_ALT, IMP_IMP, INTER_SUBSET, IN_DELETE, IN_DIFF, IN_ELIM_THM, IN_INTER,
        MONO_EXISTS, .. } := D.core2
  let { REAL_ADD_LID, REAL_ADD_RID, .. } := D.core3
  let { SUBSET_REFL, o_DEF, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO, .. } := BContMap2
  let { ALWAYS_EVENTUALLY, EVENTUALLY_TRUE, .. } := BNets
  let { SUBMETRIC, SUBMETRIC_MSPACE, SUBMETRIC_SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { METRIC_ARITH, .. } := BMetricArith
  let { REGULAR_SPACE_MTOPOLOGY, .. } := BRegular1
  let { limit, .. } := BLimits1
  let { LIMIT_METRIC_DIST_NULL, LIMIT_NULL_REAL_COMPARISON, .. } := BMetricLim
  let { LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN, .. } := BSeqChar1
  let { CLOSURE_OF_SEQUENTIALLY, .. } := BSeqChar2
  let { LIMIT_REAL_ADD, .. } := BRealLim
  let { CAUCHY_IN_SUBMETRIC, CONVERGENT_IMP_CAUCHY_IN, mcomplete, .. } := BCauchy1
  let { CAUCHY_IN_INTERLEAVING_GEN, .. } := BCauchy2
  let { CAUCHY_CONTINUOUS_MAP_IMAGE, cauchy_continuous_map, .. } := BCC1
  let { CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP, .. } := BCC2
  let { CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT, .. } := BEXT1
  -- @@SCOPE END

  let CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF ← prove
   r"!m1 m2 (f:A->B) s.
        mcomplete m2 /\ cauchy_continuous_map (submetric m1 s,m2) f
        ==> ?g. continuous_map
                 (subtopology (mtopology m1) (mtopology m1 closure_of s),
                  mtopology m2) g /\
                !x. x IN s ==> g x = f x"
   (GEN_TAC THEN GEN_TAC THEN GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q
     r"!m. ((!s. s SUBSET mspace m ==> P s) ==> (!s. P s)) /\
          (!s. s SUBSET mspace m ==> P s)
          ==> !s. P s")) THEN
    EXISTS_TAC (← q r"m1:A metric") THEN CONJ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"mspace m1 INTER s:A->bool")) THEN
      ASM_REWRITE_TAC [← GSYM SUBMETRIC_SUBMETRIC, SUBMETRIC_MSPACE] THEN
      REWRITE_TAC [INTER_SUBSET, ← GSYM TOPSPACE_MTOPOLOGY] THEN
      REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT, IN_INTER] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:A->B") STRIP_ASSUME_TAC) THEN EXISTS_TAC
       (← q r"\x. if x IN topspace(mtopology m1) then (g:A->B) x else f x") THEN
      ASM_SIMP_TAC [COND_ID] THEN MATCH_MP_TAC CONTINUOUS_MAP_EQ THEN
      EXISTS_TAC (← q r"g:A->B") THEN ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER],
      ALL_TAC] THEN
    REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MAP_EXTENSION_POINTWISE_ALT THEN
    REWRITE_TAC [REGULAR_SPACE_MTOPOLOGY, SUBSET_REFL] THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY] THEN
    ASM_SIMP_TAC [CAUCHY_CONTINUOUS_IMP_CONTINUOUS_MAP,
                  ← GSYM MTOPOLOGY_SUBMETRIC, IN_DIFF] THEN
    X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o GEN_REWRITE_RULE RAND_CONV [CLOSURE_OF_SEQUENTIALLY]) THEN
    REWRITE_TAC [IN_ELIM_THM, IN_INTER, FORALL_AND_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (X_CHOOSE_THEN (← q r"x:num->A") STRIP_ASSUME_TAC)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        CONVERGENT_IMP_CAUCHY_IN)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
      SPEC (← q r"x:num->A") o REWRITE_RULE [cauchy_continuous_map]) THEN
    ASM_REWRITE_TAC [CAUCHY_IN_SUBMETRIC] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"(f:A->B) o (x:num->A)") o
      REWRITE_RULE [mcomplete]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"l:B") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o CONJUNCT1 o REWRITE_RULE [limit]) THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN DISCH_TAC THEN
    ASM_REWRITE_TAC [LIMIT_ATPOINTOF_SEQUENTIALLY_WITHIN] THEN
    X_GEN_TAC (← q r"y:num->A") THEN
    REWRITE_TAC [IN_INTER, IN_DELETE, FORALL_AND_THM] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o
     SPEC (← q r"\n. if EVEN n then x(n DIV 2):A else y(n DIV 2)") o
     REWRITE_RULE [cauchy_continuous_map]) THEN
    REWRITE_TAC [CAUCHY_IN_INTERLEAVING_GEN, o_DEF, COND_RAND] THEN
    ASM_REWRITE_TAC [SUBMETRIC, CAUCHY_IN_SUBMETRIC] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [CONVERGENT_IMP_CAUCHY_IN], ALL_TAC] THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"limit (mtopology m1) y (a:A) sequentially",
        ← q r"limit (mtopology m1) x (a:A) sequentially"] THEN
      REWRITE_TAC [IMP_IMP] THEN
      GEN_REWRITE_TAC (LAND_CONV o BINOP_CONV) [LIMIT_METRIC_DIST_NULL] THEN
      ASM_REWRITE_TAC [EVENTUALLY_TRUE] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LIMIT_REAL_ADD) THEN
      REWRITE_TAC [REAL_ADD_LID] THEN MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
        LIMIT_NULL_REAL_COMPARISON) THEN
      MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [] THEN GEN_TAC THEN
      MATCH_MP_TAC (← METRIC_ARITH (← q
        r"a IN mspace m /\ x IN mspace m /\ y IN mspace m
         ==> abs(mdist m (x,y)) <= abs(mdist m (x,a) + mdist m (y,a))")) THEN
      ASM_REWRITE_TAC [],
      DISCH_THEN (MP_TAC o CONJUNCT2 o CONJUNCT2) THEN
      GEN_REWRITE_TAC RAND_CONV [LIMIT_METRIC_DIST_NULL] THEN
      UNDISCH_TAC (← q r"limit (mtopology m2) ((f:A->B) o x) l sequentially") THEN
      GEN_REWRITE_TAC LAND_CONV [LIMIT_METRIC_DIST_NULL] THEN
      SIMP_TAC [o_DEF] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      REWRITE_TAC [IMP_IMP] THEN
      DISCH_THEN (MP_TAC o MATCH_MP LIMIT_REAL_ADD) THEN
      REWRITE_TAC [REAL_ADD_RID] THEN
      DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
       [DISCH_THEN (K ALL_TAC : thm → tactic) THEN MATCH_MP_TAC ALWAYS_EVENTUALLY THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
        REWRITE_TAC [SUBMETRIC] THEN ASM SET_TAC [],
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT]
          LIMIT_NULL_REAL_COMPARISON) THEN
        MATCH_MP_TAC ALWAYS_EVENTUALLY THEN REWRITE_TAC [] THEN GEN_TAC THEN
        MATCH_MP_TAC (← METRIC_ARITH (← q
         r"a IN mspace m /\ x IN mspace m /\ y IN mspace m
          ==> abs(mdist m (y,a)) <= abs(mdist m (x,a) + mdist m (x,y))")) THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP CAUCHY_CONTINUOUS_MAP_IMAGE) THEN
        REWRITE_TAC [SUBMETRIC] THEN ASM SET_TAC []]])

  let CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_INTERMEDIATE_CLOSURE_OF ← prove
   r"!m1 m2 (f:A->B) s t.
        mcomplete m2 /\ cauchy_continuous_map (submetric m1 s,m2) f /\
        t SUBSET mtopology m1 closure_of s
        ==> ?g. continuous_map(subtopology (mtopology m1) t,mtopology m2) g /\
                !x. x IN s ==> g x = f x"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"m1:A metric", ← q r"m2:B metric", ← q r"f:A->B",
                      ← q r"s:A->bool"]
          CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF) THEN
    ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO])

  return { CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_CLOSURE_OF,
           CAUCHY_CONTINUOUS_MAP_EXTENDS_TO_CONTINUOUS_INTERMEDIATE_CLOSURE_OF }

/- ------------------------------------------------------------------------- -/
