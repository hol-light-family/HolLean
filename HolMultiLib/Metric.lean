/-- lib.ml's `itlist`, for a function with effects. -/
def itlistIO {α β : Type} (f : α → β → ExceptT String IO β) :
    List α → β → ExceptT String IO β
  | [], b => pure b
  | h :: t, b => do f h (← itlistIO f t b)

/-- lib.ml's `repeat`: apply `f` until it fails. -/
partial def repeatIO {α : Type} (f : α → ExceptT String IO α) (x : α) :
    ExceptT String IO α :=
  tryCatch (do repeatIO f (← f x)) (fun _ => pure x)

/- ------------------------------------------------------------------------- -/
/- Instrument classical tactics to attach label to inductive hypothesis;    -/
/- further tactics for structuring the proof flow.  (metric.ml 12-57)        -/
/- ------------------------------------------------------------------------- -/

structure Tactics where
  LABEL_INDUCT_TAC : tactic
  LABEL_ABBREV_TAC : term → tactic
  CUT_TAC : term → tactic
  CLAIM_TAC : String → term → tactic
  CONJ_LIST : List thm → ExceptT String IO thm
  deriving Inhabited

@[nospecialize]
def setupTactics [HolBase] (D : MetricDeps) : ExceptT String IO Tactics := do
  -- @@SCOPE BEGIN
  let { DESTRUCT_TAC, MESON, .. } := D
  let { num_INDUCTION, .. } := D.core4
  -- @@SCOPE END

  D.prioritize_real

  let LABEL_INDUCT_TAC : tactic :=
    let IND_TAC := MATCH_MP_TAC num_INDUCTION THEN CONJ_TAC
    fun gl => ExceptT.run do
      let (asl, w) := gl
      let _ := asl
      let s := (← liftExcept (dest_var (← liftExcept (HolCore.Basics.dest_forall w)).1)).1
      ExceptT.mk ((IND_TAC THENL
       [ALL_TAC, GEN_TAC THEN DISCH_THEN (LABEL_TAC ("ind_" ++ s))]) gl)

  let LABEL_ABBREV_TAC (tm : term) : tactic := fun gl => ExceptT.run do
    let (cvs, t) ← liftExcept (dest_eq tm)
    let (v, vs) := HolCore.Basics.strip_comb cvs
    let s := HolCore.Printer.name_of v
    let rs ← liftExcept (HolCore.Basics.list_mk_abs vs t)
    let mkEq ← ExceptT.mk (mk_eq : IO _)
    let eq ← liftExcept (mkEq (rs, v))
    let th1 ← itlistIO (fun v th => do CONV_RULE (LAND_CONV BETA_CONV) (← AP_THM th v))
                 vs.reverse (← ASSUME eq)
    let th2 ← SIMPLE_CHOOSE v (← SIMPLE_EXISTS v (← GENL vs th1))
    let th3 ← PROVE_HYP (← EXISTS (← liftExcept (HolCore.Bool.mk_exists v eq), rs) (REFL rs)) th2
    let (asl, w) := gl
    let avoids := itlist (fun (_, th) acc => union (frees (concl th)) acc) asl (frees w)
    if mem v avoids then throw "LABEL_ABBREV_TAC: variable already used" else
    ExceptT.mk (CHOOSE_THEN
     (fun th => RULE_ASSUM_TAC (PURE_ONCE_REWRITE_RULE [th]) THEN
                PURE_ONCE_REWRITE_TAC [th] THEN
                LABEL_TAC s th)
     th3 gl)

  let CUT_TAC : term → tactic ← do
    let th ← MESON [] (← q r"(p ==> q) /\ p ==> q")
    let ptm ← q r"p:bool"
    pure (fun tm => tactic_of (do
      pure (MATCH_MP_TAC (← INST [(tm, ptm)] th) THEN CONJ_TAC)))

  let CLAIM_TAC (s : String) (tm : term) : tactic := SUBGOAL_THEN tm (DESTRUCT_TAC s)

  let CONJ_LIST : List thm → ExceptT String IO thm := end_itlist CONJ

  return { LABEL_INDUCT_TAC, LABEL_ABBREV_TAC, CUT_TAC, CLAIM_TAC, CONJ_LIST }

/- ------------------------------------------------------------------------- -/
/- General notion of a topology; the "universe"; open sets; closed sets.     -/
/- (metric.ml 59-297)                                                         -/
/- ------------------------------------------------------------------------- -/

structure Topology where
  istopology : thm
  topology_tybij_th : thm
  topology_tybij : thm
  ISTOPOLOGY_OPEN_IN : thm
  TOPOLOGY_EQ : thm
  topspace : thm
  OPEN_IN_CLAUSES : thm
  OPEN_IN_SUBSET : thm
  OPEN_IN_EMPTY : thm
  OPEN_IN_INTER : thm
  OPEN_IN_UNIONS : thm
  OPEN_IN_UNION : thm
  OPEN_IN_TOPSPACE : thm
  OPEN_IN_INTERS : thm
  OPEN_IN_SUBOPEN : thm
  closed_in : thm
  CLOSED_IN_SUBSET : thm
  CLOSED_IN_EMPTY : thm
  CLOSED_IN_TOPSPACE : thm
  CLOSED_IN_UNION : thm
  CLOSED_IN_INTERS : thm
  CLOSED_IN_INTER : thm
  OPEN_IN_CLOSED_IN_EQ : thm
  OPEN_IN_CLOSED_IN : thm
  CLOPEN_IN_COMPLEMENT : thm
  OPEN_IN_DIFF : thm
  CLOSED_IN_DIFF : thm
  FORALL_OPEN_IN : thm
  FORALL_CLOSED_IN : thm
  EXISTS_OPEN_IN : thm
  EXISTS_CLOSED_IN : thm
  TOPOLOGY_FINER_CLOSED_IN : thm
  CLOSED_IN_UNIONS : thm
  TOPOLOGY_EQ_ALT : thm
  CARD_EQ_OPEN_CLOSED_IN_SETS : thm
  deriving Inhabited

@[nospecialize]
def setupTopology [HolBase] (D : MetricDeps) : ExceptT String IO Topology := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, SIMP_RULE, new_definition,
        new_type_definition, .. } := D
  let { DIFF_EMPTY, DIFF_EQ_EMPTY, EMPTY_SUBSET, ETA_AX, EXISTS_IN_IMAGE, EXTENSION,
        FINITE_INDUCT_STRONG, FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, INTERS_0, INTERS_2, INTERS_INSERT, INTER_UNIV, IN_DIFF,
        IN_ELIM_THM, IN_INSERT, IN_INTERS, IN_UNIONS, IN_UNIV, LEFT_IMP_EXISTS_THM,
        NOT_INSERT_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_REFL, UNIONS_0, UNIONS_2,
        UNIONS_INSERT, UNION_SUBSET, .. } := D.core4
  let { EQ_IMP, FORALL_AND_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { EQ_C_INVOLUTION, .. } := D.lib
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let istopology ← new_definition
   r"istopology L <=>
        {} IN L /\
        (!s t. s IN L /\ t IN L ==> (s INTER t) IN L) /\
        (!k. k SUBSET L ==> (UNIONS k) IN L)"

  let topology_tybij_th ← prove
   r"?t:(A->bool)->bool. istopology t"
   (EXISTS_TAC (← q r"UNIV:(A->bool)->bool") THEN REWRITE_TAC [istopology, IN_UNIV])

  let topology_tybij ←
    new_type_definition "topology" ("topology", "open_in") topology_tybij_th

  let ISTOPOLOGY_OPEN_IN ← prove
   r"istopology(open_in top)"
   (MESON_TAC [topology_tybij])

  let TOPOLOGY_EQ ← prove
   r"!top1 top2. top1 = top2 <=> !s. open_in top1 s <=> open_in top2 s"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM FUN_EQ_THM] THEN
    REWRITE_TAC [ETA_AX] THEN MESON_TAC [topology_tybij])

  let topspace ← new_definition
   r"topspace top = UNIONS {s | open_in top s}"

  let OPEN_IN_CLAUSES ← prove
   r"!top:(A)topology.
        open_in top {} /\
        (!s t. open_in top s /\ open_in top t ==> open_in top (s INTER t)) /\
        (!k. (!s. s IN k ==> open_in top s) ==> open_in top (UNIONS k))"
   (SIMP_TAC [IN, SUBSET, ← SIMP_RULE [istopology, IN, SUBSET] ISTOPOLOGY_OPEN_IN])

  let OPEN_IN_SUBSET ← prove
   r"!top s. open_in top s ==> s SUBSET (topspace top)"
   (REWRITE_TAC [topspace] THEN SET_TAC [])

  let OPEN_IN_EMPTY ← prove
   r"!top. open_in top {}"
   (REWRITE_TAC [OPEN_IN_CLAUSES])

  let OPEN_IN_INTER ← prove
   r"!top s t. open_in top s /\ open_in top t ==> open_in top (s INTER t)"
   (REWRITE_TAC [OPEN_IN_CLAUSES])

  let OPEN_IN_UNIONS ← prove
   r"!top k. (!s. s IN k ==> open_in top s) ==> open_in top (UNIONS k)"
   (REWRITE_TAC [OPEN_IN_CLAUSES])

  let OPEN_IN_UNION ← prove
   r"!top s t. open_in top s /\ open_in top t ==> open_in top (s UNION t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM UNIONS_2] THEN
    MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [])

  let OPEN_IN_TOPSPACE ← prove
   r"!top. open_in top (topspace top)"
   (SIMP_TAC [topspace, OPEN_IN_UNIONS, IN_ELIM_THM])

  let OPEN_IN_INTERS ← prove
   r"!top s:(A->bool)->bool.
        FINITE s /\ ~(s = {}) /\ (!t. t IN s ==> open_in top t)
        ==> open_in top (INTERS s)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [INTERS_INSERT, IMP_IMP, NOT_INSERT_EMPTY, FORALL_IN_INSERT] THEN
    MAP_EVERY X_GEN_TAC [← q r"s:A->bool", ← q r"f:(A->bool)->bool"] THEN
    ASM_CASES_TAC (← q r"f:(A->bool)->bool = {}") THEN
    ASM_SIMP_TAC [INTERS_0, INTER_UNIV] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC OPEN_IN_INTER THEN ASM_SIMP_TAC [])

  let OPEN_IN_SUBOPEN ← prove
   r"!top s:A->bool.
        open_in top s <=>
        !x. x IN s ==> ?t. open_in top t /\ x IN t /\ t SUBSET s"
   (REPEAT GEN_TAC THEN EQ_TAC THENL [MESON_TAC [SUBSET_REFL], ALL_TAC] THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    REWRITE_TAC [← TAUT (← q r"a ==> b /\ c <=> (a ==> b) /\ (a ==> c)")] THEN
    REWRITE_TAC [FORALL_AND_THM, LEFT_IMP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← GSYM FORALL_IN_IMAGE] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_UNIONS) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let closed_in ← new_definition
   r"closed_in top s <=>
        s SUBSET (topspace top) /\ open_in top (topspace top DIFF s)"

  let CLOSED_IN_SUBSET ← prove
   r"!top s. closed_in top s ==> s SUBSET (topspace top)"
   (MESON_TAC [closed_in])

  let CLOSED_IN_EMPTY ← prove
   r"!top. closed_in top {}"
   (REWRITE_TAC [closed_in, EMPTY_SUBSET, DIFF_EMPTY, OPEN_IN_TOPSPACE])

  let CLOSED_IN_TOPSPACE ← prove
   r"!top. closed_in top (topspace top)"
   (REWRITE_TAC [closed_in, SUBSET_REFL, DIFF_EQ_EMPTY, OPEN_IN_EMPTY])

  let CLOSED_IN_UNION ← prove
   r"!top s t. closed_in top s /\ closed_in top t ==> closed_in top (s UNION t)"
   (SIMP_TAC [closed_in, UNION_SUBSET, OPEN_IN_INTER,
              ← sr r"u DIFF (s UNION t) = (u DIFF s) INTER (u DIFF t)"])

  let CLOSED_IN_INTERS ← prove
   r"!top k:(A->bool)->bool.
        ~(k = {}) /\ (!s. s IN k ==> closed_in top s)
        ==> closed_in top (INTERS k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_in] THEN REPEAT STRIP_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"topspace top DIFF INTERS k :A->bool =
                UNIONS {topspace top DIFF s | s IN k}") SUBST1_TAC
    THENL [ALL_TAC, MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC []] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    REWRITE_TAC [IN_UNIONS, IN_INTERS, IN_DIFF, EXISTS_IN_IMAGE] THEN
    MESON_TAC [])

  let CLOSED_IN_INTER ← prove
   r"!top s t. closed_in top s /\ closed_in top t ==> closed_in top (s INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_2] THEN
    MATCH_MP_TAC CLOSED_IN_INTERS THEN ASM SET_TAC [])

  let OPEN_IN_CLOSED_IN_EQ ← prove
   r"!top s. open_in top s <=>
           s SUBSET topspace top /\ closed_in top (topspace top DIFF s)"
   (REWRITE_TAC [closed_in, ← sr r"(u DIFF s) SUBSET u"] THEN
    REWRITE_TAC [← sr r"u DIFF (u DIFF s) = u INTER s"] THEN
    MESON_TAC [OPEN_IN_SUBSET, ← sr r"s SUBSET t ==> t INTER s = s"])

  let OPEN_IN_CLOSED_IN ← prove
   r"!s. s SUBSET topspace top
       ==> (open_in top s <=> closed_in top (topspace top DIFF s))"
   (SIMP_TAC [OPEN_IN_CLOSED_IN_EQ])

  let CLOPEN_IN_COMPLEMENT ← prove
   r"!top s:A->bool.
        closed_in top s /\ open_in top s <=>
        s SUBSET topspace top /\
        closed_in top (topspace top DIFF s) /\
        open_in top (topspace top DIFF s)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [closed_in] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [OPEN_IN_CLOSED_IN_EQ] THEN
    MESON_TAC [])

  let OPEN_IN_DIFF ← prove
   r"!top s t:A->bool.
      open_in top s /\ closed_in top t ==> open_in top (s DIFF t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s DIFF t :A->bool = s INTER (topspace top DIFF t)")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [],
      MATCH_MP_TAC OPEN_IN_INTER THEN ASM_MESON_TAC [closed_in]])

  let CLOSED_IN_DIFF ← prove
   r"!top s t:A->bool.
        closed_in top s /\ open_in top t ==> closed_in top (s DIFF t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s DIFF t :A->bool = s INTER (topspace top DIFF t)")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_INTER THEN ASM_MESON_TAC [OPEN_IN_CLOSED_IN_EQ]])

  let FORALL_OPEN_IN ← prove
   r"!top. (!s. open_in top s ==> P s) <=>
         (!s. closed_in top s ==> P(topspace top DIFF s))"
   (MESON_TAC [OPEN_IN_CLOSED_IN_EQ, OPEN_IN_CLOSED_IN, closed_in,
               ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"])

  let FORALL_CLOSED_IN ← prove
   r"!top. (!s. closed_in top s ==> P s) <=>
         (!s. open_in top s ==> P(topspace top DIFF s))"
   (MESON_TAC [OPEN_IN_CLOSED_IN_EQ, OPEN_IN_CLOSED_IN, closed_in,
               ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"])

  let EXISTS_OPEN_IN ← prove
   r"!top. (?s. open_in top s /\ P s) <=>
         (?s. closed_in top s /\ P(topspace top DIFF s))"
   (MESON_TAC [OPEN_IN_CLOSED_IN_EQ, OPEN_IN_CLOSED_IN, closed_in,
               ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"])

  let EXISTS_CLOSED_IN ← prove
   r"!top. (?s. closed_in top s /\ P s) <=>
         (?s. open_in top s /\ P(topspace top DIFF s))"
   (MESON_TAC [OPEN_IN_CLOSED_IN_EQ, OPEN_IN_CLOSED_IN, closed_in,
               ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"])

  let TOPOLOGY_FINER_CLOSED_IN ← prove
   r"!top top':A topology.
        topspace top' = topspace top
        ==> ((!s. open_in top s ==> open_in top' s) <=>
             (!s. closed_in top s ==> closed_in top' s))"
   (REWRITE_TAC [FORALL_CLOSED_IN] THEN
    MESON_TAC [OPEN_IN_CLOSED_IN, OPEN_IN_SUBSET])

  let CLOSED_IN_UNIONS ← prove
   r"!top s. FINITE s /\ (!t. t IN s ==> closed_in top t)
           ==> closed_in top (UNIONS s)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_INSERT, UNIONS_0, CLOSED_IN_EMPTY, IN_INSERT] THEN
    MESON_TAC [CLOSED_IN_UNION])

  let TOPOLOGY_EQ_ALT ← prove
   r"!top1 top2:A topology.
        top1 = top2 <=> !s. closed_in top1 s <=> closed_in top2 s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← SPEC (← q r"topspace top1:A->bool") th) THEN
            MP_TAC (← SPEC (← q r"topspace top2:A->bool") th))) THEN
    REWRITE_TAC [CLOSED_IN_TOPSPACE, IMP_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    REWRITE_TAC [IMP_IMP, SUBSET_ANTISYM_EQ] THEN DISCH_TAC THEN
    REWRITE_TAC [TOPOLOGY_EQ, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    ASM_REWRITE_TAC [FORALL_AND_THM, FORALL_OPEN_IN] THEN
    ASM_MESON_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE])

  let CARD_EQ_OPEN_CLOSED_IN_SETS ← prove
   r"!top:A topology. {s | open_in top s} =_c {s | closed_in top s}"
   (GEN_TAC THEN MATCH_MP_TAC EQ_C_INVOLUTION THEN
    EXISTS_TAC (← q r"\u:A->bool. topspace top DIFF u") THEN
    SIMP_TAC [IN_ELIM_THM, OPEN_IN_DIFF, OPEN_IN_TOPSPACE,
              CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
    REWRITE_TAC [← sr r"u DIFF (u DIFF s) = s <=> s SUBSET u"] THEN
    MESON_TAC [OPEN_IN_SUBSET, CLOSED_IN_SUBSET])

  return { istopology, topology_tybij_th, topology_tybij, ISTOPOLOGY_OPEN_IN, TOPOLOGY_EQ,
           topspace, OPEN_IN_CLAUSES, OPEN_IN_SUBSET, OPEN_IN_EMPTY, OPEN_IN_INTER,
           OPEN_IN_UNIONS, OPEN_IN_UNION, OPEN_IN_TOPSPACE, OPEN_IN_INTERS, OPEN_IN_SUBOPEN,
           closed_in, CLOSED_IN_SUBSET, CLOSED_IN_EMPTY, CLOSED_IN_TOPSPACE, CLOSED_IN_UNION,
           CLOSED_IN_INTERS, CLOSED_IN_INTER, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_CLOSED_IN,
           CLOPEN_IN_COMPLEMENT, OPEN_IN_DIFF, CLOSED_IN_DIFF, FORALL_OPEN_IN,
           FORALL_CLOSED_IN, EXISTS_OPEN_IN, EXISTS_CLOSED_IN, TOPOLOGY_FINER_CLOSED_IN,
           CLOSED_IN_UNIONS, TOPOLOGY_EQ_ALT, CARD_EQ_OPEN_CLOSED_IN_SETS }

/- ------------------------------------------------------------------------- -/
/- The discrete topology.  (metric.ml 299-427)                               -/
/- ------------------------------------------------------------------------- -/

structure Discrete where
  discrete_topology : thm
  discrete_space : thm
  OPEN_IN_DISCRETE_TOPOLOGY : thm
  TOPSPACE_DISCRETE_TOPOLOGY : thm
  CLOSED_IN_DISCRETE_TOPOLOGY : thm
  DISCRETE_SPACE_DISCRETE_TOPOLOGY : thm
  DISCRETE_SPACE : thm
  FORALL_DISCRETE_SPACES : thm
  DISCRETE_TOPOLOGY_UNIQUE : thm
  DISCRETE_SPACE_UNIQUE : thm
  DISCRETE_TOPOLOGY_UNIQUE_ALT : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY : thm
  DISCRETE_SPACE_TOPSPACE_EMPTY : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING : thm
  DISCRETE_SPACE_OPEN_EQ : thm
  DISCRETE_SPACE_OPEN : thm
  DISCRETE_SPACE_CLOSED_EQ : thm
  DISCRETE_SPACE_CLOSED : thm
  OPEN_IN_DISCRETE_SPACE : thm
  CLOSED_IN_DISCRETE_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupDiscrete [HolBase] (D : MetricDeps) (BTopology : Topology) :
    ExceptT String IO Discrete := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EMPTY_SUBSET, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET_ANTISYM_EQ, UNIONS_IMAGE, UNIONS_SUBSET,
        .. } := D.core4
  let { CLOSED_IN_SUBSET, OPEN_IN_EMPTY, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS,
        TOPOLOGY_EQ, TOPOLOGY_EQ_ALT, closed_in, istopology, topology_tybij, topspace,
        .. } := BTopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let discrete_topology ← new_definition
   r"discrete_topology u = topology {s:A->bool | s SUBSET u}"

  let discrete_space ← new_definition
   r"discrete_space (top:A topology) <=> discrete_topology(topspace top) = top"

  let OPEN_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool. open_in (discrete_topology u) s <=> s SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [discrete_topology] THEN
    GEN_REWRITE_TAC RAND_CONV [← sr r"s SUBSET u <=> {t | t SUBSET u} s"] THEN
    AP_THM_TAC THEN REWRITE_TAC [← GSYM (← CONJUNCT2 topology_tybij)] THEN
    REWRITE_TAC [istopology, IN_ELIM_THM, EMPTY_SUBSET, UNIONS_SUBSET] THEN
    SET_TAC [])

  let TOPSPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. topspace(discrete_topology u) = u"
   (REWRITE_TAC [topspace, OPEN_IN_DISCRETE_TOPOLOGY] THEN SET_TAC [])

  let CLOSED_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool. closed_in (discrete_topology u) s <=> s SUBSET u"
   (REWRITE_TAC [closed_in] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    SET_TAC [])

  let DISCRETE_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. discrete_space(discrete_topology u)"
   (REWRITE_TAC [discrete_space, TOPSPACE_DISCRETE_TOPOLOGY])

  let DISCRETE_SPACE ← prove
   r"!top:A topology. discrete_space top <=> ?u. discrete_topology u = top"
   (MESON_TAC [discrete_space, DISCRETE_SPACE_DISCRETE_TOPOLOGY])

  let FORALL_DISCRETE_SPACES ← prove
   r"(!top:A topology. discrete_space top ==> P (topspace top) top) <=>
   (!u:A->bool. P u (discrete_topology u))"
   (MESON_TAC [DISCRETE_SPACE, TOPSPACE_DISCRETE_TOPOLOGY])

  let DISCRETE_TOPOLOGY_UNIQUE ← prove
   r"!top u:A->bool.
        discrete_topology u = top <=>
        topspace top = u /\ (!x. x IN u ==> open_in top {x})"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY] THEN
      REWRITE_TAC [SING_SUBSET],
      STRIP_TAC THEN REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_DISCRETE_TOPOLOGY] THEN
      X_GEN_TAC (← q r"s:A->bool") THEN EQ_TAC THENL
       [DISCH_TAC, ASM_MESON_TAC [OPEN_IN_SUBSET]] THEN
      SUBGOAL_THEN (← q r"s = UNIONS(IMAGE (\x:A. {x}) s)") SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
        MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
        ASM SET_TAC []]])

  let DISCRETE_SPACE_UNIQUE ← prove
   r"!top:A topology.
        discrete_space top <=> !x. x IN topspace top ==> open_in top {x}"
   (REWRITE_TAC [discrete_space, DISCRETE_TOPOLOGY_UNIQUE])

  let DISCRETE_TOPOLOGY_UNIQUE_ALT ← prove
   r"!top u:A->bool.
        discrete_topology u = top <=>
        topspace top SUBSET u /\ (!x. x IN u ==> open_in top {x})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN MATCH_MP_TAC (← TAUT (← q
     r"(r ==> q) ==> ((p /\ q) /\ r <=> p /\ r)")) THEN
    DISCH_TAC THEN MATCH_MP_TAC OPEN_IN_SUBSET THEN
    SUBGOAL_THEN (← q r"u = UNIONS(IMAGE (\x:A. {x}) u)") SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
      MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_REWRITE_TAC [FORALL_IN_IMAGE]])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY ← prove
   r"!top:A topology. top = discrete_topology {} <=> topspace top = {}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN
    DISCH_TAC THEN REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN EQ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET],
      REWRITE_TAC [← sr r"s SUBSET {} <=> s = {}"] THEN
      ASM_MESON_TAC [OPEN_IN_EMPTY, OPEN_IN_TOPSPACE]])

  let DISCRETE_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> discrete_space top"
   (MESON_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, discrete_space])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING ← prove
   r"!top a:A. top = discrete_topology {a} <=> topspace top = {a}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN SIMP_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN
    DISCH_TAC THEN REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN EQ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET],
      REWRITE_TAC [← sr r"s SUBSET {a} <=> s = {} \/ s = {a}"] THEN
      ASM_MESON_TAC [OPEN_IN_EMPTY, OPEN_IN_TOPSPACE]])

  let DISCRETE_SPACE_OPEN_EQ ← prove
   r"!top:A topology.
        discrete_space top <=> !s. open_in top s <=> s SUBSET topspace top"
   (GEN_TAC THEN REWRITE_TAC [discrete_space, TOPOLOGY_EQ] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY] THEN MESON_TAC [])

  let DISCRETE_SPACE_OPEN ← prove
   r"!top:A topology.
        discrete_space top <=> !s. s SUBSET topspace top ==> open_in top s"
   (REWRITE_TAC [DISCRETE_SPACE_OPEN_EQ] THEN MESON_TAC [OPEN_IN_SUBSET])

  let DISCRETE_SPACE_CLOSED_EQ ← prove
   r"!top:A topology.
        discrete_space top <=> !s. closed_in top s <=> s SUBSET topspace top"
   (GEN_TAC THEN REWRITE_TAC [discrete_space, TOPOLOGY_EQ_ALT] THEN
    REWRITE_TAC [CLOSED_IN_DISCRETE_TOPOLOGY] THEN MESON_TAC [])

  let DISCRETE_SPACE_CLOSED ← prove
   r"!top:A topology.
        discrete_space top <=> !s. s SUBSET topspace top ==> closed_in top s"
   (REWRITE_TAC [DISCRETE_SPACE_CLOSED_EQ] THEN MESON_TAC [CLOSED_IN_SUBSET])

  let OPEN_IN_DISCRETE_SPACE ← prove
   r"!top (s:A->bool).
        discrete_space top ==> (open_in top s <=> s SUBSET topspace top)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_DISCRETE_SPACES] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY])

  let CLOSED_IN_DISCRETE_SPACE ← prove
   r"!top (s:A->bool).
        discrete_space top ==> (closed_in top s <=> s SUBSET topspace top)"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM, FORALL_DISCRETE_SPACES] THEN
    REWRITE_TAC [CLOSED_IN_DISCRETE_TOPOLOGY])

  return { discrete_topology, discrete_space, OPEN_IN_DISCRETE_TOPOLOGY,
           TOPSPACE_DISCRETE_TOPOLOGY, CLOSED_IN_DISCRETE_TOPOLOGY,
           DISCRETE_SPACE_DISCRETE_TOPOLOGY, DISCRETE_SPACE, FORALL_DISCRETE_SPACES,
           DISCRETE_TOPOLOGY_UNIQUE, DISCRETE_SPACE_UNIQUE, DISCRETE_TOPOLOGY_UNIQUE_ALT,
           SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, DISCRETE_SPACE_TOPSPACE_EMPTY,
           SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING, DISCRETE_SPACE_OPEN_EQ, DISCRETE_SPACE_OPEN,
           DISCRETE_SPACE_CLOSED_EQ, DISCRETE_SPACE_CLOSED, OPEN_IN_DISCRETE_SPACE,
           CLOSED_IN_DISCRETE_SPACE }

/- ------------------------------------------------------------------------- -/
/- Subspace topology.  (metric.ml 429-763)                                   -/
/- ------------------------------------------------------------------------- -/

structure Subtopology where
  subtopology : thm
  ISTOPOLOGY_SUBTOPOLOGY : thm
  ISTOPOLOGY_RELATIVE_TO : thm
  OPEN_IN_SUBTOPOLOGY : thm
  TOPOLOGY_FINER_SUBTOPOLOGY : thm
  OPEN_IN_SUBSET_TOPSPACE : thm
  OPEN_INTER_OPEN_IN_SUBTOPOLOGY : thm
  OPEN_IN_SUBTOPOLOGY_INTER_OPEN : thm
  OPEN_IN_RELATIVE_TO : thm
  OPEN_IN_SUBTOPOLOGY_ALT : thm
  OPEN_IN_SUBSET_TRANS : thm
  OPEN_IN_OPEN_SUBTOPOLOGY : thm
  OPEN_IN_SUBTOPOLOGY_INTER_SUBSET : thm
  OPEN_IN_SUBTOPOLOGY_INTER_OPEN_IN : thm
  TOPSPACE_SUBTOPOLOGY : thm
  TOPSPACE_SUBTOPOLOGY_SUBSET : thm
  TOPSPACE_SUBTOPOLOGY_IS_SUBSET : thm
  OPEN_IN_TRANS : thm
  CLOSED_IN_SUBTOPOLOGY : thm
  CLOSED_IN_SUBSET_TOPSPACE : thm
  CLOSED_INTER_CLOSED_IN_SUBTOPOLOGY : thm
  CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED : thm
  CLOSED_IN_RELATIVE_TO : thm
  CLOSED_IN_SUBTOPOLOGY_ALT : thm
  CLOSED_IN_SUBSET_TRANS : thm
  CLOSED_IN_CLOSED_SUBTOPOLOGY : thm
  CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET : thm
  CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN : thm
  SUBTOPOLOGY_SUBTOPOLOGY : thm
  CLOSED_IN_TRANS : thm
  OPEN_IN_TOPSPACE_EMPTY : thm
  CLOSED_IN_TOPSPACE_EMPTY : thm
  OPEN_IN_SUBTOPOLOGY_EMPTY : thm
  CLOSED_IN_SUBTOPOLOGY_EMPTY : thm
  OPEN_IN_SUBTOPOLOGY_REFL : thm
  CLOSED_IN_SUBTOPOLOGY_REFL : thm
  SUBTOPOLOGY_SUPERSET : thm
  SUBTOPOLOGY_TOPSPACE : thm
  SUBTOPOLOGY_UNIV : thm
  SUBTOPOLOGY_RESTRICT : thm
  OPEN_IN_IMP_SUBSET : thm
  CLOSED_IN_IMP_SUBSET : thm
  OPEN_IN_TRANS_FULL : thm
  CLOSED_IN_TRANS_FULL : thm
  OPEN_IN_SUBTOPOLOGY_DIFF_CLOSED : thm
  CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN : thm
  OPEN_IN_SUBTOPOLOGY_UNION : thm
  CLOSED_IN_SUBTOPOLOGY_UNION : thm
  SUBTOPOLOGY_DISCRETE_TOPOLOGY : thm
  DISCRETE_SPACE_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupSubtopology [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BDiscrete : Discrete) : ExceptT String IO Subtopology := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, INTER_ACI, INTER_ASSOC, INTER_COMM, INTER_EMPTY, INTER_SUBSET,
        INTER_UNIONS, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_IMAGE,
        SUBSET_INTER, SUBSET_REFL, SUBSET_UNIV, .. } := D.core4
  let { EQ_IMP, LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { RELATIVE_TO, RELATIVE_TO_SUBSET_TRANS, relative_to, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_SUBSET,
        CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, TOPOLOGY_EQ, closed_in, istopology,
        topology_tybij, topspace, .. } := BTopology
  let { DISCRETE_SPACE, OPEN_IN_DISCRETE_TOPOLOGY, discrete_topology, .. } := BDiscrete
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)
  let tiff ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")

  let subtopology ← new_definition
   r"subtopology top u = topology {s INTER u | open_in top s}"

  let ISTOPOLOGY_SUBTOPOLOGY ← prove
   r"!top u:A->bool. istopology {s INTER u | open_in top s}"
   (REWRITE_TAC [istopology, ← sr
     r"{s INTER u | open_in top s} =
    IMAGE (\s. s INTER u) {s | open_in top s}"] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_IN_IMAGE, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [SUBSET_IMAGE, IN_IMAGE, IN_ELIM_THM, SUBSET] THEN
    REPEAT GEN_TAC THEN REPEAT CONJ_TAC THENL
     [EXISTS_TAC (← q r"{}:A->bool") THEN REWRITE_TAC [OPEN_IN_EMPTY, INTER_EMPTY],
      SIMP_TAC [← sr r"(s INTER u) INTER t INTER u = (s INTER t) INTER u"] THEN
      ASM_MESON_TAC [OPEN_IN_INTER],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:(A->bool)->bool", ← q r"g:(A->bool)->bool"] THEN
      STRIP_TAC THEN EXISTS_TAC (← q r"UNIONS g :A->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_UNIONS, INTER_UNIONS] THEN SET_TAC []])

  let ISTOPOLOGY_RELATIVE_TO ← prove
   r"!top u:A->bool.
        istopology top ==> istopology(top relative_to u)"
   (REWRITE_TAC [RELATIVE_TO] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    REPEAT GEN_TAC THEN GEN_REWRITE_TAC LAND_CONV [topology_tybij] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN REWRITE_TAC [ISTOPOLOGY_SUBTOPOLOGY])

  let OPEN_IN_SUBTOPOLOGY ← prove
   r"!top u s. open_in (subtopology top u) s <=>
                ?t. open_in top t /\ s = t INTER u"
   (REWRITE_TAC [subtopology] THEN
    SIMP_TAC [← REWRITE_RULE [← CONJUNCT2 topology_tybij] ISTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM])

  let TOPOLOGY_FINER_SUBTOPOLOGY ← prove
   r"!top top' (u:A->bool).
        (!s. open_in top s ==> open_in top' s)
        ==> (!s. open_in (subtopology top u) s
                 ==> open_in (subtopology top' u) s)"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN MESON_TAC [])

  let OPEN_IN_SUBSET_TOPSPACE ← prove
   r"!top s t:A->bool.
        open_in top s /\ s SUBSET t ==> open_in (subtopology top t) s"
   (SIMP_TAC [OPEN_IN_SUBTOPOLOGY, ← sr r"s SUBSET t <=> s INTER t = s"] THEN
    MESON_TAC [])

  let OPEN_INTER_OPEN_IN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        open_in top s ==> open_in (subtopology top t) (s INTER t)"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN MESON_TAC [])

  let OPEN_IN_SUBTOPOLOGY_INTER_OPEN ← prove
   r"!top s t:A->bool.
        open_in top t ==> open_in (subtopology top s) (s INTER t)"
   (ONCE_REWRITE_TAC [INTER_COMM] THEN
    REWRITE_TAC [OPEN_INTER_OPEN_IN_SUBTOPOLOGY])

  let OPEN_IN_RELATIVE_TO ← prove
   r"!top s:A->bool.
        (open_in top relative_to s) = open_in (subtopology top s)"
   (REWRITE_TAC [relative_to, OPEN_IN_SUBTOPOLOGY, FUN_EQ_THM] THEN
    MESON_TAC [INTER_COMM])

  let OPEN_IN_SUBTOPOLOGY_ALT ← prove
   r"!top u s:A->bool.
       open_in (subtopology top u) s <=> s IN {u INTER t | open_in top t}"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, IN_ELIM_THM] THEN SET_TAC [])

  let OPEN_IN_SUBSET_TRANS ← prove
   r"!top s t u:A->bool.
         open_in (subtopology top u) s /\ s SUBSET t /\ t SUBSET u
         ==> open_in (subtopology top t) s"
   (REWRITE_TAC [← GSYM OPEN_IN_RELATIVE_TO, RELATIVE_TO_SUBSET_TRANS])

  let OPEN_IN_OPEN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        open_in top s
        ==> (open_in (subtopology top s) t <=> open_in top t /\ t SUBSET s)"
   (REWRITE_TAC [tiff] THEN
    REWRITE_TAC [OPEN_IN_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    SIMP_TAC [FORALL_IN_GSPEC, OPEN_IN_INTER, INTER_SUBSET])

  let OPEN_IN_SUBTOPOLOGY_INTER_SUBSET ← prove
   r"!top s u v:A->bool.
        open_in (subtopology top u) (u INTER s) /\ v SUBSET u
        ==> open_in (subtopology top v) (v INTER s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM SET_TAC [])

  let OPEN_IN_SUBTOPOLOGY_INTER_OPEN_IN ← prove
   r"!top s t u.
        open_in (subtopology top u) s /\ open_in top t
        ==> open_in (subtopology top u) (s INTER t)"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [OPEN_IN_INTER, INTER_ACI])

  let TOPSPACE_SUBTOPOLOGY ← prove
   r"!top u. topspace(subtopology top u) = topspace top INTER u"
   (REWRITE_TAC [topspace, OPEN_IN_SUBTOPOLOGY, INTER_UNIONS] THEN
    REPEAT STRIP_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [IN_ELIM_THM])

  let TOPSPACE_SUBTOPOLOGY_SUBSET ← prove
   r"!top s:A->bool. s SUBSET topspace top ==> topspace(subtopology top s) = s"
   (REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [])

  let TOPSPACE_SUBTOPOLOGY_IS_SUBSET ← prove
   r"!top s:A->bool. topspace(subtopology top s) SUBSET s"
   (REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, INTER_SUBSET])

  let OPEN_IN_TRANS ← prove
   r"!top s t u:A->bool.
        open_in (subtopology top t) s /\
        open_in (subtopology top u) t
        ==> open_in (subtopology top u) s"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [OPEN_IN_INTER, INTER_ACI])

  let CLOSED_IN_SUBTOPOLOGY ← prove
   r"!top u s. closed_in (subtopology top u) s <=>
                ?t:A->bool. closed_in top t /\ s = t INTER u"
   (REWRITE_TAC [closed_in, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [SUBSET_INTER, OPEN_IN_SUBTOPOLOGY, RIGHT_AND_EXISTS_THM] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"topspace top DIFF t :A->bool") THEN
    ASM_SIMP_TAC [CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, CLOSED_IN_DIFF,
                  OPEN_IN_TOPSPACE] THEN
    ASM SET_TAC [])

  let CLOSED_IN_SUBSET_TOPSPACE ← prove
   r"!top s t:A->bool.
        closed_in top s /\ s SUBSET t ==> closed_in (subtopology top t) s"
   (SIMP_TAC [CLOSED_IN_SUBTOPOLOGY, ← sr r"s SUBSET t <=> s INTER t = s"] THEN
    MESON_TAC [])

  let CLOSED_INTER_CLOSED_IN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        closed_in top s ==> closed_in (subtopology top t) (s INTER t)"
   (REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN MESON_TAC [])

  let CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED ← prove
   r"!top s t:A->bool.
        closed_in top t ==> closed_in (subtopology top s) (s INTER t)"
   (ONCE_REWRITE_TAC [INTER_COMM] THEN
    REWRITE_TAC [CLOSED_INTER_CLOSED_IN_SUBTOPOLOGY])

  let CLOSED_IN_RELATIVE_TO ← prove
   r"!top s:A->bool.
        (closed_in top relative_to s) = closed_in (subtopology top s)"
   (REWRITE_TAC [relative_to, CLOSED_IN_SUBTOPOLOGY, FUN_EQ_THM] THEN
    MESON_TAC [INTER_COMM])

  let CLOSED_IN_SUBTOPOLOGY_ALT ← prove
   r"!top u s:A->bool.
       closed_in (subtopology top u) s <=> s IN {u INTER t | closed_in top t}"
   (REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY, IN_ELIM_THM] THEN SET_TAC [])

  let CLOSED_IN_SUBSET_TRANS ← prove
   r"!top s t u:A->bool.
         closed_in (subtopology top u) s /\ s SUBSET t /\ t SUBSET u
         ==> closed_in (subtopology top t) s"
   (REWRITE_TAC [← GSYM CLOSED_IN_RELATIVE_TO, RELATIVE_TO_SUBSET_TRANS])

  let CLOSED_IN_CLOSED_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
      closed_in top s
      ==> (closed_in (subtopology top s) t <=> closed_in top t /\ t SUBSET s)"
   (REWRITE_TAC [tiff] THEN
    REWRITE_TAC [CLOSED_IN_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [RIGHT_FORALL_IMP_THM, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
    SIMP_TAC [FORALL_IN_GSPEC, CLOSED_IN_INTER, INTER_SUBSET])

  let CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET ← prove
   r"!top s u v:A->bool.
        closed_in (subtopology top u) (u INTER s) /\ v SUBSET u
        ==> closed_in (subtopology top v) (v INTER s)"
   (REPEAT GEN_TAC THEN SIMP_TAC [CLOSED_IN_SUBTOPOLOGY, LEFT_AND_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])

  let CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN ← prove
   r"!top s t u.
        closed_in (subtopology top u) s /\ closed_in top t
        ==> closed_in (subtopology top u) (s INTER t)"
   (REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    ASM_MESON_TAC [CLOSED_IN_INTER, INTER_ACI])

  let SUBTOPOLOGY_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        subtopology (subtopology top s) t = subtopology top (s INTER t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [subtopology] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← sr r"{f x | ?y. P y /\ x = g y} = {f(g y) | P y}"] THEN
    REWRITE_TAC [INTER_ASSOC])

  let CLOSED_IN_TRANS ← prove
   r"!top s t u:A->bool.
        closed_in (subtopology top t) s /\
        closed_in (subtopology top u) t
        ==> closed_in (subtopology top u) s"
   (REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM_MESON_TAC [CLOSED_IN_INTER, INTER_ACI])

  let OPEN_IN_TOPSPACE_EMPTY ← prove
   r"!top:A topology s. topspace top = {} ==> (open_in top s <=> s = {})"
   (MESON_TAC [OPEN_IN_EMPTY, OPEN_IN_SUBSET, SUBSET_EMPTY])

  let CLOSED_IN_TOPSPACE_EMPTY ← prove
   r"!top:A topology s. topspace top = {} ==> (closed_in top s <=> s = {})"
   (MESON_TAC [CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, SUBSET_EMPTY])

  let OPEN_IN_SUBTOPOLOGY_EMPTY ← prove
   r"!top s. open_in (subtopology top {}) s <=> s = {}"
   (SIMP_TAC [OPEN_IN_TOPSPACE_EMPTY, TOPSPACE_SUBTOPOLOGY, INTER_EMPTY])

  let CLOSED_IN_SUBTOPOLOGY_EMPTY ← prove
   r"!top s. closed_in (subtopology top {}) s <=> s = {}"
   (SIMP_TAC [CLOSED_IN_TOPSPACE_EMPTY, TOPSPACE_SUBTOPOLOGY, INTER_EMPTY])

  let OPEN_IN_SUBTOPOLOGY_REFL ← prove
   r"!top u:A->bool. open_in (subtopology top u) u <=> u SUBSET topspace top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN ONCE_ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← sr r"s SUBSET u ==> s INTER t SUBSET u") THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET],
      DISCH_TAC THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
      REWRITE_TAC [OPEN_IN_TOPSPACE] THEN ASM SET_TAC []])

  let CLOSED_IN_SUBTOPOLOGY_REFL ← prove
   r"!top u:A->bool. closed_in (subtopology top u) u <=> u SUBSET topspace top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN ONCE_ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← sr r"s SUBSET u ==> s INTER t SUBSET u") THEN
      ASM_SIMP_TAC [CLOSED_IN_SUBSET],
      DISCH_TAC THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
      REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN ASM SET_TAC []])

  let SUBTOPOLOGY_SUPERSET ← prove
   r"!top s:A->bool. topspace top SUBSET s ==> subtopology top s = top"
   (REPEAT GEN_TAC THEN SIMP_TAC [TOPOLOGY_EQ, OPEN_IN_SUBTOPOLOGY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"u:A->bool") THEN EQ_TAC THENL
     [DISCH_THEN (CHOOSE_THEN (CONJUNCTS_THEN2 MP_TAC SUBST1_TAC)) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC th THEN ASSUME_TAC (← MATCH_MP OPEN_IN_SUBSET th))) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      DISCH_TAC THEN EXISTS_TAC (← q r"u:A->bool") THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let SUBTOPOLOGY_TOPSPACE ← prove
   r"!top. subtopology top (topspace top) = top"
   (SIMP_TAC [SUBTOPOLOGY_SUPERSET, SUBSET_REFL])

  let SUBTOPOLOGY_UNIV ← prove
   r"!top. subtopology top UNIV = top"
   (SIMP_TAC [SUBTOPOLOGY_SUPERSET, SUBSET_UNIV])

  let SUBTOPOLOGY_RESTRICT ← prove
   r"!top s:A->bool.
        subtopology top s = subtopology top (topspace top INTER s)"
   (MESON_TAC [SUBTOPOLOGY_TOPSPACE, SUBTOPOLOGY_SUBTOPOLOGY])

  let OPEN_IN_IMP_SUBSET ← prove
   r"!top s t. open_in (subtopology top s) t ==> t SUBSET s"
   (REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN SET_TAC [])

  let CLOSED_IN_IMP_SUBSET ← prove
   r"!top s t. closed_in (subtopology top s) t ==> t SUBSET s"
   (REWRITE_TAC [closed_in, TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [])

  let OPEN_IN_TRANS_FULL ← prove
   r"!top s u.
        open_in (subtopology top u) s /\ open_in top u ==> open_in top s"
   (MESON_TAC [OPEN_IN_TRANS, SUBTOPOLOGY_TOPSPACE])

  let CLOSED_IN_TRANS_FULL ← prove
   r"!top s u.
      closed_in (subtopology top u) s /\ closed_in top u ==> closed_in top s"
   (MESON_TAC [CLOSED_IN_TRANS, SUBTOPOLOGY_TOPSPACE])

  let OPEN_IN_SUBTOPOLOGY_DIFF_CLOSED ← prove
   r"!top s t:A->bool.
        s SUBSET topspace top /\ closed_in top t
        ==> open_in (subtopology top s) (s DIFF t)"
   (REWRITE_TAC [closed_in, OPEN_IN_SUBTOPOLOGY] THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"topspace top DIFF t:A->bool") THEN ASM SET_TAC [])

  let CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN ← prove
   r"!top s t:A->bool.
        s SUBSET topspace top /\ open_in top t
        ==> closed_in (subtopology top s) (s DIFF t)"
   (REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ, CLOSED_IN_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"topspace top DIFF t:A->bool") THEN ASM SET_TAC [])

  let OPEN_IN_SUBTOPOLOGY_UNION ← prove
   r"!top s t u:A->bool.
        open_in (subtopology top t) s /\ open_in (subtopology top u) s
        ==> open_in (subtopology top (t UNION u)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s':A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t':A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"s' INTER t':A->bool") THEN ASM_SIMP_TAC [OPEN_IN_INTER] THEN
    ASM SET_TAC [])

  let CLOSED_IN_SUBTOPOLOGY_UNION ← prove
   r"!top s t u:A->bool.
        closed_in (subtopology top t) s /\ closed_in (subtopology top u) s
        ==> closed_in (subtopology top (t UNION u)) s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"s':A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t':A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"s' INTER t':A->bool") THEN ASM_SIMP_TAC [CLOSED_IN_INTER] THEN
    ASM SET_TAC [])

  let SUBTOPOLOGY_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool.
        subtopology (discrete_topology u) s = discrete_topology(u INTER s)"
   (REWRITE_TAC [subtopology, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [discrete_topology] THEN
    AP_TERM_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    ONCE_REWRITE_TAC [SUBSET] THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
    SIMP_TAC [IN_ELIM_THM, SUBSET_INTER] THEN SET_TAC [])

  let DISCRETE_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        discrete_space top ==> discrete_space(subtopology top s)"
   (REWRITE_TAC [DISCRETE_SPACE] THEN MESON_TAC [SUBTOPOLOGY_DISCRETE_TOPOLOGY])

  return { subtopology, ISTOPOLOGY_SUBTOPOLOGY, ISTOPOLOGY_RELATIVE_TO, OPEN_IN_SUBTOPOLOGY,
           TOPOLOGY_FINER_SUBTOPOLOGY, OPEN_IN_SUBSET_TOPSPACE, OPEN_INTER_OPEN_IN_SUBTOPOLOGY,
           OPEN_IN_SUBTOPOLOGY_INTER_OPEN, OPEN_IN_RELATIVE_TO, OPEN_IN_SUBTOPOLOGY_ALT,
           OPEN_IN_SUBSET_TRANS, OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_INTER_SUBSET,
           OPEN_IN_SUBTOPOLOGY_INTER_OPEN_IN, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET,
           TOPSPACE_SUBTOPOLOGY_IS_SUBSET, OPEN_IN_TRANS, CLOSED_IN_SUBTOPOLOGY,
           CLOSED_IN_SUBSET_TOPSPACE, CLOSED_INTER_CLOSED_IN_SUBTOPOLOGY,
           CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, CLOSED_IN_RELATIVE_TO, CLOSED_IN_SUBTOPOLOGY_ALT,
           CLOSED_IN_SUBSET_TRANS, CLOSED_IN_CLOSED_SUBTOPOLOGY,
           CLOSED_IN_SUBTOPOLOGY_INTER_SUBSET, CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN,
           SUBTOPOLOGY_SUBTOPOLOGY, CLOSED_IN_TRANS, OPEN_IN_TOPSPACE_EMPTY,
           CLOSED_IN_TOPSPACE_EMPTY, OPEN_IN_SUBTOPOLOGY_EMPTY, CLOSED_IN_SUBTOPOLOGY_EMPTY,
           OPEN_IN_SUBTOPOLOGY_REFL, CLOSED_IN_SUBTOPOLOGY_REFL, SUBTOPOLOGY_SUPERSET,
           SUBTOPOLOGY_TOPSPACE, SUBTOPOLOGY_UNIV, SUBTOPOLOGY_RESTRICT, OPEN_IN_IMP_SUBSET,
           CLOSED_IN_IMP_SUBSET, OPEN_IN_TRANS_FULL, CLOSED_IN_TRANS_FULL,
           OPEN_IN_SUBTOPOLOGY_DIFF_CLOSED, CLOSED_IN_SUBTOPOLOGY_DIFF_OPEN,
           OPEN_IN_SUBTOPOLOGY_UNION, CLOSED_IN_SUBTOPOLOGY_UNION,
           SUBTOPOLOGY_DISCRETE_TOPOLOGY, DISCRETE_SPACE_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Topology bases; hereditary topological properties.  (metric.ml 765-933)  -/
/- ------------------------------------------------------------------------- -/

structure Bases where
  ISTOPOLOGY_BASE_ALT : thm
  ISTOPOLOGY_BASE_EQ : thm
  ISTOPOLOGY_BASE : thm
  MINIMAL_TOPOLOGY_BASE : thm
  OPEN_IN_TOPOLOGY_BASE_UNIQUE : thm
  TOPOLOGY_BASE_UNIQUE : thm
  TOPOLOGY_BASES_EQ : thm
  ISTOPOLOGY_SUBBASE : thm
  OPEN_IN_SUBBASE : thm
  TOPSPACE_SUBBASE : thm
  MINIMAL_TOPOLOGY_SUBBASE : thm
  ISTOPOLOGY_SUBBASE_UNIV : thm
  hereditarily : thm
  HEREDITARILY : thm
  HEREDITARILY_MONO : thm
  HEREDITARILY_INC : thm
  HEREDITARILY_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupBases [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) : ExceptT String IO Bases := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { ARBITRARY, ARBITRARY_UNION_OF_ALT, ARBITRARY_UNION_OF_EMPTY,
        ARBITRARY_UNION_OF_IDEMPOT, ARBITRARY_UNION_OF_INC, ARBITRARY_UNION_OF_INTER_EQ,
        ARBITRARY_UNION_OF_UNIONS, ETA_AX, FINITE_EMPTY, FINITE_INSERT,
        FINITE_INTERSECTION_OF_INTER, FORALL_INTERSECTION_OF, FORALL_IN_INSERT,
        FORALL_UNION_OF, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, INTERSECTION_OF, INTERS_0, INTERS_INSERT, INTER_SUBSET,
        INTER_UNIV, IN_ELIM_THM, IN_UNIONS, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, UNIONS_1,
        UNIONS_GSPEC, UNIONS_SUBSET, UNION_OF, UNION_OF_MONO, .. } := D.core4
  let { FORALL_AND_THM, .. } := D.core5
  let { FORALL_RELATIVE_TO, RELATIVE_TO_INTER, relative_to, .. } := D.misc
  let { OPEN_IN_INTERS, OPEN_IN_UNIONS, istopology, topology_tybij, topspace, .. } := BTopology
  let { SUBTOPOLOGY_RESTRICT, SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, .. } :=
    BSubtopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let ISTOPOLOGY_BASE_ALT ← prove
   r"!P:(A->bool)->bool.
        istopology (ARBITRARY UNION_OF P) <=>
        (!s t. (ARBITRARY UNION_OF P) s /\ (ARBITRARY UNION_OF P) t
               ==> (ARBITRARY UNION_OF P) (s INTER t))"
   (GEN_TAC THEN REWRITE_TAC [← REWRITE_RULE [IN] istopology] THEN
    REWRITE_TAC [ARBITRARY_UNION_OF_EMPTY] THEN
    MATCH_MP_TAC (← TAUT (← q r"q ==> (p /\ q <=> p)")) THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC ARBITRARY_UNION_OF_UNIONS THEN
    ASM SET_TAC [])

  let ISTOPOLOGY_BASE_EQ ← prove
   r"!P:(A->bool)->bool.
        istopology (ARBITRARY UNION_OF P) <=>
        (!s t. P s /\ P t ==> (ARBITRARY UNION_OF P) (s INTER t))"
   (REWRITE_TAC [ISTOPOLOGY_BASE_ALT, ARBITRARY_UNION_OF_INTER_EQ])

  let ISTOPOLOGY_BASE ← prove
   r"!P:(A->bool)->bool.
        (!s t. P s /\ P t ==> P(s INTER t))
        ==> istopology (ARBITRARY UNION_OF P)"
   (REWRITE_TAC [ISTOPOLOGY_BASE_EQ] THEN
    MESON_TAC [ARBITRARY_UNION_OF_INC])

  let MINIMAL_TOPOLOGY_BASE ← prove
   r"!top:A topology P.
        (!s. P s ==> open_in top s) /\
        (!s t. P s /\ P t ==> P(s INTER t))
        ==> !s. open_in(topology(ARBITRARY UNION_OF P)) s ==> open_in top s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP ISTOPOLOGY_BASE) THEN
    SIMP_TAC [topology_tybij] THEN DISCH_THEN (K ALL_TAC) THEN
    ASM_SIMP_TAC [FORALL_UNION_OF, OPEN_IN_UNIONS])

  let OPEN_IN_TOPOLOGY_BASE_UNIQUE ← prove
   r"!top:A topology B.
        open_in top = ARBITRARY UNION_OF B <=>
        (!v. v IN B ==> open_in top v) /\
        (!u x. open_in top u /\ x IN u
               ==> ?v. v IN B /\ x IN v /\ v SUBSET u)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN DISCH_TAC THEN REPEAT CONJ_TAC THENL
     [ASM_REWRITE_TAC [ARBITRARY_UNION_OF_INC, IN],
      ASM_REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_UNION_OF, ARBITRARY, SUBSET, IN_UNIONS] THEN SET_TAC [],
      REWRITE_TAC [FUN_EQ_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
      ASM_REWRITE_TAC [FORALL_UNION_OF, ARBITRARY, FORALL_AND_THM] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        REWRITE_TAC [UNION_OF, ARBITRARY] THEN
        EXISTS_TAC (← q r"{v:A->bool | v IN B /\ v SUBSET u}") THEN
        REWRITE_TAC [UNIONS_GSPEC, IN_ELIM_THM] THEN ASM SET_TAC [],
        REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC []]])

  let TOPOLOGY_BASE_UNIQUE ← prove
   r"!top:A topology P.
        (!s. P s ==> open_in top s) /\
        (!u x. open_in top u /\ x IN u ==> ?b. P b /\ x IN b /\ b SUBSET u)
        ==> topology(ARBITRARY UNION_OF P) = top"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC (← MESON [topology_tybij] (← q
     r"open_in top = P ==> topology P = top")) THEN
    REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE] THEN ASM SET_TAC [])

  let TOPOLOGY_BASES_EQ ← prove
   r"!P Q.
        (!u x. P u /\ x IN u ==> ?v. Q v /\ x IN v /\ v SUBSET u) /\
        (!v x. Q v /\ x IN v ==> ?u. P u /\ x IN u /\ u SUBSET v)
        ==> topology (ARBITRARY UNION_OF P) =
            topology (ARBITRARY UNION_OF Q)"
   (REPEAT STRIP_TAC THEN AP_TERM_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
    CONJ_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM ARBITRARY_UNION_OF_IDEMPOT] THEN
    REWRITE_TAC [SUBSET, IN] THEN GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] UNION_OF_MONO) THEN
    REWRITE_TAC [ARBITRARY_UNION_OF_ALT] THEN ASM SET_TAC [])

  let ISTOPOLOGY_SUBBASE ← prove
   r"!P s:A->bool.
     istopology (ARBITRARY UNION_OF (FINITE INTERSECTION_OF P relative_to s))"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC ISTOPOLOGY_BASE THEN
    MATCH_MP_TAC RELATIVE_TO_INTER THEN
    REWRITE_TAC [FINITE_INTERSECTION_OF_INTER])

  let OPEN_IN_SUBBASE ← prove
   r"!B u s:A->bool.
        open_in (topology
           (ARBITRARY UNION_OF (FINITE INTERSECTION_OF B relative_to u))) s <=>
        (ARBITRARY UNION_OF (FINITE INTERSECTION_OF B relative_to u)) s"
   (GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 topology_tybij), ← GSYM FUN_EQ_THM, ETA_AX] THEN
    REWRITE_TAC [ISTOPOLOGY_SUBBASE])

  let TOPSPACE_SUBBASE ← prove
   r"!B u:A->bool.
        topspace(topology
           (ARBITRARY UNION_OF (FINITE INTERSECTION_OF B relative_to u))) = u"
   (REWRITE_TAC [OPEN_IN_SUBBASE, topspace, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REPEAT STRIP_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET, IN_ELIM_THM, FORALL_UNION_OF] THEN
      GEN_TAC THEN REWRITE_TAC [ARBITRARY] THEN MATCH_MP_TAC (← MESON [] (← q
       r"(!x. Q x ==> R x) ==> (!x. P x ==> Q x) ==> (!x. P x ==> R x)")) THEN
      REWRITE_TAC [FORALL_RELATIVE_TO, INTER_SUBSET],
      MATCH_MP_TAC (← sr r"x IN s ==> x SUBSET UNIONS s") THEN
      REWRITE_TAC [UNION_OF, ARBITRARY, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"{u:A->bool}") THEN REWRITE_TAC [UNIONS_1] THEN
      REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, relative_to] THEN
      EXISTS_TAC (← q r"(:A)") THEN REWRITE_TAC [INTER_UNIV] THEN
      REWRITE_TAC [INTERSECTION_OF] THEN EXISTS_TAC (← q r"{}:(A->bool)->bool") THEN
      REWRITE_TAC [FINITE_EMPTY, NOT_IN_EMPTY, INTERS_0]])

  let MINIMAL_TOPOLOGY_SUBBASE ← prove
   r"!top:A topology u P.
        (!s. P s ==> open_in top s) /\ open_in top u
        ==> !s. open_in(topology(ARBITRARY UNION_OF
                       (FINITE INTERSECTION_OF P relative_to u))) s
                ==> open_in top s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    SIMP_TAC [← REWRITE_RULE [topology_tybij] ISTOPOLOGY_SUBBASE] THEN
    REWRITE_TAC [FORALL_UNION_OF, ARBITRARY] THEN
    X_GEN_TAC (← q r"v:(A->bool)->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC OPEN_IN_UNIONS THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← sr r"(!x. P x ==> Q x)
              ==> (!x. Q x ==> R x) ==> (!x. P x ==> R x)")) THEN
    REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_INSERT] THEN
    MATCH_MP_TAC OPEN_IN_INTERS THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, FINITE_INSERT, NOT_INSERT_EMPTY] THEN
    ASM_MESON_TAC [])

  let ISTOPOLOGY_SUBBASE_UNIV ← prove
   r"!P:(A->bool)->bool.
       istopology (ARBITRARY UNION_OF (FINITE INTERSECTION_OF P))"
   (GEN_TAC THEN MATCH_MP_TAC ISTOPOLOGY_BASE THEN
    REWRITE_TAC [FINITE_INTERSECTION_OF_INTER])

  let hereditarily ← new_definition
   r"hereditarily P (top:A topology) <=>
        !s. s SUBSET topspace top ==> P(subtopology top s)"

  let HEREDITARILY ← prove
   r"!P top:A topology.
        hereditarily P top <=> !s. P(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hereditarily] THEN
    EQ_TAC THEN DISCH_TAC THEN ASM_REWRITE_TAC [] THEN GEN_TAC THEN
    ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN REWRITE_TAC [INTER_SUBSET])

  let HEREDITARILY_MONO ← prove
   r"!P Q:A topology->bool.
        (!top. P top ==> Q t)
        ==> (!top:A topology. hereditarily P top ==> hereditarily P top)"
   (REWRITE_TAC [hereditarily] THEN MESON_TAC [])

  let HEREDITARILY_INC ← prove
   r"!P:A topology->bool. hereditarily P top ==> P top"
   (REWRITE_TAC [HEREDITARILY] THEN MESON_TAC [SUBTOPOLOGY_TOPSPACE])

  let HEREDITARILY_SUBTOPOLOGY ← prove
   r"!P top s:A->bool.
        hereditarily P top ==> hereditarily P (subtopology top s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [HEREDITARILY] THEN
    SIMP_TAC [SUBTOPOLOGY_SUBTOPOLOGY])

  return { ISTOPOLOGY_BASE_ALT, ISTOPOLOGY_BASE_EQ, ISTOPOLOGY_BASE, MINIMAL_TOPOLOGY_BASE,
           OPEN_IN_TOPOLOGY_BASE_UNIQUE, TOPOLOGY_BASE_UNIQUE, TOPOLOGY_BASES_EQ,
           ISTOPOLOGY_SUBBASE, OPEN_IN_SUBBASE, TOPSPACE_SUBBASE, MINIMAL_TOPOLOGY_SUBBASE,
           ISTOPOLOGY_SUBBASE_UNIV, hereditarily, HEREDITARILY, HEREDITARILY_MONO,
           HEREDITARILY_INC, HEREDITARILY_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Derived set (set of limit points).  (metric.ml 935-1079)                  -/
/- ------------------------------------------------------------------------- -/

structure Derived where
  derived_set_of : thm
  DERIVED_SET_OF_RESTRICT : thm
  IN_DERIVED_SET_OF : thm
  DERIVED_SET_OF_SUBSET_TOPSPACE : thm
  DERIVED_SET_OF_SUBTOPOLOGY : thm
  DERIVED_SET_OF_SUBSET_SUBTOPOLOGY : thm
  DERIVED_SET_OF_EMPTY : thm
  DERIVED_SET_OF_MONO : thm
  DERIVED_SET_OF_UNION : thm
  DERIVED_SET_OF_UNIONS : thm
  DERIVED_SET_OF_TOPSPACE : thm
  DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN : thm
  OPEN_IN_INTER_DERIVED_SET_OF_SUBSET : thm
  OPEN_IN_INTER_DERIVED_SET_OF_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupDerived [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) : ExceptT String IO Derived := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, parse_as_infix, .. } := D
  let { EXTENSION, FINITE_INDUCT_STRONG, IMAGE_CLAUSES, .. } := D.core1
  let { INTER_SUBSET, IN_ELIM_THM, IN_INTER, IN_UNION, LEFT_IMP_EXISTS_THM, NOT_FORALL_THM,
        NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_UNION, SWAP_FORALL_THM,
        UNIONS_0, UNIONS_INSERT, UNION_SUBSET, .. } := D.core4
  let { CONTRAPOS_THM, DE_MORGAN_THM, FORALL_UNWIND_THM2, RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { DISCRETE_TOPOLOGY_UNIQUE, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_RESTRICT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("derived_set_of", (21, "right"))

  let derived_set_of ← new_definition
   r"top derived_set_of s =
   {x:A | x IN topspace top /\
          (!t. x IN t /\ open_in top t
               ==> ?y. ~(y = x) /\ y IN s /\ y IN t)}"

  let DERIVED_SET_OF_RESTRICT ← prove
   r"!top s:A->bool.
     top derived_set_of s = top derived_set_of (topspace top INTER s)"
   (REWRITE_TAC [derived_set_of, EXTENSION, IN_ELIM_THM, IN_INTER] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let IN_DERIVED_SET_OF ← prove
   r"!top s x:A.
     x IN top derived_set_of s <=>
     x IN topspace top /\
     (!t. x IN t /\ open_in top t ==> ?y. ~(y = x) /\ y IN s /\ y IN t)"
   (REWRITE_TAC [derived_set_of, IN_ELIM_THM])

  let DERIVED_SET_OF_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. top derived_set_of s SUBSET topspace top"
   (REWRITE_TAC [derived_set_of] THEN SET_TAC [])

  let DERIVED_SET_OF_SUBTOPOLOGY ← prove
   r"!top u s:A->bool.
        (subtopology top u) derived_set_of s =
        u INTER top derived_set_of (u INTER s)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [derived_set_of, OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM, IN_ELIM_THM] THEN
    ONCE_REWRITE_TAC [SWAP_FORALL_THM] THEN ONCE_REWRITE_TAC [← TAUT (← q
     r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")] THEN
    REWRITE_TAC [FORALL_UNWIND_THM2, IN_INTER, IN_ELIM_THM] THEN
    ASM SET_TAC [])

  let DERIVED_SET_OF_SUBSET_SUBTOPOLOGY ← prove
   r"!top s t:A->bool. (subtopology top s) derived_set_of t SUBSET s"
   (SIMP_TAC [DERIVED_SET_OF_SUBTOPOLOGY, INTER_SUBSET])

  let DERIVED_SET_OF_EMPTY ← prove
   r"!top:A topology. top derived_set_of {} = {}"
   (REWRITE_TAC [EXTENSION, IN_DERIVED_SET_OF, NOT_IN_EMPTY] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let DERIVED_SET_OF_MONO ← prove
   r"!top s t:A->bool.
        s SUBSET t ==> top derived_set_of s SUBSET top derived_set_of t"
   (REWRITE_TAC [derived_set_of] THEN SET_TAC [])

  let DERIVED_SET_OF_UNION ← prove
   r"!top s t:A->bool.
       top derived_set_of (s UNION t) =
       top derived_set_of s UNION top derived_set_of t"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, UNION_SUBSET, DERIVED_SET_OF_MONO,
              SUBSET_UNION] THEN
    REWRITE_TAC [SUBSET, IN_DERIVED_SET_OF, IN_UNION] THEN
    X_GEN_TAC (← q r"x:A") THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    ASM_REWRITE_TAC [] THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [DE_MORGAN_THM, NOT_FORALL_THM, NOT_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"u:A->bool")) (X_CHOOSE_TAC (← q r"v:A->bool"))) THEN
    EXISTS_TAC (← q r"u INTER v:A->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER] THEN ASM_MESON_TAC [])

  let DERIVED_SET_OF_UNIONS ← prove
   r"!top (f:(A->bool)->bool).
        FINITE f
        ==> top derived_set_of (UNIONS f) =
            UNIONS {top derived_set_of s | s IN f}"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, NOT_IN_EMPTY, UNIONS_INSERT, DERIVED_SET_OF_EMPTY,
              DERIVED_SET_OF_UNION, SIMPLE_IMAGE, IMAGE_CLAUSES])

  let DERIVED_SET_OF_TOPSPACE ← prove
   r"!top:A topology.
        top derived_set_of (topspace top) =
        {x | x IN topspace top /\ ~open_in top {x}}"
   (GEN_TAC THEN REWRITE_TAC [EXTENSION, derived_set_of, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{a:A}")) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"u = {a:A}") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET ← prove
   r"!top u:A->bool.
        discrete_topology u = top <=>
        topspace top = u /\ top derived_set_of u = {}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE] THEN
    ASM_CASES_TAC (← q r"u:A->bool = topspace top") THEN
    ASM_REWRITE_TAC [DERIVED_SET_OF_TOPSPACE] THEN SET_TAC [])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ ← prove
   r"!top u:A->bool.
        subtopology top u = discrete_topology u <=>
        u SUBSET topspace top /\ u INTER top derived_set_of u = {}"
   (REPEAT GEN_TAC THEN CONV_TAC (LAND_CONV SYM_CONV) THEN
    REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, DERIVED_SET_OF_SUBTOPOLOGY] THEN
    REWRITE_TAC [← sr r"u INTER u = u"] THEN SET_TAC [])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY ← prove
   r"!top s:A->bool.
        s SUBSET topspace top /\ s INTER top derived_set_of s = {}
        ==> subtopology top s = discrete_topology s"
   (REWRITE_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN ← prove
   r"!top s:A->bool.
        s INTER top derived_set_of s = {}
        ==> subtopology top s = discrete_topology(topspace top INTER s)"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN
    MATCH_MP_TAC SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY THEN
    REWRITE_TAC [← GSYM DERIVED_SET_OF_RESTRICT] THEN ASM SET_TAC [])

  let OPEN_IN_INTER_DERIVED_SET_OF_SUBSET ← prove
   r"!top s t:A->bool.
       open_in top s
       ==> s INTER top derived_set_of t SUBSET top derived_set_of (s INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [derived_set_of] THEN
    REWRITE_TAC [SUBSET, IN_INTER, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s INTER u:A->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, IN_INTER] THEN MESON_TAC [])

  let OPEN_IN_INTER_DERIVED_SET_OF_EQ ← prove
   r"!top s t:A->bool.
        open_in top s
        ==> s INTER top derived_set_of t =
            s INTER top derived_set_of (s INTER t)"
   (SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, INTER_SUBSET, SUBSET_INTER] THEN
    SIMP_TAC [OPEN_IN_INTER_DERIVED_SET_OF_SUBSET] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← sr r"s SUBSET t ==> u INTER s SUBSET t") THEN
    MATCH_MP_TAC DERIVED_SET_OF_MONO THEN SET_TAC [])

  return { derived_set_of, DERIVED_SET_OF_RESTRICT, IN_DERIVED_SET_OF,
           DERIVED_SET_OF_SUBSET_TOPSPACE, DERIVED_SET_OF_SUBTOPOLOGY,
           DERIVED_SET_OF_SUBSET_SUBTOPOLOGY, DERIVED_SET_OF_EMPTY, DERIVED_SET_OF_MONO,
           DERIVED_SET_OF_UNION, DERIVED_SET_OF_UNIONS, DERIVED_SET_OF_TOPSPACE,
           DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ,
           SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN,
           OPEN_IN_INTER_DERIVED_SET_OF_SUBSET, OPEN_IN_INTER_DERIVED_SET_OF_EQ }

/- ------------------------------------------------------------------------- -/
/- Closure with respect to a topological space.  (metric.ml 1081-1439)       -/
/- ------------------------------------------------------------------------- -/

structure Closure where
  closure_of : thm
  CLOSURE_OF_RESTRICT : thm
  IN_CLOSURE_OF : thm
  CLOSURE_OF : thm
  CLOSURE_OF_ALT : thm
  DERIVED_SET_OF_SUBSET_CLOSURE_OF : thm
  CLOSURE_OF_SUBTOPOLOGY : thm
  CLOSURE_OF_EMPTY : thm
  CLOSURE_OF_TOPSPACE : thm
  CLOSURE_OF_UNIV : thm
  CLOSURE_OF_SUBSET_TOPSPACE : thm
  CLOSURE_OF_SUBSET_SUBTOPOLOGY : thm
  CLOSURE_OF_MONO : thm
  CLOSURE_OF_SUBTOPOLOGY_SUBSET : thm
  CLOSURE_OF_SUBTOPOLOGY_MONO : thm
  CLOSURE_OF_UNION : thm
  CLOSURE_OF_UNIONS : thm
  CLOSURE_OF_SUBSET : thm
  CLOSURE_OF_SUBSET_INTER : thm
  CLOSURE_OF_SUBSET_EQ : thm
  CLOSURE_OF_EQ : thm
  CLOSED_IN_CONTAINS_DERIVED_SET : thm
  DERIVED_SET_SUBSET_GEN : thm
  DERIVED_SET_SUBSET : thm
  CLOSED_IN_DERIVED_SET : thm
  CLOSED_IN_INTER_CLOSURE_OF : thm
  CLOSURE_OF_CLOSED_IN : thm
  CLOSED_IN_CLOSURE_OF : thm
  CLOSURE_OF_CLOSURE_OF : thm
  CLOSURE_OF_HULL : thm
  CLOSURE_OF_MINIMAL : thm
  CLOSURE_OF_MINIMAL_EQ : thm
  CLOSURE_OF_UNIQUE : thm
  FORALL_IN_CLOSURE_OF_GEN : thm
  FORALL_IN_CLOSURE_OF : thm
  FORALL_IN_CLOSURE_OF_UNIV : thm
  CLOSURE_OF_EQ_EMPTY_GEN : thm
  CLOSURE_OF_EQ_EMPTY : thm
  OPEN_IN_INTER_CLOSURE_OF_SUBSET : thm
  CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF : thm
  OPEN_IN_INTER_CLOSURE_OF_EQ : thm
  OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY : thm
  CLOSURE_OF_OPEN_IN_INTER_SUPERSET : thm
  CLOSURE_OF_OPEN_IN_SUBTOPOLOGY_INTER_CLOSURE_OF : thm
  CLOSURE_OF_SUBTOPOLOGY_OPEN : thm
  DISCRETE_TOPOLOGY_CLOSURE_OF : thm
  deriving Inhabited

@[nospecialize]
def setupClosure [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BDerived : Derived) : ExceptT String IO Closure := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, FIX_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition,
        parse_as_infix, .. } := D
  let { DISJOINT, EXTENSION, FINITE_INDUCT_STRONG, FORALL_IN_GSPEC, IMAGE_CLAUSES, .. } := D.core1
  let { INTER_EMPTY, INTER_SUBSET, IN_ELIM_THM, IN_INTER, IN_UNION, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_TRANS,
        SUBSET_UNION, UNIONS_0, UNIONS_GSPEC, UNIONS_INSERT, .. } := D.core4
  let { HULL_UNIQUE, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE,
        OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, closed_in,
        .. } := BTopology
  let { CLOSED_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { DERIVED_SET_OF_RESTRICT, DERIVED_SET_OF_SUBSET_TOPSPACE, DERIVED_SET_OF_SUBTOPOLOGY,
        DERIVED_SET_OF_UNION, IN_DERIVED_SET_OF, OPEN_IN_INTER_DERIVED_SET_OF_SUBSET,
        .. } := BDerived
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("closure_of", (21, "right"))

  let closure_of ← new_definition
   r"top closure_of s =
   {x:A | x IN topspace top /\
          (!t. x IN t /\ open_in top t ==> ?y. y IN s /\ y IN t)}"

  let CLOSURE_OF_RESTRICT ← prove
   r"!top s:A->bool. top closure_of s = top closure_of (topspace top INTER s)"
   (REWRITE_TAC [closure_of, EXTENSION, IN_ELIM_THM, IN_INTER] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let IN_CLOSURE_OF ← prove
   r"!top s x:A.
     x IN top closure_of s <=>
     x IN topspace top /\
     (!t. x IN t /\ open_in top t ==> ?y. y IN s /\ y IN t)"
   (REWRITE_TAC [closure_of, IN_ELIM_THM])

  let CLOSURE_OF ← prove
   r"!top s:A->bool.
     top closure_of s =
     topspace top INTER (s UNION top derived_set_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EXTENSION] THEN FIX_TAC "[x]" THEN
    REWRITE_TAC [IN_CLOSURE_OF, IN_DERIVED_SET_OF, IN_UNION, IN_INTER] THEN
    ASM_CASES_TAC (← q r"x:A IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (LABEL_TAC "x_ok") THEN MESON_TAC [])

  let CLOSURE_OF_ALT ← prove
   r"!top s:A->bool.
        top closure_of s = topspace top INTER s UNION top derived_set_of s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSURE_OF] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
          DERIVED_SET_OF_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let DERIVED_SET_OF_SUBSET_CLOSURE_OF ← prove
   r"!top s:A->bool. top derived_set_of s SUBSET top closure_of s"
   (REWRITE_TAC [CLOSURE_OF, SUBSET_INTER, DERIVED_SET_OF_SUBSET_TOPSPACE] THEN
    SIMP_TAC [SUBSET_UNION])

  let CLOSURE_OF_SUBTOPOLOGY ← prove
   r"!top u s:A->bool.
      (subtopology top u) closure_of s = u INTER (top closure_of (u INTER s))"
   (SIMP_TAC [CLOSURE_OF, TOPSPACE_SUBTOPOLOGY, DERIVED_SET_OF_SUBTOPOLOGY] THEN
    SET_TAC [])

  let CLOSURE_OF_EMPTY ← prove
   r"!top. top closure_of {}:A->bool = {}"
   (REWRITE_TAC [EXTENSION, IN_CLOSURE_OF, NOT_IN_EMPTY] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let CLOSURE_OF_TOPSPACE ← prove
   r"!top:A topology. top closure_of topspace top = topspace top"
   (REWRITE_TAC [EXTENSION, IN_CLOSURE_OF] THEN MESON_TAC [])

  let CLOSURE_OF_UNIV ← prove
   r"!top. top closure_of (:A) = topspace top"
   (REWRITE_TAC [closure_of] THEN SET_TAC [])

  let CLOSURE_OF_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. top closure_of s SUBSET topspace top"
   (REWRITE_TAC [closure_of] THEN SET_TAC [])

  let CLOSURE_OF_SUBSET_SUBTOPOLOGY ← prove
   r"!top s t:A->bool. (subtopology top s) closure_of t SUBSET s"
   (REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, closure_of] THEN SET_TAC [])

  let CLOSURE_OF_MONO ← prove
   r"!top s t:A->bool.
        s SUBSET t ==> top closure_of s SUBSET top closure_of t"
   (REWRITE_TAC [closure_of] THEN SET_TAC [])

  let CLOSURE_OF_SUBTOPOLOGY_SUBSET ← prove
   r"!top s u:A->bool.
        (subtopology top u) closure_of s SUBSET (top closure_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
    MATCH_MP_TAC (← sr r"t SUBSET u ==> s INTER t SUBSET u") THEN
    MATCH_MP_TAC CLOSURE_OF_MONO THEN REWRITE_TAC [INTER_SUBSET])

  let CLOSURE_OF_SUBTOPOLOGY_MONO ← prove
   r"!top s t u:A->bool.
        t SUBSET u
        ==> (subtopology top t) closure_of s SUBSET
            (subtopology top u) closure_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
    MATCH_MP_TAC (← sr
     r"s SUBSET s' /\ t SUBSET t' ==> s INTER t SUBSET s' INTER t'") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC CLOSURE_OF_MONO THEN
    ASM SET_TAC [])

  let CLOSURE_OF_UNION ← prove
   r"!top s t:A->bool.
       top closure_of (s UNION t) = top closure_of s UNION top closure_of t"
   (REWRITE_TAC [CLOSURE_OF, DERIVED_SET_OF_UNION] THEN SET_TAC [])

  let CLOSURE_OF_UNIONS ← prove
   r"!top (f:(A->bool)->bool).
        FINITE f
        ==> top closure_of (UNIONS f) =  UNIONS {top closure_of s | s IN f}"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [UNIONS_0, NOT_IN_EMPTY, UNIONS_INSERT, CLOSURE_OF_EMPTY,
              CLOSURE_OF_UNION, SIMPLE_IMAGE, IMAGE_CLAUSES])

  let CLOSURE_OF_SUBSET ← prove
   r"!top s:A->bool. s SUBSET topspace top ==> s SUBSET top closure_of s"
   (REWRITE_TAC [CLOSURE_OF] THEN SET_TAC [])

  let CLOSURE_OF_SUBSET_INTER ← prove
   r"!top s:A->bool. topspace top INTER s SUBSET top closure_of s"
   (REWRITE_TAC [CLOSURE_OF] THEN SET_TAC [])

  let CLOSURE_OF_SUBSET_EQ ← prove
   r"!top s:A->bool.
     s SUBSET topspace top /\ top closure_of s SUBSET s <=> closed_in top s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN
    ASM_REWRITE_TAC [closed_in, SUBSET, closure_of, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC RAND_CONV [OPEN_IN_SUBOPEN] THEN
    MP_TAC (← ISPEC (← q r"top:A topology") OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let CLOSURE_OF_EQ ← prove
   r"!top s:A->bool. top closure_of s = s <=> closed_in top s"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THENL
     [ASM_MESON_TAC [SUBSET_ANTISYM_EQ, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_EQ],
      ASM_MESON_TAC [CLOSED_IN_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE]])

  let CLOSED_IN_CONTAINS_DERIVED_SET ← prove
   r"!top s:A->bool.
        closed_in top s <=>
        top derived_set_of s SUBSET s /\ s SUBSET topspace top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, CLOSURE_OF] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
      DERIVED_SET_OF_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let DERIVED_SET_SUBSET_GEN ← prove
   r"!top s:A->bool.
        top derived_set_of s SUBSET s <=>
        closed_in top (topspace top INTER s)"
   (REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET, INTER_SUBSET] THEN
    REWRITE_TAC [← GSYM DERIVED_SET_OF_RESTRICT, SUBSET_INTER] THEN
    REWRITE_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE])

  let DERIVED_SET_SUBSET ← prove
   r"!top s:A->bool.
        s SUBSET topspace top
        ==> (top derived_set_of s SUBSET s <=> closed_in top s)"
   (SIMP_TAC [CLOSED_IN_CONTAINS_DERIVED_SET])

  let CLOSED_IN_DERIVED_SET ← prove
   r"!top s t:A->bool.
        closed_in (subtopology top t) s <=>
        s SUBSET topspace top /\ s SUBSET t /\
        !x. x IN top derived_set_of s /\ x IN t ==> x IN s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    REWRITE_TAC [DERIVED_SET_OF_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"t INTER s:A->bool = s") THEN ASM_REWRITE_TAC [] THEN
    ASM SET_TAC [])

  let CLOSED_IN_INTER_CLOSURE_OF ← prove
   r"!top s t:A->bool.
        closed_in (subtopology top s) t <=> s INTER top closure_of t = t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSURE_OF, CLOSED_IN_DERIVED_SET] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"]
          DERIVED_SET_OF_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let CLOSURE_OF_CLOSED_IN ← prove
   r"!top s:A->bool. closed_in top s ==> top closure_of s = s"
   (REWRITE_TAC [CLOSURE_OF_EQ])

  let CLOSED_IN_CLOSURE_OF ← prove
   r"!top s:A->bool. closed_in top (top closure_of s)"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"top closure_of (s:A->bool) =
    topspace top DIFF
    UNIONS {t | open_in top t /\ DISJOINT s t}")
    SUBST1_TAC THENL
     [REWRITE_TAC [closure_of, UNIONS_GSPEC] THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
      SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_GSPEC]])

  let CLOSURE_OF_CLOSURE_OF ← prove
   r"!top s:A->bool. top closure_of (top closure_of s) = top closure_of s"
   (REWRITE_TAC [CLOSURE_OF_EQ, CLOSED_IN_CLOSURE_OF])

  let CLOSURE_OF_HULL ← prove
   r"!top s:A->bool.
        s SUBSET topspace top ==> top closure_of s = (closed_in top) hull s"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC HULL_UNIQUE THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, CLOSED_IN_CLOSURE_OF] THEN
    ASM_MESON_TAC [CLOSURE_OF_EQ, CLOSURE_OF_MONO])

  let CLOSURE_OF_MINIMAL ← prove
   r"!top s t:A->bool.
        s SUBSET t /\ closed_in top t ==> (top closure_of s) SUBSET t"
   (ASM_MESON_TAC [CLOSURE_OF_EQ, CLOSURE_OF_MONO])

  let CLOSURE_OF_MINIMAL_EQ ← prove
   r"!top s t:A->bool.
        s SUBSET topspace top /\ closed_in top t
        ==> ((top closure_of s) SUBSET t <=> s SUBSET t)"
   (MESON_TAC [SUBSET_TRANS, CLOSURE_OF_SUBSET, CLOSURE_OF_MINIMAL])

  let CLOSURE_OF_UNIQUE ← prove
   r"!top s t. s SUBSET t /\ closed_in top t /\
             (!t'. s SUBSET t' /\ closed_in top t' ==> t SUBSET t')
             ==> top closure_of s = t"
   (REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) CLOSURE_OF_HULL o lhand o snd) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET_TRANS],
      DISCH_THEN SUBST1_TAC] THEN
    MATCH_MP_TAC HULL_UNIQUE THEN ASM_REWRITE_TAC [])

  let FORALL_IN_CLOSURE_OF_GEN ← prove
   r"!top P s:A->bool.
         (!x. x IN s ==> P x) /\
         closed_in top {x | x IN top closure_of s /\ P x}
         ==> (!x. x IN top closure_of s ==> P x)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    STRIP_TAC THEN
    REWRITE_TAC [← sr
     r"(!x. x IN s ==> P x) <=> s SUBSET {x | x IN s /\ P x}"] THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top INTER s:A->bool"]
          CLOSURE_OF_SUBSET) THEN
    ASM SET_TAC [])

  let FORALL_IN_CLOSURE_OF ← prove
   r"!top P s:A->bool.
         (!x. x IN s ==> P x) /\
         closed_in top {x | x IN topspace top /\ P x}
         ==> (!x. x IN top closure_of s ==> P x)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC FORALL_IN_CLOSURE_OF_GEN THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"{x:A | x IN top closure_of s /\ P x} =
                top closure_of s INTER {x | x IN topspace top /\ P x}")
     (fun th => ASM_SIMP_TAC [th, CLOSED_IN_INTER, CLOSED_IN_CLOSURE_OF]) THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let FORALL_IN_CLOSURE_OF_UNIV ← prove
   r"!top P s:A->bool.
        (!x. x IN s ==> P x) /\ closed_in top {x | P x}
        ==> !x. x IN top closure_of s ==> P x"
   (REWRITE_TAC [← sr r"(!x. x IN s ==> P x) <=> s SUBSET {x | P x}"] THEN
    SIMP_TAC [CLOSURE_OF_MINIMAL])

  let CLOSURE_OF_EQ_EMPTY_GEN ← prove
   r"!top s:A->bool.
        top closure_of s = {} <=> DISJOINT (topspace top) s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT, DISJOINT] THEN
    EQ_TAC THEN SIMP_TAC [CLOSURE_OF_EMPTY] THEN
    MATCH_MP_TAC (← sr r"t SUBSET s ==> s = {} ==> t = {}") THEN
    MATCH_MP_TAC CLOSURE_OF_SUBSET THEN REWRITE_TAC [INTER_SUBSET])

  let CLOSURE_OF_EQ_EMPTY ← prove
   r"!top s:A->bool.
        s SUBSET topspace top ==> (top closure_of s = {} <=> s = {})"
   (REWRITE_TAC [CLOSURE_OF_EQ_EMPTY_GEN] THEN SET_TAC [])

  let OPEN_IN_INTER_CLOSURE_OF_SUBSET ← prove
   r"!top s t:A->bool.
        open_in top s
        ==> s INTER top closure_of t SUBSET top closure_of (s INTER t)"
   (REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o SPEC (← q r"t:A->bool") o MATCH_MP
      OPEN_IN_INTER_DERIVED_SET_OF_SUBSET) THEN
    REWRITE_TAC [CLOSURE_OF] THEN SET_TAC [])

  let CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF ← prove
   r"!top s t:A->bool.
        open_in top s
        ==> top closure_of (s INTER top closure_of t) =
            top closure_of (s INTER t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN
      ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_SUBSET],
      MATCH_MP_TAC CLOSURE_OF_MONO THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top INTER t:A->bool"]
          CLOSURE_OF_SUBSET) THEN
      REWRITE_TAC [INTER_SUBSET, ← GSYM CLOSURE_OF_RESTRICT] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      SET_TAC []])

  let OPEN_IN_INTER_CLOSURE_OF_EQ ← prove
   r"!top s t:A->bool.
        open_in top s
        ==> s INTER top closure_of t = s INTER top closure_of (s INTER t)"
   (SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, INTER_SUBSET, SUBSET_INTER] THEN
    SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_SUBSET] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC (← sr r"s SUBSET t ==> u INTER s SUBSET t") THEN
    MATCH_MP_TAC CLOSURE_OF_MONO THEN SET_TAC [])

  let OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY ← prove
   r"!top s t:A->bool.
        open_in top s ==> (s INTER top closure_of t = {} <=> s INTER t = {})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SPEC (← q r"t:A->bool") o
        MATCH_MP OPEN_IN_INTER_CLOSURE_OF_EQ) THEN
    EQ_TAC THEN SIMP_TAC [CLOSURE_OF_EMPTY, INTER_EMPTY] THEN
    MATCH_MP_TAC (← sr
     r"s INTER t SUBSET c ==> s INTER c = {} ==> s INTER t = {}") THEN
    MATCH_MP_TAC CLOSURE_OF_SUBSET THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [])

  let CLOSURE_OF_OPEN_IN_INTER_SUPERSET ← prove
   r"!top s t:A->bool.
        open_in top s /\ s SUBSET top closure_of t
        ==> top closure_of (s INTER t) = top closure_of s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o SPEC (← q r"t:A->bool") o
      MATCH_MP CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF) THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let CLOSURE_OF_OPEN_IN_SUBTOPOLOGY_INTER_CLOSURE_OF ← prove
   r"!top s t u:A->bool.
        open_in (subtopology top u) s /\ t SUBSET u
        ==> top closure_of (s INTER top closure_of t) =
            top closure_of (s INTER t)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_SUBTOPOLOGY]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"t:A->bool") o
        MATCH_MP CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF) THEN
      ASM_SIMP_TAC [← sr
       r"t SUBSET u ==> (v INTER u) INTER t = v INTER t"] THEN
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      MATCH_MP_TAC CLOSURE_OF_MONO THEN SET_TAC [],
      MATCH_MP_TAC CLOSURE_OF_MONO THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top INTER t:A->bool"]
          CLOSURE_OF_SUBSET) THEN
      REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT, INTER_SUBSET] THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC []])

  let CLOSURE_OF_SUBTOPOLOGY_OPEN ← prove
   r"!top u s:A->bool.
        open_in top u \/ s SUBSET u
        ==> (subtopology top u) closure_of s = u INTER top closure_of s"
   (REWRITE_TAC [← sr r"s SUBSET u <=> u INTER s = s"] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
    ASM_MESON_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ])

  let DISCRETE_TOPOLOGY_CLOSURE_OF ← prove
   r"!u s:A->bool. (discrete_topology u) closure_of s = u INTER s"
   (ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, CLOSURE_OF_EQ] THEN
    REWRITE_TAC [CLOSED_IN_DISCRETE_TOPOLOGY, INTER_SUBSET])

  return { closure_of, CLOSURE_OF_RESTRICT, IN_CLOSURE_OF, CLOSURE_OF, CLOSURE_OF_ALT,
           DERIVED_SET_OF_SUBSET_CLOSURE_OF, CLOSURE_OF_SUBTOPOLOGY, CLOSURE_OF_EMPTY,
           CLOSURE_OF_TOPSPACE, CLOSURE_OF_UNIV, CLOSURE_OF_SUBSET_TOPSPACE,
           CLOSURE_OF_SUBSET_SUBTOPOLOGY, CLOSURE_OF_MONO, CLOSURE_OF_SUBTOPOLOGY_SUBSET,
           CLOSURE_OF_SUBTOPOLOGY_MONO, CLOSURE_OF_UNION, CLOSURE_OF_UNIONS, CLOSURE_OF_SUBSET,
           CLOSURE_OF_SUBSET_INTER, CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_EQ,
           CLOSED_IN_CONTAINS_DERIVED_SET, DERIVED_SET_SUBSET_GEN, DERIVED_SET_SUBSET,
           CLOSED_IN_DERIVED_SET, CLOSED_IN_INTER_CLOSURE_OF, CLOSURE_OF_CLOSED_IN,
           CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSURE_OF, CLOSURE_OF_HULL, CLOSURE_OF_MINIMAL,
           CLOSURE_OF_MINIMAL_EQ, CLOSURE_OF_UNIQUE, FORALL_IN_CLOSURE_OF_GEN,
           FORALL_IN_CLOSURE_OF, FORALL_IN_CLOSURE_OF_UNIV, CLOSURE_OF_EQ_EMPTY_GEN,
           CLOSURE_OF_EQ_EMPTY, OPEN_IN_INTER_CLOSURE_OF_SUBSET,
           CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF, OPEN_IN_INTER_CLOSURE_OF_EQ,
           OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, CLOSURE_OF_OPEN_IN_INTER_SUPERSET,
           CLOSURE_OF_OPEN_IN_SUBTOPOLOGY_INTER_CLOSURE_OF, CLOSURE_OF_SUBTOPOLOGY_OPEN,
           DISCRETE_TOPOLOGY_CLOSURE_OF }

/- ------------------------------------------------------------------------- -/
/- Interior with respect to a topological space.  (metric.ml 1441-1715)      -/
/- ------------------------------------------------------------------------- -/

structure Interior where
  interior_of : thm
  INTERIOR_OF_RESTRICT : thm
  INTERIOR_OF_EQ : thm
  INTERIOR_OF_OPEN_IN : thm
  INTERIOR_OF_EMPTY : thm
  INTERIOR_OF_TOPSPACE : thm
  OPEN_IN_INTERIOR_OF : thm
  INTERIOR_OF_INTERIOR_OF : thm
  INTERIOR_OF_SUBSET : thm
  INTERIOR_OF_SUBSET_CLOSURE_OF : thm
  SUBSET_INTERIOR_OF_EQ : thm
  INTERIOR_OF_MONO : thm
  INTERIOR_OF_MAXIMAL : thm
  INTERIOR_OF_MAXIMAL_EQ : thm
  INTERIOR_OF_UNIQUE : thm
  INTERIOR_OF_SUBSET_TOPSPACE : thm
  INTERIOR_OF_SUBSET_SUBTOPOLOGY : thm
  INTERIOR_OF_INTER : thm
  INTERIOR_OF_INTERS_SUBSET : thm
  UNION_INTERIOR_OF_SUBSET : thm
  INTERIOR_OF_EQ_EMPTY : thm
  INTERIOR_OF_EQ_EMPTY_ALT : thm
  INTERIOR_OF_UNIONS_OPEN_IN_SUBSETS : thm
  INTERIOR_OF_COMPLEMENT : thm
  INTERIOR_OF_CLOSURE_OF : thm
  CLOSURE_OF_INTERIOR_OF : thm
  CLOSURE_OF_COMPLEMENT : thm
  INTERIOR_OF_EQ_EMPTY_COMPLEMENT : thm
  CLOSURE_OF_EQ_UNIV : thm
  INTERIOR_OF_SUBTOPOLOGY_SUBSET : thm
  INTERIOR_OF_SUBTOPOLOGY_SUBSETS : thm
  INTERIOR_OF_SUBTOPOLOGY_MONO : thm
  INTERIOR_OF_SUBTOPOLOGY_OPEN : thm
  DENSE_INTERSECTS_OPEN : thm
  INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF : thm
  INTERIOR_OF_UNION_EQ_EMPTY : thm
  DISCRETE_TOPOLOGY_INTERIOR_OF : thm
  deriving Inhabited

@[nospecialize]
def setupInterior [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) : ExceptT String IO Interior := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, parse_as_infix, .. } := D
  let { EXTENSION, .. } := D.core1
  let { INTERS_GSPEC, INTER_SUBSET, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_INTERS, MONO_EXISTS,
        .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM, SUBSET_ANTISYM_EQ, SUBSET_EMPTY, SUBSET_INTER, SUBSET_TRANS,
        SUBSET_UNION, UNION_COMM, UNION_SUBSET, UNWIND_THM2, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, SWAP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF, CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_SUBTOPOLOGY_OPEN, OPEN_IN_INTER_CLOSURE_OF_EQ,
        closure_of, .. } := BClosure
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("interior_of", (21, "right"))

  let interior_of ← new_definition
   r"top interior_of s = {x | ?t. open_in top t /\ x IN t /\ t SUBSET s}"

  let INTERIOR_OF_RESTRICT ← prove
   r"!top s:A->bool.
        top interior_of s = top interior_of (topspace top INTER s)"
   (REWRITE_TAC [interior_of, EXTENSION, IN_ELIM_THM, SUBSET_INTER] THEN
    MESON_TAC [OPEN_IN_SUBSET])

  let INTERIOR_OF_EQ ← prove
   r"!top s:A->bool. (top interior_of s = s) <=> open_in top s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EXTENSION, interior_of, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC RAND_CONV [OPEN_IN_SUBOPEN] THEN MESON_TAC [SUBSET])

  let INTERIOR_OF_OPEN_IN ← prove
   r"!top s:a->bool. open_in top s ==> top interior_of s = s"
   (MESON_TAC [INTERIOR_OF_EQ])

  let INTERIOR_OF_EMPTY ← prove
   r"!top:A topology. top interior_of {} = {}"
   (REWRITE_TAC [INTERIOR_OF_EQ, OPEN_IN_EMPTY])

  let INTERIOR_OF_TOPSPACE ← prove
   r"!top:A topology. top interior_of (topspace top) = topspace top"
   (REWRITE_TAC [INTERIOR_OF_EQ, OPEN_IN_TOPSPACE])

  let OPEN_IN_INTERIOR_OF ← prove
   r"!top s:A->bool. open_in top (top interior_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [interior_of] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let INTERIOR_OF_INTERIOR_OF ← prove
   r"!top s:A->bool. top interior_of top interior_of s = top interior_of s"
   (REWRITE_TAC [INTERIOR_OF_EQ, OPEN_IN_INTERIOR_OF])

  let INTERIOR_OF_SUBSET ← prove
   r"!top s:A->bool. top interior_of s SUBSET s"
   (REWRITE_TAC [interior_of] THEN SET_TAC [])

  let INTERIOR_OF_SUBSET_CLOSURE_OF ← prove
   r"!top s:A->bool. top interior_of s SUBSET top closure_of s"
   (REPEAT GEN_TAC THEN
    ONCE_REWRITE_TAC [INTERIOR_OF_RESTRICT, CLOSURE_OF_RESTRICT] THEN
    TRANS_TAC SUBSET_TRANS (← q r"topspace top INTER s:A->bool") THEN
    SIMP_TAC [INTERIOR_OF_SUBSET, CLOSURE_OF_SUBSET, INTER_SUBSET])

  let SUBSET_INTERIOR_OF_EQ ← prove
   r"!top s:A->bool. s SUBSET top interior_of s <=> open_in top s"
   (SIMP_TAC [← GSYM INTERIOR_OF_EQ, ← GSYM SUBSET_ANTISYM_EQ, INTERIOR_OF_SUBSET])

  let INTERIOR_OF_MONO ← prove
   r"!top s t:A->bool.
        s SUBSET t ==> top interior_of s SUBSET top interior_of t"
   (REWRITE_TAC [interior_of] THEN SET_TAC [])

  let INTERIOR_OF_MAXIMAL ← prove
   r"!top s t:A->bool.
        t SUBSET s /\ open_in top t ==> t SUBSET top interior_of s"
   (REWRITE_TAC [interior_of] THEN SET_TAC [])

  let INTERIOR_OF_MAXIMAL_EQ ← prove
   r"!top s t:A->bool.
        open_in top t ==> (t SUBSET top interior_of s <=> t SUBSET s)"
   (MESON_TAC [INTERIOR_OF_MAXIMAL, SUBSET_TRANS, INTERIOR_OF_SUBSET])

  let INTERIOR_OF_UNIQUE ← prove
   r"!top s t:A->bool.
        t SUBSET s /\ open_in top t /\
        (!t'. t' SUBSET s /\ open_in top t' ==> t' SUBSET t)
        ==> top interior_of s = t"
   (MESON_TAC [SUBSET_ANTISYM, INTERIOR_OF_MAXIMAL, INTERIOR_OF_SUBSET,
               OPEN_IN_INTERIOR_OF])

  let INTERIOR_OF_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. top interior_of s SUBSET topspace top"
   (REWRITE_TAC [SUBSET, interior_of, IN_ELIM_THM] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let INTERIOR_OF_SUBSET_SUBTOPOLOGY ← prove
   r"!top s t:A->bool. (subtopology top s) interior_of t SUBSET s"
   (REPEAT STRIP_TAC THEN MP_TAC
     (← ISPEC (← q r"subtopology top (s:A->bool)") INTERIOR_OF_SUBSET_TOPSPACE) THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER])

  let INTERIOR_OF_INTER ← prove
   r"!top s t:A->bool.
      top interior_of (s INTER t) = top interior_of s INTER top interior_of t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET_INTER] THEN
    SIMP_TAC [INTERIOR_OF_MONO, INTER_SUBSET] THEN
    SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ, OPEN_IN_INTERIOR_OF, OPEN_IN_INTER] THEN
    MATCH_MP_TAC (← sr
        r"s SUBSET s' /\ t SUBSET t' ==> s INTER t SUBSET s' INTER t'") THEN
    REWRITE_TAC [INTERIOR_OF_SUBSET])

  let INTERIOR_OF_INTERS_SUBSET ← prove
   r"!top f:(A->bool)->bool.
        top interior_of (INTERS f) SUBSET
        INTERS {top interior_of s | s IN f}"
   (REWRITE_TAC [SUBSET, interior_of, INTERS_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_INTERS] THEN MESON_TAC [])

  let UNION_INTERIOR_OF_SUBSET ← prove
   r"!top s t:A->bool.
        top interior_of s UNION top interior_of t
        SUBSET top interior_of (s UNION t)"
   (SIMP_TAC [UNION_SUBSET, INTERIOR_OF_MONO, SUBSET_UNION])

  let INTERIOR_OF_EQ_EMPTY ← prove
   r"!top s:A->bool.
                top interior_of s = {} <=>
                !t. open_in top t /\ t SUBSET s ==> t = {}"
   (MESON_TAC [INTERIOR_OF_MAXIMAL_EQ, SUBSET_EMPTY,
               OPEN_IN_INTERIOR_OF, INTERIOR_OF_SUBSET])

  let INTERIOR_OF_EQ_EMPTY_ALT ← prove
   r"!top s:A->bool.
        top interior_of s = {} <=>
        !t. open_in top t /\ ~(t = {}) ==> ~(t DIFF s = {})"
   (GEN_TAC THEN REWRITE_TAC [INTERIOR_OF_EQ_EMPTY] THEN SET_TAC [])

  let INTERIOR_OF_UNIONS_OPEN_IN_SUBSETS ← prove
   r"!top s:A->bool.
        UNIONS {t | open_in top t /\ t SUBSET s} = top interior_of s"
   (REPEAT GEN_TAC THEN CONV_TAC SYM_CONV THEN
    MATCH_MP_TAC INTERIOR_OF_UNIQUE THEN
    SIMP_TAC [OPEN_IN_UNIONS, IN_ELIM_THM] THEN SET_TAC [])

  let INTERIOR_OF_COMPLEMENT ← prove
   r"!top s:A->bool.
        top interior_of (topspace top DIFF s) =
        topspace top DIFF top closure_of s"
   (REWRITE_TAC [interior_of, closure_of] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM, SUBSET] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let INTERIOR_OF_CLOSURE_OF ← prove
   r"!top s:A->bool.
        top interior_of s =
        topspace top DIFF top closure_of (topspace top DIFF s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM INTERIOR_OF_COMPLEMENT] THEN
    GEN_REWRITE_TAC LAND_CONV [INTERIOR_OF_RESTRICT] THEN
    AP_TERM_TAC THEN SET_TAC [])

  let CLOSURE_OF_INTERIOR_OF ← prove
   r"!top s:A->bool.
        top closure_of s =
        topspace top DIFF top interior_of (topspace top DIFF s)"
   (REWRITE_TAC [INTERIOR_OF_COMPLEMENT] THEN
    REWRITE_TAC [← sr r"s = t DIFF (t DIFF s) <=> s SUBSET t"] THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE])

  let CLOSURE_OF_COMPLEMENT ← prove
   r"!top s:A->bool.
        top closure_of (topspace top DIFF s) =
        topspace top DIFF top interior_of s"
   (REWRITE_TAC [interior_of, closure_of] THEN
    REWRITE_TAC [EXTENSION, IN_DIFF, IN_ELIM_THM, SUBSET] THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let INTERIOR_OF_EQ_EMPTY_COMPLEMENT ← prove
   r"!top s:A->bool.
        top interior_of s = {} <=>
        top closure_of (topspace top DIFF s) = topspace top"
   (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"s:A->bool"] INTERIOR_OF_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [CLOSURE_OF_COMPLEMENT] THEN SET_TAC [])

  let CLOSURE_OF_EQ_UNIV ← prove
   r"!top s:A->bool.
     top closure_of s = topspace top <=>
     top interior_of (topspace top DIFF s) = {}"
   (REPEAT GEN_TAC THEN MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [INTERIOR_OF_COMPLEMENT] THEN SET_TAC [])

  let INTERIOR_OF_SUBTOPOLOGY_SUBSET ← prove
   r"!top s u:A->bool.
        u INTER top interior_of s SUBSET (subtopology top u) interior_of s"
   (REWRITE_TAC [SUBSET, IN_INTER, interior_of,
                 OPEN_IN_SUBTOPOLOGY, IN_ELIM_THM] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    GEN_REWRITE_TAC RAND_CONV [SWAP_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ r <=> q /\ p /\ r")] THEN
    REWRITE_TAC [UNWIND_THM2] THEN ASM SET_TAC [])

  let INTERIOR_OF_SUBTOPOLOGY_SUBSETS ← prove
   r"!top s t u:A->bool.
        t SUBSET u
        ==> t INTER (subtopology top u) interior_of s SUBSET
            (subtopology top t) interior_of s"
   (REPEAT STRIP_TAC THEN FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← sr
     r"t SUBSET u ==> t = u INTER t")) THEN
    REWRITE_TAC [← GSYM SUBTOPOLOGY_SUBTOPOLOGY] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← sr
     r"t SUBSET u ==> u INTER t = t")) THEN
    REWRITE_TAC [INTERIOR_OF_SUBTOPOLOGY_SUBSET])

  let INTERIOR_OF_SUBTOPOLOGY_MONO ← prove
   r"!top s t u:A->bool.
        s SUBSET t /\ t SUBSET u
        ==> (subtopology top u) interior_of s SUBSET
            (subtopology top t) interior_of s"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← sr
      r"i SUBSET s /\ t INTER i SUBSET i'
     ==> s SUBSET t ==> i SUBSET i'") THEN
    ASM_SIMP_TAC [INTERIOR_OF_SUBSET, INTERIOR_OF_SUBTOPOLOGY_SUBSETS])

  let INTERIOR_OF_SUBTOPOLOGY_OPEN ← prove
   r"!top u s:A->bool.
        open_in top u
        ==> (subtopology top u) interior_of s = u INTER top interior_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTERIOR_OF_CLOSURE_OF] THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY_OPEN] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [← sr r"s INTER t DIFF u = t INTER (s DIFF u)"] THEN
    ASM_SIMP_TAC [← GSYM OPEN_IN_INTER_CLOSURE_OF_EQ] THEN SET_TAC [])

  let DENSE_INTERSECTS_OPEN ← prove
   r"!top s:A->bool.
        top closure_of s = topspace top <=>
        !t. open_in top t /\ ~(t = {}) ==> ~(s INTER t = {})"
   (REWRITE_TAC [CLOSURE_OF_INTERIOR_OF] THEN
    SIMP_TAC [INTERIOR_OF_SUBSET_TOPSPACE,
     ← sr r"s SUBSET u ==> (u DIFF s = u <=> s = {})"] THEN
    REWRITE_TAC [INTERIOR_OF_EQ_EMPTY_ALT] THEN
    SIMP_TAC [OPEN_IN_SUBSET, ← sr
     r"t SUBSET u ==> (~(t DIFF (u DIFF s) = {}) <=> ~(s INTER t = {}))"])

  let INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF ← prove
   r"!top s t:A->bool.
        closed_in top s /\ top interior_of t = {}
        ==> top interior_of (s UNION t) = top interior_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTERIOR_OF_CLOSURE_OF] THEN
    AP_TERM_TAC THEN
    REWRITE_TAC [← sr r"u DIFF (s UNION t) = (u DIFF s) INTER (u DIFF t)"] THEN
    W (MP_TAC o PART_MATCH (rand o rand) CLOSURE_OF_OPEN_IN_INTER_CLOSURE_OF o
      lhand o snd) THEN
    ASM_SIMP_TAC [CLOSURE_OF_COMPLEMENT, OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_COMPLEMENT] THEN
    AP_TERM_TAC THEN SET_TAC [])

  let INTERIOR_OF_UNION_EQ_EMPTY ← prove
   r"!top s t:A->bool.
        closed_in top s \/ closed_in top t
        ==> (top interior_of (s UNION t) = {} <=>
             top interior_of s = {} /\ top interior_of t = {})"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON [] (← q
     r"(!x y. R x y ==> R y x) /\ (!x y. P x ==> R x y)
    ==> (!x y. P x \/ P y ==> R x y)")) THEN
    CONJ_TAC THENL [REWRITE_TAC [UNION_COMM] THEN SET_TAC [], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> r) /\ (r ==> (p <=> q)) ==> (p <=> q /\ r)")) THEN
    ASM_SIMP_TAC [INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF] THEN
    MATCH_MP_TAC (← sr r"s SUBSET t ==> t = {} ==> s = {}") THEN
    SIMP_TAC [INTERIOR_OF_MONO, SUBSET_UNION])

  let DISCRETE_TOPOLOGY_INTERIOR_OF ← prove
   r"!u s:A->bool. (discrete_topology u) interior_of s = u INTER s"
   (ONCE_REWRITE_TAC [INTERIOR_OF_RESTRICT] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, INTERIOR_OF_EQ] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, INTER_SUBSET])

  return { interior_of, INTERIOR_OF_RESTRICT, INTERIOR_OF_EQ, INTERIOR_OF_OPEN_IN,
           INTERIOR_OF_EMPTY, INTERIOR_OF_TOPSPACE, OPEN_IN_INTERIOR_OF, INTERIOR_OF_INTERIOR_OF,
           INTERIOR_OF_SUBSET, INTERIOR_OF_SUBSET_CLOSURE_OF, SUBSET_INTERIOR_OF_EQ,
           INTERIOR_OF_MONO, INTERIOR_OF_MAXIMAL, INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_UNIQUE,
           INTERIOR_OF_SUBSET_TOPSPACE, INTERIOR_OF_SUBSET_SUBTOPOLOGY, INTERIOR_OF_INTER,
           INTERIOR_OF_INTERS_SUBSET, UNION_INTERIOR_OF_SUBSET, INTERIOR_OF_EQ_EMPTY,
           INTERIOR_OF_EQ_EMPTY_ALT, INTERIOR_OF_UNIONS_OPEN_IN_SUBSETS, INTERIOR_OF_COMPLEMENT,
           INTERIOR_OF_CLOSURE_OF, CLOSURE_OF_INTERIOR_OF, CLOSURE_OF_COMPLEMENT,
           INTERIOR_OF_EQ_EMPTY_COMPLEMENT, CLOSURE_OF_EQ_UNIV, INTERIOR_OF_SUBTOPOLOGY_SUBSET,
           INTERIOR_OF_SUBTOPOLOGY_SUBSETS, INTERIOR_OF_SUBTOPOLOGY_MONO,
           INTERIOR_OF_SUBTOPOLOGY_OPEN, DENSE_INTERSECTS_OPEN,
           INTERIOR_OF_CLOSED_IN_UNION_EMPTY_INTERIOR_OF, INTERIOR_OF_UNION_EQ_EMPTY,
           DISCRETE_TOPOLOGY_INTERIOR_OF }

/- ------------------------------------------------------------------------- -/
/- Frontier with respect to topological space.  (metric.ml 1717-1960)        -/
/- ------------------------------------------------------------------------- -/

structure Frontier where
  frontier_of : thm
  FRONTIER_OF_CLOSURES : thm
  INTERIOR_OF_UNION_FRONTIER_OF : thm
  FRONTIER_OF_RESTRICT : thm
  CLOSED_IN_FRONTIER_OF : thm
  FRONTIER_OF_SUBSET_TOPSPACE : thm
  FRONTIER_OF_SUBSET_SUBTOPOLOGY : thm
  FRONTIER_OF_SUBTOPOLOGY_SUBSET : thm
  FRONTIER_OF_SUBTOPOLOGY_MONO : thm
  CLOPEN_IN_EQ_FRONTIER_OF : thm
  FRONTIER_OF_EQ_EMPTY : thm
  FRONTIER_OF_OPEN_IN : thm
  FRONTIER_OF_OPEN_IN_STRADDLE_INTER : thm
  FRONTIER_OF_SUBSET_CLOSED_IN : thm
  FRONTIER_OF_EMPTY : thm
  FRONTIER_OF_TOPSPACE : thm
  FRONTIER_OF_SUBSET_EQ : thm
  FRONTIER_OF_COMPLEMENT : thm
  FRONTIER_OF_DISJOINT_EQ : thm
  FRONTIER_OF_DISJOINT_EQ_ALT : thm
  FRONTIER_OF_INTER : thm
  FRONTIER_OF_INTER_SUBSET : thm
  FRONTIER_OF_INTER_CLOSED_IN : thm
  FRONTIER_OF_UNION_SUBSET : thm
  FRONTIER_OF_UNIONS_SUBSET : thm
  FRONTIER_OF_FRONTIER_OF_SUBSET : thm
  FRONTIER_OF_SUBTOPOLOGY_OPEN : thm
  DISCRETE_TOPOLOGY_FRONTIER_OF : thm
  OPEN_IN_SUBSET_TOPSPACE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupFrontier [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BInterior : Interior) :
    ExceptT String IO Frontier := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, parse_as_infix, .. } := D
  let { DIFF_EQ_EMPTY, FINITE_INDUCT_STRONG, IMAGE_CLAUSES, .. } := D.core1
  let { IMAGE_UNIONS, INTER_COMM, INTER_EMPTY, INTER_SUBSET, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET_DIFF, SUBSET_INTER, SUBSET_REFL, UNIONS_0, UNIONS_INSERT,
        .. } := D.core4
  let { MONO_AND, .. } := D.core5
  let { CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN,
        OPEN_IN_CLOSED_IN_EQ, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBSET_TOPSPACE, OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_RESTRICT,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_EMPTY, CLOSURE_OF_MONO,
        CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_EQ,
        CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_SUBTOPOLOGY_MONO, CLOSURE_OF_SUBTOPOLOGY_OPEN,
        CLOSURE_OF_SUBTOPOLOGY_SUBSET, CLOSURE_OF_UNION, DISCRETE_TOPOLOGY_CLOSURE_OF,
        OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := BClosure
  let { CLOSURE_OF_COMPLEMENT, DISCRETE_TOPOLOGY_INTERIOR_OF, INTERIOR_OF_OPEN_IN,
        INTERIOR_OF_SUBSET, INTERIOR_OF_SUBSET_CLOSURE_OF, INTERIOR_OF_SUBTOPOLOGY_MONO,
        INTERIOR_OF_SUBTOPOLOGY_OPEN, INTERIOR_OF_SUBTOPOLOGY_SUBSET, OPEN_IN_INTERIOR_OF,
        .. } := BInterior
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("frontier_of", (21, "right"))

  let frontier_of ← new_definition
   r"top frontier_of s =  top closure_of s DIFF top interior_of s"

  let FRONTIER_OF_CLOSURES ← prove
   r"!top s. top frontier_of s =
           top closure_of s INTER top closure_of (topspace top DIFF s)"
   (REPEAT GEN_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [frontier_of, CLOSURE_OF_COMPLEMENT] THEN
    MATCH_MP_TAC (← sr r"s SUBSET u ==> s INTER (u DIFF t) = s DIFF t") THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE])

  let INTERIOR_OF_UNION_FRONTIER_OF ← prove
   r"!top s:A->bool.
        top interior_of s UNION top frontier_of s = top closure_of s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [frontier_of] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
      INTERIOR_OF_SUBSET_CLOSURE_OF) THEN
    SET_TAC [])

  let FRONTIER_OF_RESTRICT ← prove
   r"!top s:A->bool. top frontier_of s = top frontier_of (topspace top INTER s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    BINOP_TAC THEN GEN_REWRITE_TAC LAND_CONV [CLOSURE_OF_RESTRICT] THEN
    AP_TERM_TAC THEN SET_TAC [])

  let CLOSED_IN_FRONTIER_OF ← prove
   r"!top s:A->bool. closed_in top (top frontier_of s)"
   (SIMP_TAC [FRONTIER_OF_CLOSURES, CLOSED_IN_INTER, CLOSED_IN_CLOSURE_OF])

  let FRONTIER_OF_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. top frontier_of s SUBSET topspace top"
   (SIMP_TAC [CLOSED_IN_SUBSET, CLOSED_IN_FRONTIER_OF])

  let FRONTIER_OF_SUBSET_SUBTOPOLOGY ← prove
   r"!top s t:A->bool. (subtopology top s) frontier_of t SUBSET s"
   (MESON_TAC [TOPSPACE_SUBTOPOLOGY, FRONTIER_OF_SUBSET_TOPSPACE, SUBSET_INTER])

  let FRONTIER_OF_SUBTOPOLOGY_SUBSET ← prove
   r"!top s u:A->bool.
        u INTER (subtopology top u) frontier_of s SUBSET (top frontier_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [frontier_of] THEN MATCH_MP_TAC (← sr
     r"s SUBSET s' /\ u INTER t' SUBSET t
    ==> u INTER (s DIFF t) SUBSET s' DIFF t'") THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY_SUBSET, INTERIOR_OF_SUBTOPOLOGY_SUBSET])

  let FRONTIER_OF_SUBTOPOLOGY_MONO ← prove
   r"!top s t u:A->bool.
        s SUBSET t /\ t SUBSET u
        ==> (subtopology top t) frontier_of s SUBSET
            (subtopology top u) frontier_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier_of] THEN MATCH_MP_TAC (← sr
     r"s SUBSET s' /\ t' SUBSET t ==> s DIFF t SUBSET s' DIFF t'") THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBTOPOLOGY_MONO, INTERIOR_OF_SUBTOPOLOGY_MONO])

  let CLOPEN_IN_EQ_FRONTIER_OF ← prove
   r"!top s:A->bool.
        closed_in top s /\ open_in top s <=>
        s SUBSET topspace top /\ top frontier_of s = {}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES, OPEN_IN_CLOSED_IN_EQ] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THENL [SIMP_TAC [CLOSURE_OF_CLOSED_IN] THEN SET_TAC [], DISCH_TAC] THEN
    ASM_REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, SUBSET_DIFF] THEN
    MATCH_MP_TAC (← sr
     r"c INTER c' = {} /\
    s SUBSET c /\ (u DIFF s) SUBSET c' /\ c SUBSET u /\ c' SUBSET u
        ==> c SUBSET s /\ c' SUBSET (u DIFF s)") THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, SUBSET_DIFF, CLOSURE_OF_SUBSET_TOPSPACE])

  let FRONTIER_OF_EQ_EMPTY ← prove
   r"!top s:A->bool.
        s SUBSET topspace top
        ==> (top frontier_of s = {} <=> closed_in top s /\ open_in top s)"
   (SIMP_TAC [CLOPEN_IN_EQ_FRONTIER_OF])

  let FRONTIER_OF_OPEN_IN ← prove
   r"!top s:A->bool.
        open_in top s ==> top frontier_of s = top closure_of s DIFF s"
   (SIMP_TAC [frontier_of, INTERIOR_OF_OPEN_IN])

  let FRONTIER_OF_OPEN_IN_STRADDLE_INTER ← prove
   r"!top s u:A->bool.
        open_in top  u /\ ~(u INTER top frontier_of s = {})
        ==> ~(u INTER s = {}) /\ ~(u DIFF s = {})"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN DISCH_THEN (MP_TAC o MATCH_MP (← sr
     r"~(s INTER t INTER u = {})
    ==> ~(s INTER t = {}) /\ ~(s INTER u = {})")) THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN
    W (MP_TAC o PART_MATCH (lhand o rand) OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY o
       rand o lhand o snd) THEN
    ASM SET_TAC [])

  let FRONTIER_OF_SUBSET_CLOSED_IN ← prove
   r"!top s:A->bool. closed_in top s ==> (top frontier_of s) SUBSET s"
   (REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, frontier_of] THEN SET_TAC [])

  let FRONTIER_OF_EMPTY ← prove
   r"!top. top frontier_of {} = {}"
   (REWRITE_TAC [FRONTIER_OF_CLOSURES, CLOSURE_OF_EMPTY, INTER_EMPTY])

  let FRONTIER_OF_TOPSPACE ← prove
   r"!top:A topology. top frontier_of topspace top = {}"
   (SIMP_TAC [FRONTIER_OF_EQ_EMPTY, SUBSET_REFL] THEN
    REWRITE_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE])

  let FRONTIER_OF_SUBSET_EQ ← prove
   r"!top s:A->bool.
        s SUBSET topspace top
        ==> ((top frontier_of s) SUBSET s <=> closed_in top s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [FRONTIER_OF_SUBSET_CLOSED_IN] THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    ASM_REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    ONCE_REWRITE_TAC [← sr r"s INTER t = s DIFF (s DIFF t)"]  THEN
    DISCH_THEN (MATCH_MP_TAC o MATCH_MP (← sr
     r"s DIFF t SUBSET u ==> t SUBSET u ==> s SUBSET u")) THEN
    MATCH_MP_TAC (← sr
     r"!u. u DIFF s SUBSET d /\ c SUBSET u ==> c DIFF d SUBSET s") THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE] THEN
    MATCH_MP_TAC CLOSURE_OF_SUBSET THEN SET_TAC [])

  let FRONTIER_OF_COMPLEMENT ← prove
   r"!top s:A->bool. top frontier_of (topspace top DIFF s) = top frontier_of s"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [FRONTIER_OF_RESTRICT] THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    GEN_REWRITE_TAC RAND_CONV [INTER_COMM] THEN
    BINOP_TAC THEN AP_TERM_TAC THEN SET_TAC [])

  let FRONTIER_OF_DISJOINT_EQ ← prove
   r"!top s. s SUBSET topspace top
        ==> ((top frontier_of s) INTER s = {} <=> open_in top s)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_CLOSED_IN] THEN
    ASM_SIMP_TAC [← GSYM FRONTIER_OF_SUBSET_EQ, SUBSET_DIFF] THEN
    REWRITE_TAC [FRONTIER_OF_COMPLEMENT] THEN
    MATCH_MP_TAC (← sr
     r"f SUBSET u ==> (f INTER s = {} <=> f SUBSET u DIFF s)") THEN
    REWRITE_TAC [FRONTIER_OF_SUBSET_TOPSPACE])

  let FRONTIER_OF_DISJOINT_EQ_ALT ← prove
   r"!top s:A->bool.
        s SUBSET (topspace top DIFF top frontier_of s) <=>
        open_in top s"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THENL
     [ASM_SIMP_TAC [← GSYM FRONTIER_OF_DISJOINT_EQ] THEN ASM SET_TAC [],
      EQ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC [OPEN_IN_SUBSET]]])

  let FRONTIER_OF_INTER ← prove
   r"!top s t:A->bool.
        top frontier_of(s INTER t) =
        top closure_of (s INTER t) INTER
        (top frontier_of s UNION top frontier_of t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    SIMP_TAC [CLOSURE_OF_MONO, INTER_SUBSET, ← GSYM CLOSURE_OF_UNION, ← sr
      r"u SUBSET s /\ u SUBSET t
     ==> u INTER (s INTER x UNION t INTER y) = u INTER (x UNION y)"] THEN
    REPLICATE_TAC 2 AP_TERM_TAC THEN SET_TAC [])

  let FRONTIER_OF_INTER_SUBSET ← prove
   r"!top s t. top frontier_of(s INTER t) SUBSET
             top frontier_of(s) UNION top frontier_of(t)"
   (REWRITE_TAC [FRONTIER_OF_INTER] THEN SET_TAC [])

  let FRONTIER_OF_INTER_CLOSED_IN ← prove
   r"!top s t:A->bool.
        closed_in top s /\ closed_in top t
        ==> top frontier_of(s INTER t) =
            top frontier_of s INTER t UNION s INTER top frontier_of t"
   (SIMP_TAC [FRONTIER_OF_INTER, CLOSED_IN_INTER, CLOSURE_OF_CLOSED_IN] THEN
    REPEAT STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP FRONTIER_OF_SUBSET_CLOSED_IN)) THEN
    SET_TAC [])

  let FRONTIER_OF_UNION_SUBSET ← prove
   r"!top s t:A->bool.
      top frontier_of(s UNION t) SUBSET
      top frontier_of s UNION top frontier_of t"
   (ONCE_REWRITE_TAC [← GSYM FRONTIER_OF_COMPLEMENT] THEN
    REWRITE_TAC [← sr r"u DIFF (s UNION t) = (u DIFF s) INTER (u DIFF t)"] THEN
    REWRITE_TAC [FRONTIER_OF_INTER_SUBSET])

  let FRONTIER_OF_UNIONS_SUBSET ← prove
   r"!top f:(A->bool)->bool.
        FINITE f
        ==> top frontier_of (UNIONS f) SUBSET
            UNIONS {top frontier_of t | t IN f}"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    SIMP_TAC [SIMPLE_IMAGE, IMAGE_UNIONS, IMAGE_CLAUSES, UNIONS_0,
              UNIONS_INSERT, FRONTIER_OF_EMPTY, SUBSET_REFL] THEN
    REPEAT STRIP_TAC THEN
    W (MP_TAC o PART_MATCH lhand FRONTIER_OF_UNION_SUBSET o lhand o snd) THEN
    ASM SET_TAC [])

  let FRONTIER_OF_FRONTIER_OF_SUBSET ← prove
   r"!top s:A->bool.
    top frontier_of (top frontier_of s) SUBSET top frontier_of s"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC FRONTIER_OF_SUBSET_CLOSED_IN THEN
    REWRITE_TAC [CLOSED_IN_FRONTIER_OF])

  let FRONTIER_OF_SUBTOPOLOGY_OPEN ← prove
   r"!top u s:A->bool.
        open_in top u
        ==> (subtopology top u) frontier_of s = u INTER top frontier_of s"
   (SIMP_TAC [frontier_of, CLOSURE_OF_SUBTOPOLOGY_OPEN,
              INTERIOR_OF_SUBTOPOLOGY_OPEN] THEN
    SET_TAC [])

  let DISCRETE_TOPOLOGY_FRONTIER_OF ← prove
   r"!u s:A->bool. (discrete_topology u) frontier_of s = {}"
   (REWRITE_TAC [frontier_of, DISCRETE_TOPOLOGY_CLOSURE_OF,
                 DISCRETE_TOPOLOGY_INTERIOR_OF, DIFF_EQ_EMPTY])

  let OPEN_IN_SUBSET_TOPSPACE_EQ ← prove
   r"!top u s:A->bool.
        DISJOINT s (top frontier_of u)
        ==> (open_in (subtopology top u) s <=>
             open_in top s /\ s SUBSET u)"
   (ONCE_REWRITE_TAC [FRONTIER_OF_RESTRICT] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THEN REWRITE_TAC [OPEN_IN_SUBSET_TOPSPACE] THEN
    ONCE_REWRITE_TAC [SUBTOPOLOGY_RESTRICT] THEN DISCH_TAC THEN CONJ_TAC THENL
     [MP_TAC (← sr r"topspace top INTER (u:A->bool) SUBSET topspace top"),
      FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC []] THEN
    REPEAT (POP_ASSUM MP_TAC) THEN
    SPEC_TAC (← q r"topspace top INTER u:A->bool", ← q r"u:A->bool") THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_SUBTOPOLOGY]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"t INTER u:A->bool = t INTER top interior_of u") SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [frontier_of]) THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool"] INTERIOR_OF_SUBSET) THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool"] CLOSURE_OF_SUBSET) THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_INTERIOR_OF]])

  return { frontier_of, FRONTIER_OF_CLOSURES, INTERIOR_OF_UNION_FRONTIER_OF,
           FRONTIER_OF_RESTRICT, CLOSED_IN_FRONTIER_OF, FRONTIER_OF_SUBSET_TOPSPACE,
           FRONTIER_OF_SUBSET_SUBTOPOLOGY, FRONTIER_OF_SUBTOPOLOGY_SUBSET,
           FRONTIER_OF_SUBTOPOLOGY_MONO, CLOPEN_IN_EQ_FRONTIER_OF, FRONTIER_OF_EQ_EMPTY,
           FRONTIER_OF_OPEN_IN, FRONTIER_OF_OPEN_IN_STRADDLE_INTER, FRONTIER_OF_SUBSET_CLOSED_IN,
           FRONTIER_OF_EMPTY, FRONTIER_OF_TOPSPACE, FRONTIER_OF_SUBSET_EQ,
           FRONTIER_OF_COMPLEMENT, FRONTIER_OF_DISJOINT_EQ, FRONTIER_OF_DISJOINT_EQ_ALT,
           FRONTIER_OF_INTER, FRONTIER_OF_INTER_SUBSET, FRONTIER_OF_INTER_CLOSED_IN,
           FRONTIER_OF_UNION_SUBSET, FRONTIER_OF_UNIONS_SUBSET, FRONTIER_OF_FRONTIER_OF_SUBSET,
           FRONTIER_OF_SUBTOPOLOGY_OPEN, DISCRETE_TOPOLOGY_FRONTIER_OF,
           OPEN_IN_SUBSET_TOPSPACE_EQ }

/- ------------------------------------------------------------------------- -/
/- Iteration of interior and closure; locally finite collections.           -/
/- (metric.ml 1962-2239)                                                      -/
/- ------------------------------------------------------------------------- -/

structure IterLocal where
  INTERIOR_OF_CLOSURE_OF_IDEMP : thm
  CLOSURE_OF_INTERIOR_OF_IDEMP : thm
  INTERIOR_OF_FRONTIER_OF : thm
  THIN_FRONTIER_OF_SUBSET : thm
  THIN_FRONTIER_OF_CIC : thm
  THIN_FRONTIER_OF_ICI : thm
  INTERIOR_OF_FRONTIER_OF_EMPTY : thm
  FRONTIER_OF_FRONTIER_OF : thm
  FRONTIER_OF_FRONTIER_OF_FRONTIER_OF : thm
  REGULAR_CLOSURE_OF_INTERIOR_OF : thm
  REGULAR_INTERIOR_OF_CLOSURE_OF : thm
  REGULAR_CLOSED_IN : thm
  REGULAR_OPEN_IN : thm
  REGULAR_CLOSURE_OF_IMP_THIN_FRONTIER_OF : thm
  REGULAR_INTERIOR_OF_IMP_THIN_FRONTIER_OF : thm
  locally_finite_in : thm
  FINITE_IMP_LOCALLY_FINITE_IN : thm
  LOCALLY_FINITE_IN_SUBSET : thm
  LOCALLY_FINITE_IN_REFINEMENT : thm
  LOCALLY_FINITE_IN_SUBTOPOLOGY : thm
  LOCALLY_FINITE_IN_SUBTOPOLOGY_EQ : thm
  CLOSED_IN_LOCALLY_FINITE_UNIONS : thm
  LOCALLY_FINITE_IN_CLOSURES : thm
  CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES : thm
  CLOSURE_OF_UNIONS_SUBSET : thm
  CLOSURE_OF_LOCALLY_FINITE_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupIterLocal [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BInterior : Interior)
    (BFrontier : Frontier) : ExceptT String IO IterLocal := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, DIFF_EMPTY, EXISTS_IN_GSPEC, FINITE_EMPTY, FINITE_IMAGE, FINITE_RESTRICT,
        FINITE_SUBSET, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, INTER_COMM, INTER_SUBSET, IN_DIFF, IN_ELIM_THM, IN_INTER,
        MONO_EXISTS, .. } := D.core2
  let { SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, UNIONS_SUBSET, .. } := D.core4
  let { MONO_AND, .. } := D.core5
  let { CLOSED_IN_UNIONS, OPEN_IN_DIFF, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        closed_in, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_CLOSURE_OF, CLOSURE_OF_EQ,
        CLOSURE_OF_MINIMAL, CLOSURE_OF_MINIMAL_EQ, CLOSURE_OF_MONO, CLOSURE_OF_RESTRICT,
        CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_UNIQUE,
        OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, .. } := BClosure
  let { CLOSURE_OF_COMPLEMENT, INTERIOR_OF_COMPLEMENT, INTERIOR_OF_EQ, INTERIOR_OF_INTER,
        INTERIOR_OF_INTERIOR_OF, INTERIOR_OF_MAXIMAL_EQ, INTERIOR_OF_MONO, INTERIOR_OF_OPEN_IN,
        INTERIOR_OF_RESTRICT, INTERIOR_OF_SUBSET, INTERIOR_OF_SUBSET_TOPSPACE,
        INTERIOR_OF_UNIQUE, OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { CLOSED_IN_FRONTIER_OF, FRONTIER_OF_CLOSURES, frontier_of, .. } := BFrontier
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let INTERIOR_OF_CLOSURE_OF_IDEMP ← prove
   r"!top s:A->bool.
        top interior_of top closure_of top interior_of top closure_of s =
        top interior_of top closure_of s"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_OF_UNIQUE THEN
    REWRITE_TAC [OPEN_IN_INTERIOR_OF] THEN
    SIMP_TAC [CLOSURE_OF_SUBSET, INTERIOR_OF_SUBSET_TOPSPACE] THEN
    SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
    REWRITE_TAC [CLOSED_IN_CLOSURE_OF, INTERIOR_OF_SUBSET])

  let CLOSURE_OF_INTERIOR_OF_IDEMP ← prove
   r"!top s:A->bool.
        top closure_of top interior_of top closure_of top interior_of s =
        top closure_of top interior_of s"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top DIFF s:A->bool"]
          INTERIOR_OF_CLOSURE_OF_IDEMP) THEN
    REWRITE_TAC [CLOSURE_OF_COMPLEMENT, INTERIOR_OF_COMPLEMENT] THEN
    MATCH_MP_TAC (← sr
     r"s SUBSET u /\ t SUBSET u ==> u DIFF s = u DIFF t ==> s = t") THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE, INTERIOR_OF_SUBSET_TOPSPACE])

  let INTERIOR_OF_FRONTIER_OF ← prove
   r"!top s:A->bool.
        top interior_of (top frontier_of s) =
        top interior_of (top closure_of s) DIFF
        top closure_of (top interior_of s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [FRONTIER_OF_CLOSURES, INTERIOR_OF_INTER] THEN
    REWRITE_TAC [CLOSURE_OF_COMPLEMENT, INTERIOR_OF_COMPLEMENT] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top closure_of s:A->bool"]
          INTERIOR_OF_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let THIN_FRONTIER_OF_SUBSET ← prove
   r"!top s:A->bool.
        top interior_of (top frontier_of s) = {} <=>
        top interior_of (top closure_of s) SUBSET
        top closure_of (top interior_of s)"
   (REWRITE_TAC [INTERIOR_OF_FRONTIER_OF] THEN SET_TAC [])

  let THIN_FRONTIER_OF_CIC ← prove
   r"!top s:A->bool.
        top interior_of (top frontier_of s) = {} <=>
        top closure_of (top interior_of (top closure_of s)) =
        top closure_of (top interior_of s)"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [THIN_FRONTIER_OF_SUBSET] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p <=> q) /\ r==> (p <=> q /\ r)")) THEN CONJ_TAC THENL
     [SIMP_TAC [CLOSURE_OF_MINIMAL_EQ, CLOSED_IN_CLOSURE_OF,
                INTERIOR_OF_SUBSET_TOPSPACE],
      GEN_REWRITE_TAC LAND_CONV [← GSYM CLOSURE_OF_INTERIOR_OF_IDEMP] THEN
      SIMP_TAC [CLOSURE_OF_MONO, INTERIOR_OF_MONO, INTERIOR_OF_SUBSET]])

  let THIN_FRONTIER_OF_ICI ← prove
   r"!s:A->bool.
        top interior_of (top frontier_of s) = {} <=>
        top interior_of (top closure_of (top interior_of s)) =
        top interior_of (top closure_of  s)"
   (GEN_TAC THEN REWRITE_TAC [THIN_FRONTIER_OF_CIC] THEN
    MESON_TAC [INTERIOR_OF_CLOSURE_OF_IDEMP, CLOSURE_OF_INTERIOR_OF_IDEMP])

  let INTERIOR_OF_FRONTIER_OF_EMPTY ← prove
   r"!top s:A->bool.
        open_in top s \/ closed_in top s
        ==> top interior_of (top frontier_of s) = {}"
   (REPEAT STRIP_TAC THENL
     [REWRITE_TAC [THIN_FRONTIER_OF_ICI], REWRITE_TAC [THIN_FRONTIER_OF_CIC]] THEN
    ASM_SIMP_TAC [INTERIOR_OF_OPEN_IN, CLOSURE_OF_CLOSED_IN])

  let FRONTIER_OF_FRONTIER_OF ← prove
   r"!top s:A->bool.
        open_in top s \/ closed_in top s
        ==> top frontier_of (top frontier_of s) = top frontier_of s"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [frontier_of] THEN
    SIMP_TAC [INTERIOR_OF_FRONTIER_OF_EMPTY, CLOSURE_OF_CLOSED_IN,
              CLOSED_IN_FRONTIER_OF, DIFF_EMPTY])

  let FRONTIER_OF_FRONTIER_OF_FRONTIER_OF ← prove
   r"!top s:A->bool.
        top frontier_of top frontier_of top frontier_of s =
        top frontier_of top frontier_of s"
   (SIMP_TAC [FRONTIER_OF_FRONTIER_OF, CLOSED_IN_FRONTIER_OF])

  let REGULAR_CLOSURE_OF_INTERIOR_OF ← prove
   r"!top s:A->bool.
        s SUBSET top closure_of top interior_of s <=>
        s SUBSET topspace top /\
        top closure_of top interior_of s = top closure_of s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [CLOSURE_OF_MONO, INTERIOR_OF_SUBSET] THEN
    MESON_TAC [CLOSURE_OF_MINIMAL_EQ, CLOSED_IN_CLOSURE_OF,
               CLOSURE_OF_SUBSET_TOPSPACE, SUBSET_TRANS])

  let REGULAR_INTERIOR_OF_CLOSURE_OF ← prove
   r"!top s:A->bool.
        top interior_of top closure_of s SUBSET s <=>
        top interior_of top closure_of s = top interior_of s"
   (REPEAT GEN_TAC THEN
    SUBST1_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_RESTRICT) THEN
    SUBST1_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] INTERIOR_OF_RESTRICT) THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN
    SIMP_TAC [INTERIOR_OF_MONO, CLOSURE_OF_SUBSET, INTER_SUBSET] THEN
    SIMP_TAC [INTERIOR_OF_MAXIMAL_EQ, OPEN_IN_INTERIOR_OF] THEN
    REWRITE_TAC [SUBSET_INTER, INTERIOR_OF_SUBSET_TOPSPACE])

  let REGULAR_CLOSED_IN ← prove
   r"!top s:A->bool.
        top closure_of top interior_of s = s <=>
        closed_in top s /\ s SUBSET top closure_of top interior_of s"
   (REWRITE_TAC [REGULAR_CLOSURE_OF_INTERIOR_OF, ← GSYM CLOSURE_OF_EQ] THEN
    MESON_TAC [CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_CLOSURE_OF])

  let REGULAR_OPEN_IN ← prove
   r"!top s:A->bool.
        top interior_of top closure_of s = s <=>
        open_in top s /\ top interior_of top closure_of s SUBSET s"
   (REWRITE_TAC [REGULAR_INTERIOR_OF_CLOSURE_OF, ← GSYM INTERIOR_OF_EQ] THEN
    MESON_TAC [INTERIOR_OF_INTERIOR_OF])

  let REGULAR_CLOSURE_OF_IMP_THIN_FRONTIER_OF ← prove
   r"!top s:A->bool.
        s SUBSET top closure_of top interior_of s
        ==> top interior_of top frontier_of s = {}"
   (SIMP_TAC [REGULAR_CLOSURE_OF_INTERIOR_OF, THIN_FRONTIER_OF_ICI])

  let REGULAR_INTERIOR_OF_IMP_THIN_FRONTIER_OF ← prove
   r"!top s:A->bool.
        top interior_of top closure_of s SUBSET s
        ==> top interior_of top frontier_of s = {}"
   (SIMP_TAC [REGULAR_INTERIOR_OF_CLOSURE_OF, THIN_FRONTIER_OF_CIC])

  let locally_finite_in ← new_definition
   r"locally_finite_in top U <=>
        (!u. u IN U ==> u SUBSET topspace top) /\
        (!x. x IN topspace top
             ==> ?v. open_in top v /\ x IN v /\
                     FINITE {u | u IN U /\ ~(u INTER v = {})})"

  let FINITE_IMP_LOCALLY_FINITE_IN ← prove
   r"!(top:A topology) u.
        FINITE u /\ UNIONS u SUBSET topspace top ==> locally_finite_in top u"
   (SIMP_TAC [UNIONS_SUBSET, locally_finite_in, FINITE_RESTRICT] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let LOCALLY_FINITE_IN_SUBSET ← prove
   r"!(top:A topology) u v.
        locally_finite_in top u /\ v SUBSET u ==> locally_finite_in top v"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_finite_in] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN
    ASM SET_TAC [])

  let LOCALLY_FINITE_IN_REFINEMENT ← prove
   r"!top u (f:(A->bool)->(A->bool)).
        locally_finite_in top u /\ (!s. s IN u ==> f s SUBSET s)
        ==> locally_finite_in top {f s | s IN u}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_finite_in] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
    DISCH_TAC THEN ONCE_REWRITE_TAC [← sr
      r"{y | y IN {f x | P x} /\ Q y} = IMAGE f {x | P x /\ Q(f x)}"] THEN
    MATCH_MP_TAC FINITE_IMAGE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
    ASM SET_TAC [])

  let LOCALLY_FINITE_IN_SUBTOPOLOGY ← prove
   r"!top s (u:(A->bool)->bool).
        locally_finite_in top u /\ (!t. t IN u ==> t SUBSET s)
        ==> locally_finite_in (subtopology top s) u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_finite_in] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, IN_INTER] THEN
    X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC, IN_INTER] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN SET_TAC [])

  let LOCALLY_FINITE_IN_SUBTOPOLOGY_EQ ← prove
   r"!top s (u:(A->bool)->bool).
        closed_in top s
        ==> (locally_finite_in (subtopology top s) u <=>
             locally_finite_in top u /\ (!t. t IN u ==> t SUBSET s))"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [LOCALLY_FINITE_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [locally_finite_in, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"(x:A) IN s") THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [IN_INTER] THEN
      ASM_REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, EXISTS_IN_GSPEC, IN_INTER] THEN
      MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
      REPEAT (MATCH_MP_TAC MONO_AND THEN REWRITE_TAC []) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN ASM SET_TAC [],
      EXISTS_TAC (← q r"topspace top DIFF s:A->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, IN_DIFF] THEN
      MATCH_MP_TAC (← MESON [FINITE_EMPTY] (← q r"s = {} ==> FINITE s")) THEN
      ASM SET_TAC []])

  let CLOSED_IN_LOCALLY_FINITE_UNIONS ← prove
   r"!top f:(A->bool)->bool.
        (!s. s IN f ==> closed_in top s) /\ locally_finite_in top f
        ==> closed_in top (UNIONS f)"
   (REWRITE_TAC [locally_finite_in] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [closed_in] THEN CONJ_TAC THENL
      [RULE_ASSUM_TAC (REWRITE_RULE [closed_in]) THEN
       ASM_SIMP_TAC [UNIONS_SUBSET],
       ALL_TAC] THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN X_GEN_TAC (← q r"x:A") THEN
    REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC) THEN EXISTS_TAC
      (← q r"v DIFF UNIONS {s | s IN f /\ ~(s INTER v = {})}:A->bool") THEN
    ASM_REWRITE_TAC [IN_DIFF, ← GSYM CONJ_ASSOC] THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CLOSED_IN_UNIONS THEN ASM_SIMP_TAC [IN_ELIM_THM],
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC []])

  let LOCALLY_FINITE_IN_CLOSURES ← prove
   r"!top f:(A->bool)->bool.
        locally_finite_in top f
        ==> locally_finite_in top {top closure_of s | s IN f}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [locally_finite_in] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [← sr
      r"{y | y IN {f x | P x} /\ Q y} = IMAGE f {x | P x /\ Q(f x)}"] THEN
    MATCH_MP_TAC FINITE_IMAGE THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
    REWRITE_TAC [] THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    ASM_SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, SUBSET_REFL])

  let CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES ← prove
   r"!top f:(A->bool)->bool.
        locally_finite_in top f
        ==> closed_in top (UNIONS {top closure_of s | s IN f})"
   (SIMP_TAC [CLOSED_IN_LOCALLY_FINITE_UNIONS, LOCALLY_FINITE_IN_CLOSURES,
              CLOSED_IN_CLOSURE_OF, FORALL_IN_GSPEC])

  let CLOSURE_OF_UNIONS_SUBSET ← prove
   r"!top (f:(A->bool)->bool).
        UNIONS {top closure_of s | s IN f} SUBSET top closure_of (UNIONS f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN STRIP_TAC THEN
    MATCH_MP_TAC CLOSURE_OF_MONO THEN ASM SET_TAC [])

  let CLOSURE_OF_LOCALLY_FINITE_UNIONS ← prove
   r"!top (f:(A->bool)->bool).
        locally_finite_in top f
        ==> top closure_of (UNIONS f) = UNIONS {top closure_of s | s IN f}"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSURE_OF_UNIQUE THEN
    ASM_SIMP_TAC [CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES] THEN
    SIMP_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, CLOSURE_OF_MINIMAL] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [locally_finite_in]) THEN
    MP_TAC (← ISPEC (← q r"top:A topology") CLOSURE_OF_SUBSET) THEN ASM SET_TAC [])

  return { INTERIOR_OF_CLOSURE_OF_IDEMP, CLOSURE_OF_INTERIOR_OF_IDEMP, INTERIOR_OF_FRONTIER_OF,
           THIN_FRONTIER_OF_SUBSET, THIN_FRONTIER_OF_CIC, THIN_FRONTIER_OF_ICI,
           INTERIOR_OF_FRONTIER_OF_EMPTY, FRONTIER_OF_FRONTIER_OF,
           FRONTIER_OF_FRONTIER_OF_FRONTIER_OF, REGULAR_CLOSURE_OF_INTERIOR_OF,
           REGULAR_INTERIOR_OF_CLOSURE_OF, REGULAR_CLOSED_IN, REGULAR_OPEN_IN,
           REGULAR_CLOSURE_OF_IMP_THIN_FRONTIER_OF, REGULAR_INTERIOR_OF_IMP_THIN_FRONTIER_OF,
           locally_finite_in, FINITE_IMP_LOCALLY_FINITE_IN, LOCALLY_FINITE_IN_SUBSET,
           LOCALLY_FINITE_IN_REFINEMENT, LOCALLY_FINITE_IN_SUBTOPOLOGY,
           LOCALLY_FINITE_IN_SUBTOPOLOGY_EQ, CLOSED_IN_LOCALLY_FINITE_UNIONS,
           LOCALLY_FINITE_IN_CLOSURES, CLOSED_IN_UNIONS_LOCALLY_FINITE_CLOSURES,
           CLOSURE_OF_UNIONS_SUBSET, CLOSURE_OF_LOCALLY_FINITE_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Continuous maps, part 1.  (metric.ml 2241-2510)                           -/
/- ------------------------------------------------------------------------- -/

structure ContMap1 where
  continuous_map : thm
  CONTINUOUS_MAP : thm
  CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE : thm
  CONTINUOUS_MAP_ON_EMPTY : thm
  CONTINUOUS_MAP_INTO_EMPTY : thm
  CONTINUOUS_MAP_CLOSED_IN : thm
  OPEN_IN_CONTINUOUS_MAP_PREIMAGE : thm
  CLOSED_IN_CONTINUOUS_MAP_PREIMAGE : thm
  OPEN_IN_CONTINUOUS_MAP_PREIMAGE_GEN : thm
  CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN : thm
  CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET : thm
  CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET : thm
  CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_ALT : thm
  CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_GEN : thm
  CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET : thm
  CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET : thm
  CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET_ALT : thm
  CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET : thm
  CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET : thm
  CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET_ALT : thm
  CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET : thm
  CONTINUOUS_MAP_ID : thm
  TOPOLOGY_FINER_CONTINUOUS_ID : thm
  CONTINUOUS_MAP_CONST : thm
  CONTINUOUS_MAP_LOCALLY_CONSTANT : thm
  deriving Inhabited

@[nospecialize]
def setupContMap1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BInterior : Interior) (BFrontier : Frontier) : ExceptT String IO ContMap1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, EMPTY_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ_ALT, IN_ELIM_THM, NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET, SUBSET_REFL, SUBSET_RESTRICT, SUBSET_TRANS, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE,
        OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBOPEN,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_MINIMAL, CLOSURE_OF_MONO,
        CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_EQ,
        CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_TOPSPACE, .. } := BClosure
  let { CLOSURE_OF_INTERIOR_OF, INTERIOR_OF_CLOSURE_OF, .. } := BInterior
  let { FRONTIER_OF_CLOSURES, .. } := BFrontier
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let continuous_map ← new_definition
    r"!top top' f:A->B.
     continuous_map (top,top')  f <=>
     (!x. x IN topspace top ==> f x IN topspace top') /\
     (!u. open_in top' u
          ==> open_in top {x | x IN topspace top /\ f x IN u})"

  let CONTINUOUS_MAP ← prove
   r"!top top' f.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !u. open_in top' u
            ==> open_in top {x | x IN topspace top /\ f x IN u}"
   (REWRITE_TAC [continuous_map, SUBSET, FORALL_IN_IMAGE])

  let CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE ← prove
   r"!top top' f:A->B. continuous_map (top,top')  f
                     ==> IMAGE f (topspace top) SUBSET topspace top'"
   (REWRITE_TAC [continuous_map] THEN SET_TAC [])

  let CONTINUOUS_MAP_ON_EMPTY ← prove
   r"!top top' (f:A->B). topspace top = {} ==> continuous_map(top,top') f"
   (SIMP_TAC [continuous_map, NOT_IN_EMPTY, EMPTY_GSPEC, OPEN_IN_EMPTY])

  let CONTINUOUS_MAP_INTO_EMPTY ← prove
   r"!top top' (f:A->B).
        topspace top' = {}
        ==> (continuous_map(top,top') f <=> topspace top = {})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_ON_EMPTY] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    ASM SET_TAC [])

  let CONTINUOUS_MAP_CLOSED_IN ← prove
   r"!top top' f:A->B.
         continuous_map (top,top') f <=>
         (!x. x IN topspace top ==> f x IN topspace top') /\
         (!c. closed_in top' c
              ==> closed_in top {x | x IN topspace top /\ f x IN c})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    DISCH_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"topspace top' DIFF t:B->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_TOPSPACE,
                  CLOSED_IN_TOPSPACE] THEN
    GEN_REWRITE_TAC LAND_CONV [closed_in, OPEN_IN_CLOSED_IN_EQ] THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let OPEN_IN_CONTINUOUS_MAP_PREIMAGE ← prove
   r"!f:A->B top top' u.
        continuous_map (top,top') f /\ open_in top' u
        ==> open_in top {x | x IN topspace top /\ f x IN u}"
   (REWRITE_TAC [continuous_map] THEN SET_TAC [])

  let CLOSED_IN_CONTINUOUS_MAP_PREIMAGE ← prove
   r"!f:A->B top top' c.
        continuous_map (top,top') f /\ closed_in top' c
        ==> closed_in top {x | x IN topspace top /\ f x IN c}"
   (REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN SET_TAC [])

  let OPEN_IN_CONTINUOUS_MAP_PREIMAGE_GEN ← prove
   r"!f:A->B top top' u v.
        continuous_map (top,top') f /\ open_in top u /\ open_in top' v
        ==> open_in top {x | x IN u /\ f x IN v}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x | x IN u /\ (f:A->B) x IN v} =
                u INTER {x | x IN topspace top /\ f x IN v}")
    SUBST1_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN SET_TAC [],
      MATCH_MP_TAC OPEN_IN_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      ASM_MESON_TAC []])

  let CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN ← prove
   r"!f:A->B top top' u v.
        continuous_map (top,top') f /\ closed_in top u /\ closed_in top' v
        ==> closed_in top {x | x IN u /\ f x IN v}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"{x | x IN u /\ (f:A->B) x IN v} =
                u INTER {x | x IN topspace top /\ f x IN v}")
    SUBST1_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_INTER THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      ASM_MESON_TAC []])

  let CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET ← prove
   r"!top top' (f:A->B) s.
        continuous_map (top,top') f
        ==> IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
    TRANS_TAC SUBSET_TRANS
     (← q r"top' closure_of (IMAGE (f:A->B) (topspace top INTER s))") THEN
    CONJ_TAC THENL
     [ALL_TAC, MATCH_MP_TAC CLOSURE_OF_MONO THEN ASM SET_TAC []] THEN
    MP_TAC (← sr r"(topspace top INTER s:A->bool) SUBSET topspace top") THEN
    SPEC_TAC (← q r"topspace top INTER s:A->bool", ← q r"s:A->bool") THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← sr
     r"IMAGE f s SUBSET t <=> s SUBSET {x | x IN s /\ f x IN t}"] THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN CONJ_TAC THENL
     [MATCH_MP_TAC (← sr
       r"s SUBSET s' /\ IMAGE f s SUBSET t'
      ==> s SUBSET {x | x IN s' /\ f x IN t'}") THEN
      CONJ_TAC THEN MATCH_MP_TAC CLOSURE_OF_SUBSET THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN THEN
      EXISTS_TAC (← q r"top':B topology") THEN
      ASM_REWRITE_TAC [CLOSED_IN_CLOSURE_OF]])

  let [CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET,
       CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_ALT,
       CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_GEN] := CONJUNCTS (← prove
   r"(!top top' f:A->B.
        continuous_map (top,top') f <=>
        !s. IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s) /\
   (!top top' f:A->B.
        continuous_map (top,top') f <=>
        !s. s SUBSET topspace top
            ==> IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s) /\
   (!top top' f:A->B.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !s. IMAGE f (top closure_of s) SUBSET top' closure_of IMAGE f s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> q) /\ (q ==> q') /\ (p ==> r) /\ (q' ==> p)
    ==> (p <=> q) /\ (p <=> q') /\ (p <=> r /\ q)")) THEN
    SIMP_TAC [CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE] THEN
    DISCH_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"topspace top:A->bool")) THEN
      REWRITE_TAC [SUBSET_REFL, CLOSURE_OF_TOPSPACE] THEN
      MATCH_MP_TAC (← sr
       r"v' SUBSET v ==> IMAGE f u SUBSET v' ==> !x. x IN u ==> f x IN v") THEN
      REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE],
      X_GEN_TAC (← q r"c:B->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, SUBSET_RESTRICT] THEN
      REWRITE_TAC [← sr
       r"s SUBSET {x | x IN t /\ f x IN u} <=>
        s SUBSET t /\ IMAGE f s SUBSET u"] THEN
      REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE] THEN
      FIRST_ASSUM (fun th =>
         W (MP_TAC o PART_MATCH (lhand o rand) th o lhand o snd)) THEN
      REWRITE_TAC [SUBSET_RESTRICT] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] SUBSET_TRANS) THEN
      MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN ASM SET_TAC []]))
    | throw "CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET: CONJUNCTS"

  let CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET ← prove
   r"!top top' (f:A->B) t.
        continuous_map (top,top') f
        ==> top closure_of {x | x IN topspace top /\ f x IN t}
            SUBSET {x | x IN topspace top /\ f x IN top' closure_of t}"
   (REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN ASM_SIMP_TAC [CLOSED_IN_CLOSURE_OF] THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"topspace top' INTER t:B->bool"]
      CLOSURE_OF_SUBSET) THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT] THEN ASM SET_TAC [])

  let (CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET,
       CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET_ALT) ← CONJ_PAIR (← prove
   r"(!top top' f:A->B.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !t. top closure_of {x | x IN topspace top /\ f x IN t}
            SUBSET {x | x IN topspace top /\ f x IN top' closure_of t}) /\
   (!top top' f:A->B.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !t. t SUBSET topspace top'
            ==> top closure_of {x | x IN topspace top /\ f x IN t}
                SUBSET {x | x IN topspace top /\ f x IN top' closure_of t})"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
              CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET] THEN
    STRIP_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    X_GEN_TAC (← q r"t:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:B->bool")) THEN
    ASM_SIMP_TAC [CLOSURE_OF_CLOSED_IN, CLOSED_IN_SUBSET] THEN
    SIMP_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, SUBSET_RESTRICT]))

  let CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET ← prove
   r"!top top' (f:A->B) t.
        continuous_map (top,top') f
        ==> {x | x IN topspace top /\ f x IN top' interior_of t} SUBSET
            top interior_of {x | x IN topspace top /\ f x IN t}"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"topspace top' DIFF (t:B->bool)") o
      MATCH_MP CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET) THEN
    ASM_SIMP_TAC [INTERIOR_OF_CLOSURE_OF, ← sr
     r"IMAGE f t SUBSET u
          ==> {x | x IN t /\ f x IN u DIFF v} =
              t DIFF {x | x IN t /\ f x IN v}"] THEN
    SET_TAC [])

  let (CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET,
       CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET_ALT) ← CONJ_PAIR (← prove
   r"(!top top' f:A->B.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !t. {x | x IN topspace top /\ f x IN top' interior_of t} SUBSET
            top interior_of {x | x IN topspace top /\ f x IN t}) /\
   (!top top' f:A->B.
        continuous_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !t. t SUBSET topspace top'
            ==> {x | x IN topspace top /\ f x IN top' interior_of t} SUBSET
                top interior_of {x | x IN topspace top /\ f x IN t})"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> q) /\ (q ==> r) /\ (r ==> p) ==> (p <=> q) /\ (p <=> r)")) THEN
    SIMP_TAC [CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET,
              CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE] THEN
    STRIP_TAC THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET_ALT] THEN
    X_GEN_TAC (← q r"t:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"topspace top' DIFF (t:B->bool)")) THEN
    ASM_SIMP_TAC [CLOSURE_OF_INTERIOR_OF, ← sr
     r"IMAGE f t SUBSET u
          ==> {x | x IN t /\ f x IN u DIFF v} =
              t DIFF {x | x IN t /\ f x IN v}"] THEN
    SET_TAC []))

  let CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET ← prove
   r"!top top' (f:A->B) t.
        continuous_map (top,top') f
        ==> top frontier_of {x | x IN topspace top /\ f x IN t}
            SUBSET {x | x IN topspace top /\ f x IN top' frontier_of t}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    MATCH_MP_TAC (← sr
     r"s SUBSET {x | x IN t /\ f x IN u} /\ s' SUBSET {x | x IN t /\ f x IN u'}
    ==> s INTER s' SUBSET {x | x IN t /\ f x IN u INTER u'}") THEN
    SUBGOAL_THEN
     (← q r"topspace top DIFF {x | x IN topspace top /\ (f:A->B) x IN t} =
      {x | x IN topspace top /\ f x IN topspace top' DIFF t}")
     (fun th => ASM_SIMP_TAC [th, CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_ID ← prove
   r"!top:A topology. continuous_map (top,top) (\x. x)"
   (REWRITE_TAC [continuous_map] THEN REPEAT GEN_TAC THEN
    MATCH_MP_TAC (← MESON [] (← q r"(P x ==> x = y) ==> P x ==> P y")) THEN
    REWRITE_TAC [← sr r"u = {x | x IN s /\ x IN u} <=> u SUBSET s"] THEN
    REWRITE_TAC [OPEN_IN_SUBSET])

  let TOPOLOGY_FINER_CONTINUOUS_ID ← prove
   r"!top top':A topology.
        topspace top' = topspace top
        ==> ((!s. open_in top s ==> open_in top' s) <=>
             continuous_map (top',top) (\x. x))"
   (REWRITE_TAC [continuous_map] THEN SIMP_TAC [OPEN_IN_SUBSET, ← sr
     r"u SUBSET s ==> {x | x IN s /\ x IN u} = u"])

  let CONTINUOUS_MAP_CONST ← prove
   r"!top1:A topology top2:B topology c.
       continuous_map (top1,top2) (\x. c) <=>
       topspace top1 = {} \/ c IN topspace top2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map] THEN
    ASM_CASES_TAC (← q r"topspace top1:A->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, OPEN_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"(c:B) IN topspace top2") THEN ASM_REWRITE_TAC [] THENL
     [ALL_TAC, ASM SET_TAC []] THEN
    X_GEN_TAC (← q r"u:B->bool") THEN
    ASM_CASES_TAC (← q r"(c:B) IN u") THEN
    ASM_REWRITE_TAC [EMPTY_GSPEC, OPEN_IN_EMPTY] THEN
    REWRITE_TAC [← sr r"{x | x IN s} = s", OPEN_IN_TOPSPACE])

  let CONTINUOUS_MAP_LOCALLY_CONSTANT ← prove
   r"!top top' (f:A->B).
        (!x. x IN topspace top ==> f x IN topspace top') /\
        (!x. x IN topspace top
             ==> ?u. open_in top u /\ x IN u /\ !y. y IN u ==> f y = f x)
        ==> continuous_map (top,top') f"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [continuous_map] THEN
    X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  return { continuous_map, CONTINUOUS_MAP, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
           CONTINUOUS_MAP_ON_EMPTY, CONTINUOUS_MAP_INTO_EMPTY, CONTINUOUS_MAP_CLOSED_IN,
           OPEN_IN_CONTINUOUS_MAP_PREIMAGE, CLOSED_IN_CONTINUOUS_MAP_PREIMAGE,
           OPEN_IN_CONTINUOUS_MAP_PREIMAGE_GEN, CLOSED_IN_CONTINUOUS_MAP_PREIMAGE_GEN,
           CONTINUOUS_MAP_IMAGE_CLOSURE_SUBSET, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET,
           CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_ALT, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET_GEN,
           CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET, CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET,
           CONTINUOUS_MAP_EQ_CLOSURE_PREIMAGE_SUBSET_ALT, CONTINUOUS_MAP_INTERIOR_PREIMAGE_SUBSET,
           CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET,
           CONTINUOUS_MAP_EQ_INTERIOR_PREIMAGE_SUBSET_ALT,
           CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET, CONTINUOUS_MAP_ID,
           TOPOLOGY_FINER_CONTINUOUS_ID, CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_LOCALLY_CONSTANT }

/- ------------------------------------------------------------------------- -/
/- Continuous maps, part 2.  (metric.ml 2527-2895)                           -/
/- ------------------------------------------------------------------------- -/

structure ContMap2 where
  CONTINUOUS_MAP_COMPOSE : thm
  CONTINUOUS_MAP_EQ : thm
  RESTRICTION_CONTINUOUS_MAP : thm
  CONTINUOUS_MAP_IN_SUBTOPOLOGY : thm
  CONTINUOUS_MAP_FROM_SUBTOPOLOGY : thm
  CONTINUOUS_MAP_INTO_FULLTOPOLOGY : thm
  CONTINUOUS_MAP_INTO_SUBTOPOLOGY : thm
  CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO : thm
  CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY : thm
  CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY : thm
  CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES : thm
  PASTING_LEMMA : thm
  PASTING_LEMMA_EXISTS : thm
  PASTING_LEMMA_LOCALLY_FINITE : thm
  PASTING_LEMMA_EXISTS_LOCALLY_FINITE : thm
  PASTING_LEMMA_CLOSED : thm
  PASTING_LEMMA_EXISTS_CLOSED : thm
  CONTINUOUS_MAP_CASES : thm
  CONTINUOUS_MAP_CASES_ALT : thm
  CONTINUOUS_MAP_CASES_FUNCTION : thm
  CONTINUOUS_MAP_SEPARATED_UNION : thm
  deriving Inhabited

@[nospecialize]
def setupContMap2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BFrontier : Frontier)
    (BIterLocal : IterLocal) (BContMap1 : ContMap1) : ExceptT String IO ContMap2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, SUBST_VAR_TAC, .. } := D
  let { COND_ID, ETA_AX, EXISTS_IN_INSERT, FINITE_EMPTY, FINITE_IMAGE, FINITE_INSERT,
        FINITE_RESTRICT, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, INTER_SUBSET, IN_ELIM_THM, IN_GSPEC, IN_INTER, IN_SING, MONO_EXISTS,
        MONO_FORALL, NOT_IN_EMPTY, .. } := D.core2
  let { RESTRICTION, RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_RESTRICT, SUBSET_TRANS,
        UNIONS_GSPEC, o_THM, .. } := D.core4
  let { EQ_IMP, MONO_AND, MONO_IMP, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, closed_in, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_TRANS_FULL, OPEN_IN_SUBTOPOLOGY, OPEN_IN_TRANS_FULL, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MONO, CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBTOPOLOGY, .. } := BClosure
  let { FRONTIER_OF_CLOSURES, FRONTIER_OF_RESTRICT, .. } := BFrontier
  let { CLOSED_IN_LOCALLY_FINITE_UNIONS, locally_finite_in, .. } := BIterLocal
  let { CONTINUOUS_MAP_CLOSED_IN, CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET,
        CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET, continuous_map, .. } := BContMap1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONTINUOUS_MAP_COMPOSE ← prove
   r"!top top' top'' f:A->B g:B->C.
        continuous_map (top,top') f /\ continuous_map (top',top'') g
        ==> continuous_map (top,top'') (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map, o_THM] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"u:C->bool")] THEN
    SUBGOAL_THEN
     (← q r"{x:A | x IN topspace top /\ (g:B->C) (f x) IN u} =
      {x:A | x IN  topspace top /\ f x IN {y | y IN topspace top' /\ g y IN u}}")
    SUBST1_TAC THENL [ASM SET_TAC [], ASM SIMP_TAC []])

  let CONTINUOUS_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ continuous_map (top,top') f
        ==> continuous_map (top,top') g"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [continuous_map] THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_FORALL THEN GEN_TAC THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let RESTRICTION_CONTINUOUS_MAP ← prove
   r"!top top' f:A->B s.
        topspace top SUBSET s
        ==> (continuous_map (top,top') (RESTRICTION s f) <=>
             continuous_map (top,top') f)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN EQ_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] CONTINUOUS_MAP_EQ) THEN
    REWRITE_TAC [RESTRICTION] THEN ASM SET_TAC [])

  let CONTINUOUS_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s f:A->B.
     continuous_map (top,subtopology top' s) f <=>
     continuous_map (top,top')  f /\ IMAGE f (topspace top) SUBSET s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_map, TOPSPACE_SUBTOPOLOGY, IN_INTER,
      OPEN_IN_SUBTOPOLOGY] THEN
    EQ_TAC THEN SIMP_TAC [] THENL
    [INTRO_TAC "img cont" THEN CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
     INTRO_TAC "!u; u" THEN
     SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top /\ f x:B IN u} =
        {x | x IN topspace top /\ f x IN u INTER s}")
       (fun th => REWRITE_TAC [th]) THENL [HYP SET_TAC "img" [], ALL_TAC] THEN
     REMOVE_THEN "cont" MATCH_MP_TAC THEN EXISTS_TAC (← q r"u:B->bool") THEN
     ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
     INTRO_TAC "(img cont) img'" THEN
     CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
     INTRO_TAC "!u; @t. t ueq" THEN REMOVE_THEN "ueq" SUBST_VAR_TAC THEN
     SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top /\ f x:B IN t INTER s} =
        {x | x IN topspace top /\ f x IN t}")
       (fun th => ASM_REWRITE_TAC [th]) THEN
     ASM SET_TAC []])

  let CONTINUOUS_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' f:A->B s.
        continuous_map (top,top') f
        ==> continuous_map (subtopology top s,top') f"
   (SIMP_TAC [continuous_map, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"u:B->bool") THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    EXISTS_TAC (← q r"{x | x IN topspace top /\ (f:A->B) x IN u}") THEN
    ASM_SIMP_TAC [] THEN SET_TAC [])

  let CONTINUOUS_MAP_INTO_FULLTOPOLOGY ← prove
   r"!top top' f:A->B t.
        continuous_map (top,subtopology top' t) f
        ==> continuous_map (top,top') f"
   (SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY])

  let CONTINUOUS_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top top' f:A->B t.
        continuous_map (top,top') f /\
        IMAGE f (topspace top) SUBSET t
        ==> continuous_map (top,subtopology top' t) f"
   (SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY])

  let CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO ← prove
   r"!top top' f s t.
           continuous_map (subtopology top t,top') f /\ s SUBSET t
           ==> continuous_map (subtopology top s,top') f"
   (MESON_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
               ← sr r"s SUBSET t ==> t INTER s = s"])

  let CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY ← prove
   r"!(f:A->B) top u.
        continuous_map (discrete_topology u,top) f <=>
        IMAGE f u SUBSET topspace top"
   (REWRITE_TAC [continuous_map, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, SUBSET_RESTRICT] THEN SET_TAC [])

  let CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY ← prove
   r"!top s (f:A->B).
        continuous_map (top,discrete_topology s) f <=>
        (!x. x IN topspace top ==> f x IN s) /\
        (!x. x IN topspace top
             ==> ?v. open_in top v /\ x IN v /\ !y. y IN v ==> f y = f x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_map, TOPSPACE_DISCRETE_TOPOLOGY,
                OPEN_IN_DISCRETE_TOPOLOGY] THEN
    ASM_CASES_TAC (← q r"!x. x IN topspace top ==> (f:A->B) x IN s") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"{y | y IN topspace top /\ (f:A->B) y IN {f x}}") THEN
      REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC [SING_SUBSET],
        ASM_REWRITE_TAC [IN_ELIM_THM, IN_SING],
        SIMP_TAC [IN_ELIM_THM, IN_SING]],
      X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:A->bool") THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"y:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(f:A->B) y = f x") SUBST1_TAC THENL
       [ASM_MESON_TAC [], ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET]]])

  let CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES ← prove
   r"!top u (f:A->B).
        continuous_map (top,discrete_topology u) f <=>
        (!x. x IN topspace top ==> f x IN u) /\
        !y. y IN u ==> open_in top {x | x IN topspace top /\ f x = y}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_map, TOPSPACE_DISCRETE_TOPOLOGY,
                OPEN_IN_DISCRETE_TOPOLOGY] THEN
    ASM_CASES_TAC (← q r"!x. x IN topspace top ==> (f:A->B) x IN u") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{y:B}")) THEN
      ASM_REWRITE_TAC [SING_SUBSET, IN_SING],
      X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN v} =
        UNIONS {{x | x IN topspace top /\ f x = y} | y IN v}")
      SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [],
        MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
        ASM SET_TAC []]])

  let PASTING_LEMMA ← prove
   r"!top top' (f:K->A->B) g t k.
        (!i. i IN k
             ==> open_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x) /\
        (!x. x IN topspace top ==> ?j. j IN k /\ x IN t j /\ g x = f j x)
        ==> continuous_map(top,top') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"!i. i IN k ==> (t:K->A->bool) i SUBSET topspace top") THENL
     [ALL_TAC, ASM_MESON_TAC [OPEN_IN_SUBSET]] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET t ==> t INTER s = s"] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ g x IN u} =
      UNIONS {{x | x IN (t i) /\ ((f:K->A->B) i x) IN u} |
              i IN k}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
      MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_GSPEC] THEN
      ASM_MESON_TAC [OPEN_IN_TRANS_FULL]])

  let PASTING_LEMMA_EXISTS ← prove
   r"!top top' (f:K->A->B) t k.
        topspace top SUBSET UNIONS {t i | i IN k} /\
        (!i. i IN k
             ==> open_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x)
        ==> ?g. continuous_map(top,top') g /\
                !x i. i IN k /\ x IN topspace top INTER t i ==> g x = f i x"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. (f:K->A->B)(@i. i IN k /\ x IN t i) x") THEN CONJ_TAC THENL
     [MATCH_MP_TAC PASTING_LEMMA THEN
      MAP_EVERY EXISTS_TAC [← q r"f:K->A->B", ← q r"t:K->A->bool", ← q r"k:K->bool"] THEN
      ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [OPEN_IN_CLOSED_IN_EQ]) THEN ASM SET_TAC []])

  let PASTING_LEMMA_LOCALLY_FINITE ← prove
   r"!top top' (f:K->A->B) g t k.
        (!x. x IN topspace top
             ==> ?v. open_in top v /\ x IN v /\
                     FINITE {i | i IN k /\ ~(t i INTER v = {})}) /\
        (!i. i IN k
             ==> closed_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x) /\
        (!x. x IN topspace top ==> ?j. j IN k /\ x IN t j /\ g x = f j x)
        ==> continuous_map(top,top') g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"!i. i IN k ==> (t:K->A->bool) i SUBSET topspace top") THENL
     [ALL_TAC, ASM_MESON_TAC [CLOSED_IN_SUBSET]] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET t ==> t INTER s = s"] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ g x IN u} =
      UNIONS {{x | x IN (t i) /\ ((f:K->A->B) i x) IN u} |
              i IN k}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_LOCALLY_FINITE_UNIONS THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN
      CONJ_TAC THENL [ASM_MESON_TAC [CLOSED_IN_TRANS_FULL], ALL_TAC] THEN
      REWRITE_TAC [locally_finite_in, ← sr
       r"{y | y IN {f x | x IN s} /\ P y} = IMAGE f {x | x IN s /\ P(f x)}"] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN ASM SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"x:A") th) THEN
          ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS)) THEN
      X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC FINITE_IMAGE THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          FINITE_SUBSET)) THEN
      SET_TAC []])

  let PASTING_LEMMA_EXISTS_LOCALLY_FINITE ← prove
   r"!top top' (f:K->A->B) t k.
        (!x. x IN topspace top
             ==> ?v. open_in top v /\ x IN v /\
                     FINITE {i | i IN k /\ ~(t i INTER v = {})}) /\
        topspace top SUBSET UNIONS {t i | i IN k} /\
        (!i. i IN k
             ==> closed_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x)
        ==> ?g. continuous_map(top,top') g /\
                !x i. i IN k /\ x IN topspace top INTER t i ==> g x = f i x"
   (REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"\x. (f:K->A->B)(@i. i IN k /\ x IN t i) x") THEN CONJ_TAC THENL
     [MATCH_MP_TAC PASTING_LEMMA_LOCALLY_FINITE THEN
      MAP_EVERY EXISTS_TAC [← q r"f:K->A->B", ← q r"t:K->A->bool", ← q r"k:K->bool"] THEN
      ASM SET_TAC [],
      RULE_ASSUM_TAC (REWRITE_RULE [closed_in]) THEN ASM SET_TAC []])

  let PASTING_LEMMA_CLOSED ← prove
   r"!top top' (f:K->A->B) g t k.
        FINITE k /\
        (!i. i IN k
             ==> closed_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x) /\
        (!x. x IN topspace top ==> ?j. j IN k /\ x IN t j /\ g x = f j x)
        ==> continuous_map(top,top') g"
   (MP_TAC PASTING_LEMMA_LOCALLY_FINITE THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    MATCH_MP_TAC MONO_IMP THEN SIMP_TAC [FINITE_RESTRICT] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let PASTING_LEMMA_EXISTS_CLOSED ← prove
   r"!top top' (f:K->A->B) t k.
        FINITE k /\
        topspace top SUBSET UNIONS {t i | i IN k} /\
        (!i. i IN k
             ==> closed_in top (t i) /\
                 continuous_map(subtopology top (t i),top') (f i)) /\
        (!i j x. i IN k /\ j IN k /\ x IN topspace top INTER t i INTER t j
                 ==> f i x = f j x)
        ==> ?g. continuous_map(top,top') g /\
                !x i. i IN k /\ x IN topspace top INTER t i ==> g x = f i x"
   (MP_TAC PASTING_LEMMA_EXISTS_LOCALLY_FINITE THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    MATCH_MP_TAC MONO_IMP THEN SIMP_TAC [FINITE_RESTRICT] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let CONTINUOUS_MAP_CASES ← prove
   r"!top top' P f g:A->B.
        continuous_map (subtopology top (top closure_of {x | P x}),top') f /\
        continuous_map (subtopology top (top closure_of {x | ~P x}),top') g /\
        (!x. x IN top frontier_of {x | P x} ==> f x = g x)
        ==> continuous_map (top,top') (\x. if P x then f x else g x)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [FRONTIER_OF_CLOSURES] THEN
    REWRITE_TAC [← sr r"u DIFF {x | P x} = u INTER {x | ~P x}"] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"top':B topology",
      ← q r"\p. if p then (f:A->B) else g",
      ← q r"\x. if P x then (f:A->B) x else g x",
      ← q r"\p. if p then top closure_of {x:A | P x}
                else top closure_of {x | ~P x}",
      ← q r"{T,F}"] PASTING_LEMMA_CLOSED) THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [EXISTS_IN_INSERT, FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    ASM_REWRITE_TAC [FINITE_INSERT, CLOSED_IN_CLOSURE_OF, FINITE_EMPTY] THEN
    ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN MATCH_MP_TAC] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top INTER {x:A | P x}"]
          CLOSURE_OF_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"topspace top INTER {x:A | ~P x}"]
          CLOSURE_OF_SUBSET) THEN
    REWRITE_TAC [INTER_SUBSET, ← GSYM CLOSURE_OF_RESTRICT] THEN
    ASM SET_TAC [])

  let CONTINUOUS_MAP_CASES_ALT ← prove
   r"!top top' P f g:A->B.
        continuous_map (subtopology top
         (top closure_of {x | x IN topspace top /\ P x}),top') f /\
        continuous_map (subtopology top
         (top closure_of {x | x IN topspace top /\ ~P x}),top') g /\
        (!x. x IN top frontier_of {x | x IN topspace top /\ P x} ==> f x = g x)
        ==> continuous_map (top,top') (\x. if P x then f x else g x)"
   (REWRITE_TAC [← sr r"{x | x IN s /\ P x} = s INTER {x | P x}"] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_RESTRICT, ← GSYM FRONTIER_OF_RESTRICT] THEN
    REWRITE_TAC [CONTINUOUS_MAP_CASES])

  let CONTINUOUS_MAP_CASES_FUNCTION ← prove
   r"!top top' top'' (p:A->C) f (g:A->B) u.
        continuous_map (top,top'') p /\
        continuous_map (subtopology top
         {x | x IN topspace top /\ p x IN top'' closure_of u},top') f /\
        continuous_map (subtopology top
         {x | x IN topspace top /\
              p x IN top'' closure_of (topspace top'' DIFF u)},top') g /\
        (!x. x IN topspace top /\ p x IN top'' frontier_of u ==> f x = g x)
        ==> continuous_map (top,top') (\x. if p x IN u then f x else g x)"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MAP_CASES_ALT THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO THEN
      EXISTS_TAC
       (← q r"{x | x IN topspace top /\ (p:A->C) x IN top'' closure_of u}") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET],
      MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO THEN
      EXISTS_TAC
       (← q r"{x | x IN topspace top /\
             (p:A->C) x IN top'' closure_of (topspace top'' DIFF u)}") THEN
      ASM_REWRITE_TAC [] THEN
      W (MP_TAC o PART_MATCH (rand o rand)
        CONTINUOUS_MAP_CLOSURE_PREIMAGE_SUBSET o rand o snd) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      MATCH_MP_TAC CLOSURE_OF_MONO THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      GEN_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"u:C->bool") o  MATCH_MP
        CONTINUOUS_MAP_FRONTIER_FRONTIER_PREIMAGE_SUBSET) THEN
      ASM SET_TAC []])

  let CONTINUOUS_MAP_SEPARATED_UNION ← prove
   r"!top top' (f:A->B) s t.
        continuous_map (subtopology top s,top') f /\
        continuous_map (subtopology top t,top') f /\
        DISJOINT s (top closure_of t) /\
        DISJOINT t (top closure_of s)
        ==> continuous_map (subtopology top (s UNION t),top') f"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"subtopology top (s UNION t:A->bool)",
      ← q r"top':B topology",
      ← q r"\x:A. x IN s",
      ← q r"f:A->B", ← q r"f:A->B"] CONTINUOUS_MAP_CASES) THEN
    REWRITE_TAC [COND_ID, ETA_AX] THEN DISCH_THEN MATCH_MP_TAC THEN
    CONJ_TAC THEN MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO THENL
     [EXISTS_TAC (← q r"s:A->bool"), EXISTS_TAC (← q r"t:A->bool")] THEN
    ASM_REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [IN_GSPEC, ← sr r"(s UNION t) INTER s = s"] THEN
    ASM_REWRITE_TAC [← sr r"(s UNION t) INTER t = t"] THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"(s UNION t) INTER top closure_of t:A->bool") THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC (← sr r"t SUBSET u ==> (s INTER t) SUBSET (s INTER u)") THEN
    MATCH_MP_TAC CLOSURE_OF_MONO THEN ASM SET_TAC [])

  return { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, RESTRICTION_CONTINUOUS_MAP,
           CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
           CONTINUOUS_MAP_INTO_FULLTOPOLOGY, CONTINUOUS_MAP_INTO_SUBTOPOLOGY,
           CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO, CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY, CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY, CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES,
           PASTING_LEMMA, PASTING_LEMMA_EXISTS, PASTING_LEMMA_LOCALLY_FINITE,
           PASTING_LEMMA_EXISTS_LOCALLY_FINITE, PASTING_LEMMA_CLOSED,
           PASTING_LEMMA_EXISTS_CLOSED, CONTINUOUS_MAP_CASES, CONTINUOUS_MAP_CASES_ALT,
           CONTINUOUS_MAP_CASES_FUNCTION, CONTINUOUS_MAP_SEPARATED_UNION }

/- ------------------------------------------------------------------------- -/
/- Open and closed maps, part 1.  (metric.ml 2900-3157)                      -/
/- ------------------------------------------------------------------------- -/

structure OpenClosed1 where
  open_map : thm
  closed_map : thm
  OPEN_MAP_IMP_SUBSET_TOPSPACE : thm
  OPEN_MAP_IMP_SUBSET : thm
  TOPOLOGY_FINER_OPEN_ID : thm
  OPEN_MAP_ID : thm
  OPEN_MAP_EQ : thm
  OPEN_MAP_INCLUSION_EQ : thm
  OPEN_MAP_INCLUSION : thm
  OPEN_MAP_COMPOSE : thm
  CLOSED_MAP_IMP_SUBSET_TOPSPACE : thm
  CLOSED_MAP_IMP_SUBSET : thm
  TOPOLOGY_FINER_CLOSED_ID : thm
  CLOSED_MAP_ID : thm
  CLOSED_MAP_EQ : thm
  CLOSED_MAP_COMPOSE : thm
  CLOSED_MAP_INCLUSION_EQ : thm
  CLOSED_MAP_INCLUSION : thm
  OPEN_MAP_INTO_SUBTOPOLOGY : thm
  CLOSED_MAP_INTO_SUBTOPOLOGY : thm
  OPEN_MAP_INTO_DISCRETE_TOPOLOGY : thm
  CLOSED_MAP_INTO_DISCRETE_TOPOLOGY : thm
  BIJECTIVE_OPEN_IMP_CLOSED_MAP : thm
  BIJECTIVE_CLOSED_IMP_OPEN_MAP : thm
  OPEN_MAP_ON_EMPTY : thm
  CLOSED_MAP_ON_EMPTY : thm
  OPEN_MAP_FROM_SUBTOPOLOGY : thm
  CLOSED_MAP_FROM_SUBTOPOLOGY : thm
  OPEN_MAP_RESTRICTION : thm
  CLOSED_MAP_RESTRICTION : thm
  CLOSED_MAP_CLOSURE_OF_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupOpenClosed1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) : ExceptT String IO OpenClosed1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMAGE_CLAUSES, IMAGE_ID, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_o, INJECTIVE_ON_ALT, INTER_COMM, IN_ELIM_THM, .. } := D.core2
  let { SUBSET, SUBSET_TRANS, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE,
        FORALL_CLOSED_IN, FORALL_OPEN_IN, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_EMPTY, OPEN_IN_INTER,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { CLOSED_IN_DISCRETE_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_SUBTOPOLOGY, CLOSED_IN_SUBTOPOLOGY_ALT, CLOSED_IN_TOPSPACE_EMPTY,
        OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_ALT, OPEN_IN_TOPSPACE_EMPTY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_EQ, .. } := BClosure
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let open_map ← new_definition
   r"open_map (top1,top2) (f:A->B) <=>
  !u. open_in top1 u ==> open_in top2 (IMAGE f u)"

  let closed_map ← new_definition
   r"closed_map (top1,top2) (f:A->B) <=>
  !u. closed_in top1 u ==> closed_in top2 (IMAGE f u)"

  let OPEN_MAP_IMP_SUBSET_TOPSPACE ← prove
   r"!top1 top2 f:A->B.
        open_map (top1,top2) f
        ==> IMAGE f (topspace top1) SUBSET topspace top2"
   (MESON_TAC [OPEN_IN_SUBSET, open_map, OPEN_IN_TOPSPACE])

  let OPEN_MAP_IMP_SUBSET ← prove
   r"!top1 top2 f:A->B s.
        open_map (top1,top2) f /\ s SUBSET topspace top1
        ==> IMAGE f s SUBSET topspace top2"
   (MESON_TAC [OPEN_MAP_IMP_SUBSET_TOPSPACE, IMAGE_SUBSET, SUBSET_TRANS])

  let TOPOLOGY_FINER_OPEN_ID ← prove
   r"!top top':A topology.
        (!s. open_in top s ==> open_in top' s) <=>
        open_map (top,top') (\x. x)"
   (REWRITE_TAC [open_map, IMAGE_ID])

  let OPEN_MAP_ID ← prove
   r"!top:A topology. open_map(top,top) (\x. x)"
   (REWRITE_TAC [← GSYM TOPOLOGY_FINER_OPEN_ID])

  let OPEN_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ open_map (top,top') f
        ==> open_map (top,top') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let OPEN_MAP_INCLUSION_EQ ← prove
   r"!top s:A->bool.
        open_map (subtopology top s,top) (\x. x) <=>
        open_in top (topspace top INTER s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    REWRITE_TAC [open_map, OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [IMAGE_ID, FORALL_IN_GSPEC] THEN
    EQ_TAC THEN SIMP_TAC [OPEN_IN_TOPSPACE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s INTER t:A->bool = (s INTER topspace top) INTER t")
    SUBST1_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [OPEN_IN_INTER]])

  let OPEN_MAP_INCLUSION ← prove
   r"!top s:A->bool.
        open_in top s ==> open_map (subtopology top s,top) (\x. x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    REWRITE_TAC [OPEN_MAP_INCLUSION_EQ] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"])

  let OPEN_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        open_map(top,top') f /\ open_map(top',top'') g
        ==> open_map(top,top'') (g o f)"
   (REWRITE_TAC [open_map, IMAGE_o] THEN MESON_TAC [])

  let CLOSED_MAP_IMP_SUBSET_TOPSPACE ← prove
   r"!top1 top2 f:A->B.
        closed_map (top1,top2) f
        ==> IMAGE f (topspace top1) SUBSET topspace top2"
   (MESON_TAC [CLOSED_IN_SUBSET, closed_map, CLOSED_IN_TOPSPACE])

  let CLOSED_MAP_IMP_SUBSET ← prove
   r"!top1 top2 f:A->B s.
        closed_map (top1,top2) f /\ s SUBSET topspace top1
        ==> IMAGE f s SUBSET topspace top2"
   (MESON_TAC [CLOSED_MAP_IMP_SUBSET_TOPSPACE, IMAGE_SUBSET, SUBSET_TRANS])

  let TOPOLOGY_FINER_CLOSED_ID ← prove
   r"!top top':A topology.
        (!s. closed_in top s ==> closed_in top' s) <=>
        closed_map (top,top') (\x. x)"
   (REWRITE_TAC [closed_map, IMAGE_ID])

  let CLOSED_MAP_ID ← prove
   r"!top:A topology. closed_map(top,top) (\x. x)"
   (REWRITE_TAC [← GSYM TOPOLOGY_FINER_CLOSED_ID])

  let CLOSED_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ closed_map (top,top') f
        ==> closed_map (top,top') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [])

  let CLOSED_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        closed_map(top,top') f /\ closed_map(top',top'') g
        ==> closed_map(top,top'') (g o f)"
   (REWRITE_TAC [closed_map, IMAGE_o] THEN MESON_TAC [])

  let CLOSED_MAP_INCLUSION_EQ ← prove
   r"!top s:A->bool.
        closed_map (subtopology top s,top) (\x. x) <=>
        closed_in top (topspace top INTER s)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [INTER_COMM] THEN
    REWRITE_TAC [closed_map, CLOSED_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [IMAGE_ID, FORALL_IN_GSPEC] THEN
    EQ_TAC THEN SIMP_TAC [CLOSED_IN_TOPSPACE] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"s INTER t:A->bool = (s INTER topspace top) INTER t")
    SUBST1_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [CLOSED_IN_INTER]])

  let CLOSED_MAP_INCLUSION ← prove
   r"!top s:A->bool.
        closed_in top s ==> closed_map (subtopology top s,top) (\x. x)"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    REWRITE_TAC [CLOSED_MAP_INCLUSION_EQ] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"])

  let OPEN_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) s.
        open_map (top,top') f /\ IMAGE f (topspace top) SUBSET s
        ==> open_map (top,subtopology top' s) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map, OPEN_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) u") THEN ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let CLOSED_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) s.
        closed_map (top,top') f /\ IMAGE f (topspace top) SUBSET s
        ==> closed_map (top,subtopology top' s) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map, CLOSED_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) u") THEN ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [])

  let OPEN_MAP_INTO_DISCRETE_TOPOLOGY ← prove
   r"!(f:A->B) top u.
        open_map (top,discrete_topology u) f <=>
        IMAGE f (topspace top) SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    MESON_TAC [OPEN_IN_TOPSPACE, OPEN_IN_SUBSET, SUBSET])

  let CLOSED_MAP_INTO_DISCRETE_TOPOLOGY ← prove
   r"!(f:A->B) top u.
        closed_map (top,discrete_topology u) f <=>
        IMAGE f (topspace top) SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map, CLOSED_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
    MESON_TAC [CLOSED_IN_TOPSPACE, CLOSED_IN_SUBSET, SUBSET])

  let BIJECTIVE_OPEN_IMP_CLOSED_MAP ← prove
   r"!top top' f:A->B.
        open_map (top,top') f /\ IMAGE f (topspace top) = topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y)
        ==> closed_map (top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [open_map, closed_map, INJECTIVE_ON_ALT] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [FORALL_CLOSED_IN] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN
    ASM_REWRITE_TAC [closed_in] THEN
    DISCH_THEN (fun th => CONJ_TAC THENL [ASM SET_TAC [], MP_TAC th]) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let BIJECTIVE_CLOSED_IMP_OPEN_MAP ← prove
   r"!top top' f:A->B.
        closed_map (top,top') f /\ IMAGE f (topspace top) = topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y)
        ==> open_map (top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [open_map, closed_map, INJECTIVE_ON_ALT] THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [FORALL_OPEN_IN] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN
    ASM_REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN
    DISCH_THEN (fun th => CONJ_TAC THENL [ASM SET_TAC [], MP_TAC th]) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [])

  let OPEN_MAP_ON_EMPTY ← prove
   r"!top top' (f:A->B). topspace top = {} ==> open_map(top,top') f"
   (SIMP_TAC [open_map, OPEN_IN_TOPSPACE_EMPTY] THEN
    REWRITE_TAC [IMAGE_CLAUSES, OPEN_IN_EMPTY])

  let CLOSED_MAP_ON_EMPTY ← prove
   r"!top top' (f:A->B). topspace top = {} ==> closed_map(top,top') f"
   (SIMP_TAC [closed_map, CLOSED_IN_TOPSPACE_EMPTY] THEN
    REWRITE_TAC [IMAGE_CLAUSES, CLOSED_IN_EMPTY])

  let OPEN_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) u.
        open_map(top,top') f /\ open_in top u
        ==> open_map (subtopology top u,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN STRIP_TAC THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN ASM_SIMP_TAC [OPEN_IN_INTER])

  let CLOSED_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) u.
        closed_map(top,top') f /\ closed_in top u
        ==> closed_map (subtopology top u,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map] THEN STRIP_TAC THEN
    REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN ASM_SIMP_TAC [CLOSED_IN_INTER])

  let OPEN_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        open_map(top,top') f /\ {x | x IN topspace top /\ f x IN v} = u
        ==> open_map (subtopology top u,subtopology top' v) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN STRIP_TAC THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) t") THEN ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let CLOSED_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        closed_map(top,top') f /\ {x | x IN topspace top /\ f x IN v} = u
        ==> closed_map (subtopology top u,subtopology top' v) f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map] THEN STRIP_TAC THEN
    REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) t") THEN ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [])

  let CLOSED_MAP_CLOSURE_OF_IMAGE ← prove
   r"!top top' f:A->B.
        closed_map (top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !s. s SUBSET topspace top
            ==> top' closure_of (IMAGE f s) SUBSET IMAGE f (top closure_of s)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"IMAGE (f:A->B) (topspace top) SUBSET topspace top'") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [CLOSED_MAP_IMP_SUBSET_TOPSPACE]] THEN
    REWRITE_TAC [closed_map] THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THENL
     [MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
      ASM_SIMP_TAC [CLOSED_IN_CLOSURE_OF] THEN MATCH_MP_TAC IMAGE_SUBSET THEN
      ASM_SIMP_TAC [CLOSURE_OF_SUBSET],
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
      ASM_SIMP_TAC [CLOSURE_OF_CLOSED_IN, ← GSYM CLOSURE_OF_SUBSET_EQ] THEN
      ASM SET_TAC []])

  return { open_map, closed_map, OPEN_MAP_IMP_SUBSET_TOPSPACE, OPEN_MAP_IMP_SUBSET,
           TOPOLOGY_FINER_OPEN_ID, OPEN_MAP_ID, OPEN_MAP_EQ, OPEN_MAP_INCLUSION_EQ,
           OPEN_MAP_INCLUSION, OPEN_MAP_COMPOSE, CLOSED_MAP_IMP_SUBSET_TOPSPACE,
           CLOSED_MAP_IMP_SUBSET, TOPOLOGY_FINER_CLOSED_ID, CLOSED_MAP_ID, CLOSED_MAP_EQ,
           CLOSED_MAP_COMPOSE, CLOSED_MAP_INCLUSION_EQ, CLOSED_MAP_INCLUSION,
           OPEN_MAP_INTO_SUBTOPOLOGY, CLOSED_MAP_INTO_SUBTOPOLOGY,
           OPEN_MAP_INTO_DISCRETE_TOPOLOGY, CLOSED_MAP_INTO_DISCRETE_TOPOLOGY,
           BIJECTIVE_OPEN_IMP_CLOSED_MAP, BIJECTIVE_CLOSED_IMP_OPEN_MAP, OPEN_MAP_ON_EMPTY,
           CLOSED_MAP_ON_EMPTY, OPEN_MAP_FROM_SUBTOPOLOGY, CLOSED_MAP_FROM_SUBTOPOLOGY,
           OPEN_MAP_RESTRICTION, CLOSED_MAP_RESTRICTION, CLOSED_MAP_CLOSURE_OF_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Open and closed maps, part 2.  (metric.ml 3159-3412)                      -/
/- ------------------------------------------------------------------------- -/

structure OpenClosed2 where
  OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET : thm
  OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_ALT : thm
  OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_GEN : thm
  OPEN_MAP_PREIMAGE_NEIGHBOURHOOD : thm
  CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD : thm
  CLOSED_MAP_FIBRE_NEIGHBOURHOOD : thm
  OPEN_MAP_IN_SUBTOPOLOGY : thm
  OPEN_MAP_FROM_OPEN_SUBTOPOLOGY : thm
  CLOSED_MAP_IN_SUBTOPOLOGY : thm
  CLOSED_MAP_FROM_CLOSED_SUBTOPOLOGY : thm
  CLOSED_MAP_FROM_COMPOSITION_LEFT : thm
  CLOSED_MAP_FROM_COMPOSITION_RIGHT : thm
  OPEN_MAP_FROM_COMPOSITION_LEFT : thm
  OPEN_MAP_FROM_COMPOSITION_RIGHT : thm
  CLOSED_MAP_CONST : thm
  DISCRETE_SPACE_OPEN_MAP_IMAGE : thm
  DISCRETE_SPACE_CLOSED_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupOpenClosed2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BInterior : Interior) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) : ExceptT String IO OpenClosed2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { AND_FORALL_THM, COND_RAND, FORALL_SUBSET_IMAGE, FUN_EQ_THM, IMAGE_CONST, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IN_SING, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { SING_SUBSET, SKOLEM_THM, SUBSET_INTER, SUBSET_TRANS, .. } := D.core4
  let { EQ_IMP, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { DISCRETE_SPACE_CLOSED, DISCRETE_SPACE_CLOSED_EQ, DISCRETE_SPACE_OPEN,
        DISCRETE_SPACE_OPEN_EQ, .. } := BDiscrete
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
        .. } := BSubtopology
  let { INTERIOR_OF_MAXIMAL, INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF, SUBSET_INTERIOR_OF_EQ,
        .. } := BInterior
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map,
        .. } := BContMap1
  let { CLOSED_MAP_IMP_SUBSET_TOPSPACE, CLOSED_MAP_INTO_SUBTOPOLOGY, CLOSED_MAP_ON_EMPTY,
        OPEN_MAP_IMP_SUBSET_TOPSPACE, OPEN_MAP_INTO_SUBTOPOLOGY, closed_map, open_map,
        .. } := BOpenClosed1
  -- @@SCOPE END

  let [OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET,
       OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_ALT,
       OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_GEN] := CONJUNCTS (← prove
   r"(!top top' f:A->B.
        open_map (top,top') f <=>
        !s. IMAGE f (top interior_of s) SUBSET
            top' interior_of (IMAGE f s)) /\
   (!top top' f:A->B.
      open_map (top,top') f <=>
      !s. s SUBSET topspace top
          ==> IMAGE f (top interior_of s) SUBSET
              top' interior_of (IMAGE f s)) /\
   (!top top' f:A->B.
      open_map (top,top') f <=>
      IMAGE f (topspace top) SUBSET topspace top' /\
      !s. IMAGE f (top interior_of s) SUBSET top' interior_of (IMAGE f s))"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(q ==> q') /\ (p ==> r) /\ (p ==> q) /\ (q' ==> p)
    ==> (p <=> q) /\ (p <=> q') /\ (p <=> r /\ q)")) THEN
    SIMP_TAC [OPEN_MAP_IMP_SUBSET_TOPSPACE] THEN CONJ_TAC THEN DISCH_TAC THENL
     [FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_MAP_IMP_SUBSET_TOPSPACE) THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"s:A->bool") THEN
      MATCH_MP_TAC INTERIOR_OF_MAXIMAL THEN
      SIMP_TAC [IMAGE_SUBSET, INTERIOR_OF_SUBSET] THEN
      FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [open_map]) THEN
      REWRITE_TAC [OPEN_IN_INTERIOR_OF],
      REWRITE_TAC [open_map] THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
      ASM_SIMP_TAC [OPEN_IN_SUBSET, ← GSYM SUBSET_INTERIOR_OF_EQ] THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
      MATCH_MP_TAC IMAGE_SUBSET THEN
      ASM_REWRITE_TAC [SUBSET_INTERIOR_OF_EQ]]))
    | throw "OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET: CONJUNCTS"

  let OPEN_MAP_PREIMAGE_NEIGHBOURHOOD ← prove
   r"!top top' (f:A->B).
        open_map(top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !u t. closed_in top u /\ t SUBSET topspace top' /\
              {x | x IN topspace top /\ f x IN t} SUBSET u
              ==> ?v. closed_in top' v /\ t SUBSET v /\
                      {x | x IN topspace top /\ f x IN v} SUBSET u"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_MAP_IMP_SUBSET_TOPSPACE) THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF u)") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [open_map]) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF,
                    OPEN_IN_TOPSPACE] THEN
      ASM SET_TAC [],
      STRIP_TAC THEN REWRITE_TAC [open_map] THEN X_GEN_TAC (← q r"c:A->bool") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"topspace top DIFF c:A->bool",
        ← q r"topspace top' DIFF IMAGE (f:A->B) c"]) THEN
      ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:B->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"IMAGE (f:A->B) c = topspace top' DIFF v") SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
        ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE]]])

  let CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !u t. open_in top u /\ t SUBSET topspace top' /\
              {x | x IN topspace top /\ f x IN t} SUBSET u
              ==> ?v. open_in top' v /\ t SUBSET v /\
                      {x | x IN topspace top /\ f x IN v} SUBSET u"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
      ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF u)") THEN
      RULE_ASSUM_TAC (REWRITE_RULE [closed_map]) THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE, CLOSED_IN_DIFF,
                    CLOSED_IN_TOPSPACE] THEN
      ASM SET_TAC [],
      STRIP_TAC THEN REWRITE_TAC [closed_map] THEN X_GEN_TAC (← q r"c:A->bool") THEN
      DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"topspace top DIFF c:A->bool",
        ← q r"topspace top' DIFF IMAGE (f:A->B) c"]) THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:B->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"IMAGE (f:A->B) c = topspace top' DIFF v") SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
        ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE]]])

  let CLOSED_MAP_FIBRE_NEIGHBOURHOOD ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f <=>
        IMAGE f (topspace top) SUBSET topspace top' /\
        !u y. open_in top u /\ y IN topspace top' /\
              {x | x IN topspace top /\ f x = y} SUBSET u
              ==> ?v. open_in top' v /\ y IN v /\
                      {x | x IN topspace top /\ f x IN v} SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q <=> p /\ r) <=> p ==> (q <=> r)")] THEN
    DISCH_TAC THEN AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [] THEN
    EQ_TAC THENL [SIMP_TAC [← GSYM IN_SING, ← GSYM SING_SUBSET], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"vv:B->B->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"t:B->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS { (vv:B->B->bool) y | y IN t}") THEN CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [], ASM SET_TAC []])

  let OPEN_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        open_in top' s
        ==> (open_map(top,subtopology top' s) f <=>
             open_map(top,top') f /\ IMAGE f (topspace top) SUBSET s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [OPEN_MAP_INTO_SUBTOPOLOGY] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_MAP_IMP_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [open_map]) THEN
    ASM_SIMP_TAC [open_map, OPEN_IN_OPEN_SUBTOPOLOGY])

  let OPEN_MAP_FROM_OPEN_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        open_in top' s /\ open_map(top,subtopology top' s) f
        ==> open_map(top,top') f"
   (MESON_TAC [OPEN_MAP_IN_SUBTOPOLOGY])

  let CLOSED_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        closed_in top' s
        ==> (closed_map(top,subtopology top' s) f <=>
             closed_map(top,top') f /\ IMAGE f (topspace top) SUBSET s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    ASM_SIMP_TAC [CLOSED_MAP_INTO_SUBTOPOLOGY] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_map]) THEN
    ASM_SIMP_TAC [closed_map, CLOSED_IN_CLOSED_SUBTOPOLOGY])

  let CLOSED_MAP_FROM_CLOSED_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        closed_in top' s /\ closed_map(top,subtopology top' s) f
        ==> closed_map(top,top') f"
   (MESON_TAC [CLOSED_MAP_IN_SUBTOPOLOGY])

  let CLOSED_MAP_FROM_COMPOSITION_LEFT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        closed_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> closed_map(top',top'') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"c:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"{x | x IN topspace top /\ (f:A->B) x IN c}")) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN REWRITE_TAC [IMAGE_o] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []])

  let CLOSED_MAP_FROM_COMPOSITION_RIGHT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        closed_map(top,top'') (g o f) /\
        IMAGE f (topspace top) SUBSET topspace top' /\
        continuous_map(top',top'') g /\
        (!x y. x IN topspace top' /\ y IN topspace top' /\ g x = g y
               ==> x = y)
        ==> closed_map(top,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closed_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE f c =
      {x | x IN topspace top' /\ g x IN IMAGE ((g:B->C) o (f:A->B)) c}")
    SUBST1_TAC THENL
     [REWRITE_TAC [IMAGE_o] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC []])

  let OPEN_MAP_FROM_COMPOSITION_LEFT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        open_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> open_map(top',top'') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"{x | x IN topspace top /\ (f:A->B) x IN u}")) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN REWRITE_TAC [IMAGE_o] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []])

  let OPEN_MAP_FROM_COMPOSITION_RIGHT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        open_map(top,top'') (g o f) /\
        IMAGE f (topspace top) SUBSET topspace top' /\
        continuous_map(top',top'') g /\
        (!x y. x IN topspace top' /\ y IN topspace top' /\ g x = g y
               ==> x = y)
        ==> open_map(top,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE f u =
      {x | x IN topspace top' /\ g x IN IMAGE ((g:B->C) o (f:A->B)) u}")
    SUBST1_TAC THENL
     [REWRITE_TAC [IMAGE_o] THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC []])

  let CLOSED_MAP_CONST ← prove
   r"!(top:A topology) top' (c:B).
        closed_map(top,top') (\x. c) <=>
        topspace top = {} \/ closed_in top' {c}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [CLOSED_MAP_ON_EMPTY] THEN REWRITE_TAC [closed_map] THEN
    REWRITE_TAC [IMAGE_CONST] THEN ONCE_REWRITE_TAC [COND_RAND] THEN
    REWRITE_TAC [CLOSED_IN_EMPTY, ← TAUT (← q r"(if p then T else q) <=> p \/ q")] THEN
    ASM_MESON_TAC [CLOSED_IN_TOPSPACE])

  let DISCRETE_SPACE_OPEN_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        open_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        discrete_space top
        ==> discrete_space top'"
   (REWRITE_TAC [open_map] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [DISCRETE_SPACE_OPEN] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
    ASM_MESON_TAC [DISCRETE_SPACE_OPEN_EQ])

  let DISCRETE_SPACE_CLOSED_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        discrete_space top
        ==> discrete_space top'"
   (REWRITE_TAC [closed_map] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [DISCRETE_SPACE_CLOSED] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
    ASM_MESON_TAC [DISCRETE_SPACE_CLOSED_EQ])

  return { OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET, OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_ALT,
           OPEN_MAP_INTERIOR_OF_IMAGE_SUBSET_GEN, OPEN_MAP_PREIMAGE_NEIGHBOURHOOD,
           CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD, CLOSED_MAP_FIBRE_NEIGHBOURHOOD,
           OPEN_MAP_IN_SUBTOPOLOGY, OPEN_MAP_FROM_OPEN_SUBTOPOLOGY, CLOSED_MAP_IN_SUBTOPOLOGY,
           CLOSED_MAP_FROM_CLOSED_SUBTOPOLOGY, CLOSED_MAP_FROM_COMPOSITION_LEFT,
           CLOSED_MAP_FROM_COMPOSITION_RIGHT, OPEN_MAP_FROM_COMPOSITION_LEFT,
           OPEN_MAP_FROM_COMPOSITION_RIGHT, CLOSED_MAP_CONST, DISCRETE_SPACE_OPEN_MAP_IMAGE,
           DISCRETE_SPACE_CLOSED_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Quotient maps.  (metric.ml 3414-3718)                                     -/
/- ------------------------------------------------------------------------- -/

structure Quotient where
  quotient_map : thm
  QUOTIENT_MAP_EQ : thm
  QUOTIENT_MAP_COMPOSE : thm
  QUOTIENT_MAP_FROM_COMPOSITION : thm
  QUOTIENT_IMP_CONTINUOUS_MAP : thm
  QUOTIENT_IMP_SURJECTIVE_MAP : thm
  QUOTIENT_MAP : thm
  CONTINUOUS_OPEN_IMP_QUOTIENT_MAP : thm
  CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP : thm
  CONTINUOUS_OPEN_QUOTIENT_MAP : thm
  CONTINUOUS_CLOSED_QUOTIENT_MAP : thm
  INJECTIVE_QUOTIENT_MAP : thm
  CONTINUOUS_COMPOSE_QUOTIENT_MAP : thm
  CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ : thm
  QUOTIENT_MAP_COMPOSE_EQ : thm
  QUOTIENT_MAP_RESTRICTION : thm
  QUOTIENT_MAP_SATURATED_OPEN : thm
  QUOTIENT_MAP_SATURATED_CLOSED : thm
  QUOTIENT_MAP_ONTO_IMAGE : thm
  QUOTIENT_MAP_LIFT_EXISTS : thm
  DISCRETE_SPACE_QUOTIENT_MAP_IMAGE : thm
  quotient_topology : thm
  OPEN_IN_QUOTIENT_TOPOLOGY : thm
  TOPSPACE_QUOTIENT_TOPOLOGY : thm
  CLOSED_IN_QUOTIENT_TOPOLOGY : thm
  QUOTIENT_MAP_QUOTIENT_TOPOLOGY : thm
  QUOTIENT_MAP_QUOTIENT_TOPOLOGY_EQ : thm
  CONTINUOUS_MAP_QUOTIENT_TOPOLOGY : thm
  CONTINUOUS_MAP_FROM_QUOTIENT_TOPOLOGY : thm
  OPEN_IN_QUOTIENT_TOPOLOGY_INJ : thm
  deriving Inhabited

@[nospecialize]
def setupQuotient [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) : ExceptT String IO Quotient := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, EMPTY_GSPEC, EMPTY_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FUNCTION_FACTORS_LEFT_GEN, .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, IN_ELIM_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_ANTISYM, SUBSET_DIFF, SUBSET_INTER, SUBSET_REFL,
        SUBSET_RESTRICT, o_THM, .. } := D.core4
  let { EQ_IMP, FORALL_AND_THM, MONO_AND, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        OPEN_IN_UNIONS, TOPOLOGY_EQ, closed_in, istopology, topology_tybij, .. } := BTopology
  let { DISCRETE_SPACE_UNIQUE, OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY,
        discrete_space, .. } := BDiscrete
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, OPEN_IN_SUBSET_TOPSPACE,
        OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP, CONTINUOUS_MAP_CLOSED_IN, OPEN_IN_CONTINUOUS_MAP_PREIMAGE,
        continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, .. } := BContMap2
  let { closed_map, open_map, .. } := BOpenClosed1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let quotient_map ← new_definition
   r"quotient_map (top,top') (f:A->B) <=>
        IMAGE f (topspace top) = topspace top' /\
        !u. u SUBSET topspace top'
            ==> (open_in top {x | x IN topspace top /\ f x IN u} <=>
                 open_in top' u)"

  let QUOTIENT_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ quotient_map (top,top') f
        ==> quotient_map (top,top') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ABS_TAC THEN
    AP_TERM_TAC THEN AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let QUOTIENT_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        quotient_map(top,top') f /\ quotient_map(top',top'') g
        ==> quotient_map(top,top'') (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map, IMAGE_o, o_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"w:C->bool") THEN DISCH_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPEC (← q r"{y | y IN topspace top' /\ (g:B->C) y IN w}")) THEN
    ASM_SIMP_TAC [SUBSET_RESTRICT] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let QUOTIENT_MAP_FROM_COMPOSITION ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        continuous_map(top,top') f /\ continuous_map(top',top'') g /\
        quotient_map(top,top'') (g o f)
        ==> quotient_map(top',top'') g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [quotient_map, continuous_map, IMAGE_o, o_THM] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"w:C->bool") THEN DISCH_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    ASM_SIMP_TAC [] THEN
    FIRST_ASSUM (fun th => W (MP_TAC o PART_MATCH (rand o rand) th o snd)) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], DISCH_THEN (SUBST1_TAC o SYM)] THEN
    SUBGOAL_THEN
     (← q r"{x:A | x IN topspace top /\ (g:B->C) (f x) IN w} =
      {x | x IN topspace top /\
           f x IN {y | y IN topspace top' /\ g y IN w}}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
    EXISTS_TAC (← q r"top':B topology") THEN ASM_SIMP_TAC [continuous_map])

  let QUOTIENT_IMP_CONTINUOUS_MAP ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f ==> continuous_map (top,top') f"
   (SIMP_TAC [quotient_map, CONTINUOUS_MAP, OPEN_IN_SUBSET, SUBSET_REFL])

  let QUOTIENT_IMP_SURJECTIVE_MAP ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f ==> IMAGE f (topspace top) = topspace top'"
   (SIMP_TAC [quotient_map])

  let QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f <=>
        IMAGE f (topspace top) = topspace top' /\
        !u. u SUBSET topspace top'
            ==> (closed_in top {x | x IN topspace top /\ f x IN u} <=>
                 closed_in top' u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    DISCH_TAC THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"s:B->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"topspace top' DIFF s:B->bool")) THEN
    ASM_SIMP_TAC [closed_in, SUBSET_RESTRICT, SUBSET_DIFF,
                  ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_OPEN_IMP_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\ open_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> quotient_map (top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_map, open_map, quotient_map] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"v:B->bool") THEN
    DISCH_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\ closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> quotient_map (top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, closed_map, QUOTIENT_MAP] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"v:B->bool") THEN
    DISCH_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [] THEN
    DISCH_THEN (ANTE_RES_THEN MP_TAC) THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_OPEN_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\
        open_map (top,top') f
        ==> (quotient_map (top,top') f <=>
             IMAGE f (topspace top) = topspace top')"
   (MESON_TAC [CONTINUOUS_OPEN_IMP_QUOTIENT_MAP, quotient_map])

  let CONTINUOUS_CLOSED_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\
        closed_map (top,top') f
        ==> (quotient_map (top,top') f <=>
             IMAGE f (topspace top) = topspace top')"
   (MESON_TAC [CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, quotient_map])

  let INJECTIVE_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        (!x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y))
        ==> (quotient_map (top,top') f <=>
             continuous_map (top,top') f /\
             open_map (top,top') f /\
             closed_map (top,top') f /\
             IMAGE f (topspace top) = topspace top')"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [CONTINUOUS_OPEN_IMP_QUOTIENT_MAP]] THEN
    SIMP_TAC [QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [open_map, closed_map] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THENL
     [FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [quotient_map]),
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [QUOTIENT_MAP])] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
     (MP_TAC o SPEC (← q r"IMAGE (f:A->B) u"))) THEN
    (ANTS_TAC THENL [ASM SET_TAC [], DISCH_THEN (SUBST1_TAC o SYM)]) THEN
    SUBGOAL_THEN (← q r"{x | x IN topspace top /\ (f:A->B) x IN IMAGE f u} = u")
     (fun th => ASM_REWRITE_TAC [th]) THEN
    ASM SET_TAC [])

  let CONTINUOUS_COMPOSE_QUOTIENT_MAP ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        quotient_map (top,top') f /\
        continuous_map (top,top'') (g o f)
        ==> continuous_map (top',top'') g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [quotient_map, continuous_map, o_THM] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"v:C->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (fun th => W (MP_TAC o PART_MATCH (rand o rand) th o snd)) THEN
    REWRITE_TAC [SUBSET_RESTRICT] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"v:C->bool")) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        quotient_map (top,top') f
        ==> (continuous_map (top,top'') (g o f) <=>
             continuous_map (top',top'') g)"
   (MESON_TAC [CONTINUOUS_COMPOSE_QUOTIENT_MAP, QUOTIENT_IMP_CONTINUOUS_MAP,
               CONTINUOUS_MAP_COMPOSE])

  let QUOTIENT_MAP_COMPOSE_EQ ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        quotient_map(top,top') f
        ==> (quotient_map(top,top'') (g o f) <=> quotient_map(top',top'') g)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ALL_TAC, ASM_MESON_TAC [QUOTIENT_MAP_COMPOSE]] THEN
    DISCH_THEN (fun th => ASSUME_TAC th THEN MP_TAC th) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] QUOTIENT_MAP_FROM_COMPOSITION)) THEN
    ASM_MESON_TAC [CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ,
                   QUOTIENT_IMP_CONTINUOUS_MAP])

  let QUOTIENT_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        quotient_map(top,top') f /\
        (open_in top' v \/ closed_in top' v) /\
        {x | x IN topspace top /\ f x IN v} = u
        ==> quotient_map (subtopology top u,subtopology top' v) f"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THENL
     [REWRITE_TAC [quotient_map] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET),
      REWRITE_TAC [QUOTIENT_MAP] THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET)] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    STRIP_TAC THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY, CLOSED_IN_CLOSED_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [← sr
      r"u SUBSET v
       ==> (x IN t INTER {x | x IN t /\ f x IN v} /\ f x IN u <=>
            x IN t /\ f x IN u)"] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let QUOTIENT_MAP_SATURATED_OPEN ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f <=>
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        !u. open_in top u /\
            {x | x IN topspace top /\ f x IN IMAGE f u} SUBSET u
            ==> open_in top' (IMAGE f u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_map, continuous_map] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, FORALL_AND_THM, ← TAUT (← q
     r"(p ==> (q <=> r)) <=> (p /\ q ==> r) /\ (r ==> p ==> q)")] THEN
    SIMP_TAC [OPEN_IN_SUBSET] THEN MATCH_MP_TAC (← TAUT (← q
     r"(i ==> j) /\ (i /\ c ==> (p <=> q))
    ==> (i /\ p /\ c <=> j /\ c /\ i /\ q)")) THEN
    CONJ_TAC THENL [SET_TAC [], STRIP_TAC] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"open_in top (u:A->bool)") THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN v}")) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let QUOTIENT_MAP_SATURATED_CLOSED ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f <=>
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        !u. closed_in top u /\
            {x | x IN topspace top /\ f x IN IMAGE f u} SUBSET u
            ==> closed_in top' (IMAGE f u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [QUOTIENT_MAP, CONTINUOUS_MAP_CLOSED_IN] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, FORALL_AND_THM, ← TAUT (← q
     r"(p ==> (q <=> r)) <=> (p /\ q ==> r) /\ (r ==> p ==> q)")] THEN
    SIMP_TAC [CLOSED_IN_SUBSET] THEN MATCH_MP_TAC (← TAUT (← q
     r"(i ==> j) /\ (i /\ c ==> (p <=> q))
    ==> (i /\ p /\ c <=> j /\ c /\ i /\ q)")) THEN
    CONJ_TAC THENL [SET_TAC [], STRIP_TAC] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      UNDISCH_TAC (← q r"closed_in top (u:A->bool)") THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN v}")) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let QUOTIENT_MAP_ONTO_IMAGE ← prove
   r"!top top' (f:A->B).
        IMAGE f (topspace top) SUBSET topspace top' /\
        (!u. u SUBSET topspace top'
             ==> (open_in top {x | x IN topspace top /\ f x IN u} <=>
                  open_in top' u))
        ==> quotient_map(top,subtopology top' (IMAGE f (topspace top))) f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [quotient_map, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [← sr r"s = t INTER s <=> s SUBSET t"] THEN
    REWRITE_TAC [SUBSET_INTER, FORALL_AND_THM, ← TAUT (← q
     r"(p ==> (q <=> r)) <=> (p /\ q ==> r) /\ (r ==> p ==> q)")] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [OPEN_IN_SUBTOPOLOGY_ALT] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, SUBSET_INTER] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"u:B->bool") THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:B->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET_TOPSPACE, OPEN_IN_SUBSET] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let QUOTIENT_MAP_LIFT_EXISTS ← prove
   r"!top top' top'' (f:A->B) (h:A->C).
        quotient_map (top,top') f /\
        continuous_map (top,top'') h /\
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y
               ==> h x = h y)
        ==> ?g. continuous_map (top',top'') g /\
                IMAGE g (topspace top') = IMAGE h (topspace top) /\
                !x. x IN topspace top ==> g(f x) = h x"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [FUNCTION_FACTORS_LEFT_GEN]) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:B->C") THEN
    DISCH_THEN (ASSUME_TAC o GSYM) THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← ONCE_REWRITE_RULE [IMP_CONJ] CONTINUOUS_COMPOSE_QUOTIENT_MAP)) THEN
      MATCH_MP_TAC CONTINUOUS_MAP_EQ THEN
      EXISTS_TAC (← q r"h:A->C") THEN ASM_SIMP_TAC [o_THM],
      RULE_ASSUM_TAC (REWRITE_RULE [quotient_map, continuous_map]) THEN
      ASM SET_TAC []])

  let DISCRETE_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map (top,top') q /\ discrete_space top
        ==> discrete_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ_ALT, quotient_map] THEN
    GEN_REWRITE_TAC LAND_CONV [discrete_space] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, SUBSET_RESTRICT,
                 TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [DISCRETE_SPACE_UNIQUE] THEN
    ASM_SIMP_TAC [SING_SUBSET])

  /- The quotient topology of top along f (the finest topology on IMAGE f      -/
  /- (topspace top) making f continuous): v is open iff its preimage is        -/
  /- (OPEN_IN_QUOTIENT_TOPOLOGY, CLOSED_IN_QUOTIENT_TOPOLOGY), f is a quotient -/
  /- map onto top' exactly when top' is the quotient topology                  -/
  /- (QUOTIENT_MAP_QUOTIENT_TOPOLOGY_EQ), a map out of it is continuous iff    -/
  /- its composite with f is (CONTINUOUS_MAP_FROM_QUOTIENT_TOPOLOGY), and for  -/
  /- f injective on topspace top its open sets are the images of the open sets -/
  /- of top (OPEN_IN_QUOTIENT_TOPOLOGY_INJ) and f is a homeomorphism onto it   -/
  /- (HOMEOMORPHIC_MAP_QUOTIENT_TOPOLOGY, with the homeomorphisms below).      -/

  let quotient_topology ← new_definition
   r"quotient_topology (top:A topology,f:A->B) =
        topology {v | v SUBSET IMAGE f (topspace top) /\
                      open_in top {x | x IN topspace top /\ f x IN v}}"

  let OPEN_IN_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B v.
        open_in (quotient_topology (top,f)) v <=>
        v SUBSET IMAGE f (topspace top) /\
        open_in top {x | x IN topspace top /\ f x IN v}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [quotient_topology] THEN
    SUBGOAL_THEN
     (← q r"open_in (topology {v | v SUBSET IMAGE f (topspace top) /\
                             open_in top {x | x IN topspace top /\ f x IN v}}) =
      {v | v SUBSET IMAGE (f:A->B) (topspace top) /\
           open_in top {x | x IN topspace top /\ f x IN v}}")
     (fun th => REWRITE_TAC [th, IN_ELIM_THM]) THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 topology_tybij)] THEN
    REWRITE_TAC [istopology, IN_ELIM_THM, EMPTY_SUBSET, NOT_IN_EMPTY] THEN
    REWRITE_TAC [EMPTY_GSPEC, OPEN_IN_EMPTY] THEN CONJ_TAC THENL
     [MAP_EVERY X_GEN_TAC [← q r"s:B->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN s INTER t} =
        {x | x IN topspace top /\ f x IN s} INTER
        {x | x IN topspace top /\ f x IN t}")
      SUBST1_TAC THENL [SET_TAC [], ASM_SIMP_TAC [OPEN_IN_INTER]],
      X_GEN_TAC (← q r"k:(B->bool)->bool") THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      DISCH_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN UNIONS k} =
        UNIONS (IMAGE (\v. {x | x IN topspace top /\ f x IN v}) k)")
      SUBST1_TAC THENL [SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC []])

  let TOPSPACE_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B.
        topspace(quotient_topology (top,f)) = IMAGE f (topspace top)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
     [MESON_TAC [OPEN_IN_TOPSPACE, OPEN_IN_QUOTIENT_TOPOLOGY],
      MATCH_MP_TAC OPEN_IN_SUBSET THEN
      REWRITE_TAC [OPEN_IN_QUOTIENT_TOPOLOGY, SUBSET_REFL] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top /\ (f:A->B) x IN IMAGE f (topspace top)} =
        topspace top")
       (fun th => REWRITE_TAC [th, OPEN_IN_TOPSPACE]) THEN
      SET_TAC []])

  let CLOSED_IN_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B v.
        closed_in (quotient_topology (top,f)) v <=>
        v SUBSET IMAGE f (topspace top) /\
        closed_in top {x | x IN topspace top /\ f x IN v}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [closed_in, TOPSPACE_QUOTIENT_TOPOLOGY,
                OPEN_IN_QUOTIENT_TOPOLOGY, SUBSET_DIFF] THEN
    ASM_CASES_TAC (← q r"v SUBSET IMAGE (f:A->B) (topspace top)") THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p <=> r) ==> (p <=> q /\ r)")) THEN
    CONJ_TAC THENL [SET_TAC [], AP_TERM_TAC THEN ASM SET_TAC []])

  let QUOTIENT_MAP_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B. quotient_map (top,quotient_topology (top,f)) f"
   (REWRITE_TAC [quotient_map, TOPSPACE_QUOTIENT_TOPOLOGY,
                OPEN_IN_QUOTIENT_TOPOLOGY] THEN
    SIMP_TAC [])

  let QUOTIENT_MAP_QUOTIENT_TOPOLOGY_EQ ← prove
   r"!top top' f:A->B.
        quotient_map (top,top') f <=> quotient_topology (top,f) = top'"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [quotient_map, TOPOLOGY_EQ, OPEN_IN_QUOTIENT_TOPOLOGY] THEN
      STRIP_TAC THEN X_GEN_TAC (← q r"v:B->bool") THEN
      ASM_CASES_TAC (← q r"v SUBSET topspace(top':B topology)") THEN
      ASM_SIMP_TAC [] THEN ASM_MESON_TAC [OPEN_IN_SUBSET],
      DISCH_THEN (SUBST1_TAC o SYM) THEN
      REWRITE_TAC [QUOTIENT_MAP_QUOTIENT_TOPOLOGY]])

  let CONTINUOUS_MAP_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B. continuous_map (top,quotient_topology (top,f)) f"
   (MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_MAP_QUOTIENT_TOPOLOGY])

  let CONTINUOUS_MAP_FROM_QUOTIENT_TOPOLOGY ← prove
   r"!top top' (f:A->B) (g:B->C).
        continuous_map (quotient_topology (top,f),top') g <=>
        continuous_map (top,top') (g o f)"
   (MESON_TAC [CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ,
              QUOTIENT_MAP_QUOTIENT_TOPOLOGY])

  let OPEN_IN_QUOTIENT_TOPOLOGY_INJ ← prove
   r"!top f:A->B.
        (!x y. x IN topspace top /\ y IN topspace top ==> (f x = f y <=> x = y))
        ==> !v. open_in (quotient_topology (top,f)) v <=>
                ?w. open_in top w /\ v = IMAGE f w"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [OPEN_IN_QUOTIENT_TOPOLOGY] THEN
    EQ_TAC THENL
     [STRIP_TAC THEN EXISTS_TAC (← q r"{x | x IN topspace top /\ (f:A->B) x IN v}") THEN
      ASM_REWRITE_TAC [] THEN ASM SET_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"w:A->bool")
       (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN CONJ_TAC THENL
       [ASM SET_TAC [],
        SUBGOAL_THEN (← q r"{x | x IN topspace top /\ (f:A->B) x IN IMAGE f w} = w")
         (fun th => ASM_REWRITE_TAC [th]) THEN
        ASM SET_TAC []]])

  return { quotient_map, QUOTIENT_MAP_EQ, QUOTIENT_MAP_COMPOSE, QUOTIENT_MAP_FROM_COMPOSITION,
           QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_MAP,
           CONTINUOUS_OPEN_IMP_QUOTIENT_MAP, CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP,
           CONTINUOUS_OPEN_QUOTIENT_MAP, CONTINUOUS_CLOSED_QUOTIENT_MAP, INJECTIVE_QUOTIENT_MAP,
           CONTINUOUS_COMPOSE_QUOTIENT_MAP, CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ,
           QUOTIENT_MAP_COMPOSE_EQ, QUOTIENT_MAP_RESTRICTION, QUOTIENT_MAP_SATURATED_OPEN,
           QUOTIENT_MAP_SATURATED_CLOSED, QUOTIENT_MAP_ONTO_IMAGE, QUOTIENT_MAP_LIFT_EXISTS,
           DISCRETE_SPACE_QUOTIENT_MAP_IMAGE, quotient_topology, OPEN_IN_QUOTIENT_TOPOLOGY, TOPSPACE_QUOTIENT_TOPOLOGY, CLOSED_IN_QUOTIENT_TOPOLOGY, QUOTIENT_MAP_QUOTIENT_TOPOLOGY, QUOTIENT_MAP_QUOTIENT_TOPOLOGY_EQ, CONTINUOUS_MAP_QUOTIENT_TOPOLOGY, CONTINUOUS_MAP_FROM_QUOTIENT_TOPOLOGY, OPEN_IN_QUOTIENT_TOPOLOGY_INJ }

/- ------------------------------------------------------------------------- -/
/- A binary product topology, part 1.  (metric.ml 3837-4077)                 -/
/- ------------------------------------------------------------------------- -/

structure Prod1 where
  prod_topology : thm
  OPEN_IN_PROD_TOPOLOGY : thm
  TOPSPACE_PROD_TOPOLOGY : thm
  SUBTOPOLOGY_CROSS : thm
  PROD_TOPOLOGY_SUBTOPOLOGY : thm
  PROD_TOPOLOGY_DISCRETE_TOPOLOGY : thm
  OPEN_IN_PROD_TOPOLOGY_ALT : thm
  OPEN_IN_CROSS : thm
  CLOSURE_OF_CROSS : thm
  CLOSED_IN_CROSS : thm
  INTERIOR_OF_CROSS : thm
  DISCRETE_SPACE_PROD_TOPOLOGY : thm
  CONTINUOUS_MAP_PAIRWISE : thm
  CONTINUOUS_MAP_PAIRED : thm
  CONTINUOUS_MAP_FST : thm
  CONTINUOUS_MAP_SND : thm
  CONTINUOUS_MAP_FST_OF : thm
  CONTINUOUS_MAP_SND_OF : thm
  deriving Inhabited

@[nospecialize]
def setupProd1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BBases : Bases) (BClosure : Closure) (BInterior : Interior)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) : ExceptT String IO Prod1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, ARBITRARY, ARBITRARY_UNION_OF_ALT, ARBITRARY_UNION_OF_INC, CONJ_ASSOC,
        CROSS_EMPTY, CROSS_EQ, CROSS_EQ_EMPTY, CROSS_SING, ETA_AX, EXISTS_IN_GSPEC, EXTENSION,
        FORALL_IN_GSPEC, FORALL_PASTECART, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN, INTER_CROSS, IN_CROSS, IN_ELIM_THM, IN_INTER, IN_SING,
        LEFT_IMP_EXISTS_THM, NOT_INSERT_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_CROSS, UNIONS_SUBSET, UNION_OF,
        o_DEF, o_THM, .. } := D.core4
  let { DE_MORGAN_THM, EQ_IMP, FORALL_PAIR_THM, PAIR_EQ, .. } := D.core5
  let { ARBITRARY_UNION_OF_RELATIVE_TO, relative_to, .. } := D.misc
  let { OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        TOPOLOGY_EQ, topology_tybij, topspace, .. } := BTopology
  let { DISCRETE_SPACE_UNIQUE, DISCRETE_TOPOLOGY_UNIQUE, OPEN_IN_DISCRETE_TOPOLOGY,
        TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_RELATIVE_TO, SUBTOPOLOGY_TOPSPACE, .. } := BSubtopology
  let { ISTOPOLOGY_BASE, .. } := BBases
  let { CLOSURE_OF_EMPTY, CLOSURE_OF_EQ, closure_of, .. } := BClosure
  let { INTERIOR_OF_SUBSET, INTERIOR_OF_UNIQUE, OPEN_IN_INTERIOR_OF, interior_of,
        .. } := BInterior
  let { CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, .. } := BContMap2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let prod_topology ← new_definition
   r"prod_topology (top1:A topology) (top2:B topology) =
    topology (ARBITRARY UNION_OF
               {s CROSS t | open_in top1 s /\ open_in top2 t})"

  let OPEN_IN_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
     open_in (prod_topology top1 top2) =
     (ARBITRARY UNION_OF {s CROSS t | open_in top1 s /\ open_in top2 t})"
   (REWRITE_TAC [prod_topology, ← GSYM (← CONJUNCT2 topology_tybij)] THEN
    REPEAT GEN_TAC THEN MATCH_MP_TAC ISTOPOLOGY_BASE THEN
    ONCE_REWRITE_TAC [← sr r"GSPEC p x <=> x IN GSPEC p"] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    MAP_EVERY (fun t => X_GEN_TAC t THEN DISCH_TAC)
     [← q r"s1:A->bool", ← q r"t1:B->bool", ← q r"s2:A->bool", ← q r"t2:B->bool"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q r"s1 INTER s2:A->bool", ← q r"t1 INTER t2:B->bool"] THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, INTER_CROSS])

  let TOPSPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        topspace(prod_topology top1 top2) =
        topspace top1 CROSS topspace top2"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [topspace] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
     [REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC, OPEN_IN_PROD_TOPOLOGY] THEN
      X_GEN_TAC (← q r"s:A#B->bool") THEN REWRITE_TAC [UNION_OF, ARBITRARY] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN GEN_TAC THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC (SUBST1_TAC o SYM)) THEN
      REWRITE_TAC [UNIONS_SUBSET] THEN MATCH_MP_TAC (← sr
       r"(!x. x IN P ==> Q x) ==> (!x. R x ==> P x) ==> (!x. R x ==> Q x)") THEN
      REWRITE_TAC [ETA_AX, FORALL_IN_GSPEC, SUBSET_CROSS] THEN
      MESON_TAC [OPEN_IN_SUBSET],
      MATCH_MP_TAC (← sr r"x IN s ==> x SUBSET UNIONS s") THEN
      REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY, IN_ELIM_THM] THEN
      MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
      REWRITE_TAC [IN_ELIM_THM] THEN MAP_EVERY EXISTS_TAC
       [← q r"topspace top1:A->bool", ← q r"topspace top2:B->bool"] THEN
      REWRITE_TAC [OPEN_IN_TOPSPACE]])

  let SUBTOPOLOGY_CROSS ← prove
   r"!top1:A topology top2:B topology s t.
        subtopology (prod_topology top1 top2) (s CROSS t) =
        prod_topology (subtopology top1 s) (subtopology top2 t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TOPOLOGY_EQ] THEN
    REWRITE_TAC [← GSYM OPEN_IN_RELATIVE_TO, OPEN_IN_PROD_TOPOLOGY] THEN
    REWRITE_TAC [ARBITRARY_UNION_OF_RELATIVE_TO] THEN
    X_GEN_TAC (← q r"t:A#B->bool") THEN AP_THM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"s:A#B->bool") THEN
    REWRITE_TAC [relative_to] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, INTER_CROSS] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN MESON_TAC [])

  let PROD_TOPOLOGY_SUBTOPOLOGY ← prove
   r"(!(top:A topology) (top':B topology) s.
        prod_topology (subtopology top s) top' =
        subtopology (prod_topology top top') (s CROSS topspace top')) /\
   (!(top:A topology) (top':B topology) t.
        prod_topology top (subtopology top' t) =
        subtopology (prod_topology top top') (topspace top CROSS t))"
   (REWRITE_TAC [SUBTOPOLOGY_CROSS, SUBTOPOLOGY_TOPSPACE])

  let PROD_TOPOLOGY_DISCRETE_TOPOLOGY ← prove
   r"!s:A->bool t:B->bool.
        prod_topology (discrete_topology s) (discrete_topology t) =
        discrete_topology (s CROSS t)"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN REWRITE_TAC [IN_ELIM_THM] THEN
    MAP_EVERY EXISTS_TAC [← q r"{x:A}", ← q r"{y:B}"] THEN
    REWRITE_TAC [EXTENSION, FORALL_PAIR_THM, IN_SING, IN_CROSS, SUBSET] THEN
    REWRITE_TAC [PAIR_EQ] THEN ASM_MESON_TAC [])

  let OPEN_IN_PROD_TOPOLOGY_ALT ← prove
   r"!top1:A topology top2:B topology s.
        open_in (prod_topology top1 top2) s <=>
        !x y. (x,y) IN s
              ==> ?u v. open_in top1 u /\ open_in top2 v /\
                        x IN u /\ y IN v /\ u CROSS v SUBSET s"
   (REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY] THEN
    REWRITE_TAC [ARBITRARY_UNION_OF_ALT, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, ← GSYM CONJ_ASSOC])

  let OPEN_IN_CROSS ← prove
   r"!top1:A topology top2:B topology s t.
        open_in (prod_topology top1 top2) (s CROSS t) <=>
        s = {} \/ t = {} \/ open_in top1 s /\ open_in top2 t"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_REWRITE_TAC [CROSS_EMPTY, OPEN_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN
    ASM_REWRITE_TAC [CROSS_EMPTY, OPEN_IN_EMPTY] THEN
    REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY_ALT, FORALL_PASTECART, IN_CROSS] THEN
    GEN_REWRITE_TAC (RAND_CONV o BINOP_CONV) [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [SUBSET_CROSS] THEN EQ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2
     (MP_TAC o SPEC (← q r"x:A")) (MP_TAC o SPEC (← q r"y:B"))) THEN
    ASM SET_TAC [])

  let CLOSURE_OF_CROSS ← prove
   r"!top1:A topology top2:B topology s t.
        (prod_topology top1 top2) closure_of (s CROSS t) =
        (top1 closure_of s) CROSS (top2 closure_of t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closure_of, ← sr
     r"(?y. y IN s /\ y IN t) <=> ~(s INTER t = {})"] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, IN_ELIM_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN
    ASM_CASES_TAC (← q r"(x:A) IN topspace top1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(y:B) IN topspace top2") THEN ASM_REWRITE_TAC [] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(u CROSS topspace top2):A#B->bool")),
        X_GEN_TAC (← q r"v:B->bool") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(topspace top1 CROSS v):A#B->bool"))] THEN
      ASM_REWRITE_TAC [IN_CROSS, OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
      SIMP_TAC [INTER_CROSS, CROSS_EQ_EMPTY, DE_MORGAN_THM],
      REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY_ALT] THEN X_GEN_TAC (← q r"w:A#B->bool") THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"])) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      MATCH_MP_TAC (← sr
       r"~(u INTER s = {}) ==> s SUBSET t ==> ~(u INTER t = {})") THEN
      REWRITE_TAC [INTER_CROSS, CROSS_EQ_EMPTY] THEN ASM_MESON_TAC []])

  let CLOSED_IN_CROSS ← prove
   r"!top1:A topology top2:B topology s t.
        closed_in (prod_topology top1 top2) (s CROSS t) <=>
        s = {} \/ t = {} \/ closed_in top1 s /\ closed_in top2 t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_EQ, CLOSURE_OF_CROSS, CROSS_EQ] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [CLOSURE_OF_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN ASM_REWRITE_TAC [CLOSURE_OF_EMPTY])

  let INTERIOR_OF_CROSS ← prove
   r"!top1:A topology top2:B topology s t.
        (prod_topology top1 top2) interior_of (s CROSS t) =
        (top1 interior_of s) CROSS (top2 interior_of t)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC INTERIOR_OF_UNIQUE THEN
    REWRITE_TAC [SUBSET_CROSS, INTERIOR_OF_SUBSET] THEN
    REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_INTERIOR_OF] THEN
    X_GEN_TAC (← q r"w:A#B->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"((u CROSS v):A#B->bool) SUBSET s CROSS t") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [SUBSET_CROSS]] THEN
    ASM_CASES_TAC (← q r"u:A->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_CASES_TAC (← q r"v:B->bool = {}") THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_REWRITE_TAC [interior_of, IN_ELIM_THM] THEN ASM_MESON_TAC [])

  let DISCRETE_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top2:B topology).
        discrete_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        discrete_space top1 /\ discrete_space top2"
   (REWRITE_TAC [DISCRETE_SPACE_UNIQUE, FORALL_PAIR_THM, ← GSYM CROSS_SING] THEN
    REWRITE_TAC [OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    REWRITE_TAC [NOT_INSERT_EMPTY, CROSS_EQ_EMPTY] THEN SET_TAC [])

  let CONTINUOUS_MAP_PAIRWISE ← prove
   r"!top top1 top2 f:A->B#C.
        continuous_map (top,prod_topology top1 top2) f <=>
        continuous_map (top,top1) (FST o f) /\
        continuous_map (top,top2) (SND o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [continuous_map, TOPSPACE_PROD_TOPOLOGY] THEN
    MAP_EVERY ABBREV_TAC [← q r"g = FST o (f:A->B#C)", ← q r"h = SND o (f:A->B#C)"] THEN
    SUBGOAL_THEN (← q r"!x. (f:A->B#C) x = g x,h x") (fun th => REWRITE_TAC [th]) THENL
     [MAP_EVERY EXPAND_TAC ["g", "h"] THEN REWRITE_TAC [o_THM], ALL_TAC] THEN
    REWRITE_TAC [IN_CROSS] THEN
    ASM_CASES_TAC (← q r"!x. x IN topspace top ==> (g:A->B) x IN topspace top1") THEN
    ASM_SIMP_TAC [] THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    ASM_CASES_TAC (← q r"!x. x IN topspace top ==> (h:A->C) x IN topspace top2") THEN
    ASM_SIMP_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [CONJ_TAC THENL
       [X_GEN_TAC (← q r"u:B->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"(u:B->bool) CROSS (topspace top2:C->bool)")),
        X_GEN_TAC (← q r"v:C->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"(topspace top1:B->bool) CROSS (v:C->bool)"))] THEN
      ASM_REWRITE_TAC [IN_CROSS, OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"w:B#C->bool") THEN STRIP_TAC THEN
      GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"(g:A->B) x", ← q r"(h:A->C) x"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"v:C->bool"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (CONJUNCTS_THEN2
       (MP_TAC o SPEC (← q r"u:B->bool")) (MP_TAC o SPEC (← q r"v:C->bool"))) THEN
      ASM_REWRITE_TAC [IMP_IMP] THEN MATCH_MP_TAC (← MESON [OPEN_IN_INTER] (← q
       r"P(s INTER t)
        ==> open_in top s /\ open_in top t ==> ?u. open_in top u /\ P u")) THEN
      ASM_REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
      ASM SET_TAC []])

  let CONTINUOUS_MAP_PAIRED ← prove
   r"!top top1 top2 (f:A->B) (g:A->C).
        continuous_map (top,prod_topology top1 top2) (\x. f x,g x) <=>
        continuous_map(top,top1) f /\ continuous_map(top,top2) g"
   (REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX])

  let (CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND) ← CONJ_PAIR (← prove
   r"(!top1:A topology top2:B topology.
        continuous_map (prod_topology top1 top2,top1) FST) /\
   (!top1:A topology top2:B topology.
        continuous_map (prod_topology top1 top2,top2) SND)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"prod_topology top1 top2 :(A#B)topology",
                     ← q r"top1:A topology", ← q r"top2:B topology", ← q r"\x:A#B. x"]
          CONTINUOUS_MAP_PAIRWISE) THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, o_DEF, ETA_AX]))

  let CONTINUOUS_MAP_FST_OF ← prove
   r"!top top1 top2 f:A->B#C.
         continuous_map (top,prod_topology top1 top2) f
         ==> continuous_map (top,top1) (\x. FST(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FST])

  let CONTINUOUS_MAP_SND_OF ← prove
   r"!top top1 top2 f:A->B#C.
         continuous_map (top,prod_topology top1 top2) f
         ==> continuous_map (top,top2) (\x. SND(f x))"
   (REPEAT STRIP_TAC THEN GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
    ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_SND])

  return { prod_topology, OPEN_IN_PROD_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY, SUBTOPOLOGY_CROSS,
           PROD_TOPOLOGY_SUBTOPOLOGY, PROD_TOPOLOGY_DISCRETE_TOPOLOGY, OPEN_IN_PROD_TOPOLOGY_ALT,
           OPEN_IN_CROSS, CLOSURE_OF_CROSS, CLOSED_IN_CROSS, INTERIOR_OF_CROSS,
           DISCRETE_SPACE_PROD_TOPOLOGY, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_PAIRED,
           CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, CONTINUOUS_MAP_FST_OF,
           CONTINUOUS_MAP_SND_OF }

/- ------------------------------------------------------------------------- -/
/- A binary product topology, part 2.  (metric.ml 4079-4285)                 -/
/- ------------------------------------------------------------------------- -/

structure Prod2 where
  OPEN_MAP_FST : thm
  OPEN_MAP_SND : thm
  QUOTIENT_MAP_FST : thm
  QUOTIENT_MAP_SND : thm
  CONTINUOUS_MAP_OF_FST : thm
  CONTINUOUS_MAP_OF_SND : thm
  CONTINUOUS_MAP_PROD : thm
  CONTINUOUS_MAP_PROD_TOPOLOGY_ID : thm
  OPEN_MAP_PROD : thm
  IN_PROD_TOPOLOGY_CLOSURE_OF : thm
  CLOSED_MAP_PROD : thm
  PROD_TOPOLOGY_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupProd2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient)
    (BProd1 : Prod1) : ExceptT String IO Prod2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, .. } := D
  let { CROSS_EMPTY, CROSS_EQ, CROSS_EQ_EMPTY, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES,
        IMAGE_EQ_EMPTY, IMAGE_FST_CROSS, .. } := D.core1
  let { IMAGE_PAIRED_CROSS, IMAGE_SND_CROSS, IMAGE_SUBSET, IMAGE_o, IMP_CONJ, IN_CROSS,
        IN_IMAGE, LEFT_IMP_EXISTS_THM, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_REFL, SUBSET_TRANS, o_DEF, .. } := D.core4
  let { DE_MORGAN_THM, EQ_IMP, EQ_SYM_EQ, EXISTS_PAIR_THM, FORALL_PAIR_THM, LAMBDA_PAIR, PAIR_EQ,
        .. } := D.core5
  let { CLOSED_IN_EMPTY, CLOSED_IN_TOPSPACE, OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_TOPSPACE,
        TOPOLOGY_EQ, .. } := BTopology
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, .. } := BDiscrete
  let { CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET, CONTINUOUS_MAP_ON_EMPTY, .. } := BContMap1
  let { OPEN_MAP_ON_EMPTY, closed_map, open_map, .. } := BOpenClosed1
  let { CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ, CONTINUOUS_OPEN_QUOTIENT_MAP, .. } := BQuotient
  let { CLOSED_IN_CROSS, CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND,
        OPEN_IN_CROSS, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  -- @@SCOPE END

  let (OPEN_MAP_FST, OPEN_MAP_SND) ← CONJ_PAIR (← prove
   r"(!top1:A topology top2:B topology.
      open_map (prod_topology top1 top2,top1) FST) /\
   (!top1:A topology top2:B topology.
      open_map (prod_topology top1 top2,top2) SND)"
   (REPEAT STRIP_TAC THEN  REWRITE_TAC [open_map, OPEN_IN_PROD_TOPOLOGY_ALT] THEN
    X_GEN_TAC (← q r"w:A#B->bool") THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THENL
     [EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
      TRANS_TAC SUBSET_TRANS (← q r"IMAGE FST ((u:A->bool) CROSS (v:B->bool))"),
      EXISTS_TAC (← q r"v:B->bool") THEN ASM_REWRITE_TAC [] THEN
      TRANS_TAC SUBSET_TRANS (← q r"IMAGE SND ((u:A->bool) CROSS (v:B->bool))")] THEN
    ASM_SIMP_TAC [IMAGE_SUBSET] THEN
    REWRITE_TAC [IMAGE_FST_CROSS, IMAGE_SND_CROSS] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM SET_TAC []))

  let QUOTIENT_MAP_FST ← prove
   r"!top:A topology top':B topology.
        quotient_map(prod_topology top top',top) FST <=>
        (topspace top' = {} ==> topspace top = {})"
   (SIMP_TAC [CONTINUOUS_OPEN_QUOTIENT_MAP, OPEN_MAP_FST, CONTINUOUS_MAP_FST] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IMAGE_FST_CROSS] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  let QUOTIENT_MAP_SND ← prove
   r"!top:A topology top':B topology.
        quotient_map(prod_topology top top',top') SND <=>
        (topspace top = {} ==> topspace top' = {})"
   (SIMP_TAC [CONTINUOUS_OPEN_QUOTIENT_MAP, OPEN_MAP_SND, CONTINUOUS_MAP_SND] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IMAGE_SND_CROSS] THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  let CONTINUOUS_MAP_OF_FST ← prove
   r"!top:C topology top1:A topology top2:B topology f.
        continuous_map (prod_topology top1 top2,top) (\x. f(FST x)) <=>
        topspace top2 = {} \/ continuous_map (top1,top) f"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top2:B->bool = {}") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ON_EMPTY,
                  TOPSPACE_PROD_TOPOLOGY, CROSS_EMPTY] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP_FST])

  let CONTINUOUS_MAP_OF_SND ← prove
   r"!top:C topology top1:A topology top2:B topology f.
        continuous_map (prod_topology top1 top2,top) (\x. f(SND x)) <=>
        topspace top1 = {} \/ continuous_map (top2,top) f"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top1:A->bool = {}") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ON_EMPTY,
                  TOPSPACE_PROD_TOPOLOGY, CROSS_EMPTY] THEN
    REWRITE_TAC [← GSYM o_DEF] THEN
    MATCH_MP_TAC CONTINUOUS_COMPOSE_QUOTIENT_MAP_EQ THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP_SND])

  let CONTINUOUS_MAP_PROD ← prove
   r"!top1 top2 top3 top4 (f:A->B) (g:C->D).
        continuous_map (prod_topology top1 top2,prod_topology top3 top4)
                       (\(x,y). f x,g y) <=>
        topspace(prod_topology top1 top2) = {} \/
        continuous_map (top1,top3) f /\ continuous_map (top2,top4) g"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#C->bool = {}") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ON_EMPTY] THEN
    REWRITE_TAC [LAMBDA_PAIR] THEN
    REWRITE_TAC [CONTINUOUS_MAP_PAIRED] THEN
    REWRITE_TAC [CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY]) THEN
    ASM_MESON_TAC [])

  let CONTINUOUS_MAP_PROD_TOPOLOGY_ID ← prove
   r"!(top1:A topology) (top2:B topology) top3 top4.
        continuous_map (top1,top3) (\x. x) /\
        continuous_map (top2,top4) (\x. x)
        ==> continuous_map (prod_topology top1 top2,prod_topology top3 top4)
                           (\x. x)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top1:A topology", ← q r"top2:B topology", ← q r"top3:A topology",
                   ← q r"top4:B topology", ← q r"\x:A. x", ← q r"\x:B. x"]
      CONTINUOUS_MAP_PROD) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
    REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM])

  let OPEN_MAP_PROD ← prove
   r"!top1 top1' top2 top2' (f:A->C) (g:B->D).
        open_map (prod_topology top1 top2,prod_topology top1' top2')
                 (\(x,y). f x,g y) <=>
        topspace(prod_topology top1 top2) = {} \/
        open_map (top1,top1') f /\ open_map (top2,top2') g"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THEN
    ASM_SIMP_TAC [OPEN_MAP_ON_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    EQ_TAC THEN REPEAT STRIP_TAC THEN REWRITE_TAC [open_map] THENL
     [X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE f u =
        IMAGE FST (IMAGE (\(x,y). (f:A->C) x,(g:B->D) y)
                         (u CROSS topspace top2))")
      SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LAMBDA_PAIR] THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [IMAGE_FST_CROSS, IMAGE_o],
        MATCH_MP_TAC (← REWRITE_RULE [open_map] OPEN_MAP_FST) THEN
        EXISTS_TAC (← q r"top2':D topology") THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [open_map]) THEN
        ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE]],
      X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE g v =
        IMAGE SND (IMAGE (\(x,y). (f:A->C) x,(g:B->D) y)
                         (topspace top1 CROSS v))")
      SUBST1_TAC THENL
       [REWRITE_TAC [← GSYM IMAGE_o, o_DEF, LAMBDA_PAIR] THEN
        ONCE_REWRITE_TAC [← GSYM o_DEF] THEN
        ASM_REWRITE_TAC [IMAGE_SND_CROSS, IMAGE_o],
        MATCH_MP_TAC (← REWRITE_RULE [open_map] OPEN_MAP_SND) THEN
        EXISTS_TAC (← q r"top1':C topology") THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [open_map]) THEN
        ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE]],
    X_GEN_TAC (← q r"w:A#B->bool") THEN DISCH_TAC THEN
    ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:B"] o
      GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A->C) u CROSS IMAGE (g:B->D) v") THEN
    REWRITE_TAC [OPEN_IN_CROSS, IN_CROSS] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [open_map], ALL_TAC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [IN_IMAGE, PAIR_EQ, EXISTS_PAIR_THM] THEN SET_TAC []])

  let IN_PROD_TOPOLOGY_CLOSURE_OF ← prove
   r"!top1 top2 s z:A#B.
        z IN (prod_topology top1 top2) closure_of s
        ==> FST z IN top1 closure_of (IMAGE FST s) /\
            SND z IN top2 closure_of (IMAGE SND s)"
   (REPEAT STRIP_TAC THENL
     [MATCH_MP_TAC (← REWRITE_RULE
      [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET]
      CONTINUOUS_MAP_FST),
     MATCH_MP_TAC (← REWRITE_RULE
      [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET]
      CONTINUOUS_MAP_SND)] THEN
    ASM_MESON_TAC [])

  let CLOSED_MAP_PROD ← prove
   r"!top1 top1' top2 top2' (f:A->C) (g:B->D).
        closed_map (prod_topology top1 top2,prod_topology top1' top2')
                   (\(x,y). f x,g y)
        ==> topspace(prod_topology top1 top2) = {} \/
            closed_map (top1,top1') f /\ closed_map (top2,top2') g"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY, DE_MORGAN_THM] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [closed_map] THENL
     [X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"c:A->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, CLOSED_IN_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(c CROSS topspace top2):A#B->bool") o
          GEN_REWRITE_RULE id [closed_map]) THEN
      REWRITE_TAC [IMAGE_PAIRED_CROSS, CLOSED_IN_CROSS] THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, CLOSED_IN_TOPSPACE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"c:B->bool") THEN DISCH_TAC THEN
      ASM_CASES_TAC (← q r"c:B->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, CLOSED_IN_EMPTY] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(topspace top1 CROSS c):A#B->bool") o
          GEN_REWRITE_RULE id [closed_map]) THEN
      REWRITE_TAC [IMAGE_PAIRED_CROSS, CLOSED_IN_CROSS] THEN
      ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, CLOSED_IN_TOPSPACE] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC []])

  let PROD_TOPOLOGY_EQ ← prove
   r"!(top1:A topology) (top2:B topology) top1' top2'.
        prod_topology top1 top2 = prod_topology top1' top2' <=>
        topspace(prod_topology top1 top2) = {} /\
        topspace(prod_topology top1' top2') = {} \/
        top1 = top1' /\ top2 = top2'"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC
     (← q r"topspace(prod_topology top1' top2' :(A#B)topology) =
      topspace(prod_topology top1 top2)")
    THENL [ASM_REWRITE_TAC [], ASM_MESON_TAC []] THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2 :(A#B)topology) = {}") THENL
     [ASM_MESON_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY],
      ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL [ALL_TAC, ASM_MESON_TAC []] THEN
    REWRITE_TAC [TOPOLOGY_EQ] THEN DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← GEN (← q r"u:A->bool")
              (← SPEC (← q r"(u CROSS topspace top2):A#B->bool") th)) THEN
            MP_TAC (← GEN (← q r"v:B->bool")
              (← SPEC (← q r"(topspace top1 CROSS v):A#B->bool") th)))) THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ, CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE] THEN
    ASM_MESON_TAC [OPEN_IN_EMPTY, OPEN_IN_TOPSPACE])

  return { OPEN_MAP_FST, OPEN_MAP_SND, QUOTIENT_MAP_FST, QUOTIENT_MAP_SND,
           CONTINUOUS_MAP_OF_FST, CONTINUOUS_MAP_OF_SND, CONTINUOUS_MAP_PROD, CONTINUOUS_MAP_PROD_TOPOLOGY_ID, OPEN_MAP_PROD,
           IN_PROD_TOPOLOGY_CLOSURE_OF, CLOSED_MAP_PROD, PROD_TOPOLOGY_EQ }

/- ------------------------------------------------------------------------- -/
/- The usual (Tychonoff) product topology, part 1.  (metric.ml 4287-4490)    -/
/- ------------------------------------------------------------------------- -/

structure Product1 where
  product_topology : thm
  TOPSPACE_PRODUCT_TOPOLOGY : thm
  TOPSPACE_PRODUCT_TOPOLOGY_ALT : thm
  PRODUCT_TOPOLOGY_EMPTY_DISCRETE : thm
  OPEN_IN_PRODUCT_TOPOLOGY : thm
  SUBTOPOLOGY_CARTESIAN_PRODUCT : thm
  PRODUCT_TOPOLOGY_SUBBASE_ALT : thm
  PRODUCT_TOPOLOGY_BASE_ALT : thm
  OPEN_IN_PRODUCT_TOPOLOGY_ALT : thm
  OPEN_IN_PRODUCT_TOPOLOGY_ALT_EXPAND : thm
  deriving Inhabited

@[nospecialize]
def setupProduct1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BBases : Bases) : ExceptT String IO Product1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, ARBITRARY_UNION_OF_ALT, CARTESIAN_PRODUCT_EMPTY, CONJ_ASSOC, EMPTY_GSPEC,
        EXISTS_IN_GSPEC, EXTENSION, FINITE_DELETE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_INTERSECTION_OF_INC,
        FINITE_INTERSECTION_OF_INTERS, FINITE_SUBSET, FORALL_INTERSECTION_OF, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IN, INTERSECTION_OF, INTERS_0, INTERS_IMAGE, INTERS_INSERT,
        INTER_CARTESIAN_PRODUCT, INTER_UNIV, IN_DELETE, IN_ELIM_THM, IN_INTER,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, PSUBSET, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_ANTISYM_EQ, UNWIND_THM1, cartesian_product, o_DEF,
        o_THM, .. } := D.core4
  let { FORALL_AND_THM, LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, SWAP_EXISTS_THM,
        .. } := D.core5
  let { ARBITRARY_UNION_OF_RELATIVE_TO, FINITE_INTERSECTION_OF_RELATIVE_TO, FORALL_RELATIVE_TO,
        RELATIVE_TO, RELATIVE_TO_RELATIVE_TO, relative_to, .. } := D.misc
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, TOPOLOGY_EQ, topology_tybij,
        .. } := BTopology
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING, .. } := BDiscrete
  let { OPEN_IN_RELATIVE_TO, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { ISTOPOLOGY_SUBBASE, TOPSPACE_SUBBASE, .. } := BBases
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let product_topology ← new_definition
   r"product_topology t (tops:K->A topology) =
        topology
          (ARBITRARY UNION_OF
             ((FINITE INTERSECTION_OF
              { {x:K->A | x k IN u} | k,u | k IN t /\ open_in (tops k) u})
              relative_to {x | EXTENSIONAL t x /\
                               !k. k IN t ==> x k IN topspace(tops k)}))"

  let TOPSPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) t.
        topspace (product_topology t tops) =
        cartesian_product t (topspace o tops)"
   (REWRITE_TAC [product_topology, cartesian_product, o_THM, TOPSPACE_SUBBASE])

  let TOPSPACE_PRODUCT_TOPOLOGY_ALT ← prove
   r"!(tops:K->A topology) t.
        topspace (product_topology t tops) =
        {x | EXTENSIONAL t x /\ !k. k IN t ==> x k IN topspace(tops k)}"
   (REWRITE_TAC [product_topology, TOPSPACE_SUBBASE])

  let PRODUCT_TOPOLOGY_EMPTY_DISCRETE ← prove
   r"!tops:K->A topology.
        product_topology {} tops = discrete_topology {(\x. ARB)}"
   (REWRITE_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_SING] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, CARTESIAN_PRODUCT_EMPTY])

  let OPEN_IN_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) t.
        open_in (product_topology t tops) =
        ARBITRARY UNION_OF
          ((FINITE INTERSECTION_OF
           { {x:K->A | x k IN u} | k,u | k IN t /\ open_in (tops k) u})
           relative_to topspace (product_topology t tops))"
   (REWRITE_TAC [product_topology, TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 topology_tybij), ISTOPOLOGY_SUBBASE])

  let SUBTOPOLOGY_CARTESIAN_PRODUCT ← prove
   r"!tops:K->A topology s k.
        subtopology (product_topology k tops) (cartesian_product k s) =
        product_topology k (\i. subtopology (tops i) (s i))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TOPOLOGY_EQ] THEN
    REWRITE_TAC [← GSYM OPEN_IN_RELATIVE_TO, OPEN_IN_PRODUCT_TOPOLOGY] THEN
    X_GEN_TAC (← q r"u:(K->A)->bool") THEN
    REWRITE_TAC [ARBITRARY_UNION_OF_RELATIVE_TO] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [o_DEF, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [← GSYM INTER_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [RELATIVE_TO_RELATIVE_TO] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN
    ONCE_REWRITE_TAC [FINITE_INTERSECTION_OF_RELATIVE_TO] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [SUBSET] THEN
    REWRITE_TAC [RELATIVE_TO, FORALL_IN_GSPEC] THEN
    GEN_REWRITE_TAC (BINOP_CONV o BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    CONJ_TAC THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THENL
     [ALL_TAC, GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV) [← GSYM IN]] THEN
    REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC id [IN_ELIM_THM] THEN REWRITE_TAC [] THEN
    GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV) [← GSYM IN] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN EXISTS_TAC (← q r"i:K") THEN
    ASM_REWRITE_TAC [] THENL
     [GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV) [← GSYM IN], ALL_TAC] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC] THEN
    EXISTS_TAC (← q r"u:A->bool") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_THM, cartesian_product] THEN
    ASM SET_TAC [])

  let PRODUCT_TOPOLOGY_SUBBASE_ALT ← prove
   r"!tops:K->A topology.
        ((FINITE INTERSECTION_OF
          { {x | x k IN u} | k,u | k IN t /\ open_in (tops k) u})
         relative_to topspace (product_topology t tops)) =
        ((FINITE INTERSECTION_OF
         { {x | x k IN u} | k,u |
           k IN t /\ open_in (tops k) u /\ u PSUBSET topspace (tops k)})
         relative_to topspace (product_topology t tops))"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"s:(K->A)->bool") THEN
    ONCE_REWRITE_TAC [FINITE_INTERSECTION_OF_RELATIVE_TO] THEN
    REWRITE_TAC [INTERSECTION_OF, relative_to, IN_ELIM_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [SWAP_EXISTS_THM] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> r /\ p /\ q")] THEN
    REWRITE_TAC [UNWIND_THM1, ← GSYM CONJ_ASSOC] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"w:((K->A)->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"w DELETE topspace(product_topology t (tops:K->A topology))") THEN
    ASM_REWRITE_TAC [FINITE_DELETE, IN_DELETE] THEN
    REWRITE_TAC [← GSYM INTERS_INSERT] THEN
    REWRITE_TAC [← sr r"x INSERT (s DELETE x) = x INSERT s"] THEN
    ASM_REWRITE_TAC [INTERS_INSERT] THEN
    X_GEN_TAC (← q r"w:(K->A)->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"w:(K->A)->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (SUBST_ALL_TAC o SYM) THEN
    STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
    ASM_REWRITE_TAC [PSUBSET] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET], DISCH_THEN SUBST_ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY_ALT]) THEN
    ASM SET_TAC [])

  let PRODUCT_TOPOLOGY_BASE_ALT ← prove
   r"!(tops:K->A topology) k.
        FINITE INTERSECTION_OF {{x | x i IN u} | i IN k /\ open_in (tops i) u}
        relative_to topspace(product_topology k tops) =
        { cartesian_product k u | u |
          FINITE {i | i IN k /\ ~(u i = topspace(tops i))} /\
          !i. i IN k ==> open_in (tops i) (u i)}"
   (REPEAT GEN_TAC THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    GEN_REWRITE_TAC (BINDER_CONV o LAND_CONV) [IN] THEN
    REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
      REWRITE_TAC [IMP_CONJ, IN_ELIM_THM, ← GSYM CONJ_ASSOC] THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
       [DISCH_THEN (K ALL_TAC) THEN
        EXISTS_TAC (← q r"(\i. topspace(tops i)):K->A->bool") THEN
        REWRITE_TAC [EMPTY_GSPEC, INTERS_0, INTER_UNIV] THEN
        REWRITE_TAC [FINITE_EMPTY, OPEN_IN_TOPSPACE] THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF],
        MAP_EVERY X_GEN_TAC [← q r"v:(K->A)->bool", ← q r"ovs:((K->A)->bool)->bool"] THEN
        REWRITE_TAC [FORALL_IN_INSERT] THEN
        DISCH_THEN (fun th => DISCH_THEN (CONJUNCTS_THEN ASSUME_TAC) THEN
          CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC th) THEN
        ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"u:K->(A->bool)") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"i:K") (X_CHOOSE_THEN (← q r"v:A->bool")
          (STRIP_ASSUME_TAC o GSYM))) THEN
        EXISTS_TAC
         (← q r"\j. (u:K->(A->bool)) j INTER
              (if j = i then v else topspace(tops j))") THEN
        REWRITE_TAC [] THEN REPEAT CONJ_TAC THENL
         [MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
          (← q r"i INSERT {i | i IN k /\ ~((u:K->A->bool) i = topspace (tops i))}") THEN
          ASM_REWRITE_TAC [FINITE_INSERT] THEN SET_TAC [],
          REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
          ASM_SIMP_TAC [OPEN_IN_INTER, OPEN_IN_TOPSPACE],
          ASM_REWRITE_TAC [INTERS_INSERT, ← sr
           r"s INTER (t INTER u) = (s INTER u) INTER t"] THEN
          REWRITE_TAC [← GSYM INTER_CARTESIAN_PRODUCT] THEN EXPAND_TAC "v" THEN
          REWRITE_TAC [EXTENSION, cartesian_product, IN_ELIM_THM, IN_INTER] THEN
          X_GEN_TAC (← q r"f:K->A") THEN MATCH_MP_TAC (← TAUT (← q
           r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
          EQ_TAC THENL [DISCH_TAC, ASM_MESON_TAC []] THEN
          X_GEN_TAC (← q r"j:K") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
          ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET]]],
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:K->A->bool") THEN
      STRIP_TAC THEN REWRITE_TAC [relative_to] THEN
      EXISTS_TAC
       (← q r"INTERS (IMAGE (\i. {x | x i IN u i})
               {i | i IN k /\ ~(u i = topspace((tops:K->A topology) i))})") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC FINITE_INTERSECTION_OF_INTERS THEN
        ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        X_GEN_TAC (← q r"i:K") THEN REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY EXISTS_TAC [← q r"i:K", ← q r"(u:K->A->bool) i"] THEN
        ASM_MESON_TAC [],
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
        GEN_REWRITE_TAC id [EXTENSION] THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM, IN_INTER, INTERS_IMAGE] THEN
        ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET]]])

  let OPEN_IN_PRODUCT_TOPOLOGY_ALT ← prove
   r"!k (tops:K->A topology) s.
         open_in (product_topology k tops) s <=>
         !x. x IN s
             ==> ?u. FINITE {i | i IN k /\ ~(u i = topspace(tops i))} /\
                     (!i. i IN k ==> open_in (tops i) (u i)) /\
                     x IN cartesian_product k u /\
                     cartesian_product k u SUBSET s"
   (REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, ARBITRARY_UNION_OF_ALT] THEN
    REWRITE_TAC [PRODUCT_TOPOLOGY_BASE_ALT, EXISTS_IN_GSPEC, ← GSYM CONJ_ASSOC])

  let OPEN_IN_PRODUCT_TOPOLOGY_ALT_EXPAND ← prove
   r"!k (tops:K->A topology) s.
        open_in (product_topology k tops) s <=>
        s SUBSET topspace(product_topology k tops) /\
        !x. x IN s
            ==> ?u. FINITE {i | i IN k /\ ~(u i = topspace(tops i))} /\
                    (!i. i IN k ==> open_in (tops i) (u i) /\ x i IN u i) /\
                    cartesian_product k u SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN
    GEN_REWRITE_TAC (RAND_CONV o LAND_CONV) [SUBSET] THEN
    REWRITE_TAC [AND_FORALL_THM] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"x:K->A") THEN
    ASM_CASES_TAC (← q r"(x:K->A) IN s") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_THM] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    ASM_MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  return { product_topology, TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY_ALT,
           PRODUCT_TOPOLOGY_EMPTY_DISCRETE, OPEN_IN_PRODUCT_TOPOLOGY,
           SUBTOPOLOGY_CARTESIAN_PRODUCT, PRODUCT_TOPOLOGY_SUBBASE_ALT,
           PRODUCT_TOPOLOGY_BASE_ALT, OPEN_IN_PRODUCT_TOPOLOGY_ALT,
           OPEN_IN_PRODUCT_TOPOLOGY_ALT_EXPAND }

/- ------------------------------------------------------------------------- -/
/- The usual (Tychonoff) product topology, part 2.  (metric.ml 4492-4723)    -/
/- ------------------------------------------------------------------------- -/

structure Product2 where
  CONTINUOUS_MAP_COMPONENTWISE : thm
  CONTINUOUS_MAP_COMPONENTWISE_UNIV : thm
  CONTINUOUS_MAP_PRODUCT_PROJECTION : thm
  OPEN_MAP_PRODUCT_PROJECTION : thm
  OPEN_IN_CARTESIAN_PRODUCT_GEN : thm
  OPEN_IN_CARTESIAN_PRODUCT : thm
  PRODUCT_TOPOLOGY_EMPTY : thm
  OPEN_IN_PRODUCT_TOPOLOGY_EMPTY : thm
  TOPSPACE_PRODUCT_TOPOLOGY_EMPTY : thm
  deriving Inhabited

@[nospecialize]
def setupProduct2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BProduct1 : Product1) : ExceptT String IO Product2 := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ARBITRARY, ARBITRARY_UNION_OF_INC, ETA_AX, EXTENSION, EXTENSIONAL, EXTENSIONAL_EMPTY,
        EXTENSIONAL_UNIV, FINITE_EMPTY, FINITE_IMAGE, FINITE_INTERSECTION_OF_INC,
        FINITE_RESTRICT, FINITE_SUBSET, FORALL_INTERSECTION_OF, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_UNION_OF, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_UNIONS, IMP_CONJ, IMP_IMP, INTERSECTION_OF,
        INTERS_0, INTERS_GSPEC, INTER_INTERS, INTER_UNIV, IN_ELIM_THM, IN_IMAGE, IN_INSERT,
        IN_INTER, IN_UNIV, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SUBSET, SUBSET_CARTESIAN_PRODUCT, SUBSET_EMPTY,
        UNIONS_0, UNIONS_1, UNIONS_2, UNIONS_GSPEC, UNION_EMPTY, UNION_OF, UNWIND_THM2, o_DEF,
        .. } := D.core4
  let { EQ_IMP, EXISTS_OR_THM, RIGHT_OR_DISTRIB, .. } := D.core5
  let { ARBITRARY_UNION_OF_RELATIVE_TO, FORALL_RELATIVE_TO, RELATIVE_TO, relative_to,
        .. } := D.misc
  let { OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_INTERS, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, topspace, .. } := BTopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { open_map, .. } := BOpenClosed1
  let { OPEN_IN_PRODUCT_TOPOLOGY, OPEN_IN_PRODUCT_TOPOLOGY_ALT, PRODUCT_TOPOLOGY_BASE_ALT,
        TOPSPACE_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY_ALT, product_topology,
        .. } := BProduct1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONTINUOUS_MAP_COMPONENTWISE ← do
    let lemma ← prove
     r"{x | x IN s /\ f x IN UNIONS v} =
       UNIONS {{x | x IN s /\ f x IN u} | u IN v} /\
       {x | x IN s /\ f x IN INTERS v} =
       s INTER INTERS {{x | x IN s /\ f x IN u} | u IN v}"
     (REWRITE_TAC [UNIONS_GSPEC, INTERS_GSPEC] THEN SET_TAC [])
    prove
     r"!top:A topology (tops:K->B topology) t f.
       continuous_map (top,product_topology t tops) f <=>
       IMAGE f (topspace top) SUBSET EXTENSIONAL t /\
       !k. k IN t ==> continuous_map (top,tops k) (\x. f x k)"
     (REPEAT GEN_TAC THEN
      REWRITE_TAC [continuous_map, TOPSPACE_PRODUCT_TOPOLOGY_ALT, IN_ELIM_THM] THEN
      ASM_CASES_TAC
        (← q r"!x. x IN topspace top ==> EXTENSIONAL t ((f:A->K->B) x)")
      THENL [ASM_SIMP_TAC [], ASM SET_TAC []] THEN
      ASM_CASES_TAC
        (← q r"!k x. k IN t /\ x IN topspace top
               ==> (f:A->K->B) x k IN topspace(tops k)")
      THENL [ASM_SIMP_TAC [], ASM SET_TAC []] THEN
      MATCH_MP_TAC (← TAUT (← q r"q /\ (p <=> r) ==> (p <=> q /\ r)")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [RIGHT_IMP_FORALL_THM, IMP_IMP] THEN EQ_TAC THENL
       [DISCH_TAC THEN MAP_EVERY X_GEN_TAC [← q r"k:K", ← q r"u:B->bool"] THEN
        REPEAT DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC
         (← q r"{y:K->B | y k IN u} INTER topspace(product_topology t tops)")) THEN
        ANTS_TAC THENL
         [REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN
          REWRITE_TAC [← GSYM ARBITRARY_UNION_OF_RELATIVE_TO] THEN
          REWRITE_TAC [relative_to, TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
          EXISTS_TAC (← q r"{y:K->B | y k IN u}") THEN
          CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
          MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
          MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
          REWRITE_TAC [IN_ELIM_THM] THEN
          MAP_EVERY EXISTS_TAC [← q r"k:K", ← q r"u:B->bool"] THEN
          ASM_REWRITE_TAC [],
          MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
          REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN ASM SET_TAC []],
        DISCH_TAC THEN
        REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, FORALL_UNION_OF, ARBITRARY] THEN
        X_GEN_TAC (← q r"v:((K->B)->bool)->bool") THEN DISCH_TAC THEN
        REWRITE_TAC [lemma] THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
        REWRITE_TAC [FORALL_IN_GSPEC] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← sr r"(!x. P x ==> Q x)
                    ==> (!x. Q x ==> R x) ==> (!x. P x ==> R x)")) THEN
        REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
        X_GEN_TAC (← q r"w:((K->B)->bool)->bool") THEN STRIP_TAC THEN
        REWRITE_TAC [← sr
        r"{x | x IN s /\ f x IN t INTER u} =
         {x | x IN {x | x IN s /\ f x IN t} /\ f x IN u}"] THEN
        REWRITE_TAC [lemma] THEN
        SUBGOAL_THEN
         (← q r"{x | x IN topspace top /\
               (f:A->K->B) x IN topspace (product_topology t tops)} =
          topspace top")
        SUBST1_TAC THENL
         [REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN ASM SET_TAC [],
          ALL_TAC] THEN
        ASM_CASES_TAC (← q r"w:((K->B)->bool)->bool = {}") THEN
        ASM_REWRITE_TAC [NOT_IN_EMPTY, ← sr r"{f x | x | F} = {}",
                         INTERS_0, INTER_UNIV, OPEN_IN_TOPSPACE] THEN
        MATCH_MP_TAC OPEN_IN_INTER THEN REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        MATCH_MP_TAC OPEN_IN_INTERS THEN
        ASM_SIMP_TAC [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        ASM_REWRITE_TAC [IMAGE_EQ_EMPTY] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← sr r"(!x. P x ==> Q x)
                    ==> (!x. x IN Q ==> R x) ==> (!x. P x ==> R x)")) THEN
        REWRITE_TAC [ETA_AX, FORALL_IN_GSPEC] THEN ASM_REWRITE_TAC [IN_ELIM_THM]])

  let CONTINUOUS_MAP_COMPONENTWISE_UNIV ← prove
   r"!top tops (f:A->K->B).
         continuous_map (top,product_topology (:K) tops) f <=>
         !k. continuous_map (top,tops k) (\x. f x k)"
   (REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE, IN_UNIV] THEN
    REWRITE_TAC [← sr r"IMAGE f s SUBSET P <=> !x. x IN s ==> P(f x)"] THEN
    REWRITE_TAC [EXTENSIONAL_UNIV])

  let CONTINUOUS_MAP_PRODUCT_PROJECTION ← prove
   r"!(tops:K->A topology) t k.
        k IN t ==> continuous_map (product_topology t tops,tops k) (\x. x k)"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"product_topology t (tops:K->A topology)",
      ← q r"tops:K->A topology", ← q r"t:K->bool", ← q r"\x:K->A. x"]
          CONTINUOUS_MAP_COMPONENTWISE) THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ID])

  let OPEN_MAP_PRODUCT_PROJECTION ← do
    let lemma ← prove
     r"k IN t
       ==> {a | a IN v /\
            (\i. if i = k then a else if i IN t then x i else b) IN u}
       SUBSET IMAGE (\x:K->A. x k) u"
     (REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN
      EXISTS_TAC (← q r"(\i. if i = k then a else if i IN t then x i else b):K->A") THEN
      ASM_REWRITE_TAC [])
    prove
     r"!(tops:K->A topology) t k.
        k IN t ==> open_map (product_topology t tops,tops k) (\x. x k)"
     (REPEAT STRIP_TAC THEN REWRITE_TAC [open_map] THEN
      REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, FORALL_UNION_OF, ARBITRARY] THEN
      X_GEN_TAC (← q r"v:((K->A)->bool)->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [IMAGE_UNIONS] THEN MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← sr r"(!x. P x ==> Q x)
                  ==> (!x. Q x ==> R x) ==> (!x. P x ==> R x)")) THEN
      REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
      X_GEN_TAC (← q r"w:((K->A)->bool)->bool") THEN STRIP_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:K->A") THEN REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN
      STRIP_TAC THEN
      EXISTS_TAC (← q r"{a | a IN topspace(tops k) /\
                       (\i:K. if i = k then a:A
                              else if i IN t then x i else ARB) IN
                       topspace(product_topology t tops) INTER INTERS w}") THEN
      ASM_SIMP_TAC [lemma] THEN CONJ_TAC THENL
       [ALL_TAC,
        RULE_ASSUM_TAC (REWRITE_RULE
         [TOPSPACE_PRODUCT_TOPOLOGY_ALT, EXTENSIONAL, IN_ELIM_THM]) THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, EXTENSIONAL, IN_ELIM_THM] THEN
        ASM SET_TAC []] THEN
      MATCH_MP_TAC (← MESON [continuous_map] (← q
       r"!top'. continuous_map (top,top') f /\ open_in top' u
               ==> open_in top {x | x IN topspace top /\ f x IN u}")) THEN
      EXISTS_TAC (← q r"product_topology t (tops:K->A topology)") THEN
      REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN REPEAT CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, EXTENSIONAL, IN_ELIM_THM] THEN
        ASM SET_TAC [],
        X_GEN_TAC (← q r"j:K") THEN ASM_CASES_TAC (← q r"j:K = k") THEN
        ASM_REWRITE_TAC [ETA_AX, CONTINUOUS_MAP_ID] THEN
        RULE_ASSUM_TAC (REWRITE_RULE
         [TOPSPACE_PRODUCT_TOPOLOGY_ALT, IN_ELIM_THM]) THEN
        ASM_CASES_TAC (← q r"(j:K) IN t") THEN ASM_SIMP_TAC [CONTINUOUS_MAP_CONST],
        REWRITE_TAC [INTER_INTERS] THEN COND_CASES_TAC THEN
        REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY_ALT, OPEN_IN_TOPSPACE] THEN
        MATCH_MP_TAC OPEN_IN_INTERS THEN
        ASM_SIMP_TAC [FINITE_IMAGE, IMAGE_EQ_EMPTY, SIMPLE_IMAGE] THEN
        REWRITE_TAC [FORALL_IN_IMAGE] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← sr r"(!x. P x ==> Q x)
                    ==> (!x. x IN Q ==> R x) ==> (!x. P x ==> R x)")) THEN
        REWRITE_TAC [FORALL_IN_GSPEC, ETA_AX] THEN
        MAP_EVERY X_GEN_TAC [← q r"i:K", ← q r"v:A->bool"] THEN STRIP_TAC THEN
        REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN
        MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN REWRITE_TAC [relative_to] THEN
        EXISTS_TAC (← q r"{x:K->A | x i IN v}") THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [IN_ELIM_THM] THEN
        MAP_EVERY EXISTS_TAC [← q r"i:K", ← q r"v:A->bool"] THEN
        ASM_REWRITE_TAC []])

  let OPEN_IN_CARTESIAN_PRODUCT_GEN ← prove
   r"!(tops:K->A topology) s k.
        open_in (product_topology k tops) (cartesian_product k s) <=>
        cartesian_product k s = {} \/
        FINITE {i | i IN k /\ ~(s i = topspace(tops i))} /\
        (!i. i IN k ==> open_in (tops i) (s i))"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"cartesian_product k (s:K->A->bool) = {}") THEN
    ASM_REWRITE_TAC [OPEN_IN_EMPTY] THEN EQ_TAC THENL
     [ALL_TAC,
      STRIP_TAC THEN REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN
      MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
      REWRITE_TAC [PRODUCT_TOPOLOGY_BASE_ALT, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"s:K->A->bool") THEN ASM_REWRITE_TAC []] THEN
    DISCH_TAC THEN CONJ_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"tops:K->A topology", ← q r"k:K->bool", ← q r"i:K"]
          OPEN_MAP_PRODUCT_PROJECTION) THEN
      ASM_REWRITE_TAC [open_map] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"cartesian_product k (s:K->A->bool)")) THEN
      ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT]] THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A")) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"z:K->A")) THEN
    ASM_REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:K->A->bool") STRIP_ASSUME_TAC) THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_ASSUM (MATCH_MP_TAC o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] FINITE_SUBSET)) THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"i:K") THEN
    ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← sr
     r"t SUBSET s /\ s SUBSET u ==> ~(s = u) ==> ~(t = u)") THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    ASM_SIMP_TAC [TOPSPACE_PRODUCT_TOPOLOGY, SUBSET_CARTESIAN_PRODUCT, o_DEF])

  let OPEN_IN_CARTESIAN_PRODUCT ← prove
   r"!(tops:K->A topology) (s:K->A->bool) k.
        FINITE k
        ==> (open_in (product_topology k tops) (cartesian_product k s) <=>
             cartesian_product k s = {} \/
             (!i. i IN k ==> open_in (tops i) (s i)))"
   (SIMP_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN, FINITE_RESTRICT])

  let (PRODUCT_TOPOLOGY_EMPTY, OPEN_IN_PRODUCT_TOPOLOGY_EMPTY) ← CONJ_PAIR (← prove
   r"(!tops:K->A topology.
        product_topology {} tops = topology {{},{\k. ARB}}) /\
   (!tops:K->A topology s.
        open_in (product_topology {} tops) s <=> s IN {{},{\k. ARB}})"
   (REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
    REWRITE_TAC [product_topology, EXTENSIONAL_EMPTY, NOT_IN_EMPTY] THEN
    CONJ_TAC THENL
     [AP_TERM_TAC,
      ONCE_REWRITE_TAC [← sr r"(!x. P x <=> x IN s) <=> P = s"] THEN
      REWRITE_TAC [ETA_AX]] THEN
    REWRITE_TAC [← sr r"{f x y | x,y| F} = {}"] THEN
    REWRITE_TAC [← sr r"{x | s x} = s", ETA_AX] THEN
    ABBREV_TAC (← q r"g:K->A = \x. ARB") THEN
    REWRITE_TAC [INTERSECTION_OF] THEN
    REWRITE_TAC [← sr r"(!x. x IN s ==> t x) <=> s SUBSET t"] THEN
    REWRITE_TAC [← MESON [SUBSET_EMPTY, FINITE_EMPTY] (← q
     r"(?u. FINITE u /\ u SUBSET {} /\ P u) <=> P {}")] THEN
    REWRITE_TAC [← sr r"(\s. a = s) = {a}", INTERS_0] THEN
    REWRITE_TAC [UNION_OF] THEN
    REWRITE_TAC [← sr r"(!x. x IN s ==> t x) <=> s SUBSET t"] THEN
    REWRITE_TAC [ETA_AX, ARBITRARY] THEN
    REWRITE_TAC [RELATIVE_TO, ← sr r"{f x | s x} = IMAGE f s"] THEN
    REWRITE_TAC [IMAGE_CLAUSES, ETA_AX, INTER_UNIV] THEN
    REWRITE_TAC [← sr r"s SUBSET {a} <=> s = {} \/ s = {a}"] THEN
    REWRITE_TAC [EXISTS_OR_THM, UNWIND_THM2, RIGHT_OR_DISTRIB] THEN
    REWRITE_TAC [UNIONS_0, UNIONS_1] THEN GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [IN_ELIM_THM, IN_INSERT, NOT_IN_EMPTY] THEN MESON_TAC []))

  let TOPSPACE_PRODUCT_TOPOLOGY_EMPTY ← prove
   r"!tops:K->A topology.
        topspace(product_topology {} tops) = {\k. ARB}"
   (REWRITE_TAC [topspace, OPEN_IN_PRODUCT_TOPOLOGY_EMPTY] THEN
    REWRITE_TAC [← sr r"{x | x IN s} = s", UNIONS_2, UNION_EMPTY])

  return { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_COMPONENTWISE_UNIV,
           CONTINUOUS_MAP_PRODUCT_PROJECTION, OPEN_MAP_PRODUCT_PROJECTION,
           OPEN_IN_CARTESIAN_PRODUCT_GEN, OPEN_IN_CARTESIAN_PRODUCT, PRODUCT_TOPOLOGY_EMPTY,
           OPEN_IN_PRODUCT_TOPOLOGY_EMPTY, TOPSPACE_PRODUCT_TOPOLOGY_EMPTY }

/- ------------------------------------------------------------------------- -/
/- The usual (Tychonoff) product topology, part 3.  (metric.ml 4725-4992)    -/
/- ------------------------------------------------------------------------- -/

structure Product3 where
  CLOSURE_OF_CARTESIAN_PRODUCT : thm
  CLOSED_IN_CARTESIAN_PRODUCT : thm
  INTERIOR_IN_CARTESIAN_PRODUCT : thm
  QUOTIENT_MAP_PRODUCT_PROJECTION : thm
  CONTINUOUS_MAP_PRODUCT : thm
  OPEN_MAP_PRODUCT : thm
  CLOSED_MAP_PRODUCT : thm
  IN_PRODUCT_TOPOLOGY_CLOSURE_OF : thm
  deriving Inhabited

@[nospecialize]
def setupProduct3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BInterior : Interior) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) (BProduct1 : Product1)
    (BProduct2 : Product2) : ExceptT String IO Product3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ARBITRARY, ARBITRARY_UNION_OF_INC, CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY,
        COND_ID, COND_RAND, COND_RATOR, EMPTY_GSPEC, ETA_AX, EXTENSION, EXTENSIONAL,
        FINITE_EMPTY, FINITE_FINITE_PREIMAGE_GENERAL, FINITE_INSERT,
        FINITE_INTERSECTION_OF_INC, FINITE_SING, FINITE_SUBSET, FINITE_UNION,
        FORALL_INTERSECTION_OF, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT,
        FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMAGE_PRODUCT_MAP, IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SUBSET, IMP_CONJ,
        IMP_CONJ_ALT, IMP_IMP, INTERS_INSERT, INTER_CARTESIAN_PRODUCT, IN_ELIM_THM, IN_INTER,
        IN_INTERS, IN_SING, IN_UNION, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_FORALL_THM, NOT_INSERT_EMPTY, NOT_IN_EMPTY, PSUBSET, .. } := D.core2
  let { RESTRICTION, RESTRICTION_IN_EXTENSIONAL, RIGHT_IMP_FORALL_THM, SKOLEM_THM, SUBSET,
        SUBSET_CARTESIAN_PRODUCT, UNION_OF, cartesian_product, o_DEF, o_THM, product_map,
        .. } := D.core4
  let { CONTRAPOS_THM, EQ_SYM_EQ, NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { FORALL_RELATIVE_TO, RELATIVE_TO_INC, .. } := D.misc
  let { CLOSED_IN_EMPTY, CLOSED_IN_TOPSPACE, OPEN_IN_INTERS, OPEN_IN_SUBOPEN, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSURE_OF_EMPTY, CLOSURE_OF_EQ, closure_of, .. } := BClosure
  let { INTERIOR_OF_SUBSET, INTERIOR_OF_UNIQUE, OPEN_IN_INTERIOR_OF, interior_of,
        .. } := BInterior
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET, CONTINUOUS_MAP_ID,
        CONTINUOUS_MAP_ON_EMPTY, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, .. } := BContMap2
  let { OPEN_MAP_ON_EMPTY, closed_map, open_map, .. } := BOpenClosed1
  let { CONTINUOUS_OPEN_QUOTIENT_MAP, .. } := BQuotient
  let { OPEN_IN_PRODUCT_TOPOLOGY, OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY,
        .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION,
        OPEN_IN_CARTESIAN_PRODUCT, OPEN_IN_CARTESIAN_PRODUCT_GEN, OPEN_MAP_PRODUCT_PROJECTION,
        .. } := BProduct2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CLOSURE_OF_CARTESIAN_PRODUCT ← prove
   r"!k tops s:K->A->bool.
        (product_topology k tops) closure_of (cartesian_product k s) =
        cartesian_product k (\i. (tops i) closure_of (s i))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [closure_of, ← sr
     r"(?y. y IN s /\ y IN t) <=> ~(s INTER t = {})"] THEN
    GEN_REWRITE_TAC id [EXTENSION] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [← sr r"{x | x IN s /\ P x} = s INTER {x | P x}"] THEN
    REWRITE_TAC [← GSYM INTER_CARTESIAN_PRODUCT] THEN
    X_GEN_TAC (← q r"f:K->A") THEN REWRITE_TAC [IN_INTER, o_DEF, IN_ELIM_THM] THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
    REWRITE_TAC [← GSYM cartesian_product] THEN MATCH_MP_TAC (← TAUT (← q
     r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"topspace (product_topology k tops) INTER {x:K->A | x i IN u}")) THEN
      ASM_REWRITE_TAC [IN_INTER, TOPSPACE_PRODUCT_TOPOLOGY, IN_ELIM_THM] THEN
      ANTS_TAC THENL
       [CONJ_TAC THENL
         [ASM_REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_DEF],
          REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN
          MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
          REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
          MATCH_MP_TAC RELATIVE_TO_INC THEN
          MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN ASM SET_TAC []],
        REWRITE_TAC [EXTENSION, IN_INTER, NOT_IN_EMPTY, NOT_FORALL_THM] THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_DEF] THEN ASM SET_TAC []],
      DISCH_TAC THEN X_GEN_TAC (← q r"u:(K->A)->bool") THEN
      REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, UNION_OF, ARBITRARY] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← sr
       r"x IN s /\ (?u. (!c. c IN u ==> P c) /\ UNIONS u = s)
        ==> ?c. P c /\ c SUBSET s /\ x IN c")) THEN
      REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM, FORALL_RELATIVE_TO] THEN
      REWRITE_TAC [FORALL_INTERSECTION_OF] THEN
      X_GEN_TAC (← q r"t:((K->A)->bool)->bool") THEN STRIP_TAC THEN
      REWRITE_TAC [IN_INTER, TOPSPACE_PRODUCT_TOPOLOGY] THEN
      DISCH_TAC THEN STRIP_TAC THEN
      RULE_ASSUM_TAC (REWRITE_RULE [RIGHT_IMP_FORALL_THM, IMP_IMP]) THEN
      FIRST_ASSUM (MP_TAC o GEN (← q r"i:K") o SPECL
       [← q r"i:K",
        ← q r"topspace((tops:K->A topology) i) INTER
         INTERS {u | open_in (tops i) u /\ {x | x i IN u} IN t}"]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← MESON [] (← q
       r"(!i. P i /\ Q i /\ R i ==> S i)
        ==> (!i. P i ==> Q i /\ R i) ==> (!i. P i ==> S i)"))) THEN
      ANTS_TAC THENL
       [X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN REWRITE_TAC [IN_INTER] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [cartesian_product, IN_ELIM_THM, o_DEF]) THEN
        ASM_SIMP_TAC [IN_INTERS, IN_ELIM_THM] THEN CONJ_TAC THENL
         [X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERS]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"{x:K->A | x i IN v}")) THEN
          ASM_REWRITE_TAC [IN_ELIM_THM],
          REWRITE_TAC [← GSYM INTERS_INSERT] THEN MATCH_MP_TAC OPEN_IN_INTERS THEN
          REWRITE_TAC [NOT_INSERT_EMPTY, FORALL_IN_INSERT] THEN
          SIMP_TAC [IN_ELIM_THM, OPEN_IN_TOPSPACE, FINITE_INSERT] THEN
          ONCE_REWRITE_TAC [← sr
           r"{x | P x /\ Q x} = {x | x IN P /\ Q x}"] THEN
          MATCH_MP_TAC FINITE_FINITE_PREIMAGE_GENERAL THEN
          ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
           r"(!x. P x ==> Q x) ==> (!x. Q x ==> R x) ==> (!x. P x ==> R x)")) THEN
          SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT STRIP_TAC THEN
          MATCH_MP_TAC (← MESON [FINITE_SING, FINITE_SUBSET] (← q
           r"(?a. s SUBSET {a}) ==> FINITE s")) THEN
          MATCH_MP_TAC (← sr r"(!x y. f x = f y ==> x = y)
           ==> ?a. {x | P x /\ f x = c} SUBSET {a}") THEN
          REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
          MAP_EVERY X_GEN_TAC [← q r"z1:A->bool", ← q r"z2:A->bool"] THEN
          DISCH_THEN (fun th => tactic_of do
            pure (X_GEN_TAC (← q r"z:A") THEN
              MP_TAC (← SPEC (← q r"(\i. z):K->A") th))) THEN
          REWRITE_TAC []],
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN
        GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
        REWRITE_TAC [SKOLEM_THM, IN_INTER, IN_INTERS, IN_ELIM_THM] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"x:K->A") (LABEL_TAC "*")) THEN
        EXISTS_TAC (← q r"\i. if i IN k then (x:K->A) i else ARB") THEN CONJ_TAC THENL
         [ASM_SIMP_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL],
          FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET])] THEN
        REWRITE_TAC [IN_INTER, cartesian_product, IN_ELIM_THM, o_DEF] THEN
        ASM_SIMP_TAC [EXTENSIONAL, IN_ELIM_THM, IN_INTERS] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
         r"(!x. P x ==> Q x) ==> (!x. x IN Q ==> P x ==> R x)
          ==> (!x. P x ==> R x)")) THEN
        REWRITE_TAC [ETA_AX, FORALL_IN_GSPEC] THEN
        ASM_SIMP_TAC [IN_ELIM_THM]]])

  let CLOSED_IN_CARTESIAN_PRODUCT ← prove
   r"!(tops:K->A topology) (s:K->A->bool) k.
        closed_in (product_topology k tops) (cartesian_product k s) <=>
        cartesian_product k s = {} \/
        (!i. i IN k ==> closed_in (tops i) (s i))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_EQ, CLOSURE_OF_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ] THEN
    ASM_CASES_TAC (← q r"cartesian_product k (s:K->A->bool) = {}") THEN
    ASM_REWRITE_TAC [] THEN DISJ1_TAC THEN POP_ASSUM MP_TAC THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [CLOSURE_OF_EMPTY])

  let INTERIOR_IN_CARTESIAN_PRODUCT ← prove
   r"!k tops s:K->A->bool.
        FINITE k
        ==> ((product_topology k tops) interior_of (cartesian_product k s) =
             cartesian_product k (\i. (tops i) interior_of (s i)))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INTERIOR_OF_UNIQUE THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT, INTERIOR_OF_SUBSET] THEN
    ASM_SIMP_TAC [OPEN_IN_CARTESIAN_PRODUCT, OPEN_IN_INTERIOR_OF] THEN
    X_GEN_TAC (← q r"w:(K->A)->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [SUBSET, cartesian_product, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"f:K->A") THEN DISCH_TAC THEN CONJ_TAC THENL
     [FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_SIMP_TAC [cartesian_product, IN_ELIM_THM],
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
      REWRITE_TAC [interior_of, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"IMAGE (\x:K->A. x i) w") THEN REPEAT CONJ_TAC THENL
       [MP_TAC (← ISPECL [← q r"tops:K->A topology", ← q r"k:K->bool", ← q r"i:K"]
          OPEN_MAP_PRODUCT_PROJECTION) THEN
        ASM_SIMP_TAC [open_map],
        ASM SET_TAC [],
        FIRST_ASSUM (MP_TAC o ISPEC (← q r"\x:K->A. x i") o MATCH_MP IMAGE_SUBSET) THEN
        ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN SET_TAC []]])

  let QUOTIENT_MAP_PRODUCT_PROJECTION ← prove
   r"!(tops:K->A topology) k i.
      i IN k
      ==> (quotient_map(product_topology k tops,tops i) (\x. x i) <=>
           topspace(product_topology k tops) = {} ==> topspace(tops i) = {})"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_OPEN_QUOTIENT_MAP, OPEN_MAP_PRODUCT_PROJECTION,
                  CONTINUOUS_MAP_PRODUCT_PROJECTION] THEN
    ASM_REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                     TOPSPACE_PRODUCT_TOPOLOGY, o_THM] THEN
    COND_CASES_TAC THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [EQ_SYM_EQ])

  let CONTINUOUS_MAP_PRODUCT ← prove
   r"!k top top' (f:K->A->B).
        continuous_map (product_topology k top,product_topology k top')
                       (product_map k f) <=>
        topspace(product_topology k top) = {} \/
        !i. i IN k ==> continuous_map(top i,top' i) (f i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (top:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_ON_EMPTY] THEN
    REWRITE_TAC [product_map, CONTINUOUS_MAP_COMPONENTWISE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
    SIMP_TAC [RESTRICTION] THEN EQ_TAC THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"i:K")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"(f:K->A->B) i =
        (\x. f i (x i)) o (\x. RESTRICTION k (\j. if j = i then x else z j))")
      SUBST1_TAC THENL [ASM_SIMP_TAC [o_DEF, RESTRICTION, ETA_AX], ALL_TAC] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"product_topology k (top:K->A topology)") THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, RESTRICTION_IN_EXTENSIONAL] THEN
      X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"j:K = i") THEN
      ASM_SIMP_TAC [RESTRICTION, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST],
      GEN_REWRITE_TAC RAND_CONV [← GSYM o_DEF] THEN
      MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"(top:K->A topology) i") THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION]])

  let OPEN_MAP_PRODUCT ← prove
   r"!k top top' (f:K->A->B).
        open_map (product_topology k top,product_topology k top')
                 (product_map k f) <=>
        topspace(product_topology k top) = {} \/
        FINITE {i | i IN k /\
                    IMAGE (f i) (topspace(top i)) PSUBSET topspace(top' i)} /\
        !i. i IN k ==> open_map(top i,top' i) (f i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (top:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [OPEN_MAP_ON_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [TOPSPACE_PRODUCT_TOPOLOGY, o_THM, CARTESIAN_PRODUCT_EQ_EMPTY]) THEN
    EQ_TAC THEN STRIP_TAC THEN TRY CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC
        (← q r"cartesian_product k (\i. topspace((top:K->A topology) i))") o
        GEN_REWRITE_RULE id [open_map]) THEN
      REWRITE_TAC [IMAGE_PRODUCT_MAP, OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
      ASM_REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, IMAGE_EQ_EMPTY] THEN
      REWRITE_TAC [EMPTY_GSPEC, FINITE_EMPTY, OPEN_IN_TOPSPACE] THEN
      DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN SET_TAC [],
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN REWRITE_TAC [open_map] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"IMAGE ((f:K->A->B) i) u =
        IMAGE (\x. x i)
              (IMAGE (product_map k f)
                     (cartesian_product k
                       (\j. if j = i then u else topspace(top j))))")
      SUBST1_TAC THENL
       [REWRITE_TAC [IMAGE_PRODUCT_MAP, IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
        ASM_REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, IMAGE_EQ_EMPTY] THEN
        ASM_MESON_TAC [IMAGE_CLAUSES],
        FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE [open_map] o
          MATCH_MP OPEN_MAP_PRODUCT_PROJECTION) THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o REWRITE_RULE [open_map]) THEN
        REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
        ONCE_REWRITE_TAC [COND_RAND] THEN DISJ2_TAC THEN
        ASM_SIMP_TAC [OPEN_IN_TOPSPACE, COND_ID] THEN
        ONCE_REWRITE_TAC [COND_RATOR] THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{i:K}") THEN REWRITE_TAC [FINITE_SING, SUBSET] THEN
        GEN_TAC THEN GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
        SIMP_TAC [IN_SING, IN_ELIM_THM]],
      REWRITE_TAC [open_map] THEN
      X_GEN_TAC (← q r"w:(K->A)->bool") THEN DISCH_TAC THEN
      ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      REWRITE_TAC [FORALL_IN_IMAGE] THEN
      X_GEN_TAC (← q r"x:K->A") THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o SPEC (← q r"x:K->A") o
        GEN_REWRITE_RULE id [OPEN_IN_PRODUCT_TOPOLOGY_ALT]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:K->A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (product_map k (f:K->A->B)) (cartesian_product k u)") THEN
      ASM_SIMP_TAC [IMAGE_SUBSET, FUN_IN_IMAGE] THEN
      REWRITE_TAC [IMAGE_PRODUCT_MAP, OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
      DISJ2_TAC THEN RULE_ASSUM_TAC (REWRITE_RULE [open_map]) THEN
      ASM_SIMP_TAC [] THEN UNDISCH_TAC
       (← q r"FINITE {i | i IN k /\ ~((u:K->A->bool) i = topspace (top i))}") THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← MESON [FINITE_SUBSET, FINITE_UNION] (← q
       r"FINITE s ==> u SUBSET s UNION t ==> FINITE t ==> FINITE u"))) THEN
      REWRITE_TAC [SUBSET, IN_UNION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"i:K") THEN ASM_CASES_TAC (← q r"(i:K) IN k") THEN ASM_REWRITE_TAC [] THEN
      ASM_SIMP_TAC [PSUBSET, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE] THEN
      MESON_TAC []])

  let CLOSED_MAP_PRODUCT ← prove
   r"!k top top' (f:K->A->B).
        closed_map (product_topology k top,product_topology k top')
                   (product_map k f)
        ==> topspace(product_topology k top) = {} \/
            !i. i IN k ==> closed_map(top i,top' i) (f i)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, NOT_EXISTS_THM] THEN
    REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> p ==> ~q")] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN REWRITE_TAC [closed_map] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    ASM_CASES_TAC (← q r"c:A->bool = {}") THEN
    ASM_REWRITE_TAC [IMAGE_CLAUSES, CLOSED_IN_EMPTY] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"cartesian_product k
        (\j. if j = i then c else topspace(top j)):(K->A)->bool") o
      GEN_REWRITE_RULE id [closed_map]) THEN
    REWRITE_TAC [IMAGE_PRODUCT_MAP, CLOSED_IN_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [IMAGE_EQ_EMPTY, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
    REWRITE_TAC [COND_RATOR, COND_RAND] THEN
    ASM_SIMP_TAC [CLOSED_IN_TOPSPACE, COND_ID] THEN
    DISCH_THEN (DISJ_CASES_THEN MP_TAC) THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"i:K")) THEN ASM_REWRITE_TAC [])

  let IN_PRODUCT_TOPOLOGY_CLOSURE_OF ← prove
   r"!(tops:K->A topology) s k z.
        z IN (product_topology k tops) closure_of s
        ==> !i. i IN k ==> z i IN ((tops i) closure_of (IMAGE (\x. x i) s))"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MATCH_MP_TAC o REWRITE_RULE
     [SUBSET, FORALL_IN_IMAGE, CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET] o
     MATCH_MP CONTINUOUS_MAP_PRODUCT_PROJECTION) THEN
    ASM_REWRITE_TAC [])

  return { CLOSURE_OF_CARTESIAN_PRODUCT, CLOSED_IN_CARTESIAN_PRODUCT,
           INTERIOR_IN_CARTESIAN_PRODUCT, QUOTIENT_MAP_PRODUCT_PROJECTION,
           CONTINUOUS_MAP_PRODUCT, OPEN_MAP_PRODUCT, CLOSED_MAP_PRODUCT,
           IN_PRODUCT_TOPOLOGY_CLOSURE_OF }

/- ------------------------------------------------------------------------- -/
/- The usual (Tychonoff) product topology, part 4.  (metric.ml 4994-5114)    -/
/- ------------------------------------------------------------------------- -/

structure Product4 where
  PRODUCT_TOPOLOGY_EQ : thm
  DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT_EQ : thm
  DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT : thm
  DISCRETE_SPACE_PRODUCT_TOPOLOGY : thm
  pointwise_topology : thm
  TOPSPACE_POINTWISE_PRODUCT : thm
  TOPSPACE_POINTWISE_TOPOLOGY : thm
  OPEN_IN_POINTWISE_PRODUCT_AGREE : thm
  POINTWISE_PRODUCT_NEIGHBOURHOOD : thm
  CLOSED_IN_POINTWISE_PRODUCT : thm
  OPEN_IN_POINTWISE_TOPOLOGY_AGREE : thm
  OPEN_IN_POINTWISE_TOPOLOGY_POINT : thm
  CLOSED_IN_POINTWISE_TOPOLOGY_AGREE : thm
  POINTWISE_TOPOLOGY_NEIGHBOURHOOD : thm
  CLOSURE_OF_POINTWISE_TOPOLOGY : thm
  CONTINUOUS_MAP_POINTWISE_TOPOLOGY : thm
  CONTINUOUS_MAP_POINTWISE_EVALUATION : thm
  CONTINUOUS_MAP_POINTWISE_ACTION : thm
  deriving Inhabited

@[nospecialize]
def setupProduct4 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BOpenClosed2 : OpenClosed2) (BProduct1 : Product1) (BProduct2 : Product2) (BSubtopology : Subtopology) (BContMap2 : ContMap2) (BClosure : Closure) (BProd1 : Prod1) :
    ExceptT String IO Product4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CARTESIAN_PRODUCT_EQ, CARTESIAN_PRODUCT_EQ_EMPTY, CARTESIAN_PRODUCT_SINGS,
        CARTESIAN_PRODUCT_UNIV, COND_RAND, CONJ_ASSOC, ETA_AX, EXTENSION, EXTENSIONAL_UNIV,
        FINITE_SING, FINITE_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMP_CONJ, IMP_CONJ_ALT, INTER_UNIV,
        IN_CARTESIAN_PRODUCT, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_EXTENSIONAL, IN_SING, IN_UNIV,
        LEFT_FORALL_IMP_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM,
        NOT_IMP, NOT_INSERT_EMPTY, .. } := D.core2
  let { SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_TRANS, SUBSET_UNIV, UNIONS_GSPEC, o_DEF, o_THM,
        .. } := D.core4
  let { CONTRAPOS_THM, FORALL_AND_THM, FORALL_PAIR_THM, FORALL_UNWIND_THM2, MONO_AND,
        NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_EMPTY, OPEN_IN_SUBOPEN, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, TOPOLOGY_EQ, closed_in,
        .. } := BTopology
  let { DISCRETE_SPACE, DISCRETE_SPACE_TOPSPACE_EMPTY, DISCRETE_SPACE_UNIQUE,
        DISCRETE_TOPOLOGY_UNIQUE, OPEN_IN_DISCRETE_TOPOLOGY,
        SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { DISCRETE_SPACE_OPEN_MAP_IMAGE, .. } := BOpenClosed2
  let { OPEN_IN_PRODUCT_TOPOLOGY_ALT, TOPSPACE_PRODUCT_TOPOLOGY, product_topology, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, OPEN_IN_CARTESIAN_PRODUCT_GEN, OPEN_MAP_PRODUCT_PROJECTION,
        .. } := BProduct2
  let { CLOSED_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { IN_CLOSURE_OF, .. } := BClosure
  let { OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let PRODUCT_TOPOLOGY_EQ ← prove
   r"!k top (top':K->A topology).
        product_topology k top = product_topology k top' <=>
        topspace(product_topology k top) = {} /\
        topspace(product_topology k top') = {} \/
        (!i. i IN k ==> top i = top' i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC
     (← q r"topspace(product_topology k (top':K->A topology)) =
      topspace(product_topology k top)")
    THENL
     [ASM_REWRITE_TAC [],
      EQ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
      REWRITE_TAC [CARTESIAN_PRODUCT_EQ, TOPSPACE_PRODUCT_TOPOLOGY] THEN
      REWRITE_TAC [o_DEF] THEN MESON_TAC []] THEN
    ASM_CASES_TAC (← q r"topspace (product_topology k (top:K->A topology)) = {}") THENL
     [ASM_MESON_TAC [SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EMPTY],
      ASM_REWRITE_TAC []] THEN
    EQ_TAC THENL
     [REWRITE_TAC [TOPOLOGY_EQ] THEN
      DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN MP_TAC th)) THEN
      REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q
       r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
      MATCH_MP_TAC MONO_AND THEN CONJ_TAC THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      (ASM_CASES_TAC (← q r"u:A->bool = {}") THEN ASM_REWRITE_TAC [OPEN_IN_EMPTY]) THENL
      [FIRST_X_ASSUM (MP_TAC o SPEC
        (← q r"cartesian_product k
          (\j:K. if j = i then (u:A->bool) else topspace(top j))")),
       FIRST_X_ASSUM ((fun th => SUBST_ALL_TAC th THEN ASSUME_TAC th) o SYM) THEN
       FIRST_X_ASSUM (MP_TAC o SPEC
        (← q r"cartesian_product k
          (\j:K. if j = i then (u:A->bool) else topspace(top' j))"))] THEN
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
      MATCH_MP_TAC (← TAUT (← q
       r"(r ==> s) /\ ~p /\ q ==> (p \/ q ==> p \/ r) ==> s")) THEN
      (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE
       [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF, CARTESIAN_PRODUCT_EQ_EMPTY]) THEN
      REWRITE_TAC [o_DEF, CARTESIAN_PRODUCT_EQ_EMPTY] THEN
      (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      (CONJ_TAC THENL [ALL_TAC, ASM_MESON_TAC [OPEN_IN_TOPSPACE]]) THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"{i:K}") THEN
      REWRITE_TAC [FINITE_SING, SUBSET, IN_SING, IN_ELIM_THM, NOT_IMP] THEN
      MESON_TAC [],
      DISCH_TAC THEN ASM_SIMP_TAC [product_topology] THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN AP_THM_TAC THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN ASM SET_TAC []])

  let DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT_EQ ← prove
   r"!k (s:K->A->bool).
        discrete_topology(cartesian_product k s) =
        product_topology k (discrete_topology o s) <=>
        cartesian_product k s = {} \/
        FINITE {i | i IN k /\ ~(?a. s i SUBSET {a})}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, ETA_AX] THEN
    SIMP_TAC [IN_CARTESIAN_PRODUCT, ← GSYM CARTESIAN_PRODUCT_SINGS] THEN
    REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY] THEN
    SIMP_TAC [TOPSPACE_DISCRETE_TOPOLOGY, SING_SUBSET] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, NOT_INSERT_EMPTY] THEN
    ONCE_REWRITE_TAC [← sr
     r"P /\ ~({x} = s) <=> P /\ (P ==> x IN s ==> ~(?a. s SUBSET {a}))"] THEN
    SIMP_TAC [] THEN
    REWRITE_TAC [← TAUT (← q r"p /\ (p ==> q) <=> p /\ q"), LEFT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM IN_CARTESIAN_PRODUCT, MEMBER_NOT_EMPTY] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, ← TAUT (← q r"~p ==> q <=> p \/ q")])

  let DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT ← prove
   r"!k (s:K->A->bool).
        FINITE {i | i IN k /\ ~(?a. s i SUBSET {a})}
        ==> discrete_topology(cartesian_product k s) =
            product_topology k (discrete_topology o s)"
   (SIMP_TAC [DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT_EQ])

  let DISCRETE_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) k.
        discrete_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        FINITE {i | i IN k /\ ~(?a. topspace(tops i) SUBSET {a})} /\
        !i. i IN k ==> discrete_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [DISCRETE_SPACE_TOPSPACE_EMPTY] THEN
    EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, LEFT_IMP_EXISTS_THM] THEN
        X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN
        GEN_REWRITE_TAC LAND_CONV [DISCRETE_SPACE_UNIQUE] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"z:K->A")) THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
        SIMP_TAC [IN_CARTESIAN_PRODUCT, ← GSYM CARTESIAN_PRODUCT_SINGS] THEN
        ASM_REWRITE_TAC [← GSYM IN_CARTESIAN_PRODUCT, ETA_AX] THEN
        REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN
        REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, NOT_INSERT_EMPTY] THEN
        DISCH_THEN (MP_TAC o CONJUNCT1) THEN
        MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] FINITE_SUBSET) THEN SET_TAC [],
        DISCH_THEN (fun th => tactic_of do
        pure (X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN MP_TAC th)) THEN
        MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
         (← REWRITE_RULE [CONJ_ASSOC] DISCRETE_SPACE_OPEN_MAP_IMAGE)) THEN
        EXISTS_TAC (← q r"\x:K->A. x i") THEN
        ASM_SIMP_TAC [OPEN_MAP_PRODUCT_PROJECTION] THEN
        REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                     TOPSPACE_PRODUCT_TOPOLOGY] THEN
        ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM]],
      ONCE_REWRITE_TAC [IMP_CONJ_ALT] THEN
      GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [DISCRETE_SPACE] THEN
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"u:K->A->bool") (ASSUME_TAC o GSYM)) THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p /\ ~q <=> ~(p ==> q)")] THEN ASM_SIMP_TAC [] THEN
      REWRITE_TAC [NOT_IMP, TOPSPACE_DISCRETE_TOPOLOGY] THEN DISCH_TAC THEN
      REWRITE_TAC [DISCRETE_SPACE] THEN
      EXISTS_TAC (← q r"cartesian_product k (u:K->A->bool)") THEN
      ASM_SIMP_TAC [DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT] THEN
      ASM_SIMP_TAC [PRODUCT_TOPOLOGY_EQ, o_THM]])

  /- The topology of pointwise convergence on a set s of functions A->B, as    -/
  /- the subspace topology on s of product_topology (:A) (\x.                  -/
  /- discrete_topology (:B)). The sets of functions agreeing with f on a       -/
  /- finite set are open and form a base at f                                  -/
  /- (OPEN_IN_POINTWISE_TOPOLOGY_AGREE, POINTWISE_TOPOLOGY_NEIGHBOURHOOD); a   -/
  /- set is closed in the product iff it contains every function approximable  -/
  /- on finite sets by its members (CLOSED_IN_POINTWISE_PRODUCT); a map into   -/
  /- pointwise_topology s is continuous iff the fibres of its evaluations are  -/
  /- open (CONTINUOUS_MAP_POINTWISE_TOPOLOGY).                                 -/

  let pointwise_topology ← new_definition
   r"pointwise_topology (s:(A->B)->bool) =
        subtopology (product_topology (:A) (\x. discrete_topology (:B))) s"

  let TOPSPACE_POINTWISE_PRODUCT ← prove
   r"topspace(product_topology (:A) (\x. discrete_topology (:B))) = (:A->B)"
   (REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, o_DEF, TOPSPACE_DISCRETE_TOPOLOGY,
                CARTESIAN_PRODUCT_UNIV])

  let TOPSPACE_POINTWISE_TOPOLOGY ← prove
   r"!s:(A->B)->bool. topspace(pointwise_topology s) = s"
   (REWRITE_TAC [pointwise_topology, TOPSPACE_SUBTOPOLOGY,
                TOPSPACE_POINTWISE_PRODUCT, INTER_UNIV])

  let OPEN_IN_POINTWISE_PRODUCT_AGREE ← prove
   r"!k (f:A->B).
        FINITE k
        ==> open_in (product_topology (:A) (\x. discrete_topology (:B)))
                    {g | !x. x IN k ==> g x = f x}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{g | !x. x IN k ==> g x = (f:A->B) x} =
      cartesian_product (:A) (\x. if x IN k then {f x} else (:B))")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_CARTESIAN_PRODUCT, IN_ELIM_THM,
                  EXTENSIONAL_UNIV, IN_UNIV] THEN
      REWRITE_TAC [COND_RAND, IN_SING, IN_UNIV] THEN
      REWRITE_TAC [← TAUT (← q r"(if p then q else T) <=> (p ==> q)")],
      REWRITE_TAC [OPEN_IN_CARTESIAN_PRODUCT_GEN] THEN DISJ2_TAC THEN
      REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, OPEN_IN_DISCRETE_TOPOLOGY,
                  SUBSET_UNIV, IN_UNIV] THEN
      MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC (← q r"k:A->bool") THEN
      ASM_REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"i:A") THEN COND_CASES_TAC THEN ASM_REWRITE_TAC []])

  let POINTWISE_PRODUCT_NEIGHBOURHOOD ← prove
   r"!w (f:A->B).
        open_in (product_topology (:A) (\x. discrete_topology (:B))) w /\
        f IN w
        ==> ?k. FINITE k /\ {g | !x. x IN k ==> g x = f x} SUBSET w"
   (REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY_ALT] THEN REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:A->B")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->B->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC
     (← q r"{i | i IN (:A) /\ ~((u:A->B->bool) i = topspace(discrete_topology (:B)))}")
    THEN ASM_REWRITE_TAC [] THEN
    TRANS_TAC SUBSET_TRANS (← q r"cartesian_product (:A) (u:A->B->bool)") THEN
    ASM_REWRITE_TAC [] THEN
    UNDISCH_TAC (← q r"(f:A->B) IN cartesian_product (:A) u") THEN
    REWRITE_TAC [SUBSET, IN_CARTESIAN_PRODUCT, IN_ELIM_THM, EXTENSIONAL_UNIV,
                IN_UNIV, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"g:A->B") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"i:A") THEN
    ASM_CASES_TAC (← q r"(u:A->B->bool) i = (:B)") THEN ASM_SIMP_TAC [IN_UNIV])

  let CLOSED_IN_POINTWISE_PRODUCT ← prove
   r"!s:(A->B)->bool.
        closed_in (product_topology (:A) (\x. discrete_topology (:B))) s <=>
        !f. (!k. FINITE k ==> ?g. g IN s /\ !x. x IN k ==> g x = f x)
            ==> f IN s"
   (GEN_TAC THEN
    REWRITE_TAC [closed_in, TOPSPACE_POINTWISE_PRODUCT, SUBSET_UNIV] THEN
    EQ_TAC THENL
     [DISCH_TAC THEN X_GEN_TAC (← q r"f:A->B") THEN
      ONCE_REWRITE_TAC [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
      MP_TAC (← ISPECL [← q r"(:A->B) DIFF s", ← q r"f:A->B"]
                    POINTWISE_PRODUCT_NEIGHBOURHOOD) THEN
      ASM_REWRITE_TAC [IN_DIFF, IN_UNIV] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [],
      DISCH_TAC THEN ONCE_REWRITE_TAC [OPEN_IN_SUBOPEN] THEN
      X_GEN_TAC (← q r"f:A->B") THEN REWRITE_TAC [IN_DIFF, IN_UNIV] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"f:A->B")) THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"{g | !x. x IN k ==> g x = (f:A->B) x}") THEN
      ASM_SIMP_TAC [OPEN_IN_POINTWISE_PRODUCT_AGREE] THEN ASM SET_TAC []])

  let OPEN_IN_POINTWISE_TOPOLOGY_AGREE ← prove
   r"!s k (f:A->B).
        FINITE k
        ==> open_in (pointwise_topology s)
                    {g | g IN s /\ !x. x IN k ==> g x = f x}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [pointwise_topology, OPEN_IN_SUBTOPOLOGY] THEN
    EXISTS_TAC (← q r"{g | !x. x IN k ==> g x = (f:A->B) x}") THEN
    ASM_SIMP_TAC [OPEN_IN_POINTWISE_PRODUCT_AGREE] THEN SET_TAC [])

  let OPEN_IN_POINTWISE_TOPOLOGY_POINT ← prove
   r"!s x (y:B).
        open_in (pointwise_topology s) {g:A->B | g IN s /\ g x = y}"
   (REPEAT GEN_TAC THEN
    MP_TAC (← ISPECL [← q r"s:(A->B)->bool", ← q r"{x:A}", ← q r"\z:A. (y:B)"]
                  OPEN_IN_POINTWISE_TOPOLOGY_AGREE) THEN
    REWRITE_TAC [FINITE_SING, IN_SING, FORALL_UNWIND_THM2])

  let CLOSED_IN_POINTWISE_TOPOLOGY_AGREE ← prove
   r"!s k (f:A->B).
        closed_in (pointwise_topology s)
                  {g | g IN s /\ !x. x IN k ==> g x = f x}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [pointwise_topology, CLOSED_IN_SUBTOPOLOGY] THEN
    EXISTS_TAC (← q r"{g | !x. x IN k ==> g x = (f:A->B) x}") THEN
    CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    REWRITE_TAC [CLOSED_IN_POINTWISE_PRODUCT, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"h:A->B") THEN DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:A}")) THEN
    REWRITE_TAC [FINITE_SING, IN_SING, FORALL_UNWIND_THM2] THEN
    ASM_MESON_TAC [])

  let POINTWISE_TOPOLOGY_NEIGHBOURHOOD ← prove
   r"!s w (f:A->B).
        open_in (pointwise_topology s) w /\ f IN w
        ==> ?k. FINITE k /\ {g | g IN s /\ !x. x IN k ==> g x = f x} SUBSET w"
   (REWRITE_TAC [pointwise_topology, OPEN_IN_SUBTOPOLOGY] THEN
    REPEAT STRIP_TAC THEN FIRST_X_ASSUM SUBST_ALL_TAC THEN
    MP_TAC (← ISPECL [← q r"t:(A->B)->bool", ← q r"f:A->B"]
                  POINTWISE_PRODUCT_NEIGHBOURHOOD) THEN
    ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])

  let CLOSURE_OF_POINTWISE_TOPOLOGY ← prove
   r"!s t:(A->B)->bool.
        t SUBSET s
        ==> (pointwise_topology s) closure_of t =
            {f | f IN s /\
                 !k. FINITE k ==> ?g. g IN t /\ !x. x IN k ==> g x = f x}"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [EXTENSION, IN_CLOSURE_OF, TOPSPACE_POINTWISE_TOPOLOGY,
                IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"f:A->B") THEN ASM_CASES_TAC (← q r"(f:A->B) IN s") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC
       (← q r"{g | g IN s /\ !x. x IN k ==> g x = (f:A->B) x}")) THEN
      ASM_SIMP_TAC [OPEN_IN_POINTWISE_TOPOLOGY_AGREE, IN_ELIM_THM] THEN
      MESON_TAC [],
      X_GEN_TAC (← q r"w:(A->B)->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"s:(A->B)->bool", ← q r"w:(A->B)->bool", ← q r"f:A->B"]
                    POINTWISE_TOPOLOGY_NEIGHBOURHOOD) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"k:A->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN ASM_REWRITE_TAC [] THEN
      ASM SET_TAC []])

  let CONTINUOUS_MAP_POINTWISE_TOPOLOGY ← prove
   r"!top s (g:C->A->B).
        continuous_map (top,pointwise_topology s) g <=>
        (!z. z IN topspace top ==> g z IN s) /\
        !x y. open_in top {z | z IN topspace top /\ g z x = y}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [pointwise_topology, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE, IN_UNIV] THEN
    REWRITE_TAC [CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES, IN_UNIV] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_EXTENSIONAL, IN_UNIV] THEN
    MESON_TAC [])

  let CONTINUOUS_MAP_POINTWISE_EVALUATION ← prove
   r"!s x:A. continuous_map (pointwise_topology s,discrete_topology (:B))
                          (\f:A->B. f x)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES, IN_UNIV] THEN
    REWRITE_TAC [TOPSPACE_POINTWISE_TOPOLOGY, OPEN_IN_POINTWISE_TOPOLOGY_POINT])

  let CONTINUOUS_MAP_POINTWISE_ACTION ← prove
   r"!s:(A->B)->bool.
        continuous_map
         (prod_topology (pointwise_topology s) (discrete_topology (:A)),
          discrete_topology (:B))
         (\z. FST z (SND z))"
   (GEN_TAC THEN
    REWRITE_TAC [CONTINUOUS_MAP_INTO_DISCRETE_TOPOLOGY_FIBRES, IN_UNIV] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, TOPSPACE_POINTWISE_TOPOLOGY,
                TOPSPACE_DISCRETE_TOPOLOGY] THEN
    X_GEN_TAC (← q r"y:B") THEN
    SUBGOAL_THEN
     (← q r"{z | z IN (s:(A->B)->bool) CROSS (:A) /\ FST z (SND z) = y} =
      UNIONS {{f | f IN s /\ f x = y} CROSS {x} | x IN (:A)}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM,
                  IN_CROSS, IN_SING, IN_UNIV] THEN
      MESON_TAC [],
      MATCH_MP_TAC OPEN_IN_UNIONS THEN
      REWRITE_TAC [FORALL_IN_GSPEC, IN_UNIV, OPEN_IN_CROSS] THEN
      REWRITE_TAC [OPEN_IN_POINTWISE_TOPOLOGY_POINT, OPEN_IN_DISCRETE_TOPOLOGY,
                  SUBSET_UNIV]])

  return { PRODUCT_TOPOLOGY_EQ, DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT_EQ,
           DISCRETE_TOPOLOGY_CARTESIAN_PRODUCT, DISCRETE_SPACE_PRODUCT_TOPOLOGY, pointwise_topology, TOPSPACE_POINTWISE_PRODUCT, TOPSPACE_POINTWISE_TOPOLOGY, OPEN_IN_POINTWISE_PRODUCT_AGREE, POINTWISE_PRODUCT_NEIGHBOURHOOD, CLOSED_IN_POINTWISE_PRODUCT, OPEN_IN_POINTWISE_TOPOLOGY_AGREE, OPEN_IN_POINTWISE_TOPOLOGY_POINT, CLOSED_IN_POINTWISE_TOPOLOGY_AGREE, POINTWISE_TOPOLOGY_NEIGHBOURHOOD, CLOSURE_OF_POINTWISE_TOPOLOGY, CONTINUOUS_MAP_POINTWISE_TOPOLOGY, CONTINUOUS_MAP_POINTWISE_EVALUATION, CONTINUOUS_MAP_POINTWISE_ACTION }

/- ------------------------------------------------------------------------- -/
/- Disjoint sum of arbitarily many spaces.  (metric.ml 5313-5487)            -/
/- ------------------------------------------------------------------------- -/

structure SumTop where
  sum_topology : thm
  OPEN_IN_SUM_TOPOLOGY : thm
  OPEN_IN_DISJOINT_UNION : thm
  TOPSPACE_SUM_TOPOLOGY : thm
  OPEN_IN_SUM_TOPOLOGY_ALT : thm
  FORALL_OPEN_IN_SUM_TOPOLOGY : thm
  EXISTS_OPEN_IN_SUM_TOPOLOGY : thm
  CLOSED_IN_SUM_TOPOLOGY : thm
  CLOSED_IN_DISJOINT_UNION : thm
  CLOSED_IN_SUM_TOPOLOGY_ALT : thm
  FORALL_CLOSED_IN_SUM_TOPOLOGY : thm
  EXISTS_CLOSED_IN_SUM_TOPOLOGY : thm
  OPEN_MAP_COMPONENT_INJECTION : thm
  CLOSED_MAP_COMPONENT_INJECTION : thm
  CONTINUOUS_MAP_COMPONENT_INJECTION : thm
  SUBTOPOLOGY_SUM_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupSumTop [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1) : ExceptT String IO SumTop := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { DIFF, DISJOINT_UNION_EQ, EMPTY_GSPEC, EMPTY_SUBSET, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, INTER_COMM, INTER_DISJOINT_UNION, IN_DIFF, IN_ELIM_PAIR_THM, IN_ELIM_THM,
        IN_GSPEC, IN_IMAGE, LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_DIFF, SUBSET_DISJOINT_UNION_EXISTS,
        UNIONS_GSPEC, UNIONS_SUBSET, UNWIND_THM1, disjoint_union, o_THM, .. } := D.core4
  let { FORALL_AND_THM, FORALL_PAIR_THM, LEFT_AND_EXISTS_THM, PAIR_EQ, RIGHT_IMP_EXISTS_THM,
        .. } := D.core5
  let { CLOSED_IN_EMPTY, CLOSED_IN_SUBSET, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, TOPOLOGY_EQ, closed_in, istopology, topology_tybij,
        topspace, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY_INTER_OPEN,
        .. } := BSubtopology
  let { continuous_map, .. } := BContMap1
  let { closed_map, open_map, .. } := BOpenClosed1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let sum_topology ← new_definition
   r"sum_topology (k:K->bool) (top:K->A topology) =
        topology { u | u SUBSET disjoint_union k (topspace o top) /\
                       !i. i IN k ==> open_in (top i) {x | (i,x) IN u}}"

  let OPEN_IN_SUM_TOPOLOGY ← do
    let lemma ← prove
     r"{x | i,x IN UNIONS v} = UNIONS {{x | i,x IN k} | k IN v}"
     (REWRITE_TAC [UNIONS_GSPEC] THEN SET_TAC [])
    let tybij2 ← CONJUNCT2 topology_tybij
    prove
     r"!k (top:K->A topology) u.
        open_in (sum_topology k top) u <=>
        u SUBSET disjoint_union k (topspace o top) /\
        !i. i IN k ==> open_in (top i) {x | (i,x) IN u}"
     (REPEAT GEN_TAC THEN REWRITE_TAC [sum_topology] THEN
      W (MP_TAC o (fun th => do pure (← EQ_IMP_RULE th).1) o
          PART_MATCH (lhand o rand) tybij2 o
            rator o lhand o snd) THEN
      ANTS_TAC THENL [ALL_TAC, SIMP_TAC [IN_ELIM_THM]] THEN
      REWRITE_TAC [istopology] THEN REWRITE_TAC [IN_ELIM_THM] THEN
      REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, EMPTY_SUBSET] THEN
      SIMP_TAC [OPEN_IN_EMPTY, OPEN_IN_INTER, ← sr
       r"{x | (i,x) IN s INTER t} = {x | (i,x) IN s} INTER {x | (i,x) IN t}"] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"v:(K#A->bool)->bool") THEN REWRITE_TAC [UNIONS_SUBSET] THEN
      GEN_REWRITE_TAC LAND_CONV [SUBSET] THEN
      SIMP_TAC [IN_ELIM_THM, lemma, OPEN_IN_UNIONS, FORALL_IN_GSPEC])

  let OPEN_IN_DISJOINT_UNION ← prove
   r"!k (top:K->A topology) u.
        open_in (sum_topology k top) (disjoint_union k u) <=>
        !i. i IN k ==> open_in (top i) (u i)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [OPEN_IN_SUM_TOPOLOGY, disjoint_union] THEN
    SIMP_TAC [IN_ELIM_PAIR_THM, SUBSET, FORALL_IN_GSPEC, o_THM, IN_GSPEC] THEN
    MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let TOPSPACE_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        topspace(sum_topology k top) = disjoint_union k (topspace o top)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ] THEN CONJ_TAC THENL
     [GEN_REWRITE_TAC LAND_CONV [topspace] THEN
      SIMP_TAC [UNIONS_SUBSET, IN_ELIM_THM, OPEN_IN_SUM_TOPOLOGY],
      MATCH_MP_TAC OPEN_IN_SUBSET THEN
      REWRITE_TAC [OPEN_IN_DISJOINT_UNION, o_THM, OPEN_IN_TOPSPACE]])

  let OPEN_IN_SUM_TOPOLOGY_ALT ← prove
   r"!k (top:K->A topology) u.
        open_in (sum_topology k top) u <=>
        ?t. u = disjoint_union k t /\
            !i. i IN k ==> open_in (top i) (t i)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_SUM_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_DISJOINT_UNION_EXISTS] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [IMP_CONJ] THEN
    REWRITE_TAC [disjoint_union, IN_ELIM_PAIR_THM] THEN
    SIMP_TAC [IN_GSPEC, o_THM, OPEN_IN_SUBSET])

  let FORALL_OPEN_IN_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        (!u. open_in (sum_topology k top) u ==> P u) <=>
        (!t. (!i. i IN k ==> open_in (top i) (t i))
             ==> P(disjoint_union k t))"
   (REWRITE_TAC [OPEN_IN_SUM_TOPOLOGY_ALT] THEN MESON_TAC [])

  let EXISTS_OPEN_IN_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        (?u. open_in (sum_topology k top) u /\ P u) <=>
        (?t. (!i. i IN k ==> open_in (top i) (t i)) /\
             P(disjoint_union k t))"
   (REWRITE_TAC [OPEN_IN_SUM_TOPOLOGY_ALT] THEN MESON_TAC [])

  let CLOSED_IN_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology) u.
        closed_in (sum_topology k top) u <=>
        u SUBSET disjoint_union k (topspace o top) /\
        !i. i IN k ==> closed_in (top i) {x | (i,x) IN u}"
   (REWRITE_TAC [closed_in, TOPSPACE_SUM_TOPOLOGY, OPEN_IN_SUM_TOPOLOGY] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [SUBSET_DIFF] THEN
    SIMP_TAC [IN_DIFF, disjoint_union, SUBSET, IN_ELIM_PAIR_THM, o_THM,
              FORALL_PAIR_THM] THEN
    REWRITE_TAC [DIFF, IN_ELIM_THM] THEN MESON_TAC [])

  let CLOSED_IN_DISJOINT_UNION ← prove
   r"!k (top:K->A topology) u.
        closed_in (sum_topology k top) (disjoint_union k u) <=>
        !i. i IN k ==> closed_in (top i) (u i)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CLOSED_IN_SUM_TOPOLOGY, disjoint_union] THEN
    SIMP_TAC [IN_ELIM_PAIR_THM, SUBSET, FORALL_IN_GSPEC, o_THM, IN_GSPEC] THEN
    MESON_TAC [SUBSET, CLOSED_IN_SUBSET])

  let CLOSED_IN_SUM_TOPOLOGY_ALT ← prove
   r"!k (top:K->A topology) u.
        closed_in (sum_topology k top) u <=>
        ?t. u = disjoint_union k t /\
            !i. i IN k ==> closed_in (top i) (t i)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_SUM_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_DISJOINT_UNION_EXISTS] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_EXISTS THEN SIMP_TAC [IMP_CONJ] THEN
    REWRITE_TAC [disjoint_union, IN_ELIM_PAIR_THM] THEN
    SIMP_TAC [IN_GSPEC, o_THM, CLOSED_IN_SUBSET])

  let FORALL_CLOSED_IN_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        (!u. closed_in (sum_topology k top) u ==> P u) <=>
        (!t. (!i. i IN k ==> closed_in (top i) (t i))
             ==> P(disjoint_union k t))"
   (REWRITE_TAC [CLOSED_IN_SUM_TOPOLOGY_ALT] THEN MESON_TAC [])

  let EXISTS_CLOSED_IN_SUM_TOPOLOGY ← prove
   r"!k (top:K->A topology).
        (?u. closed_in (sum_topology k top) u /\ P u) <=>
        (?t. (!i. i IN k ==> closed_in (top i) (t i)) /\
             P(disjoint_union k t))"
   (REWRITE_TAC [CLOSED_IN_SUM_TOPOLOGY_ALT] THEN MESON_TAC [])

  let OPEN_MAP_COMPONENT_INJECTION ← prove
   r"!k (top:K->A topology) i.
        i IN k ==> open_map(top i,sum_topology k top) (\x. (i,x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [open_map, OPEN_IN_SUM_TOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, disjoint_union, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
      REWRITE_TAC [o_THM, PAIR_EQ] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE, PAIR_EQ] THEN
      ASM_CASES_TAC (← q r"j:K = i") THEN
      ASM_REWRITE_TAC [UNWIND_THM1, EMPTY_GSPEC, IN_GSPEC] THEN
      ASM_SIMP_TAC [OPEN_IN_EMPTY]])

  let CLOSED_MAP_COMPONENT_INJECTION ← prove
   r"!k (top:K->A topology) i.
        i IN k ==> closed_map(top i,sum_topology k top) (\x. (i,x))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closed_map, CLOSED_IN_SUM_TOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, disjoint_union, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
      REWRITE_TAC [o_THM, PAIR_EQ] THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN REWRITE_TAC [IN_IMAGE, PAIR_EQ] THEN
      ASM_CASES_TAC (← q r"j:K = i") THEN
      ASM_REWRITE_TAC [UNWIND_THM1, EMPTY_GSPEC, IN_GSPEC] THEN
      ASM_SIMP_TAC [CLOSED_IN_EMPTY]])

  let CONTINUOUS_MAP_COMPONENT_INJECTION ← prove
   r"!k (top:K->A topology) i.
        i IN k ==> continuous_map(top i,sum_topology k top) (\x. (i,x))"
   (REWRITE_TAC [continuous_map, OPEN_IN_SUM_TOPOLOGY, TOPSPACE_SUM_TOPOLOGY] THEN
    REWRITE_TAC [← sr r"{x | x IN s /\ P x} = s INTER {x | P x}"] THEN
    SIMP_TAC [OPEN_IN_INTER, OPEN_IN_TOPSPACE] THEN
    SIMP_TAC [disjoint_union, IN_ELIM_PAIR_THM, o_THM])

  let SUBTOPOLOGY_SUM_TOPOLOGY ← prove
   r"!k top s:K->A->bool.
        subtopology (sum_topology k top) (disjoint_union k s) =
        sum_topology k (\i. subtopology (top i) (s i))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [TOPOLOGY_EQ] THEN
    REWRITE_TAC [FORALL_AND_THM, ← TAUT (← q r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [FORALL_OPEN_IN_SUM_TOPOLOGY] THEN
    REWRITE_TAC [INTER_DISJOINT_UNION, OPEN_IN_DISJOINT_UNION] THEN
    SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:K->A->bool", ← q r"t:K->A->bool"] THEN STRIP_TAC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"disjoint_union k (t:K->A->bool)") THEN
    ASM_SIMP_TAC [OPEN_IN_DISJOINT_UNION, INTER_DISJOINT_UNION] THEN
    REWRITE_TAC [DISJOINT_UNION_EQ] THEN
    ASM_SIMP_TAC [INTER_COMM])

  return { sum_topology, OPEN_IN_SUM_TOPOLOGY, OPEN_IN_DISJOINT_UNION, TOPSPACE_SUM_TOPOLOGY,
           OPEN_IN_SUM_TOPOLOGY_ALT, FORALL_OPEN_IN_SUM_TOPOLOGY, EXISTS_OPEN_IN_SUM_TOPOLOGY,
           CLOSED_IN_SUM_TOPOLOGY, CLOSED_IN_DISJOINT_UNION, CLOSED_IN_SUM_TOPOLOGY_ALT,
           FORALL_CLOSED_IN_SUM_TOPOLOGY, EXISTS_CLOSED_IN_SUM_TOPOLOGY,
           OPEN_MAP_COMPONENT_INJECTION, CLOSED_MAP_COMPONENT_INJECTION,
           CONTINUOUS_MAP_COMPONENT_INJECTION, SUBTOPOLOGY_SUM_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Homeomorphisms, part 1.  (metric.ml 5489-5716)                            -/
/- ------------------------------------------------------------------------- -/

structure Homeo1 where
  homeomorphic_map : thm
  homeomorphic_maps : thm
  HOMEOMORPHIC_MAP_EQ : thm
  HOMEOMORPHIC_MAPS_EQ : thm
  HOMEOMORPHIC_MAPS_SYM : thm
  HOMEOMORPHIC_MAPS_ID : thm
  HOMEOMORPHIC_MAP_ID : thm
  HOMEOMORPHIC_MAPS_I : thm
  HOMEOMORPHIC_MAP_I : thm
  HOMEOMORPHIC_MAP_COMPOSE : thm
  HOMEOMORPHIC_MAPS_COMPOSE : thm
  HOMEOMORPHIC_EQ_EVERYTHING_MAP : thm
  HOMEOMORPHIC_IMP_QUOTIENT_MAP : thm
  HOMEOMORPHIC_MAP_QUOTIENT_TOPOLOGY : thm
  HOMEOMORPHIC_IMP_CONTINUOUS_MAP : thm
  HOMEOMORPHIC_IMP_OPEN_MAP : thm
  HOMEOMORPHIC_IMP_CLOSED_MAP : thm
  HOMEOMORPHIC_IMP_SURJECTIVE_MAP : thm
  HOMEOMORPHIC_IMP_INJECTIVE_MAP : thm
  BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP : thm
  BIJECTIVE_CLOSED_IMP_HOMEOMORPHIC_MAP : thm
  OPEN_EQ_CONTINUOUS_INVERSE_MAP : thm
  CLOSED_EQ_CONTINUOUS_INVERSE_MAP : thm
  HOMEOMORPHIC_MAPS_MAP : thm
  HOMEOMORPHIC_MAPS_IMP_MAP : thm
  deriving Inhabited

@[nospecialize]
def setupHomeo1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) :
    ExceptT String IO Homeo1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ACI, CONJ_ASSOC, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_ID, .. } := D.core1
  let { I_DEF, .. } := D.core2
  let { SUBSET, SUBSET_ANTISYM_EQ, o_THM, .. } := D.core4
  let { CLOSED_IN_SUBSET, OPEN_IN_SUBSET, TOPOLOGY_EQ, .. } := BTopology
  let { CONTINUOUS_MAP_CLOSED_IN, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
        continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, .. } := BContMap2
  let { closed_map, open_map, .. } := BOpenClosed1
  let { CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, CONTINUOUS_OPEN_IMP_QUOTIENT_MAP,
        INJECTIVE_QUOTIENT_MAP, QUOTIENT_MAP_COMPOSE, QUOTIENT_MAP_EQ,
        QUOTIENT_MAP_QUOTIENT_TOPOLOGY, quotient_map, .. } := BQuotient
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let homeomorphic_map ← new_definition
   r"homeomorphic_map (top,top') (f:A->B) <=>
      quotient_map (top,top') f /\
      !x y. x IN topspace top /\ y IN topspace top
            ==> (f x = f y <=> x = y)"

  let homeomorphic_maps ← new_definition
   r"homeomorphic_maps(top,top') (f:A->B,g) <=>
        continuous_map(top,top') f /\
        continuous_map(top',top) g /\
        (!x. x IN topspace top ==> g(f x) = x) /\
        (!y. y IN topspace top' ==> f(g y) = y)"

  let HOMEOMORPHIC_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ homeomorphic_map (top,top') f
        ==> homeomorphic_map (top,top') g"
   (REWRITE_TAC [homeomorphic_map] THEN MESON_TAC [QUOTIENT_MAP_EQ])

  let HOMEOMORPHIC_MAPS_EQ ← prove
   r"!top top' f (f':A->B) g g'.
        (!x. x IN topspace top ==> f x = f' x) /\
        (!x. x IN topspace top' ==> g x = g' x) /\
        homeomorphic_maps (top,top') (f,g)
        ==> homeomorphic_maps (top,top') (f',g')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_EQ], ALL_TAC] THEN
    REPEAT (FIRST_X_ASSUM
     (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_SYM ← prove
   r"!(f:A->B) g top top'.
        homeomorphic_maps(top,top') (f,g) <=>
        homeomorphic_maps(top',top) (g,f)"
   (REWRITE_TAC [homeomorphic_maps, CONJ_ACI])

  let HOMEOMORPHIC_MAPS_ID ← prove
   r"!top top':A topology.
        homeomorphic_maps(top,top') ((\x. x),(\x. x)) <=> top' = top"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [homeomorphic_maps, CONTINUOUS_MAP_ID] THEN
    REWRITE_TAC [continuous_map, IMAGE_ID] THEN
    ASM_CASES_TAC (← q r"topspace top':A->bool = topspace top") THENL
     [ASM_REWRITE_TAC [], ASM SET_TAC []] THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET, ← sr
     r"s SUBSET u ==> {x | x IN u /\ x IN s} = s"] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET, ← sr
     r"s SUBSET u ==> {x | x IN u /\ x IN s} = s"] THEN
    REWRITE_TAC [TOPOLOGY_EQ] THEN MESON_TAC [])

  let HOMEOMORPHIC_MAP_ID ← prove
   r"!top top':A topology.
        homeomorphic_map(top,top') (\x. x) <=> top' = top"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_map, quotient_map, IMAGE_ID] THEN EQ_TAC THENL
     [DISCH_THEN (CONJUNCTS_THEN2 (ASSUME_TAC o SYM) MP_TAC), ALL_TAC] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> {x | x IN u /\ x IN s} = s"] THEN
    GEN_REWRITE_TAC RAND_CONV [TOPOLOGY_EQ] THEN
    ASM_MESON_TAC [OPEN_IN_SUBSET])

  let HOMEOMORPHIC_MAPS_I ← prove
   r"!top top':A topology.
        homeomorphic_maps(top,top') (I,I) <=> top' = top"
   (REWRITE_TAC [I_DEF, HOMEOMORPHIC_MAPS_ID])

  let HOMEOMORPHIC_MAP_I ← prove
   r"!top top':A topology. homeomorphic_map(top,top') I <=> top' = top"
   (REWRITE_TAC [I_DEF, HOMEOMORPHIC_MAP_ID])

  let HOMEOMORPHIC_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        homeomorphic_map(top,top') f /\ homeomorphic_map(top',top'') g
        ==> homeomorphic_map(top,top'') (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_map, o_THM] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM_MESON_TAC [QUOTIENT_MAP_COMPOSE], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE
     [quotient_map, ← GSYM SUBSET_ANTISYM_EQ, SUBSET, FORALL_IN_IMAGE]) THEN
    ASM_MESON_TAC [])

  let HOMEOMORPHIC_MAPS_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C) h k.
        homeomorphic_maps(top,top') (f,h) /\
        homeomorphic_maps(top',top'') (g,k)
        ==> homeomorphic_maps(top,top'') (g o f,h o k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps, o_THM] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE], ALL_TAC] THEN
    REPEAT (FIRST_X_ASSUM
     (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_EQ_EVERYTHING_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f <=>
        continuous_map (top,top') f /\
        open_map (top,top') f /\
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        !x y. x IN topspace top /\ y IN topspace top
              ==> (f x = f y <=> x = y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_map] THEN
    ASM_CASES_TAC
     (← q r"!x y. x IN topspace top /\ y IN topspace top
            ==> ((f:A->B) x = f y <=> x = y)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INJECTIVE_QUOTIENT_MAP THEN
    ASM_REWRITE_TAC [])

  let HOMEOMORPHIC_IMP_QUOTIENT_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f ==> quotient_map(top,top') f"
   (SIMP_TAC [homeomorphic_map])

  let HOMEOMORPHIC_MAP_QUOTIENT_TOPOLOGY ← prove
   r"!top f:A->B.
        (!x y. x IN topspace top /\ y IN topspace top ==> (f x = f y <=> x = y))
        ==> homeomorphic_map (top,quotient_topology (top,f)) f"
   (SIMP_TAC [homeomorphic_map, QUOTIENT_MAP_QUOTIENT_TOPOLOGY])

  let HOMEOMORPHIC_IMP_CONTINUOUS_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f ==> continuous_map (top,top') f"
   (SIMP_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP])

  let HOMEOMORPHIC_IMP_OPEN_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f ==> open_map (top,top') f"
   (SIMP_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP])

  let HOMEOMORPHIC_IMP_CLOSED_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f ==> closed_map (top,top') f"
   (SIMP_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP])

  let HOMEOMORPHIC_IMP_SURJECTIVE_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f
        ==> IMAGE f (topspace top) = topspace top'"
   (SIMP_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP])

  let HOMEOMORPHIC_IMP_INJECTIVE_MAP ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f
        ==> !x y. x IN topspace top /\ y IN topspace top
                  ==> (f x = f y <=> x = y)"
   (SIMP_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP])

  let BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\
        open_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y))
        ==> homeomorphic_map(top,top') f"
   (REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [homeomorphic_map] THEN
    MATCH_MP_TAC CONTINUOUS_OPEN_IMP_QUOTIENT_MAP THEN
    ASM_REWRITE_TAC [])

  let BIJECTIVE_CLOSED_IMP_HOMEOMORPHIC_MAP ← prove
   r"!top top' f:A->B.
        continuous_map (top,top') f /\
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y))
        ==> homeomorphic_map(top,top') f"
   (REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [homeomorphic_map] THEN
    MATCH_MP_TAC CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP THEN
    ASM_REWRITE_TAC [])

  let OPEN_EQ_CONTINUOUS_INVERSE_MAP ← prove
   r"!top top' (f:A->B) g.
        (!x. x IN topspace top ==> f x IN topspace top' /\ g(f x) = x) /\
        (!y. y IN topspace top' ==> g y IN topspace top /\ f(g y) = y)
        ==> (open_map (top,top') f <=> continuous_map (top',top) g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [open_map, continuous_map] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let CLOSED_EQ_CONTINUOUS_INVERSE_MAP ← prove
   r"!top top' (f:A->B) g.
        (!x. x IN topspace top ==> f x IN topspace top' /\ g(f x) = x) /\
        (!y. y IN topspace top' ==> g y IN topspace top /\ f(g y) = y)
        ==> (closed_map (top,top') f <=> continuous_map (top',top) g)"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ASM_SIMP_TAC [closed_map, CONTINUOUS_MAP_CLOSED_IN] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"closed_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_MAP ← prove
   r"!top top' (f:A->B) g.
        homeomorphic_maps(top,top') (f:A->B,g) <=>
        homeomorphic_map(top,top') f /\
        homeomorphic_map(top',top) g /\
        (!x. x IN topspace top ==> g(f x) = x) /\
        (!y. y IN topspace top' ==> f(g y) = y)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps] THEN
    EQ_TAC THENL [STRIP_TAC, MESON_TAC [HOMEOMORPHIC_IMP_CONTINUOUS_MAP]] THEN
    ASM_REWRITE_TAC [] THEN
    CONJ_TAC THEN MATCH_MP_TAC BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP THEN
    ASM_REWRITE_TAC [] THENL
     [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B",
                       ← q r"g:B->A"]
          OPEN_EQ_CONTINUOUS_INVERSE_MAP),
      MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology", ← q r"g:B->A",
                       ← q r"f:A->B"]
          OPEN_EQ_CONTINUOUS_INVERSE_MAP)] THEN
    ASM_REWRITE_TAC [] THEN REPEAT
     (FIRST_X_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_IMP_MAP ← prove
   r"!top top' (f:A->B) g.
        homeomorphic_maps (top,top') (f,g) ==> homeomorphic_map (top,top') f"
   (SIMP_TAC [HOMEOMORPHIC_MAPS_MAP])

  return { homeomorphic_map, homeomorphic_maps, HOMEOMORPHIC_MAP_EQ, HOMEOMORPHIC_MAPS_EQ,
           HOMEOMORPHIC_MAPS_SYM, HOMEOMORPHIC_MAPS_ID, HOMEOMORPHIC_MAP_ID,
           HOMEOMORPHIC_MAPS_I, HOMEOMORPHIC_MAP_I, HOMEOMORPHIC_MAP_COMPOSE,
           HOMEOMORPHIC_MAPS_COMPOSE, HOMEOMORPHIC_EQ_EVERYTHING_MAP,
           HOMEOMORPHIC_IMP_QUOTIENT_MAP, HOMEOMORPHIC_MAP_QUOTIENT_TOPOLOGY, HOMEOMORPHIC_IMP_CONTINUOUS_MAP,
           HOMEOMORPHIC_IMP_OPEN_MAP, HOMEOMORPHIC_IMP_CLOSED_MAP,
           HOMEOMORPHIC_IMP_SURJECTIVE_MAP, HOMEOMORPHIC_IMP_INJECTIVE_MAP,
           BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP, BIJECTIVE_CLOSED_IMP_HOMEOMORPHIC_MAP,
           OPEN_EQ_CONTINUOUS_INVERSE_MAP, CLOSED_EQ_CONTINUOUS_INVERSE_MAP,
           HOMEOMORPHIC_MAPS_MAP, HOMEOMORPHIC_MAPS_IMP_MAP }

/- ------------------------------------------------------------------------- -/
/- Homeomorphisms, part 2.  (metric.ml 5718-5957)                            -/
/- ------------------------------------------------------------------------- -/

structure Homeo2 where
  HOMEOMORPHIC_MAP_MAPS : thm
  HOMEOMORPHIC_MAPS_INVOLUTION : thm
  HOMEOMORPHIC_MAP_INVOLUTION : thm
  HOMEOMORPHIC_MAP_OPENNESS : thm
  HOMEOMORPHIC_MAP_CLOSEDNESS : thm
  HOMEOMORPHIC_MAP_OPENNESS_EQ : thm
  HOMEOMORPHIC_MAP_CLOSEDNESS_EQ : thm
  FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE : thm
  FORALL_CLOSED_IN_HOMEOMORPHIC_IMAGE : thm
  HOMEOMORPHIC_MAP_DERIVED_SET_OF : thm
  HOMEOMORPHIC_MAP_CLOSURE_OF : thm
  HOMEOMORPHIC_MAP_INTERIOR_OF : thm
  HOMEOMORPHIC_MAP_FRONTIER_OF : thm
  HOMEOMORPHIC_MAPS_SUBTOPOLOGIES : thm
  HOMEOMORPHIC_MAPS_SUBTOPOLOGIES_ALT : thm
  HOMEOMORPHIC_MAP_SUBTOPOLOGIES : thm
  HOMEOMORPHIC_MAP_SUBTOPOLOGIES_ALT : thm
  HOMEOMORPHIC_MAPS_PROD : thm
  HOMEOMORPHIC_MAPS_SWAP : thm
  HOMEOMORPHIC_MAP_SWAP : thm
  deriving Inhabited

@[nospecialize]
def setupHomeo2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BDerived : Derived) (BClosure : Closure) (BInterior : Interior) (BFrontier : Frontier)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1)
    (BProd1 : Prod1) (BProd2 : Prod2) (BHomeo1 : Homeo1) : ExceptT String IO Homeo2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EQ_EMPTY, FORALL_SUBSET_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMAGE_UNION, IMP_CONJ, INJECTIVE_ON_ALT, INJECTIVE_ON_LEFT_INVERSE, IN_CROSS, IN_INTER,
        LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SUBSET_DIFF, UNION_SUBSET, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, LAMBDA_PAIR, PAIR_EQ, .. } := D.core5
  let { CLOSED_IN_SUBSET, FORALL_CLOSED_IN, OPEN_IN_SUBSET, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { DERIVED_SET_OF_SUBSET_TOPSPACE, derived_set_of, .. } := BDerived
  let { CLOSURE_OF, CLOSURE_OF_SUBSET_TOPSPACE, .. } := BClosure
  let { INTERIOR_OF_CLOSURE_OF, INTERIOR_OF_SUBSET_CLOSURE_OF, .. } := BInterior
  let { frontier_of, .. } := BFrontier
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { closed_map, open_map, .. } := BOpenClosed1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { CONTINUOUS_MAP_PROD, .. } := BProd2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_IMP_CLOSED_MAP,
        HOMEOMORPHIC_IMP_INJECTIVE_MAP, HOMEOMORPHIC_IMP_OPEN_MAP,
        HOMEOMORPHIC_IMP_SURJECTIVE_MAP, HOMEOMORPHIC_MAPS_MAP, OPEN_EQ_CONTINUOUS_INVERSE_MAP,
        homeomorphic_maps, .. } := BHomeo1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let HOMEOMORPHIC_MAP_MAPS ← prove
   r"!top top' f:A->B.
     homeomorphic_map (top,top') f <=> ?g. homeomorphic_maps (top,top') (f,g)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [HOMEOMORPHIC_MAPS_MAP]] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM INJECTIVE_ON_ALT]) THEN
    REWRITE_TAC [INJECTIVE_ON_LEFT_INVERSE] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:B->A") THEN DISCH_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B",
                     ← q r"g:B->A"]
          OPEN_EQ_CONTINUOUS_INVERSE_MAP) THEN
    ASM_REWRITE_TAC [homeomorphic_maps] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_INVOLUTION ← prove
   r"!top (f:A->A).
        continuous_map(top,top) f /\ (!x. x IN topspace top ==> f(f x) = x)
        ==> homeomorphic_maps (top,top) (f,f)"
   (SIMP_TAC [homeomorphic_maps])

  let HOMEOMORPHIC_MAP_INVOLUTION ← prove
   r"!top (f:A->A).
        continuous_map(top,top) f /\ (!x. x IN topspace top ==> f(f x) = x)
        ==> homeomorphic_map (top,top) f"
   (REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN
    MESON_TAC [HOMEOMORPHIC_MAPS_INVOLUTION])

  let HOMEOMORPHIC_MAP_OPENNESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (open_in top' (IMAGE f u) <=> open_in top u)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAP_MAPS]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHIC_MAPS_MAP] THEN
    X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [HOMEOMORPHIC_IMP_OPEN_MAP, open_map]] THEN
    SUBGOAL_THEN (← q r"u = IMAGE (g:B->A) (IMAGE f u)") SUBST1_TAC THENL
     [ASM SET_TAC [], ASM_MESON_TAC [HOMEOMORPHIC_IMP_OPEN_MAP, open_map]])

  let HOMEOMORPHIC_MAP_CLOSEDNESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (closed_in top' (IMAGE f u) <=> closed_in top u)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAP_MAPS]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHIC_MAPS_MAP] THEN
    X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN EQ_TAC THENL
     [DISCH_TAC, ASM_MESON_TAC [HOMEOMORPHIC_IMP_CLOSED_MAP, closed_map]] THEN
    SUBGOAL_THEN (← q r"u = IMAGE (g:B->A) (IMAGE f u)") SUBST1_TAC THENL
     [ASM SET_TAC [], ASM_MESON_TAC [HOMEOMORPHIC_IMP_CLOSED_MAP, closed_map]])

  let HOMEOMORPHIC_MAP_OPENNESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (open_in top u <=>
             u SUBSET topspace top /\ open_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_OPENNESS, OPEN_IN_SUBSET])

  let HOMEOMORPHIC_MAP_CLOSEDNESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (closed_in top u <=>
             u SUBSET topspace top /\ closed_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_CLOSEDNESS, CLOSED_IN_SUBSET])

  let FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE ← prove
   r"!(f:A->B) top top' P.
        homeomorphic_map(top,top') f
        ==> ((!v. open_in top' v ==> P v) <=>
             (!u. open_in top u ==> P(IMAGE f u)))"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_MAP_OPENNESS, OPEN_IN_SUBSET],
      DISCH_TAC THEN X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAP_MAPS]) THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHIC_MAPS_MAP] THEN
      X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (g:B->A) v")) THEN ANTS_TAC THENL
       [ASM_MESON_TAC [HOMEOMORPHIC_MAP_OPENNESS, OPEN_IN_SUBSET],
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
        ASM SET_TAC []]])

  let FORALL_CLOSED_IN_HOMEOMORPHIC_IMAGE ← prove
   r"!(f:A->B) top top' P.
        homeomorphic_map(top,top') f
        ==> ((!v. closed_in top' v ==> P v) <=>
             (!u. closed_in top u ==> P(IMAGE f u)))"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FORALL_CLOSED_IN] THEN
    FIRST_ASSUM (fun th => tactic_of do
      pure (REWRITE_TAC [← MATCH_MP FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE th])) THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN
    ASM_CASES_TAC (← q r"open_in top (u:A->bool)") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps,
          continuous_map]) THEN
    AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_DERIVED_SET_OF ← prove
   r"!(f:A->B) top top' s.
        homeomorphic_map (top,top') f /\ s SUBSET topspace top
        ==> top' derived_set_of (IMAGE f s) = IMAGE f (top derived_set_of s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [derived_set_of] THEN MATCH_MP_TAC (← sr
     r"t = IMAGE f s /\ (!x. x IN s ==> (P x <=> Q(f x)))
      ==> {y | y IN t /\ Q y} = IMAGE f {x | x IN s /\ P x}") THEN
    CONJ_TAC THENL [ASM_MESON_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP], ALL_TAC] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← MESON [OPEN_IN_SUBSET] (← q
     r"P /\ open_in top s <=> s SUBSET topspace top /\ P /\ open_in top s")] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP) THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN FIRST_ASSUM
     (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP HOMEOMORPHIC_MAP_OPENNESS_EQ th])) THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_CLOSURE_OF ← prove
   r"!(f:A->B) top top' s.
        homeomorphic_map (top,top') f /\ s SUBSET topspace top
        ==> top' closure_of (IMAGE f s) = IMAGE f (top closure_of s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [CLOSURE_OF] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"s:A->bool") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_MAP_DERIVED_SET_OF)) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
    REWRITE_TAC [← GSYM IMAGE_UNION] THEN MATCH_MP_TAC (← sr
     r"IMAGE f u = t /\ s SUBSET u
      ==> t INTER IMAGE f s = IMAGE f (u INTER s)") THEN
    ASM_REWRITE_TAC [UNION_SUBSET, DERIVED_SET_OF_SUBSET_TOPSPACE] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_IMP_SURJECTIVE_MAP])

  let HOMEOMORPHIC_MAP_INTERIOR_OF ← prove
   r"!(f:A->B) top top' s.
        homeomorphic_map (top,top') f /\ s SUBSET topspace top
        ==> top' interior_of (IMAGE f s) = IMAGE f (top interior_of s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [INTERIOR_OF_CLOSURE_OF] THEN
    MATCH_MP_TAC (← sr
     r"(IMAGE f t = v /\ (!x y. x IN t /\ y IN t /\ f x = f y ==> x = y)) /\
      IMAGE f s = u /\ s SUBSET t
      ==> v DIFF u = IMAGE f (t DIFF s)") THEN
    CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
      ASM SET_TAC [],
      REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE]] THEN
    SUBGOAL_THEN
     (← q r"topspace top' DIFF IMAGE (f:A->B) s =
      IMAGE f (topspace top DIFF s)")
    SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
      ASM SET_TAC [],
      CONV_TAC SYM_CONV THEN MATCH_MP_TAC HOMEOMORPHIC_MAP_CLOSURE_OF THEN
      ASM_REWRITE_TAC [SUBSET_DIFF]])

  let HOMEOMORPHIC_MAP_FRONTIER_OF ← prove
   r"!(f:A->B) top top' s.
        homeomorphic_map (top,top') f /\ s SUBSET topspace top
        ==> top' frontier_of (IMAGE f s) = IMAGE f (top frontier_of s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [frontier_of] THEN MATCH_MP_TAC (← sr
     r"!u. IMAGE f s = s' /\ IMAGE f t = t' /\
          s SUBSET t /\ t SUBSET u /\
          (!x y. x IN u /\ y IN u /\ f x = f y ==> x = y)
          ==> t' DIFF s' = IMAGE f (t DIFF s)") THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    REWRITE_TAC [INTERIOR_OF_SUBSET_CLOSURE_OF] THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE] THEN REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [HOMEOMORPHIC_MAP_INTERIOR_OF],
      ASM_MESON_TAC [HOMEOMORPHIC_MAP_CLOSURE_OF],
      ASM_MESON_TAC [HOMEOMORPHIC_IMP_INJECTIVE_MAP]])

  let HOMEOMORPHIC_MAPS_SUBTOPOLOGIES ← prove
   r"!top top' (f:A->B) g s t.
        homeomorphic_maps(top,top') (f,g) /\
        IMAGE f (topspace top INTER s) = topspace top' INTER t
        ==> homeomorphic_maps(subtopology top s,subtopology top' t) (f,g)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
                  TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    REPEAT (FIRST_X_ASSUM
     (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_SUBTOPOLOGIES_ALT ← prove
   r"!top top' (f:A->B) g s t.
        homeomorphic_maps (top,top') (f,g) /\
        IMAGE f (topspace top INTER s) SUBSET t /\
        IMAGE g (topspace top' INTER t) SUBSET s
        ==> homeomorphic_maps (subtopology top s,subtopology top' t) (f,g)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_MAPS_SUBTOPOLOGIES THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_SUBTOPOLOGIES ← prove
   r"!top top' (f:A->B) s t.
        homeomorphic_map(top,top') f /\
        IMAGE f (topspace top INTER s) = topspace top' INTER t
        ==> homeomorphic_map(subtopology top s,subtopology top' t) f"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [HOMEOMORPHIC_MAPS_SUBTOPOLOGIES])

  let HOMEOMORPHIC_MAP_SUBTOPOLOGIES_ALT ← prove
   r"!top top' (f:A->B) s t.
        homeomorphic_map (top,top') f /\
        (!x. x IN topspace top /\ f x IN topspace top'
             ==> (f x IN t <=> x IN s))
        ==> homeomorphic_map (subtopology top s,subtopology top' t) f"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC HOMEOMORPHIC_MAPS_SUBTOPOLOGIES THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAPS_PROD ← prove
   r"!top1 top2 top3 top4 (f:A->B) (g:C->D) f' g'.
        homeomorphic_maps (prod_topology top1 top2,prod_topology top3 top4)
                          ((\(x,y). f x,g y),(\(x,y). f' x,g' y)) <=>
        topspace(prod_topology top1 top2) = {} /\
        topspace(prod_topology top3 top4) = {} \/
        homeomorphic_maps (top1,top3) (f,f') /\
        homeomorphic_maps (top2,top4) (g,g')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_PROD] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, FORALL_PAIR_THM, IN_CROSS] THEN
    REWRITE_TAC [CROSS_EQ_EMPTY, PAIR_EQ] THEN
    REWRITE_TAC [continuous_map] THEN SET_TAC [])

  let HOMEOMORPHIC_MAPS_SWAP ← prove
   r"!(top:A topology) (top':B topology).
        homeomorphic_maps (prod_topology top top',prod_topology top' top)
                          ((\(x,y). y,x),(\(y,x). x,y))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_PAIRED, LAMBDA_PAIR,
                 CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND])

  let HOMEOMORPHIC_MAP_SWAP ← prove
   r"!(top:A topology) (top':B topology).
        homeomorphic_map (prod_topology top top',prod_topology top' top)
                         (\(x,y). y,x)"
   (REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN
    MESON_TAC [HOMEOMORPHIC_MAPS_SWAP])

  return { HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAPS_INVOLUTION, HOMEOMORPHIC_MAP_INVOLUTION,
           HOMEOMORPHIC_MAP_OPENNESS, HOMEOMORPHIC_MAP_CLOSEDNESS, HOMEOMORPHIC_MAP_OPENNESS_EQ,
           HOMEOMORPHIC_MAP_CLOSEDNESS_EQ, FORALL_OPEN_IN_HOMEOMORPHIC_IMAGE,
           FORALL_CLOSED_IN_HOMEOMORPHIC_IMAGE, HOMEOMORPHIC_MAP_DERIVED_SET_OF,
           HOMEOMORPHIC_MAP_CLOSURE_OF, HOMEOMORPHIC_MAP_INTERIOR_OF,
           HOMEOMORPHIC_MAP_FRONTIER_OF, HOMEOMORPHIC_MAPS_SUBTOPOLOGIES,
           HOMEOMORPHIC_MAPS_SUBTOPOLOGIES_ALT, HOMEOMORPHIC_MAP_SUBTOPOLOGIES,
           HOMEOMORPHIC_MAP_SUBTOPOLOGIES_ALT, HOMEOMORPHIC_MAPS_PROD, HOMEOMORPHIC_MAPS_SWAP,
           HOMEOMORPHIC_MAP_SWAP }

/- ------------------------------------------------------------------------- -/
/- Relation of homeomorphism between topological spaces.                     -/
/- (metric.ml 5959-6190)                                                      -/
/- ------------------------------------------------------------------------- -/

structure HomeoSpace where
  homeomorphic_space : thm
  HOMEOMORPHIC_SPACE_REFL : thm
  HOMEOMORPHIC_SPACE_SYM : thm
  HOMEOMORPHIC_SPACE_TRANS : thm
  HOMEOMORPHIC_SPACE : thm
  HOMEOMORPHIC_MAPS_IMP_HOMEOMORPHIC_SPACE : thm
  HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE : thm
  HOMEOMORPHIC_SPACE_IMP_CARD_EQ : thm
  HOMEOMORPHIC_SPACE_FINITENESS : thm
  HOMEOMORPHIC_SPACE_INFINITENESS : thm
  HOMEOMORPHIC_SPACE_COUNTABILITY : thm
  HOMEOMORPHIC_EMPTY_SPACE : thm
  HOMEOMORPHIC_EMPTY_SPACE_EQ : thm
  PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT : thm
  PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT : thm
  HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING : thm
  TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT : thm
  PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT : thm
  TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT : thm
  HOMEOMORPHIC_SPACE_PROD_TOPOLOGY : thm
  HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP : thm
  HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupHomeoSpace [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BProd1 : Prod1) (BProd2 : Prod2) (BProduct1 : Product1)
    (BProduct2 : Product2) (BProduct3 : Product3) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) :
    ExceptT String IO HomeoSpace := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, parse_as_infix, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, CARTESIAN_PRODUCT_EQ_MEMBERS,
        CARTESIAN_PRODUCT_EQ_MEMBERS_EQ, EXTENSIONAL, .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMP_CONJ, INFINITE, IN_CROSS, IN_ELIM_THM, IN_SING,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_INSERT_EMPTY, NOT_IN_EMPTY,
        .. } := D.core2
  let { UNWIND_THM2, cartesian_product, eq_c, o_THM, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, LEFT_AND_EXISTS_THM, PAIR_EQ, RIGHT_AND_EXISTS_THM,
        .. } := D.core5
  let { CARD_COUNTABLE_CONG, CARD_FINITE_CONG, .. } := D.lib
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ON_EMPTY, continuous_map, .. } := BContMap1
  let { SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { QUOTIENT_MAP_FST, QUOTIENT_MAP_SND, .. } := BProd2
  let { SUBTOPOLOGY_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, OPEN_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { QUOTIENT_MAP_PRODUCT_PROJECTION, .. } := BProduct3
  let { BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP, HOMEOMORPHIC_MAPS_COMPOSE, HOMEOMORPHIC_MAPS_I,
        HOMEOMORPHIC_MAPS_SYM, homeomorphic_map, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAPS_PROD, HOMEOMORPHIC_MAPS_SWAP, HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("homeomorphic_space", (12, "right"))

  let homeomorphic_space ← new_definition
   r"(top:A topology) homeomorphic_space (top':B topology) <=>
        ?f g. homeomorphic_maps(top,top') (f,g)"

  let HOMEOMORPHIC_SPACE_REFL ← prove
   r"!top:A topology. top homeomorphic_space top"
   (REWRITE_TAC [homeomorphic_space] THEN MESON_TAC [HOMEOMORPHIC_MAPS_I])

  let HOMEOMORPHIC_SPACE_SYM ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top' <=> top' homeomorphic_space top"
   (REWRITE_TAC [homeomorphic_space] THEN MESON_TAC [HOMEOMORPHIC_MAPS_SYM])

  let HOMEOMORPHIC_SPACE_TRANS ← prove
   r"!top1:A topology top2:B topology top3:C topology.
        top1 homeomorphic_space top2 /\ top2 homeomorphic_space top3
        ==> top1 homeomorphic_space top3"
   (REWRITE_TAC [homeomorphic_space, LEFT_AND_EXISTS_THM,
                 RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_MAPS_COMPOSE) THEN MESON_TAC [])

  let HOMEOMORPHIC_SPACE ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top' <=> ?f. homeomorphic_map (top,top') f"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAP_MAPS])

  let HOMEOMORPHIC_MAPS_IMP_HOMEOMORPHIC_SPACE ← prove
   r"!top top' (f:A->B) g.
        homeomorphic_maps (top,top') (f,g) ==> top homeomorphic_space top'"
   (REWRITE_TAC [homeomorphic_space] THEN MESON_TAC [])

  let HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE ← prove
   r"!top top' f:A->B.
        homeomorphic_map (top,top') f ==> top homeomorphic_space top'"
   (REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_IMP_HOMEOMORPHIC_SPACE])

  let HOMEOMORPHIC_SPACE_IMP_CARD_EQ ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top' ==> topspace top =_c topspace top'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_space, homeomorphic_maps, continuous_map, eq_c] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])

  let HOMEOMORPHIC_SPACE_FINITENESS ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top'
        ==> (FINITE(topspace top) <=> FINITE(topspace top'))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_SPACE_IMP_CARD_EQ) THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP CARD_FINITE_CONG))

  let HOMEOMORPHIC_SPACE_INFINITENESS ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top'
        ==> (INFINITE(topspace top) <=> INFINITE(topspace top'))"
   (REWRITE_TAC [INFINITE] THEN MESON_TAC [HOMEOMORPHIC_SPACE_FINITENESS])

  let HOMEOMORPHIC_SPACE_COUNTABILITY ← prove
   r"!top:A topology top':B topology.
        top homeomorphic_space top'
        ==> (COUNTABLE(topspace top) <=> COUNTABLE(topspace top'))"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_SPACE_IMP_CARD_EQ) THEN
    DISCH_THEN (ACCEPT_TAC o MATCH_MP CARD_COUNTABLE_CONG))

  let HOMEOMORPHIC_EMPTY_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (topspace top = {} <=> topspace top' = {})"
   (REWRITE_TAC [homeomorphic_space, homeomorphic_maps, continuous_map] THEN
    SET_TAC [])

  let HOMEOMORPHIC_EMPTY_SPACE_EQ ← prove
   r"(!(top:A topology) (top':B topology).
        topspace top = {}
        ==> (top homeomorphic_space top' <=> topspace top' = {})) /\
   (!(top:A topology) (top':B topology).
        topspace top' = {}
        ==> (top homeomorphic_space top' <=> topspace top = {}))"
   (REPEAT STRIP_TAC THEN
    (EQ_TAC THENL
      [DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_EMPTY_SPACE) THEN
       ASM_REWRITE_TAC [],
       DISCH_TAC THEN REWRITE_TAC [homeomorphic_space, homeomorphic_maps] THEN
       ASM_SIMP_TAC [NOT_IN_EMPTY, CONTINUOUS_MAP_ON_EMPTY]]))

  let PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT ← prove
   r"!(top:A topology) (top':B topology) b.
        topspace top' = {b} ==> prod_topology top top' homeomorphic_space top"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    EXISTS_TAC (← q r"FST:A#B->A") THEN
    REWRITE_TAC [← GSYM HOMEOMORPHIC_MAP_MAPS, homeomorphic_map] THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP_FST, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS, PAIR_EQ] THEN
    ASM_SIMP_TAC [IN_SING])

  let PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT ← prove
   r"!(top:A topology) (top':B topology) a.
        topspace top = {a} ==> prod_topology top top' homeomorphic_space top'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    EXISTS_TAC (← q r"SND:A#B->B") THEN
    REWRITE_TAC [← GSYM HOMEOMORPHIC_MAP_MAPS, homeomorphic_map] THEN
    ASM_REWRITE_TAC [QUOTIENT_MAP_SND, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS, PAIR_EQ] THEN
    ASM_SIMP_TAC [IN_SING])

  let HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING ← prove
   r"(!top:A topology top':B topology b.
      b IN topspace top'
      ==> top homeomorphic_space (prod_topology top (subtopology top' {b}))) /\
   (!top:A topology top':B topology a.
      a IN topspace top
      ==> top' homeomorphic_space (prod_topology (subtopology top {a}) top'))"
   (REPEAT STRIP_TAC THEN ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THENL
     [MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT,
      MATCH_MP_TAC PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, ← sr
     r"a IN s ==> s INTER {a} = {a}"] THEN
    ASM_MESON_TAC [])

  let TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT ← prove
   r"!P Q R (top1:A topology) (top2:B topology).
        (!a. a IN topspace top1 /\ P(prod_topology top1 top2)
             ==> P(subtopology (prod_topology top1 top2)
                               ({a} CROSS topspace top2))) /\
        (!b. b IN topspace top2 /\ P(prod_topology top1 top2)
             ==> P(subtopology (prod_topology top1 top2)
                               (topspace top1 CROSS {b}))) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top')) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> R top'))
        ==> P(prod_topology top1 top2)
            ==> topspace(prod_topology top1 top2) = {} \/
                Q top1 /\ R top2"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN REPEAT STRIP_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"b:B")),
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"a:A"))] THEN
    ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [SUBTOPOLOGY_CROSS, SUBTOPOLOGY_TOPSPACE] THEN
    ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
    ASM_SIMP_TAC [HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING])

  let PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT ← prove
   r"!(tops:K->A topology) k i.
        i IN k /\
        (!j. j IN k /\ ~(j = i) ==> ?a. topspace(tops j) = {a})
        ==> product_topology k tops homeomorphic_space (tops i)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    EXISTS_TAC (← q r"\x:K->A. x i") THEN
    REWRITE_TAC [← GSYM HOMEOMORPHIC_MAP_MAPS, homeomorphic_map] THEN
    ASM_SIMP_TAC [QUOTIENT_MAP_PRODUCT_PROJECTION, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, o_THM] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [NOT_INSERT_EMPTY], ALL_TAC] THEN
    REPEAT STRIP_TAC THEN EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN
    MATCH_MP_TAC CARTESIAN_PRODUCT_EQ_MEMBERS THEN
    MAP_EVERY EXISTS_TAC [← q r"k:K->bool", ← q r"topspace o (tops:K->A topology)"] THEN
    ASM_REWRITE_TAC [] THEN RULE_ASSUM_TAC (REWRITE_RULE
     [cartesian_product, EXTENSIONAL, IN_ELIM_THM, o_THM]) THEN
    X_GEN_TAC (← q r"j:K") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:K")) THEN
    ASM_MESON_TAC [IN_SING])

  let TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT ← prove
   r"!P Q (tops:K->A topology) k.
        (!z i. z IN topspace(product_topology k tops) /\
               P(product_topology k tops) /\
               i IN k
               ==> P(subtopology
                       (product_topology k tops)
                       (cartesian_product k
                         (\j. if j = i then topspace(tops i) else {z j})))) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top'))
        ==> P(product_topology k tops)
            ==> topspace(product_topology k tops) = {} \/
                !i. i IN k ==> Q(tops i)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← TAUT (← q r"p \/ q <=> ~p ==> q")] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"z:K->A", ← q r"i:K"]) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    REWRITE_TAC [SUBTOPOLOGY_CARTESIAN_PRODUCT] THEN
    FIRST_ASSUM (fun th => tactic_of do
        let ith ← MATCH_MP (← REWRITE_RULE [IMP_CONJ]
           PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT) th
        pure (W (MP_TAC o PART_MATCH (lhand o rand) ith o lhand o snd))) THEN
    REWRITE_TAC [SUBTOPOLOGY_TOPSPACE] THEN DISCH_THEN MATCH_MP_TAC THEN
    X_GEN_TAC (← q r"j:K") THEN REPEAT DISCH_TAC THEN
    ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product,
      IN_ELIM_THM, o_THM]) THEN
    ASM_MESON_TAC [← sr r"a IN s ==> s INTER {a} = {a}"])

  let HOMEOMORPHIC_SPACE_PROD_TOPOLOGY ← prove
   r"!(top1:A topology) (top1':B topology) (top2:C topology) (top2':D topology).
        top1 homeomorphic_space top1' /\ top2 homeomorphic_space top2'
        ==> prod_topology top1 top2 homeomorphic_space
            prod_topology top1' top2'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space, LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, RIGHT_AND_EXISTS_THM] THEN
    REPEAT GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← MATCH_MP (← TAUT (← q
     r"(p <=> q \/ r) ==> (r ==> p)")) (← SPEC_ALL HOMEOMORPHIC_MAPS_PROD))) THEN
    MESON_TAC [])

  let HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP ← prove
   r"!(top:A topology) (top':B topology).
        (prod_topology top top') homeomorphic_space (prod_topology top' top)"
   (REWRITE_TAC [homeomorphic_space] THEN
    MESON_TAC [HOMEOMORPHIC_MAPS_SWAP])

  let HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT ← prove
   r"!(tops:K->A topology) k.
        product_topology {k} tops homeomorphic_space (tops k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN
    EXISTS_TAC (← q r"\x:K->A. x k") THEN
    MATCH_MP_TAC BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP THEN
    SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, IN_SING,
              OPEN_MAP_PRODUCT_PROJECTION] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, IMAGE_PROJECTION_CARTESIAN_PRODUCT,
                 CARTESIAN_PRODUCT_EQ_EMPTY, IN_SING, UNWIND_THM2, o_THM] THEN
    CONJ_TAC THENL [MESON_TAC [], REPEAT GEN_TAC] THEN
    DISCH_THEN (SUBST1_TAC o MATCH_MP CARTESIAN_PRODUCT_EQ_MEMBERS_EQ) THEN
    SET_TAC [])

  return { homeomorphic_space, HOMEOMORPHIC_SPACE_REFL, HOMEOMORPHIC_SPACE_SYM,
           HOMEOMORPHIC_SPACE_TRANS, HOMEOMORPHIC_SPACE,
           HOMEOMORPHIC_MAPS_IMP_HOMEOMORPHIC_SPACE, HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE,
           HOMEOMORPHIC_SPACE_IMP_CARD_EQ, HOMEOMORPHIC_SPACE_FINITENESS,
           HOMEOMORPHIC_SPACE_INFINITENESS, HOMEOMORPHIC_SPACE_COUNTABILITY,
           HOMEOMORPHIC_EMPTY_SPACE, HOMEOMORPHIC_EMPTY_SPACE_EQ,
           PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_LEFT, PROD_TOPOLOGY_HOMEOMORPHIC_SPACE_RIGHT,
           HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SING, TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT,
           PRODUCT_TOPOLOGY_HOMEOMORPHIC_COMPONENT, TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT,
           HOMEOMORPHIC_SPACE_PROD_TOPOLOGY, HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP,
           HOMEOMORPHIC_SPACE_SINGLETON_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- Embedding maps.  (metric.ml 6192-6364)                                    -/
/- ------------------------------------------------------------------------- -/

structure Embedding where
  embedding_map : thm
  EMBEDDING_MAP_EQ : thm
  EMBEDDING_MAP_COMPOSE : thm
  SURJECTIVE_EMBEDDING_MAP : thm
  EMBEDDING_MAP_IN_SUBTOPOLOGY : thm
  INJECTIVE_OPEN_IMP_EMBEDDING_MAP : thm
  INJECTIVE_CLOSED_IMP_EMBEDDING_MAP : thm
  EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE : thm
  EMBEDDING_IMP_CONTINUOUS_MAP : thm
  EMBEDDING_IMP_INJECTIVE_MAP : thm
  EMBEDDING_IMP_CLOSED_MAP : thm
  EMBEDDING_IMP_CLOSED_MAP_EQ : thm
  EMBEDDING_IMP_OPEN_MAP : thm
  EMBEDDING_IMP_OPEN_MAP_EQ : thm
  EMBEDDING_MAP_ON_EMPTY : thm
  EMBEDDING_MAP_COMPONENT_INJECTION : thm
  TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT : thm
  deriving Inhabited

@[nospecialize]
def setupEmbedding [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) (BSumTop : SumTop) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) : ExceptT String IO Embedding := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { IMAGE_CLAUSES, IMAGE_EQ, .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_IMP, INTER_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SUBSET_REFL, .. } := D.core4
  let { CONTRAPOS_THM, EQ_IMP, PAIR_EQ, .. } := D.core5
  let { CLOSED_IN_TOPSPACE, OPEN_IN_TOPSPACE, .. } := BTopology
  let { CLOSED_IN_CLOSED_SUBTOPOLOGY, OPEN_IN_OPEN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
        SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ON_EMPTY, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_MAP_INTO_SUBTOPOLOGY, OPEN_MAP_INTO_SUBTOPOLOGY, closed_map, open_map,
        .. } := BOpenClosed1
  let { quotient_map, .. } := BQuotient
  let { CLOSED_MAP_COMPONENT_INJECTION, CONTINUOUS_MAP_COMPONENT_INJECTION,
        OPEN_MAP_COMPONENT_INJECTION, .. } := BSumTop
  let { BIJECTIVE_CLOSED_IMP_HOMEOMORPHIC_MAP, BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP,
        HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_IMP_CLOSED_MAP,
        HOMEOMORPHIC_IMP_CONTINUOUS_MAP, HOMEOMORPHIC_IMP_INJECTIVE_MAP,
        HOMEOMORPHIC_IMP_OPEN_MAP, HOMEOMORPHIC_IMP_SURJECTIVE_MAP, HOMEOMORPHIC_MAP_COMPOSE,
        HOMEOMORPHIC_MAP_EQ, homeomorphic_map, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let embedding_map ← new_definition
   r"embedding_map (top,top') (f:A->B) <=>
        homeomorphic_map (top,subtopology top' (IMAGE f (topspace top))) f"

  let EMBEDDING_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ embedding_map (top,top') f
        ==> embedding_map (top,top') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [embedding_map] THEN
    MESON_TAC [IMAGE_EQ, HOMEOMORPHIC_MAP_EQ])

  let EMBEDDING_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        embedding_map(top,top') f /\ embedding_map(top',top'') g
        ==> embedding_map(top,top'') (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [embedding_map] THEN DISCH_TAC THEN
    MATCH_MP_TAC HOMEOMORPHIC_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"subtopology top' (IMAGE (f:A->B) (topspace top))") THEN
    ASM_REWRITE_TAC [] THEN FIRST_ASSUM (MP_TAC o
     SPECL [← q r"IMAGE (f:A->B) (topspace top)",
            ← q r"IMAGE (g:B->C) (IMAGE (f:A->B) (topspace top))"] o
     MATCH_MP (← REWRITE_RULE [IMP_CONJ] HOMEOMORPHIC_MAP_SUBTOPOLOGIES) o
     CONJUNCT2) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN (MP_TAC o
      MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP)) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    DISCH_TAC THEN DISCH_TAC THEN REWRITE_TAC [IMAGE_o] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC EQ_IMP] THEN
    AP_THM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN AP_TERM_TAC THEN
    ASM SET_TAC [])

  let SURJECTIVE_EMBEDDING_MAP ← prove
   r"!top top' f:A->B.
      embedding_map (top,top') f /\ IMAGE f (topspace top) = topspace top' <=>
      homeomorphic_map (top,top') f"
   (REWRITE_TAC [embedding_map, HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN
    MESON_TAC [SUBTOPOLOGY_TOPSPACE])

  let EMBEDDING_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s f:A->B.
         embedding_map (top,subtopology top' s) f <=>
         embedding_map (top,top') f /\ IMAGE f (topspace top) SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [embedding_map, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"IMAGE (f:A->B) (topspace top) SUBSET s") THEN
    ASM_SIMP_TAC [← sr r"t SUBSET s ==> s INTER t = t"] THEN
    POP_ASSUM MP_TAC THEN REWRITE_TAC [CONTRAPOS_THM] THEN
    REWRITE_TAC [homeomorphic_map, quotient_map, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  let INJECTIVE_OPEN_IMP_EMBEDDING_MAP ← prove
   r"!top top' (f:A->B).
           continuous_map (top,top') f /\
           open_map (top,top') f /\
           (!x y. x IN topspace top /\ y IN topspace top
                  ==> (f x = f y <=> x = y))
           ==> embedding_map (top,top') f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [embedding_map] THEN
    MATCH_MP_TAC BIJECTIVE_OPEN_IMP_HOMEOMORPHIC_MAP THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    ASM_SIMP_TAC [OPEN_MAP_INTO_SUBTOPOLOGY, SUBSET_REFL] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let INJECTIVE_CLOSED_IMP_EMBEDDING_MAP ← prove
   r"!top top' (f:A->B).
           continuous_map (top,top') f /\
           closed_map (top,top') f /\
           (!x y. x IN topspace top /\ y IN topspace top
                  ==> (f x = f y <=> x = y))
           ==> embedding_map (top,top') f"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [embedding_map] THEN
    MATCH_MP_TAC BIJECTIVE_CLOSED_IMP_HOMEOMORPHIC_MAP THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    ASM_SIMP_TAC [CLOSED_MAP_INTO_SUBTOPOLOGY, SUBSET_REFL] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE ← prove
   r"!top top' f:A->B.
      embedding_map (top,top') f
      ==> top homeomorphic_space (subtopology top' (IMAGE f (topspace top)))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [embedding_map] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_IMP_HOMEOMORPHIC_SPACE])

  let EMBEDDING_IMP_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B).
     embedding_map(top,top') f ==> continuous_map(top,top') f"
   (MESON_TAC [embedding_map, HOMEOMORPHIC_IMP_CONTINUOUS_MAP,
               CONTINUOUS_MAP_IN_SUBTOPOLOGY])

  let EMBEDDING_IMP_INJECTIVE_MAP ← prove
   r"!top top' (f:A->B).
     embedding_map(top,top') f
     ==> !x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y)"
   (MESON_TAC [embedding_map, HOMEOMORPHIC_IMP_INJECTIVE_MAP,
               CONTINUOUS_MAP_IN_SUBTOPOLOGY])

  let EMBEDDING_IMP_CLOSED_MAP ← prove
   r"!top top' (f:A->B).
        embedding_map(top,top') f /\ closed_in top' (IMAGE f (topspace top))
        ==> closed_map(top,top') f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closed_map] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [embedding_map]) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CLOSED_MAP) THEN
    REWRITE_TAC [closed_map] THEN DISCH_THEN (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_SIMP_TAC [CLOSED_IN_CLOSED_SUBTOPOLOGY])

  let EMBEDDING_IMP_CLOSED_MAP_EQ ← prove
   r"!top top' (f:A->B).
     embedding_map(top,top') f
     ==> (closed_map(top,top') f <=> closed_in top' (IMAGE f (topspace top)))"
   (MESON_TAC [EMBEDDING_IMP_CLOSED_MAP, closed_map, CLOSED_IN_TOPSPACE])

  let EMBEDDING_IMP_OPEN_MAP ← prove
   r"!top top' (f:A->B).
        embedding_map(top,top') f /\ open_in top' (IMAGE f (topspace top))
        ==> open_map(top,top') f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [open_map] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [embedding_map]) THEN
    DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_OPEN_MAP) THEN
    REWRITE_TAC [open_map] THEN DISCH_THEN (MP_TAC o SPEC (← q r"u:A->bool")) THEN
    ASM_SIMP_TAC [OPEN_IN_OPEN_SUBTOPOLOGY])

  let EMBEDDING_IMP_OPEN_MAP_EQ ← prove
   r"!top top' (f:A->B).
      embedding_map(top,top') f
      ==> (open_map(top,top') f <=> open_in top' (IMAGE f (topspace top)))"
   (MESON_TAC [EMBEDDING_IMP_OPEN_MAP, open_map, OPEN_IN_TOPSPACE])

  let EMBEDDING_MAP_ON_EMPTY ← prove
   r"!top top' (f:A->B). topspace top = {} ==> embedding_map(top,top') f"
   (SIMP_TAC [embedding_map, IMAGE_CLAUSES, HOMEOMORPHIC_MAP_MAPS,
              homeomorphic_maps, CONTINUOUS_MAP_ON_EMPTY, TOPSPACE_SUBTOPOLOGY,
              INTER_EMPTY, NOT_IN_EMPTY])

  let EMBEDDING_MAP_COMPONENT_INJECTION ← prove
   r"!k (top:K->A topology) i.
        i IN k ==> embedding_map(top i,sum_topology k top) (\x. (i,x))"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC INJECTIVE_OPEN_IMP_EMBEDDING_MAP THEN
    ASM_SIMP_TAC [OPEN_MAP_COMPONENT_INJECTION, PAIR_EQ,
                  CONTINUOUS_MAP_COMPONENT_INJECTION])

  let TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT ← prove
   r"!P Q (tops:K->A topology) k.
        (!top s. P top /\ closed_in top s /\ open_in top s
                 ==> P(subtopology top s)) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top'))
        ==> P(sum_topology k tops) ==> !i. i IN k ==> Q(tops i)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"sum_topology k (tops:K->A topology)",
      ← q r"IMAGE (\x:A. (i:K),x) (topspace(tops i))"]) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [MATCH_MP_TAC (← REWRITE_RULE [closed_map, RIGHT_IMP_FORALL_THM, IMP_IMP]
          CLOSED_MAP_COMPONENT_INJECTION) THEN
        ASM_REWRITE_TAC [CLOSED_IN_TOPSPACE],
        MATCH_MP_TAC (← REWRITE_RULE [open_map, RIGHT_IMP_FORALL_THM, IMP_IMP]
          OPEN_MAP_COMPONENT_INJECTION) THEN
        ASM_REWRITE_TAC [OPEN_IN_TOPSPACE]],
      MATCH_MP_TAC EQ_IMP THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      MATCH_MP_TAC EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE THEN
      ASM_SIMP_TAC [EMBEDDING_MAP_COMPONENT_INJECTION]])

  return { embedding_map, EMBEDDING_MAP_EQ, EMBEDDING_MAP_COMPOSE, SURJECTIVE_EMBEDDING_MAP,
           EMBEDDING_MAP_IN_SUBTOPOLOGY, INJECTIVE_OPEN_IMP_EMBEDDING_MAP,
           INJECTIVE_CLOSED_IMP_EMBEDDING_MAP, EMBEDDING_MAP_IMP_HOMEOMORPHIC_SPACE,
           EMBEDDING_IMP_CONTINUOUS_MAP, EMBEDDING_IMP_INJECTIVE_MAP, EMBEDDING_IMP_CLOSED_MAP,
           EMBEDDING_IMP_CLOSED_MAP_EQ, EMBEDDING_IMP_OPEN_MAP, EMBEDDING_IMP_OPEN_MAP_EQ,
           EMBEDDING_MAP_ON_EMPTY, EMBEDDING_MAP_COMPONENT_INJECTION,
           TOPOLOGICAL_PROPERTY_OF_SUM_COMPONENT }

/- ------------------------------------------------------------------------- -/
/- Retraction and section maps (having 1-sided inverses).                    -/
/- (metric.ml 6366-6655)                                                      -/
/- ------------------------------------------------------------------------- -/

structure Retraction where
  retraction_maps : thm
  section_map : thm
  retraction_map : thm
  RETRACTION_IMP_CONTINUOUS_MAP : thm
  SECTION_IMP_CONTINUOUS_MAP : thm
  RETRACTION_MAPS_EQ : thm
  SECTION_MAP_EQ : thm
  RETRACTION_MAP_EQ : thm
  HOMEOMORPHIC_IMP_RETRACTION_MAPS : thm
  SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP : thm
  HOMEOMORPHIC_IMP_RETRACTION_MAP : thm
  HOMEOMORPHIC_IMP_SECTION_MAP : thm
  SECTION_IMP_EMBEDDING_MAP : thm
  RETRACTION_IMP_QUOTIENT_MAP : thm
  RETRACTION_MAPS_COMPOSE : thm
  RETRACTION_MAP_COMPOSE : thm
  SECTION_MAP_COMPOSE : thm
  SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP : thm
  SURJECTIVE_RETRACTION_OR_SECTION_MAP : thm
  RETRACTION_IMP_SURJECTIVE_MAP : thm
  SECTION_IMP_INJECTIVE_MAP : thm
  RETRACTION_MAPS_TO_RETRACT_MAPS : thm
  EMBEDDING_EQ_SECTION_MAP : thm
  RETRACTION_MAP_INTO_SUBTOPOLOGY : thm
  RETRACTION_MAPS_SUBTOPOLOGIES : thm
  RETRACTION_MAP_FST : thm
  RETRACTION_MAP_SND : thm
  RETRACTION_MAP_PRODUCT_PROJECTION : thm
  DISCRETE_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_DISCRETE_SPACE : thm
  HOMEOMORPHIC_DISCRETE_SPACES : thm
  deriving Inhabited

@[nospecialize]
def setupRetraction [HolBase] (D : MetricDeps) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BQuotient : Quotient) (BProd1 : Prod1) (BProduct1 : Product1) (BProduct2 : Product2)
    (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding) :
    ExceptT String IO Retraction := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, CROSS_EMPTY, EXTENSIONAL, FORALL_IN_IMAGE, .. } := D.core1
  let { IMAGE_SUBSET, IMAGE_o, IMP_CONJ_ALT, IN_ELIM_THM, IN_INTER, I_DEF, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, MONO_EXISTS, .. } := D.core2
  let { SUBSET, SUBSET_REFL, cartesian_product, o_THM, .. } := D.core4
  let { EQ_IMP, LEFT_AND_EXISTS_THM, .. } := D.core5
  let { EQ_C_BIJECTIONS, .. } := D.lib
  let { FORALL_DISCRETE_SPACES, .. } := BDiscrete
  let { TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE,
        CONTINUOUS_MAP_ON_EMPTY, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_EQ, CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY,
        CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { DISCRETE_SPACE_QUOTIENT_MAP_IMAGE, quotient_map, .. } := BQuotient
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { HOMEOMORPHIC_MAPS_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { homeomorphic_space, .. } := BHomeoSpace
  let { SURJECTIVE_EMBEDDING_MAP, embedding_map, .. } := BEmbedding
  -- @@SCOPE END

  let retraction_maps ← new_definition
   r"retraction_maps (top,top') (f:A->B,g) <=>
        continuous_map(top,top') f /\
        continuous_map(top',top) g /\
        (!x. x IN topspace top' ==> f(g x) = x)"

  let section_map ← new_definition
   r"section_map (top,top') (f:A->B) <=>
    ?g. retraction_maps (top',top) (g,f)"

  let retraction_map ← new_definition
   r"retraction_map (top,top') (f:A->B) <=>
    ?g. retraction_maps (top,top') (f,g)"

  let RETRACTION_IMP_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B).
        retraction_map (top,top') f ==> continuous_map(top,top') f"
   (REWRITE_TAC [retraction_map, retraction_maps] THEN MESON_TAC [])

  let SECTION_IMP_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B).
        section_map (top,top') f ==> continuous_map(top,top') f"
   (REWRITE_TAC [section_map, retraction_maps] THEN MESON_TAC [])

  let RETRACTION_MAPS_EQ ← prove
   r"!top top' f (f':A->B) g g'.
        (!x. x IN topspace top ==> f x = f' x) /\
        (!x. x IN topspace top' ==> g x = g' x) /\
        retraction_maps (top,top') (f,g)
        ==> retraction_maps (top,top') (f',g')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retraction_maps] THEN STRIP_TAC THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [CONTINUOUS_MAP_EQ], ALL_TAC] THEN
    REPEAT (FIRST_X_ASSUM
     (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
    ASM SET_TAC [])

  let SECTION_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ section_map (top,top') f
        ==> section_map (top,top') g"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [section_map] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [RETRACTION_MAPS_EQ])

  let RETRACTION_MAP_EQ ← prove
   r"!top top' f g:A->B.
        (!x. x IN topspace top ==> f x = g x) /\ retraction_map (top,top') f
        ==> retraction_map (top,top') g"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [retraction_map] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [RETRACTION_MAPS_EQ])

  let HOMEOMORPHIC_IMP_RETRACTION_MAPS ← prove
   r"!top top' (f:A->B) g.
    homeomorphic_maps(top,top') (f,g) ==> retraction_maps (top,top') (f,g)"
   (REWRITE_TAC [homeomorphic_maps, retraction_maps] THEN MESON_TAC [])

  let SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP ← prove
   r"!top top' (f:A->B).
        section_map (top,top') f /\ retraction_map (top,top') f <=>
        homeomorphic_map (top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [section_map, retraction_map, HOMEOMORPHIC_MAP_MAPS] THEN
    REWRITE_TAC [retraction_maps, homeomorphic_maps] THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"g:B->A") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"h:B->A") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"g:B->A") THEN ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_IMP_RETRACTION_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f ==> retraction_map (top,top') f"
   (SIMP_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP])

  let HOMEOMORPHIC_IMP_SECTION_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f ==> section_map (top,top') f"
   (SIMP_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP])

  let SECTION_IMP_EMBEDDING_MAP ← prove
   r"!top top' (f:A->B).
        section_map(top,top') f ==> embedding_map(top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [section_map, embedding_map, HOMEOMORPHIC_MAP_MAPS] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"g:B->A") THEN
    REWRITE_TAC [retraction_maps, homeomorphic_maps] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IMP_CONJ_ALT] THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE])

  let RETRACTION_IMP_QUOTIENT_MAP ← prove
   r"!top top' (f:A->B).
        retraction_map(top,top') f ==> quotient_map(top,top') f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [retraction_map, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN
    REWRITE_TAC [retraction_maps, quotient_map, continuous_map] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"v:B->bool") THEN DISCH_TAC THEN
    EQ_TAC THEN ASM_REWRITE_TAC [] THEN DISCH_TAC THEN FIRST_X_ASSUM
     (MP_TAC o SPEC (← q r"{x | x IN topspace top /\ (f:A->B) x IN v}")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let RETRACTION_MAPS_COMPOSE ← prove
   r"!top1 top2 top3 (f:A->B) (g:B->C) f' g'.
        retraction_maps (top1,top2) (f,f') /\
        retraction_maps (top2,top3) (g,g')
        ==> retraction_maps (top1,top3) (g o f,f' o g')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retraction_maps, o_THM, CONJ_ASSOC] THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE],
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC []])

  let RETRACTION_MAP_COMPOSE ← prove
   r"!top1 top2 top3 (f:A->B) (g:B->C).
        retraction_map (top1,top2) f /\
        retraction_map (top2,top3) g
        ==> retraction_map (top1,top3) (g o f)"
   (REWRITE_TAC [retraction_map] THEN MESON_TAC [RETRACTION_MAPS_COMPOSE])

  let SECTION_MAP_COMPOSE ← prove
   r"!top1 top2 top3 (f:A->B) (g:B->C).
        section_map (top1,top2) f /\
        section_map (top2,top3) g
        ==> section_map (top1,top3) (g o f)"
   (REWRITE_TAC [section_map] THEN MESON_TAC [RETRACTION_MAPS_COMPOSE])

  let SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP ← prove
   r"!top top' (f:A->B).
        section_map(top,top') f /\ IMAGE f (topspace top) = topspace top' <=>
        homeomorphic_map (top,top') f"
   (MESON_TAC [SURJECTIVE_EMBEDDING_MAP, SECTION_IMP_EMBEDDING_MAP,
               SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP])

  let SURJECTIVE_RETRACTION_OR_SECTION_MAP ← prove
   r"!top top' (f:A->B).
        IMAGE f (topspace top) = topspace top'
        ==> (retraction_map(top,top') f \/ section_map(top,top') f <=>
             retraction_map(top,top') f)"
   (MESON_TAC [SURJECTIVE_EMBEDDING_MAP, SECTION_IMP_EMBEDDING_MAP,
               SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP])

  let RETRACTION_IMP_SURJECTIVE_MAP ← prove
   r"!top top' (f:A->B).
        retraction_map(top,top') f ==> IMAGE f (topspace top) = topspace top'"
   (REWRITE_TAC [retraction_map, retraction_maps, continuous_map] THEN
    SET_TAC [])

  let SECTION_IMP_INJECTIVE_MAP ← prove
   r"!top top' (f:A->B).
        section_map(top,top') f
        ==> (!x y. x IN topspace top /\ y IN topspace top
                   ==> (f x = f y <=> x = y))"
   (REWRITE_TAC [section_map, retraction_maps] THEN SET_TAC [])

  let RETRACTION_MAPS_TO_RETRACT_MAPS ← prove
   r"!top top' (r:A->B) s.
        retraction_maps(top,top') (r,s)
        ==> retraction_maps (top,subtopology top (IMAGE s (topspace top')))
                            (s o r,I)"
   (REWRITE_TAC [retraction_maps] THEN
    SIMP_TAC [I_DEF, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET, o_THM,
              CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, IMAGE_o, IMAGE_SUBSET] THEN
    SIMP_TAC [FORALL_IN_IMAGE] THEN MESON_TAC [CONTINUOUS_MAP_COMPOSE])

  let EMBEDDING_EQ_SECTION_MAP ← prove
   r"!top top' (f:A->B).
        embedding_map(top,top') f <=>
        section_map(top,subtopology top' (IMAGE f (topspace top))) f"
   (REWRITE_TAC [embedding_map, section_map, HOMEOMORPHIC_MAP_MAPS] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_maps, retraction_maps] THEN
    AP_TERM_TAC THEN ABS_TAC THEN REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  let RETRACTION_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top top' t (r:A->B).
        retraction_map(top,top') r /\ IMAGE r (topspace top) SUBSET t
        ==> retraction_map(top,subtopology top' t) r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retraction_map, LEFT_AND_EXISTS_THM] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r':B->A") THEN
    SIMP_TAC [retraction_maps, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, IN_INTER])

  let RETRACTION_MAPS_SUBTOPOLOGIES ← prove
   r"!top top' s t (r:A->B) r'.
        retraction_maps(top,top') (r,r') /\
        IMAGE r s SUBSET t /\ IMAGE r' t SUBSET s
        ==> retraction_maps(subtopology top s,subtopology top' t) (r,r')"
   (REWRITE_TAC [retraction_maps] THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY,
              TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    REWRITE_TAC [continuous_map] THEN SET_TAC [])

  let RETRACTION_MAP_FST ← prove
   r"!(top1:A topology) (top2:B topology).
        retraction_map (prod_topology top1 top2,top1) FST <=>
        topspace top2 = {} ==> topspace top1 = {}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top2:B->bool = {}") THEN
    ASM_REWRITE_TAC [retraction_map, retraction_maps] THENL
     [EQ_TAC THENL
       [DISCH_THEN (CHOOSE_THEN (MP_TAC o MATCH_MP
         CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE o CONJUNCT1 o CONJUNCT2)) THEN
        ASM_REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, CROSS_EMPTY] THEN SET_TAC [],
        DISCH_TAC],
        FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"b:B") o
          REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY])] THEN
    EXISTS_TAC (← q r"(\x. x,b):A->A#B") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST])

  let RETRACTION_MAP_SND ← prove
   r"!(top1:A topology) (top2:B topology).
        retraction_map (prod_topology top1 top2,top2) SND <=>
        topspace top1 = {} ==> topspace top2 = {}"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top1:A->bool = {}") THEN
    ASM_REWRITE_TAC [retraction_map, retraction_maps] THENL
     [EQ_TAC THENL
       [DISCH_THEN (CHOOSE_THEN (MP_TAC o MATCH_MP
         CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE o CONJUNCT1 o CONJUNCT2)) THEN
        ASM_REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, CROSS_EMPTY] THEN SET_TAC [],
        DISCH_TAC],
        FIRST_X_ASSUM (X_CHOOSE_TAC (← q r"a:A") o
          REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY])] THEN
    EXISTS_TAC (← q r"(\y. a,y):B->A#B") THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_SND, CONTINUOUS_MAP_PAIRED] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST])

  let RETRACTION_MAP_PRODUCT_PROJECTION ← prove
   r"!k (tops:K->A topology) i.
        i IN k
        ==> (retraction_map (product_topology k tops,tops i) (\x. x i) <=>
             topspace (product_topology k tops) = {}
             ==> topspace (tops i) = {})"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP RETRACTION_IMP_SURJECTIVE_MAP) THEN SET_TAC [],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"topspace (product_topology k (tops:K->A topology)) = {}") THEN
    ASM_REWRITE_TAC [] THENL
     [DISCH_TAC,
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A"))] THEN
    REWRITE_TAC [retraction_map, retraction_maps] THEN
    EXISTS_TAC (← q r"\x j. if j = i then x else (z:K->A) j") THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION, CONTINUOUS_MAP_ON_EMPTY] THEN
    REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN CONJ_TAC THENL
     [ALL_TAC,
      X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"j:K = i") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST]] THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE RAND_CONV [TOPSPACE_PRODUCT_TOPOLOGY]) THEN
    REWRITE_TAC [cartesian_product, SUBSET, FORALL_IN_IMAGE] THEN
    REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM, o_THM] THEN ASM_MESON_TAC [])

  let DISCRETE_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map (top,top') r /\ discrete_space top
        ==> discrete_space top'"
   (MESON_TAC [RETRACTION_IMP_QUOTIENT_MAP, DISCRETE_SPACE_QUOTIENT_MAP_IMAGE])

  let HOMEOMORPHIC_DISCRETE_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (discrete_space top <=> discrete_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    MESON_TAC [DISCRETE_SPACE_RETRACTION_MAP_IMAGE])

  let HOMEOMORPHIC_DISCRETE_SPACES ← prove
   r"!(top:A topology) (top':B topology).
        discrete_space top /\ discrete_space top'
        ==> (top homeomorphic_space top' <=>
             topspace top =_c topspace top')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [homeomorphic_space, homeomorphic_maps] THEN
    ASM_SIMP_TAC [← REWRITE_RULE [← GSYM FORALL_DISCRETE_SPACES]
          CONTINUOUS_MAP_FROM_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [EQ_C_BIJECTIONS] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [])

  return { retraction_maps, section_map, retraction_map, RETRACTION_IMP_CONTINUOUS_MAP,
           SECTION_IMP_CONTINUOUS_MAP, RETRACTION_MAPS_EQ, SECTION_MAP_EQ, RETRACTION_MAP_EQ,
           HOMEOMORPHIC_IMP_RETRACTION_MAPS, SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP,
           HOMEOMORPHIC_IMP_RETRACTION_MAP, HOMEOMORPHIC_IMP_SECTION_MAP,
           SECTION_IMP_EMBEDDING_MAP, RETRACTION_IMP_QUOTIENT_MAP, RETRACTION_MAPS_COMPOSE,
           RETRACTION_MAP_COMPOSE, SECTION_MAP_COMPOSE, SURJECTIVE_SECTION_EQ_HOMEOMORPHIC_MAP,
           SURJECTIVE_RETRACTION_OR_SECTION_MAP, RETRACTION_IMP_SURJECTIVE_MAP,
           SECTION_IMP_INJECTIVE_MAP, RETRACTION_MAPS_TO_RETRACT_MAPS, EMBEDDING_EQ_SECTION_MAP,
           RETRACTION_MAP_INTO_SUBTOPOLOGY, RETRACTION_MAPS_SUBTOPOLOGIES, RETRACTION_MAP_FST,
           RETRACTION_MAP_SND, RETRACTION_MAP_PRODUCT_PROJECTION,
           DISCRETE_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_DISCRETE_SPACE,
           HOMEOMORPHIC_DISCRETE_SPACES }

/- ------------------------------------------------------------------------- -/
/- When a subset is a retract of a topological space.  (metric.ml 6657-6802) -/
/- ------------------------------------------------------------------------- -/

structure RetractOf where
  retract_of_space : thm
  RETRACT_OF_SPACE_RETRACTION_MAPS : thm
  RETRACT_OF_SPACE_SECTION_MAP : thm
  RETRACT_OF_SPACE_IMP_SUBSET : thm
  RETRACT_OF_SPACE_TOPSPACE : thm
  RETRACT_OF_SPACE_EMPTY : thm
  RETRACT_OF_SPACE_IMP_NONEMPTY : thm
  RETRACT_OF_SPACE_SING : thm
  RETRACT_OF_SPACE_TRANS : thm
  RETRACT_OF_SPACE_SUBTOPOLOGY : thm
  RETRACT_OF_SPACE_CLOPEN : thm
  RETRACT_OF_SPACE_DISJOINT_UNION : thm
  RETRACTION_MAPS_SECTION_IMAGE : thm
  HEREDITARY_IMP_RETRACTIVE_PROPERTY : thm
  deriving Inhabited

@[nospecialize]
def setupRetractOf [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BFrontier : Frontier) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BHomeoSpace : HomeoSpace) (BEmbedding : Embedding)
    (BRetraction : Retraction) : ExceptT String IO RetractOf := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, parse_as_infix,
        .. } := D
  let { EMPTY_SUBSET, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IN_GSPEC, IN_INTER, IN_SING, I_DEF, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY,
        NOT_IN_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_EMPTY, SUBSET_INTER, SUBSET_REFL, .. } := D.core4
  let { I_O_ID, .. } := D.core5
  let { OPEN_IN_SUBSET, closed_in, .. } := BTopology
  let { SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { FRONTIER_OF_EQ_EMPTY, .. } := BFrontier
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_CASES, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, .. } := BHomeoSpace
  let { embedding_map, .. } := BEmbedding
  let { RETRACTION_MAPS_COMPOSE, RETRACTION_MAPS_TO_RETRACT_MAPS, SECTION_IMP_EMBEDDING_MAP,
        retraction_map, retraction_maps, section_map, .. } := BRetraction
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  parse_as_infix ("retract_of_space", (12, "right"))

  let retract_of_space ← new_definition
   r"(s:A->bool) retract_of_space top <=>
        s SUBSET topspace top /\
        ?r. continuous_map(top,subtopology top s) r /\
            !x. x IN s ==> r x = x"

  let RETRACT_OF_SPACE_RETRACTION_MAPS ← prove
   r"!top s:A->bool.
        s retract_of_space top <=>
        s SUBSET topspace top /\
        ?r. retraction_maps (top,subtopology top s) (r,I)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [retract_of_space, retraction_maps] THEN
    SIMP_TAC [I_DEF, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [])

  let RETRACT_OF_SPACE_SECTION_MAP ← prove
   r"!top s:A->bool.
        s retract_of_space top <=>
        s SUBSET topspace top /\ section_map (subtopology top s,top) (\x. x)"
   (REWRITE_TAC [retract_of_space, section_map, retraction_maps] THEN
    SIMP_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET, IN_INTER] THEN MESON_TAC [])

  let RETRACT_OF_SPACE_IMP_SUBSET ← prove
   r"!top s:A->bool. s retract_of_space top ==> s SUBSET topspace top"
   (SIMP_TAC [retract_of_space])

  let RETRACT_OF_SPACE_TOPSPACE ← prove
   r"!top:A topology. topspace top retract_of_space top"
   (GEN_TAC THEN
    REWRITE_TAC [retract_of_space, SUBTOPOLOGY_TOPSPACE, SUBSET_REFL] THEN
    EXISTS_TAC (← q r"\x:A. x") THEN
    REWRITE_TAC [CONTINUOUS_MAP_ID])

  let RETRACT_OF_SPACE_EMPTY ← prove
   r"!top:A topology. {} retract_of_space top <=> topspace top = {}"
   (GEN_TAC THEN EQ_TAC THENL
     [ALL_TAC, MESON_TAC [RETRACT_OF_SPACE_TOPSPACE]] THEN
    REWRITE_TAC [retract_of_space, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [EMPTY_SUBSET, SUBSET_EMPTY, IMAGE_EQ_EMPTY] THEN SET_TAC [])

  let RETRACT_OF_SPACE_IMP_NONEMPTY ← prove
   r"!top s:A->bool.
        s retract_of_space top /\ ~(topspace top = {}) ==> ~(s = {})"
   (MESON_TAC [RETRACT_OF_SPACE_EMPTY])

  let RETRACT_OF_SPACE_SING ← prove
   r"!top a:A. {a} retract_of_space top <=> a IN topspace top"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    REWRITE_TAC [← GSYM SING_SUBSET, RETRACT_OF_SPACE_IMP_SUBSET] THEN
    SIMP_TAC [SING_SUBSET, retract_of_space, IN_SING] THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(\x. a):A->A") THEN
    REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, CONTINUOUS_MAP_CONST] THEN
    ASM_REWRITE_TAC [] THEN SET_TAC [])

  let RETRACT_OF_SPACE_TRANS ← prove
   r"!top s t:A->bool.
        s retract_of_space top /\ t retract_of_space (subtopology top s)
        ==> t retract_of_space top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [RETRACT_OF_SPACE_RETRACTION_MAPS] THEN
    REWRITE_TAC [SUBSET_INTER, TOPSPACE_SUBTOPOLOGY] THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC MP_TAC)) THEN
    ASM_REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, LEFT_IMP_EXISTS_THM] THEN
    ASM_SIMP_TAC [← sr r"t SUBSET s ==> s INTER t = t"] THEN
    X_GEN_TAC (← q r"r2:A->A") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"r1:A->A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"(r2:A->A) o (r1:A->A)") THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM I_O_ID] THEN
    MATCH_MP_TAC RETRACTION_MAPS_COMPOSE THEN ASM_MESON_TAC [])

  let RETRACT_OF_SPACE_SUBTOPOLOGY ← prove
   r"!top s u:A->bool.
        s retract_of_space top /\ s SUBSET u
        ==> s retract_of_space (subtopology top u)"
   (REPEAT GEN_TAC THEN
    SIMP_TAC [retract_of_space, SUBTOPOLOGY_SUBTOPOLOGY,
              TOPSPACE_SUBTOPOLOGY, SUBSET_INTER,
              ← sr r"s SUBSET u ==> u INTER s = s"] THEN
    MESON_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY])

  let RETRACT_OF_SPACE_CLOPEN ← prove
   r"!top s:A->bool.
        open_in top s /\ closed_in top s /\ (s = {} ==> topspace top = {})
        ==> s retract_of_space top"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_SIMP_TAC [RETRACT_OF_SPACE_EMPTY] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    REWRITE_TAC [retract_of_space] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"a:A")) THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"\x:A. if x IN s then x else a") THEN
    SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    MATCH_MP_TAC CONTINUOUS_MAP_CASES THEN
    ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_CONST,
                  CONTINUOUS_MAP_ID, IN_GSPEC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC (← MESON [NOT_IN_EMPTY] (← q r"s = {} ==> !x. x IN s ==> P x")) THEN
    ASM_SIMP_TAC [FRONTIER_OF_EQ_EMPTY])

  let RETRACT_OF_SPACE_DISJOINT_UNION ← prove
   r"!top s t:A->bool.
     open_in top s /\ open_in top t /\ DISJOINT s t /\
     s UNION t = topspace top /\
     (s = {} ==> topspace top = {})
     ==> s retract_of_space top"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC RETRACT_OF_SPACE_CLOPEN THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [closed_in] THEN
    ASM_CASES_TAC (← q r"topspace top DIFF s:A->bool = t") THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let RETRACTION_MAPS_SECTION_IMAGE ← prove
   r"!top top' (r:A->B) s.
        retraction_maps(top,top') (r,s)
        ==> IMAGE s (topspace top') retract_of_space top /\
            subtopology top (IMAGE s (topspace top')) homeomorphic_space top'"
   (REWRITE_TAC [RETRACT_OF_SPACE_SECTION_MAP] THEN REPEAT STRIP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [retraction_maps, continuous_map]) THEN
      ASM SET_TAC [],
      REWRITE_TAC [section_map] THEN EXISTS_TAC (← q r"(s:B->A) o (r:A->B)") THEN
      ASM_SIMP_TAC [← GSYM I_DEF, RETRACTION_MAPS_TO_RETRACT_MAPS],
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN EXISTS_TAC (← q r"s:B->A") THEN
      REWRITE_TAC [← GSYM embedding_map] THEN
      ASM_MESON_TAC [SECTION_IMP_EMBEDDING_MAP, section_map]])

  let HEREDITARY_IMP_RETRACTIVE_PROPERTY ← prove
   r"!(P:A topology->bool) (Q:B topology->bool).
        (!top s. P top ==> P(subtopology top s)) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top'))
        ==> !top top' r. retraction_map(top,top') r /\ P top ==> Q top'"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [retraction_map]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:B->A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"subtopology top (IMAGE (s:B->A) (topspace top'))",
      ← q r"top':B topology"]) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [RETRACTION_MAPS_SECTION_IMAGE], ALL_TAC] THEN
    ASM_SIMP_TAC [])

  return { retract_of_space, RETRACT_OF_SPACE_RETRACTION_MAPS, RETRACT_OF_SPACE_SECTION_MAP,
           RETRACT_OF_SPACE_IMP_SUBSET, RETRACT_OF_SPACE_TOPSPACE, RETRACT_OF_SPACE_EMPTY,
           RETRACT_OF_SPACE_IMP_NONEMPTY, RETRACT_OF_SPACE_SING, RETRACT_OF_SPACE_TRANS,
           RETRACT_OF_SPACE_SUBTOPOLOGY, RETRACT_OF_SPACE_CLOPEN,
           RETRACT_OF_SPACE_DISJOINT_UNION, RETRACTION_MAPS_SECTION_IMAGE,
           HEREDITARY_IMP_RETRACTIVE_PROPERTY }


/- ------------------------------------------------------------------------- -/
/- Compact sets and compact topological spaces, part 1.                      -/
/- (metric.ml 6804-7028)                                                      -/
/- ------------------------------------------------------------------------- -/

structure Compact1 where
  compact_in : thm
  compact_space : thm
  COMPACT_SPACE_ALT : thm
  COMPACT_SPACE : thm
  COMPACT_IN_ABSOLUTE : thm
  COMPACT_IN_SUBSPACE : thm
  COMPACT_SPACE_SUBTOPOLOGY : thm
  COMPACT_IN_SUBTOPOLOGY : thm
  COMPACT_IN_SUBSET_TOPSPACE : thm
  COMPACT_IN_CONTRACTIVE : thm
  COMPACT_SPACE_CONTRACTIVE : thm
  FINITE_IMP_COMPACT_IN : thm
  COMPACT_IN_EMPTY : thm
  COMPACT_SPACE_TOPSPACE_EMPTY : thm
  FINITE_IMP_COMPACT_IN_EQ : thm
  COMPACT_IN_SING : thm
  CLOSED_COMPACT_IN : thm
  CLOSED_IN_COMPACT_SPACE : thm
  COMPACT_INTER_CLOSED_IN : thm
  CLOSED_INTER_COMPACT_IN : thm
  COMPACT_IN_UNION : thm
  COMPACT_IN_UNIONS : thm
  COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT : thm
  deriving Inhabited

@[nospecialize]
def setupCompact1 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BSubtopology : Subtopology) : ExceptT String IO Compact1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, HYP_TAC, SUBST_VAR_TAC,
        new_definition, .. } := D
  let { AND_FORALL_THM, EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE, FINITE_DELETE, FINITE_EMPTY,
        FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_SING, FINITE_UNION, FORALL_SUBSET_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INTER_COMM, INTER_SUBSET, INTER_UNIONS, IN_DELETE, IN_DIFF,
        IN_ELIM_THM, IN_IMAGE, IN_INSERT, IN_UNIONS, MONO_FORALL, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_REFL,
        UNIONS_0, UNIONS_INSERT, UNIONS_SUBSET, UNIONS_UNION, UNION_SUBSET, .. } := D.core4
  let { MONO_AND, .. } := D.core5
  let { CLAIM_TAC, CUT_TAC, LABEL_ABBREV_TAC, .. } := BTactics
  let { CLOSED_IN_SUBSET, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in,
        .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN, CLOSED_IN_SUBTOPOLOGY_REFL, OPEN_IN_SUBTOPOLOGY,
        SUBTOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY,
        .. } := BSubtopology
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let compact_in ← new_definition
    r"!top s:A->bool.
     compact_in top s <=>
     s SUBSET topspace top /\
     (!U. (!u. u IN U ==> open_in top u) /\ s SUBSET UNIONS U
          ==> (?V. FINITE V /\ V SUBSET U /\ s SUBSET UNIONS V))"

  let compact_space ← new_definition
   r"compact_space(top:A topology) <=> compact_in top (topspace top)"

  let COMPACT_SPACE_ALT ← prove
   r"!top:A topology.
        compact_space top <=>
        !U. (!u. u IN U ==> open_in top u) /\
            topspace top SUBSET UNIONS U
            ==> ?V. FINITE V /\ V SUBSET U /\ topspace top SUBSET UNIONS V"
   (REWRITE_TAC [compact_space, compact_in, SUBSET_REFL])

  let COMPACT_SPACE ← prove
   r"!top:A topology.
        compact_space top <=>
        !U. (!u. u IN U ==> open_in top u) /\
            UNIONS U = topspace top
            ==> ?V. FINITE V /\ V SUBSET U /\ UNIONS V = topspace top"
   (GEN_TAC THEN REWRITE_TAC [COMPACT_SPACE_ALT] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    MESON_TAC [SUBSET, OPEN_IN_SUBSET])

  let COMPACT_IN_ABSOLUTE ← prove
   r"!top s:A->bool.
        compact_in (subtopology top s) s <=> compact_in top s"
   (REWRITE_TAC [compact_in] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, SUBSET_REFL] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, ← sr
     r"(!x. x IN s ==> ?y. P y /\ x = f y) <=> s SUBSET IMAGE f {y | P y}"] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
    REWRITE_TAC [SUBSET_INTER, SUBSET_REFL] THEN SET_TAC [])

  let COMPACT_IN_SUBSPACE ← prove
   r"!top s:A->bool.
        compact_in top s <=>
        s SUBSET topspace top /\ compact_space (subtopology top s)"
   (REWRITE_TAC [compact_space, COMPACT_IN_ABSOLUTE, TOPSPACE_SUBTOPOLOGY] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q <=> ~(p ==> ~q)")] THEN
    SIMP_TAC [← sr r"s SUBSET t ==> t INTER s = s"] THEN
    REWRITE_TAC [COMPACT_IN_ABSOLUTE] THEN
    REWRITE_TAC [← TAUT (← q r"(p <=> ~(q ==> ~p)) <=> (p ==> q)")] THEN
    SIMP_TAC [compact_in])

  let COMPACT_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool. compact_in top s ==> compact_space (subtopology top s)"
   (SIMP_TAC [COMPACT_IN_SUBSPACE])

  let COMPACT_IN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        compact_in (subtopology top s) t <=> compact_in top t /\ t SUBSET s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [COMPACT_IN_SUBSPACE, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    ASM_CASES_TAC (← q r"(t:A->bool) SUBSET s") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← sr r"t SUBSET s ==> s INTER t = t"])

  let COMPACT_IN_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. compact_in top s ==> s SUBSET topspace top"
   (SIMP_TAC [compact_in])

  let COMPACT_IN_CONTRACTIVE ← prove
   r"!top top':A topology.
        topspace top' = topspace top /\
        (!u. open_in top u ==> open_in top' u)
        ==> !s. compact_in top' s ==> compact_in top s"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN GEN_TAC THEN
    REWRITE_TAC [compact_in] THEN MATCH_MP_TAC MONO_AND THEN CONJ_TAC THENL
     [ASM SET_TAC [], MATCH_MP_TAC MONO_FORALL THEN ASM SET_TAC []])

  let COMPACT_SPACE_CONTRACTIVE ← prove
   r"!top top':A topology.
        topspace top' = topspace top /\
        (!u. open_in top u ==> open_in top' u)
        ==> compact_space top' ==> compact_space top"
   (SIMP_TAC [compact_space] THEN MESON_TAC [COMPACT_IN_CONTRACTIVE])

  let FINITE_IMP_COMPACT_IN ← prove
   r"!top s:A->bool. s SUBSET topspace top /\ FINITE s ==> compact_in top s"
   (SIMP_TAC [compact_in] THEN INTRO_TAC "!top s; sub fin; !U; U s" THEN
    EXISTS_TAC (← q r"IMAGE (\x:A. @u. u IN U /\ x IN u) s") THEN
    HYP SIMP_TAC "fin" [FINITE_IMAGE] THEN ASM SET_TAC [])

  let COMPACT_IN_EMPTY ← prove
   r"!top:A topology. compact_in top {}"
   (GEN_TAC THEN MATCH_MP_TAC FINITE_IMP_COMPACT_IN THEN
    REWRITE_TAC [FINITE_EMPTY, EMPTY_SUBSET])

  let COMPACT_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> compact_space top"
   (MESON_TAC [SUBTOPOLOGY_TOPSPACE, COMPACT_IN_EMPTY, compact_space])

  let FINITE_IMP_COMPACT_IN_EQ ← prove
   r"!top s:A->bool.
        FINITE s ==> (compact_in top s <=> s SUBSET topspace top)"
   (MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE, FINITE_IMP_COMPACT_IN])

  let COMPACT_IN_SING ← prove
   r"!top a:A. compact_in top {a} <=> a IN topspace top"
   (SIMP_TAC [FINITE_IMP_COMPACT_IN_EQ, FINITE_SING, SING_SUBSET])

  let CLOSED_COMPACT_IN ← prove
   r"!top k c:A->bool. compact_in top k /\ c SUBSET k /\ closed_in top c
                     ==> compact_in top c"
   (INTRO_TAC "! *; cpt sub cl" THEN REWRITE_TAC [compact_in] THEN CONJ_TAC THENL
    [HYP SET_TAC "sub cpt" [compact_in], INTRO_TAC "!U; U c"] THEN
    HYP_TAC "cpt: ksub cpt" (REWRITE_RULE [compact_in]) THEN
    REMOVE_THEN "cpt" (MP_TAC o
      SPEC (← q r"(topspace top DIFF c:A->bool) INSERT U")) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [CUT_TAC (← q r"open_in top (topspace top DIFF c:A->bool)") THENL
      [HYP SET_TAC "U" [IN_DIFF],
       HYP SIMP_TAC "cl" [OPEN_IN_DIFF, OPEN_IN_TOPSPACE]],
      HYP_TAC "cl: c' cl" (REWRITE_RULE [closed_in]) THEN
      REWRITE_TAC [SUBSET, IN_INSERT, IN_DIFF, IN_UNIONS] THEN
      INTRO_TAC "!x; x" THEN ASM_CASES_TAC (← q r"x:A IN c") THEN
      POP_ASSUM (LABEL_TAC "x'") THENL
      [HYP SET_TAC "c x'" [],
       EXISTS_TAC (← q r"topspace top DIFF c:A->bool") THEN
       ASM_REWRITE_TAC [] THEN ASM SET_TAC []]],
     INTRO_TAC "@V. fin v k" THEN
     EXISTS_TAC (← q r"V DELETE (topspace top DIFF c:A->bool)") THEN
     ASM_REWRITE_TAC [FINITE_DELETE] THEN
     CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
     REWRITE_TAC [SUBSET, IN_UNIONS, IN_DELETE] THEN ASM SET_TAC []])

  let CLOSED_IN_COMPACT_SPACE ← prove
   r"!top s:A->bool.
        compact_space top /\ closed_in top s ==> compact_in top s"
   (REWRITE_TAC [compact_space] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_COMPACT_IN THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_MESON_TAC [CLOSED_IN_SUBSET])

  let COMPACT_INTER_CLOSED_IN ← prove
   r"!top s t:A->bool.
        compact_in top s /\ closed_in top t ==> compact_in top (s INTER t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"compact_in (subtopology top s) (s INTER t:A->bool)")
    MP_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
      CONJ_TAC THENL [ASM_MESON_TAC [COMPACT_IN_SUBSPACE], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED_IN THEN
      ASM_REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY_REFL] THEN
      ASM_MESON_TAC [compact_in],
      REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, INTER_SUBSET]])

  let CLOSED_INTER_COMPACT_IN ← prove
   r"!top s t:A->bool.
        closed_in top s /\ compact_in top t ==> compact_in top (s INTER t)"
   (ONCE_REWRITE_TAC [INTER_COMM] THEN SIMP_TAC [COMPACT_INTER_CLOSED_IN])

  let COMPACT_IN_UNION ← prove
   r"!top s t:A->bool.
        compact_in top s /\ compact_in top t ==> compact_in top (s UNION t)"
   (REPEAT GEN_TAC THEN SIMP_TAC [compact_in, UNION_SUBSET] THEN
    DISCH_THEN (CONJUNCTS_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [IMP_IMP, AND_FORALL_THM] THEN MATCH_MP_TAC MONO_FORALL THEN
    X_GEN_TAC (← q r"u:(A->bool)->bool") THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"v:(A->bool)->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"w:(A->bool)->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"v UNION w:(A->bool)->bool") THEN
    ASM_REWRITE_TAC [FINITE_UNION, UNIONS_UNION] THEN
    ASM SET_TAC [])

  let COMPACT_IN_UNIONS ← prove
   r"!top f:(A->bool)->bool.
        FINITE f /\ (!s. s IN f ==> compact_in top s)
        ==> compact_in top (UNIONS f)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [UNIONS_0, COMPACT_IN_EMPTY, IN_INSERT, UNIONS_INSERT] THEN
    MESON_TAC [COMPACT_IN_UNION])

  let COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT ← prove
   r"!top k s:A->bool.
     compact_in (subtopology top s) k ==> compact_in top k"
   (REWRITE_TAC [compact_in, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    INTRO_TAC "!top k s; (k sub) cpt" THEN ASM_REWRITE_TAC [] THEN
    INTRO_TAC "!U; open cover" THEN
    HYP_TAC "cpt: +" (SPEC (← q r"{u INTER s | u | u:A->bool IN U}")) THEN
    ANTS_TAC THENL
    [ASM_REWRITE_TAC [← GSYM INTER_UNIONS, SUBSET_INTER] THEN
     REWRITE_TAC [IN_ELIM_THM, OPEN_IN_SUBTOPOLOGY] THEN
     INTRO_TAC "!u; @v. v ueq" THEN
     REMOVE_THEN "ueq" SUBST_VAR_TAC THEN EXISTS_TAC (← q r"v:A->bool") THEN
     REMOVE_THEN "v" (HYP_TAC "open" o C MATCH_MP) THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    INTRO_TAC "@V. fin V k" THEN EXISTS_TAC (← q r"IMAGE (\v:A->bool.
      if v IN V then @u. u IN U /\ v = u INTER s else {}) V") THEN
    ASM_SIMP_TAC [FINITE_IMAGE] THEN
    CONJ_TAC THENL
    [REWRITE_TAC [SUBSET, IN_IMAGE] THEN INTRO_TAC "![u]; @v. ueq v" THEN
     REMOVE_THEN "ueq" SUBST_VAR_TAC THEN ASM_REWRITE_TAC [] THEN
     HYP_TAC "V" (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
     REMOVE_THEN "v" (HYP_TAC "V: @u. u veq" o C MATCH_MP) THEN
     REMOVE_THEN "veq" SUBST_VAR_TAC THEN HYP MESON_TAC "u" [],
     ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_UNIONS, IN_IMAGE] THEN INTRO_TAC "!x; x" THEN
    HYP_TAC "k" (REWRITE_RULE [SUBSET, IN_UNIONS]) THEN
    USE_THEN "x" (HYP_TAC "k: @v. v xINv" o C MATCH_MP) THEN
    LABEL_ABBREV_TAC (← q r"u:A->bool = @u. u IN U /\ v = u INTER s") THEN
    CLAIM_TAC "u' veq" (← q r"u:A->bool IN U /\ v = u INTER s") THENL
    [REMOVE_THEN "u" SUBST_VAR_TAC THEN
     CUT_TAC (← q r"?u:A->bool. u IN U /\ v = u INTER s") THENL
     [MESON_TAC [], ALL_TAC] THEN
     HYP_TAC "V" (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
     USE_THEN "v" (HYP_TAC "V" o C MATCH_MP) THEN
     REMOVE_THEN "V" MATCH_ACCEPT_TAC,
     EXISTS_TAC (← q r"u:A->bool") THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"v:A->bool") THEN ASM_REWRITE_TAC [],
      HYP SET_TAC "veq xINv" []]])

  return { compact_in, compact_space, COMPACT_SPACE_ALT, COMPACT_SPACE, COMPACT_IN_ABSOLUTE,
           COMPACT_IN_SUBSPACE, COMPACT_SPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY,
           COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_CONTRACTIVE, COMPACT_SPACE_CONTRACTIVE,
           FINITE_IMP_COMPACT_IN, COMPACT_IN_EMPTY, COMPACT_SPACE_TOPSPACE_EMPTY,
           FINITE_IMP_COMPACT_IN_EQ, COMPACT_IN_SING, CLOSED_COMPACT_IN,
           CLOSED_IN_COMPACT_SPACE, COMPACT_INTER_CLOSED_IN, CLOSED_INTER_COMPACT_IN,
           COMPACT_IN_UNION, COMPACT_IN_UNIONS, COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT }

/- ------------------------------------------------------------------------- -/
/- Compact sets, part 2.  (metric.ml 7030-7264)                              -/
/- ------------------------------------------------------------------------- -/

structure Compact2 where
  COMPACT_IMP_COMPACT_IN_SUBTOPOLOGY : thm
  CLOSED_IN_COMPACT_SUBTOPOLOGY : thm
  COMPACT_SPACE_FIP : thm
  COMPACT_IN_FIP : thm
  COMPACT_SPACE_IMP_NEST : thm
  COMPACT_IN_DISCRETE_TOPOLOGY : thm
  COMPACT_SPACE_DISCRETE_TOPOLOGY : thm
  COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS : thm
  COMPACT_IN_IMP_BOLZANO_WEIERSTRASS : thm
  COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS : thm
  DISCRETE_COMPACT_IN_EQ_FINITE : thm
  DISCRETE_COMPACT_SPACE_EQ_FINITE : thm
  deriving Inhabited

@[nospecialize]
def setupCompact2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BDerived : Derived) (BClosure : Closure)
    (BCompact1 : Compact1) : ExceptT String IO Compact2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, HYP_TAC, SUBST_VAR_TAC,
        .. } := D
  let { DIFF_EMPTY, DIFF_INTERS, EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE, FINITE_EMPTY,
        FINITE_IMAGE, FINITE_SING, FINITE_SUBSET, FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_SUBSET_IMAGE, FUN_EQ_THM, IMAGE_CLAUSES, IMAGE_EQ_EMPTY,
        .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_IMP, INFINITE, INTERS_0, INTERS_1, INTERS_GSPEC, INTERS_IMAGE,
        INTERS_INSERT, INTERS_SUBSET, INTER_EMPTY, INTER_INTERS, INTER_UNIONS, IN_ELIM_THM,
        IN_UNIV, LEFT_IMP_EXISTS_THM, LE_0, LE_REFL, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_FORALL_THM, NOT_IMP, NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SING_SUBSET, SUBSET, SUBSET_EMPTY, SUBSET_INTER,
        SUBSET_INTERS, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIV, UNIONS_0, UNIONS_IMAGE,
        UNIONS_INTERS, UNIONS_MONO, UNIV_NOT_EMPTY, o_DEF, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { UPPER_BOUND_FINITE_SET, .. } := D.misc
  let { CLOSED_IN_DIFF, CLOSED_IN_INTERS, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF,
        OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { CLOSED_IN_SUBTOPOLOGY_ALT, CLOSED_IN_TOPSPACE_EMPTY, OPEN_IN_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { DERIVED_SET_OF_SUBTOPOLOGY, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY, .. } := BDerived
  let { CLOSED_IN_CONTAINS_DERIVED_SET, CLOSURE_OF_MONO, CLOSURE_OF_SUBSET, .. } := BClosure
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_EMPTY, COMPACT_IN_SUBSET_TOPSPACE,
        COMPACT_IN_SUBSPACE, COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT, COMPACT_SPACE_ALT,
        COMPACT_SPACE_SUBTOPOLOGY, FINITE_IMP_COMPACT_IN, compact_in, compact_space,
        .. } := BCompact1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let COMPACT_IMP_COMPACT_IN_SUBTOPOLOGY ← prove
   r"!top k s:A->bool.
     compact_in top k /\ k SUBSET s ==> compact_in (subtopology top s) k"
   (INTRO_TAC "!top k s; cpt sub" THEN
    ASM_SIMP_TAC [compact_in, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER,
      COMPACT_IN_SUBSET_TOPSPACE] THEN
    INTRO_TAC "!U; open cover" THEN
    HYP_TAC "cpt: sub' cpt" (REWRITE_RULE [compact_in]) THEN
    (HYP_TAC "cpt: +" o SPEC)
      (← q r"{v:A->bool | v | open_in top v /\ ?u. u IN U /\ u = v INTER s}") THEN
    ANTS_TAC THENL
    [SIMP_TAC [IN_ELIM_THM] THEN TRANS_TAC SUBSET_TRANS (← q r"UNIONS U:A->bool") THEN
     ASM_REWRITE_TAC [] THEN MATCH_MP_TAC UNIONS_MONO THEN
     INTRO_TAC "![u]; u" THEN USE_THEN "u" (HYP_TAC "open" o C MATCH_MP) THEN
     HYP_TAC "open: @v. v ueq" (REWRITE_RULE [OPEN_IN_SUBTOPOLOGY]) THEN
     EXISTS_TAC (← q r"v:A->bool") THEN REMOVE_THEN "ueq" SUBST_VAR_TAC THEN
     ASM_REWRITE_TAC [IN_ELIM_THM] THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"v INTER s:A->bool") THEN ASM_REWRITE_TAC [], SET_TAC []],
     ALL_TAC] THEN
    INTRO_TAC "@V. fin open cover" THEN
    EXISTS_TAC (← q r"{v INTER s | v | v:A->bool IN V}") THEN CONJ_TAC THENL
    [(SUBST1_TAC o SET_RULE)
       (← q r"{v INTER s | v | v:A->bool IN V} = IMAGE (\v. v INTER s) V") THEN
     ASM_SIMP_TAC [FINITE_IMAGE],
     ALL_TAC] THEN
    ASM_REWRITE_TAC [← GSYM INTER_UNIONS, SUBSET_INTER] THEN
    REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN INTRO_TAC "![u]; @v. v ueq" THEN
    REMOVE_THEN "ueq" SUBST_VAR_TAC THEN
    HYP_TAC "open" (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
    REMOVE_THEN "v" (HYP_TAC "open: v @u. u ueq" o C MATCH_MP) THEN
    REMOVE_THEN "ueq" SUBST_VAR_TAC THEN ASM_REWRITE_TAC [])

  let CLOSED_IN_COMPACT_SUBTOPOLOGY ← prove
   r"!top k s.
        compact_in top k /\ closed_in(subtopology top k) s
        ==> compact_in top s"
   (MESON_TAC [COMPACT_IN_SUBTOPOLOGY_IMP_COMPACT, CLOSED_IN_COMPACT_SPACE,
               COMPACT_SPACE_SUBTOPOLOGY])

  let COMPACT_SPACE_FIP ← prove
   r"!top:A topology.
        compact_space top <=>
        !f. (!c. c IN f ==> closed_in top c) /\
            (!f'. FINITE f' /\ f' SUBSET f ==> ~(INTERS f' = {}))
           ==> ~(INTERS f = {})"
   (GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THENL
     [ASM_SIMP_TAC [compact_space, CLOSED_IN_TOPSPACE_EMPTY] THEN
      REWRITE_TAC [COMPACT_IN_EMPTY, ← sr
       r"(!x. x IN s ==> x = a) <=> s = {} \/ s = {a}"] THEN
      X_GEN_TAC (← q r"f:(A->bool)->bool") THEN
      ASM_CASES_TAC (← q r"f:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [INTERS_0, UNIV_NOT_EMPTY] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"f:(A->bool)->bool"))) THEN
      ASM_REWRITE_TAC [INTERS_1, FINITE_SING, SUBSET_REFL],
      ALL_TAC] THEN
    REWRITE_TAC [COMPACT_SPACE_ALT] THEN EQ_TAC THEN
    INTRO_TAC "0" THEN X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    REMOVE_THEN "0" (MP_TAC o SPEC
     (← q r"IMAGE (\s:A->bool. topspace top DIFF s) U")) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, CLOSED_IN_DIFF, OPEN_IN_DIFF,
                  OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE] THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM CONTRAPOS_THM] THENL
     [REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM DIFF_INTERS] THEN
      ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") MP_TAC) THEN
      REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
      ASM_CASES_TAC (← q r"V:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [INTERS_0, UNIV_NOT_EMPTY] THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"V:(A->bool)->bool")) THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← sr
      r"~(u = {}) /\ s SUBSET u ==> ~(s = {}) ==> ~(u SUBSET u DIFF s)") THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC INTERS_SUBSET THEN
      ASM_MESON_TAC [SUBSET, CLOSED_IN_SUBSET],
      ASM_CASES_TAC (← q r"U:(A->bool)->bool = {}") THENL
       [ASM_MESON_TAC [UNIONS_0, SUBSET_EMPTY], ALL_TAC] THEN
      UNDISCH_TAC (← q r"(topspace top:A->bool) SUBSET UNIONS U") THEN
      REWRITE_TAC [UNIONS_INTERS] THEN
      ONCE_REWRITE_TAC [← sr
       r"u SUBSET UNIV DIFF t <=> u SUBSET u DIFF u INTER u INTER t"] THEN
      ONCE_REWRITE_TAC [← GSYM INTERS_INSERT] THEN
      REWRITE_TAC [INTER_INTERS, NOT_INSERT_EMPTY] THEN
      REWRITE_TAC [SIMPLE_IMAGE, INTERS_INSERT, IMAGE_CLAUSES] THEN
      REWRITE_TAC [← sr r"u DIFF (u INTER u) INTER t = u DIFF t"] THEN
      REWRITE_TAC [← GSYM IMAGE_o, o_DEF] THEN
      REWRITE_TAC [← sr r"u INTER (UNIV DIFF s) = u DIFF s"] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← sr
       r"u SUBSET u DIFF s ==> u = {} \/ (s SUBSET u ==> s = {})")) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [MATCH_MP_TAC INTERS_SUBSET THEN
        ASM_REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE] THEN SET_TAC [],
        DISCH_TAC THEN ASM_REWRITE_TAC [NOT_FORALL_THM]] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"V:(A->bool)->bool") THEN
      SIMP_TAC [NOT_IMP, DIFF_EMPTY, SUBSET_REFL]])

  let COMPACT_IN_FIP ← prove
   r"!top s:A->bool.
        compact_in top s <=>
        s SUBSET topspace top /\
        !f. (!c. c IN f ==> closed_in top c) /\
            (!f'. FINITE f' /\ f' SUBSET f ==> ~(s INTER INTERS f' = {}))
            ==> ~(s INTER INTERS f = {})"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [ASM_REWRITE_TAC [COMPACT_IN_EMPTY, INTER_EMPTY, EMPTY_SUBSET] THEN
      GEN_TAC THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"{}:(A->bool)->bool") o CONJUNCT2) THEN
      REWRITE_TAC [FINITE_EMPTY, EMPTY_SUBSET],
      ALL_TAC] THEN
    REWRITE_TAC [COMPACT_IN_SUBSPACE, COMPACT_SPACE_FIP] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN
    ASM_REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY_ALT, ← GSYM SUBSET, IMP_CONJ] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN REWRITE_TAC [FORALL_SUBSET_IMAGE] THEN
    REWRITE_TAC [IMP_IMP, FORALL_FINITE_SUBSET_IMAGE] THEN
    REWRITE_TAC [INTER_INTERS, ← GSYM SIMPLE_IMAGE] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"f:(A->bool)->bool") THEN
    ASM_CASES_TAC (← q r"f:(A->bool)->bool = {}") THEN
    ASM_SIMP_TAC [SUBSET_EMPTY] THENL
     [REWRITE_TAC [← sr r"{f x | x IN {}} = {}", INTERS_0, UNIV_NOT_EMPTY] THEN
      DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN MESON_TAC [FINITE_EMPTY],
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN
      ASM_CASES_TAC (← q r"!c:A->bool. c IN f ==> closed_in top c") THEN
      ASM_REWRITE_TAC [] THEN
      ASM_CASES_TAC (← q r"INTERS {s INTER t:A->bool | t IN f} = {}") THEN
      ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN
      AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
      X_GEN_TAC (← q r"g:(A->bool)->bool") THEN
      ASM_CASES_TAC (← q r"g:(A->bool)->bool = {}") THEN
      ASM_SIMP_TAC [← sr r"{f x | x IN {}} = {}", INTERS_0, UNIV_NOT_EMPTY]])

  let COMPACT_SPACE_IMP_NEST ← prove
   r"!top c:num->A->bool.
        compact_space top /\
        (!n. closed_in top (c n)) /\
        (!n. ~(c n = {})) /\
        (!m n. m <= n ==> c n SUBSET c m)
        ==> ~(INTERS {c n | n IN (:num)} = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPACT_SPACE_FIP]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE (\n. INTERS {(c:num->A->bool) m | m <= n}) (:num)")) THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE, SUBSET_UNIV] THEN ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_IMAGE, IN_UNIV] THEN GEN_TAC THEN
        MATCH_MP_TAC CLOSED_IN_INTERS THEN
        ASM_REWRITE_TAC [FORALL_IN_GSPEC, ← GSYM MEMBER_NOT_EMPTY] THEN
        MATCH_MP_TAC (← sr r"(?x. P x) ==> ?x. x IN {f a | P a}") THEN
        MESON_TAC [LE_0],
        X_GEN_TAC (← q r"k:num->bool") THEN
        DISCH_THEN (MP_TAC o ISPEC (← q r"\n:num. n") o
          MATCH_MP UPPER_BOUND_FINITE_SET) THEN
        REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN X_GEN_TAC (← q r"n:num") THEN
        DISCH_TAC THEN MATCH_MP_TAC (← sr
         r"!t. ~(t = {}) /\ t SUBSET s ==> ~(s = {})") THEN
        EXISTS_TAC (← q r"(c:num->A->bool) n") THEN
        ASM_SIMP_TAC [SUBSET_INTERS, FORALL_IN_IMAGE, FORALL_IN_GSPEC] THEN
        ASM SET_TAC []],
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN MATCH_MP_TAC MONO_EXISTS THEN
      REWRITE_TAC [INTERS_GSPEC, INTERS_IMAGE, IN_UNIV, IN_ELIM_THM] THEN
      MESON_TAC [LE_REFL]])

  let COMPACT_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool.
        compact_in (discrete_topology u) s <=> s SUBSET u /\ FINITE s"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [FINITE_IMP_COMPACT_IN, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [compact_in, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (\x:A. {x}) u")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, OPEN_IN_DISCRETE_TOPOLOGY, SING_SUBSET] THEN
    REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
    ASM_REWRITE_TAC [UNIONS_IMAGE, ← sr r"(?x. x IN u /\ y IN {x}) <=> y IN u",
                     ← sr r"{x | x IN s} = s"] THEN
    MESON_TAC [FINITE_SUBSET])

  let COMPACT_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. compact_space(discrete_topology u) <=> FINITE u"
   (REWRITE_TAC [compact_space, COMPACT_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY, SUBSET_REFL])

  let COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS ← prove
   r"!top s:A->bool.
        compact_space top /\ INFINITE s /\ s SUBSET topspace top
        ==> ~(top derived_set_of s = {})"
   (REPEAT STRIP_TAC THEN
    UNDISCH_TAC (← q r"INFINITE(s:A->bool)") THEN REWRITE_TAC [INFINITE] THEN
    SUBGOAL_THEN (← q r"compact_in top (s:A->bool)") MP_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET, NOT_IN_EMPTY] THEN
      ASM SET_TAC [],
      ASM_SIMP_TAC [COMPACT_IN_SUBSPACE, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY,
                    INTER_EMPTY, COMPACT_SPACE_DISCRETE_TOPOLOGY]])

  let COMPACT_IN_IMP_BOLZANO_WEIERSTRASS ← prove
   r"!top s t:A->bool.
        compact_in top s /\ INFINITE t /\ t SUBSET s
        ==> ~(s INTER top derived_set_of t = {})"
   (REWRITE_TAC [COMPACT_IN_SUBSPACE] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"subtopology top (s:A->bool)", ← q r"t:A->bool"]
          COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS) THEN
    ASM_REWRITE_TAC [DERIVED_SET_OF_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"])

  let COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS ← prove
   r"!top s t:A->bool.
        compact_in top (top closure_of s) /\
        INFINITE t /\ t SUBSET s /\ t SUBSET topspace top
        ==> ~(top derived_set_of t = {})"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"t:A->bool") o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          COMPACT_IN_IMP_BOLZANO_WEIERSTRASS)) THEN
    ASM_REWRITE_TAC [INTER_EMPTY] THEN
    TRANS_TAC SUBSET_TRANS (← q r"top closure_of t:A->bool") THEN
    ASM_SIMP_TAC [CLOSURE_OF_MONO, CLOSURE_OF_SUBSET])

  let DISCRETE_COMPACT_IN_EQ_FINITE ← prove
   r"!top s:A->bool.
        s INTER top derived_set_of s = {}
        ==> (compact_in top s <=> s SUBSET topspace top /\ FINITE s)"
   (REPEAT STRIP_TAC THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC [FINITE_IMP_COMPACT_IN]] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [compact_in]] THEN
    GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [← GSYM INFINITE] THEN
    ASM_MESON_TAC [COMPACT_IN_IMP_BOLZANO_WEIERSTRASS, SUBSET_REFL])

  let DISCRETE_COMPACT_SPACE_EQ_FINITE ← prove
   r"!top:A topology.
        top derived_set_of (topspace top) = {}
        ==> (compact_space top <=> FINITE(topspace top))"
   (SIMP_TAC [compact_space, DISCRETE_COMPACT_IN_EQ_FINITE, INTER_EMPTY] THEN
    REWRITE_TAC [SUBSET_REFL])

  return { COMPACT_IMP_COMPACT_IN_SUBTOPOLOGY, CLOSED_IN_COMPACT_SUBTOPOLOGY,
           COMPACT_SPACE_FIP, COMPACT_IN_FIP, COMPACT_SPACE_IMP_NEST,
           COMPACT_IN_DISCRETE_TOPOLOGY, COMPACT_SPACE_DISCRETE_TOPOLOGY,
           COMPACT_SPACE_IMP_BOLZANO_WEIERSTRASS, COMPACT_IN_IMP_BOLZANO_WEIERSTRASS,
           COMPACT_CLOSURE_OF_IMP_BOLZANO_WEIERSTRASS, DISCRETE_COMPACT_IN_EQ_FINITE,
           DISCRETE_COMPACT_SPACE_EQ_FINITE }

/- ------------------------------------------------------------------------- -/
/- Compact sets, part 3.  (metric.ml 7266-7493)                              -/
/- ------------------------------------------------------------------------- -/

structure Compact3 where
  IMAGE_COMPACT_IN : thm
  HOMEOMORPHIC_COMPACT_SPACE : thm
  HOMEOMORPHIC_MAP_COMPACTNESS : thm
  HOMEOMORPHIC_MAP_COMPACTNESS_EQ : thm
  COMPACT_SPACE_QUOTIENT_MAP_IMAGE : thm
  COMPACT_SPACE_RETRACTION_MAP_IMAGE : thm
  ALEXANDER_SUBBASE_THEOREM : thm
  ALEXANDER_SUBBASE_THEOREM_ALT : thm
  deriving Inhabited

@[nospecialize]
def setupCompact3 [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BBases : Bases) (BContMap1 : ContMap1) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace) (BRetraction : Retraction)
    (BCompact1 : Compact1) : ExceptT String IO Compact3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, INTRO_TAC, HYP_TAC, .. } := D
  let { ARBITRARY, EXISTS_FINITE_SUBSET_IMAGE, FINITE_DELETE, FINITE_EMPTY, FINITE_IMAGE,
        FINITE_INSERT, FINITE_SING, FINITE_SUBSET_UNIONS_CHAIN, FINITE_UNIONS,
        FORALL_INTERSECTION_OF, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_SUBSET_IMAGE,
        FORALL_UNION_OF, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_IMP, INTERSECTION_OF, INTERS_0, INTERS_1, INTER_SUBSET,
        INTER_UNIONS, INTER_UNIV, IN_ELIM_THM, IN_INTER, IN_UNIONS, LEFT_FORALL_IMP_THM,
        LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_INTER, SUBSET_REFL,
        SUBSET_TRANS, UNIONS_1, UNIONS_SUBSET, UNION_OF_INC, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, RIGHT_EXISTS_IMP_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { FINITE_INTERSECTION_OF_RELATIVE_TO, FORALL_RELATIVE_TO, RELATIVE_TO, relative_to,
        .. } := D.misc
  let { ZL_SUBSETS_UNIONS_NONEMPTY, .. } := D.lib
  let { CLAIM_TAC, .. } := BTactics
  let { OPEN_IN_SUBSET, topology_tybij, .. } := BTopology
  let { ISTOPOLOGY_SUBBASE, OPEN_IN_SUBBASE, TOPSPACE_SUBBASE, .. } := BBases
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, continuous_map, .. } := BContMap1
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, .. } := BQuotient
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBSPACE, compact_in, compact_space,
        .. } := BCompact1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let IMAGE_COMPACT_IN ← prove
   r"!top top' (f:A->B) s.
     compact_in top s /\ continuous_map (top,top')  f
     ==> compact_in top' (IMAGE f s)"
   (INTRO_TAC "!top top' f s; cpt cont" THEN REWRITE_TAC [compact_in] THEN
    CONJ_TAC THENL
    [TRANS_TAC SUBSET_TRANS (← q r"IMAGE (f:A->B) (topspace top)") THEN
     ASM_SIMP_TAC [CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, IMAGE_SUBSET,
       COMPACT_IN_SUBSET_TOPSPACE],
     INTRO_TAC "!U; U img"] THEN
    HYP_TAC "cpt : sub cpt" (REWRITE_RULE [compact_in]) THEN
    REMOVE_THEN "cpt" (MP_TAC o
      SPEC (← q r"{{x | x | x IN topspace top /\ (f:A->B) x IN u} | u | u IN U}")) THEN
    ANTS_TAC THENL
    [REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIONS] THEN
     INTRO_TAC "{![w]; @v. v eq & !x; x}" THENL
     [REMOVE_THEN "eq" SUBST1_TAC THEN
      HYP_TAC "cont : wd cont" (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      REMOVE_THEN "img" (MP_TAC o SPEC (← q r"f (x:A):B") o REWRITE_RULE [SUBSET]) THEN
      ANTS_TAC THENL [HYP SET_TAC "x" [], REWRITE_TAC [IN_UNIONS]] THEN
      INTRO_TAC "@t. t fx" THEN
      EXISTS_TAC (← q r"{x:A | x IN topspace top /\ f x:B IN t}") THEN ASM SET_TAC []],
     ALL_TAC] THEN
    INTRO_TAC "@V. fin sub s" THEN
    CLAIM_TAC "@u. u"
      (← q r"?u. !v. v IN V ==> u v IN U /\
                          v = {x:A | x IN topspace top /\ f x:B IN u v}") THENL
    [REWRITE_TAC [← GSYM SKOLEM_THM, RIGHT_EXISTS_IMP_THM] THEN
     INTRO_TAC "!v; v" THEN
     HYP_TAC "sub" (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
     REMOVE_THEN "v" (HYP_TAC "sub: @u. u eq" o C MATCH_MP) THEN
     EXISTS_TAC (← q r"u:B->bool") THEN ASM_REWRITE_TAC [],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"IMAGE (u:(A->bool)->(B->bool)) V") THEN CONJ_TAC THENL
    [HYP SIMP_TAC "fin" [FINITE_IMAGE], ASM SET_TAC []])

  let HOMEOMORPHIC_COMPACT_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (compact_space top <=> compact_space top')"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_space, homeomorphic_maps, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [compact_space] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)")
      SUBST1_TAC THENL [ALL_TAC, ASM_MESON_TAC [IMAGE_COMPACT_IN]],
      SUBGOAL_THEN (← q r"topspace top = IMAGE (g:B->A) (topspace top')")
      SUBST1_TAC THENL [ALL_TAC, ASM_MESON_TAC [IMAGE_COMPACT_IN]]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_COMPACTNESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (compact_in top' (IMAGE f u) <=> compact_in top u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [COMPACT_IN_SUBSPACE] THEN
    BINOP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC HOMEOMORPHIC_COMPACT_SPACE THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN EXISTS_TAC (← q r"f:A->B") THEN
      MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
      ASM_REWRITE_TAC []] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_COMPACTNESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (compact_in top u <=>
             u SUBSET topspace top /\ compact_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_COMPACTNESS, COMPACT_IN_SUBSET_TOPSPACE])

  let COMPACT_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ compact_space top
        ==> compact_space top'"
   (REWRITE_TAC [compact_space] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP QUOTIENT_IMP_SURJECTIVE_MAP) THEN
    MATCH_MP_TAC IMAGE_COMPACT_IN THEN
    ASM_MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP])

  let COMPACT_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ compact_space top
        ==> compact_space top'"
   (MESON_TAC [COMPACT_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let ALEXANDER_SUBBASE_THEOREM ← prove
   r"!top:A topology B.
        topology
          (ARBITRARY UNION_OF
               (FINITE INTERSECTION_OF B relative_to UNIONS B)) = top /\
        (!C. C SUBSET B /\ UNIONS C = topspace top
             ==> ?C'. FINITE C' /\ C' SUBSET C /\ UNIONS C' = topspace top)
        ==> compact_space top"
   (REPEAT GEN_TAC THEN INTRO_TAC "top fin" THEN
    SUBGOAL_THEN (← q r"UNIONS B:A->bool = topspace top") ASSUME_TAC THENL
     [EXPAND_TAC "top" THEN REWRITE_TAC [TOPSPACE_SUBBASE], ALL_TAC] THEN
    REWRITE_TAC [compact_space, compact_in, SUBSET_REFL] THEN
    MP_TAC (← ISPEC
     (← q r"\C. (!u:A->bool. u IN C ==> open_in top u) /\
          topspace top SUBSET UNIONS C /\
          !C'. FINITE C' /\ C' SUBSET C ==> ~(topspace top SUBSET UNIONS C')")
      ZL_SUBSETS_UNIONS_NONEMPTY) THEN
    REWRITE_TAC [] THEN
    MATCH_MP_TAC (← TAUT (← q r"(~p' ==> p) /\ q /\ ~r ==> (p /\ q ==> r) ==> p'")) THEN
    CONJ_TAC THENL [MESON_TAC [], ALL_TAC] THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"c:((A->bool)->bool)->bool") THEN
      REWRITE_TAC [MEMBER_NOT_EMPTY] THEN STRIP_TAC THEN
      REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      X_GEN_TAC (← q r"c':(A->bool)->bool") THEN STRIP_TAC THEN
      MP_TAC (← ISPECL [← q r"c:((A->bool)->bool)->bool", ← q r"c':(A->bool)->bool"]
       FINITE_SUBSET_UNIONS_CHAIN) THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"C:(A->bool)->bool") MP_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 STRIP_ASSUME_TAC (LABEL_TAC "*")) THEN
    SUBGOAL_THEN
     (← q r"?x:A. x IN topspace top /\ ~(x IN UNIONS(B INTER C))")
    STRIP_ASSUME_TAC THENL
     [MATCH_MP_TAC (← sr
       r"s SUBSET t /\ ~(s = t) ==> ?x. x IN t /\ ~(x IN s)") THEN
      CONJ_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET, IN_INTER] THEN ASM_MESON_TAC [OPEN_IN_SUBSET],
        DISCH_TAC] THEN
      REMOVE_THEN "fin" (MP_TAC o SPEC (← q r"B INTER C:(A->bool)->bool")) THEN
      ASM_REWRITE_TAC [INTER_SUBSET, SUBSET_INTER] THEN
      ASM_MESON_TAC [SUBSET_REFL],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"?c B'. c IN C /\ open_in top c /\ ~(c = topspace top) /\
             FINITE B' /\ B' SUBSET B /\ ~(B' = {}) /\ (x:A) IN INTERS B' /\
             INTERS B' SUBSET c")
    STRIP_ASSUME_TAC THENL
     [SUBGOAL_THEN (← q r"?u:A->bool. open_in top u /\ u IN C /\ x IN u")
      MP_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
      X_GEN_TAC (← q r"c:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [RIGHT_EXISTS_AND_THM] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM_MESON_TAC [SING_SUBSET, FINITE_SING, UNIONS_1, SUBSET_REFL],
        UNDISCH_TAC (← q r"(x:A) IN c")] THEN
      UNDISCH_TAC (← q r"open_in top (c:A->bool)") THEN EXPAND_TAC "top" THEN
      REWRITE_TAC [← REWRITE_RULE [topology_tybij] ISTOPOLOGY_SUBBASE] THEN
      SPEC_TAC (← q r"c:A->bool", ← q r"d:A->bool") THEN
      ASM_REWRITE_TAC [FORALL_UNION_OF, ARBITRARY] THEN
      X_GEN_TAC (← q r"v:(A->bool)->bool") THEN
      DISCH_THEN (LABEL_TAC "+") THEN
      ONCE_REWRITE_TAC [← TAUT (← q r"p ==> q ==> r <=> q ==> p ==> r")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← sr
       r"~(UNIONS v = u) ==> UNIONS v SUBSET u ==> ~(u IN v)")) THEN
      ANTS_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
         (← sr r"(!x. P x ==> Q x)
                    ==> (!x. Q x ==> R x) ==> (!x. P x ==> R x)")) THEN
        REWRITE_TAC [FORALL_RELATIVE_TO, INTER_SUBSET],
        DISCH_TAC] THEN
      REWRITE_TAC [IN_UNIONS, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"w:A->bool") THEN STRIP_TAC THEN
      REMOVE_THEN "+" (MP_TAC o SPEC (← q r"w:A->bool")) THEN
      ASM_REWRITE_TAC [relative_to, LEFT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [IMP_CONJ, FORALL_INTERSECTION_OF] THEN
      REWRITE_TAC [IMP_IMP, LEFT_FORALL_IMP_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"B':(A->bool)->bool") THEN
      ASM_CASES_TAC (← q r"B':(A->bool)->bool = {}") THENL [ALL_TAC, ASM SET_TAC []] THEN
      ASM_REWRITE_TAC [INTERS_0, INTER_UNIV, FINITE_EMPTY, NOT_IN_EMPTY] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!b. (b:A->bool) IN B'
          ==> ?C'. FINITE C' /\ C' SUBSET C /\
                   topspace top SUBSET UNIONS(b INSERT C')")
    MP_TAC THENL
     [X_GEN_TAC (← q r"b:A->bool") THEN DISCH_TAC THEN
      REMOVE_THEN "*" (MP_TAC o SPEC (← q r"(b:A->bool) INSERT C")) THEN
      ASM_REWRITE_TAC [FORALL_IN_INSERT, ← sr r"s SUBSET a INSERT s"] THEN
      MATCH_MP_TAC (← TAUT (← q
       r"q /\ ~s /\ p /\ (~r ==> t) ==> (p /\ q /\ r ==> s) ==> t")) THEN
      REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
      CONJ_TAC THENL
       [EXPAND_TAC "top" THEN REWRITE_TAC [OPEN_IN_SUBBASE] THEN
        MATCH_MP_TAC UNION_OF_INC THEN REWRITE_TAC [ARBITRARY] THEN
        REWRITE_TAC [INTERSECTION_OF, relative_to] THEN
        EXISTS_TAC (← q r"b:A->bool") THEN
        CONJ_TAC THENL [EXISTS_TAC (← q r"{b:A->bool}"), ASM SET_TAC []] THEN
        REWRITE_TAC [FINITE_SING, FORALL_IN_INSERT, INTERS_1, NOT_IN_EMPTY] THEN
        ASM SET_TAC [],
        REWRITE_TAC [NOT_FORALL_THM, NOT_IMP] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"C':(A->bool)->bool") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"C' DELETE (b:A->bool)") THEN
        ASM_REWRITE_TAC [FINITE_DELETE] THEN ASM SET_TAC []],
      REWRITE_TAC [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]] THEN
    DISCH_THEN (X_CHOOSE_TAC (← q r"cc:(A->bool)->(A->bool)->bool")) THEN
    SUBGOAL_THEN
     (← q r"topspace top SUBSET
      UNIONS(c INSERT UNIONS(IMAGE (cc:(A->bool)->(A->bool)->bool) B'))")
    MP_TAC THENL [ASM SET_TAC [], REWRITE_TAC []] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_REWRITE_TAC [FINITE_INSERT, FINITE_UNIONS] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let ALEXANDER_SUBBASE_THEOREM_ALT ← prove
   r"!top:A topology B u.
        u SUBSET UNIONS B /\
        topology
          (ARBITRARY UNION_OF
               (FINITE INTERSECTION_OF B relative_to u)) = top /\
        (!C. C SUBSET B /\ u SUBSET UNIONS C
             ==> ?C'. FINITE C' /\ C' SUBSET C /\ u SUBSET UNIONS C')
        ==> compact_space top"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"topspace top:A->bool = u") ASSUME_TAC THENL
     [ASM_MESON_TAC [TOPSPACE_SUBBASE], ALL_TAC] THEN
    MATCH_MP_TAC ALEXANDER_SUBBASE_THEOREM THEN
    EXISTS_TAC (← q r"B relative_to (topspace top:A->bool)") THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (fun th => tactic_of do
        pure (GEN_REWRITE_TAC RAND_CONV [← SYM th])) THEN
      AP_TERM_TAC THEN AP_TERM_TAC THEN
      GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV)
       [FINITE_INTERSECTION_OF_RELATIVE_TO] THEN
      ASM_REWRITE_TAC [] THEN AP_TERM_TAC THEN REWRITE_TAC [RELATIVE_TO] THEN
      ONCE_REWRITE_TAC [← sr r"{f x | s x} = {f x | x IN s}"] THEN
      REWRITE_TAC [← GSYM INTER_UNIONS] THEN ASM SET_TAC [],
      REWRITE_TAC [RELATIVE_TO, IMP_CONJ] THEN
      ONCE_REWRITE_TAC [← sr r"{f x | s x} = IMAGE f s"] THEN
      REWRITE_TAC [FORALL_SUBSET_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
      REWRITE_TAC [← sr r"s INTER t = s <=> s SUBSET t"] THEN
      ASM_MESON_TAC []])

  return { IMAGE_COMPACT_IN, HOMEOMORPHIC_COMPACT_SPACE, HOMEOMORPHIC_MAP_COMPACTNESS,
           HOMEOMORPHIC_MAP_COMPACTNESS_EQ, COMPACT_SPACE_QUOTIENT_MAP_IMAGE,
           COMPACT_SPACE_RETRACTION_MAP_IMAGE, ALEXANDER_SUBBASE_THEOREM,
           ALEXANDER_SUBBASE_THEOREM_ALT }

/- ------------------------------------------------------------------------- -/
/- Compact sets, part 4.  (metric.ml 7495-7689)                              -/
/- ------------------------------------------------------------------------- -/

structure Compact4 where
  COMPACT_SPACE_PROD_TOPOLOGY : thm
  COMPACT_IN_CROSS : thm
  COMPACT_SPACE_PRODUCT_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupCompact4 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BProd1 : Prod1) (BProduct1 : Product1)
    (BProduct2 : Product2) (BCompact1 : Compact1) (BCompact3 : Compact3) :
    ExceptT String IO Compact4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EQ, CROSS_EQ_EMPTY, EXISTS_IN_GSPEC, EXISTS_IN_UNION, EXTENSIONAL, FINITE_EMPTY,
        FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_INSERT, FINITE_SING,
        FORALL_INTERSECTION_OF, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT,
        FORALL_SUBSET_IMAGE, FORALL_SUBSET_UNION, IMAGE_FST_CROSS, .. } := D.core1
  let { IMAGE_SND_CROSS, IMP_CONJ, INTERSECTION_OF, INTERS_0, INTERS_2, INTERS_INSERT,
        INTER_CROSS, INTER_EMPTY, INTER_UNIV, IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_UNION,
        IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_IN_EMPTY,
        .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, SUBSET_CROSS, SUBSET_REFL, UNION, UNIONS_IMAGE, UNIONS_UNION,
        .. } := D.core4
  let { DE_MORGAN_THM, EQ_IMP, FORALL_PAIR_THM, NOT_EXISTS_THM, .. } := D.core5
  let { FORALL_RELATIVE_TO, RELATIVE_TO_INC, .. } := D.misc
  let { OPEN_IN_INTER, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY,
        prod_topology, .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY_ALT, product_topology, .. } := BProduct1
  let { CONTINUOUS_MAP_PRODUCT_PROJECTION, TOPSPACE_PRODUCT_TOPOLOGY_EMPTY, .. } := BProduct2
  let { COMPACT_IN_EMPTY, COMPACT_IN_SUBSPACE, COMPACT_SPACE_TOPSPACE_EMPTY,
        FINITE_IMP_COMPACT_IN, compact_in, compact_space, .. } := BCompact1
  let { ALEXANDER_SUBBASE_THEOREM_ALT, IMAGE_COMPACT_IN, .. } := BCompact3
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let COMPACT_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        compact_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        compact_space top1 /\ compact_space top2"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THEN
    ASM_SIMP_TAC [COMPACT_SPACE_TOPSPACE_EMPTY] THEN EQ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY,
          CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
      REWRITE_TAC [compact_space] THEN REPEAT STRIP_TAC THENL
       [MP_TAC (← ISPECL [← q r"prod_topology top1 top2:(A#B)topology",
                         ← q r"top1:A topology", ← q r"FST:A#B->A",
                         ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          IMAGE_COMPACT_IN),
        MP_TAC (← ISPECL [← q r"prod_topology top1 top2:(A#B)topology",
                         ← q r"top2:B topology", ← q r"SND:A#B->B",
                         ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          IMAGE_COMPACT_IN)] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN
      ASM_REWRITE_TAC [IMAGE_FST_CROSS, IMAGE_SND_CROSS],
      STRIP_TAC THEN MATCH_MP_TAC ALEXANDER_SUBBASE_THEOREM_ALT THEN
      EXISTS_TAC
       (← q r"{(topspace top1 CROSS v):A#B->bool | open_in top2 v} UNION
        {u CROSS topspace top2 | open_in top1 u}") THEN
      EXISTS_TAC (← q r"(topspace top1 CROSS topspace top2):A#B->bool") THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC (← sr
        r"(?s. s IN f /\ x SUBSET s) ==> x SUBSET UNIONS f") THEN
        REWRITE_TAC [EXISTS_IN_UNION, EXISTS_IN_GSPEC] THEN DISJ2_TAC THEN
        EXISTS_TAC (← q r"topspace top1:A->bool") THEN
        REWRITE_TAC [OPEN_IN_TOPSPACE, SUBSET_REFL],
        GEN_REWRITE_TAC RAND_CONV [prod_topology] THEN
        AP_TERM_TAC THEN AP_TERM_TAC THEN
        MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL
         [REWRITE_TAC [← sr r"s SUBSET t <=> !x. s x ==> x IN t"] THEN
          REWRITE_TAC [FORALL_RELATIVE_TO, FORALL_INTERSECTION_OF] THEN
          REWRITE_TAC [IMP_CONJ] THEN MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
          CONJ_TAC THENL
           [REWRITE_TAC [NOT_IN_EMPTY, INTERS_0, INTER_UNIV, IN_ELIM_THM] THEN
            ASM_MESON_TAC [OPEN_IN_TOPSPACE],
            MAP_EVERY X_GEN_TAC [← q r"c:A#B->bool", ← q r"t:(A#B->bool)->bool"] THEN
            REWRITE_TAC [FORALL_IN_INSERT] THEN DISCH_THEN (fun th =>
              DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN MP_TAC th) THEN
            ASM_REWRITE_TAC [] THEN
            REWRITE_TAC [IN_ELIM_THM, UNION] THEN REPEAT STRIP_TAC THEN
            REWRITE_TAC [INTERS_INSERT] THEN ONCE_REWRITE_TAC [← sr
             r"s INTER t INTER u = (s INTER u) INTER t"] THEN
            ASM_REWRITE_TAC [INTER_CROSS] THEN
            ASM_MESON_TAC [OPEN_IN_INTER, OPEN_IN_TOPSPACE]],
          REWRITE_TAC [← sr r"s SUBSET t <=> !x. x IN s ==> t x"] THEN
          REWRITE_TAC [FORALL_IN_GSPEC] THEN
          MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
          SUBGOAL_THEN
           (← q r"(u CROSS v):A#B->bool =
            (topspace top1 CROSS topspace top2) INTER (u CROSS v)")
          SUBST1_TAC THENL
           [REWRITE_TAC [← sr r"s = u INTER s <=> s SUBSET u"] THEN
            ASM_SIMP_TAC [SUBSET_CROSS, OPEN_IN_SUBSET],
            MATCH_MP_TAC RELATIVE_TO_INC] THEN
          REWRITE_TAC [INTERSECTION_OF] THEN EXISTS_TAC
           (← q r"{(u CROSS topspace top2),(topspace top1 CROSS v)}
            :(A#B->bool)->bool") THEN
          REWRITE_TAC [FINITE_INSERT, FINITE_EMPTY, INTERS_2] THEN
          REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN CONJ_TAC THENL
           [REWRITE_TAC [UNION, IN_ELIM_THM] THEN ASM_MESON_TAC [],
            REWRITE_TAC [INTER_CROSS, CROSS_EQ] THEN
            REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
            SET_TAC []]],
          REWRITE_TAC [FORALL_SUBSET_UNION, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
          ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
          REWRITE_TAC [FORALL_SUBSET_IMAGE, UNIONS_UNION] THEN
          REWRITE_TAC [SUBSET, UNIONS_IMAGE, IN_UNION, IN_ELIM_THM] THEN
          X_GEN_TAC (← q r"v:(B->bool)->bool") THEN DISCH_TAC THEN
          X_GEN_TAC (← q r"u:(A->bool)->bool") THEN DISCH_TAC THEN
          SIMP_TAC [FORALL_PAIR_THM, IN_CROSS] THEN DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE (RAND_CONV o LAND_CONV)
           [TOPSPACE_PROD_TOPOLOGY]) THEN
          REWRITE_TAC [CROSS_EQ_EMPTY, DE_MORGAN_THM] THEN STRIP_TAC THEN
          SUBGOAL_THEN
           (← q r"topspace top1 SUBSET (UNIONS u:A->bool) \/
            topspace top2 SUBSET (UNIONS v:B->bool)")
          STRIP_ASSUME_TAC THENL
           [REWRITE_TAC [SUBSET, IN_UNIONS] THEN ASM SET_TAC [],
            UNDISCH_TAC (← q r"compact_space(top1:A topology)"),
            UNDISCH_TAC (← q r"compact_space(top2:B topology)")] THEN
          REWRITE_TAC [compact_in, compact_space, SUBSET_REFL] THENL
           [DISCH_THEN (MP_TAC o SPEC (← q r"u:(A->bool)->bool")),
            DISCH_THEN (MP_TAC o SPEC (← q r"v:(B->bool)->bool"))] THEN
          ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THENL
           [X_GEN_TAC (← q r"u':(A->bool)->bool") THEN STRIP_TAC THEN EXISTS_TAC
            (← q r"IMAGE (\c. (c:A->bool) CROSS topspace(top2:B topology)) u'"),
            X_GEN_TAC (← q r"v':(B->bool)->bool") THEN STRIP_TAC THEN EXISTS_TAC
            (← q r"IMAGE (\c. topspace(top1:A topology) CROSS (c:B->bool)) v'")] THEN
          ASM_SIMP_TAC [FINITE_IMAGE] THEN
          (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
          MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
          ASM_REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM, IN_CROSS] THEN
          ASM SET_TAC []]])

  let COMPACT_IN_CROSS ← prove
   r"!top1 top2 s:A->bool t:B->bool.
        compact_in (prod_topology top1 top2) (s CROSS t) <=>
        s = {} \/ t = {} \/ compact_in top1 s /\ compact_in top2 t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [COMPACT_IN_SUBSPACE, SUBTOPOLOGY_CROSS] THEN
    REWRITE_TAC [COMPACT_SPACE_PROD_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CROSS, CROSS_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:B->bool) SUBSET topspace top2") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"])

  let COMPACT_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!(tops:K->A topology) t.
        compact_space(product_topology t tops) <=>
        topspace(product_topology t tops) = {} \/
        !k. k IN t ==> compact_space(tops k)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [compact_space] THEN
    ASM_CASES_TAC (← q r"topspace(product_topology t (tops:K->A topology)) = {}") THEN
    ASM_REWRITE_TAC [COMPACT_IN_EMPTY] THEN EQ_TAC THENL
     [REWRITE_TAC [compact_space] THEN REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o
        ISPECL [← q r"(tops:K->A topology) k", ← q r"\(f:K->A). f k"] o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ] IMAGE_COMPACT_IN)) THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN
      REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, SUBSET,
                   FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [IN_IMAGE, EXTENSIONAL] THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:K->A")) THEN
      X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
      EXISTS_TAC
       (← q r"\i. if i = k then a else if i IN t then (z:K->A) i else ARB") THEN
      ASM_REWRITE_TAC [IN_ELIM_THM] THEN ASM_MESON_TAC [],
      DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"t:K->bool = {}") THENL
     [ASM_REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_EMPTY] THEN
      MATCH_MP_TAC FINITE_IMP_COMPACT_IN THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_EMPTY, FINITE_SING, SUBSET_REFL],
      REWRITE_TAC [← GSYM compact_space]] THEN
    MATCH_MP_TAC ALEXANDER_SUBBASE_THEOREM_ALT THEN
    EXISTS_TAC (← q r"{{x:K->A | x k IN u} | k IN t /\ open_in (tops k) u}") THEN
    EXISTS_TAC (← q r"topspace(product_topology t (tops:K->A topology))") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC (← sr
        r"(?s. s IN f /\ x SUBSET s) ==> x SUBSET UNIONS f") THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"k:K") THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"topspace((tops:K->A topology) k)") THEN
      ASM_REWRITE_TAC [OPEN_IN_TOPSPACE] THEN GEN_REWRITE_TAC id [SUBSET] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT] THEN ASM SET_TAC [],
      GEN_REWRITE_TAC RAND_CONV [product_topology] THEN
      REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY_ALT],
      ALL_TAC] THEN
    X_GEN_TAC (← q r"C:((K->A)->bool)->bool") THEN STRIP_TAC THEN
    ASM_CASES_TAC
      (← q r"?k. k IN t /\
           topspace ((tops:K->A topology) k) SUBSET
           UNIONS {u | open_in (tops k) u /\ {x | x k IN u} IN C}")
    THENL
     [FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"k:K") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:K")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
      REWRITE_TAC [SUBSET_REFL] THEN DISCH_THEN (MP_TAC o SPEC
       (← q r"{u | open_in (tops k) u /\ {x:K->A | x k IN u} IN C}")) THEN
      ASM_SIMP_TAC [IN_ELIM_THM] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"D:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"IMAGE (\u. {x:K->A | x k IN u}) D") THEN
      ASM_SIMP_TAC [FINITE_IMAGE] THEN
      CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, TOPSPACE_PRODUCT_TOPOLOGY_ALT, UNIONS_IMAGE] THEN
      ASM SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [NOT_EXISTS_THM]) THEN
      REWRITE_TAC [← TAUT (← q r"~(p /\ q) <=> p ==> ~q"), ← sr
       r"(!x. x IN t ==> ~(f x SUBSET g x)) <=>
        (!x. ?a. x IN t ==> a IN f x /\ ~(a IN g x))"] THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM, SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"z:K->A") THEN DISCH_TAC THEN UNDISCH_TAC
       (← q r"topspace (product_topology t (tops:K->A topology)) SUBSET UNIONS C") THEN
      MATCH_MP_TAC (← sr
       r"(?x. x IN s /\ ~(x IN t)) ==> s SUBSET t ==> Q") THEN
      EXISTS_TAC (← q r"\i. if i IN t then (z:K->A) i else ARB") THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY_ALT, EXTENSIONAL, IN_ELIM_THM] THEN
      ASM_SIMP_TAC [IN_UNIONS] THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP
       (← sr r"t SUBSET s ==> (!x. x IN s ==> x IN t ==> ~P x)
          ==> ~(?x. x IN t /\ P x)")) THEN
      REWRITE_TAC [FORALL_IN_GSPEC] THEN SIMP_TAC [IN_ELIM_THM] THEN
      ASM_MESON_TAC []])

  return { COMPACT_SPACE_PROD_TOPOLOGY, COMPACT_IN_CROSS, COMPACT_SPACE_PRODUCT_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Compact sets, part 5.  (metric.ml 7691-7894)                              -/
/- ------------------------------------------------------------------------- -/

structure Compact5 where
  COMPACT_IN_CARTESIAN_PRODUCT : thm
  TUBE_LEMMA_LEFT : thm
  TUBE_LEMMA_RIGHT : thm
  CLOSED_MAP_FST : thm
  CLOSED_MAP_SND : thm
  WALLACE_THEOREM_PROD_TOPOLOGY : thm
  LOCALLY_FINITE_COVER_OF_COMPACT_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupCompact5 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BIterLocal : IterLocal) (BOpenClosed1 : OpenClosed1)
    (BOpenClosed2 : OpenClosed2) (BProd1 : Prod1) (BProduct1 : Product1) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BCompact1 : Compact1) (BCompact4 : Compact4) :
    ExceptT String IO Compact5 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, CROSS_EMPTY, EMPTY_SUBSET, EXISTS_FINITE_SUBSET_IMAGE,
        EXTENSION, FINITE_IMAGE, FINITE_INSERT, FINITE_SUBSET, FINITE_UNIONS,
        FORALL_FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC, FORALL_IN_IMAGE, FUN_EQ_THM,
        IMAGE_CLAUSES, IMAGE_EQ_EMPTY, IMAGE_FST_CROSS, .. } := D.core1
  let { IN_CROSS, IN_ELIM_THM, IN_INSERT, IN_INTERS, IN_SING, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET, SUBSET_ANTISYM_EQ,
        SUBSET_CARTESIAN_PRODUCT, SUBSET_EMPTY, UNIONS_0, UNIONS_GSPEC, UNIONS_IMAGE, o_DEF,
        o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_EMPTY, OPEN_IN_INTERS, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS,
        .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { locally_finite_in, .. } := BIterLocal
  let { CLOSED_MAP_COMPOSE, .. } := BOpenClosed1
  let { CLOSED_MAP_FIBRE_NEIGHBOURHOOD, .. } := BOpenClosed2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND,
        OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { SUBTOPOLOGY_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { HOMEOMORPHIC_IMP_CLOSED_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBSPACE, COMPACT_SPACE_ALT, compact_in,
        compact_space, .. } := BCompact1
  let { COMPACT_SPACE_PRODUCT_TOPOLOGY, .. } := BCompact4
  -- @@SCOPE END

  let COMPACT_IN_CARTESIAN_PRODUCT ← prove
   r"!tops:K->A topology s k.
        compact_in (product_topology k tops) (cartesian_product k s) <=>
        cartesian_product k s = {} \/
        !i. i IN k ==> compact_in (tops i) (s i)"
   (REWRITE_TAC [COMPACT_IN_SUBSPACE, SUBTOPOLOGY_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [COMPACT_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, o_DEF, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  let TUBE_LEMMA_LEFT ← prove
   r"!top top' (k:A->bool) (y:B) w.
        open_in (prod_topology top top') w /\
        compact_in top k /\
        y IN topspace top' /\
        k CROSS {y} SUBSET w
        ==> ?u v. open_in top u /\ open_in top' v /\
                  k SUBSET u /\ y IN v /\ u CROSS v SUBSET w"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"k:A->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"{}:A->bool", ← q r"topspace top':B->bool"] THEN
      ASM_SIMP_TAC [EMPTY_SUBSET, OPEN_IN_EMPTY, OPEN_IN_TOPSPACE, CROSS_EMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN k
          ==> ?u v. open_in top u /\ open_in top' v /\
                    (x:A) IN u /\ (y:B) IN v /\
                    u CROSS v SUBSET w")
    MP_TAC THENL
     [X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o
        GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_REWRITE_TAC [IN_CROSS, IN_SING],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->A->bool", ← q r"v:A->B->bool"] THEN DISCH_TAC THEN
      FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
        REWRITE_RULE [compact_in]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (u:A->A->bool) k")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"l:A->bool") MP_TAC) THEN
      ASM_CASES_TAC (← q r"l:A->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, SUBSET_EMPTY] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o REWRITE_RULE [SUBSET]) THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (u:A->A->bool) l)") THEN
      EXISTS_TAC (← q r"INTERS(IMAGE (v:A->B->bool) l)") THEN
      ASM_SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_IMAGE, OPEN_IN_INTERS,
                    FINITE_IMAGE, IMAGE_EQ_EMPTY, IN_INTERS] THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
      ASM SET_TAC []])

  let TUBE_LEMMA_RIGHT ← prove
   r"!top top' (x:A) (k:B->bool) w.
        open_in (prod_topology top top') w /\
        compact_in top' k /\
        x IN topspace top /\
        {x} CROSS k SUBSET w
        ==> ?u v. open_in top u /\ open_in top' v /\
                  x IN u /\ k SUBSET v /\ u CROSS v SUBSET w"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"k:B->bool = {}") THENL
     [MAP_EVERY EXISTS_TAC [← q r"topspace top:A->bool", ← q r"{}:B->bool"] THEN
      ASM_SIMP_TAC [EMPTY_SUBSET, OPEN_IN_EMPTY, OPEN_IN_TOPSPACE, CROSS_EMPTY],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN k
          ==> ?u v. open_in top u /\ open_in top' v /\
                    (x:A) IN u /\ (y:B) IN v /\
                    u CROSS v SUBSET w")
    MP_TAC THENL
     [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o
        GEN_REWRITE_RULE id [OPEN_IN_PROD_TOPOLOGY_ALT]) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      ASM_REWRITE_TAC [IN_CROSS, IN_SING],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:B->A->bool", ← q r"v:B->B->bool"] THEN DISCH_TAC THEN
      FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
        REWRITE_RULE [compact_in]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (v:B->B->bool) k")) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"l:B->bool") MP_TAC) THEN
      ASM_CASES_TAC (← q r"l:B->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, SUBSET_EMPTY] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o REWRITE_RULE [SUBSET]) THEN
      EXISTS_TAC (← q r"INTERS(IMAGE (u:B->A->bool) l)") THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (v:B->B->bool) l)") THEN
      ASM_SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_IMAGE, OPEN_IN_INTERS,
                    FINITE_IMAGE, IMAGE_EQ_EMPTY, IN_INTERS] THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
      ASM SET_TAC []])

  let CLOSED_MAP_FST ← prove
   r"!(top:A topology) (top':B topology).
        compact_space top' ==> closed_map(prod_topology top top',top) FST"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IMAGE_FST_CROSS] THEN
    CONJ_TAC THENL [SET_TAC [], REWRITE_TAC [← GSYM IN_SING]] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r <=> ~(p /\ q ==> ~r)")] THEN
    SUBGOAL_THEN
     (← q r"!u. u SUBSET topspace top
          ==> {x:A#B | x IN topspace top CROSS topspace top' /\ FST x IN u} =
              u CROSS topspace top'")
     (fun th => SIMP_TAC [th, OPEN_IN_SUBSET, SING_SUBSET])
    THENL
     [SIMP_TAC [EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS] THEN SET_TAC [],
      MAP_EVERY X_GEN_TAC [← q r"w:A#B->bool", ← q r"x:A"]] THEN
    REWRITE_TAC [NOT_IMP] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"top':B topology", ← q r"x:A",
      ← q r"topspace top':B->bool", ← q r"w:A#B->bool"] TUBE_LEMMA_RIGHT) THEN
    ASM_REWRITE_TAC [← GSYM compact_space] THEN MATCH_MP_TAC MONO_EXISTS THEN
    MESON_TAC [SUBSET_ANTISYM_EQ, OPEN_IN_SUBSET])

  let CLOSED_MAP_SND ← prove
   r"!(top:A topology) (top':B topology).
        compact_space top ==> closed_map(prod_topology top top',top') SND"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"SND = FST o (\x:A#B. SND x,FST x)") SUBST1_TAC THENL
     [REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM], ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_topology top' top:(B#A)topology") THEN
    ASM_SIMP_TAC [CLOSED_MAP_FST] THEN
    MATCH_MP_TAC HOMEOMORPHIC_IMP_CLOSED_MAP THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS] THEN EXISTS_TAC (← q r"\x:B#A. SND x,FST x") THEN
    REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_PAIRED] THEN
    REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND])

  let WALLACE_THEOREM_PROD_TOPOLOGY ← prove
   r"!top top' w (k:A->bool) (l:B->bool).
        compact_in top k /\ compact_in top' l /\
        open_in (prod_topology top top') w /\
        k CROSS l SUBSET w
        ==> ?u v. open_in top u /\ open_in top' v /\
                  k SUBSET u /\ l SUBSET v /\ u CROSS v SUBSET w"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!y. y IN l
          ==> ?u v. open_in top u /\ open_in top' v /\
                    k SUBSET u /\ y IN v /\
                    u CROSS v SUBSET (w:A#B->bool)")
    MP_TAC THENL
     [REPEAT STRIP_TAC THEN MATCH_MP_TAC TUBE_LEMMA_LEFT THEN
      ASM_REWRITE_TAC [] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE)) THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN ASM SET_TAC [],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:B->A->bool", ← q r"v:B->B->bool"] THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"compact_in top' (l:B->bool)") THEN REWRITE_TAC [compact_in] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"IMAGE (v:B->B->bool) l"))) THEN
      ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [EXISTS_FINITE_SUBSET_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"m:B->bool") MP_TAC) THEN
      ASM_CASES_TAC (← q r"m:B->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, SUBSET_EMPTY] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o REWRITE_RULE [SUBSET]) THENL
       [MAP_EVERY EXISTS_TAC [← q r"topspace top:A->bool", ← q r"{}:B->bool"] THEN
        ASM_REWRITE_TAC [OPEN_IN_EMPTY, OPEN_IN_TOPSPACE, CROSS_EMPTY] THEN
        ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, EMPTY_SUBSET],
        EXISTS_TAC (← q r"INTERS(IMAGE (u:B->A->bool) m)") THEN
        EXISTS_TAC (← q r"UNIONS(IMAGE (v:B->B->bool) m)") THEN
        ASM_SIMP_TAC [OPEN_IN_UNIONS, FORALL_IN_IMAGE, OPEN_IN_INTERS,
                      FINITE_IMAGE, IMAGE_EQ_EMPTY, IN_INTERS] THEN
        ASM_REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
        RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, FORALL_PAIR_THM, IN_CROSS]) THEN
        ASM SET_TAC []]])

  let LOCALLY_FINITE_COVER_OF_COMPACT_SPACE ← prove
   r"!(top:A topology) u.
        compact_space top /\
        topspace top SUBSET UNIONS u /\
        locally_finite_in top u
        ==> FINITE u"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, LEFT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    X_GEN_TAC (← q r"t:A->A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [COMPACT_SPACE_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (t:A->A->bool) (topspace top)")) THEN
    ASM_SIMP_TAC [UNIONS_IMAGE, FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] THEN
    REWRITE_TAC [FORALL_FINITE_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC FINITE_SUBSET THEN EXISTS_TAC
      (← q r"{} INSERT
       UNIONS {{c | c IN u /\ ~(c INTER (t:A->A->bool) a = {})} | a IN k}") THEN
    ASM_SIMP_TAC [FINITE_UNIONS, FORALL_IN_GSPEC, UNIONS_GSPEC,
                  FINITE_INSERT] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, SIMPLE_IMAGE] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SUBSET, IN_INSERT, NOT_IN_EMPTY, EXTENSION, IN_ELIM_THM] THEN
    ASM SET_TAC [])

  return { COMPACT_IN_CARTESIAN_PRODUCT, TUBE_LEMMA_LEFT, TUBE_LEMMA_RIGHT, CLOSED_MAP_FST,
           CLOSED_MAP_SND, WALLACE_THEOREM_PROD_TOPOLOGY, LOCALLY_FINITE_COVER_OF_COMPACT_SPACE }

/- ------------------------------------------------------------------------- -/
/- Separated sets.  (metric.ml 7896-8097)                                    -/
/- ------------------------------------------------------------------------- -/

structure Separated where
  separated_in : thm
  SEPARATED_IN_EMPTY : thm
  SEPARATED_IN_REFL : thm
  SEPARATED_IN_SYM : thm
  SEPARATED_IN_IMP_DISJOINT : thm
  SEPARATED_IN_MONO : thm
  SEPARATED_IN_OPEN_SETS : thm
  SEPARATED_IN_CLOSED_SETS : thm
  SEPARATED_IN_COMPLEMENT : thm
  SEPARATED_IN_SUBTOPOLOGY : thm
  SEPARATED_IN_DISCRETE_TOPOLOGY : thm
  SEPARATED_EQ_DISTINGUISHABLE : thm
  SEPARATED_IN_UNION : thm
  SEPARATED_IN_UNIONS : thm
  SEPARATED_IN_DIFFS : thm
  SEPARATION_CLOSED_IN_UNION_GEN : thm
  SEPARATION_OPEN_IN_UNION_GEN : thm
  SEPARATED_IN_FULL : thm
  HOMEOMORPHIC_MAP_SEPARATION : thm
  deriving Inhabited

@[nospecialize]
def setupSeparated [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) :
    ExceptT String IO Separated := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ACI, CONJ_SYM, DISJOINT, DISJOINT_EMPTY_REFL, EMPTY_SUBSET, EMPTY_UNIONS,
        FORALL_IN_GSPEC, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, INTER_EMPTY, INTER_UNIONS, IN_ELIM_THM, IN_SING,
        .. } := D.core2
  let { SUBSET_EMPTY, SUBSET_INTER, SUBSET_TRANS, SUBSET_UNION, UNIONS_SUBSET, UNWIND_THM2,
        .. } := D.core4
  let { EQ_IMP, MONO_AND, .. } := D.core5
  let { CLOSED_IN_SUBSET, OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        closed_in, .. } := BTopology
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_INTER_CLOSURE_OF, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_EMPTY, CLOSURE_OF_MONO,
        CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_SUBSET_TOPSPACE,
        CLOSURE_OF_SUBTOPOLOGY, CLOSURE_OF_UNION, CLOSURE_OF_UNIONS,
        DISCRETE_TOPOLOGY_CLOSURE_OF, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, closure_of,
        .. } := BClosure
  let { HOMEOMORPHIC_IMP_INJECTIVE_MAP, HOMEOMORPHIC_IMP_SURJECTIVE_MAP, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_CLOSURE_OF, .. } := BHomeo2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let separated_in ← new_definition
   r"separated_in top s t <=>
     s SUBSET topspace top /\ t SUBSET topspace top /\
     s INTER top closure_of t = {} /\ t INTER top closure_of s = {}"

  let SEPARATED_IN_EMPTY ← prove
   r"(!top s:A->bool. separated_in top s {} <=> s SUBSET topspace top) /\
   (!top s:A->bool. separated_in top {} s <=> s SUBSET topspace top)"
   (REWRITE_TAC [separated_in, CLOSURE_OF_EMPTY, EMPTY_SUBSET, INTER_EMPTY])

  let SEPARATED_IN_REFL ← prove
   r"!top s:A->bool. separated_in top s s <=> s = {}"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [SEPARATED_IN_EMPTY, EMPTY_SUBSET] THEN
    REWRITE_TAC [separated_in, DISJOINT_EMPTY_REFL] THEN
    SIMP_TAC [CLOSURE_OF_SUBSET, IMP_CONJ, ← sr
      r"s SUBSET t ==> s INTER t = s"])

  let SEPARATED_IN_SYM ← prove
   r"!top s t:A->bool.
        separated_in top s t <=> separated_in top t s"
   (REWRITE_TAC [separated_in, CONJ_ACI])

  let SEPARATED_IN_IMP_DISJOINT ← prove
   r"!top s t:A->bool. separated_in top s t ==> DISJOINT s t"
   (REWRITE_TAC [separated_in] THEN REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] CLOSURE_OF_SUBSET) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let SEPARATED_IN_MONO ← prove
   r"!top s t s' t':A->bool.
        separated_in top s t /\ s' SUBSET s /\ t' SUBSET t
        ==> separated_in top s' t'"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [separated_in, ← GSYM SUBSET_EMPTY] THEN
    REPEAT (MATCH_MP_TAC MONO_AND THEN CONJ_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] SUBSET_TRANS) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← sr
     r"s SUBSET s' /\ t SUBSET t' ==> s INTER t SUBSET s' INTER t'") THEN
    ASM_SIMP_TAC [CLOSURE_OF_MONO])

  let SEPARATED_IN_OPEN_SETS ← prove
   r"!top s t:A->bool.
        open_in top s /\ open_in top t
        ==> (separated_in top s t <=> DISJOINT s t)"
   (REWRITE_TAC [DISJOINT, separated_in] THEN
    SIMP_TAC [OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY, OPEN_IN_SUBSET] THEN
    SET_TAC [])

  let SEPARATED_IN_CLOSED_SETS ← prove
   r"!top s t:A->bool.
        closed_in top s /\ closed_in top t
        ==> (separated_in top s t <=> DISJOINT s t)"
   (SIMP_TAC [CLOSURE_OF_CLOSED_IN, separated_in, CLOSED_IN_SUBSET] THEN
    SET_TAC [])

  let SEPARATED_IN_COMPLEMENT ← prove
   r"!top s:A->bool.
        separated_in top s (topspace top DIFF s) <=>
        closed_in top s /\ open_in top s"
   (SIMP_TAC [separated_in, CLOSURE_OF_SUBSET_TOPSPACE, ← sr
     r"c SUBSET u /\ d SUBSET u
      ==> (s SUBSET u /\ u DIFF s SUBSET u /\
           s INTER c = {} /\ (u DIFF s) INTER d = {} <=>
           s SUBSET u /\ c SUBSET u DIFF s /\ d SUBSET s)"] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ, OPEN_IN_CLOSED_IN_EQ] THEN
    SET_TAC [])

  let SEPARATED_IN_SUBTOPOLOGY ← prove
   r"!top u s t:A->bool.
        separated_in (subtopology top u) s t <=>
        s SUBSET u /\ t SUBSET u /\ separated_in top s t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_in, CLOSURE_OF_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET u") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:A->bool) SUBSET u") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> s INTER u INTER t = s INTER t"])

  let SEPARATED_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s t:A->bool.
        separated_in (discrete_topology u) s t <=>
        s SUBSET u /\ t SUBSET u /\ DISJOINT s t"
   (REWRITE_TAC [separated_in, DISCRETE_TOPOLOGY_CLOSURE_OF] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN SET_TAC [])

  let SEPARATED_EQ_DISTINGUISHABLE ← prove
   r"!top x y:A.
        separated_in top {x} {y} <=>
        x IN topspace top /\ y IN topspace top /\
        (?u. open_in top u /\ x IN u /\ ~(y IN u)) /\
        (?v. open_in top v /\ y IN v /\ ~(x IN v))"
   (REWRITE_TAC [separated_in, closure_of, IN_ELIM_THM, IN_SING, UNWIND_THM2] THEN
    SET_TAC [])

  let SEPARATED_IN_UNION ← prove
   r"(!top s t u:A->bool.
        separated_in top s (t UNION u) <=>
        separated_in top s t /\ separated_in top s u) /\
   (!top s t u:A->bool.
        separated_in top (s UNION t) u <=>
        separated_in top s u /\ separated_in top t u)"
   (REWRITE_TAC [separated_in, CLOSURE_OF_UNION] THEN SET_TAC [])

  let SEPARATED_IN_UNIONS ← prove
   r"(!top s u:(A->bool)->bool.
        FINITE u
        ==> (separated_in top s (UNIONS u) <=>
             s SUBSET topspace top /\ !t. t IN u ==> separated_in top s t)) /\
   (!top s u:(A->bool)->bool.
        FINITE u
        ==> (separated_in top (UNIONS u) s <=>
             (!t. t IN u ==> separated_in top s t) /\ s SUBSET topspace top))"
   (SIMP_TAC [separated_in, CLOSURE_OF_UNIONS] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [INTER_UNIONS, UNIONS_SUBSET] THEN
    REWRITE_TAC [EMPTY_UNIONS, FORALL_IN_GSPEC] THEN SET_TAC [])

  let SEPARATED_IN_DIFFS ← prove
   r"!top s t:A->bool.
        open_in top s /\ open_in top t \/ closed_in top s /\ closed_in top t
        ==> separated_in top (s DIFF t) (t DIFF s)"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN (← q r"(s:A->bool) SUBSET topspace top /\ t SUBSET topspace top")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, CLOSED_IN_SUBSET],
      ASM_REWRITE_TAC [separated_in]] THEN
    REPLICATE_TAC 2 (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    FIRST_X_ASSUM (DISJ_CASES_THEN STRIP_ASSUME_TAC) THENL
     [CONJ_TAC THEN
      MATCH_MP_TAC (← sr r"s INTER u = {} ==> (s DIFF t) INTER u = {}"),
      CONJ_TAC THEN FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
       r"w SUBSET u
        ==> (u DIFF x) INTER v = {} ==> (w DIFF x) INTER v = {}"))] THEN
     ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE,
                   OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY] THEN
    ASM SET_TAC [])

  let SEPARATION_CLOSED_IN_UNION_GEN ← prove
   r"!top s t:A->bool.
        separated_in top s t <=>
        s SUBSET topspace top /\ t SUBSET topspace top /\ DISJOINT s t /\
        closed_in (subtopology top (s UNION t)) s /\
        closed_in (subtopology top (s UNION t)) t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_in, CLOSED_IN_INTER_CLOSURE_OF] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] CLOSURE_OF_SUBSET) THEN
    SET_TAC [])

  let SEPARATION_OPEN_IN_UNION_GEN ← prove
   r"!top s t:A->bool.
        separated_in top s t <=>
        s SUBSET topspace top /\ t SUBSET topspace top /\ DISJOINT s t /\
        open_in (subtopology top (s UNION t)) s /\
        open_in (subtopology top (s UNION t)) t"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, SUBSET_UNION] THEN
    ASM_SIMP_TAC [SEPARATION_CLOSED_IN_UNION_GEN] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"DISJOINT (s:A->bool) t") THEN ASM_REWRITE_TAC [] THEN
    GEN_REWRITE_TAC RAND_CONV [CONJ_SYM] THEN BINOP_TAC THEN
    AP_TERM_TAC THEN ASM SET_TAC [])

  let SEPARATED_IN_FULL ← prove
   r"!top s t:A->bool.
        s UNION t = topspace top
        ==> (separated_in top s t <=>
             DISJOINT s t /\
             closed_in top s /\ open_in top s /\
             closed_in top t /\ open_in top t)"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [SEPARATION_OPEN_IN_UNION_GEN] THEN
    REWRITE_TAC [SUBTOPOLOGY_TOPSPACE] THEN EQ_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET, CLOSED_IN_SUBSET] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [closed_in] THEN CONJ_TAC THENL
     [UNDISCH_TAC (← q r"open_in top (t:A->bool)"),
      UNDISCH_TAC (← q r"open_in top (s:A->bool)")] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_SEPARATION ← prove
   r"!(f:A->B) top top' s t.
        homeomorphic_map (top,top') f /\
        s SUBSET topspace top /\ t SUBSET topspace top
        ==> (separated_in top' (IMAGE f s) (IMAGE f t) <=>
             separated_in top s t)"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [separated_in] THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP HOMEOMORPHIC_IMP_SURJECTIVE_MAP) THEN
    ASM_SIMP_TAC [IMAGE_SUBSET] THEN BINOP_TAC THEN
    MATCH_MP_TAC (← sr
     r"!u. IMAGE f t = t' /\ s SUBSET u /\ t SUBSET u /\
          (!x y. x IN u /\ y IN u /\ f x = f y ==> x = y)
          ==> (IMAGE f s INTER t' = {} <=> s INTER t = {})") THEN
    EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_MAP_CLOSURE_OF,
                   HOMEOMORPHIC_IMP_INJECTIVE_MAP])

  return { separated_in, SEPARATED_IN_EMPTY, SEPARATED_IN_REFL, SEPARATED_IN_SYM,
           SEPARATED_IN_IMP_DISJOINT, SEPARATED_IN_MONO, SEPARATED_IN_OPEN_SETS,
           SEPARATED_IN_CLOSED_SETS, SEPARATED_IN_COMPLEMENT, SEPARATED_IN_SUBTOPOLOGY,
           SEPARATED_IN_DISCRETE_TOPOLOGY, SEPARATED_EQ_DISTINGUISHABLE, SEPARATED_IN_UNION,
           SEPARATED_IN_UNIONS, SEPARATED_IN_DIFFS, SEPARATION_CLOSED_IN_UNION_GEN,
           SEPARATION_OPEN_IN_UNION_GEN, SEPARATED_IN_FULL, HOMEOMORPHIC_MAP_SEPARATION }

/- ------------------------------------------------------------------------- -/
/- T_1 spaces, part 1.  (metric.ml 8099-8282)                                -/
/- ------------------------------------------------------------------------- -/

structure T1a where
  t1_space : thm
  T1_SPACE_EXPANSIVE : thm
  T1_SPACE_ALT : thm
  T1_SPACE_SEPARATED_IN : thm
  T1_SPACE_DERIVED_SET_OF_SING : thm
  T1_SPACE_DERIVED_SET_OF_FINITE : thm
  T1_SPACE_CLOSED_IN_SING : thm
  CLOSED_IN_T1_SING : thm
  T1_SPACE_CLOSED_IN_FINITE : thm
  CLOSURE_OF_SING : thm
  SEPARATED_IN_SING : thm
  T1_SPACE_OPEN_IN_DELETE : thm
  T1_SPACE_OPEN_IN_DELETE_ALT : thm
  T1_SPACE_SING_INTERS_OPEN : thm
  T1_SPACE_INTERS_OPEN_SUPERSETS : thm
  T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN : thm
  FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY : thm
  T1_SPACE_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupT1a [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BDerived : Derived) (BClosure : Closure) (BSeparated : Separated) :
    ExceptT String IO T1a := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, DIFF_EMPTY, EMPTY_UNIONS, EXISTS_IN_GSPEC, EXTENSION, FINITE_IMAGE,
        FINITE_INTER, FINITE_SING, FINITE_SUBSET, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INFINITE, INTERS_GSPEC, INTER_COMM, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_SING,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SUBSET, SUBSET_ANTISYM, UNIONS_SINGS, .. } := D.core4
  let { RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_TOPSPACE, CLOSED_IN_UNIONS, EXISTS_CLOSED_IN,
        FORALL_OPEN_IN, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { DERIVED_SET_OF_RESTRICT, DERIVED_SET_OF_SUBSET_TOPSPACE, DERIVED_SET_OF_UNIONS,
        DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET, OPEN_IN_INTER_DERIVED_SET_OF_SUBSET,
        derived_set_of, .. } := BDerived
  let { CLOSED_IN_CONTAINS_DERIVED_SET, CLOSURE_OF_CLOSED_IN, CLOSURE_OF_EMPTY,
        CLOSURE_OF_RESTRICT, CLOSURE_OF_SUBSET, .. } := BClosure
  let { SEPARATED_EQ_DISTINGUISHABLE, separated_in, .. } := BSeparated
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let t1_space ← new_definition
   r"t1_space top <=>
  !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
        ==> ?u. open_in top u /\ x IN u /\ ~(y IN u)"

  let T1_SPACE_EXPANSIVE ← prove
   r"!top top':A topology.
         topspace top' = topspace top /\ (!u. open_in top u ==> open_in top' u)
         ==> t1_space top ==> t1_space top'"
   (REWRITE_TAC [t1_space] THEN METIS_TAC [])

  let T1_SPACE_ALT ← prove
   r"!top:A topology.
        t1_space top <=>
        !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
              ==> ?u. closed_in top u /\ x IN u /\ ~(y IN u)"
   (SIMP_TAC [t1_space, EXISTS_CLOSED_IN, IN_DIFF] THEN MESON_TAC [])

  let T1_SPACE_SEPARATED_IN ← prove
   r"!top:A topology.
        t1_space top <=>
        !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
              ==> separated_in top {x} {y}"
   (SIMP_TAC [t1_space, SEPARATED_EQ_DISTINGUISHABLE] THEN MESON_TAC [])

  let T1_SPACE_DERIVED_SET_OF_SING ← prove
   r"!top:A topology.
      t1_space top <=> !x. x IN topspace top ==> top derived_set_of {x} = {}"
   (GEN_TAC THEN REWRITE_TAC [t1_space, derived_set_of, ← sr
     r"(?y. P y /\ y IN {a} /\ Q y) <=> P a /\ Q a"] THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    MESON_TAC [OPEN_IN_TOPSPACE])

  let T1_SPACE_DERIVED_SET_OF_FINITE ← prove
   r"!top:A topology.
      t1_space top <=> !s. FINITE s ==> top derived_set_of s = {}"
   (GEN_TAC THEN REWRITE_TAC [T1_SPACE_DERIVED_SET_OF_SING] THEN
    EQ_TAC THEN SIMP_TAC [FINITE_SING] THEN REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [DERIVED_SET_OF_RESTRICT] THEN
    GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [← GSYM UNIONS_SINGS] THEN
    ASM_SIMP_TAC [DERIVED_SET_OF_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE, IN_INTER,
                  FINITE_INTER, EMPTY_UNIONS, FORALL_IN_IMAGE])

  let T1_SPACE_CLOSED_IN_SING ← prove
   r"!top:A topology.
      t1_space top <=> !x. x IN topspace top ==> closed_in top {x}"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [T1_SPACE_DERIVED_SET_OF_SING, CLOSED_IN_CONTAINS_DERIVED_SET] THEN
      REWRITE_TAC [NOT_IN_EMPTY, SING_SUBSET] THEN SET_TAC [],
      DISCH_TAC THEN REWRITE_TAC [T1_SPACE_ALT] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"{x:A}") THEN ASM_SIMP_TAC [IN_SING]])

  let CLOSED_IN_T1_SING ← prove
   r"!top a:A. t1_space top /\ a IN topspace top ==> closed_in top {a}"
   (MESON_TAC [T1_SPACE_CLOSED_IN_SING])

  let T1_SPACE_CLOSED_IN_FINITE ← prove
   r"!top:A topology.
      t1_space top <=>
      !s. FINITE s /\ s SUBSET topspace top ==> closed_in top s"
   (GEN_TAC THEN REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN
    EQ_TAC THEN SIMP_TAC [FINITE_SING, SING_SUBSET] THEN REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM UNIONS_SINGS] THEN
    MATCH_MP_TAC CLOSED_IN_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, FORALL_IN_IMAGE, FINITE_IMAGE] THEN
    ASM SET_TAC [])

  let CLOSURE_OF_SING ← prove
   r"!top a:A.
        t1_space top
        ==> top closure_of {a} = if a IN topspace top then {a} else {}"
   (REPEAT STRIP_TAC THEN COND_CASES_TAC THENL
     [MATCH_MP_TAC CLOSURE_OF_CLOSED_IN THEN
      ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING],
      ONCE_REWRITE_TAC [CLOSURE_OF_RESTRICT] THEN
      ASM_SIMP_TAC [← sr r"~(a IN s) ==> s INTER {a} = {}"] THEN
      REWRITE_TAC [CLOSURE_OF_EMPTY]])

  let SEPARATED_IN_SING ← prove
   r"(!top s a:A.
        t1_space top
        ==> (separated_in top {a} s <=>
             a IN topspace top /\ s SUBSET topspace top /\
             ~(a IN top closure_of s))) /\
   (!top s a:A.
        t1_space top
        ==> (separated_in top s {a} <=>
             a IN topspace top /\ s SUBSET topspace top /\
             ~(a IN top closure_of s)))"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [separated_in, CLOSURE_OF_SING] THEN
    ASM_CASES_TAC (← q r"(a:A) IN topspace top") THEN ASM_REWRITE_TAC [] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET) THEN
    ASM SET_TAC [])

  let T1_SPACE_OPEN_IN_DELETE ← prove
   r"!top:A topology.
        t1_space top <=>
        !u x. open_in top u /\ x IN u ==> open_in top (u DELETE x)"
   (GEN_TAC THEN REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN EQ_TAC THENL
     [REWRITE_TAC [← sr r"u DELETE x = u DIFF {x}"] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC OPEN_IN_DIFF THEN ASM_REWRITE_TAC [] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
      DISCH_TAC THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"{x:A} = topspace top DIFF (topspace top DELETE x)")
      SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN
      ASM_SIMP_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE]])

  let T1_SPACE_OPEN_IN_DELETE_ALT ← prove
   r"!top:A topology.
        t1_space top <=> !u x. open_in top u ==> open_in top (u DELETE x)"
   (REWRITE_TAC [T1_SPACE_OPEN_IN_DELETE] THEN
    MESON_TAC [← sr r"x IN u \/ u DELETE x = u"])

  let (T1_SPACE_SING_INTERS_OPEN, T1_SPACE_INTERS_OPEN_SUPERSETS) ← CONJ_PAIR (← prove
   r"(!top:A topology.
      t1_space top <=>
      !x. x IN topspace top ==> INTERS {u | open_in top u /\ x IN u} = {x}) /\
   (!top:A topology.
      t1_space top <=>
      !s. s SUBSET topspace top
          ==> INTERS {u | open_in top u /\ s SUBSET u} = s)"
   (REWRITE_TAC [AND_FORALL_THM] THEN GEN_TAC THEN MATCH_MP_TAC (← TAUT (← q
     r"(r ==> q) /\ (q ==> p) /\ (p ==> r)
      ==> (p <=> q) /\ (p <=> r)")) THEN
    REPEAT CONJ_TAC THENL
     [SIMP_TAC [← GSYM SING_SUBSET],
      REWRITE_TAC [t1_space, INTERS_GSPEC] THEN SET_TAC [],
      REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN
      DISCH_TAC THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [INTERS_GSPEC] THEN MATCH_MP_TAC SUBSET_ANTISYM THEN
      CONJ_TAC THENL [GEN_REWRITE_TAC id [SUBSET], SET_TAC []] THEN
      REWRITE_TAC [FORALL_OPEN_IN, IN_ELIM_THM, IMP_CONJ] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_THEN (fun th => tactic_of do
        pure (MP_TAC (← SPEC (← q r"{x:A}") th) THEN
              MP_TAC (← SPEC (← q r"{}:A->bool") th))) THEN
      ASM_SIMP_TAC [CLOSED_IN_EMPTY, DIFF_EMPTY] THEN ASM SET_TAC []]))

  let T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN ← prove
   r"!top:A topology.
        t1_space top <=>
        !s. top derived_set_of s =
            {x | x IN topspace top /\
                 !u. x IN u /\ open_in top u ==> INFINITE(s INTER u)}"
   (GEN_TAC THEN EQ_TAC THEN DISCH_TAC THENL
     [REPEAT STRIP_TAC THEN REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN EQ_TAC THENL
       [DISCH_TAC THEN CONJ_TAC THENL
         [ASM_MESON_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE, SUBSET],
          X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [INFINITE] THEN
          REPEAT STRIP_TAC THEN
          FIRST_ASSUM (MP_TAC o SPEC (← q r"s INTER u:A->bool") o
            REWRITE_RULE [T1_SPACE_DERIVED_SET_OF_FINITE]) THEN
          FIRST_ASSUM (MP_TAC o SPEC (← q r"s:A->bool") o MATCH_MP
           OPEN_IN_INTER_DERIVED_SET_OF_SUBSET) THEN
          ASM_REWRITE_TAC [INTER_COMM] THEN ASM SET_TAC []],
        REWRITE_TAC [derived_set_of, IN_ELIM_THM, INFINITE, ← sr
         r"(?y. ~(y = x) /\ y IN s /\ y IN t) <=> ~((s INTER t) SUBSET {x})"] THEN
        MESON_TAC [FINITE_SUBSET, FINITE_SING]],
      ASM_REWRITE_TAC [T1_SPACE_DERIVED_SET_OF_SING] THEN
      REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_ELIM_THM] THEN
      SIMP_TAC [FINITE_INTER, FINITE_SING, INFINITE] THEN
      MESON_TAC [OPEN_IN_TOPSPACE]])

  let FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY ← prove
   r"!top u:A->bool.
        topspace top = u /\ FINITE u /\ t1_space top
        ==> top = discrete_topology u"
   (REPEAT STRIP_TAC THEN CONV_TAC SYM_CONV THEN
    ASM_REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE_DERIVED_SET] THEN
    ASM_MESON_TAC [T1_SPACE_DERIVED_SET_OF_FINITE])

  let T1_SPACE_SUBTOPOLOGY ← prove
   r"!top u:A->bool.
        t1_space top ==> t1_space(subtopology top u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [t1_space, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, IN_INTER] THEN MESON_TAC [])

  return { t1_space, T1_SPACE_EXPANSIVE, T1_SPACE_ALT, T1_SPACE_SEPARATED_IN,
           T1_SPACE_DERIVED_SET_OF_SING, T1_SPACE_DERIVED_SET_OF_FINITE, T1_SPACE_CLOSED_IN_SING,
           CLOSED_IN_T1_SING, T1_SPACE_CLOSED_IN_FINITE, CLOSURE_OF_SING, SEPARATED_IN_SING,
           T1_SPACE_OPEN_IN_DELETE, T1_SPACE_OPEN_IN_DELETE_ALT, T1_SPACE_SING_INTERS_OPEN,
           T1_SPACE_INTERS_OPEN_SUPERSETS, T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN,
           FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY, T1_SPACE_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- T_1 spaces, part 2.  (metric.ml 8284-8410)                                -/
/- ------------------------------------------------------------------------- -/

structure T1b where
  CLOSED_IN_DERIVED_SET_OF_GEN : thm
  DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN_FINITE : thm
  SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE : thm
  T1_SPACE_CLOSED_MAP_IMAGE : thm
  HOMEOMORPHIC_T1_SPACE : thm
  T1_SPACE_RETRACTION_MAP_IMAGE : thm
  T1_SPACE_PROD_TOPOLOGY : thm
  T1_SPACE_PRODUCT_TOPOLOGY : thm
  CARD_LE_TOPSPACE_CLOSED_SETS : thm
  CARD_LE_TOPSPACE_OPEN_SETS : thm
  INFINITE_PERFECT_SET_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupT1b [HolBase] (D : MetricDeps) (BTopology : Topology) (BDerived : Derived)
    (BClosure : Closure) (BOpenClosed1 : OpenClosed1) (BProd1 : Prod1) (BProduct1 : Product1)
    (BProduct3 : Product3) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace)
    (BRetractOf : RetractOf) (BT1a : T1a) : ExceptT String IO T1b := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CARTESIAN_PRODUCT_EQ_EMPTY, CONJ_ASSOC, CROSS_EQ_EMPTY, CROSS_SING, EXTENSION,
        EXTENSIONAL, FORALL_CARTESIAN_PRODUCT_ELEMENTS, FORALL_IN_IMAGE, FUN_EQ_THM,
        .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INFINITE_SUPERSET, INTER_EMPTY, INTER_SUBSET,
        IN_CROSS, IN_ELIM_THM, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM, NOT_INSERT_EMPTY,
        .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SUBSET, cartesian_product, le_c, o_DEF,
        .. } := D.core4
  let { FORALL_PAIR_THM, .. } := D.core5
  let { CARD_EQ_IMP_LE, CARD_EQ_SYM, CARD_LE_TRANS, .. } := D.lib
  let { CARD_EQ_OPEN_CLOSED_IN_SETS, OPEN_IN_INTER, OPEN_IN_TOPSPACE, .. } := BTopology
  let { DERIVED_SET_OF_SUBSET_TOPSPACE, IN_DERIVED_SET_OF, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY,
        SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN, .. } := BDerived
  let { CLOSED_IN_CONTAINS_DERIVED_SET, DERIVED_SET_SUBSET, .. } := BClosure
  let { closed_map, .. } := BOpenClosed1
  let { CLOSED_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { CLOSED_IN_CARTESIAN_PRODUCT, .. } := BProduct3
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { T1_SPACE_CLOSED_IN_SING, T1_SPACE_DERIVED_SET_OF_FINITE,
        T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN, T1_SPACE_SUBTOPOLOGY, t1_space,
        .. } := BT1a
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CLOSED_IN_DERIVED_SET_OF_GEN ← prove
   r"!top s:A->bool. t1_space top ==> closed_in top (top derived_set_of s)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [CLOSED_IN_CONTAINS_DERIVED_SET] THEN
    REWRITE_TAC [DERIVED_SET_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x'':A") THEN
    REWRITE_TAC [IN_DERIVED_SET_OF] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u:A->bool")) THEN ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"x':A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [t1_space]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"x':A", ← q r"x'':A"]) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"v:A->bool") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"u INTER v:A->bool")) THEN
    ASM_SIMP_TAC [IN_INTER, OPEN_IN_INTER] THEN ASM SET_TAC [])

  let DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN ← prove
   r"!top s:A->bool.
        t1_space top
        ==> top derived_set_of (top derived_set_of s) SUBSET
            top derived_set_of s"
   (SIMP_TAC [DERIVED_SET_SUBSET, DERIVED_SET_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [CLOSED_IN_DERIVED_SET_OF_GEN])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN_FINITE ← prove
   r"!top s:A->bool.
        t1_space top /\ FINITE s
        ==> subtopology top s = discrete_topology(topspace top INTER s)"
   (REWRITE_TAC [T1_SPACE_DERIVED_SET_OF_FINITE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN THEN
    ASM_SIMP_TAC [INTER_EMPTY])

  let SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE ← prove
   r"!top s:A->bool.
        t1_space top /\ s SUBSET topspace top /\ FINITE s
        ==> subtopology top s = discrete_topology s"
   (REWRITE_TAC [T1_SPACE_DERIVED_SET_OF_FINITE] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY THEN
    ASM_SIMP_TAC [INTER_EMPTY])

  let T1_SPACE_CLOSED_MAP_IMAGE ← prove
   r"!f:A->B top top'.
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        t1_space top
        ==> t1_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [T1_SPACE_CLOSED_IN_SING, closed_map] THEN
    STRIP_TAC THEN FIRST_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [FORALL_IN_IMAGE] THEN
    ONCE_REWRITE_TAC [← sr r"{f x} = IMAGE f {x}"] THEN
    ASM_SIMP_TAC [])

  let HOMEOMORPHIC_T1_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (t1_space top <=> t1_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN STRIP_TAC THEN
    EQ_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] T1_SPACE_CLOSED_MAP_IMAGE)) THEN
    ASM_MESON_TAC [])

  let T1_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ t1_space top ==> t1_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [T1_SPACE_SUBTOPOLOGY, HOMEOMORPHIC_T1_SPACE])

  let T1_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        t1_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        t1_space top1 /\ t1_space top2"
   (REWRITE_TAC [T1_SPACE_CLOSED_IN_SING, FORALL_PAIR_THM] THEN
    REWRITE_TAC [← GSYM CROSS_SING, CLOSED_IN_CROSS, NOT_INSERT_EMPTY] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, CROSS_EQ_EMPTY, IN_CROSS] THEN
    SET_TAC [])

  let T1_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!tops:K->A topology k.
        t1_space (product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        !i. i IN k ==> t1_space (tops i)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, IMP_IMP, RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [o_DEF, ← GSYM FORALL_CARTESIAN_PRODUCT_ELEMENTS] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    AP_TERM_TAC THEN ABS_TAC THEN
    W (MP_TAC o PART_MATCH (rand o rand) CLOSED_IN_CARTESIAN_PRODUCT o
      rand o rand o snd) THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, NOT_INSERT_EMPTY] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p ==> q <=> p ==> r)")) THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
    DISCH_TAC THEN AP_TERM_TAC THEN
    REWRITE_TAC [EXTENSION, IN_SING, IN_ELIM_THM] THEN
    REWRITE_TAC [FUN_EQ_THM] THEN ASM_MESON_TAC [])

  let CARD_LE_TOPSPACE_CLOSED_SETS ← prove
   r"!top:A topology. t1_space top ==> topspace top <=_c {s | closed_in top s}"
   (REWRITE_TAC [T1_SPACE_CLOSED_IN_SING] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [le_c] THEN EXISTS_TAC (← q r"\x:A. {x}") THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN SET_TAC [])

  let CARD_LE_TOPSPACE_OPEN_SETS ← prove
   r"!top:A topology. t1_space top ==> topspace top <=_c {s | open_in top s}"
   (GEN_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP CARD_LE_TOPSPACE_CLOSED_SETS) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_TRANS) THEN
    MATCH_MP_TAC CARD_EQ_IMP_LE THEN ONCE_REWRITE_TAC [CARD_EQ_SYM] THEN
    REWRITE_TAC [CARD_EQ_OPEN_CLOSED_IN_SETS])

  let INFINITE_PERFECT_SET_GEN ← prove
   r"!top s:A->bool.
        t1_space top /\ s SUBSET top derived_set_of s /\ ~(s = {})
        ==> INFINITE s"
   (REWRITE_TAC [T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN] THEN
    REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?a:A. a IN top derived_set_of s") MP_TAC THENL
     [ASM SET_TAC [], ASM_REWRITE_TAC [IN_ELIM_THM]] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A")
      (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"topspace top:A->bool")))) THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
    MESON_TAC [INFINITE_SUPERSET, INTER_SUBSET])

  return { CLOSED_IN_DERIVED_SET_OF_GEN, DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN,
           SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_GEN_FINITE, SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_FINITE,
           T1_SPACE_CLOSED_MAP_IMAGE, HOMEOMORPHIC_T1_SPACE, T1_SPACE_RETRACTION_MAP_IMAGE,
           T1_SPACE_PROD_TOPOLOGY, T1_SPACE_PRODUCT_TOPOLOGY, CARD_LE_TOPSPACE_CLOSED_SETS,
           CARD_LE_TOPSPACE_OPEN_SETS, INFINITE_PERFECT_SET_GEN }

/- ------------------------------------------------------------------------- -/
/- Hausdorff spaces, part 1.  (metric.ml 8412-8645)                          -/
/- ------------------------------------------------------------------------- -/

structure Hausdorff1 where
  hausdorff_space : thm
  HAUSDORFF_SPACE_EXPANSIVE : thm
  HAUSDORFF_SPACE_TOPSPACE_EMPTY : thm
  HAUSDORFF_IMP_T1_SPACE : thm
  CLOSED_IN_DERIVED_SET_OF : thm
  T1_OR_HAUSDORFF_SPACE : thm
  HAUSDORFF_SPACE_SING_INTERS_OPENS : thm
  HAUSDORFF_SPACE_SING_INTERS_CLOSED : thm
  HAUSDORFF_SPACE_SUBTOPOLOGY : thm
  HAUSDORFF_SPACE_COMPACT_SEPARATION : thm
  HAUSDORFF_SPACE_COMPACT_SETS : thm
  COMPACT_IN_IMP_CLOSED_IN : thm
  CLOSED_IN_HAUSDORFF_SING : thm
  CLOSED_IN_HAUSDORFF_SING_EQ : thm
  HAUSDORFF_SPACE_DISCRETE_TOPOLOGY : thm
  COMPACT_IN_INTER : thm
  FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY : thm
  DERIVED_SET_OF_FINITE : thm
  DERIVED_SET_OF_SING : thm
  CLOSED_IN_HAUSDORFF_FINITE : thm
  OPEN_IN_HAUSDORFF_DELETE : thm
  CLOSED_IN_HAUSDORFF_FINITE_EQ : thm
  DERIVED_SET_OF_INFINITE_OPEN_IN : thm
  deriving Inhabited

@[nospecialize]
def setupHausdorff1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BInterior : Interior)
    (BCompact1 : Compact1) (BT1a : T1a) (BT1b : T1b) : ExceptT String IO Hausdorff1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, METIS_TAC, SET_RULE, SET_TAC, new_definition,
        .. } := D
  let { EXISTS_FINITE_SUBSET_IMAGE, EXISTS_IN_GSPEC, FINITE_IMAGE, FINITE_SING,
        FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SKOLEM_THM, SUBSET, UNIONS_IMAGE, .. } := D.core4
  let { MONO_AND, RIGHT_EXISTS_AND_THM, RIGHT_EXISTS_IMP_THM, RIGHT_IMP_EXISTS_THM,
        .. } := D.core5
  let { CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, EXISTS_CLOSED_IN, OPEN_IN_EMPTY, OPEN_IN_INTERS,
        OPEN_IN_SUBOPEN, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, closed_in,
        .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { closure_of, .. } := BClosure
  let { INTERIOR_OF_COMPLEMENT, INTERIOR_OF_SUBSET, INTERIOR_OF_TOPSPACE, .. } := BInterior
  let { COMPACT_INTER_CLOSED_IN, COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE,
        FINITE_IMP_COMPACT_IN, compact_in, .. } := BCompact1
  let { FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY, T1_SPACE_CLOSED_IN_FINITE,
        T1_SPACE_DERIVED_SET_OF_FINITE, T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN,
        T1_SPACE_OPEN_IN_DELETE_ALT, T1_SPACE_SING_INTERS_OPEN, t1_space, .. } := BT1a
  let { CLOSED_IN_DERIVED_SET_OF_GEN, .. } := BT1b
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let hausdorff_space ← new_definition
   r"hausdorff_space (top:A topology) <=>
        !x y. x IN topspace top /\ y IN topspace top /\ ~(x = y)
              ==> ?u v. open_in top u /\ open_in top v /\ x IN u /\ y IN v /\
                        DISJOINT u v"

  let HAUSDORFF_SPACE_EXPANSIVE ← prove
   r"!top top':A topology.
         topspace top' = topspace top /\ (!u. open_in top u ==> open_in top' u)
         ==> hausdorff_space top ==> hausdorff_space top'"
   (REWRITE_TAC [hausdorff_space] THEN METIS_TAC [])

  let HAUSDORFF_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> hausdorff_space top"
   (SIMP_TAC [hausdorff_space, NOT_IN_EMPTY])

  let HAUSDORFF_IMP_T1_SPACE ← prove
   r"!top:A topology. hausdorff_space top ==> t1_space top"
   (REWRITE_TAC [hausdorff_space, t1_space] THEN SET_TAC [])

  let CLOSED_IN_DERIVED_SET_OF ← prove
   r"!(top:A topology) s.
        hausdorff_space top ==> closed_in top (top derived_set_of s)"
   (MESON_TAC [CLOSED_IN_DERIVED_SET_OF_GEN, HAUSDORFF_IMP_T1_SPACE])

  let T1_OR_HAUSDORFF_SPACE ← prove
   r"!top:A topology.
        t1_space top \/ hausdorff_space top <=> t1_space top"
   (MESON_TAC [HAUSDORFF_IMP_T1_SPACE])

  let HAUSDORFF_SPACE_SING_INTERS_OPENS ← prove
   r"!top a:A.
        hausdorff_space top /\ a IN topspace top
        ==> INTERS {u | open_in top u /\ a IN u} =  {a}"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM T1_SPACE_SING_INTERS_OPEN] THEN
    REWRITE_TAC [HAUSDORFF_IMP_T1_SPACE])

  let HAUSDORFF_SPACE_SING_INTERS_CLOSED ← prove
   r"!top:A topology.
      hausdorff_space top <=>
      !x. x IN topspace top
          ==> INTERS {u | closed_in top u /\ x IN top interior_of u} = {x}"
   (REWRITE_TAC [← sr r"s = {a} <=> a IN s /\ !b. ~(b = a) ==> ~(b IN s)"] THEN
    REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IMP_CONJ] THEN
    REWRITE_TAC [← REWRITE_RULE [SUBSET] INTERIOR_OF_SUBSET] THEN
    GEN_TAC THEN REWRITE_TAC [NOT_FORALL_THM, NOT_IMP, ← MESON [] (← q
     r"(!x. x IN s ==> !y. ~(y = x) ==> R x y) <=>
      (!x y. x IN s /\ ~(y IN s) ==> R x y) /\
      (!y x. y IN s /\ x IN s /\ ~(y = x) ==> R x y)")] THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p <=> r) ==> (p <=> q /\ r)")) THEN CONJ_TAC THENL
     [MESON_TAC [CLOSED_IN_TOPSPACE, INTERIOR_OF_TOPSPACE], ALL_TAC] THEN
    REWRITE_TAC [hausdorff_space, EXISTS_CLOSED_IN] THEN
    SIMP_TAC [INTERIOR_OF_COMPLEMENT, IN_DIFF, RIGHT_EXISTS_AND_THM] THEN
    SIMP_TAC [closure_of, IN_ELIM_THM] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [])

  let HAUSDORFF_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        hausdorff_space top ==> hausdorff_space(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hausdorff_space, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, RIGHT_EXISTS_AND_THM] THEN
    REWRITE_TAC [EXISTS_IN_GSPEC, IN_INTER] THEN
    REPEAT (MATCH_MP_TAC MONO_FORALL THEN GEN_TAC) THEN
    DISCH_THEN (fun th => STRIP_TAC THEN MP_TAC th) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC THEN
    MATCH_MP_TAC MONO_AND THEN REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN SET_TAC [])

  let HAUSDORFF_SPACE_COMPACT_SEPARATION ← do
    let lemma ← prove
     r"!top s a:A.
        hausdorff_space top /\ compact_in top s /\
        a IN topspace top /\ ~(a IN s)
        ==> ?u v. open_in top u /\ open_in top v /\ DISJOINT u v /\
                  a IN u /\ s SUBSET v"
     (REWRITE_TAC [hausdorff_space, compact_in] THEN REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
       [MAP_EVERY EXISTS_TAC [← q r"topspace top:A->bool", ← q r"{}:A->bool"] THEN
        ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o GEN (← q r"x:A") o SPECL [← q r"x:A", ← q r"a:A"]) THEN
      ASM_REWRITE_TAC [] THEN
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->A->bool", ← q r"v:A->A->bool"] THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (u:A->A->bool) s")) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      ANTS_TAC THENL [SIMP_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"INTERS(IMAGE (v:A->A->bool) k)") THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (u:A->A->bool) k)") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC OPEN_IN_INTERS THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
        ASM SET_TAC [],
        CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_UNIONS, ALL_TAC] THEN
        ASM SET_TAC []])
    prove
     r"!top s t:A->bool.
        hausdorff_space top /\
        compact_in top s /\ compact_in top t /\ DISJOINT s t
        ==> ?u v. open_in top u /\ open_in top v /\
                  s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
     (REPEAT STRIP_TAC THEN
      ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
       [MAP_EVERY EXISTS_TAC [← q r"{}:A->bool", ← q r"topspace top:A->bool"] THEN
        ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY] THEN
        ASM_SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE] THEN ASM SET_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"!x:A. ?u v.
          x IN s ==> open_in top u /\ open_in top v /\
                     x IN u /\ t SUBSET v /\ DISJOINT u v")
      MP_TAC THENL
       [X_GEN_TAC (← q r"x:A") THEN REWRITE_TAC [RIGHT_EXISTS_IMP_THM] THEN DISCH_TAC THEN
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool", ← q r"x:A"]
            lemma) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], MESON_TAC []] THEN
        REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE)) THEN
        ASM SET_TAC [],
        REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->A->bool", ← q r"v:A->A->bool"] THEN DISCH_TAC THEN
      UNDISCH_TAC (← q r"compact_in top (s:A->bool)") THEN REWRITE_TAC [compact_in] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (MP_TAC o SPEC (← q r"IMAGE (u:A->A->bool) s"))) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      ANTS_TAC THENL [SIMP_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [UNIONS_IMAGE, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"k:A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"UNIONS(IMAGE (u:A->A->bool) k)") THEN
      EXISTS_TAC (← q r"INTERS(IMAGE (v:A->A->bool) k)") THEN
      CONJ_TAC THENL [MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC OPEN_IN_INTERS THEN ASM_SIMP_TAC [FINITE_IMAGE] THEN
      ASM SET_TAC [])

  let HAUSDORFF_SPACE_COMPACT_SETS ← prove
   r"!top:A topology.
        hausdorff_space top <=>
        !s t. compact_in top s /\ compact_in top t /\ DISJOINT s t
              ==> ?u v. open_in top u /\ open_in top v /\
                        s SUBSET u /\ t SUBSET v /\ DISJOINT u v"
   (GEN_TAC THEN EQ_TAC THEN SIMP_TAC [HAUSDORFF_SPACE_COMPACT_SEPARATION] THEN
    DISCH_TAC THEN REWRITE_TAC [hausdorff_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"{y:A}"]) THEN
    ASM_REWRITE_TAC [SING_SUBSET, COMPACT_IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MESON_TAC []])

  let COMPACT_IN_IMP_CLOSED_IN ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ compact_in top s ==> closed_in top s"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
    ASM_REWRITE_TAC [closed_in] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"{y:A}", ← q r"s:A->bool"]
      HAUSDORFF_SPACE_COMPACT_SEPARATION) THEN
    ASM_REWRITE_TAC [COMPACT_IN_SING] THEN
    ANTS_TAC THENL [ASM SET_TAC [], MATCH_MP_TAC MONO_EXISTS] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CLOSED_IN_HAUSDORFF_SING ← prove
   r"!top x:A. hausdorff_space top /\ x IN topspace top ==> closed_in top {x}"
   (MESON_TAC [COMPACT_IN_IMP_CLOSED_IN, FINITE_IMP_COMPACT_IN, FINITE_SING,
               SING_SUBSET])

  let CLOSED_IN_HAUSDORFF_SING_EQ ← prove
   r"!top x:A. hausdorff_space top
             ==> (closed_in top {x} <=> x IN topspace top)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN ASM_SIMP_TAC [CLOSED_IN_HAUSDORFF_SING] THEN
    DISCH_THEN (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN SET_TAC [])

  let HAUSDORFF_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. hausdorff_space(discrete_topology u)"
   (GEN_TAC THEN REWRITE_TAC [hausdorff_space, OPEN_IN_DISCRETE_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"{x:A}", ← q r"{y:A}"] THEN ASM SET_TAC [])

  let COMPACT_IN_INTER ← prove
   r"!top s t:A->bool.
        hausdorff_space top /\ compact_in top s /\ compact_in top t
        ==> compact_in top (s INTER t)"
   (MESON_TAC [COMPACT_IN_IMP_CLOSED_IN, COMPACT_INTER_CLOSED_IN])

  let FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY ← prove
   r"!top:A topology.
        topspace top = u /\ FINITE u /\ hausdorff_space top
        ==> top = discrete_topology u"
   (ASM_MESON_TAC [HAUSDORFF_IMP_T1_SPACE,
                   FINITE_T1_SPACE_IMP_DISCRETE_TOPOLOGY])

  let DERIVED_SET_OF_FINITE ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ FINITE s ==> top derived_set_of s = {}"
   (MESON_TAC [T1_SPACE_DERIVED_SET_OF_FINITE, HAUSDORFF_IMP_T1_SPACE])

  let DERIVED_SET_OF_SING ← prove
   r"!top x:A. hausdorff_space top ==> top derived_set_of {x} = {}"
   (SIMP_TAC [DERIVED_SET_OF_FINITE, FINITE_SING])

  let CLOSED_IN_HAUSDORFF_FINITE ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ s SUBSET topspace top /\ FINITE s
        ==> closed_in top s"
   (MESON_TAC [T1_SPACE_CLOSED_IN_FINITE, HAUSDORFF_IMP_T1_SPACE])

  let OPEN_IN_HAUSDORFF_DELETE ← prove
   r"!top s x:A.
        hausdorff_space top /\ open_in top s ==> open_in top (s DELETE x)"
   (MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, HAUSDORFF_IMP_T1_SPACE])

  let CLOSED_IN_HAUSDORFF_FINITE_EQ ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ FINITE s
        ==> (closed_in top s <=> s SUBSET topspace top)"
   (MESON_TAC [CLOSED_IN_HAUSDORFF_FINITE, CLOSED_IN_SUBSET])

  let DERIVED_SET_OF_INFINITE_OPEN_IN ← prove
   r"!top s:A->bool.
        hausdorff_space top
        ==> top derived_set_of s =
            {x | x IN topspace top /\
                 !u. x IN u /\ open_in top u ==> INFINITE(s INTER u)}"
   (REWRITE_TAC [RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [← GSYM T1_SPACE_DERIVED_SET_OF_INFINITE_OPEN_IN] THEN
    REWRITE_TAC [HAUSDORFF_IMP_T1_SPACE])

  return { hausdorff_space, HAUSDORFF_SPACE_EXPANSIVE, HAUSDORFF_SPACE_TOPSPACE_EMPTY,
           HAUSDORFF_IMP_T1_SPACE, CLOSED_IN_DERIVED_SET_OF, T1_OR_HAUSDORFF_SPACE,
           HAUSDORFF_SPACE_SING_INTERS_OPENS, HAUSDORFF_SPACE_SING_INTERS_CLOSED,
           HAUSDORFF_SPACE_SUBTOPOLOGY, HAUSDORFF_SPACE_COMPACT_SEPARATION,
           HAUSDORFF_SPACE_COMPACT_SETS, COMPACT_IN_IMP_CLOSED_IN, CLOSED_IN_HAUSDORFF_SING,
           CLOSED_IN_HAUSDORFF_SING_EQ, HAUSDORFF_SPACE_DISCRETE_TOPOLOGY, COMPACT_IN_INTER,
           FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY, DERIVED_SET_OF_FINITE, DERIVED_SET_OF_SING,
           CLOSED_IN_HAUSDORFF_FINITE, OPEN_IN_HAUSDORFF_DELETE, CLOSED_IN_HAUSDORFF_FINITE_EQ,
           DERIVED_SET_OF_INFINITE_OPEN_IN }

/- ------------------------------------------------------------------------- -/
/- Hausdorff spaces, part 2.  (metric.ml 8647-8925)                          -/
/- ------------------------------------------------------------------------- -/

structure Hausdorff2 where
  HAUSDORFF_SPACE_DISCRETE_COMPACT_IN : thm
  HAUSDORFF_SPACE_FINITE_TOPSPACE : thm
  DERIVED_SET_OF_DERIVED_SET_SUBSET : thm
  HAUSDORFF_SPACE_INJECTIVE_PREIMAGE : thm
  HOMEOMORPHIC_HAUSDORFF_SPACE : thm
  HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE : thm
  COMPACT_HAUSDORFF_SPACE_OPTIMAL : thm
  CONTINUOUS_IMP_CLOSED_MAP : thm
  CONTINUOUS_IMP_QUOTIENT_MAP : thm
  CONTINUOUS_IMP_HOMEOMORPHIC_MAP : thm
  CONTINUOUS_IMP_EMBEDDING_MAP : thm
  CONTINUOUS_INVERSE_MAP : thm
  HAUSDORFF_SPACE_PROD_TOPOLOGY : thm
  HAUSDORFF_SPACE_PRODUCT_TOPOLOGY : thm
  HAUSDORFF_SPACE_POINTWISE_TOPOLOGY : thm
  HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD : thm
  INFINITE_PERFECT_SET : thm
  deriving Inhabited

@[nospecialize]
def setupHausdorff2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BDerived : Derived) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient)
    (BProd1 : Prod1) (BProduct1 : Product1) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace)
    (BEmbedding : Embedding) (BRetractOf : RetractOf) (BCompact1 : Compact1)
    (BCompact2 : Compact2) (BCompact3 : Compact3) (BT1b : T1b) (BHausdorff1 : Hausdorff1) (BProduct4 : Product4) :
    ExceptT String IO Hausdorff2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_TAC, .. } := D
  let { ARBITRARY_UNION_OF_INC, CONJ_ASSOC, CROSS_EQ_EMPTY, DISJOINT_CROSS, EXISTS_IN_GSPEC,
        EXTENSIONAL, FINITE_INTERSECTION_OF_INC, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IMP_IMP, INJECTIVE_ON_ALT, IN_CROSS, IN_ELIM_THM, IN_INTER,
        LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SUBSET_REFL, cartesian_product, o_DEF, .. } := D.core4
  let { DE_MORGAN_THM, EQ_IMP, FORALL_AND_THM, FORALL_PAIR_THM, PAIR_EQ, RIGHT_AND_EXISTS_THM,
        RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { RELATIVE_TO_INC, .. } := D.misc
  let { CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_INTER, OPEN_IN_TOPSPACE,
        OPEN_IN_UNION, TOPOLOGY_EQ, TOPOLOGY_FINER_CLOSED_IN, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ, derived_set_of, .. } := BDerived
  let { CONTINUOUS_MAP_CLOSED_IN, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, continuous_map,
        .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { closed_map, .. } := BOpenClosed1
  let { CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, .. } := BQuotient
  let { OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { OPEN_IN_PRODUCT_TOPOLOGY, TOPSPACE_PRODUCT_TOPOLOGY, .. } := BProduct1
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, homeomorphic_map,
        .. } := BHomeo1
  let { TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT, TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT,
        homeomorphic_space, .. } := BHomeoSpace
  let { embedding_map, .. } := BEmbedding
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_CONTRACTIVE, COMPACT_IN_SUBTOPOLOGY,
        FINITE_IMP_COMPACT_IN, compact_space, .. } := BCompact1
  let { DISCRETE_COMPACT_IN_EQ_FINITE, .. } := BCompact2
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN, INFINITE_PERFECT_SET_GEN, .. } := BT1b
  let { COMPACT_IN_IMP_CLOSED_IN, FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY, HAUSDORFF_IMP_T1_SPACE,
        HAUSDORFF_SPACE_DISCRETE_TOPOLOGY, HAUSDORFF_SPACE_SUBTOPOLOGY, hausdorff_space,
        .. } := BHausdorff1
  let { pointwise_topology, .. } := BProduct4
  -- @@SCOPE END

  let HAUSDORFF_SPACE_DISCRETE_COMPACT_IN ← prove
   r"!top s:A->bool.
        hausdorff_space top
        ==> (s INTER top derived_set_of s = {} /\ compact_in top s <=>
             s SUBSET topspace top /\ FINITE s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [DISCRETE_COMPACT_IN_EQ_FINITE], STRIP_TAC] THEN
    ASM_SIMP_TAC [FINITE_IMP_COMPACT_IN] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"]
      SUBTOPOLOGY_EQ_DISCRETE_TOPOLOGY_EQ) THEN
    ASM_REWRITE_TAC [] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC FINITE_TOPSPACE_IMP_DISCRETE_TOPOLOGY THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    ASM SET_TAC [])

  let HAUSDORFF_SPACE_FINITE_TOPSPACE ← prove
   r"!top:A topology.
        hausdorff_space top
        ==> (top derived_set_of (topspace top) = {} /\ compact_space top <=>
             FINITE(topspace top))"
   (GEN_TAC THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"topspace top:A->bool") o MATCH_MP
      HAUSDORFF_SPACE_DISCRETE_COMPACT_IN) THEN
    REWRITE_TAC [SUBSET_REFL] THEN DISCH_THEN (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [← GSYM compact_space] THEN
    REWRITE_TAC [derived_set_of] THEN SET_TAC [])

  let DERIVED_SET_OF_DERIVED_SET_SUBSET ← prove
   r"!top s:A->bool.
        hausdorff_space top
        ==> top derived_set_of (top derived_set_of s) SUBSET
            top derived_set_of s"
   (SIMP_TAC [DERIVED_SET_OF_DERIVED_SET_SUBSET_GEN,
              HAUSDORFF_IMP_T1_SPACE])

  let HAUSDORFF_SPACE_INJECTIVE_PREIMAGE ← prove
   r"!top top' f:A->B.
       continuous_map (top,top') f /\
       (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y) /\
       hausdorff_space top'
       ==> hausdorff_space top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [hausdorff_space, continuous_map] THEN
    REWRITE_TAC [INJECTIVE_ON_ALT] THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"(f:A->B) x", ← q r"(f:A->B) y"]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"{x | x IN topspace top /\ (f:A->B) x IN u}",
      ← q r"{x | x IN topspace top /\ (f:A->B) x IN v}"] THEN
    ASM_SIMP_TAC [] THEN ASM SET_TAC [])

  let HOMEOMORPHIC_HAUSDORFF_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (hausdorff_space top <=> hausdorff_space top')"
   (REPEAT GEN_TAC THEN REWRITE_TAC [homeomorphic_space] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN STRIP_TAC THEN
    EQ_TAC THEN MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ]
     (← REWRITE_RULE [CONJ_ASSOC] HAUSDORFF_SPACE_INJECTIVE_PREIMAGE)) THEN
    ASM_MESON_TAC [])

  let HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ hausdorff_space top
        ==> hausdorff_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, HOMEOMORPHIC_HAUSDORFF_SPACE])

  let COMPACT_HAUSDORFF_SPACE_OPTIMAL ← prove
   r"!top top':A topology.
        topspace top' = topspace top /\
        (!u. open_in top u ==> open_in top' u) /\
        hausdorff_space top /\ compact_space top'
        ==> top' = top"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [TOPOLOGY_EQ, FORALL_AND_THM, ← TAUT (← q
     r"(p <=> q) <=> (p ==> q) /\ (q ==> p)")] THEN
    ASM_SIMP_TAC [TOPOLOGY_FINER_CLOSED_IN] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_IMP, RIGHT_IMP_FORALL_THM]
          COMPACT_IN_CONTRACTIVE) THEN
    EXISTS_TAC (← q r"top':A topology") THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
    ASM_REWRITE_TAC [])

  let CONTINUOUS_IMP_CLOSED_MAP ← prove
   r"!top top' f:A->B.
        compact_space top /\ hausdorff_space top' /\
        continuous_map (top,top') f
        ==> closed_map (top,top') f"
   (REWRITE_TAC [closed_map] THEN
    MESON_TAC [IMAGE_COMPACT_IN, COMPACT_IN_IMP_CLOSED_IN,
               CLOSED_IN_COMPACT_SPACE])

  let CONTINUOUS_IMP_QUOTIENT_MAP ← prove
   r"!top top' f:A->B.
        compact_space top /\ hausdorff_space top' /\
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> quotient_map (top,top') f"
   (MESON_TAC [CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, CONTINUOUS_IMP_CLOSED_MAP])

  let CONTINUOUS_IMP_HOMEOMORPHIC_MAP ← prove
   r"!top top' f:A->B.
        compact_space top /\ hausdorff_space top' /\
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        (!x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y))
        ==> homeomorphic_map(top,top') f"
   (REWRITE_TAC [homeomorphic_map] THEN MESON_TAC [CONTINUOUS_IMP_QUOTIENT_MAP])

  let CONTINUOUS_IMP_EMBEDDING_MAP ← prove
   r"!top top' f:A->B.
        compact_space top /\ hausdorff_space top' /\
        continuous_map (top,top') f /\
        (!x y. x IN topspace top /\ y IN topspace top
               ==> (f x = f y <=> x = y))
        ==> embedding_map(top,top') f"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [embedding_map] THEN
    MATCH_MP_TAC CONTINUOUS_IMP_HOMEOMORPHIC_MAP THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    ASM_REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    SET_TAC [])

  let CONTINUOUS_INVERSE_MAP ← prove
   r"!top top' (f:A->B) g s.
        compact_space top /\ hausdorff_space top' /\
        continuous_map (top,top') f /\
        (!x. x IN topspace top ==> g(f x) = x) /\
        s SUBSET IMAGE f (topspace top)
        ==> continuous_map(subtopology top' s,top) g"
   (REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CONTINUOUS_MAP_FROM_SUBTOPOLOGY_MONO THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) (topspace top)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC] THEN
    MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
    CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"c:A->bool") o MATCH_MP
     (← REWRITE_RULE [IMP_CONJ_ALT] IMAGE_COMPACT_IN)) THEN
    ASM_SIMP_TAC [CLOSED_IN_COMPACT_SPACE] THEN MATCH_MP_TAC EQ_IMP THEN
    AP_TERM_TAC THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let HAUSDORFF_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        hausdorff_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        hausdorff_space top1 /\ hausdorff_space top2"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PROD_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_HAUSDORFF_SPACE] THEN
      SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC (← q r"(topspace top1 CROSS topspace top2):A#B->bool = {}") THEN
    ASM_REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THENL
     [ASM_REWRITE_TAC [hausdorff_space, TOPSPACE_PROD_TOPOLOGY, NOT_IN_EMPTY],
      FIRST_X_ASSUM (MP_TAC o REWRITE_RULE [CROSS_EQ_EMPTY]) THEN
      REWRITE_TAC [DE_MORGAN_THM] THEN STRIP_TAC] THEN
    STRIP_TAC THEN REWRITE_TAC [hausdorff_space, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS, PAIR_EQ] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B", ← q r"x':A", ← q r"y':B"] THEN
    ASM_CASES_TAC (← q r"y':B = y") THEN ASM_REWRITE_TAC [] THEN STRIP_TAC THENL
     [UNDISCH_TAC (← q r"hausdorff_space(top1:A topology)"),
      UNDISCH_TAC (← q r"hausdorff_space(top2:B topology)")] THEN
    REWRITE_TAC [hausdorff_space] THENL
     [DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"x':A"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(u CROSS topspace top2):A#B->bool") THEN
      EXISTS_TAC (← q r"(v CROSS topspace top2):A#B->bool"),
      DISCH_THEN (MP_TAC o SPECL [← q r"y:B", ← q r"y':B"]) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(topspace top1 CROSS u):A#B->bool") THEN
      EXISTS_TAC (← q r"(topspace top1 CROSS v):A#B->bool")] THEN
    ASM_REWRITE_TAC [OPEN_IN_CROSS, OPEN_IN_TOPSPACE, IN_CROSS] THEN
    ASM_REWRITE_TAC [DISJOINT_CROSS])

  let HAUSDORFF_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!tops:K->A topology k.
        hausdorff_space (product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        !i. i IN k ==> hausdorff_space (tops i)"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MATCH_MP_TAC TOPOLOGICAL_PROPERTY_OF_PRODUCT_COMPONENT THEN
      REWRITE_TAC [HOMEOMORPHIC_HAUSDORFF_SPACE] THEN
      SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY],
      ALL_TAC] THEN
    ASM_CASES_TAC
     (← q r"cartesian_product k (topspace o (tops:K->A topology)) = {}") THEN
    ASM_REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THENL
     [ASM_REWRITE_TAC [hausdorff_space, TOPSPACE_PRODUCT_TOPOLOGY, NOT_IN_EMPTY],
      ALL_TAC] THEN
    DISCH_TAC THEN REWRITE_TAC [hausdorff_space, FUN_EQ_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:K->A", ← q r"g:K->A"] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> r ==> p /\ q ==> s")] THEN
    REWRITE_TAC [NOT_FORALL_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"m:K") THEN DISCH_TAC THEN
    DISCH_THEN (fun th => STRIP_ASSUME_TAC th THEN MP_TAC th) THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product] THEN
    REWRITE_TAC [IN_ELIM_THM, o_DEF, EXTENSIONAL] THEN
    ASM_CASES_TAC (← q r"(m:K) IN k") THENL [STRIP_TAC, ASM_MESON_TAC []] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE RAND_CONV [hausdorff_space] o
        SPEC (← q r"m:K")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"(f:K->A) m", ← q r"(g:K->A) m"]) THEN
    ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"topspace(product_topology k tops) INTER {x:K->A | x m IN u}",
      ← q r"topspace(product_topology k tops) INTER {x:K->A | x m IN v}"] THEN
    ASM_REWRITE_TAC [IN_ELIM_THM, CONJ_ASSOC, IN_INTER] THEN
    CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
    REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY] THEN CONJ_TAC THEN
    MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
    MATCH_MP_TAC RELATIVE_TO_INC THEN
    MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"m:K") THENL
     [EXISTS_TAC (← q r"u:A->bool"), EXISTS_TAC (← q r"v:A->bool")] THEN
    ASM_REWRITE_TAC [])

  let HAUSDORFF_SPACE_POINTWISE_TOPOLOGY ← prove
   r"!s:(A->B)->bool. hausdorff_space(pointwise_topology s)"
   (GEN_TAC THEN REWRITE_TAC [pointwise_topology] THEN
    MATCH_MP_TAC HAUSDORFF_SPACE_SUBTOPOLOGY THEN
    REWRITE_TAC [HAUSDORFF_SPACE_PRODUCT_TOPOLOGY,
                HAUSDORFF_SPACE_DISCRETE_TOPOLOGY])

  let HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD ← prove
   r"!top:A topology.
        hausdorff_space top <=>
        !x. x IN topspace top
            ==> ?u c. open_in top u /\
                      closed_in top c /\
                      hausdorff_space(subtopology top c) /\
                      x IN u /\
                      u SUBSET c"
   (GEN_TAC THEN EQ_TAC THENL
     [SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
      MESON_TAC [OPEN_IN_TOPSPACE, CLOSED_IN_TOPSPACE, SUBSET_REFL],
      DISCH_TAC] THEN
    REWRITE_TAC [hausdorff_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"c:A->bool"] THEN STRIP_TAC THEN
    ASM_CASES_TAC (← q r"(y:A) IN c") THENL
     [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [hausdorff_space]) THEN
      DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
      ASM_REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, RIGHT_EXISTS_AND_THM] THEN
      ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT]] THEN
      REWRITE_TAC [EXISTS_IN_GSPEC] THEN REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN
      REWRITE_TAC [LEFT_IMP_EXISTS_THM, IN_INTER] THEN
      MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"w:A->bool"] THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"u INTER v:A->bool") THEN
      EXISTS_TAC (← q r"w UNION (topspace top DIFF c):A->bool") THEN
      ASM_SIMP_TAC [OPEN_IN_INTER] THEN
      ASM_SIMP_TAC [OPEN_IN_UNION, OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
      ASM SET_TAC [],
      MAP_EVERY EXISTS_TAC [← q r"u:A->bool", ← q r"topspace top DIFF c:A->bool"] THEN
      ASM_SIMP_TAC [OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN ASM SET_TAC []])

  let INFINITE_PERFECT_SET ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ s SUBSET top derived_set_of s /\ ~(s = {})
        ==> INFINITE s"
   (MESON_TAC [INFINITE_PERFECT_SET_GEN, HAUSDORFF_IMP_T1_SPACE])

  return { HAUSDORFF_SPACE_DISCRETE_COMPACT_IN, HAUSDORFF_SPACE_FINITE_TOPSPACE,
           DERIVED_SET_OF_DERIVED_SET_SUBSET, HAUSDORFF_SPACE_INJECTIVE_PREIMAGE,
           HOMEOMORPHIC_HAUSDORFF_SPACE, HAUSDORFF_SPACE_RETRACTION_MAP_IMAGE,
           COMPACT_HAUSDORFF_SPACE_OPTIMAL, CONTINUOUS_IMP_CLOSED_MAP,
           CONTINUOUS_IMP_QUOTIENT_MAP, CONTINUOUS_IMP_HOMEOMORPHIC_MAP,
           CONTINUOUS_IMP_EMBEDDING_MAP, CONTINUOUS_INVERSE_MAP, HAUSDORFF_SPACE_PROD_TOPOLOGY,
           HAUSDORFF_SPACE_PRODUCT_TOPOLOGY, HAUSDORFF_SPACE_POINTWISE_TOPOLOGY, HAUSDORFF_SPACE_CLOSED_NEIGHBOURHOOD,
           INFINITE_PERFECT_SET }

/- ------------------------------------------------------------------------- -/
/- Closed diagonals and graphs.  (metric.ml 8927-9140)                       -/
/- ------------------------------------------------------------------------- -/

structure Diagonal where
  HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL : thm
  CLOSED_MAP_DIAG_EQ : thm
  CLOSED_IN_CONTINUOUS_MAPS_EQ : thm
  FORALL_IN_CLOSURE_OF_EQ : thm
  RETRACT_OF_SPACE_IMP_CLOSED_IN : thm
  WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY : thm
  HOMEOMORPHIC_MAPS_GRAPH : thm
  EMBEDDING_MAP_GRAPH : thm
  CONTINUOUS_MAP_IMP_CLOSED_GRAPH : thm
  CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT : thm
  CLOSED_MAP_PAIRED_CONTINUOUS_MAP_LEFT : thm
  EMBEDDING_MAP_ON_DENSE_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupDiagonal [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BContMap1 : ContMap1)
    (BContMap2 : ContMap2) (BOpenClosed1 : OpenClosed1) (BProd1 : Prod1) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) (BEmbedding : Embedding) (BRetraction : Retraction)
    (BRetractOf : RetractOf) (BHausdorff1 : Hausdorff1) : ExceptT String IO Diagonal := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT, ETA_AX, EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ_ALT, IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_INTER, LEFT_IMP_EXISTS_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, SUBSET_INTER, SUBSET_REFL, o_DEF, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, PAIR_EQ, .. } := D.core5
  let { OPEN_IN_SUBSET, closed_in, .. } := BTopology
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY_SUBSET,
        .. } := BSubtopology
  let { CLOSED_IN_INTER_CLOSURE_OF, FORALL_IN_CLOSURE_OF, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP, CONTINUOUS_MAP_ID,
        OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { CLOSED_MAP_COMPOSE, .. } := BOpenClosed1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_PAIRWISE,
        CONTINUOUS_MAP_SND, OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { HOMEOMORPHIC_IMP_CLOSED_MAP, HOMEOMORPHIC_IMP_CONTINUOUS_MAP, HOMEOMORPHIC_MAPS_MAP,
        homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, HOMEOMORPHIC_MAP_SWAP, .. } := BHomeo2
  let { EMBEDDING_IMP_CLOSED_MAP, EMBEDDING_IMP_CLOSED_MAP_EQ, embedding_map,
        .. } := BEmbedding
  let { SECTION_IMP_EMBEDDING_MAP, retraction_map, retraction_maps, section_map,
        .. } := BRetraction
  let { RETRACTION_MAPS_SECTION_IMAGE, retract_of_space, .. } := BRetractOf
  let { HAUSDORFF_SPACE_SUBTOPOLOGY, hausdorff_space, .. } := BHausdorff1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL ← prove
   r"!top:A topology.
        hausdorff_space top <=>
        closed_in (prod_topology top top) {(x,x) | x IN topspace top}"
   (GEN_TAC THEN REWRITE_TAC [closed_in] THEN
    REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY_ALT, hausdorff_space] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, TOPSPACE_PROD_TOPOLOGY, IN_CROSS,
      NOT_IN_EMPTY, DISJOINT, EXTENSION, IN_INTER, IN_DIFF, FORALL_PAIR_THM] THEN
    REWRITE_TAC [IN_ELIM_THM, PAIR_EQ, ← sr
     r"(?z. P z /\ x = z /\ y = z) <=> P x /\ x = y"] THEN
    REWRITE_TAC [← TAUT (← q r"(p /\ q) /\ ~(p /\ r) <=> p /\ q /\ ~r")] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN AP_TERM_TAC THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    MESON_TAC [← REWRITE_RULE [SUBSET] OPEN_IN_SUBSET])

  let CLOSED_MAP_DIAG_EQ ← prove
   r"!top:A topology.
        closed_map(top,prod_topology top top) (\x. x,x) <=>
        hausdorff_space top"
   (GEN_TAC THEN W (MP_TAC o PART_MATCH (lhand o rand)
      EMBEDDING_IMP_CLOSED_MAP_EQ o lhand o snd) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC SECTION_IMP_EMBEDDING_MAP THEN
      REWRITE_TAC [section_map, retraction_maps] THEN
      EXISTS_TAC (← q r"FST:A#A->A") THEN
      REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID],
      DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [← GSYM SIMPLE_IMAGE, HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL]])

  let CLOSED_IN_CONTINUOUS_MAPS_EQ ← prove
   r"!(f:A->B) g top top'.
        hausdorff_space top' /\
        continuous_map (top,top') f /\
        continuous_map (top,top') g
        ==> closed_in top {x | x IN topspace top /\ f x = g x}"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (f:A->B) x = g x} =
      {x | x IN topspace top /\ (f x,g x) IN {y,y | y IN topspace top'}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [IN_ELIM_THM, PAIR_EQ] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"prod_topology (top':B topology) top'") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED] THEN
      ASM_REWRITE_TAC [← GSYM HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL]])

  let FORALL_IN_CLOSURE_OF_EQ ← prove
   r"!top top' f g:A->B.
        hausdorff_space top' /\
        continuous_map (top,top') f /\ continuous_map (top,top') g /\
        (!x. x IN s ==> f x = g x)
        ==> !x. x IN top closure_of s ==> f x = g x"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    MATCH_MP_TAC FORALL_IN_CLOSURE_OF THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (f:A->B) x = g x} =
      {x | x IN topspace top /\ (f x,g x) IN {(z,z) | z IN topspace top'}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, IN_ELIM_THM, PAIR_EQ] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [CONTINUOUS_MAP]) THEN ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"prod_topology (top':B topology) top'") THEN
      ASM_REWRITE_TAC [← GSYM HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF, ETA_AX]])

  let RETRACT_OF_SPACE_IMP_CLOSED_IN ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ s retract_of_space top ==> closed_in top s"
   (REWRITE_TAC [retract_of_space] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s = {x | x IN topspace top /\ (r:A->A) x = x}") SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map, TOPSPACE_SUBTOPOLOGY]) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAPS_EQ THEN
      EXISTS_TAC (← q r"top:A topology") THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IN_SUBTOPOLOGY]])

  let WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY ← prove
   r"!(P:A topology->bool) (Q:B topology->bool).
        (!top. P top ==> hausdorff_space top) /\
        (!top s. P top /\ closed_in top s ==> P(subtopology top s)) /\
        (!top top'. top homeomorphic_space top' ==> (P top <=> Q top'))
        ==> !top top' r. retraction_map(top,top') r /\ P top ==> Q top'"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [retraction_map]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:B->A") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"subtopology top (IMAGE (s:B->A) (topspace top'))",
      ← q r"top':B topology"]) THEN
    ANTS_TAC THENL [ASM_MESON_TAC [RETRACTION_MAPS_SECTION_IMAGE], ALL_TAC] THEN
    DISCH_THEN (SUBST1_TAC o SYM) THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC RETRACT_OF_SPACE_IMP_CLOSED_IN THEN
    ASM_MESON_TAC [RETRACTION_MAPS_SECTION_IMAGE])

  let HOMEOMORPHIC_MAPS_GRAPH ← prove
   r"!top top' (f:A->B).
        homeomorphic_maps
         (top,subtopology (prod_topology top top')
                          (IMAGE (\x. x,f x) (topspace top)))
         ((\x. x,f x),FST) <=>
        continuous_map(top,top') f"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP] THEN DISCH_THEN
       (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CONTINUOUS_MAP o CONJUNCT1) THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
      DISCH_TAC THEN SUBGOAL_THEN (← q r"(f:A->B) = SND o (\x. x,f x)") SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, ETA_AX],
        ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_SND]],
      DISCH_TAC THEN
      ASM_REWRITE_TAC [homeomorphic_maps, CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRED, SUBSET_REFL, CONTINUOUS_MAP_ID] THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_FST] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IMP_CONJ_ALT] THEN
      REWRITE_TAC [FORALL_IN_IMAGE]])

  let EMBEDDING_MAP_GRAPH ← prove
   r"!top top' (f:A->B).
        embedding_map(top,prod_topology top top') (\x. x,f x) <=>
        continuous_map (top,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [embedding_map] THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_IMP_CONTINUOUS_MAP) THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, SUBSET_REFL] THEN
      DISCH_TAC THEN SUBGOAL_THEN (← q r"(f:A->B) = SND o (\x. x,f x)") SUBST1_TAC THENL
       [REWRITE_TAC [o_DEF, ETA_AX],
        ASM_MESON_TAC [CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_SND]],
      REWRITE_TAC [← GSYM HOMEOMORPHIC_MAPS_GRAPH] THEN
      SIMP_TAC [HOMEOMORPHIC_MAPS_MAP]])

  let CONTINUOUS_MAP_IMP_CLOSED_GRAPH ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f /\ hausdorff_space top'
        ==> closed_in (prod_topology top top') {x,f x | x IN topspace top}"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [closed_in] THEN CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, FORALL_IN_GSPEC, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      REWRITE_TAC [OPEN_IN_PROD_TOPOLOGY_ALT, TOPSPACE_PROD_TOPOLOGY] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN
      REWRITE_TAC [IN_CROSS, IN_DIFF, IN_ELIM_THM, PAIR_EQ] THEN
      ASM_CASES_TAC (← q r"(f:A->B) x = y") THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_THEN (STRIP_ASSUME_TAC o CONJUNCT1)] THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [hausdorff_space]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"(f:A->B) x", ← q r"y:B"]) THEN
    SUBGOAL_THEN (← q r"(f:A->B) x IN topspace top'") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"{x | x IN topspace top /\ (f:A->B) x IN u}") THEN
    EXISTS_TAC (← q r"v:B->bool") THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS, IN_ELIM_THM, IN_DIFF] THEN
      ASM_REWRITE_TAC [PAIR_EQ] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      ASM SET_TAC []])

  let CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f /\ hausdorff_space top'
        ==> closed_map(top,prod_topology top top') (\x. x,f x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC EMBEDDING_IMP_CLOSED_MAP THEN
    ASM_REWRITE_TAC [EMBEDDING_MAP_GRAPH] THEN
    ASM_SIMP_TAC [← GSYM SIMPLE_IMAGE, CONTINUOUS_MAP_IMP_CLOSED_GRAPH])

  let CLOSED_MAP_PAIRED_CONTINUOUS_MAP_LEFT ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f /\ hausdorff_space top'
        ==> closed_map(top,prod_topology top' top) (\x. f x,x)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"(\x. (f:A->B) x,x) = (\(a,b). b,a) o (\x. x,f x)")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF], ALL_TAC] THEN
    MATCH_MP_TAC CLOSED_MAP_COMPOSE THEN
    EXISTS_TAC (← q r"prod_topology top top':(A#B)topology") THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT] THEN
    MATCH_MP_TAC HOMEOMORPHIC_IMP_CLOSED_MAP THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_SWAP])

  let EMBEDDING_MAP_ON_DENSE_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) s.
        hausdorff_space top /\
        s SUBSET topspace top /\
        top closure_of s = topspace top /\
        continuous_map (top,top') f /\
        embedding_map (subtopology top s,top') f
        ==> DISJOINT (IMAGE f s) (IMAGE f (topspace top DIFF s))"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"t = {x | x IN topspace top /\ f x IN IMAGE (f:A->B) s}") THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [embedding_map]) THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN
    REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"f':B->A") THEN REWRITE_TAC [homeomorphic_maps] THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) s SUBSET topspace top'") ASSUME_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET] THEN STRIP_TAC] THEN
    SUBGOAL_THEN (← q r"(s:A->bool) retract_of_space (subtopology top t)")
    MP_TAC THENL
     [ASM_REWRITE_TAC [retract_of_space, TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (p ==> q) ==> p /\ q")) THEN CONJ_TAC THENL
       [ASM SET_TAC [], REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY]] THEN
      SIMP_TAC [← sr r"s SUBSET t ==> t INTER s = s"] THEN DISCH_TAC THEN
      EXISTS_TAC (← q r"(f':B->A) o (f:A->B)") THEN
      ASM_REWRITE_TAC [o_THM] THEN MATCH_MP_TAC CONTINUOUS_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"subtopology top' (IMAGE (f:A->B) s)") THEN
      ASM_REWRITE_TAC [] THEN REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
      ASM SET_TAC [],
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
        RETRACT_OF_SPACE_IMP_CLOSED_IN))] THEN
    ASM_SIMP_TAC [HAUSDORFF_SPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [CLOSED_IN_INTER_CLOSURE_OF] THEN ASM SET_TAC [])

  return { HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL, CLOSED_MAP_DIAG_EQ, CLOSED_IN_CONTINUOUS_MAPS_EQ,
           FORALL_IN_CLOSURE_OF_EQ, RETRACT_OF_SPACE_IMP_CLOSED_IN,
           WEAKLY_HEREDITARY_IMP_RETRACTIVE_PROPERTY, HOMEOMORPHIC_MAPS_GRAPH,
           EMBEDDING_MAP_GRAPH, CONTINUOUS_MAP_IMP_CLOSED_GRAPH,
           CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT, CLOSED_MAP_PAIRED_CONTINUOUS_MAP_LEFT,
           EMBEDDING_MAP_ON_DENSE_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- KC spaces, part 1.  (metric.ml 9142-9358)                                 -/
/- ------------------------------------------------------------------------- -/

structure KC1 where
  kc_space : thm
  KC_SPACE_EXPANSIVE : thm
  COMPACT_IN_IMP_CLOSED_IN_GEN : thm
  HAUSDORFF_IMP_KC_SPACE : thm
  KC_IMP_T1_SPACE : thm
  KC_SPACE_SUBTOPOLOGY : thm
  KC_SPACE_DISCRETE_TOPOLOGY : thm
  KC_SPACE_CONTINUOUS_INJECTIVE_MAP_PREIMAGE : thm
  KC_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_KC_SPACE : thm
  COMPACT_KC_EQ_MAXIMAL_COMPACT_SPACE : thm
  CONTINUOUS_IMP_CLOSED_MAP_GEN : thm
  KC_SPACE_COMPACT_SUBTOPOLOGIES : thm
  KC_SPACE_COMPACT_PROD_TOPOLOGY : thm
  KC_SPACE_PROD_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupKC1 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BBases : Bases) (BClosure : Closure) (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1)
    (BProd1 : Prod1) (BHomeo1 : Homeo1) (BHomeoSpace : HomeoSpace) (BRetraction : Retraction)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BCompact4 : Compact4) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2) (BDiagonal : Diagonal) :
    ExceptT String IO KC1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, ARBITRARY_UNION_OF_INC, FINITE_INSERT, FINITE_INTERSECTION_OF_INC,
        FORALL_SUBSET_INSERT, .. } := D.core1
  let { IMP_CONJ, INJECTIVE_ON_ALT, INSERT, IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_SING,
        IN_UNION, LEFT_IMP_EXISTS_THM, NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, SUBSET_UNION, UNIONS_INSERT, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, FST, LEFT_AND_EXISTS_THM, SND, .. } := D.core5
  let { RELATIVE_TO_INC, .. } := D.misc
  let { OPEN_IN_SUBSET, TOPOLOGY_EQ_ALT, TOPOLOGY_FINER_CLOSED_IN, closed_in, topspace,
        .. } := BTopology
  let { CLOSED_IN_SUBSET_TOPSPACE, SUBTOPOLOGY_SUBTOPOLOGY, .. } := BSubtopology
  let { OPEN_IN_SUBBASE, TOPSPACE_SUBBASE, .. } := BBases
  let { CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_SUBTOPOLOGY,
        .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_CLOSED_IN, CONTINUOUS_MAP_ID,
        .. } := BContMap1
  let { closed_map, .. } := BOpenClosed1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS,
        .. } := BProd1
  let { HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP, retraction_map, retraction_maps,
        .. } := BRetraction
  let { CLOSED_IN_COMPACT_SPACE, COMPACT_IN_CONTRACTIVE, COMPACT_IN_SING,
        COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY, COMPACT_IN_UNION,
        COMPACT_SPACE_SUBTOPOLOGY, compact_in, compact_space, .. } := BCompact1
  let { ALEXANDER_SUBBASE_THEOREM_ALT, IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_DISCRETE_TOPOLOGY, .. } := BHausdorff1
  let { HAUSDORFF_SPACE_PROD_TOPOLOGY, .. } := BHausdorff2
  let { HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL, .. } := BDiagonal
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let kc_space ← new_definition
   r"kc_space (top:A topology) <=> !s. compact_in top s ==> closed_in top s"

  let KC_SPACE_EXPANSIVE ← prove
   r"!top top':A topology.
         topspace top' = topspace top /\ (!u. open_in top u ==> open_in top' u)
         ==> kc_space top ==> kc_space top'"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN REWRITE_TAC [kc_space] THEN
    ASM_MESON_TAC [TOPOLOGY_FINER_CLOSED_IN, COMPACT_IN_CONTRACTIVE])

  let COMPACT_IN_IMP_CLOSED_IN_GEN ← prove
   r"!top s:A->bool. kc_space top /\ compact_in top s ==> closed_in top s"
   (SIMP_TAC [kc_space])

  let HAUSDORFF_IMP_KC_SPACE ← prove
   r"!top:A topology. hausdorff_space top ==> kc_space top"
   (SIMP_TAC [kc_space, COMPACT_IN_IMP_CLOSED_IN])

  let KC_IMP_T1_SPACE ← prove
   r"!top:A topology. kc_space top ==> t1_space top"
   (SIMP_TAC [kc_space, T1_SPACE_CLOSED_IN_SING, COMPACT_IN_SING])

  let KC_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool. kc_space top ==> kc_space(subtopology top s)"
   (REWRITE_TAC [kc_space, COMPACT_IN_SUBTOPOLOGY] THEN
    SIMP_TAC [CLOSED_IN_SUBSET_TOPSPACE])

  let KC_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. kc_space(discrete_topology u)"
   (MESON_TAC [HAUSDORFF_SPACE_DISCRETE_TOPOLOGY, HAUSDORFF_IMP_KC_SPACE])

  let KC_SPACE_CONTINUOUS_INJECTIVE_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B).
      continuous_map(top,top') f /\
      (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y) /\
      kc_space top'
      ==> kc_space top"
   (REPEAT GEN_TAC THEN REWRITE_TAC [INJECTIVE_ON_ALT, kc_space] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"s = {x | x IN topspace top /\ f x IN IMAGE (f:A->B) s}")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      FIRST_ASSUM (MATCH_MP_TAC o CONJUNCT2 o
        REWRITE_RULE [CONTINUOUS_MAP_CLOSED_IN]) THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      ASM_MESON_TAC []])

  let KC_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ kc_space top ==> kc_space top'"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [retraction_map, retraction_maps] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r':B->A") THEN REWRITE_TAC [kc_space] THEN STRIP_TAC THEN
    X_GEN_TAC (← q r"s:B->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"s = {x | x IN topspace top' /\ r' x IN IMAGE (r':B->A) s}")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"top:A topology") THEN
      ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      MATCH_MP_TAC IMAGE_COMPACT_IN THEN ASM_MESON_TAC []])

  let HOMEOMORPHIC_KC_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (kc_space top <=> kc_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    MESON_TAC [KC_SPACE_RETRACTION_MAP_IMAGE])

  let COMPACT_KC_EQ_MAXIMAL_COMPACT_SPACE ← prove
   r"!top:A topology.
        compact_space top
        ==> (kc_space top <=>
             !top'. topspace top' = topspace top /\
                    (!s. open_in top s ==> open_in top' s) /\
                    compact_space top'
                    ==> top' = top)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [kc_space] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"top':A topology") THEN
      SIMP_TAC [IMP_CONJ, TOPOLOGY_FINER_CLOSED_IN] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [TOPOLOGY_EQ_ALT] THEN
      ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE, COMPACT_IN_CONTRACTIVE,
                     TOPOLOGY_FINER_CLOSED_IN],
      X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
      FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
      GEN_REWRITE_TAC id [← TAUT (← q r"p <=> ~p ==> F")] THEN DISCH_TAC THEN
      ABBREV_TAC
       (← q r"top' = topology
             (ARBITRARY UNION_OF (FINITE INTERSECTION_OF
               ((topspace top DIFF s) INSERT open_in top)
              relative_to (topspace top:A->bool)))") THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"top':A topology")) THEN
      REWRITE_TAC [NOT_IMP] THEN REPEAT CONJ_TAC THENL
       [EXPAND_TAC "top'" THEN REWRITE_TAC [TOPSPACE_SUBBASE],
        X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
        EXPAND_TAC "top'" THEN REWRITE_TAC [OPEN_IN_SUBBASE] THEN
        MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
        FIRST_ASSUM (SUBST1_TAC o MATCH_MP
         (← sr r"u SUBSET t ==> u = t INTER u") o
         MATCH_MP OPEN_IN_SUBSET) THEN
        MATCH_MP_TAC RELATIVE_TO_INC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [INSERT, IN_ELIM_THM] THEN ASM SET_TAC [],
        MATCH_MP_TAC ALEXANDER_SUBBASE_THEOREM_ALT THEN
        EXISTS_TAC (← q r"(topspace top DIFF s:A->bool) INSERT open_in top") THEN
        EXISTS_TAC (← q r"topspace top:A->bool") THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
         [REWRITE_TAC [UNIONS_INSERT] THEN
          MATCH_MP_TAC (← sr
           r"UNIONS {x | P x} = s ==> s SUBSET t UNION UNIONS P") THEN
          REWRITE_TAC [topspace],
          ALL_TAC] THEN
        REWRITE_TAC [FORALL_SUBSET_INSERT, IMP_CONJ] THEN
        X_GEN_TAC (← q r"U:(A->bool)->bool") THEN GEN_REWRITE_TAC LAND_CONV
         [← sr r"s SUBSET P <=> !x. x IN s ==> P x"] THEN
        DISCH_TAC THEN CONJ_TAC THENL
         [DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_space]) THEN
          REWRITE_TAC [compact_in] THEN ASM_SIMP_TAC [],
          ASM_SIMP_TAC [UNIONS_INSERT, ← sr
           r"s SUBSET u
            ==> (u SUBSET (u DIFF s) UNION t <=> s SUBSET t)"] THEN
          DISCH_TAC THEN
          FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
          DISCH_THEN (MP_TAC o SPEC (← q r"U:(A->bool)->bool") o CONJUNCT2) THEN
          ASM_REWRITE_TAC [] THEN
          DISCH_THEN (X_CHOOSE_THEN (← q r"V:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
          EXISTS_TAC (← q r"(topspace top DIFF s:A->bool) INSERT V") THEN
          ASM_REWRITE_TAC [FINITE_INSERT, UNIONS_INSERT] THEN ASM SET_TAC []],
        REWRITE_TAC [TOPOLOGY_EQ_ALT, NOT_FORALL_THM] THEN
        EXISTS_TAC (← q r"s:A->bool") THEN ASM_REWRITE_TAC [] THEN
        REWRITE_TAC [closed_in] THEN EXPAND_TAC "top'" THEN
        REWRITE_TAC [TOPSPACE_SUBBASE, OPEN_IN_SUBBASE] THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC ARBITRARY_UNION_OF_INC THEN
        ONCE_REWRITE_TAC [← sr r"u DIFF s = u INTER (u DIFF s)"] THEN
        MATCH_MP_TAC RELATIVE_TO_INC THEN
        MATCH_MP_TAC FINITE_INTERSECTION_OF_INC THEN
        REWRITE_TAC [INSERT, IN_ELIM_THM] THEN ASM SET_TAC []]])

  let CONTINUOUS_IMP_CLOSED_MAP_GEN ← prove
   r"!top top' (f:A->B).
        compact_space top /\ kc_space top' /\ continuous_map(top,top') f
        ==> closed_map(top,top') f"
   (REWRITE_TAC [closed_map, kc_space] THEN
    ASM_MESON_TAC [IMAGE_COMPACT_IN, CLOSED_IN_COMPACT_SPACE])

  let KC_SPACE_COMPACT_SUBTOPOLOGIES ← prove
   r"!top:A topology.
        kc_space top <=> !k. compact_in top k ==> kc_space(subtopology top k)"
   (GEN_TAC THEN REWRITE_TAC [kc_space, COMPACT_IN_SUBTOPOLOGY] THEN
    EQ_TAC THENL [MESON_TAC [CLOSED_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
    ASM_REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP
     (← REWRITE_RULE [SUBSET] CLOSURE_OF_SUBSET_TOPSPACE)) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"{x:A} UNION k")) THEN
    ASM_SIMP_TAC [COMPACT_IN_UNION, COMPACT_IN_SING] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"k:A->bool")) THEN
    ASM_REWRITE_TAC [SUBSET_UNION, ← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [SUBSET, IN_INTER, CLOSURE_OF_SUBTOPOLOGY] THEN
    DISCH_THEN (MATCH_MP_TAC o CONJUNCT2) THEN
    ASM_REWRITE_TAC [← sr r"(s UNION t) INTER t = t", IN_UNION, IN_SING])

  let KC_SPACE_COMPACT_PROD_TOPOLOGY ← prove
   r"!top:A topology.
        compact_space top
        ==> (kc_space(prod_topology top top) <=> hausdorff_space top)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    SIMP_TAC [HAUSDORFF_IMP_KC_SPACE, HAUSDORFF_SPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [kc_space, HAUSDORFF_SPACE_CLOSED_IN_DIAGONAL] THEN
    DISCH_THEN MATCH_MP_TAC THEN ONCE_REWRITE_TAC [SIMPLE_IMAGE] THEN
    MATCH_MP_TAC IMAGE_COMPACT_IN THEN EXISTS_TAC (← q r"top:A topology") THEN
    REWRITE_TAC [CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID] THEN
    ASM_REWRITE_TAC [← GSYM compact_space])

  let KC_SPACE_PROD_TOPOLOGY ← prove
   r"!top:A topology.
        kc_space(prod_topology top top) <=>
        !k. compact_in top k ==> hausdorff_space(subtopology top k)"
   (GEN_TAC THEN ONCE_REWRITE_TAC [KC_SPACE_COMPACT_SUBTOPOLOGIES] THEN
    SIMP_TAC [AND_FORALL_THM, ← TAUT (← q r"(p ==> q) /\ (p ==> r) <=> p ==> q /\ r")] THEN
    EQ_TAC THEN DISCH_TAC THENL
     [X_GEN_TAC (← q r"k:A->bool") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(k:A->bool) CROSS k")) THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_CROSS, COMPACT_IN_CROSS] THEN
      ASM_SIMP_TAC [KC_SPACE_COMPACT_PROD_TOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY,
                    HAUSDORFF_IMP_KC_SPACE],
      X_GEN_TAC (← q r"l:A#A->bool") THEN DISCH_TAC THEN
      ABBREV_TAC (← q r"k:A->bool = IMAGE FST l UNION IMAGE SND l") THEN
      SUBGOAL_THEN (← q r"compact_in top (k:A->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "k" THEN MATCH_MP_TAC COMPACT_IN_UNION THEN CONJ_TAC THEN
        MATCH_MP_TAC IMAGE_COMPACT_IN THEN
        EXISTS_TAC (← q r"prod_topology (top:A topology) top") THEN
        ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND],
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"k:A->bool")) THEN ASM_REWRITE_TAC []] THEN
      ASM_SIMP_TAC [← GSYM KC_SPACE_COMPACT_PROD_TOPOLOGY,
       COMPACT_SPACE_SUBTOPOLOGY] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"l:A#A->bool") o
        MATCH_MP KC_SPACE_SUBTOPOLOGY) THEN
      MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
      REWRITE_TAC [← GSYM SUBTOPOLOGY_CROSS, SUBTOPOLOGY_SUBTOPOLOGY] THEN
      AP_TERM_TAC THEN REWRITE_TAC [← sr r"s INTER t = t <=> t SUBSET s"] THEN
      EXPAND_TAC "k" THEN
      REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_UNION, IN_CROSS, IN_IMAGE] THEN
      MESON_TAC [FST, SND]])

  return { kc_space, KC_SPACE_EXPANSIVE, COMPACT_IN_IMP_CLOSED_IN_GEN, HAUSDORFF_IMP_KC_SPACE,
           KC_IMP_T1_SPACE, KC_SPACE_SUBTOPOLOGY, KC_SPACE_DISCRETE_TOPOLOGY,
           KC_SPACE_CONTINUOUS_INJECTIVE_MAP_PREIMAGE, KC_SPACE_RETRACTION_MAP_IMAGE,
           HOMEOMORPHIC_KC_SPACE, COMPACT_KC_EQ_MAXIMAL_COMPACT_SPACE,
           CONTINUOUS_IMP_CLOSED_MAP_GEN, KC_SPACE_COMPACT_SUBTOPOLOGIES,
           KC_SPACE_COMPACT_PROD_TOPOLOGY, KC_SPACE_PROD_TOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- KC spaces, part 2.  (metric.ml 9360-9488)                                 -/
/- ------------------------------------------------------------------------- -/

structure KC2 where
  KC_SPACE_PROD_TOPOLOGY_ALT : thm
  KC_SPACE_PROD_TOPOLOGY_LEFT : thm
  KC_SPACE_PROD_TOPOLOGY_RIGHT : thm
  KC_SPACE_PROD_TOPOLOGY_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupKC2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BProd1 : Prod1) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BCompact1 : Compact1) (BCompact3 : Compact3) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BKC1 : KC1) : ExceptT String IO KC2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IMP_CONJ, IN_CROSS, IN_DIFF, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, IN_INTER,
        IN_SING, NOT_IN_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_RESTRICT, .. } := D.core4
  let { EQ_IMP, EXISTS_PAIR_THM, FORALL_PAIR_THM, RIGHT_EXISTS_AND_THM, .. } := D.core5
  let { CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, EXISTS_OPEN_IN, OPEN_IN_DIFF, OPEN_IN_SUBOPEN,
        OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID,
        .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_IN_CROSS, CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_SND,
        OPEN_IN_CROSS, PROD_TOPOLOGY_SUBTOPOLOGY, SUBTOPOLOGY_CROSS, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP, homeomorphic_space, .. } := BHomeoSpace
  let { COMPACT_INTER_CLOSED_IN, COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE,
        COMPACT_IN_SUBSPACE, .. } := BCompact1
  let { HOMEOMORPHIC_COMPACT_SPACE, IMAGE_COMPACT_IN, .. } := BCompact3
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { HAUSDORFF_SPACE_COMPACT_SEPARATION, .. } := BHausdorff1
  let { HAUSDORFF_IMP_KC_SPACE, HOMEOMORPHIC_KC_SPACE, KC_IMP_T1_SPACE,
        KC_SPACE_COMPACT_SUBTOPOLOGIES, KC_SPACE_PROD_TOPOLOGY, KC_SPACE_SUBTOPOLOGY, kc_space,
        .. } := BKC1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let KC_SPACE_PROD_TOPOLOGY_ALT ← prove
   r"!top:A topology.
        kc_space(prod_topology top top) <=>
        kc_space top /\
        !k. compact_in top k ==> hausdorff_space(subtopology top k)"
   (REWRITE_TAC [KC_SPACE_PROD_TOPOLOGY] THEN
    ONCE_REWRITE_TAC [KC_SPACE_COMPACT_SUBTOPOLOGIES] THEN
    MESON_TAC [HAUSDORFF_IMP_KC_SPACE])

  let KC_SPACE_PROD_TOPOLOGY_LEFT ← prove
   r"!(top:A topology) (top':B topology).
        kc_space top /\ hausdorff_space top'
        ==> kc_space (prod_topology top top')"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [kc_space] THEN
    X_GEN_TAC (← q r"k:A#B->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
    ASM_REWRITE_TAC [closed_in] THEN
    GEN_REWRITE_TAC id [OPEN_IN_SUBOPEN] THEN
    REWRITE_TAC [FORALL_PAIR_THM, IN_DIFF, IN_CROSS, TOPSPACE_PROD_TOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      SPECL [← q r"{b:B}", ← q r"{y | y IN topspace top' /\ (a,y) IN (k:A#B->bool)}"] o
      MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
       HAUSDORFF_SPACE_COMPACT_SEPARATION)) THEN
    ASM_REWRITE_TAC [COMPACT_IN_SING] THEN ANTS_TAC THENL
     [CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REWRITE_TAC [COMPACT_IN_SUBSPACE, SUBSET_RESTRICT] THEN
      MP_TAC (← ISPECL [← q r"prod_topology top top':(A#B)topology",
                       ← q r"k:A#B->bool", ← q r"{a:A} CROSS (topspace top':B->bool)"]
          COMPACT_INTER_CLOSED_IN) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [REWRITE_TAC [CLOSED_IN_CROSS, CLOSED_IN_TOPSPACE] THEN
        ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING, KC_IMP_T1_SPACE],
        REWRITE_TAC [COMPACT_IN_SUBSPACE] THEN
        DISCH_THEN (MP_TAC o CONJUNCT2) THEN MATCH_MP_TAC EQ_IMP] THEN
      MATCH_MP_TAC HOMEOMORPHIC_COMPACT_SPACE THEN
      REWRITE_TAC [homeomorphic_space, homeomorphic_maps] THEN
      MAP_EVERY EXISTS_TAC [← q r"SND:A#B->B", ← q r"(\x. (a,x)):B->A#B"] THEN
      REWRITE_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY] THEN
      SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_SND,
         CONTINUOUS_MAP_PAIRED, CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST] THEN
      ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, FORALL_PAIR_THM] THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER, IN_CROSS,
                   TOPSPACE_PROD_TOPOLOGY, IN_SING] THEN
      SIMP_TAC [IN_ELIM_THM] THEN MESON_TAC [],
      DISCH_THEN (X_CHOOSE_THEN (← q r"v:B->bool") MP_TAC)] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, IMP_CONJ] THEN DISCH_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [EXISTS_OPEN_IN] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"v':B->bool") MP_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP OPEN_IN_SUBSET) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    REWRITE_TAC [SING_SUBSET, SUBSET_RESTRICT, ← sr
      r"s SUBSET t DIFF u <=> s SUBSET t /\ DISJOINT s u"] THEN
    ASM_SIMP_TAC [← sr
     r"v SUBSET u ==> (DISJOINT v (u DIFF v') <=> v SUBSET v')"] THEN
    STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [kc_space]) THEN
    ABBREV_TAC
     (← q r"c = IMAGE FST (k INTER {z:A#B | z IN topspace(prod_topology top top') /\
                                      SND z IN v'})") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"c:A->bool")) THEN ANTS_TAC THENL
     [EXPAND_TAC "c" THEN MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      EXISTS_TAC (← q r"prod_topology top top':(A#B)topology") THEN
      REWRITE_TAC [CONTINUOUS_MAP_FST] THEN
      MATCH_MP_TAC COMPACT_INTER_CLOSED_IN THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"top':B topology") THEN ASM_REWRITE_TAC [CONTINUOUS_MAP_SND],
      DISCH_TAC] THEN
    EXISTS_TAC (← q r"(topspace top DIFF c:A->bool) CROSS (v:B->bool)") THEN
    ASM_SIMP_TAC [OPEN_IN_CROSS, OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
    ASM_REWRITE_TAC [IN_CROSS, IN_DIFF] THEN
    POP_ASSUM_LIST (fun ths => (MP_TAC o end_itlist CONJ) ths.reverse) THEN
    REWRITE_TAC [DISJOINT] THEN ONCE_REWRITE_TAC [EXTENSION] THEN
    REWRITE_TAC [FORALL_PAIR_THM, SUBSET, IN_IMAGE, EXISTS_PAIR_THM] THEN
    REWRITE_TAC [IN_INTER, IN_ELIM_PAIR_THM, IN_CROSS, IN_DIFF,
                 TOPSPACE_PROD_TOPOLOGY, NOT_IN_EMPTY] THEN
    SET_TAC [])

  let KC_SPACE_PROD_TOPOLOGY_RIGHT ← prove
   r"!(top:A topology) (top':B topology).
        hausdorff_space top /\ kc_space top'
        ==> kc_space (prod_topology top top')"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top':B topology", ← q r"top:A topology"]
          KC_SPACE_PROD_TOPOLOGY_LEFT) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN
    MATCH_MP_TAC HOMEOMORPHIC_KC_SPACE THEN
    REWRITE_TAC [HOMEOMORPHIC_SPACE_PROD_TOPOLOGY_SWAP])

  let KC_SPACE_PROD_TOPOLOGY_GEN ← prove
   r"!(top:A topology) (top':B topology).
        kc_space top /\ kc_space top' /\
        ((!k. compact_in top k ==> hausdorff_space (subtopology top k)) \/
         (!l. compact_in top' l ==> hausdorff_space (subtopology top' l)))
        ==> kc_space(prod_topology top top')"
   (REPEAT GEN_TAC THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"!(k:A->bool) (l:B->bool).
          compact_in top k /\ compact_in top' l
          ==> kc_space (prod_topology (subtopology top k) (subtopology top' l))")
    MP_TAC THENL
     [FIRST_X_ASSUM STRIP_ASSUME_TAC THEN REPEAT STRIP_TAC THENL
       [MP_TAC (← ISPECL [← q r"subtopology top (k:A->bool)", ← q r"top':B topology"]
          KC_SPACE_PROD_TOPOLOGY_RIGHT) THEN
        ASM_SIMP_TAC [] THEN
        REWRITE_TAC [← CONJUNCT2 PROD_TOPOLOGY_SUBTOPOLOGY] THEN
        SIMP_TAC [KC_SPACE_SUBTOPOLOGY],
        MP_TAC (← ISPECL [← q r"top:A topology", ← q r"subtopology top' (l:B->bool)"]
          KC_SPACE_PROD_TOPOLOGY_LEFT) THEN
        ASM_SIMP_TAC [] THEN
        REWRITE_TAC [← CONJUNCT1 PROD_TOPOLOGY_SUBTOPOLOGY] THEN
        SIMP_TAC [KC_SPACE_SUBTOPOLOGY]],
      DISCH_TAC THEN GEN_REWRITE_TAC id [KC_SPACE_COMPACT_SUBTOPOLOGIES]] THEN
    X_GEN_TAC (← q r"m:A#B->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"subtopology (prod_topology top top') (m:A#B->bool) =
      subtopology (prod_topology (subtopology top (IMAGE FST m))
                                 (subtopology top' (IMAGE SND m))) m")
    SUBST1_TAC THENL
     [REWRITE_TAC [← GSYM SUBTOPOLOGY_CROSS, SUBTOPOLOGY_SUBTOPOLOGY] THEN
      AP_TERM_TAC THEN REWRITE_TAC [← sr r"k = s INTER k <=> k SUBSET s"] THEN
      SIMP_TAC [FORALL_PAIR_THM, IN_CROSS, IN_IMAGE, EXISTS_PAIR_THM, SUBSET] THEN
      MESON_TAC [],
      MATCH_MP_TAC KC_SPACE_SUBTOPOLOGY THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THEN
      MATCH_MP_TAC IMAGE_COMPACT_IN THEN
      ASM_MESON_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND]])

  return { KC_SPACE_PROD_TOPOLOGY_ALT, KC_SPACE_PROD_TOPOLOGY_LEFT, KC_SPACE_PROD_TOPOLOGY_RIGHT,
           KC_SPACE_PROD_TOPOLOGY_GEN }

/- ------------------------------------------------------------------------- -/
/- Proper maps, part 1.  (metric.ml 9490-9681)                               -/
/- ------------------------------------------------------------------------- -/

structure Proper1 where
  proper_map : thm
  PROPER_IMP_CLOSED_MAP : thm
  PROPER_MAP_IMP_SUBSET_TOPSPACE : thm
  CLOSED_INJECTIVE_IMP_PROPER_MAP : thm
  INJECTIVE_IMP_PROPER_EQ_CLOSED_MAP : thm
  PROPER_MAP_DIAG_EQ : thm
  HOMEOMORPHIC_IMP_PROPER_MAP : thm
  COMPACT_IN_PROPER_MAP_PREIMAGE : thm
  COMPACT_SPACE_PROPER_MAP_PREIMAGE : thm
  PROPER_MAP_ALT : thm
  PROPER_MAP_ON_EMPTY : thm
  PROPER_MAP_ID : thm
  PROPER_MAP_COMPOSE : thm
  PROPER_MAP_CONST : thm
  PROPER_MAP_INCLUSION : thm
  PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT : thm
  PROPER_MAP_PAIRED_CONTINUOUS_MAP_LEFT : thm
  deriving Inhabited

@[nospecialize]
def setupProper1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2)
    (BHomeo1 : Homeo1) (BCompact1 : Compact1) (BDiagonal : Diagonal) :
    ExceptT String IO Proper1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { COND_RAND, EMPTY_GSPEC, EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FINITE_UNIONS,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, IMAGE_ID, .. } := D.core1
  let { IMAGE_o, IMP_CONJ, IMP_CONJ_ALT, INJECTIVE_ON_ALT, INTER, IN_GSPEC, IN_SING,
        LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SING_SUBSET, SKOLEM_THM, SUBSET_REFL, SUBSET_RESTRICT, UNIONS_GSPEC,
        UNIONS_IMAGE, o_THM, .. } := D.core4
  let { FORALL_PAIR_THM, FORALL_UNWIND_THM1, PAIR_EQ, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_TOPSPACE,
        OPEN_IN_UNIONS, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_MAP_COMPOSE, CLOSED_MAP_ID, CLOSED_MAP_IMP_SUBSET_TOPSPACE,
        CLOSED_MAP_INCLUSION_EQ, CLOSED_MAP_ON_EMPTY, closed_map, .. } := BOpenClosed1
  let { CLOSED_MAP_CONST, .. } := BOpenClosed2
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, .. } := BHomeo1
  let { COMPACT_IN_EMPTY, COMPACT_IN_SING, COMPACT_IN_SUBSET_TOPSPACE, COMPACT_IN_SUBTOPOLOGY,
        COMPACT_SPACE_TOPSPACE_EMPTY, compact_in, compact_space, .. } := BCompact1
  let { CLOSED_MAP_DIAG_EQ, CLOSED_MAP_PAIRED_CONTINUOUS_MAP_LEFT,
        CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT, .. } := BDiagonal
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let proper_map ← new_definition
   r"proper_map (top,top') (f:A->B) <=>
        closed_map (top,top') f /\
        !y. y IN topspace top'
            ==> compact_in top {x | x IN topspace top /\ f x = y}"

  let PROPER_IMP_CLOSED_MAP ← prove
   r"!top top' (f:A->B). proper_map(top,top') f ==> closed_map(top,top') f"
   (SIMP_TAC [proper_map])

  let PROPER_MAP_IMP_SUBSET_TOPSPACE ← prove
   r"!top top' (f:A->B).
      proper_map(top,top') f ==> IMAGE f (topspace top) SUBSET topspace top'"
   (MESON_TAC [PROPER_IMP_CLOSED_MAP, CLOSED_MAP_IMP_SUBSET_TOPSPACE])

  let CLOSED_INJECTIVE_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        closed_map(top,top') f /\
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y)
        ==> proper_map(top,top') f"
   (REWRITE_TAC [INJECTIVE_ON_ALT] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [proper_map] THEN X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (f:A->B) x = y} = {} \/
      ?a. a IN topspace top /\ {x | x IN topspace top /\ (f:A->B) x = y} = {a}")
    MP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [COMPACT_IN_EMPTY, COMPACT_IN_SING])

  let INJECTIVE_IMP_PROPER_EQ_CLOSED_MAP ← prove
   r"!top top' (f:A->B).
        (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y)
        ==> (proper_map(top,top') f <=> closed_map(top,top') f)"
   (MESON_TAC [CLOSED_INJECTIVE_IMP_PROPER_MAP, PROPER_IMP_CLOSED_MAP])

  let PROPER_MAP_DIAG_EQ ← prove
   r"!top:A topology.
        proper_map (top,prod_topology top top) (\x. x,x) <=>
        hausdorff_space top"
   (GEN_TAC THEN REWRITE_TAC [← GSYM CLOSED_MAP_DIAG_EQ] THEN
    MATCH_MP_TAC INJECTIVE_IMP_PROPER_EQ_CLOSED_MAP THEN
    REWRITE_TAC [FORALL_PAIR_THM, PAIR_EQ] THEN SIMP_TAC [])

  let HOMEOMORPHIC_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f ==> proper_map(top,top') f"
   (REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC CLOSED_INJECTIVE_IMP_PROPER_MAP THEN
    ASM_REWRITE_TAC [INJECTIVE_ON_ALT])

  let COMPACT_IN_PROPER_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B) k.
        proper_map(top,top') f /\ compact_in top' k
        ==> compact_in top {x | x IN topspace top /\ f x IN k}"
   (REWRITE_TAC [proper_map] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [compact_in, SUBSET_RESTRICT] THEN
    X_GEN_TAC (← q r"u:(A->bool)->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!y. y IN k
          ==> ?v. FINITE v /\ v SUBSET u /\
                  {x | x IN topspace top /\ (f:A->B) x = y} SUBSET UNIONS v")
    MP_TAC THENL
     [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN ANTS_TAC THENL
       [FIRST_ASSUM (MP_TAC o MATCH_MP COMPACT_IN_SUBSET_TOPSPACE) THEN
        ASM SET_TAC [],
        ASM_REWRITE_TAC [compact_in, SUBSET_RESTRICT] THEN
        DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC []],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"v:B->(A->bool)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"{ topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF UNIONS (v y)) |
        (y:B) IN k}")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"y:B") THEN
        DISCH_TAC THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
        REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [closed_map]) THEN
        MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [],
        REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []],
      REWRITE_TAC [SIMPLE_IMAGE, EXISTS_FINITE_SUBSET_IMAGE] THEN
      REWRITE_TAC [UNIONS_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:B->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS { (v:B->(A->bool)->bool) y | y IN j}") THEN
      ASM_SIMP_TAC [FINITE_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE,
                    FORALL_IN_IMAGE, UNIONS_IMAGE] THEN
      ASM SET_TAC []])

  let COMPACT_SPACE_PROPER_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B).
        proper_map(top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        compact_space top'
        ==> compact_space top"
   (REWRITE_TAC [compact_space] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"topspace top = {x | x IN topspace top /\ (f:A->B) x IN topspace top'}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN FIRST_X_ASSUM
     (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
       COMPACT_IN_PROPER_MAP_PREIMAGE)) THEN
    ASM_REWRITE_TAC [])

  let PROPER_MAP_ALT ← prove
   r"!top top' (f:A->B).
        proper_map (top,top') f <=>
        closed_map (top,top') f /\
        !k. compact_in top' k
            ==> compact_in top {x | x IN topspace top /\ f x IN k}"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN ASM_SIMP_TAC [PROPER_IMP_CLOSED_MAP] THEN
      ASM_MESON_TAC [COMPACT_IN_PROPER_MAP_PREIMAGE],
      STRIP_TAC THEN ASM_REWRITE_TAC [proper_map] THEN
      REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM IN_SING] THEN
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [COMPACT_IN_SING]])

  let PROPER_MAP_ON_EMPTY ← prove
   r"!top top' (f:A->B). topspace top = {} ==> proper_map(top,top') f"
   (SIMP_TAC [proper_map, CLOSED_MAP_ON_EMPTY, NOT_IN_EMPTY] THEN
    REWRITE_TAC [EMPTY_GSPEC, COMPACT_IN_EMPTY])

  let PROPER_MAP_ID ← prove
   r"!top:A topology. proper_map(top,top) (\x. x)"
   (REWRITE_TAC [PROPER_MAP_ALT, CLOSED_MAP_ID, IMAGE_ID, SUBSET_REFL] THEN
    SIMP_TAC [COMPACT_IN_SUBSET_TOPSPACE, ← sr
     r"k SUBSET u ==> {x | x IN u /\ x IN k} = k"])

  let PROPER_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        proper_map(top,top') f /\ proper_map(top',top'') g
        ==> proper_map(top,top'') (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [PROPER_MAP_ALT, o_THM, IMAGE_o] THEN
    STRIP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CLOSED_MAP_COMPOSE], ALL_TAC] THEN
    X_GEN_TAC (← q r"k:C->bool") THEN DISCH_TAC THEN
    REPEAT (FIRST_X_ASSUM (ASSUME_TAC o
      MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE)) THEN
    SUBGOAL_THEN
     (← q r"{x:A | x IN topspace top /\ (g:B->C) (f x) IN k} =
      {x | x IN topspace top /\ f x IN {y | y IN topspace top' /\ g y IN k}}")
    SUBST1_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC []])

  let PROPER_MAP_CONST ← prove
   r"!(top:A topology) top' (c:B).
        proper_map(top,top') (\x. c) <=>
        compact_space top /\ (topspace top = {} \/ closed_in top' {c})"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [PROPER_MAP_ON_EMPTY, COMPACT_SPACE_TOPSPACE_EMPTY] THEN
    ASM_REWRITE_TAC [proper_map, CLOSED_MAP_CONST] THEN
    ASM_CASES_TAC (← q r"closed_in top' {c:B}") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [← sr r"{x | P x /\ Q} = if Q then {x | P x} else {}"] THEN
    ONCE_REWRITE_TAC [COND_RAND] THEN REWRITE_TAC [COMPACT_IN_EMPTY, IN_GSPEC] THEN
    REWRITE_TAC [← TAUT (← q r"(if p then q else T) <=> p ==> q"),
                 ← GSYM compact_space] THEN
    REWRITE_TAC [← GSYM IMP_CONJ_ALT] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_UNWIND_THM1] THEN
    FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN
    SIMP_TAC [SING_SUBSET])

  let PROPER_MAP_INCLUSION ← prove
   r"!top s:A->bool.
        s SUBSET topspace top
        ==> (proper_map(subtopology top s,top) (\x. x) <=>
             closed_in top s /\
             !k. compact_in top k ==> compact_in top (s INTER k))"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [PROPER_MAP_ALT, CLOSED_MAP_INCLUSION_EQ] THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, ← sr r"s SUBSET u ==> u INTER s = s",
                  COMPACT_IN_SUBTOPOLOGY, SUBSET_RESTRICT] THEN
    REWRITE_TAC [← GSYM INTER])

  let PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f /\ hausdorff_space top'
        ==> proper_map(top,prod_topology top top') (\x. x,f x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_INJECTIVE_IMP_PROPER_MAP THEN
    SIMP_TAC [PAIR_EQ] THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CONTINUOUS_MAP_RIGHT])

  let PROPER_MAP_PAIRED_CONTINUOUS_MAP_LEFT ← prove
   r"!top top' (f:A->B).
        continuous_map(top,top') f /\ hausdorff_space top'
        ==> proper_map(top,prod_topology top' top) (\x. f x,x)"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_INJECTIVE_IMP_PROPER_MAP THEN
    SIMP_TAC [PAIR_EQ] THEN
    ASM_SIMP_TAC [CLOSED_MAP_PAIRED_CONTINUOUS_MAP_LEFT])

  return { proper_map, PROPER_IMP_CLOSED_MAP, PROPER_MAP_IMP_SUBSET_TOPSPACE,
           CLOSED_INJECTIVE_IMP_PROPER_MAP, INJECTIVE_IMP_PROPER_EQ_CLOSED_MAP,
           PROPER_MAP_DIAG_EQ, HOMEOMORPHIC_IMP_PROPER_MAP, COMPACT_IN_PROPER_MAP_PREIMAGE,
           COMPACT_SPACE_PROPER_MAP_PREIMAGE, PROPER_MAP_ALT, PROPER_MAP_ON_EMPTY, PROPER_MAP_ID,
           PROPER_MAP_COMPOSE, PROPER_MAP_CONST, PROPER_MAP_INCLUSION,
           PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT, PROPER_MAP_PAIRED_CONTINUOUS_MAP_LEFT }

/- ------------------------------------------------------------------------- -/
/- Proper maps, part 2.  (metric.ml 9683-9894)                               -/
/- ------------------------------------------------------------------------- -/

structure Proper2 where
  COMPACT_IMP_PROPER_MAP_GEN : thm
  CONTINUOUS_CLOSED_IMP_PROPER_MAP : thm
  CONTINUOUS_IMP_PROPER_MAP : thm
  PROPER_IMP_CONTINUOUS_MAP : thm
  PROPER_MAP_FST : thm
  PROPER_MAP_SND : thm
  PROPER_MAP_INTO_SUBTOPOLOGY : thm
  PROPER_MAP_FROM_SUBTOPOLOGY : thm
  PROPER_MAP_RESTRICTION : thm
  PROPER_MAP_IN_SUBTOPOLOGY : thm
  PROPER_MAP_FROM_CLOSED_SUBTOPOLOGY : thm
  PROPER_MAP_FROM_COMPOSITION_LEFT : thm
  PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ : thm
  deriving Inhabited

@[nospecialize]
def setupProper2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2) (BProd1 : Prod1)
    (BCompact1 : Compact1) (BCompact3 : Compact3) (BCompact4 : Compact4)
    (BCompact5 : Compact5) (BT1a : T1a) (BKC1 : KC1) (BProper1 : Proper1) :
    ExceptT String IO Proper2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_METIS_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CROSS_EQ_EMPTY, EXTENSION, .. } := D.core1
  let { IMP_CONJ_ALT, INTER_SUBSET, IN_CROSS, IN_ELIM_THM, IN_INTER, IN_SING,
        LEFT_FORALL_IMP_THM, MEMBER_NOT_EMPTY, NOT_INSERT_EMPTY, .. } := D.core2
  let { o_DEF, .. } := D.core4
  let { EQ_IMP, FORALL_PAIR_THM, .. } := D.core5
  let { CLOSED_IN_SUBSET, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_CLOSED_IN, continuous_map,
        .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_MAP_FROM_SUBTOPOLOGY, CLOSED_MAP_IMP_SUBSET_TOPSPACE, CLOSED_MAP_INTO_SUBTOPOLOGY,
        CLOSED_MAP_ON_EMPTY, CLOSED_MAP_RESTRICTION, closed_map, .. } := BOpenClosed1
  let { CLOSED_MAP_FROM_COMPOSITION_LEFT, CLOSED_MAP_FROM_COMPOSITION_RIGHT,
        CLOSED_MAP_IN_SUBTOPOLOGY, .. } := BOpenClosed2
  let { TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { CLOSED_INTER_COMPACT_IN, CLOSED_IN_COMPACT_SPACE, COMPACT_IN_EMPTY, COMPACT_IN_SING,
        COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY, COMPACT_SPACE_TOPSPACE_EMPTY,
        compact_space, .. } := BCompact1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { CLOSED_MAP_FST, CLOSED_MAP_SND, .. } := BCompact5
  let { T1_SPACE_CLOSED_IN_SING, .. } := BT1a
  let { COMPACT_IN_IMP_CLOSED_IN_GEN, CONTINUOUS_IMP_CLOSED_MAP_GEN, KC_IMP_T1_SPACE,
        KC_SPACE_SUBTOPOLOGY, .. } := BKC1
  let { PROPER_MAP_ALT, proper_map, .. } := BProper1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let COMPACT_IMP_PROPER_MAP_GEN ← prove
   r"!top'. (!s. s SUBSET topspace top' /\
               (!k. compact_in top' k ==> compact_in top' (s INTER k))
               ==> closed_in top' s)
          ==> !top (f:A->B).
                   IMAGE f (topspace top) SUBSET topspace top' /\
                   (continuous_map(top,top') f \/ kc_space top) /\
                   (!k. compact_in top' k
                        ==> compact_in top {x | x IN topspace top /\ f x IN k})
                   ==> proper_map(top,top') f"
   (GEN_TAC THEN DISCH_TAC THEN REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    ASM_REWRITE_TAC [PROPER_MAP_ALT, closed_map] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN CONJ_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
      X_GEN_TAC (← q r"k:B->bool") THEN DISCH_TAC] THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:A->B) c INTER k =
      IMAGE f ({x | x IN topspace top /\ f x IN k} INTER c)")
    SUBST1_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET) THEN ASM SET_TAC [],
      MATCH_MP_TAC IMAGE_COMPACT_IN] THEN
    EXISTS_TAC (← q r"subtopology top {x | x IN topspace top /\ (f:A->B) x IN k}") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, COMPACT_SPACE_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [CLOSED_IN_SUBTOPOLOGY_INTER_CLOSED],
      ALL_TAC] THEN
    FIRST_X_ASSUM DISJ_CASES_TAC THENL
     [ASM_SIMP_TAC [CONTINUOUS_MAP_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                    CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC (← MESON [CONTINUOUS_MAP_IN_SUBTOPOLOGY] (← q
       r"!t. continuous_map(top,subtopology top' t) f
            ==> continuous_map(top,top') f")) THEN
      EXISTS_TAC (← q r"k:B->bool") THEN
      REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, TOPSPACE_SUBTOPOLOGY] THEN
      CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"t:B->bool")] THEN
      DISCH_THEN (MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
         CLOSED_IN_COMPACT_SPACE)) THEN
      ASM_SIMP_TAC [COMPACT_SPACE_SUBTOPOLOGY, COMPACT_IN_SUBTOPOLOGY] THEN
      STRIP_TAC THEN MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN_GEN THEN
      ASM_SIMP_TAC [KC_SPACE_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [COMPACT_IN_SUBTOPOLOGY, ← sr
       r"c SUBSET k
        ==> {x | x IN u INTER {x | x IN u /\ f x IN k} /\ f x IN c} =
            {x | x IN u /\ f x IN c}"] THEN
      ASM SET_TAC []])

  let CONTINUOUS_CLOSED_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        compact_space top /\
        t1_space top' /\
        continuous_map (top,top') f /\
        closed_map (top,top') f
        ==> proper_map (top,top') f"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [proper_map] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM IN_SING] THEN
    MATCH_MP_TAC CLOSED_IN_COMPACT_SPACE THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
    ASM_MESON_TAC [T1_SPACE_CLOSED_IN_SING])

  let CONTINUOUS_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        compact_space top /\
        kc_space top' /\
        continuous_map (top,top') f
        ==> proper_map (top,top') f"
   (MESON_TAC [CONTINUOUS_IMP_CLOSED_MAP_GEN,
               CONTINUOUS_CLOSED_IMP_PROPER_MAP, KC_IMP_T1_SPACE])

  let PROPER_IMP_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B).
        kc_space top /\
        compact_space top' /\
        proper_map (top,top') f
        ==> continuous_map (top,top') f"
   (REWRITE_TAC [CONTINUOUS_MAP_CLOSED_IN, PROPER_MAP_ALT] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
    REPEAT STRIP_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC COMPACT_IN_IMP_CLOSED_IN_GEN THEN
    ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
    ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE])

  let PROPER_MAP_FST ← prove
   r"!(top:A topology) (top':B topology).
        proper_map(prod_topology top top',top) FST <=>
        topspace top = {} \/ compact_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [proper_map, TOPSPACE_PROD_TOPOLOGY] THEN
    SUBGOAL_THEN
     (← q r"!x. x IN topspace top
          ==> {z:A#B | z IN topspace top CROSS topspace top' /\ FST z = x} =
              {x} CROSS topspace top'")
     (fun th => SIMP_TAC [th])
    THENL
     [SIMP_TAC [EXTENSION, IN_ELIM_THM, FORALL_PAIR_THM, IN_CROSS, IN_SING] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [COMPACT_IN_CROSS, COMPACT_IN_SING, ← GSYM compact_space] THEN
    SIMP_TAC [NOT_INSERT_EMPTY, ← MESON [COMPACT_SPACE_TOPSPACE_EMPTY] (← q
     r"topspace top = {} \/ compact_space top <=> compact_space top")] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, MEMBER_NOT_EMPTY, ← TAUT (← q
     r"(r /\ (~p ==> q) <=> p \/ q) <=> (p ==> r) /\ (q ==> r)")] THEN
    SIMP_TAC [CLOSED_MAP_FST, CLOSED_MAP_ON_EMPTY, TOPSPACE_PROD_TOPOLOGY,
              CROSS_EQ_EMPTY])

  let PROPER_MAP_SND ← prove
   r"!(top:A topology) (top':B topology).
        proper_map(prod_topology top top',top') SND <=>
        compact_space top \/ topspace top' = {}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [proper_map, TOPSPACE_PROD_TOPOLOGY] THEN
    SUBGOAL_THEN
     (← q r"!y. y IN topspace top'
          ==> {z:A#B | z IN topspace top CROSS topspace top' /\ SND z = y} =
              topspace top CROSS {y}")
     (fun th => SIMP_TAC [th])
    THENL
     [SIMP_TAC [EXTENSION, IN_ELIM_THM, FORALL_PAIR_THM, IN_CROSS, IN_SING] THEN
      ASM_MESON_TAC [],
      ALL_TAC] THEN
    REWRITE_TAC [COMPACT_IN_CROSS, COMPACT_IN_SING, ← GSYM compact_space] THEN
    SIMP_TAC [NOT_INSERT_EMPTY, ← MESON [COMPACT_SPACE_TOPSPACE_EMPTY] (← q
     r"topspace top = {} \/ compact_space top <=> compact_space top")] THEN
    REWRITE_TAC [LEFT_FORALL_IMP_THM, MEMBER_NOT_EMPTY, ← TAUT (← q
     r"(r /\ (~p ==> q) <=> q \/ p) <=> (p ==> r) /\ (q ==> r)")] THEN
    SIMP_TAC [CLOSED_MAP_SND, CLOSED_MAP_ON_EMPTY, TOPSPACE_PROD_TOPOLOGY,
              CROSS_EQ_EMPTY])

  let PROPER_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) c.
        proper_map (top,top') f /\ IMAGE f (topspace top) SUBSET c
        ==> proper_map (top,subtopology top' c) f"
   (SIMP_TAC [proper_map, CLOSED_MAP_INTO_SUBTOPOLOGY] THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER])

  let PROPER_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B) c.
        proper_map (top,top') f /\ closed_in top c
        ==> proper_map (subtopology top c,top') f"
   (SIMP_TAC [proper_map, CLOSED_MAP_FROM_SUBTOPOLOGY] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [INTER_SUBSET, ← sr
     r"{x | x IN u INTER c /\ P x} = c INTER {x | x IN u /\ P x}"] THEN
    SIMP_TAC [CLOSED_INTER_COMPACT_IN])

  let PROPER_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        proper_map (top,top') f /\ {x | x IN topspace top /\ f x IN v} = u
        ==> proper_map (subtopology top u,subtopology top' v) f"
   (REPEAT GEN_TAC THEN SIMP_TAC [proper_map, CLOSED_MAP_RESTRICTION] THEN
    REWRITE_TAC [COMPACT_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [INTER_SUBSET, ← sr
     r"{x | x IN u INTER c /\ P x} = c INTER {x | x IN u /\ P x}"] THEN
    STRIP_TAC THEN X_GEN_TAC (← q r"y:B") THEN REWRITE_TAC [IN_INTER] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC [])

  let PROPER_MAP_IN_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        closed_in top' s
        ==> (proper_map(top,subtopology top' s) f <=>
             proper_map(top,top') f /\ IMAGE f (topspace top) SUBSET s)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [proper_map, CLOSED_MAP_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THEN
    X_GEN_TAC (← q r"y:B") THEN ASM_CASES_TAC (← q r"(y:B) IN s") THEN ASM_SIMP_TAC [] THEN
    MATCH_MP_TAC (← MESON [COMPACT_IN_EMPTY] (← q
     r"s = {} ==> p ==> compact_in top s")) THEN
    ASM SET_TAC [])

  let PROPER_MAP_FROM_CLOSED_SUBTOPOLOGY ← prove
   r"!top top' s (f:A->B).
        closed_in top' s /\ proper_map(top,subtopology top' s) f
        ==> proper_map(top,top') f"
   (MESON_TAC [PROPER_MAP_IN_SUBTOPOLOGY])

  let PROPER_MAP_FROM_COMPOSITION_LEFT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        proper_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> proper_map(top',top'') g"
   (REPEAT GEN_TAC THEN REWRITE_TAC [proper_map] THEN STRIP_TAC THEN CONJ_TAC
    THENL [ASM_MESON_TAC [CLOSED_MAP_FROM_COMPOSITION_LEFT], ALL_TAC] THEN
    X_GEN_TAC (← q r"z:C") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{y | y IN topspace top' /\ (g:B->C) y = z} =
      IMAGE (f:A->B) {x | x IN topspace top /\ (g o f) x = z}")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF] THEN ASM SET_TAC [], ALL_TAC] THEN
    MATCH_MP_TAC IMAGE_COMPACT_IN THEN EXISTS_TAC (← q r"top:A topology") THEN
    ASM_SIMP_TAC [])

  let PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        proper_map(top,top'') (g o f) /\
        IMAGE f (topspace top) SUBSET topspace top' /\
        continuous_map(top',top'') g /\
        (!x y. x IN topspace top' /\ y IN topspace top' /\ g x = g y
               ==> x = y)
        ==> proper_map(top,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [proper_map] THEN STRIP_TAC THEN CONJ_TAC
    THENL [ASM_METIS_TAC [CLOSED_MAP_FROM_COMPOSITION_RIGHT], ALL_TAC] THEN
    X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x | x IN topspace top /\ (f:A->B) x = y} =
      {x | x IN topspace top /\ (g o f) x:C = g y}")
    SUBST1_TAC THENL [REWRITE_TAC [o_DEF] THEN ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM MATCH_MP_TAC THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  return { COMPACT_IMP_PROPER_MAP_GEN, CONTINUOUS_CLOSED_IMP_PROPER_MAP,
           CONTINUOUS_IMP_PROPER_MAP, PROPER_IMP_CONTINUOUS_MAP, PROPER_MAP_FST, PROPER_MAP_SND,
           PROPER_MAP_INTO_SUBTOPOLOGY, PROPER_MAP_FROM_SUBTOPOLOGY, PROPER_MAP_RESTRICTION,
           PROPER_MAP_IN_SUBTOPOLOGY, PROPER_MAP_FROM_CLOSED_SUBTOPOLOGY,
           PROPER_MAP_FROM_COMPOSITION_LEFT, PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ }

/- ------------------------------------------------------------------------- -/
/- Proper maps, part 3.  (metric.ml 9896-10078)                               -/
/- ------------------------------------------------------------------------- -/

structure Proper3 where
  PROPER_MAP_PROD : thm
  PROPER_MAP_PAIRED : thm
  PROPER_MAP_PAIRWISE : thm
  PROPER_MAP_FROM_COMPOSITION_RIGHT : thm
  CONTINUOUS_EXTENSION_OF_PROPER_MAP_FROM_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupProper3 [HolBase] (D : MetricDeps) (BContMap1 : ContMap1) (BContMap2 : ContMap2)
    (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2) (BProd1 : Prod1)
    (BProd2 : Prod2) (BHomeo1 : Homeo1) (BCompact3 : Compact3) (BCompact4 : Compact4)
    (BCompact5 : Compact5) (BDiagonal : Diagonal) (BProper1 : Proper1) (BProper2 : Proper2) :
    ExceptT String IO Proper3 := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, SET_TAC, .. } := D
  let { CROSS_EQ_EMPTY, ETA_AX, EXTENSION, FORALL_IN_IMAGE, FUN_EQ_THM, .. } := D.core1
  let { IMP_IMP, IN_CROSS, IN_ELIM_PAIR_THM, IN_ELIM_THM, IN_IMAGE, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { SUBSET, o_DEF, o_THM, .. } := D.core4
  let { DE_MORGAN_THM, EXISTS_PAIR_THM, FORALL_PAIR_FUN_THM, FORALL_PAIR_THM, PAIR_EQ,
        .. } := D.core5
  let { CONTINUOUS_MAP_ID, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  let { CONTINUOUS_MAP_FROM_SUBTOPOLOGY, .. } := BContMap2
  let { CLOSED_MAP_IMP_SUBSET_TOPSPACE, .. } := BOpenClosed1
  let { CLOSED_MAP_FIBRE_NEIGHBOURHOOD, .. } := BOpenClosed2
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, OPEN_IN_CROSS, TOPSPACE_PROD_TOPOLOGY,
        .. } := BProd1
  let { CLOSED_MAP_PROD, .. } := BProd2
  let { HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { IMAGE_COMPACT_IN, .. } := BCompact3
  let { COMPACT_IN_CROSS, .. } := BCompact4
  let { WALLACE_THEOREM_PROD_TOPOLOGY, .. } := BCompact5
  let { HOMEOMORPHIC_MAPS_GRAPH, .. } := BDiagonal
  let { HOMEOMORPHIC_IMP_PROPER_MAP, PROPER_MAP_COMPOSE, PROPER_MAP_DIAG_EQ, PROPER_MAP_ID,
        PROPER_MAP_IMP_SUBSET_TOPSPACE, PROPER_MAP_INCLUSION, PROPER_MAP_ON_EMPTY,
        PROPER_MAP_PAIRED_CONTINUOUS_MAP_LEFT, PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT,
        proper_map, .. } := BProper1
  let { PROPER_MAP_INTO_SUBTOPOLOGY, .. } := BProper2
  -- @@SCOPE END

  let PROPER_MAP_PROD ← prove
   r"!top1 top1' top2 top2' (f:A->C) (g:B->D).
        proper_map (prod_topology top1 top2,prod_topology top1' top2')
                   (\(x,y). f x,g y) <=>
        topspace(prod_topology top1 top2) = {} \/
        proper_map (top1,top1') f /\ proper_map (top2,top2') g"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THEN
    ASM_SIMP_TAC [PROPER_MAP_ON_EMPTY] THEN EQ_TAC THENL
     [REWRITE_TAC [proper_map] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_MAP_PROD) THEN
      ASM_REWRITE_TAC [] THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY]) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
      REPEAT (FIRST_X_ASSUM (ASSUME_TAC o
        MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE)) THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"y:C") THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
         GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY] o CONJUNCT2) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"z:B")) THEN
        SUBGOAL_THEN
         (← q r"{x | x IN topspace top1 /\ f x = y} =
          IMAGE FST {x | x IN topspace top1 CROSS topspace top2 /\
                    (\(x,y). (f:A->C) x,(g:B->D) y) x = y,g z}")
        SUBST1_TAC THENL
         [REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM,
                       IN_CROSS, PAIR_EQ] THEN
          ASM SET_TAC [],
          MATCH_MP_TAC IMAGE_COMPACT_IN THEN
          EXISTS_TAC (← q r"prod_topology top1 top2:(A#B)topology") THEN
          REWRITE_TAC [CONTINUOUS_MAP_FST] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_CROSS] THEN ASM SET_TAC []],
        X_GEN_TAC (← q r"y:D") THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY] o CONJUNCT1) THEN
        DISCH_THEN (X_CHOOSE_TAC (← q r"z:A")) THEN
        SUBGOAL_THEN
         (← q r"{x | x IN topspace top2 /\ g x = y} =
          IMAGE SND {x | x IN topspace top1 CROSS topspace top2 /\
                    (\(x,y). (f:A->C) x,(g:B->D) y) x = f z,y}")
        SUBST1_TAC THENL
         [REWRITE_TAC [EXTENSION, IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM,
                       IN_CROSS, PAIR_EQ] THEN
          ASM SET_TAC [],
          MATCH_MP_TAC IMAGE_COMPACT_IN THEN
          EXISTS_TAC (← q r"prod_topology top1 top2:(A#B)topology") THEN
          REWRITE_TAC [CONTINUOUS_MAP_SND] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
          REWRITE_TAC [IN_CROSS] THEN ASM SET_TAC []]],
      STRIP_TAC THEN REWRITE_TAC [proper_map] THEN CONJ_TAC THENL
       [ALL_TAC,
        REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS] THEN
        MAP_EVERY X_GEN_TAC [← q r"w:C", ← q r"z:D"] THEN STRIP_TAC THEN
        SUBGOAL_THEN
         (← q r"{x | x IN topspace top1 CROSS topspace top2 /\
               (\(x,y). (f:A->C) x,(g:B->D) y) x = w,z} =
          {x | x IN topspace top1 /\ f x = w} CROSS
          {y | y IN topspace top2 /\ g y = z}")
        SUBST1_TAC THENL
         [REWRITE_TAC [EXTENSION, IN_ELIM_THM, FORALL_PAIR_THM, IN_CROSS] THEN
          REWRITE_TAC [PAIR_EQ] THEN MESON_TAC [],
          REWRITE_TAC [COMPACT_IN_CROSS] THEN
          RULE_ASSUM_TAC (REWRITE_RULE [proper_map]) THEN ASM_SIMP_TAC []]] THEN
      REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
        pure (ASSUME_TAC (← MATCH_MP PROPER_MAP_IMP_SUBSET_TOPSPACE th) THEN
              STRIP_ASSUME_TAC (← REWRITE_RULE [proper_map] th)))) THEN
      REWRITE_TAC [CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN CONJ_TAC THENL
       [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, TOPSPACE_PROD_TOPOLOGY] THEN
        REWRITE_TAC [FORALL_PAIR_THM, IN_CROSS] THEN ASM SET_TAC [],
        REWRITE_TAC [FORALL_PAIR_THM, TOPSPACE_PROD_TOPOLOGY, IN_CROSS]] THEN
      MAP_EVERY X_GEN_TAC [← q r"w:A#B->bool", ← q r"y1:C", ← q r"y2:D"] THEN
      SUBGOAL_THEN
       (← q r"{x | x IN topspace top1 CROSS topspace top2 /\
             (\(x,y). (f:A->C) x,(g:B->D) y) x = y1,y2} =
        {x | x IN topspace top1 /\ f x = y1} CROSS
        {y | y IN topspace top2 /\ g y = y2}")
      SUBST1_TAC THENL
       [REWRITE_TAC [EXTENSION, IN_ELIM_THM, FORALL_PAIR_THM, IN_CROSS] THEN
        REWRITE_TAC [PAIR_EQ] THEN MESON_TAC [],
        STRIP_TAC] THEN
      MP_TAC (← ISPECL [← q r"top1:A topology", ← q r"top2:B topology", ← q r"w:A#B->bool",
                       ← q r"{x | x IN topspace top1 /\ (f:A->C) x = y1}",
                       ← q r"{x | x IN topspace top2 /\ (g:B->D) x = y2}"]
          WALLACE_THEOREM_PROD_TOPOLOGY) THEN
      ASM_SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"closed_map(top2,top2') (g:B->D)",
        ← q r"closed_map(top1,top1') (f:A->C)"] THEN
      REWRITE_TAC [IMP_IMP, CLOSED_MAP_FIBRE_NEIGHBOURHOOD] THEN
      DISCH_THEN (CONJUNCTS_THEN (MP_TAC o CONJUNCT2)) THEN
      REWRITE_TAC [IMP_IMP] THEN DISCH_THEN (CONJUNCTS_THEN2
       (MP_TAC o SPECL [← q r"v:B->bool", ← q r"y2:D"])
       (MP_TAC o SPECL [← q r"u:A->bool", ← q r"y1:C"])) THEN
      ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u':C->bool") THEN STRIP_TAC THEN
      X_GEN_TAC (← q r"v':D->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"(u':C->bool) CROSS (v':D->bool)") THEN
      ASM_REWRITE_TAC [IN_CROSS, OPEN_IN_CROSS] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SUBSET])) THEN
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM,
                   IN_ELIM_THM, IN_CROSS, SUBSET] THEN
      SET_TAC []])

  let PROPER_MAP_PAIRED ← prove
   r"!top top1 top2 (f:A->B) (g:A->C).
        hausdorff_space top /\
        proper_map(top,top1) f /\ proper_map(top,top2) g \/
        hausdorff_space top1 /\
        continuous_map(top,top1) f /\ proper_map(top,top2) g \/
        hausdorff_space top2 /\
        proper_map(top,top1) f /\ continuous_map(top,top2) g
        ==> proper_map (top,prod_topology top1 top2) (\x. f x,g x)"
   (REPEAT STRIP_TAC THENL
     [SUBGOAL_THEN (← q r"(\x. f x,g x):A->B#C = (\(x,y). f x,g y) o (\x. x,x)")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM], ALL_TAC] THEN
      MATCH_MP_TAC PROPER_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology (top:A topology) top") THEN
      ASM_REWRITE_TAC [PROPER_MAP_DIAG_EQ, PROPER_MAP_PROD],
      SUBGOAL_THEN (← q r"(\x. f x,g x):A->B#C = (\(x,y). x,g y) o (\x. f x,x)")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM], ALL_TAC] THEN
      MATCH_MP_TAC PROPER_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology top1 top:(B#A)topology") THEN
      ASM_SIMP_TAC [PROPER_MAP_PAIRED_CONTINUOUS_MAP_LEFT] THEN
      ASM_REWRITE_TAC [PROPER_MAP_PROD, PROPER_MAP_ID],
      SUBGOAL_THEN (← q r"(\x. f x,g x):A->B#C = (\(x,y). f x,y) o (\x. x,g x)")
      SUBST1_TAC THENL
       [REWRITE_TAC [FUN_EQ_THM, o_THM, FORALL_PAIR_THM], ALL_TAC] THEN
      MATCH_MP_TAC PROPER_MAP_COMPOSE THEN
      EXISTS_TAC (← q r"prod_topology top top2:(A#C)topology") THEN
      ASM_SIMP_TAC [PROPER_MAP_PAIRED_CONTINUOUS_MAP_RIGHT] THEN
      ASM_REWRITE_TAC [PROPER_MAP_PROD, PROPER_MAP_ID]])

  let PROPER_MAP_PAIRWISE ← prove
   r"!top top1 top2 f:A->B#C.
        hausdorff_space top /\
        proper_map(top,top1) (FST o f) /\ proper_map(top,top2) (SND o f) \/
        hausdorff_space top1 /\
        continuous_map(top,top1) (FST o f) /\ proper_map(top,top2) (SND o f) \/
        hausdorff_space top2 /\
        proper_map(top,top1) (FST o f) /\ continuous_map(top,top2) (SND o f)
        ==> proper_map (top,prod_topology top1 top2) f"
   (REWRITE_TAC [FORALL_PAIR_FUN_THM, o_DEF, ETA_AX] THEN
    REWRITE_TAC [PROPER_MAP_PAIRED])

  let PROPER_MAP_FROM_COMPOSITION_RIGHT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        hausdorff_space top' /\
        proper_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        continuous_map(top',top'') g
        ==> proper_map(top,top') f"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"f = FST o (\x. f x,((g:B->C) o (f:A->B)) x)") SUBST1_TAC THENL
     [REWRITE_TAC [o_DEF, ETA_AX], MATCH_MP_TAC PROPER_MAP_COMPOSE] THEN
    EXISTS_TAC
     (← q r"subtopology (prod_topology top' top'')
                  (IMAGE (\x. x,(g:B->C) x)
                         (topspace top'))") THEN
    CONJ_TAC THENL
     [MATCH_MP_TAC PROPER_MAP_INTO_SUBTOPOLOGY THEN
      ASM_SIMP_TAC [PROPER_MAP_PAIRED, ETA_AX] THEN
      REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP
        CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE)) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [o_THM, IN_IMAGE, PAIR_EQ] THEN SET_TAC [],
      UNDISCH_TAC (← q r"continuous_map (top',top'') (g:B->C)") THEN
      REWRITE_TAC [← GSYM HOMEOMORPHIC_MAPS_GRAPH] THEN
      SIMP_TAC [HOMEOMORPHIC_MAPS_MAP, HOMEOMORPHIC_IMP_PROPER_MAP]])

  let CONTINUOUS_EXTENSION_OF_PROPER_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top top' (f:A->B).
        hausdorff_space top /\
        s SUBSET topspace top /\
        continuous_map (top,top') f /\
        proper_map(subtopology top s,top') f
        ==> closed_in top s"
   (REPEAT STRIP_TAC THEN MP_TAC (← ISPECL
     [← q r"subtopology top (s:A->bool)", ← q r"top:A topology", ← q r"top':B topology",
      ← q r"\x:A. x", ← q r"f:A->B"] PROPER_MAP_FROM_COMPOSITION_RIGHT) THEN
    ASM_SIMP_TAC [o_DEF, PROPER_MAP_INCLUSION, ETA_AX] THEN
    SIMP_TAC [CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_ID])

  return { PROPER_MAP_PROD, PROPER_MAP_PAIRED, PROPER_MAP_PAIRWISE,
           PROPER_MAP_FROM_COMPOSITION_RIGHT, CONTINUOUS_EXTENSION_OF_PROPER_MAP_FROM_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Perfect maps (proper, continuous and surjective).  (metric.ml 10080-10234)  -/
/- ------------------------------------------------------------------------- -/

structure Perfect where
  perfect_map : thm
  HOMEOMORPHIC_IMP_PERFECT_MAP : thm
  PERFECT_IMP_QUOTIENT_MAP : thm
  HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP : thm
  PERFECT_INJECTIVE_EQ_HOMEOMORPHIC_MAP : thm
  PERFECT_MAP_ID : thm
  PERFECT_MAP_COMPOSE : thm
  PERFECT_IMP_CONTINUOUS_MAP : thm
  PERFECT_IMP_CLOSED_MAP : thm
  PERFECT_IMP_PROPER_MAP : thm
  PERFECT_IMP_SURJECTIVE_MAP : thm
  CONTINUOUS_CLOSED_IMP_PERFECT_MAP : thm
  CONTINUOUS_IMP_PEFECT_MAP : thm
  PERFECT_MAP_FST : thm
  PERFECT_MAP_SND : thm
  PERFECT_MAP_RESTRICTION : thm
  PERFECT_MAP_FROM_COMPOSITION_LEFT : thm
  PERFECT_MAP_FROM_COMPOSITION_RIGHT : thm
  PERFECT_MAP_FROM_COMPOSITION_RIGHT_INJ : thm
  deriving Inhabited

@[nospecialize]
def setupPerfect [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BContMap2 : ContMap2) (BQuotient : Quotient) (BProd1 : Prod1)
    (BHomeo1 : Homeo1) (BCompact1 : Compact1) (BKC1 : KC1) (BProper1 : Proper1)
    (BProper2 : Proper2) (BProper3 : Proper3) : ExceptT String IO Perfect := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_METIS_TAC, MESON_TAC, SET_TAC, new_definition, .. } := D
  let { COND_ID, IMAGE_FST_CROSS, IMAGE_ID, .. } := D.core1
  let { IMAGE_SND_CROSS, IMAGE_o, IMP_CONJ, .. } := D.core2
  let { SUBSET_REFL, .. } := D.core4
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, .. } := BContMap1
  let { CONTINUOUS_MAP_COMPOSE, CONTINUOUS_MAP_FROM_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
        .. } := BContMap2
  let { CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP, .. } := BQuotient
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND, TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_IMP_INJECTIVE_MAP, homeomorphic_map,
        .. } := BHomeo1
  let { COMPACT_SPACE_TOPSPACE_EMPTY, .. } := BCompact1
  let { CONTINUOUS_IMP_CLOSED_MAP_GEN, .. } := BKC1
  let { HOMEOMORPHIC_IMP_PROPER_MAP, PROPER_IMP_CLOSED_MAP, PROPER_MAP_COMPOSE, PROPER_MAP_ID,
        proper_map, .. } := BProper1
  let { CONTINUOUS_CLOSED_IMP_PROPER_MAP, CONTINUOUS_IMP_PROPER_MAP,
        PROPER_MAP_FROM_COMPOSITION_LEFT, PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ, PROPER_MAP_FST,
        PROPER_MAP_RESTRICTION, PROPER_MAP_SND, .. } := BProper2
  let { PROPER_MAP_FROM_COMPOSITION_RIGHT, .. } := BProper3
  -- @@SCOPE END

  let perfect_map ← new_definition
   r"perfect_map (top,top') (f:A->B) <=>
        continuous_map(top,top') f /\
        proper_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'"

  let HOMEOMORPHIC_IMP_PERFECT_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f ==> perfect_map(top,top') f"
   (SIMP_TAC [perfect_map, HOMEOMORPHIC_IMP_PROPER_MAP] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN REPEAT STRIP_TAC THEN
    ASM_REWRITE_TAC [])

  let PERFECT_IMP_QUOTIENT_MAP ← prove
   r"!top top' (f:A->B). perfect_map(top,top') f ==> quotient_map(top,top') f"
   (SIMP_TAC [perfect_map, proper_map, CONTINUOUS_CLOSED_IMP_QUOTIENT_MAP])

  let HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP ← prove
   r"!top top' (f:A->B).
        homeomorphic_map(top,top') f <=>
        perfect_map(top,top') f /\
        !x y. x IN topspace top /\ y IN topspace top
              ==> (f x = f y <=> x = y)"
   (MESON_TAC [HOMEOMORPHIC_IMP_PERFECT_MAP, HOMEOMORPHIC_IMP_INJECTIVE_MAP,
               homeomorphic_map, PERFECT_IMP_QUOTIENT_MAP])

  let PERFECT_INJECTIVE_EQ_HOMEOMORPHIC_MAP ← prove
   r"!top top' (f:A->B).
      perfect_map(top,top') f /\
      (!x y. x IN topspace top /\ y IN topspace top /\ f x = f y ==> x = y) <=>
      homeomorphic_map(top,top') f"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [REWRITE_TAC [homeomorphic_map] THEN MESON_TAC [PERFECT_IMP_QUOTIENT_MAP],
      MESON_TAC [HOMEOMORPHIC_IMP_PERFECT_MAP, HOMEOMORPHIC_IMP_INJECTIVE_MAP]])

  let PERFECT_MAP_ID ← prove
   r"!top:A topology. perfect_map(top,top) (\x. x)"
   (REWRITE_TAC [perfect_map, IMAGE_ID, PROPER_MAP_ID, CONTINUOUS_MAP_ID])

  let PERFECT_MAP_COMPOSE ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        perfect_map(top,top') f /\ perfect_map(top',top'') g
        ==> perfect_map(top,top'') (g o f)"
   (REWRITE_TAC [perfect_map] THEN
    MESON_TAC [PROPER_MAP_COMPOSE, IMAGE_o, CONTINUOUS_MAP_COMPOSE])

  let PERFECT_IMP_CONTINUOUS_MAP ← prove
   r"!top top' (f:A->B).
        perfect_map(top,top') f ==> continuous_map(top,top') f"
   (SIMP_TAC [perfect_map])

  let PERFECT_IMP_CLOSED_MAP ← prove
   r"!top top' (f:A->B).
        perfect_map(top,top') f ==> closed_map(top,top') f"
   (SIMP_TAC [perfect_map, PROPER_IMP_CLOSED_MAP])

  let PERFECT_IMP_PROPER_MAP ← prove
   r"!top top' (f:A->B).
        perfect_map(top,top') f ==> proper_map(top,top') f"
   (SIMP_TAC [perfect_map])

  let PERFECT_IMP_SURJECTIVE_MAP ← prove
   r"!top top' (f:A->B).
        perfect_map(top,top') f ==> IMAGE f (topspace top) = topspace top'"
   (SIMP_TAC [perfect_map])

  let CONTINUOUS_CLOSED_IMP_PERFECT_MAP ← prove
   r"!top top' (f:A->B).
        compact_space top /\ t1_space top' /\
        continuous_map (top,top') f /\
        closed_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> perfect_map (top,top') f"
   (SIMP_TAC [perfect_map, CONTINUOUS_CLOSED_IMP_PROPER_MAP])

  let CONTINUOUS_IMP_PEFECT_MAP ← prove
   r"!top top' (f:A->B).
        compact_space top /\ kc_space top' /\
        continuous_map (top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> perfect_map (top,top') f"
   (SIMP_TAC [perfect_map, CONTINUOUS_IMP_PROPER_MAP,
              CONTINUOUS_IMP_CLOSED_MAP_GEN])

  let PERFECT_MAP_FST ← prove
   r"!(top:A topology) (top':B topology).
        perfect_map(prod_topology top top',top) FST <=>
        (topspace top = {} \/ compact_space top') /\
        (topspace top' = {} ==> topspace top = {})"
   (REWRITE_TAC [perfect_map, PROPER_MAP_FST, CONTINUOUS_MAP_FST] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IMAGE_FST_CROSS] THEN
    REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN ASM_REWRITE_TAC [COND_ID] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [COMPACT_SPACE_TOPSPACE_EMPTY])

  let PERFECT_MAP_SND ← prove
   r"!(top:A topology) (top':B topology).
        perfect_map(prod_topology top top',top') SND <=>
        (topspace top' = {} \/ compact_space top) /\
        (topspace top = {} ==> topspace top' = {})"
   (REWRITE_TAC [perfect_map, PROPER_MAP_SND, CONTINUOUS_MAP_SND] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY, IMAGE_SND_CROSS] THEN
    REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace top':B->bool = {}") THEN ASM_REWRITE_TAC [COND_ID] THEN
    COND_CASES_TAC THEN ASM_SIMP_TAC [COMPACT_SPACE_TOPSPACE_EMPTY])

  let PERFECT_MAP_RESTRICTION ← prove
   r"!top top' (f:A->B) u v.
        perfect_map (top,top') f /\ {x | x IN topspace top /\ f x IN v} = u
        ==> perfect_map (subtopology top u,subtopology top' v) f"
   (REPEAT GEN_TAC THEN SIMP_TAC [perfect_map, PROPER_MAP_RESTRICTION] THEN
    SIMP_TAC [TOPSPACE_SUBTOPOLOGY, CONTINUOUS_MAP_IN_SUBTOPOLOGY,
              CONTINUOUS_MAP_FROM_SUBTOPOLOGY] THEN
    SET_TAC [])

  let PERFECT_MAP_FROM_COMPOSITION_LEFT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        perfect_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        continuous_map(top',top'') g /\
        IMAGE f (topspace top) = topspace top'
        ==> perfect_map(top',top'') g"
   (REWRITE_TAC [perfect_map] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          PROPER_MAP_FROM_COMPOSITION_LEFT)),
      ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [IMAGE_o]) THEN ASM SET_TAC [])

  let PERFECT_MAP_FROM_COMPOSITION_RIGHT ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        hausdorff_space top' /\
        perfect_map(top,top'') (g o f) /\
        continuous_map(top,top') f /\
        continuous_map(top',top'') g /\
        IMAGE f (topspace top) = topspace top'
        ==> perfect_map(top,top') f"
   (REWRITE_TAC [perfect_map] THEN REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    ASM_MESON_TAC [PROPER_MAP_FROM_COMPOSITION_RIGHT])

  let PERFECT_MAP_FROM_COMPOSITION_RIGHT_INJ ← prove
   r"!top top' top'' (f:A->B) (g:B->C).
        perfect_map(top,top'') (g o f) /\
        IMAGE f (topspace top) = topspace top' /\
        continuous_map(top,top') f /\
        continuous_map(top',top'') g /\
        (!x y. x IN topspace top' /\ y IN topspace top' /\ g x = g y
               ==> x = y)
        ==> perfect_map(top,top') f"
   (REPEAT GEN_TAC THEN REWRITE_TAC [perfect_map] THEN STRIP_TAC THEN
    ASM_REWRITE_TAC [] THEN
    ASM_METIS_TAC [PROPER_MAP_FROM_COMPOSITION_RIGHT_INJ, SUBSET_REFL])

  return { perfect_map, HOMEOMORPHIC_IMP_PERFECT_MAP, PERFECT_IMP_QUOTIENT_MAP,
           HOMEOMORPHIC_EQ_INJECTIVE_PERFECT_MAP, PERFECT_INJECTIVE_EQ_HOMEOMORPHIC_MAP,
           PERFECT_MAP_ID, PERFECT_MAP_COMPOSE, PERFECT_IMP_CONTINUOUS_MAP,
           PERFECT_IMP_CLOSED_MAP, PERFECT_IMP_PROPER_MAP, PERFECT_IMP_SURJECTIVE_MAP,
           CONTINUOUS_CLOSED_IMP_PERFECT_MAP, CONTINUOUS_IMP_PEFECT_MAP, PERFECT_MAP_FST,
           PERFECT_MAP_SND, PERFECT_MAP_RESTRICTION, PERFECT_MAP_FROM_COMPOSITION_LEFT,
           PERFECT_MAP_FROM_COMPOSITION_RIGHT, PERFECT_MAP_FROM_COMPOSITION_RIGHT_INJ }

/- ------------------------------------------------------------------------- -/
/- Preservation theorems for proper or perfect maps.  (metric.ml 10236-10381)  -/
/- ------------------------------------------------------------------------- -/

structure Preserve where
  DISCRETE_SPACE_PERFECT_MAP_IMAGE : thm
  KC_SPACE_PROPER_MAP_IMAGE : thm
  KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : thm
  KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ : thm
  HAUSDORFF_SPACE_PROPER_MAP_IMAGE : thm
  HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE : thm
  HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ : thm
  HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE : thm
  HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE_EQ : thm
  T1_SPACE_PERFECT_MAP_IMAGE : thm
  HAUSDORFF_SPACE_PERFECT_MAP_IMAGE : thm
  COMPACT_SPACE_PERFECT_MAP_IMAGE : thm
  COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ : thm
  KC_SPACE_PERFECT_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupPreserve [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BOpenClosed1 : OpenClosed1) (BOpenClosed2 : OpenClosed2) (BCompact1 : Compact1)
    (BCompact3 : Compact3) (BT1b : T1b) (BHausdorff1 : Hausdorff1) (BHausdorff2 : Hausdorff2)
    (BKC1 : KC1) (BProper1 : Proper1) (BProper2 : Proper2) (BPerfect : Perfect) :
    ExceptT String IO Preserve := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_TAC, .. } := D
  let { FORALL_SUBSET_IMAGE, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, IN_SING, LEFT_IMP_EXISTS_THM, MONO_EXISTS, .. } := D.core2
  let { SING_SUBSET, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, .. } := D.core5
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { closed_map, .. } := BOpenClosed1
  let { CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD, DISCRETE_SPACE_CLOSED_MAP_IMAGE, .. } := BOpenClosed2
  let { COMPACT_IN_SUBSET_TOPSPACE, .. } := BCompact1
  let { COMPACT_SPACE_QUOTIENT_MAP_IMAGE, .. } := BCompact3
  let { T1_SPACE_CLOSED_MAP_IMAGE, .. } := BT1b
  let { HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_COMPACT_SETS, hausdorff_space,
        .. } := BHausdorff1
  let { CONTINUOUS_IMP_CLOSED_MAP, .. } := BHausdorff2
  let { CONTINUOUS_IMP_CLOSED_MAP_GEN, HAUSDORFF_IMP_KC_SPACE, KC_IMP_T1_SPACE, kc_space,
        .. } := BKC1
  let { COMPACT_SPACE_PROPER_MAP_PREIMAGE, PROPER_MAP_ALT, proper_map, .. } := BProper1
  let { CONTINUOUS_CLOSED_IMP_PROPER_MAP, .. } := BProper2
  let { PERFECT_IMP_QUOTIENT_MAP, perfect_map, .. } := BPerfect
  -- @@SCOPE END

  let DISCRETE_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        discrete_space top /\ perfect_map (top,top') f
        ==> discrete_space top'"
   (REWRITE_TAC [perfect_map, proper_map] THEN
    MESON_TAC [DISCRETE_SPACE_CLOSED_MAP_IMAGE])

  let KC_SPACE_PROPER_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        kc_space top /\
        proper_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> kc_space top'"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [kc_space] THEN
    ONCE_REWRITE_TAC [← MESON [COMPACT_IN_SUBSET_TOPSPACE] (← q
     r"compact_in top s <=> s SUBSET topspace top /\ compact_in top s")] THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"s:A->bool") THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"IMAGE (f:A->B) s = IMAGE f {x | x IN topspace top /\ f x IN IMAGE f s}")
    SUBST1_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [closed_map, kc_space, PROPER_MAP_ALT]) THEN
    ASM_SIMP_TAC [])

  let KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        kc_space top /\
        compact_space top /\
        closed_map(top,top') f /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> kc_space top'"
   (MESON_TAC [KC_SPACE_PROPER_MAP_IMAGE, KC_IMP_T1_SPACE,
               T1_SPACE_CLOSED_MAP_IMAGE, CONTINUOUS_CLOSED_IMP_PROPER_MAP])

  let KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
        kc_space top /\
        compact_space top /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> (closed_map(top,top') f <=> kc_space top')"
   (MESON_TAC [KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE,
               CONTINUOUS_IMP_CLOSED_MAP_GEN])

  let HAUSDORFF_SPACE_PROPER_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        hausdorff_space top /\
        proper_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> hausdorff_space top'"
   (REWRITE_TAC [proper_map] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [hausdorff_space] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:B", ← q r"y:B"] THEN STRIP_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE id [HAUSDORFF_SPACE_COMPACT_SETS]) THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"{z | z IN topspace top /\ (f:A->B) z = x}",
      ← q r"{z | z IN topspace top /\ (f:A->B) z = y}"]) THEN
    ASM_SIMP_TAC [] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
    STRIP_TAC THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o GEN_REWRITE_RULE id
     [CLOSED_MAP_PREIMAGE_NEIGHBOURHOOD]) THEN
    DISCH_THEN (fun th => tactic_of do
      pure (MP_TAC (← SPECL [← q r"u:A->bool", ← q r"{x:B}"] th) THEN
            MP_TAC (← SPECL [← q r"v:A->bool", ← q r"{y:B}"] th))) THEN
    ASM_REWRITE_TAC [SING_SUBSET, IN_SING, IMP_IMP, RIGHT_AND_EXISTS_THM] THEN
    REWRITE_TAC [LEFT_AND_EXISTS_THM] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        compact_space top /\ hausdorff_space top /\
        closed_map(top,top') f /\ continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> hausdorff_space top'"
   (MESON_TAC [HAUSDORFF_SPACE_PROPER_MAP_IMAGE,
               CONTINUOUS_CLOSED_IMP_PROPER_MAP,
               T1_SPACE_CLOSED_MAP_IMAGE, HAUSDORFF_IMP_T1_SPACE])

  let HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
        compact_space top /\ hausdorff_space top /\
        continuous_map(top,top') f /\ IMAGE f (topspace top) = topspace top'
        ==> (closed_map(top,top') f <=> hausdorff_space top')"
   (MESON_TAC [HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE,
               CONTINUOUS_IMP_CLOSED_MAP])

  let HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        compact_space top /\ hausdorff_space top /\ kc_space top' /\
        continuous_map(top,top') f /\
        IMAGE f (topspace top) = topspace top'
        ==> hausdorff_space top'"
   (REPEAT STRIP_TAC THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"top':B topology", ← q r"f:A->B"]
          HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE) THEN
    DISCH_THEN MATCH_MP_TAC THEN ASM_SIMP_TAC [KC_IMP_T1_SPACE] THEN
    MATCH_MP_TAC CONTINUOUS_IMP_CLOSED_MAP_GEN THEN ASM_REWRITE_TAC [])

  let HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
        compact_space top /\ hausdorff_space top /\
        continuous_map(top,top') f /\ IMAGE f (topspace top) = topspace top'
        ==> (hausdorff_space top' <=> kc_space top')"
   (MESON_TAC [HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ,
               KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ,
               HAUSDORFF_IMP_KC_SPACE])

  let T1_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
        t1_space top /\ perfect_map(top,top') f ==> t1_space top'"
   (REWRITE_TAC [perfect_map, proper_map] THEN
    MESON_TAC [T1_SPACE_CLOSED_MAP_IMAGE])

  let HAUSDORFF_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    hausdorff_space top /\ perfect_map(top,top') f ==> hausdorff_space top'"
   (REWRITE_TAC [perfect_map] THEN MESON_TAC [HAUSDORFF_SPACE_PROPER_MAP_IMAGE])

  let COMPACT_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    compact_space top /\ perfect_map(top,top') f ==> compact_space top'"
   (MESON_TAC [COMPACT_SPACE_QUOTIENT_MAP_IMAGE, PERFECT_IMP_QUOTIENT_MAP])

  let COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
      perfect_map(top,top') f ==> (compact_space top <=> compact_space top')"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [COMPACT_SPACE_PERFECT_MAP_IMAGE],
      ASM_MESON_TAC [perfect_map, COMPACT_SPACE_PROPER_MAP_PREIMAGE]])

  let KC_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
      kc_space top /\ perfect_map(top,top') f
      ==> kc_space top'"
   (REWRITE_TAC [perfect_map] THEN MESON_TAC [KC_SPACE_PROPER_MAP_IMAGE])

  return { DISCRETE_SPACE_PERFECT_MAP_IMAGE, KC_SPACE_PROPER_MAP_IMAGE,
           KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE, KC_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ,
           HAUSDORFF_SPACE_PROPER_MAP_IMAGE, HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE,
           HAUSDORFF_SPACE_CLOSED_CONTINUOUS_MAP_IMAGE_EQ, HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE,
           HAUSDORFF_SPACE_CONTINUOUS_MAP_IMAGE_EQ, T1_SPACE_PERFECT_MAP_IMAGE,
           HAUSDORFF_SPACE_PERFECT_MAP_IMAGE, COMPACT_SPACE_PERFECT_MAP_IMAGE,
           COMPACT_SPACE_PERFECT_MAP_IMAGE_EQ, KC_SPACE_PERFECT_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Lindelof spaces.  (metric.ml 10383-10619)                                  -/
/- ------------------------------------------------------------------------- -/

structure Lindelof where
  lindelof_space : thm
  LINDELOF_SPACE_ALT : thm
  COMPACT_IMP_LINDELOF_SPACE : thm
  LINDELOF_SPACE_TOPSPACE_EMPTY : thm
  LINDELOF_SPACE_UNIONS : thm
  COUNTABLE_IMP_LINDELOF_SPACE : thm
  LINDELOF_SPACE_SUBTOPOLOGY : thm
  LINDELOF_SPACE_SUBTOPOLOGY_SUBSET : thm
  LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY : thm
  LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE : thm
  LINDELOF_SPACE_QUOTIENT_MAP_IMAGE : thm
  LINDELOF_SPACE_RETRACTION_MAP_IMAGE : thm
  LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE : thm
  LINDELOF_SPACE_PROPER_MAP_PREIMAGE : thm
  LINDELOF_SPACE_PERFECT_MAP_IMAGE : thm
  LINDELOF_SPACE_PERFECT_MAP_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupLindelof [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BIterLocal : IterLocal) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) (BRetraction : Retraction)
    (BCompact1 : Compact1) (BProper1 : Proper1) (BPerfect : Perfect) :
    ExceptT String IO Lindelof := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { FORALL_IN_GSPEC, FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_SUBSET_IMAGE,
        .. } := D.core1
  let { IMP_CONJ, INTER_SUBSET, INTER_UNIONS, IN_ELIM_THM, IN_INSERT, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, .. } := D.core2
  let { RIGHT_IMP_FORALL_THM, SIMPLE_IMAGE, SIMPLE_IMAGE_GEN, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, SUBSET_INTER, SUBSET_RESTRICT, SWAP_FORALL_THM, UNIONS_GSPEC,
        UNIONS_IMAGE, UNIONS_INSERT, UNIONS_SINGS, UNIONS_SUBSET, .. } := D.core4
  let { RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { COUNTABLE_DELETE, COUNTABLE_IMAGE, COUNTABLE_INSERT, COUNTABLE_SUBSET,
        COUNTABLE_UNIONS, EXISTS_COUNTABLE_SUBSET_IMAGE, FINITE_IMP_COUNTABLE,
        FORALL_COUNTABLE_SUBSET_IMAGE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY_ALT, SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { locally_finite_in, .. } := BIterLocal
  let { continuous_map, .. } := BContMap1
  let { CLOSED_MAP_IMP_SUBSET_TOPSPACE, closed_map, .. } := BOpenClosed1
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, .. } := BQuotient
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { COMPACT_IN_SING, COMPACT_SPACE, COMPACT_SPACE_SUBTOPOLOGY,
        COMPACT_SPACE_TOPSPACE_EMPTY, compact_in, .. } := BCompact1
  let { proper_map, .. } := BProper1
  let { PERFECT_IMP_QUOTIENT_MAP, perfect_map, .. } := BPerfect
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let lindelof_space ← new_definition
   r"lindelof_space (top:A topology) <=>
        !U. (!u. u IN U ==> open_in top u) /\ UNIONS U = topspace top
            ==> ?V. COUNTABLE V /\ V SUBSET U /\ UNIONS V = topspace top"

  let LINDELOF_SPACE_ALT ← prove
   r"!top:A topology.
        lindelof_space top <=>
        !U. (!u. u IN U ==> open_in top u) /\
            topspace top SUBSET UNIONS U
            ==> ?V. COUNTABLE V /\ V SUBSET U /\ topspace top SUBSET UNIONS V"
   (GEN_TAC THEN REWRITE_TAC [lindelof_space] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, UNIONS_SUBSET] THEN
    AP_TERM_TAC THEN ABS_TAC THEN  MESON_TAC [OPEN_IN_SUBSET, SUBSET])

  let COMPACT_IMP_LINDELOF_SPACE ← prove
   r"!top:A topology. compact_space top ==> lindelof_space top"
   (REWRITE_TAC [lindelof_space, COMPACT_SPACE] THEN
    MESON_TAC [FINITE_IMP_COUNTABLE])

  let LINDELOF_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> lindelof_space top"
   (SIMP_TAC [COMPACT_IMP_LINDELOF_SPACE, COMPACT_SPACE_TOPSPACE_EMPTY])

  let LINDELOF_SPACE_UNIONS ← prove
   r"!top U:(A->bool)->bool.
        COUNTABLE U /\
        (!c. c IN U ==> lindelof_space (subtopology top c))
        ==> lindelof_space (subtopology top (UNIONS U))"
   (REPEAT GEN_TAC THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [lindelof_space] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"f:(A->bool)->bool") THEN REPEAT DISCH_TAC THEN FIRST_X_ASSUM
     (MP_TAC o GEN_REWRITE_RULE BINDER_CONV [RIGHT_IMP_FORALL_THM]) THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_FORALL_THM] THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"f:(A->bool)->bool")) THEN
    ASM_REWRITE_TAC [] THEN FIRST_ASSUM (ASSUME_TAC o MATCH_MP (← sr
     r"UNIONS u INTER s = t INTER UNIONS u
      ==> !c. c IN u ==> c INTER s = t INTER c")) THEN
    ASM_SIMP_TAC [] THEN
    GEN_REWRITE_TAC (LAND_CONV o BINDER_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:(A->bool)->(A->bool)->bool") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"UNIONS(IMAGE (g:(A->bool)->(A->bool)->bool) U)") THEN
    ASM_SIMP_TAC [COUNTABLE_UNIONS, FORALL_IN_IMAGE, COUNTABLE_IMAGE] THEN
    ASM SET_TAC [])

  let COUNTABLE_IMP_LINDELOF_SPACE ← prove
   r"!top:A topology. COUNTABLE(topspace top) ==> lindelof_space top"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM SUBTOPOLOGY_TOPSPACE] THEN
    GEN_REWRITE_TAC (RAND_CONV o RAND_CONV) [← GSYM UNIONS_SINGS] THEN
    MATCH_MP_TAC LINDELOF_SPACE_UNIONS THEN
    ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    MATCH_MP_TAC COMPACT_IMP_LINDELOF_SPACE THEN
    MATCH_MP_TAC COMPACT_SPACE_SUBTOPOLOGY THEN
    ASM_REWRITE_TAC [COMPACT_IN_SING])

  let LINDELOF_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        lindelof_space(subtopology top s) <=>
        !U. (!u. u IN U ==> open_in top u) /\
            topspace top INTER s SUBSET UNIONS U
            ==> ?V. COUNTABLE V /\ V SUBSET U /\
                    topspace top INTER s SUBSET UNIONS V"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [lindelof_space] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, ← GSYM SUBSET] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    REWRITE_TAC [IMP_CONJ, FORALL_SUBSET_IMAGE] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
    REWRITE_TAC [← GSYM SIMPLE_IMAGE, ← GSYM INTER_UNIONS] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    SIMP_TAC [← GSYM SUBSET_ANTISYM_EQ, INTER_SUBSET, SUBSET_INTER] THEN
    REWRITE_TAC [← sr r"s SUBSET {x | P x} <=> !x. x IN s ==> P x"] THEN
    SIMP_TAC [OPEN_IN_SUBSET, ← sr
     r"(!x. x IN U ==> x SUBSET t)
      ==> (V SUBSET U /\ s INTER UNIONS V SUBSET t /\ P <=>
           V SUBSET U /\ P) /\
          (s INTER UNIONS U SUBSET t)"])

  let LINDELOF_SPACE_SUBTOPOLOGY_SUBSET ← prove
   r"!top s:A->bool.
        s SUBSET topspace top
        ==> (lindelof_space(subtopology top s) <=>
             !U. (!u. u IN U ==> open_in top u) /\ s SUBSET UNIONS U
                 ==> ?V. COUNTABLE V /\ V SUBSET U /\ s SUBSET UNIONS V)"
   (SIMP_TAC [LINDELOF_SPACE_SUBTOPOLOGY, ← sr
     r"s SUBSET u ==> u INTER s = s"])

  let LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        lindelof_space top /\ closed_in top s
        ==> lindelof_space(subtopology top s)"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [LINDELOF_SPACE_SUBTOPOLOGY_SUBSET, CLOSED_IN_SUBSET] THEN
    X_GEN_TAC (← q r"f:(A->bool)->bool") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(topspace top DIFF s:A->bool) INSERT f") o
      REWRITE_RULE [lindelof_space]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [SUBSET, IN_ELIM_THM]) THEN
    ASM_SIMP_TAC [FORALL_IN_INSERT, OPEN_IN_TOPSPACE, OPEN_IN_DIFF] THEN
    SUBGOAL_THEN (← q r"(UNIONS f:A->bool) SUBSET topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [UNIONS_SUBSET, OPEN_IN_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [UNIONS_INSERT] THEN ANTS_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"g DELETE (topspace top DIFF s:A->bool)") THEN
    ASM_REWRITE_TAC [COUNTABLE_DELETE] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"UNIONS((topspace top DIFF s) INSERT
             (g DELETE (topspace top DIFF s))):A->bool =
      UNIONS((topspace top DIFF s) INSERT g)")
    MP_TAC THENL
     [AP_TERM_TAC THEN ASM SET_TAC [],
      ASM_REWRITE_TAC [UNIONS_INSERT] THEN ASM SET_TAC []])

  let LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        lindelof_space top /\
        continuous_map (top,top') f /\ IMAGE f (topspace top) = topspace top'
        ==> lindelof_space top'"
   (REWRITE_TAC [continuous_map] THEN REPEAT STRIP_TAC THEN
    REWRITE_TAC [lindelof_space] THEN X_GEN_TAC (← q r"U:(B->bool)->bool") THEN
    DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [lindelof_space]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"IMAGE (\u. {x | x IN topspace top /\ (f:A->B) x IN u}) U")) THEN
    ASM_SIMP_TAC [FORALL_IN_IMAGE, UNIONS_IMAGE] THEN ANTS_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE]] THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"V:(B->bool)->bool") THEN
    REWRITE_TAC [UNIONS_IMAGE] THEN ASM SET_TAC [])

  let LINDELOF_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ lindelof_space top
        ==> lindelof_space top'"
   (MESON_TAC [QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_IMP_CONTINUOUS_MAP,
               LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE])

  let LINDELOF_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ lindelof_space top
        ==> lindelof_space top'"
   (MESON_TAC [LINDELOF_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE ← prove
   r"!(top:A topology) u.
        lindelof_space top /\
        topspace top SUBSET UNIONS u /\
        locally_finite_in top u
        ==> COUNTABLE u"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [locally_finite_in]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [RIGHT_IMP_EXISTS_THM, LEFT_IMP_EXISTS_THM, SKOLEM_THM] THEN
    X_GEN_TAC (← q r"t:A->A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LINDELOF_SPACE_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"IMAGE (t:A->A->bool) (topspace top)")) THEN
    ASM_SIMP_TAC [UNIONS_IMAGE, FORALL_IN_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    REWRITE_TAC [← TAUT (← q r"p /\ q /\ r ==> s <=> p /\ q ==> r ==> s")] THEN
    REWRITE_TAC [FORALL_COUNTABLE_SUBSET_IMAGE] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN REPEAT STRIP_TAC THEN
    MATCH_MP_TAC COUNTABLE_SUBSET THEN EXISTS_TAC
      (← q r"{} INSERT
       UNIONS {{c | c IN u /\ ~(c INTER (t:A->A->bool) a = {})} | a IN k}") THEN
    CONJ_TAC THENL
     [REWRITE_TAC [COUNTABLE_INSERT] THEN MATCH_MP_TAC COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC FINITE_IMP_COUNTABLE THEN
      ASM SET_TAC [],
      REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM, IN_INSERT] THEN
      ASM SET_TAC []])

  let LINDELOF_SPACE_PROPER_MAP_PREIMAGE ← prove
   r"!top top' (f:A->B).
        proper_map(top,top') f /\ lindelof_space top'
        ==> lindelof_space top"
   (REWRITE_TAC [proper_map] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CLOSED_MAP_IMP_SUBSET_TOPSPACE) THEN
    REWRITE_TAC [LINDELOF_SPACE_ALT] THEN
    X_GEN_TAC (← q r"u:(A->bool)->bool") THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"!y. y IN topspace top'
          ==> ?v. FINITE v /\ v SUBSET u /\
                  {x | x IN topspace top /\ (f:A->B) x = y} SUBSET UNIONS v")
    MP_TAC THENL
     [X_GEN_TAC (← q r"y:B") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPEC (← q r"y:B")) THEN ASM_REWRITE_TAC [] THEN
      ASM_REWRITE_TAC [compact_in, SUBSET_RESTRICT] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM SET_TAC [],
      GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
      REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"v:B->(A->bool)->bool") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [LINDELOF_SPACE_ALT]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"{ topspace top' DIFF IMAGE (f:A->B) (topspace top DIFF UNIONS (v y)) |y|
        (y:B) IN topspace top'}")) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"y:B") THEN
        DISCH_TAC THEN MATCH_MP_TAC OPEN_IN_DIFF THEN
        REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
        FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [closed_map]) THEN
        MATCH_MP_TAC CLOSED_IN_DIFF THEN REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
        MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM SET_TAC [],
        REWRITE_TAC [UNIONS_GSPEC] THEN ASM SET_TAC []],
      REWRITE_TAC [SIMPLE_IMAGE, EXISTS_COUNTABLE_SUBSET_IMAGE] THEN
      REWRITE_TAC [UNIONS_IMAGE] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:B->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"UNIONS { (v:B->(A->bool)->bool) y | y IN j}") THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      MATCH_MP_TAC COUNTABLE_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_GSPEC] THEN
      ASM_MESON_TAC [FINITE_IMP_COUNTABLE, SUBSET]])

  let LINDELOF_SPACE_PERFECT_MAP_IMAGE ← prove
   r"!top top' (f:A->B).
    lindelof_space top /\ perfect_map(top,top') f ==> lindelof_space top'"
   (MESON_TAC [LINDELOF_SPACE_QUOTIENT_MAP_IMAGE, PERFECT_IMP_QUOTIENT_MAP])

  let LINDELOF_SPACE_PERFECT_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B).
      perfect_map(top,top') f ==> (lindelof_space top <=> lindelof_space top')"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [ASM_MESON_TAC [LINDELOF_SPACE_PERFECT_MAP_IMAGE],
      ASM_MESON_TAC [perfect_map, LINDELOF_SPACE_PROPER_MAP_PREIMAGE]])

  return { lindelof_space, LINDELOF_SPACE_ALT, COMPACT_IMP_LINDELOF_SPACE,
           LINDELOF_SPACE_TOPSPACE_EMPTY, LINDELOF_SPACE_UNIONS, COUNTABLE_IMP_LINDELOF_SPACE,
           LINDELOF_SPACE_SUBTOPOLOGY, LINDELOF_SPACE_SUBTOPOLOGY_SUBSET,
           LINDELOF_SPACE_CLOSED_IN_SUBTOPOLOGY, LINDELOF_SPACE_CONTINUOUS_MAP_IMAGE,
           LINDELOF_SPACE_QUOTIENT_MAP_IMAGE, LINDELOF_SPACE_RETRACTION_MAP_IMAGE,
           LOCALLY_FINITE_COVER_OF_LINDELOF_SPACE, LINDELOF_SPACE_PROPER_MAP_PREIMAGE,
           LINDELOF_SPACE_PERFECT_MAP_IMAGE, LINDELOF_SPACE_PERFECT_MAP_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- Other countability properties.  (metric.ml 10621-10878)                   -/
/- ------------------------------------------------------------------------- -/

structure Countability where
  second_countable : thm
  first_countable : thm
  separable_space : thm
  SECOND_COUNTABLE : thm
  SECOND_COUNTABLE_SUBTOPOLOGY : thm
  SECOND_COUNTABLE_DISCRETE_TOPOLOGY : thm
  SECOND_COUNTABLE_OPEN_MAP_IMAGE : thm
  HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY : thm
  SECOND_COUNTABLE_RETRACTION_MAP_IMAGE : thm
  SECOND_COUNTABLE_IMP_FIRST_COUNTABLE : thm
  FIRST_COUNTABLE_SUBTOPOLOGY : thm
  FIRST_COUNTABLE_DISCRETE_TOPOLOGY : thm
  FIRST_COUNTABLE_OPEN_MAP_IMAGE : thm
  HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY : thm
  FIRST_COUNTABLE_RETRACTION_MAP_IMAGE : thm
  SEPARABLE_SPACE_OPEN_SUBSET : thm
  SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE : thm
  SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE : thm
  SEPARABLE_SPACE_RETRACTION_MAP_IMAGE : thm
  HOMEOMORPHIC_SEPARABLE_SPACE : thm
  SEPARABLE_SPACE_DISCRETE_TOPOLOGY : thm
  SECOND_COUNTABLE_IMP_SEPARABLE_SPACE : thm
  SECOND_COUNTABLE_IMP_LINDELOF_SPACE : thm
  deriving Inhabited

@[nospecialize]
def setupCountability [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BBases : Bases) (BClosure : Closure) (BContMap1 : ContMap1)
    (BOpenClosed1 : OpenClosed1) (BQuotient : Quotient) (BHomeo1 : Homeo1)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BRetractOf : RetractOf)
    (BLindelof : Lindelof) : ExceptT String IO Countability := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { EXISTS_IN_IMAGE, EXISTS_IN_INSERT, EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, INTER_SUBSET, IN_DELETE, IN_ELIM_THM, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE_GEN, SING_SUBSET, SKOLEM_THM, SUBSET,
        SUBSET_ANTISYM_EQ, UNIONS_IMAGE, le_c, .. } := D.core4
  let { CARD_LE_COUNTABLE, COUNTABLE_DELETE, COUNTABLE_IMAGE, COUNTABLE_INTER,
        COUNTABLE_RESTRICT, COUNTABLE_SING, EXISTS_COUNTABLE_SUBSET_IMAGE, .. } := D.lib
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { OPEN_IN_SUBTOPOLOGY_ALT, OPEN_IN_SUBTOPOLOGY_INTER_OPEN, TOPSPACE_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY_SUBSET, .. } := BSubtopology
  let { OPEN_IN_TOPOLOGY_BASE_UNIQUE, .. } := BBases
  let { CLOSURE_OF_SUBSET_TOPSPACE, CLOSURE_OF_SUBTOPOLOGY, DISCRETE_TOPOLOGY_CLOSURE_OF,
        OPEN_IN_INTER_CLOSURE_OF_EQ, closure_of, .. } := BClosure
  let { CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET, OPEN_IN_CONTINUOUS_MAP_PREIMAGE,
        .. } := BContMap1
  let { open_map, .. } := BOpenClosed1
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, .. } := BQuotient
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_MAPS_MAP, .. } := BHomeo1
  let { homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP,
        .. } := BRetraction
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { lindelof_space, .. } := BLindelof
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let second_countable ← new_definition
   r"second_countable (top:A topology) <=>
         ?b. COUNTABLE b /\
             (!v. v IN b ==> open_in top v) /\
             (!u x. open_in top u /\ x IN u
                    ==> ?v. v IN b /\ x IN v /\ v SUBSET u)"

  let first_countable ← new_definition
   r"first_countable (top:A topology) <=>
        !x. x IN topspace top
            ==> ?b. COUNTABLE b /\
                    (!v. v IN b ==> open_in top v) /\
                    (!u. open_in top u /\ x IN u
                         ==> ?v. v IN b /\ x IN v /\ v SUBSET u)"

  let separable_space ← new_definition
   r"separable_space (top:A topology) <=>
        ?c. COUNTABLE c /\
            c SUBSET topspace top /\
            top closure_of c = topspace top"

  let SECOND_COUNTABLE ← prove
   r"!top:A topology.
        second_countable top <=>
        ?b. COUNTABLE b /\ open_in top = ARBITRARY UNION_OF b"
   (REWRITE_TAC [OPEN_IN_TOPOLOGY_BASE_UNIQUE, second_countable])

  let SECOND_COUNTABLE_SUBTOPOLOGY ← prove
   r"!top (s:A->bool).
        second_countable top ==> second_countable(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [second_countable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:(A->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (\b:A->bool. s INTER b) B") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    ASM_SIMP_TAC [OPEN_IN_SUBTOPOLOGY_INTER_OPEN] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, FORALL_IN_GSPEC] THEN
    ASM SET_TAC [])

  let SECOND_COUNTABLE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. second_countable(discrete_topology u) <=> COUNTABLE u"
   (GEN_TAC THEN REWRITE_TAC [second_countable] THEN EQ_TAC THENL
     [DISCH_THEN (X_CHOOSE_THEN (← q r"b:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← REWRITE_RULE [IMP_CONJ]
          CARD_LE_COUNTABLE)) THEN
      REWRITE_TAC [le_c] THEN EXISTS_TAC (← q r"\x:A. {x}") THEN
      SIMP_TAC [← sr r"{x} = {y} <=> x = y"] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"{x:A}", ← q r"x:A"]) THEN
      ASM_REWRITE_TAC [IN_SING, OPEN_IN_DISCRETE_TOPOLOGY, SING_SUBSET] THEN
      REWRITE_TAC [← sr r"x IN s /\ s SUBSET {x} <=> s = {x}"] THEN
      MESON_TAC [],
      DISCH_TAC THEN EXISTS_TAC (← q r"IMAGE (\x:A. {x}) u") THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, SING_SUBSET] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE] THEN SET_TAC []])

  let SECOND_COUNTABLE_OPEN_MAP_IMAGE ← prove
   r"!(f:A->B) top top'.
        continuous_map(top,top') f /\ open_map(top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        second_countable top
        ==> second_countable top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [second_countable, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:(A->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (IMAGE (f:A->B)) B") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:B->bool", ← q r"y:B"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?x. x IN topspace top /\ (f:A->B) x = y") STRIP_ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
      ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{x | x IN topspace top /\ (f:A->B) x IN v}", ← q r"x:A"]) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  let HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (second_countable top <=> second_countable top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN
    MESON_TAC [SECOND_COUNTABLE_OPEN_MAP_IMAGE])

  let SECOND_COUNTABLE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ second_countable top
        ==> second_countable top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [SECOND_COUNTABLE_SUBTOPOLOGY,
                 HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY])

  let SECOND_COUNTABLE_IMP_FIRST_COUNTABLE ← prove
   r"!top:A topology. second_countable top ==> first_countable top"
   (GEN_TAC THEN REWRITE_TAC [second_countable, first_countable] THEN
    DISCH_THEN (fun th => REPEAT STRIP_TAC THEN MP_TAC th) THEN
    MATCH_MP_TAC MONO_EXISTS THEN MESON_TAC [])

  let FIRST_COUNTABLE_SUBTOPOLOGY ← prove
   r"!top s:A->bool. first_countable top ==> first_countable(subtopology top s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [first_countable] THEN DISCH_TAC THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY_ALT, TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    REWRITE_TAC [← GSYM SUBSET, IMP_CONJ, FORALL_IN_GSPEC] THEN
    ONCE_REWRITE_TAC [SIMPLE_IMAGE_GEN] THEN
    REWRITE_TAC [EXISTS_COUNTABLE_SUBSET_IMAGE, EXISTS_IN_IMAGE] THEN
    X_GEN_TAC (← q r"x:A") THEN REPEAT DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC [])

  let FIRST_COUNTABLE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. first_countable(discrete_topology u)"
   (GEN_TAC THEN REWRITE_TAC [first_countable] THEN
    REWRITE_TAC [OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"{{x:A}}") THEN
    REWRITE_TAC [COUNTABLE_SING, FORALL_IN_INSERT, EXISTS_IN_INSERT] THEN
    ASM_SIMP_TAC [IN_SING, SING_SUBSET, NOT_IN_EMPTY])

  let FIRST_COUNTABLE_OPEN_MAP_IMAGE ← prove
   r"!(f:A->B) top top'.
        continuous_map(top,top') f /\ open_map(top,top') f /\
        IMAGE f (topspace top) = topspace top' /\
        first_countable top
        ==> first_countable top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [open_map] THEN
    REPEAT (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [first_countable] THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"?x. x IN topspace top /\ (f:A->B) x = y") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"B:(A->bool)->bool") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (IMAGE (f:A->B)) B") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, EXISTS_IN_IMAGE] THEN
    X_GEN_TAC (← q r"v:B->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC
      (← q r"{x | x IN topspace top /\ (f:A->B) x IN v}")) THEN
    ASM_REWRITE_TAC [IN_ELIM_THM] THEN ANTS_TAC THENL
     [MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN ASM_MESON_TAC [],
      MATCH_MP_TAC MONO_EXISTS THEN ASM SET_TAC []])

  let HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (first_countable top <=> first_countable top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [HOMEOMORPHIC_EQ_EVERYTHING_MAP] THEN
    MESON_TAC [FIRST_COUNTABLE_OPEN_MAP_IMAGE])

  let FIRST_COUNTABLE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ first_countable top
        ==> first_countable top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [FIRST_COUNTABLE_SUBTOPOLOGY,
                 HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY])

  let SEPARABLE_SPACE_OPEN_SUBSET ← prove
   r"!top s:A->bool.
        separable_space top /\ open_in top s
        ==> separable_space(subtopology top s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [IMP_CONJ, separable_space, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"b:A->bool") THEN REPEAT STRIP_TAC THEN
    EXISTS_TAC (← q r"s INTER b:A->bool") THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY_SUBSET, OPEN_IN_SUBSET] THEN
    ASM_SIMP_TAC [COUNTABLE_INTER, INTER_SUBSET] THEN
    REWRITE_TAC [CLOSURE_OF_SUBTOPOLOGY] THEN
    REWRITE_TAC [← sr r"s INTER s INTER b = s INTER b"] THEN
    ASM_SIMP_TAC [← GSYM OPEN_IN_INTER_CLOSURE_OF_EQ] THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [])

  let SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' f:A->B.
        separable_space top /\
        continuous_map (top,top') f /\ IMAGE f (topspace top) = topspace top'
        ==> separable_space top'"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONTINUOUS_MAP_EQ_IMAGE_CLOSURE_SUBSET] THEN
    REWRITE_TAC [IMP_CONJ, separable_space, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:A->bool") THEN REPEAT DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (f:A->B) c") THEN ASM_SIMP_TAC [COUNTABLE_IMAGE] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM SUBSET_ANTISYM_EQ, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"c:A->bool")) THEN
    ASM_REWRITE_TAC [])

  let SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ separable_space top
        ==> separable_space top'"
   (MESON_TAC [QUOTIENT_IMP_SURJECTIVE_MAP, QUOTIENT_IMP_CONTINUOUS_MAP,
               SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE])

  let SEPARABLE_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ separable_space top
        ==> separable_space top'"
   (MESON_TAC [SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let HOMEOMORPHIC_SEPARABLE_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (separable_space top <=> separable_space top')"
   (REWRITE_TAC [homeomorphic_space, HOMEOMORPHIC_MAPS_MAP] THEN
    REWRITE_TAC [← GSYM SECTION_AND_RETRACTION_EQ_HOMEOMORPHIC_MAP] THEN
    MESON_TAC [SEPARABLE_SPACE_RETRACTION_MAP_IMAGE])

  let SEPARABLE_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. separable_space(discrete_topology u) <=> COUNTABLE u"
   (REWRITE_TAC [separable_space, DISCRETE_TOPOLOGY_CLOSURE_OF] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [← sr r"s SUBSET u /\ u INTER s = u <=> s = u"] THEN
    MESON_TAC [])

  let SECOND_COUNTABLE_IMP_SEPARABLE_SPACE ← prove
   r"!top:A topology. second_countable top ==> separable_space top"
   (GEN_TAC THEN REWRITE_TAC [second_countable, separable_space] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    MP_TAC (← sr r"!v. ?x:A. v IN B /\ ~(v = {}) ==> x IN v") THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"c:(A->bool)->A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"IMAGE (c:(A->bool)->A) (B DELETE {})") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_DELETE, SUBSET] THEN
    REWRITE_TAC [FORALL_IN_IMAGE, ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [CLOSURE_OF_SUBSET_TOPSPACE, IN_DELETE] THEN CONJ_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
    REWRITE_TAC [closure_of, SUBSET, IN_ELIM_THM] THEN X_GEN_TAC (← q r"x:A") THEN
    DISCH_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN REWRITE_TAC [EXISTS_IN_IMAGE] THEN
    REWRITE_TAC [IN_DELETE, EXTENSION, NOT_IN_EMPTY] THEN ASM SET_TAC [])

  let SECOND_COUNTABLE_IMP_LINDELOF_SPACE ← prove
   r"!top:A topology. second_countable top ==> lindelof_space top"
   (GEN_TAC THEN REWRITE_TAC [second_countable, lindelof_space] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"U:(A->bool)->bool") THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"B' = {b:A->bool | b IN B /\ ?u. u IN U /\ b SUBSET u}") THEN
    SUBGOAL_THEN
     (← q r"COUNTABLE B' /\ UNIONS B' :A->bool = UNIONS U")
    STRIP_ASSUME_TAC THENL
     [EXPAND_TAC "B'" THEN ASM_SIMP_TAC [COUNTABLE_RESTRICT] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!b:A->bool. ?u. b IN B' ==> u IN U /\ b SUBSET u")
    MP_TAC THENL [EXPAND_TAC "B'" THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:(A->bool)->(A->bool)") THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"IMAGE (g:(A->bool)->(A->bool)) B'") THEN
    ASM_SIMP_TAC [COUNTABLE_IMAGE, UNIONS_IMAGE] THEN
    REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  return { second_countable, first_countable, separable_space, SECOND_COUNTABLE,
           SECOND_COUNTABLE_SUBTOPOLOGY, SECOND_COUNTABLE_DISCRETE_TOPOLOGY,
           SECOND_COUNTABLE_OPEN_MAP_IMAGE, HOMEOMORPHIC_SPACE_SECOND_COUNTABILITY,
           SECOND_COUNTABLE_RETRACTION_MAP_IMAGE, SECOND_COUNTABLE_IMP_FIRST_COUNTABLE,
           FIRST_COUNTABLE_SUBTOPOLOGY, FIRST_COUNTABLE_DISCRETE_TOPOLOGY,
           FIRST_COUNTABLE_OPEN_MAP_IMAGE, HOMEOMORPHIC_SPACE_FIRST_COUNTABILITY,
           FIRST_COUNTABLE_RETRACTION_MAP_IMAGE, SEPARABLE_SPACE_OPEN_SUBSET,
           SEPARABLE_SPACE_CONTINUOUS_MAP_IMAGE, SEPARABLE_SPACE_QUOTIENT_MAP_IMAGE,
           SEPARABLE_SPACE_RETRACTION_MAP_IMAGE, HOMEOMORPHIC_SEPARABLE_SPACE,
           SEPARABLE_SPACE_DISCRETE_TOPOLOGY, SECOND_COUNTABLE_IMP_SEPARABLE_SPACE,
           SECOND_COUNTABLE_IMP_LINDELOF_SPACE }

/- ------------------------------------------------------------------------- -/
/- A variant of nets; the "within" modifier; "eventually".                   -/
/- (metric.ml 10880-11086)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Nets where
  net_tybij : thm
  netfilter : thm
  netlimits : thm
  netlimit : thm
  NET : thm
  within : thm
  WITHIN : thm
  NETLIMITS_WITHIN : thm
  NET_WITHIN_UNIV : thm
  WITHIN_WITHIN : thm
  eventually : thm
  trivial_limit : thm
  EVENTUALLY_WITHIN_IMP : thm
  EVENTUALLY_IMP_WITHIN : thm
  EVENTUALLY_WITHIN_INTER_IMP : thm
  NONTRIVIAL_LIMIT_WITHIN : thm
  EVENTUALLY_HAPPENS : thm
  ALWAYS_EVENTUALLY : thm
  EVENTUALLY_MONO : thm
  EVENTUALLY_AND : thm
  EVENTUALLY_MP : thm
  EVENTUALLY_EQ_MP : thm
  EVENTUALLY_IFF : thm
  EVENTUALLY_FALSE : thm
  EVENTUALLY_TRUE : thm
  EVENTUALLY_WITHIN_SUBSET : thm
  ALWAYS_WITHIN_EVENTUALLY : thm
  NOT_EVENTUALLY : thm
  EVENTUALLY_FORALL : thm
  FORALL_EVENTUALLY : thm
  EVENTUALLY_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupNets [HolBase] (D : MetricDeps) : ExceptT String IO Nets := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_TAC, INTRO_TAC, new_definition, new_type_definition,
        parse_as_infix, .. } := D
  let { AND_FORALL_THM, ETA_AX, EXISTS_IN_GSPEC, FINITE_INDUCT_STRONG, FORALL_IN_GSPEC,
        FORALL_IN_INSERT, FUN_EQ_THM, .. } := D.core1
  let { IMP_CONJ, IN, INTERS_GSPEC, IN_ELIM_THM, IN_INTER, IN_UNIV, NOT_IN_EMPTY,
        .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, .. } := D.core4
  let { EQ_SYM_EQ, EXISTS_PAIR_THM, PAIR, PAIR_EQ, .. } := D.core5
  let { RELATIVE_TO, RELATIVE_TO_RELATIVE_TO, RELATIVE_TO_UNIV, .. } := D.misc
  -- @@SCOPE END

  let net_tybij ← new_type_definition "net" ("mk_net", "dest_net")
   (← prove
     r"?g:((A->bool)->bool)#(A->bool).
        !s t. s IN FST g /\ t IN FST g ==> (s INTER t) IN FST g"
     (REWRITE_TAC [EXISTS_PAIR_THM] THEN EXISTS_TAC (← q r"(:A->bool)") THEN
      REWRITE_TAC [IN_UNIV]))

  let netfilter ← new_definition
   r"netfilter(n:A net) = FST(dest_net n)"

  let netlimits ← new_definition
   r"netlimits(n:A net) = SND(dest_net n)"

  let netlimit ← new_definition
   r"netlimit(n:A net) = @x. x IN netlimits n"

  let NET ← prove
   r"!n s t. !s t. s IN netfilter n /\ t IN netfilter n
                 ==> (s INTER t) IN netfilter n"
   (REWRITE_TAC [netfilter] THEN MESON_TAC [net_tybij])

  parse_as_infix ("within", (14, "right"))

  let within ← new_definition
    r"net within s = mk_net (netfilter net relative_to s,netlimits net)"

  let (WITHIN, NETLIMITS_WITHIN) ← CONJ_PAIR (← prove
   r"(!n s:A->bool. netfilter(n within s) = netfilter n relative_to s) /\
   (!n s:A->bool. netlimits(n within s) = netlimits n)"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [netfilter, netlimits, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [within] THEN
    W (MP_TAC o PART_MATCH (lhand o lhand) (← GSYM (← CONJUNCT2 net_tybij)) o
     lhand o snd) THEN
    MATCH_MP_TAC (← TAUT (← q r"q /\ (p ==> r) ==> (p <=> q) ==> r")) THEN
    SIMP_TAC [← GSYM netfilter, ← GSYM netlimits, RELATIVE_TO] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN
    X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
    REWRITE_TAC [RELATIVE_TO, IN_ELIM_THM] THEN
    EXISTS_TAC (← q r"t INTER u:A->bool") THEN
    ASM_SIMP_TAC [← REWRITE_RULE [IN] NET] THEN SET_TAC []))

  let NET_WITHIN_UNIV ← prove
   r"!net. net within (:A) = net"
   (GEN_TAC THEN MATCH_MP_TAC (← MESON [net_tybij] (← q
     r"dest_net x = dest_net y ==> x = y")) THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM PAIR] THEN
    PURE_REWRITE_TAC [← GSYM netlimits, ← GSYM netfilter] THEN
    REWRITE_TAC [WITHIN, NETLIMITS_WITHIN] THEN
    REWRITE_TAC [PAIR_EQ, FUN_EQ_THM, RELATIVE_TO_UNIV])

  let WITHIN_WITHIN ← prove
   r"!net s t. (net within s) within t = net within (s INTER t)"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC (← MESON [net_tybij] (← q
     r"dest_net x = dest_net y ==> x = y")) THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM PAIR] THEN
    PURE_REWRITE_TAC [← GSYM netlimits, ← GSYM netfilter] THEN
    REWRITE_TAC [WITHIN, NETLIMITS_WITHIN, PAIR_EQ] THEN
    REWRITE_TAC [RELATIVE_TO_RELATIVE_TO])

  let eventually ← new_definition
   r"eventually (P:A->bool) net <=>
        netfilter net = {} \/
        ?u. u IN netfilter net /\
            !x. x IN u DIFF netlimits net ==> P x"

  let trivial_limit ← new_definition
    r"trivial_limit net <=> eventually (\x. F) net"

  let EVENTUALLY_WITHIN_IMP ← prove
   r"!net (P:A->bool) s.
        eventually P (net within s) <=>
        eventually (\x. x IN s ==> P x) net"
   (REWRITE_TAC [eventually, WITHIN, RELATIVE_TO, EXISTS_IN_GSPEC] THEN
    REWRITE_TAC [INTERS_GSPEC, NETLIMITS_WITHIN] THEN SET_TAC [])

  let EVENTUALLY_IMP_WITHIN ← prove
   r"!net (P:A->bool) s.
        eventually P net ==> eventually P (net within s)"
   (REWRITE_TAC [EVENTUALLY_WITHIN_IMP] THEN REWRITE_TAC [eventually] THEN
    MESON_TAC [])

  let EVENTUALLY_WITHIN_INTER_IMP ← prove
   r"!net (P:A->bool) s t.
        eventually P (net within s INTER t) <=>
        eventually (\x. x IN t ==> P x) (net within s)"
   (REWRITE_TAC [← GSYM WITHIN_WITHIN] THEN
    REWRITE_TAC [EVENTUALLY_WITHIN_IMP])

  let NONTRIVIAL_LIMIT_WITHIN ← prove
   r"!net s. trivial_limit net ==> trivial_limit(net within s)"
   (REWRITE_TAC [trivial_limit, EVENTUALLY_IMP_WITHIN])

  let EVENTUALLY_HAPPENS ← prove
   r"!net p. eventually p net ==> trivial_limit net \/ ?x. p x"
   (REWRITE_TAC [trivial_limit, eventually] THEN SET_TAC [])

  let ALWAYS_EVENTUALLY ← prove
   r"(!x. p x) ==> eventually p net"
   (SIMP_TAC [eventually] THEN SET_TAC [])

  let EVENTUALLY_MONO ← prove
   r"!net:(A net) p q.
        (!x. p x ==> q x) /\ eventually p net
        ==> eventually q net"
   (REWRITE_TAC [eventually] THEN MESON_TAC [])

  let EVENTUALLY_AND ← prove
   r"!net:(A net) p q.
        eventually (\x. p x /\ q x) net <=>
        eventually p net /\ eventually q net"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
      SIMP_TAC [],
      REWRITE_TAC [eventually] THEN
      ASM_CASES_TAC (← q r"netfilter(net:A net) = {}") THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (CONJUNCTS_THEN2
       (X_CHOOSE_THEN (← q r"u:A->bool") STRIP_ASSUME_TAC)
       (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC)) THEN
      EXISTS_TAC (← q r"u INTER v:A->bool") THEN
      ASM_SIMP_TAC [IN_INTER, NET] THEN ASM SET_TAC []])

  let EVENTUALLY_MP ← prove
   r"!net:(A net) p q.
        eventually (\x. p x ==> q x) net /\ eventually p net
        ==> eventually q net"
   (REWRITE_TAC [← GSYM EVENTUALLY_AND] THEN
    REWRITE_TAC [eventually] THEN MESON_TAC [])

  let EVENTUALLY_EQ_MP ← prove
   r"!net P Q. eventually (\x:A. P x <=> Q x) net /\ eventually P net
             ==> eventually Q net"
   (INTRO_TAC "!net P Q; PQ P" THEN REMOVE_THEN "P" MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    POP_ASSUM MP_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MP) THEN
    MATCH_MP_TAC ALWAYS_EVENTUALLY THEN SIMP_TAC [])

  let EVENTUALLY_IFF ← prove
   r"!net P Q. eventually (\x:A. P x <=> Q x) net
             ==> (eventually P net <=> eventually Q net)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    (MATCH_MP_TAC o REWRITE_RULE [IMP_CONJ]) EVENTUALLY_EQ_MP THEN
    ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [EQ_SYM_EQ] THEN
    ASM_REWRITE_TAC [])

  let EVENTUALLY_FALSE ← prove
   r"!net. eventually (\x. F) net <=> trivial_limit net"
   (REWRITE_TAC [trivial_limit])

  let EVENTUALLY_TRUE ← prove
   r"!net. eventually (\x. T) net <=> T"
   (REWRITE_TAC [eventually] THEN SET_TAC [])

  let EVENTUALLY_WITHIN_SUBSET ← prove
   r"!P net s t:A->bool.
    eventually P (net within s) /\ t SUBSET s ==> eventually P (net within t)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [EVENTUALLY_WITHIN_IMP] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC ASSUME_TAC) THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN ASM SET_TAC [])

  let ALWAYS_WITHIN_EVENTUALLY ← prove
   r"!net P. (!x. x IN s ==> P x) ==> eventually P (net within s)"
   (SIMP_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_TRUE])

  let NOT_EVENTUALLY ← prove
   r"!net p. (!x. ~(p x)) /\ ~(trivial_limit net) ==> ~(eventually p net)"
   (REWRITE_TAC [eventually, trivial_limit] THEN MESON_TAC [])

  let EVENTUALLY_FORALL ← prove
   r"!net:(A net) p s:B->bool.
        FINITE s /\ ~(s = {})
        ==> (eventually (\x. !a. a IN s ==> p a x) net <=>
             !a. a IN s ==> eventually (p a) net)"
   (GEN_TAC THEN GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, EVENTUALLY_AND, ETA_AX] THEN
    MAP_EVERY X_GEN_TAC [← q r"b:B", ← q r"t:B->bool"] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN
    ASM_SIMP_TAC [NOT_IN_EMPTY, EVENTUALLY_TRUE])

  let FORALL_EVENTUALLY ← prove
   r"!net:(A net) p s:B->bool.
        FINITE s /\ ~(s = {})
        ==> ((!a. a IN s ==> eventually (p a) net) <=>
             eventually (\x. !a. a IN s ==> p a x) net)"
   (SIMP_TAC [EVENTUALLY_FORALL])

  let EVENTUALLY_TRIVIAL ← prove
   r"!net P:A->bool. trivial_limit net ==> eventually P net"
   (REPEAT GEN_TAC THEN REWRITE_TAC [trivial_limit] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO) THEN
    REWRITE_TAC [])

  return { net_tybij, netfilter, netlimits, netlimit, NET, within, WITHIN, NETLIMITS_WITHIN,
           NET_WITHIN_UNIV, WITHIN_WITHIN, eventually, trivial_limit, EVENTUALLY_WITHIN_IMP,
           EVENTUALLY_IMP_WITHIN, EVENTUALLY_WITHIN_INTER_IMP, NONTRIVIAL_LIMIT_WITHIN,
           EVENTUALLY_HAPPENS, ALWAYS_EVENTUALLY, EVENTUALLY_MONO, EVENTUALLY_AND,
           EVENTUALLY_MP, EVENTUALLY_EQ_MP, EVENTUALLY_IFF, EVENTUALLY_FALSE, EVENTUALLY_TRUE,
           EVENTUALLY_WITHIN_SUBSET, ALWAYS_WITHIN_EVENTUALLY, NOT_EVENTUALLY,
           EVENTUALLY_FORALL, FORALL_EVENTUALLY, EVENTUALLY_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Sequential limits.  (metric.ml 11088-11301)                               -/
/- ------------------------------------------------------------------------- -/

structure Sequential where
  sequentially : thm
  SEQUENTIALLY : thm
  NETLIMITS_SEQUENTIALLY : thm
  EVENTUALLY_SEQUENTIALLY : thm
  TRIVIAL_LIMIT_SEQUENTIALLY : thm
  EVENTUALLY_HAPPENS_SEQUENTIALLY : thm
  EVENTUALLY_SEQUENTIALLY_WITHIN : thm
  TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN : thm
  EVENTUALLY_SUBSEQUENCE : thm
  ARCH_EVENTUALLY_LT : thm
  ARCH_EVENTUALLY_LE : thm
  ARCH_EVENTUALLY_ABS_INV_OFFSET : thm
  ARCH_EVENTUALLY_INV_OFFSET : thm
  ARCH_EVENTUALLY_INV1 : thm
  ARCH_EVENTUALLY_INV : thm
  ARCH_EVENTUALLY_POW : thm
  ARCH_EVENTUALLY_POW_INV : thm
  EVENTUALLY_IN_SEQUENTIALLY : thm
  EVENTUALLY_NO_SUBSEQUENCE : thm
  EVENTUALLY_UBOUND_LE_SEQUENTIALLY : thm
  EVENTUALLY_LBOUND_LE_SEQUENTIALLY : thm
  deriving Inhabited

@[nospecialize]
def setupSequential [HolBase] (D : MetricDeps) (BTactics : Tactics) (BNets : Nets) :
    ExceptT String IO Sequential := do
  -- @@SCOPE BEGIN
  let { ARITH_RULE, ARITH_TAC, ASM_ARITH_TAC, ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC,
        REAL_ARITH_TAC, SET_RULE, INTRO_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, EXISTS_IN_IMAGE, EXTENSION, FINITE_IMAGE, FORALL_IN_GSPEC,
        IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, IMP_IMP, INFINITE, INTERS_IMAGE, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNIV,
        LEFT_IMP_EXISTS_THM, LE_0, LE_1, LE_REFL, LE_TRANS, LT_IMP_LE, MEMBER_NOT_EMPTY,
        MONO_EXISTS, NOT_FORALL_THM, NOT_IN_EMPTY, NOT_LE, REAL_ABS_INV, REAL_ABS_NUM,
        .. } := D.core2
  let { REAL_ABS_POW, REAL_ADD_RID, REAL_ARCH_POW, REAL_ARCH_SIMPLE, REAL_INF_LE_FINITE,
        REAL_INV_1_LT, REAL_INV_INV, REAL_LET_TRANS, REAL_LE_INV2, REAL_LE_INV_EQ, REAL_LE_MAX,
        REAL_LE_REFL, REAL_LE_SUP_FINITE, REAL_LTE_TRANS, REAL_LT_IMP_LE, REAL_LT_INV,
        REAL_LT_INV2, REAL_LT_INV_EQ, REAL_MAX_LT, REAL_MIN_LE, REAL_OF_NUM_LE, REAL_OF_NUM_LT,
        REAL_POW_INV, REAL_POW_MONO, .. } := D.core3
  let { REAL_POW_ZERO, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, UNIV_NOT_EMPTY, num_FINITE,
        num_INFINITE_EQ, o_THM, .. } := D.core4
  let { CONTRAPOS_THM, NOT_EXISTS_THM, PAIR_EQ, .. } := D.core5
  let { INFINITE_ENUMERATE_EQ_ALT, IN_FROM, MONOTONE_BIGGER, .. } := D.misc
  let { CLAIM_TAC, .. } := BTactics
  let { EVENTUALLY_AND, EVENTUALLY_HAPPENS, EVENTUALLY_MONO, EVENTUALLY_WITHIN_IMP, eventually,
        net_tybij, netfilter, netlimits, trivial_limit, .. } := BNets
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let sequentially ← new_definition
    r"sequentially = mk_net({from n | n IN (:num)},{})"

  let (SEQUENTIALLY, NETLIMITS_SEQUENTIALLY) ← CONJ_PAIR (← prove
   r"(!n. netfilter sequentially = {from n | n IN (:num)}) /\
   (netlimits sequentially = {})"
   (REWRITE_TAC [AND_FORALL_THM] THEN REPEAT GEN_TAC THEN
    REWRITE_TAC [netfilter, netlimits, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [sequentially] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 net_tybij)] THEN
    REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_GSPEC, IN_UNIV] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:num", ← q r"n:num"] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"MAX m n") THEN
    REWRITE_TAC [EXTENSION, IN_INTER, IN_FROM] THEN ARITH_TAC))

  let EVENTUALLY_SEQUENTIALLY ← prove
   r"!p. eventually p sequentially <=> ?N. !n. N <= n ==> p n"
   (REWRITE_TAC [eventually, SEQUENTIALLY, NETLIMITS_SEQUENTIALLY] THEN
    SIMP_TAC [SIMPLE_IMAGE, EXISTS_IN_IMAGE, IMAGE_EQ_EMPTY, UNIV_NOT_EMPTY] THEN
    REWRITE_TAC [IN_UNIV, INTERS_IMAGE, IN_FROM, IN_ELIM_THM, IN_DIFF,
                 NOT_IN_EMPTY] THEN
    MESON_TAC [← ARITH_RULE (← q r"~(SUC n <= n)")])

  let TRIVIAL_LIMIT_SEQUENTIALLY ← prove
   r"~(trivial_limit sequentially)"
   (REWRITE_TAC [trivial_limit, EVENTUALLY_SEQUENTIALLY] THEN
    MESON_TAC [LE_REFL])

  let EVENTUALLY_HAPPENS_SEQUENTIALLY ← prove
   r"!P. eventually P sequentially ==> ?n. P n"
   (MESON_TAC [EVENTUALLY_HAPPENS, TRIVIAL_LIMIT_SEQUENTIALLY])

  let EVENTUALLY_SEQUENTIALLY_WITHIN ← prove
   r"!k p. eventually p (sequentially within k) <=>
         FINITE k \/ (?N. !n. n IN k /\ N <= n ==> p n)"
   (GEN_TAC THEN GEN_TAC THEN
    REWRITE_TAC [EVENTUALLY_WITHIN_IMP, EVENTUALLY_SEQUENTIALLY] THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THEN ASM_REWRITE_TAC [] THENL
    [POP_ASSUM (STRIP_ASSUME_TAC o REWRITE_RULE [num_FINITE]) THEN
     EXISTS_TAC (← q r"a + 1") THEN
     REWRITE_TAC [← ARITH_RULE (← q r"a + 1 <= n <=> a < n")] THEN
     ASM_MESON_TAC [NOT_LE],
     POP_ASSUM MP_TAC THEN
     REWRITE_TAC [← GSYM INFINITE, num_INFINITE_EQ] THEN
     MESON_TAC []])

  let TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN ← prove
   r"!k. trivial_limit (sequentially within k) <=> FINITE k"
   (GEN_TAC THEN REWRITE_TAC [trivial_limit] THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY_WITHIN] THEN
    ASM_CASES_TAC (← q r"FINITE (k:num->bool)") THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [NOT_EXISTS_THM, NOT_FORALL_THM] THEN GEN_TAC THEN
    POP_ASSUM (MP_TAC o REWRITE_RULE [← GSYM INFINITE, num_INFINITE_EQ]) THEN
    MESON_TAC [])

  let EVENTUALLY_SUBSEQUENCE ← prove
   r"!P r. (!m n. m < n ==> r m < r n) /\ eventually P sequentially
         ==> eventually (P o r) sequentially"
   (REWRITE_TAC [EVENTUALLY_SEQUENTIALLY, o_THM] THEN
    MESON_TAC [MONOTONE_BIGGER, LE_TRANS])

  let ARCH_EVENTUALLY_LT ← prove
   r"!x. eventually (\n. x < &n) sequentially"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"x + &1") REAL_ARCH_SIMPLE) THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN REAL_ARITH_TAC)

  let ARCH_EVENTUALLY_LE ← prove
   r"!x. eventually (\n. x <= &n) sequentially"
   (GEN_TAC THEN MP_TAC (← ISPEC (← q r"x:real") REAL_ARCH_SIMPLE) THEN
    REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN MATCH_MP_TAC MONO_EXISTS THEN
    REWRITE_TAC [← GSYM REAL_OF_NUM_LE] THEN REAL_ARITH_TAC)

  let ARCH_EVENTUALLY_ABS_INV_OFFSET ← prove
   r"!a e. eventually (\n. abs(inv(&n + a)) < e) sequentially <=> &0 < e"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY] THEN REAL_ARITH_TAC,
      DISCH_TAC THEN MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"\n. max (&0) (max (&2 * abs a) (&2 / e)) < &n") THEN
      REWRITE_TAC [ARCH_EVENTUALLY_LT] THEN X_GEN_TAC (← q r"n:num") THEN
      REWRITE_TAC [REAL_MAX_LT, REAL_OF_NUM_LT] THEN STRIP_TAC THEN
      TRANS_TAC REAL_LET_TRANS (← q r"inv(&n / &2)") THEN
      REWRITE_TAC [REAL_ABS_INV] THEN CONJ_TAC THENL
       [MATCH_MP_TAC REAL_LE_INV2 THEN ASM_REAL_ARITH_TAC,
        GEN_REWRITE_TAC RAND_CONV [← GSYM REAL_INV_INV] THEN
        MATCH_MP_TAC REAL_LT_INV2 THEN
        ASM_REWRITE_TAC [REAL_LT_INV_EQ] THEN ASM_REAL_ARITH_TAC]])

  let ARCH_EVENTUALLY_INV_OFFSET ← prove
   r"!a e. eventually (\n. inv (&n + a) < e) sequentially <=> &0 < e"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MP_TAC (← ISPEC (← q r"abs a") ARCH_EVENTUALLY_LT) THEN
      REWRITE_TAC [IMP_IMP, ← GSYM EVENTUALLY_AND] THEN
      DISCH_THEN (MP_TAC o MATCH_MP EVENTUALLY_HAPPENS) THEN
      REWRITE_TAC [TRIVIAL_LIMIT_SEQUENTIALLY, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"n:num") THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] REAL_LET_TRANS) THEN
      REWRITE_TAC [REAL_LE_INV_EQ] THEN ASM_REAL_ARITH_TAC,
      DISCH_TAC THEN MATCH_MP_TAC EVENTUALLY_MONO THEN
      EXISTS_TAC (← q r"\n. abs(inv(&n + a)) < e") THEN
      ASM_SIMP_TAC [ARCH_EVENTUALLY_ABS_INV_OFFSET] THEN REAL_ARITH_TAC])

  let ARCH_EVENTUALLY_INV1 ← prove
   r"!e. eventually (\n. inv(&n + &1) < e) sequentially <=> &0 < e"
   (MP_TAC (← SPEC (← q r"&1") ARCH_EVENTUALLY_INV_OFFSET) THEN REWRITE_TAC [])

  let ARCH_EVENTUALLY_INV ← prove
   r"!e. eventually (\n. inv(&n) < e) sequentially <=> &0 < e"
   (MP_TAC (← SPEC (← q r"&0") ARCH_EVENTUALLY_INV_OFFSET) THEN
    REWRITE_TAC [REAL_ADD_RID])

  let ARCH_EVENTUALLY_POW ← prove
   r"!x b. &1 < x ==> eventually (\n. b < x pow n) sequentially"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"b:real") o MATCH_MP REAL_ARCH_POW) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"N:num") THEN
    DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN DISCH_TAC THEN
    TRANS_TAC REAL_LTE_TRANS (← q r"(x:real) pow N") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC REAL_POW_MONO THEN
    ASM_SIMP_TAC [REAL_LT_IMP_LE])

  let ARCH_EVENTUALLY_POW_INV ← prove
   r"!x e. &0 < e /\ abs(x) < &1
         ==> eventually (\n. abs(x pow n) < e) sequentially"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"x = &0") THENL
     [REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THEN EXISTS_TAC (← q r"1") THEN
      ASM_SIMP_TAC [REAL_POW_ZERO, LE_1, REAL_ABS_NUM],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"inv(abs x)", ← q r"inv e:real"] ARCH_EVENTUALLY_POW) THEN
    ANTS_TAC THENL
     [MATCH_MP_TAC REAL_INV_1_LT THEN ASM_REAL_ARITH_TAC,
      MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ] EVENTUALLY_MONO)] THEN
    X_GEN_TAC (← q r"n:num") THEN REWRITE_TAC [REAL_ABS_POW] THEN DISCH_TAC THEN
    GEN_REWRITE_TAC BINOP_CONV [← GSYM REAL_INV_INV] THEN
    ASM_SIMP_TAC [← GSYM REAL_POW_INV, REAL_LT_INV, REAL_LT_INV2])

  let EVENTUALLY_IN_SEQUENTIALLY ← prove
   r"!P. eventually P sequentially <=> FINITE {n | ~P n}"
   (GEN_TAC THEN
    REWRITE_TAC [num_FINITE, EVENTUALLY_SEQUENTIALLY, IN_ELIM_THM] THEN
    GEN_REWRITE_TAC (RAND_CONV o ONCE_DEPTH_CONV) [← GSYM CONTRAPOS_THM] THEN
    REWRITE_TAC [NOT_LE] THEN
    MESON_TAC [LT_IMP_LE, ← ARITH_RULE (← q r"a + 1 <= x ==> a < x")])

  let EVENTUALLY_NO_SUBSEQUENCE ← prove
   r"!P. eventually P sequentially <=>
       ~(?r:num->num. (!m n. m < n ==> r m < r n) /\ (!n. ~P(r n)))"
   (GEN_TAC THEN REWRITE_TAC [EVENTUALLY_IN_SEQUENTIALLY] THEN
    ONCE_REWRITE_TAC [← TAUT (← q r"(p <=> ~q) <=> (~p <=> q)")] THEN
    REWRITE_TAC [← GSYM INFINITE, INFINITE_ENUMERATE_EQ_ALT] THEN
    REWRITE_TAC [IN_ELIM_THM])

  let EVENTUALLY_UBOUND_LE_SEQUENTIALLY ← prove
   r"!f. (?b. eventually (\n. f n <= b) sequentially) <=> (?b. !n. f n <= b)"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THENL
    [ALL_TAC,
     INTRO_TAC "@b. b" THEN EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC []] THEN
    INTRO_TAC "@b N. b" THEN ASM_CASES_TAC (← q r"N = 0") THENL
    [POP_ASSUM SUBST_ALL_TAC THEN POP_ASSUM MP_TAC THEN
     REWRITE_TAC [LE_0] THEN MESON_TAC [],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"max b (sup {f m | m:num < N})") THEN INTRO_TAC "![m]" THEN
    REWRITE_TAC [REAL_LE_MAX] THEN ASM_CASES_TAC (← q r"m < N:num") THENL
    [ALL_TAC, DISJ1_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC] THEN
    DISJ2_TAC THEN
    CLAIM_TAC "fin" (← q r"FINITE {f m:real | m:num < N}") THENL
    [SUBST1_TAC (← sr
       r"{f m:real | m:num < N} = IMAGE f {m:num | m < N}") THEN
     MATCH_MP_TAC FINITE_IMAGE THEN
     REWRITE_TAC [num_FINITE, FORALL_IN_GSPEC] THEN
     EXISTS_TAC (← q r"N:num") THEN ARITH_TAC,
     ALL_TAC] THEN
    CLAIM_TAC "ne" (← q r"~({f m:real | m:num < N} = {})") THENL
    [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"f 0:real") THEN
     REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"0") THEN
     CONJ_TAC THENL [ASM_ARITH_TAC, REFL_TAC],
     ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_LE_SUP_FINITE] THEN EXISTS_TAC (← q r"f (m:num):real") THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN EXISTS_TAC (← q r"m:num") THEN
    ASM_REWRITE_TAC [])

  let EVENTUALLY_LBOUND_LE_SEQUENTIALLY ← prove
   r"!f. (?b. eventually (\n. b <= f n) sequentially) <=> (?b. !n. b <= f n)"
   (GEN_TAC THEN EQ_TAC THEN REWRITE_TAC [EVENTUALLY_SEQUENTIALLY] THENL
    [ALL_TAC,
     INTRO_TAC "@b. b" THEN EXISTS_TAC (← q r"b:real") THEN ASM_REWRITE_TAC []] THEN
    INTRO_TAC "@b N. b" THEN ASM_CASES_TAC (← q r"N = 0") THENL
    [POP_ASSUM SUBST_ALL_TAC THEN POP_ASSUM MP_TAC THEN
     REWRITE_TAC [LE_0] THEN MESON_TAC [],
     ALL_TAC] THEN
    EXISTS_TAC (← q r"min b (inf {f m | m:num < N})") THEN INTRO_TAC "![m]" THEN
    REWRITE_TAC [REAL_MIN_LE] THEN ASM_CASES_TAC (← q r"m < N:num") THENL
    [ALL_TAC, DISJ1_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_ARITH_TAC] THEN
    DISJ2_TAC THEN
    CLAIM_TAC "fin" (← q r"FINITE {f m:real | m:num < N}") THENL
    [SUBST1_TAC (← sr
       r"{f m:real | m:num < N} = IMAGE f {m:num | m < N}") THEN
     MATCH_MP_TAC FINITE_IMAGE THEN
     REWRITE_TAC [num_FINITE, FORALL_IN_GSPEC] THEN
     EXISTS_TAC (← q r"N:num") THEN ARITH_TAC,
     ALL_TAC] THEN
    CLAIM_TAC "ne" (← q r"~({f m:real | m:num < N} = {})") THENL
    [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"f 0:real") THEN
     REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"0") THEN
     CONJ_TAC THENL [ASM_ARITH_TAC, REFL_TAC],
     ALL_TAC] THEN
    ASM_SIMP_TAC [REAL_INF_LE_FINITE] THEN EXISTS_TAC (← q r"f (m:num):real") THEN
    REWRITE_TAC [IN_ELIM_THM, REAL_LE_REFL] THEN EXISTS_TAC (← q r"m:num") THEN
    ASM_REWRITE_TAC [])

  return { sequentially, SEQUENTIALLY, NETLIMITS_SEQUENTIALLY, EVENTUALLY_SEQUENTIALLY,
           TRIVIAL_LIMIT_SEQUENTIALLY, EVENTUALLY_HAPPENS_SEQUENTIALLY,
           EVENTUALLY_SEQUENTIALLY_WITHIN, TRIVIAL_LIMIT_SEQUENTIALLY_WITHIN,
           EVENTUALLY_SUBSEQUENCE, ARCH_EVENTUALLY_LT, ARCH_EVENTUALLY_LE,
           ARCH_EVENTUALLY_ABS_INV_OFFSET, ARCH_EVENTUALLY_INV_OFFSET, ARCH_EVENTUALLY_INV1,
           ARCH_EVENTUALLY_INV, ARCH_EVENTUALLY_POW, ARCH_EVENTUALLY_POW_INV,
           EVENTUALLY_IN_SEQUENTIALLY, EVENTUALLY_NO_SUBSEQUENCE,
           EVENTUALLY_UBOUND_LE_SEQUENTIALLY, EVENTUALLY_LBOUND_LE_SEQUENTIALLY }

/- ------------------------------------------------------------------------- -/
/- F_sigma and G_delta sets in a topological space.  (metric.ml 11303-11581) -/
/- ------------------------------------------------------------------------- -/

structure FsigmaGdelta where
  fsigma_in : thm
  gdelta_in : thm
  FSIGMA_IN_ASCENDING : thm
  GDELTA_IN_ALT : thm
  FSIGMA_IN_SUBSET : thm
  GDELTA_IN_SUBSET : thm
  CLOSED_IMP_FSIGMA_IN : thm
  OPEN_IMP_GDELTA_IN : thm
  FSIGMA_IN_EMPTY : thm
  GDELTA_IN_EMPTY : thm
  FSIGMA_IN_TOPSPACE : thm
  GDELTA_IN_TOPSPACE : thm
  FSIGMA_IN_UNIONS : thm
  FSIGMA_IN_UNION : thm
  FSIGMA_IN_INTER : thm
  GDELTA_IN_INTERS : thm
  GDELTA_IN_INTER : thm
  GDELTA_IN_UNION : thm
  FSIGMA_IN_DIFF : thm
  GDELTA_IN_DIFF : thm
  GDELTA_IN_FSIGMA_IN : thm
  FSIGMA_IN_GDELTA_IN : thm
  GDELTA_IN_DESCENDING : thm
  HOMEOMORPHIC_MAP_FSIGMANESS : thm
  HOMEOMORPHIC_MAP_FSIGMANESS_EQ : thm
  HOMEOMORPHIC_MAP_GDELTANESS : thm
  HOMEOMORPHIC_MAP_GDELTANESS_EQ : thm
  FSIGMA_IN_RELATIVE_TO : thm
  FSIGMA_IN_SUBTOPOLOGY : thm
  GDELTA_IN_RELATIVE_TO : thm
  GDELTA_IN_SUBTOPOLOGY : thm
  FSIGMA_IN_FSIGMA_SUBTOPOLOGY : thm
  GDELTA_IN_GDELTA_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupFsigmaGdelta [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BOpenClosed1 : OpenClosed1) (BHomeo1 : Homeo1)
    (BHomeo2 : Homeo2) : ExceptT String IO FsigmaGdelta := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { ADD1, CONJ_ACI, DIFF_INTERS, DIFF_UNIONS, FORALL_INTERSECTION_OF, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, FORALL_UNION_OF, .. } := D.core1
  let { IMAGE_UNIONS, INTERS_2, INTERS_SUBSET, INTER_COMM, INTER_SUBSET, LEFT_IMP_EXISTS_THM,
        NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET_DIFF, UNIONS_SUBSET, UNION_OF, UNION_SUBSET, .. } := D.core4
  let { COUNTABLE_INTERSECTION_OF_RELATIVE_TO, COUNTABLE_INTERSECTION_OF_RELATIVE_TO_ALT,
        COUNTABLE_UNION_OF_RELATIVE_TO, FORALL_RELATIVE_TO, RELATIVE_TO_INC,
        RELATIVE_TO_RELATIVE_TO, relative_to, .. } := D.misc
  let { COUNTABLE_EMPTY, COUNTABLE_IMAGE, COUNTABLE_INSERT, COUNTABLE_INTERSECTION_OF_INC,
        COUNTABLE_INTERSECTION_OF_INTERS, COUNTABLE_INTERSECTION_OF_UNION,
        COUNTABLE_UNION_OF_ASCENDING, COUNTABLE_UNION_OF_INC, COUNTABLE_UNION_OF_INTER,
        COUNTABLE_UNION_OF_UNION, COUNTABLE_UNION_OF_UNIONS, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_EMPTY, CLOSED_IN_INTER, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE,
        CLOSED_IN_UNION, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        OPEN_IN_UNION, .. } := BTopology
  let { CLOSED_IN_RELATIVE_TO, OPEN_IN_RELATIVE_TO, SUBTOPOLOGY_SUBTOPOLOGY,
        TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { closed_map, .. } := BOpenClosed1
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, HOMEOMORPHIC_IMP_CLOSED_MAP, HOMEOMORPHIC_MAPS_MAP,
        .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let fsigma_in ← new_definition
   r"fsigma_in (top:A topology) = COUNTABLE UNION_OF closed_in top"

  let gdelta_in ← new_definition
   r"gdelta_in (top:A topology) =
        (COUNTABLE INTERSECTION_OF open_in top) relative_to topspace top"

  let FSIGMA_IN_ASCENDING ← prove
   r"!top s:A->bool.
        fsigma_in top s <=>
        ?c. (!n. closed_in top (c n)) /\
            (!n. c n SUBSET c(n + 1)) /\
            UNIONS {c n | n IN (:num)} = s"
   (REWRITE_TAC [fsigma_in] THEN
    SIMP_TAC [COUNTABLE_UNION_OF_ASCENDING, CLOSED_IN_EMPTY, CLOSED_IN_UNION] THEN
    REWRITE_TAC [ADD1])

  let GDELTA_IN_ALT ← prove
   r"!top s:A->bool.
        gdelta_in top s <=>
        s SUBSET topspace top /\ (COUNTABLE INTERSECTION_OF open_in top) s"
   (SIMP_TAC [COUNTABLE_INTERSECTION_OF_RELATIVE_TO_ALT, gdelta_in,
              OPEN_IN_TOPSPACE] THEN
    REWRITE_TAC [CONJ_ACI])

  let FSIGMA_IN_SUBSET ← prove
   r"!top s:A->bool. fsigma_in top s ==> s SUBSET topspace top"
   (GEN_TAC THEN REWRITE_TAC [fsigma_in, FORALL_UNION_OF, UNIONS_SUBSET] THEN
    SIMP_TAC [CLOSED_IN_SUBSET])

  let GDELTA_IN_SUBSET ← prove
   r"!top s:A->bool. gdelta_in top s ==> s SUBSET topspace top"
   (SIMP_TAC [GDELTA_IN_ALT])

  let CLOSED_IMP_FSIGMA_IN ← prove
   r"!top s:A->bool. closed_in top s ==> fsigma_in top s"
   (REWRITE_TAC [fsigma_in, COUNTABLE_UNION_OF_INC])

  let OPEN_IMP_GDELTA_IN ← prove
   r"!top s:A->bool. open_in top s ==> gdelta_in top s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [gdelta_in] THEN
    FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← sr r"s SUBSET u ==> s = u INTER s") o
      MATCH_MP OPEN_IN_SUBSET) THEN
    MATCH_MP_TAC RELATIVE_TO_INC THEN
    ASM_SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC])

  let FSIGMA_IN_EMPTY ← prove
   r"!top:A topology. fsigma_in top {}"
   (SIMP_TAC [CLOSED_IMP_FSIGMA_IN, CLOSED_IN_EMPTY])

  let GDELTA_IN_EMPTY ← prove
   r"!top:A topology. gdelta_in top {}"
   (SIMP_TAC [OPEN_IMP_GDELTA_IN, OPEN_IN_EMPTY])

  let FSIGMA_IN_TOPSPACE ← prove
   r"!top:A topology. fsigma_in top (topspace top)"
   (SIMP_TAC [CLOSED_IMP_FSIGMA_IN, CLOSED_IN_TOPSPACE])

  let GDELTA_IN_TOPSPACE ← prove
   r"!top:A topology. gdelta_in top (topspace top)"
   (SIMP_TAC [OPEN_IMP_GDELTA_IN, OPEN_IN_TOPSPACE])

  let FSIGMA_IN_UNIONS ← prove
   r"!top t:(A->bool)->bool.
        COUNTABLE t /\ (!s. s IN t ==> fsigma_in top s)
        ==> fsigma_in top (UNIONS t)"
   (REWRITE_TAC [fsigma_in, COUNTABLE_UNION_OF_UNIONS])

  let FSIGMA_IN_UNION ← prove
   r"!top s t:A->bool.
        fsigma_in top s /\ fsigma_in top t ==> fsigma_in top (s UNION t)"
   (REWRITE_TAC [fsigma_in, COUNTABLE_UNION_OF_UNION])

  let FSIGMA_IN_INTER ← prove
   r"!top s t:A->bool.
        fsigma_in top s /\ fsigma_in top t ==> fsigma_in top (s INTER t)"
   (GEN_TAC THEN REWRITE_TAC [fsigma_in] THEN
    MATCH_MP_TAC COUNTABLE_UNION_OF_INTER THEN
    REWRITE_TAC [CLOSED_IN_INTER])

  let GDELTA_IN_INTERS ← prove
   r"!top t:(A->bool)->bool.
        COUNTABLE t /\ ~(t = {}) /\ (!s. s IN t ==> gdelta_in top s)
        ==> gdelta_in top (INTERS t)"
   (REWRITE_TAC [GDELTA_IN_ALT] THEN REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [INTERS_SUBSET] THEN
    ASM_SIMP_TAC [COUNTABLE_INTERSECTION_OF_INTERS])

  let GDELTA_IN_INTER ← prove
   r"!top s t:A->bool.
        gdelta_in top s /\ gdelta_in top t ==> gdelta_in top (s INTER t)"
   (SIMP_TAC [← GSYM INTERS_2, GDELTA_IN_INTERS, COUNTABLE_INSERT, COUNTABLE_EMPTY,
              NOT_INSERT_EMPTY, FORALL_IN_INSERT, NOT_IN_EMPTY])

  let GDELTA_IN_UNION ← prove
   r"!top s t:A->bool.
        gdelta_in top s /\ gdelta_in top t ==> gdelta_in top (s UNION t)"
   (SIMP_TAC [GDELTA_IN_ALT, UNION_SUBSET] THEN
    MESON_TAC [COUNTABLE_INTERSECTION_OF_UNION, OPEN_IN_UNION])

  let FSIGMA_IN_DIFF ← prove
   r"!top s t:A->bool.
        fsigma_in top s /\ gdelta_in top t ==> fsigma_in top (s DIFF t)"
   (GEN_TAC THEN SUBGOAL_THEN
     (← q r"!s:A->bool. gdelta_in top s ==> fsigma_in top (topspace top DIFF s)")
    ASSUME_TAC THENL
     [REWRITE_TAC [fsigma_in, gdelta_in, FORALL_RELATIVE_TO] THEN
      REWRITE_TAC [FORALL_INTERSECTION_OF, DIFF_INTERS, ← sr
       r"s DIFF (s INTER t) = s DIFF t"] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC COUNTABLE_UNION_OF_UNIONS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [COUNTABLE_UNION_OF_INC, CLOSED_IN_DIFF,
                    CLOSED_IN_TOPSPACE],
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"s DIFF t:A->bool = s INTER (topspace top DIFF t)")
       (fun th => SUBST1_TAC th THEN ASM_SIMP_TAC [FSIGMA_IN_INTER]) THEN
     FIRST_ASSUM (MP_TAC o MATCH_MP FSIGMA_IN_SUBSET) THEN ASM SET_TAC []])

  let GDELTA_IN_DIFF ← prove
   r"!top s t:A->bool.
        gdelta_in top s /\ fsigma_in top t ==> gdelta_in top (s DIFF t)"
   (GEN_TAC THEN SUBGOAL_THEN
     (← q r"!s:A->bool. fsigma_in top s ==> gdelta_in top (topspace top DIFF s)")
    ASSUME_TAC THENL
     [REWRITE_TAC [fsigma_in, gdelta_in, FORALL_UNION_OF, DIFF_UNIONS] THEN
      REPEAT STRIP_TAC THEN MATCH_MP_TAC RELATIVE_TO_INC THEN
      MATCH_MP_TAC COUNTABLE_INTERSECTION_OF_INTERS THEN
      ASM_SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_SIMP_TAC [COUNTABLE_INTERSECTION_OF_INC, OPEN_IN_DIFF,
                    OPEN_IN_TOPSPACE],
      REPEAT STRIP_TAC THEN
      SUBGOAL_THEN (← q r"s DIFF t:A->bool = s INTER (topspace top DIFF t)")
       (fun th => SUBST1_TAC th THEN ASM_SIMP_TAC [GDELTA_IN_INTER]) THEN
     FIRST_ASSUM (MP_TAC o MATCH_MP GDELTA_IN_SUBSET) THEN ASM SET_TAC []])

  let GDELTA_IN_FSIGMA_IN ← prove
   r"!top s:A->bool.
       gdelta_in top s <=>
       s SUBSET topspace top /\ fsigma_in top (topspace top DIFF s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [GDELTA_IN_SUBSET, FSIGMA_IN_DIFF, FSIGMA_IN_TOPSPACE] THEN
    STRIP_TAC THEN FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← sr
     r"s SUBSET u ==> s = u DIFF (u DIFF s)")) THEN
    ASM_SIMP_TAC [GDELTA_IN_DIFF, GDELTA_IN_TOPSPACE])

  let FSIGMA_IN_GDELTA_IN ← prove
   r"!top s:A->bool.
        fsigma_in top s <=>
        s SUBSET topspace top /\ gdelta_in top (topspace top DIFF s)"
   (REPEAT GEN_TAC THEN EQ_TAC THEN
    SIMP_TAC [FSIGMA_IN_SUBSET, GDELTA_IN_DIFF, GDELTA_IN_TOPSPACE] THEN
    STRIP_TAC THEN FIRST_ASSUM (SUBST1_TAC o MATCH_MP (← sr
     r"s SUBSET u ==> s = u DIFF (u DIFF s)")) THEN
    ASM_SIMP_TAC [FSIGMA_IN_DIFF, FSIGMA_IN_TOPSPACE])

  let GDELTA_IN_DESCENDING ← prove
   r"!top s:A->bool.
        gdelta_in top s <=>
        ?c. (!n. open_in top (c n)) /\
            (!n. c(n + 1) SUBSET c n) /\
            INTERS {c n | n IN (:num)} = s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [GDELTA_IN_FSIGMA_IN] THEN
    REWRITE_TAC [FSIGMA_IN_ASCENDING] THEN EQ_TAC THENL
     [DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
       (X_CHOOSE_THEN (← q r"c:num->A->bool") STRIP_ASSUME_TAC)),
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:num->A->bool") STRIP_ASSUME_TAC) THEN
      CONJ_TAC THENL
       [FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN MATCH_MP_TAC INTERS_SUBSET THEN
        ASM_SIMP_TAC [OPEN_IN_SUBSET, FORALL_IN_GSPEC] THEN SET_TAC [],
        ALL_TAC]] THEN
    EXISTS_TAC (← q r"\n. topspace top DIFF (c:num->A->bool) n") THEN
    ASM_SIMP_TAC [OPEN_IN_DIFF, CLOSED_IN_DIFF, OPEN_IN_TOPSPACE,
      CLOSED_IN_TOPSPACE, ← sr r"s SUBSET t ==> u DIFF t SUBSET u DIFF s"]
    THENL
     [FIRST_X_ASSUM (MP_TAC o MATCH_MP (← sr
       r"u = t DIFF s ==> s SUBSET t ==> s = t DIFF u")) THEN
      ASM_REWRITE_TAC [] THEN DISCH_THEN SUBST1_TAC THEN
      REWRITE_TAC [DIFF_UNIONS],
      FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN REWRITE_TAC [DIFF_INTERS]] THEN
    REWRITE_TAC [← sr r"{g y | y IN {f x | x IN s}} = {g(f x) | x IN s}"] THEN
    REWRITE_TAC [← sr r"s = t INTER s <=> s SUBSET t"] THEN
    MATCH_MP_TAC INTERS_SUBSET THEN
    ASM_SIMP_TAC [OPEN_IN_SUBSET, FORALL_IN_GSPEC] THEN SET_TAC [])

  let HOMEOMORPHIC_MAP_FSIGMANESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (fsigma_in top' (IMAGE f u) <=> fsigma_in top u)"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAP_MAPS]) THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, HOMEOMORPHIC_MAPS_MAP] THEN
    X_GEN_TAC (← q r"g:B->A") THEN STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [fsigma_in, UNION_OF, LEFT_IMP_EXISTS_THM] THENL
     [X_GEN_TAC (← q r"v:(B->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (IMAGE (g:B->A)) v") THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, ← GSYM IMAGE_UNIONS] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []],
      X_GEN_TAC (← q r"v:(A->bool)->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"IMAGE (IMAGE (f:A->B)) v") THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE, ← GSYM IMAGE_UNIONS]] THEN
    ASM_MESON_TAC [HOMEOMORPHIC_IMP_CLOSED_MAP, closed_map])

  let HOMEOMORPHIC_MAP_FSIGMANESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (fsigma_in top u <=>
             u SUBSET topspace top /\ fsigma_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_FSIGMANESS, FSIGMA_IN_SUBSET])

  let HOMEOMORPHIC_MAP_GDELTANESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (gdelta_in top' (IMAGE f u) <=> gdelta_in top u)"
   (REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [GDELTA_IN_FSIGMA_IN] THEN
    SUBGOAL_THEN
     (← q r"topspace top' DIFF IMAGE (f:A->B) u = IMAGE f (topspace top DIFF u)")
    SUBST1_TAC THENL
     [ALL_TAC,
      ASM_SIMP_TAC [HOMEOMORPHIC_MAP_FSIGMANESS, SUBSET_DIFF]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_GDELTANESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (gdelta_in top u <=>
             u SUBSET topspace top /\ gdelta_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_GDELTANESS, GDELTA_IN_SUBSET])

  let FSIGMA_IN_RELATIVE_TO ← prove
   r"!top s:A->bool.
        (fsigma_in top relative_to s) = fsigma_in (subtopology top s)"
   (REWRITE_TAC [fsigma_in, COUNTABLE_UNION_OF_RELATIVE_TO] THEN
    REWRITE_TAC [CLOSED_IN_RELATIVE_TO])

  let FSIGMA_IN_SUBTOPOLOGY ← prove
   r"!top u s:A->bool.
         fsigma_in (subtopology top u) s <=>
         ?t. fsigma_in top t /\ s = t INTER u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM FSIGMA_IN_RELATIVE_TO] THEN
    REWRITE_TAC [relative_to] THEN MESON_TAC [INTER_COMM])

  let GDELTA_IN_RELATIVE_TO ← prove
   r"!top s:A->bool.
        (gdelta_in top relative_to s) = gdelta_in (subtopology top s)"
   (REWRITE_TAC [gdelta_in, RELATIVE_TO_RELATIVE_TO] THEN
    ONCE_REWRITE_TAC [COUNTABLE_INTERSECTION_OF_RELATIVE_TO] THEN
    REWRITE_TAC [OPEN_IN_RELATIVE_TO] THEN
    REWRITE_TAC [SUBTOPOLOGY_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [← sr r"s INTER u INTER s = u INTER s"])

  let GDELTA_IN_SUBTOPOLOGY ← prove
   r"!top u s:A->bool.
         gdelta_in (subtopology top u) s <=>
         ?t. gdelta_in top t /\ s = t INTER u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM GDELTA_IN_RELATIVE_TO] THEN
    REWRITE_TAC [relative_to] THEN MESON_TAC [INTER_COMM])

  let FSIGMA_IN_FSIGMA_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        fsigma_in top s
        ==> (fsigma_in (subtopology top s) t <=>
             fsigma_in top t /\ t SUBSET s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [FSIGMA_IN_SUBTOPOLOGY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [INTER_SUBSET, FSIGMA_IN_INTER] THEN
    EXISTS_TAC (← q r"t:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let GDELTA_IN_GDELTA_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
        gdelta_in top s
        ==> (gdelta_in (subtopology top s) t <=>
             gdelta_in top t /\ t SUBSET s)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [GDELTA_IN_SUBTOPOLOGY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [INTER_SUBSET, GDELTA_IN_INTER] THEN
    EXISTS_TAC (← q r"t:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  return { fsigma_in, gdelta_in, FSIGMA_IN_ASCENDING, GDELTA_IN_ALT, FSIGMA_IN_SUBSET,
           GDELTA_IN_SUBSET, CLOSED_IMP_FSIGMA_IN, OPEN_IMP_GDELTA_IN, FSIGMA_IN_EMPTY,
           GDELTA_IN_EMPTY, FSIGMA_IN_TOPSPACE, GDELTA_IN_TOPSPACE, FSIGMA_IN_UNIONS,
           FSIGMA_IN_UNION, FSIGMA_IN_INTER, GDELTA_IN_INTERS, GDELTA_IN_INTER, GDELTA_IN_UNION,
           FSIGMA_IN_DIFF, GDELTA_IN_DIFF, GDELTA_IN_FSIGMA_IN, FSIGMA_IN_GDELTA_IN,
           GDELTA_IN_DESCENDING, HOMEOMORPHIC_MAP_FSIGMANESS, HOMEOMORPHIC_MAP_FSIGMANESS_EQ,
           HOMEOMORPHIC_MAP_GDELTANESS, HOMEOMORPHIC_MAP_GDELTANESS_EQ, FSIGMA_IN_RELATIVE_TO,
           FSIGMA_IN_SUBTOPOLOGY, GDELTA_IN_RELATIVE_TO, GDELTA_IN_SUBTOPOLOGY,
           FSIGMA_IN_FSIGMA_SUBTOPOLOGY, GDELTA_IN_GDELTA_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Borel sets.  (metric.ml 11583-11823)                                      -/
/- ------------------------------------------------------------------------- -/

structure Borel where
  borel_in_RULES : thm
  borel_in_INDUCT : thm
  borel_in_CASES : thm
  OPEN_IMP_BOREL_IN : thm
  BOREL_IN_COMPLEMENT : thm
  BOREL_IN_COMPLEMENT_EQ : thm
  BOREL_IN_UNIONS : thm
  BOREL_IN_SUBSET_TOPSPACE : thm
  BOREL_IN_TOPSPACE : thm
  BOREL_IN_EMPTY : thm
  BOREL_IN_INTERS : thm
  BOREL_IN_UNION : thm
  BOREL_IN_INTER : thm
  BOREL_IN_DIFF : thm
  CLOSED_IMP_BOREL_IN : thm
  FSIGMA_IMP_BOREL_IN : thm
  GDELTA_IMP_BOREL_IN : thm
  OPEN_IN_SUBTOPOLOGY_BOREL_IN : thm
  CLOSED_IN_SUBTOPOLOGY_BOREL_IN : thm
  BOREL_IN_SUBTOPOLOGY : thm
  BOREL_FROM_SUBTOPOLOGY : thm
  BOREL_IN_INTER_SUBTOPOLOGY : thm
  BOREL_IN_SUBTOPOLOGY_EQ : thm
  BOREL_IN_CONTINUOUS_MAP_PREIMAGE : thm
  BOREL_IN_HOMEOMORPHIC_MAP_IMAGE : thm
  BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ : thm
  BOREL_IN_HOMEOMORPHIC_MAP_IMAGE_EQ : thm
  deriving Inhabited

@[nospecialize]
def setupBorel [HolBase] (D : MetricDeps) (BTopology : Topology) (BSubtopology : Subtopology)
    (BContMap1 : ContMap1) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BFsigmaGdelta : FsigmaGdelta) : ExceptT String IO Borel := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_inductive_definition, .. } := D
  let { FORALL_IN_IMAGE, FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, INTERS_2, INTER_SUBSET, INTER_UNIONS, IN_ELIM_THM, LEFT_IMP_EXISTS_THM,
        NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { SIMPLE_IMAGE, SUBSET, UNIONS_2, UNIONS_GSPEC, UNIONS_IMAGE, UNIONS_SUBSET, UNION_OF,
        .. } := D.core4
  let { COUNTABLE_EMPTY, COUNTABLE_IMAGE, COUNTABLE_INSERT, FORALL_COUNTABLE_SUBSET_IMAGE,
        .. } := D.lib
  let { OPEN_IN_EMPTY, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_MAPS_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_MAPS, .. } := BHomeo2
  let { GDELTA_IN_FSIGMA_IN, fsigma_in, .. } := BFsigmaGdelta
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let (borel_in_RULES, borel_in_INDUCT, borel_in_CASES) ← new_inductive_definition
   r"(!s:A->bool. open_in top s ==> borel_in top s) /\
  (!s:A->bool. borel_in top s ==> borel_in top (topspace top DIFF s)) /\
  (!u:(A->bool)->bool.
       COUNTABLE u /\ (!s. s IN u ==> borel_in top s)
       ==> borel_in top (UNIONS u))"

  let OPEN_IMP_BOREL_IN ← prove
   r"!top s:A->bool. open_in top s ==> borel_in top s"
   (REWRITE_TAC [borel_in_RULES])

  let BOREL_IN_COMPLEMENT ← prove
   r"!top s:A->bool.
        borel_in top s ==> borel_in top (topspace top DIFF s)"
   (REWRITE_TAC [borel_in_RULES])

  let BOREL_IN_COMPLEMENT_EQ ← prove
   r"!top s:A->bool.
     s SUBSET topspace top
     ==> (borel_in top (topspace top DIFF s) <=> borel_in top s)"
   (MESON_TAC [borel_in_RULES, ← sr r"s SUBSET u ==> u DIFF (u DIFF s) = s"])

  let BOREL_IN_UNIONS ← prove
   r"!top (u:(A->bool)->bool).
        COUNTABLE u /\ (!s. s IN u ==> borel_in top s)
        ==> borel_in top (UNIONS u)"
   (REWRITE_TAC [borel_in_RULES])

  let BOREL_IN_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. borel_in top s ==> s SUBSET topspace top"
   (GEN_TAC THEN MATCH_MP_TAC borel_in_INDUCT THEN REPEAT CONJ_TAC THENL
    [REWRITE_TAC [OPEN_IN_SUBSET],
     REPEAT STRIP_TAC THEN SET_TAC [],
     REPEAT STRIP_TAC THEN REWRITE_TAC [UNIONS_SUBSET] THEN ASM_MESON_TAC []])

  let BOREL_IN_TOPSPACE ← prove
   r"!top:A topology. borel_in top (topspace top)"
   (GEN_TAC THEN MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN
    REWRITE_TAC [OPEN_IN_TOPSPACE])

  let BOREL_IN_EMPTY ← prove
   r"!top:A topology. borel_in top {}"
   (GEN_TAC THEN MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN
    REWRITE_TAC [OPEN_IN_EMPTY])

  let BOREL_IN_INTERS ← prove
   r"!top (u:(A->bool)->bool).
     COUNTABLE u /\ ~(u = {}) /\ (!s. s IN u ==> borel_in top s)
     ==> borel_in top (INTERS u)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
      (← q r"INTERS u:A->bool =
       topspace top DIFF UNIONS (IMAGE (\s. topspace top DIFF s) u)")
    SUBST1_TAC THENL
     [SUBGOAL_THEN (← q r"!s:A->bool. s IN u ==> s SUBSET topspace top") MP_TAC THENL
       [ASM_MESON_TAC [BOREL_IN_SUBSET_TOPSPACE], ASM SET_TAC []],
      MATCH_MP_TAC BOREL_IN_COMPLEMENT THEN MATCH_MP_TAC BOREL_IN_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
      ASM_MESON_TAC [borel_in_RULES]])

  let BOREL_IN_UNION ← prove
   r"!top s t:A->bool.
     borel_in top s /\ borel_in top t ==> borel_in top (s UNION t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM UNIONS_2] THEN
    MATCH_MP_TAC BOREL_IN_UNIONS THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY] THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT, COUNTABLE_EMPTY])

  let BOREL_IN_INTER ← prove
   r"!top s t:A->bool.
     borel_in top s /\ borel_in top t ==> borel_in top (s INTER t)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM INTERS_2] THEN
    MATCH_MP_TAC BOREL_IN_INTERS THEN
    ASM_REWRITE_TAC [FORALL_IN_INSERT, NOT_IN_EMPTY, NOT_INSERT_EMPTY] THEN
    ASM_REWRITE_TAC [COUNTABLE_INSERT, COUNTABLE_EMPTY])

  let BOREL_IN_DIFF ← prove
   r"!top s t:A->bool.
     borel_in top s /\ borel_in top t ==> borel_in top (s DIFF t)"
   (REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s DIFF t:A->bool = s INTER (topspace top DIFF t)")
    SUBST1_TAC THENL
     [MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool"] BOREL_IN_SUBSET_TOPSPACE) THEN
      ASM_REWRITE_TAC [] THEN SET_TAC [],
      ASM_SIMP_TAC [BOREL_IN_INTER, BOREL_IN_COMPLEMENT]])

  let CLOSED_IMP_BOREL_IN ← prove
   r"!top s:A->bool. closed_in top s ==> borel_in top s"
   (REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_in]) THEN
    STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s:A->bool = topspace top DIFF (topspace top DIFF s)")
    SUBST1_TAC THENL
     [ASM SET_TAC [], ASM_SIMP_TAC [BOREL_IN_COMPLEMENT, OPEN_IMP_BOREL_IN]])

  let FSIGMA_IMP_BOREL_IN ← prove
   r"!top s:A->bool. fsigma_in top s ==> borel_in top s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [fsigma_in, UNION_OF] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (SUBST1_TAC o SYM) THEN
    MATCH_MP_TAC BOREL_IN_UNIONS THEN ASM_REWRITE_TAC [] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CLOSED_IMP_BOREL_IN THEN
    ASM_MESON_TAC [])

  let GDELTA_IMP_BOREL_IN ← prove
   r"!top s:A->bool. gdelta_in top s ==> borel_in top s"
   (MESON_TAC [GDELTA_IN_FSIGMA_IN, FSIGMA_IMP_BOREL_IN, BOREL_IN_COMPLEMENT_EQ])

  let OPEN_IN_SUBTOPOLOGY_BOREL_IN ← prove
   r"!top t s:A->bool.
     open_in (subtopology top t) s /\ borel_in top t ==> borel_in top s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC BOREL_IN_INTER THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN ASM_REWRITE_TAC [])

  let CLOSED_IN_SUBTOPOLOGY_BOREL_IN ← prove
   r"!top t s:A->bool.
     closed_in (subtopology top t) s /\ borel_in top t ==> borel_in top s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CLOSED_IN_SUBTOPOLOGY] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC BOREL_IN_INTER THEN ASM_REWRITE_TAC [] THEN
    MATCH_MP_TAC CLOSED_IMP_BOREL_IN THEN ASM_REWRITE_TAC [])

  let BOREL_IN_SUBTOPOLOGY ← prove
   r"!top (u:A->bool) s.
        borel_in (subtopology top u) s <=>
        ?t. borel_in top t /\ s = t INTER u"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [SPEC_TAC (← q r"s:A->bool", ← q r"s:A->bool"),
      DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool")
          (CONJUNCTS_THEN2 MP_TAC SUBST1_TAC)) THEN
      SPEC_TAC (← q r"t:A->bool", ← q r"t:A->bool")] THEN
    MATCH_MP_TAC borel_in_INDUCT THEN REPEAT CONJ_TAC THENL
     [MESON_TAC [OPEN_IN_SUBTOPOLOGY, OPEN_IMP_BOREL_IN],
      X_GEN_TAC (← q r"s:A->bool") THEN DISCH_THEN
       (X_CHOOSE_THEN (← q r"t:A->bool") (CONJUNCTS_THEN2 ASSUME_TAC SUBST1_TAC)) THEN
      EXISTS_TAC (← q r"topspace top DIFF t:A->bool") THEN
      ASM_SIMP_TAC [BOREL_IN_COMPLEMENT, TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [],
      REWRITE_TAC [FORALL_COUNTABLE_SUBSET_IMAGE, ← sr
       r"(!s. s IN u ==> ?t. P t /\ s = f t) <=> u SUBSET IMAGE f {t | P t}"] THEN
      REWRITE_TAC [← GSYM (← REWRITE_RULE [SIMPLE_IMAGE] INTER_UNIONS)] THEN
      REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC [BOREL_IN_UNIONS],
      MESON_TAC [OPEN_IN_SUBTOPOLOGY, OPEN_IMP_BOREL_IN],
      X_GEN_TAC (← q r"s:A->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"(topspace top DIFF s) INTER u:A->bool =
        topspace(subtopology top u) DIFF (s INTER u)")
      SUBST1_TAC THENL
       [REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN SET_TAC [],
        ASM_SIMP_TAC [BOREL_IN_COMPLEMENT]],
      X_GEN_TAC (← q r"f:(A->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
       (← q r"UNIONS f INTER u:A->bool = UNIONS (IMAGE (\u'. u' INTER u) f)")
      SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_IMAGE, UNIONS_GSPEC] THEN SET_TAC [],
        MATCH_MP_TAC BOREL_IN_UNIONS THEN
        ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE]]])

  let BOREL_FROM_SUBTOPOLOGY ← prove
   r"!top (u:A->bool) s.
        borel_in (subtopology top u) s /\ borel_in top u ==> borel_in top s"
   (MESON_TAC [BOREL_IN_SUBTOPOLOGY, BOREL_IN_INTER])

  let BOREL_IN_INTER_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
     borel_in top t ==> borel_in (subtopology top s) (t INTER s)"
   (MESON_TAC [BOREL_IN_SUBTOPOLOGY])

  let BOREL_IN_SUBTOPOLOGY_EQ ← prove
   r"!top u s:A->bool.
        borel_in top u
        ==> (borel_in (subtopology top u) s <=> borel_in top s /\ s SUBSET u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [BOREL_IN_SUBTOPOLOGY] THEN EQ_TAC THENL
     [ASM_MESON_TAC [BOREL_IN_INTER, INTER_SUBSET], SET_TAC []])

  let BOREL_IN_CONTINUOUS_MAP_PREIMAGE ← prove
   r"!top1 top2 (f:A->B) t.
        continuous_map (top1,top2) f /\ borel_in top2 t
        ==> borel_in top1 {x | x IN topspace top1 /\ f x IN t}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN DISCH_TAC THEN
    SPEC_TAC (← q r"t:B->bool", ← q r"t:B->bool") THEN
    MATCH_MP_TAC borel_in_INDUCT THEN REPEAT CONJ_TAC THENL
     [X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC OPEN_IMP_BOREL_IN THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_map]) THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"u:B->bool") o CONJUNCT2) THEN
      ASM_REWRITE_TAC [],
      X_GEN_TAC (← q r"s:B->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
        (← q r"{x:A | x IN topspace top1 /\ (f:A->B) x IN topspace top2 DIFF s} =
         topspace top1 DIFF {x | x IN topspace top1 /\ f x IN s}")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [continuous_map]) THEN
        DISCH_THEN (MP_TAC o CONJUNCT1) THEN SET_TAC [],
        ASM_SIMP_TAC [BOREL_IN_COMPLEMENT]],
      X_GEN_TAC (← q r"u:(B->bool)->bool") THEN STRIP_TAC THEN
      SUBGOAL_THEN
        (← q r"{x:A | x IN topspace top1 /\ (f:A->B) x IN UNIONS u} =
         UNIONS (IMAGE (\s. {x | x IN topspace top1 /\ f x IN s}) u)")
      SUBST1_TAC THENL
       [REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
        MATCH_MP_TAC BOREL_IN_UNIONS THEN
        ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN
        ASM_MESON_TAC []]])

  let BOREL_IN_HOMEOMORPHIC_MAP_IMAGE ← prove
   r"!top top' (f:A->B) s.
        homeomorphic_map (top,top') f /\ borel_in top s
        ==> borel_in top' (IMAGE f s)"
   (REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, homeomorphic_maps] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [IMP_CONJ, LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"g:B->A") THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN (← q r"s SUBSET topspace(top:A topology)") ASSUME_TAC THENL
     [ASM_MESON_TAC [BOREL_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"IMAGE (f:A->B) s = {y | y IN topspace top' /\ g y IN s}")
    SUBST1_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [],
      MATCH_MP_TAC BOREL_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"top:A topology") THEN ASM_REWRITE_TAC []])

  let BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ ← prove
   r"!top top' (f:A->B) g s.
        homeomorphic_maps (top,top') (f,g) /\ s SUBSET topspace top
        ==> (borel_in top' (IMAGE f s) <=> borel_in top s)"
   (REWRITE_TAC [HOMEOMORPHIC_MAPS_MAP] THEN REPEAT STRIP_TAC THEN
    EQ_TAC THENL [DISCH_TAC, ASM_MESON_TAC [BOREL_IN_HOMEOMORPHIC_MAP_IMAGE]] THEN
    SUBGOAL_THEN (← q r"s = IMAGE (g:B->A) (IMAGE (f:A->B) s)") SUBST1_TAC THENL
     [ASM SET_TAC [], ASM_MESON_TAC [BOREL_IN_HOMEOMORPHIC_MAP_IMAGE]])

  let BOREL_IN_HOMEOMORPHIC_MAP_IMAGE_EQ ← prove
   r"!top top' (f:A->B) s.
     homeomorphic_map (top,top') f /\ s SUBSET topspace top
     ==> (borel_in top' (IMAGE f s) <=> borel_in top s)"
   (REWRITE_TAC [HOMEOMORPHIC_MAP_MAPS, LEFT_IMP_EXISTS_THM] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ THEN
    EXISTS_TAC (← q r"g:B->A") THEN ASM_REWRITE_TAC [])

  return { borel_in_RULES, borel_in_INDUCT, borel_in_CASES, OPEN_IMP_BOREL_IN,
           BOREL_IN_COMPLEMENT, BOREL_IN_COMPLEMENT_EQ, BOREL_IN_UNIONS,
           BOREL_IN_SUBSET_TOPSPACE, BOREL_IN_TOPSPACE, BOREL_IN_EMPTY, BOREL_IN_INTERS,
           BOREL_IN_UNION, BOREL_IN_INTER, BOREL_IN_DIFF, CLOSED_IMP_BOREL_IN,
           FSIGMA_IMP_BOREL_IN, GDELTA_IMP_BOREL_IN, OPEN_IN_SUBTOPOLOGY_BOREL_IN,
           CLOSED_IN_SUBTOPOLOGY_BOREL_IN, BOREL_IN_SUBTOPOLOGY, BOREL_FROM_SUBTOPOLOGY,
           BOREL_IN_INTER_SUBTOPOLOGY, BOREL_IN_SUBTOPOLOGY_EQ,
           BOREL_IN_CONTINUOUS_MAP_PREIMAGE, BOREL_IN_HOMEOMORPHIC_MAP_IMAGE,
           BOREL_IN_HOMEOMORPHIC_MAPS_IMAGE_EQ, BOREL_IN_HOMEOMORPHIC_MAP_IMAGE_EQ }

/- ------------------------------------------------------------------------- -/
/- Borel measurable maps.  (metric.ml 11825-11974)                           -/
/- ------------------------------------------------------------------------- -/

structure BorelMap where
  borel_measurable_map : thm
  BOREL_MEASURABLE_MAP_OPEN_IN : thm
  BOREL_MEASURABLE_MAP_CLOSED_IN : thm
  BOREL_MEASURABLE_MAP_IMAGE_SUBSET_TOPSPACE : thm
  CONTINUOUS_IMP_BOREL_MEASURABLE_MAP : thm
  BOREL_MEASURABLE_MAP_ID : thm
  BOREL_MEASURABLE_MAP_CONST : thm
  BOREL_MEASURABLE_MAP_EQ : thm
  BOREL_MEASURABLE_MAP_COMPOSE : thm
  BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY : thm
  BOREL_MEASURABLE_MAP_INTO_SUBTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupBorelMap [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BBorel : Borel) :
    ExceptT String IO BorelMap := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, SET_TAC, new_definition, .. } := D
  let { EMPTY_GSPEC, EXTENSION, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_ELIM_THM, LEFT_IMP_EXISTS_THM, NOT_IN_EMPTY, .. } := D.core2
  let { UNIONS_IMAGE, o_THM, .. } := D.core4
  let { EQ_IMP, .. } := D.core5
  let { COUNTABLE_IMAGE, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_ID, continuous_map, .. } := BContMap1
  let { BOREL_IN_COMPLEMENT, BOREL_IN_EMPTY, BOREL_IN_INTER_SUBTOPOLOGY, BOREL_IN_TOPSPACE,
        BOREL_IN_UNIONS, CLOSED_IMP_BOREL_IN, OPEN_IMP_BOREL_IN, borel_in_INDUCT,
        .. } := BBorel
  -- @@SCOPE END

  let borel_measurable_map ← new_definition
   r"borel_measurable_map (top1,top2) (f:A->B) <=>
    (!x. x IN topspace top1 ==> f x IN topspace top2) /\
    (!u. borel_in top2 u
         ==> borel_in top1 {x | x IN topspace top1 /\ f x IN u})"

  let BOREL_MEASURABLE_MAP_OPEN_IN ← prove
   r"!top1 top2 (f:A->B).
        borel_measurable_map (top1,top2) f <=>
        (!x. x IN topspace top1 ==> f x IN topspace top2) /\
        (!c. open_in top2 c
             ==> borel_in top1 {x | x IN topspace top1 /\ f x IN c})"
   (REPEAT GEN_TAC THEN REWRITE_TAC [borel_measurable_map] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THENL
     [ASM_MESON_TAC [OPEN_IMP_BOREL_IN], ALL_TAC] THEN
    MATCH_MP_TAC borel_in_INDUCT THEN REPEAT CONJ_TAC THENL
    [REPEAT GEN_TAC THEN DISCH_TAC THEN ASM_SIMP_TAC [],
     X_GEN_TAC (← q r"s:B->bool") THEN DISCH_TAC THEN
     SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top1 /\ (f:A->B) x IN topspace top2 DIFF s} =
        topspace top1 DIFF {x | x IN topspace top1 /\ f x IN s}")
     SUBST1_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC [BOREL_IN_COMPLEMENT]],
     X_GEN_TAC (← q r"u:(B->bool)->bool") THEN STRIP_TAC THEN
     SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top1 /\ (f:A->B) x IN UNIONS u} =
        UNIONS (IMAGE (\s. {x | x IN topspace top1 /\ f x IN s}) u)")
       SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_IMAGE] THEN SET_TAC [],
      MATCH_MP_TAC BOREL_IN_UNIONS THEN
      ASM_SIMP_TAC [COUNTABLE_IMAGE, FORALL_IN_IMAGE] THEN ASM_MESON_TAC []]])

  let BOREL_MEASURABLE_MAP_CLOSED_IN ← prove
   r"!top1 top2 (f:A->B).
     borel_measurable_map (top1,top2) f <=>
     (!x. x IN topspace top1 ==> f x IN topspace top2) /\
     (!c. closed_in top2 c
          ==> borel_in top1 {x | x IN topspace top1 /\ f x IN c})"
   (REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [CONJ_TAC THENL [ASM_MESON_TAC [BOREL_MEASURABLE_MAP_OPEN_IN], ALL_TAC] THEN
      ASM_MESON_TAC [borel_measurable_map, CLOSED_IMP_BOREL_IN],
      REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN] THEN ASM_REWRITE_TAC [] THEN
      X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
      SUBGOAL_THEN
       (← q r"{x:A | x IN topspace top1 /\ (f:A->B) x IN u} =
        topspace top1 DIFF
        {x | x IN topspace top1 /\ f x IN (topspace top2 DIFF u)}")
      SUBST1_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN ASM SET_TAC [],
         MATCH_MP_TAC BOREL_IN_COMPLEMENT THEN
         ASM_MESON_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE]]])

  let BOREL_MEASURABLE_MAP_IMAGE_SUBSET_TOPSPACE ← prove
   r"!top1 top2 (f:A->B).
     borel_measurable_map (top1,top2) f
     ==> IMAGE f (topspace top1) SUBSET topspace top2"
   (REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN] THEN SET_TAC [])

  let CONTINUOUS_IMP_BOREL_MEASURABLE_MAP ← prove
   r"!top1 top2 (f:A->B).
     continuous_map (top1,top2) f ==> borel_measurable_map (top1,top2) f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [continuous_map, BOREL_MEASURABLE_MAP_OPEN_IN] THEN
    ASM_MESON_TAC [OPEN_IMP_BOREL_IN])

  let BOREL_MEASURABLE_MAP_ID ← prove
   r"!top:A topology. borel_measurable_map (top,top) (\x. x)"
   (SIMP_TAC [CONTINUOUS_IMP_BOREL_MEASURABLE_MAP, CONTINUOUS_MAP_ID])

  let BOREL_MEASURABLE_MAP_CONST ← prove
   r"!top1 top2 (c:B).
     borel_measurable_map (top1,top2) (\x:A. c) <=>
     topspace top1 = {} \/ c IN topspace top2"
   (REPEAT GEN_TAC THEN REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN] THEN
    ASM_CASES_TAC (← q r"topspace top1:A->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, BOREL_IN_EMPTY] THEN
    ASM_CASES_TAC (← q r"(c:B) IN topspace top2") THEN ASM_REWRITE_TAC [] THENL
    [X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
     ASM_CASES_TAC (← q r"(c:B) IN u") THENL
     [SUBGOAL_THEN (← q r"{x:A | x IN topspace top1 /\ (c:B) IN u} = topspace top1")
        SUBST1_TAC THENL [ASM SET_TAC [], REWRITE_TAC [BOREL_IN_TOPSPACE]],
      SUBGOAL_THEN (← q r"{x:A | x IN topspace top1 /\ (c:B) IN u} = {}")
        SUBST1_TAC THENL [ASM SET_TAC [], REWRITE_TAC [BOREL_IN_EMPTY]]],
     ASM SET_TAC []])

  let BOREL_MEASURABLE_MAP_EQ ← prove
   r"!top1 top2 (f:A->B) g.
        (!x. x IN topspace top1 ==> f x = g x) /\
        borel_measurable_map (top1,top2) f
        ==> borel_measurable_map (top1,top2) g"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN] THEN STRIP_TAC THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
      (← q r"{x:A | x IN topspace top1 /\ (g:A->B) x IN u} =
       {x | x IN topspace top1 /\ f x IN u}")
    SUBST1_TAC THENL [ASM SET_TAC [], ASM_SIMP_TAC []])

  let BOREL_MEASURABLE_MAP_COMPOSE ← prove
   r"!top1 top2 top3 (f:A->B) (g:B->C).
     borel_measurable_map (top1,top2) f /\ borel_measurable_map (top2,top3) g
     ==> borel_measurable_map (top1,top3) (g o f)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [borel_measurable_map] THEN STRIP_TAC THEN
    CONJ_TAC THENL [REWRITE_TAC [o_THM] THEN ASM_MESON_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"t:C->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
      (← q r"{x:A | x IN topspace top1 /\ ((g:B->C) o (f:A->B)) x IN t} =
       {x | x IN topspace top1 /\ f x IN {y | y IN topspace top2 /\ g y IN t}}")
    SUBST1_TAC THENL
     [REWRITE_TAC [o_THM, EXTENSION, IN_ELIM_THM] THEN ASM_MESON_TAC [],
      FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_SIMP_TAC []])

  let BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY ← prove
   r"!top1 top2 (f:A->B) s.
        borel_measurable_map (top1,top2) f
        ==> borel_measurable_map (subtopology top1 s,top2) f"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN, TOPSPACE_SUBTOPOLOGY] THEN
    STRIP_TAC THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
    SUBGOAL_THEN
     (← q r"{x:A | x IN topspace top1 INTER s /\ (f:A->B) x IN u} =
      {x | x IN topspace top1 /\ f x IN u} INTER s")
    SUBST1_TAC THENL
     [SET_TAC [], MATCH_MP_TAC BOREL_IN_INTER_SUBTOPOLOGY THEN ASM_SIMP_TAC []])

  let BOREL_MEASURABLE_MAP_INTO_SUBTOPOLOGY ← prove
   r"!top1 top2 (f:A->B) s.
     borel_measurable_map (top1,subtopology top2 s) f <=>
     borel_measurable_map (top1,top2) f /\ IMAGE f (topspace top1) SUBSET s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [BOREL_MEASURABLE_MAP_OPEN_IN, TOPSPACE_SUBTOPOLOGY] THEN
    REWRITE_TAC [OPEN_IN_SUBTOPOLOGY, LEFT_IMP_EXISTS_THM] THEN EQ_TAC THEN
    STRIP_TAC THENL
     [REPEAT CONJ_TAC THENL
       [ASM SET_TAC [],
        X_GEN_TAC (← q r"u:B->bool") THEN DISCH_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPECL [← q r"u INTER s:B->bool", ← q r"u:B->bool"]) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN
        ASM SET_TAC [],
        ASM SET_TAC []],
      CONJ_TAC THENL
       [ASM SET_TAC [],
        MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"t:B->bool"] THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"t:B->bool")) THEN ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC EQ_IMP THEN AP_TERM_TAC THEN ASM SET_TAC []]])

  return { borel_measurable_map, BOREL_MEASURABLE_MAP_OPEN_IN, BOREL_MEASURABLE_MAP_CLOSED_IN,
           BOREL_MEASURABLE_MAP_IMAGE_SUBSET_TOPSPACE, CONTINUOUS_IMP_BOREL_MEASURABLE_MAP,
           BOREL_MEASURABLE_MAP_ID, BOREL_MEASURABLE_MAP_CONST, BOREL_MEASURABLE_MAP_EQ,
           BOREL_MEASURABLE_MAP_COMPOSE, BOREL_MEASURABLE_MAP_FROM_SUBTOPOLOGY,
           BOREL_MEASURABLE_MAP_INTO_SUBTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- Metric spaces; distance; open ball; submetric.  (metric.ml 11976-12206)   -/
/- ------------------------------------------------------------------------- -/

structure MetricSpace where
  is_metric_space : thm
  IS_METRIC_SPACE : thm
  metric_tybij : thm
  IS_METRIC_SPACE_SUBSPACE : thm
  mspace : thm
  mdist : thm
  METRIC : thm
  MSPACE : thm
  MDIST : thm
  MDIST_POS_LE : thm
  MDIST_0 : thm
  MDIST_SYM : thm
  MDIST_TRIANGLE : thm
  REAL_ABS_MDIST : thm
  MDIST_POS_LT : thm
  MDIST_REFL : thm
  MDIST_POS_EQ : thm
  MDIST_REVERSE_TRIANGLE : thm
  mball : thm
  IN_MBALL : thm
  CENTRE_IN_MBALL : thm
  CENTRE_IN_MBALL_EQ : thm
  MBALL_SUBSET_MSPACE : thm
  MBALL_EMPTY : thm
  MBALL_EMPTY_ALT : thm
  MBALL_EQ_EMPTY : thm
  MBALL_SUBSET : thm
  DISJOINT_MBALL : thm
  MBALL_SUBSET_CONCENTRIC : thm
  submetric : thm
  SUBMETRIC : thm
  MBALL_SUBMETRIC_EQ : thm
  MBALL_SUBMETRIC : thm
  SUBMETRIC_UNIV : thm
  SUBMETRIC_SUBMETRIC : thm
  SUBMETRIC_MSPACE : thm
  SUBMETRIC_RESTRICT : thm
  deriving Inhabited

@[nospecialize]
def setupMetricSpace [HolBase] (D : MetricDeps) (BTactics : Tactics) :
    ExceptT String IO MetricSpace := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_RULE,
        SET_TAC, FIX_TAC, INTRO_TAC, new_definition, new_type_definition, .. } := D
  let { CONJ_ACI, DISJOINT, EXTENSION, .. } := D.core1
  let { INTER_COMM, INTER_UNIV, IN_ELIM_THM, IN_INTER, NOT_IN_EMPTY, REAL_ABS_BOUNDS,
        .. } := D.core2
  let { REAL_ABS_REFL, REAL_ADD_RID, REAL_LET_TRANS, REAL_LE_ANTISYM, REAL_LE_SUB_RADD,
        REAL_LTE_TRANS, REAL_LT_LE, REAL_LT_REFL, REAL_NOT_LE, .. } := D.core3
  let { SUBSET, real_gt, .. } := D.core4
  let { FORALL_AND_THM, FORALL_PAIR_THM, FST, SND, .. } := D.core5
  let { CLAIM_TAC, CUT_TAC, .. } := BTactics
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let is_metric_space ← new_definition
    r"is_metric_space (s,d) <=>
   (!x y:A. x IN s /\ y IN s ==> &0 <= d(x,y)) /\
   (!x y. x IN s /\ y IN s ==> (d(x,y) = &0 <=> x = y)) /\
   (!x y. x IN s /\ y IN s ==> d(x,y) = d(y,x)) /\
   (!x y z. x IN s /\ y IN s /\ z IN s ==> d(x,z) <= d(x,y) + d(y,z))"

  let IS_METRIC_SPACE ← prove
   r"!s d:A#A->real.
        is_metric_space (s,d) <=>
        (!x y. x IN s /\ y IN s ==> (d(x,y) = &0 <=> x = y)) /\
        (!x y z.
              x IN s /\ y IN s /\ z IN s ==> d(x,z) <= d(y,x) + d(y,z))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [is_metric_space] THEN
    EQ_TAC THENL [MESON_TAC [], STRIP_TAC THEN ASM_REWRITE_TAC []] THEN
    MATCH_MP_TAC (← TAUT (← q r"(q ==> r) /\ p /\ q ==> p /\ q /\ r")) THEN
    REPEAT CONJ_TAC THENL
     [ASM_MESON_TAC [],
      ONCE_REWRITE_TAC [← REAL_ARITH (← q r"&0 <= x <=> &0 <= x + x")] THEN
      ASM_MESON_TAC [],
      REWRITE_TAC [← GSYM REAL_LE_ANTISYM] THEN ASM_MESON_TAC [REAL_ADD_RID]])

  let metric_tybij ← new_type_definition "metric" ("metric", "dest_metric")
   (← prove
    r"?m:(A->bool)#(A#A->real). is_metric_space m"
    (EXISTS_TAC (← q r"({}:A->bool,(\p:A#A. &0))") THEN
     REWRITE_TAC [is_metric_space, NOT_IN_EMPTY]))

  let IS_METRIC_SPACE_SUBSPACE ← prove
   r"!(s:A->bool) d. is_metric_space (s,d) ==>
                   (! s'. s' SUBSET s ==> is_metric_space (s',d))"
   (SIMP_TAC [SUBSET, is_metric_space])

  let mspace ← new_definition
    r"!m:A metric. mspace m = FST (dest_metric m)"

  let mdist ← new_definition
    r"!m:A metric. mdist m = SND (dest_metric m)"

  let METRIC ← prove
   r"!s d. is_metric_space (s:A->bool,d)
         ==> mspace (metric (s,d)) = s /\
             mdist (metric (s,d)) = d"
   (REWRITE_TAC [mspace, mdist] THEN MESON_TAC [metric_tybij, FST, SND])

  let MSPACE ← prove
   r"!s:A->bool d. is_metric_space (s,d) ==> mspace (metric (s,d)) = s"
   (SIMP_TAC [METRIC])

  let MDIST ← prove
   r"!s:A->bool d. is_metric_space (s,d) ==> mdist (metric (s,d)) = d"
   (SIMP_TAC [METRIC])

  let [MDIST_POS_LE, MDIST_0, MDIST_SYM, MDIST_TRIANGLE] ← (do
      let FORALL_METRIC_THM ← prove
       r"!P. (!m. P m) <=>
           (!s:A->bool d. is_metric_space(s,d) ==> P(metric (s,d)))"
       (REWRITE_TAC [← GSYM FORALL_PAIR_THM, metric_tybij] THEN
        MESON_TAC [← CONJUNCT1 metric_tybij])
      let METRIC_AXIOMS :=
       (r"!m. (!x y:A. x IN mspace m /\ y IN mspace m
                    ==> &0 <= mdist m (x,y)) /\
           (!x y. x IN mspace m /\ y IN mspace m
                  ==> (mdist m (x,y) = &0 <=> x = y)) /\
           (!x y. x IN mspace m /\ y IN mspace m
                  ==> mdist m (x,y) = mdist m (y,x)) /\
           (!x y z. x IN mspace m /\ y IN mspace m /\ z IN mspace m
                    ==> mdist m (x,z) <= mdist m (x,y) + mdist m (y,z))",
        SIMP_TAC [FORALL_METRIC_THM, MSPACE, MDIST, is_metric_space])
      pure (CONJUNCTS (← REWRITE_RULE [FORALL_AND_THM]
        (← prove METRIC_AXIOMS.1 METRIC_AXIOMS.2))) : ExceptT String IO (List thm))
    | throw "MDIST_POS_LE: CONJUNCTS"

  let REAL_ABS_MDIST ← prove
   r"!m x y:A. x IN mspace m /\ y IN mspace m
             ==> abs(mdist m (x,y)) = mdist m (x,y)"
   (SIMP_TAC [REAL_ABS_REFL, MDIST_POS_LE])

  let MDIST_POS_LT ← prove
   r"!m x y:A. x IN mspace m /\ y IN mspace m /\ ~(x=y)
             ==> &0 < mdist m (x,y)"
   (SIMP_TAC [REAL_LT_LE, MDIST_POS_LE] THEN MESON_TAC [MDIST_0])

  let MDIST_REFL ← prove
   r"!m x:A. x IN mspace m ==> mdist m (x,x) = &0"
   (SIMP_TAC [MDIST_0])

  let MDIST_POS_EQ ← prove
   r"!m x y:A.
        x IN mspace m /\ y IN mspace m
        ==> (&0 < mdist m (x,y) <=> ~(x = y))"
   (MESON_TAC [MDIST_POS_LT, MDIST_REFL, REAL_LT_REFL])

  let MDIST_REVERSE_TRIANGLE ← prove
   r"!m x y z:A. x IN mspace m /\ y IN mspace m /\ z IN mspace m
               ==> abs(mdist m (x,y) - mdist m (y,z)) <= mdist m (x,z)"
   (GEN_TAC THEN
    CLAIM_TAC "rmk"
      (← q r"!x y z:A. x IN mspace m /\ y IN mspace m /\ z IN mspace m
                 ==> mdist m (x,y) - mdist m (y,z) <= mdist m (x,z)") THEN
    REPEAT STRIP_TAC THENL
    [REWRITE_TAC [REAL_LE_SUB_RADD] THEN ASM_MESON_TAC [MDIST_TRIANGLE, MDIST_SYM],
     REWRITE_TAC [REAL_ABS_BOUNDS,
                  ← REAL_ARITH (← q r"!a b c. --a <= b - c <=> c - a <= b")] THEN
     ASM_MESON_TAC [MDIST_SYM]])

  let mball ← new_definition
    r"mball m (x:A,r) =
   {y | x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < r}"

  let IN_MBALL ← prove
   r"!m x y:A r.
     y IN mball m (x,r) <=>
     x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < r"
   (REWRITE_TAC [mball, IN_ELIM_THM])

  let CENTRE_IN_MBALL ← prove
   r"!m x:A r. &0 < r /\ x IN mspace m ==> x IN mball m (x,r)"
   (SIMP_TAC [IN_MBALL, MDIST_REFL, real_gt])

  let CENTRE_IN_MBALL_EQ ← prove
   r"!m x:A r. x IN mball m (x,r) <=> x IN mspace m /\ &0 < r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_MBALL] THEN
    ASM_CASES_TAC (← q r"x:A IN mspace m") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [MDIST_REFL])

  let MBALL_SUBSET_MSPACE ← prove
   r"!m (x:A) r. mball m (x,r) SUBSET mspace m"
   (SIMP_TAC [SUBSET, IN_MBALL])

  let MBALL_EMPTY ← prove
   r"!m x:A r. r <= &0 ==> mball m (x,r) = {}"
   (REWRITE_TAC [IN_MBALL, EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [MDIST_POS_LE, ← REAL_ARITH (← q r"!x. ~(r <= &0 /\ &0 <= x /\ x < r)")])

  let MBALL_EMPTY_ALT ← prove
   r"!m x:A r. ~(x IN mspace m) ==> mball m (x,r) = {}"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY, IN_MBALL] THEN MESON_TAC [])

  let MBALL_EQ_EMPTY ← prove
   r"!m x:A r. mball m (x,r) = {} <=> ~(x IN mspace m) \/ r <= &0"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
    [MP_TAC CENTRE_IN_MBALL THEN REWRITE_TAC [← GSYM REAL_NOT_LE] THEN SET_TAC [],
     STRIP_TAC THEN ASM_SIMP_TAC [MBALL_EMPTY, MBALL_EMPTY_ALT]])

  let MBALL_SUBSET ← prove
   r"!m x y:A a b. y IN mspace m /\ mdist m (x,y) + a <= b
                 ==> mball m (x,a) SUBSET mball m (y,b)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"x:A IN mspace m") THENL
    [STRIP_TAC, ASM SET_TAC [MBALL_EMPTY_ALT]] THEN
    ASM_REWRITE_TAC [SUBSET, IN_MBALL] THEN FIX_TAC "[z]" THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CUT_TAC (← q r"mdist m (y,z) <= mdist m (x:A,y) + mdist m (x,z)") THENL
    [ASM_REAL_ARITH_TAC, ASM_MESON_TAC [MDIST_SYM, MDIST_TRIANGLE]])

  let DISJOINT_MBALL ← prove
   r"!m x:A x' r r'. r + r' <= mdist m (x,x')
             ==> DISJOINT (mball m (x,r)) (mball m (x',r'))"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, IN_MBALL,
                 NOT_IN_EMPTY, CONJ_ACI] THEN
    INTRO_TAC "!m x x' r r'; HPrr'; !x''; x x' x'' d1 d2" THEN
    SUBGOAL_THEN (← q r"mdist m (x:A,x') < r + r'")
      (fun th => ASM_MESON_TAC [th, REAL_NOT_LE]) THEN
    TRANS_TAC REAL_LET_TRANS (← q r"mdist m (x:A,x'') + mdist m (x'',x')") THEN
    ASM_SIMP_TAC [MDIST_TRIANGLE, MDIST_SYM] THEN
    HYP (MP_TAC o end_itlist CONJ) "d1 d2" [] THEN REAL_ARITH_TAC)

  let MBALL_SUBSET_CONCENTRIC ← prove
   r"!m (x:A) r1 r2. r1 <= r2 ==> mball m (x,r1) SUBSET mball m (x,r2)"
   (SIMP_TAC [SUBSET, IN_MBALL] THEN MESON_TAC [REAL_LTE_TRANS])

  let submetric ← new_definition
    r"submetric (m:A metric) s = metric (s INTER mspace m, mdist m)"

  let SUBMETRIC ← prove
   r"(!m:A metric s. mspace (submetric m s) = s INTER mspace m) /\
   (!m:A metric s. mdist (submetric m s) = mdist m)"
   (CLAIM_TAC "metric"
      (← q r"!m:A metric s. is_metric_space (s INTER mspace m, mdist m)") THENL
    [REWRITE_TAC [is_metric_space, IN_INTER] THEN
     SIMP_TAC [MDIST_POS_LE, MDIST_0, MDIST_SYM, MDIST_TRIANGLE],
     ASM_SIMP_TAC [submetric, MSPACE, MDIST]])

  let MBALL_SUBMETRIC_EQ ← prove
   r"!m s a:A r. mball (submetric m s) (a,r) =
               if a IN s then s INTER mball m (a,r) else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [EXTENSION, IN_INTER, IN_MBALL, SUBMETRIC] THEN
    SET_TAC [])

  let MBALL_SUBMETRIC ← prove
   r"!m s x:A r. x IN s ==> mball (submetric m s) (x,r) = mball m (x,r) INTER s"
   (SIMP_TAC [MBALL_SUBMETRIC_EQ, INTER_COMM])

  let SUBMETRIC_UNIV ← prove
   r"submetric m (:A) = m"
   (REWRITE_TAC [submetric, INTER_UNIV, mspace, mdist, metric_tybij])

  let SUBMETRIC_SUBMETRIC ← prove
   r"!m s t:A->bool.
        submetric (submetric m s) t = submetric m (s INTER t)"
   (REPEAT GEN_TAC THEN ONCE_REWRITE_TAC [submetric] THEN
    REWRITE_TAC [SUBMETRIC] THEN
    REWRITE_TAC [← sr r"(s INTER t) INTER m = t INTER s INTER m"])

  let SUBMETRIC_MSPACE ← prove
   r"!m:A metric. submetric m (mspace m) = m"
   (GEN_TAC THEN REWRITE_TAC [submetric, ← sr r"s INTER s = s"] THEN
    GEN_REWRITE_TAC RAND_CONV [← GSYM (← CONJUNCT1 metric_tybij)] THEN
    REWRITE_TAC [mspace, mdist])

  let SUBMETRIC_RESTRICT ← prove
   r"!m s:A->bool. submetric m s = submetric m (mspace m INTER s)"
   (REPEAT GEN_TAC THEN
    GEN_REWRITE_TAC (LAND_CONV o LAND_CONV) [← GSYM SUBMETRIC_MSPACE] THEN
    REWRITE_TAC [SUBMETRIC_SUBMETRIC])

  return { is_metric_space, IS_METRIC_SPACE, metric_tybij, IS_METRIC_SPACE_SUBSPACE, mspace,
           mdist, METRIC, MSPACE, MDIST, MDIST_POS_LE, MDIST_0, MDIST_SYM, MDIST_TRIANGLE,
           REAL_ABS_MDIST, MDIST_POS_LT, MDIST_REFL, MDIST_POS_EQ, MDIST_REVERSE_TRIANGLE,
           mball, IN_MBALL, CENTRE_IN_MBALL, CENTRE_IN_MBALL_EQ, MBALL_SUBSET_MSPACE,
           MBALL_EMPTY, MBALL_EMPTY_ALT, MBALL_EQ_EMPTY, MBALL_SUBSET, DISJOINT_MBALL,
           MBALL_SUBSET_CONCENTRIC, submetric, SUBMETRIC, MBALL_SUBMETRIC_EQ, MBALL_SUBMETRIC,
           SUBMETRIC_UNIV, SUBMETRIC_SUBMETRIC, SUBMETRIC_MSPACE, SUBMETRIC_RESTRICT }

/- ------------------------------------------------------------------------- -/
/- Metric topology.  (metric.ml 12207-12583)                                 -/
/- ------------------------------------------------------------------------- -/

structure MTopology where
  mtopology : thm
  IS_TOPOLOGY_METRIC_TOPOLOGY : thm
  OPEN_IN_MTOPOLOGY : thm
  TOPSPACE_MTOPOLOGY : thm
  SUBTOPOLOGY_MSPACE : thm
  OPEN_IN_MSPACE : thm
  CLOSED_IN_MSPACE : thm
  OPEN_IN_MBALL : thm
  MTOPOLOGY_SUBMETRIC : thm
  METRIC_INJECTIVE_IMAGE : thm
  MTOPOLOGY_BASE : thm
  CLOSED_IN_METRIC : thm
  mcball : thm
  IN_MCBALL : thm
  CENTRE_IN_MCBALL : thm
  CENTRE_IN_MCBALL_EQ : thm
  MCBALL_EQ_EMPTY : thm
  MCBALL_EMPTY : thm
  MCBALL_EMPTY_ALT : thm
  MCBALL_SUBSET_MSPACE : thm
  MBALL_SUBSET_MCBALL : thm
  MCBALL_SUBSET : thm
  MCBALL_SUBSET_CONCENTRIC : thm
  MCBALL_SUBSET_MBALL : thm
  MCBALL_SUBSET_MBALL_CONCENTRIC : thm
  CLOSED_IN_MCBALL : thm
  MCBALL_SUBMETRIC_EQ : thm
  MCBALL_SUBMETRIC : thm
  msphere : thm
  OPEN_IN_MTOPOLOGY_MCBALL : thm
  METRIC_DERIVED_SET_OF : thm
  METRIC_CLOSURE_OF : thm
  METRIC_CLOSURE_OF_ALT : thm
  METRIC_INTERIOR_OF : thm
  METRIC_INTERIOR_OF_ALT : thm
  IN_INTERIOR_OF_MBALL : thm
  IN_INTERIOR_OF_MCBALL : thm
  deriving Inhabited

@[nospecialize]
def setupMTopology [HolBase] (D : MetricDeps) (BTactics : Tactics) (BTopology : Topology)
    (BSubtopology : Subtopology) (BBases : Bases) (BDerived : Derived) (BClosure : Closure)
    (BInterior : Interior) (BMetricSpace : MetricSpace) : ExceptT String IO MTopology := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        DESTRUCT_TAC, FIX_TAC, INTRO_TAC, HYP_TAC, IMP_REWRITE_TAC, SUBST_VAR_TAC,
        new_definition, .. } := D
  let { DIFF, DISJOINT, DISJOINT_EMPTY, EMPTY_SUBSET, EXISTS_IN_GSPEC, EXTENSION,
        FORALL_IN_GSPEC, FORALL_IN_IMAGE, .. } := D.core1
  let { IN, INJECTIVE_ON_ALT, INTER_COMM, IN_DIFF, IN_ELIM_THM, IN_INTER, IN_UNIONS,
        MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_TRANS, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_MIN, REAL_MIN_MIN,
        REAL_NOT_LE, REAL_NOT_LT, .. } := D.core3
  let { SUBSET, SUBSET_ANTISYM, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, .. } := D.core4
  let { DE_MORGAN_THM, MONO_AND, PAIR_EQ, .. } := D.core5
  let { REAL_HALF, .. } := D.misc
  let { CUT_TAC, .. } := BTactics
  let { CLOSED_IN_TOPSPACE, OPEN_IN_EMPTY, OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, TOPOLOGY_EQ,
        closed_in, istopology, topology_tybij, topspace, .. } := BTopology
  let { OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_TOPSPACE, .. } := BSubtopology
  let { TOPOLOGY_BASE_UNIQUE, .. } := BBases
  let { derived_set_of, .. } := BDerived
  let { closure_of, .. } := BClosure
  let { INTERIOR_OF_CLOSURE_OF, .. } := BInterior
  let { CENTRE_IN_MBALL, CENTRE_IN_MBALL_EQ, IN_MBALL, MBALL_EMPTY, MBALL_SUBMETRIC,
        MBALL_SUBSET_CONCENTRIC, MBALL_SUBSET_MSPACE, MDIST_0, MDIST_POS_LE, MDIST_REFL,
        MDIST_SYM, MDIST_TRIANGLE, SUBMETRIC, is_metric_space, mdist, metric_tybij, mspace,
        .. } := BMetricSpace
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let mtopology ← new_definition
    r"mtopology (m:A metric) =
   topology {u | u SUBSET mspace m /\
                 !x:A. x IN u ==> ?r. &0 < r /\ mball m (x,r) SUBSET u}"

  let IS_TOPOLOGY_METRIC_TOPOLOGY ← prove
   r"istopology {u | u SUBSET mspace m /\
                   !x:A. x IN u ==> ?r. &0 < r /\ mball m (x,r) SUBSET u}"
   (REWRITE_TAC [istopology, IN_ELIM_THM, NOT_IN_EMPTY, EMPTY_SUBSET] THEN
    CONJ_TAC THENL
    [INTRO_TAC "!s t; (s shp) (t thp)" THEN CONJ_TAC THENL
     [HYP SET_TAC "s t" [], ALL_TAC] THEN
     REWRITE_TAC [IN_INTER] THEN INTRO_TAC "!x; sx tx" THEN
     REMOVE_THEN "shp"
       (DESTRUCT_TAC "@r1. r1 rs" o C MATCH_MP (← ASSUME (← q r"x:A IN s"))) THEN
     REMOVE_THEN "thp"
       (DESTRUCT_TAC "@r2. r2 rt" o C MATCH_MP (← ASSUME (← q r"x:A IN t"))) THEN
     EXISTS_TAC (← q r"min r1 r2") THEN
     ASM_REWRITE_TAC [REAL_LT_MIN, SUBSET_INTER] THEN
     ASM_MESON_TAC [REAL_MIN_MIN, MBALL_SUBSET_CONCENTRIC, SUBSET_TRANS],
     REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_UNIONS] THEN MESON_TAC []])

  let OPEN_IN_MTOPOLOGY ← prove
   r"!m:A metric u.
     open_in (mtopology m) u <=>
     u SUBSET mspace m /\
     (!x. x IN u ==> ?r. &0 < r /\ mball m (x,r) SUBSET u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mtopology] THEN
    (SUBST1_TAC o REWRITE_RULE [IS_TOPOLOGY_METRIC_TOPOLOGY] o
    SPEC (← q r"{u | u SUBSET mspace m /\
               !x:A. x IN u ==> ?r. &0 < r /\ mball m (x,r) SUBSET u}") o
    CONJUNCT2)
    topology_tybij THEN
    GEN_REWRITE_TAC LAND_CONV [← GSYM IN] THEN REWRITE_TAC [IN_ELIM_THM])

  let TOPSPACE_MTOPOLOGY ← prove
   r"!m:A metric. topspace (mtopology m) = mspace m"
   (GEN_TAC THEN REWRITE_TAC [mtopology, topspace] THEN
    (SUBST1_TAC o REWRITE_RULE [IS_TOPOLOGY_METRIC_TOPOLOGY] o
    SPEC (← q r"{u | u SUBSET mspace m /\
               !x:A. x IN u ==> ?r. &0 < r /\ mball m (x,r) SUBSET u}") o
    CONJUNCT2)
    topology_tybij THEN
    REWRITE_TAC [EXTENSION, IN_UNIONS, IN_ELIM_THM] THEN GEN_TAC THEN EQ_TAC THENL
    [SET_TAC [], ALL_TAC] THEN
    INTRO_TAC "x" THEN EXISTS_TAC (← q r"mspace (m:A metric)") THEN
    ASM_REWRITE_TAC [MBALL_SUBSET_MSPACE, SUBSET_REFL] THEN
    MESON_TAC [REAL_LT_01])

  let SUBTOPOLOGY_MSPACE ← prove
   r"!m:A metric. subtopology (mtopology m) (mspace m) = mtopology m"
   (REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, SUBTOPOLOGY_TOPSPACE])

  let OPEN_IN_MSPACE ← prove
   r"!m:A metric. open_in (mtopology m) (mspace m)"
   (REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, OPEN_IN_TOPSPACE])

  let CLOSED_IN_MSPACE ← prove
   r"!m:A metric. closed_in (mtopology m) (mspace m)"
   (REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, CLOSED_IN_TOPSPACE])

  let OPEN_IN_MBALL ← prove
   r"!m (x:A) r. open_in (mtopology m) (mball m (x,r))"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"&0 < (r:real)") THENL
    [ALL_TAC, ASM_SIMP_TAC [MBALL_EMPTY, ← GSYM REAL_NOT_LT, OPEN_IN_EMPTY]] THEN
    REWRITE_TAC [OPEN_IN_MTOPOLOGY, MBALL_SUBSET_MSPACE, IN_MBALL, SUBSET] THEN
    INTRO_TAC "![y]; x y xy" THEN ASM_REWRITE_TAC [] THEN
    EXISTS_TAC (← q r"r - mdist m (x:A,y)") THEN CONJ_TAC THENL
    [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    INTRO_TAC "![z]; z lt" THEN ASM_REWRITE_TAC [] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"mdist m (x:A,y) + mdist m (y,z)") THEN
    ASM_SIMP_TAC [MDIST_TRIANGLE] THEN ASM_REAL_ARITH_TAC)

  let MTOPOLOGY_SUBMETRIC ← prove
   r"!m:A metric s. mtopology (submetric m s) = subtopology (mtopology m) s"
   (REWRITE_TAC [TOPOLOGY_EQ] THEN INTRO_TAC "!m s [u]" THEN
    EQ_TAC THEN INTRO_TAC "hp" THENL
    [REWRITE_TAC [OPEN_IN_SUBTOPOLOGY] THEN
     EXISTS_TAC
       (← q r"UNIONS {mball m (c:A,r) | c,r | mball m (c,r) INTER s SUBSET u}") THEN
     CONJ_TAC THENL
     [MATCH_MP_TAC OPEN_IN_UNIONS THEN REWRITE_TAC [IN_ELIM_THM] THEN
      INTRO_TAC "![t]; @c r. sub t" THEN REMOVE_THEN "t" SUBST_VAR_TAC THEN
      MATCH_ACCEPT_TAC OPEN_IN_MBALL,
      MATCH_MP_TAC SUBSET_ANTISYM THEN CONJ_TAC THENL [ALL_TAC, SET_TAC []] THEN
      HYP_TAC "hp: (us um) hp"
        (REWRITE_RULE [OPEN_IN_MTOPOLOGY, SUBMETRIC, SUBSET_INTER]) THEN
      ASM_REWRITE_TAC [SUBSET_INTER] THEN REWRITE_TAC [SUBSET] THEN
      INTRO_TAC "!x; x" THEN
      USE_THEN "x" (HYP_TAC "hp: @r. rpos sub" o C MATCH_MP) THEN
      REWRITE_TAC [IN_UNIONS, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"mball m (x:A,r)") THEN
      CONJ_TAC THENL
      [REWRITE_TAC [IN_ELIM_THM] THEN MAP_EVERY EXISTS_TAC [← q r"x:A", ← q r"r:real"] THEN
       IMP_REWRITE_TAC [← GSYM MBALL_SUBMETRIC] THEN ASM SET_TAC [],
       MATCH_MP_TAC CENTRE_IN_MBALL THEN ASM SET_TAC []]],
     ALL_TAC] THEN
    REWRITE_TAC [OPEN_IN_MTOPOLOGY, SUBMETRIC, SUBSET_INTER] THEN
    HYP_TAC "hp: @t. t u" (REWRITE_RULE [OPEN_IN_SUBTOPOLOGY]) THEN
    REMOVE_THEN "u" SUBST_VAR_TAC THEN
    HYP_TAC "t: tm r" (REWRITE_RULE [OPEN_IN_MTOPOLOGY]) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [IN_INTER] THEN INTRO_TAC "!x; xt xs" THEN
    USE_THEN "xt" (HYP_TAC "r: @r. rpos sub" o C MATCH_MP) THEN
    EXISTS_TAC (← q r"r:real") THEN IMP_REWRITE_TAC [MBALL_SUBMETRIC] THEN
    ASM SET_TAC [])

  let METRIC_INJECTIVE_IMAGE ← prove
   r"!(f:A->B) m s.
        IMAGE f s SUBSET mspace m /\
        (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
        ==> (mspace(metric(s,\(x,y). mdist m (f x,f y))) = s) /\
            (mdist(metric(s,\(x,y). mdist m (f x,f y))) =
             \(x,y). mdist m (f x,f y))"
   (REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, INJECTIVE_ON_ALT] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN
    REWRITE_TAC [mspace, mdist, ← GSYM PAIR_EQ] THEN
    REWRITE_TAC [← GSYM (← CONJUNCT2 metric_tybij), is_metric_space] THEN
    REWRITE_TAC [← GSYM mspace, ← GSYM mdist] THEN
    ASM_SIMP_TAC [MDIST_POS_LE, MDIST_TRIANGLE, MDIST_0] THEN
    ASM_MESON_TAC [MDIST_SYM])

  let MTOPOLOGY_BASE ← prove
   r"!m:A metric.
      mtopology m =
      topology(ARBITRARY UNION_OF
                 {mball m (x,r) |x,r| x IN mspace m /\ &0 < r})"
   (GEN_TAC THEN CONV_TAC SYM_CONV THEN MATCH_MP_TAC TOPOLOGY_BASE_UNIQUE THEN
    REWRITE_TAC [← sr r"GSPEC s x <=> x IN GSPEC s"] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, EXISTS_IN_GSPEC, OPEN_IN_MBALL] THEN
    REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"x:A") THEN FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MONO_EXISTS THEN
    ASM_MESON_TAC [CENTRE_IN_MBALL, SUBSET])

  let CLOSED_IN_METRIC ← prove
   r"!m c:A->bool.
     closed_in (mtopology m) c <=>
     c SUBSET mspace m /\
     (!x. x IN mspace m DIFF c ==> ?r. &0 < r /\ DISJOINT c (mball m (x,r)))"
   (REWRITE_TAC [closed_in, OPEN_IN_MTOPOLOGY, DISJOINT, TOPSPACE_MTOPOLOGY] THEN
    MP_TAC MBALL_SUBSET_MSPACE THEN ASM SET_TAC [])

  let mcball ← new_definition
    r"mcball m (x:A,r) =
   {y | x IN mspace m /\ y IN mspace m /\ mdist m (x,y) <= r}"

  let IN_MCBALL ← prove
   r"!m (x:A) r y.
     y IN mcball m (x,r) <=>
     x IN mspace m /\ y IN mspace m /\ mdist m (x,y) <= r"
   (REWRITE_TAC [mcball, IN_ELIM_THM])

  let CENTRE_IN_MCBALL ← prove
   r"!m x:A r. &0 <= r /\ x IN mspace m ==> x IN mcball m (x,r)"
   (SIMP_TAC [IN_MCBALL, MDIST_REFL])

  let CENTRE_IN_MCBALL_EQ ← prove
   r"!m x:A r. x IN mcball m (x,r) <=> x IN mspace m /\ &0 <= r"
   (REPEAT GEN_TAC THEN REWRITE_TAC [IN_MCBALL] THEN
    ASM_CASES_TAC (← q r"x:A IN mspace m") THEN ASM_SIMP_TAC [MDIST_REFL])

  let MCBALL_EQ_EMPTY ← prove
   r"!m x:A r. mcball m (x,r) = {} <=> ~(x IN mspace m) \/ r < &0"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [EXTENSION, IN_MCBALL, IN_ELIM_THM, NOT_IN_EMPTY] THEN
    ASM_MESON_TAC [REAL_NOT_LT, REAL_LE_TRANS, MDIST_POS_LE, MDIST_REFL])

  let MCBALL_EMPTY ← prove
   r"!m (x:A) r. r < &0 ==> mcball m (x,r) = {}"
   (SIMP_TAC [MCBALL_EQ_EMPTY])

  let MCBALL_EMPTY_ALT ← prove
   r"!m (x:A) r. ~(x IN mspace m) ==> mcball m (x,r) = {}"
   (SIMP_TAC [MCBALL_EQ_EMPTY])

  let MCBALL_SUBSET_MSPACE ← prove
   r"!m (x:A) r. mcball m (x,r) SUBSET (mspace m)"
   (REWRITE_TAC [mcball, SUBSET, IN_ELIM_THM] THEN MESON_TAC [])

  let MBALL_SUBSET_MCBALL ← prove
   r"!m x:A r. mball m (x,r) SUBSET mcball m (x,r)"
   (SIMP_TAC [SUBSET, IN_MBALL, IN_MCBALL, REAL_LT_IMP_LE])

  let MCBALL_SUBSET ← prove
   r"!m x y:A a b. y IN mspace m /\ mdist m (x,y) + a <= b
                 ==> mcball m (x,a) SUBSET mcball m (y,b)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"x:A IN mspace m") THENL
    [STRIP_TAC, ASM SET_TAC [MCBALL_EMPTY_ALT]] THEN
    ASM_REWRITE_TAC [SUBSET, IN_MCBALL] THEN FIX_TAC "[z]" THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    CUT_TAC (← q r"mdist m (y,z) <= mdist m (x:A,y) + mdist m (x,z)") THENL
    [ASM_REAL_ARITH_TAC, ASM_MESON_TAC [MDIST_SYM, MDIST_TRIANGLE]])

  let MCBALL_SUBSET_CONCENTRIC ← prove
   r"!m (x:A) a b. a <= b ==> mcball m (x,a) SUBSET mcball m (x,b)"
   (SIMP_TAC [SUBSET, IN_MCBALL] THEN MESON_TAC [REAL_LE_TRANS])

  let MCBALL_SUBSET_MBALL ← prove
   r"!m x y:A a b.
     y IN mspace m /\ mdist m (x,y) + a < b
     ==> mcball m (x,a) SUBSET mball m (y,b)"
   (INTRO_TAC "!m x y a b; y lt" THEN ASM_CASES_TAC (← q r"x:A IN mspace m") THENL
    [POP_ASSUM (LABEL_TAC "x"),
     ASM_SIMP_TAC [MCBALL_EMPTY_ALT, EMPTY_SUBSET]] THEN
    ASM_REWRITE_TAC [SUBSET, IN_MCBALL, IN_MBALL] THEN
    INTRO_TAC "![z]; z le" THEN HYP REWRITE_TAC "z" [] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"mdist m (y:A,x) + mdist m (x,z)") THEN
    ASM_SIMP_TAC [MDIST_TRIANGLE] THEN
    TRANS_TAC REAL_LET_TRANS (← q r"mdist m (x:A,y) + a") THEN
    HYP REWRITE_TAC "lt" [] THEN HYP SIMP_TAC "x y" [MDIST_SYM] THEN
    ASM_REAL_ARITH_TAC)

  let MCBALL_SUBSET_MBALL_CONCENTRIC ← prove
   r"!m x:A a b. a < b ==> mcball m (x,a) SUBSET mball m (x,b)"
   (INTRO_TAC "!m x a b; lt" THEN ASM_CASES_TAC (← q r"x:A IN mspace m") THENL
    [POP_ASSUM (LABEL_TAC "x"),
     ASM_SIMP_TAC [MCBALL_EMPTY_ALT, EMPTY_SUBSET]] THEN
    MATCH_MP_TAC MCBALL_SUBSET_MBALL THEN ASM_SIMP_TAC [MDIST_REFL] THEN
    ASM_REAL_ARITH_TAC)

  let CLOSED_IN_MCBALL ← prove
   r"!m:A metric x r. closed_in (mtopology m) (mcball m (x,r))"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CLOSED_IN_METRIC, MCBALL_SUBSET_MSPACE, DIFF, IN_ELIM_THM,
                 IN_MCBALL, DE_MORGAN_THM, REAL_NOT_LE] THEN
    FIX_TAC "[y]" THEN
    MAP_EVERY ASM_CASES_TAC [← q r"x:A IN mspace m", ← q r"y:A IN mspace m"] THEN
    ASM_REWRITE_TAC [] THENL
    [ALL_TAC,
     ASM_SIMP_TAC [MCBALL_EMPTY_ALT, DISJOINT_EMPTY] THEN
     MESON_TAC [REAL_LT_01]] THEN
    INTRO_TAC "lt" THEN EXISTS_TAC (← q r"mdist m (x:A,y) - r") THEN
    CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ASM_REWRITE_TAC []] THEN
    REWRITE_TAC [EXTENSION, DISJOINT, IN_INTER, NOT_IN_EMPTY,
                 IN_MBALL, IN_MCBALL] THEN
    FIX_TAC "[z]" THEN ASM_CASES_TAC (← q r"z:A IN mspace m") THEN
    ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"mdist m (x,y) <= mdist m (x:A,z) + mdist m (z,y)") MP_TAC THENL
    [ASM_SIMP_TAC [MDIST_TRIANGLE], ALL_TAC] THEN
    ASM_SIMP_TAC [MDIST_SYM] THEN ASM_REAL_ARITH_TAC)

  let MCBALL_SUBMETRIC_EQ ← prove
   r"!m s a:A r. mcball (submetric m s) (a,r) =
               if a IN s then s INTER mcball m (a,r) else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [EXTENSION, IN_INTER, IN_MCBALL, SUBMETRIC] THEN
    SET_TAC [])

  let MCBALL_SUBMETRIC ← prove
   r"!m s x:A r.
     x IN s ==> mcball (submetric m s) (x,r) = mcball m (x,r) INTER s"
   (SIMP_TAC [MCBALL_SUBMETRIC_EQ, INTER_COMM])

  let msphere ← new_definition
    r"msphere m (x:A,e) = {y | mdist m (x,y) = e}"

  let OPEN_IN_MTOPOLOGY_MCBALL ← prove
   r"!m u. open_in (mtopology m) (u:A->bool) <=>
         u SUBSET mspace m /\
         (!x. x IN u ==> (?r. &0 < r /\ mcball m (x,r) SUBSET u))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"u:A->bool SUBSET mspace m") THEN
    ASM_REWRITE_TAC [] THEN EQ_TAC THENL
    [INTRO_TAC "hp; !x; x" THEN
     REMOVE_THEN "x" (HYP_TAC "hp: @r. rpos sub" o C MATCH_MP) THEN
     EXISTS_TAC (← q r"r / &2") THEN
     HYP REWRITE_TAC "rpos" [REAL_HALF] THEN
     TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A,r)") THEN HYP REWRITE_TAC "sub" [] THEN
     MATCH_MP_TAC MCBALL_SUBSET_MBALL_CONCENTRIC THEN
     ASM_REAL_ARITH_TAC,
     INTRO_TAC "hp; !x; x" THEN
     REMOVE_THEN "x" (HYP_TAC "hp: @r. rpos sub" o C MATCH_MP) THEN
     EXISTS_TAC (← q r"r:real") THEN HYP REWRITE_TAC "rpos" [] THEN
     TRANS_TAC SUBSET_TRANS (← q r"mcball m (x:A,r)") THEN
     HYP REWRITE_TAC "sub" [MBALL_SUBSET_MCBALL]])

  let METRIC_DERIVED_SET_OF ← prove
   r"!m s.
      mtopology m derived_set_of s =
      {x:A | x IN mspace m /\
            (!r. &0 < r ==> (?y. ~(y = x) /\ y IN s /\ y IN mball m (x,r)))}"
   (REWRITE_TAC [derived_set_of, TOPSPACE_MTOPOLOGY, OPEN_IN_MTOPOLOGY, EXTENSION,
                 IN_ELIM_THM] THEN
    REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"x:A IN mspace m") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (LABEL_TAC "x") THEN EQ_TAC THENL
    [INTRO_TAC "hp; !r; r" THEN HYP_TAC "hp: +" (SPEC (← q r"mball m (x:A,r)")) THEN
     ASM_REWRITE_TAC [CENTRE_IN_MBALL_EQ, MBALL_SUBSET_MSPACE] THEN
     DISCH_THEN MATCH_MP_TAC THEN HYP REWRITE_TAC "x" [IN_MBALL] THEN
     INTRO_TAC "![y]; y xy" THEN EXISTS_TAC (← q r"r - mdist m (x:A,y)") THEN
     CONJ_TAC THENL
     [REMOVE_THEN "xy" MP_TAC THEN REAL_ARITH_TAC,
      HYP REWRITE_TAC "x y" [SUBSET, IN_MBALL] THEN INTRO_TAC "![z]; z lt" THEN
      HYP REWRITE_TAC "z" [] THEN
      TRANS_TAC REAL_LET_TRANS (← q r"mdist m (x:A,y) + mdist m (y,z)") THEN
      ASM_SIMP_TAC [MDIST_TRIANGLE] THEN ASM_REAL_ARITH_TAC],
     INTRO_TAC "hp; !t; t inc r" THEN
     HYP_TAC "r: @r. r ball" (C MATCH_MP (← ASSUME (← q r"x:A IN t"))) THEN
     HYP_TAC "hp: @y. neq y dist" (C MATCH_MP (← ASSUME (← q r"&0 < r"))) THEN
     EXISTS_TAC (← q r"y:A") THEN HYP REWRITE_TAC "neq y" [] THEN
     ASM SET_TAC []])

  let METRIC_CLOSURE_OF ← prove
   r"!m s.
      mtopology m closure_of s =
      {x:A | x IN mspace m /\
            (!r. &0 < r ==> (?y. y IN s /\ y IN mball m (x,r)))}"
   (REWRITE_TAC [closure_of, TOPSPACE_MTOPOLOGY, OPEN_IN_MTOPOLOGY, EXTENSION,
                 IN_ELIM_THM] THEN
    REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"x:A IN mspace m") THEN ASM_REWRITE_TAC [] THEN
    POP_ASSUM (LABEL_TAC "x") THEN EQ_TAC THENL
    [INTRO_TAC "hp; !r; r" THEN HYP_TAC "hp: +" (SPEC (← q r"mball m (x:A,r)")) THEN
     ASM_REWRITE_TAC [CENTRE_IN_MBALL_EQ, MBALL_SUBSET_MSPACE] THEN
     DISCH_THEN MATCH_MP_TAC THEN HYP REWRITE_TAC "x" [IN_MBALL] THEN
     INTRO_TAC "![y]; y xy" THEN EXISTS_TAC (← q r"r - mdist m (x:A,y)") THEN
     CONJ_TAC THENL
     [REMOVE_THEN "xy" MP_TAC THEN REAL_ARITH_TAC,
      HYP REWRITE_TAC "x y" [SUBSET, IN_MBALL] THEN INTRO_TAC "![z]; z lt" THEN
      HYP REWRITE_TAC "z" [] THEN
      TRANS_TAC REAL_LET_TRANS (← q r"mdist m (x:A,y) + mdist m (y,z)") THEN
      ASM_SIMP_TAC [MDIST_TRIANGLE] THEN ASM_REAL_ARITH_TAC],
     INTRO_TAC "hp; !t; t inc r" THEN
     HYP_TAC "r: @r. r ball" (C MATCH_MP (← ASSUME (← q r"x:A IN t"))) THEN
     HYP_TAC "hp: @y. y dist" (C MATCH_MP (← ASSUME (← q r"&0 < r"))) THEN
     EXISTS_TAC (← q r"y:A") THEN HYP REWRITE_TAC "y" [] THEN
     ASM SET_TAC []])

  let METRIC_CLOSURE_OF_ALT ← prove
   r"!m s:A->bool.
      mtopology m closure_of s =
      {x | x IN mspace m /\
           !r. &0 < r ==> ?y. y IN s /\ y IN mcball m (x,r)}"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [EXTENSION, IN_ELIM_THM, METRIC_CLOSURE_OF] THEN
    X_GEN_TAC (← q r"x:A") THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    X_GEN_TAC (← q r"r:real") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"r / &2")) THEN
    ASM_REWRITE_TAC [REAL_HALF] THEN MATCH_MP_TAC MONO_EXISTS THEN
    X_GEN_TAC (← q r"y:A") THEN MATCH_MP_TAC MONO_AND THEN
    SIMP_TAC [IN_MBALL, IN_MCBALL] THEN ASM_REAL_ARITH_TAC)

  let METRIC_INTERIOR_OF ← prove
   r"!m s:A->bool.
        mtopology m interior_of s =
        {x | x IN mspace m /\ ?e. &0 < e /\ mball m (x,e) SUBSET s}"
   (REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, METRIC_CLOSURE_OF, TOPSPACE_MTOPOLOGY,
                 IN_DIFF, IN_MBALL, SUBSET] THEN
    SET_TAC [])

  let METRIC_INTERIOR_OF_ALT ← prove
   r"!m s:A->bool.
        mtopology m interior_of s =
        {x | x IN mspace m /\ ?e. &0 < e /\ mcball m (x,e) SUBSET s}"
   (REWRITE_TAC [INTERIOR_OF_CLOSURE_OF, METRIC_CLOSURE_OF_ALT, IN_DIFF,
                 IN_MCBALL, TOPSPACE_MTOPOLOGY, SUBSET] THEN
    SET_TAC [])

  let IN_INTERIOR_OF_MBALL ← prove
   r"!m s x:A.
        x IN (mtopology m) interior_of s <=>
        x IN mspace m /\
        ?e. &0 < e /\ mball m (x,e) SUBSET s"
   (REWRITE_TAC [METRIC_INTERIOR_OF, IN_ELIM_THM])

  let IN_INTERIOR_OF_MCBALL ← prove
   r"!m s x:A.
        x IN (mtopology m) interior_of s <=>
        x IN mspace m /\
        ?e. &0 < e /\ mcball m (x,e) SUBSET s"
   (REWRITE_TAC [METRIC_INTERIOR_OF_ALT, IN_ELIM_THM])

  return { mtopology, IS_TOPOLOGY_METRIC_TOPOLOGY, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY,
           SUBTOPOLOGY_MSPACE, OPEN_IN_MSPACE, CLOSED_IN_MSPACE, OPEN_IN_MBALL,
           MTOPOLOGY_SUBMETRIC, METRIC_INJECTIVE_IMAGE, MTOPOLOGY_BASE, CLOSED_IN_METRIC,
           mcball, IN_MCBALL, CENTRE_IN_MCBALL, CENTRE_IN_MCBALL_EQ, MCBALL_EQ_EMPTY,
           MCBALL_EMPTY, MCBALL_EMPTY_ALT, MCBALL_SUBSET_MSPACE, MBALL_SUBSET_MCBALL,
           MCBALL_SUBSET, MCBALL_SUBSET_CONCENTRIC, MCBALL_SUBSET_MBALL,
           MCBALL_SUBSET_MBALL_CONCENTRIC, CLOSED_IN_MCBALL, MCBALL_SUBMETRIC_EQ,
           MCBALL_SUBMETRIC, msphere, OPEN_IN_MTOPOLOGY_MCBALL, METRIC_DERIVED_SET_OF,
           METRIC_CLOSURE_OF, METRIC_CLOSURE_OF_ALT, METRIC_INTERIOR_OF,
           METRIC_INTERIOR_OF_ALT, IN_INTERIOR_OF_MBALL, IN_INTERIOR_OF_MCBALL }

/- ------------------------------------------------------------------------- -/
/- Bounded sets.  (metric.ml 12585-12735)                                    -/
/- ------------------------------------------------------------------------- -/

structure Bounded where
  mbounded : thm
  MBOUNDED_POS : thm
  MBOUNDED_ALT : thm
  MBOUNDED_ALT_POS : thm
  MBOUNDED_SUBSET : thm
  MBOUNDED_SUBSET_MSPACE : thm
  MBOUNDED : thm
  MBOUNDED_EMPTY : thm
  MBOUNDED_MCBALL : thm
  MBOUNDED_MBALL : thm
  MBOUNDED_INSERT : thm
  MBOUNDED_INTER : thm
  MBOUNDED_UNION : thm
  MBOUNDED_UNIONS : thm
  MBOUNDED_CLOSURE_OF : thm
  MBOUNDED_CLOSURE_OF_EQ : thm
  MBOUNDED_SUBMETRIC : thm
  deriving Inhabited

@[nospecialize]
def setupBounded [HolBase] (D : MetricDeps) (BTactics : Tactics) (BClosure : Closure)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) : ExceptT String IO Bounded := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, SET_TAC,
        INTRO_TAC, new_definition, .. } := D
  let { EMPTY_SUBSET, FINITE_INDUCT_STRONG, FORALL_IN_INSERT, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN_INSERT, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_INSERT_EMPTY, NOT_IN_EMPTY, .. } := D.core2
  let { REAL_LE_REFL, REAL_LE_TRANS, REAL_MAX_MAX, REAL_NOT_LE, .. } := D.core3
  let { SUBSET, SUBSET_REFL, SUBSET_TRANS, UNIONS_0, UNIONS_INSERT, UNION_SUBSET,
        .. } := D.core4
  let { DE_MORGAN_THM, .. } := D.core5
  let { CUT_TAC, .. } := BTactics
  let { CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET, .. } := BClosure
  let { MDIST_POS_LE, MDIST_SYM, MDIST_TRIANGLE, SUBMETRIC, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, MBALL_SUBSET_MCBALL, MCBALL_EMPTY, MCBALL_EMPTY_ALT,
        MCBALL_SUBSET, MCBALL_SUBSET_CONCENTRIC, MCBALL_SUBSET_MSPACE, TOPSPACE_MTOPOLOGY,
        .. } := BMTopology
  -- @@SCOPE END

  let mbounded ← new_definition
    r"mbounded m s <=> (?c:A b. s SUBSET mcball m (c,b))"

  let MBOUNDED_POS ← prove
   r"!m s:A->bool.
        mbounded m s <=> ?c b. &0 < b /\ s SUBSET mcball m (c,b)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mbounded] THEN
    EQ_TAC THEN MATCH_MP_TAC MONO_EXISTS THENL [ALL_TAC, MESON_TAC []] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_THEN (X_CHOOSE_TAC (← q r"B:real")) THEN
    EXISTS_TAC (← q r"abs B + &1") THEN CONJ_TAC THENL [REAL_ARITH_TAC, ALL_TAC] THEN
    TRANS_TAC SUBSET_TRANS (← q r"mcball m (a:A,B)") THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC MCBALL_SUBSET_CONCENTRIC THEN
    REAL_ARITH_TAC)

  let MBOUNDED_ALT ← prove
   r"!m s:A->bool.
        mbounded m s <=>
        s SUBSET mspace m /\
        ?b. !x y. x IN s /\ y IN s ==> mdist m (x,y) <= b"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mbounded] THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM, SUBSET, IN_MCBALL] THEN
      MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:real"] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [] THEN EXISTS_TAC (← q r"&2 * b") THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      TRANS_TAC REAL_LE_TRANS (← q r"mdist m (x:A,a) + mdist m (a,y)") THEN
      CONJ_TAC THENL [ASM_MESON_TAC [MDIST_TRIANGLE, MDIST_SYM], ALL_TAC] THEN
      MATCH_MP_TAC (← REAL_ARITH (← q r"x <= b /\ y <= b ==> x + y <= &2 * b")) THEN
      ASM_MESON_TAC [MDIST_SYM],
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (X_CHOOSE_TAC (← q r"B:real"))) THEN
      ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [EMPTY_SUBSET] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"a:A") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"B:real") THEN REWRITE_TAC [SUBSET, IN_MCBALL] THEN
      X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN ASM SET_TAC []])

  let MBOUNDED_ALT_POS ← prove
   r"!m s:A->bool.
        mbounded m s <=>
        s SUBSET mspace m /\
        ?B. &0 < B /\ !x y. x IN s /\ y IN s ==> mdist m (x,y) <= B"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MBOUNDED_ALT] THEN AP_TERM_TAC THEN
    EQ_TAC THENL [ALL_TAC, MESON_TAC []] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:real") STRIP_ASSUME_TAC) THEN
    EXISTS_TAC (← q r"abs B + &1") THEN CONJ_TAC THENL
     [REAL_ARITH_TAC, ASM_MESON_TAC [← REAL_ARITH (← q r"x <= b ==> x <= abs b + &1")]])

  let MBOUNDED_SUBSET ← prove
   r"!m s t:A->bool. mbounded m t /\ s SUBSET t ==> mbounded m s"
   (REWRITE_TAC [mbounded] THEN SET_TAC [])

  let MBOUNDED_SUBSET_MSPACE ← prove
   r"!m s:A->bool. mbounded m s ==> s SUBSET mspace m"
   (REWRITE_TAC [mbounded] THEN REPEAT STRIP_TAC THEN
    TRANS_TAC SUBSET_TRANS (← q r"mcball m (c:A,b)") THEN
    ASM_REWRITE_TAC [MCBALL_SUBSET_MSPACE])

  let MBOUNDED ← prove
   r"!m s. mbounded m s <=>
         s = {} \/
         (!x:A. x IN s ==> x IN mspace m) /\
         (?c b. c IN mspace m /\ (!x. x IN s ==> mdist m (c,x) <= b))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mbounded, SUBSET, IN_MCBALL] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [NOT_IN_EMPTY] THEN
    ASM SET_TAC [])

  let MBOUNDED_EMPTY ← prove
   r"!m:A metric. mbounded m {}"
   (REWRITE_TAC [mbounded, EMPTY_SUBSET])

  let MBOUNDED_MCBALL ← prove
   r"!m:A metric c b. mbounded m (mcball m (c,b))"
   (REWRITE_TAC [mbounded] THEN MESON_TAC [SUBSET_REFL])

  let MBOUNDED_MBALL ← prove
   r"!m:A metric c b. mbounded m (mball m (c,b))"
   (REPEAT GEN_TAC THEN MATCH_MP_TAC MBOUNDED_SUBSET THEN
    EXISTS_TAC (← q r"mcball m (c:A,b)") THEN
    REWRITE_TAC [MBALL_SUBSET_MCBALL, MBOUNDED_MCBALL])

  let MBOUNDED_INSERT ← prove
   r"!m a:A s. mbounded m (a INSERT s) <=> a IN mspace m /\ mbounded m s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [MBOUNDED, NOT_INSERT_EMPTY, IN_INSERT] THEN
    ASM_CASES_TAC (← q r"a:A IN mspace m") THEN ASM_REWRITE_TAC [] THENL
    [ALL_TAC, ASM_MESON_TAC []] THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_SIMP_TAC [NOT_IN_EMPTY] THENL [ASM_MESON_TAC [REAL_LE_REFL], ALL_TAC] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_SIMP_TAC [] THENL
    [ASM_MESON_TAC [], ALL_TAC] THEN
    CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
    MAP_EVERY EXISTS_TAC [← q r"c:A", ← q r"max b (mdist m (c:A,a))"] THEN
    REPEAT STRIP_TAC THEN ASM_REWRITE_TAC [REAL_MAX_MAX] THEN
    TRANS_TAC REAL_LE_TRANS (← q r"b:real") THEN ASM_SIMP_TAC [REAL_MAX_MAX])

  let MBOUNDED_INTER ← prove
   r"!m:A metric s t. mbounded m s /\ mbounded m t ==> mbounded m (s INTER t)"
   (REWRITE_TAC [mbounded] THEN SET_TAC [])

  let MBOUNDED_UNION ← prove
   r"!m:A metric s t. mbounded m (s UNION t) <=> mbounded m s /\ mbounded m t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mbounded] THEN EQ_TAC THENL
    [SET_TAC [], INTRO_TAC "(@c1 b1. s) (@c2 b2. t)"] THEN
    ASM_CASES_TAC
      (← q r"&0 <= b1 /\ &0 <= b2 /\ c1:A IN mspace m /\ c2 IN mspace m") THENL
    [POP_ASSUM STRIP_ASSUME_TAC,
     POP_ASSUM MP_TAC THEN REWRITE_TAC [DE_MORGAN_THM, REAL_NOT_LE] THEN
     ASM SET_TAC [MCBALL_EMPTY, MCBALL_EMPTY_ALT]] THEN
    MAP_EVERY EXISTS_TAC [← q r"c1:A", ← q r"b1 + b2 + mdist m (c1:A,c2)"] THEN
    REWRITE_TAC [UNION_SUBSET] THEN CONJ_TAC THENL
    [TRANS_TAC SUBSET_TRANS (← q r"mcball m (c1:A,b1)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC MCBALL_SUBSET_CONCENTRIC THEN
     CUT_TAC (← q r"&0 <= mdist m (c1:A,c2)") THENL
     [ASM_REAL_ARITH_TAC, ASM_SIMP_TAC [MDIST_POS_LE]],
     TRANS_TAC SUBSET_TRANS (← q r"mcball m (c2:A,b2)") THEN ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC MCBALL_SUBSET THEN ASM_SIMP_TAC [MDIST_SYM] THEN
     ASM_REAL_ARITH_TAC])

  let MBOUNDED_UNIONS ← prove
   r"!m f:(A->bool)->bool.
        FINITE f /\ (!s. s IN f ==> mbounded m s)
        ==> mbounded m (UNIONS f)"
   (GEN_TAC THEN REWRITE_TAC [IMP_CONJ] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN
    REWRITE_TAC [FORALL_IN_INSERT, UNIONS_INSERT, NOT_IN_EMPTY] THEN
    SIMP_TAC [UNIONS_0, MBOUNDED_EMPTY, MBOUNDED_UNION])

  let MBOUNDED_CLOSURE_OF ← prove
   r"!m s:A->bool.
      mbounded m s ==> mbounded m (mtopology m closure_of s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [mbounded] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN DISCH_TAC THEN
    MATCH_MP_TAC CLOSURE_OF_MINIMAL THEN
    ASM_REWRITE_TAC [CLOSED_IN_MCBALL])

  let MBOUNDED_CLOSURE_OF_EQ ← prove
   r"!m s:A->bool.
        s SUBSET mspace m
        ==> (mbounded m (mtopology m closure_of s) <=> mbounded m s)"
   (REPEAT STRIP_TAC THEN EQ_TAC THEN
    REWRITE_TAC [MBOUNDED_CLOSURE_OF] THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] MBOUNDED_SUBSET) THEN
    ASM_SIMP_TAC [CLOSURE_OF_SUBSET, TOPSPACE_MTOPOLOGY])

  let MBOUNDED_SUBMETRIC ← prove
   r"!m:A metric s.
     mbounded (submetric m s) t <=> mbounded m (s INTER t) /\ t SUBSET s"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MBOUNDED_ALT, SUBMETRIC] THEN
    SET_TAC [])

  return { mbounded, MBOUNDED_POS, MBOUNDED_ALT, MBOUNDED_ALT_POS, MBOUNDED_SUBSET,
           MBOUNDED_SUBSET_MSPACE, MBOUNDED, MBOUNDED_EMPTY, MBOUNDED_MCBALL, MBOUNDED_MBALL,
           MBOUNDED_INSERT, MBOUNDED_INTER, MBOUNDED_UNION, MBOUNDED_UNIONS,
           MBOUNDED_CLOSURE_OF, MBOUNDED_CLOSURE_OF_EQ, MBOUNDED_SUBMETRIC }


/- ------------------------------------------------------------------------- -/
/- A decision procedure for metric spaces.  (metric.ml 12737-13035)          -/
/- METRIC_ARITH's local functions that do not close over theorems or over    -/
/- the metric are defined here, at top level, under their OCaml names; the   -/
/- recursive conversions use `fixConv` for OCaml's `let rec c tm = ... tm`.  -/
/- ------------------------------------------------------------------------- -/

namespace MetricArith

/-- OCaml's `let rec c tm = (... c ...) tm` for a conversion. -/
partial def fixConv (f : ioconv → ioconv) : ioconv := fun tm => f (fixConv f) tm

/-- lib.ml's `mapfilter`, for a function with effects. -/
def mapfilterIO {α β : Type} (f : α → ExceptT String IO β) :
    List α → ExceptT String IO (List β)
  | [] => pure []
  | h :: t => do
      let rest ← mapfilterIO f t
      tryCatch (do pure ((← f h) :: rest)) (fun _ => pure rest)

/-- lib.ml's `end_itlist`, for a function with effects. -/
def end_itlistIO {α : Type} (f : α → α → ExceptT String IO α) :
    List α → ExceptT String IO α
  | [] => throw "end_itlist"
  | [x] => pure x
  | h :: t => do f h (← end_itlistIO f t)

/-- `guess_metric` (metric.ml 12817-12823). -/
partial def guess_metric (tm : term) : Except String term :=
  match tm with
  | .Comb (.Const "mdist" _) m => pure m
  | .Comb (.Const "mspace" _) m => pure m
  | .Comb s t => match guess_metric s with
    | .ok r => pure r
    | .error _ => guess_metric t
  | .Abs _ bd => guess_metric bd
  | _ => throw "metric not found"

/-- `find_mdist` (metric.ml 12824-12831). -/
partial def find_mdist (mtm : term) (tm : term) : List term :=
  match tm with
  | .Comb s t =>
      let isMdist := match s with
        | .Comb (.Const "mdist" _) pmtm => pmtm == mtm
        | _ => false
      if isMdist then [tm] else union (find_mdist mtm s) (find_mdist mtm t)
  | .Abs v bd => (find_mdist mtm bd).filter (fun x => !(HolCore.Basics.free_in v x))
  | _ => []

/-- `find_eq` (metric.ml 12832-12839). -/
partial def find_eq (mty : hol_type) (tm : term) : List term :=
  match tm with
  | .Comb s t =>
      let isEq := match s with
        | .Comb (.Const "=" ty) _ =>
            match HolCore.Basics.dest_fun_ty ty with
            | .ok (d, _) => d == mty
            | .error _ => false
        | _ => false
      if isEq then [tm] else union (find_eq mty s) (find_eq mty t)
  | .Abs v bd => (find_eq mty bd).filter (fun x => !(HolCore.Basics.free_in v x))
  | _ => []

/-- `find_points` (metric.ml 12840-12851). -/
partial def find_points (mtm : term) (tm : term) : Except String (List term) :=
  match tm with
  | .Comb s t =>
      match s, t with
      | .Comb (.Const "mdist" _) pmtm, p =>
          if pmtm == mtm then do
            let (x, y) ← HolMath.Pair.dest_pair p
            pure (if x == y then [x] else [x, y])
          else do pure (union (← find_points mtm s) (← find_points mtm t))
      | .Comb (.Const "IN" _) x, .Comb (.Const "mspace" _) pmtm =>
          if pmtm == mtm then pure [x]
          else do pure (union (← find_points mtm s) (← find_points mtm t))
      | _, _ => do pure (union (← find_points mtm s) (← find_points mtm t))
  | .Abs v bd => do
      pure ((← find_points mtm bd).filter (fun x => !(HolCore.Basics.free_in v x)))
  | _ => pure []

/-- `prove_hyps` (metric.ml 12808-12816). -/
partial def prove_hyps [HolBase] (EXCLUDED_MIDDLE : thm) (PRESIMP_CONV : ioconv)
    (MESON : List thm → term → ExceptT String IO thm) (th : thm) : ExceptT String IO thm :=
  match hyp th with
  | [] => pure th
  | htm :: _ => do
      let emth ← SPEC htm EXCLUDED_MIDDLE
      let nhp ← EQF_INTRO (← ASSUME (← liftExcept (HolCore.Bool.mk_neg htm)))
      let nth1 ← ExceptT.mk ((SUBS_CONV [nhp] THENC PRESIMP_CONV) (concl th))
      let nth2 ← MESON [nhp] (← liftExcept (rand (concl nth1)))
      let nth ← HolLight.EQ_MP (← SYM nth1) nth2
      prove_hyps EXCLUDED_MIDDLE PRESIMP_CONV MESON (← DISJ_CASES emth th nth)

mutual
/-- `try_points` (metric.ml 13024-13029). -/
partial def try_points [HolBase] (SIMPLE_METRIC_ARITH : term → ExceptT String IO thm)
    (points : List term) (v tm : term) (ptl : List term) : ExceptT String IO thm :=
  match ptl with
  | [] => throw ""
  | xtm :: rest =>
      tryCatch (do
        let etm ← liftExcept (HolCore.Bool.mk_exists v tm)
        let tm' := (← liftExcept (vsubst [(xtm, v)])) tm
        EXISTS (etm, xtm) (← elim_exists SIMPLE_METRIC_ARITH points tm'))
        (fun _ => try_points SIMPLE_METRIC_ARITH points v tm rest)

/-- `elim_exists` (metric.ml 13030-13033). -/
partial def elim_exists [HolBase] (SIMPLE_METRIC_ARITH : term → ExceptT String IO thm)
    (points : List term) (tm : term) : ExceptT String IO thm :=
  tryCatch (do
    let (v, bd) ← liftExcept (HolCore.Basics.dest_exists tm)
    try_points SIMPLE_METRIC_ARITH points v bd points)
    (fun _ => SIMPLE_METRIC_ARITH tm)
end

end MetricArith

open MetricArith

structure MetricArithB where
  METRIC_ARITH : term → ExceptT String IO thm
  METRIC_ARITH_TAC : tactic
  ASM_METRIC_ARITH_TAC : tactic
  deriving Inhabited

@[nospecialize]
def setupMetricArith [HolBase] (D : MetricDeps) (BTactics : Tactics)
    (BMetricSpace : MetricSpace) (BBounded : Bounded) : ExceptT String IO MetricArithB := do
  -- @@SCOPE BEGIN
  let { MESON, REAL_ARITH, SET_TAC, INTRO_TAC, CONDS_CELIM_CONV, CONJ_CANON_CONV,
        IMP_REWR_CONV, NNFC_CONV, PRENEX_CONV, PRESIMP_CONV, REAL_POLY_CONV,
        REAL_RAT_REDUCE_CONV, WEAK_CNF_CONV, mk_setenum, .. } := D
  let { AND_FORALL_THM, EMPTY_SUBSET, FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES,
        .. } := D.core1
  let { INSERT_AC, INSERT_SUBSET, IN_INSERT, NOT_IN_EMPTY, REAL_ABS_0, REAL_ABS_NEG,
        .. } := D.core2
  let { REAL_ABS_SUB, REAL_LE_TRANS, .. } := D.core3
  let { REAL_SUB_LZERO, REAL_SUB_REFL, REAL_SUB_RZERO, SUP_INSERT_INSERT, SUP_SING,
        SUP_UNIQUE, .. } := D.core4
  let { EXCLUDED_MIDDLE, EXISTS_SIMP, FORALL_SIMP, LEFT_AND_FORALL_THM, LEFT_OR_FORALL_THM,
        RIGHT_AND_FORALL_THM, RIGHT_OR_FORALL_THM, .. } := D.core5
  let { CLAIM_TAC, .. } := BTactics
  let { MDIST_0, MDIST_POS_LE, MDIST_REFL, MDIST_REVERSE_TRIANGLE, MDIST_SYM,
        REAL_ABS_MDIST, .. } := BMetricSpace
  let { MBOUNDED_EMPTY, MBOUNDED_INSERT, MBOUNDED_SUBSET_MSPACE, .. } := BBounded
  -- @@SCOPE END

  let METRIC_ARITH : term → ExceptT String IO thm ← do
    let SUP_CONV : ioconv :=
      let conv0 := REWR_CONV SUP_INSERT_INSERT
      let conv1 := REWR_CONV SUP_SING
      conv1 ORELSEC (conv0 THENC REPEATC conv0 THENC TRY_CONV conv1)
    let MAXDIST_THM ← prove
     r"!m s x y:A.
       mbounded m s /\ x IN s /\ y IN s
       ==> mdist m (x,y) =
           sup (IMAGE (\a. abs(mdist m (x,a) - mdist m (a,y))) s)"
     (REPEAT GEN_TAC THEN INTRO_TAC "bnd x y" THEN
      MATCH_MP_TAC (← GSYM SUP_UNIQUE) THEN
      CLAIM_TAC "inc" (← q r"!p:A. p IN s ==> p IN mspace m") THENL
      [HYP SET_TAC "bnd" [MBOUNDED_SUBSET_MSPACE], ALL_TAC] THEN
      GEN_TAC THEN REWRITE_TAC [FORALL_IN_IMAGE] THEN EQ_TAC THENL
      [INTRO_TAC "le; ![z]; z" THEN
       TRANS_TAC REAL_LE_TRANS (← q r"mdist m (x:A,y)") THEN
       ASM_SIMP_TAC [MDIST_REVERSE_TRIANGLE],
       DISCH_THEN (MP_TAC o C MATCH_MP (← ASSUME (← q r"y:A IN s"))) THEN
       ASM_SIMP_TAC [MDIST_REFL, REAL_SUB_RZERO, REAL_ABS_MDIST]])
    let METRIC_EQ_THM ← prove
     r"!m s x y:A.
       s SUBSET mspace m /\ x IN s /\ y IN s
       ==> (x = y <=> (!a. a IN s ==> mdist m (x,a) = mdist m (y,a)))"
     (INTRO_TAC "!m s x y; sub sx sy" THEN EQ_TAC THEN SIMP_TAC [] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"y:A")) THEN
      CLAIM_TAC "x y" (← q r"x:A IN mspace m /\ y IN mspace m") THENL
      [ASM SET_TAC [], ASM_SIMP_TAC [MDIST_REFL, MDIST_0]])
    let CONJ1_CONV : ioconv → ioconv ← do
      let TRUE_CONJ_CONV := REWR_CONV (← MESON [] (← q r"T /\ p <=> p"))
      pure (fun conv => LAND_CONV conv THENC TRUE_CONJ_CONV)
    let IN_CONV : ioconv ← do
      let DISJ_TRUE_CONV := REWR_CONV (← MESON [] (← q r"p \/ T <=> T"))
      let TRUE_DISJ_CONV := REWR_CONV (← MESON [] (← q r"T \/ p <=> T"))
      let REFL_CONV := REWR_CONV (← MESON [] (← q r"x:A = x <=> T"))
      let conv0 := REWR_CONV (← EQF_INTRO (← SPEC_ALL NOT_IN_EMPTY))
      let conv1 := REWR_CONV IN_INSERT
      let conv2 := LAND_CONV REFL_CONV THENC TRUE_DISJ_CONV
      let IN_CONV := fixConv (fun IN_CONV =>
        (conv0 ORELSEC
         (conv1 THENC
          (conv2 ORELSEC
           (RAND_CONV IN_CONV THENC DISJ_TRUE_CONV)))))
      pure IN_CONV
    let IMAGE_CONV : ioconv ← do
      let (pth0, pth1) ← CONJ_PAIR IMAGE_CLAUSES
      let conv0 := REWR_CONV pth0
      let conv1 := REWR_CONV pth1 THENC TRY_CONV (LAND_CONV BETA_CONV)
      let IMAGE_CONV := fixConv (fun IMAGE_CONV =>
        (conv0 ORELSEC (conv1 THENC RAND_CONV IMAGE_CONV)))
      pure IMAGE_CONV
    let SUBSET_CONV : ioconv → ioconv ← do
      let conv0 := REWR_CONV (← EQT_INTRO (← SPEC_ALL EMPTY_SUBSET))
      let conv1 := REWR_CONV INSERT_SUBSET
      pure (fun conv =>
        let conv2 := conv1 THENC CONJ1_CONV conv
        REPEATC conv2 THENC conv0)
    let prenex_conv :=
      TOP_DEPTH_CONV BETA_CONV THENC
      PURE_REWRITE_CONV [FORALL_SIMP, EXISTS_SIMP] THENC
      NNFC_CONV THENC DEPTH_BINOP_CONV (← q r"(/\)") CONDS_CELIM_CONV THENC
      PRESIMP_CONV THENC
      GEN_REWRITE_CONV REDEPTH_CONV
        [AND_FORALL_THM, LEFT_AND_FORALL_THM, RIGHT_AND_FORALL_THM,
         LEFT_OR_FORALL_THM, RIGHT_OR_FORALL_THM] THENC
      PRENEX_CONV
    let real_poly_conv ← do
      let eths ← REAL_ARITH (← q
        r"(x = y <=> x - y = &0) /\
       (x < y <=> y - x > &0) /\
       (x > y <=> x - y > &0) /\
       (x <= y <=> y - x >= &0) /\
       (x >= y <=> x - y >= &0)")
      pure (GEN_REWRITE_CONV id [eths] THENC LAND_CONV REAL_POLY_CONV)
    let augment_mdist_pos_thm ←
      MESON [] (← q r"p ==> (q <=> r) ==> (q <=> (p ==> r))")
    pure (fun tm => do
      let mtm ← liftExcept (guess_metric tm)
      let mty ← liftExcept (do
        let (_, args) ← dest_type (type_of mtm)
        hd args)
      let mspace_tm ← liftExcept (HolCore.Basics.mk_icomb
        (← ExceptT.mk (mk_const "mspace" [])) mtm)
      let metric_eq_thm ← ISPEC mtm METRIC_EQ_THM
      let mk_in_mspace_th : term → ExceptT String IO thm := fun pt => do
        let aty := mk_vartype "A"
        let in_tm ← ExceptT.mk (mk_const "IN" [(mty, aty)])
        ASSUME (← liftExcept (mk_comb (← liftExcept (mk_comb in_tm pt)) mspace_tm))
      let th0 ← ExceptT.mk (prenex_conv tm)
      let tm0 ← liftExcept (rand (concl th0))
      let (avs, bod) := HolCore.Basics.strip_forall tm0
      let points ← liftExcept (find_points mtm bod)
      let in_mspace_conv := GEN_REWRITE_CONV id (← points.mapM mk_in_mspace_th)
      let in_mspace2_conv := CONJ1_CONV in_mspace_conv THENC in_mspace_conv
      let MDIST_REFL_CONV : ioconv ← do
        let pconv := IMP_REWR_CONV (← ISPEC mtm MDIST_REFL)
        pure (fun tm => (do MP_CONV in_mspace_conv (← ExceptT.mk (pconv tm))).run)
      let MDIST_SYM_CONV : ioconv ← do
        let pconv := IMP_REWR_CONV (← ISPEC mtm MDIST_SYM)
        pure (fun tm => (do
          let (x, y) ← liftExcept (HolMath.Pair.dest_pair (← liftExcept (rand tm)))
          if compare x y != Ordering.gt then throw "MDIST_SYM_CONV" else
          MP_CONV in_mspace2_conv (← ExceptT.mk (pconv tm))).run)
      let MBOUNDED_CONV : ioconv ← do
        let conv0 := REWR_CONV (← EQT_INTRO (← ISPEC mtm MBOUNDED_EMPTY))
        let conv1 := REWR_CONV (← ISPEC mtm MBOUNDED_INSERT)
        let mbounded_conv := fixConv (fun mbounded_conv tm => (do
          tryCatch (ExceptT.mk (conv0 tm)) (fun _ =>
            ExceptT.mk ((conv1 THENC CONJ1_CONV in_mspace_conv THENC mbounded_conv) tm))).run)
        pure mbounded_conv
      let REFL_SYM_CONV := MDIST_REFL_CONV ORELSEC MDIST_SYM_CONV
      let ABS_MDIST_CONV : ioconv ← do
        let pconv := IMP_REWR_CONV (← ISPEC mtm REAL_ABS_MDIST)
        pure (fun tm => (do MP_CONV in_mspace2_conv (← ExceptT.mk (pconv tm))).run)
      let metric_eq_prerule : thm → ExceptT String IO thm :=
        (CONV_RULE o BINDER_CONV o BINDER_CONV)
        (LAND_CONV (CONJ1_CONV (SUBSET_CONV in_mspace_conv)) THENC
         RAND_CONV (REWRITE_CONV [FORALL_IN_INSERT, NOT_IN_EMPTY]))
      let MAXDIST_CONV : term → ExceptT String IO ioconv ← do
        let maxdist_thm ← ISPEC mtm MAXDIST_THM
        let ante_conv :=
          CONJ1_CONV MBOUNDED_CONV THENC CONJ1_CONV IN_CONV THENC IN_CONV
        let image_conv :=
          IMAGE_CONV THENC ONCE_DEPTH_CONV REFL_SYM_CONV THENC
          PURE_REWRITE_CONV
            [REAL_SUB_LZERO, REAL_SUB_RZERO, REAL_SUB_REFL,
             REAL_ABS_0, REAL_ABS_NEG, REAL_ABS_SUB, INSERT_AC] THENC
          ONCE_DEPTH_CONV ABS_MDIST_CONV THENC
          PURE_REWRITE_CONV [INSERT_AC]
        let sup_conv := RAND_CONV image_conv THENC SUP_CONV
        pure (fun fset_tm => do
          let maxdist_th ← SPEC fset_tm maxdist_thm
          pure (fun tm => (do
            let th0 ← MP_CONV ante_conv (← ExceptT.mk (IMP_REWR_CONV maxdist_th tm))
            let tm0 ← liftExcept (rand (concl th0))
            let th1 ← ExceptT.mk (sup_conv tm0)
            HolLight.TRANS th0 th1).run))
      let AUGMENT_MDISTS_POS_RULE : thm → ExceptT String IO thm ← do
        let mdist_pos_le ← ISPEC mtm MDIST_POS_LE
        let augment_rule : term → thm → ExceptT String IO thm :=
          let mk_mdist_pos_thm (tm : term) : ExceptT String IO thm := do
            let (xtm, ytm) ← liftExcept (HolMath.Pair.dest_pair (← liftExcept (rand tm)))
            let pth ← SPECL [xtm, ytm] mdist_pos_le
            MP_CONV (CONJ1_CONV in_mspace_conv THENC in_mspace_conv) pth
          fun mdist_tm th => do
            let ith ←
              MATCH_MP augment_mdist_pos_thm (← mk_mdist_pos_thm mdist_tm)
            MATCH_MP ith th
        pure (fun th => do
          let mdist_thl := find_mdist mtm (concl th)
          itlistIO augment_rule mdist_thl th)
      let BASIC_METRIC_ARITH (tm : term) : ExceptT String IO thm := do
        let mdist_tms := find_mdist mtm tm
        let th0 ← do
          let eqs ← mapfilterIO (fun t => ExceptT.mk ((MDIST_REFL_CONV ORELSEC MDIST_SYM_CONV) t))
            mdist_tms
          ExceptT.mk ((ONCE_DEPTH_CONV in_mspace_conv THENC PRESIMP_CONV THENC
           SUBS_CONV eqs THENC REAL_RAT_REDUCE_CONV THENC
           ONCE_DEPTH_CONV real_poly_conv) tm)
        let tm0 ← liftExcept (rand (concl th0))
        let points ← liftExcept (find_points mtm tm0)
        let fset_tm ← mk_setenum (points, mty)
        let METRIC_EQ_CONV : ioconv ← do
          let th ← metric_eq_prerule (← SPEC fset_tm metric_eq_thm)
          pure (fun tm => (do
            let (xtm, ytm) ← liftExcept (dest_eq tm)
            let th0 ← SPECL [xtm, ytm] th
            let th1 ← MP_CONV (CONJ1_CONV IN_CONV THENC IN_CONV) th0
            let tm1 ← liftExcept (rand (concl th1))
            let th2 ← ExceptT.mk (ONCE_DEPTH_CONV REFL_SYM_CONV tm1)
            HolLight.TRANS th1 th2).run)
        let eq1 ← do
          let c ← MAXDIST_CONV fset_tm
          (find_mdist mtm tm0).mapM (fun t => ExceptT.mk (c t))
        let eq2 ← (find_eq mty tm0).mapM (fun t => ExceptT.mk (METRIC_EQ_CONV t))
        let th1 ← AUGMENT_MDISTS_POS_RULE (← ExceptT.mk (SUBS_CONV (eq1 ++ eq2) tm0))
        let tm1 ← liftExcept (rand (concl th1))
        prove_hyps EXCLUDED_MIDDLE PRESIMP_CONV MESON
          (← HolLight.EQ_MP (← SYM th0) (← HolLight.EQ_MP (← SYM th1) (← REAL_ARITH tm1)))
      let SIMPLE_METRIC_ARITH (tm : term) : ExceptT String IO thm := do
        let th0 ← ExceptT.mk ((WEAK_CNF_CONV THENC CONJ_CANON_CONV) tm)
        let tml ← tryCatch (do
            pure (HolCore.Basics.conjuncts (← liftExcept (rand (concl th0)))))
          (fun s => throw ("conjuncts " ++ s))
        let th1 ← tryCatch (do end_itlistIO CONJ (← tml.mapM BASIC_METRIC_ARITH))
          (fun s => throw ("end_itlist " ++ s))
        HolLight.EQ_MP (← SYM th0) th1
      let elim_exists (tm : term) : ExceptT String IO thm := do
        let points ← liftExcept (find_points mtm tm)
        MetricArith.elim_exists SIMPLE_METRIC_ARITH points tm
      HolLight.EQ_MP (← SYM th0) (← GENL avs (← elim_exists bod)))

  let METRIC_ARITH_TAC := CONV_TAC (fun t => METRIC_ARITH t)

  let ASM_METRIC_ARITH_TAC :=
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      pure (MP_TAC (← liftExcept
        (check (fun (t : thm) => !(HolCore.Basics.is_forall (concl t))) th))))) THEN
    METRIC_ARITH_TAC

  return { METRIC_ARITH, METRIC_ARITH_TAC, ASM_METRIC_ARITH_TAC }

/- ------------------------------------------------------------------------- -/
/- Compact sets are bounded; metric spaces are Hausdorff.                    -/
/- (metric.ml 12979-13034)                                                    -/
/- ------------------------------------------------------------------------- -/

structure MetricHaus where
  COMPACT_IN_IMP_MBOUNDED : thm
  HAUSDORFF_SPACE_MTOPOLOGY : thm
  T1_SPACE_MTOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupMetricHaus [HolBase] (D : MetricDeps) (BTactics : Tactics) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BBounded : Bounded) (BMetricArith : MetricArithB) : ExceptT String IO MetricHaus := do
  -- @@SCOPE BEGIN
  let { MESON_TAC, REAL_ARITH, SET_RULE, SET_TAC, DESTRUCT_TAC, INTRO_TAC, HYP_TAC, .. } := D
  let { EMPTY_SUBSET, FINITE_IMAGE, .. } := D.core1
  let { IN, IN_ELIM_THM, IN_UNIONS, IN_UNIV, MEMBER_NOT_EMPTY, .. } := D.core2
  let { REAL_ADD_LID, REAL_ARCH_SIMPLE, REAL_OF_NUM_ADD, REAL_OF_NUM_LE, .. } := D.core3
  let { SKOLEM_THM, SUBSET, SUBSET_TRANS, UNIONS_SUBSET, num_FINITE, .. } := D.core4
  let { RIGHT_EXISTS_IMP_THM, .. } := D.core5
  let { CLAIM_TAC, .. } := BTactics
  let { compact_in, .. } := BCompact1
  let { HAUSDORFF_IMP_T1_SPACE, hausdorff_space, .. } := BHausdorff1
  let { IN_MBALL, MBALL_SUBSET, MDIST_REFL, .. } := BMetricSpace
  let { MBALL_SUBSET_MCBALL, OPEN_IN_MBALL, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { mbounded, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let COMPACT_IN_IMP_MBOUNDED ← prove
   r"!m s:A->bool. compact_in (mtopology m) s ==> mbounded m s"
   (REWRITE_TAC [compact_in, TOPSPACE_MTOPOLOGY, mbounded] THEN
    INTRO_TAC "!m s; s cpt" THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
    [ASM_REWRITE_TAC [EMPTY_SUBSET],
     POP_ASSUM (DESTRUCT_TAC "@a. a" o REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY])] THEN
    CLAIM_TAC "a'" (← q r"a:A IN mspace m") THENL [ASM SET_TAC [], EXISTS_TAC (← q r"a:A")] THEN
    REMOVE_THEN "cpt" (MP_TAC o SPEC (← q r"{mball m (a:A,&n) | n IN (:num)}")) THEN
    ANTS_TAC THENL
    [CONJ_TAC THENL
     [REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN GEN_TAC THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [IN, OPEN_IN_MBALL],
      REWRITE_TAC [SUBSET, IN_UNIONS, IN_ELIM_THM, IN_UNIV] THEN
      INTRO_TAC "!x; x" THEN CLAIM_TAC "@n. n" (← q r"?n. mdist m (a:A,x) <= &n") THENL
      [MATCH_ACCEPT_TAC REAL_ARCH_SIMPLE,
       EXISTS_TAC (← q r"mball m (a:A,&n + &1)")] THEN
      CONJ_TAC THENL
      [REWRITE_TAC [REAL_OF_NUM_ADD, IN_UNIV] THEN MESON_TAC [],
       ASM_SIMP_TAC [IN_MBALL, ← REAL_ARITH (← q r"!x. x <= &n ==> x < &n + &1")] THEN
       ASM SET_TAC []]],
     ALL_TAC] THEN
    INTRO_TAC "@V. fin V cov" THEN
    CLAIM_TAC "@k. k" (← q r"?k. !v. v IN V ==> v = mball m (a:A,&(k v))") THENL
    [REWRITE_TAC [← GSYM SKOLEM_THM, RIGHT_EXISTS_IMP_THM] THEN ASM SET_TAC [],
     ALL_TAC] THEN
    CLAIM_TAC "kfin" (← q r"FINITE (IMAGE (k:(A->bool)->num) V)") THENL
    [HYP SIMP_TAC "fin" [FINITE_IMAGE],
     HYP_TAC "kfin: @n. n" (REWRITE_RULE [num_FINITE])] THEN EXISTS_TAC (← q r"&n") THEN
    TRANS_TAC SUBSET_TRANS (← q r"UNIONS (V:(A->bool)->bool)") THEN
    HYP SIMP_TAC "cov" [UNIONS_SUBSET] THEN INTRO_TAC "![v]; v" THEN
    USE_THEN "v" (HYP_TAC "k" o C MATCH_MP) THEN REMOVE_THEN "k" SUBST1_TAC THEN
    TRANS_TAC SUBSET_TRANS (← q r"mball m (a:A,&n)") THEN
    REWRITE_TAC [MBALL_SUBSET_MCBALL] THEN MATCH_MP_TAC MBALL_SUBSET THEN
    ASM_SIMP_TAC [MDIST_REFL, REAL_ADD_LID, REAL_OF_NUM_LE] THEN
    HYP SET_TAC "n v" [])

  let HAUSDORFF_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. hausdorff_space(mtopology m)"
   (REWRITE_TAC [hausdorff_space, TOPSPACE_MTOPOLOGY] THEN
    MAP_EVERY X_GEN_TAC [← q r"m:A metric", ← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"mball m (x:A,mdist m (x,y) / &2)") THEN
    EXISTS_TAC (← q r"mball m (y:A,mdist m (x,y) / &2)") THEN
    REWRITE_TAC [← sr r"DISJOINT s t <=> !x. x IN s /\ x IN t ==> F"] THEN
    REWRITE_TAC [OPEN_IN_MBALL, IN_MBALL] THEN
    POP_ASSUM_LIST (fun ths => (MP_TAC o end_itlist CONJ) ths.reverse) THEN CONV_TAC (fun t => METRIC_ARITH t))

  let T1_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. t1_space(mtopology m)"
   (SIMP_TAC [HAUSDORFF_IMP_T1_SPACE, HAUSDORFF_SPACE_MTOPOLOGY])

  return { COMPACT_IN_IMP_MBOUNDED, HAUSDORFF_SPACE_MTOPOLOGY, T1_SPACE_MTOPOLOGY }

/- ------------------------------------------------------------------------- -/
/- The discrete metric; metrizable spaces.  (metric.ml 13036-13264)          -/
/- ------------------------------------------------------------------------- -/

structure Metrizable where
  discrete_metric : thm
  DISCRETE_METRIC : thm
  MTOPOLOGY_DISCRETE_METRIC : thm
  DISCRETE_ULTRAMETRIC : thm
  MBOUNDED_DISCRETE_METRIC : thm
  metrizable_space : thm
  METRIZABLE_SPACE_MTOPOLOGY : thm
  FORALL_METRIC_TOPOLOGY : thm
  FORALL_METRIZABLE_SPACE : thm
  EXISTS_METRIZABLE_SPACE : thm
  METRIZABLE_SPACE_DISCRETE_TOPOLOGY : thm
  METRIZABLE_SPACE_SUBTOPOLOGY : thm
  HOMEOMORPHIC_METRIZABLE_SPACE : thm
  METRIZABLE_SPACE_RETRACTION_MAP_IMAGE : thm
  METRIZABLE_IMP_HAUSDORFF_SPACE : thm
  METRIZABLE_IMP_KC_SPACE : thm
  KC_SPACE_MTOPOLOGY : thm
  METRIZABLE_IMP_T1_SPACE : thm
  CLOSED_IMP_GDELTA_IN : thm
  OPEN_IMP_FSIGMA_IN : thm
  FIRST_COUNTABLE_MTOPOLOGY : thm
  METRIZABLE_IMP_FIRST_COUNTABLE : thm
  deriving Inhabited

@[nospecialize]
def setupMetrizable [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BContMap1 : ContMap1) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2) (BHomeoSpace : HomeoSpace)
    (BRetractOf : RetractOf) (BHausdorff1 : Hausdorff1) (BKC1 : KC1)
    (BCountability : Countability) (BFsigmaGdelta : FsigmaGdelta)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BBounded : Bounded)
    (BMetricArith : MetricArithB) (BMetricHaus : MetricHaus) :
    ExceptT String IO Metrizable := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, REAL_ARITH_TAC, SET_RULE, SET_TAC,
        REAL_RAT_REDUCE_CONV, new_definition, .. } := D
  let { AND_FORALL_THM, EXISTS_IN_GSPEC, EXTENSION, FORALL_IN_GSPEC, FORALL_IN_IMAGE,
        FUN_EQ_THM, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMP_CONJ, INTERS_GSPEC, IN_DIFF, IN_ELIM_THM, IN_SING, IN_UNIV, LEFT_IMP_EXISTS_THM,
        MONO_EXISTS, MONO_FORALL, NOT_FORALL_THM, NOT_IMP, .. } := D.core2
  let { REAL_LE_REFL, REAL_LT_01, REAL_LT_IMP_LE, REAL_LT_INV_EQ, REAL_LT_REFL, REAL_LT_TRANS,
        REAL_POS, .. } := D.core3
  let { REAL_SUB_LT, REAL_SUB_REFL, RIGHT_FORALL_IMP_THM, SIMPLE_IMAGE, SING_SUBSET, SUBSET,
        SUBSET_RESTRICT, SUBSET_TRANS, UNIV_NOT_EMPTY, .. } := D.core4
  let { CONTRAPOS_THM, FORALL_PAIR_THM, FORALL_UNWIND_THM2, .. } := D.core5
  let { COUNTABLE_RATIONAL, FORALL_POS_MONO_1_EQ, .. } := D.misc
  let { COUNTABLE_IMAGE, COUNTABLE_RESTRICT, NUM_COUNTABLE, RATIONAL_APPROXIMATION_BELOW,
        .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_SUBSET, TOPOLOGY_EQ,
        closed_in, .. } := BTopology
  let { DISCRETE_TOPOLOGY_UNIQUE, .. } := BDiscrete
  let { continuous_map, .. } := BContMap1
  let { HOMEOMORPHIC_MAPS_IMP_MAP, HOMEOMORPHIC_MAPS_SYM, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_OPENNESS_EQ, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { HEREDITARY_IMP_RETRACTIVE_PROPERTY, .. } := BRetractOf
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { HAUSDORFF_IMP_KC_SPACE, .. } := BKC1
  let { first_countable, .. } := BCountability
  let { FSIGMA_IN_GDELTA_IN, GDELTA_IN_EMPTY, GDELTA_IN_INTERS, OPEN_IMP_GDELTA_IN,
        .. } := BFsigmaGdelta
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_CONCENTRIC, MDIST_REFL, METRIC,
        is_metric_space, .. } := BMetricSpace
  let { METRIC_INJECTIVE_IMAGE, MTOPOLOGY_SUBMETRIC, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY,
        TOPSPACE_MTOPOLOGY, mcball, .. } := BMTopology
  let { MBOUNDED_ALT, .. } := BBounded
  let { METRIC_ARITH, .. } := BMetricArith
  let { HAUSDORFF_SPACE_MTOPOLOGY, .. } := BMetricHaus
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let discrete_metric ← new_definition
    r"discrete_metric s = metric(s,(\(x,y). if x = y then &0 else &1))"

  let DISCRETE_METRIC ← prove
   r"(!s:A->bool. mspace(discrete_metric s) = s) /\
   (!s x y:A. mdist (discrete_metric s) (x,y) = if x = y then &0 else &1)"
   (REWRITE_TAC [AND_FORALL_THM] THEN X_GEN_TAC (← q r"s:A->bool") THEN
    MP_TAC (← ISPECL [← q r"s:A->bool", ← q r"\(x:A,y). if x = y then &0 else &1"]
          METRIC) THEN
    REWRITE_TAC [← GSYM discrete_metric] THEN
    REWRITE_TAC [FUN_EQ_THM, FORALL_PAIR_THM] THEN
    DISCH_THEN MATCH_MP_TAC THEN REWRITE_TAC [is_metric_space] THEN
    REPEAT STRIP_TAC THEN REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_MESON_TAC [])

  let MTOPOLOGY_DISCRETE_METRIC ← prove
   r"!s:A->bool. mtopology(discrete_metric s) = discrete_topology s"
   (GEN_TAC THEN CONV_TAC SYM_CONV THEN
    REWRITE_TAC [DISCRETE_TOPOLOGY_UNIQUE] THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY, DISCRETE_METRIC, OPEN_IN_MTOPOLOGY] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN ASM_REWRITE_TAC [SING_SUBSET] THEN
    REWRITE_TAC [IN_SING, FORALL_UNWIND_THM2] THEN EXISTS_TAC (← q r"&1") THEN
    REWRITE_TAC [SUBSET, REAL_LT_01, IN_MBALL, DISCRETE_METRIC] THEN
    GEN_TAC THEN COND_CASES_TAC THEN ASM_REWRITE_TAC [IN_SING, REAL_LT_REFL])

  let DISCRETE_ULTRAMETRIC ← prove
   r"!s x y z:A.
        mdist(discrete_metric s) (x,z) <=
        max (mdist(discrete_metric s) (x,y))
            (mdist(discrete_metric s) (y,z))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [DISCRETE_METRIC] THEN
    REPEAT (COND_CASES_TAC THEN ASM_REWRITE_TAC []) THEN
    CONV_TAC REAL_RAT_REDUCE_CONV THEN ASM_MESON_TAC [])

  let MBOUNDED_DISCRETE_METRIC ← prove
   r"!u s:A->bool. mbounded (discrete_metric u) s <=> s SUBSET u"
   (REPEAT GEN_TAC THEN REWRITE_TAC [MBOUNDED_ALT, DISCRETE_METRIC, mcball] THEN
    EQ_TAC THEN SIMP_TAC [] THEN DISCH_TAC THEN EXISTS_TAC (← q r"&1:real") THEN
    REPEAT STRIP_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [REAL_POS, REAL_LE_REFL])

  let metrizable_space ← new_definition
   r"metrizable_space top <=> ?m. top = mtopology m"

  let METRIZABLE_SPACE_MTOPOLOGY ← prove
   r"!m. metrizable_space (mtopology m)"
   (REWRITE_TAC [metrizable_space] THEN MESON_TAC [])

  let FORALL_METRIC_TOPOLOGY ← prove
   r"!P. (!m:A metric. P (mtopology m) (mspace m)) <=>
       !top. metrizable_space top ==> P top (topspace top)"
   (SIMP_TAC [metrizable_space, LEFT_IMP_EXISTS_THM, TOPSPACE_MTOPOLOGY] THEN
    MESON_TAC [])

  let FORALL_METRIZABLE_SPACE ← prove
   r"!P. (!top. metrizable_space top ==> P top (topspace top)) <=>
       (!m:A metric. P (mtopology m) (mspace m))"
   (REWRITE_TAC [FORALL_METRIC_TOPOLOGY])

  let EXISTS_METRIZABLE_SPACE ← prove
   r"!P. (?top. metrizable_space top /\ P top (topspace top)) <=>
       (?m:A metric. P (mtopology m) (mspace m))"
   (REWRITE_TAC [← MESON [] (← q r"(?x. P x) <=> ~(!x. ~P x)")] THEN
    REWRITE_TAC [FORALL_METRIC_TOPOLOGY] THEN MESON_TAC [])

  let METRIZABLE_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool. metrizable_space(discrete_topology u)"
   (REWRITE_TAC [metrizable_space] THEN MESON_TAC [MTOPOLOGY_DISCRETE_METRIC])

  let METRIZABLE_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
    metrizable_space top ==> metrizable_space(subtopology top s)"
   (REWRITE_TAC [metrizable_space] THEN MESON_TAC [MTOPOLOGY_SUBMETRIC])

  let HOMEOMORPHIC_METRIZABLE_SPACE ← do
    let lemma ← prove
     r"!(top:A topology) (top':B topology).
          top homeomorphic_space top'
          ==> metrizable_space top ==> metrizable_space top'"
     (REPEAT GEN_TAC THEN
      REWRITE_TAC [metrizable_space, homeomorphic_space, LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"m:A metric") THEN DISCH_THEN (STRIP_ASSUME_TAC o GSYM) THEN
      ABBREV_TAC
       (← q r"m' = metric(topspace top',\(x,y). mdist m ((g:B->A) x,g y))") THEN
      MP_TAC (← ISPECL [← q r"g:B->A", ← q r"m:A metric", ← q r"topspace top':B->bool"]
            METRIC_INJECTIVE_IMAGE) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [homeomorphic_maps]) THEN
        EXPAND_TAC "top" THEN
        REWRITE_TAC [continuous_map, TOPSPACE_MTOPOLOGY] THEN SET_TAC [],
        STRIP_TAC THEN EXISTS_TAC (← q r"m':B metric")] THEN
      REWRITE_TAC [TOPOLOGY_EQ, OPEN_IN_MTOPOLOGY] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [HOMEOMORPHIC_MAPS_SYM]) THEN
      DISCH_THEN (MP_TAC o MATCH_MP HOMEOMORPHIC_MAPS_IMP_MAP) THEN
      DISCH_THEN (fun th => tactic_of do
        pure (REWRITE_TAC [← MATCH_MP HOMEOMORPHIC_MAP_OPENNESS_EQ th])) THEN
      X_GEN_TAC (← q r"v:B->bool") THEN
      ASM_CASES_TAC (← q r"(v:B->bool) SUBSET topspace top'") THEN
      ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "top" THEN REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, SUBSET, FORALL_IN_IMAGE] THEN
      ASM_REWRITE_TAC [IN_MBALL] THEN
      RULE_ASSUM_TAC (REWRITE_RULE [homeomorphic_maps, continuous_map]) THEN
      MATCH_MP_TAC (← TAUT (← q r"p /\ (q <=> r) ==> (p /\ q <=> r)")) THEN
      CONJ_TAC THENL [ASM SET_TAC [], EQ_TAC] THEN
      MATCH_MP_TAC MONO_FORALL THEN X_GEN_TAC (← q r"b:B") THEN
      ASM_CASES_TAC (← q r"(b:B) IN v") THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN
      ASM_REWRITE_TAC [] THENL
       [X_GEN_TAC (← q r"y:B") THEN STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o SPEC (← q r"(g:B->A) y")) THEN ASM SET_TAC [],
        ASM SET_TAC []])
    prove
     r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (metrizable_space top <=> metrizable_space top')"
     (REPEAT STRIP_TAC THEN EQ_TAC THEN MATCH_MP_TAC lemma THEN
      ASM_MESON_TAC [HOMEOMORPHIC_SPACE_SYM])

  let METRIZABLE_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ metrizable_space top
        ==> metrizable_space top'"
   (MATCH_MP_TAC HEREDITARY_IMP_RETRACTIVE_PROPERTY THEN
    REWRITE_TAC [METRIZABLE_SPACE_SUBTOPOLOGY, HOMEOMORPHIC_METRIZABLE_SPACE])

  let METRIZABLE_IMP_HAUSDORFF_SPACE ← prove
   r"!top. metrizable_space top ==> hausdorff_space top"
   (MESON_TAC [metrizable_space, HAUSDORFF_SPACE_MTOPOLOGY])

  let METRIZABLE_IMP_KC_SPACE ← prove
   r"!top:A topology. metrizable_space top ==> kc_space top"
   (MESON_TAC [METRIZABLE_IMP_HAUSDORFF_SPACE, HAUSDORFF_IMP_KC_SPACE])

  let KC_SPACE_MTOPOLOGY ← prove
   r"!m:A metric. kc_space(mtopology m)"
   (REWRITE_TAC [← GSYM FORALL_METRIZABLE_SPACE, METRIZABLE_IMP_KC_SPACE])

  let METRIZABLE_IMP_T1_SPACE ← prove
   r"!top. metrizable_space top ==> t1_space top"
   (MESON_TAC [HAUSDORFF_IMP_T1_SPACE, METRIZABLE_IMP_HAUSDORFF_SPACE])

  let CLOSED_IMP_GDELTA_IN ← prove
   r"!top s:A->bool.
        metrizable_space top /\ closed_in top s ==> gdelta_in top s"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_METRIZABLE_SPACE] THEN
    REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [GDELTA_IN_EMPTY] THEN
    SUBGOAL_THEN
     (← q r"s:A->bool =
      INTERS
       {{x | x IN mspace m /\
             ?y. y IN s /\ mdist m (x,y) < inv(&n + &1)} | n IN (:num)}")
    SUBST1_TAC THENL
     [GEN_REWRITE_TAC id [EXTENSION] THEN X_GEN_TAC (← q r"x:A") THEN
      REWRITE_TAC [INTERS_GSPEC, IN_ELIM_THM, IN_UNIV] THEN EQ_TAC THENL
       [DISCH_TAC THEN X_GEN_TAC (← q r"n:num") THEN
        SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
         [ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY],
          ASM_REWRITE_TAC [] THEN EXISTS_TAC (← q r"x:A") THEN
          ASM_SIMP_TAC [MDIST_REFL, REAL_LT_INV_EQ] THEN REAL_ARITH_TAC],
        ASM_CASES_TAC (← q r"(x:A) IN mspace m") THEN ASM_REWRITE_TAC [] THEN
        W (MP_TAC o PART_MATCH (rand o rand)
          FORALL_POS_MONO_1_EQ o lhand o snd) THEN
        ANTS_TAC THENL
         [MESON_TAC [REAL_LT_TRANS], DISCH_THEN (SUBST1_TAC o SYM)] THEN
        GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN DISCH_TAC THEN
        FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [closed_in]) THEN
        REWRITE_TAC [OPEN_IN_MTOPOLOGY, NOT_FORALL_THM, NOT_IMP] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"x:A") o CONJUNCT2 o CONJUNCT2) THEN
        ASM_REWRITE_TAC [IN_DIFF, TOPSPACE_MTOPOLOGY, SUBSET, IN_MBALL] THEN
        ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY]],
      MATCH_MP_TAC GDELTA_IN_INTERS THEN
      SIMP_TAC [SIMPLE_IMAGE, COUNTABLE_IMAGE, NUM_COUNTABLE] THEN
      REWRITE_TAC [IMAGE_EQ_EMPTY, FORALL_IN_IMAGE, UNIV_NOT_EMPTY, IN_UNIV] THEN
      X_GEN_TAC (← q r"n:num") THEN MATCH_MP_TAC OPEN_IMP_GDELTA_IN THEN
      REWRITE_TAC [OPEN_IN_MTOPOLOGY, SUBSET_RESTRICT, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"x:A") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"inv(&n + &1) - mdist m (x:A,y)") THEN
      ASM_REWRITE_TAC [SUBSET, IN_MBALL, IN_ELIM_THM, REAL_SUB_LT] THEN
      X_GEN_TAC (← q r"z:A") THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXISTS_TAC (← q r"y:A") THEN ASM_REWRITE_TAC [] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
        MATCH_MP (← METRIC_ARITH (← q
          r"mdist m (x,z) < e - mdist m (x,y)
           ==> x IN mspace m /\ y IN mspace m /\ z IN mspace m
               ==> mdist m (z,y) < e"))) THEN
      ASM_MESON_TAC [CLOSED_IN_SUBSET, SUBSET, TOPSPACE_MTOPOLOGY]])

  let OPEN_IMP_FSIGMA_IN ← prove
   r"!top s:A->bool.
        metrizable_space top /\ open_in top s ==> fsigma_in top s"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [FSIGMA_IN_GDELTA_IN, OPEN_IN_SUBSET] THEN
    MATCH_MP_TAC CLOSED_IMP_GDELTA_IN THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE])

  let FIRST_COUNTABLE_MTOPOLOGY ← prove
   r"!m:A metric. first_countable(mtopology m)"
   (GEN_TAC THEN REWRITE_TAC [first_countable, TOPSPACE_MTOPOLOGY] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"{ mball m (x:A,r) | rational r /\ &0 < r}") THEN
    REWRITE_TAC [FORALL_IN_GSPEC, OPEN_IN_MBALL, EXISTS_IN_GSPEC] THEN
    ONCE_REWRITE_TAC [← sr
     r"{f x | s x /\ Q x} = IMAGE f {x | x IN s /\ Q x}"] THEN
    SIMP_TAC [COUNTABLE_IMAGE, COUNTABLE_RATIONAL, COUNTABLE_RESTRICT] THEN
    REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"x:A")) THEN
    ASM_REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    X_GEN_TAC (← q r"r:real") THEN STRIP_TAC THEN FIRST_ASSUM
     (MP_TAC o SPEC (← q r"r:real") o MATCH_MP RATIONAL_APPROXIMATION_BELOW) THEN
    MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"q:real") THEN
    REWRITE_TAC [REAL_SUB_REFL] THEN STRIP_TAC THEN
    ASM_SIMP_TAC [CENTRE_IN_MBALL] THEN
    TRANS_TAC SUBSET_TRANS (← q r"mball m (x:A,r)") THEN
    ASM_SIMP_TAC [MBALL_SUBSET_CONCENTRIC, REAL_LT_IMP_LE])

  let METRIZABLE_IMP_FIRST_COUNTABLE ← prove
   r"!top:A topology. metrizable_space top ==> first_countable top"
   (REWRITE_TAC [FORALL_METRIZABLE_SPACE, FIRST_COUNTABLE_MTOPOLOGY])

  return { discrete_metric, DISCRETE_METRIC, MTOPOLOGY_DISCRETE_METRIC, DISCRETE_ULTRAMETRIC,
           MBOUNDED_DISCRETE_METRIC, metrizable_space, METRIZABLE_SPACE_MTOPOLOGY,
           FORALL_METRIC_TOPOLOGY, FORALL_METRIZABLE_SPACE, EXISTS_METRIZABLE_SPACE,
           METRIZABLE_SPACE_DISCRETE_TOPOLOGY, METRIZABLE_SPACE_SUBTOPOLOGY,
           HOMEOMORPHIC_METRIZABLE_SPACE, METRIZABLE_SPACE_RETRACTION_MAP_IMAGE,
           METRIZABLE_IMP_HAUSDORFF_SPACE, METRIZABLE_IMP_KC_SPACE, KC_SPACE_MTOPOLOGY,
           METRIZABLE_IMP_T1_SPACE, CLOSED_IMP_GDELTA_IN, OPEN_IMP_FSIGMA_IN,
           FIRST_COUNTABLE_MTOPOLOGY, METRIZABLE_IMP_FIRST_COUNTABLE }

/- ------------------------------------------------------------------------- -/
/- Separable metrizable spaces are second-countable. Additional              -/
/- second-countability results including closed map images.                  -/
/- (metric.ml 13266-13466)                                                    -/
/- ------------------------------------------------------------------------- -/

structure SepMetrizable where
  SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE : thm
  SECOND_COUNTABLE_CLOSED_MAP_IMAGE : thm
  deriving Inhabited

@[nospecialize]
def setupSepMetrizable [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BContMap1 : ContMap1) (BOpenClosed1 : OpenClosed1) (BCompact1 : Compact1) (BT1a : T1a)
    (BHausdorff1 : Hausdorff1) (BCountability : Countability) (BMetricSpace : MetricSpace)
    (BMTopology : MTopology) (BMetrizable : Metrizable) : ExceptT String IO SepMetrizable := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_TAC, .. } := D
  let { EXISTS_IN_IMAGE, FORALL_IN_IMAGE, .. } := D.core1
  let { IN_CROSS, IN_DIFF, IN_ELIM_THM, IN_IMAGE, IN_SING, IN_UNIONS, .. } := D.core2
  let { REAL_LET_TRANS, .. } := D.core3
  let { SUBSET, UNIONS_SUBSET, .. } := D.core4
  let { EXISTS_PAIR_THM, FORALL_PAIR_THM, NOT_EXISTS_THM, .. } := D.core5
  let { COUNTABLE_RATIONAL, REAL_HALF, .. } := D.misc
  let { COUNTABLE_CROSS, COUNTABLE_FINITE_SUBSETS, COUNTABLE_IMAGE, COUNTABLE_SUBSET,
        RATIONAL_BETWEEN, .. } := D.lib
  let { CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE, OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE,
        OPEN_IN_UNIONS, .. } := BTopology
  let { IN_CLOSURE_OF, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { closed_map, .. } := BOpenClosed1
  let { CLOSED_IN_COMPACT_SPACE, compact_in, .. } := BCompact1
  let { CLOSED_IN_T1_SING, .. } := BT1a
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { second_countable, separable_space, .. } := BCountability
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_POS_LE, MDIST_SYM, MDIST_TRIANGLE, .. } := BMetricSpace
  let { OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { metrizable_space, .. } := BMetrizable
  -- @@SCOPE END

  let SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE ← prove
   r"!top:A topology.
        separable_space top /\ metrizable_space top ==> second_countable top"
   (GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [metrizable_space]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"m:A metric") SUBST_ALL_TAC) THEN
    FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [separable_space]) THEN
    REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"D:A->bool") STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [second_countable] THEN
    EXISTS_TAC
      (← q r"IMAGE (\(d:A,r:real). mball m (d,r))
             (D CROSS {r | rational r /\ &0 < r})") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_IMAGE THEN
      MATCH_MP_TAC COUNTABLE_CROSS THEN
      ASM_REWRITE_TAC [] THEN MATCH_MP_TAC COUNTABLE_SUBSET THEN
      EXISTS_TAC (← q r"rational") THEN
      REWRITE_TAC [COUNTABLE_RATIONAL] THEN SET_TAC [],
      REWRITE_TAC [FORALL_IN_IMAGE, FORALL_PAIR_THM,
                   IN_CROSS, IN_ELIM_THM] THEN
      SIMP_TAC [OPEN_IN_MBALL],
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [OPEN_IN_MTOPOLOGY]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"x:A"))) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"r:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"x:A IN mspace m") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"?d:A. d IN D /\ d IN mball m (x, r / &2)")
        STRIP_ASSUME_TAC THENL
       [MP_TAC (← ISPECL [← q r"mtopology m:A topology",
          ← q r"D:A->bool", ← q r"x:A"] IN_CLOSURE_OF) THEN
        ASM_REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"mball m (x:A, r / &2)")) THEN
        ASM_SIMP_TAC [OPEN_IN_MBALL, CENTRE_IN_MBALL,
                      REAL_HALF] THEN
        MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"d:A IN mspace m") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      ABBREV_TAC (← q r"delta = mdist m (x:A,d)") THEN
      SUBGOAL_THEN (← q r"delta < r / &2") ASSUME_TAC THENL
       [UNDISCH_TAC (← q r"(d:A) IN mball m (x:A, r / &2)") THEN
        REWRITE_TAC [IN_MBALL] THEN EXPAND_TAC "delta" THEN
        MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"delta < r - delta") ASSUME_TAC THENL
       [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MP_TAC (← SPECL [← q r"delta:real", ← q r"r - delta:real"]
        RATIONAL_BETWEEN) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"q:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"&0 < q") ASSUME_TAC THENL
       [SUBGOAL_THEN (← q r"&0 <= delta") MP_TAC THENL
         [EXPAND_TAC "delta" THEN MATCH_MP_TAC MDIST_POS_LE THEN
          ASM_REWRITE_TAC [],
          ASM_REAL_ARITH_TAC], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"mdist m (d:A,x) = mdist m (x,d)") ASSUME_TAC THENL
       [MATCH_MP_TAC MDIST_SYM THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, EXISTS_PAIR_THM, IN_CROSS,
                   IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"d:A") THEN EXISTS_TAC (← q r"q:real") THEN
      ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
       [REWRITE_TAC [IN_MBALL] THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [SUBSET, IN_MBALL] THEN
        X_GEN_TAC (← q r"y:A") THEN ASM_REWRITE_TAC [] THEN
        STRIP_TAC THEN
        FIRST_X_ASSUM (MP_TAC o
          GEN_REWRITE_RULE id [SUBSET]) THEN
        DISCH_THEN MATCH_MP_TAC THEN
        REWRITE_TAC [IN_MBALL] THEN ASM_REWRITE_TAC [] THEN
        TRANS_TAC REAL_LET_TRANS
          (← q r"mdist m (x:A,d) + mdist m (d,y)") THEN
        CONJ_TAC THENL
         [MATCH_MP_TAC MDIST_TRIANGLE THEN ASM_REWRITE_TAC [],
          ASM_REAL_ARITH_TAC]]])

  let SECOND_COUNTABLE_CLOSED_MAP_IMAGE ← prove
   r"!(f:B->C) top top'.
        continuous_map(top,top') f /\
        closed_map(top,top') f /\
        compact_space top /\
        hausdorff_space top' /\
        IMAGE f (topspace top) = topspace top' /\
        second_countable top
        ==> second_countable top'"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o
      GEN_REWRITE_RULE id [second_countable]) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"B:(B->bool)->bool")
      STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [second_countable] THEN EXISTS_TAC
      (← q r"IMAGE (\G. topspace top' DIFF
                  IMAGE (f:B->C) (topspace top DIFF UNIONS G))
             {G:(B->bool)->bool | G SUBSET B /\ FINITE G}") THEN
    REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC COUNTABLE_IMAGE THEN
      MATCH_MP_TAC COUNTABLE_FINITE_SUBSETS THEN
      ASM_REWRITE_TAC [],
      REWRITE_TAC [FORALL_IN_IMAGE, IN_ELIM_THM] THEN
      X_GEN_TAC (← q r"G:(B->bool)->bool") THEN STRIP_TAC THEN
      MATCH_MP_TAC OPEN_IN_DIFF THEN
      REWRITE_TAC [OPEN_IN_TOPSPACE] THEN
      FIRST_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [closed_map]) THEN
      DISCH_THEN MATCH_MP_TAC THEN
      MATCH_MP_TAC CLOSED_IN_DIFF THEN
      REWRITE_TAC [CLOSED_IN_TOPSPACE] THEN
      MATCH_MP_TAC OPEN_IN_UNIONS THEN ASM_MESON_TAC [SUBSET],
      MAP_EVERY X_GEN_TAC [← q r"v:C->bool", ← q r"y:C"] THEN
      STRIP_TAC THEN
      REWRITE_TAC [EXISTS_IN_IMAGE, IN_ELIM_THM] THEN
      SUBGOAL_THEN (← q r"y:C IN topspace top'") ASSUME_TAC THENL
       [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"closed_in top
          {x:B | x IN topspace top /\ (f:B->C) x IN {y:C}}")
        ASSUME_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':C topology") THEN
        ASM_REWRITE_TAC [] THEN
        MATCH_MP_TAC CLOSED_IN_T1_SING THEN
        ASM_SIMP_TAC [HAUSDORFF_IMP_T1_SPACE], ALL_TAC] THEN
      ABBREV_TAC
        (← q r"fib = {x:B | x IN topspace top /\
                       (f:B->C) x IN {y:C}}") THEN
      SUBGOAL_THEN (← q r"compact_in top (fib:B->bool)") ASSUME_TAC THENL
       [ASM_MESON_TAC [CLOSED_IN_COMPACT_SPACE], ALL_TAC] THEN
      ABBREV_TAC
        (← q r"preim = {x:B | x IN topspace top /\
                         (f:B->C) x IN v}") THEN
      SUBGOAL_THEN (← q r"open_in top (preim:B->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "preim" THEN
        MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':C topology") THEN ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      SUBGOAL_THEN (← q r"fib SUBSET (preim:B->bool)") ASSUME_TAC THENL
       [EXPAND_TAC "fib" THEN EXPAND_TAC "preim" THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN
        ASM SET_TAC [], ALL_TAC] THEN
      ABBREV_TAC
        (← q r"cov = {w:B->bool | w IN B /\ w SUBSET preim}") THEN
      SUBGOAL_THEN
        (← q r"fib SUBSET UNIONS (cov:(B->bool)->bool)")
        ASSUME_TAC THENL
       [REWRITE_TAC [SUBSET, IN_UNIONS] THEN
        X_GEN_TAC (← q r"a:B") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(a:B) IN preim") ASSUME_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        FIRST_X_ASSUM (MP_TAC o
          SPECL [← q r"preim:B->bool", ← q r"a:B"]) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"w:B->bool")
          STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"w:B->bool") THEN ASM_REWRITE_TAC [] THEN
        EXPAND_TAC "cov" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_REWRITE_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"!w:B->bool. w IN cov ==> open_in top w")
        ASSUME_TAC THENL
       [EXPAND_TAC "cov" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        ASM_MESON_TAC [], ALL_TAC] THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [compact_in]) THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
        (MP_TAC o SPEC (← q r"cov:(B->bool)->bool"))) THEN
      ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"G:(B->bool)->bool")
        STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"G:(B->bool)->bool") THEN
      SUBGOAL_THEN (← q r"(G:(B->bool)->bool) SUBSET B") ASSUME_TAC THENL
       [EXPAND_TAC "cov" THEN ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"UNIONS G SUBSET (preim:B->bool)") ASSUME_TAC THENL
       [REWRITE_TAC [UNIONS_SUBSET] THEN
        X_GEN_TAC (← q r"w:B->bool") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"(w:B->bool) IN cov") MP_TAC THENL
         [ASM SET_TAC [], ALL_TAC] THEN
        EXPAND_TAC "cov" THEN REWRITE_TAC [IN_ELIM_THM] THEN
        MESON_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
       [REWRITE_TAC [IN_DIFF, IN_IMAGE, NOT_EXISTS_THM] THEN
        ASM_REWRITE_TAC [] THEN X_GEN_TAC (← q r"a:B") THEN
        REWRITE_TAC [IN_DIFF] THEN STRIP_TAC THEN
        SUBGOAL_THEN (← q r"(a:B) IN fib") MP_TAC THENL
         [EXPAND_TAC "fib" THEN ASM SET_TAC [], ALL_TAC] THEN
        ASM SET_TAC [], ALL_TAC] THEN
      REWRITE_TAC [SUBSET, IN_DIFF] THEN
      X_GEN_TAC (← q r"z:C") THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"?a:B. a IN topspace top /\ (f:B->C) a = z")
        STRIP_ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"(a:B) IN UNIONS G") ASSUME_TAC THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      EXPAND_TAC "preim" THEN ASM SET_TAC []])

  return { SEPARABLE_METRIZABLE_IMP_SECOND_COUNTABLE, SECOND_COUNTABLE_CLOSED_MAP_IMAGE }

/- ------------------------------------------------------------------------- -/
/- Connected topological spaces.  (metric.ml 13468-13657)                    -/
/- ------------------------------------------------------------------------- -/

structure Connected1 where
  connected_space : thm
  connected_in : thm
  CONNECTED_IN_SUBSET_TOPSPACE : thm
  CONNECTED_IN_TOPSPACE : thm
  CONNECTED_SPACE_SUBTOPOLOGY : thm
  CONNECTED_IN_SUBTOPOLOGY : thm
  CONNECTED_SPACE_EQ : thm
  CONNECTED_SPACE_CLOSED_IN : thm
  CONNECTED_SPACE_CLOSED_IN_EQ : thm
  CONNECTED_SPACE_CLOPEN_IN : thm
  CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY : thm
  CONNECTED_SPACE_FRONTIER_EQ_EMPTY : thm
  CONNECTED_IN : thm
  CONNECTED_IN_CLOSED_IN : thm
  CONNECTED_IN_EMPTY : thm
  CONNECTED_SPACE_TOPSPACE_EMPTY : thm
  CONNECTED_IN_SING : thm
  CONNECTED_IN_ABSOLUTE : thm
  CONNECTED_IN_UNIONS : thm
  deriving Inhabited

@[nospecialize]
def setupConnected1 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BFrontier : Frontier) : ExceptT String IO Connected1 := do
  -- @@SCOPE BEGIN
  let { MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, EMPTY_SUBSET, .. } := D.core1
  let { INTER_ACI, INTER_EMPTY, IN_INTER, IN_INTERS, IN_UNIONS, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET_INTER, SUBSET_REFL, UNIONS_SUBSET, UNWIND_THM2, .. } := D.core4
  let { FORALL_AND_THM, MONO_AND, NOT_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_SUBSET, CLOSED_IN_TOPSPACE, OPEN_IN_CLOSED_IN_EQ,
        OPEN_IN_DIFF, OPEN_IN_SUBSET, OPEN_IN_TOPSPACE, closed_in, .. } := BTopology
  let { CLOSED_IN_SUBTOPOLOGY, OPEN_IN_SUBTOPOLOGY, SUBTOPOLOGY_SUBTOPOLOGY,
        SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOPEN_IN_EQ_FRONTIER_OF, FRONTIER_OF_EMPTY, FRONTIER_OF_TOPSPACE, .. } := BFrontier
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let connected_space ← new_definition
    r"connected_space(top:A topology) <=>
        ~(?e1 e2. open_in top e1 /\ open_in top e2 /\
                  topspace top SUBSET e1 UNION e2 /\ e1 INTER e2 = {} /\
                  ~(e1 = {}) /\ ~(e2 = {}))"

  let connected_in ← new_definition
   r"connected_in top s <=>
  s SUBSET topspace top /\ connected_space (subtopology top s)"

  let CONNECTED_IN_SUBSET_TOPSPACE ← prove
   r"!top s:A->bool. connected_in top s ==> s SUBSET topspace top"
   (SIMP_TAC [connected_in])

  let CONNECTED_IN_TOPSPACE ← prove
   r"!top:A topology. connected_in top (topspace top) <=> connected_space top"
   (REWRITE_TAC [connected_in, SUBSET_REFL, SUBTOPOLOGY_TOPSPACE])

  let CONNECTED_SPACE_SUBTOPOLOGY ← prove
   r"!top s:A->bool.
        connected_in top s ==> connected_space (subtopology top s)"
   (SIMP_TAC [connected_in])

  let CONNECTED_IN_SUBTOPOLOGY ← prove
   r"!top s t:A->bool.
      connected_in (subtopology top s) t <=> connected_in top t /\ t SUBSET s"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [connected_in, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER] THEN
    ASM_CASES_TAC (← q r"(t:A->bool) SUBSET s") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← sr r"t SUBSET s ==> s INTER t = t"])

  let CONNECTED_SPACE_EQ ← prove
   r"!top:A topology.
        connected_space(top:A topology) <=>
        ~(?e1 e2. open_in top e1 /\ open_in top e2 /\
                  e1 UNION e2 = topspace top /\ e1 INTER e2 = {} /\
                  ~(e1 = {}) /\ ~(e2 = {}))"
   (REWRITE_TAC [← sr
     r"s UNION t = u <=> u SUBSET s UNION t /\ s SUBSET u /\ t SUBSET u"] THEN
    REWRITE_TAC [connected_space] THEN MESON_TAC [OPEN_IN_SUBSET])

  let CONNECTED_SPACE_CLOSED_IN ← prove
   r"!top:A topology.
        connected_space(top:A topology) <=>
        ~(?e1 e2. closed_in top e1 /\ closed_in top e2 /\
                  topspace top SUBSET e1 UNION e2 /\ e1 INTER e2 = {} /\
                  ~(e1 = {}) /\ ~(e2 = {}))"
   (GEN_TAC THEN REWRITE_TAC [connected_space] THEN AP_TERM_TAC THEN
    EQ_TAC THEN REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC
     [← q r"topspace top DIFF v:A->bool", ← q r"topspace top DIFF u:A->bool"] THEN
    ASM_SIMP_TAC [CLOSED_IN_DIFF, CLOSED_IN_TOPSPACE,
                  OPEN_IN_DIFF, OPEN_IN_TOPSPACE] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CONNECTED_SPACE_CLOSED_IN_EQ ← prove
   r"!top:A topology.
        connected_space(top:A topology) <=>
        ~(?e1 e2. closed_in top e1 /\ closed_in top e2 /\
                  e1 UNION e2 = topspace top /\ e1 INTER e2 = {} /\
                  ~(e1 = {}) /\ ~(e2 = {}))"
   (REWRITE_TAC [← sr
     r"s UNION t = u <=> u SUBSET s UNION t /\ s SUBSET u /\ t SUBSET u"] THEN
    REWRITE_TAC [CONNECTED_SPACE_CLOSED_IN] THEN MESON_TAC [CLOSED_IN_SUBSET])

  let CONNECTED_SPACE_CLOPEN_IN ← prove
   r"!top:A topology.
        connected_space top <=>
        !t. open_in top t /\ closed_in top t ==> t = {} \/ t = topspace top"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_SPACE_EQ] THEN SIMP_TAC [OPEN_IN_SUBSET,
       ← sr r"(open_in top e1 ==> e1 SUBSET topspace top) /\
                 (open_in top e2 ==> e2 SUBSET topspace top)
                 ==> (open_in top e1 /\ open_in top e2 /\
                      e1 UNION e2 = topspace top /\ e1 INTER e2 = {} /\ P <=>
                      e2 = topspace top DIFF e1 /\
                      open_in top e1 /\ open_in top e2 /\ P)"] THEN
    REWRITE_TAC [UNWIND_THM2, closed_in] THEN
    REWRITE_TAC [NOT_EXISTS_THM] THEN AP_TERM_TAC THEN ABS_TAC THEN
    ONCE_REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN SET_TAC [])

  let CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY ← prove
   r"!top:A topology.
        connected_space top <=>
        !s. s SUBSET topspace top /\ top frontier_of s = {}
            ==> s = {} \/ s = topspace top"
   (REWRITE_TAC [CONNECTED_SPACE_CLOPEN_IN] THEN
    MESON_TAC [CLOPEN_IN_EQ_FRONTIER_OF])

  let CONNECTED_SPACE_FRONTIER_EQ_EMPTY ← prove
   r"!top s:A->bool.
        connected_space top /\ s SUBSET topspace top
        ==> (top frontier_of s = {} <=> s = {} \/ s = topspace top)"
   (MESON_TAC [CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY,
               FRONTIER_OF_EMPTY, FRONTIER_OF_TOPSPACE])

  let CONNECTED_IN ← prove
   r"!top s:A->bool.
        connected_in top s <=>
        s SUBSET topspace top /\
        ~(?e1 e2. open_in top e1 /\ open_in top e2 /\
                  s SUBSET (e1 UNION e2) /\
                  (e1 INTER e2 INTER s = {}) /\
                  ~(e1 INTER s = {}) /\ ~(e2 INTER s = {}))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_in] THEN MATCH_MP_TAC
     (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN DISCH_TAC THEN
    REWRITE_TAC [connected_space, OPEN_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← MESON [] (← q
     r"(?e1 e2. (?t1. P1 t1 /\ e1 = f1 t1) /\ (?t2. P2 t2 /\ e2 = f2 t2) /\
               R e1 e2) <=> (?t1 t2. P1 t1 /\ P2 t2 /\ R(f1 t1) (f2 t2))")] THEN
    AP_TERM_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_CLOSED_IN ← prove
   r"!top s:A->bool.
        connected_in top s <=>
        s SUBSET topspace top /\
        ~(?e1 e2. closed_in top e1 /\ closed_in top e2 /\
                  s SUBSET (e1 UNION e2) /\
                  (e1 INTER e2 INTER s = {}) /\
                  ~(e1 INTER s = {}) /\ ~(e2 INTER s = {}))"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_in] THEN MATCH_MP_TAC
     (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN DISCH_TAC THEN
    REWRITE_TAC [CONNECTED_SPACE_CLOSED_IN, CLOSED_IN_SUBTOPOLOGY] THEN
    REWRITE_TAC [← MESON [] (← q
     r"(?e1 e2. (?t1. P1 t1 /\ e1 = f1 t1) /\ (?t2. P2 t2 /\ e2 = f2 t2) /\
               R e1 e2) <=> (?t1 t2. P1 t1 /\ P2 t2 /\ R(f1 t1) (f2 t2))")] THEN
    AP_TERM_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
    EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP CLOSED_IN_SUBSET)) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_EMPTY ← prove
   r"!top:A topology. connected_in top {}"
   (REWRITE_TAC [CONNECTED_IN, EMPTY_SUBSET, INTER_EMPTY])

  let CONNECTED_SPACE_TOPSPACE_EMPTY ← prove
   r"!top:A topology. topspace top = {} ==> connected_space top"
   (MESON_TAC [SUBTOPOLOGY_TOPSPACE, connected_in, CONNECTED_IN_EMPTY])

  let CONNECTED_IN_SING ← prove
   r"!top a:A. connected_in top {a} <=> a IN topspace top"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [CONNECTED_IN_SUBSET_TOPSPACE, SING_SUBSET],
      SIMP_TAC [CONNECTED_IN, SING_SUBSET] THEN SET_TAC []])

  let CONNECTED_IN_ABSOLUTE ← prove
   r"!top s:A->bool. connected_in (subtopology top s) s <=> connected_in top s"
   (REWRITE_TAC [connected_in, SUBTOPOLOGY_SUBTOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_SUBTOPOLOGY, SUBSET_INTER, SUBSET_REFL] THEN
    REWRITE_TAC [INTER_ACI])

  let CONNECTED_IN_UNIONS ← prove
   r"!top u:(A->bool)->bool.
        (!s. s IN u ==> connected_in top s) /\ ~(INTERS u = {})
        ==> connected_in top (UNIONS u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONNECTED_IN, NOT_EXISTS_THM] THEN
    GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV)
     [← TAUT (← q r"p ==> q /\ r <=> (p ==> q) /\ (p ==> r)")] THEN
    REWRITE_TAC [FORALL_AND_THM, ← GSYM CONJ_ASSOC] THEN MATCH_MP_TAC MONO_AND THEN
    CONJ_TAC THENL [REWRITE_TAC [UNIONS_SUBSET], ALL_TAC] THEN
    STRIP_TAC THEN MAP_EVERY X_GEN_TAC [← q r"e1:A->bool", ← q r"e2:A->bool"] THEN
    STRIP_TAC THEN UNDISCH_TAC (← q r"~(INTERS u :A->bool = {})") THEN
    PURE_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTERS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"a:A") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN (← q r"(a:A) IN e1 \/ a IN e2") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [],
      UNDISCH_TAC (← q r"~(e2 INTER UNIONS u:A->bool = {})"),
      UNDISCH_TAC (← q r"~(e1 INTER UNIONS u:A->bool = {})")] THEN
    PURE_REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"b:A")
     (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    UNDISCH_TAC (← q r"!t:A->bool. t IN u ==> a IN t") THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"s:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN DISCH_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"e1:A->bool", ← q r"e2:A->bool"]) THEN
    ASM SET_TAC [])

  return { connected_space, connected_in, CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_TOPSPACE,
           CONNECTED_SPACE_SUBTOPOLOGY, CONNECTED_IN_SUBTOPOLOGY, CONNECTED_SPACE_EQ,
           CONNECTED_SPACE_CLOSED_IN, CONNECTED_SPACE_CLOSED_IN_EQ, CONNECTED_SPACE_CLOPEN_IN,
           CONNECTED_SPACE_EQ_FRONTIER_EQ_EMPTY, CONNECTED_SPACE_FRONTIER_EQ_EMPTY,
           CONNECTED_IN, CONNECTED_IN_CLOSED_IN, CONNECTED_IN_EMPTY,
           CONNECTED_SPACE_TOPSPACE_EMPTY, CONNECTED_IN_SING, CONNECTED_IN_ABSOLUTE,
           CONNECTED_IN_UNIONS }

/- ------------------------------------------------------------------------- -/
/- Connected topological spaces, continued.  (metric.ml 13659-13870)         -/
/- ------------------------------------------------------------------------- -/

structure Connected2 where
  CONNECTED_IN_UNION : thm
  CONNECTED_SPACE_SUBCONNECTED : thm
  CONNECTED_IN_INTERMEDIATE_CLOSURE_OF : thm
  CONNECTED_IN_CLOSURE_OF : thm
  CONNECTED_IN_SEPARATION : thm
  CONNECTED_IN_SEPARATION_ALT : thm
  CONNECTED_IN_EQ_NOT_SEPARATED : thm
  CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET : thm
  CONNECTED_SPACE_EQ_NOT_SEPARATED : thm
  CONNECTED_SPACE_EQ_NOT_SEPARATED_SUBSET : thm
  CONNECTED_IN_SUBSET_SEPARATED_UNION : thm
  CONNECTED_IN_NONSEPARATED_UNION : thm
  CONNECTED_IN_UNIONS_STRONG : thm
  irreducible_in : thm
  IRREDUCIBLE_IN_SING : thm
  IRREDUCIBLE_IN_CLOSURE_OF : thm
  IRREDUCIBLE_IN_CONTINUOUS_MAP_IMAGE : thm
  IRREDUCIBLE_IMP_CONNECTED_IN : thm
  sober_space : thm
  deriving Inhabited

@[nospecialize]
def setupConnected2 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BClosure : Closure) (BSeparated : Separated)
    (BConnected1 : Connected1) (BContMap1 : ContMap1) : ExceptT String IO Connected2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { AND_FORALL_THM, FORALL_IN_GSPEC, IMAGE_EQ_EMPTY, .. } := D.core1
  let { IMAGE_SUBSET, IMP_CONJ, IMP_CONJ_ALT, INTERS_2, INTERS_GSPEC, INTER_SUBSET, IN_ELIM_THM,
        IN_INTER, IN_UNION, IN_UNIONS, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, MONO_EXISTS,
        NOT_INSERT_EMPTY, .. } := D.core2
  let { SING_SUBSET, SUBSET, SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, UNIONS_2, UNION_SUBSET,
        .. } := D.core4
  let { CONTRAPOS_THM, DE_MORGAN_THM, NOT_EXISTS_THM, RIGHT_AND_FORALL_THM, .. } := D.core5
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { SUBTOPOLOGY_TOPSPACE, TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSED_IN_CLOSURE_OF, CLOSED_IN_INTER_CLOSURE_OF, CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBSET,
        CLOSURE_OF_SUBSET_INTER, CLOSURE_OF_SUBSET_TOPSPACE, OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY,
        .. } := BClosure
  let { SEPARATED_IN_MONO, SEPARATED_IN_SYM, separated_in, .. } := BSeparated
  let { CONNECTED_IN, CONNECTED_IN_CLOSED_IN, CONNECTED_IN_TOPSPACE, CONNECTED_IN_UNIONS,
        CONNECTED_SPACE_CLOSED_IN_EQ, connected_in, connected_space, .. } := BConnected1
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, .. } := BContMap1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONNECTED_IN_UNION ← prove
   r"!top s t:A->bool.
        connected_in top s /\ connected_in top t /\ ~(s INTER t = {})
        ==> connected_in top (s UNION t)"
   (REWRITE_TAC [← GSYM UNIONS_2, ← GSYM INTERS_2] THEN
    REPEAT STRIP_TAC THEN MATCH_MP_TAC CONNECTED_IN_UNIONS THEN
    ASM SET_TAC [])

  let CONNECTED_SPACE_SUBCONNECTED ← prove
   r"!top:A topology.
        connected_space top <=>
        !x y. x IN topspace top /\ y IN topspace top
              ==> ?s. connected_in top s /\ x IN s /\ y IN s"
   (GEN_TAC THEN EQ_TAC THENL
     [REPEAT STRIP_TAC THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
      ASM_REWRITE_TAC [SUBTOPOLOGY_TOPSPACE, connected_in, SUBSET_REFL],
      DISCH_TAC] THEN
    REWRITE_TAC [connected_space, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
    REPLICATE_TAC 4 (DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC)) THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_TAC (← q r"a:A")) (X_CHOOSE_TAC (← q r"b:A"))) THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"a:A", ← q r"b:A"]) THEN ANTS_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, SUBSET], ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"t:A->bool") STRIP_ASSUME_TAC) THEN
    FIRST_X_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
      GEN_REWRITE_RULE id [CONNECTED_IN]) THEN
    ASM_REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
    ASM SET_TAC [])

  let CONNECTED_IN_INTERMEDIATE_CLOSURE_OF ← prove
   r"!top s t:A->bool.
        connected_in top s /\ s SUBSET t /\ t SUBSET top closure_of s
        ==> connected_in top t"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONNECTED_IN, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    DISCH_THEN (fun th => CONJ_TAC THEN MP_TAC th) THENL
     [DISCH_THEN (K ALL_TAC) THEN MP_TAC (← ISPECL
        [← q r"top:A topology", ← q r"s:A->bool"] CLOSURE_OF_SUBSET_TOPSPACE) THEN
      ASM SET_TAC [],
      REWRITE_TAC [CONTRAPOS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"u:A->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"v:A->bool") THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"u:A->bool", ← q r"s:A->bool"]
          OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"v:A->bool", ← q r"s:A->bool"]
          OPEN_IN_INTER_CLOSURE_OF_EQ_EMPTY) THEN
      ASM SET_TAC []])

  let CONNECTED_IN_CLOSURE_OF ← prove
   r"!top s:A->bool. connected_in top s ==> connected_in top (top closure_of s)"
   (REPEAT GEN_TAC THEN DISCH_THEN (fun th => tactic_of do
      pure (ASSUME_TAC (← CONJUNCT1 (← REWRITE_RULE [connected_in] th)) THEN MP_TAC th)) THEN
    MATCH_MP_TAC (← ONCE_REWRITE_RULE [IMP_CONJ_ALT]
      CONNECTED_IN_INTERMEDIATE_CLOSURE_OF) THEN
    ASM_SIMP_TAC [SUBSET_REFL, CLOSURE_OF_SUBSET])

  let (CONNECTED_IN_SEPARATION, CONNECTED_IN_SEPARATION_ALT) ← CONJ_PAIR (← prove
   r"(!top s:A->bool.
        connected_in top s <=>
        s SUBSET topspace top /\
        ~(?c1 c2. c1 UNION c2 = s /\ ~(c1 = {}) /\ ~(c2 = {}) /\
                  c1 INTER top closure_of c2 = {} /\
                  c2 INTER top closure_of c1 = {})) /\
   (!top s:A->bool.
        connected_in top s <=>
        s SUBSET topspace top /\
        ~(?c1 c2.
            s SUBSET c1 UNION c2 /\ ~(c1 INTER s = {}) /\ ~(c2 INTER s = {}) /\
            c1 INTER top closure_of c2 = {} /\
            c2 INTER top closure_of c1 = {}))"
   (REWRITE_TAC [AND_FORALL_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"top: A topology", ← q r"s:A->bool"] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THENL
     [ASM_REWRITE_TAC [], ASM_MESON_TAC [connected_in]] THEN
    MATCH_MP_TAC (← TAUT (← q
     r"(q ==> r) /\ (~q ==> p) /\ (r ==> ~p)
      ==> (p <=> ~q) /\ (p <=> ~r)")) THEN
    REPEAT CONJ_TAC THENL
     [REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SET_TAC [],
      ASM_REWRITE_TAC [connected_in, CONNECTED_SPACE_CLOSED_IN_EQ] THEN
      REWRITE_TAC [CLOSED_IN_INTER_CLOSURE_OF, CONTRAPOS_THM] THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c1:A->bool") THEN
      MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"c2:A->bool") THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN ASM SET_TAC [],
      REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c1:A->bool", ← q r"c2:A->bool"] THEN
      STRIP_TAC THEN ASM_REWRITE_TAC [CONNECTED_IN_CLOSED_IN] THEN
      MAP_EVERY EXISTS_TAC
       [← q r"top closure_of c1:A->bool", ← q r"top closure_of c2:A->bool"] THEN
      REWRITE_TAC [CLOSED_IN_CLOSURE_OF] THEN
      MP_TAC (← ISPEC (← q r"top:A topology") CLOSURE_OF_SUBSET_INTER) THEN DISCH_THEN
       (fun th => tactic_of do
          pure (MP_TAC (← SPEC (← q r"c1:A->bool") th) THEN
                MP_TAC (← SPEC (← q r"c2:A->bool") th))) THEN
      ASM SET_TAC []]))

  let CONNECTED_IN_EQ_NOT_SEPARATED ← prove
   r"!top s:A->bool.
         connected_in top s <=>
         s SUBSET topspace top /\
         ~(?c1 c2. c1 UNION c2 = s /\ ~(c1 = {}) /\ ~(c2 = {}) /\
                   separated_in top c1 c2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_in, CONNECTED_IN_SEPARATION] THEN
    REWRITE_TAC [NOT_EXISTS_THM, RIGHT_AND_FORALL_THM] THEN
    REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN SET_TAC [])

  let CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET ← prove
   r"!top s:A->bool.
         connected_in top s <=>
         s SUBSET topspace top /\
         ~(?c1 c2. s SUBSET c1 UNION c2 /\
                   ~(s INTER c1 = {}) /\ ~(s INTER c2 = {}) /\
                   separated_in top c1 c2)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top") THEN ASM_REWRITE_TAC [] THEN
    AP_TERM_TAC THEN EQ_TAC THENL
     [REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c1:A->bool", ← q r"c2:A->bool"] THEN STRIP_TAC THEN
    MAP_EVERY EXISTS_TAC [← q r"s INTER c1:A->bool", ← q r"s INTER c2:A->bool"] THEN
    ASM_REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    ASM_MESON_TAC [SEPARATED_IN_MONO, INTER_SUBSET])

  let CONNECTED_SPACE_EQ_NOT_SEPARATED ← prove
   r"!top:A topology.
        connected_space top <=>
        ~(?c1 c2. c1 UNION c2 = topspace top /\ ~(c1 = {}) /\ ~(c2 = {}) /\
                  separated_in top c1 c2)"
   (REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE, CONNECTED_IN_EQ_NOT_SEPARATED] THEN
    REWRITE_TAC [SUBSET_REFL])

  let CONNECTED_SPACE_EQ_NOT_SEPARATED_SUBSET ← prove
   r"!top:A topology.
      connected_space top <=>
      ~(?c1 c2. topspace top SUBSET c1 UNION c2 /\ ~(c1 = {}) /\ ~(c2 = {}) /\
                separated_in top c1 c2)"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_SPACE_EQ_NOT_SEPARATED] THEN
    AP_TERM_TAC THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    REWRITE_TAC [separated_in] THEN SET_TAC [])

  let CONNECTED_IN_SUBSET_SEPARATED_UNION ← prove
   r"!top s t c:A->bool.
        connected_in top c /\ separated_in top s t /\ c SUBSET s UNION t
        ==> c SUBSET s \/ c SUBSET t"
   (REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, NOT_EXISTS_THM] THEN
    REPEAT STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"s:A->bool", ← q r"t:A->bool"]) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_NONSEPARATED_UNION ← prove
   r"!top s t:A->bool.
        connected_in top s /\ connected_in top t /\ ~separated_in top s t
        ==> connected_in top (s UNION t)"
   (REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, UNION_SUBSET] THEN
    REPEAT GEN_TAC THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"c1:A->bool", ← q r"c2:A->bool"] THEN STRIP_TAC THEN
    REPEAT (FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c1:A->bool", ← q r"c2:A->bool"])) THEN
    ASM_REWRITE_TAC [DE_MORGAN_THM] THEN REPEAT STRIP_TAC THENL
     [ASM SET_TAC [], ALL_TAC, ALL_TAC, ASM SET_TAC []] THEN
    UNDISCH_TAC (← q r"~separated_in top (s:A->bool) t") THEN REWRITE_TAC [] THENL
     [ONCE_REWRITE_TAC [SEPARATED_IN_SYM], ALL_TAC] THEN
    FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ]
          SEPARATED_IN_MONO)) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_UNIONS_STRONG ← prove
   r"!(top:A topology) f:(A->bool)->bool.
        (!s. s IN f ==> connected_in top s) /\
        ~(UNIONS f INTER INTERS {top closure_of s | s IN f} = {})
        ==> connected_in top (UNIONS f)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_INTER, IN_UNIONS, INTERS_GSPEC] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN STRIP_TAC THEN
    /- Now we have assumptions:
       0: !s. s IN f ==> connected_in top s
       1: t IN f
       2: x IN t
       3: !s. s IN f ==> x IN top closure_of s -/
    /- Define g = {t UNION s | s IN f} where t is our witness set containing x -/
    SUBGOAL_THEN
      (← q r"UNIONS f :A->bool = UNIONS {(t:A->bool) UNION s | s IN f}")
      SUBST1_TAC THENL
     [MATCH_MP_TAC (← sr
        r"(t:A->bool) IN f /\ (!s. s IN f ==> s SUBSET t UNION s) /\
         (!s. s IN f ==> t UNION s SUBSET UNIONS f)
         ==> UNIONS f = UNIONS {t UNION s | s IN f}") THEN
      ASM_REWRITE_TAC [] THEN
      CONJ_TAC THENL [SET_TAC [], ALL_TAC] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      REWRITE_TAC [UNION_SUBSET] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC CONNECTED_IN_UNIONS THEN CONJ_TAC THENL
     [/- Each t UNION s is connected -/
      REWRITE_TAC [FORALL_IN_GSPEC] THEN X_GEN_TAC (← q r"u:A->bool") THEN DISCH_TAC THEN
      MATCH_MP_TAC CONNECTED_IN_NONSEPARATED_UNION THEN
      REPEAT CONJ_TAC THENL
       [FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
        FIRST_X_ASSUM MATCH_MP_TAC THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [separated_in, DE_MORGAN_THM] THEN
        DISJ2_TAC THEN DISJ2_TAC THEN DISJ1_TAC THEN
        REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"x:A") THEN
        ASM_REWRITE_TAC [IN_INTER] THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
        ASM_REWRITE_TAC []],
      /- INTERS {t UNION s | s IN f} is non-empty -/
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, INTERS_GSPEC, IN_ELIM_THM] THEN
      EXISTS_TAC (← q r"x:A") THEN X_GEN_TAC (← q r"v:A->bool") THEN
      DISCH_TAC THEN ASM_REWRITE_TAC [IN_UNION]])

  /- Irreducible sets and sober spaces. A nonempty subset s of topspace top is -/
  /- irreducible when it lies in one of any two closed sets covering it        -/
  /- (irreducible_in). Singletons are irreducible (IRREDUCIBLE_IN_SING); so    -/
  /- are closures and continuous images of irreducible sets                    -/
  /- (IRREDUCIBLE_IN_CLOSURE_OF, IRREDUCIBLE_IN_CONTINUOUS_MAP_IMAGE), and     -/
  /- irreducible sets are connected (IRREDUCIBLE_IMP_CONNECTED_IN). A space is -/
  /- sober when every irreducible closed set is the closure of exactly one     -/
  /- point (sober_space).                                                      -/

  let irreducible_in ← new_definition
   r"irreducible_in (top:A topology) s <=>
        s SUBSET topspace top /\ ~(s = {}) /\
        !c d. closed_in top c /\ closed_in top d /\ s SUBSET c UNION d
              ==> s SUBSET c \/ s SUBSET d"

  let IRREDUCIBLE_IN_SING ← prove
   r"!top a:A. irreducible_in top {a} <=> a IN topspace top"
   (REWRITE_TAC [irreducible_in, SING_SUBSET, NOT_INSERT_EMPTY, IN_UNION] THEN
    MESON_TAC [])

  let IRREDUCIBLE_IN_CLOSURE_OF ← prove
   r"!top s:A->bool.
        irreducible_in top s ==> irreducible_in top (top closure_of s)"
   (REWRITE_TAC [irreducible_in, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    REPEAT STRIP_TAC THENL
     [ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET_EMPTY],
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:A->bool", ← q r"d:A->bool"]) THEN
      ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
       [ASM_MESON_TAC [CLOSURE_OF_SUBSET, SUBSET_TRANS],
        ASM_MESON_TAC [CLOSURE_OF_MINIMAL]]])

  let IRREDUCIBLE_IN_CONTINUOUS_MAP_IMAGE ← prove
   r"!top top' (f:A->B) s.
        continuous_map (top,top') f /\ irreducible_in top s
        ==> irreducible_in top' (IMAGE f s)"
   (REWRITE_TAC [irreducible_in, IMAGE_EQ_EMPTY] THEN REPEAT GEN_TAC THEN
    STRIP_TAC THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
     [MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"IMAGE (f:A->B) (topspace top)") THEN
      ASM_SIMP_TAC [IMAGE_SUBSET, CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE],
      REPEAT STRIP_TAC THEN FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"{x | x IN topspace top /\ (f:A->B) x IN c}",
        ← q r"{x | x IN topspace top /\ (f:A->B) x IN d}"]) THEN
      ANTS_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN
      REPEAT CONJ_TAC THENL
       [MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':B topology") THEN ASM_REWRITE_TAC [],
        MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
        EXISTS_TAC (← q r"top':B topology") THEN ASM_REWRITE_TAC [],
        ASM SET_TAC []]])

  let IRREDUCIBLE_IMP_CONNECTED_IN ← prove
   r"!top s:A->bool. irreducible_in top s ==> connected_in top s"
   (REWRITE_TAC [irreducible_in, CONNECTED_IN_CLOSED_IN] THEN
    REPEAT GEN_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC [NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"c:A->bool", ← q r"d:A->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL [← q r"c:A->bool", ← q r"d:A->bool"]) THEN
    ASM_REWRITE_TAC [] THEN ASM SET_TAC [])

  let sober_space ← new_definition
   r"sober_space (top:A topology) <=>
        !s. closed_in top s /\ irreducible_in top s
            ==> ?!x. x IN topspace top /\ top closure_of {x} = s"

  return { CONNECTED_IN_UNION, CONNECTED_SPACE_SUBCONNECTED,
           CONNECTED_IN_INTERMEDIATE_CLOSURE_OF, CONNECTED_IN_CLOSURE_OF,
           CONNECTED_IN_SEPARATION, CONNECTED_IN_SEPARATION_ALT, CONNECTED_IN_EQ_NOT_SEPARATED,
           CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, CONNECTED_SPACE_EQ_NOT_SEPARATED,
           CONNECTED_SPACE_EQ_NOT_SEPARATED_SUBSET, CONNECTED_IN_SUBSET_SEPARATED_UNION,
           CONNECTED_IN_NONSEPARATED_UNION, CONNECTED_IN_UNIONS_STRONG, irreducible_in, IRREDUCIBLE_IN_SING, IRREDUCIBLE_IN_CLOSURE_OF, IRREDUCIBLE_IN_CONTINUOUS_MAP_IMAGE, IRREDUCIBLE_IMP_CONNECTED_IN, sober_space }

/- ------------------------------------------------------------------------- -/
/- Connectedness of the intersection of a chain of compact connected sets.   -/
/- This is the general topology version of CONNECTED_CHAIN from topology.ml. -/
/- Hausdorff is needed to separate disjoint compact sets.                    -/
/- (metric.ml 13938-14168)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Chain where
  CONNECTED_IN_CHAIN : thm
  CONNECTED_IN_CHAIN_GEN : thm
  CONNECTED_IN_NEST : thm
  CONNECTED_IN_NEST_GEN : thm
  deriving Inhabited

@[nospecialize]
def setupChain [HolBase] (D : MetricDeps) (BTopology : Topology) (BCompact1 : Compact1)
    (BHausdorff1 : Hausdorff1) (BConnected1 : Connected1) : ExceptT String IO Chain := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { EMPTY_SUBSET, EXISTS_IN_GSPEC, EXISTS_IN_IMAGE, EXISTS_IN_INSERT, EXTENSION,
        FINITE_DELETE, FINITE_INDUCT_STRONG, FINITE_SUBSET_IMAGE, FORALL_IN_GSPEC,
        FORALL_IN_IMAGE, FORALL_IN_INSERT, IMAGE_CLAUSES, .. } := D.core1
  let { IMP_CONJ, INTERS_IMAGE, INTERS_SUBSET_STRONG, IN_DIFF, IN_ELIM_THM, IN_INTERS,
        IN_UNION, IN_UNIV, MEMBER_NOT_EMPTY, MONO_EXISTS, NOT_FORALL_THM, NOT_IMP,
        NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SUBSET, SUBSET_INTER, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNIONS,
        UNIONS_0, UNIONS_IMAGE, UNIONS_INSERT, UNION_EMPTY, WLOG_LE, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_INTERS, OPEN_IN_DIFF, OPEN_IN_TOPSPACE, OPEN_IN_UNION, .. } := BTopology
  let { CLOSED_COMPACT_IN, COMPACT_INTER_CLOSED_IN, COMPACT_IN_SUBSET_TOPSPACE, compact_in,
        .. } := BCompact1
  let { COMPACT_IN_IMP_CLOSED_IN, HAUSDORFF_SPACE_COMPACT_SEPARATION, .. } := BHausdorff1
  let { CONNECTED_IN, CONNECTED_IN_CLOSED_IN, .. } := BConnected1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONNECTED_IN_CHAIN ← prove
   r"!top (f:(A->bool)->bool).
        hausdorff_space top /\
        ~(f = {}) /\
        (!s. s IN f ==> compact_in top s /\ connected_in top s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> connected_in top (INTERS f)"
   (REPEAT STRIP_TAC THEN
    ABBREV_TAC (← q r"c:A->bool = INTERS f") THEN
    SUBGOAL_THEN (← q r"?k:A->bool. k IN f") STRIP_ASSUME_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!s:A->bool. s IN f ==> s SUBSET topspace top")
      ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"!s:A->bool. s IN f ==> closed_in top s") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_IMP_CLOSED_IN], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"compact_in top (c:A->bool)") ASSUME_TAC THENL
     [MATCH_MP_TAC CLOSED_COMPACT_IN THEN EXISTS_TAC (← q r"k:A->bool") THEN
      REPEAT CONJ_TAC THENL
       [ASM_MESON_TAC [],
        EXPAND_TAC "c" THEN MATCH_MP_TAC INTERS_SUBSET_STRONG THEN
        EXISTS_TAC (← q r"k:A->bool") THEN ASM_REWRITE_TAC [SUBSET_REFL],
        EXPAND_TAC "c" THEN MATCH_MP_TAC CLOSED_IN_INTERS THEN
        CONJ_TAC THENL [ASM SET_TAC [], ASM_MESON_TAC []]],
      ALL_TAC] THEN
    SUBGOAL_THEN (← q r"(c:A->bool) SUBSET topspace top") ASSUME_TAC THENL
     [ASM_MESON_TAC [COMPACT_IN_SUBSET_TOPSPACE], ALL_TAC] THEN
    REWRITE_TAC [CONNECTED_IN_CLOSED_IN, NOT_EXISTS_THM] THEN
    ASM_REWRITE_TAC [] THEN
    MAP_EVERY X_GEN_TAC [← q r"e1:A->bool", ← q r"e2:A->bool"] THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"a:A->bool = c INTER e1") THEN
    ABBREV_TAC (← q r"b:A->bool = c INTER e2") THEN
    SUBGOAL_THEN
      (← q r"compact_in top (a:A->bool) /\ compact_in top (b:A->bool)")
      STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["a", "b"] THEN
      CONJ_TAC THEN MATCH_MP_TAC COMPACT_INTER_CLOSED_IN THEN
      ASM_REWRITE_TAC [],
      ALL_TAC] THEN
    SUBGOAL_THEN
      (← q r"DISJOINT (a:A->bool) b /\ ~(a = {}) /\ ~(b = {})")
      STRIP_ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["a", "b"] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"a:A->bool", ← q r"b:A->bool"]
      HAUSDORFF_SPACE_COMPACT_SEPARATION) THEN
    ASM_REWRITE_TAC [] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"u:A->bool")
      (X_CHOOSE_THEN (← q r"v:A->bool") STRIP_ASSUME_TAC)) THEN
    SUBGOAL_THEN (← q r"(c:A->bool) SUBSET u UNION v") ASSUME_TAC THENL
     [MAP_EVERY EXPAND_TAC ["a", "b"] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    /- Cover k with (u UNION v) and complements of elements of f -/
    SUBGOAL_THEN (← q r"compact_in top (k:A->bool)") MP_TAC THENL
     [ASM_MESON_TAC [], ALL_TAC] THEN
    REWRITE_TAC [compact_in] THEN DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
      (MP_TAC o SPEC
        (← q r"(u UNION v:A->bool) INSERT IMAGE (\s:A->bool. topspace top DIFF s) f"))) THEN
    ANTS_TAC THENL
     [CONJ_TAC THENL
       [REWRITE_TAC [FORALL_IN_INSERT, FORALL_IN_IMAGE] THEN
        ASM_MESON_TAC [OPEN_IN_UNION, OPEN_IN_DIFF, OPEN_IN_TOPSPACE],
        REWRITE_TAC [UNIONS_INSERT, SUBSET, IN_UNION] THEN
        X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN
        ASM_CASES_TAC (← q r"(x:A) IN c") THENL
         [DISJ1_TAC THEN
          UNDISCH_TAC (← q r"(c:A->bool) SUBSET u UNION v") THEN ASM SET_TAC [],
          DISJ2_TAC THEN REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
          UNDISCH_TAC (← q r"~((x:A) IN c)") THEN EXPAND_TAC "c" THEN
          REWRITE_TAC [IN_INTERS, NOT_FORALL_THM, NOT_IMP] THEN
          MATCH_MP_TAC MONO_EXISTS THEN X_GEN_TAC (← q r"r:A->bool") THEN
          STRIP_TAC THEN ASM_REWRITE_TAC [IN_DIFF] THEN
          UNDISCH_TAC (← q r"(x:A) IN k") THEN
          UNDISCH_TAC (← q r"!s:A->bool. s IN f ==> s SUBSET topspace top") THEN
          UNDISCH_TAC (← q r"(k:A->bool) IN f") THEN
          POP_ASSUM_LIST (K ALL_TAC) THEN SET_TAC []]],
      ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"g:(A->bool)->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
     (← q r"?f':(A->bool)->bool. FINITE f' /\ f' SUBSET f /\
                            g DELETE (u UNION v:A->bool) =
                            IMAGE (\s:A->bool. topspace top DIFF s) f'")
    STRIP_ASSUME_TAC THENL
     [REWRITE_TAC [← GSYM FINITE_SUBSET_IMAGE] THEN
      CONJ_TAC THENL [ASM_REWRITE_TAC [FINITE_DELETE], ALL_TAC] THEN
      UNDISCH_TAC (← q r"g SUBSET (u UNION v:A->bool) INSERT
                    IMAGE (\s:A->bool. topspace top DIFF s) f") THEN
      SET_TAC [],
      ALL_TAC] THEN
    /- Find minimum element j in f' -/
    SUBGOAL_THEN
     (← q r"?j:A->bool. j IN f /\
                   UNIONS(IMAGE (\s. topspace top DIFF s) f') SUBSET
                   (topspace top DIFF j)")
    STRIP_ASSUME_TAC THENL
     [ASM_CASES_TAC (← q r"f':(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_0, EMPTY_SUBSET] THENL
       [ASM SET_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN
       (← q r"?j:A->bool. j IN f' /\
                     UNIONS(IMAGE (\s. topspace top DIFF s) f') SUBSET
                     (topspace top DIFF j)")
      MP_TAC THENL [ALL_TAC, ASM_MESON_TAC [SUBSET]] THEN
      SUBGOAL_THEN
       (← q r"!s t:A->bool. s IN f' /\ t IN f' ==> s SUBSET t \/ t SUBSET s")
      MP_TAC THENL [ASM_MESON_TAC [SUBSET], ALL_TAC] THEN
      UNDISCH_TAC (← q r"~(f':(A->bool)->bool = {})") THEN
      UNDISCH_TAC (← q r"FINITE(f':(A->bool)->bool)") THEN
      SPEC_TAC (← q r"f':(A->bool)->bool", ← q r"f':(A->bool)->bool") THEN
      MATCH_MP_TAC FINITE_INDUCT_STRONG THEN REWRITE_TAC [] THEN
      REWRITE_TAC [EXISTS_IN_INSERT, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
      REWRITE_TAC [FORALL_IN_INSERT] THEN POP_ASSUM_LIST (K ALL_TAC) THEN
      MAP_EVERY X_GEN_TAC [← q r"i:A->bool", ← q r"ff:(A->bool)->bool"] THEN
      ASM_CASES_TAC (← q r"ff:(A->bool)->bool = {}") THEN
      ASM_REWRITE_TAC [IMAGE_CLAUSES, UNIONS_INSERT, NOT_IN_EMPTY,
                       UNIONS_0, UNION_EMPTY, SUBSET_REFL] THEN
      DISCH_THEN (fun th => REPEAT DISCH_TAC THEN MP_TAC th) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"j:A->bool") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(topspace top DIFF j) SUBSET (topspace top DIFF i) \/
                    (topspace top DIFF i:A->bool) SUBSET (topspace top DIFF j)")
      STRIP_ASSUME_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o SPEC (← q r"j:A->bool") o CONJUNCT2) THEN
        ASM SET_TAC [],
        DISJ1_TAC THEN ASM SET_TAC [],
        DISJ2_TAC THEN EXISTS_TAC (← q r"j:A->bool") THEN ASM SET_TAC []],
      ALL_TAC] THEN
    /- j INTER k SUBSET u UNION v -/
    SUBGOAL_THEN (← q r"(j INTER k:A->bool) SUBSET (u UNION v)") ASSUME_TAC THENL
     [MATCH_MP_TAC (← sr
       r"(k:A->bool) SUBSET (u UNION v) UNION (topspace top DIFF j)
        ==> (j INTER k) SUBSET (u UNION v)") THEN
      MATCH_MP_TAC SUBSET_TRANS THEN
      EXISTS_TAC (← q r"UNIONS g:A->bool") THEN ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC
       (← q r"UNIONS((u UNION v:A->bool) INSERT (g DELETE (u UNION v)))") THEN
      CONJ_TAC THENL
       [MATCH_MP_TAC SUBSET_UNIONS THEN SET_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [] THEN ONCE_REWRITE_TAC [UNIONS_INSERT] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    /- c SUBSET j INTER k -/
    SUBGOAL_THEN (← q r"(c:A->bool) SUBSET j INTER k") ASSUME_TAC THENL
     [EXPAND_TAC "c" THEN REWRITE_TAC [SUBSET_INTER] THEN
      CONJ_TAC THEN MATCH_MP_TAC INTERS_SUBSET_STRONG THEN
      ASM_REWRITE_TAC [SUBSET_REFL] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    /- j INTER k is connected -/
    SUBGOAL_THEN (← q r"connected_in top (j INTER k:A->bool)") MP_TAC THENL
     [UNDISCH_TAC (← q r"(j:A->bool) IN f") THEN
      UNDISCH_TAC (← q r"(k:A->bool) IN f") THEN
      UNDISCH_TAC
        (← q r"!s t:A->bool. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s") THEN
      UNDISCH_TAC
        (← q r"!s:A->bool. s IN f ==> compact_in top s /\ connected_in top s") THEN
      POP_ASSUM_LIST (K ALL_TAC) THEN
      MESON_TAC [← sr r"(s:A->bool) SUBSET t ==> s INTER t = s",
                 ← sr r"(t:A->bool) SUBSET s ==> s INTER t = t"],
      ALL_TAC] THEN
    /- Contradiction: connected but split by u, v -/
    REWRITE_TAC [CONNECTED_IN, NOT_EXISTS_THM] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (K ALL_TAC)
      (MP_TAC o SPECL [← q r"u:A->bool", ← q r"v:A->bool"])) THEN
    REWRITE_TAC [← TAUT (← q r"(~p ==> F) <=> p")] THEN
    REPEAT CONJ_TAC THENL
     [FIRST_ASSUM ACCEPT_TAC,
      FIRST_ASSUM ACCEPT_TAC,
      FIRST_ASSUM ACCEPT_TAC,
      UNDISCH_TAC (← q r"DISJOINT (u:A->bool) v") THEN SET_TAC [],
      MAP_EVERY EXPAND_TAC ["a"] THEN ASM SET_TAC [],
      MAP_EVERY EXPAND_TAC ["b"] THEN ASM SET_TAC []])

  let CONNECTED_IN_CHAIN_GEN ← prove
   r"!top (f:(A->bool)->bool).
        hausdorff_space top /\
        (!s. s IN f ==> closed_in top s /\ connected_in top s) /\
        (?s. s IN f /\ compact_in top s) /\
        (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
        ==> connected_in top (INTERS f)"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"s:A->bool") STRIP_ASSUME_TAC) THEN
    SUBGOAL_THEN
      (← q r"INTERS f = INTERS(IMAGE (\t:A->bool. s INTER t) f)")
      SUBST1_TAC THENL
     [REWRITE_TAC [EXTENSION, INTERS_IMAGE] THEN ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_IN_CHAIN THEN ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, FORALL_IN_IMAGE] THEN
      CONJ_TAC THENL [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, EXISTS_IN_IMAGE] THEN
        ASM SET_TAC [], ALL_TAC] THEN
      CONJ_TAC THENL
       [X_GEN_TAC (← q r"t:A->bool") THEN DISCH_TAC THEN CONJ_TAC THENL
         [MATCH_MP_TAC COMPACT_INTER_CLOSED_IN THEN ASM_MESON_TAC [],
          SUBGOAL_THEN (← q r"s INTER t:A->bool = s \/ s INTER t = t")
            (DISJ_CASES_THEN SUBST1_TAC) THEN ASM_MESON_TAC [← sr
              r"(s:A->bool) SUBSET t ==> s INTER t = s",
            ← sr r"(t:A->bool) SUBSET s ==> s INTER t = t"]],
        ASM SET_TAC []]])

  let CONNECTED_IN_NEST ← prove
   r"!top (s:num->A->bool).
        hausdorff_space top /\
        (!n. compact_in top (s n) /\ connected_in top (s n)) /\
        (!m n. m <= n ==> s n SUBSET s m)
        ==> connected_in top (INTERS {s n | n IN (:num)})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN MATCH_MP_TAC CONNECTED_IN_CHAIN THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, IN_UNIV, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY] THEN EXISTS_TAC (← q r"(s:num->A->bool) 0") THEN
      REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"0") THEN REWRITE_TAC [IN_UNIV],
      MATCH_MP_TAC WLOG_LE THEN ASM_MESON_TAC []])

  let CONNECTED_IN_NEST_GEN ← prove
   r"!top (s:num->A->bool).
        hausdorff_space top /\
        (!n. closed_in top (s n) /\ connected_in top (s n)) /\
        (?n. compact_in top (s n)) /\
        (!m n. m <= n ==> s n SUBSET s m)
        ==> connected_in top (INTERS {s n | n IN (:num)})"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
    MATCH_MP_TAC CONNECTED_IN_CHAIN_GEN THEN
    ASM_SIMP_TAC [FORALL_IN_GSPEC, IN_UNIV, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    CONJ_TAC THENL
     [REWRITE_TAC [EXISTS_IN_GSPEC, IN_UNIV] THEN ASM_MESON_TAC [],
      MATCH_MP_TAC WLOG_LE THEN ASM_MESON_TAC []])

  return { CONNECTED_IN_CHAIN, CONNECTED_IN_CHAIN_GEN, CONNECTED_IN_NEST,
           CONNECTED_IN_NEST_GEN }

/- ------------------------------------------------------------------------- -/
/- More on connectedness: separation, images, discrete spaces.               -/
/- (metric.ml 14170-14386)                                                    -/
/- ------------------------------------------------------------------------- -/

structure Connected3 where
  CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION : thm
  CONNECTED_IN_CLOPEN_CASES : thm
  CONNECTED_SPACE_CLOSURES : thm
  CONNECTED_IN_INTER_FRONTIER_OF : thm
  CONNECTED_IN_CONTINUOUS_MAP_IMAGE : thm
  HOMEOMORPHIC_CONNECTED_SPACE : thm
  HOMEOMORPHIC_MAP_CONNECTEDNESS : thm
  HOMEOMORPHIC_MAP_CONNECTEDNESS_EQ : thm
  CONNECTED_SPACE_QUOTIENT_MAP_IMAGE : thm
  CONNECTED_SPACE_RETRACTION_MAP_IMAGE : thm
  CONNECTED_IN_DISCRETE_TOPOLOGY : thm
  CONNECTED_SPACE_DISCRETE_TOPOLOGY : thm
  CONNECTED_IN_IMP_PERFECT_GEN : thm
  CONNECTED_IN_IMP_PERFECT : thm
  CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN : thm
  deriving Inhabited

@[nospecialize]
def setupConnected3 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BDerived : Derived) (BClosure : Closure) (BInterior : Interior) (BFrontier : Frontier)
    (BContMap1 : ContMap1) (BQuotient : Quotient) (BHomeo1 : Homeo1) (BHomeo2 : Homeo2)
    (BHomeoSpace : HomeoSpace) (BRetraction : Retraction) (BSeparated : Separated)
    (BT1a : T1a) (BHausdorff1 : Hausdorff1) (BConnected1 : Connected1)
    (BConnected2 : Connected2) : ExceptT String IO Connected3 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { CONJ_ASSOC, EMPTY_SUBSET, FINITE_DELETE, FUN_EQ_THM, HAS_SIZE, .. } := D.core1
  let { IN_DELETE, IN_ELIM_THM, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, .. } := D.core2
  let { SUBSET, pairwise, .. } := D.core4
  let { NOT_EXISTS_THM, .. } := D.core5
  let { CARD_LE_RELATIONAL_FULL, .. } := D.lib
  let { OPEN_IN_DIFF, OPEN_IN_TOPSPACE, .. } := BTopology
  let { OPEN_IN_DISCRETE_TOPOLOGY, TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { derived_set_of, .. } := BDerived
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_EQ, CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE,
        .. } := BClosure
  let { INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { FRONTIER_OF_RESTRICT, frontier_of, .. } := BFrontier
  let { CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE, OPEN_IN_CONTINUOUS_MAP_PREIMAGE, continuous_map,
        .. } := BContMap1
  let { QUOTIENT_IMP_CONTINUOUS_MAP, QUOTIENT_IMP_SURJECTIVE_MAP, .. } := BQuotient
  let { HOMEOMORPHIC_EQ_EVERYTHING_MAP, homeomorphic_maps, .. } := BHomeo1
  let { HOMEOMORPHIC_MAP_SUBTOPOLOGIES, .. } := BHomeo2
  let { HOMEOMORPHIC_SPACE, HOMEOMORPHIC_SPACE_SYM, homeomorphic_space, .. } := BHomeoSpace
  let { RETRACTION_IMP_QUOTIENT_MAP, .. } := BRetraction
  let { SEPARATED_IN_COMPLEMENT, SEPARATED_IN_IMP_DISJOINT, SEPARATED_IN_UNIONS, separated_in,
        .. } := BSeparated
  let { T1_SPACE_OPEN_IN_DELETE_ALT, .. } := BT1a
  let { HAUSDORFF_IMP_T1_SPACE, .. } := BHausdorff1
  let { CONNECTED_IN, CONNECTED_IN_EMPTY, CONNECTED_IN_SING, CONNECTED_IN_SUBSET_TOPSPACE,
        CONNECTED_IN_TOPSPACE, CONNECTED_SPACE_CLOSED_IN_EQ, connected_in, connected_space,
        .. } := BConnected1
  let { CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET, CONNECTED_IN_SUBSET_SEPARATED_UNION,
        .. } := BConnected2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION ← prove
   r"!top c:A->bool.
        connected_in top c <=>
        c SUBSET topspace top /\
        !s t. separated_in top s t /\ c SUBSET s UNION t
              ==> c SUBSET s \/ c SUBSET t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET] THEN
    MATCH_MP_TAC (← TAUT (← q r"(p ==> (q <=> r)) ==> (p /\ q <=> p /\ r)")) THEN
    DISCH_TAC THEN REWRITE_TAC [NOT_EXISTS_THM] THEN
    AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"s:A->bool") THEN
    REWRITE_TAC [] THEN AP_TERM_TAC THEN
    GEN_REWRITE_TAC id [FUN_EQ_THM] THEN X_GEN_TAC (← q r"t:A->bool") THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"s:A->bool", ← q r"t:A->bool"]
          SEPARATED_IN_IMP_DISJOINT) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_CLOPEN_CASES ← prove
   r"!top c t:A->bool.
        connected_in top c /\ closed_in top t /\ open_in top t
        ==> c SUBSET t \/ DISJOINT c t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [← GSYM SEPARATED_IN_COMPLEMENT] THEN
    DISCH_TAC THEN MP_TAC (← ISPECL
     [← q r"top:A topology", ← q r"t:A->bool", ← q r"topspace top DIFF t:A->bool",
      ← q r"c:A->bool"]
     CONNECTED_IN_SUBSET_SEPARATED_UNION) THEN
    ASM_REWRITE_TAC [] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [connected_in]) THEN ASM SET_TAC [])

  let CONNECTED_SPACE_CLOSURES ← prove
   r"!top:A topology.
        connected_space top <=>
        ~(?e1 e2. e1 UNION e2 = topspace top /\
                  top closure_of e1 INTER top closure_of e2 = {} /\
                  ~(e1 = {}) /\ ~(e2 = {}))"
   (GEN_TAC THEN REWRITE_TAC [CONNECTED_SPACE_CLOSED_IN_EQ] THEN
    AP_TERM_TAC THEN AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"u:A->bool") THEN REWRITE_TAC [] THEN
    AP_TERM_TAC THEN GEN_REWRITE_TAC id [FUN_EQ_THM] THEN
    X_GEN_TAC (← q r"v:A->bool") THEN REWRITE_TAC [] THEN
    MAP_EVERY (fun t => ASM_CASES_TAC t THEN ASM_REWRITE_TAC [])
     [← q r"u:A->bool = {}", ← q r"v:A->bool = {}",
      ← q r"u UNION v:A->bool = topspace top"] THEN
    REWRITE_TAC [← GSYM CLOSURE_OF_EQ] THEN
    MAP_EVERY (MP_TAC o ISPECL [← q r"top:A topology", ← q r"u:A->bool"])
     [CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    MAP_EVERY (MP_TAC o ISPECL [← q r"top:A topology", ← q r"v:A->bool"])
     [CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_TOPSPACE] THEN
    ASM SET_TAC [])

  let CONNECTED_IN_INTER_FRONTIER_OF ← prove
   r"!top s t:A->bool.
        connected_in top s /\ ~(s INTER t = {}) /\ ~(s DIFF t = {})
        ==> ~(s INTER top frontier_of t = {})"
   (REPEAT GEN_TAC THEN STRIP_TAC THEN
    ONCE_REWRITE_TAC [FRONTIER_OF_RESTRICT] THEN
    SUBGOAL_THEN (← q r"~(s DIFF (topspace top INTER t):A->bool = {})") MP_TAC THENL
     [ASM SET_TAC [], ALL_TAC] THEN
    SUBGOAL_THEN (← q r"~(s INTER topspace top INTER t:A->bool = {})") MP_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [connected_in]) THEN ASM SET_TAC [],
      UNDISCH_TAC (← q r"connected_in top (s:A->bool)")] THEN
    POP_ASSUM_LIST (K ALL_TAC) THEN
    MP_TAC (← sr r"(topspace top INTER t:A->bool) SUBSET topspace top") THEN
    SPEC_TAC (← q r"topspace top INTER t:A->bool", ← q r"t:A->bool") THEN
    REWRITE_TAC [frontier_of] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [CONNECTED_IN]) THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN
    REWRITE_TAC [] THEN MAP_EVERY EXISTS_TAC
     [← q r"top interior_of t:A->bool",
      ← q r"topspace top DIFF top closure_of t:A->bool"] THEN
    SIMP_TAC [OPEN_IN_INTERIOR_OF, OPEN_IN_DIFF, CLOSED_IN_CLOSURE_OF,
              OPEN_IN_TOPSPACE] THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] INTERIOR_OF_SUBSET) THEN
    MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] CLOSURE_OF_SUBSET) THEN
    ASM SET_TAC [])

  let CONNECTED_IN_CONTINUOUS_MAP_IMAGE ← prove
   r"!f:A->B top top' s.
        continuous_map (top,top') f /\ connected_in top s
        ==> connected_in top' (IMAGE f s)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [CONNECTED_IN] THEN
    REWRITE_TAC [connected_space, NOT_EXISTS_THM] THEN STRIP_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONTINUOUS_MAP_IMAGE_SUBSET_TOPSPACE) THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:B->bool", ← q r"v:B->bool"] THEN STRIP_TAC THEN
    FIRST_X_ASSUM (MP_TAC o SPECL
     [← q r"{x | x IN topspace top /\ (f:A->B) x IN u}",
      ← q r"{x | x IN topspace top /\ (f:A->B) x IN v}"]) THEN
    REWRITE_TAC [] THEN GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      ASM SET_TAC [],
      ASM SET_TAC []])

  let HOMEOMORPHIC_CONNECTED_SPACE ← prove
   r"!(top:A topology) (top':B topology).
        top homeomorphic_space top'
        ==> (connected_space top <=> connected_space top')"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [homeomorphic_space, homeomorphic_maps, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"f:A->B", ← q r"g:B->A"] THEN STRIP_TAC THEN
    REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE] THEN EQ_TAC THEN DISCH_TAC THENL
     [SUBGOAL_THEN (← q r"topspace top' = IMAGE (f:A->B) (topspace top)") SUBST1_TAC
      THENL [ALL_TAC, ASM_MESON_TAC [CONNECTED_IN_CONTINUOUS_MAP_IMAGE]],
      SUBGOAL_THEN (← q r"topspace top = IMAGE (g:B->A) (topspace top')") SUBST1_TAC
      THENL [ALL_TAC, ASM_MESON_TAC [CONNECTED_IN_CONTINUOUS_MAP_IMAGE]]] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [continuous_map]) THEN ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_CONNECTEDNESS ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f /\ u SUBSET topspace top
        ==> (connected_in top' (IMAGE f u) <=> connected_in top u)"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [connected_in] THEN
    BINOP_TAC THENL
     [ALL_TAC,
      MATCH_MP_TAC HOMEOMORPHIC_CONNECTED_SPACE THEN
      ONCE_REWRITE_TAC [HOMEOMORPHIC_SPACE_SYM] THEN
      REWRITE_TAC [HOMEOMORPHIC_SPACE] THEN EXISTS_TAC (← q r"f:A->B") THEN
      MATCH_MP_TAC HOMEOMORPHIC_MAP_SUBTOPOLOGIES THEN
      ASM_REWRITE_TAC []] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HOMEOMORPHIC_EQ_EVERYTHING_MAP]) THEN
    ASM SET_TAC [])

  let HOMEOMORPHIC_MAP_CONNECTEDNESS_EQ ← prove
   r"!(f:A->B) top top' u.
        homeomorphic_map(top,top') f
        ==> (connected_in top u <=>
             u SUBSET topspace top /\ connected_in top' (IMAGE f u))"
   (MESON_TAC [HOMEOMORPHIC_MAP_CONNECTEDNESS, CONNECTED_IN_SUBSET_TOPSPACE])

  let CONNECTED_SPACE_QUOTIENT_MAP_IMAGE ← prove
   r"!top top' (q:A->B).
        quotient_map(top,top') q /\ connected_space top
        ==> connected_space top'"
   (REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE] THEN REPEAT STRIP_TAC THEN
    FIRST_ASSUM (SUBST1_TAC o SYM o MATCH_MP QUOTIENT_IMP_SURJECTIVE_MAP) THEN
    MATCH_MP_TAC CONNECTED_IN_CONTINUOUS_MAP_IMAGE THEN
    ASM_MESON_TAC [QUOTIENT_IMP_CONTINUOUS_MAP])

  let CONNECTED_SPACE_RETRACTION_MAP_IMAGE ← prove
   r"!top top' (r:A->B).
        retraction_map(top,top') r /\ connected_space top
        ==> connected_space top'"
   (MESON_TAC [CONNECTED_SPACE_QUOTIENT_MAP_IMAGE,
               RETRACTION_IMP_QUOTIENT_MAP])

  let CONNECTED_IN_DISCRETE_TOPOLOGY ← prove
   r"!u s:A->bool.
       connected_in (discrete_topology u) s <=>
       s SUBSET u /\ ?a. s SUBSET {a}"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(s:A->bool) SUBSET u") THENL
     [ALL_TAC, ASM_MESON_TAC [connected_in, TOPSPACE_DISCRETE_TOPOLOGY]] THEN
    ASM_REWRITE_TAC [] THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
    ASM_REWRITE_TAC [CONNECTED_IN_EMPTY, EMPTY_SUBSET] THEN
    ASM_REWRITE_TAC [← sr r"(?a. s SUBSET {a}) <=> s = {} \/ ?a. s = {a}"] THEN
    ASM_CASES_TAC (← q r"?a:A. s = {a}") THEN ASM_REWRITE_TAC [] THENL
     [FIRST_X_ASSUM (CHOOSE_THEN SUBST_ALL_TAC) THEN
      ASM_REWRITE_TAC [CONNECTED_IN_SING, TOPSPACE_DISCRETE_TOPOLOGY] THEN
      ASM SET_TAC [],
      REWRITE_TAC [CONNECTED_IN, OPEN_IN_DISCRETE_TOPOLOGY] THEN
      ASM_REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [← GSYM MEMBER_NOT_EMPTY]) THEN
      DISCH_THEN (X_CHOOSE_TAC (← q r"z:A")) THEN
      MAP_EVERY EXISTS_TAC [← q r"{z:A}", ← q r"u DELETE (z:A)"] THEN
      ASM SET_TAC []])

  let CONNECTED_SPACE_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool.
        connected_space (discrete_topology u) <=>
        ?a. u SUBSET {a}"
   (REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE, CONNECTED_IN_DISCRETE_TOPOLOGY] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY] THEN SET_TAC [])

  let CONNECTED_IN_IMP_PERFECT_GEN ← prove
   r"!top s:A->bool.
        t1_space top /\ connected_in top s /\ ~(?a. s = {a})
        ==> s SUBSET top derived_set_of s"
   (REPEAT STRIP_TAC THEN REWRITE_TAC [SUBSET, derived_set_of, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    FIRST_ASSUM (ASSUME_TAC o MATCH_MP CONNECTED_IN_SUBSET_TOPSPACE) THEN
    CONJ_TAC THENL [ASM SET_TAC [], X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC] THEN
    FIRST_ASSUM (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC o
      REWRITE_RULE [CONNECTED_IN, NOT_EXISTS_THM]) THEN
    DISCH_THEN (MP_TAC o SPECL [← q r"u:A->bool", ← q r"topspace top DELETE (a:A)"]) THEN
    ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← TAUT (← q
     r"p /\ q /\ s /\ t /\ (~r ==> u) ==> ~(p /\ q /\ r /\ s /\ t) ==> u")) THEN
    CONJ_TAC THENL
     [ASM_MESON_TAC [T1_SPACE_OPEN_IN_DELETE_ALT, OPEN_IN_TOPSPACE],
      ASM SET_TAC []])

  let CONNECTED_IN_IMP_PERFECT ← prove
   r"!top s:A->bool.
        hausdorff_space top /\ connected_in top s /\ ~(?a. s = {a})
        ==> s SUBSET top derived_set_of s"
   (MESON_TAC [CONNECTED_IN_IMP_PERFECT_GEN, HAUSDORFF_IMP_T1_SPACE])

  let CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN ← prove
   r"!(top:A topology) u v.
        FINITE u /\
        pairwise (separated_in top) u /\
        (!c. c IN u ==> ~(c = {})) /\
        (!c. c IN v ==> connected_in top c) /\
        UNIONS u = UNIONS v
        ==> u <=_c v"
   (REPEAT STRIP_TAC THEN MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"\(s:A->bool) t. ~DISJOINT s t") THEN
    REWRITE_TAC [] THEN CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"t:A->bool", ← q r"c1:A->bool", ← q r"c2:A->bool"] THEN
    STRIP_TAC THEN ASM_CASES_TAC (← q r"c1:A->bool = c2") THEN ASM_REWRITE_TAC [] THEN
    SUBGOAL_THEN (← q r"connected_in top (t:A->bool)") MP_TAC THENL
     [ASM_MESON_TAC [],
      REWRITE_TAC [CONNECTED_IN_EQ_NOT_SEPARATED_SUBSET]] THEN
    DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC MP_TAC) THEN REWRITE_TAC [] THEN
    MAP_EVERY EXISTS_TAC [← q r"c1:A->bool", ← q r"UNIONS(u DELETE (c1:A->bool))"] THEN
    REPEAT (CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC]) THEN
    RULE_ASSUM_TAC (REWRITE_RULE [HAS_SIZE]) THEN
    ASM_SIMP_TAC [SEPARATED_IN_UNIONS, FINITE_DELETE] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [pairwise]) THEN
    REWRITE_TAC [IN_DELETE] THEN ASM_MESON_TAC [separated_in])

  return { CONNECTED_IN_EQ_SUBSET_SEPARATED_UNION, CONNECTED_IN_CLOPEN_CASES,
           CONNECTED_SPACE_CLOSURES, CONNECTED_IN_INTER_FRONTIER_OF,
           CONNECTED_IN_CONTINUOUS_MAP_IMAGE, HOMEOMORPHIC_CONNECTED_SPACE,
           HOMEOMORPHIC_MAP_CONNECTEDNESS, HOMEOMORPHIC_MAP_CONNECTEDNESS_EQ,
           CONNECTED_SPACE_QUOTIENT_MAP_IMAGE, CONNECTED_SPACE_RETRACTION_MAP_IMAGE,
           CONNECTED_IN_DISCRETE_TOPOLOGY, CONNECTED_SPACE_DISCRETE_TOPOLOGY,
           CONNECTED_IN_IMP_PERFECT_GEN, CONNECTED_IN_IMP_PERFECT,
           CARD_LE_PAIRWISE_SEPARATED_CONNECTED_IN }

/- ------------------------------------------------------------------------- -/
/- Connectedness of products.  (metric.ml 14388-14692)                       -/
/- ------------------------------------------------------------------------- -/

structure Connected4 where
  CONNECTED_SPACE_PROD_TOPOLOGY : thm
  CONNECTED_IN_CROSS : thm
  CONNECTED_SPACE_PRODUCT_TOPOLOGY : thm
  CONNECTED_IN_CARTESIAN_PRODUCT : thm
  deriving Inhabited

@[nospecialize]
def setupConnected4 [HolBase] (D : MetricDeps) (BTopology : Topology)
    (BSubtopology : Subtopology) (BContMap1 : ContMap1) (BProd1 : Prod1)
    (BProduct1 : Product1) (BProduct2 : Product2) (BConnected1 : Connected1)
    (BConnected3 : Connected3) : ExceptT String IO Connected4 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { ARBITRARY, CARTESIAN_PRODUCT_EQ_EMPTY, CONJ_ASSOC, CROSS_EQ_EMPTY, ETA_AX, EXTENSION,
        EXTENSIONAL, FINITE_IMAGE, FINITE_INDUCT_STRONG, FINITE_SING, FINITE_SUBSET,
        FINITE_UNIONS, FORALL_INTERSECTION_OF, FORALL_IN_IMAGE, FUN_EQ_THM, IMAGE_FST_CROSS,
        .. } := D.core1
  let { IMAGE_PROJECTION_CARTESIAN_PRODUCT, IMAGE_SND_CROSS, IMP_CONJ, IMP_CONJ_ALT,
        INTER_EMPTY, IN_CROSS, IN_ELIM_THM, IN_IMAGE, IN_INTER, IN_INTERS, IN_SING, IN_UNION,
        IN_UNIV, LEFT_IMP_EXISTS_THM, MEMBER_NOT_EMPTY, NOT_IMP, NOT_IN_EMPTY, .. } := D.core2
  let { SUBSET, SUBSET_CARTESIAN_PRODUCT, SUBSET_CROSS, UNIONS_IMAGE, UNION_OF,
        cartesian_product, o_DEF, o_THM, .. } := D.core4
  let { DE_MORGAN_THM, FORALL_PAIR_THM, NOT_EXISTS_THM, .. } := D.core5
  let { FORALL_RELATIVE_TO, .. } := D.misc
  let { OPEN_IN_SUBSET, .. } := BTopology
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, CONTINUOUS_MAP_ID, OPEN_IN_CONTINUOUS_MAP_PREIMAGE,
        .. } := BContMap1
  let { CONTINUOUS_MAP_FST, CONTINUOUS_MAP_PAIRWISE, CONTINUOUS_MAP_SND, SUBTOPOLOGY_CROSS,
        TOPSPACE_PROD_TOPOLOGY, .. } := BProd1
  let { OPEN_IN_PRODUCT_TOPOLOGY, SUBTOPOLOGY_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY,
        .. } := BProduct1
  let { CONTINUOUS_MAP_COMPONENTWISE, CONTINUOUS_MAP_PRODUCT_PROJECTION, .. } := BProduct2
  let { CONNECTED_IN_TOPSPACE, CONNECTED_SPACE_TOPSPACE_EMPTY, connected_in, connected_space,
        .. } := BConnected1
  let { CONNECTED_IN_CONTINUOUS_MAP_IMAGE, .. } := BConnected3
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONNECTED_SPACE_PROD_TOPOLOGY ← prove
   r"!top1:A topology top2:B topology.
        connected_space(prod_topology top1 top2) <=>
        topspace(prod_topology top1 top2) = {} \/
        connected_space top1 /\ connected_space top2"
   (REPEAT STRIP_TAC THEN
    ASM_CASES_TAC (← q r"topspace(prod_topology top1 top2):A#B->bool = {}") THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_TOPSPACE_EMPTY] THEN
    RULE_ASSUM_TAC (REWRITE_RULE [TOPSPACE_PROD_TOPOLOGY,
          CROSS_EQ_EMPTY, DE_MORGAN_THM]) THEN
    EQ_TAC THENL
     [REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE] THEN REPEAT STRIP_TAC THENL
       [MP_TAC (← ISPECL [← q r"FST:A#B->A", ← q r"prod_topology top1 top2:(A#B)topology",
                         ← q r"top1:A topology",
                         ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          CONNECTED_IN_CONTINUOUS_MAP_IMAGE),
        MP_TAC (← ISPECL [← q r"SND:A#B->B", ← q r"prod_topology top1 top2:(A#B)topology",
                         ← q r"top2:B topology",
                         ← q r"topspace(prod_topology top1 top2:(A#B)topology)"]
          CONNECTED_IN_CONTINUOUS_MAP_IMAGE)] THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_FST, CONTINUOUS_MAP_SND] THEN
      REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN
      ASM_REWRITE_TAC [IMAGE_FST_CROSS, IMAGE_SND_CROSS],
      REWRITE_TAC [connected_space, NOT_EXISTS_THM] THEN STRIP_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A#B->bool", ← q r"v:A#B->bool"] THEN
    REWRITE_TAC [TOPSPACE_PROD_TOPOLOGY] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(u:A#B->bool) SUBSET (topspace top1) CROSS (topspace top2) /\
      v SUBSET (topspace top1) CROSS (topspace top2)")
    STRIP_ASSUME_TAC THENL
     [ASM_MESON_TAC [OPEN_IN_SUBSET, TOPSPACE_PROD_TOPOLOGY], ALL_TAC] THEN
    UNDISCH_TAC (← q r"~(u:A#B->bool = {})") THEN
    REWRITE_TAC [EXTENSION, FORALL_PAIR_THM, NOT_IN_EMPTY] THEN
    MAP_EVERY X_GEN_TAC [← q r"a:A", ← q r"b:B"] THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← sr
     r"s SUBSET u UNION v
      ==> u SUBSET s /\ v SUBSET s /\ u INTER v = {} /\ ~(v = {})
         ==> ~(s SUBSET u)")) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN
    SUBGOAL_THEN (← q r"(a:A,b:B) IN topspace top1 CROSS topspace top2") MP_TAC THENL
     [ASM SET_TAC [], REWRITE_TAC [IN_CROSS] THEN STRIP_TAC] THEN
    REWRITE_TAC [SUBSET, FORALL_PAIR_THM, IN_CROSS] THEN
    MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:B"] THEN STRIP_TAC THEN
    SUBGOAL_THEN (← q r"((a:A),(y:B)) IN u") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"{y | y IN topspace top2 /\ (a:A,y:B) IN u}",
        ← q r"{y | y IN topspace top2 /\ (a:A,y:B) IN v}"]),
      FIRST_X_ASSUM (MP_TAC o SPECL
       [← q r"{x | x IN topspace top1 /\ (x:A,y:B) IN u}",
        ← q r"{x | x IN topspace top1 /\ (x:A,y:B) IN v}"])] THEN
    (MATCH_MP_TAC (← TAUT (← q
      r"(s /\ t) /\ (p /\ q) /\ r /\ (~u ==> v)
       ==> ~(p /\ q /\ r /\ s /\ t /\ u) ==> v")) THEN
     CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN CONJ_TAC THENL
      [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
       EXISTS_TAC (← q r"prod_topology top1 top2 :(A#B)topology") THEN
       ASM_REWRITE_TAC [CONTINUOUS_MAP_PAIRWISE, o_DEF] THEN
       ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST],
       ALL_TAC] THEN
     CONJ_TAC THENL
      [SIMP_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
         MATCH_MP (← sr
           r"s SUBSET u UNION v ==> IMAGE f q SUBSET s
          ==> (!x. x IN q ==> f x IN u \/ f x IN v)")) THEN
       ASM_REWRITE_TAC [SUBSET, FORALL_IN_IMAGE, IN_CROSS],
       REWRITE_TAC []])
    THENL
     [MATCH_MP_TAC (← sr
       r"P y /\ (a,y) IN u UNION v
        ==> {y | P y /\ (a,y) IN v} = {} ==> (a,y) IN u"),
      MATCH_MP_TAC (← sr
       r"P x /\ (x,y) IN u UNION v
        ==> {x | P x /\ (x,y) IN v} = {} ==> (x,y) IN u")] THEN
    ASM_REWRITE_TAC [] THEN
    FIRST_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
    ASM_REWRITE_TAC [IN_CROSS])

  let CONNECTED_IN_CROSS ← prove
   r"!top1 top2 s:A->bool t:B->bool.
        connected_in (prod_topology top1 top2) (s CROSS t) <=>
        s = {} \/ t = {} \/ connected_in top1 s /\ connected_in top2 t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_in, SUBTOPOLOGY_CROSS] THEN
    REWRITE_TAC [CONNECTED_SPACE_PROD_TOPOLOGY, TOPSPACE_PROD_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CROSS, CROSS_EQ_EMPTY, TOPSPACE_SUBTOPOLOGY] THEN
    ASM_CASES_TAC (← q r"s:A->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"t:B->bool = {}") THEN ASM_REWRITE_TAC [INTER_EMPTY] THEN
    ASM_CASES_TAC (← q r"(s:A->bool) SUBSET topspace top1") THEN ASM_REWRITE_TAC [] THEN
    ASM_CASES_TAC (← q r"(t:B->bool) SUBSET topspace top2") THEN ASM_REWRITE_TAC [] THEN
    ASM_SIMP_TAC [← sr r"s SUBSET u ==> u INTER s = s"])

  let CONNECTED_SPACE_PRODUCT_TOPOLOGY ← prove
   r"!tops:K->A topology k.
        connected_space(product_topology k tops) <=>
        topspace(product_topology k tops) = {} \/
        !i. i IN k ==> connected_space(tops i)"
   (REPEAT GEN_TAC THEN
    ASM_CASES_TAC (← q r"topspace(product_topology k (tops:K->A topology)) = {}") THEN
    ASM_SIMP_TAC [CONNECTED_SPACE_TOPSPACE_EMPTY] THEN EQ_TAC THENL
     [REWRITE_TAC [← GSYM CONNECTED_IN_TOPSPACE] THEN DISCH_TAC THEN
      X_GEN_TAC (← q r"i:K") THEN DISCH_TAC THEN FIRST_ASSUM (MP_TAC o
        ISPECL [← q r"\(f:K->A). f i", ← q r"(tops:K->A topology) i"] o
        MATCH_MP (← REWRITE_RULE [IMP_CONJ_ALT]
          CONNECTED_IN_CONTINUOUS_MAP_IMAGE)) THEN
      ASM_SIMP_TAC [CONTINUOUS_MAP_PRODUCT_PROJECTION] THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN
      REWRITE_TAC [IMAGE_PROJECTION_CARTESIAN_PRODUCT] THEN
      ASM_REWRITE_TAC [← GSYM TOPSPACE_PRODUCT_TOPOLOGY, o_THM],
      DISCH_TAC] THEN
    REWRITE_TAC [connected_space, NOT_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:(K->A)->bool", ← q r"v:(K->A)->bool"] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"(u:(K->A)->bool) SUBSET topspace(product_topology k tops) /\
      (v:(K->A)->bool) SUBSET topspace(product_topology k tops)")
    MP_TAC THENL [ASM_MESON_TAC [OPEN_IN_SUBSET], ALL_TAC] THEN
    REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN STRIP_TAC THEN
    UNDISCH_TAC (← q r"~(u:(K->A)->bool = {})") THEN
    REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    X_GEN_TAC (← q r"f:K->A") THEN DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP (← sr
     r"s SUBSET u UNION v
      ==> u SUBSET s /\ v SUBSET s /\ u INTER v = {} /\ ~(v = {})
         ==> ~(s SUBSET u)")) THEN
    ASM_REWRITE_TAC [NOT_IMP] THEN
    SUBGOAL_THEN (← q r"f IN cartesian_product k (topspace o (tops:K->A topology))")
    ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    MP_TAC (← ASSUME (← q r"open_in (product_topology k (tops:K->A topology)) u")) THEN
    REWRITE_TAC [OPEN_IN_PRODUCT_TOPOLOGY, UNION_OF, ARBITRARY] THEN
    DISCH_THEN (MP_TAC o MATCH_MP (← sr
     r"(?u. (!c. c IN u ==> P c) /\ UNIONS u = s)
      ==> !x. x IN s ==> ?c. P c /\ c SUBSET s /\ x IN c")) THEN
    DISCH_THEN (MP_TAC o SPEC (← q r"f:K->A")) THEN ASM_REWRITE_TAC [] THEN
    REWRITE_TAC [LEFT_IMP_EXISTS_THM, IMP_CONJ, FORALL_RELATIVE_TO] THEN
    REWRITE_TAC [FORALL_INTERSECTION_OF] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"t:((K->A)->bool)->bool") THEN STRIP_TAC THEN
    REWRITE_TAC [IN_INTER] THEN REPEAT STRIP_TAC THEN
    SUBGOAL_THEN
     (← q r"?l. FINITE l /\
          !i u. i IN k /\ open_in (tops i) u /\ u PSUBSET topspace(tops i) /\
                {x:K->A | x i IN u} IN t
                ==> i IN l")
    STRIP_ASSUME_TAC THENL
     [EXISTS_TAC
       (← q r"UNIONS(IMAGE (\c. {i | IMAGE (\x:K->A. x i) c PSUBSET topspace(tops i)})
                     t)") THEN
      CONJ_TAC THENL
       [ASM_SIMP_TAC [FINITE_UNIONS, FINITE_IMAGE, FORALL_IN_IMAGE] THEN
        FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
         r"(!x. P x ==> Q x)
          ==> (!x. Q x ==> P x ==> R x) ==> (!x. P x ==> R x)")) THEN
        SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"c:(K->A)->bool", ← q r"i:K", ← q r"v:A->bool"] THEN
        STRIP_TAC THEN DISCH_THEN (MP_TAC o MATCH_MP (← sr
         r"s IN t ==> !x. x IN INTERS t ==> x IN s")) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"f:K->A")) THEN ASM_REWRITE_TAC [IN_ELIM_THM] THEN
        DISCH_TAC THEN MATCH_MP_TAC FINITE_SUBSET THEN
        EXISTS_TAC (← q r"{i:K}") THEN REWRITE_TAC [FINITE_SING] THEN
        REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_SING] THEN X_GEN_TAC (← q r"j:K") THEN
        MATCH_MP_TAC (← sr r"(~P ==> s = UNIV) ==> (s PSUBSET t ==> P)") THEN
        DISCH_TAC THEN
        REWRITE_TAC [EXTENSION, IN_UNIV, IN_IMAGE, IN_ELIM_THM] THEN
        X_GEN_TAC (← q r"z:A") THEN
        EXISTS_TAC (← q r"\m. if m = j then z else (f:K->A) m") THEN
        ASM_REWRITE_TAC [],
        REWRITE_TAC [UNIONS_IMAGE, IN_ELIM_THM] THEN
        MAP_EVERY X_GEN_TAC [← q r"i:K", ← q r"u:A->bool"] THEN STRIP_TAC THEN
        EXISTS_TAC (← q r"{x:K->A | x i IN u}") THEN ASM SET_TAC []],
      ALL_TAC] THEN
    REWRITE_TAC [SUBSET] THEN X_GEN_TAC (← q r"h:K->A") THEN DISCH_TAC THEN
    ABBREV_TAC (← q r"g = \i. if i IN l then (f:K->A) i else h i") THEN
    SUBGOAL_THEN (← q r"(g:K->A) IN u") ASSUME_TAC THENL
     [FIRST_X_ASSUM (MATCH_MP_TAC o GEN_REWRITE_RULE id [SUBSET]) THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, IN_INTER, IN_INTERS] THEN
      CONJ_TAC THENL
       [MAP_EVERY UNDISCH_TAC
         [← q r"(f:K->A) IN topspace (product_topology k tops)",
          ← q r"(h:K->A) IN cartesian_product k (topspace o tops)"] THEN
        EXPAND_TAC "g" THEN
        REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY, cartesian_product] THEN
        REWRITE_TAC [IN_ELIM_THM, EXTENSIONAL] THEN MESON_TAC [],
        ALL_TAC] THEN
      FIRST_X_ASSUM (MATCH_MP_TAC o MATCH_MP (← sr
       r"(!x. P x ==> Q x)
        ==> (!x. Q x ==> P x ==> R x) ==> (!x. P x ==> R x)")) THEN
      SIMP_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"c:(K->A)->bool", ← q r"i:K", ← q r"v:A->bool"] THEN
      REPEAT STRIP_TAC THEN EXPAND_TAC "g" THEN REWRITE_TAC [IN_ELIM_THM] THEN
      COND_CASES_TAC THENL
       [FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [IN_INTERS]) THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"{x:K->A | x i IN v}")) THEN
        ASM_REWRITE_TAC [IN_ELIM_THM],
        UNDISCH_TAC (← q r"(h:K->A) IN cartesian_product k (topspace o tops)") THEN
        REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_THM] THEN
        DISCH_THEN (MP_TAC o SPEC (← q r"i:K") o CONJUNCT2) THEN
        ASM_REWRITE_TAC [] THEN MATCH_MP_TAC (← sr
         r"s SUBSET t /\ ~(s PSUBSET t) ==> x IN t ==> x IN s") THEN
        ASM_SIMP_TAC [OPEN_IN_SUBSET] THEN ASM_MESON_TAC []],
      ALL_TAC] THEN
    SUBGOAL_THEN
     (← q r"!m. FINITE m
          ==> !h. h IN cartesian_product k (topspace o tops) /\
                  {i | i IN k /\ ~((h:K->A) i = g i)} SUBSET m
                  ==> h IN u")
    MP_TAC THENL
     [ALL_TAC,
      DISCH_THEN (MP_TAC o SPEC (← q r"l:K->bool")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN MATCH_MP_TAC THEN ASM_REWRITE_TAC [] THEN
      EXPAND_TAC "g" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM] THEN MESON_TAC []] THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      let vtm ← q r"h:K->A"
      pure (K ALL_TAC (← liftExcept (check
        (fun t => HolCore.Basics.free_in vtm (concl t)) th))))) THEN
    REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
      let vtm ← q r"f:K->A"
      pure (K ALL_TAC (← liftExcept (check
        (fun t => HolCore.Basics.free_in vtm (concl t)) th))))) THEN
    SUBGOAL_THEN (← q r"(g:K->A) IN cartesian_product k (topspace o tops)")
    ASSUME_TAC THENL
     [REPEAT (FIRST_X_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET)) THEN
      REWRITE_TAC [TOPSPACE_PRODUCT_TOPOLOGY] THEN ASM SET_TAC [],
      ALL_TAC] THEN
    MATCH_MP_TAC FINITE_INDUCT_STRONG THEN CONJ_TAC THENL
     [X_GEN_TAC (← q r"h:K->A") THEN REWRITE_TAC [← sr
       r"{i | i IN k /\ ~(h i = g i)} SUBSET {} <=>
        !i. i IN k ==> h i = g i"] THEN
      ASM_CASES_TAC (← q r"h:K->A = g") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"(g:K->A) IN cartesian_product k (topspace o tops)",
        ← q r"~(h:K->A = g)"] THEN
      REWRITE_TAC [FUN_EQ_THM] THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, EXTENSIONAL] THEN
      MESON_TAC [],
      ALL_TAC] THEN
    MAP_EVERY X_GEN_TAC [← q r"i:K", ← q r"m:K->bool"] THEN
    DISCH_THEN (CONJUNCTS_THEN2 (LABEL_TAC "*") STRIP_ASSUME_TAC) THEN
    X_GEN_TAC (← q r"h:K->A") THEN STRIP_TAC THEN
    ABBREV_TAC (← q r"(f:K->A) = \j. if j = i then g i else h j") THEN
    SUBGOAL_THEN (← q r"(f:K->A) IN cartesian_product k (topspace o tops)")
    ASSUME_TAC THENL
     [MAP_EVERY UNDISCH_TAC
       [← q r"(g:K->A) IN cartesian_product k (topspace o tops)",
        ← q r"(h:K->A) IN cartesian_product k (topspace o tops)"] THEN
      EXPAND_TAC "f" THEN REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN MESON_TAC [],
      ALL_TAC] THEN
    REMOVE_THEN "*" (MP_TAC o SPEC (← q r"f:K->A")) THEN
    ASM_REWRITE_TAC [] THEN ANTS_TAC THENL
     [EXPAND_TAC "f" THEN REWRITE_TAC [] THEN ASM SET_TAC [], DISCH_TAC] THEN
    ASM_CASES_TAC (← q r"(h:K->A) IN v") THENL [ALL_TAC, ASM SET_TAC []] THEN
    ASM_CASES_TAC (← q r"(i:K) IN k") THENL
     [ALL_TAC,
      ASM_CASES_TAC (← q r"h:K->A = f") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY UNDISCH_TAC
       [← q r"(f:K->A) IN cartesian_product k (topspace o tops)",
        ← q r"(h:K->A) IN cartesian_product k (topspace o tops)",
        ← q r"~(h:K->A = f)"] THEN
      GEN_REWRITE_TAC (LAND_CONV o RAND_CONV) [FUN_EQ_THM] THEN
      EXPAND_TAC "f" THEN REWRITE_TAC [cartesian_product, IN_ELIM_THM] THEN
      REWRITE_TAC [EXTENSIONAL, IN_ELIM_THM] THEN ASM SET_TAC []] THEN
    SUBGOAL_THEN (← q r"connected_space ((tops:K->A topology) i)") MP_TAC THENL
     [ASM_MESON_TAC [], REWRITE_TAC [connected_space, NOT_EXISTS_THM]] THEN
    DISCH_THEN (MP_TAC o SPECL
     [← q r"{x | x IN topspace((tops:K->A topology) i) /\
            (\j. if j = i then x else h j) IN u}",
      ← q r"{x | x IN topspace((tops:K->A topology) i) /\
            (\j. if j = i then x else h j) IN v}"]) THEN
    MATCH_MP_TAC (← TAUT (← q r"p ==> ~p ==> q")) THEN
    GEN_REWRITE_TAC id [CONJ_ASSOC] THEN CONJ_TAC THENL
     [CONJ_TAC THEN MATCH_MP_TAC OPEN_IN_CONTINUOUS_MAP_PREIMAGE THEN
      EXISTS_TAC (← q r"product_topology k (tops:K->A topology)") THEN
      ASM_REWRITE_TAC [CONTINUOUS_MAP_COMPONENTWISE] THEN
      (CONJ_TAC THENL
        [REWRITE_TAC [SUBSET, FORALL_IN_IMAGE],
         X_GEN_TAC (← q r"j:K") THEN DISCH_TAC THEN ASM_CASES_TAC (← q r"j:K = i") THEN
         ASM_REWRITE_TAC [CONTINUOUS_MAP_ID, CONTINUOUS_MAP_CONST]] THEN
       UNDISCH_TAC (← q r"(h:K->A) IN cartesian_product k (topspace o tops)") THEN
       REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_DEF, EXTENSIONAL] THEN
       ASM SET_TAC []),
      ALL_TAC] THEN
    CONJ_TAC THENL
     [SIMP_TAC [SUBSET, IN_ELIM_THM, IN_UNION] THEN FIRST_X_ASSUM (MATCH_MP_TAC o
      MATCH_MP (← sr
        r"s SUBSET u UNION v ==> IMAGE f q SUBSET s
         ==> (!x. x IN q ==> f x IN u \/ f x IN v)")) THEN
      REWRITE_TAC [SUBSET, FORALL_IN_IMAGE] THEN
      UNDISCH_TAC (← q r"(h:K->A) IN cartesian_product k (topspace o tops)") THEN
      REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_DEF, EXTENSIONAL] THEN
      ASM SET_TAC [],
      ALL_TAC] THEN
    CONJ_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
    REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, IN_ELIM_THM] THEN CONJ_TAC THENL
     [EXISTS_TAC (← q r"(g:K->A) i") THEN ASM_REWRITE_TAC [] THEN
      UNDISCH_TAC (← q r"(g:K->A) IN cartesian_product k (topspace o tops)"),
      EXISTS_TAC (← q r"(h:K->A) i") THEN
      REWRITE_TAC [← MESON [] (← q r"(if j = i then h i else h j) = h j")] THEN
      ASM_REWRITE_TAC [ETA_AX] THEN
      UNDISCH_TAC (← q r"(h:K->A) IN cartesian_product k (topspace o tops)")] THEN
    REWRITE_TAC [cartesian_product, IN_ELIM_THM, o_DEF] THEN ASM SET_TAC [])

  let CONNECTED_IN_CARTESIAN_PRODUCT ← prove
   r"!tops:K->A topology s k.
        connected_in (product_topology k tops) (cartesian_product k s) <=>
        cartesian_product k s = {} \/
        !i. i IN k ==> connected_in (tops i) (s i)"
   (REWRITE_TAC [connected_in, SUBTOPOLOGY_CARTESIAN_PRODUCT] THEN
    REWRITE_TAC [CONNECTED_SPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [SUBSET_CARTESIAN_PRODUCT, TOPSPACE_PRODUCT_TOPOLOGY] THEN
    REWRITE_TAC [CARTESIAN_PRODUCT_EQ_EMPTY, o_DEF, TOPSPACE_SUBTOPOLOGY] THEN
    SET_TAC [])

  return { CONNECTED_SPACE_PROD_TOPOLOGY, CONNECTED_IN_CROSS, CONNECTED_SPACE_PRODUCT_TOPOLOGY,
           CONNECTED_IN_CARTESIAN_PRODUCT }

/- ------------------------------------------------------------------------- -/
/- The notion of "separated between" (complement of "connected between")     -/
/- (metric.ml 14694-14948)                                                    -/
/- ------------------------------------------------------------------------- -/

structure SepBetween where
  separated_between : thm
  SEPARATED_BETWEEN_ALT : thm
  SEPARATED_BETWEEN : thm
  SEPARATED_BETWEEN_MONO : thm
  SEPARATED_BETWEEN_REFL : thm
  SEPARATED_BETWEEN_SYM : thm
  SEPARATED_BETWEEN_IMP_SUBSET : thm
  SEPARATED_BETWEEN_EMPTY : thm
  SEPARATED_BETWEEN_UNION : thm
  SEPARATED_BETWEEN_IMP_DISJOINT : thm
  SEPARATED_BETWEEN_IMP_SEPARATED_IN : thm
  SEPARATED_BETWEEN_FULL : thm
  SEPARATED_BETWEEN_EQ_SEPARATED_IN : thm
  SEPARATED_BETWEEN_POINTWISE_LEFT : thm
  SEPARATED_BETWEEN_POINTWISE_RIGHT : thm
  SEPARATED_BETWEEN_CLOSURE_OF : thm
  SEPARATED_BETWEEN_CLOSURE_OF_EQ : thm
  SEPARATED_BETWEEN_FRONTIER_OF_EQ : thm
  SEPARATED_BETWEEN_FRONTIER_OF : thm
  CONNECTED_SPACE_SEPARATED_BETWEEN : thm
  CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL : thm
  deriving Inhabited

@[nospecialize]
def setupSepBetween [HolBase] (D : MetricDeps) (BTopology : Topology) (BClosure : Closure)
    (BInterior : Interior) (BFrontier : Frontier) (BCompact1 : Compact1)
    (BSeparated : Separated) (BConnected1 : Connected1) : ExceptT String IO SepBetween := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { CONJ_ASSOC, DISJOINT, DISJOINT_SYM, EMPTY_GSPEC, EMPTY_SUBSET,
        EXISTS_FINITE_SUBSET_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE, .. } := D.core1
  let { LEFT_IMP_EXISTS_THM, MONO_EXISTS, NOT_IN_EMPTY, .. } := D.core2
  let { SING_SUBSET, SKOLEM_THM, SUBSET_EMPTY, SUBSET_REFL, SUBSET_TRANS, SUBSET_UNION,
        UNIONS_IMAGE, UNION_COMM, UNWIND_THM2, .. } := D.core4
  let { LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM, RIGHT_EXISTS_AND_THM, RIGHT_IMP_EXISTS_THM,
        SWAP_EXISTS_THM, .. } := D.core5
  let { CLOSED_IN_DIFF, CLOSED_IN_INTER, CLOSED_IN_TOPSPACE, CLOSED_IN_UNIONS, EXISTS_CLOSED_IN,
        OPEN_IN_CLOSED_IN_EQ, OPEN_IN_DIFF, OPEN_IN_EMPTY, OPEN_IN_INTER, OPEN_IN_SUBSET,
        OPEN_IN_TOPSPACE, OPEN_IN_UNIONS, closed_in, .. } := BTopology
  let { CLOSED_IN_CLOSURE_OF, CLOSURE_OF_MINIMAL_EQ, CLOSURE_OF_SUBSET, .. } := BClosure
  let { INTERIOR_OF_SUBSET, OPEN_IN_INTERIOR_OF, .. } := BInterior
  let { frontier_of, .. } := BFrontier
  let { compact_in, .. } := BCompact1
  let { SEPARATED_IN_FULL, SEPARATED_IN_MONO, SEPARATED_IN_OPEN_SETS, .. } := BSeparated
  let { CONNECTED_SPACE_EQ, .. } := BConnected1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let separated_between ← new_definition
   r"separated_between top (s:A->bool) t <=>
        ?u v. open_in top u /\ open_in top v /\
              u UNION v = topspace top /\ DISJOINT u v /\
              s SUBSET u /\ t SUBSET v"

  let SEPARATED_BETWEEN_ALT ← prove
   r"!top s (t:A->bool).
        separated_between top s t <=>
        ?u v. closed_in top u /\ closed_in top v /\
              u UNION v = topspace top /\ DISJOINT u v /\
              s SUBSET u /\ t SUBSET v"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_between] THEN
    GEN_REWRITE_TAC LAND_CONV [SWAP_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_EXISTS_AND_THM, EXISTS_CLOSED_IN] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN REPEAT (AP_TERM_TAC THEN ABS_TAC) THEN
    REWRITE_TAC [OPEN_IN_CLOSED_IN_EQ] THEN SET_TAC [])

  let SEPARATED_BETWEEN ← prove
   r"!top s (t:A->bool).
        separated_between top s t <=>
        ?u. closed_in top u /\ open_in top u /\
            s SUBSET u /\ t SUBSET (topspace top DIFF u)"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_between] THEN
    ONCE_REWRITE_TAC [← TAUT
      (← q r"p /\ q /\ r /\ s /\ t /\ u <=> (r /\ s) /\ p /\ q /\ t /\ u")] THEN
    REWRITE_TAC [← sr
     r"u UNION v = t /\ DISJOINT u v <=> v = t DIFF u /\ u SUBSET t"] THEN
    REWRITE_TAC [← GSYM CONJ_ASSOC, UNWIND_THM2, closed_in] THEN
    AP_TERM_TAC THEN ABS_TAC THEN SET_TAC [])

  let SEPARATED_BETWEEN_MONO ← prove
   r"!top s t s' t':A->bool.
        separated_between top s t /\ s' SUBSET s /\ t' SUBSET t
        ==> separated_between top s' t'"
   (REPEAT GEN_TAC THEN
    DISCH_THEN (CONJUNCTS_THEN2 MP_TAC STRIP_ASSUME_TAC) THEN
    REWRITE_TAC [separated_between] THEN
    REPEAT (MATCH_MP_TAC MONO_EXISTS THEN GEN_TAC) THEN
    ASM SET_TAC [])

  let SEPARATED_BETWEEN_REFL ← prove
   r"!top s:A->bool. separated_between top s s <=> s = {}"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_between] THEN
    EQ_TAC THENL [SET_TAC [], DISCH_TAC] THEN
    MAP_EVERY EXISTS_TAC [← q r"topspace top:A->bool", ← q r"{}:A->bool"] THEN
    ASM_REWRITE_TAC [OPEN_IN_TOPSPACE, OPEN_IN_EMPTY, EMPTY_SUBSET] THEN
    SET_TAC [])

  let SEPARATED_BETWEEN_SYM ← prove
   r"!top s (t:A->bool).
        separated_between top s t <=> separated_between top t s"
   (REWRITE_TAC [separated_between] THEN MESON_TAC [UNION_COMM, DISJOINT_SYM])

  let SEPARATED_BETWEEN_IMP_SUBSET ← prove
   r"!top s (t:A->bool).
        separated_between top s t
        ==> s SUBSET topspace top /\ t SUBSET topspace top"
   (REWRITE_TAC [separated_between] THEN
    MESON_TAC [OPEN_IN_SUBSET, SUBSET_TRANS])

  let SEPARATED_BETWEEN_EMPTY ← prove
   r"(!top s:A->bool. separated_between top {} s <=> s SUBSET topspace top) /\
   (!top s:A->bool. separated_between top s {} <=> s SUBSET topspace top)"
   (REPEAT STRIP_TAC THEN
    (EQ_TAC THENL [MESON_TAC [SEPARATED_BETWEEN_IMP_SUBSET], DISCH_TAC])
    THENL [ONCE_REWRITE_TAC [SEPARATED_BETWEEN_SYM], ALL_TAC] THEN
    REWRITE_TAC [SEPARATED_BETWEEN] THEN EXISTS_TAC (← q r"topspace top:A->bool") THEN
    ASM_REWRITE_TAC [CLOSED_IN_TOPSPACE, OPEN_IN_TOPSPACE, EMPTY_SUBSET])

  let SEPARATED_BETWEEN_UNION ← prove
   r"(!top s t u:A->bool.
        separated_between top s (t UNION u) <=>
        separated_between top s t /\
        separated_between top s u) /\
   (!top s t u:A->bool.
        separated_between top (s UNION t) u <=>
        separated_between top s u /\
        separated_between top t u)"
   (MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    CONJ_TAC THENL [MESON_TAC [SEPARATED_BETWEEN_SYM], ALL_TAC] THEN
    REPEAT GEN_TAC THEN EQ_TAC THENL
     [MESON_TAC [SEPARATED_BETWEEN_MONO, SUBSET_UNION, SUBSET_REFL],
      REWRITE_TAC [SEPARATED_BETWEEN]] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"d:A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"c INTER d:A->bool") THEN
    ASM_SIMP_TAC [OPEN_IN_INTER, CLOSED_IN_INTER] THEN ASM SET_TAC [])

  let SEPARATED_BETWEEN_IMP_DISJOINT ← prove
   r"!top s (t:A->bool). separated_between top s t ==> DISJOINT s t"
   (REWRITE_TAC [separated_between] THEN SET_TAC [])

  let SEPARATED_BETWEEN_IMP_SEPARATED_IN ← prove
   r"!top s (t:A->bool). separated_between top s t ==> separated_in top s t"
   (REPEAT GEN_TAC THEN REWRITE_TAC [separated_between, LEFT_IMP_EXISTS_THM] THEN
    MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
    MATCH_MP_TAC SEPARATED_IN_MONO THEN
    MAP_EVERY EXISTS_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN
    ASM_SIMP_TAC [SEPARATED_IN_OPEN_SETS])

  let SEPARATED_BETWEEN_FULL ← prove
   r"!top s t:A->bool.
        s UNION t = topspace top
        ==> (separated_between top s t <=>
             DISJOINT s t /\
             closed_in top s /\ open_in top s /\
             closed_in top t /\ open_in top t)"
   (REPEAT STRIP_TAC THEN
    GEN_REWRITE_TAC LAND_CONV [← MESON [SEPARATED_BETWEEN_SYM] (← q
     r"separated_between top s t <=>
      separated_between top s t /\ separated_between top t s")] THEN
    REWRITE_TAC [SEPARATED_BETWEEN, LEFT_AND_EXISTS_THM] THEN
    REWRITE_TAC [RIGHT_AND_EXISTS_THM] THEN EQ_TAC THENL
     [REWRITE_TAC [LEFT_IMP_EXISTS_THM] THEN
      MAP_EVERY X_GEN_TAC [← q r"u:A->bool", ← q r"v:A->bool"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"s:A->bool = u /\ t:A->bool = v")
      (CONJUNCTS_THEN SUBST_ALL_TAC) THENL
       [RULE_ASSUM_TAC (REWRITE_RULE [closed_in]) THEN ASM SET_TAC [],
        ASM SET_TAC []],
      STRIP_TAC THEN MAP_EVERY EXISTS_TAC [← q r"s:A->bool", ← q r"t:A->bool"] THEN
      ASM SET_TAC []])

  let SEPARATED_BETWEEN_EQ_SEPARATED_IN ← prove
   r"!top s t:A->bool.
        s UNION t = topspace top
        ==> (separated_between top s t <=> separated_in top s t)"
   (SIMP_TAC [SEPARATED_IN_FULL, SEPARATED_BETWEEN_FULL])

  let SEPARATED_BETWEEN_POINTWISE_LEFT ← prove
   r"!top s t:A->bool.
        compact_in top s
        ==> (separated_between top s t <=>
             (s = {} ==> t SUBSET topspace top) /\
             !x. x IN s ==> separated_between top {x} t)"
   (REPEAT STRIP_TAC THEN EQ_TAC THENL
     [MESON_TAC [SEPARATED_BETWEEN_MONO, SUBSET_REFL,
                 SEPARATED_BETWEEN_IMP_SUBSET, SING_SUBSET],
      ASM_CASES_TAC (← q r"s:A->bool = {}") THEN
      ASM_REWRITE_TAC [SEPARATED_BETWEEN_EMPTY, NOT_IN_EMPTY] THEN
      REWRITE_TAC [SEPARATED_BETWEEN]] THEN
    GEN_REWRITE_TAC (LAND_CONV o TOP_DEPTH_CONV) [RIGHT_IMP_EXISTS_THM] THEN
    REWRITE_TAC [SKOLEM_THM, LEFT_IMP_EXISTS_THM, SING_SUBSET] THEN
    X_GEN_TAC (← q r"u:A->A->bool") THEN DISCH_TAC THEN
    FIRST_X_ASSUM (STRIP_ASSUME_TAC o GEN_REWRITE_RULE id [compact_in]) THEN
    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"IMAGE (u:A->A->bool) s")) THEN
    REWRITE_TAC [FORALL_IN_IMAGE, EXISTS_FINITE_SUBSET_IMAGE, UNIONS_IMAGE] THEN
    ANTS_TAC THENL [ASM SET_TAC [], REWRITE_TAC [LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"k:A->bool") THEN ASM_CASES_TAC (← q r"k:A->bool = {}") THEN
    ASM_REWRITE_TAC [NOT_IN_EMPTY, EMPTY_GSPEC, SUBSET_EMPTY] THEN STRIP_TAC THEN
    EXISTS_TAC (← q r"UNIONS(IMAGE (u:A->A->bool) k)") THEN REPEAT CONJ_TAC THENL
     [MATCH_MP_TAC CLOSED_IN_UNIONS,
      MATCH_MP_TAC OPEN_IN_UNIONS,
      REWRITE_TAC [UNIONS_IMAGE],
      REWRITE_TAC [UNIONS_IMAGE]] THEN
    ASM_SIMP_TAC [FINITE_IMAGE, FORALL_IN_IMAGE] THEN ASM SET_TAC [])

  let SEPARATED_BETWEEN_POINTWISE_RIGHT ← prove
   r"!top s t:A->bool.
        compact_in top t
        ==> (separated_between top s t <=>
             (t = {} ==> s SUBSET topspace top) /\
             !y. y IN t ==> separated_between top s {y})"
   (ONCE_REWRITE_TAC [SEPARATED_BETWEEN_SYM] THEN
    REWRITE_TAC [SEPARATED_BETWEEN_POINTWISE_LEFT])

  let SEPARATED_BETWEEN_CLOSURE_OF ← prove
   r"(!top s t:A->bool.
        s SUBSET topspace top
        ==> (separated_between top (top closure_of s) t <=>
             separated_between top s t)) /\
   (!top s t:A->bool.
        t SUBSET topspace top
        ==> (separated_between top s (top closure_of t) <=>
             separated_between top s t))"
   (MATCH_MP_TAC (← TAUT (← q r"(p ==> q) /\ p ==> p /\ q")) THEN
    CONJ_TAC THENL [MESON_TAC [SEPARATED_BETWEEN_SYM], ALL_TAC] THEN
    REWRITE_TAC [SEPARATED_BETWEEN] THEN MESON_TAC [CLOSURE_OF_MINIMAL_EQ])

  let SEPARATED_BETWEEN_CLOSURE_OF_EQ ← prove
   r"(!top s t:A->bool.
        separated_between top s t <=>
        s SUBSET topspace top /\
        separated_between top (top closure_of s) t) /\
   (!top s t:A->bool.
        separated_between top s t <=>
        t SUBSET topspace top /\
        separated_between top s (top closure_of t))"
   (MESON_TAC [SEPARATED_BETWEEN_CLOSURE_OF, SEPARATED_BETWEEN_IMP_SUBSET])

  let SEPARATED_BETWEEN_FRONTIER_OF_EQ ← prove
   r"(!top s t:A->bool.
        separated_between top s t <=>
        s SUBSET topspace top /\ DISJOINT s t /\
        separated_between top (top frontier_of s) t) /\
   (!top s t:A->bool.
        separated_between top s t <=>
        t SUBSET topspace top /\ DISJOINT s t /\
        separated_between top s (top frontier_of t))"
   (MATCH_MP_TAC (← TAUT (← q r"(q ==> p) /\ q ==> p /\ q")) THEN CONJ_TAC THENL
     [MESON_TAC [SEPARATED_BETWEEN_SYM, DISJOINT_SYM], ALL_TAC] THEN
    REPEAT GEN_TAC THEN EQ_TAC THEN STRIP_TAC THENL
     [CONJ_TAC THENL
       [ASM_MESON_TAC [SEPARATED_BETWEEN_IMP_SUBSET], ALL_TAC] THEN
      CONJ_TAC THENL
       [ASM_MESON_TAC [SEPARATED_BETWEEN_IMP_DISJOINT], ALL_TAC] THEN
      MATCH_MP_TAC SEPARATED_BETWEEN_MONO THEN
      MAP_EVERY EXISTS_TAC [← q r"s:A->bool", ← q r"top closure_of t:A->bool"] THEN
      FIRST_X_ASSUM (MP_TAC o
        GEN_REWRITE_RULE id [← CONJUNCT2 SEPARATED_BETWEEN_CLOSURE_OF_EQ]) THEN
      SIMP_TAC [SUBSET_REFL] THEN REWRITE_TAC [frontier_of] THEN SET_TAC [],
      FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [SEPARATED_BETWEEN]) THEN
      REWRITE_TAC [SEPARATED_BETWEEN, LEFT_IMP_EXISTS_THM] THEN
      X_GEN_TAC (← q r"u:A->bool") THEN STRIP_TAC THEN
      EXISTS_TAC (← q r"u DIFF t:A->bool") THEN
      GEN_REWRITE_TAC id [CONJ_ASSOC] THEN
      CONJ_TAC THENL [ALL_TAC, ASM SET_TAC []] THEN CONJ_TAC THENL
       [SUBGOAL_THEN (← q r"u DIFF t:A->bool = u DIFF top interior_of t")
         (fun th => ASM_SIMP_TAC [th, CLOSED_IN_DIFF, OPEN_IN_INTERIOR_OF]),
        SUBGOAL_THEN (← q r"u DIFF t:A->bool = u DIFF top closure_of t")
         (fun th => ASM_SIMP_TAC [th, OPEN_IN_DIFF, CLOSED_IN_CLOSURE_OF])] THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] INTERIOR_OF_SUBSET) THEN
      MP_TAC (← ISPECL [← q r"top:A topology", ← q r"t:A->bool"] CLOSURE_OF_SUBSET) THEN
      RULE_ASSUM_TAC (REWRITE_RULE [frontier_of]) THEN ASM SET_TAC []])

  let SEPARATED_BETWEEN_FRONTIER_OF ← prove
   r"(!top s t:A->bool.
        s SUBSET topspace top /\ DISJOINT s t
        ==> (separated_between top (top frontier_of s) t <=>
             separated_between top s t)) /\
   (!top s t:A->bool.
        t SUBSET topspace top /\ DISJOINT s t
        ==> (separated_between top s (top frontier_of t) <=>
             separated_between top s t))"
   (MESON_TAC [SEPARATED_BETWEEN_FRONTIER_OF_EQ])

  let CONNECTED_SPACE_SEPARATED_BETWEEN ← prove
   r"!top:A topology.
        connected_space top <=>
        !s t. separated_between top s t ==> s = {} \/ t = {}"
   (REWRITE_TAC [CONNECTED_SPACE_EQ, separated_between] THEN
    MESON_TAC [DISJOINT, SUBSET_REFL, SUBSET_EMPTY])

  let CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL ← prove
   r"!top s t:A->bool.
        connected_space top
        ==> (separated_between top s t <=>
             s = {} /\ t SUBSET topspace top \/
             s SUBSET topspace top /\ t = {})"
   (MESON_TAC [CONNECTED_SPACE_SEPARATED_BETWEEN, SEPARATED_BETWEEN_EMPTY])

  return { separated_between, SEPARATED_BETWEEN_ALT, SEPARATED_BETWEEN, SEPARATED_BETWEEN_MONO,
           SEPARATED_BETWEEN_REFL, SEPARATED_BETWEEN_SYM, SEPARATED_BETWEEN_IMP_SUBSET,
           SEPARATED_BETWEEN_EMPTY, SEPARATED_BETWEEN_UNION, SEPARATED_BETWEEN_IMP_DISJOINT,
           SEPARATED_BETWEEN_IMP_SEPARATED_IN, SEPARATED_BETWEEN_FULL,
           SEPARATED_BETWEEN_EQ_SEPARATED_IN, SEPARATED_BETWEEN_POINTWISE_LEFT,
           SEPARATED_BETWEEN_POINTWISE_RIGHT, SEPARATED_BETWEEN_CLOSURE_OF,
           SEPARATED_BETWEEN_CLOSURE_OF_EQ, SEPARATED_BETWEEN_FRONTIER_OF_EQ,
           SEPARATED_BETWEEN_FRONTIER_OF, CONNECTED_SPACE_SEPARATED_BETWEEN,
           CONNECTED_SPACE_IMP_SEPARATED_BETWEEN_TRIVIAL }

/- ------------------------------------------------------------------------- -/
/- Connected components.  (metric.ml 14950-15168)                            -/
/- ------------------------------------------------------------------------- -/

structure Components1 where
  connected_component_of : thm
  connected_components_of : thm
  CONNECTED_COMPONENT_IN_TOPSPACE : thm
  CONNECTED_COMPONENT_OF_REFL : thm
  CONNECTED_COMPONENT_OF_SYM : thm
  CONNECTED_COMPONENT_OF_TRANS : thm
  CONNECTED_COMPONENT_OF_SUBTOPOLOGY : thm
  CONNECTED_COMPONENT_OF_MONO : thm
  CONNECTED_COMPONENT_OF_SET : thm
  CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE : thm
  CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ : thm
  CONNECTED_COMPONENTS_OF_SUBTOPOLOGY : thm
  CONNECTED_COMPONENT_OF_EQ_EMPTY : thm
  CONNECTED_SPACE_IFF_CONNECTED_COMPONENT : thm
  CONNECTED_SPACE_IMP_CONNECTED_COMPONENT_OF : thm
  CONNECTED_SPACE_CONNECTED_COMPONENT_SET : thm
  CONNECTED_COMPONENT_OF_MAXIMAL : thm
  CONNECTED_COMPONENT_OF_EQUIV : thm
  CONNECTED_COMPONENT_OF_DISJOINT : thm
  CONNECTED_COMPONENT_OF_EQ : thm
  CONNECTED_IN_CONNECTED_COMPONENT_OF : thm
  UNIONS_CONNECTED_COMPONENTS_OF : thm
  CONNECTED_COMPONENTS_OF_MAXIMAL : thm
  PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF : thm
  COMPLEMENT_CONNECTED_COMPONENTS_OF_UNIONS : thm
  NONEMPTY_CONNECTED_COMPONENTS_OF : thm
  CONNECTED_COMPONENTS_OF_SUBSET : thm
  CONNECTED_IN_CONNECTED_COMPONENTS_OF : thm
  CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF : thm
  deriving Inhabited

@[nospecialize]
def setupComponents1 [HolBase] (D : MetricDeps) (BSubtopology : Subtopology)
    (BConnected1 : Connected1) (BConnected2 : Connected2) : ExceptT String IO Components1 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, new_definition, .. } := D
  let { DIFF_UNIONS_PAIRWISE_DISJOINT, DISJOINT, EXTENSION, FORALL_IN_GSPEC, FUN_EQ_THM,
        .. } := D.core1
  let { IMP_CONJ, IN, IN_ELIM_THM, IN_INTER, IN_SING, IN_UNION, LEFT_IMP_EXISTS_THM,
        NOT_IN_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, RIGHT_IMP_FORALL_THM, SING_SUBSET, SUBSET, SUBSET_ANTISYM,
        SUBSET_ANTISYM_EQ, UNIONS_1, UNIONS_GSPEC, UNIONS_SUBSET, pairwise, .. } := D.core4
  let { CONTRAPOS_THM, .. } := D.core5
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CONNECTED_IN_SING, CONNECTED_IN_SUBSET_TOPSPACE, CONNECTED_IN_SUBTOPOLOGY,
        CONNECTED_IN_UNIONS, .. } := BConnected1
  let { CONNECTED_IN_UNION, CONNECTED_SPACE_SUBCONNECTED, .. } := BConnected2
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let connected_component_of ← new_definition
   r"connected_component_of top x y <=>
        ?t. connected_in top t /\ x IN t /\ y IN t"

  let connected_components_of ← new_definition
   r"connected_components_of top =
    {connected_component_of top x |x| x IN topspace top}"

  let CONNECTED_COMPONENT_IN_TOPSPACE ← prove
   r"!top x y:A.
        connected_component_of top x y
        ==> x IN topspace top /\ y IN topspace top"
   (REWRITE_TAC [connected_component_of] THEN
    MESON_TAC [CONNECTED_IN_SUBSET_TOPSPACE, SUBSET])

  let CONNECTED_COMPONENT_OF_REFL ← prove
   r"!top x:A. connected_component_of top x x <=> x IN topspace top"
   (REPEAT GEN_TAC THEN
    EQ_TAC THENL [MESON_TAC [CONNECTED_COMPONENT_IN_TOPSPACE], DISCH_TAC] THEN
    REWRITE_TAC [connected_component_of] THEN
    EXISTS_TAC (← q r"{x:A}") THEN ASM_REWRITE_TAC [CONNECTED_IN_SING, IN_SING])

  let CONNECTED_COMPONENT_OF_SYM ← prove
   r"!top x y:A.
    connected_component_of top x y <=> connected_component_of top y x"
   (REWRITE_TAC [connected_component_of] THEN MESON_TAC [])

  let CONNECTED_COMPONENT_OF_TRANS ← prove
   r"!top x y z:A.
        connected_component_of top x y /\ connected_component_of top y z
        ==> connected_component_of top x z"
   (REPEAT GEN_TAC THEN REWRITE_TAC [connected_component_of] THEN
    DISCH_THEN (CONJUNCTS_THEN2
     (X_CHOOSE_THEN (← q r"t1:A->bool") STRIP_ASSUME_TAC)
     (X_CHOOSE_THEN (← q r"t2:A->bool") STRIP_ASSUME_TAC)) THEN
    EXISTS_TAC (← q r"t1 UNION t2:A->bool") THEN
    ASM_REWRITE_TAC [IN_UNION] THEN MATCH_MP_TAC CONNECTED_IN_UNION THEN
    ASM SET_TAC [])

  let CONNECTED_COMPONENT_OF_SUBTOPOLOGY ← prove
   r"!top s x y:A.
        connected_component_of (subtopology top s) x y
        ==> connected_component_of top x y"
   (REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
    MESON_TAC [])

  let CONNECTED_COMPONENT_OF_MONO ← prove
   r"!top s t x y:A.
        connected_component_of (subtopology top s) x y /\ s SUBSET t
        ==> connected_component_of (subtopology top t) x y"
   (REWRITE_TAC [connected_component_of, CONNECTED_IN_SUBTOPOLOGY] THEN
    MESON_TAC [SUBSET])

  let CONNECTED_COMPONENT_OF_SET ← prove
   r"!top x:A.
        connected_component_of top x =
        {y | ?t. connected_in top t /\ x IN t /\ y IN t}"
   (REWRITE_TAC [EXTENSION, IN_ELIM_THM] THEN
    REWRITE_TAC [IN, connected_component_of])

  let CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE ← prove
   r"!top x. (connected_component_of top x) SUBSET topspace top"
   (REWRITE_TAC [SUBSET, IN] THEN MESON_TAC [CONNECTED_COMPONENT_IN_TOPSPACE, IN])

  let CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ ← prove
   r"!top u x:A.
      connected_component_of (subtopology top u) x =
      connected_component_of top x <=>
      connected_component_of top x SUBSET u"
   (REWRITE_TAC [CONNECTED_COMPONENT_OF_SET, CONNECTED_IN_SUBTOPOLOGY] THEN
    SET_TAC [])

  let CONNECTED_COMPONENTS_OF_SUBTOPOLOGY ← prove
   r"!top u c:A->bool.
        c IN connected_components_of top /\ c SUBSET u
        ==> c IN connected_components_of (subtopology top u)"
   (GEN_TAC THEN GEN_TAC THEN
    SIMP_TAC [connected_components_of, IMP_CONJ, FORALL_IN_GSPEC] THEN
    X_GEN_TAC (← q r"x:A") THEN REPEAT DISCH_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"x:A") o GEN_REWRITE_RULE id [SUBSET]) THEN
    ANTS_TAC THENL
     [ASM_MESON_TAC [CONNECTED_COMPONENT_OF_REFL, IN], DISCH_TAC] THEN
    REWRITE_TAC [IN_ELIM_THM] THEN EXISTS_TAC (← q r"x:A") THEN
    ASM_SIMP_TAC [TOPSPACE_SUBTOPOLOGY, IN_INTER] THEN
    ASM_MESON_TAC [CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ])

  let CONNECTED_COMPONENT_OF_EQ_EMPTY ← prove
   r"!top x. connected_component_of top x = {} <=> ~(x IN topspace top)"
   (REWRITE_TAC [EXTENSION, NOT_IN_EMPTY] THEN
    MESON_TAC [IN, CONNECTED_COMPONENT_OF_REFL, CONNECTED_COMPONENT_IN_TOPSPACE])

  let CONNECTED_SPACE_IFF_CONNECTED_COMPONENT ← prove
   r"!top:A topology.
        connected_space top <=>
        !x y. x IN topspace top /\ y IN topspace top
              ==> connected_component_of top x y"
   (REWRITE_TAC [CONNECTED_SPACE_SUBCONNECTED, connected_component_of] THEN
    MESON_TAC [])

  let CONNECTED_SPACE_IMP_CONNECTED_COMPONENT_OF ← prove
   r"!top a b:A.
        connected_space top /\ a IN topspace top /\ b IN topspace top
        ==> connected_component_of top a b"
   (MESON_TAC [CONNECTED_SPACE_IFF_CONNECTED_COMPONENT])

  let CONNECTED_SPACE_CONNECTED_COMPONENT_SET ← prove
   r"!top. connected_space top <=>
         !x:A. x IN topspace top
               ==> connected_component_of top x = topspace top"
   (REWRITE_TAC [CONNECTED_SPACE_IFF_CONNECTED_COMPONENT,
                 ← GSYM SUBSET_ANTISYM_EQ] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE] THEN SET_TAC [])

  let CONNECTED_COMPONENT_OF_MAXIMAL ← prove
   r"!top s x:A.
     connected_in top s /\ x IN s ==> s SUBSET (connected_component_of top x)"
   (REPEAT STRIP_TAC THEN
    REWRITE_TAC [SUBSET, CONNECTED_COMPONENT_OF_SET, IN_ELIM_THM] THEN
    ASM_MESON_TAC [])

  let CONNECTED_COMPONENT_OF_EQUIV ← prove
   r"!top x y:A.
        connected_component_of top x y <=>
        x IN topspace top /\ y IN topspace top /\
        connected_component_of top x = connected_component_of top y"
   (REWRITE_TAC [FUN_EQ_THM] THEN
    MESON_TAC [CONNECTED_COMPONENT_OF_REFL, CONNECTED_COMPONENT_OF_TRANS,
               CONNECTED_COMPONENT_OF_SYM])

  let CONNECTED_COMPONENT_OF_DISJOINT ← prove
   r"!top x y:A.
        DISJOINT (connected_component_of top x)
                 (connected_component_of top y) <=>
        ~(connected_component_of top x y)"
   (REWRITE_TAC [DISJOINT, EXTENSION, IN_INTER, NOT_IN_EMPTY] THEN
    REWRITE_TAC [IN] THEN
    MESON_TAC [CONNECTED_COMPONENT_OF_SYM, CONNECTED_COMPONENT_OF_TRANS])

  let CONNECTED_COMPONENT_OF_EQ ← prove
   r"!top x y:A.
        connected_component_of top x = connected_component_of top y <=>
        ~(x IN topspace top) /\ ~(y IN topspace top) \/
        x IN topspace top /\ y IN topspace top /\
        connected_component_of top x y"
   (MESON_TAC [CONNECTED_COMPONENT_OF_REFL, CONNECTED_COMPONENT_OF_EQUIV,
               CONNECTED_COMPONENT_OF_EQ_EMPTY])

  let CONNECTED_IN_CONNECTED_COMPONENT_OF ← prove
   r"!top x:A. connected_in top (connected_component_of top x)"
   (REPEAT GEN_TAC THEN
    SUBGOAL_THEN
     (← q r"connected_component_of top (x:A) =
      UNIONS {t | connected_in top t /\ x IN t}")
    SUBST1_TAC THENL
     [REWRITE_TAC [UNIONS_GSPEC, CONNECTED_COMPONENT_OF_SET] THEN SET_TAC [],
      MATCH_MP_TAC CONNECTED_IN_UNIONS THEN SET_TAC []])

  let UNIONS_CONNECTED_COMPONENTS_OF ← prove
   r"!top:A topology. UNIONS (connected_components_of top) = topspace top"
   (GEN_TAC THEN REWRITE_TAC [connected_components_of] THEN
    MATCH_MP_TAC SUBSET_ANTISYM THEN
    REWRITE_TAC [UNIONS_SUBSET, FORALL_IN_GSPEC,
                 CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    REWRITE_TAC [SUBSET, UNIONS_GSPEC, IN_ELIM_THM] THEN
    X_GEN_TAC (← q r"x:A") THEN DISCH_TAC THEN EXISTS_TAC (← q r"x:A") THEN
    ASM_REWRITE_TAC [] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL])

  let CONNECTED_COMPONENTS_OF_MAXIMAL ← prove
   r"!top s c:A->bool.
        c IN connected_components_of top /\ connected_in top s /\ ~DISJOINT c s
        ==> s SUBSET c"
   (REWRITE_TAC [connected_components_of, IMP_CONJ, FORALL_IN_GSPEC,
      LEFT_IMP_EXISTS_THM, ← sr r"~DISJOINT P t <=> ?x. P x /\ x IN t"] THEN
    SIMP_TAC [CONNECTED_COMPONENT_OF_EQUIV] THEN
    MESON_TAC [CONNECTED_COMPONENT_OF_MAXIMAL])

  let PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF ← prove
   r"!top:A topology. pairwise DISJOINT (connected_components_of top)"
   (SIMP_TAC [pairwise, IMP_CONJ, connected_components_of,
              RIGHT_IMP_FORALL_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, RIGHT_FORALL_IMP_THM] THEN
    SIMP_TAC [CONNECTED_COMPONENT_OF_EQ, CONNECTED_COMPONENT_OF_DISJOINT])

  let COMPLEMENT_CONNECTED_COMPONENTS_OF_UNIONS ← prove
   r"!top c:A->bool.
      c IN connected_components_of top
      ==> topspace top DIFF c = UNIONS (connected_components_of top DELETE c)"
   (REWRITE_TAC [← sr r"s DELETE a = s DIFF {a}"] THEN
    ASM_SIMP_TAC [← GSYM DIFF_UNIONS_PAIRWISE_DISJOINT,
                  PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF, SING_SUBSET] THEN
    REWRITE_TAC [UNIONS_CONNECTED_COMPONENTS_OF, UNIONS_1])

  let NONEMPTY_CONNECTED_COMPONENTS_OF ← prove
   r"!top c:A->bool. c IN connected_components_of top ==> ~(c = {})"
   (SIMP_TAC [connected_components_of, FORALL_IN_GSPEC,
              CONNECTED_COMPONENT_OF_EQ_EMPTY])

  let CONNECTED_COMPONENTS_OF_SUBSET ← prove
   r"!top c:A->bool. c IN connected_components_of top ==> c SUBSET topspace top"
   (SIMP_TAC [connected_components_of, FORALL_IN_GSPEC,
              CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE])

  let CONNECTED_IN_CONNECTED_COMPONENTS_OF ← prove
   r"!top c:A->bool. c IN connected_components_of top ==> connected_in top c"
   (REWRITE_TAC [connected_components_of, FORALL_IN_GSPEC] THEN
    REWRITE_TAC [CONNECTED_IN_CONNECTED_COMPONENT_OF])

  let CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF ← prove
   r"!top a:A.
        connected_component_of top a IN connected_components_of top <=>
        a IN topspace top"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [GEN_REWRITE_TAC id [← GSYM CONTRAPOS_THM] THEN
      SIMP_TAC [← GSYM CONNECTED_COMPONENT_OF_EQ_EMPTY] THEN
      MESON_TAC [NONEMPTY_CONNECTED_COMPONENTS_OF],
      REWRITE_TAC [connected_components_of] THEN SET_TAC []])

  return { connected_component_of, connected_components_of, CONNECTED_COMPONENT_IN_TOPSPACE,
           CONNECTED_COMPONENT_OF_REFL, CONNECTED_COMPONENT_OF_SYM,
           CONNECTED_COMPONENT_OF_TRANS, CONNECTED_COMPONENT_OF_SUBTOPOLOGY,
           CONNECTED_COMPONENT_OF_MONO, CONNECTED_COMPONENT_OF_SET,
           CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE, CONNECTED_COMPONENT_OF_SUBTOPOLOGY_EQ,
           CONNECTED_COMPONENTS_OF_SUBTOPOLOGY, CONNECTED_COMPONENT_OF_EQ_EMPTY,
           CONNECTED_SPACE_IFF_CONNECTED_COMPONENT, CONNECTED_SPACE_IMP_CONNECTED_COMPONENT_OF,
           CONNECTED_SPACE_CONNECTED_COMPONENT_SET, CONNECTED_COMPONENT_OF_MAXIMAL,
           CONNECTED_COMPONENT_OF_EQUIV, CONNECTED_COMPONENT_OF_DISJOINT,
           CONNECTED_COMPONENT_OF_EQ, CONNECTED_IN_CONNECTED_COMPONENT_OF,
           UNIONS_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENTS_OF_MAXIMAL,
           PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF, COMPLEMENT_CONNECTED_COMPONENTS_OF_UNIONS,
           NONEMPTY_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENTS_OF_SUBSET,
           CONNECTED_IN_CONNECTED_COMPONENTS_OF, CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF }

/- ------------------------------------------------------------------------- -/
/- Connected components, continued.  (metric.ml 15170-15399)                 -/
/- ------------------------------------------------------------------------- -/

structure Components2 where
  CONNECTED_SPACE_IFF_COMPONENTS_EQ : thm
  CONNECTED_COMPONENTS_OF_EQ_EMPTY : thm
  CONNECTED_COMPONENTS_OF_EMPTY_SPACE : thm
  CONNECTED_COMPONENTS_OF_SUBSET_SING : thm
  CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING : thm
  CONNECTED_COMPONENTS_OF_EQ_SING : thm
  CONNECTED_COMPONENTS_OF_CONNECTED_SPACE : thm
  EXISTS_CONNECTED_COMPONENT_OF_SUPERSET : thm
  CLOSED_IN_CONNECTED_COMPONENTS_OF : thm
  CLOSED_IN_CONNECTED_COMPONENT_OF : thm
  OPEN_IN_FINITE_CONNECTED_COMPONENTS : thm
  CONNECTED_COMPONENT_OF_EQ_OVERLAP : thm
  CONNECTED_COMPONENT_OF_NONOVERLAP : thm
  CONNECTED_COMPONENT_OF_OVERLAP : thm
  CONNECTED_COMPONENTS_OF_DISJOINT : thm
  CONNECTED_COMPONENTS_OF_OVERLAP : thm
  CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF : thm
  PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF : thm
  CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE : thm
  FINITE_CONNECTED_COMPONENTS_OF_FINITE : thm
  CONNECTED_COMPONENT_OF_UNIQUE : thm
  CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY : thm
  CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY : thm
  CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY : thm
  deriving Inhabited

@[nospecialize]
def setupComponents2 [HolBase] (D : MetricDeps) (BTopology : Topology) (BDiscrete : Discrete)
    (BSubtopology : Subtopology) (BClosure : Closure) (BSeparated : Separated)
    (BConnected1 : Connected1) (BConnected2 : Connected2) (BConnected3 : Connected3)
    (BComponents1 : Components1) : ExceptT String IO Components2 := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, MESON_TAC, SET_RULE, SET_TAC, .. } := D
  let { DISJOINT, EMPTY_SUBSET, FINITE_DELETE, FORALL_IN_GSPEC, .. } := D.core1
  let { IMP_CONJ, IMP_CONJ_ALT, IN, IN_DELETE, IN_INTER, IN_SING, LEFT_IMP_EXISTS_THM,
        MEMBER_NOT_EMPTY, .. } := D.core2
  let { RIGHT_FORALL_IMP_THM, SING_SUBSET, SUBSET, SUBSET_INTER, UNIONS_1, pairwise,
        .. } := D.core4
  let { CARD_LE_FINITE, CARD_LE_RELATIONAL_FULL, .. } := D.lib
  let { CLOSED_IN_EMPTY, CLOSED_IN_UNIONS, OPEN_IN_CLOSED_IN_EQ, .. } := BTopology
  let { TOPSPACE_DISCRETE_TOPOLOGY, .. } := BDiscrete
  let { TOPSPACE_SUBTOPOLOGY, .. } := BSubtopology
  let { CLOSURE_OF_SUBSET, CLOSURE_OF_SUBSET_EQ, CLOSURE_OF_SUBSET_INTER, .. } := BClosure
  let { SEPARATED_IN_CLOSED_SETS, .. } := BSeparated
  let { CONNECTED_IN_SUBTOPOLOGY, connected_in, .. } := BConnected1
  let { CONNECTED_IN_CLOSURE_OF, .. } := BConnected2
  let { CONNECTED_IN_DISCRETE_TOPOLOGY, .. } := BConnected3
  let { COMPLEMENT_CONNECTED_COMPONENTS_OF_UNIONS, CONNECTED_COMPONENTS_OF_MAXIMAL,
        CONNECTED_COMPONENTS_OF_SUBSET, CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF,
        CONNECTED_COMPONENT_IN_TOPSPACE, CONNECTED_COMPONENT_OF_DISJOINT,
        CONNECTED_COMPONENT_OF_EQ, CONNECTED_COMPONENT_OF_EQ_EMPTY,
        CONNECTED_COMPONENT_OF_MAXIMAL, CONNECTED_COMPONENT_OF_REFL,
        CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE, CONNECTED_IN_CONNECTED_COMPONENTS_OF,
        CONNECTED_IN_CONNECTED_COMPONENT_OF, CONNECTED_SPACE_IFF_CONNECTED_COMPONENT,
        NONEMPTY_CONNECTED_COMPONENTS_OF, PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF,
        UNIONS_CONNECTED_COMPONENTS_OF, connected_component_of, connected_components_of,
        .. } := BComponents1
  -- @@SCOPE END
  let sr (s : String) : ExceptT String IO thm := do SET_RULE (← q s)

  let CONNECTED_SPACE_IFF_COMPONENTS_EQ ← prove
   r"!top:A topology.
        connected_space top <=>
        !c c'. c IN connected_components_of top /\
               c' IN connected_components_of top
               ==> c = c'"
   (REWRITE_TAC [connected_components_of, IMP_CONJ, RIGHT_FORALL_IMP_THM] THEN
    REWRITE_TAC [FORALL_IN_GSPEC, CONNECTED_SPACE_IFF_CONNECTED_COMPONENT] THEN
    SIMP_TAC [CONNECTED_COMPONENT_OF_EQ] THEN MESON_TAC [])

  let CONNECTED_COMPONENTS_OF_EQ_EMPTY ← prove
   r"!top:A topology. connected_components_of top = {} <=> topspace top = {}"
   (REWRITE_TAC [connected_components_of] THEN SET_TAC [])

  let CONNECTED_COMPONENTS_OF_EMPTY_SPACE ← prove
   r"!top:A topology. topspace top = {} ==> connected_components_of top = {}"
   (REWRITE_TAC [CONNECTED_COMPONENTS_OF_EQ_EMPTY])

  let CONNECTED_COMPONENTS_OF_SUBSET_SING ← prove
   r"!top s:A->bool.
        connected_components_of top SUBSET {s} <=>
        connected_space top /\ (topspace top = {} \/ topspace top = s)"
   (REPEAT GEN_TAC THEN
    REWRITE_TAC [CONNECTED_SPACE_IFF_COMPONENTS_EQ, ← sr
     r"(!x y. x IN s /\ y IN s ==> x = y) <=> s = {} \/ ?a. s = {a}"] THEN
    ASM_CASES_TAC (← q r"topspace top:A->bool = {}") THEN
    ASM_SIMP_TAC [CONNECTED_COMPONENTS_OF_EMPTY_SPACE, EMPTY_SUBSET] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENTS_OF_EQ_EMPTY, ← sr
     r"s SUBSET {a} <=> s = {} \/ s = {a}"] THEN
    MESON_TAC [UNIONS_CONNECTED_COMPONENTS_OF, UNIONS_1])

  let CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING ← prove
   r"!top:A topology.
        connected_space top <=> ?a. connected_components_of top SUBSET {a}"
   (MESON_TAC [CONNECTED_COMPONENTS_OF_SUBSET_SING])

  let CONNECTED_COMPONENTS_OF_EQ_SING ← prove
   r"!top s:A->bool.
        connected_components_of top = {s} <=>
        connected_space top /\ ~(topspace top = {}) /\ s = topspace top"
   (REWRITE_TAC [CONNECTED_COMPONENTS_OF_SUBSET_SING,
                 CONNECTED_COMPONENTS_OF_EQ_EMPTY,
                 ← sr r"s = {a} <=> s SUBSET {a} /\ ~(s = {})"] THEN
    MESON_TAC [])

  let CONNECTED_COMPONENTS_OF_CONNECTED_SPACE ← prove
   r"!top:A topology.
        connected_space top
        ==> connected_components_of top =
            if topspace top = {} then {} else {topspace top}"
   (ASM_MESON_TAC [CONNECTED_COMPONENTS_OF_EMPTY_SPACE,
                   CONNECTED_COMPONENTS_OF_EQ_SING])

  let EXISTS_CONNECTED_COMPONENT_OF_SUPERSET ← prove
   r"!top s:A->bool.
        connected_in top s /\ ~(topspace top = {})
        ==> ?c. c IN connected_components_of top /\ s SUBSET c"
   (REPEAT STRIP_TAC THEN ASM_CASES_TAC (← q r"s:A->bool = {}") THENL
     [ASM_REWRITE_TAC [EMPTY_SUBSET, MEMBER_NOT_EMPTY] THEN
      ASM_REWRITE_TAC [CONNECTED_COMPONENTS_OF_EQ_EMPTY],
      UNDISCH_TAC (← q r"~(s:A->bool = {})") THEN
      REWRITE_TAC [← GSYM MEMBER_NOT_EMPTY, LEFT_IMP_EXISTS_THM]] THEN
    X_GEN_TAC (← q r"a:A") THEN DISCH_TAC THEN
    EXISTS_TAC (← q r"connected_component_of top (a:A)") THEN CONJ_TAC THENL
     [RULE_ASSUM_TAC (REWRITE_RULE [connected_in]) THEN
      REWRITE_TAC [CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF] THEN
      ASM SET_TAC [],
      MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
      ASM_REWRITE_TAC []])

  let CLOSED_IN_CONNECTED_COMPONENTS_OF ← prove
   r"!top c:A->bool.
        c IN connected_components_of top ==> closed_in top c"
   (REWRITE_TAC [connected_components_of, FORALL_IN_GSPEC] THEN
    REPEAT STRIP_TAC THEN REWRITE_TAC [← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_SUBSET_TOPSPACE] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_OF_MAXIMAL THEN
    SIMP_TAC [CONNECTED_IN_CLOSURE_OF, CONNECTED_IN_CONNECTED_COMPONENT_OF] THEN
    MATCH_MP_TAC (← REWRITE_RULE [SUBSET] CLOSURE_OF_SUBSET_INTER) THEN
    ASM_REWRITE_TAC [IN_INTER] THEN REWRITE_TAC [IN] THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_REFL])

  let CLOSED_IN_CONNECTED_COMPONENT_OF ← prove
   r"!top x:A. closed_in top (connected_component_of top x)"
   (REPEAT GEN_TAC THEN ASM_CASES_TAC (← q r"(x:A) IN topspace top") THENL
     [MATCH_MP_TAC CLOSED_IN_CONNECTED_COMPONENTS_OF THEN
      ASM_MESON_TAC [CONNECTED_COMPONENT_IN_CONNECTED_COMPONENTS_OF],
      ASM_MESON_TAC [CLOSED_IN_EMPTY, CONNECTED_COMPONENT_OF_EQ_EMPTY]])

  let OPEN_IN_FINITE_CONNECTED_COMPONENTS ← prove
   r"!top c:A->bool.
        FINITE(connected_components_of top) /\
        c IN connected_components_of top
        ==> open_in top c"
   (REPEAT STRIP_TAC THEN
    ASM_SIMP_TAC [OPEN_IN_CLOSED_IN_EQ, CONNECTED_COMPONENTS_OF_SUBSET] THEN
    ASM_SIMP_TAC [COMPLEMENT_CONNECTED_COMPONENTS_OF_UNIONS] THEN
    MATCH_MP_TAC CLOSED_IN_UNIONS THEN
    ASM_SIMP_TAC [FINITE_DELETE, IN_DELETE, CLOSED_IN_CONNECTED_COMPONENTS_OF])

  let CONNECTED_COMPONENT_OF_EQ_OVERLAP ← prove
   r"!top x y:A.
      connected_component_of top x = connected_component_of top y <=>
      ~(x IN topspace top) /\ ~(y IN topspace top) \/
      ~(connected_component_of top x INTER connected_component_of top y = {})"
   (REWRITE_TAC [← GSYM DISJOINT, CONNECTED_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ] THEN
    MESON_TAC [CONNECTED_COMPONENT_IN_TOPSPACE])

  let CONNECTED_COMPONENT_OF_NONOVERLAP ← prove
   r"!top x y:A.
     connected_component_of top x INTER connected_component_of top y = {} <=>
     ~(x IN topspace top) \/ ~(y IN topspace top) \/
     ~(connected_component_of top x = connected_component_of top y)"
   (REWRITE_TAC [← GSYM DISJOINT, CONNECTED_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ] THEN
    MESON_TAC [CONNECTED_COMPONENT_IN_TOPSPACE])

  let CONNECTED_COMPONENT_OF_OVERLAP ← prove
   r"!top x y:A.
    ~(connected_component_of top x INTER connected_component_of top y = {}) <=>
    x IN topspace top /\ y IN topspace top /\
    connected_component_of top x = connected_component_of top y"
   (REWRITE_TAC [← GSYM DISJOINT, CONNECTED_COMPONENT_OF_DISJOINT] THEN
    REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ] THEN
    MESON_TAC [CONNECTED_COMPONENT_IN_TOPSPACE])

  let CONNECTED_COMPONENTS_OF_DISJOINT ← prove
   r"!top c c'.
        c IN connected_components_of top /\ c' IN connected_components_of top
        ==> (DISJOINT c c' <=> ~(c = c'))"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, connected_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, CONNECTED_COMPONENT_OF_NONOVERLAP])

  let CONNECTED_COMPONENTS_OF_OVERLAP ← prove
   r"!top c c'.
        c IN connected_components_of top /\ c' IN connected_components_of top
        ==> (~(c INTER c' = {}) <=> c = c')"
   (REWRITE_TAC [IMP_CONJ, RIGHT_FORALL_IMP_THM, connected_components_of] THEN
    SIMP_TAC [FORALL_IN_GSPEC, DISJOINT, CONNECTED_COMPONENT_OF_NONOVERLAP])

  let CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF ← prove
   r"!top s:A->bool.
        connected_in top s <=>
        s SUBSET topspace top /\
        !x y. x IN s /\ y IN s ==> connected_component_of (subtopology top s) x y"
   (REPEAT GEN_TAC THEN EQ_TAC THENL
     [DISCH_TAC THEN CONJ_TAC THENL
       [ASM_MESON_TAC [connected_in], ALL_TAC] THEN
      REPEAT STRIP_TAC THEN
      MP_TAC (← ISPEC (← q r"subtopology top s:A topology")
        CONNECTED_SPACE_IFF_CONNECTED_COMPONENT) THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [connected_in]) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      STRIP_TAC THEN ASM_SIMP_TAC [← sr r"(s:A->bool) SUBSET t ==> t INTER s = s"],
      STRIP_TAC THEN REWRITE_TAC [connected_in] THEN
      ASM_REWRITE_TAC [] THEN
      MP_TAC (← ISPEC (← q r"subtopology top s:A topology")
        CONNECTED_SPACE_IFF_CONNECTED_COMPONENT) THEN
      REWRITE_TAC [TOPSPACE_SUBTOPOLOGY] THEN
      ASM_SIMP_TAC [← sr r"(s:A->bool) SUBSET t ==> t INTER s = s"]])

  let PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF ← prove
   r"!top:A topology.
        pairwise (separated_in top) (connected_components_of top)"
   (REWRITE_TAC [pairwise] THEN
    SIMP_TAC [CLOSED_IN_CONNECTED_COMPONENTS_OF, SEPARATED_IN_CLOSED_SETS] THEN
    REWRITE_TAC [← GSYM pairwise, PAIRWISE_DISJOINT_CONNECTED_COMPONENTS_OF])

  let CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE ← prove
   r"!top:A topology. connected_components_of top <=_c topspace top"
   (GEN_TAC THEN MATCH_MP_TAC CARD_LE_RELATIONAL_FULL THEN
    EXISTS_TAC (← q r"(IN):A->(A->bool)->bool") THEN CONJ_TAC THENL
     [REPEAT STRIP_TAC THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
      FIRST_ASSUM (MP_TAC o MATCH_MP NONEMPTY_CONNECTED_COMPONENTS_OF) THEN
      SET_TAC [],
      MESON_TAC [← REWRITE_RULE [← GSYM MEMBER_NOT_EMPTY, IN_INTER]
                  CONNECTED_COMPONENTS_OF_OVERLAP]])

  let FINITE_CONNECTED_COMPONENTS_OF_FINITE ← prove
   r"!top:A topology.
        FINITE(topspace top) ==> FINITE(connected_components_of top)"
   (GEN_TAC THEN
    MATCH_MP_TAC (← REWRITE_RULE [IMP_CONJ_ALT] CARD_LE_FINITE) THEN
    REWRITE_TAC [CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE])

  let CONNECTED_COMPONENT_OF_UNIQUE ← prove
   r"!top c x:A.
        x IN c /\ connected_in top c /\
        (!c'. x IN c' /\ connected_in top c' ==> c' SUBSET c)
        ==> connected_component_of top x = c"
   (REPEAT STRIP_TAC THEN
    ONCE_REWRITE_TAC [← sr r"R = s <=> !x. R x <=> x IN s"] THEN
    REWRITE_TAC [connected_component_of] THEN ASM SET_TAC [])

  let CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY ← prove
   r"!top c:A->bool.
        c IN connected_components_of(subtopology top s) /\
        top closure_of c SUBSET s
        ==> closed_in top c"
   (REPEAT STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o SPEC (← q r"top closure_of c:A->bool") o
     MATCH_MP (← ONCE_REWRITE_RULE [IMP_CONJ] CONNECTED_COMPONENTS_OF_MAXIMAL)) THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP CONNECTED_COMPONENTS_OF_SUBSET) THEN
    ASM_SIMP_TAC [CONNECTED_IN_SUBTOPOLOGY, TOPSPACE_SUBTOPOLOGY,
                  SUBSET_INTER, ← GSYM CLOSURE_OF_SUBSET_EQ] THEN
    STRIP_TAC THEN DISCH_THEN MATCH_MP_TAC THEN CONJ_TAC THENL
     [ASM_MESON_TAC [CONNECTED_IN_SUBTOPOLOGY, CONNECTED_IN_CLOSURE_OF,
                     CONNECTED_IN_CONNECTED_COMPONENTS_OF],
      MATCH_MP_TAC (← sr r"c SUBSET d /\ ~(c = {}) ==> ~DISJOINT c d") THEN
      ASM_SIMP_TAC [CLOSURE_OF_SUBSET] THEN
      ASM_MESON_TAC [NONEMPTY_CONNECTED_COMPONENTS_OF]])

  let CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY ← prove
   r"!u x:A. connected_component_of (discrete_topology u) x =
           if x IN u then {x} else {}"
   (REPEAT GEN_TAC THEN COND_CASES_TAC THEN
    ASM_REWRITE_TAC [CONNECTED_COMPONENT_OF_EQ_EMPTY,
                     TOPSPACE_DISCRETE_TOPOLOGY] THEN
    MATCH_MP_TAC CONNECTED_COMPONENT_OF_UNIQUE THEN
    ASM_REWRITE_TAC [CONNECTED_IN_DISCRETE_TOPOLOGY, IN_SING, SING_SUBSET] THEN
    SET_TAC [])

  let CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY ← prove
   r"!u:A->bool.
        connected_components_of (discrete_topology u) = {{x} | x IN u}"
   (GEN_TAC THEN REWRITE_TAC [connected_components_of] THEN
    REWRITE_TAC [TOPSPACE_DISCRETE_TOPOLOGY,
                 CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY] THEN
    SET_TAC [])

  return { CONNECTED_SPACE_IFF_COMPONENTS_EQ, CONNECTED_COMPONENTS_OF_EQ_EMPTY,
           CONNECTED_COMPONENTS_OF_EMPTY_SPACE, CONNECTED_COMPONENTS_OF_SUBSET_SING,
           CONNECTED_SPACE_IFF_COMPONENTS_SUBSET_SING, CONNECTED_COMPONENTS_OF_EQ_SING,
           CONNECTED_COMPONENTS_OF_CONNECTED_SPACE, EXISTS_CONNECTED_COMPONENT_OF_SUPERSET,
           CLOSED_IN_CONNECTED_COMPONENTS_OF, CLOSED_IN_CONNECTED_COMPONENT_OF,
           OPEN_IN_FINITE_CONNECTED_COMPONENTS, CONNECTED_COMPONENT_OF_EQ_OVERLAP,
           CONNECTED_COMPONENT_OF_NONOVERLAP, CONNECTED_COMPONENT_OF_OVERLAP,
           CONNECTED_COMPONENTS_OF_DISJOINT, CONNECTED_COMPONENTS_OF_OVERLAP,
           CONNECTED_IN_IFF_CONNECTED_COMPONENT_OF, PAIRWISE_SEPARATED_CONNECTED_COMPONENTS_OF,
           CARD_LE_CONNECTED_COMPONENTS_OF_TOPSPACE, FINITE_CONNECTED_COMPONENTS_OF_FINITE,
           CONNECTED_COMPONENT_OF_UNIQUE, CLOSED_IN_CONNECTED_COMPONENT_OF_SUBTOPOLOGY,
           CONNECTED_COMPONENT_OF_DISCRETE_TOPOLOGY, CONNECTED_COMPONENTS_OF_DISCRETE_TOPOLOGY }

