    FIRST_X_ASSUM (MP_TAC o SPEC (← q r"s:A->bool")) THEN
    ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
    FIRST_ASSUM (MP_TAC o MATCH_MP OPEN_IN_SUBSET) THEN SET_TAC [])

  return { BAIRE_CATEGORY_ALT, BAIRE_CATEGORY }

