              EXISTS_TAC (← q r"a0:real") THEN
           REWRITE_TAC [IN_INTER, IN_ELIM_THM] THEN ASM_REWRITE_TAC [] THEN
           ASM_REAL_ARITH_TAC, ALL_TAC] THEN
          SUBGOAL_THEN (← q r"~((C:real->bool) INTER {s:real | y <= s} = {})")
