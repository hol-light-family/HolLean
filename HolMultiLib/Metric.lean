    FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [MCOMPLETE_FIP_SING]) THEN
    DISCH_THEN (MP_TAC o SPEC
     (← q r"{ mtopology m closure_of (IMAGE (f:A->B) ((s INTER u) DELETE a)) |u|
