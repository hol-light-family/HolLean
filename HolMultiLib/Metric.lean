structure Components3 where
  CARD_LE_CONNNECTED_COMPONENTS_CONNECTED_IN : thm
  CARD_LE_CONNECTED_COMPONENTS_ALT : thm
  CONNECTED_COMPONENT_OF_CONTINUOUS_IMAGE : thm
  HOMEOMORPHIC_MAP_CONNECTED_COMPONENT_OF : thm
  HOMEOMORPHIC_MAP_CONNECTED_COMPONENTS_OF : thm
  CONNECTED_COMPONENT_OF_PAIR : thm
  CONNECTED_COMPONENTS_OF_PROD_TOPOLOGY : thm
  CONNECTED_COMPONENT_OF_PRODUCT_TOPOLOGY : thm
  CONNECTED_COMPONENTS_OF_PRODUCT_TOPOLOGY : thm
