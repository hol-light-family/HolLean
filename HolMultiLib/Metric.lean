         ASM_MESON_TAC [REAL_LT_DIV2_EQ], ALL_TAC] THEN
           REWRITE_TAC [← GSYM REAL_OF_NUM_ADD,
                        ← GSYM REAL_OF_NUM_LT] THEN REAL_ARITH_TAC, ALL_TAC] THEN
       /- J and J' differ by at most 1 -/
       SUBGOAL_THEN (← q r"J = J' \/ J = SUC J' \/ J' = SUC J")
         ASSUME_TAC THENL [SUBGOAL_THEN (← q r"J <= J' + 1 /\ J' <= J + 1") MP_TAC THENL
        [CONJ_TAC THENL [EXPAND_TAC "J" THEN ASM_SIMP_TAC [LE_LDIV_EQ] THEN
          REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = SUC(n + 1)"),
                       MULT_CLAUSES] THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
          TRANS_TAC LT_TRANS (← q r"K' + D:num") THEN
            CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC,
           REWRITE_TAC [LT_ADD_RCANCEL] THEN EXPAND_TAC "J'" THEN
           ASM_SIMP_TAC [← GSYM RDIV_LT_EQ] THEN ARITH_TAC],
          EXPAND_TAC "J'" THEN ASM_SIMP_TAC [LE_LDIV_EQ] THEN
          REWRITE_TAC [← ARITH_RULE (← q r"(n + 1) + 1 = SUC(n + 1)"),
                       MULT_CLAUSES] THEN ONCE_REWRITE_TAC [ADD_SYM] THEN
          TRANS_TAC LT_TRANS (← q r"K + D:num") THEN
            CONJ_TAC THENL [FIRST_ASSUM ACCEPT_TAC,
           REWRITE_TAC [LT_ADD_RCANCEL] THEN EXPAND_TAC "J" THEN
           ASM_SIMP_TAC [← GSYM RDIV_LT_EQ] THEN
             ARITH_TAC]], ARITH_TAC], ALL_TAC] THEN
       /- Triangle inequality: mdist(h M K', h M K) < eps -/
       MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"(ep:num->real) n0") THEN
         ASM_REWRITE_TAC [] THEN
       /- Bound via intermediate points h n0 J', h n0 J -/
       SUBGOAL_THEN (← q r"(h:num->num->A) n0 J IN mspace m /\ h n0 J' IN mspace m /\
          h M K IN mspace m /\ h M K' IN mspace m")
         STRIP_ASSUME_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN
           MATCH_MP_TAC REAL_LE_TRANS THEN
       EXISTS_TAC
         (← q r"mdist m ((h:num->num->A) M K', h n0 J') +
          mdist m (h n0 J', h n0 J) + mdist m (h n0 J, h M K)") THEN
       CONJ_TAC THENL [MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC
          (← q r"mdist m ((h:num->num->A) M K', h n0 J') +
           mdist m (h n0 J', h M K)") THEN ASM_SIMP_TAC [MDIST_TRIANGLE] THEN
        MATCH_MP_TAC REAL_LE_LADD_IMP THEN
          ASM_SIMP_TAC [MDIST_TRIANGLE, REAL_LE_REFL], ALL_TAC] THEN
       /- Bound each term -/
       SUBGOAL_THEN
         (← q r"mdist m ((h:num->num->A) M K', h n0 J') <= (ep:num->real) n0 / &3 /\
          mdist m (h n0 J, h M K) <= ep n0 / &3 /\
          mdist m (h n0 J', h n0 J) <= ep(SUC n0)")
         STRIP_ASSUME_TAC THENL [REPEAT CONJ_TAC THENL
        [/- mdist(h M K', h n0 J') = mdist(h n0 J', h M K') <= ep n0/3 -/
         SUBGOAL_THEN (← q r"mdist m ((h:num->num->A) M K', h n0 J') =
            mdist m (h n0 J',
              h M K')") SUBST1_TAC THENL [ASM_SIMP_TAC [MDIST_SYM], ALL_TAC] THEN
         SUBGOAL_THEN (← q r"(h:num->num->A) n0 J' =
            h n0 (K' DIV ((N:num->num) M DIV N n0))")
           SUBST1_TAC THENL [AP_TERM_TAC THEN EXPAND_TAC "J'" THEN
             EXPAND_TAC "D" THEN REFL_TAC,
          USE_THEN "telesc" MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
         /- mdist(h n0 J, h M K) <= ep n0 / 3 -/
         SUBGOAL_THEN (← q r"(h:num->num->A) n0 J =
            h n0 (K DIV ((N:num->num) M DIV N n0))")
           SUBST1_TAC THENL [AP_TERM_TAC THEN EXPAND_TAC "J" THEN
             EXPAND_TAC "D" THEN REFL_TAC,
          USE_THEN "telesc" MATCH_MP_TAC THEN ASM_REWRITE_TAC []],
         /- mdist(h n0 J', h n0 J) <= ep(SUC n0) -/
         FIRST_X_ASSUM (DISJ_CASES_THEN2 SUBST_ALL_TAC
           (DISJ_CASES_THEN2 SUBST_ALL_TAC SUBST_ALL_TAC)) THENL
         [MATCH_MP_TAC (← REAL_ARITH (← q r"a = &0 /\ &0 < b ==> a <= b")) THEN
           ASM_MESON_TAC [MDIST_REFL],
          MATCH_MP_TAC REAL_LT_IMP_LE THEN
            USE_THEN "adj" (MP_TAC o SPECL [← q r"n0:num", ← q r"J':num"]) THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []],
          SUBGOAL_THEN (← q r"mdist m ((h:num->num->A) n0 (SUC J), h n0 J) =
             mdist m (h n0 J,
               h n0 (SUC
                 J))") SUBST1_TAC THENL [ASM_MESON_TAC [MDIST_SYM], ALL_TAC] THEN
          MATCH_MP_TAC REAL_LT_IMP_LE THEN
            USE_THEN "adj" (MP_TAC o SPECL [← q r"n0:num", ← q r"J:num"]) THEN
          ANTS_TAC THENL [ASM_ARITH_TAC, SIMP_TAC []]]], ALL_TAC] THEN
            REPEAT (FIRST_X_ASSUM (fun th => tactic_of do
         let c := concl th
         if !(HolCore.Basics.is_forall c) &&
            HolCore.Lib.can (HolCore.Basics.find_term (fun t =>
              match HolCore.Kernel.dest_const t with
              | .ok (n, _) => n == "mdist" | .error _ => false)) c
         then pure (MP_TAC th) else liftExcept (failwith "not mdist bound"))) THEN
       MP_TAC (← SPEC (← q r"n0:num")
         (← ASSUME (← q r"!n. (ep:num->real)(SUC n) <= ep n / &4"))) THEN
       MP_TAC (← SPEC (← q r"n0:num") (← ASSUME (← q r"!n. &0 < (ep:num->real) n"))) THEN
         REAL_ARITH_TAC])

  return { DENSE_FUNCTION_ON_DYADIC }


/- ------------------------------------------------------------------------- -/
/- Nearby paths; compact Peano spaces are path connected.                    -/
/- (metric.ml 48214-48490)                                                   -/
/- ------------------------------------------------------------------------- -/

structure NPATH where
  COMPACT_LOCALLY_CONNECTED_NEARBY_PATH : thm
  COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED : thm
  COMPACT_METRIZABLE_PEANO_IMP_PATH_CONNECTED : thm
  deriving Inhabited

@[nospecialize]
def setupNPATH [HolBase] (D : MetricDeps) (BClosure : Closure) (BContMap1 : ContMap1)
    (BCompact1 : Compact1) (BMetricSpace : MetricSpace) (BMTopology : MTopology)
    (BMetricHaus : MetricHaus) (BMetrizable : Metrizable) (BRealTop1 : RealTop1)
    (BRealTop2 : RealTop2) (BMCompact2 : MCompact2) (BPaths1 : Paths1) (BPaths2 : Paths2)
    (BLPC1 : LPC1) (BLPC2 : LPC2) (BUC1 : UC1) (BCC2 : CC2) (BCE3 : CE3) (BDIAM1 : DIAM1)
    (BULC1 : ULC1) (BULC4 : ULC4) (BDFD : DFD) :
    ExceptT String IO NPATH := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, SET_TAC, REAL_RAT_REDUCE_CONV, .. } := D
  let { FORALL_IN_IMAGE_2, .. } := D.core1
  let { INTER_UNIV, IN_ELIM_THM, IN_IMAGE, .. } := D.core2
  let { REAL_LET_TRANS, REAL_LE_ADD2, REAL_LE_TRANS, .. } := D.core3
  let { SUBSET, SUBSET_TRANS, .. } := D.core4
  let { IN_REAL_INTERVAL, REAL_HALF, .. } := D.misc
  let { CLOSURE_OF_MINIMAL, CLOSURE_OF_SUBTOPOLOGY_OPEN, .. } := BClosure
  let { CLOSED_IN_CONTINUOUS_MAP_PREIMAGE, .. } := BContMap1
  let { compact_space, .. } := BCompact1
  let { CENTRE_IN_MBALL, IN_MBALL, MBALL_SUBSET_CONCENTRIC, MDIST_SYM, MDIST_TRIANGLE,
        SUBMETRIC, .. } := BMetricSpace
  let { CLOSED_IN_MCBALL, IN_MCBALL, MTOPOLOGY_SUBMETRIC, OPEN_IN_MBALL, OPEN_IN_MTOPOLOGY,
        TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { metrizable_space, .. } := BMetrizable
  let { TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { COMPACT_SPACE_IMP_MCOMPLETE, .. } := BMCompact2
  let { path_in, .. } := BPaths1
  let { COMPACT_IN_PATH_IMAGE, PATH_CONNECTED_IN_PATH_IMAGE, .. } := BPaths2
  let { LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN, .. } := BLPC1
  let { PATH_CONNECTED_EQ_CONNECTED_SPACE, .. } := BLPC2
  let { uniformly_continuous_map, .. } := BUC1
  let { UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP, .. } := BCC2
  let { UNIFORMLY_CONTINUOUS_MAP_EXTENDS_TO_INTERMEDIATE_CLOSURE_OF, .. } := BCE3
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_LE, .. } := BDIAM1
  let { ulc_space, .. } := BULC1
  let { COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE, .. } := BULC4
  let { DENSE_FUNCTION_ON_DYADIC, .. } := BDFD
  -- @@SCOPE END

  -- Core lemma: nearby points in compact metrizable locally connected space
  -- can be joined by a path of small diameter.
  -- Proof uses multi-scale ULC chain construction (Willard 31.4):
  -- 1. Get ULC sequences eps_k, del_k at decreasing scales
  -- 2. Build iterated chains: refine at each level
  -- 3. Define function on dense set, show uniformly continuous
  -- 4. Extend to [0,1] via extension theorem
  -- 5. Extension gives continuous path with small diameter
  let COMPACT_LOCALLY_CONNECTED_NEARBY_PATH ← do
    let COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_ULC ← prove
     r"!m:A metric.
         compact_space (mtopology m) /\ locally_connected_space (mtopology m)
         ==> !e. &0 < e
                 ==> ?d. &0 < d /\
                         !x y. x IN mspace m /\ y IN mspace m /\
                                mdist m (x,y) < d
                               ==> ?c. connected_in (mtopology m) c /\
                                       x IN c /\ y IN c /\
                                       mbounded m c /\
                                       mdiameter m c < e"
     (REPEAT STRIP_TAC THEN SUBGOAL_THEN (← q r"ulc_space (m:A metric)") MP_TAC THENL
      [MATCH_MP_TAC COMPACT_IN_LOCALLY_CONNECTED_IMP_ULC_SPACE THEN
       ASM_REWRITE_TAC [← GSYM TOPSPACE_MTOPOLOGY, ← GSYM compact_space],
       ALL_TAC] THEN
      REWRITE_TAC [ulc_space] THEN DISCH_THEN (MP_TAC o SPEC (← q r"e / &2")) THEN
        ASM_SIMP_TAC [REAL_HALF] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"c:A->bool") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"c:A->bool") THEN ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC)
    prove
     r"!m:A metric.
       compact_space (mtopology m) /\ locally_connected_space (mtopology m)
       ==> !e. &0 < e
               ==> ?d. &0 < d /\
                       !x y. x IN mspace m /\ y IN mspace m /\
                              mdist m (x,y) < d
                             ==> ?g. path_in (mtopology m) g /\
                                     g(&0) = x /\ g(&1) = y /\
                                     IMAGE g (real_interval[&0,&1])
                                       SUBSET mspace m /\
                                     mdiameter m
                                       (IMAGE g (real_interval[&0,&1])) < e"
     (GEN_TAC THEN STRIP_TAC THEN X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
      /- mcomplete m -/
      SUBGOAL_THEN (← q r"mcomplete (m:A metric)") ASSUME_TAC THENL
        [ASM_MESON_TAC [COMPACT_SPACE_IMP_MCOMPLETE], ALL_TAC] THEN
      /- Get ULC function: for any eps > 0, get del > 0 -/
      SUBGOAL_THEN (← q r"!eps. &0 < eps
               ==> ?del. &0 < del /\
                         !x y:A. x IN mspace m /\ y IN mspace m /\
                                 mdist m (x,y) < del
                                 ==> ?c. connected_in(mtopology m) c /\
                                         x IN c /\ y IN c /\
                                         mbounded m c /\
                                         mdiameter m c < eps")
        (LABEL_TAC "ULC") THENL [GEN_TAC THEN DISCH_TAC THEN
       MP_TAC (← ISPEC (← q r"m:A metric") COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_ULC) THEN
       ASM_REWRITE_TAC [] THEN DISCH_THEN (MP_TAC o SPEC (← q r"eps:real")) THEN
         ASM_REWRITE_TAC [] THEN
       DISCH_THEN ACCEPT_TAC, ALL_TAC] THEN
      /- Key subgoal: for any x, y close enough, construct a path.
         We use the multi-scale chain construction + extension theorem.
         The function on a dense subset of [0,1] is uniformly continuous,
         and its extension gives the desired continuous path. -/
      SUBGOAL_THEN (← q r"?d. &0 < d /\
             !x y:A. x IN mspace m /\ y IN mspace m /\ mdist m (x,y) < d
                     ==> ?f s. s SUBSET real_interval[&0,&1] /\
                               real_interval[&0,&1] SUBSET
                                 euclideanreal closure_of s /\
                               &0 IN s /\ &1 IN s /\
                               (f:real->A)(&0) = x /\ f(&1) = y /\
                               IMAGE f s SUBSET mspace m /\
                               (!a. a IN s ==> mdist m (x,f a) <= e / &4) /\
                               uniformly_continuous_map
                                 (submetric real_euclidean_metric s, m) f")
        STRIP_ASSUME_TAC THENL
      [MP_TAC (← ISPECL [← q r"m:A metric", ← q r"e:real"] DENSE_FUNCTION_ON_DYADIC) THEN
        ANTS_TAC THENL
       [ASM_REWRITE_TAC [] THEN GEN_TAC THEN DISCH_TAC THEN
        USE_THEN "ULC" (MP_TAC o SPEC (← q r"eps:real")) THEN
        ASM_REWRITE_TAC [] THEN
          DISCH_THEN ACCEPT_TAC, DISCH_THEN ACCEPT_TAC], ALL_TAC] THEN
      /- Use the dense function subgoal to prove the main theorem -/
      EXISTS_TAC (← q r"d:real") THEN ASM_REWRITE_TAC [] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
      ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"f:real->A") (X_CHOOSE_THEN (← q r"s:real->bool")
        STRIP_ASSUME_TAC)) THEN
      /- Apply extension theorem -/
      MP_TAC (← ISPECL [← q r"real_euclidean_metric", ← q r"m:A metric",
        ← q r"f:real->A", ← q r"s:real->bool", ← q r"real_interval[&0,&1]"]
       UNIFORMLY_CONTINUOUS_MAP_EXTENDS_TO_INTERMEDIATE_CLOSURE_OF) THEN
      ANTS_TAC THENL
        [ASM_REWRITE_TAC [MTOPOLOGY_REAL_EUCLIDEAN_METRIC], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"g:real->A") THEN
      /- g is a path: uniformly continuous on submetric => continuous_map -/
      SUBGOAL_THEN
        (← q r"continuous_map(subtopology euclideanreal (real_interval[&0,&1]),
                        mtopology m) (g:real->A)") ASSUME_TAC THENL
      [REWRITE_TAC [← GSYM MTOPOLOGY_REAL_EUCLIDEAN_METRIC,
        ← GSYM MTOPOLOGY_SUBMETRIC] THEN
       MATCH_MP_TAC UNIFORMLY_CONTINUOUS_IMP_CONTINUOUS_MAP THEN
         ASM_REWRITE_TAC [], ALL_TAC] THEN
      ASM_REWRITE_TAC [path_in] THEN
      /- g(0) = x and g(1) = y -/
      REPLICATE_TAC 2 (CONJ_TAC THENL [ASM_MESON_TAC [], ALL_TAC]) THEN
      /- IMAGE g [0,1] SUBSET mspace m -/
      SUBGOAL_THEN (← q r"IMAGE (g:real->A) (real_interval[&0,&1]) SUBSET mspace m")
        ASSUME_TAC
      THENL [UNDISCH_TAC (← q r"uniformly_continuous_map
         (submetric real_euclidean_metric (real_interval[&0,&1]),m)
           (g:real->A)") THEN
       REWRITE_TAC [uniformly_continuous_map, SUBMETRIC, REAL_EUCLIDEAN_METRIC,
                    INTER_UNIV] THEN SET_TAC [], ALL_TAC] THEN ASM_REWRITE_TAC [] THEN
      /- mdiameter bound -/
      MATCH_MP_TAC REAL_LET_TRANS THEN EXISTS_TAC (← q r"e / &2") THEN CONJ_TAC THENL
      [SUBGOAL_THEN (← q r"!a:real. a IN real_interval[&0,&1]
                   ==> mdist m (x:A,(g:real->A) a) <= e / &4")
         ASSUME_TAC THENL [/- Proof: preimage of mcball(x,e/4) under g is closed
           in subtopology,
           contains s (dense), so equals all of [0,1]. -/ X_GEN_TAC (← q r"a:real") THEN
             DISCH_TAC THEN
        /- The preimage set -/
        ABBREV_TAC (← q r"P = {t:real | t IN real_interval[&0,&1] /\
                         (g:real->A) t IN mcball m (x:A, e / &4)}") THEN
        /- P is closed in subtopology -/
        SUBGOAL_THEN (← q r"closed_in (subtopology euclideanreal (real_interval[&0,&1]))
                     (P:real->bool)") ASSUME_TAC THENL
         [EXPAND_TAC "P" THEN SUBGOAL_THEN
           (← q r"{t:real | t IN real_interval[&0,&1] /\
                      (g:real->A) t IN mcball m (x:A, e / &4)} =
            {t | t IN topspace(subtopology euclideanreal (real_interval[&0,&1]))
                 /\ g t IN mcball m (x, e / &4)}")
           SUBST1_TAC THENL [REWRITE_TAC [TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY],
             ALL_TAC] THEN
         MATCH_MP_TAC CLOSED_IN_CONTINUOUS_MAP_PREIMAGE THEN
           EXISTS_TAC (← q r"mtopology (m:A metric)") THEN
         ASM_REWRITE_TAC [CLOSED_IN_MCBALL], ALL_TAC] THEN
        /- s SUBSET P -/
        SUBGOAL_THEN (← q r"(s:real->bool) SUBSET P") ASSUME_TAC THENL
        [EXPAND_TAC "P" THEN REWRITE_TAC [SUBSET, IN_ELIM_THM, IN_MCBALL] THEN
         X_GEN_TAC (← q r"b:real") THEN DISCH_TAC THEN
         SUBGOAL_THEN (← q r"(g:real->A) b = (f:real->A) b") SUBST1_TAC THENL
           [ASM_MESON_TAC [], ALL_TAC]
           THEN
         ASM SET_TAC [], ALL_TAC] THEN
        /- Closure of s in subtopology = real_interval[0,1] -/
        SUBGOAL_THEN
          (← q r"(subtopology euclideanreal (real_interval[&0,&1])) closure_of s =
           real_interval[&0,&1]") ASSUME_TAC THENL
        [MP_TAC (← ISPECL [← q r"euclideanreal", ← q r"real_interval[&0,&1]",
                           ← q r"s:real->bool"] CLOSURE_OF_SUBTOPOLOGY_OPEN) THEN
         ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
           DISCH_THEN (fun th => REWRITE_TAC [th]) THEN
         UNDISCH_TAC
           (← q r"real_interval[&0,&1] SUBSET euclideanreal closure_of s") THEN
             SET_TAC [], ALL_TAC] THEN
        /- a IN P by CLOSURE_OF_MINIMAL -/
        SUBGOAL_THEN (← q r"(a:real) IN P") MP_TAC THENL [MP_TAC (← ISPECL
           [← q r"subtopology euclideanreal (real_interval[&0,&1])",
            ← q r"s:real->bool", ← q r"P:real->bool"] CLOSURE_OF_MINIMAL) THEN
         ASM_REWRITE_TAC [] THEN ASM SET_TAC [], ALL_TAC] THEN
        EXPAND_TAC "P" THEN REWRITE_TAC [IN_ELIM_THM, IN_MCBALL] THEN
          MESON_TAC [], ALL_TAC] THEN
       MATCH_MP_TAC MDIAMETER_LE THEN ASM_REWRITE_TAC [] THEN
       CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
         REWRITE_TAC [FORALL_IN_IMAGE_2] THEN
       MAP_EVERY X_GEN_TAC [← q r"u:real", ← q r"v:real"] THEN STRIP_TAC THEN
       SUBGOAL_THEN (← q r"(g:real->A) u IN mspace m /\ g v IN mspace m /\
                       (x:A) IN mspace
                         m") STRIP_ASSUME_TAC THENL [ASM SET_TAC [], ALL_TAC] THEN
       MATCH_MP_TAC REAL_LE_TRANS THEN
       EXISTS_TAC (← q r"mdist m ((g:real->A) u, x:A) + mdist m (x:A, g v)") THEN
       CONJ_TAC THENL [ASM_SIMP_TAC [MDIST_TRIANGLE], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"mdist m ((g:real->A) u, x:A) = mdist m (x,g u)")
         SUBST1_TAC THENL [ASM_MESON_TAC [MDIST_SYM], ALL_TAC] THEN
       MATCH_MP_TAC REAL_LE_TRANS THEN EXISTS_TAC (← q r"e / &4 + e / &4") THEN
       CONJ_TAC THENL [MATCH_MP_TAC REAL_LE_ADD2 THEN
         ASM_SIMP_TAC [], ASM_REAL_ARITH_TAC],
       ASM_REAL_ARITH_TAC])

  -- Key: compact metrizable locally connected =>
  -- locally path connected. Use nearby paths + chains.
  let COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED ← prove
   r"!top:A topology.
     compact_space top /\ metrizable_space top /\
     locally_connected_space top
     ==> locally_path_connected_space top"
   (GEN_TAC THEN STRIP_TAC THEN
    FIRST_X_ASSUM (X_CHOOSE_THEN (← q r"m:A metric") SUBST_ALL_TAC o
      GEN_REWRITE_RULE id [metrizable_space]) THEN
    REWRITE_TAC [LOCALLY_PATH_CONNECTED_SPACE_IM_KLEINEN] THEN
    MAP_EVERY X_GEN_TAC [← q r"v:A->bool", ← q r"x:A"] THEN STRIP_TAC THEN
    /- x IN mspace m -/
    SUBGOAL_THEN (← q r"(x:A) IN mspace m") ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"open_in (mtopology m) (v:A->bool)") THEN
     REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN ASM SET_TAC [], ALL_TAC] THEN
    /- Get r > 0 with mball(x, r) SUBSET v -/
    SUBGOAL_THEN (← q r"?r. &0 < r /\ mball m (x:A, r) SUBSET v")
      STRIP_ASSUME_TAC THENL
    [UNDISCH_TAC (← q r"open_in (mtopology m) (v:A->bool)") THEN
      REWRITE_TAC [OPEN_IN_MTOPOLOGY] THEN
     DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (MP_TAC o SPEC (← q r"x:A"))) THEN
     ASM_REWRITE_TAC [], ALL_TAC] THEN
    /- Get d from nearby path lemma for epsilon = r/2 -/
    MP_TAC (← ISPEC (← q r"m:A metric") COMPACT_LOCALLY_CONNECTED_NEARBY_PATH) THEN
    ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"r / &2")) THEN
    ANTS_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    DISCH_THEN (X_CHOOSE_THEN (← q r"d:real") STRIP_ASSUME_TAC) THEN
    /- Take u = mball(x, min(d, r/2)) -/
    EXISTS_TAC (← q r"mball m (x:A, min d (r / &2))") THEN
      SUBGOAL_THEN (← q r"&0 < min d (r / &2)") ASSUME_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
    REPEAT CONJ_TAC THENL [/- open_in -/ REWRITE_TAC [OPEN_IN_MBALL],
     /- x IN mball -/
     ASM_SIMP_TAC [CENTRE_IN_MBALL],
     /- mball SUBSET v -/
     MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"mball m (x:A, r)") THEN
       ASM_REWRITE_TAC [] THEN
     MATCH_MP_TAC MBALL_SUBSET_CONCENTRIC THEN ASM_REAL_ARITH_TAC,
     /- !y. y IN mball ==> path_connected_in -/
     X_GEN_TAC (← q r"y:A") THEN REWRITE_TAC [IN_MBALL] THEN STRIP_TAC THEN
     FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN
     ANTS_TAC THENL [ASM_REWRITE_TAC [] THEN ASM_REAL_ARITH_TAC, ALL_TAC] THEN
     DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
     EXISTS_TAC (← q r"IMAGE (g:real->A) (real_interval[&0,&1])") THEN
       REPEAT CONJ_TAC THENL
     [/- path_connected_in -/
      MATCH_MP_TAC PATH_CONNECTED_IN_PATH_IMAGE THEN ASM_REWRITE_TAC [],
      /- IMAGE SUBSET v -/
      MATCH_MP_TAC SUBSET_TRANS THEN EXISTS_TAC (← q r"mball m (x:A, r)") THEN
        ASM_REWRITE_TAC [] THEN
      REWRITE_TAC [SUBSET, IN_MBALL] THEN X_GEN_TAC (← q r"z:A") THEN DISCH_TAC THEN
      SUBGOAL_THEN (← q r"(z:A) IN mspace m") ASSUME_TAC THENL
        [ASM SET_TAC [], ALL_TAC] THEN
        ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC REAL_LET_TRANS THEN
      EXISTS_TAC (← q r"mdiameter m (IMAGE (g:real->A) (real_interval[&0,&1]))") THEN
        CONJ_TAC THENL
      [MATCH_MP_TAC MDIAMETER_BOUNDED_BOUND THEN ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL
       [MATCH_MP_TAC COMPACT_IN_IMP_MBOUNDED THEN
        MATCH_MP_TAC COMPACT_IN_PATH_IMAGE THEN ASM_REWRITE_TAC [],
        REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&0") THEN
        ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN
          CONV_TAC REAL_RAT_REDUCE_CONV], ASM_REAL_ARITH_TAC],
      /- x IN IMAGE -/
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&0") THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN CONV_TAC REAL_RAT_REDUCE_CONV,
      /- y IN IMAGE -/
      REWRITE_TAC [IN_IMAGE] THEN EXISTS_TAC (← q r"&1") THEN
      ASM_REWRITE_TAC [IN_REAL_INTERVAL] THEN CONV_TAC REAL_RAT_REDUCE_CONV]])

  -- Compact metrizable connected locally connected => path connected
  let COMPACT_METRIZABLE_PEANO_IMP_PATH_CONNECTED ← do
    let LOCALLY_PATH_CONNECTED_CONNECTED_IMP_PATH_CONNECTED_SPACE ← prove
     r"!top:A topology.
        locally_path_connected_space top /\ connected_space top
        ==> path_connected_space top"
     (MESON_TAC [PATH_CONNECTED_EQ_CONNECTED_SPACE])
    prove
     r"!top:A topology.
       compact_space top /\ metrizable_space top /\
       connected_space top /\ locally_connected_space top
       ==> path_connected_space top"
     (REPEAT STRIP_TAC THEN
      MATCH_MP_TAC (← ISPEC (← q r"top:A topology")
        LOCALLY_PATH_CONNECTED_CONNECTED_IMP_PATH_CONNECTED_SPACE) THEN
      ASM_REWRITE_TAC [] THEN
      MATCH_MP_TAC COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED
        THEN
      ASM_REWRITE_TAC [])

  return { COMPACT_LOCALLY_CONNECTED_NEARBY_PATH,
           COMPACT_METRIZABLE_LOCALLY_CONNECTED_IMP_LOCALLY_PATH_CONNECTED,
           COMPACT_METRIZABLE_PEANO_IMP_PATH_CONNECTED }

/- ------------------------------------------------------------------------- -/
/- Hahn-Mazurkiewicz theorem (backward direction).                           -/
/- Whyburn, Analytic Topology, Theorem (4.1); H-Y Theorem 3-30;              -/
/- Willard, General Topology, Theorem 31.5.                                  -/
/- Every compact, connected, locally connected, metrizable, nonempty space   -/
/- is a continuous image of [0,1].                                           -/
/- (metric.ml 48491-49886)                                                   -/
/- ------------------------------------------------------------------------- -/

structure PGF where
  PEANO_GAP_FILLING_EXTENSION : thm
  deriving Inhabited

set_option maxHeartbeats 4000000 in
@[nospecialize]
def setupPGF [HolBase] (D : MetricDeps) (BSubtopology : Subtopology) (BContMap1 : ContMap1)
    (BMetricSpace : MetricSpace) (BMTopology : MTopology) (BMetricHaus : MetricHaus)
    (BMetrizable : Metrizable) (BRealTop1 : RealTop1) (BRealTop2 : RealTop2)
    (BMetricCont : MetricCont) (BPaths1 : Paths1) (BPaths2 : Paths2)
    (BPathComp1 : PathComp1) (BDIAM1 : DIAM1) (BNPATH : NPATH) :
    ExceptT String IO PGF := do
  -- @@SCOPE BEGIN
  let { ASM_MESON_TAC, ASM_REAL_ARITH_TAC, MESON_TAC, REAL_ARITH, REAL_ARITH_TAC, REAL_FIELD,
        SET_TAC, .. } := D
  let { ELEMENT_LE_SUP, EXTENSION, FUN_IN_IMAGE, IMAGE_CLAUSES, IMAGE_CONST, .. } := D.core1
  let { INF, INF_APPROACH, INF_LE_ELEMENT, INTER_UNIV, IN_DIFF, IN_ELIM_THM, IN_IMAGE,
        IN_INTER, IN_UNIV, MEMBER_NOT_EMPTY, NOT_IN_EMPTY, REAL_ABS_0, REAL_ABS_DIV,
        REAL_ABS_NEG, .. } := D.core2
  let { REAL_ABS_REFL, REAL_INF_UNIQUE, REAL_LET_TRANS, REAL_LE_DIV, REAL_LE_INF,
        REAL_LE_LDIV_EQ, REAL_LE_REFL, REAL_LE_SUP, REAL_LE_TRANS, REAL_LTE_TRANS,
        REAL_LT_LDIV_EQ, REAL_LT_LE, REAL_LT_MIN, REAL_LT_MUL, REAL_LT_TRANS, REAL_NOT_LE,
        REAL_NOT_LT, .. } := D.core3
  let { REAL_SUB_REFL, REAL_SUB_RZERO, REAL_SUP_LE, REAL_SUP_UNIQUE, SKOLEM_THM, SUBSET,
        SUBSET_REFL, SUP, SUP_APPROACH, real_ge, real_gt, .. } := D.core4
  let { DE_MORGAN_THM, NOT_EXISTS_THM, RIGHT_IMP_EXISTS_THM, .. } := D.core5
  let { IN_REAL_INTERVAL, REAL_INTERVAL_NE_EMPTY, .. } := D.misc
  let { CLOSED_IN_TRANS_FULL, OPEN_IN_SUBTOPOLOGY, .. } := BSubtopology
  let { CONTINUOUS_MAP_CONST, continuous_map, .. } := BContMap1
  let { CENTRE_IN_MBALL, IN_MBALL, MDIST_POS_EQ, MDIST_REFL, MDIST_SYM, MDIST_TRIANGLE,
        SUBMETRIC, .. } := BMetricSpace
  let { MTOPOLOGY_SUBMETRIC, TOPSPACE_MTOPOLOGY, .. } := BMTopology
  let { COMPACT_IN_IMP_MBOUNDED, .. } := BMetricHaus
  let { METRIZABLE_SPACE_MTOPOLOGY, metrizable_space, .. } := BMetrizable
  let { REAL_CLOSED_HALFSPACE_GE, REAL_CLOSED_HALFSPACE_LE, REAL_CLOSED_IN, REAL_CLOSED_INTER,
        REAL_CLOSED_REAL_INTERVAL, REAL_OPEN_HALFSPACE_GT, REAL_OPEN_HALFSPACE_LT,
        REAL_OPEN_IN, TOPSPACE_EUCLIDEANREAL, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, real_closed,
        real_open, .. } := BRealTop1
  let { MTOPOLOGY_REAL_EUCLIDEAN_METRIC, REAL_EUCLIDEAN_METRIC, .. } := BRealTop2
  let { CONTINUOUS_MAP_TO_METRIC, METRIC_CONTINUOUS_MAP, .. } := BMetricCont
  let { path_connected_space, path_in, .. } := BPaths1
  let { COMPACT_IN_PATH_IMAGE, .. } := BPaths2
  let { PATH_CONNECTED_SPACE_IFF_PATH_COMPONENT, path_component_of, .. } := BPathComp1
  let { MDIAMETER_BOUNDED_BOUND, MDIAMETER_SING, .. } := BDIAM1
  let { COMPACT_LOCALLY_CONNECTED_NEARBY_PATH, COMPACT_METRIZABLE_PEANO_IMP_PATH_CONNECTED,
        .. } := BNPATH
  -- @@SCOPE END

  -- Gap-filling extension: extend continuous surjection from closed C in [0,1]
  -- Proof sketch: X is path-connected (Peano space). For each gap (a,b) of
  -- [0,1] \ C, connect f(a) to f(b) by a path. Use ULPC for diameter control
  -- near boundary points of C. Define F by f on C and paths on gaps.
  let PEANO_GAP_FILLING_EXTENSION ← do
    let SUP_IN_REAL_CLOSED ← prove
     r"!s. real_closed s /\ ~(s = {}) /\ (?b. !x. x IN s ==> x <= b)
           ==> sup s IN s"
     (GEN_TAC THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"sup s IN (s:real->bool)") THENL [ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_closed]) THEN
      REWRITE_TAC [real_open, IN_DIFF, IN_UNIV] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"sup s")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
      MP_TAC (← SPECL [← q r"s:real->bool", ← q r"sup s - e"] SUP_APPROACH) THEN
      ANTS_TAC THENL
      [ASM_REWRITE_TAC [] THEN
        CONJ_TAC THENL [ASM_MESON_TAC [], ASM_REAL_ARITH_TAC], ALL_TAC] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"y:real") STRIP_ASSUME_TAC) THEN
      SUBGOAL_THEN (← q r"(y:real) <= sup s") ASSUME_TAC THENL
      [MP_TAC (← ISPECL [← q r"s:real->bool", ← q r"y:real"] ELEMENT_LE_SUP) THEN
        ASM_MESON_TAC [], ALL_TAC] THEN
      SUBGOAL_THEN (← q r"abs(y - sup s) < e") ASSUME_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC] THEN ASM_MESON_TAC [])
    let INF_IN_REAL_CLOSED ← prove
     r"!s. real_closed s /\ ~(s = {}) /\ (?b. !x. x IN s ==> b <= x)
           ==> inf s IN s"
     (GEN_TAC THEN STRIP_TAC THEN
      ASM_CASES_TAC (← q r"inf s IN (s:real->bool)") THENL [ASM_REWRITE_TAC [],
        ALL_TAC] THEN
      FIRST_ASSUM (MP_TAC o GEN_REWRITE_RULE id [real_closed]) THEN
      REWRITE_TAC [real_open, IN_DIFF, IN_UNIV] THEN
      DISCH_THEN (MP_TAC o SPEC (← q r"inf s")) THEN ASM_REWRITE_TAC [] THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"e:real") STRIP_ASSUME_TAC) THEN
        MP_TAC (← SPEC (← q r"s:real->bool") INF) THEN
      ANTS_TAC THENL [ASM_MESON_TAC [], ALL_TAC] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"inf s + e / &2 <= inf s") MP_TAC THENL [FIRST_X_ASSUM
        MATCH_MP_TAC THEN
       X_GEN_TAC (← q r"y:real") THEN DISCH_TAC THEN
         SUBGOAL_THEN (← q r"inf s <= (y:real)") ASSUME_TAC THENL
           [ASM_MESON_TAC [], ALL_TAC] THEN
       SUBGOAL_THEN (← q r"~(abs(y - inf s) < e)") ASSUME_TAC THENL
         [ASM_MESON_TAC [], ALL_TAC] THEN
         ASM_REAL_ARITH_TAC,
       ASM_REAL_ARITH_TAC])
    let DIAMETER_CONTROLLED_PATH_CHOICE ← prove
     r"!m:A metric.
         compact_space (mtopology m) /\ locally_connected_space (mtopology m) /\
         connected_space (mtopology m) /\ ~(mspace m = {})
         ==> ?PP. (!x y. x IN mspace m /\ y IN mspace m
                         ==> path_in (mtopology m) (PP x y) /\
                             PP x y (&0) = x /\ PP x y (&1) = y /\
                             IMAGE (PP x y) (real_interval[&0,&1])
                               SUBSET mspace m) /\
                  (!e. &0 < e
                       ==> ?d. &0 < d /\
                               !x y. x IN mspace m /\ y IN mspace m /\
                                      mdist m (x,y) < d
                                     ==> mdiameter m
                                           (IMAGE (PP x y)
                                             (real_interval[&0,&1])) <
                                               e)"
     (GEN_TAC THEN STRIP_TAC THEN
      /- Get path_connected_space -/
      SUBGOAL_THEN
       (← q r"path_connected_space (mtopology (m:A metric))")
       ASSUME_TAC THENL
      [MATCH_MP_TAC COMPACT_METRIZABLE_PEANO_IMP_PATH_CONNECTED THEN
       ASM_REWRITE_TAC [METRIZABLE_SPACE_MTOPOLOGY], ALL_TAC] THEN
      /- Skolemize ULPC to get DELTA function -/
      MP_TAC (← ISPEC (← q r"m:A metric") COMPACT_LOCALLY_CONNECTED_NEARBY_PATH) THEN
        ASM_REWRITE_TAC [] THEN
      DISCH_THEN (MP_TAC o REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"DELTA:real->real") (LABEL_TAC "ULPC")) THEN
      /- For each (x,y), produce a path with controlled diameter -/
      SUBGOAL_THEN (← q r"!x y:A. x IN mspace m /\ y IN mspace m
           ==> ?g. path_in (mtopology m) g /\ g(&0) = x /\ g(&1) = y /\
                   IMAGE g (real_interval[&0,&1]) SUBSET mspace m /\
                   !e. &0 < e /\ mdist m (x:A,y) < DELTA e
                       ==> mdiameter m (IMAGE g (real_interval[&0,&1]))
                             < e + mdist m (x,y)")
        ASSUME_TAC THENL [REPEAT GEN_TAC THEN STRIP_TAC THEN
          ASM_CASES_TAC (← q r"x:A = y") THENL
       [/- Case x = y: use constant path -/
        EXISTS_TAC (← q r"(\t:real. x:A)") THEN REWRITE_TAC [] THEN
        ASM_REWRITE_TAC [] THEN
          REPEAT CONJ_TAC THENL [REWRITE_TAC [path_in, CONTINUOUS_MAP_CONST,
           TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY, TOPSPACE_MTOPOLOGY] THEN
         DISJ2_TAC THEN ASM_REWRITE_TAC [],
         SUBGOAL_THEN (← q r"~(real_interval[&0,&1] = {})") ASSUME_TAC THENL
         [REWRITE_TAC [REAL_INTERVAL_NE_EMPTY] THEN REAL_ARITH_TAC, ALL_TAC] THEN
         ASM_SIMP_TAC [IMAGE_CONST] THEN ASM SET_TAC [],
         REPEAT STRIP_TAC THEN
           SUBGOAL_THEN (← q r"~(real_interval[&0,&1] = {})") ASSUME_TAC THENL
         [REWRITE_TAC [REAL_INTERVAL_NE_EMPTY] THEN REAL_ARITH_TAC, ALL_TAC] THEN
         ASM_SIMP_TAC [IMAGE_CONST, MDIAMETER_SING] THEN
         ASM_SIMP_TAC [MDIST_REFL] THEN ASM_REAL_ARITH_TAC],
       /- Case x <> y -/
       ASM_CASES_TAC (← q r"{e:real | &0 < e /\ mdist m (x:A,y) < DELTA e} = {}") THENL
       [/- Sub-case: S empty - any path works, condition is vacuous -/
        FIRST_X_ASSUM (MP_TAC o GEN_REWRITE_RULE id [path_connected_space]) THEN
        REWRITE_TAC [TOPSPACE_MTOPOLOGY] THEN
        DISCH_THEN (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN ASM_REWRITE_TAC [] THEN
        DISCH_THEN (X_CHOOSE_THEN (← q r"g:real->A") STRIP_ASSUME_TAC) THEN
        EXISTS_TAC (← q r"g:real->A") THEN ASM_REWRITE_TAC [] THEN CONJ_TAC THENL
        [UNDISCH_TAC (← q r"path_in (mtopology (m:A metric)) (g:real->A)") THEN
         REWRITE_TAC [path_in, continuous_map, TOPSPACE_EUCLIDEANREAL_SUBTOPOLOGY,
           TOPSPACE_MTOPOLOGY] THEN MESON_TAC [SUBSET, IN_IMAGE],
         REPEAT STRIP_TAC THEN
           UNDISCH_TAC (← q r"{e:real | &0 < e /\ mdist m (x:A,y) < DELTA e} = {}") THEN
         REWRITE_TAC [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY] THEN
         DISCH_THEN (MP_TAC o SPEC (← q r"e:real")) THEN ASM_REWRITE_TAC []],
       /- Sub-case: S nonempty - use infimum argument -/
       ABBREV_TAC (← q r"S0 = {e:real | &0 < e /\ mdist m (x:A,y) < DELTA e}") THEN
       SUBGOAL_THEN (← q r"?b:real. !e. e IN S0 ==> b <= e") ASSUME_TAC THENL
       [EXISTS_TAC (← q r"&0") THEN EXPAND_TAC "S0" THEN
        REWRITE_TAC [IN_ELIM_THM] THEN REAL_ARITH_TAC, ALL_TAC] THEN
       SUBGOAL_THEN (← q r"mdist m (x:A,y) > &0") ASSUME_TAC THENL
         [ASM_MESON_TAC [MDIST_POS_EQ, REAL_LT_LE, real_gt], ALL_TAC] THEN
       /- inf S0 + mdist > inf S0, so by INF_APPROACH get e' in S0 -/
       SUBGOAL_THEN (← q r"inf S0 < inf S0 + mdist m (x:A,y)") ASSUME_TAC THENL
         [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
       MP_TAC (← SPECL [← q r"S0:real->bool", ← q r"inf S0 + mdist m (x:A,y)"]
         INF_APPROACH) THEN ASM_REWRITE_TAC [] THEN
       DISCH_THEN (X_CHOOSE_THEN (← q r"e0:real") STRIP_ASSUME_TAC) THEN
       /- e0 IN S0 means 0 < e0 and mdist < DELTA(e0) -/
       SUBGOAL_THEN (← q r"&0 < e0 /\ mdist m (x:A,y) < DELTA(e0:real)")
         STRIP_ASSUME_TAC THENL [UNDISCH_TAC (← q r"e0 IN (S0:real->bool)") THEN
        EXPAND_TAC "S0" THEN REWRITE_TAC [IN_ELIM_THM], ALL_TAC] THEN
       /- Use ULPC with e = e0 to get path -/
       USE_THEN "ULPC" (MP_TAC o SPEC (← q r"e0:real")) THEN
         ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
       DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC
         (X_CHOOSE_THEN (← q r"gg:A->A->real->A")
           (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]))) THEN
       ASM_REWRITE_TAC [] THEN STRIP_TAC THEN
       EXISTS_TAC (← q r"(gg:A->A->real->A) x y") THEN ASM_REWRITE_TAC [] THEN
         REPEAT STRIP_TAC THEN
       /- Need: diam(g) < e + mdist(x,y) -/
       /- Have: diam(g) < e0, e0 < inf S0 + mdist, and we show inf S0 <= e -/
       SUBGOAL_THEN (← q r"inf S0 <= (e:real)") ASSUME_TAC THENL
       [MATCH_MP_TAC INF_LE_ELEMENT THEN CONJ_TAC THENL [ASM_MESON_TAC [],
         EXPAND_TAC "S0" THEN REWRITE_TAC [IN_ELIM_THM] THEN
           ASM_REWRITE_TAC []], ALL_TAC] THEN
       ASM_REAL_ARITH_TAC]],
      /- Skolemize to get PP -/
      FIRST_X_ASSUM (MP_TAC o
        REWRITE_RULE [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) THEN
      DISCH_THEN (X_CHOOSE_THEN (← q r"PP:A->A->real->A") STRIP_ASSUME_TAC) THEN
      EXISTS_TAC (← q r"PP:A->A->real->A") THEN CONJ_TAC THENL
        [ASM_MESON_TAC [], ALL_TAC] THEN
      /- Diameter control: given e, use d = min(DELTA(e/2), e/2) -/
      X_GEN_TAC (← q r"e:real") THEN DISCH_TAC THEN
        SUBGOAL_THEN (← q r"&0 < e / &2") ASSUME_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      USE_THEN "ULPC" (MP_TAC o SPEC (← q r"e / &2")) THEN
        ANTS_TAC THENL [ASM_REWRITE_TAC [], ALL_TAC] THEN
      DISCH_THEN (CONJUNCTS_THEN2 ASSUME_TAC (K ALL_TAC : thm → tactic)) THEN
      EXISTS_TAC (← q r"min (DELTA(e / &2)) (e / &2)") THEN
        CONJ_TAC THENL [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      MAP_EVERY X_GEN_TAC [← q r"x:A", ← q r"y:A"] THEN STRIP_TAC THEN
      SUBGOAL_THEN (← q r"mdist m (x:A,y) < DELTA(e / &2)") ASSUME_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN (← q r"mdist m (x:A,y) < e / &2") ASSUME_TAC THENL
        [ASM_REAL_ARITH_TAC, ALL_TAC] THEN
      SUBGOAL_THEN
        (← q r"mdiameter m (IMAGE ((PP:A->A->real->A) x y) (real_interval[&0,&1]))
           < e / &2 + mdist m (x:A,y)") ASSUME_TAC THENL
      [FIRST_X_ASSUM (MP_TAC o SPECL [← q r"x:A", ← q r"y:A"]) THEN ASM_REWRITE_TAC [] THEN
       DISCH_THEN (fun th => tactic_of do pure (MP_TAC (← SPEC (← q r"e / &2")
         (← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 (← CONJUNCT2 th))))))) THEN
       ASM_REWRITE_TAC [], ASM_REAL_ARITH_TAC]])
    let c_in_01_tac (thms : List thm) : tactic := tactic_of do pure (
      UNDISCH_TAC (← q r"(C:real->bool) SUBSET real_interval[&0,&1]") THEN
      REWRITE_TAC [SUBSET, IN_REAL_INTERVAL] THEN MESON_TAC thms)
    let sup_in_C_tac : tactic :=
      MATCH_MP_TAC SUP_IN_REAL_CLOSED THEN
        CONJ_TAC THENL [MATCH_MP_TAC REAL_CLOSED_INTER THEN
       ASM_REWRITE_TAC [REAL_CLOSED_HALFSPACE_LE], ASM_REWRITE_TAC [] THEN
         EXISTS_TAC (← q r"&1") THEN
